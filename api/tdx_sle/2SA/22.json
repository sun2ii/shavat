{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"2SA","translationId":"tdx_sle","name":"Samoele II","commonName":"Samoele II","title":"Samoele II","order":10,"numberOfChapters":24,"sha256":"48589ef7e1e70f474b03db36be03e28e005525413d02bbe0e012da0afc15bdc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/tdx_sle/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["Tinaro’ i Davide am’ Iehovà ty onin-tsabo toy amy andro nandrombaha’ Iehovà aze am-pità’ o rafelahi’e iabio naho am-pità’ i Saoley;"]},{"type":"verse","number":2,"content":["le hoe re:",{"text":"Lamilamiko t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ty fitsolohako, naho","poem":1},{"lineBreak":true},{"text":"ty mpandrombak’ ahy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"T’i Andrianañahare lamilamiko,","poem":1},{"lineBreak":true},{"text":"Ie ty fipalirako, ty fikalan-defoko,","poem":1},{"lineBreak":true},{"text":"ty tsìfam-pandrombahañe ahy,","poem":1},{"lineBreak":true},{"text":"ty fitalakesañ-aboko,","poem":1},{"lineBreak":true},{"text":"naho ty fiampirako;","poem":1},{"lineBreak":true},{"text":"t’i Mpandrombak’ ahy,","poem":1},{"lineBreak":true},{"text":"Ihe ro mamotsots’ ahy amo hotakotakeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rengèñe, hoe ty koiko, t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa hinaha’e amo rafelahikoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nandipotse ahy o onjan-kavilasio,","poem":1},{"lineBreak":true},{"text":"nañoridañe ahy ty fisorotombaha’ i Beliale.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mivandibanditse amako","poem":1},{"lineBreak":true},{"text":"o vahoran-tsikeokeokeo;","poem":1},{"lineBreak":true},{"text":"miatreatre ahy o fandrim-pihomahañeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie niampoheke le nikanjy Iehovà,","poem":1},{"lineBreak":true},{"text":"eka, kinanjiko t’i Andrianañahareko;","poem":1},{"lineBreak":true},{"text":"le jinanji’e an-kivoho’e ao ty feoko,","poem":1},{"lineBreak":true},{"text":"vaho nimoake amo ravembia’eo ty fitoreoko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nanginikinike naho niozoñozoñe ty tane toy","poem":1},{"lineBreak":true},{"text":"niezeñezeñe o fahan-dikerañeo;","poem":1},{"lineBreak":true},{"text":"nañondrañe ty amy haviñera’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nionjoñe boak’ am-piantsona’e ty hatoeñe;","poem":1},{"lineBreak":true},{"text":"afo nahaforototo ty hirik’ am-palie’e ao;","poem":1},{"lineBreak":true},{"text":"foroha mirekake ty boak’ ama’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nampivokoke o likerañeo re vaho nizotso;","poem":1},{"lineBreak":true},{"text":"ieñe nimoromoroñe ty ambane fandia’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nijoñe ambone kerobe eo re le nitiliñe,","poem":1},{"lineBreak":true},{"text":"nitalakeseñe ambone’ o elan-tiokeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nampiarikatohe’e ama’e ty ieñe","poem":1},{"lineBreak":true},{"text":"manahake t’ie kibohotse, rano mainte","poem":1},{"lineBreak":true},{"text":"naho rahoñe migobo’ i likerañey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ty fireandrea’ i fiatrefa’ey","poem":1},{"lineBreak":true},{"text":"ty nahaviañañe vaen’ afo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nangotroke boak’ andikerañe ao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"tinolo’ i Andindimoneñey fiarañanañañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nañiririña’e ana-pale, hampibaibay;","poem":1},{"lineBreak":true},{"text":"helatse, hampitsobore iareo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Niboak’ amy zao o goledon-driakeo,","poem":1},{"lineBreak":true},{"text":"piniopioke o faha’ ty tane toio","poem":1},{"lineBreak":true},{"text":"ami’ty fañendaha’ Iehovà,","poem":1},{"lineBreak":true},{"text":"amy fikofò’ o fiantsoña’eoy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nahiti’e boak’ an-dikerañe ao ty fità’e,","poem":1},{"lineBreak":true},{"text":"rinambe’e iraho, tinari’e","poem":1},{"lineBreak":true},{"text":"boak’ añ’antara bey ao;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rinomba’e amo rafelahiko maozatseo,","poem":1},{"lineBreak":true},{"text":"amo malaiñ’ahio,","poem":1},{"lineBreak":true},{"text":"amy t’ie nifatratse te amako.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Niatreatre ahy iereo añ’andron-kankàñe;","poem":1},{"lineBreak":true},{"text":"fe nirampiako t’Iehovà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nasese’e mb’an-toetse mangadagadamb’eo","poem":1},{"lineBreak":true},{"text":"rinomba’e iraho amy te mahafale aze.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tinambe’ Iehovà ty havañonako, ty falion-tañako ty nanolora’e ahy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Toe nifaharako o lala’ Iehovào, vaho","poem":1},{"lineBreak":true},{"text":"tsy nitsile an-kelok’ aman’ Añahareko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tañatrefako eo iaby o fepè’eo,","poem":1},{"lineBreak":true},{"text":"le tsy nisitaheko o fañè’eo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nigahiñe añatrefa’e eo iraho,","poem":1},{"lineBreak":true},{"text":"vaho nilie-batañe tsy handilatse.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa le tinambe’ Iehovà","poem":1},{"lineBreak":true},{"text":"i havantañakoy,","poem":1},{"lineBreak":true},{"text":"ty haliovako am-pihaino’eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"O mpitretrèo ro tretreze’o,","poem":1},{"lineBreak":true},{"text":"vañon-dRehe amo vañoñeo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Amo malio arofoo irehe ro ki’e,","poem":1},{"lineBreak":true},{"text":"fe o mengokeo ro helofe’o.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Rombahe’o o mpisotrio;","poem":1},{"lineBreak":true},{"text":"fe amo mpitrotroabokeo o fihaino’oo, hamotsaha’o.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ihe ro failoko, ry Iehovà;","poem":1},{"lineBreak":true},{"text":"hazavae’ Iehovà o faiekoo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ihe ty nañoridañako ty firimboñañe,","poem":1},{"lineBreak":true},{"text":"i Andrianañaharekoy","poem":1},{"lineBreak":true},{"text":"ty nanganihako kijoly.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"I Andrianañahare :","poem":1},{"lineBreak":true},{"text":"vantañe i lala’ey;","poem":1},{"lineBreak":true},{"text":"niventeseñe ty Tsara’ Iehovà;","poem":1},{"lineBreak":true},{"text":"fikalan-defoñe re","poem":1},{"lineBreak":true},{"text":"amy ze hene mitsolok’ ama’e.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Fa ia t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"naho tsy Iehovà?","poem":1},{"lineBreak":true},{"text":"vaho ia ty Lamilamy","poem":1},{"lineBreak":true},{"text":"naho tsy i Andrianañaharentikañe?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"T’i Andrianañaharem-pipalirako fatratse;","poem":1},{"lineBreak":true},{"text":"i mampavantañe i liakoiy;","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ie manao o tombokoo","poem":1},{"lineBreak":true},{"text":"ho tombom-panaloke,","poem":1},{"lineBreak":true},{"text":"vaho mamotrak’ ahy an-kaboañe eo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ie mañòke o tañakoo hialy,","poem":1},{"lineBreak":true},{"text":"hampibitsohan-tañako ty fale torisìke.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Fa natolo’o ahy ka","poem":1},{"lineBreak":true},{"text":"ty fikalan-defom-pandrombahañe;","poem":1},{"lineBreak":true},{"text":"vaho nampitoabotse ahy o fañisoha’oo.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Nampangadagadañe’o ty liako;","poem":1},{"lineBreak":true},{"text":"tsy hititititike o ongokoo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Fa hinorìdako o rafelahikoo, vaho narotsako; tsy nimpoly iraho ampara’ te finongoko.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Nagedrako iereo vaho","poem":1},{"lineBreak":true},{"text":"trinabotraboko tsy hitroatse;","poem":1},{"lineBreak":true},{"text":"nikorovok’ ambane tomboko eo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Fa nampidiañe’o haozarañe","poem":1},{"lineBreak":true},{"text":"amy hotakotakey iraho;","poem":1},{"lineBreak":true},{"text":"fa nampiambanè’o amako","poem":1},{"lineBreak":true},{"text":"o nitroatse amakoo.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Natolo’o ahy ka ty hàto’ o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"haitoako amako o malaiñ’ ahio.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Nipay iereo, fe tsy amam-pandrombake;","poem":1},{"lineBreak":true},{"text":"amy Iehovà, f’ie tsy nanoiñe.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Aa le dinemodemoko ho pilipito’e iereo","poem":1},{"lineBreak":true},{"text":"manahake ty debo’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"linialiako hoe fotak’ an-dalañe eo,","poem":1},{"lineBreak":true},{"text":"toe linialiako ambane.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Ie rinomba’o am-pikitrohan-drati’ ondatikoo;","poem":1},{"lineBreak":true},{"text":"nambena’o ho mpiaolo’ o kilakila’ ondatio;","poem":1},{"lineBreak":true},{"text":"mitoroñe ahy ondaty tsy nahafohiñe ahio.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Mifimpìñe aoloko eo o anan-drenetaneo;","poem":1},{"lineBreak":true},{"text":"ie vaho mahajanjiñe ahy,","poem":1},{"lineBreak":true},{"text":"le mivohotse.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Mitsilofìñe o anan’ ambahinio,","poem":1},{"lineBreak":true},{"text":"ie minevenevetse boak’ am-piampira’eo.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Veloñe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"andriañeñe i Lamilamikoy;","poem":1},{"lineBreak":true},{"text":"onjoneñe t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"lamilamim-pandrombahako.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro mpamale-fate ho ahy,","poem":1},{"lineBreak":true},{"text":"mamotsake ondatio ho ambaneko.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"I mamotsotse ahy amo rafelahikooy;","poem":1},{"lineBreak":true},{"text":"eka onjone’o ambone’ o mitroatse amakoo;","poem":1},{"lineBreak":true},{"text":"haha’o ami’ty ‘ndaty mitrotrofiake.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Aa le hañandriañe Azo iraho, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"amo kilakila’ ondatio, vaho","poem":1},{"lineBreak":true},{"text":"ho bangoeko an-tsabo ty tahina’o.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Hafatraram-pipaliram-","poem":1},{"lineBreak":true},{"text":"pandrombahan-dRe","poem":1},{"lineBreak":true},{"text":"amy mpanjaka’ey;","poem":1},{"lineBreak":true},{"text":"ferenaiña’e i noriza’ey, i Davide","poem":1},{"lineBreak":true},{"text":"naho i tiri’ey, nainai’e kitro añ’afe’e","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}