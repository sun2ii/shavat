ineBreak":true},{"text":"vaho haitoako añivo’e ao i mpizakay,","poem":1},{"lineBreak":true},{"text":"le fonga hatraoko fizamanañe","poem":1},{"lineBreak":true},{"text":"o roandria’eo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hoe ty nafè’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Ty ami’ty fiolàñe telo’ Iehoda,","poem":1},{"lineBreak":true},{"text":"naho i fahèfa’ey","poem":1},{"lineBreak":true},{"text":"le tsy hapoko ty fandilovañe aze,","poem":1},{"lineBreak":true},{"text":"amy te tsinambolitio’ iareo","poem":1},{"lineBreak":true},{"text":"o Tsara’ Iehovào","poem":1},{"lineBreak":true},{"text":"naho tsy nambena’ iareo o fañè’eo, vaho nampandilatse iareo ty fandañira’ iareo","poem":1},{"lineBreak":true},{"text":"ie nañaveloan-droae’ iareoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"fe hamotraheko afo t’Iehoda,","poem":1},{"lineBreak":true},{"text":"hamorototo o anjomba’ Ierosalaimeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe ty nafè’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Ty ami’ty fiolàñe telo’ Israele,","poem":1},{"lineBreak":true},{"text":"naho i fah’efa’ey","poem":1},{"lineBreak":true},{"text":"le tsy hapoko ty fandilovañe aze,","poem":1},{"lineBreak":true},{"text":"amy te naleta’ iareo","poem":1},{"lineBreak":true},{"text":"ho volafoty o vantañeo,","poem":1},{"lineBreak":true},{"text":"naho ho hana o rarakeo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dorodemohe’ iereo ami’ty debo’ ty tane toy ty añambone’ o rarakeo,","poem":1},{"lineBreak":true},{"text":"naho mañolake ty lala’ o mpirekeo;","poem":1},{"lineBreak":true},{"text":"ao ka t’indaty naho ty rae’e","poem":1},{"lineBreak":true},{"text":"songa miolotse ami’ty somondrara raike, haniva ty añarako masiñe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie màndre añ’ila’ o kitrelio","poem":1},{"lineBreak":true},{"text":"an-tsikiñe tsinoake,","poem":1},{"lineBreak":true},{"text":"vaho minoñe ty divai’ o nandilovañeo an-kibohon-drahare’ iareo ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"F’izaho ty nanjamañe o nte Amoreo aolo’ iareo eo,","poem":1},{"lineBreak":true},{"text":"ie nira ami’ty haabon-tsivokon-tsifake;","poem":1},{"lineBreak":true},{"text":"nanahake o vaovio ty haozara’e;","poem":1},{"lineBreak":true},{"text":"fa rinotsako o voa’e amboneo,","poem":1},{"lineBreak":true},{"text":"naho o vaha’e ambaneo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie nakareko an-tane Mitsraime ao ka,","poem":1},{"lineBreak":true},{"text":"naho niaoloako efa-polo taoñe","poem":1},{"lineBreak":true},{"text":"am-pirangañe i fatrambeiy,","poem":1},{"lineBreak":true},{"text":"soa te hanaña’ areo ty tane’ o nte Amoreo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mbore nibeizeko ho mpitoky","poem":1},{"lineBreak":true},{"text":"ty ila’ o ana’ areoo,","poem":1},{"lineBreak":true},{"text":"naho ho nte Nazire","poem":1},{"noteId":19},{"text":"ty ila’e,","poem":1},{"lineBreak":true},{"text":"tsy to hao izay, ry ana’ Israeleo?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa nazi’ areo o nte Nazireo","poem":1},{"lineBreak":true},{"text":"ty hinoñe divay,","poem":1},{"lineBreak":true},{"text":"vaho linili’o o mpitokio ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Ko mitoky.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inao t’ie ho tindrieko ambane","poem":1},{"lineBreak":true},{"text":"manahake ty fanindrian-tsarete","poem":1},{"lineBreak":true},{"text":"pea ampemba.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hilesa ty fivoratsaha’ o malisao,","poem":1},{"lineBreak":true},{"text":"naho tsy hitoloñe ty haozara’ o fatratseo","poem":1},{"lineBreak":true},{"text":"vaho tsy haharomba-piaiñe ty fanalolahy,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"mbore tsy hahafijohañe ty mpitàm-pale;","poem":1},{"lineBreak":true},{"text":"naho tsy hahafioratse","poem":1},{"lineBreak":true},{"text":"ty mahafilay am-pandia,","poem":1},{"lineBreak":true},{"text":"naho tsy haharombak’aiñe","poem":1},{"lineBreak":true},{"text":"ty mpiningi-tsoavala;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"vaho hitriban-day tsy an-tsaroñe","poem":1},{"lineBreak":true},{"text":"ty lahi-tsi-ai’ o fanalolahio,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":17,"caller":"+","text":"Moabe: an-drae’e","reference":{"chapter":2,"verse":1}},{"noteId":18,"caller":"+","text":"Keriote: o rovao; o fikoihañeo","reference":{"chapter":2,"verse":2}},{"noteId":19,"caller":"+","text":"Nazire: Jinoboñe ndra naambake","reference":{"chapter":2,"verse":11}}]},"thisChapterLink":"/api/tdx_sle/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}