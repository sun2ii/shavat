{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"AMO","translationId":"tdx_sle","name":"Amose","commonName":"Amose","title":"Amose","order":30,"numberOfChapters":9,"sha256":"9a2feca9a24a6d1af4b050ac33c5d87e0b5d8041717bfb60fd6dee8f3366d348","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tdx_sle/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Mijanjiña ty nitsarà’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry ana’ Israeleo,","poem":1},{"lineBreak":true},{"text":"ry hene foko nakareko","poem":1},{"lineBreak":true},{"text":"an-tane’ i Mitsraimeo, ami’ty hoe:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inahareo avao ty napotako amo kila","poem":1},{"lineBreak":true},{"text":"foko ty tane toio;","poem":1},{"lineBreak":true},{"text":"aa le fonga havaleko ama’ areo","poem":1},{"lineBreak":true},{"text":"o hakeo’ areoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mahay miharo lia hao ty roe","poem":1},{"lineBreak":true},{"text":"naho tsy milahatse hey?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hitroñe añ’ala ao hao ty liona","poem":1},{"lineBreak":true},{"text":"naho tsy aman-tsàtsa’e?","poem":1},{"lineBreak":true},{"text":"Hañaolo boak’ an-dakato’e ao hao","poem":1},{"lineBreak":true},{"text":"ty liona tora’e naho tsy nahatsepake?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mete hikoropok’ am-pandri-bo","poem":1},{"lineBreak":true},{"text":"an-tane eo hao ty voroñe,","poem":1},{"lineBreak":true},{"text":"naho tsy ama’e ty fitake?","poem":1},{"lineBreak":true},{"text":"Hidraitse an-tane eo hao i bitsokey,","poem":1},{"lineBreak":true},{"text":"ie tsy aman-ko tsepaheñe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naho tiofeñe an-drova ao i antsivay,","poem":1},{"lineBreak":true},{"text":"tsy hangebahebake hao ondatio?","poem":1},{"lineBreak":true},{"text":"Ie hizò hankàñe ty rova,","poem":1},{"lineBreak":true},{"text":"tsy ho sata’ Iehovà hao?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe tsy hanao ndra inoñ’inoñe","poem":1},{"lineBreak":true},{"text":"t’Iehovà, Talè, naho tsy borahe’e","poem":1},{"lineBreak":true},{"text":"amo mpitoro’e mpitokio heike","poem":1},{"lineBreak":true},{"text":"o safiri’e mietakeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa nitroñe i lionay,","poem":1},{"lineBreak":true},{"text":"ia ty tsy ho hembañe?","poem":1},{"lineBreak":true},{"text":"Fa nitsara t’Iehovà, Talè,","poem":1},{"lineBreak":true},{"text":"ia ty tsy hitoky?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tseizo amo anjomba’ i Asdodeo","poem":1},{"lineBreak":true},{"text":"naho amo anjomba an-tane’","poem":1},{"lineBreak":true},{"text":"Mitsraime añeo ty hoe:","poem":1},{"lineBreak":true},{"text":"mitontona am-bohi’ i Somerone eo,","poem":1},{"lineBreak":true},{"text":"naho mahaisaha ty fifandraparapahañe añivo’e ao vaho o forekekeñe ama’e aoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa tsy fohi’ iareo ty hanao ty hiti’e,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie mañaja fikatramoañe, naho fampikamerañe añ’anjomba’ iareo ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa hoe t’Iehovà, Talè:","poem":1},{"lineBreak":true},{"text":"Hiarikatohe’ ty rafelahy i taney","poem":1},{"lineBreak":true},{"text":"naho harotsa’e o hafatrara’oo,","poem":1},{"lineBreak":true},{"text":"vaho ho kopahe’e o anjomba’oo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoe t’i Iehovà:","poem":1},{"lineBreak":true},{"text":"Manahake ty añakara’ ty mpiarake","poem":1},{"lineBreak":true},{"text":"ami’ty montsilin-diona","poem":1},{"lineBreak":true},{"text":"ty tombo’e roe ndra ty silan-tsofi’e,","poem":1},{"lineBreak":true},{"text":"ty haneseañe o ana’ Israele","poem":1},{"lineBreak":true},{"text":"mimoneñe e Someroneo,","poem":1},{"lineBreak":true},{"text":"reketse ty indran-tihy","poem":1},{"lineBreak":true},{"text":"ndra ty tombom-pandreañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mijanjiña, le asisio ty anjomba’ Iakobe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, Talè Andrianañahare’ i màroy;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"fa amy andro hañondrohako","poem":1},{"lineBreak":true},{"text":"o fiolà’ Israeleoy,","poem":1},{"lineBreak":true},{"text":"le ho valeako o kitreli’ i Beteleo","poem":1},{"noteId":20},{"text":",","poem":1},{"lineBreak":true},{"text":"naho ho kitsifañe i tsifan-kitrely rey","poem":1},{"lineBreak":true},{"text":"vaho hipok’ an-tane eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hatraoko lafa i anjomban’asaray","poem":1},{"lineBreak":true},{"text":"naho i anjomban’asotriy,","poem":1},{"lineBreak":true},{"text":"hikoromake ka o anjomba aman-tsifao;","poem":1},{"lineBreak":true},{"text":"toe hirotsake o anjomba jabajabao,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Betele: Anjomba mandrifondrifoñe","reference":{"chapter":3,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}