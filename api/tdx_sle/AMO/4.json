mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho hahifike mb’e Karmone","poem":1},{"noteId":22},{"text":"añe","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mb’e Betele mb’atoy, le mandilara;","poem":1},{"lineBreak":true},{"text":"mb’e Gilgale","poem":1},{"noteId":23},{"text":"le ampitombò hakeo;","poem":1},{"lineBreak":true},{"text":"banabanao o enga’ areoo te maraindray,","poem":1},{"lineBreak":true},{"text":"ty faha-folo’e añ’andro fahatelo’e;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"naho añengao sorom-pandrengeañe","poem":1},{"lineBreak":true},{"text":"milaro lalivay","poem":1},{"noteId":24},{"text":",","poem":1},{"lineBreak":true},{"text":"le tseizo o banabanan-tsatrin-trokeo,","poem":1},{"lineBreak":true},{"text":"vaho isengeo,","poem":1},{"lineBreak":true},{"text":"fa izay ty tea’ areo, ry ana’Israeleo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, Talè.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nitolorako nife malio","poem":1},{"lineBreak":true},{"text":"amo rova’ areo iabio,","poem":1},{"lineBreak":true},{"text":"naho tsy fahampeañe mofo","poem":1},{"lineBreak":true},{"text":"añ’anjomba’ areo,","poem":1},{"lineBreak":true},{"text":"fe tsy nimpoly amako nahareo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nampihakañeko ama’ areo ty orañe,","poem":1},{"lineBreak":true},{"text":"te mbe volañe telo añe i fitatahañey,","poem":1},{"lineBreak":true},{"text":"le nampahaviako orañe ty rova raike","poem":1},{"lineBreak":true},{"text":"fa tsy nampahaviako ka ty rova raike;","poem":1},{"lineBreak":true},{"text":"toetse raike ty nahazo orañe,","poem":1},{"lineBreak":true},{"text":"niforejeje ka i tsy nahavia’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa le nitoha rano hinoma’e mb’ an-drova raike añe ty rova telo ndra roe,","poem":1},{"lineBreak":true},{"text":"fa tsy nahaeneñe,","poem":1},{"lineBreak":true},{"text":"mboe tsy nimpoly amako avao","poem":1},{"lineBreak":true},{"text":"nahareo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"F’ie linafako an-tio-maike","poem":1},{"lineBreak":true},{"text":"naho an-tromambo;","poem":1},{"lineBreak":true},{"text":"le nabotse’ ty kijeja","poem":1},{"lineBreak":true},{"text":"ty hamaroa’ o golobo’ areoo,","poem":1},{"lineBreak":true},{"text":"naho o tanem-bahe’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho o voanio’ areoo;","poem":1},{"lineBreak":true},{"text":"fe tsy nimpoly amako, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nahitriko ama’ areo ty angorosy","poem":1},{"lineBreak":true},{"text":"manahake o tan-tane Mitsraime añeo,","poem":1},{"lineBreak":true},{"text":"zinamako am-pibara o ajalahi’ areoo,","poem":1},{"lineBreak":true},{"text":"naho tinavako o soavala’ areoo,","poem":1},{"lineBreak":true},{"text":"nampionjoneko mb’am-pian­tsona’ areo ao ty fitrotròra’e;","poem":1},{"lineBreak":true},{"text":"fe tsy nimpoly amako, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Finongoko ty ila’e ama’ areo","poem":1},{"lineBreak":true},{"text":"manahake ty namongoran’Añahare","poem":1},{"lineBreak":true},{"text":"i Sedome","poem":1},{"noteId":25},{"text":"naho i Amorà","poem":1},{"noteId":26},{"text":",","poem":1},{"lineBreak":true},{"text":"ie nihoe foroha mirekake tsinoake","poem":1},{"lineBreak":true},{"text":"amy afoy ao;","poem":1},{"lineBreak":true},{"text":"fe mboe tsy nimpoly amako","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toly ndra inao ty hanoeko ama’o","poem":1},{"lineBreak":true},{"text":"ry Israele;","poem":1},{"lineBreak":true},{"text":"kanao tsy mete tsy hanoeko,","poem":1},{"lineBreak":true},{"text":"le mihentseña hifañaoñe","poem":1},{"lineBreak":true},{"text":"aman’ Añahare’o ry Israele.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inao, i mpitsene o vohitseo","poem":1},{"lineBreak":true},{"text":"naho mpamboatse o tiokeoy,","poem":1},{"lineBreak":true},{"text":"I mampiborake o vetsevetse’eo am’ondatioy.","poem":1},{"lineBreak":true},{"text":"I mampiboake ty manjirik’andro","poem":1},{"lineBreak":true},{"text":"ami’ty fimoromoroñe,","poem":1},{"lineBreak":true},{"text":"I midraidraitse amo toets’ambone’","poem":1},{"lineBreak":true},{"text":"ty tane toioy;","poem":1},{"lineBreak":true},{"text":"Iehovà Andrianañahare’ i màroy","poem":1},{"lineBreak":true},{"text":"ty tahina’e.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Basane: aman-tsifa (nife jabajaba foty)","reference":{"chapter":4,"verse":1}},{"noteId":22,"caller":"+","text":"Karome: anjomba","reference":{"chapter":4,"verse":3}},{"noteId":23,"caller":"+","text":"Gilgale: larô; mivarimbariñe; votry","reference":{"chapter":4,"verse":4}},{"noteId":24,"caller":"+","text":"Oniño: Sor 2.11","reference":{"chapter":4,"verse":5}},{"noteId":25,"caller":"+","text":"Sedome: ty tsikotsiko’ iareo;","reference":{"chapter":4,"verse":11}},{"noteId":26,"caller":"+","text":"Amorà: ondaty miola","reference":{"chapter":4,"verse":11}}]},"thisChapterLink":"/api/tdx_sle/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}