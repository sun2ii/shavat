{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"AMO","translationId":"tdx_sle","name":"Amose","commonName":"Amose","title":"Amose","order":30,"numberOfChapters":9,"sha256":"9a2feca9a24a6d1af4b050ac33c5d87e0b5d8041717bfb60fd6dee8f3366d348","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tdx_sle/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Janjiño o entañe honjoneko","poem":1},{"lineBreak":true},{"text":"ho bekom-pandalàñe ama’ areoo,","poem":1},{"lineBreak":true},{"text":"ry anjomba’ Israele:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nihotrake ty somondrara’ Israele;","poem":1},{"lineBreak":true},{"text":"tsy hahafitroatse ka:","poem":1},{"lineBreak":true},{"text":"mifitak’ an-tane’e eo avao,","poem":1},{"lineBreak":true},{"text":"tsy eo ty mahaongak’ aze.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa hoe ty nafè’ Iehovà, Talè:","poem":1},{"lineBreak":true},{"text":"Ty rova nampionjoñe ty arivo","poem":1},{"lineBreak":true},{"text":"ro hengañe zato;","poem":1},{"lineBreak":true},{"text":"naho ty nampionjoñe zato","poem":1},{"lineBreak":true},{"text":"ro sisàñe folo,","poem":1},{"lineBreak":true},{"text":"amy anjomba’ Israeley.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"F’ie hoe ty nafè’ Iehovà","poem":1},{"lineBreak":true},{"text":"amy anjomba’ Israeley:","poem":1},{"lineBreak":true},{"text":"Paiavo iraho, soa t’ie ho veloñe;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa ko mipay i Betele,","poem":1},{"lineBreak":true},{"text":"naho ko mb’e Gilgale mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho ko mitsake mb’e Beersèba","poem":1},{"noteId":27},{"lineBreak":true},{"text":"amy te hasese mb’an-drohy","poem":1},{"lineBreak":true},{"text":"añe t’i Gilgale,","poem":1},{"lineBreak":true},{"text":"naho ho tanan-taolo t’i Betele.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsoeho t’Iehovà, soa te ho veloñe;","poem":1},{"lineBreak":true},{"text":"tsy mone hisolebora’e hoe afo,","poem":1},{"lineBreak":true},{"text":"ry anjomba’ Iosefe,","poem":1},{"lineBreak":true},{"text":"hamorototo i Betele,","poem":1},{"lineBreak":true},{"text":"ie tsy ama’e ty hahafikipek’aze.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O ry mamotetse ty zaka ho vahontsoy,","poem":1},{"lineBreak":true},{"text":"vaho mametsake ty havantañañe an-tane,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miandrà mb’amy Namboatse","poem":1},{"lineBreak":true},{"text":"i vasiam-pito rey","poem":1},{"lineBreak":true},{"text":"naho i Telo-miriritseiy;","poem":1},{"lineBreak":true},{"text":"mb’amy mamalike ty fimoromoroñan-kavilasy ho maraiñey,","poem":1},{"lineBreak":true},{"text":"mb’amy mampaièñe ty andro ho haleñey;","poem":1},{"lineBreak":true},{"text":"mb’amy mpikanjy o ranon-driakeo","poem":1},{"lineBreak":true},{"text":"hañiliña’e an-tarehe’ ty tane toiy:","poem":1},{"lineBreak":true},{"text":"Iehovà ty tahina’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampibiloe’e amo maozatseo","poem":1},{"lineBreak":true},{"text":"ty fandrotsahañe,","poem":1},{"lineBreak":true},{"text":"vaho miambotrak’ amy rova","poem":1},{"lineBreak":true},{"text":"fatratsey ty fandrebahañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Heje’ iereo ty mpañendak’ an-dalambey eo,","poem":1},{"lineBreak":true},{"text":"vaho falai’ iareo","poem":1},{"lineBreak":true},{"text":"ty misaontsy an-kavañonañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa kanao lialià’ areo o rarakeo, naho","poem":1},{"lineBreak":true},{"text":"angala’ areo fehen-ampemba,","poem":1},{"lineBreak":true},{"text":"naho andranjia’ areo traño","poem":1},{"lineBreak":true},{"text":"am-bato vinaky,","poem":1},{"lineBreak":true},{"text":"toe tsy himoneña’areo;","poem":1},{"lineBreak":true},{"text":"nambolèa’ areo tanem-bahe soa,","poem":1},{"lineBreak":true},{"text":"f’ie tsy hinoman-divay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe apotako te maro o fandilara’ areoo naho jabajaba o ota-fali’ areo;","poem":1},{"lineBreak":true},{"text":"helofa’ areo o vantañeoo,","poem":1},{"lineBreak":true},{"text":"naho mangala-vokàñe,","poem":1},{"lineBreak":true},{"text":"vaho ampiotahe’ areo an-dalambey eo","poem":1},{"lineBreak":true},{"text":"o rarakeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le hianjiñe avao o mahilalao","poem":1},{"lineBreak":true},{"text":"amy andro zay amy te","poem":1},{"lineBreak":true},{"text":"ho hekoheko i sa zay.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paiao ty soa, fa tsy ty raty,","poem":1},{"lineBreak":true},{"text":"soa te ho veloñe;","poem":1},{"lineBreak":true},{"text":"vaho hañimba anahareo","poem":1},{"lineBreak":true},{"text":"t’Iehovà Andrianañahare’ i màroy,","poem":1},{"lineBreak":true},{"text":"ty amy saontsi’ areoy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hejeo ty raty naho kokò ty soa,","poem":1},{"lineBreak":true},{"text":"vaho añorizo zaka to an-dalambey eo;","poem":1},{"lineBreak":true},{"text":"hera hanolots’arofo","poem":1},{"lineBreak":true},{"text":"amo sehanga’ Iosefeo","poem":1},{"lineBreak":true},{"text":"t’Iehovà Andrianañahare.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà, Talè","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ i màroy:","poem":1},{"lineBreak":true},{"text":"Fangololoihañe ty ho amo lalan-drovao,","poem":1},{"lineBreak":true},{"text":"vaho ho koiheñe an-damoke ey","poem":1},{"lineBreak":true},{"text":"ty hoe, Hankàñe! hankàñe!","poem":1},{"lineBreak":true},{"text":"le hikoke o mpihareo, handala,","poem":1},{"lineBreak":true},{"text":"naho o mahay mikoiakeo, hangoihoy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le firovetañe ty ho amo","poem":1},{"lineBreak":true},{"text":"tanem-bahe iabio,","poem":1},{"lineBreak":true},{"text":"amy te hiranga añivo’o ao iraho,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hankàñe ama’ areo misalala","poem":1},{"lineBreak":true},{"text":"ty andro’ Iehovà!","poem":1},{"lineBreak":true},{"text":"Ho inoñ’ ama’ areo ty andro’ Iehovà?","poem":1},{"lineBreak":true},{"text":"Ho fimoromoroñañe fa tsy hazavàñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Manahake t’indaty","poem":1},{"lineBreak":true},{"text":"mibotatsak’ ami’ty liona","poem":1},{"lineBreak":true},{"text":"te mone mizò amboa romotse;","poem":1},{"lineBreak":true},{"text":"ndra mizilik’ añ’anjomba ao","poem":1},{"lineBreak":true},{"text":"naho miato an-drindriñe eo ty fità’e","poem":1},{"lineBreak":true},{"text":"vaho tsipohe’ ty fandrefeala.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy haieñe hao ty andro’ Iehovà","poem":1},{"lineBreak":true},{"text":"fa tsy hazavàñe?","poem":1},{"lineBreak":true},{"text":"Toe ho fimoromoroñañe fa","poem":1},{"lineBreak":true},{"text":"tsy ho aman-kazavàñe ndra piti’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hejeko, toe mampangorý ahy","poem":1},{"lineBreak":true},{"text":"o sabadida’ areo miavakeo,","poem":1},{"lineBreak":true},{"text":"tsy noko o fivorim-pamantaña’ areoo","poem":1},{"noteId":28},{"text":".","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa ndra t’ie mañenga soron-koroañe","poem":1},{"lineBreak":true},{"text":"rekets’ enga-mahakama amako,","poem":1},{"lineBreak":true},{"text":"tsy ho noko;","poem":1},{"lineBreak":true},{"text":"vaho tsy ho haoñeko","poem":1},{"lineBreak":true},{"text":"o engam-pilongoa’ areoo","poem":1},{"lineBreak":true},{"text":"naho o vinondra’ areoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Asitaho amako ty fikoraha’ o saboo;","poem":1},{"lineBreak":true},{"text":"le tsy ho tsanoñeko ty feo fititiha’ areo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Te mone ­ampikararaho hoe rano ty hatò,","poem":1},{"lineBreak":true},{"text":"naho hoe torahañe tsy-mai-drano","poem":1},{"lineBreak":true},{"text":"ty havantañañe.","poem":1}]},{"type":"verse","number":25,"content":["Aa vaho nisoroñe naho ­nañenga-mahakama amako an-dratraratra añe hao nahareo tamy efa-polo taoñe zay, ry Anjomba’ Israele?"]},{"type":"verse","number":26,"content":["Toe niba­bè’ areo ty kibohom-panjàka’ areo, naho o samposampo’ areoo, i vasian-drahare",{"noteId":29},"nitsenè’ areoy."]},{"type":"verse","number":27,"content":["Aa le hase­seko an-drohy mb’ankalo’ i Damesèk’ añe, hoe t’Iehovà. I Andria­nañahare’ i màroy ty tahina’ey."]}],"footnotes":[{"noteId":27,"caller":"+","text":"Beerseba: vovom-pañina; vovo faha-fito","reference":{"chapter":5,"verse":5}},{"noteId":28,"caller":"+","text":"Mp I 12:32-33","reference":{"chapter":5,"verse":21}},{"noteId":29,"caller":"+","text":"Ies 59:15, Ti II 4:4","reference":{"chapter":5,"verse":26}}]},"thisChapterLink":"/api/tdx_sle/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}