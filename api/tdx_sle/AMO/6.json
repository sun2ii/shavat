{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"AMO","translationId":"tdx_sle","name":"Amose","commonName":"Amose","title":"Amose","order":30,"numberOfChapters":9,"sha256":"9a2feca9a24a6d1af4b050ac33c5d87e0b5d8041717bfb60fd6dee8f3366d348","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tdx_sle/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe ry mierañerañe e Tsione ao, naho o mipalitse ami’ty vohi’ i Someroneo,","poem":1},{"lineBreak":true},{"text":"o roandriam-pifeheañe valoha’e","poem":1},{"lineBreak":true},{"text":"iatoa’ ty anjomba’ Israeleo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mionjona mb’e Kalnè mb’eo le isao,","poem":1},{"lineBreak":true},{"text":"akia henane zay mb’e Kamate jabajabay;","poem":1},{"lineBreak":true},{"text":"vaho mizotsoa mb’e Gate","poem":1},{"lineBreak":true},{"text":"nte-Pilistiy mb’eo.","poem":1},{"lineBreak":true},{"text":"Ho soa te amy fifeheañe retiañe hao iereo?","poem":1},{"lineBreak":true},{"text":"mandikoatse ty efe-tane’ areo","poem":1},{"lineBreak":true},{"text":"hao ty a iareo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ry mampihànkañe i andron-kankàñey","poem":1},{"lineBreak":true},{"text":"vaho mampitotoke","poem":1},{"lineBreak":true},{"text":"i fiambesan-karotsahañey;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"o mitsalalampatse am-­pandreañe nihamineñe hafotia-nife","poem":1},{"lineBreak":true},{"text":"naho mihitsy an-kidori’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho mikama anak’añondry","poem":1},{"lineBreak":true},{"text":"boak’ amy lia-raikey","poem":1},{"lineBreak":true},{"text":"naho sarake boak’ añivon-jolokeo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"o mititike marovany arahem-peo","poem":1},{"lineBreak":true},{"text":"vaho mamoroñe raham-pititihañe,","poem":1},{"lineBreak":true},{"text":"manahake i Davideo;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"o minon-divay an-tsini-hara","poem":1},{"lineBreak":true},{"text":"naho mihosotse menake soao,","poem":1},{"lineBreak":true},{"text":"fe tsy iroveta’e ty hasotria’ Iosefe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ie amy zao, hasese mb’an-drohy mb’eo ho mpiaolom-pirohy,","poem":1},{"lineBreak":true},{"text":"vaho hafahañe añe ty sabadida’","poem":1},{"lineBreak":true},{"text":"o mpihity an-telo-antarao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa nifanta amam-bata’e t’Iehovà, Talè;","poem":1},{"lineBreak":true},{"text":"le hoe t’Iehovà Andrianañahare’ i màroy,","poem":1},{"lineBreak":true},{"text":"Hejeko ty fiebotsebora’ Iakobe,","poem":1},{"lineBreak":true},{"text":"naho mampangorý ahy o anjomba’eo:","poem":1},{"lineBreak":true},{"text":"aa le hatoloko añe","poem":1},{"lineBreak":true},{"text":"i rovay rekets’ o ama’e iabio.","poem":1}]},{"type":"verse","number":9,"content":["Ie henane zay, naho lahilahy folo ty sisa añ’anjomba raike, fonga hihomake."]},{"type":"verse","number":10,"content":["Ho rambese’ i rahalahin-drae’e kiraikiraike iereo hañakara’e añ’anjomba’e ao hañoroa’e, le ty hoe ty hanoe’e amy añ’anjomba aoy, Mbe ama’e hao irehe? le ty hoe ty hatoi’ ty ao, Aiy! vaho hoe ka i raikey. Mianjiña, fa tsy volañeñe ty tahina’ Iehovà."]},{"type":"verse","number":11,"content":[{"text":"Inao fa handily t’Iehovà","poem":1},{"lineBreak":true},{"text":"te ho tseratseraheñe o anjombao","poem":1},{"lineBreak":true},{"text":"vaho ho hotohotoeñe o kibohotseo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hilay ambatovato hao o soavalao?","poem":1},{"lineBreak":true},{"text":"hitari-dasarý eo reketse katràka","poem":1},{"lineBreak":true},{"text":"hao t’indaty?","poem":1},{"lineBreak":true},{"text":"Mañino te nafote’ areo ho voreke","poem":1},{"lineBreak":true},{"text":"ty havañonañe,","poem":1},{"lineBreak":true},{"text":"vaho ho vahon-tsoy","poem":1},{"lineBreak":true},{"text":"ty vokan-kavantañañe?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ry mpirebek’ amo raha tsy vente’eo,","poem":1},{"lineBreak":true},{"text":"manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy ty haozara’ay avao hao","poem":1},{"lineBreak":true},{"text":"ty nahavontititse tsifa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Inao arè, ry anjomba’ Israeleo","poem":1},{"lineBreak":true},{"text":"te hatroako haname anahareo","poem":1},{"lineBreak":true},{"text":"ty fifeheañe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà Andrianañahare’ i màroy,","poem":1},{"lineBreak":true},{"text":"le ho silofe’ iereo","poem":1},{"lineBreak":true},{"text":"boak’ am-piziliha’ i Kamate eo","poem":1},{"lineBreak":true},{"text":"pak’ an-tsaka’ Arabà añe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}