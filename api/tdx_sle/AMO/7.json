{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"AMO","translationId":"tdx_sle","name":"Amose","commonName":"Amose","title":"Amose","order":30,"numberOfChapters":9,"sha256":"9a2feca9a24a6d1af4b050ac33c5d87e0b5d8041717bfb60fd6dee8f3366d348","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tdx_sle/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Zao ty natoro’ Iehovà, Talè, ahy, Ingo, namboare’e fifamorohotam-balala te nitovoañe i ampemba afaray, le hehe t’ie nandimbe ty fitataha’ i mpanjakay i tinogy an-doha-taoñey."]},{"type":"verse","number":2,"content":["Aa naho hene nabotse’ iareo ze ahetse amy taney eo, le hoe ty asako tama’e,",{"text":"Ry Iehovà, Talè, ehe apoho;","poem":1},{"lineBreak":true},{"text":"akore ty hahafijohaña’ Iakobe?","poem":1},{"lineBreak":true},{"text":"Ie kede.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le napo’ Iehovà;","poem":1},{"lineBreak":true},{"text":"Tsy hanoeñe izay, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie añe le inao ka ty naboa’ Iehovà, Talè: Heheke te kinanji’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Talè ty zaka añ’afo;","poem":1},{"lineBreak":true},{"text":"finorototo’e i laleke beiy","poem":1},{"lineBreak":true},{"text":"vaho namototse nampigodrañe i taney.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le hoe iraho, Ry Iehovà, Talè, Aziro! iambaneako;","poem":1},{"lineBreak":true},{"text":"aia ty hijohaña’ Iakobe, ie kede?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le nado’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Tsy hanoeñe ka izay, hoe t’Iehovà, Talè.","poem":1}]},{"type":"verse","number":7,"content":["Zao ka ty natoro’e ahy, ingo te nijohañe ambone kijoly nanoeñe an-tàlin-kahity eo t’i Talè, reketse ty talin-kahity am-pità’e ao."]},{"type":"verse","number":8,"content":["Le hoe t’Iehovà amako, O Amose, ino o isa’oo? Le hoe iraho, Talin-kahity. Aa hoe t’i Talè;",{"text":"Hehe, hapoko añivo’ ondatiko","poem":1},{"lineBreak":true},{"text":"Israeleo ty talin-kahitiko;","poem":1},{"lineBreak":true},{"text":"tsy hiheveako ka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho koake o toets’ abo’ Ietsakeo,","poem":1},{"lineBreak":true},{"text":"naho hanoeñe bijon-draha","poem":1},{"lineBreak":true},{"text":"o toe’ Israele miambakeo;","poem":1},{"lineBreak":true},{"text":"vaho hitroatse amy anjomba’ Ieroboame iraho reketse fibara.","poem":1}]},{"type":"verse","number":10,"content":["Nampañitrik’ am’ Ieroboame mpanjaka’ Israele t’i Amatsià mpisoro’ i Betele, nanao ty hoe, Nikinia azo t’i Amose añ’ anjomba’ Israele ao; tsy leo’ o taneo ze fonga ­saontsi’e."]},{"type":"verse","number":11,"content":["Fa hoe ty asa’ i Amose,",{"text":"Inao, hampihomahem-pibara","poem":1},{"lineBreak":true},{"text":"t’Ieroboame,","poem":1},{"lineBreak":true},{"text":"vaho tsy mete tsy hasese","poem":1},{"lineBreak":true},{"text":"mb’am-pandrohizañ’ añe","poem":1},{"lineBreak":true},{"text":"boak’ an-tane’e ao t’Israele.","poem":1}]},{"type":"verse","number":12,"content":["Aa le hoe t’i Amatsià amy Amose, Ry mpioniñeo, akia, mitribaña an-day mb’an-tane’ Iehoda mb’eo, le kamao añe o mahakama’oo, vaho añe ty itokia’o,"]},{"type":"verse","number":13,"content":["fa ko mitoky ka e Betele ao, amy t’ie ty toe-masi’ i mpanjakay vaho rova-bei’ ty fifeheañe toy."]},{"type":"verse","number":14,"content":["Aa le hoe ty natoi’ i Amose amy Amatsià, Izaho tsy mpitoky, tsy anam-pitoky, fa mpihare naho mpañalahala sakoa;"]},{"type":"verse","number":15,"content":["vaho rinambe’ Iehovà ami’ty fañarahañe i lia-raikey, le hoe t’Iehovà amako, Akia, mitokia am’ ondatiko Israeleo."]},{"type":"verse","number":16,"content":["Janjiño arè ty tsara’ Iehovà: Hoe ty asa’o:",{"text":"Ko mitoky am’ Israele vaho","poem":1},{"lineBreak":true},{"text":"ko mampipoke saontsy","poem":1},{"lineBreak":true},{"text":"amy anjomba’ Ietsakey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa le hoe ty nitsarà’ Iehovà;","poem":1},{"lineBreak":true},{"text":"Ho tsimirira an-drova ao ty vali’o,","poem":1},{"lineBreak":true},{"text":"naho hampikorovohem-pibara","poem":1},{"lineBreak":true},{"text":"o ana-dahi’oo naho","poem":1},{"lineBreak":true},{"text":"o anak-ampela’oo,","poem":1},{"lineBreak":true},{"text":"naho ho zarazaraeñe ty tane’o;","poem":1},{"lineBreak":true},{"text":"naho hikoromak’ an-tane tiva eo irehe;","poem":1},{"lineBreak":true},{"text":"toe hasese mb’am-pandrohizañ’ añe","poem":1},{"lineBreak":true},{"text":"boak’an-tane’e ao t’Israele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/AMO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}