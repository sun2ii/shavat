{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"AMO","translationId":"tdx_sle","name":"Amose","commonName":"Amose","title":"Amose","order":30,"numberOfChapters":9,"sha256":"9a2feca9a24a6d1af4b050ac33c5d87e0b5d8041717bfb60fd6dee8f3366d348","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tdx_sle/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Zao ty natoron’ Añahare Talè ahy; Ingo ty vakoa pea havokaran’ asara."]},{"type":"verse","number":2,"content":["Le hoe re, O Amose, ino o isa’oo? Le hoe iraho, Ty vakoam-boan’asara. Vaho hoe t’Iehovà amako,",{"text":"Fa tondrok’ am’ondatiko Israeleo","poem":1},{"lineBreak":true},{"text":"ty figadoña’e; ie tsy hapoko ka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie amy andro zay handimbe o sabo añ’anjombao ty bekom-pandala,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, Talè:","poem":1},{"lineBreak":true},{"text":"ho pea lolo atoy naho aroa i taney;","poem":1},{"lineBreak":true},{"text":"le havokovoko","poem":1},{"lineBreak":true},{"text":"am-pianjiñañe añe iereo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Janjiño izao ry mpigedrañe o rarakeo,","poem":1},{"lineBreak":true},{"text":"ry mpañito o poi’e amy taneio,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ie manao ty hoe, naho añe i pea-bolañey","poem":1},{"lineBreak":true},{"text":"le haletan-tika i ampembay;","poem":1},{"lineBreak":true},{"text":"naho modo i andro Sabotsey","poem":1},{"lineBreak":true},{"text":"le ho sokafen-tika o an-drihao,","poem":1},{"lineBreak":true},{"text":"ho tomoreñe ty kapoake,","poem":1},{"lineBreak":true},{"text":"naho honjoneñe i dralay,","poem":1},{"lineBreak":true},{"text":"vaho hampivilañeñe","poem":1},{"lineBreak":true},{"text":"am-pañahy o balantsio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho kaloen-tika drala o rarakeo","poem":1},{"lineBreak":true},{"text":"naho hana roe o poi’eo,","poem":1},{"lineBreak":true},{"text":"vaho haletan-tika reke-kafo’e i ampembay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe nifanta ami’ty volonahe’ Iakobe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Le lia’e tsy haliñoko o sata’ iareoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy hampiozoñozoñe i taney hao zay:","poem":1},{"lineBreak":true},{"text":"hampandala o hene mpimoneñeo?","poem":1},{"lineBreak":true},{"text":"hanganahana manahake i Sakay, hivalitaboake vaho hiketrake indraike","poem":1},{"lineBreak":true},{"text":"manahake i saka’ i Mitsraimey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho tondrok’ amy andro zay,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, Talè, te, hampitsoforeko","poem":1},{"lineBreak":true},{"text":"an-tsipinde-mena i àndroy,","poem":1},{"lineBreak":true},{"text":"vaho ho lombofako ieñe ty tane toy","poem":1},{"lineBreak":true},{"text":"añ’andro mazava;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"naho hafoteko ho fandalàñe","poem":1},{"lineBreak":true},{"text":"o sabadida’ areoo","poem":1},{"lineBreak":true},{"text":"naho ho firovetañe o sabo’ areoo;","poem":1},{"lineBreak":true},{"text":"fonga hampisikineko gony ze tohake, naho ho peaheko ze hene añambone;","poem":1},{"lineBreak":true},{"text":"le hampangololoiheko","poem":1},{"lineBreak":true},{"text":"hoe t’ie ni-tañoloñoloñañe,","poem":1},{"lineBreak":true},{"text":"vaho hafaitse ty androm-pigadoña’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ingo, ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, Talè,","poem":1},{"lineBreak":true},{"text":"te hiraheko an-tane atoy ty san-kerè,","poem":1},{"lineBreak":true},{"text":"fa tsy ty hasaliko-mahakama,","poem":1},{"lineBreak":true},{"text":"naho tsy ty hataliñieren-drano,","poem":1},{"lineBreak":true},{"text":"fa ty fijanjiñañe o tsara’ Iehovào;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"hirererere boak’ an-driake pak’","poem":1},{"lineBreak":true},{"text":"an-driak’ añe ondatio,","poem":1},{"lineBreak":true},{"text":"naho boak’ avaratse vaho hianiñanañe,","poem":1},{"lineBreak":true},{"text":"hibelobelo mb’etia mb’eroa","poem":1},{"lineBreak":true},{"text":"hipay ty tsara’ Iehovà fa tsy ho isa’e","poem":1},{"noteId":30},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho toirañen-keahea","poem":1},{"lineBreak":true},{"text":"o somondrara maintelèñeo","poem":1},{"lineBreak":true},{"text":"naho o ajalahio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le o mifanta amy hakeo’ i Someroneio ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Kanao veloñe ty ‘ndrahare’ i Dane;","poem":1},{"lineBreak":true},{"text":"naho, Katao veloñe ty sata’ i Beèrsèbae;","poem":1},{"lineBreak":true},{"text":"le hikorovoke, tsy hitroatse ka.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Iir 5:13, Hos 8:12, Iek 34:3-10","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}