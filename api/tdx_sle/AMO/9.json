{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"AMO","translationId":"tdx_sle","name":"Amose","commonName":"Amose","title":"Amose","order":30,"numberOfChapters":9,"sha256":"9a2feca9a24a6d1af4b050ac33c5d87e0b5d8041717bfb60fd6dee8f3366d348","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tdx_sle/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Nitreako nijohañe añ’ila’ i kitreliy","poem":1},{"lineBreak":true},{"text":"t’i Talè, le hoe re: Vangò o tokona’eo,","poem":1},{"lineBreak":true},{"text":"hiezeñezeña’ o tsotsò’eo,","poem":1},{"lineBreak":true},{"text":"hampidemodemohañe o loha’eo;","poem":1},{"lineBreak":true},{"text":"vaho ho zamaneko am-pibara ty sisa’e;","poem":1},{"lineBreak":true},{"text":"tsy ho aman-tsehanga’e hioratse;","poem":1},{"lineBreak":true},{"text":"tsy hipoliotse ty honka’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndra t’ie mihaly mb’an-Tsikeokeok’ ao, le hakare’ ty tañako,","poem":1},{"lineBreak":true},{"text":"ndra t’ie manganike mb’an-dindi-mb’eo, hampizotsoeko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndra t’ie mietak’ an-kaboa’ i Karmele ao,","poem":1},{"lineBreak":true},{"text":"ho kodebèko le hakareko boak’ao;","poem":1},{"lineBreak":true},{"text":"ndra t’ie mikafitse am-pahaisahako ambane’ i riakey ao,","poem":1},{"lineBreak":true},{"text":"le ho tokaveko boak’ ao i fañaneñey","poem":1},{"lineBreak":true},{"text":"handrimita’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa ndra te misese mb’an-drohy aolo’","poem":1},{"lineBreak":true},{"text":"o rafelahi’eo mb’eo iereo,","poem":1},{"lineBreak":true},{"text":"boak’ añe ty hitokavako i fibaray","poem":1},{"lineBreak":true},{"text":"hanjamañe;","poem":1},{"lineBreak":true},{"text":"hentea’ o masokoo ho an-kankàñe,","poem":1},{"lineBreak":true},{"text":"fa tsy ho ami’ty hasoa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie mipaoke i taney t’Iehovà, Talè’ i màroy,","poem":1},{"lineBreak":true},{"text":"hitranaha’e, le miharovetse","poem":1},{"lineBreak":true},{"text":"iaby o mpimoneñeo;","poem":1},{"lineBreak":true},{"text":"ie hionjoñe manahake ty fisorotombahañe,","poem":1},{"lineBreak":true},{"text":"naho hizetse manahake","poem":1},{"lineBreak":true},{"text":"i Saka’ i Mitsraimeiy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I mpandranjy o fanonga’e andikerañeo,","poem":1},{"lineBreak":true},{"text":"naho nañoreñe i tafo’e bontoly","poem":1},{"lineBreak":true},{"text":"ambone’ ty tane toy;","poem":1},{"lineBreak":true},{"text":"I mikanjy o ranon-driakeo","poem":1},{"lineBreak":true},{"text":"vaho adoandoa’e an-tarehe’ ty tane toiy;","poem":1},{"lineBreak":true},{"text":"Iehovà ty tahina’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O ry ana’Israeleo, tsy ho hambañe amo tiri’ i Kosio amako hao nahareo? hoe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Tsy Izaho hao ty nañakatse Israele","poem":1},{"lineBreak":true},{"text":"an-tane’ i Mitsraime ao?","poem":1},{"lineBreak":true},{"text":"Naho o nte-Pilistio boake Kaftore","poem":1},{"lineBreak":true},{"text":"naho o nte-Arameo boake Kire?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Inao! miatreatre o fifeheañe lifotse hakeoo o fihaino’ Iehovà, Talèo,","poem":1},{"lineBreak":true},{"text":"vaho harotsako an-tarehe’ ty tane toy","poem":1},{"noteId":31},{"text":",","poem":1},{"lineBreak":true},{"text":"fa tsy ho fonga mongoreko","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Iakobe, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Inao te mandily iraho,","poem":1},{"lineBreak":true},{"text":"vaho ho tsararaheko amo kilakila’ ondatio","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Israele","poem":1},{"lineBreak":true},{"text":"manahake ty fitsararahañe tsako an-tsikelo,","poem":1},{"lineBreak":true},{"text":"fa leo voa’e raike tsy hipok’ an-tane.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Songa havetram-pibara","poem":1},{"lineBreak":true},{"text":"o mpanan-tahiñe am’ondatikoo,","poem":1},{"lineBreak":true},{"text":"o manao ty hoe: Tsy hitotofa’e, tsy hifanalaka ama’ay ty hankàñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Haonjoko amy andro zay ty kiboho’","poem":1},{"lineBreak":true},{"text":"i Davide nikoromakey","poem":1},{"lineBreak":true},{"text":"naho hakatoko o vinàkio;","poem":1},{"lineBreak":true},{"text":"naho hatroako o nihotrakeo,","poem":1},{"lineBreak":true},{"text":"vaho hamboareko manahake","poem":1},{"lineBreak":true},{"text":"tañ’andro taolo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le ho fanaña’ iareo ty sehanga’ i Dame","poem":1},{"noteId":32},{"lineBreak":true},{"text":"naho o kilakila’ ondaty kanjieñe","poem":1},{"lineBreak":true},{"text":"ami’ty añarakoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà mpanao izay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inao, ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te ho losore’ ty mpitrabake ty mpanatake","poem":1},{"lineBreak":true},{"text":"naho ty mpandia valoboke","poem":1},{"lineBreak":true},{"text":"ty mpitongy tabiry;","poem":1},{"lineBreak":true},{"text":"le hamopoke divay mamy o vohitseo,","poem":1},{"lineBreak":true},{"text":"hikararake boak’an-kaboañeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le hafoteko ty fandrohiza’","poem":1},{"lineBreak":true},{"text":"ondatiko Israeleo,","poem":1},{"lineBreak":true},{"text":"naho haore’ iereo o tanàn-taoloo,","poem":1},{"lineBreak":true},{"text":"himoneña’ iareo;","poem":1},{"lineBreak":true},{"text":"naho hambole tanem-baloboke,","poem":1},{"lineBreak":true},{"text":"naho hinoñe divay ama’e,","poem":1},{"lineBreak":true},{"text":"naho hañalahala golobon-traka,","poem":1},{"lineBreak":true},{"text":"vaho ho kamae’ iareo o voka’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie hamboleko an-tane’ iareo eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hombotañe amy tane’","poem":1},{"lineBreak":true},{"text":"natoloko iareoy ka,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà Andrianañahare.","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Ies 34:2, Iir 30:11, 46:28, Dan 2:44, Tsf 3:8, Kag 2:22, Lke 4:5-6","reference":{"chapter":9,"verse":8}},{"noteId":32,"caller":"+","text":"Fof 15:17","reference":{"chapter":9,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}