{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"DEU","translationId":"tdx_sle","name":"Indra-Tsara","commonName":"Indra-Tsara","title":"Indra-Tsara","order":5,"numberOfChapters":34,"sha256":"ee092e6f7a7e8348c71aa4f3379b13905fa4983ae552923a42bafc39ef2f0d4f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tdx_sle/DEU/34.json","totalNumberOfVerses":956},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Anokilaño ravembia ry likerañeo, le hivolan-draho;","poem":1},{"lineBreak":true},{"text":"Janjiño ry tane toy o entam-bavakoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ee te himiamia manahake ty fiavi’ i orañey o tarokoo,","poem":1},{"lineBreak":true},{"text":"le hitsopatsopake hoe zono o rehakoo, hambañe ami’ty fimitemiteha’e amo ahetseo naho ty finiziniziha’e amo rongoñeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa ho tseizeko ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"onjono ty hara’elahi’","poem":1},{"lineBreak":true},{"text":"i Andrianañaharen-tikañey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I Lamilamiy: Fiaintane o fitoloña’eo,","poem":1},{"lineBreak":true},{"text":"hene marentane o lala’eo:","poem":1},{"lineBreak":true},{"text":"Andrianañahare migahiñe tsy aman-tahy,","poem":1},{"lineBreak":true},{"text":"vañoñe naho vantañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa nanoa’iareo hamengohañe,","poem":1},{"lineBreak":true},{"text":"toe tsy ana’e ty amy hila’ iareo,","poem":1},{"lineBreak":true},{"text":"ty tariratse vìlañe naho mengoke tia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Izay hao ty añavaha’ areo am’ Iehovà ry dagola, ry ondaty tsi-mahilalao? tsy ie hao ty Rae’o nivily azo?","poem":1},{"lineBreak":true},{"text":"Tsy ie hao ty nitsene azo,","poem":1},{"lineBreak":true},{"text":"vaho nañoreñ’ azo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tiahio o andro haehaeo;","poem":1},{"lineBreak":true},{"text":"haraharao o taon-tariratse tsi-efao,","poem":1},{"lineBreak":true},{"text":"añontaneo aman-drae’o hanoroa’e,","poem":1},{"lineBreak":true},{"text":"naho aman-androanavi’o hitaroña’iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie zinara’ i Andindimoneñey amo rofokoo ty lova’ iareo;","poem":1},{"lineBreak":true},{"text":"naho naparaita’e o ana’ i Dameo,","poem":1},{"lineBreak":true},{"text":"le nefetsefere’e","poem":1},{"lineBreak":true},{"text":"ty ami’ty ia’ o ana’ Israeleo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa anjara’ Iehovà ondati’eo;","poem":1},{"lineBreak":true},{"text":"Iakobe ro anjara’ lova’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nifanendrek’ama’e an-diolio añe re,","poem":1},{"lineBreak":true},{"text":"am-babangoañe mangoañe mangolalaik’ ao;","poem":1},{"lineBreak":true},{"text":"nohoñe’e naho niatrak’aze,","poem":1},{"lineBreak":true},{"text":"nambena’e hoe t’ie saintem-pihaino’e","poem":1},{"noteId":28},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe vantio mitsobore ty traño’e,","poem":1},{"lineBreak":true},{"text":"mihefahefa ambone’ o ana’eo,","poem":1},{"lineBreak":true},{"text":"akopakopa’e o ela’eo,","poem":1},{"lineBreak":true},{"text":"vaho rambese’e añ’ela’eo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Iehovà avao ty niaolo aze,","poem":1},{"lineBreak":true},{"text":"ie tsy ama‘ndrahare ila’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nampijoñe’e ambonen-kaboa’","poem":1},{"lineBreak":true},{"text":"ty tane toy,","poem":1},{"lineBreak":true},{"text":"le nihinana’e ty voka’ o tetekeo;","poem":1},{"lineBreak":true},{"text":"nampininihe’e tantele an-tevañe ao,","poem":1},{"lineBreak":true},{"text":"naho menake am-bato-paik’ ao;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Habobon’añombe naho rononon’ose,","poem":1},{"lineBreak":true},{"text":"ty safom-bik’ añondry,","poem":1},{"lineBreak":true},{"text":"le ty kobatron- dia-rain-tirim-Basaneo,","poem":1},{"lineBreak":true},{"text":"o ose-lahio reketse","poem":1},{"lineBreak":true},{"text":"ty safom-boam-bare-bolè;","poem":1},{"lineBreak":true},{"text":"aman-diom-baloboke","poem":1},{"lineBreak":true},{"text":"ty ninoma’o divay mamore.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fe niha-vondrake t’Iesorone","poem":1},{"noteId":29},{"lineBreak":true},{"text":"le nikambia; niha-vondrake irehe,","poem":1},{"lineBreak":true},{"text":"niha-mateve, vaho nisometsètse;","poem":1},{"lineBreak":true},{"text":"napo’e t’i Andrianañahare nitsene aze,","poem":1},{"lineBreak":true},{"text":"namoea’e i Lamilamim-pandrombahañ’azey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nitrabihe’ iareo, hamarahia’e","poem":1},{"lineBreak":true},{"text":"o ‘ndrahare ila’eo,","poem":1},{"lineBreak":true},{"text":"nanikisiky aze an-draha tiva.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nisoroña’ iereo amo kokolampao,","poem":1},{"lineBreak":true},{"text":"amo ndrahare tsi’ieo","poem":1},{"lineBreak":true},{"text":"‘ndrahare tsy nifohi’ iareo,","poem":1},{"lineBreak":true},{"text":"‘ndrahare vaho niboak’ aniany","poem":1},{"lineBreak":true},{"text":"tsy nampañeveñe an-droae’ areo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Namoea’o ty Lamilamy nampiareñe azo,","poem":1},{"lineBreak":true},{"text":"nandikofa’o t’i Andrianañahare niolakolak’ am-pitsongoañe azo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie nivazohoe’ Iehovà, le niambohoa’e,","poem":1},{"lineBreak":true},{"text":"ami’ty fanigiha’ o ana-dahi’eo","poem":1},{"lineBreak":true},{"text":"naho o anak’ampela’eo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le hoe re: Haetako am’ iereo ty tareheko,","poem":1},{"lineBreak":true},{"text":"ho treako ty fimodoa’ iareo,","poem":1},{"lineBreak":true},{"text":"fa tariratse mengoke, ajaja tsy atokisañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nampamarahy ahiko iereo,","poem":1},{"lineBreak":true},{"text":"amo ‘ndrahare tsie’eo;","poem":1},{"lineBreak":true},{"text":"sigi’ iareo amo samposampon-drahao ty habosehako","poem":1},{"lineBreak":true},{"text":"aa le hampamarahieko ondati-tsie iereo;","poem":1},{"lineBreak":true},{"text":"hampisigiheko foko mengoke.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Afo misolebotse ty an-doakoroko ao,","poem":1},{"lineBreak":true},{"text":"mamorototo pak’ an-tsikeokeom-paha-sive ao,","poem":1},{"lineBreak":true},{"text":"ampangotomomohe’e ty tane toy","poem":1},{"lineBreak":true},{"text":"naho o vorohota’eo,","poem":1},{"lineBreak":true},{"text":"ampirehete’e o faham-bohitseo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hañoboñako hekoheko,","poem":1},{"lineBreak":true},{"text":"Ho kapaiheko am’ iereo o ana-palekoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho sihe’ ty halimpoañe iereo,","poem":1},{"lineBreak":true},{"text":"habotse’ ty lel-afo;","poem":1},{"lineBreak":true},{"text":"naho ty harotsahañe mafaitse.","poem":1},{"lineBreak":true},{"text":"Hiraheko ama’e ty famotsim-biby,","poem":1},{"lineBreak":true},{"text":"ty vorehe’ o milaly an-debokeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hampandala ty fibara o alafe’eo,","poem":1},{"lineBreak":true},{"text":"firevendreveñañe ty añate ao","poem":1},{"lineBreak":true},{"text":"songa zamane’e ty ajalahy","poem":1},{"lineBreak":true},{"text":"naho ty tomoenono, ty anak’ajaja,","poem":1},{"lineBreak":true},{"text":"vaho ty androanavy ama-maroi-foty.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nataoko ho nampimodoeko,","poem":1},{"lineBreak":true},{"text":"vaho ho najiheko am’ondatio","poem":1},{"lineBreak":true},{"text":"ty faniahiañe iareo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fe nimahimahiñeko","poem":1},{"lineBreak":true},{"text":"ty fiforoforon-drafelahi’e,","poem":1},{"lineBreak":true},{"text":"hera ho hafa hente o malaiñe iareoo,","poem":1},{"lineBreak":true},{"text":"kera hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ty fità’ay ro abo, fa tsy:","poem":1},{"lineBreak":true},{"text":"Iehovà ty nanao ie iaby zao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fifeheañe po-anatse iereo,","poem":1},{"lineBreak":true},{"text":"toe ondaty po-faharendrehañe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ee t’ie ho nahihitse,","poem":1},{"lineBreak":true},{"text":"soa te ho naharendreke,","poem":1},{"lineBreak":true},{"text":"le ho nitsikarahe’iareo ty figadoña’e.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Akore ty hañinjafa’ ty raike ty arivo, ty hampivoratsahe’ ty roe ty aman’ale’e, naho tsy naleta’ i Lamilami’ iareoy, naho tsy Iehovà ty nanese iereo?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Toe tsy i Lamilami’aiy ty vato’ iareo,","poem":1},{"lineBreak":true},{"text":"ndra o rafelahi’aio ro mahatsikarake izay.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Boak’ am-bahe’ i Sedome ty vahe’ iareo,","poem":1},{"lineBreak":true},{"text":"boak’an-tete’ i Amorà ao;","poem":1},{"lineBreak":true},{"text":"valòbok’ afero ty valòbo’ iareo, mafaitse ty angaroza’ iareo;","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"vorem-pañaneñe ty divai’ iareo","poem":1},{"lineBreak":true},{"text":"ty voren-kankàm-pandrefeala.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tsy mihaja amako ao hao zao?","poem":1},{"lineBreak":true},{"text":"he mihily an-korojiko ao?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ahiko o vale-fateo naho ty avake;","poem":1},{"lineBreak":true},{"text":"mbe hibolatitse o fandia’ iareoo,","poem":1},{"lineBreak":true},{"text":"fa antitotse ty andron-kankà’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho malisa ty fihelaña’ o hifetsak’ am’iereoo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Iehovà ty hizaka ondati’eo","poem":1},{"lineBreak":true},{"text":"le hiferenaiña’e o mpitoro’eo","poem":1},{"lineBreak":true},{"text":"ie vazoho’e te ritse ty haozara’e","poem":1},{"lineBreak":true},{"text":"naho tsy aman-tsehanga’e,","poem":1},{"lineBreak":true},{"text":"ke ty mirohy he ty midada;","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Le hanao ty hoe re:","poem":1},{"lineBreak":true},{"text":"Aia o ndrahare’ iareoo,","poem":1},{"lineBreak":true},{"text":"i vato niatoa’ iareoy?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ia ty nilintseñe ty safom-pisoroña’ iareo,","poem":1},{"lineBreak":true},{"text":"naho nigenoke ty divain-enga rano’e?","poem":1},{"lineBreak":true},{"text":"angao hitroatse iereo hañolora’e anahareo.","poem":1},{"lineBreak":true},{"text":"Apoho re ho fitsoloha’ iareo.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Inao te izaho, izaho avao ro ie,","poem":1},{"lineBreak":true},{"text":"tsy ama’ ndrahare hatovoñ’ahy:","poem":1},{"lineBreak":true},{"text":"izaho ty mamono, izaho ty mameloñe;","poem":1},{"lineBreak":true},{"text":"mandratse iraho le mañamelañe;","poem":1},{"lineBreak":true},{"text":"tsy eo ty mahasintoñe ty an-tañako.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Aonjoko mb’andikerañe ey ty tañako","poem":1},{"lineBreak":true},{"text":"manao ty hoe, veloñe nainai’e iraho.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ie sioñeko i fibarako mipelatsey,","poem":1},{"lineBreak":true},{"text":"naho mandrambe zaka ty tañako;","poem":1},{"lineBreak":true},{"text":"le ho valeako o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"vaho hondroheko o malaiñ’ Ahikoo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Ho mamoeko an-dio o ana-palekoo,","poem":1},{"lineBreak":true},{"text":"le hamotseke nofotse ty fibarako;","poem":1},{"lineBreak":true},{"text":"ty lio’ o zinamañeo naho o an-drohio;","poem":1},{"lineBreak":true},{"text":"boak’ an-doha miogogo’","poem":1},{"lineBreak":true},{"text":"o mpiaolo’ i rafelahiio.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ipoñafo sabo ondati’eo, ry kilakila ondaty,","poem":1},{"lineBreak":true},{"text":"fa ho valea’e fate ty lio’ o mpitoro’eo,","poem":1},{"lineBreak":true},{"text":"le havaha’e an-keloke o rafelahi’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho jebañe’e ty tane ondati’eo.","poem":1}]},{"type":"verse","number":44,"content":["Nimb’eo amy zao t’i Mosè vaho hene nisaontsie’e an-tsabo an-dravembia’ ondatio i tsara zay, ie naho Iehosoa ana’ i None."]},{"type":"verse","number":45,"content":["Aa ie nagado’ i Mosè i hene fitaroña’e am’ Israele rezay,"]},{"type":"verse","number":46,"content":["le hoe re am’ iereo: Fonga faharo añ’ arofo’ areo ao ze tsara taroñeko androany, le ampañambeno o amori’ areoo o hene enta’ ty Hake toio, hañorike ze hene tsara amy Hake ao."]},{"type":"verse","number":47,"content":["Ko atao’ areo ho tsara kafoake ama’ areo, amy t’ie o havelo’ areoo, le ama’e ty hahalava andro anahareo amy tane añaveloa’ areo ampitsa­hañe Iardeney hitavana’ areoy."]},{"type":"verse","number":48,"content":["Le hoe ty nitsara’ Iehovà amy Mosè amy andro zay."]},{"type":"verse","number":49,"content":["Mañambonea mb’am-bohitse Avarime mb’eo pak’ am-bohi-Nebo an-tane’ i Moabe tandrife Ieriko añe; le isaho ty tane’ Kanàne atoloko amo ana’ Israeleo ho fanañañe;"]},{"type":"verse","number":50,"content":["le mihomaha amy vohitse itroara’oy, hitontona’o am’ondati’oo, hambañe ami’ty nivetraha’ i Aharone, rahalahi’o e Hore añe vaho nifanontoñe am’ondati’eo;"]},{"type":"verse","number":51,"content":["amy t’ie nandilatse amako añivo’ o ana’ Israeleo an-drano’ i Meribà-Kadese eo, an-dratraratra’ i Zine añe; izaho tsy navahe’o añivo’ o ana’ Israeleo."]},{"type":"verse","number":52,"content":["Ho talake’o eñe i taney, fe tsy homba’o o tane atoloko amo ana’ Israeleoo."]}],"footnotes":[{"noteId":28,"caller":"+","text":"Zek 2:8","reference":{"chapter":32,"verse":10}},{"noteId":29,"caller":"+","text":"Iesorone: Tahina rai’ Israely","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/tdx_sle/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}