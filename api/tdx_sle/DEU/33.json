Iakòbe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie ty ni-mpanjaka’ Iesorone,","poem":1},{"lineBreak":true},{"text":"te nivory ty mpiaolo’ ondatio,","poem":1},{"lineBreak":true},{"text":"rekets’ o fifokoa’ Israeleo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ee te ho veloñe t’i Reobene","poem":1},{"lineBreak":true},{"text":"le tsy hihomake,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho tsi-ampe ondati’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le hoe re ty am’ Iehoda:","poem":1},{"lineBreak":true},{"text":"Janjiño ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ Iehoda,","poem":1},{"lineBreak":true},{"text":"endeso mb’am’ ondati’eo mb’eo.","poem":1},{"lineBreak":true},{"text":"Hitoloñe aze o fità’eo,","poem":1},{"lineBreak":true},{"text":"le Ihe ty hañolots’aze amo rafelahi’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le hoe ty nanoe’e i Levy:","poem":1},{"lineBreak":true},{"text":"Ee te ho amy Masi’oy","poem":1},{"lineBreak":true},{"text":"ty Tomime’o naho ty Orime’o;","poem":1},{"lineBreak":true},{"text":"i niventea’o e Masà naho","poem":1},{"lineBreak":true},{"text":"nitsohe’o an-drano’ i Meribày;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"hoe re ty aman-drae’e naho i rene’e:","poem":1},{"lineBreak":true},{"text":"‘Amoeako.’","poem":1},{"lineBreak":true},{"text":"tsy nihaoñe’e o roahalahi’eo,","poem":1},{"lineBreak":true},{"text":"nialik’ama’e o ana’eo;","poem":1},{"lineBreak":true},{"text":"amy te norihe’e o tsara’oo","poem":1},{"lineBreak":true},{"text":"vaho nambena’e i fañina’oy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hanare’ iereo am’Iakobe o lili’oo,","poem":1},{"lineBreak":true},{"text":"naho am’Israele i Tsara’oy;","poem":1},{"lineBreak":true},{"text":"le hapo’ iareo añatrefa’o eo ty emboke, naho soroñe añoñe an-kitreli’o eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O ry Iehovà, tahio ty fijangana’e","poem":1},{"lineBreak":true},{"text":"naho ty fitoloñam-pità’e,","poem":1},{"lineBreak":true},{"text":"fofoho am-baniañe o miatreatre azeo,","poem":1},{"lineBreak":true},{"text":"naho o malaiñe azeo,","poem":1},{"lineBreak":true},{"text":"tsy hitroara’ iareo ka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le hoe ty nanoe’e i Beniamine,","poem":1},{"lineBreak":true},{"text":"Himoneñe añ’ila’e eo am-pierañerañañe","poem":1},{"lineBreak":true},{"text":"i kokoa’ Iehovày;","poem":1},{"lineBreak":true},{"text":"saroña’e lomoñandro,","poem":1},{"lineBreak":true},{"text":"ie mimoneñe añivo’ o soro’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le hoe ty nano’e Iosefe:","poem":1},{"lineBreak":true},{"text":"Ho tahie’ Iehovà ty tane’e,","poem":1},{"lineBreak":true},{"text":"amo vara’ fanjàka’ i likerañeio, i mikay,","poem":1},{"lineBreak":true},{"text":"amy laleke mitrokotroko ambane’ey,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naho amo fivokara talango’ i àndroio, naho amo lengo’e banabanae’ i volañeio,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"naho amo hatsomerentsere’ o vohitse haehaeoo,","poem":1},{"lineBreak":true},{"text":"amo vara fanjàka’ o tamboho hatrela’eoo;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"naho amo harea’ ty tane toy","poem":1},{"lineBreak":true},{"text":"amy halifora’eio,","poem":1},{"lineBreak":true},{"text":"naho amy fatariha’","poem":1},{"lineBreak":true},{"text":"i nimoneñe an-drongoñe aoiy,","poem":1},{"lineBreak":true},{"text":"ho tata ami’ty añ’ambone’ Iosefe, ambone’ ty añambone’ i miambak’ amo roandrian-droahalahi’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Añombelahy ty valohan’ ana’e,","poem":1},{"lineBreak":true},{"text":"volonahetse ty aze;","poem":1},{"lineBreak":true},{"text":"tsifan-drimo o tsifa’eo,","poem":1},{"lineBreak":true},{"text":"ama’e ty handronjeronjea’e ondaty iabio sikal’añ’olo-ty tane toy,","poem":1},{"lineBreak":true},{"text":"ie o aleale’ i Efraimeo,","poem":1},{"lineBreak":true},{"text":"naho o arivo-arivo’ i Menasèo.","poem":1}]},{"type":"verse","number":18,"content":["Le hoe ty nanoe’e i Zebolone:",{"text":"Mirebeha ry Zebolone, amo fionjona’oo","poem":1},{"lineBreak":true},{"text":"naho ry Isakhare, amo kiboho’oo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho koihe’ iareo","poem":1},{"lineBreak":true},{"text":"homb’ amy haboañey mb’eo ondatio,","poem":1},{"lineBreak":true},{"text":"eo ro hañenga’ iareo soron-kavañonañe;","poem":1},{"lineBreak":true},{"text":"fa ho karae’ iareo ty havokara’ o riakeo,","poem":1},{"lineBreak":true},{"text":"naho ty vara mikafitse am-paseñe ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le hoe ty nanoe’e i Gade,","poem":1},{"lineBreak":true},{"text":"Soa tata ty mampitratrañake ty a i Gade;","poem":1},{"lineBreak":true},{"text":"hoe liona ty imoneña’e,","poem":1},{"lineBreak":true},{"text":"rimite’e ty fitàñe naho ty hevo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rinambe’e ho aze ty anjara valoha’e;","poem":1},{"lineBreak":true},{"text":"Fa tao ty nañajañe ty anjaram-pandily.","poem":1},{"lineBreak":true},{"text":"Naho nivory ty mpiaolo’ ondatio","poem":1},{"lineBreak":true},{"text":"le ie ty nitoloñe ty zaka-to’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho o fepe’eo am’ Israele.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Le hoe ty nanoe’e i Dane,","poem":1},{"lineBreak":true},{"text":"anan-diona t’i Dane,","poem":1},{"lineBreak":true},{"text":"mitsamboañe boak’e Basane añe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Le hoe ty nano’e i Naftalý,","poem":1},{"lineBreak":true},{"text":"O Naftalý: Ihe ene-pañisohañeo,","poem":1},{"lineBreak":true},{"text":"atsake ty fitahia’ Iehovà,","poem":1},{"lineBreak":true},{"text":"lovao i riakey naho ty atimo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Le hoe ty nano’e i Asere,","poem":1},{"lineBreak":true},{"text":"soa-tata te amy ze atao anake t’i Asere,","poem":1},{"lineBreak":true},{"text":"hisohe’ o rahalahi’eo;","poem":1},{"lineBreak":true},{"text":"hajo’e an-tsolik’ ao ty fandia’e.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Viñe naho torisìke ty ho sikada’o,","poem":1},{"lineBreak":true},{"text":"vaho hañeneke o andro’oo ty haozara’o.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tsy añohatse t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ry Iesorone,","poem":1},{"lineBreak":true},{"text":"i miningitse andikerañey hañolora’e,","poem":1},{"lineBreak":true},{"text":"naho amo rahoñeo am-bolonahe’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fitsolohañe t’i Andrianañahare Haehae,","poem":1},{"lineBreak":true},{"text":"ambane eo o fitàñe nainai’eo.","poem":1},{"lineBreak":true},{"text":"Hasio’e aolo’o mb’eo o rafelahi’oo","poem":1},{"lineBreak":true},{"text":"le hanao ty hoe, ‘Arotsaho,’","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mimoneñe am-bangiñe soa’aro ao t’Israele,","poem":1},{"lineBreak":true},{"text":"miereñereñe ty rano manganahana’ Iakobe, an-tanen-tsako naho divay vao;","poem":1},{"lineBreak":true},{"text":"eka, mampitsopatsopa-jono ama’e o andindi’ey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Haha irehe ry Israele,","poem":1},{"lineBreak":true},{"text":"ia ty mañirinkiriñe azo?","poem":1},{"lineBreak":true},{"text":"Ondaty rinomba’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty Fikalan-defo-pañolorañe azo,","poem":1},{"lineBreak":true},{"text":"naho ty Fibara-pisengea’o,","poem":1},{"lineBreak":true},{"text":"le hitsilofìñe aolo’o ao o rafelahi’oo,","poem":1},{"lineBreak":true},{"text":"vaho ho lialià’o iaby o toets-abo’ iareoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}