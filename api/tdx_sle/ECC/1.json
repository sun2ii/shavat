{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ty taro’ i Mpañokey,","poem":1},{"lineBreak":true},{"text":"ana’ i Davide, mpanjaka e Ierosalaime ao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hakafoahan-kafoake, hoe i Mpañokey,","poem":1},{"lineBreak":true},{"text":"Hakafoahan-kafoake! Fonga kafoake!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ino ty tombo’e ho a ondatio","poem":1},{"lineBreak":true},{"text":"amo fifanehafa’e ambane’ i àndroy?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mihelañe ty tariratse raike,","poem":1},{"lineBreak":true},{"text":"mbore limbezen-tariratse,","poem":1},{"lineBreak":true},{"text":"fe nainai’e eo ty tane toy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manjirike ka i àndroy,","poem":1},{"lineBreak":true},{"text":"mitsofotse i àndroy,","poem":1},{"lineBreak":true},{"text":"mihiririñe mb’am-panjiriha’e añe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitioke mañatimo,","poem":1},{"lineBreak":true},{"text":"le mibalike mañavaratse;","poem":1},{"lineBreak":true},{"text":"mikariokariok’ avao i tiokey,","poem":1},{"lineBreak":true},{"text":"vaho mimpoly amo fiaria’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Songa mivariñe mb’an-driake mb’eo","poem":1},{"lineBreak":true},{"text":"o sakao fe tsy atseke i riakey;","poem":1},{"lineBreak":true},{"text":"mb’amy fikararaha’ o torahañeoy,","poem":1},{"lineBreak":true},{"text":"le mb’eo avao ty fikararaha’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hene mahamamake,","poem":1},{"lineBreak":true},{"text":"tsy lefe’ ondaty volañeñe,","poem":1},{"lineBreak":true},{"text":"tsy mahaetsa-pihaino t’ie vazoho,","poem":1},{"lineBreak":true},{"text":"mbore tsy mahaenen-dravembia","poem":1},{"lineBreak":true},{"text":"te ijanjiñañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mbe ho avy indraike i fa añey,","poem":1},{"lineBreak":true},{"text":"naho mbe hanoeñe avao ze fa nanoeñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy ambane’ i àndroy","poem":1},{"lineBreak":true},{"text":"ty atao vao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Eo hao ty mete hanoeñe ty hoe,","poem":1},{"lineBreak":true},{"text":"Heheke! vao itoy? Ie fa teo avao,","poem":1},{"lineBreak":true},{"text":"haehae taolon-tikañe añe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsy tiahy o raha taoloo,","poem":1},{"lineBreak":true},{"text":"naho o raha hifetsakeo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hahatiahy irezay","poem":1},{"lineBreak":true},{"text":"o hanonjohio.","poem":1}]},{"type":"verse","number":12,"content":["Izaho, i mpañokey, le fa mpanjaka Israele e Ierosalaime ao,"]},{"type":"verse","number":13,"content":["le nimanean-troko ty hañotsohotso naho hikodebe an-kihitse ze hene fitoloñañe ambanen-dike­rañe atoa; toe tolon-draha mahamokotse ty natolon’ Añahare am’ondatio hifanehafa’e."]},{"type":"verse","number":14,"content":["Nitreako iaby ze fitoloñañe ambane’ i àndroy; le hehe t’ie fonga kafoake vaho fañeañan-tioke."]},{"type":"verse","number":15,"content":[{"text":"Tsy mete ahity ty mengoke,","poem":1},{"lineBreak":true},{"text":"vaho tsy lefe iaheñe ty tsy eo.","poem":1}]},{"type":"verse","number":16,"content":["Hoe iraho am-batako: Ingo fa natontoko mandikoatse ze hene mpifehe’ Ierosalaime taolo ahy ty fahaoniñañe ra’elahy; vaho nandifotse ty troko ty hihitse naho hilala."]},{"type":"verse","number":17,"content":["Le nampitoloñeko ty troko hahaoniña’e hihitse naho hahafohiñe ty hadagolà naho ty hagegeañe. Nirendreko t’ie fañeañan-tioke ka."]},{"type":"verse","number":18,"content":[{"text":"Amy te minday hasosoram-bey","poem":1},{"lineBreak":true},{"text":"ty hihitse maro,","poem":1},{"lineBreak":true},{"text":"vaho mampitombo haoreañe","poem":1},{"lineBreak":true},{"text":"ty fitomboan-kilala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}