{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Mampitrotrotse ty menam-pañemboke ty laletse mate; le mavesatse te ami’ty hihitse naho ty asiñe, ty hagegeañe kede."]},{"type":"verse","number":2,"content":["Mitolike mb’an-kavàna ty arofo’ i mahihitsey, mb’ankavia ka ty tro’ i dagolay."]},{"type":"verse","number":3,"content":["Ndra te mijelanjelañe an-dalañe eo ty derendereñe, kanao po-hilala, aboa’e amy màroy ty hagegea’e."]},{"type":"verse","number":4,"content":["Naho miforoforo ama’o ty haviñera’ ty mpifehe, ko apo’o ty toe’o, amy te mañafa-tsirìka-mena ty hamora-fo."]},{"type":"verse","number":5,"content":["Eo ty haratiañe nitendrek’ahy ambane’ i àndroy, hoe lilatse aboa’ ty mpifehe."]},{"type":"verse","number":6,"content":[{"text":"Onjoneñe mb’an-toetse ambone","poem":1},{"lineBreak":true},{"text":"ty seretse maro,","poem":1},{"lineBreak":true},{"text":"ie mitozoke ambane eo o mpañalealeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nahatrea ondevo miningi-tsoavala iraho,","poem":1},{"lineBreak":true},{"text":"vaho ty ana-donake","poem":1},{"lineBreak":true},{"text":"mañavelo an-tane eo hoe ondevo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mete hivariñe ama’e ao","poem":1},{"lineBreak":true},{"text":"ty mihaly koboñe;","poem":1},{"lineBreak":true},{"text":"naho mete hehere’ ty mereñe","poem":1},{"lineBreak":true},{"text":"ze misorodidy kijoly.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mete joie’ ty vato ty mihaly aze;","poem":1},{"lineBreak":true},{"text":"le mete hizo fere ty mampitserake hatae.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naho malomo ty viñe,","poem":1},{"lineBreak":true},{"text":"ie tsy sioña’e ty lela’e,","poem":1},{"lineBreak":true},{"text":"le añ’ozatse ambone ty ifanehafa’e;","poem":1},{"lineBreak":true},{"text":"lombolombo’e ty hihitse mahatafetetse.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie hehere’ ty mereñe","poem":1},{"lineBreak":true},{"text":"tsy nampipendreñeñe;","poem":1},{"lineBreak":true},{"text":"le an-koheke i mpitroboy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Matarike o entam-­palie’ i mahihitseio,","poem":1},{"lineBreak":true},{"text":"fe mampibotseke ty dagola o soñi’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mifototse an-kagegeañe","poem":1},{"lineBreak":true},{"text":"o fivolam-bava’eo,","poem":1},{"lineBreak":true},{"text":"naho migadon-ko haratian-dagola;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mangaradadak’ avao ty minè.","poem":1},{"lineBreak":true},{"text":"Tsy fohi’ ondatio ty ho zoeñe,","poem":1},{"lineBreak":true},{"text":"ia ty mahatalily ama’e ty hanonjohy aze?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Akore ty hamokora’ i dagolay","poem":1},{"lineBreak":true},{"text":"amy fitromaha’ey, kanao tsy fohi’e","poem":1},{"lineBreak":true},{"text":"ty homba’e mb’an-drova mb’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hoy hoy ty ama’o, ry tane,","poem":1},{"lineBreak":true},{"text":"naho ajaja ty mpanjaka’o","poem":1},{"lineBreak":true},{"text":"vaho mpanao bedidake maraindray","poem":1},{"lineBreak":true},{"text":"o ana-dona’oo!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Haha irehe ry tane,","poem":1},{"lineBreak":true},{"text":"te roandriañe ty mpanjaka’o,","poem":1},{"lineBreak":true},{"text":"vaho mikama ami’ty evae’e","poem":1},{"lineBreak":true},{"text":"o ana-dona’oo hihaozara’e","poem":1},{"lineBreak":true},{"text":"fa tsy ty himamoa’e!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Havotroañe ty mahakolemake tafo;","poem":1},{"lineBreak":true},{"text":"tañañe ledra’e","poem":1},{"lineBreak":true},{"text":"ty mahatsopatsopake traño.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Natao hampiankahake ty sabadidake;","poem":1},{"lineBreak":true},{"text":"te hahafale fiay ty divay,","poem":1},{"lineBreak":true},{"text":"vaho te hamale ze he’e ty drala.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"tovo’e: Ko mamatse ty mpanjaka","poem":1},{"lineBreak":true},{"text":"am-pitsakorea’o ao,","poem":1},{"lineBreak":true},{"text":"naho ty mpiefoefo","poem":1},{"lineBreak":true},{"text":"an-trañom-pandrea’o ao;","poem":1},{"lineBreak":true},{"text":"ke hinday ty feo’o i voron-tiokey,","poem":1},{"lineBreak":true},{"text":"hera haboele’ i amañ’elatsey i enta’oy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}