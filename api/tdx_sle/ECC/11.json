{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ahifiho ambone’ o ranoo ty mofo’o,","poem":1},{"lineBreak":true},{"text":"le ho tendrek’azo andro maro añe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zarao fito o vara’oo, he valo,","poem":1},{"lineBreak":true},{"text":"fa tsy fohi’o ze hankàñe","poem":1},{"lineBreak":true},{"text":"mete hifetsak’ an-tane atoy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie milodolodo o rahoñeo,","poem":1},{"lineBreak":true},{"text":"le adoa’e mb’an-tane atoy ty orañe;","poem":1},{"lineBreak":true},{"text":"aa ke mihorokodoboke mañatimo","poem":1},{"lineBreak":true},{"text":"ty hatae, he mañavaratse,","poem":1},{"lineBreak":true},{"text":"le amy ideboña’ey ty handrea’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy hitongy ty mpisamba tioke;","poem":1},{"lineBreak":true},{"text":"vaho tsy hanatake ty mpijilo rahoñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kanao tsy apota’o ty lala’ i tiokey,","poem":1},{"lineBreak":true},{"text":"naho tsy fohi’o ty fitiria’","poem":1},{"lineBreak":true},{"text":"o taolañe an-kovi’ i mivesatsey,","poem":1},{"lineBreak":true},{"text":"le tsy fohi’o ka ty fitoloñan’ Añahare","poem":1},{"lineBreak":true},{"text":"mpamboatse ze he’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tongiso maraindray o tabiri’oo,","poem":1},{"lineBreak":true},{"text":"vaho ko mampi-po pitàñe te hariva;","poem":1},{"lineBreak":true},{"text":"amy te tsy fohi’o ty ho lefe,","poem":1},{"lineBreak":true},{"text":"ke ty etoañe ke i eroañey,","poem":1},{"lineBreak":true},{"text":"hera ho soa iaby iereo roroe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mamy o hazavàñeo,","poem":1},{"lineBreak":true},{"text":"naho mahafale fihaino","poem":1},{"lineBreak":true},{"text":"ty mahaoniñe i àndroy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa ndra te veloñe maro-taoñe t’indaty","poem":1},{"lineBreak":true},{"text":"ee te hirebeha’e iaby,","poem":1},{"lineBreak":true},{"text":"le ho tiahi’e abey","poem":1},{"lineBreak":true},{"text":"o andron-kamoromoroñañeo,","poem":1},{"lineBreak":true},{"text":"t’ie ho maro,","poem":1},{"lineBreak":true},{"text":"toe hakoahañ’ iaby ty ho avy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mandià taroba ry ajalahy,","poem":1},{"lineBreak":true},{"text":"ihe mbe tora’e,","poem":1},{"lineBreak":true},{"text":"ee te hampahaehak’ azo ty tro’o","poem":1},{"lineBreak":true},{"text":"amo andron-katora’oo.","poem":1},{"lineBreak":true},{"text":"Oriho ty fisalalam-po’o","poem":1},{"lineBreak":true},{"text":"naho ty fañiria’ o maso’oo,","poem":1},{"lineBreak":true},{"text":"fe mahafohina t’ie hampiatrefen’","poem":1},{"lineBreak":true},{"text":"Añahare an-jaka ty amy hene rezay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ano soike o halorèan-tro’oo,","poem":1},{"lineBreak":true},{"text":"vaho ampihankaño ami’ty sandri’o","poem":1},{"lineBreak":true},{"text":"ty falovilovia’e;","poem":1},{"lineBreak":true},{"text":"fa toe mihelañe ty hatorañe","poem":1},{"lineBreak":true},{"text":"naho ty haañom-piaiñe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}