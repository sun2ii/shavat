{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Tiahio i nitsene azo","poem":1},{"lineBreak":true},{"text":"an-tsan-kajalahi’o,","poem":1},{"lineBreak":true},{"text":"aolo’ ty fivotraha’ o andron-kasotriañeo,","poem":1},{"lineBreak":true},{"text":"naho ty hitotofa’ i taoñe hanoe’o ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy mahafale ahiko irezay;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"aolo’ ty fañamaieñañe ty hazava’","poem":1},{"lineBreak":true},{"text":"i àndroy naho i volañey vaho o vasiañeo,","poem":1},{"lineBreak":true},{"text":"naho ty fibaliha’ o rahoñeo","poem":1},{"lineBreak":true},{"text":"ie fa añe i orañey;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"amy andro hihondrahondrà’","poem":1},{"lineBreak":true},{"text":"o mpañambeñ’ anjombao,","poem":1},{"lineBreak":true},{"text":"naho hibokobokoha’ ondaty maozatseo,","poem":1},{"lineBreak":true},{"text":"naho hitroara’ o mpandisañeo","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy ampe,","poem":1},{"lineBreak":true},{"text":"vaho mihamaieñe tsy hahaisaha’","poem":1},{"lineBreak":true},{"text":"ondaty mitilihitse amo lalan-kedeo;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ie mirindriñe o lalam-ban-dalam-beio,","poem":1},{"lineBreak":true},{"text":"naho migeongeoñe avao","poem":1},{"lineBreak":true},{"text":"o vato fandisanañeo,","poem":1},{"lineBreak":true},{"text":"naho mahatsekake ondaty","poem":1},{"lineBreak":true},{"text":"ty feom-boroñe,","poem":1},{"lineBreak":true},{"text":"vaho hene namptsiñeñe o anak’ ampela mpibekoo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"eka, mahahembañe ondatio","poem":1},{"lineBreak":true},{"text":"te an-kaboañe ey,","poem":1},{"lineBreak":true},{"text":"mirevendreveñe t’ie an-damoke eo;","poem":1},{"lineBreak":true},{"text":"mikò-foty o mahabiboo,","poem":1},{"lineBreak":true},{"text":"fe mikozozotse avao i valalay,","poem":1},{"lineBreak":true},{"text":"vaho milesa i vahen’ amaloy;","poem":1},{"lineBreak":true},{"text":"amy te migodañe mb’añ’akiba’e","poem":1},{"lineBreak":true},{"text":"nainai’e mb’eo ondatio,","poem":1},{"lineBreak":true},{"text":"ie midraidraitse an-dalañeo","poem":1},{"lineBreak":true},{"text":"o mpandàlao;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"aolo’ te tampake i fole volafotiy,","poem":1},{"lineBreak":true},{"text":"naho foy i korobo volamenay,","poem":1},{"lineBreak":true},{"text":"naho señak’ am-bava’ i vovoñey","poem":1},{"lineBreak":true},{"text":"ty fitovy,","poem":1},{"lineBreak":true},{"text":"naho nipozak’ an-kadaha eo","poem":1},{"lineBreak":true},{"text":"i larom-pitarikey,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"naho mibalike mb’an-tane","poem":1},{"lineBreak":true},{"text":"niboaha’e ao i debokey,","poem":1},{"lineBreak":true},{"text":"vaho mimpoly mb’","poem":1},{"lineBreak":true},{"text":"aman’Andrianamboatse azey","poem":1},{"lineBreak":true},{"text":"i kofòkey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Habibin-kakafoahañe izay,","poem":1},{"lineBreak":true},{"text":"hoe t’i Mpañoke; kila kafoake.","poem":1}]},{"type":"verse","number":9,"content":["Tovo i hihi’ey, nanare’ i Mpañokey hilala ondatio, ie nandanja naho nañotsohotso vaho nañity razan-tsaontsy maro."]},{"type":"verse","number":10,"content":["Nitsoeke fisaontsy mahafale i Mpañokey, vaho nanokitse tsara-to am-palangesañe."]},{"type":"verse","number":11,"content":["Hoe fitsi­poke ty fisaontsi’ o mahihitseo, toe fati-by soa oreñe o razan-drehakeo, o natolo’ i Mpiarak’ añondriio."]},{"type":"verse","number":12,"content":[{"text":"Aa, le mitaoa ry anake","poem":1},{"lineBreak":true},{"text":"amo mandikoatse irezaio,","poem":1},{"lineBreak":true},{"text":"fa tsy ho modo ty fanoañe boke maro,","poem":1},{"lineBreak":true},{"text":"vaho mahamamake o nofotseo","poem":1},{"lineBreak":true},{"text":"ty halako-pihotsohotsoañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ty figadoña’e, ie hene jinanjiñe:","poem":1},{"lineBreak":true},{"text":"Mañeveña aman’Añahare,","poem":1},{"lineBreak":true},{"text":"vaho ambeno o lili’eo;","poem":1},{"lineBreak":true},{"text":"ho a’ ze kila ondaty izay.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hendesen’ Añahare mb’an-jaka","poem":1},{"lineBreak":true},{"text":"ze hene sata, ze he’e mietake,","poem":1},{"lineBreak":true},{"text":"ndra t’ie soa ndra te raty.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}