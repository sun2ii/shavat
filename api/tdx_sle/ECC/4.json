{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Aa le niharaharaeko indraike ze forekekeñe iaby ambane’ i àndroy:",{"text":"hehe ty ranomaso’ o forekekeñeo,","poem":1},{"lineBreak":true},{"text":"ie tsy amam-pañohò;","poem":1},{"lineBreak":true},{"text":"naho am-pità’ o mpamorekekeo","poem":1},{"lineBreak":true},{"text":"ty hafatrarañe;","poem":1},{"lineBreak":true},{"text":"f’ie tsy amam-pañimba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aa le nandrenge o vilasy","poem":1},{"lineBreak":true},{"text":"fa nihomakeo iraho,","poem":1},{"lineBreak":true},{"text":"ambone’ o veloñe mbe amañ’aiñeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eka, lombolombo i roe rey","poem":1},{"lineBreak":true},{"text":"ty mbe lia’e tsy eo,","poem":1},{"lineBreak":true},{"text":"ie mbe tsy nahaoniñe ty sata-raty","poem":1},{"lineBreak":true},{"text":"anoeñe ambane’ i àndroy.","poem":1}]},{"type":"verse","number":4,"content":["Nitreako indraike te o fitoloñañe iabio naho ze tolon-draha mahatafe­tetse, le voka’ ty fifampitsikiriha’ ondaty naho i rañe’ey. Hakafoahañe naho fañeañan-tioke ka zao."]},{"type":"verse","number":5,"content":[{"text":"Mamihim-pitañe ty dagola,","poem":1},{"lineBreak":true},{"text":"vaho abotse’e ty nofo’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hàmake ty fianjiñañe mahapea-pitàñe,","poem":1},{"lineBreak":true},{"text":"ta ty fitàn-droe pea","poem":1},{"lineBreak":true},{"text":"fitromahañe naho fañeañan-tioke.","poem":1}]},{"type":"verse","number":7,"content":["Nenteako indraike o hakafoahañe ambane’ i àndroy."]},{"type":"verse","number":8,"content":[{"text":"Teo ty raike tsy amam-paha-roe;","poem":1},{"lineBreak":true},{"text":"toe tsy nanañ’ anake, tsy aman-drahalahy:","poem":1},{"lineBreak":true},{"text":"fe tsy mbia tsy heneke o fitoloña’eo;","poem":1},{"lineBreak":true},{"text":"vaho tsy mahaene-pihaino’e ty vara;","poem":1},{"lineBreak":true},{"text":"Tsie, hoe re, Ia ze o itoloñako zao,","poem":1},{"lineBreak":true},{"text":"malorè ty fiaiko tsy hanjo ty soa?","poem":1},{"lineBreak":true},{"text":"hakafoahañe ka zao","poem":1},{"lineBreak":true},{"text":"mbore fifanehafañe mahaore.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hàmake te roe ta t’ie raike;","poem":1},{"lineBreak":true},{"text":"amy te soa fitombo ty fitoloña’ iareo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie mikorovoke ty raike,","poem":1},{"lineBreak":true},{"text":"honjone’ i rañe’ey;","poem":1},{"lineBreak":true},{"text":"fe feh’ohatse te mikorovoke ty bangìñe","poem":1},{"lineBreak":true},{"text":"tsy manañ’ ila hampitroatse aze.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tovo izay, ie mitrao-pandreañe ty roe","poem":1},{"lineBreak":true},{"text":"le mafana: fa ino ty hampafana aze t’ie raike?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mete hiambotraha’ t’indaty","poem":1},{"lineBreak":true},{"text":"ty raike ie miereñereñe,","poem":1},{"lineBreak":true},{"text":"fe hijohañe hiatrek’ aze ty roe;","poem":1},{"lineBreak":true},{"text":"tsy rofondrofoteñe aniany","poem":1},{"lineBreak":true},{"text":"ty taly telo-randra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndra kitra’e ajalahy","poem":1},{"lineBreak":true},{"text":"rarake mahihitse","poem":1},{"lineBreak":true},{"text":"ta t’ie mpanjaka antetse gege","poem":1},{"lineBreak":true},{"text":"tsy mañaoñe hatahata.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Toe niboak’am-balabey ao re","poem":1},{"lineBreak":true},{"text":"ho mpanjaka;","poem":1},{"lineBreak":true},{"text":"ie nirarake te nitoly am-pifehea’e ao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nitreako te niarimboe’","poem":1},{"lineBreak":true},{"text":"ze hene veloñe ambane’ i àndroy,","poem":1},{"lineBreak":true},{"text":"i ajalahy tsinara valoha’ey,","poem":1},{"lineBreak":true},{"text":"i handimbe azey,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"naho te tsifotofoto ondaty","poem":1},{"lineBreak":true},{"text":"am-boriza’e ao,","poem":1},{"lineBreak":true},{"text":"f’ie tsy ho loho onjone’","poem":1},{"lineBreak":true},{"text":"o manonjohy azeo.","poem":1},{"lineBreak":true},{"text":"Toe hakafoahañe ka zao","poem":1},{"lineBreak":true},{"text":"vaho fañeañan-tioke.","poem":1}]},{"type":"verse","number":17,"content":["Ambeno ty lia’o mb’añ’an­jomban’ añahare mb’eo, harineo hijanjiñe’o, Hàmake izay ta te mañenga ty soro’ o seretseo, ie tsy apota’e te manao raty."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}