{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Ko meke am-palie, naho ko malisa an-tro’o ty hisaontsy ndra inoñe aman’ Añahare: fa an-dindiñe ao t’i Andrianañahare, ihe an-tane atoy, aa le anò tsy ampeampe o enta’oo."]},{"type":"verse","number":2,"content":[{"text":"Mahavy nofy ty fimaneam-pitoloñañe;","poem":1},{"lineBreak":true},{"text":"fe fohiñe ami’ty hamaron-tsaontsi’e","poem":1},{"lineBreak":true},{"text":"ty feo’ i gegey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ihe mifanta aman’ Añahare,","poem":1},{"lineBreak":true},{"text":"ko malaoñe hañavake;","poem":1},{"lineBreak":true},{"text":"fa tsy ifalea’e ty dagola:","poem":1},{"lineBreak":true},{"text":"ondroho i nifantà’oy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hàmake t’ie tsy mifanta,","poem":1},{"lineBreak":true},{"text":"ta te mifanta tsy mañavake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko metè’o hañakeo azo ty vava’o;","poem":1},{"lineBreak":true},{"text":"le ko manao amy Irakey te nilosotse:","poem":1},{"lineBreak":true},{"text":"fa ino ty hiviñeran’ Añahare amy feo’oy,","poem":1},{"lineBreak":true},{"text":"handrotsaha’e o satan-taña’oo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa hakafoahañe ty halàko nofy","poem":1},{"lineBreak":true},{"text":"naho ty hamaro saontsy:","poem":1},{"lineBreak":true},{"text":"mone mañeveña aman’Añahare.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie isa’o ty famorekekeañe o rarakeo,","poem":1},{"lineBreak":true},{"text":"naho ty fampitavanan-jo naho hatò","poem":1},{"lineBreak":true},{"text":"ampariparitse añe, ko ilatsa’o:","poem":1},{"lineBreak":true},{"text":"fa jilove’ i mpifelek’ azey ty mpifehe","poem":1},{"lineBreak":true},{"text":"vaho ambone ka ty bei’iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amy te itraofa’ iabikey","poem":1},{"lineBreak":true},{"text":"ty tombo’ i taney:","poem":1},{"lineBreak":true},{"text":"toe mitoroñe i mpanjakay i tetekey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy mahaeneñe ty mpitea-vola ty vola;","poem":1},{"lineBreak":true},{"text":"vaho ty mpikoko firegoregoañe","poem":1},{"lineBreak":true},{"text":"t’ie miegoego:","poem":1},{"lineBreak":true},{"text":"hakafoahañe ka izay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie mitobake ty havokarañe,","poem":1},{"lineBreak":true},{"text":"maro ka o mampibotsek’ azeo:","poem":1},{"lineBreak":true},{"text":"aa le ino ty tombo’e ho a i tompo’ey","poem":1},{"lineBreak":true},{"text":"ta te ho sambae’e am-pihaino avao?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mamy ty firota’ ty mpifanehake,","poem":1},{"lineBreak":true},{"text":"ndra te kede ty kamae’e ndra te bey:","poem":1},{"lineBreak":true},{"text":"fe tsy apo’e hirotse","poem":1},{"lineBreak":true},{"text":"ty havontsiña’ i mpañalealey.","poem":1}]},{"type":"verse","number":12,"content":["Eo ty haratiañe manivontivoñe nitreako ambane’ i àndroy, te mijoy ty mpañefoefo o vara ahaja’eo."]},{"type":"verse","number":13,"content":["Ie nikapaike i varay, amy te navaridì’e ami’ty tsy vara, le nahatoly ana-dahy f’ie an-tañam-polo."]},{"type":"verse","number":14,"content":["Hambañe amy niboaha’e an-kovin-drene’ey, t’ie hiboridañe ka te himpoly, ndra loli’e tsy ho tintinem-pità’e amy fitromaha’ey."]},{"type":"verse","number":15,"content":["Haratiañe manivontivoñe ka izay, te manahake ty nitolia’e ty himpolia’e: aa le ino ty tombo’ ty fitromahañe hahazoañe tioke?"]},{"type":"verse","number":16,"content":["Mikama añ’ieñe ao amo hene andro’eo, amy t’ie lako haemberañe naho hasilofañe vaho habosehañe."]},{"type":"verse","number":17,"content":["Ingo, ty nitreako ho soa naho mañeva aze, t’ie mikama naho mitohoke vaho hifale ami’ty hasoa’ i tolon-draha itoloña’e ambane’ i àndroy amo andro tsy ampeampe iaiña’eo, o natolon’ Añahare azeo: fa izay ty anjara’e."]},{"type":"verse","number":18,"content":["Naho ondaty nitoloran’ Añahare vara naho hanaña le nimea’e lily hikama naho handrambe anjara, vaho hirebek’ amy nifanehafa’ey; toe falalàn’ Añahare izay."]},{"type":"verse","number":19,"content":["Le tsy beteke haereñere’e o andro iveloma’eo, amy t’ie ampitoloñen’ Añahare an-kafalean-troke."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":19}