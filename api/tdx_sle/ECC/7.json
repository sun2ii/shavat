{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ECC","translationId":"tdx_sle","name":"Mpañoke","commonName":"Mpañoke","title":"Mpañoke","order":21,"numberOfChapters":12,"sha256":"fea4cbdbfa9e51b893de4a89bcfa2b949685859e9a5c3775d280552c9e1a44d9","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tdx_sle/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ambone’ ty fahosotse sarotse","poem":1},{"lineBreak":true},{"text":"ty tahinañe soa;","poem":1},{"lineBreak":true},{"text":"naho ty androm-pihomahañe,","poem":1},{"lineBreak":true},{"text":"ta ty andro nisamahañe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hàmake t’ie mb’an-traño fandalàñe","poem":1},{"lineBreak":true},{"text":"ta te mb’añ’anjomba fisabadidahañe,","poem":1},{"lineBreak":true},{"text":"fa izay ty figadoña’ ze kila ondaty,","poem":1},{"lineBreak":true},{"text":"ee te hapo’ ty veloñe an-tro’e ao izay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ambone’ ty fiankahafañe","poem":1},{"lineBreak":true},{"text":"ty haemberañe;","poem":1},{"lineBreak":true},{"text":"fa mete ho fale ty arofo","poem":1},{"lineBreak":true},{"text":"ndra te lonjetse ty laharañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Añ-anjombam-pandalàñe ao","poem":1},{"lineBreak":true},{"text":"ty arofo’ o mahihitseo,","poem":1},{"lineBreak":true},{"text":"le an-trañom-piankahafañe ao","poem":1},{"lineBreak":true},{"text":"ty tro’ o dagolao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hàmake t’ie mijanjiñe","poem":1},{"lineBreak":true},{"text":"ty fañendaha’ ty mahihitse,","poem":1},{"lineBreak":true},{"text":"ta te mitsanoñe ty sabo’ o mineñeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty fipipiham-patike","poem":1},{"lineBreak":true},{"text":"ambane’ valàñe eo,","poem":1},{"lineBreak":true},{"text":"ty fitohafa’ i dagola;","poem":1},{"lineBreak":true},{"text":"hakoahañe ka izay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe mampinè’ ty mahihitse","poem":1},{"lineBreak":true},{"text":"ty famorekekeañe,","poem":1},{"lineBreak":true},{"text":"vaho mamorek’ arofo ty vokàñe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ambone’ ty fifotoran-draha","poem":1},{"lineBreak":true},{"text":"ty figadoña’e,","poem":1},{"lineBreak":true},{"text":"le ambone’ ty troke misenge","poem":1},{"lineBreak":true},{"text":"ty arofo mahaliñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko malisa ho viñetse añ’arofo irehe,","poem":1},{"lineBreak":true},{"text":"amy te mimoneñe am-banian-dagola ao","poem":1},{"lineBreak":true},{"text":"ty habosehañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko manao ty hoe,","poem":1},{"lineBreak":true},{"text":"Ino ty nahasoa o andro taoloo","poem":1},{"lineBreak":true},{"text":"te amo henanekeo?","poem":1},{"lineBreak":true},{"text":"toe tsy aman-kihitse i ontane’o zay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Raha soa te mitraoke an-kihitse ty lova,","poem":1},{"lineBreak":true},{"text":"toe tombo’ o mahaisake i androio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manahake ty fañarova’ ty vara","poem":1},{"lineBreak":true},{"text":"ty fañambena’ i hihitsey;","poem":1},{"lineBreak":true},{"text":"fe ty hasoa’ o hilalao,","poem":1},{"lineBreak":true},{"text":"arova’ i hihitsey ty fiai’ o manañ’ azeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Haraharao ty fitoloñan’ Añahare;","poem":1},{"lineBreak":true},{"text":"ia ty mahay mañity ty nimengoha’e.","poem":1}]},{"type":"verse","number":14,"content":["Mifalea añ’andro vokatse, vaho mi­tsakorea añ’andron-kankàñe; songa nanoen’ Añahare itoy naho iroy, soa tsy ho oni’ ondaty ndra inoñ’ inoñe amo hanonjohy azeo."]},{"type":"verse","number":15,"content":["Hene nitreako amo haveloko koakey; eo t’indaty vaño mihomak’ amy havantaña’ey, eo ka ty lo-tsereke mañalava andro amy haratia’ey."]},{"type":"verse","number":16,"content":["Ko loho vantañe; ko losore’o ty hihitse; Ino ty hampiantoa’o ty vata’o?"]},{"type":"verse","number":17,"content":["Ko loho tsereheñe, naho ko manao gege; ino ty hivetraha’o aolo’ ty andro’o?"]},{"type":"verse","number":18,"content":["Soa re te fahara’o iroy, vaho tsy asita’o itoy, fa horihe’ ty mañeveñe aman’ Añahare i roe rey."]},{"type":"verse","number":19,"content":["Mampaozatse ty mahihitse ambone’ ty mpifehe folo an-drova ao, ty hihitse."]},{"type":"verse","number":20,"content":["Fa toe tsitantane t’indaty vañoñe mitolon-kavantañañe le lia’e tsy mandilatse."]},{"type":"verse","number":21,"content":["Aa le ko loho haoñe’o ze fonga enta saontsieñe, tsy mone ho janji’o mamatse azo ty mpitoro’o;"]},{"type":"verse","number":22,"content":["amy te beteke, fohi’ ty vata’o te ihe namatse ty ila’e."]},{"type":"verse","number":23,"content":["Fa hene nitsoheako an-kihitse, le hoe iraho: Ho paiako ty hihitse, fe nihànkañe amako."]},{"type":"verse","number":24,"content":["Tsietoitane añe naho miheotse o raha fa nifetsakeo, ia ty hahatendreke aze?"]},{"type":"verse","number":25,"content":["Natoliko ty troko handrèndreke naho hitsikarake vaho hikodebe ty hihitse naho ty lengo’ o rahao, naho ty hahafohinako ty haratia’ ty hadagolàñe, vaho ty hanè’ o hagegeañeo;"]},{"type":"verse","number":26,"content":["le nitreako te mafaitse te ami’ty havilasy ty rakemba amam-pandrike, ie harato ty tro’e, naho silisilim-pandrohizañe o taña’eo; hiponiora’ ty mahafale an’ Andrianañahare; fe ho tsepahe’e ty mpanan-tahiñe."]},{"type":"verse","number":27,"content":["Ingo, itoy ty nitreako, hoe ty mpañoke, ie tovoñañe ami’ty raha raike ty ila’e, hamoliliañ’ aze;"]},{"type":"verse","number":28,"content":["ie nitolom-pipay ty troko, fe mbe mboe tsy naharendreke; fa nahatrea ondaty raik’ ami’ty arivo iraho, fe tsy nahatrea rakemba raik’ amy rezay iaby."]},{"type":"verse","number":29,"content":["Inao, te zao avao ty nitreako, te nanoen’ Añahare mahity t’indaty, f’ie mikitro-draha maro."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}