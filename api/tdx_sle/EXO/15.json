{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"EXO","translationId":"tdx_sle","name":"Avotse","commonName":"Avotse","title":"Avotse","order":2,"numberOfChapters":40,"sha256":"b727789f8ae64ddadb1f0a475f7eb66ef27edb631e3f8716dd01386d88c1b059","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/tdx_sle/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Ty Sabo’ i Mosè naho i Miriamae"]},{"type":"verse","number":1,"content":["Le nisabo ty takasy toy am’ Iehovà t’i Mosè naho o ana’ Israeleo, nipoña-peo ami’ty hoe:",{"text":"Ho saboeko t’Iehovà,","poem":1},{"lineBreak":true},{"text":"onjono an-tiotiotse ey,","poem":1},{"lineBreak":true},{"text":"Nafetsa’e an-driak’ ao","poem":1},{"lineBreak":true},{"text":"ty soavala reke-mpiningi’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haozarako naho saboko t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Ie fandrombahañe","poem":1},{"noteId":14},{"text":"ahiko henaneo.","poem":1},{"lineBreak":true},{"text":"Andrianañahareko re, le ho rengeko,","poem":1},{"lineBreak":true},{"text":"Andrianañaharen-draeko,","poem":1},{"lineBreak":true},{"text":"vaho honjoñeko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fanalolahy añ’ aly t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Iehovà ty Tahina’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Navokovoko’e an-driak’ ao","poem":1},{"lineBreak":true},{"text":"o sarete’ i Paròo naho i valobohò’ey.","poem":1},{"lineBreak":true},{"text":"Nampiopoe’e an-dRia-Binda ao","poem":1},{"lineBreak":true},{"text":"o roandria jinobo’eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manafots’iareo i lalekey,","poem":1},{"lineBreak":true},{"text":"nilempotse an-dalek’ ao hoe vato.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toe engeñe an-kaozarañe o fità’o havanao, ry Iehovà.","poem":1},{"lineBreak":true},{"text":"Fa dinorodemom-pitàn-kavana’o","poem":1},{"lineBreak":true},{"text":"i rafelahiy, ry Iehovà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ami’ty hajabahinam-bolonahe’o","poem":1},{"lineBreak":true},{"text":"ty anjevoña’o ambane o mivoala ama’oo.","poem":1},{"lineBreak":true},{"text":"Ampihitrife’o mb’eo ty haviñera’o","poem":1},{"lineBreak":true},{"text":"mahatomonto iareo hoe tain’ ava.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ami’ty fikofòm-piantsona’o ty nivotria’ i ranoy.","poem":1},{"lineBreak":true},{"text":"Nitroatse hoe rindriñe i sorotombahañey;","poem":1},{"lineBreak":true},{"text":"Nizitse an-tro’ i riakey o lalekeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hoe ty asa’ i rafelahiy:","poem":1},{"lineBreak":true},{"text":"Ho horidañeko, ho trako,","poem":1},{"lineBreak":true},{"text":"Ho zaraeko o dinohitseo;","poem":1},{"lineBreak":true},{"text":"ie hañeneke ty haveloko.","poem":1},{"lineBreak":true},{"text":"Hapontsoako ty fibarako,","poem":1},{"lineBreak":true},{"text":"handrotsaha’ ty tañako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe nitiofe’o an-kofò’o","poem":1},{"lineBreak":true},{"text":"Le nandipotse iareo i riakey.","poem":1},{"lineBreak":true},{"text":"Nilempotse hoe firake","poem":1},{"lineBreak":true},{"text":"An-drano nitabohazake ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ia amo ndrahareo ty mañirinkiriñe Azo ry Iehovà? Ia ty hambañe ama’o?","poem":1},{"lineBreak":true},{"text":"Tsomerentsereñe an-kamasiñañe,","poem":1},{"lineBreak":true},{"text":"mampañeveñe an-drenge,","poem":1},{"lineBreak":true},{"text":"ry mpitolon-kalatsàñeo!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nahiti’o ty fità’o havana","poem":1},{"lineBreak":true},{"text":"vaho nabea’ i taney iereo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Am-pikokoa-migahiñe","poem":1},{"lineBreak":true},{"text":"ty niaoloa’o ondaty nijebañe’oo.","poem":1},{"lineBreak":true},{"text":"An-kafatrara’o ty nitehafa’o","poem":1},{"lineBreak":true},{"text":"mb’añ’akiban-kamasiña’o mb’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nahajanjiñe o kilakila ondatio","poem":1},{"lineBreak":true},{"text":"vaho nititititike;","poem":1},{"lineBreak":true},{"text":"Fineveneverañe ty nametreke o nte-Pilistio","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nirevendreveñe o mpifehe’ i Edomeo","poem":1},{"lineBreak":true},{"text":"nihondrahondra o roandria’ i Moabeo,","poem":1},{"lineBreak":true},{"text":"fonga nitranake o nte-Kanàneo;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"nivotraha’ ty havorombeloñe","poem":1},{"lineBreak":true},{"text":"naho ty hetraketrake,","poem":1},{"lineBreak":true},{"text":"ami’ty haozaram-pità’o","poem":1},{"lineBreak":true},{"text":"nizitse hoe vato iereo—","poem":1},{"lineBreak":true},{"text":"Ampara’ te nitsake ondati’oo ry Iehovà, ampara’ te nitsake ondaty vinili’oo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hampimoahe’o ao iereo vaho haore’o am-bohi’ i lova’oy—","poem":1},{"lineBreak":true},{"text":"i toem-pimoneña’o hinalanka’oy,","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1},{"lineBreak":true},{"text":"i fipalirañe naorem-pità’oy ry Talè.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mifehe nainai’e donia t’Iehovà.","poem":1}]},{"type":"verse","number":19,"content":["Fa nisorogodañ’ an-driak’ ao o soavala i Paròo rekets’ o sarete’eo naho o mpiningi’eo, le nampoli’ Iehovà am’ iereo o ranon-driakeo, vaho nitsake añivo’ i riakey an-tane maike o ana’ Israeleo."]},{"type":"verse","number":20,"content":["Nandrambe kantsàñe amy zao t’i Miriamae mpitoky, rahavave’ i Aharone, le nañorik’ aze an-kantsàñe naho tsinjake o rakemba iabio"]},{"type":"verse","number":21,"content":["vaho nitakasie’ i Miriamae:",{"text":"Misaboa am’ Iehovà","poem":1},{"lineBreak":true},{"text":"fa nandreketse am-pandreketam-bolonahetse.","poem":1},{"lineBreak":true},{"text":"Navokovoko’e an-driak’ ao ty soavala reke-piningi’e.","poem":1}]},{"type":"heading","content":["O Rano i Marà naho i Elima"]},{"type":"verse","number":22,"content":["Aa le nendese’ i Mosè nienga i Ria-Binday t’Israele naho nionjomb’ an-dRatraratra’ i Sore. Nañavelo telo andro am-patrambey ao iereo fe tsy nahatendreke rano."]},{"type":"verse","number":23,"content":["Ie pok’e Marà",{"noteId":15},"ao, le tsy nihay kamaeñe i rano’ i Marày fa nafaitse. (Izay ty nanoañe ty hoe Marà i aoy.)"]},{"type":"verse","number":24,"content":["Aa le niñeoñeo amy Mosè ondatio ami’ty hoe: Ino ty hinome’ay?"]},{"type":"verse","number":25,"content":["Le nitoreo am’Iehovà re naho nitoroa’ Iehovà ty hatae, ze nahifi’e an-drano ao nahamamy i ranoy. Teo ty nanoa’ Iehovà fañè naho zaka vaho teo ty nitsoha’e iareo."]},{"type":"verse","number":26,"content":["Hoe re: Naho imanea’o haoñe ty fiarañanaña’ Iehovà Andria­nañahare’o naho manao ty hahiti’e am-pivazohoa’e naho mijanjiñe o fandilia’eo vaho miambeñe o fañè’e iabio, le tsy hapoko ama’o o areteñe nafetsako amo nte-Mitsraimeoo, fa Izaho Iehovà Mpampijangañe azo."]},{"type":"verse","number":27,"content":["Le nitotsake Elìme ao iereo, toetse an-dohan-drano manganahana folo ro’ amby naho satrañe fitom-polo; vaho nañialo marine’ o ranoo eo."]}],"footnotes":[{"noteId":14,"caller":"+","text":"Sab 118:14, Ies 12:2","reference":{"chapter":15,"verse":2}},{"noteId":15,"caller":"+","text":"Marà: mafaitse","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/tdx_sle/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}