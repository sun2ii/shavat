{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"EZK","translationId":"tdx_sle","name":"Iekezkèle","commonName":"Iekezkèle","title":"Iekezkèle","order":26,"numberOfChapters":48,"sha256":"812185ad817c89095a48dc9a2aa0e612acbd9e2fea66f0c05a029c67bba0cef6","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tdx_sle/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Niheo amako indraike ty tsara’ Iehovà nanao ty hoe:"]},{"type":"verse","number":2,"content":["Ie amy zao ana’ ondatio, onjono fandalañe t’i Tsore, le ano ty hoe t’i Tsore,"]},{"type":"verse","number":3,"content":["O ry mpimo­neñe am-pitolia’ o riakeo, mpanao balike ho am’ ondaty an-tokonose maroo, inao ty nafè’ Iehovà Talè:",{"text":"O Tsore! hoe ty asa’o:","poem":1},{"lineBreak":true},{"text":"ginoke an-katsomerentseren-draho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anteñateña’ i riakey o efe-tane’oo","poem":1},{"lineBreak":true},{"text":"naho nahafonitse ty hatsaratsea’o","poem":1},{"lineBreak":true},{"text":"o mpandranji’oo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hene nanoe’ iereo ami’ty nato’ i Senire","poem":1},{"noteId":48},{"text":"o varamban-daka’oo;","poem":1},{"lineBreak":true},{"text":"nangalak’ amo mendorave’ i Libanoneo,","poem":1},{"lineBreak":true},{"text":"hamboara’ iareo o bodan-dai’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amo kobai’ i Basaneo","poem":1},{"noteId":49},{"lineBreak":true},{"text":"ty nandranjia’ iareo o fivei’oo;","poem":1},{"lineBreak":true},{"text":"an-tsifa boak’ amo tokonose’ i Kitio","poem":1},{"lineBreak":true},{"text":"ty nitsenea’ o nte-Asoreo o fiambesa’oo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lamba leny marerarera","poem":1},{"lineBreak":true},{"text":"soa vinahotse boake Mitsraime añe","poem":1},{"lineBreak":true},{"text":"ty nalama’o ho lai’o;","poem":1},{"lineBreak":true},{"text":"manga naho malo-mavo boak’","poem":1},{"lineBreak":true},{"text":"an-tokonose’ i Elisà","poem":1},{"noteId":50},{"text":"ty nanaroñe azo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nimpivei’o o nte-Tsidoneo","poem":1},{"noteId":51},{"lineBreak":true},{"text":"naho o nte Arvadeo","poem":1},{"noteId":52},{"text":";","poem":1},{"lineBreak":true},{"text":"tam-po’o ao, ry Tsore,","poem":1},{"lineBreak":true},{"text":"ondaty mahihi’oo,","poem":1},{"lineBreak":true},{"text":"o ni-mpanehak’ azoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O androanavi’ i Gebaleo","poem":1},{"noteId":53},{"lineBreak":true},{"text":"naho o mahihi’eo ty nanosoke","poem":1},{"lineBreak":true},{"text":"o varakivaraky ama’oo;","poem":1},{"lineBreak":true},{"text":"songa tama’o ao o sambon-driakeo","poem":1},{"lineBreak":true},{"text":"rekets’ o mpiandria’eo","poem":1},{"lineBreak":true},{"text":"nifanakalo kilankañe ama’o.","poem":1}]},{"type":"verse","number":10,"content":["Nimpitraok’ amo lahin­defo’oo, o nte-Paraseo",{"noteId":54},"naho o nte-Lodeo",{"noteId":55},"rekets’ o nte-Poteo",{"noteId":56},", ondaty mpialy; naradorado’ iareo ama’o o fikala’ iareo naho o aron-doha’eo; naràm-bintañe ama’e irehe."]},{"type":"verse","number":11,"content":["Niariary an-kijoli’o eo o lahindefo’oo mindre amo nte-Arvadeo, naho tam-pitalakesañ’ abo’o ao o nte-Gamadeo",{"noteId":57},"; nase­ba’ iareo amo rindri’oo mb’atia mb’atia o fikalan-defo’eo; nifonira’ iareo ty hamontramontra’o."]},{"type":"verse","number":12,"content":["Nimpanao balibalik’ ama’o t’i Tarsise",{"noteId":58},"amy fibodobodoam-bara’ey; navaro’ iareo an-tsena’o ao ty volafoty, viñe, kankiñe, vaho firake."]},{"type":"verse","number":13,"content":["Nimpanao balike ho azo t’Iavane naho i Tobale vaho i Meseke",{"noteId":59},", nanao takinak’ ama’o ami’ty fiai’ondaty naho ami’ ty valàñe torisìke."]},{"type":"verse","number":14,"content":["Nanao kinanga amo tsena’oo ty anjomba’ i Togarmà",{"noteId":60},"rekets’ o soavala’eo naho soavalan-aly vaho borìke."]},{"type":"verse","number":15,"content":["Nimpanao balik’ ama’o o nte-Dedaneo, tokonose tsiefa ty nikalo am-pità’o eo; nibanabana tsifa-foty naho mañary."]},{"type":"verse","number":16,"content":["Nanao takinak’ ama’o ka t’i Arame amo hatsifotofoton-draha tsinene’oo, nanao takinak’ an-drobikà naho malòmavo naho raha soa vinahotse naho leny marerarera naho hareañe vaho hange."]},{"type":"verse","number":17,"content":["Nanao balik’ ama’o ka t’Iehodà naho ty tane’ Israele; nendese’ iareo vare-bole boake Minite",{"noteId":61},"mb’an-tsena’o ao, naho raha mafiry naho tantele naho menake vaho solike."]},{"type":"verse","number":18,"content":["Nikalo ama’o ka t’i Damesèke",{"noteId":62},"ami’ty fibodobodoan-draha namboare’o, ami’ty vara tsy efa, naho divay boak’e Kelbone",{"noteId":63},"vaho volonañondry mikotritriake."]},{"type":"verse","number":19,"content":["Nikaloe’ i V’Dane naho Iavane nte-Ozale viñe niloeloe, le amo kilanka’o iabio ty sena naho vinda mañitse."]},{"type":"verse","number":20,"content":["Nanao balik’ ama’o t’i Dedane: lamba fanoeñe an-tsarete."]},{"type":"verse","number":21,"content":["O nte-Arabeo",{"noteId":64},"naho o roandria’ i Kedareo",{"noteId":65},"nanao takinak’ ama’o amo vik’ añondrio, o añon­drilahio, vaho amo ose-lahio, nimpikalo i raha rey iereo."]},{"type":"verse","number":22,"content":["I Sebà",{"noteId":66},"naho i Raama",{"noteId":67},"ni-mpanao balike; nanao takinak’ amo tsena’oo an-tsakày naho vatosoa vaho volamena."]},{"type":"verse","number":23,"content":["Songa nifanakalo ama’o ty Karane",{"noteId":68},"naho i Kanè",{"noteId":69},"naho i Edene",{"noteId":70},", o mpampibali’ i Sebao, i Asore vaho i Kilmade",{"noteId":71},"."]},{"type":"verse","number":24,"content":["Nilahatse ama’o ami’ty raha maro i mpanao takinak’ ama’o rezay; tañate’ ty kilanka’o ao ty sarimbo manga naho lamba soa vinahotse naho vata pea fisiky fanjaka, finehe taly naho rinanjy ami’ty mendoraveñe."]},{"type":"verse","number":25,"content":["Ihe ty nampionjoñe o sambo’ i Tarsiseo,",{"text":"o mpanao takinake ho azoo; nipea irehe,","poem":1},{"lineBreak":true},{"text":"nitoabotoabotse añivo’ i riakey ao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ninday azo nitoañe riake laleke","poem":1},{"lineBreak":true},{"text":"o mpivei’oo,","poem":1},{"lineBreak":true},{"text":"fe namolak’ azo añivo’ o riakeo","poem":1},{"lineBreak":true},{"text":"i tiok’ atiñanañey.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ty vara’o, o tsena’oo,","poem":1},{"lineBreak":true},{"text":"o fifampikaloa’oo,","poem":1},{"lineBreak":true},{"text":"o mpivei’oo, o mpaneha’oo,","poem":1},{"lineBreak":true},{"text":"o mpandite-laka’oo,","poem":1},{"lineBreak":true},{"text":"o mpanao balibalik’ ama’oo,","poem":1},{"lineBreak":true},{"text":"ze hene lahin-defo’o ama’o,","poem":1},{"lineBreak":true},{"text":"ze fonga valobohò’o ama’o,","poem":1},{"lineBreak":true},{"text":"songa hijoroboñe am-po’ o riakeo ao","poem":1},{"lineBreak":true},{"text":"amy androm-pirotsaha’oy.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hihondrahondra o mpañohok’ azoo","poem":1},{"lineBreak":true},{"text":"ami’ty feon-toreo’o o mpanehakeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Songa hizotso amo sambo’eo","poem":1},{"lineBreak":true},{"text":"o mpitàm-piveio, o mpifanehake am-piveio, sindre hijohañe an-tamboho eo","poem":1},{"lineBreak":true},{"text":"o mpanehake an-driakeo","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"naho hipoña-piarañanañañe,","poem":1},{"lineBreak":true},{"text":"ho janjiñeñe ama’o ao","poem":1},{"lineBreak":true},{"text":"ty fangololoihañe,","poem":1},{"lineBreak":true},{"text":"vaho hampibobò deboke","poem":1},{"lineBreak":true},{"text":"amo añambone iereoo","poem":1},{"lineBreak":true},{"text":"hidrakadrakak’ an-davenok’ ao:","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Hifandriritse maròy ty ama’o,","poem":1},{"lineBreak":true},{"text":"naho hisikiñe lamban-gony,","poem":1},{"lineBreak":true},{"text":"vaho hirovetse an-","poem":1},{"lineBreak":true},{"text":"kaferon’arofo naho","poem":1},{"lineBreak":true},{"text":"hangoihoy an-kafairañe.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Amy fangololoihañey","poem":1},{"lineBreak":true},{"text":"ty hañonjonam-bekom-pandalàñe ho azo am-pirovetañe, ami’ty hoe;","poem":1},{"lineBreak":true},{"text":"Ia ty mañirinkiriñe i Tsore,","poem":1},{"lineBreak":true},{"text":"hambañe amy rinotsake","poem":1},{"lineBreak":true},{"text":"anteñateña’ i riakeiy?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ie nionjoñe boak’ an-driak’ ao","poem":1},{"lineBreak":true},{"text":"o kilanka’oo,","poem":1},{"lineBreak":true},{"text":"le nilifore’o ty fifokoañe maro;","poem":1},{"lineBreak":true},{"text":"nampañefoefo o mpanjaka’ ty tane toio","poem":1},{"lineBreak":true},{"text":"ami’ty hatsifotofoto’","poem":1},{"lineBreak":true},{"text":"o kilanka’oo, naho o balibali’oo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Amy andro namolaha’ i riakey","poem":1},{"lineBreak":true},{"text":"azoy an-kalale’ o ranoo ao,","poem":1},{"lineBreak":true},{"text":"le fonga nirotsake","poem":1},{"lineBreak":true},{"text":"ty fifampibalibalihañe naho","poem":1},{"lineBreak":true},{"text":"i valobohòke ama’oy.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Songa nidaba ty ama’o","poem":1},{"lineBreak":true},{"text":"o mpimoneñ’an-tokonose añeo,","poem":1},{"lineBreak":true},{"text":"naho niazo’ ty anifañe o mpanjaka’eo","poem":1},{"lineBreak":true},{"text":"nitsololòk’ an-daharañe.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Mikosìke azo","poem":1},{"lineBreak":true},{"text":"o mpanao takinak’ añivo’ ondatioo;","poem":1},{"lineBreak":true},{"text":"fangetraketrahañe nainai’e irehe,","poem":1},{"lineBreak":true},{"text":"vaho le lia’e tsy ho ao ka.","poem":1}]}],"footnotes":[{"noteId":48,"caller":"+","text":"Senire: labozim-pandreañe; miovaova","reference":{"chapter":27,"verse":5}},{"noteId":49,"caller":"+","text":"Basane: ami’ty nife; nifem-biby bey","reference":{"chapter":27,"verse":6}},{"noteId":50,"caller":"+","text":"Elisà: Añondrin’Añahare; I Mpañolotse","reference":{"chapter":27,"verse":7}},{"noteId":51,"caller":"+","text":"Tsidone: mpañoro; mpamintañe;","reference":{"chapter":27,"verse":8}},{"noteId":52,"caller":"+","text":"Arvade: mpirererere","reference":{"chapter":27,"verse":8}},{"noteId":53,"caller":"+","text":"Gebale: efe-tane;","reference":{"chapter":27,"verse":9}},{"noteId":54,"caller":"+","text":"Parase: mpandily, mpizara; kitroke;","reference":{"chapter":27,"verse":10}},{"noteId":55,"caller":"+","text":"Lode; fisamahañe; tariratse","reference":{"chapter":27,"verse":10}},{"noteId":56,"caller":"+","text":"Pote: ana’ i Kame, ana’ i Noake","reference":{"chapter":27,"verse":10}},{"noteId":57,"caller":"+","text":"Gamade: kana; ondaty mahasibeke","reference":{"chapter":27,"verse":11}},{"noteId":58,"caller":"+","text":"Tarsise: fitsakore