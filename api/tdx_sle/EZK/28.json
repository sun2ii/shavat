,"number":22,"content":["ty hoe, Hoe ty nafè’ Iehovà Talè:",{"text":"Heheke te miatrek’azo iraho ry Tsidone;","poem":1},{"lineBreak":true},{"text":"le ho rengeñe añivo’o ao iraho;","poem":1},{"lineBreak":true},{"text":"naho ho fohi’ iareo te Izaho Iehovà,","poem":1},{"lineBreak":true},{"text":"ie ametsahako zaka,","poem":1},{"lineBreak":true},{"text":"vaho haveheñe ama’e.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hañitrifako angorosy","poem":1},{"lineBreak":true},{"text":"naho lio amo lala’eo","poem":1},{"lineBreak":true},{"text":"naho hitsingoritritse añivo’e ao o fereo,","poem":1},{"lineBreak":true},{"text":"ty asam-pibara miarikoboñe aze,","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’ iareo te Izaho Iehovà.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le lia’e tsy ho aman-droi-piteke","poem":1},{"lineBreak":true},{"text":"i anjomba’ Israeley,","poem":1},{"lineBreak":true},{"text":"ndra fatike hampinòtse aze","poem":1},{"lineBreak":true},{"text":"boak’ amo mpiarikoboñe malaiñe azeo;","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’ iareo","poem":1},{"lineBreak":true},{"text":"te Izaho Iehovà Talè.","poem":1}]},{"type":"verse","number":25,"content":["Hoe ty nafè’ Iehovà Talè: Ie atontoko amo hene nampipara­tsiahako aze añeo ty anjomba’ Israele, naho fa nampiavaheko am-pihaino’ o kilakila’ ndatio"]},{"type":"verse","number":26,"content":["le hi­mo­neña’ iareo i tane natoloko amy mpitoroko Iakobeiy. Hiaiñañoleñañe iereo naho hañoreñe kivoho naho hañalahala tanem-bahe le himoneñ’ an-kanintsiñe ao, ie fa nametsahako zaka o mpamaoke mañohoke iareo vaho ho fohi’ iareo te Izaho Iehovà Andrianañahare’ iareo."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}