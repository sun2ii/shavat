rse","number":10,"content":[{"lineBreak":true},{"text":"Hoe ty nafè’ Iehovà Talè,","poem":1},{"lineBreak":true},{"text":"hajiheko ty valobohò’ i Mitsraime","poem":1},{"lineBreak":true},{"text":"am-pità’ i Nebokadnetsare","poem":1},{"lineBreak":true},{"text":"mpanjaka’ i Bavele.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie rekets’ ondati’eo;","poem":1},{"lineBreak":true},{"text":"le hendeseñe hampianto i taney","poem":1},{"lineBreak":true},{"text":"o maozatse amo kilakila’ ndatioo","poem":1},{"lineBreak":true},{"text":"naho hapontsoa’iareo fibara","poem":1},{"lineBreak":true},{"text":"t’i Mitsraime,","poem":1},{"lineBreak":true},{"text":"vaho hañatseke i taney ami’ty vinono.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho maiheko o sakao,","poem":1},{"lineBreak":true},{"text":"le hatoloko am-pità’","poem":1},{"lineBreak":true},{"text":"o tsereheñeo i taney;","poem":1},{"lineBreak":true},{"text":"vaho ho joieko i taney","poem":1},{"lineBreak":true},{"text":"naho ze hene ama’e ao","poem":1},{"lineBreak":true},{"text":"am-pitàn’ambahiny.","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà ty nitsara.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ty hoe ty nafè’ Iehovà Talè:","poem":1},{"lineBreak":true},{"text":"Ho fonga joieko o saren-drahao,","poem":1},{"lineBreak":true},{"text":"hajiheko ka o samposampo’ i Nofeo","poem":1},{"noteId":76},{"lineBreak":true},{"text":"tsy ho aman-droandriañe ty","poem":1},{"lineBreak":true},{"text":"tane’ Mitsraime, vaho","poem":1},{"lineBreak":true},{"text":"hapoko an-tane Mitsraime ty anifañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hanoeko bangiñe ty Patrose","poem":1},{"lineBreak":true},{"text":"le hamiañako afo ty Tsoane","poem":1},{"noteId":77},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho hafetsako amy No ty zaka.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hakofòko amy Sine","poem":1},{"noteId":78},{"text":"ty fifomboko,","poem":1},{"lineBreak":true},{"text":"i haozara’ i Mitsraimey;","poem":1},{"lineBreak":true},{"text":"naho haitoako ty valobohò’ i No.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hampirehetako afo ty Mitsraime;","poem":1},{"lineBreak":true},{"text":"hanaintaiñe ty Sine, hitori-anjake ty No,","poem":1},{"lineBreak":true},{"text":"ho forekekèñe boak’ andro t’i Nofe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hampihotrahem-pibara o ajalahi’","poem":1},{"lineBreak":true},{"text":"i Avene","poem":1},{"noteId":79},{"text":"naho i Pi-Beseteo","poem":1},{"noteId":80},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho hasese añe aman-drohy i rova rey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hanoeñe maieñe ty andro","poem":1},{"lineBreak":true},{"text":"e Tapanekese","poem":1},{"noteId":81},{"text":"ao","poem":1},{"lineBreak":true},{"text":"ie hampipozaheko","poem":1},{"lineBreak":true},{"text":"ty joka’ o nte-Mitsraimeo,","poem":1},{"lineBreak":true},{"text":"naho hijihetse ama’e","poem":1},{"lineBreak":true},{"text":"ty habohabohan-kaozara’e;","poem":1},{"lineBreak":true},{"text":"ie hikopaha’ ty rahoñe,","poem":1},{"lineBreak":true},{"text":"vaho hasese am-pandrohizañe añe","poem":1},{"lineBreak":true},{"text":"o anak’ampela’eo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Izay ty hametsahako zaka","poem":1},{"lineBreak":true},{"text":"amy Mitsraime;","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’ iereo te Izaho Iehovà.","poem":1}]},{"type":"verse","number":20,"content":["Aa ie amy andro faha-fito’ i volam-baloha’ ty taom-paha-folo-raik’ambiy, le niheo amako ty tsara’ Iehovà nanao ty hoe:"]},{"type":"verse","number":21,"content":["O ana’ondatio, fa pinozako ty sira’ i Parò mpanjaka’ i Mitsraime; le Inao, t’ie tsy nibandieñe amañ’ aoly, tsy naholonkoloñe ho melañe, hahafitam-pibara."]},{"type":"verse","number":22,"content":["Aa le hoe ty nafè’ Iehovà Talè; Oniño te hatreatrèko t’i Parò mpanjaka’ i Mitsraime, naho ho pozaheko i sira’ey, i maozatsey, i nifolakey; vaho havotsoko am-pità’e ty fibara’e."]},{"type":"verse","number":23,"content":["Le hampiparaitaheko amo kilakila’ ndatio o nte-Mitsraimeo, vaho hampiboelèko amo fifeheañeo."]},{"type":"verse","number":24,"content":["Le hampaozareko o sira’ i mpanjaka’ i Baveleo, naho hapoko am-pità’e ty fibarako, fe ho pozaheko o sira’ i Paròo, vaho hitretretretre manahake ty fañitoza ondaty fere mitarik’ aiñe taolo’eo."]},{"type":"verse","number":25,"content":["Aa le hampaozareko ty sira’ i mpanjaka’ i Baveley, fe hiradorado ambane o sira’ i Paroo; le ho fohi’ iareo te Izaho Iehovà, ie atoloko am-pitàm-panjaka’ i Bavele ty fibarako vaho hatorakitsi’e an-tane Mitsraime."]},{"type":"verse","number":26,"content":["Le habaratsako amo kilakila’ ndatio o nte-Mitsraimeo, naho havarakaiko amo fifeheañeo, vaho ho fohi’ iareo te Izaho Iehovà."]}],"footnotes":[{"noteId":75,"caller":"+","text":"Kobe: Ondaty raike mañohoke Egipte","reference":{"chapter":30,"verse":5}},{"noteId":76,"caller":"+","text":"Nofe: papi-tatnele; ze mitsopatsopake","reference":{"chapter":30,"verse":13}},{"noteId":77,"caller":"+","text":"Tsoane: fihetseke","reference":{"chapter":30,"verse":14}},{"noteId":78,"caller":"+","text":"Sine: rongoñe","reference":{"chapter":30,"verse":15}},{"noteId":79,"caller":"+","text":"Avene: hakeo; haozara; vara; anahelo","reference":{"chapter":30,"verse":17}},{"noteId":80,"caller":"+","text":"Pi-Besete: akiba ‘nahare’ ampela Besete","reference":{"chapter":30,"verse":17}},{"noteId":81,"caller":"+","text":"Tapanekese: Oniño Ier. 2.16: fañahy","reference":{"chapter":30,"verse":18}}]},"thisChapterLink":"/api/tdx_sle/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/EZ