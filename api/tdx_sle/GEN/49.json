{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"GEN","translationId":"tdx_sle","name":"Foto’e","commonName":"Foto’e","title":"Foto’e","order":1,"numberOfChapters":50,"sha256":"5518a2ee28b6ce5e4c1756ac8c7c39993dae3556717a021442f17443c8628f5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/tdx_sle/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Fitata’ Iakobe o Ana’eo"]},{"type":"verse","number":1,"content":["Le kinanji’ Iakòbe o ana’eo, vaho nanao ty hoe, Miropaha amako etoy, ho talilieko ze hife­tsak’ ama’ areo amo andro añeo."]},{"type":"verse","number":2,"content":["Mivoria vaho mitsanoña, ry ana’ Iakòbe; tsendreño Israele rae’areo."]},{"type":"verse","number":3,"content":[{"text":"O Reòbene, tañoloñoloñako irehe,","poem":1},{"lineBreak":true},{"text":"ty haozarako naho","poem":1},{"lineBreak":true},{"text":"ty loha-voan-kafatrarako,","poem":1},{"lineBreak":true},{"text":"mininginingy an-dohàñe,","poem":1},{"lineBreak":true},{"text":"miligiligy am-panjofahañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mihalingaliñe hoe rano, tsy hionjoñe ka,","poem":1},{"lineBreak":true},{"text":"amy te nanganiha’o ty fandrean-drae’o;","poem":1},{"lineBreak":true},{"text":"nitivàeñe—ie nijoñe an-tihiko eo!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miharo-foetse t’i Simone naho i Levy;","poem":1},{"lineBreak":true},{"text":"haraom-piaroteñe o fialia’ iareoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ee te tsy hitrao-pikinia’ am’iareo ty troko,","poem":1},{"lineBreak":true},{"text":"Lonike te tsy hirekets’ am-pivori’iareo ty asiko,","poem":1},{"lineBreak":true},{"text":"Fa an-kabosehañe ty namonoa’iareo ondaty,","poem":1},{"lineBreak":true},{"text":"Naho an-tsatri’ iareo ro namirasintake añombe,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hafàtse ty haboseha’iareo,","poem":1},{"lineBreak":true},{"text":"amy te mandoviake,","poem":1},{"lineBreak":true},{"text":"naho ty fiforoforoa’iareo,","poem":1},{"lineBreak":true},{"text":"amy te manitra!","poem":1},{"lineBreak":true},{"text":"Ho zaraeko am’ Iakòbe ao iereo,","poem":1},{"lineBreak":true},{"text":"vaho hampiparaitaheko e Israele ao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Iehodà, mandrenge azo o rahalahi’oo;","poem":1},{"lineBreak":true},{"text":"An-trehon-drafelahi’o ty fità’o;","poem":1},{"lineBreak":true},{"text":"Milokoloko ama’o o ana-dahin-drae’oo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ana-diona t’Iehodà;","poem":1},{"lineBreak":true},{"text":"Nitsàtsa irehe le nitroatse.","poem":1},{"lineBreak":true},{"text":"Mitsakononoke eo re,","poem":1},{"lineBreak":true},{"text":"mangolotoke hoe liona, hoe liona-vave,","poem":1},{"lineBreak":true},{"text":"ia ty hampitsekak’ aze?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy hipitsok’ am’ Iehodà","poem":1},{"lineBreak":true},{"text":"ty kobain-drazañe,","poem":1},{"lineBreak":true},{"text":"ndra ty fitoñom-panjaka","poem":1},{"lineBreak":true},{"text":"añivo’ o fandia’eo,","poem":1},{"lineBreak":true},{"text":"ampara’ ty fitotsaha’ i Talè’ey","poem":1},{"noteId":97},{"lineBreak":true},{"text":"vaho ie ty hivohora’ o kilakila’ndatio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vahora’e am-bahe ty borìke’e tarabao,","poem":1},{"lineBreak":true},{"text":"naho ty ana-borìke’e am-bahe miloeloe,","poem":1},{"lineBreak":true},{"text":"le sinasa’e an-divay o siki’eo,","poem":1},{"lineBreak":true},{"text":"naho o saro’eo an-diom-balobok’ ao;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Menae’ ty divay o maso’eo,","poem":1},{"lineBreak":true},{"text":"vaho hafotin-dronono ty nife’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hitoetse añolon-driake t’i Zebolone ho fitolian-dakañe,","poem":1},{"lineBreak":true},{"text":"hiefetse amy Tsidòne añe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Borìke maozatse t’Isakare","poem":1},{"lineBreak":true},{"text":"miondrek’ añivon-kilankañe roe,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naheo’e te soa i fitofàñey","poem":1},{"lineBreak":true},{"text":"naho te naindoñindoñe i taney,","poem":1},{"lineBreak":true},{"text":"aa le nabokoboko’e o soro’eo hinday","poem":1},{"lineBreak":true},{"text":"vaho ninjare nitoroñe haba.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hizaka ondati’eo t’i Dane,","poem":1},{"lineBreak":true},{"text":"Kanao mpiamo foko Israeleo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ho mereñe an-dalañe eo t’i Dane,","poem":1},{"lineBreak":true},{"text":"menarà mandiñe an-dalan-tsileke eo,","poem":1},{"lineBreak":true},{"text":"Mpihehetse tomin-tsovala","poem":1},{"lineBreak":true},{"text":"Hampitafatsilañelañe i piningi’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mandiñe ty fandrombaha’o raho","poem":1},{"lineBreak":true},{"text":"ry Iehovà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Haname i Gade ty fifañosoñañe,","poem":1},{"lineBreak":true},{"text":"Fa hihoridaña’e an-tomi’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Boak’amy Asere ty mahakama matave,","poem":1},{"lineBreak":true},{"text":"hazotso’e ty hafiriam-panjakay.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Renem-panaloke nampidadañe t’i Naftaly,","poem":1},{"lineBreak":true},{"text":"mitaroñe razan-tsaontsy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tirin-katae mamoa t’Iosefe,","poem":1},{"lineBreak":true},{"text":"toran-katae miregorego","poem":1},{"lineBreak":true},{"text":"añ’olon-drano manganahana;","poem":1},{"lineBreak":true},{"text":"mamokon-kijoly o tora’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nampioje aze an-kafairañe o mpitàm-paleo;","poem":1},{"lineBreak":true},{"text":"Hiniriri’iareo ana-pale fa nalaiñe aze.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Fe nitan-kaozarañe i fale’ey","poem":1},{"lineBreak":true},{"text":"vaho nampigañe’ o fitàn-Tsitongerè’ Iakòbeo, o siram-pità’eo,","poem":1},{"lineBreak":true},{"text":"Boak’ ao ty Mpiarake, i Lamilami’ Israeley,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"hirik’ aman’ Añaharen-drae’o","poem":1},{"lineBreak":true},{"text":"mpañimb’azoy,","poem":1},{"lineBreak":true},{"text":"naho amy El-Sadai mpitahy azo,","poem":1},{"lineBreak":true},{"text":"amo fitahia’ i andikerañe amboneio,","poem":1},{"lineBreak":true},{"text":"amo fitahia’ i laleke mandre ambane aoio,","poem":1},{"lineBreak":true},{"text":"amo fitahiam-patroa naho hoviñeo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Maozatse te ami’ty tata’ o vohitse tsy modoo o tatan-drae’oo,","poem":1},{"lineBreak":true},{"text":"Pak’ añ’efe’ o haboañe nainai’eo","poem":1},{"lineBreak":true},{"text":"ty ho an-kevo’ Iosefe,","poem":1},{"lineBreak":true},{"text":"naho añambone’ i naambake","poem":1},{"noteId":98},{"lineBreak":true},{"text":"amo rahalahi’eoy","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Farasy romotse t’i Beniamine,","poem":1},{"lineBreak":true},{"text":"maraiñe re mampibo­tseke ty nitsatsà’e,","poem":1},{"lineBreak":true},{"text":"haleñe re mandiva o kinopa’eo.","poem":1}]},{"type":"verse","number":28,"content":["I tsaraeñe rezay ro fifokoa folo-ro’ ambi’ Israele, le i saontsieñey ro nafèn-drae’ iareo t’ie nitata; toe songa nitatae’e an-tata mañeva."]},{"type":"heading","content":["Ty Havilasi’ Iakòbe"]},{"type":"verse","number":29,"content":["Le hoe ty nafè’e am’iereo: Fa antitotse te hifanontoñe am’ ondati­koo iraho. Aleveño aman-droaeko an-dakato an-tete’ i Efrone nte-Khete ao"]},{"type":"verse","number":30,"content":["amy lakato an-tonda’ i Makpelà, aolo’ i Mamrè, an-tane Kanàne añe, vinili’ i Avrahame reketse tonda amy Efrone nte-Khete ho tanen-donake ho azey."]},{"type":"verse","number":31,"content":["Tao ty nandentehañe i Avrahame naho i Sarà vali’e le ty nandentehañe Ietsàke naho i vali’e Ribkae, vaho tao ty nandeveñako i Leae"]},{"type":"verse","number":32,"content":["I tetekey naho i lakato ama’ey ty vinily amo ana’ i Kheteo."]},{"type":"verse","number":33,"content":["Ie nagado’ Iakòbe i nafè’e amo ana’eoy, le naonjo’e am-pandrea’e o fandia’eo le nikofòke fara’e vaho natontoñe am’ ondati’eo."]}],"footnotes":[{"noteId":97,"caller":"+","text":"Heb: Siloa (i banabanaeñey)","reference":{"chapter":49,"verse":10}},{"noteId":98,"caller":"+","text":"Ndra: nte-Nazare","reference":{"chapter":49,"verse":26}}]},"thisChapterLink":"/api/tdx_sle/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}