{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HAB","translationId":"tdx_sle","name":"Kabakòke","commonName":"Kabakòke","title":"Kabakòke","order":35,"numberOfChapters":3,"sha256":"d3c861673049ff26eae7a69ddbcd7bc35a95f3418baff46ea68baa54bc724057","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ty entañe nioni’ i Kabakòke",{"noteId":0},"mpitoky."]},{"type":"verse","number":2,"content":["O ry Iehovà, pak’ombia",{"text":"ty hitoreovako, Ihe tsy mijanjiñeo?","poem":1},{"lineBreak":true},{"text":"naho ipoñafako feo, ami’ty hoe: Varata! Tsy rombahe’o!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ino ty ampahaisaha’o ahy","poem":1},{"lineBreak":true},{"text":"o tsy fanjofahañeo,","poem":1},{"lineBreak":true},{"text":"naho ampandrendreha’o ty","poem":1},{"lineBreak":true},{"text":"halonjerañe, naho ty harotsahañe,","poem":1},{"lineBreak":true},{"text":"vaho ty halò-tserehañe aoloko ey?","poem":1},{"lineBreak":true},{"text":"eo ka o mpiolao naho o mpandietseo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa le repake t’i Hake,","poem":1},{"lineBreak":true},{"text":"vaho tsy miboake ho vantañe o zakao;","poem":1},{"lineBreak":true},{"text":"fa arikoboña’ o tsivokatseo o vañoñeo,","poem":1},{"lineBreak":true},{"text":"aa le zaka vìlañe avao ty mandeha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sambao o kilakila’ ondatio,","poem":1},{"lineBreak":true},{"text":"le maharendreha naho mañaraharà,","poem":1},{"lineBreak":true},{"text":"Ilatsao fa hanoeñe amo andro’ areoo","poem":1},{"lineBreak":true},{"text":"ty fitoloñañe tsy hiantofa’ areo,","poem":1},{"lineBreak":true},{"text":"ndra t’ie italilañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inao! te hampitroareko o nte-Kasdìo,","poem":1},{"lineBreak":true},{"text":"i fifeheañe mafaitse naho malìsay,","poem":1},{"lineBreak":true},{"text":"o hangovovoke hitsaha’e","poem":1},{"lineBreak":true},{"text":"i tane bey heneheneio","poem":1},{"lineBreak":true},{"text":"hitavana’e o akiba tsy a iareoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie mampangebahebake naho","poem":1},{"lineBreak":true},{"text":"mampirevendreveñe;","poem":1},{"lineBreak":true},{"text":"miboak’ am-bata’e ty hionjona’","poem":1},{"lineBreak":true},{"text":"ty zaka naho ty enge’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Masika te amo farasio o soavala’eo,","poem":1},{"lineBreak":true},{"text":"ie maola te amo amboa-hako","poem":1},{"lineBreak":true},{"text":"an-kaleñeo,","poem":1},{"lineBreak":true},{"text":"mitsapiotsapioke o mpiningitseo,","poem":1},{"lineBreak":true},{"text":"boake tsietoitane añe o mpiningi’eo;","poem":1},{"lineBreak":true},{"text":"miherereake hoe hondria","poem":1},{"lineBreak":true},{"text":"malisa t’ie hanao revozeake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fonga hihofike mb’eo am-bodongero’e o azeo, miatre-daharañe manahake i tiok’ atiñanañey hanontom-pirohy hoe faseñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie mpanivetive mpanjaka,","poem":1},{"lineBreak":true},{"text":"inje’ iareo o roandriañeo,","poem":1},{"lineBreak":true},{"text":"itohafa’ iareo ze rova fatratse,","poem":1},{"lineBreak":true},{"text":"ampirampia’ iereo tane le mitavañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mihelañe hoe tioke ty arofo’iareo,","poem":1},{"lineBreak":true},{"text":"fa voa hakeo, amy te samposampo’e ty haozara’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsy taolo’ ty atao andro hao irehe","poem":1},{"lineBreak":true},{"text":"ry Iehovà Andrianañahareko masiñe?","poem":1},{"lineBreak":true},{"text":"tsy ho mongotse zahay.","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, toe tinendre’o ho zakaeñe re,","poem":1},{"lineBreak":true},{"text":"Ihe Lamilamy, ro nañory aze ho liloveñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amam-pihaino mikotritriake irehe,","poem":1},{"lineBreak":true},{"text":"tsy mañeva azo ty hivazoho haratiañe;","poem":1},{"lineBreak":true},{"text":"tsy mete mioniñe hatsivokarañe;","poem":1},{"lineBreak":true},{"text":"akore te metea’o o mañoho-dozao?","poem":1},{"lineBreak":true},{"text":"Ihe mianjiñe avao, t’ie abotse’ i lo-tserekey t’indaty vantañe te ama’e;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie anoe’o hoe fian-driake ondatio,","poem":1},{"lineBreak":true},{"text":"hoe raha milalilaly tsy amam-pifehe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fonga tarihe’e am-porengotse,","poem":1},{"lineBreak":true},{"text":"kozozote’e an-karato,","poem":1},{"lineBreak":true},{"text":"naho manontoñe an-jarifa,","poem":1},{"lineBreak":true},{"text":"vaho mirebeke am-pitreñañe,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Misoroñe amo harato’eo,","poem":1},{"lineBreak":true},{"text":"naho mañemboke amo jarifa’eo,","poem":1},{"lineBreak":true},{"text":"amy t’ie ro mahavondrake ty anjara’e,","poem":1},{"lineBreak":true},{"text":"naho mahatobàke o mahakama’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa ho koahe’e hao o harato’eo?","poem":1},{"lineBreak":true},{"text":"ho zamane’e nainai’e hao o fifeheañeo","poem":1},{"lineBreak":true},{"text":"fa tsy hanisa?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kabakòke: mpanazoke; mpanao ringa","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}