{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HAB","translationId":"tdx_sle","name":"Kabakòke","commonName":"Kabakòke","title":"Kabakòke","order":35,"numberOfChapters":3,"sha256":"d3c861673049ff26eae7a69ddbcd7bc35a95f3418baff46ea68baa54bc724057","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Hijohañe am-pijilovako eo iraho,","poem":1},{"lineBreak":true},{"text":"hijadoñe am-pitalakesañ’ abo ey,","poem":1},{"lineBreak":true},{"text":"hañilo mb’alafe’e mb’eo","poem":1},{"lineBreak":true},{"text":"handrèndreke ze ho tsarae’e amako,","poem":1},{"lineBreak":true},{"text":"naho ze hatoiko t’ie hiveroke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nanoiñe ahy t’Iehovà ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Sokiro i aroñaroñey,","poem":1},{"lineBreak":true},{"text":"bakabakafo an-takelake,","poem":1},{"lineBreak":true},{"text":"hahavakia’ondaty milay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho amy andro namantañañ’ azey i tokiy,","poem":1},{"lineBreak":true},{"text":"i figadoñañey ro enta’e,","poem":1},{"lineBreak":true},{"text":"le tsy handañitse","poem":1},{"lineBreak":true},{"text":"ndra t’ie tambatse, liñiso,","poem":1},{"lineBreak":true},{"text":"toe ho tondroke le tsy hihenekeneke.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Heheke ty miebotsebots’ an-troke,","poem":1},{"lineBreak":true},{"text":"tsy vañoñe ty ama’e ao;","poem":1},{"lineBreak":true},{"text":"fe veloñe amy fatokisa’ey ty vantañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbore fañahie’ ty divay ty mpirengevoke","poem":1},{"lineBreak":true},{"text":"tsy ho tamàñe añ’akiba’e ao,","poem":1},{"lineBreak":true},{"text":"fa ampienare’e hoe i Tsikeokeokey","poem":1},{"lineBreak":true},{"text":"ty fañiria’e, manahake o vilasio","poem":1},{"lineBreak":true},{"text":"t’ie tsy mb’ia tsy etsake,","poem":1},{"lineBreak":true},{"text":"fa atonto’e ama’e ze hene fifeheañe,","poem":1},{"lineBreak":true},{"text":"ampitoabore’e ama’e ze kila ondaty.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa vaho tsy songa handrambe","poem":1},{"lineBreak":true},{"text":"razan-drehake ama’e irezay,","poem":1},{"lineBreak":true},{"text":"handrabioñe aze an-titse,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Hankàñe","poem":1},{"lineBreak":true},{"text":"amy nanontoñe ty tsy azey!","poem":1},{"lineBreak":true},{"text":"akore ty hatrela’ ty nilogologoa’e tsoake!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy hitroatse amy zao hao","poem":1},{"lineBreak":true},{"text":"o mipay avak’ ama’oo?","poem":1},{"lineBreak":true},{"text":"tsy ho tsekake hao o mampi­nevenevetse azo?","poem":1},{"lineBreak":true},{"text":"ihe ho fikopaha’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa kanao nikopahe’o o kilakila’ondatio,","poem":1},{"lineBreak":true},{"text":"le ho volose’ o sehanga’ ondatio ka irehe;","poem":1},{"lineBreak":true},{"text":"ty amo lio’ ondatio,","poem":1},{"lineBreak":true},{"text":"naho i heloke nanoañe amy taney,","poem":1},{"lineBreak":true},{"text":"naho amy rovaiy,","poem":1},{"lineBreak":true},{"text":"vaho amo hene mpimoneñeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hekoheko amy mpikatramo vara","poem":1},{"lineBreak":true},{"text":"ho a i anjomba’eiy,","poem":1},{"lineBreak":true},{"text":"hañonjona’e ambone ey i kiboho’ey,","poem":1},{"lineBreak":true},{"text":"hivotsora’e ami’ty haozara’ o ratio!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"fa nikinia’o hasalarañe ty akiba’o","poem":1},{"lineBreak":true},{"text":"hañitoa’o t’indaty maro,","poem":1},{"lineBreak":true},{"text":"vaho amam-kakeo am-bata’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hikoike boak’an-drindriñe ao ty vato,","poem":1},{"lineBreak":true},{"text":"hanoiñe aze i tsotsòke boak’ an-katae aoy:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hankàñe! ty mpamboatse rova an-dio,","poem":1},{"lineBreak":true},{"text":"ie mañoren-tanàñe an-tahiñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inao! tsy Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"ty amokora’ ondaty ho ami’ty afo,","poem":1},{"lineBreak":true},{"text":"naho ty amozaha’ o fifeheañeo","poem":1},{"lineBreak":true},{"text":"ho an-kakoahañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Toe ho lifotse ty fahafohinañe","poem":1},{"lineBreak":true},{"text":"ty enge’ Iehovà ty tane toy,","poem":1},{"lineBreak":true},{"text":"manahake ty fañampoan-drano i riakey","poem":1},{"noteId":1},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hankàñe ami’ty mampigenoke i rañe’ey,","poem":1},{"lineBreak":true},{"text":"ie izonjoña’e i zonjòñey, hampijik’ aze am-bòreke, hisamba’e i heña’ey!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Àtsan-kasalaran-drehe fa tsy engeñe, minoma ka, ho zoeñe t’ie tsy sinavatse,","poem":1},{"lineBreak":true},{"text":"hitoliha’ ty fitovim-pitàn-kavana’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ho losore’ ty hameñarañe ty enge’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hanaroñ’ azo ty fijoiañe i Libanone,","poem":1},{"lineBreak":true},{"text":"naho ty fanjamanañe biby","poem":1},{"lineBreak":true},{"text":"nampalý iareo;","poem":1},{"lineBreak":true},{"text":"ty ami’ty lio’ ondatio naho","poem":1},{"lineBreak":true},{"text":"ty fampiantoañe i taney, i rovay,","poem":1},{"lineBreak":true},{"text":"vaho o mpimoneñe ao iabio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ino ty tombo’ i sare-sokitsey,","poem":1},{"lineBreak":true},{"text":"ie tsinene ty nanao aze, sare nitranaheñe naho mpañoke vande;","poem":1},{"lineBreak":true},{"text":"t’ie iatoa’ i mpandranjy azey","poem":1},{"lineBreak":true},{"text":"hanoe’e samposampo moañe?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hekoheko ami’ty manao ty hoe","poem":1},{"lineBreak":true},{"text":"ami’ty hatae: Mañentea!","poem":1},{"lineBreak":true},{"text":"naho amy vato moañey: Miongaha!","poem":1},{"lineBreak":true},{"text":"Mahafanoro hao izay?","poem":1},{"lineBreak":true},{"text":"Hehe t’ie nohoñem-bolamena naho","poem":1},{"lineBreak":true},{"text":"volafoty, fe tsy aman-kofòke.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Añ’anjomba’e masiñe ao t’Iehovà;","poem":1},{"lineBreak":true},{"text":"mianjìña añatrefa’e eo ry an-tane-bey atoy.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Ies 11:9","reference":{"chapter":2,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}