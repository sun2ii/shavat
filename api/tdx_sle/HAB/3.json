{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HAB","translationId":"tdx_sle","name":"Kabakòke","commonName":"Kabakòke","title":"Kabakòke","order":35,"numberOfChapters":3,"sha256":"d3c861673049ff26eae7a69ddbcd7bc35a95f3418baff46ea68baa54bc724057","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ty fikora’ i Kabakoke mpitoky,","poem":1},{"lineBreak":true},{"text":"nanoeñe añ’onin-tsabo","poem":1},{"noteId":2},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry Iehovà, fa tsinanoko i nilañona’oy","poem":1},{"lineBreak":true},{"text":"vaho hemban-draho; sotraho o fitoloña’oo","poem":1},{"lineBreak":true},{"text":"ry Iehovà, añivon’andro zao;","poem":1},{"lineBreak":true},{"text":"ampahafohino anteñateñan-tsa,","poem":1},{"lineBreak":true},{"text":"ihe viñetse mahatiahia fiferenaiñañe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niboak’ amy Temane","poem":1},{"noteId":3},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"hirik’am-bohi-Parane","poem":1},{"noteId":4},{"text":"i Masiñey. Selah","poem":1},{"lineBreak":true},{"text":"nanitsike o likerañeo ty volonahe’e,","poem":1},{"lineBreak":true},{"text":"nandramban-tane ty enge’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mireandreañe hoe i àndroy;","poem":1},{"lineBreak":true},{"text":"mitsipelatsipelatse ty fità’e;","poem":1},{"lineBreak":true},{"text":"mikafitse ao i haozara’ey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miaolo Aze ty angorosy,","poem":1},{"lineBreak":true},{"text":"mimilemiletse am-pandia’eo ty afo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie mijohañe, manginikinike i taney,","poem":1},{"lineBreak":true},{"text":"Ie mivazoho, minevenevetse o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"mikoromak’ amy zao o vohitse nainai’eo,","poem":1},{"lineBreak":true},{"text":"mibokoke o haboañe haehaeo,","poem":1},{"lineBreak":true},{"text":"aze o lalañe haehae’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Treako te misotry o kiboho’ i Kosìo,","poem":1},{"lineBreak":true},{"text":"nititititike o lamban-dalan-kiboho’","poem":1},{"lineBreak":true},{"text":"i Midianeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà, ­nañatsembe Azo hao o sakao?","poem":1},{"lineBreak":true},{"text":"Niviñera’o hao o torahañeo?","poem":1},{"lineBreak":true},{"text":"Nampiforoforo Azo hao i riakey?","poem":1},{"lineBreak":true},{"text":"t’ie miningitse soavala naho","poem":1},{"lineBreak":true},{"text":"saretem-pandrombahañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zonjoñe’o ty taram-pale’o,","poem":1},{"lineBreak":true},{"text":"lilie’o ho liforen’ ana-pale. Selà","poem":1},{"lineBreak":true},{"text":"Torie’o amo sakao ty tane toy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nahaisak’ azo o vohitseo le nihembañe, nanginahina i sorotombakey,","poem":1},{"lineBreak":true},{"text":"nampipoña-peo i lalekey,","poem":1},{"lineBreak":true},{"text":"vaho naonjo’e mb’añ’abo o taña’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nijihetse añ’akiba’e eo i àndroy","poem":1},{"lineBreak":true},{"text":"naho i volañey,","poem":1},{"lineBreak":true},{"text":"ami’ty filoeloea’ o ana-pale’o","poem":1},{"lineBreak":true},{"text":"nihiririñe mb’eoo,","poem":1},{"lineBreak":true},{"text":"naho ami’ty fimilomiloran-defo’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Linialia’o an-kaviñerañe i taney;","poem":1},{"lineBreak":true},{"text":"trinabotrabo’o an-keloke o kilakila’ndatio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nionjomb’eo irehe handrombake ondati’oo,","poem":1},{"lineBreak":true},{"text":"hamotsotse i Noriza’oy;","poem":1},{"lineBreak":true},{"text":"dinemo’o ty loha-traño’ o tsivokatseo,","poem":1},{"lineBreak":true},{"text":"nampikorendahe’o boak’","poem":1},{"lineBreak":true},{"text":"ami’ty manàntañe pak’am-bozo’e. Selà","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Trinofa’o amo kobai’eo avao","poem":1},{"lineBreak":true},{"text":"ty loha’ o mpifehe’eo,","poem":1},{"lineBreak":true},{"text":"o mpivovo amako hoe tangololahio;","poem":1},{"lineBreak":true},{"text":"ie miankahake hampibotseke","poem":1},{"lineBreak":true},{"text":"o mahaferenaiñeo añ’etake ao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Linialia’o amo soavala’oo i riakey","poem":1},{"lineBreak":true},{"text":"amy fitoaboran-drano bey heneheney.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsinanoko le ninevenevetse ty troko,","poem":1},{"lineBreak":true},{"text":"nampititititike o soñikoo","poem":1},{"lineBreak":true},{"text":"i fiarañanañañey,","poem":1},{"lineBreak":true},{"text":"nizilik’ an-taolako ao ty fimomohañe,","poem":1},{"lineBreak":true},{"text":"nihondrahondra iraho am-pijohañako eo","poem":1},{"lineBreak":true},{"text":"handiñisako i andro hankàñey,","poem":1},{"lineBreak":true},{"text":"ty hitroara’ o haname anaio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa ndra te tsy mamòñe i sakoañey,","poem":1},{"lineBreak":true},{"text":"naho tsy mamoa o vaheo;","poem":1},{"lineBreak":true},{"text":"mianto te mitoloñe amo oliveo,","poem":1},{"lineBreak":true},{"text":"tsy mamokatse haneñe o tetekeo,","poem":1},{"lineBreak":true},{"text":"aitoañe amo golobo’eo o añondrio,","poem":1},{"lineBreak":true},{"text":"vaho po-pirai-tròke ty an-jolok’ ao,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"mbe hirebek’am’ Iehovà nainai’e raho","poem":1},{"lineBreak":true},{"text":"handia-taroba aman’","poem":1},{"lineBreak":true},{"text":"Añaharem-pandrombahañ’ ahy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Haozarako t’Iehovà Andrianañahareko hanoe’e tombon-tsarake o tombokoo,","poem":1},{"lineBreak":true},{"text":"hanjotike an-kaboañe ey.","poem":1},{"lineBreak":true},{"text":"Ho amy talèn-tsakèray: anoeñe am-pititihañe.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Sigionote: onin-tsabo","reference":{"chapter":3,"verse":1}},{"noteId":3,"caller":"+","text":"Temane: atimo, Afrika; fonitse","reference":{"chapter":3,"verse":3}},{"noteId":4,"caller":"+","text":"Parane: soa vinta; engeñe; fihaminañe","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}