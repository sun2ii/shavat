{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HEB","translationId":"tdx_sle","name":"Hebreo","commonName":"Hebreo","title":"Hebreo","order":58,"numberOfChapters":13,"sha256":"a6e594e358cfc7528d9a986bae39a8fe27612aeeb6d2108a6f2e0ee3b01a978d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/tdx_sle/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Ty Fandikoara’ i Norizañey o Mpitokio"]},{"type":"verse","number":1,"content":["Haehae izay, nitsara beteke naho an-tsata maro amo roaentikañeo añamo mpitokio t’i Andrianañahare,"]},{"type":"verse","number":2,"content":["le an-tsa honka’e zao ro nisaontsie’e aman-tika añamy Ana’ey, i tinendre’e handova ze he’ey, ie ty nanoa’e ty voatse toy",{"noteId":0},";"]},{"type":"verse","number":3,"content":["Ie ty fireandrea’ i enge’ey naho ty vinta-to’ i fañòva’ey, mpanohañe ze he’e ami’ty haozara’ o tsara’eo, ie nañefetse o hakeon-tikañeo amy fañòva’ey vaho miambesatse am-pitàn-kavana",{"noteId":1},"’ i Andindimoneñe andikerañ’ añey."]},{"type":"heading","content":["Milikoatse o Irakeo i Anakey"]},{"type":"verse","number":4,"content":["Ie nampilikoareñe an-tiotio’ o anjelio, le nampandovaeñe tahinañe ra’elahy te am’ iareo."]},{"type":"verse","number":5,"content":["Fa ia amo anjelio ty nisaontsia’e ndra mb’ia mb’ia ty hoe:",{"text":"Anako irehe;","poem":1},{"lineBreak":true},{"text":"anindroany ty nisamahako Azo","poem":1},{"noteId":2},"naho ty hoe:",{"text":"Ho Rae’e iraho, le ho Anako re","poem":1},{"noteId":3},{"text":"?","poem":1}]},{"type":"verse","number":6,"content":["Ie ninday ty tañoloñolòña’e ami’ty voatse toy, le hoe ty natovo’e:",{"text":"Ee te hene hitalaho ama’e","poem":1},{"lineBreak":true},{"text":"o anjelin’ Añahareo.","poem":1},{"noteId":4}]},{"type":"verse","number":7,"content":["Aa hoe ty nanoe’e o anjelio:",{"text":"Anoe’e tioke o anjeli’eo, vaho lelan’ afo o mpitoro’eo.","poem":1},{"noteId":5}]},{"type":"verse","number":8,"content":["Fe hoe re amy Anakey:",{"text":"Nainai’e donia ry Andrianañahare ty fiambesa’o;","poem":1},{"lineBreak":true},{"text":"Naho kobain-kavantañañe","poem":1},{"lineBreak":true},{"text":"ty kobaim-pifehea’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa nikokoa’o ty havantañañe","poem":1},{"lineBreak":true},{"text":"naho nalaiñe ty tsy fañambenan-Kake;","poem":1},{"lineBreak":true},{"text":"Aa le norizen’ Añahare,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’o irehe","poem":1},{"lineBreak":true},{"text":"an-tavon-kaehake ambone’ o rañe’oo,","poem":1},{"noteId":6}]},{"type":"verse","number":10,"content":["naho :",{"text":"Ihe ry Talè, tam-pifotorañe añe ro nañoreñe o mananta’ ty tane toio naho satam-pità’o o likerañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho momoke iereo, fe nainai’e eo irehe;","poem":1},{"lineBreak":true},{"text":"fonga hihamodo hoe saroñe iereo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"le hambañe ami’ty sarimbo","poem":1},{"lineBreak":true},{"text":"ty hañoronkoroña’o iareo,","poem":1},{"lineBreak":true},{"text":"eka, hoe sikiñe ty handimbezañe iareo.","poem":1},{"lineBreak":true},{"text":"F’ihe tsy mihotike,","poem":1},{"lineBreak":true},{"text":"naho tsy higadoñe o tao’oo.","poem":1},{"noteId":7}]},{"type":"verse","number":13,"content":["Le ia amo anjelio ndra mb’ia mb’ia ty nanoa’e ty hoe:",{"text":"Mitoboha an-tañan-kavanako etoa","poem":1},{"lineBreak":true},{"text":"ampara’ te anoeko fitongoàm-pandia’oo rafelahi’oo.","poem":1},{"noteId":8},{"text":"?","poem":1}]},{"type":"verse","number":14,"content":["Aa vaho tsy songa arofo mitoroñe hao iereo, nahitrike hitoroñe o handova fandrombahañeo?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Jao 1:3","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"Sab 110:1","reference":{"chapter":1,"verse":3}},{"noteId":2,"caller":"+","text":"Sab 2:7","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"Sa II 7:14; Oni Ko II: 17:13","reference":{"chapter":1,"verse":5}},{"noteId":4,"caller":"+","text":"Sab 97:7","reference":{"chapter":1,"verse":6}},{"noteId":5,"caller":"+","text":"Sab 104:4","reference":{"chapter":1,"verse":7}},{"noteId":6,"caller":"+","text":"Sab 45: 6,7","reference":{"chapter":1,"verse":9}},{"noteId":7,"caller":"+","text":"Sab 102: 25-27","reference":{"chapter":1,"verse":12}},{"noteId":8,"caller":"+","text":"Sab 110: 1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}