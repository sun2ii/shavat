{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Niheo amy Hosea",{"noteId":0},"ana’ i Bierý",{"noteId":1},"ty tsara’ Iehovà faha’ i Ozià naho Iotame naho i Akhaze",{"noteId":2},"naho Khizkiia",{"noteId":3},"mpanjaka Iehodà, vaho Iarobàme",{"noteId":4},"ana’ Ioàse",{"noteId":5},", mpanjaka’ Israele",{"noteId":6},"."]},{"type":"verse","number":2,"content":["Ie namotsotse nitsara amy Hosea t’Iehovà, le hoe t’Iehovà amy Hosea, Akia mañengà karapilo ho vali’o, ty anak’ ampela boak’ an-kàrapiloañe ao; fa toe mpanao hakarapiloan-kalalijake naho miamboho am’ Iehovà o taneo."]},{"type":"verse","number":3,"content":["Aa le nimb’eo re nañenga i Gomere",{"noteId":7},", ana’ i Diblaime",{"noteId":8},", le niaren-dre vaho nisamaha’e anadahy."]},{"type":"verse","number":4,"content":["Le hoe t’Iehovà ama’e, Toñono ty hoe Iezreèle",{"noteId":9},"ty añara’e; fa tsy ho ela te havaleko ami’ty anjomba’ Iehò",{"noteId":10},"ty lio’ Iezreèle, vaho hagàdoko ty fifehean’ anjomba’ Israele."]},{"type":"verse","number":5,"content":["Ie amy andro zay, ho pozaheko ty fale’ Israele am-bavatane’ Iezreèle ao."]},{"type":"verse","number":6,"content":["Niareñe indraike re nahatoly anak’ ampela, le hoe re tama’e, Toñono ty hoe Lorokamà",{"noteId":11},"ty añara’e: fa tsy ho ferenaiñako ka ty anjomba’ Israele, toe tsy iheveako."]},{"type":"verse","number":7,"content":["Fe ho tretrezeko ty anjomba’ Iehodà le ho rombaheko añam’ Iehovà Andrianañahare’ iareoy, fa tsy ho rombaheko am-pale ndra fibara ndra hotakotake ndra soavala ndra mpiningi-tsoavala."]},{"type":"verse","number":8,"content":["Aa ie notañe’e t’i Lorokamà, le niareñe indraike nisamak’ anadahy."]},{"type":"verse","number":9,"content":["Le hoe re, Toñono ty hoe Loamý",{"noteId":12},"fa tsy ondatiko nahareo vaho tsy ho Andrianañahare’ areo iraho."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Hosea: mpandrombake; fitsolohañe","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Bierý: ty vovoko","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"Akhaze: mpitavañe","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"Khizkiia: haozara’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"+","text":"Iarobàme: mpandietse ondaty","reference":{"chapter":1,"verse":1}},{"noteId":5,"caller":"+","text":"Ioàse: ty mamoe’ay, he miforehetse","reference":{"chapter":1,"verse":1}},{"noteId":6,"caller":"+","text":"Israele: mpifanehak’ aman’Añahare","reference":{"chapter":1,"verse":1}},{"noteId":7,"caller":"+","text":"Gomere: mahafonitse; mahaheneke","reference":{"chapter":1,"verse":3}},{"noteId":8,"caller":"+","text":"Diblaime: Sakoañe maroan-tsinga’e","reference":{"chapter":1,"verse":3}},{"noteId":9,"caller":"+","text":"Iezreèle: Miongake t’Iehovà; ty hazavà’e","reference":{"chapter":1,"verse":4}},{"noteId":10,"caller":"+","text":"Iehò: Ie ze Ie","reference":{"chapter":1,"verse":4}},{"noteId":11,"caller":"+","text":"Lorokamà: tsy nitretrezañe","reference":{"chapter":1,"verse":6}},{"noteId":12,"caller":"+","text":"Loamý: tsy ondatiko","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/HOS/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/DAN/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}