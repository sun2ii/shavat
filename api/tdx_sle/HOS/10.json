{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Vahe nandrevake t’Israele,","poem":1},{"lineBreak":true},{"text":"niregorego o voa’eo,","poem":1},{"lineBreak":true},{"text":"ie nitombo o famokara’eo,","poem":1},{"lineBreak":true},{"text":"le nampitomboe’e ka o kitreli’eo;","poem":1},{"lineBreak":true},{"text":"mira ami’ty havokara’ i tane’ey","poem":1},{"lineBreak":true},{"text":"ty nampisomontie’e o samposampo’eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa mizara ty arofo’ iareo;","poem":1},{"lineBreak":true},{"text":"fa hivave hakeo iereo;","poem":1},{"lineBreak":true},{"text":"ho hatsafe’e o kitreli’ iareoo,","poem":1},{"lineBreak":true},{"text":"ho rotsahe’e o samposampo’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hanao ty hoe iereo te aniany,","poem":1},{"lineBreak":true},{"text":"Tsy amam-panjàka zahay,","poem":1},{"lineBreak":true},{"text":"ami’ty tsy fañeveña’ay am’ Iehovà;","poem":1},{"lineBreak":true},{"text":"fa ho nanao inoñe ho antika","poem":1},{"lineBreak":true},{"text":"ty mpanjaka?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mivolambolañe avao iereo,","poem":1},{"lineBreak":true},{"text":"manao fanta vìlañe naho mifañìna;","poem":1},{"lineBreak":true},{"text":"aa le hitiry hoe lombiry","poem":1},{"lineBreak":true},{"text":"am-bavahalin-tete’ iareo ty zaka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mihondrahondra o mpimone’","poem":1},{"lineBreak":true},{"text":"i Someroneo ty amo bania’ i Bet’aveneo;","poem":1},{"lineBreak":true},{"text":"handala i baniay ondatio,","poem":1},{"lineBreak":true},{"text":"naho o mpisoroñe","poem":1},{"lineBreak":true},{"text":"nañonjoñe azeo, ty amy enge’ey,","poem":1},{"lineBreak":true},{"text":"fa niakatse añe izay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie hasese mb’e Asore añe","poem":1},{"lineBreak":true},{"text":"ho ravoravo am’ Iarebe mpanjaka;","poem":1},{"lineBreak":true},{"text":"ho salareñe t’i Efraime,","poem":1},{"lineBreak":true},{"text":"vaho ho meñatse t’Israele","poem":1},{"lineBreak":true},{"text":"ty amo fañòha’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I Somerone: fa naitoañe i mpanjaka’ey,","poem":1},{"lineBreak":true},{"text":"manahake ty vore","poem":1},{"lineBreak":true},{"text":"mihafoñ’ ambone rano eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho rotsaheñe o kitreli’ i Aveneo,","poem":1},{"lineBreak":true},{"text":"ty hakeo’ Israele;","poem":1},{"lineBreak":true},{"text":"hitiry amo kitreli’e iabio ty fatike","poem":1},{"lineBreak":true},{"text":"naho ty hisatse,","poem":1},{"lineBreak":true},{"text":"le hanoeñe ty hoe o vohitseo,","poem":1},{"lineBreak":true},{"text":"Lembefo zahay;","poem":1},{"lineBreak":true},{"text":"naho o haboañeo,","poem":1},{"lineBreak":true},{"text":"Mitraboha ama’ay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ry Israele, fa nandilatse","poem":1},{"lineBreak":true},{"text":"hirik’añ’andro’ i Gibà irehe;","poem":1},{"lineBreak":true},{"text":"nijihetse ey avao iereo;","poem":1},{"lineBreak":true},{"text":"Tsy nahafivohotse ondaty mirengevoke e Gibà ao i hotakotakey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho liloveko an-tsatriko;","poem":1},{"lineBreak":true},{"text":"vaho hifanontoñe haname iareo","poem":1},{"lineBreak":true},{"text":"o kilakila’ ondatio,","poem":1},{"lineBreak":true},{"text":"le ho rohizeñe ty amy","poem":1},{"lineBreak":true},{"text":"hakeo roe zay iereo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kiloa finolake t’i Efraime,","poem":1},{"lineBreak":true},{"text":"tea’e ty mandisañe;","poem":1},{"lineBreak":true},{"text":"le nampiariako ambone’ i hàto’e fanjàkay","poem":1},{"lineBreak":true},{"text":"ty ana-joka, hitariha’ i Efraime,","poem":1},{"lineBreak":true},{"text":"hitan-dasarý t’Iehodà, vaho","poem":1},{"lineBreak":true},{"text":"ho bonabonahe’ Iakobe o boko’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mitongisa havantañañe,","poem":1},{"lineBreak":true},{"text":"mitataha fiferenaiñañe;","poem":1},{"lineBreak":true},{"text":"bonabonaho o moka’ areoo;","poem":1},{"lineBreak":true},{"text":"fa tondroke ty fipaiañe Iehovà,","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie totsake eo","poem":1},{"lineBreak":true},{"text":"hampidoañe havañonañe ama’ areo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Navae’ areo ty halò-tsereke,","poem":1},{"lineBreak":true},{"text":"nitatahe’ areo ty hakeo,","poem":1},{"lineBreak":true},{"text":"ho kamae’ areo ty vokam-pandañirañe,","poem":1},{"lineBreak":true},{"text":"amy te niatoa’o o sata’oo,","poem":1},{"lineBreak":true},{"text":"naho ty hatsifotofoto’ o fanalolahi’oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le hitroatse añivo’ ondati’oo","poem":1},{"lineBreak":true},{"text":"ty fifandragaragàñe;","poem":1},{"lineBreak":true},{"text":"fonga ho rotsake o rova fatratseo,","poem":1},{"lineBreak":true},{"text":"manahake ty nandrotsaha’","poem":1},{"lineBreak":true},{"text":"i Salmane","poem":1},{"noteId":35},{"text":"i Bet’arbele","poem":1},{"noteId":36},{"text":",","poem":1},{"lineBreak":true},{"text":"tañ’andro’ i hotakotakey;","poem":1},{"lineBreak":true},{"text":"dinemoke rekets’ an-drene’e o ana’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hambañe amy zay ty hanoa’ i Betele o halò-tsere’ areoo;","poem":1},{"lineBreak":true},{"text":"ho vata’e aitoañe ty mpanjaka’ Israele","poem":1},{"lineBreak":true},{"text":"te maraindray.","poem":1}]}],"footnotes":[{"noteId":35,"caller":"+","text":"Salmane: mampilongo; fonitse; tambe","reference":{"chapter":10,"verse":14}},{"noteId":36,"caller":"+","text":"Bet’arbele: Filonadonan’Andrianañahare","reference":{"chapter":10,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}