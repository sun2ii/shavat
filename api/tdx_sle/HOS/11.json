{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ie mbe ni-ajaja t’Israele, le nikokoako vaho tinokako hiakats’ i Mitsraime i ana-dahikoy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie nikanjieko iereo","poem":1},{"lineBreak":true},{"text":"àntsake te nihànkañe,","poem":1},{"lineBreak":true},{"text":"nisoroñe amo Baaleo, vaho","poem":1},{"lineBreak":true},{"text":"nañembok’ amo samposampoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Izaho ty nañoke i Efraime hitekeñe,","poem":1},{"lineBreak":true},{"text":"rinambeko an-tañañe,","poem":1},{"lineBreak":true},{"text":"fe tsy napota’iereo te","poem":1},{"lineBreak":true},{"text":"izaho ty nampijangañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tinariko an-tali’ondaty,","poem":1},{"lineBreak":true},{"text":"am-bahem-pikokoañe,","poem":1},{"lineBreak":true},{"text":"le nanahake ty mpañaka-joka","poem":1},{"lineBreak":true},{"text":"an-kàto’ iareo raho","poem":1},{"lineBreak":true},{"text":"vaho finahako mora.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apoho himpoly mb’an-tane Mitsraime re,","poem":1},{"lineBreak":true},{"text":"naho ho mpanjaka’e t’i Asore,","poem":1},{"lineBreak":true},{"text":"amy t’ie mifoneñe tsy himpoly amako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hininininike amo rova’eo i fibaray,","poem":1},{"lineBreak":true},{"text":"handrotsake ty sakan-dala’e,","poem":1},{"lineBreak":true},{"text":"naho hampibotseke, ty amy fikililia’iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imanea’ ondatikoo ty hiola amako,","poem":1},{"lineBreak":true},{"text":"ndra t’ie mikaike mb’ añ’Abo-Tia,","poem":1},{"lineBreak":true},{"text":"leo raike tsy mañonjoñ’ Aze.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Akore ty hampipohako azo, ry Efraime?","poem":1},{"lineBreak":true},{"text":"Akore ty hanolorako azo, ry Israele?","poem":1},{"lineBreak":true},{"text":"Akore te hampanahafeko","poem":1},{"lineBreak":true},{"text":"amy Admà","poem":1},{"noteId":37},{"text":"?","poem":1},{"lineBreak":true},{"text":"ndra t’ie hanoeñe hoe Tsibiìme","poem":1},{"noteId":38},{"text":"?","poem":1},{"lineBreak":true},{"text":"mikoretse ty an-troko ao,","poem":1},{"lineBreak":true},{"text":"naho hene niviañeñe o fiferenaiñakoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy hafetsako ty hasiahan-kaviñerako,","poem":1},{"lineBreak":true},{"text":"tsy hibalike mb’amy Efraime handrotsake;","poem":1},{"lineBreak":true},{"text":"amy te Andrianañahare iraho,","poem":1},{"lineBreak":true},{"text":"fa tsy ondaty;","poem":1},{"lineBreak":true},{"text":"t’i Masiñe añivo’ areo ao;","poem":1},{"lineBreak":true},{"text":"tsy ho pok’eo an-kabosehañe iraho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hañavelo am-pañorihañe Iehovà iereo;","poem":1},{"lineBreak":true},{"text":"hitroñe manahake o lionao re;","poem":1},{"lineBreak":true},{"text":"aa ie mitromoroñe,","poem":1},{"lineBreak":true},{"text":"le hititititike boak’ ahandrefañ’añe","poem":1},{"lineBreak":true},{"text":"ty ana’dahy maro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hanahake o voroñeo","poem":1},{"lineBreak":true},{"text":"ty hiborofota’ iareo","poem":1},{"lineBreak":true},{"text":"boake Mitsraime añe,","poem":1},{"lineBreak":true},{"text":"naho hoe deho hirik’ an-tane Asore añe;","poem":1},{"lineBreak":true},{"text":"ie hapoko añ’anjomba’ iareo ao,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":37,"caller":"+","text":"Admà: hamenañe; hoe lio","reference":{"chapter":11,"verse":8}},{"noteId":38,"caller":"+","text":"Tsibiìme: biby lý hoe añondry","reference":{"chapter":11,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":11}