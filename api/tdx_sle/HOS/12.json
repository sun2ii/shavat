:1},{"lineBreak":true},{"text":"o fitoloña’eo ro hañondroha’e aze.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rinambe’e an-tomi’e an-koviñe ao","poem":1},{"lineBreak":true},{"text":"i zoke’ey,","poem":1},{"lineBreak":true},{"text":"le nifanehak’ aman’ Añahare an-kaozara’e;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eka nigore’e i anjeliy vaho nahatañe","poem":1},{"noteId":39},{"text":";","poem":1},{"lineBreak":true},{"text":"nirovetse re naho nitoreova’e;","poem":1},{"lineBreak":true},{"text":"i nioni’e e Betele","poem":1},{"noteId":40},{"text":"añey,","poem":1},{"lineBreak":true},{"text":"le ao ty nitsara’e aman-tika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Eka, Iehovà, Andrianañahare’ i màroy; Iehovà ty tahina’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa le mimpolia mb’aman’Añahare’o;","poem":1},{"lineBreak":true},{"text":"tambozoro ty fatarihañe naho ty hatò,","poem":1},{"lineBreak":true},{"text":"vaho itamao nainai’e t’i Andrianañahare’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I mpampibalibalikey,","poem":1},{"lineBreak":true},{"text":"balantsim-­pamañahiañe ty am-pità’e ao; tea’e ty mikatramo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hoe t’i Efraime,","poem":1},{"lineBreak":true},{"text":"Toe fa mpañaleale iraho,","poem":1},{"lineBreak":true},{"text":"nahatrea vara maro;","poem":1},{"lineBreak":true},{"text":"tsy eo ty haharendreke tahiñe amako,","poem":1},{"lineBreak":true},{"text":"ndra hakeo amo fitoloñakoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Izaho Iehovà Andrianañahare’o","poem":1},{"lineBreak":true},{"text":"boak’ an-tane’ i Mitsraime añe;","poem":1},{"lineBreak":true},{"text":"mbe hampimoneñeko an-kibohotse irehe","poem":1},{"lineBreak":true},{"text":"manahak’ amo andro namantañañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nisaontsieko o mpitokio,","poem":1},{"lineBreak":true},{"text":"nampitomboeko aroñaroñe,","poem":1},{"lineBreak":true},{"text":"vaho nandrazañe am-pitàm-pitoky.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aman-tahiñe hao t’i Gilade?","poem":1},{"lineBreak":true},{"text":"toe hakoahañe,","poem":1},{"lineBreak":true},{"text":"ie nañenga bania e Gilgale ao;","poem":1},{"lineBreak":true},{"text":"eka, votrim-bato","poem":1},{"lineBreak":true},{"text":"am-bavahali’ o hatsakeo o kitreli’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"F’ie nilay mb’an-tete’ i Arame","poem":1},{"noteId":41},{"text":"añe t’Iakobe,","poem":1},{"lineBreak":true},{"text":"nitoroñe ho a i tañamjomba’ey,","poem":1},{"lineBreak":true},{"text":"eka nimpiarake ty amy vali’ey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mpitoky ty nañendesa’ Iehovà t’Israele boake Mitsraime ao,","poem":1},{"lineBreak":true},{"text":"vaho mpitoky ty nañarovañ’ aze;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"nikai-jaka añ’afero t’i Efraime;","poem":1},{"lineBreak":true},{"text":"aa le hapoke ama’e ty lio’e;","poem":1},{"lineBreak":true},{"text":"vaho hondrohe’ i Talè’e ama’e ty inje’e.","poem":1}]}],"footnotes":[{"noteId":39,"caller":"+","text":"Fot 32:28","reference":{"chapter":12,"verse":5}},{"noteId":40,"caller":"+","text":"Betele: Anjomban’Añahare","reference":{"chapter":12,"verse":5}},{"noteId":41,"caller":"+","text":"Arame: haabo; soa; mpamañahy; fatse","reference":{"chapter":12,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":15}