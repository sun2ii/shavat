{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Ie nisaontsy ama-nevenevetse t’i Efraime","poem":1},{"lineBreak":true},{"text":"le nonjoneñe e Israele ao,","poem":1},{"lineBreak":true},{"text":"fe nizoeñe te aman-kakeo","poem":1},{"lineBreak":true},{"text":"ty amy Baale, vaho nihomake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie henanekeo, mitolom-pandilatse avao,","poem":1},{"lineBreak":true},{"text":"nampitranake saren-draha ami’ty volafoti’ iareoo, ty amo hilala’ iareo, toe samposampon-draha,","poem":1},{"lineBreak":true},{"text":"fitoloña’ ty kante;","poem":1},{"lineBreak":true},{"text":"anoa’iareo ty hoe: Angao horofa’","poem":1},{"lineBreak":true},{"text":"o mpanao soroñeo i bania rey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le hanahake","poem":1},{"lineBreak":true},{"text":"ty zono maraindray iereo,","poem":1},{"lineBreak":true},{"text":"naho i mika am-pangoàñ’andro","poem":1},{"lineBreak":true},{"text":"mihelañey;","poem":1},{"lineBreak":true},{"text":"hambañe an-kàfo’e asiotsion-talìo boak’an-toe-pifofohañe eo,","poem":1},{"lineBreak":true},{"text":"vaho hatoeñe boak’an-toñak’ ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa izaho Iehovà Andrianañahare’o","poem":1},{"lineBreak":true},{"text":"boak’ an-tane’ i Mitsraime añe;","poem":1},{"lineBreak":true},{"text":"aa le tsy hahafohin-drahare ila’e nahareo naho tsy Izaho;","poem":1},{"lineBreak":true},{"text":"fa tsy eo ty mpandrombake","poem":1},{"lineBreak":true},{"text":"naho tsy Izaho avao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Napotako an-dratraratra añe irehe,","poem":1},{"lineBreak":true},{"text":"an-tane kankañe añe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie nifahanañe le niboboke, toe nianjañe, le nikavokavok’ an-troke,","poem":1},{"lineBreak":true},{"text":"izay ty nandikofa’ iareo ahy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa le liona am’ iereo iraho henaneo,","poem":1},{"lineBreak":true},{"text":"hanampohako hoe farasy añ’olon-dalañeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hipoke am’iereo iraho hoe dòbe mandala","poem":1},{"lineBreak":true},{"text":"handrimitse ty saron’arofo’ iareo;","poem":1},{"lineBreak":true},{"text":"vaho habotseko hoe liona;","poem":1},{"lineBreak":true},{"text":"ho rimiteko hoe biby hako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ry Israele, mampianto vatan-drehe,","poem":1},{"lineBreak":true},{"text":"fa amako ty fañolorañ’azo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aia ty mpanjaka’o","poem":1},{"lineBreak":true},{"text":"handrombak’ azo an-drova’o iaby?","poem":1},{"lineBreak":true},{"text":"Naho o mpizaka’oo nanoe’o ty hoe :","poem":1},{"lineBreak":true},{"text":"Añomezo mpanjaka naho roandriañe?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tinoloko mpanjaka irehe ami’ty habosehako;","poem":1},{"lineBreak":true},{"text":"vaho nasintako ami’ty fifomboko.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mifamahotse ty tahi’ i Efraime,","poem":1},{"lineBreak":true},{"text":"mihaja ao o hakeo’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hivotrak’ama’e","poem":1},{"lineBreak":true},{"text":"ty fitsongoan’ ampela;","poem":1},{"lineBreak":true},{"text":"ie ana-dahy tsy mahilala,","poem":1},{"lineBreak":true},{"text":"tsy ho nihenekenek’ ambavan-koviñe ao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho jebañeko ami’ty haozara’","poem":1},{"lineBreak":true},{"text":"i Tsikeokeokey hao?","poem":1},{"lineBreak":true},{"text":"ho vilieko aiñe amy Havilasiy?","poem":1},{"lineBreak":true},{"text":"O Havilasio, aia o angorosi’oo?","poem":1},{"lineBreak":true},{"text":"O Tsikeokeokeo,","poem":1},{"lineBreak":true},{"text":"aia o fandrotsaha’oo?","poem":1},{"noteId":42},{"lineBreak":true},{"text":"Mietak’ amo masokoo ty tretre.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndra te ie mibodobodo amo vindao,","poem":1},{"lineBreak":true},{"text":"ho avy ty tiok’atiñanañe;","poem":1},{"lineBreak":true},{"text":"hivovo boak’ am-patram-bey ao","poem":1},{"lineBreak":true},{"text":"ty tio’ Iehovà,","poem":1},{"lineBreak":true},{"text":"le ho maike i rano’e manganahanay,","poem":1},{"lineBreak":true},{"text":"ho ritse i loha-rano’e nigoangoañey,","poem":1},{"lineBreak":true},{"text":"ho haofe’e ty an-driha’e ao","poem":1},{"lineBreak":true},{"text":"hañakatse ze hene vara’e sarotse.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"Ko I 15:55","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":15}