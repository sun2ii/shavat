{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Ho vave’ i Somerone o tahi’eo,","poem":1},{"lineBreak":true},{"text":"amy t’ie niody aman’Añahare’e;","poem":1},{"lineBreak":true},{"text":"hampikorovohem-pibara;","poem":1},{"lineBreak":true},{"text":"ho demoheñe an-damilamy","poem":1},{"lineBreak":true},{"text":"o anak’ ajaja’ iareoo,","poem":1},{"lineBreak":true},{"text":"ho boraheñe an-drimitse","poem":1},{"lineBreak":true},{"text":"o rakemba mivesatseo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry Israele, mimpolia mb’am’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’o;","poem":1},{"lineBreak":true},{"text":"fa nampihotrake azo o hakeo’oo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Andeso saontsy, le mibaliha mb’am’Iehovà: ano ty hoe:","poem":1},{"lineBreak":true},{"text":"Fonga afaho o hakeoo, rambeso an-kasoa,","poem":1},{"lineBreak":true},{"text":"vaho hengae’ay ty banian-tsoñi’ay","poem":1},{"noteId":43},{"text":".","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy haharombak’ anay t’i Asore;","poem":1},{"lineBreak":true},{"text":"izahay tsy hiningitse an-tsoavala,","poem":1},{"lineBreak":true},{"text":"le tsy hanao ty hoe amo sata-pità’aio:","poem":1},{"lineBreak":true},{"text":"Ry ndrahare’ay.","poem":1},{"lineBreak":true},{"text":"Fa ama’o ty hahaoniña’","poem":1},{"lineBreak":true},{"text":"ty bode-rae fiferenaiñañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho jangañeko ty fidisa-voli’ iareo;","poem":1},{"lineBreak":true},{"text":"hikokoako an-tsatrin-tro,","poem":1},{"lineBreak":true},{"text":"fa mitolike ty habosehako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hanahake ty zono am’ Israele iraho;","poem":1},{"lineBreak":true},{"text":"ie hidorenake hoe antake mandriake,","poem":1},{"lineBreak":true},{"text":"vaho hirifondrifoñe hoe Libanone.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Handrevake o ra’eo,","poem":1},{"lineBreak":true},{"text":"naho hanahake ty andramahe ty enge’e,","poem":1},{"lineBreak":true},{"text":"vaho hoe Libanone ty harifondrifo’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Himpoly iaby o mialok’ ama’eo;","poem":1},{"lineBreak":true},{"text":"ho tolorañ’ aiñe manahake i ampembay,","poem":1},{"lineBreak":true},{"text":"le hiraorao hoe vahe,","poem":1},{"lineBreak":true},{"text":"vaho handrifondrifoñe","poem":1},{"lineBreak":true},{"text":"hoe ty hamañiran-divai’ i Libanone.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le hanao ty hoe t’i Efraime:","poem":1},{"lineBreak":true},{"text":"Hanoeko inoñe ka o samposampoo?","poem":1},{"lineBreak":true},{"text":"Fa nitsanoñeko naho nijiloveko,","poem":1},{"lineBreak":true},{"text":"Manahake ty kile maindoñe ama’o iraho,","poem":1},{"lineBreak":true},{"text":"amako ty aharendreha’o voa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ee te hahafohiñe o raha zao ty mahihitse,","poem":1},{"lineBreak":true},{"text":"naho haharendreke o mahilalao.","poem":1},{"lineBreak":true},{"text":"Amy te vantañe o lala’ Iehovào,","poem":1},{"lineBreak":true},{"text":"ie orihe’ o vañoñeo,","poem":1},{"lineBreak":true},{"text":"fe itsikapia’ o miolao.","poem":1}]}],"footnotes":[{"noteId":43,"caller":"+","text":"Heb 13:5","reference":{"chapter":14,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}