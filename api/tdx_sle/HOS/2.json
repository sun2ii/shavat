{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Fe mbe ho mira amo fasen-driakeo ty ia’ o ana’ Israeleo, ze tsy ho mete zeheñe ndra iaheñe; ie amy zay, amy tane nanoañe ama’ areo te Tsy ondatiko nahareoy, ty hafetse am’ iereo te Anan’ Añahare Veloñe."]},{"type":"verse","number":2,"content":["Le hifanontoñe o ana’ Iehodào naho o ana’ Israeleo, naho ho tendrè’ iareo ty mpiaolo raike ho a iareo, vaho hitombo an-tane eo: fa jabajaba ty andro’ Iezreèle."]},{"type":"verse","number":3,"content":["Anò amo roahalahi’ areoo ty hoe: Amý",{"noteId":13},", naho aman-droahavave’ areo ty hoe; Rohamà",{"noteId":14}]},{"type":"verse","number":4,"content":[{"text":"Mifanjomora aman-drene’ areo;","poem":1},{"lineBreak":true},{"text":"mifangatora;","poem":1},{"lineBreak":true},{"text":"fa tsy tañanjombako,","poem":1},{"lineBreak":true},{"text":"vaho tsy vali’e iraho.","poem":1},{"lineBreak":true},{"text":"Aa le ampañafaho an-tarehe’e eo","poem":1},{"lineBreak":true},{"text":"o hakarapiloa’eo naho","poem":1},{"lineBreak":true},{"text":"añivo’ o fatroa’eo","poem":1},{"lineBreak":true},{"text":"o hatsirimira’eo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"tsy mone ho holireko,","poem":1},{"lineBreak":true},{"text":"naho hapoko manahake","poem":1},{"lineBreak":true},{"text":"i andro nahatoly azey,","poem":1},{"lineBreak":true},{"text":"naho hanoeko hoe tane ratraratra,","poem":1},{"lineBreak":true},{"text":"naho hadoko an-tane maik’ añe","poem":1},{"lineBreak":true},{"text":"vaho havetrako an-karan-dranoañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy hiferenaiñako ka o ana’eo","poem":1},{"lineBreak":true},{"text":"fa anak’amontoñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe nanao satan-tsimirira ty rene’iareo","poem":1},{"lineBreak":true},{"text":"nimeñatse i nampiareñe iareoy;","poem":1},{"lineBreak":true},{"text":"ie nanao ty hoe,","poem":1},{"lineBreak":true},{"text":"ho paiako añe o sakezako","poem":1},{"lineBreak":true},{"text":"mamahañe ahy mofo naho rano,","poem":1},{"lineBreak":true},{"text":"ty volon’añondry naho ty leniko,","poem":1},{"lineBreak":true},{"text":"ty menake vaho ty finomakoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa le ingo, ho faherako fatike ty lala’o,","poem":1},{"lineBreak":true},{"text":"vaho hañoreñako kijoly","poem":1},{"lineBreak":true},{"text":"tsy hahatreava’e ty homba’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Himanea’e orik’ amy zao o sakeza’eo","poem":1},{"lineBreak":true},{"text":"fe tsy ho tra’e;","poem":1},{"lineBreak":true},{"text":"ho paia’e iereo fa tsy ho trea’e;","poem":1},{"lineBreak":true},{"text":"hanao ty hoe amy zao re,","poem":1},{"lineBreak":true},{"text":"Homb’eo iraho himpoly","poem":1},{"lineBreak":true},{"text":"mb’amy valiko valoha’ey mb’eo,","poem":1},{"lineBreak":true},{"text":"fa nisoa te amo henaneo i henane zay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa namoea’e te nanjotsoako","poem":1},{"lineBreak":true},{"text":"ampemba naho divay vaho menake;","poem":1},{"lineBreak":true},{"text":"le nampitomboeko ama’e","poem":1},{"lineBreak":true},{"text":"ty volafoty naho volamena","poem":1},{"lineBreak":true},{"text":"nañamboare’ iareo Baaleo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hibalike iraho le hendeseko","poem":1},{"lineBreak":true},{"text":"ty ampembako añ’andro’e","poem":1},{"lineBreak":true},{"text":"naho ty divaiko an-tsa’e,","poem":1},{"lineBreak":true},{"text":"vaho hasintako i volon’añondrikoy","poem":1},{"lineBreak":true},{"text":"naho i leny natoloko aze","poem":1},{"lineBreak":true},{"text":"hanaroña’e ty fihaloa’ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie henane zao, le ho boraheko ty fimeñara’e am-pahaisaha’ o sakeza’eo,","poem":1},{"lineBreak":true},{"text":"le tsy eo ty hahavo­tsots’ aze an-tañako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fonga hajiheko o hafalefalea’eo,","poem":1},{"lineBreak":true},{"text":"o sabadidam-pitontona’eo","poem":1},{"noteId":15},{"text":",","poem":1},{"lineBreak":true},{"text":"naho o pea-bola’eo, naho o fitofa’eo","poem":1},{"lineBreak":true},{"text":"vaho o hene androm-pamantaña’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho firaeko añe o vahe’eo","poem":1},{"lineBreak":true},{"text":"naho o sakoa’eo;","poem":1},{"lineBreak":true},{"text":"i natao’e ty hoey, Tàngeko ‘nio,","poem":1},{"lineBreak":true},{"text":"natolo’ o sakezakoo ahiko;","poem":1},{"lineBreak":true},{"text":"aa le hafotsako ho ratraratra izay","poem":1},{"lineBreak":true},{"text":"ho fihina’ o bibin-kivokeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hampitiliheko ama’e ty andro’ o Baaleo,","poem":1},{"lineBreak":true},{"text":"i nañoroa’e tsotse rezay,","poem":1},{"lineBreak":true},{"text":"ie niravake o bange’eo naho o fomela’eo,","poem":1},{"lineBreak":true},{"text":"naho nitsoeke o sakeza’eo","poem":1},{"lineBreak":true},{"text":"vaho nandikok’ ahy, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le ingo t’ie ho sigiheko,","poem":1},{"lineBreak":true},{"text":"naho hendeseko mb’am-patrambey","poem":1},{"lineBreak":true},{"text":"mb’eo vaho hidiby aze an-troke.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le hatoloko aze ty tanem-bahe boak’añe,","poem":1},{"lineBreak":true},{"text":"naho ty vavatane’ i Akore","poem":1},{"noteId":16},{"lineBreak":true},{"text":"ho lalam-pampitamàñe;","poem":1},{"lineBreak":true},{"text":"ie hisabo añe manahake","poem":1},{"lineBreak":true},{"text":"tañ’andron-katora’e,","poem":1},{"lineBreak":true},{"text":"hambañe amy andro niakara’e","poem":1},{"lineBreak":true},{"text":"an-tane Mitsraime","poem":1},{"noteId":17},{"text":"añey.","poem":1}]},{"type":"verse","number":18,"content":["Amy andro zay, hoe t’Iehovà, le ho kanjie’o iraho ami’ty hoe Valiko, vaho tsy hatao’o Baale ka."]},{"type":"verse","number":19,"content":["Fa hasintako am-bava’e ao ty añara’ o Baaleo, vaho tsy ho toñoneñe ka o añara’eo."]},{"type":"verse","number":20,"content":["Ie amy andro zay, hanoeko fañina añivo’ iereo naho o bibin-kivokeo naho o voron-dikerañeo, naho o milaly an-tane eoo; le ho pozaheko ty fale naho ty fibara naho ty fihotakotaha’ ty tane toy vaho hampiroteko am-pierañerañañe."]},{"type":"verse","number":21,"content":["Le ho fofoeko ho ahy nainai’e; eka ho fofoeko ho ahy an-kavantañañe naho an-katò naho an-kafatra­ram-pikokoañe naho fiferenaiñañe;"]},{"type":"verse","number":22,"content":["ie fofoeko ho ahy am-pigahiñañe, le ho fohi’o t’Iehovà."]},{"type":"verse","number":23,"content":[{"text":"Ie amy andro zay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le hamale iraho, ho toiñeko o likerañeo,","poem":1},{"lineBreak":true},{"text":"vaho ho valè’ iereo i taney;","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"le hamale i ampembay","poem":1},{"lineBreak":true},{"text":"naho i divaiy naho i menakey ty tane;","poem":1},{"lineBreak":true},{"text":"vaho ho valè’ iareo t’Iezreèle.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Le ho tongiseko ho ahy an-tane ao re;","poem":1},{"lineBreak":true},{"text":"naho ho ferenaiñako i tsy niferenaiñañey","poem":1},{"lineBreak":true},{"text":"naho hataoko amo tsy ni-ondatikoo ty hoe : Ondatiko irehe;","poem":1},{"lineBreak":true},{"text":"vaho hanoa’ iareo ty hoe:","poem":1},{"lineBreak":true},{"text":"Andrianañahareko.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Amý: ondatikoo","reference":{"chapter":2,"verse":3}},{"noteId":14,"caller":"+","text":"Rohamà: niferenaiñañe","reference":{"chapter":2,"verse":3}},{"noteId":15,"caller":"+","text":"Sabadidam-pitontonañe: P’sake, Halimampolo, Kibohotse","reference":{"chapter":2,"verse":13}},{"noteId":16,"caller":"+","text":"Akore: am-poheke","reference":{"chapter":2,"verse":17}},{"noteId":17,"caller":"+","text":"Mitsraime: Mpamorekeke; hasotriañe","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}