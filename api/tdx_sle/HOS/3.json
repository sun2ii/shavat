{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Le hoe t’Iehovà amako; Akia irehe: Ikokò ty rakemba ikokoan-tsakeza’e, ie toe karapilo, manahake ty fikokoa’ Iehovà o ana’ Israeleo, ie mitolik’ aman-drahare ila’e vaho mpitea mofom-balòboke."]},{"type":"verse","number":2,"content":["Aa le viniliko ho ahiko re ami’ty volafoty folo-lim’amby naho ampemba omere raike naho tampa’e;"]},{"type":"verse","number":3,"content":["le hoe iraho ama’e, Himoneñe amako andro maro irehe; fa tsy hihisa ankarapiloañe ka, naho tsy hiharo amy t’indaty ila’e; le hoe izay ka izaho ama’o."]},{"type":"verse","number":4,"content":["Amy te himoneñe andro maro tsy amam-panjàka tsy aman-Talè, tsy aman-tsòroñe, tsy aman-tsamposampo, tsy aman’efode",{"noteId":18},"vaho tsy aman-terafeme",{"noteId":19},"o nte-Israeleo."]},{"type":"verse","number":5,"content":["Ie modo izay, le himpoly o ana’ Israeleo, hipay Iehovà Andrianañahare’ iareo, naho i Davide mpanjaka’ iareo; vaho hañeveñe am’ Iehovà naho i fatariha’ey amo andro sehanga’eo."]}],"footnotes":[{"noteId":18,"caller":"+","text":"Efode: hareañe","reference":{"chapter":3,"verse":4}},{"noteId":19,"caller":"+","text":"Terafime: sare fihalaliañe","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}