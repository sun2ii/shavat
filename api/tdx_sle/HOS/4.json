{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Janjiño ty tsara’Iehovà: ry ana’ Israeleo;","poem":1},{"lineBreak":true},{"text":"amy te atreatré’ Iehovà o mpimoneñe an-tane atoio.","poem":1},{"lineBreak":true},{"text":"Fa tsy aman-katò,","poem":1},{"lineBreak":true},{"text":"tsy mitretrè, tsy mahafohiñe","poem":1},{"lineBreak":true},{"text":"an’ Andrianañahare ty an-tane ao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Te mone fàtse, naho lañitse,","poem":1},{"lineBreak":true},{"text":"naho hohodan-doza,","poem":1},{"lineBreak":true},{"text":"naho kametse,","poem":1},{"lineBreak":true},{"text":"vaho hakarapiloañe ty itoloña’ iareo,","poem":1},{"lineBreak":true},{"text":"le mifanoitoy ami’ty lio ty lio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le handala ty tane, naho","poem":1},{"lineBreak":true},{"text":"fonga hinìke ze mpimoneñe ao,","poem":1},{"lineBreak":true},{"text":"naho o bibin-kivokeo","poem":1},{"lineBreak":true},{"text":"naho o voron-dikerañeo;","poem":1},{"lineBreak":true},{"text":"vaho hasese añe ka o fian-driakeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asoao tsy ho liereñe","poem":1},{"lineBreak":true},{"text":"tsy ho endakendaheñe,","poem":1},{"lineBreak":true},{"text":"fa manahake ty mpifandietse","poem":1},{"lineBreak":true},{"text":"ami’ty mpisoroñe ondatikoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le hikorovoke antoandro irehe,","poem":1},{"lineBreak":true},{"text":"le hindre hihotrak’ ama’o ty mpitoky","poem":1},{"lineBreak":true},{"text":"naho haleñe, vaho havetrako ty rene’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rotsake ondatikoo fa po-hilala,","poem":1},{"lineBreak":true},{"text":"aa kanao narinjèñe’o ty hihitse","poem":1},{"lineBreak":true},{"text":"le hariako amo fisoroñañeo irehe;","poem":1},{"lineBreak":true},{"text":"kanao nandikofa’o","poem":1},{"lineBreak":true},{"text":"o Tsaran’Añahare’oo,","poem":1},{"lineBreak":true},{"text":"le ho haliñoko ka o ana’oo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie nampitoaboreñe iereo","poem":1},{"lineBreak":true},{"text":"àntsake t’ie nandilatse amako;","poem":1},{"lineBreak":true},{"text":"aa le hafoteko ho fisalarañe ty asi’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fihinana’ iareo o engan-kakeo’ ondatikoo,","poem":1},{"lineBreak":true},{"text":"vontitire’ iereo an-tro’e ao o tahi’ iareoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le zao ty ho ie te","poem":1},{"lineBreak":true},{"text":"hiray ami’ty ondaty ty mpisoroñe;","poem":1},{"lineBreak":true},{"text":"sindre ho liloveko ty amo sata’eo,","poem":1},{"lineBreak":true},{"text":"vaho hondroheko ty amo fitoloña’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hikama iereo fe tsy ho anjañe;","poem":1},{"lineBreak":true},{"text":"hanao hakarapiloañe fe tsy hitombo,","poem":1},{"lineBreak":true},{"text":"amy te napo’ iereo ty hañaoñe","poem":1},{"lineBreak":true},{"text":"am’ Iehovà","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mitavañe arofo ty hakarapiloañe,","poem":1},{"lineBreak":true},{"text":"naho ty divay, vaho i divay vaoy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mihalaly hevetse am-poto-katae’eo ondatikoo,","poem":1},{"lineBreak":true},{"text":"vaho manoiñe ty kobai’ iareo;","poem":1},{"lineBreak":true},{"text":"fa nampandilatse iareo","poem":1},{"lineBreak":true},{"text":"ty fañahin-kakarapiloañe,","poem":1},{"lineBreak":true},{"text":"vaho nifarie’iereo t’i Andrianañahare’iareo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mañenga soroñe am-bohitse ey iereo","poem":1},{"lineBreak":true},{"text":"naho mañembok’ an-kaboañe ey,","poem":1},{"lineBreak":true},{"text":"ambane’ o kileo naho o talìo,","poem":1},{"lineBreak":true},{"text":"vaho o mendoraveñeo,","poem":1},{"lineBreak":true},{"text":"o mañaloke soao;","poem":1},{"lineBreak":true},{"text":"aa le handrato o anak’ ampela’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho hanao hakarapiloañe","poem":1},{"lineBreak":true},{"text":"o ana-drahavavem-bali’ areoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsy ho tiliheko o anak’ampela’ areoo","poem":1},{"lineBreak":true},{"text":"t’ie manao hakarapiloañe,","poem":1},{"lineBreak":true},{"text":"naho o ana-drahavavem-bali’ areoo, t’ie mandranto","poem":1},{"lineBreak":true},{"text":"fa mitrao-pañenga amo tsimirirañeo iereo, vaho miharo soroñe amo kalalijakeo;","poem":1},{"lineBreak":true},{"text":"toe hihotrake ondaty tsy aman-kilalao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa ndra te manao hakarapiloan-drehe Israele, ko ampandilare’o t’Iehodà;","poem":1},{"lineBreak":true},{"text":"ko migodañe mb’e Gilgale, naho","poem":1},{"lineBreak":true},{"text":"ko mionjomb’e Bet’avène","poem":1},{"noteId":20},{"text":"mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho ko mifanta ty hoe","poem":1},{"lineBreak":true},{"text":"Kanao veloñe t’Iehovà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa midisa-voly manahake","poem":1},{"lineBreak":true},{"text":"ty fidisa-volin-kiloa t’Israele;","poem":1},{"lineBreak":true},{"text":"aa vaho ho fahana’ Iehovà","poem":1},{"lineBreak":true},{"text":"hoe añondri-lahy midada iereo?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kanao mitolon-tsamposampo","poem":1},{"lineBreak":true},{"text":"t’i Efraime","poem":1},{"noteId":21},{"text":"; adono ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa maseñe ty divai’ iareo;","poem":1},{"lineBreak":true},{"text":"ie mitoloñe hakarapiloañe avao;","poem":1},{"lineBreak":true},{"text":"tea’ o mpifehe’oo ty haloloañe","poem":1},{"lineBreak":true},{"text":"te ami’ty engeñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fa kinolopo’ i tiokey añ’ela’e ao iereo","poem":1},{"lineBreak":true},{"text":"le ho salatse ty amo fisoroña’ iareoo","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Bet’avene: trañon-kakoahañe","reference":{"chapter":4,"verse":15}},{"noteId":21,"caller":"+","text":"Efraime: mahavokatse; mitombo","reference":{"chapter":4,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}