{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Inao, ry mpisoroñeo,","poem":1},{"lineBreak":true},{"text":"mitsendreña ry anjomba’ Israeleo,","poem":1},{"lineBreak":true},{"text":"manokilaña ravembia ry anjomba’","poem":1},{"lineBreak":true},{"text":"i mpanjakay, fa ama’ areo i zakay;","poem":1},{"lineBreak":true},{"text":"amy t’ie fandrik’ amy Mitspà","poem":1},{"noteId":22},{"lineBreak":true},{"text":"naho harato nalafike ho amy Tabore","poem":1},{"noteId":23},{"text":";","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"vaho mpiola miheotse t’ie mandenta","poem":1},{"lineBreak":true},{"text":"ndra te nendahako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fàntako t’i Efraime naho","poem":1},{"lineBreak":true},{"text":"tsy mietak’ amako t’Israele;","poem":1},{"lineBreak":true},{"text":"fa manao hakarapiloan-drehe Efraime,","poem":1},{"lineBreak":true},{"text":"vaho maleotse t’Israele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy ho safirie’ iareo ty himpoly aman’Añahare’ iareo;","poem":1},{"lineBreak":true},{"text":"fa añivo’ iareo ao ty fañahin-kakarapiloañe,","poem":1},{"lineBreak":true},{"text":"vaho tsy fohi’ iereo t’Iehovà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitalily an-dahara’e","poem":1},{"lineBreak":true},{"text":"ty fiebotsebora’ Israele;","poem":1},{"lineBreak":true},{"text":"toly ndra hitsikapy an-kakèo","poem":1},{"lineBreak":true},{"text":"t’Israele naho i Efraime;","poem":1},{"lineBreak":true},{"text":"hiharo hihotrak’ am’ iereo ka t’Iehodà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hendese’ iereo ty lia-rai’ iareo","poem":1},{"lineBreak":true},{"text":"naho o mpirai-tro’ iareoo","poem":1},{"lineBreak":true},{"text":"ho paia’ iereo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fe tsy ho oniñe, fa nisitake.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa niola am’ Iehovà iereo,","poem":1},{"lineBreak":true},{"text":"naho nahatoly anak’amontoñe;","poem":1},{"lineBreak":true},{"text":"aa le habotse’ ty pea-bolañe","poem":1},{"lineBreak":true},{"text":"reke-panañañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tiofo e Gibà","poem":1},{"noteId":24},{"text":"i antsivay","poem":1},{"lineBreak":true},{"text":"naho e Ramà","poem":1},{"noteId":25},{"text":"i soliy;","poem":1},{"lineBreak":true},{"text":"koiho e Bet’avene ty hankàñe:","poem":1},{"lineBreak":true},{"text":"mitoliha ry Beniamine","poem":1},{"noteId":26},{"text":".","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho koaheñe t’i Efraime","poem":1},{"lineBreak":true},{"text":"amy andro fandilovañey;","poem":1},{"lineBreak":true},{"text":"fa nampahafohineko o fifokoa’","poem":1},{"lineBreak":true},{"text":"Israeleo ze toe hifetsake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Manahake ty mpameve vorovoro","poem":1},{"lineBreak":true},{"text":"o roandria’ Iehodào;","poem":1},{"lineBreak":true},{"text":"hadoandoako am’ iereo hoe rano","poem":1},{"lineBreak":true},{"text":"ty habosehako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Forekekèñe t’i Efraime demok’ an-jaka;","poem":1},{"lineBreak":true},{"text":"ie nañorike haloloañe an-tsatri’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le ho bararaok’ amy Efraime iraho,","poem":1},{"lineBreak":true},{"text":"naho haloloañe amy anjomba’ Iehodày.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie nahaoniñe i arete’ey t’i Efraime,","poem":1},{"lineBreak":true},{"text":"naho i fere’ey t’Iehodà,","poem":1},{"lineBreak":true},{"text":"le nihitrike mb’ Asorey mb’eo,","poem":1},{"lineBreak":true},{"text":"naho nisangitrife’e i mpanjaka Iaribey","poem":1},{"noteId":27},{"text":";","poem":1},{"lineBreak":true},{"text":"f’ie tsy hahajangañ’ azo,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho melañe’e i fere’oy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho liona amy Efraime iraho,","poem":1},{"lineBreak":true},{"text":"naho liona tora’e amy anjomba’ Iehodày;","poem":1},{"lineBreak":true},{"text":"Izaho le Izaho avao ty handrimitse","poem":1},{"lineBreak":true},{"text":"vaho hienga;","poem":1},{"lineBreak":true},{"text":"hinday iraho le ia ty haharombake.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Homb’eo iraho himpoly","poem":1},{"lineBreak":true},{"text":"mb’añ’akibako añe,","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie miantoke o hakeo’eo,","poem":1},{"lineBreak":true},{"text":"naho mipay ty tareheko;","poem":1},{"lineBreak":true},{"text":"ie am-poheke ro hitsoek’ahy.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Mitspa: fitilik’abo; anjoanjo","reference":{"chapter":5,"verse":1}},{"noteId":23,"caller":"+","text":"Tabore: talango’e; hiringiry;","reference":{"chapter":5,"verse":1}},{"noteId":24,"caller":"+","text":"Gibà; haboañe","reference":{"chapter":5,"verse":8}},{"noteId":25,"caller":"+","text":"Ramà: ambone, miereñereñe","reference":{"chapter":5,"verse":8}},{"noteId":26,"caller":"+","text":"Beniamine: am-pitan-kavana","reference":{"chapter":5,"verse":8}},{"noteId":27,"caller":"+","text":"Iaribe: mpamale fate","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}