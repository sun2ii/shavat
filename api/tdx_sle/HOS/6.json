{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Antao, himpoly am’ Iehovà tika;","poem":1},{"lineBreak":true},{"text":"Ie ty nandrimitse,","poem":1},{"lineBreak":true},{"text":"naho ie ty hampijangañe antika,","poem":1},{"lineBreak":true},{"text":"Ie ty namofoke, naho ie ty hampidiañe antika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Afake roe andro le hampiveloma’e, amy andro fahateloy ro hampitroara’e, himoneñan-tika am-pivazohoa’e eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le hahafohiñe tika,","poem":1},{"lineBreak":true},{"text":"naho himane hahafohiñe Iehovà;","poem":1},{"lineBreak":true},{"text":"Mionjoñe re manahake ty manjirik’àndro;","poem":1},{"lineBreak":true},{"text":"le hivotrak’ amantika","poem":1},{"lineBreak":true},{"text":"manahake o orañeo,","poem":1},{"lineBreak":true},{"text":"i oram-pigadoñañey,","poem":1},{"lineBreak":true},{"text":"naho i orañe aolo an-tane atoiy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ry Efraime, ino ty hanoako ama’o?","poem":1},{"lineBreak":true},{"text":"Ry Iehodà, ino ty hanoako azo?","poem":1},{"lineBreak":true},{"text":"Hoe mika ty hasoa’o;","poem":1},{"lineBreak":true},{"text":"mimeatse añe te maraindray","poem":1},{"lineBreak":true},{"text":"manahake o misafononokeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le nihatsafeko amo mpitokio,","poem":1},{"lineBreak":true},{"text":"nizamaneko am-pivolam-bavako;","poem":1},{"lineBreak":true},{"text":"hoe fipelaran-kelatse ty fizakañ’ azo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toe fiferenaiñañe ty paiako,","poem":1},{"lineBreak":true},{"text":"fa tsy soroñe;","poem":1},{"lineBreak":true},{"text":"naho ty fahafohinañe an’Andrianañahare","poem":1},{"lineBreak":true},{"text":"te amo engan-koroañeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe manahake i Dame","poem":1},{"lineBreak":true},{"text":"t’ie nivalike amy fañinay;","poem":1},{"lineBreak":true},{"text":"izay ty niolà’ iareo amako.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rova’ o mpikitro-draha ratio t’i Gilade","poem":1},{"noteId":28},{"text":",","poem":1},{"lineBreak":true},{"text":"tsitsike lian-dio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hoe firimbo-malaso mivoñoñe ondaty,","poem":1},{"lineBreak":true},{"text":"ty fañohofa’ i fivorim-pisoroñey","poem":1},{"lineBreak":true},{"text":"loza an-tevan-dala’ i Sekème","poem":1},{"noteId":29},{"text":"eo;","poem":1},{"lineBreak":true},{"text":"toe haloloañe ty anoe’ iereo;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naharendreke haleorañe añ’anjomba’","poem":1},{"lineBreak":true},{"text":"Israele ao iraho;","poem":1},{"lineBreak":true},{"text":"zoeñe e Efraime ao ty hatsimirirañe,","poem":1},{"lineBreak":true},{"text":"naho naniva vatañe t’Israele.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"F’ie nifotoañeko san-kavokaran-","poem":1},{"lineBreak":true},{"text":"drehe r’Iehodà,","poem":1},{"lineBreak":true},{"text":"ie hampoliko ty fandrohizañe ondatikoo.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Gilade: fitoaboran-talily (sisie)","reference":{"chapter":6,"verse":8}},{"noteId":29,"caller":"+","text":"Sekeme: tevan-kaboa, hatoke; anjara","reference":{"chapter":6,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}