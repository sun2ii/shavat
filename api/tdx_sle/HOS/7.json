sata-rati’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho o roandriañeo amo fandañira’eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fonga mpañarapilo","poem":1},{"lineBreak":true},{"text":"manahake ty toñake finana’ i mpanoñakey","poem":1},{"lineBreak":true},{"text":"ie tsy nasoro’e sikal’ami’ty fibokobokoan-kòba ampara’ ty fiboenara’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tañ’ andro’ i mpanjakan-tikañey,","poem":1},{"lineBreak":true},{"text":"nisilofe’ ty hamaen-divay o roandriañeo,","poem":1},{"lineBreak":true},{"text":"ie nañoho-pitañe amo mpandrabioñeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa hinalankañe hoe toñake","poem":1},{"lineBreak":true},{"text":"ty arofo’ iareo,","poem":1},{"lineBreak":true},{"text":"ie mirekak’ avao te haleñe ie mirotse avao i mpanoñakey;","poem":1},{"lineBreak":true},{"text":"le ie maraindray, miforehetse","poem":1},{"lineBreak":true},{"text":"hoe afo milebaleba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manao hamaen-toñake iaby,","poem":1},{"lineBreak":true},{"text":"fa finorototo’ iareo o mpizaka’eo;","poem":1},{"lineBreak":true},{"text":"le fonga nihotrake o mpanjaka’eo;","poem":1},{"lineBreak":true},{"text":"leo raike tsy mikanjy ahy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Efraime: mpitraok’ amo ambahinio,","poem":1},{"lineBreak":true},{"text":"hoe mokary tsy navalike t’i Efraime.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nabotse’ o ambahinio ty haozara’e,","poem":1},{"lineBreak":true},{"text":"fe amoea’e;","poem":1},{"lineBreak":true},{"text":"eka etia naho atia ama’e ty maròy foty,","poem":1},{"lineBreak":true},{"text":"fe tsy rendre’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitalily an-dahara’e ty fisengea’ Israele,","poem":1},{"lineBreak":true},{"text":"fe mboe tsy nimpoly am’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’e,","poem":1},{"lineBreak":true},{"text":"vaho mb’e mboe tsy mipay Aze iereo","poem":1},{"lineBreak":true},{"text":"amy hoe zay iaby.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Manahake deho minè t’i Efraime,","poem":1},{"lineBreak":true},{"text":"tsy mahafohiñe;","poem":1},{"lineBreak":true},{"text":"koihe’ iereo ty Mitsraime","poem":1},{"lineBreak":true},{"text":"vaho mionjomb’e Asore mb’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Handafihako harato iereo te mañavelo;","poem":1},{"lineBreak":true},{"text":"ho tariheko mañambane","poem":1},{"lineBreak":true},{"text":"manahake o voron-dikerañeo;","poem":1},{"lineBreak":true},{"text":"ho liloveko iereo amy","poem":1},{"lineBreak":true},{"text":"nitalilieñe amy fivori’ iareoy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hankàñe ama’e! fa nandripàke amako;","poem":1},{"lineBreak":true},{"text":"firotsahañe am’ iereo fa niola amako!","poem":1},{"lineBreak":true},{"text":"Ho nijebañeko","poem":1},{"lineBreak":true},{"text":"f’ie nifosa vande.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mboe tsy nitoreo amako","poem":1},{"lineBreak":true},{"text":"boak’añ’arofo iereo,","poem":1},{"lineBreak":true},{"text":"ndra t’ie mangolalaik’ am-pandreañ’ao;","poem":1},{"lineBreak":true},{"text":"nifanontoñe ty amy ampembay","poem":1},{"lineBreak":true},{"text":"naho i divay vaoy,","poem":1},{"lineBreak":true},{"text":"fe iambohoa’ iareo iraho.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndra t’ie naòko, naho","poem":1},{"lineBreak":true},{"text":"nampifatrareko o sira’ iareoo,","poem":1},{"lineBreak":true},{"text":"mbe ikinia’ iareo haratiañe avao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nibalike iereo, fe tsy mañambone","poem":1},{"lineBreak":true},{"text":"hoe fale am-pañahy;","poem":1},{"lineBreak":true},{"text":"ho tsingoroem-pibara o roandria’eo","poem":1},{"lineBreak":true},{"text":"ami’ty firengevoham-pamele’ iareo,","poem":1},{"lineBreak":true},{"text":"izay ty ho fandrambioñañe","poem":1},{"lineBreak":true},{"text":"iareo an-tane Mitsraime añe.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Somerone: vohi-fitalakesañe","reference":{"chapter":7,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}