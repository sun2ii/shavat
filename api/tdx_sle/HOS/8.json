{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Ano am-palie’o eo i antsivay,","poem":1},{"lineBreak":true},{"text":"hihelañe mb’añ’anjomba’ Iehovà","poem":1},{"lineBreak":true},{"text":"mb’eo re hoe vantio,","poem":1},{"lineBreak":true},{"text":"amy t’ie nivalik’ amy fañinakoy","poem":1},{"lineBreak":true},{"text":"vaho niola amo Fanoroakoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hitoreo amako hao t’Israele:","poem":1},{"lineBreak":true},{"text":"Ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"fa nahafohiñ’Azo zahay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nahifi’ Israele añe ty soa;","poem":1},{"lineBreak":true},{"text":"horidañe’ o rafelahio iereo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nampijadoñe mpifeleke iereo,","poem":1},{"lineBreak":true},{"text":"fe tsy boak’ amako;","poem":1},{"lineBreak":true},{"text":"manam-pifehe, fe nofiko;","poem":1},{"lineBreak":true},{"text":"nanoe’ iereo ndrahare avao o volafoty naho volamena’ iareoo, soa te haitoañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bania’oy ry Somerone, ty nañitoañ’ azo;","poem":1},{"lineBreak":true},{"text":"misolebotse ama’o ty habosehako;","poem":1},{"lineBreak":true},{"text":"ampara’ te ombia t’ie hahatakatse","poem":1},{"lineBreak":true},{"text":"lio-hakeo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"F’ie boak’ am’ Israele;","poem":1},{"lineBreak":true},{"text":"rinanjim-pitoroñe;","poem":1},{"lineBreak":true},{"text":"toe tsy Andrianañahare;","poem":1},{"lineBreak":true},{"text":"le ho demoheñe i bania’ i Somerone rey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nitongy i tiokey iereo,","poem":1},{"lineBreak":true},{"text":"vaho ho tatahe’ iereo ty tangololahy;","poem":1},{"lineBreak":true},{"text":"tsy hanam-bokatse iereo;","poem":1},{"lineBreak":true},{"text":"tsy hiborake ty taho’e","poem":1},{"lineBreak":true},{"text":"fe ndra t’ie hamokatse,","poem":1},{"lineBreak":true},{"text":"habotse’ ty ambahiny.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa nagodrañe t’Israele;","poem":1},{"lineBreak":true},{"text":"le hoe fanake tsy vara","poem":1},{"lineBreak":true},{"text":"amo kilakila’ ondatio,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"amy te nionjomb’Asore mb’eo,","poem":1},{"lineBreak":true},{"text":"i borìke lý mirerererey;","poem":1},{"lineBreak":true},{"text":"manambe sakeza t’i Efraime.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa ndra t’ie nandeta-­vatañe amo fifeheañeo, hatontoko henaneo,","poem":1},{"lineBreak":true},{"text":"ie fa ninìke ty amy nampijiniam-panjaka","poem":1},{"lineBreak":true},{"text":"naho o roandriañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nampitombo kitrely handilara’e","poem":1},{"lineBreak":true},{"text":"t’i Efraime; hakeo ama’e i kitrely rey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sinokiko ama’e ty raha maro amy","poem":1},{"lineBreak":true},{"text":"Fanoroakoy","poem":1},{"lineBreak":true},{"text":"fe natao’e ho raha ankafaankafa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Banabanae’ iereo soron-draho,","poem":1},{"lineBreak":true},{"text":"isoroña’ iareo hena naho kamae’e;","poem":1},{"lineBreak":true},{"text":"fe tsy no’ Iehovà;","poem":1},{"lineBreak":true},{"text":"ho tiahi’e o tahi’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho ho vale’e o hakeo’ iareoo;","poem":1},{"lineBreak":true},{"text":"himpoly mb’e Mitsraime mb’eo iereo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amy te nandikofa’Israele i Mpitsene azey, vaho nandranjy anjomba bey;","poem":1},{"lineBreak":true},{"text":"fa nampitombo kijoly t’Iakobe","poem":1},{"noteId":31},{"text":";","poem":1},{"lineBreak":true},{"text":"aa le hañirahako afo o rova’eo,","poem":1},{"lineBreak":true},{"text":"fonga habotse’e o anjomba’eo.","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Iakobe: tomitse; misolo am-pitake","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}