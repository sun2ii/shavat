{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"HOS","translationId":"tdx_sle","name":"Hosèa","commonName":"Hosèa","title":"Hosèa","order":28,"numberOfChapters":14,"sha256":"406287a3ea62870f35ade7913d1f88e04b1821aac9dbb397b5b2eaeab4c06116","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Ko mirebeke ry Israele,","poem":1},{"lineBreak":true},{"text":"ko miriñariña an-kobaiñe","poem":1},{"lineBreak":true},{"text":"manahake ondatio;","poem":1},{"lineBreak":true},{"text":"nisitak’ aman’Añahare’o irehe,","poem":1},{"lineBreak":true},{"text":"nitea’o ty tamben-karapilo","poem":1},{"lineBreak":true},{"text":"an-toe-panongàñe eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy hahaeneñe iareo o toe-","poem":1},{"lineBreak":true},{"text":"pamofoha’eo naho o fipiritan-divaio,","poem":1},{"lineBreak":true},{"text":"vaho hifotetse ama’e ty divay vao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsy ho tambatse an-tane’ Iehovà ao;","poem":1},{"lineBreak":true},{"text":"fa hibalike mb’e Mitsraime mb’eo","poem":1},{"lineBreak":true},{"text":"t’i Efraime,","poem":1},{"lineBreak":true},{"text":"naho hilintseñe hàneñe tsy malio","poem":1},{"lineBreak":true},{"text":"e Asore añe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie tsy mañilin-divay am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho tsy ho no’e ka o fisoroña’ iereoo,","poem":1},{"lineBreak":true},{"text":"fa hoe mofom-pandala,","poem":1},{"lineBreak":true},{"text":"fonga tiva ze mikama ama’e:","poem":1},{"lineBreak":true},{"text":"a’ iareo avao izay,","poem":1},{"lineBreak":true},{"text":"fe tsy mete mimoak’ amy anjomba’","poem":1},{"lineBreak":true},{"text":"Iehovày ao ty mahakama’ iareo","poem":1},{"lineBreak":true},{"text":"ty amo arofo’ iareoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ino ty hanoe’ areo amo","poem":1},{"lineBreak":true},{"text":"sabadidam-pitontonañeo?","poem":1},{"lineBreak":true},{"text":"naho amo andro namantaña’ Iehovào?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ingo te nisitaha’ iereo ty fandrotsahañe;","poem":1},{"lineBreak":true},{"text":"fe hatonto’ i Mitsraime, haleve’ i Mofe","poem":1},{"noteId":32},{"lineBreak":true},{"text":"ho lovae’ o hisatseo ze nisoa amo","poem":1},{"lineBreak":true},{"text":"volafoti’ iareoo;","poem":1},{"lineBreak":true},{"text":"fatike ty hitiry amo kivoho’ iareoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa tondroke o androm-pitilihañeo","poem":1},{"lineBreak":true},{"text":"fa pok’eo o androm-pamaleañeo;","poem":1},{"lineBreak":true},{"text":"hapota’ Israele izay;","poem":1},{"lineBreak":true},{"text":"dagola ty mpitoky,","poem":1},{"lineBreak":true},{"text":"minè t’indaty entoen-troke,","poem":1},{"lineBreak":true},{"text":"ty amy fitoabora’ o hakeo’oo,","poem":1},{"lineBreak":true},{"text":"bey ty falaiñañe azo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mpijilojilon’ Añahareko t’i Efraime","poem":1},{"lineBreak":true},{"text":"fe fandri-bom-pitsindroke","poem":1},{"lineBreak":true},{"text":"o sata’ i mpitokiy iabio, toe falaiñañe añ’anjomban’Añahare’e ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa pok’ an-dalek’ ao iereo,","poem":1},{"lineBreak":true},{"text":"naniva vatañe manahake","poem":1},{"lineBreak":true},{"text":"tañ’andro’ i Gibà;","poem":1},{"lineBreak":true},{"text":"toly ndra ho tiahi’e o hakeo’eo","poem":1},{"lineBreak":true},{"text":"vaho ho tilihe’e o tahi’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tendrek’ ahy hoe valòboke","poem":1},{"lineBreak":true},{"text":"an-dratraratra añe t’Israele;","poem":1},{"lineBreak":true},{"text":"nitreako o rae’eo hoe loham-boan-tsakoa amy fifotora’ey;","poem":1},{"lineBreak":true},{"text":"fe nimoake e Baal-peore","poem":1},{"noteId":33},{"lineBreak":true},{"text":"ie nitokañe ho amity raha mahameñatse,","poem":1},{"lineBreak":true},{"text":"vaho naniva vatañe","poem":1},{"lineBreak":true},{"text":"mira amo raha kokoa’ iareoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I Efraime: hitiliñe añe hoe voroñe","poem":1},{"lineBreak":true},{"text":"ty enge’ iareo,","poem":1},{"lineBreak":true},{"text":"ho po-pisamahañe,","poem":1},{"lineBreak":true},{"text":"naho hakoahañe an-koviñe ao","poem":1},{"lineBreak":true},{"text":"vaho tsy am-piareñañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ndra t’ie mañabey anake, hampandalàko,","poem":1},{"lineBreak":true},{"text":"tsy hahatoly lahilahy raike;","poem":1},{"lineBreak":true},{"text":"Eka! hankàñe am’iereo ka te isitahako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I Efraime, manahake ty nahatreavako","poem":1},{"lineBreak":true},{"text":"i Tsore, ie tinongy an-tane fanjàka;","poem":1},{"lineBreak":true},{"text":"fe hakare’ i Efraime ho amy","poem":1},{"lineBreak":true},{"text":"mpanjamañey o ana-dahi’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Atoloro iareo, ry Iehovà","poem":1},{"lineBreak":true},{"text":"ze satri’o hatolotse:","poem":1},{"lineBreak":true},{"text":"toloro hòviñe mampiboloañe","poem":1},{"lineBreak":true},{"text":"naho fatroa kapaike.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"E Gilgale iaby o hakeo’eo,","poem":1},{"lineBreak":true},{"text":"tañe ty namotorako falaiñañe am’ iareo,","poem":1},{"lineBreak":true},{"text":"ami’ty halò-tsere’ o sata’eo ty","poem":1},{"lineBreak":true},{"text":"handroahako iareo amy anjombakoy,","poem":1},{"lineBreak":true},{"text":"tsy hikokoako ka;","poem":1},{"lineBreak":true},{"text":"fonga mpiola o roandria’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Linafa t’i Efraime, maike o vaha’eo,","poem":1},{"lineBreak":true},{"text":"tsy hamokatse voa ka iereo;","poem":1},{"lineBreak":true},{"text":"aa ndra t’ie mahatoly,","poem":1},{"lineBreak":true},{"text":"haitoako ty sabon-koviñe noro’ iareo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hahifin’Añahare añe iereo,","poem":1},{"lineBreak":true},{"text":"ami’ty tsy fañaoña’ iareo Aze;","poem":1},{"lineBreak":true},{"text":"vaho ho mpirererere amo","poem":1},{"lineBreak":true},{"text":"kilakila’ondatio añe","poem":1},{"noteId":34},{"text":".","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Mofe: akiba o vañoñeo","reference":{"chapter":9,"verse":6}},{"noteId":33,"caller":"+","text":"Baal-Peore: Talen-kirike, Andrian-davake","reference":{"chapter":9,"verse":10}},{"noteId":34,"caller":"+","text":"Its 28:36","reference":{"chapter":9,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}