{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["I aroñaroñe nioni’Iesaià",{"noteId":0},"ana’ i Amotse",{"noteId":1},"ty am’ Iehodà",{"noteId":2},"naho Ierosalaime",{"noteId":3},"tañ’andro’ i Ozià",{"noteId":4},", Iotame",{"noteId":5},", Iakaze",{"noteId":6},", naho Iekizkia",{"noteId":7},"mpanjaka’ Iehodà."]},{"type":"verse","number":2,"content":[{"text":"Mitsanoña ry likerañeo,","poem":1},{"lineBreak":true},{"text":"manolora sofiñe ty tane toy,","poem":1},{"lineBreak":true},{"text":"fa mitsara t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Nañabey naho nampi­tombo anake iraho,","poem":1},{"lineBreak":true},{"text":"f’ie niola.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apota ty añombelahy ty tompo’e, naho","poem":1},{"lineBreak":true},{"text":"ty borìke ty lokaloka’ i mpanehak’ azey;","poem":1},{"lineBreak":true},{"text":"fe tsy mahafohiñe t’Israele","poem":1},{"noteId":8},{"text":",","poem":1},{"lineBreak":true},{"text":"tsy maharendreke ondatikoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ry boriza aman-kakeo,","poem":1},{"lineBreak":true},{"text":"ondaty mijiny tahiñeo, tirim-panao raty,","poem":1},{"lineBreak":true},{"text":"anake mitolon-kamengohañe!","poem":1},{"lineBreak":true},{"text":"fa nifarie’ iereo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"nitsambolitio’ iereo t’i Masi’ Israele,","poem":1},{"lineBreak":true},{"text":"aliheñe iereo vaho midisa-voly.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ino ty mbe hanilofañe anahareo,","poem":1},{"lineBreak":true},{"text":"ie mbe mitolom-piola avao?","poem":1},{"lineBreak":true},{"text":"Marare iaby ty añambone,","poem":1},{"lineBreak":true},{"text":"hene toirañe ty arofo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boak’an-dela-pandia pak’añambone’e,","poem":1},{"lineBreak":true},{"text":"tsy ama’e ty janga, fa fere,","poem":1},{"lineBreak":true},{"text":"vonotroboke naho bae miborentatse:","poem":1},{"lineBreak":true},{"text":"tsy nitindrieñe, tsy nibandieñe,","poem":1},{"lineBreak":true},{"text":"tsy nihosoren-tsolike.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mangoakoake ty tane’ areo;","poem":1},{"lineBreak":true},{"text":"finorototo’ ty afo ty rova’ areo;","poem":1},{"lineBreak":true},{"text":"fa nabotse’ ty ambahiny añatrefa’ areo","poem":1},{"lineBreak":true},{"text":"ty tane’ areo; le koake,","poem":1},{"lineBreak":true},{"text":"hoe t’ie navalitaboam-pisorotombahañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le nengañe hoe kijà an-tetem-bahe ey","poem":1},{"lineBreak":true},{"text":"ty anak’ampela’ i Tsione,","poem":1},{"lineBreak":true},{"text":"hoe kibohotse an-tanem-bazavo ao,","poem":1},{"lineBreak":true},{"text":"hoe rova arikatohem-paname.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naho tsy sinisa’ Iehovà’ i Màroy sehanga’e tikañe, le ho ni-hoe Sedome","poem":1},{"noteId":9},{"text":",","poem":1},{"lineBreak":true},{"text":"ho nanahake i Amorà","poem":1},{"noteId":10},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Janjiño ty tsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ry mpifehe’ i Sedome;","poem":1},{"lineBreak":true},{"text":"toloro ravembia i Tsaran’","poem":1},{"lineBreak":true},{"text":"Añaharen-tikañey, ry nte-Amorà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Inoñ’amako o soroñe mitozantozañeo?","poem":1},{"lineBreak":true},{"text":"Hoe t’Iehovà: Fa mahaetsak’ahy","poem":1},{"lineBreak":true},{"text":"o añondrilahy engaeñe horoañeo,","poem":1},{"lineBreak":true},{"text":"naho o safom-biby vinondrakeo;","poem":1},{"lineBreak":true},{"text":"tsy mahafale ahy ty liom-bania","poem":1},{"lineBreak":true},{"text":"ndra o vik’añondrio,","poem":1},{"lineBreak":true},{"text":"ndra o añondrilahio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie mb’etoa nahareo hiatrek’ amako,","poem":1},{"lineBreak":true},{"text":"ia ty nipay am-pità’ areo te","poem":1},{"lineBreak":true},{"text":"ho lialià’ areo o kiririsakoo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ko añenga’areo raha koake ka;","poem":1},{"lineBreak":true},{"text":"ie enga tiva amako;","poem":1},{"lineBreak":true},{"text":"O jiribolañeo, o Sabatao","poem":1},{"noteId":11},{"text":",","poem":1},{"lineBreak":true},{"text":"o fivory koiheñeo:","poem":1},{"lineBreak":true},{"text":"Tsy leoko o fivori-miavake","poem":1},{"lineBreak":true},{"text":"milaro haratiañeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Heje’ ty troko o jiri’bola’ areoo","poem":1},{"lineBreak":true},{"text":"naho o takataka-tinendre’ areoo;","poem":1},{"lineBreak":true},{"text":"Ie manosots’ ahy, hejeko ho vaveñe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naho amelara’areo tañañe,","poem":1},{"lineBreak":true},{"text":"le ho takonako ty masoko;","poem":1},{"lineBreak":true},{"text":"Eka ndra t’ie mitolon-kalaly,","poem":1},{"lineBreak":true},{"text":"tsy ho tsanoñeko, fa pea lio o fità’ areoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Miandroa, miliova;","poem":1},{"lineBreak":true},{"text":"asitaho tsy ho aolo’ masoko","poem":1},{"lineBreak":true},{"text":"ty halò-tserem-pitoloña’ areo;","poem":1},{"lineBreak":true},{"text":"mijihera amo fanoañe ratio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mianara hanao ty soa; tsoeho ty hato,","poem":1},{"lineBreak":true},{"text":"avotsoro o forekekeñeo,","poem":1},{"lineBreak":true},{"text":"omeo to ty bode rae,","poem":1},{"lineBreak":true},{"text":"mihalalia ho a o vantotseo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Antao hisafiry arè, hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"ndra te mena mandofiry ty hakeo’ areo,","poem":1},{"lineBreak":true},{"text":"le ho foty matsatsaoke;","poem":1},{"lineBreak":true},{"text":"ndra t’ie mena mañabasà,","poem":1},{"lineBreak":true},{"text":"le hanahake volon’añondry.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie miato naho tsy manjehatse,","poem":1},{"lineBreak":true},{"text":"ro hikama ty hasoa’ i taney.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"F’ie mandietse vaho miola,","poem":1},{"lineBreak":true},{"text":"le habotse’ ty fibara;","poem":1},{"lineBreak":true},{"text":"izay ty nitsaraem-palie’ Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Akore te nanjare karapilo","poem":1},{"lineBreak":true},{"text":"i rova matoey!","poem":1},{"lineBreak":true},{"text":"ie nilifotse ty hatò,","poem":1},{"lineBreak":true},{"text":"nimoneñe an-kavañonañe,","poem":1},{"lineBreak":true},{"text":"te mone mpañoho-doza henaneo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa tai’e avao ty volafoti’o,","poem":1},{"lineBreak":true},{"text":"botsa-drano ty divai’o.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mpikitro-karatiañe o ana-dona’oo,","poem":1},{"lineBreak":true},{"text":"mpirañetse ami’ty malaso;","poem":1},{"lineBreak":true},{"text":"songa mpitea vokàñe","poem":1},{"lineBreak":true},{"text":"naho mpañori-tambe;","poem":1},{"lineBreak":true},{"text":"tsy mea’ iereo to ty bode rae,","poem":1},{"lineBreak":true},{"text":"vaho tsy atrefe’ iareo ty entam-bantotse.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le hoe t’i Talè, Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"i Hafatrara’ Israeley:","poem":1},{"lineBreak":true},{"text":"Hete! Hafahako amako o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"vaho ho valèko o malaiñe ahikoo;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Le hahimpako ama’o ty tañako,","poem":1},{"lineBreak":true},{"text":"naho ho lioveko hoe amañ’asidra","poem":1},{"lineBreak":true},{"text":"ty taim-bi’o,","poem":1},{"lineBreak":true},{"text":"vaho hafahako iaby o kanki’oo;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Le hampoliko o mpizaka’oo","poem":1},{"lineBreak":true},{"text":"manahake tam-baloha’e añe,","poem":1},{"lineBreak":true},{"text":"naho o mpanolo-keve’oo","poem":1},{"lineBreak":true},{"text":"hambañe am-pifotora’e añe:","poem":1},{"lineBreak":true},{"text":"vaho hatao ty hoe irehe:","poem":1},{"lineBreak":true},{"text":"Rova-Kavantañañe, Posetse Matoe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ho jebañeñe ami’ty hatò ty Tsione,","poem":1},{"lineBreak":true},{"text":"naho an-­kavantañañe o aze mimpolio.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fe hitrao-pirotsahañe","poem":1},{"lineBreak":true},{"text":"o mpanan-kakeo naho mpanan-tahiñeo,","poem":1},{"lineBreak":true},{"text":"vaho ho hotomomoheñe","poem":1},{"lineBreak":true},{"text":"ze mienga Iehovà.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Toe hisalara’ iereo o kile nisalalaeñeo,","poem":1},{"lineBreak":true},{"text":"vaho himeñara’ areo o goloboñe nivihañeo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hanahake ty kile","poem":1},{"lineBreak":true},{"text":"aman-drave’e miheatse nahareo,","poem":1},{"lineBreak":true},{"text":"naho hoe goloboñe tsy aman-drano.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ho pipìke ty maozatse,","poem":1},{"lineBreak":true},{"text":"ho tsipelats’afo o tolon-draha’eo;","poem":1},{"lineBreak":true},{"text":"hiharo hiforehetse iereon-droroe,","poem":1},{"lineBreak":true},{"text":"le tsy eo ty hampikipeke.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Iesaia: Ty fandrombaha’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Amotse: Maozatse","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"Iehodà: fandrengea’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"Ierosalaime: Aroñarom-panintsiñañe","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"+","text":"Ozia: ty haozara’ Iehovà; ty anak’ose’e","reference":{"chapter":1,"verse":1}},{"noteId":5,"caller":"+","text":"Iotame: Ty Hafonira’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":6,"caller":"+","text":"Iakaze: Mpitavañe","reference":{"chapter":1,"verse":1}},{"noteId":7,"caller":"+","text":"Iekizkia: ty hafatrara’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":8,"caller":"+","text":"Israele: mpifanehak’ aman’ Añahare","reference":{"chapter":1,"verse":3}},{"noteId":9,"caller":"+","text":"Sedome: ty tsikotsiko’e; ty simà’e","reference":{"chapter":1,"verse":9}},{"noteId":10,"caller":"+","text":"Amorà: Ondaty miola","reference":{"chapter":1,"verse":9}},{"noteId":11,"caller":"+","text":"Sabata: andro faha-fito, naho toe i fito nifotoañañe ami’ty taoñe rey","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}