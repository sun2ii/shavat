{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe amo manampa-pepètse tsivokatseo,","poem":1},{"lineBreak":true},{"text":"naho o mampipatetse famorekekeañeo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ty mampivike o ­misotrio","poem":1},{"lineBreak":true},{"text":"tsy hahazoa’e to,","poem":1},{"lineBreak":true},{"text":"vaho mitavañe ty zo’ o rarake am’ondatikoo,","poem":1},{"lineBreak":true},{"text":"hihaofa’ iareo o vantotseo,","poem":1},{"lineBreak":true},{"text":"hitsatsà’ iareo o bode-raeo!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le ino ty hanoe’ areo","poem":1},{"lineBreak":true},{"text":"amy androm-pitilihañey,","poem":1},{"lineBreak":true},{"text":"naho amy hekoheko hifetsake boak’añey?","poem":1},{"lineBreak":true},{"text":"fa hipay imba ama’ia nahareo?","poem":1},{"lineBreak":true},{"text":"vaho hapo’ areo aia ty vara’ areo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ino ty hanoeñe,","poem":1},{"lineBreak":true},{"text":"naho tsy hitsilofìñe amo tsinepakeo,","poem":1},{"lineBreak":true},{"text":"ndra hitsingoritritse amo vinonoo?","poem":1},{"lineBreak":true},{"text":"Amy hoe zay iaby,","poem":1},{"lineBreak":true},{"text":"mboe tsy mitolike ty haviñera’e,","poem":1},{"lineBreak":true},{"text":"mbore mbe mitora-kitsy ty fità’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O Asore, kobain-kaviñerakoo,","poem":1},{"lineBreak":true},{"text":"ry dodan-­katorifihako am-pità’ iareoo:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hiraheko haname ty fifeheañe","poem":1},{"lineBreak":true},{"text":"tsy ­vokatse,","poem":1},{"lineBreak":true},{"text":"hafantoko am’ondaty ­iviñerakoo, hikopaha’e naho hitsindroha’e vaho handialia’e hoe fotake an-dalañe eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy apota’e izay,","poem":1},{"lineBreak":true},{"text":"toe tsy am-pitsakorean-tro’e;","poem":1},{"lineBreak":true},{"text":"fe ty handrotsake ro firefea’e,","poem":1},{"lineBreak":true},{"text":"ty hañito fifeheañe maro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa hoe re: Tsy songa mpanjaka","poem":1},{"lineBreak":true},{"text":"hao o roandriakoo?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy hambañe amy Karkemise","poem":1},{"noteId":44},{"lineBreak":true},{"text":"hao ty Kalnè","poem":1},{"noteId":45},{"text":"?","poem":1},{"lineBreak":true},{"text":"Naho amy Kamate","poem":1},{"noteId":46},{"text":"ty Arpade","poem":1},{"noteId":47},{"text":"?","poem":1},{"lineBreak":true},{"text":"Vaho amy Damesèke ty Somerone?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Manahake ty nitakaran-tañako","poem":1},{"lineBreak":true},{"text":"o borizañe an-tsamposampo tsieo,","poem":1},{"lineBreak":true},{"text":"ie maro te amo hazomanga e","poem":1},{"lineBreak":true},{"text":"Ierosalaime naho e Someroneo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa tsy hanoeko am’ Ierosalaime naho","poem":1},{"lineBreak":true},{"text":"o hazomanga’eo hao,","poem":1},{"lineBreak":true},{"text":"ty nanoeko amy Somerone reketse","poem":1},{"lineBreak":true},{"text":"o hazomanga’eo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le ho tondroke te","poem":1},{"lineBreak":true},{"text":"ie nihenefa’ i Talè","poem":1},{"lineBreak":true},{"text":"ty fitoloña’e am-bohi’ i Tsioney eo","poem":1},{"lineBreak":true},{"text":"naho am’ Ierosalaime eo,","poem":1},{"lineBreak":true},{"text":"le hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ho liloveko o vokan’ arofo","poem":1},{"lineBreak":true},{"text":"irengevoha’ i mpanjaka’ i Asoreio","poem":1},{"lineBreak":true},{"text":"naho o engen-dahara’e mievoñevoñeo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ami’ty nanoe’e ty hoe:","poem":1},{"lineBreak":true},{"text":"Ami’ty haozaran-tàñako naho ami’ty hihiko ty nanoako izay,","poem":1},{"lineBreak":true},{"text":"toe mahilala iraho;","poem":1},{"lineBreak":true},{"text":"fonga nafahako ty efe-tane’ondatio","poem":1},{"lineBreak":true},{"text":"naho nikamereko ty vara’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho nampitsingoro o mpimone’ iareoo","poem":1},{"lineBreak":true},{"text":"hoe asam-panalolahy;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le nitakaren-tañako manahake te","poem":1},{"lineBreak":true},{"text":"nitrañom-boroñe ty vara’","poem":1},{"lineBreak":true},{"text":"ze hene ondaty;","poem":1},{"lineBreak":true},{"text":"hoe fitontonan-atoly naforintseñe","poem":1},{"lineBreak":true},{"text":"ty nanontonako ty tane toy iaby;","poem":1},{"lineBreak":true},{"text":"tsy teo ty nañetseke elatse,","poem":1},{"lineBreak":true},{"text":"ndra nanoka-bava, ndra nivolañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hiebotsebotse amy mitañ’azey","poem":1},{"lineBreak":true},{"text":"hao ty fekoñe?","poem":1},{"lineBreak":true},{"text":"Hitsingevongevo amy mandronje azey","poem":1},{"lineBreak":true},{"text":"hao ty lasý?","poem":1},{"lineBreak":true},{"text":"Manahake ty kobaiñe manjonjoñe","poem":1},{"lineBreak":true},{"text":"ty mivontititse ama’e,","poem":1},{"lineBreak":true},{"text":"naho ty fitoñoñe mañongake ty raha tsy hatae.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le hañitrike haborokàñe amo","poem":1},{"lineBreak":true},{"text":"vondra’eo t’i Talè, Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"le ho viañeñe ambane’ i enge’ey eo","poem":1},{"lineBreak":true},{"text":"ty hatomomohañe hoe afo mamorototo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hinjare afo ty failo’ Israele","poem":1},{"lineBreak":true},{"text":"naho lel’afo i Masi’ey;","poem":1},{"lineBreak":true},{"text":"hiforehetse hampitomontoñe","poem":1},{"lineBreak":true},{"text":"o fati’eo naho o hisa’eo","poem":1},{"lineBreak":true},{"text":"añate ty andro raike.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ty enge’ i ala’ey","poem":1},{"lineBreak":true},{"text":"naho i tete’e kobokaray ty","poem":1},{"lineBreak":true},{"text":"hagodra’e troke naho tsandriñe;","poem":1},{"lineBreak":true},{"text":"manahake ty finiha’ t’indaty siloke.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho tsiampe ty hatae sisa añ’ala’e ao,","poem":1},{"lineBreak":true},{"text":"ndra ajaja ty hahavolily aze.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te tsy","poem":1},{"lineBreak":true},{"text":"hiato amy namofoke iareo ty sengaha’","poem":1},{"lineBreak":true},{"text":"Israele naho o nandrifitse amy","poem":1},{"lineBreak":true},{"text":"anjomba’ Iakobeio;","poem":1},{"lineBreak":true},{"text":"fe Iehovà Masi’ Israele","poem":1},{"lineBreak":true},{"text":"ty hiatoa’ iareo ami’ty hatò.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Himpoly ty sehanga’e, ty honka’ Iakobe, mb’aman’ Añahare Tsitongereñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa ndra te mira ami’ty faseñe","poem":1},{"lineBreak":true},{"text":"an-driakey ondati’oo ry Israele,","poem":1},{"lineBreak":true},{"text":"ty sehanga’e avao ty himpoly;","poem":1},{"lineBreak":true},{"text":"fa fanjamanañe","poem":1},{"lineBreak":true},{"text":"lifo-kavañonañe ty tinendre.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Famongorañe do’e, toe najadoñe,","poem":1},{"lineBreak":true},{"text":"ty hafetsa’ i Talè, Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"añ’ivo i tane iabiy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le hoe t’i Talè, Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"O ry ondatiko mpimoneñe e Tsioneo,","poem":1},{"lineBreak":true},{"text":"ko hembañe amy Asore,","poem":1},{"lineBreak":true},{"text":"ndra te fofohe’e an-doda,","poem":1},{"lineBreak":true},{"text":"naho añonjona’e kobay handafà’e azo","poem":1},{"lineBreak":true},{"text":"ami’ty sata’ i Mitsraime.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa hanintsiñe aniany","poem":1},{"lineBreak":true},{"text":"o heloko miforoforoo,","poem":1},{"lineBreak":true},{"text":"vaho ho amy fandrotsahañe iareoy","poem":1},{"lineBreak":true},{"text":"ty habosehako.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Le ho tsekafe’ Iehovà’ i Màroy ama’e","poem":1},{"lineBreak":true},{"text":"ty karavantsy,","poem":1},{"lineBreak":true},{"text":"manahake ty nanjamanañe i Midiane","poem":1},{"lineBreak":true},{"text":"am-bato’ i Orebe","poem":1},{"noteId":48},{"text":"añe;","poem":1},{"lineBreak":true},{"text":"naho ho ambone’ i riakey ey ty kobai’e,","poem":1},{"lineBreak":true},{"text":"vaho honjone’e manahake ty nanoe’e amy Mitsraime.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, hihintsañe tsy","poem":1},{"lineBreak":true},{"text":"ho antsoro’o eo ty kilanka’e,","poem":1},{"lineBreak":true},{"text":"naho tsy ho an-kàto’o eo ty joka’e,","poem":1},{"lineBreak":true},{"text":"toe hipozake amy havondrahañey i jokay.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fa nivotrak’e Aiate","poem":1},{"noteId":49},{"text":"re,","poem":1},{"lineBreak":true},{"text":"fa nirangae’e ty Migrone","poem":1},{"noteId":50},{"text":";","poem":1},{"lineBreak":true},{"text":"e Mikmase","poem":1},{"noteId":51},{"text":"ao ty nampipoha’e","poem":1},{"lineBreak":true},{"text":"o harao’eo;","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nitsahe’ iereo i hebam-bohitsey;","poem":1},{"lineBreak":true},{"text":"nialeñe e Gèbà","poem":1},{"noteId":52},{"text":"añe;","poem":1},{"lineBreak":true},{"text":"nihondrahondra t’i Ramae","poem":1},{"noteId":53},{"text":";","poem":1},{"lineBreak":true},{"text":"nibotafotse añe ty Gibae","poem":1},{"noteId":54},{"text":"’ i Saole","poem":1},{"noteId":55},{"text":".","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mampikoiaha feo","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ i Galime","poem":1},{"noteId":56},{"text":":","poem":1},{"lineBreak":true},{"text":"manokilaña ravembia ry Laise","poem":1},{"noteId":57},{"text":"!","poem":1},{"lineBreak":true},{"text":"Ry Anatote","poem":1},{"noteId":58},{"text":"mahaferenaiñeo!","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Fa nivoratsake ty Madmenae","poem":1},{"noteId":59},{"text":";","poem":1},{"lineBreak":true},{"text":"fa mitsoloke o mpimone’ i Gebimeo","poem":1},{"noteId":60},{"text":".","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Hitofa e Nobe","poem":1},{"noteId":61},{"text":"ao re te anito,","poem":1},{"lineBreak":true},{"text":"hañonjo-haok’ amy vohi’ i anak’ampela’","poem":1},{"lineBreak":true},{"text":"i Tsione an-kaboa’ Ierosalaimey.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Eka, ho birae’ i Talè, Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"an-kaviñerañe o tsampa’eo;","poem":1},{"lineBreak":true},{"text":"le ho firaeñe añe o mijoalao,","poem":1},{"lineBreak":true},{"text":"vaho ho tomoreñe o mininginingio.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ho firae’e am-biñe o ala matahetseo,","poem":1},{"lineBreak":true},{"text":"le hideboñe hoe fanalolahy t’i Lebanone.","poem":1}]}],"footnotes":[{"noteId":44,"caller":"+","text":"Karkemise: rova’ i mpañambaney","reference":{"chapter":10,"verse":9}},{"noteId":45,"caller":"+","text":"Kalnè: ty fahafonirantika; vata’e ie avao","reference":{"chapter":10,"verse":9}},{"noteId":46,"caller":"+","text":"Kamate: haviñerañe, fiforoforoañe; kijoly","reference":{"chapter":10,"verse":9}},{"noteId":47,"caller":"+","text":"Arpade: ty hazavam-pijebañañe","reference":{"chapter":10,"verse":9}},{"noteId":48,"caller":"+","text":"Orebe: Koake","reference":{"chapter":10,"verse":26}},{"noteId":49,"caller":"+","text":"Aite: ora raike; fihaino; rano hanahana","reference":{"chapter":10,"verse":28}},{"noteId":50,"caller":"+","text":"Migrone: hembañe; teteke; tretrake","reference":{"chapter":10,"verse":28}},{"noteId":51,"caller":"+","text":"Mikmase: i mpadafay","reference":{"chapter":10,"verse":28}},{"noteId":52,"caller":"+","text":"Gibà: tamboho; fitihike","reference":{"chapter":10,"verse":29}},{"noteId":53,"caller":"+","text":"Ramae: Naonjoñe; mierañerañe","reference":{"chapter":10,"verse":29}},{"noteId":54,"caller":"+","text":"Gibae: tamboho","reference":{"chapter":10,"verse":29}},{