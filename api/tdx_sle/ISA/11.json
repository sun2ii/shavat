{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Hitiry ami’ty foto’ Iisày","poem":1},{"noteId":62},{"text":"ty singa’e,","poem":1},{"lineBreak":true},{"text":"vaho hitomiry boak’am-baha’e ty tora’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hipetak’ ama’e ty Arofo’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty arofon-kihitse naho faharendrehañe,","poem":1},{"lineBreak":true},{"text":"ty arofom-panoroañe naho haozarañe,","poem":1},{"lineBreak":true},{"text":"ty arofon-kilala naho ty fañeveñañe","poem":1},{"lineBreak":true},{"text":"am’ Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ty fañeveñañe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ro mahafale ty arofo’e.","poem":1},{"lineBreak":true},{"text":"Tsy ty isam-pihaino’e ro hizaka’e,","poem":1},{"lineBreak":true},{"text":"tsy ty fijanjiñan-dravembia’e","poem":1},{"lineBreak":true},{"text":"ro hisafiria’e;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa an-kavantañañe","poem":1},{"lineBreak":true},{"text":"ro hizaka’e o rarakeo,","poem":1},{"lineBreak":true},{"text":"vaho an-kahiti’e ro handilia’e","poem":1},{"lineBreak":true},{"text":"o mpirèke an-tane atoio.","poem":1},{"lineBreak":true},{"text":"Ho lafae’e ami’ty kobaim-palie’e i taney,","poem":1},{"lineBreak":true},{"text":"le ho zamane’e ami’ty kofòm-pivimbi’e","poem":1},{"lineBreak":true},{"text":"o tsereheñeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hidian-kamarentane ty vania’e","poem":1},{"lineBreak":true},{"text":"vaho hiteveke figahiñañe o toha’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hitrao-pimoneñe ty marambolo","poem":1},{"lineBreak":true},{"text":"naho ty anak’añondry,","poem":1},{"lineBreak":true},{"text":"hiharo fandreañe ty farasy","poem":1},{"lineBreak":true},{"text":"naho ty anak’ose;","poem":1},{"lineBreak":true},{"text":"hifampireketse ty sarake","poem":1},{"lineBreak":true},{"text":"naho ty liona vaho ty vosy;","poem":1},{"lineBreak":true},{"text":"Anak’ajaja ty hiarake iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hitrao-pihinañe ty añombe rene’e","poem":1},{"lineBreak":true},{"text":"naho ty dobe","poem":1},{"noteId":63},{"text":";","poem":1},{"lineBreak":true},{"text":"hiharo fandreañe o ana’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho hihota-ahetse manahake","poem":1},{"lineBreak":true},{"text":"ty añombe ty liona.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hihisa ambonen-davan-dapetake","poem":1},{"lineBreak":true},{"text":"ty ajaja minono,","poem":1},{"lineBreak":true},{"text":"hajo’ ty anak’ajaja an-doan-davam-boae ao ty taña’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho amy vohiko miavakey iaby ty hijoy ndra ty hamono;","poem":1},{"lineBreak":true},{"text":"fa ho tsitsike ty faharendrehañe","poem":1},{"lineBreak":true},{"text":"Iehovà ty tane toy,","poem":1},{"lineBreak":true},{"text":"manahake ty haatsa-drano’ i riakey","poem":1},{"noteId":64},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, hitroatse ho viloñe am’ondatio ty Vaha’ Iesày,","poem":1},{"lineBreak":true},{"text":"le hipay Aze o Kilakila’ndatio,","poem":1},{"lineBreak":true},{"text":"vaho ho lifots’engeñe ty toe-pitofà’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te","poem":1},{"lineBreak":true},{"text":"hahiti’ i Talè fañindroe’e ty fità’e","poem":1},{"lineBreak":true},{"text":"hampolia’e ty sehanga’ ondati’eo,","poem":1},{"lineBreak":true},{"text":"Ty henka’ i Asore, naho","poem":1},{"lineBreak":true},{"text":"ty boake Mitsraime, naho","poem":1},{"lineBreak":true},{"text":"ty boake Patrose","poem":1},{"noteId":65},{"text":", naho","poem":1},{"lineBreak":true},{"text":"ty boake Kose","poem":1},{"noteId":66},{"text":", naho","poem":1},{"lineBreak":true},{"text":"ty boak’ Elame","poem":1},{"noteId":67},{"text":", naho","poem":1},{"lineBreak":true},{"text":"ty boake Sinare","poem":1},{"noteId":68},{"text":", naho","poem":1},{"lineBreak":true},{"text":"ty boake Kamate, vaho","poem":1},{"lineBreak":true},{"text":"ty boak’ amo tokonose andriakeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le hampitroara’e viloñe o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"hatonto’e o naparatsake boak’ Israeleo,","poem":1},{"lineBreak":true},{"text":"vaho havori’e o naparaitake am’ Iehodà hirik’ an-kotsok’ efa’ ty tane toio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hisitake amy Efraime ty fihàña’e,","poem":1},{"lineBreak":true},{"text":"naho haitoañe ty helo’ Iehodà;","poem":1},{"lineBreak":true},{"text":"tsy hitsikirìke i Efraime t’Iehodà,","poem":1},{"lineBreak":true},{"text":"le tsy hañembetse Iehodà t’i Efraime.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"F’ie hitsiritsioke am-pivariña’","poem":1},{"lineBreak":true},{"text":"o nte-Pilisty ahandrefañeo;","poem":1},{"lineBreak":true},{"text":"hitrao-pamaoke o anan-tatiñanañeo;","poem":1},{"lineBreak":true},{"text":"songa hampitora-kitsie’ iereo fitàñe","poem":1},{"lineBreak":true},{"text":"t’i Edome","poem":1},{"noteId":69},{"text":"naho i Moabe","poem":1},{"noteId":70},{"text":";","poem":1},{"lineBreak":true},{"text":"vaho hiambane am’ iereo t’i Amone","poem":1},{"noteId":71},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho mongore’ Iehovà ty lela’","poem":1},{"lineBreak":true},{"text":"i ria’ i Mitsraimey;","poem":1},{"lineBreak":true},{"text":"le ami’ty tio’e mae mihoboboke","poem":1},{"lineBreak":true},{"text":"ty añelahelà’e ambone’ i Oñey ty fità’e","poem":1},{"lineBreak":true},{"text":"vaho ho fofohe’e ho torahañe fito,","poem":1},{"lineBreak":true},{"text":"hampitsaha’e ondatio an-kana.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Le ho ami’ty sehanga ondati’e boak’ Asoreo ty lalañe dinamoke,","poem":1},{"lineBreak":true},{"text":"manahake tamy niakara’ o ana’ Israeleo","poem":1},{"lineBreak":true},{"text":"i Mitsraime.","poem":1}]}],"footnotes":[{"noteId":62,"caller":"+","text":"Iisay: ravoravo; banabana","reference":{"chapter":11,"verse":1}},{"noteId":63,"caller":"+","text":"Dobe: Biby romotse jabajaba","reference":{"chapter":11,"verse":7}},{"noteId":64,"caller":"+","text":"Kab 2:14","reference":{"chapter":11,"verse":9}},{"noteId":65,"caller":"+","text":"Patrose: falie pea koba; t’ie ho rotsake","reference":{"chapter":11,"verse":11}},{"noteId":66,"caller":"+","text":"Kose: nte-Etiopia; mainte","reference":{"chapter":11,"verse":11}},{"noteId":67,"caller":"+","text":"Elame: ajalahy; somondrara; tangogo","reference":{"chapter":11,"verse":11}},{"noteId":68,"caller":"+","text":