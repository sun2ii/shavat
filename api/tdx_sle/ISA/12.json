"lineBreak":true},{"text":"amy andro zay: andriaño t’Iehovà, kanjio i Tahina’ey;","poem":1},{"lineBreak":true},{"text":"ampahoniño o kilakila ondatio","poem":1},{"lineBreak":true},{"text":"o fitoloña’eo,","poem":1},{"lineBreak":true},{"text":"vaho taroño ty haandikera’ i tahina’ey,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Misaboa am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty amo raha fanjaka anoe’eo;","poem":1},{"lineBreak":true},{"text":"ehe te hene hahaoniñe izay","poem":1},{"lineBreak":true},{"text":"o an-tane atoio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mipazapazaha, poñafo ty sabo,","poem":1},{"lineBreak":true},{"text":"ry nte-Tsioneo,","poem":1},{"lineBreak":true},{"text":"amy te jabahinake añivo’ areo ao","poem":1},{"lineBreak":true},{"text":"t’i Masi’ Israele.","poem":1}]}],"footnotes":[{"noteId":72,"caller":"+","text":"Ià: fampiboriañe ty hoe Iehovà","reference":{"chapter":12,"verse":2}},{"noteId":73,"caller":"+","text":"Avo 15:2, Sab 118:14","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/tdx_sle/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}