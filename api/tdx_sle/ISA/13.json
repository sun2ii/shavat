content":[{"lineBreak":true},{"text":"Le tsy hañomey ty hazavà’e","poem":1},{"lineBreak":true},{"text":"o vasian-dikerañeo","poem":1},{"lineBreak":true},{"text":"naho o fitoboroña’eo,","poem":1},{"lineBreak":true},{"text":"ho maieñe i àndroy te manjirike,","poem":1},{"lineBreak":true},{"text":"vaho tsy hampaviahe’ i volañey","poem":1},{"lineBreak":true},{"text":"ty hazavà’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho liloveko ty tane toy","poem":1},{"lineBreak":true},{"text":"ty amo hakeo’ iareoo,","poem":1},{"lineBreak":true},{"text":"o tsy vokatseo ty amo tahi’ iareoo,","poem":1},{"lineBreak":true},{"text":"le haziko ty firengevoha’","poem":1},{"lineBreak":true},{"text":"o mpiebotsebotseo,","poem":1},{"lineBreak":true},{"text":"vaho hazevoko ambane ty fireñeta’","poem":1},{"lineBreak":true},{"text":"o mpamorekekeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hanoeko loho sarotse ta ty volamena","poem":1},{"lineBreak":true},{"text":"hiringiri’e t’indaty;","poem":1},{"lineBreak":true},{"text":"le ambone’ ty vongam-bola­mena’ i Ofirey","poem":1},{"noteId":76},{"text":"ondatio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le hampiezeñezeñeko o likerañeo,","poem":1},{"lineBreak":true},{"text":"naho hahifikifike tsy ho amy toe’ey","poem":1},{"lineBreak":true},{"text":"ty tane toy,","poem":1},{"lineBreak":true},{"text":"ty ami’ty fifombo’ Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"amy andron-kaviñera’e miloroloroy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho tondroke amy zay t’ie hanahake","poem":1},{"lineBreak":true},{"text":"ty farasy rinoake","poem":1},{"lineBreak":true},{"text":"naho ty añondry tsy amam-pamory","poem":1},{"lineBreak":true},{"text":"sindre milay mb’an-tane’e mb’eo,","poem":1},{"lineBreak":true},{"text":"songa himpoly mb’am’ondati’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho tomboheñe iaby ze zoeñe,","poem":1},{"lineBreak":true},{"text":"vaho hene hampikorovohem-pibara","poem":1},{"lineBreak":true},{"text":"ze tsinepake.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho demodemoheñe añatrefam-","poem":1},{"lineBreak":true},{"text":"pihaino’iareo o anak’ajaja’ iareoo;","poem":1},{"lineBreak":true},{"text":"ho kopaheñe ty anjomba’ iareo, vaho","poem":1},{"lineBreak":true},{"text":"ho vahorañe ty rakemba’ iareo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Eka, ho troboheko am’ iareo","poem":1},{"lineBreak":true},{"text":"o nte-Madaio","poem":1},{"noteId":77},{"text":",","poem":1},{"lineBreak":true},{"text":"o tsy mañaom-bolafotio;","poem":1},{"lineBreak":true},{"text":"ndra volamena tsy ifalea’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho trofatrofahem-pale o ajalahio;","poem":1},{"lineBreak":true},{"text":"tsy ho ferenaiña’ iareo","poem":1},{"lineBreak":true},{"text":"ty vokan-koviñe;","poem":1},{"lineBreak":true},{"text":"tsy ho tretrezem-­pihaino’e o ajajao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I Bavele amy zao,","poem":1},{"lineBreak":true},{"text":"i volonahe’ o fifeheañeoy,","poem":1},{"lineBreak":true},{"text":"i fisengea’ o nte-Kasdio","poem":1},{"noteId":78},{"text":"fanjakay:","poem":1},{"lineBreak":true},{"text":"le hanahake ty fandrotsahan’Añahare","poem":1},{"lineBreak":true},{"text":"i Sedome naho i Amorà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le lia’e tsy ho amam-pimoneñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy hañialo ao","poem":1},{"lineBreak":true},{"text":"o tariratse mifandimbeo;","poem":1},{"lineBreak":true},{"text":"tsy hañoren-kivoho eo t’i nte-Arabe","poem":1},{"noteId":79},{"text":",","poem":1},{"lineBreak":true},{"text":"tsy hamahetse goloboñe ao o mpiarakeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Toe ho fandrea’ o fanalokeo;","poem":1},{"lineBreak":true},{"text":"ho àtseke ty ontsoñontsoñe","poem":1},{"lineBreak":true},{"text":"o anjomba’ iareoo,","poem":1},{"lineBreak":true},{"text":"himoneñe ao o voron-tsatrañeo,","poem":1},{"lineBreak":true},{"text":"vaho hitsinjake ao o lolo miogogoo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hañaolo añ’anjomba-hara’ iareo ao","poem":1},{"lineBreak":true},{"text":"o maràmboloo naho o amboa sirasirao","poem":1},{"lineBreak":true},{"text":"an-toe’ iareo fanjakao;","poem":1},{"lineBreak":true},{"text":"fa antitotse ty amotoañañe aze,","poem":1},{"lineBreak":true},{"text":"vaho tsy haesoñe o andro’eo.","poem":1}]}],"footnotes":[{"noteId":74,"caller":"+","text":"Bavele: hadabañe; filaroañe","reference":{"chapter":13,"verse":1}},{"noteId":75,"caller":"+","text":"Ies 24:1-23, 34:1-17, 63:1-19, 66:1-24","reference":{"chapter":13,"verse":5}},{"noteId":76,"caller":"+","text":"Ofire: tane kobokara","reference":{"chapter":13,"verse":12}},{"noteId":77,"caller":"+","text":"Maday: fañaranañe; zaka; saroñe","reference":{"chapter":13,"verse":17}},{"noteId":78,"caller":"+","text":"Kasdy: hoe kokolampa; ndra malaso","reference":{"chapter":13,"verse":19}},{"noteId":79,"caller":"+","text":"Arabe: mihamaro; mitongy fiolàñe;","reference":{"chapter":13,"verse":20}}]},"thisChapterLink":"/api/tdx_sle/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}