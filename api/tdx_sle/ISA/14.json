{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Aa ie tretreze’ Iehovà t’Iakobe,","poem":1},{"lineBreak":true},{"text":"naho joboñe’e t’Israele, vaho","poem":1},{"lineBreak":true},{"text":"hampimoneñe’e an-tane’ iareo eo;","poem":1},{"lineBreak":true},{"text":"le hirekets’ am’ iereo ty renetane,","poem":1},{"lineBreak":true},{"text":"hipitek’ amy anjomba’ Iakobey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ho rambese’ o kilakila’ ndatio","poem":1},{"lineBreak":true},{"text":"naho hasese’iareo mb’an-toe’ iareo mb’eo;","poem":1},{"lineBreak":true},{"text":"ie ho fanaña’ i anjomba’ Israeley","poem":1},{"lineBreak":true},{"text":"ho mpitoroñe lahy naho ampela","poem":1},{"lineBreak":true},{"text":"an-tane’ Iehovà ao;","poem":1},{"lineBreak":true},{"text":"naho ho tsepahe’iareo","poem":1},{"lineBreak":true},{"text":"o namahotse iareoo;","poem":1},{"lineBreak":true},{"text":"vaho ho fehè’ iareo ­ o namorekeke iareoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho tendreke amy andro hampanintsiña’ Iehovà anahareo amo fioremeña’ areoo,","poem":1},{"lineBreak":true},{"text":"naho amo haorea’ areoo,","poem":1},{"lineBreak":true},{"text":"naho amo fitromahañe","poem":1},{"lineBreak":true},{"text":"namorekekeañe anahareoo,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"t’ie ho ente’ areo amy mpanjaka’","poem":1},{"lineBreak":true},{"text":"i Baveley añe ty tafatoño toy,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"akore te nijihetse i mpamorekekey!","poem":1},{"lineBreak":true},{"text":"naho nipendreñe i fidabadoañey!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa pinoza’ Iehovà ty fitoño’","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo, ty kobai’ o mpifeheo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I nitolom-pamofoke ondatio","poem":1},{"lineBreak":true},{"text":"ami’ty haboseha’ey,","poem":1},{"lineBreak":true},{"text":"i nameleke ondatio ami’ty haviñera’e","poem":1},{"lineBreak":true},{"text":"an-tsarerake tsy nimete kalañeñey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manintsiñe iaby ty tane toy,","poem":1},{"lineBreak":true},{"text":"vaho mitsiñe;","poem":1},{"lineBreak":true},{"text":"ie ampipoñafan-tsabo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Eka mirebeke ty ama’o o sohihio,","poem":1},{"lineBreak":true},{"text":"naho o mendorave’ i Lebanoneo:","poem":1},{"lineBreak":true},{"text":"Kanao nazevoñ’ ambane irehe,","poem":1},{"lineBreak":true},{"text":"tsy mitroatse ama’ay ty mpamira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mangetseketseke ty ama’o","poem":1},{"lineBreak":true},{"text":"ty tsikeokeoke","poem":1},{"lineBreak":true},{"text":"hifanalaka ama’o amy figodaña’oy;","poem":1},{"lineBreak":true},{"text":"ampibarakaofe’e ty ama’o o angatseo,","poem":1},{"lineBreak":true},{"text":"o nifeleke tan-tane atoio;","poem":1},{"lineBreak":true},{"text":"songa miongake amo fiambesa’eo","poem":1},{"lineBreak":true},{"text":"o mpanjakam-pifeheañeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Songa mifañontane ama’e","poem":1},{"lineBreak":true},{"text":"manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Toe maleme manahake anay irehe !","poem":1},{"lineBreak":true},{"text":"Ihe hambañe ama’ay !","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa nampanjotso azo mb’an-kibory","poem":1},{"lineBreak":true},{"text":"mb’atoy ty firegevoha’o,","poem":1},{"lineBreak":true},{"text":"reketse ty fikoraha’ o karara’oo;","poem":1},{"lineBreak":true},{"text":"Nalamake ambane’o ao o oletseo,","poem":1},{"lineBreak":true},{"text":"vaho mañohoñe azo o kànkañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akore ty nideboña’o boak’","poem":1},{"lineBreak":true},{"text":"andikerañey, ry vasian-kandro,","poem":1},{"lineBreak":true},{"text":"ana’ ty fanjirik’andro !","poem":1},{"lineBreak":true},{"text":"Finira mb’an-tane,","poem":1},{"lineBreak":true},{"text":"ihe nimpamotsake o fifeheañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanoe’o an-tro’o ao ty hoe :","poem":1},{"lineBreak":true},{"text":"Hionjoñe mb’andikerañe mb’eo iraho,","poem":1},{"lineBreak":true},{"text":"ambone’ o vasian’ Añahareo","poem":1},{"lineBreak":true},{"text":"ty hañonjonako ty fiambesako,","poem":1},{"lineBreak":true},{"text":"vaho hiambesatse am-bohim-pivory eo, amo ila’e avaratseo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hionjoñe ambonen-dikera’","poem":1},{"lineBreak":true},{"text":"o rahoñeo iraho,","poem":1},{"lineBreak":true},{"text":"hihambañako amy Abo-Tia.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Te mone hazotso","poem":1},{"lineBreak":true},{"text":"mb’an-tsikeokeoke ao irehe,","poem":1},{"lineBreak":true},{"text":"pak’am-para’ i halale’ i koboñeiy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hisamb’ azo o hahaisake azoo,","poem":1},{"lineBreak":true},{"text":"hañarahara ty hoe: Itiañe hao indaty","poem":1},{"lineBreak":true},{"text":"nampiezeñezeñe ty tane toiy,","poem":1},{"lineBreak":true},{"text":"i ­nampihondrahondra o fifeheañeoy;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty nanao ty tane toy ho ratraratra,","poem":1},{"lineBreak":true},{"text":"naho nandrotsake o rova’eo;","poem":1},{"lineBreak":true},{"text":"vaho tsy nanokake ty vala-bei’e","poem":1},{"lineBreak":true},{"text":"himpolia’ o narohi’eo?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Songa mirotse ami’ty enge’e","poem":1},{"lineBreak":true},{"text":"o mpanjaka’ o fifeheañeoo, ie iabikey,","poem":1},{"lineBreak":true},{"text":"sindre an-kibori’e ao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"F’ihe ka, ro navokovoko boak’","poem":1},{"lineBreak":true},{"text":"an-kibori’o ao hoe tsampañe tiva,","poem":1},{"lineBreak":true},{"text":"an-tsaro’ ty vinono, tinomboke fibara,","poem":1},{"lineBreak":true},{"text":"mihotrake mb’amo vato an-koboñeo","poem":1},{"lineBreak":true},{"text":"hoe lolo linialiam-pandia.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy hitrao-pileveñe am’ iereo,","poem":1},{"lineBreak":true},{"text":"amy te narotsa’o ty tane’o","poem":1},{"lineBreak":true},{"text":"vaho zinama’o ondati’oo;","poem":1},{"lineBreak":true},{"text":"toe tsy ho tiahieñe ka","poem":1},{"lineBreak":true},{"text":"ty tarira’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mihentseña hanjamañe o ana’eo","poem":1},{"lineBreak":true},{"text":"ty amo hakeon-droae’ iareoo;","poem":1},{"lineBreak":true},{"text":"tsy mone hitroatse","poem":1},{"lineBreak":true},{"text":"hitavañe ty voatse toy iereo,","poem":1},{"lineBreak":true},{"text":"hanitsike o rova an-tane atoio.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Izaho, hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ty hitroatse am’ iereo,","poem":1},{"lineBreak":true},{"text":"vaho haitoako amy Bavele","poem":1},{"lineBreak":true},{"text":"ty añarañe naho ty sehanga’e,","poem":1},{"lineBreak":true},{"text":"ty tariratse naho ty tamingañe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hatoloko ho fanaña’ ty trandrake,","poem":1},{"lineBreak":true},{"text":"ho babangoa-mangenakenake;","poem":1},{"lineBreak":true},{"text":"le ho piopioheko am-pamafa-","poem":1},{"lineBreak":true},{"text":"karotsahañe, hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nifanta’ Iehovà’ i Màroy ty hoe:","poem":1},{"lineBreak":true},{"text":"Toe ho tondroke ze fitsakoreako;","poem":1},{"lineBreak":true},{"text":"hijadon-ko do’e ze aereñereko.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ho folaheko an-taneko ao ty Asore,","poem":1},{"lineBreak":true},{"text":"ho lialiàko am-bohiko eo;","poem":1},{"lineBreak":true},{"text":"habalake ty joka’e am’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho havotsotse an-tsoro’ iareo","poem":1},{"lineBreak":true},{"text":"ty kilanka’e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Izay ty safiry nalahatse","poem":1},{"lineBreak":true},{"text":"ho a’ ty tane bey toy","poem":1},{"lineBreak":true},{"text":"vaho itoy ty taña natora-kitsike","poem":1},{"lineBreak":true},{"text":"amo fifeheañe iabio.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Naereñere’ Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ia ty hahakalañe aze?","poem":1},{"lineBreak":true},{"text":"Napololotse ty fità’e,","poem":1},{"lineBreak":true},{"text":"ia ty hampipoly aze?","poem":1}]},{"type":"verse","number":28,"content":["Tamy taoñe nahavilasy i Akhaze",{"noteId":80},"mpanjaka, ty niheova’ ty entañe toy."]},{"type":"verse","number":29,"content":[{"text":"Ko mandia-taroba, ry Pilistý iabio,","poem":1},{"lineBreak":true},{"text":"amy te pinozake ty kobaiñe nandafa azo,","poem":1},{"lineBreak":true},{"text":"fa boak’ am-baha’ ty mereñe","poem":1},{"lineBreak":true},{"text":"ty hitiria’ ty lapetake,","poem":1},{"lineBreak":true},{"text":"ie ka ty hamoa fandrefeala mibela, mitiliñe.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hikama o loho rarakeo, naho","poem":1},{"lineBreak":true},{"text":"hàndre am-pipalirañe ao o poi’eo;","poem":1},{"lineBreak":true},{"text":"ho vonoeko ami’ty kerè o vaha’oo,","poem":1},{"lineBreak":true},{"text":"izay ty hanjamanañe ty honka’o.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mañaoloa ry lalambey,","poem":1},{"lineBreak":true},{"text":"mikoiha ry rova;","poem":1},{"lineBreak":true},{"text":"mitranaha ry Pilistý, nahareo iaby;","poem":1},{"lineBreak":true},{"text":"hehe te boak’ avaratse añe ty hatoeñe,","poem":1},{"lineBreak":true},{"text":"tsy ama’e ty mitakàtrotse","poem":1},{"lineBreak":true},{"text":"am-pirimboña’e.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Akore arè ty hamaleañe","poem":1},{"lineBreak":true},{"text":"o ira’ i fifeheañeio?","poem":1},{"lineBreak":true},{"text":"T’ie naore’ Iehovà t’i Tsione","poem":1},{"lineBreak":true},{"text":"le hitsoloke ama’e ondati’e misotrio.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":80,"caller":"+","text":"Akhaze: mpitavañe","reference":{"chapter":14,"verse":28}}]},"thisChapterLink":"/api/tdx_sle/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}