{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Ahitrifo mb’amy mpanjaka’ i taney","poem":1},{"lineBreak":true},{"text":"o vik’añondry boak’ an-tseram-","poem":1},{"lineBreak":true},{"text":"bato miatreke i fatrambeiio,","poem":1},{"lineBreak":true},{"text":"mb’am-bohin’ anak’ampela’","poem":1},{"lineBreak":true},{"text":"i Tsione mb’eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie amy zao manahake ty voroñe naronje boak’ an-traño’ iareo ao,","poem":1},{"lineBreak":true},{"text":"o anak’ ampela’ i Moabe","poem":1},{"lineBreak":true},{"text":"amy fitsaha’ i Arnoneio.","poem":1},{"noteId":95}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atorò, tampaho ty heve’o;","poem":1},{"lineBreak":true},{"text":"manalinjò hoe te haleñe","poem":1},{"lineBreak":true},{"text":"an-tsingilingilin’andro;","poem":1},{"lineBreak":true},{"text":"aetaho o naitoañeo;","poem":1},{"lineBreak":true},{"text":"ko aboake ty mipalitse.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adono hañialo ama’o ao ry Moabe o naitoañe amako,","poem":1},{"lineBreak":true},{"text":"ehe ampitsoloho","poem":1},{"lineBreak":true},{"text":"ami’ty tarehe’ i mpamaokey.","poem":1},{"lineBreak":true},{"text":"Fa añe ty mpisenge hery,","poem":1},{"lineBreak":true},{"text":"nijihetse i fikopahañey,","poem":1},{"lineBreak":true},{"text":"le finaoke amy taney o mpamorekekeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haoreñe am-pikokoa-migahiñe","poem":1},{"lineBreak":true},{"text":"ty fiambesatse,","poem":1},{"lineBreak":true},{"text":"le hiambesatse ama’e ty mpizaka","poem":1},{"lineBreak":true},{"text":"an-kavantaña’e, an-kivoho’ i Davide ao,","poem":1},{"lineBreak":true},{"text":"ie ty hipay ty hatò","poem":1},{"lineBreak":true},{"text":"vaho halisa amy fahiti’ey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa jinanji’ay ty firengevoha’","poem":1},{"lineBreak":true},{"text":"i Moabe;","poem":1},{"lineBreak":true},{"text":"ie loho miebotsebotse,","poem":1},{"lineBreak":true},{"text":"ty amy fitoabora’e naho ty hakavokavo’e,","poem":1},{"lineBreak":true},{"text":"ty harobodroboha’e, vaho","poem":1},{"lineBreak":true},{"text":"ty fisengea’e kafoake.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa le hangololoike ho a i Moabe","poem":1},{"lineBreak":true},{"text":"t’i Moabe, songa hangoihoy;","poem":1},{"lineBreak":true},{"text":"ho a ty mofo-mami’ i Kir-karesete","poem":1},{"noteId":96},{"lineBreak":true},{"text":"ty hiroveta’ areo, tsipike ty anahelo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miforejeje o tonda’ i Kesboneo,","poem":1},{"lineBreak":true},{"text":"naho ty vahe’ i Sibmà","poem":1},{"noteId":97},{"text":",","poem":1},{"lineBreak":true},{"text":"fa pinekapeka’ o roandria’","poem":1},{"lineBreak":true},{"text":"o kilakila’ ndatioo","poem":1},{"lineBreak":true},{"text":"o hatae fanjàka’eo;","poem":1},{"lineBreak":true},{"text":"o nahatakatse Iazare","poem":1},{"noteId":98},{"text":"añeo,","poem":1},{"lineBreak":true},{"text":"nikariokarioke an-dratraratra ao;","poem":1},{"lineBreak":true},{"text":"le nandrevake o tsampa’eo,","poem":1},{"lineBreak":true},{"text":"nitsake i riakey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa le hindre hirovetse ami’ty firoveta’","poem":1},{"lineBreak":true},{"text":"Iazare iraho ty amy vahe’ i Sibmày;","poem":1},{"lineBreak":true},{"text":"ho tondrahako ranomaso irehe","poem":1},{"lineBreak":true},{"text":"ry Kesbone, naho i Eleale;","poem":1},{"lineBreak":true},{"text":"ty amy havokaran’asara’oy naho ty fitataha’o, fa inay ty koike aly.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa tinavañe amy tonda-kobokaray","poem":1},{"lineBreak":true},{"text":"ty hafaleañe naho ty rebeke;","poem":1},{"lineBreak":true},{"text":"tsy aman-tsabo","poem":1},{"lineBreak":true},{"text":"o tondam-baheo, tsy amam-pazake;","poem":1},{"lineBreak":true},{"text":"tsy eo ty handialia divay","poem":1},{"lineBreak":true},{"text":"amo fipiritañeo;","poem":1},{"lineBreak":true},{"text":"fa nampitsiñeko ty koikoi’ iareo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le hanoiñe hoe marovany","poem":1},{"lineBreak":true},{"text":"amy Moabe ty troko,","poem":1},{"lineBreak":true},{"text":"naho ho a i Kir-karesete o añ’ovakoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le ho tondroke te, ho oniñe midazidazitse ankaboa’ey t’i Moabe,","poem":1},{"lineBreak":true},{"text":"ie mizilike amo navahe’eo hihalaly,","poem":1},{"lineBreak":true},{"text":"f’ie tsy haharongatse.","poem":1}]},{"type":"verse","number":13,"content":["Izay ty nibekoe’ Iehovà haehae i Moabe."]},{"type":"verse","number":14,"content":["Hoe ka t’Iehovà henaneo:",{"text":"Tsy hahamodo telo taoñe,","poem":1},{"lineBreak":true},{"text":"ami’ty fañiahan’androm-pikarama, le ho sirikaeñe ty enge’ i Moabe","poem":1},{"lineBreak":true},{"text":"naho i valobohò’ey; le ho potrapotra’e avao ty ho sisa vaho tsy hanjofake.","poem":1}]}],"footnotes":[{"noteId":95,"caller":"+","text":"Arnone: firebehañe; fireandrea’ i àndroy","reference":{"chapter":16,"verse":2}},{"noteId":96,"caller":"+","text":"Kir: kijoly; haresete; rova’ i àndroy","reference":{"chapter":16,"verse":7}},{"noteId":97,"caller":"+","text":"Sibmà: fiovañe; fandrohizañe","reference":{"chapter":16,"verse":8}},{"noteId":98,"caller":"+","text":"Iezare: olotse; mpañolotse, mpañimba","reference":{"chapter":16,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}