{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Ty nibekoeñe i Damesèke:","poem":1},{"lineBreak":true},{"text":"Hehe te nasintake amy Damesèke","poem":1},{"lineBreak":true},{"text":"ty maharova aze,","poem":1},{"lineBreak":true},{"text":"fa ho votrem-porompotse.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naforintseñe o rova’ i Aroereo","poem":1},{"noteId":99},{"text":",","poem":1},{"lineBreak":true},{"text":"ho fandrean’ añondry,","poem":1},{"lineBreak":true},{"text":"tsy eo ty hañembañe iareo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho modo ka ty ­kijoli-abo’ i Efraime,","poem":1},{"lineBreak":true},{"text":"naho ty fifehea’ i Damesèke;","poem":1},{"lineBreak":true},{"text":"fa hanahake ty enge’ o nte-Israeleo","poem":1},{"lineBreak":true},{"text":"ty sisa’ i Arame, hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, le hanoeñe matify","poem":1},{"lineBreak":true},{"text":"ty volonahe’ Iakobe, vaho hinike","poem":1},{"lineBreak":true},{"text":"ho boroka ty havondra’ i sandri’ey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le hanahake ty fanontonam-panatake","poem":1},{"lineBreak":true},{"text":"o tsako miadaoroo,","poem":1},{"lineBreak":true},{"text":"ie manifo o tsakoo an-tsira’e eo;","poem":1},{"lineBreak":true},{"text":"eka le hanahake ty fañoroñañe ty voto’e ambavatane’ i Rafà","poem":1},{"noteId":100},{"text":"ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fe mbe hapoke eo ty nengañe,","poem":1},{"lineBreak":true},{"text":"manahake ty fañintsañañe zaite","poem":1},{"noteId":101},{"text":",","poem":1},{"lineBreak":true},{"text":"t’ie telo ndra roe ty an-dengo’","poem":1},{"lineBreak":true},{"text":"i singa’e amboney,","poem":1},{"lineBreak":true},{"text":"lime ndra efatse ty an-katae miregorego,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, Andrianañahare’ Israele.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amy andro zay,","poem":1},{"lineBreak":true},{"text":"hañaoñe i Namboatse azey t’indaty, naho hampiandra fihaino","poem":1},{"lineBreak":true},{"text":"mb’amy Masi’ Israeley","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy ho haoñe’e o kitrelio,","poem":1},{"lineBreak":true},{"text":"o satam-pità’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho tolihe’e","poem":1},{"lineBreak":true},{"text":"o nitsenen-drambo-pità’eo,","poem":1},{"lineBreak":true},{"text":"ndra o Asereo","poem":1},{"noteId":102},{"text":",","poem":1},{"lineBreak":true},{"text":"ndra o kitrelin’ embokeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O rova’e maozatseo amy andro zay,","poem":1},{"lineBreak":true},{"text":"le ho koake hoe tsampa’e napoke añ’ala,","poem":1},{"lineBreak":true},{"text":"hoe singa’e nadoke ty amo ana’ Israeleo,","poem":1},{"lineBreak":true},{"text":"vaho hangoakoake ty ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amy te nihaliño’o","poem":1},{"lineBreak":true},{"text":"t’i Andrianañaharem-pandrombahañ’ azo,","poem":1},{"lineBreak":true},{"text":"le nandikofa’o ty Lamilamin-kaozara’o;","poem":1},{"lineBreak":true},{"text":"aa le hambole hatae soasoa irehe,","poem":1},{"lineBreak":true},{"text":"vaho haketsa’o ho an-drahare","poem":1},{"lineBreak":true},{"text":"ambahiny ty tora-katae.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nifahera’o amy andro nambolè’o azey, maraindray re ro ampamoñea’o i tiri’oy;","poem":1},{"lineBreak":true},{"text":"fe votrim-­porompotse ty ho voka’e,","poem":1},{"lineBreak":true},{"text":"amy andron-kasilofañe naho fanaintaiñañey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hedey! ty fikoraha’ o mitozantozañeo, mitroñe manahake ty fitroña’ i riakey;","poem":1},{"lineBreak":true},{"text":"naho ty fidabadoà’","poem":1},{"lineBreak":true},{"text":"o kilakila ‘ndatio hambañe","poem":1},{"lineBreak":true},{"text":"ami’ty fisorotombahan-drano bey!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le hitabatroake manahake","poem":1},{"lineBreak":true},{"text":"ty fitotsaha’ ty rano bey o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"fe hendaha’e, le hioratse añe iereo,","poem":1},{"lineBreak":true},{"text":"vaho ho horidañeñe hoe kafo’e","poem":1},{"lineBreak":true},{"text":"am-bohitsey añatrefa’ i tiokey,","poem":1},{"lineBreak":true},{"text":"manahake ty fibòn-deboke","poem":1},{"lineBreak":true},{"text":"miviombio aolo’ ty tiobey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie hariva, hehe te hekoheko;","poem":1},{"lineBreak":true},{"text":"ie miporea’ ty maraindray","poem":1},{"lineBreak":true},{"text":"le tsy eo;","poem":1},{"lineBreak":true},{"text":"izay ty anjara’ o mañaoke anaio,","poem":1},{"lineBreak":true},{"text":"vaho ty tambe’ o mampikametse ama’aio.","poem":1}]}],"footnotes":[{"noteId":99,"caller":"+","text":"Aroere: montoñe; tanan-taolo","reference":{"chapter":17,"verse":2}},{"noteId":100,"caller":"+","text":"Rafa: aoly, fanahañe","reference":{"chapter":17,"verse":5}},{"noteId":101,"caller":"+","text":"Zaite : hoe satrañe hanem-boa’e (olive)","reference":{"chapter":17,"verse":6}},{"noteId":102,"caller":"+","text":"Asere: hafaleañe","reference":{"chapter":17,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}