{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe, ty tane aman’elatse","poem":1},{"lineBreak":true},{"text":"miñiñiñìñe, alafe’ o toraha’ i Koseo","poem":1},{"noteId":103},{"text":";","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie mampañitrike sorotà mb’an-driake,","poem":1},{"lineBreak":true},{"text":"an-dakam-binda lava","poem":1},{"lineBreak":true},{"text":"ambone’ o ranoo!","poem":1},{"lineBreak":true},{"text":"Dàñe ry mpihitrike, masikà,","poem":1},{"lineBreak":true},{"text":"mb’ an-tane’ ondaty abo naho","poem":1},{"lineBreak":true},{"text":"aman-kolitse mendoo; ondaty","poem":1},{"lineBreak":true},{"text":"mampangebahebake ty ao naho ty añe;","poem":1},{"lineBreak":true},{"text":"ondaty gañe vaho mandialia,","poem":1},{"lineBreak":true},{"text":"i tane’ iareo zarazaraen-torahañey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ry hene mpimoneñe ami’ty voatse toio,","poem":1},{"lineBreak":true},{"text":"ry mpitoboke an-tane ao,","poem":1},{"lineBreak":true},{"text":"ie mitroatse an-kaboa’ o vohitseo","poem":1},{"lineBreak":true},{"text":"ty viloñe, le mahaisaha;","poem":1},{"lineBreak":true},{"text":"naho mipopò i antsivay, mijanjiña.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa hoe ty nafè’ Iehovà amako:","poem":1},{"lineBreak":true},{"text":"hitàn-kahendrean-dRaho,","poem":1},{"lineBreak":true},{"text":"vaho hijilojilo boak’am-","poem":1},{"lineBreak":true},{"text":"pimoneñako atoy,","poem":1},{"lineBreak":true},{"text":"hoe hatrevohan-tsingilingilieñe","poem":1},{"lineBreak":true},{"text":"an-tariñandroke,","poem":1},{"lineBreak":true},{"text":"manahake raho-mika","poem":1},{"lineBreak":true},{"text":"an-katrovoham-pitatahañe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"aolo’ i fitatahañey, ie fa nihintsam-boñe,","poem":1},{"lineBreak":true},{"text":"ie mihamatoe i valoboke makiray,","poem":1},{"lineBreak":true},{"text":"le ho hitsikitsifem-pibira","poem":1},{"lineBreak":true},{"text":"miporengotse o singa’eo,","poem":1},{"lineBreak":true},{"text":"handrantsañe o tsampa’e mandrevakeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Harongoñe eo iereo ho a o","poem":1},{"lineBreak":true},{"text":"voro-pitsindroke am-bohitseo,","poem":1},{"lineBreak":true},{"text":"naho ho a o bibin-kivokeo;","poem":1},{"lineBreak":true},{"text":"le ho ama’e o voro-pitsindrokeo","poem":1},{"lineBreak":true},{"text":"naho asara, vaho hiasotry ama’e ze hene bibi’ ty tane toy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, hanese ravoravo","poem":1},{"lineBreak":true},{"text":"am’ Iehovà’ i Màroy ondaty abo","poem":1},{"lineBreak":true},{"text":"naho aman-kolitse mendoo,","poem":1},{"lineBreak":true},{"text":"ondaty mampangebahebake","poem":1},{"lineBreak":true},{"text":"ao naho añeo;","poem":1},{"lineBreak":true},{"text":"foko gañe vaho mandialia,","poem":1},{"lineBreak":true},{"text":"an-tane zarazaraen-torahañe;","poem":1},{"lineBreak":true},{"text":"mb’an-toen-tahina’ Iehovà i Màroy:","poem":1},{"lineBreak":true},{"text":"mb’ambohi-Tsione mb’eo.","poem":1}]}],"footnotes":[{"noteId":103,"caller":"+","text":"Kose: nte-Eteopia; mainte","reference":{"chapter":18,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}