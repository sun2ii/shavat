{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ty tsara nioni’ Iesaia ana’ i Amotse","poem":1},{"lineBreak":true},{"text":"ty am’ Iehodà naho Ierosalaime:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ho tondrok’ amo andro honka’eo te haoreñe ankaboa’ o vohitseo","poem":1},{"lineBreak":true},{"text":"ty vohin-anjomba’ Iehovà,","poem":1},{"lineBreak":true},{"text":"honjoneñe ambone’ o haboañeo;","poem":1},{"lineBreak":true},{"text":"vaho hikovovoke mb’ama’e mb’eo","poem":1},{"lineBreak":true},{"text":"ze kilakila ondaty.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maro ty rofòko homb’eo hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Antao, hionjoñe mb’ambohi’ Iehovà,","poem":1},{"lineBreak":true},{"text":"mb’añ’anjomban’Añahare’ Iakobe","poem":1},{"noteId":12},{"text":";","poem":1},{"lineBreak":true},{"text":"hañòha’e antika o lala’eo,","poem":1},{"lineBreak":true},{"text":"hañaveloan-tika o oloñolo’eo;","poem":1},{"lineBreak":true},{"text":"amy te hionjoñe boake Tsione ao","poem":1},{"lineBreak":true},{"text":"ty Hàke,","poem":1},{"lineBreak":true},{"text":"naho boak’ Ierosalaime ao","poem":1},{"lineBreak":true},{"text":"ty tsara’Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie ty hizaka añivo’ o kilakila’ ndatio,","poem":1},{"lineBreak":true},{"text":"naho hifandahatse ami’ty maro;","poem":1},{"lineBreak":true},{"text":"le ho pehe’ iareo ho lelan-dasarý","poem":1},{"lineBreak":true},{"text":"o fibara’ iareoo","poem":1},{"lineBreak":true},{"text":"naho ho fibira miporengotse,","poem":1},{"lineBreak":true},{"text":"o lefo’ iareoo;","poem":1},{"lineBreak":true},{"text":"tsy hifañonjom-pibara","poem":1},{"lineBreak":true},{"text":"ami’ty fifeheañe ty fifeheañe","poem":1},{"lineBreak":true},{"text":"vaho tsy hioke hialy ka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O ry anjomba’ Iakobeo, mb’etoy, hañaveloan-tika ami’ty fireandrea’ Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa naforintse’ ondati’oo i anjomba’ Iakobey","poem":1},{"lineBreak":true},{"text":"fa àtsake ty sata’ o tatiñanañeo iereo,","poem":1},{"lineBreak":true},{"text":"naho o mpisikily manahake","poem":1},{"lineBreak":true},{"text":"o nte-Pilistioo","poem":1},{"noteId":13},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho mifañoho-pitàñe","poem":1},{"lineBreak":true},{"text":"amo anan’ambahinio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pea volafoty naho volamena","poem":1},{"lineBreak":true},{"text":"ty tane’ iareo;","poem":1},{"lineBreak":true},{"text":"tsifotofoto ty vara’e,","poem":1},{"lineBreak":true},{"text":"tsitsike soavala ka ty tane’ iareo,","poem":1},{"lineBreak":true},{"text":"tsy vatse iaheñe o sarete’eo;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lifo-tsamposampo ka ty tane’ iareo;","poem":1},{"lineBreak":true},{"text":"italahoa’iareo o satam-pità’ iareoo,","poem":1},{"lineBreak":true},{"text":"o fitolon-drambom-pità’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nafotsake ty fokonontsoa,","poem":1},{"lineBreak":true},{"text":"narèke ondatio;","poem":1},{"lineBreak":true},{"text":"aa le ko ihevea’o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mimoaha am-bato ao,","poem":1},{"lineBreak":true},{"text":"mietaha an-debok’ ao,","poem":1},{"lineBreak":true},{"text":"am-pirevendreveñañe am’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ami’ty enge’ i volonahe’ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hareke ty fiebotsebo’ ondatio,","poem":1},{"lineBreak":true},{"text":"havokok’ ambane ty fibohabohà’ondatio,","poem":1},{"lineBreak":true},{"text":"Iehovà avao ro honjoneñe","poem":1},{"lineBreak":true},{"text":"amy andro zay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa manañ’andro amo mpirengevokeo","poem":1},{"lineBreak":true},{"text":"naho amo mpitahebokeo","poem":1},{"lineBreak":true},{"text":"t’Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"naho amy ze hene mitoabotse;","poem":1},{"lineBreak":true},{"text":"fa songa harèke;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"naho amo mendorave’","poem":1},{"lineBreak":true},{"text":"i Lebanone","poem":1},{"noteId":14},{"text":"iabio,","poem":1},{"lineBreak":true},{"text":"o miligiligy amboneo,","poem":1},{"lineBreak":true},{"text":"naho amo kile’ i Basane","poem":1},{"noteId":15},{"text":"iabio,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naho amo vohitse abo iabio,","poem":1},{"lineBreak":true},{"text":"naho amy ze hene haboañe mionjoñe,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naho amo tilik’abo iabio,","poem":1},{"lineBreak":true},{"text":"naho amo fahetse matahetseo,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naho amo hene sambo’ i Tarsiseo,","poem":1},{"lineBreak":true},{"text":"vaho amo sare mahafalefaleo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Habotreke ty fitoabora’ ondaty,","poem":1},{"lineBreak":true},{"text":"le haketrake ty fitrotroabora’ondatio;","poem":1},{"lineBreak":true},{"text":"Iehovà avao ty honjoneñe amy andro zay.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Vata’e hasiots’añe o hazomangao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Himoak’ an-davan-damilamy ao ondatio, naho an-dakato an-tane ao,","poem":1},{"lineBreak":true},{"text":"ami’ty fañeveñañe am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ami’ty engem-bolonahe’e,","poem":1},{"lineBreak":true},{"text":"ie hiongake hañozoñozoñe ty tane toy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amy andro zay, le haria’ ondatio","poem":1},{"lineBreak":true},{"text":"amo sorao naho amo kananavio","poem":1},{"lineBreak":true},{"text":"o hazomanga volafoty naho","poem":1},{"lineBreak":true},{"text":"o hazomanga volamena","poem":1},{"lineBreak":true},{"text":"nitsenè’ iareo ho fitalahoañeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hitsifira’e an-tseram-bato ao,","poem":1},{"lineBreak":true},{"text":"naho am-bato tringitringieñe ao,","poem":1},{"lineBreak":true},{"text":"amy fihondrahondra’e am’ Iehovày,","poem":1},{"lineBreak":true},{"text":"naho amy engem-bolonahe’ey,","poem":1},{"lineBreak":true},{"text":"ie miongake hañozoñozoñe ty tane toy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ko iatoa’o ondatio,","poem":1},{"lineBreak":true},{"text":"o mikofòk’ an-doak’oro’eo:","poem":1},{"lineBreak":true},{"text":"fa ho volilien-ko inon-dre?","poem":1}]}],"footnotes":[{"