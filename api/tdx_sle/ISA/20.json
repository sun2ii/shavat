{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Amy taoñe nanamea’ i Tartane",{"noteId":108},"i Asdodey",{"noteId":109},", (ie nampañitrife’ ty mpanjaka’ i Asore), le nialia’e ty Asdode vaho tinava’e;"]},{"type":"verse","number":2,"content":["ie amy taoñe zay, le nitsara am’ Iesaià ana’ i Amotse t’Iehovà nanao ty hoe: Akia, abalaho hiafake an-toha’o eo i lamban-goniy vaho apolitiro am-pandia’o o hana’oo. Nanoe’e zay, nañavelo nihalo tsy aman-kana."]},{"type":"verse","number":3,"content":["Le hoe t’Iehovà:",{"text":"Manahake te nañavelo tsy aman-tsaroñe,","poem":1},{"lineBreak":true},{"text":"tsy aman-kana telo taoñe","poem":1},{"lineBreak":true},{"text":"ty mpitoroko Iesaià,","poem":1},{"lineBreak":true},{"text":"t’ie ho viloñe naho halatsañe","poem":1},{"lineBreak":true},{"text":"amy Mitsraime naho amy Kose,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"le ho kozozote’ ty mpanjaka’","poem":1},{"lineBreak":true},{"text":"i Asore o mpirohi’ i Mitsraimeo","poem":1},{"lineBreak":true},{"text":"naho o hasese boake Koseo,","poem":1},{"lineBreak":true},{"text":"hibongy vaho tsy ho aman-kana,","poem":1},{"lineBreak":true},{"text":"ty kede naho ty bey,","poem":1},{"lineBreak":true},{"text":"tsy ho aman-tsaro ty voli’e","poem":1},{"lineBreak":true},{"text":"ho ami’ty hasalara’ i Mitsraime.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho lonjetse naho meñatse iereo","poem":1},{"lineBreak":true},{"text":"ty amy Kose, fitamà’ iareo, naho","poem":1},{"lineBreak":true},{"text":"i Mitsraime fisengea’ iareo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le hanao ty hoe ty mpimoneñe","poem":1},{"lineBreak":true},{"text":"añ’olo-tane atoy amy andro zay:","poem":1},{"lineBreak":true},{"text":"Heheke o nitamaen-tikañeo,","poem":1},{"lineBreak":true},{"text":"i nipitsihan-tika nipay olotse","poem":1},{"lineBreak":true},{"text":"hivotsoran-tika amy","poem":1},{"lineBreak":true},{"text":"mpanjaka’ i Asoreiy;","poem":1},{"lineBreak":true},{"text":"tika ‘nio! aia ty hivoratsahan-tika?","poem":1}]}],"footnotes":[{"noteId":108,"caller":"+","text":"Tartane: mpifehe bey (zenerale)","reference":{"chapter":20,"verse":1}},{"noteId":109,"caller":"+","text":"Asdode: Mañiliñe; midegañe; mikizo","reference":{"chapter":20,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}