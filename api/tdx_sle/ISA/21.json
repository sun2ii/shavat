{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Ty nibangoeñe i ­fatram-bei’ i riakeiy:","poem":1},{"lineBreak":true},{"text":"Manahake ty famaoha’ o tio-bey tatimoo,","poem":1},{"lineBreak":true},{"text":"ie miboak’ an-dratraratra","poem":1},{"lineBreak":true},{"text":"hirik’ an-tane mampangebahebak’ añe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naboak’ amako ty aroñaroñe","poem":1},{"lineBreak":true},{"text":"mampioremeñe:","poem":1},{"lineBreak":true},{"text":"Ty mpamañahy mamañahy,","poem":1},{"lineBreak":true},{"text":"ty mpamaoke mamaoke.","poem":1},{"lineBreak":true},{"text":"Mionjona ry Elame!","poem":1},{"lineBreak":true},{"text":"Miarikoboña, ry Maday!","poem":1},{"lineBreak":true},{"text":"Fa hene nampitsiñeko","poem":1},{"lineBreak":true},{"text":"o fiselekaiñañeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le mikoritoke avao ty vaniako;","poem":1},{"lineBreak":true},{"text":"mamihiñe ahy ty fitsongoañe,","poem":1},{"lineBreak":true},{"text":"manahake ty fitsongon’ ampela mañèñe; mikoretse iraho le tsy mahatsanoñe,","poem":1},{"lineBreak":true},{"text":"miroreke tsy mahafañente.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mifejofejo ty troko;","poem":1},{"lineBreak":true},{"text":"mampirevendreveñ’ahiko ty tahotse;","poem":1},{"lineBreak":true},{"text":"nivalike ho fineveneverañe","poem":1},{"lineBreak":true},{"text":"i palipalitsieñe nisalalaeko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nihalankañeñe i fandambañañey,","poem":1},{"lineBreak":true},{"text":"nalamake i tihiy, nikama naho ninoñe;","poem":1},{"lineBreak":true},{"text":"Miongaha ry roandriañeo,","poem":1},{"lineBreak":true},{"text":"hosoro o fikalan-defoñeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa zao ty nafè’ i Talè amako:","poem":1},{"lineBreak":true},{"text":"Akia, ajadoño ty mpijilo;","poem":1},{"lineBreak":true},{"text":"adono hitalily ze talake’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nahaisake firimboñañe re","poem":1},{"lineBreak":true},{"text":"reketse mpiningi-tsoavala ki-roe roe, mpijòm-borìke","poem":1},{"lineBreak":true},{"text":"naho mpitoboke an-drameva;","poem":1},{"lineBreak":true},{"text":"mitsendreñe amy zao re, mitsatsike.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nikaikaihe’e hoe liona: O talè,","poem":1},{"lineBreak":true},{"text":"Mitolom-pijagarodoñe am-pitala­kesañ’ abo atoy iraho te handro,","poem":1},{"lineBreak":true},{"text":"le mijohañe am-pijilovako ey te haleñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Heheke ondaty lia-raikeo,","poem":1},{"lineBreak":true},{"text":"mpiningi-tsoavala kiroe-roe.","poem":1},{"lineBreak":true},{"text":"Manoiñe ka re manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Rotsake, Rotsake t’i Bavele;","poem":1},{"lineBreak":true},{"text":"fonga nivolentsa an-tane eo","poem":1},{"lineBreak":true},{"text":"o saren-drahare’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O ry linisakoo, ry anako","poem":1},{"lineBreak":true},{"text":"an-toem-pamofohakoo,","poem":1},{"lineBreak":true},{"text":"Hampahafohineko anahareo o raha","poem":1},{"lineBreak":true},{"text":"tsinanoko am’ Iehovà’ i maroio,","poem":1},{"lineBreak":true},{"text":"i Andrianañahare’ Israeley.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ty nibangoeñe i Domà","poem":1},{"noteId":110},{"text":":","poem":1},{"lineBreak":true},{"text":"Mikoike amako ty boak’e Seire","poem":1},{"noteId":111},{"text":":","poem":1},{"lineBreak":true},{"text":"O mpigaritseo, manao akore i haleñey?","poem":1},{"lineBreak":true},{"text":"O mpijiloo, akore ty haleñe toy?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoe i mpigaritsey:","poem":1},{"lineBreak":true},{"text":"Hiporea’ ty maraindray,","poem":1},{"lineBreak":true},{"text":"fa ho avy ka ty haleñe—","poem":1},{"lineBreak":true},{"text":"ihe hañontane le mañontanea;","poem":1},{"lineBreak":true},{"text":"mibaliha indraike!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ty entañe ho amy Arabe","poem":1},{"noteId":112},{"text":":","poem":1},{"lineBreak":true},{"text":"Amo rongo-matahe’ i Arabeo","poem":1},{"lineBreak":true},{"text":"ty hitobea’ areo","poem":1},{"lineBreak":true},{"text":"ry mpivorontsa’ i Dedaneo","poem":1},{"noteId":113},{"text":".","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ry mpimone’ i Temao","poem":1},{"noteId":114},{"text":",","poem":1},{"lineBreak":true},{"text":"anjotsò rano i taliñiereñey;","poem":1},{"lineBreak":true},{"text":"Salakao ama’ ­mahakama","poem":1},{"lineBreak":true},{"text":"o nivoratsakeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie nilaisa’ iareo o fibarao,","poem":1},{"lineBreak":true},{"text":"i mesolava napotsoañey, naho","poem":1},{"lineBreak":true},{"text":"i fale nibitsokey, vaho","poem":1},{"lineBreak":true},{"text":"ty fanindria’ i aliy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa zao ty nafè’ i Talè amako:","poem":1},{"lineBreak":true},{"text":"Añate ty taoñe raike,","poem":1},{"lineBreak":true},{"text":"ami’ty fañiaham-pikarama,","poem":1},{"lineBreak":true},{"text":"le ho hene modo ty enge’ i Kedare","poem":1},{"noteId":115},{"text":".","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le tsy ho ampeampe ty sengaha’","poem":1},{"lineBreak":true},{"text":"o mpitàm-paleo,","poem":1},{"lineBreak":true},{"text":"o lahilahy manjofake amo ana-Kedareoo;","poem":1},{"lineBreak":true},{"text":"fa izay ty nitsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele.","poem":1}]}],"footnotes":[{"noteId":110,"caller":"+","text":"Doma: tondrahen-jono","reference":{"chapter":21,"verse":11}},{"noteId":111,"caller":"+","text":"Seire: volovoloe; ose; kokolampa; tio-bey","reference":{"chapter":21,"verse":11}},{"noteId":112,"caller":"+","text":"Arabe: hariva; liolio; koake","reference":{"chapter":21,"verse":13}},{"noteId":113,"caller":"+","text":"Dedane: ty araña’e; firañetañe; mpizaka","reference":{"chapter":21,"verse":13}},{"noteId":114,"caller":"+","text":"Tema: hatea; fahafonirañe; heneke","reference":{"chapter":21,"verse":14}},{"noteId":115,"caller":"+","text":"Kedare: hainte’e; fandalañe, hontoke","reference":{"chapter":21,"verse":16}}]},"thisChapterLink":"/api/tdx_sle/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}