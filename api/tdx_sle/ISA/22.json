{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Ty nibangoeñe i Vavatanem-","poem":1},{"lineBreak":true},{"text":"Pahaoniñañey:","poem":1},{"lineBreak":true},{"text":"Ino ty maniloke azo henaneo gea,","poem":1},{"lineBreak":true},{"text":"t’ie miañambone mb’an-tafo","poem":1},{"lineBreak":true},{"text":"mb’eo iaby!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Atsa-koràke irehe,","poem":1},{"lineBreak":true},{"text":"Ty rova mivalitsikotake,","poem":1},{"lineBreak":true},{"text":"ty positse mirebeke tia!","poem":1},{"lineBreak":true},{"text":"Toe tsy zinamam-pibara","poem":1},{"lineBreak":true},{"text":"o nibaibay ama’ areoo,","poem":1},{"lineBreak":true},{"text":"tsy nitsingoro an-kotakotake!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fonga nitrao-­pivoratsake ty mpifehe’ areo, f’ie tsinepake tsy am-pale,","poem":1},{"lineBreak":true},{"text":"hene miharo-rohy ze ­nitendreke","poem":1},{"lineBreak":true},{"text":"ndra te niherereake añe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa le hoe iraho, Aviho amako o fihaino’oo; apoho hangololoike ty tañy;","poem":1},{"lineBreak":true},{"text":"ko imanea’o hohò, ty amy fandrotsahañe","poem":1},{"lineBreak":true},{"text":"i anak’ampela’ ondatikooy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa ho andron-kankàñe,","poem":1},{"lineBreak":true},{"text":"fandialiañe naho ampoheke,","poem":1},{"lineBreak":true},{"text":"am-bavatanem-Pahoniñañe ao","poem":1},{"lineBreak":true},{"text":"boak’ amy Talè Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"ty fandrotsahan-kijoly,","poem":1},{"lineBreak":true},{"text":"vaho ty fikaikaihañe o vohitseo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nitintiñe i trañon’ana-paley t’i Elame","poem":1},{"lineBreak":true},{"text":"reketse sarete naho ondaty","poem":1},{"lineBreak":true},{"text":"naho mpiningi-tsoavala,","poem":1},{"lineBreak":true},{"text":"vaho nañafake i sarom-pikalan-","poem":1},{"lineBreak":true},{"text":"defoñey t’i Kire","poem":1},{"noteId":116},{"text":".","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho tondroke te ho tsitsike sarete","poem":1},{"lineBreak":true},{"text":"o vavatane’ areo fanjàkao,","poem":1},{"lineBreak":true},{"text":"vaho hilahatse an-dalam-bey eo","poem":1},{"lineBreak":true},{"text":"o mpiningi-tsoavalao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hinalo’e ty saro’ Iehodà.","poem":1},{"lineBreak":true},{"text":"Nitolihe’o amy andro zay ­","poem":1},{"lineBreak":true},{"text":"o fialiañe añ’anjomban’alao;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nisamba’ areo o jeba’e an-drova’ i Davideo t’ie maro; vaho nitoha rano","poem":1},{"lineBreak":true},{"text":"añ’antara ambane ey nahareo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nivolilie’ areo o anjomba’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"vaho nakoroma’ areo ty anjomba ila’e","poem":1},{"lineBreak":true},{"text":"hanosohañe i kijoliy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nandranjia’ areo talaha añivo’ i kijoly roe rey hitañe ty rano’ i antara antetsey—fe tsy niatoa’ areo i namboats’azey,","poem":1},{"lineBreak":true},{"text":"tsy nihaoñe’ areo i nisafiry aze haehaey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amy andro zay nikoike fangololoihañe, naho fandalàñe, t’i Talè,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"naho fampikovohan-doha,","poem":1},{"lineBreak":true},{"text":"vaho fisikinan-gony;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Te mone: rebeke naho hafaleañe,","poem":1},{"lineBreak":true},{"text":"tombok’añombe","poem":1},{"lineBreak":true},{"text":"naho fandentàñ’ añondry,","poem":1},{"lineBreak":true},{"text":"fikamàn-kena naho finoman-divay:","poem":1},{"lineBreak":true},{"text":"Antao hikama naho hinoñe,","poem":1},{"lineBreak":true},{"text":"ke ho mate maray!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le naboa’ Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"an-tsofiko ao ty hoe :","poem":1},{"lineBreak":true},{"text":"Toe tsy ho jebaña’o i hakeo zay","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie mihomake,","poem":1},{"lineBreak":true},{"text":"hoe t’i Talè, Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hoe t’i Talè, Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Akia mb’amy mpamandroñey,","poem":1},{"lineBreak":true},{"text":"mb’amy Sebnà","poem":1},{"noteId":117},{"text":", mpifehe’ i trañoy mb’eo:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ino ty zo’o atoy?","poem":1},{"lineBreak":true},{"text":"Ia o azo atoio,","poem":1},{"lineBreak":true},{"text":"te nihalia’o kibory etoa ho am-bata’o,","poem":1},{"lineBreak":true},{"text":"ie andavaha’o lonake an-kaboañe ey,","poem":1},{"lineBreak":true},{"text":"naho kaokaohe’o ho azo","poem":1},{"lineBreak":true},{"text":"ty fimoneña’o an-damilamy ao?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Inao! havokovoko’ Iehovà","poem":1},{"lineBreak":true},{"text":"am-pivokovokoam-panalolahy añe irehe;","poem":1},{"lineBreak":true},{"text":"eka ho gore’e an-jitse,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"havarimbari’e vaho havoeboe’e","poem":1},{"lineBreak":true},{"text":"hoe labole mb’an-tane miratraratra añe;","poem":1},{"lineBreak":true},{"text":"añe ty hihomaha’o,","poem":1},{"lineBreak":true},{"text":"ho añe ka o sareten’ enge’oo,","poem":1},{"lineBreak":true},{"text":"ty hasalarañ’ anjomban-talè’o tia.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho roaheko irehe tsy ho an-toe’o,","poem":1},{"lineBreak":true},{"text":"le hafotsako ho ambanen-tsaranga’o ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te","poem":1},{"lineBreak":true},{"text":"ho kanjieko t’i Eliakime","poem":1},{"noteId":118},{"lineBreak":true},{"text":"ana’ i Hilkià","poem":1},{"noteId":119},{"text":", mpitoroko.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Le haombeako ty sarimbo’o,","poem":1},{"lineBreak":true},{"text":"hadiako ama’e ty sadia’o,","poem":1},{"lineBreak":true},{"text":"vaho hapoko am-pità’e eo i nifelehe’oy;","poem":1},{"lineBreak":true},{"text":"ie ty ho rae’ o mpimone’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"naho i anjomba’ Iehodày.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hanoeko an-tsoro’eo i lahin-dakilèn’ anjomba’ i Davidey;","poem":1},{"lineBreak":true},{"text":"ie manokake, tsy eo ty handrindry;","poem":1},{"lineBreak":true},{"text":"ie mandrindriñe tsy eo ty hanokake.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Haoreko hoe fàntake an-toe’e mafe eo;","poem":1},{"lineBreak":true},{"text":"ie ty ho fiambesam-bolonahetse","poem":1},{"lineBreak":true},{"text":"añ’anjomban-drae’e ao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Le hasampe’ iareo ama’e iaby","poem":1},{"lineBreak":true},{"text":"ty engen-anjomban-drae’e,","poem":1},{"lineBreak":true},{"text":"o tariratseo naho o tamingañeo,","poem":1},{"lineBreak":true},{"text":"ze fonga anam-pitiheke naho","poem":1},{"lineBreak":true},{"text":"ze hene fitovy naho o sajoao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amy andro añe zay, hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"le hitrànkañe i fantake nazitse","poem":1},{"lineBreak":true},{"text":"an-toe’e mafey,","poem":1},{"lineBreak":true},{"text":"hipoñake le hideboñe,","poem":1},{"lineBreak":true},{"text":"vaho hipitsoke ama’e o kilankañe","poem":1},{"lineBreak":true},{"text":"tama’eo; fa nitsara t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":116,"caller":"+","text":"Kire: rova, kijoly, fivory","reference":{"chapter":22,"verse":6}},{"noteId":117,"caller":"+","text":"Sebna: i mitofay; i am-pandrohizañey","reference":{"chapter":22,"verse":15}},{"noteId":118,"caller":"+","text":"Eliakime: fiheren-kovelo’ i A’hare","reference":{"chapter":22,"verse":20}},{"noteId":119,"caller":"+","text":"Hilkia: Anjarako t’i Andrianañahare","reference":{"chapter":22,"verse":20}}]},"thisChapterLink":"/api/tdx_sle/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}