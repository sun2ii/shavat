{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Ty nibangoeñe i Tsore","poem":1},{"noteId":120},{"text":":","poem":1},{"lineBreak":true},{"text":"mangolalaiha ry lakam-bein-Tarsiseo","poem":1},{"noteId":121},{"text":";","poem":1},{"lineBreak":true},{"text":"narotsake re: pok’anjomba,","poem":1},{"lineBreak":true},{"text":"tsy amam-pitolia;","poem":1},{"lineBreak":true},{"text":"natalili’ o boake Kitio","poem":1},{"noteId":122},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mianjina ry mpimoneñ’ añ’olotse añe;","poem":1},{"lineBreak":true},{"text":"ry natsafe’ o mpanao takina’ i Tsidone","poem":1},{"noteId":123},{"text":", mpitsake i riakeio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ty tabiri’ i Sihore","poem":1},{"noteId":124},{"text":"an-drano mieneneo,","poem":1},{"lineBreak":true},{"text":"ty voka’ i Sakay ty tambe’e;","poem":1},{"lineBreak":true},{"text":"ie ty ni-tsena’ o kilakila’ ndatio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mimeñara ry Tsidone;","poem":1},{"lineBreak":true},{"text":"fa mivolañe i riakey,","poem":1},{"lineBreak":true},{"text":"manao ty hoe ty haozara’ i riakey:","poem":1},{"lineBreak":true},{"text":"Mboe lia’e tsy nitsongo iraho,","poem":1},{"lineBreak":true},{"text":"tsy niterak’ajaja; tsy nañabey ajalahy,","poem":1},{"lineBreak":true},{"text":"tsy nañotroñe somondrara.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie pok’ e Mitsraime añe i taliliy,","poem":1},{"lineBreak":true},{"text":"le hioremeñe iereo ty amy enta’ i Tsore.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitsaha mb’e Tarsise mb’eo;","poem":1},{"lineBreak":true},{"text":"mangoihoia ry mpimoneñ’añ’olotseo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Itoy hao i rova nirebeha’ areoy,","poem":1},{"lineBreak":true},{"text":"i nioreñe haehaey? i naneseañe o fandia’eo hitaveañe an-tsietoitaney?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ia ty nibeko i Tsore izao?","poem":1},{"lineBreak":true},{"text":"i mpanolon-tsabakam-panjakay?","poem":1},{"lineBreak":true},{"text":"Ie sindre ana-donake o mpandetakeo,","poem":1},{"lineBreak":true},{"text":"songa niroandria’ ty tane toy","poem":1},{"lineBreak":true},{"text":"o kinanga’eo?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ereñere’ Iehovà’ i Màroy izay,","poem":1},{"lineBreak":true},{"text":"hanivàñe ty firengevoha’","poem":1},{"lineBreak":true},{"text":"ze hene engeñe,","poem":1},{"lineBreak":true},{"text":"hamotsaha’e ze fonga onjoneñe","poem":1},{"lineBreak":true},{"text":"an-tane atoy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Manginahinà an-tane’o eo","poem":1},{"lineBreak":true},{"text":"an-tsata’ i Sakay,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ i Tarsise!","poem":1},{"lineBreak":true},{"text":"fa tsy eo ty mikalañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Natora-kitsi’e ambone’ i riakey","poem":1},{"lineBreak":true},{"text":"ty fità’e,","poem":1},{"lineBreak":true},{"text":"nakopikopi’e o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"fa linili’ Iehovà ty amy Kanàne","poem":1},{"lineBreak":true},{"text":"te ho mongoreñe o fipalira’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le hoe re: Tsy hirenge ka,","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ i Tsidone demokeo,","poem":1},{"lineBreak":true},{"text":"miongaha, mitsahà mb’e Kity mb’eo;","poem":1},{"lineBreak":true},{"text":"fe tsy hahazoa’o fitofañe ty añe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hehe ty tane’ o nte-Kasdio—","poem":1},{"lineBreak":true},{"text":"ondaty tsy teo","poem":1},{"lineBreak":true},{"text":"amy nandahara’ i Asore aze","poem":1},{"lineBreak":true},{"text":"ho amo ampatrambeioy;","poem":1},{"lineBreak":true},{"text":"natroa’ iareo o rafi-panamea’ iareoo, nakorenda’ iareo o anjomba’eo; nampangoakoahe’ iereo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mangolalaiha ry lakam-bei’ i Tarsiseo,","poem":1},{"lineBreak":true},{"text":"fa rotsake i fiampira’oy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te","poem":1},{"lineBreak":true},{"text":"haliño fitom-­polo taoñe ty Tsore,","poem":1},{"lineBreak":true},{"text":"ami’ty androm-panjaka;","poem":1},{"lineBreak":true},{"text":"ie peake i fitom-polo taoñe zay","poem":1},{"lineBreak":true},{"text":"le hifetsake amy Tsore i sabon-karapiloy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tintino i marovaniy,","poem":1},{"lineBreak":true},{"text":"mañariaria an-drova ao,","poem":1},{"lineBreak":true},{"text":"ry karapilo tsy tiahy; titiho feo mamy,","poem":1},{"lineBreak":true},{"text":"isabò sabo maro, hahatiahiañe azo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa ie peake i taoñe fitompolo rey","poem":1},{"lineBreak":true},{"text":"le ho tendreke te ho tilihe’ Iehovà","poem":1},{"lineBreak":true},{"text":"t’i Tsore,","poem":1},{"lineBreak":true},{"text":"le himpolia’e i nanambezañe azey,","poem":1},{"lineBreak":true},{"text":"hanitsike o kila fifeheañe ambone’ ty tane toy amy hakarapiloa’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Havalike ho miavake am’ Iehovà","poem":1},{"lineBreak":true},{"text":"o kilanka’eo naho o tambe’eo;","poem":1},{"lineBreak":true},{"text":"tsy hahaja, tsy hakafitse;","poem":1},{"lineBreak":true},{"text":"fa ho a o mpimoneñe","poem":1},{"lineBreak":true},{"text":"añatrefa’ Iehovào","poem":1},{"lineBreak":true},{"text":"o tombom-baro’eo,","poem":1},{"lineBreak":true},{"text":"hahaeneñañe mahakama","poem":1},{"lineBreak":true},{"text":"vaho ho an-tsaroñe mañeva.","poem":1}]}],"footnotes":[{"noteId":120,"caller":"+","text":"Tsore: haozarañe; vato; masioñe","reference":{"chapter":23,"verse":1}},{"noteId":121,"caller":"+","text":"Tarsise; fitsakoreañe, fihotsohotsoañe","reference":{"chapter":23,"verse":1}},{"noteId":122,"caller":"+","text":"Kity: o mamonotrobokeo; volamena","reference":{"chapter":23,"verse":1}},{"noteId":123,"caller":"+","text":"Tsidone: mañoro, maminta; tsinindroke","reference":{"chapter":23,"verse":2}},{"noteId":124,"caller":"+","text":"Sihore: mainte; am-poheke; I saka Nailey","reference":{"chapter":23,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}