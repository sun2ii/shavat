{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Heheke ampangoakoahe’ ­Iehovà i taney, ampiantoe’e, aotakota’e,","poem":1},{"lineBreak":true},{"text":"vaho aparatsia’e o mpimone’eo:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ty mpisoroñe naho ty fokonontsoa,","poem":1},{"lineBreak":true},{"text":"ty ondevo naho ty tale;","poem":1},{"lineBreak":true},{"text":"ty anak’ampatañe naho ty rakemba;","poem":1},{"lineBreak":true},{"text":"ty mpivily naho ty mpandetake;","poem":1},{"lineBreak":true},{"text":"ty mpampindrañe naho ty mpindrañe,","poem":1},{"lineBreak":true},{"text":"ty mampisongo naho ty mpisongo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hene ho korendaheñe i taney,","poem":1},{"lineBreak":true},{"text":"hakopake malio, fa nafè’ Iehovà i tsaray.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mioje i taney naho ­miforejeje, miheatse naho midrodremotse ty voatse toy,","poem":1},{"lineBreak":true},{"text":"fonga mitike o nonjoneñe an-tane atoio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tiniva’ o mpimone’eo i taney,","poem":1},{"lineBreak":true},{"text":"nandilatse Hàke iereo,","poem":1},{"lineBreak":true},{"text":"niotake amo fañèo,","poem":1},{"lineBreak":true},{"text":"vaho nivalike amy fañina tsy modoy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le nabotsem-patse i taney,","poem":1},{"lineBreak":true},{"text":"naho sesehen-kakeo","poem":1},{"lineBreak":true},{"text":"o mpitoboke ama’eo,","poem":1},{"lineBreak":true},{"text":"toly ndra minike o mpimone’ i taneio,","poem":1},{"lineBreak":true},{"text":"vaho tsy ampe ty sengaha’e;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy vaño ty divay vao,","poem":1},{"lineBreak":true},{"text":"miheatse o vaheo;","poem":1},{"lineBreak":true},{"text":"hene miselekaiñe o mpifalefaleo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mijihetse ty firebeha’ o kantsàñeo,","poem":1},{"lineBreak":true},{"text":"migadoñe ty fikoraha’ o mpirebekeo,","poem":1},{"lineBreak":true},{"text":"milesa ty hafalea’ o marovanio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy minon-divay an-tsabo iereo;","poem":1},{"lineBreak":true},{"text":"mafaitse ty toake amo mikam’azeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nakoromake i rova nitsamborohotakey;","poem":1},{"lineBreak":true},{"text":"songa mirindriñe ze anjomba,","poem":1},{"lineBreak":true},{"text":"tsy hiziliha’ondaty.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Firovetañe ty an-dalañe ey,","poem":1},{"lineBreak":true},{"text":"ty amy divaiy;","poem":1},{"lineBreak":true},{"text":"nagoboñe ze hene hafaleañe,","poem":1},{"lineBreak":true},{"text":"fa nafahañe ty firavoravoa’ i taney.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nengañe hoake i rovay,","poem":1},{"lineBreak":true},{"text":"kinaboke ho fianto o lalambei’eo","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa izay ty ho ie añivo’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"anteñateña’ ondatio, manahake ty fañozoñozoñan-tsakoa,","poem":1},{"lineBreak":true},{"text":"naho ty fitimponañe ty sisa ami’ty fanontonañe valoboke.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mampipoña-peo iereo, misabo an-drebeke;","poem":1},{"lineBreak":true},{"text":"mirañoraño o boak’ an-driakeo","poem":1},{"lineBreak":true},{"text":"mañonjoñe ty volonahe’ Iehovà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le mandrengea Iehovà","poem":1},{"lineBreak":true},{"text":"ry an-kazavañe añe,","poem":1},{"lineBreak":true},{"text":"ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"ry añ’olon-driakeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Boak’ antsietoitane añe","poem":1},{"lineBreak":true},{"text":"ty nahajanjiña’ay sabo:","poem":1},{"lineBreak":true},{"text":"Enge ho a i vantañey!","poem":1},{"lineBreak":true},{"text":"Fe nataoko ty hoe: Minike iraho,","poem":1},{"lineBreak":true},{"text":"mitike avao; feh’ohatse amako!","poem":1},{"lineBreak":true},{"text":"Mikinia o mpikitro-drahao;","poem":1},{"lineBreak":true},{"text":"eka vata’e mikitroke ty mpikilily.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ama’o ry mpimone’ ty tane toio","poem":1},{"lineBreak":true},{"text":"ty harevendreveñañe,","poem":1},{"lineBreak":true},{"text":"i koboñey, vaho i fandrikey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa le ho tondroke te,","poem":1},{"lineBreak":true},{"text":"hikapotrake an-koboñe ao","poem":1},{"lineBreak":true},{"text":"ze ampivoratsahe’ ty talili’ i hekohekoy;","poem":1},{"lineBreak":true},{"text":"naho ho tsepahe’ ty fandrike ze manganike boak’ an-koboñe ao;","poem":1},{"lineBreak":true},{"text":"fa misòkake o lalan-kede añ’abo eñeo","poem":1},{"lineBreak":true},{"text":"vaho miezeñezeñe o faha’ ty tane toio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Señake ty tane toy, mangorobagorobañe;","poem":1},{"lineBreak":true},{"text":"nampigavengaveñeñe ty tane toy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mivembeñe hoe ondaty jike","poem":1},{"lineBreak":true},{"text":"ty tane toy;","poem":1},{"lineBreak":true},{"text":"mitroetroe hoe kibohotse;","poem":1},{"lineBreak":true},{"text":"mavesatse ama’e o fiolà’eo,","poem":1},{"lineBreak":true},{"text":"ie hikorovoke tsy hitroatse ka.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te","poem":1},{"lineBreak":true},{"text":"ho lilove’ Iehovà i valobohòn-dikerañey,","poem":1},{"lineBreak":true},{"text":"an-dindiñ’ añe,","poem":1},{"lineBreak":true},{"text":"naho o mpanjaka’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"an-tane atoy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hatontoñe, manahake ty añoroñañe","poem":1},{"lineBreak":true},{"text":"mpirohy am-balabey ao,","poem":1},{"lineBreak":true},{"text":"naho hagabeñe am-porozò ao;","poem":1},{"lineBreak":true},{"text":"ie naha-modo andro maro ao","poem":1},{"lineBreak":true},{"text":"vaho ho liloveñe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho meñatse i volañey,","poem":1},{"lineBreak":true},{"text":"ho salatse i àndroy;","poem":1},{"lineBreak":true},{"text":"fa hifehe am-bohi-Tsione ey","poem":1},{"lineBreak":true},{"text":"t’Iehovà, toe e Ierosalaime ao","poem":1},{"noteId":125},{"text":",","poem":1},{"lineBreak":true},{"text":"le haboak’ amo mpifehe’ondati’eo ty enge’e.","poem":1}]}],"footnotes":[{"noteId":125,"caller":"+","text":"Ies 12:6, 16:5, 46:13, 52:8, 59:20, Sab 102:16, Iek 43:7-9, Ioe 3:17, 4:17, Mik 4:7-8, Tsf 3:14-17, Zek 1:16-17, 2:10, 8:3-8, 14:1-11, Top 1:6-7, Ben 21:1-27","reference":{"chapter":24,"verse":23}}]},"thisChapterLink":"/api/tdx_sle/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}