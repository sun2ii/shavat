{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, Andrianañahareko irehe,","poem":1},{"lineBreak":true},{"text":"hañonjoñ’Azo iraho,","poem":1},{"lineBreak":true},{"text":"ho bangoeko ty tahina’o,","poem":1},{"lineBreak":true},{"text":"ty amo fitoloña’o fanjàkao;","poem":1},{"lineBreak":true},{"text":"ihe nisafiry haehae","poem":1},{"lineBreak":true},{"text":"am-pigahiñañe naho an-katò.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa nanoe’o votre ty rova,","poem":1},{"lineBreak":true},{"text":"naho fianto i rova fatra-piaroy;","poem":1},{"lineBreak":true},{"text":"tsy rova ka i anjomban’ ambahiniy,","poem":1},{"lineBreak":true},{"text":"vaho tsy hamboareñe ka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le hañonjoñe Azo","poem":1},{"lineBreak":true},{"text":"ondaty manjofakeo,","poem":1},{"lineBreak":true},{"text":"hañeveñe ama’o","poem":1},{"lineBreak":true},{"text":"o rovam-pifeheañe mitromoroñeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa nifipalira’ o rarakeo irehe,","poem":1},{"lineBreak":true},{"text":"fitsoloha’ o misotrio,","poem":1},{"lineBreak":true},{"text":"fiampirañe an-tio bey,","poem":1},{"lineBreak":true},{"text":"fialofañe amy hatrovohañey;","poem":1},{"lineBreak":true},{"text":"naho hoe tio-bey an-kijoly","poem":1},{"lineBreak":true},{"text":"ty fikofoha’ o maharevendreveñeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manahake ty hatrevohañe","poem":1},{"lineBreak":true},{"text":"an-tane maike eo,","poem":1},{"lineBreak":true},{"text":"ty hampitsiña’o ty fikoraha’","poem":1},{"lineBreak":true},{"text":"o ambahinio;","poem":1},{"lineBreak":true},{"text":"hambañe ami’ty talinjon-drahoñe","poem":1},{"lineBreak":true},{"text":"amy fipisañañey,","poem":1},{"lineBreak":true},{"text":"ty hampijomohoñe","poem":1},{"lineBreak":true},{"text":"ty fibekoa’ o mangosasàkeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ami’ty vohitse toy ty hañalankaña’","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy sabadidake","poem":1},{"lineBreak":true},{"text":"amo raha mafirio ze kila ondaty,","poem":1},{"lineBreak":true},{"text":"takataka aman-divay natadrètse,","poem":1},{"lineBreak":true},{"text":"ty vondrake pea’ ty betron-taolañe,","poem":1},{"lineBreak":true},{"text":"vaho divay soa-filomboke.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le hagedra’e ami’ty vohitse toy ty fikolopofañe ami’ty vinta’ ze kila-ondaty","poem":1},{"lineBreak":true},{"text":"naho ty marerarera mandrongoñe","poem":1},{"lineBreak":true},{"text":"o fifeheañeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hatele’e ho mongotse ty havilasy,","poem":1},{"lineBreak":true},{"text":"vaho ho faohe’ i Rañandria Iehovà","poem":1},{"lineBreak":true},{"text":"amy ze hene laharañe ty ranompihaino;","poem":1},{"lineBreak":true},{"text":"hafaha’e ami’ty tane toy","poem":1},{"lineBreak":true},{"text":"ty sirika’ondati’eo;","poem":1},{"lineBreak":true},{"text":"izay ty nitsarà’ Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho tseizeñe amy andro zay,","poem":1},{"lineBreak":true},{"text":"ty hoe: Toe Ie t’i Andrianañaharentika","poem":1},{"lineBreak":true},{"text":"nitamañe handrombake an-tikañey,","poem":1},{"lineBreak":true},{"text":"Ie Iehovà niliñisan-tikañey, antao hifale naho hirebeke","poem":1},{"lineBreak":true},{"text":"amy fandrombaha’ey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa ami’ty vohitse toy","poem":1},{"lineBreak":true},{"text":"ty hitofà’ ty fità’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho ho lialiàñe an-toe’e eo t’i Moabe,","poem":1},{"lineBreak":true},{"text":"hambañe ami’ty fandialiàñe","poem":1},{"lineBreak":true},{"text":"ty ahetse an-ditsake ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le ho velare’e añivo’iareo o fità’eo,","poem":1},{"lineBreak":true},{"text":"manahake ty famelara’","poem":1},{"lineBreak":true},{"text":"ty pilaño hilañoa’e,","poem":1},{"lineBreak":true},{"text":"fe harèke ty firengevoha’e","poem":1},{"lineBreak":true},{"text":"rekets’ o taña-politì’eo","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"naho harotsa’e ambane o kijoli’o fatratse mitiotiotseo, eka, halama’e;","poem":1},{"lineBreak":true},{"text":"hazevo’e an-tane, toe an-deboke ao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}