mb’ia ho modo t’Iehovà, Ià.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa nakapotra’e","poem":1},{"lineBreak":true},{"text":"o mpimoneñe an-kaboañeo,","poem":1},{"lineBreak":true},{"text":"linama’e ambane’ i rova miligiligiy,","poem":1},{"lineBreak":true},{"text":"nilamahe’e an-tane eo,","poem":1},{"lineBreak":true},{"text":"eka, mb’an-deboke ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho lian-tomboke,","poem":1},{"lineBreak":true},{"text":"ty fandia’ o mpisotrio,","poem":1},{"lineBreak":true},{"text":"ty fidraidraita’ o boròkao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lalañe mira ho amo vañoñeo izay","poem":1},{"lineBreak":true},{"text":"ihe, ry Andindimoneñe,","poem":1},{"lineBreak":true},{"text":"ro mañajary ty lala’ o vantañeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toe an-dala’ o fizaka’oo","poem":1},{"lineBreak":true},{"text":"ry Iehovà, ty nitamà’ay Azo;","poem":1},{"lineBreak":true},{"text":"i tahina’oy naho ty fitiahiañe Azo","poem":1},{"lineBreak":true},{"text":"ro fisalalàn’arofo’ay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nirie’ ty fiaiko irehe te haleñe;","poem":1},{"lineBreak":true},{"text":"eka, nitsoek’azo an-troko ato;","poem":1},{"lineBreak":true},{"text":"amy te, ie ifetsaha’ o fizaka’oo ty tane toy,","poem":1},{"lineBreak":true},{"text":"le hioke havantañañe ondatio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndra te isoheñe o lo tserekeo,","poem":1},{"lineBreak":true},{"text":"tsy ho hai’e o havañonañeo;","poem":1},{"lineBreak":true},{"text":"fa hikitro-karatiañe","poem":1},{"lineBreak":true},{"text":"an-tanen-kavantañañe ao,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho oni’e ty volonahe’ Iehovà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mionjoñe añ’abo ey ty fità’o,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, f’ie tsy isa’ iareo;","poem":1},{"lineBreak":true},{"text":"zoe’ iareo an-kasalarañe","poem":1},{"lineBreak":true},{"text":"ty fahimbaña’o am’ ondatio;","poem":1},{"lineBreak":true},{"text":"eka, ho forototoen-afo o rafelahi’oo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ry Iehovà,","poem":1},{"lineBreak":true},{"text":"toloro fierañerañan-jahay;","poem":1},{"lineBreak":true},{"text":"fa toe Ihe ro nanao","poem":1},{"lineBreak":true},{"text":"ze hene fitoloña’ay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ry Iehovà Andrianañahare’ay,","poem":1},{"lineBreak":true},{"text":"fa nifehèn-drotompo ila’ te ama’o zahay,","poem":1},{"lineBreak":true},{"text":"f’Ihe avao ty toñone’ay tahinañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsy ho veloñe o mateo,","poem":1},{"lineBreak":true},{"text":"tsy hitroatse o loloo;","poem":1},{"lineBreak":true},{"text":"izay ty namara’o naho nandrotsaha’o iareo","poem":1},{"lineBreak":true},{"text":"vaho fonga nimodoe’o","poem":1},{"lineBreak":true},{"text":"ty fitiahiañe iareo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nonjoneñe amo kilakila ondatio irehe,","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1},{"lineBreak":true},{"text":"eka ­nitoabotse amo kila taneo;","poem":1},{"lineBreak":true},{"text":"iasiañe pak’ añ’olotse tsietoimone’","poem":1},{"lineBreak":true},{"text":"ty tane toy añe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ry Iehovà, ie niampoheke","poem":1},{"lineBreak":true},{"text":"te nipaia’ iareo Azo,","poem":1},{"lineBreak":true},{"text":"ampianjiñeñe ty nampi­doandoaña’ iareo","poem":1},{"lineBreak":true},{"text":"halaly ama’o ty amy fandilova’o iareoy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Manahake ty rakemba mitsongo,","poem":1},{"lineBreak":true},{"text":"ie mitotoke ty hisamaha’e,","poem":1},{"lineBreak":true},{"text":"ie manaintaiñe vaho mikoaike","poem":1},{"lineBreak":true},{"text":"amo fitsongoa’eo;","poem":1},{"lineBreak":true},{"text":"hoe izay zahay ry Iehovà tañ’atrefa’o eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe nivesatse zahay,","poem":1},{"lineBreak":true},{"text":"nangotsokotsoke,","poem":1},{"lineBreak":true},{"text":"fe hoe tioke avao ty naboloa’ay;","poem":1},{"lineBreak":true},{"text":"tsy nañeneke ­famotsorañe amy taney;","poem":1},{"lineBreak":true},{"text":"mbore tsy nahatoly ondaty ho","poem":1},{"lineBreak":true},{"text":"mpimone’ ty tane toy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho veloñe o nivetrake ama’oo,","poem":1},{"lineBreak":true},{"text":"hitroatse i sandriko nihomakey,","poem":1},{"lineBreak":true},{"text":"mivañona naho misaboa","poem":1},{"lineBreak":true},{"text":"ry mpitoboke an-deboke ao,","poem":1},{"lineBreak":true},{"text":"fa zono maraindray o zono’oo,","poem":1},{"lineBreak":true},{"text":"vaho haboloa’ i taney o niloloo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Antao ry ondatiko,","poem":1},{"lineBreak":true},{"text":"mihovà añ’anjomba’o ao,","poem":1},{"lineBreak":true},{"text":"arindrino o lalañe amboho’oo","poem":1},{"lineBreak":true},{"text":"mietaha hey ampara’ te heneke","poem":1},{"lineBreak":true},{"text":"i fifomboañey.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Heheke! miakatse i toe’ey t’Iehovà","poem":1},{"lineBreak":true},{"text":"handilo o mpimoneñ’ an-tane atoio","poem":1},{"lineBreak":true},{"text":"ty amo hakeo’eo;","poem":1},{"lineBreak":true},{"text":"haboa’ i taney ty lio niorike ama’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho lembefa’e ka o vinono’eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}