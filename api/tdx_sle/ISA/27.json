{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Amy andro zay, le amy fibara’e","poem":1},{"lineBreak":true},{"text":"mitrotrofiake ra’elahy naho maozatsey","poem":1},{"lineBreak":true},{"text":"ty handilova’ Iehovà i fañaneñey,","poem":1},{"lineBreak":true},{"text":"toe i mereñe mibotatsakey;","poem":1},{"lineBreak":true},{"text":"ty fañaneñe, i mereñe mivanditsey;","poem":1},{"lineBreak":true},{"text":"vaho ho vonoe’e i fañanen-driakey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie tondroke i andro zay:","poem":1},{"lineBreak":true},{"text":"Tetem-bahe fanjàka! Isabò!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Izaho Iehovà ty miambeñe aze,","poem":1},{"lineBreak":true},{"text":"tondrahako rano erike;","poem":1},{"lineBreak":true},{"text":"ambenako haleñe naho handro","poem":1},{"lineBreak":true},{"text":"tsy mone ho joieñe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy mifombo ty an-troko ao,","poem":1},{"lineBreak":true},{"text":"Ie mea’e hisatse naho fatike iraho,","poem":1},{"lineBreak":true},{"text":"le ho lialiako, haharoko forototoeñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naho tsy izay, ee te hiatoa’e ty ­haozarako, hifampilongo amako;","poem":1},{"lineBreak":true},{"text":"ehe t’ie hifampirañetse amako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho tondroke ty andro te ­hamahatse t’Iakobe,","poem":1},{"lineBreak":true},{"text":"hibotiboty naho hitaroke t’Israele;","poem":1},{"lineBreak":true},{"text":"vaho ho tsitsi-kavokarañe","poem":1},{"lineBreak":true},{"text":"ty an-tarehe’ ty tane toy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Linafa’e hao re manahake ty","poem":1},{"lineBreak":true},{"text":"nandafa’e o nandafa azeo?","poem":1},{"lineBreak":true},{"text":"He vinono re hambañe ami’ty","poem":1},{"lineBreak":true},{"text":"nanjamane’e o namono azeo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fandroahañe, faneseañe mb’eo añe","poem":1},{"lineBreak":true},{"text":"ty nihotakotaha’o am’ iereo;","poem":1},{"lineBreak":true},{"text":"amy kofò’e mangosasàkey","poem":1},{"lineBreak":true},{"text":"ty nampisitaha’e iareo","poem":1},{"lineBreak":true},{"text":"amy andro’ i tioke atiñanañeiy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa izay ty hijebañe Iakobe ty amo tahi’eo,","poem":1},{"lineBreak":true},{"text":"zao ty havokarañe handopolopo","poem":1},{"lineBreak":true},{"text":"ty amy nañahàñe o hakeo’eoy:","poem":1},{"lineBreak":true},{"text":"te ho fonga dorodemohe’e","poem":1},{"lineBreak":true},{"text":"ty vato’ o kitrelio,","poem":1},{"lineBreak":true},{"text":"tsy hitroatse ka o hazomangao","poem":1},{"lineBreak":true},{"text":"naho o sare’ i àndroio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Miereñereñe i rova soa-fikalañey,","poem":1},{"lineBreak":true},{"text":"kialo koake naho naforintseñe","poem":1},{"lineBreak":true},{"text":"manahake i fatrañey,","poem":1},{"lineBreak":true},{"text":"ho fiandraza’ o anak’añombeo,","poem":1},{"lineBreak":true},{"text":"eo ty andrea’ iareo,","poem":1},{"lineBreak":true},{"text":"eo ty añolira’ iareo o tsampa’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hapekañe o tsampa’e niforejejeo;","poem":1},{"lineBreak":true},{"text":"homb’eo o rakembao handrehetse aze;","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy ondaty mahilala,","poem":1},{"lineBreak":true},{"text":"aa le tsy hiferenaiña’ i Namboatse iareoy,","poem":1},{"lineBreak":true},{"text":"tsy hitretreza’ i Nitsene iareoy.","poem":1}]},{"type":"verse","number":12,"content":["Ho tondroke amy andro zay te hanatake boak’ amy fikararaha’ i Oñey pak’ amy Toraha’ i Mitsraimey t’Iehovà, le hatontoñe kiraikiraike",{"noteId":126},"nahareo, ry ana’ Israeleo."]},{"type":"verse","number":13,"content":["Le ho popoheñe amy andro zay ty antsiva jabajaba vaho hikovovoke mb’ etoa o nimotso an-tane’ i Asoreo naho o nampitsiran­tsiràñe an-tane Mitsraimeo hitalahoa’ iareo am’ Iehovà amy vohi-miavake e Ierosalaimey."]}],"footnotes":[{"noteId":126,"caller":"+","text":"Iir 3:14-15","reference":{"chapter":27,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}