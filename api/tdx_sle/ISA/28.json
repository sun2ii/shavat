{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe amy sabaka-pisengea’","poem":1},{"lineBreak":true},{"text":"o mpijike’ i Efraimeoy,","poem":1},{"lineBreak":true},{"text":"naho amy fihearam-boñe’e nifanjaka","poem":1},{"lineBreak":true},{"text":"ami’ty hatsomerentsere’ey,","poem":1},{"lineBreak":true},{"text":"i an-doham-bavatane vondra’","poem":1},{"lineBreak":true},{"text":"o niopo-divaioy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heheke te manañe ty maozatse","poem":1},{"lineBreak":true},{"text":"naho ty fatratse t’i Talè,","poem":1},{"lineBreak":true},{"text":"hoe tio-bein-kavandran-gadaboñe,","poem":1},{"lineBreak":true},{"text":"tangololahy mampianto,","poem":1},{"lineBreak":true},{"text":"hoe fisorotombahan-drano mienene,","poem":1},{"lineBreak":true},{"text":"ty hamokovokoam-pita’e aze","poem":1},{"lineBreak":true},{"text":"an-kasiahañe mb’an-tane mb’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho lialiàm-pandia i sabaka niebotsebora’","poem":1},{"lineBreak":true},{"text":"o mpijike mena’ i Efraimeoy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le i voñe an-doham-bavatane vondrakey ro hIheatse amy hasoa-vinta’ey,","poem":1},{"lineBreak":true},{"text":"naho i sakoa loham-boan’ asaray, ie vata’e isake naho am-pità’e ao, ro habotse’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iehovà’ i Màroy ty ho halam-","poem":1},{"lineBreak":true},{"text":"boñem-bolonahetse amy andro zay,","poem":1},{"lineBreak":true},{"text":"Sabaka fanjaka ho a’ ondaty sehanga’eo;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"naho ty arofo tò amy miambesatse an-jakay,","poem":1},{"lineBreak":true},{"text":"Vaho haozarañe ho amo manebañe","poem":1},{"lineBreak":true},{"text":"i hotakotake an-dalam-beiy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Avembèn-divay naho ampidalean­daleañen-toake ka retoañe:","poem":1},{"lineBreak":true},{"text":"ampisiotsioren-toake ty mpisoroñe","poem":1},{"lineBreak":true},{"text":"naho ty mpitoky; alihen-­divay iereo, avembèn-toake;","poem":1},{"lineBreak":true},{"text":"mitoantoañe añ’aroñaroñe iereo, mikolitrekolitre t’ie mizaka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kanao lifo-deotse naho loa","poem":1},{"lineBreak":true},{"text":"o fandambañañeo,,","poem":1},{"lineBreak":true},{"text":"le tsy aman-toetse malio ka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ia ty hañòha’e hilala,","poem":1},{"lineBreak":true},{"text":"naho ia ty hampalangese’e i taliliy?","poem":1},{"lineBreak":true},{"text":"O vaho notàñe amy rononoio hao?","poem":1},{"lineBreak":true},{"text":"O vaho nasitake am-patroao hao?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa, fañè manovom-­pañè, fañè am-pañè,","poem":1},{"lineBreak":true},{"text":"patetse am-patetse, patetse am-patetse,","poem":1},{"lineBreak":true},{"text":"kede atoy, kede aroy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe am-pivimby mibedobedo,","poem":1},{"lineBreak":true},{"text":"naho am-pamelen’ ambahiny,","poem":1},{"lineBreak":true},{"text":"ty hisaontsia’e am’ondatio,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ie nanoeñe ty hoe: Fitofàñe toy;","poem":1},{"lineBreak":true},{"text":"ampitofa o mokotseo;","poem":1},{"lineBreak":true},{"text":"zao o fanintsiñañeo;","poem":1},{"lineBreak":true},{"text":"fe tsy nañaoñe iereo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le hoe ty hitsara’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Fañè tovoñam-pañè, fañè am-pañè,","poem":1},{"lineBreak":true},{"text":"patetse am-patetse, patetse am-patetse,","poem":1},{"lineBreak":true},{"text":"kede ty atoy, kede ty aroy.","poem":1},{"lineBreak":true},{"text":"Soa te ie mandeha iereo ro","poem":1},{"lineBreak":true},{"text":"hitoboly, ho pozaheñe,","poem":1},{"lineBreak":true},{"text":"ho fandriheñe, vaho ho tavaneñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le janjiño ty tsara’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry mpanivetive mifeleke ondaty","poem":1},{"lineBreak":true},{"text":"e Ierosalaime ao retoa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ami’ty natao’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"nilahatse amy Havilasiy zahay,","poem":1},{"lineBreak":true},{"text":"vaho nifañina amy Tsikeokeokey;","poem":1},{"lineBreak":true},{"text":"le ie misoroke atoy ty kiria mamaoke","poem":1},{"lineBreak":true},{"text":"le tsy homb’ama’ay izay;","poem":1},{"lineBreak":true},{"text":"fa ipalira’ay ty fandañirañe,","poem":1},{"lineBreak":true},{"text":"itsoloha’ay i remborake;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le hoe t’i Talè Iehovà :","poem":1},{"lineBreak":true},{"text":"Heheke te mampipoke faham-bato","poem":1},{"lineBreak":true},{"text":"e Tsione eo iraho, vato tsinòke;","poem":1},{"lineBreak":true},{"text":"vaton-kotsoke sarotse, soa fijadoñe;","poem":1},{"lineBreak":true},{"text":"Tsy ho tsòtseke ty mpiato ama’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hanoeko talim-panjeheañe ty hatò,","poem":1},{"lineBreak":true},{"text":"naho havantañañe ty fampimiràñe,","poem":1},{"lineBreak":true},{"text":"ho faopaohen-kavandra","poem":1},{"lineBreak":true},{"text":"ty fipaliram-bodiake,","poem":1},{"lineBreak":true},{"text":"vaho handoparan-­drano i fiampirañey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho mongoreñe ty fañina’ areo","poem":1},{"lineBreak":true},{"text":"amy Havilasy,","poem":1},{"lineBreak":true},{"text":"tsy hijadoñe ty filahara’ areo","poem":1},{"lineBreak":true},{"text":"amy Tsikeokeoke;","poem":1},{"lineBreak":true},{"text":"ie mitoañe mb’eo ty kiria mamaoke,","poem":1},{"lineBreak":true},{"text":"le ho lialià’e nahareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ndra mbiambia ty hirangà’e,","poem":1},{"lineBreak":true},{"text":"le ho fihine’e nahareo,","poem":1},{"lineBreak":true},{"text":"fa boak’ andro ty hitoaña’e,","poem":1},{"lineBreak":true},{"text":"handro an-kale;","poem":1},{"lineBreak":true},{"text":"vaho ho vata’e maharevendreveñe","poem":1},{"lineBreak":true},{"text":"ty andrendrehañe ty tali’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Loho bory ty fandreañe,","poem":1},{"lineBreak":true},{"text":"tsy mete ihitsiañe,","poem":1},{"lineBreak":true},{"text":"kede ty am-pohe’ i bodoy","poem":1},{"lineBreak":true},{"text":"tsy mete isafononohañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hiongake hoe tam-bohi-Peratsime","poem":1},{"noteId":127},{"lineBreak":true},{"text":"t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hitroñe manahake tam-bohi’ i Gibone","poem":1},{"noteId":128},{"text":",","poem":1},{"lineBreak":true},{"text":"hanoe’e ty fitoloña’e","poem":1},{"lineBreak":true},{"text":"—tolon-draha boidy,","poem":1},{"lineBreak":true},{"text":"hihentseña’e ty sata’e—sata àlike!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie amy zao, apoho ty fanivetiveañe,","poem":1},{"lineBreak":true},{"text":"hera ho fihineñe o ­tali-randra’ areoo,","poem":1},{"lineBreak":true},{"text":"fa tsinanoko amy Talè, Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"te nitseizeñe fandro­tsahañe ty tane bey toy","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mijanjiña naho tsendreño ty feoko;","poem":1},{"lineBreak":true},{"text":"haoño vaho janjiño o entakoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mitrabake nainai’e hao ty mpitongy?","poem":1},{"lineBreak":true},{"text":"ho troboe’e naho ho fantaña’e","poem":1},{"lineBreak":true},{"text":"nainai’e hao i taney?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie fa nampirae’e i taney,","poem":1},{"lineBreak":true},{"text":"tsy handraraha’e vañemba","poem":1},{"noteId":129},{"text":"hao","poem":1},{"lineBreak":true},{"text":"naho amitseza’e vihinja","poem":1},{"noteId":130},{"text":"?","poem":1},{"lineBreak":true},{"text":"Tongise’e am-piriritañe ty vare-bolè","poem":1},{"noteId":131},{"text":",","poem":1},{"lineBreak":true},{"text":"le an-toe’e eo ty vare-horodè","poem":1},{"noteId":132},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho añ’olotse ey ty kosemete","poem":1},{"noteId":133},{"text":".","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Amy t’ie anareko hisafiry,","poem":1},{"lineBreak":true},{"text":"mañòke aze t’i Andrianañahare’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tsy lisanem-baoñe ty vañemba,","poem":1},{"lineBreak":true},{"text":"tsy aodiñ’ an-daròn-tsarete ty vihinja,","poem":1},{"lineBreak":true},{"text":"fe kimokimohen-doda ty vañemba","poem":1},{"lineBreak":true},{"text":"naho lisaneñ’ akalo ty vihinja.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Demoheñe ty vare-bolè hanoañe mofo,","poem":1},{"lineBreak":true},{"text":"fa tsy lisaneñe nainai’e,","poem":1},{"lineBreak":true},{"text":"eo ty mandialia aze an-tsarete","poem":1},{"lineBreak":true},{"text":"reketse soavala ambone’e eo,","poem":1},{"lineBreak":true},{"text":"fe tsy hotomomohe’e.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Boak’ am’ Iehovà’ i Màroy ka izay,","poem":1},{"lineBreak":true},{"text":"miambake ty fanoroa’e,","poem":1},{"lineBreak":true},{"text":"tsy amañ’ohatse ty hihi’e.","poem":1}]}],"footnotes":[{"noteId":127,"caller":"+","text":"Perazime: fizarazarañe","reference":{"chapter":28,"verse":21}},{"noteId":128,"caller":"+","text":"Gibeone: fititike; tamboho; naonjoñe","reference":{"chapter":28,"verse":21}},{"noteId":129,"caller":"+","text":"Heb: kètsake","reference":{"chapter":28,"verse":25}},{"noteId":130,"caller":"+","text":"Heb: kamone","reference":{"chapter":28,"verse":25}},{"noteId":131,"caller":"+","text":"Heb: kità","reference":{"chapter":28,"verse":25}},{"noteId":132,"caller":"+","text":"Heb: sehorà","reference":{"chapter":28,"verse":25}},{"noteId":133,"caller":"+","text":"Kosemete: karazam-bare-bolè","reference":{"chapter":28,"verse":25}}]},"thisChapterLink":"/api/tdx_sle/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}