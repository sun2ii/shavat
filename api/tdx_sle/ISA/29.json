{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Hekoheko ry Ariele","poem":1},{"noteId":134},{"text":", ry ­Ariele","poem":1},{"noteId":135},{"text":",","poem":1},{"lineBreak":true},{"text":"ty rova nitobea’ i Davide!","poem":1},{"lineBreak":true},{"text":"Tovoño taoñe an-taoñe,","poem":1},{"lineBreak":true},{"text":"ampitoitoio o sabadidakeo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le handesako haemberañe ty Ariele,","poem":1},{"lineBreak":true},{"text":"le ho fandalàñe naho firovetañe ty ao,","poem":1},{"lineBreak":true},{"text":"ie hanahake Ariele amako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le ho arikatohako irehe;","poem":1},{"lineBreak":true},{"text":"ho arikoboñako votre abo,","poem":1},{"lineBreak":true},{"text":"hatroako ama’o ty rafi-panameañe","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le hafotsak’ ambane irehe,","poem":1},{"lineBreak":true},{"text":"hisaontsy boak’an-tane ao,","poem":1},{"lineBreak":true},{"text":"hirik’an-deboke itsalalampa’o ao","poem":1},{"lineBreak":true},{"text":"ty hipetropetroha’o,","poem":1},{"lineBreak":true},{"text":"hanahake ty feon’ angatse","poem":1},{"lineBreak":true},{"text":"boak’ an-tane ao","poem":1},{"lineBreak":true},{"text":"ty antseñàntseña’o,","poem":1},{"lineBreak":true},{"text":"vaho higeongeoñe boak’ an-demboke ao","poem":1},{"lineBreak":true},{"text":"ty filañona’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa hanahake ty deboke mibò","poem":1},{"lineBreak":true},{"text":"o rafelahi’o maroo,","poem":1},{"lineBreak":true},{"text":"le hoe kafo mihofa","poem":1},{"lineBreak":true},{"text":"o mampangebahebake tsifotofotoo—","poem":1},{"lineBreak":true},{"text":"eka, hafetsak’ aniany, ami’ty manao zao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hitilike anahareo t’Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"reketse hotroke naho fanginikinihañe,","poem":1},{"lineBreak":true},{"text":"naho fitromoroñañe, naho tangololahy,","poem":1},{"lineBreak":true},{"text":"naho tiobey vaho ty lel-afo mamorototo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le ty valobohò’ o fifeheañe iaby","poem":1},{"lineBreak":true},{"text":"mialy amy Arieleo,","poem":1},{"lineBreak":true},{"text":"o mifandrapake ama’eo,","poem":1},{"lineBreak":true},{"text":"naho o rafem-pañarikatohañe azeo,","poem":1},{"lineBreak":true},{"text":"naho o mampalovilovy azeo,","poem":1},{"lineBreak":true},{"text":"le hanahake ty nofy,","poem":1},{"lineBreak":true},{"text":"ty aroñaroñe an-kaleñe;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le ho hambañe ami’ty saliko mañinofy, heheke t’ie mikama,","poem":1},{"lineBreak":true},{"text":"f’ie tsekake, mbe mikolempa ty tro’e; naho ty fañinofisa’ ty taliñiereñe,","poem":1},{"lineBreak":true},{"text":"heheke t’ie minon-drano,","poem":1},{"lineBreak":true},{"text":"ie mibarakaoke hehe te mbe miheahea,","poem":1},{"lineBreak":true},{"text":"tsy afake i harandrano’ey,","poem":1},{"lineBreak":true},{"text":"hanahake izay ty valobohò’ o fifeheañe iaby haname i vohi-Tsioneio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mijimejimeña naho midebedebea,","poem":1},{"lineBreak":true},{"text":"migoà vaho mitambara ho fèy!","poem":1},{"lineBreak":true},{"text":"jike iereo, fa tsy an-divay!","poem":1},{"lineBreak":true},{"text":"mivembeñe fa tsy an-toake!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa nadoa’ Iehovà ama’ areo","poem":1},{"lineBreak":true},{"text":"ty fañahy mampilañake an-droro;","poem":1},{"lineBreak":true},{"text":"fa nakipe’e ty fihaino’ areo, (o mpitokio); naho fa kinolopo’e","poem":1},{"lineBreak":true},{"text":"ty añambone’ areo (o mpioniñeo).","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I hene aroñaroñey le ho ama’areo","poem":1},{"lineBreak":true},{"text":"hoe tsara am-boke linite,","poem":1},{"lineBreak":true},{"text":"ie atolo’areo ami’ty mahay mamaky,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Ehe, vakio toy,","poem":1},{"lineBreak":true},{"text":"le hoe ty hatoi’e: Tsy mete fa linite.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le ie atolo’areo ami’ty tsy mahay,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Vakio toy,","poem":1},{"lineBreak":true},{"text":"le hanoa’e ty hoe: Tsy mahay iraho.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hoe t’i Talè:","poem":1},{"lineBreak":true},{"text":"Kanao mañarine ahy am-palie,","poem":1},{"lineBreak":true},{"text":"ondaty retoañe","poem":1},{"lineBreak":true},{"text":"naho miasy ahy am-pivimby,","poem":1},{"lineBreak":true},{"text":"ie ahanka’ iareo lavits’ahy o arofo’iareoo, vaho lili’ ondaty avao","poem":1},{"lineBreak":true},{"text":"ty añoha’iareo ho fañeveñañe amako","poem":1},{"noteId":136},{"text":";","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Inao, hanoeko raha mampañeveñe","poem":1},{"lineBreak":true},{"text":"indraike ondatio: halatsañe mahadaba;","poem":1},{"lineBreak":true},{"text":"ho mongotse ty hihi’ o mahihi’ iareoo","poem":1},{"lineBreak":true},{"text":"naho hikafitse ty hilala’","poem":1},{"lineBreak":true},{"text":"o mahilala’ iareoo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hankàñe amo mañetake ty fikinià’iareo laleke tsy ho oni’ Iehovào,","poem":1},{"lineBreak":true},{"text":"amo mikitroke raha añ’ieñeio,","poem":1},{"lineBreak":true},{"text":"naho manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ia ty mahavazoho’ antika? ndra:","poem":1},{"lineBreak":true},{"text":"Ia ty maharofoanañe antika?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hete! akore ty hamengoha’ areo!","poem":1},{"lineBreak":true},{"text":"Hasiñeñe manahake i mpanao valàñe taney hao i litsakey?","poem":1},{"lineBreak":true},{"text":"hanao ty hoe amy namboatsey","poem":1},{"lineBreak":true},{"text":"hao i namboareñey:","poem":1},{"lineBreak":true},{"text":"Tsy ihe ty namboatse ahy.","poem":1},{"lineBreak":true},{"text":"Ndra hanao amy nandrafitse azey ty hoe: Tsy mahilala irehe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy aniany avao hao te havalike","poem":1},{"lineBreak":true},{"text":"ho tonda kobokara ty Lebanone,","poem":1},{"lineBreak":true},{"text":"vaho hatao ala i teteke kobokaray?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amy andro zay,","poem":1},{"lineBreak":true},{"text":"ho janjiñe’ o ­kareñeñeo ty tsara","poem":1},{"lineBreak":true},{"text":"am-boke ao,","poem":1},{"lineBreak":true},{"text":"le boak’ami’ty fimoromoroña’e","poem":1},{"lineBreak":true},{"text":"naho ty fanalinjoña’e ao","poem":1},{"lineBreak":true},{"text":"ty hahaisaha’ ty fihaino’ o feio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hañonjon-karebehañe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"o tretram-poo,","poem":1},{"lineBreak":true},{"text":"naho handia taroba amy Masi’Israeley","poem":1},{"lineBreak":true},{"text":"o rarake am’ondatio.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa hihelañe añe i mpitrotrofiakey,","poem":1},{"lineBreak":true},{"text":"naho hijihetse i mpañìnjey,","poem":1},{"lineBreak":true},{"text":"toe fonga haitoañe","poem":1},{"lineBreak":true},{"text":"o mahimbam-panao ratio;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"O mampandilatse ondaty","poem":1},{"lineBreak":true},{"text":"an-tsaontsy,","poem":1},{"lineBreak":true},{"text":"naho mamandrike","poem":1},{"lineBreak":true},{"text":"i mizaka an-dalam-beiy,","poem":1},{"lineBreak":true},{"text":"vaho mikatramo ty vantañe","poem":1},{"lineBreak":true},{"text":"an-dreha-borosodeo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"mpijebañe i Avrahame,","poem":1},{"lineBreak":true},{"text":"ty amy anjomba’ Iakobey:","poem":1},{"lineBreak":true},{"text":"Tsy ho salatse t’Iakobe henane zao,","poem":1},{"lineBreak":true},{"text":"vaho tsy hiko-mavo i lahara’ey,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ie isa’ o ana’eo o satan-tañako","poem":1},{"lineBreak":true},{"text":"añivo’eo, le havahe’iereo ty añarako","poem":1},{"lineBreak":true},{"text":"Eka! hiasia’ iareo i Masi’ Iakobey,","poem":1},{"lineBreak":true},{"text":"vaho hañeveñe","poem":1},{"lineBreak":true},{"text":"amy Andrianañahare’ Israele.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Le hahilala o mandilatse an-trokeo,","poem":1},{"lineBreak":true},{"text":"vaho hañaom-pañanarañe","poem":1},{"lineBreak":true},{"text":"o miñeoñeoñeo.","poem":1}]}],"footnotes":[{"noteId":134,"caller":"+","text":"Ariele: añaram-binta’ Ierosalaime","reference":{"chapter":29,"verse":1}},{"noteId":135,"caller":"+","text":"Ariele: kitrely; hazava ndra liona’ Iehovà","reference":{"chapter":29,"verse":1}},{"noteId":136,"caller":"+","text":"Mat 15:8-9, Mar 7:6-7","reference":{"chapter":29,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}