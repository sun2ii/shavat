{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Hehek’ arè te","poem":1},{"lineBreak":true},{"text":"afaha’ Iehovà Talè’ i màroy","poem":1},{"lineBreak":true},{"text":"am’ Iehodà naho am’ Ierosalaime","poem":1},{"lineBreak":true},{"text":"ty fitoñoñe naho ty kobay,","poem":1},{"lineBreak":true},{"text":"ze mahakama an-driha ao iaby,","poem":1},{"lineBreak":true},{"text":"naho ze hene haja rano,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ty fanalolahy naho ty lahindefoñe,","poem":1},{"lineBreak":true},{"text":"ty mpizaka naho ty mpitoky,","poem":1},{"lineBreak":true},{"text":"ty mpisikily naho ty androanavy,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ty mpifeleke limampolo","poem":1},{"lineBreak":true},{"text":"naho ty manan-kasy,","poem":1},{"lineBreak":true},{"text":"ty mpanolo-kevetse,","poem":1},{"lineBreak":true},{"text":"ty kalitake vaho","poem":1},{"lineBreak":true},{"text":"ty mahay lañonañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ho tolorako ajaja ho roandria’e,","poem":1},{"lineBreak":true},{"text":"ho felehe’ o anak’ajajao iereo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho forekekèñe ondatio,","poem":1},{"lineBreak":true},{"text":"sindre ondaty ami’ty ilae’e,","poem":1},{"lineBreak":true},{"text":"songa ami’ty rañe’e","poem":1},{"lineBreak":true},{"text":"hijiajia amo androanavio ty ajaja,","poem":1},{"lineBreak":true},{"text":"naho amo vañoñeo ty tembo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le hangazoñe t’indaty ty rahalahi’e","poem":1},{"lineBreak":true},{"text":"añ’anjomban-drae’e ao:","poem":1},{"lineBreak":true},{"text":"Manan-tsikin-drehe: feheo zahay,","poem":1},{"lineBreak":true},{"text":"le angao ho ambane’ fità’o eo","poem":1},{"lineBreak":true},{"text":"ty fianto toy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hifanta amy andro zay re:","poem":1},{"lineBreak":true},{"text":"Izaho tsy ho mpanaha;","poem":1},{"lineBreak":true},{"text":"amy te tsy ama-mahakama","poem":1},{"lineBreak":true},{"text":"ndra saroñe ty an-trañoko ao,","poem":1},{"lineBreak":true},{"text":"aa le ko ampifehè’o ahy ondatio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amy te nikoletra t’Ierosalaime","poem":1},{"lineBreak":true},{"text":"nihotrake t’Iehodà: songa mandietse Iehovà","poem":1},{"lineBreak":true},{"text":"ty fameleke naho ty fitoloñañe,","poem":1},{"lineBreak":true},{"text":"hanigike o fihainon-enge’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manisý iareo ty vintan-dahara’ iareo;","poem":1},{"lineBreak":true},{"text":"ie misenge hakeo manahak’ i Sedome, tsy aeta’ iareo.","poem":1},{"lineBreak":true},{"text":"Hekoheko amo tro’ iareoo,","poem":1},{"lineBreak":true},{"text":"fa nikai-kankàñe am-bata’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Misaontsia amo vantañeo ty hoe, Soa!","poem":1},{"lineBreak":true},{"text":"fa ho kamae’e o vokam-pitoloña’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Feh’ohatse amo lo­-tserekeo: ho silofeñe:","poem":1},{"lineBreak":true},{"text":"fa havahañe ama’e o satam-pità’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le ty am’ondatikoo, ty ajaja ro talè’e,","poem":1},{"lineBreak":true},{"text":"naho ampela ro mpifeleke.","poem":1},{"lineBreak":true},{"text":"O ry ondatikoo, ampandilare’","poem":1},{"lineBreak":true},{"text":"o mpifehe’areoo,","poem":1},{"lineBreak":true},{"text":"abotse’iereo o lala ho norihe’areoo","poem":1},{"noteId":16},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Miongake t’Iehovà hitaroñe,","poem":1},{"lineBreak":true},{"text":"mijohañe eo hizaka ondatio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho zakae’ Iehovà","poem":1},{"lineBreak":true},{"text":"o androanavi’ondati’eoo","poem":1},{"lineBreak":true},{"text":"naho o roandria’eo;","poem":1},{"lineBreak":true},{"text":"Amy te nabea’ areo","poem":1},{"lineBreak":true},{"text":"i tanem-balobokey;","poem":1},{"lineBreak":true},{"text":"añ’anjomba’areo ao o tinavañe","poem":1},{"lineBreak":true},{"text":"amo rarakeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ino ty atao’ areo,","poem":1},{"lineBreak":true},{"text":"kanao mampidemoke ondatikoo,","poem":1},{"lineBreak":true},{"text":"vaho mandisañe ty lahara’ o rarakeo?","poem":1},{"lineBreak":true},{"text":"hoe ty nafè’ Iehovà Talè’ i màroy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mbore tinovo’ Iehovà ty hoe:","poem":1},{"lineBreak":true},{"text":"Kanao mitoandratoandra","poem":1},{"lineBreak":true},{"text":"o anak’ampela’ i Tsioneo,","poem":1},{"lineBreak":true},{"text":"naho miebotsebotse","poem":1},{"lineBreak":true},{"text":"am-bozo midagarìtse","poem":1},{"lineBreak":true},{"text":"naho ama-maso mikiroke,","poem":1},{"lineBreak":true},{"text":"ie mitsapiotsapiok’ am-piotroñañe,","poem":1},{"lineBreak":true},{"text":"vaho am-pikantsakantsañañe","poem":1},{"lineBreak":true},{"text":"ty tombo’ iareo,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"le ho silofe’ i Talè lañao","poem":1},{"lineBreak":true},{"text":"ty an-gadon-doha’","poem":1},{"lineBreak":true},{"text":"o anak’ampela’ i Tsioneo","poem":1},{"noteId":17},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho habora’ Iehovà ty fimeñara’ iareo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hafaha’ i Talè amy andro zay","poem":1},{"lineBreak":true},{"text":"o mohara soa’ iareo mikorìñeo,","poem":1},{"lineBreak":true},{"text":"o ravak’ an-doha’eo,","poem":1},{"lineBreak":true},{"text":"o tsiandetse bontolio,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"o rojoo, o bangebangeo","poem":1},{"lineBreak":true},{"text":"o saron-doha mihofahofao,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"o satro-beio, o ravam-pandiao,","poem":1},{"lineBreak":true},{"text":"o ravan-dohao,","poem":1},{"lineBreak":true},{"text":"o fibandian’arañañeo, o kiviroo,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"o bangeo naho o kavin’ oroñeo,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"o saravio, naho o salampiñeo,","poem":1},{"lineBreak":true},{"text":"o kitambio","poem":1},{"lineBreak":true},{"text":"naho o haro-pitintiñañeo,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"o hetsoroo, o lamba leny marerarerao,","poem":1},{"lineBreak":true},{"text":"o sabakao vaho o tsingarakarakeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho tondroke te ho limbeze’ ty fitrotrotse ty harifondrifoñe;","poem":1},{"lineBreak":true},{"text":"handimbe ty fiètse ty hàfotse;","poem":1},{"lineBreak":true},{"text":"handimbe ty volo mirandra ty loha peake;","poem":1},{"lineBreak":true},{"text":"handimbe ty marerarera ty gony;","poem":1},{"lineBreak":true},{"text":"hisolo ty montramontra ty soba.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ho zamaneñe am-pibara o lahilahi’oo,","poem":1},{"lineBreak":true},{"text":"an-kotakotak’ ao o lahindefo’oo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Handala naho hangololoike","poem":1},{"lineBreak":true},{"text":"o lalam-bei’eo;","poem":1},{"lineBreak":true},{"text":"ho farien-dre le hitozoke an-tane eo.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Ies 9:16","reference":{"chapter":3,"verse":12}},{"noteId":17,"caller":"+","text":"Tsione: Fitiahiañe; naonjoñe; lonake","reference":{"chapter":3,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}