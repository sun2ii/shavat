[{"lineBreak":true},{"text":"Amy t’ie ondaty miola,","poem":1},{"lineBreak":true},{"text":"anake mavande,","poem":1},{"lineBreak":true},{"text":"ajaja tsy mete mitsanoñe","poem":1},{"lineBreak":true},{"text":"o Tsara’ Iehovào;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ie manao amo mpioniñeo ty hoe:","poem":1},{"lineBreak":true},{"text":"Ko mioniñe, naho amo mpitokio,","poem":1},{"lineBreak":true},{"text":"Ko mitoky ama’ay ty hahiti’e;","poem":1},{"lineBreak":true},{"text":"taroño ama’ay ty raha mora,","poem":1},{"lineBreak":true},{"text":"mitokia famañahiañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isitaho o lalañeo, idisaho i lalam-bantañey, ajihero tsy ho aolo’ay","poem":1},{"lineBreak":true},{"text":"t’i Masi’ Israele.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le hoe t’i Masi’ Israele,","poem":1},{"lineBreak":true},{"text":"kanao tsambolitio’ areo ty tsara toy,","poem":1},{"lineBreak":true},{"text":"naho miato ami’ty famorekekeañe","poem":1},{"lineBreak":true},{"text":"naho ty hamengohañe,","poem":1},{"lineBreak":true},{"text":"vaho mipitek’ ama’e;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"le ho ama’ areo i hakeo zay,","poem":1},{"lineBreak":true},{"text":"manahake ty heba an-kijoly te higorobañe,","poem":1},{"lineBreak":true},{"text":"ie miboenatse an-kijolim-bato abo ey,","poem":1},{"lineBreak":true},{"text":"vaho migorogodeboñe amy zao","poem":1},{"lineBreak":true},{"text":"ty fihotraha’e;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ie hiparaitsake hoe valañem-panao valàñe tane,","poem":1},{"lineBreak":true},{"text":"le akore ty fipoñafa’e kanao","poem":1},{"lineBreak":true},{"text":"tsy ahatreavañe ndra tsila’e","poem":1},{"lineBreak":true},{"text":"amo biliti’e niparatsakeo","poem":1},{"lineBreak":true},{"text":"hahatintinañe vaen’afo","poem":1},{"lineBreak":true},{"text":"boak’am-patañe ao,","poem":1},{"lineBreak":true},{"text":"ndra ty hanilofañe rano hirik’ an-kadaha ao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa hoe t’i Talè Iehovà, Masi’ Israele;","poem":1},{"lineBreak":true},{"text":"ty fisolohoañe naho fihendreañe","poem":1},{"lineBreak":true},{"text":"ty maharombake anahareo;","poem":1},{"lineBreak":true},{"text":"toe fianjiñañe naho fatokisañe","poem":1},{"lineBreak":true},{"text":"ro haozara’ areo.","poem":1},{"lineBreak":true},{"text":"Fe tsy nipaoke nahareo","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"te mone ty hoe: Aiy avao!","poem":1},{"lineBreak":true},{"text":"hioratse an-tsoavala zahay! —","poem":1},{"lineBreak":true},{"text":"toe hivoratsake nahareo! naho,","poem":1},{"lineBreak":true},{"text":"Hiningitse an-tsoavala lahi’e","poem":1},{"lineBreak":true},{"text":"mahafitsontike zahay—","poem":1},{"lineBreak":true},{"text":"aa le hipirirìtse ka o","poem":1},{"lineBreak":true},{"text":"mañoridañe anahareoo!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Arivo ty hibioñe","poem":1},{"lineBreak":true},{"text":"ami’ty fañembaña’ ty raike,","poem":1},{"lineBreak":true},{"text":"hitriban-day nahareo ami’ty","poem":1},{"lineBreak":true},{"text":"fañembaña’ ty lime, ampara’ t’ie","poem":1},{"lineBreak":true},{"text":"miereñereñe hoe hazolahy","poem":1},{"lineBreak":true},{"text":"an-kaboañe eñe,","poem":1},{"lineBreak":true},{"text":"hoe viloñe ambone vohitse ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe mandiñe te hañisoke","poem":1},{"lineBreak":true},{"text":"anahareo t’Iehovà;","poem":1},{"lineBreak":true},{"text":"hitretrèza’e boak’ añ’abo ao.","poem":1},{"lineBreak":true},{"text":"Fa Andrianañaharen-katò t’Iehovà;","poem":1},{"lineBreak":true},{"text":"haha iaby o mitamà Azeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ry ondaty e 