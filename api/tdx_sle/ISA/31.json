{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Feh-ohatse amo mizotso mb’e","poem":1},{"lineBreak":true},{"text":"Mitsraime mb’eo hipay olotse,","poem":1},{"lineBreak":true},{"text":"miato aman-tsoavala,","poem":1},{"lineBreak":true},{"text":"naho mirampy an-­tsarete kanao maro,","poem":1},{"lineBreak":true},{"text":"vaho amo mpiningitse ama’eo","poem":1},{"lineBreak":true},{"text":"katao maozatse;","poem":1},{"lineBreak":true},{"text":"f’ie tsy mitolike amy Masi’ Israele,","poem":1},{"lineBreak":true},{"text":"tsy paia’ iareo t’Iehovà!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa mahihitse ka re hindesa’e hankàñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy hampoli’e o tsara’eo;","poem":1},{"lineBreak":true},{"text":"f’ie hiongake hiatreatre","poem":1},{"lineBreak":true},{"text":"ty anjomba’ o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"naho ty fañimba’ o mikitro-karatiañeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ondaty ‘nio o nte-Mitsraimeo","poem":1},{"lineBreak":true},{"text":"fa tsy Andrianañahare,","poem":1},{"lineBreak":true},{"text":"naho nòfotse o soavala’eo fa tsy angatse;","poem":1},{"lineBreak":true},{"text":"aa le hatora-kitsi’ Iehovà ty fità’e,","poem":1},{"lineBreak":true},{"text":"le hitsikapy ty mpañimba","poem":1},{"lineBreak":true},{"text":"naho hikorovoke i imbaeñey,","poem":1},{"lineBreak":true},{"text":"vaho songa hitrao-pihotrake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Hambañe ami’ty liona","poem":1},{"lineBreak":true},{"text":"naho ty liona tora’e,","poem":1},{"lineBreak":true},{"text":"ie mitromoroñe ambone’ i nitsàtsa’ey,","poem":1},{"lineBreak":true},{"text":"ndra te maro ty mpiarak’añondry","poem":1},{"lineBreak":true},{"text":"nikoiheñe ty ama’e,","poem":1},{"lineBreak":true},{"text":"tsy mañembañe aze ty feo’ iareo,","poem":1},{"lineBreak":true},{"text":"tsy mañembetse aze ty fikorà’ iareo;","poem":1},{"lineBreak":true},{"text":"izay ty hizotsoa’ Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"hialia’e am-bohi-Tsione,","poem":1},{"lineBreak":true},{"text":"naho an-kaboa’e eo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manahake ty fihelahela’ o voroñeo,","poem":1},{"lineBreak":true},{"text":"ty hañarova’ Iehovà’ i Màroy t’Ierosalaime;","poem":1},{"lineBreak":true},{"text":"katao mañaro, mamotsotse,","poem":1},{"lineBreak":true},{"text":"kanao ihelaña’e ambone, mandrombake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitoliha amy loho niolà’ areoy,","poem":1},{"lineBreak":true},{"text":"ry ana’ Israeleo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie amy andro zay,","poem":1},{"lineBreak":true},{"text":"songa hañary ze sare-sokim-bolafoti’e","poem":1},{"lineBreak":true},{"text":"naho o saren-draha volamena’eo,","poem":1},{"lineBreak":true},{"text":"o tsinene am-­pitañe aman-kakeoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toe hampikorovohe’ ty fibara","poem":1},{"lineBreak":true},{"text":"tsy a’ ondaty ty Asore;","poem":1},{"lineBreak":true},{"text":"ty fibara tsy a’ ondaty ty hamotsek’ aze;","poem":1},{"lineBreak":true},{"text":"aa le tsy hibotatsaha’e i fibaray,","poem":1},{"lineBreak":true},{"text":"vaho ho mpitorom-pamorekèke","poem":1},{"lineBreak":true},{"text":"o ajalahi’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hihelañe añe am-pirevendreveñañe i hafatrara’ey,","poem":1},{"lineBreak":true},{"text":"naho hitsolofìñe amy saiñey","poem":1},{"lineBreak":true},{"text":"o mpifehe’eo, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"an-Tsione ao ty afo’e vaho","poem":1},{"lineBreak":true},{"text":"e Ierosalaime ao ty toña’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}