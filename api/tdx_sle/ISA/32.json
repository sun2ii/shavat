},{"lineBreak":true},{"text":"ty fivetsevetse bei-àreke,","poem":1},{"lineBreak":true},{"text":"hiaren-tsaontsy ty famele’ o mènekeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy hatao vañoñe ka ty dagola,","poem":1},{"lineBreak":true},{"text":"le tsy hatao matarike ty tsivokatse;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amy te mivolam-­borosode ty gege,","poem":1},{"lineBreak":true},{"text":"mikitro-draha raty ty tro’e,","poem":1},{"lineBreak":true},{"text":"hitoloñe tsy aman-Kake,","poem":1},{"lineBreak":true},{"text":"hivolañ’ ota am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"kefohe’e ty tro’ i saliko,","poem":1},{"lineBreak":true},{"text":"vaho kapaihe’e ty fitovi’ i taliñiereñey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy vente’e ty harao’ o tsivokatseo;","poem":1},{"lineBreak":true},{"text":"kiniae’e loza an-tambaimbaiñe","poem":1},{"lineBreak":true},{"text":"o rarakeo,","poem":1},{"lineBreak":true},{"text":"ndra te mivolan-to i misotriy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Misafiry fatarihañe ty matarike,","poem":1},{"lineBreak":true},{"text":"naho i fatariha’e ty ijadoña’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Miongaha ry rakemba miagarègañeo,","poem":1},{"lineBreak":true},{"text":"janjiño o feokoo;","poem":1},{"lineBreak":true},{"text":"ry anak’ampela mitabonìtseo","poem":1},{"lineBreak":true},{"text":"anoloro sofiñe o lañonakoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho ampoheke nahareo","poem":1},{"lineBreak":true},{"text":"te peake ty taoñe tovoñañ’ andro","poem":1},{"lineBreak":true},{"text":"ry tsidaredareo;","poem":1},{"lineBreak":true},{"text":"fa tsy hamokatse o vaheo,","poem":1},{"lineBreak":true},{"text":"tsy ho toly i fanontonañey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mititititiha, ry miaiñañoleñañeo, mimahimahiña ry miandrañandrañeo; maña­metsametsà, miboridaña,","poem":1},{"lineBreak":true},{"text":"misikina gony an-tohake","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mikabokaboha araña","poem":1},{"lineBreak":true},{"text":"ty amo tonda nisoao,","poem":1},{"lineBreak":true},{"text":"naho amo vahe niregoregoo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ty amy tane-hoba’ ondatikoy,","poem":1},{"lineBreak":true},{"text":"ie itiriam-patike naho hisatse;","poem":1},{"lineBreak":true},{"text":"eka, ty amo anjomba mitsinjakeo","poem":1},{"lineBreak":true},{"text":"vaho i rova mandia taròbay.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa kòake i anjombam-panjakay,","poem":1},{"lineBreak":true},{"text":"babangoañe i rova ­nitsi­tsike ondatiy;","poem":1},{"lineBreak":true},{"text":"fa lakato nainai’e ty haboa","poem":1},{"lineBreak":true},{"text":"naho ty fijilovañ’abo","poem":1},{"lineBreak":true},{"text":"fa fitsamboañam-birike lý","poem":1},{"lineBreak":true},{"text":"naho fiandraza’ o lia-raikeo","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ampara’ te adoañe amantika","poem":1},{"lineBreak":true},{"text":"ty Arofo boak’ añ’abo,","poem":1},{"lineBreak":true},{"text":"ie ho tete-­kobokara ty ratraratra,","poem":1},{"lineBreak":true},{"text":"vaho atao ty hoe ala ty tonda vokatse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Himoneñe am-patrambey ao","poem":1},{"lineBreak":true},{"text":"amy zao ty hatò,","poem":1},{"lineBreak":true},{"text":"vaho hañialo an-tonda kobokara ao","poem":1},{"lineBreak":true},{"text":"ty havantañañe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hamokatse fierañerañañe","poem":1},{"lineBreak":true},{"text":"ty havañonañe,","poem":1},{"lineBreak":true},{"text":"hahatoly fianjiñañe naho fatokisañe","poem":1},{"lineBreak":true},{"text":"nainai’e ty hamarentane.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hitoboke","poem":1},{"lineBreak":true},{"text":"añ’akibam-pañanintsiñe ondatikoo,","poem":1},{"lineBreak":true},{"text":"naho am-pipaliran-tsoa,","poem":1},{"lineBreak":true},{"text":"vaho am-pitofàñe mipendreñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Manahake te mihotrake","poem":1},{"lineBreak":true},{"text":"ty amy havandray i alay;","poem":1},{"lineBreak":true},{"text":"t’ie harèke ambane i rovay.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Haha nahareo mpitongy","poem":1},{"lineBreak":true},{"text":"añ’olon-drano iabio,","poem":1},{"lineBreak":true},{"text":"o mampidada ty tombo’ o añombeo","poem":1},{"lineBreak":true},{"text":"naho o borìkeo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}