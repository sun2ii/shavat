{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe ama’o ty mpandrotsake,","poem":1},{"lineBreak":true},{"text":"ihe tsy rinotsake;","poem":1},{"lineBreak":true},{"text":"ty mpamañahy, ihe tsy nifañahieñey!","poem":1},{"lineBreak":true},{"text":"ie migadoñe ty fikopaha’o,","poem":1},{"lineBreak":true},{"text":"le ho kopaheñe,","poem":1},{"lineBreak":true},{"text":"ie itroara’o o famañahia’oo,","poem":1},{"lineBreak":true},{"text":"le ho fañahieñe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O ry Iehovà, toloro arofo zahay;","poem":1},{"lineBreak":true},{"text":"fa mandiñe Azo;","poem":1},{"lineBreak":true},{"text":"ehe te Ihe ho fità’ iareo boa’ maraiñe,","poem":1},{"lineBreak":true},{"text":"naho ty fandrombahañe anay","poem":1},{"lineBreak":true},{"text":"an-tsan-koheke.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mampitriban-day ondatio","poem":1},{"lineBreak":true},{"text":"i feon-koràkey;","poem":1},{"lineBreak":true},{"text":"mibaibay o fifeheañeo ami’ty fiongaha’o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ahoro’e ty kinopa’areo","poem":1},{"lineBreak":true},{"text":"manahake ty añoroña’ ty beañe;","poem":1},{"lineBreak":true},{"text":"hoe fifamorohotan-kijeja","poem":1},{"lineBreak":true},{"text":"ty ifamorohota'iareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onjoneñe t’Iehovà","poem":1},{"lineBreak":true},{"text":"an-tiotiots' añe ty fimoneña’e;","poem":1},{"lineBreak":true},{"text":"fa natsafe'e hatò naho","poem":1},{"lineBreak":true},{"text":"havantanañe t’i Tsione.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie ty hampijadoñe o tao’oo","poem":1},{"lineBreak":true},{"text":"an-kakaliforam-pandrombahañe;","poem":1},{"lineBreak":true},{"text":"ty hihitse naho ty hilala","poem":1},{"lineBreak":true},{"text":"vaho ty fañeveñañe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ro toe vara’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Inao! mangoihoy an-tameañe ey","poem":1},{"lineBreak":true},{"text":"ty lahitsiai’ iareo,","poem":1},{"lineBreak":true},{"text":"mangololoike o sorotàm-pañanintsiñeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vahiny o lalañeo tsy amam-pañavelo,","poem":1},{"lineBreak":true},{"text":"nifotera’e i fañinay,","poem":1},{"lineBreak":true},{"text":"tsinambolitio’e o rovao,","poem":1},{"lineBreak":true},{"text":"tsy haoñe’e ondatio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mandala o taneo vaho miforejeje;","poem":1},{"lineBreak":true},{"text":"salatse ty Lebanone, miheatse;","poem":1},{"lineBreak":true},{"text":"hoe fatran-tane ty Sarone","poem":1},{"noteId":141},{"lineBreak":true},{"text":"mihintsam-boa ty Karmele","poem":1},{"noteId":142},{"lineBreak":true},{"text":"naho i Basane","poem":1},{"noteId":143},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hiongake amy zao iraho, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"honjonen-dRaho henaneo,","poem":1},{"lineBreak":true},{"text":"ho rengen-dRaho henane zao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mampiareñe kafo’e nahareo,","poem":1},{"lineBreak":true},{"text":"hisamake forompotse;","poem":1},{"lineBreak":true},{"text":"hamorototo anahareo hoe afo","poem":1},{"lineBreak":true},{"text":"ty kofò’areo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho tomomoheñe hoe sokày ondatio,","poem":1},{"lineBreak":true},{"text":"hoe fatike finira, nitomontoñe añ’afo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mijanjiña ry an-tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"ino o nanoekoo?","poem":1},{"lineBreak":true},{"text":"Ry marine eo, iantofo o haozarakoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mirevendreveñe o mpanan-kakeo","poem":1},{"lineBreak":true},{"text":"e Tsioneo","poem":1},{"lineBreak":true},{"text":"fihine’ ty fihitikitike ty tsy aman-Kake.","poem":1},{"lineBreak":true},{"text":"ia aman-tika ty hahafitoboke","poem":1},{"lineBreak":true},{"text":"amo afo mamorototoo,","poem":1},{"lineBreak":true},{"text":"ia aman-tika ty hahafimoneñe","poem":1},{"lineBreak":true},{"text":"amo afo manòba nainai’eo?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I mpañavelo an-kavantañañe,","poem":1},{"lineBreak":true},{"text":"naho misaontsy an-kavañonañey;","poem":1},{"lineBreak":true},{"text":"ie tsy mañaoñe ty varam-pikatramoañe,","poem":1},{"lineBreak":true},{"text":"i mañelahela fitàñe","poem":1},{"lineBreak":true},{"text":"tsy handrambesa’e vokàñey,","poem":1},{"lineBreak":true},{"text":"ty manjenjen-dravembia tsy ho janjiña’e","poem":1},{"lineBreak":true},{"text":"ze o fampiorihan-dio zao,","poem":1},{"lineBreak":true},{"text":"ie mikipe fihaino tsy hahaisaha’e","poem":1},{"lineBreak":true},{"text":"ty raty.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Himoneñe an-kaboañe ey re,","poem":1},{"lineBreak":true},{"text":"kijolim-bato ty ho fipalira’e,","poem":1},{"lineBreak":true},{"text":"hazotso ama’e ty mahakama’e,","poem":1},{"lineBreak":true},{"text":"tsy hisike ty rano’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ho isam-pihaino’o ami’ty","poem":1},{"lineBreak":true},{"text":"hatsomerentsere’e i mpanjakay;","poem":1},{"lineBreak":true},{"text":"ho oni’ iareo ty tane mitakatse añe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hañerehere ty tro’o ty fangebahebahañe:","poem":1},{"lineBreak":true},{"text":"Aia i mpamoliliy, aia i mpandanjay?","poem":1},{"lineBreak":true},{"text":"Aia i mpañiake o fitalakesañ’abooy?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy ho isa’o ka ondaty mangosasàkeo;","poem":1},{"lineBreak":true},{"text":"ondaty aman-tsaontsy","poem":1},{"lineBreak":true},{"text":"miheotse tsy fohiñeo,","poem":1},{"lineBreak":true},{"text":"o amam-pameleke mibedobedo","poem":1},{"lineBreak":true},{"text":"tsy rendre’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vazohò t’i Tsione,","poem":1},{"lineBreak":true},{"text":"i rovam-pamantaña-masin-tikañey;","poem":1},{"lineBreak":true},{"text":"ho isam-pihaino’o te fimoneñañe","poem":1},{"lineBreak":true},{"text":"mierañerañe t’Ierosalaime,","poem":1},{"lineBreak":true},{"text":"kijoly tsy hahoroñe,","poem":1},{"lineBreak":true},{"text":"amam-pàntake tsy hombotañe,","poem":1},{"lineBreak":true},{"text":"aman-taly tsy ho tampaheñe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hindre aman-tikañe ami’ty volonahe’e, t’Iehovà,","poem":1},{"lineBreak":true},{"text":"an-toetse amañ’oñe","poem":1},{"lineBreak":true},{"text":"naho torahañe mibànatse;","poem":1},{"lineBreak":true},{"text":"tsy handenà’ ty lakañ’ am-pivey,","poem":1},{"lineBreak":true},{"text":"tsy ho rangaen-tsambo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Toe mpizakan-tika t’Iehovà","poem":1},{"lineBreak":true},{"text":"Mpandily antika t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Mpanjakan-tika t’Iehovà;","poem":1},{"lineBreak":true},{"text":"Ie ty handrombake an-tika.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fa migebañe o talin-tsambo’oo,","poem":1},{"lineBreak":true},{"text":"tsy mitàñe i fahan-daiy,","poem":1},{"lineBreak":true},{"text":"tsy mamela-day;","poem":1},{"lineBreak":true},{"text":"Akore ty habei’ o kinopake zaraeñeo","poem":1},{"lineBreak":true},{"text":"kanao andivañe amo kepekeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tsy hanao ty hoe ty mpitoboke ao:","poem":1},{"lineBreak":true},{"text":"Siloke iraho;","poem":1},{"lineBreak":true},{"text":"Hafahan-kakeo ondaty mimoneñe aoo.","poem":1}]}],"footnotes":[{"noteId":141,"caller":"+","text":"Sarone: ty monto’e; ty sabo’e","reference":{"chapter":33,"verse":9}},{"noteId":142,"caller":"+","text":"Karmele: añondry vosy; fitatahañe;","reference":{"chapter":33,"verse":9}},{"noteId":143,"caller":"+","text":"Basane: ami’ty nife; ndra aman-tsifa","reference":{"chapter":33,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}