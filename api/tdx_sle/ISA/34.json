{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"Mitotoha hijanjiñe ry fifeheañeo, mitsendreña ry ondatio!","poem":1},{"lineBreak":true},{"text":"Mitsanoña ry tane, naho ze halifora’e;","poem":1},{"lineBreak":true},{"text":"ty voatse toy naho ze hene aboa’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iforoforoa’ Iehovà o fifeheañeo","poem":1},{"noteId":144},{"text":",","poem":1},{"lineBreak":true},{"text":"ifomboa’e iaby o lahindefo’eo;","poem":1},{"lineBreak":true},{"text":"fa zinama’e iereo,","poem":1},{"lineBreak":true},{"text":"nasese’e ho mongoreñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Havokovoko alafe ao o vinono am’iareoo,","poem":1},{"lineBreak":true},{"text":"hakare’ o loloo ty fañati-fofo’e,","poem":1},{"lineBreak":true},{"text":"hidoandoañe amo vohitseo ty lio’ iareo,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ho momoke i valobohòn-dindiñey,","poem":1},{"lineBreak":true},{"text":"le hapeleke hoe","poem":1},{"noteId":145},{"text":"tihy o likerañeo;","poem":1},{"lineBreak":true},{"text":"hene hihintsañe ty fifamorohota’ iareo manahake ty fiforejejen-dravem-bahe,","poem":1},{"lineBreak":true},{"text":"vaho i miheatse an-tsakoañey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa àtsa-dio andikerañe ao ty fibarako, hehe t’ie mizotso mb’ Edome mb’eo henaneo hizaka,","poem":1},{"lineBreak":true},{"text":"mb’am’ondaty nafàko harotsakeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Etsa-dio ty fibara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"nampivondrahen-tsolike,","poem":1},{"lineBreak":true},{"text":"ami’ty lio’ o añondrio naho o oseo,","poem":1},{"lineBreak":true},{"text":"ami’ty safom-boan-kobatroke;","poem":1},{"lineBreak":true},{"text":"fa manañe fisoroñañe e Botsrà añe","poem":1},{"lineBreak":true},{"text":"t’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho fanjamanañe an-tane Edome ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hindre ama’e hizotso o ndrimoo,","poem":1},{"lineBreak":true},{"text":"o baniao rekets’ o maozatseo;","poem":1},{"lineBreak":true},{"text":"le ho kotsa-dio ty tane’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho ho bobohen-tsolike ty debo’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa aman’andro hamalea’e t’Iehovà,","poem":1},{"lineBreak":true},{"text":"taoñe hañondroha’e i Tsione.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hovaeñe ho lokotara o toraha’eo,","poem":1},{"lineBreak":true},{"text":"ho solifara o lembo’eo;","poem":1},{"lineBreak":true},{"text":"hene hifotetse ho lokotara milebaleba","poem":1},{"lineBreak":true},{"text":"o tane’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy hakipeke handro ndra haleñe, hitolom-­pionjoñe avao ty hatoe’e;","poem":1},{"lineBreak":true},{"text":"ho kòake an-tariratse an-tariratse,","poem":1},{"lineBreak":true},{"text":"tsy hirangañe nainai’e donia.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho fanañan-tangongo","poem":1},{"lineBreak":true},{"text":"naho sama ty ao,","poem":1},{"lineBreak":true},{"text":"ho fimoneñam-borondolo naho koàke, ho vavare’e ama’e ty talin-kakoahañe","poem":1},{"lineBreak":true},{"text":"naho ty talim-polò hakapaihañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O roandria’eo, tsy eo ty ho kanjieñe","poem":1},{"lineBreak":true},{"text":"ho mpanjaka;","poem":1},{"lineBreak":true},{"text":"kila ho mongotse o ana-dona’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fatike ty hitiry amo fijilova’e fatratseo, hìsatse naho ropiteke amo kijoli’eo;","poem":1},{"lineBreak":true},{"text":"ho fitoboha’ o fanalokeo,","poem":1},{"lineBreak":true},{"text":"naho ty fanozora’ o voron-tsatrañeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho fikaoña’ ty farasy naho ty fanaloke, hikoike o hamaroa’eo ty ose-lý;","poem":1},{"lineBreak":true},{"text":"Eka, hitoboke ao ty voron-dolo,","poem":1},{"lineBreak":true},{"text":"ho tendreke ao ty fitofa’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hamboare’ i lapetakey ty traño’e","poem":1},{"lineBreak":true},{"text":"naho hifana ao, naho hamoy,","poem":1},{"lineBreak":true},{"text":"vaho hatonto’e ambane’ talinjo’eo,","poem":1},{"lineBreak":true},{"text":"hifamory ao ty vantio,","poem":1},{"lineBreak":true},{"text":"songa amam-bali’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kodebeo ty boke’ Iehovà, le vakio:","poem":1},{"lineBreak":true},{"text":"tsy am’iereo ty ho motso,","poem":1},{"lineBreak":true},{"text":"sindre ho amam-bali’e;","poem":1},{"lineBreak":true},{"text":"i falie’ey ty nandily,","poem":1},{"lineBreak":true},{"text":"le i arofo’ey ty nanontoñe iareo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Niazo’e an-tsapake iareo,","poem":1},{"lineBreak":true},{"text":"le zinaram-pità’e am’iereo an-taly","poem":1},{"lineBreak":true},{"text":"o anjara’eo;","poem":1},{"lineBreak":true},{"text":"ho fanaña’ iareo nainai’e,","poem":1},{"lineBreak":true},{"text":"tariratse an-tariratse","poem":1},{"lineBreak":true},{"text":"ty fimoneña’ iareo.","poem":1}]}],"footnotes":[{"noteId":144,"caller":"+","text":"Iir 30:11","reference":{"chapter":34,"verse":2}},{"noteId":145,"caller":"+","text":"Heb: boke-peleke","reference":{"chapter":34,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}