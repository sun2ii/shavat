{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"Hifale ty ratraratra naho ty paipaiñe, hirebeke i vavataney,","poem":1},{"lineBreak":true},{"text":"vaho hitaroke hoe dokonose;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Handrevake re vaho hirañaraña","poem":1},{"lineBreak":true},{"text":"an-drebeke naho sabo;","poem":1},{"lineBreak":true},{"text":"hatolots’aze ty enge’ i Lebanone,","poem":1},{"lineBreak":true},{"text":"ty hafanjàka’ i Karmele naho i Sarone; hahaisake ty enge’ Iehovà iereo,","poem":1},{"lineBreak":true},{"text":"ty volonahen’ Añaharen-tika.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haozaro o fitàn-kengeo","poem":1},{"lineBreak":true},{"text":"le hafatraro o ongotse mikoletrao,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ano ty hoe o embetse an-trokeo: Manintsiña, ko hembañe!","poem":1},{"lineBreak":true},{"text":"hehe te ho avy t’i Andrianañahare’ areo, aman-tambe naho famalean’ Añahare handrombake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le hibeake ty fihaino’ o goao","poem":1},{"lineBreak":true},{"text":"naho ho sokafeñe ty ravembia’ o gìñeo;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hitsamboañe hoe hirañe ty kepeke","poem":1},{"lineBreak":true},{"text":"vaho hisabo an-kaehake ty famele’ o moañeo; higoangoañan-drano ty fatrambey naho ty torahañe am-bavatane eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hifotetse ho antara ty tane maike,","poem":1},{"lineBreak":true},{"text":"naho rano manganahana o paipaiñeo,","poem":1},{"lineBreak":true},{"text":"hitiria’ ty vinda o korontsom-panalokeo, vaho handimbe o ahetseo","poem":1},{"lineBreak":true},{"text":"ty tongoahara naho ty sale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho eo ty lalan-gadagadañe,","poem":1},{"lineBreak":true},{"text":"ty fañaveloañe hatao ty hoe","poem":1},{"lineBreak":true},{"text":"ty Lala-Piavahañe","poem":1},{"noteId":146},{"text":",","poem":1},{"lineBreak":true},{"text":"tsy homb’ama’e ty tsy malio;","poem":1},{"lineBreak":true},{"text":"ie ho amo mpañavelo amy lalañey,","poem":1},{"lineBreak":true},{"text":"vaho tsy hihezeñe aze ty dagola.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho ama’e ty liona,","poem":1},{"lineBreak":true},{"text":"tsy hanganike ama’e ty biby romotse;","poem":1},{"lineBreak":true},{"text":"tsy ho zoeñe ao iereo,","poem":1},{"lineBreak":true},{"text":"fa ho fañaveloa’ o jinebañeo","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"le himpoly o vinili’ Iehovào,","poem":1},{"lineBreak":true},{"text":"hipoña-tsabo mb’e Tsione mb’eo;","poem":1},{"lineBreak":true},{"text":"naho hafaleañe tsy modo ty ho añ’ambone’ iareo ;","poem":1},{"lineBreak":true},{"text":"Hitendreke firebehañe naho haravoañe vaho hihelañe añe ty hontoke","poem":1},{"lineBreak":true},{"text":"naho ty fiselekaiñañe.","poem":1}]}],"footnotes":[{"noteId":146,"caller":"+","text":"Sab 77:13","reference":{"chapter":35,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}