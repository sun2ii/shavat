{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":["Ie amy andro rezay, natindry fa heta’e t’Iekizkia; le nimb’ama’e mb’eo t’Iesaià ana’ i Amotse, nanao ty hoe: Hoe t’Iehovà: Hajario ty an­jomba’o fa toe hivetrake, tsy ho veloñe."]},{"type":"verse","number":2,"content":["Nampitolihe’ Iekizkia mb’ an-drindriñe ty lahara’e vaho nihalaly am’ Iehovà,"]},{"type":"verse","number":3,"content":["ty hoe: Mihalaly ama’o, ry Iehovà, tiahio henaneo ty fandenàko añatrefa’o an-kavantañañe naho an-kaliforan-troke, vaho nanao ze mahity am-pahaoniña’o; aa ie nangololoike ty rovetse,"]},{"type":"verse","number":4,"content":["nivo­trak’ am’ Iesaià ty tsara’ Iehovà nanao ty hoe:"]},{"type":"verse","number":5,"content":["Akia saontsio am’ Iekizkia ty hoe: Hoe t’Iehovà, Andrianañaharen-drae’o Davide. Fa jinanjiko i halali’oy, nitreako o ranom-pihaino’oo; ingo ho tovoñako taoñe folo lim’ amby o andro’oo."]},{"type":"verse","number":6,"content":["Ho hahako am-pitàm-panjaka’ i Asore irehe naho ty rova toy vaho harovako ty rova toy;"]},{"type":"verse","number":7,"content":["le zao ty ho viloñe ama’o boak’am’ Iehovà, te ho henefa’ Iehovà i raha tsinara’ey:"]},{"type":"verse","number":8,"content":["Heheke te hampibaliheko soritse folo amo soritse fa nilia’eo ty talinjom-panondro-andro’ i Akhaze. Aa le nibalik’ amy soritse folo fa nomba’ey i àndroy."]},{"type":"verse","number":9,"content":["Inao ty sinoki’ Iekizkia mpanjaka’ Iehodà, t’ie natindry an-tihy vaho nijangañe amy arete’ey."]},{"type":"verse","number":10,"content":[{"text":"Hoe iraho: Ami’ty tsipinde-mena’","poem":1},{"lineBreak":true},{"text":"o androkoo ty ijoñako","poem":1},{"lineBreak":true},{"text":"an-dalambein-tsikeokeoke eo;","poem":1},{"lineBreak":true},{"text":"kinalañ’ amako o andro tsy nirikoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe iraho: tsy ho treako t’Ià,","poem":1},{"lineBreak":true},{"text":"Eka, Ià an-tane’ o veloñeo;","poem":1},{"lineBreak":true},{"text":"tsy ho isako ka t’indaty mindre amo mpimone’ ty tane toio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nombotañe vaho nasitake amako","poem":1},{"lineBreak":true},{"text":"hoe kibohom-piarak’ añondry ty kijàko;","poem":1},{"lineBreak":true},{"text":"nahoronkoroñe hoe te asam-panenoñe ty fiaiko:","poem":1},{"lineBreak":true},{"text":"tinampa’e amy tenoñey iraho,","poem":1},{"lineBreak":true},{"text":"handro an-kaleñe","poem":1},{"lineBreak":true},{"text":"ty hamongora’o ty fiaiko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nifeahako pak’ami’ty maraiñe,","poem":1},{"lineBreak":true},{"text":"manahake ty liona,","poem":1},{"lineBreak":true},{"text":"fe mbe nipozapozake iaby o taolakoo, añivo ty handro naho ty haleñe","poem":1},{"lineBreak":true},{"text":"ty nampigadoña’o ahy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mikora hoe tivoke naho aliotse iraho;","poem":1},{"lineBreak":true},{"text":"mikò hoe deho;","poem":1},{"lineBreak":true},{"text":"nimokore’ ty fiandrandràko o masokoo.","poem":1},{"lineBreak":true},{"text":"O ry Iehovà, voatindry iraho,","poem":1},{"lineBreak":true},{"text":"Ihe abey ro tsoako.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ino ty ho volañeko? Nametse amako","poem":1},{"lineBreak":true},{"text":"re mbore nanoe’e;","poem":1},{"lineBreak":true},{"text":"hiezañe amo hene androkoo iraho,","poem":1},{"lineBreak":true},{"text":"ami’ty hafairam-piaiko.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O Talè, irezay o mahajangañe ondatio,","poem":1},{"lineBreak":true},{"text":"mampanintsiñe ty troko irehe;","poem":1},{"lineBreak":true},{"text":"vaho mameloñ’ ahy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy nanjo fañanintsin-draho","poem":1},{"lineBreak":true},{"text":"te mone haaferon’ aiko;","poem":1},{"lineBreak":true},{"text":"fe o fikokoa’o ahikoo","poem":1},{"lineBreak":true},{"text":"ro nañaha’o ahy","poem":1},{"lineBreak":true},{"text":"amy kobon-kamodoañey;","poem":1},{"lineBreak":true},{"text":"vaho fonga nahifi’o amboho’o ao","poem":1},{"lineBreak":true},{"text":"o hakeokoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy mahafandrenge Azo","poem":1},{"lineBreak":true},{"text":"ty tsikeokeoke,","poem":1},{"lineBreak":true},{"text":"tsy hañonjoñe azo ty havilasy;","poem":1},{"lineBreak":true},{"text":"tsy mahafitamà ty figahiña’o","poem":1},{"lineBreak":true},{"text":"ty migodañe mb’an-koak’ ao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O veloñeo, o veloñeo,","poem":1},{"lineBreak":true},{"text":"ie ro mandrenge Azoo,","poem":1},{"lineBreak":true},{"text":"manahake ty anoeko henaneo;","poem":1},{"lineBreak":true},{"text":"ampandrendrehen-drae amo keleia’eo","poem":1},{"lineBreak":true},{"text":"ty figahiña’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Handrombak’ ahy t’Iehovà;","poem":1},{"lineBreak":true},{"text":"le hititiha’ay ami’ty marovany añ’anjomba’ Iehovà ao o sabokoo,","poem":1},{"lineBreak":true},{"text":"amo hene andro hiveloma’aio.","poem":1}]},{"type":"verse","number":21,"content":["Fa hoe ty natao’ Iesaià: Ampangalao garaton-tsakoa hapakotse amy honay himeara’e."]},{"type":"verse","number":22,"content":["Nanao ty hoe ka t’Iekizkia: Ino ty viloñe hampionjoñ’ ahy mb’ añ’ anjomba’ Iehovà mb’eo?"]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}