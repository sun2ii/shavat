1},{"lineBreak":true},{"text":"ze honka’e am’ Ierosalaime ao,","poem":1},{"lineBreak":true},{"text":"eka, ze hene sinokitse ho veloñe","poem":1},{"lineBreak":true},{"text":"e Ierosalaime ao,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ie fa sinasa’ i Talè","poem":1},{"lineBreak":true},{"text":"amo anak’ampela’ Israeleo","poem":1},{"lineBreak":true},{"text":"ty haleora’e;","poem":1},{"lineBreak":true},{"text":"naho fa nimongore’e ty lio’","poem":1},{"lineBreak":true},{"text":"Ierosalaime boak’ añ’ate’e ao","poem":1},{"lineBreak":true},{"text":"ami’ty arofon-jaka naho","poem":1},{"lineBreak":true},{"text":"ami’ty arofom-piforehetañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le hanoe’ Iehovà ambone’","poem":1},{"lineBreak":true},{"text":"ze akiba ambohi’ i Tsione eo naho","poem":1},{"lineBreak":true},{"text":"ambone’ o firimboña’eo ty rahoñe","poem":1},{"lineBreak":true},{"text":"an-katoeñe te handro,","poem":1},{"lineBreak":true},{"text":"vaho ty fireandreañ’ afo milebaleba te haleñe;","poem":1},{"lineBreak":true},{"text":"le ho ey ty lafike","poem":1},{"noteId":19},{"text":"ambone’ o engeñe iabio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le ho eo ka ty bandrabandra naho antoandro amy hatrevohañey,","poem":1},{"lineBreak":true},{"text":"naho fipalirañe vaho fitampinañe","poem":1},{"lineBreak":true},{"text":"ami’ty tio-bey naho amo orañeo.","poem":1}]}],"footnotes":[{"noteId":18,"caller":"+","text":"Ioe 3:5, Oba 1:17","reference":{"chapter":4,"verse":2}},{"noteId":19,"caller":"+","text":"Heb: Hopa: fialofa’e naho i engavao’ey","reference":{"chapter":4,"verse":5}}]},"thisChapterLink":"/api/tdx_sle/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}