{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"Hohò, Hohò, ondatikoo,","poem":1},{"lineBreak":true},{"text":"hoe t’i Andrianañahare’ areo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Saontsio fañohòañe t’Ierosalaime,","poem":1},{"lineBreak":true},{"text":"vaho koiho ama’e te fa heneke ty ali’e","poem":1},{"noteId":169},{"text":";","poem":1},{"lineBreak":true},{"text":"te jinebañe o hakeo’eo,","poem":1},{"lineBreak":true},{"text":"amy t’ie nandrambe indroe","poem":1},{"lineBreak":true},{"text":"am-pitàn’ Añahare","poem":1},{"lineBreak":true},{"text":"ho vale’ o hene tahi’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Inao ty fiarañanañañe mikoike :","poem":1},{"lineBreak":true},{"text":"Anataho lalañe am-patrambey añe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Ampimirao lalambey an-dratraratra","poem":1},{"lineBreak":true},{"text":"añe t’i Andrianañahare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Haonjoñe iaby ze atao goledoñe,","poem":1},{"lineBreak":true},{"text":"naho haketrake iaby o tambohoo","poem":1},{"lineBreak":true},{"text":"ho vàñeñe ze manongatonga,","poem":1},{"lineBreak":true},{"text":"naho hampimiraeñe ze migodeogodeoñe;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"le haboake ty enge’ Iehovà, vaho hiharo handrendrek’ aze","poem":1},{"lineBreak":true},{"text":"ze atao nofotse, izay ty nitsaram-palie’ Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inao ty fiarañanañañe manao ty hoe: Koiho, le hoe ty natoi’e:","poem":1},{"lineBreak":true},{"text":"Ino ty ho koiheko?","poem":1},{"lineBreak":true},{"text":"Ahetse iaby ze atao nofotse,","poem":1},{"lineBreak":true},{"text":"le hoe voñe an-teteke ao ty hasoa’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Miheatse o ahetseo,","poem":1},{"lineBreak":true},{"text":"mihintsañe o voñe’eo,","poem":1},{"lineBreak":true},{"text":"kanao tiofe’ ty kofòn’ Añahare, toe ahetse ondatio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miheatse o ahetseo,","poem":1},{"lineBreak":true},{"text":"mihintsañe o voñe’eo,","poem":1},{"lineBreak":true},{"text":"fe mijadoñe nainai’e","poem":1},{"noteId":170},{"lineBreak":true},{"text":"ty tsaran’ Añaharen-tikañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O ry Tsione mpitaroñe entan-tsoao","poem":1},{"lineBreak":true},{"text":"mañambonea vohitse abo;","poem":1},{"lineBreak":true},{"text":"ry Ierosalaime mpanese talily soao","poem":1},{"lineBreak":true},{"text":"poñafo an-koike ty fiarañanaña’o, aonjono, le ko hembañe;","poem":1},{"lineBreak":true},{"text":"saontsio ty hoe o rova’ Iehodào :","poem":1},{"lineBreak":true},{"text":"Ingo t’i Andrianañahare’ areo !","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hehe, te hitotsak’ an-kaozarañe","poem":1},{"lineBreak":true},{"text":"t’i Talè Iehovà; hifehe am-pità’e;","poem":1},{"lineBreak":true},{"text":"Ingo, te ama’e i tambe’ey, añatrefa’e o vale-soa’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Manahake ty mpiarake","poem":1},{"lineBreak":true},{"text":"miandrazañe i mpirai-lia’ey naho","poem":1},{"lineBreak":true},{"text":"manontontoñe o vik’añondri’eo am-pità’e","poem":1},{"lineBreak":true},{"text":"ie otroñe’e añ’araña’e eo, vaho manehak’ ty mampinono mora mb’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ia ty nanovy o ranoo an-dela-pità’e,","poem":1},{"lineBreak":true},{"text":"naho nanjehe i likerañey an-kiho’e,","poem":1},{"lineBreak":true},{"text":"naho nañiake ty debo’ ty tane toy","poem":1},{"lineBreak":true},{"text":"am-pañaranañe,","poem":1},{"lineBreak":true},{"text":"naho nandanja o vohitseo","poem":1},{"lineBreak":true},{"text":"am-pandanjàñe,","poem":1},{"lineBreak":true},{"text":"vaho o tambohoo am-balantsy?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ia ty nanoro i Arofo’ Iehovà,","poem":1},{"lineBreak":true},{"text":"he ia ty mpañana’e mañòk’ aze?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ia ty niharoa’e safiry,","poem":1},{"lineBreak":true},{"text":"ia ty nampahafohiñe aze,","poem":1},{"lineBreak":true},{"text":"ia ty nanoro aze i lalam-bantañey,","poem":1},{"lineBreak":true},{"text":"naho nampandrendreke aze ty hilala","poem":1},{"lineBreak":true},{"text":"vaho nañòke aze i oloñolon-kihitsey?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Toe tsopake an-tsajoa ao","poem":1},{"lineBreak":true},{"text":"ze kilakila ondaty,","poem":1},{"lineBreak":true},{"text":"iaheñe hoe deboke","poem":1},{"lineBreak":true},{"text":"am-pingam-balantsy,","poem":1},{"lineBreak":true},{"text":"vaho lanjaeñe hoe lemboke o tokonoseo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsy ampe horoañe ty Lebanone,","poem":1},{"lineBreak":true},{"text":"tsy mahaenen-­kisoroñañe o bibi’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hoe hakoahañe añatrefa’e","poem":1},{"lineBreak":true},{"text":"o fifeheañ’ iabio, volilien-ko tsy vente’e, ie ambane’ ty hatao kapaike.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hirinkiriñe’o ama’ ia arè","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare?","poem":1},{"lineBreak":true},{"text":"vintan’ inoñe ty hampanahafe’o ama’e?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hera i saren-draha natrana’ i mpitseney,","poem":1},{"lineBreak":true},{"text":"naho nipakora’ i mpanefe-volamenay","poem":1},{"lineBreak":true},{"text":"volamena,","poem":1},{"lineBreak":true},{"text":"vaho nandranjia’ i mpanefe-volafotiy","poem":1},{"lineBreak":true},{"text":"silisily volafoty?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le eo ty rarake tsy mahalefe enga,","poem":1},{"lineBreak":true},{"text":"joboñe’e ty hatae tsy ho momoke;","poem":1},{"lineBreak":true},{"text":"paiae’e ty mpandranjy mahimbañe handranjy ­saren-draha tsy hitroetroe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy fohi’o hao? Tsy jinanji’o hao? Tsy natalily ama’o am-pifotora’e añe hao?","poem":1},{"lineBreak":true},{"text":"Tsy nirendre’o hao","poem":1},{"lineBreak":true},{"text":"o manànta’ ty tane toio?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie ty miambesatse ambone’ ty","poem":1},{"lineBreak":true},{"text":"fibontolia’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"o mpimone’eo ro manahake kijeja;","poem":1},{"lineBreak":true},{"text":"Ie ty mandamake o likerañeo","poem":1},{"lineBreak":true},{"text":"hoe lamba fañefetse,","poem":1},{"lineBreak":true},{"text":"vaho mamelatse iereo","poem":1},{"lineBreak":true},{"text":"hoe kivohom-pañialoañe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ie ty mamotsake roandriañe ho hakoahañe, naho ampinjarie’e ho tsy vente’e o mpizaka’ ty tane toio.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie vaho nitongisañe,","poem":1},{"lineBreak":true},{"text":"aniany te nararake;","poem":1},{"lineBreak":true},{"text":"le namahatse an-tane ao","poem":1},{"lineBreak":true},{"text":"o taho’eo;","poem":1},{"lineBreak":true},{"text":"vaho miheatse t’ie tiofe’e,","poem":1},{"lineBreak":true},{"text":"endese’ o tangololahio añe","poem":1},{"lineBreak":true},{"text":"hoe ahe-maike.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa le hampanahafe’ areo ama’ ia","poem":1},{"lineBreak":true},{"text":"te Izaho ro hambañe ama’e?","poem":1},{"lineBreak":true},{"text":"Hoe i Masiñey.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ampiandrandrao mb’añ’abo ey o fihaino’oo, mahaisaha: ia ty namboatse iareo?","poem":1},{"lineBreak":true},{"text":"I mañakatse ty havasiaña’ iareo","poem":1},{"lineBreak":true},{"text":"ami’ty ia’ey,","poem":1},{"lineBreak":true},{"text":"hene kanjie’e amy tahina’ey,","poem":1},{"lineBreak":true},{"text":"naho amy hara’elahin-kaozara’ey","poem":1},{"lineBreak":true},{"text":"vaho am-panjofahan-kafatrara’e,","poem":1},{"lineBreak":true},{"text":"leo raike tsy mikipe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ino ty atao’o ty hoe, O Iakobe,","poem":1},{"lineBreak":true},{"text":"naho saontsie’o ty hoe: Ry Israele,","poem":1},{"lineBreak":true},{"text":"Mietake am’ Iehovà ty liako,","poem":1},{"lineBreak":true},{"text":"tsy ahoan’ Añahareko o zokoo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mboe tsy fohi’o hao?","poem":1},{"lineBreak":true},{"text":"Tsy jinanji’o hao te tsy mitoirañe, tsy mokotse","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare nainai’e,","poem":1},{"lineBreak":true},{"text":"Iehovà Andrianamboatse o olon-taneo?","poem":1},{"lineBreak":true},{"text":"Tsy taka-tsikaraheñe o hilala’eo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ampaozare’e o midazidazìtseo;","poem":1},{"lineBreak":true},{"text":"vaho hafatrare’e o tsy maozatseo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ndra te toirañe","poem":1},{"lineBreak":true},{"text":"naho màmake o ajalahio,","poem":1},{"lineBreak":true},{"text":"vaho mikoletra ty fanalolahy;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ho vaoen-kaozarañe o mahaliñe Iehovào;","poem":1},{"lineBreak":true},{"text":"hionjoñe amañ’elatse hoe vantio;","poem":1},{"lineBreak":true},{"text":"hilay fa tsy ho vozake,","poem":1},{"lineBreak":true},{"text":"hinokitse fa tsy ho toirañe.","poem":1}]}],"footnotes":[{"noteId":169,"caller":"+","text":"ndra ty hoe: ty fiatran-draha’e","reference":{"chapter":40,"verse":2}},{"noteId":170,"caller":"+","text":"Pe I 1:24-25","reference":{"chapter":40,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}