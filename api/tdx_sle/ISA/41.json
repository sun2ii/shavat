{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Mianjiña, hijanjiña’ areo ahy,","poem":1},{"lineBreak":true},{"text":"ry tokonoseo,","poem":1},{"lineBreak":true},{"text":"ampaozareñe ondatio;","poem":1},{"lineBreak":true},{"text":"hañarinea’ iareo mb’etoy, hisaontsy;","poem":1},{"lineBreak":true},{"text":"Antao hototoke mb’eo hitsarañe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ia ty nampitsekake i boak’ atiñanañey","poem":1},{"lineBreak":true},{"text":"hitroara’e an-kavañonañe?","poem":1},{"lineBreak":true},{"text":"Ie apo’e aolo’e ey o kilakila ondatio naho ampiambanè’e o mpanjakao?","poem":1},{"lineBreak":true},{"text":"Idemohe’ i fibara’ey ho deboke, ahofahofa i fale’ey hoe t’ie kafo’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niheañe’e iereo, nirefe tsy an-joy;","poem":1},{"lineBreak":true},{"text":"an-dalañe mbe lia tsy niliam-pandia’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ia ty nitsakore vaho nahatafetetse?","poem":1},{"lineBreak":true},{"text":"Ie nikanjy o tarira­tseo am’baloha’e añe.","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà, ty valoha’e,","poem":1},{"lineBreak":true},{"text":"vaho ty fara’e, Ie iRaho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nañeveñe o tokonoseo te nahaoniñe; nihondrahondra o olon-taneo;","poem":1},{"lineBreak":true},{"text":"nitotoke iereo vaho nimb’atoy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mifañimba o mpifankarineo,","poem":1},{"lineBreak":true},{"text":"songa manao aman-drahalahi’e :","poem":1},{"lineBreak":true},{"text":"Mihaozara.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa le hafatrare’ i mpandranjiy","poem":1},{"lineBreak":true},{"text":"ty mpitsene volamena,","poem":1},{"lineBreak":true},{"text":"risihe’ i mpamañe añ’ana-batoy","poem":1},{"lineBreak":true},{"text":"i mipeke renem-batoy;","poem":1},{"lineBreak":true},{"text":"le ata’e ty hoe i fanodirañey:","poem":1},{"lineBreak":true},{"text":"Soa zao.","poem":1},{"lineBreak":true},{"text":"Rekete’e am-pati-by tsy hitroetroe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"F’ihe Israele, mpitoroko,","poem":1},{"lineBreak":true},{"text":"Iakobe jinoboko,","poem":1},{"lineBreak":true},{"text":"tirin’ Avrahame Rañeko;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie rinambeko añ’olo’ ty tane toy añe","poem":1},{"lineBreak":true},{"text":"naho nitoka azo an-tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"nanao ty hoe ama’o: Mpitoroko irehe,","poem":1},{"lineBreak":true},{"text":"jinoboko fa tsy nifarieko;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko hemban-drehe,","poem":1},{"lineBreak":true},{"text":"fa indrezako,","poem":1},{"lineBreak":true},{"text":"ko mijilojilo:","poem":1},{"lineBreak":true},{"text":"Izaho ro Andrianañahare’o;","poem":1},{"lineBreak":true},{"text":"le hampaozareko","poem":1},{"lineBreak":true},{"text":"toe hañimb’ azo iraho;","poem":1},{"lineBreak":true},{"text":"Eka, ho tohanako an-tañan-kavanan-","poem":1},{"lineBreak":true},{"text":"kavantàñako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe fonga ho salareñe naho aliheñe","poem":1},{"lineBreak":true},{"text":"ze navaivay ama’o;","poem":1},{"lineBreak":true},{"text":"harotsake o nañatreatre azoo,","poem":1},{"lineBreak":true},{"text":"hafotsake tsy ho vente’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho paia’o fa tsy ho isa’o","poem":1},{"lineBreak":true},{"text":"o nifañotokotok’ ama’oo;","poem":1},{"lineBreak":true},{"text":"ho hakoahañe o nialy ama’oo,","poem":1},{"lineBreak":true},{"text":"vata’e kòake.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amy te Izaho Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’o ty mikalañe","poem":1},{"lineBreak":true},{"text":"ty fità’o ankavana, hanoako ty hoe:","poem":1},{"lineBreak":true},{"text":"Ko mirevendreven-drehe,","poem":1},{"lineBreak":true},{"text":"Izaho ty hañolotse azo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ko hembañe ry oletse Iakobe,","poem":1},{"lineBreak":true},{"text":"ry ondati’ Israeleo, fa holoreko,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà Mpijebañe azo,","poem":1},{"lineBreak":true},{"text":"i Masi’ Israeley.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ingo rinanjiko ho fandisañan-drehe,","poem":1},{"lineBreak":true},{"text":"reketse nife masioñe;","poem":1},{"lineBreak":true},{"text":"ho lisane’o o vohitseo, ho demohe’o,","poem":1},{"lineBreak":true},{"text":"vaho hanoe’o kafo o tambohoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho tsongae’o,","poem":1},{"lineBreak":true},{"text":"le hahofa’ i tiokey mb’eo,","poem":1},{"lineBreak":true},{"text":"naho haboele’ i tangololahiy;","poem":1},{"lineBreak":true},{"text":"naho hirebeha’o ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"handia-taroba amy Masi’ Israeley.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mipay rano o rarakeo naho o poi’eo,","poem":1},{"lineBreak":true},{"text":"fe tsy eo,","poem":1},{"lineBreak":true},{"text":"kantañe an-karan-drano’e","poem":1},{"lineBreak":true},{"text":"ty famele’ iareo;","poem":1},{"lineBreak":true},{"text":"izaho Iehovà ty hanoiñe iareo,","poem":1},{"lineBreak":true},{"text":"Tsy haforintseko;","poem":1},{"lineBreak":true},{"text":"izaho Andrianañahare’ Israele.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hanokafako torahañe","poem":1},{"lineBreak":true},{"text":"o haboan-diolioo,","poem":1},{"lineBreak":true},{"text":"naho rano manganahana","poem":1},{"lineBreak":true},{"text":"añivo’ o vavataneo;","poem":1},{"lineBreak":true},{"text":"hanoako sihanake lifo-drano","poem":1},{"lineBreak":true},{"text":"ty fatrambey","poem":1},{"lineBreak":true},{"text":"naho rano ­mipororoake o tane kankañeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hapoko an-dratraratra ao","poem":1},{"lineBreak":true},{"text":"ty mendorave","poem":1},{"noteId":171},{"text":"naho ty roy,","poem":1},{"lineBreak":true},{"text":"ty akao naho ty olive;","poem":1},{"lineBreak":true},{"text":"hadoko an-diolio ao ty sohihy","poem":1},{"noteId":172},{"text":",","poem":1},{"lineBreak":true},{"text":"reketse ty ­harandranto, vaho ty kobaiñe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Soa t’ie hahaisake naho haharendreke","poem":1},{"lineBreak":true},{"text":"hitsakore naho hitrao-kilala","poem":1},{"lineBreak":true},{"text":"te nanoem-pità’ Iehovà zao,","poem":1},{"lineBreak":true},{"text":"vaho tsinene’ i Masi’ Israeley.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aboaho ty enta’ areo, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"akaro ty filiera’ areo,","poem":1},{"lineBreak":true},{"text":"hoe t’i Mpanjaka’ Iakobe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ee t’ie hakare’areo,","poem":1},{"lineBreak":true},{"text":"hitsey ama’ay o hifetsakeo;","poem":1},{"lineBreak":true},{"text":"o raha taoloo, te inoñe?","poem":1},{"lineBreak":true},{"text":"Atalilio hitsakorea’ay,","poem":1},{"lineBreak":true},{"text":"hahafohina’ay ty figadoña’e;","poem":1},{"lineBreak":true},{"text":"he taroño ama’ay o raha ho avio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Itokio o raha mbe hiheo amy añeio,","poem":1},{"lineBreak":true},{"text":"hahafohina’ay t’ie ndrahare;","poem":1},{"lineBreak":true},{"text":"ke anò ty soa, he anò ty raty, hisamba’ay, hitraofa’ay fañeveñañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Toe tsy manjofake nahareo,","poem":1},{"lineBreak":true},{"text":"koake o sata’ areoo.","poem":1},{"lineBreak":true},{"text":"Avivivioke ty mifale ama’areo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa nitsekafeko i tavaratse añey,","poem":1},{"lineBreak":true},{"text":"le fa pok’eo,","poem":1},{"lineBreak":true},{"text":"boak’ am-panjiriha’ i àndroy añe;","poem":1},{"lineBreak":true},{"text":"ie hitoka ty añarako vaho","poem":1},{"lineBreak":true},{"text":"hivotrak’ amo mpifeheo hoe an-dietse,","poem":1},{"lineBreak":true},{"text":"manahake ty fandialiàm-panao","poem":1},{"lineBreak":true},{"text":"valàñe-tane i lietsey.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ia ty nitsey boak’ am-baloha’e","poem":1},{"lineBreak":true},{"text":"haharendreha’ay:","poem":1},{"lineBreak":true},{"text":"naho haehae añe,","poem":1},{"lineBreak":true},{"text":"hahavolaña’ay t’ie to?","poem":1},{"lineBreak":true},{"text":"Toe tsy amam-mpitaroñe,","poem":1},{"lineBreak":true},{"text":"eka, leo raike tsy mitalily,","poem":1},{"lineBreak":true},{"text":"toe tsy eo ty mahajanjiñe o lañona’oo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Izaho ty valoha’e nañitrik’ amy Tsione","poem":1},{"lineBreak":true},{"text":"ty hoe: Heheke, ingo iereo;","poem":1},{"lineBreak":true},{"text":"vaho hiraheko mb’e Ierosalaime mb’eo","poem":1},{"lineBreak":true},{"text":"ty hinday talily soa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mañente iraho, fe tsy ama’ ondaty;","poem":1},{"lineBreak":true},{"text":"naho tsy amam-pamere,","poem":1},{"lineBreak":true},{"text":"ie ho nañontaneako hahavalea’e.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Heheke fonga tsy vokatse, tsy jefa’e","poem":1},{"lineBreak":true},{"text":"o sata’ iareoo, toe tioke naho hakoahañe avao","poem":1},{"lineBreak":true},{"text":"o sare fatrana’ iareoo.","poem":1}]}],"footnotes":[{"noteId":171,"caller":"+","text":"Toe: “erez, sità, hadase,” “atese semene.”","reference":{"chapter":41,"verse":19}},{"noteId":172,"caller":"+","text":"Toe: “berose, tidhare,” vaho “te’esore.”","reference":{"chapter":41,"verse":19}}]},"thisChapterLink":"/api/tdx_sle/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}