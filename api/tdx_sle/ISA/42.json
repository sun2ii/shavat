{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":42,"content":[{"type":"verse","number":1,"content":[{"text":"Intoy ty mpitoroko tohañako,","poem":1},{"lineBreak":true},{"text":"ty jinoboko toe mahafale troke,","poem":1},{"lineBreak":true},{"text":"le nakofòko ama’e ty troko","poem":1},{"lineBreak":true},{"text":"ie ty hinday ty hatò amo kilakila’ ndatio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy hikoikoike re tsy hampipoña-peo,","poem":1},{"lineBreak":true},{"text":"le tsy hampijanjiñe’e an-dalañey","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’e;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tsy ho potora’e ty vinda pineke","poem":1},{"lineBreak":true},{"text":"vaho tsy hakipe’e ty lamese miliriliry;","poem":1},{"lineBreak":true},{"text":"hampiboaha’e ty hatò ami’ty figahiña’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy ho toiran-dre, tsy ho demoke,","poem":1},{"lineBreak":true},{"text":"ampara’ te najado’e an-tane atoy ty hatò;","poem":1},{"lineBreak":true},{"text":"naho hitamà i Hake o olon-taneo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà Andrianañahare","poem":1},{"lineBreak":true},{"text":"Mpamboatse o likerañeo","poem":1},{"lineBreak":true},{"text":"naho nandafike iareo,","poem":1},{"lineBreak":true},{"text":"I namelatse ty tane toy naho","poem":1},{"lineBreak":true},{"text":"ze miboak’ ama’ey,","poem":1},{"lineBreak":true},{"text":"ie mampikofòke ondaty ama’eo","poem":1},{"lineBreak":true},{"text":"vaho manolotse arofo","poem":1},{"lineBreak":true},{"text":"amo midraidraitse aoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Izaho Iehovà, ty nitok’azo","poem":1},{"lineBreak":true},{"text":"an-kavañonañe,","poem":1},{"lineBreak":true},{"text":"nitintineko ty taña’o","poem":1},{"lineBreak":true},{"text":"naho nampitsoloheko,","poem":1},{"lineBreak":true},{"text":"vaho natoloko ho fañina","poem":1},{"lineBreak":true},{"text":"am’ondatio,","poem":1},{"lineBreak":true},{"text":"ho hazavàñe amo kilakila’ ndatio,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"hanokake ty fihaino fey","poem":1},{"lineBreak":true},{"text":"hañakatse o mpirohy am-balabeio","poem":1},{"lineBreak":true},{"text":"naho o mitozòke alafem-porozò añ’ieñeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Izaho Iehovà, izay ty añarako;","poem":1},{"lineBreak":true},{"text":"tsy hatoloko ami’ty ila’e o volonahekoo,","poem":1},{"lineBreak":true},{"text":"ndra amo hazomangao ty engeko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Heheke fa nihelañe o raha haehaeo,","poem":1},{"lineBreak":true},{"text":"o raha vaoo o tseizeko henaneo;","poem":1},{"lineBreak":true},{"text":"Ie mbe tsy mipoteake","poem":1},{"lineBreak":true},{"text":"ty ho taroñeko ama’ areo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Misaboa sabo vao am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ibangò ry añ’olo-tane añeo;","poem":1},{"lineBreak":true},{"text":"ie mizotso mb’an-driakey,","poem":1},{"lineBreak":true},{"text":"naho ze he’e ama’e ao, o tokonoseo,","poem":1},{"lineBreak":true},{"text":"vaho o mpimoneñe ama’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hampionjonem-peo ty fatram-bey","poem":1},{"lineBreak":true},{"text":"naho o rova ama’eo,","poem":1},{"lineBreak":true},{"text":"o tanàñe añialoa’ i Kedareo","poem":1},{"noteId":173},{"text":",","poem":1},{"lineBreak":true},{"text":"naho hañonjo Hake t’i Selà,","poem":1},{"lineBreak":true},{"text":"vaho hipaza-­kafaleañe boak’ ankaboa’ o vohitseo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho rengè’ iereo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hitsey ty enge’e amo tokonoseo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hionjom-b’eo hoe ­fanalolahy t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ho troboe’e am-pamarahiañe","poem":1},{"lineBreak":true},{"text":"hoe lahin-defoñe;","poem":1},{"lineBreak":true},{"text":"hikaikaike naho hisehaseha","poem":1},{"noteId":174},{"text":",","poem":1},{"lineBreak":true},{"text":"hisenge amo rafelahi’eo ty haozara’e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Loho ela ty nitsiñako,","poem":1},{"lineBreak":true},{"text":"nihendre vaho nifoneñe;","poem":1},{"lineBreak":true},{"text":"f’ie henane zao, hikoiake","poem":1},{"lineBreak":true},{"text":"hoe ampela mitsongo;","poem":1},{"lineBreak":true},{"text":"hisañasaña naho hisehaseha.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho koaheko o vohitseo","poem":1},{"lineBreak":true},{"text":"naho o haboañeo,","poem":1},{"lineBreak":true},{"text":"vaho ho forejejeko o ahe’eo;","poem":1},{"lineBreak":true},{"text":"hanoeko tokonose o oñe’eo,","poem":1},{"lineBreak":true},{"text":"naho ho riteko o antara’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hendeseko mb’an-dalañe","poem":1},{"lineBreak":true},{"text":"tsy nifohi’ iareo o goao;","poem":1},{"lineBreak":true},{"text":"hiaoloako añ’oloñoloñe tsy nahazatse iareo;","poem":1},{"lineBreak":true},{"text":"hanoeko hazavàñe aolo’ iereo eo ty ieñe,","poem":1},{"lineBreak":true},{"text":"hampiraeko ze tomoantoañe.","poem":1},{"lineBreak":true},{"text":"hanoeko iaby vaho tsy hapoko","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie fonitse.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hampiambohoeñe an-kasalarañe,","poem":1},{"lineBreak":true},{"text":"o miato an-tsamposampo sinokitseo,","poem":1},{"lineBreak":true},{"text":"ze manao amo sare nitranaheñeo,","poem":1},{"lineBreak":true},{"text":"‘ndrahare’ay nahareo’.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mijanjiña ry kareñeñeo,","poem":1},{"lineBreak":true},{"text":"mahaisaha ry fey, hahavazohoa’ areo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ia ty goa naho tsy i mpitorokoy?","poem":1},{"lineBreak":true},{"text":"ndra kareñe manahake","poem":1},{"lineBreak":true},{"text":"i irako nafantokoy?","poem":1},{"lineBreak":true},{"text":"Ia ty fey mandikoatse i nampanintsiñekoy,","poem":1},{"lineBreak":true},{"text":"naho goa te amy mpitoro’ Iehovày?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mahaisake raha maro nahareo","poem":1},{"lineBreak":true},{"text":"fe tsy mahaoniñe,","poem":1},{"lineBreak":true},{"text":"misokake o raven-tsofio","poem":1},{"lineBreak":true},{"text":"fe tsy mahatsendreñe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Niehake t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ty amy havañona’ey,","poem":1},{"lineBreak":true},{"text":"honjoñe’e naho ho renge’e i Tsara’ey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fe ondaty nikamereñe","poem":1},{"lineBreak":true},{"text":"naho nivoloseñe retoa,","poem":1},{"lineBreak":true},{"text":"songa tsinepake an-koboñe ao,","poem":1},{"lineBreak":true},{"text":"naetake am-balabey ao;","poem":1},{"lineBreak":true},{"text":"natao ho fitsatsàñe tsy amam-pandrombake, fikopahañe,","poem":1},{"lineBreak":true},{"text":"le tsy eo ty manao: Ampolio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ia ama’ areo ty hanolo-ravembia","poem":1},{"lineBreak":true},{"text":"amy zay?","poem":1},{"lineBreak":true},{"text":"Ia ty hitsendreñe naho hijanjiñe","poem":1},{"lineBreak":true},{"text":"amy ze añe zay?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ia ty nanolotse Iakobe ho kopaheñe,","poem":1},{"lineBreak":true},{"text":"naho Israele ho amo mpamaokeo?","poem":1},{"lineBreak":true},{"text":"tsy Iehovà hao? I nanoantika hakeoy,","poem":1},{"lineBreak":true},{"text":"tsy nete nañavelo amo lala’eo iereo,","poem":1},{"lineBreak":true},{"text":"tsy norihe’ iareo o Tsara’eo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa le nadoa’e ama’e","poem":1},{"lineBreak":true},{"text":"ty haforoforon-kaviñera’e,","poem":1},{"lineBreak":true},{"text":"naho ty hafatraran-kotakotake;","poem":1},{"lineBreak":true},{"text":"naho namiaña’e afo nañarikatok’aze","poem":1},{"lineBreak":true},{"text":"fe tsy hinao’e, vaho nampiforehete’e,","poem":1},{"lineBreak":true},{"text":"tsy rinambe’ ty arofo’e.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":173,"caller":"+","text":"Kedare; mainte; hontoke","reference":{"chapter":42,"verse":11}},{"noteId":174,"caller":"+","text":"Satan-drakemba mitsongo","reference":{"chapter":42,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}