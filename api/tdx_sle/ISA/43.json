{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Aa le hoe t’Iehovà",{"text":"namboatse azo, ry Iakobe,","poem":1},{"lineBreak":true},{"text":"i nitsene azoy, ry Israele;","poem":1},{"lineBreak":true},{"text":"ko hembañe fa nijebañe azo iraho,","poem":1},{"lineBreak":true},{"text":"fa nikoihako ami’ty tahina’o,","poem":1},{"lineBreak":true},{"text":"Ahiko irehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie mitsake o ranoo irehe,","poem":1},{"lineBreak":true},{"text":"hindrezako,","poem":1},{"lineBreak":true},{"text":"ie miranga saka,","poem":1},{"lineBreak":true},{"text":"tsy handipora’e;","poem":1},{"lineBreak":true},{"text":"ie misorok’ afo am-pandia","poem":1},{"lineBreak":true},{"text":"tsy ho mae,","poem":1},{"lineBreak":true},{"text":"le tsy hiviañe ama’o ty firebareba’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Izaho Iehovà Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"t’i Masi’ Israele, i Mpijebañe azoy;","poem":1},{"lineBreak":true},{"text":"natoloko ho vilin’ai’o ty Mitsraime,","poem":1},{"lineBreak":true},{"text":"i Kose naho i Sebà","poem":1},{"noteId":175},{"text":"ho azo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa kanao sarotse am-pañenteako,","poem":1},{"lineBreak":true},{"text":"naho mañeva asiñe, vaho kokoako;","poem":1},{"lineBreak":true},{"text":"le lahilahy maro ty ho tolorako ho azo,","poem":1},{"lineBreak":true},{"text":"vaho rofoko ho solom-piai’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko hembañe, fa indrezako;","poem":1},{"lineBreak":true},{"text":"hendeseko boak’atiñanañe añe ty tiri’o,","poem":1},{"lineBreak":true},{"text":"vaho hatontoko boak’ ­ahandrefañe añe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hanao ty hoe iraho amy avaratsey:","poem":1},{"lineBreak":true},{"text":"Hahao, naho ami’ty atimo: Ko tana’o,","poem":1},{"lineBreak":true},{"text":"endeso boak’e tsietoitane añe","poem":1},{"lineBreak":true},{"text":"o ana-dahikoo,","poem":1},{"lineBreak":true},{"text":"naho boak’ añ’olo’ ty tane toy","poem":1},{"lineBreak":true},{"text":"o anak’ampelakoo—","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ze hene kanjieñe ami’ty añarako,","poem":1},{"lineBreak":true},{"text":"o tsineneko ho ami’ty engekoo,","poem":1},{"lineBreak":true},{"text":"o naoreko vaho namboarekoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Akaro boak’ ao ondaty goa","poem":1},{"lineBreak":true},{"text":"am-pihainoo,","poem":1},{"lineBreak":true},{"text":"o giñe an-dravembiao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hene mifanontone o kilakila’ ndatio,","poem":1},{"lineBreak":true},{"text":"songa mivory ondatio;","poem":1},{"lineBreak":true},{"text":"ia am’ iereo ty mahafitsey izay,","poem":1},{"lineBreak":true},{"text":"hitaroñe aman-tika o raha haehaeo?","poem":1},{"lineBreak":true},{"text":"Ampiboaho o valolombelo’ iareoo","poem":1},{"lineBreak":true},{"text":"hahazoa’ iareo to; hijanjiñañe,","poem":1},{"lineBreak":true},{"text":"hanoañe ty hoe: To izay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inahareo ro valolombeloko,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ty mpitoroko jinoboko;","poem":1},{"lineBreak":true},{"text":"hahafohina’ areo naho hatokisa’ areo ahy,","poem":1},{"lineBreak":true},{"text":"haharendreke te Ie iraho;","poem":1},{"lineBreak":true},{"text":"tsy eo ty ‘ndrahare ­niforoñeñe taoloko,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hanonjohy ahy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Izaho le Izaho avao t’Iehovà;","poem":1},{"lineBreak":true},{"text":"le naho tsy Izaho,","poem":1},{"lineBreak":true},{"text":"tsy eo ty mpandrombake.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa nitaroñe iraho, naho nandrombake,","poem":1},{"lineBreak":true},{"text":"naho nañoke, te tsy aman’ Andrianañahare ila’e nahareo;","poem":1},{"lineBreak":true},{"text":"aa le inahareo ro valolombeloko,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Izaho ro Andrianañahare.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Eka, boak’ amy àndro zay,","poem":1},{"lineBreak":true},{"text":"le fa ie iraho,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty haha­tavañe ty an-tañako;","poem":1},{"lineBreak":true},{"text":"hitoloñe iraho, le ia ty mahasebañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà mpijebañe anahareo,","poem":1},{"lineBreak":true},{"text":"ty Masi’ Israele:","poem":1},{"lineBreak":true},{"text":"inahareo ro nañitrifako e Bavele añe,","poem":1},{"lineBreak":true},{"text":"le fonga nafotsako ho gike iareo","poem":1},{"lineBreak":true},{"text":"naho o nte-Kasdy mitreñe o laka’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Izaho Iehovà, Masi’ areo,","poem":1},{"lineBreak":true},{"text":"i mpamboats’ Israeley, ty Mpanjaka’ areo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"mpamboatse lalañe mitsake i riakey,","poem":1},{"lineBreak":true},{"text":"naho oloñoloñe mitoañe","poem":1},{"lineBreak":true},{"text":"o rano mitroñeo;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I mpañakatse i sarete reke-tsoavalaiy,","poem":1},{"lineBreak":true},{"text":"o lahindefoñe naho haozara’eo—","poem":1},{"lineBreak":true},{"text":"miharo fandreañe ao iereo,","poem":1},{"lineBreak":true},{"text":"tsy hitroatse ka,","poem":1},{"lineBreak":true},{"text":"fa mongotse, nakipeke hoe lamese.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ko mitsakore o raha taoloo,","poem":1},{"lineBreak":true},{"text":"ko mañereñere o raha haehaeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Heheke te manao raha vao iraho,","poem":1},{"lineBreak":true},{"text":"hitiry ami’ty manao zao;","poem":1},{"lineBreak":true},{"text":"aa tsy ho rendre’ areo hao?","poem":1},{"lineBreak":true},{"text":"hanatahako lalañe ka","poem":1},{"lineBreak":true},{"text":"ty am-patrañe añe,","poem":1},{"lineBreak":true},{"text":"naho saka an-dratraratra ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hiasy ahy o biby an-kivokeo,","poem":1},{"lineBreak":true},{"text":"o fanalokeo naho o voron-tsatrañeo,","poem":1},{"lineBreak":true},{"text":"ty amo rano nanoeko am-patrañeo,","poem":1},{"lineBreak":true},{"text":"naho o saka an-dratraratrao,","poem":1},{"lineBreak":true},{"text":"hanjotsoako rano ondaty jinobokoo;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ho talilie’ ondaty namboareko ho ahikoo, ty engeko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fe tsy nikanjy ahy nahareo, ry Iakobe,","poem":1},{"lineBreak":true},{"text":"namokoreko nahareo ry Israele.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsy nisoroña’o ty añondri’o;","poem":1},{"lineBreak":true},{"text":"tsy niasia’o amo engaeñeo;","poem":1},{"lineBreak":true},{"text":"tsy nampijinieko engan-kaneñe,","poem":1},{"lineBreak":true},{"text":"tsy nivozaheko ami’ty tsotse.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tsy nibanabana’o fare naho drala,","poem":1},{"lineBreak":true},{"text":"tsy nahaeneñ’ Ahy ty safom-pisoroña’o;","poem":1},{"lineBreak":true},{"text":"te mone nampavesare’o amako o tahi’oo,","poem":1},{"lineBreak":true},{"text":"vaho namokore’o amo hakeo’oo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Izaho le Izaho avao ty namaoke","poem":1},{"lineBreak":true},{"text":"o fiolà’o amakoo.","poem":1},{"lineBreak":true},{"text":"vaho tsy ho tiahiko ka o hakeo’oo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ajoño am-pitiahia’o ao iraho,","poem":1},{"lineBreak":true},{"text":"antao hifaneseke; mitalilia hahazoa’o to.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nandilatse i rae’o valoha’ey,","poem":1},{"lineBreak":true},{"text":"vaho manan-kakeo amako","poem":1},{"lineBreak":true},{"text":"ondati-aivo’oo;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aa le vinetako o ana-dona’","poem":1},{"lineBreak":true},{"text":"i toetse miavakeio,","poem":1},{"lineBreak":true},{"text":"nengaeko am-patse t’Iakobe,","poem":1},{"lineBreak":true},{"text":"vaho an-teratera t’Israele.","poem":1}]}],"footnotes":[{"noteId":175,"caller":"+","text":"Seba: mpijike; mpifotetse, fandrohizañe;","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}