{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":44,"content":[{"type":"verse","number":1,"content":[{"text":"Aa le janjiño heike","poem":1},{"lineBreak":true},{"text":"ry Iakobe mpitoroko,","poem":1},{"lineBreak":true},{"text":"ry Israele jinoboko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà namboatse azo,","poem":1},{"lineBreak":true},{"text":"i namoroñe azo an-koviñ’ aoy,","poem":1},{"lineBreak":true},{"text":"Ie ty hañimb’azo:","poem":1},{"lineBreak":true},{"text":"ko hemban-drehe ry Iakobe mpitoroko,","poem":1},{"lineBreak":true},{"text":"naho ry Iesorone","poem":1},{"noteId":176},{"text":"jinoboko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa hañiliñako rano i kirikintàñey,","poem":1},{"lineBreak":true},{"text":"naho rano mitsiritsioke","poem":1},{"lineBreak":true},{"text":"an-tane maike eo;","poem":1},{"lineBreak":true},{"text":"hadoako amo tiri’oo ty Troko,","poem":1},{"lineBreak":true},{"text":"naho amo tarira’oo ty fañanintsiko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le hitiry añate ahetse ao iereo","poem":1},{"lineBreak":true},{"text":"manahake ty sohihy añolon-tsaka ey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hanao ty hoe ty raike:","poem":1},{"lineBreak":true},{"text":"A Iehovà iraho,","poem":1},{"lineBreak":true},{"text":"le hitoka ty añara’e","poem":1},{"lineBreak":true},{"text":"ho Iakobe ty raike;","poem":1},{"lineBreak":true},{"text":"ty ila’e hanokitse am-pità’e eo t’ie","poem":1},{"lineBreak":true},{"text":"a Iehovà, vaho","poem":1},{"lineBreak":true},{"text":"hatao’e Israele ty añaram-binta’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà, Mpanjaka’ Israele","poem":1},{"lineBreak":true},{"text":"naho ty Mpijeba’e, t’Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"Izaho ro valoha’e,","poem":1},{"lineBreak":true},{"text":"Izaho ro figadoña’e,","poem":1},{"lineBreak":true},{"text":"le tsy eo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"naho tsy Izaho avao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ia ty manahak’ ahy—angao ho koihe’e naho ho taroñe’e, hamolily amako—","poem":1},{"lineBreak":true},{"text":"boak’ amy nampijadoñako o matoetoeo!","poem":1},{"lineBreak":true},{"text":"He adono re hitoky o viloñe ho avio,","poem":1},{"lineBreak":true},{"text":"o raha mbe tsy nifetsakeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko hemban-drehe, ko mahimahiñe,","poem":1},{"lineBreak":true},{"text":"tsy fa nitaroñeko haehae hao?","poem":1},{"lineBreak":true},{"text":"Mbore nikoihako?","poem":1},{"lineBreak":true},{"text":"Inahareo ro valolombeloko:","poem":1},{"lineBreak":true},{"text":"Ia t’i Andrianañahare añ’ilako?","poem":1},{"lineBreak":true},{"text":"Ia ka ty Lamilamy? ie alik’ amako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Songa tsy manjofake o mpamo­roñe sare’ndrahareo,","poem":1},{"lineBreak":true},{"text":"vaho tsy vara o mahasinda iareoo;","poem":1},{"lineBreak":true},{"text":"tsy maharendreke o mpitalili’ iareoo,","poem":1},{"lineBreak":true},{"text":"tsy mahafohiñe, hisalara’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ia ty namoroñe ty ‘ndrahare,","poem":1},{"lineBreak":true},{"text":"ndra nampitranake saren-draha","poem":1},{"lineBreak":true},{"text":"tsy jefa’e?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe ho meñatse iaby o mpirimboñe ama’eo, mentsake ondaty","poem":1},{"lineBreak":true},{"text":"nandranjy iareoo;","poem":1},{"lineBreak":true},{"text":"angao hifanontone iereo,","poem":1},{"lineBreak":true},{"text":"songa hijohañe ey hirevendreveñe,","poem":1},{"lineBreak":true},{"text":"sindre hitrao-kasalarañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manefe fekoñe ty mpanefe,","poem":1},{"lineBreak":true},{"text":"tolone’e am-baen’ afo,","poem":1},{"lineBreak":true},{"text":"foroñe’e ami’ty ana-bato,","poem":1},{"lineBreak":true},{"text":"anoe’e an-tsirañe maozatse;","poem":1},{"lineBreak":true},{"text":"miha-kerè re, milesa i haozara’ey;","poem":1},{"lineBreak":true},{"text":"tsy minon-drano, midazidazìtse.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mamavatse taly ty mpandranjy;","poem":1},{"lineBreak":true},{"text":"sokire’e am-penisily;","poem":1},{"lineBreak":true},{"text":"lamae’e am-pandama,","poem":1},{"lineBreak":true},{"text":"patere’e an-kompà,","poem":1},{"lineBreak":true},{"text":"vaho tsene’e ho sarem-binta’ondaty","poem":1},{"lineBreak":true},{"text":"an-katsomerentseren-dra-olombelo,","poem":1},{"lineBreak":true},{"text":"hitoboha’e añ’anjomba ao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Firae’e ho aze ty mendoraveñe,","poem":1},{"lineBreak":true},{"text":"rambese’e ty varo naho ty kobaiñe;","poem":1},{"lineBreak":true},{"text":"beize’e ka ty hatae raike añ’ala ao,","poem":1},{"lineBreak":true},{"text":"ambolè’e ty kintsy,","poem":1},{"lineBreak":true},{"text":"vaho mamahañe aze i orañey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Minjare raha mete oroa’ ondaty,","poem":1},{"lineBreak":true},{"text":"aa le angala’e hamindroa’e;","poem":1},{"lineBreak":true},{"text":"eka viañe’e naho anokona’e mahakama;","poem":1},{"lineBreak":true},{"text":"mbore andranjia’e ndrahare,","poem":1},{"lineBreak":true},{"text":"naho mitalaho ama’e,","poem":1},{"lineBreak":true},{"text":"anokira’e hazomanga","poem":1},{"lineBreak":true},{"text":"vaho midrakadrakak’ ama’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Olora’e añ’afo ao ty ila’e;","poem":1},{"lineBreak":true},{"text":"ikama’e i henay","poem":1},{"lineBreak":true},{"text":"ie mitono ty ila’ i henay, le anjañe,","poem":1},{"lineBreak":true},{"text":"eka, amindroa’e le manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Hiry! Mafana iraho fa nitendrek’afo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty sisa’e amboare’e ‘ndrahare,","poem":1},{"lineBreak":true},{"text":"toe sare’e; mibaboke re italahoa’e,","poem":1},{"lineBreak":true},{"text":"naho ihalalia’e, manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Hahao iraho, fa ‘ndrahareko irehe?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy apota’e, tsy mahilala;","poem":1},{"lineBreak":true},{"text":"fa nakipe’e ty maso’iareo, tsy hahaisake,","poem":1},{"lineBreak":true},{"text":"naho ty tro’e tsy haharendreke.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy eo ty mitsakore an-troke","poem":1},{"lineBreak":true},{"text":"te tsy ama’e ty hihitse ndra hilala","poem":1},{"lineBreak":true},{"text":"hanoa’e ty hoe:","poem":1},{"lineBreak":true},{"text":"Toe finorototoko añ’afo ao ty ila’e;","poem":1},{"lineBreak":true},{"text":"eka fa nanokonako ahandro o vae’eo;","poem":1},{"lineBreak":true},{"text":"fa nahandroako hena naho nihinañe;","poem":1},{"lineBreak":true},{"text":"aa vaho handranjiako raha tiva ty sisa’e?","poem":1},{"lineBreak":true},{"text":"Hibabohako hao ty foto-katae?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lavenoke ty itamboavokaha’e,","poem":1},{"lineBreak":true},{"text":"nampivike aze ty tro’e finitake,","poem":1},{"lineBreak":true},{"text":"tsy haharombaha’e aiñe,","poem":1},{"lineBreak":true},{"text":"hanao ty hoe: Tsy vande hao","poem":1},{"lineBreak":true},{"text":"ty an-tañan-kavanako toa?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tiahio o raha zao ry Iakobe,","poem":1},{"lineBreak":true},{"text":"naho ry Israele, amy te mpitoroko;","poem":1},{"lineBreak":true},{"text":"Izaho ty nitsene azo, fetrek’oroko irehe;","poem":1},{"lineBreak":true},{"text":"ry Israele, ehe ko andikofa’o.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa finaoko hoe rahoñe milodolodo o fiolà’oo,","poem":1},{"lineBreak":true},{"text":"naho hoe mika-mikopoke o tahi’oo,","poem":1},{"lineBreak":true},{"text":"mibaliha amako fa nijebañeko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Misaboa ry likerañeo,","poem":1},{"lineBreak":true},{"text":"fa nifonira’ Iehovà;","poem":1},{"lineBreak":true},{"text":"mamantsiña, ry goledoñe lalekeo;","poem":1},{"lineBreak":true},{"text":"mipoñafa sabo ry vohitseo,","poem":1},{"lineBreak":true},{"text":"ry ala naho ze hatae ama’e ao;","poem":1},{"lineBreak":true},{"text":"amy te jineba’ Iehovà t’Iakobe,","poem":1},{"lineBreak":true},{"text":"vaho rengè’e t’Israele.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà Mpijeba’o,","poem":1},{"lineBreak":true},{"text":"i nitsene azo an-koviñe aoy.","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianamboatse ze he’e;","poem":1},{"lineBreak":true},{"text":"I mandafike o likerañeoy, Izaho raike;","poem":1},{"lineBreak":true},{"text":"I mamelatse ty tane toiy, Izaho avao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I mampijiañe ty sahà’ i remborakey,","poem":1},{"lineBreak":true},{"text":"naho mahaboseke o mpisikilio;","poem":1},{"lineBreak":true},{"text":"naho mampidisa-voly o mahihitseo,","poem":1},{"lineBreak":true},{"text":"vaho mampigege o hilala’eoy;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I mañatò ty saontsi’ i mpitoro’ey","poem":1},{"lineBreak":true},{"text":"naho mañeneke ze atoro’ o ira’eoy;","poem":1},{"lineBreak":true},{"text":"ie mitalily am’Ierosalaime ty hoe:","poem":1},{"lineBreak":true},{"text":"Ho fimoneñañe;","poem":1},{"lineBreak":true},{"text":"naho amo rova’ Iehodào : Hamboareñe, vaho hatroako o mangoakoake ama’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ie manao amy lalekey ty hoe:","poem":1},{"lineBreak":true},{"text":"Maiha, vaho ho maiheko ka o saka’oo;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ie anoe’e ty hoe i Korese","poem":1},{"noteId":177},{"text":": Mpiarak’añondriko re,","poem":1},{"lineBreak":true},{"text":"hanoe’e iaby ze mahafale ty troko;","poem":1},{"lineBreak":true},{"text":"hanoe’e ty hoe t’Ierosalaime:","poem":1},{"lineBreak":true},{"text":"Ho rafeteñe!","poem":1},{"lineBreak":true},{"text":"naho i anjomban’ Añaharey :","poem":1},{"lineBreak":true},{"text":"Haoreñe o mananta’oo.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":176,"caller":"+","text":"Iesorone: mpandrombake, mpamotsotse: añara’ Israele, Its 32:15, 33:5 33:26","reference":{"chapter":44,"verse":2}},{"noteId":177,"caller":"+","text":"Korese: hoe osa; hoe mpandova","reference":{"chapter":44,"verse":28}}]},"thisChapterLink":"/api/tdx_sle/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}