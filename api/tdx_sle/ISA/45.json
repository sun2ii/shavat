{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"Hoe t’Iehovà amy Korese noriza’ey, ie nihafatrareko ty fità’e havana,","poem":1},{"lineBreak":true},{"text":"hampibabohañe aolo’e eo","poem":1},{"lineBreak":true},{"text":"o kilakila ondatio,","poem":1},{"lineBreak":true},{"text":"vaho hampibalaha’e","poem":1},{"lineBreak":true},{"text":"ty am-bania’ o mpanjakao;","poem":1},{"lineBreak":true},{"text":"hanokafa’e o lalam-bey añatrefa’eoo,","poem":1},{"lineBreak":true},{"text":"tsy harindriñe ka o sikadañeo:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hiaolo azo iraho, naho","poem":1},{"lineBreak":true},{"text":"hampimiraeko o migoledogoledoñeo;","poem":1},{"lineBreak":true},{"text":"ho tseratseraheko o lalam-bey torisìkeo;","poem":1},{"lineBreak":true},{"text":"vaho ho pozapozaheko o sikadam-bìo;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hatoloko azo o hanañan-kaieñeo,","poem":1},{"lineBreak":true},{"text":"naho ty vara mikafitse an-toetse","poem":1},{"lineBreak":true},{"text":"mietake ao, soa te ho fohi’o","poem":1},{"lineBreak":true},{"text":"te Izaho Iehovà;","poem":1},{"lineBreak":true},{"text":"i mikanjy azo ami’ty tahina’oy;","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iakobe mpitorokoy,","poem":1},{"lineBreak":true},{"text":"naho Israele jinobokoy,","poem":1},{"lineBreak":true},{"text":"ty nikanjiako azo an-tahinañe,","poem":1},{"lineBreak":true},{"text":"Izaho ty nanolotse azo añarañe","poem":1},{"lineBreak":true},{"text":"ndra te tsy apota’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Izaho Iehovà vaho tsy aman-tovo,","poem":1},{"lineBreak":true},{"text":"tsy eo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"naho tsy Izaho avao;","poem":1},{"lineBreak":true},{"text":"Izaho ty nampidiañe azo ndra te nofi’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Soa te ho fohi’","poem":1},{"lineBreak":true},{"text":"o am-panjiriha’ i àndroy","poem":1},{"lineBreak":true},{"text":"pak’ am-pitsofora’eo","poem":1},{"lineBreak":true},{"text":"te tsy eo ty hatovoñ’ahy;","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà, vaho tsy aman-tovo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Izaho ty mamoroñe o hazavàñeo,","poem":1},{"lineBreak":true},{"text":"naho mamboatse o ieñeo;","poem":1},{"lineBreak":true},{"text":"amboareko ty fierañerañañe,","poem":1},{"lineBreak":true},{"text":"vaho foroñeko ty hankàñe;","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà o manao ze he’e zao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mikojojoaha ry likerañeo,","poem":1},{"lineBreak":true},{"text":"boak’ambone ey,","poem":1},{"lineBreak":true},{"text":"ampidoaño ­havañonañe ry rahoñeo;","poem":1},{"lineBreak":true},{"text":"misokafa ry tane,","poem":1},{"lineBreak":true},{"text":"hampamokarañe fandrombahañe,","poem":1},{"lineBreak":true},{"text":"ampitraofo fitiry ama’e ty havantañañe;","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà, ty namoroñe aze.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hankàñe amy mifandietse","poem":1},{"lineBreak":true},{"text":"amy Mpamboatse azey,","poem":1},{"lineBreak":true},{"text":"manahake ty valàñe-tane amo valàñe-tane an-taneo!","poem":1},{"lineBreak":true},{"text":"hanao ty hoe hao ty lietse","poem":1},{"lineBreak":true},{"text":"amy mpamoroñe azey,","poem":1},{"lineBreak":true},{"text":"Inom-bao o amboare’oo?","poem":1},{"lineBreak":true},{"text":"ndra: ino’ o tsenè’oo t’ie","poem":1},{"lineBreak":true},{"text":"tsy aman-tanañe?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hekoheko amy manao ty hoe","poem":1},{"lineBreak":true},{"text":"aman-drae’ey: Ino o nasama’oo?","poem":1},{"lineBreak":true},{"text":"ndra amy rakembay,","poem":1},{"lineBreak":true},{"text":"Ino ty nitsongoe’o?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà, t’i Masi’ Israele,","poem":1},{"lineBreak":true},{"text":"Namboatse azey:","poem":1},{"lineBreak":true},{"text":"Añontanea’o ahy hao o raha ho avio;","poem":1},{"lineBreak":true},{"text":"halohi’o hao iraho amo ana-dahikoo,","poem":1},{"lineBreak":true},{"text":"naho amo fitoloñakoo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Izaho, ty namboatse ty tane toy;","poem":1},{"lineBreak":true},{"text":"naho nitsene ondaty ama’e;","poem":1},{"lineBreak":true},{"text":"Izaho, le o tañakoo, ty nandafike","poem":1},{"lineBreak":true},{"text":"o likerañeo vaho liniliko","poem":1},{"lineBreak":true},{"text":"o havasiaña’ iareoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa nitsekafeko an-kavañonan-dre,","poem":1},{"lineBreak":true},{"text":"naho ho hene vantañeko o fombà’eo;","poem":1},{"lineBreak":true},{"text":"Ie ty hamboatse i rovakoy,","poem":1},{"lineBreak":true},{"text":"vaho havotso’e hidada,","poem":1},{"lineBreak":true},{"text":"tsy amam-bili’e tsy aman-tambe,","poem":1},{"lineBreak":true},{"text":"o naseseo,","poem":1},{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Homb’ama’o mb’eo,","poem":1},{"lineBreak":true},{"text":"ty fitoloña’ i Mitsraime,","poem":1},{"lineBreak":true},{"text":"naho ty kilanka’ i Kose","poem":1},{"lineBreak":true},{"text":"naho o nte-Sevàý mijoalao, ie ho azo:","poem":1},{"lineBreak":true},{"text":"hañorik’ azo iereo, hitsake mb’eo an-tsilisily,","poem":1},{"lineBreak":true},{"text":"naho hilokolokoa’ iareo hihalaly ama’o ami’ty hoe: Toe ama’areo t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"naho tsy eo ty hatovoñ’ Aze;","poem":1},{"lineBreak":true},{"text":"tsy aman’ Añahare ila’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Toe Andrianañahare mietake irehe","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare’ Israele","poem":1},{"lineBreak":true},{"text":"Mpandrombakeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho salatse iereo, eka,","poem":1},{"lineBreak":true},{"text":"fonga ho an-tamberen-tane;","poem":1},{"lineBreak":true},{"text":"hitrao-dia am-pivotemboteñañe","poem":1},{"lineBreak":true},{"text":"o mpitsene hazomangao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ry Israele, ie rinomba’ Iehovà","poem":1},{"lineBreak":true},{"text":"am-pandrombahañe tsy modo le","poem":1},{"lineBreak":true},{"text":"tsy ho salatse ndra daba nainai’e donia.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà Mpamboatse","poem":1},{"lineBreak":true},{"text":"o likerañeo: (i Andrianañahare","poem":1},{"lineBreak":true},{"text":"namoroñe ty tane toy, ie toe nitsene vaho nampijadoñ’ azey.) Tsy namboare’e ho koake.","poem":1},{"lineBreak":true},{"text":"fa namboatse iareo himoneñañe;","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà vaho tsy aman-tovo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy nivolañe añetake iraho,","poem":1},{"lineBreak":true},{"text":"an-toetse maieñe ao;","poem":1},{"lineBreak":true},{"text":"tsy nanoeko ty hoe ty tiri’ Iakobe:","poem":1},{"lineBreak":true},{"text":"Ipaiao hoe voa-nè,","poem":1},{"lineBreak":true},{"text":"Fe mpitaron-kavañonan-draho, Iehovà,","poem":1},{"lineBreak":true},{"text":"Mpikoike entam-bantañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mifanontona mb’etoañe;","poem":1},{"lineBreak":true},{"text":"mañarinea t’ie nahabotitsike","poem":1},{"lineBreak":true},{"text":"amo kilakila ondatioo!","poem":1},{"lineBreak":true},{"text":"Tsy aman-kilala ze misalika voñe","poem":1},{"lineBreak":true},{"text":"naho mihalaly aman-drahare","poem":1},{"lineBreak":true},{"text":"tsy maharombake.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Taroño, aboaho ty enta’ areo; angao t’ie hisafiry!","poem":1},{"lineBreak":true},{"text":"Ia ty nahafitoky zao haehae izay? Ia ty nitsey aze taolo bey añe?","poem":1},{"lineBreak":true},{"text":"Tsy Izaho, Iehovà hao? Tsy aman’ Añahare naho tsy Izaho, t’i Andrianañahare vantañe","poem":1},{"lineBreak":true},{"text":"naho Mpandrombake—","poem":1},{"lineBreak":true},{"text":"tsy eo naho tsy Izaho avao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mitoliha amako ry hene olon-taneo,","poem":1},{"lineBreak":true},{"text":"soa te ho rombaheñe,","poem":1},{"lineBreak":true},{"text":"amy te Izaho ro Andrianañahare,","poem":1},{"lineBreak":true},{"text":"le tsy aman-tovo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nifanta am-batako,","poem":1},{"lineBreak":true},{"text":"niboak’am-bavako ao an-","poem":1},{"lineBreak":true},{"text":"kavantaña’e ty tsara","poem":1},{"lineBreak":true},{"text":"vaho tsy hibalike ka, soa te amako","poem":1},{"lineBreak":true},{"text":"ty hitongalefa’ ze kila ongotse, ty hifantà’ ze hene fameleke.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho taroñeñe ahy ty hoe: Am’ Iehovà ao avao ty fandrebahañe","poem":1},{"lineBreak":true},{"text":"naho ty haozarañe.","poem":1},{"lineBreak":true},{"text":"Homb’ama’e mb’eo ondatio,","poem":1},{"lineBreak":true},{"text":"fonga hinañanaña o malaiñe Azeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Am’ Iehovà ao, kila hahazo to","poem":1},{"lineBreak":true},{"text":"ty tiri’ Israele,","poem":1},{"lineBreak":true},{"text":"vaho hirañaraña an-kobay!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}