{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":["Mibotreke ty Bele",{"noteId":178},",",{"text":"Midrokoke ty Nebò; vavè’ o bibio,","poem":1},{"lineBreak":true},{"text":"o añombe mijiny kilankañeo, ty sare’e; nampilogologoeñe o raha endese’ areoo o biby mokotseo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mibokoboko iereo, mitrao-piondreke,","poem":1},{"lineBreak":true},{"text":"tsy nitafete’ iareo i kilankañey; vaho","poem":1},{"lineBreak":true},{"text":"songa nasese mb’am-pandrohizañe añe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mijanjiña ahy ry anjomba’ Iakobeo,","poem":1},{"lineBreak":true},{"text":"naho ry sehangan’ anjomba’ Israeleo,","poem":1},{"lineBreak":true},{"text":"o nivesareko boak’am-pisamaha’eo,","poem":1},{"lineBreak":true},{"text":"o notroñeñe boak’ an-koviñe ao","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"pak’ an-ka’anterañeo, Izaho ro Ie,","poem":1},{"lineBreak":true},{"text":"ho babèko pak’ a maròy foty irehe;","poem":1},{"lineBreak":true},{"text":"Izaho ty namboatse, izaho ty hinday;","poem":1},{"lineBreak":true},{"text":"eka hotroñeko mbore hampipalireko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia ty hampañirin­kiriña’ areo amako,","poem":1},{"lineBreak":true},{"text":"naho hampihambaña’areo,","poem":1},{"lineBreak":true},{"text":"vaho hampanahafa’ areo,","poem":1},{"lineBreak":true},{"text":"soa te hifañoronkoroñe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mandrarake volamena","poem":1},{"lineBreak":true},{"text":"boak’ an-kotrañe ao ty ila’e,","poem":1},{"lineBreak":true},{"text":"naho mandanja volafoty am-balantsy;","poem":1},{"lineBreak":true},{"text":"vaho mañarama mpanefe volamena","poem":1},{"lineBreak":true},{"text":"hañamboare’e ndrahare,","poem":1},{"lineBreak":true},{"text":"hibokobokoa’e naho hitalahoa’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jinie’ iereo an-tsoroke, endeseñe,","poem":1},{"lineBreak":true},{"text":"apo’ iereo amy toe’ey,","poem":1},{"lineBreak":true},{"text":"ie mijagarodoñe eo, tsy hienga i toe’ey;","poem":1},{"lineBreak":true},{"text":"eka, ndra t’ie kaikaiheñe","poem":1},{"lineBreak":true},{"text":"tsy mete manoiñe,","poem":1},{"lineBreak":true},{"text":"tsy haharombak’ aze","poem":1},{"lineBreak":true},{"text":"amy hasosora’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tiahio le mijadoña;","poem":1},{"lineBreak":true},{"text":"ampolio an-troke ao, ry mpanan-kakeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tiahio o raha taoloo, eka haehae;","poem":1},{"lineBreak":true},{"text":"te Izaho ro Andrianañahare","poem":1},{"lineBreak":true},{"text":"naho tsy aman-tovo;","poem":1},{"lineBreak":true},{"text":"Izaho ro Andrianañahare","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hambañe amako,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitaroñe ty figadoña’e hirik’am-baloha’e,","poem":1},{"lineBreak":true},{"text":"boake haehae añe o mbe tsy nanoeñeo,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Hijadoñe ty ereñereko,","poem":1},{"lineBreak":true},{"text":"vaho hene hanoeko","poem":1},{"lineBreak":true},{"text":"ze mahafale ty troko;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho tokaveko boak’ atiñanañe añe","poem":1},{"lineBreak":true},{"text":"ty voroñe mipay hena;","poem":1},{"lineBreak":true},{"text":"t’indaty nisafirieko boak’","poem":1},{"lineBreak":true},{"text":"an-tsietoitane añe;","poem":1},{"lineBreak":true},{"text":"eka fa nivolan-dRaho le ho henefeko,","poem":1},{"lineBreak":true},{"text":"niereñeren-dRaho vaho hanoeko.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haoño iraho, ry gan-katokeo,","poem":1},{"lineBreak":true},{"text":"ry lavitse havañonañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hendeseko marine eo","poem":1},{"lineBreak":true},{"text":"ty havantañako, tsy ho lavitse,","poem":1},{"lineBreak":true},{"text":"tsy halaoñe i fandrombahakoy;","poem":1},{"lineBreak":true},{"text":"vaho hatoloko amy Tsione","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe, ho a’ Israele engeko.","poem":1}]}],"footnotes":[{"noteId":178,"caller":"+","text":"Bele: ty Tale’ i Bavele; mpandrotsake","reference":{"chapter":46,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}