{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Mizotsoa, mitoboha an-debok’ ao,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ i Bavele;","poem":1},{"lineBreak":true},{"text":"mitozoha an-tane eo","poem":1},{"lineBreak":true},{"text":"tsy amam-piambesatse,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ i Kasdý;","poem":1},{"lineBreak":true},{"text":"fa tsy hatao mitrotrotrotro","poem":1},{"lineBreak":true},{"text":"ndra sakoly ka irehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rambeso i vato fandisanañey","poem":1},{"lineBreak":true},{"text":"naho lisano i tsakoy;","poem":1},{"lineBreak":true},{"text":"afaho o lamba marerarera’oo,","poem":1},{"lineBreak":true},{"text":"voloso o mireparepao,","poem":1},{"lineBreak":true},{"text":"aonjono ty an-kitso’o eo,","poem":1},{"lineBreak":true},{"text":"itsaho o sakao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haboake ty fibongia’o;","poem":1},{"lineBreak":true},{"text":"ho trea ty fimeñara’o;","poem":1},{"lineBreak":true},{"text":"hamale fate raho","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hanebañe ahy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I Mpijeba’ay, Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"ty tahina’e, i Masi’ Israeley.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitoboha am-pitsiñañe ao,","poem":1},{"lineBreak":true},{"text":"akia mb’an-kamoromoroñañe ao,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ o Kasdio,","poem":1},{"lineBreak":true},{"text":"tsy hatao mpanjakam-pifeheañe ka irehe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niboseke am’ondatikoo iraho,","poem":1},{"lineBreak":true},{"text":"vinetako i lovakoy,","poem":1},{"lineBreak":true},{"text":"vaho natoloko am-pità’o,","poem":1},{"lineBreak":true},{"text":"fa tsy niferenaiña’o, nanoe’o mavesatse amo antetseo ty joka’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie nanoe’o ty hoe,","poem":1},{"lineBreak":true},{"text":"Ho mpanjaka-­ampela nainai’e iraho,","poem":1},{"lineBreak":true},{"text":"le tsy nahaja’o an-troke ao o raha zao,","poem":1},{"lineBreak":true},{"text":"vaho tsy nitiahi’o ty figadoña’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa le tsanoño izao,","poem":1},{"lineBreak":true},{"text":"ty mpañori-kadrao,","poem":1},{"lineBreak":true},{"text":"ty mpiaiñ’añoleñañe,","poem":1},{"lineBreak":true},{"text":"ty manao an-tro’e ao ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy hitoboke ho remavoin-draho,","poem":1},{"lineBreak":true},{"text":"hamoeako ty fahamotsoan’ anake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa hivotrak’ama’o ami’ty andro raike","poem":1},{"lineBreak":true},{"text":"o raha roe zao:","poem":1},{"lineBreak":true},{"text":"ty hamotsoan’anake,","poem":1},{"lineBreak":true},{"text":"naho ty ha-remavoiñe;","poem":1},{"lineBreak":true},{"text":"am-pañaranañe pea t’ie hifetsake","poem":1},{"lineBreak":true},{"text":"ndra te tsifotofoto’ o famoreha’oo,","poem":1},{"lineBreak":true},{"text":"naho maozatse ty fisikilia’o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Natao’o mahasoa-aro ty halò-tsere’o, ihe nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy eo ty mahatrea ahy.","poem":1},{"lineBreak":true},{"text":"Songa nampikeloke azo ty hihi’o","poem":1},{"lineBreak":true},{"text":"naho ty hilala’o;","poem":1},{"lineBreak":true},{"text":"ie nanao ty hoe an-troke ao: Izaho ro ie,","poem":1},{"lineBreak":true},{"text":"vaho tsy ie naho tsy izaho avao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le hifetsake ama’o ty raty;","poem":1},{"lineBreak":true},{"text":"tsy ho lefe’o troboeñe hisitaha’e;","poem":1},{"lineBreak":true},{"text":"hidoiñe ama’o ty hankàñe;","poem":1},{"lineBreak":true},{"text":"tsy ho lefe añeferañe;","poem":1},{"lineBreak":true},{"text":"hivovò ama’o ty fiànto, aolo’ te apota’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mijadòña arè amo fisikilia’oo,","poem":1},{"lineBreak":true},{"text":"naho amo fitozantozam-pamoreha’oo,","poem":1},{"lineBreak":true},{"text":"o nitoloñe’o ampara’ ty nahakede azoo;","poem":1},{"lineBreak":true},{"text":"ke ho tambeza’e, he hahafitroboe’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie nimokore’ o fikililia’oo;","poem":1},{"lineBreak":true},{"text":"angao hiongake henaneo arè","poem":1},{"lineBreak":true},{"text":"o mpañandroo, naho","poem":1},{"lineBreak":true},{"text":"o mpañorike vasiañeo, naho","poem":1},{"lineBreak":true},{"text":"o mpahay volañeo,","poem":1},{"lineBreak":true},{"text":"handrombak’ azo amo hifetsak’ ama’oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Heheke, fa manahake ty ahetse iereo,","poem":1},{"lineBreak":true},{"text":"ho forototoen’ afo;","poem":1},{"lineBreak":true},{"text":"ie tsy haharombake ami’ty","poem":1},{"lineBreak":true},{"text":"haozara’ i firebareba’ey;","poem":1},{"lineBreak":true},{"text":"tsy ama’e ty vaen’ afo hitaraña’e,","poem":1},{"lineBreak":true},{"text":"toe tsy ho afo hamindroañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hoe izay iereo ama’o, o nifanehafa’oo;","poem":1},{"lineBreak":true},{"text":"songa hirererere mb’an-toe’e mb’eo","poem":1},{"lineBreak":true},{"text":"o nitrao-balibalike ama’o","poem":1},{"lineBreak":true},{"text":"boak’ ami’ty naha-ajaja azoo,","poem":1},{"lineBreak":true},{"text":"tsy ho amam-pandrombake irehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}