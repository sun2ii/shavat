{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"oJanjiño zao, ry anjomba’ Iakobe,","poem":1},{"lineBreak":true},{"text":"ie tokaveñe ami’ty tahina’ Israele,","poem":1},{"lineBreak":true},{"text":"ry niboak’ ami’ty figoangoa’ Iehodà;","poem":1},{"lineBreak":true},{"text":"o mifanta ami’ty tahina’ Iehovà","poem":1},{"lineBreak":true},{"text":"naho mitalily i Andrianañahare’ Israeleo, fe tsy an-katò,","poem":1},{"lineBreak":true},{"text":"tsy an-kavantañañe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie manao ho mpiamy rova miavakey, naho mpiato aman’ Añahare’ Israele,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nitaroñeko haehae o raha taoloo;","poem":1},{"lineBreak":true},{"text":"eka fa nionjoñe boak’am-bavako ao,","poem":1},{"lineBreak":true},{"text":"nitaroñeko le tsipaepae’e te nifetsake;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy te napotako","poem":1},{"lineBreak":true},{"text":"t’ie mitangingìñe,","poem":1},{"lineBreak":true},{"text":"naho viñe ty tali-bozìn-kàto’o,","poem":1},{"lineBreak":true},{"text":"Vaho torisìke ty lahara’o;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le nivolañako boake taolo añe,","poem":1},{"lineBreak":true},{"text":"ie mbe tsy nitondroke le nitaroñako,","poem":1},{"lineBreak":true},{"text":"tsy mone hatao’o ty hoe;","poem":1},{"lineBreak":true},{"text":"Nihenefa’ i hazomangakoy,","poem":1},{"lineBreak":true},{"text":"naho i sare pinateko an-kataey,","poem":1},{"lineBreak":true},{"text":"vaho, i raha natranakoy","poem":1},{"lineBreak":true},{"text":"ty nandily izay.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"F’ie nahajanjiñe,","poem":1},{"lineBreak":true},{"text":"heheke iaby o raha zao:","poem":1},{"lineBreak":true},{"text":"aa vaho tsy ho taroñe’ areo?","poem":1},{"lineBreak":true},{"text":"F’ie nitaroñeko raha vao henaneo,","poem":1},{"lineBreak":true},{"text":"raha mietake mbe tsy nifohi’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nifonireñe henaneo, fa tsy haehae,","poem":1},{"lineBreak":true},{"text":"tsy nijanjiña’o taolo’ ty andro toy,","poem":1},{"lineBreak":true},{"text":"tsy mone hatao’o ty hoe t’ie nifanta’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Eka, tsy jinanji’o tsy napota’o;","poem":1},{"lineBreak":true},{"text":"toe tsy nisokake o ravembia’oo","poem":1},{"lineBreak":true},{"text":"haehae izay;","poem":1},{"lineBreak":true},{"text":"fe napotako t’ie hikabo-draha,","poem":1},{"lineBreak":true},{"text":"ihe natao mpiola boak’ an-koviñe ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa le ty añarako ty hampihankàñe","poem":1},{"lineBreak":true},{"text":"o fifombokoo,","poem":1},{"lineBreak":true},{"text":"i fandrengeañe ahiy ty ifoneñako,","poem":1},{"lineBreak":true},{"text":"tsy mone haitoako irehe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie hinasohasoko, fa tsy hoe volafoty;","poem":1},{"lineBreak":true},{"text":"nitsoheko an-toñan-kaloviloviañe ao","poem":1},{"noteId":179},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Izaho, eka izaho, ty hanao izay;","poem":1},{"lineBreak":true},{"text":"fa akore te ho tivaeñe ty añarako?","poem":1},{"lineBreak":true},{"text":"toe tsy hatoloko ami’ty ila’e o engekoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haoño iraho ry Iakobe,","poem":1},{"lineBreak":true},{"text":"ry Israele kinanjiko;","poem":1},{"lineBreak":true},{"text":"Izaho ro Ie, Izaho ty fifotora’e,","poem":1},{"lineBreak":true},{"text":"naho Izaho ty figadoña’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Eka, nandaharen-tañako","poem":1},{"lineBreak":true},{"text":"ty faha’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"nilamahen-tañako havana o likerañeo;","poem":1},{"lineBreak":true},{"text":"ie tokavako, mitrao-piongake.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mitontoña, ie iaby, vaho mijanjiña:","poem":1},{"lineBreak":true},{"text":"ia am’ iereo ty nitsey o raha zao?","poem":1},{"lineBreak":true},{"text":"Hanao ty satrin-arofo’e e Bavele añe","poem":1},{"lineBreak":true},{"text":"t’i kokoa’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ie hisenge ty sira’e amo nte-Kasdio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Izaho le Izaho avao ty nivolañe,","poem":1},{"lineBreak":true},{"text":"eka Izaho ty nitoka aze,","poem":1},{"lineBreak":true},{"text":"Izaho ty nanese aze,","poem":1},{"lineBreak":true},{"text":"Ie ty hampiraorao o lala’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mitotoha amako le janjiño:","poem":1},{"lineBreak":true},{"text":"Boak’ am-baloha’e raho","poem":1},{"lineBreak":true},{"text":"tsy nivolañe añ’etake;","poem":1},{"lineBreak":true},{"text":"ie vaho namoroñe le tao iraho;","poem":1},{"lineBreak":true},{"text":"ie amy zao fa nañirak’ ahy","poem":1},{"lineBreak":true},{"text":"naho i Arofo’ey t’Iehovà Talè","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà, Mpijebañe azo,","poem":1},{"lineBreak":true},{"text":"t’i Masi’ Israele;","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà, Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"I mpañòke azo ho ami’ty hasoa’oy,","poem":1},{"lineBreak":true},{"text":"I mpiaolo azo an-dalan-kombà’oy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Naho ho nihaoñe’ areo o lilikoo!","poem":1},{"lineBreak":true},{"text":"le ho nanahake o oñeo ty fierañeraña’o,","poem":1},{"lineBreak":true},{"text":"vaho hoe onjan-driake ty havantaña’o.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Le ho nira amo faseñeo o tiri’oo,","poem":1},{"lineBreak":true},{"text":"o tariram-pañova’oo","poem":1},{"lineBreak":true},{"text":"ami’ty hamaro’ ty haminjilita’e;","poem":1},{"lineBreak":true},{"text":"naho tsy napitsoke","poem":1},{"lineBreak":true},{"text":"ndra naitoañe aoloko ka ty tahina’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Iakaro i Bavele,","poem":1},{"lineBreak":true},{"text":"Ivoratsaho o nte-Kasdio;","poem":1},{"lineBreak":true},{"text":"am-peo-pisaboañe, tseizo, pazapazaho, koiho pak’ añ’olo’ ty tane toy;","poem":1},{"lineBreak":true},{"text":"Ano ty hoe:","poem":1},{"lineBreak":true},{"text":"Fa jineba’ Iehovà ty mpitoro’e Iakobe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie tsy nitaliñiereñe te niaoloa’e hitsake o fatram-beio;","poem":1},{"lineBreak":true},{"text":"Nampipororoaha’e rano i vatoy;","poem":1},{"lineBreak":true},{"text":"tsinera’e i lamilamiy vaho","poem":1},{"lineBreak":true},{"text":"nidoandoañe i ranoy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Po-panintsiñañe, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"o tsivokatseo.","poem":1}]}],"footnotes":[{"noteId":179,"caller":"+","text":"Its 8:2-16","reference":{"chapter":48,"verse":10}}]},"thisChapterLink":"/api/tdx_sle/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}