{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":["Ry tokonoseo, mijanjiña ahiko;",{"text":"mitsendreña ry ondaty tsietoitàneo;","poem":1},{"lineBreak":true},{"text":"fa nikanjy ahy sikal’ an-tron-dreneko ao","poem":1},{"lineBreak":true},{"text":"t’Iehovà; boak’an-kovin-dreneko ao","poem":1},{"lineBreak":true},{"text":"ty nitoñona’e ty añarako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa nanoe’e arara masioñe ty vavako; an-talinjom-pità’e ao ty nañetaha’e; nanoe’e ana-pàle vinàñe; an-trañom-pale ao ty nampikafira’e;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le hoe re tamako:","poem":1},{"lineBreak":true},{"text":"Mpitoroko irehe, Israele;","poem":1},{"lineBreak":true},{"text":"Ihe ty fandrengeañe ahy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fe hoe raho : Nifanehake ami’ty tsy","poem":1},{"lineBreak":true},{"text":"havokaran-draho; nahamodo ty haozarako","poem":1},{"lineBreak":true},{"text":"tsy jefa’e naho tsy vente’e; toe Iehovà ty hahazoako to, naho aman’Añahareko ao","poem":1},{"lineBreak":true},{"text":"ty tambem-pitoloñako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa hoe t’Iehovà henanekeo— ie nitsene ahy an-koviñ’ ao ho mpitoro’e, hampipoliako t’Iakobe,","poem":1},{"lineBreak":true},{"text":"ndra te tsy natontoñe t’Israele, fe aman-kasy am-pihaino’Iehovà iraho vaho haozarako t’i Andrianañahareko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"hoe re: Raha loho-kede ho azo","poem":1},{"lineBreak":true},{"text":"te ho mpitoroko hampionjoñe o fifokoa’ Iakobeo, hampipoly o tarira’ Israeleo;","poem":1},{"lineBreak":true},{"text":"te mone hatoloko azo","poem":1},{"lineBreak":true},{"text":"ty ho failo’ o kilakila ondatio, hahatsitsifañe ty fandrombahako","poem":1},{"lineBreak":true},{"text":"pak’ añ’ olo’ ty tane toy añe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà— t’i Mpijeba’ Israele, i Masi’ey—","poem":1},{"lineBreak":true},{"text":"amy nisirikaeñey, amy falai’ o kilakila ondatioy, amy mpitorom-pifehey;","poem":1},{"lineBreak":true},{"text":"ho isa’ o mpanjakao le hiongake, vaho hibàboke o ana-donakeo,","poem":1},{"lineBreak":true},{"text":"am’ Iehovà migahiñey, i Masi’ Israele nijoboñe azoy;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hoe ty nafè’ Iehovà :","poem":1},{"lineBreak":true},{"text":"Añ’andro mete ty nitsanoñako azo,","poem":1},{"lineBreak":true},{"text":"añ’androm-pandrombahañe","poem":1},{"lineBreak":true},{"text":"te nitolorako; harovako irehe,","poem":1},{"lineBreak":true},{"text":"vaho hatoloko ho fañina am’ondatio,","poem":1},{"lineBreak":true},{"text":"hañavao i taney,","poem":1},{"lineBreak":true},{"text":"hampandova’o o lova mangoakoakeo;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"mitsey amo mpirohio ty hoe : Miakara.","poem":1},{"lineBreak":true},{"text":"vaho amo añ’ieñeo, ty hoe : Miboaha.","poem":1},{"lineBreak":true},{"text":"Hihinañe añ’olon-dalañe eo iereo,","poem":1},{"lineBreak":true},{"text":"ho fiandraza’ iareo o haboañe iabio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie tsy ho kerè ndra maran-drano,","poem":1},{"lineBreak":true},{"text":"tsy ho pisañen-katrevohañe","poem":1},{"lineBreak":true},{"text":"ndra tariñandroke;","poem":1},{"lineBreak":true},{"text":"fa hiaolo iareo ty Mpitretrè,","poem":1},{"lineBreak":true},{"text":"ho tehafe’e mb’an-drano","poem":1},{"lineBreak":true},{"text":"manganahana mb’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hanoeko lalañe o vohiko iabio,","poem":1},{"lineBreak":true},{"text":"vaho haonjoñe ambone o lalan-damokeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe ho boake tsietoitane añe retoañe;","poem":1},{"lineBreak":true},{"text":"ho boak’ avaratse añe retiañe","poem":1},{"lineBreak":true},{"text":"naho ahandrefañe añe reroañe,","poem":1},{"lineBreak":true},{"text":"vaho hiboak’e Sinime","poem":1},{"noteId":180},{"text":"añe reroy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Misaboa ry andikerañe ao !","poem":1},{"lineBreak":true},{"text":"mandià taroba ry tane !","poem":1},{"lineBreak":true},{"text":"mipoñafa beko ry haboañeo !","poem":1},{"lineBreak":true},{"text":"fa ohoñe’ Iehovà ondati’eo,","poem":1},{"lineBreak":true},{"text":"tretreze’e o mpisotri’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fe hoe t’i Tsione:","poem":1},{"lineBreak":true},{"text":"Nifarie’ Iehovà iraho,","poem":1},{"lineBreak":true},{"text":"vaho nandikofa’ i Talè.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho haliño’ ty rakemba hao","poem":1},{"lineBreak":true},{"text":"ty ana’e minono;","poem":1},{"lineBreak":true},{"text":"tsy ho ferenaiña’e hao","poem":1},{"lineBreak":true},{"text":"ty ana-dahi’e boak’ an-kovi’e ao?","poem":1},{"lineBreak":true},{"text":"Eka ndra t’ie mañaliño,","poem":1},{"lineBreak":true},{"text":"Izaho tsy hañaliño azo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hehe t’ie sinokiko an-dela-tañako;","poem":1},{"lineBreak":true},{"text":"Añatrefako eo nainai’e o kijoli’oo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Malisa o ana’oo; fa mienga","poem":1},{"lineBreak":true},{"text":"o mpandro­tsake naho mpamaoke azoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Andrandrao fihaino,","poem":1},{"lineBreak":true},{"text":"le mañisaha mb’eo mb’eo: ie mifanontone iaby te mb’ama’o mb’etoañe.","poem":1},{"lineBreak":true},{"text":"Amy te izaho veloñe, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hene ho hamiñe’o hoe bange,","poem":1},{"lineBreak":true},{"text":"vaho ho ravaha’o hoe an’enga-vao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fa rinotsake naho malio","poem":1},{"lineBreak":true},{"text":"vaho mangoakoake","poem":1},{"lineBreak":true},{"text":"o tane’oo,","poem":1},{"lineBreak":true},{"text":"fe maifitse irehe henane zay","poem":1},{"lineBreak":true},{"text":"ty amo mpimoneñeo,","poem":1},{"lineBreak":true},{"text":"vaho ho lavitse azo o nampigedrañe azoo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mbe hibisike an-dravembia’o ao","poem":1},{"lineBreak":true},{"text":"o anam-pandalà’oo, ty hoe:","poem":1},{"lineBreak":true},{"text":"Maifitse amako ty toe’o toy;","poem":1},{"lineBreak":true},{"text":"añalalahao toetse himoneñako.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hitsakore ty hoe irehe an-trok’ao:","poem":1},{"lineBreak":true},{"text":"Sinama’ ia o retoañeo, Izaho nimotso anake naho nibangiñe,","poem":1},{"lineBreak":true},{"text":"nasese vaho mpirererere avao?","poem":1},{"lineBreak":true},{"text":"Ia ty nañabey o retoañe?","poem":1},{"lineBreak":true},{"text":"izaho naforintseñe:","poem":1},{"lineBreak":true},{"text":"boak’aia o retoañeo?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe t’i Talè Iehovà:","poem":1},{"lineBreak":true},{"text":"Ingo fa hañonjon-tsirañe","poem":1},{"lineBreak":true},{"text":"amo kilakila ondatio iraho,","poem":1},{"lineBreak":true},{"text":"naho hajadoko am’ ondatio ty viloko,","poem":1},{"lineBreak":true},{"text":"naho hindese’ iareo añ’araña’e ao","poem":1},{"lineBreak":true},{"text":"o ana-dahi’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho hasese’ iereo añ’ èga","poem":1},{"lineBreak":true},{"text":"o anak’ ampela’ areoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho roae-mpañotroñe iareo","poem":1},{"lineBreak":true},{"text":"o mpanjakao,","poem":1},{"lineBreak":true},{"text":"hampinono iareo o valim-panjakao,","poem":1},{"lineBreak":true},{"text":"hidrakadrakake ama’o iereo,","poem":1},{"lineBreak":true},{"text":"laharañe mb’an-tane,","poem":1},{"lineBreak":true},{"text":"hitsela ty deboke am-pandia’o eo;","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’o te Izaho Iehovà,","poem":1},{"lineBreak":true},{"text":"le tsy ho salatse ze mahaliñe ahy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho tavaneñe ami’ty fanalolahy","poem":1},{"lineBreak":true},{"text":"hao ty tsindro’e,","poem":1},{"lineBreak":true},{"text":"havotsotse amy nahagiokey hao","poem":1},{"lineBreak":true},{"text":"o tsinepa’eo?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Toe ho tavaneñe amy fanalolahiy","poem":1},{"lineBreak":true},{"text":"o narohi’eo,","poem":1},{"lineBreak":true},{"text":"naho havotsotse amy mitrotrofiakey","poem":1},{"lineBreak":true},{"text":"o hinoro’eo;","poem":1},{"lineBreak":true},{"text":"hatrefeko ty miatreatre azo,","poem":1},{"lineBreak":true},{"text":"vaho ho rombaheko o ana’oo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ho fahanako amo nofo’eo avao","poem":1},{"lineBreak":true},{"text":"o mpamorekeke anahareoo;","poem":1},{"lineBreak":true},{"text":"ho mamoe’ ty lio’e avao,","poem":1},{"lineBreak":true},{"text":"hoe t’ie divay mamy;","poem":1},{"lineBreak":true},{"text":"ho fohi’ ze hene nofotse te","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà ro Mpandrombak’ azo,","poem":1},{"lineBreak":true},{"text":"naho t’i Mpijeba’o, t’i Manjofa’ Iakobe.","poem":1}]}],"footnotes":[{"noteId":180,"caller":"+","text":"Sinime: Tane atimo","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}