{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ho bekoeko i kokoakoy,","poem":1},{"lineBreak":true},{"text":"toe beko’ i rañeko,","poem":1},{"lineBreak":true},{"text":"ty amy tanem-balobo’ey,","poem":1},{"lineBreak":true},{"text":"Aman-tanem-bahy ankaboan-","poem":1},{"lineBreak":true},{"text":"kobokara añe i kokoakoy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nitrabahe’e, nahoro’e boak’ao o vato’eo,","poem":1},{"lineBreak":true},{"text":"naketsa’e ao ty vahe soa-joboñe,","poem":1},{"lineBreak":true},{"text":"rinanji’e tilik’abo an-teñateña ao,","poem":1},{"lineBreak":true},{"text":"vaho nitsenea’e fipiritan-divay:","poem":1},{"lineBreak":true},{"text":"le nitamà’e valoboke,","poem":1},{"lineBreak":true},{"text":"f’ie namokatse valoboke vìlañe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie henane zao ry mpimoneñe e","poem":1},{"lineBreak":true},{"text":"Ierosalaime ao, ry ondati’ Iehodào,","poem":1},{"lineBreak":true},{"text":"ihalaliako : mizakà añivoko naho","poem":1},{"lineBreak":true},{"text":"i tondam-balobokoy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ino ka ty hanoako","poem":1},{"lineBreak":true},{"text":"amy tetem-bahekoy,","poem":1},{"lineBreak":true},{"text":"ze mboe tsy nanoeko?","poem":1},{"lineBreak":true},{"text":"Ie nitamàko hamokatse valoboke","poem":1},{"lineBreak":true},{"text":"soa, ro nañomey valoboke lo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa ie zao, hampahafohineko anahareo","poem":1},{"lineBreak":true},{"text":"ty hanoako amy tanem-bahekoy;","poem":1},{"lineBreak":true},{"text":"hombotako i fahe’ey, le horoañe;","poem":1},{"lineBreak":true},{"text":"le harotsako ambane i kijoli’ey,","poem":1},{"lineBreak":true},{"text":"ho lialiàñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hampangoakoaheko,","poem":1},{"lineBreak":true},{"text":"tsy ho birabiraeñe, tsy havaeñe ka;","poem":1},{"lineBreak":true},{"text":"fa hitirian-kisatse naho fatike:","poem":1},{"lineBreak":true},{"text":"ho lilieko ka o rahoñeo","poem":1},{"lineBreak":true},{"text":"ty tsy hampahavy orañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ty anjomba’Israele,","poem":1},{"lineBreak":true},{"text":"ie ty tondam-bahe’ Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ondati’ Iehodào, i hatae ifalea’ey,","poem":1},{"lineBreak":true},{"text":"nipay to re fe nizò fanjamanañe;","poem":1},{"lineBreak":true},{"text":"nitsoeke havañonañe fe inao ty kaikaike.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hankàñe amo mampifanoitoy","poem":1},{"lineBreak":true},{"text":"kibohotse an-kivoho,","poem":1},{"lineBreak":true},{"text":"naho tonda toien-tetekeo,","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie tsy malalake,","poem":1},{"lineBreak":true},{"text":"vaho bangy irehe añivo’ i taney.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amo sofikoo ao! hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"Toe maro ty anjomba ho kòake,","poem":1},{"lineBreak":true},{"text":"ty jabajaba naho ty fanjaka","poem":1},{"lineBreak":true},{"text":"tsy ho ama’ ondaty.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Eka, hamokatse sajoa raike","poem":1},{"lineBreak":true},{"text":"ty tanem-bahe folo lasarý,","poem":1},{"lineBreak":true},{"text":"le hahafoe tsikotoke raike","poem":1},{"lineBreak":true},{"text":"ty tabiry zahetse raike.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hekoheko amo mitroatse handro","poem":1},{"lineBreak":true},{"text":"hitolon-kamamoañeo;","poem":1},{"lineBreak":true},{"text":"o mihenekeneke halem-bey","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie solebaren-divaio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amo takataka’ iareo","poem":1},{"lineBreak":true},{"text":"ty marovany naho ty mandolina,","poem":1},{"lineBreak":true},{"text":"ty fikantsakantsàñe vaho ty divay:","poem":1},{"lineBreak":true},{"text":"fe tsy oni’iareo ty sata’ Iehovà,","poem":1},{"lineBreak":true},{"text":"mbore tsy ereñere’ iareo","poem":1},{"lineBreak":true},{"text":"o fitoloñam-pità’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le misese mb’an-drohy ondatikoo,","poem":1},{"lineBreak":true},{"text":"amy te po-hilala,","poem":1},{"lineBreak":true},{"text":"salikoeñe o androanavi’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho miforejeje ami’ty hataliñiere’e","poem":1},{"lineBreak":true},{"text":"ty valobohò’ iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le nienatse ty fañiria’ i tsikeokeokey,","poem":1},{"lineBreak":true},{"text":"nigorobahe’e ty vava’e tsy taka-zeheñe;","poem":1},{"lineBreak":true},{"text":"hijoloboñe ao ty enge’ iareo,","poem":1},{"lineBreak":true},{"text":"ty fivoamboa’e, ty fikoraha’e,","poem":1},{"lineBreak":true},{"text":"rekets’ i mirebekey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Haketrake ty fokonon-tsoa,","poem":1},{"lineBreak":true},{"text":"harèke ty fanalolahy,","poem":1},{"lineBreak":true},{"text":"vaho hampiambaneañe ty fihaino’","poem":1},{"lineBreak":true},{"text":"o mievotsevotseo:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ty hatò ro añonjonañe","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ty havañonañe ro añamasiñañe","poem":1},{"lineBreak":true},{"text":"i Andrianañahare Masiñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hierañerañe am-piandrazañe ao","poem":1},{"lineBreak":true},{"text":"o anak’añondrio,","poem":1},{"lineBreak":true},{"text":"naho hihinañe amo tete-","poem":1},{"lineBreak":true},{"text":"lovodovo’ o vondrakeo ty mpirererere.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Feh’ohatse amo mpikozozo-kakeo","poem":1},{"lineBreak":true},{"text":"an-taly hòakeo,","poem":1},{"lineBreak":true},{"text":"naho o tahiñeo hoe an-talin-tsarete:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie manao ty hoe: Ee t’ie halisa,","poem":1},{"lineBreak":true},{"text":"hanaentaeñe i fitoloña’ey,","poem":1},{"lineBreak":true},{"text":"hahaoniña’ay aze,","poem":1},{"lineBreak":true},{"text":"le ee te hitotoke eo ty fanoroa’","poem":1},{"lineBreak":true},{"text":"i Masi’ Israeley","poem":1},{"lineBreak":true},{"text":"homb’etoy hahafohina’ay Aze!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hekoheko ami’ty manao te raty ty soa, naho soa ty raty,","poem":1},{"lineBreak":true},{"text":"o misolo ty ieñe ho hazavàñe","poem":1},{"lineBreak":true},{"text":"naho ty hazavàñe ho ieñeo;","poem":1},{"lineBreak":true},{"text":"o manao ty mafaitse ho mamy","poem":1},{"lineBreak":true},{"text":"vaho ty mamy ho mafaitseo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hankàñe amo mahihitse","poem":1},{"lineBreak":true},{"text":"am-pahaoniña’eo","poem":1},{"noteId":20},{"text":",","poem":1},{"lineBreak":true},{"text":"naho o mahilala am-pahaisaha’eo!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Feh’ ohatse o fanalolahy am-pinon-divaio, naho ondaty maozatse","poem":1},{"lineBreak":true},{"text":"am-pampilaroañe toakeo;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ie mañatò ty lo-tsereke","poem":1},{"lineBreak":true},{"text":"hahazoam-bokàñe","poem":1},{"lineBreak":true},{"text":"vaho mañafake ty havañona’","poem":1},{"lineBreak":true},{"text":"o vantañeo!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le manahake ty fipiloran-afo","poem":1},{"lineBreak":true},{"text":"ty ahetse,","poem":1},{"lineBreak":true},{"text":"naho ty fampibotseha’ ty lel’afo","poem":1},{"lineBreak":true},{"text":"ty kafokafo’e,","poem":1},{"lineBreak":true},{"text":"ty hañamomohañe ty vaha’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho hiboele hoe deboke o voñe’ iareoo;","poem":1},{"lineBreak":true},{"text":"fa napo’ iareo ty Hà’ Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"naho nimavoe’ iareo","poem":1},{"lineBreak":true},{"text":"ty nafè’ i Masi’ Israeley.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Toly ndra miforoforo am’ ondati’eo","poem":1},{"lineBreak":true},{"text":"ty haviñera’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho natora-kitsi’e am’ iereo ty fità’e,","poem":1},{"lineBreak":true},{"text":"naho trinabotrabo’e;","poem":1},{"lineBreak":true},{"text":"nihondrahondra iaby o tambohoo,","poem":1},{"lineBreak":true},{"text":"natao litsake an-dalambey eo","poem":1},{"lineBreak":true},{"text":"ty lolo’ iareo.","poem":1},{"lineBreak":true},{"text":"Amy hoe zay iaby","poem":1},{"lineBreak":true},{"text":"mbe tsy nivike ty haviñera’e,","poem":1},{"lineBreak":true},{"text":"vaho mbe mihity avao ty fità’e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hañonjo kobaiñe amo kilakila ondaty tsietoitaneo Re,","poem":1},{"lineBreak":true},{"text":"naho hifioke ama’e boak’","poem":1},{"lineBreak":true},{"text":"añ’olo-ty tane toy añe, le hehe,","poem":1},{"lineBreak":true},{"text":"hiherereake mb’etoy masika.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tsy ho am’ iereo ty ho mokotse","poem":1},{"lineBreak":true},{"text":"ndra hitsikapy;","poem":1},{"lineBreak":true},{"text":"tsy eo ty hiroro ndra hirotse;","poem":1},{"lineBreak":true},{"text":"tsy habalake ty sadiam-bania’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hianto ty ­fihilin-kana’ iareo;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Masioñe o ana-pale’eo,","poem":1},{"lineBreak":true},{"text":"fonga mivohotse o fale’eo,","poem":1},{"lineBreak":true},{"text":"hoe vato-pilake o tombon-tsoavala’eo,","poem":1},{"lineBreak":true},{"text":"vaho talio o larò’eo;","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Hirohake hoe liona vave iereo,","poem":1},{"lineBreak":true},{"text":"hiroharoha hoe anan-diona,","poem":1},{"lineBreak":true},{"text":"Eka, mitrè iereo mitsepake i horoñeñey,","poem":1},{"lineBreak":true},{"text":"naho hendese’e añe,","poem":1},{"lineBreak":true},{"text":"ie tsy amam-pandrombake.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hitròñe amy andro zay iereo, manahake ty fitròña’ i riakey,","poem":1},{"lineBreak":true},{"text":"ie mahaisake i taney,","poem":1},{"lineBreak":true},{"text":"heheke ty hamoromoroñañe,","poem":1},{"lineBreak":true},{"text":"naho faloviloviañe,","poem":1},{"lineBreak":true},{"text":"ndra i hazavañey","poem":1},{"lineBreak":true},{"text":"ro ampigodoñen-drahoñe.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Rzs 3:7","reference":{"chapter":5,"verse":21}}]},"thisChapterLink":"/api/tdx_sle/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}