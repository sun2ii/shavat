{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":[{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Aia ty takelam-panarahañe","poem":1},{"lineBreak":true},{"text":"naneseako an-drene’ areo?","poem":1},{"lineBreak":true},{"text":"Ia amo mpampisongo amakoo","poem":1},{"lineBreak":true},{"text":"ty nandetahako anahareo?","poem":1},{"lineBreak":true},{"text":"Toe niletahañe ty amo tahi’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho o fiolà’ areoo","poem":1},{"lineBreak":true},{"text":"ty naneseañe ty rene’ areo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Akore te tsy teo ty ondaty,","poem":1},{"lineBreak":true},{"text":"te izaho nimb’eo?","poem":1},{"lineBreak":true},{"text":"Ie nikaike, tsy teo ty ho nanoiñe?","poem":1},{"lineBreak":true},{"text":"Bory hao ty sirako tsy hahafijebañe?","poem":1},{"lineBreak":true},{"text":"Aa vaho po-kaozarañe hao raho","poem":1},{"lineBreak":true},{"text":"tsy haharombake?","poem":1},{"lineBreak":true},{"text":"Heheke maiheko i riakey te endahako; anoeko ratraratra o sakao;","poem":1},{"lineBreak":true},{"text":"mantiñe o fia’eo kanao tsy an-drano,","poem":1},{"lineBreak":true},{"text":"mate’ ty arandrano.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sikinako mainte o likerañeo,","poem":1},{"lineBreak":true},{"text":"añombeako gony ho saroñe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa natolo’ i Talè, Iehovà ahiko","poem":1},{"lineBreak":true},{"text":"ty famele’ o nanàrañeo,","poem":1},{"lineBreak":true},{"text":"hampanintsiñako an-drehake","poem":1},{"lineBreak":true},{"text":"o mondetseo;","poem":1},{"lineBreak":true},{"text":"barakakaofe’e boa-maraiñe","poem":1},{"lineBreak":true},{"text":"tsekafe’e o sofikoo","poem":1},{"lineBreak":true},{"text":"hitsanoñe hoe t’ie mpioke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa nisokafe’ i Talè, Iehovà o sofikoo,","poem":1},{"lineBreak":true},{"text":"le tsy nanjehatse, tsy niamboho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Natoloko amo mpandafao ty lambosiko,","poem":1},{"lineBreak":true},{"text":"naho amo mpañono-boloo ty fifiko; tsy naetako ami’ty ònjitse naho","poem":1},{"lineBreak":true},{"text":"ami’ty rora ty tareheko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hañolotse ahy t’i Talè, Iehovà,","poem":1},{"lineBreak":true},{"text":"aa le tsy nisalatse;","poem":1},{"lineBreak":true},{"text":"nampigañeko hoe vato-paike ty tareheko,","poem":1},{"lineBreak":true},{"text":"le fantako te tsy ho meñatse;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"fa marine ao i Mpañatò ahikoy.","poem":1},{"lineBreak":true},{"text":"Ia ty hifañotake amako?","poem":1},{"lineBreak":true},{"text":"Antao songa hiongake;","poem":1},{"lineBreak":true},{"text":"Ia ty rafelahiko?","poem":1},{"lineBreak":true},{"text":"Angao re hitotoke amako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I Talè, Iehovà ro mpañolotse ahy;","poem":1},{"lineBreak":true},{"text":"ia ka ty hamatse ahy?","poem":1},{"lineBreak":true},{"text":"Fonga hihamodo hoe tsirodea; ho vazañem-pizara.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ia ama’ areo ty mañeveñe am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho mañorike ty feo’ i mpitoro’ey?","poem":1},{"lineBreak":true},{"text":"Aa ndra t’ie mañavelo añ’ieñe","poem":1},{"lineBreak":true},{"text":"ie tsy aman-kazavàñe,","poem":1},{"lineBreak":true},{"text":"le hiatoa’e ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hirampia’e t’i Andrianañahare’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O ry mpamiañe afoo,","poem":1},{"lineBreak":true},{"text":"o mpisikiñe vaen-afoo,","poem":1},{"lineBreak":true},{"text":"mandià amo lebaleban’ afo’ areoo,","poem":1},{"lineBreak":true},{"text":"amo vaen’afo niviañe’ areoo.","poem":1},{"lineBreak":true},{"text":"zao ty hizò anahareo an-tañako","poem":1},{"lineBreak":true},{"text":"t’ie handre an-anahelo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}