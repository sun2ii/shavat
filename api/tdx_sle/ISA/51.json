{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"Haoño iraho, ry mpañori-kavantañañe,","poem":1},{"lineBreak":true},{"text":"ry mipay Iehovà; itoliho i lamilamy","poem":1},{"lineBreak":true},{"text":"nampitserahañe anahareoy,","poem":1},{"lineBreak":true},{"text":"naho i koboñe nihaliañe anahareoy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haraharao t’i Avrahame rae’ areo,","poem":1},{"lineBreak":true},{"text":"naho i Sarae","poem":1},{"noteId":181},{"text":"nisamake anahareo","poem":1},{"lineBreak":true},{"text":"am-panaintaiñañe,","poem":1},{"lineBreak":true},{"text":"amy t’ie nirery avao te tinokako,","poem":1},{"lineBreak":true},{"text":"le nitahieko vaho nampitozantozañeko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nohoñe’ Iehovà t’i Tsione;","poem":1},{"lineBreak":true},{"text":"hene nampanintsiñe’e o tanan-taolo’eo,","poem":1},{"lineBreak":true},{"text":"naho nampanahafe’e amy Edene","poem":1},{"lineBreak":true},{"text":"o ratraratra’eo,","poem":1},{"lineBreak":true},{"text":"le hambañe amy golobo’ Iehovày o liolio’eo;","poem":1},{"lineBreak":true},{"text":"ho tendrek’ ao","poem":1},{"lineBreak":true},{"text":"ty firebehañe naho ty hafaleañe,","poem":1},{"lineBreak":true},{"text":"ty fañandriañañe naho ty feom-pisaboañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Haoño iraho ry ondatiko,","poem":1},{"lineBreak":true},{"text":"toloro ravembia ry fifeheako;","poem":1},{"lineBreak":true},{"text":"fa hiboak’ amako ty Hàke, vaho havereko ami’ty havañonako ho failo’ ondatio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa marine ty havantañako,","poem":1},{"lineBreak":true},{"text":"fa mionjom-beo ty fandrombahako,","poem":1},{"lineBreak":true},{"text":"vaho hizaka ondatio o sirakoo;","poem":1},{"lineBreak":true},{"text":"handiñe ahy o tokonoseo,","poem":1},{"lineBreak":true},{"text":"hiato ami’ty sirako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Andrandrao mb’andikerañe eñe","poem":1},{"lineBreak":true},{"text":"o fihaino’ areoo,","poem":1},{"lineBreak":true},{"text":"le isao ty tane ambane atoy;","poem":1},{"lineBreak":true},{"text":"fa himosaoñe hoe hatoeñe o likerañeo,","poem":1},{"lineBreak":true},{"text":"naho hihamodo hoe saroñe ty tane toy,","poem":1},{"lineBreak":true},{"text":"naho hihomake hoe izay ka ondatio;","poem":1},{"lineBreak":true},{"text":"fe ho nainai’e donia ty fandrombahako vaho le lia’e tsy haitoañe ty havantañako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mañaoña ahy ry ­mahafohin-kavañonañeo, ry ondaty mitan-Kake añ’arofoo;","poem":1},{"lineBreak":true},{"text":"ko ihembaña’areo ty ifañembaña’ondatio,","poem":1},{"lineBreak":true},{"text":"vaho ko ilonjera’ areo o inje’iareoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie ho hanem-­bararaoke hoe lamba,","poem":1},{"lineBreak":true},{"text":"naho habotsen-oletse hoe volonañondry;","poem":1},{"lineBreak":true},{"text":"fe nainai’e kitro añ’afe’e ty havantañako,","poem":1},{"lineBreak":true},{"text":"naho pak’ an-tariratse tsitso’e añe","poem":1},{"lineBreak":true},{"text":"ty fandrombahako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mivañona, Mivañona,","poem":1},{"lineBreak":true},{"text":"mañombea haozarañe ry fità’ Iehovà!","poem":1},{"lineBreak":true},{"text":"Mivañona manahake o andro taoloo","poem":1},{"lineBreak":true},{"text":"manahake o tariratse haehaeo.","poem":1},{"lineBreak":true},{"text":"Tsy Ihe hao ty nampitsera­tserake","poem":1},{"lineBreak":true},{"text":"i Rahabae? ty nitomboke i fañaneñey?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy Ihe hao ty nañamaike i riakey,","poem":1},{"lineBreak":true},{"text":"o rano’ i laleke mangonkoñeio;","poem":1},{"lineBreak":true},{"text":"mbore nanoa’o lalañe an-daleke ao","poem":1},{"lineBreak":true},{"text":"hitsaha’ o jinebañeo?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le himpoly o vinili’ Iehovà fiaiñeo, higodañe an-tsabo mbe Tsione mb’eo,","poem":1},{"lineBreak":true},{"text":"nainai’e hilolohe hafaleañe, naho handia taroba an-kaliforan-kaehake, vaho hihelañe añe ty haoreañe","poem":1},{"lineBreak":true},{"text":"naho ty fiselekaiñañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Izaho, le Izaho ty mañohò anahareo,","poem":1},{"lineBreak":true},{"text":"Ia-mb’arè irehe te ho hembañe am’ondaty","poem":1},{"lineBreak":true},{"text":"tsi-mahay tsy hivetrakeo,","poem":1},{"lineBreak":true},{"text":"naho amo ana-ondaty nanoen-ko ahetseo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nihaliño’o hao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianamboatse azo,","poem":1},{"lineBreak":true},{"text":"I namelatse o likerañeo","poem":1},{"lineBreak":true},{"text":"naho nañoreñe o faha’ ty tane toio?","poem":1},{"lineBreak":true},{"text":"ihe miriatsandry lomoñandro","poem":1},{"lineBreak":true},{"text":"ty amy haleveleve’ i mpamorekeke","poem":1},{"lineBreak":true},{"text":"mihentseñe handrotsakeiy!","poem":1},{"lineBreak":true},{"text":"Fa aia ty haromota’ i mpamolevoley?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho hahàñe aniany ty nasese-androhy;","poem":1},{"lineBreak":true},{"text":"tsy hizotso mb’ am-pihomahañe","poem":1},{"lineBreak":true},{"text":"mb’an-tsikeokeoke ao,","poem":1},{"lineBreak":true},{"text":"vaho tsy hieren-kaneñe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Izaho Iehovà Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"ty mampivalitaboake i riakey","poem":1},{"lineBreak":true},{"text":"vaho nampitroñe o onja’eo—","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa najoko am-palie’o ao o volakoo;","poem":1},{"lineBreak":true},{"text":"naho nanakoñe azo","poem":1},{"lineBreak":true},{"text":"ami’ty talinjon-tañako,","poem":1},{"lineBreak":true},{"text":"soa te hambole i likerañey,","poem":1},{"lineBreak":true},{"text":"naho hañoreñe ty tane toy,","poem":1},{"lineBreak":true},{"text":"vaho hanao ty hoe amy Tsione:","poem":1},{"lineBreak":true},{"text":"Ondatiko ‘n-iheo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mivañona, Mivañona,","poem":1},{"lineBreak":true},{"text":"mitroara ry Ierosalaime,","poem":1},{"lineBreak":true},{"text":"fa ninoma’o am-pità’","poem":1},{"lineBreak":true},{"text":"Iehovà i fitovim-piforoforoa’ey;","poem":1},{"lineBreak":true},{"text":"ie gineno’o reketse karafo’e","poem":1},{"lineBreak":true},{"text":"ty fitihem-pivembeñañe,","poem":1},{"lineBreak":true},{"text":"vaho nikapaihe’o.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy eo ty hiaolo aze","poem":1},{"lineBreak":true},{"text":"ami’ty hatozantoza’","poem":1},{"lineBreak":true},{"text":"o anake nisamahe’eo;","poem":1},{"lineBreak":true},{"text":"tsy eo ty mañoho-pitañe aze","poem":1},{"lineBreak":true},{"text":"amo ana-dahi’e tsifotofoto nibeize’eo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O raha roe zao ty hifetsak’ ama’o;","poem":1},{"lineBreak":true},{"text":"ia ty handala azo?","poem":1},{"lineBreak":true},{"text":"Ty fangoakoahañe naho ty fandrotsahañe,","poem":1},{"lineBreak":true},{"text":"ty kerè vaho ty fibara;","poem":1},{"lineBreak":true},{"text":"aia ty hañohòako azo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa toirañe o ana-dahi’oo,","poem":1},{"lineBreak":true},{"text":"mifitake amo lohan-dala’o iabio,","poem":1},{"lineBreak":true},{"text":"hoe fanaloke tsinepake an-karato;","poem":1},{"lineBreak":true},{"text":"lifore’ ty fifombo’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty fañendahan’ Añahare’o.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ehe janjiño zao ry mpisotry, naho","poem":1},{"lineBreak":true},{"text":"ry mpijike—fe tsy an-divay;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà Talè","poem":1},{"lineBreak":true},{"text":"naho i Andrianañahare’o milozoke","poem":1},{"lineBreak":true},{"text":"ty am’ ondati’eoy:","poem":1},{"lineBreak":true},{"text":"Hehe te rinambeko am-pità’o","poem":1},{"lineBreak":true},{"text":"ty fanovim-pivembeñañe,","poem":1},{"lineBreak":true},{"text":"naho ty fitovin-kaviñerako;","poem":1},{"lineBreak":true},{"text":"le lia’e tsy hinoma’o ka;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fa hapoko an-taña’","poem":1},{"lineBreak":true},{"text":"o mamorekeke azoo;","poem":1},{"lineBreak":true},{"text":"o nanao ty hoe ami’ty sandri’oo:","poem":1},{"lineBreak":true},{"text":"Mibaboha handialià’ay;","poem":1},{"lineBreak":true},{"text":"le nampanahafe’o amy taney","poem":1},{"lineBreak":true},{"text":"ty lambosi’o, vaho amy damokey","poem":1},{"lineBreak":true},{"text":"hijelajelaña’iareo.","poem":1}]}],"footnotes":[{"noteId":181,"caller":"+","text":"Sarae: rakemba: bey; panjaka; ana’e maro","reference":{"chapter":51,"verse":2}}]},"thisChapterLink":"/api/tdx_sle/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}