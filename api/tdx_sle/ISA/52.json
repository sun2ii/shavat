{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Mivañona, mivañona,","poem":1},{"lineBreak":true},{"text":"aombeo ty haozara’o ry Tsione;","poem":1},{"lineBreak":true},{"text":"sikino o saro’o fanjàkao,","poem":1},{"lineBreak":true},{"text":"ry Ierosalaime, rova miavakeo;","poem":1},{"lineBreak":true},{"text":"fa tsy himoak’ ama’o ka henane zao","poem":1},{"lineBreak":true},{"text":"o tsy nisavatseo naho o tsy malioo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ahifikifiho o debokeo;","poem":1},{"lineBreak":true},{"text":"miongaha, miambesara, r’Ierosalaime;","poem":1},{"lineBreak":true},{"text":"mibalaha amo taly am-bozo’oo,","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ i Tsione mirohio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"Ie naletake tsy amam-bili’e;","poem":1},{"lineBreak":true},{"text":"vaho tsy drala t’ie hijebañañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa hoe t’i Talè, Iehovà:","poem":1},{"lineBreak":true},{"text":"Nañavelo mb’e Mitsraime mb’eo","poem":1},{"lineBreak":true},{"text":"heike ondatiko taoloo, nitaveañe añe;","poem":1},{"lineBreak":true},{"text":"vaho finorekeke’ o nte-Asoreo","poem":1},{"lineBreak":true},{"text":"tsy aman-dengo’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa inoñe arè ty hanoeko atoy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, kanao nasese mb’eo","poem":1},{"lineBreak":true},{"text":"tsy amam-bili’e ondatikoo?","poem":1},{"lineBreak":true},{"text":"Mangolalaike o mpifele’ iareoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho nainai’e terateraeñe","poem":1},{"lineBreak":true},{"text":"ty añarako","poem":1},{"noteId":182},{"text":", toe lomoñandro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le hahafohiñe ty añarako ondatikoo;","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’ iareo amy andro zay,","poem":1},{"lineBreak":true},{"text":"te Izaho ty manao ty hoe: Intoy iraho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fanjaka amo haboañeo","poem":1},{"lineBreak":true},{"text":"o fandiam-pañitrike talily soao,","poem":1},{"lineBreak":true},{"text":"ty mitsey fierañerañañe,","poem":1},{"lineBreak":true},{"text":"ty mitaroñe entan-tsoa,","poem":1},{"lineBreak":true},{"text":"ty mikoike fandrombahañe","poem":1},{"lineBreak":true},{"text":"vaho manao amy Tsione ty hoe:","poem":1},{"lineBreak":true},{"text":"Mifehe t’i Andrianañahare’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Inao ty mpijilo’ areo! Mampipoña-peo, mitrao-pisaboañe;","poem":1},{"lineBreak":true},{"text":"fa ho isam-pihaino’ iareo ty fibaliha’ Iehovà mb’e Tsione ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mipoñafa an-drebeke,","poem":1},{"lineBreak":true},{"text":"miredoña an-tsabo,","poem":1},{"lineBreak":true},{"text":"ry tanan-taolo’ Ierosalaime;","poem":1},{"lineBreak":true},{"text":"fa nañohò ondati’eo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"jineba’e t’Ierosalaime.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hinalo’ Iehovà ty fità’e masiñe","poem":1},{"lineBreak":true},{"text":"am-pihaino’ o kilakila’ ndatio;","poem":1},{"lineBreak":true},{"text":"vaho hahaoniñe ty fandrombahan’","poem":1},{"lineBreak":true},{"text":"Añaharen-tika o añ’olo-ty tane toy iabio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Miavota, Miengà, miakara boak’ ao,","poem":1},{"lineBreak":true},{"text":"ko mitsapa raha maleotse;","poem":1},{"lineBreak":true},{"text":"miakara boak’ añivo’e ao,","poem":1},{"lineBreak":true},{"text":"miliova, ry mpinday o harao’ Iehovào.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsy halisa hiavotse nahareo,","poem":1},{"lineBreak":true},{"text":"naho tsy hivoratsake mb’eo;","poem":1},{"lineBreak":true},{"text":"amy te hiaolo anahareo t’Iehovà","poem":1},{"lineBreak":true},{"text":"vaho hivoly anahareo","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ingo, hiraorao i mpitorokoy,","poem":1},{"lineBreak":true},{"text":"hongaheñe naho honjoneñe","poem":1},{"lineBreak":true},{"text":"mb’andindiñe añe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manahake te nimaro ty nitoritotse ty ama’o— ie dinemoke i lahara’ey,","poem":1},{"lineBreak":true},{"text":"hoe tsy ondaty, naho ty fañova’e","poem":1},{"lineBreak":true},{"text":"hoe tsy ana’ondaty—","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ie henaneo ro hampi­tsekake fifeheañe maro,","poem":1},{"lineBreak":true},{"text":"mijomohòñe ama’e o mpanjakao;","poem":1},{"lineBreak":true},{"text":"amy te ho isa’ iareo","poem":1},{"lineBreak":true},{"text":"o mboe tsy nitalilañeo,","poem":1},{"lineBreak":true},{"text":"vaho ho oni’ iareo o mboe","poem":1},{"lineBreak":true},{"text":"tsy jinanji’iareo.","poem":1}]}],"footnotes":[{"noteId":182,"caller":"+","text":"Sab 74:10, 74:18, Avo 20:7, Its 5:11","reference":{"chapter":52,"verse":5}}]},"thisChapterLink":"/api/tdx_sle/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}