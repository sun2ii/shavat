{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":["Ia ty hiantoke ty taro’ay?",{"text":"naboak’ ama’ia ty fità’ Iehovà?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie nitiry añatrefa’e eo","poem":1},{"lineBreak":true},{"text":"hoe toran-katae,","poem":1},{"lineBreak":true},{"text":"hoe vahatse an-tane maike.","poem":1},{"lineBreak":true},{"text":"Ie tsy naràm-bintañe","poem":1},{"lineBreak":true},{"text":"tsy amañ’asiñe te nisambà’ay;","poem":1},{"lineBreak":true},{"text":"tsy ni-soa-vintañe hahasinda anay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nisirikaeñe, nitorifiha’ ondaty,","poem":1},{"lineBreak":true},{"text":"lahilahy nalovilovy,","poem":1},{"lineBreak":true},{"text":"nahafohim-pandalàñe,","poem":1},{"lineBreak":true},{"text":"hoe itakonan-tarehe; nimavoeñe","poem":1},{"lineBreak":true},{"text":"vaho tsy nañaoñe Aze tikañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Toe nivavè’e o haorean-tikañeo,","poem":1},{"lineBreak":true},{"text":"nendese’e o hasilofan-tikañeo;","poem":1},{"lineBreak":true},{"text":"fa nataon-tika t’ie vinango,","poem":1},{"lineBreak":true},{"text":"linafan’Añahare, nisilofeñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O fiolàn-tikañeo ty nandratañe aze,","poem":1},{"lineBreak":true},{"text":"o tahin-tikañeo ty nandemohañe aze;","poem":1},{"lineBreak":true},{"text":"tama’e ty fandilovañe ninday","poem":1},{"lineBreak":true},{"text":"fanintsiñañe aman-tikañe;","poem":1},{"lineBreak":true},{"text":"o fere’eo ro mahajangañ’antika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Songa nandrike hoe añondry","poem":1},{"lineBreak":true},{"text":"sindre nitsile amy lia’ey;","poem":1},{"lineBreak":true},{"text":"fonga nampivavè’ Iehovà aze","poem":1},{"lineBreak":true},{"text":"o hakeon-tikañeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niforekekeñe naho nampiambaneñe,","poem":1},{"lineBreak":true},{"text":"f’ie tsy nanoka-palie;","poem":1},{"lineBreak":true},{"text":"hoe anak’añondry tantalieñe ho lentaeñe,","poem":1},{"lineBreak":true},{"text":"hambañe ami’ty fitsìn’añondry","poem":1},{"lineBreak":true},{"text":"añatrefa’ o mpañitsikeo,","poem":1},{"lineBreak":true},{"text":"t’ie tsy nanoka-palie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fiforeforeañe naho zaka","poem":1},{"lineBreak":true},{"text":"ty naneseañe aze;","poem":1},{"lineBreak":true},{"text":"Ia ty ho nahafitoky ty loak’andro’e","poem":1},{"lineBreak":true},{"text":"kanao naitoañe an-tanen-kaveloñe;","poem":1},{"lineBreak":true},{"text":"ie pinaoke ty amo fiolà’ ondatikoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nampindrezeñe amo tsereheñeo ty kibori’e,","poem":1},{"lineBreak":true},{"text":"vaho niharoe’e havilasy o mpañalealeo,","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy nijoy,","poem":1},{"lineBreak":true},{"text":"vaho tsy tam-palie’e ao ty famañahiañe","poem":1},{"noteId":183},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"F’ie ninò’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty handemoke aze","poem":1},{"lineBreak":true},{"text":"naho ty haniloke aze,","poem":1},{"lineBreak":true},{"text":"aa ie nañenga ty fiai’e","poem":1},{"lineBreak":true},{"text":"ho efe-tahiñe,","poem":1},{"lineBreak":true},{"text":"le hahavazoho tariratse,","poem":1},{"lineBreak":true},{"text":"naho hitompeañ’andro,","poem":1},{"lineBreak":true},{"text":"vaho hiraorao am-pità’e","poem":1},{"lineBreak":true},{"text":"o satrin’ arofo’ Iehovào.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho isa’e ty vokam-paloviloviam-piai’e","poem":1},{"lineBreak":true},{"text":"le hanintsiñe;","poem":1},{"lineBreak":true},{"text":"ty hilala’ i mpitoroko vantañey","poem":1},{"lineBreak":true},{"text":"ro hañavantañe ty maro;","poem":1},{"lineBreak":true},{"text":"ie ty mivave o tahi’ iareoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le hitolorako tambe añivo’","poem":1},{"lineBreak":true},{"text":"o manjofakeo,","poem":1},{"lineBreak":true},{"text":"le handivà’e amo fanalolahio","poem":1},{"lineBreak":true},{"text":"i nikopaheñey,","poem":1},{"lineBreak":true},{"text":"amy te nadoa’e an-kavilasy ty fiai’e,","poem":1},{"lineBreak":true},{"text":"naho vinolily amo mpanan-kakeoo,","poem":1},{"lineBreak":true},{"text":"nilogologoe’e ty tahi’ o maroo,","poem":1},{"lineBreak":true},{"text":"vaho jineba’e o manan-tahiñeo.","poem":1}]}],"footnotes":[{"noteId":183,"caller":"+","text":"Pe I 2:22","reference":{"chapter":53,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/52.json","previousCha