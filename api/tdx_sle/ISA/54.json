{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Mirebeha ry betsiterake,","poem":1},{"lineBreak":true},{"text":"ihe tsy nanaranake,","poem":1},{"lineBreak":true},{"text":"mipoñafa sabo,","poem":1},{"lineBreak":true},{"text":"mipazapazaha ry tsy nitsongo!","poem":1},{"lineBreak":true},{"text":"Fa maro ty ana’ i vahiniy, te amo ana’ i amam-baliio,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Itàro ty toen-kiboho’o,","poem":1},{"lineBreak":true},{"text":"tibaho o lamba fañefen’ akiba’oo,","poem":1},{"lineBreak":true},{"text":"naho ko tomoreñe;","poem":1},{"lineBreak":true},{"text":"halavao o tali’oo,","poem":1},{"lineBreak":true},{"text":"vaho haozaro o tsato’oo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amy t’ie hañivake mb’ankavana,","poem":1},{"lineBreak":true},{"text":"naho mb’ankavia;","poem":1},{"lineBreak":true},{"text":"naho handova o kilakila’ ndatio o tarira’oo,","poem":1},{"lineBreak":true},{"text":"vaho hampimoneñañe o rova mangoakoakeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ko hemban-drehe fa tsy ho salatse,","poem":1},{"lineBreak":true},{"text":"ko meñatse, fa tsy hinjèñe,","poem":1},{"lineBreak":true},{"text":"toe ho haliño’o ty hameñaran-katora’o,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho tiahi’o ka","poem":1},{"lineBreak":true},{"text":"ty fañinjeañe i haramavoi’oy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa tañanjomba’o i Mpamboatse azoy,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e;","poem":1},{"lineBreak":true},{"text":"t’i Masi’ Israele ro Mpijeba’o,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ ty tane toy","poem":1},{"lineBreak":true},{"text":"ro fikanjiañe Aze.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nitok’azo t’Iehovà hoe valy","poem":1},{"lineBreak":true},{"text":"naforintseñe naho mihontoke,","poem":1},{"lineBreak":true},{"text":"aa kanao valin-katora’e,","poem":1},{"lineBreak":true},{"text":"hapoke hao?","poem":1},{"lineBreak":true},{"text":"hoe t’i Andrianañahare.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Andro bory ty namorin­tseñako azo;","poem":1},{"lineBreak":true},{"text":"fe am-piferenaiñañe jabajaba","poem":1},{"lineBreak":true},{"text":"ty hanontonako azo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fifomboañe fohe","poem":1},{"lineBreak":true},{"text":"ty nañetahako ama’o ty tareheko;","poem":1},{"lineBreak":true},{"text":"fe am-pikokoañe migahiñe nainai’e","poem":1},{"lineBreak":true},{"text":"ty hiferenaiñako,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà Mpijeba’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toe rano’ i ­Noake amako itoy;","poem":1},{"lineBreak":true},{"text":"amy te hambañe ami’ty nandi­liako te tsy hañàmpo ty tane toy ka i rano’ i Noakey,","poem":1},{"lineBreak":true},{"text":"le nititiheko ka t’ie tsy hibosehako","poem":1},{"lineBreak":true},{"text":"vaho tsy ho trevoheko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa hafahañe o vohitseo,","poem":1},{"lineBreak":true},{"text":"naho haveve o haboañeo;","poem":1},{"lineBreak":true},{"text":"fe tsy hieng’azo ty fiferenaiñako,","poem":1},{"lineBreak":true},{"text":"vaho tsy hovaeñe i fañinam-pilongoakoy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà mpiferenaiñ’azo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O ry malorè avalitaboa’ i tio-beiy,","poem":1},{"lineBreak":true},{"text":"ie tsy amam-pañohò,","poem":1},{"lineBreak":true},{"text":"heheke te harafeko am-bolo soa","poem":1},{"lineBreak":true},{"text":"o vato’oo, naho ho tsenèko","poem":1},{"lineBreak":true},{"text":"an-tsafira o faha’oo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hanoeko roy o tilik’abo’oo,","poem":1},{"lineBreak":true},{"text":"le am-bato mañabasà o lalam-bei’oo,","poem":1},{"lineBreak":true},{"text":"vaho am-batosoa o olotsolotseo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hene hanare’ Iehovà o ana’oo;","poem":1},{"lineBreak":true},{"text":"vaho hampitomboeñe","poem":1},{"lineBreak":true},{"text":"ty fierañeraña’ o keleia’oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Horizañe an-kavantañan-drehe;","poem":1},{"lineBreak":true},{"text":"hitots’azo ty famorekekeañe,","poem":1},{"lineBreak":true},{"text":"tsy hihembaña’o,","poem":1},{"lineBreak":true},{"text":"tsy hitotok’ azo ka o fandrotsahañeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mete hifanontone iereo,","poem":1},{"lineBreak":true},{"text":"fa tsy ty amako;","poem":1},{"lineBreak":true},{"text":"hikorovoke añatrefa’o eo","poem":1},{"lineBreak":true},{"text":"ze mikitroke azo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Izaho ‘nio ty nanao i mpanefe","poem":1},{"lineBreak":true},{"text":"mitiotioke vaen’afoy,","poem":1},{"lineBreak":true},{"text":"Ie añakara’e fialiañe hitoloña’e;","poem":1},{"lineBreak":true},{"text":"nanoeko ka ty mpijoy hijoia’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy hanjofake ze fialiañe","poem":1},{"lineBreak":true},{"text":"namboareñe haname azo;","poem":1},{"lineBreak":true},{"text":"naho fonga hafà’o ze fameleke","poem":1},{"lineBreak":true},{"text":"hitroatse hiatreatre azo an-jaka.","poem":1},{"lineBreak":true},{"text":"izay ty lova’ o mpitoro’ Iehovào,","poem":1},{"lineBreak":true},{"text":"vaho tamako ty havantaña’ iareo","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}