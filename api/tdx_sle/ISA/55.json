{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":55,"content":[{"type":"verse","number":1,"content":[{"text":"O ry taliñiereñeo!","poem":1},{"lineBreak":true},{"text":"Mb’an-drano mb’etoa!","poem":1},{"lineBreak":true},{"text":"Ry tsy aman-dràlao, mb’etoa mivily,","poem":1},{"lineBreak":true},{"text":"vaho mikama,","poem":1},{"lineBreak":true},{"text":"eka, ikalò divay naho ronono","poem":1},{"lineBreak":true},{"text":"tsy aman-drala, tsy amam-bili’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inoñe ty andrita’ areo drala","poem":1},{"lineBreak":true},{"text":"amo tsy mahakamao, naho itoloña’ areo o tsy mañenekeo?","poem":1},{"lineBreak":true},{"text":"Haoño iraho, mitsatsiha,","poem":1},{"lineBreak":true},{"text":"vaho kamao ty soa,","poem":1},{"lineBreak":true},{"text":"ampifaleo ty fiai’ areo ami’ty betro’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atokilaño amako o ravembia’ areoo;","poem":1},{"lineBreak":true},{"text":"Mijanjiña, hahaveloñe ty tro’ areo,","poem":1},{"lineBreak":true},{"text":"vaho hanoako fañina tsy modo, o fiferenaiña’ i Davideo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ingo, t’ie nanoeko mpañalañalañe","poem":1},{"lineBreak":true},{"text":"amo kilakila’ndatio,","poem":1},{"lineBreak":true},{"text":"mpiaolo naho mpameleke ondaty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ingo! ho koihe’o ty tane tsy fohi’o,","poem":1},{"lineBreak":true},{"text":"vaho hilay mb’ama’o mb’eo","poem":1},{"lineBreak":true},{"text":"ty tane tsy mahafohiñe azo, ty am’ Iehovà, Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"i Masi’ Israeley, ihe nitolora’e engeñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paiao t’Iehovà ie mbe mete ho oniñe, ikanjio te mbe marine eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ee te hapo’ i tsereheñey o sata rati’eo vaho hado’ i mengokey o fikinià’eo;","poem":1},{"lineBreak":true},{"text":"himpoly mb’am’ Iehovà hitretreza’e,","poem":1},{"lineBreak":true},{"text":"naho mb’aman’ Añahare","poem":1},{"lineBreak":true},{"text":"hilosora’e tàha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toe tsy fitsakoreako o vetsevetse’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy lalako o lala’ areoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mira ami’ty maha ambone’ ty tane toy","poem":1},{"lineBreak":true},{"text":"o likerañeo","poem":1},{"lineBreak":true},{"text":"ty ha-andikera’ o lalakoo","poem":1},{"lineBreak":true},{"text":"te amo sata’ areoo,","poem":1},{"lineBreak":true},{"text":"naho o ereñerekoo","poem":1},{"lineBreak":true},{"text":"te amo fitsakorean-tro’ areoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty fiavi’ o orañeo naho","poem":1},{"lineBreak":true},{"text":"o oram-panala boak’ andindiñeo","poem":1},{"lineBreak":true},{"text":"ie tsy mibalike, naho tsy","poem":1},{"lineBreak":true},{"text":"tondraha’e hey o taneo","poem":1},{"lineBreak":true},{"text":"hampamokara’e naho hampitovoaña’e, hamahana’e doria ami” ty mpitongy naho ampemba ami’ty mikama,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe izay ty fiakara’ ty entako","poem":1},{"lineBreak":true},{"text":"am-bavako ao;","poem":1},{"lineBreak":true},{"text":"ie tsy holy mañomaño amako, fa ho fonire’e o satrikoo,","poem":1},{"lineBreak":true},{"text":"vaho ho henefe’e ty namantohako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hiavotse an-kafaleañe nahareo, vaho hampionjoneñe","poem":1},{"lineBreak":true},{"text":"am-pierañerañañe;","poem":1},{"lineBreak":true},{"text":"ho poñafe’ o vohitseo ty sabo aolo’ areo,","poem":1},{"lineBreak":true},{"text":"le hene hiteha-tañañe","poem":1},{"lineBreak":true},{"text":"ze hatae am-patrañe añe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hitovoañe hisolo ty fatike","poem":1},{"lineBreak":true},{"text":"ty mendoraveñe, vaho handimbe","poem":1},{"lineBreak":true},{"text":"ty hisatse ty beifelañe.","poem":1},{"lineBreak":true},{"text":"Ho fitiahiañe Iehovà izay,","poem":1},{"lineBreak":true},{"text":"ho viloñe nainai’e tsy modo, tsy haitoañe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}