{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"Hoe t’Iehovà: Mifahara ami’ty hatò,","poem":1},{"lineBreak":true},{"text":"naho ano ty havantañañe;","poem":1},{"lineBreak":true},{"text":"toe mitotoke mb’eo ty fandrombahako,","poem":1},{"lineBreak":true},{"text":"vaho ho bentareñe ty havañonako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haha t’indaty manao zao","poem":1},{"lineBreak":true},{"text":"naho ty ana’ondaty","poem":1},{"lineBreak":true},{"text":"mivontititse ama’e;","poem":1},{"lineBreak":true},{"text":"te ambena’e i Sabotsey","poem":1},{"lineBreak":true},{"text":"tsy hañotà’e faly, vaho","poem":1},{"lineBreak":true},{"text":"tana’e ty fità’e tsy hanoe’e raty.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsy apo’e hanao ty hoe,","poem":1},{"lineBreak":true},{"text":"i renetane mpirekets’ am’ Iehovày:","poem":1},{"lineBreak":true},{"text":"Toe havi’ Iehovà am’ondati’eo iraho;","poem":1},{"lineBreak":true},{"text":"vaho tsy hado’e hanao ty hoe ty vositse:","poem":1},{"lineBreak":true},{"text":"Inao! Hatae maike iraho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa hoe ty nafè’ Iehovà:","poem":1},{"lineBreak":true},{"text":"O vositse mpitañ’ o Sabatakoo,","poem":1},{"lineBreak":true},{"text":"naho mijoboñe o mahafale ahikoo,","poem":1},{"lineBreak":true},{"text":"vaho mifahatse amy fañinakoy:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho tolorako lily","poem":1},{"lineBreak":true},{"text":"naho tahinañe an-trañoko ao","poem":1},{"lineBreak":true},{"text":"naho am-po’ o rindrikoo","poem":1},{"lineBreak":true},{"text":"ambone’ ze atao anadahy","poem":1},{"lineBreak":true},{"text":"naho anak’ ampela:","poem":1},{"lineBreak":true},{"text":"hitolorako tahinañe tsy ho modo,","poem":1},{"lineBreak":true},{"text":"tsy haitoañe nainai’e","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le o renetane mpirekets’ am’ Iehovà hiatrak’ Aze,","poem":1},{"lineBreak":true},{"text":"hikoko ty tahina’ Iehovà ho mpitoro’eo,","poem":1},{"lineBreak":true},{"text":"ze mañambeñe i Sabotsey tsy haniva aze,","poem":1},{"lineBreak":true},{"text":"vaho mifahatse amy fañinakoy:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie ro hendeseko","poem":1},{"lineBreak":true},{"text":"mb’amy vohiko miavakey mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho hampifalèko an-kivohom-","poem":1},{"lineBreak":true},{"text":"pitalahoako ao;","poem":1},{"lineBreak":true},{"text":"ho rambeseñe amy kitrelikoy","poem":1},{"lineBreak":true},{"text":"ty enga’ holora’ iareo","poem":1},{"lineBreak":true},{"text":"naho o fisoroña’ iareoo;","poem":1},{"lineBreak":true},{"text":"amy te hatao: Anjombam-pitalahoa’","poem":1},{"lineBreak":true},{"text":"ze kila ondaty ty kivohoko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hoe t’i Talè, Iehovà,","poem":1},{"lineBreak":true},{"text":"Mpanontone o naitoañe","poem":1},{"lineBreak":true},{"text":"amo ana’ Israeleo,","poem":1},{"lineBreak":true},{"text":"Mbe eo ty havoriko ho ama’e","poem":1},{"lineBreak":true},{"text":"amo fa natontoko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O ry biby an-kivok’ ao,","poem":1},{"lineBreak":true},{"text":"mb’etoa hampibotseke,","poem":1},{"lineBreak":true},{"text":"eka ry hene biby añ’ala ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Goa o mpijilo’eo,","poem":1},{"lineBreak":true},{"text":"Songa tsy aman-kilala;","poem":1},{"lineBreak":true},{"text":"Sindre amboa bobo tsy maha-hiake;","poem":1},{"lineBreak":true},{"text":"mañinofy t’ie mibabòfoke, mpitea-roro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Eka matity o amboao,","poem":1},{"lineBreak":true},{"text":"tsy apota’iareo ty atao etsake, toe mpiarak’añondry","poem":1},{"lineBreak":true},{"text":"tsy mahafohiñe, o retiañe;","poem":1},{"lineBreak":true},{"text":"songa mitsile mb’an-dala’e mb’eo","poem":1},{"lineBreak":true},{"text":"sindre mampitombo ty aze avao","poem":1},{"lineBreak":true},{"text":"pak’ an-tsitso’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Antao, hoe iereo, Hangalake divay,","poem":1},{"lineBreak":true},{"text":"hampiboboke ty tron-tika an-toake;","poem":1},{"lineBreak":true},{"text":"le hanahake ty andro toy avao","poem":1},{"lineBreak":true},{"text":"ty hamaray, fe ampitoaboreñe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}