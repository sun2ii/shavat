ineBreak":true},{"text":"Tsy anam-piolàñe hao ry","poem":1},{"lineBreak":true},{"text":"tirim-pandañirañeo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inahareo mpañiri-­mena ambane’ kileo","poem":1},{"lineBreak":true},{"text":"ambane ze hatae mandrevakeo;","poem":1},{"lineBreak":true},{"text":"o mpamono ajaja am-bavataneo,","poem":1},{"lineBreak":true},{"text":"ambane’ o tevam-batoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amo vato nivañeñe an-goledoñ’ ao","poem":1},{"lineBreak":true},{"text":"ty anjara’o, mañeva azo izay,","poem":1},{"lineBreak":true},{"text":"mbore nañiliña’o engan-drano,","poem":1},{"lineBreak":true},{"text":"nibanabanà’o engan-kaneñe.","poem":1},{"lineBreak":true},{"text":"Hitsiñe amy tsaraeñey hao iraho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa nalafi’o ambone vohitse mitiotiotse eo ty tìhi’o;","poem":1},{"lineBreak":true},{"text":"le nimb’eo hañenga soroñe,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nañoreñ’ajiba amboho lalañe naho tsotsoke ao;","poem":1},{"lineBreak":true},{"text":"ie nañafa-tsaroñe fa tsy amako,","poem":1},{"lineBreak":true},{"text":"niañambone, namelatse i tihi’oy,","poem":1},{"lineBreak":true},{"text":"le nilahatse am’ iereo","poem":1},{"lineBreak":true},{"text":"vaho nitea’o ty tihi’ iareo","poem":1},{"lineBreak":true},{"text":"te nitsikaoreñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nomba’o reke-tsolike i mpanjakay,","poem":1},{"lineBreak":true},{"text":"le nampitomboe’o o rano-mañi’oo,","poem":1},{"lineBreak":true},{"text":"nampihitrife’o añe o sorotà’oo,","poem":1},{"lineBreak":true},{"text":"ihe nihotrake mb’an-tsikeokeoke ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nahamokotse azo ty halava’ i lia’oy;","poem":1},{"lineBreak":true},{"text":"f’ie tsy nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Po-pitamañe.","poem":1},{"lineBreak":true},{"text":"Nisolebatse indraike ty fañiria’o,","poem":1},{"lineBreak":true},{"text":"vaho tsy nilesa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ia ty nihembaña’o naho nañeveña’o?","poem":1},{"lineBreak":true},{"text":"Akore te nandañira’o naho","poem":1},{"lineBreak":true},{"text":"tsy nitiahie’o vaho tsy nitsakorea’o?","poem":1},{"lineBreak":true},{"text":"Kanao hatr’ela’e ty nitsiñako","poem":1},{"lineBreak":true},{"text":"ihe tsy mañeveñe amako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho taroñeko ty hamarentane’o,","poem":1},{"lineBreak":true},{"text":"naho o fitoloña’oo—","poem":1},{"lineBreak":true},{"text":"f'ie tsy ho vara ama’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ihe mitoreo,","poem":1},{"lineBreak":true},{"text":"hahahah’ azo hao o raha nahoro’oo;","poem":1},{"lineBreak":true},{"text":"fa fonga hasiotsion-tioke,","poem":1},{"lineBreak":true},{"text":"ho vavèn-kofòke mb’eo;","poem":1},{"lineBreak":true},{"text":"fa ho fanaña’ i mitsoloke amakoy i taney, vaho ho lovae’e i vohiko miavakey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le ho koiheñe ty hoe:","poem":1},{"lineBreak":true},{"text":"Ahifiho mañambone,","poem":1},{"lineBreak":true},{"text":"Aobòño ambone ey,","poem":1},{"lineBreak":true},{"text":"afaho iaby ze sebañe","poem":1},{"lineBreak":true},{"text":"an-dala’ ondatikoo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fa hoe ty nafè’ i Antiotiotsey,","poem":1},{"lineBreak":true},{"text":"i Andindimoneñe mpimoneñe","poem":1},{"lineBreak":true},{"text":"an-tsi-fimodoañey,","poem":1},{"lineBreak":true},{"text":"ie kanjieñe ty hoe: Masiñe.","poem":1},{"lineBreak":true},{"text":"Izaho mpitoboke amy abo naho masiñey—mpiamako ty mibàboke","poem":1},{"lineBreak":true},{"text":"naho ty mirèke añ’ova’e ao,","poem":1},{"lineBreak":true},{"text":"hameloñe ty arofo miambane,","poem":1},{"lineBreak":true},{"text":"vaho hampibodañe ty troke misoloho.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Toe tsy ­hifañotakotake nainai’e iraho,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho boseke kitro katroke;","poem":1},{"lineBreak":true},{"text":"hera hamoe’ay o troke aolokoo,","poem":1},{"lineBreak":true},{"text":"naho o arofo nitsenèkoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty haratia’ i fihaña’ey ty nibosehako naho nandafàko,","poem":1},{"lineBreak":true},{"text":"nietake am-pifomboan-draho;","poem":1},{"lineBreak":true},{"text":"f’ie nitolom-piola","poem":1},{"lineBreak":true},{"text":"ami’ty fombàn-tro’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa nitreako o sata’eo,","poem":1},{"lineBreak":true},{"text":"fe ho jangañeko;","poem":1},{"lineBreak":true},{"text":"naho hiaoloako, vaho ho vaoeko ama’e","poem":1},{"lineBreak":true},{"text":"naho amo mpandala’eo ty fañohòañe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Izaho ty mitsene o vokam-pivimbio;","poem":1},{"lineBreak":true},{"text":"fanintsiñañe, fanintsiñañe,","poem":1},{"lineBreak":true},{"text":"amy tsietoitaney naho","poem":1},{"lineBreak":true},{"text":"amy marivoy, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho ho melañeko.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa manahake i riake mivalitaboakey","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo;","poem":1},{"lineBreak":true},{"text":"amy te tsy mete mipendreñe,","poem":1},{"lineBreak":true},{"text":"vaho aretsa’ o ranoo mañambone","poem":1},{"lineBreak":true},{"text":"ty leotse naho loto.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy am-pierañerañañe","poem":1},{"lineBreak":true},{"text":"o rati-tserekeo.","poem":1},{"lineBreak":true},{"text":"hoe t’i Andrianañahareko,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}