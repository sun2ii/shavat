{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":58,"content":[{"type":"verse","number":1,"content":[{"text":"Mikoiha, ko mifoneñe,","poem":1},{"lineBreak":true},{"text":"mipoñafa-feo hoe antsiva, vaho","poem":1},{"lineBreak":true},{"text":"taroño am’ondatikoo ty fiolà’ iareo,","poem":1},{"lineBreak":true},{"text":"naho am’ Iakobe o tahi’eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Boak’andro iereo manao te mipay ahy,","poem":1},{"lineBreak":true},{"text":"le mintse mifale handrendreke","poem":1},{"lineBreak":true},{"text":"o satakoo, manahake t’ie","poem":1},{"lineBreak":true},{"text":"fifeheañe mpanao havantañañe,","poem":1},{"lineBreak":true},{"text":"hoe mbe lia’e tsy naforintse’e","poem":1},{"lineBreak":true},{"text":"o fañèn’ Añahare’eo,","poem":1},{"lineBreak":true},{"text":"vaho mipay zaka to amako,","poem":1},{"lineBreak":true},{"text":"inao mahafale iareo ty","poem":1},{"lineBreak":true},{"text":"mañarine aman’Añahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ino ty nililira’ay,","poem":1},{"lineBreak":true},{"text":"ihe tsy mahavazoho anay?","poem":1},{"lineBreak":true},{"text":"Akore te nijoie’ay o tro’aio","poem":1},{"lineBreak":true},{"text":"fe tsy nihaoñe’o?","poem":1},{"lineBreak":true},{"text":"Inao! amy androm-pililira’ areoy","poem":1},{"lineBreak":true},{"text":"ro mbore mitolon-draha,","poem":1},{"lineBreak":true},{"text":"naho mampifanehake mpitoroñe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isao te fañòlañe naho fifandierañe avao ty fililira’ areo, hanjevoña’ areo an-­komondron-kalo-tserehañe.","poem":1},{"lineBreak":true},{"text":"Tsy ho janjiñeñe an-dindimoneñe ey","poem":1},{"lineBreak":true},{"text":"i fililira’ areo anindroaniy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zao hao o fililirañe jinoboko","poem":1},{"lineBreak":true},{"text":"ho androm-pilieram-batañeo?","poem":1},{"lineBreak":true},{"text":"T’ie ho fihohòfañe hoe bararata hao,","poem":1},{"lineBreak":true},{"text":"naho ho fandafihañe gony naho","poem":1},{"lineBreak":true},{"text":"lavenoke ambane eo?","poem":1},{"lineBreak":true},{"text":"Izay hao ty atao’ areo ho lilitse,","poem":1},{"lineBreak":true},{"text":"ho andro no’ Iehovà?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy itoy hao o fililirañe joboñekoo?","poem":1},{"lineBreak":true},{"text":"ty fañahàñe o silisilin-­kalo-tserehañeo naho ty hampibalahañe","poem":1},{"lineBreak":true},{"text":"o tali-randran-jokao,","poem":1},{"lineBreak":true},{"text":"ty hamotsorañe o forekekèñeo naho ty hampipozahañe","poem":1},{"lineBreak":true},{"text":"ze hene ana-joka?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy ty handivàñe ty mahakama’o","poem":1},{"lineBreak":true},{"text":"amo salikoeñeo hao, naho","poem":1},{"lineBreak":true},{"text":"ty hampihovàñe añ’anjomba’o ao","poem":1},{"lineBreak":true},{"text":"i mavomavo natao’o soike rezay, naho","poem":1},{"lineBreak":true},{"text":"ty hanikinañe ty miboridañe","poem":1},{"lineBreak":true},{"text":"te oni’o, vaho tsy iambohoa’o","poem":1},{"lineBreak":true},{"text":"ty nofots’aman-dio’o?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie amy zao hipelatse ty hazavà’o","poem":1},{"lineBreak":true},{"text":"manahake te manjirik’ andro,","poem":1},{"lineBreak":true},{"text":"le halisa ty fijangaña’o,","poem":1},{"lineBreak":true},{"text":"hiaolo azo ty havañona’o,","poem":1},{"lineBreak":true},{"text":"vaho hanehak’ azo ty enge’ Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hikanjy irehe henane zay,","poem":1},{"lineBreak":true},{"text":"le hanoiñe azo t’Iehovà;","poem":1},{"lineBreak":true},{"text":"hikaik’olotse le hanoe’e ty hoe:","poem":1},{"lineBreak":true},{"text":"Intoy iraho.","poem":1},{"lineBreak":true},{"text":"Naho asita’o añivo’o ao i jokay, i tondro-soñiy","poem":1},{"lineBreak":true},{"text":"naho o tambaitambaiñeo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Le ie ferenaiña’o o salikoo","poem":1},{"lineBreak":true},{"text":"naho eneñe’o o foreforèñeo,","poem":1},{"lineBreak":true},{"text":"le hanjirike añ’ieñe ao ty hazavà’o vaho hivalike ho tsipinde-mena","poem":1},{"lineBreak":true},{"text":"ty fimoromoroña’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hiaolo azo nainai’e t’Iehovà, le ho eneñe’e ty fiai’o an-tsan-kerè,","poem":1},{"lineBreak":true},{"text":"vaho hampaozare’e o taola’oo.","poem":1},{"lineBreak":true},{"text":"Ho goloboñe soa-tondrake irehe,","poem":1},{"lineBreak":true},{"text":"naho torahañe tsy mai-drano.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hamboare’ o boak’ama’oo","poem":1},{"lineBreak":true},{"text":"o tanàn-taoloo le hatroa’o o fahan-tariratse maroo,","poem":1},{"lineBreak":true},{"text":"vaho hatao mpamboatse jebañe irehe,","poem":1},{"lineBreak":true},{"text":"mpanomonty o lalam-pimoneñañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa naho avì’o amy Sabatay","poem":1},{"lineBreak":true},{"text":"ty fandia’o","poem":1},{"lineBreak":true},{"text":"tsy hañeañe o tolon-draha’oo","poem":1},{"lineBreak":true},{"text":"amy androko masiñey;","poem":1},{"lineBreak":true},{"text":"naho tokave’o ty hoe ‘mahafale’","poem":1},{"lineBreak":true},{"text":"o Sabotseo, ty andro masi’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho amañ’engeñe, le iasia’o,","poem":1},{"lineBreak":true},{"text":"tsy hañorike o lala’oo, naho","poem":1},{"lineBreak":true},{"text":"tsy hipay ty mahafale azo, vaho","poem":1},{"lineBreak":true},{"text":"tsy hisaontsy o enta’oo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie hifale am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"le hampiningirako azo","poem":1},{"lineBreak":true},{"text":"o haboa’ ty tane toio, vaho","poem":1},{"lineBreak":true},{"text":"ho fahanako ami’ty lova’ Iakobe rae’o;","poem":1},{"lineBreak":true},{"text":"izay ty nitsaraem-palie’ Iehovà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}