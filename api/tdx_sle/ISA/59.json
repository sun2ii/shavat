{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":59,"content":[{"type":"verse","number":1,"content":[{"text":"Toe tsy ­nitomoreñe ty fità’ Iehovà","poem":1},{"lineBreak":true},{"text":"tsy haharombake,","poem":1},{"lineBreak":true},{"text":"mbore tsy mavesatse i ravembia’ey,","poem":1},{"lineBreak":true},{"text":"tsy hahajanjiñe;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fe nampisitake anahareo","poem":1},{"lineBreak":true},{"text":"aman’Añahare’ areo o tahi’ areoo","poem":1},{"lineBreak":true},{"text":"naho naeta’ o hakeo’ areoo","poem":1},{"lineBreak":true},{"text":"amy lahara’ey nahareo,","poem":1},{"lineBreak":true},{"text":"tsy hahajanjiñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa vinetan-dio o fità’oo,","poem":1},{"lineBreak":true},{"text":"naho haratiañe o rambom-pità’oo;","poem":1},{"lineBreak":true},{"text":"fa nireha-bande o soñi’oo,","poem":1},{"lineBreak":true},{"text":"vaho miñeoñeon-kalò-tserehañe o lela’oo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy eo ty manisý an-kavañonañe,","poem":1},{"lineBreak":true},{"text":"tsy eo ty mihalaly an-kahiti’e;","poem":1},{"lineBreak":true},{"text":"miato an-kafoahañe,","poem":1},{"lineBreak":true},{"text":"naho mivolam-bande,","poem":1},{"lineBreak":true},{"text":"mampiareñe fikitrofañe iareo,","poem":1},{"lineBreak":true},{"text":"mampiboloañe haloloañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie mañatoly atolim-pañaneñe,","poem":1},{"lineBreak":true},{"text":"mandrare fararotse;","poem":1},{"lineBreak":true},{"text":"mate ty mitsopeke o atoli’eo,","poem":1},{"lineBreak":true},{"text":"vaho ipoñafan-dapetake ze foy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy hanoen-tsaroñe o fararo’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho sikina’ondaty","poem":1},{"lineBreak":true},{"text":"o tolom-pità’eo;","poem":1},{"lineBreak":true},{"text":"toe satan-karatiañe ty fifanehafa’ iareo,","poem":1},{"lineBreak":true},{"text":"am-pità’ iareo ty tolom-piaroteñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Milay mb’an-kaloloañe mb’eo","poem":1},{"lineBreak":true},{"text":"ty fandia’ iareo,","poem":1},{"lineBreak":true},{"text":"naho malisa hampiori-dio màliñe;","poem":1},{"lineBreak":true},{"text":"vetsevetse raty ty fitsakorea’ iareo,","poem":1},{"lineBreak":true},{"text":"an-dala’ iareo ty fangoakoahañe","poem":1},{"lineBreak":true},{"text":"naho ty fandrotsahañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nofi’ iareo ty lalam-pifampilongoañe,","poem":1},{"lineBreak":true},{"text":"vaho tsy vantañe o oloñolo’ iareoo;","poem":1},{"lineBreak":true},{"text":"tsy tendreke ­fañanintsiñe ze mizilike ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toli-ndra lavits’antika ty havantañañe,","poem":1},{"lineBreak":true},{"text":"vaho tsy mahatratse an-tika ty hatò;","poem":1},{"lineBreak":true},{"text":"mipay hazavàñe tika,","poem":1},{"lineBreak":true},{"text":"fe hehe t’ie hamoromoroñañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsapatsapaen-tika i rindriñey","poem":1},{"lineBreak":true},{"text":"manahake te goa,","poem":1},{"lineBreak":true},{"text":"eka mitsapatsapa hoe tsy amam-pihaino;","poem":1},{"lineBreak":true},{"text":"mitotohitse an-tsipinde-mena","poem":1},{"lineBreak":true},{"text":"hoe am-palipalitsieñe;","poem":1},{"lineBreak":true},{"text":"itika hoe lolo an-toetse maieñe ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mañaolo hoe dobe tika,","poem":1},{"lineBreak":true},{"text":"mangololoike hoe deho;","poem":1},{"lineBreak":true},{"text":"mipay ty vantañe fa tsy eo;","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe,","poem":1},{"lineBreak":true},{"text":"fe mitòtse aman-tika.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa ­mitoabotse añatrefa’o eo","poem":1},{"lineBreak":true},{"text":"o fiolà’aio,","poem":1},{"lineBreak":true},{"text":"mbore manisý anay o tahi’aio;","poem":1},{"lineBreak":true},{"text":"toe aolo’ay eo o fandilara’aio,","poem":1},{"lineBreak":true},{"text":"vaho fohi’ay o ota-fali’aio:","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mandilatse naho mitety Iehovà","poem":1},{"lineBreak":true},{"text":"miamboho aman’Añahare’ay","poem":1},{"lineBreak":true},{"text":"tsy mañorike Aze,","poem":1},{"lineBreak":true},{"text":"mivolam-pamorekekeañe","poem":1},{"lineBreak":true},{"text":"naho hamengohañe,","poem":1},{"lineBreak":true},{"text":"mikinia naho mañakatse","poem":1},{"lineBreak":true},{"text":"entan-dremborake boak’an-troke ao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Naolake ami’ty hatò, midisa-voly","poem":1},{"lineBreak":true},{"text":"naho mijohañe eñe ty havañonañe;","poem":1},{"lineBreak":true},{"text":"mitsikapy an-­gadagadañe ey ty fahiti’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy mete mizilik’ ao ty havantañañe","poem":1},{"noteId":184},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Milesa ty havañonañe,","poem":1},{"lineBreak":true},{"text":"ze mienga ty haratiañe","poem":1},{"lineBreak":true},{"text":"manao ty vata’e ho injaheñe;","poem":1},{"lineBreak":true},{"text":"vazoho’ Iehovà,","poem":1},{"lineBreak":true},{"text":"le heje’e t’ie po-kavantañañe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nioni’e te tsy eo ty ondaty,","poem":1},{"lineBreak":true},{"text":"vaho nilatsa t’ie tsy am-pañalañàlañe;","poem":1},{"lineBreak":true},{"text":"aa le i fità’ey ty nandrombake ho Aze;","poem":1},{"lineBreak":true},{"text":"i havantaña’ey ty nanozañe Aze.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Niombea’e ty havañonañe","poem":1},{"lineBreak":true},{"text":"hoe sarom-by","poem":1},{"lineBreak":true},{"text":"naho añambone’e eo ty sabakam-pandrombahañe;","poem":1},{"lineBreak":true},{"text":"nisaroñe lambam-pamaleam-pate","poem":1},{"lineBreak":true},{"text":"ho fisaro’e, vaho","poem":1},{"lineBreak":true},{"text":"nisaravy fahimbañañe ho sarimbo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mira amo sata’ eo, ty havaha’e:","poem":1},{"lineBreak":true},{"text":"Fiforoforoañe amo malaiñe Azeo,","poem":1},{"lineBreak":true},{"text":"Fañondroke amo rafelahi’eo;","poem":1},{"lineBreak":true},{"text":"Fañavahañe amo tokonoseo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Izay ty añeveña’ o tahandrefañeo","poem":1},{"lineBreak":true},{"text":"ty tahina’ Iehovà, i enge’ey,","poem":1},{"lineBreak":true},{"text":"boak’ am-panjirihan’ andro añe;","poem":1},{"lineBreak":true},{"text":"fa hanao vovòn-tsorotombake","poem":1},{"lineBreak":true},{"text":"ty hankàñe, hasio’ ty kofò’ Iehovà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le hitotsak’ e Tsione ty mpijebañe","poem":1},{"noteId":185},{"lineBreak":true},{"text":"ho amo mpiamboho fiolàñe","poem":1},{"lineBreak":true},{"text":"am’ Iakobeo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa naho Izaho, le zao ty fañinako","poem":1},{"lineBreak":true},{"text":"am’ iereo, hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ty Troko ama’o naho","poem":1},{"lineBreak":true},{"text":"o tsara najoko am-palie’oo,","poem":1},{"lineBreak":true},{"text":"ro tsy hienga am-palie’o,","poem":1},{"lineBreak":true},{"text":"ndra am-palie’ o tiri’oo,","poem":1},{"lineBreak":true},{"text":"ndra am-palie’ o tariran-tiri’oo,","poem":1},{"lineBreak":true},{"text":"henane zao naho nainai’e tsy modo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":184,"caller":"+","text":"Amo 5:7","reference":{"chapter":59,"verse":14}},{"noteId":185,"caller":"+","text":"Ies 24:23","reference":{"chapter":59,"verse":20}}]},"thisChapterLink":"/api/tdx_sle/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}