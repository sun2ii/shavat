{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":6,"content":[{"type":"heading","content":["Ty Vohi’Iehovà"]},{"type":"verse","number":1,"content":["Tamy taoñe nihomaha’ i Oziày, le nitreako miambesatse am-piambesatse abo naho nonjoneñe t’i Talè vaho nahaatseke i anjombay ty saravi’e."]},{"type":"verse","number":2,"content":["Nijohañe ambone’e ey o seràfeo",{"noteId":21},"; songa aman’ elatse eneñe, ty roe nanakoñe ty lahara’e, ty roe nanaroñe o fandia’eo vaho nitiliñe ty roe."]},{"type":"verse","number":3,"content":["Ie nifampikoike ty hoe : Masiñe, masiñe, masiñe, t’Iehovà’ i Màroy; lifotse ty enge’e ty tane bey toy."]},{"type":"verse","number":4,"content":["Nampiezeñezeñe o tokonañeo i feon-koikey, vaho natsafe’ ty hatoeñe i anjombay."]},{"type":"verse","number":5,"content":["Le hoe iraho, Hankàñe amako, rebake, fa ondaty maleo-tsoñy, vaho añivo’ ondaty maleo-pivimby ty itobohako; fa nahatrea i Mpanjakay, Iehovà’ i Màroy, o masokoo."]},{"type":"verse","number":6,"content":["Niti­liñe mb’ amako amy zao ty seràfe ninday vato mirekake am-pità’e, ie rinambe’e an-tsadrò boak’amy kitreliy ao,"]},{"type":"verse","number":7,"content":["le natoho’e ami’ty soñiko naho nanao ty hoe: Hehe, tinoho’ ty raha toy o fivim­bi’oo, vaho nijebañańe o tahi’oo."]},{"type":"verse","number":8,"content":["Tsinanoko ka ty fiarañanaña’ i Talè nanao ty hoe: Ia ty hiraheko, vaho ia ty homb’eo ho anay? Le hoe iraho: Intoy iraho; iraho!"]},{"type":"verse","number":9,"content":["Le hoe re: Akia, le saontsio am’ondaty retoañe:",{"text":"Toe mijanjiñe nahareo fe tsy mahafohiñe,","poem":1},{"lineBreak":true},{"text":"mañente fe tsy mahaoniñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ampibobòho ty arofo’ ondaty retoa,","poem":1},{"lineBreak":true},{"text":"le ampivalagìño o ravembia’ iareoo,","poem":1},{"lineBreak":true},{"text":"akipeo o fihaino’ iareoo;","poem":1},{"lineBreak":true},{"text":"tsy mone hahaisake o fihaino’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho hitsendreñe o ravembia’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho hahafohiñe o arofo’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho himpoly ho jangañeñe.","poem":1}]},{"type":"verse","number":11,"content":["Le hoe iraho: O Talè, pak’ombia? Le hoe ty natoi’e:",{"text":"Ampara’ te kòake o rovao","poem":1},{"lineBreak":true},{"text":"tsy amam-pimoneñe,","poem":1},{"lineBreak":true},{"text":"naho tsy ama’ondaty o anjombao,","poem":1},{"lineBreak":true},{"text":"vaho vata’e ratraratra i taney,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ie fa naveve’ Iehovà añe ondatio,","poem":1},{"lineBreak":true},{"text":"vaho maro ty toetse hoakoake","poem":1},{"lineBreak":true},{"text":"añivo’ i taney.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa ndra te i faha-folo’ey ro sehanga’e,","poem":1},{"lineBreak":true},{"text":"mbe habotseke avao;","poem":1},{"lineBreak":true},{"text":"fe manahake te mbe eo ty foto’","poem":1},{"lineBreak":true},{"text":"o mendoraveñeo naho o kileo","poem":1},{"lineBreak":true},{"text":"t’ie firaeñe,","poem":1},{"lineBreak":true},{"text":"le i tiry miavakey ty ho foto’e.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Serafe: anjely ambane’ lohà’ o kerobeo","reference":{"chapter":6,"verse":2}}]},"thisChapterLink":"/api/tdx_sle/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}