o fihaino’oo, le mahaoniña, hene mifanontoñe, mivovotse mb’ama’o mb’eo","poem":1},{"lineBreak":true},{"text":"boak’e tsietoitane añe o ana-dahi’oo,","poem":1},{"lineBreak":true},{"text":"vaho hotroñe’ o mpiatrak’ azeo","poem":1},{"lineBreak":true},{"text":"o anak’ ampela’oo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho oni’o amy zao naho haviake, hitepotepo vaho hienatse ty arofo’o;","poem":1},{"lineBreak":true},{"text":"Fa hasese ama’o ty havokara’ i riakey,","poem":1},{"lineBreak":true},{"text":"hitotsake ama’o ty vara’ o fifeheañeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Handrakotse’ azo ty rameva añ’aleale;","poem":1},{"lineBreak":true},{"text":"hikararake boake Seba añe","poem":1},{"lineBreak":true},{"text":"o rameva tora’ i Midiane naho Eifàeo","poem":1},{"noteId":187},{"lineBreak":true},{"text":"ro hanese volamena naho rame,","poem":1},{"lineBreak":true},{"text":"hitalily ty enge’ Iehovà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sindre hatontoñe ama’o","poem":1},{"lineBreak":true},{"text":"ze lia-rai’ i Kedare","poem":1},{"noteId":188},{"text":",","poem":1},{"lineBreak":true},{"text":"songa hitoroñe azo","poem":1},{"lineBreak":true},{"text":"ty añondrilahi’ i Nebaiote","poem":1},{"noteId":189},{"text":",","poem":1},{"lineBreak":true},{"text":"hionjom-b’an’ kitreliko mb’eo fa mañeva;","poem":1},{"lineBreak":true},{"text":"ho rengèko ty akibam-bolonaheko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ia o mitiliñe hoe rahoñeo? hoe deho mamonje o traño’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toe handiñe ahy o tokonoseo,","poem":1},{"lineBreak":true},{"text":"naho hiaolo hinday o ana-dahi’oo","poem":1},{"lineBreak":true},{"text":"boake lavitse añe o sambo’ i Tarsosio,","poem":1},{"lineBreak":true},{"text":"reketse ty volafoti’iareo","poem":1},{"lineBreak":true},{"text":"vaho ty volamena’iareo,","poem":1},{"lineBreak":true},{"text":"mb’amy tahina’ Iehovà Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"naho mb’amy Masi’ Israeley,","poem":1},{"lineBreak":true},{"text":"fa ie ro hanolotse’ engeñe ama’o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Harafi’ o renetaneo o kijoli’oo,","poem":1},{"lineBreak":true},{"text":"naho hiatrak’azo o mpanjaka’eo;","poem":1},{"lineBreak":true},{"text":"toe linafako an-kabosehan-drehe,","poem":1},{"lineBreak":true},{"text":"fe am-pañosihañe ty niferenaiñako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hisokake nainai’e o lalam-bei’oo,","poem":1},{"lineBreak":true},{"text":"tsy harindriñe handro ndra hale,","poem":1},{"lineBreak":true},{"text":"hañendesa’ ondaty ama’o","poem":1},{"lineBreak":true},{"text":"ty vara’ o kilakila’ ndatio,","poem":1},{"lineBreak":true},{"text":"vaho hivovora’ o mpanjaka’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hirotsake ty fifeheañe naho","poem":1},{"lineBreak":true},{"text":"ze famelehañe tsy mitoroñe azo;","poem":1},{"lineBreak":true},{"text":"eka ho vata’e fianto i fifeheañe rezay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Homb’ama’o mb’eo ty volonahe’","poem":1},{"lineBreak":true},{"text":"i Lebanone, o mendoraveñeo,","poem":1},{"lineBreak":true},{"text":"o harandrantoo, o mañario,","poem":1},{"lineBreak":true},{"text":"naho o kintsiñeo,","poem":1},{"lineBreak":true},{"text":"hampisomontia’ iareo i toeko miavakey;","poem":1},{"lineBreak":true},{"text":"le hanoeko fanjàka ty atimpaheko.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hidrakadrakake mb’ama’o mb’eo","poem":1},{"lineBreak":true},{"text":"ty ana’ o nampisoañe azoo,","poem":1},{"lineBreak":true},{"text":"hibokoke an-dela-pandia’o eo","poem":1},{"lineBreak":true},{"text":"o nanìtse azoo;","poem":1},{"lineBreak":true},{"text":"vaho hanoa’ iereo ty hoe:","poem":1},{"lineBreak":true},{"text":"ty rova’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty Tsione’ i Masi’ Israeley.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa kanao naforintseñe","poem":1},{"lineBreak":true},{"text":"naho ni-falai’ ondaty irehe,","poem":1},{"lineBreak":true},{"text":"vaho tsy nirangaeñe,","poem":1},{"lineBreak":true},{"text":"le hanoeko fiaintane nainai’e,","poem":1},{"lineBreak":true},{"text":"hafaleañe tariratse an-tariratse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho riote’ areo ty ronono’ o fifeheañeo","poem":1},{"lineBreak":true},{"text":"hinono am-patroam-panjaka","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’o te","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà ro Mpandrombak’ azo,","poem":1},{"lineBreak":true},{"text":"naho Izaho Tsitongerè’ Iakobe","poem":1},{"lineBreak":true},{"text":"ro Mpijebañe azo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hindesako volamena","poem":1},{"lineBreak":true},{"text":"hasolo ty torisìke,","poem":1},{"lineBreak":true},{"text":"naho torisìke hasolo ty hatae,","poem":1},{"lineBreak":true},{"text":"naho viñe fa tsy vato;","poem":1},{"lineBreak":true},{"text":"hanoeko fierañerañañe o mpifehe’oo,","poem":1},{"lineBreak":true},{"text":"vaho havantañañe o mpizaka’oo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy ho rey an-taneko ao ka","poem":1},{"lineBreak":true},{"text":"ty hotakotake, ndra fangoakoahañe","poem":1},{"lineBreak":true},{"text":"ndra fangomokomohañe am-po fahe’o ao;","poem":1},{"lineBreak":true},{"text":"fa hatao’o ty hoe","poem":1},{"lineBreak":true},{"text":"Fandrombahañe o kijoli’oo,","poem":1},{"lineBreak":true},{"text":"naho fandrengeañe o lalam-beio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy i àndroy ka ty hitsavavàk’ ama’o te handro,","poem":1},{"lineBreak":true},{"text":"vaho tsy ty hadorisa’ i volañey","poem":1},{"lineBreak":true},{"text":"ty himilemiletse ama’o;","poem":1},{"lineBreak":true},{"text":"fa ­hireandreañe ama’o nainai’e t’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ho enge’o t’i Andrianañahare.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le lia’e tsy hiroñe i àndroy,","poem":1},{"lineBreak":true},{"text":"naho tsy hisitake ka i volañey;","poem":1},{"lineBreak":true},{"text":"fa Iehovà ty ho failo’o nainai’e,","poem":1},{"lineBreak":true},{"text":"vaho ho modo o androm-pandalà’oo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hene ho vantañe ondati’oo","poem":1},{"lineBreak":true},{"text":"ho lova’ iareo nainai’e ty tane;","poem":1},{"lineBreak":true},{"text":"ie singa namboleko,","poem":1},{"lineBreak":true},{"text":"ty satan-tañako, handrengeañ’ Ahiko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hinjare arivo ty tsitso’e,","poem":1},{"lineBreak":true},{"text":"naho fifeheañe jabajaba ty kede","poem":1},{"noteId":190},{"text":";","poem":1},{"lineBreak":true},{"text":"Izaho Iehovà ty hanaentaeñe aze","poem":1},{"lineBreak":true},{"text":"ami’ty andro’e.","poem":1}]}],"footnotes":[{"noteId":186,"caller":"+","text":"Ies 60:19-20, Ben 21:23-24","reference":{"chapter":60,"verse":3}},{"noteId":187,"caller":"+","text":"Eifà: mokotse, vozake","reference":{"chapter":60,"verse":6}},{"noteId":188,"caller":"+","text":"Kedare: mainte; fandalañe","reference":{"chapter":60,"verse":7}},{"noteId":189,"caller":"+","text":"Nebaiote: saontsy; toky; taroke","reference":{"chapter":60,"verse":7}},{"noteId":190,"caller":"+","text":"Ies 41:14, Dan 2:34-44","reference":{"chapter":60,"verse":22}}]},"thisChapterLink":"/api/tdx_sle/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/59.json","previousChapterAudioLi