{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Amako t’i Arofo’ i Talè, Iehovà;","poem":1},{"lineBreak":true},{"text":"ie noriza’ Iehovà hinday talily soa amo mpirèkeo;","poem":1},{"lineBreak":true},{"text":"nirahe’e hamolonkoñe ty jagobo,","poem":1},{"lineBreak":true},{"text":"hitaroñe fidadàñe amo am-balabeio, naho fañahañe amo mirohio;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"hitsey ty taom-pañisoha’ Iehovà","poem":1},{"lineBreak":true},{"text":"naho ty androm-pañondrohan’Añahare, hañohòa’e o mihontokeo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"hamahana’e ze mirovetse e Tsione ao,","poem":1},{"lineBreak":true},{"text":"hampisabakae’e voñe","poem":1},{"lineBreak":true},{"text":"halimbe ty lavenoke,","poem":1},{"lineBreak":true},{"text":"tavon-kaehake hasolo ty fandalàñe,","poem":1},{"lineBreak":true},{"text":"saravim-bolonahetse","poem":1},{"lineBreak":true},{"text":"halimbe ty hamonjèrañe.","poem":1},{"lineBreak":true},{"text":"Hatao kilen-kavañonañe,","poem":1},{"lineBreak":true},{"text":"ty fambolèa’ Iehovà hisengea’iareo ty volonahe’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le hamboare’ iareo o tanàn-taoloo,","poem":1},{"lineBreak":true},{"text":"hatroa’ iareo o nangoakoake haehaeo,","poem":1},{"lineBreak":true},{"text":"vaho ho vaoe’ iareo o rova niantoeñeo,","poem":1},{"lineBreak":true},{"text":"o nibangý fa tariratse maro izay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hiavotse hamahañe o lia-rai’oo","poem":1},{"lineBreak":true},{"text":"o ambahinio,","poem":1},{"lineBreak":true},{"text":"le ho mpiava’o naho mpañeteke","poem":1},{"lineBreak":true},{"text":"o vahe’oo ty renetane.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fe hatao mpisoro’ Iehovà nahareo,","poem":1},{"lineBreak":true},{"text":"hatao ondatio ty hoe:","poem":1},{"lineBreak":true},{"text":"Mpiatrak’ an’Andrianañahare’ay;","poem":1},{"lineBreak":true},{"text":"ho kamae’ areo ty vara’ o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"vaho ho sengè’ areo ty volonahe’ iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kanao ni-roe ty hasalara’ areo,","poem":1},{"lineBreak":true},{"text":"naho nirebeha’ iareo ty hoe:","poem":1},{"lineBreak":true},{"text":"Anjara’ iareo ty fivoteboteñañe,","poem":1},{"lineBreak":true},{"text":"le hanañe roe an-tane’ iareo ao,","poem":1},{"lineBreak":true},{"text":"vaho ho nainai’e am’ iareo ao","poem":1},{"lineBreak":true},{"text":"ty hafaleañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa mpitea ty hatò izaho Iehovà;","poem":1},{"lineBreak":true},{"text":"hejeko ty kametse naho ty lilatse;","poem":1},{"lineBreak":true},{"text":"hondrohako ami’ty hahiti’e iereo,","poem":1},{"lineBreak":true},{"text":"naho hanoako fañina tsy modo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho fohiñe amo kilakila ondatio","poem":1},{"lineBreak":true},{"text":"o tarira’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho am’ondatio o taminga’ iareoo;","poem":1},{"lineBreak":true},{"text":"hapota’ ze mahaoniñe","poem":1},{"lineBreak":true},{"text":"t’ie ty tiry nitahie’ Iehovà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Handia taroba am’ Iehovà iraho,","poem":1},{"lineBreak":true},{"text":"hirebek’ aman’ Añahareko ty troko;","poem":1},{"lineBreak":true},{"text":"amy te siniki’e sikim-pandrombahañe,","poem":1},{"lineBreak":true},{"text":"Nasaro’e sarimbom-pandrebahañe,","poem":1},{"lineBreak":true},{"text":"le sinabaka’e hoe fañombeam-pañenga i sabaka’ey,","poem":1},{"lineBreak":true},{"text":"vaho nihaminañe hoe enga-vao amo bange’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe hambañe ami’ty fampitiria’","poem":1},{"lineBreak":true},{"text":"i taney o hatae’eo naho","poem":1},{"lineBreak":true},{"text":"ty fampiporotsaha’ ty goloboñe","poem":1},{"lineBreak":true},{"text":"o nitongiseñe ama’eo;","poem":1},{"lineBreak":true},{"text":"ty hampipitsiha’ i Talè, Iehovà","poem":1},{"lineBreak":true},{"text":"fandrebahañe naho engeñe añatrefa’","poem":1},{"lineBreak":true},{"text":"ze kilakila’ondaty.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}