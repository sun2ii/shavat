{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"Tsy hitsin-draho ty amy Tsione,","poem":1},{"lineBreak":true},{"text":"tsy hitofa ty am’ Ierosalaime;","poem":1},{"lineBreak":true},{"text":"ampara’ te mionjom-beo am-pireandreañe ty fandrebaha’e,","poem":1},{"lineBreak":true},{"text":"naho manahake ty firebarebam-pañilo","poem":1},{"lineBreak":true},{"text":"ty fandrombaha’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ho isa’ o fifeheañeo ty fandreketa’o,","poem":1},{"lineBreak":true},{"text":"naho o mpanjaka iabio ty enge’o;","poem":1},{"lineBreak":true},{"text":"vaho ho kanjieñe tahinañe vao irehe,","poem":1},{"lineBreak":true},{"text":"ze ho toñonem-palie’ Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie ho sabaka soa am-pità’ Iehovà ka,","poem":1},{"lineBreak":true},{"text":"naho banetram-panjaka","poem":1},{"lineBreak":true},{"text":"an-dela-pitàn’ Añahare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy hatao Naforintseñe ka irehe, naho","poem":1},{"lineBreak":true},{"text":"tsy ho tokaveñe ty hoe mangoakoake ka ty tane’o;","poem":1},{"lineBreak":true},{"text":"fa hoe ty hatao azo: An-Kafaleako,","poem":1},{"lineBreak":true},{"text":"naho ty tane’o: Manam-baly;","poem":1},{"lineBreak":true},{"text":"amy te ifalea’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hanam-baly ty tane’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty fañengàn’ ajalahy","poem":1},{"lineBreak":true},{"text":"ty somondrara miehañe,","poem":1},{"lineBreak":true},{"text":"ty hañengà’ o ana-dahi’oo azo;","poem":1},{"lineBreak":true},{"text":"vaho manahake ty firebeha’","poem":1},{"lineBreak":true},{"text":"ty mpañenga amy enga-vao’ey,","poem":1},{"lineBreak":true},{"text":"ty hifalean’ Añahare’o ama’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nampijadoñeko ambone’","poem":1},{"lineBreak":true},{"text":"kijoli’o ey ty mpijilo, ry Ierosalaime,","poem":1},{"lineBreak":true},{"text":"tsy hianjiñe handro an-kaleñe iereo;","poem":1},{"lineBreak":true},{"text":"ko mitofa ry mpanohiñe Iehovào,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"vaho ko apo’ areo t’ie hitofa,","poem":1},{"lineBreak":true},{"text":"ampara’ te oriza’e,","poem":1},{"lineBreak":true},{"text":"eka ampara’ te hanoe’e fandrengea’","poem":1},{"lineBreak":true},{"text":"ty tane toy t’Ierosalaime.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa nifanta am-pità’e havana t’Iehovà, an-tsiran-kaozara’e:","poem":1},{"lineBreak":true},{"text":"T’ie tsy ho fahanako amo ampemba’oo","poem":1},{"lineBreak":true},{"text":"o rafelahi’oo, naho","poem":1},{"lineBreak":true},{"text":"tsy hinoman’ ambahiny ka","poem":1},{"lineBreak":true},{"text":"o divay nitoloñe’oo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O nanontoñe azeo ty hikama ama’e,","poem":1},{"lineBreak":true},{"text":"naho handrenge Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho o nitimpoñe azeo ty hinoñe ama’e,","poem":1},{"lineBreak":true},{"text":"an-kiririsan-toeko miavake eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iziliho, iziliho o lalam-beio, hajario ty lala’ ondatio;","poem":1},{"lineBreak":true},{"text":"ampitoabòro, ampitoaboro i tatakey, hene aveveo o vatoo, zonjò viloñe ambone’ ondatio ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ingo fa nikoike pak’añ’olon-tane añe","poem":1},{"lineBreak":true},{"text":"t’Iehovà, Ano ty hoe t’i Tsione anak’ampela : Ingo, mb’eo ty fandrombaha’o; rekets’ i tambe’ey,","poem":1},{"lineBreak":true},{"text":"ama’e ka ty vale-soa’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hatao ty hoe iereo :","poem":1},{"lineBreak":true},{"text":"Ondaty masiñe, jineba’ Iehovà.","poem":1},{"lineBreak":true},{"text":"Ho tokaveñe ty hoe irehe :","poem":1},{"lineBreak":true},{"text":"Tsinoeke;","poem":1},{"lineBreak":true},{"text":"Rova tsy Naforintseñe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}