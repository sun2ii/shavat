,{"lineBreak":true},{"text":"eka ho liàko ami’ty fifomboko,","poem":1},{"lineBreak":true},{"text":"naho hatsafeko ami’ty fiforoforoako;","poem":1},{"lineBreak":true},{"text":"naho nifitse amo sikikoo ty lio’ iareo","poem":1},{"lineBreak":true},{"text":"vaho hene kinomatraoko o sarokoo,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Toe androm-­pañavahañe ty an-troko ao,","poem":1},{"lineBreak":true},{"text":"fa tondroke ty taom-pijebañako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nenteako te tsy teo ty hañolotse,","poem":1},{"lineBreak":true},{"text":"niisako an-kalatsañe","poem":1},{"lineBreak":true},{"text":"fe tsy teo ty hanozañe;","poem":1},{"lineBreak":true},{"text":"aa le ty tañako avao ty ninday","poem":1},{"lineBreak":true},{"text":"fandrombahañe ho ahiko,","poem":1},{"lineBreak":true},{"text":"nanozañ’ahy ty fifomboko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le niliako an-­kaboseke ondatio,","poem":1},{"lineBreak":true},{"text":"naho nimamoeko am-poroforo,","poem":1},{"lineBreak":true},{"text":"vaho naretsako an-tane ty haozara’ iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho taroñeko ty fiferenaiña’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ty fijejoañe Iehovà,","poem":1},{"lineBreak":true},{"text":"ty amo hene raha fanjàka","poem":1},{"lineBreak":true},{"text":"natolo’ Iehovà antikañeo,","poem":1},{"lineBreak":true},{"text":"naho i fatariha’e ra’elahy","poem":1},{"lineBreak":true},{"text":"amy anjomba’ Israeley,","poem":1},{"lineBreak":true},{"text":"i natolo’e iareo","poem":1},{"lineBreak":true},{"text":"ty amo fitretreza’eoy naho","poem":1},{"lineBreak":true},{"text":"amo fiferenaiña’e bey heneheneo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"amy natao’e, ty hoe; Toe ondatiko iereo, anake tsy handañitse;","poem":1},{"lineBreak":true},{"text":"Ie ro nandrombake iareo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amo haferenai’ iareo iabio, le niferenaiña’e, naho nandrombake","poem":1},{"lineBreak":true},{"text":"iareo ty anjelim-piatrefa’e;","poem":1},{"lineBreak":true},{"text":"ty fikokoa’e, toe i haleñ’arofo’ey","poem":1},{"lineBreak":true},{"text":"ty nijebaña’e iareo","poem":1},{"lineBreak":true},{"text":"naho notroñe’e vaho nivavè’e","poem":1},{"lineBreak":true},{"text":"amo hene andro taoloo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe niola iereo, nanjehatse","poem":1},{"lineBreak":true},{"text":"amy Arofo’e masiñey;","poem":1},{"lineBreak":true},{"text":"aa le nifotetse re ho rafelahi’ iareo;","poem":1},{"lineBreak":true},{"text":"ie avao ty nialy am’ iereo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nitiahi’ ondati’eo amy zao","poem":1},{"lineBreak":true},{"text":"o andro taolo faha’ i Mosèo:","poem":1},{"lineBreak":true},{"text":"Aia i nampitroatse iareo","poem":1},{"lineBreak":true},{"text":"amy riakey rekets’ i mpiara-lia-rai’eiy?","poem":1},{"lineBreak":true},{"text":"Aia i nampijoñe i Arofo’e Masiñey","poem":1},{"lineBreak":true},{"text":"am’ iereoy?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ie nanehake ty fitàn-kavana’ i Mosè","poem":1},{"lineBreak":true},{"text":"am-pità’e lifots’engeñey;","poem":1},{"lineBreak":true},{"text":"ie nandriatse i rano aolo’ iareoy,","poem":1},{"lineBreak":true},{"text":"hanoe’e tahinañe tsy modo ho aze;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ie niaolo iareo hitsake i lalekey hoe te","poem":1},{"lineBreak":true},{"text":"soavala ampatrañey, tsy hitsikapy?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manahake ty fizotsoan’ añombe","poem":1},{"lineBreak":true},{"text":"mb’am-bavatane mb’eo,","poem":1},{"lineBreak":true},{"text":"ty nampitofà’ i Arofo’ Iehovà ia