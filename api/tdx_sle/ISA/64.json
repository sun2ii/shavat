{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Manahake ty famorototoan’","poem":1},{"lineBreak":true},{"text":"afo o rongoñeo,","poem":1},{"lineBreak":true},{"text":"ty afo mampitroatroake rano.","poem":1},{"lineBreak":true},{"text":"Hampaharofoanañe o malaiñ’Azoo","poem":1},{"lineBreak":true},{"text":"ty tahina’o, hihondrahondra’","poem":1},{"lineBreak":true},{"text":"o kilakila’ ndatio ami’ty fiatrefa’o,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie nanoa’o raha tsitantane tsy nipaia’ay","poem":1},{"lineBreak":true},{"text":"—Ehe te hizotso irehe,","poem":1},{"lineBreak":true},{"text":"te hiozoñozoñe o haboañeo","poem":1},{"lineBreak":true},{"text":"ami’ty fiatrefa’o!—","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ie tsy jinanji’ ondatio taolo,","poem":1},{"lineBreak":true},{"text":"tsy napotan-dravembia","poem":1},{"lineBreak":true},{"text":"tsy nioni-pihaino,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare naho tsy Ihe,","poem":1},{"lineBreak":true},{"text":"Ie mitoloñe ho a o mandiñe Azeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fitilihe’o ty mitolon-kavantañañe an-kaehake, o mahatiahy Azo amo lala’oo —eka, mifombo irehe te mandilatse zahay.","poem":1},{"lineBreak":true},{"text":"Fe ami’ty fiatoa’ay amo lala’o haehaeo","poem":1},{"lineBreak":true},{"text":"ro hahazoa’ay rombake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Songa ninjare hoe ondaty tiva zahay,","poem":1},{"lineBreak":true},{"text":"sindre hoe tsirodea maleotse ty havantaña’ay;","poem":1},{"lineBreak":true},{"text":"miheatse manahake ty raveñe,","poem":1},{"lineBreak":true},{"text":"vaho maniotsiotse anay añe","poem":1},{"lineBreak":true},{"text":"hoe i tiokey o hakeo’aio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Leo raike tsy mikanjy ty tahina’o,","poem":1},{"lineBreak":true},{"text":"ty mitrobo vatañe handrambe Azo;","poem":1},{"lineBreak":true},{"text":"fa naeta’o ama’ay ty lahara’o,","poem":1},{"lineBreak":true},{"text":"vaho nagedra’o ty amo tahi’aio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hoke, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Ihe ro Rae’ay; zahay ro lietse,","poem":1},{"lineBreak":true},{"text":"Ihe ro mpitoloñe anay,","poem":1},{"lineBreak":true},{"text":"Ie songa satam-pità’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko loho viñetse ry Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho ko mahatiahy hakeo nainai’e;","poem":1},{"lineBreak":true},{"text":"heheke, vazohò henaneo,","poem":1},{"lineBreak":true},{"text":"te hene ondati’o zahay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa nanjare ­ratraratra o rova’o miavakeo,","poem":1},{"lineBreak":true},{"text":"fatrambey ty Tsione,","poem":1},{"lineBreak":true},{"text":"mangoakoake t’Ierosalaime.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I anjomba’ay miavake naho fanjakay,","poem":1},{"lineBreak":true},{"text":"i nitalahoan-droae’aiy,","poem":1},{"lineBreak":true},{"text":"le fa finorototo’ ty afo;","poem":1},{"lineBreak":true},{"text":"vaho fonga navatambia ho forompotse","poem":1},{"lineBreak":true},{"text":"o raha soa’aio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mbe hifoneña’o hao ry Iehovà","poem":1},{"lineBreak":true},{"text":"ty amy raha rezay?","poem":1},{"lineBreak":true},{"text":"hianjiñe hao irehe hampalovilovy","poem":1},{"lineBreak":true},{"text":"anay an-tìñake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}