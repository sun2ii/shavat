{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":65,"content":[{"type":"verse","number":1,"content":[{"text":"Tsoehe’ o tsy nañontane Ahio iraho,","poem":1},{"lineBreak":true},{"text":"nitendreke o tsy nipay Ahikoo;","poem":1},{"lineBreak":true},{"text":"Le nataoko ty hoe:","poem":1},{"lineBreak":true},{"text":"Intoy iraho, Intoy iraho;","poem":1},{"lineBreak":true},{"text":"ami’ty fifeheañe tsy tokaveñe","poem":1},{"lineBreak":true},{"text":"ami’ty añarako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa nañity tañañe lomoñandro raho","poem":1},{"lineBreak":true},{"text":"am’ondaty mañarinjeñeo,","poem":1},{"lineBreak":true},{"text":"o mijelanjelañe an-dalañe tsy mahasoao,","poem":1},{"lineBreak":true},{"text":"mañorike ty fitsakorea’ iareo avao;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ondaty mikai-jaka an-daharako","poem":1},{"lineBreak":true},{"text":"nainai’eo, ie manao soroñe","poem":1},{"lineBreak":true},{"text":"an-goloboñe ao, vaho mañemboke","poem":1},{"lineBreak":true},{"text":"ambone birike eo;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O mpitozòke an-kibory ao,","poem":1},{"lineBreak":true},{"text":"naho mañialo añ’etake ao;","poem":1},{"lineBreak":true},{"text":"o milintseñe henan-dambo","poem":1},{"noteId":192},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho ron-draha veta","poem":1},{"lineBreak":true},{"text":"am-pinga’eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie manao ty hoe: Mijohaña ey irehe,","poem":1},{"lineBreak":true},{"text":"ko mitotoke amako,","poem":1},{"lineBreak":true},{"text":"amy te masiñe te ama’o iraho;","poem":1},{"lineBreak":true},{"text":"hatoeñe añ’oroko ao iereo,","poem":1},{"lineBreak":true},{"text":"afo miforehetse lomoñandro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hehe t’ie sinokitse aoloko eo,","poem":1},{"lineBreak":true},{"text":"tsy hianjiñe iraho ampara’ te hondroheko, eka, havahako añ’araña’ iareo ao","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"o hakeo’ areoo,","poem":1},{"lineBreak":true},{"text":"mitraoke amo tahin-droae’ areoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie nibanabana an-kaboañe ey,","poem":1},{"lineBreak":true},{"text":"naho niteratera ahy amo vohitseo;","poem":1},{"lineBreak":true},{"text":"le haranako añ’araña’ iareo hey","poem":1},{"lineBreak":true},{"text":"ty fitoloña’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hoe t’i Iehovà:","poem":1},{"lineBreak":true},{"text":"Manahake te zoeñe ami’ty","poem":1},{"lineBreak":true},{"text":"angazora’e ao ty ranom-baloboke,","poem":1},{"lineBreak":true},{"text":"le hoe ty saontsy: Ko joieñe, fa aman-tata;","poem":1},{"lineBreak":true},{"text":"izay ka ty hanoeko ty amo mpitorokoo,","poem":1},{"lineBreak":true},{"text":"fa tsy ho fonga rotsaheko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa hampiakareko am’ Iakobe ty tiry,","poem":1},{"lineBreak":true},{"text":"naho haboako am’ Iehodà","poem":1},{"lineBreak":true},{"text":"ty mpandova o vohikoo;","poem":1},{"lineBreak":true},{"text":"le handova aze o jinobokoo,","poem":1},{"lineBreak":true},{"text":"vaho himoneñe ao o mpitorokoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho golobon-dia-raike t’i Sarone,","poem":1},{"lineBreak":true},{"text":"le ho fandream-piray troke","poem":1},{"lineBreak":true},{"text":"ty vavatane’ i Akore","poem":1},{"noteId":193},{"text":",","poem":1},{"lineBreak":true},{"text":"ho a ondaty mipay Ahikoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fe, ry mpitsambolitioke am’Iehovà naho mandikoke i vohiko miavakeio,","poem":1},{"lineBreak":true},{"text":"naho mañalankañe kitrelim-","poem":1},{"lineBreak":true},{"text":"pitahiañe, vaho mampilaro divay","poem":1},{"lineBreak":true},{"text":"am-pañaranañe pea ho ami’ty vintañe,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoireko ho am-pibara nahareo,","poem":1},{"lineBreak":true},{"text":"fonga hitsin­goro am-pizamanañe;","poem":1},{"lineBreak":true},{"text":"amy te nitokaveko, fe tsy nanoiñe,","poem":1},{"lineBreak":true},{"text":"le tsy nihaoñe’ areo t’ie nitaroñe;","poem":1},{"lineBreak":true},{"text":"te mone nanoe’areo ze raty a masoko ao,","poem":1},{"lineBreak":true},{"text":"jinobo’ areo ty tsy maha-fale Ahiko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le hoe t’i Talè, Iehovà:","poem":1},{"lineBreak":true},{"text":"Hikama o mpitorokoo,","poem":1},{"lineBreak":true},{"text":"fe ho kerè nahareo;","poem":1},{"lineBreak":true},{"text":"hinoñe o mpitorokoo,","poem":1},{"lineBreak":true},{"text":"fe haran-drano nahareo;","poem":1},{"lineBreak":true},{"text":"hirebeke o mpitorokoo,","poem":1},{"lineBreak":true},{"text":"fe ho salatse nahareo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eka hisabo ami’ty hafalean-tro’e","poem":1},{"lineBreak":true},{"text":"o mpitorokoo,","poem":1},{"lineBreak":true},{"text":"f’ie hirovetse am-pioremeñan’arofo,","poem":1},{"lineBreak":true},{"text":"naho hangoihoy ami’ty fandalàn-troke.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hapo’ areo ho fatse amo jinobokoo ty añara’ areo:","poem":1},{"lineBreak":true},{"text":"izay ty hanjamana’ i Talè, Iehovà azo;","poem":1},{"lineBreak":true},{"text":"fa hanoe’e tahinañe hafa o mpitoro’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le hitata aman’ Añaharen-katò","poem":1},{"lineBreak":true},{"text":"ze hitata vatañe an-tane atoy;","poem":1},{"lineBreak":true},{"text":"le hifanta aman’Añaharen-katò","poem":1},{"lineBreak":true},{"text":"ze hifanta an-tane atoy;","poem":1},{"lineBreak":true},{"text":"amy te añe o hasotriañe taoloo,","poem":1},{"lineBreak":true},{"text":"fa naetake amo masokoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ingo, mandranjy likerañe vao","poem":1},{"lineBreak":true},{"text":"naho tane vao iraho;","poem":1},{"lineBreak":true},{"text":"naho tsy ho tiahy ka o raha taoloo,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho tohinem-betsevetse.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa le mifalea naho mirebeha nainai’e","poem":1},{"lineBreak":true},{"text":"amy hitseneakoy;","poem":1},{"lineBreak":true},{"text":"ingo, hamboareko firebehañe t’Ierosalaime","poem":1},{"lineBreak":true},{"text":"naho hafaleañe ondati’eo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Le hifaleako t’Ierosalaime,","poem":1},{"lineBreak":true},{"text":"naho hitrao-pirebeke am’ondatikoo;","poem":1},{"lineBreak":true},{"text":"vaho tsy ho janjiñeñe ama’e ka","poem":1},{"lineBreak":true},{"text":"ty feom-pangololoihañe,","poem":1},{"lineBreak":true},{"text":"naho ty feom-pirovetañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy eo ty anak’ajaja","poem":1},{"lineBreak":true},{"text":"tsy hahatrats’ andro,","poem":1},{"lineBreak":true},{"text":"ndra ty ondati-bey tsy ho eneñe andro;","poem":1},{"lineBreak":true},{"text":"le hatao tora’e ty mihomake t’ie zato taoñe,","poem":1},{"lineBreak":true},{"text":"vaho hatao fokom-patse aman-","poem":1},{"lineBreak":true},{"text":"kakeo ze tsy mahatratse ty hazato tao’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Handranjy anjomba iereo,","poem":1},{"lineBreak":true},{"text":"naho himoneña’e;","poem":1},{"lineBreak":true},{"text":"hambole an-tanem-bahe iereo","poem":1},{"lineBreak":true},{"text":"vaho hikama amo voa’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie tsy hamboatse, hitoboha’ ty ila’e","poem":1},{"lineBreak":true},{"text":"vaho tsy hitongy, habotse’ ty hafa;","poem":1},{"lineBreak":true},{"text":"fa ho mira ami’ty andron-katae","poem":1},{"lineBreak":true},{"text":"ty andro’ ondatikoo,","poem":1},{"lineBreak":true},{"text":"ho losore’ o jinobokoo havelo","poem":1},{"lineBreak":true},{"text":"o satam-pità’iareoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsy hifanehake ami’ty fianto iereo,","poem":1},{"lineBreak":true},{"text":"tsy hisamake ho an-kankàñe,","poem":1},{"lineBreak":true},{"text":"fa ho tahie’ Iehovà o tabiri’ iereoo,","poem":1},{"lineBreak":true},{"text":"naho o tarira’ iareoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie amy zay, aolo’ te hikanjy iereo,","poem":1},{"lineBreak":true},{"text":"le hanoiñe iraho; ie mbe misaontsy,","poem":1},{"lineBreak":true},{"text":"le fa nahatsanon-dRaho.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hitrao-pihinañe ty farasy","poem":1},{"lineBreak":true},{"text":"naho ty añondry,","poem":1},{"lineBreak":true},{"text":"hihinañ’ahetse manahake ty añombe o lionao,","poem":1},{"lineBreak":true},{"text":"le deboke ty liñe’ o mereñeo","poem":1},{"lineBreak":true},{"text":"f’ie tsy hijoy, tsy hanao raty ndra","poem":1},{"lineBreak":true},{"text":"aia’aia am-bohiko masiñ’ ao,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":192,"caller":"+","text":"Oni: Ies 66:17","reference":{"chapter":65,"verse":4}},{"noteId":193,"caller":"+","text":"Akore: tolon-tsotry","reference":{"chapter":65,"verse":10}}]},"thisChapterLink":"/api/tdx_sle/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}