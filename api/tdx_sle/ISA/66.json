{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":66,"content":[{"type":"verse","number":1,"content":[{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Fiambesako i likerañey,","poem":1},{"lineBreak":true},{"text":"atimpaheko ty tane toy;","poem":1},{"lineBreak":true},{"text":"aia arè ty traño ho lefe’ areo rafeteñe","poem":1},{"lineBreak":true},{"text":"ho Ahiko?","poem":1},{"lineBreak":true},{"text":"Aia ty toetse mete ho fitofàko?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toe kila satan-tañako ;","poem":1},{"lineBreak":true},{"text":"izay ty nampiboahañe","poem":1},{"lineBreak":true},{"text":"o fitoloñan’ Añahareo, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fe ondaty zao ty henteako:","poem":1},{"lineBreak":true},{"text":"ty rarake añ’arofo mikoretse,","poem":1},{"lineBreak":true},{"text":"naho minevenevetse amo volakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hoe mañe-doza ama’ ondaty","poem":1},{"lineBreak":true},{"text":"ty mitombok’ añombe;","poem":1},{"lineBreak":true},{"text":"hoe mamolake vozon’amboa","poem":1},{"lineBreak":true},{"text":"ty mañenga vik’añondry;","poem":1},{"lineBreak":true},{"text":"hoe mañenga lion-dambo","poem":1},{"lineBreak":true},{"text":"ty mañenga mahakama;","poem":1},{"lineBreak":true},{"text":"hoe te mitata sampondraha ty mañemboke; eka fa jinobo’iareo ty lala’iareo, naho mampinembanembañe ty tro’iareo o raha’e mampangoriñeo.","poem":1},{"lineBreak":true},{"text":"o raha tiva’iareoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Izaho ka ty hijoboñe ty fandilovañe iareo,","poem":1},{"lineBreak":true},{"text":"vaho hafetsako am’iereo ty ihembaña’ iareo;","poem":1},{"lineBreak":true},{"text":"amy te, nikanjy iraho,","poem":1},{"lineBreak":true},{"text":"fe leo raike tsy nanoiñe;","poem":1},{"lineBreak":true},{"text":"nitaron-dRaho, fe tsy amam-pañaoñe,","poem":1},{"lineBreak":true},{"text":"te mone nanoe’ iareo haloloañe","poem":1},{"lineBreak":true},{"text":"aolo’ o masokoo, vaho jinobo’ iareo","poem":1},{"lineBreak":true},{"text":"ty tsy maha fale ahiko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mijanjiña ty tsara’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry mpinevenevetse amo tsara’eo:","poem":1},{"lineBreak":true},{"text":"fa nanao ty hoe o rolongo","poem":1},{"lineBreak":true},{"text":"malaiñe anahareoo,","poem":1},{"lineBreak":true},{"text":"o nandroak’ anahareo","poem":1},{"lineBreak":true},{"text":"ami’ty añarakoo, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Itolorañ’engeñe abey t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hisamba’ay ty firebeha’ areo.","poem":1},{"lineBreak":true},{"text":"F’ie ho salatse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inay ty feon-koràke boak’an-drova ao,","poem":1},{"lineBreak":true},{"text":"inao ty feo boak’ amy anjombay,","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ Iehovà mañondroke","poem":1},{"lineBreak":true},{"text":"avake amo rafelahi’eo:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie mbe tsy nitsongo le fa nisamake,","poem":1},{"lineBreak":true},{"text":"ie mbe tsy niavy i fanaintaiña’ey","poem":1},{"lineBreak":true},{"text":"le nahatoly ana-dahy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ia ty nahajanjiñe i hoe zay?","poem":1},{"lineBreak":true},{"text":"Ia ty nahaisake i rahay?","poem":1},{"lineBreak":true},{"text":"Hiterake añ’andro raike hao ty tane?","poem":1},{"lineBreak":true},{"text":"Aboake aniany hao ty fifeheañe?","poem":1},{"lineBreak":true},{"text":"Fe vata’e nitsongo ty Tsione,","poem":1},{"lineBreak":true},{"text":"le nasama’e o ana’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hampitsongoeko hao,","poem":1},{"lineBreak":true},{"text":"le tsy hampisamaheko?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"Izaho mpampisamakey hao","poem":1},{"lineBreak":true},{"text":"ty handrindriñe i hoviñey?","poem":1},{"lineBreak":true},{"text":"hoe t’i Andrianañahare.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitraofa rebeke am’ Ierosalaime,","poem":1},{"lineBreak":true},{"text":"le itraofo fifaleañe ry mpikoko aze iabio;","poem":1},{"lineBreak":true},{"text":"irebeho an-kaehake ry mandala azeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Soa t’ie hinono vaho hiareare","poem":1},{"lineBreak":true},{"text":"ami’ty fatroa’ o fañohòa’eo;","poem":1},{"lineBreak":true},{"text":"hiriota’ areo an-kafaleañe miheotse,","poem":1},{"lineBreak":true},{"text":"ami’ty havokara’ o enge’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà: Ingo, ho taroñeko fierañerañañe hoe oñe,","poem":1},{"lineBreak":true},{"text":"naho ty enge’ o fifelehañeo","poem":1},{"lineBreak":true},{"text":"hoe torahañe mandopatse.","poem":1},{"lineBreak":true},{"text":"Hinono nahareo, ho vaveñe añ’ila’e,","poem":1},{"lineBreak":true},{"text":"vaho honkoñeñe añ’ongotse eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Manahake ty fañohòan-drene’e","poem":1},{"lineBreak":true},{"text":"ty ana-dahy, ty hañohòako anahareo;","poem":1},{"lineBreak":true},{"text":"e Ierosalaime ao t’ie hanintsiñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie isa’ areo le hifale añ’ arofo,","poem":1},{"lineBreak":true},{"text":"naho hiraorao o taola’ areoo","poem":1},{"lineBreak":true},{"text":"hoe ahetse tora’e;","poem":1},{"lineBreak":true},{"text":"naho ho fohiñe te mpañimba","poem":1},{"lineBreak":true},{"text":"o mpitoro’eo ty fità’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hatreatrè’e o rafelahi’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"F’inao! Ho totsake aman’afo t’Iehova, naho hoe tangololahy o sarete’eo, hamalea’e am-piforoforo ty haviñera’e, naho añ’ afo mirebareba ty fitrevoha’ey;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa añ’afo ty hiatrefa’Iehovà zaka,","poem":1},{"lineBreak":true},{"text":"naho am-pibara’e ze hene nofotse;","poem":1},{"lineBreak":true},{"text":"fa maro ty ho zamane’ Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ze mañamasim-batañe naho","poem":1},{"lineBreak":true},{"text":"miefetse himoaha’e an-goloboñe ao,","poem":1},{"lineBreak":true},{"text":"sindre mañorike ty añivo ao,","poem":1},{"lineBreak":true},{"text":"milintseñe henan-dambo","poem":1},{"noteId":194},{"text":",","poem":1},{"lineBreak":true},{"text":"ty mampangorý, naho ty kotika,","poem":1},{"lineBreak":true},{"text":"le fonga hatraoke ho mongoreñe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe hene apotako ze sata’ iareo","poem":1},{"lineBreak":true},{"text":"naho o vetsevetse’ iareoo,","poem":1},{"lineBreak":true},{"text":"le ho tondroke te songa hatontoko","poem":1},{"lineBreak":true},{"text":"ze fifelehañe naho fameleke;","poem":1},{"lineBreak":true},{"text":"ie homb’eo hahaisake ty engeko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Le hanoeko fanoroañe am’iereo ao,","poem":1},{"lineBreak":true},{"text":"naho hafantoko amo nahafirimatseo,","poem":1},{"lineBreak":true},{"text":"ty hañavelo mbe Tarsise, mbe Pole","poem":1},{"noteId":195},{"text":",","poem":1},{"lineBreak":true},{"text":"mbe Lode","poem":1},{"noteId":196},{"text":"mpitàm-pale, mbe Tobale","poem":1},{"noteId":197},{"lineBreak":true},{"text":"naho mbe Iavane","poem":1},{"noteId":198},{"text":",","poem":1},{"lineBreak":true},{"text":"mb’amo tokonose tsietoitaneo,","poem":1},{"lineBreak":true},{"text":"o mboe tsy nahajanjiñe o engekoo","poem":1},{"lineBreak":true},{"text":"ndra nahaisake o volonahekoo; vaho","poem":1},{"lineBreak":true},{"text":"ho koiha’iereo amo fifeheañeo ty engeko;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"vaho hampiavote’ iareo boak’ amo","poem":1},{"lineBreak":true},{"text":"kilakila’ ndatio o longo’ areoo","poem":1},{"lineBreak":true},{"text":"ho fañenga am’Iehovà","poem":1},{"lineBreak":true},{"text":"ambonen-tsoavala, naho an-tsarete,","poem":1},{"lineBreak":true},{"text":"naho an-tsarete mitafo,","poem":1},{"lineBreak":true},{"text":"naho miningitse borìke,","poem":1},{"lineBreak":true},{"text":"vaho ambone’ ty biby masìka","poem":1},{"lineBreak":true},{"text":"mb’ am-bohiko miavake","poem":1},{"lineBreak":true},{"text":"mb’e Ierosalaime mb’eo, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"manahake ty fibanabana’ o ana’ Israeleo o enga’ iareoo","poem":1},{"lineBreak":true},{"text":"am-pinga malio mb’añ’anjomba’ Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Boak’ am’ iereo ao ty hangàlako","poem":1},{"lineBreak":true},{"text":"mpisoroñe naho nte-Levy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa hambañe amy te ho añatrefako","poem":1},{"lineBreak":true},{"text":"nainai’e o likeram-baoo","poem":1},{"lineBreak":true},{"text":"naho i tane vao hanoekoy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te hifahatse eo ka ty tiri’ areo","poem":1},{"lineBreak":true},{"text":"naho ty tahina’ areo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho tondroke ka te boak’ami’ty jiri-bolañe pak’ am-pipeaha’e,","poem":1},{"lineBreak":true},{"text":"naho hirik’ an-­tSabata pak’ an-tSabata,","poem":1},{"lineBreak":true},{"text":"le homb’añatrefako eo ze hene veloñe,","poem":1},{"lineBreak":true},{"text":"hitalaho, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hiavotse ka iereo hisamba o fate’ ondaty niola amakoo;","poem":1},{"noteId":199},{"lineBreak":true},{"text":"tsy ho modo ty oletse ama’e,","poem":1},{"lineBreak":true},{"text":"tsy hakipeke ty afo ama’e,","poem":1},{"lineBreak":true},{"text":"ie hampangorý ze atao nofotse.","poem":1}]}],"footnotes":[{"noteId":194,"caller":"+","text":"Ies 65:4, Sor 11:7, Its 14:8","reference":{"chapter":66,"verse":17}},{"noteId":195,"caller":"+","text":"Pole: voa-maike; fandrotsaha","reference":{"chapter":66,"verse":19}},{"noteId":196,"caller":"+","text":"Lode: fisamahañe; fanaranàhañe","reference":{"chapter":66,"verse":19}},{"noteId":197,"caller":"+","text":"Tobale: ty tane toy; fivalitsikotahañe","reference":{"chapter":66,"verse":19}},{"noteId":198,"caller":"+","text":"Iavane: Mpamañahy; ty mahafioremeñe","reference":{"chapter":66,"verse":19}},{"noteId":199,"caller":"+","text":"Ies 24:6, 34:2-3, Sab 110:6, Iir 25:33","reference":{"chapter":66,"verse":24}}]},"thisChapterLink":"/api/tdx_sle/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}