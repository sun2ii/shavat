{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Tondroke tañandro’ i Akhaze ana’ i Otame, ana’ i Ozià, mpanjaka’ Iehodà, te nionjoñe haname Ierosalaime t’i Retsine",{"noteId":22},"mpanjaka’ i Arame",{"noteId":23},"naho i Pèkae",{"noteId":24},"ana’ i Remaliàho",{"noteId":25},", mpanjaka’ Israele, f’ie tsy naharotsake aze."]},{"type":"verse","number":2,"content":["Natalily amy anjomba’ i Davidey ty hoe: Nitraok’ amy Efraime t’i ­Arame. Le ninevenevetse ty arofo’e naho ty arofo’ ondati’eo, manahake ty fañezeñezeñan-tioke o hatae añ’alao."]},{"type":"verse","number":3,"content":["Aa le hoe t’Iehovà am’Iesaià, Akia henaneo, mifanalakà amy Akhaze, ihe naho i Sear’iasobe",{"noteId":26},"ana’o, am-pigadoña’ ty talaha’ i antara amboney, an-damo’ i tondam-panasay eo;"]},{"type":"verse","number":4,"content":["le isaontsio ty hoe:",{"text":"Mitaoa, mianjiña, ko hembañe,","poem":1},{"lineBreak":true},{"text":"ko mangonotse","poem":1},{"lineBreak":true},{"text":"ty amy foroha mahatoeñe roe rey,","poem":1},{"lineBreak":true},{"text":"ami’ty fidabadoà’ i Retsine","poem":1},{"lineBreak":true},{"text":"rekets’ i Arame,","poem":1},{"lineBreak":true},{"text":"naho ty ana’ i Remaliaho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amy fikiniàn-draty nanoe’ i Arame","poem":1},{"lineBreak":true},{"text":"naho i Efraime","poem":1},{"lineBreak":true},{"text":"vaho ty ana’ i Remaliaho ama’oy,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Antao hionjoñe haname Iehodà,","poem":1},{"lineBreak":true},{"text":"hampalovilovy aze,","poem":1},{"lineBreak":true},{"text":"hamakian-tika jeba","poem":1},{"lineBreak":true},{"text":"vaho hatroan-tika ty ana’ i Tabeale","poem":1},{"noteId":27},{"lineBreak":true},{"text":"ho mpanjaka añivo’e ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà Talè: Tsy hitroatse re,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho tondroke izay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I Damesèke","poem":1},{"noteId":28},{"text":"ty loha’ i Arame,","poem":1},{"lineBreak":true},{"text":"I Retsine ty loha’ i Damesèke;","poem":1},{"lineBreak":true},{"text":"(le añate ty taoñe enem-polo","poem":1},{"lineBreak":true},{"text":"lim’ amby ty hikorovoha’","poem":1},{"lineBreak":true},{"text":"i Efraime tsy ho ondaty ka;)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fehe’ i Someròne","poem":1},{"noteId":29},{"text":"t’i Efraime,","poem":1},{"lineBreak":true},{"text":"le fehè’ ty ana’ i Remaliaho ty Someròne.","poem":1},{"lineBreak":true},{"text":"Aa naho tsy gañe ty fatokisa’areo,","poem":1},{"lineBreak":true},{"text":"le toe tsy hioreñe.","poem":1}]},{"type":"verse","number":10,"content":["Aa le nitsara amy Akhaze indraike t’Iehovà nanao ty hoe:"]},{"type":"verse","number":11,"content":[{"text":"Mihalalia viloñe am’Iehovà Andrianañahare’o;","poem":1},{"lineBreak":true},{"text":"ke ami’ty halale’ i tsikeokeokey,","poem":1},{"lineBreak":true},{"text":"he ami’ty haabo i likerañey.","poem":1}]},{"type":"verse","number":12,"content":["Aa hoe t’i Akhaze: Izaho tsy hihalaly, tsy hitsoke ­Iehovà."]},{"type":"verse","number":13,"content":["Aa le hoe re:",{"text":"Janjiño arè ry anjomba’ i Davide :","poem":1},{"lineBreak":true},{"text":"Loho kede ama’areo hao ty hanosotse ondaty, kanao tsohe’ areo ka","poem":1},{"lineBreak":true},{"text":"ty fahaliñisan’ Añahareko?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I Talè arè ro hanolo-biloñe anahareo:","poem":1},{"lineBreak":true},{"text":"Heheke! hiareñe i somondraray,","poem":1},{"lineBreak":true},{"text":"naho hitoly ana-dahy,","poem":1},{"lineBreak":true},{"text":"vaho hatao’e Imanoele","poem":1},{"noteId":30},{"text":"ty añara’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Habobo naho tantele ty ho hane’e","poem":1},{"lineBreak":true},{"text":"ampara’ te fohi’e ty mikiho ty raty,","poem":1},{"lineBreak":true},{"text":"vaho hijoboñe ty soa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aolo’ ty haharendreha’ i ajajay","poem":1},{"lineBreak":true},{"text":"ty hitribahatse ty raty, hijoboña’e ty soa,","poem":1},{"lineBreak":true},{"text":"le ho farieñe ty tane’ i mpanjaka roe irevendreveña’o rey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hasese’ Iehovà ama’o naho am’ondati’oo","poem":1},{"lineBreak":true},{"text":"naho aman’ anjomban-droae’o","poem":1},{"lineBreak":true},{"text":"ty mpanjaka’ i Asore,","poem":1},{"lineBreak":true},{"text":"ami’ty andro mbe lia’e tsy nifetsake sikal’ami’ty nienga’ i Efraime t’Iehodà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho tendreke amy andro zay","poem":1},{"lineBreak":true},{"text":"te ho tiofe’ Iehovà i laletse","poem":1},{"lineBreak":true},{"text":"añ’olo’ i saka’ i Mitsraimey","poem":1},{"noteId":31},{"lineBreak":true},{"text":"naho i rene-tantele an-tane’ i Asorey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Homb’eo iereo hipetake","poem":1},{"lineBreak":true},{"text":"amo goledoñe bangiñeo naho","poem":1},{"lineBreak":true},{"text":"an-tsifi’ o vatoo naho","poem":1},{"lineBreak":true},{"text":"amy ze atao fatike vaho","poem":1},{"lineBreak":true},{"text":"amo tane fiandrazañe iabio.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amy andro zay, le ho hitsifa’ i Talè","poem":1},{"lineBreak":true},{"text":"ami’ty fiharatse nikaramae’e boak’ alafe’ i Sakay añe,","poem":1},{"lineBreak":true},{"text":"(i mpanjaka’ i Asorey ‘nio),","poem":1},{"lineBreak":true},{"text":"ty maroin’añambone naho ty volon-tomboke, vaho hafaha’e ka ty tanteahetse.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te","poem":1},{"lineBreak":true},{"text":"hihare kiloa raike","poem":1},{"lineBreak":true},{"text":"naho añondry roe t’indaty;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Eka, ho tendreke te,","poem":1},{"lineBreak":true},{"text":"ami’ty hamaro ronono homei’e","poem":1},{"lineBreak":true},{"text":"le hikama deron-kabobo re;","poem":1},{"lineBreak":true},{"text":"toe hikama habobo naho tantele","poem":1},{"lineBreak":true},{"text":"ze hene sehanga’e amy taney.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho tondroke amy andro zay te ze toetse amam-bahem-baloboke arivo,","poem":1},{"lineBreak":true},{"text":"mañeva volafoty arivo,","poem":1},{"lineBreak":true},{"text":"ty ho hisatse naho fatike avao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hinday fale rekets’ ana-pale","poem":1},{"lineBreak":true},{"text":"ze homb’eo, amy te","poem":1},{"lineBreak":true},{"text":"ho ropiteke naho fatike avao i taney.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ze hene tamboho nitrabahe’ ty fangaly taolo le tsy homba’o ami’ty fatahora’o fatike naho ahe-draty,","poem":1},{"lineBreak":true},{"text":"le ho fiandrazan’ añombe","poem":1},{"lineBreak":true},{"text":"naho fandialiàn’ añondry ty ao.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Retsine; mpañitrike talily; soa fisatria","reference":{"chapter":7,"verse":1}},{"noteId":23,"caller":"+","text":"Arame: enge, ty mpamañahy; fatse","reference":{"chapter":7,"verse":1}},{"noteId":24,"caller":"+","text":"Pekae: i mpanokakey; ie midada","reference":{"chapter":7,"verse":1}},{"noteId":25,"caller":"+","text":"Remialaho: ty fañonjonañe Iehovà","reference":{"chapter":7,"verse":1}},{"noteId":26,"caller":"+","text":"Sear’iasbe: himpoly o nisisao","reference":{"chapter":7,"verse":3}},{"noteId":27,"caller":"+","text":"Tabeale: Andrianañahare soa","reference":{"chapter":7,"verse":6}},{"noteId":28,"caller":"+","text":"Gony pea lio; hoe afo mirebareba","reference":{"chapter":7,"verse":8}},{"noteId":29,"caller":"+","text":"Somerone: vohi-pijilovañe","reference":{"chapter":7,"verse":9}},{"noteId":30,"caller":"+","text":"Imanoele: Andrianañahare-Amantika","reference":{"chapter":7,"verse":14}},{"noteId":31,"caller":"+","text":"Mitsraime: Egipte, mpamorekeke","reference":{"chapter":7,"verse":18}}]},"thisChapterLink":"/api/tdx_sle/ISA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/6.json","previousChapterAudioLinks":{},"numberOfVerses":25}