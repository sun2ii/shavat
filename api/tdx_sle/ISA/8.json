{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ISA","translationId":"tdx_sle","name":"Iesaià","commonName":"Iesaià","title":"Iesaià","order":23,"numberOfChapters":66,"sha256":"390817e2365b29dbe118124d61c86e6b0796d6d4880459f3ed51f761633b7214","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tdx_sle/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Le hoe t’Iehovà amako: Mandrambesa takelake bey vaho sokiro an-tsokitse lahi’e ty hoe:",{"text":"Malisa ty fikopake,","poem":1},{"lineBreak":true},{"text":"masika ty tsindroke,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"le ho rambeseko ho amako","poem":1},{"lineBreak":true},{"text":"ty valolombelo matoe hamolily,","poem":1},{"lineBreak":true},{"text":"i Orià","poem":1},{"noteId":32},{"text":"mpisoroñe","poem":1},{"lineBreak":true},{"text":"naho i Zekarià","poem":1},{"noteId":33},{"text":"ana’ Ieberekiaho","poem":1},{"noteId":34},{"text":".","poem":1}]},{"type":"verse","number":3,"content":["Aa le nimb’amy rakemba mpitokiy iraho; niaren-dre vaho nisamak’ ana-dahy. Le hoe t’Iehovà amako, Itokavo ty hoe Maher-salal-kas-baze",{"noteId":35},","]},{"type":"verse","number":4,"content":["amy te aolo’ ty aharendreha’ i ajajay ty hikoike ty hoe ‘Raeko’ naho ‘Reneko,’ le fa nasese’ i mpanjaka’ i Asorey añe ty vara’ i Damesèke naho ty fikopahañe i Somerone."]},{"type":"verse","number":5,"content":["Nitsara amako indraike t’Iehovà nanao ty hoe:"]},{"type":"verse","number":6,"content":[{"text":"Kanao nitsambolitio’ondaty retiañe","poem":1},{"lineBreak":true},{"text":"ty rano’ i Siloake","poem":1},{"noteId":36},{"text":"mitsiri­tsioke moray,","poem":1},{"lineBreak":true},{"text":"vaho mirebeke amy Retsine","poem":1},{"lineBreak":true},{"text":"naho ty ana’ i Remaliaho;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Inao arè te hampandipore’ i Talè am’iareo ty rano’ i Saka","poem":1},{"lineBreak":true},{"text":"maozatse naho beiy:","poem":1},{"lineBreak":true},{"text":"i mpanjaka’ i Asorey amy ze hene enge’e; hanginahina amo talaha’e iabio,","poem":1},{"lineBreak":true},{"text":"hitoabotse ambone’ ze hene fitroara’e;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hifaoke mb’e Iehodà re,","poem":1},{"lineBreak":true},{"text":"handopatse vaho hiranga mb’eo,","poem":1},{"lineBreak":true},{"text":"Eka ho takare’e ty fititia; hibànatse hañatseke i tane’oy","poem":1},{"lineBreak":true},{"text":"ami’ty fivela’ o ela’eo, ry Imanoele.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mijeñajeñafa ry ondaty; Midemoha!","poem":1},{"lineBreak":true},{"text":"Manolora ravembia,","poem":1},{"lineBreak":true},{"text":"ry an-tsietoitane añe;","poem":1},{"lineBreak":true},{"text":"miteveha sadia f’ie ho demoheñe;","poem":1},{"lineBreak":true},{"text":"misadia fe ho demoheñe;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Misafiria safiry, fe tsy hanjofake;","poem":1},{"lineBreak":true},{"text":"mañotsohotso firefeañe, f’ie tsy hijadoñe","poem":1},{"lineBreak":true},{"text":"fa ama’ay t’i Andrianañahare.","poem":1},{"noteId":37}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nametse amako t’Iehovà","poem":1},{"lineBreak":true},{"text":"am-pità’e maozatse,","poem":1},{"lineBreak":true},{"text":"nañeretse ahy tsy hanjotike","poem":1},{"lineBreak":true},{"text":"ami’ ty lala’ ondaty retiañe, ami’ty hoe:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ko ano ty hoe: ‘Kilily,’","poem":1},{"lineBreak":true},{"text":"o raha iaby atao’ ondaty","poem":1},{"lineBreak":true},{"text":"retiañe ho fikililiañeo;","poem":1},{"lineBreak":true},{"text":"ko hembañe’o ty fihembaña’ iareo,","poem":1},{"lineBreak":true},{"text":"le ko ihebakebaha’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hamasiño t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ie ty ihembaña’ areo,","poem":1},{"lineBreak":true},{"text":"ie ty añeveña’ areo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho fitsolohañe re,","poem":1},{"lineBreak":true},{"text":"fe ho vato fikotroforañe","poem":1},{"lineBreak":true},{"text":"naho lamilamy fitsikapiañe","poem":1},{"lineBreak":true},{"text":"amy anjomba roe’ Israele rey;","poem":1},{"lineBreak":true},{"text":"ho fandrike naho koboñe","poem":1},{"lineBreak":true},{"text":"amo mpimoneñe e Ierosalaimeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hitotohitse ty maro, hikorovoke","poem":1},{"lineBreak":true},{"text":"ho sèrañe, ho ­fandriheñe vaho ho tsepake.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vahoro i fañinay,","poem":1},{"lineBreak":true},{"text":"liteo ho a o mpiamakoo ty fañòha’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le handiñe Iehovà iraho,","poem":1},{"lineBreak":true},{"text":"I mañeta-daharañe amy anjomba’","poem":1},{"lineBreak":true},{"text":"Iakobey: Ama’e ao ty fitamàko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Intoy iraho naho o anake natolo’","poem":1},{"lineBreak":true},{"text":"Iehovà ahikoo!","poem":1},{"lineBreak":true},{"text":"Viloñe naho halatsañe e Israele atoy","poem":1},{"lineBreak":true},{"text":"boak’ am’ Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"I mimoneñe am-Bohi-Tsioney.","poem":1}]},{"type":"verse","number":19,"content":["Ie sigihe’iereo ami’ty hoe: Ipaiao amo jinio naho amo doany miñeoñeoñe naho mitreontreoñeo; Aa tsy ho paiae’ ondatio hao t’i Andrianañahare’e? Hantsaka fañahin-dolo hao o veloñeo?"]},{"type":"verse","number":20,"content":["Mb’an-Kàke naho i fañinay! Naho tsy milahatse ami’ty tsara toy ty enta’ iareo, le tsy nanjirihan’ andro."]},{"type":"verse","number":21,"content":["Hiranga aze iereo, am-poheke naho hasalikoañe, aa ie milingoa, le ho boseke vaho hamatse i mpanjaka’ iareoy naho ty ’ndrahare’ iareo. Aa ke hian­drandra iereo,"]},{"type":"verse","number":22,"content":["hera hitolike an-tane, le haronje am-paloviloviañe naho am-pigodoñañe, an-kamoromoroñañe naho an-kaferenaiñañe vaho añ’ ieñe ao."]},{"type":"verse","number":23,"content":[{"text":"Ie amy zao, tsy ho an-kamoromoroñañe ao ka i naloviloviy;","poem":1},{"lineBreak":true},{"text":"nimavoe’e ty tane’ i Zebolone","poem":1},{"lineBreak":true},{"text":"naho ty tane’ i Naftale te taolo,","poem":1},{"lineBreak":true},{"text":"fe honjone’e ty enge’e añ’andro añe,","poem":1},{"lineBreak":true},{"text":"le hampilifore’e volonahetse","poem":1},{"lineBreak":true},{"text":"ty an-dala’ i riakey, alafe’ Iordaneiy","poem":1},{"noteId":38},{"lineBreak":true},{"text":"amy Galilà","poem":1},{"noteId":39},{"text":"’ o kilakila’ ndatioy.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Orià: Iehovà ro fañiloko","reference":{"chapter":8,"verse":2}},{"noteId":33,"caller":"+","text":"Zekarià, he Zakarià: ty fitiahiañe Iehovà","reference":{"chapter":8,"verse":2}},{"noteId":34,"caller":"+","text":"Ieberekiaho: mitongaleke am’ Iehovà","reference":{"chapter":8,"verse":2}},{"noteId":35,"caller":"+","text":"Maher-salal-kas-baze: oniño ty and. 1","reference":{"chapter":8,"verse":3}},{"noteId":36,"caller":"+","text":"Siloake, tsampa, fialia, kalan-defo","reference":{"chapter":8,"verse":6}},{"noteId":37,"caller":"+","text":"Heb: Imano El","reference":{"chapter":8,"verse":10}},{"noteId":38,"caller":"+","text":"Iordane : sakam-pizakañe","reference":{"chapter":8,"verse":23}},{"noteId":39,"caller":"+","text":"Galilà : larò; fivarimbariñañe","reference":{"chapter":8,"verse":23}}]},"thisChapterLink":"/api/tdx_sle/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}