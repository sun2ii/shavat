em":1},{"lineBreak":true},{"text":"e Someroneo,","poem":1},{"lineBreak":true},{"text":"ie manao am-pirengevohañe naho","poem":1},{"lineBreak":true},{"text":"fitrotroabohañe ty hoe:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa nirotsake o birìkeo,","poem":1},{"lineBreak":true},{"text":"f’ie ho rafite’ay am-bato vinàñe;","poem":1},{"lineBreak":true},{"text":"fa finira o sakoañeo,","poem":1},{"lineBreak":true},{"text":"f’ie ho soloa’ay mendoraveñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa le hatroa’ Iehovà o rafelahi’eo","poem":1},{"lineBreak":true},{"text":"hiatreatre i Retsine;","poem":1},{"lineBreak":true},{"text":"vaho havitra’e ho raike o malaiñ’azeo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ho atiñanañe ey o nte-Arameo","poem":1},{"lineBreak":true},{"text":"naho ahandrefañe ey o nte Pilistio","poem":1},{"noteId":42},{"text":";","poem":1},{"lineBreak":true},{"text":"vaho habotse’ iareo am-palie mitañataña t’Israele.","poem":1},{"lineBreak":true},{"text":"Ie amy zay iaby mbe tsy mivio","poem":1},{"lineBreak":true},{"text":"ty haviñera’e,","poem":1},{"lineBreak":true},{"text":"fa mbe mitora-kitsy ty fità’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fe mboe tsy mitolike amy","poem":1},{"lineBreak":true},{"text":"Mpandafa’ iareoy ondatio,","poem":1},{"lineBreak":true},{"text":"vaho mboe tsy nitsoehe’ iareo","poem":1},{"lineBreak":true},{"text":"t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le ho kitsife’ Iehovà","poem":1},{"lineBreak":true},{"text":"ami’ty andro raike","poem":1},{"lineBreak":true},{"text":"ty loha naho ty rambo’ Israele,","poem":1},{"lineBreak":true},{"text":"ty ran-tsatrañe naho ty vinda.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ty androanavy naho ty iasiañe","poem":1},{"lineBreak":true},{"text":"ro lohà