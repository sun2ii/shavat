{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JDG","translationId":"tdx_sle","name":"Mpizaka","commonName":"Mpizaka","title":"Mpizaka","order":7,"numberOfChapters":21,"sha256":"167f4c65ea9b7c8c1fabafdd5608c9a84360608867ad50949933ff0c3eacd92e","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/tdx_sle/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Nisabo ty hoe amy andro zay t’i Deborae naho i Barak’ ana’ i Abinoame:"]},{"type":"verse","number":2,"content":[{"text":"Andriaño t’Iehovà","poem":1},{"lineBreak":true},{"text":"te nonjoneñe ty lohà’ Israele,","poem":1},{"lineBreak":true},{"text":"naho nanolo-batañe an-tsatri’e ondatio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mijanjiña ry mpanjaka,","poem":1},{"lineBreak":true},{"text":"manokilaña ravembia ry roandriañeo;","poem":1},{"lineBreak":true},{"text":"izaho eka izaho ty hisabo am’Iehovà,","poem":1},{"lineBreak":true},{"text":"ho rengeko an-tsabo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ry Iehovà, ihe nionjoñe boake Seire ao","poem":1},{"lineBreak":true},{"text":"ihe niroborobo boak’an-tete’ i Edome ao, nanginikinike i taney,","poem":1},{"lineBreak":true},{"text":"nifororoake o an-dikerañeo,","poem":1},{"lineBreak":true},{"text":"eka nampikojojoake rano o rahoñeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nitranak’ aolo’ Iehovà o vohitseo,","poem":1},{"lineBreak":true},{"text":"naho i Sinaiy","poem":1},{"noteId":51},{"text":"añatrefa’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie tañ’andro i Samgare ana’ i Anate,","poem":1},{"lineBreak":true},{"text":"faha’ Iaele, ie nikoake o damokeo;","poem":1},{"lineBreak":true},{"text":"ninokitse an-dalan-tsileke","poem":1},{"lineBreak":true},{"text":"ze atao mpañavelo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hene nijihetse o mpimone’ o tanañeo,","poem":1},{"lineBreak":true},{"text":"nijohañe t’Israele","poem":1},{"lineBreak":true},{"text":"ampara’ te nitroatse t’i Deborae,","poem":1},{"lineBreak":true},{"text":"ie niongake ho rene’ Israele.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe nijoboñe ‘ndrahare vao iereo,","poem":1},{"lineBreak":true},{"text":"vaho an-dalambey eo ty aly;","poem":1},{"lineBreak":true},{"text":"nitendrek’ amo efats’ ale’ Israeleo hao ty fikalandefo ndra ty lefoñe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mitolik’ amo roandria’ Israeleo ty troko,","poem":1},{"lineBreak":true},{"text":"o nanolo-batañe an-tsatri’e boak’ am’ondati’eo; andriaño t’Iehovà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Misaontsia ry mpiningi-borìke fotio,","poem":1},{"lineBreak":true},{"text":"o mpiaolo an-jakao,","poem":1},{"lineBreak":true},{"text":"naho mañavelo amy lalañey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ambone’ ty feom-pitàm-pale","poem":1},{"lineBreak":true},{"text":"am-pitarihan-drano eo,","poem":1},{"lineBreak":true},{"text":"ty hitalilia’ iareo","poem":1},{"lineBreak":true},{"text":"o fitoloñam-banta’ Iehovào,","poem":1},{"lineBreak":true},{"text":"ty asa’e mahity amo tanàñe e Israeleo,","poem":1},{"lineBreak":true},{"text":"le hizotso mb’an-dalam-bey mb’eo","poem":1},{"lineBreak":true},{"text":"ondati’ Iehovào henane zao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mivañona, mivañona, ry Deborae,","poem":1},{"lineBreak":true},{"text":"mitroara, mitroara, le andaharo sabo,","poem":1},{"lineBreak":true},{"text":"miongaha ry Barake, le kozozoto","poem":1},{"lineBreak":true},{"text":"mb’ am-pandrohizam-b’eo","poem":1},{"lineBreak":true},{"text":"o mpirohi’oo ry ana-dahi’ i Abinoame.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nizotso mb’etoa o fanalolahy sehanga’eo;","poem":1},{"lineBreak":true},{"text":"nampifehe’ Iehovà ahy o maozatseo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Niboake Efraime i vaha’ey","poem":1},{"lineBreak":true},{"text":"hiatreke i Amaleke;","poem":1},{"lineBreak":true},{"text":"nanonjohy aze t’i Beniamine haname ondati’oo;","poem":1},{"lineBreak":true},{"text":"niakatse i Makire o mpandilio;","poem":1},{"lineBreak":true},{"text":"naho boake Zebolone","poem":1},{"lineBreak":true},{"text":"o mahafitan-tsatilòm-panokitseo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nindre amy Deborae ka o roandria’ Isakareo","poem":1},{"lineBreak":true},{"text":"nañorik’ an-tomi’ i Barake t’Isakare","poem":1},{"lineBreak":true},{"text":"mb’am-bavatane mb’eo;","poem":1},{"lineBreak":true},{"text":"toe ra’elahy ty fitsakorean’ arofo’","poem":1},{"lineBreak":true},{"text":"o mpirai-lia’ i Reobeneo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ino ty nimoneña’o an-goloboñ’ ao,","poem":1},{"lineBreak":true},{"text":"hijanjiña’o ty fibabababà’","poem":1},{"lineBreak":true},{"text":"o lia-raikeo?","poem":1},{"lineBreak":true},{"text":"Toe ra’elahy ty fitsikarahan’ arofo’","poem":1},{"lineBreak":true},{"text":"o mpirai-lia’ i Reobeneo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nitambatse alafe’ Iordaney t’i Gilade,","poem":1},{"lineBreak":true},{"text":"nañino ka ty fitsoloha’ i Dane","poem":1},{"lineBreak":true},{"text":"ankalo’ o lakañeo?","poem":1},{"lineBreak":true},{"text":"Nidoñe añolon-driake añe t’i Asere,","poem":1},{"lineBreak":true},{"text":"nimoneñe am-pitolian-dakañe eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I Zebolone ty rofoko namoe’aiñe","poem":1},{"lineBreak":true},{"text":"ampara’ ty fivetrahañe,","poem":1},{"lineBreak":true},{"text":"naho i Naftalý an-kaboa’ o hivokeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nimb’eo o mpanjakao nialy;","poem":1},{"lineBreak":true},{"text":"nañotakotake e Taanake","poem":1},{"lineBreak":true},{"text":"o mpanjaka’ i Khanàne marine’","poem":1},{"lineBreak":true},{"text":"o rano’ i Megidòo,","poem":1},{"lineBreak":true},{"text":"tsy nandrambe vola ho tambe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nialy o boak’ an-dikerañeo,","poem":1},{"lineBreak":true},{"text":"nialy amy Siserà o vasiañeo","poem":1},{"lineBreak":true},{"text":"boak’ amo lala’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sinao’ ty saka Kisone iereo,","poem":1},{"lineBreak":true},{"text":"i saka haehaey, i saka’ Kisoney.","poem":1},{"lineBreak":true},{"text":"Mañitsaha an-kaozarañe, ry troko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hotron-tsoavala amy zao,","poem":1},{"lineBreak":true},{"text":"godogodoin-drimatse,","poem":1},{"lineBreak":true},{"text":"ty fandrimata’ o fanalohahi’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Afatse t’i Meroze","poem":1},{"noteId":52},{"text":"hoe ty anjeli’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ozoño mena o mpimone’eo,","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy niavy hañolotse Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy nolora’iareo t’Iehovà hiatrek’ o lahidefoñeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Haha amo rakembao t’Iaele,","poem":1},{"lineBreak":true},{"text":"tañanjomba’ i Kevere, nte-Keny;","poem":1},{"lineBreak":true},{"text":"haha re amo rakemba an-kibohotseo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Rano ty nihalalie’e fe ronono ty nazotso’e;","poem":1},{"lineBreak":true},{"text":"nanjotsoa’e dero am-pinga mañeva.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Rinambem-pità’e i tsatokey,","poem":1},{"lineBreak":true},{"text":"ty fità’e havana rekets’ ana-batom-pitoloñañe;","poem":1},{"lineBreak":true},{"text":"finofo’e amy ana-batoy t’i Sisera,","poem":1},{"lineBreak":true},{"text":"nampipotire’e ty añambone’e,","poem":1},{"lineBreak":true},{"text":"Eka, tinombo’e naho trinofa’e","poem":1},{"lineBreak":true},{"text":"o fitendrean’aoli’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Am-pandia’e eo ty nibokobokoa’e;","poem":1},{"lineBreak":true},{"text":"nikorovoke, nandre;","poem":1},{"lineBreak":true},{"text":"am-pandia’e eo ty niondreha’e,","poem":1},{"lineBreak":true},{"text":"nilantsiñe eo, amy nihotraha’ey,","poem":1},{"lineBreak":true},{"text":"teo ty nidona’e mate.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nitalake an-dalan-kede’e añe ty rene’ i Siserà","poem":1},{"lineBreak":true},{"text":"nikoaik’ an-tsingarakarake:","poem":1},{"lineBreak":true},{"text":"Ino ty nahatambatse i sarete’ey añe?","poem":1},{"lineBreak":true},{"text":"Akore te mihenekenek’ añe avao","poem":1},{"lineBreak":true},{"text":"o laròn-tsarete’eo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nanoiñe aze o ana-donak’ ampela’e mahihitseo,","poem":1},{"lineBreak":true},{"text":"Eka nifanointoiñe ama’e o fivola’eo,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hera t’ie nitendreke fikopahañe,","poem":1},{"lineBreak":true},{"text":"vaho mifanjara?","poem":1},{"lineBreak":true},{"text":"Songa ondaty aman-tsomondrara’e ndra roe;","poem":1},{"lineBreak":true},{"text":"le amy Siserà ty vara maro volo;","poem":1},{"lineBreak":true},{"text":"fikopahañe am-bolo’e ankafankafa,","poem":1},{"lineBreak":true},{"text":"satam-pitrebeke,","poem":1},{"lineBreak":true},{"text":"volom-pitoloñam-pitrebeke","poem":1},{"lineBreak":true},{"text":"ami’ty lafi’e roe,","poem":1},{"lineBreak":true},{"text":"mañeva ty fititia’ o mpamaokeo?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Izay ty hivetraha’ o rafelahi’o iabio","poem":1},{"lineBreak":true},{"text":"ry Iehovà;","poem":1},{"lineBreak":true},{"text":"le hanahake i àndroy am-pionjona’e","poem":1},{"lineBreak":true},{"text":"an-kaozarañe, o mikoko Azeo.","poem":1},"Le nitofa efa-polo taoñe i taney."]}],"footnotes":[{"noteId":51,"caller":"+","text":"Sinay: rongoñe; firafelahiañe","reference":{"chapter":5,"verse":5}},{"noteId":52,"caller":"+","text":"Meroze: raha mietake; boròke","reference":{"chapter":5,"verse":23}}]},"thisChapterLink":"/api/tdx_sle/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}