{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Inao ty entañe tsarae’ Iehovà","poem":1},{"lineBreak":true},{"text":"ama’ areo ry anjomba’ Israeleo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ko mizatse ami’ty sata’ o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"vaho ko hakahaka’areo o vilon-dikerañeo; ndra te ampifimpìñe’e o kilakila’ ndatio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toe kafoak’ avao o sata’ondatioo;","poem":1},{"lineBreak":true},{"text":"amy te hatae finira añ’ala ao","poem":1},{"lineBreak":true},{"text":"ty fitoloñam-pitàm-pandranjy","poem":1},{"lineBreak":true},{"text":"am-pekoñe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ihamina’ iareo volafoty naho volamena","poem":1},{"lineBreak":true},{"text":"ampireketa’iareo fati-biñe","poem":1},{"lineBreak":true},{"text":"ami’ty ana-bato, tsy hitroetroe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hoe bodan-katae","poem":1},{"lineBreak":true},{"text":"najadoñe antetem-bazavo ao,","poem":1},{"lineBreak":true},{"text":"tsy mivolañe, tsy mete tsy tintineñe","poem":1},{"lineBreak":true},{"text":"vaho tsy mahay mitsontike.","poem":1},{"lineBreak":true},{"text":"Ko ihembaña’ areo,","poem":1},{"lineBreak":true},{"text":"fa tsy mete manao raty izay,","poem":1},{"lineBreak":true},{"text":"vaho tsy ama’e ty manao soa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy eo ty mañirinkiriñ’ Azo r’Iehovà","poem":1},{"lineBreak":true},{"text":"Jabahinake irehe; vaho mitiotiotse","poem":1},{"lineBreak":true},{"text":"an-kaozarañe i tahina’oy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ia ty tsy hañeveñe ama’o,","poem":1},{"lineBreak":true},{"text":"ry mpanjaka’ o fifeheañeo?","poem":1},{"lineBreak":true},{"text":"Toe mañeva Azo;","poem":1},{"lineBreak":true},{"text":"fa tsy eo ty mañirinkiriñe Azo amo hene mahihitse amo fifelehañeo","poem":1},{"lineBreak":true},{"text":"naho amo borizà’iareo iabio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toe fonga votro mineñe,","poem":1},{"lineBreak":true},{"text":"ie foto-katae ty fañòhan-kafoa’e;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nendeseñe boake Tarsise","poem":1},{"noteId":33},{"text":"añe,","poem":1},{"lineBreak":true},{"text":"ty volafoty pinepèke,","poem":1},{"lineBreak":true},{"text":"naho hirik’ Ofaze","poem":1},{"noteId":34},{"text":"añe ty volamena,","poem":1},{"lineBreak":true},{"text":"ty satam-pitsene naho","poem":1},{"lineBreak":true},{"text":"satam-pitam-pitolom-bolamena;","poem":1},{"lineBreak":true},{"text":"manga naho malomàvo ty saro’iareo;","poem":1},{"lineBreak":true},{"text":"sata’ o mahimbañeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe Iehovà ro Andrianañahare to,","poem":1},{"lineBreak":true},{"text":"Ie t’i Andrianañahare veloñe,","poem":1},{"lineBreak":true},{"text":"naho t’i Mpanjaka nainai’e;","poem":1},{"lineBreak":true},{"text":"miezeñezeñe ty tane toy,","poem":1},{"lineBreak":true},{"text":"ami’ty haviñera’e","poem":1},{"lineBreak":true},{"text":"vaho tsy leo’ o kilakila’ ndatio","poem":1},{"lineBreak":true},{"text":"ty fifomboa’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe ty ho saontsie’o am’ iereo:","poem":1},{"lineBreak":true},{"text":"Ho modo an-tane atoy","poem":1},{"lineBreak":true},{"text":"naho ambanen-dikerañe ao","poem":1},{"lineBreak":true},{"text":"o ‘ndrahare tsy namboatse","poem":1},{"lineBreak":true},{"text":"o likerañeo naho ty tane toio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie namboatse ty tane toy","poem":1},{"lineBreak":true},{"text":"amy haozara’ey,","poem":1},{"lineBreak":true},{"text":"Ie nampijadoñe ty voatse toy","poem":1},{"lineBreak":true},{"text":"amy hihi’ey","poem":1},{"lineBreak":true},{"text":"vaho Ie nandafike o likerañeo","poem":1},{"lineBreak":true},{"text":"amy faharofoana’ey;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I fiarañanaña’ey","poem":1},{"lineBreak":true},{"text":"le ikoboboahañe o ranon-dikerañeo,","poem":1},{"lineBreak":true},{"text":"naho mampionjoñe ty evoñe","poem":1},{"lineBreak":true},{"text":"añ’olo-ty tane toy;","poem":1},{"lineBreak":true},{"text":"amboara’e ampiñe o orañeo,","poem":1},{"lineBreak":true},{"text":"vaho ampiakare’e an-driha’e ao i tiokey;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Songa tembo ondatio, tsy aman-kilala,","poem":1},{"lineBreak":true},{"text":"sindre ampisalareñe ty amo samposampon-draha’eo","poem":1},{"lineBreak":true},{"text":"ty mpitolom-bolamena,","poem":1},{"lineBreak":true},{"text":"remborake o sare natrana’eo,","poem":1},{"lineBreak":true},{"text":"tsy aman-kofòke.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kafoake irezay, satam-pamerevere;","poem":1},{"lineBreak":true},{"text":"hiambotraha’ ty fandrotsahañe","poem":1},{"lineBreak":true},{"text":"amy androm-pitilihañey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsy hoe izay t’i Anjara’ Iakobe;","poem":1},{"lineBreak":true},{"text":"Ie ty Mpañoreñe ze he’e,","poem":1},{"lineBreak":true},{"text":"naho kobain-dova’ey t’Israele,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ahoroño amo taneo ty harao’ areo,","poem":1},{"lineBreak":true},{"text":"ry mpifeake amy arikatokey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Hehe te ho pilereko an-tane atoy","poem":1},{"lineBreak":true},{"text":"henaneo o mpimone’ i taneio,","poem":1},{"lineBreak":true},{"text":"le ho fihineko, haharendreha’ iareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hankàñe amako ty fanaintaiñako!","poem":1},{"lineBreak":true},{"text":"Leveleve ty fereko; fe hoe iraho:","poem":1},{"lineBreak":true},{"text":"Toe hasilofeñe toy, tsy mete tsy ifeahako.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Rotsake i kivohokoy, tampake iaby o tali’eo;","poem":1},{"lineBreak":true},{"text":"fonga nienga ahy o anakoo, tsy ao;","poem":1},{"lineBreak":true},{"text":"tsy eo ka ty handafike i kibohokoy,","poem":1},{"lineBreak":true},{"text":"naho hampitroatse o efe’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Fa votro o mpiarak’añondrio,","poem":1},{"lineBreak":true},{"text":"tsy nañontane Iehovà;","poem":1},{"lineBreak":true},{"text":"aa le tsy miraorao,","poem":1},{"lineBreak":true},{"text":"vaho miparaitak’ añe o añondri’ iareoo","poem":1},{"noteId":35},{"text":".","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Inao ty talily, Hehe te mb’etoa,","poem":1},{"lineBreak":true},{"text":"ty fikoraham-bey","poem":1},{"lineBreak":true},{"text":"boak’an-tane avaratse añe,","poem":1},{"lineBreak":true},{"text":"hampangotomomoke","poem":1},{"lineBreak":true},{"text":"o rova’ Iehodào,","poem":1},{"lineBreak":true},{"text":"ho fimoneñam-panaloke.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ry Iehovà,","poem":1},{"lineBreak":true},{"text":"apotako te tsy am’ ondatio ty fombà’e;","poem":1},{"lineBreak":true},{"text":"tsy am’ondaty mpañaveloo","poem":1},{"lineBreak":true},{"text":"ty hanehake o fandia’eo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Endaho iraho, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"le an-katò;","poem":1},{"lineBreak":true},{"text":"tsy ami’ty filoroloroa’o","poem":1},{"lineBreak":true},{"text":"hera hampiminjikio’o.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Adoaño amo kilakila’ ondaty tsy mahafohiñe Azoo ty haviñera’o,","poem":1},{"lineBreak":true},{"text":"naho amo fifokoa tsy mikanjy i tahina’oio","poem":1},{"noteId":36},{"text":";","poem":1},{"lineBreak":true},{"text":"fa nabotse’ iareo t’Iakobe,","poem":1},{"lineBreak":true},{"text":"eka vinaza’ iareo naho nagedra’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho nampangoakoahe’ iareo","poem":1},{"lineBreak":true},{"text":"i fimoneña’ey.","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"Tarsise: fitsakoreañe; fihotsohotsoañe","reference":{"chapter":10,"verse":9}},{"noteId":34,"caller":"+","text":"Ofaze: volamena ki’e","reference":{"chapter":10,"verse":9}},{"noteId":35,"caller":"+","text":"Iir 2:8, 12:10-11, 50:6-7, Iek 34:1-23, Ti II 4:3-4, Pe II 2:1-22","reference":{"chapter":10,"verse":21}},{"noteId":36,"caller":"+","text":"Sab 11:4, Mik 4:5","reference":{"chapter":10,"vers