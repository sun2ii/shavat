{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ty tsara nivotrak’ am’ Iirmeà,","poem":1},{"lineBreak":true},{"text":"boak’am’ Iehovà, manao ty hoe:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Janjiño ty tsara’ ty fañina toy,","poem":1},{"lineBreak":true},{"text":"naho mitaroña am’ ondati’ Iehodào,","poem":1},{"lineBreak":true},{"text":"naho amo mpimone’ Ierosalaimeo;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"vaho ano ty hoe:","poem":1},{"lineBreak":true},{"text":"Hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele:","poem":1},{"lineBreak":true},{"text":"Fatse t’ indaty tsy mañaoñe","poem":1},{"lineBreak":true},{"text":"o tsara’ ty fañina toio,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I nandiliako an-droae’ areo amy andro","poem":1},{"lineBreak":true},{"text":"nampiengako an-tane Mitsraime","poem":1},{"lineBreak":true},{"text":"boak’ an-toñam-biy, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Haoño ty feoko","poem":1},{"noteId":37},{"text":", naho anò","poem":1},{"lineBreak":true},{"text":"ze hene andiliako; soa te h’ondatiko nahareo,","poem":1},{"lineBreak":true},{"text":"vaho ho Andrianañahare’ areo iraho;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"hampijadoñeko i fañina natoloko","poem":1},{"lineBreak":true},{"text":"an-droae’ areoy, homeako iareo ty tane","poem":1},{"lineBreak":true},{"text":"orikorehen-dronono naho tantele,","poem":1},{"lineBreak":true},{"text":"ie o henaneo.","poem":1},{"lineBreak":true},{"text":"Le hoe iraho, Amena","poem":1},{"noteId":38},{"text":", ry Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Hene tseizo amo rova’ Iehodào","poem":1},{"lineBreak":true},{"text":"naho amo lala’ Ierosalaimeo","poem":1},{"lineBreak":true},{"text":"o tsara zao, ty hoe:","poem":1},{"lineBreak":true},{"text":"Mijanjiña o tsara’ i fañinaio, vaho ano!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa hinatahatako soa o roae’ areoo","poem":1},{"lineBreak":true},{"text":"amy andro nañakarako iareo","poem":1},{"lineBreak":true},{"text":"an-tane’ Mitsraimey, pak’ androany,","poem":1},{"lineBreak":true},{"text":"boa-maraindray te mitolom-","poem":1},{"lineBreak":true},{"text":"pitaroñe ama’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Haoño ty feoko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"F’ie nañajife avao iereo,","poem":1},{"lineBreak":true},{"text":"tsy nanokilan-dravembia,","poem":1},{"lineBreak":true},{"text":"songa nitsontike ami’ty","poem":1},{"lineBreak":true},{"text":"fanjeharan-tro’e raty;","poem":1},{"lineBreak":true},{"text":"aa le fonga nafetsako am’ iereo","poem":1},{"lineBreak":true},{"text":"o tsara’ ty fañina toio,","poem":1},{"lineBreak":true},{"text":"i nandiliako hanoeñey,","poem":1},{"lineBreak":true},{"text":"f’ie tsy nipaoke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Zoeñe am’ondati’ Iehodao, naho amo mpimone’Ierosalaimeo ty kinia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie nibalike mb’amo hakeon-droae’","poem":1},{"lineBreak":true},{"text":"iareoo avao,","poem":1},{"lineBreak":true},{"text":"ami’ty tsy fañaoñañe o volakoo;","poem":1},{"lineBreak":true},{"text":"vaho nienga hañorike ‘ndrahare ila’e hitoroñe iareo;","poem":1},{"lineBreak":true},{"text":"songa nivalike amy fañina nanoeko","poem":1},{"lineBreak":true},{"text":"aman-droae’ey","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Israele naho","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Iehodà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ingo handesako ty raty","poem":1},{"lineBreak":true},{"text":"tsy hahafipoliorañe;","poem":1},{"lineBreak":true},{"text":"aa ndra t’ie hikaikaik’ ahy","poem":1},{"lineBreak":true},{"text":"Izaho tsy hañaoñe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie amy zao hiheo mb’eo","poem":1},{"lineBreak":true},{"text":"o rova’ Iehodào","poem":1},{"lineBreak":true},{"text":"naho o mpimone’ Ierosalaimeo","poem":1},{"lineBreak":true},{"text":"hikoikoike amo ‘ndrahare ila’e","poem":1},{"lineBreak":true},{"text":"fañenga’ iareoo;","poem":1},{"lineBreak":true},{"text":"f’ie toe tsy haharombake","poem":1},{"lineBreak":true},{"text":"amy san-kasotriañey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa mira ami’ty ia’ o rova’oo","poem":1},{"lineBreak":true},{"text":"o ‘ndrahare’ areoo, ry Iehodà;","poem":1},{"lineBreak":true},{"text":"vaho mifandrae ami’ty ia’ o lalañe","poem":1},{"lineBreak":true},{"text":"e Ierosalaimeo","poem":1},{"lineBreak":true},{"text":"o kitrely natroa’ areo amy raha tivaio,","poem":1},{"lineBreak":true},{"text":"o kitrely fisoroña’ areo amy Baaleo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le ko mihalaly ho a’ ondaty retoa,","poem":1},{"lineBreak":true},{"text":"naho ko añonjona’o soloho;","poem":1},{"lineBreak":true},{"text":"fa tsy hitsanon-draho amy andro ikaikaiha’ iareo","poem":1},{"lineBreak":true},{"text":"te malovilovy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ino ty anoe’ i kokoakoy an-kivohoko ao, kanao nanoa’e hakarapiloañe amy màroy?","poem":1},{"lineBreak":true},{"text":"ie tsy sazo azo i henam-pisoroña’o miavakey?","poem":1},{"lineBreak":true},{"text":"Amy te mampirebek’azo","poem":1},{"lineBreak":true},{"text":"ty manao hatsivokarañe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tinoño’ Iehovà ty hoe ty añara’o,","poem":1},{"lineBreak":true},{"text":"Hatae olive mandrevake,","poem":1},{"lineBreak":true},{"text":"fanjaka am-boa’e, soa vintañe.","poem":1},{"lineBreak":true},{"text":"Am-pikorahan-kotakotake","poem":1},{"lineBreak":true},{"text":"t’ie namiañe afo ama’e,","poem":1},{"lineBreak":true},{"text":"vaho fonga pinozapozake o tsampa’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Iehovà’ i Màroy, i nañetsa azoy","poem":1},{"lineBreak":true},{"text":"ty namatse hekoheko ama’o,","poem":1},{"lineBreak":true},{"text":"ty amy hatsivokara’ ty kiboho’ Israeley,","poem":1},{"lineBreak":true},{"text":"naho ty kivoho’ Iehodày,","poem":1},{"lineBreak":true},{"text":"ie fa nifetsak’ama’ iareo","poem":1},{"lineBreak":true},{"text":"ami’ty fanigiha’ iareo ahy","poem":1},{"lineBreak":true},{"text":"amy fisoroña’ iareo amy Baaley.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tinolo’ Iehovà hilala ama’e iraho,","poem":1},{"lineBreak":true},{"text":"vaho nirendreko;","poem":1},{"lineBreak":true},{"text":"naboa’o amako ty sata’ iareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fe nihoe anak’añondry nitrotrotrotro iraho te nitantalieñe mb’eo ho lentañe;","poem":1},{"lineBreak":true},{"text":"le tsy napotako t’ie nikilily ahy,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Antao hamira i hataey","poem":1},{"lineBreak":true},{"text":"rekets’ o voa ama’eo;","poem":1},{"lineBreak":true},{"text":"ie haitoan-tika an-tanen-kaveloñe,","poem":1},{"lineBreak":true},{"text":"tsy ho tiahy ka ty añara’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O ry Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ry mpizaka an-katò,","poem":1},{"lineBreak":true},{"text":"ry mpitsoke ova naho troke,","poem":1},{"lineBreak":true},{"text":"ehe te ho treako ty hañondroha’o am’ iareo;","poem":1},{"lineBreak":true},{"text":"Ihe ro niborahako ty toreoko.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà ty am’ondaty nte-","poem":1},{"lineBreak":true},{"text":"Anatote mipay ty fiai’o, manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ko mitoky ami’ty tahina’ Iehovà","poem":1},{"lineBreak":true},{"text":"tsy mone hivetrak’ am-pità’ay.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"le hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Toe ho liloveko:","poem":1},{"lineBreak":true},{"text":"hampikoromahem-pibara’ o ajalahio,","poem":1},{"lineBreak":true},{"text":"hampivetrahe’ ty kerè o ana-dahy","poem":1},{"lineBreak":true},{"text":"naho anak’ampela’ iareoo;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Toe tsy hapoke sehanga’e,","poem":1},{"lineBreak":true},{"text":"fa hametsahako hankàñe","poem":1},{"lineBreak":true},{"text":"amo nte-Anatoteo:","poem":1},{"lineBreak":true},{"text":"ty taom-pitilihañe iareo.","poem":1}]}],"footnotes":[{"noteId":37,"caller":"+","text":"Oni: Iir 7:23","reference":{"chapter":11,"verse":4}},{"noteId":38,"caller":"+","text":"Amena: Ie izay","reference":{"chapter":11,"verse":5}}]},"thisChapterLink":"/api/tdx_sle/JER/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/10.json","previousChapterAudioLinks":{},"numberOfVerses":23}