{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Vantan-dRehe, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ndra te ino ty ho nifandierako,","poem":1},{"lineBreak":true},{"text":"f’ie mbe te hisafiry ama’o:","poem":1},{"lineBreak":true},{"text":"Ino ty mampiraorao","poem":1},{"lineBreak":true},{"text":"ty lala’ o lo-tserekeo?","poem":1},{"lineBreak":true},{"text":"Akore te hene mierañerañe","poem":1},{"lineBreak":true},{"text":"o mikitro-draha ratio","poem":1},{"noteId":39},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tinongi’o iereo, eka, le nivahatse;","poem":1},{"lineBreak":true},{"text":"mitombo, le hehe te mamoa;","poem":1},{"lineBreak":true},{"text":"ie marine azo am-palie,","poem":1},{"lineBreak":true},{"text":"fe lavits’azo an-troke.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toe arofoana’o iraho ry Iehovà,","poem":1},{"lineBreak":true},{"text":"mahavazohò ahy,","poem":1},{"lineBreak":true},{"text":"naho mitsoke ty troko ke mb’ama’o;","poem":1},{"lineBreak":true},{"text":"aveveo hoe añondry ho lentàñe iereo,","poem":1},{"lineBreak":true},{"text":"avaho ho amy androm-panjamanañey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ampara’ te ombia i taney te handala,","poem":1},{"lineBreak":true},{"text":"naho o hatae an-kivoke eio te hiheatse?","poem":1},{"lineBreak":true},{"text":"Fonga nasintak’ añe o bibio naho o voroñeo ami’ty hatsivokara’","poem":1},{"lineBreak":true},{"text":"o mpimoneñeo,","poem":1},{"lineBreak":true},{"text":"ie manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy ho vazoho’e ty figadoña’ay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ihe nitrao-pilay amo mpikovovokeo,","poem":1},{"lineBreak":true},{"text":"le nahamokotse azo,","poem":1},{"lineBreak":true},{"text":"aia ty hifandriadriaha’o amo soavalao?","poem":1},{"lineBreak":true},{"text":"Aa ihe mikorovok’ an-tane manintsiñe,","poem":1},{"lineBreak":true},{"text":"hanoe’o akore te añ’ala-matahetse","poem":1},{"lineBreak":true},{"text":"e Iordane ao?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndra o rolongo’oo,","poem":1},{"lineBreak":true},{"text":"naho ty anjomban-droae’o,","poem":1},{"lineBreak":true},{"text":"songa namañahy azo ka,","poem":1},{"lineBreak":true},{"text":"sindre nikorak’ ama’o;","poem":1},{"lineBreak":true},{"text":"ko iantofa’o ndra te anoe’e","poem":1},{"lineBreak":true},{"text":"saontsy mora.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa naforintseko ty akibako,","poem":1},{"lineBreak":true},{"text":"fa nifarieko i lovakoy;","poem":1},{"lineBreak":true},{"text":"fa natoloko am-pitan-drafelahi’e","poem":1},{"lineBreak":true},{"text":"i kokoan’ aikoy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa nanjare liona añ’ala ao amako","poem":1},{"lineBreak":true},{"text":"i lovakoy,","poem":1},{"lineBreak":true},{"text":"kanao nañaoloa’e, hejeko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hoe vorom-banda mpitsatsa amako","poem":1},{"lineBreak":true},{"text":"i lovakoy.","poem":1},{"lineBreak":true},{"text":"Miatreatre añariary aze","poem":1},{"lineBreak":true},{"text":"o vorom-pamaokeo.","poem":1},{"lineBreak":true},{"text":"Akia, fonga atontono o bibin-kivokeo,","poem":1},{"lineBreak":true},{"text":"endeso mb’etoa hamotseke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mpiarake maro ty nampianto","poem":1},{"lineBreak":true},{"text":"i tanem-balobokoy,","poem":1},{"lineBreak":true},{"text":"fa linialia’ iareo i tetekoy,","poem":1},{"lineBreak":true},{"text":"nanoeñe ratraratra i tondako soay","poem":1},{"noteId":40},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nampangoakoaheñe, Bangiñe!","poem":1},{"lineBreak":true},{"text":"mitoreo aoloko eo;","poem":1},{"lineBreak":true},{"text":"nampibabañoaheñe iaby i taney,","poem":1},{"lineBreak":true},{"text":"amy te tsy haoñe’ ondaty an-troke.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa nivotraham-pampianto","poem":1},{"lineBreak":true},{"text":"ze hene haboañe am-patram-bey añe;","poem":1},{"lineBreak":true},{"text":"amy te mamotseke boak’añ’efe’ i taney añe pak’amy añey ka ty fibara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"fonga tsy aman-kanintsiñe","poem":1},{"lineBreak":true},{"text":"ze atao nofotse.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nandrarak’ ampemba","poem":1},{"noteId":41},{"text":"iereo,","poem":1},{"lineBreak":true},{"text":"fe nitatake fatike;","poem":1},{"lineBreak":true},{"text":"nifanehake,","poem":1},{"lineBreak":true},{"text":"f’ie tsy miraorao;","poem":1},{"lineBreak":true},{"text":"aa le imeñaro ty havokara’ areo,","poem":1},{"lineBreak":true},{"text":"ty amy haviñera’ Iehovà miforoforoy.","poem":1}]},{"type":"verse","number":14,"content":["Hoe t’Iehovà:",{"text":"Ty amo raty mañohok’ ahio,","poem":1},{"lineBreak":true},{"text":"o mitsapa i lova nampandovaeko","poem":1},{"lineBreak":true},{"text":"ondatiko Israeleio,","poem":1},{"lineBreak":true},{"text":"toe ho voroteko an-tane’ iareo, hombotako am’iereo","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Iehodà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa ie añe ty nañombotako iareo,","poem":1},{"lineBreak":true},{"text":"le ho tretrezeko indraike;","poem":1},{"lineBreak":true},{"text":"vaho hampoliko, songa mb’an-dova’e,","poem":1},{"lineBreak":true},{"text":"sindre mb’an-tane’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie amy zao, naho toe ianara’ iareo","poem":1},{"lineBreak":true},{"text":"ty sata’ ondatikoo, ty hifanta ami’ty añarako: Kanao veloñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hambañe amy nañanara’ iareo ondatiko","poem":1},{"lineBreak":true},{"text":"ty hifanta amy Baale,","poem":1},{"lineBreak":true},{"text":"le haoreñe aivo’ ondatikoo ka iereo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"F’ie naho tsy mañaoñe iereo,","poem":1},{"lineBreak":true},{"text":"le ho voroteko i fifeheañe zay,","poem":1},{"lineBreak":true},{"text":"hombotañe naho harotsake,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":39,"caller":"+","text":"Sab 73:3","reference":{"chapter":12,"verse":1}},{"noteId":40,"caller":"+","text":"Sor 26:22, Isa 27:10, Iir 10:21","reference":{"chapter":12,"verse":10}},{"noteId":41,"caller":"+","text":"Ampemba: toe karazam-bare","reference":{"chapter":12,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}