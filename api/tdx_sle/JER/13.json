{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Hoe t’Iehovà amako: Akia, mikaloa sokotry lande, le sadiaño, vaho ko alo’o an-drano."]},{"type":"verse","number":2,"content":["Aa le nivily sokotry iraho ty amy tsara’ Iehovày, vaho nadiako."]},{"type":"verse","number":3,"content":["Nomb’ amako fañindroe’e ty tsara’ Iehovà nanao ty hoe:"]},{"type":"verse","number":4,"content":["Endeso i sokotry vinili’oy, o an-toha’oo, le miongaha, akia mb’e Perate",{"noteId":42},"añe vaho akafiro an-tseran-damilamy ao."]},{"type":"verse","number":5,"content":["Aa le nimb’ eo iraho nañetak’ aze e Pe­rate ao amy nandilia’ Iehovày."]},{"type":"verse","number":6,"content":["Ie añe ty andro maro, le hoe t’Iehovà amako, Miongaha, akia mb’e Perate mb’eo vaho rambeso i sokotry nililiako haetak’aoy."]},{"type":"verse","number":7,"content":["Aa le nimb’e Perate mb’eo iraho vaho hinaliko naho rinambeko amy nañetahakoy i sokotriy; naheoko t’ie nianto, tsy vara ka."]},{"type":"verse","number":8,"content":["Le niheo amako ty tsara’ Iehovà nanao ty hoe:"]},{"type":"verse","number":9,"content":[{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Hambañe amy zay ty hamongorako","poem":1},{"lineBreak":true},{"text":"ty fiebora’ Iehodà, naho","poem":1},{"lineBreak":true},{"text":"ty firengevoha’ Ierosalaime,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ondaty lo-tsereke retoañe,","poem":1},{"lineBreak":true},{"text":"o mifoneñe tsy hijanjiñe o volakoo,","poem":1},{"lineBreak":true},{"text":"o manjotik’ ami’ty fanjeharan’arofo’eo,","poem":1},{"lineBreak":true},{"text":"naho mañorike ndrahare ila’e hitoroña’e naho hitalahoa’e;","poem":1},{"lineBreak":true},{"text":"aa le hifandrae ami’ty sokotry toy iereo,","poem":1},{"lineBreak":true},{"text":"ie tsy vente’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa hambañe ami’ty fidiañañe","poem":1},{"lineBreak":true},{"text":"ty sokotry an-toha’ondaty,","poem":1},{"lineBreak":true},{"text":"ty nampidiañako amako","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Israele iaby,","poem":1},{"lineBreak":true},{"text":"naho ze hene anjomba’ Iehodà,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"soa te ho amako iereo, h’ondaty","poem":1},{"lineBreak":true},{"text":"naho tahinañe, naho engeñe,","poem":1},{"lineBreak":true},{"text":"vaho volonahetse;","poem":1},{"lineBreak":true},{"text":"f’ie mihiritsiritse avao.","poem":1}]},{"type":"verse","number":12,"content":["Atovoño am’ iereo o tsara zao: Hoe t’Iehovà Andrianañahare’ Israele: Songa ho peañen-divay o zonjoñeo. Le ie manao ty hoe iereo: Aa tsy apota’ay hao te sindre hatsafen-divay o zonjoñeo?"]},{"type":"verse","number":13,"content":["Le hanoa’o ty hoe: Hoe t’Iehovà:",{"text":"Ingo ho liporeko hamamoañe ze hene","poem":1},{"lineBreak":true},{"text":"mpimone’ ty tane toy: o mpanjaka","poem":1},{"lineBreak":true},{"text":"miambesatse am-piambesa’ i Davideo","poem":1},{"noteId":43},{"text":",","poem":1},{"lineBreak":true},{"text":"naho o mpisoroñeo, naho o mpitokio,","poem":1},{"lineBreak":true},{"text":"vaho o mpimone’ Israele iabio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho ifampidosieko iereo,","poem":1},{"lineBreak":true},{"text":"o roaeo amo ana’eo, hoe’ t’Iehovà;","poem":1},{"lineBreak":true},{"text":"tsy hiheveako, tsy ho tretrezeko,","poem":1},{"lineBreak":true},{"text":"tsy ho ferenaiñeko;","poem":1},{"lineBreak":true},{"text":"te mone ho rotsaheko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mijanjiña naho manolora ravembia,","poem":1},{"lineBreak":true},{"text":"ko mibohaboha; fa nitsara t’Iehovà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Toloro engeñe t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ areo,","poem":1},{"lineBreak":true},{"text":"aolo’ ty firoña’e ho maieñe,","poem":1},{"lineBreak":true},{"text":"aolo te mitsikapy an-tongoa-vohitse eo","poem":1},{"lineBreak":true},{"text":"o fandia’ areoo,","poem":1},{"lineBreak":true},{"text":"le ie mipay hazavàñe nahareo","poem":1},{"lineBreak":true},{"text":"ro hafote’e ho talinjon-kavilasy,","poem":1},{"lineBreak":true},{"text":"ie hampimoromoroñe’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fe naho tsy mañaoñe nahareo,","poem":1},{"lineBreak":true},{"text":"le hiharovetse añ’etake ty troko","poem":1},{"lineBreak":true},{"text":"ty amy firengevohañe zay;","poem":1},{"lineBreak":true},{"text":"higanaganaham-pangololoihañe","poem":1},{"lineBreak":true},{"text":"o masokoo,","poem":1},{"lineBreak":true},{"text":"vaho hikararake o rano-masokoo,","poem":1},{"lineBreak":true},{"text":"amy te nasese an-drohy añe i lia-rai’ Iehovày.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Taroño amy mpanjakay naho amy","poem":1},{"lineBreak":true},{"text":"mpanjaka-ampelay ty hoe:","poem":1},{"lineBreak":true},{"text":"Mitoboha ambane,","poem":1},{"lineBreak":true},{"text":"fa nazetse o sabakan’enge’ areo fanjakao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Migabeñe o rova atimoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hanokake iareo;","poem":1},{"lineBreak":true},{"text":"songa nasese am-pandrohizañe t’Iehodà;","poem":1},{"lineBreak":true},{"text":"sindre nendeseñ’ añe an-drohy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ampiandrao o fihaino’oo,","poem":1},{"lineBreak":true},{"text":"isaho o mb’etoy boak’ avaratse eio;","poem":1},{"lineBreak":true},{"text":"aia i lia-raike natolots’ azoy,","poem":1},{"lineBreak":true},{"text":"i lia-rai’o fanjakay?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ino ty hatao’o naho tendre’e","poem":1},{"lineBreak":true},{"text":"ho ambone’ lohà’o o nirañe’o taoloo;","poem":1},{"lineBreak":true},{"text":"o naò’oo?","poem":1},{"lineBreak":true},{"text":"Tsy hamihiñe azo hao ty fikoretañe","poem":1},{"lineBreak":true},{"text":"hoe fitsongoan’ ampela?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa naho atao’o an-tro’o ao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ino ty nifetsaha’ iretoañe amako?","poem":1},{"lineBreak":true},{"text":"Ty habei’ hakeo’o ty nañaloañe i siki’oy,","poem":1},{"lineBreak":true},{"text":"naho ty maha tsi-an-kana o tomi’oo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mahay mañova ty holi’e hao","poem":1},{"lineBreak":true},{"text":"ty nte-Kose","poem":1},{"noteId":44},{"text":",","poem":1},{"lineBreak":true},{"text":"ndra i hapepoa’ey ty fosa?","poem":1},{"lineBreak":true},{"text":"Aa naho mete izay, le ho lefe’areo","poem":1},{"lineBreak":true},{"text":"mpanao ratio ka ty hanao soa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le hampiboeleko iereo","poem":1},{"lineBreak":true},{"text":"manahake ty karafo ampihelaña’","poem":1},{"lineBreak":true},{"text":"i tion-dratraratray.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Toe toli’o toy, ty nañaranako ama’o, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"amy te nihaliñe’o iraho,","poem":1},{"lineBreak":true},{"text":"vaho niatoa’o ty remborake.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aa le hatsingako ambone’ lahara’o eo","poem":1},{"lineBreak":true},{"text":"o siki’oo hampiboake ty fimeñara’o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fa nitreako o hativa’oo:","poem":1},{"lineBreak":true},{"text":"ty fañarapiloa’o,","poem":1},{"lineBreak":true},{"text":"ty fitrem-pitsinginiora’o,","poem":1},{"lineBreak":true},{"text":"ty haleoran-katsimirira’o,","poem":1},{"lineBreak":true},{"text":"amo tamboho an-kivoke eio,","poem":1},{"lineBreak":true},{"text":"nitreako o hativà’oo.","poem":1},{"lineBreak":true},{"text":"Hankàñe ama’o, ry Ierosalaime,","poem":1},{"lineBreak":true},{"text":"ampara’ te ombia t’ie mbe haleotse?","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"Perate: Saka mampiraorao","reference":{"chapter":13,"verse":4}},{"noteId":43,"caller":"+","text":"Davide: Ikokoañe","reference":{"chapter":13,"verse":13}},{"noteId":44,"caller":"+","text":"Kose: hamainten-gero’e","reference":{"chapter":13,"verse":23}}]},"thisChapterLink":"/api/tdx_sle/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}