{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Ty tsara’ Iehovà am’ Iirmeà","poem":1},{"lineBreak":true},{"text":"ty amy hasalikoañey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mandala t’Iehodà,","poem":1},{"lineBreak":true},{"text":"midegañe o lalam-bei’eo,","poem":1},{"lineBreak":true},{"text":"ie mibotrek’ an-kontoke ty amy taney;","poem":1},{"lineBreak":true},{"text":"vaho mionjoñe ty firoveta’ Ierosalaime.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nirahe’ o roandriañeo o keleia’eo","poem":1},{"lineBreak":true},{"text":"hitoha rano:","poem":1},{"lineBreak":true},{"text":"ie pok’an-kadaha eo, tsy manjo rano; mimpoly am-binta kapaike,","poem":1},{"lineBreak":true},{"text":"salatse naho daba, misaron-doha,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O taneo mivarakivaraky,","poem":1},{"lineBreak":true},{"text":"tsy niavy an-tane ty orañe,","poem":1},{"lineBreak":true},{"text":"miolitsolitse ty mpiava, misaron-doha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miterak’ an-kivoke ey ka ty fanaloke,","poem":1},{"lineBreak":true},{"text":"fe aforintse’e, ie tsy aman’ ahetse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miereñereñe an-kaboan-diolio eñe","poem":1},{"lineBreak":true},{"text":"ty borìke ly, misefosefo hoe fosa;","poem":1},{"lineBreak":true},{"text":"milesa o maso’eo,","poem":1},{"lineBreak":true},{"text":"amy te tsy eo rongoñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa ndra te asisì’ o tahi’aio zahay,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, mitoloña ty amy tahina’oy;","poem":1},{"lineBreak":true},{"text":"toe maro o fidisa-voli’aio,","poem":1},{"lineBreak":true},{"text":"naho anaña’o hakeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry fitamà’ Israele, t’i Mpandrombak’ aze an-tsan-kaoreañe,","poem":1},{"lineBreak":true},{"text":"manao akore te ihe ro manao","poem":1},{"lineBreak":true},{"text":"ambahiny an-taneo,","poem":1},{"lineBreak":true},{"text":"manahake ty mpitaveañe mañialo ao","poem":1},{"lineBreak":true},{"text":"te haleñe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mañino irehe ro hoe ondaty daba,","poem":1},{"lineBreak":true},{"text":"hoe fanalolahy tsy maharombake?","poem":1},{"lineBreak":true},{"text":"F’ie añivo’ay irehe, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho kanjieñe ami’ty tahina’o,","poem":1},{"lineBreak":true},{"text":"ko aforintse’o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà am’ondaty retoañe:","poem":1},{"lineBreak":true},{"text":"Toe nitea’ iereo ty mirererere,","poem":1},{"lineBreak":true},{"text":"tsy kinala’ iareo o fandia’eo;","poem":1},{"lineBreak":true},{"text":"aa le tsy no’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ho tiahi’e henane zao o hakeo’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho lilove’e o tahi’ iareoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Ko ihalalia’o ty hasoa’ ondaty retoa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie mililitse, tsy ho tsanoñeko","poem":1},{"lineBreak":true},{"text":"o fitoreo’eo;","poem":1},{"lineBreak":true},{"text":"ie mañenga soroñe naho enga","poem":1},{"lineBreak":true},{"text":"mahakama, tsy ho noko;","poem":1},{"lineBreak":true},{"text":"te mone ho mongoreko am-pibara,","poem":1},{"lineBreak":true},{"text":"naho an-kerè vaho an-kiria.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le hoe iraho: Ee Talè, Iehovà!","poem":1},{"lineBreak":true},{"text":"Inao ty filañona’ o mpitokio:","poem":1},{"lineBreak":true},{"text":"Tsy hizò fibara nahareo,","poem":1},{"lineBreak":true},{"text":"tsy ho tendreke hasalikoañe;","poem":1},{"lineBreak":true},{"text":"fa ho tolorako fierañerañañe","poem":1},{"lineBreak":true},{"text":"tsy modo ami’ty toetse toy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Mandañitse ami’ty añarako o mpitokio","poem":1},{"noteId":45},{"text":";","poem":1},{"lineBreak":true},{"text":"tsy nahitriko tsy nililiako, tsy nivolañako;","poem":1},{"lineBreak":true},{"text":"itokia’ iareo aroñarom-bande,","poem":1},{"lineBreak":true},{"text":"naho sahàtse, naho raha kafoake,","poem":1},{"lineBreak":true},{"text":"vaho ty famañahian-tro’ iareo avao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"O mpitoky mitoky ami’ty añarakoo:","poem":1},{"lineBreak":true},{"text":"Tsy niraheko, fe hoe ty asa’iareo:","poem":1},{"lineBreak":true},{"text":"Tsy ho an-tane atoy ty vi-lava","poem":1},{"lineBreak":true},{"text":"naho ty kerè.","poem":1},{"lineBreak":true},{"text":"Aa le ty fibara naho ty hasalikoañe","poem":1},{"lineBreak":true},{"text":"ty higadoña’ i mpitoky rey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Le hahifik’ an-dala’ Ierosalaime ey","poem":1},{"lineBreak":true},{"text":"ondaty itokia’ iareoo,","poem":1},{"lineBreak":true},{"text":"ami’ty mosare naho amy fibaray;","poem":1},{"lineBreak":true},{"text":"le tsy hanam-pandeveñe,","poem":1},{"lineBreak":true},{"text":"ie naho o vali’eo, naho o ana-dahi’eo,","poem":1},{"lineBreak":true},{"text":"vaho o anak’ ampela’eo;","poem":1},{"lineBreak":true},{"text":"fa hadoako am’iereo ty haloloa’ iareo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le isaontsio o tsara zao:","poem":1},{"lineBreak":true},{"text":"Ehe te hitsiririàhan-drano maso","poem":1},{"lineBreak":true},{"text":"handro an-kaleñe o masokoo;","poem":1},{"lineBreak":true},{"text":"vaho ko ajihetse ;","poem":1},{"lineBreak":true},{"text":"amy te dinemo’ ty fanjevoañe ra’elahy","poem":1},{"lineBreak":true},{"text":"i somondrara anak’ ampela’ ondatikoy,","poem":1},{"lineBreak":true},{"text":"ami’ty fere mahatindry.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Izaho mb’an-kivok’ añe:","poem":1},{"lineBreak":true},{"text":"hehe ty zinamam-pibara,","poem":1},{"lineBreak":true},{"text":"ie mimoak’ an-drova ao,","poem":1},{"lineBreak":true},{"text":"ingo ty nanilofen-kerè!","poem":1},{"lineBreak":true},{"text":"mikariokariok’ amy taney","poem":1},{"lineBreak":true},{"text":"o mpitokio naho o mpisoroñeo","poem":1},{"lineBreak":true},{"text":"fa tsy mahafohiñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Vata’e nifarie’o hao t’Iehodà?","poem":1},{"lineBreak":true},{"text":"Heje’ ty arofo’o vintañe hao ty Tsione?","poem":1},{"lineBreak":true},{"text":"Ino ty nandafa’o anay","poem":1},{"lineBreak":true},{"text":"ho po-pijanganañe?","poem":1},{"lineBreak":true},{"text":"Ie nandiñe fanintsiñañe fe po hasoa,","poem":1},{"lineBreak":true},{"text":"naho fitsaitsaihañe, te mone hankàñe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Iantofa’ay ry Iehovà, o halò-tsere’aio,","poem":1},{"lineBreak":true},{"text":"naho o tahin-droae’aio; toe anaña’o hakeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ko malaiñ’anay irehe, ty amy tahina’oy!","poem":1},{"lineBreak":true},{"text":"ko mavoe’o ty fiambesan’enge’o;","poem":1},{"lineBreak":true},{"text":"mahatiahia, ko ivaliha’o","poem":1},{"lineBreak":true},{"text":"i fañina’o ama’aiy!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ahavian’orañe hao o raha","poem":1},{"lineBreak":true},{"text":"tsy jefa’ o kilakila’ndatioo?","poem":1},{"lineBreak":true},{"text":"O likerañeo hao ty mampikojojoake orañe?","poem":1},{"lineBreak":true},{"text":"Tsy Ihe hao, ry Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ay?","poem":1},{"lineBreak":true},{"text":"Tsy Ihe hao ty fitamà’ay?","poem":1},{"lineBreak":true},{"text":"Toe Ihe ro Mpanao ze he’e zao!","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":45,"caller":"+","text":"Ies 9:14, Iir 23:11-36, 27: 14,16, Iek 21:34, 22:28","reference":{"chapter":14,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}