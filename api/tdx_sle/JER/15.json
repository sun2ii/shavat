{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Le hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Ndra te nijohañe añatrefako eo","poem":1},{"lineBreak":true},{"text":"t’i Mosè naho i Samoele,","poem":1},{"lineBreak":true},{"text":"tsy ho nitolike mb’am’ondaty retoa ty troko","poem":1},{"lineBreak":true},{"text":"soiho añe iereo tsy ho treako, aseseo añe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie amy zao, naho isaontsia’ iareo,","poem":1},{"lineBreak":true},{"text":"ty hoe: Homb’aia zahay?","poem":1},{"lineBreak":true},{"text":"le hanoa’o ty hoe: Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"O havetrakeo mb’am-pivetrahañe,","poem":1},{"lineBreak":true},{"text":"O ho amy fibaraio, mb’amy fibaray,","poem":1},{"lineBreak":true},{"text":"O hampisalikoeñeo le mb’amy mosarey,","poem":1},{"lineBreak":true},{"text":"O ho an-drohio, le mb’am-pandrohizañ’ añe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Efatse ty hafantoko am’ iareo:","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"hanjevoñe ty fibara naho","poem":1},{"lineBreak":true},{"text":"hirepake ty amboa naho","poem":1},{"lineBreak":true},{"text":"hampibotseke naho hamongotse o voron-dikerañeo naho","poem":1},{"lineBreak":true},{"text":"o bibi’ ty tane toio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le hanoeko fangebahebahañe","poem":1},{"lineBreak":true},{"text":"amy ze fifehea’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"ty amy Menasè","poem":1},{"noteId":46},{"text":", ana’ Iekizkia","poem":1},{"noteId":47},{"lineBreak":true},{"text":"mpanjaka’ Iehodà,","poem":1},{"lineBreak":true},{"text":"o nanoe’e e Ierosalaimeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia ty hiferenaiñ’ azo ry Ierosalaime?","poem":1},{"lineBreak":true},{"text":"Ia ty handal’ azo?","poem":1},{"lineBreak":true},{"text":"Ia ty hivike hañontane ty fanintsiña’o?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nifarie’o iraho, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"toe nidisa-voly;","poem":1},{"lineBreak":true},{"text":"izay ty añitiako ama’o ty tañako,","poem":1},{"lineBreak":true},{"text":"handrotsahako;","poem":1},{"lineBreak":true},{"text":"mahamokotse ahy ty miheve.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Itsongako an-tsikelo","poem":1},{"lineBreak":true},{"text":"an-dalambei’ i taney;","poem":1},{"lineBreak":true},{"text":"ampandalàko anake,","poem":1},{"lineBreak":true},{"text":"vaho ho mongoreko ondatikoo","poem":1},{"lineBreak":true},{"text":"amy te tsy ambohoa’e o sata’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho maro te amo fasen-driakeo","poem":1},{"lineBreak":true},{"text":"o ramavoi’iareoo aoloko eo;","poem":1},{"lineBreak":true},{"text":"afetsako am’iereo, ami’ty renen’ ajalahy","poem":1},{"lineBreak":true},{"text":"ty mpampianto an-tsipinde mena;","poem":1},{"lineBreak":true},{"text":"hivovò ama’e ty fihepakepahañe","poem":1},{"lineBreak":true},{"text":"naho ty firevendreveñañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Miforejeje ty nisamake fito;","poem":1},{"lineBreak":true},{"text":"midegañe ty fiai’e;","poem":1},{"lineBreak":true},{"text":"fa nimotake i andro’ey","poem":1},{"lineBreak":true},{"text":"t’ie mb’e nandia-loha,","poem":1},{"lineBreak":true},{"text":"meñatse re naho salatse;","poem":1},{"lineBreak":true},{"text":"vaho haseseko ami’ty fibara ty sehanga’e","poem":1},{"lineBreak":true},{"text":"añatrefa’ o rafelahi’ iareoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Feh’ohatse amako ry reneko,","poem":1},{"lineBreak":true},{"text":"te nahatoly ahy h’ondaty trabiheñe,","poem":1},{"lineBreak":true},{"text":"mpampitrobo i tane iabiy!","poem":1},{"lineBreak":true},{"text":"tsy nampisongo iraho, tsy misongo;","poem":1},{"lineBreak":true},{"text":"fe fonga mamàtse ahy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"havotsoko ho an-kasoa irehe;","poem":1},{"lineBreak":true},{"text":"hampihalalieko ama’o","poem":1},{"lineBreak":true},{"text":"ty rafelahy an-tsan-kankàñe naho añ’andron-kasotriañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mahafolake ty viñe boak’ avaratse hao","poem":1},{"lineBreak":true},{"text":"ty viñe naho ty torisìke?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hatoloko ho fikopahañe","poem":1},{"lineBreak":true},{"text":"tsy amam-bili’e ty vara naho fanaña’o,","poem":1},{"lineBreak":true},{"text":"pak’ añ’efe’o iaby ty amo hene’ tahi’oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le hampaneseko o rafelahi’oo","poem":1},{"lineBreak":true},{"text":"mb’ an-tane tsy fohi’o;","poem":1},{"lineBreak":true},{"text":"fa niviañeñe an-doak-oroko ao ty afo hisolebats’ ama’o.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ihe ry Iehovà ro maharofoanañe,","poem":1},{"lineBreak":true},{"text":"tiahio iraho vaho aereñereo,","poem":1},{"lineBreak":true},{"text":"vaho valeo o mpanao sarerak’ ahio;","poem":1},{"lineBreak":true},{"text":"ko asese’o mb’eo ty amy fiferenaiña’oy; mahaoniña te Ihe ro nahafeahako inje.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nitendreke o tsara’oo vaho nihaneko;","poem":1},{"lineBreak":true},{"text":"le nahafale ahiko","poem":1},{"lineBreak":true},{"text":"toe naharebeke ty troko o tsara’oo;","poem":1},{"lineBreak":true},{"text":"amy te nitokaveñe ami’ty tahina’o,","poem":1},{"lineBreak":true},{"text":"ry Iehovà Andrianañahare’ i màroy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy nitobohako i fivorim-pitohàkey,","poem":1},{"lineBreak":true},{"text":"tsy nirañaraña an-kobaiñe,","poem":1},{"lineBreak":true},{"text":"fa mitobok’ am-bangiñe ao ty amy fità’oy; ie nilifore’o hatorifihañe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Akore te silofeñe nainai’e o rarekoo,","poem":1},{"lineBreak":true},{"text":"ie tsy mitsaitsaike o ferekoo,","poem":1},{"lineBreak":true},{"text":"tsy mete ho melañe?","poem":1},{"lineBreak":true},{"text":"Hanao torahañe mamitak’ amako","poem":1},{"lineBreak":true},{"text":"hao irehe, hoe rano misike?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Naho himpoly irehe,","poem":1},{"lineBreak":true},{"text":"le ampibaliheko indraike,","poem":1},{"lineBreak":true},{"text":"hijohaña’o añatrefako eo;","poem":1},{"lineBreak":true},{"text":"aa naho akare’o ami’ty kafoake ty vente’e,","poem":1},{"lineBreak":true},{"text":"le ho sorotàko;","poem":1},{"lineBreak":true},{"text":"adono hitoliha’ iareo, fa ko itoliha’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Le hanoeko kijoly torisìke","poem":1},{"lineBreak":true},{"text":"am’ondaty retoa;","poem":1},{"lineBreak":true},{"text":"hialy ama’o iereo, fa tsy hahagioke,","poem":1},{"lineBreak":true},{"text":"Ho ama’o iraho handrombak’ azo","poem":1},{"lineBreak":true},{"text":"naho hañaha azo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Havotsoko am-pità’ o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"naho ho jebañeko an-dela-pità’","poem":1},{"lineBreak":true},{"text":"ty mampangebahebake.","poem":1}]}],"footnotes":[{"noteId":46,"caller":"+","text":"Menasè: i nandikofañey; bey haliño","reference":{"chapter":15,"verse":4}},{"noteId":47,"caller":"+","text":"Iekizkia: ty haozara’ Iehovà","reference":{"chapter":15,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}