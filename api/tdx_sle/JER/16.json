{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Nimb’amako ty tsara’ Iehovà","poem":1},{"lineBreak":true},{"text":"nanao ty hoe:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ko mañenga valy,","poem":1},{"lineBreak":true},{"text":"ko misamak’ ana-dahy ndra","poem":1},{"lineBreak":true},{"text":"anak’ampela an-toetse atoy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà ty amo","poem":1},{"lineBreak":true},{"text":"ana-dahy naho anak’ampela terake","poem":1},{"lineBreak":true},{"text":"ami’ty toetse toio,","poem":1},{"lineBreak":true},{"text":"naho i rene’e nisamake iareo,","poem":1},{"lineBreak":true},{"text":"naho i rae’e nampiareñe iareo","poem":1},{"lineBreak":true},{"text":"an-tane atoiy:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"T’ie hivetrak’ am-pikoromahañe","poem":1},{"lineBreak":true},{"text":"mahaferenay,","poem":1},{"lineBreak":true},{"text":"tsy eo ty handala, tsy haleveñe,","poem":1},{"lineBreak":true},{"text":"fa hapoke hoe forompotse","poem":1},{"lineBreak":true},{"text":"ambone-tane eo,","poem":1},{"lineBreak":true},{"text":"ho zamane’ ty fibara naho ty saliko;","poem":1},{"lineBreak":true},{"text":"ho hane’ o voron-dikerañeo","poem":1},{"lineBreak":true},{"text":"naho o biby an-tane atoio ty lolo’ iareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ko iziliha’o ty anjombam-pandalàñe,","poem":1},{"lineBreak":true},{"text":"ko mb’eo hirovetse ndra hañohò;","poem":1},{"lineBreak":true},{"text":"fa nafahako am’ ondaty retoa ty","poem":1},{"lineBreak":true},{"text":"fanintsiñako, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ty fiferenaiñako naho ty fitretrezako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Songa hivetrak’ an-tane atoy","poem":1},{"lineBreak":true},{"text":"ty kede naho ty bey;","poem":1},{"lineBreak":true},{"text":"tsy haleveñe,","poem":1},{"lineBreak":true},{"text":"tsy hirovetañe,","poem":1},{"lineBreak":true},{"text":"tsy handilian-tsandriñe,","poem":1},{"lineBreak":true},{"text":"tsy hañitsifañe;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy hamolahañe mofo ty mpandala,","poem":1},{"lineBreak":true},{"text":"hampanintsiñe aze ty amy raza’ey;","poem":1},{"lineBreak":true},{"text":"tsy hanjotsoañe fitovim-pañohòañe hinoma’e ty aman-drae’e ndra rene’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko imoaha’o ka ze anjomba","poem":1},{"lineBreak":true},{"text":"manao sabadidake, iambesara’o,","poem":1},{"lineBreak":true},{"text":"hikama ndra hinoñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"i Andrianañahare’ Israeley:","poem":1},{"lineBreak":true},{"text":"Toe hajiko an-toetse atoy,","poem":1},{"lineBreak":true},{"text":"añatrefam-pihaino’o eo","poem":1},{"lineBreak":true},{"text":"naho amo andro’oo,","poem":1},{"lineBreak":true},{"text":"ty feon-kafaleañe, naho","poem":1},{"lineBreak":true},{"text":"ty feom-pirebehañe, naho","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ i mpañengay vaho","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ i engañey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa ie saontsie’o am’ondaty retoa","poem":1},{"lineBreak":true},{"text":"o tsara iaby zao,","poem":1},{"lineBreak":true},{"text":"vaho manao ty hoe ama’o iereo,","poem":1},{"lineBreak":true},{"text":"Akore te zahay ro nitsarà’ Iehovà","poem":1},{"lineBreak":true},{"text":"o hankàñe jabajaba zao?","poem":1},{"lineBreak":true},{"text":"Ino o hakeo’aio?","poem":1},{"lineBreak":true},{"text":"Ino ty tahiñe nanoe’ay amy","poem":1},{"lineBreak":true},{"text":"Iehovà Andrianañahare’ay?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le ty hoe ty havale’o ami’iereo:","poem":1},{"lineBreak":true},{"text":"Amy te nifarien-droae’areo raho","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, naho nanjontike","poem":1},{"lineBreak":true},{"text":"mb’aman ‘ndrahare ila’e,","poem":1},{"lineBreak":true},{"text":"nitoroñe iareo naho nitalahoañe,","poem":1},{"lineBreak":true},{"text":"fe nieng’ahy, vaho tsy","poem":1},{"lineBreak":true},{"text":"mañambeñe i Hà-koy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lombolombo ty nanoen-droae’ areo","poem":1},{"lineBreak":true},{"text":"ty haratiañe nanoe’ areo,","poem":1},{"lineBreak":true},{"text":"songa mañorike ty fanjeharan-tro’e raty,","poem":1},{"lineBreak":true},{"text":"fa tsy mañaoñe ahy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le hahifike boak’an-tane atoy","poem":1},{"lineBreak":true},{"text":"mb’an-tane tsy nifohi’ areo","poem":1},{"lineBreak":true},{"text":"ndra o rae’ areoo;","poem":1},{"lineBreak":true},{"text":"añe nahareo ro hitoron-drahare","poem":1},{"lineBreak":true},{"text":"ila’e handro an-kaleñe;","poem":1},{"lineBreak":true},{"text":"fe tsy ho soaeko.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rendreho arè, te ho tondroke ty andro, hoe t’Iehovà, te tsy ho volañeñe ka ty hoe: Kanao veloñe t’Iehovà nañakatse o ana’ Israeleo an-tane Mitsraime añe,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Te mone: Kanao veloñe t’Iehovà","poem":1},{"lineBreak":true},{"text":"nampipoly o ana’ Israeleo","poem":1},{"lineBreak":true},{"text":"boak’ an-tane avaratse añe,","poem":1},{"lineBreak":true},{"text":"naho amo hene tane nandroahako iareoo;","poem":1},{"lineBreak":true},{"text":"Ie hampoliko an-tane’ natoloko an-droae’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie amy zay, hampisangitrifeko","poem":1},{"lineBreak":true},{"text":"mpamintañe maro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le ho vintañe’iereo;","poem":1},{"lineBreak":true},{"text":"heneke zay le hampañitrifeko","poem":1},{"lineBreak":true},{"text":"mpañoro maro,","poem":1},{"lineBreak":true},{"text":"le ho horoñe’ iereo amy ze hene vohitse","poem":1},{"lineBreak":true},{"text":"naho amy ze fonga tamboho,","poem":1},{"lineBreak":true},{"text":"vaho boak’amo tseran-damilamio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa amo sata’ iareo iabio o masokoo,","poem":1},{"lineBreak":true},{"text":"tsy mietak’ an-tareheko iereo;","poem":1},{"lineBreak":true},{"text":"mbore tsy mikafitse amo masokoo","poem":1},{"lineBreak":true},{"text":"ty fandilara’ iareo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hondroheko indroe hey ty hakeo","poem":1},{"lineBreak":true},{"text":"naho tahi’ iareo;","poem":1},{"lineBreak":true},{"text":"amy t’ie nañota-faly an-taneko;","poem":1},{"lineBreak":true},{"text":"nilipore’ iareo amy lovakoy o faten-","poem":1},{"lineBreak":true},{"text":"draha’e mampangorìñeo","poem":1},{"lineBreak":true},{"text":"vaho o raha tivao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ry Iehovà, haozarako naho","poem":1},{"lineBreak":true},{"text":"kijoliko fatratse,","poem":1},{"lineBreak":true},{"text":"toe fipalirako an-tsan-kasotriañe,","poem":1},{"lineBreak":true},{"text":"ama’o ty hañaveloa’ o fifeheañe","poem":1},{"lineBreak":true},{"text":"boak’ añ’olo-ty tane toio","poem":1},{"lineBreak":true},{"text":"hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Nandova vande avao o rae’aio,","poem":1},{"lineBreak":true},{"text":"raha kafoake, tsy amam-bente’e","poem":1},{"noteId":48},{"text":".","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hamboara’ ondaty ‘ndrahare hao","poem":1},{"lineBreak":true},{"text":"ty vata’e, ie tsy andrianañahare?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mahaoniña arè te hampahafohineko","poem":1},{"lineBreak":true},{"text":"ami’ty indraike toy te haboako am’ iereo","poem":1},{"lineBreak":true},{"text":"ty tañako, naho ty haozarako;","poem":1},{"lineBreak":true},{"text":"vaho ho fohi’ iareo te Iehovà ty añarako.","poem":1}]}],"footnotes":[{"noteId":48,"caller":"+","text":"Sab 147:19 Isa 2:3 Jao 4:22, Rom 2:20, 3:2,","reference":{"chapter":16,"verse":19}}]},"thisChapterLink":"/api/tdx_sle/JER/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/15.json","previousChapterAudioLinks":{},"numberOfVerses":21}