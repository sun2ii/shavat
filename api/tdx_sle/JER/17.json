":true},{"text":"Aia ty tsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ampombao mb’etoa henaneo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa naho izaho, tsy nalisa hisitake","poem":1},{"lineBreak":true},{"text":"ami’ty maha-piarak’ahy ama’o;","poem":1},{"lineBreak":true},{"text":"tsy nirieko ka ty andron-kankàñe;","poem":1},{"lineBreak":true},{"text":"arofoana’o te nalange añatrefa’o eo","poem":1},{"lineBreak":true},{"text":"ze niakatse an-tsoñiko.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ko mamangebahebak’ ahy,","poem":1},{"lineBreak":true},{"text":"amy te Ihe ro fipalirako","poem":1},{"lineBreak":true},{"text":"añ’andron-kankàñe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ee te ho salareñe o mampisoañe ahy,","poem":1},{"lineBreak":true},{"text":"fe ko ampisalaren-draho;","poem":1},{"lineBreak":true},{"text":"ee te hembereñe iereo,","poem":1},{"lineBreak":true},{"text":"fe ko ampisosoren-draho,","poem":1},{"lineBreak":true},{"text":"aseseo am’iereo ty andron-kekoheko,","poem":1},{"lineBreak":true},{"text":"vaho rotsaho an-drotsake roe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà amako:","poem":1},{"lineBreak":true},{"text":"Akia, mijohaña an-dalambei’","poem":1},{"lineBreak":true},{"text":"o ana’ ondatio,","poem":1},{"lineBreak":true},{"text":"am-piziliha’ o mpanjaka’ Iehodào","poem":1},{"lineBreak":true},{"text":"naho am-piengà’ iareo eo,","poem":1},{"lineBreak":true},{"text":"naho amo lalambei’ Ierosalaimeo;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"vaho isaontsio ty hoe:","poem":1},{"lineBreak":true},{"text":"Janjiño ty tsara’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry mpanjaka’ Iehodà, naho","poem":1},{"lineBreak":true},{"text":"ry Iehodà iaby, naho","poem":1},{"lineBreak":true},{"text":"ry hene mpimone’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"ze fonga mimoak’ an-dalam-bey retoañe:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà: Mitaoa!","poem":1},{"lineBreak":true},{"text":"ko minday entañe ami’ty andro Sabotse,","poem":1},{"lineBreak":true},{"text":"naho ko mampizilike ndra inoñ’inoñe","poem":1},{"lineBreak":true},{"text":"amo lalambei’ Ierosalaimeo;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ko añakaran-kilankañe ty anjomba’o ami’ty andro Sabata,","poem":1},{"lineBreak":true},{"text":"naho ko mitolon-draha,","poem":1},{"lineBreak":true},{"text":"vaho avaho ty andro Sabotse,","poem":1},{"lineBreak":true},{"text":"amy nandiliako aman-droae’areoy;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ie tsy nañaoñe,","poem":1},{"lineBreak":true},{"text":"tsy nanokilan-dravembia,","poem":1},{"lineBreak":true},{"text":"te mone nampigam-pititia,","poem":1},{"lineBreak":true},{"text":"tsy hijanjiñe","poem":1},{"lineBreak":true},{"text":"tsy handrambe fanoroañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho tondroke ka te,","poem":1},{"lineBreak":true},{"text":"ie mahafitsendreñe ahy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te tsy anjilihañ’ entañe amo lalam-bei’","poem":1},{"lineBreak":true},{"text":"ty rova toio ami’ty andro Sabotse,","poem":1},{"lineBreak":true},{"text":"fe hambenañe ho masiñe","poem":1},{"lineBreak":true},{"text":"ty andro Sabotse, tsy hitoloñañe;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie amy zay himoaham-panjaka","poem":1},{"lineBreak":true},{"text":"naho roandriañe o lalam-bei’ ty rova toio hiambesatse amy fiambesa’ i Davidey,","poem":1},{"lineBreak":true},{"text":"miningitse sarete naho soavala,","poem":1},{"lineBreak":true},{"text":"ie naho o roandria’eo,","poem":1},{"lineBreak":true},{"text":"naho ondati’ Iehodao,","poem":1},{"lineBreak":true}