{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Ty tsara niheo am’ Iirmeà boak’ am’ Iehovà, manao ty hoe:"]},{"type":"verse","number":2,"content":["Miongaha, mizotsoa mb’an-kiboho’ i mpanao valàñe-taney mb’eo, le hampijanjiñeko azo eo o entakoo."]},{"type":"verse","number":3,"content":["Aa le nizotso mb’añ’anjomba’ i mpanao valàñe taney mb’eo, le nizoeko eo re nifanehak’ amo larò’eo."]},{"type":"verse","number":4,"content":["Aa ndra mbia’mbia aman-kandra i valàñe am-pità’ i mpanao valàñe-taneiy, le namboare’e indraike ho valàñe hafa, ty amy ze natao’ i mpanao valàñe taney soa hanoeñe."]},{"type":"verse","number":5,"content":["Le niheo amako ty tsara’ Iehovà, nanao ty hoe:"]},{"type":"verse","number":6,"content":["Ry anjomba’ Israele,",{"text":"Aa vaho tsy mete hanoeko ama’ areo","poem":1},{"lineBreak":true},{"text":"hao ty sata’ i mpanao valàñe-taney?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Ingo, te hambañe ami’ty lietse","poem":1},{"lineBreak":true},{"text":"am-pità’ i mpanao valàñe taneio,","poem":1},{"lineBreak":true},{"text":"inahareo an-tañako,","poem":1},{"lineBreak":true},{"text":"ry anjomba’ Israele.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie volañako ami’ty fifeheañe,","poem":1},{"lineBreak":true},{"text":"naho ami’ty fifelehañe,","poem":1},{"lineBreak":true},{"text":"t’ie haombotse, naho harotsake,","poem":1},{"lineBreak":true},{"text":"vaho hahomake,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"fe iambohoa’ i fifeheañe nafàkoy","poem":1},{"lineBreak":true},{"text":"o hatsivokara’eo,","poem":1},{"lineBreak":true},{"text":"le hivalik’amy raty ho nafetsako ama’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le ie volañeko i fifeheañe naho ty fifelehañe,","poem":1},{"lineBreak":true},{"text":"t’ie harafetse naho haoreñe;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"f’ie manao raty amasoko eo,","poem":1},{"lineBreak":true},{"text":"tsy mañaoñe ty feoko;","poem":1},{"lineBreak":true},{"text":"le haneñenako i soa nitaroñeko","poem":1},{"lineBreak":true},{"text":"hitahiako azey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le saontsio am’ondati’ Iehodào,","poem":1},{"lineBreak":true},{"text":"naho amo mpimoneñe e Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"ty hoe: Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Inao, hañajariako hankàñe,","poem":1},{"lineBreak":true},{"text":"naho ikitrohako hekoheko;","poem":1},{"lineBreak":true},{"text":"Mitoliha!","poem":1},{"lineBreak":true},{"text":"songa amy fitsilea’e tsy vokatsey,","poem":1},{"lineBreak":true},{"text":"vaho ovao o sata’ areoo","poem":1},{"lineBreak":true},{"text":"naho o fitoloña’ areoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa hoe iereo: Famoeam-piay izay;","poem":1},{"lineBreak":true},{"text":"fa hañavelo amo fisafiria’aio zahay,","poem":1},{"lineBreak":true},{"text":"sindre hañorike ty fanjeharan’arofo’e","poem":1},{"noteId":51},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Añontaneo amo fifeheañeo henaneo,","poem":1},{"lineBreak":true},{"text":"ia ty nahajanjiñe i hoe zay;","poem":1},{"lineBreak":true},{"text":"toe nanao halatsàñe i somondrara","poem":1},{"lineBreak":true},{"text":"ana’ Israeley.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hipotak’ amy vato an-kivokey hao","poem":1},{"lineBreak":true},{"text":"ty fanala’ i Lebanone?","poem":1},{"lineBreak":true},{"text":"Mb’ia te nasintake i rano manintsy mikararake boak’añ’ambahiniy?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fe nandikok’ ahy ondatikoo,","poem":1},{"lineBreak":true},{"text":"nañembok’ an-drahare tsy vente’e;","poem":1},{"lineBreak":true},{"text":"nampitsikapy iareo amo lala’eo,","poem":1},{"lineBreak":true},{"text":"amo lalan-taoloo,","poem":1},{"lineBreak":true},{"text":"hitsilea’ iareo añ’oloñoloñe ao,","poem":1},{"lineBreak":true},{"text":"fa tsy an-dàmoke;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hanoeñe halatsañe ty tane’ iareo,","poem":1},{"lineBreak":true},{"text":"fikosihañe nainai’e;","poem":1},{"lineBreak":true},{"text":"Songa ho vereñe ty mioza ama’e,","poem":1},{"lineBreak":true},{"text":"vaho hikofikofi-doha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Haboeleko manahake t’ie an-tioke","poem":1},{"lineBreak":true},{"text":"atiñanañe añatrefa’ o rafelahi’ iareoo;","poem":1},{"lineBreak":true},{"text":"hiambohoako,","poem":1},{"lineBreak":true},{"text":"fa tsy hampiatrefako laharañe,","poem":1},{"lineBreak":true},{"text":"amy androm-peh’ohatsey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Le hoe iereo,","poem":1},{"lineBreak":true},{"text":"Antao hikitro-draha am’ Iirmeà;","poem":1},{"lineBreak":true},{"text":"fa tsy ho modo amo mpisoroñeo ty Hàke","poem":1},{"lineBreak":true},{"text":"naho amo mpitokio i tsaray.","poem":1},{"lineBreak":true},{"text":"Antao hanjevoñe aze am-pameleke,","poem":1},{"lineBreak":true},{"text":"fa leo raik’ amo enta’eo","poem":1},{"lineBreak":true},{"text":"tsy ho haoñen-tika.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Haoño iraho ry Iehovà, vaho","poem":1},{"lineBreak":true},{"text":"janjiño ty feo’ o mpikilily ahikoo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ty raty hao ty añavahañe ty soa?","poem":1},{"lineBreak":true},{"text":"amy te nihalia’ iareo koboñe ty fiaiko.","poem":1},{"lineBreak":true},{"text":"Tiahio i niongahako añatrefa’o eo","poem":1},{"lineBreak":true},{"text":"nitaliliako hasoa,","poem":1},{"lineBreak":true},{"text":"hampiholiarañe iareo amy haviñera’oy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa le aseseo mb’an-kerè o keleia’eo, ampikovovoho mb’an-kaozara’","poem":1},{"lineBreak":true},{"text":"i fibaray mb’eo;","poem":1},{"lineBreak":true},{"text":"le ampifandalao o ana’eo","poem":1},{"lineBreak":true},{"text":"o rakembao ho ramavoiñe;","poem":1},{"lineBreak":true},{"text":"naho ampizevo hivetrake ondati’eo,","poem":1},{"lineBreak":true},{"text":"vaho ampitrobahem-pibara","poem":1},{"lineBreak":true},{"text":"an-kotakotak’ ao o ajalahi’iareoo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ee te ho janjiñeñe boak’añ’anjomba’ iareo ty kaikaike,","poem":1},{"lineBreak":true},{"text":"ie ampivovoa’o firimboñan-dahin-defoñe; amy te nihalia’ iareo koboñe hitsepak’ ahy,","poem":1},{"lineBreak":true},{"text":"vaho nañetaha’ iareo fandrike","poem":1},{"lineBreak":true},{"text":"o tombokoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fe arofoana’o, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ze hene fikililia’ iareo hañè-doza amako,","poem":1},{"lineBreak":true},{"text":"ko ihevean-kakeo vaho ko faopaohe’o tsy ho añatrefa’o o tahi’iareoo;","poem":1},{"lineBreak":true},{"text":"f’ie rotsaho aolo’o eo,","poem":1},{"lineBreak":true},{"text":"ondroho amy andron-kaviñera’oy.","poem":1}]}],"footnotes":[{"noteId":51,"caller":"+","text":"Fot 8:21, Sab 141:1, Rzs 32:6, Iir 4:4, 7:24, 16:12, 17:9, 23:17, Lke 6:45, Heb 3:12","reference":{"chapter":18,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}