ntse’ iereo iraho,","poem":1},{"lineBreak":true},{"text":"naho nampialihe’ iereo ty toetse toy,","poem":1},{"lineBreak":true},{"text":"naho nañemboke tsotse","poem":1},{"lineBreak":true},{"text":"aman-drahare ila’e","poem":1},{"lineBreak":true},{"text":"tsy nifohi’ iereo ndra o roae’ iareoo,","poem":1},{"lineBreak":true},{"text":"ndra o mpanjaka’ Iehodào;","poem":1},{"lineBreak":true},{"text":"nilipore’ iereo lio-màliñe ty toetse toy;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"le nandranjia’ iareo tamboho t’i Baale, hamorototo o ana’ iareoo añ’afo ao","poem":1},{"lineBreak":true},{"text":"ho soroñañe amy Baale;","poem":1},{"lineBreak":true},{"text":"ie tsy nililieko, tsy nitaroñako","poem":1},{"lineBreak":true},{"text":"naho tsy nimoak’am-pitsakoreako ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te tsy ho tokaveñe ty hoe Tofete","poem":1},{"lineBreak":true},{"text":"ty toetse toy, ndra ty hoe","poem":1},{"lineBreak":true},{"text":"Vavatanen’ ana’ i Hinome,","poem":1},{"lineBreak":true},{"text":"te mone ty Vavatanem-panjamanañe;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le ho koaheko ami’ty toetse toy","poem":1},{"lineBreak":true},{"text":"ty fanoroan-keve’ Iehodà","poem":1},{"lineBreak":true},{"text":"naho Ierosalaime;","poem":1},{"lineBreak":true},{"text":"le hampikorovoheko fibara","poem":1},{"lineBreak":true},{"text":"añ’atrefa’ o rafelahi’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho am-pità’ o mipay ty fiai’ iareoo;","poem":1},{"lineBreak":true},{"text":"vaho ho fahanako ami’ty lolo’ iareo o voron-dikerañeo","poem":1},{"lineBreak":true},{"text":"naho o bibi’ty tane toio;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"naho hanoeko halatsañe ty rova toy,","poem":1},{"lineBreak":true},{"text":"naho fikosihañe;","poem":1},{"lineBreak":true},{"text":"le hene ho vereñe ze miary eo vaho","poem":1},{"lineBreak":true},{"text":"hikosìke ty amo hekoheko iabio;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"le hampikamaeko iareo","poem":1},{"lineBreak":true},{"text":"ty sandri’ o ana-dahi’eo naho","poem":1},{"lineBreak":true},{"text":"ty nofo’ o anak’ampela’eo,","poem":1},{"lineBreak":true},{"text":"naho songa hikama ty nofo’ o rañe’eo, amy fañarikatohañey naho amy fanjirañey, vaho amy haloviloviañe hanoe’ o rafelahi’e mipay ty fiai’ iareooy.","poem":1}]},{"type":"verse","number":10,"content":["Ie amy zao, jeñaho am-pahaisaha’ indaty mindre ama’o rey i zonjoñey,"]},{"type":"verse","number":11,"content":["vaho ano ty hoe:",{"text":"Hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Hanahake izay ty hampidemohako","poem":1},{"lineBreak":true},{"text":"ondaty retoa naho ty rova toy,","poem":1},{"lineBreak":true},{"text":"hambañe ami’ty fampijeñafañe","poem":1},{"lineBreak":true},{"text":"ty zonjòm-panao valàñe tane,","poem":1},{"lineBreak":true},{"text":"t’ie tsy ho lefe amboareñe ka;","poem":1},{"lineBreak":true},{"text":"le halenteke e Tofete ao iereo","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy ho aman-tanem-pandeveñañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Izay ty hanoako ami’ty toetse toy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho amo mpimone’eo,","poem":1},{"lineBreak":true},{"text":"soa te hampanahafeko amy Tofete","poem":1},{"lineBreak":true},{"text":"ty rova toy,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"le ho hambañe amy Tofete","poem":1},{"lineBreak":true},{"text":"o anjomba’ Ierosalaimeo, naho","poem":1},{"lineBreak":true},{"text":"o anjombam-panjaka’ Iehodà fa vinetao,","poem":1},{"lineBreak":true},{"text":"toe ze hene anjomba nañemboke amo valobohòn-dikerañeo,","poem":1},{"li