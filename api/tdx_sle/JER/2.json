{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Le niheo amako ty tsara’ Iehovà, nanao ty hoe:"]},{"type":"verse","number":2,"content":["Akia mikoiha an-dravembia’ Ierosalaime ao ty hoe:",{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"tiahiko ty hatea’ i hatora’oy,","poem":1},{"lineBreak":true},{"text":"ty fikokoa’o, ihe nienga-vao;","poem":1},{"lineBreak":true},{"text":"i fireketa’o amako an-dratraratray","poem":1},{"lineBreak":true},{"text":"an-tane mboe tsy nitongisañe añe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niavake am’ Iehovà t’Israele,","poem":1},{"lineBreak":true},{"text":"ty lohavoan-kavokara’e;","poem":1},{"lineBreak":true},{"text":"hanan-kakeo ze mampibotseke ama’e,","poem":1},{"lineBreak":true},{"text":"hankàñe ty hizò iareo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mijanjiña ty tsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ry anjomba’ Iakobe","poem":1},{"noteId":10},{"text":", naho","poem":1},{"lineBreak":true},{"text":"ry hene fifokoan’anjomba’ Israele;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ino ty tsi-havañonañe nizoe’","poem":1},{"lineBreak":true},{"text":"o roae’ areoo amako,","poem":1},{"lineBreak":true},{"text":"kanao nihankaña’e,","poem":1},{"lineBreak":true},{"text":"naho nañorike ty tsy jefa’e,","poem":1},{"lineBreak":true},{"text":"vaho nifotsake ho kafoake?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mbore tsy nanao ty hoe iereo:","poem":1},{"lineBreak":true},{"text":"Aia t’Iehovà nanese antika niakatse","poem":1},{"lineBreak":true},{"text":"an-tane Mitsraime","poem":1},{"noteId":11},{"text":",","poem":1},{"lineBreak":true},{"text":"niranga i fatram-beiy,","poem":1},{"lineBreak":true},{"text":"i tanen-diolio naho koboñey,","poem":1},{"lineBreak":true},{"text":"i tanem-paosa an-talinjon-kavilasiy,","poem":1},{"lineBreak":true},{"text":"tane mb’e lia’e tsy nitsahe ‘ondaty,","poem":1},{"lineBreak":true},{"text":"vaho tsy fimoneña’ ty ana’ ondaty.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nendesako mb’an-tane mamokatse,","poem":1},{"lineBreak":true},{"text":"hikama’ areo ty hasoa’e;","poem":1},{"lineBreak":true},{"text":"fa ie nizilik’ ao te mone tiniva’ areo i tanekoy,","poem":1},{"lineBreak":true},{"text":"vaho vineta’ areo i lovakoy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy nanao ty hoe o mpisoroñeo:","poem":1},{"lineBreak":true},{"text":"Aia t’Iehovà?","poem":1},{"lineBreak":true},{"text":"Namoea’ o mpamandroñe Hàke iabio iraho,","poem":1},{"lineBreak":true},{"text":"nandilatse ahy o mpiarakeo","poem":1},{"noteId":12},{"text":",","poem":1},{"lineBreak":true},{"text":"nitoky añamy Baale","poem":1},{"noteId":13},{"text":"o mpitokio,","poem":1},{"lineBreak":true},{"text":"vaho nañorike raha tsy vara.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa le hiatreatreako, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hatreatrèko o anan’ana’ areoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitsahà mb’an-tokonosen’","poem":1},{"lineBreak":true},{"text":"te-Kitìmeo","poem":1},{"noteId":14},{"text":"añe naho mandrendreha","poem":1},{"lineBreak":true},{"text":"naho ampañitrifo mb’e Kedare","poem":1},{"noteId":15},{"text":"mb’eo","poem":1},{"lineBreak":true},{"text":"vaho mitsoeha,","poem":1},{"lineBreak":true},{"text":"hera ho oni’ areo te fa teo, o hoe zao:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tane aia ty nañova o ‘ndrahare’eo,","poem":1},{"lineBreak":true},{"text":"ie toe ‘ndrahare tsie avao?","poem":1},{"lineBreak":true},{"text":"fe nasolo’ ondatiko raha tsy manjofake ty enge’ iareo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ilatsao ry likerañeo,","poem":1},{"lineBreak":true},{"text":"minevenevèra naho mijehàra,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanao hakeo roe ondatikoo:","poem":1},{"lineBreak":true},{"text":"Nifarie’ iareo iraho,","poem":1},{"lineBreak":true},{"text":"i Rano Veloñe","poem":1},{"noteId":16},{"text":"migoangoañey,","poem":1},{"lineBreak":true},{"text":"hihalia’iareo kadaha,","poem":1},{"lineBreak":true},{"text":"kadaha señake tsy mahatan-drano.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ondevo hao t’Israele?","poem":1},{"lineBreak":true},{"text":"Fetrek’oro hao?","poem":1},{"lineBreak":true},{"text":"Aa le ino ty idohirañ’ aze?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fa nitroñe ama’e o liona tora’eo,","poem":1},{"lineBreak":true},{"text":"nipoña-peo hampangoakoak’ i tane’ey,","poem":1},{"lineBreak":true},{"text":"kòake iaby o rova’eo,","poem":1},{"lineBreak":true},{"text":"tsy amam-pimoneñe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hinara’ o ana’ i Nofe","poem":1},{"noteId":17},{"lineBreak":true},{"text":"naho i Tak’penkeseo","poem":1},{"noteId":18},{"text":"ty hevo’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy zao hao ty tali’ i raha zay,","poem":1},{"lineBreak":true},{"text":"te naforintse’o t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"i niaolo azo amy lalañeiy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ino mb’arè ty atao’o an-dalam-b’e Mitsraime añe,","poem":1},{"lineBreak":true},{"text":"hitohoke ty ranon-tSikore","poem":1},{"noteId":19},{"text":"hao?","poem":1},{"lineBreak":true},{"text":"Ino ka ty hanoe’o an-dalañe mb’e Asore mb’eo, he hitrinike i ranon-tSàkay hao?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ty halò-tsere’o avao ty hitrevok’ azo,","poem":1},{"lineBreak":true},{"text":"naho hañendak’ azo ty fidisa-voli’o;","poem":1},{"lineBreak":true},{"text":"mahaoniña arè, vaho mahaisaha","poem":1},{"lineBreak":true},{"text":"te raha raty naho mafaitse","poem":1},{"lineBreak":true},{"text":"ty fitsambolitio’o an’ Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"naho te tsy ama’o","poem":1},{"lineBreak":true},{"text":"ty fañeveñañe Amako,","poem":1},{"lineBreak":true},{"text":"hoe t’i Talè, Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa pinozako haehae ty joka’o,","poem":1},{"lineBreak":true},{"text":"rinafadrafako o vahotseo,","poem":1},{"lineBreak":true},{"text":"le hoe irehe: Tsy ho toroñeko, te mone nandrea’o vaho nanao hakarapiloañe ambone’ ze hene haboañe","poem":1},{"lineBreak":true},{"text":"naho ambane’ ze fonga hatae mandrevake","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie naketsako am-bahem-panjàka,","poem":1},{"lineBreak":true},{"text":"toe am-boa’e soa do’e;","poem":1},{"lineBreak":true},{"text":"inom-barè ty nifotera’o ho hatae","poem":1},{"lineBreak":true},{"text":"tsy jefa’e, ho vahe alik’amako?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa ndra te ihe mikitroñe an-kilìny,","poem":1},{"lineBreak":true},{"text":"vaho milipotse an-tsavony ao,","poem":1},{"lineBreak":true},{"text":"mboe komatrao amako o tahi’oo,","poem":1},{"lineBreak":true},{"text":"hoe t’i Talè, Iehovà.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aa vaho ino ty atao’o ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy aman-kila iraho, izaho tsy nihitrike","poem":1},{"lineBreak":true},{"text":"mb’amo Baaleo?","poem":1},{"lineBreak":true},{"text":"Isao ty sata’o am-bavatane ao,","poem":1},{"lineBreak":true},{"text":"mahafohina o anoe’oo;","poem":1},{"lineBreak":true},{"text":"kiloan-drameva malisa irehe,","poem":1},{"lineBreak":true},{"text":"manivalativala o lala’eo;","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"tamanam-birike lý zatse am-patrañe ao,","poem":1},{"lineBreak":true},{"text":"mañantson-tioke am-pañirian-tro’e,","poem":1},{"lineBreak":true},{"text":"ia ty mahafikalañe i fitongoña’ey?","poem":1},{"lineBreak":true},{"text":"Tsy ho mokotse ty mipay aze,","poem":1},{"lineBreak":true},{"text":"ho oni’ iareo amy fivola’ey.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tano o fandia’oo tsy ho afa-kana,","poem":1},{"lineBreak":true},{"text":"ty tretra’o tsy haran-drano;","poem":1},{"lineBreak":true},{"text":"fe hoe irehe:","poem":1},{"lineBreak":true},{"text":"Tsy aman-ko tamaeñe, Aiy!","poem":1},{"lineBreak":true},{"text":"amy te nikoko ambahiny iraho,","poem":1},{"lineBreak":true},{"text":"le tsy mete tsy heañeko.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty hasalara’","poem":1},{"lineBreak":true},{"text":"ty mpikizo, ie tendreke,","poem":1},{"lineBreak":true},{"text":"ty hameñara’ ty anjomba’ Israele:","poem":1},{"lineBreak":true},{"text":"ie naho o mpanjaka’eo, o roandria’eo,","poem":1},{"lineBreak":true},{"text":"o mpisoro’eo, vaho o mpitoki’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ie manao ami’ty hatae ty hoe:","poem":1},{"lineBreak":true},{"text":"Raeko irehe, naho ami’ty vato:","poem":1},{"lineBreak":true},{"text":"Ihe ty niterak’ ahy,","poem":1},{"lineBreak":true},{"text":"toe nampiatre-boho amako iereo","poem":1},{"lineBreak":true},{"text":"fa tsy ty laharañe;","poem":1},{"lineBreak":true},{"text":"fe an-tsa maha am-poheke","poem":1},{"lineBreak":true},{"text":"ro hanoa’iareo ty hoe:","poem":1},{"lineBreak":true},{"text":"Miongaha, rombaho zahay.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aia heike o ­‘ndrahare tsinene’o","poem":1},{"lineBreak":true},{"text":"ho azoo? Angao hiongake iereo,","poem":1},{"lineBreak":true},{"text":"naho mete handrombak’ azo","poem":1},{"lineBreak":true},{"text":"an-tsan-kankà’o ao;","poem":1},{"lineBreak":true},{"text":"fa mira ami’ty hamaro’ o rova’oo","poem":1},{"lineBreak":true},{"text":"ty ndrahare’o, ry Iehodà.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Akore t’ie miatreatre ahiko?","poem":1},{"lineBreak":true},{"text":"Ie fonga nanao hakeo amako,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tsy jefa’e ty nandafàko o ana’ areoo,","poem":1},{"lineBreak":true},{"text":"ie tsy mete avohotse;","poem":1},{"lineBreak":true},{"text":"toe nabotsem-pibara’ areo","poem":1},{"lineBreak":true},{"text":"o mpitoki’areoo,","poem":1},{"lineBreak":true},{"text":"hoe namotsahan-diona.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ry tariratseo, inao ty tsara’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Nifatram-bey am’ Israele hao iraho?","poem":1},{"lineBreak":true},{"text":"ndra tane migobon-kaiem-bey?","poem":1},{"lineBreak":true},{"text":"Ino ty atao’ ondatikoo ty hoe:","poem":1},{"lineBreak":true},{"text":"Votsotse zahay; tsy homb’ama’o ka?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Handikofa’ ty somondrara hao","poem":1},{"lineBreak":true},{"text":"o rava’eo, ndra ty enga-vao o saro’eo?","poem":1},{"lineBreak":true},{"text":"Fe haliño’ ondatikoo","poem":1},{"lineBreak":true},{"text":"andro tsy fotofoto iraho.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ino ty ihamina’o","poem":1},{"lineBreak":true},{"text":"ty lalam-pipaia’o koko?","poem":1},{"lineBreak":true},{"text":"Toe nanare’o amo sata-rati’oo ka","poem":1},{"lineBreak":true},{"text":"o kalalijakeo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mbore oniñe an-jipo’o ao","poem":1},{"lineBreak":true},{"text":"ty liom-piai’ o rarake vañoñeo;","poem":1},{"lineBreak":true},{"text":"tsy nirendre’o t’ie niboroboñake ama’o;","poem":1},{"lineBreak":true},{"text":"ie amy hoe rezay","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Izaho tsy aman-kakeo;","poem":1},{"lineBreak":true},{"text":"fa mitolik’ amako ty haviñera’e—","poem":1},{"lineBreak":true},{"text":"ingo mikai-jaka amako irehe","poem":1},{"lineBreak":true},{"text":"ami’ty atao’o ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy aman-tahin-draho.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ie mikanifokanifoke avao","poem":1},{"lineBreak":true},{"text":"ami’ty fiovà’o lalañe;","poem":1},{"lineBreak":true},{"text":"Toe ho salare’ i Mitsraime ka","poem":1},{"lineBreak":true},{"text":"manahake ty hameñara’o amy Asore.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Boak’ atoy ty hiakara’o,","poem":1},{"lineBreak":true},{"text":"taña-mitan-doha;","poem":1},{"lineBreak":true},{"text":"fa napo’ Iehovà o niatoa’oo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hiraorao am’ iereo irehe.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Iakobe: Tomitse; Gegeañe hahazoañe","reference":{"chapter":2,"verse":4}},{"noteId":11,"caller":"+","text":"Egipte: Mpamorekeke, mampisotry","reference":{"chapter":2,"verse":6}},{"noteId":12,"caller":"+","text":"Iir 10:21, 12:10-11, 50:6-7","reference":{"chapter":2,"verse":8}},{"noteId":13,"caller":"+","text":"Baale: Talè, Tompo","reference":{"chapter":2,"verse":8}},{"noteId":14,"caller":"+","text":"Kitime: mamolake; mamonodroboke kedeke; volamena;","reference":{"chapter":2,"verse":10}},{"noteId":15,"caller":"+","text":"Kedare: hamoromoroñañe, hontoke","reference":{"chapter":2,"verse":10}},{"noteId":16,"caller":"+","text":"Jao 4:10,11, 7:38","reference":{"chapter":2,"verse":13}},{"noteId":17,"caller":"+","text":"Nofe: papin-tantele; ze mitsopatsopake","reference":{"chapter":2,"verse":16}},{"noteId":18,"caller":"+","text":"Tak’penkese: fanjiziañe mietake","reference":{"chapter":2,"verse":16}},{"noteId":19,"caller":"+","text":"Sikore: Hamainte’e","reference":{"chapter":2,"verse":18}}]},"thisChapterLink":"/api/tdx_sle/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}