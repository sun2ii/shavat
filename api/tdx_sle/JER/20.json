{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Ie jinanji’ i Paskore",{"noteId":52},"ana’ Imere",{"noteId":53},", mpisoroñe, loham-pifehe añ’ An­jomba’ Iehovà ao, i nitokie’ Iirmeày,"]},{"type":"verse","number":2,"content":["le nampandafa’ i Paskore t’Iirmeà, vaho najo’e an-dangoke an-dalam-bei’ i Beniamine añ’ Anjomba’ Iehovà ao."]},{"type":"verse","number":3,"content":["Ie amy loak’ àndroy naho nakare’ i Paskore amy longòkey t’Iirmeà, le nanoe’ Iirmeà ty hoe, Tsy Paskore ty nanoe’ Iehovà i tahina’oy fa Magòremisabìbe",{"noteId":54},"."]},{"type":"verse","number":4,"content":["Fa hoe t’Iehovà: Ingo hanoeko harevendreveñañe ami’ty vata’o naho amo hene rañe’oo irehe; le ho isam-pihaino’o ty ho korovohem-pibaran-drafelahi’ iareo, naho fonga hatoloko am-pitàm-panjaka’ i Bavele t’Iehodà naho hasese’e an-drohy mb’e Bavele mb’eo vaho ho zevoñe’e am-pibara."]},{"type":"verse","number":5,"content":["Hatoloko iareo ze hene haja’ ty rova toy; o havokara’e iabio, naho o raha sarobili’e iabio, eka, ze fonga vara’ o mpanjaka’ Iehodào ty hatoloko am-pità’ o rafe­lahi’eo; ho kopahe’ iereo, ho rambese’ iereo vaho hendese’ iareo mb’e Bavele añe."]},{"type":"verse","number":6,"content":["Le ihe, Paskore, naho ze fonga añ’ anjomba’o ao ro hasese mb’am-pandrohizam-b’eo; le ho avy e Bavele añe irehe, naho hihomake añe, vaho haleveñe añe, Ihe rekets’ o rañe’o iaby nitokia’o entam-bìlañeo."]},{"type":"verse","number":7,"content":[{"text":"Ry Iehovà, nazi’o iraho le nimeteako,","poem":1},{"lineBreak":true},{"text":"niambotraha’o, vaho nahagioke;","poem":1},{"lineBreak":true},{"text":"izaho fitohàfañe lomoñandro,","poem":1},{"lineBreak":true},{"text":"mañabiañe ahy ie abikey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie mivolan-draho le mitazataza,","poem":1},{"lineBreak":true},{"text":"mikoiake ty hoe:","poem":1},{"lineBreak":true},{"text":"Joy naho fandrotsahañe;","poem":1},{"lineBreak":true},{"text":"aa le sirikaeñe naho injeañe lomoñandro iraho ty amy tsara’ Iehovày","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie anoeko ty hoe,","poem":1},{"lineBreak":true},{"text":"tsy hivolañe aze iraho,","poem":1},{"lineBreak":true},{"text":"tsy hirehak’ ami’ty tahina’e ka,","poem":1},{"lineBreak":true},{"text":"toly ndra afo ty mihoboboke an-troko, migabeñe an-taolako ao,","poem":1},{"lineBreak":true},{"text":"naho mokotse avao iraho t’ie tanañe ao,","poem":1},{"lineBreak":true},{"text":"vaho tsy feleko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsinanoko ty tangogo’ i màroy,","poem":1},{"lineBreak":true},{"text":"mangebahebake mb’atia mb’etia:","poem":1},{"lineBreak":true},{"text":"Manirikà, eka ho sirikae’ay;","poem":1},{"lineBreak":true},{"text":"mamandroñ’ahy o rañeko iabio ke hitsikapy: He ho fañahien-dre, hoe iereo,","poem":1},{"lineBreak":true},{"text":"Toe ho felen-tika, ho valen-tikañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fe mindre amako t’Iehovà","poem":1},{"lineBreak":true},{"text":"hoe fanalolahy;","poem":1},{"lineBreak":true},{"text":"aa le hitsikapy o mpampisoañe ahio,","poem":1},{"lineBreak":true},{"text":"naho tsy hahalefe,","poem":1},{"lineBreak":true},{"text":"akore ty ho fisalara’ iareo","poem":1},{"lineBreak":true},{"text":"kanao tsy zary vaho ho fañonjirañe","poem":1},{"lineBreak":true},{"text":"tsy ho haliño kitro katroke.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ry Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ry Mpitsoke o vantañeo,","poem":1},{"lineBreak":true},{"text":"Mpivazoho añ’ova naho añ’arofo ao,","poem":1},{"lineBreak":true},{"text":"ehe te ho treako ty famalea’o fate iareo;","poem":1},{"lineBreak":true},{"text":"fa Ihe ty nampibentarako ty amako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sabò t’Iehovà, rengeo t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fa hinaha’e am-pità’ o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"ty fiai’ o rarakeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fatse i andro nahatoly ahikoy;","poem":1},{"lineBreak":true},{"text":"ehe te tsy ho tahieñe","poem":1},{"lineBreak":true},{"text":"i andro niterahan-drenekoy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ozoñeñe t’indaty ninday talily","poem":1},{"lineBreak":true},{"text":"an-draeko, nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Nisamake lahilahy irehe, nahafale aze.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ehe te hanahake o rova narotsa’ Iehovà tsy mete nisolohoo indaty zay;","poem":1},{"lineBreak":true},{"text":"Ee t’ie hijanjiñe kaikaike te maraiñe,","poem":1},{"lineBreak":true},{"text":"naho hazolava te tsipinde-mena.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amy t’ie tsy vinono’e boak’","poem":1},{"lineBreak":true},{"text":"an-koviñ’ ao;","poem":1},{"lineBreak":true},{"text":"soa te ho ni-kiboriko ty reneko,","poem":1},{"lineBreak":true},{"text":"ie nainai’e ho ni-bei-troke.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa vaho ino ty niakarako","poem":1},{"lineBreak":true},{"text":"i hoviñey hahatreavako","poem":1},{"lineBreak":true},{"text":"haemberañe naho hasotriañe,","poem":1},{"lineBreak":true},{"text":"hampibotsehan-kasalarañe o androkoo?","poem":1}]}],"footnotes":[{"noteId":52,"caller":"+","text":"Paskore: mampigaraboke loake; hafotia","reference":{"chapter":20,"verse":1}},{"noteId":53,"caller":"+","text":"Imere: misaontsy; añondry","reference":{"chapter":20,"verse":1}},{"noteId":54,"caller":"+","text":"Magoremisabibe: iarisehoa’ ty tahotse","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}