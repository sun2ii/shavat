m":1},{"lineBreak":true},{"text":"anahareo alafe’ o kijolioo,","poem":1},{"lineBreak":true},{"text":"fa hatontoko an-drova atoy iereo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le Izaho avao ty hialy ama’ areo","poem":1},{"lineBreak":true},{"text":"am-pità’ natorakìtsy naho","poem":1},{"lineBreak":true},{"text":"an-tsirañe maozatse, naho","poem":1},{"lineBreak":true},{"text":"an-kaboseke mileveleve,","poem":1},{"lineBreak":true},{"text":"vaho am-pifombo miforoforo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le ho lafaeko o mpimone’ ty rova toio,","poem":1},{"lineBreak":true},{"text":"ndra ondaty ndra biby;","poem":1},{"lineBreak":true},{"text":"hampihomahe’ ty angorosy jabajaba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie heneke, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le haseseko am-pità’ i Nebokadnetsare","poem":1},{"lineBreak":true},{"text":"mpanjaka’ i Bavele naho","poem":1},{"lineBreak":true},{"text":"am-pità’ o rafelahi’eo, naho","poem":1},{"lineBreak":true},{"text":"am-pità’ o mipay ty fiai’eo","poem":1},{"lineBreak":true},{"text":"t’i Tsidkià mpanjaka’Iehodà","poem":1},{"lineBreak":true},{"text":"naho o mpitoro’eo, naho","poem":1},{"lineBreak":true},{"text":"ze ondati’ an-drova atoy sinisa’ i","poem":1},{"lineBreak":true},{"text":"angorosiy naho i fibaray,","poem":1},{"lineBreak":true},{"text":"naho i hasalikoañey;","poem":1},{"lineBreak":true},{"text":"vaho ho lafae’e an-kasiom-pibara,","poem":1},{"lineBreak":true},{"text":"le tsy hihevea’e,","poem":1},{"lineBreak":true},{"text":"tsy hiferenaiña’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy hitretreza’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le hoe ty hatao’o am’ondaty retoa:","poem":1},{"lineBreak":true},{"text":"Hoe ty nafè’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Hehe te apoko aolo’ areo eo","poem":1},{"lineBreak":true},{"text":"ty lalan-kaveloñe naho","poem":1},{"lineBreak":true},{"text":"ty lalam-pikoromahañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ze tambatse an-drova atoy","poem":1},{"lineBreak":true},{"text":"ho vonoe’ ty fibara naho ty kerè,","poem":1},{"lineBreak":true},{"text":"vaho ty angorosy;","poem":1},{"lineBreak":true},{"text":"fe ho veloñe ze miakatse,","poem":1},{"lineBreak":true},{"text":"miambane amo nte-Kasdy","poem":1},{"lineBreak":true},{"text":"mañarikatok’ anahareoo,","poem":1},{"lineBreak":true},{"text":"le ho tamben-ali’e ty fiai’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe nampiatrefeko ami’ty rova toy","poem":1},{"lineBreak":true},{"text":"ty tareheko ho hekoheko fa tsy hasoa, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ie hatolotse am-pità’ i mpanjaka’ i","poem":1},{"lineBreak":true},{"text":"Baveley, vaho ho forototoe’e amañ’afo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le i anjombam-panjaka’ Iehodày,","poem":1},{"lineBreak":true},{"text":"janjiño ty tsara’ Iehovà;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ry anjomba’ i Davide, hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ano ty hatò boak’andro,","poem":1},{"lineBreak":true},{"text":"vaho avotsoro am-pità’ ty","poem":1},{"lineBreak":true},{"text":"mpamorekeke i nikamereñey,","poem":1},{"lineBreak":true},{"text":"tsy mone hionjoñe hoe afo ty habosehako,","poem":1},{"lineBreak":true},{"text":"hamorototoako tsy ho lefe vonoeñe,","poem":1},{"lineBreak":true},{"text":"ty amo haloloam-pitoloña’ areoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hehe te miatrek’azo raho","poem":1},{"lineBreak":true},{"text":"ry mpimoneñe am-bavatane ao,","poem":1},{"lineBreak":true},{"text":"hoe t’ie vato a montoñe ey,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"amy ty fatao’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Ia ty hizotso haname anay?","poem":1},{"lineBreak":true},{"text":"ndra ia ty himoak’ añ-akiba’ay atoa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Toe ho liloveko ty amo vokam-pitoloña’ areoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"naho hamiañako afo i ala’ey,","poem":1},{"lineBreak":true},{"text":"vaho fonga ho tomontoñe","poem":1},{"lineBreak":true},{"text":"ze mañohok’ aze.","poem":1}]}],"footnotes":[{"noteId":55,"caller":"+","text":"Malkia: Ià mpanjakako, mpañeretse ahy","reference":{"chapter":21,"verse":1}},{"noteId":56,"caller":"+","text":"Tsefanià: Iehovà ro tsikoko","reference":{"chapter":21,"verse":1}},{"noteId":57,"caller":"+","text":"Maaseia: ty fitoloña’ Iehovà","reference":{"chapter":21,"verse":1}},{"noteId":58,"caller":"+","text":"Nebokadnetsare: Ranomaso, hoihoi-jaka","reference":{"chapter":21,"verse":2}},{"noteId":59,"caller":"+","text":"Bavele: rapadrapake, fivalintsingoahañe;","reference":{"chapter":21,"verse":2}},{"noteId":60,"caller":"+","text":"Kasdy: hoe kokolampa; hoe malaso","reference":{"chapter":21,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/JER/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}