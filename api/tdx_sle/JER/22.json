{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["Hoe t’Iehovà: Mizotsoa mb’añ’ anjombam-panjaka’ Iehodà mb’eo, vaho saontsio eo o entañe zao:"]},{"type":"verse","number":2,"content":["ami’ty hoe: Janjiño ty tsara’ Iehovà, ry mpanjaka’ Iehodà miambesatse am-piambesa’ i Davide, ihe naho o mpitoro’oo vaho ondati’o mimoak’ an-dalam-bey retoañe."]},{"type":"verse","number":3,"content":["Hoe t’Iehovà: Ano ty hatò naho ty havantañañe, naho avotsoro am-pità’ o mpamorekekeo o nikamerañeo, naho ko isengea’o hery, ko mijoy ty renetane, ndra ty bode-rae, ndra ty vantotse, vaho ko mampiori-dio-màliñe an-toetse atoy."]},{"type":"verse","number":4,"content":["Aa naho toe anoe’ areo i tsarae­ñey, le himoak’ amo lalambei’ ty anjomba toio o mpanjaka hiambesatse am-piambesa’ i Davideo, hiningitse sarete naho soavala, ie naho o mpitoro’eo naho ondati’eo."]},{"type":"verse","number":5,"content":["F’ie tsy mañaoñe o tsara zao le hifantako am-batako, hoe t’Iehovà, te hangoakoake ty anjomba toy."]},{"type":"verse","number":6,"content":["Aa hoe t’Iehovà amy anjomba’ i mpanjaka’ Iehodày:",{"text":"Gilade","poem":1},{"noteId":61},{"text":"amako irehe,","poem":1},{"lineBreak":true},{"text":"ty andengo’ i Libanone","poem":1},{"noteId":62},{"text":";","poem":1},{"lineBreak":true},{"text":"f’ie toe hanoeko fatrañe,","poem":1},{"lineBreak":true},{"text":"rova tsy amam-pimoneñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ampihentseñako mpandrotsake,","poem":1},{"lineBreak":true},{"text":"songa amam-pialiañe;","poem":1},{"lineBreak":true},{"text":"ho firae’ iereo o mendoraveñe soao,","poem":1},{"lineBreak":true},{"text":"vaho havokovoko’ iareo añ’ afo ao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fifeheañe maro ty hiary ami’ty rova toy, naho hifanao aman-drañe’e ty hoe:","poem":1},{"lineBreak":true},{"text":"Aa vaho akore o nanoe’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty rova jabajaba toio?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le hanoiñe ty hoe iereo:","poem":1},{"lineBreak":true},{"text":"Amy t’ie nifary ty fañina’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ iareo,","poem":1},{"lineBreak":true},{"text":"niambane aman-drahare ila’e,","poem":1},{"lineBreak":true},{"text":"nitoroñe iareo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko roveta’ areo ty mikoromake,","poem":1},{"lineBreak":true},{"text":"ko mangololoike ho aze;","poem":1},{"lineBreak":true},{"text":"fe poñafo ty hoihoy i misesey,","poem":1},{"lineBreak":true},{"text":"amy te tsy himpoly ka,","poem":1},{"lineBreak":true},{"text":"tsy ho isa’e ka i tane nihirifa’ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"ty amy Salome","poem":1},{"noteId":63},{"text":"ana’ Iosià,","poem":1},{"lineBreak":true},{"text":"mpanjaka’ Iehodà,","poem":1},{"lineBreak":true},{"text":"i nandimbe an-drae’e Iosiay,","poem":1},{"lineBreak":true},{"text":"i nionjoñe boak’ ami’ty toetse toiy:","poem":1},{"lineBreak":true},{"text":"t’ie tsy himpoly atoy ka;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"fa amy tane aneseañ’ aze ho mpirohiy","poem":1},{"lineBreak":true},{"text":"ty hikoromaha’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho isa’e ka ty tane toy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hankàñe t’indaty mandranjy","poem":1},{"lineBreak":true},{"text":"ty anjomba’e tsy an-kavantañañe,","poem":1},{"lineBreak":true},{"text":"naho o efe’eo tsy an-katò,","poem":1},{"lineBreak":true},{"text":"mampitolom-pitoroñe tsy an-tambe, vaho tsy atolo’e aze o karama’eo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I manao ty hoe, hatratrañako","poem":1},{"lineBreak":true},{"text":"ty trañoko naho ampalalàheko o efe’eo;","poem":1},{"lineBreak":true},{"text":"le anampaha’e lalan-kedekede,","poem":1},{"lineBreak":true},{"text":"naho temere’e mendoraveñe o rindri’eo,","poem":1},{"lineBreak":true},{"text":"vaho lokoe’e mena mañabasà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mahafehe hao irehe kanao","poem":1},{"lineBreak":true},{"text":"mpisenge mendoraveñe?","poem":1},{"lineBreak":true},{"text":"Tsy nikama naho ninoñe hao o rae’o","poem":1},{"lineBreak":true},{"text":"nitoloñe an-katò naho an-kahiti’e","poem":1},{"lineBreak":true},{"text":"vaho nierañerañeo?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nitaroñe’e ty enta’ o rarakeo","poem":1},{"lineBreak":true},{"text":"naho o poi’eo; nisoa henane zay.","poem":1},{"lineBreak":true},{"text":"Tsy izay hao ty faharendrehañe ahy?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe ami’ty fihàña’o avao","poem":1},{"lineBreak":true},{"text":"o fihaino’oo naho ty arofo’o,","poem":1},{"lineBreak":true},{"text":"naho ami’ty fampiorihan-dio-màliñe naho famorekekeañe vaho fikatramoañe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà ty am’ Iehoiakime","poem":1},{"lineBreak":true},{"text":"ana’ Iosià, mpanjaka’ Iehodà:","poem":1},{"lineBreak":true},{"text":"tsy hirovetañe ty hoe:","poem":1},{"lineBreak":true},{"text":"Hoihoy ty rahalahiko,","poem":1},{"lineBreak":true},{"text":"Hoihoy ty rahavave!","poem":1},{"lineBreak":true},{"text":"Tsy hangololoiha’iareo ty hoe:","poem":1},{"lineBreak":true},{"text":"Aa! ry talè, ndra, Aa! ty enge’e!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie haleveñe am-pandeveñam-borìke ao","poem":1},{"lineBreak":true},{"text":"ho kozozoteñe vaho havokovoko alafe’ o lalam-bei’ Ierosalaime ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mionjona mb’e Libanone","poem":1},{"lineBreak":true},{"text":"naho mikoiakoiaha,","poem":1},{"lineBreak":true},{"text":"poñafo e Basane","poem":1},{"noteId":64},{"text":"añe ty fiarañanaña’o;","poem":1},{"lineBreak":true},{"text":"vaho mangololoiha e Abarime","poem":1},{"noteId":65},{"text":"añe","poem":1},{"lineBreak":true},{"text":"fa fonga demoke o sakeza’oo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nivolañe ama’o iraho ami’ty firaoraoa’o","poem":1},{"lineBreak":true},{"text":"fa hoe irehe, Izaho tsy hitsanoñe,","poem":1},{"lineBreak":true},{"text":"sata’o tamy naha ajalahy azoy","poem":1},{"lineBreak":true},{"text":"ty tsy nañaoñe ty feoko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho faopaohe’ i tiokey ze mpiara’o iaby,","poem":1},{"lineBreak":true},{"text":"le homb’ ampandrohizañe añe","poem":1},{"lineBreak":true},{"text":"o sakeza’oo;","poem":1},{"lineBreak":true},{"text":"vaho ho meñare’o naho salare’o ze fonga haratia’o.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ry mpimoneñe e Libanone ao,","poem":1},{"lineBreak":true},{"text":"mpikafitse amo mendorave’eo,","poem":1},{"lineBreak":true},{"text":"akore ty fatariha’o naho mivovo ama’o o fikoritahañe manahake","poem":1},{"lineBreak":true},{"text":"ty fitsongoan’ ampela.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kanao velon-dRaho hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Ndra te nibangem-pitombok’ an-","poem":1},{"lineBreak":true},{"text":"tañan-kavanako eo t’i Koniaho","poem":1},{"noteId":66},{"lineBreak":true},{"text":"ana’ Iehoiakime, mpanjaka’ Iehodà,","poem":1},{"lineBreak":true},{"text":"le ho nasintako amako,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"vaho ho natoloko am-pità’","poem":1},{"lineBreak":true},{"text":"o mipay ty fiai’oo,","poem":1},{"lineBreak":true},{"text":"eka! am-pità’ o ihembaña’oo,","poem":1},{"lineBreak":true},{"text":"toe am-pità’ i Nebokadnetsare","poem":1},{"lineBreak":true},{"text":"mpanjaka’ i Bavele,","poem":1},{"lineBreak":true},{"text":"vaho am-pità’ o nte-Kasdio.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Le hahifiko mb’an-tane","poem":1},{"lineBreak":true},{"text":"tsy nisamaha’o añe,","poem":1},{"lineBreak":true},{"text":"ihe naho ty rene’o nahatoly azo;","poem":1},{"lineBreak":true},{"text":"le añe ty hihomaha’o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fe i tane salalae’ iereo himpoliañey, tsy himpolia’ iereo ka.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ondaty sirikaeñe hao ty Koniaho,","poem":1},{"lineBreak":true},{"text":"sinihara jeñake?","poem":1},{"lineBreak":true},{"text":"Karabiba tsy paiañe?","poem":1},{"lineBreak":true},{"text":"Akore te nariañe añe,","poem":1},{"lineBreak":true},{"text":"ie naho o amori’eo,","poem":1},{"lineBreak":true},{"text":"mb’an-tane tsy fohi’ iareo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"O ry tane, ry tane, ry tane!","poem":1},{"lineBreak":true},{"text":"Janjiño ty tsara’ Iehovà.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Sokiro tsy ho aman’anake t’indaty tia,","poem":1},{"lineBreak":true},{"text":"ondaty tsy hiraorao añ’andro’e;","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy ho aman-dahilahy o","poem":1},{"lineBreak":true},{"text":"tiri’eo ze hierañe am-piambesa’e,","poem":1},{"lineBreak":true},{"text":"am-piambesa’ i Davide eo,","poem":1},{"lineBreak":true},{"text":"ndra hifehe e Iehodà ao.","poem":1}]}],"footnotes":[{"noteId":61,"caller":"+","text":"Gilade: talily mitoboro, atiñana’ Iordane.","reference":{"chapter":22,"verse":6}},{"noteId":62,"caller":"+","text":"Libanone: Fidadañam-bohitse abo e Pilistý","reference":{"chapter":22,"verse":6}},{"noteId":63,"caller":"+","text":"Salome: fonitse; mete","reference":{"chapter":22,"verse":11}},{"noteId":64,"caller":"+","text":"Basane: am-pamotsy ao, ami’ty nife","reference":{"chapter":22,"verse":20}},{"noteId":65,"caller":"+","text":"Abarime: Fizilihañe; Mpijoñe","reference":{"chapter":22,"verse":20}},{"noteId":66,"caller":"+","text":"Koniaho: Haozara’ Iehovà","reference":{"chapter":22,"verse":24}}]},"thisChapterLink":"/api/tdx_sle/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}