{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Hankàñe amo mpiarake manjamañe naho mampibaibay o añondrim-piandrazakoo",{"noteId":67},"! hoe t’Iehovà."]},{"type":"verse","number":2,"content":["Aa le hoe t’Iehovà Andrianañahare’ Israele amo mpiarake mamahañe ondatikoo: Fa nampivarakaihe’ areo i lia-raikoy, vaho rinoa’ areo añe; tsy sinari’ areo; aa le hisariako ty amo haloloam-pitoloña’ areo, hoe t’Iehovà."]},{"type":"verse","number":3,"content":["Le izaho ty hanontoñe ty sehanga’ i lia-raikoy boak’ amo fifeheañe nandroahako iareoo, le hampoliko mb’ an-golobo’e mb’eo; vaho hiraorao vaho hanaranake."]},{"type":"verse","number":4,"content":["Le hampitroareko mpiarake hisary iareo naho hamahañe iareo",{"noteId":68},"; ie tsy ho hembañe ka, tsy hiroreke, vaho tsy ama’e ty hirereke, hoe t’Iehovà."]},{"type":"verse","number":5,"content":[{"text":"Ingo ho tondroke ty andro, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"t’ie hampitirieko amy Davide","poem":1},{"lineBreak":true},{"text":"ty tora-mionjo-bantañe,","poem":1},{"lineBreak":true},{"text":"ie ty ho mpanjaka hifeleke naho hiraorao,","poem":1},{"lineBreak":true},{"text":"vaho hizaka amy taney an-katò","poem":1},{"lineBreak":true},{"text":"naho an-kavañonañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho rombaheñe amo andro’eo t’Iehodà,","poem":1},{"lineBreak":true},{"text":"vaho hiaiñañoleñañe t’Israele;","poem":1},{"lineBreak":true},{"text":"le zao ty tahina’e hikanjiañe aze:","poem":1},{"lineBreak":true},{"text":"Iehovà Havantaña’ay.","poem":1}]},{"type":"verse","number":7,"content":["Aa le ingo ho tondroke ty andro hoe t’Iehovà, te tsy hanoe’ iereo ty hoe: Kanao veloñe t’Iehovà nañakatse o ana’ Israeleo boak’ an-tane’ Mitsraime añe;"]},{"type":"verse","number":8,"content":["fe: Kanao veloñe t’Iehovà nañavotse naho niaolo ty tirin’ anjomba’ Israele boak’an-tane avaratse añe, hirik’amo hene fifeheañe nandroahako iareo, le himoneña’ iareo ty tane’iareo."]},{"type":"verse","number":9,"content":[{"text":"Aa ty amo mpitokio:","poem":1},{"lineBreak":true},{"text":"Rofotse ty troko añ’ovako ao,","poem":1},{"lineBreak":true},{"text":"miripidripike iaby o taolakoo,","poem":1},{"lineBreak":true},{"text":"hoe te ondaty jike,","poem":1},{"lineBreak":true},{"text":"manahake t’indaty nimamoe’ ty divay,","poem":1},{"lineBreak":true},{"text":"ty am’ Iehovà naho o tsara’e masiñeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amy te manitsike i taney","poem":1},{"lineBreak":true},{"text":"o mpañakarapiloo;","poem":1},{"lineBreak":true},{"text":"itañia’ i taney i fatsey,","poem":1},{"lineBreak":true},{"text":"mikantañe o fiandrazañe am-patrambeio; mengoke am-pañaveloañe iareo","poem":1},{"lineBreak":true},{"text":"naho vàlañe an-kaozarañe;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsy aman-Kàke","poem":1},{"lineBreak":true},{"text":"ndra mpitoky ndra mpisoroñe;","poem":1},{"lineBreak":true},{"text":"eka, ndra añ’akibako ao ty nahatreavako","poem":1},{"lineBreak":true},{"text":"ty haloloa’ iareo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le halama o lala’ iareoo,","poem":1},{"lineBreak":true},{"text":"haronje ami’ty haleñe iereo","poem":1},{"lineBreak":true},{"text":"vaho hivarinjonjok’ ao;","poem":1},{"lineBreak":true},{"text":"fa hafetsako am’ iereo ty hankàñe,","poem":1},{"lineBreak":true},{"text":"eka, ty taom-pitilihañe iareo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mbore nahatrea hativañe amo mpisoro’","poem":1},{"lineBreak":true},{"text":"i Someroneo","poem":1},{"noteId":69},{"text":"iraho:","poem":1},{"lineBreak":true},{"text":"i Baale ty fitokia’ iareo,","poem":1},{"lineBreak":true},{"text":"mampanan-kakeo Israele ondatikoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Toe vata’e haloloañe ty nitreako amo mpitoky e Ierosalaimeo:","poem":1},{"lineBreak":true},{"text":"ie mpañarapilo naho","poem":1},{"lineBreak":true},{"text":"mpañavelo an-dañitse,","poem":1},{"lineBreak":true},{"text":"ampahozare’ iareo ty fità’ o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"soa tsy eo ty hibalintoa","poem":1},{"lineBreak":true},{"text":"amy hatsivokara’ey;","poem":1},{"lineBreak":true},{"text":"songa hanahake Sedome","poem":1},{"noteId":70},{"text":"amako iereo,","poem":1},{"lineBreak":true},{"text":"manahak’ i Amorà","poem":1},{"noteId":71},{"text":"o mpimone’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"ty amo mpitokio:","poem":1},{"lineBreak":true},{"text":"Ingo hifahanako vahontsoy,","poem":1},{"lineBreak":true},{"text":"ampinomeko manahin-afero;","poem":1},{"lineBreak":true},{"text":"fa boak’ amo mpitoki’ Ierosalaimeo ty namelaran-katemboañe nahatsitsike ty tane.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Ko haoñe’ areo ty lañona’ o mpitoky","poem":1},{"lineBreak":true},{"text":"mitoky ama’ areoo,","poem":1},{"lineBreak":true},{"text":"o mitarik’ anahareo mb’an-koakeo;","poem":1},{"lineBreak":true},{"text":"ty aroñaron-tro’e avao ty saontsie’ iereo f’ie tsy boak’am-palie’ Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mitolom-panao ty hoe amo malaiñe","poem":1},{"lineBreak":true},{"text":"Ahio iereo: inao ty tsara’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Hierañerañe nahareo;","poem":1},{"lineBreak":true},{"text":"naho amo manjotik’ am-panjeharan-tro’eo ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy ho tendrek’ ama’ areo","poem":1},{"lineBreak":true},{"text":"ty hekoheko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa ia ty nijohañe am-pivori’","poem":1},{"lineBreak":true},{"text":"Iehovà ao hahaoniñe,","poem":1},{"lineBreak":true},{"text":"hijanjiñe o tsara’eo?","poem":1},{"lineBreak":true},{"text":"Ia ty nañaoñe i nafè’ey,","poem":1},{"lineBreak":true},{"text":"naho nahafitsendreñ’aze?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ingo fa nionjoñe am-piforoforoa’e","poem":1},{"lineBreak":true},{"text":"ty tio-bei’ Iehovà,","poem":1},{"lineBreak":true},{"text":"eka, hiviombio an-doha’ o lo-tserekeo ty tangololahy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy himpoly ty haviñera’ Iehovà","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie mahaheneke,","poem":1},{"lineBreak":true},{"text":"ampara’ te fonire’e i satrie’ey,","poem":1},{"lineBreak":true},{"text":"ho fohi’ areo do’e izay","poem":1},{"lineBreak":true},{"text":"amo andro honkahonka’eo","poem":1},{"noteId":72},{"text":".","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy nafantoko o mpitoky retoa,","poem":1},{"lineBreak":true},{"text":"f’ie mihitrihitry;","poem":1},{"lineBreak":true},{"text":"tsy nivolañeko, f’ie mitoky avao","poem":1},{"noteId":73},{"text":".","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa naho nijohañ’ ampivoriko ao,","poem":1},{"lineBreak":true},{"text":"le ho nampijanjiñe’ iareo ondatikoo","poem":1},{"lineBreak":true},{"text":"o entakoo, himpolia’iareo","poem":1},{"lineBreak":true},{"text":"boak’amy lalan-kelokelo’iareoy","poem":1},{"lineBreak":true},{"text":"vaho hiambohoa’ iareo o sata’ rati’ iareoo,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Andrianañahare atoañe avao hao iraho, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa tsy Andrianañahare añe ka?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eo hao ty mahafietake","poem":1},{"lineBreak":true},{"text":"am-pipalira’e ao tsy ho treako?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Tsy manitsike i likerañey naho","poem":1},{"lineBreak":true},{"text":"ty tane toy hao iraho? hoe t’Iehovà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa tsinanoko ty saontsi’ o mpitoky","poem":1},{"lineBreak":true},{"text":"mpandañitse ami’ty añarakoo, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Nañinofy iraho, nañinofy iraho.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ampara’ te mb’ia te ho an-tro’","poem":1},{"lineBreak":true},{"text":"i mpitoky vilañey","poem":1},{"lineBreak":true},{"text":"ty hitokia’e vande,","poem":1},{"lineBreak":true},{"text":"ty hitoky ty famañahian-tro’e avao.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fisafiria’ iareo ty hampañaliñoañe ondatikoo ty añarako amo nofi’ iareo ifampisaontsia’ iareoo,","poem":1},{"lineBreak":true},{"text":"manahake ty nandikofa’ o roae’eo","poem":1},{"lineBreak":true},{"text":"ty añarako ty amy Baale.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ty mpitoky mañinofy,","poem":1},{"lineBreak":true},{"text":"apoho hitalily i nofi’ey;","poem":1},{"lineBreak":true},{"text":"le ty manañe i entakoy, soa re te","poem":1},{"lineBreak":true},{"text":"hitaroñe am-pigahiñañe.","poem":1},{"lineBreak":true},{"text":"Inoñ’ ami’ty ampemba hao ty ahetse? hoe t’Iehovà;","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tsy manahake ty afo hao o volakoo? hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"naho hoe ana-bato mampikotekoteke","poem":1},{"lineBreak":true},{"text":"ty lamilamy?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aa le inao! hejeko o mpitokio, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie mifampikametse o entakoo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Inao hatreatreko o mpitokio,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"ie mañetseke ty famele’e hitoky ty hoe: Hoe ty tsara’e.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Inao! toe hejeko o mitoky","poem":1},{"lineBreak":true},{"text":"nofin-dremborakeo, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie mitalily vaho mampandilatse ondatikoo amo vande’eo","poem":1},{"lineBreak":true},{"text":"naho amo fikanifoha’eo;","poem":1},{"lineBreak":true},{"text":"ie tsy niraheko, tsy liniliko;","poem":1},{"lineBreak":true},{"text":"mbore tsy mahasoa ondaty retoa,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":33,"content":["Aa naho manao ty hoe ama’o ondaty retoa, ndra ty mpitoky, ndra ty mpisoroñe: Ino ty nafè’ Iehovà? le isaontsio ty hoe, Fetse inoñe! Fa ho farieko nahareo, hoe t’Iehovà."]},{"type":"verse","number":34,"content":["Le ty mpitoky ndra mpisoroñe ndra ze ondaty mete hanao ty hoe: Ty nafè’ Iehovà; toe ho liloveko rekets’ i anjomba’ey indatiy."]},{"type":"verse","number":35,"content":["Fe songa hifanaontsy ty hoe aman-drañe’e naho aman-drahalahi’e: Ino ty navale’ Iehovà? ndra Ino ty nitsa­rae’ Iehovà?"]},{"type":"verse","number":36,"content":["fe tsy ho tiahi’ areo ty nafè’ Iehovà; fa sambe hisaontsy ty enta’e avao ondatio ho fetse, ie nimengohe’ areo",{"noteId":74},"ty tsaran’ Añahare veloñe, Iehovà’ i Màroy, Andrianañaharentikañe."]},{"type":"verse","number":37,"content":["Ty hoe ka ty hatao’ areo ami’ty mpitoky: Ino ty natoi’ Iehovà azo? naho Ino ty ni­tsarae’ Iehovà?"]},{"type":"verse","number":38,"content":["Fe anoe’areo ty hoe: Ty nafè’ Iehovà; le hoe t’Iehovà: kanao taroñe’ areo ty hoe: Ty nafè’ Iehovà, ie nafantoko ama’ areo ty hoe: Tsy ho saontsie’ areo ty hoe: Ty nafè’ Iehovà;"]},{"type":"verse","number":39,"content":["Ingo toe handikofako nahareo, haitoako tsy ho añ’ atrefako eo rekets’ i rova natoloko aman-droae’ areoy;"]},{"type":"verse","number":40,"content":["vaho hapoko ama’ areo ty inje tsy ho modo naho ty hasalarañe kitro katroke tsy ho haliño."]}],"footnotes":[{"noteId":67,"caller":"+","text":"Iek 34:6,12, Zek 10:2, Mat 9:36, Jao 10:12","reference":{"chapter":23,"verse":1}},{"noteId":68,"caller":"+","text":"Iir 3:14-17, Mik 2:12, 7:14","reference":{"chapter":23,"verse":4}},{"noteId":69,"caller":"+","text":"Somerone: ankaboam-pijilovañe","reference":{"chapter":23,"verse":13}},{"noteId":70,"caller":"+","text":"Sedome: ty tsiko’ iareo","reference":{"chapter":23,"verse":14}},{"noteId":71,"caller":"+","text":"Amorà: Mpiola","reference":{"chapter":23,"verse":14}},{"noteId":72,"caller":"+","text":"Iir 30:24, Dan 12:10","reference":{"chapter":23,"verse":20}},{"noteId":73,"caller":"+","text":"Iir 14:14-15, 23:32, 28:15, 29:9","reference":{"chapter":23,"verse":21}},{"noteId":74,"caller":"+","text":"Isa 24:5, Dan 7:25","reference":{"chapter":23,"verse":36}}]},"thisChapterLink":"/api/tdx_sle/JER/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/22.json","previousChapterAudioLinks":{},"numberOfVerses":40}