{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Saontsieñe te, ie mitsey valy t’indaty naho mifanarak’ ama’e i rakembay,","poem":1},{"lineBreak":true},{"text":"naho engae’ t’indaty ila’e,","poem":1},{"lineBreak":true},{"text":"ho mete hao te himpolie’e i valoha’ey?","poem":1},{"lineBreak":true},{"text":"Tsy haniva i taney hao?","poem":1},{"lineBreak":true},{"text":"F’ihe nanao hakarapiloañe ami’ty","poem":1},{"lineBreak":true},{"text":"mpikoko maro,","poem":1},{"lineBreak":true},{"text":"mbore te himpoly amako!","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ampiandrao mb’an-kaboañe liolio ey","poem":1},{"lineBreak":true},{"text":"o fihaino’oo le mahaisaha:","poem":1},{"lineBreak":true},{"text":"Aia irehe te tsy niolorañe?","poem":1},{"lineBreak":true},{"text":"Nitoboke añ’olon-dalañe eo nitsinginiotse am’iareo,","poem":1},{"lineBreak":true},{"text":"manahake ty Arabe","poem":1},{"noteId":20},{"text":"am-babangoañe añe;","poem":1},{"lineBreak":true},{"text":"vaho nandeora’o amy hatsimirira’o","poem":1},{"lineBreak":true},{"text":"naho ami’ty haloloa’o i taney.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toly ndra nahànkañe i orañey,","poem":1},{"lineBreak":true},{"text":"naho tsy nahavy ora-mamaratse;","poem":1},{"lineBreak":true},{"text":"toe nanao laharan-kalalijake irehe,","poem":1},{"lineBreak":true},{"text":"mifoneñe tsy ho salatse.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa tsy nitoreova’o aniany","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Ry Aba,","poem":1},{"lineBreak":true},{"text":"Nirañeko irehe te izaho nitora’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho tana’e nainai’e hao ty kabo’e?","poem":1},{"lineBreak":true},{"text":"ifahara’e pak’an-kamodoañe añe hao?","poem":1},{"lineBreak":true},{"text":"Inay ty saontsi’o,","poem":1},{"lineBreak":true},{"text":"fe nitoloñe’o raha raty","poem":1},{"lineBreak":true},{"text":"vaho i nipaia’oy avao ty norihe’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà amako","poem":1},{"lineBreak":true},{"text":"tañ’andro Iosià, mpanjaka: Niisa’o hao","poem":1},{"lineBreak":true},{"text":"i nanoe’ Israele mpidisa-voliy?","poem":1},{"lineBreak":true},{"text":"Songa vinonje’e ze vohitse abo","poem":1},{"lineBreak":true},{"text":"naho ambane’ ze hatae mandrevake,","poem":1},{"lineBreak":true},{"text":"vaho nanao hakarapiloañe ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le hoe iraho, Ie fonga nanoe’e,","poem":1},{"lineBreak":true},{"text":"le himpoly amako; f’ie tsy nimpoly,","poem":1},{"lineBreak":true},{"text":"vaho nahatrea izay ka t’Iehodà","poem":1},{"lineBreak":true},{"text":"rahavave’e mpahay fañahy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le nitreako te ndra t’ie tsineiko reke-takelam-pisarahañe ty amo fonga fañarapiloa’ Israele mpidisa-volio,","poem":1},{"lineBreak":true},{"text":"le tsy nañembañe Iehodà,","poem":1},{"lineBreak":true},{"text":"rahavave’e mpiolay izay;","poem":1},{"lineBreak":true},{"text":"ie nimb’eo nañarapilo ka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ty amy fitsihelatsihela’ i reñeley,","poem":1},{"lineBreak":true},{"text":"fonga nileore’e i taney,","poem":1},{"lineBreak":true},{"text":"vaho niolora’e ze hatae naho vato;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie amy zay, mboe tsy nimpoly","poem":1},{"lineBreak":true},{"text":"amako ami’ty haliforan’arofo’e","poem":1},{"lineBreak":true},{"text":"i rahavave’e Iehodà mpamañahiy","poem":1},{"lineBreak":true},{"text":"fa an-kalitake avao, hoe t’Iehovà—","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà amako,","poem":1},{"lineBreak":true},{"text":"Niventè’ Israele mpidisa-voliy te","poem":1},{"lineBreak":true},{"text":"mbe ambone’ Iehodà","poem":1},{"lineBreak":true},{"text":"mpamañahiy ty havañona’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akia, tseizo mañavaratse o tsara","poem":1},{"lineBreak":true},{"text":"zao ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Mimpolia ry Israele mpidisa-volio,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"Tsy hibosehako, fa hitretrezako,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy ho tanako nainai’e ty farahiko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Iantofo avao o hakeo’oo, o nandilara’o","poem":1},{"lineBreak":true},{"text":"am’ Iehovà Andrianañahare’oo,","poem":1},{"lineBreak":true},{"text":"ie naboele’o amy ze hene ambahiny ambane’ ze hatae mandrevake o sata’o,","poem":1},{"lineBreak":true},{"text":"naho tsy nihaoñe’o ty feoko,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mimpolia ry anake mpidisa-volio,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fa Tañanjomba’areo iraho,","poem":1},{"lineBreak":true},{"text":"naho hengaeko boak’an-drova ao","poem":1},{"lineBreak":true},{"text":"ty raik’ ama’ areo,","poem":1},{"lineBreak":true},{"text":"ty roe boak’ am-pifokoañ’ ao","poem":1},{"noteId":21},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho haseseko mb’e Tsione","poem":1},{"noteId":22},{"text":"mb’eo;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Le ho tolorako mpiarake","poem":1},{"lineBreak":true},{"text":"milahatse ami’ty troko,","poem":1},{"lineBreak":true},{"text":"hamahana’e hilala naho hihitse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho tondroke t’ie nanaranake vaho","poem":1},{"lineBreak":true},{"text":"nanitsike i taney","poem":1},{"lineBreak":true},{"text":"amo andro añeo, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te tsy hanao ty hoe ka iereo:","poem":1},{"lineBreak":true},{"text":"Ty vatam-pañina’ Iehovà;","poem":1},{"lineBreak":true},{"text":"tsy ho tendreke an-tsaiñe;","poem":1},{"lineBreak":true},{"text":"tsy ho saontsieñe;","poem":1},{"lineBreak":true},{"text":"tsy ho tiliheñe; vaho","poem":1},{"lineBreak":true},{"text":"tsy hanoeñe ka.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amy andro zay, hatao’ iareo ty hoe","poem":1},{"lineBreak":true},{"text":"fiambesa’ Iehovà t’Ierosalaime;","poem":1},{"lineBreak":true},{"text":"le kila fifeheañe ty hifanontone","poem":1},{"lineBreak":true},{"text":"mb’amy tahina’ Iehovày","poem":1},{"lineBreak":true},{"text":"mb’e Ierosalaime mb’eo;","poem":1},{"lineBreak":true},{"text":"vaho tsy hañaveloa’ iareo ka","poem":1},{"lineBreak":true},{"text":"i fanjeharan-tron-kaloloañey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hiharo-lia ami’ty anjomba’ Israele","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Iehodà amy andro zay,","poem":1},{"lineBreak":true},{"text":"vaho hindre lia boak’ an-tane","poem":1},{"lineBreak":true},{"text":"avaratse añe pak’ amy tane","poem":1},{"lineBreak":true},{"text":"natoloko an-droae’ areo ho lovay.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Le hoe iraho:","poem":1},{"lineBreak":true},{"text":"Akore t’ie havotrako amo anakoo,","poem":1},{"lineBreak":true},{"text":"naho hatoloko tane soa,","poem":1},{"lineBreak":true},{"text":"ty lova loho fanjaka amo fifeheañeo?","poem":1},{"lineBreak":true},{"text":"Le ho tokave’oo ty hoe: Raeko, iraho,","poem":1},{"lineBreak":true},{"text":"vaho tsy hivike ami’ty fañorihañe ahy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Toe manahake ty rakemba misita-baly am-pamañahiañe ty namañahia’o ahy,","poem":1},{"lineBreak":true},{"text":"ry anjomba’ Israele!","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Inay ty fiarañanañañe boak’","poem":1},{"lineBreak":true},{"text":"an-kaboañe maliolio eñe,","poem":1},{"lineBreak":true},{"text":"ty fangoihoia’ o ana’ Israele misolohoo,","poem":1},{"lineBreak":true},{"text":"amy te nimengohe’ iereo ty lala’ iareoy,","poem":1},{"lineBreak":true},{"text":"nandikofa’ iereo t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ iareo:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mimpolia ry anake manjehatseo,","poem":1},{"lineBreak":true},{"text":"le ho jangañeko ty fanjehara’ areo.","poem":1},{"lineBreak":true},{"text":"Itoan-jahay mb’ama’o,","poem":1},{"lineBreak":true},{"text":"amy te Ihe ro Iehovà Andrianañahare’ay.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Toe sahàtse avao o vohitseo,","poem":1},{"lineBreak":true},{"text":"o fifandragaragàñe an-kaboañeo.","poem":1},{"lineBreak":true},{"text":"Toe am’ Iehovà Andrianañahe’ay","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe Israele.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Fa nabea’ i hameñarañey mifototse ami’ty nahatora anay","poem":1},{"lineBreak":true},{"text":"o raha nitoloñan-droae’aio,","poem":1},{"lineBreak":true},{"text":"o lia-rai’eo, o mpirai-tro’eo, naho","poem":1},{"lineBreak":true},{"text":"o ana-dahi’eo vaho o anak’ampela’eo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Antao hibabok’ an-keñatse,","poem":1},{"lineBreak":true},{"text":"hisaron-tsalatse;","poem":1},{"lineBreak":true},{"text":"fa nanao hakeo am’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañaharentika tika naho","poem":1},{"lineBreak":true},{"text":"o raentikañeo, boak’ ami’ty","poem":1},{"lineBreak":true},{"text":"naha-ajaja antika pake henane,","poem":1},{"lineBreak":true},{"text":"vaho tsy norihentika ty fiarañanaña’ Iehovà Andrianañaharentika.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Arabe: hariva; liolio; kòake","reference":{"chapter":3,"verse":2}},{"noteId":21,"caller":"+","text":"Isa 27:12","reference":{"chapter":3,"verse":14}},{"noteId":22,"caller":"+","text":"Fampitiahiañe natroatse","reference":{"chapter":3,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/JER/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}