{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Ty tsara niheo am’Iirmeà boak’ am’ Iehovà, manao ty hoe:"]},{"type":"verse","number":2,"content":["Inao ty nitsara’ Iehovà, Andrianañahare’ Israele: Sokiro am-boke ao ze hene tsara nitaroñeko ama’o."]},{"type":"verse","number":3,"content":["Amy te ho tondroke ty andro, hoe t’Iehovà, te hafoteko ty fandrohiza’ ondatiko Israele naho Iehodao, hoe t’Iehovà; le hampoliko mb’amy tane natoloko aman-droae’ iareoy, vaho ho fanaña’ iareo."]},{"type":"verse","number":4,"content":["Le iretoañe o entañe nitsarae’ Iehova am’ Israele naho am’ Iehodao."]},{"type":"verse","number":5,"content":["Hoe t’Iehovà:",{"text":"Toe nahajanjiñe feom-pihondrahondrañe, naho fangebahebañan-jahay,","poem":1},{"lineBreak":true},{"text":"fa tsy fanintsiñañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Añontaneo henaneo, maharendreha hera misamake ty lahilahy;","poem":1},{"lineBreak":true},{"text":"akore arè te treako","poem":1},{"lineBreak":true},{"text":"mitam-pisafoa manahake","poem":1},{"lineBreak":true},{"text":"ty rakemba mitsongo ondaty iabio,","poem":1},{"lineBreak":true},{"text":"ie sindre miha-fosaposatse","poem":1},{"lineBreak":true},{"text":"o laharañeo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hoy abey ty hara’elahi’ i àndroy,","poem":1},{"lineBreak":true},{"text":"tsy añirinkiriñañe,","poem":1},{"lineBreak":true},{"text":"ho andron-kankàñe am’Iakobe,","poem":1},{"lineBreak":true},{"text":"f’ie ho rombaheñe ama’e.","poem":1}]},{"type":"verse","number":8,"content":["Ho tondrok’ amy andro zay, hoe t’Iehovà’ i Màroy, te hampipozaheko am-pititia’o ty joka’e, naho ho rafadrafateko o rohi’oo; vaho tsy hañondevo azo ka ty ambahiny;"]},{"type":"verse","number":9,"content":["fe songa hitoroñe Iehovà Andrianañahare’e naho i Davide mpanjaka’e, ie hampitroareko ho a iareo."]},{"type":"verse","number":10,"content":[{"text":"Aa le ko hemban-drehe","poem":1},{"lineBreak":true},{"text":"ry Iakobe mpitoroko, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"naho ko lonjetse, ry Israele;","poem":1},{"lineBreak":true},{"text":"fa toe ho rombaheko","poem":1},{"lineBreak":true},{"text":"boake tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"naho ty tiri’o boak’ an-tanem-","poem":1},{"lineBreak":true},{"text":"pandrohizañe añe,","poem":1},{"lineBreak":true},{"text":"le himpoly t’Iakobe naho hianjiñe","poem":1},{"lineBreak":true},{"text":"naho hierañerañe,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hañembañe aze.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amy t’ie indrezako, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"handrombahako;","poem":1},{"lineBreak":true},{"text":"le ho fonga mongoreko o fifeheañe nampiparatsiahako azoo,","poem":1},{"lineBreak":true},{"text":"fa tsy hampigadoñeko ka irehe;","poem":1},{"lineBreak":true},{"text":"te mone ho lafaeko ami’ty hatò,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho rotsaheko ho mongotse","poem":1},{"noteId":112},{"text":".","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Toe tsy lefe jangañeñe ty farare’o,","poem":1},{"lineBreak":true},{"text":"vaho mahaferenaiñe o fere’oo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy eo ty mihalaly ho azo,","poem":1},{"lineBreak":true},{"text":"hampibandiañe o naratseo,","poem":1},{"lineBreak":true},{"text":"tsy amañ’aoly mahamelañ’ azo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Songa nañaliño azo o sakeza’oo,","poem":1},{"lineBreak":true},{"text":"tsy ipaia’iareo; fa vinonotroboko","poem":1},{"lineBreak":true},{"text":"hoe zinevo’ ty rafelahy,","poem":1},{"lineBreak":true},{"text":"ami’ty fandafam-pampisoañe;","poem":1},{"lineBreak":true},{"text":"ami’ty hajabajaba’ o hakeo’oo","poem":1},{"lineBreak":true},{"text":"ami’ty fitoabora’ o tahi’oo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ino ty ikoikoiha’o ty hasilofa’o,","poem":1},{"lineBreak":true},{"text":"tsy mete mitotòtse o rare’oo,","poem":1},{"lineBreak":true},{"text":"fa ty haloza’ o hakeo’oo,","poem":1},{"lineBreak":true},{"text":"vaho ty hamaro’ o tahi’oo","poem":1},{"lineBreak":true},{"text":"ty nanoako ama’o o raha rezao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"F’ie songa habotseke","poem":1},{"lineBreak":true},{"text":"o mampibotsek’ azoo,","poem":1},{"lineBreak":true},{"text":"naho o rafelahi’o iabio,","poem":1},{"lineBreak":true},{"text":"sindre hasese am-pandrohizañe añe;","poem":1},{"lineBreak":true},{"text":"naho ho fikopahañe o mikopak’ azoo,","poem":1},{"lineBreak":true},{"text":"vaho fonga hatoloko ho tsindroheñe","poem":1},{"lineBreak":true},{"text":"ze mitsàtsa azo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hampijangañeko,","poem":1},{"lineBreak":true},{"text":"vaho ho melañeko o fere’oo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"amy te natao’ iareo","poem":1},{"lineBreak":true},{"text":"añombe-lahy mavo irehe ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Ty Tsione, ie tsy paia’ondatio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Inao! hafoteko ty fandrohizañe","poem":1},{"lineBreak":true},{"text":"o kiboho’ Iakobeo,","poem":1},{"lineBreak":true},{"text":"naho ho ferenaiñeko o kivoho’eo;","poem":1},{"lineBreak":true},{"text":"naho hamboareñe ambone’ i tamboho’ey i rovay,","poem":1},{"lineBreak":true},{"text":"vaho hajadoñe amy toe’ey","poem":1},{"lineBreak":true},{"text":"eo i anjombay.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hiboak’am’iereo ty fañandriañañe,","poem":1},{"lineBreak":true},{"text":"naho ty fiarañanaña’ o mifaleo;","poem":1},{"lineBreak":true},{"text":"vaho hampitomboeko fa tsy haketrake,","poem":1},{"lineBreak":true},{"text":"hampiraoraoeko iereo le tsy ho kede.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hanahake te taolo o ana’eo,","poem":1},{"lineBreak":true},{"text":"naho hioreñe aoloko eo","poem":1},{"lineBreak":true},{"text":"ty valobohò’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho fonga ho liloveko","poem":1},{"lineBreak":true},{"text":"ze mamorekeke iareo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ho raik’ am’iereo ty mpiaolo’ iareo,","poem":1},{"lineBreak":true},{"text":"naho ho hirik’ am’iereo ao ty mpifehe’ iareo; naho hampañarineko amako re,","poem":1},{"lineBreak":true},{"text":"toe ie ty hañarivo ahy;","poem":1},{"lineBreak":true},{"text":"fa ia ty hahavany hitotok’ amako? hoe t’Iehovà.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho ondatiko nahareo, vaho","poem":1},{"lineBreak":true},{"text":"ho Andrianañahare’ areo iraho.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Heheke ty talio-lahi’ Iehovà, fa mionjoñe mb’eo ty filoroloroa’e, tangololahy mikafoakafoake;","poem":1},{"lineBreak":true},{"text":"miviombio ami’ty loha’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tsy hibalike ty haviñerañe miforoforo’ Iehovà, ampara’ te nihenefe’e naho sikal’amy te fonitse i nisatrien’ arofo’ey;","poem":1},{"lineBreak":true},{"text":"ho rendre’ areo izay amo andro honka’eo","poem":1},{"noteId":113},{"text":".","poem":1}]}],"footnotes":[{"noteId":112,"caller":"+","text":"Iir 46:28, Isa 34:2, 45:17, Amo 9:8,","reference":{"chapter":30,"verse":11}},{"noteId":113,"caller":"+","text":"Iir 23:20","reference":{"chapter":30,"verse":24}}]},"thisChapterLink":"/api/tdx_sle/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}