{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Amy andro zay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le ho Andrianañahare’ ze hene fifokoa’","poem":1},{"lineBreak":true},{"text":"Israele iraho, vaho h’ondatiko iereo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Nitendreke falalàñe am-patrambey añe ondaty nasisa’ i fibaraio,","poem":1},{"lineBreak":true},{"text":"fa naseseko mb’am-pitofa’e","poem":1},{"lineBreak":true},{"text":"mb’eo t’Israele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niheo amako t’Iehovà","poem":1},{"lineBreak":true},{"text":"boak’ an-tsietoitane añe. nanao ty hoe: Eka, fa nikokoako irehe","poem":1},{"lineBreak":true},{"text":"am-pikokoañe tsy ho modo;","poem":1},{"lineBreak":true},{"text":"izay ty nitaonako azo","poem":1},{"lineBreak":true},{"text":"an-kafatraram-pikokoañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hamboareko indraike","poem":1},{"lineBreak":true},{"text":"le ho fonireñe irehe","poem":1},{"lineBreak":true},{"text":"ry somondrara’ Israele;","poem":1},{"lineBreak":true},{"text":"ho tintine’o indraike o kantsà’oo,","poem":1},{"lineBreak":true},{"text":"naho hionjo-mb’an-tsinjake","poem":1},{"lineBreak":true},{"text":"mindre amo mpifaleo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hambole vahe amo vohi’ i Someroneo indraike nahareo;","poem":1},{"lineBreak":true},{"text":"hitongy o mpitongio,","poem":1},{"lineBreak":true},{"text":"vaho hifale t’ie mahatoly sabo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"te ho koihe’ ty mpijilo ambohi’","poem":1},{"lineBreak":true},{"text":"i Efraime ey, ty hoe:","poem":1},{"lineBreak":true},{"text":"Miavota, antao hionjo","poem":1},{"lineBreak":true},{"text":"mb’e Tsione, mb’am’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañaharen-tika mb’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Misabòa an-kafaleañe r’Iakobe,","poem":1},{"lineBreak":true},{"text":"vaho mikoiha añivo o beim-pifeheañeo; Mitaroña, mandrengea, le ano ty hoe:","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, rombaho ondati’oo,","poem":1},{"lineBreak":true},{"text":"i sehanga’ Israeley.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Oniño t’ie hendeseko boak’an-tane","poem":1},{"lineBreak":true},{"text":"avaratse añe,","poem":1},{"lineBreak":true},{"text":"hatontoko boak’añ’olo’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"rekets’ o goao naho o kepekeo,","poem":1},{"lineBreak":true},{"text":"o savereñe rekets’ ana’eo,","poem":1},{"lineBreak":true},{"text":"vaho o mitsongo fa hisamakeo—","poem":1},{"lineBreak":true},{"text":"valobohòke jabajaba ty himpoly mb’atoy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie homb’ atoy an-kololoike,","poem":1},{"lineBreak":true},{"text":"le hiaoloako an-kohò;","poem":1},{"lineBreak":true},{"text":"hampombako mb’añolon-torahañe mikararake mb’eo,","poem":1},{"lineBreak":true},{"text":"an-dalam-bantañe tsy hahatsikapy;","poem":1},{"lineBreak":true},{"text":"amy te rae’ Israele iraho,","poem":1},{"lineBreak":true},{"text":"naho tañoloñoloñako t’i Efraime.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mahajanjiña ty tsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ry fifeheañeo, vaho tseizo amo tokonose tsietoitaneo","poem":1},{"lineBreak":true},{"text":"ty hoe: I nampivarakaike Israeley","poem":1},{"lineBreak":true},{"text":"ro manontoñe aze, naho mañotroñ’aze manahake ty fañotroña’","poem":1},{"lineBreak":true},{"text":"ty mpiarake i lia-rai’ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amy te vinili’ Iehovà ty fiai’Iakobe,","poem":1},{"lineBreak":true},{"text":"naho jineba’e am-pità’","poem":1},{"lineBreak":true},{"text":"i maozatse te ama’ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le homb’ atoy iereo hisabo","poem":1},{"lineBreak":true},{"text":"an-kaboa’ i Tsione ey,","poem":1},{"lineBreak":true},{"text":"naho hiloeloe ami’ty hasoa’ Iehovà;","poem":1},{"lineBreak":true},{"text":"ami’ty mahakama, naho ami’ty divay","poem":1},{"lineBreak":true},{"text":"naho ami’ty menake, ami’ty tora’ o lia-raike naho mpirai-trokeo;","poem":1},{"lineBreak":true},{"text":"le ho goloboñe soa tondrake ty fiai’ iareo, vaho tsy hinike ka.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie amy zay, hisalale an-tsinjake","poem":1},{"lineBreak":true},{"text":"ty somondrara,","poem":1},{"lineBreak":true},{"text":"naho hitraok’ ami’ty bey ty ajalahy;","poem":1},{"lineBreak":true},{"text":"ie hafoteko ho hafaleañe","poem":1},{"lineBreak":true},{"text":"ty fioremeña’ iareo,","poem":1},{"lineBreak":true},{"text":"naho hohoñeko,","poem":1},{"lineBreak":true},{"text":"vaho ho limbezeko firebehañe","poem":1},{"lineBreak":true},{"text":"ty fihontofa’ iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho liporeko solike","poem":1},{"lineBreak":true},{"text":"ty arofo’ o mpisoroñeo,","poem":1},{"lineBreak":true},{"text":"vaho hahaeneñe ondatikoo o hasoakoo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Inay ty fiarañanañañe e Ramà","poem":1},{"noteId":114},{"text":"añe,","poem":1},{"lineBreak":true},{"text":"fangololoihañe naho firovetañ’afero,","poem":1},{"lineBreak":true},{"text":"Angoihoie’ i Rakele","poem":1},{"noteId":115},{"text":"o amori’eo;","poem":1},{"lineBreak":true},{"text":"tsy mete ohoñen-dre ty amo ana’eo,","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà: Kalaño ty fiarañanaña’o","poem":1},{"lineBreak":true},{"text":"tsy hirovetse, naho","poem":1},{"lineBreak":true},{"text":"o fihaino’oo tsy hitsirike ranomaso;","poem":1},{"lineBreak":true},{"text":"fa ho tambezañe ty fitromaha’o,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà; vaho himpoly","poem":1},{"lineBreak":true},{"text":"boak’ an-tane’ i rafelahiy iereo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aman-ko tamaeñe o herone’oo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"le himpoly an-tane’ iareo o ana’ areoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe tsinanoko ty fikoaiha’ i Efraime:","poem":1},{"lineBreak":true},{"text":"Fa linafa’o,","poem":1},{"lineBreak":true},{"text":"toe finiake hoe dronga tsy folake,","poem":1},{"lineBreak":true},{"text":"ampitoliho iraho le ho tafa-tolike,","poem":1},{"lineBreak":true},{"text":"amy te Ihe ro Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahareko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa ie nampitolihen-draho le nisoloho,","poem":1},{"lineBreak":true},{"text":"ie nanaren-draho le pinaoko ty feko;","poem":1},{"lineBreak":true},{"text":"nisalatse, eka nimeñatse,","poem":1},{"lineBreak":true},{"text":"amy te tsy nivavèko ty injen-katorako.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Anak’isoko hao t’i Efraime?","poem":1},{"lineBreak":true},{"text":"Ajaja nahasinda hao re?","poem":1},{"lineBreak":true},{"text":"Fa beteke mivolañe aze iraho,","poem":1},{"lineBreak":true},{"text":"le vata’e tiahiko;","poem":1},{"lineBreak":true},{"text":"mikoritoke ho aze ty troko,","poem":1},{"lineBreak":true},{"text":"vaho ho tretrezeko, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Añoreño fanoroañe,","poem":1},{"lineBreak":true},{"text":"ampijadoño bodam-pamantarañe;","poem":1},{"lineBreak":true},{"text":"reketo mb’amy damokey ty arofo’o,","poem":1},{"lineBreak":true},{"text":"i lalañe nomba’o mb’eoy;","poem":1},{"lineBreak":true},{"text":"mimpolia ry somondrara’ Israele,","poem":1},{"lineBreak":true},{"text":"mibaliha mb’amo rova’o retoañe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ampara’ te ombia t’ie hiamboho,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela midisa-volio?","poem":1},{"lineBreak":true},{"text":"Fa namboatse raha vao an-tane atoy t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ho tsikarikarie’ ty ampela ty lahilahy.","poem":1}]},{"type":"verse","number":23,"content":["Hoe t’Iehovà’ i Màroy, t’i Andria­nañahare’ Israele: Mbe hindrai’ iareo an-tane’ Iehodà ao naho amo rova’eo, ie hafoteko ty fandrohizañe iareo, ty saontsy manao ty hoe:",{"text":"Hitahy azo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ry kivohon-kavantañañe,","poem":1},{"lineBreak":true},{"text":"ry vohin-kamasiñañe.","poem":1}]},{"type":"verse","number":24,"content":["Songa hitrao-pimoneñe ao t’Iehodà, vaho amo rova’eo o mpitongio naho o mpiarake lia-raikeo."]},{"type":"verse","number":25,"content":["Fa hanjañeko ty fañova mokotse le hampieneñeko ty sandry mitìke."]},{"type":"verse","number":26,"content":["Nitsekak’ amy zao iraho le nañente, vaho nimamy amako i firoroakoy."]},{"type":"verse","number":27,"content":["Inao! ho tondroke ty andro, hoe t’Iehovà, te ho tongiseko ami’ty tabiri’ ondaty naho ami’ty tabirin-kare ty anjomba’ Israele naho Iehodà."]},{"type":"verse","number":28,"content":["Ie amy zao, hambañe amy nisarieko iareo ho voroteñe naho harotsake vaho ho silofeñey; ty hisarieko iareo hamboareñe naho hamboleñe, hoe t’Iehovà."]},{"type":"verse","number":29,"content":["Tsy ho saontsie’ iereo ka amy andro zay te",{"text":"Nikama valoboke mìtsa ty roae,","poem":1},{"lineBreak":true},{"text":"vaho mangitsy ty nife’ o ana’eo.","poem":1}]},{"type":"verse","number":30,"content":["F’ie fonga hampihomahe’ o hakeo’eo; ze ondaty mikama valoboke mìtsa, le o famotsi’eo ty hangìtsy."]},{"type":"verse","number":31,"content":["Inao, ho tondroke ty andro, hoe t’Iehovà te hanoeko fañina vao amy anjomba’ Israeley naho i anjomba’ Iehodày",{"noteId":116},";"]},{"type":"verse","number":32,"content":["tsy hanahake i fañina nilahareko an-droae’ iareo tañ’andro nitanako am-pitàñe nañakarako iareo an-tane Mitsraimey; ie nivalik’ amy fañinakoy, ndra t’ie nitañanjomba’ iareo",{"noteId":117},", hoe t’Iehovà."]},{"type":"verse","number":33,"content":["Fe zao ty fañina hanoeko amy anjomba’ Israeley naho fa modo i andro rezay, hoe t’Iehovà, hapoko añ’ova’ iareo ao ty Hàke le ho sokireko añ’arofo’ iareo ao; naho ho Andrianañahare’ iareo iraho vaho h’ondatiko iereo;"]},{"type":"verse","number":34,"content":["tsy songa hifañoke ka ondatio naho o rañe’eo ami’ty hoe: Mahafohina Iehovà fa hene hahafohiñe ahy, mifotots’ an-tsitso’e pak’ ami’ty bey hoe t’Iehovà; fa hapoko ty tahi’ iareo le tsy ho tiahiko ka o hakeo’ iareoo."]},{"type":"verse","number":35,"content":[{"text":"Hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"mpanolotse i àndroy hañazava ty andro,","poem":1},{"lineBreak":true},{"text":"naho o fepè’ i volañey vaho o vasiañeoo","poem":1},{"lineBreak":true},{"text":"ho failo amo haleñeo,","poem":1},{"lineBreak":true},{"text":"i mpitrobo i riakey,","poem":1},{"lineBreak":true},{"text":"hampitroñañe o onjao,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Naho mienga tsy ho añatrefako","poem":1},{"lineBreak":true},{"text":"i fañè rezay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le hijihetse tsy ho fifeheañe","poem":1},{"lineBreak":true},{"text":"aoloko eo ka ty tiri’ Israele.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Naho lefe zeheñe i likerañey, naho","poem":1},{"lineBreak":true},{"text":"mete tsikaraheñe o mananta’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"izay vaho haitoako ka ze hene tiri’ Israele","poem":1},{"lineBreak":true},{"text":"ty amo fonga sata’ iareoo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Inao te ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te hamboareñe ho a Iehovà","poem":1},{"lineBreak":true},{"text":"i rovay boak’ am-pitalakesañ’abo","poem":1},{"lineBreak":true},{"text":"i Kanànele","poem":1},{"noteId":118},{"text":", pak’ an-dalambein-kotsokey.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Mbore ho kozozoteñe mahity mb’an-","poem":1},{"lineBreak":true},{"text":"kaboa’ i Garebe","poem":1},{"noteId":119},{"text":"i taly fanjeheañey,","poem":1},{"lineBreak":true},{"text":"vaho hiolake mb’e Goà","poem":1},{"noteId":120},{"text":"mb’eo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Le havaheñe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"i hene vavatanen-dolo naho lavenokey,","poem":1},{"lineBreak":true},{"text":"naho o teteke iaby pak’ an-toraha’ i","poem":1},{"lineBreak":true},{"text":"Kidroney","poem":1},{"noteId":121},{"text":"mb’eo, pak’ an-kotso’","poem":1},{"lineBreak":true},{"text":"i lalambein-tsoavala mianiñanañeio;","poem":1},{"lineBreak":true},{"text":"ie tsy hombotañe ka, tsy hafetsake","poem":1},{"lineBreak":true},{"text":"ambane nainai’e kitro añ’afe’e.","poem":1}]}],"footnotes":[{"noteId":114,"caller":"+","text":"Ramà: mionjoñe; pendreñe","reference":{"chapter":31,"verse":15}},{"noteId":115,"caller":"+","text":"Rakele: Vali’ Iakobe; añondry","reference":{"chapter":31,"verse":15}},{"noteId":116,"caller":"+","text":"Heb 8:8-12, 10:16-17","reference":{"chapter":31,"verse":31}},{"noteId":117,"caller":"+","text":"Ies 54:5, 56:5, Iek 16:8, Hos 2:19 Jao 3:29, Ko II 11:2-3, Efe 5:25-27, Ben 3:12, 19:8","reference":{"chapter":31,"verse":32}},{"noteId":118,"caller":"+","text":"Kanànele: falalañe; tamben’Añahare","reference":{"chapter":31,"verse":38}},{"noteId":119,"caller":"+","text":"Garebe: Olatse","reference":{"chapter":31,"verse":39}},{"noteId":120,"caller":"+","text":"Goà: ty fitsapa’e; ty fitroña’e","reference":{"chapter":31,"verse":39}},{"noteId":121,"caller":"+","text":"Kidrone: lompolompo, mampanahelo","reference":{"chapter":31,"verse":40}}]},"thisChapterLink":"/api/tdx_sle/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}