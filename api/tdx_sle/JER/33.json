"lineBreak":true},{"text":"amo firampiañeo naho amo fibarao,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ie mialy amo nte-Kasdio,","poem":1},{"lineBreak":true},{"text":"ro mone hiliporañe lolo’ondaty","poem":1},{"lineBreak":true},{"text":"zinamako ami’ ty habosehako,","poem":1},{"lineBreak":true},{"text":"naho ami’ty fifombokoo,","poem":1},{"lineBreak":true},{"text":"ty amo fonga haloloañe nañetahako tarehe ami’ty rova toio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inao ! handesako fijanganañe","poem":1},{"lineBreak":true},{"text":"le ho melañeko;","poem":1},{"lineBreak":true},{"text":"vaho haborako am’ iereo ty haliforan-kanintsiñe naho hatò.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hafoteko ty fandrohiza’ Iehodà","poem":1},{"lineBreak":true},{"text":"naho ty fandrohiza’ Israele,","poem":1},{"lineBreak":true},{"text":"vaho haoreko manahake tam-baloha’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie ho lioveko amo halò-tserek’ iabio,","poem":1},{"lineBreak":true},{"text":"i nampanan-tahiñe iareo amakoy;","poem":1},{"lineBreak":true},{"text":"vaho hapoko iaby ty hakeo’ iareo,","poem":1},{"lineBreak":true},{"text":"i nandilara’ iareo amako rezay;","poem":1},{"lineBreak":true},{"text":"o nañotà’ iareo faly amakoo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ho tahinam-pampirebehañ’ ahy","poem":1},{"lineBreak":true},{"text":"naho engeñe vaho volonahetse,","poem":1},{"lineBreak":true},{"text":"añatrefa ze fifehea’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"le hañeveñe naho hinevenevetse","poem":1},{"lineBreak":true},{"text":"ze hahajanjiñe ty hasoa","poem":1},{"lineBreak":true},{"text":"hanoeko am’ iereo;","poem":1},{"lineBreak":true},{"text":"amy ze hene hasoa","poem":1},{"lineBreak":true},{"text":"naho fierañerañañe hanoako.","poem":1}]},{"type":"verse","number":10,"content":["Hoe t’Iehovà: Mbe ho janjiñeñe an-toetse atoy, i atao’ areo ty hoe: Mangoakoake, tsy ama’ ondaty, tsy amam-biby naho amo rova’ Iehodào naho an-dàmo’ Ierosalaime ey; amy bangìñe tsy ama’ ondaty, tsy amam-pimoneñe, tsy aman-kàrey,"]},{"type":"verse","number":11,"content":[{"text":"ty feom-pirebehañe, naho","poem":1},{"lineBreak":true},{"text":"ty feon-kafaleañe,","poem":1},{"lineBreak":true},{"text":"ty feom-pañenga naho","poem":1},{"lineBreak":true},{"text":"ty feon’engaeñe,","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ o manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Andriaño t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"fa soa t’Iehovà, nainai’e ty fiferenaiña’e;","poem":1},{"lineBreak":true},{"text":"vaho o minday engam-pañandriañañe mb’añ’anjomba’ Iehovà mb’eoo.","poem":1},{"lineBreak":true},{"text":"Amy te hampoliko ty fandrohiza’ i taney manahake tam-baloha’ey,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":12,"content":["Hoe t’Iehovà’ i Màroy, Mbe ho eo indraik’ ami’ty toetse mangoakoake toy,",{"text":"ie tsy ama’ondaty, tsy aman-kàre, naho amo hene rova’eo,","poem":1},{"lineBreak":true},{"text":"ty kivohom-piarake mampàndre o lia-rai’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amo rova am-bohitseo naho","poem":1},{"lineBreak":true},{"text":"amo rova am-bavataneo naho","poem":1},{"lineBreak":true},{"text":"amo rova atimoo naho","poem":1},{"lineBreak":true},{"text":"an-tane’ i Beniamine ao naho","poem":1},{"lineBreak":true},{"text":"am-paripari’ Ierosalaimeo vaho","poem":1},{"lineBreak":true},{"text":"amo rova Iehodao, ty hirangà’ o lia-raikeo ambane’ ty fitàñe mañiake iareo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":14,"content":["Inao! ho tondroke ty andro, hoe t’Iehovà, te ho henefako i tsara soa nitsa­raeko amy anjomba’ Israeley naho i anjomba’ Iehodàiy."]},{"type":"verse","number":15,"content":["Ie amy andro rezay naho amy sa zay, ty hampitiriako toran-kavañonañe t’i Davide, le ie ty hitoloñe an-katò naho an-kavantañañe amy taney."]},{"type":"verse","number":16,"content":["Ho rombaheñe amy andro rezay t’Iehodà, vaho hierañerañe t’Ierosa­laime; le hoe ty hitokavañe aze,",{"text":"Iehovà Havantañan-tika.","poem":1}]},{"type":"verse","number":17,"content":["Fa hoe t’Iehovà: Le lia’e tsy haitoañe amy Davide t’indaty miambesatse amy fiambesa’ i anjomba’ Israeleiy;"]},{"type":"verse","number":18,"content":["vaho le lia’e tsy haitoañe amo mpisoroñe nte-Levio t’indaty hanolotse engan-koroañe, naho hañoro enga-mahakama, vaho hisoroñe nainai’e añatrefako eo."]},{"type":"verse","number":19,"content":["Niheo am’ Iirmeà ty tsara’ Iehovà manao ty hoe:"]},{"type":"verse","number":20,"content":[{"text":"Hoe t’Iehovà: Naho lefe’ areo","poem":1},{"lineBreak":true},{"text":"valiheñe ty fañinako amy àndroy,","poem":1},{"lineBreak":true},{"text":"naho ty fañinako amy haleñey,","poem":1},{"lineBreak":true},{"text":"soa te tsy ho aman-kandro,","poem":1},{"lineBreak":true},{"text":"tsy ho aman-kaleñe o famantaña’eo;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"zay vaho mete mivalike amy fañinako amy Davide mpitorokoy,","poem":1},{"lineBreak":true},{"text":"naho tsy hanañ’anake","poem":1},{"lineBreak":true},{"text":"hamelek’ amy fiambesa’ey;","poem":1},{"lineBreak":true},{"text":"vaho amo mpisoroñe nte-Levy mpiatrak’Ahio.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hambañe amy te tsy mete iaheñe","poem":1},{"lineBreak":true},{"text":"ty havasiañan-dikerañe,","poem":1},{"lineBreak":true},{"text":"vaho tsy lefe zehèñe o fasen-driakeo;","poem":1},{"lineBreak":true},{"text":"ty hampitomboako","poem":1},{"lineBreak":true},{"text":"ty tarira’ i Davide mpitorokoy,","poem":1},{"lineBreak":true},{"text":"naho o nte-Levy mpiatrak’ ahio.","poem":1}]},{"type":"verse","number":23,"content":["Niheo am’ Iirmeà ty tsara’ Iehovà manao ty hoe:"]},{"type":"verse","number":24,"content":["Tsy nioni’o hao ty saontsi’ ondaty retoa manao ty hoe: O fifokoañe roe jinobo’ Iehovà rey, le fa naitoa’e? Aa le mavoe’ iereo ondatikoo",{"noteId":126},", t’ie tsy ho fifeheañe añ’atrefa’ iareo ka."]},{"type":"verse","number":25,"content":[{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Naho tsy nifañina ami’ty andro","poem":1},{"lineBreak":true},{"text":"naho ty haleñe,","poem":1},{"lineBreak":true},{"text":"naho tsy tinendreko fañè i likera­ñey","poem":1},{"lineBreak":true},{"text":"naho ty tane toy:","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"le ho farieko ty tiri’ Iakobe","poem":1},{"lineBreak":true},{"text":"naho ty a i Davide mpitorokoy,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho rambeseko amo tiri’eo","poem":1},{"lineBreak":true},{"text":"ty ho mpifeleke o tarira’ i Avrahame, Ietsake, naho Iakobeo;","poem":1},{"lineBreak":true},{"text":"fe toe hampoliko ty fandrohiza’ iareo, vaho hiferenaiñako.","poem":1}]}],"footnotes":[{"noteId":126,"caller":"+","text":"Sab 83:3-4, Iek 28:24-26, 36:2-6","reference":{"chapter":33,"verse":24}}]},"thisChapterLink":"/api/tdx_sle/JER/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/32.json","previousChapterAudioLinks":{},"numberOfVerses":26}