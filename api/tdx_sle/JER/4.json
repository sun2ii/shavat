{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ie mimpoly irehe, ry Israele,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le mimpolia amako,","poem":1},{"lineBreak":true},{"text":"naho asitaho añ’atrefako eo","poem":1},{"lineBreak":true},{"text":"o raha tìva’oo, vaho ko mitroetroe,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"naho ifanta’o ty hoe:","poem":1},{"lineBreak":true},{"text":"Amy te veloñe t’Iehovà!","poem":1},{"lineBreak":true},{"text":"ami’ty fahiti’e naho ty hatò’e","poem":1},{"lineBreak":true},{"text":"naho ty havañonañe,","poem":1},{"lineBreak":true},{"text":"le ie ty hifampitata’ o fifeheañeo","poem":1},{"lineBreak":true},{"text":"vaho hifampirengea’ iareo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà am’ondati’ Iehodào","poem":1},{"lineBreak":true},{"text":"naho am’ Ierosalaime:","poem":1},{"lineBreak":true},{"text":"Trabatrabàho o moka’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho ko mitongy amo fatikeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Misavara ho am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"afaho ty ofoke añ’arofo’ areo ao,","poem":1},{"lineBreak":true},{"text":"ry ondati’ Iehodào naho mpimoneñe","poem":1},{"lineBreak":true},{"text":"e Ierosalaimeo, tsy mone","poem":1},{"lineBreak":true},{"text":"hionjom-beo hoe afo ty habosehako,","poem":1},{"lineBreak":true},{"text":"hisolebatse tsy mete vonoeñe,","poem":1},{"lineBreak":true},{"text":"ami’ty hatsivokara’ o sata’areoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaikaiho e Iehodà ao,","poem":1},{"lineBreak":true},{"text":"naho tseizo e Ierosalaime ao, ty hoe:","poem":1},{"lineBreak":true},{"text":"Popòho amy taney ao ty antsiva;","poem":1},{"lineBreak":true},{"text":"mifanontona,","poem":1},{"lineBreak":true},{"text":"antao himoake amo rova fatratseo!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atroaro mb’e Tsione ty viloñe,","poem":1},{"lineBreak":true},{"text":"mipalira, ko mihenekeneke, fa minday","poem":1},{"lineBreak":true},{"text":"hekoheko boak’ avaratse añe iraho,","poem":1},{"lineBreak":true},{"text":"naho fandrotsahañe jabajaba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa niakatse an-drongoñe ao ty liona,","poem":1},{"lineBreak":true},{"text":"fa nionjoñe i mpandrotsake fifeheañey,","poem":1},{"lineBreak":true},{"text":"fa niavotse an-toe’e ao","poem":1},{"lineBreak":true},{"text":"hampangoakoake ty tane’o,","poem":1},{"lineBreak":true},{"text":"ho harakarake avao o rova’oo,","poem":1},{"lineBreak":true},{"text":"tsy ho amam-pimoneñe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie amy zay, misikina gony, miroveta,","poem":1},{"lineBreak":true},{"text":"vaho mangololoiha: Fa mboe","poem":1},{"lineBreak":true},{"text":"tsy nivike aman-tika ty haviñera’Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amy andro zay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te hilesa ty fahavania’ i mpanjakay","poem":1},{"lineBreak":true},{"text":"naho o roandriañeo;","poem":1},{"lineBreak":true},{"text":"ho latsa o mpisoroñeo vaho","poem":1},{"lineBreak":true},{"text":"ho veren-draha o mpitokio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa le hoe iraho, Ry Talè, Iehovà,","poem":1},{"lineBreak":true},{"text":"akore te nifañahie’o ondaty retoa","poem":1},{"lineBreak":true},{"text":"naho Ierosalaime, amy ty hoe:","poem":1},{"lineBreak":true},{"text":"Hanintsiñe nahareo,","poem":1},{"lineBreak":true},{"text":"ie fa totofem-pibara ty fiaiñe!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie amy zay ho taroñeñe am’ondaty","poem":1},{"lineBreak":true},{"text":"retoa naho am’ Ierosalaime ty hoe:","poem":1},{"lineBreak":true},{"text":"Ho hirik’ ankaboa’ i liolio am-patrambeiy ty tioke mihoboboke","poem":1},{"lineBreak":true},{"text":"mb’amo anak’ ampela’ ondatikoo,","poem":1},{"lineBreak":true},{"text":"tsy t’ie hanonga ndra hañororoke—","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"tioke lombolombo izay ty homb’eo","poem":1},{"lineBreak":true},{"text":"boak’ amako;","poem":1},{"lineBreak":true},{"text":"fa hivolañako zaka henaneo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Heheke! Mionjoñe hoe rahon-dre,","poem":1},{"lineBreak":true},{"text":"o sarete’eo hoe tangololahy;","poem":1},{"lineBreak":true},{"text":"masika ta ty vantio o soavala’eo—","poem":1},{"lineBreak":true},{"text":"feh’ohatse tika! fa mianto!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ry Ierosalaime, sasao añ’arofo’o ao","poem":1},{"lineBreak":true},{"text":"o haloloañeo soa te ho rombaheñe,","poem":1},{"lineBreak":true},{"text":"pak’ombia te mbe himoneñe ama’o","poem":1},{"lineBreak":true},{"text":"ao o fikililia’o ratio?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Inao, mikoike boak’e Dane","poem":1},{"noteId":23},{"text":"añe","poem":1},{"lineBreak":true},{"text":"ty fiarañanañañe; vaho mitsey hankàñe","poem":1},{"lineBreak":true},{"text":"ty boak’ am-bohi’ Efraime añe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Talilio o fifeheañeo, henaneo!","poem":1},{"lineBreak":true},{"text":"ikoiho am’Ierosalaime;","poem":1},{"lineBreak":true},{"text":"hirike tsietoitane añe o mpañarikatokeo","poem":1},{"lineBreak":true},{"text":"hipoña-peo amo rova’ Iehodào.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa niarikoboña’ iareo manahake","poem":1},{"lineBreak":true},{"text":"o mpivoñon-tondao, amy t’ie niola","poem":1},{"lineBreak":true},{"text":"amako, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O sata’oo naho o fitoloña’oo","poem":1},{"lineBreak":true},{"text":"ty naneseañe o raha zao;","poem":1},{"lineBreak":true},{"text":"hankàñe ama’o; akore ty hafai’e!","poem":1},{"lineBreak":true},{"text":"kanao mahatakatse ty arofo’o.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ty añ’ovako, ty añ’ovako!","poem":1},{"lineBreak":true},{"text":"ty haloviloviako!","poem":1},{"lineBreak":true},{"text":"Hete! Ty troko! Ty troko!","poem":1},{"lineBreak":true},{"text":"Midebodebo amako ao;","poem":1},{"lineBreak":true},{"text":"izaho tsy mahafitsiñe;","poem":1},{"lineBreak":true},{"text":"amy te ihe, fiaiko, ty nahatsanoñe","poem":1},{"lineBreak":true},{"text":"i fipopòn’ antsivay, i kaik’ aliy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vinonje’ ty hekoheko ty hankàñe,","poem":1},{"lineBreak":true},{"text":"fonga nimongoreñe i taney;","poem":1},{"lineBreak":true},{"text":"rotsake ami’ty manao zao","poem":1},{"lineBreak":true},{"text":"o kibohokoo,","poem":1},{"lineBreak":true},{"text":"ami’ty tsi-maemae-laletse","poem":1},{"lineBreak":true},{"text":"o rindrin-kivohokoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ampara’ te ombia ty mbe","poem":1},{"lineBreak":true},{"text":"hahatreavako i viloñey,","poem":1},{"lineBreak":true},{"text":"ty hahatsanoñako ty feo i antsivay?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Toe dereñe ondatikoo,","poem":1},{"lineBreak":true},{"text":"tsy mahafohiñe ahy;","poem":1},{"lineBreak":true},{"text":"ajaja minè, tsy mahilala.","poem":1},{"lineBreak":true},{"text":"Kante an-katsivokarañe,","poem":1},{"lineBreak":true},{"text":"ie tsy mahay manao soa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nenteako ty tane toy","poem":1},{"lineBreak":true},{"text":"t'ie nihoake tsy amam-bintañe,","poem":1},{"lineBreak":true},{"text":"vaho mb’ andikeramb’eo","poem":1},{"lineBreak":true},{"text":"fe nipo-kazavàñe ty ey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nenteako o vohitseo le nizoeko","poem":1},{"lineBreak":true},{"text":"te niezeñezeñe,","poem":1},{"lineBreak":true},{"text":"vaho fonga nivembèñe o haboañeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nenteako le hehe t’ie tsy ama’ ondaty,","poem":1},{"lineBreak":true},{"text":"leo raike,","poem":1},{"lineBreak":true},{"text":"vaho hene niborofotse o voron-tiokeo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nenteako,","poem":1},{"lineBreak":true},{"text":"le ingo te paimpaiñe","poem":1},{"lineBreak":true},{"text":"i tane ni-kobokaray,","poem":1},{"lineBreak":true},{"text":"fonga narotsake añatrefa’ Iehovà o rovao,","poem":1},{"lineBreak":true},{"text":"aolo’ ty haviñera’e miforoforo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ho koake iaby i taney","poem":1},{"lineBreak":true},{"text":"fe tsy ho fonga mongoreko.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Handala’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"naho haieñe o likerañe eñeo;","poem":1},{"lineBreak":true},{"text":"ty amo volakoo;","poem":1},{"lineBreak":true},{"text":"naereñereko, le tsy hiheve,","poem":1},{"lineBreak":true},{"text":"vaho tsy hibalihako.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Songa mivoratsake ty lay","poem":1},{"lineBreak":true},{"text":"o rovao ami’ty fikoraha’ o mpiningi-","poem":1},{"lineBreak":true},{"text":"tsoavalao naho o mpitàm-paleo,","poem":1},{"lineBreak":true},{"text":"iziliha’ iareo ty matahetse;","poem":1},{"lineBreak":true},{"text":"anganiha’ iareo o vatovatoeñeo;","poem":1},{"lineBreak":true},{"text":"nengañe hoake iaby o rovao,","poem":1},{"lineBreak":true},{"text":"leo ondaty raike tsy mimoneñe ao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Le ihe tinavañey,","poem":1},{"lineBreak":true},{"text":"Ino ty atao’o kanao","poem":1},{"lineBreak":true},{"text":"misiki-mena mañabasà,","poem":1},{"lineBreak":true},{"text":"naho miravake bange volamena,","poem":1},{"lineBreak":true},{"text":"vaho ampiboenare’o loko o maso’oo?","poem":1},{"lineBreak":true},{"text":"Tsy vente ty ihamina’o vatañe,","poem":1},{"lineBreak":true},{"text":"songa malaiñe azo o sipa’oo,","poem":1},{"lineBreak":true},{"text":"toe hañè-doza ama’o.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Fa nahatsanoñe hoe fikoiahan’ ampela mitsongo iraho,","poem":1},{"lineBreak":true},{"text":"ty fanaintaiña’ i misamake","poem":1},{"lineBreak":true},{"text":"i tañoloñolo’eiy,","poem":1},{"lineBreak":true},{"text":"ty fikoiaha’ ty ana’ i Tsione misehaseha,","poem":1},{"lineBreak":true},{"text":"mañiti-tañampolo manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Hankàñe amako!","poem":1},{"lineBreak":true},{"text":"Mitoirañe añatrefa’ o mpamonoo","poem":1},{"lineBreak":true},{"text":"ty fiaiko!","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Dan: Zaka; ty Mpizaka","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/tdx_sle/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}