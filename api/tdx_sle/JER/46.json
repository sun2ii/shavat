{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":["Niheo am’Iirmeà, mpitoky ty tsara’ Iehovà ty amo fifeheañeo;"]},{"type":"verse","number":2,"content":["ty amy Mitsraime, i mpirai-lian-dahin-defo’ i Parò-Neko",{"noteId":194},"mpanjaka’ i Mitsraimey, ie añolo’ i Saka-Perate",{"noteId":195},"e Karkemise ao, le ginio’ i Nebokadnetsare mpanjaka’ i Bavele, amy taom-paha-efa’ Iehoiakime ana’ Iosià mpanjaka’ Iehodày."]},{"type":"verse","number":3,"content":[{"text":"Ihentseño ty fañeba","poem":1},{"lineBreak":true},{"text":"naho ty fikalan-defo,","poem":1},{"lineBreak":true},{"text":"vaho itotoho i hotakotakey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aombeo laboridy o soavalao,","poem":1},{"lineBreak":true},{"text":"naho miningira, ry mpiningi-tsoavalao;","poem":1},{"lineBreak":true},{"text":"mijohaña eo reketse kalan-doha;","poem":1},{"lineBreak":true},{"text":"fotìo o lefoñeo, aombeo o sarom-bìo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akore t’ie treako hoe","poem":1},{"lineBreak":true},{"text":"lonjetse naho miamboho?","poem":1},{"lineBreak":true},{"text":"Finofok’ ambane o fanalolahi’eo,","poem":1},{"lineBreak":true},{"text":"fa nitriban-day mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy nitolik’ am-boho,","poem":1},{"lineBreak":true},{"text":"fa niarikatoha’ ty firevendreveñañe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy hahafiorotse ty masìka,","poem":1},{"lineBreak":true},{"text":"tsy hahafivoratsake ty fanalolahy;","poem":1},{"lineBreak":true},{"text":"mitsikapy vaho mikorovoke","poem":1},{"lineBreak":true},{"text":"mb’avaratse añe iereo,","poem":1},{"lineBreak":true},{"text":"marine i Saka-Peratey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ia ty hambañ’am’Ieore","poem":1},{"noteId":196},{"text":"mitroatroakey,","poem":1},{"lineBreak":true},{"text":"manahake o saka misorotombake hanginahina’eo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manahake Ieore t’i Mitsraime","poem":1},{"lineBreak":true},{"text":"amy fitabatroaha’ o rano’eoy;","poem":1},{"lineBreak":true},{"text":"ie manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Hitroatse iraho, hanginahina naho","poem":1},{"lineBreak":true},{"text":"hampiopo ty tane toy,","poem":1},{"lineBreak":true},{"text":"toe harotsako i rovay naho","poem":1},{"lineBreak":true},{"text":"o mpimoneñe ama’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mionjona ry soavalao,","poem":1},{"lineBreak":true},{"text":"mionara ry sareteo;","poem":1},{"lineBreak":true},{"text":"ampivavaro mb’etoy o fanalolahio,","poem":1},{"lineBreak":true},{"text":"o nte-Kose naho nte-Pote","poem":1},{"noteId":197},{"lineBreak":true},{"text":"mahafitàm-pikalan-defoñeo,","poem":1},{"lineBreak":true},{"text":"o nte-Lode","poem":1},{"noteId":198},{"text":"mahatañe naho","poem":1},{"lineBreak":true},{"text":"mahafibitsoke faleo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amy te hanañ’ androm-pañondroha’e","poem":1},{"lineBreak":true},{"text":"t’i Talè Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"hamalea’e fate o rafelahi’eo,","poem":1},{"lineBreak":true},{"text":"hampibotsehañe i fibaray","poem":1},{"lineBreak":true},{"text":"ampara’ te etsake","poem":1},{"lineBreak":true},{"text":"naho mamo ami’ty lio’ iareo;","poem":1},{"lineBreak":true},{"text":"fa manao soroñe t’i Talè,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"an-tane avaratse, marine’ i Saka-Peratey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mionjona mb’e Gilade","poem":1},{"noteId":199},{"text":"mb’eo,","poem":1},{"lineBreak":true},{"text":"mitohà fatevo","poem":1},{"noteId":200},{"lineBreak":true},{"text":"ry anak’ ampela’ i Mitsraimeo;","poem":1},{"lineBreak":true},{"text":"fonga tsy jefa’e o aoly anoe’oo,","poem":1},{"lineBreak":true},{"text":"toe tsy eo ty hampijangañe azo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa jinanji’ o kilakila’ ndatio","poem":1},{"lineBreak":true},{"text":"ty fisalara’o,","poem":1},{"lineBreak":true},{"text":"vaho manitsike ty tane toy","poem":1},{"lineBreak":true},{"text":"ty fikoikoiha’o,","poem":1},{"lineBreak":true},{"text":"fa nitsikapy amy maozatsey","poem":1},{"lineBreak":true},{"text":"ty fanalolahy, sindre nihotrake.","poem":1}]},{"type":"verse","number":13,"content":["Ty tsara’ Iehovà am’ Iirmeà mpitoky, te hanao akore ty hionjona’ i Nebokadnetsare mpanjaka’ i Bavele mb’an-tane Mitsraime mb’eo handafa aze?"]},{"type":"verse","number":14,"content":[{"text":"Tseizo’ areo e Mitsraime ao,","poem":1},{"lineBreak":true},{"text":"koiho e Migdole,","poem":1},{"lineBreak":true},{"text":"koiho-lava e Nofe","poem":1},{"lineBreak":true},{"text":"naho e Tafanese, vaho ano ty hoe:","poem":1},{"lineBreak":true},{"text":"Mijohaña vaho mihentseña","poem":1},{"lineBreak":true},{"text":"fa hampibotsek’ añ’ariary azo i fibaray.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Akore te nafaoke añe o maoza’oo?","poem":1},{"lineBreak":true},{"text":"Ie tsy nahafitroatse amy te","poem":1},{"lineBreak":true},{"text":"tinindri’ Iehovà ambane.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Maro ty tsinikapi’e;","poem":1},{"lineBreak":true},{"text":"eka songa mifampikorovoke","poem":1},{"lineBreak":true},{"text":"vaho manao ty hoe :","poem":1},{"lineBreak":true},{"text":"Miongaha, antao himpoly","poem":1},{"lineBreak":true},{"text":"mb’am’ondatin-tika mb’eo,","poem":1},{"lineBreak":true},{"text":"mb’an-tane nahatoly an-tikañe añe,","poem":1},{"lineBreak":true},{"text":"hienga ty fijoia’ i fibaray.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty hoe ty nikoihe’ iereo añe:","poem":1},{"lineBreak":true},{"text":"Koràk’ avao t’i Parò","poem":1},{"lineBreak":true},{"text":"mpanjaka’ i Mitsraime;","poem":1},{"lineBreak":true},{"text":"Napo’e hihelañe añe i ni-fantañañey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kanao velon-dRaho hoe i Mpanjakay,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e,","poem":1},{"lineBreak":true},{"text":"Toe hanahak’ i Tabore","poem":1},{"noteId":201},{"text":"am-bohitsey","poem":1},{"lineBreak":true},{"text":"naho i Karmele","poem":1},{"noteId":202},{"text":"añ’olon-driake añe,","poem":1},{"lineBreak":true},{"text":"Ty higodaña’e mb’etoy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O ry anak’ampela mpimoneñe","poem":1},{"lineBreak":true},{"text":"e Mitsraime ao, mivatia handenà’o","poem":1},{"lineBreak":true},{"text":"mb’am-pandrohizañe añe,","poem":1},{"lineBreak":true},{"text":"fa ho tanàn-taolo ty Nofe,","poem":1},{"lineBreak":true},{"text":"hampangoakoaheñe","poem":1},{"lineBreak":true},{"text":"tsy ho amam-pimoneñe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kiloa fanjaka t’i Mitsraime","poem":1},{"lineBreak":true},{"text":"fe boak’ avaratse añe","poem":1},{"lineBreak":true},{"text":"ty lale-boròñe hamongotse—toe ho avy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Manahake ty sarak’ an-jolok’ ao,","poem":1},{"lineBreak":true},{"text":"o lahin-defo mpikarama añivo’eo,","poem":1},{"lineBreak":true},{"text":"fa nivalike ka iereo;","poem":1},{"lineBreak":true},{"text":"niharo nibotatsake,","poem":1},{"lineBreak":true},{"text":"tsy nahafijohañe,","poem":1},{"lineBreak":true},{"text":"fa tondroke ty andron-kankà’ iareo,","poem":1},{"lineBreak":true},{"text":"ty androm-pitilihañe iareo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe mereñe ty fikosasaha’e","poem":1},{"lineBreak":true},{"text":"ie misoroke o lahindefo’eo,","poem":1},{"lineBreak":true},{"text":"mikovovoke mb’am-pisorohañ’aze","poem":1},{"lineBreak":true},{"text":"o lahindefoñeo, ie mitoañ’ aze","poem":1},{"lineBreak":true},{"text":"am-pekoñe hoe mpañatsak’ ala.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hinatsa’ iareo i alay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa tsy lefe volilieñe;","poem":1},{"lineBreak":true},{"text":"amy t’ie maro te amo valalao,","poem":1},{"lineBreak":true},{"text":"mitozantozañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nisalareñe ty anak’ ampela’","poem":1},{"lineBreak":true},{"text":"i Mitsraime;","poem":1},{"lineBreak":true},{"text":"fa natolotse am-pità’ ondaty","poem":1},{"lineBreak":true},{"text":"avaratse añe.","poem":1}]},{"type":"verse","number":25,"content":["Hoe t’Iehovà’ i Màroy, t’i Andria­nañahare’ Israrele, Ho liloveko t’i Amone nte-No",{"noteId":203},"naho i Parò, naho i Mitsraime, rekets’ o ‘ndrahare’eo, naho o mpanjaka’eo; toe i Parò naho ze miato ama’e."]},{"type":"verse","number":26,"content":["Hatoloko am-pità’ o mipay ty fiai’eo naho am-pità’ i Nebokadnetsare mpanjaka’ i Bavele naho am-pità’ o mpitoro’eo; ie añe, le ho fimoneñañe indraike re manahake te taolo, hoe t’Iehovà."]},{"type":"verse","number":27,"content":[{"text":"Aa le ko hemban-drehe","poem":1},{"lineBreak":true},{"text":"ry Iakobe mpitoroko,","poem":1},{"lineBreak":true},{"text":"naho ko lonjetse ry Israele;","poem":1},{"lineBreak":true},{"text":"fa ho rombaheko boake tsietoitane añe, naho ty tiri’o","poem":1},{"lineBreak":true},{"text":"an-tanem-pandrohiza’ iareo;","poem":1},{"lineBreak":true},{"text":"himpoly t’Iakobe, naho hierañerañe,","poem":1},{"lineBreak":true},{"text":"le tsy eo ty hañembañe aze ka.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ko hemban-drehe ry Iakobe mpitoroko, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa mpiama’o iraho;","poem":1},{"lineBreak":true},{"text":"ho fonga mongoreko o fifeheañe","poem":1},{"lineBreak":true},{"text":"nandroahako azoo,","poem":1},{"lineBreak":true},{"text":"f’ihe tsy ho mongoreko;","poem":1},{"lineBreak":true},{"text":"ho liloveko an-jaka-to,","poem":1},{"lineBreak":true},{"text":"fe tsy hapoko tsy ho liloveñe","poem":1},{"noteId":204},{"text":".","poem":1}]}],"footnotes":[{"noteId":194,"caller":"+","text":"Neko: Kepeke; gioke","reference":{"chapter":46,"verse":2}},{"noteId":195,"caller":"+","text":"Perate : (Heb) misorotombake","reference":{"chapter":46,"verse":2}},{"noteId":196,"caller":"+","text":"Ieore : I Niley Egipte, saka mikararake","reference":{"chapter":46,"verse":7}},{"noteId":197,"caller":"+","text":"Pote: Fale; ana’ i Kame; ondaty Afrika","reference":{"chapter":46,"verse":9}},{"noteId":198,"caller":"+","text":"Lode: Antara","reference":{"chapter":46,"verse":9}},{"noteId":199,"caller":"+","text":"Gilade: Taroñe mivotry; Talily mibokoke","reference":{"chapter":46,"verse":11}},{"noteId":200,"caller":"+","text":"Heg; Tsoriy","reference":{"chapter":46,"verse":11}},{"noteId":201,"caller":"+","text":"Tabore: joboñe; mikanitsoke; vonotroboe","reference":{"chapter":46,"verse":18}},{"noteId":202,"caller":"+","text":"Karmele: añondry vosy; tsako vokatse","reference":{"chapter":46,"verse":18}},{"noteId":203,"caller":"+","text":"No: mangaro; mandrara","reference":{"chapter":46,"verse":25}},{"noteId":204,"caller":"+","text":"Oni: Iir 30:11","reference":{"chapter":46,"verse":28}}]},"thisChapterLink":"/api/tdx_sle/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}