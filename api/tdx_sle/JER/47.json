1},{"lineBreak":true},{"text":"ty fitrakotrako’ o sareteo,","poem":1},{"lineBreak":true},{"text":"ty kodoikodoi’ o larò’eo","poem":1},{"lineBreak":true},{"text":"le tsy mitolike mb’an-keleia’e","poem":1},{"lineBreak":true},{"text":"o roae’eo, ie mavozo am-pitàñe;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa tondroke ty andro te fonga","poem":1},{"lineBreak":true},{"text":"hampiantoañe o nte-Pilistio,","poem":1},{"lineBreak":true},{"text":"ie hañitoa’e amy Tsore naho amy","poem":1},{"lineBreak":true},{"text":"Tsidone ze mpañolotse sisa;","poem":1},{"lineBreak":true},{"text":"amy te ho kopahe’ Iehovà o nte-Pilistio,","poem":1},{"lineBreak":true},{"text":"naho ze sehanga’e an-tokonose’","poem":1},{"lineBreak":true},{"text":"i Kaftore","poem":1},{"noteId":206},{"text":".","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hasolàñe ty nifetsak’ amy Azà;","poem":1},{"lineBreak":true},{"text":"fa naitoañe ty Askelone.","poem":1},{"lineBreak":true},{"text":"Ry honka’ i vavatane’ iereoy:","poem":1},{"lineBreak":true},{"text":"ampara’ te ‘mbia ty handilindilia’o","poem":1},{"lineBreak":true},{"text":"ty sandri’o?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O ry fibara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ampara’ te ombia vaho hitsiñe?","poem":1},{"lineBreak":true},{"text":"miombea an-traño’o ao,","poem":1},{"lineBreak":true},{"text":"mitofà, naho mihendrea.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Akore ty hitofa’e kanao nandily t’Iehovà ?","poem":1},{"lineBreak":true},{"text":"i Askelone naho i olon-driakey","poem":1},{"lineBreak":true},{"text":"ty nitendrea’e.","poem":1}]}],"footnotes":[{"noteId":205,"caller":"+","text":"Aza: fatratse","reference":{"chapter":47,"verse":1}},{"noteId":206,"caller":"+","text":"Kaftore: Halañe: tokonose bontolie","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/JER/47.json","t