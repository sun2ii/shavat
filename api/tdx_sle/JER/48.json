{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"Ty amy Moabe","poem":1},{"noteId":207},{"text":",","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele:","poem":1},{"lineBreak":true},{"text":"hankàñe amy Nebo","poem":1},{"noteId":208},{"text":"! fa peake,","poem":1},{"lineBreak":true},{"text":"nisalareñe t’i Kiriataime","poem":1},{"noteId":209},{"text":"fa tsinepake;","poem":1},{"lineBreak":true},{"text":"nimeñareñe ty Misgabe","poem":1},{"noteId":210},{"lineBreak":true},{"text":"vaho mioremeñe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy eo ka ty enge’ i Moabe;","poem":1},{"lineBreak":true},{"text":"nikinia raty aze o e Kesboneo","poem":1},{"noteId":211},{"text":":","poem":1},{"lineBreak":true},{"text":"Antao hampipitsok’aze tsy ho fifeheañe,","poem":1},{"lineBreak":true},{"text":"hampitsiñeñe ka irehe, Medmene","poem":1},{"noteId":212},{"text":",","poem":1},{"lineBreak":true},{"text":"hañoridañ’azo i fibaray.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Inao ty koike boak’e Koronaime","poem":1},{"noteId":213},{"lineBreak":true},{"text":"fikopahañe naho fandrotsaham-bey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rotsake t’i Moabe,","poem":1},{"lineBreak":true},{"text":"nipoñafe’ o keleia’eo ty koiake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hitolom-pirovetse iereo te hanganike","poem":1},{"lineBreak":true},{"text":"ty fitroara’ i Lokote","poem":1},{"noteId":214},{"lineBreak":true},{"text":"ami’ty fizotsoa’ i Koronaime","poem":1},{"lineBreak":true},{"text":"ty nahajanjiña’ iareo","poem":1},{"lineBreak":true},{"text":"ty fikaiham-pandrotsahañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitribaha, handrombaha’ areo fiaiñe,","poem":1},{"lineBreak":true},{"text":"mihambaña ami’ty kile","poem":1},{"lineBreak":true},{"text":"an-dratraratra añe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho tsepaheñe ka nahareo ami’ty","poem":1},{"lineBreak":true},{"text":"fiatoa’ areo amo tolon-draha’ areoo,","poem":1},{"lineBreak":true},{"text":"naho amo vara’ areoo;","poem":1},{"lineBreak":true},{"text":"hasese am-pandrohizañe añe ty Kemise","poem":1},{"noteId":215},{"text":",","poem":1},{"lineBreak":true},{"text":"o mpisoro’eo rekets’ o roandria’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Songa hiambotraha’ i mpitavañey","poem":1},{"lineBreak":true},{"text":"o rovao, ndra rova raike tsy hahavoratsake;","poem":1},{"lineBreak":true},{"text":"ho momoke i vavataney,","poem":1},{"lineBreak":true},{"text":"hampiantoeñe i montoñey,","poem":1},{"lineBreak":true},{"text":"ami’ty saontsi’ Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toloro elatse t’i Moabe, hiborifita’e,","poem":1},{"lineBreak":true},{"text":"fa hampangoakoaheñe o rova’eo,","poem":1},{"lineBreak":true},{"text":"ie tsy ho amam-pimoneñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hozoñeñe t’indaty mitoloñe","poem":1},{"lineBreak":true},{"text":"ho a’ Iehovà am-pitañe milesa,","poem":1},{"lineBreak":true},{"text":"hafàtse ty mitañe i fibara’ey","poem":1},{"lineBreak":true},{"text":"tsy ho aman-dio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa nierañerañe sikal’ am-pahajalahy","poem":1},{"lineBreak":true},{"text":"aze t’i Moabe,","poem":1},{"lineBreak":true},{"text":"naho fa nitadrètse amo karafo’eo,","poem":1},{"lineBreak":true},{"text":"tsy nañiliñañe an-jonjoñ’an-jonjoñe,","poem":1},{"lineBreak":true},{"text":"vaho le lia’e tsy nasese","poem":1},{"lineBreak":true},{"text":"am-pandrohizañe añe;","poem":1},{"lineBreak":true},{"text":"aa le mbe ama’e ty hafira’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy niova ty harifondrifo’e.","poem":1}]},{"type":"verse","number":12,"content":["Aa le, ingo ho tondroke ty andro, hoe t’Iehovà, te hampañitrifeko ama’e ty mpañiliñe, ze hañiliñe aze; ho fonga kapaihe’ iareo o fitovi’eo, vaho ho foie’ iereo o zonjò’eo."]},{"type":"verse","number":13,"content":["Ho salatse amy Kemose t’i Moabe, manahake ty nisalara’ Israele amy Betele",{"noteId":216},"fatokisa’ iareoy."]},{"type":"verse","number":14,"content":[{"text":"Akore te anoe’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Ondaty maozatse zahay,","poem":1},{"lineBreak":true},{"text":"fanalolahy añ’aly’?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mianto t’i Moabe, fa nionjoñe","poem":1},{"lineBreak":true},{"text":"mb’amo rova’eo, fa nizotso","poem":1},{"lineBreak":true},{"text":"mb’am-pizamanam-b’eo o ajalahy jinobo’eo,","poem":1},{"lineBreak":true},{"text":"hoe t’i Mpanjaka,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa antitotse ty hekoheko’ i Moabe,","poem":1},{"lineBreak":true},{"text":"malisa i feh-oha’ey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mandalà aze ry mañohok’ azeo,","poem":1},{"lineBreak":true},{"text":"ano ty hoe ama’e ry mahafohiñe","poem":1},{"lineBreak":true},{"text":"i tahina’ey:","poem":1},{"lineBreak":true},{"text":"Akore te pinozake i kobaiñe","poem":1},{"lineBreak":true},{"text":"maozatsey, i doda fanjakay.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O ry anak’ampela mimoneñe","poem":1},{"lineBreak":true},{"text":"e Dibone","poem":1},{"noteId":217},{"text":"ao,","poem":1},{"lineBreak":true},{"text":"mizotsoa amo enge’oo,","poem":1},{"lineBreak":true},{"text":"mitoboha an-kataliñiera’o eo,","poem":1},{"lineBreak":true},{"text":"fa nionjomb’ama’o mb’eo","poem":1},{"lineBreak":true},{"text":"ty mampikoromake i Moabe,","poem":1},{"lineBreak":true},{"text":"fa songa narotsa’e o rova’o fatratseo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O ry mpimone’ i Arore","poem":1},{"noteId":218},{"text":",","poem":1},{"lineBreak":true},{"text":"mijohaña amy lalañey, vaho mijilova;","poem":1},{"lineBreak":true},{"text":"añontaneo i mioratsey, ty hoe:","poem":1},{"lineBreak":true},{"text":"Inom-bao o nifetsakeo?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nisalareñe t’i Moabe, le mioremeñe;","poem":1},{"lineBreak":true},{"text":"mangololoiha vaho mikoiha;","poem":1},{"lineBreak":true},{"text":"tseizo e Arnone","poem":1},{"noteId":219},{"text":"ao te mianto t’i Moabe.","poem":1}]},{"type":"verse","number":21,"content":["Fa niambotraha’ ty zaka o tane amontoñeo, t’i Kolone",{"noteId":220},", Iatsà",{"noteId":221},", vaho i Mefaate",{"noteId":222},","]},{"type":"verse","number":22,"content":["Le i Dibone",{"noteId":223},", i Nebo",{"noteId":224},", naho i Bet’diblataime",{"noteId":225},"."]},{"type":"verse","number":23,"content":["Le i Kiriataime",{"noteId":226},"naho i Bet’gamole",{"noteId":227},"vaho i Bet’meone.",{"noteId":228}]},{"type":"verse","number":24,"content":["Le i Keriote",{"noteId":229},"naho i Botsrà",{"noteId":230},"vaho o hene rova an-tane’ i Moabeo, o lavi­tseo naho o marìneo."]},{"type":"verse","number":25,"content":["Fa nipi­tsok’ añe ty tsifa’ i Moabe, pinozake i sira’ey, hoe t’Iehovà."]},{"type":"verse","number":26,"content":["Ampimamò, amy te nampi­ebore’e am’ Iehovà ty vata’e; fa hitorokosek’ amy loa’ey t’i Moabe, vaho ho rabioñeñe."]},{"type":"verse","number":27,"content":["Aa tsy nandrabioña’o hao t’Israele? Nizoeñe amo malasoo hao? amy te mikofi-doha ama’e irehe ndra ‘mbiambia isaontsia’o."]},{"type":"verse","number":28,"content":[{"text":"O ry mpimoneñe e Moabe ao,","poem":1},{"lineBreak":true},{"text":"Miavota amo rovao naho mimoneña an-tseran-kereretsake ao, vaho mihambaña ami’ty deho manao traño añ’ilam-bava’ i koboñey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Fa jinanji’ay ty firengevoha’","poem":1},{"lineBreak":true},{"text":"i Moabey;","poem":1},{"lineBreak":true},{"text":"toe mpitoabotse, amy fibohaboha’ey,","poem":1},{"lineBreak":true},{"text":"naho ty fiengeña’e","poem":1},{"lineBreak":true},{"text":"vaho ty fitrotroabohan’arofo’e.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Haiko o habose’eo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, t’ie kafoake,","poem":1},{"lineBreak":true},{"text":"tsy naha-pi-draha o fikoiboha’eo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aa le hangoihoiako ty Moabe;","poem":1},{"lineBreak":true},{"text":"eka hikoiako ty halifora’ i Moabe;","poem":1},{"lineBreak":true},{"text":"hihontofa’ ty troko o nte-Kir’kereseo","poem":1},{"noteId":231},{"text":".","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Mandikoatse ty firoveta’ Iazere","poem":1},{"noteId":232},{"lineBreak":true},{"text":"ty hitañiako azo, ry vahe’ i Sibmà","poem":1},{"noteId":233},{"text":";","poem":1},{"lineBreak":true},{"text":"nikazazake nahafitsake i riakey","poem":1},{"lineBreak":true},{"text":"o tsampa’oo,","poem":1},{"lineBreak":true},{"text":"nitakare’ iareo ty ria’ Iazere;","poem":1},{"lineBreak":true},{"text":"amo voa’ o asarao,","poem":1},{"lineBreak":true},{"text":"naho amo vahe’oo ty niambotraha’","poem":1},{"lineBreak":true},{"text":"i mpandrotsakey.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tinavañe amy tonda kobokaray","poem":1},{"lineBreak":true},{"text":"ty hafaleañe naho ty firebehañe,","poem":1},{"lineBreak":true},{"text":"vaho an-tane’ Moabe;","poem":1},{"lineBreak":true},{"text":"fa najiheko tsy hiboak’ amo","poem":1},{"lineBreak":true},{"text":"fipiritañeo ty divay;","poem":1},{"lineBreak":true},{"text":"tsy eo ty handialia aze an-koike,","poem":1},{"lineBreak":true},{"text":"tsy ho fifandian-taroba i korakey.","poem":1}]},{"type":"verse","number":34,"content":["Boak’ ami’ty fikoiha’ i Kesbone",{"noteId":234},"pak’e Eleale",{"noteId":235},", sikal’am’ Iazere ty nikaiha’ ty fiarañanaña’ iareo; boak’e Tsoare",{"noteId":236},"pak’e Koronaime, hoe tamanañe telo taoñe; fa ho kòake ka ty Rano’ i Nimrime",{"noteId":237},"."]},{"type":"verse","number":35,"content":["Mbore hajiheko amy Moabe, hoe t’Iehovà, ty mañenga amo haboañeo, naho i mañemboke aman-drahare’ey."]},{"type":"verse","number":36,"content":["Aa le mangolalaike ho a i Moabe manahake o solio ty foko vaho mandala hoe firirio ho a ondati’ i Kir’kereseo ty troko; fa mongotse ty vara natonto’e."]},{"type":"verse","number":37,"content":["Fonga peake o añamboneo, songa hinaratse o tateahetseo; sindre linily o fitañeo vaho gony ty sikin-tohake."]},{"type":"verse","number":38,"content":["Tsitsik’ ambone’ tafo’ i Moabe naho mandrambañ’ an-tameañe ey, le firovetañe avao ty ao; fa finoiko hoe karabiba tsy rei-tave t’i Moabe, hoe t’Iehovà."]},{"type":"verse","number":39,"content":["Akore ty fivolentsa’e, mangololoiha! Akore te niamboho t’i Mobe! salatse re! Aa le ho fiankahafañe naho fiantoañe avao t’i Moabe amo mañohok’ azeo."]},{"type":"verse","number":40,"content":["Fa hoe ty nafè’ Iehovà:",{"text":"Ingo te eo ty hitiliñe hoe vantio,","poem":1},{"lineBreak":true},{"text":"havela’e amy Moabe o ela’eo.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Fa tinavañe o rovao,","poem":1},{"lineBreak":true},{"text":"tsinepake o fipalirañe maozatseo,","poem":1},{"lineBreak":true},{"text":"le hanahake ty tron’ ampela mitsongo","poem":1},{"lineBreak":true},{"text":"ty arofo’ o fanalolahi’ i Moabeo","poem":1},{"lineBreak":true},{"text":"amy andro zay.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Le haitoañe tsy ho karaza’ ondaty","poem":1},{"lineBreak":true},{"text":"t’i Moabe, amy t’ie nirengevok’ amy Iehovà.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Firevendreveñañe naho i koboñey,","poem":1},{"lineBreak":true},{"text":"vaho i fandrikey ty ho ama’o,","poem":1},{"lineBreak":true},{"text":"ry mpimoneñe e Moabe ao,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Hikapotrak’ an-koboñe ao ty mibotatsak’ amy mampihebakebakey,","poem":1},{"lineBreak":true},{"text":"naho ho tsepahe’ ty fandrike ty mahafiakatse amy koboñey;","poem":1},{"lineBreak":true},{"text":"fa hafetsako ama’e, eka, amy Moabe,","poem":1},{"lineBreak":true},{"text":"ty taom-pitilihañe iareo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Mijagarodoñe tsy an-kaozarañe an-kàlo’ i Kesbone ao o nipoliotseo,","poem":1},{"lineBreak":true},{"text":"fa nionjoñe boake Kesbone ty afo,","poem":1},{"lineBreak":true},{"text":"naho boak’ añivo’ i Sihone","poem":1},{"noteId":238},{"text":"ao ty lel’afo,","poem":1},{"lineBreak":true},{"text":"ze namorototo ty lahara’ i Moabe,","poem":1},{"lineBreak":true},{"text":"vaho ty hevo’ o mpikoràkeo.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Hankàñe ama’o ry Moabe!","poem":1},{"lineBreak":true},{"text":"Fa mibalake ondati’ i Kemoseo","poem":1},{"noteId":239},{"text":",","poem":1},{"lineBreak":true},{"text":"amy te nasese mb’an-drohy mb’eo","poem":1},{"lineBreak":true},{"text":"o ana-dahi’eo","poem":1},{"lineBreak":true},{"text":"naho mb’am-bahoram-b’eo","poem":1},{"lineBreak":true},{"text":"o anak’ampela’eo.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Fe hafoteko amo andro honka’eo ty fandrohiza’ i Moabe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Izay ty figadoñam-pizakañe i Moabe.","poem":1}]}],"footnotes":[{"noteId":207,"caller":"+","text":"Moabe: boak’ aman-drae’e; Ana’ i Lote","reference":{"chapter":48,"verse":1}},{"noteId":208,"caller":"+","text":"Nebo: vohitse e Moabe ao;","reference":{"chapter":48,"verse":1}},{"noteId":209,"caller":"+","text":"Kiriataime: rova hambañe","reference":{"chapter":48,"verse":1}},{"noteId":210,"caller":"+","text":"Misgabe; fipalirañe an-tiotiotse ey","reference":{"chapter":48,"verse":1}},{"noteId":211,"caller":"+","text":"Kesbone: mikitroke","reference":{"chapter":48,"verse":2}},{"noteId":212,"caller":"+","text":"Medmene: votrin-ditsake","reference":{"chapter":48,"verse":2}},{"noteId":213,"caller":"+","text":"Koronaime: rova amandakato roe, boseke","reference":{"chapter":48,"verse":3}},{"noteId":214,"caller":"+","text":"Lokote: nanoeñe gorodoñe","reference":{"chapter":48,"verse":5}},{"noteId":215,"caller":"+","text":"Kemise: Mpampireke; tale’ i Moabe","reference":{"chapter":48,"verse":7}},{"noteId":216,"caller":"+","text":"Betele: Akiban’Añahare","reference":{"chapter":48,"verse":13}},{"noteId":217,"caller":"+","text":"Dibone: minike","reference":{"chapter":48,"verse":18}},{"noteId":218,"caller":"+","text":"Arore: liolio, ndra kile","reference":{"chapter":48,"verse":19}},{"noteId":219,"caller":"+","text":"Arnone: torahañe misorotombake","reference":{"chapter":48,"verse":20}},{"noteId":220,"caller":"+","text":"Kolone: hontoke, lafenete","reference":{"chapter":48,"verse":21}},{"noteId":221,"caller":"+","text":"Iatsà: lie-drokoñe","reference":{"chapter":48,"verse":21}},{"noteId":222,"caller":"+","text":"Mefaate: mañazava","reference":{"chapter":48,"verse":21}},{"noteId":223,"caller":"+","text":"Dibone: lifo-kilala","reference":{"chapter":48,"verse":22}},{"noteId":224,"caller":"+","text":"Nebo: mpitsara, mpitoky","reference":{"chapter":48,"verse":22}},{"noteId":225,"caller":"+","text":"Bet’diblataime: akiba mofon-tsakoa roe","reference":{"chapter":48,"verse":22}},{"noteId":226,"caller":"+","text":"Kiriataime: rova hambañe","reference":{"chapter":48,"verse":23}},{"noteId":227,"caller":"+","text":"Bet’gamole: akiba’ ty nisara-nono","reference":{"chapter":48,"verse":23}},{"noteId":228,"caller":"+","text":"Bet’meone: akiba fimoneña’ (i Baale)","reference":{"chapter":48,"verse":23}},{"noteId":229,"caller":"+","text":"Keriote: anjomba maro","reference":{"chapter":48,"verse":24}},{"noteId":230,"caller":"+","text":"Botsrà: an-kasotriañe","reference":{"chapter":48,"verse":24}},{"noteId":231,"caller":"+","text":"Kir’kerese: rovam-balañe tane","reference":{"chapter":48,"verse":31}},{"noteId":232,"caller":"+","text":"Iazere: mpañimba","reference":{"chapter":48,"verse":32}},{"noteId":233,"caller":"+","text":"Sibmà: mibalintoa, tsinepake","reference":{"chapter":48,"verse":32}},{"noteId":234,"caller":"+","text":"Kesbone: fifanehafañe, fahimbañañe","reference":{"chapter":48,"verse":34}},{"noteId":235,"caller":"+","text":"Eleale: aonjoñañe aman’Añahare","reference":{"chapter":48,"verse":34}},{"noteId":236,"caller":"+","text":"Tsoare: kedeke","reference":{"chapter":48,"verse":34}},{"noteId":237,"caller":"+","text":"Nimrime: mafaitse, fiolàñe","reference":{"chapter":48,"verse":34}},{"noteId":238,"caller":"+","text":"Sihone: mikorake, troatroake, rakaraka","reference":{"chapter":48,"verse":45}},{"noteId":239,"caller":"+","text":"Kemose: mampiambane","reference":{"chapter":48,"verse":46}}]},"thisChapterLink":"/api/tdx_sle/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}