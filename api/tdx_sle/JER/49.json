{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":["Ty amo nte-Amoneo.",{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Tsy amañ’ana-dahy hao t’Israele?","poem":1},{"lineBreak":true},{"text":"Tsy amam-pandova hao re?","poem":1},{"lineBreak":true},{"text":"Inoñ’ arè ty itavana’ i Meleke","poem":1},{"noteId":240},{"text":"i Gade?","poem":1},{"lineBreak":true},{"text":"naho ty imoneña’ ondati’eo","poem":1},{"lineBreak":true},{"text":"an-drova’ iareo ao?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aa le ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te hampijanjiñeko koin’aly","poem":1},{"lineBreak":true},{"text":"e Rabà","poem":1},{"noteId":241},{"text":"’ o ana’ i Amoneo","poem":1},{"noteId":242},{"text":";","poem":1},{"lineBreak":true},{"text":"ie ho votre mangoakoake","poem":1},{"lineBreak":true},{"text":"le ho hotomomoheñe añ’afo","poem":1},{"lineBreak":true},{"text":"o anak’ ampela’eo;","poem":1},{"lineBreak":true},{"text":"naho hapitso’ Israele","poem":1},{"lineBreak":true},{"text":"o nampipitsok’ azeo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mangoihoia ry Kesbone,","poem":1},{"lineBreak":true},{"text":"fa rotsake t’i Aia","poem":1},{"noteId":243},{"text":";","poem":1},{"lineBreak":true},{"text":"mikoeakoeaha ry anak’ ampela’ i Rabà,","poem":1},{"lineBreak":true},{"text":"misikina gony, mandalà,","poem":1},{"lineBreak":true},{"text":"miheloheloa amo goloboñeo,","poem":1},{"lineBreak":true},{"text":"fa homb’am-pandrohizañe añe","poem":1},{"lineBreak":true},{"text":"t’i Meleke,","poem":1},{"lineBreak":true},{"text":"o mpisoro’eo rekets’ o roandria’eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ino ty irengea’o am-bavatane ao,","poem":1},{"lineBreak":true},{"text":"i vavatane’o mitsiritsiokey,","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela midisa-volio?","poem":1},{"lineBreak":true},{"text":"Ihe miato vara, manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ia ty haname ahy?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inao, hampangebahebak’azo iraho,","poem":1},{"lineBreak":true},{"text":"hoe t’i Talè, Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"boak’ amo mañohok’ azo iabio;","poem":1},{"lineBreak":true},{"text":"naho songa haronje’ ty roake mb’eo,","poem":1},{"lineBreak":true},{"text":"tsy eo ty hanontoñe ty mibaratsake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa ie añe, le hampoliko boak’ an-drohy añe o ana’ i Amoneo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ty amy Edome; hoe ’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Fa kapaike hao ty hihitse e Temane","poem":1},{"noteId":244},{"text":"ao?","poem":1},{"lineBreak":true},{"text":"Fa mongotse hao ty veren-tsoa’","poem":1},{"lineBreak":true},{"text":"o maharendrekeo?","poem":1},{"lineBreak":true},{"text":"Fa nilosotse am’ iareo hao ty hilala?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miridaridà, mibalintoà, mitoboha","poem":1},{"lineBreak":true},{"text":"an-dalek’ ao, ry mpimone’ i Dedaneo","poem":1},{"noteId":245},{"text":";","poem":1},{"lineBreak":true},{"text":"fa hapoko ama’e ty feh’oha’ i Esave","poem":1},{"noteId":246},{"text":",","poem":1},{"lineBreak":true},{"text":"ty andro andilovako aze.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa naho nimb’ama’o mb’eo","poem":1},{"lineBreak":true},{"text":"ty mpanontoñe valoboke,","poem":1},{"lineBreak":true},{"text":"tsy ho nisisà’ iareo hao","poem":1},{"lineBreak":true},{"text":"ty ho tsindroheñe?","poem":1},{"lineBreak":true},{"text":"Naho ty malaso an-kaleñe,","poem":1},{"lineBreak":true},{"text":"tsy ho namaok’ am-para’ te nieneñe?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"F’ie finaopaoko t’i Esave, nampikorendaheko o fikafira’eo,","poem":1},{"lineBreak":true},{"text":"le tsy ho lefe’e ty hietake;","poem":1},{"lineBreak":true},{"text":"fa tinavañe o tiri’eo,","poem":1},{"lineBreak":true},{"text":"songa tsy eo o rolongo’eo,","poem":1},{"lineBreak":true},{"text":"naho o rañe’eo, vaho i vata’ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fario o anam-bode-rae’oo,","poem":1},{"lineBreak":true},{"text":"fa ho velomeko;","poem":1},{"lineBreak":true},{"text":"naho angao hiato amako o ramavoi’oo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ingo, ndra te tsy tinendre","poem":1},{"lineBreak":true},{"text":"hinoñe amy fitoviy ty ila’e,","poem":1},{"lineBreak":true},{"text":"toe hinoñe ama’e avao;","poem":1},{"lineBreak":true},{"text":"aa le tsy ho lilovañe ka v’iheo?","poem":1},{"lineBreak":true},{"text":"Tsy hapoke tsy ho lilovan-drehe,","poem":1},{"lineBreak":true},{"text":"toe tsy mahay tsy hinoñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa nifanta ami’ty vatako iraho,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te ho hadabàñe ty Botsrà","poem":1},{"noteId":247},{"text":",","poem":1},{"lineBreak":true},{"text":"fañinjeañe, ratraratra, naho fatse;","poem":1},{"lineBreak":true},{"text":"vaho ho koake nainai’e donia o rova’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa nahatsanon-talily boak’am’ Iehovà iraho, fa nampihitrifeñe amo kilakila’ ondatio ty minday ty hoe:","poem":1},{"lineBreak":true},{"text":"Mifanontona, mionjona haname aze,","poem":1},{"lineBreak":true},{"text":"vaho miongaha mb’an-kotakotake mb’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Inao, hafotsako ho kedekedeke","poem":1},{"lineBreak":true},{"text":"amo fifeheañeo irehe,","poem":1},{"lineBreak":true},{"text":"naho ho fañamavoa’ ondatio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa namañahy azo ty fangebaheba’o:","poem":1},{"lineBreak":true},{"text":"ty firengevohan’ arofo’o,","poem":1},{"lineBreak":true},{"text":"ihe mpimoneñe an-tseratseram-bato ao, mitobok’ an-kaboañe ey;","poem":1},{"lineBreak":true},{"text":"aa ndra te nanoe’o antiotiotse ey,","poem":1},{"lineBreak":true},{"text":"mira ami’ty vantio ty akiba’o,","poem":1},{"lineBreak":true},{"text":"mbe hampizotsoeko boak’ey,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ho liolio kòake t’i Edome,","poem":1},{"lineBreak":true},{"text":"hene ho latsa ze mioza ama’e,","poem":1},{"lineBreak":true},{"text":"hikosìk’ amo hekoheko nizoe’eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hanahake ty fandrotsahañe","poem":1},{"lineBreak":true},{"text":"i Sedome","poem":1},{"noteId":248},{"text":"naho i Amorà","poem":1},{"noteId":249},{"text":"naho","poem":1},{"lineBreak":true},{"text":"o rova nañohoke iareoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy himoneña’ ondaty,","poem":1},{"lineBreak":true},{"text":"tsy hañialoa’ ty ana’ondaty.","poem":1}]},{"type":"verse","number":19,"content":["Ingo hionjoñe hanahake ty liona boak’an-drongoñe matahetse añ’olo’ Iordaney mb’an-goloboñe soa fahetse mb’eo; fa hampitribaheko an-day boak’ ama’e amy zao, vaho ho tendrèko hifehe aze ze nijoboñeñe; fa ia ty hambañ’ amako? Ia ty haneseke ahy? Vaho ia ty mpiarake hahafijohañe hiatrek’ ahiko?"]},{"type":"verse","number":20,"content":["Aa le inao ty safiri’ Iehovà, ty nisafirie’e i Edome; naho ty ereñere naereñere’e amo mpimone’ i Temaneo; toe ho kozozote’e añe ndra o kede amy lia-raikeio, vata’e hampangoakoahe’e am’iereo o fiandraza’ iareoo."]},{"type":"verse","number":21,"content":["Man­ginikinike ty tane ami’ty fikodoim-pikorovoha’ iareo; inay ty koeake, janjiñe an-dRiake Mena añe ty feo’e."]},{"type":"verse","number":22,"content":["Ingo t’ie hionjoñe mb’eo naho hitsikefañe hoe vantio vaho havela’e amy Botsrà o ela’eo; le hanahake ty fidebom-pon-drakemba mitsongo ty arofo’ o fanalolahi’ i Edomeo amy andro zay."]},{"type":"verse","number":23,"content":[{"text":"I Damesèke:","poem":1},{"noteId":250},{"text":"Angoae ty Kamate","poem":1},{"noteId":251},{"text":"naho i Arpade","poem":1},{"noteId":252},{"text":";","poem":1},{"lineBreak":true},{"text":"ty amy talili-raty jinanji’ iareo,","poem":1},{"lineBreak":true},{"text":"ie tranahe’ ty hebakebake,","poem":1},{"lineBreak":true},{"text":"mitroñe i riakey tsy mete pendreñeñe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Niforetrake t’i Damesèke,","poem":1},{"lineBreak":true},{"text":"nitolike re hivoratsake,","poem":1},{"lineBreak":true},{"text":"fe manjitse aze ty fineveneverà’e;","poem":1},{"lineBreak":true},{"text":"fioremeñañe naho teveteveke","poem":1},{"lineBreak":true},{"text":"ty mamihiñe aze,","poem":1},{"lineBreak":true},{"text":"manahake ty ampela mitsongo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Akore te hangoakoake","poem":1},{"lineBreak":true},{"text":"i rova nirengèñey,","poem":1},{"lineBreak":true},{"text":"i rova nahafale ahiy?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aa le hikorovok’ an-tameañe ey","poem":1},{"lineBreak":true},{"text":"o ajalahi’eo,","poem":1},{"lineBreak":true},{"text":"vaho fonga hampianjiñeñe amy andro zay","poem":1},{"lineBreak":true},{"text":"o lahin-defoñeo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hamiañako afo ty kijoli’ i Damesèke,","poem":1},{"lineBreak":true},{"text":"hampibotseke o anjomba’","poem":1},{"lineBreak":true},{"text":"i Ben-hadadeo","poem":1},{"noteId":253},{"text":".","poem":1}]},{"type":"verse","number":28,"content":["Ty amy Kedare",{"noteId":254},"naho or fifehea’ i Katsore",{"noteId":255},"linafa’ i Nebokadnetsare mpanjaka’ i Baveleo, hoe t’Iehovà;",{"text":"Miongaha, mionjona mb’e Kedare,","poem":1},{"lineBreak":true},{"text":"vaho korendaho o anan-tatiñanañeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ho kopahe’ iereo ty kivoho","poem":1},{"lineBreak":true},{"text":"naho o lia-rai’ iareoo,","poem":1},{"lineBreak":true},{"text":"ho tavane’ iareo ho am-bata’e","poem":1},{"lineBreak":true},{"text":"o lamban-temetseo, naho o vara’ iareoo, naho o rameva’ iareoo;","poem":1},{"lineBreak":true},{"text":"vaho ho koraheñe ama’iareo, ty hoe, Hankàñe mb’etia mb’eroa!","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Miorata añe, miherereaha!","poem":1},{"lineBreak":true},{"text":"mañialoa an-dalek’ ao,","poem":1},{"lineBreak":true},{"text":"ry mpimoneñe e Katsore ao,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fa nisafirie’ i Nebokadnetsare mpanjaka’ i Bavele,","poem":1},{"lineBreak":true},{"text":"vaho naereñere’e talin-dia.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Miongaha, mionjona mb’amy fifeheañe mierañerañey, i miaiñañoleñañey;","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"I tsy aman-kijoly, tsy aman-tsikadañey;","poem":1},{"lineBreak":true},{"text":"mpimoneñe am-bangiñe.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Hakopake o rameva’ iareoo,","poem":1},{"lineBreak":true},{"text":"ho tongañe o añombe’ iareo mitozantozañeo; vaho hampiparatsiaheko","poem":1},{"lineBreak":true},{"text":"mb’amo tioke iabio","poem":1},{"lineBreak":true},{"text":"o mihitsike ty am-bala’eo,","poem":1},{"lineBreak":true},{"text":"haseseko hankàñe boak’an -dafi’e iaby, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ho poakorom-panaloke ty Katsore, hoakoake nainai’e kitro-katroke,","poem":1},{"lineBreak":true},{"text":"ie ho po-pimoneñe,","poem":1},{"lineBreak":true},{"text":"ndra ty ana’ ondaty tsy hañialo ao.","poem":1}]},{"type":"verse","number":34,"content":["Ty tsara’ Iehovà niheo am’ Iirmeà mpitoky ty amy Elame ami’ty fifotoram-pifehea’ i Tsidkia’ mpanjaka’ Iehodà, manao ty hoe:"]},{"type":"verse","number":35,"content":["Hoe t’Iehovà’ i Màroy;",{"text":"Inao! ho pekañeko ty fale’ i Elame,","poem":1},{"lineBreak":true},{"text":"ty fiaolon-kaozara’ iareo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Le hatreatrèko amy Elame i tiok’efatse boak’ an-kotsok’ efa’ i likerañey rey,","poem":1},{"lineBreak":true},{"text":"naho hampiparaitaheko","poem":1},{"lineBreak":true},{"text":"mb’amy tioke rey iereo;","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty fifeheañe tsy higodañe’","poem":1},{"lineBreak":true},{"text":"o naronje boak’ Elameo.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Le hampiroreheko añatrefa’ o rafelahi’eo t’i Elame,","poem":1},{"lineBreak":true},{"text":"naho aolo’ o mipay ty fiai’iareoo;","poem":1},{"lineBreak":true},{"text":"naho hametsahako hankàñe,","poem":1},{"lineBreak":true},{"text":"naho ty haboseko miforoforo;","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"vaho hañitrifako fibara hañoridañe iareo ampara’ te mongotse;","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"le hapoko Elame ao ty fiambesako","poem":1},{"lineBreak":true},{"text":"vaho ho rotsaheko boak’ao","poem":1},{"lineBreak":true},{"text":"ze mpanjaka ndra roandriañe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Fe ho tondrok’ amo andro honka’eo te hampoliko o ­nasese hirik’ i Elame,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":240,"caller":"+","text":"Meleke: mpanjaka","reference":{"chapter":49,"verse":1}},{"noteId":241,"caller":"+","text":"Rabà: maozatse, ra’elahy, mirengetse","reference":{"chapter":49,"verse":2}},{"noteId":242,"caller":"+","text":"Amone: tariratse; toe tarira’ i Lote","reference":{"chapter":49,"verse":2}},{"noteId":243,"caller":"+","text":"Aia: votre","reference":{"chapter":49,"verse":3}},{"noteId":244,"caller":"+","text":"Temane: atimo, Afrika; fonitse","reference":{"chapter":49,"verse":7}},{"noteId":245,"caller":"+","text":"Dedane: o araña’eo; firañetañe; mpizaka","reference":{"chapter":49,"verse":8}},{"noteId":246,"caller":"+","text":"Esave: ty manao, ty mamonitse","reference":{"chapter":49,"verse":8}},{"noteId":247,"caller":"+","text":"Botsrà: toe-kasotriañe, fijalea","reference":{"chapter":49,"verse":13}},{"noteId":248,"caller":"+","text":"Sedome: sodotse, forototo","reference":{"chapter":49,"verse":18}},{"noteId":249,"caller":"+","text":"Amorà: mpiola","reference":{"chapter":49,"verse":18}},{"noteId":250,"caller":"+","text":"Damesèke: haroñe pea-dio hoe mirehetse","reference":{"chapter":49,"verse":23}},{"noteId":251,"caller":"+","text":"Kamate: habosehañe; miforoforo; rindry","reference":{"chapter":49,"verse":23}},{"noteId":252,"caller":"+","text":"Arpade: hazava’ ty fijebañañe","reference":{"chapter":49,"verse":23}},{"noteId":253,"caller":"+","text":"Ben-Hadad: Ana’ Korake; Hafalea","reference":{"chapter":49,"verse":27}},{"noteId":254,"caller":"+","text":"Kedare: ieñe, embetse","reference":{"chapter":49,"verse":28}},{"noteId":255,"caller":"+","text":"Katsore: kiririsa, ahe-maike","reference":{"chapter":49,"verse":28}}]},"thisChapterLink":"/api/tdx_sle/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}