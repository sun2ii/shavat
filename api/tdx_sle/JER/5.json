{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Mikariokarioha amo lala’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"mijilojilova vaho mahaoniña!","poem":1},{"lineBreak":true},{"text":"Tsikaraho o kiririsa’eo","poem":1},{"lineBreak":true},{"text":"ke hahaisake ondaty","poem":1},{"lineBreak":true},{"text":"manao ty hahiti’e, mipay ty hatò—","poem":1},{"lineBreak":true},{"text":"le hiheveako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndra te manao ty hoe,","poem":1},{"lineBreak":true},{"text":"Amy te veloñe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"manao fanta vilañe re.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ry Iehovà, tsy mitsoeke ty hatò","poem":1},{"lineBreak":true},{"text":"hao o fihaino’oo?","poem":1},{"lineBreak":true},{"text":"Linafa’o iereo f’ie tsy nalorè;","poem":1},{"lineBreak":true},{"text":"nimongore’o fe tsy mete avohotse;","poem":1},{"lineBreak":true},{"text":"nanoe’ iareo gañe ta ty vato","poem":1},{"lineBreak":true},{"text":"o tarehe’ iareoo;","poem":1},{"lineBreak":true},{"text":"mifoneñe tsy hisoloho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le hoe iraho, rarake avao iereo, gege;","poem":1},{"lineBreak":true},{"text":"tsy fohi’ iareo ty lala’ Iehovà,","poem":1},{"lineBreak":true},{"text":"o lilin’ Andrianañahare’ iareoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Homb’amo roandriañeo arè iraho,","poem":1},{"lineBreak":true},{"text":"tsy mete tsy rendre’ iereo","poem":1},{"lineBreak":true},{"text":"o sata’ Iehovào,","poem":1},{"lineBreak":true},{"text":"o lilin’ Andrianañahare’ iareoo.","poem":1},{"lineBreak":true},{"text":"F’ie songa nampipozake i jokay,","poem":1},{"lineBreak":true},{"text":"nandrafarafake o talirandrañeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toly ndra hampibaibay iareo","poem":1},{"lineBreak":true},{"text":"o liona boak’ añ’alao,","poem":1},{"lineBreak":true},{"text":"hanjaman’ iareo ty maràmbolo","poem":1},{"lineBreak":true},{"text":"boak’ an-dratraratra ao.","poem":1},{"lineBreak":true},{"text":"Mijilojilo o rova’eo ty farasi-lahi’e;","poem":1},{"lineBreak":true},{"text":"ie mandrimidrimitse ze miakatse","poem":1},{"lineBreak":true},{"text":"—amy ty hamaro’ o fiolà’ iareoo,","poem":1},{"lineBreak":true},{"text":"fa losotse ty fidisa-voli’ iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa vaho akore ty hiheveako azo?","poem":1},{"lineBreak":true},{"text":"Fa nieng’ahy o ana’oo","poem":1},{"lineBreak":true},{"text":"naho nifanta amo ndrahare tsie’eo;","poem":1},{"lineBreak":true},{"text":"ie nampianjañeko,","poem":1},{"lineBreak":true},{"text":"le nañarapilo, vaho nikovovoke","poem":1},{"lineBreak":true},{"text":"mb’añ’ akiban-tsimiriram-beo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Soavala lahi’e mpilelalela iereo, songa mitreñe amy tañanjomban-drañe’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho lafaeko hao? Hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"tsy hondroheko hao","poem":1},{"lineBreak":true},{"text":"ty fifeheañe manahake zao?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Soroho o tondam-bahe’eo le fongoro,","poem":1},{"lineBreak":true},{"text":"fe anisao;","poem":1},{"lineBreak":true},{"text":"holiro o tsampa’eo amy te tsy a’ Iehovà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe songa nitsambolitiok’ ahy","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Israele","poem":1},{"lineBreak":true},{"text":"naho ty anjomba’ Iehodà, hoe t’Iehovà;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"nanoe’e entam-bande t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Tsy Ie;","poem":1},{"lineBreak":true},{"text":"tsy hiambotraha’ ty raty tika,","poem":1},{"lineBreak":true},{"text":"vaho tsy hizò fibara ndra kerè.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kafoake avao o mpitokio,","poem":1},{"lineBreak":true},{"text":"tsy am’ iareo i tsaray;","poem":1},{"lineBreak":true},{"text":"aa le zay ty hanoañe iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ i màroy:","poem":1},{"lineBreak":true},{"text":"Kanao sinao’ areo i entañe zay,","poem":1},{"lineBreak":true},{"text":"le hanoeko afo am-palie’o ao o volakoo,","poem":1},{"lineBreak":true},{"text":"naho hatae ondaty retoañe,","poem":1},{"lineBreak":true},{"text":"hamorototoeko iareo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hampiambotraheko ama’o ty","poem":1},{"lineBreak":true},{"text":"fifeheañe boake tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"ry anjomba’ Israele, hoe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Fifeheañe lava havelo, fifelehañe haehae,","poem":1},{"lineBreak":true},{"text":"tane aman-tsaontsy tsy fohi’o,","poem":1},{"lineBreak":true},{"text":"vaho tsy hapota’o ze taroñe’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hoe kibory misokake","poem":1},{"lineBreak":true},{"text":"ty trañon-ana-pale’ iareo,","poem":1},{"lineBreak":true},{"text":"songa fanalolahy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Habotse’ iareo ty nivokare’o","poem":1},{"lineBreak":true},{"text":"naho ty mahakama’o;","poem":1},{"lineBreak":true},{"text":"hagedra’ iareo o ana-dahi’oo","poem":1},{"lineBreak":true},{"text":"naho o anak’ampela’oo;","poem":1},{"lineBreak":true},{"text":"ho kamae’ iareo o lia-rai’oo","poem":1},{"lineBreak":true},{"text":"naho o mpirai-tro’oo:","poem":1},{"lineBreak":true},{"text":"ho genohe’ iareo o vahe’oo","poem":1},{"lineBreak":true},{"text":"naho o sakoa’oo;","poem":1},{"lineBreak":true},{"text":"ho demohe’ iareo am-pibara","poem":1},{"lineBreak":true},{"text":"o rova fatratse iatoa’oo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa ndra amy andro rezay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy ho fonga mongoreko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa ie manao ty hoe iereo:","poem":1},{"lineBreak":true},{"text":"Ino ty nanoe’Iehovà Andrianañahare-tika","poem":1},{"lineBreak":true},{"text":"amantika i hene raha zay?","poem":1},{"lineBreak":true},{"text":"le hoe ty havale’o:","poem":1},{"lineBreak":true},{"text":"Hambañ’amy namorintseña’ areo Ahiy, naho nitoroñe","poem":1},{"lineBreak":true},{"text":"‘ndrahare ila’e an-tane’ areo ao,","poem":1},{"lineBreak":true},{"text":"t’ie hitoroñe ambahiny","poem":1},{"lineBreak":true},{"text":"an-tane tsy anahareo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Koiho añ’anjomba’ Iakobe naho tseizo e Iehodà ao ty hoe:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Janjiño zao ry ondaty gege,","poem":1},{"lineBreak":true},{"text":"tsy mahilalao;","poem":1},{"lineBreak":true},{"text":"amam-pihaino fe tsy mahaoniñe,","poem":1},{"lineBreak":true},{"text":"aman-dravembia f’ie tsy mahajanjiñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy mañeveñe amako hao nahareo?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"Tsy mihondrahondra añatrefako etoa","poem":1},{"lineBreak":true},{"text":"hao nahareo?","poem":1},{"lineBreak":true},{"text":"Napoko ho fañefetse amy riakey","poem":1},{"lineBreak":true},{"text":"i faseñey,","poem":1},{"lineBreak":true},{"text":"ho sebañe nainai’e tsy hisorohañe;","poem":1},{"lineBreak":true},{"text":"aa ndra te mitoabotse o onja’eo","poem":1},{"lineBreak":true},{"text":"tsy hahafitroatse,","poem":1},{"lineBreak":true},{"text":"ndra te mitroñe tsy haha-fitsaka aze.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"F’ie manjehatse naho miola","poem":1},{"lineBreak":true},{"text":"ty arofo’ondaty retoa,","poem":1},{"lineBreak":true},{"text":"miveve vaho mienga.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tsy anoe’ iereo añ’arofo ao ty hoe:","poem":1},{"lineBreak":true},{"text":"Antao hañeveñe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañaharentika,","poem":1},{"lineBreak":true},{"text":"ie mampahavy orañe an-tsa’e,","poem":1},{"lineBreak":true},{"text":"i orañ’asotriy naho i oram-panjakay","poem":1},{"lineBreak":true},{"text":"vaho tana’e ho antika","poem":1},{"lineBreak":true},{"text":"o hereñandro namantañeñe ho","poem":1},{"lineBreak":true},{"text":"fitatahañeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa nampihake irezay o hakeo’oo,","poem":1},{"lineBreak":true},{"text":"le nampisitake ty hasoa ama’o o tahi’oo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Toe zoeñe am’ondatikoo o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"mijilo hoe mpitsepa-boroñe","poem":1},{"lineBreak":true},{"text":"le mikopete; mampibitsoke ­fandri-bo; mamandrike ondaty.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Manahake ty kipa pea voroñe,","poem":1},{"lineBreak":true},{"text":"o kivoho’ iareo lipo-kiniao;","poem":1},{"lineBreak":true},{"text":"aa le nitoabotse ty enge","poem":1},{"lineBreak":true},{"text":"naho ty vara’ iareo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Vondrake naho sometsetse,","poem":1},{"lineBreak":true},{"text":"mitombo am-pikitrohan-draty,","poem":1},{"lineBreak":true},{"text":"tsy zakae’ iereo ami’ty hatò","poem":1},{"lineBreak":true},{"text":"ty enta’ i bodey hampiraorao aze,","poem":1},{"lineBreak":true},{"text":"vaho tsy arova’ iareo ty zo’ o rarakeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tsy ho liloveko hao iereo? hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy ho valeko fate hao","poem":1},{"lineBreak":true},{"text":"ty fifeheañe manahake itone?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Raha mahavereñe naho haloloañe","poem":1},{"lineBreak":true},{"text":"ty nifetsake amy taney:","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"mitoky vilañe o mpitokio,","poem":1},{"lineBreak":true},{"text":"vaho mañorike o mpitokio","poem":1},{"lineBreak":true},{"text":"ty fifehea’ o mpisoroñeo;","poem":1},{"lineBreak":true},{"text":"izay ty tea’ ondatikoo,","poem":1},{"lineBreak":true},{"text":"fa ino ty hanoe’areo am-pigadoña’e?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}