{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":["Ty entañe nitsarae’ Iehovà ty amy Bavele, tane’ o nte-Kasdioy, añam’ Iirmeà mpitoky."]},{"type":"verse","number":2,"content":[{"text":"Taroño amo kilakila’ ndatio, tseizo;","poem":1},{"lineBreak":true},{"text":"añonjono vorovoro, koiho","poem":1},{"lineBreak":true},{"text":"vaho ko ampikafireñe ty hoe:","poem":1},{"lineBreak":true},{"text":"Tinavañe ty Bavele, salatse t’i Bele","poem":1},{"noteId":256},{"text":",","poem":1},{"lineBreak":true},{"text":"lonjetse ty Merodake","poem":1},{"noteId":257},{"text":";","poem":1},{"lineBreak":true},{"text":"songa nampisalareñe","poem":1},{"lineBreak":true},{"text":"o saren-drahare’eo,","poem":1},{"lineBreak":true},{"text":"dinemoke o hazomanga’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amy te boak’ avaratse añe","poem":1},{"lineBreak":true},{"text":"ty fifeheañe haname aze,","poem":1},{"lineBreak":true},{"text":"ty hampangoakoake i tane’ey,","poem":1},{"lineBreak":true},{"text":"ampara t’ie tsy amam-pimoneñe;","poem":1},{"lineBreak":true},{"text":"fonga nañariok’ añe","poem":1},{"lineBreak":true},{"text":"ndra ondaty ndra hare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy andro zay, naho amy sa zay,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le homb’ atoy o ana’ Israeleo,","poem":1},{"lineBreak":true},{"text":"ie naho o ana’ Iehodao,","poem":1},{"lineBreak":true},{"text":"hangololoike ty rovetse te mañavelo, vaho ho tsoehe’ iereo t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ iareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hañontanea’ iareo ty lalañe","poem":1},{"lineBreak":true},{"text":"mb’e Tsione mb’eo,","poem":1},{"lineBreak":true},{"text":"naho hampiatrefe’iareo laharañe;","poem":1},{"lineBreak":true},{"text":"Homb’eo iereo hireketse am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ami’ty fañina tsy modo nainai’e,","poem":1},{"lineBreak":true},{"text":"tsy ho haliño.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa añondry motso ondatikoo; nampandrifihe’ o mpiara’ iareoo;","poem":1},{"lineBreak":true},{"text":"nampidadà’ iereo amo haboañeo;","poem":1},{"lineBreak":true},{"text":"nirererere am-bohitse pak’ an-kaboañe, nandikofa’ iareo ty fitofà’ iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fonga nampibotseke iareo","poem":1},{"lineBreak":true},{"text":"ze nifanendrek’ ama’e;","poem":1},{"lineBreak":true},{"text":"le nanao ty hoe o malaiñ’ iareoo:","poem":1},{"lineBreak":true},{"text":"Tsy aman-kakeo zahay;","poem":1},{"lineBreak":true},{"text":"amy t’ie ro nandilatse","poem":1},{"lineBreak":true},{"text":"am’ Iehovà, fimoneñan-kavantañañey,","poem":1},{"lineBreak":true},{"text":"am’ Iehovà fitaman-droae’iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miridriha boake Bavele ao,","poem":1},{"lineBreak":true},{"text":"naho iakaro ty tane o nte-Kasdio","poem":1},{"noteId":258},{"text":", vaho itsikombeo ty oselahy","poem":1},{"lineBreak":true},{"text":"miaolo’ i lia-rai’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Inao! ho troboeko","poem":1},{"lineBreak":true},{"text":"hionjoñe hiatrek’ i Bavele","poem":1},{"lineBreak":true},{"text":"ty firimboñam-pifeheañe ra’elahy","poem":1},{"lineBreak":true},{"text":"boak’ an-tane avaratse añe;","poem":1},{"lineBreak":true},{"text":"miriritse ama’e iereo,","poem":1},{"lineBreak":true},{"text":"le ho tavaneñe amy zao;","poem":1},{"lineBreak":true},{"text":"hanahake o amy fanalolahy mahimbañeo","poem":1},{"lineBreak":true},{"text":"o anam-pale’iareoo,","poem":1},{"lineBreak":true},{"text":"tsy ama’e ty himpoly mañomaño;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho kopaheñe t’i Kasdy;","poem":1},{"lineBreak":true},{"text":"hahaeneñe ze hene mamaok’ ama’e;","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ty hafalea’areo,","poem":1},{"lineBreak":true},{"text":"naho ty firebeha’areo:","poem":1},{"lineBreak":true},{"text":"ry mpampikopake i lovakoio,","poem":1},{"lineBreak":true},{"text":"ty fitrekoa’areo le","poem":1},{"lineBreak":true},{"text":"hoe tamana añ’ahetse,","poem":1},{"lineBreak":true},{"text":"vaho misehaseha hoe soavala mirefe;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hangirifiry ty fisalaran-drene’o,","poem":1},{"lineBreak":true},{"text":"ho meñatse i nahatoly azoy;","poem":1},{"lineBreak":true},{"text":"ho tsitso’ o fifeheañeo, fatram-bey,","poem":1},{"lineBreak":true},{"text":"tane karakankaiñe vaho liolio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ami’ty haviñera’ Iehovà","poem":1},{"lineBreak":true},{"text":"le tsy himoneñañe,","poem":1},{"lineBreak":true},{"text":"fa ho vata’e bangìñe;","poem":1},{"lineBreak":true},{"text":"ho latsa iaby ze miary amy Bavele,","poem":1},{"lineBreak":true},{"text":"hikosàke amo hekoheko’e iabio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ampiririto hialy amy Bavele","poem":1},{"lineBreak":true},{"text":"añ’ariari’e eo ry mahatam-paleo,","poem":1},{"lineBreak":true},{"text":"ahiririño, ko manisa ana-pale;","poem":1},{"lineBreak":true},{"text":"amy te anaña’ Iehovà tahiñe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mirohafa añ’arikatoke aze,","poem":1},{"lineBreak":true},{"text":"fa miambane re;","poem":1},{"lineBreak":true},{"text":"mihotrake o faha’eo,","poem":1},{"lineBreak":true},{"text":"rebake o kijoli’eo;","poem":1},{"lineBreak":true},{"text":"izay ty fañondroha’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Mamalea fate! hambañe amy nanoe’ey","poem":1},{"lineBreak":true},{"text":"ty hanoañe ama’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aitò amy Bavele ty mpandrarake,","poem":1},{"lineBreak":true},{"text":"naho i mpita-meso am-pitatahañey,","poem":1},{"lineBreak":true},{"text":"ie ihembaña’e ty fibaram-panindry,","poem":1},{"lineBreak":true},{"text":"songa hitolike mb’am’ondati’eo,","poem":1},{"lineBreak":true},{"text":"sindre handripake mb’an-tane’e mb’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Añondry miparaitake t’Israele,","poem":1},{"lineBreak":true},{"text":"niroahe’ o lionao añe;","poem":1},{"lineBreak":true},{"text":"Ty valoha’e nampibotsek’ aze,","poem":1},{"lineBreak":true},{"text":"i mpanjaka’ i Asorey","poem":1},{"lineBreak":true},{"text":"naho ami’ty figado’e toy","poem":1},{"lineBreak":true},{"text":"t’i Nebokadnetsare mpanjaka’ i Bavele","poem":1},{"lineBreak":true},{"text":"ro nampipekañe o taola’eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele:","poem":1},{"lineBreak":true},{"text":"Inao! ho liloveko ty mpanjaka’ i Bavele","poem":1},{"lineBreak":true},{"text":"naho i tane’ey,","poem":1},{"lineBreak":true},{"text":"manahake ty nandilovako","poem":1},{"lineBreak":true},{"text":"i mpanjaka’ i Asorey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Le hampoliko mb’am-piandraza’e mb’eo t’Israele,","poem":1},{"lineBreak":true},{"text":"hihinañe e Karmele naho e Basane ao,","poem":1},{"lineBreak":true},{"text":"vaho hahaeneñe ty tro’e","poem":1},{"lineBreak":true},{"text":"ty an-kaboa’ i Efraime naho i Gilade.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amy andro rezay naho amy sa zay,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ho kodebèñe ty hakeo’ Israele fe tsy ho eo, naho ty tahi’ Iehodà, fa tsy hahaoniñe;","poem":1},{"lineBreak":true},{"text":"amy te ho hahàko ty hakeo’","poem":1},{"lineBreak":true},{"text":"o napoko ho sehanga’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mionjona mb’an-tane’ Merataime","poem":1},{"noteId":259},{"text":",","poem":1},{"lineBreak":true},{"text":"atreatréo,","poem":1},{"lineBreak":true},{"text":"naho o mpimoneñe e Pekodeo","poem":1},{"noteId":260},{"text":",","poem":1},{"lineBreak":true},{"text":"mongoro,","poem":1},{"lineBreak":true},{"text":"vata’e rotsaho, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ano iaby o nandiliako azoo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Inao, ty hotakotak’ amy taney,","poem":1},{"lineBreak":true},{"text":"naho ty fandrotsaham-bey.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Akore te finira naho pinozake","poem":1},{"lineBreak":true},{"text":"ty ana-bato’ ty tane toy!","poem":1},{"lineBreak":true},{"text":"Akore te nampangoakoaheñe","poem":1},{"lineBreak":true},{"text":"añivo’ o fifeheañeo ty Bavele!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie nandaharako fandrike,","poem":1},{"lineBreak":true},{"text":"toe tsinepake ka, ry Bavele,","poem":1},{"lineBreak":true},{"text":"fe tsy napota’o;","poem":1},{"lineBreak":true},{"text":"nivazohoen-drehe vaho nitratse,","poem":1},{"lineBreak":true},{"text":"amy te ihe nifangatotse am’ Iehovà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa sinoka’ Iehovà ty fañaja’e,","poem":1},{"lineBreak":true},{"text":"vaho nakare’e o fialian-kaviñera’eo;","poem":1},{"lineBreak":true},{"text":"ty fitoloñañe tsy mete tsy anoe’ i Talè, Iehovà, an-tane o nte-Kasdio.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Itameo boak’an-tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"sokafo o riha’eo,","poem":1},{"lineBreak":true},{"text":"atontono mañambone kivo­tre kivotre, vaho rotsaho; ko anisa’o ndra inoñe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fonga lentao o vosi’eo,","poem":1},{"lineBreak":true},{"text":"ampizotsò mb’am-panjamanañe ao;","poem":1},{"lineBreak":true},{"text":"feh’ ohatse ama’e !","poem":1},{"lineBreak":true},{"text":"fa tondroke ty andro’ iareo,","poem":1},{"lineBreak":true},{"text":"ty androm-pandilovañe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Inay! ty feom-pipiliotse naho o nandrifitse boak’an-tane Baveleo, hitsey e Tsione ao ty fañondroha’ Iehovà Andrianañaharentika,","poem":1},{"lineBreak":true},{"text":"i vale-fate’e ty amy anjomba’eiy.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Koiho hifanontone hiatreke i Bavele","poem":1},{"lineBreak":true},{"text":"o mpitàm-paleo, o mampibitsoke fale iabio; mitobea añ’arikatoke aze;","poem":1},{"lineBreak":true},{"text":"ko ado’ areo te ho eo ty hiborofotse;","poem":1},{"lineBreak":true},{"text":"ondroho ty amo sata’eo,","poem":1},{"lineBreak":true},{"text":"avaleo ama’e o fonga fitoloña’eo,","poem":1},{"lineBreak":true},{"text":"fa nirengevohe’e t’Iehovà,","poem":1},{"lineBreak":true},{"text":"i Masi’ Israeley.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aa le hikorovok’ an-tameañe eo","poem":1},{"lineBreak":true},{"text":"o ajalahi’eo,","poem":1},{"lineBreak":true},{"text":"songa hampianjiñeñe amy andro zay","poem":1},{"lineBreak":true},{"text":"o lahin-defo’eo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Inao! miatre azo raho","poem":1},{"lineBreak":true},{"text":"ty mpitoabotse tia,","poem":1},{"lineBreak":true},{"text":"hoe t’i Talè, Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"fa tondroke ty andro’o,","poem":1},{"lineBreak":true},{"text":"ty namotoañako handilo azo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Hitsikapy naho hikorovoke","poem":1},{"lineBreak":true},{"text":"i loho mpiroharohay,","poem":1},{"lineBreak":true},{"text":"tsy ho amam-pañongake;","poem":1},{"lineBreak":true},{"text":"le ho viañeko afo o rova’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho forototoe’e o faripari’e iabio.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"naharo forekekeñe o ana’ Israeleo","poem":1},{"lineBreak":true},{"text":"naho o nte-Iehodao;","poem":1},{"lineBreak":true},{"text":"fa tinambozò’ o nitsepak’ iareo,","poem":1},{"lineBreak":true},{"text":"nifoneña’ iareo tsy hamotsots’ iareo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Maozatse ty Mpijeba’ iareo,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e,","poem":1},{"lineBreak":true},{"text":"ho henefa’e ty fisalala’ iareo,","poem":1},{"lineBreak":true},{"text":"hampitofa’e i taney,","poem":1},{"lineBreak":true},{"text":"vaho ho troboe’e o mpimone’ i Baveleo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"hoe t’Iehovà","poem":1},{"lineBreak":true},{"text":"Hebae’ ty fibara o nte-Kasdio,","poem":1},{"lineBreak":true},{"text":"naho o mpimone’ i Baveleo,","poem":1},{"lineBreak":true},{"text":"naho o roandria’eo,","poem":1},{"lineBreak":true},{"text":"vaho o mahihi’eo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ohare’ ty fibara o mpandañitseo,","poem":1},{"lineBreak":true},{"text":"hampidagolàñe iareo;","poem":1},{"lineBreak":true},{"text":"Hebaem-bi-lava o fanalolahio,","poem":1},{"lineBreak":true},{"text":"hampidemòhañe iareo.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ho amo soavala’ iareoo ty fibara,","poem":1},{"lineBreak":true},{"text":"naho amo sarete’eo,","poem":1},{"lineBreak":true},{"text":"naho amo ambahiny iaby añivo’ iareoo,","poem":1},{"lineBreak":true},{"text":"fa hanahake ty rakemba iereo;","poem":1},{"lineBreak":true},{"text":"amo vara’eo ty meso-lava,","poem":1},{"lineBreak":true},{"text":"vaho ho voloseñe.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Hafaosa amo rano’eo, fa ho riteñe,","poem":1},{"lineBreak":true},{"text":"amy t’ie tanen-tsamposampon-draha,","poem":1},{"lineBreak":true},{"text":"vaho renge’ iareo o irevendreveña’ iareoo.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Aa le hitrao-pitobok’ ao","poem":1},{"lineBreak":true},{"text":"ty fosa naho ty farasy,","poem":1},{"lineBreak":true},{"text":"hiantraño ao ka o voron-tsatrañeo;","poem":1},{"lineBreak":true},{"text":"le tsy ho fimoneñañe kitro-katroke,","poem":1},{"lineBreak":true},{"text":"tsy hañialoañe mb’an-tariratse","poem":1},{"lineBreak":true},{"text":"an-tamingañe.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Ho hambañe amy nandrotsahan’ Añahare i Sedome naho i Amorà","poem":1},{"lineBreak":true},{"text":"vaho o mañohoke iareoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"tsy himoneña’ ondaty,","poem":1},{"lineBreak":true},{"text":"tsy hañialoa’ ty ana’ ondaty.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Inao! hitotsake boak’ avaratse añe ondatio, fifeheañe jabajaba naho mpanjaka maro","poem":1},{"lineBreak":true},{"text":"ty ho troboeñe boak’an-tsietoitane añe.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Vontitire’ iereo ty fale naho ty lefoñe, mpampisoañe tsy miferenaiñe;","poem":1},{"lineBreak":true},{"text":"mitroñe hoe i riakey ty feo’ iareo,","poem":1},{"lineBreak":true},{"text":"mijon-tsoavala;","poem":1},{"lineBreak":true},{"text":"miriritse hoe ondaty hihotakotake,","poem":1},{"lineBreak":true},{"text":"ama’o ry anak’ ampela’ i Bavele.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Fa jinanji’ ty mpanjaka’ i Bavele","poem":1},{"lineBreak":true},{"text":"ty talily iareo,","poem":1},{"lineBreak":true},{"text":"vaho migebañe o fità’eo;","poem":1},{"lineBreak":true},{"text":"namihiñ’aze ty halonjerañe,","poem":1},{"lineBreak":true},{"text":"ty fanaintaiñan-ampela mitsongo.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Inao! eo ty hionjoñe hoe liona boak’amo rongo-matahe’ Iordaneo","poem":1},{"lineBreak":true},{"text":"mb’an-goloboñe mifahetse mb’eo;","poem":1},{"lineBreak":true},{"text":"f’ie ho roaheko amy zao,","poem":1},{"lineBreak":true},{"text":"vaho ho tendrèko hamehe aze ze joboñeko; fa ia ty rahambako?","poem":1},{"lineBreak":true},{"text":"Ia ty hamotoañ’ andro ho ahy?","poem":1},{"lineBreak":true},{"text":"Le ia ty mpiarake hahafiatrek’ ahiko?","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Aa le mahajanjiña ty safiri’ Iehovà nisafirie’e i Bavele,","poem":1},{"lineBreak":true},{"text":"naho ty ereñere niereñere’e","poem":1},{"lineBreak":true},{"text":"i tane’ o nte-Kasdioy;","poem":1},{"lineBreak":true},{"text":"toe ho kozozote’e mb’eo","poem":1},{"lineBreak":true},{"text":"ndra ty kede amy lia-rai’ey, hampangoakoahe’e ty am’iereo i fiandraza’ iareoy.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Hampirihindrihie’ i Taney ty koike","poem":1},{"lineBreak":true},{"text":"manao ty hoe: Fa rinambe ty Bavele;","poem":1},{"lineBreak":true},{"text":"vaho ho janjiñeñe amo fifeheañeo","poem":1},{"lineBreak":true},{"text":"ty fikoaihañe.","poem":1}]}],"footnotes":[{"noteId":256,"caller":"+","text":"Bel: ndra Baale: ‘ndrahare’ i Bavele","reference":{"chapter":50,"verse":2}},{"noteId":257,"caller":"+","text":"Merodake: Fisolohoañe mafaitse","reference":{"chapter":50,"verse":2}},{"noteId":258,"caller":"+","text":"Iir 51:6, 45, Isa 48:20, 2Kor 6:17 Ben 18:4","reference":{"chapter":50,"verse":8}},{"noteId":259,"caller":"+","text":"Merataime: indroe niola","reference":{"chapter":50,"verse":21}},{"noteId":260,"caller":"+","text":"Pekode: Fitilihañe","reference":{"chapter":50,"verse":21}}]},"thisChapterLink":"/api/tdx_sle/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}