{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Hoe t’Iehovà: Inao!",{"text":"hetsefeko amy Bavele naho amo mpimone’ i Leb-Kanaio ty kofom-pijoy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le hañitrifako ty ambahiny hanongañe aze, naho hampikapaike i tane’ey;","poem":1},{"lineBreak":true},{"text":"fa hiarikoboñe hiatreatre aze iereo","poem":1},{"lineBreak":true},{"text":"amy andron-kankà’ey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko mei’o t’ie hampibitso-pale,","poem":1},{"lineBreak":true},{"text":"naho ty hiongaha’ ty aman-tsarom-by;","poem":1},{"lineBreak":true},{"text":"tsy sisañe o ajalahi’eo,","poem":1},{"lineBreak":true},{"text":"fonga rotsaho o valobohò’eo,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"hitsingoro an-tane’ o nte Kasdio,","poem":1},{"lineBreak":true},{"text":"ie tinombok’ an-dala’iareo eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe tsy niramavoin’ Añahare’e,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy, t’Israele naho Iehodà;","poem":1},{"lineBreak":true},{"text":"ndra te lifo-kakeo aolo’ i Masi’ Israeley","poem":1},{"lineBreak":true},{"text":"i tane’ iareoy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Itribaho ty lay i Bavele ao","poem":1},{"noteId":261},{"text":",","poem":1},{"lineBreak":true},{"text":"songa mandrombaha aiñe,","poem":1},{"lineBreak":true},{"text":"ko mirotsak’ amy fandilovañe azey;","poem":1},{"lineBreak":true},{"text":"fa tondroke ty andron-kaviñera’ Iehovà; hañondroha’e ho valen-kakeo’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe ni-fitovy volamena am-pità’ Iehovà t’i Bavele, hene nampimamoe’e ty tane toy","poem":1},{"noteId":262},{"text":"; ninome’ o kilakila’ ndatio ty divai’e,","poem":1},{"lineBreak":true},{"text":"izay ty maha-dereñe iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nideboñe ami’ty manao zao ty Bavele, rotsake ! angololoiho !","poem":1},{"lineBreak":true},{"text":"Añendeso aoly o fangirifiri’eo,","poem":1},{"lineBreak":true},{"text":"hera hahasarik’ aze.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nañosora’ay famelañe t’i Bavele,","poem":1},{"lineBreak":true},{"text":"f’ie tsy nahajangañe aze, ifario,","poem":1},{"lineBreak":true},{"text":"antao songa himpoly mb’an-tane’e añe;","poem":1},{"lineBreak":true},{"text":"fa mitakatse i likerañey ty fizakañ’aze,","poem":1},{"lineBreak":true},{"text":"toe mionjomb’an-dindiñe añe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa nihenefa’ Iehovà ty fañavantañañe anay; antao hitalily e Tsione ao","poem":1},{"lineBreak":true},{"text":"ty fitoloña’ Iehovà Andrianañaharentika.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sioño o ana-paleo, atsafo o traño’eo,","poem":1},{"lineBreak":true},{"text":"fa nitroboe’ Iehovà ty tro’","poem":1},{"lineBreak":true},{"text":"o mpanjaka’ i Madaio;","poem":1},{"lineBreak":true},{"text":"fa safiri’e ty mandrotsake i Bavele;","poem":1},{"lineBreak":true},{"text":"ho famalea’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ho fañodrohañe i anjomba’ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aonjono viloñe amo kijoli’ i Baveleo, ampaozaro o mpijiloo,","poem":1},{"lineBreak":true},{"text":"atroaro o mpañambeñeo,","poem":1},{"lineBreak":true},{"text":"ampihentseño mpamandroñe;","poem":1},{"lineBreak":true},{"text":"fa naereñerè’ Iehovà naho nihenefa’e i nitsara’e amo mpimone’ i Baveleoy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O mpiambesatse añ’ olon-drano maro,","poem":1},{"lineBreak":true},{"text":"am-bara tsifotofotoo,","poem":1},{"lineBreak":true},{"text":"fa tsatoke ty figadoña’o,","poem":1},{"lineBreak":true},{"text":"ty fizehem-pikatramoa’o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa nifanta am-pañova’e t’Iehovà’ i Màroy: Toe ho tsitsifeko ondaty","poem":1},{"lineBreak":true},{"text":"mira amo kijejao irehe;","poem":1},{"lineBreak":true},{"text":"ie hipoña-tsabo ama’o.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I namboatse ty tane toy ami’ty haozara’ey, i nañoreñe ty voatse toy ami’ty hihi’ey,","poem":1},{"lineBreak":true},{"text":"naho nandafike o likerañeo","poem":1},{"lineBreak":true},{"text":"ami’ty hilala’e;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ie mañotroke i fiarañanaña’ey","poem":1},{"lineBreak":true},{"text":"le mitroñe o rano an-dikerañeo; ampionjone’e boak’añ’olon-tane añe","poem":1},{"lineBreak":true},{"text":"o evoñeo; anoe’e ampiñe i orañey,","poem":1},{"lineBreak":true},{"text":"vaho akare’e amo riha’eo i tiokey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zoeñe te biby t’indaty tsy aman-kilala; songa salatse ty mpanefe volamena","poem":1},{"lineBreak":true},{"text":"ty amo sare sokire’eo,","poem":1},{"lineBreak":true},{"text":"te vande avao i trinana’ey,","poem":1},{"lineBreak":true},{"text":"mbore tsy mahakofòke.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hakoafañe iereo, satam-pamerevere;","poem":1},{"lineBreak":true},{"text":"ie ho mongotse ami’ty andro","poem":1},{"lineBreak":true},{"text":"fandilovañe iareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy manahake izay ty Anjara’ Iakobe, amy te Ie ro Mpamboatse ze he’e,","poem":1},{"lineBreak":true},{"text":"naho ty kobain-dova’e,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ihe ro dodako naho fialiañ’ aliko,","poem":1},{"lineBreak":true},{"text":"ie rekets’Azo le hampagomokomoheko ty fifelehañe","poem":1},{"lineBreak":true},{"text":"naho hampikimokimoheko ty fifeheañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie ama’o iraho, le andemodemoheko soavala naho i mpiningi’ey,","poem":1},{"lineBreak":true},{"text":"naho ama’o le hampikimokimoheko","poem":1},{"lineBreak":true},{"text":"ty sarete rekets’ i mpijoñe ama’ey;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie ama’o le hampibaibaieko","poem":1},{"lineBreak":true},{"text":"t’indaty naho ty ampela,","poem":1},{"lineBreak":true},{"text":"naho ama’o le hañimokimoheko","poem":1},{"lineBreak":true},{"text":"ty androanavy naho ty tora’e;","poem":1},{"lineBreak":true},{"text":"vaho ie ama’o le handemoheko","poem":1},{"lineBreak":true},{"text":"ty ajalahy naho ty somondrara.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ie ama’o le hampagomokomoheko ty mpiarake naho ty lia-rai’e,","poem":1},{"lineBreak":true},{"text":"ie ama’o le handemoheko","poem":1},{"lineBreak":true},{"text":"ty mpiroake naho o katraka’eo,","poem":1},{"lineBreak":true},{"text":"ie ama’o le hañimokimoheko","poem":1},{"lineBreak":true},{"text":"o mpifeheo rekets’ o sorota’eo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Le hondrohako amy Bavele","poem":1},{"lineBreak":true},{"text":"naho amo hene mpimone’ i Kasdio,","poem":1},{"lineBreak":true},{"text":"ze fonga halò-tsereke nanoe’ iereo","poem":1},{"lineBreak":true},{"text":"e Tsione ao ampahaoniña’o eo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Inao atreatreko irehe, ry vohitse mandrotsake, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ty mampianto ty tane toy iaby;","poem":1},{"lineBreak":true},{"text":"le hatora-kitsiko ama’o ty sirako,","poem":1},{"lineBreak":true},{"text":"naho havarimbariko","poem":1},{"lineBreak":true},{"text":"hizotso o tsera-batoo irehe,","poem":1},{"lineBreak":true},{"text":"vaho hanoeko vohitse finorototo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Le tsy hangala’ iareo ama’o","poem":1},{"lineBreak":true},{"text":"ty vato-kotsoke,","poem":1},{"lineBreak":true},{"text":"ndra ty vato hanoeñe manantañe;","poem":1},{"lineBreak":true},{"text":"fa hangoakoake kitro-katroke,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Añonjono viloñe i taney,","poem":1},{"lineBreak":true},{"text":"popoho añivo’ o fifeheañeo ty antsiva, añambaho fifeheañe hiatreatre aze,","poem":1},{"lineBreak":true},{"text":"koiho hifanontone ama’e","poem":1},{"lineBreak":true},{"text":"ty fifehea’ i Ararate","poem":1},{"noteId":263},{"text":", i Miny","poem":1},{"noteId":264},{"text":",","poem":1},{"lineBreak":true},{"text":"naho i Askenaze","poem":1},{"noteId":265},{"text":";","poem":1},{"lineBreak":true},{"text":"tendreo mpiaolo hiatrek’aze;","poem":1},{"lineBreak":true},{"text":"ampionjono mb’eo o soavalao","poem":1},{"lineBreak":true},{"text":"hoe kijeja mifamorohotse.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ambaho ho ama’e o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"o mpanjaka’ o nte-Madaio, o mpifele’eo,","poem":1},{"lineBreak":true},{"text":"o sorotà’eo, reketse ze hene tane fehe’e.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aa le manginikinike vaho mañore i taney;","poem":1},{"lineBreak":true},{"text":"amy te mijadoñe o ereñereñ’ arofo’ Iehovà amy Baveleo,","poem":1},{"lineBreak":true},{"text":"te hampangoakoahe’e ty tane’ i Bavele,","poem":1},{"lineBreak":true},{"text":"tsy ho amam-pimoneñe.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Malain-kialy o fanalolahi’ i Baveleo; mikonenak’ am-pipalirañe ao;","poem":1},{"lineBreak":true},{"text":"fa milesa ty haozara’ iareo,","poem":1},{"lineBreak":true},{"text":"hoe t’ie rakemba;","poem":1},{"lineBreak":true},{"text":"nampiforeheteñe o akiba’eo,","poem":1},{"lineBreak":true},{"text":"pinozake o sikada’eo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Milay hifanojo ami’ty mpijilo raike","poem":1},{"lineBreak":true},{"text":"ty raike,","poem":1},{"lineBreak":true},{"text":"naho hifanampe ami’ty ìrake raike","poem":1},{"lineBreak":true},{"text":"ty raike,","poem":1},{"lineBreak":true},{"text":"hitalily amy mpanjaka’ i Baveley","poem":1},{"lineBreak":true},{"text":"te fa tinavañe an-kotso’e valo i rovay;","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"fa tinambozòtse o fitsahañeo,","poem":1},{"lineBreak":true},{"text":"fa finorototo o vindao,","poem":1},{"lineBreak":true},{"text":"vaho vorombeloñe o lahin-defoñeo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele:","poem":1},{"lineBreak":true},{"text":"Ho toem-pifofohañe t’i Bavele","poem":1},{"lineBreak":true},{"text":"amy androm-pamofohañey;","poem":1},{"lineBreak":true},{"text":"aniany te ho tendreke","poem":1},{"lineBreak":true},{"text":"ty sam-pitatahañe aze.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Fa nampigedrañ’ahy t’i Nebokadnetsare, mpanjaka’ i Bavele, dinemo’e iraho,","poem":1},{"lineBreak":true},{"text":"napo’e eo hoe korobo kapaike,","poem":1},{"lineBreak":true},{"text":"nagodra’e an-tsatan-drimo,","poem":1},{"lineBreak":true},{"text":"naatsa’e an-tro’e ao o mafirikoo,","poem":1},{"lineBreak":true},{"text":"vaho sinao’e iraho.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ee te ho amy Bavele","poem":1},{"lineBreak":true},{"text":"ty hekoheko nanoañe ahy","poem":1},{"lineBreak":true},{"text":"naho amo nofokoo,","poem":1},{"lineBreak":true},{"text":"hoe ty asa’ o mpimone’ i Tsioneo;","poem":1},{"lineBreak":true},{"text":"naho ho amo nte-Kasdio ty lioko,","poem":1},{"lineBreak":true},{"text":"hoe t’Ierosalaime.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Inao! te hañalañalañe ho azo iraho,","poem":1},{"lineBreak":true},{"text":"naho hampañondrohako ty do’e","poem":1},{"lineBreak":true},{"text":"naho ho maiheko i oñe’ey","poem":1},{"lineBreak":true},{"text":"vaho ho riteko i rano’e migoangoañey.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Hanoeñe votre t’i Bavele,","poem":1},{"lineBreak":true},{"text":"lakatom-panaloke,","poem":1},{"lineBreak":true},{"text":"halatsañe naho fikosihañe,","poem":1},{"lineBreak":true},{"text":"tsy amam-pitoetse.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Hañaolo hoe liona tora’e iereo; hitromoroñe hoe ana-diona mena.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ie misolebotse ty drao’iareo,","poem":1},{"lineBreak":true},{"text":"le hazotsoko am’iereo ty takataka; hampimamoeko iereo hitsipoñapoña,","poem":1},{"lineBreak":true},{"text":"naho hirota’e firotse kitro-katroke,","poem":1},{"lineBreak":true},{"text":"vaho tsy hivañoñe, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Hampiambanèko hoe anak’ añondry ho lentañe,","poem":1},{"lineBreak":true},{"text":"hoe añondrilahy naho oselahy.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Hete! fa tinavañe ty Sesake,","poem":1},{"lineBreak":true},{"text":"fa nijihetse ty enge’ ty tane bey toy!","poem":1},{"lineBreak":true},{"text":"Akore te fa halatsañe amo fifeheañeo t’i Bavele.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Fa nitroare’ i riakey t’i Bavele,","poem":1},{"lineBreak":true},{"text":"nilipore’ ty fitroatroaha’ o onja’eo.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Fa mangoakoake o rova’eo,","poem":1},{"lineBreak":true},{"text":"kànkañe i taney naho liolio,","poem":1},{"lineBreak":true},{"text":"tane tsy imoneña’ ondaty,","poem":1},{"lineBreak":true},{"text":"tsy irangà’ ty ana’ ondaty.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Toe ho liloveko t’i Bel e Bavele ao,","poem":1},{"lineBreak":true},{"text":"naho hampiakareko am-bava’e ao","poem":1},{"lineBreak":true},{"text":"o nagedra’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hikararake mb’ama’e mb’eo ka o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"eka, fa nideboñe ty kijoli’ i Bavele.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"O ry ondatikoo,","poem":1},{"lineBreak":true},{"text":"mandripaha boak’ama’e ao","poem":1},{"noteId":266},{"text":",","poem":1},{"lineBreak":true},{"text":"mipolitira, songa ondaty mirombaha-piaiñe,","poem":1},{"lineBreak":true},{"text":"ami’ty haviñera’ Iehovà miforoforo.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Ko ado’o hifatsike o arofo’ areoo,","poem":1},{"lineBreak":true},{"text":"ko irevendreveñe ty amy tolom-bolañe","poem":1},{"lineBreak":true},{"text":"ho janjiñe amy taney;","poem":1},{"lineBreak":true},{"text":"fa ho pok’eo ty talily bokòke","poem":1},{"lineBreak":true},{"text":"ami’ty taoñe raike,","poem":1},{"lineBreak":true},{"text":"le ty tolom-boetse, an-taon-kafa","poem":1},{"lineBreak":true},{"text":"naho ty fandrakarakañe amy taney","poem":1},{"lineBreak":true},{"text":"ie hifandrapake ami’ty mpifeleke","poem":1},{"lineBreak":true},{"text":"ty mpifehe.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Aa le oniño, te ho tondroke ty andro hizakako o sare niatoa’ i Baveleo,","poem":1},{"lineBreak":true},{"text":"naho fonga ho salareñe i tane’ey;","poem":1},{"lineBreak":true},{"text":"vaho hifitafita ama’e ao o aze zinamañeo.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Le hisaboe’ i likerañey naho ty tane toy,","poem":1},{"lineBreak":true},{"text":"naho ze hene am’iereo ao, ty Bavele;","poem":1},{"lineBreak":true},{"text":"fa hiambotraha’ o mpamaoke","poem":1},{"lineBreak":true},{"text":"boak’ avaratseo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Eka, hikorovoke t’i Bavele","poem":1},{"lineBreak":true},{"text":"ty amo tinomboke e Israeleo,","poem":1},{"lineBreak":true},{"text":"toe nideboñe ty amy Bavele","poem":1},{"lineBreak":true},{"text":"o nihomak’ amy tane iabiio.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ry nahafipoliotse amy fibaray, mandripaha, ko tambatse ao,","poem":1},{"lineBreak":true},{"text":"tiahio t’Iehovà boak’ an-tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"vaho ampiziliho añ’arofo’ areo ao t’Ierosalaime.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Salatse zahay fa nahatsanoñ’ inje, manafotse ty tarehe’ay ty hameñarañe;","poem":1},{"lineBreak":true},{"text":"amy te nimoahan’ ambahiny","poem":1},{"lineBreak":true},{"text":"ty toe-masin’ anjomba’ Iehovà","poem":1},{"noteId":267},{"text":".","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Aa le oniño te ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te ho liloveko o sare niatoa’eo;","poem":1},{"lineBreak":true},{"text":"vaho hanitsike i tane’ey","poem":1},{"lineBreak":true},{"text":"ty fitoreova’ o nifereo.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Ndra te hitoabotse mb’andikerañe ey","poem":1},{"lineBreak":true},{"text":"t’i Bavele,","poem":1},{"lineBreak":true},{"text":"naho hafatrare’e i tambohon-kaozara’ey,","poem":1},{"lineBreak":true},{"text":"mbe hiboak’ amako, hionjoñe mb’ama’e mb’eo o mpampiantoo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Inay ty koeake boak’e Bavele,","poem":1},{"lineBreak":true},{"text":"naho ty harotsahañe jabajaba","poem":1},{"lineBreak":true},{"text":"hirik’an-tane’ o nte-Kasdioo!","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Fe hampiantoe’ Iehovà t’i Bavele,","poem":1},{"lineBreak":true},{"text":"naho hajihe’e i fikorahañe ama’ey,","poem":1},{"lineBreak":true},{"text":"ie mitroñe hoe rano mitabohazake","poem":1},{"lineBreak":true},{"text":"o onja’ iareoo,","poem":1},{"lineBreak":true},{"text":"i fipoñafa’ ty fivalitaboaham-peo’iareoy;","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Ie mivotrak’ama’e i mpandrotsakey, amy Bavele,","poem":1},{"lineBreak":true},{"text":"naho ho tsepaheñe o fanalolahi’eo,","poem":1},{"lineBreak":true},{"text":"ho tseraheñe o fale’eo;","poem":1},{"lineBreak":true},{"text":"fa Andrianañahare mpamale fate t’Iehovà,","poem":1},{"lineBreak":true},{"text":"toe hene hondroha’e.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Hampimamoeko o roandria’eo","poem":1},{"lineBreak":true},{"text":"naho o mahihi’eo,","poem":1},{"lineBreak":true},{"text":"o mpifeheo naho o mpifelekeo,","poem":1},{"lineBreak":true},{"text":"vaho o fanalolahio;","poem":1},{"lineBreak":true},{"text":"le hirotse firoroan-kitro-katroke,","poem":1},{"lineBreak":true},{"text":"tsy hivañoñe ka, hoe t’i Mpanjaka,","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy ty tahina’e.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"ho vata’e rotsaheñe o kijoly mateve’","poem":1},{"lineBreak":true},{"text":"i Baveleo; naho ho forototoe’ ty afo","poem":1},{"lineBreak":true},{"text":"o lalam-bei’e mitiotiotseo;","poem":1},{"lineBreak":true},{"text":"aa le tsi-vara ty fitoloña’ ondatio,","poem":1},{"lineBreak":true},{"text":"vaho afo ty himokora’ o fifeheañeo.","poem":1}]},{"type":"verse","number":59,"content":["Ty saontsy nafanto’Iirmeà mpitoky amy Seraia",{"noteId":268},"ana’ i Nerià, ana’ i Maseia, ie nindre lia amy Tsidkia mpanjaka’ Iehodà mbe Bavele mb’eo amy taom-paha-efam-pifehea’ey. (Talèm-pañalankañ’ anjomba t’i Seraia.)"]},{"type":"verse","number":60,"content":["Fonga sinoki’ Iirmeà am-boke-pelek’ ao o hankàñe hifetsak’ amy Baveleo, o hene entañe sinokitse ty amy Bavele retoañe."]},{"type":"verse","number":61,"content":["Hoe t’Iirmeà amy Seraia: Ie loake e Bavele añe irehe le mahaoniña te ho vakie’o am-peo abo o hene tsara zao,"]},{"type":"verse","number":62,"content":["le ano ty hoe, Ihe ry Iehovà, ro nitsara ty amy toetse toy, ty hañitoañe aze, tsy ho amam-pañialo, ndra ondaty ndra hare, f’ie hangoakoake nainai’e kitro-katroke."]},{"type":"verse","number":63,"content":["Ie vaho migadoñe ty famakiañe ty boke toy, le handrohiza’o vato, vaho hahiriri’o añivo’ i Perate ao;"]},{"type":"verse","number":64,"content":["le ano ty hoe: Zao ty hilempora’ i Bavele, tsy hitroatse ka, ty amy hankàñe hafe­tsako ama’e; vaho hitoirañe iereo. Izay ty figadoña’ ty enta’ Iirmeà."]}],"footnotes":[{"noteId":261,"caller":"+","text":"Oni: Iir 50:8","reference":{"chapter":51,"verse":6}},{"noteId":262,"caller":"+","text":"Ben 17:1-18","reference":{"chapter":51,"verse":7}},{"noteId":263,"caller":"+","text":"Ararate: ty fatse mampihondrahondra","reference":{"chapter":51,"verse":27}},{"noteId":264,"caller":"+","text":"Miny: vinolily; veka’e","reference":{"chapter":51,"verse":27}},{"noteId":265,"caller":"+","text":"Askenaze: afo mandakake","reference":{"chapter":51,"verse":27}},{"noteId":266,"caller":"+","text":"Oni: Iir 50:8, Ben 18:4","reference":{"chapter":51,"verse":45}},{"noteId":267,"caller":"+","text":"Sab 79:1-7, Fir 1:10, Dan 8:13, 11:31","reference":{"chapter":51,"verse":51}},{"noteId":268,"caller":"+","text":"Seraia: ty roandria’ Iehovà","reference":{"chapter":51,"verse":59}}]},"thisChapterLink":"/api/tdx_sle/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}