{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Mipitsiha mb’am-pipalirañe mb’eo","poem":1},{"lineBreak":true},{"text":"ry ana’ i Beniamineo,","poem":1},{"lineBreak":true},{"text":"boak’ an-teñateña’ Ierosalaime ao;","poem":1},{"lineBreak":true},{"text":"popòho e Tekoa","poem":1},{"noteId":24},{"text":"añe i antsivay,","poem":1},{"lineBreak":true},{"text":"vaho ampitroaro fanairañe","poem":1},{"lineBreak":true},{"text":"e Bete-hak’kereme","poem":1},{"noteId":25},{"text":"eñe;","poem":1},{"lineBreak":true},{"text":"fa hirik’ avaratse ty hankàñe,","poem":1},{"lineBreak":true},{"text":"ty fandrotsahañe jabajaba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I soa vintañe naho malemey,","poem":1},{"lineBreak":true},{"text":"i anak’ampela’ i Tsioney ro haitoako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hivotrak’ ama’e o mpiarakeo","poem":1},{"lineBreak":true},{"text":"rekets’ o lia-rai’eo,","poem":1},{"lineBreak":true},{"text":"hampitroatse fiarikatohañe","poem":1},{"lineBreak":true},{"text":"ami’ty kivoho’ iareo, le songa hiandrazañe an-toe’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ihentseño aly;","poem":1},{"lineBreak":true},{"text":"miongaha hanameantika aze","poem":1},{"lineBreak":true},{"text":"an-tsingilingiliñeñe.","poem":1},{"lineBreak":true},{"text":"Feh’ ohatse amantika, fa miroñe i àndroy,","poem":1},{"lineBreak":true},{"text":"mihalava o talinjon-karivao!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miavota hanamean-tika haleñe,","poem":1},{"lineBreak":true},{"text":"handrotsahantika o anjomba’eo!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Firao o hatae’eo;","poem":1},{"lineBreak":true},{"text":"atroaro am’Ierosalaime","poem":1},{"lineBreak":true},{"text":"ty fanongàm-panameañe;","poem":1},{"lineBreak":true},{"text":"toe rova tsy mete tsy lilovañe,","poem":1},{"lineBreak":true},{"text":"fa forekeke avao ty ama’e ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manahake ty fitana’ o vovoñeo","poem":1},{"lineBreak":true},{"text":"ty hamamin-drano’e,","poem":1},{"lineBreak":true},{"text":"ty fitana’e ho veloñe o haloloa’eo;","poem":1},{"lineBreak":true},{"text":"janjiñeñe ama’e ao ty tazataza","poem":1},{"lineBreak":true},{"text":"naho ty tsiborohetoke;","poem":1},{"lineBreak":true},{"text":"añatrefako eo nainai’e","poem":1},{"lineBreak":true},{"text":"ty hasiloke naho ty fere.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mitaoa ry Ierosalaime,","poem":1},{"lineBreak":true},{"text":"kera ho alik’amako nahareo,","poem":1},{"lineBreak":true},{"text":"ie hampangoakoaheko","poem":1},{"lineBreak":true},{"text":"ho tane tsy amam-pimoneñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Ho vata’e tsindrohe’iareo ty sisa’ Israele","poem":1},{"lineBreak":true},{"text":"hambañe amy t’ie vahe;","poem":1},{"lineBreak":true},{"text":"ozaño am-pita’o indraike i tsampa’ey","poem":1},{"lineBreak":true},{"text":"manahake ty mpanifo valoboke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ia ty ho volañeko naho hatahataeko,","poem":1},{"lineBreak":true},{"text":"hahafijanjiña’ iareo?","poem":1},{"lineBreak":true},{"text":"Hehe, domoke o ravembia’ iareoo,","poem":1},{"lineBreak":true},{"text":"tsy mahatsendreñe;","poem":1},{"lineBreak":true},{"text":"Hete! fañinjeañe am’iereo","poem":1},{"lineBreak":true},{"text":"ty tsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy mahafale’ iareo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fe lifo’ ty fiforoforo’ Iehovà iraho;","poem":1},{"lineBreak":true},{"text":"mahamokotse ahy ty mitañ’aze;","poem":1},{"lineBreak":true},{"text":"adoaño amo ajaja an-dalañeo,","poem":1},{"lineBreak":true},{"text":"naho amo ajalahy mifañosoñeo;","poem":1},{"lineBreak":true},{"text":"songa ho rambeseñe ie mirovaly,","poem":1},{"lineBreak":true},{"text":"o zoke’eo rekets’ o androanavio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho limbeze’ ty ila’e o anjomba’iareoo,","poem":1},{"lineBreak":true},{"text":"o tetekeo miharo amo rakemba’ iareoo;","poem":1},{"lineBreak":true},{"text":"fa hatora-kitsiko amo mpimoneñe","poem":1},{"lineBreak":true},{"text":"amy taneio ty tañako, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Songa mitavañe hitomboa’e ty tsitso’e am’iareo","poem":1},{"lineBreak":true},{"text":"pak’ami’ty loho bey;","poem":1},{"lineBreak":true},{"text":"fonga mpikatramo ty mpitoky sikal’ami’ty mpisoroñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nitaha’ iareo tsidaredare","poem":1},{"lineBreak":true},{"text":"ty fere’ ondatikoo, ami’ty hoe,","poem":1},{"lineBreak":true},{"text":"Fañanintsiñe, Fañanintsiñe,","poem":1},{"lineBreak":true},{"text":"ie tsy eo ty Fanintsiñañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Toko’e ho nahasalatse iereo","poem":1},{"lineBreak":true},{"text":"ty hativàñe nanoe’iereo,","poem":1},{"lineBreak":true},{"text":"f’ie tsy mahay meñatse.","poem":1},{"lineBreak":true},{"text":"Aa le hikorovoke amo mikorovokeo","poem":1},{"lineBreak":true},{"text":"amy androm-pandilovañey iereo,","poem":1},{"lineBreak":true},{"text":"vaho hitsikapy, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà: Mijohaña an-dala","poem":1},{"lineBreak":true},{"text":"mifanivalañe eo le mahaisaha,","poem":1},{"lineBreak":true},{"text":"mañontanea o oloñoloñe haehaeo,","poem":1},{"lineBreak":true},{"text":"te aia i lalam-bantañey; vaho añavelò,","poem":1},{"lineBreak":true},{"text":"hahatendreha’ areo fitofan’ arofo.","poem":1},{"lineBreak":true},{"text":"Fa hoe iareo: Zahay tsy homb’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mbore nampitroarako mpijilo,","poem":1},{"lineBreak":true},{"text":"nanao ty hoe : Haoño ty feo’ i antsivay!","poem":1},{"lineBreak":true},{"text":"Hoe ka iereo: Zahay tsy hañaoñe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa le mijanjiña ry fifeheañeo","poem":1},{"lineBreak":true},{"text":"vaho mahafohina ry valobohòkeo,","poem":1},{"lineBreak":true},{"text":"ty haseseke am’iareo:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsanoño ry tane; Inao!","poem":1},{"lineBreak":true},{"text":"handesako hankàñe ondaty retoa,","poem":1},{"lineBreak":true},{"text":"ty toli’ o fikinià’ iareoo,","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy nañaoñe o volakoo;","poem":1},{"lineBreak":true},{"text":"mbore nifarie’ iareo i Fanoroakoy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hanoeko inoñe o rame boake Sebao,","poem":1},{"lineBreak":true},{"text":"naho o fare boake tsietoitaneo?","poem":1},{"lineBreak":true},{"text":"Tsy noko o enga’ oroa’ areoo,","poem":1},{"lineBreak":true},{"text":"tsy mahafale ahy o fisoroña’ areoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Hehe te mampipoke vato mahatsikapy","poem":1},{"lineBreak":true},{"text":"aolo’ ondaty retoa iraho,","poem":1},{"lineBreak":true},{"text":"hampitsikapy roae reketse keleiañe;","poem":1},{"lineBreak":true},{"text":"fonga ho mongotse","poem":1},{"lineBreak":true},{"text":"ty mpimoneñe miharo rañetse.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Heheke, ondaty mangovovoke mb’etoy","poem":1},{"lineBreak":true},{"text":"boak’an-tane avaratseo,","poem":1},{"lineBreak":true},{"text":"fifeheañe jabajaba ty hahetseketseke","poem":1},{"lineBreak":true},{"text":"boake tsietoimoneñe añe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vontitire’ iareo ty fale naho ty lefoñe,","poem":1},{"lineBreak":true},{"text":"masiake iereo, tsy miferenay,","poem":1},{"lineBreak":true},{"text":"manahake ty fitroña’ i riakey","poem":1},{"lineBreak":true},{"text":"ty fikoraha’ iareo;","poem":1},{"lineBreak":true},{"text":"naho miningitse soavala,","poem":1},{"lineBreak":true},{"text":"miriritse hoe lahin-defo miatrek’aly,","poem":1},{"lineBreak":true},{"text":"ama’o ry anak’ ampela’ i Tsione!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie nitsanoña’ay talily,","poem":1},{"lineBreak":true},{"text":"dredra’e o taña’aio;","poem":1},{"lineBreak":true},{"text":"mamihiñe anay ty lovilovy,","poem":1},{"lineBreak":true},{"text":"ty haorean-drakemba mitsongo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ko miakatse mb’an-tetek’ ao,","poem":1},{"lineBreak":true},{"text":"ko mañavelo an-damoke eo;","poem":1},{"lineBreak":true},{"text":"amy te mampiboele harevendreveñañe","poem":1},{"lineBreak":true},{"text":"mb’etia mb’atia ty fibara’ i rafelahiy.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"O ry anak’ ampela’ ondatiko,","poem":1},{"lineBreak":true},{"text":"misikìna gony,","poem":1},{"lineBreak":true},{"text":"vaho milalilalia an-davenoke;","poem":1},{"lineBreak":true},{"text":"miroveta hoe t’ie bako tokañe,","poem":1},{"lineBreak":true},{"text":"mandalà añ’aferon’ate,","poem":1},{"lineBreak":true},{"text":"amy te hivovò amantika i mpandrotsakey.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nanoeko mpañasohaso","poem":1},{"lineBreak":true},{"text":"naho mpitsòke am’ondatikoo irehe,","poem":1},{"lineBreak":true},{"text":"hahafohina’o naho hitsikaraha’o o sata’eo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fonga mpiola manjehatse iereo,","poem":1},{"lineBreak":true},{"text":"mb’eo mb’eo mamokafoka avao;","poem":1},{"lineBreak":true},{"text":"torisìke naho viñe, songa tsivokatse.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mitioke mafe o famoforañeo,","poem":1},{"lineBreak":true},{"text":"forototoe’ ty afo i firakey,","poem":1},{"lineBreak":true},{"text":"tsy lefe ty fitoloñam-pitranahañe,","poem":1},{"lineBreak":true},{"text":"amy te tsy mete ho faoheñe ama’e","poem":1},{"lineBreak":true},{"text":"o halò-tserehañeo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Atao ty hoe taim-bolafoty iereo,","poem":1},{"lineBreak":true},{"text":"amy te naforintse’ Iehovà.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"Tekoa: Antsiva mietake","reference":{"chapter":6,"verse":1}},{"noteId":25,"caller":"+","text":"Bete-hak’kereme: kivoho an-tanem-bahy","reference":{"chapter":6,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}