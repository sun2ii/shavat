{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ty tsara nahitri’ Iehovà am’ Iirmeà,","poem":1},{"lineBreak":true},{"text":"manao ty hoe:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mijohaña an-dalambein’","poem":1},{"lineBreak":true},{"text":"Anjomba’ Iehovà eo,","poem":1},{"lineBreak":true},{"text":"le koiho ty entañe toy, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Mijanjiña ty tsara’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry Iehodà iabio,","poem":1},{"lineBreak":true},{"text":"o mimoak’ amo lalam-bey retoio","poem":1},{"lineBreak":true},{"text":"hitalaho am’ Iehovào.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"ahitio o lia’ areoo","poem":1},{"lineBreak":true},{"text":"naho o fitoloña’ areoo,","poem":1},{"lineBreak":true},{"text":"le hampimoneñeko an-tane atoy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ko iantofa’ areo ty reha-bande","poem":1},{"lineBreak":true},{"text":"manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ty Anjomba’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty Anjomba’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty Anjomba’ Iehovà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eka, naho toe avanta’ areo o lala’areoo","poem":1},{"lineBreak":true},{"text":"naho o fitoloña’areoo;","poem":1},{"lineBreak":true},{"text":"naho toe manao ty hato","poem":1},{"lineBreak":true},{"text":"añivo’ t’indaty naho i rañe’ey;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naho tsy forekeke’ areo ty ambahiny,","poem":1},{"lineBreak":true},{"text":"ty bode rae, vaho ty vantotse;","poem":1},{"lineBreak":true},{"text":"le tsy mampiori-dio-màliñe","poem":1},{"lineBreak":true},{"text":"an-tane atoy,","poem":1},{"lineBreak":true},{"text":"vaho tsy mañori-drahare ila’e","poem":1},{"lineBreak":true},{"text":"ho ami’ty fañelohañe anahareo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le hampimoneñeko an-tane atoy,","poem":1},{"lineBreak":true},{"text":"ie tane natoloko an-droae’areo ho","poem":1},{"lineBreak":true},{"text":"nainai’e donia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe hehe t’ie miantoke","poem":1},{"lineBreak":true},{"text":"ty rehan-dremborake tsy manjofake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mampikametse,","poem":1},{"lineBreak":true},{"text":"mañoho-doza, mpañarapilo,","poem":1},{"lineBreak":true},{"text":"manao fanta vilañe,","poem":1},{"lineBreak":true},{"text":"mibanabana amy Baale,","poem":1},{"lineBreak":true},{"text":"vaho mañorike ndrahare ila’e","poem":1},{"lineBreak":true},{"text":"tsy nifohi’ areo!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mbore mb’etoy, mijagarodoñe","poem":1},{"lineBreak":true},{"text":"añatrefako ami’ty anjomba tokaveñe","poem":1},{"lineBreak":true},{"text":"amy añarakoy toy, manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Votsotse zahay, hitoloña’ areo","poem":1},{"lineBreak":true},{"text":"o hativàñe iabio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa vaho lakato’ malaso","poem":1},{"lineBreak":true},{"text":"am-pahaoniña’ areo hao","poem":1},{"lineBreak":true},{"text":"ty anjomba tokaveñe ami’ty añarako toy?","poem":1},{"lineBreak":true},{"text":"Heheke! izaho, eka izaho ty nahatrea,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akia arè, mb’amy ni-toeko","poem":1},{"lineBreak":true},{"text":"e Silòy","poem":1},{"noteId":26},{"text":",","poem":1},{"lineBreak":true},{"text":"i nampimoneñako i añarakoy valoha’ey,","poem":1},{"lineBreak":true},{"text":"vaho oniño ty nanoako aze","poem":1},{"lineBreak":true},{"text":"ty amy haloloa’ ondatiko Israeleoy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie henane zao,","poem":1},{"lineBreak":true},{"text":"amy te fonga nanoe’ areo i sata rezay,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, le nitaroñe,","poem":1},{"lineBreak":true},{"text":"toe nañaleñale te nivolañe,","poem":1},{"lineBreak":true},{"text":"fe tsy nañaoñe nahareo,","poem":1},{"lineBreak":true},{"text":"vaho nitokaveko f’ie tsy nanoiñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le hanoeko amy anjomba tokaveñe","poem":1},{"lineBreak":true},{"text":"amy añarakoiy, i fiatoa’ areoy,","poem":1},{"lineBreak":true},{"text":"i toetse natoloko anahareo","poem":1},{"lineBreak":true},{"text":"naho an-droae’ areoy,","poem":1},{"lineBreak":true},{"text":"hambañe amy nanoeko e Siloy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Havokovokoko tsy ho treako nahareo,","poem":1},{"lineBreak":true},{"text":"hambañe ami’ty nandroahako","poem":1},{"lineBreak":true},{"text":"o rolongo’ areo iabio,","poem":1},{"lineBreak":true},{"text":"ze hene tarira’ i Efraime.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa naho ihe, ko mihalaly","poem":1},{"lineBreak":true},{"text":"ho a’ ondaty retoañe,","poem":1},{"lineBreak":true},{"text":"ko añonjonan-koike ndra soloho,","poem":1},{"lineBreak":true},{"text":"vaho ko manao ondati-aivo amako","poem":1},{"lineBreak":true},{"text":"fa tsy ho haoñeko.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy oni’o hao ty anoe’ iareo","poem":1},{"lineBreak":true},{"text":"amo rova’ Iehodao","poem":1},{"lineBreak":true},{"text":"naho amo lala’ Ierosalaimeo?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mangàla-katae o ajajao,","poem":1},{"lineBreak":true},{"text":"mamiañe afo o rae’eo,","poem":1},{"lineBreak":true},{"text":"mañajary bokon-koba o rakembao","poem":1},{"lineBreak":true},{"text":"hamboara’ iareo vonga-mofo","poem":1},{"lineBreak":true},{"text":"i mpanjaka-ampelan-dikerañey;","poem":1},{"lineBreak":true},{"text":"vaho añiliña’ iareo enga rano","poem":1},{"lineBreak":true},{"text":"o ndrahare ila’eo,","poem":1},{"lineBreak":true},{"text":"hampibosek’ ahy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Izaho hao o sigihe’ iareoo?","poem":1},{"lineBreak":true},{"text":"Hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Tsy iereo avao ho ami’ty hasalara’iareo?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aa le hoe t’i Talè, Iehovà:","poem":1},{"lineBreak":true},{"text":"Inao! Hailiñe ami’ty toetse toy","poem":1},{"lineBreak":true},{"text":"ty habosehako naho ty fifomboko,","poem":1},{"lineBreak":true},{"text":"am’ondatio naho amo hareo,","poem":1},{"lineBreak":true},{"text":"amo hatae ankivokeo","poem":1},{"lineBreak":true},{"text":"naho ami’ty vokatse an-tane atoy;","poem":1},{"lineBreak":true},{"text":"ho forototoeñe, tsy lefe akipeke.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"i Andrianañahare’ Israeley:","poem":1},{"lineBreak":true},{"text":"Tovoño amo fisoroña’ areoo,","poem":1},{"lineBreak":true},{"text":"amo enga-koroa’ areoo","poem":1},{"lineBreak":true},{"text":"ty fikama’ areo i hena’ey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fe tsy nivolañeko o roae’ areoo","poem":1},{"lineBreak":true},{"text":"tsy nililieko amy andro","poem":1},{"lineBreak":true},{"text":"naneseako iareo boak’an-tane","poem":1},{"lineBreak":true},{"text":"Mitsraime añey","poem":1},{"lineBreak":true},{"text":"ze o enga oroañeo naho o fisoroñañeo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fe hoe ty nandiliako iareo,","poem":1},{"lineBreak":true},{"text":"Haoño ty feoko","poem":1},{"noteId":27},{"lineBreak":true},{"text":"le ho Andrianañahare’ areo iraho,","poem":1},{"lineBreak":true},{"text":"naho ho ondatiko nahareo;","poem":1},{"lineBreak":true},{"text":"vaho añavelò iaby o lalañe","poem":1},{"lineBreak":true},{"text":"nililiakoo, soa te hiraorao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"F’ie tsy nañaoñe iereo,","poem":1},{"lineBreak":true},{"text":"tsy nanongilan-dravembia,","poem":1},{"lineBreak":true},{"text":"te mone nañavelo","poem":1},{"lineBreak":true},{"text":"ami’ty fikililian-tro’ iareo,","poem":1},{"lineBreak":true},{"text":"añ’ereñeren’ arofo-lo,","poem":1},{"lineBreak":true},{"text":"vaho nidisa-voly fa tsy nionjoñe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Boak’amy andro niakaran-droae’ areo i Mitsraimey am-para’ ty andro toy,","poem":1},{"lineBreak":true},{"text":"le nañitrike o mpitoroko mpitoky iabio","poem":1},{"lineBreak":true},{"text":"mb’ama’ areo nañaleñaleñe te niraheñe;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"f’ie tsy nañaoñe ahy,","poem":1},{"lineBreak":true},{"text":"tsy nanokilan-dravembia,","poem":1},{"lineBreak":true},{"text":"toe nampigàn-kàtoke avao;","poem":1},{"lineBreak":true},{"text":"maro ty haratiañe nanoe’iereo","poem":1},{"lineBreak":true},{"text":"te aman-droae’iareo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hene saontsio am’iareo o entañe zao,","poem":1},{"lineBreak":true},{"text":"f’ie tsy hijanjiñ’azo;","poem":1},{"lineBreak":true},{"text":"ho koihe’o, f’ie tsy hanoiñe azo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hanoa’o ty hoe :","poem":1},{"lineBreak":true},{"text":"Itoy ty fifeheañe tsy nañorike","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ iareo,","poem":1},{"lineBreak":true},{"text":"tsy nañaom-panoroañe;","poem":1},{"lineBreak":true},{"text":"modo ty hatò, naito am-pivimbi’iareo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Hitsifo o maroi’oo, naho ahifiho añe;","poem":1},{"lineBreak":true},{"text":"añonjono an-kaboañe","poem":1},{"lineBreak":true},{"text":"maliolio ey ty fandalañe,","poem":1},{"lineBreak":true},{"text":"fa nifarie’ Iehovà vaho naforintse’e","poem":1},{"lineBreak":true},{"text":"ty tariratse nampiforoforo azey.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Fa nanao raty am-pahatreavako","poem":1},{"lineBreak":true},{"text":"o ana’ Iehodao, hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"napo’iareo añ’anjomba kanjieñe","poem":1},{"lineBreak":true},{"text":"amy añarakoy","poem":1},{"lineBreak":true},{"text":"o raha tiva’ iareoo, handeots’ aze.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mbore rinanji’ iareo o tamboho’","poem":1},{"lineBreak":true},{"text":"i Topete","poem":1},{"noteId":28},{"text":"am-bavatanen’ana’ i Hinomeo","poem":1},{"noteId":29},{"text":", hañoroañ’ añ’afo ao","poem":1},{"lineBreak":true},{"text":"o ana-dahi’ iareoo","poem":1},{"lineBreak":true},{"text":"naho o anak’ ampela’ iareoo—","poem":1},{"lineBreak":true},{"text":"ie tsy nililieko, tsy naereñèreko.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Aa le ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"t’ie tsy hanoeñe Topete ka,","poem":1},{"lineBreak":true},{"text":"tsy ho vavatanen’ana’ i Hinome,","poem":1},{"lineBreak":true},{"text":"fa ty vavatanem-panjamanañe,","poem":1},{"lineBreak":true},{"text":"amy te handeveñe e Topete ao iereo","poem":1},{"lineBreak":true},{"text":"am-para’ te tsy aman-toetse.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ho fihina’ o voron-tiokeo","poem":1},{"lineBreak":true},{"text":"naho o bibi’ ty tane toio ty lolo’","poem":1},{"lineBreak":true},{"text":"ondaty retoa;","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty handroake iareo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Hajiheko amo rova’ Iehodao","poem":1},{"lineBreak":true},{"text":"naho amo lala’ Ierosalaimeo","poem":1},{"lineBreak":true},{"text":"ty feon-kafaleañe naho ty feom-pirebehañe,","poem":1},{"lineBreak":true},{"text":"ty feom-pañenga naho ty feon’ engavao,","poem":1},{"lineBreak":true},{"text":"fa ho kòake i taney.","poem":1}]}],"footnotes":[{"noteId":26,"caller":"+","text":"Silò: niraheñe; i rovay: fierañerañañe,","reference":{"chapter":7,"verse":12}},{"noteId":27,"caller":"+","text":"Fot 26:5, Avo 19:5, Jao 3:36, Rom 6:16, Heb 4:11, 5:9, Ben 22:14","reference":{"chapter":7,"verse":23}},{"noteId":28,"caller":"+","text":"Topete: langoro; fifoterañe","reference":{"chapter":7,"verse":31}},{"noteId":29,"caller":"+","text":"Hinome: Ingo ie; vara’e; fangololoihañe","reference":{"chapter":7,"verse":31}}]},"thisChapterLink":"/api/tdx_sle/JER/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/6.json","previousChapterAudioLinks":{},"numberOfVerses":34}