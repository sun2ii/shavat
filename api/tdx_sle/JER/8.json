{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Amy andro zay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le hakare’ iareo boak’an-kibori’e ao","poem":1},{"lineBreak":true},{"text":"ty taola’ o mpanjaka’ Iehodào, naho","poem":1},{"lineBreak":true},{"text":"ty taola’ o roandria’eo, naho","poem":1},{"lineBreak":true},{"text":"ty taola’ o mpitokio, naho","poem":1},{"lineBreak":true},{"text":"ty taola’ o mpisoroñeo, naho","poem":1},{"lineBreak":true},{"text":"ty taola’ o mpimone’ Ierosalaimeo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ie havarakaike añatrefa’ i àndroy","poem":1},{"lineBreak":true},{"text":"naho i volañey","poem":1},{"lineBreak":true},{"text":"vaho i valobohòn-di­kerañe nitea’ iareo","poem":1},{"lineBreak":true},{"text":"naho nitoroñe’ iereo","poem":1},{"lineBreak":true},{"text":"naho norihe’ iereo","poem":1},{"lineBreak":true},{"text":"naho nitsoehe’ iereo","poem":1},{"lineBreak":true},{"text":"vaho nitalahoa’ iareo;","poem":1},{"lineBreak":true},{"text":"tsy hahoroñe tsy haleveñe,","poem":1},{"lineBreak":true},{"text":"fa hadoñe ho forompotse","poem":1},{"lineBreak":true},{"text":"ambone’ tane eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho joboñe’ o romoromom-pokom-patse honka’e","poem":1},{"lineBreak":true},{"text":"amo tane nandroahako iareo iabioo","poem":1},{"lineBreak":true},{"text":"ty fivetrahañe aolo’ ty fivelomañe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tovoño am’ iereo ka ty hoe: Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Tsy hitroatse hao ty mikorovoke?","poem":1},{"lineBreak":true},{"text":"Tsy himpoly hao ty mibotriatse?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inoñ’arè ty nampivio’ ondati’ Ierosalaime retoa t’ie nainai’e am-pitsileañ’ añe?","poem":1},{"lineBreak":true},{"text":"vontitire’ iereo ty fitake,","poem":1},{"lineBreak":true},{"text":"mifoneñe tsy himpoly.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nitsendreñe iraho, nahatsanoñe","poem":1},{"lineBreak":true},{"text":"t’ie tsy nisaontsy ty hato,","poem":1},{"lineBreak":true},{"text":"leo raik’ am’ondatio tsy misoloho","poem":1},{"lineBreak":true},{"text":"manao ty hoe: Ino o nanoekoo?","poem":1},{"lineBreak":true},{"text":"Songa mivio am-pombà’e mb’eo,","poem":1},{"lineBreak":true},{"text":"manahake ty soavala mirefe aly.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eka apota’ ty sama andikerañ’ eñe","poem":1},{"lineBreak":true},{"text":"o famantaña’eo;","poem":1},{"lineBreak":true},{"text":"ambena’ ty ongongo naho ty foly","poem":1},{"lineBreak":true},{"text":"vaho ty tsiriry o fiampaneña’eo,","poem":1},{"lineBreak":true},{"text":"fe tsy fohi’ ondatikoo ty lili’ Iehovà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Akore te atao’ areo :","poem":1},{"lineBreak":true},{"text":"Mahihitse zahay,","poem":1},{"lineBreak":true},{"text":"vaho aman-tika ty Hà’ Iehovà?","poem":1},{"lineBreak":true},{"text":"Fe hehe te nanoe’ i fanoki-bìla’","poem":1},{"lineBreak":true},{"text":"o mpanoki-dilioy fandañitse.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nisalareñe o mahihitseo,","poem":1},{"lineBreak":true},{"text":"lonjetse iereo vaho tsinepake:","poem":1},{"lineBreak":true},{"text":"nifarie’ iereo ty tsara’ Iehovà;","poem":1},{"lineBreak":true},{"text":"inoñ’arè ze o hihitse am’ iereo zao?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa le hatoloko am’ty ila’e","poem":1},{"lineBreak":true},{"text":"o tañanjomba’iareoo,","poem":1},{"lineBreak":true},{"text":"naho amo mpitavañeo o tete’iareoo;","poem":1},{"lineBreak":true},{"text":"amy te songa matiti-mena,","poem":1},{"lineBreak":true},{"text":"ty kede naho ty bey;","poem":1},{"lineBreak":true},{"text":"sindre mpikatramo","poem":1},{"lineBreak":true},{"text":"ty mpitoky pak’am-pisoroñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Loho maivañe ty nanindria’ iareo","poem":1},{"lineBreak":true},{"text":"ty rare’ i anak’ ampela’ ondatikoy","poem":1},{"lineBreak":true},{"text":"ami’ty hoe: Fañanintsiñe, Fañanintsiñe;","poem":1},{"lineBreak":true},{"text":"aia ze o fanintsiñañe zao?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nimeñatse hao iereo te niota-faly?","poem":1},{"lineBreak":true},{"text":"Aiy avao! tsy nahasalatse iareo,","poem":1},{"lineBreak":true},{"text":"vaho tsy mahay minanake;","poem":1},{"lineBreak":true},{"text":"aa le hikorovoke amo mikorovokeo","poem":1},{"lineBreak":true},{"text":"naho hafetsake ambane","poem":1},{"lineBreak":true},{"text":"amy andro fitilihañe iareoy, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Toe ho mongoreko hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ho po-balòboke o vaheo,","poem":1},{"lineBreak":true},{"text":"tsy ho amam-boa o sakoañeo,","poem":1},{"lineBreak":true},{"text":"naho hiheatse o rave’eo,","poem":1},{"lineBreak":true},{"text":"vaho hihelañe añe o nitolorakoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ino ty andrarean-tika toboke?","poem":1},{"lineBreak":true},{"text":"Mifanontona,","poem":1},{"lineBreak":true},{"text":"antao hizilik’ amo rova fatratseo","poem":1},{"lineBreak":true},{"text":"naho hianjiñe ao;","poem":1},{"lineBreak":true},{"text":"fa nampianjiñe antika t’Iehovà Andrianañaharentika,","poem":1},{"lineBreak":true},{"text":"vaho nanjotsoa’e ranon-afero","poem":1},{"lineBreak":true},{"text":"ho fikamañe, amy te nanao","poem":1},{"lineBreak":true},{"text":"hakeo am’ Iehovà tika.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nipay fierañerañañe tika","poem":1},{"lineBreak":true},{"text":"fe tsy nanjo hasoa;","poem":1},{"lineBreak":true},{"text":"naho andro fijanganañe,","poem":1},{"lineBreak":true},{"text":"fe hehe t’ie hebahebake!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Janjiñeñe boake Dane","poem":1},{"lineBreak":true},{"text":"ty fikofòn-tsoavala;","poem":1},{"lineBreak":true},{"text":"manginikinike iaby i taney","poem":1},{"lineBreak":true},{"text":"ami’ty kofò’ o soavala lahi’eo;","poem":1},{"lineBreak":true},{"text":"amy t’ie pok’ eo mampibotseke","poem":1},{"lineBreak":true},{"text":"i taney naho ty halifora’e;","poem":1},{"lineBreak":true},{"text":"ty rova naho o mpimone’eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le ingo, hañirahako mereñe,","poem":1},{"lineBreak":true},{"text":"toe fandrefeala tsy mete avere,","poem":1},{"lineBreak":true},{"text":"hañehetse anahareo, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy lefe melañeñe ty halendeñako! mitoirañe amako ao ty troko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Inao ty feon-kaikai’ o anak’ ampela’ ondatikoo boak’ an-tsietoitane añe,","poem":1},{"lineBreak":true},{"text":"tsy e Tsione ao hao t’Iehovà?","poem":1},{"lineBreak":true},{"text":"Tsy ama’e ao hao i Mpanjaka’ey?","poem":1},{"lineBreak":true},{"text":"Ino ty nampiboseha’iareo ahy","poem":1},{"lineBreak":true},{"text":"amo sare-soki’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho amo samposampon’ ambahinio?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Añe i fitatahañey, modo i asaray,","poem":1},{"lineBreak":true},{"text":"fe tsy voa-rombake tika.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mangirifiry ami’ty fangirifiria’ o anak’ ampela’ ondatikoo iraho;","poem":1},{"lineBreak":true},{"text":"miharovetse; fosatse;","poem":1},{"lineBreak":true},{"text":"mamihiñe ahy ty haemberañe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy aman-kosotse hao ty Gilade","poem":1},{"noteId":30},{"text":"?","poem":1},{"lineBreak":true},{"text":"Po-panaha hao ty ao?","poem":1},{"lineBreak":true},{"text":"Inoñ’ arè ty tsy nahatotòtse","poem":1},{"lineBreak":true},{"text":"ty fijangana’ i anak’ ampela’ondatikoy?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ee t’ie ni-rano ty lohako,","poem":1},{"lineBreak":true},{"text":"naho niganaganake o masokoo,","poem":1},{"lineBreak":true},{"text":"hirovetako handro an-kaleñe","poem":1},{"lineBreak":true},{"text":"o nizamaneñe","poem":1},{"lineBreak":true},{"text":"amy anak’ ampela’ ondatikoy.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Gilade: votrin-talily; bokobokon-taroñe","reference":{"chapter":8,"verse":22}}]},"thisChapterLink":"/api/tdx_sle/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}