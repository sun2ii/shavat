{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JER","translationId":"tdx_sle","name":"Iirmeà","commonName":"Iirmeà","title":"Iirmeà","order":24,"numberOfChapters":52,"sha256":"b2419199f764e93989027a2ac9a379976fb3b575df96e9ac8c2e7d2c9a046148","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tdx_sle/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Ee te tam-babangoañe añe iraho,","poem":1},{"lineBreak":true},{"text":"an-kialo’ o mpandroakeo,","poem":1},{"lineBreak":true},{"text":"hisitahako ondatikoo,","poem":1},{"lineBreak":true},{"text":"hihankañako lavitse!","poem":1},{"lineBreak":true},{"text":"Fa songa mpañarapilo","poem":1},{"lineBreak":true},{"text":"firimboñam-pamañahy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ampibitsohe’ iereo o famele’eo,","poem":1},{"lineBreak":true},{"text":"ie ty falem-pandañira’iareo;","poem":1},{"lineBreak":true},{"text":"maozatse amy tane’ey iareo,","poem":1},{"lineBreak":true},{"text":"fe tsy ami’ty hatò;","poem":1},{"lineBreak":true},{"text":"boak’an-draty mb’an-katsivokarañe;","poem":1},{"lineBreak":true},{"text":"alik’am’ iereo iraho, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mifampitaoa ry mpitrao-tanàñeo","poem":1},{"lineBreak":true},{"text":"naho ko miato rahalahy;","poem":1},{"lineBreak":true},{"text":"fa songa kalitake ty mpilongo,","poem":1},{"lineBreak":true},{"text":"vaho sindre mifañosoñe amo mpidramotseo o rañetseo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sambe mifamañahy o mpirai-moneñeo,","poem":1},{"lineBreak":true},{"text":"tsy mivolan-to,","poem":1},{"lineBreak":true},{"text":"nanare’ iereo handañitse o famele’ iareoo; mamoza-batañe ami’ty fikitrohan-draty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Añivom-pamañahiañe ao ty akiba’o;","poem":1},{"lineBreak":true},{"text":"ifoneña’ iareo o fikatramoañeo","poem":1},{"lineBreak":true},{"text":"tsy hañaoñe ahy, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Ho tranaheko iereo,","poem":1},{"lineBreak":true},{"text":"ho tsoheko iereo;","poem":1},{"lineBreak":true},{"text":"fa ino ka ty ho nanoeko,","poem":1},{"lineBreak":true},{"text":"amy anak’ampela’ ondatikoy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ana-pale mamono ty famele’ iareo,","poem":1},{"lineBreak":true},{"text":"mivola-pitake;","poem":1},{"lineBreak":true},{"text":"saontsiem-palie’e filongoañe ty mpiama’e, fe ikinia’e an-troke ao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy ho liloveko hao iereo ty amy rezay?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"tsy ho valèko fate hao","poem":1},{"lineBreak":true},{"text":"ty fifelehañe manahak’ itoañe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hirovetako naho hangololoihako","poem":1},{"lineBreak":true},{"text":"o vohitseo,","poem":1},{"lineBreak":true},{"text":"naho handalàko o fiandrazañe","poem":1},{"lineBreak":true},{"text":"am-patrambeio,","poem":1},{"lineBreak":true},{"text":"fa napoke ho tomontoñe,","poem":1},{"lineBreak":true},{"text":"tsy iranga’ ondaty;","poem":1},{"lineBreak":true},{"text":"tsy ahatsanoñam-pimàn’ añombe;","poem":1},{"lineBreak":true},{"text":"songa niborofotse añe o voron-dikerañeo naho o bibio, nibioñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hanoeko votrem-porompotse t’Ierosalaime, lakatom-panaloke;","poem":1},{"lineBreak":true},{"text":"vaho hampangoakoaheko","poem":1},{"lineBreak":true},{"text":"o rova’ Iehodào ho po-pimoneñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ia ty mahihitse haharendreke zao?","poem":1},{"lineBreak":true},{"text":"Ia ty nitsaram-palie’ Iehovà, hitalilia’e? Ino ty nampangoakoake i taney","poem":1},{"lineBreak":true},{"text":"ho ratraratra tsy firangàñe?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le hoe t’Iehovà :","poem":1},{"lineBreak":true},{"text":"Amy t’ie nifary i Hàke","poem":1},{"lineBreak":true},{"text":"napoko aolo’ iereoy,","poem":1},{"lineBreak":true},{"text":"naho tsy nañaoñe ty feoko","poem":1},{"noteId":31},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho tsy nañavelo ama’e;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"te mone nitsontike","poem":1},{"lineBreak":true},{"text":"ami’ty hagàñ’ arofo’ iareo,","poem":1},{"lineBreak":true},{"text":"naho amo Baaleo,","poem":1},{"lineBreak":true},{"text":"i nañanaran-droae’ iareoy;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"aa le hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"i Andrianañahare’ Israeley:","poem":1},{"lineBreak":true},{"text":"Ingo hanjotsoako vahontsoy ondaty retoañe,","poem":1},{"lineBreak":true},{"text":"vaho hampinomeko ranon’ afero.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Habaratsàko amo fifeheañeo iereo,","poem":1},{"lineBreak":true},{"text":"amo tsy nifohi’ iareo naho o rae’ iareoo;","poem":1},{"lineBreak":true},{"text":"vaho hampañoridañeko fibara,","poem":1},{"lineBreak":true},{"text":"ampara’ te mongoreko.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy: Tsakoreo,","poem":1},{"lineBreak":true},{"text":"koiho o rakemba mpandalao, homb’atoy; ampañitrifo o rakemba mahafibekoo,","poem":1},{"lineBreak":true},{"text":"hiheo mb’etoa;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Itaentaeño hangoihoy ho antika","poem":1},{"lineBreak":true},{"text":"higanaganaha’ o fihainon-tikañeo,","poem":1},{"lineBreak":true},{"text":"vaho hikararahan-drano","poem":1},{"lineBreak":true},{"text":"o holi-mason-tikañeo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa janjiñe e Tsione ao","poem":1},{"lineBreak":true},{"text":"ty feom-pirovetañe:","poem":1},{"lineBreak":true},{"text":"Hete! rotsake tika!","poem":1},{"lineBreak":true},{"text":"Vata’e salatse, fa nienga i taney tika,","poem":1},{"lineBreak":true},{"text":"fa narobake o akiban-tikañeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ehe, janjiño ty tsara’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry rakembao,","poem":1},{"lineBreak":true},{"text":"le ampitsendreño o ravembia’ areoo","poem":1},{"lineBreak":true},{"text":"ty tsaram-palie’e:","poem":1},{"lineBreak":true},{"text":"Songa anaro fangololoihañe","poem":1},{"lineBreak":true},{"text":"o anak’ ampela’eo,","poem":1},{"lineBreak":true},{"text":"vaho fiojeañe o mpiama’eo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa nizilik’ amo lafinetio ty havilasy,","poem":1},{"lineBreak":true},{"text":"nimoak’ añ’anjomban-tikañ’ao,","poem":1},{"lineBreak":true},{"text":"ho zamane’e an-dalañe eo","poem":1},{"lineBreak":true},{"text":"o anan-tikañeo,","poem":1},{"lineBreak":true},{"text":"naho an-kiririsa ao o ajalahio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Isaontsio: Hoe t’Iehovà—","poem":1},{"lineBreak":true},{"text":"Hiforetrake hoe taik-ombe amontoñe ey","poem":1},{"lineBreak":true},{"text":"ty lolo’ ondatio,","poem":1},{"lineBreak":true},{"text":"naho manahake ty voton-tsako","poem":1},{"lineBreak":true},{"text":"nipoke boak’an-taña’ i mpanatakey,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hanontoñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ee te tsy hirenge ami’ty hihi’e","poem":1},{"lineBreak":true},{"text":"ty mahihitse,","poem":1},{"lineBreak":true},{"text":"naho tsy hisenge ty haozara’e","poem":1},{"lineBreak":true},{"text":"ty maozatse,","poem":1},{"lineBreak":true},{"text":"vaho tsy hiebotsebotse ami’ty vara’e","poem":1},{"lineBreak":true},{"text":"ty mpañaleale.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"F’ie zao ty hirengea’ ty mpirenge:","poem":1},{"lineBreak":true},{"text":"t’ie maharendreke naho mahafohiñ’ ahiko, te Izaho Iehovà,","poem":1},{"lineBreak":true},{"text":"Mpanolots’ arofo naho ty hato,","poem":1},{"lineBreak":true},{"text":"vaho ty havantañañe an-tane atoy;","poem":1},{"lineBreak":true},{"text":"fa irezay ty teako, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ingo, ho tondroke ty andro,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà, te ho fonga liloveko","poem":1},{"lineBreak":true},{"text":"o sinavatse mboe tsy sinavatseo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I Mitsraime naho Iehodà,","poem":1},{"lineBreak":true},{"text":"naho i Edome, naho o ana’ i Amoneo naho i Moabe","poem":1},{"noteId":32},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho ze hene mpimoneñe am-patrambey añe mpañitsike ty maròy","poem":1},{"lineBreak":true},{"text":"añ’ilam-panda’e eo;","poem":1},{"lineBreak":true},{"text":"fa songa tsy sinavatse o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"sindre tsy sinavatse añ’arofo ao","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Israele.","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Iir 7:23","reference":{"chapter":9,"verse":12}},{"noteId":32,"caller":"+","text":"Moabe: boak’ aman-drae’e","reference":{"chapter":9,"verse":25}}]},"thisChapterLink":"/api/tdx_sle/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":25}