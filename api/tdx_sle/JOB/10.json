{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Hejeko ty haveloko;","poem":1},{"lineBreak":true},{"text":"hampidadaeko ty fitoreoko","poem":1},{"lineBreak":true},{"text":"hivolañe ami’ty hafairan-troko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hoe ty ataoko aman’Añahare,","poem":1},{"lineBreak":true},{"text":"Ko ozoñe’o;","poem":1},{"lineBreak":true},{"text":"ampahafohino ahiko ty lie’o amako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mahasoa azo hao te ihe mamorekeke,","poem":1},{"lineBreak":true},{"text":"te mavoe’o ty satam-pità’o","poem":1},{"lineBreak":true},{"text":"vaho ampiloeloea’o ty fikinià’","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amam-pihaino nofotse v’iheo?","poem":1},{"lineBreak":true},{"text":"Mahavazoho manahake ty fañentea’ ondatio hao?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty andro’ o olombeloñeo hao o andro’oo,","poem":1},{"lineBreak":true},{"text":"mira ami’ty tao’ ondatio hao o tao’oo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"t’ie tsoehe’o o tahikoo,","poem":1},{"lineBreak":true},{"text":"vaho kodebe’o o hakeokoo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ndra t’ie arofoana’o te","poem":1},{"lineBreak":true},{"text":"tsy tsereheñe,","poem":1},{"lineBreak":true},{"text":"tsy eo ty haharombake am-pità’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nitsenèm-pità’o iraho,","poem":1},{"lineBreak":true},{"text":"nifonire’o ho raike;","poem":1},{"lineBreak":true},{"text":"aa vaho ho rotsahe’o?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tiahio te lietse ty nitsenea’o ahy;","poem":1},{"lineBreak":true},{"text":"hampoli’o ho deboke hao?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy nadoa’o hoe ronono hao raho","poem":1},{"lineBreak":true},{"text":"vaho nampamoae’o hoe habobo?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nanikina’o holitse naho nofotse,","poem":1},{"lineBreak":true},{"text":"namahera’o an-taolañe","poem":1},{"lineBreak":true},{"text":"naho talin’ozatse.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tinolo’o havelo an-koko migahiñe,","poem":1},{"lineBreak":true},{"text":"vaho nampitambeloñe ty troko","poem":1},{"lineBreak":true},{"text":"ty fiatraha’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fe naeta’o añ’arofo’o ao o raha zao;","poem":1},{"lineBreak":true},{"text":"apotako t’ie ama’o:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie mandilatse iraho, tendre’o,","poem":1},{"lineBreak":true},{"text":"vaho tsy apo’o i hakeokoy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie manao hakeo: hankàñe amako!","poem":1},{"lineBreak":true},{"text":"Ie mahity, tsy vaniko ty miandra,","poem":1},{"lineBreak":true},{"text":"amy te lifo-kasalarañe,","poem":1},{"lineBreak":true},{"text":"tsapako o hasotriakoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa naho niandrandra:","poem":1},{"lineBreak":true},{"text":"Le hoe liona ty hangoroña’o ahy;","poem":1},{"lineBreak":true},{"text":"vaho havale’o ahy an-kalatsàñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Vaoe’o amako o mpanisý ahikoo,","poem":1},{"lineBreak":true},{"text":"vaho indrae’o amako ty haviñera’o;","poem":1},{"lineBreak":true},{"text":"hasosorañe mitovon-kaemberañe","poem":1},{"lineBreak":true},{"text":"ty amako.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ino ty nañakara’o ahy an-koviñe ao?","poem":1},{"lineBreak":true},{"text":"Nainako te ho nisimba","poem":1},{"lineBreak":true},{"text":"tsy ho niisam-pihaino,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hàmake t’ie hoe tsy nitoly,","poem":1},{"lineBreak":true},{"text":"fa boak’an-koviñe mb’an-kibory","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy ho napo’e hao o androko","poem":1},{"lineBreak":true},{"text":"tsy ampeampeo?","poem":1},{"lineBreak":true},{"text":"Misitaha hey irehe,","poem":1},{"lineBreak":true},{"text":"hahatreavako fañanintsin-kedeke,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"aolo’ te hiampaneñako;","poem":1},{"lineBreak":true},{"text":"mb’amy tsy hahafibaliham-beoy,","poem":1},{"lineBreak":true},{"text":"mb’an-tane mimoromoroñe,","poem":1},{"lineBreak":true},{"text":"mb’an-talinjon-kavilasy ao;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tane migobogoboñ’ ieñe,","poem":1},{"lineBreak":true},{"text":"toe fimoromoroñañe,","poem":1},{"lineBreak":true},{"text":"an-tane an-kalon-kavilasy,","poem":1},{"lineBreak":true},{"text":"tsy mipendreñe,","poem":1},{"lineBreak":true},{"text":"miloeloe hoe ieñe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}