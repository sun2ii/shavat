{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["Le hoe ty natoi’ i Tsofare nte Naamate:"]},{"type":"verse","number":2,"content":[{"text":"Hapoke tsy ho valeañe hao","poem":1},{"lineBreak":true},{"text":"i entan-tsy fotofoto rezay,","poem":1},{"lineBreak":true},{"text":"hahazo to hao ondaty lifo-dañonañeo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hampijomohòn-ty lahilahy hao","poem":1},{"lineBreak":true},{"text":"ty fangaradadaha’o,","poem":1},{"lineBreak":true},{"text":"tsy hendaha’ ondaty hao","poem":1},{"lineBreak":true},{"text":"t’ie manivetive?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ami’ty nanoa’o ty hoe:","poem":1},{"lineBreak":true},{"text":"Ki’e o fañòhakoo,","poem":1},{"lineBreak":true},{"text":"naho malio-tahin-draho","poem":1},{"lineBreak":true},{"text":"am-pivazohoa’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa ehe te hitsara t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"naho hanokake fivimby ama’o,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"hitaroña’e hihitse miheotse! Toe aman’ ila roe ty hilala to.","poem":1},{"lineBreak":true},{"text":"Aa le mahafohina te apon’ Añahare","poem":1},{"lineBreak":true},{"text":"ty ila’ o hakeo’oo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mahafitsikarake o raha miheotse aman’ Añahareo v’iheo?","poem":1},{"lineBreak":true},{"text":"Mahafañitsokitsoke o efe’ efe’","poem":1},{"lineBreak":true},{"text":"i El-Sadai hao?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sikal’ an-dindìñe eñe iereo?","poem":1},{"lineBreak":true},{"text":"—ino ty ho mete’o?","poem":1},{"lineBreak":true},{"text":"laleke ta i Tsikeokeokey","poem":1},{"lineBreak":true},{"text":"—ino ty ho fohi’o?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lava te ami’ty tane toy ty andava’e,","poem":1},{"lineBreak":true},{"text":"mihenehene te amy riakey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ke miary re, ke mampigabeñe,","poem":1},{"lineBreak":true},{"text":"he manontoñe, ia ty hanebañe aze?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe arofoana’e ty votro;","poem":1},{"lineBreak":true},{"text":"naho vazoho’e ty hakeo,","poem":1},{"lineBreak":true},{"text":"ndra t’ie tsy mandohy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kanao hahilala ty dagola,","poem":1},{"lineBreak":true},{"text":"le mahaterak’ ondaty ty borìke-ly.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Avantaño arè ty arofo’o,","poem":1},{"lineBreak":true},{"text":"vaho avelaro ama’e o fità’oo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"apoho añe ze hakeo am-pità’o;","poem":1},{"lineBreak":true},{"text":"ko ado’o hitobok’ añ’akiba’o ao ty tahiñe,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie amy zao, hampiandrae’o laharañe tsy aman-kila;","poem":1},{"lineBreak":true},{"text":"hijohan-drehe tsy an-kahembañañe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho haliño’o ty fisotria’o;","poem":1},{"lineBreak":true},{"text":"ho tiahi’o hoe rano fa nisaok’ añe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Le hazava te amy tsipinde-menay","poem":1},{"lineBreak":true},{"text":"ty havelo’o;","poem":1},{"lineBreak":true},{"text":"naho manahake ty maraindray i haìe’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Le hahatoky irehe kanao am-pitamàñe;","poem":1},{"lineBreak":true},{"text":"mijilojilova añ’ariari’o,","poem":1},{"lineBreak":true},{"text":"le màndrea an-kanintsiñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho nihity tsy an-kahembañañe","poem":1},{"lineBreak":true},{"text":"vaho maro ty hipay imba ama’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fe ho tofake ty maso’ o lo-tserekeo;","poem":1},{"lineBreak":true},{"text":"le tsy aia ty hivoratsaha’e,","poem":1},{"lineBreak":true},{"text":"vaho ty fipetro’e avao ty hisalala’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}