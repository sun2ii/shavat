{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Nanoiñe ami’ty hoe t’Iobe:"]},{"type":"verse","number":2,"content":[{"text":"Toe inahareo avao ro ondaty,","poem":1},{"lineBreak":true},{"text":"vaho hitrao-pihomak’","poem":1},{"lineBreak":true},{"text":"ama’ areo ty hihitse.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa toe mahilala ka iraho,","poem":1},{"lineBreak":true},{"text":"tsy inahareo avao;","poem":1},{"lineBreak":true},{"text":"Tsy zai’ areo iraho.","poem":1},{"lineBreak":true},{"text":"Ia ty tsy mahafohiñe o raha rezao?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fiankahafa’ o rañekoo iraho:","poem":1},{"lineBreak":true},{"text":"Kanjie’e t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"vaho toiñe’e,","poem":1},{"lineBreak":true},{"text":"Fitohafañe i vañoñe tsy aman-kilay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsambolitio’ ty miagaregañe ty failo,","poem":1},{"lineBreak":true},{"text":"ie nihentseñañe ho a","poem":1},{"lineBreak":true},{"text":"o mipolititse am-pandiao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mierañerañe ty kiboho-malaso,","poem":1},{"lineBreak":true},{"text":"le tsi-añoleñañe ty manigìk’ an’Andrianañahare,","poem":1},{"lineBreak":true},{"text":"o mitintiñe ty ndrahare’e am-pità’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe añontaneo o bibio,","poem":1},{"lineBreak":true},{"text":"hampandrendreha’ iareo;","poem":1},{"lineBreak":true},{"text":"naho o voro-mitiliñeo,","poem":1},{"lineBreak":true},{"text":"hitalilia’ iareo;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ke misaontsia ami’ty tane toy,","poem":1},{"lineBreak":true},{"text":"hañòha’e azo,","poem":1},{"lineBreak":true},{"text":"apoho hitaroña’ o fian-driakeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ia amy rezay ro tsy mahafohiñe t’ie","poem":1},{"lineBreak":true},{"text":"nanoem-pità’ Iehovà?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kila am-pità’e ao ty fiai’ ze veloñe,","poem":1},{"lineBreak":true},{"text":"naho ty kofò’ ze hene ondaty.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsy mpitsò-bolañe hao ty ravembia, manahake ty fitsopehan-dañilañy","poem":1},{"lineBreak":true},{"text":"ty mahakama?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amo antetseo hao ty hihitse,","poem":1},{"lineBreak":true},{"text":"amo lava’ androo hao ty hilala?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aman’Añahare o hihitse naho haozarañeo; ama’e o fanoroañe naho hilalao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Heheke, mandrotsake re,","poem":1},{"lineBreak":true},{"text":"le tsy hamboareñe ka;","poem":1},{"lineBreak":true},{"text":"agabe’e ao t’indaty,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho hahañe ka.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hehe te kalaña’e o ranoo, le maike;","poem":1},{"lineBreak":true},{"text":"irahe’e ka iereo, le añinahinà’e ty tane.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ama’e ty hafatrarañe naho ty hilala;","poem":1},{"lineBreak":true},{"text":"aze ty finitake naho ty mpamitake","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ampañaveloa’e tsy aman-kana","poem":1},{"lineBreak":true},{"text":"o mpanoroo,","poem":1},{"lineBreak":true},{"text":"vaho ampigege’e o mpizakao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Abala’e ty kitambem-panjaka","poem":1},{"lineBreak":true},{"text":"vaho diaña’e sokotry ty vania’e.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Asese’e tsy aman-kana o mpisoroñeo naho gorè’e ty fanalolahy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ampitsiñe’e ty lañona’ o matoeo, naho afaha’e ty hilala’o antetseo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ampidoaña’e inje o ana-donakeo naho abala’e ty sadia’ o maozatseo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ventabentare’e o raha mietak’ añ’ieñeo, aboa’e an-kazavàñe o talinjon-kavilasio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Onjone’e o fifeheañeo naho rotsahe’e; atratrañahe’e o fifelehañeo","poem":1},{"lineBreak":true},{"text":"vaho asese’e an-drohy añe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ampimotsoe’e arofo","poem":1},{"lineBreak":true},{"text":"o mpiaolo’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"vaho ampirerererè’e an-dratraratra","poem":1},{"lineBreak":true},{"text":"tsy aman-dalañe añe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie mijimejime añ’ ieñe ao","poem":1},{"lineBreak":true},{"text":"tsy an-kazavàñe;","poem":1},{"lineBreak":true},{"text":"midaleandaleañe hoe jike.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}