{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Inao! fa nitreako iaby zao,","poem":1},{"lineBreak":true},{"text":"tsinano’ ty sofiko vaho maharendreke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ze fohi’areo, apotako ka;","poem":1},{"lineBreak":true},{"text":"Izaho tsy zai’ areo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fe te hivolañe amy El-Sadai iraho,","poem":1},{"lineBreak":true},{"text":"te hifanointoiñe aman’ Añahare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpanosoke vande nahareo,","poem":1},{"lineBreak":true},{"text":"songa mpanaha tsy manjofake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ehe t’ie vata’e nianjiñe,","poem":1},{"lineBreak":true},{"text":"le ho natao hihitse!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ehe janjiño ty havereko,","poem":1},{"lineBreak":true},{"text":"vaho janjiño ty fanoroan-tsoñiko","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hisaontsy hamengohañ’ aman’Añahare hao,","poem":1},{"lineBreak":true},{"text":"hilañona’areo famañahiañe?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Handombok’ aze v’inahareoo?","poem":1},{"lineBreak":true},{"text":"h’ondati-aivo, mpihalaly ho an’Andrianañahare hao?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hahasoa anahareo hao te itsikaraha’e?","poem":1},{"lineBreak":true},{"text":"Hamañahy Aze hao nahareo","poem":1},{"lineBreak":true},{"text":"manahake ty famañahiañe ondaty?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie ho trevohe’e","poem":1},{"lineBreak":true},{"text":"te mirihy añ’etake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsy hampangebahebak’ anahareo hao ty enge’e?","poem":1},{"lineBreak":true},{"text":"naho hivotrak’ ama’ areo ty fañeveñañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Oha-drehan-davenoke","poem":1},{"lineBreak":true},{"text":"ty onin-taro’ areo,","poem":1},{"lineBreak":true},{"text":"fiaron-dietse ty fikala’ areo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mianjiña, apoho iraho hivolañe","poem":1},{"lineBreak":true},{"text":"le adono ho amako ty toly.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ino ty andrambesako?","poem":1},{"lineBreak":true},{"text":"ami’ty nifeko ty nofoko,","poem":1},{"lineBreak":true},{"text":"vaho apoko an-tañako ty fiaiko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndra te havetra’e, ie ty fatokisako","poem":1},{"lineBreak":true},{"text":"fe hiverok’ añ’atrefa’e raho","poem":1},{"lineBreak":true},{"text":"ty amo satakoo,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vaho zao ty ho fandrombahañe ahy:","poem":1},{"lineBreak":true},{"text":"te tsy hiatrek’aze ty tsy aman-Kake","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsendreño o entakoo,","poem":1},{"lineBreak":true},{"text":"naho ty lañonako an-dravembia’ areo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ingo, fa nalahako i tarokoy,","poem":1},{"lineBreak":true},{"text":"apotako te hahazo to.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ia ty hifanjomotse amako?","poem":1},{"lineBreak":true},{"text":"le ho nitsiñe amy zao raho","poem":1},{"lineBreak":true},{"text":"vaho nikenkañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ehe ty raha roe avao","poem":1},{"lineBreak":true},{"text":"ty tsy hanoa’o ahy,","poem":1},{"lineBreak":true},{"text":"le tsy hietahako o lahara’oo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ahankaño amako ty fità’o,","poem":1},{"lineBreak":true},{"text":"le ehe tsy hampianifañe ahy","poem":1},{"lineBreak":true},{"text":"ty fañeveñako ama’o","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie amy zao koiho, le hanoiñe iraho,","poem":1},{"lineBreak":true},{"text":"ke angao hivolan-draho vaho toiño.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fire o fandilarako naho hakeokoo?","poem":1},{"lineBreak":true},{"text":"Ampahafohino ahy ty fiolako","poem":1},{"lineBreak":true},{"text":"naho o tahikoo,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Akore te añetaha’o laharañe,","poem":1},{"lineBreak":true},{"text":"vaho manao ahy ho rafelahi’o?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hampititititihe’o hao ty ravets-atae","poem":1},{"lineBreak":true},{"text":"asiotsion-tioke,","poem":1},{"lineBreak":true},{"text":"ho heañe’o hao ty kafo maike?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fa anokira’o raha mafaitse iraho,","poem":1},{"lineBreak":true},{"text":"vaho ampandova’o ahy","poem":1},{"lineBreak":true},{"text":"o hakeoko te niajalahy.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Añombea’o longòke o tombokoo,","poem":1},{"lineBreak":true},{"text":"naho efera’o ty ho nilian-tombokoo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ie mihamomoke hoe raha lo iraho,","poem":1},{"lineBreak":true},{"text":"hoe saroñe nihanem-bararaoke.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}