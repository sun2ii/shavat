{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Ondaty nasaman’ ampelao,","poem":1},{"lineBreak":true},{"text":"tsy lava-ohatse vaho lifo-kasotriañe,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"hoe voñen-katae ty fionjona’e","poem":1},{"lineBreak":true},{"text":"le miheatse, mihelañe hoe talinjo","poem":1},{"lineBreak":true},{"text":"fa tsy mitoetse.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Harefa’o vaho hasese’o an-jaka ama’o ao?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ia ty mahaakatse ty malio","poem":1},{"lineBreak":true},{"text":"ami’ty maleotse? Leo raike.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kanao fa nalahatse o andro’eo,","poem":1},{"lineBreak":true},{"text":"fa ama’o ty ia’ o vola’eo vaho fa najado’o","poem":1},{"lineBreak":true},{"text":"o efetse tsy handilara’eo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ampitoliho añe ty fijilova’o, hitofa’e,","poem":1},{"lineBreak":true},{"text":"ampara’ te henefe’e o andro’eo,","poem":1},{"lineBreak":true},{"text":"manahake ty mpièke","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manan-ko tamae’e ty hatae,","poem":1},{"lineBreak":true},{"text":"ie firaeñe ro mbe mitiry avao,","poem":1},{"lineBreak":true},{"text":"vaho tsy milesa o tora’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndra te mihaantetse an-tane ao","poem":1},{"lineBreak":true},{"text":"o vaha’eo,","poem":1},{"lineBreak":true},{"text":"naho mate an-debok’ ao i foto’ey,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"fa ie mañantson-drano ro hibotiboty","poem":1},{"lineBreak":true},{"text":"vaho handrevake hoe ana-katae.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe mihomake t’i Raolombelo","poem":1},{"lineBreak":true},{"text":"vaho mitsalalampatse;","poem":1},{"lineBreak":true},{"text":"mipetroke t’indaty, le aia?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty fisiha’ o sihanakeo","poem":1},{"lineBreak":true},{"text":"naho ty fimaiha’ o sakao","poem":1},{"lineBreak":true},{"text":"ampara’ te kapaike,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ty fandrea’ ondaty tsy hitroatse,","poem":1},{"lineBreak":true},{"text":"tsy hivañone ampara’ te","poem":1},{"lineBreak":true},{"text":"mihelañe o likerañeo,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho barakaofeñe amy firota’ey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ehe t’ie haeta’o an-tsikeokeok’ao,","poem":1},{"lineBreak":true},{"text":"le hakafi’o ampara’ te mimpoly ty","poem":1},{"lineBreak":true},{"text":"haviñera’o, vaho hampitsatoha’o","poem":1},{"lineBreak":true},{"text":"andro hahatiahia’o ahy!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie vilasy ondatio, mbe ho veloñe hao?","poem":1},{"lineBreak":true},{"text":"Fe ho liñisako amo hene androm-pitoroñakoo ampara’ te tondroke ty fañovàñe ahiko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hikanjy irehe le hanoiñe iraho;","poem":1},{"lineBreak":true},{"text":"ho maniña’o ty satam-pità’o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fe henaneo, tinoñe’o o liakoo,","poem":1},{"lineBreak":true},{"text":"ie mbe tsy vazoho’o ty fandilarako;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"rinohy an-karoñe ao o tahikoo,","poem":1},{"lineBreak":true},{"text":"vaho lombofa’o o hakeokoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mivoravora i vohitse mihotrakey,","poem":1},{"lineBreak":true},{"text":"naho misitse an-toe’e ty vato;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"mivañen-drano o vongam-batoo;","poem":1},{"lineBreak":true},{"text":"saohe’ o rano-vohitseo ty mena’ i taney;","poem":1},{"lineBreak":true},{"text":"Izay ty androtsaha’o","poem":1},{"lineBreak":true},{"text":"ty fitama’ ondatio.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Iambotraha’o nainai’e, le mihelañe añe;","poem":1},{"lineBreak":true},{"text":"ovae’o ty tarehe’e vaho irahe’o mb’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Asiñeñe o ana’eo, fa tsy apota’e; mifotsake, fa tsy fohi’e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"O marare amy nofo’eio avao ro tsapa’e,","poem":1},{"lineBreak":true},{"text":"ty tro’e avao ro iroveta’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}