{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Le hoe ty natoi’ i Elifatse nte-Temane:"]},{"type":"verse","number":2,"content":[{"text":"Hanoiñe an-kilala-kafoake hao","poem":1},{"lineBreak":true},{"text":"t’indaty mahihitse,","poem":1},{"lineBreak":true},{"text":"ho lifora’e tiok’atiñanañe hao ty fisafoa’e?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hisafiry an-drehake tsy vente’e hao,","poem":1},{"lineBreak":true},{"text":"ndra an-dañonañe tsy hahasoa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eka, apo’o ty fañeveñañe,","poem":1},{"lineBreak":true},{"text":"sebaña’o ty fiambaneañe aman’ Añahare.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anare’ o hakeo’oo ty falie’o,","poem":1},{"lineBreak":true},{"text":"joboñe’o ty famelen-kalitake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mamatse azo o falie’oo, fa tsy izaho;","poem":1},{"lineBreak":true},{"text":"eka talilie’ o fivimbi’oo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ihe hao t’indaty nisamaheñe valoha’e?","poem":1},{"lineBreak":true},{"text":"Nitoly aolo’ o vohitseo v’iheo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Janji’o hao o safirin’ Añahare","poem":1},{"lineBreak":true},{"text":"miheotseo?","poem":1},{"lineBreak":true},{"text":"Haramamoe’o hao ty hihitse?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ino ty fohi’o tsy fohi’ay?","poem":1},{"lineBreak":true},{"text":"Ino ty rendre’o tsy ama’ay?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Songa ama’ay ty maròy foty","poem":1},{"lineBreak":true},{"text":"naho ty androanavy bey taoñe","poem":1},{"lineBreak":true},{"text":"te aman-drae’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maivañe ama’o hao ty fañohòan’ Añahare,","poem":1},{"lineBreak":true},{"text":"naho o navere’e mora ama’oo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ino ty mampihelañe ty arofo’o?","poem":1},{"lineBreak":true},{"text":"vaho mampandofiry o fihaino’oo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"T’ie tsambolitioe’o aman’Añahare","poem":1},{"lineBreak":true},{"text":"ty arofo’o,","poem":1},{"lineBreak":true},{"text":"ie anga’o hiakatse am-palie’o","poem":1},{"lineBreak":true},{"text":"i saontsy zay.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ino t’indaty, t’ie halio?","poem":1},{"lineBreak":true},{"text":"I nasaman’ampelay, t’ie ho vañoñe?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ingo, ndra o masi’eo tsy iatoa’e","poem":1},{"lineBreak":true},{"text":"mbore tsy malio am-pivazohoa’e","poem":1},{"lineBreak":true},{"text":"o likerañeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Àntsake ty lo-tsereke naho ty maleotse,","poem":1},{"lineBreak":true},{"text":"ie mpitohoke tahiñe hoe rano!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hataliliko azo, janjiño;","poem":1},{"lineBreak":true},{"text":"vaho ho taroñeko o nitreakoo—","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O saontsi’ ondaty mahihitseo,","poem":1},{"lineBreak":true},{"text":"ty tsy naeta’e boak’ aman droae’ iareo;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie am’ iereo avao","poem":1},{"lineBreak":true},{"text":"ty nitolorañe i taney,","poem":1},{"lineBreak":true},{"text":"ndra ty renetane tsy nihelañe","poem":1},{"lineBreak":true},{"text":"am’iereo ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ampikoretohe’","poem":1},{"lineBreak":true},{"text":"ty farare’e lomoñandro","poem":1},{"lineBreak":true},{"text":"ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"voaiake o taoñe nahaja","poem":1},{"lineBreak":true},{"text":"ho a’ o mpisenge-herio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Feo mañebake","poem":1},{"lineBreak":true},{"text":"ty an-dravembia’e ao;","poem":1},{"lineBreak":true},{"text":"ie manintsin-dre,","poem":1},{"lineBreak":true},{"text":"te ivotraha’ ty malaso.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy iantofa’e","poem":1},{"lineBreak":true},{"text":"te hibalike boak’amy ieñey,","poem":1},{"lineBreak":true},{"text":"toli’e i fibaray.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mirererere mipay hanen-dre ami’ty hoe; Aia Izay? Apota’e te am-pità’e","poem":1},{"lineBreak":true},{"text":"i andro mimoromoroñey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ampangebahebahe’","poem":1},{"lineBreak":true},{"text":"ty haloviloviañe naho hasotriañe,","poem":1},{"lineBreak":true},{"text":"miambotrak’ ama’e hoe mpanjaka","poem":1},{"lineBreak":true},{"text":"veka’e hihotakotake.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amy te natora-kitsi’e aman’Añahare ty fità’e,","poem":1},{"lineBreak":true},{"text":"mitoandratoandra amy El-Sadai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Horidaña’e ami’ty hagàn-kàto’e,","poem":1},{"lineBreak":true},{"text":"amy hateven’ angozim-pikalan-defo’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Amy te kinope’e solike i tarehe’ey,","poem":1},{"lineBreak":true},{"text":"vaho pinako’e havondrahañe ty leme’e;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Itoboha’e o rova mangoakoakeo, añ’anjomba tsy fimoneñañe,","poem":1},{"lineBreak":true},{"text":"ie veka’e ho votre.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tsy ho mpañaleale re,","poem":1},{"lineBreak":true},{"text":"tsy ho nainai’e ty fijangaña’e,","poem":1},{"lineBreak":true},{"text":"tsy midrodretse mb’an-tane o ampemba’eo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tsy hibolitira’e i ieñey;","poem":1},{"lineBreak":true},{"text":"haforejeje’ i lelan’ afoy o tora’eo,","poem":1},{"lineBreak":true},{"text":"vaho hampihelaña’ ty kofòm-palie’e.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ee te tsy hiatoa’e ty hakoahañe,","poem":1},{"lineBreak":true},{"text":"hamañahia’e vatañe;","poem":1},{"lineBreak":true},{"text":"fa hanambezañe aze ty tsy vente’e.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ho henek’ aolo’ ty andro’e Izay,","poem":1},{"lineBreak":true},{"text":"vaho tsy handrevake ty tsampa’e.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Hahifi’e i valobo’e mantay","poem":1},{"lineBreak":true},{"text":"manahak’ i vahey,","poem":1},{"lineBreak":true},{"text":"vaho hahintsa’e i voñe’ey","poem":1},{"lineBreak":true},{"text":"hambañ’ amo oliveo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Fa hangoakoake ty fivavea’","poem":1},{"lineBreak":true},{"text":"ty tsy aman-Kake,","poem":1},{"lineBreak":true},{"text":"vaho ho forototoe’ ty afo","poem":1},{"lineBreak":true},{"text":"ty kijà’ o mpanao vokàñeo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ie mampiareñe hakalitahañe,","poem":1},{"lineBreak":true},{"text":"naho mampiboloañe hakeo,","poem":1},{"lineBreak":true},{"text":"vaho famañahiañe","poem":1},{"lineBreak":true},{"text":"ty ihentseñan-tro’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}