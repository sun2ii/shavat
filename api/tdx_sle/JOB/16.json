nampanintsiña’","poem":1},{"lineBreak":true},{"text":"ty fihetsen-tsoñiko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fe ndra te mivolan-draho,","poem":1},{"lineBreak":true},{"text":"tsy mikepake ty hasotriako,","poem":1},{"lineBreak":true},{"text":"hahamaivañ’ ahy hao te mifoneñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe nimokore’e iraho henaneo,","poem":1},{"lineBreak":true},{"text":"fa nahabangý o mpiamako iabio irehe,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nampiforejeje ahiko irehe, valolombelo amako izay;","poem":1},{"lineBreak":true},{"text":"Mionjoñe amako ato ty faifoifoko,","poem":1},{"lineBreak":true},{"text":"ie oniñe an-tareheko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nirimita’ ty haviñera’e, mitan-kabò amako, nialia’e vazañe; nabohiri’ i Rafelahikoy amako o fihaino’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nampibolobea-palie amako,","poem":1},{"lineBreak":true},{"text":"tinakapi’ iareo amañ’inje ty fifiko,","poem":1},{"lineBreak":true},{"text":"le nihimpok’ amako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe nasesen’Añahare","poem":1},{"lineBreak":true},{"text":"amo raty tserekeo iraho,","poem":1},{"lineBreak":true},{"text":"mbore navokovoko’e am-pità’","poem":1},{"lineBreak":true},{"text":"o tsy vokatseo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nierañeran-draho,","poem":1},{"lineBreak":true},{"text":"fe nampivaletrahe’e.","poem":1},{"lineBreak":true},{"text":"Ginore’e am-bozoko vaho hinotohoto’e,","poem":1},{"lineBreak":true},{"text":"mbore najado’e ho fanolarañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Miarikoboñe ahy o mpitàm-pale’eo, tseratserahe’e, abenta’e tsy aman-tretre","poem":1},{"lineBreak":true},{"text":"o tsapa-voakoo,","poem":1},{"lineBreak":true},{"text":"vaho adoandoa’e","poem":1},{"lineBreak":true},{"text":"an-tane eo o aferokoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Boroboñake atovom-boroboñake","poem":1},{"lineBreak":true},{"text":"ty niboroboñaha’e ahy;","poem":1},{"lineBreak":true},{"text":"hoe fanalohaly t’ie mañoridañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nitrebehako gony ty holiko,","poem":1},{"lineBreak":true},{"text":"vaho napoko an-deboke ao ty tsifako.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nampandofiry","poem":1},{"lineBreak":true},{"text":"ty tareheko o tañikoo,","poem":1},{"lineBreak":true},{"text":"an-koli-masoko eo","poem":1},{"lineBreak":true},{"text":"ty talinjon-kavilasy;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ndra te tsy aman-tsenge hery","poem":1},{"lineBreak":true},{"text":"o tañakoo,","poem":1},{"lineBreak":true},{"text":"mbore malio o halalikoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O ry tane; ko lembefa’o ty lioko,","poem":1},{"lineBreak":true},{"text":"le ko mea’o fitofàñe o toreokoo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie amy zao hehe te an-dikerañe ao","poem":1},{"lineBreak":true},{"text":"i valolombelokoy, ambone ao i Mpañalañalakoy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mikizak’ahy o rañekoo,","poem":1},{"lineBreak":true},{"text":"i Andrianañahare","poem":1},{"lineBreak":true},{"text":"ty fitsopaha’ o masokoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ehe t’ie nimpañalañalañe añivo’ ondatio naho i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"manahake ty ana’ondaty aman-drañe’e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa ie añe ty taoñe tsy ampeampe,","poem":1},{"lineBreak":true},{"text":"le hionjomb’an-dalañe","poem":1},{"lineBreak":true},{"text":"tsy impolian-draho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}