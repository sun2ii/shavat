{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Fa demoke ty troko,","poem":1},{"lineBreak":true},{"text":"le modo o androkoo; vaho veka’e amako ty kibory.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toe amako atoa o mañinje ahikoo;","poem":1},{"lineBreak":true},{"text":"naho harefe’ o masokoo","poem":1},{"lineBreak":true},{"text":"ty fanigiha’ iareo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toloro antoke henaneo, Ihe ro tsoake, ia ka ty hifampipao-pitàñe amako?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa nakite’o ty tro’ iareo tsy hahilala,","poem":1},{"lineBreak":true},{"text":"aa le tsy honjone’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie mifosa rañetse hahazoa’e raha,","poem":1},{"lineBreak":true},{"text":"le hilesa ka o mason’ ana’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fe nanoa’e mpitolom-bola’ ondaty;","poem":1},{"lineBreak":true},{"text":"firorà’ o lahilahio ty tareheko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nampaieñe ty fioremeñako o masokoo,","poem":1},{"lineBreak":true},{"text":"hoe talinjo avao o fangefangekoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ilatsa’ ondaty vantañeo, hitrobo-vatañe ty vaño","poem":1},{"lineBreak":true},{"text":"hatreatre’e ty tsy aman-kake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mitan-ty lala’e ty marentane,","poem":1},{"lineBreak":true},{"text":"naho mihaozatse vaho mihafatratse","poem":1},{"lineBreak":true},{"text":"ty malio fitàñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa inahareo iaby,","poem":1},{"lineBreak":true},{"text":"mibaliha mb’etoa indraike,","poem":1},{"lineBreak":true},{"text":"f’ie tsy hahatrea ondaty mahilala ama’ areo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa modo o androkoo,","poem":1},{"lineBreak":true},{"text":"nipeñapeñake o safirikoo;","poem":1},{"lineBreak":true},{"text":"naho o fisalalan-trokoo!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Afote’ iereo ho andro ty haleñe","poem":1},{"lineBreak":true},{"text":"[ami’ty hoe]:","poem":1},{"lineBreak":true},{"text":"Mitotoke añatrefa’ i ieñey ty hazavàñe,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie andiñisako ho akibako","poem":1},{"lineBreak":true},{"text":"ty tsikeokeoke, naho añ’ieñe ao","poem":1},{"lineBreak":true},{"text":"ty andafihako i tihikoy,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa naho tokaveko i koboñey, [ty hoe:] Raeko irehe, naho i oletsey:","poem":1},{"lineBreak":true},{"text":"Ihe ty Reneko naho rahavaveko;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aia arè o fitamakoo?","poem":1},{"lineBreak":true},{"text":"I fisalalàkoy, ia ty mahaisak’ aze?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hilenteke mb’an-tsikeokeoke ao hao re?","poem":1},{"lineBreak":true},{"text":"hitrao-pitofàñe an-debok’ ao hao zahay.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}