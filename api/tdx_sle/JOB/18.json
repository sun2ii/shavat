{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Aa le hoe ty natoi’ i Bildade nte-Sohy :"]},{"type":"verse","number":2,"content":[{"text":"Pak’ ombia vaho hagado’o o volañeo? Mañaraharà heike, le hirehake zahay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa vaho akore t’ie atao biby?","poem":1},{"lineBreak":true},{"text":"te kàboke am-pihaino’o eo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ihe mandrimi-batañe ami’ty hasosora’o,","poem":1},{"lineBreak":true},{"text":"haforintseñe ty ama’o hao ty tane toy?","poem":1},{"lineBreak":true},{"text":"ke havik’ amy toe’ey ty vato?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eka, hakipeke ty jiro’ o tsereheñeo, vaho tsy haviake ty fibela’ i afo’ey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Haieñe ty hazavàñe an-kivoho’e ao, vaho hakipeke ty jiro’e ambone’e eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho tomoreñe ty lian-kaozara’e","poem":1},{"lineBreak":true},{"text":"naho hamotsak’ aze o kilili’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O fandia’eo ty hampijòñ’ aze","poem":1},{"lineBreak":true},{"text":"an-karato ao, minday aze","poem":1},{"lineBreak":true},{"text":"mb’an-tsikarakara mb’eo o lià’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsepahe’ ty fandrim-bikoviko ty tomi’e, mibitsok’ ama’e ty bitsoke","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Linembeke ho asa’e an-tane ao ty tsingere naho ty fandrik’ an-dalañe eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mañembañ’aze mb’atia mb’etia","poem":1},{"lineBreak":true},{"text":"o mampangetraketrakeo,","poem":1},{"lineBreak":true},{"text":"mañoridañ’ aze am-pandia’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Te hampibotsek’ aze ty haemberañe,","poem":1},{"lineBreak":true},{"text":"salahàñe’ ty hankàñe hikorovoha’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hatao’e tsipeake ty holi’e,","poem":1},{"lineBreak":true},{"text":"habotse’ ty tañoloñoloñan-kavilasy","poem":1},{"lineBreak":true},{"text":"o fangefange’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hombotañe an-kiboho’e ao","poem":1},{"lineBreak":true},{"text":"i niatoa’ey,","poem":1},{"lineBreak":true},{"text":"le hasese aolo’ ty mpanjakam- pangetraketrahañe eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Leo raik’ amo azeo","poem":1},{"lineBreak":true},{"text":"tsy mimoneñe an-kiboho’e ao,","poem":1},{"lineBreak":true},{"text":"famitsezam-ponde i akiba’ey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Maike o vaha’e ambane ao,","poem":1},{"lineBreak":true},{"text":"vaho binira ambone ey ty tsampa’e","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Modo an-tane atoy ty fitiahiañe aze;","poem":1},{"lineBreak":true},{"text":"tsy aman-tahinañe re an-koe añe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aronje boak’an-kazavàñe ao re","poem":1},{"lineBreak":true},{"text":"mb’an-kamoromoroñañe ao,","poem":1},{"lineBreak":true},{"text":"vaho atao soike ami’ty voatse fimoneñañe toy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie tsy hanañ’anake ndra anan’anake","poem":1},{"lineBreak":true},{"text":"am’ondati’eo,","poem":1},{"lineBreak":true},{"text":"ho po-sehanga’e ty an-kijà’e ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hilatsà’ o mpanonjohy azeo i andro’ey, hambañe ami’ty firia-tsandri’ o niaoloo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Toe Izay o akiban-tsereheñeo;","poem":1},{"lineBreak":true},{"text":"ty toe’ o tsy mahafohiñe","poem":1},{"lineBreak":true},{"text":"an’Andrianañahareo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}