{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["Aa le hoe ty natoi’ Iobe :"]},{"type":"verse","number":2,"content":[{"text":"Pak’ombia nahareo","poem":1},{"lineBreak":true},{"text":"ro mbe hampiojeoje ty troko naho hampipinepinek’ahy an-tsaontsy?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Im-polo ty nañonjira’ areo ahiko","poem":1},{"lineBreak":true},{"text":"vaho tsy mahasalats’ anahareo","poem":1},{"lineBreak":true},{"text":"ty mañaraty ahy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa naho nitò t’ie nandilatse, le midoñ’ amako avao i tahiñey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naho mivongevòngek’ amako nahareo manisý ahy amo injekoo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le mahafohina te nifotetse amako,","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"vaho narikato’e amako ty harato’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mitoreo iraho fa nikatramoeñe","poem":1},{"lineBreak":true},{"text":"fe tsy amam-pañaoñe;","poem":1},{"lineBreak":true},{"text":"mikanjy, fe tsy añomean-to.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Finahepahe’e ty lalako tsy handenàko,","poem":1},{"lineBreak":true},{"text":"naho napo’e añ’oloñoloko ao ty ieñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nampikorendahe’e amako ty engeko,","poem":1},{"lineBreak":true},{"text":"vaho nafaha’e an-dohako ao","poem":1},{"lineBreak":true},{"text":"i sabakam-bolonahetsey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Narotsa’e mb’etia mb’atia,","poem":1},{"lineBreak":true},{"text":"le fa añe iraho:","poem":1},{"lineBreak":true},{"text":"ombota’e hoe hatae ty fitamàko.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nasoleba’e amako ka ty haviñera’e","poem":1},{"lineBreak":true},{"text":"vaho atao’e ho rafelahi’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mitotoke amako o lahindefo’eo,","poem":1},{"lineBreak":true},{"text":"mitoañe mb’amako","poem":1},{"lineBreak":true},{"text":"le mitobe añariary i kibohokoy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Napo’e lavitse ahy o rahalahikoo,","poem":1},{"lineBreak":true},{"text":"vaho fonga alik’amako o nimpiamakoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Namorintseñe ahy o longokoo,","poem":1},{"lineBreak":true},{"text":"nañaliño ahy o rañekoo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O mitobok’ añ’anjombakoo,","poem":1},{"lineBreak":true},{"text":"naho o anak’ampatakoo,","poem":1},{"lineBreak":true},{"text":"songa manao ahy ho ambahiny,","poem":1},{"lineBreak":true},{"text":"toe renetane am-pahaisaha’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tokaveko ty mpitoroko, fe tsy manoiñe,","poem":1},{"lineBreak":true},{"text":"ndra te itoreovam-bavako.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mampangorý i valiko ty kofòko,","poem":1},{"lineBreak":true},{"text":"vaho heje’ ty amorin-dreneko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Manirìk’ahy o anak’ajalahio,","poem":1},{"lineBreak":true},{"text":"ie miongake iraho, onjira’ iareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Malaiñ’ahy iaby o atehenakoo;","poem":1},{"lineBreak":true},{"text":"tsambolitio’ o nikokoakoo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mipitek’ ami’ty holiko naho","poem":1},{"lineBreak":true},{"text":"ami’ty nofoko o taolakoo,","poem":1},{"lineBreak":true},{"text":"vaho an-tain-tsìko avao ty nimolaoreko.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tretrezo iraho, iferenaiño, ry rañeko;","poem":1},{"lineBreak":true},{"text":"fa nipaok’ ahy ty fitàn’Añahare.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ino ty ampisoaña’ areo ahy hoe t’ie Andrianañahare?","poem":1},{"lineBreak":true},{"text":"Tsy mahaeneñ’ anahareo hao o holikoo?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ee te nisokireñe o volako zao!","poem":1},{"lineBreak":true},{"text":"Lonike t’ie nipatereñe am-boke ao!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ee any t’ie sokirañe","poem":1},{"lineBreak":true},{"text":"an-tsantilò viñe naho firake","poem":1},{"lineBreak":true},{"text":"am-bato tsy ho modo!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa naho izaho, apotako te veloñe","poem":1},{"lineBreak":true},{"text":"i Mpijebañ’ahikoy,","poem":1},{"lineBreak":true},{"text":"ie hijohañe ambone’","poem":1},{"lineBreak":true},{"text":"o lembokeo an-tsengaha’e añe.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Le ie fa momoke ty holiko—","poem":1},{"lineBreak":true},{"text":"ty mianto toy, ho treako boak’ ami’ty nofoko t’i Andrianañahare;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Eka, hahatrea Aze iraho;","poem":1},{"lineBreak":true},{"text":"o masokoo ro hahaisak’ aze fa tsy ty ila’e.","poem":1},{"lineBreak":true},{"text":"Momoke o añ’ovakoo!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hera hanao ty hoe nahareo:","poem":1},{"lineBreak":true},{"text":"Akore ty hampisoañan-tikañ’ aze?","poem":1},{"lineBreak":true},{"text":"Ino ty lengo’e ho tendreke","poem":1},{"lineBreak":true},{"text":"hanesehañ’ aze?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mihembaña amy fibaray; amy te minday falilovam-pibara o haviñerañeo,","poem":1},{"lineBreak":true},{"text":"hahafohina’ areo te eo ty zaka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}