{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Tsofare"]},{"type":"verse","number":1,"content":["Aa le hoe ty natoi’ i Tsofare nte-Naamate:"]},{"type":"verse","number":2,"content":[{"text":"Mañetsek’ ahy hanao o fitsakoreakoo, naho","poem":1},{"lineBreak":true},{"text":"tokoen-draha ty am-pisafoañ’ ao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa tsinanoko i endake fañinjeañ’ ahiy, fe manoiñe ahy","poem":1},{"lineBreak":true},{"text":"ty arofo tsy takam-pahilàlako.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy fohi’o hao boake haehae zay,","poem":1},{"lineBreak":true},{"text":"hirik ami’ty nampipohañe ondaty","poem":1},{"lineBreak":true},{"text":"an-tane atoy?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"T’ie anianik’ avao ty hafalea’","poem":1},{"lineBreak":true},{"text":"o tsereheñeo,","poem":1},{"lineBreak":true},{"text":"mihelañe ty firebeha’ ty tsy aman-Kàke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndra te mitakatse andikerañe eñe","poem":1},{"lineBreak":true},{"text":"ty fitoabora’e,","poem":1},{"lineBreak":true},{"text":"naho mioza rahoñe i añambone’ey,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"mbe hihomake manahake o fiamonto’eo kitro-katroke;","poem":1},{"lineBreak":true},{"text":"hanao ty hoe o mpahatrea’ azeo:","poem":1},{"lineBreak":true},{"text":"Aia re?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Himosaoñe hoe nofy re,","poem":1},{"lineBreak":true},{"text":"tsy ho isake ka,","poem":1},{"lineBreak":true},{"text":"hasiotse hoe aroñaron-kaleñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho isa’","poem":1},{"lineBreak":true},{"text":"ty fihaino nahaoniñe aze;","poem":1},{"lineBreak":true},{"text":"tsy hahatrea aze ka i akiba’ey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mipay tretre amo rarakeo o ana’eo;","poem":1},{"lineBreak":true},{"text":"le soloem-pità’e o vara’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lifotse ty havitrihan-katora’e","poem":1},{"lineBreak":true},{"text":"o taola’eo,","poem":1},{"lineBreak":true},{"text":"fe hitrao fidok’ ama’e an-debok’ ao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ndra te mamy am-palie’e ao","poem":1},{"lineBreak":true},{"text":"ty halò-tsere’e","poem":1},{"lineBreak":true},{"text":"vaho aeta’e ambane famele’e ao,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ndra te tea’e, tsy foe’e, tambozore’e am-palie’e ao,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"le hiova hafaitse am-pisafoa’e ao","poem":1},{"lineBreak":true},{"text":"o mahakama’eo;","poem":1},{"lineBreak":true},{"text":"hoe vorehe’ o mereñeo ty ao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Agedra’e o varao fe haloa’e;","poem":1},{"lineBreak":true},{"text":"ampañiliñan’ Añahare","poem":1},{"lineBreak":true},{"text":"boak’ am-pisafoa’e ao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sihe’e ty vorem-pañàneñe;","poem":1},{"lineBreak":true},{"text":"avetra’ ty fitsipom-pandrefeala.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy ho sambae’e o torahañeo,","poem":1},{"lineBreak":true},{"text":"o saka midoandoan-tantele","poem":1},{"lineBreak":true},{"text":"naho hendron-drononoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Havaha’e i nifanehafa’ey, fa tsy hatele’e;","poem":1},{"lineBreak":true},{"text":"i vara niazo’e an-takinakey","poem":1},{"lineBreak":true},{"text":"tsy hahafale aze,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Amy te finorekeke’e o rarakeo","poem":1},{"lineBreak":true},{"text":"vaho nado’e ho poie’e;","poem":1},{"lineBreak":true},{"text":"nitavane’e ty anjomba tsy rinanji’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ty amy tsy fipendreñañe an-tro’e ao,","poem":1},{"lineBreak":true},{"text":"tsy apo’ i fihaña’e","poem":1},{"lineBreak":true},{"text":"te eo ty himolaotse ama’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Po-draha sisa hagodrañe;","poem":1},{"lineBreak":true},{"text":"toly ndra hihelañe añe ty firaorao’e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ami’ty haliforan-kavokara’e","poem":1},{"lineBreak":true},{"text":"ty hanjoa’e fanjirañe;","poem":1},{"lineBreak":true},{"text":"fonga atreatre’e ze fità’ o misotrio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ie boboke ty fisafoa’e le hafetsa’e ama’e","poem":1},{"lineBreak":true},{"text":"ty fiforoforoan-kaviñera’e,","poem":1},{"lineBreak":true},{"text":"hakojojoa’e ama’e t’ie mihinañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ndra te hivoratsaha’e","poem":1},{"lineBreak":true},{"text":"ty fialiam-bý, hampitrofak’ aze","poem":1},{"lineBreak":true},{"text":"ty fale torisìke.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sitoneñe, le miakatse an-dambosi’e,","poem":1},{"lineBreak":true},{"text":"i masioñe milimolimotsey","poem":1},{"lineBreak":true},{"text":"boak’ añ’afero’e ao;","poem":1},{"lineBreak":true},{"text":"vaho vovoem-pirevendreveñañe.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fimoromoroñañe ty vandroñeñe","poem":1},{"lineBreak":true},{"text":"ho amo vara’eo.","poem":1},{"lineBreak":true},{"text":"Afo tsy rarafeñe ty hamorototo aze vaho hangotomomoke ty honka’e","poem":1},{"lineBreak":true},{"text":"añ’akiba’e ao.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ho borahe’ o likerañeo o hakeo’eo;","poem":1},{"lineBreak":true},{"text":"hitroatse hiatreatrea’ ty tane toy.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ho kopaheñe ty vokatse","poem":1},{"lineBreak":true},{"text":"an-kivoho’e ao, ie hasoik’ añe amy andron-kaviñera’ey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Izay ty toly havalen’ Añahare","poem":1},{"lineBreak":true},{"text":"amy lo-tserekey,","poem":1},{"lineBreak":true},{"text":"ty ampandovaen’ Añahare aze.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}