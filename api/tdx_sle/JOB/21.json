{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Le hoe ty natoi’ Iobe:"]},{"type":"verse","number":2,"content":[{"text":"Tsatsiho o entakoo;","poem":1},{"lineBreak":true},{"text":"ehe t’ie ro hamere anahareo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iheveo hey hivolañe,","poem":1},{"lineBreak":true},{"text":"ie fa nivolañe, le mañinjea.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa naho izaho,","poem":1},{"lineBreak":true},{"text":"ondaty hao ty itoreovako?","poem":1},{"lineBreak":true},{"text":"Ino ty tsy hahatsimboetse ahy?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Isaho iraho vaho ilatsao:","poem":1},{"lineBreak":true},{"text":"akapefo am-pitàñe ty falie.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie mahatiahy iraho, le embetse;","poem":1},{"lineBreak":true},{"text":"fitititihañe ty mangazoñe ty vatako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Akore te mbe veloñe o tsereheñeo,","poem":1},{"lineBreak":true},{"text":"miha-bey,","poem":1},{"lineBreak":true},{"text":"vaho mitombo an-kaozarañe","poem":1},{"noteId":7},{"text":"?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mitrao-pimoneñe am’iareo,","poem":1},{"lineBreak":true},{"text":"am-pahaisaha’ iareo o ana’eo,","poem":1},{"lineBreak":true},{"text":"añatrefam-pihaino’ iareo","poem":1},{"lineBreak":true},{"text":"o tarira’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Soa-aro tsy an-kahembañañe","poem":1},{"lineBreak":true},{"text":"o akiba’eo;","poem":1},{"lineBreak":true},{"text":"tsy am’ iereo ty kobain’Añahare.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitongoñe o añombelahi’eo fa tsy milesa;","poem":1},{"lineBreak":true},{"text":"miterake o añombe vave’eo fa tsy mandoly.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampidadà’ iereo","poem":1},{"lineBreak":true},{"text":"hoe lia raike o ana’eo;","poem":1},{"lineBreak":true},{"text":"mitrekatreka o keleia’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kantsáñe naho marovany","poem":1},{"lineBreak":true},{"text":"ty arahe’ iareo takasy,","poem":1},{"lineBreak":true},{"text":"vaho mifale ami’ty feon-tsoly.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gadoñe’ iereo am-pibodobodoañe o andro’eo vaho mizotso mb’an-kibory ao am-pierañerañañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie nanao ty hoe aman’ Añahare:","poem":1},{"lineBreak":true},{"text":"Adono zahay!","poem":1},{"lineBreak":true},{"text":"Tsy fañiria’ay ty hahafohiñe o sata’oo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ia ze o El-Sadai zao, hitoroña’ay?","poem":1},{"lineBreak":true},{"text":"Ino ty ho tombo’e ho anay","poem":1},{"lineBreak":true},{"text":"te ihalalia’ay?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Heheke, tsy am-pità’ iareo ty hasoa, lavits’ahy","poem":1},{"lineBreak":true},{"text":"ty famerea’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Im-pire hao te akipeke","poem":1},{"lineBreak":true},{"text":"ty failo’ o tsivokatseo?","poem":1},{"lineBreak":true},{"text":"Im-pire t’ie ivovoa’ ty hankàñe?","poem":1},{"lineBreak":true},{"text":"Ie anjarà’e ty tivontivoñe","poem":1},{"lineBreak":true},{"text":"ty amy haviñera’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Boka-maike miatre-tioke iereo,","poem":1},{"lineBreak":true},{"text":"hoe kafo’e aboelen-tio-bey?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"[Hoe nahareo:] Ahajan’ Añahare","poem":1},{"lineBreak":true},{"text":"ho amo ana’eo o tahi’eo.","poem":1},{"lineBreak":true},{"text":"Ehe te hañondroke ama’e","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare, hahafohina’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Apoho ho oni-pihaino’e ty firotsaha’e, hitohofa’e ty haviñera’ i El-Sadai.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Haoñe’e hao i hasavereña’e","poem":1},{"lineBreak":true},{"text":"hanonjohy azey,","poem":1},{"lineBreak":true},{"text":"apota’e hao te voaiake o vola’eo?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ia ty hañoke hilala aman’Añahare","poem":1},{"lineBreak":true},{"text":"kanao Ie ro mizaka o an-dikerañeo?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mihomak’ ami’ty haañoña’e ty raike,","poem":1},{"lineBreak":true},{"text":"ie miaiñañoleñañe am-panintsiñañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pea ronono o korobo’eo,","poem":1},{"lineBreak":true},{"text":"lendeñe o betron-taola’eo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mivetrake ka ty aman-kafairan-troke,","poem":1},{"lineBreak":true},{"text":"le lia’e tsy nitsopeke raha mafiry.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Songa mandre andebok’ ao,","poem":1},{"lineBreak":true},{"text":"sindre saroñan-oletse.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Eka, fantako ty fikitroha’ areo,","poem":1},{"lineBreak":true},{"text":"ty fikililia’ areo hañaraty ahy.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fa hoe nahareo:","poem":1},{"lineBreak":true},{"text":"Aia ty anjomba’ i roandriañey?","poem":1},{"lineBreak":true},{"text":"Aia ty kivoho, ty fimoneña’ o lo-tserekeo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mboe tsy nañontanea’ areo hao","poem":1},{"lineBreak":true},{"text":"o mpañaveloo,","poem":1},{"lineBreak":true},{"text":"tsy apota’ areo hao o talili’ iareoo?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"te arovañe ho an-tsan-kankàñe","poem":1},{"lineBreak":true},{"text":"i tsereheñey, ho kozozoteñe mb’eo añ’androm-piforoforoañe.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ia ty hiatreatre aze ty amo lala’eo,","poem":1},{"lineBreak":true},{"text":"ia ty hañondrok’ ama’e o nanoe’eo?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ie takoneñe mb’an-kibory mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho ambenañe i lona’ey.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mamy ama’e o vongan-tane","poem":1},{"lineBreak":true},{"text":"am-bavataneo;","poem":1},{"lineBreak":true},{"text":"vaho fonga hañorik’ aze ondatio,","poem":1},{"lineBreak":true},{"text":"ie mitozantozañe ka ty niaolo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Aia arè ty añohòa’ areo","poem":1},{"lineBreak":true},{"text":"amañ’entan-kòake,","poem":1},{"lineBreak":true},{"text":"le o hatoi’ areoo,","poem":1},{"lineBreak":true},{"text":"manao hakalitahañe avao.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Sab 73:3,17, Iir 12:1-2","reference":{"chapter":21,"verse":7}}]},"thisChapterLink":"/api/tdx_sle/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}