m":1},{"lineBreak":true},{"text":"vente’e i rahalahi’oy,","poem":1},{"lineBreak":true},{"text":"vaho hinoli’o hiboridañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy nanjotsoa’o rano ty taliñiereñe hinoma’e,","poem":1},{"lineBreak":true},{"text":"vaho nitana’o amy salikoeñey","poem":1},{"lineBreak":true},{"text":"ty mahakama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tompo’ ty tane toy ty fanalolahy;","poem":1},{"lineBreak":true},{"text":"vaho mpioneñe ao ty aman-kasy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nampolie’o hara’e o vantotseo,","poem":1},{"lineBreak":true},{"text":"vaho navitso’o ty taña’ o bode-raeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Toly t’ie arikoboñem-pandrike, naho itsoborean-ka’endrahañe;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"an-kamoromoroñañe tsy hahaisaha’o,","poem":1},{"lineBreak":true},{"text":"vaho mandipots’azo ty rano bey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsy andindin-dikerañe ao hao","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare?","poem":1},{"lineBreak":true},{"text":"Isaho ka ty haabo’ o vasiañeo,","poem":1},{"lineBreak":true},{"text":"t’ie an-tiotiots’ eñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hoe irehe: Ino ty arofoanan’ Añahare? hahafiranga","poem":1},{"lineBreak":true},{"text":"o ieñe milodolodoo hao ty fizakà’e?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mañibok’ aze o rahoñe mikopokeo","poem":1},{"lineBreak":true},{"text":"tsy hahavazohoa’e,","poem":1},{"lineBreak":true},{"text":"vaho an-kivoho’ i likerañey ty fidraidraita’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Horihe’o hao i lalañe haehae","poem":1},{"lineBreak":true},{"text":"nilià’ ondaty tsereheñeoy?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O sinintoñe aolo’ ty andro’eo;","poem":1},{"lineBreak":true},{"text":"ie sinaon-drano-vohitse o faha’eo,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ie nanao ty hoe aman’ Añahare:","poem":1},{"lineBreak":true},{"text":"Ihankaño zahay; naho,","poem":1},{"lineBreak":true},{"text":"Ino ty mete hanoa’ i El-Sadai?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mbe natsafe’e hasoa avao","poem":1},{"lineBreak":true},{"text":"ty anjomba’e.","poem":1},{"lineBreak":true},{"text":"Fe lavits’ ahy ty famerea’ o tsivokatseo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Oni’ o vañoñeo Izay, le fale,","poem":1},{"lineBreak":true},{"text":"iankahafa’ o malioo añ’ inje,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"[ami’ty hoe]:","poem":1},{"lineBreak":true},{"text":"Toe naitoeñe o malaiñe anaio,","poem":1},{"lineBreak":true},{"text":"niforototoe’ ty afo","poem":1},{"lineBreak":true},{"text":"o vara’ iareoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa le mifampilongoa ama’e,","poem":1},{"lineBreak":true},{"text":"hanintsiña’o, hitotsaha’ ty soa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ehe, rambeso am-palie’e","poem":1},{"lineBreak":true},{"text":"ty Hake,","poem":1},{"lineBreak":true},{"text":"vaho ahajao añ’arofo’o ao","poem":1},{"lineBreak":true},{"text":"o tsara’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mimpolia amy El-Sadai","poem":1},{"lineBreak":true},{"text":"le ho vaoen-drehe,","poem":1},{"lineBreak":true},{"text":"ampisitaho lavitse","poem":1},{"lineBreak":true},{"text":"i kiboho’oy ty tsy to.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ahajao an-debok’ ao ty vara,","poem":1},{"lineBreak":true},{"text":"ty volamena’ i Ofire","poem":1},{"lineBreak":true},{"text":"amo vato an-torahañeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Le i El-Sadai ty ho vara’o,","poem":1},{"lineBreak":true},{"text":"ie ty volafoty ki’e ama’o,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"vaho hifalea’o t’i El-Sadai,","poem":1},{"lineBreak":true},{"text":"le hampiandrae’o aman’ Añahare","poem":1},{"lineBreak":true},{"text":"ty lahara’o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hihalaly ama’e irehe, le hijanjiña’e,","poem":1},{"lineBreak":true},{"text":"ie havaha’o o nifantà’oo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hisafiry irehe, le ho tafetetse vaho hireandreañe","poem":1},{"lineBreak":true},{"text":"amo lala’oo ty hazavàñe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Naho eo ty areke,","poem":1},{"lineBreak":true},{"text":"le hanoa’o ty hoe: tsiringèvotse!","poem":1},{"lineBreak":true},{"text":"ty mirè-batañe ro haha.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Havotso’e hao ty tsy malio tahiñe,","poem":1},{"lineBreak":true},{"text":"hañaha azo ty faliom-pità’o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}