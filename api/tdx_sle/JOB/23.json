{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Hoe ty natoi’ Iobe:"]},{"type":"verse","number":2,"content":[{"text":"Mafaitse ty toreoko henaneo,","poem":1},{"lineBreak":true},{"text":"taña-miletraletra ty amy hatreontreoko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ehe te napotako ty hahatreavako Aze,","poem":1},{"lineBreak":true},{"text":"hiheovako mb’am-piambesa’e mb’eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Halahako aolo’e eo ty amako,","poem":1},{"lineBreak":true},{"text":"vaho hatsafeko veroke ty vavako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho azoko ty entañe havale’e ahy,","poem":1},{"lineBreak":true},{"text":"vaho ho rendreko ty hitsara’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hatreatré’e ami’ty hara’elahin-kaozara’e hao?","poem":1},{"lineBreak":true},{"text":"Aiy, f’ie ho haoñe’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mete hilahatse ama’e ty vañoñe,","poem":1},{"lineBreak":true},{"text":"hamotsorañe ahy nainai’e","poem":1},{"lineBreak":true},{"text":"amy Mpizakakoy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hehe te mionjon-draho, f’ie tsy eo,","poem":1},{"lineBreak":true},{"text":"midisa-voly, fa tsy isako,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ie mitoloñ’an-kavia, tsy treako,","poem":1},{"lineBreak":true},{"text":"ie mitolike mb’àn-kavana,","poem":1},{"lineBreak":true},{"text":"tsy rendreko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe arofoana’e ty lala fombàko,","poem":1},{"lineBreak":true},{"text":"ie fa nitsoeha’e le hiboake hoe volamena.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nahafitinoñe i lia’ey ty tomboko,","poem":1},{"lineBreak":true},{"text":"nifaharako i lala’ey vaho tsy nitsile.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsy nisitahako o nafèm-pivimbi’eo;","poem":1},{"lineBreak":true},{"text":"nahajako o tsaram-palie’eo","poem":1},{"lineBreak":true},{"text":"mandikoatse ty anjara rimako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"F’ie tsy roe tsy telo,","poem":1},{"lineBreak":true},{"text":"ia ty hampitolik’ aze?","poem":1},{"lineBreak":true},{"text":"anoe’e iaby ze satrin’arofo’e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie ro mañeneke o atolots’ ahikoo:","poem":1},{"lineBreak":true},{"text":"maro ty fanoe’e hoe Izay.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le hirevendreven-draho","poem":1},{"lineBreak":true},{"text":"añ’atrefa’e eo;","poem":1},{"lineBreak":true},{"text":"izaho mitsakore, le añeveñako.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ampianifan’ Añahare ty troko,","poem":1},{"lineBreak":true},{"text":"ampangebahebae’ i El-Sadai,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe tsy naitoañ’ añatrefa’ i ieñey iraho,","poem":1},{"lineBreak":true},{"text":"naho nisaroña’e an-tareheko i fimoromoroñañey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}