{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Tsy mikafitse amy El-Sadai","poem":1},{"lineBreak":true},{"text":"o sa-o,","poem":1},{"lineBreak":true},{"text":"Akore te tsy mahaoniñe o andro’eo","poem":1},{"lineBreak":true},{"text":"o mahafohiñe azeo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ao ty mameve vorovoro:","poem":1},{"lineBreak":true},{"text":"ie mitavañe naho mampibotseke","poem":1},{"lineBreak":true},{"text":"lia-raike.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Roahe’ iareo añe ty borìkem-bode-rae,","poem":1},{"lineBreak":true},{"text":"vaho rambese’ iereo ho tsoake","poem":1},{"lineBreak":true},{"text":"ty vosi’ i vantotsey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ampisitahe’ iereo amy lalañey ty poie’e;","poem":1},{"lineBreak":true},{"text":"mitrao-pietake o rarake an-tane atoio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hehe te hoe borìke-ly","poem":1},{"lineBreak":true},{"text":"an-dratraratra añe","poem":1},{"lineBreak":true},{"text":"ty irembea’ iareo mitsindroke;","poem":1},{"lineBreak":true},{"text":"hera hamahan-kaneñe amo ana’eo","poem":1},{"lineBreak":true},{"text":"ty fatrambey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tatahe’ iereo ze haneñe an-kivok’ ao,","poem":1},{"lineBreak":true},{"text":"vaho timpone’ iereo","poem":1},{"lineBreak":true},{"text":"ty an-tanem-bahen-do-tserek’ ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Miboridañe t’ie mialeñe,","poem":1},{"lineBreak":true},{"text":"tsy aman-tsaroñe,","poem":1},{"lineBreak":true},{"text":"tsy amam-bodo amy hanintsiñey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Len-oram-bohitse iereo,","poem":1},{"lineBreak":true},{"text":"vihineñe ty lamilamy","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy amam-pipalirañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eo ty mitavam-bode-rae am-patroa","poem":1},{"lineBreak":true},{"text":"vaho andrambesan-tsoak’ ty rarake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ampandenàñe tsy aman-tsikiñe","poem":1},{"lineBreak":true},{"text":"ty miboridañe,","poem":1},{"lineBreak":true},{"text":"tavane’ iareo ty taho’ o salikoeñeo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ie mamboatse menake an-kijoly ao;","poem":1},{"lineBreak":true},{"text":"mandia am-piriritan-divay,","poem":1},{"lineBreak":true},{"text":"f’ie maran-drano.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Miñeoñeoñe an-drova ao ondatio,","poem":1},{"lineBreak":true},{"text":"mikoiake ty fiai’ o fereo;","poem":1},{"lineBreak":true},{"text":"f’ie tsy anesehan’ Añahare hagegeañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mpiamo mpiola amo hazavàñeo,","poem":1},{"lineBreak":true},{"text":"tsy fohi’ iareo o sata’eo,","poem":1},{"lineBreak":true},{"text":"tsy imoneña’ iareo o lala’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mitroatse te mazava i mpañoho-dozay, hanjevoa’e o rarakeo","poem":1},{"lineBreak":true},{"text":"naho o poie’eo,","poem":1},{"lineBreak":true},{"text":"ie haleñe manao malaso.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mandiñe mielizava","poem":1},{"lineBreak":true},{"text":"ty masom-panao havambañe,","poem":1},{"lineBreak":true},{"text":"hoe re: tsy honiñam-pihaino,","poem":1},{"lineBreak":true},{"text":"mbore honohonoe’e ty tarehe’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie añ’ieñe ro mampigorabak’ anjomba, antoandro migabeñe ao:","poem":1},{"lineBreak":true},{"text":"tsy fohi’ iereo ty hazavàñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Talinjom-piantantiritse ama’e","poem":1},{"lineBreak":true},{"text":"ty maraindray:","poem":1},{"lineBreak":true},{"text":"mahazats’ aze ty fampangebahebahan-","poem":1},{"lineBreak":true},{"text":"kamoromoroñañe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Vore mikafo an-drano eo iereo;","poem":1},{"lineBreak":true},{"text":"fatra an-tane ty anjara’e,","poem":1},{"lineBreak":true},{"text":"tsy itsileañe ty mb’an-tanem-bahe’e.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mamotseke ranom-panala","poem":1},{"lineBreak":true},{"text":"ty tariñandroke naho ty hain-tane:","poem":1},{"lineBreak":true},{"text":"Izay ka ty kibory amo manan-tahiñeo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Handikok’ aze i hoviñey;","poem":1},{"lineBreak":true},{"text":"an-kaehake ty fihinanan’ oletse aze","poem":1},{"lineBreak":true},{"text":"ampara’ te tsy tiahy ka:","poem":1},{"lineBreak":true},{"text":"ie pozaheñe hoe hatae i lo-tserekey.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Joie’e i betsiterakey,","poem":1},{"lineBreak":true},{"text":"tsy soa’e ty vantotse.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kozozote’e amañ-ozatse ty fanalolahy;","poem":1},{"lineBreak":true},{"text":"mitroatse re le iatoa’ ia ty havelo’e.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tolora’e fañarovañe, le iatoa’iareo;","poem":1},{"lineBreak":true},{"text":"mbore jilove’e o lala’iareoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Onjoneñe betebeteke iereo,","poem":1},{"lineBreak":true},{"text":"naho mifiotse añe;","poem":1},{"lineBreak":true},{"text":"afotsake naho atontoñe ao","poem":1},{"lineBreak":true},{"text":"manahake o ila’e iabio;","poem":1},{"lineBreak":true},{"text":"vaho miheatse hoe","poem":1},{"lineBreak":true},{"text":"t’ie lengom-boto-tsako.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa naho tsy Izay,","poem":1},{"lineBreak":true},{"text":"ia ty hamente t’ie mavande","poem":1},{"lineBreak":true},{"text":"hampikoake i entakoy?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}