{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Ty hoe ty natoi’ Iobe:"]},{"type":"verse","number":2,"content":[{"text":"Akore ty nañimba’o ty tsy aman’ ozatse?","poem":1},{"lineBreak":true},{"text":"ty nandrombaha’o ty sirañe","poem":1},{"lineBreak":true},{"text":"tsy an-kafatrarañe?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Akore ty nanoroa’o ty tsy aman-kilala;","poem":1},{"lineBreak":true},{"text":"ty nitaroñe’o hasoa-anatse ami’ty maro?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ia ty nañakara’o saontsy?","poem":1},{"lineBreak":true},{"text":"Vaho fañahi’ ia ty nitroboeñe ama’o?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mihelohelo ambane rano ao o loloo,","poem":1},{"lineBreak":true},{"text":"naho o mpimoneñeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miboridañe añatrefa’e eo","poem":1},{"lineBreak":true},{"text":"ty Tsikeokeoke;","poem":1},{"lineBreak":true},{"text":"tsy aman-tsaro’e ty Fandrotsahañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alama’e an-dikerañe ambone’","poem":1},{"lineBreak":true},{"text":"i hoakoakey i avaratsey;","poem":1},{"lineBreak":true},{"text":"aradorado’e ambone","poem":1},{"lineBreak":true},{"text":"hakoahañe eo ty tane toy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aholonkolo’e amo raho’eo ty rano,","poem":1},{"lineBreak":true},{"text":"fe tsy miporitsak’ ambane i rahoñey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Takona’e ty tarehe’ i zava-volañey,","poem":1},{"lineBreak":true},{"text":"alafi’e ama’e i raho’ey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nañarikatoha’e sokitse","poem":1},{"lineBreak":true},{"text":"ty an-tarehe’ o ranoo","poem":1},{"lineBreak":true},{"text":"hañefera’e amy ieñey i hazavàñey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Miezeñezeñe o fahan-dikerañeo,","poem":1},{"lineBreak":true},{"text":"mianifañe ami’ty enda’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"An-kaozarañe ty nampipendreña’e i riakey;","poem":1},{"lineBreak":true},{"text":"aman-kihitse ty nitomboha’e i Rahàbe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I kofò’ey ty ampisava’e i likerañey;","poem":1},{"lineBreak":true},{"text":"trinofam-pità’e i mereñe mitsiritsiokey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Inay, romoromom-pitoloña’e irezay,","poem":1},{"lineBreak":true},{"text":"le volam-bisibisike ty ijanjiñañe, Fe ia ty mahafohiñe i figorogodoiña’e ra’elahiy?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}