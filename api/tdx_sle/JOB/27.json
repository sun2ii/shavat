{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Tinovo’ Iobe amy lañona’ey ty hoe:"]},{"type":"verse","number":2,"content":[{"text":"Kanao veloñe t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"nitavañe ty zoko;","poem":1},{"lineBreak":true},{"text":"naho i El-Sadai","poem":1},{"lineBreak":true},{"text":"nampafaitse ty troko,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ie mbe amako ty fiaiko,","poem":1},{"lineBreak":true},{"text":"naho an-doak’ oroko ao","poem":1},{"lineBreak":true},{"text":"ty kofòn’ Añahare,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"le lia’e tsy hañoratse o soñikoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hiñeoñeo famañahiañe ty lelako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sondia’e te hiantofako ho to ty anahareo; ampara’ te hivetrake,","poem":1},{"lineBreak":true},{"text":"tsy hapitsoko amako ty fahitiko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho faharako ty havañonako","poem":1},{"lineBreak":true},{"text":"vaho tsy havotsoko;","poem":1},{"lineBreak":true},{"text":"leo raik’ amo androkoo tsy inje’ ty troko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ee te hanahake o tsereheñeo","poem":1},{"lineBreak":true},{"text":"o malaiñe ahikoo,","poem":1},{"lineBreak":true},{"text":"naho ho hambañe ami’ty tsivokatse","poem":1},{"lineBreak":true},{"text":"ty mitroatse amako.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ino ty fitamà’ ty tsy aman-Kake,","poem":1},{"lineBreak":true},{"text":"t’ie naito,","poem":1},{"lineBreak":true},{"text":"ie tsoahen’ Añahare ty fiai’e?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho janjiñen’Añahare hao ty fikoia’e","poem":1},{"lineBreak":true},{"text":"ie mivovo ama’e ty hankàñe?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hifalea’e hao t’i El-Sadai?","poem":1},{"lineBreak":true},{"text":"Ho kanjie’e nainai’e","poem":1},{"lineBreak":true},{"text":"hao t’i Andrianañahare?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hampandrendreheko anahareo","poem":1},{"lineBreak":true},{"text":"ty fitàn’ Añahare;","poem":1},{"lineBreak":true},{"text":"tsy eo ty hapoko ty amy El-Sadai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe fonga nahaisake nahareo,","poem":1},{"lineBreak":true},{"text":"akore arè t’ie mitsingevongevo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Intoy ty toly tsaharen’ Añahare","poem":1},{"lineBreak":true},{"text":"amo tsereheñeo,","poem":1},{"lineBreak":true},{"text":"ty lova azotso’ i El-Sadai","poem":1},{"lineBreak":true},{"text":"amo mampangebahebakeo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndra firefire o ana’eo","poem":1},{"lineBreak":true},{"text":"le ho amy fibaray avao;","poem":1},{"lineBreak":true},{"text":"le lia’e tsy ho enen-kaneñe o tarira’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Halente’ ty kiria o sehanga’eo,","poem":1},{"lineBreak":true},{"text":"le tsy hahafandala o ramavoi’iareoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndra te ampitoabore’e","poem":1},{"lineBreak":true},{"text":"hoe deboke ty volafoty,","poem":1},{"lineBreak":true},{"text":"naho avotri’e hoe lietse o saroñeo—","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ndra te ihentseña’e,","poem":1},{"lineBreak":true},{"text":"ho sikina’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"vaho hifanjarà’ o malio-tahiñeo","poem":1},{"lineBreak":true},{"text":"i volafotiy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsene’e hoe fararotse ty akiba’e,","poem":1},{"lineBreak":true},{"text":"hoe kibohotse faorem-pigaritse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Reketse vara t’ie màndre,","poem":1},{"lineBreak":true},{"text":"fe tsy hamokatse ka;","poem":1},{"lineBreak":true},{"text":"ie mañente, tsy eo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Imbotraha’ ty firevendreveñañe","poem":1},{"lineBreak":true},{"text":"hoe sorotombake;","poem":1},{"lineBreak":true},{"text":"itavaña’ ty tangololahy haleñe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ahela’ i tiok’ atiñanañey; le añe re;","poem":1},{"lineBreak":true},{"text":"naviovio’ i tiobeiy amy toe’ey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Eka mihiririñe mb’ama’e le tsy apo’e;","poem":1},{"lineBreak":true},{"text":"himanea’e ty hipoliotse am’pità’e.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho tehafam-pitàñe,","poem":1},{"lineBreak":true},{"text":"ho kosasaheñe hiakatse i toe’ey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}