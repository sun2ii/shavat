{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Toe ao ty lakato fitsikaraham-bolafoty naho ty toem-pitranaham-bolamena.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Akareñe an-debok’ ao ty viñe,","poem":1},{"lineBreak":true},{"text":"le tranaheñe am-bongam-bato","poem":1},{"lineBreak":true},{"text":"ty torisike.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fongore’e ty ieñe, tsikarahe’e pak’","poem":1},{"lineBreak":true},{"text":"am-para-piefera’e ao ty vato,","poem":1},{"lineBreak":true},{"text":"an-kamoromoroñañe naho","poem":1},{"lineBreak":true},{"text":"an-talinjon-kavilasy ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anokafa’e lalam-pigodañañe,","poem":1},{"lineBreak":true},{"text":"­lavi-pimoneñañe; andikofam-pandia, ­miradorado ao, mitsikadròtse ­lavits’ ondaty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ty tane toy, ama’e ty iboaha’ ty mahakama; ambane’e ao","poem":1},{"lineBreak":true},{"text":"hoe trobotroboen’ afo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Angalan-tsafira o vato’eo,","poem":1},{"lineBreak":true},{"text":"naho volamena an-debo’e ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy hay o voro-pamaokeo i lalañey;","poem":1},{"lineBreak":true},{"text":"tsy trea’ ty maso’ i hitikitikey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy nilià’ o bibi-ly mpireñetseo;","poem":1},{"lineBreak":true},{"text":"mbe tsy nipiapia ambone’e eo ty liona.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ahiti’e mb’amo vato-pilakeo ty fità’e vaho avalitaboa’e reke-bahatse","poem":1},{"lineBreak":true},{"text":"o vohitseo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kaohe’e amo vatoo ty talàha","poem":1},{"lineBreak":true},{"text":"vaho oni-pihaino’e ze atao vara.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sebaña’e o torahañeo tsy hiorike;","poem":1},{"lineBreak":true},{"text":"aboa’e mb’an-kazavàñe o raha nikafitseo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fe aia ty hahaoniñañe hihitse?","poem":1},{"noteId":8},{"lineBreak":true},{"text":"Aia ka ty toe’ o hilalao?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy fohi’ondaty ty vili’e,","poem":1},{"lineBreak":true},{"text":"toe tsy tendrek’ an-tane’ o veloñeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"hoe i lalekey, Tsy amako atoa;","poem":1},{"lineBreak":true},{"text":"le hoe i riakey, Tsy amako etoa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tsy ikaloam-bolamena,","poem":1},{"lineBreak":true},{"text":"vaho tsy andanjàm-bolafoty.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsy añoharañe ami’ty","poem":1},{"lineBreak":true},{"text":"volamena’ i Ofire,","poem":1},{"lineBreak":true},{"text":"ndra an-tsohame sarotse","poem":1},{"lineBreak":true},{"text":"ndra safira.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy añirinkiriña’ ty volamena","poem":1},{"lineBreak":true},{"text":"ndra ty kristaly,","poem":1},{"lineBreak":true},{"text":"tsy tsalohem-panake volamena ki’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy ivolañañe","poem":1},{"lineBreak":true},{"text":"ty vaton-driake ndra vato-soa;","poem":1},{"lineBreak":true},{"text":"ambone’ o hangeo ty fikaloan-kihitse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy oharañe ama’e ty pit-dae","poem":1},{"noteId":9},{"text":"’ i Kose,","poem":1},{"lineBreak":true},{"text":"tsy ibalibalihem-bolamena hiringiri’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hirik’ aia arè o hihitseo?","poem":1},{"lineBreak":true},{"text":"Vaho aia ty toe’ o hilalao?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie mikafits’ am-pihaino’","poem":1},{"lineBreak":true},{"text":"ze atao veloñe,","poem":1},{"lineBreak":true},{"text":"vaho mietak’ amo voron-tiokeo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe ty Tsikeokeoke naho i Havilasy:","poem":1},{"lineBreak":true},{"text":"fa nahatsanon-talily aze o sofi’aio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Arofoanan’ Añahare i lala’ey,","poem":1},{"lineBreak":true},{"text":"fohi’e ka i toe’ey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Jilove’e pak’ añ’olo’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"vazoho’e ze he’e ambanen-dikerañe ao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie nanolora’e lanja o tiokeo,","poem":1},{"lineBreak":true},{"text":"vaho nanjara’e an-kapoake o ranoo;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ie nafepè’e o orañeo,","poem":1},{"lineBreak":true},{"text":"naho ty lala’ o helats’ampiñeo;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Le nivazohoe’e, nitseize’e;","poem":1},{"lineBreak":true},{"text":"najado’e vaho tsinikara’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Le hoe re am’ondatio,","poem":1},{"lineBreak":true},{"text":"Inao: Ty fañeveñañe amy Talè,","poem":1},{"lineBreak":true},{"text":"Izay ro hihitse;","poem":1},{"lineBreak":true},{"text":"ty fisitahañe an-karatiañe ro hilala.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"a.28","reference":{"chapter":28,"verse":12}},{"noteId":9,"caller":"+","text":"Pit-dae: karaza-vatosoa","reference":{"chapter":28,"verse":19}}]},"thisChapterLink":"/api/tdx_sle/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}