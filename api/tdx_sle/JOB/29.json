{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["Tinoi’Iobe i lañona’ey, ami’ty hoe:"]},{"type":"verse","number":2,"content":[{"text":"Ee t’ie nanahake o volañeo,","poem":1},{"lineBreak":true},{"text":"naho o andro narovan’ Añahare ahikoo;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ie niiloilo ambone’ lohako eo ty failo’e,","poem":1},{"lineBreak":true},{"text":"naho i hazavà’ey ty nirangako añ’ieñe ao;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ie tañ’andro naha añoñ’ay ahy,","poem":1},{"lineBreak":true},{"text":"vaho tambone’ kibohoko eo","poem":1},{"lineBreak":true},{"text":"ty firañetan’ Añahare;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ie mbe tamako t’i El-Sadai,","poem":1},{"lineBreak":true},{"text":"naho niarikoboñ’ ahy o keleiakoo;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ie nisasan-kendron-dronono o liakoo,","poem":1},{"lineBreak":true},{"text":"vaho nadoandoa’ o vatoo amako","poem":1},{"lineBreak":true},{"text":"ty menake!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie niakatse mb’an-dalambein-drova mb’eo iraho,","poem":1},{"lineBreak":true},{"text":"ie rinambeko antameañe eo","poem":1},{"lineBreak":true},{"text":"i fitobohakoy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nisitak’ ahiko o ajalahio te zoeñe,","poem":1},{"lineBreak":true},{"text":"songa niongake ty bey vaho nijohañe;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nitroatse ami’ty fivesoveso’e","poem":1},{"lineBreak":true},{"text":"o roandriañeo vaho nitàm-palie.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nianjiñe ty fiarañanaña’ o roandriañeo,","poem":1},{"lineBreak":true},{"text":"le nipitek’ an-dañilañy o famele’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie jinanjin-dravembia,","poem":1},{"lineBreak":true},{"text":"le natao’e haha iraho,","poem":1},{"lineBreak":true},{"text":"ie niisam-pihaino, le nitalily ahy;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"amy te rinombako ty rarake","poem":1},{"lineBreak":true},{"text":"nikai-drombake,","poem":1},{"lineBreak":true},{"text":"i bode-rae tsy amam-pañimbay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nivotrak’ amako ty tata’ i nipetrokey,","poem":1},{"lineBreak":true},{"text":"vaho nampisaboeko an-kaehake","poem":1},{"lineBreak":true},{"text":"ty arofo’ o vantotseo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Niombeako ty havantañañe,","poem":1},{"lineBreak":true},{"text":"le nisalora’e;","poem":1},{"lineBreak":true},{"text":"nanahake ty sabaka reke-tsarimbo","poem":1},{"lineBreak":true},{"text":"ty havañonako.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ni-fihaino ami’ty fey iraho,","poem":1},{"lineBreak":true},{"text":"naho fandia amo kepekeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ni-rae’ o poie’eo,","poem":1},{"lineBreak":true},{"text":"vaho nitsikaraheko","poem":1},{"lineBreak":true},{"text":"ty nipaia’ i alik’amakoy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Pinekako ty famotsi’ o tsereheñeo naho tinavako amo nife’eo","poem":1},{"lineBreak":true},{"text":"i nitsindrohe’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Le hoe ty fitsakoreako,","poem":1},{"lineBreak":true},{"text":"t’ie hikenkañe añ’akibako ao,","poem":1},{"lineBreak":true},{"text":"naho hampimiràko amo faseñeo ty androko;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"mitsiriaria mb’an-drano o vahakoo vaho mialeñe amo tsampakoo ty zono.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Vao amako nainai’e ty engeko,","poem":1},{"lineBreak":true},{"text":"vaoeñe an-tañako ao ty faleko.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nijanjiñe naho nandiñe ahy ondatio,","poem":1},{"lineBreak":true},{"text":"nianjiñe t’ie namereako.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie nilañon-draho, tsy nisaontsy iereo,","poem":1},{"lineBreak":true},{"text":"nitsopatsopak’ am’iereo o entakoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hoe orañe ty nandiñisa’ iareo ahiko;","poem":1},{"lineBreak":true},{"text":"ie nipaña-palie","poem":1},{"lineBreak":true},{"text":"hoe aman’ oram-panjaka.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nisomilahako t’ie tsy niantoke;","poem":1},{"lineBreak":true},{"text":"le tsy nazè’ iereo ty filoeloean-tareheko.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Jinoboko ty lala hombà’ iareo","poem":1},{"lineBreak":true},{"text":"vaho nitoboke hoe talè,","poem":1},{"lineBreak":true},{"text":"nimoneñe hoe mpanjaka ami’ty borizà’e,","poem":1},{"lineBreak":true},{"text":"manahake ty mpañohòm-pandala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}