{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Modo Izay le nanoka-palie t’Iobe namatse i andro’ey,"]},{"type":"verse","number":2,"content":["hoe ty nilañone’ Iobe:"]},{"type":"verse","number":3,"content":[{"text":"Ehe te ho mongoreñe","poem":1},{"lineBreak":true},{"text":"ty andro nahatoly ahiko,","poem":1},{"lineBreak":true},{"text":"naho ty haleñe nanoeñe ty hoe:","poem":1},{"lineBreak":true},{"text":"Inao, niareñe lahilahy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ehe te ho ieñe i andro zay;","poem":1},{"lineBreak":true},{"text":"lonike te tsy ho vazohon’ Añahare","poem":1},{"lineBreak":true},{"text":"boak’ ambone ao,","poem":1},{"lineBreak":true},{"text":"vaho tsy hipisaña’ ty hazavàñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ehe t’ie ho tsepahe’ ty hamoromoroñañe naho ty talinjon-kavilasy;","poem":1},{"lineBreak":true},{"text":"lonike te hitozòhan-drahoñe;","poem":1},{"lineBreak":true},{"text":"ee te hampirevendreveñe aze","poem":1},{"lineBreak":true},{"text":"ze fonga mahamainten-gero’ i àndroy","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le i haleñe zay:","poem":1},{"lineBreak":true},{"text":"hiambotrahan-kamoromoroñañe,","poem":1},{"lineBreak":true},{"text":"tsy hitrao-pirebeke","poem":1},{"lineBreak":true},{"text":"amo andro’ i taoñeio;","poem":1},{"lineBreak":true},{"text":"tsy hizilik’ ami’ty ia’ o volañeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hete! ehe ho beitsiterake i haleñe zay,","poem":1},{"lineBreak":true},{"text":"tsy himoaham-peon-kafaleañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ee te hamatse aze","poem":1},{"lineBreak":true},{"text":"o mpamoiñ’ androo,","poem":1},{"lineBreak":true},{"text":"o veka’e hampibarakaoke i fañaneñeio,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho maieñe abey o vasiañe am-palipalitsieñeo:","poem":1},{"lineBreak":true},{"text":"angao re hipay hazavàñe fa tsy hahatrea;","poem":1},{"lineBreak":true},{"text":"ee t’ie tsy ho sambae’ ty holimaso’ i maraiñey;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"amy te tsy narindri’e i lalan-koviñey,","poem":1},{"lineBreak":true},{"text":"naho tsy nakafi’e amo masokoo","poem":1},{"lineBreak":true},{"text":"ty hasotriañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ino ty tsy nahasimb’ ahy an-koviñe ao? Akore te tsy namoeako fiay","poem":1},{"lineBreak":true},{"text":"te niboloañe?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ino ty nandrambesa’ o ongotseo ahiko? naho o fatroa ninonoakoo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie ho nihity ampitsiñañe ao;","poem":1},{"lineBreak":true},{"text":"ho niroro naho nitofa avao,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mindre amo mpanjakao","poem":1},{"lineBreak":true},{"text":"naho o mpisafiri’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"o mamboatse hakoahañe ho am-bata’eo;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"naho o ana-donak’","poem":1},{"lineBreak":true},{"text":"amam-bolamenao,","poem":1},{"lineBreak":true},{"text":"o mameno akiba am-bolafotio:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"hera ho nanahake ty tsi-ambolañe naetake,","poem":1},{"lineBreak":true},{"text":"anak’ ajaja niboloañe","poem":1},{"lineBreak":true},{"text":"mboe lia’e tsy nahatrea hazavàñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ao ty fitroara’ o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"amo firohandroha’eo;","poem":1},{"lineBreak":true},{"text":"ao ka ty fitofà’ o màmakeo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mitraok’ am-pierañerañañe","poem":1},{"lineBreak":true},{"text":"o mpirohio,","poem":1},{"lineBreak":true},{"text":"tsy mahajanjiñe ty fiarañanaña’","poem":1},{"lineBreak":true},{"text":"i mpamorekekey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ao ty bey naho ty kede:","poem":1},{"lineBreak":true},{"text":"vaho votsotse amy talè’ey ty ondevo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ino ty añomezan-kazavàñe ty misotry,","poem":1},{"lineBreak":true},{"text":"naho ty haveloñe amo mafaitse añ’ova’eo?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ze mitama hihomake, fe tsy avy,","poem":1},{"lineBreak":true},{"text":"ie tsikaraheñe mandikoatse o vara mietakeo;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"o mandia taroba naho mirebeke","poem":1},{"lineBreak":true},{"text":"t’ie nahatendreke kiborio?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"[Ino ty anoloran-kazavàñe]","poem":1},{"lineBreak":true},{"text":"amy t’indaty nietahan-dalañe,","poem":1},{"lineBreak":true},{"text":"ie nigoloboñen’Añahare?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Misolo ty fihinanako ty fiselekaiñako,","poem":1},{"lineBreak":true},{"text":"vaho midoañe hoe rano ty fitoreoko.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amy te mifetsak’ amako","poem":1},{"lineBreak":true},{"text":"o mampangebahebak’ ahikoo,","poem":1},{"lineBreak":true},{"text":"naho mivovo amako i ihembañakoy,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"tsy mierañeran-draho, tsy mipendreñe, tsy mitsiñe","poem":1},{"lineBreak":true},{"text":"fa pok’eo ty hekoheko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}