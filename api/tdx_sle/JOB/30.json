"number":5,"content":[{"lineBreak":true},{"text":"Sinoik’ an-drolongo’e iareo,","poem":1},{"lineBreak":true},{"text":"nikoraheñe hoe t’ie malaso.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le mimoneñe am-bavatane","poem":1},{"lineBreak":true},{"text":"mampangebahebak’ ao iereo,","poem":1},{"lineBreak":true},{"text":"an-dakatom-bato","poem":1},{"lineBreak":true},{"text":"naho an-kadahan-tane ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mikoaike boak’an-drongoñe ao,","poem":1},{"lineBreak":true},{"text":"mihimpok’ añ’antak’ ao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Anan-dagola, anake po-tahinañe,","poem":1},{"lineBreak":true},{"text":"nasiotsiotse amy taney.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bekobekoe’ iareo iraho henaneo","poem":1},{"lineBreak":true},{"text":"toe fandrabioña’ iareo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Heje’ iereo vintañe,","poem":1},{"lineBreak":true},{"text":"ihankaña’ iareo,","poem":1},{"lineBreak":true},{"text":"tsy apo’ iareo ty mandrora an-tareheko.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amy te navotso’e ty tàlem-pale’e","poem":1},{"lineBreak":true},{"text":"le nitrofahe’e iraho,","poem":1},{"lineBreak":true},{"text":"vaho ahifi’ iereo laboridy","poem":1},{"lineBreak":true},{"text":"te miatrek’ ahy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mitroatse an-kavanako eo o tora’eo;","poem":1},{"lineBreak":true},{"text":"fehefehè’ iereo o tombokoo","poem":1},{"lineBreak":true},{"text":"vaho atroa’ iareo amako ty satam-","poem":1},{"lineBreak":true},{"text":"pandrotsaha’ iareo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Trobotroboe’ iereo o lalakoo,","poem":1},{"lineBreak":true},{"text":"indrà’ iareo amako o feh’ ohatseo,","poem":1},{"lineBreak":true},{"text":"ndra t’ie tsy amam-pañolotse.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mizilike hoe mb’an-jeba’e","poem":1},{"lineBreak":true},{"text":"mitañataña ao iareo;","poem":1},{"lineBreak":true},{"text":"Iboroboñafa’ iareo i rinotsakey","poem":1},{"lineBreak":true},{"text":"le mikidiadia’ mb’etoy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Natolik’ amako o","poem":1},{"lineBreak":true},{"text":"fampirevendreveñañeo;","poem":1},{"lineBreak":true},{"text":"heañe’ iereo hoe tioke ty asiko;","poem":1},{"lineBreak":true},{"text":"fa nihelañe añe hoe rahoñe ty fandrombahako.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie henaneo,","poem":1},{"lineBreak":true},{"text":"fa nadoañe amako ato ty fiaiko;","poem":1},{"lineBreak":true},{"text":"fa mifelek’ ahy o ­andro","poem":1},{"lineBreak":true},{"text":"nanotriañe ahikoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsipohe’e haleñe o taolakoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy mitofa ty fikotekotehañe ahy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mampiroñaroña o sikikoo","poem":1},{"lineBreak":true},{"text":"i fañindra’e mafey vaho","poem":1},{"lineBreak":true},{"text":"vihine’e iraho manahake","poem":1},{"lineBreak":true},{"text":"i kolen’ akanjokoy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fa navokovoko’e am-potak’ ao iraho,","poem":1},{"lineBreak":true},{"text":"le ninjare hoe lavenoke naho deboke.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mikaik’ imba ama’o raho","poem":1},{"lineBreak":true},{"text":"fe tsy toiñe’o;","poem":1},{"lineBreak":true},{"text":"miongake fe angarefa’o.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Toe mpampisoañe ahy irehe:","poem":1},{"lineBreak":true},{"text":"an-kaozaram-pità’o ty isareraha’o.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ampionjone’o mb’amy tiokey mb’eo,","poem":1},{"lineBreak":true},{"text":"naho ampiningira’o,","poem":1},{"lineBreak":true},{"text":"fe atrana’o amy tio-beiy.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Apotako t’ie hasese’o mb’an-kavetrahañe mb’eo,","poem":1},{"lineBreak":true},{"text":"mb’añ’anjombam-pifañaoña’ ze kila veloñe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa tsy hañity ty fità’e hao ty","poem":1},{"lineBreak":true},{"text":"am-botrim-piantoañe eo?","poem":1},{"lineBreak":true},{"text":"tsy hikoik’ imba hao","poem":1},{"lineBreak":true},{"text":"t’ie mizò hekoheko?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tsy nitañiako hao ty nian-kòheke?","poem":1},{"lineBreak":true},{"text":"Tsy nampihontoke","poem":1},{"lineBreak":true},{"text":"ty troko hao o rarakeo?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Izaho nitama hasoa, pok’eo ty raty;","poem":1},{"lineBreak":true},{"text":"ie nandiñe hazavàñe nihohohe’ ty ieñe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mikokèntrekokèntreñe ty añovako ao le tsy mitofa;","poem":1},{"lineBreak":true},{"text":"atreatrén-tsan-kasotriañe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mijarabajaraba añ’ ieñe ao","poem":1},{"lineBreak":true},{"text":"tsy amam-panjirik’ andro,","poem":1},{"lineBreak":true},{"text":"miongak’ am-pivory naho mikaik’ imba.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Fa rahalahim-panaloke iraho,","poem":1},{"lineBreak":true},{"text":"rañe’ o voron-tsatrañeo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mikò-mainte amako ty holiko,","poem":1},{"lineBreak":true},{"text":"mitsovovoke o taolakoo ami’ty hasilo’e.","p