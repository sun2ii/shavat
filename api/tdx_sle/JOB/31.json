{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Fa nifañina amo masokoo iraho;","poem":1},{"lineBreak":true},{"text":"akore arè ty hikirofako ty somondrara?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inoñ’amy zao ty anjarako","poem":1},{"lineBreak":true},{"text":"aman’ Añahare ambone ao,","poem":1},{"lineBreak":true},{"text":"naho ty lovako amy El-Sadai","poem":1},{"lineBreak":true},{"text":"andikerañe añe?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsy feh’ohatse ho a o lo-tserekeo hao, hekoheko ho a o mpitolon-karatiañeo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy vazoho’e hao o lalakoo,","poem":1},{"lineBreak":true},{"text":"naho iahe’e iaby o liakoo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa naho nindrezako lia t’i Remborake,","poem":1},{"lineBreak":true},{"text":"ndra nalisa mb’am-pamañahiañe","poem":1},{"lineBreak":true},{"text":"mb’eo o tombokoo—","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le ehe t’ie ho lanjaeñe","poem":1},{"lineBreak":true},{"text":"am-pandanjañe to,","poem":1},{"lineBreak":true},{"text":"hahàrofoanan’Añahare ty havantañako!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Naho nitsile amy lalañey ty tomboko,","poem":1},{"lineBreak":true},{"text":"naho nañorike o masokoo ty foko,","poem":1},{"lineBreak":true},{"text":"naho nipiteha’ ty pepo o tañakoo;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"le soa iraho te hitongy hikamà’ ondaty;","poem":1},{"lineBreak":true},{"text":"vaho hombotañe ze mitiry ho ahy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naho nisigihe’ ty rakemba ty foko,","poem":1},{"lineBreak":true},{"text":"naho nivoñoñe","poem":1},{"lineBreak":true},{"text":"an-dalan-drañeko eo;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ee te ho hafa ty handisaña’ i valiko,","poem":1},{"lineBreak":true},{"text":"naho ami’ty ila’e ty hibaboha’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie ho ni-hakeo mena,","poem":1},{"lineBreak":true},{"text":"tahiñe mañeva mpizaka,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ho ni-afo namorototo","poem":1},{"lineBreak":true},{"text":"pak’an Tsikeokeok’ ao,","poem":1},{"lineBreak":true},{"text":"ho fonga nombota’e reke-bahatse","poem":1},{"lineBreak":true},{"text":"o nivokarekoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa naho ninjèko ty zo’ ondevoko","poem":1},{"lineBreak":true},{"text":"lahy ndra ampela,","poem":1},{"lineBreak":true},{"text":"ie naneseke toreo ahy;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"le ino ty hanoeko naho mitroatse","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare?","poem":1},{"lineBreak":true},{"text":"ino ty havaleko aze naho ampamolilia’e?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tsy namboatse aze ka hao i nitsene","poem":1},{"lineBreak":true},{"text":"ahy an-koviñey?","poem":1},{"lineBreak":true},{"text":"Tsy Ie avao ty nandranjy anay","poem":1},{"lineBreak":true},{"text":"an-koviñ’ ao?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa naho nitanako ami’ty poie’e ty nipaia’e, ndra nampaieñe","poem":1},{"lineBreak":true},{"text":"ty fihaino’ i vantotsey,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"naho niareñaren-draho te nitendre,","poem":1},{"lineBreak":true},{"text":"tsy nanisako ty bode—","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe ni-ajalahy iraho t’ie nibeizeko","poem":1},{"lineBreak":true},{"text":"manahake te ni-rae’e,","poem":1},{"lineBreak":true},{"text":"boak’an-kovin-dreneko ao","poem":1},{"lineBreak":true},{"text":"ty niaoloako i vantotsey—","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"aa naho nitreako ty mpirererere","poem":1},{"lineBreak":true},{"text":"tsy aman-tsikiñe,","poem":1},{"lineBreak":true},{"text":"ndra ty rarake tsy aman-tsaroñe,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"naho tsy nitahy ahy o toha’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy nampafana aze ty","poem":1},{"lineBreak":true},{"text":"volon’ añondriko;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"naho nonjoñeko haoke ty bode,","poem":1},{"lineBreak":true},{"text":"ie nitreako an-dalambey ey","poem":1},{"lineBreak":true},{"text":"hañonjonako ty ahiko;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"le angao hikalatrake","poem":1},{"lineBreak":true},{"text":"an-tsoroko ao ty fangalin-tsoroko,","poem":1},{"lineBreak":true},{"text":"vaho hapitsok’ am-pikatsoha’e","poem":1},{"lineBreak":true},{"text":"ty sirako.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Amy te mampangebahebak’ ahy","poem":1},{"lineBreak":true},{"text":"ty hankàñe boak’aman’ Añahare,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho nanoeko ty amy enge’ey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Naho natokisako ty volamena,","poem":1},{"lineBreak":true},{"text":"ndra nataoko te fiatoako","poem":1},{"lineBreak":true},{"text":"ty volamena ki’e,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"aa naho nirebehako ty hamaro o varakoo, ty amy habey natonton-tañakoy;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"naho nijiloveko i àndroy","poem":1},{"lineBreak":true},{"text":"amy fipisaña’ey,","poem":1},{"lineBreak":true},{"text":"ndra i volañey te misitse an’ enge’ey,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"naho sinigìke añ’etake ty troko vaho nañifik’oroke boak’ am-bavako ty tañako;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"le ho ni-hakeo fikai-jaka ka!","poem":1},{"lineBreak":true},{"text":"ie ho nivalik’ aman’ Añahare","poem":1},{"lineBreak":true},{"text":"ambone ao.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Naho nahafale ahy ty fiantoa’ o malaiñe ahikoo,","poem":1},{"lineBreak":true},{"text":"kera nitrehañe t’ie nivovoan-kankàñe.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tsie, tsy napoko hanan-tahiñe ty vavako hitake ty fiai’e am-pàtse—","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tsy nanao ty hoe hao","poem":1},{"lineBreak":true},{"text":"o mpitoron-kivohokoo:","poem":1},{"lineBreak":true},{"text":"Ia ty mahatrea","poem":1},{"lineBreak":true},{"text":"ty tsy nanjañe’ i mahakama’ey!—","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tsy nibabòfok’ alafe ao ty ambahiny,","poem":1},{"lineBreak":true},{"text":"fa nisokafeko amo mpañaveloo o lalakoo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aa naho naetako manahake i Dame","poem":1},{"lineBreak":true},{"text":"ty fiolàko","poem":1},{"lineBreak":true},{"text":"ndra nakafiko añ’arañako ao o hakeokoo,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ie nampiholibalà ahy i màroy,","poem":1},{"lineBreak":true},{"text":"nampianifaña’ ty inje’ o mpirofokoo,","poem":1},{"lineBreak":true},{"text":"le nitsiñe avao, tsy niakatse an-dalañe.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ee te eo ty hijanjiñe ahy!","poem":1},{"lineBreak":true},{"text":"Intoy ty soniako!","poem":1},{"lineBreak":true},{"text":"Ho toiñe’ i El-Sadai abey,","poem":1},{"lineBreak":true},{"text":"naho i taratasin-tsisý","poem":1},{"lineBreak":true},{"text":"sinokin-drafelahikoy!","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Toe ho ni-vavèko an-tsoroko Izay;","poem":1},{"lineBreak":true},{"text":"ho ni-vahoreko amako hoe sabaka;","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"ho volilieko ama’e o liakoo;","poem":1},{"lineBreak":true},{"text":"ho niatrefako hoe roandriañe.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Aa naho mitoreo amako ty taneko,","poem":1},{"lineBreak":true},{"text":"naho mitrao-pirovetse o vavahali’eo;","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"naho nihaneko ty voka’e fa tsy nandoa drala vaho nampiselekaiñe ty tompo’e,","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"le ee t’ie hitiriam-patike hasolo","poem":1},{"lineBreak":true},{"text":"ty ampemba,","poem":1},{"lineBreak":true},{"text":"hisatse hasolo ty tsako.","poem":1},"Nigadoñe amy zao ty lañona’Iobe."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}