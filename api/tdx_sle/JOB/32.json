{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":["nAa le nijihetse tsy nanoiñe Iobe indaty telo rey, ie nivañoñe am-pihaino’e avao."]},{"type":"verse","number":2,"content":["Niforoforo amy zao ty haboseha’ i Elihò",{"noteId":10},"ana’ i Barakele ana’ i Bozý",{"noteId":11},"nte-Rame",{"noteId":12},"; niforoforoe’e t’Iobe amy t’ie mañatò-vatañe añatrefan’ Añahare,"]},{"type":"verse","number":3,"content":["nahabosek’ aze ka i rañe’ Iobe telo rey amy te tsy nahavale, fe ndra namatse Iobe."]},{"type":"verse","number":4,"content":["Ie amy zao, nandiñe ty hazoke’ iareoy t’i Eliho vaho nisaontsy am’Iobe."]},{"type":"verse","number":5,"content":["Aa ie nioni’ i Eliho te tsy aman-katoi’e ty falie’ indaty telo rey, le nifombo an-kaboseke."]},{"type":"verse","number":6,"content":["Aa le nanoiñe ami’ty hoe t’i Eliho ana’ i Barakele ana’ i Bozý: Toe tora’e an-taoñe iraho, androa­navy nahareo; le nihemban-draho tsy nahavany hitaroñe ty heveko."]},{"type":"verse","number":7,"content":[{"text":"Hoe iraho: O androo ro hilañoñe,","poem":1},{"lineBreak":true},{"text":"ty hamaro taoñe ro hañoke hihitse.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe i arofo am’ondatioy,","poem":1},{"lineBreak":true},{"text":"naho i kofòn’ El-Sadaiy","poem":1},{"noteId":13},{"lineBreak":true},{"text":"ty manolo-kilala am’iareo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy t’ie antetse ro mahihitse,","poem":1},{"lineBreak":true},{"text":"tsy te zoke ro mahilala ty hatò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa le hoe iraho, Janjiño;","poem":1},{"lineBreak":true},{"text":"hitaroñe o entakoo ka.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie zao, nahaliñe o asa’ areoo iraho,","poem":1},{"lineBreak":true},{"text":"tsinanoko o niereñerea’ areoo,","poem":1},{"lineBreak":true},{"text":"ie nitsikarahe’areo ty ho lañoneñe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe nitsendreñe anahareo iraho,","poem":1},{"lineBreak":true},{"text":"fe leo raike tsy nahafandietse Iobe,","poem":1},{"lineBreak":true},{"text":"ndra raik’ ama’ areo tsy nahavale","poem":1},{"lineBreak":true},{"text":"o enta’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ko manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Nitendreke hihitse zahay;","poem":1},{"lineBreak":true},{"text":"ho roahen’ Añahare, fa tsy ondaty.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsy nalaha’e amako o saontsi’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy o lañona’areoo ty hatoiko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Angoae iereo, tsy mamale ka;","poem":1},{"lineBreak":true},{"text":"nijiañe ty saontsi’ iareo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa handiñe avao hao iraho?","poem":1},{"lineBreak":true},{"text":"ie nijohañe, tsy mahafanoiñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hivaleako ka ami’ty ahiko;","poem":1},{"lineBreak":true},{"text":"hitaroñe ty heveko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe lifo-bolan-draho;","poem":1},{"lineBreak":true},{"text":"manjitse ahy ty trok’ amako atoa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Toe manahake ty divay","poem":1},{"lineBreak":true},{"text":"tsy amam-pikofò’e ty troko,","poem":1},{"lineBreak":true},{"text":"fa hiporitsake hoe zonjòn-divay vao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Adono hivolan-draho hanintsiñako;","poem":1},{"lineBreak":true},{"text":"Apoho hanoka-tsoñy hitoiñako.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ehe te tsy eo ty ho rihieko,","poem":1},{"lineBreak":true},{"text":"ndra t’indaty ho lombofeko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy haiko ty mitsiriry","poem":1},{"lineBreak":true},{"text":"fa ho nasintan’ Andrianamboatse aniany.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Eliho: Ie t’i Andrianañahareko","reference":{"chapter":32,"verse":2}},{"noteId":11,"caller":"+","text":"Bozy: teratera","reference":{"chapter":32,"verse":2}},{"noteId":12,"caller":"+","text":"Rame: mandigiligy; naonjoñe","reference":{"chapter":32,"verse":2}},{"noteId":13,"caller":"+","text":"Andriampañotroñey, Kila lefe’e","reference":{"chapter":32,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}