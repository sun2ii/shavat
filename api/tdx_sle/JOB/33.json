{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Ie amy zao, ry Iobe, janjiño o entakoo, tsendreño iaby o volakoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hehe t’ie misoka-bava;","poem":1},{"lineBreak":true},{"text":"mirehake ty lela am-bavako ao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Habeo’ ty havantañan-troko o volakoo,","poem":1},{"lineBreak":true},{"text":"le hitaron-kilala ki’e o soñikoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nitsene ahiko t’i Arofon’Añahare,","poem":1},{"lineBreak":true},{"text":"vaho mameloñe ahy ty kofò’ i El-Sadai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toiño iraho naho mete’o;","poem":1},{"lineBreak":true},{"text":"alaharo añ’atrefako etoa; mitroara!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hehe t’ie aman’ Añahare manahake azo:","poem":1},{"lineBreak":true},{"text":"nitsenèñe am-bokon-dietse ka.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ehe, tsy hahafiriatsandry azo","poem":1},{"lineBreak":true},{"text":"ty fihembaña’o ahy,","poem":1},{"lineBreak":true},{"text":"mbore tsy havesatse ama’o te tindrieko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toe nisaontsy am-pitsanoñako irehe,","poem":1},{"lineBreak":true},{"text":"tsinendreko i fiarañanañan-dañona’oy,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Mikanitsoke iraho, tsy aman-kakeo;","poem":1},{"lineBreak":true},{"text":"ki’e tsy aman-tahiñe an-troko ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie mipay lengo’e haneseha’e ahy,","poem":1},{"lineBreak":true},{"text":"Izaho atao’e ho rafelahi’e;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ajo’e an-dongòk’ ao o tombokoo, vandroñe’e iaby o lalakoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hete! ambarako azo:","poem":1},{"lineBreak":true},{"text":"Zao ty tsy maha-to ty azo:","poem":1},{"lineBreak":true},{"text":"Jabajaba te ama’ ondaty","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ino ty atreatre’o aze, te inao,","poem":1},{"lineBreak":true},{"text":"Tsy hene volilie’e o anoe’eo?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Indraike ty itsaràn’ Añahare, he indroe,","poem":1},{"lineBreak":true},{"text":"fe tsy haoñe’ ondaty.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"amo nofioo, añ’aroñaron-kaleñe,","poem":1},{"lineBreak":true},{"text":"naho milañake an-drotse ondatio,","poem":1},{"lineBreak":true},{"text":"ie mihity an-tihy ao;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"zay ty anokafa’e ty ravembia’ ondaty naho ampipiteha’e ao ty fanoroañe,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"soa te havi’e amo sata’eo t’indaty naho sebaña’e ty firengevohan-dRaolombelo,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"hitàn-ty tro’e tsy homb-","poem":1},{"lineBreak":true},{"text":"an’tsikeokeok’ ao","poem":1},{"lineBreak":true},{"text":"naho ty fiai’e","poem":1},{"lineBreak":true},{"text":"tsy ho mongorem-pibara.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Liloveñe am-panaentaeñañe","poem":1},{"lineBreak":true},{"text":"an-tihi’e eo ondatio,","poem":1},{"lineBreak":true},{"text":"itoreova’e nainai’e o taola’eo,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ampara te heje’e ty mahakama,","poem":1},{"lineBreak":true},{"text":"vaho tsy nom-pisafoa’e ty raha mafiry.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Minik’ avao ty sandri’e,","poem":1},{"lineBreak":true},{"text":"le tsy trea;","poem":1},{"lineBreak":true},{"text":"o taola’eo tsy niisake taolo,","poem":1},{"lineBreak":true},{"text":"mirikiriky henaneo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Harivoe’ ty tro’e ty kibory,","poem":1},{"lineBreak":true},{"text":"naho ty fiai’e o mpamonoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aa naho eo ty anjely hañalañalañe ho aze, raik’ ami’ty arivo,","poem":1},{"lineBreak":true},{"text":"hañatoà’e ty havantaña’ ondaty,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"le ee te hiferenaiña’e, hanao ty hoe,","poem":1},{"lineBreak":true},{"text":"Hahao re tsy higodañe","poem":1},{"lineBreak":true},{"text":"mb’an-tsikeokeok’ ao;","poem":1},{"lineBreak":true},{"text":"fa nitreako ty vilin’ ai’e;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"le hanahake ty haleme’","poem":1},{"lineBreak":true},{"text":"ty nofon’ ajaja ty sandri’e,","poem":1},{"lineBreak":true},{"text":"Apoho himpolia’e o andron-katòra’eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mihalaly aman’ Añahare re, le no’e,","poem":1},{"lineBreak":true},{"text":"isa’e an-kafaleañe i lahara’ey,","poem":1},{"lineBreak":true},{"text":"vaho ampolie’e ama’ ondaty ty havañona’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hibekoa’e ondatio, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Nandilatse iraho, nimengoheko","poem":1},{"lineBreak":true},{"text":"ty hahiti’e vaho tsy sazò ahy;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"toe jineba’e ty troko tsy hivariña’e","poem":1},{"lineBreak":true},{"text":"mb’an-koboñ’ao,","poem":1},{"lineBreak":true},{"text":"ho isa’ ty fiaiko i fireandreañey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Inao, fanoen’ Añahare iaby rezay,","poem":1},{"lineBreak":true},{"text":"in-droe, eka in-telo amy t’indaty,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"hampolie’e boak’an-tsikeokeok’ ao","poem":1},{"lineBreak":true},{"text":"ty tro’e, hiloeloe an-kazavàn-kavelo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mitomira ry Iobe, janjiño iraho;","poem":1},{"lineBreak":true},{"text":"mianjiña le hivolañe.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ihe aman’ entañe, toiño;","poem":1},{"lineBreak":true},{"text":"mitaroña fa te hañatò azo iraho.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Naho tsie, mitsatsiha, mianjiña,","poem":1},{"lineBreak":true},{"text":"vaho hanarako hihitse.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}