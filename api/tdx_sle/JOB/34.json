{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Natovo’ i Eliho, ty hoe:"]},{"type":"verse","number":2,"content":[{"text":"Janjiño o entakoo","poem":1},{"lineBreak":true},{"text":"ry androanavy mahihitseo,","poem":1},{"lineBreak":true},{"text":"anokilaño ravembia,","poem":1},{"lineBreak":true},{"text":"ry mahafohiñeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"fa mitso-tsara ty ravembia manahake","poem":1},{"lineBreak":true},{"text":"ty fitsohan-dañilañy mahakama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Antao tika hijoboñe ty soa,","poem":1},{"lineBreak":true},{"text":"hisafirian-tika ty atao fanjàka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"amy nanoe’ Iobey, ty hoe: Vañon-draho,","poem":1},{"lineBreak":true},{"text":"fe nasintan’ Añahare amako ty zoko;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"handañirako hao i zokoy;","poem":1},{"lineBreak":true},{"text":"tsy mete melañe i trinofan-defoñey,","poem":1},{"lineBreak":true},{"text":"ndra t’ie malio-tahiñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ondaty ia ty rahamba’ Iobe?","poem":1},{"lineBreak":true},{"text":"ie migenoke inje hoe rano,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ie mpifañosoñe amo mpitolon-karatiañeo le mitrao-pañavelo","poem":1},{"lineBreak":true},{"text":"am’ondaty mengokeo?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ie nanao ty hoe, Tsy vente’e ama’ondatio te ifalea’e t’i Andrianañahare.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa le janjiño iraho, ry aman-kilálao,","poem":1},{"lineBreak":true},{"text":"Lavits’ an’ Andrianañahare","poem":1},{"lineBreak":true},{"text":"ty haratiañe,","poem":1},{"lineBreak":true},{"text":"naho amy El-Sadai ty fandilarañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa o sata’eo ty hanambeza’e ondaty,","poem":1},{"lineBreak":true},{"text":"o fitoloña’eo ro hanoly aze","poem":1},{"lineBreak":true},{"text":"ami’ty eva’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe tsy manao raty t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"vaho tsy mañolake ty hatò","poem":1},{"lineBreak":true},{"text":"t’i El-Sadai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ia ty nampamandroñ’ aze ty tane toy,","poem":1},{"lineBreak":true},{"text":"vaho ia ty nampivave aze","poem":1},{"lineBreak":true},{"text":"ty voatse bey toy?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa naho nampoli’e ama’e ty fo’ ondaty naho natonto’e ama’e i tro’ey vaho i kofo’ey,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"le fonga ho nitrao-pihomahañe ze atao nofotse;","poem":1},{"lineBreak":true},{"text":"vaho kila ho nibalike","poem":1},{"lineBreak":true},{"text":"ho lemboke ondatio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fe naho mahilala, janjiño,","poem":1},{"lineBreak":true},{"text":"tsendreño ty feo’ o entakoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hifehe hao ty malaiñe to?","poem":1},{"lineBreak":true},{"text":"Hafà’o hao i Fanalolahy Vañoñey?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I manao ty hoe ami’ty mpanjaka:","poem":1},{"lineBreak":true},{"text":"Ry Votro,","poem":1},{"lineBreak":true},{"text":"naho amo ana-donakeo, Ty Piaroteñe!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie tsy miasy roandriañe,","poem":1},{"lineBreak":true},{"text":"tsy mañaom-pañaleale","poem":1},{"lineBreak":true},{"text":"mandikoatse ty rarake,","poem":1},{"lineBreak":true},{"text":"ie fonga satam-pità’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mihomak’aniany iereo, te petsak’ale;","poem":1},{"lineBreak":true},{"text":"troboeñe ondatio le mihelañe añe,","poem":1},{"lineBreak":true},{"text":"asintake tsy am-pitàñe o maozatseo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Fa amo sata’ ondatio o fihaino’eo,","poem":1},{"lineBreak":true},{"text":"vazoho’e iaby o lia’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy eo ty ieñe ndra ty","poem":1},{"lineBreak":true},{"text":"fimoromoroñañe hietaha’ o tsereheñeo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Le tsy ifotoañan’ andro ty hiatrefa’ ondaty aman’Añahare ho zakaeñe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Demohe’e tsy an-dohy o fatratseo,","poem":1},{"lineBreak":true},{"text":"le avotra’e an-toe’e eo ty handimbe aze.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa kanao arofoana’e o sata’eo,","poem":1},{"lineBreak":true},{"text":"le avalitaboa’e te haleñe,","poem":1},{"lineBreak":true},{"text":"vaho dorodoroe’e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lafà’e manahake o tsereheñeo","poem":1},{"lineBreak":true},{"text":"an-tameañe eo ho fisambàñe,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"amy t’ie nitsile tsy nañorik’ aze,","poem":1},{"lineBreak":true},{"text":"le tsy teo t’ie nañaoñe o lala’eo,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"toly ndra nampombae’ iareo mb’ama’e ty fitoreova’ o rarakeo","poem":1},{"lineBreak":true},{"text":"fa janji’e ty toreo’ o silofeñeo—","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"naho mianjin-dre, ia ty hanìñe?","poem":1},{"lineBreak":true},{"text":"Ie aeta’e ty lahara’e,","poem":1},{"lineBreak":true},{"text":"ia ty hahaisak’ aze,","poem":1},{"lineBreak":true},{"text":"ndra t’ie foko ndra te ondaty—","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"soa tsy hifehe ty tsi-aman-Kàke,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho fandrik’ am’ ondatio.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ia ty nanao ty hoe aman’Añahare?","poem":1},{"lineBreak":true},{"text":"Fa nililoveñe, izaho tsy nandilatse;","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Anaro ahy o tsy treakoo;","poem":1},{"lineBreak":true},{"text":"naho niota faly, tsy hanoeko ka?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"I satri’oy hao ty hamalea’e Azo,","poem":1},{"lineBreak":true},{"text":"kanao liere’o?","poem":1},{"lineBreak":true},{"text":"Ihe ‘nio ty hijoboñe, fa tsy izaho;","poem":1},{"lineBreak":true},{"text":"aa le saontsio o fohi’oo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Hanao ty hoe amako ondaty mahilalao, Toe mahafijanjiñe ty androanavy mahihitse:","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Misaontsy tsy aman-kilala t’Iobe,","poem":1},{"lineBreak":true},{"text":"vaho tsy hinotsohotso’e o enta’eo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ee te ho hereherèñe pak’am-para’e t’Iobe ie nanoiñe hoe ondaty lo-tsereke.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Tompea’e fiolàñe o hakeo’eo;","poem":1},{"lineBreak":true},{"text":"miteha-pitàn-dre añivon-tikañe eo,","poem":1},{"lineBreak":true},{"text":"le manovon-tsaontsy hatreatre’e","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}