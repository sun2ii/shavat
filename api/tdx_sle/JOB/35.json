{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Le hoe ty natovo’ i Eliho:"]},{"type":"verse","number":2,"content":[{"text":"Atao’o mahity hao","poem":1},{"lineBreak":true},{"text":"i nanoe’o ty hoe,","poem":1},{"lineBreak":true},{"text":"Izaho ro vantañe te aman’ Añahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa hoe irehe, Inoñe ty ho tombo’e ho azo? Ino ty ho tambeko mandikoatse","poem":1},{"lineBreak":true},{"text":"te tsy nandilatse?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hanoiñe azo naho o rañe’o","poem":1},{"lineBreak":true},{"text":"mindre ama’oo iraho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitalakesa mb’andikerañe ey","poem":1},{"lineBreak":true},{"text":"vaho Mahaisaha;","poem":1},{"lineBreak":true},{"text":"Heheke o rahoñeo, ambòne’o iereo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ihe mandilatse, Mijoy aze hao? Ie bey hakeo, Inoñe ty anoe’o ama’e?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie vantan-drehe, ino ty atolo’o aze,","poem":1},{"lineBreak":true},{"text":"ke ino ty rambese’e am-pità’o?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho ama’ ondaty manahak’ azo","poem":1},{"lineBreak":true},{"text":"ty hatsivokara’o naho","poem":1},{"lineBreak":true},{"text":"amo ana’ ondatio ty havañona’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O hamarom-pamorekekeañeo","poem":1},{"lineBreak":true},{"text":"ty itoreova’ iareo,","poem":1},{"lineBreak":true},{"text":"ty sira maoza’ i maroy ty ikaiha’iareo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"fe tsy eo ty manao:","poem":1},{"lineBreak":true},{"text":"Aia t’i Andrianamboatse ahy,","poem":1},{"lineBreak":true},{"text":"i Mpañomey sabo an-kaleñey,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"i mañòke raha maro amantika","poem":1},{"lineBreak":true},{"text":"te amo bibi’ ty tane toioy,","poem":1},{"lineBreak":true},{"text":"vaho ampahihire’e ambone’","poem":1},{"lineBreak":true},{"text":"o voron-tiokeo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eo ty mikaike,","poem":1},{"lineBreak":true},{"text":"f’ie tsy manoiñe","poem":1},{"lineBreak":true},{"text":"ty amy firengevoha’ ondaty","poem":1},{"lineBreak":true},{"text":"raty tserekeoy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Toe tsy janjin’ Añahare ty raha kafoake;","poem":1},{"lineBreak":true},{"text":"tsy haoñe’ i El-Sadai,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Antsake t’ie manao te tsy mahaoniñe aze;","poem":1},{"lineBreak":true},{"text":"aolo’e eo ty enta’o, aa le liñiso;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie henaneo, mbe tsy nitilihe’e an-kaviñera’e, tsy loho nihaoñe’e","poem":1},{"lineBreak":true},{"text":"o fandilarañeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le evoñe ty aakam-palie’ Iobe;","poem":1},{"lineBreak":true},{"text":"ampitomboa’e lañonañe tsy aman-kilala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}