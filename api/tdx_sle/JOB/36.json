{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Natovo’ i Eliho ty hoe:"]},{"type":"verse","number":2,"content":[{"text":"Iheveo hey iraho le hitoroako te mbe aman-ko volañeñe hañonjonañe an’Andrianañahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hitoha hilala tsietoitane añe iraho,","poem":1},{"lineBreak":true},{"text":"tolorako havantañañe i Mpitsene ahiy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Toe aman-kila o entakoo;","poem":1},{"lineBreak":true},{"text":"vaho ama’o i aman-kilala fonitsey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inao maozatse t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"naho tsy mirihy;","poem":1},{"lineBreak":true},{"text":"ie fatratse an-kaozaram-paharofoanañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy tana’e ho veloñe o tsereheñeo,","poem":1},{"lineBreak":true},{"text":"fe omei’e to ty tso-troke.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy asita’e amo vantañeo o fihaino’eo;","poem":1},{"lineBreak":true},{"text":"fa ampiambesare’e ho nainai’e","poem":1},{"lineBreak":true},{"text":"amo mpanjaka am-piambesa’eo,","poem":1},{"lineBreak":true},{"text":"vaho onjone’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa ie mirohy an-tsilisily,","poem":1},{"lineBreak":true},{"text":"naho nivahoran-kasotriañe,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"le itaroña’e o sata’ iareoo","poem":1},{"lineBreak":true},{"text":"naho o fiolà’ iareoo, te mitakeboke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sokafe’e hianatse o ravembiao,","poem":1},{"lineBreak":true},{"text":"vaho lilie’e te hiambohoa’ iareo","poem":1},{"lineBreak":true},{"text":"o tsy havokarañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie mañaoñe naho mitoroñ’aze,","poem":1},{"lineBreak":true},{"text":"le amam-bokatse ty higadoña’ o andro’eo vaho am-pierañerañañe o tao’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"F’ie tsy mañaoñe,","poem":1},{"lineBreak":true},{"text":"le ho zamanem-pibara,","poem":1},{"lineBreak":true},{"text":"hiantantiritse tsy aman-kilala,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ie mañaja si-manty,","poem":1},{"lineBreak":true},{"text":"tsy aman-Kàke an-troke;","poem":1},{"lineBreak":true},{"text":"tsy mikaike olotse te rohiza’e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Robak’ an-katora’e ty sandri’iareo,","poem":1},{"lineBreak":true},{"text":"ty fiai’ iareo an-karapiloan-do.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Haha’e am-pisotria’e ty misotry;","poem":1},{"lineBreak":true},{"text":"anokafa’e ravembia i forekekeñey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Eka, tinao’e boak’ an-jitse irehe","poem":1},{"lineBreak":true},{"text":"mb’an-tameañe tsy aman-tindry;","poem":1},{"lineBreak":true},{"text":"naho lifo-tsafo’e ty hazotso","poem":1},{"lineBreak":true},{"text":"am-pandambaña’o eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"F’ie nañeneke ty fizakañe","poem":1},{"lineBreak":true},{"text":"o rati-tserekeo;","poem":1},{"lineBreak":true},{"text":"fiihine’ ty zaka naho ty hatò.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Itaò tsy hanigìk’ azo hañivañiva","poem":1},{"lineBreak":true},{"text":"ty habosehañe,","poem":1},{"lineBreak":true},{"text":"vaho apoho tsy hampitsile azo","poem":1},{"lineBreak":true},{"text":"ty habeim-bokàñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hahatohañ’azo tsy ho am-poheke hao o vara’oo?","poem":1},{"lineBreak":true},{"text":"ndra ze hene hafatraran-kaozara’o?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ko salalaeñe ty haleñe,","poem":1},{"lineBreak":true},{"text":"ie aitoañe an-toe’e ondatio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Miambena, tsy hitoliha’o ty haratiañe;","poem":1},{"lineBreak":true},{"text":"toe ie ty nijoboñe’o,","poem":1},{"lineBreak":true},{"text":"fa tsy hasotriañe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Inao! onjoñe’ ty haozara’e t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"Ia ty mpañoke mañirinkiriñe Aze?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ia ty nanendre ty lala homb’e?","poem":1},{"lineBreak":true},{"text":"Ia ty mahafivolañe ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy soa o nanoe’oo?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tiahio hey ty hañonjonañe","poem":1},{"lineBreak":true},{"text":"o fitoloña’eo, o fisaboa’ ondatio.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hene nahaisake ondatio;","poem":1},{"lineBreak":true},{"text":"talakesa’ ondaty an-tsietoitaneo","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Inao! jabahinake","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"tsy taka’ ty hilalan-tika;","poem":1},{"lineBreak":true},{"text":"tsy hay volilieñe ty ia’ o tao’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aonjo’e o pilipiton-dranoo;","poem":1},{"lineBreak":true},{"text":"ampanjaria’e orañe i evoñey;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Le ampikojojoahe’ o rahoñeo,","poem":1},{"lineBreak":true},{"text":"hitsopatsopake, hañerek’ am’ondatio.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Hete! Ia ty maharofoanañe","poem":1},{"lineBreak":true},{"text":"ty fiboelea’ o rahoñeo?","poem":1},{"lineBreak":true},{"text":"ty fangotroha’ i sokemitraha’ey?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Oniño te ampivarakaihe’e ama’e o fitsipela’eo vaho ampoa’e","poem":1},{"lineBreak":true},{"text":"ty vaha’ i riakey.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ie ro izaka’e ondatio;","poem":1},{"lineBreak":true},{"text":"naho añeneña’e mahakama.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Safora’e helatse o fità’eo,","poem":1},{"lineBreak":true},{"text":"naho lilie’e hitomboke.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mitalily aze i ampi’ey,","poem":1},{"lineBreak":true},{"text":"amo añombeo t’ie ho avy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}