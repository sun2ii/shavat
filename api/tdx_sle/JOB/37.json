{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"Inao ka, ty mampinevenevetse","poem":1},{"lineBreak":true},{"text":"ty troko","poem":1},{"lineBreak":true},{"text":"ty mampitsamboañe aze an-toe’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsatsiho ty fipoñam-piarañanaña’e,","poem":1},{"lineBreak":true},{"text":"naho i hotroke miakatse am-palie’ey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hahà’e ambanen-kaliforan-dikerañe eo naho i hela’ey pak’añ’olo-ty tane toy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mandimbe aze ty fitroñam-peo,","poem":1},{"lineBreak":true},{"text":"mangotrok’ amy fiarañanañan’ enge’ey vaho tsy ho kalaña’e i helatsey t’ie janjiñeñe","poem":1},{"lineBreak":true},{"text":"i fiarañanaña’ey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Halatsàñe ty fangotrohan’ Añahare","poem":1},{"lineBreak":true},{"text":"i fiarañanaña’ey;","poem":1},{"lineBreak":true},{"text":"ra’elahy o fitoloña’eo,","poem":1},{"lineBreak":true},{"text":"tsy lefen-tika tsikaraheñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe re amy fanalay, Mifiafià an-tane eo; naho amy orañey, Milihira.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vihine’e iaby ty fità’ondatio","poem":1},{"lineBreak":true},{"text":"hahafohina’ ze kila ondaty ty fitoloña’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mimoak’ an-dakato ao amy zao o bibio,","poem":1},{"lineBreak":true},{"text":"miampitse am-pipalira’e ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Boak’ atimo ao ty tangololahy,","poem":1},{"lineBreak":true},{"text":"boak’ avaratse añe i tsintsiñey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ty kofòn’ Añahare ro anoloram-panala,","poem":1},{"lineBreak":true},{"text":"Ajihe’e ty fibanara’ o ranoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampijinie’e halèñe","poem":1},{"lineBreak":true},{"text":"i rahoñe milodolodoy:","poem":1},{"lineBreak":true},{"text":"Ampiparaitahe’e mb’eo","poem":1},{"lineBreak":true},{"text":"o rahom-pihelara’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mibalike re, añodiña’ ty fiteha’e,","poem":1},{"lineBreak":true},{"text":"hanoa’e ze andilia’e","poem":1},{"lineBreak":true},{"text":"ambone’ o tane fimoneñañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ampahavia’e, ke t’ie kobaiñe,","poem":1},{"lineBreak":true},{"text":"ke ho an-tane’e, he te fiferenaiñañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Inao! ry Iobe, mijohaña vaho haraharao","poem":1},{"lineBreak":true},{"text":"o fitoloñan’Añahare fanjakao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fohi’o hao ty fampijadoñan’","poem":1},{"lineBreak":true},{"text":"Añahare iareo?","poem":1},{"lineBreak":true},{"text":"Ty fampipalipalitsie’e o raho’eo","poem":1},{"lineBreak":true},{"text":"himilemiletse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fohi’o hao ty fandanjan-drahoñe,","poem":1},{"lineBreak":true},{"text":"o halatsañe amy Lifo-kilalaio?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ihe aman-tsaroñe matrovoke naho","poem":1},{"lineBreak":true},{"text":"ampitsiñe’ i tiok’atimoy ty tane toy?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lefe’o hao, ihe mitraok’ ama’e,","poem":1},{"lineBreak":true},{"text":"ty mamelatse i likerañey,","poem":1},{"lineBreak":true},{"text":"an-kagàn-ketsoro natranake.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Añanaro anay ty ho saontsie’ay;","poem":1},{"lineBreak":true},{"text":"Fa tsy mahafandahatse","poem":1},{"lineBreak":true},{"text":"zahay ty amy ieñey.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hisaontsiañe hao","poem":1},{"lineBreak":true},{"text":"te izaho hivolañe?","poem":1},{"lineBreak":true},{"text":"Ihalalia’ t’indaty hao te hagedrañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy ho isa’e henaneo i hazavàñe mireandreañe an-kalo’ o rahoñeo;","poem":1},{"lineBreak":true},{"text":"naho tsy ampisavae’ i tioke mihelañey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Havolamenañe ty boak’ avaratse añe ;","poem":1},{"lineBreak":true},{"text":"aman’engeñe maharevendreveñe","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsy lefe’ay tsikaraheñe ‘nio i El-Sadai,","poem":1},{"lineBreak":true},{"text":"Jabahinak’ an’ ozatse,","poem":1},{"lineBreak":true},{"text":"fe tsy olañe’e ty zaka","poem":1},{"lineBreak":true},{"text":"naho ty havantañañe vokatse.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le mañeveñe ama’e ondatio;","poem":1},{"lineBreak":true},{"text":"leo raike tsy haoñe’e","poem":1},{"lineBreak":true},{"text":"t’ie manao kante an-troke.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}