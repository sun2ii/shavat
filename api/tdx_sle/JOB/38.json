{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":[{"text":"Nanoiñe Iobe boak’ an-talio amy zao t’Iehovà","poem":1},{"lineBreak":true},{"text":"ami’ty hoe:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ia ze o mampaieñe vere","poem":1},{"lineBreak":true},{"text":"añ’enta’e tsy aman-kilalao?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Midiaña vania hoe ondaty;","poem":1},{"lineBreak":true},{"text":"le hañontaneako,","poem":1},{"lineBreak":true},{"text":"vaho ho toiñe’o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Taia v’iheo te ­najadoko","poem":1},{"lineBreak":true},{"text":"o faha’ ty tane toio?","poem":1},{"lineBreak":true},{"text":"Taroño kanao mahilala.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia ty nisafiry o zehe’eo naho fohi’o?","poem":1},{"lineBreak":true},{"text":"he ia ty namavatse taly ama’e?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Najadoñe ami’ty inoñ’ o faha’eo?","poem":1},{"lineBreak":true},{"text":"ia ka ty nampitsatoke ty vato-lahi’e?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie hene nitrao-pisaboañe o vasia-maraiñeo vaho fonga nipoñak’ an-drebeke o anan’ Añahareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ke ia ty nampigabeñe i riakey","poem":1},{"lineBreak":true},{"text":"an-dalam-bey,","poem":1},{"lineBreak":true},{"text":"ie vaho niboloañe boak’an-koviñe ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie nitseneako saroñe an-drahoñe,","poem":1},{"lineBreak":true},{"text":"naho sokotry an-kamoromoroñañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie nafepèko o efe’eo vaho nampijadoñe ty sikada’e naho o lala’eo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ami’ty hoe: Efets’ etoa ty homba’o,","poem":1},{"lineBreak":true},{"text":"le tsy ilikoarañe;","poem":1},{"lineBreak":true},{"text":"etoañe ty hanjirañe","poem":1},{"lineBreak":true},{"text":"o onja’o mitoabotseo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa linili’o hao i maraiñey,","poem":1},{"lineBreak":true},{"text":"sikal’am-pifotoran’ andro’o añe,","poem":1},{"lineBreak":true},{"text":"he nampahafohine’o","poem":1},{"lineBreak":true},{"text":"i fanjirik’androy hao i toe’ey,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"hamihina’e o indran-taneo,","poem":1},{"lineBreak":true},{"text":"hañifihañe ama’e o lo-tserekeo?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie miova hoe lietse ambanem-boli-pitomboke,","poem":1},{"lineBreak":true},{"text":"miboake hoe volon-tsaroñe ty vinta’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fe tanañe amo tsereheñeo ty hazavà’iareo,","poem":1},{"lineBreak":true},{"text":"vaho ampipozaheñe ty sira mizonjoñe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa niziliha’o hao ty figoangoaña’","poem":1},{"lineBreak":true},{"text":"i riakey?","poem":1},{"lineBreak":true},{"text":"hera nijelanjelañe an-goledo’ i lalekey?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa nibentareñ’ ama’o hao","poem":1},{"lineBreak":true},{"text":"o lalam-bein-kavilasio?","poem":1},{"lineBreak":true},{"text":"fa niisa’o hao","poem":1},{"lineBreak":true},{"text":"o lalan-talinjom-pihomahañeo?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apota’o hao ty fienene’ ty tane toy?","poem":1},{"lineBreak":true},{"text":"abejaño naho hene fohi’o?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aia ty lalam-bam-pimoneña’ i hazavàñey?","poem":1},{"lineBreak":true},{"text":"Naho i ieñey, aia ty akiba’e?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hanesea’o mb’am-pifaritsoha’e añe: hitinoña’o o lalam-ban-kiboho’e mb’eo?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Fohi’o kanao Izay ty nisamahañ’ azo,","poem":1},{"lineBreak":true},{"text":"vaho tsivatse o andro’oo!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa nimoaha’o hao","poem":1},{"lineBreak":true},{"text":"ty fañajañe i fanalay?","poem":1},{"lineBreak":true},{"text":"Nioni’o hao ty famandroñañe","poem":1},{"lineBreak":true},{"text":"o havandrao?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"I nahajako ho an-tsan-kasotriañey,","poem":1},{"lineBreak":true},{"text":"ho amy andron-kotakotake","poem":1},{"lineBreak":true},{"text":"naho fialiañey?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lalañe aia ty ifampirià’ i hazavàñey,","poem":1},{"lineBreak":true},{"text":"ty ifampitsiriaria’ i tiok’atiñanañey","poem":1},{"lineBreak":true},{"text":"an-tane atoy?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ia ty nihaly talaha ho a","poem":1},{"lineBreak":true},{"text":"i fisorotombahañey,","poem":1},{"lineBreak":true},{"text":"ndra ty lalan-kombà’","poem":1},{"lineBreak":true},{"text":"i àmpin-kotrokey?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hahavia’ ty orañe an-tane tsy ama’ondaty, ndra an-diolio","poem":1},{"lineBreak":true},{"text":"pok’ olombeloñe,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"hahaeneñe i fatram-bey mangoakoakey hitovoaña’ i ahetsey hitiry?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Manan-drae hao i orañey?","poem":1},{"lineBreak":true},{"text":"Ke ia ty nampiareñe o tsopan-jonoo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Boak’ an-kovi’ ia o fanalao?","poem":1},{"lineBreak":true},{"text":"Le i pilitem-panalan-dikerañey,","poem":1},{"lineBreak":true},{"text":"ia ty nisamak’ aze?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ie mihagàñe hoe vato ty rano,","poem":1},{"lineBreak":true},{"text":"vaho mijihetse ty tarehe’ i lalekey?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Lefe’ o feheñe hao","poem":1},{"lineBreak":true},{"text":"o silisili’ i","poem":1},{"noteId":14},{"text":"Kimào,","poem":1},{"lineBreak":true},{"text":"ndra ampibalaheñe ty vahots’ i","poem":1},{"noteId":15},{"text":"Kesileo?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Hampiakare’o an-tsà’e hao","poem":1},{"lineBreak":true},{"text":"t’i","poem":1},{"noteId":16},{"text":"Mazarote?","poem":1},{"lineBreak":true},{"text":"Ho tehafe’o hao t’i","poem":1},{"noteId":17},{"text":"Aiìse","poem":1},{"lineBreak":true},{"text":"rekets’ o ana’eo?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Fohi’o hao o fañèn-dikerañeo?","poem":1},{"lineBreak":true},{"text":"Ho lefe’o ajadoñe hao","poem":1},{"lineBreak":true},{"text":"ty fifehea’ iareo ty tane toy?","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mahafipoña-peo mb’an-drahoñe","poem":1},{"lineBreak":true},{"text":"mb’eo v’iheo,","poem":1},{"lineBreak":true},{"text":"hahaliporañ’ azo an-drano bey?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Mahafañirake hotroke v’iheo,","poem":1},{"lineBreak":true},{"text":"hihiririña’e mb’eo,","poem":1},{"lineBreak":true},{"text":"hanoa’iareo ty hoe: Intoan-jahay?","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ia ty nampipoke hihitse an-troke ao?","poem":1},{"lineBreak":true},{"text":"Ia ka ty nanolotse hilala añ’ arofo?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ia ty mahafañiake o rahoñeo","poem":1},{"lineBreak":true},{"text":"ami’ty hihi’e?","poem":1},{"lineBreak":true},{"text":"ke mahafañiliñe o zonjon-dikerañeo,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ie ampibokobokoeñe ty deboke,","poem":1},{"lineBreak":true},{"text":"vaho mifampipiteke o vonga’eo?","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ho tsatsae’o haneñe hao ty liona?","poem":1},{"lineBreak":true},{"text":"Ho eneñe’o hao ty hatea-hane’","poem":1},{"lineBreak":true},{"text":"o liona tora’eo,","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Ie mikoloto an-dakato ao,","poem":1},{"lineBreak":true},{"text":"ie misimotse ami’ty mangongòñe ao?","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ia ty mamahan-tsindroke o koàkeo,","poem":1},{"lineBreak":true},{"text":"ie mikoaik’ aman’Añahare o ana’eo,","poem":1},{"lineBreak":true},{"text":"naho mikariokariok’ avao","poem":1},{"lineBreak":true},{"text":"tsy aman-kaneñe?","