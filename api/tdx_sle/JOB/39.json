{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"Fohi’o hao te ombia ty faneraha’","poem":1},{"lineBreak":true},{"text":"o ose-lìm-bohitseo?","poem":1},{"lineBreak":true},{"text":"Ambena’o hao ty fitsongoa’ i fanalokey?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lefe’o iaheñe hao o volañe itohera’ iareoo? Rendre’o hao","poem":1},{"lineBreak":true},{"text":"ty andro faneraha’ iareo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mivokoke iereo, hampipoke anake, hampigadoñe o fitsongoa’eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mihagañe o ana’eo,","poem":1},{"lineBreak":true},{"text":"mitombo an-kivoke ey;","poem":1},{"lineBreak":true},{"text":"ie mionjom-beo, tsy himpoly ka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia ty nañirake ty borìke ly hidada?","poem":1},{"lineBreak":true},{"text":"Ia ty nampibalake","poem":1},{"lineBreak":true},{"text":"ty rohi’ i borìke malisay?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanoeko ho kiboho’e ty fatram-bey","poem":1},{"lineBreak":true},{"text":"naho ho fimoneña’e ty tane sira.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsambolitio’e","poem":1},{"lineBreak":true},{"text":"ty fivalitsikotaha’ o rovao,","poem":1},{"lineBreak":true},{"text":"tsy rei’e ty fikoraha’ i mpiroakey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsikarahe’e amo vohitseo ty ho fihinana’e vaho tsoetsoehe’e ze hene atao antsetra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hiantofa’ ty ndrimo hao","poem":1},{"lineBreak":true},{"text":"ty hitoroñe azo?","poem":1},{"lineBreak":true},{"text":"hialeña’e hao ty an-jolo’o ao?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lefe’o hao ty hamahotse i ndrimoy","poem":1},{"lineBreak":true},{"text":"aman-tàly am-bokavoka eo,","poem":1},{"lineBreak":true},{"text":"hiava o vavahalio am-pañorihañe azo?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hatokisa’o hao,","poem":1},{"lineBreak":true},{"text":"ty harà’elahin-kaozara’ey?","poem":1},{"lineBreak":true},{"text":"Hado’o ho aze hao o fitoloña’oo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hiantofa’o hao te hampoli’e","poem":1},{"lineBreak":true},{"text":"o mahakama’oo,","poem":1},{"lineBreak":true},{"text":"te hatonto’e hirik’ am-pamofohañe ey?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mihepakepak’ an-kafalea’e o elam-boron-tsatrañeo,","poem":1},{"lineBreak":true},{"text":"ndra te matify o volon’ela’eo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa apo’e an-tane eo o atoli’eo,","poem":1},{"lineBreak":true},{"text":"ampamana’e i debokey?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amoea’e t’ie mete ho demohem-pandia,","poem":1},{"lineBreak":true},{"text":"hera ho lialiàm-bibi-ly.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ampisoañe’e o ana’eo, hoe t’ie tsy aze;","poem":1},{"lineBreak":true},{"text":"aa ndra te tsy vente’e o fitoloña’eo","poem":1},{"lineBreak":true},{"text":"tsy ahoa’e;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe tsy natolon’Añahare hihitse,","poem":1},{"lineBreak":true},{"text":"vaho tsy nandivà’e hilala.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie mitroatse hitoabora’e le tohafa’e","poem":1},{"lineBreak":true},{"text":"ty soavala reke-piningitse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tinolo’o ozatse hao ty soavala?","poem":1},{"lineBreak":true},{"text":"Sinaro’o fineveneverañe hao","poem":1},{"lineBreak":true},{"text":"ty an-kàto’e ao?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ihe hao ty nampitsindrèko aze","poem":1},{"lineBreak":true},{"text":"hoe valala?","poem":1},{"lineBreak":true},{"text":"Mampañeveñe ty engem-pikofoha’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Jaote’e ty am-bavatane,","poem":1},{"lineBreak":true},{"text":"irebeha’e i haozara’ey;","poem":1},{"lineBreak":true},{"text":"mionjomb’eo re hijoñe","poem":1},{"lineBreak":true},{"text":"mb’an-kotakotake.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Iankahafa’e ty tahotse, tsy hemban-dre;","poem":1},{"lineBreak":true},{"text":"tsy iambohoa’e ty fibara.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mikantsakantsàñe ama’e","poem":1},{"lineBreak":true},{"text":"ty trañom-pale’e","poem":1},{"lineBreak":true},{"text":"i lefoñe mitsopelatsey,","poem":1},{"lineBreak":true},{"text":"naho i ana-defoñey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Abotse’e an-trotrofiake ty tane","poem":1},{"lineBreak":true},{"text":"naho an-doroloro;","poem":1},{"lineBreak":true},{"text":"tsy ampitsangane’ ty fivolan’ antsivay.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ndra mbia’mbia mipopò i antsivay","poem":1},{"lineBreak":true},{"text":"le hoe ty kofò’e: Hirity!","poem":1},{"lineBreak":true},{"text":"Antsoñe’e añe i hotakotakey, ty fihotrohotro’ o mpifeheo,","poem":1},{"lineBreak":true},{"text":"vaho i fikorahan’ aliy.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ami’ty hihi’o hao ty itiliña’","poem":1},{"lineBreak":true},{"text":"i tsimalahoy,","poem":1},{"lineBreak":true},{"text":"ty amelara’e mañatimo o ela’eo?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ami’ty taro’o hao ty fañambonea’","poem":1},{"lineBreak":true},{"text":"ty vantio","poem":1},{"lineBreak":true},{"text":"hañamboara’e traño andigiligy eñe?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Himoneña’e an-kereretsak’ ey;","poem":1},{"lineBreak":true},{"text":"hañialoa’e an-tseram-bato tsy takatse eñe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Talakese’e boak’ao ty tsindro’e;","poem":1},{"lineBreak":true},{"text":"mahatrea lavitse o maso’eo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Misike lio o ana’e tora’eo;","poem":1},{"lineBreak":true},{"text":"Amy vinonoy ty toe’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}