{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Le hoe ty natoi’ i Elifaze nte-Temane :"]},{"type":"verse","number":2,"content":[{"text":"Hampihivivioke azo hao","poem":1},{"lineBreak":true},{"text":"ty fimanea’ay rehak’ ama’o?","poem":1},{"lineBreak":true},{"text":"fa Ia ty maha-lie-batañe tsy hivolañe?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ingo te maro ty nanare’o,","poem":1},{"lineBreak":true},{"text":"fa nampaozare’o ty fitañe mavozo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fiatoa’ o mitsikapio o saontsi’oo;","poem":1},{"lineBreak":true},{"text":"nampifatrare’o o ongotse mikoletrao;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"F’ie nizò azo henaneo,","poem":1},{"lineBreak":true},{"text":"ihe ka ty midazidazìtse; nioza ama’o, le minevenevetse;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy o havañona’oo hao ty fatokisa’o","poem":1},{"lineBreak":true},{"text":"vaho fitamà’o ty fahitin-dala’o?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ehe, tiahio hey:","poem":1},{"lineBreak":true},{"text":"Ia ty nikoromake te nalio-tahiñe?","poem":1},{"lineBreak":true},{"text":"Aia ty vañoñe naitoeñe?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa naho o nitreakoo:","poem":1},{"lineBreak":true},{"text":"hambañe ty tatahe’ ty mpitraba-karatiañe,","poem":1},{"lineBreak":true},{"text":"naho ty mpitongy kilily.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie mihomak’ ami’ty kofòn’ Añahare,","poem":1},{"lineBreak":true},{"text":"mikoromak’ ami’ty","poem":1},{"lineBreak":true},{"text":"fiforoaham-pifombo’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitromoro ty liona","poem":1},{"lineBreak":true},{"text":"mireñetse ty liona romotse,","poem":1},{"lineBreak":true},{"text":"fe poñafeñe o nifem-parasy tora’eo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mate ty liona-lahi’e te po-tsindroke,","poem":1},{"lineBreak":true},{"text":"mibarakaike ty anan-diona rene’e,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nasese amako añ’etake ty volañe,","poem":1},{"lineBreak":true},{"text":"nitsepahen-tsòfiko ty nitangongoe’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nitsakoreñe añ’aroñaron-kaleñe,","poem":1},{"lineBreak":true},{"text":"ie lampon-drotse ondatio,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Niazo ty anifan-draho, nirevendreveñe, nampititititihe’e o taolako iabio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nihelañe añatrefan-tareheko eo","poem":1},{"lineBreak":true},{"text":"ty angatse,","poem":1},{"lineBreak":true},{"text":"niriñariña o volon-tsandrikoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nijohan-dre,","poem":1},{"lineBreak":true},{"text":"fe tsy nirendreko ty vinta’e;","poem":1},{"lineBreak":true},{"text":"nitroatse aolo’ o masokoo ty vente’e,","poem":1},{"lineBreak":true},{"text":"nianjiñe, le inao ty fiarañanañañe","poem":1},{"lineBreak":true},{"text":"nanao ty hoe :","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ho to añatrefan’ Añahare hao","poem":1},{"lineBreak":true},{"text":"t’i raolombelo?","poem":1},{"lineBreak":true},{"text":"halio te amy Namboatse azey hao ondatio?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Heheke ndra o mpitoro’eo tsy atokisa’e,","poem":1},{"lineBreak":true},{"text":"mbore anisia’e lilatse o anjeli’eo,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Àntsake o mpimoneñe an-traño taneo,","poem":1},{"lineBreak":true},{"text":"O faha’eo an-debok’ ao, ie ho pìneke aolo’ ty fizara!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ie demok’ añivo’ ty manjirik’andro naho ty haleñe;","poem":1},{"lineBreak":true},{"text":"modo kitro-katroke tsy ihaoñañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy nombotañe an-tro’e ao","poem":1},{"lineBreak":true},{"text":"hao o talin-kivoho’eo?","poem":1},{"lineBreak":true},{"text":"Ie mihomak’ avao, tsy aman-kilala!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}