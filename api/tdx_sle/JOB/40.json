{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Tinovo’ Iehovà am’Iobe ty hoe,"]},{"type":"verse","number":2,"content":[{"text":"Hatretrè’ ty mpandietse hao","poem":1},{"lineBreak":true},{"text":"t’i El-Sadai?","poem":1},{"lineBreak":true},{"text":"Manoiña, ry mpañeretse","poem":1},{"lineBreak":true},{"text":"an’ Andrianañahareo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanoiñe Iehovà ami’ty hoe t’Iobe:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Intoy o tsy manjofakeo;","poem":1},{"lineBreak":true},{"text":"ino ty hahatoiñako azo?","poem":1},{"lineBreak":true},{"text":"Hampikapefe’ ty tañako ty vavako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Indraike ty nivolañeko","poem":1},{"lineBreak":true},{"text":"fa tsy ho tovoñako;","poem":1},{"lineBreak":true},{"text":"eka, indroe, fa tsy ho losoreko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le nanoiñe Iobe t’Iehovà boak’","poem":1},{"lineBreak":true},{"text":"an-talio ao, ami’ty hoe,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Midiaña hoe ondaty;","poem":1},{"lineBreak":true},{"text":"hañontaneako","poem":1},{"lineBreak":true},{"text":"le ihe ty hitaroñe amako.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hafote’o hao o zakakoo?","poem":1},{"lineBreak":true},{"text":"Hamatse ahy irehe, hahazoa’o to?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amam-pitàñe manahake","poem":1},{"lineBreak":true},{"text":"añ’Andrianañahare v’iheo?","poem":1},{"lineBreak":true},{"text":"Mahafañotrok’ am-peo","poem":1},{"lineBreak":true},{"text":"hambañ’ ama’e hao?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mihamina amañ’engeñe","poem":1},{"lineBreak":true},{"text":"naho havañonañe;","poem":1},{"lineBreak":true},{"text":"misaroña asiñe naho volonahetse;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Adoaño o habose’o mandopatseo;","poem":1},{"lineBreak":true},{"text":"jilovo ze hene mpirengevoke","poem":1},{"lineBreak":true},{"text":"vaho afotsaho.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fonga rendreho ty mpibohaboha,","poem":1},{"lineBreak":true},{"text":"le arèho;","poem":1},{"lineBreak":true},{"text":"lialiao ambane o lo-tserekeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Akafiro hitraofa’e an-debok’ ao;","poem":1},{"lineBreak":true},{"text":"vahoro añ’etak’ ao o lahara’ iareoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le hiantofako ama’o te mahafandrombak’ azo o fità’o havanao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Oniño hey ty Behemote,","poem":1},{"lineBreak":true},{"text":"i naharoko fitseneañe ama’oy;","poem":1},{"lineBreak":true},{"text":"mihinañe ahetse re manahake o añombeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Heheke te am-poto-pe’e ao ty haozara’e, amo ozan-tro’eo","poem":1},{"lineBreak":true},{"text":"ty hafatrara’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Atora-kitsi’e hoe talý ty ohi’e;","poem":1},{"lineBreak":true},{"text":"mifamanditse iaby o talin-ozan-toha’eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Boda torisike o taola’eo,","poem":1},{"lineBreak":true},{"text":"hoe tsotsò-by o kitso’eo","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie ty lohàñe amo satan’ añahareo;","poem":1},{"lineBreak":true},{"text":"I namboatse azey","poem":1},{"lineBreak":true},{"text":"ro mahafitotok’ ama’e am-pibara.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Toe mamahan-kaneñe aze o vohitseo,","poem":1},{"lineBreak":true},{"text":"amy fihisa’ o bibin-kivoke iabioy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mandre ambane’ sohihy eo re,","poem":1},{"lineBreak":true},{"text":"am-pipaliram-binda","poem":1},{"lineBreak":true},{"text":"an-tane manginakinak’ ao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mañalok’ aze ty talinjo’ o ­sohihio; miarikoboñ’ aze iaby","poem":1},{"lineBreak":true},{"text":"o bararata añ’olon-dranoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsy ihondrahondrà’e","poem":1},{"lineBreak":true},{"text":"ty fandipora’ i sakay;","poem":1},{"lineBreak":true},{"text":"mahasibeke re ndra te isorotombaha’","poem":1},{"lineBreak":true},{"text":"Iordaney mb’am-bava’e.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eo hao ty hahatsepak’aze te mañente; eo hao ty hahafangirike i oro’ey","poem":1},{"lineBreak":true},{"text":"hampikavitse aze?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mahatarike i","poem":1},{"noteId":18},{"text":"Leviatàne","poem":1},{"lineBreak":true},{"text":"am-bintañe v-iheo?","poem":1},{"lineBreak":true},{"text":"hatindri’o ambane an-tàly hao i lela’ey?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lefe’o hao ty mampikiviro i oro’ey,","poem":1},{"lineBreak":true},{"text":"ndra ty hangirike","poem":1},{"lineBreak":true},{"text":"i soma’ey am-pengoke?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hanao lako halaly ama’o hao re?","poem":1},{"lineBreak":true},{"text":"Ke hivolañe mora ama’o?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hifañina ama’o hao, handrambesa’o aze","poem":1},{"lineBreak":true},{"text":"ho fetrek’oro’o kitro katroke?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ho hisà’o hao hoe voroñe?","poem":1},{"lineBreak":true},{"text":"ke ho tantalie’o ho amo anak’ ampela’oo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hifampihehetse ama’e hao","poem":1},{"lineBreak":true},{"text":"o mpanao balikeo?","poem":1},{"lineBreak":true},{"text":"Ho zarae’ iareo am’","poem":1},{"lineBreak":true},{"text":"o mpanao takinakeo hao re?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ho tsitsihem-pirango hao i holi’ey?","poem":1},{"lineBreak":true},{"text":"Ndra i loha’ey an-defom-piañe?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Apaoho ama’e ty fità’o vaho tiahio i ho ali’oy te tsy hindroe’o.","poem":1}]}],"footnotes":[{"noteId":18,"caller":"+","text":"Leviatane: fañanen-driake bey haehae","reference":{"chapter":40,"verse":25}}]},"thisChapterLink":"/api/tdx_sle/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":32}