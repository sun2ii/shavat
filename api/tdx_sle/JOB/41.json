{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Hete! Toe tsy vente’e t’ie salalaeñe,","poem":1},{"lineBreak":true},{"text":"tsy ho tafahohoke hao te isahañe?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I Tsy eo ty lahitsi’ay mahavany","poem":1},{"lineBreak":true},{"text":"hitsobore aze;","poem":1},{"lineBreak":true},{"text":"ia arè ty mahafiatreatre amako?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ia ty nanolotse ahy, te havahako?","poem":1},{"lineBreak":true},{"text":"ahiko ze hene ambanen-dikerañe ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy hitsiñeko o kitso’eo,","poem":1},{"lineBreak":true},{"text":"ty haozara’e ra’elahiy,","poem":1},{"lineBreak":true},{"text":"vaho i sandri’e tsaratseakey,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia ty hañolitse o sisin-koli’eo?","poem":1},{"lineBreak":true},{"text":"Ia ty hahafizilik’","poem":1},{"lineBreak":true},{"text":"añivom-balañorà’e roe ao?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ia ty mahafisokake","poem":1},{"lineBreak":true},{"text":"o lalam-bein-tarehe’eo?","poem":1},{"lineBreak":true},{"text":"mampangetraketrake ty fañarikatoha’ o nife’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fisengea’e o sisì’e fatratseo,","poem":1},{"lineBreak":true},{"text":"ie mikititse hoe linite;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Akore ty fifampikiteha’e","poem":1},{"lineBreak":true},{"text":"kanao tsy mahafitsifitse ao ty tioke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nifampireketeñe iereo,","poem":1},{"lineBreak":true},{"text":"mifampipiteke, tsy lefe akatrake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitsopela-kazavàñe o fihatsìhe’eo,","poem":1},{"lineBreak":true},{"text":"manahake ty holi-maso’","poem":1},{"lineBreak":true},{"text":"i maraindraiñey o maso’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Failo milebaleba ty miakatse am-bava’e, afo mipelatse ty mipitsike mb’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mañatoeñe o loa-koro’eo,","poem":1},{"lineBreak":true},{"text":"hoe valàñe mamorotse","poem":1},{"lineBreak":true},{"text":"ambone vinda mirehetse.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mamiañe foroha ty kofò’e,","poem":1},{"lineBreak":true},{"text":"afo misodotse ty miboak’ am-bava’e ao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mimoneñe an-kàto’e ty haozarañe,","poem":1},{"lineBreak":true},{"text":"vaho mitsinjak’ aolo’e eo ty miroreke.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mifampirekets’ ama’e i holi’e mifanosokeo, gañe ama’e Izay tsy mete asitse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gañe hoe vato ty fo’e;","poem":1},{"lineBreak":true},{"text":"manahake ty hamafem-bato-lisañe ambane.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ie mivoalatse, miholi-tsandry","poem":1},{"lineBreak":true},{"text":"o fanalolahio; ie vereñe mamoe’ay.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy lefe t’ie liherem-pibara, ndra lefoñe, ndra ana-defo, ndra","poem":1},{"lineBreak":true},{"text":"baramino masioñe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Atao’e ho boka maike ty viñe,","poem":1},{"lineBreak":true},{"text":"naho hatae voroke ty torisìke.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy mahafandrifitse aze o ana-paleo;","poem":1},{"lineBreak":true},{"text":"atao’e forompotse o vato-piletseo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tonton-drongoñe ama’e o kobaiñeo, tohafa’e o lefoñe mikaratsakaratsakeo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Silam-balañe-tane masioñe ty ambane’e, hoe mamofopofoke ampemba t’ie miranga fotake.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ampitroatroahe’e hoe valàñe i lalekey;","poem":1},{"lineBreak":true},{"text":"ampanahafe’e ami’ty fampitranahañe rano mañitse i riakey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Anoe’e lala-miloeloe ty am-boho’e ao","poem":1},{"lineBreak":true},{"text":"anoe’e hoe a maròy foty i lalekey.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tsy ambone-tane atoy","poem":1},{"lineBreak":true},{"text":"ty mañirinkiriñe aze,","poem":1},{"lineBreak":true},{"text":"ie nitsenèñe tsy ho aman-tahotse.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Jilojilove’e iaby ze atao abo;","poem":1},{"lineBreak":true},{"text":"ie ty lohà’ ze hene anam-pirengevohañe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":26}