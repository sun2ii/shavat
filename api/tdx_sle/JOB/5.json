{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Mikoiha arè! ia ty ao t’ie hanoiñe azo!","poem":1},{"lineBreak":true},{"text":"Ia amo masiñeo ty hitoliha’o?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mañe-doza ami’ty minè ty hasosora’e,","poem":1},{"lineBreak":true},{"text":"zevoñe’ i famarahia’ey ty derendereñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nitreako te nivahatse ty dagola,","poem":1},{"lineBreak":true},{"text":"fe nozoñeko amy zao ty akiba’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lavi-pipalirañe o tiri’eo,","poem":1},{"lineBreak":true},{"text":"demoheñe an-dalambey ey,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty mpandrombake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kamae’ o salikoeñeo ty nitatahe’e,","poem":1},{"lineBreak":true},{"text":"tsindrohe’ iereo boak’am-patik’ao;","poem":1},{"lineBreak":true},{"text":"midañadaña amo vara’eo ty kòboñe","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy miboak’ an-debok’ ao ty hasotriañe,","poem":1},{"lineBreak":true},{"text":"naho tsy mitiry an-tane ao ty hankàñe;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe ampoheke t’indaty te samake","poem":1},{"lineBreak":true},{"text":"manahake ty fionjona’ ty fipitsin’afo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Izaho ho nipay an’Andrianañahare","poem":1},{"lineBreak":true},{"text":"vaho i Andrianamboatse","poem":1},{"lineBreak":true},{"text":"ty nitaroñako o entakoo—","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"amy Mpanao raha mampañeveñe","poem":1},{"lineBreak":true},{"text":"tsy taka-tsikaraheñey,","poem":1},{"lineBreak":true},{"text":"raha tsitantane tsivatse.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I mampahavy orañe an-tane atoy,","poem":1},{"lineBreak":true},{"text":"vaho mañirake rano an-teteke ey;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hampitongoà’e ambone o mirèkeo,","poem":1},{"lineBreak":true},{"text":"le honjonem-b’am-pipalirañe o mandalao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Avorembore’e ty kilili’ o kalitakeo, soa tsy hahapi-draha o taña’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsepahe’e ami’ty fikitrofa’e","poem":1},{"lineBreak":true},{"text":"o kanteo,","poem":1},{"lineBreak":true},{"text":"vaho misaok’ añe ty fikinià’o mengokeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie manjo ieñe te antoandro,","poem":1},{"lineBreak":true},{"text":"mijimenjimè hoe an-kaleñe","poem":1},{"lineBreak":true},{"text":"te tsipinde-mena.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fe rombahe’e am-pibara am-bava’iareo, ty rarake am-pità’ o maozatseo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa le aman-ko tamae’e o rarakeo,","poem":1},{"lineBreak":true},{"text":"fe mampikite-bava ty haratiañe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Haha t’indaty endahan’ Añahare;","poem":1},{"lineBreak":true},{"text":"le ko tsambolitio’o","poem":1},{"noteId":3},{"text":"ty fandilova’ i El-Sadai.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie mandafa, le bandie’e;","poem":1},{"lineBreak":true},{"text":"mitrabake, le melañe’ o fità’eo.","poem":1},{"noteId":4}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho haha’e irehe","poem":1},{"lineBreak":true},{"text":"am-peh’ohatse eneñe;","poem":1},{"lineBreak":true},{"text":"Eka, im-pito tsy hipaok’ azo ty hankàñe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho jebañe’e ami’ty havilasy irehe","poem":1},{"lineBreak":true},{"text":"an-tsan-kerè,","poem":1},{"lineBreak":true},{"text":"naho ami’ty haozara’ i fibaray","poem":1},{"lineBreak":true},{"text":"an-tsàn’aly.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Harovan-drehe ami’ty fifiaham-pameleke, f’ie tsy ho hembañe","poem":1},{"lineBreak":true},{"text":"te itsatohan-kekoheko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hiankahafa’o ty hankàñe naho ty kerè,","poem":1},{"lineBreak":true},{"text":"le tsy hatahora’o ze bibi’ ty tane toy.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ie hirai-lia amo vato an-tetekeo","poem":1},{"lineBreak":true},{"text":"vaho hiharo-rehak’ ama’o","poem":1},{"lineBreak":true},{"text":"o biby an-kivokeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho rendre’o te mierañerañe ty akiba’o,","poem":1},{"lineBreak":true},{"text":"ho tilihe’o ty golobo’o","poem":1},{"lineBreak":true},{"text":"le tsy ho motso ze ama’e ao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ho fohi’o te maro o ana’oo,","poem":1},{"lineBreak":true},{"text":"ho mira ami’ty hatsifotofoto’ o ahetse","poem":1},{"lineBreak":true},{"text":"an-tane atoio o tarira’oo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Homb’an-kibori’o ao irehe","poem":1},{"lineBreak":true},{"text":"ami’ty haañon-kaantera’o,","poem":1},{"lineBreak":true},{"text":"manahake ty fitroara’ o toboron’","poem":1},{"lineBreak":true},{"text":"ampembao an-tsa’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Heheke! fa nitsikarahe’ay, le ie Izay.","poem":1},{"lineBreak":true},{"text":"Inao! irendreho, ho ami’ty hasoa’o.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Rzs 3:12, Heb 12:6-8","reference":{"chapter":5,"verse":17}},{"noteId":4,"caller":"+","text":"Iir 32:42, Frv 3:31-32, Hos 6:1","reference":{"chapter":5,"verse":18}}]},"thisChapterLink":"/api/tdx_sle/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}