{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Nanoiñe amy zao t’Iobe:"]},{"type":"verse","number":2,"content":[{"text":"Ee te linanja o ha’emberakoo,","poem":1},{"lineBreak":true},{"text":"vaho natrao-fipoke am-balantsy ao","poem":1},{"lineBreak":true},{"text":"o ha’ampohekoo!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa ho nandikoatse ty lanja’","poem":1},{"lineBreak":true},{"text":"ze kila faseñe an-driak’ ao:","poem":1},{"lineBreak":true},{"text":"Aa le nitsoretoke t’ie nivolañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa amako ao o ana-pale’","poem":1},{"lineBreak":true},{"text":"i El-Sadaio;","poem":1},{"lineBreak":true},{"text":"inome’ ty troko ty vore’e;","poem":1},{"lineBreak":true},{"text":"miatreatre ahiko o harevendreveñan’","poem":1},{"lineBreak":true},{"text":"Añahareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitreñe hao ty borìke ly","poem":1},{"lineBreak":true},{"text":"t’ie amañ’ahetse,","poem":1},{"lineBreak":true},{"text":"ke mirohake hao ty añombe","poem":1},{"lineBreak":true},{"text":"ambone’ i hane’ey?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho kamaeñe tsy aman-tsira hao","poem":1},{"lineBreak":true},{"text":"t’ie nàmoñe?","poem":1},{"lineBreak":true},{"text":"mafiry hao ty tapotin’atoly?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ifoneñan-troko ty hitsopeke;","poem":1},{"lineBreak":true},{"text":"hoe lintseñe t’ie siloke.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ehe te niazoko i halalikoy; te hatolon’Añahare i salalaekoy,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ee te ho non’ Añahare","poem":1},{"lineBreak":true},{"text":"ty handemok’ ahiko,","poem":1},{"lineBreak":true},{"text":"te ho hahà’e ty fità’e hañitoa’e ahy!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zao ty ho nañohò ahiko; hahavontitirako tsy aman-tretrè ty fanaintaiñañe;","poem":1},{"lineBreak":true},{"text":"te tsy niliereko ty nafè’ i Masiñey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aia ty haozarako te hitamà?","poem":1},{"lineBreak":true},{"text":"Inoñe ty ho figadoñako, t’ie hahaliñe?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haozaram-bato hao ty hafatrarako?","poem":1},{"lineBreak":true},{"text":"Torisike hao ty sandriko?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hera tsy amako ty fañimbàñe ahiko,","poem":1},{"lineBreak":true},{"text":"ke nasiotse amako ty famotsorañe?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mañeva ho ferenaiñan-drañe’e","poem":1},{"lineBreak":true},{"text":"ty mpisotry,","poem":1},{"lineBreak":true},{"text":"ndra te napo’e ty fañeveñañe","poem":1},{"lineBreak":true},{"text":"amy El-Sadai.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Manao hakalitahan-torahañe","poem":1},{"lineBreak":true},{"text":"amako o rañekoo,","poem":1},{"lineBreak":true},{"text":"hoe saka misorotombake","poem":1},{"lineBreak":true},{"text":"vaho mimosaoñe,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ie angonkòña’ i ranon-kavandray,","poem":1},{"lineBreak":true},{"text":"naho am-pietaham-panala.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ie matrovoke le mianjiñe,","poem":1},{"lineBreak":true},{"text":"ie faosa vaho mimiañe an-toe’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Miolakolak’ am-pañaveloañe iereo,","poem":1},{"lineBreak":true},{"text":"mb’an-kakoahañe mb’eo vaho mimeatse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nipaia’ o mpivovotse boak’ i Temào,","poem":1},{"lineBreak":true},{"text":"nitamà’ o mpitavea’ i Sebào.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nilonjetse t’ie nahatoky;","poem":1},{"lineBreak":true},{"text":"nitangòke te nipok’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Toe manahake Izay nahareo henaneo;","poem":1},{"lineBreak":true},{"text":"oni’ areo ty hekoheko le miriatsandriñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nanao ty hoe vi’raho?","poem":1},{"lineBreak":true},{"text":"Añendeso, ndra,","poem":1},{"lineBreak":true},{"text":"Itambezo am-bokàñe","poem":1},{"lineBreak":true},{"text":"amo vara’ areoo","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ehe, ampipolitiro am-pitàn-drafelahy,","poem":1},{"lineBreak":true},{"text":"ke: Jebaño am-pità’ o fanalolahio ty fiaiko?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Anaro iraho, le hitsiñe; atoro ahy ty nandilarako.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Toe mahasibeke ty saontsy to !","poem":1},{"lineBreak":true},{"text":"Fe inoñe ty ho toiñe’","poem":1},{"lineBreak":true},{"text":"ty fifanoitoi’areo?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ke te o reha’oo ro vente’e","poem":1},{"lineBreak":true},{"text":"vaho tioke avao ty lañonam-pamoe’ piaiñe?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Eka, ndra iambotraha’ areo","poem":1},{"lineBreak":true},{"text":"ty bode-rae vaho haletake ty rañetse.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ehe henteo henaneo,","poem":1},{"lineBreak":true},{"text":"hera mpandañitse añ’atrefa’ areo iraho.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mibalintoàña, le ko mandilatse;","poem":1},{"lineBreak":true},{"text":"Eka mifosera, fa vantañe o ahikoo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Manan-tahy hao ty lelako?","poem":1},{"lineBreak":true},{"text":"Tsy apota’ ty lañilañiko hao ty hankàñe?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}