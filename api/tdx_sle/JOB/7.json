{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Tsy lily hao ty fitromaha’ ondaty","poem":1},{"lineBreak":true},{"text":"an-tane atoy?","poem":1},{"lineBreak":true},{"text":"Tsy mira ami’ty androm-pièke hao","poem":1},{"lineBreak":true},{"text":"o andro’eo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manahake ty filelalela’ ondevo ty aloke naho ty fitamam-pièke ty rima’e,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ty anolorañ’ ahy volan-kafoake,","poem":1},{"lineBreak":true},{"text":"ie nitendreñe halen-kaemberañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Izaho mandre, manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ombia ty hitroarako, fa lava i haleñey,","poem":1},{"lineBreak":true},{"text":"le mivoamboañe avao","poem":1},{"lineBreak":true},{"text":"ampara’ te manjirike.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Misikiñ’oletse naho pakoram-potake","poem":1},{"lineBreak":true},{"text":"ty sandriko,","poem":1},{"lineBreak":true},{"text":"mijiri-gañe ty holiko vaho mandrano.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masika te amy sozom-panenoñey","poem":1},{"lineBreak":true},{"text":"o androkoo,","poem":1},{"lineBreak":true},{"text":"ie mihelañe añe po-pitamàñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ehe tiahio te kofòke avao ty haveloko:","poem":1},{"lineBreak":true},{"text":"toe tsy hahatrea hasoa ka o masokoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy ho onim-pihaino’ i mahaisak’ ahikoy: amako o fihaino’oo fe tsy eo iraho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie misaoke ty rahoñe, le añe:","poem":1},{"lineBreak":true},{"text":"Izay ty igodaña’ ty an-kibory ao,","poem":1},{"lineBreak":true},{"text":"tsy hiboaha’e ka.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy himpolia’e i anjomba’ey,","poem":1},{"lineBreak":true},{"text":"ie tsy hapota’ i akiba’ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le tsy hijomohòn-draho;","poem":1},{"lineBreak":true},{"text":"hivolañe ami’ty falorean-troko,","poem":1},{"lineBreak":true},{"text":"hitoreo ami’ty hafairañe añ’ovako ao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I riakey hao iraho, ke i fañaneñey","poem":1},{"lineBreak":true},{"text":"kanao nampijilovañe?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie anoeko ty hoe","poem":1},{"lineBreak":true},{"text":"te ho hohòe’ i tihikoy,","poem":1},{"lineBreak":true},{"text":"te hampanintsiñe ty toreoko","poem":1},{"lineBreak":true},{"text":"i fandreakoy,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"le ampihembaña’o ami’ty nofy naho ampirevendreveña’o añ’aroñaroñe,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"le joboñe’ ty fiaiko t’ie dageañeñe,","poem":1},{"lineBreak":true},{"text":"hamake hikenkañe ty amo taolakoo,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"f’ie minike, tsy ho veloñe nainai’e:","poem":1},{"lineBreak":true},{"text":"apoho, fa kafoak’ avao o androkoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Inoñ’ ondatio te honjone’o?","poem":1},{"lineBreak":true},{"text":"te hapite’o ama’e ty arofo’o?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"T’ie tilihe’o boak’andro,","poem":1},{"lineBreak":true},{"text":"vaho tsohe’o lomoñandro?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ombia t’ie hitolike tsy hisamb’ahy,","poem":1},{"lineBreak":true},{"text":"apoho ho bangìñe hey raho","poem":1},{"lineBreak":true},{"text":"hahateleñako ty iveko?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nanao hakeo hao iraho,","poem":1},{"lineBreak":true},{"text":"ino o nanoekoo, ry Mpijilo ondatio?","poem":1},{"lineBreak":true},{"text":"ino ty nanoe’o ahy fanolarañe,","poem":1},{"lineBreak":true},{"text":"hañavesatse ty sandriko?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Akore te tsy apo’o o tahikoo,","poem":1},{"lineBreak":true},{"text":"te tsy haha’o o hakeokoo?","poem":1},{"lineBreak":true},{"text":"f’ie hiroro an-debok’ ao te aniany;","poem":1},{"lineBreak":true},{"text":"ho paia’o, fa tsy ho eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}