{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Nanoiñe amy zao t’i Bildade nte-Sohy:"]},{"type":"verse","number":2,"content":[{"text":"Pak’ombia te ho saontsie’o o raha zao?","poem":1},{"lineBreak":true},{"text":"Ampara ombia te ho tio-bey avao","poem":1},{"lineBreak":true},{"text":"o entam-palie’oo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mengohen’ Añahare hao ty zaka?","poem":1},{"lineBreak":true},{"text":"Ampiolahe’ i El-Sadai","poem":1},{"lineBreak":true},{"text":"hao ty hatò?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie nandilats’ azo o ana’oo,","poem":1},{"lineBreak":true},{"text":"le nasese’e ami’ty haozara’","poem":1},{"lineBreak":true},{"text":"o fiodia’eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa naho nitsoehe’o t’i Andrianañahare vaho ty fiferenaiña’ i El-Sadai,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"naho malio naho vantan-drehe,","poem":1},{"lineBreak":true},{"text":"le hivañona’e","poem":1},{"lineBreak":true},{"text":"hampipoly i akiban-kavantaña’oy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le ndra te nikede ty fifotora’o,","poem":1},{"lineBreak":true},{"text":"hitombo ho ra’elahy ty figadoña’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ehe añontaneo i sà’ taoloy vaho imaneo","poem":1},{"lineBreak":true},{"text":"o nitsikarahen-droae’eo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bahimo tika fa toly omale avao,","poem":1},{"lineBreak":true},{"text":"mbore talinjo ambone’ ty tane toy o andron-tikañeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa vaho tsy ho toroa’ iareo hao, hisaontsy ama’o, hañakatse entañe","poem":1},{"lineBreak":true},{"text":"boak’ añ’arofo’ iareo ao?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mahafitiry hao ty vinda","poem":1},{"lineBreak":true},{"text":"lehe tsy an-tane hinake?","poem":1},{"lineBreak":true},{"text":"Hitiry tsy aman-drano hao ty vondro?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie maindoñe, tsy nibiraeñe,","poem":1},{"lineBreak":true},{"text":"le mbe miheatse aolo’ ze hene rongoñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Izay ty lala’ o mañaliño","poem":1},{"lineBreak":true},{"text":"an’ Andrianañahareo;","poem":1},{"lineBreak":true},{"text":"toe modo fitamàñe ty tsy aman-Kake.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie maràntsañe ty fiatoa’e;","poem":1},{"lineBreak":true},{"text":"naho fararotse ty fatokisa’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hiatoa’e ty anjomba’e","poem":1},{"lineBreak":true},{"text":"fe tsy hahafijadoñe;","poem":1},{"lineBreak":true},{"text":"vontitire’e fe tsy leo’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Maindoñindoñe re añatrefa’ i àndroy andrevaha’ o tsampa’eo i golobo’ey,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"vandindire’ o vaha’eo ty votrim-bato, i traño-vatoo nitsifira’ iareoy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie ombotañe amy toe’ey, le ho lañe’e, ami’ty hoe,","poem":1},{"lineBreak":true},{"text":"Mbe lia tsy nahatrea azo iraho.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Eka, Izay ty haeha’ i lia’ey,","poem":1},{"lineBreak":true},{"text":"mbe hitiry amo debokeo ka ty ila’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Oniño te tsy ho farien’ Añahare ty vañoñe vaho tsy ho tohaña’e","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mbe ho lifore’e fiankahafañe ty falie’o naho o fivimbi’oo am-pazake.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho saroñen-kasalarañe","poem":1},{"lineBreak":true},{"text":"ze malaiñe azo,","poem":1},{"lineBreak":true},{"text":"ho modo ty kivoho’ o tsivokatseo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}