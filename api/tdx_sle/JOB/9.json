{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOB","translationId":"tdx_sle","name":"Iobe","commonName":"Iobe","title":"Iobe","order":18,"numberOfChapters":42,"sha256":"7322d004ff6716cb4e0b187d78d6fe7c75f369563047619f49c2dc1aeeb1cb25","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tdx_sle/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Aa hoe ty natoi’ Iobe :"]},{"type":"verse","number":2,"content":[{"text":"Toe apotako ty hatò izay: fe aia te ho to añatrefan’ Añahare ondatio?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naho teo ty nipay hifandietse ama’e,","poem":1},{"lineBreak":true},{"text":"tsy ho toiñe’e indraik’ ami’ty arivo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mahihitse añ’Arofo,","poem":1},{"lineBreak":true},{"text":"fatratse an-kaozarañe,","poem":1},{"lineBreak":true},{"text":"ia ty nanjehatse ama’e tsy aman-joy?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aveve’e o vohitseo, tsy apota’ iareo","poem":1},{"lineBreak":true},{"text":"te avali-hoho’e an-kaviñerañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Akofikofi’e tsy an-toe’e ty tane toy, le mitroetroe o faha’eo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lilie’e tsy hanjirike i àndroy,","poem":1},{"lineBreak":true},{"text":"agobo’e o vasiañeo;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie avao ty namelatse o likerañeo,","poem":1},{"lineBreak":true},{"text":"naho mandialia o onjan-driakeo;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie ty nañoreñe i Arktorose","poem":1},{"lineBreak":true},{"text":"naho i Telo-milahatsey,","poem":1},{"lineBreak":true},{"text":"i Bode naho i Koto-kede atimoy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie i manao halatsàñe tsy onim-biribiriy,","poem":1},{"lineBreak":true},{"text":"raha tsitantane tsy taka-voliliy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie miary amako, tsy ho treako:","poem":1},{"lineBreak":true},{"text":"Naho ihelaña’e tsy ho rendreko.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie mandrirotse, ia ty hisebañe.","poem":1},{"lineBreak":true},{"text":"Hanoa’ ia ty hoe, Ino o anoe’oo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy hampolin’ Añahare ty haviñera’e;","poem":1},{"lineBreak":true},{"text":"mitsolofìñe ama’e ka","poem":1},{"lineBreak":true},{"text":"o mpañimba’ i Rahabeo.","poem":1},{"noteId":5}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Akore arè ty hahatoiñako aze,","poem":1},{"lineBreak":true},{"text":"ty hijoboñe o volañe hitaroñakoo;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndra te to i ahikoy, tsy ho nahatoiñe; ho nihalalieko tretre","poem":1},{"lineBreak":true},{"text":"i Mpizakakoy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naho nikanjy iraho vaho nanoiñe ahiko re, tsy ho niantofako te nihaoñe’e ty feoko.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Vinonotrobo’e an-tio-bey iraho,","poem":1},{"lineBreak":true},{"text":"indrae’e tsy amam-poto’e o ferekoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy hapo’e hikofòke iraho,","poem":1},{"lineBreak":true},{"text":"te mone atsafe’e afero;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ty amo haozarañeo,","poem":1},{"lineBreak":true},{"text":"Inao! Ie ty Maozatse!","poem":1},{"lineBreak":true},{"text":"Le ty hatò :","poem":1},{"lineBreak":true},{"text":"Ia ty hifamotoañe ama’e?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Naho naniom-batan-draho,","poem":1},{"lineBreak":true},{"text":"ho nanisý ahy ty vavako;","poem":1},{"lineBreak":true},{"text":"ndra t’ie tsy an-kila,","poem":1},{"lineBreak":true},{"text":"ho tsarae’e te mengoke.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Malio tahin-draho, tsy haoñe’ ty troko,","poem":1},{"lineBreak":true},{"text":"ho farieko ty fiaiko;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Toe raike iaby avao: aa hoe iraho:","poem":1},{"lineBreak":true},{"text":"Songa rotsahe’e ty mahity","poem":1},{"lineBreak":true},{"text":"naho ty lo-tsereke.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Naho manjamañe aniany ty angorosy,","poem":1},{"lineBreak":true},{"text":"le kizahe’e ty famoeañ’ay o vañoñeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie atolots’an-taña’ o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"ty tane,","poem":1},{"lineBreak":true},{"text":"le takone’e ty lahara’ o mpizakao;","poem":1},{"lineBreak":true},{"text":"aa naho tsy ie, le ia ka?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Masìka te amo mpanao tsikiaviavio o androkoo,","poem":1},{"lineBreak":true},{"text":"mihelañe tsy ahaisahan-kasoa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mitsiritsioke hoe lakam-bezo","poem":1},{"noteId":6},{"text":",","poem":1},{"lineBreak":true},{"text":"hoe tsimalaho mañao-tsindroke.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aa naho nanao ty hoe iraho,","poem":1},{"lineBreak":true},{"text":"handikofako i halalikoy,","poem":1},{"lineBreak":true},{"text":"hapoko ty tareheko lonjetse toy,","poem":1},{"lineBreak":true},{"text":"vaho hisomilake;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ihembañako o fanaintaiñakoo,","poem":1},{"lineBreak":true},{"text":"apotako t’ie tsy ho haha’o;","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aa kanao atao lo-tsereke iraho;","poem":1},{"lineBreak":true},{"text":"ino ty ifanehafako tsy vente’e?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Naho miandro an-dranom-panala,","poem":1},{"lineBreak":true},{"text":"naho kotriñeko an-tsokay o tañakoo;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mbe hagodo’o an-davak’ ao,","poem":1},{"lineBreak":true},{"text":"vaho halaim-bintañe ahy o sikikoo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Toe tsy ondaty manahak’ ahy re","poem":1},{"lineBreak":true},{"text":"hahatoiñako,","poem":1},{"lineBreak":true},{"text":"t’ie hifañatrek’ an-jaka.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tsy amam-pañalañalañe ty añivo’ay ao,","poem":1},{"lineBreak":true},{"text":"ze mete ho nanazok’ anay roroe.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ehe te hasita’e amako i kobai’ey,","poem":1},{"lineBreak":true},{"text":"vaho tsy hampangebahebak’ ahy","poem":1},{"lineBreak":true},{"text":"i fañeveñañe ama’ey;","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Le ho nivolan-draho,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho nianifañe ama’e;","poem":1},{"lineBreak":true},{"text":"fa toe tsy Izay ty an-troko ao.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Rahabe: i Ndrimon-driakey, i Mitsraime","reference":{"chapter":9,"verse":13}},{"noteId":6,"caller":"+","text":"Heb: lakañe nirareañe vinda","reference":{"chapter":9,"verse":26}}]},"thisChapterLink":"/api/tdx_sle/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}