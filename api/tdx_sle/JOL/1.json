{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOL","translationId":"tdx_sle","name":"Ioèle","commonName":"Ioèle","title":"Ioèle","order":29,"numberOfChapters":4,"sha256":"a44ee2740f548f45279449af8b61adf2b2ad2085e533dfc75c6ff2cf041c240f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tdx_sle/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ty tsara’ Iehovà niheo am’ Ioèle",{"noteId":0},"ana’ i Petoele",{"noteId":1},":"]},{"type":"verse","number":2,"content":["Janjiño ry androanavio, toloro ravembia",{"text":"ry hene mpimone’ o taneo,","poem":1},{"lineBreak":true},{"text":"he t’ie nizoeñe añ’andro’ areo,","poem":1},{"lineBreak":true},{"text":"ndra tañ’andron-droae’ areo hao?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atalilio amo ana’ areoo,","poem":1},{"lineBreak":true},{"text":"le ampitalilio o ana’ areoo amo ana’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho o ana’ iereoo amo tariratse añeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nabotse’ ty kijeja","poem":1},{"lineBreak":true},{"text":"ze nenga’ ty marambolo,","poem":1},{"lineBreak":true},{"text":"nihane’ ty voantane ze nenga i kijeja,","poem":1},{"lineBreak":true},{"text":"vaho nikapaihe’ ty beañe","poem":1},{"lineBreak":true},{"text":"ze nenga’ ty lambotane.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitsekafa ry jike le miroveta;","poem":1},{"lineBreak":true},{"text":"mangololoiha ry mpinon-divaio,","poem":1},{"lineBreak":true},{"text":"ty amy divai-vao napitsoke","poem":1},{"lineBreak":true},{"text":"am-palie’ areo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nivotrak’ an-taneko atoy ty fòko maozatse, mitozantozañe;","poem":1},{"lineBreak":true},{"text":"hoe nifen-diona o famotsi’eo,","poem":1},{"lineBreak":true},{"text":"vazan-diona ra’elahy","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa napo’e ho forompotse o vahekoo,","poem":1},{"lineBreak":true},{"text":"nikorendahe’e ty sakoako;","poem":1},{"lineBreak":true},{"text":"niholira’e malio naho nahifi’e añe,","poem":1},{"lineBreak":true},{"text":"le foty iaby o ra’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mangoihoia manahake ty somondrara","poem":1},{"lineBreak":true},{"text":"misikin-gony ty amy valin-katòra’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa naitoañe amy anjomba’ Iehovày","poem":1},{"lineBreak":true},{"text":"i enga-mahakamay, naho i engan-dranoy;","poem":1},{"lineBreak":true},{"text":"mandala o mpisoroñe mitoroñe Iehovào.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Finaoke i tetekey, mitañy ty tane;","poem":1},{"lineBreak":true},{"text":"finongotse i ampembay;","poem":1},{"lineBreak":true},{"text":"nimaiheñe i divay vaoy,","poem":1},{"lineBreak":true},{"text":"kapaike i menakey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mioremeña ry mpihare,","poem":1},{"lineBreak":true},{"text":"mangololoiha ry mpañalahala vahe,","poem":1},{"lineBreak":true},{"text":"ty amy ampembay naho i tsakoy;","poem":1},{"lineBreak":true},{"text":"amy te mikirikintàñe i tetekey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa maike i vahey,","poem":1},{"lineBreak":true},{"text":"mongotse i sakoañey;","poem":1},{"lineBreak":true},{"text":"niforejeje ka i raketay","poem":1},{"noteId":2},{"text":", i sasaviy,","poem":1},{"lineBreak":true},{"text":"i takokoy, naho ze hene hatae","poem":1},{"lineBreak":true},{"text":"an-kivoke ey;","poem":1},{"lineBreak":true},{"text":"aa le niheatse amo ana’ondatio","poem":1},{"lineBreak":true},{"text":"ty hafaleañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Midiaña vaho mandalà ry mpisoroñeo;","poem":1},{"lineBreak":true},{"text":"mangololoiha ry mpitoron-kitrely;","poem":1},{"lineBreak":true},{"text":"antao hialeñe an-gony ry mpitoron’","poem":1},{"lineBreak":true},{"text":"Añahareko;","poem":1},{"lineBreak":true},{"text":"fa napitsok’ amy anjomban’","poem":1},{"lineBreak":true},{"text":"Añahare’ areoy ty enga-mahakama","poem":1},{"lineBreak":true},{"text":"naho ty enga rano.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Añamasiño lilitse,","poem":1},{"lineBreak":true},{"text":"koiho ty fivory miavake,","poem":1},{"lineBreak":true},{"text":"atontono o androanavio,","poem":1},{"lineBreak":true},{"text":"naho ze kila mpimone’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"mb’ añ’anjomba’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ areo,","poem":1},{"lineBreak":true},{"text":"vaho mitoreova am’ Iehovà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hankàñe ty andro!","poem":1},{"lineBreak":true},{"text":"fa tondroke ty andro’ Iehovà,","poem":1},{"lineBreak":true},{"text":"le hoe firotsahañe boak’ amy","poem":1},{"lineBreak":true},{"text":"El-Sadai ty hivovoa’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsy fa naitoañe aolom-","poem":1},{"lineBreak":true},{"text":"pihaino’ areo hao ty mahakama?","poem":1},{"lineBreak":true},{"text":"ty haehake naho ty firebehañe boak’","poem":1},{"lineBreak":true},{"text":"añ’anjomban’Añaharen-tikañe ao?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nimomok’ am-bokon-tane ao","poem":1},{"lineBreak":true},{"text":"ty tabiry, nikapaiheñe o rihao,","poem":1},{"lineBreak":true},{"text":"nikoromake o kiboho-mahakamao;","poem":1},{"lineBreak":true},{"text":"fonga niheatse i ampembay.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Akore ty fañaoloa’ o hareo!","poem":1},{"lineBreak":true},{"text":"lonjetse o mpirai-tron’añombeo","poem":1},{"lineBreak":true},{"text":"kanao tsy amam-piandrazañe;","poem":1},{"lineBreak":true},{"text":"eka, malorè o lia-rain-añondrio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ry Iehovà, ihe ro itoreovako","poem":1},{"lineBreak":true},{"text":"fa finorototo’ ty afo o fiandrazañe","poem":1},{"lineBreak":true},{"text":"am-patrambeio;","poem":1},{"lineBreak":true},{"text":"vaho nampangotomomohe’ i lel’afoy","poem":1},{"lineBreak":true},{"text":"ze kila hatae an-kivok’ ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ihe ro isehasehà’","poem":1},{"lineBreak":true},{"text":"o biby am-patrañeo,","poem":1},{"lineBreak":true},{"text":"fa maike iaby o sakao,","poem":1},{"lineBreak":true},{"text":"vaho fa hinotomomo’ i afoy","poem":1},{"lineBreak":true},{"text":"o fiandrazañe an-dratraratrao.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ioèle: manatry; mandily","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Petoele: Falien’Añahare; nosihe’e","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"Heb: mimone: ampongabeindañitse","reference":{"chapter":1,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}