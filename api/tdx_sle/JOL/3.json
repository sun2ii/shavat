{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JOL","translationId":"tdx_sle","name":"Ioèle","commonName":"Ioèle","title":"Ioèle","order":29,"numberOfChapters":4,"sha256":"a44ee2740f548f45279449af8b61adf2b2ad2085e533dfc75c6ff2cf041c240f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tdx_sle/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ie heneke zao, hadoako amy ze atao nofotse ty Troko;","poem":1},{"lineBreak":true},{"text":"le hitoky o ana-dahio","poem":1},{"lineBreak":true},{"text":"naho o anak’ampela’ areoo,","poem":1},{"lineBreak":true},{"text":"naho hañinofy o androanavi’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho hahaoniñe aroñaroñe","poem":1},{"lineBreak":true},{"text":"o ajalahi’ areoo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le hailiko amo mpitoroñeo,","poem":1},{"lineBreak":true},{"text":"naho amo anak’ ampatañeo","poem":1},{"lineBreak":true},{"text":"ty Troko amy andro rezay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hampiboahako raha tsitantane","poem":1},{"lineBreak":true},{"text":"an-dindiñe ey, naho an-tane atoy,","poem":1},{"lineBreak":true},{"text":"lio naho afo, vaho hatoeñe mijoala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hafotetse ho ieñe i àndroy,","poem":1},{"lineBreak":true},{"text":"naho ho lio i volañey,","poem":1},{"lineBreak":true},{"text":"aolo ty fitotsaha’ i andro’ Iehovà jabajaba","poem":1},{"lineBreak":true},{"text":"naho mampangebahebakey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie amy zay, ho rombaheñe ze mikanjy ty tahina’ Iehovà;","poem":1},{"lineBreak":true},{"text":"fa hipolititse an-kaboa’ i Tsione ao naho e Ierosalaime ao ty ila’e amy nafè’ Iehovày, vaho ho kanjie’ Iehovà o sehanga’eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}