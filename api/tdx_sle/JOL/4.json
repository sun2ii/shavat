e","number":6,"content":["naho naleta’ areo amo nte-Ievanio o ana’ Iehodào naho o ana’ Ierosalaimeo haneseañe iareo lavitse ty tane’ iareo añe."]},{"type":"verse","number":7,"content":["Inao fa hampionjoneko boak’ an-tane nandetahañe iareo, vaho havàhako an-doha’ areo o sata’ areoo,"]},{"type":"verse","number":8,"content":["fa haletako am-pità’ o ana’ Iehodào o ana-dahi’ areoo naho o anak’ ampela’ areoo, vaho haleta’ iereo amo nte-Sevào, ondaty tsietoitane añeo, fa izay ty tsinara’ Iehovà."]},{"type":"verse","number":9,"content":["Tseizo ty hoe amo kilakila’ondatio:",{"text":"Mihentseña hialy;","poem":1},{"lineBreak":true},{"text":"tsekafo o fanalolahio,","poem":1},{"lineBreak":true},{"text":"ampañarineo ze hene lahindefoñe;","poem":1},{"lineBreak":true},{"text":"ampionjono mb’etoa;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tefeo ho fibara o lelan-dasarì’ areoo,","poem":1},{"lineBreak":true},{"text":"naho ho lefoñe o fibira’ areoo,","poem":1},{"lineBreak":true},{"text":"ampanò ty hoe o mavozoo:","poem":1},{"lineBreak":true},{"text":"Maozatse iraho;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Malisà! mb’etoy","poem":1},{"lineBreak":true},{"text":"ry kilakila’ ondaty mañohokeo;","poem":1},{"lineBreak":true},{"text":"ampizotsò o fanalolahi’oo ry Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mitrobotroboa ry kilakila ondatio,","poem":1},{"lineBreak":true},{"text":"mionjona mb’am-bavatane’ Iehosefate eo.","poem":1},{"lineBreak":true},{"text":"fa eo ty hitobohako hizaka","poem":1},{"lineBreak":true},{"text":"o kilakila ondaty miarisehoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sonjono ty fitatahañe,","poem":1},{"lineBreak":true},{"text":"fa matoe i vokatsey,","poem":1},{"lineBreak":true},{"text":"miziliha, mandialià, fa pea i fipiritañey,","poem":1},{"lineBreak":true},{"text":"naho mandopatse o sajoao,","poem":1},{"lineBreak":true},{"text":"fa bey ty haloloa’ iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rehoreho, fikorakorahañe","poem":1},{"lineBreak":true},{"text":"ty am-bavatanem-panàmpan-kevetse,","poem":1},{"lineBreak":true},{"text":"fa mitotoke ty andro’ Iehovà","poem":1},{"lineBreak":true},{"text":"am-bavatanem-panàmpan-kevetse.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hampaieñeñe i àndroy naho i volañey,","poem":1},{"lineBreak":true},{"text":"vaho hasinta’ o vasiañeo o filoeloea’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Le hitroñe boak’e Tsione ao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hampipoña-piarañanañañe","poem":1},{"lineBreak":true},{"text":"boak’e Ierosalaime ao;","poem":1},{"lineBreak":true},{"text":"le hihondrahondra o likerañeo","poem":1},{"lineBreak":true},{"text":"naho ty tane toy;","poem":1},{"lineBreak":true},{"text":"fa fitamà’ ondati’eo t’Iehovà","poem":1},{"lineBreak":true},{"text":"naho ty fipalira-maoza’ o ana’ Israeleo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa le ho fohi’ areo te Izaho Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ areo,","poem":1},{"lineBreak":true},{"text":"mpimoneñe e Tsione, vohi-masiko,","poem":1},{"noteId":6},{"text":"ao,","poem":1},{"lineBreak":true},{"text":"aa le hiavake t’Ierosalaime,","poem":1},{"lineBreak":true},{"text":"vaho tsy hiranga ama’e ka o ambahinio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie amy andro zay,","poem":1},{"lineBreak":true},{"text":"hampitsopatsopake divay vao o vohitseo,","poem":1},{"lineBreak":true},{"text":"le horikorihen-dronono o haboañeo,","poem":1},{"lineBreak":true},{"text":"naho hene hikararahan-drano","poem":1},{"lineBreak":true},{"text":"o saka’ Iehodào, le higoangoañe boak’ añ’anjomba’ Iehovà ao ty rano","poem":1},{"lineBreak":true},{"text":"hanondrake ty vavatane’ i Sitime.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho babangoañe t’i Mitsraime,","poem":1},{"lineBreak":true},{"text":"naho ho ratrotratro bangý t’i Edome,","poem":1},{"lineBreak":true},{"text":"ty amy hasiaha’ iareo amo ana’Iehodào,","poem":1},{"lineBreak":true},{"text":"ie nampiorike lio-màliñe","poem":1},{"lineBreak":true},{"text":"an-tane’ iareo eo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa himoneñe nainai’e t’Iehodà;","poem":1},{"lineBreak":true},{"text":"naho tariratse an-tariratse t’Ierosalaime","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Le ho lioveko ty lio’iareo mboe tsy nilioveko","poem":1},{"lineBreak":true},{"text":"fa himoneñe e Tsione ao t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Iehosafate: Iehovà ro Mpizaka","reference":{"chapter":4,"verse":2}},{"noteId":6,"caller":"+","text":"Ies 12:6, Iek 48:35, Mik 4:7, Tsf 3:14-16","reference":{"chapter":4,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/JOL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}