{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"JON","translationId":"tdx_sle","name":"Ionà","commonName":"Ionà","title":"Ionà","order":32,"numberOfChapters":4,"sha256":"021b7443fa7ab7d4d5e84a677630dc809c060f13fabb08e3b7d64725bdd09e9e","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tdx_sle/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ie amy zao fa nihentseñe’ Iehovà ty fiañe jabajaba nampigodrañe Ionà. Tam-pò’ i fiañey telo andro naho telo haleñe t’Ionà."]},{"type":"verse","number":2,"content":["Nihalaly am’ Iehovà Andrianañahare’e, an-tro’ i fiañey ao t’Ionà,"]},{"type":"verse","number":3,"content":["ami’ty hoe,",{"text":"Nitoreo am’ Iehovà amy fisotriakoy,","poem":1},{"lineBreak":true},{"text":"le tinoi’e;","poem":1},{"lineBreak":true},{"text":"nikoiake boak’ an-Tsikeokeok’ ao,","poem":1},{"lineBreak":true},{"text":"vaho jinanji’o ty feoko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa navokovoko’o an-daleke ao iraho,","poem":1},{"lineBreak":true},{"text":"an-teñateña’ o riakeo ao;","poem":1},{"lineBreak":true},{"text":"nandipots’ ahy o kinera’eo;","poem":1},{"lineBreak":true},{"text":"niary amboneko eo ze hene alo’o naho onja’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le hoe iraho,","poem":1},{"lineBreak":true},{"text":"nahifike tsy ho isam-pihaino’o;","poem":1},{"lineBreak":true},{"text":"fa ho toliheko indraike","poem":1},{"lineBreak":true},{"text":"i kivoho’o miavakey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niarikoboñe ahy o ranoo, pak’an-troko,","poem":1},{"lineBreak":true},{"text":"niariseho amako i lalekey;","poem":1},{"lineBreak":true},{"text":"vinandibandi’ o lomotseo ty lohako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nizotso mb’ am-baha’ o vohitseo;","poem":1},{"lineBreak":true},{"text":"nañarikatok’ahy kitro katroke","poem":1},{"lineBreak":true},{"text":"o tsotsò’ ty tane toio;","poem":1},{"lineBreak":true},{"text":"fe nakare’o boak’ an-kibory ao","poem":1},{"lineBreak":true},{"text":"ty haveloko, ry Iehovà Andrianañahareko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie nitoirañe an-troko ao ty fiaiko,","poem":1},{"lineBreak":true},{"text":"le nahatiahy Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho niheo mb’ama’o an-kivoho’o","poem":1},{"lineBreak":true},{"text":"miavake ao ty halaliko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsambolitio’ o mpañaon-kakoaham-","poem":1},{"lineBreak":true},{"text":"bandeo ty fiferenaiñañe ama’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe hañenga soroñe ama’o raho","poem":1},{"lineBreak":true},{"text":"am-peom-pañandriañañe;","poem":1},{"lineBreak":true},{"text":"havahako i ni-fantàkoy,","poem":1},{"lineBreak":true},{"text":"fa boak’ am’ Iehovà ty fandrombahañe.","poem":1}]},{"type":"verse","number":11,"content":["Aa le nafanto’ Iehovà i fiañey, vaho naloa’e an-tamboho ey t’Ionà."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}