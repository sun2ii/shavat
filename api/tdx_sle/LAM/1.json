e},{"text":"ze hene vara’e añ’andro taolo,","poem":1},{"lineBreak":true},{"text":"ie nisotry naho nirererere,","poem":1},{"lineBreak":true},{"text":"ie mijoñe am-pitan-drafelahi’e ao,","poem":1},{"lineBreak":true},{"text":"ie pitsom-pañolotse,","poem":1},{"lineBreak":true},{"text":"vaho nisamba i fihotraha’ey","poem":1},{"lineBreak":true},{"text":"o malaiñ’azeo,","poem":1},{"lineBreak":true},{"text":"nikizake i harotsaha’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ח Niota faly t’Ierosalaime,","poem":1},{"lineBreak":true},{"text":"aa le ìnjen-dre henaneo;","poem":1},{"lineBreak":true},{"text":"mavoe’ o niasy aze iabio,","poem":1},{"lineBreak":true},{"text":"fa niisa’ iareo ty fimeñara’e;","poem":1},{"lineBreak":true},{"text":"miselekain-dre vaho miamboho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ט An-tsiki’e leny ao ty haleora’e;","poem":1},{"lineBreak":true},{"text":"tsy hinao’e t’ie ho figadoña’e;","poem":1},{"lineBreak":true},{"text":"nahalatsa ty nihotraha’e,","poem":1},{"lineBreak":true},{"text":"ie tsy amam-pañohò.","poem":1},{"lineBreak":true},{"text":"O ry Iehovà, vazohò ty fisotriako,","poem":1},{"lineBreak":true},{"text":"ie ireñeta’ ty rafelahy!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"י Fa natorakitsi’ o mpalaiñe azeo ambone’ o vara’e iabio o fità’eo;","poem":1},{"lineBreak":true},{"text":"niisa’e iaby ty fipoñafa’","poem":1},{"lineBreak":true},{"text":"o kilakila’ ndatio i toe’e miavakey,","poem":1},{"lineBreak":true},{"text":"o nirarà’o tsy himoake","poem":1},{"lineBreak":true},{"text":"am-pivori’oo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"כ Songa mitoreo ondati’eo,","poem":1},{"lineBreak":true},{"text":"mitsoeke mofo;","poem":1},{"lineBreak":true},{"text":"natsalo’ iareo mahakama ty vara’ iareo","poem":1},{"lineBreak":true},{"text":"ho famelomam-piaiñe.","poem":1},{"lineBreak":true},{"text":"Vazoho ry Iehovà, mahaoniña","poem":1},{"lineBreak":true},{"text":"ty tsy fanjofahako henaneo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ל Tsy ahoa’ areo hao zao,","poem":1},{"lineBreak":true},{"text":"ry mpiary mb’eo?","poem":1},{"lineBreak":true},{"text":"Paiao naho oniño, he ao ty hontoke","poem":1},{"lineBreak":true},{"text":"manahake o fihontoke","poem":1},{"lineBreak":true},{"text":"nafetsak’ amakoo,","poem":1},{"lineBreak":true},{"text":"ie naretsa’ Iehovà amako","poem":1},{"lineBreak":true},{"text":"amy andron-kaviñera’e","poem":1},{"lineBreak":true},{"text":"miforoforo zao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"מ Nampihitrifa’e afo boak’ andikerañey,","poem":1},{"lineBreak":true},{"text":"le niteveke lalek’ an-taolako ao;","poem":1},{"lineBreak":true},{"text":"nandafiha’e harato o tombokoo;","poem":1},{"lineBreak":true},{"text":"nampolie’e mb’eo naho","poem":1},{"lineBreak":true},{"text":"nenga’e fiain-drifi’e,","poem":1},{"lineBreak":true},{"text":"vaho mitoirañe lomoñandro iraho.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"נ Hoe vinahotse an-joka o fiolàkoo,","poem":1},{"lineBreak":true},{"text":"mirohy am-pità’eo,","poem":1},{"lineBreak":true},{"text":"mivandibanditse","poem":1},{"lineBreak":true},{"text":"pak’am-bozoko eo;","poem":1},{"lineBreak":true},{"text":"mampinike ty haozarako;","poem":1},{"lineBreak":true},{"text":"natolo’ i Talè am-pita’ o tsy lefeko ijohañañeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ס Hene naforintse’ i Talè","poem":1},{"lineBreak":true},{"text":"o lahindefoko añivoo;","poem":1},{"lineBreak":true},{"text":"nitaroñe’e amako ty andro","poem":1},{"lineBreak":true},{"text":"ho demohe’e o ajalahikoo;","poem":1},{"lineBreak":true},{"text":"fa linialia’ i Talè hoe","poem":1},{"lineBreak":true},{"text":"am-pipiritan-divay i anak-ampela mieha’ Iehodày.","poem":1}]},{"type":"verse","number