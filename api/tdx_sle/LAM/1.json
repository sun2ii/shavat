xt":"mikoreokoreoke ty troko,","poem":1},{"lineBreak":true},{"text":"mifihiñe amako ao ty foko,","poem":1},{"lineBreak":true},{"text":"amy hafairañe nilosotsey.","poem":1},{"lineBreak":true},{"text":"Mampandala an-dalañe eo ty fibara;","poem":1},{"lineBreak":true},{"text":"hoe fihomahañe ty añ’anjomba ao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ש Jinanji’ iereo ty fitoreovako,","poem":1},{"lineBreak":true},{"text":"izaho pitso-pañohò;","poem":1},{"lineBreak":true},{"text":"jinanji’ o rafelahiko iabio","poem":1},{"lineBreak":true},{"text":"o feh’ohakoo;","poem":1},{"lineBreak":true},{"text":"ehake iereo te nanoe’o izay.","poem":1},{"lineBreak":true},{"text":"Ampitsatoho i andro nitseize’oy,","poem":1},{"lineBreak":true},{"text":"le hanahak’ ahy iereo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ת Ampombao aolo’o eo ze fonga","poem":1},{"lineBreak":true},{"text":"fitoloñan-drati’ iareo;","poem":1},{"lineBreak":true},{"text":"le ano am’ iereo o nanoe’o amakoo,","poem":1},{"lineBreak":true},{"text":"ty amo fiolàñe iabio;","poem":1},{"lineBreak":true},{"text":"amy te lako toreo iraho vaho","poem":1},{"lineBreak":true},{"text":"midazidazìtse ty troko.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sor 23","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}