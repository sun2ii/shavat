1},{"lineBreak":true},{"text":"midian-gony am-baniañe;","poem":1},{"lineBreak":true},{"text":"miondre-doha’ mb’an-tane","poem":1},{"lineBreak":true},{"text":"o somondrara mieha’ i Tsioneo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"כ Milesa o masokoo ty amo ranomasoo, mioremeñe ty troko;","poem":1},{"lineBreak":true},{"text":"fa nadoañe an-tane ty ateko,","poem":1},{"lineBreak":true},{"text":"ty amy fandrotsahañe","poem":1},{"lineBreak":true},{"text":"i anak’ampela’ ondatikoy,","poem":1},{"lineBreak":true},{"text":"ty amo anak’ajajao naho o mpinono","poem":1},{"lineBreak":true},{"text":"mitoirañe an-dalan-drovao;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ל Hoe iereo aman-drene,","poem":1},{"lineBreak":true},{"text":"aia ty tsako naho ty divay?","poem":1},{"lineBreak":true},{"text":"ie tsipike hoe mate an-dala’ i rovay ey","poem":1},{"lineBreak":true},{"text":"ie midoañe añ’arañan-drene’e ao","poem":1},{"lineBreak":true},{"text":"ty fiai’ iareo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"מ Akore ty havereko azo?","poem":1},{"lineBreak":true},{"text":"Añoharako ami’ty inon-drehe","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ Ierosalaime?","poem":1},{"lineBreak":true},{"text":"Ino ty hañirinkiriñako ama’o","poem":1},{"lineBreak":true},{"text":"hañohòako azo,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ i Tsione?","poem":1},{"lineBreak":true},{"text":"Fa mienene manahake i riakey","poem":1},{"lineBreak":true},{"text":"ty fere’o, ia ty hahamelañe azo?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"נ Nahaisak’ aroñarom-bande","poem":1},{"lineBreak":true},{"text":"naho hagegeañe ho azo o mpitoki’oo;","poem":1},{"lineBreak":true},{"text":"vaho tsy nabora’ iareo o tahi’oo,","poem":1},{"lineBreak":true},{"text":"hampipoliañe azo boak’an-drohy ao,","poem":1},{"lineBreak":true},{"text":"fa fetsen-dremborake ty niisa’