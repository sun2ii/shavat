ineBreak":true},{"text":"Hasoa am’ondatio ty mivave","poem":1},{"lineBreak":true},{"text":"ty jokan-katora’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"י Angao re hiambesatse am-bangiñe","poem":1},{"lineBreak":true},{"text":"ao, hianjiñe,","poem":1},{"lineBreak":true},{"text":"amy te ie ty nandafik’ aze.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Hatoho’e an-debok’ ao ty falie’e,","poem":1},{"lineBreak":true},{"text":"hera ama’e ty fitamañe.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Soa re te hatolo’e amy mandrara-","poem":1},{"lineBreak":true},{"text":"tehak’ azey ty fiambina’e;","poem":1},{"lineBreak":true},{"text":"angao ampiliporeñ’ inje.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"כ Fa tsy hañito nainai’e t’i Talè.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Aa ndra t’ie ty mampioremeñe,","poem":1},{"lineBreak":true},{"text":"mbe hiferenaiña’e","poem":1},{"lineBreak":true},{"text":"amy hafatraram-pikokoa’ey.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tsy mora ama’e ty mandafa,","poem":1},{"lineBreak":true},{"text":"ndra ty mandilo o ana’ondatio;","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ל Ie ampidemoheñe am-pandia,","poem":1},{"lineBreak":true},{"text":"ze mpirohi’ ty tane toy;","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ie tsy omen-to ondatio añatrefa’","poem":1},{"lineBreak":true},{"text":"i Andindimoneñey,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ie ampikeloheñe ty enta’ ondatio—","poem":1},{"lineBreak":true},{"text":"tsy arofoana’ i Talè hao?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"מ Ia ty nitaroñe naho nahafetsake zao,","poem":1},{"lineBreak":true},{"text":"naho tsy i Talè ty nametse?","p