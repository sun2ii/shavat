ext":"ondatikoo henane zao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ד Mipitek’ an-dañilañi’e","poem":1},{"lineBreak":true},{"text":"ty lela’ o anak’ajajao","poem":1},{"lineBreak":true},{"text":"amy harandrano’ey;","poem":1},{"lineBreak":true},{"text":"mangata-kaneñe o ajajao,","poem":1},{"lineBreak":true},{"text":"fe tsy amam-panisa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ה Mikoromak’ an-dalañeo","poem":1},{"lineBreak":true},{"text":"o nitakataka raha mafirio;","poem":1},{"lineBreak":true},{"text":"mitam­bozòtse votren-davenoke","poem":1},{"lineBreak":true},{"text":"o nibeizeñe an-tsikiñe malo-mavoo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ו Fa lombolombo’ ty nandilovañe","poem":1},{"lineBreak":true},{"text":"i Sedome ty nandafañe ondatikoo,","poem":1},{"lineBreak":true},{"text":"ie aniany te narotsake,","poem":1},{"lineBreak":true},{"text":"ie fitàn-draike tsy zinonjoñ’ ama’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ז Nikotritriake hoe fanala o roandria’eo,","poem":1},{"lineBreak":true},{"text":"foty te aman-dronono;","poem":1},{"lineBreak":true},{"text":"nilikoatse o safira","poem":1},{"lineBreak":true},{"text":"pinilak’ amo vonga’eoo,","poem":1},{"lineBreak":true},{"text":"ty filoeloem-binta’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mainten-geroke hoe molale","poem":1},{"lineBreak":true},{"text":"o tareheo henaneo;","poem":1},{"lineBreak":true},{"text":"tsy fohiñe an-dalañey iereo,","poem":1},{"lineBreak":true},{"text":"fa niforejeje amo taola’eo ty holi’ iareo,","poem":1},{"lineBreak":true},{"text":"mipipìke hoe hatae maike.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ט Falefale i tinombom-pibaray","poem":1},{"lineBreak":true},{"text":"te amo trinofan-kasalikoañeo,","poem":1},{"lineBreak":true},{"text":"ie mitike avao ty fiai’ ir