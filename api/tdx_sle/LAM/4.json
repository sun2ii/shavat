ko mitsapa!","poem":1},{"lineBreak":true},{"text":"aa le gike naho mpirererere iereo;","poem":1},{"lineBreak":true},{"text":"le hoe ty natao’ o kilakila’ ndatio:","poem":1},{"lineBreak":true},{"text":"Tsy hitobok’ atoy ka iereo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"פ Nampivarakaihe’ ty haviñera’ Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy ho haoñe’e ka;","poem":1},{"lineBreak":true},{"text":"tsy niasia’ iareo o mpisoroñeo,","poem":1},{"lineBreak":true},{"text":"tsy nisohe’ iareo o androanavio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ע Fa milesa o fihaino’aio,","poem":1},{"lineBreak":true},{"text":"mitolom-pijilojilo imba tsy vente’e;","poem":1},{"lineBreak":true},{"text":"nitalake avao zahay","poem":1},{"lineBreak":true},{"text":"nitama fifeheañe tsy maharombake;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"צ Ie nitinoñe o lia’aio,","poem":1},{"lineBreak":true},{"text":"zahay tsy naha-jelanjelañe amo lala’aio;","poem":1},{"lineBreak":true},{"text":"mitotoke ty figadoña’ay,","poem":1},{"lineBreak":true},{"text":"voa-iake o andro’aio,","poem":1},{"lineBreak":true},{"text":"vaho an-titotse ty fimodoa’ay.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ק Nasika te amo tsimalahoo","poem":1},{"lineBreak":true},{"text":"o nihofik’ ama’aio;","poem":1},{"lineBreak":true},{"text":"linafa’ iareo am-bohitsey,","poem":1},{"lineBreak":true},{"text":"vinandro’ iareo an-dratraratra ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ר O kofòn’ai’aio, o noriza’Iehovào","poem":1},{"lineBreak":true},{"text":"le fa tinavañe an-kobo’ iareo ao—","poem":1},{"lineBreak":true},{"text":"ie nataon-tika ty hoe: Ambanen’alo’e ao","poem":1},{"lineBreak":true},{"text":"ty himoneñan-tika","poem":1},{"lineBreak":true},{"text":"añivo’ o kilakila’ ndatioy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineB