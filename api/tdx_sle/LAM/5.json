{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"LAM","translationId":"tdx_sle","name":"Firovetañe","commonName":"Firovetañe","title":"Firovetañe","order":25,"numberOfChapters":5,"sha256":"131129d3cd3ebf2da5a45cff57f9f514246f7c354a02580f10c05e178b7c0f02","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tdx_sle/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Tiahio, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"i nifetsak’ ama’ay zay;","poem":1},{"lineBreak":true},{"text":"vazohò vaho oniño ty fisalara’ay!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Natolotse amo ambahinio ty lova’ay,","poem":1},{"lineBreak":true},{"text":"amo rene-taneo o akiba’aio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bode zahay henaneo, toe bode rae;","poem":1},{"lineBreak":true},{"text":"remavoiñe o rene’aio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy mete tsy vilie’ay ty rano hinome’ay; kaloeñe o hatae avori’aio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ampisoañeñe o hatò’aio;","poem":1},{"lineBreak":true},{"text":"màmake zahay tsy maharendre-pitofàñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nanolo-pitàñe amy Mitsraime zahay","poem":1},{"lineBreak":true},{"text":"naho amy Asore,","poem":1},{"lineBreak":true},{"text":"hitakara’ay mofo mahàtsake.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nandilatse o roae’aio; tsy eo ka iereo;","poem":1},{"lineBreak":true},{"text":"zahay avao ty mivave o hakeo’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fehe’ o ondevoo, fe tsy eo","poem":1},{"lineBreak":true},{"text":"ty hamotsots’anay am-pità’ iareo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mampamoe’ aiñe","poem":1},{"lineBreak":true},{"text":"ty ahazoa’ay haneñe,","poem":1},{"lineBreak":true},{"text":"amy fibara an-dratraratray.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mahamainte ty holi’ay hoe toñake","poem":1},{"lineBreak":true},{"text":"I kerè matrovokey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vahorañe e Tsione ao o rakemba’aio, naho amo rova’ Iehodào o somondrara’aio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aradorado am-pità’e o roandriañeo;","poem":1},{"lineBreak":true},{"text":"tsy iasiañe ty lahara’ o androanavio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Azitse handisañe ty ajalahy","poem":1},{"lineBreak":true},{"text":"naho midaleandaleañe o jolingao te","poem":1},{"lineBreak":true},{"text":"mijiny hatae.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Napo’ o androanavio ty lalam-bey,","poem":1},{"lineBreak":true},{"text":"nado o ajalahio ty bekobeko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nijihetse ty hafalean’ arofo’ay;","poem":1},{"lineBreak":true},{"text":"nifotetse ho fandalàñe o tsinja’aio.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Po-tsabaka zahay; feh’ohatse fa niota!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Izay ty mahasiloke o tro’aio,","poem":1},{"lineBreak":true},{"text":"izay ty mahalopelope o fihaino’aio;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"toe i Vohi-Tsione mangoakoakey;","poem":1},{"lineBreak":true},{"text":"mitingañ’ ao o farasio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fa Ihe ry Iehovà,","poem":1},{"lineBreak":true},{"text":"nainai’e tsy modo ty fifehea’o;","poem":1},{"lineBreak":true},{"text":"pak’amo tariratse fara-mandimbeo","poem":1},{"lineBreak":true},{"text":"ty fiambesa’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Akore t’ie naforintse’o?","poem":1},{"lineBreak":true},{"text":"Amoea’o andro maro hao zahay?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ampolio ama’o, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"hibodaña’ay; vaò manahake o andro taoloo o andro’aio—","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa naitoa’o zafezanake,","poem":1},{"lineBreak":true},{"text":"naho loho niviñera’o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}