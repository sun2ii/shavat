{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MAL","translationId":"tdx_sle","name":"Malaký","commonName":"Malaký","title":"Malaký","order":39,"numberOfChapters":3,"sha256":"fa462c0739806cf442c68701e367c5f1f79903b50e459e5153dde0759b23da01","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MAL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/MAL/3.json","totalNumberOfVerses":55},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Fetse: ty tsara’ ­Iehovà am’ Israele añamy Malaký",{"noteId":0},"."]},{"type":"verse","number":2,"content":[{"text":"Fa nikokoako nahareo, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le anoa’areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Ami’ty akore ty nikokoa’o anay?","poem":1},{"lineBreak":true},{"text":"Aa tsy nirahalahi’ Iakobe","poem":1},{"noteId":1},{"text":"hao","poem":1},{"lineBreak":true},{"text":"t’i Esave","poem":1},{"noteId":2},{"text":"? hoe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fe nikokoako t’Iakobe,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"naho nihejeko t’i Esave,","poem":1},{"lineBreak":true},{"text":"nampangoakoaheko o tamboho’eo,","poem":1},{"lineBreak":true},{"text":"vaho natoloko amo farasim-","poem":1},{"lineBreak":true},{"text":"patram-beio ty lova’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie amy zao, hoe ty asa’ i Edome:","poem":1},{"lineBreak":true},{"text":"Finofok’ ambane zahay fe himpoly,","poem":1},{"lineBreak":true},{"text":"hamboara’ay o liolioo;","poem":1},{"lineBreak":true},{"text":"aa hoe t’Iehovà’ i Màroy:","poem":1},{"lineBreak":true},{"text":"Hamboatse iereo, fe harotsako ambane;","poem":1},{"lineBreak":true},{"text":"naho hatao tanem-piaroteñe i toetsey,","poem":1},{"lineBreak":true},{"text":"ie ondaty mahaviñetse Iehovà nainai’eo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho isa’ o fihaino’areoo,","poem":1},{"lineBreak":true},{"text":"vaho hanao ty hoe: Jabahinake t’Iehovà","poem":1},{"lineBreak":true},{"text":"alafe’ o efe-tane’ Israeleo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miasy an-drae’e ty ana-dahy,","poem":1},{"lineBreak":true},{"text":"naho an-talè’e ty ondevo,","poem":1},{"lineBreak":true},{"text":"aa kanao izaho t’i Rae,","poem":1},{"lineBreak":true},{"text":"aia ty fiasiañe Ahiko?","poem":1},{"lineBreak":true},{"text":"Katao Talè iraho,","poem":1},{"lineBreak":true},{"text":"aia ty fañeveñañe amako?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy amo","poem":1},{"lineBreak":true},{"text":"mpisoroñe manirìka ty añarakoo.","poem":1},{"lineBreak":true},{"text":"Ie anoa’areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Aia ty nanirikà’ay ty tahina’O?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie mibanabana mofo maleotse amy kitrelikoy, naho manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Akore ty nanivà’ay Azo?","poem":1},{"lineBreak":true},{"text":"Ie atao’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Mavo ty fandambaña’ Iehovà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie mañenga ty goa hisoroñañe,","poem":1},{"lineBreak":true},{"text":"tsy haloloañe hao?","poem":1},{"lineBreak":true},{"text":"Ie engaeñe ty mikotrile","poem":1},{"lineBreak":true},{"text":"naho ty aman-kandra,","poem":1},{"lineBreak":true},{"text":"tsy haratiañe hao?","poem":1},{"lineBreak":true},{"text":"Ibanabanao amy mpifehe’ areoy,","poem":1},{"lineBreak":true},{"text":"hifalea’e hao? ho no’e hao irehe?","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie amy zao, naho miambane","poem":1},{"lineBreak":true},{"text":"hihalaly ty fañisohan’ Añahare,","poem":1},{"lineBreak":true},{"text":"hiferenaiña’e hao?","poem":1},{"lineBreak":true},{"text":"naho banabanae’areo izay?","poem":1},{"lineBreak":true},{"text":"Ho rambese’e soa v’inahareo?","poem":1},{"lineBreak":true},{"text":"Hoe t’Iehovà’ i Màroy:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ia ama’areo ty handrindriñe o lalakoo","poem":1},{"lineBreak":true},{"text":"tsy mone ho viañeñe an-kitreliko eo ty tsy vente’e!","poem":1},{"lineBreak":true},{"text":"Tsy mahafale ahy nahareo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy, vaho tsy noko","poem":1},{"lineBreak":true},{"text":"o banabanam-pità’ areoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amy te boak’am-panjirihan’ andro añe pak’am-pitsofora’e,","poem":1},{"lineBreak":true},{"text":"le ra’elahy amo fifeheañeo ty añarako;","poem":1},{"lineBreak":true},{"text":"amy ze fañembohañe naho","poem":1},{"lineBreak":true},{"text":"fañengañe mahakama malio ami’ty añarako,","poem":1},{"lineBreak":true},{"text":"fa Ra’elahy amo kilakila’ ondatio","poem":1},{"lineBreak":true},{"text":"ty añarako,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"F’ie teraterà’ areo,","poem":1},{"lineBreak":true},{"text":"ami’ty atao’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Nivetàñe ty fandambaña’ i Talè,","poem":1},{"lineBreak":true},{"text":"naho o vokare’eo,","poem":1},{"lineBreak":true},{"text":"vaho tiva o mahakama’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mbore atao’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Hete! mahamokotse!","poem":1},{"lineBreak":true},{"text":"mbore injè’ areo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"endese’ areo ty nitavaneñe,","poem":1},{"lineBreak":true},{"text":"ty mikotrile, naho ty boròka,","poem":1},{"lineBreak":true},{"text":"vaho engae’ areo hisoroñañe,","poem":1},{"lineBreak":true},{"text":"ho noko am-pità’areo hao? hoe t’Iehovà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fàtse ty mpikatramo,","poem":1},{"lineBreak":true},{"text":"ie aman-kobatròke amy lia-rai’ey,","poem":1},{"lineBreak":true},{"text":"le ie mifanta: i aman-kàndray","poem":1},{"lineBreak":true},{"text":"ty engae’e amy Talè,","poem":1},{"lineBreak":true},{"text":"Izaho Mpanjaka ra’elahy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"naho añeveñañe amo fifeheañeo","poem":1},{"lineBreak":true},{"text":"ty añarako.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Malaký: irako; anjeliko","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Iakobe: mpamañahy; tomitse","reference":{"chapter":1,"verse":2}},{"noteId":2,"caller":"+","text":"Esave: i mitoloñey, i mahahenekey","reference":{"chapter":1,"verse":2}}]},"thisChapterLink":"/api/tdx_sle/MAL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MAL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ZEC/14.json","previousChapterAudioLinks":{},"numberOfVerses":14}