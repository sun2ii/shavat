{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MAL","translationId":"tdx_sle","name":"Malaký","commonName":"Malaký","title":"Malaký","order":39,"numberOfChapters":3,"sha256":"fa462c0739806cf442c68701e367c5f1f79903b50e459e5153dde0759b23da01","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MAL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/MAL/3.json","totalNumberOfVerses":55},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ie henane zao: ho anahareo o lily zao ry mpisoroñeo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aa naho tsy haoñe’ areo,","poem":1},{"lineBreak":true},{"text":"naho tsy tsakore’ areo añ’arofo ao,","poem":1},{"lineBreak":true},{"text":"ty handrenge i añarakoy, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le hañitrifako fatse,","poem":1},{"lineBreak":true},{"text":"vaho hozoñeko o fitahia’ areoo;","poem":1},{"lineBreak":true},{"text":"eka, toe fa nozoñeko, amy te","poem":1},{"lineBreak":true},{"text":"tsy ifahara’ ty tro’ areo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ingo, hendahako o tabiri’areoo,","poem":1},{"lineBreak":true},{"text":"le ho hosorako hativàñe o lahara’ areoo,","poem":1},{"lineBreak":true},{"text":"ty tai’ o takataka’ areoo;","poem":1},{"lineBreak":true},{"text":"ie hisese añe mindre ama’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fohino arè te nampihitrifeko","poem":1},{"lineBreak":true},{"text":"ama’ areo ty lily toy,","poem":1},{"lineBreak":true},{"text":"soa te ho amy Levý nainai’e i fañinakoy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haveloñe naho filongoañe","poem":1},{"lineBreak":true},{"text":"i fañinako ama’ey;","poem":1},{"lineBreak":true},{"text":"natoloko aze ho fañeveñañe,","poem":1},{"lineBreak":true},{"text":"toe nañeveña’e","poem":1},{"lineBreak":true},{"text":"vaho niambane ami’ty añarako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tam-palie’e ao i Hake vantañey","poem":1},{"noteId":3},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho tsy nitendrek’ am-pamele’e ao","poem":1},{"lineBreak":true},{"text":"ty hatsivokarañe;","poem":1},{"lineBreak":true},{"text":"ie nindre nañavelo amako an-kanintsiñe naho an-kavañonañe vaho maro ty nampiambohoe’e ami’ty raty.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe fañajàn-kilala ty fivimbim-pisoroñe, vaho ho tsoeheñe am-palie’e ao ty Hake;","poem":1},{"lineBreak":true},{"text":"ie ìra’ Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe nitsile amy lalañey nahareo,","poem":1},{"lineBreak":true},{"text":"naho nampitsikapy ty maro amy Hake;","poem":1},{"lineBreak":true},{"text":"nitivae’ areo ty fañina’ i Levý,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa le nisirikaeko naho nimavoeko añatrefa’ ze kila ondaty","poem":1},{"lineBreak":true},{"text":"amy te tsy nambena’ areo o lalakooy,","poem":1},{"lineBreak":true},{"text":"vaho mirihy t’ie mañorike Hake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy raik’ avao hao t’i Raentika?","poem":1},{"lineBreak":true},{"text":"Tsy Andrianañahare Raike hao ty namboatse an-tika?","poem":1},{"lineBreak":true},{"text":"Aa vaho akore te songa","poem":1},{"lineBreak":true},{"text":"mifampikatramo aman-drahalahy,","poem":1},{"lineBreak":true},{"text":"hiteratera i fañinan-droaentikañey?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa nanao hatsivokarañe t’Iehodà,","poem":1},{"lineBreak":true},{"text":"hativàñe ty nanoeñe e Israele ao","poem":1},{"lineBreak":true},{"text":"naho e Ierosalaime ao;","poem":1},{"lineBreak":true},{"text":"fa vineta’ Iehodà i toetse navahe’ Iehovày ie nikokoa’e,","poem":1},{"lineBreak":true},{"text":"amy nañenga’e ty anak’ ampelan-","poem":1},{"lineBreak":true},{"text":"drahare ambahiny ho vali’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haitoa’ Iehovà amo kiboho’ Iakobeo","poem":1},{"lineBreak":true},{"text":"t’indaty manao izay, ie mañenga soroñe","poem":1},{"lineBreak":true},{"text":"amy Iehovà’ i maroiy.","poem":1},{"lineBreak":true},{"text":"he t’ie mpiaolo ke te mpañorike.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inao ka ty fanoe’areo:","poem":1},{"lineBreak":true},{"text":"atsafe’ areo rano-maso ty kitreli’ Iehovà, am-pirovetañe, vaho am-pangololoihañe,","poem":1},{"lineBreak":true},{"text":"amy te tsy haoñe’e i engay,","poem":1},{"lineBreak":true},{"text":"tsy no’e ty handrambe an-taña’ areo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le anoa’areo ty hoe: Aa vaho akore?","poem":1},{"lineBreak":true},{"text":"Amy te Iehovà ro valolombeloñe","poem":1},{"lineBreak":true},{"text":"añivo’o naho i tañanjomban-","poem":1},{"lineBreak":true},{"text":"katora’oy, i fañahie’oy,","poem":1},{"lineBreak":true},{"text":"ndra te nirañe’o i valim-pañina’oy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa tsy nanoe’e [nofotse] raike hao?","poem":1},{"lineBreak":true},{"text":"Aa manao akore t’ie raike?","poem":1},{"lineBreak":true},{"text":"naho tsy te ipaia’e tiry mpañori-Kake.","poem":1},{"lineBreak":true},{"text":"Aa le itaò ty arofo’ areo,","poem":1},{"lineBreak":true},{"text":"ehe te tsy eo ty hifotetse","poem":1},{"lineBreak":true},{"text":"amy tañanjomban-katora’ey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hejeko ty tsei-valy, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"naho ty misaroñe tiñake hoe t’ie sikiñe,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"aa le itaò o tro’ areoo,","poem":1},{"lineBreak":true},{"text":"tsy mone hivalike.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa nimokore’ areo","poem":1},{"lineBreak":true},{"text":"t’Iehovà amo enta’ areoo.","poem":1},{"lineBreak":true},{"text":"le manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Aa vaho akore ty nampimokora’ay?","poem":1},{"lineBreak":true},{"text":"Ami’ty atao’ areo ty hoe:","poem":1},{"lineBreak":true},{"text":"Hene soa am-pivazohoa’ Iehovà eo","poem":1},{"lineBreak":true},{"text":"ze manao raty, vaho no’e!","poem":1},{"lineBreak":true},{"text":"ndra ty hoe;","poem":1},{"lineBreak":true},{"text":"Aia i Andrianañaharen-","poem":1},{"lineBreak":true},{"text":"kavantañañey?","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Nek 9:13","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/tdx_sle/MAL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MAL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MAL/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}