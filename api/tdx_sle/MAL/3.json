hoe mpampitranake","poem":1},{"lineBreak":true},{"text":"naho mpañalio volafoty,","poem":1},{"lineBreak":true},{"text":"hañefetse o ana’ i Levio,","poem":1},{"lineBreak":true},{"text":"hampitranake iereo","poem":1},{"lineBreak":true},{"text":"hoe volamena naho volafoty,","poem":1},{"lineBreak":true},{"text":"hibanabana’ iareo enga an-kavantañañe am’ Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie amy zay ho no’ Iehovà o banabana’ Iehodà naho Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"manahake tañ’andro taolo,","poem":1},{"lineBreak":true},{"text":"naho tan-taoñe haehae.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"F’ie hafetsako am-pizakàñe heike;","poem":1},{"lineBreak":true},{"text":"fa valolombeloñe mahimbañe","poem":1},{"lineBreak":true},{"text":"iraho amo mpamorekeo,","poem":1},{"lineBreak":true},{"text":"naho amo mpañarapilo,","poem":1},{"lineBreak":true},{"text":"naho amo mpanao fanta vìlañeo;","poem":1},{"lineBreak":true},{"text":"naho amo mpikatramo","poem":1},{"lineBreak":true},{"text":"ty tambe’ i mpikaramay","poem":1},{"lineBreak":true},{"text":"naho i vantotsey naho i bode-raeio;","poem":1},{"lineBreak":true},{"text":"naho amo manitake ty ambahiny ami’ty zo’e;","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy mañeveñe amako,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Izaho Iehovà tsy miova","poem":1},{"noteId":4},{"lineBreak":true},{"text":"ro tsy mahamongotse anahareo","poem":1},{"lineBreak":true},{"text":"ry ana’ Iakobeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sikal’ aman-droae’ areo","poem":1},{"lineBreak":true},{"text":"ty niambohoa’ areo o fañèkoo,","poem":1},{"lineBreak":true},{"text":"naho tsy niambena’ areo,","poem":1},{"lineBreak":true},{"text":"mimpolia amako, le hitolihako,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1},{"lineBreak":true},{"text":"Fe hoe nahareo,","poem":1},{"lineBreak":true},{"text":"Aa vaho akore ty himpolia’ay?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hampikametse aman’ Añahare hao","poem":1},{"lineBreak":true},{"text":"t’indaty? F’ie nikamera’areo.","poem":1},{"lineBreak":true},{"text":"Aa hoe nahareo:","poem":1},{"lineBreak":true},{"text":"Ami’ty aia ty nikamera’ay?","poem":1},{"lineBreak":true},{"text":"Amo faha-foloo, naho amo engao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Silofem-pàtse nahareo,","poem":1},{"lineBreak":true},{"text":"amy te fonga nikizo ahiko,","poem":1},{"lineBreak":true},{"text":"Eka naho ty fifeheañe toy iaby.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hene aseseo an-driha i fahafoloy,","poem":1},{"lineBreak":true},{"text":"soa te ama’ mahakama ty an-kivohoko ao,","poem":1},{"lineBreak":true},{"text":"le tsoho iraho ty amy zao,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"hera hisokafako o lalan-dikerañeo","poem":1},{"lineBreak":true},{"text":"hampidoandoañako fañanintsiñe","poem":1},{"lineBreak":true},{"text":"tsy hierañañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hendahako ty ama’ areo","poem":1},{"lineBreak":true},{"text":"i mampibotsekey tsy hampianto ty vokan-tane’ areo;","poem":1},{"lineBreak":true},{"text":"vaho tsy hañary o voa’e tsy matoeo","poem":1},{"lineBreak":true},{"text":"o vahe’ areo an-tetek’ aoo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le hatao’ ze hene fifeheañe ty hoe:","poem":1},{"lineBreak":true},{"text":"Haha nahareo; fa ho tane fanjàka,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanoa’areo saontsy maràñe, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"mbore manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Akore ty nañinjea’ay azo?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nanao ty hoe nahareo:","poem":1},{"lineBreak":true},{"text":"Tsy vente’e ty mitoroñe","poem":1},{"lineBreak":true},{"text":"an’Andrianañahare;","poem":1},{"lineBreak":true},{"text":"ino ty tombo’e ho antika","poem":1},{"lineBreak":true},{"text":"t’ie mitañe o fandilia’eo,","poem":1},{"lineBreak":true},{"text":"naho mañavelo am-pirevendreveñañe","poem":1},{"lineBreak":true},{"text":"am’ Iehovà’ i Màroy?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie amy zao, ataon-tika ho haha","poem":1},{"lineBreak":true},{"text":"o mpiebotsebotseo,","poem":1},{"lineBreak":true},{"text":"eka onjoneñe o mpikitro-draha ratio,","poem":1},{"lineBreak":true},{"text":"ie mitsok’ an’Andrianañahare,","poem":1},{"lineBreak":true},{"text":"vaho mipolititse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nifanaontsy amy zao","poem":1},{"lineBreak":true},{"text":"o mpañeveñe am’ Iehovào;","poem":1},{"lineBreak":true},{"text":"nañaoñe t’Iehovà naho nahajanjiñe,","poem":1},{"lineBreak":true},{"text":"vaho sinokitse añ’atrefa’e eo","poem":1},{"lineBreak":true},{"text":"ty bokem-paniahiañe,","poem":1},{"lineBreak":true},{"text":"ho amo mpañeveñe am’ Iehovào,","poem":1},{"lineBreak":true},{"text":"naho o miasy i tahina’eio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ho ahy iereo, hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"le harovako amy andro amoriako o varakooy;","poem":1},{"lineBreak":true},{"text":"manahake ty fañarova’ ondaty","poem":1},{"lineBreak":true},{"text":"i ana’e mitoroñe azey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie amy zay, ho oni’areo ty fiavaha’","poem":1},{"lineBreak":true},{"text":"ty vantañe ami’ty tsivokatse,","poem":1},{"lineBreak":true},{"text":"ty mitoroñe an’Andrianañahare","poem":1},{"lineBreak":true},{"text":"ami’ty tsy mitoroñe Aze.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Inao, ho tondroke ty andro","poem":1},{"lineBreak":true},{"text":"hirehetse hoe toñake;","poem":1},{"lineBreak":true},{"text":"ie ho ahe-maike iaby","poem":1},{"lineBreak":true},{"text":"o mpirengevokeo","poem":1},{"lineBreak":true},{"text":"naho o mpanao haloloañeo;","poem":1},{"lineBreak":true},{"text":"hampirebareba iareo amy andro ho aviy,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"vaho tsy hapo’e ndra vahatse ndra singa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fe ama’ areo mpañeveñe ami’ty añarako,","poem":1},{"lineBreak":true},{"text":"ro hanjiriha’ ty andron-kavañonañe,","poem":1},{"lineBreak":true},{"text":"reketse fijangañañe an-dengon-tsaro’e eo","poem":1},{"noteId":5},{"text":";","poem":1},{"lineBreak":true},{"text":"hionjom-beo nahareo","poem":1},{"lineBreak":true},{"text":"manahake ty fivoamboañan-tsarake boak’an-kijoly ao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Le ho lialià’ areo o lo-tserekeo;","poem":1},{"lineBreak":true},{"text":"ie ho lavenok’ ambane’ lelam-pandia’","poem":1},{"lineBreak":true},{"text":"areo ao amy andro anoeko izay,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tiahio i Ha’ i Mosè mpitorokoy,","poem":1},{"lineBreak":true},{"text":"i nafantoko aze e Korebe añey:","poem":1},{"lineBreak":true},{"text":"o fañè naho fepetse ho a Israele iabio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Inao te hiraheko ama’ areo t’i Elià","poem":1},{"noteId":6},{"lineBreak":true},{"text":"mpitoky aolo’ i andro Iehovà jabajaba","poem":1},{"lineBreak":true},{"text":"naho maharevendreveñey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie ty hampimpoly ty arofon-droae","poem":1},{"lineBreak":true},{"text":"amo ana’eo, naho o tron’anakeo","poem":1},{"lineBreak":true},{"text":"aman-droae’iareoo;","poem":1},{"lineBreak":true},{"text":"tsy mone homb’eo iraho handafa","poem":1},{"lineBreak":true},{"text":"i taney am-pandrotsahañe do’e.","poem":1},{"noteId":7}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Iak 1:17","reference":{"chapter":3,"verse":6}},{"noteId":5,"caller":"+","text":"Oniño: Vol 15.38-39","reference":{"chapter":3,"verse":20}},{"noteId":6,"caller":"+","text":"Elià: Andrianañahare; Talè Maozatse","reference":{"chapter":3,"verse":23}},{"noteId":7,"caller":"+","text":"Zek 14:13, Lke 1:16-17, 76","reference":{"chapter":3,"verse":24}}]},"thisChapterLink":"/api/tdx_sle/MAL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MAL/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}