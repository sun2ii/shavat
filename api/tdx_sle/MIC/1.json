":"naho ho vaky o vavataneo,","poem":1},{"lineBreak":true},{"text":"manahake ty takafotse añatrefa’ ty afo eo,","poem":1},{"lineBreak":true},{"text":"naho rano nadoandoañe am-piroroñañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fonga ty amo fiolà’ Iakobeo","poem":1},{"noteId":9},{"text":",","poem":1},{"lineBreak":true},{"text":"naho o tahi’ i anjomba’ Israeleio","poem":1},{"noteId":10},{"text":";","poem":1},{"lineBreak":true},{"text":"Ino i hakeo’ Iakobey?","poem":1},{"lineBreak":true},{"text":"Tsy i Somerone hao?","poem":1},{"lineBreak":true},{"text":"Aia o ankaboa’ Iehodao?","poem":1},{"lineBreak":true},{"text":"Tsy e Ierosalaime hao?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le hanoeko fivotrim-porompotse","poem":1},{"lineBreak":true},{"text":"an-tetek’ ao ty Somerone,","poem":1},{"lineBreak":true},{"text":"ho tanem-bahe; naho","poem":1},{"lineBreak":true},{"text":"haparatsiako am-bavatane ao o vato’eo,","poem":1},{"lineBreak":true},{"text":"vaho haboako o mananta’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho demodemoheñe iaby o samposampo’eo,","poem":1},{"lineBreak":true},{"text":"le ho forototoeñe añ’afo ao","poem":1},{"lineBreak":true},{"text":"o nibanabanaeñe ama’eo;","poem":1},{"lineBreak":true},{"text":"ho rotsaheko iaby o saren-drahare’eo,","poem":1},{"lineBreak":true},{"text":"fa natonto’e an-tamben-karapilo,","poem":1},{"lineBreak":true},{"text":"le hibalike ho tamben-tsimirirañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa le hangoihoy naho hikoiakoiake iraho,","poem":1},{"lineBreak":true},{"text":"hihalo naho hibongy te handeha;","poem":1},{"lineBreak":true},{"text":"hanao fitrèn-drimo vaho","poem":1},{"lineBreak":true},{"text":"fandalàm-boron-tsatrañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy lefe hahàñe o fere’eo,","poem":1},{"lineBreak":true},{"text":"fa nandakake mb’e Iehoda ao;","poem":1},{"lineBreak":true},{"text":"fa nahatakatse ty lalambei’ ondatikoo;","poem":1},{"lineBreak":true},{"text":"Eka, pak’ e Ierosalaime ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko taroñe’o e Gate añe,","poem":1},{"lineBreak":true},{"text":"ko mirovetse;","poem":1},{"lineBreak":true},{"text":"mivarimbariña an-davenok’ ao","poem":1},{"lineBreak":true},{"text":"ty amy anjomba’ i Ofrày","poem":1},{"noteId":11},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mihelaña mb’eo ry mpimoneñe e Safire ao","poem":1},{"noteId":12},{"text":";","poem":1},{"lineBreak":true},{"text":"ami’ty hameñaram-piboridaña’o;","poem":1},{"lineBreak":true},{"text":"tsy lefe ty fivoratsaha’ o","poem":1},{"lineBreak":true},{"text":"mpimone’ i Tsa’ananeo","poem":1},{"noteId":13},{"text":";","poem":1},{"lineBreak":true},{"text":"mangololoike ty Bete’haetsele","poem":1},{"noteId":14},{"lineBreak":true},{"text":"hasinta’e ama’o ty fijohaña’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mifeak’ am-pitamàñe hasoa","poem":1},{"lineBreak":true},{"text":"o mpimone’ i Maròteo","poem":1},{"noteId":15},{"lineBreak":true},{"text":"fe nivotrak’ an-dalambei’","poem":1},{"lineBreak":true},{"text":"Ierosalaime eo boak’ am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty hankàñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Feheo amo sareteo o soavalao,","poem":1},{"lineBreak":true},{"text":"ry mpimone’ i Lakìse","poem":1},{"noteId":16},{"text":",","poem":1},{"lineBreak":true},{"text":"ihe namototse ty hakeo’","poem":1},{"lineBreak":true},{"text":"i anak’ ampela’ i Tsioney","poem":1},{"noteId":17},{"text":",","poem":1},{"lineBreak":true},{"text":"vaho nizoeñe ama’o","poem":1},{"lineBreak":true},{"text":"o fiolà’ Israeleo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aa le ho banabanae’o ravoravom-piavotañe ty Moresete-Gate;","poem":1},{"lineBreak":true},{"text":"ho famañahiañe amo mpanjaka’","poem":1},{"lineBreak":true},{"text":"Israeleo o anjomba’ i Akzìbeo","poem":1},{"noteId":18},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mbore haseseko ama’o ty mpitavañe,","poem":1},{"lineBreak":true},{"text":"ry mpimone’ i Maresà;","poem":1},{"lineBreak":true},{"text":"himoak’ Adolame","poem":1},{"noteId":19},{"text":"ao ty enge’ Israele.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mipeaha irehe, miharata","poem":1},{"lineBreak":true},{"text":"ty amo anake mahafale azoo;","poem":1},{"lineBreak":true},{"text":"indrao ty hasola’o hifanahak’ ami’ty koáke, ie hieng’azo mb’an-drohy mb’eo.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mikà: rarake; mpireke","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Morestete; Fanaña’ i Gate","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"Iotame: ty havantaña’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"Akhaze: mpitavañe","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"+","text":"Iekezkia: Haozara’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":5,"caller":"+","text":"Somerone: Vohi-pijilovañe","reference":{"chapter":1,"verse":1}},{"noteId":6,"caller":"+","text":"Ierosalaime: Aroñarom-pañanintsiñe","reference":{"chapter":1,"verse":1}},{"noteId":7,"caller":"+","text":"Ies 26:21","reference":{"chapter":1,"verse":3}},{"noteId":8,"caller":"+","text":"Sab 97:5","reference":{"chapter":1,"verse":4}},{"noteId":9,"caller":"+","text":"Iakobe: tomitse; mpanolo aman-kalitake","reference":{"chapter":1,"verse":5}},{"noteId":10,"caller":"+","text":"Israele: mpifanehak’ amy Talè","reference":{"chapter":1,"verse":5}},{"noteId":11,"caller":"+","text":"Afrà; mivolañe, mikofòke","reference":{"chapter":1,"verse":10}},{"noteId":12,"caller":"+","text":"Safire; Mpizaka