{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MIC","translationId":"tdx_sle","name":"Mikà","commonName":"Mikà","title":"Mikà","order":33,"numberOfChapters":7,"sha256":"387832a9e3b8c9c57e474eb650732fb793d8321c8ef36d857d16448f4e28fd5f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tdx_sle/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe amo mpikilily","poem":1},{"lineBreak":true},{"text":"hatsivokarañeo,","poem":1},{"lineBreak":true},{"text":"o mikitro-draha an-tihi’eo!","poem":1},{"lineBreak":true},{"text":"Ie berabera andro le mañeneke","poem":1},{"lineBreak":true},{"text":"kanao am-pità’ iareo ty haozarañe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mihañe teteke, le mitavañe,","poem":1},{"lineBreak":true},{"text":"naho anjomba, le minday;","poem":1},{"lineBreak":true},{"text":"aa le forekekè’ iereo","poem":1},{"lineBreak":true},{"text":"ty fokontokoñe rekets’ i akiba’ey,","poem":1},{"lineBreak":true},{"text":"vaho t’indaty naho i lova’ey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa le hoe ty nafè’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Inao, safirieko hekoheko ty fifokoañe toy,","poem":1},{"lineBreak":true},{"text":"le tsy haha-votso-­bozoñ’ ama’e nahareo,","poem":1},{"lineBreak":true},{"text":"vaho ko mañavelo an-drengevoke;","poem":1},{"lineBreak":true},{"text":"fa ho san-kankàñe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy andro zay le handrazan-drehake","poem":1},{"lineBreak":true},{"text":"ty ama’o iereo,","poem":1},{"lineBreak":true},{"text":"naho handala am-pirovetañe ty hoe:","poem":1},{"lineBreak":true},{"text":"Vata’e rotsake zahay;","poem":1},{"lineBreak":true},{"text":"novae’e ty anjara’ ondatikoo,","poem":1},{"lineBreak":true},{"text":"akore ty nanintaha’e amako!","poem":1},{"lineBreak":true},{"text":"Tsy ho navaha’e o tete’aio? te mone zarae’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le tsy eo ty hikozozotse talim-panjeheañe an-kitsapak’ ami’ty valobohò’ Iehovà ho azo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko mitaroñe, hoe ty taroñe’ iareo;","poem":1},{"lineBreak":true},{"text":"Tsy hitaroña’iareo o raha zao,","poem":1},{"lineBreak":true},{"text":"tsy mone ho salareñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hoe ty volañeñe ry anjomba’ Iakobe,","poem":1},{"lineBreak":true},{"text":"Tsy mahaliñe hao t’i Arofo’ Iehovà?","poem":1},{"lineBreak":true},{"text":"Sata’e hao rezao?","poem":1},{"lineBreak":true},{"text":"Tsy mahasoa ty mpañavelo an-kavantañañe hao o volakoo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe nitroatse ho rafelahy omale ondatikoo; endahe’ areo ty sarimbo reketse ty akanjo’ ondaty mitoañe am-panintsiñañeo,","poem":1},{"lineBreak":true},{"text":"o mimpoly boak’añ’alio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampisitahe’ areo o rakemba’ ondatikoo; songa boak’ añ’anjomba’e soa fihamiñe; asinta’ areo amo keleia’ iareoo kitro-katroke ty engeko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Miongaha! Akia! fa tsy fitofà’ areo ty atoy; i haloera’ey ty maharotsake","poem":1},{"lineBreak":true},{"text":"am-pandrotsahañe mitivontivoñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naho teo ty mpañorike tioke naho vande, nandañitse ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Hitaroñe divay naho toake","poem":1},{"lineBreak":true},{"text":"ama’ areo iraho,","poem":1},{"lineBreak":true},{"text":"ie ty hatao mpilañoñe","poem":1},{"lineBreak":true},{"text":"am’ondaty retoañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe havoriko irehe, ry Iakobe, ihe iaby;","poem":1},{"lineBreak":true},{"text":"toe hatontoko ty sengaha’ Israele;","poem":1},{"lineBreak":true},{"text":"hatraoko hoe añondry","poem":1},{"lineBreak":true},{"text":"am-piandrazañe ao;","poem":1},{"lineBreak":true},{"text":"manahake ty lia-raik’ an-golobo’e ao;","poem":1},{"lineBreak":true},{"text":"higoreongoreoñe ty am’ondatio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Miakatse aolo’ iareo mb’eo","poem":1},{"lineBreak":true},{"text":"t’i Mpampiboroboñake;","poem":1},{"lineBreak":true},{"text":"miboroboñake mb’eo iereo,","poem":1},{"lineBreak":true},{"text":"mivavatse mb’an-dalambey","poem":1},{"lineBreak":true},{"text":"naho miakatse añe;","poem":1},{"lineBreak":true},{"text":"vaho miary aolo mb’eo ty Mpanjaka’ iareo, Iehovà ty mpiaolo’ iareo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}