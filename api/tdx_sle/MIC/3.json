{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MIC","translationId":"tdx_sle","name":"Mikà","commonName":"Mikà","title":"Mikà","order":33,"numberOfChapters":7,"sha256":"387832a9e3b8c9c57e474eb650732fb793d8321c8ef36d857d16448f4e28fd5f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tdx_sle/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Le hoe iraho:","poem":1},{"lineBreak":true},{"text":"Ehe, mijanjiña ry roandria’ Iakobe,","poem":1},{"lineBreak":true},{"text":"naho o lohà’ i anjomba’ Israeleio,","poem":1},{"lineBreak":true},{"text":"tsy inahareo hao ty hahafohiñe ty hatò?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry mpalain-ty soa, naho mpitea haratiañeo; ry mampikorendake ty holi’ iareo,","poem":1},{"lineBreak":true},{"text":"naho ty nofotse boak’an-taola’ iareo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ry mpampibotseke ty nofo’ ondatikoo, mpañolitse iareo, mpampipozake o taola’eo, naho manoritory iareo ho am-balàñeo,","poem":1},{"lineBreak":true},{"text":"hoe hena an-tsajoa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hitoreo am’ Iehovà iereo henane zay,","poem":1},{"lineBreak":true},{"text":"f’ie tsy hanoiñe;","poem":1},{"lineBreak":true},{"text":"eka, haeta’e am’ iereo ty lahara’e","poem":1},{"lineBreak":true},{"text":"amy andro zay,","poem":1},{"lineBreak":true},{"text":"ty amy haloloan-tsata’ iareoy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hoe ty nafè’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty amo mpitoky mampandilatse ondatikoo; mikoike ty hoe:","poem":1},{"lineBreak":true},{"text":"Fierañerañañe,","poem":1},{"lineBreak":true},{"text":"kanao ahazoa’e ty ho tifarem-pamotsi’e;","poem":1},{"lineBreak":true},{"text":"fe hentseñe’e aly","poem":1},{"lineBreak":true},{"text":"ty tsy mampijon-draha am-palie’e ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le ho haleñe ama’ areo izay,","poem":1},{"lineBreak":true},{"text":"tsy amañ’aroñaroñe,","poem":1},{"lineBreak":true},{"text":"naho ho ieñe ama’ areo,","poem":1},{"lineBreak":true},{"text":"tsy hisikiliañe;","poem":1},{"lineBreak":true},{"text":"ho tsofots’ andro amo mpitokio,","poem":1},{"lineBreak":true},{"text":"himoromoroñe am’ iereo te handro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho salatse o mpioniñeo,","poem":1},{"lineBreak":true},{"text":"vaho ho tangòke o mpisikilio;","poem":1},{"lineBreak":true},{"text":"eka, hanakom-palie iereo,","poem":1},{"lineBreak":true},{"text":"amy te tsy manoiñe t’i Andrianañahare.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe mañatsak’ ahy ty haozaran’","poem":1},{"lineBreak":true},{"text":"Arofo’ Iehovà, naho ty hatò,","poem":1},{"lineBreak":true},{"text":"vaho ty hafatrarañe,","poem":1},{"lineBreak":true},{"text":"hitsey am’ Iakobe i fiolà’ey,","poem":1},{"lineBreak":true},{"text":"naho am’ Israele i hakeo’ey","poem":1},{"noteId":20},{"text":".","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ehe, janjiño zao, ry talen’ akiba’ Iakobeo, naho ry talèn’ anjomba’ Israeleo,","poem":1},{"lineBreak":true},{"text":"ry mpalain-kavantañañeo,","poem":1},{"lineBreak":true},{"text":"vaho mpañamengoke ze atao zaka-to;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie mamboatse i Tsione an-dio,","poem":1},{"lineBreak":true},{"text":"naho Ierosalaime an-katsivokarañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mpizaka mipay tambe o mpiaolo’eo;","poem":1},{"lineBreak":true},{"text":"mipay karama te mañòke","poem":1},{"noteId":21},{"text":"o mpisoro’eo, naho mpitoky mpangala falitse o mpitoki’eo;","poem":1},{"lineBreak":true},{"text":"inao, miato am’ Iehovà iereo,","poem":1},{"lineBreak":true},{"text":"manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy añivon-tika hao t’Iehovà?","poem":1},{"lineBreak":true},{"text":"Toe tsy hifetsahan-kankàñe!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le inahareo ro itrabahañe i Tsione hoe tonda,","poem":1},{"lineBreak":true},{"text":"naho Ierosalaime ho votrim-porompotse,","poem":1},{"lineBreak":true},{"text":"vaho ty an-tamboho’","poem":1},{"lineBreak":true},{"text":"i vohi’ i anjombaiy ho ala.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Fi II 24:20, Jao 16:8","reference":{"chapter":3,"verse":8}},{"noteId":21,"caller":"+","text":"Jao 10:12","reference":{"chapter":3,"verse":11}}]},"thisChapterLink":"/api/tdx_sle/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}