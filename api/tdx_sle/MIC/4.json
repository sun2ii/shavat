{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MIC","translationId":"tdx_sle","name":"Mikà","commonName":"Mikà","title":"Mikà","order":33,"numberOfChapters":7,"sha256":"387832a9e3b8c9c57e474eb650732fb793d8321c8ef36d857d16448f4e28fd5f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tdx_sle/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"F’ie amo andro honka’eo,","poem":1},{"lineBreak":true},{"text":"le horizañe ho abo amo vohitseo","poem":1},{"lineBreak":true},{"text":"ty vohin-anjomba’ Iehovà,","poem":1},{"lineBreak":true},{"text":"haonjoñe ambone’ o haboañeo;","poem":1},{"lineBreak":true},{"text":"vaho hivovotse mb’ama’e mb’eo ondatio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le homb’eo ty fifeheañe maro","poem":1},{"lineBreak":true},{"text":"hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Antao hionjom-b’am-bohi’Iehovà mb’eo,","poem":1},{"lineBreak":true},{"text":"mb’amy anjomban’Añahare’Iakobey.","poem":1},{"lineBreak":true},{"text":"hañòha’e antikañ’ o sata’eo,","poem":1},{"lineBreak":true},{"text":"hañaveloan-tika o lala’eo.","poem":1},{"lineBreak":true},{"text":"Hionjoñe boake Tsione ao ty Hàke,","poem":1},{"lineBreak":true},{"text":"vaho hirike Ierosalaime ao ty tsara’ Iehovà,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"hizaka añivo’ o kilakila ondatio","poem":1},{"lineBreak":true},{"text":"vaho ho toroa’e lily o foko maozatse","poem":1},{"lineBreak":true},{"text":"tsietoitane añeo.","poem":1},{"lineBreak":true},{"text":"Le ho pehe’ iareo ho fangaly o fibarao","poem":1},{"lineBreak":true},{"text":"naho ho fañeteke o lefo’ iareoo.","poem":1},{"lineBreak":true},{"text":"Tsy hifañonjom-pibara o rofokoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hiòke hialy ka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Songa hiambesatse ambane’","poem":1},{"lineBreak":true},{"text":"ty vahe’e t’indaty naho ambane’ i sakoa’ey eo,","poem":1},{"lineBreak":true},{"text":"tsy ao ty hahahembañe iareo,","poem":1},{"lineBreak":true},{"text":"fa nitsara ty falie’ Iehovà’ i Màroy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sindre hanjotik’ ami’ty añaran-drahare’e o kilakila’ ondatio;","poem":1},{"lineBreak":true},{"text":"fe hañavelo ami’ty tahina’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañaharen-tika","poem":1},{"lineBreak":true},{"text":"nainai’e donia tika","poem":1},{"noteId":22},{"text":".","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hatontoko amy andro zay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ze mikoletra,","poem":1},{"lineBreak":true},{"text":"naho havoriko ty nasiotse añe","poem":1},{"lineBreak":true},{"text":"vaho i nanilofakoy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hanoeko sehanga’e i nikoletray","poem":1},{"lineBreak":true},{"text":"naho fifeheañe maozatse i nasiotsey.","poem":1},{"lineBreak":true},{"text":"ie ho fehe’ Iehovà am-bohi’ i Tsione ao,","poem":1},{"lineBreak":true},{"text":"henane zay naho ho nainai’e añe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le ihe, ry Fitalakesañ’Abo i Lia-Raikey","poem":1},{"noteId":23},{"text":",","poem":1},{"lineBreak":true},{"text":"ty haboa’ i anak’ ampela’ i Tsioney;","poem":1},{"lineBreak":true},{"text":"eka, homb’ama’o mb’eo re;","poem":1},{"lineBreak":true},{"text":"hitotsake eo i fifeheañe taoloy,","poem":1},{"lineBreak":true},{"text":"ty fifeleha’ i Anak’ ampela’ Ierosalaimey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ino ty ikoiakoiaha’o?","poem":1},{"lineBreak":true},{"text":"Tsy amam-panjaka hao?","poem":1},{"lineBreak":true},{"text":"Nihomake hao i Mpanoro azoy,","poem":1},{"lineBreak":true},{"text":"ihe fihine’ ty fanivontivoñañe","poem":1},{"lineBreak":true},{"text":"manahake ty fitsongoan-drakemba?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Minioniòra, mañeña, hisamaha’o,","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ i Tsione,","poem":1},{"lineBreak":true},{"text":"manahake ty ampela mitsongo;","poem":1},{"lineBreak":true},{"text":"fa hiavote’o henaneo i rovay,","poem":1},{"lineBreak":true},{"text":"himoneñe an-kivok’ ao,","poem":1},{"lineBreak":true},{"text":"am-para’ te mandoake e Bavele ao;","poem":1},{"lineBreak":true},{"text":"añe irehe ho hahañe;","poem":1},{"lineBreak":true},{"text":"añe ty hijebaña’ Iehovà azo","poem":1},{"lineBreak":true},{"text":"am-pità’ o rafelahi’oo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie henanekeo maro ty fifeheañe","poem":1},{"lineBreak":true},{"text":"mifanontoñe hialy ama’o,","poem":1},{"lineBreak":true},{"text":"manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ee t’ie ho tivaeñe, naho hahafi­samba i Tsione o fihainon-tikañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa tsy fohi’ iareo ty ereñere’ Iehovà;","poem":1},{"lineBreak":true},{"text":"naho tsy apota’ iareo ty safiri’e;","poem":1},{"lineBreak":true},{"text":"Ie ro nanontoñe iereo hoe ampemba","poem":1},{"lineBreak":true},{"text":"an-toem-pamofohañe eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Miongaha, mamofoha,","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ i Tsione;","poem":1},{"lineBreak":true},{"text":"fa hanoeko viñe ty tsifa’o,","poem":1},{"lineBreak":true},{"text":"naho hanoeko torisìke o hotro’oo;","poem":1},{"lineBreak":true},{"text":"handemodemoke t’indaty maro;","poem":1},{"lineBreak":true},{"text":"vaho hengae’o am’ Iehovà","poem":1},{"lineBreak":true},{"text":"o nivokare’ iareo tsy too;","poem":1},{"lineBreak":true},{"text":"ho amy Talè’ ty tane bey toiy ty vara’ iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mifanontona am-pirimboñañe,","poem":1},{"lineBreak":true},{"text":"ry anak’ ampelam-pirimboñañeo","poem":1},{"lineBreak":true},{"text":"fa vinandro’ iareo tika;","poem":1},{"lineBreak":true},{"text":"nilafàe’ iareo an-kobaiñe ty fiambina’ i Mpizaka’ Israeley.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Zek 10:12","reference":{"chapter":4,"verse":5}},{"noteId":23,"caller":"+","text":"heb: Migdale-edere","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":14}