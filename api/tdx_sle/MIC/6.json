{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MIC","translationId":"tdx_sle","name":"Mikà","commonName":"Mikà","title":"Mikà","order":33,"numberOfChapters":7,"sha256":"387832a9e3b8c9c57e474eb650732fb793d8321c8ef36d857d16448f4e28fd5f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tdx_sle/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Janjiño henaneo ty nafè’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Miongaha, aboaho amo vohitseo o enta’oo, ampitsanoño o haboañeo ty fiarañanaña’o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mitsendreña ry vohitseo, ty sisì’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ry manantañe maoza’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"fa manan-kabò am’ondati’eo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie toe hifanjomotse am’Israele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O ry ondatikoo,","poem":1},{"lineBreak":true},{"text":"ino ty nanoako azo?","poem":1},{"lineBreak":true},{"text":"Akore ty nahamokorako azo?","poem":1},{"lineBreak":true},{"text":"Atalilio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Izaho nañakatse azo","poem":1},{"lineBreak":true},{"text":"an-tane Mitsraime añe,","poem":1},{"lineBreak":true},{"text":"nijebañ’azo an-trañom-pañondevozañe,","poem":1},{"lineBreak":true},{"text":"le nampiaoloeko azo t’i Mosè","poem":1},{"noteId":29},{"text":"naho i Aharone","poem":1},{"noteId":30},{"text":"vaho i Miriame","poem":1},{"noteId":31},{"text":".","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O ry ondatikoo, tiahio henaneo i nikinià’ i Balake","poem":1},{"noteId":32},{"text":"mpanjaka’ i Moabey","poem":1},{"noteId":33},{"text":",","poem":1},{"lineBreak":true},{"text":"naho ty natoi’ i Balame","poem":1},{"noteId":34},{"text":"ana’ i Beore","poem":1},{"noteId":35},{"text":"aze boake Sitime","poem":1},{"noteId":36},{"text":"pake Gilgale","poem":1},{"noteId":37},{"text":",","poem":1},{"lineBreak":true},{"text":"hahafohina’ areo o sata-vanta’ Iehovào.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Akore ty hiatrefako Iehovà?","poem":1},{"lineBreak":true},{"text":"ty hiambaneako aman’ Añahare","poem":1},{"lineBreak":true},{"text":"Andindimoneñey?","poem":1},{"lineBreak":true},{"text":"Hiatrefako an-tsoron-koroañe hao,","poem":1},{"lineBreak":true},{"text":"an-temboay hao?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho no’ Iehovà hao t’ie kobatròk’ arivo?","poem":1},{"lineBreak":true},{"text":"ndra torahañe rai-ale ­mikararàke menake?","poem":1},{"lineBreak":true},{"text":"hatoloko hao ty tañoloñoloñako","poem":1},{"lineBreak":true},{"text":"ty amy fiolàkoy?","poem":1},{"lineBreak":true},{"text":"ty vokan-troko ty amo hakeom-piaikoo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa natoro azo, ry koahe, ty hasoa,","poem":1},{"lineBreak":true},{"text":"naho ty ipaia’ Iehovà:","poem":1},{"lineBreak":true},{"text":"te hanoe’o ty hiti’e,","poem":1},{"lineBreak":true},{"text":"t’ie ho tea fiferenaiñañe,","poem":1},{"lineBreak":true},{"text":"vaho hirè-batañe hindreza’o fañavelo aman’ Añahare’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mikoik’ amy rovay ­­","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ Iehovà,","poem":1},{"lineBreak":true},{"text":"hañaoñe ty tahina’o ty mahihitse.","poem":1},{"lineBreak":true},{"text":"Janjiño i Kobaiñey, naho i nanendre azey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mbe amam-baran-katsivokarañe hao","poem":1},{"lineBreak":true},{"text":"ty añ’akiba’ i lo-tserekey?","poem":1},{"lineBreak":true},{"text":"naho i kapoa-tomotse tìvay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho volilien-ko hiringiri’e hao raho","poem":1},{"lineBreak":true},{"text":"t’ie amam-balantsy vìlañe,","poem":1},{"lineBreak":true},{"text":"naho amam-batom-pamañahiañe an-koroñe ao?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie pea katramo o mpañalealeo,","poem":1},{"lineBreak":true},{"text":"naho mivolam-bande o mpimone’eo,","poem":1},{"lineBreak":true},{"text":"vaho mamañahy am-bava’e ao ty lela’ iareo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa le ho silòfeko irehe,","poem":1},{"lineBreak":true},{"text":"ho zevoñeko ambane, hampibangìñ’ azo","poem":1},{"lineBreak":true},{"text":"ty amo tahi’o maroo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hikama irehe fa tsy ho anjañe;","poem":1},{"lineBreak":true},{"text":"hasalikoañe mampikoritoke","poem":1},{"lineBreak":true},{"text":"ty an-tro’o ao;","poem":1},{"lineBreak":true},{"text":"hanao an-driha irehe fa tsy hahafihaja,","poem":1},{"lineBreak":true},{"text":"vaho hatoloko ami’ty fibara ze nakafi’o.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hitongy irehe fe tsy hanatake;","poem":1},{"lineBreak":true},{"text":"handia olive fe tsy hihosotse","poem":1},{"lineBreak":true},{"text":"amy menakey;","poem":1},{"lineBreak":true},{"text":"naho hampipiritse valoboke,","poem":1},{"lineBreak":true},{"text":"fe tsy hinome’o ty divai’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nitambozora’ areo o fañè’ i Omrio","poem":1},{"noteId":38},{"text":";","poem":1},{"lineBreak":true},{"text":"naho nitàñ’ o sata’ i Akabeo","poem":1},{"noteId":39},{"text":",","poem":1},{"lineBreak":true},{"text":"naho nañavelo amo fisafiri’ iareoo;","poem":1},{"lineBreak":true},{"text":"aa le hampangoakoaheko irehe,","poem":1},{"lineBreak":true},{"text":"hampikosihañe o mpimoneñeo,","poem":1},{"lineBreak":true},{"text":"le ho vavè’ areo ty inje’ ondatikoo.","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Mosè: nakareñe;","reference":{"chapter":6,"verse":4}},{"noteId":30,"caller":"+","text":"Aharone: mpañoke; abo; an-koazara","reference":{"chapter":6,"verse":4}},{"noteId":31,"caller":"+","text":"Miriame: Fiolàñe","reference":{"chapter":6,"verse":4}},{"noteId":32,"caller":"+","text":"Balake: mpandrotsake","reference":{"chapter":6,"verse":5}},{"noteId":33,"caller":"+","text":"Moabe: boak’ aman-drae’e","reference":{"chapter":6,"verse":5}},{"noteId":34,"caller":"+","text":"Ty antetse am’ondatio; ty famongora’e","reference":{"chapter":6,"verse":5}},{"noteId":35,"caller":"+","text":"Beore: mirehetse; dagola; minèñe","reference":{"chapter":6,"verse":5}},{"noteId":36,"caller":"+","text":"Sitime: fatike","reference":{"chapter":6,"verse":5}},{"noteId":37,"caller":"+","text":"Gilgale: larò; mivariñe; votry","reference":{"chapter":6,"verse":5}},{"noteId":38,"caller":"+","text":"Omri: voton-tsako","reference":{"chapter":6,"verse":16}},{"noteId":39,"caller":"+","text":"Akabe: Rahalahin-drae","reference":{"chapter":6,"verse":16}}]},"thisChapterLink":"/api/tdx_sle/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}