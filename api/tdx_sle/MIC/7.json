{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"MIC","translationId":"tdx_sle","name":"Mikà","commonName":"Mikà","title":"Mikà","order":33,"numberOfChapters":7,"sha256":"387832a9e3b8c9c57e474eb650732fb793d8321c8ef36d857d16448f4e28fd5f","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tdx_sle/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe amako! fa manahake","poem":1},{"lineBreak":true},{"text":"i nipòk’ amo vokan’ asara fa natontoñeoy,","poem":1},{"lineBreak":true},{"text":"tsy am-pirotorotom-baloboke ho haneñe; ndra valoham-boa hampilelalela ty fiaiko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa nifaoheñ’ an-tane atoy t’indaty","poem":1},{"lineBreak":true},{"text":"mañori-Kake,","poem":1},{"lineBreak":true},{"text":"tsy ao ty mahity am’ondatio;","poem":1},{"lineBreak":true},{"text":"songa miampitse handrendreke lio,","poem":1},{"lineBreak":true},{"text":"sindre mifañoroñe an-karato","poem":1},{"lineBreak":true},{"text":"o mpirahalahio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fità-roe ty mahatafetetse o sata rati’eo;","poem":1},{"lineBreak":true},{"text":"ipaia’ i roandriañey naho","poem":1},{"lineBreak":true},{"text":"takea’ i mpizakay ty vokàñe;","poem":1},{"lineBreak":true},{"text":"aboa’ ty bey ty fikitrohan-tro’e,","poem":1},{"lineBreak":true},{"text":"vaho rarè’ iereo hitraoke.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hoe hìsatse ty soa am’iereo,","poem":1},{"lineBreak":true},{"text":"hoe vovom-patike ty mahity ama’e;","poem":1},{"lineBreak":true},{"text":"i andro ampitsatohe’o mpijilojiloy:","poem":1},{"lineBreak":true},{"text":"tondroke ty fitilihañe azo;","poem":1},{"lineBreak":true},{"text":"ho doboñe iereo henane zay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko miato rañetse,","poem":1},{"lineBreak":true},{"text":"ko mirampy aman-atehena;","poem":1},{"lineBreak":true},{"text":"amy màndre añ’araña’o eoy,","poem":1},{"lineBreak":true},{"text":"itaò o soñi’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa mañamavo an-drae’e ty ana-dahy,","poem":1},{"lineBreak":true},{"text":"miatreatre an-drene ty anak’ ampela,","poem":1},{"lineBreak":true},{"text":"ty vinanto-ampela aman-drafoza’e ampela; rafelahi’ondatio t’indaty añ’akiba’e ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa naho izaho, hitamà Iehovà;","poem":1},{"lineBreak":true},{"text":"ho liñisako i Andrianañaharem-pandrombahakoy; hijanjiñe ahy t’i Andrianañahareko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko mirebeke ahy, ry mpalaiñ’ ahio, ndra t’ie mikorovoke, mbe hitroatse;","poem":1},{"lineBreak":true},{"text":"ndra mitobok’ añ’ieñe ao,","poem":1},{"lineBreak":true},{"text":"Iehovà ro hazavàko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho vavèko ty haviñera’ Iehovà","poem":1},{"lineBreak":true},{"text":"amy t’ie nandilatse ama’e,","poem":1},{"lineBreak":true},{"text":"ampara’ te ihalalia’e ho ahy,","poem":1},{"lineBreak":true},{"text":"naho ampijadoña’e zakam-pañisohañe; ie hakare’e mb’an-kazavàm-b’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho treako ty havantaña’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho oni’ i rafelahikoy izay,","poem":1},{"lineBreak":true},{"text":"vaho ho saroña’ ty hasalarañe","poem":1},{"lineBreak":true},{"text":"ty nanao amako ty hoe:","poem":1},{"lineBreak":true},{"text":"Aia t’Iehovà Andrianañahare’o?","poem":1},{"lineBreak":true},{"text":"Ho sambae’ o masokoo, ie ho lialiàñe hoe fotak’ an-dalañe eo henane zay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho androm-pampitroarañe o kijoli’oo amy andro zay, hibolea’ i Hake mb’eo mbe’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho androm-pitotsahañ’ ama’o,","poem":1},{"lineBreak":true},{"text":"boak’ Asore naho i Mitsraime,","poem":1},{"lineBreak":true},{"text":"boake Mitsraime pak’amy sakay","poem":1},{"noteId":40},{"text":"; eka, boak’an-driake pak’an-driake, vaho boak’am-bohitse pak’am-bohitse,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le ho koake i taney ty amo mpimone’eo,","poem":1},{"lineBreak":true},{"text":"ho vale’ ty hatsivokaram-pitoloña’ iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Araho an-kobai’o ondati’oo,","poem":1},{"lineBreak":true},{"text":"i lia-rain-dova’o rerek’ añ’ala ao,","poem":1},{"lineBreak":true},{"text":"an-teñateñan-tane marorok’ aoy;","poem":1},{"lineBreak":true},{"text":"andrazo mb’e Basane","poem":1},{"noteId":41},{"text":"naho mb’e Gilade","poem":1},{"noteId":42},{"text":"mb’eo iereo manahake tañ’andro haehae.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Manahake tañ’andro nañakarako azo","poem":1},{"lineBreak":true},{"text":"an-tane Mitsraime ao,","poem":1},{"lineBreak":true},{"text":"le hampiboahako raha fanjaka.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ho oni’ o kilakila’ ondatio le ho salatse ndra te maozatse; hamihim-palie am-pitàñe vaho ho valagìñe an-dravembia.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ie hitsela deboke hoe mereñe,","poem":1},{"lineBreak":true},{"text":"hititititike t’ie miakatse an-kijoly ao hoe merembitike hirik’ an-tane ao; hangebahebake t’ie miheo mb’am’ Iehovà Andrianañaharentika,","poem":1},{"lineBreak":true},{"text":"vaho hañeveñe ama’o iereo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ia t’i Andrianañahare hañirinkiriñe Azo,","poem":1},{"lineBreak":true},{"text":"Mpañafa-kakeo, naho mampipoke ty fiolà’ o honkahonkan-dova’eo!","poem":1},{"lineBreak":true},{"text":"Tsy tana’e nainai’e ty haviñera’e, vaho","poem":1},{"lineBreak":true},{"text":"ifalea’e ty fiferenaiñañe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hiferenaiña’e indraike tika,","poem":1},{"lineBreak":true},{"text":"ho lialiàm-pandia’e o hakeon-tikañeo; Eka! hahifi’o an-driake lalek’ ao o tahi’ iareoo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho tolora’o havantañañe t’Iakobe,","poem":1},{"lineBreak":true},{"text":"naho fiferenaiñañe t’i Avrahame,","poem":1},{"lineBreak":true},{"text":"i nifantà’o aman-droae’ay haehae izay.","poem":1}]}],"footnotes":[{"noteId":40,"caller":"+","text":"Eofrate","reference":{"chapter":7,"verse":12}},{"noteId":41,"caller":"+","text":"Basane: tsinila, tsifa","reference":{"chapter":7,"verse":14}},{"noteId":42,"caller":"+","text":"Gilade: fitoaboran-talily","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}