:"o rahoñeo ro debom-pandia’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Endaha’e i riakey le ampimaihe’e,","poem":1},{"lineBreak":true},{"text":"ampikarakankaiñe’e o sakao;","poem":1},{"lineBreak":true},{"text":"rinotsake t’i Basane naho i Karmele;","poem":1},{"lineBreak":true},{"text":"miheatse ty voñen-katae’ i Libanone.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miezeñezeñe aolo’e eo o vohitseo,","poem":1},{"lineBreak":true},{"text":"mitranake iaby o haboañeo,","poem":1},{"lineBreak":true},{"text":"forototo ty tane toy ami’ty fiatrefa’e,","poem":1},{"lineBreak":true},{"text":"ty voatse toy naho ze mpimoneñe ama’e ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ia ty mahafijohañe añatrefa’","poem":1},{"lineBreak":true},{"text":"o fifombo’eo?","poem":1},{"lineBreak":true},{"text":"Ia ty mahatambeloñe amy","poem":1},{"lineBreak":true},{"text":"fiforoforoan-kaviñera’ey?","poem":1},{"lineBreak":true},{"text":"Ailiñe hoe afo ty filevelevea’e,","poem":1},{"lineBreak":true},{"text":"avokovoko’e ambane iaby ze vato.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Soa t’Iehovà, fipalirañe","poem":1},{"lineBreak":true},{"text":"añ’andron-kankàñe;","poem":1},{"lineBreak":true},{"text":"arofoana’e iaby o miato ama’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"F’ie an-tsorotombahañe mivovò,","poem":1},{"lineBreak":true},{"text":"ty hamongora’e i toe’ey,","poem":1},{"lineBreak":true},{"text":"vaho ho roahe’e mb’ an-kamoromoroñañe ao o rafelahi’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ino ze o fikililia’ areo am’ Iehovà zao?","poem":1},{"lineBreak":true},{"text":"Fa harotsa’e,","poem":1},{"lineBreak":true},{"text":"tsy hiongake fañindroe’e ty hekoheko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa manahake ty fivandiram-patike","poem":1},{"lineBreak":true},{"text":"naho ty hamamoa’ o jikeo,","poem":1},{"lineBreak":true},{"text":"ty hampangotomomoheñe iereo hoe ahe-maike.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Boak’ ama’o ty niavia’","poem":1},{"lineBreak":true},{"text":"i nikitro-draha am’ Iehovày,","poem":1},{"lineBreak":true},{"text":"ie mañeretse hatsivokarañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"ndra t’ie lifo-kaozarañe,","poem":1},{"lineBreak":true},{"text":"naho mitozantozañe,","poem":1},{"lineBreak":true},{"text":"mbe hampikorovoheñe,","poem":1},{"lineBreak":true},{"text":"vaho hihelañe añe;","poem":1},{"lineBreak":true},{"text":"fa ndra te nanilofeko irehe,","poem":1},{"lineBreak":true},{"text":"tsy ho silofeko ka.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hapozako ama’o henaneo ty joka’e,","poem":1},{"lineBreak":true},{"text":"vaho ho rafadrafateko o tali-randra’oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa nandily ty ama’o t’Iehovà,","poem":1},{"lineBreak":true},{"text":"te tsy ho tongisañe ka ty tahina’o;","poem":1},{"lineBreak":true},{"text":"le haitoako amy akiban-drahare’oy","poem":1},{"lineBreak":true},{"text":"ty sare sokin-katae","poem":1},{"lineBreak":true},{"text":"naho ty sare natranake;","poem":1},{"lineBreak":true},{"text":"f’ie hanoako kibory,","poem":1},{"lineBreak":true},{"text":"amy t’ie tsy manjofake.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ninevè: soa vintañe; mete","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Nakome: mpañohò; veka’e hisoloho","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"Elkose: ty figahiñan’Añahare","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/NAM/2.json","nextCha