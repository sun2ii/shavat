{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"NAM","translationId":"tdx_sle","name":"Nakòme","commonName":"Nakòme","title":"Nakòme","order":34,"numberOfChapters":3,"sha256":"b3faff47fd81ec9a2c0444c26165a6af91b40e47c0032ccdef3089f760d957d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Hehek’ an-kaboañe ey","poem":1},{"lineBreak":true},{"text":"o fandia’ i mpinday talily soaio,","poem":1},{"lineBreak":true},{"text":"i mampiboele fifampilongoañey!","poem":1},{"lineBreak":true},{"text":"O ry Iehodà, anò o sabadidake miavakeo, henefo o nifantà’oo;","poem":1},{"lineBreak":true},{"text":"amy te tsy hiranga ama’o ka","poem":1},{"lineBreak":true},{"text":"ty Beliale, fa naitoañe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa nitroatse añ’atrefan-dahara’o eo","poem":1},{"lineBreak":true},{"text":"ty mpandrotsake,","poem":1},{"lineBreak":true},{"text":"tano i kijoliy, jilovo i lalañey,","poem":1},{"lineBreak":true},{"text":"mitokia an-kaozarañe, avorio o hafatrara’oo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vaòe’ Iehovà ty enge’ Iakobe","poem":1},{"lineBreak":true},{"text":"naho ty volonahe’ Israele;","poem":1},{"lineBreak":true},{"text":"fa nampikoake iareo o mampikoakeo,","poem":1},{"lineBreak":true},{"text":"vaho jinoi’ iareo o singam-bahe’eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ho mena mañabarà ty fikalan-defo’","poem":1},{"lineBreak":true},{"text":"o fanalolahio,","poem":1},{"lineBreak":true},{"text":"misikiñe mena iaby o lahin-defo’eo,","poem":1},{"lineBreak":true},{"text":"afo amam-bý miloeloe o sarete’eo","poem":1},{"lineBreak":true},{"text":"amy andro fihentseña’ey,","poem":1},{"lineBreak":true},{"text":"vaho miriñariña iaby o lefon-ambilazoo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitrakotrako amo lalañeo o sareteo,","poem":1},{"lineBreak":true},{"text":"mifaniotsiotse an-diolio eo;","poem":1},{"lineBreak":true},{"text":"manahake ty fañilo ty vinta’ iareo,","poem":1},{"lineBreak":true},{"text":"ie mihelatse mb’etia mb’eroa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tiahi’e i mpiaolo rey;","poem":1},{"lineBreak":true},{"text":"mamingañe iereo te miloka;","poem":1},{"lineBreak":true},{"text":"malisa t’ie handrombake i kijoliy,","poem":1},{"lineBreak":true},{"text":"fa nihentseñeñe ty fikala’e,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Misokake o lalam-pikalañañe i sakaio","poem":1},{"lineBreak":true},{"text":"vaho rinava’e i anjombay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa nivoloseñe i mpanjaka ampelay,","poem":1},{"lineBreak":true},{"text":"fa nasese añe,","poem":1},{"lineBreak":true},{"text":"miñeoñeoñe hoe feon-deho-fona","poem":1},{"lineBreak":true},{"text":"o anak’ ampata’eo,","poem":1},{"lineBreak":true},{"text":"ie mamofok’ arañañe;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manahake o antara haehaeo","poem":1},{"lineBreak":true},{"text":"t’i Ninevè, ie mihelañe añe;","poem":1},{"lineBreak":true},{"text":"mijohaña, mitsangana!","poem":1},{"lineBreak":true},{"text":"fe leo raike tsy mitoli-boho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kopaho o volafotio,","poem":1},{"lineBreak":true},{"text":"haofo o volamenao","poem":1},{"lineBreak":true},{"text":"amy te tsy ho revo ty an-driha ao,","poem":1},{"lineBreak":true},{"text":"fanake tsifotofoto ty ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kapaike re, mangoakoake naho mavo,","poem":1},{"lineBreak":true},{"text":"mitranake ty arofo,","poem":1},{"lineBreak":true},{"text":"mifampigaiñe o ongotseo,","poem":1},{"lineBreak":true},{"text":"mikoritoke iaby ze fisafoa,","poem":1},{"lineBreak":true},{"text":"mikò mainte iaby o vintañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aia i lakaton-dionay,","poem":1},{"lineBreak":true},{"text":"ty famahanañe o liona tora’eo,","poem":1},{"lineBreak":true},{"text":"i fipiapià’ i lionay naho i liona-vavey","poem":1},{"lineBreak":true},{"text":"naho i ana-dionaiy,","poem":1},{"lineBreak":true},{"text":"ie tsy amam-pañembañe?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nahaeneñe o ana’eo ty rinimi’ i lionay,","poem":1},{"lineBreak":true},{"text":"nahatseke o vali’eo o vinono’eo,","poem":1},{"lineBreak":true},{"text":"natsafe’e tsindroke o lava’eo,","poem":1},{"lineBreak":true},{"text":"le nofotse riniatse an-dakato’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Miatreatre azo iraho, hoe t’Iehovà’ i Màroy","poem":1},{"lineBreak":true},{"text":"Haonjoko an-katòeñe o sarete’eo,","poem":1},{"lineBreak":true},{"text":"habotse’ i fibaray o liona tora’oo;","poem":1},{"lineBreak":true},{"text":"le haitoako ami’ty tane toy o tsindro’oo,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho janjiñeñe ka","poem":1},{"lineBreak":true},{"text":"ty fiarañanaña’ o ira’oo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}