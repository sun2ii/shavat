{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"NAM","translationId":"tdx_sle","name":"Nakòme","commonName":"Nakòme","title":"Nakòme","order":34,"numberOfChapters":3,"sha256":"b3faff47fd81ec9a2c0444c26165a6af91b40e47c0032ccdef3089f760d957d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe amy rova mpampiori-dioy,","poem":1},{"lineBreak":true},{"text":"lifotse vande naho vara kinopake,","poem":1},{"lineBreak":true},{"text":"le lia’e tsy modo o tsindroheñeo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inay ty karavantsy!","poem":1},{"lineBreak":true},{"text":"Inao ty fikatrakatrà’ o laròn-tsareteo;","poem":1},{"lineBreak":true},{"text":"heheke ty fitsapio­tsapio’ o soavalao,","poem":1},{"lineBreak":true},{"text":"naho o sarete mitrakotrakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mañoridañe o mpiningitse soavalao,","poem":1},{"lineBreak":true},{"text":"mimilomilotse i fibaray;","poem":1},{"lineBreak":true},{"text":"mipelapelatse i lefoñey;","poem":1},{"lineBreak":true},{"text":"zinamañe i lahialeñey,","poem":1},{"lineBreak":true},{"text":"tsifotofoto o votrin-doloo,","poem":1},{"lineBreak":true},{"text":"o fañova mifitakeo;","poem":1},{"lineBreak":true},{"text":"ie mitsikapy amo fateo;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ty ami’ty hamaro’ o hakarapiloa’","poem":1},{"lineBreak":true},{"text":"i tsimirira kenakenakeio,","poem":1},{"lineBreak":true},{"text":"i hekohekom-pamorekey,","poem":1},{"lineBreak":true},{"text":"i mandetake fifeheañe amo","poem":1},{"lineBreak":true},{"text":"hakalalijaha’eoy,","poem":1},{"lineBreak":true},{"text":"naho hasavereñañe amo famoreha’eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inao! miatreatre azo iraho,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"le hatsingako an-doha’o eo o siki’oo,","poem":1},{"lineBreak":true},{"text":"naho haboako amo kilakila’ondatio ty fihalo’o","poem":1},{"lineBreak":true},{"text":"vaho amo fifeheañeo ty heña’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hafetsako ama’o ty raha mampangorý,","poem":1},{"lineBreak":true},{"text":"hanivà’e azo, ie hanoeko fisambàñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie amy zao, hene handripak’ ama’o","poem":1},{"lineBreak":true},{"text":"ze maharendrek’ azo, hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Fa mangoakoake ty Ninevè;","poem":1},{"lineBreak":true},{"text":"ia’ ty handala aze?","poem":1},{"lineBreak":true},{"text":"aia ty hahatreavako mpañohò ho azo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Soa te amy No-amone v’iheo,","poem":1},{"lineBreak":true},{"text":"Ie nitoetse añivon-tsaka eoy,","poem":1},{"lineBreak":true},{"text":"naho niarikatohen-drano,","poem":1},{"lineBreak":true},{"text":"i riakey ty nañaro aze,","poem":1},{"lineBreak":true},{"text":"naho i ranoy ty ni-kijoli’e?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I Kose naho i Mitsraime ty nanolo-kaozarañ’ ama’e tsy nete ritse;","poem":1},{"lineBreak":true},{"text":"nimpañolots’aze t’i Pote naho i Lobý","poem":1},{"noteId":3},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"F’ie nasese mb’eo,","poem":1},{"lineBreak":true},{"text":"nisese mb’am-pandrohizañe añe,","poem":1},{"lineBreak":true},{"text":"fonga naretsak’ an-doha’ o lalan-drovao ey o anak’ ajaja’eo;","poem":1},{"lineBreak":true},{"text":"nanoe’ iereo tsato-piso o roandria’eo,","poem":1},{"lineBreak":true},{"text":"vaho rinohy an-tsilisily iaby","poem":1},{"lineBreak":true},{"text":"o ana-dona’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe ho jike ka irehe, vaho hiàmpitse;","poem":1},{"lineBreak":true},{"text":"ie hipay fitsolohañe ty amy rafelahiy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manahake o rotseo","poem":1},{"lineBreak":true},{"text":"ze hene golobo’o mifahetse,","poem":1},{"lineBreak":true},{"text":"ie ezeñezeñeñe ro mihintsañe","poem":1},{"lineBreak":true},{"text":"mb’am-paliem-pikama ao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Oniño te hambañe aman’ampela","poem":1},{"lineBreak":true},{"text":"ondaty añivo’oo;","poem":1},{"lineBreak":true},{"text":"midañadaña ho a o rafelahio","poem":1},{"lineBreak":true},{"text":"o lalambein-tane’oo;","poem":1},{"lineBreak":true},{"text":"hampangotomomohe’ ty afo o sikada’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mitariha rano ho amy fiarikoboñañey, haozaro o kijolio;","poem":1},{"lineBreak":true},{"text":"mionjona amo lietseo,","poem":1},{"lineBreak":true},{"text":"lialiao i pakotsey,","poem":1},{"lineBreak":true},{"text":"vontitiro i mòlim-birìkey;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hamorototo azo ao ty afo,","poem":1},{"lineBreak":true},{"text":"hañito azo i fibaray,","poem":1},{"lineBreak":true},{"text":"habotse’e manahake i valalay;","poem":1},{"lineBreak":true},{"text":"mifamorohota hoe kijeja,","poem":1},{"lineBreak":true},{"text":"mivorovoroa hoe sy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nampamasiañe’o mandikoatse","poem":1},{"lineBreak":true},{"text":"o vasian-dikerañeo","poem":1},{"lineBreak":true},{"text":"o mpibalibalik’ ama’oo;","poem":1},{"lineBreak":true},{"text":"miofoke i kijejay vaho mitiliñe añe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hoe valala o mpigari’oo,","poem":1},{"lineBreak":true},{"text":"mifamorohotse hoe kijeja","poem":1},{"lineBreak":true},{"text":"o mpifehe’oo, ie mitobe an-kijoly eo","poem":1},{"lineBreak":true},{"text":"naho manintsiñe ty andro,","poem":1},{"lineBreak":true},{"text":"fe mipitsik’ añe te mafana-voho,","poem":1},{"lineBreak":true},{"text":"vaho tsy fohiñe ty tane nombà’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mirotse o mpiara’oo ry mpanjaka’","poem":1},{"lineBreak":true},{"text":"i Asore, mitofa o roandria’oo;","poem":1},{"lineBreak":true},{"text":"mivarakaik’ am-bohitse ey ondati’oo,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty hanontoña’o.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy hay melañeñe ty bae’o,","poem":1},{"lineBreak":true},{"text":"mahaferenay o fere’oo;","poem":1},{"lineBreak":true},{"text":"fonga hitehateha-pitàñe ty ama’o","poem":1},{"lineBreak":true},{"text":"o mahajanjiñe i talili’oio;","poem":1},{"lineBreak":true},{"text":"fa ia ty tsy nifetsaha’ o fampisoaña’o","poem":1},{"lineBreak":true},{"text":"nitoloñeñe nainai’eo?","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Lobý: taliñiereñe","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}