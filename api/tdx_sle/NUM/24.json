{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"NUM","translationId":"tdx_sle","name":"Volily","commonName":"Volily","title":"Volily","order":4,"numberOfChapters":36,"sha256":"793776cafca3abca75bc16ca8ce474888dd5ace2fe6b82d7b9ae93b4ff8784d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/tdx_sle/NUM/36.json","totalNumberOfVerses":1289},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Aa kanao nioni’ i Balame te ninò’ Iehovà ty hitata Israele le tsy nisikilie’e nanahake i lili’ey fe nampitolihe’e mb’ am-patrambey eñe ty lahara’e."]},{"type":"verse","number":2,"content":["Aa naho niandra t’i Balame le nioni’e t’Israele nimoneñe an-kiboho’e ey nilahatse amo fifokoa’eo; le nivotrak’ ama’e ty arofon’ Andrianañahare;"]},{"type":"verse","number":3,"content":["vaho nonjone’e ami’ty hoe ty razan-drehake,",{"text":"Hoe ty fetse’ i Balame ana’ i Beore,","poem":1},{"lineBreak":true},{"text":"naho ty lañona’ ondaty","poem":1},{"lineBreak":true},{"text":"am-pihaino misokake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ty enta’ ondaty mahajanjiñe","poem":1},{"lineBreak":true},{"text":"ty tsaran’Añahare,","poem":1},{"lineBreak":true},{"text":"naho mahaisake ty aroñaro’ i El-Sadai","poem":1},{"noteId":24},{"text":", mibaboke","poem":1},{"lineBreak":true},{"text":"fe am-pihaino mibolanake:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fanjaka o kiboho’oo ry Iakòbe","poem":1},{"lineBreak":true},{"text":"naho o kivoho’oo ry Israele.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mivelatse hoe vavatane,","poem":1},{"lineBreak":true},{"text":"hoe kodobo añ’olon-tsaka,","poem":1},{"lineBreak":true},{"text":"hoe vahoñe nambole’ Iehovà","poem":1},{"lineBreak":true},{"text":"hoe mendoraveñe añ’olon-drano.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hidoandoan-drano o sihoa’eo","poem":1},{"lineBreak":true},{"text":"naho ho an-drano maro o tabiri’eo.","poem":1},{"lineBreak":true},{"text":"Mitoabotse ambone’ i Agage ty mpanjaka’e","poem":1},{"lineBreak":true},{"text":"vaho onjoneñe i fifehea’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manahake ty tsifan-drimo mitiotiotse","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare nampiavotse aze amy Mitsraime.","poem":1},{"lineBreak":true},{"text":"Hampibotseke ze tane malaiñe aze","poem":1},{"lineBreak":true},{"text":"hampipozapozake o taola’eo,","poem":1},{"lineBreak":true},{"text":"hampitrofahe’e amo ana-pale’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nitsakononòke re,","poem":1},{"lineBreak":true},{"text":"nanao fandrean-diona","poem":1},{"lineBreak":true},{"text":"naho hoe liona rene’e, ia ty hampitsekak’ aze?","poem":1},{"lineBreak":true},{"text":"Hene soa tata ze mitat’azo","poem":1},{"lineBreak":true},{"text":"Fonga ozoñeñe o mañozoñ’azoo.","poem":1}]},{"type":"verse","number":10,"content":["Nisolebotse amy Balame amy zao ty habose’ i Balake, le nifampitrabohe’e o fità’eo, naho hoe t’i Balak’ amy Bala­me, Nikanjiako haño­zoñe o rafelahikoo, vaho hehe te nitsitsihe’o tata in-telo."]},{"type":"verse","number":11,"content":["Mibioña arè mb’ an-toe’o añe, ie ho nonjoneko andi­kerañe eñe ty asi’o; te mone kinala’ Iehovà i ho ni-enge’oy."]},{"type":"verse","number":12,"content":["Le hoe t’i Balame amy Balake, Tsy vinolako hao o ìra’o nampihitrife’o amakoo ty hoe,"]},{"type":"verse","number":13,"content":["Ndra te hatolo’ i Balak’ ahiko ty volafoty naho volamena mahaatseke i anjomba’ey, tsy ho likoareko ty falie’ Iehovà, hanoako ty soa ndra ty raty boak’ an-troko, fa ze nitsarae’ Iehovà ty ho taroñeko?"]},{"type":"verse","number":14,"content":["Aa le himpoliako ondatikoo henaneo, fe adono hey hitoroako ty hanoe’ ondaty reroañe am’ondati’oo amo andro ampara’e añeo."]},{"type":"heading","content":["Fitokia’ i Balame Fahefatse"]},{"type":"verse","number":15,"content":["Aa le nonjone’e ami’ty hoe i fandrazaña’ey:",{"text":"Ty lañona’ i Balame ana’ i Beore,","poem":1},{"lineBreak":true},{"text":"ty taro’ ondaty am-pihaino nabeake.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ty kora’ i mpijanjiñe","poem":1},{"lineBreak":true},{"text":"o tsaran’ Añahareoy,","poem":1},{"lineBreak":true},{"text":"vaho ama’e ty fahafohinañe","poem":1},{"lineBreak":true},{"text":"i Andindimoneñey,","poem":1},{"lineBreak":true},{"text":"Oni’e ty aroñaro’ i El-Sadai","poem":1},{"lineBreak":true},{"text":"mibaboke fe am-pihaino mibeake:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Treako fa tsy henaneo;","poem":1},{"lineBreak":true},{"text":"misamb’ aze iraho fe tsy mitotoke;","poem":1},{"lineBreak":true},{"text":"hiboak’ am’ Iakòbe ty vasiañe;","poem":1},{"lineBreak":true},{"text":"hionjoñe hirik’am’ Israele ty kobaiñe,","poem":1},{"lineBreak":true},{"text":"ho demohe’e o olon-tane’ i Moabeo","poem":1},{"lineBreak":true},{"text":"le fonga ho rotsahe’e o anam-pifandrakarakañeo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho fanañañe t’i Edome,","poem":1},{"lineBreak":true},{"text":"ho hanaña’ o rafelahi’eo t’i Seire,","poem":1},{"lineBreak":true},{"text":"le hitoloñ’ an-kafatrarañe t’Israele.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hiboak’ am’ Iakòbe ty hifehe,","poem":1},{"lineBreak":true},{"text":"handrotsake ty sehanga’ i Are.","poem":1}]},{"type":"verse","number":20,"content":["Ie nitalakese’e t’i Amaleke le nonjone’e ty fetse’e ami’ty hoe:",{"text":"Nilohà’ o kilakila taneo t’i Amaleke,","poem":1},{"lineBreak":true},{"text":"Fe hamongorañe ty ho figadoña’e.","poem":1}]},{"type":"verse","number":21,"content":["Nisambae’e amy zao o nte-Keineo, vaho nañonjona’e fetse ami’ ty hoe:",{"text":"Fatratse o fimoneña’oo","poem":1},{"lineBreak":true},{"text":"naho mioreñe an-damilamy eo ty akiba’o;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"fe ho forototoeñe t’i Kàine;","poem":1},{"lineBreak":true},{"text":"ampara’ mbia te ho tana’ i Asore an-drohy?","poem":1}]},{"type":"verse","number":23,"content":["Le nonjone’e ty fetse’e nanao ty hoe:",{"text":"Hedey! Ia ty ho veloñe","poem":1},{"lineBreak":true},{"text":"naho akipen’ Añahare?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hitotsak’ eo o lakambey hirik’","poem":1},{"lineBreak":true},{"text":"añ’olo’ i Ketio,","poem":1},{"lineBreak":true},{"text":"ho silofe’ iareo t’i Asore","poem":1},{"lineBreak":true},{"text":"naho hampiambane’e t’i Aibere,","poem":1},{"lineBreak":true},{"text":"ampara’ t’ie mongotse nainai’e.","poem":1}]},{"type":"verse","number":25,"content":["Aa le niongake t’i Balame, nienga, naho nimpoly mb’an-toe’e añe; vaho nimb’ amy lia’e mb’eo ka t’i Balake."]}],"footnotes":[{"noteId":24,"caller":"+","text":"Andriampañotroñe, kila lefe’e","reference":{"chapter":24,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}