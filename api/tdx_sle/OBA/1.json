{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"OBA","translationId":"tdx_sle","name":"Obadià","commonName":"Obadià","title":"Obadià","order":31,"numberOfChapters":1,"sha256":"3427c56b031d69c7f2ae7058e2736205f95f692c6dd7f9ed4a70c69462994bcf","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/tdx_sle/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ty aroñaro’ i Obadià",{"noteId":0},":",{"text":"Hoe ty nafè’ Iehovà, Talè amy Edome:","poem":1},{"lineBreak":true},{"text":"Nahajanjiñe entañe boak’ amy","poem":1},{"lineBreak":true},{"text":"Iehovà zahay,","poem":1},{"lineBreak":true},{"text":"le fa nampihitrifeñe amo kilakila’","poem":1},{"lineBreak":true},{"text":"ondatio ty sorotà, nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Miongaha, antao hitroatse hihotakotake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inao te hafotsako ho kede","poem":1},{"lineBreak":true},{"text":"amo fifeheañeo irehe;","poem":1},{"lineBreak":true},{"text":"ho vata’e mavoeñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa namañahy azo ty firengevohan’arofo’o,","poem":1},{"lineBreak":true},{"text":"ihe mpimoneñe an-tseratseram-bato ao;","poem":1},{"lineBreak":true},{"text":"an-kaboañe ey ty fimoneña’o","poem":1},{"lineBreak":true},{"text":"ihe mitsakore ty hoe añ’arofo ao:","poem":1},{"lineBreak":true},{"text":"Ia ty hanjotso ahy mb’an-tane mb’eo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa ndra t’ie mizonjoñe mb’añ’abo ey","poem":1},{"lineBreak":true},{"text":"hirae’o am-bantio,","poem":1},{"lineBreak":true},{"text":"naho ajado’o amo vasiañeo eñe ty akiba’o,","poem":1},{"lineBreak":true},{"text":"mbe hazotsoko boak’ ey, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ie nivotraha’ ty mpampikametse,","poem":1},{"lineBreak":true},{"text":"naho ty malaso an-kaleñe","poem":1},{"lineBreak":true},{"text":"— akore ty fandrotsahañe anahareo—","poem":1},{"lineBreak":true},{"text":"tsy ho nampikametse am-para’","poem":1},{"lineBreak":true},{"text":"t’ie nietsake hao?","poem":1},{"lineBreak":true},{"text":"Aa naho nivotrak’ ama’o","poem":1},{"lineBreak":true},{"text":"ty mpanontoñe valoboke,","poem":1},{"lineBreak":true},{"text":"tsy ho nenga’e hao ty ho tsindroheñe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Akore ty fivolosañe i Esave,","poem":1},{"lineBreak":true},{"text":"ty fikodebeañe o vara nakafi’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa nanese azo pak’ añ’efe-tane eo","poem":1},{"lineBreak":true},{"text":"o mpirimboñ’ ama’oo;","poem":1},{"lineBreak":true},{"text":"nifañahie’ o nifampilongo ama’oo","poem":1},{"lineBreak":true},{"text":"vaho nahagioke;","poem":1},{"lineBreak":true},{"text":"fa nampipoke fandrik’ ambane’o ao","poem":1},{"lineBreak":true},{"text":"o mpitrao-pikama ama’oo;","poem":1},{"lineBreak":true},{"text":"(tsy ama’e ty hilala!)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy ho mongoreko Edome ao hao","poem":1},{"lineBreak":true},{"text":"o mahihitseo","poem":1},{"lineBreak":true},{"text":"naho am-bohi’ Esave ty faharendrehañe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hiroreke o fanalolahi’oo ry Temane,","poem":1},{"lineBreak":true},{"text":"amy te ho fonga haitoañe am-pizamanañe","poem":1},{"lineBreak":true},{"text":"am-bohi’ i Esave eo ondatio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hañoloñe azo ty fisalarañe","poem":1},{"lineBreak":true},{"text":"ty amy nampisoaña’o","poem":1},{"lineBreak":true},{"text":"an-drahalahi’o Iakobey,","poem":1},{"lineBreak":true},{"text":"vaho haitoañe zafe-zanake irehe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ihe nijagarodoñe eo amy andro zay,","poem":1},{"lineBreak":true},{"text":"amy andro nendese’ o ambahinio","poem":1},{"lineBreak":true},{"text":"mb’eo o vara’eoy","poem":1},{"lineBreak":true},{"text":"naho nizilike an-dalambei’e mb’eo o alik’ama’oo,","poem":1},{"lineBreak":true},{"text":"vaho nanoe’ iereo tsatopiso t’Ierosalaime","poem":1},{"lineBreak":true},{"text":"—ihe nimpiama’ iareo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho nisoa t’ie tsy nisamba an-drahalahi’o amy andron-kekoheko’ey,","poem":1},{"lineBreak":true},{"text":"tsy ho nirebeke amy andro","poem":1},{"lineBreak":true},{"text":"naha-rotsake o ana’ Iehodaoy;","poem":1},{"lineBreak":true},{"text":"mbore tsy nimete ty nisaontsie’o añ’ebotsebotse amy andron-kankàñey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy nimete ty nimoaha’o an-dalambei’ ondatikoo amy andron-kekoheko’ iareoy;","poem":1},{"lineBreak":true},{"text":"Eka, tsy ho nisambà’o ty fisotria’e amy andron-kankà’ iareoy,","poem":1},{"lineBreak":true},{"text":"ndra nampipao-pitàñe amo fanaña’ iareoo amy andro nitarañen-doza’ iareoy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsy nimete ty nijohaña’o am-pitsileañe eo","poem":1},{"lineBreak":true},{"text":"hamonoa’o ze nipoliotse mb’eo;","poem":1},{"lineBreak":true},{"text":"naho tsy ho nasese’o o sehanga’eo","poem":1},{"lineBreak":true},{"text":"amy andron-kasotriañey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fa mitotok’ amo kilakila’ ondatio","poem":1},{"lineBreak":true},{"text":"ty andro’ Iehovà:","poem":1},{"lineBreak":true},{"text":"hambañe amo sata’oo ty hanoeñe ama’o.","poem":1},{"lineBreak":true},{"text":"habalik’ añ’ambone’o eo o fitoloña’oo","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa manahake ty ninoma’ areo","poem":1},{"lineBreak":true},{"text":"amy vohiko miavakey,","poem":1},{"lineBreak":true},{"text":"ty hinoma’ o ambahinio nainai’e;","poem":1},{"lineBreak":true},{"text":"ie hinoñe naho higenoke,","poem":1},{"lineBreak":true},{"text":"vaho hanahake te mbe lia’e tsy teo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"F’ie ambohi’ i Tsione ao","poem":1},{"lineBreak":true},{"text":"ty nahapoliotse","poem":1},{"noteId":1},{"text":", ie ho miavake;","poem":1},{"lineBreak":true},{"text":"vaho ho fanaña’ Iakobe o vara’ iareoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Le ho afo ty anjomba’ Iakobe,","poem":1},{"lineBreak":true},{"text":"naho lel’afo ty anjomba’ Iosefe,","poem":1},{"lineBreak":true},{"text":"naho ho ahetse ty anjomba’ i Esave,","poem":1},{"lineBreak":true},{"text":"le ho viañe’ iereo ty ao, hamorototo iareo,","poem":1},{"lineBreak":true},{"text":"vaho tsy hengañe honka’e ty añ’anjomba’ i Esave ao; fa nitsara t’Iehovà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho a o tatimoo ty vohi’ i Esave,","poem":1},{"lineBreak":true},{"text":"naho i monto’ o nte-Pilisty ambane eio,","poem":1},{"lineBreak":true},{"text":"ho fanaña’ iareo ty tete’ i Efraime,","poem":1},{"lineBreak":true},{"text":"naho ty tonda’ i Somerone,","poem":1},{"lineBreak":true},{"text":"vaho ho fanaña’ i Beniamine t’i Gilade.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho fanaña’ o nirohizañe amy valobohò’ o nte-­Israeleoy ty a o nte-Kenàneo,","poem":1},{"lineBreak":true},{"text":"pak’e Tsakrefate añe;","poem":1},{"lineBreak":true},{"text":"vaho ho fanaña’ o mpirohi’ Ierosalaime","poem":1},{"lineBreak":true},{"text":"e Sefaradeo o rova atimoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Homb’an-kaboa’ i Tsione mb’eo o","poem":1},{"lineBreak":true},{"text":"mpandrombakeo hizaka ty vohi’ i Esave;","poem":1},{"lineBreak":true},{"text":"vaho ho a Iehovà i fifeheañey","poem":1},{"noteId":2},{"text":".","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Obadià: Mpitoro’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Ies 4:2-3, Ioe 2:32, Ben 14:1","reference":{"chapter":1,"verse":17}},{"noteId":2,"caller":"+","text":"Sab 2:8, Dan 2:44, Zek 14:9, Ben 11:15","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/tdx_sle/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}