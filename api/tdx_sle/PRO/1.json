{"text":"le ho verèñe an-kihitse ty maharendreke,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"hahavaky o hatòm-bolañeo,","poem":1},{"lineBreak":true},{"text":"naho o fandrazañañeo,","poem":1},{"lineBreak":true},{"text":"ty enta’ o mahihitseo vaho","poem":1},{"lineBreak":true},{"text":"o razan-tsaontsi’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ty fañeveñañ’am’ Iehovà ro fifotoran-kilala","poem":1},{"noteId":0},{"text":",","poem":1},{"lineBreak":true},{"text":"fe malain-kihitse naho anatse ty gege.","poem":1}]},{"type":"heading","content":["Hatahata ty amo Rañetse Tsivokatseo"]},{"type":"verse","number":8,"content":[{"text":"O anake, tsendreño, ty fameren-drae’o,","poem":1},{"lineBreak":true},{"text":"naho ko ado’o ty fañòhan-drene’o;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie firavahañe soa an-doha’o eo","poem":1},{"lineBreak":true},{"text":"vaho hareañe am-bozo’o eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O anake, ihe edrè’ o tsivokatseo, ko miantoke.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie manao ty hoe :","poem":1},{"lineBreak":true},{"text":"Antao hindre ama’ay;","poem":1},{"lineBreak":true},{"text":"antao hivoñon-dio,","poem":1},{"lineBreak":true},{"text":"hiambotrak’ am’ondaty mahitio tsy aman-tali’ey;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"hagodran-tika veloñe iareo","poem":1},{"lineBreak":true},{"text":"manahake i kiboriy, ty vata’e iaby,","poem":1},{"lineBreak":true},{"text":"hambañe amo mivariñe an-kòak’ aoo;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hahaisake ze atao vara soa,","poem":1},{"lineBreak":true},{"text":"hañatsafan-draha kinopake","poem":1},{"lineBreak":true},{"text":"amo akiban-tikañeo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mipiteha ama’ay arè, sindre hitraok’ an-koroñe raike.—","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O anake, tsy iharoan-dia iereo,","poem":1},{"lineBreak":true},{"text":"kalaño ty tombo’o","poem":1},{"lineBreak":true},{"text":"tsy ho ami’ty lala’ iareo;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"fa milay mb’an-katsivokaram-b’eo","poem":1},{"lineBreak":true},{"text":"o tombo’ iareo","poem":1},{"lineBreak":true},{"text":"malisa hampiori-dioo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe tsy vente’e ty amohàm-pandrike","poem":1},{"noteId":1},{"lineBreak":true},{"text":"ambane’ ty masom-boroñe eo !","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"fe o liom-bata’eo ty iampira’ iareo,","poem":1},{"lineBreak":true},{"text":"ty fiai’iareo avao ty amandroña’iareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Izay ty sata’ o mpitavam-bara","poem":1},{"lineBreak":true},{"text":"am-patiti’eo,","poem":1},{"lineBreak":true},{"text":"asinta’e ty fiai’ i mitañ’ aze’ey.","poem":1}]},{"type":"heading","content":["Mikaike t’i Hihitse"]},{"type":"verse","number":20,"content":[{"text":"Mikok’ an-dalambey eo t’i Hihitse;","poem":1},{"lineBreak":true},{"text":"poñafe’e an-tameañe ey i fiarañanaña’ey.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mikaik’ ami’ty fangovovoha’ondatio,","poem":1},{"lineBreak":true},{"text":"mametse saontsy","poem":1},{"lineBreak":true},{"text":"an-dalam-pizilihañ’an-drova eo:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pak’ombia ry seretseo ty mbe","poem":1},{"lineBreak":true},{"text":"ho tea’o ty firoerano’o?","poem":1},{"lineBreak":true},{"text":"naho mbe hifale ami’ty famokafoka’e o mpanivetiveo,","poem":1},{"lineBreak":true},{"text":"vaho mbe halain-kilala o gegeo?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mibaliha ty amy fañendahakoy,","poem":1},{"lineBreak":true},{"text":"Hadoako ama’ areo ty añ’ovako ao; hampahafohineko anahareo o entakoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amy te nikoike iraho, f’ie nifoneñe;","poem":1},{"lineBreak":true},{"text":"nahitiko ty tañako,","poem":1},{"lineBreak":true},{"text":"fe leo raike tsy nañaoñe,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"fonga nifarie’ areo o fañerekoo,","poem":1},{"lineBreak":true},{"text":"vaho niambohoa’ areo o endakoo,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aa le izaho ka ty hiankahake","poem":1},{"lineBreak":true},{"text":"ami’ty hankà’areo,","poem":1},{"lineBreak":true},{"text":"vaho ho kizaheko t’ie mianifañe,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ie vovoa’ ty havoro­mbeloñe","poem":1},{"lineBreak":true},{"text":"hoe te tiobey,","poem":1},{"lineBreak":true},{"text":"naho iambovoa’ ty hankàñe","poem":1},{"lineBreak":true},{"text":"manahake te talio,","poem":1},{"lineBreak":true},{"text":"ie iambotraha’ ty haloviloviañe","poem":1},{"lineBreak":true},{"text":"naho ty halonjerañe,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hikaik’ ahy amy zao iereo","poem":1},{"lineBreak":true},{"text":"fe hamoeako","poem":1},{"lineBreak":true},{"text":"hitsoek’ ahy fa tsy hahaoniñe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Amy t’ie nalain-kilala, tsy nijoboñe","poem":1},{"lineBreak":true},{"text":"ty fañeveñañe am’ Iehovà,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"nitambolitritrie’ iereo ty fañerèko,","poem":1},{"lineBreak":true},{"text":"vaho tsinambolitio’ iereo o fitrevokoo,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aa le hagedra’ iareo","poem":1},{"lineBreak":true},{"text":"ty voka’ o sata’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho ho etsa-kilily,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ie mañoho-doza amo tren­trañeo","poem":1},{"lineBreak":true},{"text":"t’ie miamboho, naho","poem":1},{"lineBreak":true},{"text":"mandrotsake o dagolao t’ie midada.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Fe ho soa fimoneñe","poem":1},{"lineBreak":true},{"text":"ty mitsendreñe ahiko","poem":1},{"lineBreak":true},{"text":"vaho hiaiñ’añ’oleñañe,","poem":1},{"lineBreak":true},{"text":"tsy ho hemban-kankàñe.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Rzs 9:10, Sab 111:10","reference":{"chapter":1,"verse":7}},{"noteId":1,"caller":"+","text":"Heb: andamahan-karato","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}