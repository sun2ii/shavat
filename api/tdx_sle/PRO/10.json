{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["Taron-Kilala’ i Selomò"]},{"type":"verse","number":1,"content":[{"text":"O razan-dreha’ i Selomòo.","poem":1},{"lineBreak":true},{"text":"Mahaehak’ an-drae ty anake karafito,","poem":1},{"lineBreak":true},{"text":"fe mañore an-drene’e ty anadahy gege.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy manjofake ty vara niazo","poem":1},{"lineBreak":true},{"text":"an-kalo-tsere’e,","poem":1},{"lineBreak":true},{"text":"fa mañaha an-kavilasy ty havantañañe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsy apo’ Iehovà ho saliko ty vañoñe,","poem":1},{"lineBreak":true},{"text":"fe aveve’e ty hadrao’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Minday hararahañe ty satan-taña migebañe, fe mampañaleale","poem":1},{"lineBreak":true},{"text":"ty fità’ i mavitrikey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anake mahihitse ty manontoñe ami’ty asara, fe minday hasalarañe ty anake","poem":1},{"lineBreak":true},{"text":"miroro am-pitatahañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fitahiañe ro añambone’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"fe mañeta-piaroteñe","poem":1},{"lineBreak":true},{"text":"ty vava’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mahahaha ty fitiahiañe o vantañeo,","poem":1},{"lineBreak":true},{"text":"fe hihomake ty añara’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mañaon-dily ty arofo’ o mahihitseo","poem":1},{"noteId":8},{"text":",","poem":1},{"lineBreak":true},{"text":"fe hianto ty gege mitolom-bolañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Midraidraitse am-panintsiñañe","poem":1},{"lineBreak":true},{"text":"ty mpañavelo an-kavañonañe,","poem":1},{"lineBreak":true},{"text":"fe ho fohiñe ty mitsontike","poem":1},{"lineBreak":true},{"text":"an-dala mikelokeloke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mampioremeñe ty mañieke,","poem":1},{"lineBreak":true},{"text":"vaho ho gorèñe ty gege mivolambolañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsiritsiriohen-kaveloñe ty falie’ o vañoñeo, fe mañeta-piaroteñe","poem":1},{"lineBreak":true},{"text":"ty vava’ o lo-tserekeo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mitrobo fifandierañe ty falaiñañe,","poem":1},{"lineBreak":true},{"text":"fe mandembeke ze atao fiolàñe","poem":1},{"lineBreak":true},{"text":"ty fikokoañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tendrek’ am-pivimbi’ o mahilalao","poem":1},{"lineBreak":true},{"text":"ty hihitse,","poem":1},{"lineBreak":true},{"text":"fe mañeva ty lambosi’","poem":1},{"lineBreak":true},{"text":"i po-hilalay ty kobaiñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mañaja hilala o mahihitseo,","poem":1},{"lineBreak":true},{"text":"fe antitotse ty fiantoañe ty vava’ o dagolao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kijoly maozatse ty varam-pañaleale; fampiantoañe o rarakeo ty hapoia’iareo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Havelo ty tambe’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"vaho fandilovañe","poem":1},{"lineBreak":true},{"text":"ty karama’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mañori-dàlan-kaveloñe","poem":1},{"lineBreak":true},{"text":"ty mañaoñ’ anatse,","poem":1},{"lineBreak":true},{"text":"fe mandridrike ty tsy mipaok’endake.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aman-tsoñy mandañitse","poem":1},{"lineBreak":true},{"text":"ty mañetake falaiñañe,","poem":1},{"lineBreak":true},{"text":"vaho gege ty mampiboele dramotse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy po-tahiñe ty maro rehake,","poem":1},{"lineBreak":true},{"text":"mahihitse ka ty maha-tam-pivimby.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Volafoty hiringiri’e","poem":1},{"lineBreak":true},{"text":"ty famele’ o vantañeo;","poem":1},{"lineBreak":true},{"text":"fe tsy vente’e ty tro’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mamahañe maro ty fivimbi’","poem":1},{"lineBreak":true},{"text":"o vantañeo,","poem":1},{"lineBreak":true},{"text":"fe mampivetrake ty dagola","poem":1},{"lineBreak":true},{"text":"te tsy aman-kilala.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ty fitahia’ Iehovà ro mampañaleale,","poem":1},{"lineBreak":true},{"text":"vaho tsy tovoña’e anahelo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fihisà’ ty seretse ty mikilily,","poem":1},{"lineBreak":true},{"text":"fe hihitse ty ho amy t’indaty mahilala.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hifetsak’ amy lo-tserekey","poem":1},{"lineBreak":true},{"text":"ty ihembaña’e, fe hatolotse amy vantañey ty fisalalà’e.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie misaok’ añe ty talio,","poem":1},{"lineBreak":true},{"text":"tsy eo ka i lo-tserekey,","poem":1},{"lineBreak":true},{"text":"fe mijadoñe nainai’e o vañoñeo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hoe kile","poem":1},{"noteId":9},{"text":"amo fihitsikeo,","poem":1},{"lineBreak":true},{"text":"naho hatoeñe amo fihainoo,","poem":1},{"lineBreak":true},{"text":"ty tembo amo mpañirak’ azeo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fañalavañe andro","poem":1},{"lineBreak":true},{"text":"ty fañeveñañe am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"fe ho tomoreñe ty tao’o lo-tserekeo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hafaleañe ty fisalala’o vantañeo,","poem":1},{"lineBreak":true},{"text":"fe ho modo ty fitamà’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Rova maozats’ amo mahitio","poem":1},{"lineBreak":true},{"text":"ty làla’ Iehovà,","poem":1},{"lineBreak":true},{"text":"f’ie firotsahañe amo mpanao ratio.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Le lia’e tsy hasiotse o vantañeo,","poem":1},{"lineBreak":true},{"text":"fe tsy himoneña’ o tsereheñeo i taney.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mamoa hihitse ty falie’ o vañoñeo,","poem":1},{"lineBreak":true},{"text":"fe haitoañe ty lela mitera.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Apota’ ty fivimbi’ o mahitio","poem":1},{"lineBreak":true},{"text":"ze mete akareñe,","poem":1},{"lineBreak":true},{"text":"fe mengoke ty vava’ o lo-tserekeo.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Hos 14:9","reference":{"chapter":10,"verse":8}},{"noteId":9,"caller":"+","text":"Khomtse: vinegra","reference":{"chapter":10,"verse":26}}]},"thisChapterLink":"/api/tdx_sle/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}