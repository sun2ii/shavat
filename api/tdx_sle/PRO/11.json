o tahiñeo","poem":1},{"lineBreak":true},{"text":"ty havantaña’e,","poem":1},{"lineBreak":true},{"text":"fe mikorovok’ ami’ty haratia’e","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mañaha ty vañoñe i havantaña’ey,","poem":1},{"lineBreak":true},{"text":"fe hamahotse o piaroteñeo","poem":1},{"lineBreak":true},{"text":"ty fatiti’iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie mate ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"momoke o fañiria’eo,","poem":1},{"lineBreak":true},{"text":"vaho voroke ty fitamà’ i tsy mahitiy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Votsorañe amy falovilovia’ey ty vantañe,","poem":1},{"lineBreak":true},{"text":"le mb’eo handimbe aze ty lo-tsereke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mijoy ty rañe’e am-bava’e ty tsi-aman-Kàke,","poem":1},{"lineBreak":true},{"text":"fe hilala ty mañaha o vañoñeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie miraorao o vantañeo,","poem":1},{"lineBreak":true},{"text":"mirebeke ty rova;","poem":1},{"lineBreak":true},{"text":"ie momoke ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"inay ty firiñariñan-kobaiñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mionjoñe ty rova tatae’ o vañoñeo,","poem":1},{"lineBreak":true},{"text":"fe rotsahe’ ty vava’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Po-hilala ty maniva ondaty,","poem":1},{"lineBreak":true},{"text":"fe mianjiñe t’indaty mahilala.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mb’eo mb’eo i mpitolom-bolañey","poem":1},{"lineBreak":true},{"text":"mampiborake ty nitangogoeñe,","poem":1},{"lineBreak":true},{"text":"fe mahakafi-draha ty migahiñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie po-panoroañe, mihotrake o borizañeo,","poem":1},{"lineBreak":true},{"text":"fe fandreketañe t’ie mitolom-pisafiry.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Toe hisotry ty miantoke","poem":1},{"lineBreak":true},{"text":"songon’ ambahiny,","poem":1},{"lineBreak":true},{"text":"fe soa fiaro ty malai-mañoho-pitàñe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Asieñe ty rakemba matarike,","poem":1},{"lineBreak":true},{"text":"vaho manontom-bara ty fanalolahy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mañasoa ty tro’e t’indaty matarike,","poem":1},{"lineBreak":true},{"text":"fe mijoy ty vata’e ty mpampisoañe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mikarama hakoahañe ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"fe ho soa tambe","poem":1},{"lineBreak":true},{"text":"ty mitongy havantañañe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho veloñe ty mifahatse","poem":1},{"lineBreak":true},{"text":"an-kavañonañe,","poem":1},{"lineBreak":true},{"text":"fe hihomake ty mañean-karatiañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tiva am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty mengok’ an-troke,","poem":1},{"lineBreak":true},{"text":"fe ifalea’e ty mañavelo an-kahiti’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy mikalafo te","poem":1},{"noteId":10},{"text":"tsy ho po-lafa","poem":1},{"lineBreak":true},{"text":"ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"fe ho haha ty tiri’ o vantañeo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe bange volamena","poem":1},{"lineBreak":true},{"text":"ami’ty oron-dambo","poem":1},{"lineBreak":true},{"text":"ty ampela montramontra","poem":1},{"lineBreak":true},{"text":"tsy mahalie-batañe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ty hasoa avao ty fisalala’ o vañoñeo;","poem":1},{"lineBreak":true},{"text":"fe haviñerañe ty fitamà’ i lahiaga.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eo ty fampiparaitahañe","poem":1},{"lineBreak":true},{"text":"mbe mampitombo avao;","poem":1},{"lineBreak":true},{"text":"eo ty matity ami’ty mañeva,","poem":1},{"lineBreak":true},{"text":"f’ie ho rarake.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hiraorao t’indaty matarike,","poem":1},{"lineBreak":true},{"text":"vaho ho tondrahañe ka ty manondrake.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Honjire’ ondatio ty matity ampemba,","poem":1},{"lineBreak":true},{"text":"fe fitahiañe ty ho añambone’","poem":1},{"lineBreak":true},{"text":"i mandetak’ azey.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Osiheñe ty mitsoe-kasoa,","poem":1},{"lineBreak":true},{"text":"fe ami’ty mipay haratiañe,","poem":1},{"lineBreak":true},{"text":"izay ty ho zoe’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hihotrake ty miato vara,","poem":1},{"lineBreak":true},{"text":"fe handrevake hoe ravets-atae","poem":1},{"lineBreak":true},{"text":"maindoñe o vantañeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Handova tioke ty mpanolo-tsotry","poem":1},{"lineBreak":true},{"text":"añ’anjomba’e,","poem":1},{"lineBreak":true},{"text":"le hitoroñe ty mahihi-troke ty dagola.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hataen-kaveloñe ty vokare’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"vaho mpandrekets’arofo ty mahihitse.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Kanao ho tambezeñe an-tane atoy","poem":1},{"lineBreak":true},{"text":"o vantañeo,","poem":1},{"lineBreak":true},{"text":"àntsake ty tsereheñe naho o piaroteñeo.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Heb: ama’e ty tañako!","reference":{"chapter":11,"verse":21}}]},"thisChapterLink":"/api/tdx_sle/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}