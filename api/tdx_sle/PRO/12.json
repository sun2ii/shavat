{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Mikoko hilala ty mpitea lafa,","poem":1},{"lineBreak":true},{"text":"fe gege ty malaiñ-endake;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hanjo fañisohañe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty matarike, fe hafà’e ty mpikinia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsy mahafioreñe ondaty ty halo-tserehañe,","poem":1},{"lineBreak":true},{"text":"fe tsy hasiotse ty vaha’o vañoñeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sabakan-engem-bali’e ty rakemba soa,","poem":1},{"lineBreak":true},{"text":"fe hoe hamomohañe an-taola’e ao","poem":1},{"lineBreak":true},{"text":"ty mahasalatse.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To ty fivetsevetse’ o vantañeo;","poem":1},{"lineBreak":true},{"text":"fe mitarik’ an-dama ty fanoroa’","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Famandroñan-dio ty entam-bola’","poem":1},{"lineBreak":true},{"text":"o raty tserekeo,","poem":1},{"lineBreak":true},{"text":"fe hañaha ty vañoñe o saontsi’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rotsaheñe o lo-tserekeo le tsy eo,","poem":1},{"lineBreak":true},{"text":"fe hijadoñe ty anjomba’ o mahitio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O hihi’eo ty anambezañe ondatio,","poem":1},{"lineBreak":true},{"text":"fe ho sirikaeñe ty mengok’ an-troke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hàmake t’ie mirè-batañe,","poem":1},{"lineBreak":true},{"text":"naho manaña mpitoroñe raike,","poem":1},{"lineBreak":true},{"text":"ta t’ie mieva ho bey fe tsy aman-kaneñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Haoñe’ ty vantañe ty fiai’ i bibi’ey,","poem":1},{"lineBreak":true},{"text":"fe fampisoañañe avao","poem":1},{"lineBreak":true},{"text":"ty tretre’ i rati-tserekey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho enen-kaneñe ty mpiava’ i tane’ey,","poem":1},{"lineBreak":true},{"text":"fe po-hilala ty mañeañe ty tsy vente’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsikirihe’ o rati-tserekeo","poem":1},{"lineBreak":true},{"text":"ty fikopahan-karatiañe,","poem":1},{"lineBreak":true},{"text":"fe mamokatse ty vaha’ o vantañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fandrihe’ ty fiolàn-tsoñi’e ty lahiaga,","poem":1},{"lineBreak":true},{"text":"fe hibolititse amy haloviloviañey ty vañoñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mahaenen-kasoa t’indaty","poem":1},{"lineBreak":true},{"text":"ty vokam-palie’e,","poem":1},{"lineBreak":true},{"text":"vaho himpoly ama’ ondaty","poem":1},{"lineBreak":true},{"text":"o fitoloñam-pità’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mahity amo maso’eo ty gege,","poem":1},{"lineBreak":true},{"text":"fe mijanjim-panoroañe ty mahihitse.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fohiñe aniany ty filoa-tiña’ i dagola,","poem":1},{"lineBreak":true},{"text":"fe lembefe’ i mahihitse ty mahasalatse.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mampiboake havantañañe","poem":1},{"lineBreak":true},{"text":"ty mikofòke hatò,","poem":1},{"lineBreak":true},{"text":"fe famañahiañe ty manara-bande.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Eo ty manoantoañe an-drehake,","poem":1},{"lineBreak":true},{"text":"hoe fitomboham-pibara,","poem":1},{"lineBreak":true},{"text":"fe minday fijanganañe","poem":1},{"lineBreak":true},{"text":"ty famele’ o mahihitseo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hijadoñe nainai’e ty fivimbin-katò,","poem":1},{"lineBreak":true},{"text":"fe aniany avao ty lelan-dremborake.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Famañahiañe ty an-tro’ o mpikililio,","poem":1},{"lineBreak":true},{"text":"fe haehake t’ie mpifampilongo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy mizò raty ty vantañe,","poem":1},{"lineBreak":true},{"text":"fe lifo-kasotriañe ty tsereheñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tiva am’ Iehovà ty soñy mandañitse,","poem":1},{"lineBreak":true},{"text":"fe no’e o mitoloñe am-pigahiñañeo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mañaja hihitse ty hendre,","poem":1},{"lineBreak":true},{"text":"fe mitazataza hagegeañe ty tron-dagola.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hifeleke ty fità’ o mahimbañeo, vaho hondevozeñe ty taña migebañe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mampidrodretse ty arofo’ ondaty","poem":1},{"lineBreak":true},{"text":"ty fivazobazorañe ama’e ao,","poem":1},{"lineBreak":true},{"text":"fe mampanintsiñe aze ty talily soa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Manoro an-drañe’e ty vantañe,","poem":1},{"lineBreak":true},{"text":"fe mampivike o lo-tsere­keo ty lala’iareo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tsy atono’ i tembo ty nitsatsà’e;","poem":1},{"lineBreak":true},{"text":"fe vara ami’ty mpifanehake o hanaña’eo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tendrek’ an-dalam-bantañe","poem":1},{"lineBreak":true},{"text":"ty haveloñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy aman-kavetrahañe i oloñolo’ey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}