{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Miantoke ty lafan-drae’e","poem":1},{"lineBreak":true},{"text":"ty ajaja karafito,","poem":1},{"lineBreak":true},{"text":"fe tsy mañaon-trevoke ty mpiteratera.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ty havokaran-tsaontsi’ ondatio","poem":1},{"lineBreak":true},{"text":"ro ikama’e raha mafiry,","poem":1},{"lineBreak":true},{"text":"fe tsihavokarañe ty fañiria’","poem":1},{"lineBreak":true},{"text":"o mpitroboo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mahatan-kavelo ty mahambeñe","poem":1},{"lineBreak":true},{"text":"ty falie’e;","poem":1},{"lineBreak":true},{"text":"mianto ka ty mampidañadaña fivimby.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tea-haneñe ty votroo, fe tsy mahazo;","poem":1},{"lineBreak":true},{"text":"ho anjañeñe ka ty mavitrike.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Malain-dremborake ty vañoñe,","poem":1},{"lineBreak":true},{"text":"fe manao ty hameñarañe naho hasalarañe ty lahiaga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mahambeñe i an-dalam-bantañey","poem":1},{"lineBreak":true},{"text":"ty havañonañe,","poem":1},{"lineBreak":true},{"text":"fe mamotsake ty mpanan-kakeo","poem":1},{"lineBreak":true},{"text":"o hatsivokarañeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eo ty miamoke ho mpañefoefo","poem":1},{"lineBreak":true},{"text":"fe poi’e;","poem":1},{"lineBreak":true},{"text":"eo ka ty manao ho rarake","poem":1},{"lineBreak":true},{"text":"f’ie mpañaleale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mahajebañe ty fiai’ ondaty o vara’eo,","poem":1},{"lineBreak":true},{"text":"fe tsy mañaom-pañembàñañe","poem":1},{"lineBreak":true},{"text":"ty rarake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mirebeke ty failo’ o vantañeo, fe hakipeke ty jiro’ i lahiaga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fifandierañe avao ty ente’","poem":1},{"lineBreak":true},{"text":"ty fibohabohañe,","poem":1},{"lineBreak":true},{"text":"fe hihitse ty rambese’","poem":1},{"lineBreak":true},{"text":"ty mañaom-bere.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mikepake ty vara niazo","poem":1},{"lineBreak":true},{"text":"an-tsata koake,","poem":1},{"lineBreak":true},{"text":"fa mampitombo ka ty mitromake hanontoña’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mampikoretse arofo","poem":1},{"lineBreak":true},{"text":"ty fitamañe nihànkañe,","poem":1},{"lineBreak":true},{"text":"fe hataen-kaveloñe ty salala niheneke.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hanaña’ i tsaray songo ty manirìka aze,","poem":1},{"lineBreak":true},{"text":"fe ho tambezeñe","poem":1},{"lineBreak":true},{"text":"ty mañeveñe amo lilio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Figoangoañan-kavelo","poem":1},{"lineBreak":true},{"text":"ty Fañòha’ o mahihitseo","poem":1},{"lineBreak":true},{"text":"hiholiara’e o fandrin-kavilasio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tendreke fañisohañe ty hilala soa,","poem":1},{"lineBreak":true},{"text":"fe tomoantoañe ty lala’","poem":1},{"lineBreak":true},{"text":"o manao bodongeroo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hene mitoloñe an-kilala ze hendre,","poem":1},{"lineBreak":true},{"text":"fe hagegeañe ty aboa’ i dagolay.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mivariñ’an-dama ty irake vìlañe,","poem":1},{"lineBreak":true},{"text":"fe fijanganañe ty mpihitrike migahiñe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hararahañe naho hasalarañe","poem":1},{"lineBreak":true},{"text":"ty hizò ty tsi-mañaon-dafa,","poem":1},{"lineBreak":true},{"text":"iasiañe ka ty miantok’ endake.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mamy an-troke ty fisalalàñe heneke,","poem":1},{"lineBreak":true},{"text":"fe mamparitsike i dagola","poem":1},{"lineBreak":true},{"text":"ty isitaha’e ty raty.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Miha-mahihitse te miharo lia","poem":1},{"lineBreak":true},{"text":"ami’ty mahihitse,","poem":1},{"lineBreak":true},{"text":"f’ie halovilovy te mpiami’ty gege.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tokoen-kasotriañe ty aman-kakeo,","poem":1},{"lineBreak":true},{"text":"fe firaoraoañe ty anambezañe","poem":1},{"lineBreak":true},{"text":"o vantañeo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mampandova amo anan’ ana’eo","poem":1},{"lineBreak":true},{"text":"ty vañoñe,","poem":1},{"lineBreak":true},{"text":"fe mihaja ho a o vantañeo","poem":1},{"lineBreak":true},{"text":"ty vara’ o piaroteñeo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bey ty havokarañe an-tane-hoba’ i rarakey,","poem":1},{"lineBreak":true},{"text":"fe ifaopaoha’ ty tsy-hatò.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Malaiñ-anake ty mampipoke fikiso,","poem":1},{"lineBreak":true},{"text":"fe mikoko aze ty mipiso","poem":1},{"lineBreak":true},{"text":"am-pahimbañañe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mahaeneñe ty tro’e","poem":1},{"lineBreak":true},{"text":"ty mahakama’ i vantañey,","poem":1},{"lineBreak":true},{"text":"fe kefoke ty fisafoa’ i lahiaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}