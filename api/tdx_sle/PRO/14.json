{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Mandranjy ty akiba’e","poem":1},{"lineBreak":true},{"text":"ty rakemba mahihitse,","poem":1},{"lineBreak":true},{"text":"fe arotsa’ ty minè an-taña’e ty aze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mañeveñe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty mañavelo an-kahiti’e,","poem":1},{"lineBreak":true},{"text":"fe manirika aze ty mengok’ amo lala’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Am-bava’ i dagola ty kobay","poem":1},{"lineBreak":true},{"text":"ho an-dambosi’e,","poem":1},{"lineBreak":true},{"text":"fe mañaro ty mahihitse o fivimbi’eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie tsy eo añombe, koake ty riha’e;","poem":1},{"lineBreak":true},{"text":"Toe mahavokatse ty haozaran’ añombe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy mandañitse ty mpitalily migahiñe,","poem":1},{"lineBreak":true},{"text":"fe mikofòke habodiake","poem":1},{"lineBreak":true},{"text":"ty mpitarom-bande.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mipay hihitse ty mpanivetive","poem":1},{"lineBreak":true},{"text":"fa tsy mahatrea,","poem":1},{"lineBreak":true},{"text":"fe mora ami’ty mahafohiñe","poem":1},{"lineBreak":true},{"text":"ty hitendreke hilala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mihankaña ami’ty fiatrefañe i minèñey,","poem":1},{"lineBreak":true},{"text":"fa tsy ho oni’o eo ty soñy mahilala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ty hihi’ i mahilalay :","poem":1},{"lineBreak":true},{"text":"le t’ie mahatsikarake ty lia’e,","poem":1},{"lineBreak":true},{"text":"fe hakalitahañe ty hagegean-dagola.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sirikae’ ty minèñe ty fisolohoañe,","poem":1},{"lineBreak":true},{"text":"fe amo vañoñeo ty fiharoan-drehake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fohi’ ty troke ty hafaim-piai’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy itraofa’ ty ambahiny","poem":1},{"lineBreak":true},{"text":"ty firebeha’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Harotsake ty akiba’ i rati-tserekey,","poem":1},{"lineBreak":true},{"text":"fe hiraorao ty kivoho’ o vañoñeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eo ty làlañe atao’ ondaty ho vantañe,","poem":1},{"lineBreak":true},{"text":"f’ie migodañe mb’an-kavilasy ao","poem":1},{"noteId":11},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mikoretse ty arofo","poem":1},{"lineBreak":true},{"text":"ndra t’ie miankahake,","poem":1},{"lineBreak":true},{"text":"vaho migadoñ’ an-kontoke ty rebeke.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Atsake o sata’eo ty midisa-voly,","poem":1},{"lineBreak":true},{"text":"fe mahaeneñe t’indaty soa i azey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kila iantofa’ ty seretse,","poem":1},{"lineBreak":true},{"text":"fe tsakorè’ ty hendre o lia’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mihilotse ty mahihitse","poem":1},{"lineBreak":true},{"text":"vaho iholiara’e ty raty,","poem":1},{"lineBreak":true},{"text":"fe mijikajika naho mitsidaredare","poem":1},{"lineBreak":true},{"text":"ty dagola.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Manao raha tsi-roe-tafa-toe","poem":1},{"lineBreak":true},{"text":"ty mora boseke,","poem":1},{"lineBreak":true},{"text":"vaho tsambolitioheñe ty mikinia.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mandova hagegeañe ty seretse,","poem":1},{"lineBreak":true},{"text":"fe sabakaen-kilala ty hendre.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hidrakadrakak’ anatrefa’ ty soa ty raty,","poem":1},{"lineBreak":true},{"text":"naho an-dalambei’ o vantañeo ty tsereheñe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Heje’ ty rañe’e i rarakey,","poem":1},{"lineBreak":true},{"text":"fe maro ty mikoko i mpañalealey.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aman-tahiñe ty manirìka ondaty,","poem":1},{"lineBreak":true},{"text":"haha ka ty matarike amo poi’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy hidridrike hao ty mpikilily?","poem":1},{"lineBreak":true},{"text":"Fe fiferenaiñañe naho hatò","poem":1},{"lineBreak":true},{"text":"ro amo misafiry hasoao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Amam-bokatse ze hene fitoloñañe,","poem":1},{"lineBreak":true},{"text":"fe mahararake ty soñy mikofofoake.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Sabaka’ o mahihitseo ty vara’e;","poem":1},{"lineBreak":true},{"text":"fe hagegeañe ty hanè’ o dagolao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mpañaha aiñe ty mpitaroñe mahity,","poem":1},{"lineBreak":true},{"text":"fe mpikitro-draha ty mikofò-bande.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fañarovañe fatratse ty fañeveñañe","poem":1},{"lineBreak":true},{"text":"am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho amam-pipalirañe o ana’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Havelo ­migoangoañe ty fañeveñañe","poem":1},{"lineBreak":true},{"text":"am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"toe fampiariañe o fandri-kakoromahañeo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Enge’ i mpanjakay ty borizañe maro;","poem":1},{"lineBreak":true},{"text":"ampoheke ka ty ana-donake","poem":1},{"lineBreak":true},{"text":"tsy ama’ ondaty.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Àmpon-kilala ty malaon-kaviñerañe;","poem":1},{"lineBreak":true},{"text":"fe mpañonjo hagegeañe ty mora boseke.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mahavelon-tsandriñe ty arofo hendre,","poem":1},{"lineBreak":true},{"text":"fe mahavoroke taolañe ty farahy.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mitera i Andrianamboatse aze","poem":1},{"lineBreak":true},{"text":"ty mamorekeke o rarakeo,","poem":1},{"lineBreak":true},{"text":"fe miasy Aze ty mitretre mahatra.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Arotsa’ ty fandilara’e ty rati-tsereke,","poem":1},{"lineBreak":true},{"text":"fe am-pitsalohañe ty vañoñe te mivetrake.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mimoneñe añ’arofo’ i mahilalay","poem":1},{"lineBreak":true},{"text":"ty hihitse,","poem":1},{"lineBreak":true},{"text":"fe abentabenta’ o dagolao ty antrok’ ao.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mañonjom-pifeheañe ty havañonañe,","poem":1},{"lineBreak":true},{"text":"fe mañìnje o borizañeo ty hakeo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Osihe’ ty mpanjaka ty mpitoroñe","poem":1},{"lineBreak":true},{"text":"mitoloñe an-kihitse,","poem":1},{"lineBreak":true},{"text":"fe atretrè’e an-kaviñerañe","poem":1},{"lineBreak":true},{"text":"ty manao hasalarañe.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Rzs 16:25","reference":{"chapter":14,"verse":12}}]},"thisChapterLink":"/api/tdx_sle/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}