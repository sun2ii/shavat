em":1},{"lineBreak":true},{"text":"t’indaty mahihitse.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Haveloñe ty filoeloean-daharam-panjaka,","poem":1},{"lineBreak":true},{"text":"naho hoe rahoñe minday oran-dohataoñe","poem":1},{"lineBreak":true},{"text":"ty fañisoha’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Soa hatò ty ahazoan-kihitse","poem":1},{"lineBreak":true},{"text":"ta ty volamena! naho ty hijobon-kilala","poem":1},{"lineBreak":true},{"text":"te ami’ty volafoty.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty ihankaña’e haratiañe","poem":1},{"lineBreak":true},{"text":"ro lala’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"vaho mahavontitits’ aiñe","poem":1},{"lineBreak":true},{"text":"ty mahambeñe i lia’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Miaolo ty firotsahañe","poem":1},{"lineBreak":true},{"text":"ty firengevohañe,","poem":1},{"lineBreak":true},{"text":"vaho iaoloa’ ty troke miebotsebotse","poem":1},{"lineBreak":true},{"text":"ty fihotrahañe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hàmake te mpiamo rarake","poem":1},{"lineBreak":true},{"text":"an-troke mirekeo,","poem":1},{"lineBreak":true},{"text":"ta te mitraok’ amo mifanjara","poem":1},{"lineBreak":true},{"text":"o kinopake am-pibohabohañeo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hene hanjo hasoa ze mañaoñe i tsaray,","poem":1},{"lineBreak":true},{"text":"haha ty miato am’ Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Atao mahatsikarake ty mahihitse añ’arofo;","poem":1},{"lineBreak":true},{"text":"mahafañosike fañòhañe ty saontsy malea.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ranon-kavelo migoangoañe ty hilala","poem":1},{"lineBreak":true},{"text":"amy ze manañ’aze;","poem":1},{"lineBreak":true},{"text":"fe hagegeañe ty fandafàñe i dagola.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mañòke ty falie’ i mahihitsey ty tro’e,","poem":1},{"lineBreak":true},{"text":"vaho tompea’e fañòhañe o fivimbi’eo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hoe papy tantele","poem":1},{"lineBreak":true},{"text":"ty saontsy mampanintsy,","poem":1},{"lineBreak":true},{"text":"mamy añ’arofo naho","poem":1},{"lineBreak":true},{"text":"mampijangan-taolañe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Eo ty lalañe atao’ t’indaty ho vantañe,","poem":1},{"lineBreak":true},{"text":"fe fikoromahañe ty figadoña’e","poem":1},{"noteId":13},{"text":".","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mifanehake ho aze ty fiai’ ondaty,","poem":1},{"lineBreak":true},{"text":"vaho azim-palie’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mikabo-draha t’i Beliale1, afo misolebotse ty am-pivimbi’e ao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mampiboele hotakotake","poem":1},{"lineBreak":true},{"text":"t’indaty mengoke,","poem":1},{"lineBreak":true},{"text":"mampifanarake mpiatehena ty bisibisike.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Risihe’ t’indaty piaroteñe ty rañe’e,","poem":1},{"lineBreak":true},{"text":"vaho kozozote’e mb’an-dalan-tsy soa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mikinia raha mengoke","poem":1},{"lineBreak":true},{"text":"ty mpipie maso,","poem":1},{"lineBreak":true},{"text":"vaho mampifetsake haratiañe","poem":1},{"lineBreak":true},{"text":"ty mpimontso.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Sabakan-engeñe ty maroi-foty;","poem":1},{"lineBreak":true},{"text":"oniñe an-dalan-kavañonañe eo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Lombolombo ty fanalolahy","poem":1},{"lineBreak":true},{"text":"ty malaon-kaviñerañe,","poem":1},{"lineBreak":true},{"text":"vaho ambone’ ty mpitavañe rova ty mahafeleke ty tro’e.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tora-tsato-piso am-pe,","poem":1},{"lineBreak":true},{"text":"Iehovà avao ro Mpanampake.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Rzs 14:12","reference":{"chapter":16,"verse":25}}]},"thisChapterLink":"/api/tdx_sle/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}