":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hoe mampipororoake rano","poem":1},{"lineBreak":true},{"text":"ty fifotoram-pifandierañe,","poem":1},{"lineBreak":true},{"text":"aa le apoho i lietsey","poem":1},{"lineBreak":true},{"text":"tsy hiforehetse ho aly.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Songa tiva am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty mañatò ty lo-tsereke naho","poem":1},{"lineBreak":true},{"text":"ty mamàtse ty vantañe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aia ty dagola te hinday drala","poem":1},{"lineBreak":true},{"text":"an-taña’e hikaloa’e hihitse","poem":1},{"lineBreak":true},{"text":"kanao tsy an-tro’e ao ty hilala.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mikoko nainai’e ty rañetse,","poem":1},{"lineBreak":true},{"text":"fe nasamake ho an-tsam-poheke ty rahalahy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Miroe-rano ty manò-taña","poem":1},{"lineBreak":true},{"text":"hiantofa’e ty songon-drañetse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mpitea fiolàñe ty mpikoko lietse,","poem":1},{"lineBreak":true},{"text":"vaho mikai-rotsake ty mandranjy","poem":1},{"lineBreak":true},{"text":"lalambey abo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy mahatrea hasoa","poem":1},{"lineBreak":true},{"text":"ty mengok’ an-troke;","poem":1},{"lineBreak":true},{"text":"vaho mihotrak’ an-kaloviloviañe ao","poem":1},{"lineBreak":true},{"text":"ty aman-dela mamañahy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ho aman’anahelo","poem":1},{"lineBreak":true},{"text":"ty misamake ty minè;","poem":1},{"lineBreak":true},{"text":"vaho tsy aman-kaehake ty rae’ i gegey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aoly soa ty arofo mifale,","poem":1},{"lineBreak":true},{"text":"fe mahamain-taolañe ty hafola-po.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mandrambe vokañe boak’am-pisafoa","poem":1},{"lineBreak":true},{"text":"ty lahiaga,","poem":1},{"lineBreak":true},{"text":"hampikelokeloke ty lalam-bantañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Añatrefa’ ty mahatsikarake","poem":1},{"lineBreak":true},{"text":"ty hihitse,","poem":1},{"lineBreak":true},{"text":"fe mihilohilo mb’añ’olo-tane añe","poem":1},{"lineBreak":true},{"text":"ty maso’ i dagola.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mañembetse an-drae","poem":1},{"lineBreak":true},{"text":"ty hagegean’ana-dahy,","poem":1},{"lineBreak":true},{"text":"vaho hafairañe amy nitoly azey.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tsy mahasoa te liloveñe ty malio-tahiñe,","poem":1},{"lineBreak":true},{"text":"naho ty andafañe roandriañe","poem":1},{"lineBreak":true},{"text":"ty amy havañona’ey.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Malea fisaontsy ty mahilala,","poem":1},{"lineBreak":true},{"text":"mahalie-troke t’indaty maharendreke.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ndra i seretsey ro atao mahihitse","poem":1},{"lineBreak":true},{"text":"naho mahafianjiñe,","poem":1},{"lineBreak":true},{"text":"mbore atao hendre","poem":1},{"lineBreak":true},{"text":"t’ie mahatan-tsoñy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}