{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Mañean-drao ty mirery,","poem":1},{"lineBreak":true},{"text":"tsambolitio’e ze atao vere-to.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy no’ i dagolay ty faharendrehañe,","poem":1},{"lineBreak":true},{"text":"fa ty mampiboake ty heve’e avao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie pok’eo ty tsivokatse,","poem":1},{"lineBreak":true},{"text":"mipotìtse eo ka ty teratera,","poem":1},{"lineBreak":true},{"text":"vaho indrezan-kasalarañe ty inje.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rano laleke ty fisaontsim-palie’ ondaty, torahañe mibobobobo","poem":1},{"lineBreak":true},{"text":"ty figoangoañan-kihitse.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy mahasoa te osiheñe ty raty,","poem":1},{"lineBreak":true},{"text":"hikihoañe ty vañoñe an-jaka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mikaidraha o soñi’ i dagolao,","poem":1},{"lineBreak":true},{"text":"naho mikai-tampify ty vava’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fiantoa’ i seretsey ty vava’e,","poem":1},{"lineBreak":true},{"text":"vaho mpamandrike ty fiai’e o soñi’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kenoke mafiry","poem":1},{"lineBreak":true},{"text":"ty fivolam-pitolom-boetse,","poem":1},{"lineBreak":true},{"text":"migodoñe mb’añ’ova’ ondaty ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rahalahi’ ty mpijoy,","poem":1},{"lineBreak":true},{"text":"ty mpilesa am-pitoloña’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fitalakesañ’abo fatratse","poem":1},{"lineBreak":true},{"text":"ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"milay mb’ama’e ao ty vantañe","poem":1},{"lineBreak":true},{"text":"vaho onjoneñe tsy takatse.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Rova fatratse ty varam-pañaleale,","poem":1},{"lineBreak":true},{"text":"naho hoe kijoly abo añ’ereñere’e ao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aolo’ ty ikorovoha’ ondaty","poem":1},{"lineBreak":true},{"text":"ty fiebotseboran-tro’e,","poem":1},{"lineBreak":true},{"text":"fe miaolo’ ty hasiñe ty firehañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ie manoiñe aolo’ t’ie mitsanoñe:","poem":1},{"lineBreak":true},{"text":"le hagegea’e naho hasalara’e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mahafeake hasilofañe ty tro’ ondaty,","poem":1},{"lineBreak":true},{"text":"fa ia ka ty mahaleo ty fikoretan’ arofo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mitoha hilala ty tro’ i mahatsikarake,","poem":1},{"lineBreak":true},{"text":"vaho mañotsohotso hihitse","poem":1},{"lineBreak":true},{"text":"an-dravembia’e ty mahilala.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Anokafan-dalañe","poem":1},{"lineBreak":true},{"text":"ty ravoravo’ ondaty,","poem":1},{"lineBreak":true},{"text":"manese aze hiatreke ty bey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Heveren-ko to ty mitalily valoha’e,","poem":1},{"lineBreak":true},{"text":"ampara’ te pok’eo ty mañody aze.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Abala’ ty tora-tsato-piso","poem":1},{"lineBreak":true},{"text":"ty fifandierañe,","poem":1},{"lineBreak":true},{"text":"ie mampivike ty mpifanjomotse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mora ty mandreketse rova fatratse,","poem":1},{"lineBreak":true},{"text":"ta ty rañetse torifike,","poem":1},{"lineBreak":true},{"text":"vaho hoe tsotso-bim-pitilik’abo","poem":1},{"lineBreak":true},{"text":"ty fifanjomorañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ty havokaram-palie’ ondaty","poem":1},{"lineBreak":true},{"text":"ro mahaenem-pisafoa,","poem":1},{"lineBreak":true},{"text":"o vokam-pivimbi’eo ro maha-anjañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Manandily ami’ ty haveloñe naho ami’ty havilasy ty fameleke,","poem":1},{"lineBreak":true},{"text":"hikama amo vokare’eo ze mikoko aze.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mahaonin-kasoa ty tendreke valy,","poem":1},{"lineBreak":true},{"text":"vaho isohe’ Iehovà.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mihalaly tretrè ty rarake,","poem":1},{"lineBreak":true},{"text":"fe sotrafe’ ty mpitsikafo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mianto t’indaty lako rañetse,","poem":1},{"lineBreak":true},{"text":"fe ao ty ate-hena mipiteke soa","poem":1},{"lineBreak":true},{"text":"te ami’ty rahalahy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}