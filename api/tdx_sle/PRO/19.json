{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Ambone’ ty dagola","poem":1},{"lineBreak":true},{"text":"aman-tsoñy mengoke,","poem":1},{"lineBreak":true},{"text":"ty rarake mañavelo an-kahiti’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy mahasoa ty fiaiñe","poem":1},{"lineBreak":true},{"text":"te tsy aman-kilala,","poem":1},{"lineBreak":true},{"text":"mandilatse ty malisa am-pandia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mampianto ty lia’e ty hanè’ ondaty,","poem":1},{"lineBreak":true},{"text":"ie mitrevok’ Iehovà an-tro’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpanovon-drañetse o varao,","poem":1},{"lineBreak":true},{"text":"fe pitso-drañetse t’ie rarake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy ho po-lafa ty mpitalily vilañe,","poem":1},{"lineBreak":true},{"text":"vaho tsy himolaotse ty mavande.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amam-pandomboke maro ty matarike,","poem":1},{"lineBreak":true},{"text":"kila mifandrañetse ami’ty mpanolo-ravoravo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Falai’ o rahalahi’e iabio ty rarake—","poem":1},{"lineBreak":true},{"text":"sandrake t’ie farien-drañe’e!","poem":1},{"lineBreak":true},{"text":"Heañe’e fe tsy eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mpikoko ty tro’e ze mitoha hihitse,","poem":1},{"lineBreak":true},{"text":"ho tendreke hasoa ty mpangazon-kilala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho po-lilo ty mpanao kitomboke,","poem":1},{"lineBreak":true},{"text":"le hihomake ty mpandañitse.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy mañeva ty seretse","poem":1},{"lineBreak":true},{"text":"ty miaiñ’ añoleñañe,","poem":1},{"lineBreak":true},{"text":"naho ty ondevo","poem":1},{"lineBreak":true},{"text":"ty hifehe ana-donake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mampalaon-kaviñerañe","poem":1},{"lineBreak":true},{"text":"ty fitsikaraha’ ondatio,","poem":1},{"lineBreak":true},{"text":"vaho enge’e ty miheve fiolàñe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manahake ty fitreñan-diona","poem":1},{"lineBreak":true},{"text":"ty haviñeram-panjaka,","poem":1},{"lineBreak":true},{"text":"fe hoe mìka añ’ahetse eo ty fañisoha’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fianto aman-drae’e ty ajaja votro,","poem":1},{"lineBreak":true},{"text":"vaho fitsopatsopahañe nainai’e","poem":1},{"lineBreak":true},{"text":"ty fitreontreon-drakemba.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lovaeñe aman-droae ty vara","poem":1},{"lineBreak":true},{"text":"naho anjomba,","poem":1},{"lineBreak":true},{"text":"fe boak’am’ Iehovà ty valy hendre.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mampilañak’ an-droro ty havotroañe,","poem":1},{"lineBreak":true},{"text":"vaho ho silofen-kerè ty tro’ i tembo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mahatam-piay ty mahatan-dily,","poem":1},{"lineBreak":true},{"text":"fe hihomake ty mitsidaredare","poem":1},{"lineBreak":true},{"text":"ami’ty lia’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mampisongo am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty mitretre i rarake,","poem":1},{"lineBreak":true},{"text":"le ho tambeze’e i fatariha’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lilovo o ana’o, kanao mb’e","poem":1},{"lineBreak":true},{"text":"amam-pitamàñe;","poem":1},{"lineBreak":true},{"text":"fe ko ilosoran-dafa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy mete tsy liloveñe ty midabadoa;","poem":1},{"lineBreak":true},{"text":"f’ie haha’o, tsy mahay tsy indrai’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mijanjiña fanoroañe,","poem":1},{"lineBreak":true},{"text":"le miantofa endake,","poem":1},{"lineBreak":true},{"text":"vaho hahihitse irehe am-para’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Maro ty safirin-tro’ ondaty,","poem":1},{"lineBreak":true},{"text":"fe hijadoñe ty famerea’ Iehovà.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ty paiañe ama’ondaty le ty fiferenaiña’e;","poem":1},{"lineBreak":true},{"text":"Hàmake t’ie rarake ta te remborake.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Minday mb’an-kaveloñe","poem":1},{"lineBreak":true},{"text":"ty fañeveñañe am’ Iehovà;","poem":1},{"lineBreak":true},{"text":"hiaiñ’añoleñan-dre, tsy ho zoem-boiñe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Alipo’ ty votro am-pinga ao ty taña’e,","poem":1},{"lineBreak":true},{"text":"fe tsy ahere’e mb’am-bava.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lafao ty mpiteratera,","poem":1},{"lineBreak":true},{"text":"hianara’ ty seretse fañahy,","poem":1},{"lineBreak":true},{"text":"fe endaho ty maharendreke,","poem":1},{"lineBreak":true},{"text":"hitovoñañe ty hilala’e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ty mampianto rae,","poem":1},{"lineBreak":true},{"text":"naho ty manao soike aman-drene,","poem":1},{"lineBreak":true},{"text":"le anadahy manalatse naho mahameñatse.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mijihera tsy hañaoñ’ endake, anake,","poem":1},{"lineBreak":true},{"text":"le handifihe’o ty tsaran-kilala.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Maneratera ty hatò ty mpitalily votro,","poem":1},{"lineBreak":true},{"text":"vaho lifo-karatiañe ty vava’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ampihentseñen-dilo ty mpandrabioñe","poem":1},{"lineBreak":true},{"text":"naho lafa ty lambosin-dagola.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}