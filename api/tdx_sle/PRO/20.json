{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Mpamerevere ty divay,","poem":1},{"lineBreak":true},{"text":"mpañotakotake ty toake,","poem":1},{"lineBreak":true},{"text":"vaho tsy mahihitse i nampivìhe’ey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ty fampangebaheban-kaviñera’","poem":1},{"lineBreak":true},{"text":"i mpanjakaiy,","poem":1},{"lineBreak":true},{"text":"le manahake ty firohafan-diona;","poem":1},{"lineBreak":true},{"text":"mamoe aiñe ty mitrabik’ aze hiboseha’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Havañona’ ondaty te miholiatse","poem":1},{"lineBreak":true},{"text":"añ-ali-drokoñe,","poem":1},{"lineBreak":true},{"text":"fe manjehatse avao o dagolao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy mitrabak’ asotry ty tembo;","poem":1},{"lineBreak":true},{"text":"ie famara-manta,","poem":1},{"lineBreak":true},{"text":"mangatake tsy mahazo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rano laleke ty fisafirian’ arofo’ ondaty,","poem":1},{"lineBreak":true},{"text":"fe mampiboak’ aze ty mahihitse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maro ty mihaboke ho mpiferenaiñe,","poem":1},{"lineBreak":true},{"text":"fa ia ty mahatendreke ondaty migahiñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mañavelo an-kahiti’e ty vantañe;","poem":1},{"lineBreak":true},{"text":"haha o ana’e manonjohy azeo!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsongàe’ ty mpanjaka","poem":1},{"lineBreak":true},{"text":"miambesatse an-jaka ao am-pihaino’e","poem":1},{"lineBreak":true},{"text":"ze atao haratiañe iaby.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ia ty mahafisaontsy ty hoe:","poem":1},{"lineBreak":true},{"text":"Fa nampikanitsoheko ty troko;","poem":1},{"lineBreak":true},{"text":"vaho malio tahin-draho?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Songa tiva am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty vato-pandanja vìlañe","poem":1},{"lineBreak":true},{"text":"naho ty kapoake vàlañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O sata’eo ro andrendrehañe i zatovo,","poem":1},{"lineBreak":true},{"text":"hera mikasokàsoke naho to i fitoloña’ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ty ravembia mahajanjiñe,","poem":1},{"lineBreak":true},{"text":"naho ty fihaino mahaoniñe,","poem":1},{"lineBreak":true},{"text":"songa namboare’ Iehovà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ko manao hatea rotse,","poem":1},{"lineBreak":true},{"text":"tsy mone ho rarake;","poem":1},{"lineBreak":true},{"text":"Avotiriho o fihaino’oo","poem":1},{"lineBreak":true},{"text":"le ho eneñe mahakama.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Raty, raty, hoe ty mpivily;","poem":1},{"lineBreak":true},{"text":"ie mienga le isengea’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eo ty volamena","poem":1},{"lineBreak":true},{"text":"naho ty vatosoa tsifotofoto;","poem":1},{"lineBreak":true},{"text":"fe safira ty fivimby nahatendreke hilala.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rambeso ty saro’ ty nitsoak’ ambahiny, tambozoro ho antoke t’ie tsy fohiñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mamy ty mofo niazo t’ie namañahy,","poem":1},{"lineBreak":true},{"text":"fa ho atseke faseñe aniany ty vava’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tolo-kevetse ro mahajadoñe safiry,","poem":1},{"lineBreak":true},{"text":"Mañolots’ añ’aly ty fanoroan-kihitse.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mampiborake tangogo","poem":1},{"lineBreak":true},{"text":"ty mpikanifoke mitsatsà;","poem":1},{"lineBreak":true},{"text":"aa le ko mirekets’ami’ty mpangaradadake.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ze mamatse rae naho rene,","poem":1},{"lineBreak":true},{"text":"hikipeke an-kaieñe ao ty failo’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ty lova tinaentaeñe am-baloha’e,","poem":1},{"lineBreak":true},{"text":"tsy ho tahieñe am-para’e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ko manao ty hoe: Ho valeko i ratiy; mahaliñisa Iehovà,","poem":1},{"lineBreak":true},{"text":"Ie ty handrombak’ azo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tiva am’ Iehovà ty vato-lanja tsy mira; vaho tsy vokatse o fandanjàñe vìlañeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Alaha’ Iehovà o lia’ ondatio; aia arè ty haharendreha’ ondaty i lala’ey?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fandrike ty ikofofoaha’ t’indaty,","poem":1},{"lineBreak":true},{"text":"ty hoe: Masiñe! ie añe i fantay","poem":1},{"lineBreak":true},{"text":"vaho añontanea’e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Manònga o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"ty mpanjaka mahihitse;","poem":1},{"lineBreak":true},{"text":"le ampivarimbariñe’e ama’e ty larò.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Failo’ Iehovà ty arofo’ ondaty,","poem":1},{"lineBreak":true},{"text":"Fonga karaofe’e o añova’eo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mahafijadoñe ty fiferenaiñañe","poem":1},{"lineBreak":true},{"text":"naho ty hatò i mpanjakay;","poem":1},{"lineBreak":true},{"text":"tohaña’e am-patarihañe i fiambesa’ey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Enge’ o ajalahio o haozara’ iareoo;","poem":1},{"lineBreak":true},{"text":"maroi-foty ty volonahe’ o androanavio.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mamaopao-karatiañe","poem":1},{"lineBreak":true},{"text":"ty fofoke mamonotroboke,","poem":1},{"lineBreak":true},{"text":"naho mañalio o añova’eo ty lafa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}