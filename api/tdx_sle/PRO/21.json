{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Hoe kadahan-drano am-pità’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty arofo’ i mpanjakay; tehafe’e an-tsatri’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mahity am-pihaino’ ondaty o sata’eo;","poem":1},{"lineBreak":true},{"text":"fe Mpandanja arofo t’Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No’ Iehovà ambone’ ty soroñe","poem":1},{"lineBreak":true},{"text":"ty havañonañe naho ty hatò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fihaino mievoñevoñe","poem":1},{"lineBreak":true},{"text":"naho arofo miebotse:","poem":1},{"lineBreak":true},{"text":"ro failo’ o lo-tserekeo—hakeo izay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Minday havokarañe ty fisafiri’","poem":1},{"lineBreak":true},{"text":"o mavitrikeo;","poem":1},{"lineBreak":true},{"text":"fe mitarike mb’am-pilàñe","poem":1},{"lineBreak":true},{"text":"ty fanaentàeñañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ty ahazoam-bara am-pamelem-pandañitse","poem":1},{"lineBreak":true},{"text":"le evoñe mihelañe mb’am-pikoromahañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho kozozoteñe añe o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"ty amo fijoia’eo,","poem":1},{"lineBreak":true},{"text":"fa ifoneña’ iareo ty tsy hanao ty hiti’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mikelokeloke ty lala’ ondaty mengoke;","poem":1},{"lineBreak":true},{"text":"fe mahity ty fitoloña’ ty malio añ’arofo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hàmake te mitoboke","poem":1},{"lineBreak":true},{"text":"an-kotson-tapenak’ ao,","poem":1},{"lineBreak":true},{"text":"ta te miharo akiba aman-drakemba","poem":1},{"lineBreak":true},{"text":"tea-trabike.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mipay haratiañe ty tro’ i tsivokatsey,","poem":1},{"lineBreak":true},{"text":"fa tsy mahaonin-tretrè","poem":1},{"lineBreak":true},{"text":"am-pihaino’e ty rañe’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie lafañe ty mpañìnje,","poem":1},{"lineBreak":true},{"text":"mihamahihitse t’ie trentrañe,","poem":1},{"lineBreak":true},{"text":"ie anareñe ty mahihitse,","poem":1},{"lineBreak":true},{"text":"mitombo ty hilala’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Misamba ty akiba’ i lo-tserekey","poem":1},{"lineBreak":true},{"text":"ty vantañe;","poem":1},{"lineBreak":true},{"text":"avari’e mb’am-piantoañe i tsivokatsey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I manjenjen-dravembia","poem":1},{"lineBreak":true},{"text":"ami’ty fitoreo’ o rarakeo,","poem":1},{"lineBreak":true},{"text":"ty mbe hikaike fe tsy ho toiñeñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fañanintsin-kaviñerañe","poem":1},{"lineBreak":true},{"text":"ty ravoravo añ’etake,","poem":1},{"lineBreak":true},{"text":"naho filoa-tiñake ty vokàñe añ’araña ao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie anoeñe ty hatò, ehake o vañoñeo,","poem":1},{"lineBreak":true},{"text":"fe mangebahebake o mpikitroke haratiañeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hitofa am-pivorian-dolo ao t’indaty mandrike amy lalan-kilalay.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"H’ondaty poi’e ty mpitea haravoañe;","poem":1},{"lineBreak":true},{"text":"tsy ho mpañaleale ty mpikoko divay","poem":1},{"lineBreak":true},{"text":"naho menake.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Vilin’ai’ ty vantañe ty tsivokatse,","poem":1},{"lineBreak":true},{"text":"le tsoa’ ty vañoñe ty mpamañahy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hàmake t’ie mimoneñe","poem":1},{"lineBreak":true},{"text":"an-dratraratra añe,","poem":1},{"lineBreak":true},{"text":"ta t’ie miharo aman-drakemba","poem":1},{"lineBreak":true},{"text":"mandietse naho mora boseke.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mihaja añ’anjomba’ o mahihitseo","poem":1},{"lineBreak":true},{"text":"ty vara sarotse naho ty menake;","poem":1},{"lineBreak":true},{"text":"fe abotse’ ty dagola o azeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Manjo haveloñe naho havañonañe","poem":1},{"lineBreak":true},{"text":"vaho hasiñe","poem":1},{"lineBreak":true},{"text":"ty mitoha havantañañe naho fiferenaiñañe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mitroatse an-drovam-panalolahy","poem":1},{"lineBreak":true},{"text":"ty mahihitse, vaho arotsa’e","poem":1},{"lineBreak":true},{"text":"ty hafatrarañe niatoa’e.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mitan-ty fiai’e tsy ho am-poheke","poem":1},{"lineBreak":true},{"text":"ty mahambeñe falie naho fameleke.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Manivetive ty añara’e avao ty mpirohake naho mpievoñevoñe ;","poem":1},{"lineBreak":true},{"text":"ie mitoloñe am-pitrotroaboha’e.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mañe-doza amy tembo ty fañiria’e,","poem":1},{"lineBreak":true},{"text":"amy te tsy mete mitoloñe o taña’eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hadrao lomoñandro ty lahiaga,","poem":1},{"lineBreak":true},{"text":"fe matarike ty vantañe, tsy mangazoñe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tiva ty fisoroña’ o tsivokatseo;","poem":1},{"lineBreak":true},{"text":"àntsake te engae’e miharo kinia.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hikenkañe ty mpitalily vìlañe,","poem":1},{"lineBreak":true},{"text":"fe mitolom-pitaroñe ty mañaoñe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Manao tarehe mahavany ty rati-tsereke,","poem":1},{"lineBreak":true},{"text":"fe itsakorea’ ty vantañe ty hombà’e.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tsy eo ty hihitse,","poem":1},{"lineBreak":true},{"text":"ndra ty faharendrehañe,","poem":1},{"lineBreak":true},{"text":"ndra ty safiry mahafiatreatre am’Iehovà.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Hentseñeñe ho ami’ty androm-pihotakotahañe ty soavala,","poem":1},{"lineBreak":true},{"text":"fe a Iehovà ty fandrebahañe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}