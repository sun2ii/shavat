tio ty vara","poem":1},{"lineBreak":true},{"text":"mitiliñe mb’an-dindiñe eñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko kamae’o ty hàne’ o matitio,","poem":1},{"lineBreak":true},{"text":"ko irie’o o aze mafirio;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa hambañe ami’ty fañereñere’e","poem":1},{"lineBreak":true},{"text":"añ’ova’e ao ty ie: hoe re ama’o;","poem":1},{"lineBreak":true},{"text":"Mikamà naho minoma!","poem":1},{"lineBreak":true},{"text":"fe tsy ama’o ty tro’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hilañe’o i pilipito’e nitsopehe’oy,","poem":1},{"lineBreak":true},{"text":"vaho hianto i fañandriaña’oy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko misaontsy am-pitsa­noña’ ty seretse,","poem":1},{"lineBreak":true},{"text":"fa ho sirikae’e ty hihi’ o enta’oo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko avi’o ty nifaritsohañe haehae,","poem":1},{"lineBreak":true},{"text":"vaho ko miaribañe ty tanem-bode-rae,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"amy te maozatse ty mpijeba’ iareo;","poem":1},{"lineBreak":true},{"text":"hitohaña’e ty ama’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ampiantofo filie-batañe ty arofo’o,","poem":1},{"lineBreak":true},{"text":"vaho volan-kilàla o ravembia’oo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ko ahànkañe ami’ty ana’o ty lilo;","poem":1},{"lineBreak":true},{"text":"fa tsy mahavetrake ty lafan-kobaiñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie pisoe’o an-kobaiñe,","poem":1},{"lineBreak":true},{"text":"ho haha’o an tsikeokeok’ ao ty tro’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O anako, naho mahihitse ty tro’o,","poem":1},{"lineBreak":true},{"text":"ho ehake ty troko,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"vaho hirebeke ty añ’ovako ao","poem":1},{"lineBreak":true},{"text":"naho mahafivolañe ty hiti’e o soñi’oo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ko apo’o ho tsikirihen-tro’o","poem":1},{"lineBreak":true},{"text":"ty mpandilatse,","poem":1},{"lineBreak":true},{"text":"fe imaneo lomoñandro","poem":1},{"lineBreak":true},{"text":"ty fañeveñañe am’ Iehovà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe ey ty ho avy,","poem":1},{"lineBreak":true},{"text":"vaho tsy haitoañe ty fisalalà’o.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"O anako, mitsanoña naho mahihira,","poem":1},{"lineBreak":true},{"text":"vaho avantaño mb’amy lalañey ty tro’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ko mitraok’ amo","poem":1},{"lineBreak":true},{"text":"mpitolom-pitrini-divaio,","poem":1},{"lineBreak":true},{"text":"ndra amo mpamotseke henao;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"fa songa hivarin-ko rarake","poem":1},{"lineBreak":true},{"text":"ty mahake naho i jike;","poem":1},{"lineBreak":true},{"text":"vaho hisikin-tsirodea ty poie.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsendreño ty rae nisamak’ azo,","poem":1},{"lineBreak":true},{"text":"vaho ko injè’o ty rene’o t’ie bey.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vilio ty hatò le ko aletake;","poem":1},{"lineBreak":true},{"text":"ikalò hihitse naho anatse vaho hilala.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Handia taroba ty rae’ i mahitiy;","poem":1},{"lineBreak":true},{"text":"vaho hifalea’e i ana-dahy karafito nampiareñe’ey.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ampiehafo ty rae’o naho i rene’o;","poem":1},{"lineBreak":true},{"text":"hampinembanembañ’ i nisamak’ azoy.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"O anake, atoloro ahiko ty tro’o,","poem":1},{"lineBreak":true},{"text":"le ampifaleo amo satakoo o maso’oo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kadaha laleke ty tsimirirañe,","poem":1},{"lineBreak":true},{"text":"vaho vovoñe maifitse ty karapilo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mivoñoñe ao re hoe malaso,","poem":1},{"lineBreak":true},{"text":"vaho ampitomboe’e am’ondatio","poem":1},{"lineBreak":true},{"text":"ty hatsivokarañe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ia ty mioremèñe, ia ty mihontoke?","poem":1},{"lineBreak":true},{"text":"Ia ty ampoheke? Ia ty mitoreo?","poem":1},{"lineBreak":true},{"text":"Ia ty vinonotroboke tsy amam-poto’e;","poem":1},{"lineBreak":true},{"text":"Ia ty ama-maso mandofiry?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"O mihenekeneke an-divaio,","poem":1},{"lineBreak":true},{"text":"o mitolom-pitsopeke divay linaroo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ko hentea’o ty hamena’ ty divay,","poem":1},{"lineBreak":true},{"text":"ty fimilomilo’e am-pitovy ao,","poem":1},{"lineBreak":true},{"text":"ty falamam-pioriha’e.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ie am-para’e mitifatse hoe lapetake","poem":1},{"lineBreak":true},{"text":"vaho mihehetse hoe fandrefeala.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Hahaoniñe sahàtse o maso’oo,","poem":1},{"lineBreak":true},{"text":"vaho hivolan-kamengohañe","poem":1},{"lineBreak":true},{"text":"ty ron-doha’o.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Le hanahake ty mitsalalampatse","poem":1},{"lineBreak":true},{"text":"aivo’ i riakey irehe,","poem":1},{"lineBreak":true},{"text":"naho ty mandre ambone’","poem":1},{"lineBreak":true},{"text":"ty bodan-dain-dakañe eo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Namofok’ ahy iereo,","poem":1},{"lineBreak":true},{"text":"fe tsy manaintaiñe;","poem":1},{"lineBreak":true},{"text":"linafa’e fe tsy nireiko!","poem":1},{"lineBreak":true},{"text":"Ombia te ho tsekake hipaiako indraike?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}