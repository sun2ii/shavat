{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Ko kirañe’o o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"ko mañiry ho mpiam’ iareo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa mikitroke hapiaroteñe","poem":1},{"lineBreak":true},{"text":"ty ron-doha’iareo,","poem":1},{"lineBreak":true},{"text":"vaho mivolan-tsiroe-tafatoe o soñi’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hihitse ty mahafonitse anjomba,","poem":1},{"lineBreak":true},{"text":"vaho hilàla ty añorizañe aze;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fahafohinañe ty mahapea o efe’eo","poem":1},{"lineBreak":true},{"text":"amy ze hene vara soa naho mahafale.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maozatse t’indaty mahihitse,","poem":1},{"lineBreak":true},{"text":"manovon-kafatrarañe ty mahilala;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"amy te fiaoloañe mahihitse","poem":1},{"lineBreak":true},{"text":"ty ifanehafa’o amo ali’oo,","poem":1},{"lineBreak":true},{"text":"vaho minday fandrebahañe","poem":1},{"lineBreak":true},{"text":"ty hamarom-piaolo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Loho ambone’ i seretsey ty hihitse;","poem":1},{"lineBreak":true},{"text":"ie tsy manoka-palie an-dalam-bey eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hatao mpikitro-draha","poem":1},{"lineBreak":true},{"text":"ty mikilily hanao raty.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hakeo ty mikitro-kagegeañe,","poem":1},{"lineBreak":true},{"text":"vaho tiva am’ondatio ty mpañinje.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vata’e tsy an-kaozaran-drehe t’ie mitoirañe añ’andron-kaemberañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hahao o kozozotem-","poem":1},{"lineBreak":true},{"text":"bam-pandentañe mb’eoo,","poem":1},{"lineBreak":true},{"text":"ie midaliendalieñe","poem":1},{"lineBreak":true},{"text":"mb’am-panjamanañe mb’eo,","poem":1},{"lineBreak":true},{"text":"Ehe, kalaño!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa naho manao ty hoe irehe,","poem":1},{"lineBreak":true},{"text":"Inao! tsy napota’ay ‘nio!—","poem":1},{"lineBreak":true},{"text":"Tsy mahatsikarake izay hao","poem":1},{"lineBreak":true},{"text":"i Mpandanja arofoy?","poem":1},{"lineBreak":true},{"text":"tsy arofoana’ i Mpañambem-piai’oy hao?","poem":1},{"lineBreak":true},{"text":"Tsy havaha’e am’ondatio hao o sata’eo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O anako, mihinana tantele, amy te soa,","poem":1},{"lineBreak":true},{"text":"eka, mamy an-dañilañy ao","poem":1},{"lineBreak":true},{"text":"ty tantele boak’ am-papi’ey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Maharendreha te izay ty hihitse","poem":1},{"lineBreak":true},{"text":"ami’ty fiai’o; ie trea’o","poem":1},{"lineBreak":true},{"text":"le ho tendrek’ ama’o ty ho avi’o,","poem":1},{"lineBreak":true},{"text":"vaho tsy haitoañe ty fisalalà’o.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ko vandroñe’o, ty tsereheñe tia,","poem":1},{"lineBreak":true},{"text":"ty anjomba’ i vañoñey;","poem":1},{"lineBreak":true},{"text":"ko joie’o ty akiba imoneña’e;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"fa mikorovoke im-pito ty vantañe,","poem":1},{"lineBreak":true},{"text":"le mbe mitroatse avao;","poem":1},{"lineBreak":true},{"text":"fe mivembeñe añ’andron-kankàñe","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ko irebeha’o ty fihotraha’ o rafelahi’oo,","poem":1},{"lineBreak":true},{"text":"vaho ko ado’o hifalea’ ty tro’o","poem":1},{"lineBreak":true},{"text":"i fitsikapia’ey.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"fa ho vazoho’ Iehovà","poem":1},{"lineBreak":true},{"text":"naho ho alihe’e","poem":1},{"lineBreak":true},{"text":"vaho havì’e tsy ho ama’e i haviñera’ey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ko angovita’o o tsivokatseo,","poem":1},{"lineBreak":true},{"text":"le ko itsikiriha’o o lo-tserekeo;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"fa tsy aman-ko tamae’e ty tsereheñe;","poem":1},{"lineBreak":true},{"text":"le hakipe ty failo’ i borololoy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"O anake, mañeveña","poem":1},{"lineBreak":true},{"text":"am’ Iehovà naho amy mpanjakay,","poem":1},{"lineBreak":true},{"text":"le ko mitraok’ amo mpiolao,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"fa hivovoa’ ty feh’ ohatse,","poem":1},{"lineBreak":true},{"text":"vaho ia ty hahafohiñe","poem":1},{"lineBreak":true},{"text":"ty fifetsaham-piantoañe","poem":1},{"lineBreak":true},{"text":"hanoe’ i roroey?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Manoly o tsara retoañe ka","poem":1},{"lineBreak":true},{"text":"o mahihitseo:","poem":1},{"lineBreak":true},{"text":"Tsy mete an-jaka ao ty firihiañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ze manao ty hoe amo aman-kakeoo:","poem":1},{"lineBreak":true},{"text":"‘Vantan-drehe,’ ro honjira’ i màroy;","poem":1},{"lineBreak":true},{"text":"vaho ho heje’ o fifeheañeo;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"fe ho ehake o mahafañendakeo","poem":1},{"lineBreak":true},{"text":"vaho ho soa tata.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Orofeñe o fivimby mahatoiñe","poem":1},{"lineBreak":true},{"text":"an-kahiti’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Henefo heike ty fitromaha’o alafe’e ao","poem":1},{"lineBreak":true},{"text":"naho halahalao o tete’oo,","poem":1},{"lineBreak":true},{"text":"vaho ranjio amy zao ty akiba’o.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ko sesehe’o, tsy amam-poto’e t’indaty;","poem":1},{"lineBreak":true},{"text":"vaho ko mamañahy am-pivimby.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ko manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Hanoako hambañe amy nanoa’e ahikoy;","poem":1},{"lineBreak":true},{"text":"sindre havahako ty amy sata’ey.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Niozàko ty tete’ i tembo,","poem":1},{"lineBreak":true},{"text":"niariako ty tanem-balobo’ i seretse;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"hehe t’ie nioboñobom-patike;","poem":1},{"lineBreak":true},{"text":"nilafihan-kisatse i taney,","poem":1},{"lineBreak":true},{"text":"vaho narobake ty kijolim-bato’e.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ie nitreako le naereñereko,","poem":1},{"lineBreak":true},{"text":"nenteako vaho nitendrek’ anatse.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Firotse kede, mandre betebeteke,","poem":1},{"lineBreak":true},{"text":"mañohom-pitañe hiroro,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"le hikovovoke mb’ama’o ty hararahañe,","poem":1},{"lineBreak":true},{"text":"vaho hoe lahin-defoñe ty hapoia’o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}