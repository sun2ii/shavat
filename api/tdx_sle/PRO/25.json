{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Tovo’ ty razan-tsaontsi’","poem":1},{"lineBreak":true},{"text":"i Selomò iretiañe,","poem":1},{"lineBreak":true},{"text":"o nitsikombean-droandria’","poem":1},{"lineBreak":true},{"text":"i Kez’kia, mpanjaka’ Iehodao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Engen’Añahare ty mampikafi-draha,","poem":1},{"lineBreak":true},{"text":"naho volonahe’ o mpanjakao","poem":1},{"lineBreak":true},{"text":"ty mañotsohotso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ty haabo’ i likerañey,","poem":1},{"lineBreak":true},{"text":"ty halale’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"izay ty hasaro-pitsikarahañe","poem":1},{"lineBreak":true},{"text":"ty arofom-panjaka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Afaho amo volafotio ty taim-pira’e,","poem":1},{"lineBreak":true},{"text":"le ho amam-panefea’e finga ty mpanefe;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"asitaho añatrefa’ i mpanjakay","poem":1},{"lineBreak":true},{"text":"o tsereheñeo,","poem":1},{"lineBreak":true},{"text":"le hijadoñe an-kavantañañe","poem":1},{"lineBreak":true},{"text":"ty fiambesa’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko mañonjom-bata","poem":1},{"lineBreak":true},{"text":"añatrefa’ i mpanjakay,","poem":1},{"lineBreak":true},{"text":"ndra mijohañe an-toe’ o aman-kasiñeo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hàmake te anoeñe ama’o ty hoe:","poem":1},{"lineBreak":true},{"text":"Miheova mb’aolo atoa,","poem":1},{"lineBreak":true},{"text":"ta t’ie hareke añatrefa’ o roandriañe","poem":1},{"lineBreak":true},{"text":"niisam-pihaino’oo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ko malisa hanese sisy;","poem":1},{"lineBreak":true},{"text":"fa inoñe ty hanoe’o ampara’e,","poem":1},{"lineBreak":true},{"text":"t’ie ampisalara’ indatiy?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mifandahara hey am’indatiy","poem":1},{"lineBreak":true},{"text":"le ko borahe’o ty tsikenta’ ondaty;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"tsy mone hinje’e te mahajanjiñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho modo ty halolo-lahi’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe raketa volamena","poem":1},{"lineBreak":true},{"text":"niravaheñe volafoty","poem":1},{"lineBreak":true},{"text":"ty saontsy soa mañeva.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoe bange volamena naho","poem":1},{"lineBreak":true},{"text":"ravake volamena ki’e,","poem":1},{"lineBreak":true},{"text":"ty endake an-kihitse","poem":1},{"lineBreak":true},{"text":"an-dravembia mahafijanjiñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty hanintsim-panala","poem":1},{"lineBreak":true},{"text":"am-bolam-binta","poem":1},{"lineBreak":true},{"text":"ty ìrake lili-po amo mpañirak’ azeo;","poem":1},{"lineBreak":true},{"text":"ie ampanintsiñe’e ty arofo’ o talè’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hoe rahoñe miharo tioke","poem":1},{"lineBreak":true},{"text":"tsy amañ’orañe","poem":1},{"lineBreak":true},{"text":"ty misenge ravoravo tsy atolo’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mete handreketse ty mpifehe","poem":1},{"lineBreak":true},{"text":"ty fahaliñisañe,","poem":1},{"lineBreak":true},{"text":"naho mahafipoza-taolañe","poem":1},{"lineBreak":true},{"text":"ty fisaontsy malea.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ihe tendreke tantele,","poem":1},{"lineBreak":true},{"text":"mikama ze mahaeneñe,","poem":1},{"lineBreak":true},{"text":"kera habodàja’o te mitipak’ eratse.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Soa re te tsy siak’ añ’akiban-drañe’o ao o fandia’oo,","poem":1},{"lineBreak":true},{"text":"tsy mone ho etsak’ azo, vaho ho heje’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hoe kobaiñe, naho fibara,","poem":1},{"lineBreak":true},{"text":"vaho ana-pale masioñe","poem":1},{"lineBreak":true},{"text":"ty manara-bande ama’ ondaty.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hoe nife folake ndra fandia mikoletra","poem":1},{"lineBreak":true},{"text":"ty fiatoañe ami’ty mpamañahy","poem":1},{"lineBreak":true},{"text":"an-tsam-poheke.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hoe mañafa-tsaroñe","poem":1},{"lineBreak":true},{"text":"añ’andro manintsy,","poem":1},{"lineBreak":true},{"text":"ndra ty vinegra nalaro sokay","poem":1},{"lineBreak":true},{"text":"ty mibeko ami’ty milendèñe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie saliko ty rafelahi’o,","poem":1},{"lineBreak":true},{"text":"anjotso mahakama;","poem":1},{"lineBreak":true},{"text":"ie taliñiereñe, fahano rano;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"zay ty hamotria’o foroha mirekake","poem":1},{"lineBreak":true},{"text":"añ’ambone’e eo,","poem":1},{"lineBreak":true},{"text":"vaho hanambe azo t’Iehovà.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Minday orañe ty tiok’ avaratse,","poem":1},{"lineBreak":true},{"text":"naho minday laharañe miloroloro","poem":1},{"lineBreak":true},{"text":"ty lela manao tsikony.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hàmake himoneñe","poem":1},{"lineBreak":true},{"text":"añ’ilan-tampenak’ ao,","poem":1},{"lineBreak":true},{"text":"ta te añ’anjomba mitraoke","poem":1},{"lineBreak":true},{"text":"aman-drakemba mpitrabike.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hoe rano manintsy","poem":1},{"lineBreak":true},{"text":"ami’ty maran-drano,","poem":1},{"lineBreak":true},{"text":"ty talily soa boak’an-tsietoitàne añe.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hoe rano manganahana","poem":1},{"lineBreak":true},{"text":"nileoren-ditsake,","poem":1},{"lineBreak":true},{"text":"naho vovoñe nitivaeñe,","poem":1},{"lineBreak":true},{"text":"ty vantañe miheve ty lo-tsereke.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tsy mahasoa te mikama tantele maro,","poem":1},{"lineBreak":true},{"text":"vaho tsy enge’o t’ie mandrenge vatañe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hoe ty fiboroboñafañe an-drova","poem":1},{"lineBreak":true},{"text":"tsy aman-kijoly,","poem":1},{"lineBreak":true},{"text":"t’indaty tsy maha-lie-batañe","poem":1}]}],"footnote