m":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Valeo mañeva’ i hagegea’ey ty dagola,","poem":1},{"lineBreak":true},{"text":"tsy mone hahihitse ami’ty maso’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe mañitsike tomboke","poem":1},{"lineBreak":true},{"text":"naho migenoke voreke,","poem":1},{"lineBreak":true},{"text":"ty mampisangitrike taratasy","poem":1},{"lineBreak":true},{"text":"am-pitàn-dagola.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maletraletra ty fandia’ i kepeke,","poem":1},{"lineBreak":true},{"text":"naho ty razan-drehak’ am-bava’","poem":1},{"lineBreak":true},{"text":"o seretseo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hoe mañombe vato am-piletse,","poem":1},{"lineBreak":true},{"text":"ty miasy i gegegege.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hoe fatike mipok’ an-taña’ i jike,","poem":1},{"lineBreak":true},{"text":"ty razan-drehak’ am-bava’ i dagola.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie mampitoloñe ty seretse,","poem":1},{"lineBreak":true},{"text":"le manahake te mañeke mpandrioñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe amboa mimpoly ami’ty loa’e,","poem":1},{"lineBreak":true},{"text":"ty dagola mamereñe ty hagegea’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsy fa nahaisake ondaty mahihitse","poem":1},{"lineBreak":true},{"text":"am-pihaino’e hao irehe?","poem":1},{"lineBreak":true},{"text":"bey ty fitamà’ i seretsey ta ty aze.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hoe ty votro,","poem":1},{"lineBreak":true},{"text":"Inao liona ty an-damoke eo!","poem":1},{"lineBreak":true},{"text":"Midada an-dalañe ey ty liona!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manahake ty figavingavin-dalañe","poem":1},{"lineBreak":true},{"text":"amo soavili’eo,","poem":1},{"lineBreak":true},{"text":"ty tembo am-pandrea’e eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ajo’ i votro am-po finga ao ty taña’e,","poem":1},{"lineBreak":true},{"text":"fe tsy lefe’e ty minday aze mb’am-bava’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mahihitse ami’ty maso’e ty tembo,","poem":1},{"lineBreak":true},{"text":"te ami’ty fito-lahy manoiñe","poem":1},{"lineBreak":true},{"text":"an-kavantañañe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hambañ’ ami’ty mitsepak’ amboa an-tsofi’e,","poem":1},{"lineBreak":true},{"text":"ty mpandrioñe mihilintsioñe","poem":1},{"lineBreak":true},{"text":"ami’ty aly tsy aze.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hoe ty derendereñe mañiririñe","poem":1},{"lineBreak":true},{"text":"raha mibelañe, naho ana-pale,","poem":1},{"lineBreak":true},{"text":"vaho fampihomahañe,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ty mamitake ondaty ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Nisolesole avao iraho.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mate ty afo tsy aman-katae,","poem":1},{"lineBreak":true},{"text":"modo ka ty dabasida tsy aman-tsikotsiko.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hoe sarebò ami’ty foroha mirekake,","poem":1},{"lineBreak":true},{"text":"naho hatae ami’ty afo,","poem":1},{"lineBreak":true},{"text":"ty famiaña’ i mpanao tsikoniy","poem":1},{"lineBreak":true},{"text":"hañolaña’e aiñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe kenoke mafiry","poem":1},{"lineBreak":true},{"text":"ty fivolam-pitàngogo,","poem":1},{"lineBreak":true},{"text":"ie migodoñe mb’añ’ova lalek’ ao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hoe valàñe-tane nihamineñe","poem":1},{"lineBreak":true},{"text":"taim-piram-bolafoty","poem":1},{"lineBreak":true},{"text":"ty fameleke ampirehetan-","poem":1},{"lineBreak":true},{"text":"kelok’ an-troke ao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Añonohonoa’ ty famele’e i falaiña’ey,","poem":1},{"lineBreak":true},{"text":"fe añaja’e famañahiañe ty an-tro’e ao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ndra t’ie mirehake fañisohañe,","poem":1},{"lineBreak":true},{"text":"ko iantofa’o,","poem":1},{"lineBreak":true},{"text":"fa pea tiva fito ty an-tro’e ao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aeta’e am-pitake ty halò-tsere’e,","poem":1},{"lineBreak":true},{"text":"fe hiboak’ am-pivory ao ty haloloa’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Higodoñe an-koboñe ao ty nihaly aze,","poem":1},{"lineBreak":true},{"text":"himpoly ama’e ty vato navarimbari’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Heje ty famele’ i remborake o jinoi’eo,","poem":1},{"lineBreak":true},{"text":"mampianto ka ty falie manao kabeake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}