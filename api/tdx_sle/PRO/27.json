rue},{"text":"Hàmake ty endak’ am-batraike,","poem":1},{"lineBreak":true},{"text":"ta ty hatea mietake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vente’e ty fikobokoboan-drañetse,","poem":1},{"lineBreak":true},{"text":"ta ty oroke maro’ i rafelahiy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Malay tantele ty ànjañe,","poem":1},{"lineBreak":true},{"text":"fe mamy ami’ty saliko ze atao mafaitse.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hoe foly mandifik’ ami’ty traño’e,","poem":1},{"lineBreak":true},{"text":"t’indaty mandridrike ami’ty akiba’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mampinembanembañ’ arofo","poem":1},{"lineBreak":true},{"text":"ty rano mañitse naho ty rame,","poem":1},{"lineBreak":true},{"text":"vaho mahasaro-tron-drañetse","poem":1},{"lineBreak":true},{"text":"ty famerea’ondaty.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko aforintse’o ty rañe’o","poem":1},{"lineBreak":true},{"text":"naho ty rañen-drae’o,","poem":1},{"lineBreak":true},{"text":"vaho ko mamonje ty anjomban-drahalahi’o","poem":1},{"lineBreak":true},{"text":"naho mivovò ama’o ty hankàñe;","poem":1},{"lineBreak":true},{"text":"kitra’e ty mpitrao-tanàñe marine eo,","poem":1},{"lineBreak":true},{"text":"ta ty rahalahy añe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mahihira irehe anake,","poem":1},{"lineBreak":true},{"text":"naho ampiehafo ty troko,","poem":1},{"lineBreak":true},{"text":"hahavaleako ze mitombok’ ahy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mahaonin-kankàñe ty mahilala","poem":1},{"lineBreak":true},{"text":"le miampitse,","poem":1},{"lineBreak":true},{"text":"fe misibeke mb’eo ty forom-po,","poem":1},{"lineBreak":true},{"text":"vaho mijale.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rambeso ty sarimbo’ i","poem":1},{"lineBreak":true},{"text":"nitsoake ambahiniy,","poem":1},{"lineBreak":true},{"text":"le ifihino ho antoke ty amy ampela tsy fohiñey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ty mitata rañetse am-pazake","poem":1},{"lineBreak":true},{"text":"te terak’ andro,","poem":1},{"lineBreak":true},{"text":"hatao ho fatse ama’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty fitsopatsopan’","poem":1},{"lineBreak":true},{"text":"andro avy,","poem":1},{"lineBreak":true},{"text":"ty rakemba mitribahatse;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"hamejan-tioke t’ie hamejañ’aze,","poem":1},{"lineBreak":true},{"text":"hoe mamihiñe menak’ am-pitàn-kavana.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Maniom-by ty vy,","poem":1},{"lineBreak":true},{"text":"vaho andrañita’ ondaty ty vintan-drañe’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hikama ty voa’e","poem":1},{"lineBreak":true},{"text":"ty mañalahala sakoañe,","poem":1},{"lineBreak":true},{"text":"vaho hasiñeñe ty miatrake i talè’ey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Manahake ty tarehen-drano hetsoroen-daharañe,","poem":1},{"lineBreak":true},{"text":"ty hetsoroen’ arofo’ ondaty t’ondaty.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsimbia tsy etsake ty tsikeokeoke","poem":1},{"lineBreak":true},{"text":"naho ty hankàñe,","poem":1},{"lineBreak":true},{"text":"le liae tsy eneñe ty fihaino’ ondaty.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Am-patañe ty volafoty","poem":1},{"lineBreak":true},{"text":"vaho an-toñake ty volamena,","poem":1},{"lineBreak":true},{"text":"fitsoehañe ondaty ty engeñe atolots’aze.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ndra te demoheñe amañ’ana-deo","poem":1},{"lineBreak":true},{"text":"an-deoñe mitraoke tsako lisaneñe","poem":1},{"lineBreak":true},{"text":"ty dagola,","poem":1},{"lineBreak":true},{"text":"mbe tsy hisitak’ ama’e ty hanè’e.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Rendreho soa o hare’oo,","poem":1},{"lineBreak":true},{"text":"vaho dareo o lia-rai’oo,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"fa tsy nainai’e ty vara,","poem":1},{"lineBreak":true},{"text":"naho tsy ho añ’afe’afe’e","poem":1},{"lineBreak":true},{"text":"ty sabakam-bolonahetse.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie fa tinatake i ahetsey,","poem":1},{"lineBreak":true},{"text":"naho mitiry o tiritiri’eo,","poem":1},{"lineBreak":true},{"text":"vaho natontoñe ty ahetse am-bohitse ey;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ho siki’o o anak-añondrio,","poem":1},{"lineBreak":true},{"text":"vaho ho vilin-teteke o ose-lahio;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"mahaeneñe ty fikama’o i rononon’ osey,","poem":1},{"lineBreak":true},{"text":"naho ho hane’ o keleia’oo,","poem":1},{"lineBreak":true},{"text":"vaho ho famahanañe o anak-ampata’oo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}