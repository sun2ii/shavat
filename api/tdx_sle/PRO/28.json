{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Mibotatsake ty tsivokatse,","poem":1},{"lineBreak":true},{"text":"ndra te tsy horidañeñe,","poem":1},{"lineBreak":true},{"text":"fe mahafiato hoe liona tora’e","poem":1},{"lineBreak":true},{"text":"o vañoñeo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kanao miola ty tane, maro ty mpifele’e","poem":1},{"lineBreak":true},{"text":"fe mahatam-pahendre’e","poem":1},{"lineBreak":true},{"text":"t’indaty mahilala naho maharendreke,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"T’indaty rarake mamorekeke ty poi’e,","poem":1},{"lineBreak":true},{"text":"le hoe oram-bey tsy manisa hane.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsiririe’ o tsereheñeo ty mifary Hàke,","poem":1},{"lineBreak":true},{"text":"f’ie atreatrè’ ty mahatàn-Kake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy apota’ o ratio ty hatò,","poem":1},{"lineBreak":true},{"text":"f’ie kila fohi’ ty mitsoeke Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hàmake te rarake","poem":1},{"lineBreak":true},{"text":"mañavelo an-kavantañañe,","poem":1},{"lineBreak":true},{"text":"ta te mpañefoefo mengok’ an-tsata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mahatan-Kàke ty anake mahihitse,","poem":1},{"lineBreak":true},{"text":"fe manalatse an-drae’e","poem":1},{"lineBreak":true},{"text":"ty mirañetse amy mahake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ty mampitombo vara ami’ty fañonjona’e ty anam-bola angala’e","poem":1},{"lineBreak":true},{"text":"ro manontoñe aze","poem":1},{"lineBreak":true},{"text":"ho ami’ty miferenaiñe amo rarakeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I mitan-tsofy tsy hitsanoña’e Hake,","poem":1},{"lineBreak":true},{"text":"tiva ka ty fisolohoa’e","poem":1},{"noteId":14},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hijoñe an-davake hinali’e ao avao","poem":1},{"lineBreak":true},{"text":"ty mampandifike o vantañeo","poem":1},{"lineBreak":true},{"text":"mb’an-dalan-karatiam-beo,","poem":1},{"lineBreak":true},{"text":"fe ho soa lova o vañoñeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mahihitse am-pihaino’e ty mpañaleale,","poem":1},{"lineBreak":true},{"text":"fe mahatsikarak’ aze ty rarake mahilala.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ipoñafen-drebeke te mandreketse ty vañoñe,","poem":1},{"lineBreak":true},{"text":"fe mikafikafitse ondatio","poem":1},{"lineBreak":true},{"text":"naho miongake ty lo-tsereke.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy hiraorao ty mañetake ty fiolà’e,","poem":1},{"lineBreak":true},{"text":"fe ho tretrèzeñe ty misoloho","poem":1},{"lineBreak":true},{"text":"naho mifoneñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Haha t’indaty mitampompotse,","poem":1},{"lineBreak":true},{"text":"fa hihotrak’ an-karatiañe","poem":1},{"lineBreak":true},{"text":"ty gañe añ’arofo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Manahake ty fitrè’ i lionay","poem":1},{"lineBreak":true},{"text":"naho i dobe mihitrihitry,","poem":1},{"lineBreak":true},{"text":"ty mpifehe lo-tserek’ am’ondaty rarakeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Po-hilala ty mpifehe mamorekeke,","poem":1},{"lineBreak":true},{"text":"fe ho lava-havelo","poem":1},{"lineBreak":true},{"text":"ty malaim-bara tsy mahity.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hahitrike mb’an-koboñe ao","poem":1},{"lineBreak":true},{"text":"ty mivave lio-màliñe,","poem":1},{"lineBreak":true},{"text":"tsy eo ty hañimb’aze.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho rombaheñe","poem":1},{"lineBreak":true},{"text":"ty mañavelo an-kalio-tahiñe,","poem":1},{"lineBreak":true},{"text":"fe hikorovoke aniany","poem":1},{"lineBreak":true},{"text":"ty mañorike lala-mengoke.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho enen-kaneñe ty miava ty tane’e,","poem":1},{"lineBreak":true},{"text":"fe hizò hararahañe","poem":1},{"lineBreak":true},{"text":"ty mpañeañe hakoahañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ho soa tata t’indaty migahiñe,","poem":1},{"lineBreak":true},{"text":"fe tsy ho po-lafa ty mihepakepake","poem":1},{"lineBreak":true},{"text":"ho mpitsikafo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy soa ty mirihy,","poem":1},{"lineBreak":true},{"text":"naho mete hampandilatse ondaty","poem":1},{"lineBreak":true},{"text":"ty mofo pila’e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mpañeam-bara ty ama’ maso-migioke,","poem":1},{"lineBreak":true},{"text":"fe tsy rendre’e te hiambotraha’","poem":1},{"lineBreak":true},{"text":"ty hararahañe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hanjo fañisohañe am-para’e","poem":1},{"lineBreak":true},{"text":"ty mañendake ondaty,","poem":1},{"lineBreak":true},{"text":"mandikoatse ty mpanao kabeake","poem":1},{"lineBreak":true},{"text":"am-pameleke.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ze mampikametse aman-drae’e","poem":1},{"lineBreak":true},{"text":"ndra aman-drene’e","poem":1},{"lineBreak":true},{"text":"vaho manao ty hoe: Tsy fiolàñe izay;","poem":1},{"lineBreak":true},{"text":"ro mpiami’ ty mpijoy.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mpitrobo fitrabihañe ty mpitrotroaboke,","poem":1},{"lineBreak":true},{"text":"fe miraorao ze miato am’ Iehovà.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Minè ty miato aman-tro’e,","poem":1},{"lineBreak":true},{"text":"fe haha ty mañavelo an-kihitse.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ho tampe-draha-irieñe","poem":1},{"lineBreak":true},{"text":"ty mamahañe o rarakeo,","poem":1},{"lineBreak":true},{"text":"fe hizò fatse maro ty mikipe maso.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ie mitroatse o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"mietake ondatio;","poem":1},{"lineBreak":true},{"text":"fa ie mihomake,","poem":1},{"lineBreak":true},{"text":"le mihavelo o vañoñeo.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Iob 15:29, Ies 59:1-2, Jao 9:31, Jn I 3:22","reference":{"chapter":28,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/29.json","nextChapterA