"poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mandafike harato ho am-pandia’e eo","poem":1},{"lineBreak":true},{"text":"t’indaty mitsiriry rañetse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fiolàñe ty mamandrike i lo-tserekey,","poem":1},{"lineBreak":true},{"text":"fe misabo naho mirebeke ty mahity.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Haoñe’ ty vantañe ty zo’ o rarakeo,","poem":1},{"lineBreak":true},{"text":"fe tsy apota’ i lo-tserekey","poem":1},{"lineBreak":true},{"text":"i hilala zay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mamofotse ty rova,","poem":1},{"lineBreak":true},{"text":"ondaty mañivañivao,","poem":1},{"lineBreak":true},{"text":"fe mampivio-kabosehañe o mahihitseo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie mifandietse ami’ty dagola","poem":1},{"lineBreak":true},{"text":"ty mahihitse,","poem":1},{"lineBreak":true},{"text":"le ifanampea’ ty filoroloroañe naho fanivetiveañe tsy mijihetse.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Heje’ o mpampiori-dioo ty vañoñe;","poem":1},{"lineBreak":true},{"text":"le i vantañey, paia’ iareo ty fiai’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fonga abora’ i dagolay ty tro’e,","poem":1},{"lineBreak":true},{"text":"fe kalaña’ i mahihitsey","poem":1},{"lineBreak":true},{"text":"am-pianjiñañe ao ty aze.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie mañaom-bande ty mpifehe,","poem":1},{"lineBreak":true},{"text":"miha raty iaby o roandria’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ty fihambaña’ i rarakey","poem":1},{"lineBreak":true},{"text":"naho o mpamorekekeo:","poem":1},{"lineBreak":true},{"text":"Iehovà ty mañazava","poem":1},{"lineBreak":true},{"text":"ty fihaino’ i roe rey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie mizaka o rarakeo an-kahiti’e","poem":1},{"lineBreak":true},{"text":"ty mpanjaka,","poem":1},{"lineBreak":true},{"text":"le hijadoñe kitro añ’afe’e i fiambesa’ey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mpanolo-hihitse ty kobay","poem":1},{"lineBreak":true},{"text":"naho ty endake,","poem":1},{"lineBreak":true},{"text":"fe manalatse rene","poem":1},{"lineBreak":true},{"text":"ty anake manao tsidaredare.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie mionjoñe o tsivokatseo,","poem":1},{"lineBreak":true},{"text":"mitombo ty fiolàñe,","poem":1},{"lineBreak":true},{"text":"fe ho sambae’ i vañoñey","poem":1},{"lineBreak":true},{"text":"ty fifotsaha’ iareo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lilovo ty ana’o, le hampanintsiña’e,","poem":1},{"lineBreak":true},{"text":"vaho hampinembanembae’e ty arofo’o.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie po-aroñarom-pitokiañe,","poem":1},{"lineBreak":true},{"text":"le hahifi’ ondatio añe","poem":1},{"lineBreak":true},{"text":"ty filieram-batañe,","poem":1},{"lineBreak":true},{"text":"haha ka ze mahatan-Kàke.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy mahafanoro ty ondevo","poem":1},{"lineBreak":true},{"text":"t’ie saontsieñe avao,","poem":1},{"lineBreak":true},{"text":"ndra te azo’e tsy haoñe’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Inao t’indaty taentaeneñe","poem":1},{"lineBreak":true},{"text":"am-pisaontsi’e,","poem":1},{"lineBreak":true},{"text":"bey fitamàñe ty dagola te ama’e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I mañaonkaom-pitoroñe","poem":1},{"lineBreak":true},{"text":"boak’amy faha-ajaja’eiy,","poem":1},{"lineBreak":true},{"text":"ro hanjo aze mpandova am-para’e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mpitrobo fitribahañe ty boseke,","poem":1},{"lineBreak":true},{"text":"vaho lako fiolàñe ty mpidabadoa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mamotsake ondaty ty habohaboha’e,","poem":1},{"lineBreak":true},{"text":"fe asiñeñe ty mpireke añ’arofo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Malaim-batañe ty mpireketse","poem":1},{"lineBreak":true},{"text":"ami’ty mpampikametse,","poem":1},{"lineBreak":true},{"text":"tsanoña’e i sisìy, f’ie tsy mitalily.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Miafara ho fandrike","poem":1},{"lineBreak":true},{"text":"ty fihembañañe ama’ ondaty;","poem":1},{"lineBreak":true},{"text":"fe honjoneñe ty miato am’ Iehovà.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Maro ty mipay ty fañisoham-pifehe,","poem":1},{"lineBreak":true},{"text":"fa Iehovà ro ahazoa’ t’indaty to.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tiva amo vañoñeo t’indaty tsy to;","poem":1},{"lineBreak":true},{"text":"fe veta amy lo-tserekey","poem":1},{"lineBreak":true},{"text":"ty vantañe am-pañaveloa’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}