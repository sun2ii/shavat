{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Miatoa am’ Iehovà"]},{"type":"verse","number":1,"content":[{"text":"O anake, ko haliño o entakoo","poem":1},{"lineBreak":true},{"text":"le ampañambeno ty tro’o o lilikoo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le halavan’andro naho taon-kavelo","poem":1},{"lineBreak":true},{"text":"vaho fierañerañañe ty hatovoñ’ ama’o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko ado’o hieng’azo ty fatarihañe","poem":1},{"lineBreak":true},{"text":"naho ty hatò;","poem":1},{"lineBreak":true},{"text":"rohizo am-bozo’o eo,","poem":1},{"lineBreak":true},{"text":"sokiro an-takelan-tro’o ao,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"hahaoniña’o hamaràm-bintañe","poem":1},{"lineBreak":true},{"text":"vaho tahinañe soa","poem":1},{"lineBreak":true},{"text":"ampivazohoan’ Añahare naho ondatio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Miatoa am’ Iehovà","poem":1},{"lineBreak":true},{"text":"an-kaampon-tro’o","poem":1},{"lineBreak":true},{"text":"vaho ko iatoa’o ty hilala’o;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iantofo amy ze hene lia’o,","poem":1},{"lineBreak":true},{"text":"le ho vantañe’e o lala’oo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ko manao mahihitse a maso’o;","poem":1},{"lineBreak":true},{"text":"mirevendreveña am’ Iehovà","poem":1},{"lineBreak":true},{"text":"vaho ihankaño ty hatsivokarañe,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ie ho fijangañan-tsandri’o,","poem":1},{"lineBreak":true},{"text":"vaho fameloman-taola’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Iasio t’Iehovà amo vara’oo,","poem":1},{"lineBreak":true},{"text":"naho ami’ty lohavoa’ o nampitomboe’oo;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Le handopolopo, hamopòke","poem":1},{"lineBreak":true},{"text":"ty an-driha’o ao","poem":1},{"lineBreak":true},{"text":"vaho handopatse divay vao o sajoa’oo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O anake, ko sirikae’o","poem":1},{"lineBreak":true},{"text":"ty fandilova’ Iehovà","poem":1},{"lineBreak":true},{"text":"ko heje’o o fañendaha’eo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"fa lilove’ Iehovà ty kokoa’e,","poem":1},{"lineBreak":true},{"text":"hambañe ami’ty rae","poem":1},{"lineBreak":true},{"text":"i anadahy ampokofe’ey","poem":1},{"noteId":2},{"text":".","poem":1}]},{"type":"heading","content":["Toe Vara"]},{"type":"verse","number":13,"content":[{"text":"Haha t’ indaty mahaonin-kihitse,","poem":1},{"lineBreak":true},{"text":"naho t’indaty itomboan-kilala,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"fa lombolombo ty fitomboam-bolafoty","poem":1},{"lineBreak":true},{"text":"ty fibodobodoa’e,","poem":1},{"lineBreak":true},{"text":"vaho ambonem-bolamena ty havokara’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sarotse te amo safirao","poem":1},{"noteId":3},{"lineBreak":true},{"text":"vaho tsy amo salalae’oo","poem":1},{"lineBreak":true},{"text":"ty mañirinkiriñ’aze.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lava-havelo ty am-pitàn-kavana’e","poem":1},{"lineBreak":true},{"text":"vara naho asiñe ro am-pitàn-kavia’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lalam-panintsiñañe o lala’eo,","poem":1},{"lineBreak":true},{"text":"vaho fierañerañañe","poem":1},{"lineBreak":true},{"text":"o lalam-pandia’eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hataen-kavelon-dre","poem":1},{"lineBreak":true},{"text":"amo mivontititse ama’eo;","poem":1},{"lineBreak":true},{"text":"naho hene haha ze mamejañe aze.","poem":1}]},{"type":"heading","content":["Ty Hihin-Añahare amo Voatseo"]},{"type":"verse","number":19,"content":[{"text":"Hihitse ty nañoriza’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty tane toy;","poem":1},{"lineBreak":true},{"text":"Hilala ty nampijadoña’e","poem":1},{"lineBreak":true},{"text":"o likerañeo;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O hilala’eo ro ampiborahañe o lalekeo, vaho ampi­tsopaha’ o rahoñeo mika.","poem":1}]},{"type":"heading","content":["Fiarovañe To"]},{"type":"verse","number":21,"content":[{"text":"O anake, asoao tsy hisitake","poem":1},{"lineBreak":true},{"text":"am-pahatreava’o ao o raha zao :","poem":1},{"lineBreak":true},{"text":"vontitiro ty hihitse to","poem":1},{"lineBreak":true},{"text":"naho ty filieram-batañe,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"hamelombeloñe ty tro’o,","poem":1},{"lineBreak":true},{"text":"naho handravake ty vozo’o.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Le handena’o an-kanintsiñe","poem":1},{"lineBreak":true},{"text":"ty lia’o, vaho tsy hikotrofotse ty tombo’o.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tsy ho hembañe te mandre;","poem":1},{"lineBreak":true},{"text":"eka ie mihitsy, ho mamy ty firoro’o.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ko mianifañe te ivotraha’ ty mampangebahebake,","poem":1},{"lineBreak":true},{"text":"ndra ty fampiantoañe o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"te mifetsake.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"fa Iehovà ro hatokisa’o","poem":1},{"lineBreak":true},{"text":"naho hitañe ty tombo’o","poem":1},{"lineBreak":true},{"text":"tsy ho fandriheñe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ko tana’o ami’ty mañeva ty soa,","poem":1},{"lineBreak":true},{"text":"naho an-taña’o ty mahaeneñe aze.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ko manao ty hoe am’ondatio: Akia hey, le mibaliha, vaho hamaray","poem":1},{"lineBreak":true},{"text":"ty hanolorako azo— ie ama’o ao avao.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ko mikitro-draty am’ ondatio,","poem":1},{"lineBreak":true},{"text":"ie mimoneñe am-patokisañe","poem":1},{"lineBreak":true},{"text":"marine’ azo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ko liera’o tsi-aman-tali’e ty ondaty","poem":1},{"lineBreak":true},{"text":"tsy nanjoam-boiñe.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ko tsikirihe’o t’indaty piaroteñe","poem":1},{"lineBreak":true},{"text":"vaho ko joboñe’o o sata’eo;","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"tiva am’ Iehovà ty mengoke;","poem":1},{"lineBreak":true},{"text":"fe itraofa’e safiry ty vantañe.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nafà’ Iehovà ty akiba’ o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"fe tahie’e ty kivoho’ o vantañeo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Toe ati’e o mpanitseo,","poem":1},{"lineBreak":true},{"text":"fe isohe’e ty mpireke.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Handova hasiñe o mahihitseo, fa onjone’ o seretseo ka ty mahasalatse.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Iob 3:11-12, Heb 12:5-6","reference":{"chapter":3,"verse":12}},{"noteId":3,"caller":"+","text":"ze vatosoa","reference":{"chapter":3,"verse":15}}]},"thisChapterLink":"/api/tdx_sle/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}