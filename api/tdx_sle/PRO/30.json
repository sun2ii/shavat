y nahatontoñe o tiokeo","poem":1},{"lineBreak":true},{"text":"an-taña’e mivokeñe?","poem":1},{"lineBreak":true},{"text":"Ia ty nañolonkoloñe o ranoo","poem":1},{"lineBreak":true},{"text":"an-tsaro’e ao?","poem":1},{"lineBreak":true},{"text":"Ia ty nampijadoñe o hene olon-taneo?","poem":1},{"lineBreak":true},{"text":"Ia ty tahina’e,","poem":1},{"lineBreak":true},{"text":"naho ty tahinan’ana’e? Naho fohi’o!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fonga niventeñe o tsaran’ Añahareo;","poem":1},{"noteId":16},{"lineBreak":true},{"text":"ie fikalañe amo mitsolok’ ama’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko tovoña’o o tsara’eo","poem":1},{"noteId":17},{"text":",","poem":1},{"lineBreak":true},{"text":"fa ho trevohe’e,","poem":1},{"lineBreak":true},{"text":"vaho ho zoeñe t’ie bodiake.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Roe ty raha ihalaliako ama’o;","poem":1},{"lineBreak":true},{"text":"ko ifoneña’o ampara’ ty hivetrahako:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ahankaño amako ze vande","poem":1},{"lineBreak":true},{"text":"naho haremborake,","poem":1},{"lineBreak":true},{"text":"le ko atolots’ahy ndra hararahañe","poem":1},{"lineBreak":true},{"text":"ndra varabey,","poem":1},{"lineBreak":true},{"text":"fahano ahy ty anjarako,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tsy mone ho vontsin-draho","poem":1},{"lineBreak":true},{"text":"vaho hitety Azo, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Ia ze o Iehovà zao?","poem":1},{"lineBreak":true},{"text":"ke ho rarake iraho naho hampikametse,","poem":1},{"lineBreak":true},{"text":"vaho hitera ty tahinan’ Añahareko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko fosà’o ami’ty tompo’e","poem":1},{"lineBreak":true},{"text":"ty mpitoroñe,","poem":1},{"lineBreak":true},{"text":"kera hamatse azo re,","poem":1},{"lineBreak":true},{"text":"vaho ho voa-hakeo irehe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Eo ty tariratse mitety an-drae,","poem":1},{"lineBreak":true},{"text":"naho tsy mitata rene;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ty taminga malio amo maso’eo","poem":1},{"lineBreak":true},{"text":"fe mboe tsy nisasa ami’ty haleora’e,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ty tariratse mievoñevoñe amo maso’eo","poem":1},{"lineBreak":true},{"text":"—akore ty fiandra’ o holi-maso’eo!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eo ty taminga hanam-pibara ho famotsi’e","poem":1},{"lineBreak":true},{"text":"naho meso ho vaza’e,","poem":1},{"lineBreak":true},{"text":"hampibotsek’ o misotry an-tane atoio,","poem":1},{"lineBreak":true},{"text":"naho o rarake am’ondatio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Roe ty anake vave’ ty oletse,","poem":1},{"lineBreak":true},{"text":"‘meo, meo.’","poem":1},{"lineBreak":true},{"text":"Telo ty raha mitolom-piereñe:","poem":1},{"lineBreak":true},{"text":"efatse ty tsy mahafivola ty hoe:","poem":1},{"lineBreak":true},{"text":"‘eneñe izay!’","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsy mahafivola ty hoe: ‘Soa izay’","poem":1},{"lineBreak":true},{"text":"ty tsikeokeoke, i beitsiterake,","poem":1},{"lineBreak":true},{"text":"i tane tsy enen-dranoy,","poem":1},{"lineBreak":true},{"text":"vaho ty afo","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty maso miteratera rae,","poem":1},{"lineBreak":true},{"text":"tsy mete avoho-drene,","poem":1},{"lineBreak":true},{"text":"ho tsimohe’ o koàke am-bavataneo,","poem":1},{"lineBreak":true},{"text":"vaho habotse’ ty tsimalaho tora’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Telo ty raha loho mahalatsa ahy,","poem":1},{"lineBreak":true},{"text":"efatse ty tsy rendreko;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ty liam-bantio an-dindiñe eñe,","poem":1},{"lineBreak":true},{"text":"ty lia’ ty mereñe an-damilamy eo,","poem":1},{"lineBreak":true},{"text":"ty lala’ o sambo añivo riakeo,","poem":1},{"lineBreak":true},{"text":"vaho ty sata’ ondaty ami’ty somondrara.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Zao ty satan-karapilo:","poem":1},{"lineBreak":true},{"text":"Mihinañe re naho mamò-bava","poem":1},{"lineBreak":true},{"text":"vaho manao ty hoe:","poem":1},{"lineBreak":true},{"text":"‘Izaho tsy nanao raty.’","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ambane’ raha telo","poem":1},{"lineBreak":true},{"text":"ty mampañezeñezeñe i taney,","poem":1},{"lineBreak":true},{"text":"ambane’ ty efatse re tsy mahaleo:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ambane’ i trètreke","poem":1},{"lineBreak":true},{"text":"t’ie ty mpanjaka,","poem":1},{"lineBreak":true},{"text":"vaho ty dagola, t’ie etsa-kaneñe,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ambane’ ty rakemba tsy kokoañe","poem":1},{"lineBreak":true},{"text":"t’ie engaen-dahy,","poem":1},{"lineBreak":true},{"text":"vaho ty anak-ampatañe","poem":1},{"lineBreak":true},{"text":"mandova aman-drakemba’e.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Efatse ty raha kede’ ty tane toy,","poem":1},{"lineBreak":true},{"text":"songa mahihitse:","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Foko tsy maozatse o vitikeo,","poem":1},{"lineBreak":true},{"text":"fe halankañe’e ami’ty asara ty haneñe;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"fifokoa tsy fatratse o trandrakeo,","poem":1},{"lineBreak":true},{"text":"fe mpandranjy traño am-bato ao;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"tsy amam-panjàka o valalao,","poem":1},{"lineBreak":true},{"text":"fe mirodo ki-pirimbo-ki-pirimboñe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mete tsepahem-pitàñe ty tsàtsake,","poem":1},{"lineBreak":true},{"text":"f’ie añ’anjombam-panjaka ao.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Telo ty raha midoegadoega:","poem":1},{"lineBreak":true},{"text":"efatse ty mitoandratoandra:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ty liona, ie maozatse amo biby iabio,","poem":1},{"lineBreak":true},{"text":"tsy eo ty itsolofiña’e;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"i akoholahiy","poem":1},{"noteId":18},{"text":", naho ty oselahy,","poem":1},{"lineBreak":true},{"text":"vaho ty mpanjaka miatreke","poem":1},{"lineBreak":true},{"text":"i valobohòn-dahindefo’ey.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Naho nanao hagegean-drehe","poem":1},{"lineBreak":true},{"text":"nañonjom-batañe, ke nikilily,","poem":1},{"lineBreak":true},{"text":"le tehafo am-pitàñe ty falie’o.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Toe miova ho dibera","poem":1},{"lineBreak":true},{"text":"ty ronono trobotroboeñe,","poem":1},{"lineBreak":true},{"text":"naho mahatontom-piantsonañe","poem":1},{"lineBreak":true},{"text":"te komondroeñe,","poem":1},{"lineBreak":true},{"text":"vaho mampiforoforo haviñerañe","poem":1},{"lineBreak":true},{"text":"t’ie troboeñe.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"ndra ty hoe: Mokotse iraho ry A’hare, vaho midazidazìtse","reference":{"chapter":30,"verse":1}},{"noteId":16,"caller":"+","text":"Sab 12:6, 18:30","reference":{"chapter":30,"verse":5}},{"noteId":17,"caller":"+","text":"Its 4:2 12:32, Ben 22:18-19","reference":{"chapter":30,"vers