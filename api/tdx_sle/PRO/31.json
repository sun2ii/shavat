{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Ty enta’ i Lemoela Mpanjaka,","poem":1},{"lineBreak":true},{"text":"ty onin-drehake ­nanaren-drene’e aze:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anhan ry anako!","poem":1},{"lineBreak":true},{"text":"Anhan ry anake tañ’ ovako ao!","poem":1},{"lineBreak":true},{"text":"Anhan ry anako nafantoko!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko atolo’o aman’ ampela ty haozara’o,","poem":1},{"lineBreak":true},{"text":"ndra amo mpandrotsake mpanjakao o sata’oo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy mañeva ty mpanjaka, ry Lemoela,","poem":1},{"lineBreak":true},{"text":"tsy sazo’ i mpanjakay ty mikama divay,","poem":1},{"lineBreak":true},{"text":"ndra o mpamelek’ arivoo","poem":1},{"lineBreak":true},{"text":"ty hilelalela toake;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kera hinoñe naho handikoke i liliy","poem":1},{"lineBreak":true},{"text":"vaho hañamengoke","poem":1},{"lineBreak":true},{"text":"ty zo’ o anan-kasotriañeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anjotsò toake ty heta’e,","poem":1},{"lineBreak":true},{"text":"vaho divay ty voretra añ’arofo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"angao hinon-dre","poem":1},{"lineBreak":true},{"text":"hañaliñoa’e ty hararaha’e,","poem":1},{"lineBreak":true},{"text":"tsy ho tiahy ka o hasotria’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manokafa falie hisolo ty moañe,","poem":1},{"lineBreak":true},{"text":"ho ami’ty zo’ o anam-pamàrañe iabio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manokafa falie","poem":1},{"lineBreak":true},{"text":"vaho mizakà an-kahiti’e;","poem":1},{"lineBreak":true},{"text":"ambeno ty zo’ o rarake naho mavomavoo.","poem":1}]},{"type":"heading","content":["Figadoña’e: Tolorañ’Asy ty Rakemba31:10 milahatse ami’ty abode hebreo ty 10-31."]},{"type":"verse","number":10,"content":[{"text":"Ia ty mahaonin-drakemba mañeva?","poem":1},{"lineBreak":true},{"text":"Ie sarotse te amo safirao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Atokisa’ ty trom-bali’e,","poem":1},{"lineBreak":true},{"text":"ie tsy ho po-vara.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hasoa’e fa tsy mañànto,","poem":1},{"lineBreak":true},{"text":"amy ze hene andro fiveloma’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paia’e ty volon-añondry","poem":1},{"lineBreak":true},{"text":"naho ty vinda,","poem":1},{"lineBreak":true},{"text":"vaho an-kafaleañe ty ifanehafa’e am-pitàñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manahake o lakam-pañondrañeo,","poem":1},{"lineBreak":true},{"text":"boak’añe ty añandesa’e mahakama.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mitroatse te mbe haleñe,","poem":1},{"lineBreak":true},{"text":"hamahañe o keleia’eo,","poem":1},{"lineBreak":true},{"text":"vaho handiva amo anak’ ampata’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ereñerè’e ty teteke vaho vilie’e;","poem":1},{"lineBreak":true},{"text":"ambolea’e tanem-­bahe ami’ty vokam-pità’e.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Midian-kafatrarañe,","poem":1},{"lineBreak":true},{"text":"naho ampaozare’e o sira’eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Oni’e te soa o balibalie’eo,","poem":1},{"lineBreak":true},{"text":"tsy mikipe haleñe i failo’ey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"An-dravem-pità’e ty fañareta’e,","poem":1},{"lineBreak":true},{"text":"le tana’e an-delam-pità’e ty antsòli’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Velare’e amo rarakeo ty sira’e,","poem":1},{"lineBreak":true},{"text":"vaho ahiti’e amo mavomavoo o fita’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy hembaña’e i fanalay","poem":1},{"lineBreak":true},{"text":"amo keleia’eo;","poem":1},{"lineBreak":true},{"text":"fa songa misiki-mañabasà o ana’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Anjaira’e saroñe ty vata’e,","poem":1},{"lineBreak":true},{"text":"hene leny naho malòmavo o siki’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fohiñe an-dalam-bey eo ty vali’e,","poem":1},{"lineBreak":true},{"text":"ie mitrao-piambesatse","poem":1},{"lineBreak":true},{"text":"amo androanavi’ i taneio.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mitenoñe lamba leny re vaho aleta’e,","poem":1},{"lineBreak":true},{"text":"tolora’e sokotry o mpanao takinakeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Haozarañe naho havantañañe","poem":1},{"lineBreak":true},{"text":"ro fisiki’e, itohafa’e ty ho avy.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Sokafe’e an-kihitse ty falie’e,","poem":1},{"lineBreak":true},{"text":"le fañòham-patarihañe","poem":1},{"lineBreak":true},{"text":"ty am-pivimbi’e eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Halahalae’e soa o satan-keleia’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsy kamae’e ty mofon-kavotroañe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Miongake o ana’eo ­mañandriañ’ aze,","poem":1},{"lineBreak":true},{"text":"naho mandrenge aze i valie’ey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Maro ty ampela manao soa,","poem":1},{"lineBreak":true},{"text":"fe fonga ilikoara’o.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mpamañahy ty hasoa vintañe,","poem":1},{"lineBreak":true},{"text":"kòake ty hamotramotràñe,","poem":1},{"lineBreak":true},{"text":"fe rengèñe ty rakemba mañeveñe","poem":1},{"lineBreak":true},{"text":"am’ Iehovà.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Atoloro aze ty havokaram-pità’e!","poem":1},{"lineBreak":true},{"text":"le handrenge aze an-dalam-bey eo","poem":1},{"lineBreak":true},{"text":"o sata’eo.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}