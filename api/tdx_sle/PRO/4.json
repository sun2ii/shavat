{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Fañòhan-dRoae"]},{"type":"verse","number":1,"content":[{"text":"Tsanoño ry anake, ty fanoroan-drae, itsendreño hahazoa’ areo hilala;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"fa nanolorako fiohan-tsoa:","poem":1},{"lineBreak":true},{"text":"aa le ko apo’ areo ty Fañòhako","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Izaho anadahin-draeko, nitrotrotrotro, bako tokañe ampahaisahan-dreneko,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"le nanareñe ahy ty hoe:","poem":1},{"lineBreak":true},{"text":"ampifaharo an-tro’o ao o entakoo;","poem":1},{"lineBreak":true},{"text":"tambozoro o lilikoo hiveloma’o","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manaña hihitse; mitohà hilala:","poem":1},{"lineBreak":true},{"text":"ko mañaliño,","poem":1},{"lineBreak":true},{"text":"vaho ko miamboho","poem":1},{"lineBreak":true},{"text":"amo volam-bavakoo;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko apo’o, le harova’e;","poem":1},{"lineBreak":true},{"text":"ikokò, le hambena’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hihitse ty lohà’e,","poem":1},{"lineBreak":true},{"text":"aa le manàña hihitse,","poem":1},{"lineBreak":true},{"text":"eka, mangalà hilala","poem":1},{"lineBreak":true},{"text":"amy ze hene famoria’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Onjono re le honjone’e irehe;","poem":1},{"lineBreak":true},{"text":"hiasia’e te fihine’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hampihamine’e voñe vinanditse","poem":1},{"lineBreak":true},{"text":"an-doha’o,","poem":1},{"lineBreak":true},{"text":"ho tolora’e sabaka fanjàka.","poem":1}]},{"type":"heading","content":["Ko Enga’o ty Lalan-kato"]},{"type":"verse","number":10,"content":[{"text":"Mitsanoña ahy, anake,","poem":1},{"lineBreak":true},{"text":"vaho iantofo o entakoo,","poem":1},{"lineBreak":true},{"text":"hañamaroañe ty taon-kavelo’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa nitalifirako mb’an-dalan-kihitse; naho nitehafeko","poem":1},{"lineBreak":true},{"text":"mb’amo lalan-kavantañañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie mitsontike,","poem":1},{"lineBreak":true},{"text":"tsy ho sebañeñe o lia’oo;","poem":1},{"lineBreak":true},{"text":"ihe milay, tsy hitsikapy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vontitiro ty anatse le ko apo’o, ambeno amy t’ie ro havelo’o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ko mitsile mb’añ’oloñolo’ o lo-tserekeo vaho ko andenà’o ty lala’ o tsivokatseo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ihankaño, ko miary eo,","poem":1},{"lineBreak":true},{"text":"iholiaro vaho mihelaña.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie tsy miroro hey","poem":1},{"lineBreak":true},{"text":"naho tsy mandilatse;","poem":1},{"lineBreak":true},{"text":"tinavañ’ am’iereo ty firotse","poem":1},{"lineBreak":true},{"text":"ampara’ te mitsikapy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fihina’ iereo ty lintsen-karatiañe","poem":1},{"lineBreak":true},{"text":"vaho genohe’ iereo ty divain-kasiahañe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Manahake ty hazavà’","poem":1},{"lineBreak":true},{"text":"i manjirik’ àndroy","poem":1},{"lineBreak":true},{"text":"ty lala’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"ie mihamazava erike ampara’","poem":1},{"lineBreak":true},{"text":"te mipisañe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hoe fimoromoroñañe","poem":1},{"lineBreak":true},{"text":"ty lala’ o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"ie tsy maharendreke te mahatsikapy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O anake, tsendreño o fivolakoo;","poem":1},{"lineBreak":true},{"text":"anokilaño sofy o lañonakoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ko enga’o hihake amo maso’oo; f’ie ahajao an-tro’o ao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amy t’ie haveloñe amo maharendrekeo,","poem":1},{"lineBreak":true},{"text":"toe fijanganañe ho an-tsandri’iareo iaby.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ambeno am-pilozohañe ty tro’o,","poem":1},{"lineBreak":true},{"text":"fa boak’ama’e","poem":1},{"lineBreak":true},{"text":"o fanganahanan-dranon-kaveloñeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Asioro ama’o ty vava mengoke,","poem":1},{"lineBreak":true},{"text":"vaho ihankaño o soñy mikelokeo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ampañenteo mahity o maso’oo,","poem":1},{"lineBreak":true},{"text":"vaho ampivantaño mañaolo","poem":1},{"lineBreak":true},{"text":"o holi-maso’oo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Jilovo ty fombàn-tombo’o, le hijadoñe soa o lia’oo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ko mivio mb’an-kavana","poem":1},{"lineBreak":true},{"text":"ndra mb’ankavia;","poem":1},{"lineBreak":true},{"text":"fa ampandifiho ty raty o tombo’oo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}