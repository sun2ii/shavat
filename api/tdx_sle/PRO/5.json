{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Hatahata amo Haleorañeo"]},{"type":"verse","number":1,"content":[{"text":"O anake, tsendreño ty hihiko;","poem":1},{"lineBreak":true},{"text":"atokilaño mb’am-pahilalako ty sofi’o,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"hifejaña’o ty filie-batañe, naho hañaja hilala o soñi’oo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mitsopa-tantele ty soñin-tsimirirañe,","poem":1},{"lineBreak":true},{"text":"vaho malama te amo solikeo ty vava’e;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"f’ie mafaitse te amo vahon-tsoiñeo am-para’e,","poem":1},{"lineBreak":true},{"text":"masioñe hoe fibara sambe-lela’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mizotso mb’am-pikoromaham-beo","poem":1},{"lineBreak":true},{"text":"o tombo’eo,","poem":1},{"lineBreak":true},{"text":"mitalifitse mb’an-tsikeokeok’ ao ty lia’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy haraharae’e i lalan-kaveloñey; mihelahela o lala’eo, fe amoea’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa le mitsanoña ahy henaneo ry anake, vaho ko mivike amo entam-bavakoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ahankaño lavits’ aze ty lala’o,","poem":1},{"lineBreak":true},{"text":"vaho ko itotofa’o ty sariran-akiba’e;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tsy mone hatolo’o ami’ty ila’e ty enge’o,","poem":1},{"lineBreak":true},{"text":"naho o tao’oo amy mifajifajiy,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mbore hampibo­boke ty ambahiny","poem":1},{"lineBreak":true},{"text":"ty haozara’o,","poem":1},{"lineBreak":true},{"text":"vaho mb’añ’akiba’ ty alik’ama’o","poem":1},{"lineBreak":true},{"text":"o nimokora’oo;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hiñeoñeon-drehe","poem":1},{"lineBreak":true},{"text":"añ’andron-kònka’o,","poem":1},{"lineBreak":true},{"text":"ie mihomake ty nofo’o naho ty sandri’o,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Akore te nalaim-pandilovan-draho,","poem":1},{"lineBreak":true},{"text":"naho niheje’ ty troko o endakeo!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy nitsendreñeko ty fiarañanaña’","poem":1},{"lineBreak":true},{"text":"o mpañanakoo,","poem":1},{"lineBreak":true},{"text":"tsy nanokilañako sofiñe","poem":1},{"lineBreak":true},{"text":"o mpañoke ahikoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa an-titotse ho nianto iraho,","poem":1},{"lineBreak":true},{"text":"añivo’ ty fivory naho i valobohòkey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Minoma rano an-kadaha’o avao","poem":1},{"lineBreak":true},{"text":"rano midoañe boak’an-tatefatse’o ao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hienene mb’an-dalambey mb’eo hao","poem":1},{"lineBreak":true},{"text":"ty rano’o migoangoañeo?","poem":1},{"lineBreak":true},{"text":"rano hitsiritsiok’ an-damoke eo?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ehe t’ie azo,","poem":1},{"lineBreak":true},{"text":"fa ko andiva’o ami’ty ambahiny.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho soa-tata ty fipotitiaha’o,","poem":1},{"lineBreak":true},{"text":"vaho irebeho ty valin-katora’o.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hirañe mikoko re,","poem":1},{"lineBreak":true},{"text":"renen-kira maintelèñe—","poem":1},{"lineBreak":true},{"text":"hampaheneñe azo nainai’e o fatroa’eo,","poem":1},{"lineBreak":true},{"text":"i fikokoa’ey avao ty hilosora’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Akore, anake, t’ie tsepahe’ ty karapilo?","poem":1},{"lineBreak":true},{"text":"naho fihine’ ty arañan’ ambahiny?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sindre añatrefam-pihaino’ Iehovà","poem":1},{"lineBreak":true},{"text":"o lala’ ondatio,","poem":1},{"lineBreak":true},{"text":"Songa tsikarahe’e o lalan-tsile’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho fandrihe’ ty hatsivokara’e","poem":1},{"lineBreak":true},{"text":"ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"vaho hamihiñe aze am-bahotse","poem":1},{"lineBreak":true},{"text":"o hakeo’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hikenkan-dre fa po-hilala,","poem":1},{"lineBreak":true},{"text":"ty halosoran-kagegea’e ty hampivike aze.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}