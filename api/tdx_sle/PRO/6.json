{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Hatahata amo Hagegeañeo"]},{"type":"verse","number":1,"content":[{"text":"O anake, ie nampipok’ antoke am’ondatio,","poem":1},{"lineBreak":true},{"text":"lehe nañoho-pitàñe hitsoake","poem":1},{"lineBreak":true},{"text":"ty ambahiny,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ie finandri’ ty entan-tsoñi’o, vinandibandi’ ty fireham-bava’o,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ano zao, ty anake toke: Mivotsora, ie fa nihotrak’ am-pità’ ondatio: akia, mireha ama’e,","poem":1},{"lineBreak":true},{"text":"imaneo halaly indatiy!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ampifoneño roro o maso’oo, tsy hidrodreke o vohomaso’oo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mibolitira hoe hirañe an-tañañe,","poem":1},{"lineBreak":true},{"text":"naho hoe kibo am-pitàm-pikehe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Akia mb’ami’ty vitike, ry tembo,","poem":1},{"lineBreak":true},{"text":"haraharao o sata’eo vaho mahihira!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie tsy amam-pifehe, tsy amam-pisary,","poem":1},{"lineBreak":true},{"text":"tsy amam-pandily,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"fe kotepè’e ami’ty asara ty hane’e,","poem":1},{"lineBreak":true},{"text":"vaho atonto’e am-pitatahañe","poem":1},{"lineBreak":true},{"text":"o lintse’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pak’ ombia irehe te mbe hitozoke,","poem":1},{"lineBreak":true},{"text":"ty mpitsorotake tia?","poem":1},{"lineBreak":true},{"text":"Ombia t’ie hitroatse amy firoroa’o?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mikonkòñe kedeke, miroro tsi-ampe, mifehefare hitofa’o heike:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"le hiambotraha’ ty hararahañe","poem":1},{"lineBreak":true},{"text":"hoe malaso,","poem":1},{"lineBreak":true},{"text":"vaho ty hapoiañe hoe lahifihaty.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ty lahi-tembo naho i lahiaga:","poem":1},{"lineBreak":true},{"text":"i mpañariok’ am-bava vìlañey,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ami’ty maso mipie,","poem":1},{"lineBreak":true},{"text":"an-tomboke mitsao tane,","poem":1},{"lineBreak":true},{"text":"an-drambo-taña manondrotondro,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ie am-pikitrohan-draty an-tro’e nainai’e, ro mbore mikilily,","poem":1},{"lineBreak":true},{"text":"mitolom-pamitse fifalaiñañe;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le, hiambotraha’ ty hankàñe","poem":1},{"lineBreak":true},{"text":"ami’ty manao zao le ho demoke","poem":1},{"lineBreak":true},{"text":"tsy lefe jangañeñe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Eneñe ty raha heje’ Iehovà, Eka, fito ro tiva ama’e:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ty fihaino mievoñevoñe,","poem":1},{"lineBreak":true},{"text":"ty fameleke mandañitse,","poem":1},{"lineBreak":true},{"text":"ty fitàñe mampiori-dio-maly,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ty troke mikitro-karatiañe, ty fandia mifajifajy mb’an-katsivokarañe,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ty mpitalily vilañe, mikofòke lañitse, naho ty mampiboele fifankalaiñañe an-drolongo’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O anake, ambeno ty lilin-drae’o,","poem":1},{"lineBreak":true},{"text":"vaho ko apo’o ty fañòhan-drene’o.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ifeheo an-tro’o ao nainai’e; rohizo am-bozo’o eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hiaoloa’e te mijelanjelañe, ie màndre, hambena’e;","poem":1},{"lineBreak":true},{"text":"tsekake le ivesovesoa’e.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Toe failo o lilio,","poem":1},{"lineBreak":true},{"text":"naho hazavàñe t’i Hake","poem":1},{"noteId":4},{"text":", vaho lalan-kaveloñe o endake fanoroañeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hikalañe azo tsy homb’ amy tsimirirañey, ami’ty lela-malama’ i karapiloy.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ko irie’o an-troke","poem":1},{"lineBreak":true},{"text":"ty hamontramontra’e,","poem":1},{"lineBreak":true},{"text":"asoao tsy ho tsepahe’ ty vohomaso’e.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Vonga-mofo ty tamben-tsimirirañe,","poem":1},{"lineBreak":true},{"text":"fa naho vali’ ondaty,","poem":1},{"lineBreak":true},{"text":"le i fiaiñe sarotsey ty itsindroha’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Naho otroñe’ ondaty añ’araña’e ao ty afo,","poem":1},{"lineBreak":true},{"text":"tsy hirehetse hao ty saro’e ?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mete lia’ondaty hao ty vae mirekake,","poem":1},{"lineBreak":true},{"text":"tsy hahamae’ o fandia’eo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Izay ty fifandian-tihy","poem":1},{"lineBreak":true},{"text":"ami’ty vali’ ondaty:","poem":1},{"lineBreak":true},{"text":"tsy mete tsy liloveñe ty mitsapa aze.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tsy injè’ ondatio ty mpampikametse","poem":1},{"lineBreak":true},{"text":"te mikizo hampahaeneñe ty fiai’e saliko,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"fa ndra ie, naho tsepake,","poem":1},{"lineBreak":true},{"text":"ro hañavake im-pito,","poem":1},{"lineBreak":true},{"text":"fonga hondroha’e ze vara añ’akiba’e ao.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Akore ty hagegea’ ty mañarapilo","poem":1},{"lineBreak":true},{"text":"an-drakemba:","poem":1},{"lineBreak":true},{"text":"fa sata’ ty handrotsa-batañe.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Vono-troboke naho hasalarañe ty ho zoe’e, vaho tsy ho faopaoheñe ka i inje’ey.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mampiforoforo ondaty ty famarahiañe, tsy hapo’e amy andro hamalea’e fatey.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Tsy handrambesa’e ondroke,","poem":1},{"lineBreak":true},{"text":"tsy mahatèke aze","poem":1},{"lineBreak":true},{"text":"t’ie ampitoboroñan-dravoravo.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Sab 119:105","reference":{"chapter":6,"verse":23}}]},"thisChapterLink":"/api/tdx_sle/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}