{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Fisarihan-tsie Kanao Vali’Ondaty"]},{"type":"verse","number":1,"content":[{"text":"O anake, ambeno o entakoo,","poem":1},{"lineBreak":true},{"text":"vaho akafiro ama’o ao o fepèkoo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fejaño o lilikoo vaho miveloma,","poem":1},{"lineBreak":true},{"text":"naho i Fañòhakoy","poem":1},{"lineBreak":true},{"text":"manahake ty sainte maso’o;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Arohizo an-drambon-taña’o, sokiro an-takelan-tro’o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anò ty hoe ty hihitse;","poem":1},{"lineBreak":true},{"text":"Rahavaveko irehe; vaho tokavo ty hoe:","poem":1},{"lineBreak":true},{"text":"Rañetse, ty hilala,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"hikalaña’ iareo azo","poem":1},{"lineBreak":true},{"text":"tsy ho ami’ty tsimirirañe,","poem":1},{"lineBreak":true},{"text":"tsy ho amy ambahiny malama firehakey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Izaho an-dalan-keden-akibako ao nitilihitse an-tsingarakarake,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"naho nisamba añivo’ o trentrañeo,","poem":1},{"lineBreak":true},{"text":"nijiloveko an-­teñateña’ o gaon-dahio,","poem":1},{"lineBreak":true},{"text":"ty ajalahy tsy aman-dron-doha,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nitsake ty lalañe mioza an-kotso’e mb’eo,","poem":1},{"lineBreak":true},{"text":"vaho nikopile mb’an-dalan-tsileke mb’añ’akiba’e mb’eo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"am-palipalitsieñe, ie ni-hariva ty andro,","poem":1},{"lineBreak":true},{"text":"amy haien-kaleñe nimoromoroñey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Le heheke ty rakemba mifanalaka ama’e, mihamiñe hoe tsimirirañe,","poem":1},{"lineBreak":true},{"text":"hakalitahañe ty an-tro’e ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie mitazataza naho miola,","poem":1},{"lineBreak":true},{"text":"tsy mimoneñe añ’akiba’e ao o tombo’eo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"mbore an-dalañey, mbore an-kiririsa,","poem":1},{"lineBreak":true},{"text":"mijeke amy ze atao fitsileañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fejañe’e i lahiy naho orofa’e","poem":1},{"lineBreak":true},{"text":"vaho anoe’e ty hoe an-tarehe miriñake:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amako ty soron-kanintsiñe vaho navahako anindroany o nifantàkoo;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"aa le niakatse iraho hifañaoñan-tika,","poem":1},{"lineBreak":true},{"text":"hitsoehako ty tarehe’o;","poem":1},{"lineBreak":true},{"text":"heheke te tendreke.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa nilafihako i tihikoy, an-deny maviabiake boak’ e Mitsraime.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa namitsezako rame","poem":1},{"noteId":5},{"text":"ty fandreako,","poem":1},{"lineBreak":true},{"text":"voñem-bahoñe naho romba","poem":1},{"noteId":6},{"text":".","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Antao ito higenoke ty hatea","poem":1},{"lineBreak":true},{"text":"ampara’ te porea’ ty maraindray;","poem":1},{"lineBreak":true},{"text":"antato hifalefale an-katea.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy añ’anjomba ao ty valiko,","poem":1},{"lineBreak":true},{"text":"fa nifokofoko añe,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ninday drala an-koroñe, vaho tsy himpoly naho tsy zava-volañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"An-tsiriry maro ty anigiha’e;","poem":1},{"lineBreak":true},{"text":"an-tsoñi’e mamolavola","poem":1},{"lineBreak":true},{"text":"ty anjira’e aze.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Orihe’ i ajalahiy amy zao,","poem":1},{"lineBreak":true},{"text":"misìtse mb’eo hoe añombe ho lentañe,","poem":1},{"lineBreak":true},{"text":"hoe ty gege an-dongòke ho liloveñe,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ampara’ te trofahañ’ ana-pale ty ate’e;","poem":1},{"lineBreak":true},{"text":"hoe kibo mibororoñe","poem":1},{"lineBreak":true},{"text":"mb’am-palàñe mb’eo,","poem":1},{"lineBreak":true},{"text":"amoea’e t’ie famoeam-piay.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie amy zao ry anakoo, tsanoño iraho, vaho tsendreño ty entam-bavako.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ko ado’o hivio mb’an-dala’e mb’eo ty tro’o;","poem":1},{"lineBreak":true},{"text":"ko mandifike mb’añ’oloñolo’e mb’eo;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"amy te maro ty tsinipo’e nifotsake,","poem":1},{"lineBreak":true},{"text":"vaho tsifotofoto o navetra’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Minday mb’an-Tsikeokeoke mb’eo","poem":1},{"lineBreak":true},{"text":"ty akiba’e,","poem":1},{"lineBreak":true},{"text":"mizotso mb’añ’ akiban-kavilasy ao.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Heb: more, boak’ ami’ty hoe mire","reference":{"chapter":7,"verse":17}},{"noteId":6,"caller":"+","text":"Heb: kinamone","reference":{"chapter":7,"verse":17}}]},"thisChapterLink":"/api/tdx_sle/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}