{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Ty Falalà’ i Hihitse"]},{"type":"verse","number":1,"content":[{"text":"Tsy mikoike hao ty hihitse,","poem":1},{"lineBreak":true},{"text":"tsy mañonjom-piarañanañañe hao","poem":1},{"lineBreak":true},{"text":"ty hilala?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"An-kaboañe ey, añ’olon-dalañe eo, am-pitsileañe eo ty ijohaña’e;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"añ’ilan-dalam-bein-tsariran-drova eo","poem":1},{"lineBreak":true},{"text":"ami’ty fiziliha’ o lalam-beio","poem":1},{"lineBreak":true},{"text":"ty ikoha’e ty hoe:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ry ondatio, ikanjiako,","poem":1},{"lineBreak":true},{"text":"ty feoko mb’amo ana’ ondatio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ry trentrañeo, mioha hakarafitoañe;","poem":1},{"lineBreak":true},{"text":"naho, ry seretseo, mandrendreha an-troke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitsanoña hitaroñako raha","poem":1},{"lineBreak":true},{"text":"aman-kasiñe;","poem":1},{"lineBreak":true},{"text":"vaho hañakatse volam-bantañe","poem":1},{"lineBreak":true},{"text":"kanao misokake o soñikoo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hivolan-katò ty vavako;","poem":1},{"lineBreak":true},{"text":"fa tiva amo soñikoo o haratiañeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Songa mahity o entam-bavakoo,","poem":1},{"lineBreak":true},{"text":"tsy ama’e ty mikeloke","poem":1},{"lineBreak":true},{"text":"ndra mengoke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie vantañe amy mahihitsey vaho mahity ami’ty maha-onin-kilala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rambeso o fañòhakoo, fa tsy volafoty; naho ty hilala fa tsy volamena nitsoheñe;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa lombolombo’ o hangeo ty hihitse,","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty salalaeñe mañirinkiriñ’aze.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Izaho, hihitse, ro miharo-toboke","poem":1},{"lineBreak":true},{"text":"ami’ty filieram-batañe,","poem":1},{"lineBreak":true},{"text":"vaho manjo hilala naho fitalifirañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Malain-karatiañe ty fañeveñañe am’ Iehovà.","poem":1},{"lineBreak":true},{"text":"hejeko ty firengeañe, ty fibohabohañe,","poem":1},{"lineBreak":true},{"text":"ty satan-karatiañe, naho ty vava mitera.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amako ty fanoroañe,","poem":1},{"lineBreak":true},{"text":"naho ty hihitse do’e,","poem":1},{"lineBreak":true},{"text":"Izaho o hilalao; ahy o haozarañeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Izaho ty ifehea’ o mpanjakao,","poem":1},{"lineBreak":true},{"text":"naho anoa’ o mpifeheo lily vantañe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Izaho ty ifeleha’ o mpifelekeo","poem":1},{"lineBreak":true},{"text":"naho o roandriañeo,","poem":1},{"lineBreak":true},{"text":"ze hene mpizaka-to.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kokoako ze mikoko ahiko, naho","poem":1},{"lineBreak":true},{"text":"handrèndrek’ ahy ze mitsoek’ ahy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Rekets’ amako ty vara naho ty asiñe;","poem":1},{"lineBreak":true},{"text":"hanàñañe tsy modo naho havañonañe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Soa te amo volamenao ty havokarako","poem":1},{"lineBreak":true},{"text":"eka ndra volamena ki’e,","poem":1},{"lineBreak":true},{"text":"vaho ambone’ ty volafoty jinoboñe","poem":1},{"lineBreak":true},{"text":"o firegoregoakoo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Manjotik’ an-dalam-bantan-draho,","poem":1},{"lineBreak":true},{"text":"añivo o oloñolon-kavantañañeo,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"hampandovàko vara o mpikoko ahio, naho hatseheko o kipondi’ iareoo.","poem":1}]},{"type":"heading","content":["I Hihitse tam-Pifotorañe añe8:22 Jaona 1.1-3; Its 30:4; Ko I 1:24,30"]},{"type":"verse","number":22,"content":[{"text":"Tsinene’ Iehovà raho","poem":1},{"lineBreak":true},{"text":"ho fifotoran-dala’e,","poem":1},{"lineBreak":true},{"text":"ty valoham-pitoloña’e haehae zay.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsietoimoneke izay ty nañorizañ’ ahiko,","poem":1},{"lineBreak":true},{"text":"tam-baloha’ey,","poem":1},{"lineBreak":true},{"text":"taolo te nioreñe ty tane toy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ie mboe tsy teo o lalekeo ty niterahañ’ ahy,","poem":1},{"lineBreak":true},{"text":"ie mboe tsy nidoadoañan-drano","poem":1},{"lineBreak":true},{"text":"o loharanoo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ie mboe tsy nipetake o vohitseo,","poem":1},{"lineBreak":true},{"text":"taolo o tambohoo, te naterake;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ie mboe tsy niforoñe’e ty tane toy","poem":1},{"lineBreak":true},{"text":"naho o hivokeo,","poem":1},{"lineBreak":true},{"text":"ndra ty deboke valoha’ ty tane toy.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ie nampijadoñe o likerañeo,","poem":1},{"lineBreak":true},{"text":"teo iraho,","poem":1},{"lineBreak":true},{"text":"Ie nanokitse ty bontoly","poem":1},{"lineBreak":true},{"text":"ami’ty tarehe’ i lalekey eñe,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ie natobe’e an-toe’e ey o likerañ’ amboneo,","poem":1},{"lineBreak":true},{"text":"naho nampitosire’e o loha-rano’ i làlekeio.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ie nifahera’e i riakey,","poem":1},{"lineBreak":true},{"text":"tsy handilara’ o ranoo i nandilia’ey;","poem":1},{"lineBreak":true},{"text":"ie tinendre’e o faha-ty tane toio,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Le nirekets’ ama’e iraho fa natokisañe, naho nampifaleako lomoñandro,","poem":1},{"lineBreak":true},{"text":"nainai’e nirebek’ aolo’e.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nihisa an-tanem-pimoneña’e","poem":1},{"lineBreak":true},{"text":"vaho nahaehak’ ahy o ana’ ondatio.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ie amy zao, ry anake, mitsendreña ahy:","poem":1},{"lineBreak":true},{"text":"Haha ze mañorike o lalakoo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mitsanoña fañòhañe","poem":1},{"lineBreak":true},{"text":"naho mahihira, vaho ko mifoneñe.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Haha t’indaty mitsendreñe ahy,","poem":1},{"lineBreak":true},{"text":"ty misary nainai’e an-dalam-beiko eo","poem":1},{"lineBreak":true},{"text":"mandiñe an-dahin-dalako eo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ze tendrek’ ahiko tendre-kaveloñe,","poem":1},{"lineBreak":true},{"text":"vaho tolora’ Iehovà fañisohañe;","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Fe ze losotse ahy mijoy vatañe;","poem":1},{"lineBreak":true},{"text":"fonga mikoko havilasy ze malaiñe ahy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}