{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PRO","translationId":"tdx_sle","name":"Razan-tSaontsy","commonName":"Razan-tSaontsy","title":"Razan-tSaontsy","order":20,"numberOfChapters":31,"sha256":"a4663a0c401c062914719ec409f24a23bf7c64780c6e9175b2b3c266f8e84460","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tdx_sle/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Ty Sabadidak’ i Hihitse"]},{"type":"verse","number":1,"content":[{"text":"Fa nandranjy i akiba’ey","poem":1},{"lineBreak":true},{"text":"t’i Hihitse, fa rinamerame’e i faha’e fito rey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa nandenta, fa linaro’e ty divai’e,","poem":1},{"lineBreak":true},{"text":"fa hinalanka’e i fandambaña’ey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nirahe’e o anak’ampata’eo,","poem":1},{"lineBreak":true},{"text":"hikaike boak’ an-digiligin-kaboa’","poem":1},{"lineBreak":true},{"text":"i rovay ey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O ry tahitahiñe, mitsilea mb’etoa!","poem":1},{"lineBreak":true},{"text":"le hoe re amy seretsey,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mb’etoa ikamao o hanekoo","poem":1},{"lineBreak":true},{"text":"naho inomo i divay linarokoy,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apoho ty hagegeañe naho miveloma,","poem":1},{"lineBreak":true},{"text":"mañaveloa an-dalan-kilala.","poem":1}]},{"type":"heading","content":["Anatse Ankababa’e"]},{"type":"verse","number":7,"content":[{"text":"Mizò inje ty mañendake mpanivetive;","poem":1},{"lineBreak":true},{"text":"tendreke joy ty mitrevoke ty lo-tsereke.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko mañendake ty mpamokafoka","poem":1},{"lineBreak":true},{"text":"hera halaiñ’azo;","poem":1},{"lineBreak":true},{"text":"Trevohe’o ty mahihitse le hikokoa’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anaro o mahihitseo","poem":1},{"lineBreak":true},{"text":"le hiha-mahihitse avao;","poem":1},{"lineBreak":true},{"text":"ampandrendreho ty vantañe","poem":1},{"lineBreak":true},{"text":"le hitombo an-kilala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ty fañeveñañe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ro fifotoran-kihitse,","poem":1},{"lineBreak":true},{"text":"vaho ty fahafohinañe i Masiñey","poem":1},{"lineBreak":true},{"text":"ro faharendrehañe","poem":1},{"noteId":7},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Izaho ty fampitomboañe o andro’oo, fampitompeañe taoñe o havelo’oo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie mahihitse, hañimbañ’ azo i hihitsey;","poem":1},{"lineBreak":true},{"text":"Ihe manivetive ty hivave izay.","poem":1}]},{"type":"heading","content":["Ty Fañambara’ i Dagola naho ty Fampitama’e"]},{"type":"verse","number":13,"content":[{"text":"Mamantsiñe ty rakemba gege,","poem":1},{"lineBreak":true},{"text":"ie tsotra tsy mahafohin-draha,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mitobok’ an-dalam-bein-akiba’e eo,","poem":1},{"lineBreak":true},{"text":"am-pitobohañe amo haboa’ i rovaio,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"mikaike ze miary eo,","poem":1},{"lineBreak":true},{"text":"amo mañavelo an-kavantañañeo:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O ry trentrañeo, mitsilea mb’etoa!","poem":1},{"lineBreak":true},{"text":"le hoe re amy tsy aman-kilalay:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mamy ty rano nikamereñe,","poem":1},{"lineBreak":true},{"text":"vaho mafiry ty mofo kamaeñe","poem":1},{"lineBreak":true},{"text":"añ’etak’ ao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fe tsy apota’e te lolo ty ao, te an-tsikeokeok’ ao o nampihovae’eo.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Rzs 1:7","reference":{"chapter":9,"verse":10}}]},"thisChapterLink":"/api/tdx_sle/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}