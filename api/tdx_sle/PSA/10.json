"lineBreak":true},{"text":"Miraorao nainai’e o sata’eo;","poem":1},{"lineBreak":true},{"text":"kanao mitiotiotse ambone,","poem":1},{"lineBreak":true},{"text":"tsy am-pahaisaha’e eo o fizakà’oo,","poem":1},{"lineBreak":true},{"text":"le fonga ibohaboha’e o malaiñ’ azeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe ty aereñeren-tro’e :","poem":1},{"lineBreak":true},{"text":"Tsy hasiotse iraho,","poem":1},{"lineBreak":true},{"text":"ndra an-tsa an-tsa tsy ho ampoheke ka.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pea hateràñe naho katramo","poem":1},{"lineBreak":true},{"text":"naho fisenge-hery i falie’ey;","poem":1},{"lineBreak":true},{"text":"kilily naho haloloañe","poem":1},{"lineBreak":true},{"text":"ty ambane’ i famele’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Itoboha’e o ­fivoñonañe an-drovao","poem":1},{"lineBreak":true},{"text":"amo fietahañeo","poem":1},{"lineBreak":true},{"text":"hamonoa’e ty vantañe;","poem":1},{"lineBreak":true},{"text":"jilojilovem-pihaino’e","poem":1},{"lineBreak":true},{"text":"ty tsy amam-pañimba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie mitingañe añetak’ ao","poem":1},{"lineBreak":true},{"text":"hoe liona ami’ty fitsifira’e;","poem":1},{"lineBreak":true},{"text":"mitampoñe hitsepake ty rarake,","poem":1},{"lineBreak":true},{"text":"hiambotrak’ ami’ty mpisotry,","poem":1},{"lineBreak":true},{"text":"hikozozota’e amy harato’ey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mibotreke re, mifinake;","poem":1},{"lineBreak":true},{"text":"vaho mikorovok’ amy figorea’ey","poem":1},{"lineBreak":true},{"text":"i pìtso-pañolotsey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe re an-troke ao :","poem":1},{"lineBreak":true},{"text":"Fa nandikofan’ Añahare,","poem":1},{"lineBreak":true},{"text":"fa naeta’e ty lahara’e; tsy ho vazoho’e ka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Miongaha ry Iehovà;","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare, zonjò ty Fità’o;","poem":1},{"lineBreak":true},{"text":"ko amoea’o o mpirekeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Akore te ati’ o tsivokatseo","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ie manao an-tro’e ao ty hoe :","poem":1},{"lineBreak":true},{"text":"Tsy ipaia’e?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Toe vazoho’o; eka fa oni’o","poem":1},{"lineBreak":true},{"text":"ty ampoheke naho ty embetse","poem":1},{"lineBreak":true},{"text":"le ho valeam-pità’o,","poem":1},{"lineBreak":true},{"text":"ihe ro iatoa’ ty tsy aman’imba;","poem":1},{"lineBreak":true},{"text":"vaho mpañimba ty bode-rae.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pozaho ty sira’ o tsivokatseo naho i piaroteñey,","poem":1},{"lineBreak":true},{"text":"karaofo ty haratia’e ie tsy nilefe tsikaraheñe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mpanjaka nainai’e t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fa mongotse an-tane’e eo o fifeheañeo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ry Iehovà,","poem":1},{"lineBreak":true},{"text":"fa jinanji’o ty halali’ o tretram-poo;","poem":1},{"lineBreak":true},{"text":"hafatraro ty arofo’ iareo","poem":1},{"lineBreak":true},{"text":"atokilaño o ravembia’oo;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hañomea’o to o bode-raeo","poem":1},{"lineBreak":true},{"text":"naho o forekekeñeo,","poem":1},{"lineBreak":true},{"text":"tsy hampinevenevera’ ondaty","poem":1},{"lineBreak":true},{"text":"an-tane atoio ka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/10.json","thisChapterAudioLinks":{