:1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ze mifosa ondatio, ie ty harotsako;","poem":1},{"lineBreak":true},{"text":"hejeko ty maso miengeñe","poem":1},{"lineBreak":true},{"text":"naho ty troke mikoìboke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amo migahiñe an-tane atoio","poem":1},{"lineBreak":true},{"text":"o masokoo,","poem":1},{"lineBreak":true},{"text":"hiharoa’ iareo fimoneñañe,","poem":1},{"lineBreak":true},{"text":"hitoroñe ahy ty mañavelo an-kahiti’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy hitobok’ an-trañoko ao","poem":1},{"lineBreak":true},{"text":"ty mitolom-pamañahiañe;","poem":1},{"lineBreak":true},{"text":"tsy ho tambatse aolo’ o masokoo","poem":1},{"lineBreak":true},{"text":"ty mpivolam-bande.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho zamaneko boa-maraindray","poem":1},{"lineBreak":true},{"text":"o lo-tserek’ amy taneio;","poem":1},{"lineBreak":true},{"text":"haitoako ami’ty rova’ Iehovà","poem":1},{"lineBreak":true},{"text":"o mpitolon-katsivokarañeo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}