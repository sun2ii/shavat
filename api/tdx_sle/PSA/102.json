{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":102,"content":[{"type":"heading","content":["Halali’ ty mpisotry,"]},{"type":"verse","number":1,"content":[{"text":"ie andeme’e vaho mandoa toreo aman’Añahare.","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, janjiño ty halaliko;","poem":1},{"lineBreak":true},{"text":"le ampomb’ama’o ty toreoko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ko aeta’o amako ty lahara’o","poem":1},{"lineBreak":true},{"text":"añ’andron-kaloviloviañe.","poem":1},{"lineBreak":true},{"text":"atokilaño amako ty ravembia’o;","poem":1},{"lineBreak":true},{"text":"malisà hanoiñe ahy","poem":1},{"lineBreak":true},{"text":"ami’ty andro ikanjiako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mihelañe hoe hatoeñe o androkoo;","poem":1},{"lineBreak":true},{"text":"miforehetse hoe an-toñak’ ao o taolakoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pinaoke hoe ahetse ty troko","poem":1},{"lineBreak":true},{"text":"vaho miheatse","poem":1},{"lineBreak":true},{"text":"toe andikofako ty mitozin-kaneñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mipitek’ an-taolako ao ty holiko","poem":1},{"lineBreak":true},{"text":"ty ami’ty volam-piselekaiñako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe tangongo am-patrañe añe iraho,","poem":1},{"lineBreak":true},{"text":"hoe vorondolon-dratraratra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mandre an-tsareke iraho;","poem":1},{"lineBreak":true},{"text":"manahake ty tivoke miereñereñe","poem":1},{"lineBreak":true},{"text":"an-tampènake ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mañinje ahy lomoñandro o rafelahikoo;","poem":1},{"lineBreak":true},{"text":"mamàtsy ahiko o mpirengevok’amakoo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa nihaneko hoe ampemba ty lavenoke,","poem":1},{"lineBreak":true},{"text":"vaho linaroko firovetse ty finomako,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ty ami’ty haviñera’o naho ty fifombo’o,","poem":1},{"lineBreak":true},{"text":"fa rinambe’o iraho le nahifi’o añe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Manahake ty fipononòran-talinjo","poem":1},{"lineBreak":true},{"text":"o androkoo;","poem":1},{"lineBreak":true},{"text":"vaho miheatse hoe boka iraho.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nainai’e eo irehe ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ty Tahina’o an-tarirats’ an-tariratse.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hiongake irehe hitretre i Tsiône,","poem":1},{"lineBreak":true},{"text":"fa tsatoke te hisohe’o,","poem":1},{"lineBreak":true},{"text":"ie tondroke i nifantañañey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"No’ o mpitoro’oo o vato’eo; mbore kokoa’ iereo o lembo’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Soa te hañeveña’ o fifeheañeo","poem":1},{"lineBreak":true},{"text":"ty tahina’ Iehovà, naho","poem":1},{"lineBreak":true},{"text":"ze hene mpanjaka’ ty tane toy ty enge’o;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"fa nitratrañàhe’ Iehovà ty Tsiône","poem":1},{"lineBreak":true},{"text":"ie niboak’ amy enge’ey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nihaoñe’e ty halali’ o poi’eo;","poem":1},{"lineBreak":true},{"text":"vaho tsy niambohoa’e ty toreo’ iareo","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho patereñe ho a ty tariratse","poem":1},{"lineBreak":true},{"text":"mandimbe,","poem":1},{"lineBreak":true},{"text":"soa te handrenge Ià","poem":1},{"lineBreak":true},{"text":"ondaty mboe tsy nanoeñeo","poem":1},{"noteId":45},{"text":":","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nivazohoe’e boak’an-toe’e masiñe ankaboañ’ añe,","poem":1},{"lineBreak":true},{"text":"nisary ty tane toy boak’ an-dikerañe","poem":1},{"lineBreak":true},{"text":"eñe t’Iehovà,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"hijanjiñe ty fiñeoñeom-pirohy,","poem":1},{"lineBreak":true},{"text":"hañaha o nafatse havetrakeo","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"soa te ho talilie’ ondaty e Tsiône ao","poem":1},{"lineBreak":true},{"text":"ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ty enge’e e Ierosalaime ao,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ie mifanontoñe ondatio,","poem":1},{"lineBreak":true},{"text":"naho o fifeheañeo hitoroñe Iehovà.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nado’e deme’e iraho añivon-dalañe eo;","poem":1},{"lineBreak":true},{"text":"nitomore’e o androkoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hoe iraho, Ry Andrianañahareko, ehe, ko ampisintahe’o","poem":1},{"lineBreak":true},{"text":"añivo’ o androkoo iraho; mitakatse ze kila tariratse o tao’oo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Haehae irehe ro nañoreñe ty tane toy,","poem":1},{"lineBreak":true},{"text":"satam-pità’o o likerañeo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ho momoke iereo, fa nainai’e eo irehe;","poem":1},{"lineBreak":true},{"text":"fonga hikoneatse hoe sikiñe hambo’e,","poem":1},{"lineBreak":true},{"text":"ampilimbeze’o hoe sarimbo","poem":1},{"lineBreak":true},{"text":"vaho ho vaoe’o iereo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fe tsy mihotike irehe,","poem":1},{"lineBreak":true},{"text":"tsy mbia higadoñe o tao’oo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Le lia’e ho eo o anam-pitoro’oo,","poem":1},{"lineBreak":true},{"text":"le hijadoñe añatrefa’o eo o tiri’eo.","poem":1}]}],"footnotes":[{"noteId":45,"caller":"+","text":"Sab 22:31","reference":{"chapter":102,"verse":18}}]},"thisChapterLink":"/api/tdx_sle/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}