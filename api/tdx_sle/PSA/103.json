{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":103,"content":[{"type":"heading","content":["Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Andriaño t’Iehovà, ry troko;","poem":1},{"lineBreak":true},{"text":"naho ze hene amako;","poem":1},{"lineBreak":true},{"text":"bangò ty tahina’e masiñe !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Andriaño t’Iehovà ry troko, le ko haliño o hasoa’e iabio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I mpañaha ze hene hakeo’oy, ie mpanaha ze atao arete’oy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I mijebañe ty fiai’o boak’an-koboñ’aoy,","poem":1},{"lineBreak":true},{"text":"ie mañohò azo am-piferenaiñañe","poem":1},{"lineBreak":true},{"text":"naho am-pitretrezañe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ie mahaeneñe ty havelo’o an-draha soa,","poem":1},{"lineBreak":true},{"text":"naho vaoe’e hoe vantio ty hajalahi’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Manao ty hahiti’e t’Iehovà","poem":1},{"lineBreak":true},{"text":"naho mitolon-kavantañañe","poem":1},{"lineBreak":true},{"text":"amy ze hene volevolèn-draha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nampahafohine’e amy Mosè o sata’eo","poem":1},{"lineBreak":true},{"text":"o tolon-draha’eo amo ana’ Israeleo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miferenaiñe naho mitretre t’Iehovà,","poem":1},{"lineBreak":true},{"text":"malaon-kaviñerañe,","poem":1},{"lineBreak":true},{"text":"vaho enem-pikokoa-migahiñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy handilo nainai’e re,","poem":1},{"lineBreak":true},{"text":"tsy hangazoña’e kitro katroke","poem":1},{"lineBreak":true},{"text":"ty fifombo’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy nanoe’e mañeva o tahin-tikañeo,","poem":1},{"lineBreak":true},{"text":"tsy nililove’e ty amo hakeo’ tikañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa mira ami’ty haabo’ i likerañey","poem":1},{"lineBreak":true},{"text":"ami’ty tane toy,","poem":1},{"lineBreak":true},{"text":"ty hajabajaba’ ty fiferenaiña’e","poem":1},{"lineBreak":true},{"text":"amo mañeveñ’ama’eo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mira ami’ty halavi’ i atiñanañey","poem":1},{"lineBreak":true},{"text":"amy ahandrefañey,","poem":1},{"lineBreak":true},{"text":"ty halavi’ ty nampisitahe’e amantika o fiolàn-tikañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty halèm-pon-drae","poem":1},{"lineBreak":true},{"text":"amo ana’eo","poem":1},{"lineBreak":true},{"text":"ty fitretreza’ Iehovà amo mañeveñe ama’eo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"amy te arofoana’e ty vintan-tika;","poem":1},{"lineBreak":true},{"text":"tiahi’e t’ie lemboke.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa naho ondaty,","poem":1},{"lineBreak":true},{"text":"hoe ahetse o andro’eo","poem":1},{"lineBreak":true},{"text":"hoe voñe an-kivok’ ao ty fandrevaha’e;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ie iarian-tioke, le tsy eo ka,","poem":1},{"lineBreak":true},{"text":"vaho tsy mahatiahy aze i toe’ey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fe boake haehae tsy amam-pipotora’e añe, sikal’ami’ty tsy modo añe, ty fiferenaiña’ Iehovà amy ze mañeveñe ama’e,","poem":1},{"lineBreak":true},{"text":"naho i havantaña’ey","poem":1},{"lineBreak":true},{"text":"amo ana’ o anakeo—","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ho amy ze miambeñe i fañina’ey","poem":1},{"lineBreak":true},{"text":"vaho mahatiahy o taro’eo hanoa’e.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fa naore’ Iehovà","poem":1},{"lineBreak":true},{"text":"an-dindiñe ao ty fiambesa’e,","poem":1},{"lineBreak":true},{"text":"vaho mamehe ze he’e i fifehea’ey.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Andriaño t’Iehovà, ry Anjeli’e, ra’elahy an-kaozarañe,","poem":1},{"lineBreak":true},{"text":"mitoloñe amo tsarae’eo,","poem":1},{"lineBreak":true},{"text":"mañaoñe ty fiarañanaña’ o tsara’eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Andriaño t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ry hene lahin-defo’eo,","poem":1},{"lineBreak":true},{"text":"ry mpitoro’e mpanao","poem":1},{"lineBreak":true},{"text":"o satrin’ arofo’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Andriaño t’Iehovà, ry hene sata’e","poem":1},{"lineBreak":true},{"text":"tok’aia tok’aia amy fifehea’eio.","poem":1},{"lineBreak":true},{"text":"Andriaño t’Iehovà, ry fiaiko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}