{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Andriaño t’Iehovà, ry troko;","poem":1},{"lineBreak":true},{"text":"ry Iehovà Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"jabahinake irehe,","poem":1},{"lineBreak":true},{"text":"asiñe naho volonahetse ro misaroñ’ azo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ihemiholonkon-kazavañe hoe sarimbo;","poem":1},{"lineBreak":true},{"text":"velare’o hoe tèmetse o likerañeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ampandrè’e an-drano ao o faham-batsa’eo, anoe’e sarete’e o rahoñeo,","poem":1},{"lineBreak":true},{"text":"draidraite’e añ’ ela’ o tiokeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anoe’e ira’e o tiokeo,","poem":1},{"lineBreak":true},{"text":"mpitoro’e o afo mibelañeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naore’e amo faha’eo ty tane toy,","poem":1},{"lineBreak":true},{"text":"soa tsy hasiotse nainai’e donia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siniki’o hoe saroñe i lalekey;","poem":1},{"lineBreak":true},{"text":"nijohañe ambone’ o vohitseo ty rano;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nibioñe iereo te trinevo’o,","poem":1},{"lineBreak":true},{"text":"nibororoñe mb’eo ami’ty fivolan’ ampi’o;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nionjoñe o vohitseo,","poem":1},{"lineBreak":true},{"text":"nilempotse o vavataneo,","poem":1},{"lineBreak":true},{"text":"mb’amo toetse tinendre’o ho a iareoo","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jinado’o efetse tsy hililara’e;","poem":1},{"lineBreak":true},{"text":"tsy mone hibalike hañàmpo ty tane toy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Añirahe’e rano migoangoañe","poem":1},{"lineBreak":true},{"text":"o goledoñeo;","poem":1},{"lineBreak":true},{"text":"mikararak’ añivo’ o vohitseo;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ampinome’ iereo rano","poem":1},{"lineBreak":true},{"text":"o bibin-kivoke iabio;","poem":1},{"lineBreak":true},{"text":"afa-karan-drano o borìke lìio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mimoneñe añ’olo’ iereo eo","poem":1},{"lineBreak":true},{"text":"o voron-dikerañeo;","poem":1},{"lineBreak":true},{"text":"mivolañe an-tsinga-katae ey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tondraha’e hirik’amo efe’e amboneo","poem":1},{"lineBreak":true},{"text":"o vohitseo;","poem":1},{"lineBreak":true},{"text":"mahaeneñe ty tane toy","poem":1},{"lineBreak":true},{"text":"o vokam-pitoloña’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ampitiria’e ahetse o añombeo,","poem":1},{"lineBreak":true},{"text":"vaho añañe, vale’ ty fitoloña’ ondatio, hampahavokare’e haneñe ty tane,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"naho divay hampifale ty arofo’ ondaty, naho solike hañamendo ty lahara’e,","poem":1},{"lineBreak":true},{"text":"vaho mahakama hahavaño ty arofo’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Enen-drano o hatae’ Iehovào,","poem":1},{"lineBreak":true},{"text":"o","poem":1},{"noteId":46},{"text":"mendorave’ i Lebanone nambolè’eo,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ama’e ao ro anoa’ o voroñeo traño;","poem":1},{"lineBreak":true},{"text":"naho ty fañaoke, anakao ty akiba’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho a o ose lì-o o vohitse aboo;","poem":1},{"lineBreak":true},{"text":"fiampiram-panaloke o tevañeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nanoe’e fifotoañañe i volañey; apota’ i àndroy ty toem-pitsofora’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tinendre’o i ieñey,","poem":1},{"lineBreak":true},{"text":"mivotrake te haleñe ty fitinga­tingàña’ ze hene biby añ’ala ao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mitreñe, mitsatsa hena o liona tora’eo,","poem":1},{"lineBreak":true},{"text":"mipay ty hane’e aman’ Añahare.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ie manjirike i àndroy, mipoliotse iereo vaho mandre an-dakato’e ao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Miavotse mb’am-pitoloña’e mb’eo","poem":1},{"lineBreak":true},{"text":"ondatio, ampara’ te haleñe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"O ry Iehovà, akore ty hamaro’","poem":1},{"lineBreak":true},{"text":"o fitoloña’oo!","poem":1},{"lineBreak":true},{"text":"kila nanoe’o an-kihitse;","poem":1},{"lineBreak":true},{"text":"manitsike ty tane toy o vara’oo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Indroke i riakey, jabajaba mihenehene,","poem":1},{"lineBreak":true},{"text":"ifamorohotam-biby tsy hay iaheñe—","poem":1},{"lineBreak":true},{"text":"ty kede naho ty bey.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ama’e ty ionjonan-dakam-bey,","poem":1},{"lineBreak":true},{"text":"naho i fañaneñe nitsenè’o hihisa aoy.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Songa mandiñ’ Azo","poem":1},{"lineBreak":true},{"text":"hamahana’o haneñ’ an-tsa’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Anjotsoa’o, le atonto’ iareo,","poem":1},{"lineBreak":true},{"text":"sokafe’o ty fità’o, vaho","poem":1},{"lineBreak":true},{"text":"hene ànjan-draha soa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aeta’o ty lahara’o, le lonjetse iereo;","poem":1},{"lineBreak":true},{"text":"sintone’o ty kofò’e, le mihomake","poem":1},{"lineBreak":true},{"text":"mimpoly an-debok’ ao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Irahe’o t’i Arofo’o, mioreñe iereo,","poem":1},{"lineBreak":true},{"text":"vaho vaoe’o ty tarehe’ ty tane toy.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tsy mb’ia ho modo ty enge’ Iehovà;","poem":1},{"lineBreak":true},{"text":"ho rebehe’ Iehovà o fitoloña’eo,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Mampititititike ty tane toy te vazohoe’e,","poem":1},{"lineBreak":true},{"text":"mahatoeñe o vohitseo te edrè’e.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ho saboeko t’Iehovà","poem":1},{"lineBreak":true},{"text":"kanao mbe velon-draho;","poem":1},{"lineBreak":true},{"text":"ho rengèko an-tsabo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"katao mbe mahakofòke.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Toe mamy t‘ie itsakoreakoo,","poem":1},{"lineBreak":true},{"text":"ifaleako t’Iehovà.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ho mongoreñe an-tane atoy","poem":1},{"lineBreak":true},{"text":"o mpanan-tahiñeo","poem":1},{"lineBreak":true},{"text":"le tsy ho eo o lo-tserekeo.","poem":1},{"lineBreak":true},{"text":"Andriaño t’Iehovà, ry troko.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià","poem":1},{"noteId":47},{"text":".","poem":1}]}],"footnotes":[{"noteId":46,"caller":"+","text":"sedera: hatae mafe mandrevake","reference":{"chapter":104,"verse":16}},{"noteId":47,"caller":"+","text":"Halàl’ià: Haleloia; ze atao ty hoe Treño","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/tdx_sle/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}