{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Andriaño t’Iehovà,","poem":1},{"lineBreak":true},{"text":"kanjio ty tahina’e;","poem":1},{"lineBreak":true},{"text":"ampahafohino ondatio o fitoloña’eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isabò, rengeo an-tsabo;","poem":1},{"lineBreak":true},{"text":"talilio o raha fanjaka nanoe’eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mitreña, amy tahina’e masiñey;","poem":1},{"lineBreak":true},{"text":"ampirebehañ’ añ’arofo’ o mipay Iehovào.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paiavo t’Iehovà naho ty haozara’e;","poem":1},{"lineBreak":true},{"text":"tsoeho nainai’e ty lahara’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tiahio o raha fanjaka nanoe’eo, o halatsañeo, naho","poem":1},{"lineBreak":true},{"text":"o fizakam-palie’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ry tarira’ i Avrahame mpitoro’eo, ry ana’ Iakobe jinobo’eo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ie t’Iehovà Andrianañaharentika;","poem":1},{"lineBreak":true},{"text":"mahaatseke ty tane toy o fandilia’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toe tiahi’e nainai’e i fañina’ey,","poem":1},{"lineBreak":true},{"text":"i tsara linili’e pak’an-tarira’e fah’arivo’e,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"i nanoe’e amy Avrahamey,","poem":1},{"lineBreak":true},{"text":"naho i nifantà’e am’ Ietsakey,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"vaho niventè’e am’Iakobe ho fañè,","poem":1},{"lineBreak":true},{"text":"amy Israele ho fañina nainai’e:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ami’ty hoe : Hatoloko azo ty tane’","poem":1},{"lineBreak":true},{"text":"Kanàne, ty anjara lova’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie ondaty mbe nitsiampeampe,","poem":1},{"lineBreak":true},{"text":"toe nitsiampe, mbore nirenetane ama’e,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ie nitsatsà-tane mb’an-tane, boak’am-pifeheañe raike","poem":1},{"lineBreak":true},{"text":"sikal’am’ondaty ila’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"tsy nimetea’e ho lovilovie’ ondatio;","poem":1},{"lineBreak":true},{"text":"le trinevo’e o mpanjakao ty am’ iereo:","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ko mitsipaoke o norizakoo;","poem":1},{"lineBreak":true},{"text":"le ko joie’ areo o mpitokikoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Le nikanjie’e san-kerè o taneo,","poem":1},{"lineBreak":true},{"text":"fonga nifolahe’e o tahon-kaneñeo;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nirahe’e t’indaty hiaolo iareo,","poem":1},{"lineBreak":true},{"text":"Iosefe naletake ho ondevo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Jinoi’ iareo am-bahotse o fandia’eo,","poem":1},{"lineBreak":true},{"text":"najo am-po viñe ao i sandri’ey,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ampara’ ty andro nañenefañe","poem":1},{"lineBreak":true},{"text":"i nitokia’ey,","poem":1},{"lineBreak":true},{"text":"namente aze ty tsara’ Iehovà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nafanto’ i mpanjakay le nabalake re,","poem":1},{"lineBreak":true},{"text":"hinaha’ ty mpifehe’ ondatio,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nanoe’e talèn’ anjomba’e naho mpamandroñe o vara’eo,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"nifehe o roandria’eo an-tsatri’e,","poem":1},{"lineBreak":true},{"text":"nanoro hihitse amo androanavio.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nimoake e Mitsraime ao ka t’Israele,","poem":1},{"lineBreak":true},{"text":"nitaveañe an-tane’ i Kame añe t’Iakobe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Le nampanaranahe’e ondati’eo;","poem":1},{"lineBreak":true},{"text":"vaho nampaozare’e","poem":1},{"lineBreak":true},{"text":"ambone’ o rafelahi’iareoo","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nampifotere’e ty arofo’ iareo","poem":1},{"lineBreak":true},{"text":"halaiñe ondati’eo,","poem":1},{"lineBreak":true},{"text":"hikinia o mpitoro’eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nirahe’e t’i Mosè mpitoro’e,","poem":1},{"lineBreak":true},{"text":"i Aharone jinobo’ey.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nanoe’ iereo añivo’ iareo eo","poem":1},{"lineBreak":true},{"text":"o raha tsitantane’eo,","poem":1},{"lineBreak":true},{"text":"naho halatsàñe an-tane’ i Kame ao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nañitrifa’e ieñe,","poem":1},{"lineBreak":true},{"text":"le nampimoromoroñe’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy niolà’ iareo o tsara’eo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Novae’e ho lio ty rano’ iareo,","poem":1},{"lineBreak":true},{"text":"naho zinama’e o fia’ iareoo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nisamborian-tsahoñe ty tane’ iareo,","poem":1},{"lineBreak":true},{"text":"añ’efem-pandrea’ o mpanjaka’ iareoo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nitsara re, le niropahen-daletse,","poem":1},{"lineBreak":true},{"text":"naho nandrambañe ty tane’ iareo","poem":1},{"lineBreak":true},{"text":"ty haon-doha.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Tinolo’e havandra hisolo orañe,","poem":1},{"lineBreak":true},{"text":"naho afo nilebaleba an-tane’ iareo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Finofo’e o vahe’eo naho o sakoa’eo,","poem":1},{"lineBreak":true},{"text":"vaho tsineratsera’e o hatae an-tane’iareoo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Nisaontsie’e, le nimb’eo o betratrao,","poem":1},{"lineBreak":true},{"text":"naho ty kijeja tsy fotofoto;","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"hene navorembore’ iereo ze naindoñe","poem":1},{"lineBreak":true},{"text":"an-tane’ iareo ao,","poem":1},{"lineBreak":true},{"text":"fonga nabotseke ty vokan-tane’ iareo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Nampivetrahe’e iaby ka","poem":1},{"lineBreak":true},{"text":"o tañoloñoloñan-tane’ iareoo,","poem":1},{"lineBreak":true},{"text":"ze hene lengom-boan- kaozara’iareo.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Le nakare’e reketse volafoty","poem":1},{"lineBreak":true},{"text":"naho volamena t’Israele,","poem":1},{"lineBreak":true},{"text":"leo raike tsy nitsikapy amo rofoko’eo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Nifale t’i Mitsraime t’ie niakatse,","poem":1},{"lineBreak":true},{"text":"fa nivotraha’ ty fihembañañe.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Nandafiha’e rahoñe ho fialofañe,","poem":1},{"lineBreak":true},{"text":"naho afo ho fañazavàn-kaleñe.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Nihalaly iereo le nanjotsoa’e","poem":1},{"lineBreak":true},{"text":"hatrakatrake,","poem":1},{"lineBreak":true},{"text":"nampieneña’e mahakaman-dikerañe.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Sinoka’e i lamilamiy,","poem":1},{"lineBreak":true},{"text":"le nidoandoañe ty rano","poem":1},{"lineBreak":true},{"text":"nikararake an-dratraratra ao hoe saka.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Fa nitiahi’e i tsara’e masiñe amy Avrahame mpitoro’ey.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Le naaka’e am-pirebehañe ondati’eo,","poem":1},{"lineBreak":true},{"text":"am-pazake o jinobo’eo;","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"natolo’e ty tane’ o kilakila ondatio,","poem":1},{"lineBreak":true},{"text":"vaho rinambe’ iareo ho lova","poem":1},{"lineBreak":true},{"text":"o nimokora’ ondatioo:","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"soa t’ie hañambeñe o fañè’eo","poem":1},{"lineBreak":true},{"text":"vaho hañorike i Tsara’ey.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/105.json","t