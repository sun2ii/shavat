{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Treño t’Iehovà;","poem":1},{"lineBreak":true},{"text":"andriaño t’Iehovà, amy te Ie ro soa;","poem":1},{"lineBreak":true},{"text":"nainai’e ty fiferenaiña’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ia ty mahatalily o sata fanjaka’","poem":1},{"lineBreak":true},{"text":"Iehovào?","poem":1},{"lineBreak":true},{"text":"ndra hahafitsey o enge’e iabio?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haha ze mahafiambeñe ty hatò,","poem":1},{"lineBreak":true},{"text":"naho mitolom-panao ty fahiti’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tiahio iraho, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"naho isohe’o ondati’oo;","poem":1},{"lineBreak":true},{"text":"itiliho amy fandrombaha’oy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hahatreavako ty firaoraoa’ o jinobo’oo,","poem":1},{"lineBreak":true},{"text":"hirebeke ami’ty hafalea’ i fifehea’oy,","poem":1},{"lineBreak":true},{"text":"hitrao-pitreñañe amy lova’oy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nindre nandilatse amo roae’aio zahay;","poem":1},{"lineBreak":true},{"text":"nanao hakeo, nitolon-karatiañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy nihaoñe’ o rae’ay e Mitsraimeo","poem":1},{"lineBreak":true},{"text":"o halatsà’oo;","poem":1},{"lineBreak":true},{"text":"tsy nitiahi’ iereo o fiferenaiña’o vokatseo,","poem":1},{"lineBreak":true},{"text":"te mone niola amy Abo Tiañe,","poem":1},{"lineBreak":true},{"text":"an-dRiake Mena","poem":1},{"noteId":48},{"text":"añe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe rinomba’e ty amy tahina’ey, hampaharofoana’e ty haozara’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Trinevo’e i Riake Menay,","poem":1},{"lineBreak":true},{"text":"le nimaike,","poem":1},{"lineBreak":true},{"text":"vaho niaoloa’e, nitoañe o lalekeo","poem":1},{"lineBreak":true},{"text":"hoe te fatram-bey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Le rinomba’e boak’an-taña’","poem":1},{"lineBreak":true},{"text":"i malaiñe iareoy,","poem":1},{"lineBreak":true},{"text":"naho jineba’e am-pità’ i rafelahiy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nopoe’ i ranoy o rafelahi’eo; tsy nanisàñe honka’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le natokisa’ iareo o tsara’eo, nisaboeñe ty enge’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fe nihaliño’ iereo anianike o sata’eo","poem":1},{"lineBreak":true},{"text":"tsy nahaliñe o famerea’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le niazo’ ty hasiji-mena","poem":1},{"lineBreak":true},{"text":"an-jerezere tane añe;","poem":1},{"lineBreak":true},{"text":"nazizi’ iereo am-babangoañe ao","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le nitolora’e i nihalalie’ iereoy,","poem":1},{"lineBreak":true},{"text":"fe nañiraha’e haborokàñe ty fiai’iereo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie nitsikirike i Mosè an-tobe ao,","poem":1},{"lineBreak":true},{"text":"naho i Aharone navahe’ Iehovày,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"le nisokake i taney niteleñe i Datane;","poem":1},{"lineBreak":true},{"text":"naho nandembeke ty fehe’ i Abirame.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nisolebare’ ty afo añivo’ i rimboñey;","poem":1},{"lineBreak":true},{"text":"niforototoe’ i firebarebàñey o tsivokatseo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nitsene bania e Korebe añe iereo,","poem":1},{"lineBreak":true},{"text":"naho nilokoloko amy sare trinanakey;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"aa le natakalo’ iereo sare bania","poem":1},{"lineBreak":true},{"text":"mivazakota ahetse, ty engen’ Añahare.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nihaliño’ iereo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"mpandrombake iareo,","poem":1},{"lineBreak":true},{"text":"I nanao raha fanjàka e Mitsraimey,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"raha tsitantane an-tane’ i Kame","poem":1},{"lineBreak":true},{"text":"vaho raha naharevendreveñe","poem":1},{"lineBreak":true},{"text":"an-dRiake Mena añe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aa le nanao ty hoe t’ie harotsa’e:","poem":1},{"lineBreak":true},{"text":"naho tsy te nijohañe an-jebañe añatrefa’e eo","poem":1},{"lineBreak":true},{"text":"t’i Mosè jinobo’e, nampivioñe","poem":1},{"lineBreak":true},{"text":"i haviñera’ey tsy hanjamana’e.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Niheje’ iereo amy zao i tane nirieñey;","poem":1},{"lineBreak":true},{"text":"tsy natokisañe o tsara’eo,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"f’ie niñeoñeoñe an-kijà ao,","poem":1},{"lineBreak":true},{"text":"tsy hinao’ iereo ty fiarañanaña’ Iehovà.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aa le nifanta","poem":1},{"lineBreak":true},{"text":"te hampikorovohe’e an-jerezere tane ao,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"naho havarakai’e amo fifeheañeo","poem":1},{"lineBreak":true},{"text":"ty tarira’ iareo","poem":1},{"lineBreak":true},{"text":"vaho haparatsà’e amo taneo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mbore nireketse amy Baale-Peore iereo","poem":1},{"lineBreak":true},{"text":"vaho nampibotseke haneñe","poem":1},{"lineBreak":true},{"text":"nisoroñañe an-dolo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aa le nampiviñere’ iereo","poem":1},{"lineBreak":true},{"text":"amo fitoloña’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho natorotosi’e an-kiria.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Niongak’ amy zao t’i Pinekase","poem":1},{"lineBreak":true},{"text":"le nijebañe,","poem":1},{"lineBreak":true},{"text":"vaho nisebañeñe i angorosiy.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nivolilien-ko havañonañe ama’e zay.","poem":1},{"lineBreak":true},{"text":"ho a ze hene tarira’e mifandimbeo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nampiviñera’ iareo ka","poem":1},{"lineBreak":true},{"text":"amo rano mpilie-drokoñeo,","poem":1},{"lineBreak":true},{"text":"le niazom-boiñe ty am’iereo t’i Mosè;","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"amy t’ie nikai-jaka amy arofo’ey,","poem":1},{"lineBreak":true},{"text":"le kamaike ty niakatse am-pivimbi’e ao.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tsy nifongore’ iareo ondatio,","poem":1},{"lineBreak":true},{"text":"amy nandilia’ Iehovà hanoeñey,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Te mone nifañaoñe amo kilakila‘ndatio","poem":1},{"lineBreak":true},{"text":"naho nizatse o sata’eo,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"naho nitoroñe o saren-drahare’eo","poem":1},{"lineBreak":true},{"text":"ze nanjare fandrik’ am’ iereo,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"naho nasoro’ iereo amo kokolampao o anadahi’iareoo naho o anak’ ampela’iareoo,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"vaho nampiorike lio-maliñe,","poem":1},{"lineBreak":true},{"text":"ty lion’ anadahy naho anak’ampela,","poem":1},{"lineBreak":true},{"text":"ie nasoro’ iereo amo saren-drahare’","poem":1},{"lineBreak":true},{"text":"i Kanànao, vaho vinetan-dio i taney.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Aa le nihativa am-pitoloñañe,","poem":1},{"lineBreak":true},{"text":"nañarapilo amo fisafiria’iareoo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Toly ndra niviañe am’ondatio","poem":1},{"lineBreak":true},{"text":"ty haviñera’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho niheje’e i lova’ey.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Natolo’e am-pità’ o fifeheañeo iereo,","poem":1},{"lineBreak":true},{"text":"hifehea’ o rafelahi’eo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Niforekeke’","poem":1},{"lineBreak":true},{"text":"o nifankalaiñe am’iereoo","poem":1},{"lineBreak":true},{"text":"le nareke ambane’ fità’iareo.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Beteke rinomba’e, f’ie nizehatse an-tsafiry,","poem":1},{"lineBreak":true},{"text":"vaho nilempotse an-kakeo.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Ie nivazoho’e ty falovilovi’ iareo,","poem":1},{"lineBreak":true},{"text":"naho jinanji’e o fitoreova’ iareoo,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"le nitiahi’e ty am’ iereo i fañina’ey naho niselekaiñe, ty amo hene fiferenaiña’eo;","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"ie nampitretreze’e amo nanese","poem":1},{"lineBreak":true},{"text":"iareo am-pandrohizañeo.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Rombaho zahay ry Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ay,","poem":1},{"lineBreak":true},{"text":"vaho atontono boak’ amo fifeheañeo, hañandriaña’ay ty tahina’o masiñe,","poem":1},{"lineBreak":true},{"text":"vaho hitreñe amo enge’oo.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Andriañeñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"boak’an-kaehae’e pak’an-kaehae’e;","poem":1},{"lineBreak":true},{"text":"vaho hene hiredoñe ami’ty hoe ondatio:","poem":1},{"lineBreak":true},{"text":"Ie Izay,","poem":1},{"noteId":49},{"text":"Treño t’Ià.","poem":1}]}],"footnotes":[{"noteId":48,"caller":"+","text":"Riake Mena: ndra: ‘Riake Vondro’ (and. 9 naho 22 ka)","reference":{"chapter":106,"verse":7}},{"noteId":49,"caller":"+","text":"Heb: Amena","reference":{"chapter":106,"verse":48}}]},"thisChapterLink":"/api/tdx_sle/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/10