1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"toe aonjo’e ambone’ o hasotriañeo","poem":1},{"lineBreak":true},{"text":"i rarakey,","poem":1},{"lineBreak":true},{"text":"vaho anoe hoe lia-raike o hasavereña’eo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Isa’ o vantañeo izay le mifale,","poem":1},{"lineBreak":true},{"text":"fonga mamìm-bava ka ty hatsivokarañe.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ia ty mahihitse, hiharaharà’e?","poem":1},{"lineBreak":true},{"text":"ie ro mahafohiñe ty fiferenaiña’ Iehovà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}