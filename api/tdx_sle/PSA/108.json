{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":108,"content":[{"type":"heading","content":["Onin-tSabo’ i Davide, titiheñe"]},{"type":"verse","number":1,"content":[{"text":"Migahiñe ty troko,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"hisaboako; handrengeako,","poem":1},{"lineBreak":true},{"text":"eka, boak’ añovako ao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mibarakaoha ry valiha naho jejo-bory!","poem":1},{"lineBreak":true},{"text":"hitsekafako ty manjirik’ andro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hañandriañe Azo iraho ry Iehovà,","poem":1},{"lineBreak":true},{"text":"añivo’ o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"ho rengeko an-tsabo aivo’ ondatio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy te abo te amy likerañe eñey","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’o;","poem":1},{"lineBreak":true},{"text":"vaho mb’an-drahoñe ey ty figahiña’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mionjona! ry Andrianañahare, mb’andindìn-dikerañe añe,","poem":1},{"lineBreak":true},{"text":"naho ty enge’o mb’ ambone’ ty tane toy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Soa te hahàñe o kokoa’oo,","poem":1},{"lineBreak":true},{"text":"rombaho am-pità’o havana,","poem":1},{"lineBreak":true},{"text":"vaho toiño iraho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nitsara ami’ty hamasiña’e","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare:","poem":1},{"lineBreak":true},{"text":"Hitreñe iraho, ho zaraeko ty Sekeme","poem":1},{"lineBreak":true},{"text":"ho tsahareko ty vavatane’ i Sokote.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ahy t’i Gilade, Ahiko t’i Menasè; naho fikalan-dohako t’i Efraime,","poem":1},{"lineBreak":true},{"text":"vaho kobaiko t’Iehodà","poem":1},{"noteId":50},{"text":";","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sajoa fisasàko t’i Moabe,","poem":1},{"lineBreak":true},{"text":"apoko amy Edome ty hànako;","poem":1},{"lineBreak":true},{"text":"ambone’ i Pilistý ey ty hitreñako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ia ty hinday ahy mb’amy","poem":1},{"lineBreak":true},{"text":"rova fatratsey ao?","poem":1},{"lineBreak":true},{"text":"Ia ty hiaolo ahy mb’ Edome mb’eo?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa naforintse’o hao zahay,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare?","poem":1},{"lineBreak":true},{"text":"Tsy hitraofe’o fionjoñe hao o lahin-defo’aio, ry Andrianañahare?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ehe oloro amo rafelahio,","poem":1},{"lineBreak":true},{"text":"fa tsy vente’e ty fandrombaha’ ondatio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hampanjofak’anay t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ie ty handialia o rafelahi’aio.","poem":1}]}],"footnotes":[{"noteId":50,"caller":"+","text":"Fot 49:10, Sab 60:7","reference":{"chapter":108,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}