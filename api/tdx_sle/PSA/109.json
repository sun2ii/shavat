{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":109,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Ry Andrianañaharem-pandrengeako, Ko mianjiñe,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"fa nasoka’ iareo amako ty vava raty","poem":1},{"lineBreak":true},{"text":"naho ty vavam-pamañahiañe","poem":1},{"lineBreak":true},{"text":"fa nifosa ahy an-dela mibodiake.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niarikoboña’ iareo am-pivolam-palaiñañe;","poem":1},{"lineBreak":true},{"text":"vaho nialy amako tsy am-poto’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manisý ahy iereo ho valem-pikokoako,","poem":1},{"lineBreak":true},{"text":"izaho mpitalaho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tinambe’ iareo raty hasolo ty soa naho falaiñañe hasolo ty fikokoako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tendreo ty lo-tsereke hifehe aze,","poem":1},{"lineBreak":true},{"text":"ampijohaño am-pitàn-kavana’e","poem":1},{"lineBreak":true},{"text":"ty mpañinje,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ie zakaeñe, ampiboaho te voa,","poem":1},{"lineBreak":true},{"text":"le hatao tahiñe i fisolohoa’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho tomoreñe o andro’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho tavaneñe i fitoloña’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le ho bode-rae o ana’eo vaho ho ramavoy ty vali’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho mpangatake miriorio o ana’eo;","poem":1},{"lineBreak":true},{"text":"hipay ty lintse’iareo am-bangiñe añe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hifetreha’ ty mpampisongo","poem":1},{"lineBreak":true},{"text":"ze hene vara’e;","poem":1},{"lineBreak":true},{"text":"naho ho volose’ o ambahinio","poem":1},{"lineBreak":true},{"text":"ty tolin-kamokora’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ee t’ie tsy ho am-piferenaiñañe,","poem":1},{"lineBreak":true},{"text":"naho leo raike tsy hitretre","poem":1},{"lineBreak":true},{"text":"o ana’e bode-raeo","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Haitoañe o tiri’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho faopaoheñe","poem":1},{"lineBreak":true},{"text":"ami’ty tariratse handimbe ty añara’ iareo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le ho tohineñe am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty hakeon-drae’e;","poem":1},{"lineBreak":true},{"text":"naho tsy ho faoheñe ami tahin-drene’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho aolo’ Iehovà nainai’e abey iereo,","poem":1},{"lineBreak":true},{"text":"soa te hapitso’e an-tane atoy","poem":1},{"lineBreak":true},{"text":"ty fitiahiañe iareo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Amy te namoea’e ty hiferenaiñe,","poem":1},{"lineBreak":true},{"text":"te mone nampisoañe ondaty rarake naho poie’e, naho ty mioremeñe,","poem":1},{"lineBreak":true},{"text":"hañohofa’e loza.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ie nimpitea onjitse, le nifotetse ama’e, nalain-tata re, le nihànkaña’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nanaroñe aze hoe sarimbo","poem":1},{"lineBreak":true},{"text":"ty fañompà’e;","poem":1},{"lineBreak":true},{"text":"nizilik’ an-tro’e ao hoe rano,","poem":1},{"lineBreak":true},{"text":"naho hoe solik’ an-taola’e ao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho ama’e manahake","poem":1},{"lineBreak":true},{"text":"ty lamba iombea’e, naho hoe","poem":1},{"lineBreak":true},{"text":"ty sadia fidiaña’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Izay ty paia’ o malaiñe ahio","poem":1},{"lineBreak":true},{"text":"hanoe’ Iehovà amako,","poem":1},{"lineBreak":true},{"text":"o mañofoke ty fiaikoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"F’Ihe, ry Iehovà Talè,","poem":1},{"lineBreak":true},{"text":"ano amako sazò i tahina’oy;","poem":1},{"lineBreak":true},{"text":"ami’ty hasoa ty fiferenaiña’o, ihahao,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"fa misotry naho rarake,","poem":1},{"lineBreak":true},{"text":"naho fere ty troko añ’ovako ao;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"zaho mimian-koe talinjo mitibake","poem":1},{"lineBreak":true},{"text":"vaho nahifik’ añe hoe valala.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mitrezontrezo ty ongoko fa mililitse;","poem":1},{"lineBreak":true},{"text":"vaho boroka ty sandriko,","poem":1},{"lineBreak":true},{"text":"tsy aman-tsolike.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ifosàñe, te isa’ iareo,","poem":1},{"lineBreak":true},{"text":"le akofikofi’iareo loha.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Imbao iraho, ry Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahareko; rombaho raho","poem":1},{"lineBreak":true},{"text":"ty amy fiferenaiña’oy.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hahafohina’ iareo t’ie i fità’oy,","poem":1},{"lineBreak":true},{"text":"te Ihe ry Iehovà, ro mitoloñe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Angao hamàtse iereo,","poem":1},{"lineBreak":true},{"text":"f’ihe mitahia;","poem":1},{"lineBreak":true},{"text":"ie mitroatse le ho salatse,","poem":1},{"lineBreak":true},{"text":"fe ho fale ty mpitoro’o.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Hampisikineñe hameñarañe","poem":1},{"lineBreak":true},{"text":"o mpanesek’ ahikoo,","poem":1},{"lineBreak":true},{"text":"naho hiholonkoñan-kasalarañe","poem":1},{"lineBreak":true},{"text":"hoe sarimbo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Honjone’ ty vavako ­fañandriañañe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ho rengeko añivo’ i màroy.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Amy t’ie mijohañe","poem":1},{"lineBreak":true},{"text":"am-pitàn-kavana’ ty poie’e,","poem":1},{"lineBreak":true},{"text":"hañaha’e amo mpanisì’ azeo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}