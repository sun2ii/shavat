":[{"lineBreak":true},{"text":"Añ’anjomba’e miavake ao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"an-dindìñe ao ty iambesara’ Iehovà;","poem":1},{"lineBreak":true},{"text":"mivazoho o fihaino’eo,","poem":1},{"lineBreak":true},{"text":"mitsoke o ana’ ondatio o vohomaso’eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsohe’ Iehovà o vantañeo,","poem":1},{"lineBreak":true},{"text":"fe heje’ ty arofo’e ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"naho i piaroteñey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hampifororoaha’e vaen’afo mirekake","poem":1},{"lineBreak":true},{"text":"o tsivokatseo;","poem":1},{"lineBreak":true},{"text":"afo naho ponde vaho tio-mae","poem":1},{"lineBreak":true},{"text":"ty ho anjaram-pitovi’ iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amy te vantañe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"kokoa’e ty havañonañe","poem":1},{"lineBreak":true},{"text":"ho isa’ o mahitio ty lahara’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}