ovà, vaho tsy hilesa:","poem":1},{"lineBreak":true},{"text":"Mpisoroñe nainai’e irehe, ami’ty famosora’ i Melkizedeke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I Tale am-pitàn-kavana’oy ty","poem":1},{"lineBreak":true},{"text":"handemoke mpanjaka","poem":1},{"lineBreak":true},{"text":"amy andron-kaviñera’ey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hizaka’e añivo’ o fifeheañeo ré,","poem":1},{"lineBreak":true},{"text":"le ho lipore’e lolo ty ao,","poem":1},{"lineBreak":true},{"text":"ho hotohotoe’e an-tane mienene","poem":1},{"lineBreak":true},{"text":"ty loha maro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hikama rano an-torahañe","poem":1},{"lineBreak":true},{"text":"añ’olon-dalañe eo re,","poem":1},{"lineBreak":true},{"text":"vaho hampiandrae’e ty añ’ambone’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}