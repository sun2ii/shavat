":1},{"lineBreak":true},{"text":"naho mampìndrañe,","poem":1},{"lineBreak":true},{"text":"י naho mandahatse o tolon-draha’eo an-kahiti’e;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"כ Le lia’e tsy hasiotse re;","poem":1},{"lineBreak":true},{"text":"ל ho tiahy nainai’e o vañoñeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"מ Tsy hampitsonevotse aze ty talily raty;","poem":1},{"lineBreak":true},{"text":"נ migahiñe ty arofo’e,","poem":1},{"lineBreak":true},{"text":"Iehovà ro fatokisa’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ס Mioreñe ty arofo’e,","poem":1},{"lineBreak":true},{"text":"tsy ho hemban-dre","poem":1},{"lineBreak":true},{"text":"ע ampara’ te sambae’e o rafelahi’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"פּ Fa nandiva’e mbeombeo,","poem":1},{"lineBreak":true},{"text":"nanolora’e o rarakeo,","poem":1},{"lineBreak":true},{"text":"צ nainai’e ty havantaña’e;","poem":1},{"lineBreak":true},{"text":"ק haonjoñe an-kasiñe ty tsifa’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ר Ho trea’ ty tsivokatse,","poem":1},{"lineBreak":true},{"text":"le hitarik’aiñe,","poem":1},{"lineBreak":true},{"text":"ש hivaza-kota vaho hitranake;","poem":1},{"lineBreak":true},{"text":"ת ho mongotse ty fañiria’ o lo-tserekeo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}