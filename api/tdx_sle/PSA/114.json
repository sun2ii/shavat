{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Ie niakatse e Mitsraime t’Israele,","poem":1},{"lineBreak":true},{"text":"ty anjomba’ Iakobe boak’ am’ondaty","poem":1},{"lineBreak":true},{"text":"hafa fisaontsio","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"le nanoe’e toetse miavake t’Iehodà","poem":1},{"lineBreak":true},{"text":"naho boriza’e t’Israele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nañente i riakey, le nibioñe,","poem":1},{"lineBreak":true},{"text":"nimpoly t’Iordane;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nitrekotreko hoe añondrilahy","poem":1},{"lineBreak":true},{"text":"o vohitseo,","poem":1},{"lineBreak":true},{"text":"hoe anak-añondry o tambohoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akore, ry riakeo te mibioñe?","poem":1},{"lineBreak":true},{"text":"ry Iordane, te miesoñe?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ry vohitseo, te mitsamboatsamboañe","poem":1},{"lineBreak":true},{"text":"hoe añondrilahy,","poem":1},{"lineBreak":true},{"text":"ry tamboho, hoe anak-añondry?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mihondrahondrà, ry tane toy,","poem":1},{"lineBreak":true},{"text":"añatrefa’ i Talè,","poem":1},{"lineBreak":true},{"text":"aolo’ i Andrianañahare’ Iakobey,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ie nampañova ty vato ho sihanake, i lamilamiy ho rano mifororoake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}