{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Tsy zahay ry Iehovà,","poem":1},{"lineBreak":true},{"text":"tsy zahay fa i tahina’oy,","poem":1},{"lineBreak":true},{"text":"ro anolorañe engeñe,","poem":1},{"lineBreak":true},{"text":"ty amy fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"naho ty figahiña’o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ino ty atao’ o kilakila ‘ndatio ty hoe: Aia t’i Andrianañahare’ iareo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Andindiñe ao t’i Andrianañaharentika;","poem":1},{"lineBreak":true},{"text":"anoe’e iaby ze satrin’ arofo’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Volamena naho vola-foty ty fitalahoa’ iareo, satam-pità’ ondaty.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amam-bava iereo, fe tsy mivolañe,","poem":1},{"lineBreak":true},{"text":"ama-maso, f’ie tsy mahatrea;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"aman-tsofy, f’ie tsy mahatsanoñe;","poem":1},{"lineBreak":true},{"text":"aman’ oroñe, f’ie tsy mahaàntsoñe;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"aman-taña, f’ie tsy maharambe,","poem":1},{"lineBreak":true},{"text":"aman-tomboke, f’ie tsy mahalia;","poem":1},{"lineBreak":true},{"text":"tsy mahalefe fiñeoñeoñañe o feo’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho hambañe ama’e ty mamboatse aze, Eka! ze hene mpiato ama’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ry Israele, atokiso Iehovà!","poem":1},{"lineBreak":true},{"text":"Ie ty mpañimba naho kalan-defo’ iareo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ry tarira’ i Aharone, atokiso Iehovà!","poem":1},{"lineBreak":true},{"text":"Ie ty mpañimba naho kalan-defo’ iareo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ry mañeveñe am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"atokiso Iehovà!","poem":1},{"lineBreak":true},{"text":"Ie ty mpañimba naho kalan-defo’ iareo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fa nitiahi’ Iehovà tika, ho tahie’e;","poem":1},{"lineBreak":true},{"text":"ho soae’e ty anjomba’ Israele, ho soae’e ty anjomba’ i Aharone,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ho tahie’e o mañeveñe am’ Iehovào,","poem":1},{"lineBreak":true},{"text":"ndra ty kede ndra ty bey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hampivangongoe’ Iehovà nahareo,","poem":1},{"lineBreak":true},{"text":"inahareo naho o tiri’ areoo,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"hampanintsiña’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianamboatse i likerañey","poem":1},{"lineBreak":true},{"text":"naho ty tane toy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O andikerañeo!","poem":1},{"lineBreak":true},{"text":"a Iehovà o likerañeo,","poem":1},{"lineBreak":true},{"text":"fe natolo’e amo ana’ i Dameo","poem":1},{"lineBreak":true},{"text":"ty tane toy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy mandrenge Ià o vilasio,","poem":1},{"lineBreak":true},{"text":"ndra ia ia mizotso mb’am-bangìñe ao;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fe hañandriañe Ià tika henane zao ho nainai’e nainai’e.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}