{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Kokoako t’Iehovà amy te janji’e","poem":1},{"lineBreak":true},{"text":"ty feoko naho o halalikoo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amy te nanokilaña’e ravembia,","poem":1},{"lineBreak":true},{"text":"le ho tokaveko Amy ze hene androko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nivandire’ o talin-kavilasio iraho,","poem":1},{"lineBreak":true},{"text":"nazi’ i tsikeokeokey;","poem":1},{"lineBreak":true},{"text":"nizò fikoretañe naho anahelo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le nikanjieko ty tahina’ Iehovà:","poem":1},{"lineBreak":true},{"text":"Ehe, r’Iehovà, hahao ty fiaiko!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Matarike t’Iehovà naho mahity;","poem":1},{"lineBreak":true},{"text":"Eka, mpitretrè t’i Andrianañaharentika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Arova’ Iehovà o trentrañeo,","poem":1},{"lineBreak":true},{"text":"nizo havoretra iraho fe rinomba’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mimpolia mb’am-pitofà’o ao ry fiaiko,","poem":1},{"lineBreak":true},{"text":"fa nampiraorao azo t’Iehovà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa navotso’o an-kavetrahañe ty fiaiko,","poem":1},{"lineBreak":true},{"text":"tsy ho foy rano o masokoo, tsy hitsikapy o tombokoo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"t’ie hitsontik’ añatrefa’ Iehovà,","poem":1},{"lineBreak":true},{"text":"an-tanen-kaveloñe ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nahatoky avao ndra te nataoko ty hoe: Mafe ty fisotriako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hoe iraho te nianifañe:","poem":1},{"lineBreak":true},{"text":"Fonga Remborake ondatio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akore ty hañavahako am’ Iehovà?","poem":1},{"lineBreak":true},{"text":"ami’ty habein-kasoa’e amako?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho zonjoñeko","poem":1},{"lineBreak":true},{"text":"ty fitovim-pandrombahañe","poem":1},{"lineBreak":true},{"text":"vaho hikanjy ty tahina’ Iehovà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Havahako o nifantàko am’ Iehovào,","poem":1},{"lineBreak":true},{"text":"añatrefa’ ondati’e iabio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sarotse am-pihaino’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty havilasi’ o noro’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ry Iehovà, toe mpitoro’o iraho, fetrek’oro’o,","poem":1},{"lineBreak":true},{"text":"ty anan’ anak’ampata’o;","poem":1},{"lineBreak":true},{"text":"fa nabala’o o rohikoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hengaeko sorom-pañandriañañe,","poem":1},{"lineBreak":true},{"text":"vaho ho kanjieko ty tahina’ Iehovà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hondrohako am’ Iehovà","poem":1},{"lineBreak":true},{"text":"o nifantàkoo,","poem":1},{"lineBreak":true},{"text":"Eka, añatrefa’ ondati’e iabio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"An-kiririsan’anjomba’ Iehovà eo,","poem":1},{"lineBreak":true},{"text":"añivo’o ao, ry Ierosalaime.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}