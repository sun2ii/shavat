"lineBreak":true},{"text":"Amako t’Iehovà, tsy ho hemban-draho,","poem":1},{"lineBreak":true},{"text":"ino ty hanoa’ondatio?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amako t’Iehovà, ­mpañolotse ahiko,","poem":1},{"lineBreak":true},{"text":"le ho sambaeko o malaiñ’ ahio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hamake t’ie mipalitse am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ta te misazok’ am’ ondatio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kitra’e mitsolok’ am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ta te mirampy amo roandriañeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hene miarikoboñe ahy o fifeheañeo","poem":1},{"lineBreak":true},{"text":"fe iatoako ty tahina’ Iehovà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Miarikatok’ ahy iereo,","poem":1},{"lineBreak":true},{"text":"eka, toe misambory amako,","poem":1},{"lineBreak":true},{"text":"fe iatoko ty tahina’ Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niropak’ amako hoe rene-tantele iereo,","poem":1},{"lineBreak":true},{"text":"f’ie hakipike hoe fatike mirehetse;","poem":1},{"lineBreak":true},{"text":"toe iatoako ty tahina’Iehovà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanafasiotse ahy iereo","poem":1},{"noteId":51},{"text":"hikorovohako,","poem":1},{"lineBreak":true},{"text":"fe nañimb’ ahy t’Iehovà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Iehovà ro haozarako naho saboko,","poem":1},{"lineBreak":true},{"text":"ie ro ­fandrombahañe","poem":1},{"noteId":52},{"text":"ahy henane zao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Inao ty feom-pirebehañe naho","poem":1},{"lineBreak":true},{"text":"fandrombahañe an-kivoho’ o vañoñeo ao: mavitrike ty fitoloñam-pitàn-kavana’ Iehovà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mizonjoñe ty fitàn-kavana’ Iehovà;","poem":1},{"lineBreak":true},{"text":"mahimbañe ty fitàn-kavana’ Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy hikenkan-draho fa ho veloñe,","poem":1},{"lineBreak":true},{"text":"hataliliko o sata’ Iehovào.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nanilofe’ Ià am-pandilovan-draho,","poem":1},{"lineBreak":true},{"text":"fe tsy natolo’e an-kavilasy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sokafo ho ahy","poem":1},{"lineBreak":true},{"text":"o lalam-bein-kavantañañeo,","poem":1},{"lineBreak":true},{"text":"hizilihako, hañandriañako Iehovà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Intoy ty lalam-bei’ Iehovà, hiziliha’o vañoñeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Andriañekoo amy te tinoi’o,","poem":1},{"lineBreak":true},{"text":"fa Ihe ro fandrombahañe ahy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"I vato nado’ o mpandrafitseoy le fa talèm-batolahy","poem":1},{"noteId":53},{"text":".","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Sata’ Iehovà izay,","poem":1},{"lineBreak":true},{"text":"le fiain-tane am-pihainon-tikañe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Itoy ty andro tsinene’ Iehovà,","poem":1},{"lineBreak":true},{"text":"antao hirebeke naho hifale ama’e.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Ehe, rombaho zahay henaneo!","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Ehe, ampiraoraò henane zao!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Andriañeñe ty 