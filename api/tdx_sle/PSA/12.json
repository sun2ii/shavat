true},{"text":"ia ty mpifehe anay?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ty fampisoañañe o rarakeo,","poem":1},{"lineBreak":true},{"text":"naho ty fitoreova’ o mpisotrio,","poem":1},{"lineBreak":true},{"text":"ty iongahako henaneo, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Fa hampipalireko amy isehasehà’ey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fetse ki’e o fepè’ Iehovào,","poem":1},{"lineBreak":true},{"text":"volafoty nitsoheñe an-toñan-tsini-hara;","poem":1},{"lineBreak":true},{"text":"nitranaheñe im-pito","poem":1},{"noteId":5},{"text":".","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arovo irezay ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ambeno ami’ty tariratse toy","poem":1},{"lineBreak":true},{"text":"nainai’e donia,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mitsapiotsapioke mbeo’ mbeo","poem":1},{"lineBreak":true},{"text":"o tsivokatseo,","poem":1},{"lineBreak":true},{"text":"naho onjoneñe amo ana’ ondatio","poem":1},{"lineBreak":true},{"text":"ty haloloañe.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Sab 18:30, 119:140, Rzs 30:5","reference":{"chapter":12,"verse":6}}]},"thisChapterLink":"/api/tdx_sle/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}