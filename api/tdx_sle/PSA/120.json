1},{"lineBreak":true},{"text":"naho ty fimoneñako an-kiboho’","poem":1},{"lineBreak":true},{"text":"i Kedàre","poem":1},{"noteId":59},{"text":"ao !","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Loho hatr’ela’e ty nitraofam-piaiko","poem":1},{"lineBreak":true},{"text":"ami’ty kivoho’ o malaim-pilongoañeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe mpitea filongoan-draho;","poem":1},{"lineBreak":true},{"text":"fa ie ivolañako, aly avao ty onjone’ iereo.","poem":1}]}],"footnotes":[{"noteId":58,"caller":"+","text":"Meseke: kinozotse an-kère’e","reference":{"chapter":120,"verse":5}},{"noteId":59,"caller":"+","text":"Kedare: hamoromoroñañe, haniñe","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/tdx_sle/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}