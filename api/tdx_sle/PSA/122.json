añe fiambesam-pizakàñe, o fiambesa’ i tarira’ i Davideio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mihalalia fañanintsiñe am’Ierosalaime: hiraorao o mikoko Azoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fañanintsiñe ty ho an-kijoli’o ao,","poem":1},{"lineBreak":true},{"text":"naho fierañerañañe","poem":1},{"lineBreak":true},{"text":"amo anjomba’o mitiotiotseo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O longokoo naho o rañekoo,","poem":1},{"lineBreak":true},{"text":"le hataoko ty hoe: Fañanintsiñe ama’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I anjomba’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañaharentikañey,","poem":1},{"lineBreak":true},{"text":"ho paiako ty hampibodobodo azo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}