:[{"lineBreak":true},{"text":"Andriaño t’Iehovà, fa tsy napò’e tika","poem":1},{"lineBreak":true},{"text":"ho fitsatsàm-pamotsi’ iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niborofotse tika hoe voroñe","poem":1},{"lineBreak":true},{"text":"am-­bitsom-pitsindro-boroñe,","poem":1},{"lineBreak":true},{"text":"nipototse i fandrikey, le nibotafotse tika.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fañimbàn-tikañe ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianamboatse i likerañey","poem":1},{"lineBreak":true},{"text":"naho ty tane toy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}