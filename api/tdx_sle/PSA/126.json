{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Sabo-Pionjonañe","poem":1},{"lineBreak":true},{"text":"Ie mampoly ty fandrohiza’ i Tsiône t’Iehovà;","poem":1},{"lineBreak":true},{"text":"le hanahake te mañinofy tikañe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hitsitsihe’ ty hehe o falien-tikañeo,","poem":1},{"lineBreak":true},{"text":"naho ty rebeke o famelen-tikañeo;","poem":1},{"lineBreak":true},{"text":"vaho hisaontsieñe amo fifeheañeo ty hoe:","poem":1},{"lineBreak":true},{"text":"Nanao raha jabajaba ho a iareo t’Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eka, nitolora’Iehovà raha ra’elahy,","poem":1},{"lineBreak":true},{"text":"lifo-kaehake tikañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Afotero ty haondevo’ay ry Iehovà,","poem":1},{"lineBreak":true},{"text":"manahake o torahañe atimo añeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hitoly sabo an-kaehake","poem":1},{"lineBreak":true},{"text":"o mitongy an-drano-pihaino !","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ty minday tabiry ho tongiseñe","poem":1},{"lineBreak":true},{"text":"am-pirovetañe","poem":1},{"lineBreak":true},{"text":"ro hibalik’ an-drebeke hanese","poem":1},{"lineBreak":true},{"text":"o fitoboroña’eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}