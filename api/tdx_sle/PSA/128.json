"Hañasoa azo boake Tsiône ao t’Iehovà","poem":1},{"lineBreak":true},{"text":"le ho oni’o ty hasoa’ Ierosalaime","poem":1},{"lineBreak":true},{"text":"amy ze hene andro hiveloma’o;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Eka, ho isa’o o anan’ ana’oo.","poem":1},{"lineBreak":true},{"text":"Fañanintsiñe am’ Israele.","poem":1}]}],"footnotes":[{"noteId":60,"caller":"+","text":"Ze’ite: hatae Oliva","reference":{"chapter":128,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}