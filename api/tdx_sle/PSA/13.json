hanao ty hoe i rafelahikoy:","poem":1},{"lineBreak":true},{"text":"rinebako re; ke hirebeha’ o malaiñ’ ahikoo t’ie mibolatitse.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe fiatoako ty figahiñan’ arofo’o;","poem":1},{"lineBreak":true},{"text":"hirebeha’ ty troko i fandrombaha’oy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho saboeko t’Iehovà,","poem":1},{"lineBreak":true},{"text":"amy te nampibodobodoe’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}