{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Sabo-Pionjonañe","poem":1},{"lineBreak":true},{"text":"Boak’an-dalek’ ao ty nitoreovako","poem":1},{"lineBreak":true},{"text":"ama’o ry Iehovà;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry Talè, haoño ty feoko !","poem":1},{"lineBreak":true},{"text":"Ampijanjiño o ravembia’oo","poem":1},{"lineBreak":true},{"text":"ty feon-kalaliko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lehe Ihe r’Iehovà ro namolily hakeo,","poem":1},{"lineBreak":true},{"text":"ia, ry Talè, ty ho nahafijohañe?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fe ama’o ty fañafahan-kakeo;","poem":1},{"lineBreak":true},{"text":"soa te hañeveñañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitamà Iehovà iraho,","poem":1},{"lineBreak":true},{"text":"mandiñe ty troko,","poem":1},{"lineBreak":true},{"text":"o tsara’oo ro salalaeko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitamà i Talè ty fiaiko","poem":1},{"lineBreak":true},{"text":"mandikoatse ty mpandiñe maraindraiñe,","poem":1},{"lineBreak":true},{"text":"eka, ty mpandiñe maraindraiñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Israeleo, mitamà Iehovà,","poem":1},{"lineBreak":true},{"text":"am’ Iehovà ao ty fikokoa-migahiñe","poem":1},{"lineBreak":true},{"text":"ama’e ty fijebañañe mihenehene.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie ty hijebañe Israele","poem":1},{"lineBreak":true},{"text":"amo fonga hakeo’eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}