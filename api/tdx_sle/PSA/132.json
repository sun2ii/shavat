neBreak":true},{"text":"akiba ho a i Tsitongerè’ Iakobey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jinanji’ay e Efrata","poem":1},{"noteId":61},{"text":"izay,","poem":1},{"lineBreak":true},{"text":"tendrek’ an-kodobo’ i alay :","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Antao hionjoñe mb’an-Kivoho’e ao;","poem":1},{"lineBreak":true},{"text":"antao hitalaho","poem":1},{"lineBreak":true},{"text":"am-pitongoàm-pandia’e eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miongaha ry Iehovà,","poem":1},{"lineBreak":true},{"text":"miheova mb’am-pitofà’o mb’eo,","poem":1},{"lineBreak":true},{"text":"Ihe naho","poem":1},{"lineBreak":true},{"text":"i vatam-pañinan-kaozara’oy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ho lafihen-kavantañañe","poem":1},{"lineBreak":true},{"text":"o mpisoro’oo,","poem":1},{"lineBreak":true},{"text":"hipoñak’ an-kaehake o noro’oo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ty amy Davide mpitoro’oy, ko ampitolihe’o añe","poem":1},{"lineBreak":true},{"text":"ty lahara’ i noriza’oy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nifanta mahity amy Davide t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho tsy hafote’e, ty hoe:","poem":1},{"lineBreak":true},{"text":"Hampiambesareko","poem":1},{"lineBreak":true},{"text":"ami’ty fiambesam-panjakà’o eo","poem":1},{"lineBreak":true},{"text":"ty boak’ am-pañova’o ao;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"lehe ambe’ o ana’oo i fañinakoy","poem":1},{"lineBreak":true},{"text":"naho ty taroko anareko iareo,","poem":1},{"lineBreak":true},{"text":"le hiambesatse amy ­fiambesam-panjaka’oy nainai’e o ana’ iareoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Toe jinobo’ Iehovà ty Tsiône, i fañiria’e ho fimoneña’ey:","poem":1}]},