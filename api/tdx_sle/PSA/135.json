{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Treño t’Ià. Bangò ty tahina’ Iehovà;","poem":1},{"lineBreak":true},{"text":"mandrengea, ry mpitoro’Iehovà,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry mpijohañe añ’anjomba’Iehovà,","poem":1},{"lineBreak":true},{"text":"an-kiririsan’ anjomban’ Añahareo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rengeo, t’Ià, amy te soa t’Iehovà;","poem":1},{"lineBreak":true},{"text":"sabò i tahina’ey ty amy volonahe’ey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy te jinobo’ Ià ho am-bata’e t’Iakobe, ho vara’e t’Israele.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fantako te ra’elahy t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le mandikoatse ze atao ‘ndrahare","poem":1},{"lineBreak":true},{"text":"iaby t’i Talè.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Manao ze satri’e t’Iehovà,","poem":1},{"lineBreak":true},{"text":"an-dindiñe añe naho an-tane atoy,","poem":1},{"lineBreak":true},{"text":"amy riakey vaho an-tsikeokeoke ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ampionjone’e hirik’ añ’olon-tane añe","poem":1},{"lineBreak":true},{"text":"ty mika; anoa’e helatse o orañeo","poem":1},{"lineBreak":true},{"text":"vaho akare’e boak’an-driha’e ao ty tioke.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zinama’e o tañoloñoloña’ i Mitsraimeo, ndra ondaty ndra biby.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nañiraha’e viloñe naho halatsàñe mb’añivo’areo ao, ihe ‘nio, ry Mitsraime,","poem":1},{"lineBreak":true},{"text":"amy Parò vaho amo mpitoro’e iabio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Narotsa’e ty fifeheañe maro,","poem":1},{"lineBreak":true},{"text":"binaibai’e o mpanjaka fanalolahio,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"i Sikone, mpanjaka’ o nte Emoreo,","poem":1},{"lineBreak":true},{"text":"naho i Oge, mpanjaka’ i Basane,","poem":1},{"lineBreak":true},{"text":"vaho o fonga fifeleha’ i Kanàneo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le natolo’e ho lova ty tane’ iareo,","poem":1},{"lineBreak":true},{"text":"ho lova’ Israele, ondati’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ry Iehovà, tsy modo ty tahina’o,","poem":1},{"lineBreak":true},{"text":"ty fitiahiañ’ azo ry Iehovà,","poem":1},{"lineBreak":true},{"text":"le nainai’e donia.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa homei’ Iehovà to ondati’eo","poem":1},{"lineBreak":true},{"text":"le ho tretreze’e o mpitoro’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Volafoty naho volamena","poem":1},{"lineBreak":true},{"text":"o raham-pahasive’ o kilakila ‘ndatioo,","poem":1},{"lineBreak":true},{"text":"ty sata-pità’ ondaty.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ie manam-bava, fe tsy mirehake,","poem":1},{"lineBreak":true},{"text":"ama-maso, fe tsy mahatrea;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"aman-tsofy, fe tsy mahatsanoñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy mahakofòke o vava’iareoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ho hambañe am’iereo o mpanao iareoo, Eka, ze hene miato am’iereo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ry anjomba’ Israele,","poem":1},{"lineBreak":true},{"text":"Andriaño t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ry akiba’ i Aharone, andriaño t’Iehovà;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ry kivoho’ i Levio, andriaño t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ry mpañeveñe am’Iehovà,","poem":1},{"lineBreak":true},{"text":"andriaño t’Iehovà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Andriaño boak’e Tsiône ao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ry mpimoneñe e Ierosalaimeo.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}