{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Tañ’olon-tsaka e Bavele eo,","poem":1},{"lineBreak":true},{"text":"ty nitoboha’ay naho nirovetse,","poem":1},{"lineBreak":true},{"text":"t’ie nahatiahy i Tsiône.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amo sohihy añivo’eo ty nandradoradoa’ay o marovani’aio,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teo ty nihalalia’ o mpanese anaio sabo, naho nipaia’ o mpampisoañ’ anaio","poem":1},{"lineBreak":true},{"text":"rebeke, ami’ty hoe :","poem":1},{"lineBreak":true},{"text":"Isabò o sabo’ i Tsiôneo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa vaho akore ty hisaboentika","poem":1},{"lineBreak":true},{"text":"ty sabo’ Iehovà an-tanen’ ambahiny atoy?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naho haliñoko irehe ry Ierosalaime,","poem":1},{"lineBreak":true},{"text":"le angao ho kombimba ty sirako havana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adono hipitek’ ami’ty lañilañiko","poem":1},{"lineBreak":true},{"text":"ty lelako, naho tsy mahatiahy azo iraho,","poem":1},{"lineBreak":true},{"text":"lehe tsy aonjoko ambone’ ze","poem":1},{"lineBreak":true},{"text":"mahafale ahiko iaby t’Ierosalaime.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tiahio ry Iehovà ty kabò’o","poem":1},{"lineBreak":true},{"text":"amo nte Edomeo tañ’andro’ Ierosalaime:","poem":1},{"lineBreak":true},{"text":"Rotsaho! hoe iereo,","poem":1},{"lineBreak":true},{"text":"akoromaho pak’amo mananta’eo!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry anak-ampela’ i Bavele, harotsake irehe, haha ty hañavak’azo amy","poem":1},{"lineBreak":true},{"text":"nañondroha’o ama’aio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fale ty handrambe o anak’ajaja’oo,","poem":1},{"lineBreak":true},{"text":"handretsake iareo an-damilamy eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}