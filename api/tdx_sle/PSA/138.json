{"lineBreak":true},{"text":"Hañandriañ’ Azo","poem":1},{"lineBreak":true},{"text":"ze hene mpanjaka’ ty tane toy, r’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho janjiñe’iereo o entam-palie’oo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho saboe’ iereo o lala’ Iehovào,","poem":1},{"lineBreak":true},{"text":"fa ra’elahy ty enge’ Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndra te onjoneñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"mbe haoñe’e ty mireke,","poem":1},{"lineBreak":true},{"text":"le arofoana’e o mpirengevokeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndra t’ie manjenge añivo’","poem":1},{"lineBreak":true},{"text":"o faloviloviañeo,","poem":1},{"lineBreak":true},{"text":"Ihe ro mameloñe ahiko,","poem":1},{"lineBreak":true},{"text":"atorakitsi’o mb’ami’ty","poem":1},{"lineBreak":true},{"text":"haboseha’ o rafelahikoo ty fità’o, vaho mandrombak’ahy ty fità’o havana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho henefe’ Iehovà ty nisafirie’e ho ahy,","poem":1},{"lineBreak":true},{"text":"nainai’e, ry Iehovà ty fiferenaiña’o,","poem":1},{"lineBreak":true},{"text":"ko ado’o o tolom-pità’oo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}