{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":139,"content":[{"type":"verse","number":1,"content":[{"text":"Ho a i Talè, Sabo’ i Davide.","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, fa nitsikarahe’o iraho,","poem":1},{"lineBreak":true},{"text":"mbore arofoana’o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arofoana’o ty fitobohako","poem":1},{"lineBreak":true},{"text":"naho ty fiongahako;","poem":1},{"lineBreak":true},{"text":"oni’o ty ereñeren-troko","poem":1},{"lineBreak":true},{"text":"ndra te tsietoitàne añe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vandroñe’o o liakoo,","poem":1},{"lineBreak":true},{"text":"naho o fandreakoo;","poem":1},{"lineBreak":true},{"text":"hene arofoana’o o lalakoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie mbe tsy an-delako ao ty fivolako,","poem":1},{"lineBreak":true},{"text":"Hete! ry Iehovà, kila arofoana’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nifahera’o raho—","poem":1},{"lineBreak":true},{"text":"aolo eo naho amboho ao;","poem":1},{"lineBreak":true},{"text":"vaho nisazoha’o fitàñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Loho fanjàka amako i hilala zay, abo, tsy takako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aia ty hombako hisitak’ amy Arofo’oy?","poem":1},{"lineBreak":true},{"text":"Aia ty hibotitsihako o lahara’oo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie mionjom-b’an-dike­rañe mb’eo iraho,","poem":1},{"lineBreak":true},{"text":"eo irehe;","poem":1},{"lineBreak":true},{"text":"naho alafiko an-kerakerak’ ao","poem":1},{"lineBreak":true},{"text":"ty fandreako, hehe t’ie eo;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie rambeseko o ela’ i maraiñeio,","poem":1},{"lineBreak":true},{"text":"naho mitoetse añ’ olon-driake","poem":1},{"lineBreak":true},{"text":"tsietoitane añe,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"eo ka ty hitehafam-pità’o ahy,","poem":1},{"lineBreak":true},{"text":"naho hanazok’ ahiko ty fità’o havana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie anoeko ty hoe,","poem":1},{"lineBreak":true},{"text":"Toe hanafotse ahy ty ieñe,","poem":1},{"lineBreak":true},{"text":"vaho hivalike ho haleñe","poem":1},{"lineBreak":true},{"text":"ty hazavàñe amako,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fe ndra o hamoromoroñañeo","poem":1},{"lineBreak":true},{"text":"ro tsy maieñe ama’o,","poem":1},{"lineBreak":true},{"text":"mireandreañe hoe i àndroy ty haleñe,","poem":1},{"lineBreak":true},{"text":"hàmbañe ty hazavàñe naho ty ieñe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsinene’o o añovakoo;","poem":1},{"lineBreak":true},{"text":"nanenoñ’ ahy an-tron-dreneko ao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Andriañeko irehe,","poem":1},{"lineBreak":true},{"text":"fa an-karevendreveñañe naho halatsàñe","poem":1},{"lineBreak":true},{"text":"ty nitsene’o ahiko;","poem":1},{"lineBreak":true},{"text":"fanjàka o satam-pità’oo,","poem":1},{"lineBreak":true},{"text":"toe apota’ ty fiaiko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tsy nietak’ ama’o o taolakoo, ie nanoeñe an-kafitse ao,","poem":1},{"lineBreak":true},{"text":"naho nitseneñe an-kahimbañe","poem":1},{"lineBreak":true},{"text":"an-kalalefan-tane ao,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nivazohom-pihaino’o","poem":1},{"lineBreak":true},{"text":"o nanoeñe ahikoo,","poem":1},{"lineBreak":true},{"text":"naho nipatereñe amy boke’oy","poem":1},{"lineBreak":true},{"text":"ze hene andro norizañe ho ahy,","poem":1},{"lineBreak":true},{"text":"ie mboe tsy teo ty raike.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Miheotse amako o fivetsevetse’oo","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare!","poem":1},{"lineBreak":true},{"text":"Mienene t’ie mitraoke !","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie imaneako iake, le andikoara’e ty ia’ o faseñeo.","poem":1},{"lineBreak":true},{"text":"ie tsekake, le mbe ama’o eo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ehe ohoño loza o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare !","poem":1},{"lineBreak":true},{"text":"Mihankàña amako arè,","poem":1},{"lineBreak":true},{"text":"ry ondaty mpampiori-dioo,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Injè’ iareo an-keloke irehe,","poem":1},{"lineBreak":true},{"text":"manoñoñe Azo tsy vente’e","poem":1},{"lineBreak":true},{"text":"o malaiñ’Azoo;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy hejeko hao o tsy tea azoo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà?","poem":1},{"lineBreak":true},{"text":"Tsy hifangantoreko hao","poem":1},{"lineBreak":true},{"text":"o miatreatre ama’oo?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Toe hejeko am-palai-mena;","poem":1},{"lineBreak":true},{"text":"fonga volilieko ho rafelahiko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsikaraho iraho, ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"arofoano ty troko;","poem":1},{"lineBreak":true},{"text":"tsoho vaho arendreho","poem":1},{"lineBreak":true},{"text":"o fitsakoreakoo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Vazoho, he amako ao ty fiolañe,","poem":1},{"lineBreak":true},{"text":"vaho iaolò mb’an-dalañe nainai’e mb’eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}