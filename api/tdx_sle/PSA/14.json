{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Ho a i Talèn-tsakera; Sabo’ i Davide","poem":1},{"lineBreak":true},{"text":"Hoe ty mineñe an-tro’e ao:","poem":1},{"lineBreak":true},{"text":"Tsy eo ze o Andrianañahare zao.","poem":1},{"lineBreak":true},{"text":"Lo-tsereke irezay, mitoloñe an-kativañe;","poem":1},{"lineBreak":true},{"text":"leo raike tsy manao soa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Misary o ana’ ondatio hirik’an-dikerañ’ ao t’Iehovà, hahaoniña’e ke eo ty mahilala mpitsoeke","poem":1},{"lineBreak":true},{"text":"an’ Andrianañahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sindre mandifike,","poem":1},{"lineBreak":true},{"text":"mitrao-kaleorañe;","poem":1},{"lineBreak":true},{"text":"tsy eo ty manao soa, leo raike.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Songa tsy aman-kilala o mpitolon-karatiañeo, o mampibotseke ondatikoo","poem":1},{"lineBreak":true},{"text":"manahake ty filintseña’e mofo,","poem":1},{"lineBreak":true},{"text":"vaho tsy mitoka Iehovà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An-gebahebak’ ao iereo,","poem":1},{"lineBreak":true},{"text":"fe amy tariratse vañoñey","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho naoveove’ areo ty fikabijà’ o rarakeo,","poem":1},{"lineBreak":true},{"text":"fe fitsoloha’iareo t’Iehovà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe hiboake Tsiône ao","poem":1},{"lineBreak":true},{"text":"ty fandrombaha’ Israele !","poem":1},{"lineBreak":true},{"text":"ie ampitolihe’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty fandrohizañe ondati’eo;","poem":1},{"lineBreak":true},{"text":"le hirebeke t’Iakobe,","poem":1},{"lineBreak":true},{"text":"vaho hifale t’Israele !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}