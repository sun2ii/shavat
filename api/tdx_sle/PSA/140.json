{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":140,"content":[{"type":"verse","number":1,"content":[{"text":"Ho a i Talè, Sabo’ i Davide.","poem":1},{"lineBreak":true},{"text":"Avotsoro am’ ondaty lo-tserekeo iraho, ry Iehovà;","poem":1},{"lineBreak":true},{"text":"arovo am’ondaty piaroteñeo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"o mikilily añ’arofo’e ao","poem":1},{"lineBreak":true},{"text":"naho mikitrok’aly lomoñandroo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nisioñe’ iereo ty famele’ iareo hoe mereñe;","poem":1},{"lineBreak":true},{"text":"an-tsoñi’iareo ty vorem-pandrefeala. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Arovo tsy ho am-pità’ o lo-tserekeo iraho ry Iehovà;","poem":1},{"lineBreak":true},{"text":"arovo amy ‘ndaty mitrotrofiakey,","poem":1},{"lineBreak":true},{"text":"ty mikinia hampidorasitse o liakoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nañetake fandrike ho ahy","poem":1},{"lineBreak":true},{"text":"o mpikavokavokeo; naho taly;","poem":1},{"lineBreak":true},{"text":"naho namelara’ iareo harato","poem":1},{"lineBreak":true},{"text":"añ’olon-dalañeo vaho","poem":1},{"lineBreak":true},{"text":"nampibitsoke fandri-boñe amako. Selà","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe iraho am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"Ihe ro Andrianañahareko.","poem":1},{"lineBreak":true},{"text":"Janjiño, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"o feon-kalalikoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ry Iehovà Talè,","poem":1},{"lineBreak":true},{"text":"faozaram-pandrombahañe ahiko,","poem":1},{"lineBreak":true},{"text":"Mpanaroñe ty lohako","poem":1},{"lineBreak":true},{"text":"añ-andron-kotakotake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko toiñe’o, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ty fisalalà’ o tsy vokatseo,","poem":1},{"lineBreak":true},{"text":"ko osihe’o ty fikililia’iareo","poem":1},{"lineBreak":true},{"text":"tsy mone hirohake. Selà","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le ty loha’ o miarikoboñ’ ahikoo:","poem":1},{"lineBreak":true},{"text":"ho rongoñeñe","poem":1},{"lineBreak":true},{"text":"ty fikotrihan-tsoñi’iareo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"naho hararadrarak’ am’ iereo","poem":1},{"lineBreak":true},{"text":"ty foroha mirekake;","poem":1},{"lineBreak":true},{"text":"vaho havokovoko añ’afo","poem":1},{"lineBreak":true},{"text":"an-koboñe ao, tsy hitroatse ka.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tsy hitoera’ ty mpikatramo ty tane toy;","poem":1},{"lineBreak":true},{"text":"ho vandroñen-doza","poem":1},{"lineBreak":true},{"text":"ondaty mpiloa-tiñakeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fantako te mpanozañe o misotrio","poem":1},{"lineBreak":true},{"text":"t’Iehovà, naho ty zo’ o rarakeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Toe mañandriañe ty tahina’o","poem":1},{"lineBreak":true},{"text":"o vantañeo,","poem":1},{"lineBreak":true},{"text":"vaho himoneñe añatrefa’o eo o vañoñeo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}