{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"Sabo’ i Davide","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, mikanjy azo iraho,","poem":1},{"lineBreak":true},{"text":"mb’etoa an-taentaeñe;","poem":1},{"lineBreak":true},{"text":"toloro ravembia ty feoko te koiheko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ano rame añatrefa’o eo o halalikoo,","poem":1},{"lineBreak":true},{"text":"hoe soron-kariva ty fizonjo’ o sirakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ampijadoño mpañambeñe ty vavako,","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ambeno ty lalambein-tsoñiko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ko avi’o mb’an-karatiam-beo ty troko,","poem":1},{"lineBreak":true},{"text":"hitoloñako sata-raty rekets’ ondaty mitolon-katsivokarañeo;","poem":1},{"lineBreak":true},{"text":"ko apo’o ho haneko","poem":1},{"lineBreak":true},{"text":"ze raha mafiri’ iareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ee te handraratehak’ahy an-kalèn-tro","poem":1},{"lineBreak":true},{"text":"ty vañoñe, naho hañendak’ ahy,","poem":1},{"lineBreak":true},{"text":"toe solik’ añambone izay,","poem":1},{"lineBreak":true},{"text":"lonike te tsy hifoneñan-dohako;","poem":1},{"lineBreak":true},{"text":"Fa tsy apoko ty halaliko ty amo sata rati’ iareoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie avokovoko añ’ilan-kereretsak’ ao","poem":1},{"lineBreak":true},{"text":"o mpizaka’iareoo,","poem":1},{"lineBreak":true},{"text":"le ho tsanoñe’ iareo te nañeva o volakoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hambañe ami’ty fitrabahañe naho","poem":1},{"lineBreak":true},{"text":"fitrobohan-tane,","poem":1},{"lineBreak":true},{"text":"ty fampivarakaihañe am-bavan –","poem":1},{"lineBreak":true},{"text":"kibory ao o taola’aio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fe mitolik’ ama’o o masokoo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, Talè;","poem":1},{"lineBreak":true},{"text":"fa ama’o ty fipalirako—","poem":1},{"lineBreak":true},{"text":"ko alonga’o ty fiaiko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Arovo iraho amy fandrike","poem":1},{"lineBreak":true},{"text":"nampibitsoheñe ho ahikoy;","poem":1},{"lineBreak":true},{"text":"naho amo fandri-bo’ o mpanao ratio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hivariñe an-karato’ iareo avao o lo-tserekeo, te izaho miary eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}