ty hipalirako;","poem":1},{"lineBreak":true},{"text":"tsy ahoa’ondaty ty fiaiko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nitoreo ama’o iraho ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ami’ty hoe : Ihe ro fitsolohako, ty anjarako an-tanen-kaveloñ’ ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Janjiño ty fikaikaihako","poem":1},{"lineBreak":true},{"text":"fa loho mirèke; hahao amo mpanao","poem":1},{"lineBreak":true},{"text":"samporerak’ ahiio, fa fatratse te amako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Akaro am-balabey ao ty fiaiko hibangoako ty tahina’o;","poem":1},{"lineBreak":true},{"text":"hiropak’ amako o vañoñeo","poem":1},{"lineBreak":true},{"text":"ami’ty fatariha’o amako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}