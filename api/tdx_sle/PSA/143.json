{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":[{"text":"Sabo’ i Davide","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, janjiño ty filolohako,","poem":1},{"lineBreak":true},{"text":"atokilaño mb’amo halalikoo","poem":1},{"lineBreak":true},{"text":"ty ravembia’o ty amo figahiña’oo naho o havantaña’oo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ko ampanesefe’o an-jaka ty mpitoro’o;","poem":1},{"lineBreak":true},{"text":"fa tsi-mbia tsy ho añatrefa’o ty veloñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nampisòañe ty fiaiko o rafelahio,","poem":1},{"lineBreak":true},{"text":"nigorè’e an-tane ty haveloko;","poem":1},{"lineBreak":true},{"text":"nampitoboheñe añ’ieñe ao,","poem":1},{"lineBreak":true},{"text":"manahake t’ie nilolo ela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa le mitsikorak’ amako ty troko;","poem":1},{"lineBreak":true},{"text":"mioremeñe ty añovako ao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tiahiko o andro taoloo,","poem":1},{"lineBreak":true},{"text":"niniheko iaby o fitoloña’oo tsakorèko o satam-pità’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ahitiko mb’ama’o o tañakoo;","poem":1},{"lineBreak":true},{"text":"limpoañe ty ama’o ty fiaiko hoe tane mivaràkivaràky. Selà","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toiño masìka ry Iehovà;","poem":1},{"lineBreak":true},{"text":"fa mimoremoretse ty troko.","poem":1},{"lineBreak":true},{"text":"ko aeta’o amako ty lahara’o","poem":1},{"lineBreak":true},{"text":"hera hanahake o mizotso","poem":1},{"lineBreak":true},{"text":"mb’an-kaly aoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ampitsanoño ahy ty fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"te maraiñe,","poem":1},{"lineBreak":true},{"text":"amy te Ihe ro iatoako.","poem":1},{"lineBreak":true},{"text":"ampandrendreho ty lala hombako,","poem":1},{"lineBreak":true},{"text":"fa ama’o ty fañonjonañe ty fiaiko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ihahao amo rafelahikoo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà; Ihe ro fitsolohako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Anaro ahy ty hanao o satri’oo,","poem":1},{"lineBreak":true},{"text":"Ihe ro Andrianañahareko;","poem":1},{"lineBreak":true},{"text":"le ampiaolò ahy an-tane mira","poem":1},{"lineBreak":true},{"text":"ty Arofo’o soa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isotrafo amy tahina’oy, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"afaho amo hasosorañeo,","poem":1},{"lineBreak":true},{"text":"ty amy havantaña’oy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aitò amako o rafelahikoo","poem":1},{"lineBreak":true},{"text":"ty amy fiferenaiña’oy, vaho","poem":1},{"lineBreak":true},{"text":"fonga rotsaho o mitsibore ty fiaikoo,","poem":1},{"lineBreak":true},{"text":"fa mpitoro’o iraho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}