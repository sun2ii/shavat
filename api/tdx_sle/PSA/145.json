{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":145,"content":[{"type":"verse","number":1,"content":[{"text":"Sabo Fibangoañe. A i Davide","poem":1},{"lineBreak":true},{"text":"Honjoneko irehe,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahareko, ry Mpanjaka,","poem":1},{"lineBreak":true},{"text":"hibango ty tahina’o mb’an-jafe’afe’e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Handriañeko boak’ andro,","poem":1},{"lineBreak":true},{"text":"le hibango ty tahina’o nainai’e donia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hinakinake t’Iehovà, rengèñe añ’abo,","poem":1},{"lineBreak":true},{"text":"tsy taka-tsikaraheñe ty hajabahina’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ho bangoe’ ty tariratse raik’ ami’ty ila’e o tolon-draha’oo;","poem":1},{"lineBreak":true},{"text":"naho hitaroñe o fitoloña’o jabajabao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ty ha’raelahim-bolonahe’ ty enge’o vaho o tolon-draha’o mahalatsao","poem":1},{"lineBreak":true},{"text":"ro fitsakoreako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho talilie’ ondatio ty haozaram-panoe’o mampañeveñe,","poem":1},{"lineBreak":true},{"text":"vaho ho taroñeko ty hajabahina’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho talilie’ iereo ty fitiahiañe o havokaran-kasoa’o;","poem":1},{"lineBreak":true},{"text":"hirebeha’ iereo ty havantaña’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Matarike t’Iehovà, naho lifo-tretrè,","poem":1},{"lineBreak":true},{"text":"malaon-kaviñerañe","poem":1},{"lineBreak":true},{"text":"vaho lifo-piferenaiñañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kila hasoà’ Iehovà;","poem":1},{"lineBreak":true},{"text":"ambone’ ze hene anoe’e o fitretreza’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fonga handrenge Azo o tolon-draha’oo, ry Iehovà;","poem":1},{"lineBreak":true},{"text":"vaho hañonjoñe Azo o noro’oo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho saontsie’ iereo","poem":1},{"lineBreak":true},{"text":"ty volonahem-pifehea’o,","poem":1},{"lineBreak":true},{"text":"vaho hitalily o haozara’oo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"hampandrendreke o ana’ ondatio","poem":1},{"lineBreak":true},{"text":"o fitoloña’e ra’elahio,","poem":1},{"lineBreak":true},{"text":"naho ty hafanjàka’ ty enge’ i fifehea’ey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fifeheañe tsy modo ty fifehea’o,","poem":1},{"lineBreak":true},{"text":"naho manitsike o tariratse iabio","poem":1},{"lineBreak":true},{"text":"ty fameleha’o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Songa tohaña’ Iehovà o mikorovokeo,","poem":1},{"lineBreak":true},{"text":"sindre atroa’e o mibokok’ ambaneo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kila fihaino miandrandra ama’o,","poem":1},{"lineBreak":true},{"text":"vaho anjotsoa’o mahakama an-tsa’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Manoka-pitàn-drehe mañeneke","poem":1},{"lineBreak":true},{"text":"ty fañiria’ ze hene raha veloñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Vantañe amo lala’e iabio t’Iehovà","poem":1},{"lineBreak":true},{"text":"naho matarik’ amy ze hene fitoloña’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Marine’ ze mikanjy aze iaby t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ze hene mikanjy aze an-katò.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ho henefa’e ty fisalalà’","poem":1},{"lineBreak":true},{"text":"o mañeveñe ama’eo;","poem":1},{"lineBreak":true},{"text":"ho janjiñe’e ka ty toreo’ iareo","poem":1},{"lineBreak":true},{"text":"vaho ho rombahe’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ambena’ Iehovà ze hene mikoko aze,","poem":1},{"lineBreak":true},{"text":"fe fonga ho rotsahe’e o lo-tserekeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hivolam-pandrengeañe am’ Iehovà ty vavako,","poem":1},{"lineBreak":true},{"text":"le kila nofotse ro hibango ty tahina’e","poem":1},{"lineBreak":true},{"text":"masiñe nainai’e donia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}