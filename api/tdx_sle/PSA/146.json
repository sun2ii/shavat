{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Treño t’Ià!","poem":1},{"lineBreak":true},{"text":"Rengeo t’Iehovà, ty troko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ho rengeko t’Iehovà kanao veloñe;","poem":1},{"lineBreak":true},{"text":"hisabo an’Andrianañahareko","poem":1},{"lineBreak":true},{"text":"te izaho mbe atoy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko iatoa’ areo o roandriañeo,","poem":1},{"lineBreak":true},{"text":"naho o ana-ondatio","poem":1},{"lineBreak":true},{"text":"fa tsy maha-rombake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miakatse mb’eo ty kofò’e,","poem":1},{"lineBreak":true},{"text":"mimpoly mb’an-tane ao;","poem":1},{"lineBreak":true},{"text":"modo amy andro zay avao","poem":1},{"lineBreak":true},{"text":"ty fañereñerea’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haha naho t’i Andrianañahare’ Iakobe","poem":1},{"lineBreak":true},{"text":"ro mpañimb’ aze.","poem":1},{"lineBreak":true},{"text":"naho Iehovà Andrianañahare’e","poem":1},{"lineBreak":true},{"text":"ro fisalalà’e,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I nanao i likerañey naho ty tane toiy,","poem":1},{"lineBreak":true},{"text":"i riakey, naho ze he’e ama’e ao,","poem":1},{"lineBreak":true},{"text":"i mitan-ty hatò nainai’ey,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I mpañomey to o volevoleñeoy,","poem":1},{"lineBreak":true},{"text":"i manjotso mahakama","poem":1},{"lineBreak":true},{"text":"amo salikoeñeoy.","poem":1},{"lineBreak":true},{"text":"Iehovà ro mpañaha o mirohio,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mampibeake ty goa t’Iehovà;","poem":1},{"lineBreak":true},{"text":"onjone’ Iehovà o mivohotseo,","poem":1},{"lineBreak":true},{"text":"kokoa’ Iehovà o vantañeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ambena’ Iehovà o ambahinio,","poem":1},{"lineBreak":true},{"text":"onjone’e ty bode-rae naho ty vantotse,","poem":1},{"lineBreak":true},{"text":"fe akelokelo’e ty lala’ i lo-tserekey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hifehe nainai’e t’Iehovà, Andrianañahare’o, ry Tsiône,","poem":1},{"lineBreak":true},{"text":"mb’am-pigadoñan-tariratse añe,","poem":1},{"lineBreak":true},{"text":"Treño t’Ià.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}