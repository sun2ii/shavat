rarañe;","poem":1},{"lineBreak":true},{"text":"tsy taka-jehèñe ty hilala’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tohaña’ Iehovà o mirèkeo,","poem":1},{"lineBreak":true},{"text":"gorè’e an-tane ty lo-tsereke.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sabò am-pañandriañañe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"Rengeo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"am-piarahañe marovany,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ie ty mpandafike rahoñe","poem":1},{"lineBreak":true},{"text":"an-dikerañe eñe,","poem":1},{"lineBreak":true},{"text":"naho mpañajary orañe an-tane atoy,","poem":1},{"lineBreak":true},{"text":"naho mampitiry ahetse am-bohitse ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fahana’e hàneñe o bibio,","poem":1},{"lineBreak":true},{"text":"naho o ana-koàke migagakeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy ty haozara’ o soavalao","poem":1},{"lineBreak":true},{"text":"ty mahahaha Aze,","poem":1},{"lineBreak":true},{"text":"tsy ty kitson-dahilahy ro ifalea’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ondaty mañeveñe ama’eo","poem":1},{"lineBreak":true},{"text":"ro noro’ Iehovà,","poem":1},{"lineBreak":true},{"text":"o mpitamà ty hafatram-pikokoa’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rengeo t’Iehovà, ry Ierosalaime;","poem":1},{"lineBreak":true},{"text":"onjono t’i Andrianañahare’o, ry Tsiône.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa nampifatrare’e","poem":1},{"lineBreak":true},{"text":"o sikadan-dalam-bei’oo;","poem":1},{"lineBreak":true},{"text":"tahie’e o ajalahy ama’oo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ampierañerañe’e o efe-tane’oo,","poem":1},{"lineBreak":true},{"text":"vaho ampieneña’e ampemba","poem":1},{"noteId":62},{"text":"soa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ahitri’e mb’an-tane atoy o fetse’eo, mipirirìtse o taro’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Anjotsoa’e oram-panala","poem":1},{"lineBreak":true},{"text":"hoe volon’ añondry;","poem":1},{"lineBreak":true},{"text":"afiafia’e hoe lavenoke ty fanala.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Afitse’e ami’ty minjikio’e ty havandra’e, ia ty mahafijohañe miatreke","poem":1},{"lineBreak":true},{"text":"ty fangoratsaha’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Irahe’e mb’eo o tsara’eo","poem":1},{"lineBreak":true},{"text":"le mitranake iereo;","poem":1},{"lineBreak":true},{"text":"ampitiofe’e o tio’eo, vaho","poem":1},{"lineBreak":true},{"text":"ampidoañe’e rano.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Talilie’e am’ Iakobe ty tsara’e;","poem":1},{"lineBreak":true},{"text":"am’ Israele o fañè’eo naho o fepè’eo","poem":1},{"noteId":63},{"text":".","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy nanoe’e izay o tane ila’eo;","poem":1},{"lineBreak":true},{"text":"tsy fohi’ iereo o nafè’eo.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià.","poem":1}]}],"footnotes":[{"noteId":62,"caller":"+","text":"Kità: Karazam-bare-boley","reference":{"chapter":147,"verse":14}},{"noteId":63,"caller":"+","text":"Rom 2:20, 3:2, 9:4","reference":{"chapter":147,"verse":19}}]},"thisChapterLink":"/api/tdx_sle/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}