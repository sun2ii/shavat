,{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toe noriza’e tsy ho modo nainai’e;","poem":1},{"lineBreak":true},{"text":"nampijadoñe lily tsy ho lilareñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rengeo t’Iehovà boak’ an-tane","poem":1},{"lineBreak":true},{"text":"ry fañane jabajaba an-driak’ ao","poem":1},{"lineBreak":true},{"text":"naho ry laleke iabio,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ry helatse naho havandra,","poem":1},{"lineBreak":true},{"text":"fanala naho tsìtsiñe,","poem":1},{"lineBreak":true},{"text":"ry tio-bey mañeneke o tsara’eo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ry vohitseo naho ze hene haboañe,","poem":1},{"lineBreak":true},{"text":"o hatae miregoregoo naho","poem":1},{"lineBreak":true},{"text":"o mendoraveñe iabio","poem":1},{"noteId":64},{"text":",","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ry biby lio naho ze fonga hare,","poem":1},{"lineBreak":true},{"text":"ry biby milalio naho voroñe mitiliñeo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ry mpanjaka’ ty tane toio","poem":1},{"lineBreak":true},{"text":"naho ze kila ondaty,","poem":1},{"lineBreak":true},{"text":"ry roandriañe naho mpifehe’ ty tane toio,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ry ajalahy naho somondrarao, ry androanavy naho ajajao;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hene mibango ty tahina’ Iehovà;","poem":1},{"lineBreak":true},{"text":"fa i tahina’ey avao ro onjoneñe;","poem":1},{"lineBreak":true},{"text":"ambone’ ty tane toy","poem":1},{"lineBreak":true},{"text":"naho o likerañeo ty enge’e.","poem":1},{"lineBreak":true},{"text":"Ty enge’ o noro’e iabio,","poem":1},{"lineBreak":true},{"text":"o ana’ Israeleo ‘nio,","poem":1},{"lineBreak":true},{"text":"ondaty marine azeo.","poem":1},{"lineBreak":true},{"text":"Treño t’Ià!","poem":1}]}],"footnotes":[{"noteId":64,"caller":"+","text":"Eretse: hatae bey","reference":{"chapter":148,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":13}