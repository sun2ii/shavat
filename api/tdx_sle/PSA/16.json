rambesen-tsoñiko","poem":1},{"lineBreak":true},{"text":"o añara’ iareoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iehovà ro anjara-lovako","poem":1},{"lineBreak":true},{"text":"naho ty fitoviko.","poem":1},{"lineBreak":true},{"text":"Tohañe’o ty navike ho ahiko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"An-toetse fanjaka ty nipoha’ o taly","poem":1},{"lineBreak":true},{"text":"ho ahikoo; Eka, soa i lovakoy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Andriañeko t’Iehovà mpamere ahiko,","poem":1},{"lineBreak":true},{"text":"ie haleñe, anare’ ty troko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Najadoko aoloko nainai’e t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Ie ty an-tañako havana eo,","poem":1},{"lineBreak":true},{"text":"tsy higavingaviñe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa le tsy mahay avao ty troko,","poem":1},{"lineBreak":true},{"text":"vaho mirebeke ty havokarako;","poem":1},{"lineBreak":true},{"text":"mierañerañe ka ty sandriko,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"amy te tsy hapo’o an-tsikeokeok’ ao ty fiaiko,","poem":1},{"lineBreak":true},{"text":"vaho tsy hado’o hahaoni-pihomahañe i Masi’oy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampaharofoana’o ahiko","poem":1},{"lineBreak":true},{"text":"ty lalan-kaveloñe;","poem":1},{"lineBreak":true},{"text":"lifotse hafaleañe ty añatrefa’o;","poem":1},{"lineBreak":true},{"text":"haravoravoañe nainai’e","poem":1},{"lineBreak":true},{"text":"ro am-pitàn-kavana’o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}