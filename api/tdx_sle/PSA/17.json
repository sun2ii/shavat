{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":17,"content":[{"type":"heading","content":["Halali’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Janjiño ty fahiti’e, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"haoño ty fitoreoko,","poem":1},{"lineBreak":true},{"text":"anoloro ravembia ty halaliko","poem":1},{"lineBreak":true},{"text":"boak’an-tsoñy tsy amam-pìtake!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ampionjono boak’ añatrefa’o eo","poem":1},{"lineBreak":true},{"text":"ty añomezan-to ahiko !","poem":1},{"lineBreak":true},{"text":"Ampivazoho mahity o fihaino’oo !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nitsohe’o ty troko,","poem":1},{"lineBreak":true},{"text":"naho nitilihe’o te haleñe","poem":1},{"lineBreak":true},{"text":"naho nadiñe’o,","poem":1},{"lineBreak":true},{"text":"vaho tsy nahavazoho","poem":1},{"lineBreak":true},{"text":"ty tsy mañeva miakatse am-bavako.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa ty amo sata’ ondatio,","poem":1},{"lineBreak":true},{"text":"o tsaram-pivimbi’oo ro nambenako","poem":1},{"lineBreak":true},{"text":"tsy hombàko ty lala’ o masia-menao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa mifahatse amo lala’oo o liakoo, tsy midorasitse o tombokoo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho kanjieko irehe, amy te toiñe’o","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"atokilaño mb’amako o","poem":1},{"lineBreak":true},{"text":"ravembia’oo, janjiño o tarokoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aboaho an-kasoa ty fiferenaiña’o,","poem":1},{"lineBreak":true},{"text":"Le rombaho am-pità’o havana","poem":1},{"lineBreak":true},{"text":"amo miatreatreo, o mitsolok’ama’oo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Faharo iraho hoe te saintem-pihaino’o!","poem":1},{"lineBreak":true},{"text":"aetaho añalon-talinjon-ela’o ao;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ty amo lo-tsereke mamaokeo,","poem":1},{"lineBreak":true},{"text":"o rafelahiko mpañoho-doza","poem":1},{"lineBreak":true},{"text":"miarikoboñe ahikoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nakiti’ iereo o tro’ iareo von­drakeo;","poem":1},{"lineBreak":true},{"text":"mivola ­firengevohañe o vava’ iareoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa sinarokoho’ iareo o lia’aio henaneo;","poem":1},{"lineBreak":true},{"text":"nikirofeñe maso hametsake anay an-tane eo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manahake ty liona","poem":1},{"lineBreak":true},{"text":"milelalela t’ie handrimitse,","poem":1},{"lineBreak":true},{"text":"hoe liona tora’e mipiapia añ’etak’ ao,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Miongaha, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"atreatréo, goreo ambane!","poem":1},{"lineBreak":true},{"text":"Hahao amo lo-tserekeo ty fiaiko,","poem":1},{"lineBreak":true},{"text":"amy fibara’oy,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"am’ondatio—am-pità’o ry Iehovà—","poem":1},{"lineBreak":true},{"text":"am’ ondati’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"fa an-kaveloñe atoy avao ty anjara’e;","poem":1},{"lineBreak":true},{"text":"ie vontsiñe’o amo vara’oo o fisafoa’eo; henek’ anake iereo; vaho ampandova’ iareo an-tiri’ iareo ty nivokara’ iareo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naho izaho, ho treako an-kavañonañe ao ty lahara’o; hifale iraho te tsekake","poem":1},{"lineBreak":true},{"text":"mahatrea ty vinta’o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}