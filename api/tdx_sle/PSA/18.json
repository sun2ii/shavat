m":1},{"lineBreak":true},{"text":"le ho nandimpotse ahy","poem":1},{"lineBreak":true},{"text":"ty fisorotombaha’ i Beliale","poem":1},{"noteId":6},{"text":";","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Namolonkoñe ahy","poem":1},{"lineBreak":true},{"text":"o vaham-pihomahañeo,","poem":1},{"lineBreak":true},{"text":"niatreatre ahy o fandrin-kavilasio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nikoike Iehovà t’ie nalovilovy,","poem":1},{"lineBreak":true},{"text":"nikaik’ imba aman’ Añahareko;","poem":1},{"lineBreak":true},{"text":"jinanji’e an-kivoho’e ao ty feoko;","poem":1},{"lineBreak":true},{"text":"vaho niheo añatrefa’e an-dravembia’e,","poem":1},{"lineBreak":true},{"text":"ty toreoko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niezeñezeñe vaho nihitikitike","poem":1},{"lineBreak":true},{"text":"amy zao ty tane;","poem":1},{"lineBreak":true},{"text":"niozoñozoñe naho nanginikinike","poem":1},{"lineBreak":true},{"text":"ty faha’ o vohitseo amy fifombo’ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Niforoake hatoeñe o fiantsona’eo","poem":1},{"lineBreak":true},{"text":"naho boak’ am-palie’e ao","poem":1},{"lineBreak":true},{"text":"ty afo nahaforototo,","poem":1},{"lineBreak":true},{"text":"nahasolebatse ty foroha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nazè’e ka i likerañey vaho nizotso;","poem":1},{"lineBreak":true},{"text":"ieñe mangonkòñe","poem":1},{"lineBreak":true},{"text":"ty tambane’ o fandia’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Niningira’e ty kerobe","poem":1},{"noteId":7},{"text":"le nitiliñe;","poem":1},{"lineBreak":true},{"text":"eka nibirirìñe añ’ela’ i tiokey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nanoe’e fietahañe","poem":1},{"lineBreak":true},{"text":"ty hamoromoroñañe;","poem":1},{"lineBreak":true},{"text":"ho kibohotse hañohok’ aze,","poem":1},{"lineBreak":true},{"text":"ty hangonkòn-drano,","poem":1},{"lineBreak":true},{"text":"ty rahoñe migoboñe an-dikerañe ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niboroboñak’ amo rahoñe milodolodoo ty havandra naho foroha mirekake","poem":1},{"lineBreak":true},{"text":"amy fireandreañe añatrefa’ey,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nañàmpiñe an-dike­rañe ao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"nampipoña-piarañanañañe","poem":1},{"lineBreak":true},{"text":"t’i Andindimoneñe;","poem":1},{"lineBreak":true},{"text":"havandra gadaboñe","poem":1},{"lineBreak":true},{"text":"naho foroha mirebareba.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nahì’e mb’eo o ana-pàle’eo,","poem":1},{"lineBreak":true},{"text":"le nampivarakaihe’e;","poem":1},{"lineBreak":true},{"text":"nampiriaria’e ty helatse","poem":1},{"lineBreak":true},{"text":"vaho nampivalitsikotahe’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Niboak’ amy zao o kadahan-dranoo, nikorendake o faha’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"ami’ty fitrevo’o ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ami’ty fitorotosi’ ty kofòm-piantsona’o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nirahe’e boak’añ’abo eñe,","poem":1},{"lineBreak":true},{"text":"le rinambe’e iraho;","poem":1},{"lineBreak":true},{"text":"sininto’e boak’ an-drano maro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Rinomba’e amy rafelahiko maozatsey,","poem":1},{"lineBreak":true},{"text":"amo malaiñe ahikoo,","poem":1},{"lineBreak":true},{"text":"amy t’ie nifatratse te amako.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Natretré’ iereo amy andro naha-ampohek’ ahikoy, fe nañolots’ ahiko t’Iehovà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nampionjone’e mb’an-toetse","poem":1},{"lineBreak":true},{"text":"mangadagadan-draho,","poem":1},{"lineBreak":true},{"text":"hinaha’e amy te no’e.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nanambe ahiko ami’ty","poem":1},{"lineBreak":true},{"text":"havantañako t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ami’ty halio tañako ro nañavaha’e ahiko.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Amy te ambenako o lala’ Iehovào;","poem":1},{"lineBreak":true},{"text":"vaho tsy mivik’ aman’Añahareko","poem":1},{"lineBreak":true},{"text":"am-bodongeron-draho.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hene tañatrefako o taro’eo,","poem":1},{"lineBreak":true},{"text":"le tsy nampisitaheko amako o fañè’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tokan-tro ama’e iraho,","poem":1},{"lineBreak":true},{"text":"vaho milie-batañe tsy hanao sida;","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aa le tinambe’ Iehovà amy havañonakoy,","poem":1},{"lineBreak":true},{"text":"ami’ty falio-tañako am-pivazohoa’e.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ami’ty mitretre","poem":1},{"lineBreak":true},{"text":"ro iboaha’o ho mpiferenaiñe,","poem":1},{"lineBreak":true},{"text":"ami’ty vañoñe","poem":1},{"lineBreak":true},{"text":"ro iboaha’o ho vantañe,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ami’ty mikanitsoke","poem":1},{"lineBreak":true},{"text":"ro iboaha’o ho ki’e.","poem":1},{"lineBreak":true},{"text":"vaho ami’ty mengoke","poem":1},{"lineBreak":true},{"text":"ro iboaha’o ho minironiroke.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Toe rombahe’o ty tretram-po,","poem":1},{"lineBreak":true},{"text":"fe arè’o o maso mitahèbokeo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ihe ro mamiañe ty jiroko,","poem":1},{"lineBreak":true},{"text":"mampazava o iekoo","poem":1},{"lineBreak":true},{"text":"ry Iehovà Andrianañahareko.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ihe ro hañoridañako","poem":1},{"lineBreak":true},{"text":"ty firimboñan-dahin-defoñe;","poem":1},{"lineBreak":true},{"text":"mahavokon-jolok’ ahy","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahareko.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aa naho i Andrianañahare!","poem":1},{"lineBreak":true},{"text":"hiringiri’e ty lala’e","poem":1},{"noteId":8},{"text":",","poem":1},{"lineBreak":true},{"text":"niventeañe","poem":1},{"noteId":9},{"text":"o fepè’ Iehovào;","poem":1},{"lineBreak":true},{"text":"Ie ty Mpañaro’ ze hene miato ama’e","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ia t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"naho tsy Iehovà?","poem":1},{"lineBreak":true},{"text":"Ia ty lamilamy naho tsy","poem":1},{"lineBreak":true},{"text":"i Andrianañaharen-tikañey?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"T’i Andrianañahare mpanìkiñe","poem":1},{"lineBreak":true},{"text":"ahy an-kaozarañe,","poem":1},{"lineBreak":true},{"text":"vaho mpamantañe ty liako.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ampanahafe’e amo tombom-panalokeo","poem":1},{"noteId":10},{"text":"o tombokoo,","poem":1},{"lineBreak":true},{"text":"avotra’e amo haboakoo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Aò’e hifandrapake o tañakoo,","poem":1},{"lineBreak":true},{"text":"mahavohotse fale torisìke o sirakoo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Natolo’o ahy ka","poem":1},{"lineBreak":true},{"text":"ty fikalan-defom-pandrombaha’o;","poem":1},{"lineBreak":true},{"text":"naho nanozañe ahy","poem":1},{"lineBreak":true},{"text":"ty fitàn-kavana’o,","poem":1},{"lineBreak":true},{"text":"nampionjoñe ahiko","poem":1},{"lineBreak":true},{"text":"ty hamoran’ arofo’o.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Nihalavae’o ty fandingàñako ambaneko eo, fe tsy nidorasitse o tombokoo.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Nihoridañeko o rafelahikoo le nahatratse,","poem":1},{"lineBreak":true},{"text":"tsy himpoly iraho naho tsy t’ie fonga rotsake.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ie tinomboko tsy hiongake ka,","poem":1},{"lineBreak":true},{"text":"nikorovok’ ambane’ tomboko eo.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Fa nampidiañe’o amako ty haozarañe hialiako","poem":1},{"lineBreak":true},{"text":"naho ampiandalie’o amako","poem":1},{"lineBreak":true},{"text":"o miatreatre ahikoo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Nampitolihe’o amako ty hàto’","poem":1},{"lineBreak":true},{"text":"o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"vaho rinotsako o malaiñ’ahikoo.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Nikaike iereo,","poem":1},{"lineBreak":true},{"text":"fe tsy amam-pandrombake—","poem":1},{"lineBreak":true},{"text":"am’Iehovà, fe tsy tinoi’e.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Aa le dinemodemoko ho deboke,","poem":1},{"lineBreak":true},{"text":"haboelen-tioke iereo,","poem":1},{"lineBreak":true},{"text":"nariako hoe litsak’ an-dalañe ey.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Vinotso’o ami’ty fioliñoliña’ ondatio iraho, le nampifehè’o ahy o fifelehañeo;","poem":1},{"lineBreak":true},{"text":"mitoroñe ahy ondaty nofikoo.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Vata’e mahajanjiñe iereo,","poem":1},{"lineBreak":true},{"text":"le manoiñe ahy.","poem":1},{"lineBreak":true},{"text":"mitsolofìñe amako o anan-drenetaneo.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Minik’ avao o anan’ambahinio,","poem":1},{"lineBreak":true},{"text":"le mihondrahondra t’ie miakatse","poem":1},{"lineBreak":true},{"text":"am-pitsifira’e ao.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Veloñe t’Iehovà !","poem":1},{"lineBreak":true},{"text":"Andriaño i lamilamikoy!","poem":1},{"lineBreak":true},{"text":"onjoneñe t’i Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahañe ahiko,","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"i Andrianañahare mpamale-fate","poem":1},{"lineBreak":true},{"text":"ho ahiy,","poem":1},{"lineBreak":true},{"text":"naho mampiandaly ondatio","poem":1},{"lineBreak":true},{"text":"ambaneko eo,","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Haha’e amo rafelahikoo iraho,","poem":1},{"lineBreak":true},{"text":"toe onjone’o ambone’","poem":1},{"lineBreak":true},{"text":"o mpitroatse amakoo,","poem":1},{"lineBreak":true},{"text":"vaho avotso’o am’ ondaty","poem":1},{"lineBreak":true},{"text":"mitrotrofiakeo.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Aa le handriañeko amo fifeheañeo irehe ry Iehovà;","poem":1},{"lineBreak":true},{"text":"vaho ho saboeko ty Tahina’o.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ra’elahy ty fandrombahañe","poem":1},{"lineBreak":true},{"text":"atolo’e amy mpanjaka’ey;","poem":1},{"lineBreak":true},{"text":"vaho iferenaiña’e i noriza’ey,","poem":1},{"lineBreak":true},{"text":"i Davide naho i tarira’ey nainai’e donia.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Beliale: Halò-tserehañe, i mpañinjey","reference":{"chapter":18,"verse":4}},{"noteId":7,"call