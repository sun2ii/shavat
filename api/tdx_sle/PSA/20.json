{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":20,"content":[{"type":"heading","content":["Ho a i Talèn-tsakera. Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Hanoiñ’azo an-tsan-kasotriañe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hañonjoñ’ azo ankaboañe ey","poem":1},{"lineBreak":true},{"text":"ty tahinan’ Añahare’ Iakobe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hañitrifa’e imba","poem":1},{"lineBreak":true},{"text":"boak’amy toe-miavakey","poem":1},{"lineBreak":true},{"text":"hanohañ’ azo hirik’e Tsiône ao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho tiahi’e o enga-mahakama iabio, vaho hiantofa’e o fisoroña’oo! Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hatolots’ azo ze salalan’ arofo’o","poem":1},{"lineBreak":true},{"text":"le ho henefeñe iaby o ereñere’oo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho poñafe’ay rebeke ty fandrombaha’o,","poem":1},{"lineBreak":true},{"text":"ty tahinan’Añahare’ay","poem":1},{"lineBreak":true},{"text":"ro añelahelà’ay kobaiñe;","poem":1},{"lineBreak":true},{"text":"ho henefa’ Iehovà abey o halali’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apotako henaneo,","poem":1},{"lineBreak":true},{"text":"te ho rombahe’ Iehovà i noriza’ey;","poem":1},{"lineBreak":true},{"text":"ho toiñe’e boak’ an-dindi’e masiñe ao,","poem":1},{"lineBreak":true},{"text":"amy haozaram-pandrombaha’","poem":1},{"lineBreak":true},{"text":"i fitàn-kavana’eiy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Miato an-tsarete o ila’eo,","poem":1},{"lineBreak":true},{"text":"an-tsoavala ka ty ila’e;","poem":1},{"lineBreak":true},{"text":"fa ho tiahi’ay ty tahina’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nibokoke iereo naho nikorovoke","poem":1},{"lineBreak":true},{"text":"mitroatse zahay vaho mijohañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rombaho, ry Iehovà;","poem":1},{"lineBreak":true},{"text":"hanoiñe abey i mpanjakay te kanjie’ay!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}