,"poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mañonjoñe ty enge’e o fandreketa’oo,","poem":1},{"lineBreak":true},{"text":"nanampeza’o asiñe naho volonahetse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nampiraoraoe’o nainai’e;","poem":1},{"lineBreak":true},{"text":"Ampirebehe’o ami’ty hafaleañe","poem":1},{"lineBreak":true},{"text":"añ’atrefa’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iatoa’ i mpanjakay t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie tsy ho ronjeronjeñe ty amy","poem":1},{"lineBreak":true},{"text":"fiferenaiña’ i Andindimoneñey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho onim-pità’o ze hene rafelahi’o;","poem":1},{"lineBreak":true},{"text":"ho takarem-pitàn-kavana’o","poem":1},{"lineBreak":true},{"text":"o malaiñe azoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hampanahafe’o ami’ty toñake","poem":1},{"lineBreak":true},{"text":"mirekake iereo","poem":1},{"lineBreak":true},{"text":"an-tsam-piforoforoa’o;","poem":1},{"lineBreak":true},{"text":"hagodra’ Iehovà an-kaviñerañe,","poem":1},{"lineBreak":true},{"text":"vaho ho forototoe’ ty afo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ho mongore’o an-tane atoy","poem":1},{"lineBreak":true},{"text":"o tarira’ iereoo,","poem":1},{"lineBreak":true},{"text":"naho o tiri’iareoo amo ana’ondatio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nikilily raty azo iereo,","poem":1},{"lineBreak":true},{"text":"nikitroke haratiañe ama’o,","poem":1},{"lineBreak":true},{"text":"f’ie tsy ho lefe,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hampiambohoe’o iereo","poem":1},{"lineBreak":true},{"text":"Ampibitsohe’o fale o lahara’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mionjona ry Iehovà an-kaozara’o !","poem":1},{"lineBreak":true},{"text":"Ho saboe’ay naho ho bangoa’ay","poem":1},{"lineBreak":true},{"text":"ty hafatrara’o!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}