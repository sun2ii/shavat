{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":22,"content":[{"type":"heading","content":["y Ho a i Talèn-tsakera ami’ty feo : Ty Hirañe22:0 Heb: diera ami’ty manjirik’andro Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"ino ty namorintseña’o ahiko?","poem":1},{"lineBreak":true},{"text":"Ihe nitotse ami’ty fañimbàñ’ahy,","poem":1},{"lineBreak":true},{"text":"amo volam-pitoreovakoo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"koiheko handro, fe tsy toiñe’o;","poem":1},{"lineBreak":true},{"text":"haleñe, fe tsy mijanjiñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toe masin-dRehe,","poem":1},{"lineBreak":true},{"text":"imoneña’o ty fandrengea’ Israele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ama’o ty niatoan-droae’ay;","poem":1},{"lineBreak":true},{"text":"niantoke iereo, le navotso’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nikoaik’ ama’o, le nihahàñe;","poem":1},{"lineBreak":true},{"text":"niato ama’o, le tsy nisalatse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oletse iraho, fa tsy ondaty;","poem":1},{"lineBreak":true},{"text":"fosae’ raolombelo, naho mavoe’ ondatio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mañinje ahy am-piankahafañe","poem":1},{"lineBreak":true},{"text":"hene mitari-tsoñy ze mahaoniñ’ahy,","poem":1},{"lineBreak":true},{"text":"vaho mikofikofi-doha, ami’ty hoe:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Angao hiatoa’e t’Iehovà!","poem":1},{"lineBreak":true},{"text":"Ie ro hañaha aze;","poem":1},{"lineBreak":true},{"text":"apoho hasinta’e kanao noro’e!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa Ihe ro nañakatse Ahy an-koviñe ao;","poem":1},{"lineBreak":true},{"text":"naho nampatokisa’o","poem":1},{"lineBreak":true},{"text":"tam-patroan-dreneko eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nafetsak’ ama’o iraho te niterake.","poem":1},{"lineBreak":true},{"text":"Andrianañahareko irehe","poem":1},{"lineBreak":true},{"text":"tan-kovin-dreneko ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ko mitotse amako,","poem":1},{"lineBreak":true},{"text":"fa antitotse o feh’ ohatseo,","poem":1},{"lineBreak":true},{"text":"vaho tsy amam-pañolotse.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mañarikatok’ ahiko o añombe-lahio;","poem":1},{"lineBreak":true},{"text":"o maoza’ i Basaneo ro mañarikoboñ’ ahy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Itañataña’ iareo vava,","poem":1},{"lineBreak":true},{"text":"manahake ty fireñetan-diona mañaolo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nadoañe hoe rano iraho,","poem":1},{"lineBreak":true},{"text":"mikalitroke iaby o taolakoo;","poem":1},{"lineBreak":true},{"text":"fa karafo’ tantele ty troko,","poem":1},{"lineBreak":true},{"text":"mitranak’ añ’ovako ao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mipike hoe tsilam-balàñe-tane","poem":1},{"lineBreak":true},{"text":"o ozakoo,","poem":1},{"lineBreak":true},{"text":"mipitek’ an-dañilañiko ty lelako;","poem":1},{"lineBreak":true},{"text":"le nampandrea’o an-debo-kavilasy ao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Miarikoboñe ahy o amboao;","poem":1},{"lineBreak":true},{"text":"misarokohok’ amako","poem":1},{"lineBreak":true},{"text":"ty kidìm-panao raty;","poem":1},{"lineBreak":true},{"text":"fa trinofa’ iereo o tañakoo","poem":1},{"lineBreak":true},{"text":"naho o tombokoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mahaìake o taolako iabio iraho,","poem":1},{"lineBreak":true},{"text":"sambae’ iareo, harefe’ iareo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ifanjarà’ iareo o sikikoo,","poem":1},{"lineBreak":true},{"text":"ifanoe’iereo tsato-piso i sarokoy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"F’ihe, ry Iehovà, ko mihak’ amako,","poem":1},{"lineBreak":true},{"text":"ry Mpañimba, malisà hañolots’ahy!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Avotsoro amy fibaray ty fiaiko,","poem":1},{"lineBreak":true},{"text":"ty troko sarotse","poem":1},{"lineBreak":true},{"text":"ami’ty fisorodidian’ amboa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hahao iraho am-bavan-diona!","poem":1},{"lineBreak":true},{"text":"Toiño ty amo tsifan-drimoo!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho taroñeko an-drolongoko","poem":1},{"lineBreak":true},{"text":"ty tahina’o;","poem":1},{"lineBreak":true},{"text":"ho rengeako añivo’ i fivoriy.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ry mpañeveñe am’ Iehovào : irengeo !","poem":1},{"lineBreak":true},{"text":"ry hene’ tiri’ Iakobeo, ijejò,","poem":1},{"lineBreak":true},{"text":"irevendreveño, ry afe’ Israeleo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amy te tsy nimavoe’e, tsy nampangorý aze ty hasotria’ o misotrio;","poem":1},{"lineBreak":true},{"text":"naho tsy nañetaha’e laharañe,","poem":1},{"lineBreak":true},{"text":"vaho jinanji’e t’ie nitoreo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Boak’ ama’o ty saboko","poem":1},{"lineBreak":true},{"text":"am-pivory bey ao;","poem":1},{"lineBreak":true},{"text":"havahako añatrefa’ ze mañeveñ’","poem":1},{"lineBreak":true},{"text":"ama’o o nifantàkoo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hikama o rarakeo le ho anjañe;","poem":1},{"lineBreak":true},{"text":"ho rengè’ o mipay azeo t’Iehovà;","poem":1},{"lineBreak":true},{"text":"ho veloñe nainai’e ty arofo’ areo !","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Songa hahatiahy naho hitolik’ am’","poem":1},{"lineBreak":true},{"text":"Iehovà o olon-taneo,","poem":1},{"lineBreak":true},{"text":"sindre hitalaho añatrefa’o","poem":1},{"lineBreak":true},{"text":"ty hasavereña’ ze kila’ ondaty.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A Iehovà i fifeheañey,","poem":1},{"lineBreak":true},{"text":"Ie ty mpameleke o kilakila ondatio","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Hikama naho hitalaho","poem":1},{"lineBreak":true},{"text":"ze hene miraorao an-tane atoy;","poem":1},{"lineBreak":true},{"text":"fonga hibokok’ añatrefa’e","poem":1},{"lineBreak":true},{"text":"o mizotso mb’an-debokeo;","poem":1},{"lineBreak":true},{"text":"vaho ze tsy mahatam-beloñe.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Hitoroñ’ Aze ty tiri’e;","poem":1},{"lineBreak":true},{"text":"ho talilieñe amy tariratse","poem":1},{"lineBreak":true},{"text":"manonjohiy i Talè,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Homb’eo iereo hitalily ty havantaña’e am’ondaty mbe hasamakeo—","poem":1},{"lineBreak":true},{"text":"t’ie nahafonitse.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}