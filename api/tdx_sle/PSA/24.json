{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":24,"content":[{"type":"heading","content":["Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"A Iehovà ty tane toy naho ty halifora’e, ty voatse toy,","poem":1},{"lineBreak":true},{"text":"naho o mpimoneñe ama’eo;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa najado’e ambone’ o riakeo,","poem":1},{"lineBreak":true},{"text":"vaho naore’e am-pisorotombahañe eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ia ty hahafitroatse","poem":1},{"lineBreak":true},{"text":"mb’am-bohi’ Iehovà ey?","poem":1},{"lineBreak":true},{"text":"Ia ty hijohañe an-toe’e miavake ao?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ty amam-pitàñe malio","poem":1},{"lineBreak":true},{"text":"naho amañ’arofo ki’e,","poem":1},{"lineBreak":true},{"text":"tsy mañonjoñe ty fiai’e","poem":1},{"lineBreak":true},{"text":"mb’ami’ty tsy vente’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy mifanta am-pamañahiañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Handrambe fitahiañe am’ Iehovà re,","poem":1},{"lineBreak":true},{"text":"naho havantañañe amy Andrianañaharem-pandrombahañe azey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Izay ty tarira’ o mipay Azeo,","poem":1},{"lineBreak":true},{"text":"ie mitsoeke ty lahara’o—","poem":1},{"lineBreak":true},{"text":"Iakobe ‘nio. Selà","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ampiandrao o loha’ areoo, ry lalambey! Miongaha, ry lalañe haehaeo!","poem":1},{"lineBreak":true},{"text":"Hiziliha’ i Mpanjaka rengeñey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ia i Mpanjaka rengeñey?","poem":1},{"lineBreak":true},{"text":"Iehovà maozatse naho fatratse,","poem":1},{"lineBreak":true},{"text":"Iehovà Lahifihatiy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampiandrao o loha’ areoo,","poem":1},{"lineBreak":true},{"text":"ry lalambey !","poem":1},{"lineBreak":true},{"text":"Eka, miongaha, ry lalañe haehaeo!","poem":1},{"lineBreak":true},{"text":"Hiziliha’ i Mpanjaka rengeñey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ia i Mpanjaka rengeñey?","poem":1},{"lineBreak":true},{"text":"Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"Ie ty Mpanjaka rengeñe. Selà","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}