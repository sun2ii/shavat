{"text":"ה Iaolò ami’ty hatò’o, le anaro;","poem":1},{"lineBreak":true},{"text":"Ihe Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"Pandrombahañe ahy;","poem":1},{"lineBreak":true},{"text":"Ihe ro fitamàko lomoñandro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ו Tiahio ry Iehovà ty fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"naho ty hafatram-pikokokoa’o,","poem":1},{"lineBreak":true},{"text":"ie fa toe haehae.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ז Ko tiahie’o o ­hakeom-paha-torakoo","poem":1},{"lineBreak":true},{"text":"naho o fiolàkoo,","poem":1},{"lineBreak":true},{"text":"fe tiahio ankalèn’arofo’o,","poem":1},{"lineBreak":true},{"text":"ami’ty hatrentra’o, ry Iehovà,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ח Soa naho vantañ’arofo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"izay ty anoroa’e o manan-tahiñeo","poem":1},{"lineBreak":true},{"text":"i lalañey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ט Iaoloa’e ami’ty hatò o mpirèkeo, vaho anare’e amo sata’eo ty tretram-po.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"י Songa fiferenaiñañe","poem":1},{"lineBreak":true},{"text":"naho figahiñañe o lala’ Iehovào,","poem":1},{"lineBreak":true},{"text":"amo mpiambeñe i fañina’ey","poem":1},{"lineBreak":true},{"text":"naho o taro’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"כ Amy tahina’oy, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"apoho o hakeokoo, fa bey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ל Ia ty’ ndaty mañeveñe am’Iehovà?","poem":1},{"lineBreak":true},{"text":"ho toroa’e ty lalan-tsoa ho joboñe’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"מ Hiaiñ’añ’oleñañe ty fiai’e;","poem":1},{"lineBreak":true},{"text":"handova i taney o tarira’eo","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"נ Avere’ Iehovà o mañeveñe ama’eo;","poem":1},{"lineBreak":true},{"text":"le ampahafohine’e iareo i fañina’ey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ס Mitolike mb’am’ Iehovà","poem":1},{"lineBreak":true},{"text":"nainai’e o masokoo,","poem":1},{"lineBreak":true},{"text":"amy te Ie ro mañakats’ o tombokoo","poem":1},{"lineBreak":true},{"text":"ami’ty harato.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ע Mitoliha amako le iferenaiño, fa mijorìñe naho misotry.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"צ Miebotse ty haemberan-troko,","poem":1},{"lineBreak":true},{"text":"afaho amo hasosorakoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ק Vazohò ty hasotriako","poem":1},{"lineBreak":true},{"text":"naho ty falovoloiako;","poem":1},{"lineBreak":true},{"text":"vaho apoho o hakeokoo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ר Vazoho o rafelahikoo, te maro;","poem":1},{"lineBreak":true},{"text":"heje’ iareo am-palai-mena iraho.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ש Ambeno o fiaikoo, hahao,","poem":1},{"lineBreak":true},{"text":"le ko ado’o ho salareñe,","poem":1},{"lineBreak":true},{"text":"amy te Ihe ro fipalirako.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ת Hañaro ahy o havañonañeo","poem":1},{"lineBreak":true},{"text":"naho o havantañañeo;","poem":1},{"lineBreak":true},{"text":"fa mitamà Azo iraho.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"פ Jebaño t’Israele,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare","poem":1},{"lineBreak":true},{"text":"amo haembera’e iabio","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}