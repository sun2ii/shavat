{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":26,"content":[{"type":"heading","content":["Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Meo to iraho, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"fa mitrantràñe ami’ty havañonako;","poem":1},{"lineBreak":true},{"text":"tsy nifejofejo ty fiatoako am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho tsy hasiotse iraho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Biribirio iraho ry Iehovà vaho tsoho;","poem":1},{"lineBreak":true},{"text":"hotsohotsò ty añ’ovako naho an-troko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aolo’ o masokoo ty fiferenaiña’o,","poem":1},{"lineBreak":true},{"text":"vaho manjotik’ amo figahiña’oo iraho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy fitraofako toboke o mpamañahio, naho tsy fiharoako fijelanjelañe","poem":1},{"lineBreak":true},{"text":"o soamiatrekeo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hejeko ty fifañosoña’ o tsivokatseo,","poem":1},{"lineBreak":true},{"text":"vaho tsy fitraofako toboke","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hanasa tañañ’ an-kalio tahin-draho,","poem":1},{"lineBreak":true},{"text":"vaho harikohoeko ty kitreli’o ry Iehovà,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho poñafeko ty feom-pañandriañañe,","poem":1},{"lineBreak":true},{"text":"ho talilieko iaby o fitoloña’o fanjakao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà, teako ty fimoneñañe","poem":1},{"lineBreak":true},{"text":"añ’anjomba’o ao,","poem":1},{"lineBreak":true},{"text":"naho i kivoho fañialoañ’ enge’oy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko aharo’o fitontoñe amo","poem":1},{"lineBreak":true},{"text":"mpanan-kakeoo ty troko,","poem":1},{"lineBreak":true},{"text":"ndra ty fiaiko am’ondaty mampiori-dioo;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"o mitan-kilily an-taña’eo,","poem":1},{"lineBreak":true},{"text":"ie pea vokàñe ty an-taña’e havana ao;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa naho izaho, hitsontik’ an-kalio-tahiko; jebaño,","poem":1},{"lineBreak":true},{"text":"vaho matariha amako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mijohañe an-tane mira ty tomboko;","poem":1},{"lineBreak":true},{"text":"andriañeko am-pivory ao t’Iehovà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}