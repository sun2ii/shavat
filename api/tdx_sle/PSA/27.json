{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":27,"content":[{"type":"heading","content":["Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Hazavàko naho fandrombahako t’Iehovà, ia ty ihembañako?","poem":1},{"lineBreak":true},{"text":"Fipaliram-piaiko t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ia ty hirevendreveñako?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie niambotrak’ amako o lo-tsere­keo hampibotseke o nofokoo;","poem":1},{"lineBreak":true},{"text":"le nitsikapy vaho nikorovoke","poem":1},{"lineBreak":true},{"text":"o malaiñ’ahio naho o rafelahikoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndra te hitobe hiatreatre ahy","poem":1},{"lineBreak":true},{"text":"ty firimboñañe,","poem":1},{"lineBreak":true},{"text":"tsy ho vorombeloñe ty troko;","poem":1},{"lineBreak":true},{"text":"ndra te hitroatse amako ty hotakotake, mbe hitam-patokisañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Raha raike ty nihalalieko am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"izay ty ho paiaeko :","poem":1},{"lineBreak":true},{"text":"ty hitobohako añ’anjomba’ Iehovà ao","poem":1},{"lineBreak":true},{"text":"ze hene andro ivelomako,","poem":1},{"lineBreak":true},{"text":"hahatrea ty hasoa-vinta’ Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hañontàne añ’akiba’e ao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ampipalira’e an-kijà’e ao t’ie","poem":1},{"lineBreak":true},{"text":"an-tsam-poheke,","poem":1},{"lineBreak":true},{"text":"akafi’e am-poreforetan-Kivoho’e ao;","poem":1},{"lineBreak":true},{"text":"ampitongoa’e andigiligin-damilamy eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le honjoneñ’ ambone’ o rafelahiko miariseho ahio ty lohako.","poem":1},{"lineBreak":true},{"text":"vaho ho banabanako soroñe","poem":1},{"lineBreak":true},{"text":"an-drebeke mb’an-kivoho’e ao;","poem":1},{"lineBreak":true},{"text":"ho saboako, eka ho rengèko","poem":1},{"lineBreak":true},{"text":"an-tsabo t’Iehovà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Janjiño ry Iehovà, naho ikaihako am-peo! Iferenaiño vaho toiño.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nitaroñe’o ami’ty foko ty hoe:","poem":1},{"lineBreak":true},{"text":"Paiao ty tareheko;","poem":1},{"lineBreak":true},{"text":"toe ho tsoeheko ty vinta’o, ry Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko aetak’ amako ty lahara’o;","poem":1},{"lineBreak":true},{"text":"ko apo’o an-­kaviñerañe ty mpitoro’o,","poem":1},{"lineBreak":true},{"text":"Ihe mpañolotse ahy ;","poem":1},{"lineBreak":true},{"text":"le ko aitoa’o, naho ko farie’o","poem":1},{"lineBreak":true},{"text":"ry Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahañe ahiko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndra t’ie nadon-drae naho rene,","poem":1},{"lineBreak":true},{"text":"ho rambese’ Iehovà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Anaro ahy ty lala’o, ry Iehovà","poem":1},{"lineBreak":true},{"text":"vaho tehafo mb’an-dalañe mira","poem":1},{"lineBreak":true},{"text":"ty amo rafelahikoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ko asese’o an-tsatri’","poem":1},{"lineBreak":true},{"text":"o malaiñ’ ahio;","poem":1},{"lineBreak":true},{"text":"fa atretréo o mpanara vandeo,","poem":1},{"lineBreak":true},{"text":"naho o mikofòke hasiahañeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hete! atokisako te ho treako","poem":1},{"lineBreak":true},{"text":"an-tanen-kaveloñe ao","poem":1},{"lineBreak":true},{"text":"ty hasoa’ Iehovà—","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Itamao t’Iehovà, mihaozara,","poem":1},{"lineBreak":true},{"text":"le mihafatrara arofo; eka, liñiso t’Iehovà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}