{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":28,"content":[{"type":"heading","content":["Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Ihe, ry Iehovà ro kanjieko,","poem":1},{"lineBreak":true},{"text":"ry Lamilamiko, ko mañovok’ ahy,","poem":1},{"lineBreak":true},{"text":"kera, hianjiñe,","poem":1},{"lineBreak":true},{"text":"le hanahake o mizotso","poem":1},{"lineBreak":true},{"text":"mb’an-tsikeokeok’aoo iraho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Janjiño ty feon-kalaliko","poem":1},{"lineBreak":true},{"text":"naho itoreovako,","poem":1},{"lineBreak":true},{"text":"ie añonjonako sirañe","poem":1},{"lineBreak":true},{"text":"mb’amy anjomba’o miavakey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ko kororohe’o hitraok’ amo","poem":1},{"lineBreak":true},{"text":"lo-tserekeo, amo mpanao raty","poem":1},{"lineBreak":true},{"text":"mivolan-kanitsiñe an-drañe’eo,","poem":1},{"lineBreak":true},{"text":"te mone fikinian-­draty ty am-po’e ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ondroho mira amo sata’eo,","poem":1},{"lineBreak":true},{"text":"naho hambañe ami’ty haratia’ o fitoloña’eo; eka, avaho mira","poem":1},{"lineBreak":true},{"text":"amo satan-taña’eo;","poem":1},{"lineBreak":true},{"text":"valeo ama’e ty mañeva.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amy te tsy haoñe’ iareo","poem":1},{"lineBreak":true},{"text":"o tolon-draha’ Iehovào, ndra o fitoloñam-pità’eo.","poem":1},{"lineBreak":true},{"text":"ho rotsahe’e iereo, le tsy hatroa’e ka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Andriañeñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa jinanji’e ty feon-kalaliko!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iehovà ro haozarako naho fikalako,","poem":1},{"lineBreak":true},{"text":"ty fiatoa’ ty troko,","poem":1},{"lineBreak":true},{"text":"toe fa nimbaen-draho,","poem":1},{"lineBreak":true},{"text":"aa le irebeha’ ty troko","poem":1},{"lineBreak":true},{"text":"vaho rengèko an-tsabo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Haozara’iareo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"kijolim-pandrombahañe i noriza’ey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rombaho ondati’oo,","poem":1},{"lineBreak":true},{"text":"naho ampanintsiño o lova’oo;","poem":1},{"lineBreak":true},{"text":"Araho iereo vaho otroño nainai’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}