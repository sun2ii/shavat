{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":3,"content":[{"type":"heading","content":["Sabo’ i Davide t’ie nirifatse ty lay hisitak’ amy Absolome3:0 Absolome: raem-panintsiñañe Ana’e"]},{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, Akore ty fitomboa’","poem":1},{"lineBreak":true},{"text":"o mpamorefore ahikoo !","poem":1},{"lineBreak":true},{"text":"Maro ty miongake hiatreatre ahy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lako ty manao ty hoe ty amako : Tsy ama’e ty fandrombahan’ Añahare. Selà","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa Ihe, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ro kalan-defo mañohoñ’ ahy, ty engeko","poem":1},{"lineBreak":true},{"text":"naho ty Mpampiandra ty lohako.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie koiheko am-peo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le janjiñe’e amy vohi’e miavakey. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Màndre iraho vaho miroro; tsekake amy te mpañimba ahy t’Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy hembañako i lahiale","poem":1},{"lineBreak":true},{"text":"miarikoboñe hiatreatre ahikoy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Miongaha, ry Iehovà! Rombaho iraho ry Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"fa fonga tinampifi’o ty valañorà’","poem":1},{"lineBreak":true},{"text":"o rafelahikoo;","poem":1},{"lineBreak":true},{"text":"vaho pinekapeka’o ty nife’","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Am’ Iehovà ty fandrombahañe;","poem":1},{"lineBreak":true},{"text":"naho am’ondati’oo ty fitahia’o. Selà","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}