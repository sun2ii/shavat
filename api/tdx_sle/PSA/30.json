{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":30,"content":[{"type":"heading","content":["Sabo; Saboeñe ami’ty Fañorizañe i Anjombay; a i Davide"]},{"type":"verse","number":1,"content":[{"text":"Honjoneko irehe ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ami’ty nañongaha’o ahy, vaho","poem":1},{"lineBreak":true},{"text":"tsy napo’o hitohàke amako o rafelahikoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry Iehovà, Andrianañahareko, nitoreovako le jinanga’o;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ry Iehovà, naonjo’o boak’","poem":1},{"lineBreak":true},{"text":"an-tsikeokeok’ ao ty fiaiko;","poem":1},{"lineBreak":true},{"text":"nahatam-beloñe ahy irehe tsy","poem":1},{"lineBreak":true},{"text":"hizotsoako mb’an-koboñe ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sabò t’Iehovà, ry ondaty noro’eo,","poem":1},{"lineBreak":true},{"text":"andriaño i tahina’e masiñey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amy te aniany avao ty haviñera’e,","poem":1},{"lineBreak":true},{"text":"pak’an-kaveloñe heneke ty fañosiha’e;","poem":1},{"lineBreak":true},{"text":"mete mahaporea’ ty maraindray","poem":1},{"lineBreak":true},{"text":"ty firovetañe,","poem":1},{"lineBreak":true},{"text":"fe ho tendreke maraiñe ty firebehañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le hoe iraho, te niraorao :","poem":1},{"lineBreak":true},{"text":"tsim-bia hasiotse.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ry Iehovà, ty fañisoha’o","poem":1},{"lineBreak":true},{"text":"ro nampijadoña’o i vohikoy;","poem":1},{"lineBreak":true},{"text":"ie naeta’o ty lahara’o","poem":1},{"lineBreak":true},{"text":"le nimarimarike.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ihe ry Iehovà ty nikoihako,","poem":1},{"lineBreak":true},{"text":"naho i Talè ty nihalaliako;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ino ty tombo’e amo liokoo,","poem":1},{"lineBreak":true},{"text":"t’ie higodoñe mb’an-koboñe ao?","poem":1},{"lineBreak":true},{"text":"Hibango Azo hao o debokeo?","poem":1},{"lineBreak":true},{"text":"Ho talilie’e hao ty figahiña’o?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Janjiño ry Iehovà,","poem":1},{"lineBreak":true},{"text":"le tretrezo iraho, ry Iehovà, vaho imbao!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nafote’o ho tsinjake o fandalakoo;","poem":1},{"lineBreak":true},{"text":"hinalo’o amako o gonikoo, vaho sinaro’o hafaleañe,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Soa te hisabo Azo ty engeko","poem":1},{"lineBreak":true},{"text":"le tsy hitsiñe;","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"handriañeko nainai’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}