"text":"Am-pità’o ao ro anolorako troke,","poem":1},{"lineBreak":true},{"text":"fa nijebañe ahy irehe ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañaharen-kavantañañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hejeko","poem":1},{"noteId":13},{"text":"o mpañaoñe","poem":1},{"lineBreak":true},{"text":"ty hakoafan-dRemborakeo;","poem":1},{"lineBreak":true},{"text":"Iehovà ro iatoako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hifale naho hirebeke","poem":1},{"lineBreak":true},{"text":"amo fiferenaiña’oo iraho,","poem":1},{"lineBreak":true},{"text":"fa nihaoñe’o o hasotriakoo;","poem":1},{"lineBreak":true},{"text":"naho niarofoana’o","poem":1},{"lineBreak":true},{"text":"ty haferenaiñako,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"tsy napo’o an-tañan-drafelahiko ao;","poem":1},{"lineBreak":true},{"text":"fa navotra’o an-tane mangadagadañe","poem":1},{"lineBreak":true},{"text":"eo o tombokoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tretrezo ry Iehovà, fa tokoen-draha;","poem":1},{"lineBreak":true},{"text":"nabotsem-pihontoke o masokoo,","poem":1},{"lineBreak":true},{"text":"eka, ty fiaiko naho ty sandriko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa nirì-ty hontoke ty fiaiko,","poem":1},{"lineBreak":true},{"text":"naho ty fiselekaiñañe o taokoo,","poem":1},{"lineBreak":true},{"text":"milesa ty haozarako ty amo tahikoo,","poem":1},{"lineBreak":true},{"text":"vaho minike o taolakoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe finjèn-draho ty amo rafelahikoo,","poem":1},{"lineBreak":true},{"text":"mentsake o mpiharo-tanàñ’ amakoo,","poem":1},{"lineBreak":true},{"text":"fañembañañe o rañekoo,","poem":1},{"lineBreak":true},{"text":"mibotitsik’ amako ze mahaoniñ’ahy","poem":1},{"lineBreak":true},{"text":"an-dalañe ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haliño hoe lolo iraho,","poem":1},{"lineBreak":true},{"text":"tsy amam-betsevetse;","poem":1},{"lineBreak":true},{"text":"manahake ty karabiba.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsinanoko ty bisibisi’ i màroy,","poem":1},{"lineBreak":true},{"text":"harevendreveñañe mb’etia mb’atia,","poem":1},{"lineBreak":true},{"text":"mikinia ahy,","poem":1},{"lineBreak":true},{"text":"ikililia’e ty hañè-doza amako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fe izaho, Ihe ro fiatoako ry Iehovà","poem":1},{"lineBreak":true},{"text":"hoe iraho: Ihe ro Andrianañahareko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Am-pità’o o androkoo;","poem":1},{"lineBreak":true},{"text":"avotsoro an-taña’ o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"naho amo mpanao samporerakeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ampaviaho amy mpitoro’oy","poem":1},{"lineBreak":true},{"text":"ty lahara’o;","poem":1},{"lineBreak":true},{"text":"hahao amo fiferenaiña’oo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ko apo’o ho salaren-draho ry Iehovà,","poem":1},{"lineBreak":true},{"text":"fa mikanjy Azo,","poem":1},{"lineBreak":true},{"text":"fe meñaro o lo tserekeo, ampitsiño an-tsikeokeok’ ao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hampianjiñeñe","poem":1},{"lineBreak":true},{"text":"o famelen-dremborake","poem":1},{"lineBreak":true},{"text":"manotratsotrake o vantañeo","poem":1},{"lineBreak":true},{"text":"ie mirengevoke naho mañinje.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Akore ty harà’ elahin-kasoa’o","poem":1},{"lineBreak":true},{"text":"nahaja’o ho amo mañeveñ’ama’oo,","poem":1},{"lineBreak":true},{"text":"ie nitsene’o ho amo mpitsolok’ ama’o","poem":1},{"lineBreak":true},{"text":"añatrefam-pihaino’ o ana’ondatio!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Akafi’o am-pipalirañe añatrefa’o iereo, ami’ty fikililia’ ondatio; ampitsolohe’o an-kivoho ao tsy ho vorehe’ o famelekeo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Andriañeñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa nilosore’e amako ty fiferenaiña’e,","poem":1},{"lineBreak":true},{"text":"an-drova niarikatoheñe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa naho izaho, hoe iraho te niendrake: ho naitoañe aolom-pihaino’o eo.","poem":1},{"lineBreak":true},{"text":"fe jinanji’o ty fivolan-kalaliko,","poem":1},{"lineBreak":true},{"text":"te nikaiheko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kokò t’Iehovà ry noro’e iabio,","poem":1},{"lineBreak":true},{"text":"arova’ Iehovà o migahiñeo,","poem":1},{"lineBreak":true},{"text":"vaho avarigidi’e amo mpievoñevoñeo ty avake.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mihaozara naho mihafatrara arofo","poem":1},{"lineBreak":true},{"text":"ry hene mpitamà Iehovà.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"ndra: Heje’o","reference":{"chapter":31,"verse":6}}]},"thisChapterLink":"/api/tdx_sle/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}