{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":32,"content":[{"type":"heading","content":["Sabo’ i Davide: Fañeretañe"]},{"type":"verse","number":1,"content":[{"text":"Haha ty nilioven-kakeo,","poem":1},{"lineBreak":true},{"text":"ty nitakonan-tahiñe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haha t’indaty tsy anisia’ Iehovà tahiñe,","poem":1},{"lineBreak":true},{"text":"ie po-­pamañahiañe an-tro’e ao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie nitsiñe iraho, le ninike o taolakoo","poem":1},{"lineBreak":true},{"text":"ty amo fitoreovako lomoñandroo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Handro an-kaleñe te nivesara’","poem":1},{"lineBreak":true},{"text":"ty fità’o,","poem":1},{"lineBreak":true},{"text":"nalongañe hoe hafaòsan’ asara","poem":1},{"lineBreak":true},{"text":"ty ranom-piaiko. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niantofako ama’o o hakeokoo,","poem":1},{"lineBreak":true},{"text":"tsy naetako o tahikoo.","poem":1},{"lineBreak":true},{"text":"hoe raho : Ho solohoeko am’ Iehovà","poem":1},{"lineBreak":true},{"text":"o fiolàkoo; le napo’o","poem":1},{"lineBreak":true},{"text":"ty halò-tsere’ o tahikoo. Selà","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie amy zao, songa hihalaly","poem":1},{"lineBreak":true},{"text":"ama’o o vañoñeo","poem":1},{"lineBreak":true},{"text":"ami’ty andro hahaoniñañ’ Azo,","poem":1},{"lineBreak":true},{"text":"le tsy hahatakatse aze","poem":1},{"lineBreak":true},{"text":"ty fisorotombahan-drano bey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ihe ro fipalirako;","poem":1},{"lineBreak":true},{"text":"harova’o t’ie am-poheke;","poem":1},{"lineBreak":true},{"text":"sabom-pañahàñe ty añohoña’o ahy. Selà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hanareko naho ampaharendreheko azo ty lala homba’o;","poem":1},{"lineBreak":true},{"text":"hitoroako, fa ama’o o masokoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko misare soavala ndra birìke","poem":1},{"lineBreak":true},{"text":"tsy mahilala, ie tsy mahay tsy fehen-daboridy viñe ty vava’e,","poem":1},{"lineBreak":true},{"text":"tsy mone tsy harinea’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lako fihontoke o lo-tserekeo;","poem":1},{"lineBreak":true},{"text":"fe ohoñe’ ty fiferenaiña’","poem":1},{"lineBreak":true},{"text":"Iehovà ty miato ama’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mifalea am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"mandià-taroba ry vantañeo,","poem":1},{"lineBreak":true},{"text":"ipoñafo rebeke,","poem":1},{"lineBreak":true},{"text":"ry vañoñ’arofo iabio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}