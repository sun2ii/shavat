{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Mirebeha am’Iehovà, ry vantañeo,","poem":1},{"lineBreak":true},{"text":"toe mañeva o vañoñeo ty mandrenge.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Andriaño ami’ty marovany t’Iehovà,","poem":1},{"lineBreak":true},{"text":"rengeo an-tsabo, mititiha folo-taly.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isabò sabo vao;","poem":1},{"lineBreak":true},{"text":"ititiho am-pahimbañañe,","poem":1},{"lineBreak":true},{"text":"am-pipoñafan-drebeke.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mahity ty tsara’ Iehovà,","poem":1},{"lineBreak":true},{"text":"hene am-pigahiñañe o fitoloña’eo","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"No’e ty havantañañe naho ty hatò:","poem":1},{"lineBreak":true},{"text":"àtseke ty fiferenaiña’ Iehovà’ ty tane toy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ty tsara’ Iehovà ro nanoeñe i likerañey;","poem":1},{"lineBreak":true},{"text":"ty kofom-palie’e i valobohò’ey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Atonto’e am-botry o ranon-driakeo;","poem":1},{"lineBreak":true},{"text":"ahaja’e an-driha ao o lalekeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mirevendreveña am’ Iehovà ry tane toy; kila mañeveña ama’e","poem":1},{"lineBreak":true},{"text":"ry mpimone’ ty voatse toy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsinara’e le nifonitse; nandily, vaho nijadoñe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koahe’ Iehovà ty fikinia’ o fifeheañeo; afofi’e ty fikilila’ ondatio;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mijadoñe nainai’e ty famerea’ Iehovà, pak’an-tariran-tariratse","poem":1},{"lineBreak":true},{"text":"o fisafirin’ arofo’e.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haha ty fifeheañe naho Iehovà","poem":1},{"lineBreak":true},{"text":"ro Andrianañahare’e,","poem":1},{"lineBreak":true},{"text":"ondaty jinobo’e ho lova’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mivazòho boak’","poem":1},{"lineBreak":true},{"text":"an-dikerañe añe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"oni’e iaby o ana’ondatio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jilove’e boak’ añ’akiba’e ao","poem":1},{"lineBreak":true},{"text":"ze hene mpimoneñ’ an-tane atoy;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I mpitsene ty arofo’ iareo iaby,","poem":1},{"lineBreak":true},{"text":"sindre aharofoana’e ty fitoloña’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tsy ty fitozantoza’ i màroy","poem":1},{"lineBreak":true},{"text":"ty maharombake i mpanjakay;","poem":1},{"lineBreak":true},{"text":"tsy i haozara’e ra’elahiy","poem":1},{"lineBreak":true},{"text":"ty mahavotsotse ty fanalolahy.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy jefa’e t’ie miato aman-tsoavalan’aly ho fiarovañe;","poem":1},{"lineBreak":true},{"text":"tsy ty hara’elahin-kafatrara’e","poem":1},{"lineBreak":true},{"text":"ty hahafipolitira’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Inao, te itoliham-pihaino’ Iehovà","poem":1},{"lineBreak":true},{"text":"o mañeveñe ama’eo,","poem":1},{"lineBreak":true},{"text":"o mitamà i fiferenaiña’eio,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ho votsora’e ty fiai’ iareo tsy hihomake, vaho ho velome’e an-tsan-kerè.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mandiñe Iehovà o tron-tikañeo;","poem":1},{"lineBreak":true},{"text":"Ie ty mpañimba antika","poem":1},{"lineBreak":true},{"text":"naho ty fikalan-defon-tika.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ama’e ty firebehan’ arofon-tika,","poem":1},{"lineBreak":true},{"text":"fiatoan-tika i tahina’e masiñey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho ama’ay abey ty fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"ry Iehovà, fa mpitamà Azo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}