{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":34,"content":[{"type":"heading","content":["A i Davide, ie nañova vintañe añatrefa’ i Abimaleka, le nienga kanao rinoa’e."]},{"type":"verse","number":1,"content":[{"text":"Andriañeko an-tsà an-tsà t’Iehovà,","poem":1},{"lineBreak":true},{"text":"am-bavako ao nainai’e","poem":1},{"lineBreak":true},{"text":"ty fandrengeañ’ aze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mirenge am’ Iehovà ty troko;","poem":1},{"lineBreak":true},{"text":"ie ho janjiñe’ o tretram-poo le hifalea’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Antao hañonjoñe Iehovà,","poem":1},{"lineBreak":true},{"text":"hitrao-pibango i Tahina’ey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nitsoeheko t’Iehovà, le tinoi’e,","poem":1},{"lineBreak":true},{"text":"fonga nafaha’e amako ty fangebahebako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niandra ama’e iereo le niloeloe,","poem":1},{"lineBreak":true},{"text":"tsy ho kolopofen-kameñarañe ka ty tarehe’ iareo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nitoreo ty rarake,","poem":1},{"lineBreak":true},{"text":"naho nijanjiñ’ aze t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho rinomba’e amo hasotria’e iabio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mitobe mañohoke o mpañeveñe ama’eo ty anjeli’ Iehovà, vaho haha’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsopeho vaho mahaisaha","poem":1},{"lineBreak":true},{"text":"te soa t’Iehovà;","poem":1},{"lineBreak":true},{"text":"fale t’indaty mitsolok’ ama’e!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mañeveña am’ Iehovà, ry navahe’eo!","poem":1},{"lineBreak":true},{"text":"amy te tampe-draha irieñe","poem":1},{"lineBreak":true},{"text":"ze mañeveñ’ ama’e.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mete mililitse vaho mifeake ty kerè","poem":1},{"lineBreak":true},{"text":"o liona tora’eo;","poem":1},{"lineBreak":true},{"text":"fe tsy ho po-kasoa o mitsoek’ Iehovào.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mb’etoa, ry anake, tsendreño;","poem":1},{"lineBreak":true},{"text":"hatoroko anahareo","poem":1},{"lineBreak":true},{"text":"ty fañeveñañe am’ Iehovà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ia t’indaty misalala ho veloñe,","poem":1},{"lineBreak":true},{"text":"naho mpitea andro, hahaisaha’e ty hasoa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Afofio ami’ty raty ty famele’o,","poem":1},{"lineBreak":true},{"text":"naho o soñi’oo tsy hivolam-pìtake.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Iholiaro ty raty, le anò ty soa;","poem":1},{"lineBreak":true},{"text":"mitsoeha filongoañe—le heaño.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Miatreke o vantañeo","poem":1},{"lineBreak":true},{"text":"ty fihaino’ Iehovà,","poem":1},{"lineBreak":true},{"text":"naho o fitoreo’eo o ravembia’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Atreatrè’ Iehovà an-daharañe","poem":1},{"lineBreak":true},{"text":"o mpanao ratio;","poem":1},{"lineBreak":true},{"text":"aitoa’e an-tane atoy","poem":1},{"lineBreak":true},{"text":"ty fitiahiañe iareo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mikaike, le mijanjiñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie haha’e amo hasotriañe iabio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Marine’ ty mikoretse añ’arofo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho rombahe’e o demok’ an-trok’aoo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Maro ty mañembetse o vañoñeo","poem":1},{"noteId":14},{"text":",","poem":1},{"lineBreak":true},{"text":"fe avotso’ Iehovà ama’e iaby.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ambena’e iaby o taola’eo,","poem":1},{"lineBreak":true},{"text":"leo raike tsy rifotse.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Havetra’ ty haratiañe ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"vaho hafàtse ze malaiñe o vantañeo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Jebañe’ Iehovà ty fiai’ o mpitoro’eo,","poem":1},{"lineBreak":true},{"text":"leo raik’ amo mitsolok’ ama’eo","poem":1},{"lineBreak":true},{"text":"tsy hafàtse.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Sab 71:20, Ti II 3:11-12","reference":{"chapter":34,"verse":19}}]},"thisChapterLink":"/api/tdx_sle/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}