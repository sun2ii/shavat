{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":35,"content":[{"type":"heading","content":["Sabo’ i Davida"]},{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, atretréo o miatreatre ahio, mialia amo mifandrapak’ amakoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Andrambeso fikalan-defoñe","poem":1},{"lineBreak":true},{"text":"naho fikala-meso,","poem":1},{"lineBreak":true},{"text":"le miongaha hañolotse ahy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apontsoaño ty lefo’o naho i fekon’ aliy;","poem":1},{"lineBreak":true},{"text":"hatreatrè’o o mañoridañ’ahikoo","poem":1},{"lineBreak":true},{"text":"saontsio ami’ty fiaiko ty hoe :","poem":1},{"lineBreak":true},{"text":"Izaho ro fandrombahañe azo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Salatse naho po-asiñe","poem":1},{"lineBreak":true},{"text":"o mipay ty fiaikoo;","poem":1},{"lineBreak":true},{"text":"ampiambohò vaho ampimeñaro","poem":1},{"lineBreak":true},{"text":"o mikilily hijoy ahikoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ano ho kafo’e aolon-tioke eo,","poem":1},{"lineBreak":true},{"text":"le hatao’ i anjeli’ Iehovày soike.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ano haieñe naho halamañe","poem":1},{"lineBreak":true},{"text":"ty fombà’ iareo,","poem":1},{"lineBreak":true},{"text":"horidañe’ i anjeli’ Iehovày.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tsy aman-taly ty nañetaha’iareo harato,","poem":1},{"lineBreak":true},{"text":"tsy vente’e ty nihalien-koboñe ty fiaiko,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hivovò ama’e abey ty firotsahañe,","poem":1},{"lineBreak":true},{"text":"le ho tsepahe’ i harato naeta’ey;","poem":1},{"lineBreak":true},{"text":"vaho amy firotsahañey ty hivarinjonjoha’e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hirebek’ am’ Iehovà ty fiaiko,","poem":1},{"lineBreak":true},{"text":"hirenge amy fandrombaha’ey.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hanao ty hoe iaby o taolakoo:","poem":1},{"lineBreak":true},{"text":"Ry Iehovà ia ty hambañ’ Ama’o?","poem":1},{"lineBreak":true},{"text":"Mpandrombake o rarakeo","poem":1},{"lineBreak":true},{"text":"amy maozatse te ama’ey;","poem":1},{"lineBreak":true},{"text":"Eka, ty poie’e naho ty mpisotry","poem":1},{"lineBreak":true},{"text":"amy mpamaok’ azey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mitroatse o mpitalily tsivokatseo,","poem":1},{"lineBreak":true},{"text":"mañody ahy an-draha amoeako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Valè’ iereo raty ty soa;","poem":1},{"lineBreak":true},{"text":"mampioremeñe ty fiaiko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa naho izaho, nisaron-gony","poem":1},{"lineBreak":true},{"text":"te natindry iereo,","poem":1},{"lineBreak":true},{"text":"nirè-batañ’aman-dilitse,","poem":1},{"lineBreak":true},{"text":"fe nimpoly an-troko i halalikoy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nandenako hoe t’ie nirañeko ndra nirahalahiko; nidròdreke an-kontoke manahake te nandala rene.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fe nirebeke iereo t’ie nikoletra, nifañosoñe,","poem":1},{"lineBreak":true},{"text":"nifanontoñe hiatreatre ahy","poem":1},{"lineBreak":true},{"text":"o mpamofoke alik’ amakoo,","poem":1},{"lineBreak":true},{"text":"nandrimitse ahy avao tsy nitroatse;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"hoe mpiteratera tsi-aman-Kake","poem":1},{"lineBreak":true},{"text":"an-tsabadidake,","poem":1},{"lineBreak":true},{"text":"ty ikodrita’ iareo nife;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"O Talè, pak’ ombia te hisamba avao?","poem":1},{"lineBreak":true},{"text":"Avotsoro ami’ty fandrotsaha’ iareo ty troko; amo lionao ty fiaiko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Andriañeko am-pivori-bey ao;","poem":1},{"lineBreak":true},{"text":"mijejo azo am-balobohòk’ ao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lonike tsy hirebeha’ o rafelahiko tsy amam-poto’eo;","poem":1},{"lineBreak":true},{"text":"tsy hipie maso amako o malaiñe ahy","poem":1},{"lineBreak":true},{"text":"tsy aman-tali’eo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tsy mivolam-pilongoañe iereo,","poem":1},{"lineBreak":true},{"text":"te mone mikilily volam-pitake","poem":1},{"lineBreak":true},{"text":"amo mianjiñe an-tane atoio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Eka ivañavaña’ iereo vava","poem":1},{"lineBreak":true},{"text":"manao ty hoe :","poem":1},{"lineBreak":true},{"text":"Hiy! Hiy! fa nitrea’ o maso’aio.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nivazoho’o","poem":1},{"lineBreak":true},{"text":"ry Iehovà, ko mianjiñe;","poem":1},{"lineBreak":true},{"text":"ry Talè, ko mitòtse amako","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mitsekafa, mivañona hañomea’o to ! Imbao i ahikoy ry Andrianañahareko","poem":1},{"lineBreak":true},{"text":"naho Talèko.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Izakao ry Iehovà Andrianañahareko","poem":1},{"lineBreak":true},{"text":"ty amy havantaña’oy;","poem":1},{"lineBreak":true},{"text":"le ko apo’o hirebeha’ iereo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ko ado’o hanoe’e ty hoe","poem":1},{"lineBreak":true},{"text":"an-troke:","poem":1},{"lineBreak":true},{"text":"Hiry! ty fañiria’ay! ndra ty hoe :","poem":1},{"lineBreak":true},{"text":"Fa nabea’ay.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Atraofo salareñe naho meñareñe o mitohàk’ amy haemberakoio;","poem":1},{"lineBreak":true},{"text":"ampisikinen-kameñarañe naho inje","poem":1},{"lineBreak":true},{"text":"o mirengèvok’ amakoo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hipoñak’ an-drebeke naho","poem":1},{"lineBreak":true},{"text":"handia-taroba","poem":1},{"lineBreak":true},{"text":"o mifale ami’ty halio tahikoo;","poem":1},{"lineBreak":true},{"text":"hitolom-panao ty hoe:","poem":1},{"lineBreak":true},{"text":"Onjono t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ry mpifale amy fanintsiña’ i mpitoro’eiy.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hitaroñe ty havantaña’o ty lelako,","poem":1},{"lineBreak":true},{"text":"ty enge’o lomoñandro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}