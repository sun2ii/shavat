{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":37,"content":[{"type":"heading","content":["Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"א Ko embetse amo tsivokatseo,","poem":1},{"lineBreak":true},{"text":"vaho ko tsikirihe’o o mpanao ratio,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"F’ie hiforejeje aniany hoe ahetse,","poem":1},{"lineBreak":true},{"text":"vaho hiheatse hoe rongo-maindoñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ב Miatoa am’ Iehovà, le anò ty soa;","poem":1},{"lineBreak":true},{"text":"imoneño i taney","poem":1},{"lineBreak":true},{"text":"vaho rañeto ty figahiñañe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mifalea am’ Iehovà; le hatolo’e azo","poem":1},{"lineBreak":true},{"text":"ty fisalalàn’ arofo’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ג Ampiatò am’ Iehovà ty fombà’o,","poem":1},{"lineBreak":true},{"text":"Atokiso, vaho ie ty hitoloñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le hampionjone’e hoe hazavàñe","poem":1},{"lineBreak":true},{"text":"ty havantaña’o,","poem":1},{"lineBreak":true},{"text":"vaho hoe an-tsipinde-mena","poem":1},{"lineBreak":true},{"text":"ty havañona’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ד Manintsiña am’ Iehovà","poem":1},{"lineBreak":true},{"text":"naho mahaliñisa;","poem":1},{"lineBreak":true},{"text":"ko ihobira’o ty miraorao an-tsata’e,","poem":1},{"lineBreak":true},{"text":"t’indaty mitoloñ’ am-pikitrohan-dratio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ה Fario o habosehañeo, naho apoho ty fombo;","poem":1},{"lineBreak":true},{"text":"ko embetse kera hañosi-karatiañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toe haitoañe o tsy vokatseo,","poem":1},{"lineBreak":true},{"text":"fa handova i taney ze mitamà Iehovà","poem":1},{"noteId":15},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ו Aniany le tsy ho eo i lo-tserekey,","poem":1},{"lineBreak":true},{"text":"ho tsoehe’o i akiba’ey f’ie tsy ho trea.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toe handova i Taney o tretram-poo,","poem":1},{"lineBreak":true},{"text":"hifale am-piraoraoañe vokatse.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ז Kililie’ i lo-tsereke ty vantañe,","poem":1},{"lineBreak":true},{"text":"vaho ampikodrita’e nife.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Iankahafa’ i Talè,","poem":1},{"lineBreak":true},{"text":"fa arofoana’e te an-­titotse ty andro’e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ח Fa napontsoa’ o tsivokatseo","poem":1},{"lineBreak":true},{"text":"ty fibara,","poem":1},{"lineBreak":true},{"text":"vaho nampibitsoke fale","poem":1},{"lineBreak":true},{"text":"hametsaha’e ambane","poem":1},{"lineBreak":true},{"text":"o rarakeo naho o misotrio,","poem":1},{"lineBreak":true},{"text":"hañohofa’e loza","poem":1},{"lineBreak":true},{"text":"amo an-dala mahitio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hitrofaha’ i fibaray ty tro’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho ho pekañeñe ty fale’ iareo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ט Hamake ty ­kedekedek’ anaña’","poem":1},{"lineBreak":true},{"text":"ty vantañe","poem":1},{"lineBreak":true},{"text":"ta ty havokara’ o tsivokatse maroo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe ho pozaheñe ty sira’ o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"fe tohaña’ Iehovà o vañoñeo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"י Arofoana’ Iehovà ty andro’","poem":1},{"lineBreak":true},{"text":"o vantañeo,","poem":1},{"lineBreak":true},{"text":"tsy ho modo kitro añ’afe’e ty lova’iareo;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsy ho salatse an-tsan-karatiañe;","poem":1},{"lineBreak":true},{"text":"le ho anjañe an-tsam-paosa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"כ Hikoromake o tsy vokatseo,","poem":1},{"lineBreak":true},{"text":"le hanahake ty safon’ añondry","poem":1},{"lineBreak":true},{"text":"o rafelahi’ Iehovào,","poem":1},{"lineBreak":true},{"text":"ie himosaoñe an-katòeñe,","poem":1},{"lineBreak":true},{"text":"toe himiañe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ל Misongo i tsivokatsey","poem":1},{"lineBreak":true},{"text":"fe tsy mañavake;","poem":1},{"lineBreak":true},{"text":"matarike i vantañey vaho mañomey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Toe handova i taney o tahie’eo,","poem":1},{"lineBreak":true},{"text":"fe haitoañe añe o afà’eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"מ Ampijadoña’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty lia’ ondaty, ie no’e i lala’ey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ndra t’ie mikorovoke","poem":1},{"lineBreak":true},{"text":"tsy hidaboñe,","poem":1},{"lineBreak":true},{"text":"fa tohaña’ Iehovà am-pitàñe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"נ Nitora’e iraho,","poem":1},{"lineBreak":true},{"text":"fa antetse henaneo,","poem":1},{"lineBreak":true},{"text":"mboe liako tsy nahatrea te","poem":1},{"lineBreak":true},{"text":"naforintseñe o vañoñeo,","poem":1},{"lineBreak":true},{"text":"te nangata-kaneñe o keleia’eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Matarike lomoñandro re naho","poem":1},{"lineBreak":true},{"text":"mampisongo, vaho vokatse o tiri’eo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ס Ihankaño ty raty, le anò ty soa,","poem":1},{"lineBreak":true},{"text":"vaho himoneñe kitro añ’afe’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tea’ Iehovà ty hatò,","poem":1},{"lineBreak":true},{"text":"le tsy ho farie’e o mpañorike i Ha’eio;","poem":1},{"lineBreak":true},{"text":"soa-fipalitse nainai’e iereo;","poem":1},{"lineBreak":true},{"text":"fe haitoañe ty tiri’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ע Handova i taney o vañoñeo, vaho himoneñe nainai’e.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"פ Mañaka-kihitse ty falie’ o vantañeo,","poem":1},{"lineBreak":true},{"text":"manao saontsi-to i famele’ey.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Añ’arofo’e ao ty Hàn’Añahare’e","poem":1},{"noteId":16},{"text":",","poem":1},{"lineBreak":true},{"text":"tsy midorasitse o fandia’eo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"צ Tampone’ ty tsivokatse ty vantañe, mipay hañè-doza ama’e.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Fe tsy hapo’ Iehovà an-taña’e ao,","poem":1},{"lineBreak":true},{"text":"vaho tsy hado’e hafàtse an-jaka.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ק Itamao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"naho ambeno i lala’ey,","poem":1},{"lineBreak":true},{"text":"le honjone’e handova i taney,","poem":1},{"lineBreak":true},{"text":"vaho ho isa’o ty fañitoañe o tsivokatseo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ר Fa nitreako ty lahiaga, tsivoatsolo,","poem":1},{"lineBreak":true},{"text":"nandrevake hoe hatae maindoñe","poem":1},{"lineBreak":true},{"text":"an-tane’e ao;","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Fe nihelañe añe, le heheke, tsy eo;","poem":1},{"lineBreak":true},{"text":"pinaiko fa tsy nahatrea.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"ש Henteo ty vañoñe, hehe i vantañey, ho soa-figadoñe ty mifampilongo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Fe hatrao-­karotsake o mpandilatseo","poem":1},{"lineBreak":true},{"text":"vaho ho tomereñe ty figadoña’","poem":1},{"lineBreak":true},{"text":"ty lo-tsereke.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"ת Boak’ am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe o vañoñeo,","poem":1},{"lineBreak":true},{"text":"Ie ty fitsoloha’ iareo an-tsàm-poheke.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Imbàe’ Iehovà naho votsore’e;","poem":1},{"lineBreak":true},{"text":"haha’e amo ­tsivokatseo vaho rombahe’e,","poem":1},{"lineBreak":true},{"text":"amy te Ie ty fipalira’ iareo.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","tex