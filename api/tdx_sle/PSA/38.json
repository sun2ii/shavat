{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":38,"content":[{"type":"heading","content":["Sabo’ i Davide, Tiahy"]},{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, ko mitrevok’ahy","poem":1},{"lineBreak":true},{"text":"ami’ty fifombo’o;","poem":1},{"lineBreak":true},{"text":"naho ko andilova’o","poem":1},{"lineBreak":true},{"text":"ami’ty fiforoforoa’o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa mitsamantake amako","poem":1},{"lineBreak":true},{"text":"o ana-pale’oo,","poem":1},{"lineBreak":true},{"text":"vaho manindry ahy ty fità’o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tararèñe ty fiaiko te hatorifiha’o, naho po-pijanganañe o taolakoo,","poem":1},{"lineBreak":true},{"text":"ty amy tahikoy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa nalipo’ o hakeokoo ty lohako,","poem":1},{"lineBreak":true},{"text":"hoe kilankañe mavesatse tsy leoko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mantiñe naho miborake o ferekoo","poem":1},{"lineBreak":true},{"text":"ty amy hadagolako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mihohokohoke iraho naho mibokoke,","poem":1},{"lineBreak":true},{"text":"toe mandala lomoñandro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lifo-pihobobohañe ty vaniako,","poem":1},{"lineBreak":true},{"text":"tsy aman-kajangañe ty sandriko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Volevole iraho, loho demoke,","poem":1},{"lineBreak":true},{"text":"miñeoñeoñe ty fioremeñan-troko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Talè, fonga añatrefa’o eo ty fisalalàko, naho tsy mietak’ ama’o ty fiselekaiñako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Midebodebo ty troko,","poem":1},{"lineBreak":true},{"text":"milesa ty haozarako;","poem":1},{"lineBreak":true},{"text":"naho nieng’ahiko ty hazavà’ o masokoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampiesoñe’ i angorosiko","poem":1},{"lineBreak":true},{"text":"o mpiamakoo naho o rañekoo;","poem":1},{"lineBreak":true},{"text":"naho mitrobàke ey o longokoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nampidreñafe’ o mipay ty fiaikoo fandrike iraho,","poem":1},{"lineBreak":true},{"text":"ikililia’ o mipay hijoy ahikoo,","poem":1},{"lineBreak":true},{"text":"toe ikinia’e hakalitahañe","poem":1},{"lineBreak":true},{"text":"lomoñandro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"F’ie manahake te giñe,","poem":1},{"lineBreak":true},{"text":"tsy mahatsanoñe iraho,","poem":1},{"lineBreak":true},{"text":"hoe bobo kanao tsy mahasoka-bava.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eka, manahake ondaty valagìñe,","poem":1},{"lineBreak":true},{"text":"tsy aman-dietse am-palie.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ihe ry Iehovà ro fisalalàko,","poem":1},{"lineBreak":true},{"text":"toe hanoiñe irehe ry Talè","poem":1},{"lineBreak":true},{"text":"Andrianañahareko.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa inao ty ahy :","poem":1},{"lineBreak":true},{"text":"Tsy mone hirebeke iareo,","poem":1},{"lineBreak":true},{"text":"ke hirengevoke te","poem":1},{"lineBreak":true},{"text":"midorasitse o tombokoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe veka’e hikorovoke iraho,","poem":1},{"lineBreak":true},{"text":"amako lomoñandro ty fanaintaiñako.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe iantofako o hakeokoo;","poem":1},{"lineBreak":true},{"text":"naho lifo-­kasosorañe ty amo tahikoo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fe maozatse naho mahasibeke","poem":1},{"lineBreak":true},{"text":"o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"maro ty malaiñe ahy tsy vente’e,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"aa kanao valea’iareo raty ty soa,","poem":1},{"lineBreak":true},{"text":"heje’ iareo ty fañorihako ty hasoa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ko mamorintseñ’ ahy ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ko mitotse amako","poem":1},{"lineBreak":true},{"text":"ry Andrianañahareko,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Malisà hañimb’ ahy ry Talè,","poem":1},{"lineBreak":true},{"text":"Fandrombahañ’ ahy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}