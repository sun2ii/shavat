{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":39,"content":[{"type":"heading","content":["Ho a i Talè, atao Iedotone, Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Hoe iraho: Hambenako o lalakoo,","poem":1},{"lineBreak":true},{"text":"tsy mone handilatse an-delako.","poem":1},{"lineBreak":true},{"text":"hampidiñeko an-daboridy ty vavako","poem":1},{"lineBreak":true},{"text":"ie añatrefako eo o lo-tserekeo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nimoañe iraho naho nitsiñe,","poem":1},{"lineBreak":true},{"text":"nijomohòñe, ndra ami’ty soa,","poem":1},{"lineBreak":true},{"text":"fe nanjeke avao ty haloviloviako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mitsovovoke ty an-troko ao,","poem":1},{"lineBreak":true},{"text":"miforehetse i afoy te mitsakore,","poem":1},{"lineBreak":true},{"text":"vaho hoe ty fivolan-delako :","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ry Iehovà, ampandrendreho ahy","poem":1},{"lineBreak":true},{"text":"ty figadoñako,","poem":1},{"lineBreak":true},{"text":"naho ty zehe’ o androkoo—te ino, ampaharofoano ahy","poem":1},{"lineBreak":true},{"text":"ty habori’ o havelokoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hehe te nanoe’o an-jehe o androkoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy vente ama’o o taokoo;","poem":1},{"lineBreak":true},{"text":"toe songa hoe kofòke avao","poem":1},{"lineBreak":true},{"text":"ndra te añoñ’ay t’indaty. Selà","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Manao firiorion-talinjo ondatio,","poem":1},{"lineBreak":true},{"text":"tsy vente’e ty fihepakepaha’e,","poem":1},{"lineBreak":true},{"text":"hampitoabotoàbotse vara,","poem":1},{"lineBreak":true},{"text":"fe nofi’e ty hangoroñ’ aze.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa inom-bao, ry Talè,","poem":1},{"lineBreak":true},{"text":"ty liñisako henaneo?","poem":1},{"lineBreak":true},{"text":"Ama’o ty fitamàko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hahao amo fonga fiolàkoo,","poem":1},{"lineBreak":true},{"text":"ko salare’o amo seretseo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa mijomohòn-draho","poem":1},{"lineBreak":true},{"text":"tsy manoka-bava; amy te Ihe ty nanao izay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Afaho amako ty angorosi’o;","poem":1},{"lineBreak":true},{"text":"tomontoñe iraho ty amy fanindriam-pità’oy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Añ’endake ty andilova’o ondatio","poem":1},{"lineBreak":true},{"text":"ty amo tahi’eo,","poem":1},{"lineBreak":true},{"text":"momohe’o hoe fizara o fisengea’eo.","poem":1},{"lineBreak":true},{"text":"Toe songa kofòke avao ondatio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Janjiño o halalikoo ry Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho toloro ravembia o fitoreoko.","poem":1},{"lineBreak":true},{"text":"Ko mianjiñe ty amo ranomasokoo,","poem":1},{"lineBreak":true},{"text":"fa ambahiny ama’o iraho, renetane manahak’ an-droaeko iaby.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Atoliho tsy hisamba’o ahy, hisomilahako, aolo’ ty fiengako tsy ho eo ka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}