{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":4,"content":[{"type":"heading","content":["Ho a i Talèn’ Tsakeray; Ho titiheñe ami’ty Marovany, Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Ry Andrianañaharen-kavañonako","poem":1},{"lineBreak":true},{"text":"toiño iraho te mikanjy Azo","poem":1},{"lineBreak":true},{"text":"fa Ihe ty nañivake ho ahy te nalovilovy;","poem":1},{"lineBreak":true},{"text":"isoho vaho janjiño o halalikoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O ry ana’ondatio, Sikala ‘mbia ro","poem":1},{"lineBreak":true},{"text":"hafote’ areo ho inje ty asiko?","poem":1},{"lineBreak":true},{"text":"ty hikoko ty tsy vente’e,","poem":1},{"lineBreak":true},{"text":"hitsoeke ty famañahiañe? Selà","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fe fohino te navaha’ Iehovà","poem":1},{"lineBreak":true},{"text":"ho ama’e i vañoñey;","poem":1},{"lineBreak":true},{"text":"ho janjiñe’ Iehovà te kanjieko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Minevenevera, le ko mandilatse;","poem":1},{"lineBreak":true},{"text":"mañereñerea añ’arofo an-tihi’o eo, vaho mianjiña. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mañengà soron-kavantañañe,","poem":1},{"lineBreak":true},{"text":"vaho miatoa am’Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maro ty mivola :","poem":1},{"lineBreak":true},{"text":"Ia ty hampiboake hasoa amantika?","poem":1},{"lineBreak":true},{"text":"Ry Iehovà, onjono ama’ay","poem":1},{"lineBreak":true},{"text":"ty hazavan-dahara’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ihe nampipoke haehake an-troko ao, mandikoatse te","poem":1},{"lineBreak":true},{"text":"an-tsàm-pamokara’ iareo","poem":1},{"lineBreak":true},{"text":"ampemba naho divay.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hàndre an-kanintsin-draho le hiroro","poem":1},{"lineBreak":true},{"text":"amy te Ihe avao ry Iehovà","poem":1},{"lineBreak":true},{"text":"ro mampimoneñe ahy am-pitsolohañe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}