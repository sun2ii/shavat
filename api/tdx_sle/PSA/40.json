{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":40,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Nitamàko am-pahaliñisañe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"le nitokilaña’e, vaho jinanji’e ty fitoreoko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naaka’e an-koboñe namparikoriko,","poem":1},{"lineBreak":true},{"text":"naho boak’ an-dietse nipaletroke,","poem":1},{"lineBreak":true},{"text":"vaho nampitongoà’e ambone","poem":1},{"lineBreak":true},{"text":"lamilamy eo o tombokoo;","poem":1},{"lineBreak":true},{"text":"le nalaha’e o liakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Napo’e am-bavako ao ty sabo vao,","poem":1},{"lineBreak":true},{"text":"fijejoañe aman’Añaharen-tikañe;","poem":1},{"lineBreak":true},{"text":"maro ty hahaoniñe le hañeveñe,","poem":1},{"lineBreak":true},{"text":"vaho hitsolok’ am’ Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Haha ty manao Iehovà ho fiatoa’e,","poem":1},{"lineBreak":true},{"text":"naho tsy mitolike","poem":1},{"lineBreak":true},{"text":"mb’amo mpirengevokeo,","poem":1},{"lineBreak":true},{"text":"vaho tsy mitsile mb’an-dremborake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maro, ry Iehovà Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"o fitoloña’o fanjàkao,","poem":1},{"lineBreak":true},{"text":"naho ty fivetsevetse’o anay,","poem":1},{"lineBreak":true},{"text":"tsy eo ty mañirinkiriñe Azo !","poem":1},{"lineBreak":true},{"text":"Naho nitaroñeko naho nilañoneko,","poem":1},{"lineBreak":true},{"text":"mbe mandikoatse ze mete ho talilieñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy mahafale Azo o soroñeo","poem":1},{"noteId":17},{"text":"naho","poem":1},{"lineBreak":true},{"text":"o enga-mahakamao;","poem":1},{"lineBreak":true},{"text":"sinoka’o o sofikoo;","poem":1},{"lineBreak":true},{"text":"tsy nipaia’o ty engan-kolorañe","poem":1},{"lineBreak":true},{"text":"ndra ty engan-kakeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le hoe raho : Intoy iraho, homb’eo,","poem":1},{"lineBreak":true},{"text":"fa nisokireñe am-boke-pelek’ ao;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Noko, ry Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"ty mitoloñe amo satrin’arofo’oo;","poem":1},{"lineBreak":true},{"text":"eka, an-troko ato o Tsara’oo","poem":1},{"noteId":18},{"text":".","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa nitaroneko am-pivori-bey ao ty talily soan-kavantañañe;","poem":1},{"lineBreak":true},{"text":"tsy ho sebañeko o soñikoo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, Ihe ro maharofoanañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy naetako an-troko ao","poem":1},{"lineBreak":true},{"text":"ty havantaña’o;","poem":1},{"lineBreak":true},{"text":"fa nitaroñeko ty figahiña’o","poem":1},{"lineBreak":true},{"text":"naho ty fandrombaha’o;","poem":1},{"lineBreak":true},{"text":"vaho tsy nakafiko amy fivori-beiy","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’o naho ty hatò’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ry Iehovà ko hazoñeñ’ amako","poem":1},{"lineBreak":true},{"text":"ty fitretreza’o;","poem":1},{"lineBreak":true},{"text":"añaro ahy nainai’e ty fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"naho ty hatò’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Miarikoboñe ahy ty haratiañe tsifotofoto; miambotrak’ amako o hakeokoo,","poem":1},{"lineBreak":true},{"text":"le tsy mahafiandra,","poem":1},{"lineBreak":true},{"text":"ie maro te amo volon-dohakoo,","poem":1},{"lineBreak":true},{"text":"vaho milesa ty troko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho no’o abey ry Iehovà ty hamotsotse ahy;","poem":1},{"lineBreak":true},{"text":"malisà ry Iehovà hañolotse ahy,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le aharò salareñe naho meñareñe","poem":1},{"lineBreak":true},{"text":"o mipay ty fiaiko hasintake;","poem":1},{"lineBreak":true},{"text":"ampiamboho vaho injeo","poem":1},{"lineBreak":true},{"text":"o te hijoy ahio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ehe ampidabao an-kenatse","poem":1},{"lineBreak":true},{"text":"ze manao amako ty hoe: Hiy! Hiy!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hirebeke naho hifale ze mipay Azo,","poem":1},{"lineBreak":true},{"text":"vaho hitolon-kanao ty hoe","poem":1},{"lineBreak":true},{"text":"o mpitea i fandrombaha’oio:","poem":1},{"lineBreak":true},{"text":"Onjoneñe t’Iehovà.","poem":1},{"lineBreak":true},{"text":"17 Aa kanao rarake naho misotry iraho,","poem":1},{"lineBreak":true},{"text":"ee t’ie ho vetsevetse’ i Talè;","poem":1},{"lineBreak":true},{"text":"Ihe ro mpañimba naho mpañaha ahy,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahareko; ko mihenekeneke.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Heb 10:5-6","reference":{"chapter":40,"verse":6}},{"noteId":18,"caller":"+","text":"Sab 37:31, 119:11, Ies 51:7, Heb 10:7-9","reference":{"chapter":40,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":16}