{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":41,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Haha ty mañaoñe o rarakeo;","poem":1},{"lineBreak":true},{"text":"ie ho votsore’ Iehovà an-tsan-kankàñe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Harova’Iehovà le ho tana’e veloñe naho hatao’e haha amy taney eo,","poem":1},{"lineBreak":true},{"text":"naho tsy apo’e an-tsatrin-tron-drafelahy","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho tohaña’ Iehovà amy tihy tindria’ey;","poem":1},{"text":"hafote’o ho jangan-dre am-pandream-pisilofa’e eo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aa naho izaho, hoe ty asako: ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Atariho, jangaño ty fiaiko, fa nandilarako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Manambaitambaiñ’ ahy o rafelahikoo: ombia t’ie hikoromake,","poem":1},{"lineBreak":true},{"text":"hihomaha’ i añara’ey?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie mitilik’ ahy,","poem":1},{"lineBreak":true},{"text":"manao rehan-dremborake;","poem":1},{"lineBreak":true},{"text":"mangoroñe hakeo ama’e ty tro’e;","poem":1},{"lineBreak":true},{"text":"ie miavotse, volañe’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ivesovesoa’ o malaiñe ahy iabio,","poem":1},{"lineBreak":true},{"text":"mikilily joy, ami’ty hoe:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mipitek’ ama’e ty bilokan-kokolampa;","poem":1},{"lineBreak":true},{"text":"kanao mitsilañe re, tsy hitroatse ka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eka, ndra i rañeko nianteherakoy,","poem":1},{"lineBreak":true},{"text":"i nikama i hanekoiy,","poem":1},{"lineBreak":true},{"text":"fa nañonjo tomitse amako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"F’Ihe ry Iehovà, iferenaiño,","poem":1},{"lineBreak":true},{"text":"vaho atroaro hamaleako iareo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zao ty aharendrehako te no’o,","poem":1},{"lineBreak":true},{"text":"t’ie tsy irohafa’ o rafelahikoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Naho izaho, tozañe’o ami’ty havañonako,","poem":1},{"lineBreak":true},{"text":"naho ampañatrefe’o laharañe amako nainai’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Andriañeñe t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’Israele,","poem":1},{"lineBreak":true},{"text":"haehae vaho nainai’e donia. Amena naho Amena.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}