r":4,"content":[{"lineBreak":true},{"text":"Le homb’an-­kitrelin’ Añahare mb’eo,","poem":1},{"lineBreak":true},{"text":"mb’aman’Añahare","poem":1},{"lineBreak":true},{"text":"mampinembanembañ’ ahy,","poem":1},{"lineBreak":true},{"text":"vaho ho saboeko ami’ty marovany,","poem":1},{"lineBreak":true},{"text":"t’i Abo-Tia, Andrianañahareko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ino ty ­mahalonjetse azo ty fiaiko tia?","poem":1},{"lineBreak":true},{"text":"inoñe ty angoihoia’o amako ao?","poem":1},{"lineBreak":true},{"text":"Mitamà an’Andriaenañahare;","poem":1},{"lineBreak":true},{"text":"fa mbe handriañeko,","poem":1},{"lineBreak":true},{"text":"i fandrombaham-piatrefako","poem":1},{"lineBreak":true},{"text":"naho Andrianañaharekoy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}