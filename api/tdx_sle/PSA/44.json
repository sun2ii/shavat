{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":44,"content":[{"type":"heading","content":["Ho a i Talèn-tsabo,"]},{"type":"heading","content":["Sabo o ana’ i Korao : Itsakoreañe"]},{"type":"verse","number":1,"content":[{"text":"Ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"fa jinanjin-dravembia’ay, fa natalilin-droae’ay o fitoloñañe nanoe’o","poem":1},{"lineBreak":true},{"text":"tañ’ andro’ iereoo,","poem":1},{"lineBreak":true},{"text":"amo andro faha’ matoetoeo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie am-pità’o ty nandroake","poem":1},{"lineBreak":true},{"text":"o fifeheañeo le najado’o eo ;","poem":1},{"lineBreak":true},{"text":"dinemo’o ondatio, vaho naparatsia’o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsy ty fibara’ iareo ty nahazoañe i taney;","poem":1},{"lineBreak":true},{"text":"le tsy o fità’ iareoo ty naharombake,","poem":1},{"lineBreak":true},{"text":"fa ty fità’o havana naho ty sira’o,","poem":1},{"lineBreak":true},{"text":"vaho ty hazavan-dahara’o","poem":1},{"lineBreak":true},{"text":"amy t’ie nisohe’o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mpanjakako irehe, ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"lilio fandrombahañe t’Iakobe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ihe ro igorea’ay o rafelahi’aio;","poem":1},{"lineBreak":true},{"text":"ty tahina’o ty andialià’ay o mitroatse hiatreatre anaio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy iatoako ty faleko,","poem":1},{"lineBreak":true},{"text":"tsy maharombak’ ahy ty fibarako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa Ihe ro nandrombak’ anay","poem":1},{"lineBreak":true},{"text":"amo rafelahi’aio,","poem":1},{"lineBreak":true},{"text":"naho nanalatse o malaiñe anaio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro","poem":1},{"lineBreak":true},{"text":"firengea’ay lomoñandro,","poem":1},{"lineBreak":true},{"text":"vaho andriañe’ay nainai’e ty tahina’o. Selà","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"F’ie nifarie’o henaneo,","poem":1},{"lineBreak":true},{"text":"naho ninje’o;","poem":1},{"lineBreak":true},{"text":"tsy indreze’o ­fionjonañe o lahindefo’aio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ampiambohoe’o amo rafelahi’aio,","poem":1},{"lineBreak":true},{"text":"vaho mamaok’ an-tsatri’e avao","poem":1},{"lineBreak":true},{"text":"o malaiñe anaio,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa natolo’o ho añondry kamaeñe,","poem":1},{"lineBreak":true},{"text":"vaho nampivarakaihe’o amo fifeheañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Naleta’o ami’ty minjilite’e ondati’oo,","poem":1},{"lineBreak":true},{"text":"tsy nahazoan-tombo’e t’ie naletake.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nampañinje’o o mpifankarineo, fanivetiveañe naho fandrabioñañe","poem":1},{"lineBreak":true},{"text":"amo mañohok’ anaio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Anoe’o oha-drehake o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"fikoliñan-doha am’ondatio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fañinjeañe ­lomoñandro ty aoloko eo,","poem":1},{"lineBreak":true},{"text":"vaho nampikolopok’ ahy","poem":1},{"lineBreak":true},{"text":"ty hameñaran-tareheko,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ami’ty fivola’ o mikobìke","poem":1},{"lineBreak":true},{"text":"naho mamàtseo;","poem":1},{"lineBreak":true},{"text":"ty amy fiatrefan-drafelahiy","poem":1},{"lineBreak":true},{"text":"vaho i mpamale-fatey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toe hene nifetsak’ ama’ay,","poem":1},{"lineBreak":true},{"text":"f’ie tsy nañaliño Azo,","poem":1},{"lineBreak":true},{"text":"vaho tsy nivalik’ amy fañina’oy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe tsy niamboho Azo o arofo’aio,","poem":1},{"lineBreak":true},{"text":"vaho tsy niveve amy lala’oy o fandia’aio,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"f’ie dinemo’o an-toem-panalok’ eo, vaho kinolopo’o an-talinjon-kavilasy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aa naho nandikofa’ay","poem":1},{"lineBreak":true},{"text":"ty tahinan’Añahare’ay,","poem":1},{"lineBreak":true},{"text":"ke namela-pitàñe aman-drahare","poem":1},{"lineBreak":true},{"text":"ankafankafa;","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tsy ho ­nitsikarahen’ Añahare hao?","poem":1},{"lineBreak":true},{"text":"Kanao arofoana’e ze mikafitse an-trok’ao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Eka, Ihe ro anjamanañe anay","poem":1},{"lineBreak":true},{"text":"handro am-pohatse;","poem":1},{"lineBreak":true},{"text":"volilieñe hoe añondry ho lentañe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mivañona, ry Talè, Ino ty irota’o?","poem":1},{"lineBreak":true},{"text":"Mitsekafa, ko farie’o","poem":1},{"lineBreak":true},{"text":"kitro katroke zahay.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Akore ty ampietaha’o laharañe,","poem":1},{"lineBreak":true},{"text":"naho añaliñoa’o ty hasotria’ay","poem":1},{"lineBreak":true},{"text":"vaho ty halovilovia’ay?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fa mibokok’ an-debok’ ao ty fiai’ay;","poem":1},{"lineBreak":true},{"text":"mipitek’ an-tane eo ty fisafoa’ay.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Miongaha hañolotse anay, vaho jebaño ty amy fiferenaiña’oy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}