,{"text":"am-bolonahe’o, hañonjonañe ty hatò","poem":1},{"lineBreak":true},{"text":"naho ty halèn-arofo,","poem":1},{"lineBreak":true},{"text":"vaho ty havantañañe;","poem":1},{"lineBreak":true},{"text":"le hañoke azo an-­draha mampañeveñe","poem":1},{"lineBreak":true},{"text":"ty fità’o havana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Masioñe ty ana-pale’o añ’arofon-drafelahi’ i mpanjakay ao—mihotrakotrak’ ambane’o","poem":1},{"lineBreak":true},{"text":"ondatio;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nainai’e donia, ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ty fiambesa’o;","poem":1},{"lineBreak":true},{"text":"kobain-kavantañañe","poem":1},{"lineBreak":true},{"text":"ty kobaim-pifehea’o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fitea’o ty havañonañe,","poem":1},{"lineBreak":true},{"text":"falai’o ty hatsivokarañe","poem":1},{"noteId":22},{"text":";","poem":1},{"lineBreak":true},{"text":"aa le nañory azo t’i Andrianañahare, Andrianañahare’o,","poem":1},{"lineBreak":true},{"text":"an-tsolim-pirebehañe","poem":1},{"lineBreak":true},{"text":"ambone’ o rañe’oo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ze hene saro’o ro tsotse naho emboke vaho mañidè!","poem":1},{"lineBreak":true},{"text":"marovany boak’ amo anjomba nitemereñe nifem-bibio ro ifalea’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anak’ampelam-panjaka","poem":1},{"lineBreak":true},{"text":"ro amo noro’oo;","poem":1},{"lineBreak":true},{"text":"mijohañe am-pitàn-kavana’o eo","poem":1},{"lineBreak":true},{"text":"ty tañanjomba’o am-bolamena","poem":1},{"lineBreak":true},{"text":"ki’ i Ofire.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitsendreña ry anak’ampela,","poem":1},{"lineBreak":true},{"text":"Inao! atokilaño ty sofi’o,","poem":1},{"lineBreak":true},{"text":"andikofo o rofoko’oo,","poem":1},{"lineBreak":true},{"text":"naho ty anjomban-drae’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mahasinda i mpanjakay","poem":1},{"lineBreak":true},{"text":"ty hamontramontra’o;","poem":1},{"lineBreak":true},{"text":"iambaneo kanao talè’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hibanabana ama’e","poem":1},{"lineBreak":true},{"text":"ty anak’ ampela’ i Tsore,","poem":1},{"lineBreak":true},{"text":"Hipay fañisoahañ’ ama’e o mpañaleale am’ondatio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fanjàka añ’anjomba ao","poem":1},{"lineBreak":true},{"text":"ty anak’ampela’ i mpanjakay,","poem":1},{"lineBreak":true},{"text":"vinahotse am-­bolamena o saro’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho roroteñe mb’amy mpanjakay mb’eo","poem":1},{"lineBreak":true},{"text":"an-tsaroñe soa vinahotse,","poem":1},{"lineBreak":true},{"text":"hasese ama’o rekets’ o somondrara","poem":1},{"lineBreak":true},{"text":"mpiama’e mpañotroñe azeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amañ’ehake naho an-drebeke","poem":1},{"lineBreak":true},{"text":"ro aneseañe iareo; ie ampiziliheñe añ’anjomba’ i mpanjakay.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Handimbe’an-droae’o o ana-dahi’oo;","poem":1},{"lineBreak":true},{"text":"horiza’o ho mpiaolo’ i tane iabiy iereo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hampitiahieko ze hene tariratse","poem":1},{"lineBreak":true},{"text":"ty tahina’o,","poem":1},{"lineBreak":true},{"text":"hañandriañe azo nainai’e donia ondatio.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Heb 1:8-9","reference":{"chapter":45,"verse":7}}]},"thisChapterLink":"/api/tdx_sle/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/46.json","nextChapt