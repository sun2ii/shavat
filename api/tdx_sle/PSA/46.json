{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":46,"content":[{"type":"heading","content":["Ho a i Talè, Sabo o ana’ i Korao, saboen’ Ampela"]},{"type":"verse","number":1,"content":[{"text":"Fitsolohañe naho haozaran-tika","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"Mpañolotse t’ie ampoheke tendrek’ aniany.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aa le tsy ho hemban-tika","poem":1},{"lineBreak":true},{"text":"ndra te migorobañe ty tane,","poem":1},{"lineBreak":true},{"text":"ndra midorasitse mb’am-po’","poem":1},{"lineBreak":true},{"text":"i riakey o vohitseo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndra te mitroñe","poem":1},{"lineBreak":true},{"text":"naho mamore i riakey,","poem":1},{"lineBreak":true},{"text":"ndra te miezeñezeñe amy fitoabora’","poem":1},{"lineBreak":true},{"text":"o alo’eo o vohitseo. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eo ty oñe mahafale ty rovan’ añahare","poem":1},{"lineBreak":true},{"text":"amo fitsiritsioha’eo,","poem":1},{"lineBreak":true},{"text":"ty kivoho masi’ i Andindimoneñey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Añivo’e ao t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"le tsy hasiotse;","poem":1},{"lineBreak":true},{"text":"hañimb’aze t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"te manjirik’andro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nidabadoa o kilakila ondatio,","poem":1},{"lineBreak":true},{"text":"niozoñozoñe o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"nipazake i fiarañanaña’ey,","poem":1},{"lineBreak":true},{"text":"nitranake ty tane.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aman-tika t’Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"fipaliran-tika t’i Andrianañahare’ Iakobe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mb’etoa, mahaoniña","poem":1},{"lineBreak":true},{"text":"o tolon-draha’ Iehovào,","poem":1},{"lineBreak":true},{"text":"o raha mampangebahebake","poem":1},{"lineBreak":true},{"text":"nanoe’e an-tane atoio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampitsiñe’e sikal’añ’olo-tane añe o alio;","poem":1},{"lineBreak":true},{"text":"peñapeñafe’e o faleo, pozahe’e o lefoñeo,","poem":1},{"lineBreak":true},{"text":"sodora’e añ’afo o sareten-tafikeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mijihera, vaho mahafohina te","poem":1},{"lineBreak":true},{"text":"izaho ro Andrianañahare;","poem":1},{"lineBreak":true},{"text":"onjoneñe amo fifeheañeo iraho,","poem":1},{"lineBreak":true},{"text":"izonjonañe an-tane atoy !","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aman-tika t’Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"fipaliran-tika t’i Andrianañahare’","poem":1},{"lineBreak":true},{"text":"Iakobe. Selà","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}