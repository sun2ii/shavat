lineBreak":true},{"text":"Nionjoñe am-pipoñafam-pitreñañe","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare;","poem":1},{"lineBreak":true},{"text":"ami’ty fivolan’antsiva t’Iehovà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Takasio t’i Andrianañahare, isabo;","poem":1},{"lineBreak":true},{"text":"takasio i mpanjakan-tikañey, isabo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro mpanjaka’","poem":1},{"lineBreak":true},{"text":"ty tane toy;","poem":1},{"lineBreak":true},{"text":"mitakasia an-tsabo soa arake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fehen’ Andrianañahare o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"miambesatse am-piambesa’e masiñe","poem":1},{"lineBreak":true},{"text":"eo t’i Andrianañahare.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mifanontoñe o roandria’ ondatio;","poem":1},{"lineBreak":true},{"text":"ondatin’ Andrianañahare’ i Avrahameo","poem":1},{"lineBreak":true},{"text":"fa an’Andrianañahare","poem":1},{"lineBreak":true},{"text":"o fikalan-defo’ ty tane toio;","poem":1},{"lineBreak":true},{"text":"ie onjoneñ’ an-tiotiotse ey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}