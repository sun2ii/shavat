{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":49,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ o Ana’ i Korao"]},{"type":"verse","number":1,"content":[{"text":"Janjiño zao, ry kilakila ondatio;","poem":1},{"lineBreak":true},{"text":"manokilaña ravembia,","poem":1},{"lineBreak":true},{"text":"ze hene mpimone’ ty tane toy;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ty ambane naho ty ambone,","poem":1},{"lineBreak":true},{"text":"ty mpañaleale miharo ami’ty rarake.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hivolan-kihitse ty vavako,","poem":1},{"lineBreak":true},{"text":"vaho ho ereñeren-troko ty hilala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hatokilako mb’am-","poem":1},{"lineBreak":true},{"text":"pandrazañan-drehake ty sofiko.","poem":1},{"lineBreak":true},{"text":"ho ventareko an-dokanga","poem":1},{"lineBreak":true},{"text":"ty tafatòñoko,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ino ty hahahembañ’ ahiko","poem":1},{"lineBreak":true},{"text":"an-tsan-kankàñe,","poem":1},{"lineBreak":true},{"text":"ie miarikoboñe ahy ty hatsivokara’","poem":1},{"lineBreak":true},{"text":"o mpañonjo-tomitse amakoo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"o mpiato amo fanaña’eoo,","poem":1},{"lineBreak":true},{"text":"vaho mirengevok’ ami’ty habei’ o vara’eo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Leo ondaty raike, ndra manao akore, tsy hahavoavily ty ain-dongo’e, ndra hibanabana jebañe","poem":1},{"lineBreak":true},{"text":"aman’Añahare ho aze—","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Loho sarotse ty vilin’ ai’e,","poem":1},{"lineBreak":true},{"text":"tsy mete tsy hadoke kitro katroke:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"—t’ie ho veloñe nainai’e,","poem":1},{"lineBreak":true},{"text":"tsy hahaoniñ’ i koboñey,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ie oni’e te mihomake o mahihitseo;","poem":1},{"lineBreak":true},{"text":"songa mikenkañe ty minè naho i dagola,","poem":1},{"lineBreak":true},{"text":"vaho apo’e amo ila’eo ty vara’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ty fitsakorean-tro’ iareo t’ie tsy ho modo o akiba’eo,","poem":1},{"lineBreak":true},{"text":"naho ty fimoneña’ iareo","poem":1},{"lineBreak":true},{"text":"mb’an-tariratse iaby kitro añ’afe’e,","poem":1},{"lineBreak":true},{"text":"ie atao’e amy añara’ey i tane’ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe tsy mahatan-ty asi’e ondatio;","poem":1},{"lineBreak":true},{"text":"le manahake o bibio t’ie mate.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Izay ty fombà’ o sèretseo,","poem":1},{"lineBreak":true},{"text":"naho o mandimbe iareoo,","poem":1},{"lineBreak":true},{"text":"ze miantoke ty enta’ iareoo. Selà","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hoe añondry iereo","poem":1},{"lineBreak":true},{"text":"tinendry ho mb’an-kibory ao,","poem":1},{"lineBreak":true},{"text":"ho mpiara’iareo ty havilasy;","poem":1},{"lineBreak":true},{"text":"ho fehe’ o vañoñeo te maraindray;","poem":1},{"lineBreak":true},{"text":"ho a’ i tsikeokeokey ty vinta’ iareo","poem":1},{"lineBreak":true},{"text":"hihomak’ ao, tsy hanaña’ iareo akiba ka.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fe ho jebañen’ Añahare","poem":1},{"lineBreak":true},{"text":"ami’ty haozara’ o kiborio ty fiaiko,","poem":1},{"lineBreak":true},{"text":"le ho rambese’e. Selà","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ko hemban-­drehe naho mihamaro ty vara’ ondaty,","poem":1},{"lineBreak":true},{"text":"naho mitombo ty enge’ i anjomba’ey;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"F’ie mihomake, tsy eo ty hendese’e.","poem":1},{"lineBreak":true},{"text":"tsy hañorik’ aze higodañe ao ty enge’e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Eka! nitata’e","poem":1},{"lineBreak":true},{"text":"ty fiai’e te niveloñe:","poem":1},{"lineBreak":true},{"text":"Nitsiririeñe t’ie niraorao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Homb’am-pimoneñan-droae’e ao re;","poem":1},{"lineBreak":true},{"text":"tsy ho isa’e ka ty hazavàñe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"T’indaty iasiañe, mete tsy maharendreke t’ie, manahake o bibio, hihomake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}