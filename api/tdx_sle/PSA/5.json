{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":5,"content":[{"type":"heading","content":["Ho a i Talèn-tsakera : an-Tsoly Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"O ry Iehovà, toloro ravembia","poem":1},{"lineBreak":true},{"text":"o volakoo;","poem":1},{"lineBreak":true},{"text":"ereñereo o toreokoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haoño ty feon-koiko ry Mpanjakako","poem":1},{"lineBreak":true},{"text":"naho Andrianañahareko :","poem":1},{"lineBreak":true},{"text":"Ihe ro ihalaliako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Handro ty hijanjiña’o ty feoko r’Iehovà;","poem":1},{"lineBreak":true},{"text":"Maraindraiñe te honjoñeko vaho hiandra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy mahafale azo ry Andrianañahare ty haratiañe;","poem":1},{"lineBreak":true},{"text":"mbore tsy hañialo ama’o ty haloloañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy hijohañe añ’atrefam-pihaino’o","poem":1},{"lineBreak":true},{"text":"o mpirebodrebokeo;","poem":1},{"lineBreak":true},{"text":"fonga heje’o ze mitolon-draha kafoake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho rotsahe’o ze mivolam-bande;","poem":1},{"lineBreak":true},{"text":"heje’ Iehovà","poem":1},{"lineBreak":true},{"text":"t’indaty mampiori-dio naho ty mamañahy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe naho izaho, i fo ferenaiña’o fonitsey ty himoahako añ’anjomba’o ao, vaho hiambane mb’añ’anjomba’o","poem":1},{"lineBreak":true},{"text":"miavake mb’eo, fa mañeveñ’ ama’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà, Iaolò ami’ty hatò’o","poem":1},{"lineBreak":true},{"text":"ty amo mivoñoñe ahikoo;","poem":1},{"lineBreak":true},{"text":"avantaño añatrefako eo ty lala’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy am-pahitiañe ty vava’ iareo;","poem":1},{"lineBreak":true},{"text":"hatsivokarañe ty an-tro’e ao;","poem":1},{"lineBreak":true},{"text":"kibory misokake o tretra’eo,","poem":1},{"lineBreak":true},{"text":"ie mitsiriry am-pameleke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ozoño iereo, ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"hikorovok’ ami’ty fikililia’iareo;","poem":1},{"lineBreak":true},{"text":"soiho añe ami’ty habeim-piolà’iareo","poem":1},{"lineBreak":true},{"text":"amy t’ie niody ama’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hene hirebeke ze mipalitse ama’o, hiriñariña an-kobaiñe nainai’e;","poem":1},{"lineBreak":true},{"text":"le ampialofo,","poem":1},{"lineBreak":true},{"text":"handia taroba ama’o o mpikoko ty tahina’oo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe ihe ty mampanintsiñe o vantañeo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, ohoñe’o fañisohañe","poem":1},{"lineBreak":true},{"text":"hoe te am-pikalan-defoñe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}