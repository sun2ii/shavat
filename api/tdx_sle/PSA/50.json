{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":50,"content":[{"type":"heading","content":["Sabo’ i Asafe"]},{"type":"verse","number":1,"content":[{"text":"Nitsara t’Iehovà Andrianañahare","poem":1},{"lineBreak":true},{"text":"Tsitongerè, nikoike ty tane toy","poem":1},{"lineBreak":true},{"text":"boak’ am-panjiriha’ i àndroy","poem":1},{"lineBreak":true},{"text":"sikal’ am-pitsofora’e añe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hirik’e Tsiône ao,","poem":1},{"lineBreak":true},{"text":"ty hafoniran-kamotsotsoreñe,","poem":1},{"lineBreak":true},{"text":"ty fireandreañan’ Añahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mb’ etoy i Andrianañaharen-tikañey,","poem":1},{"lineBreak":true},{"text":"ie tsy hianjiñe;","poem":1},{"lineBreak":true},{"text":"mamorototo aolo’e ty afo,","poem":1},{"lineBreak":true},{"text":"iarisehoa’ ty tangololahy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kanjie’e mb’andikerañe añ’abo eñe,","poem":1},{"lineBreak":true},{"text":"naho mb’an-tane atoy","poem":1},{"lineBreak":true},{"text":"hizaka’e ondati’eo:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atontono amako o norokoo, o nifañina amako an-tsoroñeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitsey ty havantaña’e o likerañeo;","poem":1},{"lineBreak":true},{"text":"amy te Ie ro Andrianañahare,","poem":1},{"lineBreak":true},{"text":"Ie ty Mpizaka. Selà","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mijanjiña ry ondatiko,","poem":1},{"lineBreak":true},{"text":"le hivolan-dRaho;","poem":1},{"lineBreak":true},{"text":"Ry Israeleo, hisesehako,","poem":1},{"lineBreak":true},{"text":"Izaho ro Andrianañahare, Andrianañahare’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsy o fisoroña’oo ro añendahako azo,","poem":1},{"lineBreak":true},{"text":"ie añatrefako eo nainai’e","poem":1},{"lineBreak":true},{"text":"o enga fañoroa’oo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho rambeseko boak’añ’akiba’o ao","poem":1},{"lineBreak":true},{"text":"ty añombelahy,","poem":1},{"lineBreak":true},{"text":"ndra hirik’an-golobo’o ao ty oselahy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amy te hene ahiko ze biby añ’ala ao,","poem":1},{"lineBreak":true},{"text":"naho ty añombe am-bohits’ arivo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Haiko iaby o voroñe am-bohitseo,","poem":1},{"lineBreak":true},{"text":"Fonga ahiko ze misitsitse an-kivok’ ao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Naho nikerè Raho, tsy ho nivolañe,","poem":1},{"lineBreak":true},{"text":"amy te Ahiko ty voatse toy,","poem":1},{"lineBreak":true},{"text":"naho ty halifora’e.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hihinañako hao ty nofo’ o añombeo?","poem":1},{"lineBreak":true},{"text":"hinomako hao ty lio’ o oselahio?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Engao aman’ Añahare","poem":1},{"lineBreak":true},{"text":"ty sorom-pañandriañañe,","poem":1},{"lineBreak":true},{"text":"naho avaho amy Andindimoneñey","poem":1},{"lineBreak":true},{"text":"o nifantà’oo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Le koiho Raho añ’andro","poem":1},{"lineBreak":true},{"text":"maha-an-koheke;","poem":1},{"lineBreak":true},{"text":"ho hahako irehe, vaho hiasia’o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa hoe t’i ­Andrianañahare","poem":1},{"lineBreak":true},{"text":"amo tsivokatseo","poem":1},{"lineBreak":true},{"text":"Ino ty anoñona’o o fandiliakoo?","poem":1},{"lineBreak":true},{"text":"vaho endese’o am-bava’o ao i fañinakoy?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Inao t’ie malain-dilo,","poem":1},{"lineBreak":true},{"text":"naho afetsa’o amboho’o ao o entakoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie manjo-mpikizo irehe, le no’o,","poem":1},{"lineBreak":true},{"text":"vaho ireketa’o o karapiloo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Avotso’o an-kaloloañe ty falie’o,","poem":1},{"lineBreak":true},{"text":"vaho mikilily fitake ty famele’o.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mitoboke irehe vaho mifosa rahalahy;","poem":1},{"lineBreak":true},{"text":"dramote’o ty anan-drene’o.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie anoe’o izay, hijomohoñe hao Raho?","poem":1},{"lineBreak":true},{"text":"natao’o ho hambañe ama’o hao,","poem":1},{"lineBreak":true},{"text":"toe endahako,","poem":1},{"lineBreak":true},{"text":"vaho alahako añatrefam-pihaino’o eo","poem":1},{"lineBreak":true},{"text":"o entako ty ama’oo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa le ereñereo zao,","poem":1},{"lineBreak":true},{"text":"ry mpandikok’ an’Andrianañahareo","poem":1},{"lineBreak":true},{"text":"kera ho rangodrangoteko,","poem":1},{"lineBreak":true},{"text":"ihe tsy amam-pañaha.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mañonjoñ’ Ahy ty mañenga","poem":1},{"lineBreak":true},{"text":"sorom-pañandriañañe;","poem":1},{"lineBreak":true},{"text":"vaho hampalangeseko","poem":1},{"lineBreak":true},{"text":"amy mamantañe i fañaveloa’eiy","poem":1},{"lineBreak":true},{"text":"ty fandrombahan’ Añahare.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}