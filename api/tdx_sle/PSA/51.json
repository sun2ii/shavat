{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":51,"content":[{"type":"heading","content":["Ho a i Talè: Sabo’ i Davide, ami’ty fitiliha’ i Natana mpitoky, ie fa niolots’ amy Bat’sebae."]},{"type":"verse","number":1,"content":[{"text":"Ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"matariha amy hafatraram-pikokoa’o, faopaoho o fiolàkoo amo hara’elahim-piferenaiña’oo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kotriño hitoratsike amo tahikoo,","poem":1},{"lineBreak":true},{"text":"liovo amo fandilarakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apotako o fiolàkoo:","poem":1},{"lineBreak":true},{"text":"vaho miatrek’ ahy nainai’e o hakeokoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ama’o, le ama’o avao ty nandilarako;","poem":1},{"lineBreak":true},{"text":"naho nanao hatsivokarañe","poem":1},{"lineBreak":true},{"text":"am-pivazohoa’o;","poem":1},{"lineBreak":true},{"text":"soa te ho rendreke to t’ie mitsara,","poem":1},{"lineBreak":true},{"text":"vaho vantañe te mizaka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toe naterak’ an-kakeo iraho,","poem":1},{"lineBreak":true},{"text":"naho an-tahiñe t’ie niareñen-drene.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inao, mipay hatò añ’ova ao irehe,","poem":1},{"lineBreak":true},{"text":"aa le ampandrendreho hìhitse","poem":1},{"lineBreak":true},{"text":"mietake iraho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Efero an-tseva","poem":1},{"noteId":23},{"text":"iraho, hikotritriake;","poem":1},{"lineBreak":true},{"text":"ampandrò ho foty matsatsaoke","poem":1},{"lineBreak":true},{"text":"te amo volovasoo","poem":1},{"noteId":24},{"text":".","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ampitsanoño firebehañe","poem":1},{"lineBreak":true},{"text":"naho hafalean-draho;","poem":1},{"lineBreak":true},{"text":"soa te hiankahake o taolañe dinemo’oo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aetaho amo tahikoo ty lahara’o,","poem":1},{"lineBreak":true},{"text":"ehe fonga forò o hakeokoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Itseneo fo vao ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"le vaò añ’ovako ao ty troke migahiñe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ko ahifike tsy ho añatrefa’o eo iraho,","poem":1},{"lineBreak":true},{"text":"le ko apitsok’ amako i Arofo’o Masiñey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ampolio amako ty hafalea’","poem":1},{"lineBreak":true},{"text":"i fandrombaha’oy,","poem":1},{"lineBreak":true},{"text":"itohano ho aman-troke mahimbañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le hampahafohineko","poem":1},{"lineBreak":true},{"text":"o aman-kakeoo o lala’oo,","poem":1},{"lineBreak":true},{"text":"hampipoliañe o mpanan-tahiñeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hahao ami’ty lio-màlin-draho,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare, Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahañ’ ahikoy;","poem":1},{"lineBreak":true},{"text":"le ho saboen-delako o havantaña’oo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"O Talè, sokafo o soñikoo","poem":1},{"lineBreak":true},{"text":"hitaroñam-bavako ty fandrengeañ’ Azo","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Toe tsy mahafale Azo o soroñeo,","poem":1},{"lineBreak":true},{"text":"fa ho nibanabanaeko;","poem":1},{"lineBreak":true},{"text":"tsy no’o o soroñe oroañeo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ty soron’ Añahare, le troke mihoto;","poem":1},{"lineBreak":true},{"text":"tsy ho sirikae’o ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ty arofo rofotse naho mikoretse.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hasoao i Tsiône ami’ty fatariha’o;","poem":1},{"lineBreak":true},{"text":"atroaro o kijoli’ Ierosalaimeo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Izay vaho ho no’o","poem":1},{"lineBreak":true},{"text":"o sorom-bantañeo:","poem":1},{"lineBreak":true},{"text":"o soroñe oroañeo naho soroñ’ añoñeo;","poem":1},{"lineBreak":true},{"text":"le hengaeñe bania ambone’ i kitreli’oy.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Hysopa: rongoñe famitsen-dio: Avo 12.22","reference":{"chapter":51,"verse":7}},{"noteId":24,"caller":"+","text":"ranom-panala","reference":{"chapter":51,"verse":7}}]},"thisChapterLink":"/api/tdx_sle/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}