{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":52,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide, naho niheo mb’amy Saole t’i Doege nte Edome, nitalily te noly añ’anjomba’ i Ahimeleke t’i Davide."]},{"type":"verse","number":1,"content":[{"text":"O Fanalolahio, ino ty firoharohà’o","poem":1},{"lineBreak":true},{"text":"hatsivokarañe?","poem":1},{"lineBreak":true},{"text":"Lomoñandro ty ­fiferenaiñan’ Añahare.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mikilily ­fandrotsahañe ty famele’o,","poem":1},{"lineBreak":true},{"text":"manahake ty fiharatse masioñe;","poem":1},{"lineBreak":true},{"text":"ty mpamañahy tia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tea’o ty raty te ami’ty soa;","poem":1},{"lineBreak":true},{"text":"i lañitsey ta te hivolan-to. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"No’o ze atao fivolan-katramoañe, ty fameleke mamañahy tia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa le harotsan’Añahare kitro-katroke, ho sintone’e, le hapitso’e amy kiboho’oy, vaho hombota’e an-tanen-kaveloñe. Selà","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ho isa’ o vantañeo, naho hañeveñe","poem":1},{"lineBreak":true},{"text":"vaho hiankahake ty hoe :","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hehe t’indaty tsy nanao","poem":1},{"lineBreak":true},{"text":"an’Andrianañahare ho fipalira’e;","poem":1},{"lineBreak":true},{"text":"fe ty habei’ o vara’eo ty niatoa’e,","poem":1},{"lineBreak":true},{"text":"vaho o fikinia’eo ty nihaozara’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa naho izaho, le hoe sakoa mandrevake","poem":1},{"lineBreak":true},{"text":"añ’anjomban’Añahare ao;","poem":1},{"lineBreak":true},{"text":"iatoako nainai’e donia","poem":1},{"lineBreak":true},{"text":"ty fiferenaiñan’ Añahare,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Andriañeko nainai’e irehe,","poem":1},{"lineBreak":true},{"text":"amy te Ihe ty nanao izay,","poem":1},{"lineBreak":true},{"text":"vaho ho tamaeko i tahina’oy","poem":1},{"lineBreak":true},{"text":"ie ty soa añatrefa’ o noro’oo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}