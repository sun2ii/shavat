{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":53,"content":[{"type":"heading","content":["Ho a i Talè, atao Hasilofañe, Fanoroa’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Hoe ty dagola an-tro’e ao:","poem":1},{"lineBreak":true},{"text":"Tsy ao t’i Andrianañahare.","poem":1},{"lineBreak":true},{"text":"Vàlañe iareo,","poem":1},{"lineBreak":true},{"text":"mpanao hakeo mampangorý;","poem":1},{"lineBreak":true},{"text":"leo raike tsy manao soa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jiloven’ Añahare boak’an-dikerañe ao","poem":1},{"lineBreak":true},{"text":"o ana’ ondatio,","poem":1},{"lineBreak":true},{"text":"hivazohoa’e ke ao ty mahilala,","poem":1},{"lineBreak":true},{"text":"mpitsoek’ an’Andrianañahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Songa niamboho,","poem":1},{"lineBreak":true},{"text":"niharo naniva vatañe,","poem":1},{"lineBreak":true},{"text":"tsy eo ty manao soa, leo raike.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsy maharendreke hao","poem":1},{"lineBreak":true},{"text":"o mpitolon-karatiañeo?","poem":1},{"lineBreak":true},{"text":"o mampibotseke ondatiko","poem":1},{"lineBreak":true},{"text":"hoe mitamboavokake mofo,","poem":1},{"lineBreak":true},{"text":"vaho tsy mikanjy an’Andrianañahareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hehe t’ie mirevendreveñe,","poem":1},{"lineBreak":true},{"text":"ndra te tsy eo ty mahahembañe;","poem":1},{"lineBreak":true},{"text":"fa navarakain’ Añahare ty taola’","poem":1},{"lineBreak":true},{"text":"o nitobe hiatreatre azoo;","poem":1},{"lineBreak":true},{"text":"nisalare’o, fa naforintsen’Añahare.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toe hiboake amy Tsiône","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe Israele!","poem":1},{"lineBreak":true},{"text":"Ie hampolien’ Añahare ondati’e mirohio;","poem":1},{"lineBreak":true},{"text":"Le hirebeke t’Iakobe, vaho hifale t’Israele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}