{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":54,"content":[{"type":"heading","content":["Ho a i Talè, ami’ty Marotaly, Fanoroa’ i Davide: ie niheo amy Saole o nte-Zifio nanao ty hoe: Aa vaho tsy ama’ay ao hao ty fietaha’ i Davide?"]},{"type":"verse","number":1,"content":[{"text":"Rombaho iraho ry Andrianañahare","poem":1},{"lineBreak":true},{"text":"ty amy tahina’oy,","poem":1},{"lineBreak":true},{"text":"vaho meo-to amo haozara’oo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare, janjiño ty halaliko,","poem":1},{"lineBreak":true},{"text":"toloro ravembia o entam-bavakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Miongake hiatreatre ahy ty ambahiny,","poem":1},{"lineBreak":true},{"text":"paia’ o mitrotrofiakeo ty fiaiko,","poem":1},{"lineBreak":true},{"text":"tsy nampiaoloe’ iareo","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inao! Mpañimb’ahy t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"Fiatoam-piaiko t’i Talè.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hafote’e amo mivoñoñe ahiko","poem":1},{"lineBreak":true},{"text":"ty haratia’ iareo;","poem":1},{"lineBreak":true},{"text":"Rotsaho iereo ami’ty figahiña’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mañenga ama’o an-tsatrin-tro iraho,","poem":1},{"lineBreak":true},{"text":"andriañeko i tahina’oy ry Iehovà, amy te ie ty soa;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa nafaha’e amako","poem":1},{"lineBreak":true},{"text":"ze hene haemberañe,","poem":1},{"lineBreak":true},{"text":"vaho nisambae’ o masokoo o rafelahikoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}