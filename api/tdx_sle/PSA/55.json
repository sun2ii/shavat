{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":55,"content":[{"type":"heading","content":["Ho a i Talè, Ami’ty Marotaly; Fanoroa’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Janjiño o ­filolohakoo ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"ko mietak’ amo halalikoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haoño iraho, le toiño;","poem":1},{"lineBreak":true},{"text":"ie tsitoboboly am-pitoreoko,","poem":1},{"lineBreak":true},{"text":"toe miñeoñeoñe avao","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ty amy feon-drafelahikoy,","poem":1},{"lineBreak":true},{"text":"ami’ty fanindria’ o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"ie mametsa-kasosorañe;","poem":1},{"lineBreak":true},{"text":"vaho am-piloroloroañe","poem":1},{"lineBreak":true},{"text":"ty atreatré’ iareo ahy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miola ty an-troko ao,","poem":1},{"lineBreak":true},{"text":"vaho midoiñ’ amako","poem":1},{"lineBreak":true},{"text":"ty fangeba­hebàn-kavilasy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Midoñ’amako ty firevendreveñañe","poem":1},{"lineBreak":true},{"text":"naho ty fihondrahondràñe,","poem":1},{"lineBreak":true},{"text":"vaho opoe’ ty anifañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hoe raho : Ee te nanañ’ elatse","poem":1},{"lineBreak":true},{"text":"hoe deho!","poem":1},{"lineBreak":true},{"text":"le ho nitiliñe añe vaho nitofa;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eka, ho niherereake mb’eo,","poem":1},{"lineBreak":true},{"text":"ho nañialo am-patrambey añe. Selà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho nifiotse mb’am-­pipalirako mb’eo,","poem":1},{"lineBreak":true},{"text":"ty ami’ty tio-bey naho ty afo-rano.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Votemboteo ry Talè,","poem":1},{"lineBreak":true},{"text":"tseraho ty famele’ iareo,","poem":1},{"lineBreak":true},{"text":"fa nahatrea piaroteñe naho fiolañe","poem":1},{"lineBreak":true},{"text":"an-drova ao iraho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Handro an-kaleñe iereo ro","poem":1},{"lineBreak":true},{"text":"mitingatinga ambone kijoly ey,","poem":1},{"lineBreak":true},{"text":"añivo’e ao ty hatsivokarañe","poem":1},{"lineBreak":true},{"text":"naho fikitrohan-draty.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Firotsahañe ty añivo’e ao,","poem":1},{"lineBreak":true},{"text":"tsy mienga o kiririsa’eo","poem":1},{"lineBreak":true},{"text":"ty joy naho ty fìtake.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsy t’ie rafelahy te mañìnje ahy,","poem":1},{"lineBreak":true},{"text":"fa ho nileoko,","poem":1},{"lineBreak":true},{"text":"tsy t’ie mpalaiñ’ ahy te itoabora’e,","poem":1},{"lineBreak":true},{"text":"fa ho nietahako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Te mone ihe, rahambako,","poem":1},{"lineBreak":true},{"text":"mpiamako naho rañeko,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nimamy ty fifañohahòhan-tika,","poem":1},{"lineBreak":true},{"text":"mbore nitrao-pivovotse amy màroy mb’añ’anjomban’ Añahare mb’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ee t’ie ho fañahieñe","poem":1},{"lineBreak":true},{"text":"mb’am-pihomaham-beo,","poem":1},{"lineBreak":true},{"text":"agodoño veloñe an-tsikeokeok’ ao;","poem":1},{"lineBreak":true},{"text":"amy te an-­kaloloañe ao ty kiboho’e;","poem":1},{"lineBreak":true},{"text":"añivo’e ao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa naho izaho, ho kanjieko t’Andrianañahare;","poem":1},{"lineBreak":true},{"text":"vaho handrombak’ ahy t’Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hariva naho handro vaho an-tsipinde ty hitoreovako","poem":1},{"lineBreak":true},{"text":"naho hiñeoñeoñe;","poem":1},{"lineBreak":true},{"text":"vaho ho janji’e ty feoko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hijebaña’e an-kanintsiñe","poem":1},{"lineBreak":true},{"text":"amy fifandraparapahañe amakoy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hijanjiñe t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"vaho ho toiñe’e iareo;","poem":1},{"lineBreak":true},{"text":"I miambesatse am-piambesa’e haehaey, Selà","poem":1},{"lineBreak":true},{"text":"toe tsy miova iareo,","poem":1},{"lineBreak":true},{"text":"tsy mañeveñe aman’ Añahare.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"F’ie mañonjo-haoke hañatreatre","poem":1},{"lineBreak":true},{"text":"amo nifampilongo ama’eo,","poem":1},{"lineBreak":true},{"text":"ie nifotetse amy fañina’ey,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nalama te amo solikeo o entam-palie’eo fe aly avao ty añ’ arofo’e ao;","poem":1},{"lineBreak":true},{"text":"nalea ta o menakeo o saontsi’eo,","poem":1},{"lineBreak":true},{"text":"te mone fibara napontsoañe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Apoho am’ Iehovà o kilanka’oo,","poem":1},{"lineBreak":true},{"text":"le ho tohaña’e;","poem":1},{"lineBreak":true},{"text":"tsy hado’e higavingaviñe o vantañeo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"F’ihe ry Andrianañahare:","poem":1},{"lineBreak":true},{"text":"ro hampijoroboñ’ iareo","poem":1},{"lineBreak":true},{"text":"an-kobon-dalek’ao;","poem":1},{"lineBreak":true},{"text":"tsy hiveloma’ ondaty mampiori-dio","poem":1},{"lineBreak":true},{"text":"naho mamañahio, ty an-tsasa’ o andro’eo, fa naho izaho, Ihe ro hiatoako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}