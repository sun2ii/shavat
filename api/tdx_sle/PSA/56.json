{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":56,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide naho ni­tsepak’ aze e Gate o nte Pelistio; atao ami’ty feo Deho amy Nonok’ aroañey"]},{"type":"verse","number":1,"content":[{"text":"Tretrezo iraho ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"fa lialia’ ondatio;","poem":1},{"lineBreak":true},{"text":"forekeke’e amañ’aly handro am-pohatse.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Te handialia ahy lomoñandro","poem":1},{"lineBreak":true},{"text":"o mivoñoñ’ ahikoo;","poem":1},{"lineBreak":true},{"text":"amy te maro ty mifandrava amako,","poem":1},{"lineBreak":true},{"text":"ry Andindimoneñey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amy andro mampangebahebak’ ahy,","poem":1},{"lineBreak":true},{"text":"Ihe ty hiatoako,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aman’Andrianañahare","poem":1},{"lineBreak":true},{"text":"—handrengeako o tsara’eo—","poem":1},{"lineBreak":true},{"text":"fa iatoako t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"tsy ho hemban-draho;","poem":1},{"lineBreak":true},{"text":"inoñe ty hanoe’ o nofotseo amako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Embere’ iereo lomoñandro","poem":1},{"lineBreak":true},{"text":"o fitoloñakoo; fikitrohan-draty avao ty ereñeren-tro’iareo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mifañosoñe iereo, mietake, mitinoñe ty liako; mandiñe hitsepake ty fiaiko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ty hatsivokara’ iareo—tsy hipoliotse.","poem":1},{"lineBreak":true},{"text":"Aretsaho an-kaviñerañe ondatio,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa vinolili’o o firererereakoo;","poem":1},{"lineBreak":true},{"text":"apoho an-jonjò’o ao","poem":1},{"lineBreak":true},{"text":"o ranomasokoo;","poem":1},{"lineBreak":true},{"text":"tsy amy boke’oy hao irezay?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hitolike amy zao o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"amy andro kanjiekoy,","poem":1},{"lineBreak":true},{"text":"Zao ty rendreko,","poem":1},{"lineBreak":true},{"text":"te mpañimb’ ahy t’i Andrianañahare,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro andrengeako o tsara’eo,","poem":1},{"lineBreak":true},{"text":"Iehovà ro añonjonako o saontsi’eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro fiatoako,","poem":1},{"lineBreak":true},{"text":"tsy ho hemban-draho,","poem":1},{"lineBreak":true},{"text":"inoñe ty hanoe’ ondaty amako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Havahako o nifantàkoo,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"hañenga fañandriañañe ama’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amy te vinotso’o ty fiaiko","poem":1},{"lineBreak":true},{"text":"tsy hikenkañe;","poem":1},{"lineBreak":true},{"text":"Eka! o tomboko tsy hitsikapy,","poem":1},{"lineBreak":true},{"text":"ie hijelanjelañe añatrefan’Añahare eo","poem":1},{"lineBreak":true},{"text":"an-kazavan-kaveloñe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}