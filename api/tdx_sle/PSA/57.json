{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":57,"content":[{"type":"heading","content":["Ho a i Talè, Haja’ i Davide, ie nibioñ’ amy Saoly mb’an-dakato ao ami’ty feo : Ko Rotsahe’o."]},{"type":"verse","number":1,"content":[{"text":"Tretrezo iraho ry Andrianañahare, iferenaiño,","poem":1},{"lineBreak":true},{"text":"fa Ihe ro fitsoloham-piaiko; eka! an-talinjon’ ela’o ao ty fipalirako, ampara’ te ihelaña’ ty hankàñe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kanjieko t’i Andrianañahare Abo-tia;","poem":1},{"lineBreak":true},{"text":"Aman’ Añahare fahatafeterako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hahitri’e hirik’an-dikerañe ao","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe ahy,","poem":1},{"lineBreak":true},{"text":"endaha’e i mandialia ahikoy. Selà","poem":1},{"lineBreak":true},{"text":"Ho sangitrihen’ Añahare ty fiferenaiña’e naho ty hatò’e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An-teñateñan-diona ao ty fiaiko;","poem":1},{"lineBreak":true},{"text":"itraofako handre o mpikofòke afoo;","poem":1},{"lineBreak":true},{"text":"toe o ana’ ondatio,","poem":1},{"lineBreak":true},{"text":"lefoñe naho ana-pale o famotsi’eo,","poem":1},{"lineBreak":true},{"text":"fibara masioñe ty famele’iareo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Onjoneñe ambone’ i likerañey irehe,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ambone’ ty tane toy iaby ty enge’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nikotepe’ iareo harato o liakoo;","poem":1},{"lineBreak":true},{"text":"mibokobokoke ty fiaiko;","poem":1},{"lineBreak":true},{"text":"nihalia’ iereo koboñe ty aoloko eo,","poem":1},{"lineBreak":true},{"text":"f’ie nigodoñe am-po’e ao. Selà","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mijadoñe ty troko ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"eka, gañe ty troko;","poem":1},{"lineBreak":true},{"text":"hisabo iraho, eka hisabo fandrengeañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mivañona, ry engeko!","poem":1},{"lineBreak":true},{"text":"Mitroara ry kararàke naho marovany,","poem":1},{"lineBreak":true},{"text":"hampitsekafako ty fanjirik’andro!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hañandriañe Azo iraho ry Talè","poem":1},{"lineBreak":true},{"text":"añivo’ ondatio eo,","poem":1},{"lineBreak":true},{"text":"ho rengeko an-tsabo","poem":1},{"lineBreak":true},{"text":"amo kilakila‘ndatio ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amy te ra’elahy pak’ an-dindiñe añe","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’o;","poem":1},{"lineBreak":true},{"text":"le pak’an-drahoñe eñe ty hatò’o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onjoneñe ambonen-dikerañ’eñe irehe","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ty enge’o ambone’ ty tane bey toy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}