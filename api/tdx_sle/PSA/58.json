{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":58,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide ami’ty feo : Ko Rotsahe’o"]},{"type":"verse","number":1,"content":[{"text":"Toe mitaron-kavantañañe","poem":1},{"lineBreak":true},{"text":"hao t’ie mitsiñe?","poem":1},{"lineBreak":true},{"text":"mizaka an-kahiti’e hao, ry ana’ ondatio?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hete, te mone hatsivokarañe","poem":1},{"lineBreak":true},{"text":"ty itoloña’areo an-troke ao;","poem":1},{"lineBreak":true},{"text":"lanjae’ areo amy taney","poem":1},{"lineBreak":true},{"text":"o fitavanam-pità’areoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amoean-kovin-drene’e ty lo-tsereke,","poem":1},{"lineBreak":true},{"text":"mañariok’ añe vata’e miboloañe","poem":1},{"lineBreak":true},{"text":"ty mpivolam-bande.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hoe vorem-pandrefe’ala ty vore’ iareo,","poem":1},{"lineBreak":true},{"text":"manahake o meren-kareñeñe","poem":1},{"lineBreak":true},{"text":"manentsen-tsofiñeo,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"tsy hahatsanoña’e ty fikoràn’ambiasa","poem":1},{"lineBreak":true},{"text":"ndra ty pandrombo-jiny bey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"rofoto am-bava’e ao o nife’eo,","poem":1},{"lineBreak":true},{"text":"atrankaño ty famotsi’ o liona tora’eo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Angao hisaok’ añe iereo hoe rano vohitse;","poem":1},{"lineBreak":true},{"text":"Lonik’abey te ho zoeñe","poem":1},{"lineBreak":true},{"text":"domoke o ama-paleo","poem":1},{"lineBreak":true},{"text":"t’ie mañohatse o fale’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lonike t’ie hanahake ty harevo’","poem":1},{"lineBreak":true},{"text":"o sifotse mihamodo te misitseo, hoe ajaja miboloañe tsy mahatrea i àndroy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aolo te hahamae valàñe o afom-patikeo,","poem":1},{"lineBreak":true},{"text":"le fonga ho faohe’e an-talìo","poem":1},{"lineBreak":true},{"text":"ty leñe naho ty mibebañe,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hirebeke o vañoñeo","poem":1},{"lineBreak":true},{"text":"te mahaisake i famaleañey,","poem":1},{"lineBreak":true},{"text":"ho sasà’e an-dio’ o tsivokatseo o fandia’eo","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vaho hanao ty hoe ondatio:","poem":1},{"lineBreak":true},{"text":"Toe tsy ho po-tambe o vantañeo;","poem":1},{"lineBreak":true},{"text":"toe eo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"mizaka an-tane atoy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}