dilarakoo ty falisa’ iareo","poem":1},{"lineBreak":true},{"text":"hiatreatre ahy;","poem":1},{"lineBreak":true},{"text":"mivañona hañolora’o vaho mivazohoa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ihe arè ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ i màroy,","poem":1},{"lineBreak":true},{"text":"Andrianañahare Israele,","poem":1},{"lineBreak":true},{"text":"mivañona, handilova’o o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"ko tretrezeñe o mpiola lo-tserekeo. Selà","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mibalike haleñe iereo,","poem":1},{"lineBreak":true},{"text":"mañaolo hoe amboa","poem":1},{"lineBreak":true},{"text":"vaho mikariokariok’ amy rovay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hehe t’ie mamore am-bava,","poem":1},{"lineBreak":true},{"text":"fibara ty an-tsoñi’e, manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Ia ty mahajanjiñe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"F’ihe, ry Iehovà, ro hiankahak’ am’iareo, hene sirikae’o o fifeheañeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O ry Haozarako, fitamakoo;","poem":1},{"lineBreak":true},{"text":"kijoli-aboko t’i Andrianañahare.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hiaolo ahy t’i Andrianañaharem-piferenaiñ’ ahiko,","poem":1},{"lineBreak":true},{"text":"hampisamban’ Añahare o rafelahikoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ko vonoe’o hey iereo,","poem":1},{"lineBreak":true},{"text":"tsy mone haliño ondatikoo;","poem":1},{"lineBreak":true},{"text":"ampirererereo ami’ty haozara’o,","poem":1},{"lineBreak":true},{"text":"vaho afotsaho, ry Talè, fikala’ay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ty amo hakeom-palie’ iareoo,","poem":1},{"lineBreak":true},{"text":"o saontsim-pivimbi’eo, ee t’ie ho tsepaheñe am-pirengevoha’e, naho amo fatse vaho fandañitse aaka’ iareoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mongoro an-kaviñerañe,","poem":1},{"lineBreak":true},{"text":"zamano ho modo,","poem":1},{"lineBreak":true},{"text":"hampandrendrehañe te mifehe","poem":1},{"lineBreak":true},{"text":"am’ Iakobe ao t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"sikala añ’olo’ ty tane toy añe, Selà","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mimpoly haleñe iereo,","poem":1},{"lineBreak":true},{"text":"mañaolo hoe amboa,","poem":1},{"lineBreak":true},{"text":"vaho mbeo-mbeo an-drova atoy,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mihelahela avao, mipay haneñe,","poem":1},{"lineBreak":true},{"text":"vaho mitromoroñe naho tsy vontsy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa naho izaho, ho saboeko ty haozara’o; Eka, hipoñafako te maraiñe","poem":1},{"lineBreak":true},{"text":"ty amy fiferenaiña’oy;","poem":1},{"lineBreak":true},{"text":"amy te Ihe ro tambohoko,","poem":1},{"lineBreak":true},{"text":"fitsolohako añ’andron-kaloviloviako.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ry Haozarako,","poem":1},{"lineBreak":true},{"text":"hisaboako am-pandrengeañe:","poem":1},{"lineBreak":true},{"text":"amy te mpikalañ’ ahy t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"i Andrianañaharem-piferenaiñ’ ahiy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}