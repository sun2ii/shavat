{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":6,"content":[{"type":"heading","content":["Ho a i Talèn-tsakeray ampititiheñe, Titiheñe an-Tali-valo; Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, ko endaha’o ami’ty haviñera’o,","poem":1},{"lineBreak":true},{"text":"le ko mandilo ahy an-keloke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tretrezo, ry Iehovà, fa minike;","poem":1},{"lineBreak":true},{"text":"jangano ry Iehovà","poem":1},{"lineBreak":true},{"text":"fa minevenevetse o taolakoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Loho mangebahebake ty troko:","poem":1},{"lineBreak":true},{"text":"Fa Ihe ry Iehovà—hombia?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mibaliha, ry Iehovà, Hahao ty fiaiko;","poem":1},{"lineBreak":true},{"text":"rombaho ty amy fiferenaiña’o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy mahatiahy Azo ty an-kavilasy;","poem":1},{"lineBreak":true},{"text":"ia ty hañandriañ’ Azo an-tsikeokeok’ ao?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mahamàmak’ ahy ty fiñeoñeoko;","poem":1},{"lineBreak":true},{"text":"ampigoribagoribañeko haleñe","poem":1},{"lineBreak":true},{"text":"ty kidoriko,","poem":1},{"lineBreak":true},{"text":"ampitranaheko rano maso","poem":1},{"lineBreak":true},{"text":"ty fandreako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mitike o masokoo ami’ty haemberako;","poem":1},{"lineBreak":true},{"text":"mihamodo ty amo rafelahy iabio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Soike ry hene mpanao ratio;","poem":1},{"lineBreak":true},{"text":"fa nahajanjiñe ty feon-tañiko t’Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jinanji’ Iehovà ty halaliko;","poem":1},{"lineBreak":true},{"text":"no’ Iehovà ty filolofako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fonga ho salatse naho hangebahebake","poem":1},{"lineBreak":true},{"text":"o rafelahikoo;","poem":1},{"lineBreak":true},{"text":"Ampipolieñe iereo,","poem":1},{"lineBreak":true},{"text":"vaho hiambovoa’ ty fimeñarañe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}