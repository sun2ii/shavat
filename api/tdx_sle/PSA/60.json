{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":60,"content":[{"type":"heading","content":["Ho a i Talè, Onin-tsabo’ i Davide ty hotakotake nanoe’e amy Arame Naharaime naho i Arame Tsobay; naho ty nibaliha’ Ioabe, ie ginio’e t’i nte-Edome rai-ale tsy roe-arivo lahy amy Vavatanen-tsiray."]},{"type":"verse","number":1,"content":[{"text":"Ry Andrianañahare nifarie’o, dinemo’o, nifomboa’o; ehe sotraho zahay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nampiezeñezeñe’o ty tane;","poem":1},{"lineBreak":true},{"text":"nabenta’o; melaño o jeba’eo, fa miozoñozoñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nampahaoniña’o ­fisotriañe ondati’oo; nampitohofa’o divay mampivembèñe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nanolora’o viloñe","poem":1},{"lineBreak":true},{"text":"o mañeveñe ama’oo;","poem":1},{"lineBreak":true},{"text":"honjoneñe ty ami’ty hatò. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Soa te ho hahàñe o kokoa’oo;","poem":1},{"lineBreak":true},{"text":"rombaho am-pità’o havana; toiño iraho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nitsara ami’ty hamasiña’e","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare:","poem":1},{"lineBreak":true},{"text":"Hitreñe iraho, ho zaraeko ty Sekeme,","poem":1},{"lineBreak":true},{"text":"vaho ho zeheko ty vavatane’ i Sokote;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ahiko t’i Gilàde, naho ahiko t’i Menasè; fiaron-dohako t’i Efraime,","poem":1},{"lineBreak":true},{"text":"kobaiko t’Iehodà","poem":1},{"noteId":25},{"text":";","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Koveta fisasako t’i Mòabe;","poem":1},{"lineBreak":true},{"text":"fampipohan-kanako t’i Edome","poem":1},{"lineBreak":true},{"text":"miroharohà ty amako, ry Pilisty.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ia ty hampihova ahy","poem":1},{"lineBreak":true},{"text":"amy rova fatratsey?","poem":1},{"lineBreak":true},{"text":"Ia ty hiaolo ahy mb’ Edome mb’eo?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy Ihe hao ry Andrianañahare","poem":1},{"lineBreak":true},{"text":"ty nahafary anay?","poem":1},{"lineBreak":true},{"text":"Tsy hitraofa’o fionjonañe hao,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare o lahindefo’aio !","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Oloro amy rafelahiy zahay,","poem":1},{"lineBreak":true},{"text":"fa tsy vente’e ty fandrombaha’ ondatio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro fahareketa’ay,","poem":1},{"lineBreak":true},{"text":"Ie ty handialia o rafelahi’aio.","poem":1}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Fot 49:10","reference":{"chapter":60,"verse":7}}]},"thisChapterLink":"/api/tdx_sle/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}