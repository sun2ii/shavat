{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":61,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide, arahe’ ty marotaly"]},{"type":"verse","number":1,"content":[{"text":"Janjiño ty koiko, ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"haoño o halalikoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Boak’ añ’olon-tane añe ty ikoihako Azo, naho opo ty troko;","poem":1},{"lineBreak":true},{"text":"iaolò mb’an-­damilamy abo te amako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amy te Ihe ro fipalirako,","poem":1},{"lineBreak":true},{"text":"haboañe fatratse aolon-drafelahiko eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hitoboke an-kivoho’o ao nainai’e iraho;","poem":1},{"lineBreak":true},{"text":"hipalirako añ’alo’ o ela’oo. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa jinanji’o o nifantàkoo","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"tinolo’o ty lova’ o mpañeveñe","poem":1},{"lineBreak":true},{"text":"amy tahina’oio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tompeo andro ty andro’ i mpanjakay,","poem":1},{"lineBreak":true},{"text":"ho tarirats’ an-tariratse o tao’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hiambesatse añatrefan’ Añahare","poem":1},{"lineBreak":true},{"text":"eo nainai’e;","poem":1},{"lineBreak":true},{"text":"afantoho hañambeñe aze","poem":1},{"lineBreak":true},{"text":"ty fiferenaiñañe naho ty hatò.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le ho bangoeko an-tsabo nainai’e ty tahina’o,","poem":1},{"lineBreak":true},{"text":"ie henefeko boak’ andro o nifantàkoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}