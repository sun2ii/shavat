ineBreak":true},{"text":"haabo’e avao ro fikililia’ iareo :","poem":1},{"lineBreak":true},{"text":"mpitea volam-bande; mitata am-palie,","poem":1},{"lineBreak":true},{"text":"f’ie mamatse añ’ova ao Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I Andrianañahare avao ty liñisa’o","poem":1},{"lineBreak":true},{"text":"ampitsiñañe, ty fiaiko toy;","poem":1},{"lineBreak":true},{"text":"boak’ ama’e ty fisalalàko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie avao ro lamilamiko","poem":1},{"lineBreak":true},{"text":"naho fandrombahañe ahy;","poem":1},{"lineBreak":true},{"text":"ty kijoliko abo; tsy hasiotse iraho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I Andrianañahare ty ampipohañe","poem":1},{"lineBreak":true},{"text":"ty fandrombahañe ahy,","poem":1},{"lineBreak":true},{"text":"naho ty engeko;","poem":1},{"lineBreak":true},{"text":"ty lamilamin-kaozarako;","poem":1},{"lineBreak":true},{"text":"fipalirako t’i Andrianañahare.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miatoa ama’e nainai’e, ondatio,","poem":1},{"lineBreak":true},{"text":"adoaño añatrefa’e ty arofo’ areo;","poem":1},{"lineBreak":true},{"text":"fitsolohan-tika t’i Andrianañahare. Selà","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toe hakoahañe avao o ana’ i Dameo,","poem":1},{"lineBreak":true},{"text":"lañitse o ana’ ondatio;","poem":1},{"lineBreak":true},{"text":"ie atraok’ am-pilanjàñe eo,","poem":1},{"lineBreak":true},{"text":"le maivañe te ami’ty kofòke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ko iatoa’o ty fikatramoañe,","poem":1},{"lineBreak":true},{"text":"naho ko manao fañirian-kafoake","poem":1},{"lineBreak":true},{"text":"am-pikamerañe.","poem":1},{"lineBreak":true},{"text":"Ndra te mionjoñe o varao","poem":1},{"lineBreak":true},{"text":"ko ampirampian’ arofo.","poem":1}]},{"typ