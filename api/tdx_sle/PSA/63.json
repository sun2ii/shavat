neBreak":true},{"text":"Hañandriañe Azo t’ie mbe veloñe;","poem":1},{"lineBreak":true},{"text":"i tahina’oy ty hañonjonako tañañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anjañe ty fiaiko hoe aman-tso-kena naho solike,","poem":1},{"lineBreak":true},{"text":"vaho mandrenge Azo","poem":1},{"lineBreak":true},{"text":"an-tsoñy mifale ty vavako,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ie mahatiahy Azo am-pandreañe ao,","poem":1},{"lineBreak":true},{"text":"naho mitsakore Azo am-pijilovan-kaleñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ihe ro mpañolotse ahiko,","poem":1},{"lineBreak":true},{"text":"naho an-kalon’ela’o ao ty hirebehako.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mipitek’ ama’o ty fiaiko;","poem":1},{"lineBreak":true},{"text":"manohañe ahy ty fità’o havana.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fe hajoroboñe an-tsikeokeok’ao","poem":1},{"lineBreak":true},{"text":"ze mipay handrotsake ty fiaiko;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Havariñe an-kaozara’ i fibaray iereo","poem":1},{"lineBreak":true},{"text":"ho tsindrohe’ ty farasy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Andriañahare ty irebeha’ i Mpanjakay,","poem":1},{"lineBreak":true},{"text":"mirañorañoa ze hene mifanta ama’e;","poem":1},{"lineBreak":true},{"text":"fe hampidiñeñe ty faliem-pandañitse.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}