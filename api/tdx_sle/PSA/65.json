{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":65,"content":[{"type":"heading","content":["Ho a i Talè; Takasy, Sabo’ i Davide."]},{"type":"verse","number":1,"content":[{"text":"Mitamà azo e Tsiône ao ty sabo,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare:","poem":1},{"lineBreak":true},{"text":"vaho ama’o ty ifantàñe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O ry Mpijanjin-kalaly,","poem":1},{"lineBreak":true},{"text":"mitontoñe ama’o ze kila sandriñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maozatse te amako o sata tsi-vokatseo,","poem":1},{"lineBreak":true},{"text":"f’ie ty hanao fijebañañe ho amo fandilara’aio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Haha t’indaty joboñe’o","poem":1},{"lineBreak":true},{"text":"vaho ampitotohe’o","poem":1},{"lineBreak":true},{"text":"himoneñe an-kiririsa’o ao:","poem":1},{"lineBreak":true},{"text":"ho heneke ty hasoa añ’akiba’o ao zahay,","poem":1},{"lineBreak":true},{"text":"an-kivoho’o miavake ao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fitoloñañe mampañeveñe","poem":1},{"lineBreak":true},{"text":"ro anoiña’o anay an-kavantañañe,","poem":1},{"lineBreak":true},{"text":"ry Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahañe anay,","poem":1},{"lineBreak":true},{"text":"Ihe ro fatokisa’ ze olon-tane iaby,","poem":1},{"lineBreak":true},{"text":"naho o an-driake tsietoitaneo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie ami’ty haozara’o ro nampijadoñe","poem":1},{"lineBreak":true},{"text":"o vohitse misadia hafatrarañeo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ihe ro mampitsiñe ty fitroña’ o riakeo, ty figodobo’ o kinerakeo,","poem":1},{"lineBreak":true},{"text":"vaho ty fivoamboaña’ o borizañeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mampañeveñe o mpimoneñe añ’olon-taneo o vilo’oo; vaho ampirebehe’o","poem":1},{"lineBreak":true},{"text":"ty fionjona’ o maraiñeo naho o haleñeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tilihe’o ty tane toy","poem":1},{"lineBreak":true},{"text":"naho tondraha’o rano:","poem":1},{"lineBreak":true},{"text":"vaho fanjàka ty nampamokara’o aze","poem":1},{"lineBreak":true},{"text":"amy sakan’Añahare miheneheney;","poem":1},{"lineBreak":true},{"text":"nañalankaña’o","poem":1},{"noteId":26},{"text":"ampemba,","poem":1},{"lineBreak":true},{"text":"izay ty fañajaria’o i taney.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Anoe’o lonte soa o hàto’eo, amàta’o o vavahali’eo:","poem":1},{"lineBreak":true},{"text":"lotrahe’o ami’ty ereke,","poem":1},{"lineBreak":true},{"text":"tahie’o ty fitovoa’e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sabakae’o ami’ty havokara’o ty taoñe,","poem":1},{"lineBreak":true},{"text":"ampitsopatsopahen-tsolike o oloñolo’oo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mitsiritsioke o fiandrazañe","poem":1},{"lineBreak":true},{"text":"am-patrambeio;","poem":1},{"lineBreak":true},{"text":"vaho misikim-pirebehañe o vohitseo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Misaroñe biby fiandrazeñe o hivokeo,","poem":1},{"lineBreak":true},{"text":"miravak’ ampemba o vavataneo;","poem":1},{"lineBreak":true},{"text":"mitreñe an-kaehake le misabo.","poem":1}]}],"footnotes":[{"noteId":26,"caller":"+","text":"Ndra ze atao vare, tsako, bajiry n. t. i.","reference":{"chapter":65,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}