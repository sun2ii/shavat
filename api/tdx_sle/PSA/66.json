{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":66,"content":[{"type":"heading","content":["Ho a i Talè, Sabo an-Titike, Takasy"]},{"type":"verse","number":1,"content":[{"text":"Mipoñafa rebek’ aman’","poem":1},{"lineBreak":true},{"text":"Andrianañahare, ry hene tane toy !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isabò ty volonahe’ i Tahina’ey,","poem":1},{"lineBreak":true},{"text":"toloro engeñe mitoabotse.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anò ty hoe aman’ Añahare : Ra’elahy o tolon-draha’oo !","poem":1},{"lineBreak":true},{"text":"Ami’ty hajabahinan-kaozara’o ty hitsolofìña’ o rafelahi’oo aolo’o eo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hene hitalaho ama’o ty tane toy,","poem":1},{"lineBreak":true},{"text":"naho hisabo fandrengeañe ama’o;","poem":1},{"lineBreak":true},{"text":"ho bangoe’ iereo ty tahina’o. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Antao hañisake o fitoloñan’Añahareo:","poem":1},{"lineBreak":true},{"text":"mampañeveñe o ana’ondatio o sata’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nabali’e ho tane kànkañe i riakey,","poem":1},{"lineBreak":true},{"text":"nitsaham-pandia’ iareo i oñey;","poem":1},{"lineBreak":true},{"text":"añe ty nirebehan-tika.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manjaka an-kaozara’e nainai’e re,","poem":1},{"lineBreak":true},{"text":"jilovem-pihaino’e o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"we te tsy hiroharoha’ o mpiolao. Selà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Andriaño t’i Andrianañaharen-tika","poem":1},{"lineBreak":true},{"text":"ry ondatio,","poem":1},{"lineBreak":true},{"text":"ipoñafo feom-pandrengeañe;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie mitañe an-tika veloñe, naho","poem":1},{"lineBreak":true},{"text":"tsy apo’e hasitse o fandian-tikañeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa namente anay irehe,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare, fa natrana’o hoe fitranaham-bolafoty.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nasese’o an-karato ao, vaho nampibabe’o faloviloviañe","poem":1},{"lineBreak":true},{"text":"o hàto’aio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nampiningire’o ambone’ ty","poem":1},{"lineBreak":true},{"text":"añambone’ay t’indaty,","poem":1},{"lineBreak":true},{"text":"zahay nisibek’ afo naho rano,","poem":1},{"lineBreak":true},{"text":"fe naaka’o ho an-kavokarañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Himoak’ añ’anjomba’o ao raho","poem":1},{"lineBreak":true},{"text":"hinday engan-koroañe;","poem":1},{"lineBreak":true},{"text":"hañenefako o nifantàkoo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ze vinolan-tsoñiko vaho rineham-bavako t’ie niankoheke.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hengaeko kobatroke horañe, an-katòen’ añondri-lahy,","poem":1},{"lineBreak":true},{"text":"hisoroñe bania naho oselahy. Selà","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mb’etoa hijanjiñe ry mpañeveñe","poem":1},{"lineBreak":true},{"text":"aman’ Añahare iabio,","poem":1},{"lineBreak":true},{"text":"le ho talilieko o nanoe’e an-kavelokoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nitoreo am-bavako,","poem":1},{"lineBreak":true},{"text":"le nampionjoneko an-delako.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie mahatrea hakeo an-troko ato,","poem":1},{"lineBreak":true},{"text":"le tsy hijanjiña’ i Talè.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fa toe mijanjiñe ahy","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"haoñe’e i feon-kalalikoy.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Andriañeñe t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"amy te tsy ambohoa’e i filolofakoy,","poem":1},{"lineBreak":true},{"text":"vaho tsy afaha’e amako","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}