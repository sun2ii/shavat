,"poem":1},{"lineBreak":true},{"text":"an-tane atoio. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho renge’ ondatio irehe","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"fonga handrenge Azo ondatio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa nahatoly sabo ty tane, nitahy antika t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"i Andrianañaharen-tikañey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tahien’ Añahare tikañe; soa te hañeveñe ama’e ze hene olon-tane.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}