true},{"text":"Misaboa aman’ Añahare,","poem":1},{"lineBreak":true},{"text":"bangò i tahina’ey;","poem":1},{"lineBreak":true},{"text":"onjono i Mpiningitse miranga","poem":1},{"lineBreak":true},{"text":"i montombeiy, Ià ty tahina’e;","poem":1},{"lineBreak":true},{"text":"vaho mitreñà añatrefa’e eo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Raem-bode-rae naho mpañomey to","poem":1},{"lineBreak":true},{"text":"amo vantotseo t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"an-kivoho’e miavake ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ampimoneñan’ Añahare","poem":1},{"lineBreak":true},{"text":"añ’akiba ao ty jorý;","poem":1},{"lineBreak":true},{"text":"akare’e mb’an-kavokarañe o rinohio;","poem":1},{"lineBreak":true},{"text":"fe mitobok’ an-tane kirikintàñe ao","poem":1},{"lineBreak":true},{"text":"o mpitrabikeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Andrianañahare, ie niaoloa’o ondati’oo, ie nihofiha’o firanga","poem":1},{"lineBreak":true},{"text":"i fatram-beiy, Selà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"niezeñezeñe i taney, nihotrake i likerañey aolo’ i Andrianamboatse,","poem":1},{"lineBreak":true},{"text":"Nihondrahondra ty Sinay añatrefa’ i Abo Tia, Andrianañahare’ Israele eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanondraha’o oran-joba,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"niventè’o i lova’o navozoy,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nitobok’ ao i mpirai-lia’oy,","poem":1},{"lineBreak":true},{"text":"nifahana’o ami’ty havokara’o","poem":1},{"lineBreak":true},{"text":"o rarakeo, ry Andrianamboatse.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nitaroñe t’i Talè;","poem":1},{"lineBreak":true},{"text":"mitozantoza o rakemba mitalily","poem":1},{"lineBreak":true},{"text":"i entañeio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nitriban-day mb’eo o mpanjakan-","poem":1},{"lineBreak":true},{"text":"dahindefoñeo! Nivoratsake;","poem":1},{"lineBreak":true},{"text":"le ho zarae’ i tambatse an-kiboho’e ao o kinopakeo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ie mandre am-bàlan’añondry ao, le manahake","poem":1},{"lineBreak":true},{"text":"ty elan-deho misarom-bola-foty;","poem":1},{"lineBreak":true},{"text":"mimilemiletse volamena o volo’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie nampivarakai’ i El-Sadai","poem":1},{"lineBreak":true},{"text":"i mpanjaka rey,","poem":1},{"lineBreak":true},{"text":"le niavy an-Tsalmone ty oram-panala.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Vohin’ Añahare ty vohy Basane;","poem":1},{"lineBreak":true},{"text":"vohitse lako-lengo’e ty haboa’ i Basane;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Inoñe ty ikiraña’ areo","poem":1},{"lineBreak":true},{"text":"ry haboañe maro-lengo’eo,","poem":1},{"lineBreak":true},{"text":"i vohitse nirien’Añahare himoneña’ey?","poem":1},{"lineBreak":true},{"text":"Eka himoneñe ao nainai’e t’Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Añ’ale’ale o sareten’ Añahareo,","poem":1},{"lineBreak":true},{"text":"arivo-añ’arivo’e;","poem":1},{"lineBreak":true},{"text":"ama’e ao an-kamasiña’e t’i Talè","poem":1},{"lineBreak":true},{"text":"manahake e Sinay añe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nionjoñe añ’abo eñe irehe,","poem":1},{"lineBreak":true},{"text":"nikozozote’o an-drohy","poem":1},{"lineBreak":true},{"text":"o fandrohizañeo,","poem":1},{"lineBreak":true},{"text":"nandrambe ravoravo am’ondatio,","poem":1},{"lineBreak":true},{"text":"vaho amo mpiolao,","poem":1},{"lineBreak":true},{"text":"himoneña’ Ià, Andrianañahare.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Andriañeñe t’i Talè mpivave o kilankan-tikañeo boak’andro,","poem":1},{"lineBreak":true},{"text":"i Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahantikañey. Selà","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Andrianañaharem-pañaha an-tika","poem":1},{"lineBreak":true},{"text":"t’i Andrianamboatse;","poem":1},{"lineBreak":true},{"text":"Toe a Iehovà Talè","poem":1},{"lineBreak":true},{"text":"ty famotsorañe an-kavilasy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Le hanorotoro ty loha’ o rafelahi’eo","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ty kovo-doha minankanankañe","poem":1},{"lineBreak":true},{"text":"amo hakeo’eo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Hoe t’i Talè:","poem":1},{"lineBreak":true},{"text":"Hampoliko o e Basaneo,","poem":1},{"lineBreak":true},{"text":"hahereko boak’ an-keraheran-driak’ ao,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho demohem-pandia’o an-dio","poem":1},{"lineBreak":true},{"text":"o rafelahi’oo,","poem":1},{"lineBreak":true},{"text":"hanañ’anjara an-dion-drafilahy ka","poem":1},{"lineBreak":true},{"text":"o lelan’ amboa’oo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Fa niisa’ iareo o fañaveloa’oo","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ty fionjonan’ Añahareko, toe","poem":1},{"lineBreak":true},{"text":"i Mpanjakakoy, mb’amy miavakey ao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Miaolo o mpisaboo,","poem":1},{"lineBreak":true},{"text":"manonjohy o mpititikeo;","poem":1},{"lineBreak":true},{"text":"añivo’e ao o somondrara","poem":1},{"lineBreak":true},{"text":"mampikantsankantsàñe o kantsàñeo :","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Andriaño am-pivory ao","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"i Iehovà boak’am-pigoa­ngoaña’ Israele.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ingo t’i Beniamine tsitso’e,","poem":1},{"lineBreak":true},{"text":"miaolo iareo,","poem":1},{"lineBreak":true},{"text":"o roandria’ Iehodào am-pirimboña’eo, o roandria’ i Zeboloneo,","poem":1},{"lineBreak":true},{"text":"o roandria’ i Naftalio.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fa linilin’ Añahare’o ty haozara’o;","poem":1},{"lineBreak":true},{"text":"mihaozara! Ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"nañenefa’o ho anay izay,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ty kiboho’o e Ierosalaime añe,","poem":1},{"lineBreak":true},{"text":"ty ibanabanà’ o mpanjakao ama’oy.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Endaho o biby hako am-bindao,","poem":1},{"lineBreak":true},{"text":"o añombelahy maroo","poem":1},{"lineBreak":true},{"text":"rekets’ o dronga’ ondatioo,","poem":1},{"lineBreak":true},{"text":"songa mandialia tseram-bolafoty; navarakai’e ondaty tea alio.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Hiavotse e Mitsraime ao o sorotà’eo,","poem":1},{"lineBreak":true},{"text":"halisa hañity fitàñe aman’Añahare","poem":1},{"lineBreak":true},{"text":"t’i Kose","poem":1},{"noteId":27},{"text":".","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Misaboa aman’Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ry fifehea’ ty tane toio;","poem":1},{"lineBreak":true},{"text":"rengeo an-tsabo t’i Talè; Selà","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"I mining