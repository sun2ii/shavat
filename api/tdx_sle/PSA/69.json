{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":69,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide ami’ty feo : O Talìfokeo."]},{"type":"verse","number":1,"content":[{"text":"Rombaho iraho ry Andrianañahare","poem":1},{"lineBreak":true},{"text":"fa nizilike añ’ovako ao ty rano.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Milempotse an-­ditsake lalek’ ao iraho,","poem":1},{"lineBreak":true},{"text":"tsy ao ty ho liàñe;","poem":1},{"lineBreak":true},{"text":"fa nijolofoñe an-drano lalek’ ao","poem":1},{"lineBreak":true},{"text":"naho mandipotse ahy o alon-driakeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mahamokotse ahy ty fitañiako,","poem":1},{"lineBreak":true},{"text":"maike ty am-peoko ao;","poem":1},{"lineBreak":true},{"text":"milesa o masokoo amy fisalalako","poem":1},{"lineBreak":true},{"text":"an’Andrianañaharekoy.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mandikoatse o volon-dohakoo","poem":1},{"lineBreak":true},{"text":"ty malaiñe ahy tsy am-bente’e;","poem":1},{"lineBreak":true},{"text":"maro ty te handrotsak’ ahiko,","poem":1},{"lineBreak":true},{"text":"ie rafelahiko tsy an-dengo’e;","poem":1},{"lineBreak":true},{"text":"havahako hao ty tsy nikamereko?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O Andrianañahare, arofoana’o","poem":1},{"lineBreak":true},{"text":"ty hadagolako,","poem":1},{"lineBreak":true},{"text":"vaho tsy mietak’ ama’o o tahikoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy izaho abey ty hisalara’","poem":1},{"lineBreak":true},{"text":"o misalala Azoo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, Talè’ i Màroy;","poem":1},{"lineBreak":true},{"text":"ee te tsy izaho ty himeñara’","poem":1},{"lineBreak":true},{"text":"o mipay Azoo,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare’ Israeleo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amy te Ihe ro nahatantezako rabioñe;","poem":1},{"lineBreak":true},{"text":"manaroñe ty tareheko ty hasalarañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa ambahiny aman-drolongoko","poem":1},{"lineBreak":true},{"text":"iraho naho alik’ amo anan-drenekoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amy te namotsek’ ahiko","poem":1},{"lineBreak":true},{"text":"ty fahimbañako amy anjomba’oy;","poem":1},{"lineBreak":true},{"text":"le nidoñe amako ty inje’","poem":1},{"lineBreak":true},{"text":"o mañinje Azoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Izaho nitañy añ’ovako ao","poem":1},{"lineBreak":true},{"text":"naho nililitse, ninjare tiñe amako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ie nanoeko lamba-gony ty sikiko, le nirabioñeñe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mivolambolañe ahy o miambesatse an-dalambeio;","poem":1},{"lineBreak":true},{"text":"vaho ibekoa’ o jikeo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa naho izaho, Ihe ty ihalaliako,","poem":1},{"lineBreak":true},{"text":"ry Iehovà, ami’ty andro mete,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare ami’ty habeim-piferenaiña’o, toiño raho","poem":1},{"lineBreak":true},{"text":"ami’ty hatòm-pandrombaha’o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ihahao amo litsakeo,","poem":1},{"lineBreak":true},{"text":"le ko apo’o hijoroboñe,","poem":1},{"lineBreak":true},{"text":"avotsoro amo malaiñe ahio,","poem":1},{"lineBreak":true},{"text":"vaho amo rano lalekeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ee t’ie tsy hopoe’ o fisorotombahañeo,","poem":1},{"lineBreak":true},{"text":"ndra hagodra’ i tsikeokeokey;","poem":1},{"lineBreak":true},{"text":"ndra hitsiteha’ ty vava’ i koboñey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Toiño iraho ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ami’ty hasoan-kafatraram-pikokoa’o;","poem":1},{"lineBreak":true},{"text":"mitoliha amako ami’ty","poem":1},{"lineBreak":true},{"text":"harà’elahim-piferenaiña’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ko aetak’ ami’ty mpitoro’o","poem":1},{"lineBreak":true},{"text":"ty lahara’o, fa ampoheke,","poem":1},{"lineBreak":true},{"text":"masikà te manoiñe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Harineo ty fiaiko, vaho jebaño;","poem":1},{"lineBreak":true},{"text":"vilio amo rafelahikoo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Arofoana’o ty tìñeko, ty hameñarako, naho ty hasalarako;","poem":1},{"lineBreak":true},{"text":"añatrefa’o eo ze hene rafelahiko.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fa nahakoretse ty troko o rabioñeo,","poem":1},{"lineBreak":true},{"text":"lifon-kasiloke iraho;","poem":1},{"lineBreak":true},{"text":"nipay tretre, fa tsy nitendreke;","poem":1},{"lineBreak":true},{"text":"naho mpañohò, fa tsy nahatrea.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hete! finaha’ iareo voreke raho","poem":1},{"lineBreak":true},{"text":"vaho finantso’ iareo vinegra","poem":1},{"lineBreak":true},{"text":"amy haran-dranoakoy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho fàndrike ty fandam­bañañe añ’atrefa’ iareo;","poem":1},{"lineBreak":true},{"text":"ie mierañerañe te mikoropoke.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Haieñe o fihaino’ iareoo,","poem":1},{"lineBreak":true},{"text":"tsy hahaisake,","poem":1},{"lineBreak":true},{"text":"vaho ampiozoñozoño nainai’e o toha’eo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Adobaño am’ iereo ty haviñera’o,","poem":1},{"lineBreak":true},{"text":"le ampitsepaho ami’ty fifombo’o","poem":1},{"lineBreak":true},{"text":"miforoforo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hangoakoake ty tobe’ iareo;","poem":1},{"lineBreak":true},{"text":"tsy himoneña’ ondaty o kiboho’eo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Amy te sarerahe’e i linafa’oy,","poem":1},{"lineBreak":true},{"text":"vaho nindrae’ iereo ty fanaintaiña’","poem":1},{"lineBreak":true},{"text":"o vinonotrobo’oo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tompeo tahiñe ty hakeo’ iareo,","poem":1},{"lineBreak":true},{"text":"le ko apo’o hifoak’ an-kavantaña’o ao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Faoho amy boken-kaveloñey iereo,","poem":1},{"lineBreak":true},{"text":"tsy hitrao-pisokitse amo vañoñeo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Misotry naho marare iraho;","poem":1},{"lineBreak":true},{"text":"ampañonjono ahy añ’abo ey","poem":1},{"lineBreak":true},{"text":"ty fandrombaha’o, ry Andrianañahare.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ho bangoeko an-tsabo","poem":1},{"lineBreak":true},{"text":"ty tahinan’ Andrianañahare,","poem":1},{"lineBreak":true},{"text":"naho honjoneko am-pañandriañañe.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ie ho no’ Iehovà mandikoatse ty vosy valo-ay reke-tsifa naho hotro.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ho oni’ o mpirèkeo le ho ehake;","poem":1},{"lineBreak":true},{"text":"ry mpipay an’ Andrianañahare,","poem":1},{"lineBreak":true},{"text":"misotrafa añ’arofo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Fa mahajanjiñe o rarakeo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho tsy sirikae’e o an-drohio.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Misaboa Aze ry likerañeo naho","poem":1},{"lineBreak":true},{"text":"ty tane toy,","poem":1},{"lineBreak":true},{"text":"ry riakeo naho ze hene misorok’ ao.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Fa ho rombahen’Añahare ty Tsiône,","poem":1},{"lineBreak":true},{"text":"naho hamboare’e o rova’ Iehodào","poem":1},{"lineBreak":true},{"text":"vaho himoneñe ao iereo ho hanañañe.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ho lovae’ ty tiri’ o mpitoro’eo,","poem":1},{"lineBreak":true},{"text":"himoneña’ o mikoko i tahina’eio","poem":1},{"noteId":28},{"text":".","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Sab 5:11, 119:132, Ies 56:6","reference":{"chapter":69,"verse":36}}]},"thisChapterLink":"/api/tdx_sle/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}