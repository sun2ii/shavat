":"hera nivoloseko tsy amam-poto’e","poem":1},{"lineBreak":true},{"text":"ty nañembets’ ahy;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le ho hotrohe’ ty rafelahiko, hiambotraha’e;","poem":1},{"lineBreak":true},{"text":"ho lialià’e an-tane ty haveloko, vaho hado’e an-debok’ ao","poem":1},{"lineBreak":true},{"text":"ty engeko. Selà","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Miongaha, ry Iehovà, an-kaviñera’o,","poem":1},{"lineBreak":true},{"text":"miavota ty amo fitrotrofiaha’","poem":1},{"lineBreak":true},{"text":"o rafelahikoo.","poem":1},{"lineBreak":true},{"text":"mivañona ty amako amy zaka kinoi’oy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hiarikatok’ ama’o ty fivori’ ondatio,","poem":1},{"lineBreak":true},{"text":"vaho mibaliha hifehea’o","poem":1},{"lineBreak":true},{"text":"boak’añ’abo ey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà Mpizaka o kilakila ‘ndatio;","poem":1},{"lineBreak":true},{"text":"zakao iraho ry Iehovà, ty amy havantañako naho ty havañonako an-trok’ ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hijihetse ty haratia’ o lo-tserekeo","poem":1},{"lineBreak":true},{"text":"naho hajado’o o vañoñeo,","poem":1},{"lineBreak":true},{"text":"fa mpitsòke arofo naho ova","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare vantañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aman’Añahare ao ty fikalako","poem":1},{"lineBreak":true},{"text":"Ie mpandrombake o vañon-trokeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mpizaka to t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"Eka, torifike boak’ andro","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa naho tsy mimpoly t’indaty: le ho sioña’e i fibara’ey;","poem":1},{"lineBreak":true},{"text":"fa navoho’e ty fale’e","poem":1},{"lineBreak":true},{"text":"vaho nihajarie’e;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa nihentseñe’e fialiañe mahafate,","poem":1},{"lineBreak":true},{"text":"ampibelabelae’ afo o ana-pàle’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hehe t’ie tsongoen-tsihavokarañe,","poem":1},{"lineBreak":true},{"text":"ie nampiareñe kilily","poem":1},{"lineBreak":true},{"text":"vaho hiterake i remborake;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nihaly kobon-dre naho nampigorabahe’e,","poem":1},{"lineBreak":true},{"text":"vaho tafajorobo amy hinali’ey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Toe hibalik’ an-doha’e avao","poem":1},{"lineBreak":true},{"text":"ty fikitroha’e raty,","poem":1},{"lineBreak":true},{"text":"vaho hivotrak’ an-kevo’e eo","poem":1},{"lineBreak":true},{"text":"i nandovia’ey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Andriañeko t’Iehovà","poem":1},{"lineBreak":true},{"text":"ty amy havantaña’ey,","poem":1},{"lineBreak":true},{"text":"ho bangoeko an-tsabo ty tahina’","poem":1},{"lineBreak":true},{"text":"Iehovà Andindimoneñe.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}