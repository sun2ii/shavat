{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":70,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Davide Faniahiañe"]},{"type":"verse","number":1,"content":[{"text":"Hahao iraho ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"Malisà hañolots’ ahy ry Iehovà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ehe ampimeñaro naho vere­vereo o mipay ty fiaiko;","poem":1},{"lineBreak":true},{"text":"hampibalihe’e mb’eo, vaho ho salareñe o falefale amy faràrekoio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hampipoliañe an-kameñarañe","poem":1},{"lineBreak":true},{"text":"ze manao ty hoe: Hý! Hý!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ampirebehañe ze hene mipay Azo,","poem":1},{"lineBreak":true},{"text":"hifale ty ama’o;","poem":1},{"lineBreak":true},{"text":"le hitolom-panao ty hoe","poem":1},{"lineBreak":true},{"text":"o mpitea ty fandrombaha’oo:","poem":1},{"lineBreak":true},{"text":"Onjono t’i Andrianañahare.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe poie’e naho rarake iraho;","poem":1},{"lineBreak":true},{"text":"Malisà mb’amako ry Andrianañahare;","poem":1},{"lineBreak":true},{"text":"Ihe ro mpañolotse naho mpañaha ahy; taentaeno ry Iehovà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}