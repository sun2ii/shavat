{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Ihe ry Iehovà, ro itsolohako;","poem":1},{"lineBreak":true},{"text":"ko apo’o ho salareñe,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Votsoro ami’ty havantaña’o,","poem":1},{"lineBreak":true},{"text":"naho hahao;","poem":1},{"lineBreak":true},{"text":"atokilaño amako ty ravembia’o","poem":1},{"lineBreak":true},{"text":"vaho rombaho.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ehe t’ie ho vato fimoneñako,","poem":1},{"lineBreak":true},{"text":"ho fimpoliako;","poem":1},{"lineBreak":true},{"text":"fa nafanto’o ty handrombahañe ahiko;","poem":1},{"lineBreak":true},{"text":"Ihe ro lamilamiko naho rova fiàroko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avotsoro an-tañan-do-tsereke iraho,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahareko","poem":1},{"lineBreak":true},{"text":"ami’ty fivontitira’ ty mpandilatse","poem":1},{"lineBreak":true},{"text":"naho i mpampisoañey.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fa Ihe ro fitamàko, ry Iehovà Talè;","poem":1},{"lineBreak":true},{"text":"ty natokisako boak’ami’te nahajalahy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ihe ty nirampiako","poem":1},{"lineBreak":true},{"text":"boak’an-kovin-dreneko ao;","poem":1},{"lineBreak":true},{"text":"Ihe ty nañakatse ahy an-tron-dreneko;","poem":1},{"lineBreak":true},{"text":"Rengeko nainai’e irehe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Filatsà’ i màroy iraho,","poem":1},{"lineBreak":true},{"text":"f’Ihe ro fipalirako maozatse.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pea’ ty fibangoañe naho ty fiasiañ’Azo","poem":1},{"lineBreak":true},{"text":"lomoñandro ty vavako,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ko aitoa’o iraho naho fa bey;","poem":1},{"lineBreak":true},{"text":"ko mamorintseñe ahy naho","poem":1},{"lineBreak":true},{"text":"milesa ty haozarako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa nikinia’ o rafelahikoo;","poem":1},{"lineBreak":true},{"text":"vaho mitrao-pikilily ahy","poem":1},{"lineBreak":true},{"text":"o mivoñoñe ty fiaikoo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"naforintsen’ Añahare,","poem":1},{"lineBreak":true},{"text":"horidaño arè vaho tsepaho amy t’ie","poem":1},{"lineBreak":true},{"text":"po-pañolotse.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare, ko ihànkaña’o,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"malisà hañolots’ ahy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho salareñe naho mongoreñe","poem":1},{"lineBreak":true},{"text":"o manisý ty fiaikoo;","poem":1},{"lineBreak":true},{"text":"le hoboñañ’ inje naho hameñarañe","poem":1},{"lineBreak":true},{"text":"o mipay hijoy ahikoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fa naho izaho, hitama nainai’e","poem":1},{"lineBreak":true},{"text":"vaho honjoneko avao","poem":1},{"lineBreak":true},{"text":"ty fandrengeako Azo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho talilie’ ty vavako o havantaña’oo,","poem":1},{"lineBreak":true},{"text":"naho o fandrombaha’o lomoñandroo,","poem":1},{"lineBreak":true},{"text":"fe nofiko ty hamaro’e.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hindeseko o tolon-draha’o ra’elahio,","poem":1},{"lineBreak":true},{"text":"ry Iehovà Talè;","poem":1},{"lineBreak":true},{"text":"ho taroñeko ty havantaña’o, ty Azo avao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare, fa nanare’o ahy boak’ ami’ty nahajalahy ahy;","poem":1},{"lineBreak":true},{"text":"pake henaneo,","poem":1},{"lineBreak":true},{"text":"taroñeko avao o raha fanjaka fanoe’oo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa ndra t’ie bey naho fotivolo,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare, ko farie’o","poem":1},{"lineBreak":true},{"text":"ampara’ te ataliliko añ’afeafe","poem":1},{"lineBreak":true},{"text":"ty haozara’o;","poem":1},{"lineBreak":true},{"text":"ty hafatrara’o amy ze hene ho avy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pak’ andindiñe añe ty havantaña’o,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare.","poem":1},{"lineBreak":true},{"text":"Ihe namonitse o raha ra’elahio:","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ia ty mañirinkiriñe ama’o?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ihe nampahatrea ahiko","poem":1},{"lineBreak":true},{"text":"haemberañe maro naho hasotriañe;","poem":1},{"lineBreak":true},{"text":"ro hameloñ’ahy,","poem":1},{"lineBreak":true},{"text":"hañakatse naho hampipoly ahy","poem":1},{"lineBreak":true},{"text":"hirik’ an-kerakeran-tane ao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ehe, onjono ty engeko,","poem":1},{"lineBreak":true},{"text":"vaho mitoliha hañohò ahy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ho rengeko ami’ty mandalina ka,","poem":1},{"lineBreak":true},{"text":"ty ami’ty hatò’o, ry Andrianañahareko;","poem":1},{"lineBreak":true},{"text":"ho saboeko ami’ty marovany,","poem":1},{"lineBreak":true},{"text":"ry Masi-Toka’ Israele.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hipoñake an-drebeke o soñikoo,","poem":1},{"lineBreak":true},{"text":"ie mandrenge Azo an-tsabo,","poem":1},{"lineBreak":true},{"text":"naho i fiaiko jineba’oy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho talilie’ ty lelako lomoñandro","poem":1},{"lineBreak":true},{"text":"o havantaña’oo,","poem":1},{"lineBreak":true},{"text":"fa salatse, toe meñatse","poem":1},{"lineBreak":true},{"text":"o mipay hijoy ahikoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}