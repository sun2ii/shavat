{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":72,"content":[{"type":"heading","content":["A i Selomò"]},{"type":"verse","number":1,"content":[{"text":"Toloro amy mpanjakay ty fizakà’o, ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"vaho amy ana’ i mpanjakaiy ty havantaña’o,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hizaka’e an-kahiti’e ondati’oo,","poem":1},{"lineBreak":true},{"text":"o mpisotri’oo an-katò.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hinday fanintsiñañe","poem":1},{"lineBreak":true},{"text":"am’ ondatio o vohitseo,","poem":1},{"lineBreak":true},{"text":"naho havañonañe o haboañeo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ho mei’e to o rarake am’ondatioo,","poem":1},{"lineBreak":true},{"text":"ho rombahe’e ty ana’ o poi’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho demohe’e ty mpamorekeke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hañeveñe ama’o iereo","poem":1},{"lineBreak":true},{"text":"naho mbe ey i androy,","poem":1},{"lineBreak":true},{"text":"vaho mbe eñe i volañey,","poem":1},{"lineBreak":true},{"text":"amy ze hene tariratse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie hizotso manahake ty orañe","poem":1},{"lineBreak":true},{"text":"an-teteke vaho tinatake eo,","poem":1},{"lineBreak":true},{"text":"hoe ereke mampiboboke ty tane.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hiraorao amo andro’eo o vañoñeo:","poem":1},{"lineBreak":true},{"text":"vaho am-pierañerañañe vokatse","poem":1},{"lineBreak":true},{"text":"ampara’ te mimosaoñe i volañey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho fehè’e ty boak’ an-driake eñe,","poem":1},{"lineBreak":true},{"text":"pak’an-driak’ añe ka;","poem":1},{"lineBreak":true},{"text":"le boak’ amy sakay pak’amo olon-taneo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"hilokoloko ama’e o mpimoneñe","poem":1},{"lineBreak":true},{"text":"am-babangoañeo;","poem":1},{"lineBreak":true},{"text":"vaho hitsela lemboke o rafelahi’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Handroroñe ama’e o mpanjaka’","poem":1},{"lineBreak":true},{"text":"i Tarsiseo naho o tokonoseo;","poem":1},{"lineBreak":true},{"text":"hañenga ama’e o mpanjaka’ i Tsebà","poem":1},{"lineBreak":true},{"text":"naho i Sebào.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Eka, hibokokoa’ ze kila mpanjaka,","poem":1},{"lineBreak":true},{"text":"hene fifeheañe ro hitoroñe aze.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Himbae’e ty rarake te mitoreo,","poem":1},{"lineBreak":true},{"text":"naho i mpisotriy,","poem":1},{"lineBreak":true},{"text":"vaho i tsy amam-pañimbay.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hiferenaiña’e ty maifoifo naho o poi’eo, vaho ho rombahe’e","poem":1},{"lineBreak":true},{"text":"ty fiai’ o mavomavoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho jebañe’e ami’ty famorekekeañe","poem":1},{"lineBreak":true},{"text":"naho amo hasiahañeo ty fiai’iareo,","poem":1},{"lineBreak":true},{"text":"fa sarotse am-pivazohoa’e eo ty lio’ iareo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho velon-dre!","poem":1},{"lineBreak":true},{"text":"hatolotse aze ty volamena’ i Sebà; añonjono halaly ama’e nainai’e,","poem":1},{"lineBreak":true},{"text":"andriaño lomoñandro.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ho vokats’ ampemba i taney, an-dengon-kaboañe ey,","poem":1},{"lineBreak":true},{"text":"le hihelakelake hoe e Lebanone añe","poem":1},{"lineBreak":true},{"text":"o havokara’eo;","poem":1},{"lineBreak":true},{"text":"vaho handrevake hoe ty ahe’ i taney","poem":1},{"lineBreak":true},{"text":"o boak’an-drovao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tsy ho tampetse nainai’e ty tahina’e; tsy ho modo aolo’ i àndroy ty tahina’e;","poem":1},{"lineBreak":true},{"text":"vaho hifampitata ty ama’e ondatio,","poem":1},{"lineBreak":true},{"text":"ze kilakila ondaty hanao aze soa-tata.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Andriaño t’Iehovà Andrianamboatse,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"Ie avao ro manao raha tsitantane.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bangoeñe nainai’e i tahina’e","poem":1},{"lineBreak":true},{"text":"lifo-bolonahetsey;","poem":1},{"lineBreak":true},{"text":"mañàtseke ty tane toy ty enge’e.","poem":1},{"lineBreak":true},{"text":"Ie izay! naho Amena!","poem":1}]},{"type":"verse","number":20,"content":["Migadoñe eo ty ­filolofa’ i Davide, ana’ Iesae."]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}