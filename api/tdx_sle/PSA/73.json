,"poem":1},{"lineBreak":true},{"text":"mbore tsy tokoen-draha","poem":1},{"lineBreak":true},{"text":"manahake ondaty ila’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa le miravake fiebotseborañe","poem":1},{"lineBreak":true},{"text":"am-bozo’eo;","poem":1},{"lineBreak":true},{"text":"manaroñ’ iareo hoe sikiñe","poem":1},{"lineBreak":true},{"text":"o hasiahañe mandoviakeo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mampiboti­ritse o fihaino’eo ty solike,","poem":1},{"lineBreak":true},{"text":"etsake naho tampe-­draha-irieñe ty tro’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manivetive iereo, mikinia famorekekeañ’ an-karatiañe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa najado’ iareo hiatreatre o likerañeo","poem":1},{"lineBreak":true},{"text":"o falie’ iareoo,","poem":1},{"lineBreak":true},{"text":"mikariokariok’ an-tane atoy","poem":1},{"lineBreak":true},{"text":"o famele’ iareoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa le mimpoly atoy ondati’eo,","poem":1},{"lineBreak":true},{"text":"naho genohe’ iereo i rano era’ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hoe iereo :","poem":1},{"lineBreak":true},{"text":"Aia te haharofoanan’ Añahare?","poem":1},{"lineBreak":true},{"text":"mahilala hao i Andindimoneñey?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Inay ie, o lo-tserekeo—","poem":1},{"lineBreak":true},{"text":"ie mierañerañe manombo vara avao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Toe tsy vente’e ty nañalioveko ty troko;","poem":1},{"lineBreak":true},{"text":"naho nanasa tañañe an-kalio-tahiñe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nalovilovy lomoñandro iraho;","poem":1},{"lineBreak":true},{"text":"vaho nililoveñe boa-maraiñe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lehe ataoko te, zao ty ho volañeko;","poem":1},{"lineBreak":true},{"text":"hete! tsy ho nahity amo tariran’ ana’oo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa ie nitsakoreako,","poem":1},{"lineBreak":true},{"text":"haharendreke o raha zao,","poem":1},{"lineBreak":true},{"text":"le nihamokorañe o masokoo,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ampara’ te niziliheko","poem":1},{"lineBreak":true},{"text":"an-toen’Añahare miavake ao;","poem":1},{"lineBreak":true},{"text":"vaho nahaisake ty figadoña’ iareo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe apo’o an-tane malama iereo;","poem":1},{"lineBreak":true},{"text":"ampikorovohe’o mb’an-karotsahañe ao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hoke! akore ty fiantoa’ iareo anianike,","poem":1},{"lineBreak":true},{"text":"Fa binotsa’ ty firevendreveñañe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hoe nofy t’ie tsekake; ry Talè,","poem":1},{"lineBreak":true},{"text":"ie mivañon-dRehe","poem":1},{"lineBreak":true},{"text":"le ho heje’o vintañ’ iareo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Fa nikokentrekokentreñe ty troko naho niteveke ty an-tsapavoako ao,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Akore ty hanèko naho","poem":1},{"lineBreak":true},{"text":"ty habahimoako, hoe biby añatrefa’o eo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fe mpiama’o nainai’e iraho;","poem":1},{"lineBreak":true},{"text":"rinambe’o ty tañako havana,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hiaoloa’o ami’ty fanoroa’o,","poem":1},{"lineBreak":true},{"text":"vaho ho rambese’o","poem":1},{"lineBreak":true},{"text":"mb’añ’engeñe mb’eo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ia ro ahiko an-dikerañe ao,","poem":1},{"lineBreak":true},{"text":"naho tsy Ihe?","poem":1},{"lineBreak":true},{"text":"le tsy amam-pisalalàko an-tane atoy naho tsy Ihe.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Milesa ty nofoko naho o ovakoo,","poem":1},{"lineBreak":true},{"text":"fa i Andrianañahare ro haozaran-","poem":1},{"lineBreak":true},{"text":"troko naho ty anjarako nainai’e.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Toe hihomake ze lavits’ Azo;","poem":1},{"lineBreak":true},{"text":"songa aitoa’o ze miamboho","poem":1},{"lineBreak":true},{"text":"ama’o hañarapiloa’e.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Fe soa ho ahy ty fañarineako","poem":1},{"lineBreak":true},{"text":"aman’Añahare,","poem":1},{"lineBreak":true},{"text":"fipalirako t’i Iehovà Talè,","poem":1},{"lineBreak":true},{"text":"hataliliko iaby o tolon-draha’oo.","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Iob 21:7, Iir 12:1-2, Sab 73:17 92:6-7","reference":{"chapter":73,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}