{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":75,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Asafe, takasy ami’ty feo : Ko Mandrotsake"]},{"type":"verse","number":1,"content":[{"text":"Fa nañandriañe Azo zahay","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare !","poem":1},{"lineBreak":true},{"text":"fa nañandriañe Azo,","poem":1},{"lineBreak":true},{"text":"fa marine i tahina’oy,","poem":1},{"lineBreak":true},{"text":"fa nitaroñeñe o fitoloña’o fanjakao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie amotoañako andro;","poem":1},{"lineBreak":true},{"text":"le hizaka ami’ty fahiti’e iraho.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mitranake ty tane toy","poem":1},{"lineBreak":true},{"text":"naho ze kila mimoneñe ao,","poem":1},{"lineBreak":true},{"text":"Izaho ty nampijadoñe o faha’eo. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hanoeko ty hoe amo mpirengevokeo:","poem":1},{"lineBreak":true},{"text":"Ko mandroharoha!","poem":1},{"lineBreak":true},{"text":"le amo lo-tserekeo:","poem":1},{"lineBreak":true},{"text":"Ko mañonjon-tsifa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko zonjoeñe añ’abo o tsifa’ areoo,","poem":1},{"lineBreak":true},{"text":"vaho ko mivolañe an-kagàn-kàtoke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa tsy boak’atiñana ndra ahandrefa","poem":1},{"lineBreak":true},{"text":"ndra am-patrambey añe ty fañonjonañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I Andrianañahare ro mizaka;","poem":1},{"lineBreak":true},{"text":"afotsa’e ty raike le aonjo’e ty raike.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Am-pità’ Iehovà ao ty fitovy","poem":1},{"lineBreak":true},{"text":"pea divay mandroso, lifo-pilaroañe;","poem":1},{"lineBreak":true},{"text":"le ampidoañe’e;","poem":1},{"lineBreak":true},{"text":"toe ho drofote’ ze fonga lo-tsereke","poem":1},{"lineBreak":true},{"text":"an-tane atoy,","poem":1},{"lineBreak":true},{"text":"vaho hagodra’ iareo o karafo’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa naho izaho, ho talilieko nainai’e,","poem":1},{"lineBreak":true},{"text":"ho rengeko an-tsabo t’i Andrianañahare’ Iakobe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fonga ho kitsiheko ty tsifa’","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"fe honjoneñe ty tsifa’ o vantañeo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}