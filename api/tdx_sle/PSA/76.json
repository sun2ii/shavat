{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":76,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Asafe, Titiheñe ami’ty marotaly"]},{"type":"verse","number":1,"content":[{"text":"Fohiñe e Iehodà ao","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare;","poem":1},{"lineBreak":true},{"text":"ra’elahy e Israele ao i tahina’ey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E Salema ao ty kivoho’e;","poem":1},{"lineBreak":true},{"text":"e Tsiône ao ty fimoneña’e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teo ty nampipeñafa’e","poem":1},{"lineBreak":true},{"text":"o ana-pale nibebañeo,","poem":1},{"lineBreak":true},{"text":"o kalan-defoñeo, o fibarao,","poem":1},{"lineBreak":true},{"text":"naho o hotakotakeo. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mireandrean-drehe, am-bolonahetse, mandikoatse ty vohitse aman-tsindroke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nivoloseñe o fanalolahio,","poem":1},{"lineBreak":true},{"text":"ie nilañake ty rotse, ndra raik’ amo lahi-maozatseo","poem":1},{"lineBreak":true},{"text":"tsy nahaisake ty fità’e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ami’ty trevo’o,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare’ Iakobe,","poem":1},{"lineBreak":true},{"text":"le sindre nitsikorak’ an-drotse","poem":1},{"lineBreak":true},{"text":"ty mpiningitse reke-tsoavala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ihe le Ihe avao ro añeveñañe!","poem":1},{"lineBreak":true},{"text":"Ia ty mahafitroatse añatrefa’o eo te ihe ro viñetse?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nampijanjiñe’o boak’ an-dikerañe añe","poem":1},{"lineBreak":true},{"text":"ty zaka,","poem":1},{"lineBreak":true},{"text":"nihembañe ty tane toy vaho nitsiñe,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ie nitroatse hizaka t’i Andrianañahare","poem":1},{"lineBreak":true},{"text":"handrombake o mpisotri’ ty tane toio. Selà","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Toe handrenge Azo","poem":1},{"lineBreak":true},{"text":"ty haboseha’ ondatio,","poem":1},{"lineBreak":true},{"text":"ho sadiañe’o ty tsy niritse","poem":1},{"lineBreak":true},{"text":"amo haviñerañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mifantà am’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ areo, le henefo;","poem":1},{"lineBreak":true},{"text":"Songa mañengà amy","poem":1},{"lineBreak":true},{"text":"Mampañeveñey o mañohok’ azeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aitoa’e ty kofò’ o roandriañeo;","poem":1},{"lineBreak":true},{"text":"irevendreveña’","poem":1},{"lineBreak":true},{"text":"o mpanjaka’ ty tane toio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}