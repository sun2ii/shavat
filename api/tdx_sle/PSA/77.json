{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":77,"content":[{"type":"heading","content":["Ho a i Talè, ami’ty Iedotone, Sabo’ i Asafe"]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amy andro nahampohek’ ahiy","poem":1},{"lineBreak":true},{"text":"t’ie nipay i Talè;","poem":1},{"lineBreak":true},{"text":"an-taña nahity, tsy nigebañe te haleñe;","poem":1},{"lineBreak":true},{"text":"nifoneñe tsy hohòeñe ty foko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie mahatiahy iraho, ry Andrianañahare","poem":1},{"lineBreak":true},{"text":"le mitretretretre, ie tsakorèko,","poem":1},{"lineBreak":true},{"text":"le mitoirañe ty troko. Selà","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tana’o tsy hikòpoke o holi-masokoo;","poem":1},{"lineBreak":true},{"text":"embetse iraho tsy mahafivolañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nereñereko o andro taoloo,","poem":1},{"lineBreak":true},{"text":"o taoñe haehaeo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tiahiko o nititihako an-kaleñeo;","poem":1},{"lineBreak":true},{"text":"mifañaoñe ami’ty troko iraho,","poem":1},{"lineBreak":true},{"text":"le hoe ty fitsakorean-troko:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Haitoa’ i Talè zafe-anake hao?","poem":1},{"lineBreak":true},{"text":"le lia’e tsy hisohe’e hao?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa modo kitro añ’afe’e hao","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’e?","poem":1},{"lineBreak":true},{"text":"Fa nilesa kitro-katroke hao","poem":1},{"lineBreak":true},{"text":"i nampitamae’ey?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nihaliñon’Añahare hao ty fatariha’e?","poem":1},{"lineBreak":true},{"text":"nagabe’e an-kaviñerañe ao hao","poem":1},{"lineBreak":true},{"text":"i fitretreza’ey? Selà","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Le hoe raho : Zao ty halemeako:","poem":1},{"lineBreak":true},{"text":"Ie ataoko ho mete miova","poem":1},{"lineBreak":true},{"text":"ty fitàn-kavana’ i Andindimoneñey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho tiahiko ty fitoloña’ Ià,","poem":1},{"lineBreak":true},{"text":"hahatsikaitse o raha tsitantane","poem":1},{"lineBreak":true},{"text":"nanoe’o haehaeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ho hene tsakorèko o fitoloña’oo,","poem":1},{"lineBreak":true},{"text":"hereñerèko o tolon-draha’oo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare, masiñe","poem":1},{"noteId":32},{"text":"ty lala’o;","poem":1},{"lineBreak":true},{"text":"ia ty ndrahare ra’elahy","poem":1},{"lineBreak":true},{"text":"hañirinkiriñe aman’ Añahare?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ihe ro Andrianañahare","poem":1},{"lineBreak":true},{"text":"mitolon-kalatsàñe!","poem":1},{"lineBreak":true},{"text":"fa naboa’o am’ ondatio ty haozara’o.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nijebañem-pità’o ondati’oo,","poem":1},{"lineBreak":true},{"text":"o tarira’ Iakobe naho Iosefeo. Selà","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nahatrea Azo o ranoo,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"ie nahatrea azo i ranoy","poem":1},{"lineBreak":true},{"text":"le nivalitaboake !","poem":1},{"lineBreak":true},{"text":"nitabohazake i lalekey.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nampikojojoake orañe o rahoñeo;","poem":1},{"lineBreak":true},{"text":"nigorogodoiñe i likerañey,","poem":1},{"lineBreak":true},{"text":"nimb’etia mb’atia ka o ana-pale’oo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tam-po’ i tangololahiy","poem":1},{"lineBreak":true},{"text":"ty fivola’ i ampi’oy;","poem":1},{"lineBreak":true},{"text":"nampireandreañe’ i helatsey","poem":1},{"lineBreak":true},{"text":"ty voatse toy!","poem":1},{"lineBreak":true},{"text":"nihondrahondra naho niozoñozoñe","poem":1},{"lineBreak":true},{"text":"ty tane toy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nitoañe’ i lala’oy i riakey,","poem":1},{"lineBreak":true},{"text":"i rano jabajabay ty nilalan-tsile’o;","poem":1},{"lineBreak":true},{"text":"vaho tsy nioniñe o liam-pandia’oo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Narahe’o hoe lia-raike ondati’oo, am-pità’ i Mosè naho i Aharone.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Ies 35:8","reference":{"chapter":77,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":19}