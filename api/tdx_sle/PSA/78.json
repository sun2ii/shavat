rue},{"text":"droae’ iareo e Mitsraimeo, an-tete’ i Tsòañe ao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Finatsi’e i riakey naho nampisorohe’e mb’eo iereo!","poem":1},{"lineBreak":true},{"text":"najoha’e hoe votry i ranoy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Le niaoloa’e an-drahoñe iereo","poem":1},{"lineBreak":true},{"text":"te antoandro,","poem":1},{"lineBreak":true},{"text":"naho an-kazavàñ’afo te haleñe","poem":1},{"lineBreak":true},{"text":"am-para’ te niporea.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Finoi’e o vato am-patrañeo,","poem":1},{"lineBreak":true},{"text":"finaha’e rano bey manahake i an-dalekey;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nampitotsaha’e torahañe ty lamilamy vaho nampikararaha’e rano hoe oñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fe mbe nandilara’ iareo,","poem":1},{"lineBreak":true},{"text":"niola amy Abo Tiañey","poem":1},{"lineBreak":true},{"text":"am-babangoañ’ añe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nitsohe’ iereo an-troke","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1},{"lineBreak":true},{"text":"nihalaly mahakama","poem":1},{"lineBreak":true},{"text":"ty amy hadrao’iareo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Toe, nandrabio’ iareo","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare, ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Mahafañalankañe fandambañañe","poem":1},{"lineBreak":true},{"text":"an-dratraratra ao hao","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahare,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Eka, finofo’e i vato","poem":1},{"lineBreak":true},{"text":"nampidoandoan-dranoy,","poem":1},{"lineBreak":true},{"text":"vaho nampanganahanae’e o torahañeo.","poem":1},{"lineBreak":true},{"text":"Aa vaho hahafanjotsoa’e mofo ka?","poem":1},{"lineBreak":true},{"text":"he ho fahana’e hena hao ondati’eo?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aa ie jinaji’ Iehovà,","poem":1},{"lineBreak":true},{"text":"le niforoforo ty fifombo’e,","poem":1},{"lineBreak":true},{"text":"naho namiañañe afo t’Iakobe,","poem":1},{"lineBreak":true},{"text":"vaho nionjoñe am’ Israele ty haviñerañe,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amy t’ie tsy natoky an’Andrianañahare,","poem":1},{"lineBreak":true},{"text":"vaho tsy niatoa’ iareo ty fandrombaha’e;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fe linili’e o rahoñe amboneo,","poem":1},{"lineBreak":true},{"text":"naho sinoka’e o lalambein-dindìñeo,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"nampikojojoaha’e mane ho kamae’iereo;","poem":1},{"lineBreak":true},{"text":"nanjotsoa’e ampemban-dikerañe.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nikama ty mofom-panalolahy ondatio! nampidobaña’e mahakama nahaeneñe!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nampikofaohe’e an-dikerañe ey","poem":1},{"lineBreak":true},{"text":"ty tiok’ atiñanañe vaho","poem":1},{"lineBreak":true},{"text":"nitehafe’e an-­kaozarañe i tiok’ atimoy.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nampidoañe’e am’ iareo","poem":1},{"lineBreak":true},{"text":"ty hena hoe lemboke,","poem":1},{"lineBreak":true},{"text":"voroñe amañ’elatse","poem":1},{"lineBreak":true},{"text":"mira amo fasen-driakeo!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"nampivotrahe’e aivo’","poem":1},{"lineBreak":true},{"text":"ty tobe’e ao,","poem":1},{"lineBreak":true},{"text":"niarikoboñe i Toem-pimoneña’ey.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aa le nikama iareo vaho nianjañe","poem":1},{"lineBreak":true},{"text":"amy te nanjotsoa’e ty hasiji’ iareo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ie mboe nibòro ty drao’ iareo,","poem":1},{"lineBreak":true},{"text":"mbe tam-palie’ iareo ao i henay,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"le nihelofe’ ty haviñeran’ Añahare","poem":1},{"lineBreak":true},{"text":"navetra’e o nanjofak’ am’iereoo,","poem":1},{"lineBreak":true},{"text":"vaho nampihotrahe’e o jinoboñ’ Israeleo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ie amy zay iaby, mbe nitolon-kakeo iereo, tsy niantoke","poem":1},{"lineBreak":true},{"text":"o fitoloña’e fanjakao.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aa le nampigadoña’e an-kamodoañe","poem":1},{"lineBreak":true},{"text":"ty andro’ iareo,","poem":1},{"lineBreak":true},{"text":"naho an-­kebahebake ty tao’ iareo.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ie zinevo’e iereo, naho nipay aze,","poem":1},{"lineBreak":true},{"text":"nisoloho vaho nitsoeke","poem":1},{"lineBreak":true},{"text":"an’Andrianañahare,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"le nahatiahy te lamilami’ iareo","poem":1},{"lineBreak":true},{"text":"t’i Andrianamboatse,","poem":1},{"lineBreak":true},{"text":"naho t’ie Mpijeba’ iareo","poem":1},{"lineBreak":true},{"text":"i Andrianañaharen-dindimoneñey.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Fe kinabea’ iareo am-palie;","poem":1},{"lineBreak":true},{"text":"vaho nandañitse am-pameleke.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Toe tsy nifahatse ama’e o arofo’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho tsy nigahiñe amy fañìna’ey.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Fe amy fitretreza’ey,","poem":1},{"lineBreak":true},{"text":"le hinaha’e o hakeo’ iareoo,","poem":1},{"lineBreak":true},{"text":"naho tsy rinotsa’e;","poem":1},{"lineBreak":true},{"text":"beteke natoli’e ty haviñera’e,","poem":1},{"lineBreak":true},{"text":"vaho tsy fonga nitroboa’e o fifombo’eo !","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Nitiahi’e te nofotse avao iareo,","poem":1},{"lineBreak":true},{"text":"tioke mihelañe naho tsy mibalike.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Impire hao ty niodia’ iareo","poem":1},{"lineBreak":true},{"text":"am-patrambey añe,","poem":1},{"lineBreak":true},{"text":"vaho nampioje’Aze an-dratraratra añe?","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Eka, niamboho naho nitsok’ an’Andrianañahare iereo,","poem":1},{"lineBreak":true},{"text":"vaho nanigike i Masi’ Israeley","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Tsy nitiahi’ iereo ty fità’e,","poem":1},{"lineBreak":true},{"text":"i andro nijebaña’e iareo","poem":1},{"lineBreak":true},{"text":"amy rafelahiy,","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ie nampipoha’e e Mitsraime añe","poem":1},{"lineBreak":true},{"text":"o vilo’eo naho","poem":1},{"lineBreak":true},{"text":"an-tete’ i Tsòañe ao o halatsà’eo.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Nafote’e ho lio o saka’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho tsy nimete kamaeñe","poem":1},{"lineBreak":true},{"text":"o toraha’ iareoo.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Nañiraha’e laletse nifamorohotse,","poem":1},{"lineBreak":true},{"text":"namotseke, naho sahoñe nandrotsake.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Natolo’e amo oletseo","poem":1},{"lineBreak":true},{"text":"ty havokara’ iareo,","poem":1},{"lineBreak":true},{"text":"amo valalao ty tolim-pitoloña’ iareo.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Rinotsa’e ami’ty havandra","poem":1},{"lineBreak":true},{"text":"ty vahe’ iareo, naho","poem":1},{"lineBreak":true},{"text":"an-drano-panala o sakoa’ iareoo.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Nengae’e amy havandray","poem":1},{"lineBreak":true},{"text":"o añombe’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho an-kelatse nibelabela","poem":1},{"lineBreak":true},{"text":"o mpirai-tro’ iareoo.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Nahitri’e am’iereo ty fiforoforoa’e;","poem":1},{"lineBreak":true},{"text":"fifomboañe naho haviñerañe vaho hankàñe; firimboñan’ anjely mpandrotsake.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Nampimirae’e lalañe i haviñera’ey;","poem":1},{"lineBreak":true},{"text":"tsy navotso’e am-pihomahañe","poem":1},{"lineBreak":true},{"text":"ty fiai’iareo,","poem":1},{"lineBreak":true},{"text":"fa napo’e ho zamanen-kiria","poem":1},{"lineBreak":true},{"text":"ty havelo’ iareo","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Binaibai’e ze hene tañoloñoloña’","poem":1},{"lineBreak":true},{"text":"i Mitsraime, ty lohan-kaozara’iareo","poem":1},{"lineBreak":true},{"text":"an-kiboho’ i Kame ao.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Nonjone’e hoe añondry ondati’eo;","poem":1},{"lineBreak":true},{"text":"vaho niaoloa’e mb’am-babangoañe añe hoe lia-raike.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Nindese’e tsy nolañeñe,","poem":1},{"lineBreak":true},{"text":"le tsy nihembañe iereo,","poem":1},{"lineBreak":true},{"text":"vaho nampiopoe’ i riakey o rafelahio.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Nindese’e mb’an-tane’e miavake mb’eo, sikala’am