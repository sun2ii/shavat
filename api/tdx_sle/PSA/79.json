{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":79,"content":[{"type":"heading","content":["Sabo’ i Asafe"]},{"type":"verse","number":1,"content":[{"text":"Ry Andrianañahare, tinorotosi’","poem":1},{"lineBreak":true},{"text":"o kilakila ‘ndatio","poem":1},{"noteId":33},{"text":"ty lova’o;","poem":1},{"lineBreak":true},{"text":"fa tiniva’ iereo i anjomba’o Masiñey","poem":1},{"lineBreak":true},{"text":"zinevo’ iereo ho am-botri-am-botry","poem":1},{"lineBreak":true},{"text":"t’Ierosalaime.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Finaha’e ami’ty fañova’ o mpitoro’oo","poem":1},{"lineBreak":true},{"text":"o voron-dikerañeo;","poem":1},{"lineBreak":true},{"text":"naho ami’ty nofo’ o nigahiñ’ ama’oo","poem":1},{"lineBreak":true},{"text":"o bibi’ ty tane toio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nadoandoañe hoe rano mb’eo mb’eo","poem":1},{"lineBreak":true},{"text":"e Ierosalaime ao ty lio’ iareo;","poem":1},{"lineBreak":true},{"text":"ie tsy amam-pandenteke.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fifosà’ o am-paripari’aio zahay,","poem":1},{"lineBreak":true},{"text":"mandrabioñe naho mitsikike anay o mañohok’ anaio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pak’ombia ry Iehovà?","poem":1},{"lineBreak":true},{"text":"ho viñera’o nainai’e hao?","poem":1},{"lineBreak":true},{"text":"Sikal’ombia ty mbe hibebañe","poem":1},{"lineBreak":true},{"text":"hoe afo ty famarahia’o?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adobaño amo kilakila ondaty tsy","poem":1},{"lineBreak":true},{"text":"mahafohiñ’Azoo ty haviñera’o;","poem":1},{"lineBreak":true},{"text":"naho amo tane tsy mikanjy i tahina’oio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa nabotse’ iereo t’Iakobe, naho","poem":1},{"lineBreak":true},{"text":"nanoeñe tanàn-taolo ty fimoneña’e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko tiahie’o ama’ay o hakeon-drae’aio,","poem":1},{"lineBreak":true},{"text":"ampisalakao anay masìka","poem":1},{"lineBreak":true},{"text":"o fiferenaiña’oo,","poem":1},{"lineBreak":true},{"text":"fa nafotsak’ ambane.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Imbao, ry Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahañ’ anay!","poem":1},{"lineBreak":true},{"text":"Ty amy enge’ i tahina’oy;","poem":1},{"lineBreak":true},{"text":"avotsoro, vaho saroño","poem":1},{"lineBreak":true},{"text":"o hakeo’aio ty amy tahina’oy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aa vaho akore ty atao’ o kilakila","poem":1},{"lineBreak":true},{"text":"ondatio ty hoe :","poem":1},{"lineBreak":true},{"text":"Aia t’i Andrianañahare’ iareo?","poem":1},{"lineBreak":true},{"text":"Ampahafohino o fifeheañeo","poem":1},{"lineBreak":true},{"text":"ampahaisaha’ay","poem":1},{"lineBreak":true},{"text":"ty famaleañe o liom-pitoro’o nadoañeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampiatrefañ’ Azo","poem":1},{"lineBreak":true},{"text":"ty fitretretretre’ o mpirohio;","poem":1},{"lineBreak":true},{"text":"ty ami’ty harà’ elahin-kaozara’o;","poem":1},{"lineBreak":true},{"text":"hahao o tinendre havetrakeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le valeo im-pito añ’araña’","poem":1},{"lineBreak":true},{"text":"o mañohok’ anaio, o tivetive","poem":1},{"lineBreak":true},{"text":"nafokafoka’e ama’oo ry Talè.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Soa te hañandriañe Azo nainai’e zahay ondati’o naho","poem":1},{"lineBreak":true},{"text":"añondrim-piandraza’oo,","poem":1},{"lineBreak":true},{"text":"vaho hatalili’ay amy ze hene tariratse","poem":1},{"lineBreak":true},{"text":"kitro añ’afe’e ty enge’o.","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"Sab 79:6-7; 74:1-23, Ies 63:18, Iir 51:51, Fir 1:10, Dan 8:13, 11:31, Mat 24:15","reference":{"chapter":79,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}