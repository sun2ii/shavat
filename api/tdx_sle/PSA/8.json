{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":8,"content":[{"type":"heading","content":["Ho a i Talèm-Pititike, Anoeñe maro-taly, Sabo’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, Talè’ay, Oakitia!","poem":1},{"lineBreak":true},{"text":"ty havolonahe’ i Tahina’oy","poem":1},{"lineBreak":true},{"text":"manitsike ty tane toy,","poem":1},{"lineBreak":true},{"text":"napò’o ambonen-dike­rañe eñe ty enge’o!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Boak’am-bava’ o ajaja-menao","poem":1},{"lineBreak":true},{"text":"naho o ajaja minonoo","poem":1},{"lineBreak":true},{"text":"ty nampijadoña’o haozarañe,","poem":1},{"lineBreak":true},{"text":"ty amo malaiñe Azoo,","poem":1},{"lineBreak":true},{"text":"hampiànjiña’o o rafelahio naho o mpamale-fateo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie haraharaeko o likera’oo, ty fitoloñan-drambom-pità’o,","poem":1},{"lineBreak":true},{"text":"i volañey naho o vasiañe najado’oo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ino ondatio, te itsakorea’o?","poem":1},{"lineBreak":true},{"text":"Naho ty ana-ondaty, te haoñe’o?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe nanoe’o ambanevane’ o anjelio","poem":1},{"noteId":4},{"text":",","poem":1},{"lineBreak":true},{"text":"naho sinabàka’o engeñe naho asiñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nampifehè’o aze o tolom-pità’oo;","poem":1},{"lineBreak":true},{"text":"kila narongo’o ambanem-pandia’e ao,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ze hene añondry naho añombe;","poem":1},{"lineBreak":true},{"text":"eka, o biby an-kivokeo:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O voron-dikerañeo, o fian-driakeo,","poem":1},{"lineBreak":true},{"text":"ze misoroke o lalan-driakeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ry Iehovà, Talè’ay, Oasirity!","poem":1},{"lineBreak":true},{"text":"ty volonahen-Tahina’o","poem":1},{"lineBreak":true},{"text":"manitsike ty tane toy.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Elohim: Andrianañahare, o ndrahareo","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/tdx_sle/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}