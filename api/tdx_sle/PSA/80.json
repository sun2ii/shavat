{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":80,"content":[{"type":"heading","content":["Ho a i Talè, ami’ty feo: Antsivam-pivory, ­titiheñe amo Marovanio. Sabo’ i Asafe."]},{"type":"verse","number":1,"content":[{"text":"Toloro ravembia ry Mpiarak’ Israele,","poem":1},{"lineBreak":true},{"text":"ry Mpiaolo’ Iosefe hoe t’ie lia-raike;","poem":1},{"lineBreak":true},{"text":"ry Mpiambesatse ambone’ o kerobeo,","poem":1},{"lineBreak":true},{"text":"mireandreaña !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsekafo añatrefa’ i Efraime naho","poem":1},{"lineBreak":true},{"text":"i Beniamine naho i Menase ty haozara’o vaho mb’etoa hañimba anay !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare, Ampolio zahay","poem":1},{"lineBreak":true},{"text":"naho ampireandreaño laharañe,","poem":1},{"lineBreak":true},{"text":"soa te ho tra-drombake zahay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O ry Iehovà Andrianañahare’ i Màroy,","poem":1},{"lineBreak":true},{"text":"pak’ombia ty mbe hiviñera’o","poem":1},{"lineBreak":true},{"text":"ty halali’ ondati’oo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nazotso’o mofon-dranom-pihaino,","poem":1},{"lineBreak":true},{"text":"naho nampigenohe’o ranomaso","poem":1},{"lineBreak":true},{"text":"am-pitovy telo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ampanivetivè’o ondaty mañohok’anaio; vaho vereverè’ o rafelahi’aio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare’ i Màroy.","poem":1},{"lineBreak":true},{"text":"Ampolio zahay,","poem":1},{"lineBreak":true},{"text":"ampireandreaño ty lahara’o,","poem":1},{"lineBreak":true},{"text":"soa t’ie ho tra-drombake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nitsongoe’o boak’e Mitsraime ty vahe;","poem":1},{"lineBreak":true},{"text":"rinoa’o o kilakila‘ndatio naho naketsa’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nihatsafe’o ty tane aolo’e eo,","poem":1},{"lineBreak":true},{"text":"naho nampandaleke o vaha’eo,","poem":1},{"lineBreak":true},{"text":"vaho nanitsife’o i taney.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nikopahe’ i alo’ey o vohitseo;","poem":1},{"lineBreak":true},{"text":"naho o tsampa’eo o mendoraveñe ra’elahio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nandrevake mb’amy riakey","poem":1},{"noteId":34},{"text":"o ra’eo,","poem":1},{"lineBreak":true},{"text":"naho pak’amy sakay añe o tora’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa vaho akore ty nandrotsaha’o o fahe’eo, hitimpona’ ze miary eo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Troatroae’ ty lambon’ ala,","poem":1},{"lineBreak":true},{"text":"vaho abotse’ ze misitsitse an-kivoke ey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ry Andrianañahare’ i màroy,","poem":1},{"lineBreak":true},{"text":"Ehe, Mibaliha, mijilova boak’ an-dikerañe ao naho vazoho vaho tiliho ty vahe toy,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eka! i tora’e naketsam-pitàn-kavana’oy, i ana-dahy nampaozare’o ho Azoy,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"finorototo’ ty afo, finira,","poem":1},{"lineBreak":true},{"text":"mihomake ami’ty fitrevohan-dahara’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Anampezo fitàñe indatim-pitàn-kavana’oy, i ana’ ondaty nampifatrare’o ho Azoy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Vaho tsy hiambohoa’ay;","poem":1},{"lineBreak":true},{"text":"Ehe sotraho, hikanjia’ay ty tahina’o.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ry Iehovà Andrianañahare’ i Màroy; Ampolio zahay,","poem":1},{"lineBreak":true},{"text":"ampireandreaño ama’ay ty lahara’o,","poem":1},{"lineBreak":true},{"text":"vaho ho tra-drombake.","poem":1}]}],"footnotes":[{"noteId":34,"caller":"+","text":"Riake: i Mediteraney","reference":{"chapter":80,"verse":11}}]},"thisChapterLink":"/api/tdx_sle/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}