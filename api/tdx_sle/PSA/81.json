{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":81,"content":[{"type":"heading","content":["Ho a i Talè, Sabo’ i Asafe Titiheñe amo Marovanio"]},{"type":"verse","number":1,"content":[{"text":"Misaboa aman’Añahare haozarantika;","poem":1},{"lineBreak":true},{"text":"mipazaha an-drebeke aman’Añahare’ Iakobe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Araho an-tsabo !","poem":1},{"lineBreak":true},{"text":"Pehopeho ty kantsàñe;","poem":1},{"lineBreak":true},{"text":"titiho ty jejo mamy-feo reketse marovany.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tiofo amy jiri-bolañey ty antsiva,","poem":1},{"lineBreak":true},{"text":"amy pea-bolam- pamantañan-tikañey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fañè","poem":1},{"noteId":35},{"text":"ho a i Israele;","poem":1},{"lineBreak":true},{"text":"fepèn’ Andrianañahare’ Iakobe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Noriza’e am’Iehosefe","poem":1},{"noteId":36},{"text":"ho taroñe,","poem":1},{"lineBreak":true},{"text":"ie niavotse le nanitsike ty tane’ i Mitsraime;","poem":1},{"lineBreak":true},{"text":"naho tsinanoko ty saontsy tsy napotako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nahahako an-tsoro’e eo i kilankañey,","poem":1},{"lineBreak":true},{"text":"navotsotse amy lietsey o fità’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kinanji’o t’ie niampoheke,","poem":1},{"lineBreak":true},{"text":"le rinombako;","poem":1},{"lineBreak":true},{"text":"nanoiñe azo am-pikafi­ran’ ampiñe ao;","poem":1},{"lineBreak":true},{"text":"nitsoheako an-drano Meriba añe. Selà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Janjiño ry ondatiko, le ho toroako,","poem":1},{"lineBreak":true},{"text":"ry Israele, hera ho haoñe’areo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy ho ama’ndrahare hafa irehe,","poem":1},{"lineBreak":true},{"text":"tsy hitalaho","poem":1},{"lineBreak":true},{"text":"amo saren-drahare ila’eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Izaho Iehovà Andrianañahare’o","poem":1},{"lineBreak":true},{"text":"ninday azo boak’an-tane’ Mitsraime añe.","poem":1},{"lineBreak":true},{"text":"atañatañao ty falie’o, le hetsaheko.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fe ­nihiritsiritse amako ondatikoo","poem":1},{"lineBreak":true},{"text":"vaho nanjehats’ ahy t’Israele.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le napoko horihe’ iereo","poem":1},{"lineBreak":true},{"text":"ty hagàn’ arofo’ iareo,","poem":1},{"lineBreak":true},{"text":"homb’am-pisafiri’ iareo avao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa naho nijanjiñe ahy ondatikoo!","poem":1},{"lineBreak":true},{"text":"naho nañavelo amo lalakoo t’Israele,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"le ho nampitsolofiñeko aniany","poem":1},{"lineBreak":true},{"text":"o malaiñe iareoo;","poem":1},{"lineBreak":true},{"text":"vaho ho natoliko ty tañako hiatreatre","poem":1},{"lineBreak":true},{"text":"o rafelahi’ iareoo!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nioniñe te tsy to añatrefa’ Iehovà","poem":1},{"lineBreak":true},{"text":"o malaiñe azeo,","poem":1},{"lineBreak":true},{"text":"fe ho nainai’e eo t’Israele.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Le hanjotsoa’e ampemba soa iereo,","poem":1},{"lineBreak":true},{"text":"naho hanjañeko an-tantele boak’am-bato ao.","poem":1}]}],"footnotes":[{"noteId":35,"caller":"+","text":"Sor 23:24, Num 10:10, 29:1","reference":{"chapter":81,"verse":4}},{"noteId":36,"caller":"+","text":"Iehosefe: Iosefe tinovoñ’ i tahinan’A’har","reference":{"chapter":81,"verse":5}}]},"thisChapterLink":"/api/tdx_sle/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}