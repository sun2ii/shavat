m":1},{"lineBreak":true},{"text":"fa naveve iaby o faha’ ty tane toio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanao ty hoe iraho: Mpizaka","poem":1},{"noteId":37},{"text":"nahareo","poem":1},{"lineBreak":true},{"text":"songa anak’ i Andindimoneñey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fe hikoromake hoe ondaty avao,","poem":1},{"lineBreak":true},{"text":"hikorovoke manahake ty raike","poem":1},{"lineBreak":true},{"text":"amo roandriañeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miongaha, ry Andrianañahare,","poem":1},{"lineBreak":true},{"text":"zakao ty tane toy,","poem":1},{"lineBreak":true},{"text":"fa kila ho lovae’o o fifeheañeo.","poem":1}]}],"footnotes":[{"noteId":37,"caller":"+","text":"elohim: a’hare maro, mpizaka, anjely,","reference":{"chapter":82,"verse":6}}]},"thisChapterLink":"/api/tdx_sle/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}