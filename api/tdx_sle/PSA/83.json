{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":83,"content":[{"type":"heading","content":["Sabo’ i Asafe, Takasy"]},{"type":"verse","number":1,"content":[{"text":"Ko mianjiñe ry Andrianañahare","poem":1},{"lineBreak":true},{"text":"ko mimosy vaho ko mañamahama,","poem":1},{"lineBreak":true},{"text":"ry Andrianamboatse!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heheke, ­miroharoha o rafelahi’oo,","poem":1},{"lineBreak":true},{"text":"mivoala-doha o malaiñe Azoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hikililie’ iareo ondati’oo;","poem":1},{"lineBreak":true},{"text":"mivory hikinia o mipalitse ama’oo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Antao, hoe iereo, haitoan-tika","poem":1},{"lineBreak":true},{"text":"tsy ho fifeheañe ka.","poem":1},{"lineBreak":true},{"text":"soa tsy ho tiahy ka ty añara’ Israeley.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An-troke miraike t’ie mikinia,","poem":1},{"lineBreak":true},{"text":"mifañina fanjeharañe ama’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O kiboho’ i Edome naho Ismaeleo;","poem":1},{"lineBreak":true},{"text":"i Moabe, naho o nte Hagìo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"i Gebale naho i Amone,","poem":1},{"lineBreak":true},{"text":"naho i Amaleke;","poem":1},{"lineBreak":true},{"text":"i Pilisty vaho o mpimone’ i Tsoreo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rekets’ am’ iareo ka t’i Asore;","poem":1},{"lineBreak":true},{"text":"le fitañe am’iareo o ana’ i Loteo. Selà","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampanahafo amy nanoa’o amy Midiane,","poem":1},{"lineBreak":true},{"text":"amy Sisera vaho am’ Iabene","poem":1},{"lineBreak":true},{"text":"an-torahan-Kisone añe,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"i narotsake Endora añe rey,","poem":1},{"lineBreak":true},{"text":"ninjare litsake amy taney.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ampihambaño amy Orebe","poem":1},{"lineBreak":true},{"text":"naho amy Zeèbe o roandria’eo,","poem":1},{"lineBreak":true},{"text":"fonga hanahak’ i Zebake naho i Tsalmonà","poem":1},{"lineBreak":true},{"text":"o ana-dona’ iareoo","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ie nanoa’iareo ty hoe:","poem":1},{"lineBreak":true},{"text":"Antao hitavañe o fiandrazen’ Añahareo!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O Andrianañahareko,","poem":1},{"lineBreak":true},{"text":"anò hoe talìon-deboke iereo,","poem":1},{"lineBreak":true},{"text":"hoe kafokafo miatre-tioke !","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manahake ty afo mamorototo ala,","poem":1},{"lineBreak":true},{"text":"naho ty foroha mampisolebatse","poem":1},{"lineBreak":true},{"text":"o vohitseo;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa le horidaño amy tangololahi’oy;","poem":1},{"lineBreak":true},{"text":"le ampihembaño ami’ty tio-bei’o.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Liforo hasalarañe ty vìnta’ iareo,","poem":1},{"lineBreak":true},{"text":"hipaia’e ty tahina’o","poem":1},{"noteId":38},{"text":", ry Iehovà.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ie ho salareñe naho","poem":1},{"lineBreak":true},{"text":"hangebakebake nainai’e,","poem":1},{"lineBreak":true},{"text":"eka ho meñareñe naho hikoromake.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hahafohina’ ondatio te Ihe avao,","poem":1},{"lineBreak":true},{"text":"ro kanjieñe ty hoe Iehovà,","poem":1},{"lineBreak":true},{"text":"Andindimone’ ty tane toy.","poem":1}]}],"footnotes":[{"noteId":38,"caller":"+","text":"Sab 44:21-22, 74:18, Ies 52:5, Iir 23:26-27","reference":{"chapter":83,"verse":16}}]},"thisChapterLink":"/api/tdx_sle/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}