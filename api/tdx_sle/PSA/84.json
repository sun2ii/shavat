"lineBreak":true},{"text":"Haha o mimoneñe añ’anjomba’o ao,","poem":1},{"lineBreak":true},{"text":"mandrenge Azo nainai’eo. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haha t’indaty naho ihe ro haozara’e,","poem":1},{"lineBreak":true},{"text":"añ’arofo’iareo","poem":1},{"lineBreak":true},{"text":"o lalam-pamantañañeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ie miranga am-bavatanem-","poem":1},{"lineBreak":true},{"text":"pirovetañe","poem":1},{"noteId":39},{"text":"ao,","poem":1},{"lineBreak":true},{"text":"le ampanjarie’e tane manganahana,","poem":1},{"lineBreak":true},{"text":"vaho saroña’ i oran-jobay fañanintsiñe!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mañavelo an-kaozarañe","poem":1},{"lineBreak":true},{"text":"orihen-kafatrarañe iareo,","poem":1},{"lineBreak":true},{"text":"songa miatrek’ an’Andrianañahare","poem":1},{"lineBreak":true},{"text":"e Tsiône ao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà Andrianañahare’","poem":1},{"lineBreak":true},{"text":"i Màroy, janjiño ty halaliko;","poem":1},{"lineBreak":true},{"text":"toloro ravembia,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare’ Iakobe. Selà","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vazohò ry Andrianamboatse","poem":1},{"lineBreak":true},{"text":"Mpikalan-defo’aiy,","poem":1},{"lineBreak":true},{"text":"isaho ty lahara’ i noriza’oy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Soa te ami’ty andro arivo,","poem":1},{"lineBreak":true},{"text":"ty andro raik’ an-kiririsa’o ao;","poem":1},{"lineBreak":true},{"text":"hamake te mpañamben-dalam-","poem":1},{"lineBreak":true},{"text":"bein’ anjomban’Añahareko iraho,","poem":1},{"lineBreak":true},{"text":"ta te himoneñe an-kiboho’","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Masoandro vaho fikalañe","poem":1},{"lineBreak":true},{"text":"t’Iehovà Andrianañahare,","poem":1},{"lineBreak":true},{"text":"Mpanolotse falalàñe naho engeñe","poem":1},{"lineBreak":true},{"text":"t’Iehovà: tsy eo ty raha soa","poem":1},{"lineBreak":true},{"text":"ho tana’e amo mañavelo","poem":1},{"lineBreak":true},{"text":"an-kavantañañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O ry Iehovà’ i Màroy,","poem":1},{"lineBreak":true},{"text":"haha t’indaty miato ama’o.","poem":1}]}],"footnotes":[{"noteId":39,"caller":"+","text":"Heb: Baka","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/tdx_sle/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}