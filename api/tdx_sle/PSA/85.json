oie’o an-tariratse kitro","poem":1},{"lineBreak":true},{"text":"añ’afe’e hao, o helok’añ’arofo’oo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy ihe hao ty hameloñe anay indraike,","poem":1},{"lineBreak":true},{"text":"hirebeha’ ondati’oo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Atorò anay ty fiferenaiña’o,","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1},{"lineBreak":true},{"text":"toloro o fandrombaha’oo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho tsendreñeko ty ho tsarae’ Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañahare;","poem":1},{"lineBreak":true},{"text":"fa fañanintsiñe ty taroñe’e am’","poem":1},{"lineBreak":true},{"text":"ondati’eo naho amo noro’eo;","poem":1},{"lineBreak":true},{"text":"le ee abey t’ie tsy hibalintoa mb’an-kadagolàñey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toe marine’ o mañeveñe ama’eo","poem":1},{"lineBreak":true},{"text":"ty fandrombaha’e,","poem":1},{"lineBreak":true},{"text":"hitobea’ o enge’eo an-tanen-tikañ’ ao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mifañaoñe ty fiferenaiñañe","poem":1},{"lineBreak":true},{"text":"naho ty hatò;","poem":1},{"lineBreak":true},{"text":"mifañondroke ty havantañañe","poem":1},{"lineBreak":true},{"text":"naho ty filongoañe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mivoañe hirik’an-tane ao ty hatò,","poem":1},{"lineBreak":true},{"text":"mijilo hirik’an-dikerañe añe","poem":1},{"lineBreak":true},{"text":"o havantañañeo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eka, hanjotso ty soa t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hañomey ty voka’e ty tane’ay toy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hiaolo Aze ty havañonañe,","poem":1},{"lineBreak":true},{"text":"hañajaria’e lalañe ho liam-pandia’e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}