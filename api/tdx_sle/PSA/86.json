{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":86,"content":[{"type":"heading","content":["Halali’ i Davide"]},{"type":"verse","number":1,"content":[{"text":"Atokilaño ty ravembia’o","poem":1},{"lineBreak":true},{"text":"ry Iehovà, le toiño iraho,","poem":1},{"lineBreak":true},{"text":"fa rarake naho misotry.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ambeno ty fiaiko, fa mañorike Hake,","poem":1},{"lineBreak":true},{"text":"Ihe ry Andrianañahareko, rombaho","poem":1},{"lineBreak":true},{"text":"o mpitoro’o mipalitse ama’oo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tretrezo iraho, ry Talè,","poem":1},{"lineBreak":true},{"text":"izaho mitoreo lomoñandro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ampifaleo ty fiaim-pitoro’o,","poem":1},{"lineBreak":true},{"text":"fa Ihe, ry Talè, ro añonjonako troke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amy te Ihe, ry Talè, ro soa,","poem":1},{"lineBreak":true},{"text":"naho veka’e hañaha hakeo,","poem":1},{"lineBreak":true},{"text":"vaho lifotse fiferenaiñañe","poem":1},{"lineBreak":true},{"text":"ho amo mikanjy Azo iabio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toloro ravembia, ry Iehovà, i halalikoy,","poem":1},{"lineBreak":true},{"text":"vaho haoño ty feom-pisolohoako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hikanjiako ami’ty androm-pañemberañ’ ahiko,","poem":1},{"lineBreak":true},{"text":"amy te hanoiñe ahy irehe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"tsy eo ty fanalolahy hambañ’ama’o ry Talè;","poem":1},{"lineBreak":true},{"text":"vaho tsy eo ty fitoloñañe","poem":1},{"lineBreak":true},{"text":"manahake o Azoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ze kila ondaty nitsenè’o,","poem":1},{"lineBreak":true},{"text":"ro homb’ ama’o mb’eo hitalaho,","poem":1},{"lineBreak":true},{"text":"ry Talè, hibango ty tahina’o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jabahinake ‘n-Iheo,","poem":1},{"lineBreak":true},{"text":"mpanao raha tsitantane;","poem":1},{"lineBreak":true},{"text":"Ihe avao ro Andrianañahare.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Anaro ahy i lala’oy, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"hitsontihako ami’ty hatò’o;","poem":1},{"lineBreak":true},{"text":"anò tro-tokan-draho hañeveñako","poem":1},{"lineBreak":true},{"text":"i tahina’oy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hañandriañe Azo iraho, ry Talè","poem":1},{"lineBreak":true},{"text":"Andrianañahareko, an-kaliforan’ troke,","poem":1},{"lineBreak":true},{"text":"vaho ho bangoeko nainai’e ty tahina’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hinakinake ty hafatram-pikokoa’o amako, naho navotso’o ami’ty","poem":1},{"lineBreak":true},{"text":"halalen-tsikeokeok’ ao ty fiaiko.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O Andrianañahare, fa mitroatse","poem":1},{"lineBreak":true},{"text":"amako o mpirengevokeo;","poem":1},{"lineBreak":true},{"text":"vaho mipay hañe-doza amako","poem":1},{"lineBreak":true},{"text":"o lo-tsereke miotrañeo,","poem":1},{"lineBreak":true},{"text":"ie tsy nampijadoñ’ azo aolo’ ty maso’ iareo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fa Ihe, Talè, ro Andrianañahare","poem":1},{"lineBreak":true},{"text":"bey tretrè naho hasoa,","poem":1},{"lineBreak":true},{"text":"malaon-kaviñerañe,","poem":1},{"lineBreak":true},{"text":"vaho lifo-piferenaiñañe naho ty hatò.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mitoliha amako, le matariha,","poem":1},{"lineBreak":true},{"text":"ehe, andivao amo mpitoro’oo ty haozara’oo","poem":1},{"lineBreak":true},{"text":"vaho rombaho ty anak’am-pata’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ehe, anoloro vilon-tsoa,","poem":1},{"lineBreak":true},{"text":"hahaisaha’ o malaiñe ahikoo hisalara’e,","poem":1},{"lineBreak":true},{"text":"amy te Ihe, ry Iehovà, ro nañimba ahy","poem":1},{"lineBreak":true},{"text":"vaho nañohò ahy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}