oe e Tsiône ao :","poem":1},{"lineBreak":true},{"text":"Intoy naho intia ro toly ama’e ao,","poem":1},{"lineBreak":true},{"text":"i Andindimoneñey","poem":1},{"lineBreak":true},{"text":"ty mañoreñ’ aze.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hañiake t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ho volilie’e ondatio:","poem":1},{"lineBreak":true},{"text":"Nisamak’ ao toy. Selà","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa le hanao ty hoe o misaboo","poem":1},{"lineBreak":true},{"text":"naho o mitsolio,","poem":1},{"lineBreak":true},{"text":"hene ama’o o fandoparakoo.","poem":1}]}],"footnotes":[{"noteId":40,"caller":"+","text":"Mitsraime izay","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}