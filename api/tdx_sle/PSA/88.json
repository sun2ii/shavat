{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":88,"content":[{"type":"heading","content":["Sabo’ o ana’ i Kora, Ho a i Talè, titiheñe ami’ty feo: Ty Hasotria’ o Hasilofañeo. Fanoroa’ i Hemane nte-Ezrà."]},{"type":"verse","number":1,"content":[{"text":"Ry Iehovà, Andrianañaharem-","poem":1},{"lineBreak":true},{"text":"pandrombahañe ahiko,","poem":1},{"lineBreak":true},{"text":"itoreovako handro an-kaleñe","poem":1},{"lineBreak":true},{"text":"añatrefa’o,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ehe te hiatrek’ azo ty halaliko;","poem":1},{"lineBreak":true},{"text":"atokilaño mb’amy fikaihakoy ty ravembia’o;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa losotse ty hasosoram-piaiko,","poem":1},{"lineBreak":true},{"text":"vaho manòto-kibory","poem":1},{"noteId":41},{"text":"ty haveloko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Volilieñe amo migodoñe","poem":1},{"lineBreak":true},{"text":"mb’an-davak’ ao iraho;","poem":1},{"lineBreak":true},{"text":"hoe ondaty nipitso-pañimba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mihoriñe amo vilasio iraho,","poem":1},{"lineBreak":true},{"text":"manahake o vinono mitsalalampatse","poem":1},{"lineBreak":true},{"text":"an-kiborio,","poem":1},{"lineBreak":true},{"text":"o tsy tiahi’o kañeo,","poem":1},{"lineBreak":true},{"text":"o naito am-pità’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Navotra’o ami’ty loho herakerak’ ao","poem":1},{"lineBreak":true},{"text":"an-toe’e mimoromoroñe an-dalek’ ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Napok’ amako o fifombo’oo, naho naniloke ahy o kinera’oo. Selà","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa naveve’o lavitse ahy o rañekoo,","poem":1},{"lineBreak":true},{"text":"nampirihie’o ahiko.","poem":1},{"lineBreak":true},{"text":"migoboñe atoan-draho tsy mahafiakatse;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mitike amy hasotriakoy o masokoo.","poem":1},{"lineBreak":true},{"text":"fa nikanjieko boak’andro, ry Iehovà;","poem":1},{"lineBreak":true},{"text":"fa namelarako tañañe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hanoa’o raha tsitantane hao o loloo?","poem":1},{"lineBreak":true},{"text":"Hitroatse hañandriañ’ Azo","poem":1},{"lineBreak":true},{"text":"hao o angatseo? Selà","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho talilieñe an-donak’ ao hao","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’o?","poem":1},{"lineBreak":true},{"text":"an-tsikeokeok’ ao hao","poem":1},{"lineBreak":true},{"text":"ty figahiña’o?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hampahafohineñe am-pimoromoroñañe ao hao o halatsà’oo,","poem":1},{"lineBreak":true},{"text":"naho an-tanem-pandikofañe","poem":1},{"lineBreak":true},{"text":"ao hao ty havañona’o?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa naho izaho, ihe ry Iehovà ty itoreovako; mifanalaka ama’o boak’andro","poem":1},{"lineBreak":true},{"text":"o halalikoo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ry Iehovà akore te farie’o ty fiaiko?","poem":1},{"lineBreak":true},{"text":"Ino ty añetaha’o laharañ’ amako?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nalovilovy ho nikenkan-draho","poem":1},{"lineBreak":true},{"text":"ampara’ ty nahajalahy ahiko,","poem":1},{"lineBreak":true},{"text":"fa nivavèko ty hetraketra’o,","poem":1},{"lineBreak":true},{"text":"vaho voretra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa nandipotse ahy","poem":1},{"lineBreak":true},{"text":"ty fifombo’o miforoforo;","poem":1},{"lineBreak":true},{"text":"vaho fa nañito ahy","poem":1},{"lineBreak":true},{"text":"ty firevendreveñañe ama’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Niropak’ amako lomoñandro hoe rano, le nanaron-kohok’ ahy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Toe nampihankàñe’o amako","poem":1},{"lineBreak":true},{"text":"ty mpikoko naho rañetse;","poem":1},{"lineBreak":true},{"text":"atehenako ty hamoromoroñañe.","poem":1}]}],"footnotes":[{"noteId":41,"caller":"+","text":"Seoly : tsikeokeoke","reference":{"chapter":88,"verse":3}}]},"thisChapterLink":"/api/tdx_sle/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}