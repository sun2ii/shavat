{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":89,"content":[{"type":"heading","content":["Fanoroa’ i Etane nte-Ezrà"]},{"type":"verse","number":1,"content":[{"text":"Ho saboeko nainai’e","poem":1},{"lineBreak":true},{"text":"ty fiferenaiña’ Iehovà,","poem":1},{"lineBreak":true},{"text":"hampahafohineko am-bava","poem":1},{"lineBreak":true},{"text":"ze hene tariratse mifandimbe","poem":1},{"lineBreak":true},{"text":"ty figahiña’o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa hoe iraho: mioreñe nainai’e","poem":1},{"lineBreak":true},{"text":"ty fiferenaiñañe,","poem":1},{"lineBreak":true},{"text":"najado’o andindiñe ao ty figahiña’o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanoeko fañina amy jinobokoy,","poem":1},{"lineBreak":true},{"text":"nifanta amy Davide mpitorokoy:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hajadoko pak’añ’afeafe’e o tarira’oo,","poem":1},{"lineBreak":true},{"text":"naho hatroako amo hene tariratseo","poem":1},{"lineBreak":true},{"text":"ty fiambesam-panjakà’o. Selà","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ho rengè’ o likerañeo o halatsà’oo","poem":1},{"lineBreak":true},{"text":"ry Iehovà, naho ty figahiña’o","poem":1},{"lineBreak":true},{"text":"am-pivori’ o noro’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fa ia an-dikerañe ao ty","poem":1},{"lineBreak":true},{"text":"mañirinkiriñe am’ Iehovà?","poem":1},{"lineBreak":true},{"text":"Ia amo ana’ o manjofakeo ty","poem":1},{"lineBreak":true},{"text":"hambakambañe am’ Iehovà?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I Andrianañahare","poem":1},{"lineBreak":true},{"text":"añeveña’ ty fivori’ o noro’eo;","poem":1},{"lineBreak":true},{"text":"hene ilatsa’ o miariseho’ azeo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà Andrianañahare’ i Màroy,","poem":1},{"lineBreak":true},{"text":"ia ty mañirinkiriñe azo?","poem":1},{"lineBreak":true},{"text":"Ry Ià maozatseo, ohoñe’ty figahiña’o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fehe’o ty fitroña’ o riakeo,","poem":1},{"lineBreak":true},{"text":"ie mitroatse o alo’eo le ampipendreñe’o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dinemodemo’o ty Rahabe","poem":1},{"lineBreak":true},{"text":"manahake o vinonoo;","poem":1},{"lineBreak":true},{"text":"binaibaim-pitàn-kaozara’o o rafelahi’oo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Azo o likerañeo, Azo ka ty tane toy;","poem":1},{"lineBreak":true},{"text":"ty voatse toy naho ty halifora’e.","poem":1},{"lineBreak":true},{"text":"Ihe ro nañoreñe iareo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ty avaratse naho ty atimo,","poem":1},{"lineBreak":true},{"text":"songa nitsenè’o;","poem":1},{"lineBreak":true},{"text":"rebehe’ i Tabore naho i Kermone","poem":1},{"lineBreak":true},{"text":"ty tahina’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maozatse ty sira’o, fatratse ty fità’o,","poem":1},{"lineBreak":true},{"text":"mionjoñe ty fitàn-kavana’o.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ty havañonañe naho ty hatò","poem":1},{"lineBreak":true},{"text":"ro fioreñam-piambesa’o;","poem":1},{"lineBreak":true},{"text":"iatrefa’ ty fiferenaiñañe","poem":1},{"lineBreak":true},{"text":"naho ty havantañañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Haha t’ondaty mahafohiñe","poem":1},{"lineBreak":true},{"text":"i fipoñafam-peoy,","poem":1},{"lineBreak":true},{"text":"Hañavelo ami’ty fireandrean-","poem":1},{"lineBreak":true},{"text":"dahara’o iereo, ry Iehovà;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I tahina’oy ty hitreña’ iareo","poem":1},{"lineBreak":true},{"text":"lomoñandro,","poem":1},{"lineBreak":true},{"text":"ie onjoñe’ ty havantaña’o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ihe ro enge’ ty haozara’iareo,","poem":1},{"lineBreak":true},{"text":"mañonjoñe ty tsifa’ay ty fañosiha’o.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A i Iehovà ty fikalan-defo’ay,","poem":1},{"lineBreak":true},{"text":"a i Masi’ Israeley ty Mpanjaka’ay","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Teo ty nitsarae’o añ’aroñaroñe","poem":1},{"lineBreak":true},{"text":"amo noro’oo, ty hoe:","poem":1},{"lineBreak":true},{"text":"fa nìmbaeko i fanalolahiy;","poem":1},{"lineBreak":true},{"text":"fa nonjoneko ty jinoboñe am’ ondatio,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"nitreako t’i Davide mpitoroko;","poem":1},{"lineBreak":true},{"text":"i norizako amy soliko miavakeiy.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ho gañe ama’e ty tañako,","poem":1},{"lineBreak":true},{"text":"hampaozatse aze ka ty sirako","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tsy hamañahy aze o rafelahio,","poem":1},{"lineBreak":true},{"text":"tsy hampilovilovy aze i anan-karatiañey.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ho demoheko añatrefa’e","poem":1},{"lineBreak":true},{"text":"o rafelahi’eo,","poem":1},{"lineBreak":true},{"text":"vaho ho zevoñeko o malaiñ’azeo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ho ama’e ty figahiñako naho","poem":1},{"lineBreak":true},{"text":"ty fiferenaiñako,","poem":1},{"lineBreak":true},{"text":"ty añarako ro fañonjonañe ty tsifa’e.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hasampeko amy riakey ka ty fità’e,","poem":1},{"lineBreak":true},{"text":"naho ty fitàn-kavana’e amo sakao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ho kanjie’e ami’ty hoe: Ihe ro Raeko,","poem":1},{"lineBreak":true},{"text":"Andrianañahareko, vaho","poem":1},{"lineBreak":true},{"text":"ty lamilamim-pandrombahañe ahiko.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hanoeko tañoloñoloñako re","poem":1},{"lineBreak":true},{"text":"ho talèm-panjaka’ ty tane toy.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Hambenako ami’ty fiferenaiñako nainai’e, le hijadoñe ama’e ty fañinako.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Haoreko tsy ho modo nainai’e","poem":1},{"lineBreak":true},{"text":"o tarira’eo,","poem":1},{"lineBreak":true},{"text":"ho mira amo","poem":1},{"lineBreak":true},{"text":"andron-dikerañeo ty fiambesa’e.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aa naho zehare’ o ana’eo i Entakoy","poem":1},{"lineBreak":true},{"text":"naho tsy mañavelo amo fepèkoo,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"naho lilare’ iareo o fañèkoo, vaho tsy mitañ’ o fandiliakoo,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Le ho tiliheko an-kobaiñe ty fiolà’ iareo,","poem":1},{"lineBreak":true},{"text":"naho am-pòfoke o tahi’ iereoo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Fe tsy hasintako ama’e","poem":1},{"lineBreak":true},{"text":"ty fiferenaiñako,","poem":1},{"lineBreak":true},{"text":"vaho tsy hivalik’ ami’ty figahiñako.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tsy ho tivaeko i fañinakoy,","poem":1},{"lineBreak":true},{"text":"ndra hañova ze naakan-tsoñiko.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Teo ty nifantàko ami’ty hamasiñako,","poem":1},{"lineBreak":true},{"text":"—zaho tsy handañitse amy Davide—","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tsy ho modo nainai’e i tiri’ey,","poem":1},{"lineBreak":true},{"text":"vaho manahake i masoandro aolokoy i fiambesa’ey;","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"hioreñe nainai’e re manahake i volañey,","poem":1},{"lineBreak":true},{"text":"vaho higahiñe manahake","poem":1},{"lineBreak":true},{"text":"i valolombelon-dikerañey. Selà","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Fe sinoi’o añe iraho, nifarieñe,","poem":1},{"lineBreak":true},{"text":"niviñera’o i noriza’oy.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Novohe’o ty fañina’o amy mpitoro’oy; nitivae’o an-debok’ao ty sabakan-enge’e.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Fonga tinorotosi’o o kijoli’eo","poem":1},{"lineBreak":true},{"text":"narotsa’o iaby o rova’eo.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ikopaha’ ze hene miary eo;","poem":1},{"lineBreak":true},{"text":"Andrabioña’ o mifankarine ama’eo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Naonjo’o ty tañan-kavana’","poem":1},{"lineBreak":true},{"text":"o malaiñe azeo;","poem":1},{"lineBreak":true},{"text":"nampirebehe’o o rafelahi’e iabio;","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Mbore nafote’o i lelam-pibara’ey","poem":1},{"lineBreak":true},{"text":"le tsy ampijohañe’o an-kotakotak’ ao.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Najihe’o ty enge’e, naho","poem":1},{"lineBreak":true},{"text":"navokovoko’o an-tane eo i fiambesa’ey.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Nitomore’o o andron-katora’eo, kinolopo’o hasalaran-dre. Selà","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Pak’ombia ry Iehovà?","poem":1},{"lineBreak":true},{"text":"Hietake nainai’e v’iheo?","poem":1},{"lineBreak":true},{"text":"Sikala ombia ty hiforoforoa’","poem":1},{"lineBreak":true},{"text":"ty fifombo’o hoe afo?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Tiahio ty habori’ o androkoo,","poem":1},{"lineBreak":true},{"text":"akore ty hakoahañe nitsenè’o","poem":1},{"lineBreak":true},{"text":"ze kila ana’ ondaty !","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Ia t’indaty veloñe tsy ho liàn-kavilasy,","poem":1},{"lineBreak":true},{"text":"ho haha’e ami’ty haozara’","poem":1},{"lineBreak":true},{"text":"i kiboriy hao ty fiai’e? Selà","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Aia o fiferenaiña’o haehaeo, ry Talè,","poem":1},{"lineBreak":true},{"text":"ze nifantà’o amy Davide ami’ty figahiña’o?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Tiahio ry Talè, ty fañivañivañe","poem":1},{"lineBreak":true},{"text":"i mpitoro’oy,","poem":1},{"lineBreak":true},{"text":"ie otroñeko añ’arañako ondaty maroo,","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"ie kinizakiza’ o rafelahi’oo, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ie ninjè’ iareo o lia’ i noriza’oio;","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Andriañeñe nainai’e t’Iehovà.","poem":1},{"lineBreak":true},{"text":"Ie izay, naho Amena.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}