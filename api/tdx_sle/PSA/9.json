{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":9,"content":[{"type":"heading","content":["Ho a i Talèn’ Tsakera, Sabo’ i Davide, ami’ty feo : Ty havilasi’ i Ana-dahiy"]},{"type":"verse","number":1,"content":[{"text":"Rengeko an-kaliforan-troke irehe r’Iehovà;","poem":1},{"lineBreak":true},{"text":"ho talilieko iaby o halatsa’oo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hifaleako naho hirebehako,","poem":1},{"lineBreak":true},{"text":"ho saboeko i tahina’oy,","poem":1},{"lineBreak":true},{"text":"ry Andindimoneñe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie mimpoly o rafelahikoo,","poem":1},{"lineBreak":true},{"text":"le mikorovoke vaho mibaibay","poem":1},{"lineBreak":true},{"text":"añ’atrefa’o ey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa nitohañe’o i naseseko mahitiy,","poem":1},{"lineBreak":true},{"text":"ihe miambesatse am-piambesa’o eo,","poem":1},{"lineBreak":true},{"text":"mizaka an-kavantañañe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nendaha’o o kilakila ‘ndatio, rinotsa’o o lo-tserekeo;","poem":1},{"lineBreak":true},{"text":"finaopao’o kitro katroke ty añara’ iareo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O ry rafelahio, fa nampigadoñeñe","poem":1},{"lineBreak":true},{"text":"an-koak’ao kitro katroke;","poem":1},{"lineBreak":true},{"text":"fa nombota’o o rovao,","poem":1},{"lineBreak":true},{"text":"fa momoke ty fitiahiañe iareo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe am-piambesa’e eo nainai’e t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fa nihentseña’e ho an-jaka i fiambesa’ey;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"an-katò ty fizaka’e ty voatse toy,","poem":1},{"lineBreak":true},{"text":"ho zakae’e an-kahiti’e ondatio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kijoly abo te amo forekekeñeo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"fitsolohañe an-tsan-kasotriañe;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hiantok’ azo o mahafohiñe","poem":1},{"lineBreak":true},{"text":"ty tahina’oo,","poem":1},{"lineBreak":true},{"text":"amy te tsy aforintse’o ze mipay Azo,","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Misaboa am’ Iehovà ry mpimoneñe","poem":1},{"lineBreak":true},{"text":"e Tsiône ao!","poem":1},{"lineBreak":true},{"text":"tseizo am’ ondatio o fitoloña’eo!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Toe ihaoñe’ i Mpamale Fatey; tsy haliño’e ty fikoiaha’ o mpisotrio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Isoho iraho, ry Iehovà !","poem":1},{"lineBreak":true},{"text":"Vazohò ty haoreako am-pità’","poem":1},{"lineBreak":true},{"text":"o malaiñe ahio;","poem":1},{"lineBreak":true},{"text":"Ihe Mpañonjoñe ahy boak’ an-","poem":1},{"lineBreak":true},{"text":"dalam-bein-kavilasy ao,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ho talilieko iaby ty enge’o","poem":1},{"lineBreak":true},{"text":"amo lalam-bei’","poem":1},{"lineBreak":true},{"text":"i anak-ampela’ i Tsiôneio,","poem":1},{"lineBreak":true},{"text":"hirebehako o fandrombaha’oo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nijoroboñe amy koboñe","poem":1},{"lineBreak":true},{"text":"hinali’iereoy o fifeheañeo;","poem":1},{"lineBreak":true},{"text":"finandri’ ty harato naeta’iareo","poem":1},{"lineBreak":true},{"text":"o fandia’iareoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa nampandrendre-batañe t’Iehovà","poem":1},{"lineBreak":true},{"text":"fa nametsake zaka:","poem":1},{"lineBreak":true},{"text":"tsepaheñ’ amo satan-taña’eo avao","poem":1},{"lineBreak":true},{"text":"ty lo-tsereke.","poem":1},{"lineBreak":true},{"text":"[mahantseñantseñe, Selà]","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Himpoly mb’an-tsikeokoek’ ao","poem":1},{"lineBreak":true},{"text":"o tsivokatseo,","poem":1},{"lineBreak":true},{"text":"ze kilakila’ ondaty mandikok’ an’Andrianañahare.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fe tsy ho haliño nainai’e o rarakeo","poem":1},{"lineBreak":true},{"text":"vaho tsy ho modo kitro añ’afe’e","poem":1},{"lineBreak":true},{"text":"ty fisalalà’ o mpisotrio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Miongaha ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ko anga’o handrekets’ ondatio;","poem":1},{"lineBreak":true},{"text":"Ho zakaeñe am-pivazohoa’o eo","poem":1},{"lineBreak":true},{"text":"o fifeheañeo !","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Apoho am’ iareo ty fangebahebahañe,","poem":1},{"lineBreak":true},{"text":"ry Iehovà","poem":1},{"lineBreak":true},{"text":"ampahafohino o kilakila’ndatio","poem":1},{"lineBreak":true},{"text":"t’ie ondaty avao ! Selà","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}