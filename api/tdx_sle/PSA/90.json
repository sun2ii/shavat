{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":90,"content":[{"type":"heading","content":["Sabo 90-106"]},{"type":"heading","content":["Ty Filoloha’ i Mosè, Ondatin’ Añahare"]},{"type":"verse","number":1,"content":[{"text":"Ry Talè, Ihe ni-fimoneña’ay amo tarira’ay iabio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie mboe tsy toly o vohitseo","poem":1},{"lineBreak":true},{"text":"mboe tsy tsinene’o ty tane toy","poem":1},{"lineBreak":true},{"text":"naho ty voatse toy,","poem":1},{"lineBreak":true},{"text":"boak’ an-kaehae hambo’e añe","poem":1},{"lineBreak":true},{"text":"pak’ an-kitro añ’afe’e añe,","poem":1},{"lineBreak":true},{"text":"Ihe ro Andrianañahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ampolie’o mb’an-debok’ ao ondatio","poem":1},{"lineBreak":true},{"text":"ami’ty hoe:","poem":1},{"lineBreak":true},{"text":"Mimpolia ry ana’ondaty.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa arivo taoñe am-pivazohoa’o ty andro raike","poem":1},{"lineBreak":true},{"text":"toe hoe omale te nihelañe, ie","poem":1},{"lineBreak":true},{"text":"manahake ty ­fiambenañe an-kaleñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sinao’o añe hoe an-tsorotombake iereo, le miròtse,","poem":1},{"lineBreak":true},{"text":"f’ie maraiñe, le hoe ahetse mipitsipitsike.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mioboñoboñe te maraindraiñe","poem":1},{"lineBreak":true},{"text":"mbore mitombo,","poem":1},{"lineBreak":true},{"text":"ie hariva miheatse vaho miforejeje.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toe mongore’ ty haviñera’o zahay,","poem":1},{"lineBreak":true},{"text":"mampangebahebak’ anay ty fifombo’o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa napo’o añatrefa’o o tahi’aio,","poem":1},{"lineBreak":true},{"text":"am-pireandrean-dahara’o eo","poem":1},{"lineBreak":true},{"text":"o hakeo’ay mietakeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fonga mihelañe ami’ty fifombo’o","poem":1},{"lineBreak":true},{"text":"o andro’aio;","poem":1},{"lineBreak":true},{"text":"fa nagado’ay hoe fiselekaiñañe o tao’aio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ty andro’ o tao’aio le fitompolo taoñe;","poem":1},{"lineBreak":true},{"text":"mete ho valo-polo, t’ie maozatse;","poem":1},{"lineBreak":true},{"text":"fe hamokorañe naho","poem":1},{"lineBreak":true},{"text":"fangoakoahañe avao ty enge’e,","poem":1},{"lineBreak":true},{"text":"migadoñe aniany, vaho mitiliñ’añe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ia ty mahafohiñe ty haozara’","poem":1},{"lineBreak":true},{"text":"o haviñera’oo?","poem":1},{"lineBreak":true},{"text":"naho ty fañeveñañe mañeva Azo","poem":1},{"lineBreak":true},{"text":"ty ami’ty fifombo’o?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa le anaro zahay hañiake o andro’aio,","poem":1},{"lineBreak":true},{"text":"hahazoa’ay arofo mahihitse.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mimpolia ry Iehovà ! Ombia?","poem":1},{"lineBreak":true},{"text":"iferenaiño o mpitoro’oo","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eneño an-kafatraram-pikokoa’o","poem":1},{"lineBreak":true},{"text":"te maraindray zahay,","poem":1},{"lineBreak":true},{"text":"hirebeha’ay naho hifalea’ay amo","poem":1},{"lineBreak":true},{"text":"hene andro’aio.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ampifaleo mira amo andro","poem":1},{"lineBreak":true},{"text":"nampisotria’o anaio,","poem":1},{"lineBreak":true},{"text":"naho amo taoñe nahaisaha’ay haratiañeo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fa halange amo mpitoro’oo","poem":1},{"lineBreak":true},{"text":"o fitoloña’oo,","poem":1},{"lineBreak":true},{"text":"naho ty enge’o amo ana’ iareoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ho aman-tika ty fañisoha’ i Talè Andrianañahare’ay;","poem":1},{"lineBreak":true},{"text":"ajadoño ty tolom-pità’ay;","poem":1},{"lineBreak":true},{"text":"eka aoreño o satam-pità’aio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}