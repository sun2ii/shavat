{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"I mpimoneñe am-pipalira’","poem":1},{"lineBreak":true},{"text":"i Andindimoneñeiy,","poem":1},{"lineBreak":true},{"text":"ty hitoetse añ’alo’ i El-Sadai ao,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hanoako ty hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Ty fiampirako, ty rova fitsolohako,","poem":1},{"lineBreak":true},{"text":"i Andrianañahare fiatoakoy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ie ty mpañaha azo boak’","poem":1},{"lineBreak":true},{"text":"am-bitsom-pamandri-boroñe ao,","poem":1},{"lineBreak":true},{"text":"naho boak’ amy biloka mahahomakey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Haholonkolo’e am-bolon-ela’e ao irehe,","poem":1},{"lineBreak":true},{"text":"ambane’ o ela’eo ty hipalira’o;","poem":1},{"lineBreak":true},{"text":"fikalan-defo naho fikala-meso","poem":1},{"lineBreak":true},{"text":"ty hatò’e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsy hahahembañ’ azo","poem":1},{"lineBreak":true},{"text":"ty hetraketrak’ an-kaleñe,","poem":1},{"lineBreak":true},{"text":"ndra ty ana-pale mihirirìñe","poem":1},{"lineBreak":true},{"text":"an-tariñandroke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndra ty kiria mitingañe añ’ieñe ao","poem":1},{"lineBreak":true},{"text":"ndra ty angorosy mamotsake","poem":1},{"lineBreak":true},{"text":"naho antoandro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Arivo ty mete hikorovok’ añ’ ila’o eo,","poem":1},{"lineBreak":true},{"text":"le rai-ale ty am-pitàn-kavana’o eo,","poem":1},{"lineBreak":true},{"text":"f’ie tsy hitotok’ azo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O fihaino’oo avao ro hisamba,","poem":1},{"lineBreak":true},{"text":"hahaisake ty ­fandilovañe o lo-tserekeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amy te Iehovà, fitsolohako,","poem":1},{"lineBreak":true},{"text":"i Andindimoneñey,","poem":1},{"lineBreak":true},{"text":"ty nanoe’o fimoneñañe,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy hidoiñe ama’o ty hankàñe,","poem":1},{"lineBreak":true},{"text":"tsy hitotofan-angorosy ty akiba’o,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fa hafanto’e ama’o o anjeli’eo,","poem":1},{"lineBreak":true},{"text":"hañambeñe azo amo lia’o iabio;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"hañotrotroa’e am-pità’e ao,","poem":1},{"lineBreak":true},{"text":"tsy mone hadasi’o ami’ty vato ty fandia’o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ho lià’o ty liona naho ty fandrefeala;","poem":1},{"lineBreak":true},{"text":"ho hitsakitsahe’o ambanem-pandia’o eo","poem":1},{"lineBreak":true},{"text":"ty liona-tora’e naho i mereñey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kanao ifahara’e koko, ho hahako,","poem":1},{"lineBreak":true},{"text":"havotrako an-kaboañe ey","poem":1},{"lineBreak":true},{"text":"amy te fohi’e ty añarako.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ho kanjie’e, le ho toiñeko;","poem":1},{"lineBreak":true},{"text":"hindrezako te am-poheke,","poem":1},{"lineBreak":true},{"text":"ho votsorako vaho ho tolorako asiñe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Heneñeko halava’ havelon-dre;","poem":1},{"lineBreak":true},{"text":"vaho hampahaoniñeko aze","poem":1},{"lineBreak":true},{"text":"ty fandrombahako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}