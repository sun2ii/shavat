{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":92,"content":[{"type":"heading","content":["Sabo. Ho titiheñe ami’ty Sabotse"]},{"type":"verse","number":1,"content":[{"text":"Soa ty mañandriañe Iehovà,","poem":1},{"lineBreak":true},{"text":"ty misabo vaho mibango","poem":1},{"lineBreak":true},{"text":"o tahina’oo ry Andindimoneñey,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ty hitalily ty fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"boa’maraiñe;","poem":1},{"lineBreak":true},{"text":"naho ty figahiña’o an-kaleñe,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ami’ty marovany folo-taly,","poem":1},{"lineBreak":true},{"text":"naho ami’ty mandalina,","poem":1},{"lineBreak":true},{"text":"vaho ami’ty fandrimotam-peon-jejo-bory.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy te Ihe ry Iehovà ro mahaehak’ ahy amo fitoloña’oo,","poem":1},{"lineBreak":true},{"text":"irebehako o tolom-pità’oo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akore ty hajabahina’ o tolon-draha’oo","poem":1},{"lineBreak":true},{"text":"ry Iehovà,","poem":1},{"lineBreak":true},{"text":"toe miheotse o fivetsevetse’oo !","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsy aman-kilala t’indaty mineñe,","poem":1},{"lineBreak":true},{"text":"tsy maharendreke zao ty dagola:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"t’ie mitiry hoe ahetse o lo-tserekeo,","poem":1},{"lineBreak":true},{"text":"naho fonga miraorao o tsy vokatseo,","poem":1},{"lineBreak":true},{"text":"f’ie hafàtse ho rotsaheñe kitro katroke.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa Ihe ry Iehovà ro an-digiligy eñe","poem":1},{"lineBreak":true},{"text":"nainai’e donia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Heheke o rafelahi’oo ry Iehovà;","poem":1},{"lineBreak":true},{"text":"Ingo te hikoromake o malaiñ’ Azoo;","poem":1},{"lineBreak":true},{"text":"Fonga hibaibay ze mpanao raty.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa naonjo’o ty tsifako","poem":1},{"lineBreak":true},{"text":"manahake ty an-drimo,","poem":1},{"lineBreak":true},{"text":"fa hinosotse solike vao iraho.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hahatrea ty fisalalako","poem":1},{"lineBreak":true},{"text":"amo rafelahikoo’ o masokoo","poem":1},{"lineBreak":true},{"text":"vaho ho tsanoñen-tsofiko","poem":1},{"lineBreak":true},{"text":"ty fañiriako amo tsereheñe","poem":1},{"lineBreak":true},{"text":"mivoalatse amakoo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Handrevake hoe satrañe o vantañeo,","poem":1},{"lineBreak":true},{"text":"manahake ty fitiria’ o akao","poem":1},{"lineBreak":true},{"text":"e Libanoneo ty hitomboa’e;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tinongy añ’anjomba’ Iehovà ao,","poem":1},{"lineBreak":true},{"text":"hitroñe an’kiririsan’Añahare eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mbe hiregorego iereo te antetse,","poem":1},{"lineBreak":true},{"text":"ho lifo-dranoke naho hirimboñe,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"hitaroñe te vañoñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"lamilamiko, tsy ama’e ty tsy to.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}