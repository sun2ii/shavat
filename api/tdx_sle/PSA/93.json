{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Hifehe t’Iehovà, hisikim-bolonahetse, hisaron-kaozarañe t’Iehovà, toe hidiañe,","poem":1},{"lineBreak":true},{"text":"Eka, mioreñe ty voatse toy, tsy hasitse.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa norizañe haehae i fiambesa’oy,","poem":1},{"lineBreak":true},{"text":"boake tsietoimonek’ añe ‘n-Iheo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa mionjoñe o afo-ranoo, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"nipoña-peo o sorotombaha’eo;","poem":1},{"lineBreak":true},{"text":"mañonjoñe ty fitroña’e i fiepoepoañey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ambone’ ty fitroña’ o alon-driakeo,","poem":1},{"lineBreak":true},{"text":"naho o kinerake jabajaba an-driakeo","poem":1},{"lineBreak":true},{"text":"ty hara’elahi' Iehovà an-digiligy eñe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toe niventeñe o taro’oo;","poem":1},{"lineBreak":true},{"text":"mañeva havaheñe nainai’e","poem":1},{"lineBreak":true},{"text":"ty anjomba’o, ry Iehovà,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}