{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"O ry Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare mpamale-fate,","poem":1},{"lineBreak":true},{"text":"ry Andrianañahare, mpañome-to:","poem":1},{"lineBreak":true},{"text":"mireandreaña.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miongaha, ry Mpizaka’ ty tane toio;","poem":1},{"lineBreak":true},{"text":"lilovo ami’ty fañeva’e o mpirengevokeo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sikal’ ombia o lo-tsere­keo, ry Iehovà :","poem":1},{"lineBreak":true},{"text":"pak’ombia ty mbe hitreña’ o tsivokatseo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mifatatiake, manotratsotrake;","poem":1},{"lineBreak":true},{"text":"mijiajia iaby o mpanao ratio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Demohe’ iereo ondati’oo ry Iehovà,","poem":1},{"lineBreak":true},{"text":"volevole’ iereo ty lova’o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vonoe’ iereo ty vantotse","poem":1},{"lineBreak":true},{"text":"naho ty renetane,","poem":1},{"lineBreak":true},{"text":"naho mañoho-doza amo bode-raeo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"vaho manao ti-hoe: Tsy vazoho’ Ià;","poem":1},{"lineBreak":true},{"text":"tsy mañaoñe t’i Andrianañahare’ Iakobe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mañaraharà ry borololo am’ ondatio;","poem":1},{"lineBreak":true},{"text":"naho o dagolao, ombia t’ie hahafohiñe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsy mahajanjiñe hao i nambole o ravembiaoy?","poem":1},{"lineBreak":true},{"text":"Tsy mahavazoho hao i Mpitsene fihainoy?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsy hanoro hao i Mpandilo o fifeheañeo?","poem":1},{"lineBreak":true},{"text":"ie mañòke hilala am’ondatio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Arofoana’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty fitsakorea’ ondaty;","poem":1},{"lineBreak":true},{"text":"t’ie kofòke avao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Haha t’indaty lilove’o ry Ià,","poem":1},{"lineBreak":true},{"text":"naho i anara’o amy Tsara’oy;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"homea’o fitofàñe an-tsan-kasotriañe,","poem":1},{"lineBreak":true},{"text":"ampara’ te nihaliañe koboñe","poem":1},{"lineBreak":true},{"text":"o lo-tserekeo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsy ho farie’ Iehovà ondati’eo;","poem":1},{"lineBreak":true},{"text":"tsy haforintse’e i lova’ey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mbe himpoly ami’ty hahiti’e o zakao,","poem":1},{"lineBreak":true},{"text":"le hene hañorik’ aze o vañoñ’ añ’arofoo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ia ty hitroatse amo tsereheñeo ho ahy? Ia ty hijohañe amo mpanao ratio","poem":1},{"lineBreak":true},{"text":"ho amakoo?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Naho tsy Iehovà ty nañimb’ ahy","poem":1},{"lineBreak":true},{"text":"le ho nitobe am-pitsiñañe ty fiaiko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ie anoeko ty hoe :","poem":1},{"lineBreak":true},{"text":"Midorasitse ty tomboko;","poem":1},{"lineBreak":true},{"text":"le manozañ’ ahy ty fiferenaiña’o","poem":1},{"lineBreak":true},{"text":"ry Iehovà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ie mañotrotro ty hamahimahin-troke, le mampanintsiñe ty fiaiko","poem":1},{"lineBreak":true},{"text":"o fañohòa’oo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mete hiharo-rehak’ ama’o hao","poem":1},{"lineBreak":true},{"text":"ty fitobohan-katsivokarañe—","poem":1},{"lineBreak":true},{"text":"ie mikitro-draha hatao’e fañè,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"naho mirañadrañake hañè-doza","poem":1},{"lineBreak":true},{"text":"ami’ty fiai’ o vañoñeo,","poem":1},{"lineBreak":true},{"text":"vaho mañozoñe ty lio tsy aman-kila.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fe haboam-pitsolohako t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho lamilamy fipalirako","poem":1},{"lineBreak":true},{"text":"t’i Andrianañahareko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nampolia’e ty hatsivokara’ iareo, vaho ho mongora’e ty amo fikotriha’iareoo; toe ihañitoa’ Iehovà Andrianañaharentika.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}