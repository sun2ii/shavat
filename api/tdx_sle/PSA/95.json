1},{"lineBreak":true},{"text":"nitsenèm-pità’e i tane maikey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mb’etoa, hiambane vaho hitalaho,","poem":1},{"lineBreak":true},{"text":"antao hanongalek’ añatrefa’","poem":1},{"lineBreak":true},{"text":"Iehovà Mpitsene antikañe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amy te ie t’i Andrianañaharentikañe;","poem":1},{"lineBreak":true},{"text":"itika ro ondatim-piandraza’e,","poem":1},{"lineBreak":true},{"text":"naho ty lia-raim-pità’e;","poem":1},{"lineBreak":true},{"text":"Anito, naho janjiñe’ areo i fiarañanaña’ey !","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ko mañagàñe arofo,","poem":1},{"lineBreak":true},{"text":"manahake te Meriba","poem":1},{"noteId":42},{"text":"añe,","poem":1},{"lineBreak":true},{"text":"tañ’andro’ i Masa","poem":1},{"noteId":43},{"text":"am-babangoañ’ añe;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie nazizin-droae’ areo,","poem":1},{"lineBreak":true},{"text":"naoveove’iareo ndra te nioni’iereo","poem":1},{"lineBreak":true},{"text":"o fitoloñakoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Efa-polo taoñe te nalaiñeko i tariratsey","poem":1},{"lineBreak":true},{"text":"le nanoeko ty hoe: foko miola an-troke,","poem":1},{"lineBreak":true},{"text":"fa tsy apota’ iareo o satakoo;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa le nifanta ami’ty fifomboko:","poem":1},{"lineBreak":true},{"text":"Toe tsy himoaha’iareo ty fitofàko.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"Meriba: fiody Avo. 17. 7:","reference":{"chapter":95,"verse":8}},{"noteId":43,"caller":"+","text":"Massah: fitsohañe Avo. 17. 7","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/tdx_sle/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/96.json","nextChapterAudioLi