{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Misaboa sabo vao am’ Iehovà !","poem":1},{"lineBreak":true},{"text":"mitakasia am’ Iehovà, ty tane toy iaby.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Misaboa am’ Iehovà, bangò i tahina’ey;","poem":1},{"lineBreak":true},{"text":"taroño boak’andro i fandrombaha’ey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atalilio aivo’ o fifeheañeo ty enge’e,","poem":1},{"lineBreak":true},{"text":"o sata’e mahalatsao añivo’ ondaty iabio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amy te ra’elahy t’Iehovà","poem":1},{"lineBreak":true},{"text":"vaho ho rengeñe añ’abo;","poem":1},{"lineBreak":true},{"text":"revendreveñen-dre","poem":1},{"lineBreak":true},{"text":"te amy ze ndrahare iaby.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fahasive o ndrahare’ ondatio,","poem":1},{"lineBreak":true},{"text":"fa Iehovà ro namboatse o likerañeo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hasiñe naho volonahetse ro aolo’e,","poem":1},{"lineBreak":true},{"text":"haozarañe naho hatsaratseake","poem":1},{"lineBreak":true},{"text":"ro añ’anjomba’e miavake ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manolora am’ Iehovà, ry foko’ ondatio,","poem":1},{"lineBreak":true},{"text":"toloro engeñe naho haozarañe t’Iehovà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Atoloro am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ty enge mañeva i tahina’ey;","poem":1},{"lineBreak":true},{"text":"mibanabanà, le miziliha an-kiririsa’e ao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mitalahoa am’ Iehovà","poem":1},{"lineBreak":true},{"text":"an-tsiki-miambake!","poem":1},{"lineBreak":true},{"text":"mititititìha añatrefa’e eo, ty tane toy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Talilio amo fifeheañeo ty hoe:","poem":1},{"lineBreak":true},{"text":"Mifehe t’Iehovà;","poem":1},{"lineBreak":true},{"text":"toe mioreñe ty voatse toy, tsy hasiotse,","poem":1},{"lineBreak":true},{"text":"ho zakae’e mira ondatio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le hifale o likerañeo,","poem":1},{"lineBreak":true},{"text":"hirebeke ty tane toy;","poem":1},{"lineBreak":true},{"text":"hitroñe ami’ty halifora’e i riakey;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hitreñe i hivokey,","poem":1},{"lineBreak":true},{"text":"naho ze he’e ama’e ao;","poem":1},{"lineBreak":true},{"text":"fonga hisabo an-kaehake","poem":1},{"lineBreak":true},{"text":"o hatae añ’alao,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"añatrefa’ Iehovà eo, fa ho totsake re,","poem":1},{"lineBreak":true},{"text":"ho avy hizaka ty tane toy;","poem":1},{"lineBreak":true},{"text":"ho zakae’e an-kahiti’e","poem":1},{"noteId":44},{"text":"ty voatse toy","poem":1},{"lineBreak":true},{"text":"vaho ondatio ami’ty figahiña’e","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":44,"caller":"+","text":"Sab 98:9, Top 17:31, Ben 19:11","reference":{"chapter":96,"verse":13}}]},"thisChapterLink":"/api/tdx_sle/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}