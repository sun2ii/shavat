{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"PSA","translationId":"tdx_sle","name":"Sabo","commonName":"Sabo","title":"Sabo","order":19,"numberOfChapters":150,"sha256":"b47780449426d10371cab0d5fd110fc88240ec7bdc4a7e16fb0335cb319dd1ff","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tdx_sle/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Mifehe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"hirebeke ty tane toy,","poem":1},{"lineBreak":true},{"text":"hifale o tokonose maroo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie arikoboñen-drahoñe naho hamoromoroñañe;","poem":1},{"lineBreak":true},{"text":"havantañañe naho ty hatò ro ioreña’","poem":1},{"lineBreak":true},{"text":"i fiambesa’ey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Miaolo Aze ty afo, mamorototo","poem":1},{"lineBreak":true},{"text":"o rafelahi’eo mb’etia mb’eroa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nihazavae’ o hela’eo ty voatse toy;","poem":1},{"lineBreak":true},{"text":"niisa’ ty tane toy le nihondrahondra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nitranake hoe karafo o vohitseo","poem":1},{"lineBreak":true},{"text":"ami’ty niatrefa’ Iehovà,","poem":1},{"lineBreak":true},{"text":"añatrefa’ i Talè’ ty tane toy iaby.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mitalily ty havantaña’e o likerañeo,","poem":1},{"lineBreak":true},{"text":"vaho fonga mahaoniñe ty enge’e ondatio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hene salatse ze mitoron-tsare sokitse,","poem":1},{"lineBreak":true},{"text":"o misenge raha kòakeo;","poem":1},{"lineBreak":true},{"text":"miambanea ama’e ry ndrahare iabio!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nahajanjiñe ty Tsiône le niehake,","poem":1},{"lineBreak":true},{"text":"nirebeke o anak’ampela Iehodào,","poem":1},{"lineBreak":true},{"text":"ty amo fizaka’oo ry Iehovà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amy te Ihe, ry Iehovà,","poem":1},{"lineBreak":true},{"text":"ro Andindimone’ ty tane toy;","poem":1},{"lineBreak":true},{"text":"vaho onjoneñe andigiligi’","poem":1},{"lineBreak":true},{"text":"ze hene ndrahare irehe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hejeo o haratiañeo ry mpikoko Iehovà; ambena’e ty fiai’ o noro’eo,","poem":1},{"lineBreak":true},{"text":"avotso’e an-taña’ o lo-tserekeo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ararake ho a’ o vantañeo ty hazavàñe,","poem":1},{"lineBreak":true},{"text":"ho a’ o mahity arofoo ty hafaleañe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mirebeha am’ Iehovà, ry vantañeo,","poem":1},{"lineBreak":true},{"text":"vaho andriaño i tahina’e masiñey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}