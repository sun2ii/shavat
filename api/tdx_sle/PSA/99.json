":"Onjono t’Iehovà Andrianañaharentika;","poem":1},{"lineBreak":true},{"text":"midrakadrakàfa am-pitongoàm-","poem":1},{"lineBreak":true},{"text":"pandia’e eo; masin-dre.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mpiamo mpisoro’eo","poem":1},{"lineBreak":true},{"text":"t’i Mosè naho i Aharone,","poem":1},{"lineBreak":true},{"text":"mpitraok’ amo mpikanjy","poem":1},{"lineBreak":true},{"text":"i tahina’eio t’i Samoele,","poem":1},{"lineBreak":true},{"text":"sindre nitoreo am’ Iehovà","poem":1},{"lineBreak":true},{"text":"vaho nitoiña’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nitsara’e hirik’amy rahoñe nijoalay;","poem":1},{"lineBreak":true},{"text":"norihe’ iereo o taro’eo","poem":1},{"lineBreak":true},{"text":"naho i fañè natolo’e iareoy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry Iehovà Andrianañahare’ay,","poem":1},{"lineBreak":true},{"text":"natoi’o iareo,","poem":1},{"lineBreak":true},{"text":"Andrianañahare nañaha ty hakeo’ iareo,","poem":1},{"lineBreak":true},{"text":"fe nililove’e o nanoe’ iareoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Onjono t’Iehovà Andrianañaharentika","poem":1},{"lineBreak":true},{"text":"vaho mitalahoa amy vohi’e miavakey,","poem":1},{"lineBreak":true},{"text":"amy te masiñe t’Iehovà","poem":1},{"lineBreak":true},{"text":"Andrianañaharentika.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}