{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"REV","translationId":"tdx_sle","name":"Bentatse","commonName":"Bentatse","title":"Bentatse","order":66,"numberOfChapters":22,"sha256":"653041a697320da7fd39a343417151e5c83cf7422a6fbca966ff215ab4d25841","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/tdx_sle/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Ty Firotsaha’i Babolone"]},{"type":"verse","number":1,"content":["Añe izay le nahatrea anjely tovo’e nizotso boak’ andindìñe añe aman-dily ra’elahy vaho nihazavae’ ty enge’e ty tane toy."]},{"type":"verse","number":2,"content":["Le nikoihe’e am-piara­ñanañañe mafe ty hoe:",{"text":"Rotsake! Rotsake t’i Babolone Jabajaba","poem":1},{"noteId":90},{"text":"!","poem":1},{"lineBreak":true},{"text":"ie fa akiban-kokolampa henaneo, naho","poem":1},{"lineBreak":true},{"text":"lakato’ ze fonga anga-draty, vaho","poem":1},{"lineBreak":true},{"text":"zoho’ ze hene voroñe maleotse naho mampangorý.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa hene ninoñe amy divain-kadraon-","poem":1},{"lineBreak":true},{"text":"kakarapiloa’ey ze kilakila ondaty.","poem":1},{"lineBreak":true},{"text":"naho fonga niolots’ ama’e","poem":1},{"lineBreak":true},{"text":"o mpanjaka’ ty tane toio,","poem":1},{"lineBreak":true},{"text":"vaho nitampe-draha irieñe","poem":1},{"lineBreak":true},{"text":"o mpanao balibali’ ty tane toio","poem":1},{"lineBreak":true},{"text":"amy halosoran-katea-mena’ey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsinanoko ka ty fiarañanañañe boak’ andindìñe ey nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Miengà ama’e ry ondatiko, tsy","poem":1},{"lineBreak":true},{"text":"hitraok’ amo hakeo’eo,","poem":1},{"lineBreak":true},{"text":"naho tsy handrambe o angorosi’eo","poem":1},{"noteId":91},{"text":";","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"fa mitoabotse pak’andindìñe ey o tahi’eo vaho tiahin’ Añahare o sata-rati’eo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ondroho ama’e mira ami’ty natolo’e;","poem":1},{"lineBreak":true},{"text":"le avaho ama’e in-droe’ o fitoloña’eo;","poem":1},{"lineBreak":true},{"text":"vaho trobotrobò in-droe","poem":1},{"lineBreak":true},{"text":"i fitovy nilaroe’ey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ampanahafo ami’ty nienge’e naho ty","poem":1},{"lineBreak":true},{"text":"fierañerañan-tro niaiña’e,","poem":1},{"lineBreak":true},{"text":"ty samporerahañe naho anahelo","poem":1},{"lineBreak":true},{"text":"hatolotse aze.","poem":1},{"lineBreak":true},{"text":"Inao ty fisengean-tro’e :","poem":1},{"lineBreak":true},{"text":"Miambesatse raho","poem":1},{"lineBreak":true},{"text":"fa mpanjaka-rakemba,","poem":1},{"lineBreak":true},{"text":"Tsy vantotse,","poem":1},{"lineBreak":true},{"text":"vaho tsy hahatrea fioremeñañe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa le hivovo ama’e añ’ andro raike o hankà’eo: ty angorosy, ty hòntoke, vaho ty kerè,","poem":1},{"lineBreak":true},{"text":"le ho hotomomohe’ ty afo;","poem":1},{"lineBreak":true},{"text":"amy te maozatse i Talè Andrianañahare","poem":1},{"lineBreak":true},{"text":"mizaka azey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie isa’ o mpanjaka’ ty tane toio, ie nifandia-tihy ama’e naho ni-mpitrao­k’ amy fiagaregaña’ey, ty hatoe’ i fanodo­rañ’ azey, le hangololoike ty tañy naho handala,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"hizorazora eroan-koe am-pirevendreveñañe i sarerahañ’ aze, hanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Hoy hoy abey, Ry rova jabajaba! I Babolone rovan-kaozarañey!","poem":1},{"text":"Ie ora raik’ avao te pok’eo ty fizakañ’azo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mirovetse naho mandala aze o mpampibalibali’ ty tane toio, amy te tsy eo ka ty hikalo o kilanka’ iareoo:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"entañe volamena naho volafoty naho vatosoa naho hange, le leny marerarera naho malo-mavo, le lande naho mena mañabarà, naho ze karazan-katae malàñe, naho ze fanake aman-tsifan-drimo","poem":2},{"noteId":92},{"text":", naho ze fanake aman-katae sarotse, le torisìke naho viñe naho vato sanga;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"le kanely","poem":2},{"noteId":93},{"text":"naho fampafiriañe naho soli-pañosorañe naho rame le divay naho solik’ oliva, le mona’e naho vare-bolè le añombe naho añondry; le soavala naho sarete le ondevo vaho fiai’ ondaty.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nisitak’ azo o voka-tsoa nirìen-tro’oo, naho nihànkañe ama’o, tsy ho isa’o ka ze atao tave naho o raha fiain-taneo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hañarafiake eñe o nanao balibalike amy raha rezaio, o nimpañaleale ty ama’eo, am-pirevendreveñañe amy halovilovia’ey, le hangoihoy ty rovetse vaho handala","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ty hoe:","poem":2},{"text":"Hoy! Hoy! i rova ni-ra’elahiy,","poem":1},{"lineBreak":true},{"text":"nisaron-deny marerarera malo-mavo","poem":1},{"lineBreak":true},{"text":"naho mena mañabarañe,","poem":1},{"lineBreak":true},{"text":"vaho niragorago volamena","poem":1},{"lineBreak":true},{"text":"naho vatosoa vaho hange!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"fa ora raik’ avao ty nahakafoake","poem":1},{"lineBreak":true},{"text":"o vara beio!","poem":1},"Nitrobàke eñe ze fonga mpinjon-dakañe naho ze hene mpañavelo an-tsambo naho o mpiandriakeo naho ze fonga mitoloñe amy riakey,"]},{"type":"verse","number":18,"content":["songa nipazapazake ty hoe t’ie nanjò ty hatoe’ i sinodotsey:",{"text":"Aia ka ty hañirinkiriñe i rova jabajaba zay?","poem":1}]},{"type":"verse","number":19,"content":[{"text":"le nampibobò deboke añambone’e, naho nangoihoy ty rovetse vaho nitoreo ty hoe:","poem":1},{"lineBreak":true},{"text":"Hoy! Hoy, I rova foloaingitrokey!","poem":1},{"lineBreak":true},{"text":"ze nampañaleale ze nanan-tsambo","poem":1},{"lineBreak":true},{"text":"an-driak’ añe añamy vara’ey!","poem":1},{"lineBreak":true},{"text":"amy te ora raik’ avao","poem":1},{"lineBreak":true},{"text":"ty nampikoahañ’ aze!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Irebeho ry likerañeo!","poem":1},{"lineBreak":true},{"text":"naho ry noro’e naho Firàheñe","poem":1},{"lineBreak":true},{"text":"vaho mpitokio!","poem":1},{"lineBreak":true},{"text":"Inahareo ro nizakàn’ Añahare aze.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ie amy zao, rinambe’ ty anjely fanalolahy ty vato bey hoe vato-fandi­sanañe jabajaba, le navokovoko’e an-driake eñe nanao ty hoe:","poem":1},{"lineBreak":true},{"text":"Izay ro handretsahañe i Babolone","poem":1},{"lineBreak":true},{"text":"rova jabajabay ambane tsy ho oniñe ka.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Le tsy ho janjiñeñe ama’o ao ka","poem":1},{"lineBreak":true},{"text":"ty feo’ o mpititike marovanio,","poem":1},{"lineBreak":true},{"text":"naho o sairio,","poem":1},{"lineBreak":true},{"text":"naho o mpitioke soly naho antsivao,","poem":1},{"lineBreak":true},{"text":"naho tsy ho trea ama’o ka","poem":1},{"lineBreak":true},{"text":"ze mpitsene an-satam-pitàñ’inoñ’inoñe,","poem":1},{"lineBreak":true},{"text":"vaho tsy ho janjiñeñe ama’o ao ka","poem":1},{"lineBreak":true},{"text":"ty fikosaokosaom-bato fandisañe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"le tsy hiiloilo ama’o ao ka","poem":1},{"lineBreak":true},{"text":"ty hazavàm-pailo,","poem":1},{"lineBreak":true},{"text":"mbore tsy ho janjiñeñe ama’o ao ka","poem":1},{"lineBreak":true},{"text":"ty fifañòhahohà’ i engavaoy","poem":1},{"lineBreak":true},{"text":"naho i mañengay;","poem":1},{"lineBreak":true},{"text":"ni-fanalolahy an-tane-bey atoy","poem":1},{"lineBreak":true},{"text":"o mpanao balibalik’ ama’oo,","poem":1},{"lineBreak":true},{"text":"amy te nampikalitahe’ o famoreha’oo","poem":1},{"lineBreak":true},{"text":"o fifeheañeo,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"naho ama’e ao ty nahatendrehañe","poem":1},{"lineBreak":true},{"text":"ty lio’ o mpitokio naho o noro’eo,","poem":1},{"lineBreak":true},{"text":"vaho ze hene vinono an-tane atoy","poem":1},{"noteId":94},{"text":".","poem":1}]}],"footnotes":[{"noteId":90,"caller":"+","text":"Ies 21:9","reference":{"chapter":18,"verse":2}},{"noteId":91,"caller":"+","text":"Iir 51:6, 9, 45; Iir 50:8, 13, 28","reference":{"chapter":18,"verse":4}},{"noteId":92,"caller":"+","text":"toe tsifa’ ty elefanta (biby jabajaba)","reference":{"chapter":18,"verse":12}},{"noteId":93,"caller":"+","text":"kanely: holi-katae mañitse fampifiriañe","reference":{"chapter":18,"verse":13}},{"noteId":94,"caller":"+","text":"Mat 23:30, Lke 11:50","reference":{"chapter":18,"verse":24}}]},"thisChapterLink":"/api/tdx_sle/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}