{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"SNG","translationId":"tdx_sle","name":"Sabo Talango’e","commonName":"Sabo Talango’e","title":"Sabo Talango’e","order":22,"numberOfChapters":8,"sha256":"8130167f6e526f9969069ad64729279c567198280900fdafec1251ba3d15186d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tdx_sle/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ty Sabo talango’ i Selomò.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":2,"content":[{"text":"Apoho hañorok’ahy re","poem":1},{"lineBreak":true},{"text":"amo orok’ am-palie’eo!","poem":1},{"lineBreak":true},{"text":"Fa soa te amo divaio ty fikokoa’o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mandrifondrifoñe","poem":1},{"lineBreak":true},{"text":"o mena-pañosora’oo,","poem":1},{"lineBreak":true},{"text":"rano máñitse nailiñe ty tahina’o,","poem":1},{"lineBreak":true},{"text":"izay ty ikokoa’ o somondrarao azo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kozozoto iraho, antao halisa;","poem":1},{"lineBreak":true},{"text":"Nandese’ i mpanjakay mb’añ’efets’","poem":1},{"lineBreak":true},{"text":"efen’anjomba’e ao.","poem":1},"Rañe’eo",{"text":"Hañonjoñ’ azo zahay naho hirebeke, honjone’ay ambone’ ty hamañin-divay.","poem":1},{"lineBreak":true},{"text":"An-kahiti’e ty fikokoa’ iareo azo.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":5,"content":[{"text":"Mainte iraho, naho ginoke,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"manahake o kiboho’ i Kedareo,","poem":1},{"lineBreak":true},{"text":"hambañe amo lamba’ fañefe’ i Selomoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko mangarek’ ahy ami’ty hamaintelèñeko,","poem":1},{"lineBreak":true},{"text":"ie nisamb’ ahy i àndroy.","poem":1},{"lineBreak":true},{"text":"Niboseha’ o ana-dahin-drenekoo iraho,","poem":1},{"lineBreak":true},{"text":"nampañalahala’ iareo","poem":1},{"lineBreak":true},{"text":"o tanem-baheo,","poem":1},{"lineBreak":true},{"text":"vaho namoeako ka","poem":1},{"lineBreak":true},{"text":"i tanem-bahekoy!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Saontsio amako,","poem":1},{"lineBreak":true},{"text":"ry fikokoam-piaiko,","poem":1},{"lineBreak":true},{"text":"Aia ty fiandraza’o,","poem":1},{"lineBreak":true},{"text":"i fampandrea’ o an’tsingilingilieñey?","poem":1},{"lineBreak":true},{"text":"Amy te ino ty hitsikombeako ty mpisaron’ tarehe marine’ o lia-rain-drañe’oo?","poem":1}]},{"type":"heading","content":["Rañe’eo"]},{"type":"verse","number":8,"content":[{"text":"Aa naho tsy fohi’o,","poem":1},{"lineBreak":true},{"text":"ry hatsomerentseren’ampelao,","poem":1},{"lineBreak":true},{"text":"le tinoño ty lia’ i lia-raikey","poem":1},{"lineBreak":true},{"text":"vaho andrazo marine’ o kibohom-","poem":1},{"lineBreak":true},{"text":"piarakeo o vik’ose’oo.","poem":1}]},{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":9,"content":[{"text":"Ry kokoako, Ampanahafeko ami’ty renen-tsoavala amo sarete’ i Paròo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fanjaka o fifi’oo ty amo hangehangeo,","poem":1},{"lineBreak":true},{"text":"ty vozo’o miravake vatosoa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hitsenea’ay bangem-bolamena","poem":1},{"lineBreak":true},{"text":"nihamineñe volafoty.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":12,"content":[{"text":"Ie nandre an-tihi’e eo i mpanjakay,","poem":1},{"lineBreak":true},{"text":"ro nañakara’ i ramekoy i hañi’ey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hoe sandrifen-drame mandre añivo’","poem":1},{"lineBreak":true},{"text":"o nonokoo i kokoakoy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fitoborom-boñen-tseva","poem":1},{"lineBreak":true},{"text":"an-tanem-balobo’ i En-Gedy ao","poem":1},{"lineBreak":true},{"text":"i kokoakoy.","poem":1}]},{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":15,"content":[{"text":"Akore ty hamozohozo’o, o kokoakoo,","poem":1},{"lineBreak":true},{"text":"Hen! ty hatrenotreno’o;","poem":1},{"lineBreak":true},{"text":"deho o maso’oo.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":16,"content":[{"text":"Toe tsomerentseren-drehe kokoakoo, vata’e miehañe;","poem":1},{"lineBreak":true},{"text":"maindoñe ty fandrean-tikañe;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mendoraveñe o fahan-trañon-tikañeo,","poem":1},{"lineBreak":true},{"text":"akao o tapena’eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}