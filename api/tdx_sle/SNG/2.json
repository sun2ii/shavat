"poem":1},{"lineBreak":true},{"text":"le nampialofe’e ambanen’","poem":1},{"lineBreak":true},{"text":"alokalom-pikokoa’e ao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fahano zizimo","poem":1},{"noteId":1},{"text":"iraho,","poem":1},{"lineBreak":true},{"text":"ampanintsiño an-takoko,","poem":1},{"lineBreak":true},{"text":"fa nampitoiram-pikokoan-draho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iondanan-dohako ty fità’e havia,","poem":1},{"lineBreak":true},{"text":"mamelek’ ahy ty fitàn-kavana’e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Afantoko ama’ areo","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"ty amo farasio naho o tsakan-kivokeo;","poem":1},{"lineBreak":true},{"text":"ko tsekafe’ areo","poem":1},{"lineBreak":true},{"text":"ndra ampibarakaohe’ areo","poem":1},{"lineBreak":true},{"text":"o fikokoañeo am-para’ te irie’e!","poem":1}]},{"type":"heading","content":["Ambara’ t’i Mpikoko i Kokoa’ey,"]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":8,"content":[{"text":"Inao i kokoakoy!","poem":1},{"lineBreak":true},{"text":"Heheke, mb’ etoan-dre,","poem":1},{"lineBreak":true},{"text":"mitsamboatsamboañe amo vohitseo,","poem":1},{"lineBreak":true},{"text":"mbore vokone’e o tambohoo.","poem":1}]},{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":9,"content":[{"text":"Manahake o farasio ndra ty fanaloke tora’e i kokoakoy;","poem":1},{"lineBreak":true},{"text":"hehe t’ie mijohañe an-kalo’","poem":1},{"lineBreak":true},{"text":"o kijolin-tikañeo,","poem":1},{"lineBreak":true},{"text":"mitangirik’ amo lalan-kedeo,","poem":1},{"lineBreak":true},{"text":"mitilihitse amo tsingarakarakeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tinoi’ i kokoakoy iraho ami’ty hoe: Miongaha ry kokoako,","poem":1},{"lineBreak":true},{"text":"i hatsomerentserekoy, antao:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"fa nihak’ añe i asotriy,","poem":1},{"lineBreak":true},{"text":"fa tampetse i orañey, le añe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Misodeha an-tane ey o voñeo,","poem":1},{"lineBreak":true},{"text":"le fa totsake ty sam-pañetefañe,","poem":1},{"lineBreak":true},{"text":"vaho fa mivolañe an-tanen-tika atoy","poem":1},{"lineBreak":true},{"text":"i lovey.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fa somaraveñe o voa’ i sakoañeio,","poem":1},{"lineBreak":true},{"text":"naho mibotiboty iaby o vaheo,","poem":1},{"lineBreak":true},{"text":"vaho mampiboele o harifondrifo’eo;","poem":1},{"lineBreak":true},{"text":"miavota ry kokoako,","poem":1},{"lineBreak":true},{"text":"ry tsaratseake, misitaha mb’etoa.","poem":1}]},{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":14,"content":[{"text":"O dehoko, an-tseram-batoo:","poem":1},{"lineBreak":true},{"text":"an-tsifitsifi’ o tevañeo,","poem":1},{"lineBreak":true},{"text":"ee te ho treako ty tarehe’o,","poem":1},{"lineBreak":true},{"text":"lonike te hitsanoñe ty feo’o,","poem":1},{"lineBreak":true},{"text":"ry talango am-peo naho soa vintañeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tsepaho ho antika o fanalokeo,","poem":1},{"lineBreak":true},{"text":"o fanaloke bory mampianto","poem":1},{"lineBreak":true},{"text":"tanem-baheo,","poem":1},{"lineBreak":true},{"text":"fa mamòñe i tanem-bahen-tikañey.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":16,"content":[{"text":"Ahiko i kokoakoy, aze ka iraho:","poem":1},{"lineBreak":true},{"text":"ie mampiandrazeñe amo vindao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ampara’ te mitiotioke i àndroy","poem":1},{"lineBreak":true},{"text":"vaho misomarike o talinjoo, ry kokoako, mitoliha, tsik