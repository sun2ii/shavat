{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"SNG","translationId":"tdx_sle","name":"Sabo Talango’e","commonName":"Sabo Talango’e","title":"Sabo Talango’e","order":22,"numberOfChapters":8,"sha256":"8130167f6e526f9969069ad64729279c567198280900fdafec1251ba3d15186d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tdx_sle/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["Ipaia’ i Kokoa’e Haleñe"]},{"type":"verse","number":1,"content":[{"text":"Ie haleñe an-tihiko atoy,","poem":1},{"lineBreak":true},{"text":"nipaiako i kokoam’ piaikoy,","poem":1},{"lineBreak":true},{"text":"nisalala aze iraho fa tsy tendreke;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hitroatse henaneo","poem":1},{"lineBreak":true},{"text":"hikariokariok’ an-drova ao,","poem":1},{"lineBreak":true},{"text":"amo lala’eo naho an-kiririsa’e eo;","poem":1},{"lineBreak":true},{"text":"ho tsoeheko i kokoan’ aikoy.","poem":1},{"lineBreak":true},{"text":"Pinaiko fa tsy nitrea.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nizoe’ o mpañambeñeo iraho,","poem":1},{"lineBreak":true},{"text":"ie nañariofa’ iereo fisamba i rovay.","poem":1},{"lineBreak":true},{"text":"Nioni’ areo hao i kokoam-piaikoy?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ie vaho nihelañako,","poem":1},{"lineBreak":true},{"text":"le nitendrek’ amy kokoam-piaikoy;","poem":1},{"lineBreak":true},{"text":"nivihineko le tsy navotsoko ampara’ t’ie naseseko mb’añ’anjomban-dreneko mb’eo, mb’añ’efe’ i nampiareñ’ ahikoy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Afantoko ama’ areo","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"ty amo farasio ndra o fanaloke","poem":1},{"lineBreak":true},{"text":"an-kivokeo:","poem":1},{"lineBreak":true},{"text":"ko tsekafe’ areo ndra barakakaofe’ areo","poem":1},{"lineBreak":true},{"text":"o fikokoañeo ampara’ te irie’e.","poem":1}]},{"type":"heading","content":["Androm-Pañambaliañe Ty Fañotroñañe i Enga Vaoy"]},{"type":"verse","number":6,"content":[{"text":"Iam-bao o mionjo’ mb’etoa","poem":1},{"lineBreak":true},{"text":"hirik’am-patrambeio,","poem":1},{"lineBreak":true},{"text":"hoe hatoeñe mihorondemboke,","poem":1},{"lineBreak":true},{"text":"nembohe’ ty tsotse naho mañidè","poem":1},{"lineBreak":true},{"text":"vaho ze hene hamañim-bom-pibalibalike?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hehe t’ie i horantsa’ i Selomoy,","poem":1},{"lineBreak":true},{"text":"iaoloa’ ty fanalolahy enem-polo","poem":1},{"lineBreak":true},{"text":"amo lahitsiai’ Israeleo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Songa mpitam-pibara, vañoñ’añ’aly,","poem":1},{"lineBreak":true},{"text":"fonga ama-mesolava am-pe’e eo","poem":1},{"lineBreak":true},{"text":"ty amo fangebahebahan-kàleñeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nitsenè’ i Selomò ho aze","poem":1},{"lineBreak":true},{"text":"ty horantsa’e an-katae’ i Libanone.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nanoe’e volafoty o anakore’eo,","poem":1},{"lineBreak":true},{"text":"volamena i voho’ey,","poem":1},{"lineBreak":true},{"text":"malo-mavo i fiambesa’ey,","poem":1},{"lineBreak":true},{"text":"fikokoañe ty nihamina’ o anak’ ampela’ Ierosalaimeo ty añ’ate’e ao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mionjona, ry anak’ ampela’ i Tsioneo, sambao i Selomò mpanjaka misabaka","poem":1},{"lineBreak":true},{"text":"i nampisabakaen-drene’e","poem":1},{"lineBreak":true},{"text":"amy androm-pañengam-bali’eiy,","poem":1},{"lineBreak":true},{"text":"amy andro nahafale i arofo’eiy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}