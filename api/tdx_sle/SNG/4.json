{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"SNG","translationId":"tdx_sle","name":"Sabo Talango’e","commonName":"Sabo Talango’e","title":"Sabo Talango’e","order":22,"numberOfChapters":8,"sha256":"8130167f6e526f9969069ad64729279c567198280900fdafec1251ba3d15186d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tdx_sle/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":1,"content":[{"text":"Akore ty hahomozohozo’o,","poem":1},{"lineBreak":true},{"text":"ry kokoakoo, toe tsomerentsereñe;","poem":1},{"lineBreak":true},{"text":"deho am-boho’ o marerarera’oo","poem":1},{"lineBreak":true},{"text":"o fihaino’oo;","poem":1},{"lineBreak":true},{"text":"hoe lia-rain-ose mivovotse","poem":1},{"lineBreak":true},{"text":"am-pizotsoa’ i Gilade o maròi’oo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hoe ty rene’añondry hinitsike mitroatse","poem":1},{"lineBreak":true},{"text":"am-panasañe o famotsi’oo,","poem":1},{"lineBreak":true},{"text":"songa aman-drahamba’e,","poem":1},{"lineBreak":true},{"text":"leo raik’ ama’e tsy doñ-anake.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hoe fole-mena o fivimbi’oo","poem":1},{"lineBreak":true},{"text":"vaho fanjaka o falie’oo.","poem":1},{"lineBreak":true},{"text":"Hoe vakim-boan-draketamena roe","poem":1},{"lineBreak":true},{"text":"o fitendrean’ aoli’oo an-kalo","poem":1},{"lineBreak":true},{"text":"o marerarera’oo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manahake ty fitilik’abo’ i Davide","poem":1},{"lineBreak":true},{"text":"ty fititia’o, rinanjy am-bato miriritse,","poem":1},{"lineBreak":true},{"text":"iradoradoa’ ty fikalan-defoñe arivo,","poem":1},{"lineBreak":true},{"text":"songa fikalam-panalolahy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hoe fanaloke tora’e o fatroa’oo,","poem":1},{"lineBreak":true},{"text":"sarake hambañe mihota am-binda ao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ampara’ ty fanintsiñañ’ andro,","poem":1},{"lineBreak":true},{"text":"an-kalavaen-talinjo,","poem":1},{"lineBreak":true},{"text":"homb’am-bohin-tsotse mb’eo iraho,","poem":1},{"lineBreak":true},{"text":"mb’an-kaboan-drame mb’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solanto’e irehe, ry mami’ ty troko,","poem":1},{"lineBreak":true},{"text":"tsy aman-kila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mindreza lia amako","poem":1},{"lineBreak":true},{"text":"boake Libanone añe","poem":1},{"lineBreak":true},{"text":"ry enga-vaoko,","poem":1},{"lineBreak":true},{"text":"ehe itraofo hirike Libanone añe;","poem":1},{"lineBreak":true},{"text":"mizotsoa boak’an-dengo’ i Amane ey,","poem":1},{"lineBreak":true},{"text":"boak’an-kaboa’ i Senire,","poem":1},{"lineBreak":true},{"text":"an-digiligi’ i Kermone eñe,","poem":1},{"lineBreak":true},{"text":"boak’amo fipaliram-parasio,","poem":1},{"lineBreak":true},{"text":"o vohim-panalokeo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa tinava’o ty troko, ry rahavaveko,","poem":1},{"lineBreak":true},{"text":"enga-vaoko;","poem":1},{"lineBreak":true},{"text":"kinizo’o an-driom-paom-pihaino’o,","poem":1},{"lineBreak":true},{"text":"ami’ty bange’o raik’ am-pititia’o eo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fanjaka ty fikokoa’o,","poem":1},{"lineBreak":true},{"text":"rahavaveko, enga-vaoko!","poem":1},{"lineBreak":true},{"text":"loho soa te amo divaio ty fikokoa’o,","poem":1},{"lineBreak":true},{"text":"naho ty harifondrifon-drano mañi’o","poem":1},{"lineBreak":true},{"text":"te amy ze atao emboke!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mitsopatsopake","poem":1},{"lineBreak":true},{"text":"ty hamamim-papy tantele","poem":1},{"lineBreak":true},{"text":"o fivimbi’oo, ry enga-vaokoo,","poem":1},{"lineBreak":true},{"text":"habobo naho tantele","poem":1},{"lineBreak":true},{"text":"ty ambane’ famele’o ao.","poem":1},{"lineBreak":true},{"text":"Manahake ty harifondrifo’ i Libanone","poem":1},{"lineBreak":true},{"text":"ty hamañin-tsaro’o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Goloboñe mihily ty zaiko, enga-vaoko.","poem":1},{"lineBreak":true},{"text":"Loha rano mifahetse,","poem":1},{"lineBreak":true},{"text":"figoangoan-drano mikapeke.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Raketa miregorego soa","poem":1},{"lineBreak":true},{"text":"o hataen-golobo’oo,","poem":1},{"lineBreak":true},{"text":"naho voan-katae fanjaka,","poem":1},{"lineBreak":true},{"text":"mañi-dè mitrao-tseva:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Rame miharo ahemañitse,","poem":1},{"lineBreak":true},{"text":"hazomañitse naho somoroñe,","poem":1},{"lineBreak":true},{"text":"naho ze hene hatae marifondrifoñe,","poem":1},{"lineBreak":true},{"text":"mitraoke tsotse naho vahoñe","poem":1},{"lineBreak":true},{"text":"vaho ze atao hafiriañe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Rano migoangoañe","poem":1},{"lineBreak":true},{"text":"an-goloboñe ao irehe,","poem":1},{"lineBreak":true},{"text":"vovon-drano mamy mitsiritsioke","poem":1},{"lineBreak":true},{"text":"boake Libanone añe.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":16,"content":[{"text":"Mitsekafa ry avaratse, mb’etoy ry atimo! Tiofo i golobokoy,","poem":1},{"lineBreak":true},{"text":"hampiboeleañe o hamañi’eo.","poem":1},{"lineBreak":true},{"text":"Ee te hizilik’ an-golobo’e ao i kokoakoy hitsopeke o voa’e mafirio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}