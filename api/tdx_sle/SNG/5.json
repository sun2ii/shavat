{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"SNG","translationId":"tdx_sle","name":"Sabo Talango’e","commonName":"Sabo Talango’e","title":"Sabo Talango’e","order":22,"numberOfChapters":8,"sha256":"8130167f6e526f9969069ad64729279c567198280900fdafec1251ba3d15186d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tdx_sle/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":1,"content":[{"text":"Fa nimoak’ amy golobokoy iraho,","poem":1},{"lineBreak":true},{"text":"ry zaiko, enga-vaoko;","poem":1},{"lineBreak":true},{"text":"fa natontoko ty rameko","poem":1},{"lineBreak":true},{"text":"naho o mañi-dèkoo;","poem":1},{"lineBreak":true},{"text":"fa nihaneko ty papi-tanteleko","poem":1},{"lineBreak":true},{"text":"naho ty tanteleko;","poem":1},{"lineBreak":true},{"text":"fa ninomeko ty divaiko","poem":1},{"lineBreak":true},{"text":"naho ty rononoko.","poem":1},"Mpirañetse",{"text":"Mikamà, ry rañetseo, naho minoma;","poem":1},{"lineBreak":true},{"text":"minoma am-pidadañe, ry mpikokoo.","poem":1}]},{"type":"heading","content":["Ipaia’ i Kokoa’e Haleñe"]},{"type":"verse","number":2,"content":[{"text":"Niroro iraho fe nañente ty troko.","poem":1},{"lineBreak":true},{"text":"Inay! Mañonkòñe i kokoakoy:","poem":1},{"lineBreak":true},{"text":"Sokafo iraho ry zaiko, mami’ty fiaiko,","poem":1},{"lineBreak":true},{"text":"ty dehoko, ginoke tsy aman-kila.","poem":1},{"lineBreak":true},{"text":"Kotsa’ ty zono ty lohako,","poem":1},{"lineBreak":true},{"text":"ty voloko ami’ty hamandoa’ i haleñey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa nafahako ty saroko—","poem":1},{"lineBreak":true},{"text":"mbe haombeko hao?","poem":1},{"lineBreak":true},{"text":"Fa sinasako o tombokoo—","poem":1},{"lineBreak":true},{"text":"mbe ho lotoeko hao?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nazili’ i kokoakoy ami’ty hiri’","poem":1},{"lineBreak":true},{"text":"i sikadañey ty fità’e;","poem":1},{"lineBreak":true},{"text":"vaho nampiponaponake o añ’ovako ao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niongake iraho hanokàfako i kokoakoy,","poem":1},{"lineBreak":true},{"text":"nitsopatsopake rame o tañakoo,","poem":1},{"lineBreak":true},{"text":"rame mitsiritsioke o rambo-tañakoo,","poem":1},{"lineBreak":true},{"text":"amo fitanañ’ i sikadañeio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nisokafeko i kokoakoy,","poem":1},{"lineBreak":true},{"text":"fe nitolik’ ane i kokoakoy, fa nienga;","poem":1},{"lineBreak":true},{"text":"toe nilesa ty troko amy saontsi’ey;","poem":1},{"lineBreak":true},{"text":"pinaiko fe tsy nahatrea,","poem":1},{"lineBreak":true},{"text":"kinoiko fe tsy nanoiñe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nitendrek’ ahy o mpigaritseo,","poem":1},{"lineBreak":true},{"text":"ie nañariofe’ iereo i rovay;","poem":1},{"lineBreak":true},{"text":"linafa’ iereo, vinonotrobo’ iereo;","poem":1},{"lineBreak":true},{"text":"tinava’ o mpigari-kijolio i sarokoy!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ry anak’ ampela’ Ierosalaimeo,","poem":1},{"lineBreak":true},{"text":"ifantako, naho isa’ areo i kokoakoy,","poem":1},{"lineBreak":true},{"text":"ino ty hisaontsia’ areo?","poem":1},{"lineBreak":true},{"text":"Izaho toiram-pikokoañe.","poem":1}]},{"type":"heading","content":["Rañe’eo"]},{"type":"verse","number":9,"content":[{"text":"Mpikoko manao akore i mpikoko azoy,","poem":1},{"lineBreak":true},{"text":"ry hatrenotrenon’ ampelao?","poem":1},{"lineBreak":true},{"text":"Mpikoko manao akore i mpikoko azoy,","poem":1},{"lineBreak":true},{"text":"ie namantok’ anay.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":10,"content":[{"text":"Miloeloe i kokoakoy","poem":1},{"lineBreak":true},{"text":"mbore volovoloeñe,","poem":1},{"lineBreak":true},{"text":"miambak’ ami’ty alen-dahy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Volamena hiringiri’e ty añambone’e;","poem":1},{"lineBreak":true},{"text":"mitaporetaporetse o maroi’eo,","poem":1},{"lineBreak":true},{"text":"hamaintem-bolon-drelove.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hoe deho añ’olon-torahañe eo","poem":1},{"lineBreak":true},{"text":"o fihaino’eo,","poem":1},{"lineBreak":true},{"text":"sinasa an-dronono,","poem":1},{"lineBreak":true},{"text":"soa fimoneñe am-pitoboha’eo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hoe tihin-ahemañitse,","poem":1},{"lineBreak":true},{"text":"kijolin-kamañirañe, o fiambina’eo;","poem":1},{"lineBreak":true},{"text":"vinda mitsopake rame o soñi’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bodam-bolamena o fità’eo,","poem":1},{"lineBreak":true},{"text":"ibangoan’","poem":1},{"noteId":2},{"text":"tarsise,","poem":1},{"lineBreak":true},{"text":"hoe te nifen-drimo nivàñeñe, niravahañe safira ty fañòva’e.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bodan-tsinihara nandreketam-bolamena ki’e o fandia’eo.","poem":1},{"lineBreak":true},{"text":"Manahak’ i Libanone ty vinta’e, ami’ ty hasoa’ o mendorave’eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Loho mamy ty falie’e;","poem":1},{"lineBreak":true},{"text":"vata’e mahasinda;","poem":1},{"lineBreak":true},{"text":"ie i kokoakoy naho i rañekoy,","poem":1},{"lineBreak":true},{"text":"ry anak’ampela’ Ierosalaimeo.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Tarsise: beryle: vato soa","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/tdx_sle/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}