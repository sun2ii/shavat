{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"SNG","translationId":"tdx_sle","name":"Sabo Talango’e","commonName":"Sabo Talango’e","title":"Sabo Talango’e","order":22,"numberOfChapters":8,"sha256":"8130167f6e526f9969069ad64729279c567198280900fdafec1251ba3d15186d","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tdx_sle/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["Rañe’eo"]},{"type":"verse","number":1,"content":[{"text":"Nimb’aia i kokoa’oy,","poem":1},{"lineBreak":true},{"text":"ry maintelèn’ampelao?","poem":1},{"lineBreak":true},{"text":"Nitsile mb’aia i kokoa’oy,","poem":1},{"lineBreak":true},{"text":"hindreza’ay fipay?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nizotso mb’an-golobo’e mb’eo","poem":1},{"lineBreak":true},{"text":"i kokoakoy,","poem":1},{"lineBreak":true},{"text":"mb’am-pilafiham-pahafiriañe mb’eo, hiarake an-golobo’e ao,","poem":1},{"lineBreak":true},{"text":"naho hanontoñe o voñem-bindao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A i kokoakoy iraho, vaho ahiko re,","poem":1},{"lineBreak":true},{"text":"ie miarak’ am-baremañitse ao.","poem":1}]},{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":4,"content":[{"text":"Hamotsontane irehe, kokoako,","poem":1},{"lineBreak":true},{"text":"manahak’ i Tirzà,","poem":1},{"lineBreak":true},{"text":"naho ty hasoa’ Ierosalaime,","poem":1},{"lineBreak":true},{"text":"amam-bolonahetse hoe lahialen-defoñe","poem":1},{"lineBreak":true},{"text":"mañonjom-borovoro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Atoliho mb’eo hoekeo o maso’oo,","poem":1},{"lineBreak":true},{"text":"fa mampivalitaboak’ ahy; manahake ty lia-rain’ose mikararake mañambane i Gilade mb’eo o volo’oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lia-rain’ añondri-vave mionjoñe boak’ ampanasañe ao o nife’oo,","poem":1},{"lineBreak":true},{"text":"songa reke-pihambañe,","poem":1},{"lineBreak":true},{"text":"ndra raike tsy jeña.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hoe vakim-boan-draketamena","poem":1},{"lineBreak":true},{"text":"ty fitendrean’ aoli’o","poem":1},{"lineBreak":true},{"text":"an-kalo’ o marerarera’oo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mete ho enempolo ty valim-panjaka,","poem":1},{"lineBreak":true},{"text":"naho valompolo o sakeza’eo","poem":1},{"lineBreak":true},{"text":"vaho somondrara tsy fotofoto;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"fa ihe ry dehoko, ry homozohozo’e,","poem":1},{"lineBreak":true},{"text":"tsy amañ’ohatse, bako tokan-drene’e,","poem":1},{"lineBreak":true},{"text":"mitoratsik’ amy nisamak’ azey.","poem":1},{"lineBreak":true},{"text":"Ie nizoe’ o somondrarao","poem":1},{"lineBreak":true},{"text":"le natao’ iareo soa-tata,","poem":1},{"lineBreak":true},{"text":"nandrenge aze ka o valim-panjakao","poem":1},{"lineBreak":true},{"text":"naho o sakezao.","poem":1}]},{"type":"heading","content":["Rañe’eo"]},{"type":"verse","number":10,"content":[{"text":"Ia o miboake hoe t’ie andro manjirikeo? motsotsore","poem":1},{"lineBreak":true},{"text":"hoe i volan-dorisay,","poem":1},{"lineBreak":true},{"text":"mikotritriake hoe i àndroy,","poem":1},{"lineBreak":true},{"text":"mahalatsa hoe valobohòke","poem":1},{"lineBreak":true},{"text":"mirañoraño an-kobaiñe?","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":11,"content":[{"text":"Nizotso mb’añ’ala-vondron-tsakoa","poem":1},{"lineBreak":true},{"text":"mb’eo raho","poem":1},{"lineBreak":true},{"text":"hisary o fitirim-bao am-bavataneo,","poem":1},{"lineBreak":true},{"text":"hañenteako ke mibotiboty o vaheo,","poem":1},{"lineBreak":true},{"text":"he mamòñe o raketao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niambovo amako te","poem":1},{"lineBreak":true},{"text":"navotra’ ty troko an-tsarete ao,","poem":1},{"lineBreak":true},{"text":"hehe te añ’ilako eo ty roandria.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}