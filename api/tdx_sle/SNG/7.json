"lineBreak":true},{"text":"am-pivimbim-pirotse.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":11,"content":[{"text":"A i kokoakoy raho","poem":1},{"lineBreak":true},{"text":"naho amako ty fañiria’e.","poem":1}]},{"type":"heading","content":["Ambara’ i Kokoa’e t’i Mpikoko"]},{"type":"verse","number":12,"content":[{"text":"Antao, kokoako, homb’ an-kaloke","poem":1},{"lineBreak":true},{"text":"mb’eo, hialeñe amo kialoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Antao hañaleñaleñe","poem":1},{"lineBreak":true},{"text":"mb’an-tanem-bahe mb’eo","poem":1},{"lineBreak":true},{"text":"handrèndreke ty fibotibotia’ o vaheo,","poem":1},{"lineBreak":true},{"text":"ke te miborake o voñe’eo,","poem":1},{"lineBreak":true},{"text":"hera mamolera o raketao;","poem":1},{"lineBreak":true},{"text":"ao ty hanjotsoako ama’o ty hateako,","poem":1},{"lineBreak":true},{"text":"ry kokoako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mañakatse ty hañi’e o vahenamaloo,","poem":1},{"lineBreak":true},{"text":"hene raha mafiry ty an-tsariran-tikañe eo,","poem":1},{"lineBreak":true},{"text":"ty vao naho ty haehae,","poem":1},{"lineBreak":true},{"text":"songa nahajako ho azo, ry kokoako.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Mahanaime: toben-dahindefoñe, he mpitsinjake","reference":{"chapter":7,"verse":1}}]},"thisChapterLink":"/api/tdx_sle/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":14}