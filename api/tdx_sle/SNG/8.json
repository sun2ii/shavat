er":9,"content":[{"lineBreak":true},{"text":"Naho kijoly re le handranjia’ay","poem":1},{"lineBreak":true},{"text":"fitilik’abo volafoty;","poem":1},{"lineBreak":true},{"text":"ie lalambey, le harikatoha’ay","poem":1},{"lineBreak":true},{"text":"varamba-mendoraveñe.","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":10,"content":[{"text":"Kijoly iraho,","poem":1},{"lineBreak":true},{"text":"hoe fitilik’abo o nonokoo;","poem":1},{"lineBreak":true},{"text":"hoe t’ie minday fañanintsiñe","poem":1},{"lineBreak":true},{"text":"am-pihaino.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nanan-tondam-bahe","poem":1},{"lineBreak":true},{"text":"e Baale-Kamone ao t’i Selomò;","poem":1},{"lineBreak":true},{"text":"nafondro’e ama’ ondaty.","poem":1},{"lineBreak":true},{"text":"Songa mañondroke volafoty arivo","poem":1},{"lineBreak":true},{"text":"ama’e ty amo voka’eo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aoloko eo i tanem-bahekoy,","poem":1},{"lineBreak":true},{"text":"azo ry Selomò i arivoy,","poem":1},{"lineBreak":true},{"text":"roan-jato ty a o mpañalahala","poem":1},{"lineBreak":true},{"text":"i voka’eio.","poem":1}]},{"type":"heading","content":["Mpikoko"]},{"type":"verse","number":13,"content":[{"text":"O ry mpimoneñe an-goloboñe ao,","poem":1},{"lineBreak":true},{"text":"te hijanjiñe ty fiarañanaña’o","poem":1},{"lineBreak":true},{"text":"o mpiamakoo,","poem":1},{"lineBreak":true},{"text":"ehe ampitsanoño ahy!","poem":1}]},{"type":"heading","content":["Kokoa’e"]},{"type":"verse","number":14,"content":[{"text":"Mipitsiha ry kokoakoo,","poem":1},{"lineBreak":true},{"text":"manahake o fanalokeo naho o farasy","poem":1},{"lineBreak":true},{"text":"ambone vohitse iregoregoan-kafirio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ISA/1.json","nextChapterAudioLinks":{},"previousChapterAp