{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ZEC","translationId":"tdx_sle","name":"Zekarià","commonName":"Zekarià","title":"Zekarià","order":38,"numberOfChapters":14,"sha256":"93622c60181098548e467beaa9698c4180a05fc30b5191ae64a0fd9cf5efb18e","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Ihalalio orañe am’ Iehovà,","poem":1},{"lineBreak":true},{"text":"oran-doha-taoñe am’ Iehovà mpitsene i helatsey;","poem":1},{"lineBreak":true},{"text":"vaho hampikojojoaha’e orañe,","poem":1},{"lineBreak":true},{"text":"fonga ondaty ty amo mitiry an-tete’eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa mikora aman-tahiñe o ambiasao,","poem":1},{"lineBreak":true},{"text":"naho mahaonim-bande o mpisikilio,","poem":1},{"lineBreak":true},{"text":"mivolam-bìlañe ka o nofio,","poem":1},{"lineBreak":true},{"text":"tsy jefa’e ty fañohò’ iareo;","poem":1},{"lineBreak":true},{"text":"aa le mirererere hoe añondry iereo,","poem":1},{"lineBreak":true},{"text":"misotry fa tsy amam-piarake","poem":1},{"noteId":32},{"text":".","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Misolebotse amo mpiarakeo","poem":1},{"lineBreak":true},{"text":"ty habosehako, le ho liloveko o ose-lahio;","poem":1},{"lineBreak":true},{"text":"fa tiahi’ Iehovà’ i Màroy i lia-rai’ey,","poem":1},{"lineBreak":true},{"text":"i anjomba’ Iehoday","poem":1},{"lineBreak":true},{"text":"ie hanoe’e hoe soavalam-bolonahe’e","poem":1},{"lineBreak":true},{"text":"an-kotakotak’ ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boak’am’ iareo ty vato-lahy,","poem":1},{"lineBreak":true},{"text":"hirik’am’ iereo ty fantake,","poem":1},{"lineBreak":true},{"text":"boak’am’ iereo ty falen-kotakotake,","poem":1},{"lineBreak":true},{"text":"vaho hirik’am’ iereo ao ze mpameleke—hiharo","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"hoe fanalolahy iereo, ho lialia’ iereo am-potak’ an-dalañe ao t’ie mihotakotake naho mifandraparapake,","poem":1},{"lineBreak":true},{"text":"fa mindre am’ iereo t’Iehovà vaho","poem":1},{"lineBreak":true},{"text":"hifandrakaraka o mpiningi-tsoavalao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hampaozareko ty anjomba’ Iehodà,","poem":1},{"lineBreak":true},{"text":"naho ho rombaheko ty anjomba’ Iosefe, hampoliko fa iferenaiñako,","poem":1},{"lineBreak":true},{"text":"vaho hanahake t’ie tsy nahifiko añe, amy te izaho Iehovà t’i Andrianañahare’ iareo, le ho toiñeko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hanahake ondaty manjofakeo t’i Efraime, le hirebeke ty arofo’ iareo hoe an-divay; Eka hahaisake izay o ana’eo","poem":1},{"lineBreak":true},{"text":"vaho handia-taroba,","poem":1},{"lineBreak":true},{"text":"hifale am’ Iehovà ty arofo’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ho tsikaoreko, naho hatontoko, amy t’ie nijebañeko, ie hitombo ho mira ami’ty hamaro’e taolo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ie aparatsiako amo fifeheañeo,","poem":1},{"lineBreak":true},{"text":"le hahatiahy ahy an-tsietoitane añe;","poem":1},{"lineBreak":true},{"text":"naho ho veloñe iereo naho o ana’ iareoo,","poem":1},{"lineBreak":true},{"text":"vaho himpoly.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hampoliko boak’an-tane Mitsraime, naho hatontoko boak’ Asore añe;","poem":1},{"lineBreak":true},{"text":"vaho hendeseko mb’an-tane Gilade","poem":1},{"lineBreak":true},{"text":"naho mb’e Libanone mb’eo;","poem":1},{"lineBreak":true},{"text":"ampara’ te tsy tsahatse i toetsey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ho sorohe’e i ria-kaloviloviañey,","poem":1},{"lineBreak":true},{"text":"ho fofohe’e o onjan-driakeo,","poem":1},{"lineBreak":true},{"text":"le ho maike o godobo’ i sakaio,","poem":1},{"lineBreak":true},{"text":"naho hafotsake ty enge’ i Asore","poem":1},{"lineBreak":true},{"text":"vaho hipitsok’ añe ty kobai’ i Mitsraime.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hampaozareko am’ Iehovà iereo vaho i tahina’ey ty hidraidraita’ iareo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Iek 34:5,8","reference":{"chapter":10,"verse":2}}]},"thisChapterLink":"/api/tdx_sle/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}