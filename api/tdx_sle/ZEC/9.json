{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ZEC","translationId":"tdx_sle","name":"Zekarià","commonName":"Zekarià","title":"Zekarià","order":38,"numberOfChapters":14,"sha256":"93622c60181098548e467beaa9698c4180a05fc30b5191ae64a0fd9cf5efb18e","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tdx_sle/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Fetse; miatrek’ an-tane’ i Hadrake","poem":1},{"noteId":23},{"text":"mpitofa e Damesèke, ty tsara’ Iehovà;","poem":1},{"lineBreak":true},{"text":"(mitolik’ am’ Iehovà ty fihaino’ ondatio","poem":1},{"lineBreak":true},{"text":"naho ze hene’ fifokoa’Israele;)","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"naho amy Kamate mpiefetse ama’ey;","poem":1},{"lineBreak":true},{"text":"naho amy Tsore","poem":1},{"noteId":24},{"lineBreak":true},{"text":"vaho amy Tsidone","poem":1},{"noteId":25},{"text":",","poem":1},{"lineBreak":true},{"text":"amy t’ie mahihitse.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toe namboatse rova fatratse t’i Tsore","poem":1},{"lineBreak":true},{"text":"le nampitoabotse volafoty hoe deboke naho volamena ki’e hoe fotak’ an-damoke.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inao t’ie hampikoahe’ i Talè, havatambia’e mb’ an-driak’ añe ty haozara’e; vaho ho forototoe’ ty afo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hahaisake zay ty Askelone","poem":1},{"noteId":26},{"lineBreak":true},{"text":"vaho hiria-kolitse,","poem":1},{"lineBreak":true},{"text":"hangirifiry ka t’i Azà","poem":1},{"noteId":27},{"text":",","poem":1},{"lineBreak":true},{"text":"naho i Ekrone","poem":1},{"noteId":28},{"text":"ty amy fitamà’e nilesay;","poem":1},{"lineBreak":true},{"text":"hihomake ty mpanjaka’ i Azà le tsy ho amam-pimoneñe ty Askelone.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anak’ amontoñe ty hitoboke e Ashdode","poem":1},{"noteId":29},{"text":", vaho haitoako ty fisengea’ o nte-Pilistio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hafahako am-bava’e ao ty lio’e","poem":1},{"lineBreak":true},{"text":"naho an-tsifim-pamotsi’e ao","poem":1},{"lineBreak":true},{"text":"o raha mampangorìñeo;","poem":1},{"lineBreak":true},{"text":"fa o sehanga’eo ty ho an’ Andrianañaharen-tika,","poem":1},{"lineBreak":true},{"text":"ie ty hanoeñe mpiaolo e Iehodà ao,","poem":1},{"lineBreak":true},{"text":"vaho hanahake ty nte-Iebose","poem":1},{"noteId":30},{"text":"t’i Ekrone.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hitobe am-­piarikatoha’ i kivohokoy raho","poem":1},{"lineBreak":true},{"text":"ty amo lahindefoñeo,","poem":1},{"lineBreak":true},{"text":"ty amy miary eo naho mibalike","poem":1},{"lineBreak":true},{"text":"vaho tsy hisoroha’ ty mpamorekeke ka, fa ho jilove’ o masokoo henane zao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mandià taroba ry anak’ampela’ i Tsione, mipoñafa ry anak’ ampela’ Ierosalaime;","poem":1},{"lineBreak":true},{"text":"Hehe te mitotsak’ ama’o ty Mpanjaka’o, Vantan-dre, reketse fandrombahañe,","poem":1},{"lineBreak":true},{"text":"mirèke, mi­ningitse borìke,","poem":1},{"lineBreak":true},{"text":"ambone’ ty fola-bao,","poem":1},{"lineBreak":true},{"text":"ana’ty borìke vave’e","poem":1},{"noteId":31},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Le hapitsoko amy Efraime ty sarete,","poem":1},{"lineBreak":true},{"text":"naho am’ Iero­salaime ty soavala,","poem":1},{"lineBreak":true},{"text":"naho ho pozaheko o fàlen-kotakotakeo;","poem":1},{"lineBreak":true},{"text":"ie hitsara fampilongoañe","poem":1},{"lineBreak":true},{"text":"amo kilakila’ ondatio,","poem":1},{"lineBreak":true},{"text":"vaho hitakatse an-driake ey","poem":1},{"lineBreak":true},{"text":"pak’ an-driak’ añe i fifehea’ey,","poem":1},{"lineBreak":true},{"text":"naho boak’amy Sakay añe","poem":1},{"lineBreak":true},{"text":"pak’ añ’ olo-ty tane toy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Le ihe, ty amy lio’ i fañina ama’oiy, hampiavoteko boak’ an-koboñe","poem":1},{"lineBreak":true},{"text":"tsy aman-drano ao","poem":1},{"lineBreak":true},{"text":"o azo an-drohio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mimpolia mb’an-drova fatratse mb’ eo,","poem":1},{"lineBreak":true},{"text":"ry mpirohy mitamàñeo;","poem":1},{"lineBreak":true},{"text":"anito ty ho koiheko te hondroheko","poem":1},{"lineBreak":true},{"text":"in-droe o azoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ampivohoreko hoe te faleko t’Iehodà,","poem":1},{"lineBreak":true},{"text":"atsafeko amy faley ty Efraime;","poem":1},{"lineBreak":true},{"text":"naho ho troboeko o ana’oo ry Tsione,","poem":1},{"lineBreak":true},{"text":"hatreatré’e o ana’oo ry Iavane,","poem":1},{"lineBreak":true},{"text":"ie hampanahafeko","poem":1},{"lineBreak":true},{"text":"amy fibaram-panalolahiy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ho oniñe ambone’ iereo eo t’Iehovà, naho hihiririñe hoe helatse i ana-pale’ey;","poem":1},{"lineBreak":true},{"text":"ho tiofe’ Iehovà, Talè i antsivay,","poem":1},{"lineBreak":true},{"text":"vaho hijoñe an-tangololahi’ i atimoy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ie harova’ Iehovà’ i Màroy;","poem":1},{"lineBreak":true},{"text":"le hampibotseke iereo","poem":1},{"lineBreak":true},{"text":"handialia o vato-piletseo;","poem":1},{"lineBreak":true},{"text":"hìnoñe iereo naho hiroharoha hoe an-divay; hatsafeñe hoe an-tsoakazo,","poem":1},{"lineBreak":true},{"text":"kotsa hoe an-kotso’ i kitreliy eo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Handrombake iareo amy andro zay t’Iehovà Andrianañahare’ iareo","poem":1},{"lineBreak":true},{"text":"ho lia-rai’ ondati’eo,","poem":1},{"lineBreak":true},{"text":"ho vatosoan-tsabaka’e,","poem":1},{"lineBreak":true},{"text":"mimilemiletse an-tane’e eo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Akore ty hafanjàka","poem":1},{"lineBreak":true},{"text":"naho hatsomerentsere’ iareo!","poem":1},{"lineBreak":true},{"text":"Hampiraorao o ajalahio ty ampemba","poem":1},{"lineBreak":true},{"text":"naho o somondrarao ty divai-vao.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Hadrake: lohan-defo; fale te tretreza’e","reference":{"chapter":9,"verse":1}},{"noteId":24,"caller":"+","text":"Tsore: Vato: haozarañe, masioñe","reference":{"chapter":9,"verse":2}},{"noteId":25,"caller":"+","text":"Tsidone: mitsatsà; mamintañe","reference":{"chapter":9,"verse":2}},{"noteId":26,"caller":"+","text":"Askelone: fikovovohañe am-pitaveañañe","reference":{"chapter":9,"verse":5}},{"noteId":27,"caller":"+","text":"Aaza: ty nihafatrarañe, maozatse","reference":{"chapter":9,"verse":5}},{"noteId":28,"caller":"+","text":"Ekrone: nombotañe reke-bahatse","reference":{"chapter":9,"verse":5}},{"noteId":29,"caller":"+","text":"Asdone: fipalirañe fatratse","reference":{"chapter":9,"verse":6}},{"noteId":30,"caller":"+","text":"Iebose: toe-pamofohañe","reference":{"chapter":9,"verse":7}},{"noteId":31,"caller":"+","text":"Mat 21:5, Jao 12:15","reference":{"chapter":9,"verse":9}}]},"thisChapterLink":"/api/tdx_sle/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}