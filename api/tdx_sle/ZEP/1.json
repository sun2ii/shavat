{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ZEP","translationId":"tdx_sle","name":"Tsefanià","commonName":"Tsefanià","title":"Tsefanià","order":36,"numberOfChapters":3,"sha256":"97187edf92ce2b19aa4af15742b85825cecc663b856c0149b5cbd9efaae7797a","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Niheo amy Tsefanià",{"noteId":0},"ana’ i Kosý ana’ i Gedalià",{"noteId":1},"ana’ i Amarià",{"noteId":2},", ana’ i Kizkià",{"noteId":3},"faha’ Iosià",{"noteId":4},"ana’ i Amone, mpanjaka’ Iehoda ty tsara’ Iehovà:"]},{"type":"verse","number":2,"content":[{"text":"Toe ho faopaoheko ami’ty tarehe’","poem":1},{"lineBreak":true},{"text":"ty tane toy ze he’e, hoe t’Iehovà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ho mongoreko ondatio naho o bibio;","poem":1},{"lineBreak":true},{"text":"ho fongoreko o voron-dindìñeo,","poem":1},{"lineBreak":true},{"text":"naho o fian-driakeo,","poem":1},{"lineBreak":true},{"text":"naho o vato mahatsikapio","poem":1},{"lineBreak":true},{"text":"mindre amo lo-tserekeo;","poem":1},{"lineBreak":true},{"text":"vaho haitoako an-tane atoy ondatio,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hatora-kitsiko ty tañako, am’ Iehoda naho","poem":1},{"lineBreak":true},{"text":"amo hene ondaty e Ierosalaimeo;","poem":1},{"lineBreak":true},{"text":"le haitoako ami’ty toetse toy","poem":1},{"lineBreak":true},{"text":"ty sisa’ i Baale,","poem":1},{"lineBreak":true},{"text":"naho ty tahina’ o mpisorom-","poem":1},{"lineBreak":true},{"text":"pahasiveo rekets’ o mpisoro’eo;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"o mitalaho amy fifamorohotan-dindiñey an-tafo’eoo;","poem":1},{"lineBreak":true},{"text":"o mitalaho naho mifanta am’ Iehovà vaho mifanta amy Malkameo","poem":1},{"noteId":5},{"text":";","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"o mitolike tsy mañorike Iehovào;","poem":1},{"lineBreak":true},{"text":"naho o tsy mipay Iehovà","poem":1},{"lineBreak":true},{"text":"vaho tsy mihalaly ama’eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mianjiña am-piatrefa’ Iehovà, Talè;","poem":1},{"lineBreak":true},{"text":"fa antitotse ty andro’ Iehovà,","poem":1},{"lineBreak":true},{"text":"fa nihentseñe fisoroñañe","poem":1},{"lineBreak":true},{"text":"jabajaba t’Iehovà,","poem":1},{"lineBreak":true},{"text":"vaho hene tinendre’e o hambarà’eo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa ie tondroke ty androm-pisoroña’","poem":1},{"lineBreak":true},{"text":"Iehovà, le ho liloveko o roandriañeo,","poem":1},{"lineBreak":true},{"text":"naho o ana-donakeo, vaho ze ondaty","poem":1},{"lineBreak":true},{"text":"misikin-damban’ambahiny iaby.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amy andro zay ka, le ho fonga lafaeko","poem":1},{"lineBreak":true},{"text":"o mitsamboan-tokonañe","poem":1},{"lineBreak":true},{"text":"naho mampikobake ty anjomban-","poem":1},{"lineBreak":true},{"text":"talè’e am-pikatramoañe","poem":1},{"lineBreak":true},{"text":"vaho am-pamañahiañeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, hoe t’Iehovà:","poem":1},{"lineBreak":true},{"text":"Inay ty kaikaike boak’an-dalam-beim-pìañe ao,","poem":1},{"lineBreak":true},{"text":"naho ty fangololoihañe","poem":1},{"lineBreak":true},{"text":"amy efetse faharoey;","poem":1},{"lineBreak":true},{"text":"vaho fandrihindrihiñañe am-bohitse ey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mangoihoìa ry mpimone’ i Maktese","poem":1},{"noteId":6},{"text":",","poem":1},{"lineBreak":true},{"text":"fa mibalake iaby o mpanao balikeo,","poem":1},{"lineBreak":true},{"text":"fa naito iaby o nirago­rago volafotio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ie amy andro zay, le ho kodebèko","poem":1},{"lineBreak":true},{"text":"am-pailo t’Ierosalaime;","poem":1},{"lineBreak":true},{"text":"le ho liloveko ondaty miagarègañeo,","poem":1},{"lineBreak":true},{"text":"ie manao ty hoe:","poem":1},{"lineBreak":true},{"text":"Tsy hanao soa t’Iehovà,","poem":1},{"lineBreak":true},{"text":"mbore tsy hanao raty.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le ho kopaheñe o vara’eo,","poem":1},{"lineBreak":true},{"text":"naho hangoakoake o akiba’eo;","poem":1},{"lineBreak":true},{"text":"eka, handrafetse anjomba iereo","poem":1},{"lineBreak":true},{"text":"fe tsy himoneña’e,","poem":1},{"lineBreak":true},{"text":"hambole tanem-bahe","poem":1},{"lineBreak":true},{"text":"f’ie tsy hinoñe amy divai’e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Toe an-titotse ty andro","poem":1},{"lineBreak":true},{"text":"ra’elahi’ Iehovà,","poem":1},{"lineBreak":true},{"text":"mitotoke vaho mihitrike,","poem":1},{"lineBreak":true},{"text":"ty feo mafaitse ty andro’ Iehovà,","poem":1},{"lineBreak":true},{"text":"ty hampangoihoy i fanalolahiy.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Andron-kaviñerañe i andro zay,","poem":1},{"lineBreak":true},{"text":"andro kankàñe naho faloviloviañe,","poem":1},{"lineBreak":true},{"text":"andro famaopaohañe","poem":1},{"lineBreak":true},{"text":"naho fampikoahañe,","poem":1},{"lineBreak":true},{"text":"andron-kamoromoroñañe","poem":1},{"lineBreak":true},{"text":"naho migoboñe, andro milodolodo","poem":1},{"lineBreak":true},{"text":"vaho ieñe mangeoñe,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Andro’ i antsivay naho ty hazolava,","poem":1},{"lineBreak":true},{"text":"amo rova fatratseo","poem":1},{"lineBreak":true},{"text":"naho amo fijilovañ’ aboo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hampalovilovieko ondatio,","poem":1},{"lineBreak":true},{"text":"hijimenjimeña’e hoe goa,","poem":1},{"lineBreak":true},{"text":"amy te nandilatse am’ Iehovà;","poem":1},{"lineBreak":true},{"text":"hikararàke hoe deboke ty lio’ iareo,","poem":1},{"lineBreak":true},{"text":"naho hoe forompotse o nofo’eo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tsy haharombake iareo","poem":1},{"lineBreak":true},{"text":"ty volafoti’ iareo ndra ty volamena,","poem":1},{"lineBreak":true},{"text":"amy andron-kaviñera’ Iehovày,","poem":1},{"lineBreak":true},{"text":"fonga ho forototoe’ ty afom-pamarahia’e","poem":1},{"lineBreak":true},{"text":"ty tane toy;","poem":1},{"lineBreak":true},{"text":"toe hampijadoñe’e figadoñañe,","poem":1},{"lineBreak":true},{"text":"eka, figadoñan-kankàñe,","poem":1},{"lineBreak":true},{"text":"amo mpimoneñe an-tane atoio.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Tsefanià: Iehovà ro fitsolohako","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Gedalià: I Andrianañahare ro engeko","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"Amarià: hoe t’Iehovà; havañona’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"Kizkià: haozara’ Iehovà","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"+","text":"Iosià: ty afo’ Iehovà; ty fampijangaña’e","reference":{"chapter":1,"verse":1}},{"noteId":5,"caller":"+","text":"Malkame: ty samposampo’ o nte-Amoneo","reference":{"chapter":1,"verse":5}},{"noteId":6,"caller":"+","text":"Maktese: leoñe; goledoñe laleke","reference":{"chapter":1,"verse":11}}]},"thisChapterLink":"/api/tdx_sle/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}