{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ZEP","translationId":"tdx_sle","name":"Tsefanià","commonName":"Tsefanià","title":"Tsefanià","order":36,"numberOfChapters":3,"sha256":"97187edf92ce2b19aa4af15742b85825cecc663b856c0149b5cbd9efaae7797a","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mitontòna, Eka, mitontòna","poem":1},{"lineBreak":true},{"text":"ry fifeheañe tsy aman-kenatseo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ie mbe tsy mifetsake i zakay,","poem":1},{"lineBreak":true},{"text":"ie mihelañe hoe kafo’e i àndroy,","poem":1},{"lineBreak":true},{"text":"aolo’ te mivovo ama’ areo","poem":1},{"lineBreak":true},{"text":"i haviñerañe miforoforo’ Iehovày,","poem":1},{"lineBreak":true},{"text":"aolo’ te tojeha ama’o","poem":1},{"lineBreak":true},{"text":"ty andron-kaviñera’ Iehovà,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsoeho t’Iehovà, ry mpirèk’ an-tane atoio, ry mpañorike o lili’eo;","poem":1},{"lineBreak":true},{"text":"paiao ty havantañañe,","poem":1},{"lineBreak":true},{"text":"kodebeo ty firèham-batañe,","poem":1},{"lineBreak":true},{"text":"hera hampipalireñe","poem":1},{"lineBreak":true},{"text":"amy andron-kaviñera’ Iehovày.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa haforintseñe ty Azà,","poem":1},{"lineBreak":true},{"text":"naho hangoakoake t’i Askelone,","poem":1},{"lineBreak":true},{"text":"ho roaheñe an-tsipinde t’i Asdode,","poem":1},{"lineBreak":true},{"text":"vaho hombotañe t’i Ekrone.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hankàñe amo mpimoneñe","poem":1},{"lineBreak":true},{"text":"añ’olon-driak’ añeo, o nte-Kereteo,","poem":1},{"lineBreak":true},{"text":"fa atreatre’ ty tsara’ Iehovà;","poem":1},{"lineBreak":true},{"text":"ry Kanàne, tane’ o nte-Pilistio,","poem":1},{"lineBreak":true},{"text":"ie harotsako tsy ho amam-pimoneñe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le ho fiandrazañe, mioboñoboñe ho amo piarakeo,","poem":1},{"lineBreak":true},{"text":"naho golobon’añondry, i añ’olon-driakey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ho a i sehangan’anjomba’ Iakobey","poem":1},{"lineBreak":true},{"text":"i olotsey, ie handrazeñe ama’e,","poem":1},{"lineBreak":true},{"text":"naho hirotse an-kiboho’ i Askelone","poem":1},{"lineBreak":true},{"text":"te haleñe;","poem":1},{"lineBreak":true},{"text":"fa hitilike iareo t’Iehovà Andrianañahare’ iareo,","poem":1},{"lineBreak":true},{"text":"vaho hampoli’e ty fandrohiza’ iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fa tsinanoko ty ìnje’ i Moabe,","poem":1},{"lineBreak":true},{"text":"naho ty natì’ o ana’ i Amoneo,","poem":1},{"lineBreak":true},{"text":"ie nañamavo ondatikoo,","poem":1},{"lineBreak":true},{"text":"naho niebotsebotse te nitare’ iareo","poem":1},{"lineBreak":true},{"text":"ty nifaritsoha’ iareoy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa kanao velon-draho hoe t’Iehovà’ i Màroy, t’i Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"le hanahake i Sedome t’i Moabe,","poem":1},{"lineBreak":true},{"text":"naho hoe Amorà o ana’ i Amoneo,","poem":1},{"lineBreak":true},{"text":"ho monton-kisatse, naho kobon-tsira,","poem":1},{"lineBreak":true},{"text":"vaho hangoakoake nainai’e;","poem":1},{"lineBreak":true},{"text":"ho kopahe’ ty sehanga’ ondatikoo,","poem":1},{"lineBreak":true},{"text":"ho lovae’ ty honka’ o borizàkoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Izay ty hamaleañe iareo","poem":1},{"lineBreak":true},{"text":"ty amy firengevohañey","poem":1},{"lineBreak":true},{"text":"amy t’ie nañinje naho nitoabotse","poem":1},{"lineBreak":true},{"text":"am’ondati’ Iehovà’ i màroio.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hampañeveñe iareo t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie hampidazidazitse ze fonga","poem":1},{"lineBreak":true},{"text":"ndrahare’ ty tane toy.","poem":1},{"lineBreak":true},{"text":"Songa hitalaho ama’e","poem":1},{"lineBreak":true},{"text":"boak’ an-toe’e eo ondatio naho ze hene tokonose’","poem":1},{"lineBreak":true},{"text":"o kilakila’ondatio.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ry nte-Kosio:","poem":1},{"lineBreak":true},{"text":"ie ho zamanem-pibarako ka,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"le hatora-kitsi’e mb’amo avaratse añeo","poem":1},{"lineBreak":true},{"text":"ty fità’e, le ho rotsahe’e t’i Asore;","poem":1},{"lineBreak":true},{"text":"vaho hampangoakoahe’e t’i Ninevè,","poem":1},{"lineBreak":true},{"text":"ie ho maike hoe ratraratra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Handre añivo’e eo ze karazam-biby mpiray troke am-piandrazañe ey,","poem":1},{"lineBreak":true},{"text":"hitobòk’ amo lahin-dala’eo","poem":1},{"lineBreak":true},{"text":"ty vorondolo naho ty lagoro;","poem":1},{"lineBreak":true},{"text":"ie hivolañe an-dalan-kede eo;","poem":1},{"lineBreak":true},{"text":"ho rotsake o tokona’eo fa holirañe","poem":1},{"lineBreak":true},{"text":"o mendoraveñe fitemerañeo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Itoke i rova nirebeke","poem":1},{"lineBreak":true},{"text":"t’ie niaiñ’añ’oleñañey,","poem":1},{"lineBreak":true},{"text":"ie nitsakore an-troke ao ty hoe,","poem":1},{"lineBreak":true},{"text":"izaho avao, tsy aman’añ’ilako;","poem":1},{"lineBreak":true},{"text":"akore t’ie hoake henaneo,","poem":1},{"lineBreak":true},{"text":"toetse fandream-biby!","poem":1},{"lineBreak":true},{"text":"Sindre hikosìke naho hañelahela-fitàñe ze hiary eo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tdx_sle/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}