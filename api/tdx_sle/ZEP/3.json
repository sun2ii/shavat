{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"ZEP","translationId":"tdx_sle","name":"Tsefanià","commonName":"Tsefanià","title":"Tsefanià","order":36,"numberOfChapters":3,"sha256":"97187edf92ce2b19aa4af15742b85825cecc663b856c0149b5cbd9efaae7797a","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tdx_sle/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Hankàñe amy maleotse naho tìvay,","poem":1},{"lineBreak":true},{"text":"i rova mamorekekey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsy hinao’e i fiarañanañañey,","poem":1},{"lineBreak":true},{"text":"tsy rinambe’e i lafay,","poem":1},{"lineBreak":true},{"text":"tsy niatoa’e t’Iehovà;","poem":1},{"lineBreak":true},{"text":"tsy niharinea’e t’i Andrianañahare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Liona mitroñe o roandria ama’eo","poem":1},{"lineBreak":true},{"text":"amboa-hako o mpizaka’eo;","poem":1},{"lineBreak":true},{"text":"ndra loli’e tsy apo’ iareo am-para’ te maray.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ondaty jagarigary naho mpikitroke o mpitoki’eo,","poem":1},{"lineBreak":true},{"text":"fa tiniva’ o mpisoro’eo i miavakey,","poem":1},{"lineBreak":true},{"text":"naho nivalike amy Hàke","poem":1},{"noteId":7},{"text":".","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vantañe añivo’e ao t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ie tsy mandilatse;","poem":1},{"lineBreak":true},{"text":"aboa’e an-kazavàñe boa-maraiñe","poem":1},{"lineBreak":true},{"text":"tsy milesa ty hatò’e;","poem":1},{"lineBreak":true},{"text":"fe tsy mete salatse ty mengoke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toe naitoako o fifeheañeo,","poem":1},{"lineBreak":true},{"text":"bangiñe o rova’eo;","poem":1},{"lineBreak":true},{"text":"nampikoaheko o lala’eo am-para’ te","poem":1},{"lineBreak":true},{"text":"tsy amam-pañavelo ty ey;","poem":1},{"lineBreak":true},{"text":"rotsake o rova’eo, po-sehanga’e,","poem":1},{"lineBreak":true},{"text":"leo raike tsy mimoneñe ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nanao ty hoe iraho:","poem":1},{"lineBreak":true},{"text":"Va’e hañeveñe amako irehe?","poem":1},{"lineBreak":true},{"text":"handrambesa’o lafa,","poem":1},{"lineBreak":true},{"text":"soa tsy haitoañe o akiba’oo;","poem":1},{"lineBreak":true},{"text":"amy ze he’e nametsahako ama’ey!","poem":1},{"lineBreak":true},{"text":"fe nalisa iereo, naniva ze fonga sata’iareo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa le liñiso iraho, hoe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ampara’ i andro hanjehazehako anahareoy, fa hoe ty safiriko:","poem":1},{"lineBreak":true},{"text":"hatontoko o kilakila’ ndatio,","poem":1},{"lineBreak":true},{"text":"havoriko o fifeheañeo","poem":1},{"lineBreak":true},{"text":"hampidoañako ty","poem":1},{"lineBreak":true},{"text":"habosehako miforoforo;","poem":1},{"lineBreak":true},{"text":"ho fonga forototoe’ ty afom-pamarahiako ty tane toy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eka hampikotritriaheko am’ondatio ty soñi’ iareo, soa te hene","poem":1},{"lineBreak":true},{"text":"hikanjy ty tahina’ Iehovà,","poem":1},{"lineBreak":true},{"text":"hitoroñe Aze am-pitraofañ’ina.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Boak’ alafe’ o saka’ i Kosìo añe","poem":1},{"lineBreak":true},{"text":"ty hanesea’ iareo o mpipay Ahikoo;","poem":1},{"lineBreak":true},{"text":"o anak’ ampela’ i nampiparaitahekoio ro ho banabanaeñe amako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amy andro zay, tsy hanalatse azo o fitoloña’oo, o niolà’o amakoo,","poem":1},{"lineBreak":true},{"text":"fa hasintako añivo’o ao o mpitreñe","poem":1},{"lineBreak":true},{"text":"am-pirengevohañeo,","poem":1},{"lineBreak":true},{"text":"ie tsy hibohaboha ka","poem":1},{"lineBreak":true},{"text":"amy vohiko miavakey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le hapoko añivo’o ao t’indaty","poem":1},{"lineBreak":true},{"text":"misotry naho rarake,","poem":1},{"lineBreak":true},{"text":"hitsoloke amy tahina’ Iehovày.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tsy handilatse tsy handañitse","poem":1},{"lineBreak":true},{"text":"ty sengaha’ Israele;","poem":1},{"lineBreak":true},{"text":"le tsy ho oniñe am-palie’e ao ty","poem":1},{"lineBreak":true},{"text":"famelem-pamañahiañe:","poem":1},{"lineBreak":true},{"text":"fa hikama iereo vaho handre,","poem":1},{"lineBreak":true},{"text":"le tsy ho amam-pañembañe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Misaboa, ry anak’ ampela’ i Tsione:","poem":1},{"lineBreak":true},{"text":"mipazaha ry Israele;","poem":1},{"lineBreak":true},{"text":"mifalea naho mirebeha an-kaampon-troke","poem":1},{"lineBreak":true},{"text":"ry anak’ ampela’ Ierosalaime.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fa nafaha’ Iehovà o nañozoñañ‘ azoo;","poem":1},{"lineBreak":true},{"text":"fa sinoi’e añe o rafelahi’oo;","poem":1},{"lineBreak":true},{"text":"Iehovà ro mpanjaka’ Israele añivo’o ao;","poem":1},{"lineBreak":true},{"text":"tsy hahaonin-karatiañe ka irehe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Amy sa zay, ho tseizeñe","poem":1},{"lineBreak":true},{"text":"am’ Ierosalaime ty hoe: Ko hembañe;","poem":1},{"lineBreak":true},{"text":"naho amy Tsione:","poem":1},{"lineBreak":true},{"text":"Ko mampigebam-pitàñe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Añivo’o ao t’Iehovà Andrianañahare’o, ie Fanalolahy maharombake","poem":1},{"lineBreak":true},{"text":"hirebek’ ama’o an-kafaleañe,","poem":1},{"lineBreak":true},{"text":"hianjiñe aman-koko;","poem":1},{"lineBreak":true},{"text":"handia taroba aman-tsabo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hatontoko o mihontoke","poem":1},{"lineBreak":true},{"text":"o sabadidam-pamantañañeoo,","poem":1},{"lineBreak":true},{"text":"o mpiama’o mivave i injeio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Inao, ie tsatoke i andro zay","poem":1},{"lineBreak":true},{"text":"songa ho toloñeko o manindry azoo,","poem":1},{"lineBreak":true},{"text":"le ho rombaheko i mikoletray,","poem":1},{"lineBreak":true},{"text":"naho hatontoko i niroaheñey,","poem":1},{"lineBreak":true},{"text":"vaho hafoteko ho engeñe naho tahinañe an-tane atoy ty fisalara’ iareo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hampolieko amy andro zay nahareo,","poem":1},{"lineBreak":true},{"text":"amy sa anontonako anahareoy,","poem":1},{"lineBreak":true},{"text":"Toe hanoako tahinañe naho engeñe","poem":1},{"lineBreak":true},{"text":"añivo ze hene ondati’ty tane toy,","poem":1},{"lineBreak":true},{"text":"naho ampoliko añatrefam-pihaino’ areo, ty fandrohizañe anahareo,","poem":1},{"lineBreak":true},{"text":"hoe t’Iehovà.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Tsf 22:26, Lke 16:16","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/tdx_sle/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}