{"translation":{"id":"tfr_wbt","name":"Sbö Tjl̈õkwo","website":"https://ebible.org/Scriptures/details.php?id=tfrNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tfrNTpo","licenseNotes":null,"shortName":"WBT","englishName":"Teribe Bible","language":"tfr","textDirection":"ltr","sha256":"8803fda7f8064898b04f9cb14d2a1fe2453c3e561b67854f0d30be7c734c1931","availableFormats":["json"],"listOfBooksApiLink":"/api/tfr_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":318,"totalNumberOfVerses":9158,"languageName":"Teribe","languageEnglishName":"Teribe"},"book":{"id":"JON","translationId":"tfr_wbt","name":"Jonás","commonName":"Jonás","title":"Jonás","order":32,"numberOfChapters":4,"sha256":"cce18e4341f1f2addd582a8c20fab99e06312174ea663cee2b6e88e36dad1792","firstChapterNumber":1,"firstChapterApiLink":"/api/tfr_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tfr_wbt/JON/4.json","totalNumberOfVerses":46},"chapter":{"number":2,"content":[{"type":"heading","content":["Jonás syõyo"]},{"type":"verse","number":1,"content":["Eni ga Jonás sök mã l̈i bö roshkoshko ga syõshtono ba Sbö Jehová kong. Tjl̈ẽ ga"]},{"type":"verse","number":2,"content":[{"text":"«Jehová, tja woydëshko ga","poem":1},{"text":"pja rokoror,","poem":2},{"lineBreak":true},{"text":"ga tja kar dboryorop.","poem":2},{"text":"Tëm dl̈ung dorong dwayo, tja wol̈on döröshko ga","poem":1},{"text":"pja rokoror,","poem":2},{"lineBreak":true},{"text":"ga tja kurop.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tja ichorop jer dl̈ung dorong,","poem":1},{"text":"ga tja popnena dl̈ung mäs l̈irë.","poem":2},{"text":"Ba pjl̈ubl̈ún këskës l̈i","poem":1},{"text":"to jek bor kjing go.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kur ga tja iorop beno sök tjoksa.","poem":1},{"text":"Bop u ĩn ame l̈oror.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tja jnena dl̈ung dyorë uunkong,","poem":1},{"text":"tja kjingara dl̈ung rong l̈irë,","poem":2},{"lineBreak":true},{"text":"dl̈ung kjl̈o sho opl̇l̇gwing jong bor dl̈u go.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tja opl̈ono jer öötong shäng dl̈ung dl̈upyo jer äärshko.","poem":1},{"text":"Kur ga tja shduna, iara beno sök eshko ĩyado.","poem":2},{"text":"Gueniyo ga tja wol̈ontoshko ga tja dörop.","poem":1},{"text":"Pja bor Sbö Jehová.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kur ga tja wol̈on döröshko ga","poem":1},{"text":"Jehová, pja woyoshroror,","poem":2},{"text":"ga bor syõ öötong bop shwoy,","poem":1},{"text":"öötong bop u jong l̈ishko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ëye mär sböpga jyãgl̈o go ga","poem":1},{"text":"kjimtëp ame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gueniyo bor tjl̈õkwo pjl̈ú go ga","poem":1},{"text":"l̇l̇ëbo sör, twër ber bop kong.","poem":2},{"lineBreak":true},{"text":"L̇l̇ëye l̈oror bop kong jl̈õkoyo l̈i shäryër eni.","poem":2},{"text":"¡Jehová, bor döga l̈i pja eröe!» l̈e.","poem":1}]},{"type":"verse","number":10,"content":["Eni ga mã l̈i ichara Jehovárë Jonás tjwë dl̈ung kjako."]}],"footnotes":[]},"thisChapterLink":"/api/tfr_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tfr_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tfr_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}