{"translation":{"id":"tgk_ibt","name":"Хушхабар","website":"https://ebible.org/Scriptures/details.php?id=tgk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tgk","licenseNotes":null,"shortName":"IBT","englishName":"Tajik Bible","language":"tgk","textDirection":"ltr","sha256":"e5f7571119b93be6c3f06077337fc220a5b3cf3546beed647fcadbfcef1f54c0","availableFormats":["json"],"listOfBooksApiLink":"/api/tgk_ibt/books.json","numberOfBooks":13,"totalNumberOfChapters":122,"totalNumberOfVerses":4344,"languageName":"тоҷикӣ","languageEnglishName":"Tajik"},"book":{"id":"EST","translationId":"tgk_ibt","name":"Эстер","commonName":"Эстер","title":"Эстер","order":17,"numberOfChapters":10,"sha256":"7a82da623de2e147d324a3a6eb104e7124c0a4cc263f89cdb900c3f2644449aa","firstChapterNumber":1,"firstChapterApiLink":"/api/tgk_ibt/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/tgk_ibt/EST/10.json","totalNumberOfVerses":166},"chapter":{"number":10,"content":[{"type":"heading","content":["Подшоҳ Аҳашверӯш ва Мордахай бузург мегарданд"]},{"type":"verse","number":1,"content":["Сипас подшоҳ Аҳашверӯш тамоми сарзамин, ҳатто ҷазираҳои",{"noteId":28},"дурро ба андоз супоридан водор намуд."]},{"type":"verse","number":2,"content":["Ҳамаи дастовардҳои калони подшоҳ ва бузургдошти Мордахай, ки шоҳ ӯро ба ин дараҷа расонд, дар Китоби Таърихи Подшоҳони Модай ва Форс навишта шудаанд."]},{"type":"verse","number":3,"content":["Хуллас, Мордахайи яҳудӣ баъд аз подшоҳ Аҳашверӯш шахси дуввум буд. Вай дар байни яҳудиён одами бузург ҳисоб меёфту байни хешу табораш эҳтироми баланд дошт. Ин аз он сабаб буд, ки ӯ барои манфиати халқаш кор мекард ва барои беҳбудии ҳамаи яҳудиён баромад менамуд."]}],"footnotes":[{"noteId":28,"caller":"+","text":"Ё соҳилҳо","reference":{"chapter":10,"verse":1}}]},"thisChapterLink":"/api/tgk_ibt/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tgk_ibt/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tgk_ibt/EST/9.json","previou