 kasalanan."]}],"footnotes":[]},"thisChapterLink":"/api/tgl_ulb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tgl_ulb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tgl_ulb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}