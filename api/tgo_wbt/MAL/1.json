{"translation":{"id":"tgo_wbt","name":"Toto Thovuye Loi Ghalɨŋae","website":"https://ebible.org/Scriptures/details.php?id=tgo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tgo","licenseNotes":null,"shortName":"WBT","englishName":"Sudest Bible Portions","language":"tgo","textDirection":"ltr","sha256":"71d98f6548cae88610be2947fc623c73acfb364702bdb1843475403d2d95eeaf","availableFormats":["json"],"listOfBooksApiLink":"/api/tgo_wbt/books.json","numberOfBooks":34,"totalNumberOfChapters":358,"totalNumberOfVerses":10487,"languageName":"Sudest","languageEnglishName":"Sudest"},"book":{"id":"MAL","translationId":"tgo_wbt","name":"Malakai","commonName":"Malakai","title":"Malakai","order":39,"numberOfChapters":4,"sha256":"062023e52c4db5f2abbce46b19cb8c62013eff15ed34075a7c627991ec218ae1","firstChapterNumber":1,"firstChapterApiLink":"/api/tgo_wbt/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tgo_wbt/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[]},{"type":"verse","number":2,"content":[]},{"type":"verse","number":3,"content":[]},{"type":"verse","number":4,"content":[]},{"type":"verse","number":5,"content":[]},{"type":"verse","number":6,"content":[]},{"type":"verse","number":7,"content":[]},{"type":"verse","number":8,"content":["Thare lolo rameyambaneke i kaiva Loi? Iyemaeŋge u kaivaŋgo. Ko u vaito ŋgoroŋga wokaivɨŋge na woŋa? E giyanjogha na mwaewo."]},{"type":"verse","number":9,"content":["Ghemi inami gura e raberabe, ghemi yambaneke laghɨye, kaiwae u vakaiviŋaŋgo."]},{"type":"verse","number":10,"content":["Giya Loi Ravurɨgheghe mbowo iŋava, “Nuwaŋguke nuwaiya moli ghemi na regha i vandegana Ŋgolo Kururu ghathɨnɨmba na mbala ma valɨkaiwami hu bigi lemi wogiya ma e ghathovuye. Ma ya warariŋa e ghemi. Mane ya wovatha lemi wogiya hu womena weŋgo.”"]},{"type":"verse","number":11,"content":[]},{"type":"verse","number":12,"content":[]},{"type":"verse","number":13,"content":[]},{"type":"verse","number":14,"content":["The lolo i dagerawe ne i vowoŋa thetheghan ghɨmoru thovuye e ghino, i mena e le thetheghanɨko tɨnenji, ko iyemaeŋge ma i wogiyava raitharɨ weŋgo. Thoŋgo thela i vakatha iyako iye rakwan na ne ya gura, kaiwae ghino kiŋ laghɨye; ghino nyao thovuthovuye lenji randeviva na gharɨgharɨ e vanautuma vavanava ne thɨ yavwatata wanaŋgo."]}],"footnotes":[]},"thisChapterLink":"/api/tgo_wbt/MAL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tgo_wbt/MAL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tgo_wbt/ZEP/3.json","previousChapterAudioLinks":{},"numberOfVerses":14}