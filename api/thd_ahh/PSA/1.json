{"translation":{"id":"thd_ahh","name":"Kuuk Thayorre Bible Portions","website":"https://ebible.org/Scriptures/details.php?id=thd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=thd","licenseNotes":null,"shortName":"AHH","englishName":"Thayorre Bible Portions","language":"thd","textDirection":"ltr","sha256":"54616cdef094ea1166d8d2bad7f4d497d0b86688e0a40dd249904b3cafc7cc8a","availableFormats":["json"],"listOfBooksApiLink":"/api/thd_ahh/books.json","numberOfBooks":4,"totalNumberOfChapters":9,"totalNumberOfVerses":170,"languageName":"Kuuk Thaayorre","languageEnglishName":"Kuuk Thaayorre"},"book":{"id":"PSA","translationId":"thd_ahh","name":"Wuuch nangn Thepitak","commonName":"Wuuch nangn Thepitak","title":"Wuuch nangn Thepitak","order":19,"numberOfChapters":1,"sha256":"bd48ac5ea3580022a487d19ba564d2f6327ec898beff752a0af90b7a3756acd3","firstChapterNumber":1,"firstChapterApiLink":"/api/thd_ahh/PSA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/thd_ahh/PSA/1.json","totalNumberOfVerses":5},"chapter":{"number":1,"content":[{"type":"heading","content":["Nampa 1"]},{"type":"verse","number":1,"content":[{"text":"Min yomparr-r ith pam kaarp wakm kuuk pelnan pam raak warr-kak;","poem":1},{"text":"Iiwurr nangunp kaarp thanm kulam-thaaw pam raak warr-kokonak;","poem":2},{"lineBreak":true},{"text":"Iiiwurr niinhin kaarp ith ninh thang-kangkar-nanr.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pam ith nul mang-mangal minch nangun Raak-warram nangnma Pam Porkam.","poem":1},{"text":"Ngul nul raak mangk minch min ngeem ngurnturnthurr miing.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nul kar yuk niinanirr thaapirri kar ngok miinthin,","poem":1},{"text":"May yuk punth koo-yermperr raak karrtham,","poem":2},{"lineBreak":true},{"text":"Iiwurr riingkaal kaarp warramr;","poem":2},{"lineBreak":true},{"text":"Mit mong-thak nangn-man nul min yomparr-r.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pam warr yorrp kaarp,","poem":1},{"text":"Kar may petn yarra puunuth puukr pelnan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yarr i'i pam warr nangunp kaarp than, Ith pelnan koo-thakarr ko'orr;","poem":1},{"text":"Iiwurr pam raak warr-kak nangunp Kaarp thaakokon thunprr pelnungun pam kuk-kunanpak;","poem":2},{"lineBreak":true},{"text":"Ngul peln kulam-n pam warr peln wonp.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/thd_ahh/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/thd_ahh/JHN/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":5}