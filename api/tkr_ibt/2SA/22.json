{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"2SA","translationId":"tkr_ibt","name":"Şamuelin q'öd'esın kitab","commonName":"Şamuelin q'öd'esın kitab","title":"Şamuelin q'öd'esın kitab","order":10,"numberOfChapters":24,"sha256":"9ae10022d86cbc5f35e5e1ceb7dad78ebcced1d7df4c860d10803c423bac251d","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/tkr_ibt/2SA/24.json","totalNumberOfVerses":688},"chapter":{"number":22,"content":[{"type":"heading","content":["Davudee Rəbbis opk'unna mə'niy"]},{"type":"verse","number":1,"content":["Rəbbee Davud gırgıne cune duşmanaaşineyiy Şaulne xılençe g'attixhan hı'ımee, Davudee Rəbbis ina mə'niy qəbəqqə:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rəbb yizda suva vobna,","poem":1},{"text":"yizda g'ala, zı g'attixhan ha'ana vorna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Allah yizın ganz vodun,","poem":1},{"text":"Mang'usne zı dyugul ixhes.","poem":2},{"text":"Yizın g'alxan, zı g'attixhanasda suva,","poem":1},{"text":"it'umun ciga Mana vor.","poem":2},{"text":"Allahee zı g'attixhan ha'a.","poem":1},{"text":"Ğu, Rəbb, zı eb ulyooğanbışde xılençe g'attixhan ha'a!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Şukur gyooxhane Rəbbilqa ona'as,","poem":1},{"text":"yizde duşmanaaşine xılençer g'attixhanasda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yizde hiqiy-alla gyabat'an mırtar ıxha,","poem":1},{"text":"zı gek'ane damabışile zı qəyq'ən ıxha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahalın t'ü'bı zalqa alitk'ır ıxha,","poem":1},{"text":"gyapt'asde gugubışeqar zı girxhu ıxha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dağamiyvalee zı Rəbbilqa onuiyn,","poem":1},{"text":"Allah kumagıs qort'ul.","poem":2},{"text":"Mang'uk'le yizın ses Cune Xaa","poem":1},{"noteId":25},{"text":"g'ayxhiyn,","poem":1},{"text":"yizın uts'ur Mang'une k'ıriysqa hitxhıriyn.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mang'us qəl vuxhal-alla","poem":1},{"text":"ç'iye oyt'al, ı'ğiykaran,","poem":2},{"lineBreak":true},{"text":"xəən xhebbı ı'ğiykar, manbı hoyharanbı.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mang'une quşeençe kuma qığeç'u,","poem":1},{"text":"ghalençe gyooxhan haa'an ts'a ı'xiyxə.","poem":2},{"lineBreak":true},{"text":"Mançikeb gyopxhanna ghadır k'yoohar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mang'vee xəybı qaxı, ç'iyelqamee geç'ena.","poem":1},{"text":"Miç'axiyvalla Mang'une g'elybışik avub vuxha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sa keruvulil","poem":1},{"noteId":26},{"text":"alixı,","poem":1},{"text":"mıtsıne xılibışil ilexa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hiqiy-allan ciga xəmdilqa sak'al ha'a,","poem":1},{"text":"xhineka gyatsts'ıyne k'aarıne buludbışike Culqa aççesın kar ha'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mang'une nuruke","poem":1},{"text":"gyotxhanan ts'a qı'ğəə ıxha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Rəbbee xəybı g'əhətqə'ə,","poem":1},{"text":"Haq'-Ta'aalee ses gyayhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vukbı avhu, duşmanar ehevkaa'anbı,","poem":1},{"text":"ts'ayılpan ı'xı'ı', manbı oot'al-ooxal haa'anbı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Qəvəəq'ənasde Rəbbine sesıke,","poem":1},{"text":"quşeençene qı'ğəəne it'umne nafasıke,","poem":2},{"text":"deryahın k'oralybı g'ece giyğal,","poem":1},{"text":"dyunyeyn xhebbı g'ece giyğal.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mang'vee xəybışeençe xıl hotku, zı aqqı,","poem":1},{"text":"zı k'orane xhyanbışeençe qığavhu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zı gucnane duşmanıke Mang'vee g'attixhan hı'ı,","poem":1},{"text":"zı g'ımece eyxhenbışike,","poem":2},{"lineBreak":true},{"text":"yizdemee geeb gucnanbışike g'attixhan hı'ı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yizde pisde yiğıl manbı yizde ögiylqa qığeepç'ı,","poem":1},{"text":"Rəbbeeme zı aqqı.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mang'vee zı dağamiyvalike hixu'u,","poem":1},{"text":"zı ıkkiykın, zı g'attixhan hı'ı.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yizde qopkuvalis sik'ı Rəbbee zas huvu,","poem":1},{"text":"yizde xılene məttıvalis sik'ı huvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mang'vee məxüd hı'iyn zı Rəbbina yəq' avquva,","poem":1},{"text":"pisda ıxha Allahılqa yı'q' sak'al hidi'ıva.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mang'un gırgın q'aanunbı yizde ögiyl vod,","poem":1},{"text":"Mang'une g'aydabışiler hixu deş.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Zı Mang'une ögiyl məttıne yik'eka ıxha,","poem":1},{"text":"zıcar zı bınahıke havacına.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Rəbbee yizde qopkuvalis sik'ı huvu,","poem":1},{"text":"Cune ulene ögiyl yizde məttıvalis sik'ı huvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ğu saadik'ranang'uka saadik'ra eyxhe,","poem":1},{"text":"kaamilinbışika kaamilyra vor.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Məttınbışika məttıra,","poem":1},{"text":"quç'opkuriynbışika, cone quç'opkuriys sik'ı eyxhe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hooç'an-g'ooç'ananbı Ğu g'attivxhan haa'a,","poem":1},{"text":"cocab-co axtıba vukkekanbışilqab Ğu ul giviyxhe,","poem":2},{"lineBreak":true},{"text":"manbı k'ap'ik'ıle avqa qaa'a.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Rəbb, Ğu yizın işix vod,","poem":1},{"text":"Ğu yizda miç'axiyvalla nurulqa savaak'al haa'a.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Zı Vakasana duşmanaaşikın ha'a,","poem":1},{"text":"yizde Allahıka şaharbı aqqaqqa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Allahna yəq kaamilyba vob,","poem":1},{"text":"Rəbbin cuvab məttıda vod!","poem":2},{"text":"Mang'ulqa yı'q' qizzırna gırgına,","poem":1},{"text":"Mang'vee g'attixhan ha'ana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Rəbbile ğayrı, Allah vuşune vor?","poem":1},{"text":"Yişde Allahıle ğayrı, medın ganz nenne vod?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Allah yizda it'umna g'ala vobna,","poem":1},{"text":"Mang'vee yizda yəq qopku qaa'a.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mang'vee yizın g'elybı maralın g'elybı xhinne ek' qa'a,","poem":1},{"text":"Zı axtıvalee it'umra aqqaqqa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mang'vee yizın xıleppı dəv'əysın xhinne qa'a,","poem":1},{"text":"zasse tuncıke hı'iyn vuk quç'okara'as əxən.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ğu zas g'attixha'anasın g'alxan huvu,","poem":1},{"text":"Ğu hı'iyne kumaagıka zı axtı qı'ı.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Zasse saccu Vaka əq'ra iykaras əxə,","poem":1},{"text":"zı məxür qaçayxarır deş.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Zı duşmanar g'ee'epşiynbı, manbı gyapxıynbı,","poem":1},{"text":"manbışikın ixhesmee yı'q'əlqar sak'ı deş.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Zı manbı hööq'əv'u ç'əvxhana,","poem":1},{"text":"manbışisse suğoots'asıb vəvxü deş,","poem":2},{"lineBreak":true},{"text":"yizde g'elybışik avqa manbı qukk'yopk'ul.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Dəv'əynemee Ğu zalqa guc alipk'ır,","poem":1},{"text":"zalqa g'elil qeepxhaynbı Ğu yizde g'eliqqa huvu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Duşmanar zale heepxasınbı xhinne qaa'a,","poem":1},{"text":"zı g'ımecenanbışikınıd zı hı'iyn.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Manbışe uleppı ooqa qe'eeyid, manbı g'attivxhan haa'anbı vuxha deş,","poem":1},{"text":"Rəbbilqa onu'eeyid, Mang'vee alidghıniy quvu deş.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Zı manbı k'ööq'ü, tooz xhinne qav'u,","poem":1},{"text":"şahrabışeedın battağ xhinneeyib k'ööq'üynbı.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Ğu zı, yizde milletne g'elil qeepxhayke g'attixhan hı'ı,","poem":1},{"text":"zake milletbışda xərna hı'ı,","poem":2},{"lineBreak":true},{"text":"zak'le dyats'ancad milletbı yizde xılyaqa quvu.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Menne cigeençenbı yizde ögiyl k'yoozarav'uynbı,","poem":1},{"text":"yizın do g'ayxhımee, eyhen ha'a.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Menne cigeençenbı yizde ögiyl hapq'ıriynbı.","poem":1},{"text":"Qəpq'ı'n zezebı atk'u,","poem":2},{"lineBreak":true},{"text":"dyuguleepxhayne cigeençe qığeepç'iynbı.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Rəbb vorna! Yizde Ganzıs şukur vuxhena!","poem":1},{"text":"Zı g'attixhan hı'iyn Ganz, Allah, axtı qe'e!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Allahee zal-alla qəl qığaaha,","poem":1},{"text":"milletbı yizde xılyaqa qele.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Mang'vee zı yizde duşmanaaşine xılençe g'attixhan ha'a,","poem":1},{"text":"Mang'vee zı yizde duşmanaaşile ooqana ha'a,","poem":2},{"lineBreak":true},{"text":"Zı eb ulyooğanbışde xılençe g'attixhan hı'ı.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Rəbb, mançil-alla zı Ğu menne milletbışde yı'q'nee axtı qa'as,","poem":1},{"text":"zı Yiğne doyus şukur haa'as!","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"Allahee Cune paççahıs xədın ğamxhaybı heles,","poem":1},{"text":"g'əyxı'yne Davudne nasıles gırgıne gahbışilycab yugvalla haagvas.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Cune xaa: Davudee inyaa Allahne çadırıne hək'ee eyhe. İzrailybı, Misirğançe qığeepç'iyle qiyğa, Allahee manbışik'le muq'addasna çadır hee'eva eyhe. Manbı sahree vuxhaylette manbışe mana çadır coka ı'ğviykar ha'a vuxha. Mana çadır işaarat vuxha, Allah cone yı'q'nee axvava. Mane muq'addasne çadırne ögiyl İzrailybışe Allahıs q'urbanbı gyaat'a, ı'bəədatbıniy ha'a. Qiyğab Davud peyğambarne gahılib mana İyerusalimeeniy vob.","reference":{"chapter":22,"verse":7}},{"noteId":26,"caller":"+","text":"Keruv: xılibınana malaaik vor.","reference":{"chapter":22,"verse":11}}]},"thisChapterLink":"/api/tkr_ibt/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}