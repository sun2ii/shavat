{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Gırgın q'əran vuççud deşin kar vodun"]},{"type":"verse","number":1,"content":["İna gaf Mə'əllimee, İyerusalimee paççahiyvalla hav'uyne, Davudne dixee hav'u."]},{"type":"verse","number":2,"content":["Mə'əllimee eyhen:",{"text":"– Q'əran vuççud deşin kar!","poem":1},{"lineBreak":true},{"text":"Q'əran vuççud deşin kar!","poem":1},{"lineBreak":true},{"text":"Gırgın ıxha-ayk'anne booğak akar vod!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"İnsanıs verığne avur qorxuyke","poem":1},{"text":"hucoona hiyxhar?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İnsanar qabı-avayk'ananbı,","poem":1},{"text":"dyunyemee gırgıne gahbışilycad çine cigee axva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Verığ k'yooçena, ılqooç'ena,","poem":1},{"text":"qiyğa meeb ılqevç'esva","poem":2},{"lineBreak":true},{"text":"çine cigeeqa zaraba g'adaaxhvan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mıts cənubulqa,","poem":1},{"text":"qiyğa şimalılqa aa'a.","poem":2},{"text":"İlyviyk'ar-ilyviyk'arıb","poem":1},{"text":"çine yəqqı'lqa siviyk'al.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gırgın damabı deryaheeqa gyodatstse,","poem":1},{"text":"deryahme gyaats'e deş.","poem":2},{"text":"Damabı gyodatstsene cigeeqacad","poem":1},{"text":"meed gyotstses.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İnsanısse gırgıne karan","poem":1},{"text":"vuc nimeeyiy ozar ha'a,","poem":2},{"lineBreak":true},{"text":"eyhes əxə deş –","poem":2},{"text":"ul, ilyaakıyke idyaats'e,","poem":1},{"text":"k'ırıd, k'ırı alixhxhiyke gidyayts'e.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hucooyiy ıxha meed ixhesın,","poem":1},{"text":"hucooyiy həşdilqamee hı'ı, meed ha'asın.","poem":2},{"text":"Xəək avud ts'edın kar deşin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sassa yəqqees eyhen:","poem":1},{"text":"«İlekke, in ts'edın karıd!»","poem":2},{"text":"Man ögiylid ıxhayn,","poem":1},{"text":"yişde dyovrule ögiyl.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Şenke vuxhaynbı","poem":1},{"text":"şavuscab yik'el avxu deş.","poem":2},{"text":"Qiyğa qavaalesınbıb,","poem":1},{"text":"cole qiyğiynbışe yik'el avqas deş.","poem":2}]},{"type":"heading","content":["K'orana ək'elib q'əran vuççud deşin kar vodun"]},{"type":"verse","number":12,"content":["Zı, Mə'əllim, İyerusalimee İzrailyna paççahniy vor."]},{"type":"verse","number":13,"content":["Zıcar zı g'aysırna xəək avud eyxhen işbı k'orane ək'elika xət qeetxhesva. Man yı'q'ı'n işbı Allahee insanaaşine gardanaqa gixhxhı."]},{"type":"verse","number":14,"content":["Zak'le xəək avud ha'an gırgın işbı g'acuynbı. Man gırgın q'əran vuççud deşin kar vodun. Man mıtsıqa qihna g'adarxhuniyk",{"noteId":0},"akar."]},{"type":"verse","number":15,"content":[{"text":"Quç'otkuriyn qotku qa'as,","poem":1},{"text":"deşinıd hı'sab ha'as dexhe.","poem":2}]},{"type":"verse","number":16,"content":["Zı zascad uvhuyn: «Zake xərna insan ıxha, zaqa zale ögee İyerusalimıs paççahiyvalla haa'ane paççahaaşile k'orana ək'el vob. Yizda k'orana ək'eliy ats'al geeb quvxha»."]},{"type":"verse","number":17,"content":["Zıcar zı g'aysırna k'orana ək'eliy ats'al xət qıxha, bəç'əriyvallayiy beynyavavalla nəxdın kariyva ats'a ixhes. Zak'le manıd mıtsıqa qihna g'adarxhuniyk akaran kar ıxhay ats'axhxhayn."]},{"type":"verse","number":18,"content":[{"text":"K'orana ək'el geeb vuxhaylette","poem":1},{"text":"aq'va havaxan hı'iyid geed qexhe.","poem":2},{"text":"Geed ats'al alyaat'ang'vee","poem":1},{"text":"cuna derdıb geeb qa'a.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"mıtsıqa qihna g'adarxhuniy: inçina sa mebna mə'na «rı'hı'n ts'ıts'aa'ana əq'üba» vob.","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/tkr_ibt/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}