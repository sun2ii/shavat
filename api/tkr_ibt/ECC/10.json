{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"heading","content":["K'orane ək'elikan uvhiybı"]},{"type":"verse","number":1,"content":[{"text":"Sa qivk'uyne xı'nit'iyn","poem":1},{"text":"yugne ətirıkın ha'an.","poem":2},{"text":"Həməxdıd k'ınne bəç'əriyvalin","poem":1},{"text":"k'orane ək'elikıniy hı'rmatıkın ha'an.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"K'orane ək'elynane insanne yik'en qorkune suralqa ts'ıts'a'a,","poem":1},{"text":"bəç'ər insanneme yik'en quç'orkune.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mang'una bəç'əriyvalla","poem":1},{"text":"yəq' əlyhəəng'əb vaats'a vooxhena.","poem":2},{"lineBreak":true},{"text":"Gırgıng'uk'le mana nimee bəç'ər ıxhay g'ecen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xərıng'una valqa qəl avqee, himexva.","poem":1},{"lineBreak":true},{"text":"Cusse vuc aqqas əxəng'une","poem":1},{"text":"geebne bınahbışike ılyheebaç'enbı.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Xəək avub zak'le sa mebna verıb g'avcuna: qotkuda hidi'iyn kar cuke paççahıke vodun."]},{"type":"verse","number":6,"content":[{"text":"Ək'el deşinbı ç'ak'ıne işbışilqa giviyxhe,","poem":1},{"text":"karnanbışeme avudun cigabı aqqaqqa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zak'le nukarar balkanıl oo,","poem":1},{"text":"ç'ak'ınbıb nukarar xhinne iviykar əlyhəə g'avcu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xandak' ilyviyk'arna","poem":1},{"text":"xandak'eeqa k'eyxhas əxə.","poem":2},{"text":"Çabır qoytalang'ukub","poem":1},{"text":"xoçe üvxəs vəəxə.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"G'aye gyabaxanar","poem":1},{"text":"g'ayeysse qoxa'as əxə.","poem":2},{"text":"Os qaxanar","poem":1},{"text":"osasse qoxa'as əxə.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yak'v ek'da deşxhee,","poem":1},{"text":"man ek'a'asıd hidevuxheene,","poem":2},{"lineBreak":true},{"text":"mançis geeb guc əlyhəəs.","poem":2},{"text":"K'orane ək'elisseme","poem":1},{"text":"man kar qa'as əxə.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xoçe avqas vəəxəna ayresse xoçe üvxee,","poem":1},{"text":"mana nişiscarne qoyt'al.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"K'orane ək'elynane insanne ghalençe","poem":1},{"text":"yugun cuvabxhe qığeç'en.","poem":2},{"text":"Ək'el deşing'une mizenmee","poem":1},{"text":"mang'ukun ha'anxhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mang'un yuşan hı'iyid","poem":1},{"text":"ək'el deşvalika giyğal.","poem":2},{"text":"Yuşan hı'iyid","poem":1},{"text":"xənne bəç'əriyvalika ç'əvexhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ək'el deşda insan","poem":1},{"text":"geerxhe yuşan ha'ana.","poem":2},{"text":"Şavuk'lecadıd vuk'lelqa qalesın ats'a deş.","poem":1},{"lineBreak":true},{"text":"Şavusse cule qiyğa","poem":1},{"text":"hucoo ixhesınçina eyhes əxəyee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ək'el deşinbışe ts'ıts'av'uyne əq'übayn,","poem":1},{"text":"cocab oozar haa'a.","poem":2},{"text":"Manbışik'le şaharılqa əlyhəəna yəqı'b","poem":1},{"text":"vaats'a deş.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yiğna paççah nukaraaşine nasılınaxheene,","poem":1},{"text":"ç'ak'ınbıb miç'eeb çakba, otxhan-ulyoğa giviyğalxhee,","poem":2},{"lineBreak":true},{"text":"ölka, vay vak ixhesın!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yiğna paççah qıvaats'ıyne nasılınaxheene,","poem":1},{"text":"ç'ak'ınbışed çine gahıl,","poem":2},{"lineBreak":true},{"text":"ulyoğasva deş, guc saa'asva otxhanxhee,","poem":2},{"text":"ölka, vaqa yugun yiğbı ixhes!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"İnsan tambalraxhee,","poem":1},{"text":"mang'una daxaxhe giviy'arna.","poem":2},{"text":"Nenacab iş g'idevceene,","poem":1},{"text":"xaane daxayle xhyan k'yak'anas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Otxhun-ulyodğuy yik'es ıkkanva ha'a,","poem":1},{"text":"çaxıren ı'mı'res rang hele.","poem":2},{"text":"Pılınmee vas ıkkanan gırgın ha'an.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Paççahıqa yik'eeyid humoka,","poem":1},{"text":"karnane insanne hək'ee","poem":2},{"lineBreak":true},{"text":"ğu g'ılexhane cigeeyid pisın immeyhe.","poem":2},{"text":"Xəə ileedaxvane şit'yaaşe xabar vukkees,","poem":1},{"text":"mançisse ğu uvhuyn cuvab hixhar ha'as əxə.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}