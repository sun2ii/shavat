{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["İnsanaaşik'le vuk'lelqa qalesın ats'a deş"]},{"type":"verse","number":1,"content":[{"text":"Yiğın gıney xhinel ooqa g'aykke,","poem":1},{"lineBreak":true},{"text":"xılece gah ılğevç'uyle qiyğa,","poem":1},{"text":"vak'le man meed aveykesın.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yighneyee, molyneyee","poem":1},{"text":"insanıs vaqa vodunçike pay hevle.","poem":2},{"text":"Vak'le ölkayne vuk'lelqa ablesda","poem":1},{"text":"verıb vaats'a deş.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Buludbı xhineka gyatsts'ı ixhee,","poem":1},{"text":"mançin ç'iyene aq'valqa gyoğiy gikkas.","poem":2},{"text":"Yiv canubulqayee, şimalılqayee hı'ğəpkıree,","poem":1},{"text":"mane qukk'yopk'ulne cigeeyib aaxvasda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mıtsıqa ilyakkang'vee toxum üvxüyxəna deş.","poem":1},{"lineBreak":true},{"text":"Buludbışiqa ilyakkang'ussed ezuyn qiyşalas əxəs deş.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vak'le mıtsın yəqbı ats'a deş,","poem":1},{"lineBreak":true},{"text":"vuxhnene zəiyfayne vuxhne","poem":1},{"text":"nəxüdiy bark'vbıd ç'ak'ı qeetxhay","poem":2},{"text":"şavuk'lecad ats'a deş.","poem":3},{"text":"Məxı'dıd vas gırgın itxhınne Allahne işbışike xabar deş.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Toxum miç'eeb üvxe,","poem":1},{"text":"exhalilqameeyid xıleppı iş dena g'ılyma'a.","poem":2},{"text":"Vak'le ats'a deş inme, şenme","poem":1},{"text":"şagav yugda ixhes,","poem":2},{"lineBreak":true},{"text":"deşxheene, q'öyudsaname yugda ixhes.","poem":2}]},{"type":"heading","content":["Ğu İrxhınna yik'el hixan hıma'a"]},{"type":"verse","number":7,"content":[{"text":"Hək'edad işix micagda vod,","poem":1},{"text":"verığ g'avciy uleppışisqa yugba qöö.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İnsanee xıliyna ı'mı'r haa'axhee,","poem":1},{"text":"hasre şadba hee'ecen.","poem":2},{"text":"Pisın yiğbı ıxhayid yik'el hixan hıma'acen,","poem":1},{"text":"pisın yiğbı geedbı ixhes.","poem":2},{"text":"Vuk'lelqa qalesın gırgın kar","poem":1},{"text":"q'əran vuççud deşin kar vod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Şadxhe mek'vna, nimeeletteyiy mek'vra.","poem":1},{"text":"Mek'vranang'a yiğın yik' şade'e.","poem":2},{"text":"Yik'es ıkkanne, uleppışik'le g'ecene","poem":1},{"text":"cigeeqa hoora.","poem":2},{"text":"Vak'le manıd ats'axhxhe,","poem":1},{"text":"mane gırgınçil-alla Allahee","poem":2},{"text":"ğu məhkameeqa ts'ıts'a'as.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mançil-allad aq'va qıma'a,","poem":1},{"text":"ık'arbı vake əq'əna hee'e.","poem":2},{"text":"Mek'vallab, mek'valeena gucub","poem":1},{"text":"ıxha-ayk'anne booğak akar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}