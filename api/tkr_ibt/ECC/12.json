{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Mek'vranang'a ğu İrxhınna yik'el qale'e.","poem":1},{"text":"Qiyğa pisın yiğbı qadımee, ğu eyhesın:","poem":2},{"text":"«Həşde yizın kef nişikecad ooqa qexhe deş».","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manke verığın, vazın,","poem":1},{"text":"xənebışin işix yiğnemee k'ətqəsın,","poem":2},{"text":"gyoğiyle qiyğa, meed buludbı sak'alas.","poem":1},{"noteId":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Man yiğ qadımee,","poem":1},{"text":"xaaka ilyaakanbışik zeze avkkas,","poem":2},{"text":"gucnanbı k'yooç'anasınbı,","poem":1},{"lineBreak":true},{"text":"giviyxəranbışisse co k'ılybava","poem":1},{"text":"suk giviyxəras vəəxəs deş,","poem":2},{"text":"g'uleppışile ilyaakanbışik'le","poem":1},{"text":"miç'axda g'aces.","poem":2},{"noteId":3}]},{"type":"verse","number":4,"content":[{"text":"G'aqa aaqan akkabı it'umeedxhesınbı,","poem":1},{"text":"yöxxəbışin sesbı k'ıl qeetxhes.","poem":2},{"text":"Ğu şit'yaaşine sesbışikar çikana muğur qıxhes,","poem":1},{"text":"mə'niybı qədəqqəne içeeşin k'ılda g'ayxhes.","poem":2},{"noteId":4}]},{"type":"verse","number":5,"content":[{"text":"Ğu manke axtıne cigabışile qəq'ənasda,","poem":1},{"text":"yəq əlyhəəsır qəq'ənasda.","poem":2},{"text":"Badamne yiven t'et' g'ayhe,","poem":1},{"text":"ts'irtyar yı'q' qeetxhes","poem":2},{"noteId":5},{"text":",","poem":2},{"lineBreak":true},{"text":"naps k'ıl qixhes.","poem":2},{"text":"Məxür insan cune gırgıne gahbışilyne xaaqa əlyhəə,","poem":1},{"text":"ak' avquynbı şahrabışeeqa k'yoohar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuk'rayn baağar qudyodu,","poem":1},{"text":"k'ınəəğəyna kasa hidyapq'ır,","poem":2},{"text":"xhyan ı'lqəəne cigaysneedın","poem":1},{"text":"parç xüvə-xüvəna qıdexha,","poem":2},{"lineBreak":true},{"text":"kahrızılin çarx hidyatq'ur","poem":2},{"noteId":6},{"text":"ğu İrxhınna yik'el qale'e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manke nyuq'vneke hıiyn tan","poem":1},{"text":"nyuq'vnelqa sak'alas,","poem":2},{"text":"ı'mren nafasıd","poem":1},{"text":"yic huvuyne Allahısqa sak'alas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Mə'əllimee eyhen:",{"text":"– Q'əran vuççud deşin kar!","poem":1},{"lineBreak":true},{"text":"Gırgın ıxha-ayk'anne booğak akar vod!","poem":1}]},{"type":"heading","content":["Nekke qiyğiyn cuvab"]},{"type":"verse","number":9,"content":["Mə'əllim k'orana ək'elynana insan ıxha, mang'vee milletıs ats'aalid hele ıxha. Mang'vee geeb fıkır opxhun, geed ək'elikan kar qiyghın, geed misaalabı sı'ı, otk'un."]},{"type":"verse","number":10,"content":["Mə'əllimıs micagın uvhiybı t'abal ha'as ıkkiykın. Mang'vee otk'uninbı qotkuda hək'eda vod."]},{"type":"verse","number":11,"content":["K'orane ək'elynanbışe eyhenbı çobanna çümq xhinne, manbışe sı'iyn cuvabbıd it'umda ı'xiyn g'adaxbı xhinne vod. Man eyhen cuvabbı sa çobanee uvhuynbı vod."]},{"type":"verse","number":12,"content":["Mançile ğayrı, dix, ğu inçilqa fıkır hevle: nimeen ıxhay kitabbı ok'anas eyxhe, geed qətqiynır insan ozarxhe ha'ana."]},{"type":"verse","number":13,"content":[{"text":"Həşde ğu nekke qiyğiyne cuvabıl k'ırı alixhxhe:","poem":1},{"lineBreak":true},{"text":"Allahıle qəq'ne, Mang'vee eyhen he'e.","poem":1},{"text":"İnsanee ts'etta ha'asın man vod.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Allahee gırgın işbı,","poem":1},{"text":"dyugulenın gırgın kar","poem":2},{"lineBreak":true},{"text":"– yugun ixheeyid, pisın ixheeyid –","poem":2},{"text":"məhkameençe alğahas.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"İne cigee (12:2-6) curayne-curayne misaalabışika insanne vuk'lelqa q'əsvalee qalesın hagva.","reference":{"chapter":12,"verse":2}},{"noteId":3,"caller":"+","text":"İnyaa «xaaka ilyaakanbıyiy gucnanbıva» xıleppışik'leyiy g'elybışik'le eyhe, «giviyxəranbıva» silibışik'le, «g'uleppışile ilyaakanbıvad» uleppışik'le eyhe.","reference":{"chapter":12,"verse":3}},{"noteId":4,"caller":"+","text":"İnyaa «g'aqa aaqan akkabıva» k'ırıbışik'le eyhe. İnyaa sayid q'əsınbışik'le pisda g'iyxhe, manbı pisba g'alyabak'ava eyhe.","reference":{"chapter":12,"verse":4}},{"noteId":5,"caller":"+","text":"İnyaa «badamne yiven t'et' g'ayheva» vuk'lelyne cagvarane ç'ərbışik'le eyhe, «ts'irtyar yı'q' qetxhesvad» q'əs qıxha, ek'ra ı'ğviykaras dəvxüyle eyhe.","reference":{"chapter":12,"verse":5}},{"noteId":6,"caller":"+","text":"İnyaa qik'uyne hək'ee eyhe.","reference":{"chapter":12,"verse":6}}]},"thisChapterLink":"/api/tkr_ibt/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/DAN/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}