{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":3,"content":[{"type":"heading","content":["Gırgınçiqa çina gah vob"]},{"type":"verse","number":1,"content":[{"text":"Gırgınçiqa çina gah vob,","poem":1},{"text":"xəək avudne gırgıne karaqa çina gah vob.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yedike ıxhayqab çina gah,","poem":1},{"text":"qik'uyqab çina gah.","poem":2},{"text":"Ezuyqab çina gah,","poem":1},{"text":"ezuyn hı'ttitxı'yqab çina gah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gyapt'ıyqab çina gah,","poem":1},{"text":"yug qav'uyqab çina gah.","poem":2},{"text":"Qottulıyqab çina gah,","poem":1},{"text":"ali'iyqab çina gah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gyaaşuyqab çina gah,","poem":1},{"text":"əqəna hı'iyqab çina gah.","poem":2},{"text":"Ak' avquyqab çina gah,","poem":1},{"text":"mık'ar hı'iyqab çina gah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"G'aye avhuyqab çina gah,","poem":1},{"text":"g'aye sav'uyqab çina gah.","poem":2},{"text":"Xüvə apk'iyqab çina gah,","poem":1},{"text":"xüvə idyapk'iyqab çina gah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"T'abal hav'uyqab çina gah,","poem":1},{"text":"aagval hav'uyqab çina gah.","poem":2},{"text":"Havaacıyqab çina gah,","poem":1},{"text":"dağetçuyqab çina gah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Qıtt'axı'iyqab çina gah,","poem":1},{"text":"man iyxhuyqab çina gah.","poem":2},{"text":"Ghal sı'iyqab çina gah,","poem":1},{"text":"yuşan hı'iyqab çina gah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vukkiykıniyqab çina gah,","poem":1},{"text":"g'umooce qepxhayqab çina gah.","poem":2},{"text":"Dəv'əyqab çina gah,","poem":1},{"text":"sülyhuqab çina gah vob.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Qorxu kar ha'ang'us mançike hucoona hiyxhar?"]},{"type":"verse","number":10,"content":["Zak'le Allahee man yı'q'ı'n işbı insanaaşine gardanaqa gixhxhı g'acu."]},{"type":"verse","number":11,"content":["Allahee gırgın kar micagda çine gahıl hı'ı. Mang'vee insanne yik'eeqa ç'əv dyooxhene gahıne hək'ee atçu. İnsanılqad Allahee hı'iyn kar q'omançe-k'anyaqqamee hiyxhar deş."]},{"type":"verse","number":12,"content":["Zalqa hitxhıriyn, insannemee şadra ıxha ı'mı'rvolle ı'mı'rıke kef qığavhuyle yugun kar deşin."]},{"type":"verse","number":13,"content":["Şavaayiy otxhanançike, ulyoğançike, qorxuyke kef qığayhee, mana Allahna pay vobna."]},{"type":"verse","number":14,"content":["Zalqa hitxhıriyn, Allahee hav'una iş gırgıne gahbışisda vobna. Mançik vuççudud hexxa'as eyxhe deş, mançike vuççudud g'ats'ak'vanas eyxhe deş. Allahee məxüd ha'a, insanarıb Cule qəvəyq'ənanbı."]},{"type":"verse","number":15,"content":[{"text":"Həşde hucooyiy vod,","poem":1},{"text":"şenked ıxhayn,","poem":2},{"text":"hucooyiy ixhesıd,","poem":1},{"text":"avaalad ıxhayn.","poem":2},{"text":"Allahee şenke ıxhaynçin","poem":1},{"text":"hı'sab qeqqas.","poem":2}]},{"type":"heading","content":["Gırgınbı nyuq'vnelqa savk'alas"]},{"type":"verse","number":16,"content":["Xəək avud zak'le inıd g'acuyn:",{"text":"Qotkune məhkamayne cigee horbı,","poem":1},{"lineBreak":true},{"text":"qopkuvaline cigeeyib pisvalla.","poem":1}]},{"type":"verse","number":17,"content":["Zı zak'lecad uvhuyn:",{"text":"«Allahee qorkung'unud,","poem":1},{"lineBreak":true},{"text":"pisıng'unud məhkama alğahas.","poem":1},{"lineBreak":true},{"text":"Mang'vee gırgıne karas,","poem":1},{"lineBreak":true},{"text":"gırgıne işis çina gah gyuvxhu».","poem":1}]},{"type":"verse","number":18,"content":["Zı zak'lecad uvhuyn: «Allahee insanar siliys üvxiyxə, co həyvanaaşik akaraba vuxhay g'avcecenva»."]},{"type":"verse","number":19,"content":["Həyvanne vuk'lelqa qaylen insanned vuk'lelqa qaylen. Həyvanıb, insanır qek'ana. Həyvanınıd, insaneeyid sa nafas ileşşe. İnsan həyvanıle ooqana deş vor. Man gırgın q'əran vuççud deşin kar vodun."]},{"type":"verse","number":20,"content":[{"text":"İnbıb, şenbıd","poem":1},{"text":"çine cigeeqa siyk'al:","poem":2},{"text":"inbıb, şenbıd","poem":1},{"text":"nyuq'vnekenbı vod,","poem":2},{"lineBreak":true},{"text":"nyuq'vnelqad sak'alasınbı.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Şavuk'lene ats'a, insanaaşin rı'h xəəqə ılqeç'emme deşme, həyvanaaşinıd rı'h avqa, nyuq'vneeqa əlyhəə ıxhay?"]},{"type":"verse","number":22,"content":["Zak'le g'acuyn, insanısqa vucee haa'ana iş yugba qööxhee, mang'unemee mançile yugun kar deşin. I'mreke mang'us axuyn man vod. Şavusse mang'uk'le cule qiyğa eyxhenbı hagvas əxəye?"]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}