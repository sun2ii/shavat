{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Dyunyeyn əq'übabı"]},{"type":"verse","number":1,"content":["Zak'le meed xəək avud helen, gırgın əq'übabı g'acu:",{"text":"k'yats'apxıliynbışin gyaaşuybı g'acu,","poem":1},{"lineBreak":true},{"text":"manbışis yik'bı helena vuşucar deşiy.","poem":1},{"lineBreak":true},{"text":"Guc əq'üba hoolenbışde xıleyiy,","poem":1},{"lineBreak":true},{"text":"k'yats'apxıliynbışis yik'bı helenbı deşiy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zasqa ögiyl hapt'ıynbı,","poem":1},{"text":"üç'übınbışile baxtivarba qabı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mane q'önbışileb yugunbı,","poem":1},{"text":"ine dyunyelqa qidyabıynbıcab vob.","poem":2},{"text":"Manbı xəək avud ha'an pisın karbı g'ıdecuynbı vob.","poem":1}]},{"type":"heading","content":["İşine hek'ee"]},{"type":"verse","number":4,"content":["Zak'le insanaaşe iş yı'q'ba haa'amee, manbışda iş yugba əlyhəə g'avcuna. Mançil-allab mebınbışe manbışde karalqa ul giviyxhe. Manıd q'əran vuççud deşin kar vodun, mıtsıqab qihna g'adapxhıniyk akar."]},{"type":"verse","number":5,"content":[{"text":"Şak'le ats'an bəç'əree xıl-xılelqa gixhxhı,","poem":1},{"text":"mıssıra axu, cukun ha'an.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sa xhaxheedın vaxxariynme,","poem":1},{"text":"q'öne xhaxheene qoxa ha'ane karaleyiy","poem":2},{"lineBreak":true},{"text":"mıtsıqa qihna g'adarxhuniyle yugda vod.","poem":2}]},{"type":"heading","content":["«Sa insanıle q'öyre yugra»"]},{"type":"verse","number":7,"content":["Zak'le meed xəək avud q'əran vuççud deşin kar g'acu:"]},{"type":"verse","number":8,"content":[{"text":"sa vuşucar deşda insanniy vor,","poem":1},{"text":"mang'uqa dixır, çocur deşdaniy.","poem":2},{"text":"Mang'una iş ç'əvcab vooxhena deşdiy,","poem":1},{"text":"mang'un uleppıd karan ayts'e deşdiy.","poem":2},{"text":"Mang'vee cuke qiyğan deşdiy, «Zı şavnemeene inimeena qoxa?","poem":1},{"text":"Şavusvane zıcar zı kefıke ha'a?»","poem":2},{"text":"Manıd q'əran vuççud deşin kariy yı'q'na iş vobna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sa insanıle q'öyre yugra,","poem":1},{"lineBreak":true},{"text":"manbı qopxu hav'uyne işike","poem":1},{"text":"yugna hək' vuxhes.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sa qukkyork'ule,","poem":1},{"text":"mang'une hambazee mana oza qa'asda.","poem":2},{"text":"Vuccar əlyhəəname qukkyork'ulee,","poem":1},{"text":"mana oza qa'asda ixhes deş.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Məxrür q'öyre insan sacigee g'alyapk'ee,","poem":1},{"text":"manbışis g'üməda ixhes.","poem":2},{"text":"Vuccar g'alirxhuna nəxür arak'vayee?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sang'ule ğamxhay vaxxariyda vod,","poem":1},{"text":"q'öng'uleme ğameepxhay dağamda ixhes.","poem":2},{"text":"Xhebılle g'atnana tü'ı'b","poem":1},{"text":"zaaraba qooxas deş.","poem":2}]},{"type":"heading","content":["Milletıs ıkkiykıniyıd q'əran kar vodun"]},{"type":"verse","number":13,"content":["Kar deşda, k'orana ək'elynana mek'vna, bəç'ərne, mı'sləhət g'idiyxhene q'əsde paççahıle yugra vor."]},{"type":"verse","number":14,"content":["Mana mek'vna ine ölkee kar deşde xizanee yedike ixheeyir, zindaneeqa girxheeyir, mang'usse mançe qığeç'u paççah ixhes əxəsda."]},{"type":"verse","number":15,"content":["Zak'le g'acuyn, xəək avub iviykaran gırgınbı paççah ıxhayne mek'vung'uqab qihna vob əlyhəə."]},{"type":"verse","number":16,"content":["Mang'une vuk'lelqa sadıyn millet qətqəs-ələtqəs eyxhe deşiy. Qiyğiyne nasılbışis mana yik'eençe ixhes deş. Manıd q'əran vuççud deşin kar vodun, mıtsıqab qihna g'adapxhıniyk akar."]},{"type":"heading","content":["K'oran mı'sləhətbı"]},{"type":"verse","number":17,"content":["Allahne Xaaqa ı'qqəmee, ğu ha'an ats'axhxhe. Beynyavabışik'le co ha'an dyats'a, cone beynyavalis sik'ı q'urban ablyaa'a. Manbışik'le co haa'ana pisvalla vaats'a deş. Ğu manbışe ha'an xhinne hıma'a, man ha'amee, Allahne cuvabıl k'ırı alixhxhe."]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}