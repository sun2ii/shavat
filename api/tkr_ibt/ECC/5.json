{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Allahne ögiyl cuvab eyhesse fıkır ooxhne,","poem":1},{"text":"zarada ghal ımaaqa.","poem":2},{"text":"Allah xəə, ğume ç'iyel vor.","poem":1},{"text":"Mançil-alla k'ırra yuşan he'e.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İnsanee geeb fıkır opxhanxhee,","poem":1},{"text":"mang'us alikkı-gikkiyn nyak'bı g'yagva.","poem":2},{"text":"Həməxdıd geer yuşan ha'ang'vee","poem":1},{"text":"cuna bəç'əriyvalla aq'valqa qığaaha.","poem":2}]},{"type":"verse","number":3,"content":["Allahıs cuvab huvuyng'a, man çine gahıl he'e. Mang'us bəç'ərar vukkiykananbı deş, cuvab huvuyn kar he'e."]},{"type":"verse","number":4,"content":["Cuvab hidevuy, cuvab huvu hidi'iyle yugda vod."]},{"type":"verse","number":5,"content":["Hımaysar yiğne ghalen ğu bınaheeqa arçes. Vasqa g'axuvuyng'uk'le immeyhe: «Zı cuvab huvu, qotkuda deş hı'ı». Vas nişisınne Allahna yiğne cuvabılqa qəl avqu, ğu yiğne xıleka hı'iynçıkın he'ecen?"]},{"type":"verse","number":6,"content":["Geed nyak'bı g'acuy, geeb yuşan hav'iy q'əran vuççud deşin kar vod. Ğumee Allahıle qəq'ne."]},{"type":"heading","content":["Geed karne hək'ee"]},{"type":"verse","number":7,"content":["Vak'le nyaamecad karnang'vee kar deşda hoyç'an, qopkuvallayiy qotkuyn məhkama g'eliqqa huvu g'acveene, ghal aaqı ımaxva, məxdın kar eyxhenxhe. Sa xərıng'ul oo, mang'vee ha'ançiqa ilyakkana sa merna xərna vor. Manbışde vuk'lel ooyur manbışile xərna vor."]},{"type":"verse","number":8,"content":["Manbışde gırgınbışe ç'iyene aq'vayn hixhara'an kar alyaat'a, nyuq'vnen paççahır ats'ya'ana."]},{"type":"verse","number":9,"content":[{"text":"K'aarın ıkkanna","poem":1},{"text":"mançike ayts'ena deş.","poem":2},{"text":"Kar ıkkannar","poem":1},{"text":"g'azançıle idyayts'e.","poem":2},{"text":"Manıd q'əran vuççud deşin kar vodun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kar geed qıxaylette,","poem":1},{"text":"man otxhananbıb geeb qeebaxhe.","poem":2},{"text":"Uleppışik'le g'acuyle ğayrı,","poem":1},{"text":"iyesiys medın hucoona axva?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xıleppışika iş g'ooceng'vee geedıd, k'ıldad otxhunee,","poem":1},{"text":"mang'un nyak' ittuda eyxhe.","poem":2},{"text":"Vuxhun gyavts'una karnanamee,","poem":1},{"text":"tyulee ittiyk'al axvana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Zak'le xəək avud insanılqa ı'qqən sa xədın divanıd g'acuyn:",{"text":"iyesee kar se'eeyid, mang'ulqa ver abayle –","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"sa devxhesde işen mang'un kar ak'an ha'a.","poem":1},{"lineBreak":true},{"text":"Mane karane iyesiys dix ıxhamee,","poem":1},{"text":"mang'us helesın kar axva deş.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nəxüriy mana yedike ts'eler ıxha,","poem":1},{"text":"həməxürur ine dyunyeençe əlyhəəs.","poem":2},{"text":"Mana geer qorxveeyir,","poem":1},{"text":"cuka vuççud qıkkees əxəs deş.","poem":2}]},{"type":"verse","number":15,"content":["Manıd insanılqa ı'qqən sa xədın divan vod:",{"text":"insan dyunyelqa nəxüriy qarayle,","poem":1},{"text":"həməxürur ayk'anna.","poem":2},{"text":"Mıtsıs hav'uyne işike","poem":1},{"text":"mang'us hucoona?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gırgıne gahbışilycad cun g'ık,","poem":1},{"lineBreak":true},{"text":"miç'axiyvalee, dağamiyvalee,","poem":1},{"text":"ık'arbışee, qəlıka oyxhan.","poem":2}]},{"type":"verse","number":17,"content":["Qiyğa zalqa hitxhıriyn, insannemee otxhun-ulyodğuy yugda, qotkuda eyxheyiy. Allahee sa-q'öne yiğıs huvuyne ı'mree, xəək avur qorxuyke kef qığehecen. Mang'us axvasın man vod."]},{"type":"verse","number":18,"content":["Allahee şavusmecad geed kar huvuxhee, man oxhanas, cuna pay alyapt'as, cune qorxuyke kef ts'ıts'a'as hassırxhee, mana Allahna pay vobna."]},{"type":"verse","number":19,"content":["Məxrıne insanın yik' Allahee şad ha'ava, mang'vee cune ı'mrena k'ılyba haa'a."]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":19}