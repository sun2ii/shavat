{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":6,"content":[{"type":"heading","content":["I'mı'r vuççud deşin kar vodun"]},{"type":"verse","number":1,"content":["Zak'le xəək avud sa medınıd insanaaşilqa ı'qqən divan g'acuyn. Man insanaaşik qitxhuyn divan geed yı'q'ı'n vodun:"]},{"type":"verse","number":2,"content":["məxrına insan vorna Allahee mang'us kar, xəbvalla, ules ıkkanan gırgın helen. Saccu mane karake mang'us otxhun-ulyoğas haysar deş. Sa dyats'anecad insanee mang'un kar oyxhan. Manıd q'əran vuççud deşin kara idyalesın, vuk'lelqa adıyn divan vodun."]},{"type":"verse","number":3,"content":["Sa insanıqa vəş uşax ıxha, mang'vee xıliyna ı'mı'rıb hav'una. Mang'vee nimeena ı'mı'r hav'eeyib, mang'uk'le mısacad yiğ g'acu deş, mana k'eyxhır deş. Məxrıng'une hək'ee zı invaniy eyhes: qik'u yedike ıxhayn uşax mang'ule yugda eyxheyiy."]},{"type":"verse","number":4,"content":[{"text":"Mang'un yedike ıxhay","poem":1},{"text":"ıxha-ayk'anne booğak akar vod.","poem":2},{"text":"Mana miç'axiyvalee agu ayk'anna,","poem":1},{"text":"mang'un doyud ağmiş ha'a deş.","poem":2}]},{"type":"verse","number":5,"content":["Mang'uk'le verığın aq'vad g'ece deş, vuççudud ats'axhxhe deş. Məxdıne uşaxna vaxxariyvalla şene insanıle geeb vooxhe."]},{"type":"verse","number":6,"content":["Mane insanee q'öne yəqqees aazır sennana ı'mı'r hav'eeyib, mang'uk'le yiğ g'ıdecuxheene, mang'us mançike hucoona? Nekke qiyğa manbışin gırgınbı sa cigeeqa əlyhəəs."]},{"type":"verse","number":7,"content":[{"text":"İnsan cune vuxhnenemee qoxa,","poem":1},{"text":"meeb mang'una ul aats'e deş.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"K'orane ək'elynang'un,","poem":1},{"text":"bəç'ərıle ooqan ciga hucoone?","poem":2},{"text":"Kar deşing'usse vuceecar vuc","poem":1},{"text":"mebınbışde ögiyl ıkkees əxəxhee,","poem":2},{"text":"mang'us mançike hucoona hixharas?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vodunçis şadxhay,","poem":1},{"text":"deşin t'abal hı'iyle yugda vod.","poem":2},{"text":"Manıd q'əran vuççud deşin kar vodun,","poem":1},{"text":"mıtsıqab qihna g'adapxhıniyk akar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vonne gırgınçis, doyud huvu vodun.","poem":1},{"text":"İnsanır hucoo ıxhay ögiylycad ats'a.","poem":2},{"text":"İnsanısse cule Gucnang'uka","poem":1},{"text":"xıliyn ha'as əxə deş.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nimee geer yuşan he'ee,","poem":1},{"text":"manimeeyid q'əran cuvab ixhes.","poem":2},{"text":"Mançike insanıs hucoona hixharas?","poem":1}]},{"type":"verse","number":12,"content":["Şavuk'lene ats'a, əq' xhinne ı'lğəəne, cit'ane, q'ərane ı'mree insannemee yugun hucooniyxan? Şavusse insanık'le eyhes əxəyee, cule qiyğa xəək avud hucoobıniyxan ixhes?"]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}