{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"ECC","translationId":"tkr_ibt","name":"Mə'əllimın kitab","commonName":"Mə'əllimın kitab","title":"Mə'əllimın kitab","order":21,"numberOfChapters":12,"sha256":"eb6e76e4cfd593b09b218ddecfe53bbd61c92f45245777f5296ae7a47316b5c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tkr_ibt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["I'mren yəq'bı"]},{"type":"verse","number":1,"content":[{"text":"Yugun do yugne ətriyatıle,","poem":1},{"text":"qek'an yiğıd, yedike ıxhayne yiğıle yugda vod.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ak'nane xaaqa hark'ıniy,","poem":1},{"text":"otxhun-ulyodğuynane xaaqa hark'ıniyle yugda vod.","poem":2},{"text":"Qik'uy gırgıng'une vuk'lel vodun,","poem":1},{"text":"hasre üç'ürung'vee man yik'el aqqecen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aq'va qı'iy, əqəna hı'iyle yugda vod.","poem":1},{"text":"Aq'va qı'iy insanne yik'enemee yugda vod.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"K'orane ək'elynang'un yik' ak'nane xaa axva.","poem":1},{"text":"Beynyavaynme yik' otxhan-ulyoğane xaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"K'orane ək'elynang'une güxül k'ırı alixhxhiy,","poem":1},{"text":"beynyavayn ğu yug hı'iyle yugda vod.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beynyavayn əqəna,","poem":1},{"text":"k'umk'umuk avud gyotxhanne zazane sesık akar.","poem":2},{"text":"Manıd q'əran vuççud deşin kar vodun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"K'orane ək'elynang'vee insanaaşike gucuka kar alyaat'axhee,","poem":1},{"text":"manar beynyavalqa siyk'al.","poem":2},{"text":"Rüşvatınır insan yəqqı'le qığayhe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sa karan ç'əvxhay, mançine gidğılıyle yugda vod.","poem":1},{"text":"Sabırıkana insan vuceecar-vuc hagvang'ule yugna vor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zaraba qəl hımaa'a,","poem":1},{"text":"qəl beynyavabışde yik'eexhe vooxhena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Nya'a ılğeeç'uyn yiğbı inçile yugda ıxhava?» qimiyghan.","poem":1},{"text":"K'orana ək'el vuxhayke məxdın kar qiyghan deş.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"K'orane ək'elynane insanıqa","poem":1},{"text":"kar geednang'a sık'ıldad yugda eyxhe.","poem":2},{"text":"Mançin q'öyüd sana ıxhay","poem":1},{"text":"verığ g'oocene gırgıng'uneme yugda vod.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"K'orane ək'elinır,","poem":1},{"text":"pılın xhinne insan havacena.","poem":2},{"text":"Ats'aalike insanıs in hiyxhar:","poem":1},{"text":"k'orane ək'elin çine iyesiyna ı'mı'r havaace.","poem":2}]},{"type":"verse","number":13,"content":["Allahne işiqa ilyakke:",{"text":"Mang'vee k'yoç'an hı'iyn","poem":1},{"text":"şavusse qotku qa'as əxəyee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yugne yiğbışee şadra ixhe,","poem":1},{"text":"pisde yiğbışilid in ats'axhxhe:","poem":2},{"text":"inıd, şenıd Allahee itxhın,","poem":1},{"text":"insanık'le cule qiyğa ixhesınbı mats'axhxhecenva.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yizde q'ərane ı'mree zak'le geed kar g'acu:","poem":1},{"lineBreak":true},{"text":"qorkuna insan,","poem":1},{"text":"cune qorkuvaliqa ilydyakkı, qek'ana,","poem":2},{"text":"pisde insannab,","poem":1},{"text":"cune pisvaliqa ilydyakkı, ı'mı'r xıliy qooxhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Geerır qorkura mexhe,","poem":1},{"text":"ğucar ğu geerır k'orane ək'elika hımagva.","poem":2},{"lineBreak":true},{"text":"Nişil-allane ğucad vakın ha'as?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Geerır pisra mexhe,","poem":1},{"lineBreak":true},{"text":"bəç'ərra mexhe.","poem":1},{"text":"Nişil-allane ğu gah qidyabıcar qik'as?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İna mı'sləhət yik'el avqee yugba vob,","poem":1},{"text":"manasab yik'el hivxan hımaa'a.","poem":2},{"text":"Allahıle qəyq'ənang'vee q'önçulysana k'ırı iliyxhen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"K'orane ək'elin, ək'elynane insanıs,","poem":1},{"text":"şaharee vooxhene yits'ne xərıng'ule geeb gucxhe hoolena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Məxrına qorkuna insan deşda,","poem":1},{"text":"mang'vee saccu yugvallacab hee'ecen,","poem":2},{"lineBreak":true},{"text":"bınah hımaa'acen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"İnsanaaşe eyhene gırgınçilqa fıkır hımoole.","poem":1},{"text":"Manke vak'le yiğne nukaree vaqa hokanıd g'ayxhes deş.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Vak'le yugda ats'a vod,","poem":1},{"text":"ğunad menne insanaaşiqa geed hoku.","poem":2}]},{"type":"verse","number":23,"content":["Man gırgın zı k'orane ək'elika siliys ı'xı'.",{"text":"«Zı k'orane ək'elikana ixhesva» uvhu.","poem":1},{"text":"K'orana ək'elyme zake əq'əna vuxha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ixha atk'ıniyn karbı şake əq'əna,","poem":1},{"text":"geed k'orada vod.","poem":2},{"text":"Manbı şavuk'le iveekeyiy?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Zas k'orana ək'eliy ats'al","poem":1},{"text":"t'abal ha'as, xət qıxhes, ats'axhxhes ıkkan.","poem":2},{"text":"Zas pisde insanaaşina beynyavallayiy","poem":1},{"text":"ək'el deşinbışda bəç'əriyvalla vaats'a vuxhes vukkan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Zak'le ats'axhxhayn,","poem":1},{"text":"merıng'us gugu hav'una zəiyfa","poem":2},{"lineBreak":true},{"text":"qik'uyle q'ap'ıra vor.","poem":2},{"text":"Məng'ı'n yik' torak,","poem":1},{"text":"xıleppıd zincirık akar.","poem":2},{"text":"Allahne ulesqa yugra qarına insan","poem":1},{"text":"məng'ı'le hexvana.","poem":2},{"text":"Bınahnaname insan","poem":1},{"text":"məng'ı'sqa gixhasda.","poem":2}]},{"type":"verse","number":27,"content":["Mə'əllimee eyhen: zı gırgınçiqa sassadna ilyakkımee, manke ats'axhxha."]},{"type":"verse","number":28,"content":[{"text":"Zı t'abal he'eeyid, aveykı deş:","poem":1},{"lineBreak":true},{"text":"aazır adamiyne yı'q'nee","poem":1},{"text":"sa qorkuna aveykı,","poem":2},{"text":"manimeene zəiyfayne yı'q'neeme –","poem":1},{"text":"sa qorkuna aveykı deş.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Zalqa saccu sa kar hitxhır:","poem":1},{"text":"Allahee insanar qopkuba ipxhın,","poem":2},{"lineBreak":true},{"text":"manbımee alytipk'ılıynbı.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}