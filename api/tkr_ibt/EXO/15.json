{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"EXO","translationId":"tkr_ibt","name":"Qığeepç'iy","commonName":"Qığeepç'iy","title":"Qığeepç'iy","order":2,"numberOfChapters":25,"sha256":"248a30ed2f8100e4a45903a838a642354b5ef28dbb92bd5326acbb247b14101b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/tkr_ibt/EXO/40.json","totalNumberOfVerses":650},"chapter":{"number":15,"content":[{"type":"heading","content":["Mısayna mə'niy"]},{"type":"verse","number":1,"content":["Mane gahıl Mıseeyiy İzrailybışe Rəbbis ina mə'niy haa'a:",{"lineBreak":true},{"text":"– Rəbbis ina mə'niy qəpqəs,","poem":1},{"text":"Mang'vee Cun do geed axtı qı'ı!","poem":2},{"text":"Balkanıb, çil alixınar,","poem":1},{"text":"Mang'vee deryaheeqa g'av'u!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rəbb Yizda guciy mə'niy vorna,","poem":1},{"text":"Mang'vee zı g'attixhan hı'ı.","poem":2},{"text":"Mana Yizda Allah vorna,","poem":1},{"text":"zı Mana qıvats'a'asda!","poem":2},{"text":"Mana yizde dekkeeyid ı'bəədat hı'ına Allah vorna,","poem":1},{"text":"zı Mana axtı qa'as!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gırgıne duşmanaaşile ğamxhesde","poem":1},{"text":"Rəbbin do YAHVE","poem":2},{"noteId":2},{"text":"vodun!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dəv'əyne daşk'abışika fironna g'oşun","poem":1},{"text":"deryaheeqa dağav'u!","poem":2},{"text":"Misirin nekke yugun ç'ak'ınbı","poem":1},{"text":"Ç'ərane deryahın höbğü!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xhyan manbışile g'alysikkı,","poem":1},{"text":"k'oralybışeeqa manbı g'ayebı xhinne qavayk'an apk'ın!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rəbb, Ğu Yiğne gucuka qıvats'ı!","poem":1},{"text":"Ğu duşmanar g'ulyotal haa'a!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ğu Yiğne xənne gucuka,","poem":1},{"text":"Ğu qidvyaats'anbışikın ha'a!","poem":2},{"text":"Yiğne qəlın,","poem":1},{"text":"ts'ayın balybiy gyoxhan ha'an xhinne, manbı gyoovxhan hav'u!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yiğne nafasın xhyanbı","poem":1},{"text":"sacigeeqa sa'a,","poem":2},{"text":"Sacigeeqa sadıyne xhineke cabırbı ha'a,","poem":1},{"text":"İttehesu deryahne k'oralybışeedın xhyanbı qiyğara'anbı!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Duşmanee eyhenniy:","poem":1},{"text":"«Qihna girxhu, zı manbı avqas,","poem":2},{"text":"Aqqıyn karıd zı bit'al ha'as!","poem":1},{"text":"Mançike yizın rı'hcad ats'es!","poem":2},{"text":"Qiyğale xhineyid g'ılınc qığahas,","poem":1},{"text":"yizde xılekacab zı manbı gyapt'as!»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ğu manbışis uf üvxü,","poem":1},{"text":"deryahın manbı höbğü!","poem":2},{"text":"Gurğuşun xhineyib","poem":1},{"text":"manbı k'oralybışeene xhinek avqa apk'ın!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ya Rəbb, vornane Vaka sa aqqasda","poem":1},{"text":"allahaaşine əree?","poem":2},{"text":"Muq'addasvallee azamatıka,","poem":1},{"text":"Vasse xhinne mö'ücüzebı ha'as əxəna vornane?","poem":2},{"lineBreak":true},{"text":"Yiğne xəbvalile xhinne qəvəəq'ənasda merna vornane?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ğu sağın xıl hotkumee,","poem":1},{"text":"ç'iyeyn manbı höbğüynbı!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vaqa badaldyooxhena yugvallava,","poem":1},{"text":"Ğu xalq' g'attixhan hı'ı,","poem":2},{"lineBreak":true},{"text":"Ğu manbışis yəq haagu!","poem":2},{"text":"Ğu eyxhene Yiğne muq'addasne cigeeqa","poem":1},{"noteId":3},{"text":",","poem":1},{"text":"Ğu Yiğne gucuka quvkees!","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Milletbışik'le man g'ayxhı, tanbışeeqa zeze avxhas,","poem":1},{"text":"Filiştinar mançile geeb qəvəəq'ənas,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Edomun ç'ak'ınbı qəpq'ı'niyn alyabat'a,","poem":1},{"text":"Moav vuk'lek vukkeekanbışik zeze ooxha,","poem":2},{"text":"Kana'anın milletıd nyaqame ixhesın axva!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Havaasre manbışilqa zeze avkkecen, qəvəq'necen!","poem":2},{"text":"Rəbb, Yiğne xılene gucen,","poem":1},{"text":"Yiğın millet ılğeç'esmee","poem":2},{"text":"manbı g'ayelqa savk'alas,","poem":1},{"text":"nıq'-ç'ı'q' dena aaxvas!","poem":2},{"text":"Ya Rəbb, Ğu nukariyvalike g'attixhan hı'iyn millet ılğeç'esmee!","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Ya Rəbb, Ğu Yiğın millet qalessın Yiğne suvalqa,","poem":2},{"text":"Ğu Yiğne Xaasva g'əyxı'yne cigee, Ğu manbışis ciga qaa'as,","poem":1},{"text":"Ey Xudaavand, Ğu Yiğne xıleka itxhınne muq'addasne cigee!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Rəbbee gırgıne gahbışil, hammaşe paççahiyvalla haa'as!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":["Fironun dəv'əyn daşk'abı, balkanaaşil alepxıynbı deryaheeqa k'epç'ımee, Rəbbee manbışilqa deryahın xhyanbı yı'q'əlqa qalya'a. İzrailybımee deryahne xhyan deşde cigayle k'ena ılğeepç'ı avayk'ananbı."]},{"type":"verse","number":20,"content":["Harunne yuçee, peyğambar Mayramee, xıleqa dyaf alyat'umee, gırgıne yedaaşed xıleqa dyafbı alyat'u, məng'ı'qab qihna mık'ar ha'a avayk'ananbı."]},{"type":"verse","number":21,"content":["Mayramee manbışis ina mə'niy qəpqı':",{"text":"– Rəbbinemee qəpqe,","poem":1},{"text":"Mang'vee Vuc axtı qı'ı.","poem":2},{"text":"Balkanıb, cil alixınar","poem":1},{"text":"Mang'vee deryaheeqa g'av'u.","poem":2}]},{"type":"heading","content":["Q'ap'ın xhyan"]},{"type":"verse","number":22,"content":["Mısee İzrailybı Ç'ərane deryahısse Şur eyhene sahreeqa quvkekka. Xhebılle yiğna manbı sahrayle k'ena avayk'an, maa'ad manbışisqa xhyan qızaxxa deş."]},{"type":"verse","number":23,"content":["Manbı Mara eyhene cigeeqa qabı hipxhıriyng'a, maadın xhyanıd q'ap'ıdava ulyoğas əxə deş. Mançil-allad mane cigayn do Mara (q'ap'ın) axva."]},{"type":"verse","number":24,"content":["Milletın «Hucoone ulyoğasva?» Mısaylena haa'a giviyğal."]},{"type":"verse","number":25,"content":["Manke Mısee Rəbbilqa ona'a, Rəbbeeyid mang'uk'le sa os hagva. Mısee man os xhineeqa dağadaççe, mançile qiyğa man xhyan uloğasın xhinne qexhe. Rəbbee maa manbışis g'ayda-q'aanun huvu, maayib siliys üvxü."]},{"type":"verse","number":26,"content":["Mang'vee eyhen: – Şu Yizde, Rəbbine, vuşde Allahne cuvabıl yugda k'ırı alixhxheene, Yizde ögiyl qotkun işbı he'eene, Zı he'eva uvhuynçil k'ırı gyaqqı q'aanunbışee hagvan xhinne he'eene, Misirbışilqa g'axuvuyne ık'arbışin nencad şolqa g'axıles deş. Şu yug qaa'ana Rəbb Zı vorna."]},{"type":"verse","number":27,"content":["Manbı qavaylenbı Elim eyhene cigeeqa. Mane cigee yits'ıq'ölle (12) xhyan ı'lqəən cigayiy yights'al (70) xurmayna yiv vooxhe. İzrailybışe mane xhyanbı ı'lqəəne cigabışde hiqiy-alla çadırbı giyxə."]}],"footnotes":[{"noteId":2,"caller":"+","text":"YAHVE:in do cühüt'yaaşine mizel «Vuc vornava» cuvabık akar. İne kitabee in do «Rəbb» xhinne sak'ala'a.","reference":{"chapter":15,"verse":3}},{"noteId":3,"caller":"+","text":"Cigeeqa: inyaa İzrailyneyiy İyerusalimne hək'ee eyhe.","reference":{"chapter":15,"verse":13}}]},"thisChapterLink":"/api/tkr_ibt/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}