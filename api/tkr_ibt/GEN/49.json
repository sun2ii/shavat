{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"GEN","translationId":"tkr_ibt","name":"Ts'etta ıxhaynbı","commonName":"Ts'etta ıxhaynbı","title":"Ts'etta ıxhaynbı","order":1,"numberOfChapters":50,"sha256":"56ad0b6239ac0d7e1f8d5edb75358d2d8858f402fe27803ba28ec6c9506a6306","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/tkr_ibt/GEN/50.json","totalNumberOfVerses":1521},"chapter":{"number":49,"content":[{"type":"heading","content":["Yaaq'ubee dixbışis xayir-düə hoole"]},{"type":"verse","number":1,"content":["Yaaq'ubee dixbı qopt'ul eyhen: – Yizde k'anyaqa savaale, vuşde vuk'lelqa qalesınbı zı yuşan ha'as."]},{"type":"verse","number":2,"content":[{"text":"Yaaq'ubın dixbı, sabı zal k'ırı alixhxhe,","poem":1},{"text":"Vuşde dekkıl İzrailir k'ırı gyaqqe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ruven, ğu yizda ts'erriyna dix,","poem":1},{"text":"ğu yizda guc.","poem":2},{"text":"Ğu yedike zı mek'varanang'a","poem":1},{"text":"taq'atıkanang'a ıxha.","poem":2},{"text":"Ğu gırgıng'ule xərna,","poem":1},{"text":"qıvaats'ana vor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ğu xhyanık akar sa'as-qa'as əxə deş.","poem":1},{"lineBreak":true},{"text":"Vak'le man ats'axhxhe,","poem":1},{"text":"ğu yik' hı'ı yizde tyuleeqa k'iç'uva,","poem":2},{"lineBreak":true},{"text":"yizde xhunaşşeeşine sang'ıka g'alirxhuva,","poem":2},{"text":"vake xərna ixhes deş!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Şimoniy Levi çocar vob,","poem":1},{"text":"manbışe qəlasın ha'asva","poem":2},{"lineBreak":true},{"text":"g'ılınc xılyaqa alyaat'a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Manbı qəlıkanang'a","poem":1},{"text":"adamer gyabat'a,","poem":2},{"text":"yik'es ıkkanang'ad","poem":1},{"text":"manbışin həyvanar kara idyalesın xhinne qa'a.","poem":2},{"text":"Manbışe ək'elee aqqıyn karbı zı ha'as deş,","poem":1},{"text":"Zı manbışika sarçes deş.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fığan haa'ane manbışde qəlbışisiy","poem":1},{"text":"xıl ts'ıts'dyaa'ane bahaliyvalis bed-düə vuxhena.","poem":2},{"text":"Zı manbışike g'abıynbı sacigeeqa savaales havaasaras deş,","poem":1},{"text":"İzrailvolle oot'alasınbı.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yahud, yiğne çocaaşe ğu axtı qa'as,","poem":1},{"text":"duşmanaaşina gardan yiğne xıle vuxhes,","poem":2},{"lineBreak":true},{"text":"dekkın dixbıb vas k'yoozaras.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yizda dix, Yahud, ğu k'on qoodu-soodu qööne","poem":1},{"text":"mek'vne aslanık akar.","poem":2},{"text":"Ğu manzil haa'ane şirık akar,","poem":1},{"text":"horku-qorku ç'iyel g'ılexha,","poem":2},{"lineBreak":true},{"text":"Şavusse şir g'udokana'as əxəyee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Paççahiyvalla Yahudne xılençe mısacab əlyhəəs deş.","poem":1},{"text":"Gırgıne gahbışil vuk'lek vukkiy","poem":2},{"lineBreak":true},{"text":"mang'une nasılınbışisse mebınbışilqa ılğeç'es deş.","poem":2},{"text":"Nimeeletteyiy gırgın milletbı k'yozarasda vake paççah g'idyarı.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yahudıqa manimee xətta t'ımılen tayangbı eyxhe,","poem":1},{"text":"mang'us manbı qidiykkın cuna əməleb çik avt'alas vəəxəna,","poem":2},{"lineBreak":true},{"text":"çike hı'iyne çaxıree tanalinbıd hoğalas əxənbı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mang'une uleppışin adın ciga çaxırıle k'ışşeyda,","poem":1},{"text":"silibıd niknele cagvarada ixhes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zevulunun cigad deryahne mıglek ixhes,","poem":1},{"text":"maa'ad gamıbı ileezaras,","poem":2},{"lineBreak":true},{"text":"mang'un ciga Sidonnee şaharılqa hixharas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xurcunbı mıgal alyaat'u, manzil haa'ana","poem":1},{"text":"İssaxar taq'atıkane əməleyk akar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mang'us vuc manzilis ulyorzuliyn ciga yugda qadı,","poem":1},{"text":"maana nyaq'v cus vukkanəxüb g'avcu,","poem":2},{"text":"mang'vee yı'q' k'yozarı'ı mebınbışis iş haa'ana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dani İzrailyne nasılbışda sa vob,","poem":1},{"text":"mang'vee cune milletıs məhkama ha'as.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dani yəqqı'ne mıglekna xoçe xhinne ixhes.","poem":1},{"lineBreak":true},{"text":"Balkanne guvuyk üvxü,","poem":1},{"text":"çilyna yı'q'ı'hiyna g'ı'xə'əne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Rəbb, zı gozet ha'an Ğu mısayiy zı duşmanaaşike g'attixhan ha'as!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mebınbı Qadın cigabı q'əra qa'as ables,","poem":1},{"text":"mang'veeyib manbı g'e'eebaşeng'a q'əra qaa'as.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aşerne cigabışee otxhuniy barakayka ixhes,","poem":1},{"text":"mang'vee paççahaaşisıd otxhuniy alles.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naftali g'avkuyne maralık akar,","poem":1},{"text":"mang'uke g'abıynbı geeb micagınbı vuxhes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yusufmee, xhyan ı'lqəəne cigaysneene,","poem":1},{"text":"bıtağbıd cabırıle g'alysikkıyne tayangık akar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Duşmanar mang'ulqa qəlıka vukkaaşika k'yoohar,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"mang'un xıleppı gucuka vodva","poem":1},{"text":"mang'vee vuk xıle it'umda aqqaqqa.","poem":2},{"text":"Mang'us guc hoole vuxha","poem":1},{"text":"Yaaq'ubee ı'bəədat ha'ane Allahee.","poem":2},{"text":"Allah İzrailiqa çoban cune syuriyqa ilyakkan xhinne ilyakka.","poem":1},{"text":"Mana manbışda Suva vobna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yiğne dekkee ı'bəədat ha'ana","poem":1},{"text":"Allah hasre vas kumagxhecen,","poem":2},{"text":"Hasre Mang'vee vas xayir-düə hevlecen,","poem":1},{"text":"xəəne-ç'iyeyne xhyanbışike","poem":2},{"lineBreak":true},{"text":"ğu g'ıts'mayk'vancen,","poem":2},{"text":"vas geeb uşaxaariy çavra-vəq'ə helecen.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yiğne dekkına xayir-düə barakatnane çolbışileb geeb vob,","poem":1},{"lineBreak":true},{"text":"ğu manisa çocaaşile qıvaats'anava,","poem":1},{"text":"hasre man gırgın xayir-düəbı yiğınbı ixhecen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Benyamin bahalne ümulyuk akar,","poem":1},{"text":"miç'eeb k'on givk'u opxhan,","poem":2},{"lineBreak":true},{"text":"exhalid ing'uke-şeng'uke g'ayşuyn bit'al ha'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":["İna ələpqı'na yits'ıq'vəble (12) nasıl İzrailyna vobna. Dekkee dixbışde gırgıng'us, cus sik'ına inəxübna xayir-düə huvu."]},{"type":"heading","content":["Yaaq'ub qek'ana"]},{"type":"verse","number":29,"content":["Qiyğa Yaaq'ubee dixbışilqa əmr haa'a: – Zı sık'ınne gahıle qik'asda, zas yizde xizanısqa, zale ögee hapt'ıynbışde k'anyaqa əlyhəəs ıkkan. Zı Q'etbışda eyxhene Efronne çoleene mağaree k'eyxhe."]},{"type":"verse","number":30,"content":["Mana mağara Kana'anne ölkeene Mamrе eyhene cigays k'anene Maxpelayne çolee vobna. İbrıhımee mana mağara nyaq'v haa'asdemee Efronusse çoluka sacigeeniy alivşu."]},{"type":"verse","number":31,"content":["Maa'abniy İbrıhımiy cuna xhunaşşe Sarra, I'saq'iy cuna xhunaşşe Rivq'a k'evxhu. Zı Leayer maa'ar k'eyxhı."]},{"type":"verse","number":32,"content":["Man çolud, maana mağarab Q'etbışisseniy alivşu."]},{"type":"verse","number":33,"content":["Yaaq'ubee dixbışis əmr hav'u g'attirxhınmee, g'elybı tyuleeqa sı'ı qek'ana. Məxür mana ahaleeqa ayk'an."]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}