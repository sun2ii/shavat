{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"JON","translationId":"tkr_ibt","name":"Yunus peyğambarın kitab","commonName":"Yunus peyğambarın kitab","title":"Yunus peyğambarın kitab","order":32,"numberOfChapters":4,"sha256":"157e4dd7e55fa3ff9abd82f711c923468bcb03deb9878ba48969631a848b81f8","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tkr_ibt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yunusna düə"]},{"type":"verse","number":1,"content":["Rəbbee geed xədın baluğ qali'ı Yunus k'öğəs ilekka. Yunus baluğne vuxhnee xhebılle yiğnayiy xheyible xəmna axva."]},{"type":"verse","number":2,"content":["Yunusee baluğne vuxhnenang'a cune Rəbbis Allahıs inəxübna düə haa'a:"]},{"type":"verse","number":3,"content":[{"text":"Rəbb, zı dağamiyvalenang'a Valqa onu'u,","poem":1},{"text":"Ğunad alidghıniy quvuyn.","poem":2},{"text":"Zı ahaleençe ts'ir hav'u,","poem":1},{"text":"Vak'le yizda ts'ir g'avxhuna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ğu zı deryahne k'oralybışeeqa g'uvorxhul,","poem":1},{"text":"Zı xhyanbışde yı'q'nee axu,","poem":2},{"text":"Yiğın gırgın xhyanbıyiy dalğabı","poem":1},{"text":"Zal ooğançe ılğeeç'u.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Manke zı uvhuyn: «Ğu zı Vake əq'əna qı'ı,","poem":1},{"text":"Meed zak'le Yiğın muq'addasın xav İyerusalimee g'acesıncad».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nafas əlyhəəsme xhyanbı zalqa qadı,","poem":1},{"text":"K'oralybışeeqa qıkkı,","poem":2},{"text":"Vuk'lelqad xavsiy alitk'ır.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Suvabışde avqamee zı giç'una,","poem":2},{"text":"İttehesu Ğu dunyeyn akkabı zal oğa it'umetxha.","poem":1},{"text":"Ğumee yizda Rəbb Allah","poem":2},{"text":"Yizın tan k'oralybışeençe g'attixhan hı'iyn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yizda ı'mı'r k'yabat'amee,","poem":1},{"text":"Zı Rəbb yik'el qali'ı,","poem":2},{"text":"Yizda düə Valqa,","poem":1},{"text":"Yiğne muq'addas xaalqa hipxhırna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Şavaayiy nişiscad karaı'dəəne bütbışis ı'bəədat ha'a,","poem":1},{"text":"Manbışe Ğu yik'el hixan ha'a,","poem":2},{"lineBreak":true},{"text":"Colqana rəhı'm avaak'an haa'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zımee şukur haa'ane mə'niybışika","poem":1},{"text":"Vas q'urbanbı allya'as.","poem":2},{"text":"Zı huvuyn cuvab cigeeqa qalya'asın.","poem":1},{"text":"G'attivxhan haa'ana sa Rəbb Vuc vorna!","poem":2}]},{"type":"verse","number":11,"content":["Rəbbee baluğuk'le uvhuyng'a, mançin Yunus ghalençe xhyan deşde cigeeqa qığayhe."]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}