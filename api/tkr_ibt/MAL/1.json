{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"MAL","translationId":"tkr_ibt","name":"Malakiya peyğambarın kitab","commonName":"Malakiya peyğambarın kitab","title":"Malakiya peyğambarın kitab","order":39,"numberOfChapters":4,"sha256":"dfe898fa0d112c9f46f554a2ba3d1317e3983653ffef020d1cddc84f45155022","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tkr_ibt/MAL/4.json","totalNumberOfVerses":54},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Rəbbee Cun cuvab İzraililqa, Malakiya peyğambarıle ğana hixhar ha'a."]},{"type":"heading","content":["Rəbbee Yaaq'ub g'əyxı', Esavmee Cuke əq'əna qı'ı"]},{"type":"verse","number":2,"content":[{"text":"Rəbbee «Zas şu vukkiykıninbıva» eyhe.","poem":1},{"lineBreak":true},{"text":"Şossemee «Şi nəxübne vukkiykınva?» qiyghanas əxə.","poem":1},{"lineBreak":true},{"text":"Rəbbeeyid inva eyhe:","poem":1},{"lineBreak":true},{"text":"– Nya'a, Esav Yaaq'ubna çoc dişdiy vor?","poem":1},{"lineBreak":true},{"text":"Zımee, Yaaq'ub ıkkanaalin şu, cuke g'abıynbı, g'əvxü,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Esaviy mang'uke g'abıynbımee, Zı əq'əna qav'u.","poem":1},{"lineBreak":true},{"text":"Zı manbı vooxhen suvabı q'əra qa'as hassır,","poem":1},{"lineBreak":true},{"text":"manbışde doyulin cigabı çaq'alaaşis huvu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Edom vooxhene, Esavıke g'abıynbışisse eyhes əxə:","poem":1},{"lineBreak":true},{"text":"– Şakın ıxheeyid,","poem":1},{"lineBreak":true},{"text":"şi meed man hatq'ur-hiyxürin cigabı qa'asınbıcad.","poem":1},{"lineBreak":true},{"text":"Saccu Xəəne G'oşunbışde Rəbbee inva vod eyhe:","poem":1},{"lineBreak":true},{"text":"– Hasre, manbışe ale'ecencad,","poem":1},{"lineBreak":true},{"text":"Zımee meed hı'ğəkkar ha'asın.","poem":1},{"lineBreak":true},{"text":"Gırgıne gahbışil","poem":1},{"lineBreak":true},{"text":"manbışde ölkayk'le g'ulyopt'ulna ölkava eyhes,","poem":1},{"lineBreak":true},{"text":"coyub Rəbbina qəl avquyn millet xhinne qıvaats'as.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Şok'le man vuşdecad uleppışika g'acumee,","poem":1},{"lineBreak":true},{"text":"şucad eyhes: «İzrailiked şaqana, Rəbbin do axtıda vod!»","poem":1}]},{"type":"heading","content":["Rəbbis dekkanan q'urbanbı"]},{"type":"verse","number":6,"content":[{"text":"Xəəne G'oşunbışde Rəbbee eyhen:","poem":1},{"lineBreak":true},{"text":"– Ay Yizın do qizar hidya'an kaahinar!","poem":1},{"lineBreak":true},{"text":"Dixee dekkıs,","poem":1},{"lineBreak":true},{"text":"g'uleeyib cune iyesiys hı'rmat giviyxhe.","poem":1},{"lineBreak":true},{"text":"Zı Dekxheene, nyavxha şu Zas giviyxhena hı'rmat?","poem":1},{"lineBreak":true},{"text":"Zı İyesiyxhee meeb nyavxha şu Zas giviyxhena hı'rmat?","poem":1},{"lineBreak":true},{"text":"Şosse «Nəxüdne şi Yiğın do qizar hidi'ıva?» qiyghanas əxə.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"– Şu Yizde q'urbanbı allya'ane cigalqa","poem":1},{"lineBreak":true},{"text":"kara idyalesın Zasın otxhuniy adı giyxhe.","poem":1},{"lineBreak":true},{"text":"Mançikad, «Şi Vas dekkanan nəxüdne ha'ava?» qiyghan.","poem":1},{"lineBreak":true},{"text":"Şu Rəbbin q'urbanbı allya'an ciga qizar hidi'ı,","poem":1},{"lineBreak":true},{"text":"məxüd Mang'us dekkanan ha'a.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Şu bı'rq'ı'n həyvanar q'urbanna alli'iy","poem":1},{"lineBreak":true},{"text":"yugunne vod?","poem":1},{"lineBreak":true},{"text":"K'aana, vuk'arna həyvan q'urbanna ablyav'uy","poem":1},{"lineBreak":true},{"text":"nya'a yugunne vod?","poem":1},{"lineBreak":true},{"text":"Məxbına sa həyvan yiğne ölkayne xərıng'us hevle,","poem":1},{"lineBreak":true},{"text":"ilekke mang'us ğu ikkiykanaseeva,","poem":1},{"lineBreak":true},{"text":"mang'vee yiğna haa'asee?","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Həşde Allahıs düə hee'e,","poem":1},{"lineBreak":true},{"text":"Mang'vee şos rəhı'm hee'ecen.","poem":1},{"lineBreak":true},{"text":"Şu məxdın q'urbanbı allya'amee,","poem":1},{"lineBreak":true},{"text":"Mana şoqa yugra eyxheye?","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vuşde sang'vee, Yizde q'urbanbı allya'ane cigee,","poem":1},{"lineBreak":true},{"text":"q'ərane cigeeqa ts'a gyoxhxhan ha'asse,","poem":1},{"lineBreak":true},{"text":"Yizde xaan akkabıcad qı'iynxhiy yugda eyxheyiy!","poem":1},{"lineBreak":true},{"text":"Yizın yik' şoka gyotxhan deş,","poem":1},{"lineBreak":true},{"text":"şu allya'an q'urbanbıd alyaat'as deş!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Verığ ılqəəne cigeençe, k'yooçene cigeeqamee,","poem":1},{"lineBreak":true},{"text":"Yizın do milletbışde yı'q'nee axtıda vod!","poem":1},{"lineBreak":true},{"text":"Gırgınəəng'ə Yizde doyule ətirbı gyoxhxhan ha'a,","poem":1},{"lineBreak":true},{"text":"məttın paybı adayle!","poem":1},{"lineBreak":true},{"text":"Man Yizın do milletbışde yı'q'nee,","poem":1},{"lineBreak":true},{"text":"axtıda ıxhayke ha'a!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Şumee, «Rəbbine q'urbanbı allya'ane cigaylin otxhuniy muq'addasın deş vod,","poem":1},{"lineBreak":true},{"text":"man qizar hide'eeyid eyxheva» uvhu,","poem":1},{"lineBreak":true},{"text":"mançina muq'addasiyvalla avaak'an haa'a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ooğançe «İnimeena əq'übavad!» uvhu,","poem":1},{"lineBreak":true},{"text":"şu mançilqa yı'q' sak'al ha'a!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəybışde Xərıng'vee Rəbbee eyhe!","poem":1},{"lineBreak":true},{"text":"Şu Zas q'urbanna ablyaa'asva","poem":1},{"lineBreak":true},{"text":"q'ööq'üna, k'aana, vuk'arna həyvan abeene,","poem":1},{"lineBreak":true},{"text":"Zı mana şoke alyabat'aye?","poem":1},{"lineBreak":true},{"text":"Məxüd Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Syuruneençe g'apsırne yugne g'argıne cigee,","poem":1},{"lineBreak":true},{"text":"Xudaavandays q'ı'bı'lyna həyvan abıyne horalays bed-düə vuxhena!","poem":1},{"lineBreak":true},{"text":"Zı inekke xərna Paççahva,","poem":1},{"lineBreak":true},{"text":"gırgıne milletbışe Yizın do axtı qa'a!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/MAL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/MAL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}