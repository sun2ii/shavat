{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"MAL","translationId":"tkr_ibt","name":"Malakiya peyğambarın kitab","commonName":"Malakiya peyğambarın kitab","title":"Malakiya peyğambarın kitab","order":39,"numberOfChapters":4,"sha256":"dfe898fa0d112c9f46f554a2ba3d1317e3983653ffef020d1cddc84f45155022","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tkr_ibt/MAL/4.json","totalNumberOfVerses":54},"chapter":{"number":2,"content":[{"type":"heading","content":["Kaahinaaşis bed-düə haa'a"]},{"type":"verse","number":1,"content":[{"text":"Xəəne G'oşunbışde Rəbbee eyhe vod:","poem":1},{"lineBreak":true},{"text":"– Kaahinar, ina əmr həşde vuşdemee vob:","poem":1},{"lineBreak":true},{"text":"Yizde cuvabıl k'ırı ilydiyxheene,","poem":1},{"lineBreak":true},{"text":"Yizın do yik'eençe axtı qıde'eene,","poem":1},{"lineBreak":true},{"text":"şolqa bed-düə gyooğav'u,","poem":1},{"lineBreak":true},{"text":"vuşun xayir-düəbı bed-düəlqa sak'al ha'as.","poem":1},{"lineBreak":true},{"text":"Şu Yizın do yik'eençe axtı qıdi'ıva,","poem":1},{"lineBreak":true},{"text":"şu Yizda bed-düə alyapt'ınacab.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zı şol-alla şoke g'abıynbışikınıd ha'asın.","poem":1},{"lineBreak":true},{"text":"Bayrambışil şu q'urbanna alli'iyne həyvanaaşin xhidbı","poem":1},{"lineBreak":true},{"text":"Zı vuşde aq'vabışile k'ena ı'xəs,","poem":1},{"lineBreak":true},{"text":"mançika sacigee şu dağaa'as.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manke şok'le ats'axhxhes,","poem":1},{"lineBreak":true},{"text":"Zı mana əmr şoka, Leviyne nasılıka, hav'una mugaavile","poem":1},{"lineBreak":true},{"text":"aaxvecenva g'axuvu.","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zı Leviyne nasılıka barakatnana ı'mı'r","poem":1},{"lineBreak":true},{"text":"hoolena mugaavileniy hav'u.","poem":1},{"lineBreak":true},{"text":"Zas hı'rmat gyuvxhuva,","poem":1},{"lineBreak":true},{"text":"Zı manbışis man gırgın huvuyn.","poem":1},{"lineBreak":true},{"text":"Manbıb Zale qəpq'ı'ninbı,","poem":1},{"lineBreak":true},{"text":"Yizde doyusub hı'rmat gyuvxhuna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Manbışde mizel qopkuna Q'aanun vuxha,","poem":1},{"lineBreak":true},{"text":"ghaleençed horbı qığeeç'enbı deşdiy.","poem":1},{"lineBreak":true},{"text":"Manbışe Yizde ögiyl yugnayiy qopkuna ı'mı'r hav'u.","poem":1},{"lineBreak":true},{"text":"Geebınbı manbışe yəqqı'lqa sav'u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kaahinaaşine ghalen ats'al havaces ıkkan,","poem":1},{"lineBreak":true},{"text":"insanaaşisse manbışde mizele","poem":1},{"lineBreak":true},{"text":"Q'aanun t'abal haa'as vəəxecenva.","poem":1},{"lineBreak":true},{"text":"Kaahinar Xəəne G'oşunbışde Rəbbee g'axuvuynbı vob.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Şumee, kaahinar, yəqqı'le qığeepç'ıynbı,","poem":1},{"lineBreak":true},{"text":"şu helene ats'aalybışika","poem":1},{"lineBreak":true},{"text":"mansanbıb şoqab qihna habğı.","poem":1},{"lineBreak":true},{"text":"Zı Leviyne nasılıka hav'una mugaavile","poem":1},{"lineBreak":true},{"text":"şu havakkal hav'una.","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Şu Yizde yəqqı'n apk'ın deş,","poem":1},{"lineBreak":true},{"text":"Q'aanunuka g'acesde işbışee,","poem":1},{"lineBreak":true},{"text":"şu gırgıng'uqa sa uleka ilyaakı deş.","poem":1},{"lineBreak":true},{"text":"Mançil-allab Zı şu milletnecab g'eliqqa hevles,","poem":1},{"lineBreak":true},{"text":"k'ap'ik'ıle avqa qaa'as.","poem":1}]},{"type":"heading","content":["Yahudayne milletın Allahıkana mugaavile havaakal haa'a"]},{"type":"verse","number":10,"content":[{"text":"Yişda gırgıng'una Dek sa dişde vor?","poem":1},{"lineBreak":true},{"text":"Şi sa Allahee dişde ipxhın?","poem":1},{"lineBreak":true},{"text":"Nya'a manke şi dekkaaşika hav'una mugaavileyna","poem":1},{"lineBreak":true},{"text":"muq'addasiyvalla avaakan haa'a,","poem":1},{"lineBreak":true},{"text":"sana-sang'us horbı ha'a?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yahudayne milletın Allahıs xayaanat hı'ı.","poem":1},{"lineBreak":true},{"text":"İzraileeyiy İyerusalimee həlyvəəq'ənasın işbı hı'ı:","poem":1},{"lineBreak":true},{"text":"Yahudabışee menne allahbışis","poem":1},{"lineBreak":true},{"text":"ı'bəədat ha'an yedar hav'u,","poem":1},{"lineBreak":true},{"text":"Rəbbis ıkkananne, muq'addasne cigayna","poem":1},{"lineBreak":true},{"text":"muq'addasiyvalla avaakan hav'u.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Man hı'ına insan vuşu ıxhay ixhecen,","poem":1},{"lineBreak":true},{"text":"Xəəne G'oşunbışde Rəbbis q'urban ablyaa'ana çikana ixheeyir,","poem":1},{"lineBreak":true},{"text":"Rəbbee mana Yaaq'ubne çadırbışisse g'e'eşşecen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Şu in karıd ha'an:","poem":1},{"lineBreak":true},{"text":"gyaaşu-gyaaxu, Rəbbin q'urbanbı allya'an cigad","poem":1},{"lineBreak":true},{"text":"ulene nağıka gyatsts'a'an.","poem":1},{"lineBreak":true},{"text":"Məxüd, şu adıyne q'urbanıqa Rəbb sak'ı ilydakkava,","poem":1},{"lineBreak":true},{"text":"manbı şoke ilydyaat'ava ha'a.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Şosse «Nişil allavane?» qidghın ha'as əxə.","poem":1},{"lineBreak":true},{"text":"Ğu mek'vranang'a hey'iyne zəiyfayneyiy yiğne yı'q'nee","poem":1},{"lineBreak":true},{"text":"Şahad Rəbb vorna.","poem":1},{"lineBreak":true},{"text":"Ğu, mana yiğna nikahıkana xhunaşşe yixhayka ilydyakkı,","poem":1},{"lineBreak":true},{"text":"məng'ı's xayaanat hı'ı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Allahee şu sa tan, sa rı'h xhinne dişde ipxhın?","poem":1},{"lineBreak":true},{"text":"Nya'asdiyxan Mang'us şu sa vuxha vukkan?","poem":1},{"lineBreak":true},{"text":"Mang'us Cunemee nasılniy vukkan.","poem":1},{"lineBreak":true},{"text":"Mançil-allab şucab şu havaace.","poem":1},{"lineBreak":true},{"text":"Hasre şavaacad mek'vranang'a hey'iyne xhunaşşeys","poem":1},{"lineBreak":true},{"text":"xayaanat hıma'acen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"İzrailyne Allahee, Rəbbee eyhen:","poem":1},{"lineBreak":true},{"text":"– Xhunaşşeyka yugra dexhena,","poem":1},{"lineBreak":true},{"text":"mana qıxeelena Zak'le g'ımece vor.","poem":1},{"lineBreak":true},{"text":"Mançil-allad şucab şu havaace,","poem":1},{"lineBreak":true},{"text":"xayaanat hıma'a!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"heading","content":["Rəbb məhkama alğahas ayres"]},{"type":"verse","number":17,"content":[{"text":"Vuşde yuşan hav'uyn Rəbb ozar ha'a.","poem":1},{"lineBreak":true},{"text":"«Nəxürne şi Mana ozar ha'ava?»","poem":1},{"lineBreak":true},{"text":"şosse qiyghanasıd əxə.","poem":1},{"lineBreak":true},{"text":"Şu eyhen:","poem":1},{"lineBreak":true},{"text":"– Qəlasın ha'anbı Rəbbine ulesqa yugba qöö,","poem":1},{"lineBreak":true},{"text":"Rəbbis manbı vukkananbı.","poem":1},{"lineBreak":true},{"text":"Şucadıd meed eyhen:","poem":1},{"lineBreak":true},{"text":"– Qopkuvalin məhkama alğayhena Allah nyaane?","poem":1},{"lineBreak":true},{"text":"Mançikar şu Mana ozar ha'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/MAL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/MAL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/MAL/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}