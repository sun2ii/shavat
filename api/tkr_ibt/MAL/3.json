{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"MAL","translationId":"tkr_ibt","name":"Malakiya peyğambarın kitab","commonName":"Malakiya peyğambarın kitab","title":"Malakiya peyğambarın kitab","order":39,"numberOfChapters":4,"sha256":"dfe898fa0d112c9f46f554a2ba3d1317e3983653ffef020d1cddc84f45155022","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tkr_ibt/MAL/4.json","totalNumberOfVerses":54},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Haane, Zı g'axuvuna ı'qqə vor.","poem":1},{"lineBreak":true},{"text":"Mana Zale ögee ark'ın yəq qaa'as.","poem":1},{"lineBreak":true},{"text":"Şu t'abal ha'ana Xudaavand","poem":1},{"lineBreak":true},{"text":"sayangara Cune İyerusalimeene xaaqa qales.","poem":1},{"lineBreak":true},{"text":"Şos g'aces ıkkanna, mugaavileyn cuvab","poem":1},{"lineBreak":true},{"text":"allesda qales.","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vuşune öörxəs Rəbb qarıne yiğıl?","poem":1},{"lineBreak":true},{"text":"Vuşune öörxəs Mana qarımee?","poem":1},{"lineBreak":true},{"text":"Mana xhiməə qa'an ts'a xhinneyiy","poem":1},{"lineBreak":true},{"text":"mətta'an sap'ın xhinne ixhes.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbbee Leviyna nasıl mətta'as.","poem":1},{"lineBreak":true},{"text":"Mang'vee man k'ınəəğəyiy nuk'ra ts'ayıka rışşi qı'ı,","poem":1},{"lineBreak":true},{"text":"mətta'ane insanee xhinne ha'as.","poem":1},{"lineBreak":true},{"text":"Mançile qiyğa manbışe Rəbbis qotkuyn q'urbanbı allya'as.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manke Yahudayne ölkeeyiy İyerusalimee","poem":1},{"lineBreak":true},{"text":"avaalıyne yiğbışil allya'an,","poem":1},{"lineBreak":true},{"text":"ögiylyne senbışil allya'an q'urbanbı xhinne","poem":1},{"lineBreak":true},{"text":"Rəbbisqa yugda qales.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zı vuşun məhkama alğahasdemee, şosqa ayres.","poem":1},{"lineBreak":true},{"text":"Cadubı ha'anbı, zina ha'anbı,","poem":1},{"lineBreak":true},{"text":"horbışika k'ın g'iysaranbı, işçiyn pıl qidelenbı,","poem":1},{"lineBreak":true},{"text":"adamer hapt'ı avxuyn yedariy","poem":1},{"lineBreak":true},{"text":"dek, yed dena avxuyn uşaxar t'yaats'axal haa'anbı,","poem":1},{"lineBreak":true},{"text":"menne cigeençe qabıynbı g'e'eebaşenbı,","poem":1},{"lineBreak":true},{"text":"Zale qı'dəəq'ənanbı man şu ha'an karbı","poem":1},{"lineBreak":true},{"text":"Zı sık'ınne gahıle aq'valqa qığahas!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zı Rəbb vorna, badaldexhena.","poem":1},{"lineBreak":true},{"text":"Yaaq'ubıke g'abıynbı, şunab badal meebaxhe!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yizde əmrbışilqa şu dekkaaşine gahıle gibğıl","poem":1},{"lineBreak":true},{"text":"yı'q'bı sak'al ha'a.","poem":1},{"lineBreak":true},{"text":"Zalqana savk'le, Zınar şolqa sak'alasda!","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1},{"lineBreak":true},{"text":"Şossemee «Nəhı'bna savk'alasva?»","poem":1},{"lineBreak":true},{"text":"qidghınıd ha'as əxə.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İnsaneeyid Allahıke qöqəyee?","poem":1},{"lineBreak":true},{"text":"Şumee Zake qöqən.","poem":1},{"lineBreak":true},{"text":"«Vake hucoona qöqəva?» şosse qiyghanas əxə.","poem":1},{"lineBreak":true},{"text":"Yits'ınçina sa pay","poem":1},{"noteId":0},{"text":", sayid Zas ikkekan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Milletıncad Zake qöqənçil-alla,","poem":1},{"lineBreak":true},{"text":"vuşde gırgıng've bed-düə alyapt'ı.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yits'ınçina sa pay bıkırba able,","poem":1},{"lineBreak":true},{"text":"Yizde xaa oxhanasın kar ixhecen.","poem":1},{"lineBreak":true},{"text":"Şu mançika Zı siliys ı'xe!","poem":1},{"lineBreak":true},{"text":"Nya'a, Zı mançile qiyğa şos xəən g'uleppı aaqas dişde,","poem":1},{"lineBreak":true},{"text":"hexxalika barakat hevles dişde?","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zı ts'irtyaaşisqa vuşun ezuyn","poem":1},{"lineBreak":true},{"text":"kar oxhanas hassaras deş,","poem":1},{"lineBreak":true},{"text":"vuşde tayangbışile t'ımılid nyaqacad ixhes deş.","poem":1},{"lineBreak":true},{"text":"Məxüd Xəybışde Xərıng'vee Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vuşda ölka micagne cigalqa savk'uva,","poem":1},{"lineBreak":true},{"text":"gırgıne milletbışecad şok'le baxtivarva eyhes.","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"heading","content":["Qopkuynbışda hək'"]},{"type":"verse","number":13,"content":["«Şu Zak'le ivdyaak'asın cuvabbı uvhuva»",{"text":"Rəbbee eyhe.","poem":1},{"lineBreak":true},{"text":"Şossemee «Nya'a, şi Vak'le hucoone uvhuva?»","poem":1},{"lineBreak":true},{"text":"qiyghanas əxə.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Şu uvhuyn: «Allahıs ı'bəədat hı'iy,","poem":1},{"lineBreak":true},{"text":"nişiscad karaı'dəən kar vodun.","poem":1},{"lineBreak":true},{"text":"Mang'vee eyhenbı hı'ı,","poem":1},{"lineBreak":true},{"text":"Xəəne G'oşunbışde Rəbbine ögiyl hapq'ır iviykıriyke nya'a,","poem":1},{"lineBreak":true},{"text":"şas hucoone ıxha?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Şi həşde cocab-co axtıba vukkekanbışik'le","poem":1},{"lineBreak":true},{"text":"baxtivararva eyhe.","poem":1},{"lineBreak":true},{"text":"Qəlasın ha'anbışin işbıd yugda ayk'an,","poem":1},{"lineBreak":true},{"text":"Allah siliys ı'xı'yxənbıb cazaake g'ittiviyxhananbı».","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Mane gahıl Rəbbile qəvəyq'ənanbı",{"text":"sana-sang'uka yuşan haa'a vooxhe.","poem":1},{"lineBreak":true},{"text":"Manbışe yuşan ha'an Rəbbik'le g'iyxhe ıxha,","poem":1},{"lineBreak":true},{"text":"Mang'vee mançil yugda k'ırı iliyxhe.","poem":1},{"lineBreak":true},{"text":"Rəbbile qəpq'ı'n Mang'une doyus hı'rmat giviyxhenbışdemee,","poem":1},{"lineBreak":true},{"text":"Mang'une ögiyl manbışin işbı oyk'anan kitab aaqı eyxhe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xəəne G'oşunbışde Rəbbee eyhen:","poem":1},{"lineBreak":true},{"text":"– Mane yiğıl Zı manbışike Zas gıranın insanar haa'as.","poem":1},{"lineBreak":true},{"text":"Dekkıs vucee eyhen ha'ana dix nəxüriy qiykkan,","poem":1},{"lineBreak":true},{"text":"Zasıb manbı məxüb qivikkanasınbı.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mane gahıl şosse qorkung'uke pisda,","poem":1},{"lineBreak":true},{"text":"Allahıs g'ullux ha'ang'uke hidya'ana","poem":1},{"lineBreak":true},{"text":"meer curaa'as əxəsda.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Yits'ınçina sa pay: Allahee İzrailybışis huvuyne Q'aanune otk'unin: şagavnayiy həyvanaaşina yits'ınçina pay Allahne yəqqə hevles vukkan. Mane Allahne yəqqə huvuyne karaka Allahın Xav havace ıxha. Mane karake sayıd maane kaahinaaşe otxhan ıxha.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/tkr_ibt/MAL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/MAL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/MAL/2.json","previousChapterAudioLinks":{},"numberOfVerses":18}