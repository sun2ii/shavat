{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"MAL","translationId":"tkr_ibt","name":"Malakiya peyğambarın kitab","commonName":"Malakiya peyğambarın kitab","title":"Malakiya peyğambarın kitab","order":39,"numberOfChapters":4,"sha256":"dfe898fa0d112c9f46f554a2ba3d1317e3983653ffef020d1cddc84f45155022","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tkr_ibt/MAL/4.json","totalNumberOfVerses":54},"chapter":{"number":4,"content":[{"type":"heading","content":["Rəbbin yiğ"]},{"type":"verse","number":1,"content":[{"text":"Xəəne G'oşunbışde Rəbbee eyhen:","poem":1},{"lineBreak":true},{"text":"– Peşt xhinne gyotxhanan yiğ k'ane qexhe vod.","poem":1},{"lineBreak":true},{"text":"Gırgın cocab co axtıba vukkekanbıyiy pisvalla haa'anbı,","poem":1},{"lineBreak":true},{"text":"mane yiğıl balybiy xhinne gyooxhanas.","poem":1},{"lineBreak":true},{"text":"Mane k'ane qexhene yiğın","poem":1},{"lineBreak":true},{"text":"manbı gyooxhan haa'asınbı.","poem":1},{"lineBreak":true},{"text":"Manbışike kokbıd, bıtağbıd axvas deş.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zale qəvəyq'ənanbışdemeeme,","poem":1},{"lineBreak":true},{"text":"Qopkuvalina verığ ılqevç'es.","poem":1},{"lineBreak":true},{"text":"Mançine şü'ülee yug qav'iy ixhes.","poem":1},{"lineBreak":true},{"text":"Ağıleençe g'aykkiyn q'ıkar xhinne şu huvaagas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pisınbı şu kööq'əsınbı.","poem":1},{"lineBreak":true},{"text":"Zı man ha'asde yiğıl,","poem":1},{"lineBreak":true},{"text":"manbı vuşde g'elybışik avub yı'q xhinne vuxhes.","poem":1},{"lineBreak":true},{"text":"Məxüd Xəəne G'oşunbışde Rəbbee eyhe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yizda nukar Mısa Xorevne suvalynang'a,","poem":1},{"lineBreak":true},{"text":"Zı mang'us İzrailyne milletnemeecab huvuna Q'aanun,","poem":1},{"lineBreak":true},{"text":"Yizın g'aydabıyiy əmrbı şu yik'el aqqe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"İlyaake, Rəbbin xədın, dağamın yiğ qalesse,","poem":1},{"lineBreak":true},{"text":"Zı şosqa İlyas peyğambar g'axıles.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zı qarı in cigabı","poem":1},{"lineBreak":true},{"text":"kunfa-yakun hıma'acenva,","poem":1},{"lineBreak":true},{"text":"Mang'vee dekkaaşin yik'bı dixbışilqa,","poem":1},{"lineBreak":true},{"text":"dixbışinbıd dekkaaşilqa sak'al ha'as.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}