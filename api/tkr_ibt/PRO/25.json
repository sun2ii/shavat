kr_ibt/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}