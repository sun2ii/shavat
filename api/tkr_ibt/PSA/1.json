mee","poem":1},{"text":"məxbınbı deş vob,","poem":2},{"text":"manbı mıtsın alixa'an","poem":1},{"text":"balybiy xhinnee vooxhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mançil-allab pisınbışisse","poem":1},{"text":"məhkamee,","poem":2},{"text":"bınahnanbışisseb","poem":1},{"text":"qopkuyn insanarnane maclisee","poem":2},{"text":"ulyoozaras vəəxəs deş.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nya'a, Rəbbee qopkuynbışda yəq","poem":1},{"text":"dişde havaace?!","poem":2},{"text":"Pisınbışde yəqqı'nıb","poem":1},{"text":"manbı gyapt'as hoot'al.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/2KI/2.json","previousChapterAudioLinks":{},"numberOfVerses":6}