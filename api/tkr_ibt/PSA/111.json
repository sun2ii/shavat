{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Rəbbilqa şukur hee'e!","poem":1},{"lineBreak":true},{"text":"Nimee baxtivariy Rəbbile qəyq'ənna,","poem":1},{"text":"Mang'un əmrbı yik'eençe ha'ana!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Qəyq'anang'un uşaxar ç'iyeyne aq'val gucuka vuxhes,","poem":1},{"text":"Qopkuyng'unbışde uşaxaaşeeb xayir-düə alyapt'as.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qopkuynbı karnanbı, barakatnanbı vuxhes,","poem":1},{"text":"Manbışda qopkuvalla, mısacab aagvales deş.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Miç'axiyvaleeyid qopkuynbışdemee nur ixhes,","poem":1},{"text":"Manbı yugun, rəhı'mıkan, qopkuyn insanar vob.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qidiykkın borcbı helenbışiqayiy horbı hidya'anbışiqa","poem":1},{"text":"yugna ı'mı'r vuxhes.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Məxbın insanar mısacab qaçaaxaras deş,","poem":1},{"text":"Qopkuyn insanar hammaşe yik'bışee aaxvas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Manbı pisde xabarıle qəvəəq'ənas deş,","poem":1},{"text":"Rəbbilqa qibzırva manbışin yik'bı it'umda ixhes.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Manbışin yik'bı it'umda vod, manbı qəvəəq'ənas deş,","poem":1},{"text":"Manbışik'le con duşmanar avub aaxva g'avces.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Manbışe con var-devlet, kar deşinbışis qidiykkın bit'al hı'ı,","poem":1},{"text":"Manbışda qopkuvallab hammaşiys aaxvas,","poem":2},{"text":"Manbışde gucus geeb hı'rmat gyuvxhes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Karaı'dəəne insanık'le man g'acu qəl vuxhes,","poem":1},{"text":"Manbışe mizyar ats'ak'vanas, əəq'əsınbı.","poem":2},{"text":"Manbışis ıkkananbı ixhes deş.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":10}