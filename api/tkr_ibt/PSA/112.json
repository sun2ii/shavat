{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Rəbbilqa şukur hee'e!","poem":1},{"lineBreak":true},{"text":"Rəbbin nukarar, şukur hee'e,","poem":1},{"text":"Rəbbine doyus şukur hee'e!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"G'iyniyke şaqa, gırgıne gahbışis","poem":1},{"text":"Rəbbin do axtı qe'e!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Şargıle garbılqamee","poem":1},{"text":"Rəbbine doyus şukur hee'e!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rəbb gırgıne milletbışile axtıra vor,","poem":1},{"text":"Mang'una xəbvallab xəybışileb axtıba vob!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Axtıne xəybışeene taxtıl gyu'urne,","poem":1},{"text":"Yişde Rəbbik Allahık akarna vornane?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xəəqə, ç'iyeyqa","poem":1},{"text":"K'yorzul ilyakkana Mana vor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mang'vee vuççud deşda, toozençe suğoots'a'a,","poem":1},{"text":"Goreençena fağırır axtı qa'a,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Manbı cone milletne ç'ak'ınbışika,","poem":1},{"text":"Sacigee gyuv'ar haa'asva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mang'vee uşax dexhene xhunaşşeys uşaxar hoole,","poem":1},{"text":"Məxür məng'ı'ke baxtivarna yed hee'e.","poem":2},{"lineBreak":true},{"text":"Rəbbilqa şukur hee'e!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":9}