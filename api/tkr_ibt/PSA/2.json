{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Nişil-allane milletbı g'elil qeedaxhe?","poem":1},{"text":"Nişil-allane manbışe cosse dəxəsde karbışda haa'a?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ç'iyene aq'valin paççahar, vuk'lek vukkekkanbı,","poem":1},{"text":"Rəbbilqayiy","poem":2},{"lineBreak":true},{"text":"Mang'vee g'əyxı'ng'ulqa, paççahılqa,","poem":2},{"text":"g'elil qeebaxhe.","poem":3}]},{"type":"verse","number":3,"content":["Manbışe eyhen:",{"text":"«Qudoora, Manbışda xamut qakkyaahas,","poem":1},{"lineBreak":true},{"text":"şalin Manbışin zincirbı qoda'as!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xəybışee taxtıl Gyu'uriyng'vee əqəna ha'as,","poem":1},{"lineBreak":true},{"text":"Xudaavandee manbı matsxara haa'as.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Qiyğa Mang'vee qəlın eyhesın.","poem":1},{"lineBreak":true},{"text":"Manbıb Mang'une it'umne qəlıle qəvəəq'ənasınbı.","poem":1}]},{"type":"verse","number":6,"content":["Mang'vee eyhen:",{"text":"«Zı Yizda paççah","poem":1},{"text":"muq'addasne suval Sionul","poem":2},{"noteId":0},{"text":"gi'ı».","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["[Paççahee eyhen:]",{"text":"Rəbbee uvhuyn zı şolqa hixhar ha'asın.","poem":1},{"lineBreak":true},{"text":"Rəbbee zak'le uvhuyn:","poem":1},{"text":"«Ğu Yizda dix vor,","poem":2},{"lineBreak":true},{"text":"Zake g'iyna Vas dek ıxha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zake heqqe,","poem":1},{"text":"Zı vas gırgıne gahbışis milletbıyiy","poem":2},{"lineBreak":true},{"text":"ç'iyeyn aq'va ç'əvxhesmeen gırgın cigabı","poem":2},{"text":"Vas heles.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ğu manbışikın yivayne əsaaka ha'as,","poem":1},{"lineBreak":true},{"text":"G'ı'bı'ne nyuq'vneke hı'iyn g'ab xhinnee","poem":1},{"text":"xüvə-xüvəna qaa'as».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Həşdiyle, paççahar, ək'elika vuxhe!","poem":1},{"text":"Ç'iyene aq'valin haakimar, dars aleet'e!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Rəbbile qəpq'ı'n Mang'us g'ullux hee'e!","poem":1},{"text":"Qəvəq'neb, şadeepxheb.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Allahne dixes, paççahıs,","poem":1},{"text":"qəl mooxhecenva hı'rmat givxhe.","poem":2},{"text":"Deşxheene, mang'una qəl","poem":1},{"text":"zarabacab ts'ayılqa sapk'ıl,","poem":2},{"lineBreak":true},{"text":"şokunud şu avquyne yəqqə ixhesın.","poem":2},{"text":"Mang'ulqa yı'q' qizzıriynbı","poem":1},{"text":"nimee baxtivarbayiy!","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sion: İyerusalim alyav'una tepa vobna. İzrailyne paççahın xan-saray maaniy vod.","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/tkr_ibt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}