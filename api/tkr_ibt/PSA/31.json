{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Maskil",{"noteId":2},", Davudna mə'niy."]},{"type":"verse","number":1,"content":[{"text":"Şavunbıyiy bınahbı Rəbbe yik'elixanı'ı,","poem":1},{"text":"Şavunbıyiy qotkuda hidi'iyn harakatbı hakkal hı'ı, nimee baxtivariy!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Cuna bınah dyugulydyaa'ana,","poem":1},{"text":"Rəbb bınahılee ilheç'una insan, nimee baxtivariy!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gardanaqa alyat'asmee zı əvəray hav'u.","poem":1},{"text":"Yiğbına, xəmbına Yiğna yı'q'na xıl zal oğa vuxha.","poem":2},{"text":"Yizda guç g'apt'ına g'ı'liyne pırane yiğıl qəhətxhayn çiy xhinne.","poem":1},{"text":"Ik'arang'an xhineyid yizın bark'vbıd rı'hı'le g'a'atk'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Manke zı bınah Yiğne ögiyl gardanaqa alyapt'ına,","poem":1},{"text":"Yizın qotkuda hidi'iy Vale dyugul hı'ı deş.","poem":2},{"text":"Qiyğa zı uvhuyn: «Zı bınahbı Rəbbine ögiyl gardanaqa alyat'anbı»,","poem":1},{"text":"Ğunar yizde bınahıle ilheç'una.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mançil-allab Yiğna yəq avquyng've,","poem":1},{"text":"Ğu iveekemee Valqa düə hee'ecen.","poem":2},{"text":"Məhrıng'uk xədın xhyanbıd qadıyng'a set'as deş.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zı dyugulexhen ciga Ğu vorna,","poem":1},{"text":"Ğu zı dağamiyvalike g'attixhan ha'as,","poem":2},{"lineBreak":true},{"text":"Ğamxhayn şadvalin mə'niybı, Ğu yizde hiqiy-alla alik'ara'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ğu eyhen: «Balkaniy g'atir xhinne ək'el kamba mexhe,","poem":1},{"text":"Manbı salbaniy g'antarağa dena","poem":2},{"lineBreak":true},{"text":"Ğu eyhençilqa qalya'as əxə deş.","poem":2},{"text":"Zı vas ək'el hevles,","poem":1},{"text":"Ğu əlyhəəsda yəq haagvas.","poem":2},{"text":"Zı ğu hot'alasda,","poem":1},{"text":"Yizda ul val vobna».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yəq avguynbışde vuk'lelqa xətta divanbı adaylenbı,","poem":1},{"text":"Rəbbir culqa umud ha'anbışiqa","poem":2},{"lineBreak":true},{"text":"Hammaşee yugra eyxhena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qopkuyn insanar, vuşda şadvalla Rəbbil-alla vuxhecen.","poem":1},{"text":"Yik' məttınbı, şadvalina mə'niy Rəbbinimee qəpqe.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Maskil:İne cuvabın cühüt'yaaşine mizel in mə'nabıd hele eyxhe: «ats'al, mı'sləhət», «uftanba gipk'ınna mə'niy».","reference":{"chapter":31,"verse":0}}]},"thisChapterLink":"/api/tkr_ibt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":9}