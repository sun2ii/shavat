{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Maq'amne xərıng'us. Molyne simnane instrumentıkana Davudna mə'niy.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Rəbb, qəl vuxha zas cazaa humoole,","poem":1},{"lineBreak":true},{"text":"qəlın qoyxharmee, zake qəl qığmaaha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rəbb, zas rəhı'm hee'e,","poem":1},{"text":"Zaqa taq'at axu deş.","poem":2},{"text":"Rəbb, zı yug qe'e,","poem":1},{"text":"uts'uruke bark'vbışeeqa zeze aypxhı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Caneeqa it'umna zeze aypxhı.","poem":1},{"lineBreak":true},{"text":"Rəbb, man mısılqameene ts'ıts'xhes?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Rəbb, qora zas kumag he'e,","poem":1},{"lineBreak":true},{"text":"Yiğne ç'əvcab dyooxhene yugvalika","poem":1},{"text":"zı g'attixhan he'e!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Qik'u ark'ınne insanee","poem":1},{"text":"Ğu deş yik'el qalya'as.","poem":2},{"text":"Şavaane qik'uyne cigeençe","poem":1},{"text":"Vas şukur haa'as?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zı yizdecar hülöörxüyke orzulyna,","poem":1},{"lineBreak":true},{"text":"yiğıscad xəmde geşşuyke","poem":1},{"text":"zı g'ılexhan ciga çüvəda eyxhe,","poem":2},{"text":"ulene nağıke","poem":1},{"text":"yizın tyulyu çüvə qexhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uts'uruke yizın uleppı qeqqu.","poem":1},{"lineBreak":true},{"text":"Duşmanaaşe zı geşşes ilekkançil-alla","poem":1},{"text":"yizın uleppı ozzur.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rəbbik'le zı geşşe g'ayxhiyn!","poem":1},{"lineBreak":true},{"text":"Pisın işbı g'ecenbı, zake əq'əna qeepxhe!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rəbbik'le, zı rəhı'm hee'eva eyhen, g'ayxhiyn,","poem":1},{"lineBreak":true},{"text":"Rəbbee yizda düə q'abıl hav'una!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yizın gırgın duşmanar","poem":1},{"text":"k'ap'ik'ıle avqa qeepxhes,","poem":2},{"text":"Manbı qəpq'ı'n,","poem":1},{"text":"manbışde caneeqa it'umna zeze avxhas,","poem":2},{"lineBreak":true},{"text":"Matsxareepxha, manbı zaraba heepxasınbı.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}