{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Maq'amne xərıng'us. Davudna Gittitne instrumentıkana mə'niy."]},{"type":"verse","number":1,"content":[{"text":"Ay Xudaavanda, yişda Rəbb,","poem":1},{"text":"nimee axtıdayiy Yiğın do ç'iyene aq'val!","poem":2},{"text":"Yiğna xəbvalla xəybışileb axtıba vob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gyooqanbışded, uşaxaaşineb gyaaşuyle ğana","poem":1},{"text":"Ğu guc haagvas,","poem":2},{"text":"qəl qığaahane duşmanee","poem":1},{"text":"nıq' aqqecenva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yiğne xıleppışde işiqa: xəybışiqa,","poem":1},{"lineBreak":true},{"text":"Ğu gyuvxhuyne vuzaqa,","poem":1},{"text":"Ğu gitk'ınne xənebışiqa, ilyakkamee,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zı eyhen: «İnsan vuşune vor,","poem":1},{"text":"Ğu mana yik'el aqqı?","poem":2},{"text":"İnsanıke g'abiynbı hucoo eyxhen karne,","poem":1},{"text":"Ğu manbışda haa'a?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ğu insan malaaikıle","poem":1},{"text":"sık'ırra avqana hı'ı.","poem":2},{"text":"İnsan axtı qı'ı,","poem":1},{"text":"tac xhineyid şöhrat huvu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İt'xhınne karalqa mana paççah gixhxhı.","poem":1},{"lineBreak":true},{"text":"İn gırgın: çavra-vəq'ə, çolun həyvanar,","poem":1},{"text":"Xəədın şit'yar, deryahbışeedın baluğar,","poem":2},{"lineBreak":true},{"text":"Deryahbışeedın gırgıncad,","poem":2},{"text":"Ğu mang'une g'elybışiqqa huvu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ay Xudaavanda, yişda Rəbb,","poem":1},{"text":"nimee axtıdayiy Yiğın do ç'iyene aq'val!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":7}