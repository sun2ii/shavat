{"translation":{"id":"tkr_ibt","name":"Tsakhur","website":"https://ebible.org/Scriptures/details.php?id=tkr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tkr","licenseNotes":null,"shortName":"IBT","englishName":"Tsakhur Bible","language":"tkr","textDirection":"ltr","sha256":"639b21a6c44adeebe2a14f8a4be4b3ae56eca36f0877362205414802cd0efc50","availableFormats":["json"],"listOfBooksApiLink":"/api/tkr_ibt/books.json","numberOfBooks":20,"totalNumberOfChapters":273,"totalNumberOfVerses":7153,"languageName":"Tsakhur","languageEnglishName":"Tsakhur"},"book":{"id":"PSA","translationId":"tkr_ibt","name":"Zabur","commonName":"Zabur","title":"Zabur","order":19,"numberOfChapters":11,"sha256":"e00f0da4b4354f7adca2b35c96da240035c59769f6c1308a104a7bc194ff9b9b","firstChapterNumber":1,"firstChapterApiLink":"/api/tkr_ibt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tkr_ibt/PSA/150.json","totalNumberOfVerses":149},"chapter":{"number":89,"content":[{"type":"verse","number":1,"content":[{"text":"Allahne insanna Mısayna düə","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nimee nasılbı badaledxheyid,","poem":1},{"text":"Xudaavanda, şi Valqa yı'q' qizzır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Suvabıyiy ç'iyeyn aq'va, dyunye ixhanassecad Ğu Allah ıxha,","poem":1},{"text":"Gırgıne gahbışilır Allahcar ixhes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ğu insanar nyuq'nelqa savaak'al haa'a.","poem":1},{"text":"Ğu manbışik'le eyhen: «Aadamın dixbı, nyuq'nelqa savk'le».","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yiğne ulesqa aazır sen, sa ılğeç'uyn yiğ xhinne,","poem":1},{"text":"Xəmdiyna sa-q'öble sə'ət xhinne qadayle.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Selin xhinne Ğu insanar vukkeka,","poem":1},{"text":"Manbı nyak' xhinne qabı avayk'an.","poem":2},{"text":"Manbı miç'eeb alyabıyne ok'uk akar:","poem":1},{"text":"miç'eeb k'atele qooxhe t'et'-t'ele g'ayhe,","poem":2},{"lineBreak":true},{"text":"xəmdemee hı'ç'ı'bğı'n, qooqqana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yiğne qəlan şi gyabat'anbı,","poem":1},{"text":"Vaqa qəlnang'a şi nyaqame vuxhesınbı aaxva.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yişin taxsirbı Vak'le ats'a,","poem":1},{"text":"Yişde dyugulene bınahbışilqa Yiğne aq'vayn nur gexha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ğu qəllamışxheene yişda ı'mı'r cit'a qooxhe.","poem":1},{"text":"Yişin senbı ul gyapxı aaqasse ılğeeç'enbı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Şi yights'al (70) sennana ı'mı'r haa'a,","poem":1},{"text":"Vuk'diyk'ıree molyts'aleeqab (80) hiviyxharanbı.","poem":2},{"text":"Mane senbışin g'ellesınbıd dağamiyvalee, ı'k'aree ı'lğəə,","poem":1},{"text":"Yişda ı'mı'r zarabacab ç'əvooxhena, alivxu avayk'an.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Şavuk'lene Yiğne qəlına guc vaats'a?","poem":1},{"text":"Vale nimeeyiy qəvəyq'ən,","poem":2},{"lineBreak":true},{"text":"Vaqa manimeenab qəl vob.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I'mı'r cit'aba vuxhay şas yik'el qale'e,","poem":1},{"text":"Şi ək'elika vuxhes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ya Rəbb, şasqa sak'le! Nimeene gahnane inəxüd ixhes?","poem":1},{"text":"Yiğne g'ulaaşis rəhı'm hee'e!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Şi gırgıne gahbışil şadba vuxhecenva,","poem":1},{"text":"Miç'eeb şalqa Yiğna yugvalla gyooğee'e.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Şalqa ver ablyav'uyn yiğbımee,","poem":1},{"text":"Balyaa ablyav'uyn senbımee, şi şad hee'e.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ğu hı'iynbı Yiğne g'ulaaşik'le,","poem":1},{"text":"Yiğna xəbvallab cone uşaxaaşik'le g'avcecen.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ay Xudaavanda yişda Allah, şaqa yugra ixhe,","poem":1},{"text":"Yişde xılen hı'iynçis baraka hevle,","poem":2},{"lineBreak":true},{"text":"Hucoone ixhes, yişde xılen hı'iynçis baraka hevle.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tkr_ibt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tkr_ibt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tkr_ibt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":17}