{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"EZK","translationId":"tod_pbt","name":"Ezekiyɛle","commonName":"Ezekiyɛle","title":"Ezekiyɛle Ná-Sɛʋɛi","order":26,"numberOfChapters":48,"sha256":"77800d22c5e78a2238412d04b9d919c6d3785b09b6bc0f8bc32ab898daa0cdf9","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tod_pbt/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Maawɔin wuyei"]},{"type":"verse","number":1,"content":["«Ɗa ʋe, maawɔin wuyei loo Izilayɛle ɠundiɠiiti ma."]},{"type":"verse","number":2,"content":["Ɗa ɠɛ ti ma:",{"text":"‹Wo-lee ɠɛni ga zala zaai.","poem":1},{"lineBreak":true},{"text":"É ʋɛɛni sakpamaalegai zala zinɛiti saama,","poem":1},{"lineBreak":true},{"text":"zala yiʋoiti saama é ná-ziʋoiti kulazu su ná.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"É ná-ziʋoi taɠila maaɠoloni,","poem":1},{"lineBreak":true},{"text":"naa ɠɛni ga zala ɓokpagi.","poem":1},{"lineBreak":true},{"text":"É zooni daamianigi zosu,","poem":1},{"lineBreak":true},{"text":"é ɗa nuiti suʋaliʋali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zii ɠiligiti ti maawooi mɛnini.","poem":1},{"lineBreak":true},{"text":"Ti soni ga ta-ʋalii,","poem":1},{"lineBreak":true},{"text":"ti kalagi lɔ sokpayeɠei zu.","poem":1},{"lineBreak":true},{"text":"Ti liini la Ezipete yooi zu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Siɛgi zu zala zaai kaani la ga","poem":1},{"lineBreak":true},{"text":"ná-maaɓɔungi zuɠooza wafuun,","poem":1},{"lineBreak":true},{"text":"kitosuʋɛ ɠoloɠologa.","poem":1},{"lineBreak":true},{"text":"É ná-ziʋoi taɠili seɠeni,","poem":1},{"lineBreak":true},{"text":"é kpɛtɛ ga zala ɓokpagi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"É ɠɛni leʋeteʋesu zalaiti saama,","poem":1},{"lineBreak":true},{"text":"é ɠɛni ga zala ɓokpagi.","poem":1},{"lineBreak":true},{"text":"É zooni daamianigi zosu,","poem":1},{"lineBreak":true},{"text":"é ɗa nuiti suʋaliʋali.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"É ta-masa pɛlɛi woloni,","poem":1},{"lineBreak":true},{"text":"é ta-laa wolai ɠoloɠolo.","poem":1},{"lineBreak":true},{"text":"Zooi ta gaa nuɓusɛiti ti luani","poem":1},{"lineBreak":true},{"text":"sikɔ lugi ʋa ti mɛnini.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zii ɠiligiti ti maaɠoolii zu,","poem":1},{"lineBreak":true},{"text":"ti wuzeɠeni daalɔɠɔma.","poem":1},{"lineBreak":true},{"text":"Ti maaɠoolini ga ta-lumɔiti,","poem":1},{"lineBreak":true},{"text":"ti soni ga ta-ʋaliiti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ti kalagi ʋilini sokpa zu,","poem":1},{"lineBreak":true},{"text":"ti pili sasa goi zu kɛai eɠɛ sekagi.","poem":1},{"lineBreak":true},{"text":"Ti liini la Ɓaɓilɔne masagi ʋɔ.","poem":1},{"lineBreak":true},{"text":"Ti pilini kasoi ɠa, nu a ʋa goomɛni,","poem":1},{"lineBreak":true},{"text":"é ɗa zikɔ Izilayɛle ɠizeiti ma.› »","poem":1}]},{"type":"heading","content":["Dɔɔɓɔi gului ta ma ɓekegiti"]},{"type":"verse","number":10,"content":[{"text":"« ‹Wo-lee ɠɛni eɠɛ leezɛn ansaɠɔgi siingai ziɛlaʋɛ.","poem":1},{"lineBreak":true},{"text":"Ma waaiti ti ɠɛni ga ta gaalaagiti,","poem":1},{"lineBreak":true},{"text":"ziɛi zaɓu zu é ɠɛni sɔlɔɔsu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma ɓekegiti ti ɠɛ ba, ti maayikiai,","poem":1},{"lineBreak":true},{"text":"naati ti ɠɛɛni ga masa tukpɔiti.","poem":1},{"lineBreak":true},{"text":"É loni gulu wolaiti maazu.","poem":1},{"lineBreak":true},{"text":"Gaaɠooza ʋelei ta ma ɓekegiti mɔin ʋelei","poem":1},{"lineBreak":true},{"text":"ɛsɛ pɛ ge ɠɛni kaazu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛlɛ tɔɔɠulani ga ziiɠaawanai,","poem":1},{"lineBreak":true},{"text":"é ʋili ya zooi ma.","poem":1},{"lineBreak":true},{"text":"Folo ɠulazu ʋele viilɛi fɔɔni ta ma waaiti,","poem":1},{"lineBreak":true},{"text":"naati ti looni bu.","poem":1},{"lineBreak":true},{"text":"Ma ɓekegiti ti maayikini, ti vɔɔni,","poem":1},{"lineBreak":true},{"text":"abui ti ɠalani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Leezɛn ansaɠɔgi tɛi siinga ɠɛni de teʋebai zu,","poem":1},{"lineBreak":true},{"text":"zou vɔɔi zu, ziɛ la ná.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Abui ɠulani ma lɔkulugi zu,","poem":1},{"lineBreak":true},{"text":"é ma ɓekegiti ta ma waaiti koloɠolo.","poem":1},{"lineBreak":true},{"text":"Ma ɓeke maayikia la mɔ ba,","poem":1},{"lineBreak":true},{"text":"nii a ɠɛ ga masa tukpɔi.› »","poem":1},"Maawɔin wuyei ɠana, maanɛai é loo ɠana."]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}