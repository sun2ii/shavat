{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"ISA","translationId":"tod_pbt","name":"Ezayi","commonName":"Ezayi","title":"Ezayi Ná-Sɛʋɛi","order":23,"numberOfChapters":66,"sha256":"91e882612d73f630525f0d6ec375f65882b0d728c07d106d3b1b32f897a9ed15","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tod_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Mama fee vai"]},{"type":"verse","number":1,"content":[{"text":"Nuɓusɛ unmɔɔgaiti, wa ɠɛ ma, naama volo ná:","poem":1},{"lineBreak":true},{"text":"«Ee, Ɠɔoɠɔ GALAGI, nà è maamusɛzu!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ è yiiɠaawanani mà,","poem":1},{"lineBreak":true},{"text":"kɛlɛ ɗa-yiiɠaawanai zeɠea màazu, è gàanɛɛnɛa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wɛlɛ GALAGI ka é ga kìzo nui,","poem":1},{"lineBreak":true},{"text":"gè ɓɔɠɔ ɠaliva tɔun ma, gè la mɔ luazu.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI, Ɠɔoɠɔ GALAGI ɠa é ga nà-zobogi,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa gè vaazu ma nà-guyeiti su,","poem":1},{"lineBreak":true},{"text":"toɠa ga Kìzo Nui.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa ziɛi zaɠa ga koozunɛɛi kizo fai ma ɗɛungiti su.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Naama volo ná, wa ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«À Ɠɔoɠɔ GALAGI maamusɛ, à wooɠula ma.","poem":1},{"lineBreak":true},{"text":"Ná-faa wolaiti é ti ɠɛai, à ti lɛ ga zii ɠiligiti,","poem":1},{"lineBreak":true},{"text":"à daasei golai ma vaa wo ɛsɛ pɛ ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À guyei loo Ɠɔoɠɔ GALAGI lɛbi vai ma,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ é faa wolaiti kɛa.","poem":1},{"lineBreak":true},{"text":"À ti lɛ eteai zu ná pɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À pilɛ sɔlɔɔ koozunɛɛi lɛɛ, Siyɔn ʋeaiti!","poem":1},{"lineBreak":true},{"text":"À wooɠula ga koozunɛɛi,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ gola wɔɔlɔʋɛ wo zaama,","poem":1},{"lineBreak":true},{"text":"tɔungi é ga Izilayɛle ná-GALA Ɲadegai.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}