{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"ISA","translationId":"tod_pbt","name":"Ezayi","commonName":"Ezayi","title":"Ezayi Ná-Sɛʋɛi","order":23,"numberOfChapters":66,"sha256":"91e882612d73f630525f0d6ec375f65882b0d728c07d106d3b1b32f897a9ed15","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tod_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"heading","content":["Eteai ɠoloɠolo fai tɛtɛ"]},{"type":"verse","number":1,"content":[{"text":"Ungo, Ɠɔoɠɔ GALAGI ɠa ʋaazu eteai pɛ koloɠolosu,","poem":1},{"lineBreak":true},{"text":"toɠa ʋaazu su ɠoloɠolosu,","poem":1},{"lineBreak":true},{"text":"é zooi ɠaaʋɛ ɠɛ wuulee,","poem":1},{"lineBreak":true},{"text":"gaa aniiti pɛ ti vaza.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Faa ɠilagi naa nɔ ɠa a ɠa ga","poem":1},{"lineBreak":true},{"text":"zalaɠa ɠula nui ta nuɓusɛiti,","poem":1},{"lineBreak":true},{"text":"pɛlɛ kɛɛɠɛi ta ná-botiɠɛ zunui,","poem":1},{"lineBreak":true},{"text":"pɛlɛ deei ta ná-botiɠɛ anzanui,","poem":1},{"lineBreak":true},{"text":"ani ʋɔdi nui ta ani ɠeya nui,","poem":1},{"lineBreak":true},{"text":"nui é anii lɔɔzu ga ziingaogi ta nui é siingaosu,","poem":1},{"lineBreak":true},{"text":"kuye ʋɛɛ nui ta kuye zeɠe nui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eteai ɠa ɠoloɠolo mɛtu, suwo kpɛlɛtɛtɛ,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ Ɠɔoɠɔ GALAGI ɓɔɠɔi ɠa é niima wooi woni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gɔlɔɗɛi ɠa eteai ɠaazuʋɛ,","poem":1},{"lineBreak":true},{"text":"eteai zuɓɔlɔa, é vɔ,","poem":1},{"lineBreak":true},{"text":"eteai nuiti tosu wolai ti ya, ti vɔa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eteai ɠɔzɔni su nuɓusɛiti kɔɠɔwu,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ti tɔgiti koloɠoloni,","poem":1},{"lineBreak":true},{"text":"ti deveiti seɠe ma,","poem":1},{"lineBreak":true},{"text":"ti ɠɔoɠɔ minazeɠegiti seɠe ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naa maaʋele ma, eteai ɠana ɠala ga GALA ná-foovooi.","poem":1},{"lineBreak":true},{"text":"Eteai zu nuɓusɛiti ti ɗa ta-vaaɠaazagi ma ɓɔlɔi zɔlɔɔ,","poem":1},{"lineBreak":true},{"text":"ti undaa ɗa ʋili,","poem":1},{"lineBreak":true},{"text":"niiti ti yɛsu ná, ti la mɔ mɔinni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dɔɔ niinɛi ɠaazuɠilia,","poem":1},{"lineBreak":true},{"text":"leezɛn ɓelei zuɓɔlɔa,","poem":1},{"lineBreak":true},{"text":"niiti kpein ti ɠoozunɛɛni ti-yiimaʋɛ, ta ɓalasu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tamadegiti ta-ɠoozunɛɛi maaleʋea,","poem":1},{"lineBreak":true},{"text":"nuiti ta-zɔngɔi ti ɠɛni bosu fɛtii zu, naa ɓega,","poem":1},{"lineBreak":true},{"text":"kɔnigiti gooi ma ɠoozunɛɛi maaleʋea.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dɔɔ ɓɔle wuye la mɔ loozu,","poem":1},{"lineBreak":true},{"text":"gaazulati ganiiti ti wanaa kpɔɔle nuiti da.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taa wolai ʋua ya, naa zuwoga.","poem":1},{"lineBreak":true},{"text":"Ɲii wosuʋɛti pɛ daaɠuluga,","poem":1},{"lineBreak":true},{"text":"nu la zooga é ʋa lɛ ná ta.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛsɛ pɛ ka kpeei loozu koi yɔɠɔzu ʋeleiti su,","poem":1},{"lineBreak":true},{"text":"ga dɔɔ la mɔ ɠaazu.","poem":1},{"lineBreak":true},{"text":"Koozunɛ la mɔ ná,","poem":1},{"lineBreak":true},{"text":"ɲaɠa ɠula vai ɓega zooi zu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Taazuʋɛ zuɠoloɠologa mɛtu,","poem":1},{"lineBreak":true},{"text":"ma ɓogiti ti ɓezeɠelega, ti ɠoloɠolo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ʋele ɠana a ɠɛɛ la nuɓusɛiti saama zooi ɠa,","poem":1},{"lineBreak":true},{"text":"eɠɛ nu ɠa wolive wului ɠaaloɠa,","poem":1},{"lineBreak":true},{"text":"eɠɛ leezɛn waai ɠula vai a ɓena tɛtɛ,","poem":1},{"lineBreak":true},{"text":"nu è ɗa ma waa ɠaaɓelagiti gaiziɛ.","poem":1}]},{"type":"heading","content":["Koozunɛɛi ɠula vai ma yeeluɠɔ"]},{"type":"verse","number":14,"content":[{"text":"Niiti ta yɛ vulua ta guyei loo,","poem":1},{"lineBreak":true},{"text":"ta ɠoozunɛ, ti wooɠula,","poem":1},{"lineBreak":true},{"text":"ti Ɠɔoɠɔ GALAGI maamusɛ ná-maayikii zu,","poem":1},{"lineBreak":true},{"text":"ta ɠɛna ʋaa, ti ɗa zeɠe folo liizu ʋele yooiti su.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Folo ɠulazu ʋelei yooi zu,","poem":1},{"lineBreak":true},{"text":"à Ɠɔoɠɔ GALAGI maamusɛ mu.","poem":1},{"lineBreak":true},{"text":"Kpoloɗɛi laaʋɛ yooiti su,","poem":1},{"lineBreak":true},{"text":"à Ɠɔoɠɔ GALAGI, Izilayɛle ná-GALAGI lɔɠɔi wo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuiti gooi ɠa ɠulazu zou ɓela ga,","poem":1},{"lineBreak":true},{"text":"gi ɗa ti woomɛni, ti ɗa guyei loo ga:","poem":1},{"lineBreak":true},{"text":"«Lɛbiyai ɠa Telebo GALAGI ʋɛ!»","poem":1},{"lineBreak":true},{"text":"Kɛlɛ gè ɠɛni ɓɔɠɔ ma:","poem":1},{"lineBreak":true},{"text":"«Gè yɛga su! Ungo, gè yɛga su! Màanɔɠɔa!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ yaava nuiti ti yaavai ɠɛɛni.","poem":1},{"lineBreak":true},{"text":"Yaavai! Yaava nuiti ti yaavai ɠɛɛni.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dualuagi, zeɠei ɓomaʋɛ ta tumɔi,","poem":1},{"lineBreak":true},{"text":"naati ka ti wo maaɓɔunsu,","poem":1},{"lineBreak":true},{"text":"wɔiti wo zeini eteai zu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zɔi a ʋela dualuagi maalugi ʋa,","poem":1},{"lineBreak":true},{"text":"naa ɠa loo zeɠei ɓomaʋɛ.","poem":1},{"lineBreak":true},{"text":"Ni toɠa zoo é lɛ, é ɠula su,","poem":1},{"lineBreak":true},{"text":"toɠa zo tumɔi zu.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ geezuʋɛ ma ʋɛlɛlaʋɛti daalaoga,","poem":1},{"lineBreak":true},{"text":"eteai ma wuulaagiti ti ɲiikpiga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zooi ɠa ʋalizu ga,","poem":1},{"lineBreak":true},{"text":"zooi ɠa ɓalasu,","poem":1},{"lineBreak":true},{"text":"zooi ɠa ɲiikpisu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"É ɗa ziɛ tingotanga eɠɛ dɔɔzo nui,","poem":1},{"lineBreak":true},{"text":"é ɗa ɓali eɠɛ kotai.","poem":1},{"lineBreak":true},{"text":"Ná-tɔ koloɠologi wuiɗa ma,","poem":1},{"lineBreak":true},{"text":"é la mɔ zooga é ʋa wuzeɠe ʋolu.","poem":1}]},{"type":"heading","content":["Masadaiti kwɛgi,GALA ná-masadai lɔɔzeigi"]},{"type":"verse","number":21,"content":[{"text":"Naama volo ná, Ɠɔoɠɔ GALAGI ɠa wuzeɠe","poem":1},{"lineBreak":true},{"text":"geezuʋɛ, geezu ɠɔɔʋɛbɛi laalɔɠɔma,","poem":1},{"lineBreak":true},{"text":"ta eteai zu, etea masagi daalɔɠɔma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ta ti ɠaalɛ ba, ti pɛ zeɠei zu,","poem":1},{"lineBreak":true},{"text":"daa ɠa ɠulu ti ma kasoi wu,","poem":1},{"lineBreak":true},{"text":"naa ʋolu su a ɠoozana,","poem":1},{"lineBreak":true},{"text":"kɛni ti ta-lukpɔi ɠaaleʋe.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Alugi ɠaaɠaalɛi ga unfegi,","poem":1},{"lineBreak":true},{"text":"foloi ɠɛ tɔmɔzɔɔ ga unfegi.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI, Fai-Pɛ-Maliɠii ɠa masadai ɠɛɛzu","poem":1},{"lineBreak":true},{"text":"Siyɔn gizei ma, ta Zeluzalɛme.","poem":1},{"lineBreak":true},{"text":"Toɠa ná-lɛbiyai ɠula kɛlɛma","poem":1},{"lineBreak":true},{"text":"ná-nuɓusɛiti ta-ɠundiɠiiti gaazu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}