{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"ISA","translationId":"tod_pbt","name":"Ezayi","commonName":"Ezayi","title":"Ezayi Ná-Sɛʋɛi","order":23,"numberOfChapters":66,"sha256":"91e882612d73f630525f0d6ec375f65882b0d728c07d106d3b1b32f897a9ed15","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tod_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Naama volo ná, anzanu lɔfela ɠa ɗa zunu ɠilagi zo, ti ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«Gi la ɠɛa è unma ga kasɔ daamiani faa zu ɓaa seɠe vaa zu.","poem":1},{"lineBreak":true},{"text":"Kɛlɛ è-laaseigi nɔ ʋɛɛ gi ʋa!","poem":1},{"lineBreak":true},{"text":"Unfegi ɠula gi ɠaazu nɔ.»","poem":1}]},{"type":"heading","content":["Ʋelela ʋele vai ma wozakalagi"]},{"type":"verse","number":2,"content":[{"text":"Naama volo ná, nii Ɠɔoɠɔ GALAGI pɔnɔsu,","poem":1},{"lineBreak":true},{"text":"maa ɠa yiki, lɛbiyai ɠɛ bɛ,","poem":1},{"lineBreak":true},{"text":"zooi ʋaalɔnɔgi ɠa ɠɛ ga unbuzeɠe vaa wola,","poem":1},{"lineBreak":true},{"text":"Izilayɛle nui mɔtaiti bɛ ti yɛsu vulua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naazu zɔiti ta yɛ vulua Siyɔn","poem":1},{"lineBreak":true},{"text":"ta loli ga nu ɲadegaiti,","poem":1},{"lineBreak":true},{"text":"niiti pɛ ta zɛʋɛ ná-sɛʋɛi zu","poem":1},{"lineBreak":true},{"text":"ga ti zɛnvui wo Zeluzalɛme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maliɠii ɓega ʋoluma ga Siyɔn anzanuiti ta-ɠɔzɔba vaiti gba,","poem":1},{"lineBreak":true},{"text":"é Zeluzalɛme ɲade ɲama ʋui ma é ɠɛɛni ná,","poem":1},{"lineBreak":true},{"text":"ga zɛnvu viilɛi maaʋele nii é telebodai ta ɲadedai ɠɛɛzu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa kpɛtɛ ga Siyɔn gizei pɛ ma,","poem":1},{"lineBreak":true},{"text":"ta niiti pɛ ti ɠaalɛɛzu ba ná,","poem":1},{"lineBreak":true},{"text":"tonaɓiingi ɠɛ ti maazu foloi, kpidii duului ta abui ma wozakalagi.","poem":1},{"lineBreak":true},{"text":"Maliɠii ná-lɛbiyai ɠa ɠɛ ti pɛ maazu ga ti makɛ anii,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"eɠɛ kotai é niinigi veezu foloi, é nu makɛ, die ge mina zei è ma,","poem":1},{"lineBreak":true},{"text":"é ɠɛ ga nu lɔɔɠuzu ta nu makɛsu fiilɛ wolai ta tonai ʋa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}