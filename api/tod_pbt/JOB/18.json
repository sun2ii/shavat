{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"JOB","translationId":"tod_pbt","name":"Zɔɓe","commonName":"Zɔɓe","title":"Zɔɓe Ná-Sɛʋɛi","order":18,"numberOfChapters":42,"sha256":"5991fdbf5eeaa4431311ad645d5b985a79b6bb7cdee5efebbd77e5c0fcc1e28e","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tod_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Ɓilidade ná-kpɔɛzuɠulai velesiɛi"]},{"type":"verse","number":1,"content":["Suɠa nui Ɓilidade kpɔɛi zeɠeni, é ɠɛ ma:"]},{"type":"verse","number":2,"content":[{"text":"«Siɛgi ɓɛgele zu ɠa wo ɓesu la kpɔɛ mɔinmɔingi naati ba la?","poem":1},{"lineBreak":true},{"text":"À ɠigaiziɛ su, naa ʋolu gá ɓɔɛ niina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Leeni vaa zu gi levezu ga suaiti?","poem":1},{"lineBreak":true},{"text":"Toɠa wo ɠisu ga gá ga faaɠaaɠalala nuiti?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ee, ɗa ʋe, ɗɛi è ɓɔɠɔ ʋalizu ga ɗa-yiiɠaawanai zu,","poem":1},{"lineBreak":true},{"text":"kɛni ɗɔun ɗa-vaa zu kɛlɛbai wo ga eteai,","poem":1},{"lineBreak":true},{"text":"fasai zeɠe tosuʋɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ungo, nu ɲɔi ná-wozakalagi ɠa za,","poem":1},{"lineBreak":true},{"text":"ma abuzogi é ɠɛa ba, naa ɠa ɓe foloi ʋa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wozakalagi zuɓidi ná-seɠe ɠotai wu,","poem":1},{"lineBreak":true},{"text":"zɛnvui ma zɔmɔgi ɠa za.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɔɠɔi zɛbɛi ɠɛa ba, naa zu ɠa ɓɔlɔ,","poem":1},{"lineBreak":true},{"text":"tɔ ɓɔɠɔi lɛnɛ gooi ɠa ɠɛ ga too zaɓui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ piligɛ ya, kɔɠɔi lɔ tumɔi zu.","poem":1},{"lineBreak":true},{"text":"Toɠa ziɛzu galuiti zɔɠɔzuʋɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bali sogɛ tibiligi ʋa,","poem":1},{"lineBreak":true},{"text":"ta galuiti daalɔ ba.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Galu ʋɔɛngi a zo da, naa lɔɔɠuʋɛ zooi wu,","poem":1},{"lineBreak":true},{"text":"balii ɠa maaɓɔunsu pelei zu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maalua vai ɠa polu adaʋɛ pɛ,","poem":1},{"lineBreak":true},{"text":"é ʋilɛ kɔɠɔʋo ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Pului suvikɛi ɠula zea,","poem":1},{"lineBreak":true},{"text":"nimizai maaɠoolia.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Toɠa kɔlɔgi ma ɓulukpulugiti sumi.","poem":1},{"lineBreak":true},{"text":"Ɗɔfɔ zeeɓɛi ɠa baalobazuʋɛti sumi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tɔɔɠulaʋɛ ná-seɠe ɠotai wu, ʋɛ é ɠɛa ɠalivaazu ná.","poem":1},{"lineBreak":true},{"text":"É lia ga ɓɔɠɔ maalua masagi ʋɔ bɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ti zei ná-seɠe ɠotai wu, é la mɔ ga nɔnɔ.","poem":1},{"lineBreak":true},{"text":"Timinigi vazaga seizuʋɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma zapeiti ti vɔa buu ʋelei,","poem":1},{"lineBreak":true},{"text":"ma ɓeke koiti ti vɔa maazu ʋelei.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tɔɠɔi ɲɛɛlɛa eteai zu,","poem":1},{"lineBreak":true},{"text":"daasei ge la mɔ etea.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Daaʋiliga, é zeɠe wozakalagi ɠa, é ʋili kpidii zu.","poem":1},{"lineBreak":true},{"text":"Ti kpɛa, é ɠula eteai ʋa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"É la dounɠa yɛni, ɓaa dounlounɠa ná-nuɓusɛiti saama.","poem":1},{"lineBreak":true},{"text":"Nu vulu nɔpɛ ge la yɛni seizuʋɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Folo liizu ta folo ɠulazu, naa ɠa mɛni nii é zeizu ma,","poem":1},{"lineBreak":true},{"text":"naa ɠa nuiti maalua, ti zasu ɗa ɓali.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zekana a ɠɛ la ga telebotala nui ná-pɛlɛi.","poem":1},{"lineBreak":true},{"text":"É ɗa wo ga, ʋɛ ɠɛa ga ada, ʋɛ ti la ɠɛni GALA kwɛɛ ná.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}