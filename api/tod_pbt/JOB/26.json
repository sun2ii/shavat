{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"JOB","translationId":"tod_pbt","name":"Zɔɓe","commonName":"Zɔɓe","title":"Zɔɓe Ná-Sɛʋɛi","order":18,"numberOfChapters":42,"sha256":"5991fdbf5eeaa4431311ad645d5b985a79b6bb7cdee5efebbd77e5c0fcc1e28e","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tod_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Zɔɓe Ɓilidade wooɠaaʋote fai"]},{"type":"verse","number":1,"content":["Zɔɓe gooɠaaʋoteni, é ɠɛ ma:"]},{"type":"verse","number":2,"content":[{"text":"«Ee, è zoogɛ nɛi ɓɔsu naama nui ʋa, nii zɛbɛ la zea,","poem":1},{"lineBreak":true},{"text":"ɗa ɓɔ naa ʋa nɛi, nii zeezu ɓɔlɔai!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È zoogɛ naama nui lɛnɛsu ɓaa, nii balagai ɠimalai ma,","poem":1},{"lineBreak":true},{"text":"ɗa ɠimalai ɠulanuma mɔinmɔingi lɛɛzu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛlɛ ɓɛ ɠa ɗa-ɓɔɛiti ti wosu ma?","poem":1},{"lineBreak":true},{"text":"È ɓɔɛ wooi naati sɔlɔɔgɛ ɓɛ ya?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gɔvɛiti kpein ta ɓalizu,","poem":1},{"lineBreak":true},{"text":"kpoloɗɛiti bu munu ta fuluaniiti ti ʋuuni ná,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mazɔlɔɔ gɔvɛalaazu ɠalagɛ GALA gaazu,","poem":1},{"lineBreak":true},{"text":"kwɛpele seɠe zuɠooza ge la zooga zɛlɛsu ma undaaʋili zeɠezaɠai ɠaazu luɠɔ, é ʋa maalɔɔɠu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"GALA ge lɛkpɛmaʋɛ nu ɠɔʋɛzuʋɛ ma ɠeeɠɔlɔgi zuviegɛ ada zu ɲakai maazu.","poem":1},{"lineBreak":true},{"text":"É eteai zɛlɛgɛ ada ɲakai maazu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"É ziɛiti gaalɛɛʋɛ ba tonaɓiin gaaɠiligiti su,","poem":1},{"lineBreak":true},{"text":"tonaɓiingi la ɗa ga ɓotaga ti-wuɲɛgi wu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toɠa ná-masa kpɔkpɔgi ɠaazu maalɔɔɠuzu,","poem":1},{"lineBreak":true},{"text":"é ná-tonaɓiingi ʋɛɛ gaazu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"É kwɛpelemaʋɛ laaʋɛ ziɛi ɠa,","poem":1},{"lineBreak":true},{"text":"wozakalagi ta kuai ti yɔɠɔzu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"GALA ga zelii lona,","poem":1},{"lineBreak":true},{"text":"geeɠɔlɔgi ma lɔkpalaiti ta ɗa ɓali, ti laavɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"GALA ná-zɛbɛi vɔniga kpoloɗɛi ma,","poem":1},{"lineBreak":true},{"text":"ta ná-keleɠelegi maaʋele ma,","poem":1},{"lineBreak":true},{"text":"é vɔniga ziɛ wu zua ɲɔi Laɠaɓe ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sokpa zu viilɛi ɠa geeɠɔlɔgi ɠaaɓalesu,","poem":1},{"lineBreak":true},{"text":"zeei kaalii ɓota, nii é ʋelazu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Anɛɛ naa ʋe, ma go nɔ ɠana ná-botiiti saama, é ti ɠɛɛzu,","poem":1},{"lineBreak":true},{"text":"ti-lugi ta go nɔ ade mɛnisu.","poem":1},{"lineBreak":true},{"text":"Ɓɛ ɠa a zoo é ná-faa wolaiti tugi ɠaaɠa?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}