{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"JOL","translationId":"tod_pbt","name":"Zowɛle","commonName":"Zowɛle","title":"Zowɛle Ná-Sɛʋɛi","order":29,"numberOfChapters":4,"sha256":"e5647f0895f6a0c06f2fc9585c94c775a5bdb51c89261ba25eca5dda5c5a7f7f","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tod_pbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["GALA Zɛnvui yei vaima minazeɠegi"]},{"type":"verse","number":1,"content":[{"text":"«Naama vaiti poluma,","poem":1},{"lineBreak":true},{"text":"nà nà-Zɛnvui yeizu nuɓusɛi pɛ ma.","poem":1},{"lineBreak":true},{"text":"Wo-loun zunuiti ta wo-loun anzanuiti ta GALA gooiti bo,","poem":1},{"lineBreak":true},{"text":"wa-ɠɛwola wɔlɔiti ta segiti bo,","poem":1},{"lineBreak":true},{"text":"wa-wuzeɠe niinɛgiti ta kulakɛlɛmaiti ka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naama voloiti su, nà nà-zɛnvui yei ɓalaa","poem":1},{"lineBreak":true},{"text":"botiɠɛ zunuiti ta botiɠɛ anzanuiti ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nà maaɓɛlɛ vaiti kɛ geeɠɔlɔgi zu ta zooi ma,","poem":1},{"lineBreak":true},{"text":"ɲamai ta abui ɠa ɠɛ ná, naa ʋɛɛ abu luului ma lonaɓiingi ʋa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Foloi ɠa ʋote ga kpidii,","poem":1},{"lineBreak":true},{"text":"alugi ɓɔi eɠɛ ɲamai,","poem":1},{"lineBreak":true},{"text":"aisa Ɠɔoɠɔ GALAGI ná-foloi ʋa zeeli,","poem":1},{"lineBreak":true},{"text":"folo wolai nii maayikiai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naazu zɔi nɔpɛ a wooɠula Maliɠii ma, toɠa ɠizo.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ ʋelei Ɠɔoɠɔ GALAGI bogai la,","poem":1},{"lineBreak":true},{"text":"kɔɔ ʋoolabaiti ta ɠɛ Siyɔn gizei ma, ta Zeluzalɛme,","poem":1},{"lineBreak":true},{"text":"niiti Ɠɔoɠɔ GALAGI ɠa ti loli,","poem":1},{"lineBreak":true},{"text":"ta ɠɛ nui mɔtaiti saama, ta yɛ vulua.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}