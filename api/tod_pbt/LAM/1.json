{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"LAM","translationId":"tod_pbt","name":"Gɔlɔ Wooiti","commonName":"Gɔlɔ Wooiti","title":"Zelemi Ná-Gɔlɔ Wooiti","order":25,"numberOfChapters":5,"sha256":"76fbcaeb5e3e961871d873b3e2fa35f126697a85a6d5bacef4923bac47bf577a","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tod_pbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Zeluzalɛme, eɠɛ poanzai ti ɠɛlɛai ba"]},{"type":"verse","number":1,"content":[{"text":"Ee! Wɛlɛ tɔ ɠila ba gaalɛiɗai,","poem":1},{"lineBreak":true},{"text":"taa wolai nii nuɓusɛi mɔinni su!","poem":1},{"lineBreak":true},{"text":"Tɔɠɔɠulani ziiti saama,","poem":1},{"lineBreak":true},{"text":"wɛlɛ, é ɠɛa eɠɛ poanzai.","poem":1},{"lineBreak":true},{"text":"Mɔungi, é ɠɛni ga masa anzanui zou zɛʋɛiti unda,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa niina é duɔla wotiiti kpein kɛɛzu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toɠa ɲiizu gɔlɔi ɠa piin,","poem":1},{"lineBreak":true},{"text":"gaazuɗɛiti ta yeizu komagaʋɛti.","poem":1},{"lineBreak":true},{"text":"Niiti kpein ti ɠɛni ga ná-wɛɛinti,","poem":1},{"lineBreak":true},{"text":"ti taɠila kpalaa ge la gaanɛɛnɛzu.","poem":1},{"lineBreak":true},{"text":"Bɔɔlaiti pɛ ti woyani,","poem":1},{"lineBreak":true},{"text":"ti pɛ ti ɠɛ niina ga sili nuiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zuda nuiti ti lia zou ɠili su,","poem":1},{"lineBreak":true},{"text":"ti ɓɔlɔa ʋoluma ga nimizai ta duɔlai.","poem":1},{"lineBreak":true},{"text":"Wɛlɛ ba, é zeini zii ɠiligiti saama,","poem":1},{"lineBreak":true},{"text":"é la ziilɛi sɔlɔɔsu.","poem":1},{"lineBreak":true},{"text":"Kpɛɛ nuiti ti yeezeelia ma","poem":1},{"lineBreak":true},{"text":"kidaaʋiligiti saama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siyɔn ʋeleiti ti lɔa gɔlɔi zu,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ nu la mɔ ʋaazu ná, fɛtiiti su.","poem":1},{"lineBreak":true},{"text":"Ná-pɛlɛla ɓogiti pɛ ti ɠoloɠologa,","poem":1},{"lineBreak":true},{"text":"ná-zalaɠa ɠula nuiti ta kpalagi wosu,","poem":1},{"lineBreak":true},{"text":"ná-anzalopoiti gaazuɠiliʋɛ,","poem":1},{"lineBreak":true},{"text":"naa pɛ ka ga ziiɓɔlɔi Siyɔn ʋɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sili nuiti ti vɔniga ma,","poem":1},{"lineBreak":true},{"text":"sakpeɲɔɠɔiti ziilɛiɗa.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI ziizoolɛa","poem":1},{"lineBreak":true},{"text":"ná-tɔ koloɠologiti mɔin vai zu.","poem":1},{"lineBreak":true},{"text":"Ná-doungoiti ti lia,","poem":1},{"lineBreak":true},{"text":"sili nuiti ti ti lɔ duɔlai zu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siyɔn nuɓusɛiti ti ʋalaga","poem":1},{"lineBreak":true},{"text":"ta-lɛbiyaiti pɛ ma.","poem":1},{"lineBreak":true},{"text":"Ta-ɠundiɠi wolaiti kɛɛʋɛ eɠɛ dopaiti,","poem":1},{"lineBreak":true},{"text":"ti la mɔ ani nɔpɛ sɔlɔɔni, ta mi,","poem":1},{"lineBreak":true},{"text":"ti ɗa li ga ɓizaa, zɛbɛ la mɔ ti ya,","poem":1},{"lineBreak":true},{"text":"ti ʋa ɠula dosoi ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ná-maanɔɠɔ voloiti su, voloi é ɠɛni leʋeteʋesu da,","poem":1},{"lineBreak":true},{"text":"Zeluzalɛme ɠi ge loa","poem":1},{"lineBreak":true},{"text":"nii kpein su","poem":1},{"lineBreak":true},{"text":"é ɠɛ ga zeaɠɔli pagɔiti mɔungi.","poem":1},{"lineBreak":true},{"text":"Siɛgi zu ná-nuɓusɛiti ti lɔɔni la sili nuiti zeezu,","poem":1},{"lineBreak":true},{"text":"nu la ná a ɓɔ ti ʋa,","poem":1},{"lineBreak":true},{"text":"sili nuiti ti ɠɛni ɲɛɛɠulazu su,","poem":1},{"lineBreak":true},{"text":"tɔɔzei é ɠoloɠologa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zeluzalɛme ná-kotoi wola zeizeiɗa ɠoozu,","poem":1},{"lineBreak":true},{"text":"naa ɠa é kɛa é ɠɔzɔa.","poem":1},{"lineBreak":true},{"text":"Niiti kpein ti ɠɛni maamusɛzu,","poem":1},{"lineBreak":true},{"text":"naati ta niina suvɛzu, ta ɠɛna kabei ɠaa.","poem":1},{"lineBreak":true},{"text":"Tɔ ɓɔɠɔi, toɠa kpalagi wosu,","poem":1},{"lineBreak":true},{"text":"é ɗa ɠula ʋolu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ná-alu kaa ɲamai ma ɠɔzɔi ʋogiti ta ná-seɠeiti su,","poem":1},{"lineBreak":true},{"text":"é la ɠigaiziɛni gaaɓelazuʋɛ zu,","poem":1},{"lineBreak":true},{"text":"ná-tooi ɠulaʋɛ filiba,","poem":1},{"lineBreak":true},{"text":"nu la koba, é ʋa tɛnɛ.","poem":1},{"lineBreak":true},{"text":"É ɠɛ ma: «Ɠɔoɠɔ GALAGI, wɛlɛ nà-nimizai ʋa,","poem":1},{"lineBreak":true},{"text":"wɛlɛ ʋelei sìli nui pilɛ sɔlɔɔsu la.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sili nuiti ti yeeʋɛa","poem":1},{"lineBreak":true},{"text":"ná-naavoloiti ma mɛɛ.","poem":1},{"lineBreak":true},{"text":"Tɔ ɓɔɠɔi zii ɠiligiti kaani,","poem":1},{"lineBreak":true},{"text":"ti lɔ ná-seizu ɲadegai zu.","poem":1},{"lineBreak":true},{"text":"Kɛlɛ tɔun, Maliɠii, è tɔ seini ma,","poem":1},{"lineBreak":true},{"text":"ga ti mina ɠɛ ɗa-ɠaalɛbai zu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ná-nuɓusɛi pɛ ka ɓalasu,","poem":1},{"lineBreak":true},{"text":"ti ɗa daamianigi ɠaiziɛ,","poem":1},{"lineBreak":true},{"text":"ti ti-yeaɠɔli pagɔi pɛ fea daamiani fai zu,","poem":1},{"lineBreak":true},{"text":"nii a kɛ ti yiila.","poem":1},{"lineBreak":true},{"text":"«Pɛtɛ, Ɠɔoɠɔ GALAGI, wɛlɛ,","poem":1},{"lineBreak":true},{"text":"ʋelei wɔ̀inzeɠeai la!»","poem":1}]},{"type":"heading","content":["Zeluzalɛme ná-gɔlɔ wooi"]},{"type":"verse","number":12,"content":[{"text":"«Wɔiti pɛ wo leʋesu ʋɛ ʋelei, niima maanɔɠɔi la zeelini wo ma.","poem":1},{"lineBreak":true},{"text":"À wɛlɛ, wo ɠida bu,","poem":1},{"lineBreak":true},{"text":"nu nɔpɛ ná-taɓa la dɛ zeelini nii zu,","poem":1},{"lineBreak":true},{"text":"nii gè sɔlɔɔsu,","poem":1},{"lineBreak":true},{"text":"nii Ɠɔoɠɔ GALAGI daa mà,","poem":1},{"lineBreak":true},{"text":"ná-ziiɠaawana wolai ma voloi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"É abui yeiɗa, é zeɠe geezuʋɛ,","poem":1},{"lineBreak":true},{"text":"é ʋa, é lɔ kpùsɛi zu.","poem":1},{"lineBreak":true},{"text":"É baliiti tɛa tùɠɔ,","poem":1},{"lineBreak":true},{"text":"é tòkaga ga pòluʋelei.","poem":1},{"lineBreak":true},{"text":"É ɓeteʋea bà mɛtu,","poem":1},{"lineBreak":true},{"text":"ma zeeɓɛi ɠa bà yeenɔpɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zeei nà-tɔ koloɠologiti gilia ba,","poem":1},{"lineBreak":true},{"text":"ti laani ɓɔɠɔ maazu eɠɛ galui,","poem":1},{"lineBreak":true},{"text":"ti lɛ, ti zei kɔ̀bu.","poem":1},{"lineBreak":true},{"text":"Maliɠii sɛ̀bɛi zuzaa,","poem":1},{"lineBreak":true},{"text":"é dɔ̀a sili nuiti zeezu,","poem":1},{"lineBreak":true},{"text":"niiti gè la zooga faa nɔpɛ kɛɛzu ga tiye.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Maliɠii nà-salaʋusu ɠɛzɛiti kpɛa,","poem":1},{"lineBreak":true},{"text":"niiti ti ɠɛa nɔ̀un ba.","poem":1},{"lineBreak":true},{"text":"É salaʋusuiti toliga dàalɔɠɔma,","poem":1},{"lineBreak":true},{"text":"nii a kɛ é nà-nu niinɛiti suɠoloɠolo.","poem":1},{"lineBreak":true},{"text":"É sùɠoloɠologa, nɛ̀i gè ga Zuda ná-Siyɔin,","poem":1},{"lineBreak":true},{"text":"eɠɛ nu a leezɛn ʋu kɔɠɛi zu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naati pɛ faa ɠa gè wɔlɔzu su,","poem":1},{"lineBreak":true},{"text":"gàazuɗɛi pɛ ge ʋua,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ gaanɛɛnɛ nui maaɠooza bà,","poem":1},{"lineBreak":true},{"text":"toɠa a la zìilaa.","poem":1},{"lineBreak":true},{"text":"Dòinti pɛ ti ɠaalɛiɗa gola,","poem":1},{"lineBreak":true},{"text":"tɔɔzei sìli nui zobo zɔlɔɔga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Siyɔn yeelɛɛni geezu,","poem":1},{"lineBreak":true},{"text":"nu nɔpɛ ge la gaanɛɛnɛni.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ná-devei ɠa","poem":1},{"lineBreak":true},{"text":"é Izilayɛle zeiɲɔɠɔiti kɛa ga sili nuiti.","poem":1},{"lineBreak":true},{"text":"Zeluzalɛme ɠɛa","poem":1},{"lineBreak":true},{"text":"ti ɠaazu ga kɔzɔba anii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Ɠɔoɠɔ GALAGI zɔlegɛ, é naa ɠɛ,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ gè la ɠoloni ná-deveiti bɛ.","poem":1},{"lineBreak":true},{"text":"À woilo, nuɓusɛiti pɛ,","poem":1},{"lineBreak":true},{"text":"à nà-kpɔlɔiti pɛtɛ!","poem":1},{"lineBreak":true},{"text":"Dòun ɓeaiti ta dòun lakpagiti","poem":1},{"lineBreak":true},{"text":"ti lia duɔlai zu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gè wooɠulani nɛ̀ɛɲɔɠɔiti ma,","poem":1},{"lineBreak":true},{"text":"kɛlɛ ti yàavani.","poem":1},{"lineBreak":true},{"text":"Nà-zalaɠa ɠula nuiti ta nà-kɛwolaiti","poem":1},{"lineBreak":true},{"text":"ti zaani taazuʋɛ,","poem":1},{"lineBreak":true},{"text":"ti yɛ daamiani gaiziɛ vai ma,","poem":1},{"lineBreak":true},{"text":"ti ʋa zɛbɛ zɔlɔɔ ʋolu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, nà-kpɔlɔi ʋɛtɛ!","poem":1},{"lineBreak":true},{"text":"Kòozuʋɛ ɠɛa nɔ yupuyapa,","poem":1},{"lineBreak":true},{"text":"zìiɓɔlɔa kòozu,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ gè kololalai ɠɛɛni gola.","poem":1},{"lineBreak":true},{"text":"Boɠa zɔkpɔi ɠa bàlasu dòinti ma etea ʋelei,","poem":1},{"lineBreak":true},{"text":"pɛlɛwu ʋelei, eɠɛ nɔ nà ɠɛ saai ɓɔɠɔi ɠoba.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ta kpàla gooiti mɛnisu,","poem":1},{"lineBreak":true},{"text":"nu nɔpɛ ge la gàanɛɛnɛzu.","poem":1},{"lineBreak":true},{"text":"Sìli nuiti pɛ ti nà-maanɔɠɔ vai zuɠwɛɛga,","poem":1},{"lineBreak":true},{"text":"é nɛɛni ti ʋɛ gola ga è naa zei mà.","poem":1},{"lineBreak":true},{"text":"Foloi è ma vaa woni, è ʋaa la,","poem":1},{"lineBreak":true},{"text":"nii é zeini mà, ti naa ɠɛɠalai zɔlɔɔ!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wɛlɛ fɔɔn ta-zuɲɔuyai ʋa,","poem":1},{"lineBreak":true},{"text":"è ti zo da","poem":1},{"lineBreak":true},{"text":"eɠɛʋelei è sòni da","poem":1},{"lineBreak":true},{"text":"nà-tɔ koloɠologiti faa zu!","poem":1},{"lineBreak":true},{"text":"Wɛlɛ, nà ɓalasu nɔ ɠɔ,","poem":1},{"lineBreak":true},{"text":"zìi ɠana wana.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}