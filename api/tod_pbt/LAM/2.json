{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"LAM","translationId":"tod_pbt","name":"Gɔlɔ Wooiti","commonName":"Gɔlɔ Wooiti","title":"Zelemi Ná-Gɔlɔ Wooiti","order":25,"numberOfChapters":5,"sha256":"76fbcaeb5e3e961871d873b3e2fa35f126697a85a6d5bacef4923bac47bf577a","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tod_pbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Zeluzalɛme taaita GALA sei ʋɛlɛi ti ɠoloɠolo fai"]},{"type":"verse","number":1,"content":[{"text":"Ee, Maliɠii ná-ziiɠaawanai zu,","poem":1},{"lineBreak":true},{"text":"é Zeluzalɛme maalɔɔɠua ga tonaɓiingi!","poem":1},{"lineBreak":true},{"text":"É Izilayɛle ná-lɛbiyai ɠulaa geezuʋɛ,","poem":1},{"lineBreak":true},{"text":"é pili ya zooi ma!","poem":1},{"lineBreak":true},{"text":"Siɛgi zu é yiiɠaawanani la Siyɔn laalɔɠɔma,","poem":1},{"lineBreak":true},{"text":"é yeemani ga ná-kɔɠɔloma anii nɔ ʋe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maliɠii la maawɔinɠaa ɠɛɛni,","poem":1},{"lineBreak":true},{"text":"é Zakɔɓe ná-pɛlɛyeɠeiti pɛ kpɔleni.","poem":1},{"lineBreak":true},{"text":"É yɛni ná-ziiɠaawanai zu,","poem":1},{"lineBreak":true},{"text":"é Zuda laa wolaiti pɛ koloɠolo, siɠigi ti ma,","poem":1},{"lineBreak":true},{"text":"é masadai ta ma ɠundiɠiiti puuni ya zooi ma,","poem":1},{"lineBreak":true},{"text":"é ɓaaɠula ti ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ná-ziiɠaawana wolai zu,","poem":1},{"lineBreak":true},{"text":"é Izilayɛle ná-zobogi pɛ koloɠoloni.","poem":1},{"lineBreak":true},{"text":"É ɓɔɠɔ zoni, é la ti maaloboni","poem":1},{"lineBreak":true},{"text":"siɛgi zu ti zili nuiti ti ʋaani la.","poem":1},{"lineBreak":true},{"text":"É abui ɠaazoga ná-nuɓusɛiti pɔ bɛ,","poem":1},{"lineBreak":true},{"text":"naa ti-maaɠoolii pɛ galani.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"É ná-mɛɛin zumɛɛnga eɠɛ nu zili nui,","poem":1},{"lineBreak":true},{"text":"é zeezai ʋɛɛ ma ga é ʋa pili.","poem":1},{"lineBreak":true},{"text":"É ɓɔɠɔ lɛ ga gi zili nui ʋe,","poem":1},{"lineBreak":true},{"text":"é naa kpein paa, nii nu ɠaazu ɠɛa ɠulazu ba.","poem":1},{"lineBreak":true},{"text":"É ná-ziiɠaawanai ʋua eɠɛ abui","poem":1},{"lineBreak":true},{"text":"Siyɔn GALA sei ʋɛlɛi ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maliɠii gi zoni eɠɛ gi zili nui,","poem":1},{"lineBreak":true},{"text":"é Izilayɛle ɓɔleni","poem":1},{"lineBreak":true},{"text":"ta ná-pɛlɛ ʋapagiti pɛ,","poem":1},{"lineBreak":true},{"text":"é ná-siɠigiti golowolo,","poem":1},{"lineBreak":true},{"text":"é ziizoolɛi ta kidaaʋiligi lɔ","poem":1},{"lineBreak":true},{"text":"Zuda nuɓusɛiti su adaʋɛ pɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"É ná-kpelei ma zasai ɠatani,","poem":1},{"lineBreak":true},{"text":"ná-gaalɛba wosuʋɛ ná ga sei ʋɛlɛi, é miná ɠoloɠoloni.","poem":1},{"lineBreak":true},{"text":"Siyɔn, Ɠɔoɠɔ GALAGI zeemai woni","poem":1},{"lineBreak":true},{"text":"fɛti voloiti ma ta dooɠo foloiti.","poem":1},{"lineBreak":true},{"text":"Ná-ziimaleʋei ma yiiɠaawanai zu,","poem":1},{"lineBreak":true},{"text":"é ɓaaɠulani masagiti ma ta zalaɠa ɠula nuiti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maliɠii la mɔ ná-zalaɠa ɠulazuʋɛ ʋɔ,","poem":1},{"lineBreak":true},{"text":"é ɠɛlɛa sei ʋɛlɛ ɲadegai ʋa,","poem":1},{"lineBreak":true},{"text":"é zɛni ná, é loo sili nuiti zeezaama,","poem":1},{"lineBreak":true},{"text":"Siyɔn ʋɛlɛ ʋapagiti ma ziɠigiti.","poem":1},{"lineBreak":true},{"text":"Ti-wooi ɠa ɠulazu Ɠɔoɠɔ GALAGI zei ʋɛlɛi wu","poem":1},{"lineBreak":true},{"text":"eɠɛ fɛti voloi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI deveni","poem":1},{"lineBreak":true},{"text":"ga é Siyɔn ziɠigiti golo.","poem":1},{"lineBreak":true},{"text":"É galui laani ma, gaa ʋa ɠɛ sɔli,","poem":1},{"lineBreak":true},{"text":"é la inɛinɛni ga golo vai.","poem":1},{"lineBreak":true},{"text":"É siɠi felegɔi pɛ doɠani,","poem":1},{"lineBreak":true},{"text":"tama ti felegɔ pɛ ti ɠoloni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Taai laaʋɛ ma ɓogiti ti ʋua ya,","poem":1},{"lineBreak":true},{"text":"é ma zɔɠɔgiti suɓulukpuluni.","poem":1},{"lineBreak":true},{"text":"Ná-masagi ta ná-kundiɠiiti ta zii ɠiligiti zeezu,","poem":1},{"lineBreak":true},{"text":"tɔ ge la mɔ ná.","poem":1},{"lineBreak":true},{"text":"Anɛɛ ná-GALA goo wo nuiti","poem":1},{"lineBreak":true},{"text":"ti la mɔ kulakɛlɛma zɔlɔɔsu Ɠɔoɠɔ GALAGI ya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siyɔn nuɓusɛiti ta-ɠɛwolaiti","poem":1},{"lineBreak":true},{"text":"ta zeini zooi ma, ti maaɠɛ kpɔ,","poem":1},{"lineBreak":true},{"text":"ti fufiligi ʋu tɔungi ma,","poem":1},{"lineBreak":true},{"text":"ti saa wɔlɔ wo seɠeiti too ɠɔba.","poem":1},{"lineBreak":true},{"text":"Zeluzalɛme anzalopoiti","poem":1},{"lineBreak":true},{"text":"ti unpilɛga zooi ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gàazuɠɛzɛiti ti ɓɔlɔa ga gɔlɔi,","poem":1},{"lineBreak":true},{"text":"sàsu ɠana ɓali,","poem":1},{"lineBreak":true},{"text":"kito nɔpɛ ge la mɔ bɛ̀,","poem":1},{"lineBreak":true},{"text":"é lo maanɔɠɔi ʋa é zeelizu nà-nuɓusɛiti ma,","poem":1},{"lineBreak":true},{"text":"tɔɔzei ɲiimiɓɔlegiti ta doungo ʋɛlɛʋɛlɛgiti ta zaazu ga kpɔɔle wɔin","poem":1},{"lineBreak":true},{"text":"taazuʋɛ peleiti su.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Doungoiti ti ɗa ɠɛ ti-leeni ma:","poem":1},{"lineBreak":true},{"text":"«Mini ɠa ani ná nu mi ɓaa nu kpɔle?»","poem":1},{"lineBreak":true},{"text":"Naazu ti ɗa ɠɛ yɔɔɠɛ, eɠɛ nuiti ti maawanaai","poem":1},{"lineBreak":true},{"text":"taa zaamaʋɛ peleiti su,","poem":1},{"lineBreak":true},{"text":"ti-yii loozu niina","poem":1},{"lineBreak":true},{"text":"ti-lee yeelokoiti su.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zeluzalɛme, gè la kwɛɛ nii nà bo è ma,","poem":1},{"lineBreak":true},{"text":"è ɠɛʋelei la ɠulani ga taɠili nɔpɛ nɔnɔ!","poem":1},{"lineBreak":true},{"text":"Ɓɛ ná-faa ɠa nà bo è ma, gè è ɠaanɛɛnɛ la,","poem":1},{"lineBreak":true},{"text":"Siyɔn nuɓusɛiti?","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ ɗa-nimizai zuwɔɔlɔʋɛ eɠɛ kpoloɗɛi,","poem":1},{"lineBreak":true},{"text":"ɓɛ ɠa deɠɛmu a zoo é è ɠɛdɛ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɗa-ƓALA goo wo nuiti ti ɠɛni è ʋɛ","poem":1},{"lineBreak":true},{"text":"ga zɛɛ wo nuiti nɔ.","poem":1},{"lineBreak":true},{"text":"Ti la ɠɛni ɗa-vaaɠaaza golai ɠulani kɛlɛma è ʋɛ,","poem":1},{"lineBreak":true},{"text":"nii a kɛ è mina li duɔlai zu.","poem":1},{"lineBreak":true},{"text":"Ti ɠɛni kulakɛlɛmaiti kaazu è ʋɛ,","poem":1},{"lineBreak":true},{"text":"ti ga zɛɛ ɓɔɛiti, ta yaava vaiti nɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zɔiti pɛ ti leʋesu náʋɛ","poem":1},{"lineBreak":true},{"text":"ta yealoɠazu ma tɔɔzei è ɠoloɠologa,","poem":1},{"lineBreak":true},{"text":"ti ɗa foei vɛ, ti ɗa tɔungiti ɲiikpi","poem":1},{"lineBreak":true},{"text":"ga ti ɲɛɛɠula è zu, Zeluzalɛme:","poem":1},{"lineBreak":true},{"text":"«Taa wolai ɠa nɛi, ti ɠɛni tolisu ga","poem":1},{"lineBreak":true},{"text":"pagi daazeeliai, eteai pɛ ná-koozunɛɛi?»","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"È zili nuiti pɛ","poem":1},{"lineBreak":true},{"text":"ta laalaosu è laalɔɠɔma,","poem":1},{"lineBreak":true},{"text":"ti ɗa foei vɛ, ti ɗa ɲiigaiti siɛ ga,","poem":1},{"lineBreak":true},{"text":"ti ɗa ɠɛ ma: «Gi kpɔlea!","poem":1},{"lineBreak":true},{"text":"Zaa voloi ɠa gi ɠɛa maaɓɔunsu,","poem":1},{"lineBreak":true},{"text":"gi yeezeelia ma, gá ga ka.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nii Ɠɔoɠɔ GALAGI a bo, naa ɠa a ɗa kɛ,","poem":1},{"lineBreak":true},{"text":"toɠa ɗa daawooi ʋilɛ su","poem":1},{"lineBreak":true},{"text":"nii é boni kaite wɔlɔwɔlɔ,","poem":1},{"lineBreak":true},{"text":"é goloni, maawɔinɠaa la su.","poem":1},{"lineBreak":true},{"text":"Ɗa-nimiza vai ɠɛa ga è zili nuiti ta-ɠoozunɛɛi,","poem":1},{"lineBreak":true},{"text":"é è-zakpeɲɔɠɔiti ta-wasogi wɔɔlɔa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nuɓusɛi ɓain gooi ɠa lɛɛzu Maliɠii ʋɔ pelei.","poem":1},{"lineBreak":true},{"text":"Siyɔn ziɠigi,","poem":1},{"lineBreak":true},{"text":"ɓe è-ɠaazuɗɛ ɓoigi ʋa,","poem":1},{"lineBreak":true},{"text":"é ʋu folo ʋɛɛ kpidi ʋa.","poem":1},{"lineBreak":true},{"text":"Mina lago pa dooɠo,","poem":1},{"lineBreak":true},{"text":"maaleʋe mina ɠɛ ɗa-wɔlɔi ʋa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wuzeɠe, è maanɛɛnɛi wo kpidii,","poem":1},{"lineBreak":true},{"text":"lɛlɛi ɠilagilagi pɛ tɔɔzeizuʋɛ!","poem":1},{"lineBreak":true},{"text":"Kula yiimaʋɛ","poem":1},{"lineBreak":true},{"text":"Maliɠii ɠaazu.","poem":1},{"lineBreak":true},{"text":"Yeezei bɛ ga maanɛɛnɛi","poem":1},{"lineBreak":true},{"text":"è-lointi zɛnvui vaa zu,","poem":1},{"lineBreak":true},{"text":"ti zaazu niina ga pului","poem":1},{"lineBreak":true},{"text":"koi yɔɠɔzu ʋelei pɛ su.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wɛlɛ, Ɠɔoɠɔ GALAGI, pɛtɛ","poem":1},{"lineBreak":true},{"text":"niiti è ti zosu ɠana!","poem":1},{"lineBreak":true},{"text":"Anzanuiti ta zoo nɛi ti ti-lointi mi,","poem":1},{"lineBreak":true},{"text":"niiti ti ti zogai ɠoozu, ti nɛai ti ʋɛ?","poem":1},{"lineBreak":true},{"text":"Nu ɠa zoo nɛi é ɗa-zalaɠa ɠula nuiti ta GALA goo wo nuiti paa,","poem":1},{"lineBreak":true},{"text":"Maliɠii è zei ʋɛlɛ ɲadegai wu?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Doungoiti ta nu wɔlɔiti","poem":1},{"lineBreak":true},{"text":"ta ʋuuni zooi ma taazuʋɛ ná pɛ.","poem":1},{"lineBreak":true},{"text":"Doun anzanuiti ta doun zunuiti ta laani","poem":1},{"lineBreak":true},{"text":"boɠa zɔkpɔi laaʋogi ti ʋa.","poem":1},{"lineBreak":true},{"text":"È ti ʋaani ɗa-yiiɠaawana voloi,","poem":1},{"lineBreak":true},{"text":"è ti ɠɔdaaleʋeni, maawɔinɠaa la su.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"È dùaba nuɓusɛiti toliga mà,","poem":1},{"lineBreak":true},{"text":"eɠɛ fɛti volo.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, ɗa-yiiɠaawana voloi,","poem":1},{"lineBreak":true},{"text":"fulu nu la ɠulani, ɓaa pela gele.","poem":1},{"lineBreak":true},{"text":"Dointi gè ti nɛɛni ʋɛ gola, gè ti ɠula su,","poem":1},{"lineBreak":true},{"text":"sìli nui ti pɛ undaaʋiliga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}