{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":1,"content":[{"type":"heading","content":["Undaanɛ ɠitei"]},{"type":"verse","number":1,"content":[{"text":"Undaanɛ nu ɠa ga naa, nii é la ziɛzu ga faa ɲɔu ɠɛ nuiti ta-lɛnɛ gooi,","poem":1},{"lineBreak":true},{"text":"é la ziɛzu ga kotoba nuiti siɛ ʋelei,","poem":1},{"lineBreak":true},{"text":"é la zeizu ɲɛɛɠulasu nuiti ta-ɓɔkpɔgi ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kɛlɛ ziima vai ɠa ga Ɠɔoɠɔ GALAGI ná-tɔgi,","poem":1},{"lineBreak":true},{"text":"é ɗa ɠizɛ ná-tɔgi zu, folo ʋɛɛ kpidi ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kɛɛʋɛ eɠɛ gului nii siingai ziɛlaʋɛ,","poem":1},{"lineBreak":true},{"text":"é gwaai wosu ga gwaa yeeɠɛɠalai,","poem":1},{"lineBreak":true},{"text":"gaalaagi la ʋooloa,","poem":1},{"lineBreak":true},{"text":"nii kpein é kɛɛzu, ta ɗa zoloo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"É la ɠana ga faa ɲɔu ɠɛ nuiti,","poem":1},{"lineBreak":true},{"text":"ti ɠɛɛʋɛ eɠɛ molo ɠalai fiilɛi liizu la.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naa ɠa é ba, faa ɲɔu ɠɛ nuiti ti la losu zɔlɔɔga tukpɔɠaaleʋe voloi.","poem":1},{"lineBreak":true},{"text":"Kotoba nuiti ɓalaa, ti la zeizu zɔlɔɔga telebo nuiti saama.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI ɠaazu ɠa telebo nuiti ta-ʋelei ʋa.","poem":1},{"lineBreak":true},{"text":"Kɛlɛ kotoba nuiti ta-ʋelei ɠa liizu ga tiye undaaʋiligi zu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}