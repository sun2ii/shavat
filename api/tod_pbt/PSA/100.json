{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"heading","content":["Ɠɔoɠɔ GALAGI ná-nuɓusɛiti ti maamusɛ"]},{"type":"verse","number":1,"content":[{"text":"Faanɛɛ wuuɠwɛɛ guyei.","descriptive":true},{"lineBreak":true},{"text":"À wooɠula ga koozunɛɛi Ɠɔoɠɔ GALAGI ʋɛ, eteai kpein!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À Ɠɔoɠɔ GALAGI lɛbi ga koozunɛɛi,","poem":1},{"lineBreak":true},{"text":"à ʋa pɔ bɛ ga koozunɛ wuyeiti toa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À suɠwɛɛ ga Ɠɔoɠɔ GALAGI ɠila ka é ga GALAGI!","poem":1},{"lineBreak":true},{"text":"Tɔ ɠa é de ɓɛtɛa, da ga nɔnɔiti,","poem":1},{"lineBreak":true},{"text":"da ga ná-nuɓusɛiti, ná-baala kpulugi é kɔnɔkulazu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"À lɛ ná-siɠidaʋɛti ga faanɛɛ wuuɠwɛɛgaiti,","poem":1},{"lineBreak":true},{"text":"à lɛ ná-koizuʋɛti ga maamusɛi!","poem":1},{"lineBreak":true},{"text":"À dɛbi, wo mamagi ve bɛ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI ʋagɛ, ná-nuɓɔɠɔlai ɠa ná eyɛsu ɠɔ,","poem":1},{"lineBreak":true},{"text":"ta ná-wooɠɛɠiladai ɓela ge la ba, yeeɠɛɠalaiti pɛ su.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}