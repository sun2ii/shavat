{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":101,"content":[{"type":"heading","content":["Minazeɠegi é lo faa ɲɔi zakpe fai ʋa"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Nà wooɠɛɠiladai ta telebodai ma wuyei loozu,","poem":1},{"lineBreak":true},{"text":"nà naa ɠɛɛzu è lɛbi vai ma ga guyei, ee, Ɠɔoɠɔ GALAGI!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nà ʋilɛ sɔle nuiti ta-ʋelei ma.","poem":1},{"lineBreak":true},{"text":"Yeelɛ ɠa è ʋaazu la pɔ̀ bɛ?","poem":1},{"lineBreak":true},{"text":"Nà ziɛ ga zii ʋagɔlai","poem":1},{"lineBreak":true},{"text":"nà-pɛlɛi wu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gè la ʋɔɔpɛa faa ɲɔu ɠɛɛ vaa nɔpɛ ba.","poem":1},{"lineBreak":true},{"text":"Kidaaleʋelala luʋai maayo ge la nɔ̀un bɛ,","poem":1},{"lineBreak":true},{"text":"gè la yeezeiɗa naa tanɔpɛ bu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaava ɠisiɛi maaɠooza nɔ̀un ba,","poem":1},{"lineBreak":true},{"text":"gè la faa ɲɔu ɠwɛɛga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nui é vaazu seiɲɔɠɔi ma dɔɔɠuzu,","poem":1},{"lineBreak":true},{"text":"nà daaɠulu,","poem":1},{"lineBreak":true},{"text":"nui nii gaazulɛai, ziimaʋɛ laavegai ga wasogi,","poem":1},{"lineBreak":true},{"text":"gè la yeezeiɗa naa wu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nà ɠaazulo sɔle nuiti ba, ti zooi zu,","poem":1},{"lineBreak":true},{"text":"gè ti zei ɠoba.","poem":1},{"lineBreak":true},{"text":"Niiti ti ziɛzu ga sɔle nuiti kɛʋele,","poem":1},{"lineBreak":true},{"text":"naati ta ɠɛ nà-botii zu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaava nu la zeizu zɔlɔɔga nà-pɛlɛi wu,","poem":1},{"lineBreak":true},{"text":"zɔi é ga zɛɛ wo nui, naa la losu zɔlɔɔga gàazu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sobu-o-sobu, nà faa ɲɔu ɠɛ nuiti daaɠulu ti zooi zu,","poem":1},{"lineBreak":true},{"text":"naa ɠa a kɛ, gè ti ɓeteʋe Ɠɔoɠɔ GALAGI ná-taai ʋa,","poem":1},{"lineBreak":true},{"text":"tɛiti kpein ti telebotala vai ɠɛɛzu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}