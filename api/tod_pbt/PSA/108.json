{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":108,"content":[{"type":"heading","content":["Nà pilɛ sɔlɔɔ!"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei. Guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ladalai ɠa zìimaʋɛ, ee, GALA!","poem":1},{"lineBreak":true},{"text":"Nà guyei loo, gè è maamusɛ ga zìimaʋɛ pɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À wuzeɠe, wa ʋe, nà-kɔnigi ta nà-papai!","poem":1},{"lineBreak":true},{"text":"Nà geelaalaosuʋɛ maaloɠa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nà è maamusɛ ziiti pɛ saama, ee, Ɠɔoɠɔ GALAGI.","poem":1},{"lineBreak":true},{"text":"Nà guyei loo è ʋɛ zii ɠiligiti saama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ ɗa-nuɓɔɠɔlai ɓudɛʋɛ geeɠɔlɔgi maazu,","poem":1},{"lineBreak":true},{"text":"ta ɗa-wooɠɛɠiladai tonaɓiingiti maazu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ee, GALA, è wɔɔlɔ ʋelei lɛ geeɠɔlɔgi maazuʋɛ!","poem":1},{"lineBreak":true},{"text":"Ɗa-lɛbiyai volo eteai zu ná pɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"naa ɠa a kɛ, niiti è ti nɛai ʋɛ, naati ti unmɔɔ.","poem":1},{"lineBreak":true},{"text":"Kizogi wo ga è-yeezai, gòoɠaaʋote.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"GALA ge ɓɔɛni seizu ɲadegai, é ɠɛ ma: «Pilɛ sɔlɔɔ nui ɠa é ga ze!","poem":1},{"lineBreak":true},{"text":"Nà Sikɛme ɠaaɠwɛ su, gè Sukɔte nɛmɛi ɠaaɠwɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Galaade ɠa ga nɔ̀nɔ, Manasé ɠa ga nɔ̀nɔ,","poem":1},{"lineBreak":true},{"text":"Efelayime ɠa ga kɔɔɠɔ wɔɔlɔgi ùnba,","poem":1},{"lineBreak":true},{"text":"Zuda ɠa ga nà-masa tukpɔi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moaɓe ɠa ga kokoi, nii gè maagbazu su,","poem":1},{"lineBreak":true},{"text":"nà-saʋala pilisuʋɛ ɠa ga Edɔme yooi.","poem":1},{"lineBreak":true},{"text":"Nà pilɛ sɔlɔɔ kpeei loozu Filisiti nuiti ta-yooi laalɔɠɔma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɓɛ ɠa a li ga ze taa wolai zu, nii siɠigi ma?","poem":1},{"lineBreak":true},{"text":"Ɓɛ ɠa a li ga ze Edɔme?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ee, GALA, ɗa laade ɓaa, è ɠɛa ɠɛlɛni gi ʋa?","poem":1},{"lineBreak":true},{"text":"Ee, GALA, siɛgi zu gá-ɠɔɔɠɔ nuiti ti ɠɛni ɠulazu la, è la mɔ ɠɛni ʋilɛsu ti ʋolu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɓɔ gi ʋa gi zili nuiti daalɔɠɔma,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ nuɓusɛiti ta-ɓɔbai ɠa nɔ ga wafuun faa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ni GALA ka ade ʋa, ada pilɛ sɔlɔɔ,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ tɔ ɠa é ade zili nuiti dɛɛvɛzu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}