{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":11,"content":[{"type":"heading","content":["Nu lɔɔɠuzu ʋagɔi"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Dɔ̀ɔɠuzuʋɛ ɠa ga Ɠɔoɠɔ GALAGI ʋɔ bɛ.","poem":1},{"lineBreak":true},{"text":"Wa zoo ɠale ɠɛɛzu mà:","poem":1},{"lineBreak":true},{"text":"«Ʋela è li gizeiti ma, eɠɛ wɔni»?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ faa ɲɔu ɠɛ nuiti ta mɛɛin ɠaalɛɛzu,","poem":1},{"lineBreak":true},{"text":"ti mɛɛn ɠaei ɠɛʋele ɓɛtɛ galui ma,","poem":1},{"lineBreak":true},{"text":"ti ʋa pili naati ma kpidii zu, niiti ti-yii zɔlegai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siɛgi zu ma ɓogiti ti lokasu da,","poem":1},{"lineBreak":true},{"text":"leeni ɠa telebo nui a kɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠa sei ʋɛlɛ ɲadegai wu.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ná-masa kpɔkpɔgi ɠa geeɠɔlɔgi zu,","poem":1},{"lineBreak":true},{"text":"gaazuʋɛ ɠa wozaɠaazu,","poem":1},{"lineBreak":true},{"text":"toɠa wɛlɛzu ga ɠaazuʋɛ, é ɗa nuɓusɛiti sumɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa telebo nui ta faa ɲɔu ɠɛ nuiti ta-vai wuuʋɛtɛsu.","poem":1},{"lineBreak":true},{"text":"Toɠa naama nui wɔinzeɠezu, nii toomai nɛai bɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"É abulekai ʋu kae faa ɲɔu ɠɛ nuiti ma, nii é ɠalazu ga timinigi.","poem":1},{"lineBreak":true},{"text":"Fiilɛ ɓadii nii é galai wosu, naa ɠa é ga ta-ɠulanumai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI zɔlegɛ, telebo faiti nɛɛʋɛ bɛ.","poem":1},{"lineBreak":true},{"text":"Nuiti ti zɔlegai, naati ta gaazuʋɛ ʋɛtɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}