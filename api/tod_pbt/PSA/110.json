{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"heading","content":["Masagi zalaɠa ɠula nui"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI laawooi é boni màliɠii ma:","poem":1},{"lineBreak":true},{"text":"«Zei zèezazuʋɛ,","poem":1},{"lineBreak":true},{"text":"eyɛsu gè è zili nuiti kɛ ga ɗa-ɠɔɠɔloma anii.»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa ɗa-masadai ma zɛbɛi zuwɔɔlɔzu,","poem":1},{"lineBreak":true},{"text":"é zo Siyɔn GALA sei ʋɛlɛi ma.","poem":1},{"lineBreak":true},{"text":"Ɗa masadai ɠɛ è zili nuiti saama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Voloi ɗa ɠɛ kɔɔi ɠɔɔzu la,","poem":1},{"lineBreak":true},{"text":"ɗa-nuɓusɛiti daa ɠa ve ga ziilɔɔi,","poem":1},{"lineBreak":true},{"text":"ti ɗa ʋa è ʋɔ ga kpizɛi, maaɠili ɲadegai zu,","poem":1},{"lineBreak":true},{"text":"sobuzobui, ɗa-ɠɔɔɠɔ zunu loungoiti ta suvilɛ ga ʋaa è ʋɔ bɛ, eɠɛʋelei nɔɗagi a ɗa ʋuu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠonani, tama é la zeɠea woo ʋolu, é ɠɛni ma:","poem":1},{"lineBreak":true},{"text":"«Ɗa ga zalaɠa ɠula nui eyɛsu ɠɔ, eɠɛʋelei Mɛlekizedɛke ɠɛni la.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"È-Maliɠii ɠa è ɠobaʋɛ,","poem":1},{"lineBreak":true},{"text":"ná-ziiɠaawana voloi, toɠa masagiti dɛɛvɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Toɠa ná-tukpɔi laalɛ zii ɠiligiti bu,","poem":1},{"lineBreak":true},{"text":"nu ʋoomai ma ɓulugiti gaa ɠa lɛ ba,","poem":1},{"lineBreak":true},{"text":"toɠa kundiɠiiti dɛɛvɛ eteai zu naa kpein.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Toɠa","poem":1},{"noteId":30},{"text":"ɓɔɔle pelei zu kɔtuɗɛi ɠa,","poem":1},{"lineBreak":true},{"text":"naa ʋoluma toɠa nɔungi wuzeɠe.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Toɠa: Masagi ɠa ti vaazu ma.","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/tod_pbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}