k":true},{"text":"Toɠa zeini anii kpein unga geezuʋɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛlɛ toɠa ɗa ungi ʋilɛ,","poem":1},{"lineBreak":true},{"text":"é geeɠɔlɔgi ɠa ta zooi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Toɠa ɗa maawɔin nui ɠula fufiligi zu,","poem":1},{"lineBreak":true},{"text":"toɠa ɗa maanɔɠɔ nui wuzeɠe, é kula kpoɠagi zu,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"é sei seizumaanɛgiti saama,","poem":1},{"lineBreak":true},{"text":"ná-nuɓusɛiti ta-zeizumaanɛgiti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Toɠa pɛlɛyeɠei ve doun zɔlɔɔtala anzanui ya,","poem":1},{"lineBreak":true},{"text":"é koozunɛɛi zɔlɔɔ, tɔɔzei é ɠɛa ga dounɠa ti-lee.","poem":1},{"lineBreak":true},{"text":"À Ɠɔoɠɔ GALAGI maamusɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}