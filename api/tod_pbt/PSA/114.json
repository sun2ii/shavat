{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"heading","content":["Siɛgi zu Izilayɛle nuiti ti ɠulani laEzipete yooi ʋa"]},{"type":"verse","number":1,"content":[{"text":"Siɛgi zu Izilayɛle nuɓusɛiti ti ɠulani la Ezipete yooi ʋa,","poem":1},{"lineBreak":true},{"text":"siɛgi zu Zakɔɓe mavofodaiti ti ɠulani wɛɛn nuɓusɛiti saama,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zuda yooi ɠɛni ga Ɠɔoɠɔ GALAGI zeizu ɲadegai,","poem":1},{"lineBreak":true},{"text":"Izilayɛle ɠɛ ga ná-zooi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kpoloɗɛi naa ɠaani, é ɓizɛ,","poem":1},{"lineBreak":true},{"text":"Zuludɛn ɠaaɠaleni ma ga ʋoluʋelei.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gizeiti ti ɠɛni ʋilisu ga baala sinɛ wolaiti kɛʋele,","poem":1},{"lineBreak":true},{"text":"gize goiti ti ɗa ʋili ga baala ziʋoiti kɛʋele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Toɠa ɠale, kpoloɗɛi, è ʋelani ɠana?","poem":1},{"lineBreak":true},{"text":"Ɗa ma, Zuludɛn, toɠa ɠale è ɠaleni ma ga ʋoluʋelei?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wa ma, gizeiti, toɠa ɠale wo ʋilini eɠɛ baala sinɛ wolaiti?","poem":1},{"lineBreak":true},{"text":"Wa ma, gize goiti, toɠa ɠale wo ʋilini eɠɛ baala ziʋoiti?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee, eteai, ɓali Maliɠii ɠakala,","poem":1},{"lineBreak":true},{"text":"Zakɔɓe ná-GALAGI ɠakala,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nii a ɗa fasai valibo, é kɛ ga kpoigi,","poem":1},{"lineBreak":true},{"text":"é kɔtui ɠɛ ga ziɛungi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}