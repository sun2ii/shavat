{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":120,"content":[{"type":"heading","content":["Nui ti zɛɛi ʋɛɛzu ma, naa ná-GALA falii"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei.","descriptive":true},{"noteId":34},{"lineBreak":true},{"text":"Nà-kidaaʋiligi zu, gè ɓainni Ɠɔoɠɔ GALAGI woizu,","poem":1},{"lineBreak":true},{"text":"é gòoɠaaʋoteni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gè ɠɛni ma: «Ee, Ɠɔoɠɔ GALAGI, ùnmɔɔ,","poem":1},{"lineBreak":true},{"text":"è kùla naati zea, niiti ti zɛɛi ʋɛɛzu mà, ti ɗa màayaava.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Leeni ɠa GALA ge ʋaazu kɛɛzu ga ɗe,","poem":1},{"lineBreak":true},{"text":"ɗɛi è zɛɛi wosu ga è-nɛgi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Toɠa ʋaazu kɔɔɠɔ mɛɛn ɠaazoɓagi ʋilisu è ma,","poem":1},{"lineBreak":true},{"text":"naa ʋɛɛ abulekai ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Toɠa bɛ̀ ga maanɔɠɔ vaa, sèi vai zii ɠiligiti saama,","poem":1},{"lineBreak":true},{"text":"gè ʋa yɛ zeini wɛɛinti ta-zeɠe ɠotaiti saama!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kaite nà zeini naati saama,","poem":1},{"lineBreak":true},{"text":"niiti ziilɛigi wɔin la ti ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ziilɛigi ɠa gè pɔ, kɛlɛ siɛgi zu gè ɓɔɛzu la,","poem":1},{"lineBreak":true},{"text":"tiya mu, kɔɔɠɔ vai ɠa ti pɔ.","poem":1}]}],"footnotes":[{"noteId":34,"caller":"+","text":"Tɛɛ wo guyei: É zo guyei ungila puufelegɔ é li ungila puusaʋagɔ maazu naanigɔi ʋɔ (120-134), naati ti ɠɛni ga guyeiti ti ɠɛni ti loozu, siɛgi zu ta la ɠɛna siɛi woga la, ti ɗa li Zeluzalɛme kona gilagila fɛtiiti su, ta la ɠɛna lɛa taa ɲadegai zu, nii é gizei unmaʋɛ.","reference":{"chapter":120,"verse":1}}]},"thisChapterLink":"/api/tod_pbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}