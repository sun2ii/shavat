{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"heading","content":["À ziilɛigi vali Zeluzalɛme ʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei. Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Kòozunɛɛni gola, siɛgi zu ti ɠɛni mà la:","poem":1},{"lineBreak":true},{"text":"«Ade li Ɠɔoɠɔ GALAGI zei ʋɛlɛi ma ɠoizuʋɛ!»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wɛlɛ, gi-ɠɔɠɔiti ti loga ɗa-ziɠidaʋɛti, ee, Zeluzalɛme!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zeluzalɛme, taa wolai togai ga pagɔ,","poem":1},{"lineBreak":true},{"text":"ná-siɠigiti kakugai ma, é ɠɛ ga ani ɠila kpe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miná ɠa bolodamaiti ta ɗa ʋa ná, Ɠɔoɠɔ GALAGI ná-bolodaiti,","poem":1},{"lineBreak":true},{"text":"ti ʋa, ti Ɠɔoɠɔ GALAGI maamusɛ náʋɛ,","poem":1},{"lineBreak":true},{"text":"naa ɠa ga tɔgi Izilayɛle ʋɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Náʋɛ ɠa masa kpɔkpɔgiti ti ná, Davide mavofodai ʋɛ,","poem":1},{"lineBreak":true},{"text":"ʋɛ é zeizu ná, é ɗa tukpɔi ɠaaleʋe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À GALA fali ga Zeluzalɛme ziilɛigi zɔlɔɔ, wo ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«Zeluzalɛme, niiti ti è nɛai ʋɛ, naati ti eteai ziɛ ziilɛigi zu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ziilɛigi masadai ɠɛ ɗa-ziɠigiti su,","poem":1},{"lineBreak":true},{"text":"ta ɗa-masa pɛlɛiti ziilɛi ɓɔɠɔ ma tɔɔn.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ̀ɛleaiti ta bɔ̀ɔlaiti maaʋele ma,","poem":1},{"lineBreak":true},{"text":"zìimai ɠa ga: «Ziilɛigi ɠɛ è ʋɛ!»","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, ada-ƓALAGI zei ʋɛlɛi ná-fai maaʋele ma,","poem":1},{"lineBreak":true},{"text":"nà undaanɛɛi ɠaiziɛzu è ʋɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}