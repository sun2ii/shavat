ak":true},{"text":"ta waso nuiti ta-wɔinzeɠemai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}