{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":124,"content":[{"type":"heading","content":["Ada-ɓɔbai ɠa zɔlɔɔsu Ɠɔoɠɔ GALAGI ya"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei. Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ni Ɠɔoɠɔ GALAGI la ɠɛni loni ade ʋɛ,","poem":1},{"lineBreak":true},{"text":"Izilayɛle lɛ naa ma ʋolu, é bo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ni Ɠɔoɠɔ GALAGI la ɠɛni loni ade ʋɛ,","poem":1},{"lineBreak":true},{"text":"siɛgi zu nuiti ti ʋaani la, ti laalɛ ade wu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"naazu ta la ade-ma vului ɓɔle,","poem":1},{"lineBreak":true},{"text":"siɛgi zu ti ɠɛni ziiɠaawana wolai zu ade laalɔɠɔma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ziɛ veinfeingi a la li ga adeye,","poem":1},{"lineBreak":true},{"text":"kɔtuɗɛi ɠɛni ade maaɓɔlesu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naazu ziɛ veinfein golaiti","poem":1},{"lineBreak":true},{"text":"ti ɠɛni yeizu ga adeye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mamagi ɠa Ɠɔoɠɔ GALAGI ʋɛ, nii é la vaani bu","poem":1},{"lineBreak":true},{"text":"ga ti-ɲiigaiti ti ʋa ade ʋaliʋali.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ade ɠulani ti ya, eɠɛ wɔnii","poem":1},{"lineBreak":true},{"text":"pelaai é ɠula wɔni ɓɛɛ nui ná-tumɔi zu.","poem":1},{"lineBreak":true},{"text":"Tumɔi ʋalini ga, ade ʋela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ada-ɓɔbai ɠa ɗa zeɠe Ɠɔoɠɔ GALAGI ɓɔɠɔi ʋɔ bɛ,","poem":1},{"lineBreak":true},{"text":"nii é geeɠɔlɔgi ta zooi ɓɛtɛa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}