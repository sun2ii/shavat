{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":126,"content":[{"type":"heading","content":["Gɔlɔiti ti valibogai ga koozunɛɛi"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei.","descriptive":true},{"lineBreak":true},{"text":"Siɛgi zu Ɠɔoɠɔ GALAGI Siyɔn zei ʋele ɓɛtɛni la ʋolu,","poem":1},{"lineBreak":true},{"text":"é ɠɛni gi-ɠi su ga se su vaa nɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naazu, gi la ɠɛni ɓesu ɲɛɛ wo fai ʋa,","poem":1},{"lineBreak":true},{"text":"gi ɗa koozunɛ wuyei loo.","poem":1},{"lineBreak":true},{"text":"Naazu, ti ɠɛni ɠɛɛzu ma zii ɠiligiti saama:","poem":1},{"lineBreak":true},{"text":"«Ungo, Ɠɔoɠɔ GALAGI faa wolaiti kɛa ti ʋɛ!»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI faa wolaiti kɛɛʋɛ gi ʋɛ,","poem":1},{"lineBreak":true},{"text":"gá koozunɛɛi zu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee, Ɠɔoɠɔ GALAGI, ʋa, è gi zei ʋele ɓɛtɛ ʋolu,","poem":1},{"lineBreak":true},{"text":"eɠɛʋelei ɗa ɗa ziɛi laa la, ziɛ yeizuʋɛti teʋebai zu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niiti ti ani zuwui vazasu gaazuɗɛʋui zu,","poem":1},{"lineBreak":true},{"text":"ta ɠɛna teʋea, ta teʋe ga koozunɛ wuyei.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zɔi é liizu ga wɔlɔa ná-molo zuwui unma,","poem":1},{"lineBreak":true},{"text":"naa ɠa ɠale ma ga koozunɛ wuyei, ná-molo ɠiliiti ti zea.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}