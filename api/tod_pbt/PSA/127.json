{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"heading","content":["Fai pɛ ka Maliɠii yeezu"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei. Salomɔn ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ni Ɠɔoɠɔ GALAGI la pɛlɛi loni,","poem":1},{"lineBreak":true},{"text":"to nuiti ta botii ɠɛɛzu nɔ wafuun.","poem":1},{"lineBreak":true},{"text":"Ni Ɠɔoɠɔ GALAGI la taai makɛni,","poem":1},{"lineBreak":true},{"text":"zɔi é makɛsu, naa ɠa ɲiizu ɠaazu ɠa fuun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toɠa ga wafuun faa, wo wuzeɠe fala, wo ɗa ɠaazuɓa, wo la laa fala,","poem":1},{"lineBreak":true},{"text":"wo ɗa ziizoolɛ vaiti kɛ, wo-laamianigi ɠaiziɛ vai zu.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa ɗa nɛɛbɛ nuiti kpɛdɛma anii ve ti ya, anɛɛ siɛgi zu ti ɲiizu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wɛlɛ, dointi ta ga tuyai, nii Ɠɔoɠɔ GALAGI feezu,","poem":1},{"lineBreak":true},{"text":"dointi ti zɔlɔɔsu, ta ga kulanumai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eɠɛʋelei mɛɛinti ti la, ti kɔɔɠuluɓai yeezu,","poem":1},{"lineBreak":true},{"text":"zekana doun zunuiti ti la, zunui ti zɔlɔɔsu ná-zunu loungoyai zu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Undaanɛ nu ɠa ga naama zunui, nii ná-ɓɔlɔi laavegai ga tiye!","poem":1},{"lineBreak":true},{"text":"É la unfega, siɛgi zu é ɓɔɛzu la sili nuiti daalɔɠɔma taai ma ziɠidaʋɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}