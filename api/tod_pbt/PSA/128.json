{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"heading","content":["Undaanɛɛi wooɠɛɠila nui sɔlɔɔsu"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei.","descriptive":true},{"lineBreak":true},{"text":"Undaanɛ nu ɠa ga naa, nu-o-nu nii é luazu Ɠɔoɠɔ GALAGI ʋa,","poem":1},{"lineBreak":true},{"text":"é ɗa ziɛ ga naa yiima ʋeleiti!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Botii è kɛɛzu ga è-yeei, ɗa naama lɔnɔgi zɔlɔɔ,","poem":1},{"lineBreak":true},{"text":"è undaa ɠa nɛ, è kulanuma zɔlɔɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È-anzai ɠa ɠɛ ɗa-ʋɛlɛi wu, eɠɛ leezɛn ɓelei gaawaai mɔinɗai,","poem":1},{"lineBreak":true},{"text":"è-loun zunuiti ta ɠooli ɗa-laɓalii ma, eɠɛ wolive wului ma ʋɔnɔgiti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ʋele ɠana nui a tuyai zɔlɔɔ da,","poem":1},{"lineBreak":true},{"text":"nii é luazu Ɠɔoɠɔ GALAGI ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠa yɛ Siyɔn, é tuya loo è ʋɛ,","poem":1},{"lineBreak":true},{"text":"ɗa Zeluzalɛme ná-undaanɛɛi ɠa, è-zii ma voloi pɛ su,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ta ɗa è-lounlointi ka.","poem":1},{"lineBreak":true},{"text":"Ziilɛigi ɠɛ Izilayɛle ʋɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}