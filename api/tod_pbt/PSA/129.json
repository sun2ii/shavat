{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":129,"content":[{"type":"heading","content":["Ti faa ɲɔu mɔinmɔin kɛɛni ga ze"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei.","descriptive":true},{"lineBreak":true},{"text":"Kaite mà loungo ziɛgi zu ti laalɛɛni bù,","poem":1},{"lineBreak":true},{"text":"Izilayɛle lɛ naa ma ʋolu, é bo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kaite mà loungo ziɛgi zu ti laalɛɛni bù,","poem":1},{"lineBreak":true},{"text":"kɛlɛ ti la zobo sɔlɔɔni mà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti kuɠui wolini pòluʋɛ,","poem":1},{"lineBreak":true},{"text":"eɠɛ nu a ɠɛ kpalagi wolizu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI zɔlegɛ,","poem":1},{"lineBreak":true},{"text":"é faa ɲɔu ɠɛ nuiti ta-ɠaluiti suleʋeleʋeni mà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti unfe, ti ɠula ʋolu,","poem":1},{"lineBreak":true},{"text":"niiti kpein ti Siyɔn wɔinzeɠezu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ti ɠɛ eɠɛ pɛlɛ ɠɔma lufai,","poem":1},{"lineBreak":true},{"text":"é vɔɔzu, aisa é ʋa wɔɔlɔ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nii molo leʋe nui la yeelaavega su,","poem":1},{"lineBreak":true},{"text":"ta molo ɠili nui la gilia ba ga ma ɠili.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Teʋe nuiti ti mina ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«Ɠɔoɠɔ GALAGI ná-tuyai mɔɔ wo ma!","poem":1},{"lineBreak":true},{"text":"Gá tuya loozu wo ʋɛ, Ɠɔoɠɔ GALAGI laaseigi zu!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}