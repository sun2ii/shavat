{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"heading","content":["Inɛinɛgi ta ladalai"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee, Ɠɔoɠɔ GALAGI, eyɛsu yeelɛ? È yeemazu mà kenein?","poem":1},{"lineBreak":true},{"text":"Ɗa maaɠoozazu bà, eyɛsu yeelɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ziizoolɛi ɠa yɛsu mà, zìimaʋɛ eyɛsu yeelɛ?","poem":1},{"lineBreak":true},{"text":"Folo-o-folo, ziiɓɔlɔi zìimaʋɛ?","poem":1},{"lineBreak":true},{"text":"Sìli nui ɠa yɛsu wuzeɠezu dàalɔɠɔma, eyɛsu yeelɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wɛlɛ, gòoɠaaʋote, Ɠɔoɠɔ GALAGI, nà-GALAGI!","poem":1},{"lineBreak":true},{"text":"Gàazuʋɛ zeɠe ma, naa ɠa a kɛ, gè mina ɲi saai zu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sìli nui mina ɠɛ ma: «Gè vɔniga ma!»","poem":1},{"lineBreak":true},{"text":"Wɔ̀inzeɠe nuiti ti mina ɠoozunɛ, ni nà ɲiikpina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nɔ̀un nà, dàaʋɛ ɗa-wooɠɛɠiladai la.","poem":1},{"lineBreak":true},{"text":"Koozunɛɛi ɠa zìimaʋɛ laavesu, ɗa-ɠizo faa wolai vaa zu.","poem":1},{"lineBreak":true},{"text":"Nà pɔ gè guyei loo è lɛbi vai ma,","poem":1},{"lineBreak":true},{"text":"ee, Ɠɔoɠɔ GALAGI, è màalatigɛ ga ɗa-vaanɛɛiti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}