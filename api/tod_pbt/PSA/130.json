{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"heading","content":["Kidaaʋiligi zu"]},{"type":"verse","number":1,"content":[{"text":"Tɛɛ wo guyei.","descriptive":true},{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, kidaaʋiligi zu nà wooɠulazu è ma, è ɓɔ bà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Màliɠii, woilo gòo ma!","poem":1},{"lineBreak":true},{"text":"Woilo, nà-maanɛɛnɛ wooiti ma ga pagɔ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, ni ɗa gi zona ga gá-vaaɠaaza golaiti,","poem":1},{"lineBreak":true},{"text":"Màliɠii, ɓɛ ɠa a yɛ vulua?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛlɛ è-ʋo ka ga maavaayɛgi,","poem":1},{"lineBreak":true},{"text":"naa ɠa a kɛ, nu lua è ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nà Ɠɔoɠɔ GALAGI maaɓɔunsu ga zìimaʋɛ pɛ,","poem":1},{"lineBreak":true},{"text":"ta kìtogɛ daawooi ʋa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nà Maliɠii maaɓɔunsu,","poem":1},{"lineBreak":true},{"text":"é leʋe maaɓɔungi ʋa nii salaʋusuiti ta ɗa bo, é lo sobui zeeli vai ʋa,","poem":1},{"lineBreak":true},{"text":"ungo, é leʋe maaɓɔungi ʋa, nii salaʋusuiti ta ɗa bo, é lo sobui zeeli vai ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee, Izilayɛle nuɓusɛiti, à ɠito Ɠɔoɠɔ GALAGI ʋa!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI ɠa ga wooɠɛɠila GALAGI,","poem":1},{"lineBreak":true},{"text":"unmɔɔgi ma zobogi kpein ka tɔun zea.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toɠa a Izilayɛle unmɔɔ,","poem":1},{"lineBreak":true},{"text":"é kula ná-faaɠaaza golaiti kpein su.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}