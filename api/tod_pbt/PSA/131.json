{},"nextChapterApiLink":"/api/tod_pbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}