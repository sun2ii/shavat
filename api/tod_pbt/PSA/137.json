{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"heading","content":["Gi ɠɛni zeini Ɓaɓilɔne ziɛ wolaiti daaʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Gi ɠɛni zeini Ɓaɓilɔne ziɛ wolaiti daaʋɛ,","poem":1},{"lineBreak":true},{"text":"gi ɠɛni wɔlɔzu, gi ɗa ɠigaiziɛ Siyɔn zu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gi gá-ɠɔnigiti sɛlɛni","poem":1},{"lineBreak":true},{"text":"ziɛlaʋɛ wulu wolaiti ba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niiti ti vɔnini gi ma, ti li ga giye,","poem":1},{"lineBreak":true},{"text":"naati ti ɠɛni gi guyeiti toona,","poem":1},{"lineBreak":true},{"text":"gi zili nuiti ti ɠɛ gi ɠoozunɛ,","poem":1},{"lineBreak":true},{"text":"ti ɠɛ ma: «À Siyɔn wuyei tanigaa loo gi ʋɛ!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gá la zoo ɠale gi Ɠɔoɠɔ GALAGI ná-guyei ta loo","poem":1},{"lineBreak":true},{"text":"zooi naa zu, gi ná ga wɛɛin?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni nà yeemana è ma, Zeluzalɛme,","poem":1},{"lineBreak":true},{"text":"zɛbɛi ɠula zèezai ʋa!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛ̀gi ɠata dàa ɠoozuʋɛ ʋa,","poem":1},{"lineBreak":true},{"text":"ni gè la mɔ ɠisiɛzu è zu, Zeluzalɛme,","poem":1},{"lineBreak":true},{"text":"ni gè la è ɠɛɛni ga nà-koozunɛɛi ma un golai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɠɔoɠɔ GALAGI, ɠizɛ naa zu,","poem":1},{"lineBreak":true},{"text":"nii Edɔme nuiti ti kɛɛni Zeluzalɛme zo foloi,","poem":1},{"lineBreak":true},{"text":"ti ɠɛni ɠɛɛzu ma: «À taa wolai zuvoo, à suvoo,","poem":1},{"lineBreak":true},{"text":"eyɛsu é zeeli ma wuulaagiti ma!»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ee, Ɓaɓilɔne, ɗa ʋaazu ɠoloɠolosu!","poem":1},{"lineBreak":true},{"text":"Undaanɛ nu ɠa ga naati, niiti ti naa zalazu è ma,","poem":1},{"lineBreak":true},{"text":"nii è kɛɛni ga giye!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Undaanɛ nu ɠa ga naati, niiti ta è-lointi so,","poem":1},{"lineBreak":true},{"text":"ti ti lɛɛvɛ fasai ma!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}