{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":138,"content":[{"type":"heading","content":["Nà pɔ gè è maamusɛ ga zìimaʋɛ pɛ"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, nà è maamusɛzu ga zìimaʋɛ pɛ.","poem":1},{"lineBreak":true},{"text":"Nà è lɛbizu ga guyeiti zɛɛ ɠalagiti gaazu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nà nɔkɔsu, gè ɠaaʋote è zei ʋɛlɛ ɲadegai ma,","poem":1},{"lineBreak":true},{"text":"gè è-laaseigi maamusɛ, ɗa-nuɓɔɠɔlai maaʋele ma ta ɗa-wooɠɛɠiladai,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ è ɗa-minazeɠegi laazeeliʋɛ,","poem":1},{"lineBreak":true},{"text":"é ɓudɛ naa maazu, nii gi-ɠigi ɠɛni ba, é lo è ʋa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Voloi gè wooɠulani la è ma, è gòoɠaaʋoteni,","poem":1},{"lineBreak":true},{"text":"è ìɲɔdɔɔni ʋolu, è zɛbɛi ve bɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eteai zu masagiti kpein ti è maamusɛ, Ɠɔoɠɔ GALAGI,","poem":1},{"lineBreak":true},{"text":"ta woilona è-laawooiti ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ta ɠɛna guyei loa, ti Ɠɔoɠɔ GALAGI ná-kɛɛwotiiti maamusɛ, ti ɗa ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«Ɠɔoɠɔ GALAGI ná-lɛbiyai wɔɔlɔʋɛ.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI maaɠoozaʋɛ geezuʋɛ,","poem":1},{"lineBreak":true},{"text":"kɛlɛ toɠa ɓɔɠɔmaayei nuiti kaazu.","poem":1},{"lineBreak":true},{"text":"Toɠa yɛsu ɠoozama, é waso nuiti kwɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ni nà ɠɛna ziaa kidaaʋiligi zaama,","poem":1},{"lineBreak":true},{"text":"ɗa zobogi veezu bɛ̀, gè zɛnvui wo.","poem":1},{"lineBreak":true},{"text":"Ɗa pele ɓesasu sìli nuiti ta-yiiɠulagi luɠɔ.","poem":1},{"lineBreak":true},{"text":"Ɗa kìzosu ga è-zɛbɛi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa faiti pɛ unseizu bɛ̀ ga pagɔ.","poem":1},{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, ɗa-wooɠɛɠiladai ɠa yɛsu ná ɠɔ!","poem":1},{"lineBreak":true},{"text":"Mina ɠɛlɛ naati ba, niiti è ti ɓɛtɛai ga è ɓɔɠɔ yeeiti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}