{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":140,"content":[{"type":"heading","content":["Ùnmɔɔ, è kùla nu ɲɔiti zea"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɠɔoɠɔ GALAGI, kùla nu ɲɔiti zea,","poem":1},{"lineBreak":true},{"text":"kìzo toosu nuiti ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta-ɠisiɛi ɠa ga faa ɲɔu ɠɛɛ vai nɔ,","poem":1},{"lineBreak":true},{"text":"folo-o-folo, kpɔɛi nɔ ɠa ti gaiziɛzu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ta ti-nɛgi ɠaalizu eɠɛ kaalii,","poem":1},{"lineBreak":true},{"text":"kaali wanai ɠa é ɠulazu ti-lakɔlɔgiti bu.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɠɔoɠɔ GALAGI, màkɛ, gè mina lɔ nu ɲɔiti zeezu.","poem":1},{"lineBreak":true},{"text":"Makɛ mà, è kìzo toosu nuiti ma,","poem":1},{"lineBreak":true},{"text":"niiti ti ɠisiɛzu ga ti tòo bu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waso nuiti ti baliiti daa kɔ̀ɠɔ wu,","poem":1},{"lineBreak":true},{"text":"nii a kɛ ti sò, ti galui ta tumɔiti daa,","poem":1},{"lineBreak":true},{"text":"ti ti zei tùɠɔ pelei zu.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gè ɠɛ Ɠɔoɠɔ GALAGI ma: «Ɗa ga nà-GALAGI!»","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, woilo nà-maanɛɛnɛ wooiti ma!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, Màliɠii, ɗa ga nà-zobogi, ta nà-kizogi,","poem":1},{"lineBreak":true},{"text":"ɗa nɔ̀ungi makɛ kɔɔɠɔ voloi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, mina va naa wu, faa ɲɔu ɠɛ nuiti bɛ, nii wɔin ti ma!","poem":1},{"lineBreak":true},{"text":"Mina va bu, ta-vaazeikpasui ʋa zoloo,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ta pilɛ sɔlɔɔ naazu.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Niiti ti màaɠooliai,","poem":1},{"lineBreak":true},{"text":"maanɔɠɔi nii ti wɔinɗai ga é zeeli nɔ̀un ma,","poem":1},{"lineBreak":true},{"text":"naama maanɔɠɔi zei tiya ɓɔɠɔi ti ma!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Abuleka ɠɛzɛi ʋu ti ma!","poem":1},{"lineBreak":true},{"text":"Ti voɓe abui zu, zeɠezaɠai zu,","poem":1},{"lineBreak":true},{"text":"ʋɛ ti la mɔ zooga ti ʋa wuzeɠe ná ɠɔ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Faa ɲɔu ɠɛ nɛgiti ti ɠula eteai ʋa!","poem":1},{"lineBreak":true},{"text":"Maanɔɠɔi ʋilɛ toosu nui ʋolu, dooɠo ge mina ɠɛ ba!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gè suɠwɛɛ ga Ɠɔoɠɔ GALAGI ɠa telebodai ɠɛ bala nuiti bɛ,","poem":1},{"lineBreak":true},{"text":"é sɔledai ɠɛ maanɔɠɔ nuiti bɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Naazu, telebo nuiti ta è-laaseigi maamusɛ wuyeiti too.","poem":1},{"lineBreak":true},{"text":"Sɔle nuiti ta zei è ɠoba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}