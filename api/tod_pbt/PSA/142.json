{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"heading","content":["Ɗa ɠa è ga dɔ̀ɔɠuzu ɠila kpegi"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-kidafaawui. GALA falii é boni, siɛgi zu é ɠɛni pugi zu la.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nà wooɠulazu Ɠɔoɠɔ GALAGI ma ga kpee wooi,","poem":1},{"lineBreak":true},{"text":"kpee wooi ɠa gè Ɠɔoɠɔ GALAGI maanɛɛnɛzu la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nà kpàla vai lɛɛzu la,","poem":1},{"lineBreak":true},{"text":"gè nà-kidaaʋili fai lɛɛ la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nà ʋalana zɛbɛi ma, ɗa ɠa è kwɛɛ ʋɛ gè liizu ná.","poem":1},{"lineBreak":true},{"text":"Ti balii laa nà-pelei zu ga kɛɛɠɛɛi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wɛlɛ ga zèezazu ʋelei:","poem":1},{"lineBreak":true},{"text":"Nu nɔpɛ ge la mɔ ná, nii é kwɛ̀ɛ.","poem":1},{"lineBreak":true},{"text":"Gè la kwɛɛ ʋɛ nà lɔɔɠu ná,","poem":1},{"lineBreak":true},{"text":"nu nɔpɛ ge la yiizoolɛzu ga zɛ̀nvui ma vaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɠɔoɠɔ GALAGI, ɗa ɠa gè kpee loozu è woizu,","poem":1},{"lineBreak":true},{"text":"Gè ɠɛ ma: «Ɗa ɠa è ga dɔ̀ɔɠuzuʋɛ,","poem":1},{"lineBreak":true},{"text":"ɗa ga zìima anii, fizɔgai bɛ̀, eteai nii zu ʋɛ gi zɛnvui wosu ná.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Woilo nà-kpee wooi ma,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ fikɛ nɔpɛ ge la mɔ sù.","poem":1},{"lineBreak":true},{"text":"Ùnmɔɔ, è kùla naati zea, niiti ti wɔ̀inzeɠezu.","poem":1},{"lineBreak":true},{"text":"Ti zuɓaaʋɛ, ta-zobogi wɔɔlɔ nɔ̀nɔi ʋa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fìe, è kùla kasoi ɠa,","poem":1},{"lineBreak":true},{"text":"nii a kɛ gè è-laaseigi maamusɛ.","poem":1},{"lineBreak":true},{"text":"Telebo nuiti ta ʋa, ti màaɠooli,","poem":1},{"lineBreak":true},{"text":"siɛgi zu è faanɛɛi naa ɠɛɛzu la bɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}