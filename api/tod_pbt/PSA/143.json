{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":143,"content":[{"type":"heading","content":["Màliɠii, mina tukpɔ ʋɛɛ bà"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, woilo nà-maanɛɛnɛ wooi ma,","poem":1},{"lineBreak":true},{"text":"woilo nà-fali wooiti ma.","poem":1},{"lineBreak":true},{"text":"Gòoɠaaʋote deɠɛmu ɗa-wooɠɛɠiladai zu ta ɗa-lelebodai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nà ga ɗa-wotiɠɛ nui, mina tùkpɔɠaaleʋea,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ fulu nu ɠila kpalaa ge la leleboni è ɠaazu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sìli nui ɠa pòlu, é la ɓɔlɔzu,","poem":1},{"lineBreak":true},{"text":"é dà zooi ma, ga é ɠɔɠɔlo mà,","poem":1},{"lineBreak":true},{"text":"é sèi kpidii zu ga naati kɛʋele niiti ti zaai kaite.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zɛ̀nvui ɲiikpiga kòozu,","poem":1},{"lineBreak":true},{"text":"zìi ɠa loɠazu ga duai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nà ɠisiɛzu siɛgiti su ti leʋegai,","poem":1},{"lineBreak":true},{"text":"gè ɠisiɛ naati kpein su, niiti è ti ɠɛɛni,","poem":1},{"lineBreak":true},{"text":"gè ɠida è-yeei ná-botii ɠɛ ʋeleiti bu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gè zèeiti maalega è ma,","poem":1},{"lineBreak":true},{"text":"nà ɓɔɠɔ ɠaazu è ɠakala, eɠɛ zooi fɔai.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee, Ɠɔoɠɔ GALAGI, ʋa fala, è gòoɠaaʋote!","poem":1},{"lineBreak":true},{"text":"Zɛ̀nvui zeelia ɠwɛgi ma.","poem":1},{"lineBreak":true},{"text":"Mina ʋoluave bà,","poem":1},{"lineBreak":true},{"text":"gè ʋa ɠɛ ga naati kɛʋele, niiti ti ti-zaa ɠizei lɛɛzu niina.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Geelaa ɠa laona nɔ feya, ɗa-wooɠɛɠiladai lɛ ga ze,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ɗa ɠa dàai è la.","poem":1},{"lineBreak":true},{"text":"Pelei lɛ ga ze, nii maanɛai gè ziɛ la,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ gè ɠaaʋotega è ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, ùnmɔɔ, è kùla sìli nuiti zea,","poem":1},{"lineBreak":true},{"text":"nà lɔɔɠuzu è ɠobaʋɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kàla ga è-yiimai ɠɛɛ vai,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ɗa ɠa è ga nà-GALAGI.","poem":1},{"lineBreak":true},{"text":"Ɗa-Yɛnvu ʋagɔi lo tùɠɔ zooi zu, ʋɛ faaɓa la ná.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, zɛ̀nvui makɛ, è-laaseigi wɔɔlɔ vai zu,","poem":1},{"lineBreak":true},{"text":"Ɗa-lelebodai maaʋele ma, ùnmɔɔ, è kùla kidaaʋiligi zu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɗa-wooɠɛɠiladai ʋɔ, sìli nuiti daaɠulu.","poem":1},{"lineBreak":true},{"text":"È naati undaaʋili, niiti ti wɔ̀inzeɠezu,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ nà ga ɗa-wotiɠɛ nui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}