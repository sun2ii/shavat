{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":148,"content":[{"type":"heading","content":["GALA maamusɛ vai geeɠɔlɔgi zu ta eteai zu"]},{"type":"verse","number":1,"content":[{"text":"À Ɠɔoɠɔ GALAGI maamusɛ!","poem":1},{"lineBreak":true},{"text":"À Ɠɔoɠɔ GALAGI maamusɛ geeɠɔlɔgi ungaʋɛ!","poem":1},{"lineBreak":true},{"text":"À maamusɛ, wɔiti wo geezuʋɛ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À maamusɛ, wo pɛ ná-geezuɠeelaiti!","poem":1},{"lineBreak":true},{"text":"À maamusɛ, wo pɛ geezu ɠɔɔɓɔgiti!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À maamusɛ, foloi ta alugi!","poem":1},{"lineBreak":true},{"text":"À maamusɛ, wo pɛ somideɠaiti, wɔiti wo volozu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À maamusɛ, ee, geeɠɔlɔgiti ti maaɠoozaai!","poem":1},{"lineBreak":true},{"text":"Wa ɓalaagi, ziɛiti wo maazuʋɛ geezuʋɛ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naama aniiti kpein ti Ɠɔoɠɔ GALAGI laaseigi maamusɛ!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ é devei veeni, ti pɛ ti ɓɛtɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"É ti zeini ga ti yɛ ɠɛʋele ma eyɛsu ɠɔ,","poem":1},{"lineBreak":true},{"text":"é ɠɛ ga tɔgi é la valiboga eyɛsu pɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À Ɠɔoɠɔ GALAGI maamusɛ, wɔi pɛ wo eteai zu,","poem":1},{"lineBreak":true},{"text":"wɔi wo ga kpoloɗɛ wu zua wolaiti, kpoloɗɛ wu yeɠezaɠaiti wo pɛ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mainmain, sakɔtui, kɔɔlɛ vukɔi, ɓumugi,","poem":1},{"lineBreak":true},{"text":"fiilɛ wolai nii é ɠolozu daawooi ʋɛ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"gizeiti ta gize goiti,","poem":1},{"lineBreak":true},{"text":"gwaa wuluiti ta sɛdele guluiti kpein,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"dɔɓɔ zuaiti ta toganiiti kpein,","poem":1},{"lineBreak":true},{"text":"niiti kpein ti ɓokposu ɓaa ti ɠoʋesu,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"eteai zu masagiti ta nuɓusɛiti kpein,","poem":1},{"lineBreak":true},{"text":"kundiɠiiti ta eteai leve nuiti,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"zunu loungoiti ta anzanu loungoiti,","poem":1},{"lineBreak":true},{"text":"kɛwola wɔlɔiti ta doungoiti!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ti Ɠɔoɠɔ GALAGI laaseigi maamusɛ!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ daaseigi ɠa bɔɔlɔai ti pɛ unda,","poem":1},{"lineBreak":true},{"text":"ná-maayikii zooi ta geeɠɔlɔgi laaɠulaʋɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"É zobogi ɠɛʋele ɓɛtɛʋɛ ná-nuɓusɛiti bɛ.","poem":1},{"lineBreak":true},{"text":"Naa ɠa ga ɓɔɠɔ maamusɛ vaa ná-wooɠɛɠila nuiti bɛ,","poem":1},{"lineBreak":true},{"text":"Izilayɛle nuiti, nuɓusɛiti ti maaɓuɠaai tɔun ba.","poem":1},{"lineBreak":true},{"text":"À Ɠɔoɠɔ GALAGI maamusɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}