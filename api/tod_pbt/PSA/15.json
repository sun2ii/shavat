{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":15,"content":[{"type":"heading","content":["Ɓɛ ɠa a zoo é zɛnvui wo GALA ba?"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, ɓɛ ɠa a lɛ è zei ʋɛlɛ ɲadegai wu?","poem":1},{"lineBreak":true},{"text":"Ɓɛ ɠa deɠɛmu a yɛ ɗa-ɠize ɲadegai ma?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Zɔi é ziɛzu sɔledai zu, é ɗa telebodai ɠɛ,","poem":1},{"lineBreak":true},{"text":"é ɗa gaamai wo ga yiimaʋɛ pɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"É la maaɓoo vaa woga ga nɛgi,","poem":1},{"lineBreak":true},{"text":"é la faa ɲɔu ɠɛa ga seiɲɔɠɔi,","poem":1},{"lineBreak":true},{"text":"é la unfetala vaa ɠɛa ga koba nuiti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Toɠa naama nui laaʋili, nii é la ʋani GALA gaazu,","poem":1},{"lineBreak":true},{"text":"kɛlɛ toɠa unfe naati ma, niiti ti luazu Ɠɔoɠɔ GALAGI ʋa.","poem":1},{"lineBreak":true},{"text":"Toɠa yɛ ná-minazeɠe gooi ʋolu, é so kpaan,","poem":1},{"lineBreak":true},{"text":"anɛɛ ni naa ɠa ɠɛ ga tɔun kpɔlɔ vaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"É la ná-walii vea nu ya ga talama vaa.","poem":1},{"lineBreak":true},{"text":"É la lobɛani zoga sɔbalala nu laalɔɠɔma.","poem":1},{"lineBreak":true},{"text":"Zɔi é ziɛzu ɠana, naa la ɲiikpiga eyɛsu pɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}