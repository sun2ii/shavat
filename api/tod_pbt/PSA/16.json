{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":16,"content":[{"type":"heading","content":["Zɛnvu ʋelei"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ee, GALA, màkɛ! Mazɔlɔɔ nà lɔɔɠuzu è ʋɔ bɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nà ɗa ɠɛ Ɠɔoɠɔ GALAGI ma: «Ɗa ga Màliɠii,","poem":1},{"lineBreak":true},{"text":"ɗa ga nà-undaanɛɛi, taɠili nɔpɛ ge la ná, a ùndaanɛ!»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nu ɲadegaiti ti zooi zu,","poem":1},{"lineBreak":true},{"text":"tiya ɓɔɠɔi, ti ga nu wolaiti, naati ka nà ɗa unfe ti ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Taɠiligaa ta undaanɛɛi ɠaiziɛzu gala kiligiti zea,","poem":1},{"lineBreak":true},{"text":"ta ta-ɓɔlɔi mɔinzu ɓɔɠɔ ma.","poem":1},{"lineBreak":true},{"text":"Gè la ta-ʋuya zalaɠa ɠula, nii é ga ɲamai,","poem":1},{"lineBreak":true},{"text":"gè la ti-laasei boga ga dàkɔlɔgiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠa é ga nà-kulanumai, ta nà-undaanɛɛi,","poem":1},{"lineBreak":true},{"text":"poganii nii gè sɔlɔɔgai, ɗa ɠa è ɓaazu maazu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gè nɔ̀nɔ ma ʋoganii zɔlɔɔga, nii fizɔgai,","poem":1},{"lineBreak":true},{"text":"toɠa bɛ̀ ga poganii, é kòozunɛɛzu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nà Ɠɔoɠɔ GALAGI mamasu, nii é tɛ̀nɛsu.","poem":1},{"lineBreak":true},{"text":"Zìi ɓɔɠɔi ɠa ɗa gàanɛɛnɛ kpidii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gàazu logɛ Ɠɔoɠɔ GALAGI ʋa yeenɔpɛ, mazɔlɔɔ toɠa kòbaʋɛ,","poem":1},{"lineBreak":true},{"text":"nii a kɛ gè mina ɲiikpi eyɛsu pɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naa ɠa é ba, zìi ɠaanɛa, zɛ̀nvui ɗa ɠoozunɛ,","poem":1},{"lineBreak":true},{"text":"kpùsɛi ɓɔɠɔi ɠa looɠosu, makɛgai kitogi zu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ è la ɠɛlɛa bà, gè ʋa yɛ gɔvɛalaazu,","poem":1},{"lineBreak":true},{"text":"è la vaa bu ɗa-wotiɠɛ nui, é ga wooɠɛɠila nui, é ʋa yei zeɠei zu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɗa zɛnvu ʋelei lɛ ga ze,","poem":1},{"lineBreak":true},{"text":"koozunɛ wolai ɠa è ɠakalaʋɛ,","poem":1},{"lineBreak":true},{"text":"ta ɠɔoɠɔ undaanɛɛi è yeezazuʋɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}