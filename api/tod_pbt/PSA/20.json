{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":20,"content":[{"type":"heading","content":["Gá-Masagi zobo sɔlɔɔ!"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɠɔoɠɔ GALAGI è wooɠaaʋote è ɠidaaʋili foloi!","poem":1},{"lineBreak":true},{"text":"Zakɔɓe ná-GALAGI laaseigi è makɛ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"É ɗa-ɓɔbai leʋe è ma, é zeɠe seizu ɲadegai,","poem":1},{"lineBreak":true},{"text":"é yɛ Siyɔn é yeezei è wu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"É ɠizɛ ɗa-vebɛaniiti kpein su.","poem":1},{"lineBreak":true},{"text":"É yeezei ɗa-zalaɠaiti bu ti ɠalazu.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"É è yiima vai ɠɛ è ʋɛ,","poem":1},{"lineBreak":true},{"text":"é naati daazeeli, niiti è pɔ è ti ɠɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gá wooɠula ga koozunɛɛi ɗa-zobo sɔlɔɔ fai zu,","poem":1},{"lineBreak":true},{"text":"gá gá-ƓALAGI ná-ɗalapoi lɛ geezu,","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa naa kpein kɛ, nii è falizu ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gè kwɛɛ niina, ga Ɠɔoɠɔ GALAGI zee ɠa ná-masagi ʋa, nii é gulɔ ɲadegai ziɛni ma,","poem":1},{"lineBreak":true},{"text":"toɠa yɛ ná-ada ɲadegai geezuʋɛ, é gooɠaaʋote,","poem":1},{"lineBreak":true},{"text":"é unmɔɔ, zeezazu ɓɔba wolai ʋɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tanigaani zee ɠa ta-ɠɔɔɠɔ wotoloiti ma,","poem":1},{"lineBreak":true},{"text":"tanigaani zee ɠa ta-zooiti ma,","poem":1},{"lineBreak":true},{"text":"gɔun gá, gá-ɠitogi ɠa ga ɗe, Ɠɔoɠɔ GALAGI, gá-ƓALAGI.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tiya mu ta ɓilisu ti loo,","poem":1},{"lineBreak":true},{"text":"gɔun, gá yɛsu loni, gi lo kpaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɠɔoɠɔ GALAGI, zobogi ve gá-masagi ʋɛ!","poem":1},{"lineBreak":true},{"text":"É zoo é gi wooɠaaʋote, siɛgi zu gi wooɠulazu ma la, ga é ɓɔ gi ʋa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}