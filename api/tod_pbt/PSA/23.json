{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"heading","content":["Nà ga baalagi,Ɠɔoɠɔ GALAGI ɠa é ga màkɛ nui"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Nà ga baalagi, Ɠɔoɠɔ GALAGI ɠa é ga màkɛ nui,","poem":1},{"lineBreak":true},{"text":"gè la ʋalaga ani nɔpɛ ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toɠa nà-dooɠo bosuʋɛ ɠɛɛzu ga tufa lɛnugi zu,","poem":1},{"lineBreak":true},{"text":"toɠa losu tùɠɔ, é li ga ze ziɛ lɛilɛigiti pɔ bɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toɠa nìinɛzu,","poem":1},{"lineBreak":true},{"text":"é lo tùɠɔ, é li ga ze telebo peleiti su,","poem":1},{"lineBreak":true},{"text":"daaseigi wɔɔlɔ vai zu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siɛgi zu gè ziɛzu la faaɓaagi ma ʋɛtugi zu,","poem":1},{"lineBreak":true},{"text":"gè la lua faa ɲɔu nɔpɛ ba, mazɔlɔɔ ɗa bà,","poem":1},{"lineBreak":true},{"text":"ɗa-lukpɔi, ta ɗa-ɓakɔi, naati ka ti zìilɛizu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɗa fɛti laamii ɠɛʋele ɓɛtɛzu bɛ̀ sìli nuiti gaazu,","poem":1},{"lineBreak":true},{"text":"è gulɔi ziɛ nɔ̀ungi ma","poem":1},{"noteId":7},{"text":",","poem":1},{"lineBreak":true},{"text":"nà-ziawɔi laavegɛ, é ɗa ʋu ya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ungo, undaanɛɛi ta nɛɛbɛi ta yɛ bà, nà-eteai pɛ su,","poem":1},{"lineBreak":true},{"text":"nà ɠale ma, gè yɛ Ɠɔoɠɔ GALAGI ná-pɛlɛi wu, eyɛsu sìi ma voloi pɛ.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"è gulɔi ziɛ nɔ̀ungi ma: Ti-ɠɛɛ vaa wɔlɔi ta ɠɛni ga naa, nii a kɛ ti unfemai ve nui ʋɛ, niiti toligai fɛti ɠula vai ma. Wɛlɛ ʋɛ: Luk 7:46.","reference":{"chapter":23,"verse":5}}]},"thisChapterLink":"/api/tod_pbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}