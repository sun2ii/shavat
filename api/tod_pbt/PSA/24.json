{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":24,"content":[{"type":"heading","content":["Ɠɔoɠɔ GALAGI ɠa lɛɛzu ná-ada ɲadegai"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Zooi ta gaa ɠaniiti ta ga Ɠɔoɠɔ GALAGI nɔnɔ,","poem":1},{"lineBreak":true},{"text":"eteai ta nii kpein é zeini su!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ tɔ ɠa é zooi zeiɗa kpoloɗɛiti gaaʋɛ,","poem":1},{"lineBreak":true},{"text":"é suvie ziɛ wolaiti maazu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɓɛ ɠa a zoo é lɛ Ɠɔoɠɔ GALAGI ná-gizei ma?","poem":1},{"lineBreak":true},{"text":"Ɓɛ ɠa a zoo é wuzeɠe, eyɛsu é lo ná-ada ɲadegai?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nii zeeiti ti la ɠɔzɔni, ziimaʋɛ ɠoleai,","poem":1},{"lineBreak":true},{"text":"nii é la ɓɔɠɔ lɔɔzu faa ɲakaiti su,","poem":1},{"noteId":8},{"lineBreak":true},{"text":"é la ɠonazu ga é ʋa nu yaava.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toɠa Ɠɔoɠɔ GALAGI ná-tuyai zɔlɔɔ,","poem":1},{"lineBreak":true},{"text":"ná-kizo GALAGI ɠa deve ga telebo nu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pele ɠana niiti ti gaiziɛzu, naati ta-nuɓusɛiti ti la,","poem":1},{"lineBreak":true},{"text":"ti ɠilizu Zakɔɓe ná-GALAGI ʋa.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kpogiti, à wa-ɓofalagiti buzeɠe,","poem":1},{"lineBreak":true},{"text":"à ti wuzeɠe, ɠɔoɠɔ siɠidaʋɛti,","poem":1},{"lineBreak":true},{"text":"naa ɠa a kɛ, lɛbiya Masagi lɛ ná!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɓɛ ɠa é ga lɛbiya Masagi?","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ʋe, sulogai, kɔɔɠuluɓai,","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, kɔɔɠuluɓai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kpogiti, à wa-ɓofalagiti buzeɠe,","poem":1},{"lineBreak":true},{"text":"à ti wuzeɠe, ɠɔoɠɔ siɠidaʋɛti,","poem":1},{"lineBreak":true},{"text":"naa ɠa a kɛ, lɛbiya Masagi lɛ ná!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɓɛ ɠa é ga lɛbiya Masagi?","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ʋe, Fai-Pɛ-Maliɠii,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa é ga lɛbiya Masagi!","poem":1},"Lo!"]}],"footnotes":[{"noteId":8,"caller":"+","text":"nii é la ɓɔɠɔ lɔɔzu faa ɲakaiti su: Tati pelei taɠili ɓalaa ka ga nii: nii é la ɠaaʋotesu zɛɛ ɠalagiti ma","reference":{"chapter":24,"verse":4}}]},"thisChapterLink":"/api/tod_pbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}