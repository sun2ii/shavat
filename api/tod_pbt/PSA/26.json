{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":26,"content":[{"type":"heading","content":["Tukpɔi lo bɛ̀"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, tukpɔi lo bɛ̀!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ nà nà-eteai ziɛzu peelalazu nɔpɛ ge la bà.","poem":1},{"lineBreak":true},{"text":"Nà ɠalivaazu Ɠɔoɠɔ GALAGI ma, gè la ɲiikpiga eyɛsu pɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fɛ̀ɠɛlɛfɛɠɛlɛ, Ɠɔoɠɔ GALAGI, pòluɠula,","poem":1},{"lineBreak":true},{"text":"è zìi ʋɛtɛ, ta nà-kisiɛiti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ gàazu ɠa ɗa-nuɓɔɠɔlai ʋa,","poem":1},{"lineBreak":true},{"text":"nà nà-eteai ziɛzu, eɠɛʋelei ɗa-wooɠɛɠiladai la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gè la liizu gè ʋa zei yaava nuiti koba,","poem":1},{"lineBreak":true},{"text":"gè la woovele nuiti seizeisu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niiti ti faa ɲɔi ɠɛɛzu, naati ta-maaɓɔgi wɔinzeɠeʋɛ mà.","poem":1},{"lineBreak":true},{"text":"Gè la zeizu suɲɔu nuiti koba.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nà zèeiti gaagbazu sɔbalalai zu,","poem":1},{"lineBreak":true},{"text":"ee, Ɠɔoɠɔ GALAGI, nà latisu ɗa-zalaɠa ɠulazuʋɛ ma,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"gè mama gooiti bo,","poem":1},{"lineBreak":true},{"text":"gè ɗa-vaanɛɛiti kpein bo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, è-zeizuʋɛ nɛɛʋɛ bɛ̀,","poem":1},{"lineBreak":true},{"text":"ʋɛ ɗa-lɛbiyai zeini ná!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mina sò ga nu ɲɔiti kɛʋele,","poem":1},{"lineBreak":true},{"text":"mina zɛ̀nvui zeɠe ga nu ʋaa nuiti kɛʋele!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ti-yeeiti dɔɔʋɛ faa ɲɔi zu.","poem":1},{"lineBreak":true},{"text":"Ti ɓɔɠɔ yɛgɛna ti ti ɠeya ga lobɛanii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɔ̀un, nà ziɛzu nà-telebodai zu,","poem":1},{"lineBreak":true},{"text":"ùnmɔɔ, è zaalai la mà!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɔ̀ɠɔi ɠa loni sɔledai zu,","poem":1},{"lineBreak":true},{"text":"nà Ɠɔoɠɔ GALAGI mamasu maaɓɔgi zu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}