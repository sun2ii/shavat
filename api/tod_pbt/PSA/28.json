{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":28,"content":[{"type":"heading","content":["Ɠɔoɠɔ GALAGI ná-gooɠaaʋotegi"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, ɗa ɠa gè wooɠulazu è ma.","poem":1},{"lineBreak":true},{"text":"Nà-fasai, mina woizuɓɔlɔ tùɠɔ.","poem":1},{"lineBreak":true},{"text":"Ni ɗa laaɠuluna, nà ɠɛ ga naati kɛʋele,","poem":1},{"lineBreak":true},{"text":"niiti ti yeizu kabai zu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Woilo nà-maanɛɛnɛ wooiti ma,","poem":1},{"lineBreak":true},{"text":"siɛgi zu gè wooɠulazu la è ma,","poem":1},{"lineBreak":true},{"text":"siɛgi zu gè zèeiti tɛɛzu la","poem":1},{"lineBreak":true},{"text":"è-zeizu ɲadegai ʋɔ pelei, è zeini ná!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mina faa ɲɔu ɠɛ nuiti ta-vaa ɲɔu ɠasɔi ta la ùnma,","poem":1},{"lineBreak":true},{"text":"faa ɲɔu ɠɛ nui naati, ti ziilɛi kpɔɛi wosu ti-zeiɲɔɠɔi ma,","poem":1},{"lineBreak":true},{"text":"kɛlɛ faa ɲɔi ti-yiimaʋɛ, ga yaavai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti zala, eɠɛʋelei ta-ɠɛɛwotiiti ti la,","poem":1},{"lineBreak":true},{"text":"eɠɛʋelei ta-yaava ɠɛɛwotiiti ti la.","poem":1},{"lineBreak":true},{"text":"Ti zala é zoloo ti-yeei ná-kɛɛwotii ma.","poem":1},{"lineBreak":true},{"text":"Nii soloogai ti ma, naa la ti unma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ ti la Ɠɔoɠɔ GALAGI ná-kɛɛwotiiti deveni,","poem":1},{"lineBreak":true},{"text":"anɛɛ zeei ná-kɛɛwotiiti.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ti ɠoloɠolo!","poem":1},{"lineBreak":true},{"text":"Ti mina mɔ wuzeɠe eyɛsu pɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mamagi ɠa Ɠɔoɠɔ GALAGI ʋɛ!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ toɠa woilosu nà-maanɛɛnɛ wooiti ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa é ga sùvikɛi ta nà-kɔɔɠɔ zɛpɛgi.","poem":1},{"lineBreak":true},{"text":"Gè ɠalivaaʋɛ ma, toɠa ɓɔsu bà.","poem":1},{"lineBreak":true},{"text":"Zìimaʋɛ laavegɛ ga koozunɛɛi.","poem":1},{"lineBreak":true},{"text":"Nà maamusɛzu ga nà-guye wooiti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa é ga ná-nuiti kpein suvikɛi,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa é ga siɠigi, ʋɛ masagi nii é gulɔ ɲadegai ziaai ma, naa a ɗa unmɔɔgi zɔlɔɔ ná.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, ɗa-nuɓusɛiti kizo, è tuya loo ti ʋɛ, ta ga ɗɔnɔiti!","poem":1},{"lineBreak":true},{"text":"Ɠɛ ga ti makɛ nui, è yeezei ti wu, eyɛsu ɠɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}