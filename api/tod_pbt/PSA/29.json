{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":29,"content":[{"type":"heading","content":["Ɠɔoɠɔ GALAGI laawooi"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"GALA ná-geezuɠeelaiti, à Ɠɔoɠɔ GALAGI maamusɛ,","poem":1},{"lineBreak":true},{"text":"wo ná-zɛbɛi ta ná-lɛbiyai ɠula kɛlɛma!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ungo, à Ɠɔoɠɔ GALAGI laaseigi ma lɛbiyai maamusɛ,","poem":1},{"lineBreak":true},{"text":"wo nɔkɔ tɔun bu, maaɠiliai ga seɠe ɲadegai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɠɔoɠɔ GALAGI wooi ɠa ɠulazu ziɛiti maazu,","poem":1},{"lineBreak":true},{"text":"lɛbiya ƓALAGI ɠa tona ɓunɛ tugi ɠulazu.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa ɓudɛzu ziɛ wolaiti gooi maazu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa ɠulazu ga keɠaaɓa!","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa ɠulazu ga masa gooi!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa sɛdele guluiti galeɠalezu,","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa Liɓan sɛdele guluiti koloɠolosu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"toɠa Liɓan ɠizeiti kpizɛzu eɠɛ nikɛ ɓokpagiti,","poem":1},{"lineBreak":true},{"text":"ta Siliyɔn ɠizei eɠɛ teɠu ɓokpagi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa mainmain ɠulazu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa ɗa teʋebai zuɲiikpi.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa ɗa Kadɛse teʋebai zuɲiikpi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wooi ɠa ɗa ɠɛ ga zaɓui dopaiti ti yiʋoi ʋu.","poem":1},{"lineBreak":true},{"text":"Toɠa ɗa dɔɓɔi zuwolo.","poem":1},{"lineBreak":true},{"text":"Ná-masa pɛlɛi wu ti pɛ ta ɗa wooɠula, ti ɠɛ ma: «Lɛbiyai ɠa bɛ!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠɛni masadai ɠɛɛzu, ziɛve golai ʋaa ziɛgi zu.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa masadai ɠɛɛzu eyɛsu ɠɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa zobogi ve ná-nuɓusɛiti bɛ.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa tuya loo ná-nuɓusɛiti bɛ, é ziilɛigi ve ti ʋɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}