{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"heading","content":["Kizogi zeɠeʋɛ Ɠɔoɠɔ GALAGI ʋɔ"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei, siɛgi zu é ɠɛni ʋelazu la ná-doun zunui Aɓasalɔme ʋa.","descriptive":true},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee, Ɠɔoɠɔ GALAGI, sìli nuiti mɔinʋɛ gola!","poem":1},{"lineBreak":true},{"text":"Ungo, sìli nuiti mɔinʋɛ gola, ti wuzeɠeai dàalɔɠɔma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuiti mɔinʋɛ ti ɠɛɛzu ma nà-faa zu:","poem":1},{"lineBreak":true},{"text":"«Ná-kpɔba nɔpɛ ge la mɔ zɔlɔɔga GALA zea!»","poem":1},"Lo!",{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kɛlɛ ɗɔun ɗa, Ɠɔoɠɔ GALAGI, ɗa ɠa è bɛ̀ ga kɔɔɠɔ zɛpɛgi,","poem":1},{"lineBreak":true},{"text":"ɗa ga mà zaalai, ɗa nɔ̀ungi wuzeɠezu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nà wooɠulazu Ɠɔoɠɔ GALAGI ma ga kpeei,","poem":1},{"lineBreak":true},{"text":"toɠa yɛsu ná-gize ɲadegai ma, é gòoɠaaʋote.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gè la, gè ɲi,","poem":1},{"lineBreak":true},{"text":"gè wuzeɠe, mazɔlɔɔ Ɠɔoɠɔ GALAGI ɠa màkɛsu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gè la lua nu waa mɔinmɔingiti ba,","poem":1},{"lineBreak":true},{"text":"niiti ti dàalɔɠɔma mini-o-mini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wuzeɠe, Ɠɔoɠɔ GALAGI!","poem":1},{"lineBreak":true},{"text":"Kìzo, nà-GALAGI!","poem":1},{"lineBreak":true},{"text":"Tɔɔzei ɗa sìli nuiti kpein doɠazu ti-woizuʋɛ,","poem":1},{"lineBreak":true},{"text":"ɗa faa ɲɔu ɠɛ nuiti ɲiigaiti galeɠalezu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, ɗa ɠa ɗa nu ɠizo.","poem":1},{"lineBreak":true},{"text":"Ɗa-luyai ɠɛ ɗa-nuɓusɛiti ba.","poem":1},"Lo!"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Wɛlɛ ʋɛ: 2Sa 15:13—18:18.","reference":{"chapter":3,"verse":1}},{"noteId":1,"caller":"+","text":"Lo!: Niima wooi wo daa ɠɛɛʋɛ ga puulɔfela maazu ɠila (71) guye zɛʋɛi zu. Eɓulu wooi nii é ga «sela», naa ɠa tatigai ɠana. Poluʋɛ ɓɔɔɓɔgi la ɠwɛɛni. Poluʋɛ tanigaa ta ga niiti: tago looɠogi guyei zu, ɓaa ta siɛposui, ɓaa maamusɛi ma ʋoogi.","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/tod_pbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}