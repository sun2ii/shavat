{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":4,"content":[{"type":"heading","content":["Ɠɔoɠɔ GALAGI ɠa ziilɛigi veezu"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. É loozu ga kɔnigiti. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Siɛgi zu gè wooɠulazu la è ma, gòoɠaaʋote,","poem":1},{"lineBreak":true},{"text":"GALAGI nii é ga nà-telebodai.","poem":1},{"lineBreak":true},{"text":"Kidaaʋiligi zu, ɗa ìɲɔdɔɔzu.","poem":1},{"lineBreak":true},{"text":"Zaalai la mà, è woilo nà-fali wooiti ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wɔi wo ga nuiti,","poem":1},{"lineBreak":true},{"text":"wa yɛsu nà-lɛbiyai maaɓoozu, eyɛsu yeelɛ?","poem":1},{"lineBreak":true},{"text":"Wa yɛsu faa ɲakai nɛɛzu ʋɛ,","poem":1},{"lineBreak":true},{"text":"wo ɗa zɛɛi ɠaiziɛ, eyɛsu yeelɛ?","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"À suɠwɛɛ ga Ɠɔoɠɔ GALAGI yiimazeɠeʋɛ ga zunu ɠila, nii é ga wooɠɛɠila nu tɔun bɛ,","poem":1},{"lineBreak":true},{"text":"toɠa ɗa gòomɛni, siɛgi zu gè tolisu da.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wa yiiɠaawanana, à mina koto ɠɛ.","poem":1},{"lineBreak":true},{"text":"À kisiɛi wo wa-ʋetei zu, wo maaɠɛ kpɔ.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À zalaɠaiti kula, niiti ti zoloogai tɔgi ma,","poem":1},{"lineBreak":true},{"text":"à ɓɔɠɔ ɠaliva Ɠɔoɠɔ GALAGI ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naati mɔinʋɛ, niiti ti gaazaɠagi wosu ga: «Mini ɠa gá-undaanɛɛi ʋaazu, é zeɠe ná?»","poem":1},{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, è-ɠaazuʋɛ ma wozakalagi lo gi ʋa!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɗa koozunɛɛi ʋuuzu zìimaʋɛ,","poem":1},{"lineBreak":true},{"text":"é leʋe ta-molo leʋe ziɛgi zu ʋa, ta ta-lɔɔ niinɛi ʋu ziɛgi zu ʋa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nà laana nɔ feya, nà ɲi ziilɛigi zu.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ ɗa ɠila kpe, Ɠɔoɠɔ GALAGI,","poem":1},{"lineBreak":true},{"text":"ɗa sèizu ziilɛigi zu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}