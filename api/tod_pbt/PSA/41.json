{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":41,"content":[{"type":"heading","content":["Seeɓɛ nui, ti wɔinzeɠezu"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Undaanɛ nu ɠa ga naama nui, nii é daazu ma ga bala nui ná-fai!","poem":1},{"lineBreak":true},{"text":"Maanɔɠɔ voloi, Ɠɔoɠɔ GALAGI unmɔɔ tɔ ɓalaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa makɛ, é zɛnvui wo,","poem":1},{"lineBreak":true},{"text":"undaa ɠa nɛ ná-zooi zu,","poem":1},{"lineBreak":true},{"text":"é la dɔa sili nuiti ziimai zu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa yeeyɛ ba, a ɠɛna laani betei zu taɓai ba.","poem":1},{"lineBreak":true},{"text":"Toɠa pilɛ kɔɠɔiti ga, siɛgi zu é zeeɓɛzu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gè ɠɛni ma: «Ee, Ɠɔoɠɔ GALAGI, màawɔinɠa!","poem":1},{"lineBreak":true},{"text":"Kɛdɛyai ve bɛ̀, gè kotoi ɠɛa è laalɔɠɔma!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wɔ̀inzeɠe nuiti ta ɓɔɛzu dàalɔɠɔma ga ɲɔuɗa,","poem":1},{"lineBreak":true},{"text":"ti ɗa ɠɛ ma: «Siɛgi ɓɛgele zu ɠa é zaazu la?","poem":1},{"lineBreak":true},{"text":"Daaseigi ɠa za siɛgi ɓɛgele zu?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni nui ta a ʋaana é wɛlɛ bà,","poem":1},{"lineBreak":true},{"text":"toɠa kpɔɛ wafuungiti bosu,","poem":1},{"lineBreak":true},{"text":"zii ɠa telebotala vaiti gaalɛɛzu ba,","poem":1},{"lineBreak":true},{"text":"é ɠula, é li, é ɓɔɛ eteaʋɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Niiti kpein ti wɔ̀inzeɠezu, ta ɓɔɛzu laa wu ɓɔɠɔ zaama ga ze,","poem":1},{"lineBreak":true},{"text":"ti ɗa ɠisiɛ maanɔɠɔ vaiti su dàalɔɠɔma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Niima zeeɓɛi é sogai, faa ɲɔu wola ɠa!","poem":1},{"lineBreak":true},{"text":"É laa betei ɠa, é la mɔ wuzeɠea eyɛsu pɛ!»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Anɛɛ bɔ̀ɔla ʋagɔi nii gè laani da,","poem":1},{"lineBreak":true},{"text":"gi ɗa nà-daamianigi mi gá tɔ, naa wuzeɠea dàalɔɠɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kɛlɛ ɗɔun ɗa, ee, Ɠɔoɠɔ GALAGI, màawɔinɠa, è ʋa è bùzeɠe,","poem":1},{"lineBreak":true},{"text":"nà naa ve ti ya, nii maanɛai ti sɔlɔɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wɛlɛ, nii gè kwɛɛgai la ga è wɔinʋɛ ga ze,","poem":1},{"lineBreak":true},{"text":"toɠa ga sìli nui la zobo sɔlɔɔsu mà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɗa makɛsu mà nà-sɔbalalai zu,","poem":1},{"lineBreak":true},{"text":"ɗa màkɛ è ɠakalaʋɛ eyɛsu ɠɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mamagi ɠa Ɠɔoɠɔ GALAGI ʋɛ,","poem":1},{"lineBreak":true},{"text":"Izilayɛle ná-GALAGI, ɠɔoɠɔ!","poem":1},{"lineBreak":true},{"text":"Amina! Amina!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}