{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"heading","content":["Ɠito GALA ba"]},{"type":"verse","number":1,"content":[{"noteId":13},{"text":"Ee, GALA, tukpɔi lo bɛ̀!","poem":1},{"lineBreak":true},{"text":"Màalobo ladalala nuɓusɛiti daalɔɠɔma!","poem":1},{"lineBreak":true},{"text":"Ùnmɔɔ, è kùla keleɠele ɲɔu nuiti zea, ti ga yaava nuiti!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɗa ɠa è ga nà-GALAGI, màkɛ nui.","poem":1},{"lineBreak":true},{"text":"Leeni vaa zu è pìliga ya?","poem":1},{"lineBreak":true},{"text":"Leeni vaa zu nà nà-eteai ziɛ gaazuɠilii zu,","poem":1},{"lineBreak":true},{"text":"sìli nuiti ta-wɔinzeɠemai zu?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɗa-wozakalagi leʋe ta ɗa-ɠaamai!","poem":1},{"lineBreak":true},{"text":"Ti lo tùɠɔ,","poem":1},{"lineBreak":true},{"text":"ti li ga ze ɗa-ɠize ɲadegai ma, è-zeizuʋɛ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nà liizu GALA ná-zalaɠa ɠulazuʋɛ,","poem":1},{"lineBreak":true},{"text":"GALA pɔ bɛ, nii é ga nà-koozunɛ wolai.","poem":1},{"lineBreak":true},{"text":"Nà è maamusɛ ga kɔnigi wooi,","poem":1},{"lineBreak":true},{"text":"ee, GALA, nà-GALAGI!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Leeni vaa zu, zìi, è ɲiikpisu,","poem":1},{"lineBreak":true},{"text":"è ɗa kpalagi wo kòozu?","poem":1},{"lineBreak":true},{"text":"Ɠito GALA ba, mazɔlɔɔ nà maamusɛzu ʋolu dɛ,","poem":1},{"lineBreak":true},{"text":"toɠa ga nà-kizogi, ta nà-GALAGI.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Eɓulu woo zɛʋɛ wɔlɔmai ma mɔinmɔin su, Guyeiti 42 ta 43 kpɔgɛ su, ti ɠɛ ga guyei ɠila.","reference":{"chapter":43,"verse":1}}]},"thisChapterLink":"/api/tod_pbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}