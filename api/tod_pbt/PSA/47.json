{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"heading","content":["À yealoɠa GALA bɛ"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Kolé mavofodaiti ta-wuyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nuɓusɛiti, wo kpein à yealoɠa!","poem":1},{"lineBreak":true},{"text":"À ɠoozunɛ wo wooɠula GALA ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI maayikiʋɛ, nii é Anii-Pɛ-Unda,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa é ga eteai kpein su masa golai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"É nuɓusɛiti koloa gi wu,","poem":1},{"lineBreak":true},{"text":"é ziiti kolo gi-ɠɔɠɔi wu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"É yiimazeɠea ga gá-yooi gi ʋɛ,","poem":1},{"lineBreak":true},{"text":"é ɠɛ ga nɛɛbɛ nui Zakɔɓe mavofodai ná-lɛbiyai.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"GALA ka lɛɛzu seizuʋɛ pilɛ sɔlɔɔ gooi zaama.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa liizu ɠakala ʋelei puʋu fɛɛ wooi ʋɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À guyei loo GALA dɛbi vai ma, à guyei loo!","poem":1},{"lineBreak":true},{"text":"À guyei loo gá-masagi lɛbi vai ma, à guyei loo!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ GALA ka ga eteai ma masagi,","poem":1},{"lineBreak":true},{"text":"à kidafaawu wuyei loo bɛ!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"GALA ka masadai ɠɛɛzu ziiti unda,","poem":1},{"lineBreak":true},{"text":"GALA ka masadai ɠɛɛzu ná-masa kpɔkpɔ ɲadegai ɠa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ziiti ta-ɠundiɠiiti ta ɓɔsu su,","poem":1},{"lineBreak":true},{"text":"ta Abalaame ná-GALAGI ná-nuɓusɛiti!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ eteai ma wɛlɛma nuiti","poem":1},{"noteId":16},{"text":"kpein ta GALA zeezu.","poem":1},{"lineBreak":true},{"text":"Tɔ ɠa é zeini eteai pɛ unda.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"wɛlɛma nuiti: Tati pelei taɠili ɓalaa ka ga nii: zobobɛ nuiti","reference":{"chapter":47,"verse":10}}]},"thisChapterLink":"/api/tod_pbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}