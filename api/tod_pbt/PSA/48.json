{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":48,"content":[{"type":"heading","content":["GALA ná-taazuʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Guyei. Kolé mavofodaiti ta-wuyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ungo, Ɠɔoɠɔ GALAGI wɔɔlɔʋɛ, toɠa maamusɛi kpein soloogai ma,","poem":1},{"lineBreak":true},{"text":"gá-ƓALAGI ná-taazuʋɛ, ná-gize ɲadegai ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gize maanɛɛgi, nii é eteai pɛ koozunɛɛzu,","poem":1},{"lineBreak":true},{"text":"Siyɔn gizei, nii é ga GALA seizuʋɛ,","poem":1},{"lineBreak":true},{"text":"masa golai ná-taai!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"GALA ka ɓɔɠɔ lɛɛzu, eɠɛ siɠi gaaɠoozagi,","poem":1},{"lineBreak":true},{"text":"Siyɔn masa pɛlɛi wu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mazɔlɔɔ wɛlɛ, masagiti ti ɓɔɠɔ ɠaani,","poem":1},{"lineBreak":true},{"text":"ti liini ʋɔɔma Siyɔn laalɔɠɔma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ti wɛlɛni, ti laavɔ,","poem":1},{"lineBreak":true},{"text":"ti ɠoozuʋilini ti ʋela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ti zasuɓalini náʋɛ nɔ,","poem":1},{"lineBreak":true},{"text":"eɠɛ taɓai nii a ɗa anzanui zo a ɠɛna doin zɔlɔɔga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Eɠɛ folo ɠulazu ʋele viilɛi,","poem":1},{"lineBreak":true},{"text":"é Taalasise ɓato wolaiti koloɠolosu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nii gi mɛnini, gi naa ɠa gá ɓɔɠɔi","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ná-taazuʋɛ, Fai-Pɛ-Maliɠii, gá-ƓALAGI ná-taazuʋɛ,","poem":1},{"lineBreak":true},{"text":"GALA ka sasulɔ eyɛsu ɠɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee, GALA, gá ɠisiɛzu ɗa-wooɠɛɠiladai zu,","poem":1},{"lineBreak":true},{"text":"è zei ʋɛlɛi wu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ee, GALA, è lɔɠɔɠulaa,","poem":1},{"lineBreak":true},{"text":"ɗa-maamusɛi zeelia zou ɓela ga,","poem":1},{"lineBreak":true},{"text":"è-yeezai laavegɛ ga telebodai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Koozunɛɛi ɠa Siyɔn gizei ma,","poem":1},{"lineBreak":true},{"text":"Zuda yooi zu laaiti ta ɠoozunɛɛzu,","poem":1},{"lineBreak":true},{"text":"ɗa-lukpɔɠaaleʋe vaiti maaʋele ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À Siyɔn maalati, wo ziɛ koozuʋɛ,","poem":1},{"lineBreak":true},{"text":"wo ná-pɛlɛ ɠaaɠoozagiti gaalu,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"à ná-siɠigiti pɛtɛ,","poem":1},{"lineBreak":true},{"text":"wo wɛlɛ dɔɔɠuzuʋɛ ma ʋɛlɛiti ba,","poem":1},{"lineBreak":true},{"text":"wo ʋa bo yamanii zu nuiti ma, ti ʋaazu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wɛlɛna GALAGI ʋa,","poem":1},{"lineBreak":true},{"text":"nii é ga gá-ƓALAGI eyɛsu ɠɔ.","poem":1},{"lineBreak":true},{"text":"Toɠa ɠɛ ga gá-lotuɠɔi eyɛsu saai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}