{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":52,"content":[{"type":"heading","content":["Naavolo nu ɲɔi ná-eteai ɠaaɓelagi"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-kidafaawui.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Siɛgi zu Edɔme nui Dowɛge liini la, é ɠɛ Sayile ma, Davide liiʋɛ Ayimelɛke ná-pɛlɛi wu.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɗɛi è zuɓaai, leeni vaa zu è wasosu ɗa-zuɲɔi zu?","poem":1},{"lineBreak":true},{"text":"Wɛlɛ, GALA ná-wooɠɛɠiladai ɠa ɠulazu kɛlɛma folo-o-folo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaavai nɔ ɠa è-nɛgi kpɛtɛzu, kpeka ɠaaligi,","poem":1},{"lineBreak":true},{"text":"ɗa ga yaava nui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Faa ɲɔi nɛɛʋɛ è ʋɛ, é leʋe faa ʋagɔi ʋa,","poem":1},{"lineBreak":true},{"text":"zɛɛ vai nɛ è ʋɛ, é leʋe sɔle kpɔɛi ʋa.","poem":1},"Lo!"]},{"type":"verse","number":6,"content":[{"text":"Nu ɠoloɠolo gooiti nɛɛʋɛ è ʋɛ,","poem":1},{"lineBreak":true},{"text":"è-nɛgi yaavaʋɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naa ɠa é ba, GALA ka è lokasu eyɛsu ɠɔ.","poem":1},{"lineBreak":true},{"text":"Toɠa è zosu ɗa-zeɠe ɠotai wu, é è lɔɔɠula,","poem":1},{"lineBreak":true},{"text":"é è-ma zapei lɔɔɠula fulu nuiti ta-yooi ɠa.","poem":1},"Lo!"]},{"type":"verse","number":8,"content":[{"text":"Telebo nuiti ta naa ɠa, dualuagi ti zo,","poem":1},{"lineBreak":true},{"text":"ti ɲɛɛɠula è zu, ti ɠɛ ma:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Wɛlɛ zunui ʋa, nii é la ɠɛni GALA kɛɛni ga makɛ nui,","poem":1},{"lineBreak":true},{"text":"kɛlɛ é ɓɔɠɔ ɠalivaani ná-naavolo wolai ma,","poem":1},{"lineBreak":true},{"text":"é ɗa ɓaa ɓɔɠɔ maazu ga ná-keleɠele ɲɔi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nɔ̀un nà, nà GALA ná-pɛlɛi wu eɠɛ wolive wului ma wundui,","poem":1},{"lineBreak":true},{"text":"gè ɓɔɠɔ ɠalivaaʋɛ GALA ná-wooɠɛɠiladai ma eyɛsu ɠɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nà è maamusɛ eyɛsu ɠɔ, è-ɠɛɛ vai ʋɔ, nii è kɛai.","poem":1},{"lineBreak":true},{"text":"Nà ɠitosu è-laaseigi ʋa, tɔɔzei è ʋagɛ ɗa-wooɠɛɠila nuiti bɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}