{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":6,"content":[{"type":"heading","content":["Kpɔbai ɠaiziɛ vai"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. É looni ga kɔnigiti, niiti galu lɔsaʋai ti ɠa. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɠɔoɠɔ GALAGI, mina dòɠa ɗa-yiiɠaawanai zu,","poem":1},{"lineBreak":true},{"text":"mina kòlo ɗa-yiiɠulagi zu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, màawɔinɠa, mazɔlɔɔ zɛbɛ nɔpɛ ge la mɔ bà!","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, bàlo, mazɔlɔɔ sàsu ɠa ɓalizu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"zìi ɗa wola ɓali.","poem":1},{"lineBreak":true},{"text":"Yeelɛ ɠa è ʋaazu la Ɠɔoɠɔ GALAGI, nà-kpɔba vai ma?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ʋa bɛ̀ mɔnɔ, Ɠɔoɠɔ GALAGI, è ùnmɔɔ,","poem":1},{"lineBreak":true},{"text":"kìzo ɗa-wooɠɛɠiladai maaʋele ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ niiti ti zaai, naati ti la zooga ti ʋa ɠisiɛ è zu!","poem":1},{"lineBreak":true},{"text":"Ɓɛ ɠa a zoo é è maamusɛ gɔvɛalaazu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gè yɛga kpalagi wola wosu, gaaɓaai ɠula sù,","poem":1},{"lineBreak":true},{"text":"nà laani nà-betei zu, kpidii kpein gè ɗa wɔlɔ,","poem":1},{"lineBreak":true},{"text":"dàazuʋɛ yɛɓɛa, é lɛilɛi ga gàazuɗɛi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gàazuɠɛzɛiti ti wɔlɔzaɠaga ga ziizoolɛi,","poem":1},{"lineBreak":true},{"text":"ta wɔlɔzaɠasu, tɔɔzei sìli nuiti ta-vaa zu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"À maaɠooza bà, faa ɲɔu ɓɛtɛ nuiti,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ Ɠɔoɠɔ GALAGI nà-gɔlɔ wooiti mɛnini.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI yeezeini nà-maanɛɛnɛ wooiti bu.","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI vaani nà-maanɛɛnɛ wooi wu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sìli nuiti kpein ta unfe, ti zasuɓali,","poem":1},{"lineBreak":true},{"text":"ti ɠula ʋolu gaamanɔ, ti pɛ ti unfe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}