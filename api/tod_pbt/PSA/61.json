{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"heading","content":["Dɔ̀ɔɠu è-ɠoʋegiti bu"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. É loozu ga kɔnigiti. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee, GALA, woilo nà-kpee wooi ma,","poem":1},{"lineBreak":true},{"text":"ɠida nà-maanɛɛnɛ wooi wu!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eteai ɠwɛmaʋɛ ɠa gè wooɠulazu ná è ma, zìiɓɔlɔʋɛ.","poem":1},{"lineBreak":true},{"text":"Lɛ ga ze fasa ɠaaɠoozagi ma, nii gè la zooga gè ʋa zeeli ma ɓɔɠɔ ʋɛ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ ɗa ga nɔ̀un dɔɔɠuzuʋɛ,","poem":1},{"lineBreak":true},{"text":"pɛlɛ ɠaaɠoozagi siɠigi ma, sìli nui ɠaazu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nà pɔ gè zei ɗa-zeɠe ʋɛlɛi wu, gè yɛ ná ɠɔ,","poem":1},{"lineBreak":true},{"text":"gè lɔɔɠu è-ɠoʋegiti bu.","poem":1},"Lo!"]},{"type":"verse","number":6,"content":[{"text":"Mazɔlɔɔ GALA, ɗa ɠa è woilosu nà-minazeɠe gooiti ma,","poem":1},{"lineBreak":true},{"text":"è poganii ve zèa, nii è feezu naati zea, niiti ti luazu è ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gá-masagi zii ma voloiti suɠooza, è ta ɓɔ ti ʋa,","poem":1},{"lineBreak":true},{"text":"ná-konagiti suɠooza yeeɠɛɠalaiti pɛ su!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"É yɛ zeini GALA kakala, eyɛsu ɠɔ.","poem":1},{"lineBreak":true},{"text":"Va bu, ɗa-wooɠɛɠiladai ta ɗa-ɠaamai, naati ti ɓaa tɔun maazu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ungo, nà guyei loozu yeenɔpɛ è-laaseigi lɛbi vai zu,","poem":1},{"lineBreak":true},{"text":"gè nà-minazeɠegiti daazeeli folo-o-folo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}