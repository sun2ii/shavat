{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":62,"content":[{"type":"heading","content":["Ni nà GALA zea, zìilɛiʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Eɠɛʋelei Yedutun la. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"GALA gila kpegi ʋɔ bɛ ɠa nà ziilɛigi zɔlɔɔ ná,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa nà-kizo fai zea.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɔ ɠila kpegi ɠa é bɛ̀ ga fasai ta kizogi,","poem":1},{"lineBreak":true},{"text":"nà-siɠigi, gè la ɲiikpiga eyɛsu pɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yeeɠɛɠala lielegɔ ɠa wo kɛɛzu, wo ɗa ɠili ɓɔɠɔ ʋa zunu ɠilagi laalɔɠɔma,","poem":1},{"lineBreak":true},{"text":"nii a kɛ wo golo,","poem":1},{"lineBreak":true},{"text":"eɠɛ siɠigi maalaai na, ɓaa eɠɛ sasai é loozu niina?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ti deveiti boga ga ti too, ti kula tosu wolai.","poem":1},{"lineBreak":true},{"text":"Zɛɛi nɛɛʋɛ ti ʋɛ,","poem":1},{"lineBreak":true},{"text":"ta tuyai loozu ga ti-laaʋɛ,","poem":1},{"lineBreak":true},{"text":"ti ɗa foovooi loo ti-ɠoozuʋɛ.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"GALA gila kpegi ʋɔ bɛ ɠa nà ziilɛigi zɔlɔɔ ná,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ tɔ ɠa é ga nà-kitogi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tɔ ɠila kpegi ɠa é bɛ̀ ga fasai ta kizogi,","poem":1},{"lineBreak":true},{"text":"nà-siɠigi, gè la ɓunɛga pɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nà-kizogi, nà-lɛbiyai, ti kpein sɛlɛgɛ GALA ba.","poem":1},{"lineBreak":true},{"text":"Nà-fasai é màkɛsu, dɔ̀ɔɠuzuʋɛ, toɠa ga GALA.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuɓusɛiti, à ɠaliva tɔun ma yeenɔpɛ!","poem":1},{"lineBreak":true},{"text":"À wo-yiiti daalao tɔun bɛ!","poem":1},{"lineBreak":true},{"text":"GALA ka é ga ade-lɔɔɠuzuʋɛ.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ungo, Adama leaiti ta nɔ ga fiilɛi é leʋesu.","poem":1},{"lineBreak":true},{"text":"Nuiti kpein ti ɓɔ su, ta nɔ ga gaaʋɛ nua.","poem":1},{"lineBreak":true},{"text":"Ɗa ti pɛ seina kiloi ɠa,","poem":1},{"lineBreak":true},{"text":"fiilɛi wuiʋɛ ti ʋa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mina ʋilɛ toomai ʋolu.","poem":1},{"lineBreak":true},{"text":"Mina ɠito naavoloiti ba, niiti ti zɔlɔɔ pelei ɲɔuɗai.","poem":1},{"lineBreak":true},{"text":"Ni è-zɔlɔɔgi ɠaa a wɔɔlɔna,","poem":1},{"lineBreak":true},{"text":"mina kɛ ga ɗa-ɠitogi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"GALA ge faa ɠila boni,","poem":1},{"lineBreak":true},{"text":"é lati, é bo ʋolu, gè mɛnini, é ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«Zobogi ɠa ga GALA nɔnɔ.»","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɗa ɓalaagi, Màliɠii, wooɠɛɠiladai ɠa ga ɗɔnɔ,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ɗa ɠa è ɛsɛ gilagilagi zalai veezu zea, eɠɛʋelei ná-kɛɛwotiiti ti la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}