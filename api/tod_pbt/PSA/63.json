{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":63,"content":[{"type":"heading","content":["Ɗa-nuɓɔɠɔlai vizɔgɛ zɛnvui ʋa"]},{"type":"verse","number":1,"content":[{"text":"Davide ná-guyei. Siɛgi zu é ɠɛni la Zuda yooi zu teʋebai zu.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee, GALA, ɗa ga nà-GALAGI!","poem":1},{"lineBreak":true},{"text":"Nà è ɠaiziɛzu,","poem":1},{"lineBreak":true},{"text":"è wɔin ɠa zìi ma eɠɛ kpɔɔle wɔin,","poem":1},{"lineBreak":true},{"text":"kpùsɛi ɠa ɓalasu ga ɗa-vaa,","poem":1},{"lineBreak":true},{"text":"eɠɛ zou vɔɔi, ná vɔai, ziɛ la ná.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zekana gè è ɠaazu la è-zeizu ɲadegai,","poem":1},{"lineBreak":true},{"text":"gè ɗa wɛlɛ è-zɛbɛi ta ɗa-lɛbiyai ʋa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ ɗa-wooɠɛɠiladai vizɔgɛ zɛnvui ʋa,","poem":1},{"lineBreak":true},{"text":"dàkɔlɔgiti ta è maamusɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naa ɠa é ba, nà è mama sìi ma voloi pɛ su,","poem":1},{"lineBreak":true},{"text":"gè zèeiti tɛ geezu è-laaseigi zu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nà anii pɛ sɔlɔɔ é kula ɠɛ, eɠɛ ma wulɔi ta ma ɓɔlɔgi,","poem":1},{"lineBreak":true},{"text":"nà wooɠula ga koozunɛɛi, gè guyeiti too, gè è maamusɛ la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Siɛgi zu kìgi loozu la è zu, dàazuʋɛ,","poem":1},{"lineBreak":true},{"text":"nà ɗa ɠigaiziɛ è zu kpidii ma yeeɠɛɠalai kpein su.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ ɗa ga nà-kpɔba nui,","poem":1},{"lineBreak":true},{"text":"nà guyei loozu ga koozunɛɛi, è-ɠoʋegiti ma niinigi wu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gìliʋɛ è ʋa ga zìimaʋɛ pɛ,","poem":1},{"lineBreak":true},{"text":"è-yeezai ɠa é ɓaazu màazu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɛlɛ niiti wɔin ti ma ga ti zɛ̀nvui ɠoloɠolo,","poem":1},{"lineBreak":true},{"text":"naati ta yei zooi ma yeɠezaɠai ɓomaʋɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ta ti ʋaa ga boɠa zɔkpɔi,","poem":1},{"lineBreak":true},{"text":"ti ɠɛ ga koʋeiti daamianigi,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"masagi ɠa ɠoozunɛ ga GALA maaʋele,","poem":1},{"lineBreak":true},{"text":"nu-o-nu nii a minazeɠe ná-faa zu, naa ɠa ɓɔɠɔ maamusɛ naazu.","poem":1},{"lineBreak":true},{"text":"Kɛlɛ naazu zɛɛ wo nuiti gaa ɠa lɛi, ti laaɠulu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}