{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":64,"content":[{"type":"heading","content":["Makɛ mà!"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee, GALA, woilo gòoi ma, siɛgi zu gè kpalagi wosu da!","poem":1},{"lineBreak":true},{"text":"Zɛ̀nvui makɛ sìli nuiti daalɔɠɔma, gè luazu ti ʋa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kìzo nu ɲɔiti daayaavai ma,","poem":1},{"lineBreak":true},{"text":"ta naati ta-woya vaiti ma, niiti ti faa ɲɔi ɠɛɛzu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ta ti-nɛgi ɠaalizu eɠɛ boɠa zɔkpɔi,","poem":1},{"lineBreak":true},{"text":"ta nu maawana ɓɔɛiti bosu, eɠɛ mɛɛinti ti ʋilisu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"é ʋilisu dɔɔɠuzu telebo nui ma.","poem":1},{"lineBreak":true},{"text":"Ta pilisu ma ga kulafilibai, inɛinɛ ge la ti ʋa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ta ɓɔɠɔ zasulɔɔzu kpɔɛ ɲɔu wogaiti su,","poem":1},{"lineBreak":true},{"text":"ta bosu ga ti baliiti da, ti maalɔɔɠu,","poem":1},{"lineBreak":true},{"text":"ti ɗa ɠɛ ma: «Ɓɛ ɠa a ti ɠa?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ti ɗa yaavaiti kpɛtɛ, ti ɠɛ ma:","poem":1},{"lineBreak":true},{"text":"«Wɛlɛ, ade ɠɛʋele ɓɛtɛa, ada-vaa ɓɛtɛi zolooga su!»","poem":1},{"lineBreak":true},{"text":"Ungo, kigaiziɛi, nu zii ɠa ga zeɠezaɠai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kɛlɛ GALA ka mɛɛin ʋilisu ti ma ga kulafilibai,","poem":1},{"lineBreak":true},{"text":"tiya ɠana ti zuloɠaai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ti-nɛgi ɠa é ti ɓunɛgai.","poem":1},{"lineBreak":true},{"text":"Nuiti ta ti ʋɛtɛna, ti ɗa ɠɔmɔɔni ga tiye.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dualuagi nuɓusɛiti kpein sogɛ,","poem":1},{"lineBreak":true},{"text":"ta GALA ná-kɛɛwotii ɠulazu kɛlɛma,","poem":1},{"lineBreak":true},{"text":"ti ná-kɛɛwotiiti gaaɠa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Telebo nui ɠa ɠoozunɛɛzu Ɠɔoɠɔ GALAGI ná-fai zu, é lɔɔɠu pɔ bɛ.","poem":1},{"lineBreak":true},{"text":"Niiti dɔin ti-yii zɔlegai, naati ta ɓɔɠɔ maamusɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}