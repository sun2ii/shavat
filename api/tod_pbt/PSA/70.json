{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"heading","content":["GALA, ʋa è ɓɔ bà"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei, é ɠɛ ga ɠizɛsui.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee, GALA, soma è ùnmɔɔ!","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, suvilɛ, è ɓɔ bà!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Unfegi ti maaɓɔle, ti wooi zupu,","poem":1},{"lineBreak":true},{"text":"tɛiti ti pɔ ti zɛ̀nvui ɠula zèa!","poem":1},{"lineBreak":true},{"text":"Ti li ga ʋoluʋelei, ti unfe,","poem":1},{"lineBreak":true},{"text":"tɛiti kpein ti wɔinɗai ga màanɔɠɔ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Niiti ti ɲɛɛɠulazu nɔ̀un su,","poem":1},{"lineBreak":true},{"text":"ti ɠula ʋolu, ta-unfe kasɔi la ti unma!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Niiti dɔin ti è ɠaiziɛzu,","poem":1},{"lineBreak":true},{"text":"ti ɠaazuɠalakala, ti ɠoozunɛ è ʋɔ!","poem":1},{"lineBreak":true},{"text":"Niiti ɗa-ɠizo fai nɛai ti ʋɛ,","poem":1},{"lineBreak":true},{"text":"ti ɠɛ ma yeenɔpɛ: «Lɛbiyai ɠa GALA bɛ!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɔ̀un nà, màanɔɠɔʋɛ, gè ɠɛ ga bala nu,","poem":1},{"lineBreak":true},{"text":"ee, GALA, ʋa kòba fala,","poem":1},{"lineBreak":true},{"text":"ɗa ga nà-kpɔba nui, ta ùnmɔɔ nui,","poem":1},{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI, mina nɛkɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}