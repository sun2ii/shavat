{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":75,"content":[{"type":"heading","content":["GALA ka eteai lukpɔɠaaleʋe"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Nii é loozu é zoloo guye wooi ma, nii daa ga: «Mina koloɠolo!» Azafe ná-guyei. Guyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gá è maamusɛzu, ee, GALA!","poem":1},{"lineBreak":true},{"text":"Gá è maamusɛzu.","poem":1},{"lineBreak":true},{"text":"Gá zezezu ga è-lɔɠɔi.","poem":1},{"lineBreak":true},{"text":"Ɛsɛ pɛ ka ɗa-ɠɛɛwoti maayikiaiti ta-vaa wosu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠɛ ma: «Siɛgi gè teʋeai ba, naa a zeelina,","poem":1},{"lineBreak":true},{"text":"nà tukpɔi ɠaaleʋe ga sɔledai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eteai ɠa ɲiikpi, ta nii kpein é zeini su,","poem":1},{"lineBreak":true},{"text":"nà ɠa nà zɛ loni kpaan kpɛdɛgiti ga.","poem":1},"Lo!"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Nà bosu naati ma, niiti ti wasosu ga: ‹À mina waso pa!›","poem":1},{"lineBreak":true},{"text":"Gè ɠɛ faa ɲɔu ɠɛ nuiti ma: ‹À mina loʋalaʋɛ wuzeɠe!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À mina gaazulɛ ɠula ga GALA!","poem":1},{"lineBreak":true},{"text":"À ɓe ɠɔgi losu ga, wo ʋa ɗa gaazulɛɛ ɓɔɛiti bo!› »","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À suɠwɛɛ ga nui ná-bɔɔlɔlai la zeɠezu folo ɠulazu ʋelei,","poem":1},{"lineBreak":true},{"text":"ɓaa folo liizu ʋelei, ɓaa teʋebai zu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ GALA ka é tukpɔi ɠaaleʋezu,","poem":1},{"lineBreak":true},{"text":"toɠa ta wuzeɠe, é ta ɠaayei.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ziawɔi ɠa zoni Ɠɔoɠɔ GALAGI ya,","poem":1},{"lineBreak":true},{"text":"daavegai ga ná-ziiɠaawana lɔɔi, nii sɔgai é zupu.","poem":1},{"lineBreak":true},{"text":"Toɠa puuzu faa ɲɔu ɠɛ nuiti bɛ eteai zu,","poem":1},{"lineBreak":true},{"text":"ta kpɔle, ti ziawɔi naa zuwo eyɛsu é zeeli kpogi zu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nɔ̀un nà, gè la looɠoga bo fai ʋa ɠɔ,","poem":1},{"lineBreak":true},{"text":"nà Zakɔɓe ná-GALAGI maamusɛ yeenɔpɛ ga guyei.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Toɠa faa ɲɔu ɠɛ nuiti ta-wasogi zuɠaleɠale,","poem":1},{"lineBreak":true},{"text":"kɛlɛ tɔun, telebo nui ɠa ɠɛ ziɛzu nɔungi wuzeɠeai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}