{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"heading","content":["GALA bɔɔlɔ ʋelei,ta nuɓusɛi ɓalaa losuʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Davide ná-guyei. É loozu kɔnigi ɠa, nii é zeɠezu Gate taazuʋɛ.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɠɔoɠɔ GALAGI, gi-Maliɠii!","poem":1},{"lineBreak":true},{"text":"È-laaseigi maayikiʋɛ, eteai zu ná pɛ!","poem":1},{"lineBreak":true},{"text":"Ɗa-maayikii é volozu, è naa zeiɗa geeɠɔlɔgi maazuʋɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È lɛbiyai lɔa doungoiti daaʋɛ, ta ɲiimiɓɔlegiti,","poem":1},{"lineBreak":true},{"text":"è wɔinzeɠe nuiti ta-vaa zu,","poem":1},{"lineBreak":true},{"text":"è è zili nuiti gaalɛi, ta potokula nuiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Siɛgi zu nà geeɠɔlɔgiti pɛtɛna da, ti ga ɗɔnɔiti, è-yeei ti ɓɛtɛai,","poem":1},{"lineBreak":true},{"text":"alugi ta somideɠaiti, è ti ɲɛkpɛai:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuɓusɛi ɠa ga leeni, è ʋa ɠigaiziɛ su?","poem":1},{"lineBreak":true},{"text":"Nui ɠa ga leeni, è ʋa yiizoolɛ la?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anɛɛ naa ʋe, è kɛɛʋɛ ga GALA ná-seikobai nɔ,","poem":1},{"lineBreak":true},{"text":"è lɛbiyai ta unfemai veeʋɛ bɛ, ti ɠɛ unma ga masa bɔɔlɔgi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"È zobogi veeʋɛ bɛ, ga é masadai ɠɛ anii kpein unda, è-yeei ti ɓɛtɛai,","poem":1},{"lineBreak":true},{"text":"è ti pɛ puuni kɔɠɔwu,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"toganiiti pɛ, ma wolaiti ta ma goiti,","poem":1},{"lineBreak":true},{"text":"anɛɛ dɔɓɔ zuaiti ɓalaa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ta wɔniiti, ta kaleiti,","poem":1},{"lineBreak":true},{"text":"ta niiti kpein ti ziɛzu ziɛiti bu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɠɔoɠɔ GALAGI, gi-Maliɠii!","poem":1},{"lineBreak":true},{"text":"È-laaseigi maayikiʋɛ, eteai zu ná pɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}