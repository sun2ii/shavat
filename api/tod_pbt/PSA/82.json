{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"heading","content":["GALA ka gala kiligiti tukpɔɠaaleʋe"]},{"type":"verse","number":1,"content":[{"text":"Azafe ná-guyei.","descriptive":true},{"lineBreak":true},{"text":"GALA ná-tukpɔɠaaleʋezuʋɛ, GALA ka loni gala kiligiti saama,","poem":1},{"lineBreak":true},{"text":"é ɗa tukpɔi ɠaaleʋe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"É ɠɛ ma: «Wa yɛsu tukpɔi ɠaaleʋezu ga telebotalai, eyɛsu yeelɛ,","poem":1},{"lineBreak":true},{"text":"wo ɗa lo faa ɲɔu ɠɛ nuiti polu?","poem":1},"Lo!"]},{"type":"verse","number":3,"content":[{"text":"À zɛbɛsulala nuiti maalobo, podointi,","poem":1},{"lineBreak":true},{"text":"wo ɠɛ ga sɔle nu bala nuiti bɛ, ta maawɔin nuiti,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"à zɛbɛsulala nuiti fie, ta maawɔin nuiti,","poem":1},{"lineBreak":true},{"text":"à ti vie, wo ti ɠula faa ɲɔu ɠɛ nuiti zea.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Kɛlɛ ti la faa nɔpɛ gaaɠaazu, ti la faa nɔpɛ kwɛɛ,","poem":1},{"lineBreak":true},{"text":"ta liizu ga yeeʋɛa mɛmɛ kpidii zu,","poem":1},{"lineBreak":true},{"text":"eteai ma wuulaagiti ti ɲiikpiga eteai zu ná pɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gè ɠɛni ma: ‹Wa ga galagiti,","poem":1},{"lineBreak":true},{"text":"wo pɛ wa ga nii é Anii-Pɛ-Unda naa ná-doun zunuiti!›","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anɛɛ naa ʋe, wa zaazu ga nuɓusɛiti kɛʋele,","poem":1},{"lineBreak":true},{"text":"wa loo bu, eɠɛʋelei nɔ kundiɠiiti ta ɗa loo bu la.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee, GALA, wuzeɠe, è eteai lukpɔɠaaleʋe!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ ziiti pɛ ta ga ɗɔnɔi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}