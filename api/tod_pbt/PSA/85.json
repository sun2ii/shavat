{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":85,"content":[{"type":"heading","content":["Ɠɔoɠɔ GALAGI ɠa undaanɛɛi ve gi ʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Guye loo ɠundiɠii nɔnɔi ʋe. Kolé mavofodaiti ta-wuyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɠɔoɠɔ GALAGI, è undaanɛ vaa ɠɛɛni ɗa-yooi ʋɛ.","poem":1},{"lineBreak":true},{"text":"È Zakɔɓe mavofodai zei ʋele ɓɛtɛni ʋolu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È ɗa-nuɓusɛiti ta-vaaɠaaza golaiti seɠeni ti unma,","poem":1},{"lineBreak":true},{"text":"è ta-ɠotoiti kpein suvaayɛni.","poem":1},"Lo!"]},{"type":"verse","number":4,"content":[{"text":"È ɗa-yiiɠaawana vai zeɠeni ga,","poem":1},{"lineBreak":true},{"text":"è yeeɓeni ɗa-yiimaleʋei ʋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gi zei ʋele ɓɛtɛ ʋolu, ee, GALA, gi ɠizo nui!","poem":1},{"lineBreak":true},{"text":"Ɓe yiiɠaawanazu gi ma!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɗa yɛsu yiiɠaawanazu gi ma, eyɛsu ɠɔ ɓaa?","poem":1},{"lineBreak":true},{"text":"Ɗa-yiiɠaawanai la ɓesu ɠɔ, eyɛsu yeeɠɛɠalaiti pɛ su?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"È la kɛa, è ʋa zɛnvui ve gi ya ʋolu ɓaa,","poem":1},{"lineBreak":true},{"text":"nii a kɛ ɗa-nuɓusɛiti gi ɠoozunɛ è ʋɔ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, ɗa-wooɠɛɠiladai lɛ ga giye!","poem":1},{"lineBreak":true},{"text":"Ɗa-ɠizo fai ve gi ʋɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nà pɔ gè woilo naa ma, nii GALA ge bosu, Ɠɔoɠɔ GALAGI.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ toɠa ziilɛi kpɔɛi wosu ná-nuɓusɛiti ma, ta niiti ti bɛ ga wooɠɛɠila nuiti.","poem":1},{"lineBreak":true},{"text":"Kɛlɛ ti mina ɠale ma mɔnɔ tooya vaiti ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ungo, nágo ʋe na, è ʋa naati kizo, niiti ti luazu ba,","poem":1},{"lineBreak":true},{"text":"naa ɠa a kɛ, lɛbiyai zei gá-yooi zu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wooɠɛɠiladai ta gaamai ta ɠomi,","poem":1},{"lineBreak":true},{"text":"telebodai ta ziilɛigi ta yeezo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gaamai ɠa ʋɔnɔ zooi ʋa,","poem":1},{"lineBreak":true},{"text":"telebodai ɠa yei, é zeɠe geezuʋɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɓɔɠɔi ɠa undaanɛɛi ve,","poem":1},{"lineBreak":true},{"text":"gá-yooi ɠa kulanumai ve.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Telebogi ɠa ziɛ tɔun kakalaʋɛ,","poem":1},{"lineBreak":true},{"text":"é pelei la tuɠɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}