wo Siyɔn ná-faa zu ga:","poem":1},{"lineBreak":true},{"text":"«Nui pɛ sɔlɔɔgɛ ʋɛ,","poem":1},{"lineBreak":true},{"text":"GALA, é Anii-Pɛ-Unda, naa ɠa zee ná ʋa.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI nuɓusɛiti kpein tɔɠɔi zɛʋɛʋɛ,","poem":1},{"lineBreak":true},{"text":"é sɛʋɛ ɛsɛ gilagilagi ná-faa zu ga:","poem":1},{"lineBreak":true},{"text":"«Nii zɔlɔɔsuʋɛ ɓɔɔɓɔgi ɠa ga ʋɛ».","poem":1},"Lo!"]},{"type":"verse","number":7,"content":[{"text":"Niiti ti guyei loozu, ta niiti ti kuai wosu,","poem":1},{"lineBreak":true},{"text":"naati ta ɠɛɛzu ma:","poem":1},{"lineBreak":true},{"text":"«Nà-sɔlɔɔgi kpein ka ɗɔun è ʋɔ bɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}