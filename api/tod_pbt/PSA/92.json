{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":92,"content":[{"type":"heading","content":["Pagɛ ga nu Ɠɔoɠɔ GALAGI maamusɛ"]},{"type":"verse","number":1,"content":[{"text":"Guyei. Dooɠo foloi ma wuyei.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pagɛ ga nu Ɠɔoɠɔ GALAGI maamusɛ,","poem":1},{"lineBreak":true},{"text":"nu è maamusɛ ga guye wooi, ɗɛi è Anii-Pɛ-Unda!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pagɛ ɓalaa ga nu ɗa-nuɓɔɠɔlai laazeeli vai lɔɔzei sobui nɔ,","poem":1},{"lineBreak":true},{"text":"ta ɗa-wooɠɛɠiladai laazeeli kpɔkɔi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"gɛingɛin ganigi galu puugɔi ga,","poem":1},{"lineBreak":true},{"text":"ta papai, ta kɔnigi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee, Ɠɔoɠɔ GALAGI, ɗa kòozunɛɛzu naa ʋɔ, nii è kɛɛzu!","poem":1},{"lineBreak":true},{"text":"Nà wooɠulazu ga koozunɛɛi è-yeei ná-kpɛtɛaniiti faa zu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɗa-ɠɛɛwotiiti bɔɔlɔʋɛ, ee, Ɠɔoɠɔ GALAGI!","poem":1},{"lineBreak":true},{"text":"Ɗa-ɠisiɛiti polu ɠoozaʋɛ!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nui ɠi ge la ma, é la kwɛɛ tago pa,","poem":1},{"lineBreak":true},{"text":"ɠimalala nui la ma ɠeleɠele sɔlɔɔga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Anɛɛ ni nu ɲɔiti ta ʋɔnɔsu eɠɛ tufa lɛnugi,","poem":1},{"lineBreak":true},{"text":"faa ɲɔu ɠɛ nuiti ti ɗa ɓɔvɔ,","poem":1},{"lineBreak":true},{"text":"ti undaa ɠa ʋili eyɛsu ɠɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɛlɛ, ee, Ɠɔoɠɔ GALAGI,","poem":1},{"lineBreak":true},{"text":"ɗa ɠa è masadai ɠɛɛzu eyɛsu ɠɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ è zili nuiti pɛtɛ, ee, Ɠɔoɠɔ GALAGI!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ è zili nuiti pɛtɛ, ti undaa ɠa ʋilisu ɲɛgɛlɛin,","poem":1},{"lineBreak":true},{"text":"niiti kpein ti faa ɲɔi ɠɛɛzu, ta vazasu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɗa sɛ̀bɛi wɔɔlɔzu, eɠɛ teɠui nɔnɔi,","poem":1},{"lineBreak":true},{"text":"gulɔ maku nɛɛnɛ niinɛi ɠa ziɛzu mà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gàazu logɛ zobo sɔlɔɔ fai ʋa sìli nuiti ma,","poem":1},{"lineBreak":true},{"text":"gòilogɛ nu ɲɔiti kpain gooi ma, niiti ti wuzeɠezu dàalɔɠɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Telebo nuiti ta ʋɔnɔsu eɠɛ dɔɔ wului,","poem":1},{"lineBreak":true},{"text":"ti wuzeɠe eɠɛ Liɓan sɛdele guluiti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ti ziingɛ Ɠɔoɠɔ GALAGI ná-pɛlɛi wu,","poem":1},{"lineBreak":true},{"text":"ti ɗa wɔɔlɔ gá-ƓALAGI ná-koizuʋɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ta ɓuɠuzu ti wɔlɔzaɠa siɛgi zu,","poem":1},{"lineBreak":true},{"text":"ti laavegɛ ga zɛbɛi, ti-ma wundui ɠɛ ti zu,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ta dɛɛ ga Ɠɔoɠɔ GALAGI zɔlegɛ,","poem":1},{"lineBreak":true},{"text":"tɔ ɠa é ga nà-fasai, telebotala ɠila kpalaa ge la tɔun su.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}