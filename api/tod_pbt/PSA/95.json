{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":95,"content":[{"type":"heading","content":["Eteai ɠa zeini GALA zeezaamaʋɛ"]},{"type":"verse","number":1,"content":[{"text":"Ade li, de guyei loo Ɠɔoɠɔ GALAGI ʋɛ!","poem":1},{"lineBreak":true},{"text":"Ade wooɠula ga koozunɛɛi ade ɠizo fasai ʋɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ade li, de lo gaazu, de mama,","poem":1},{"lineBreak":true},{"text":"de dɛbi ga guyeiti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ Ɠɔoɠɔ GALAGI, ɠa ga GALAGI bɔɔlɔai,","poem":1},{"lineBreak":true},{"text":"toɠa ga masa golai, nii é zeini galagiti unga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eteai ma yeɠe ɓomaʋɛ pɛ ka zoni zea,","poem":1},{"lineBreak":true},{"text":"gizeiti sokpaiti ta ga nɔnɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kpoloɗɛi ɠa ga nɔnɔ, tɔ ɠa é kpɛtɛa,","poem":1},{"lineBreak":true},{"text":"zooi ɓalaagi, zeei ɠa é kpɛtɛni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À ʋa, ade nɔkɔ bu, ade maayei tɔun bɛ,","poem":1},{"lineBreak":true},{"text":"ade ʋilɛ ɲiibiɠa Ɠɔoɠɔ GALAGI ʋɛ, nii é ade ɓɛtɛa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ tɔ ɠa ga da-ƓALAGI,","poem":1},{"lineBreak":true},{"text":"da ga ná-baalagiti é ti ɠɔnɔkulazu,","poem":1},{"lineBreak":true},{"text":"baala kpulugi nii é losu tuɠɔ.","poem":1},{"lineBreak":true},{"text":"Ni wa gooi mɛnina za,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"à mina wo-ɠigiti kpa, eɠɛʋelei é ɠɛɛni la Meliɓa,","poem":1},{"noteId":29},{"lineBreak":true},{"text":"eɠɛʋelei naama voloi é ɠɛɛni Masa, teʋebai zu,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ʋɛ wo-mɛmɛwolani ti tɛ̀ɛni ga ná, ti sùɠɔɠɔ,","poem":1},{"lineBreak":true},{"text":"anɛɛ ni ti nà-kɛɛwotiiti kaani.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kona ʋuunaanigɔ (40) laawu, niima yamanii wɔinzeɠeni mà,","poem":1},{"lineBreak":true},{"text":"eyɛsu gè ɠɛ ma: «Nuɓusɛa ʋe, ti ɠakagɛ ti-yiimaʋɛ,","poem":1},{"lineBreak":true},{"text":"ti la nà-peleiti kwɛɛ.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naa ɠa é kɛɛni, nà-ziiɠaawanai zu, gè ɠonani ga:","poem":1},{"lineBreak":true},{"text":"«Ti la lɔa nà-dooɠogi zu!»","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Wɛlɛ ʋɛti: Ɛgz 17:1-7; GlS 20:2-13.","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/tod_pbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}