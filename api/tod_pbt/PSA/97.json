{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":97,"content":[{"type":"heading","content":["GALAGI nii é eteai pɛ unda"]},{"type":"verse","number":1,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠa masadai ɠɛɛzu! Eteai ɠoozunɛ,","poem":1},{"lineBreak":true},{"text":"ziɛ zaama yooiti ti ɠoozunɛ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tonaɓiingiti ta kpidii ti ɠooliʋɛ ma.","poem":1},{"lineBreak":true},{"text":"Telebodai ta sɔledaiti ka ti ga ná-masa kpɔkpɔgi ʋoluzeigi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Abui ɠa ziɛzu kakalaʋɛ,","poem":1},{"lineBreak":true},{"text":"naa ɠa é sili nuiti galazu maaɠoolii zu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ná-mainmainti ta eteai zuɠalasu,","poem":1},{"lineBreak":true},{"text":"eteai kaani, é ɓali ga duai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gizeiti gaa ɠa wuunsu eɠɛ kedoi, Ɠɔoɠɔ GALAGI ɠakala,","poem":1},{"lineBreak":true},{"text":"eteai kpein Maliɠii ɠakala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Geeɠɔlɔgiti ta ná-telebodai lɛɛzu,","poem":1},{"lineBreak":true},{"text":"nuɓusɛiti pɛ ta ná-lɛbiyai ɠa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ta ɠɛ unfegi zu, niiti kpein ti nɔkɔsu vololibaiti bu,","poem":1},{"lineBreak":true},{"text":"niiti ti wasosu zɛɛ ɠalagiti ta-vaa zu, ti ti ya.","poem":1},{"lineBreak":true},{"text":"Wɔiti wo ga gala kiligiti kpein, à nɔkɔ Maliɠii wu!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma wooi ɠa mɛni Siyɔn, ti ɠoozunɛ,","poem":1},{"lineBreak":true},{"text":"Zuda laaiti kpein ta ɠɛ koozunɛɛi zu,","poem":1},{"lineBreak":true},{"text":"tɔɔzei ɗa-lukpɔɠaaleʋeiti ba, ee, Ɠɔoɠɔ GALAGI!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mazɔlɔɔ, Ɠɔoɠɔ GALAGI, ɗa ɠa è Anii-Pɛ-Unda eteai kpein maazu,","poem":1},{"lineBreak":true},{"text":"è-yee ɠa gala kiligiti kpein maazu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wɔiti Ɠɔoɠɔ GALAGI nɛai wo ʋɛ, à faa ɲɔi wɔinzeɠe!","poem":1},{"lineBreak":true},{"text":"Toɠa naati zɛnvui makɛsu, niiti ti ga wooɠɛɠila nuiti bɛ,","poem":1},{"lineBreak":true},{"text":"toɠa ti unmɔɔ, é ti ɠula faa ɲɔu ɠɛ nuiti zea.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wozakalagi vazagɛ telebo nui ʋɛ,","poem":1},{"lineBreak":true},{"text":"ta koozunɛɛi naati bɛ, niiti ti-yii zɔlegai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Telebo nuiti, à ɠoozunɛ Ɠɔoɠɔ GALAGI ná-faa zu,","poem":1},{"lineBreak":true},{"text":"wo daasei ɲadegai maamusɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}