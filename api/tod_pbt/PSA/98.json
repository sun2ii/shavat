{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":98,"content":[{"type":"heading","content":["GALA ka ʋaazu é eteai lukpɔɠaaleʋe"]},{"type":"verse","number":1,"content":[{"text":"Guyei.","descriptive":true},{"lineBreak":true},{"text":"À guye niinɛi loo Ɠɔoɠɔ GALAGI ʋɛ,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ é laavɔɔ vaiti kɛɛni.","poem":1},{"lineBreak":true},{"text":"É kizogi woni ga ná-zobogi, ta ná-gaaɓaa ɲadegai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠa ná-kizo fai lɛɛzu,","poem":1},{"lineBreak":true},{"text":"é ná-telebodai lɛ ga zii ɠiligiti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"É ɠizɛni ná-nuɓɔɠɔlai zu, ta ná-wooɠɛɠiladai Izilayɛle ná-pɛlɛyeɠei ʋɛ.","poem":1},{"lineBreak":true},{"text":"Eteai ɠwɛgi kpein ge ada-ƓALAGI ná-kizo fai ɠaani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eteai zu nuɓusɛiti kpein à wooɠula ga koozunɛɛi Ɠɔoɠɔ GALAGI ʋɛ,","poem":1},{"lineBreak":true},{"text":"wa-ɠoozunɛɛi zu, à guyei loo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À Ɠɔoɠɔ GALAGI maamusɛ ga papai wooi,","poem":1},{"lineBreak":true},{"text":"à naa ɠɛ papai wooi ʋɔ, ta guye wooiti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À maamusɛ ga puʋu gooi, ta baala minɛ ʋuʋugi wooi,","poem":1},{"lineBreak":true},{"text":"à ɠoozunɛ Ɠɔoɠɔ GALAGI ɠakala, nii é ga Masagi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kpoloɗɛi zikɔ, ta bu aniiti kpein,","poem":1},{"lineBreak":true},{"text":"eteai ta su aniiti kpein ɓalaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ziɛ wolaiti ti yealoɠa,","poem":1},{"lineBreak":true},{"text":"gizeiti ti ɓɔsu, ti guyei loo ga koozunɛɛi","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI ɠakala,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ toɠa ʋaazu é eteai lukpɔɠaaleʋe.","poem":1},{"lineBreak":true},{"text":"Toɠa eteai lukpɔɠaaleʋe ga telebodai,","poem":1},{"lineBreak":true},{"text":"ta nuɓusɛiti ga sɔledai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}