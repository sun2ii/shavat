{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"PSA","translationId":"tod_pbt","name":"Guyeiti","commonName":"Guyeiti","title":"GALA Sɛʋɛi Ma Wuyeiti","order":19,"numberOfChapters":150,"sha256":"35d9fb2287f6e2e8889eccc310a15650b61f51676f01e1dab4e956821cb00d50","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tod_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":99,"content":[{"type":"heading","content":["À nɔkɔ Ɠɔoɠɔ GALAGI wu,mazɔlɔɔ ɲadegɛ"]},{"type":"verse","number":1,"content":[{"text":"Ɠɔoɠɔ GALAGI ɠa masadai ɠɛɛzu,","poem":1},{"lineBreak":true},{"text":"nuɓusɛiti sasu ɠa ɓalizu.","poem":1},{"lineBreak":true},{"text":"Toɠa ná-masa kpɔkpɔgi zeini seeluɓɛinti unda,","poem":1},{"lineBreak":true},{"text":"zooi ɠa ɲiikpisu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɠɔoɠɔ GALAGI wɔɔlɔʋɛ Siyɔn,","poem":1},{"lineBreak":true},{"text":"buzeɠeʋɛ gola, é zei nuɓusɛiti kpein unda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuɓusɛiti pɛ ti maamusɛ, tɔ ɠa é ga GALA golai, maayikiai,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ɲadegɛ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti è-zɛbɛi maamusɛ, masagi nii telebodai nɛai bɛ!","poem":1},{"lineBreak":true},{"text":"Ungo, ɗa ɠa è sɔle faiti seiɗai kpasu,","poem":1},{"lineBreak":true},{"text":"è telebogi ta faa zɔlegai zei Izilayɛle zaama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À ada-ƓALAGI, Ɠɔoɠɔ GALAGI ná-bɔɔlɔlai ɠula kɛlɛma,","poem":1},{"lineBreak":true},{"text":"à nɔkɔ bu, ná-kɔɠɔloma anii ɠakala,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ ɲadegɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moize ta Aalɔn, ti ɠɛni ga ná-zalaɠa ɠula nuiti,","poem":1},{"lineBreak":true},{"text":"Samiyɛle ɠɛni naati saama, niiti ti ɠɛni wooɠulazu ma,","poem":1},{"lineBreak":true},{"text":"ti wooɠulani Ɠɔoɠɔ GALAGI ma, é ti wooɠaaʋoteni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"É yɛni tonaɓiingi zu, é ɓɔɛ ti ʋɔ,","poem":1},{"lineBreak":true},{"text":"ti ná-tɔgiti soni ta ná-deveiti, niiti é ti veeni ti ya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ee, Ɠɔoɠɔ GALAGI, gá-ƓALAGI, ɗa ɠa è ti wooɠaaʋoteni,","poem":1},{"lineBreak":true},{"text":"è ɠɛ ti ʋɛ ga maavaayɛ bo GALAGI,","poem":1},{"lineBreak":true},{"text":"kɛlɛ è ti loɠani ta-vaa ɲɔiti faa zu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À Ɠɔoɠɔ GALAGI ná-bɔɔlɔlai ɠula kɛlɛma, ada-ƓALAGI,","poem":1},{"lineBreak":true},{"text":"à nɔkɔ bu, ná-gize ɲadegai ma!","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ ɲadegɛ, Ɠɔoɠɔ GALAGI, da-ƓALAGI!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}