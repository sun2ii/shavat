{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"SNG","translationId":"tod_pbt","name":"Guyei Pagai Guyei Pɛ Ba","commonName":"Guyei Pagai Guyei Pɛ Ba","title":"Guyei Pagai Guyei Pɛ Ba","order":22,"numberOfChapters":8,"sha256":"b79c1ac04183b3c8bc8a5edea9a2d588f781bd98fb4fa13977f1aeef14b77c5e","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tod_pbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Nà ga tufai, nii é ʋuazu Salon nɛmɛi zu,","poem":1},{"lineBreak":true},{"text":"nà ga pɛtu su wulɛgi.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ʋelei bulɛgi a ɗa ɠɛ la ɠaingiti saama,","poem":1},{"lineBreak":true},{"text":"ʋele ɠana zìima anzanui la anzalopoiti saama.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ʋelei nɔ pɔme gului la dɔɓɔ wuluiti saama,","poem":1},{"lineBreak":true},{"text":"ʋele ɠana nɛ̀ɛbɛ nui la zinipoiti saama.","poem":1},{"lineBreak":true},{"text":"Nɛɛʋɛ bɛ̀ ga gè zei ná-niinigi wu,","poem":1},{"lineBreak":true},{"text":"gaawaai nɛɛʋɛ dàaʋɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"É lɛa ga ze fɛti ɠula ʋɛlɛi wu,","poem":1},{"lineBreak":true},{"text":"ná-poogi é màazu, naa ɠa ga nɛɛbɛi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À kɔ̀nɔkula ga leezɛn vɔɔiti, nii a kɛ gè zɛbɛ zɔlɔɔ,","poem":1},{"lineBreak":true},{"text":"à kɔ̀da yɛɓɛ ga pɔmegiti, gè gaaɓaa zɔlɔɔ,","poem":1},{"lineBreak":true},{"text":"tɔɔzei gè zeeɓɛa ga nɛɛbɛi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɔʋɛzu ʋele yeei ɠa é daazu nɔ̀ungi wu,","poem":1},{"lineBreak":true},{"text":"é zeezai velevele mà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zeluzalɛme anzalopoiti, nà wo maanɛɛnɛzu","poem":1},{"lineBreak":true},{"text":"dopaiti ta goegiti daaseigi zu, ti dɔɓɔi zu:","poem":1},{"lineBreak":true},{"text":"À mina nɛɛbɛi maaloɠa,","poem":1},{"lineBreak":true},{"text":"à mina maaloɠa, aisa é ʋa nɛɛ bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À woilo dɛɛ, nɛ̀ɛbɛ nui wooi ɠanu, é lɛɛzu,","poem":1},{"lineBreak":true},{"text":"tɔ ɠanu é ʋaazu ga ɓudɛa gize goiti ta gize wolaiti maazu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɛ̀ɛbɛ nui ɠulaʋɛ ga dopai ɓaa goe ziʋoi.","poem":1},{"lineBreak":true},{"text":"Wɛlɛ ba loni gá-zasai ʋoluʋɛ,","poem":1},{"lineBreak":true},{"text":"é ɗa wɛlɛ gá-venɛtɛlɛ laaʋɛti.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɛ̀ɛbɛ nui ɓɔɛ pɔ̀, é ɠɛ mà:","poem":1},{"lineBreak":true},{"text":"«Wuzeɠe, zìima anzanui, nà-nu ʋagɔi, ʋa!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Samai leʋega,","poem":1},{"lineBreak":true},{"text":"tonai looɠoga, é leʋega.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zooi zu ná pɛ tufaiti ti ʋua,","poem":1},{"lineBreak":true},{"text":"guye loo ziɛgi zeelia.","poem":1},{"lineBreak":true},{"text":"Nu kpumagoi wooi mɛnisu,","poem":1},{"lineBreak":true},{"text":"é ɗa guyei loo ada-yooi zu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kooleɠoole gwaaiti ti ɗa ɓɔi niina ti-ma wuluiti ga,","poem":1},{"lineBreak":true},{"text":"leezɛn ɓeleiti ti teʋea,","poem":1},{"lineBreak":true},{"text":"ti-maku nɛɛnɛgi ɗa ɠula.","poem":1},{"lineBreak":true},{"text":"Wuzeɠe, zìima anzanui, nà-nu ʋagɔi, ʋa!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɗɛi è ga nà-poopo kolegi,","poem":1},{"lineBreak":true},{"text":"è-laɠagi logai fasa yeɠeiti su,","poem":1},{"lineBreak":true},{"text":"ta ada zɛlɛgiti ma lɔɔɠuzuʋɛti.","poem":1},{"lineBreak":true},{"text":"Ɠaazuʋɛ ɠula lɛɛ, gè è-ɠaazuʋɛ ɠa,","poem":1},{"lineBreak":true},{"text":"ta gè è woomɛni,","poem":1},{"lineBreak":true},{"text":"mazɔlɔɔ è-wooi wola nɛɛʋɛ,","poem":1},{"lineBreak":true},{"text":"è-ɠaazuʋɛ wola ʋagai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«À wansai niiti so dɛɛ gi ʋɛ,","poem":1},{"lineBreak":true},{"text":"wansa yiʋoi niiti,","poem":1},{"lineBreak":true},{"text":"tiya ɠa ti faa zuɠoloɠologi ɠɛɛzu gá-leezɛn ɓeleiti su,","poem":1},{"lineBreak":true},{"text":"tama naati ti teʋea.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nɛ̀ɛbɛ nui ɠa zèema,","poem":1},{"lineBreak":true},{"text":"nà ɓalaa gè ɠɛ zeema,","poem":1},{"lineBreak":true},{"text":"toɠa ná-baalagiti kɔnɔkulazu bulɛgiti saama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kpɔkɔ ɠaalɛilɛigi ɠa zeelina,","poem":1},{"lineBreak":true},{"text":"niinigiti su ɠa wɔɔlɔna,","poem":1},{"lineBreak":true},{"text":"ɠale ma, nɛ̀ɛbɛ nui, è ʋa,","poem":1},{"lineBreak":true},{"text":"veɠa ɓɔɠɔ ma,","poem":1},{"lineBreak":true},{"text":"eɠɛ dopai ɓaa goe ziʋoi a ɠɛ ada zɛlɛgiti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}