{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"SNG","translationId":"tod_pbt","name":"Guyei Pagai Guyei Pɛ Ba","commonName":"Guyei Pagai Guyei Pɛ Ba","title":"Guyei Pagai Guyei Pɛ Ba","order":22,"numberOfChapters":8,"sha256":"b79c1ac04183b3c8bc8a5edea9a2d588f781bd98fb4fa13977f1aeef14b77c5e","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tod_pbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Zɛ̀gɛ laani nà-betei zu kpidii,","poem":1},{"lineBreak":true},{"text":"gè ɗa zìima nui ɠaiziɛ,","poem":1},{"lineBreak":true},{"text":"gè gaiziɛʋɛ, kɛlɛ gè la kaani.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gè ɠɛni ɓɔɠɔ ma: «Nà wuzeɠezu mu, gè taai lati,","poem":1},{"lineBreak":true},{"text":"gè leʋe koi yɔɠɔzuʋɛti, ta maaɓɔ bosuʋɛti,","poem":1},{"lineBreak":true},{"text":"gè zìima nui ɠaiziɛ.»","poem":1},{"lineBreak":true},{"text":"Gè gaiziɛni, kɛlɛ gè la kaani.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gi ɠomini gá taa makɛ nuiti,","poem":1},{"lineBreak":true},{"text":"ti ɗa lati taai ma.","poem":1},{"lineBreak":true},{"text":"Gè ti ɠaazaɠani ga:","poem":1},{"lineBreak":true},{"text":"«Wo la zìima nui ɠaani bɛ̀?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gè leʋeni nɔ ti ʋa feya,","poem":1},{"lineBreak":true},{"text":"gè zìima nui ɠa.","poem":1},{"lineBreak":true},{"text":"Gè soni zeei ʋa,","poem":1},{"lineBreak":true},{"text":"gè la mɔ ɓeni ba pɛ,","poem":1},{"lineBreak":true},{"text":"eyɛsu gè lɛɛ la","poem":1},{"lineBreak":true},{"text":"sɔ̀lɔɔ deei ná-pɛlɛi wu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zeluzalɛme anzalopoiti, nà wo maanɛɛnɛzu","poem":1},{"lineBreak":true},{"text":"dopaiti ta goegiti daaseigi zu, ti dɔɓɔi zu:","poem":1},{"lineBreak":true},{"text":"À mina nɛɛbɛi maaloɠa,","poem":1},{"lineBreak":true},{"text":"à mina maaloɠa, aisa é ʋa nɛɛ bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɓɛ ɠanu, é ɠulazu teʋebai zu,","poem":1},{"lineBreak":true},{"text":"é ɗa lɛ eɠɛ abu luulu,","poem":1},{"lineBreak":true},{"text":"makugi nɛai eɠɛ miilegi,","poem":1},{"lineBreak":true},{"text":"naa ʋɛɛ ansansegi ma zii pɛ ba?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Salomɔn laa ʋetei ʋe,","poem":1},{"lineBreak":true},{"text":"maaɠakugai ga zɛbɛsu nu ʋuulɔzita (60),","poem":1},{"lineBreak":true},{"text":"Izilayɛle zɛbɛsu nuiti saama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Boɠa zɔkpɔi ɠa ti pɛ zea,","poem":1},{"lineBreak":true},{"text":"ti ɠalagai ga kɔɔi.","poem":1},{"lineBreak":true},{"text":"Ɛsɛ saamaɠiliʋɛ ga ná-kɔɔɠɔ zɔɔla,","poem":1},{"lineBreak":true},{"text":"kpidii zu vaaɓaagiti daalɔɠɔma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ti Salomɔn zeɠe ɓɔkpɔgi ɓɛtɛʋɛ","poem":1},{"lineBreak":true},{"text":"ga Liɓan wului.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ti ma ɓɛdɛgiti kpɛtɛʋɛ ga walii,","poem":1},{"lineBreak":true},{"text":"tiɓisuʋɛ ɠɛ ga zanugi,","poem":1},{"lineBreak":true},{"text":"ti seɠe ɓɔkpɔgi ɓɛtɛ ga zalama zeɠei,","poem":1},{"lineBreak":true},{"text":"Zeluzalɛme anzalopoiti ti suʋu ga nɛɛbɛi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ee, Zeluzalɛme anzalopoiti, à ɠula,","poem":1},{"lineBreak":true},{"text":"wo masagi Salomɔn ɠa, masa bɔɔlɔgi unma,","poem":1},{"lineBreak":true},{"text":"nii dee dɔɔni unma, ná-vulu ɠɛɛ voloi,","poem":1},{"lineBreak":true},{"text":"yeei koozunɛɛi ziimaʋɛ pɛ daaveni la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}