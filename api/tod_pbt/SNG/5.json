{"translation":{"id":"tod_pbt","name":"GALA Daawoo Zɛʋɛi","website":"https://ebible.org/Scriptures/details.php?id=tod","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tod","licenseNotes":null,"shortName":"PBT","englishName":"Toma Bible Portions","language":"tod","textDirection":"ltr","sha256":"17139a85725e2b016f500f66985320fe447173d2141b828ae9ad5feb5a8d6b2a","availableFormats":["json"],"listOfBooksApiLink":"/api/tod_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31170,"languageName":"Toma","languageEnglishName":"Toma"},"book":{"id":"SNG","translationId":"tod_pbt","name":"Guyei Pagai Guyei Pɛ Ba","commonName":"Guyei Pagai Guyei Pɛ Ba","title":"Guyei Pagai Guyei Pɛ Ba","order":22,"numberOfChapters":8,"sha256":"b79c1ac04183b3c8bc8a5edea9a2d588f781bd98fb4fa13977f1aeef14b77c5e","firstChapterNumber":1,"firstChapterApiLink":"/api/tod_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tod_pbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Nà ga lɔ nà-kpelei zu,","poem":1},{"lineBreak":true},{"text":"ee, anzalopoi, ɗɛi è ga ànza ɓeai,","poem":1},{"lineBreak":true},{"text":"gè nà-miilegi ɠula ta tufa maku nɛɛnɛgiti,","poem":1},{"lineBreak":true},{"text":"gè nà-kɔin sɛpɛgi mi, ta ma wulɔi,","poem":1},{"lineBreak":true},{"text":"gè nà-dɔɔi ta nà-nɔnɔi ɓɔle.","poem":1},"(Bɔɔlamaiti)",{"text":"Bɔ̀ɔlaiti, à daami wo, wo ɓɔɔle.","poem":1},{"lineBreak":true},{"text":"Nɛɛbɛ nu felegɔiti, à dɔɔi ɓɔle, é wo zo.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Gè ɠɛa ɲiizu, kɛlɛ zìi ɠɛa ɠaazu ɠa,","poem":1},{"lineBreak":true},{"text":"gè nɛ̀ɛbɛ nui woomɛni,","poem":1},{"lineBreak":true},{"text":"é ɗa pɛlɛi laaloɠa, é ɗa ɠɛ mà:","poem":1},{"lineBreak":true},{"text":"«Pɛlɛi laalao, anzalopoi, zìima anzanui,","poem":1},{"lineBreak":true},{"text":"nà-poopo kolegi, ɗɛi è ɠaavɔnigai.","poem":1},{"lineBreak":true},{"text":"Mazɔlɔɔ nɔ̀ungi yɛɓɛa ga duɓui,","poem":1},{"lineBreak":true},{"text":"kpidi ɗɛ ɠilagilagi é ʋilɛsu,","poem":1},{"lineBreak":true},{"text":"naa nɔ̀undeɠaiti zɛɓɛa.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gè nà-seɠei ɠulaa ɠɔba,","poem":1},{"lineBreak":true},{"text":"nà too ɠale ʋolu?","poem":1},{"lineBreak":true},{"text":"Gè kɔ̀ɠɔiti maagbaa,","poem":1},{"lineBreak":true},{"text":"nà ti nɔɠɔzu ɠale ʋolu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nɛ̀ɛbɛ nui ɠa yeeleʋesu fenɛtɛlɛ laaʋɛ,","poem":1},{"lineBreak":true},{"text":"kɔɔlɛ ɓooi ɗa yei ga ze.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gè wuzeɠea ga gè pɛlɛi laalao nɛ̀ɛbɛ nui ʋɛ,","poem":1},{"lineBreak":true},{"text":"miile gulɔ maku nɛɛnɛgi yeiɗa zèei ta zèeɓeɠaiti zɔɠɔzuʋɛti,","poem":1},{"lineBreak":true},{"text":"gè ɗa pɛɛ sɔɠɔgi ʋa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gè pɛlɛi laalaoga nɛ̀ɛbɛ nui luɠɔ,","poem":1},{"lineBreak":true},{"text":"kɛlɛ é lia, é la mɔ ná,","poem":1},{"lineBreak":true},{"text":"gè ɠɛ unga wuulee.","poem":1},{"lineBreak":true},{"text":"Gè ɠulani gaiziɛ vai ma, kɛlɛ gè la kaani.","poem":1},{"lineBreak":true},{"text":"Gè ta nɔ lolini, é la gòoɠaaʋoteni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gi ɠomini gá taa makɛ nuiti,","poem":1},{"lineBreak":true},{"text":"ti ɗa lati taai ma.","poem":1},{"lineBreak":true},{"text":"Ti dòɠani, ti màawana,","poem":1},{"lineBreak":true},{"text":"ti nà-pɛɛkɔmai ɠula zèa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee, Zeluzalɛme anzalopoiti, nà wo ɠaazaɠasu:","poem":1},{"lineBreak":true},{"text":"Wa nɛ̀ɛbɛ nui ɠaana, leeni ɠa wo bosu ma?","poem":1},{"lineBreak":true},{"text":"À ɠɛ ma nɛɛbɛ zeeɓɛi ɠa é bà.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Bo dɛɛ gi ma, ɗɛi è ʋagai anzaa zaama,","poem":1},{"lineBreak":true},{"text":"leeni ɠa é è nɛɛbɛ nui ya, é la taɠili zea?","poem":1},{"lineBreak":true},{"text":"Gaamazu, lee ɓa ka é è nɛɛbɛ nui ya, é la taɠili zea,","poem":1},{"lineBreak":true},{"text":"è gi ɠaazaɠasu ga niima laali?","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Nɛ̀ɛbɛ nui lɔtɔʋɛ, kɛdɛgɛ,","poem":1},{"lineBreak":true},{"text":"ʋili nɔpɛ ge la ma,","poem":1},{"lineBreak":true},{"text":"anɛɛ nu waapuugɔ (10.000) zaama.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɔungi ɠulaʋɛ ga zanu kitei,","poem":1},{"lineBreak":true},{"text":"nɔundeɠai ʋɛɛni ma fɛlɛɓɛɓɛ,","poem":1},{"lineBreak":true},{"text":"nɔundeɠa lɛiɗai eɠɛ kalawɔni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gaazuɠɛzɛiti kulaʋɛ ga poopo kolegiti ti ziɛi laaʋɛ,","poem":1},{"lineBreak":true},{"text":"ti ɗa maagba ga nɔnɔi,","poem":1},{"lineBreak":true},{"text":"ti ɗa ɲi kpɛtɛi zaama.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Komagiti kɛɛʋɛ eɠɛ tufa maku nɛɛnɛ kpelei,","poem":1},{"lineBreak":true},{"text":"ti-maku nɛɛnɛgi ɗa ɠula.","poem":1},{"lineBreak":true},{"text":"Dakɔlɔgiti ta ga bulɛgiti,","poem":1},{"lineBreak":true},{"text":"ʋɛ miilegi ɠulazu ná.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zeeɓeɠaiti kɛɛʋɛ eɠɛ zanu balaɠaegiti,","poem":1},{"lineBreak":true},{"text":"daavegai ga kɔtu zɔngɔ ɓaagiti.","poem":1},{"lineBreak":true},{"text":"Kpusɛi ɠɛ eɠɛ see ɲiiga zɛpɛgi,","poem":1},{"lineBreak":true},{"text":"nii doungai ga kɔtu ɓiinii.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɔɠɔiti kulaʋɛ ga kɔtu ɠole kpɛdɛgi,","poem":1},{"lineBreak":true},{"text":"nii kpadɔai zanugi ma.","poem":1},{"lineBreak":true},{"text":"Maayikiai eɠɛ Liɓan ɠize ɲɛkpɛi,","poem":1},{"lineBreak":true},{"text":"sulogai eɠɛ sɛdele guluiti.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Daa ɠoozuʋɛ nɛɛʋɛ gola,","poem":1},{"lineBreak":true},{"text":"kpusɛi pɛ ge ɛ̀nɛkɛga.","poem":1},{"lineBreak":true},{"text":"Ee, Zeluzalɛme anzalopoiti,","poem":1},{"lineBreak":true},{"text":"gaamazu, ʋele ɠana nɛ̀ɛbɛ nui la,","poem":1},{"lineBreak":true},{"text":"ʋele ɠana zìima nui la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tod_pbt/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tod_pbt/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tod_pbt/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}