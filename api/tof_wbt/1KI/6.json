n","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tof_wbt/1KI/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tof_wbt/1KI/5.json","previousChapterAudioLinks":{},"numberOfVerses":5}