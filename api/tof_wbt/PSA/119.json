{"translation":{"id":"tof_wbt","name":"Godón Buk","website":"https://ebible.org/Scriptures/details.php?id=tof","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tof","licenseNotes":null,"shortName":"WBT","englishName":"Gizrra Bible","language":"tof","textDirection":"ltr","sha256":"08fa8caede230158d8f0dade441a2e378a526892ee8fb5af1ef85023edea6850","availableFormats":["json"],"listOfBooksApiLink":"/api/tof_wbt/books.json","numberOfBooks":40,"totalNumberOfChapters":332,"totalNumberOfVerses":8925,"languageName":"Gizrra","languageEnglishName":"Gizrra"},"book":{"id":"PSA","translationId":"tof_wbt","name":"Wórr Peba","commonName":"Wórr Peba","title":"Godón Agür Wórr Peba 23:1-6; 95:1-11; 110:1-7; 119:9-16","order":19,"numberOfChapters":4,"sha256":"18ee38798289f1818f5dd77024db50bfb9fcc3b550f09569aba9eec63cb8f8b1","firstChapterNumber":23,"firstChapterApiLink":"/api/tof_wbt/PSA/23.json","lastChapterNumber":119,"lastChapterApiLink":"/api/tof_wbt/PSA/119.json","totalNumberOfVerses":32},"chapter":{"number":119,"content":[{"type":"heading","content":["⌊Lodón⌋ Gida Arrkrru Morroal Klama"]},{"type":"verse","number":9,"content":[{"text":"Ia küsil pama ⌊kolkal⌋ ia ngyaben yarile?","poem":1},{"text":"Wata wa marü bóktan ngarkwatódó ngyaben yarile!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka marü amkoman moboküpi mamoan namulo.","poem":1},{"text":"Kürü tangkamti, marü gida bóktan poko alkomólgum.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ka marü bóktan kólba moboküpdü kuri gangga irrbüna,","poem":1},{"text":"marüka kolae tonarr tónggapón-gum.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lodóe, ka marü agürdóla.","poem":1},{"text":"Kürü moba ngyaben gida bóktan umul kyó.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kürü taea sab marü ene gida bóktan blaman tonarr arük yarile,","poem":1},{"text":"marü taedógab ne gida bóktana bausdako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ka bagürwómdóla, ka marü bóktan ngarkwatódó nóma ngyabendóla,","poem":1},{"text":"pamazan bagürwómda tóba mórrelanbókamde.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ka marü arüng bóktan metat gyagüpi amandóla,","poem":1},{"text":"ka marü ngyaben bóktan tai ngabkandóla metat.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ka kari ubi kokela marü ngyaben gida bóktan amorranóm,","poem":1},{"text":"akó ka sab marü bóktan kokean ngómkó nómkónónómo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tof_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tof_wbt/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tof_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":8}