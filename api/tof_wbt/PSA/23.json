{"translation":{"id":"tof_wbt","name":"Godón Buk","website":"https://ebible.org/Scriptures/details.php?id=tof","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tof","licenseNotes":null,"shortName":"WBT","englishName":"Gizrra Bible","language":"tof","textDirection":"ltr","sha256":"08fa8caede230158d8f0dade441a2e378a526892ee8fb5af1ef85023edea6850","availableFormats":["json"],"listOfBooksApiLink":"/api/tof_wbt/books.json","numberOfBooks":40,"totalNumberOfChapters":332,"totalNumberOfVerses":8925,"languageName":"Gizrra","languageEnglishName":"Gizrra"},"book":{"id":"PSA","translationId":"tof_wbt","name":"Wórr Peba","commonName":"Wórr Peba","title":"Godón Agür Wórr Peba 23:1-6; 95:1-11; 110:1-7; 119:9-16","order":19,"numberOfChapters":4,"sha256":"18ee38798289f1818f5dd77024db50bfb9fcc3b550f09569aba9eec63cb8f8b1","firstChapterNumber":23,"firstChapterApiLink":"/api/tof_wbt/PSA/23.json","lastChapterNumber":119,"lastChapterApiLink":"/api/tof_wbt/PSA/119.json","totalNumberOfVerses":32},"chapter":{"number":23,"content":[{"type":"heading","content":["⌊Lod⌋ Kürü Ngakan Pama"]},{"type":"heading","content":["Darrü ⌊Deibidün⌋ Wórr"]},{"type":"verse","number":1,"content":[{"text":"Lod kürü ngakan pama, kürü wató alngomólda; Ka igósidi darrü kla koke arendóla.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Wa kürü morroal mórrel bwóbdü mórran-mórran ainda.","poem":2},"Sip ngakan omokur Deibid ap apulda.",{"text":"Wa kürü alngomólda morroal piküp güb arób naedó.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Wa kürü küsil arüng akyanda.","poem":2},{"text":"Wa kürü dümdüm kwatódóma alngomólda,","poem":1},{"text":"tóba morroal ngianme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enana ka agóltagóldóla güm algón-koke tümün kwatódóma,","poem":1},{"lineBreak":true},{"text":"kürü kolaedó gum babula,","poem":1},{"text":"zitülkus ma kankü asinla.","poem":2},{"text":"Marü bidam wóp akó tupuru,","poem":1},{"text":"kürü ini nis klama adlangdamli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ma kürünkü alongalo tóre tónggapóna,","poem":1},{"text":"kürü gómdamal-koke nidipko, ibü wapi;","poem":2},{"text":"Ma kürü singül ⌊olib⌋ oele kóngangoa, kürü morroal apadóm,","poem":1},{"text":"marüme, kürü kübüla byamróke tai kókó ib.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amkoman, marü morroal tonarr akó gyaur sab kürüka asi namüli","poem":1},{"text":"kürü ngyabendó,","poem":2},{"lineBreak":true},{"text":"akó ka sab Lodón Müótüdü ngyaben namulo metat.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tof_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tof_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tof_wbt/2CH/36.json","previousChapterAudioLinks":{},"numberOfVerses":6}