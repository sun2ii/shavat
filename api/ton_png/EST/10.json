{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"EST","translationId":"ton_png","name":"Eseta","commonName":"Eseta","title":"KO E TOHI ʻA ESETA","order":17,"numberOfChapters":10,"sha256":"305c646dd1ae4d6d0794d5f2d5fd6e1fb89ad4a10fb65eab94e2b94e6a28a1df","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/ton_png/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Pea naʻe fokotuʻu ʻe ʻAhasivelo ʻene fekau ke tukuhau ʻae fonua, pea mo e ngaahi motu ʻoe tahi."]},{"type":"verse","number":2,"content":["Pea ko e ngaahi ngāue ʻo ʻene mālohi mo ʻene mafai, mo hono fakahā ʻae lahi ʻo Motekiai, ʻaia naʻe fakahikihiki ia ki ai ʻe he tuʻi, ʻikai kuo tohi ia ʻi he tohi fakamatala ki he ngaahi tuʻi ʻo Mitia mo Peasia?"]},{"type":"verse","number":3,"content":["He naʻe hoko ʻa Motekiai ko e Siu mo e tuʻi ko ʻAhasivelo, pea naʻe lahi ia ʻi he ʻao ʻae kakai Siu, pea naʻe maʻu lelei ia ʻe he fuʻu tokolahi ʻo hono kāinga, naʻe kumi ʻe ia ke koloaʻia ʻa hono kakai, pea naʻa ne lea fakamelino ki hono hako kotoa pē."]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}