{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"‌ʻOku monūʻia ʻae tangata ʻoku ʻikai ʻeveʻeva ʻi he fakakaukau ʻae angakovi,","poem":1},{"text":"pe tuʻu ʻi he hala ʻoe kau angahala,","poem":2},{"lineBreak":true},{"text":"pe nofo ʻi he nofoʻa ʻoe manuki.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ka ko ʻene fiefia ʻoku ʻi he fono ʻa Sihova;","poem":1},{"text":"pea ko ʻene fono ʻoku ne fakalaulauloto ai ʻi he ʻaho mo e pō.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pea ʻe tatau ia mo e ʻakau kuo tō ki he veʻe vaitafe,","poem":1},{"text":"ʻaia ʻoku ʻomi hono fua ʻi hono faʻahitaʻu;","poem":2},{"lineBreak":true},{"text":"pea ko hono lau foki ʻe ʻikai mae;","poem":2},{"lineBreak":true},{"text":"pea ko ia kotoa pē ʻoku ne fai ʻe monūʻia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‌ʻOku ʻikai pehē ʻae angakovi:","poem":1},{"text":"ka ʻoku tatau ia mo e kafukafu ʻaia ʻoku vilingia, ʻi he matangi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko ia ʻe ʻikai tuʻu ʻae angakovi ʻi he fakamaau,","poem":1},{"text":"pe ko e angahala ʻi he fakataha ʻoe māʻoniʻoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He ʻoku ʻilo ʻe Sihova ʻae hala ʻoe māʻoniʻoni:","poem":1},{"text":"ka ko e hala ʻoe angakovi ʻe ʻauha ia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}