{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Ki he Takimuʻa, ko e Saame ʻa Tevita."]},{"type":"verse","number":1,"content":[{"text":"‌ʻOku ou falala kia Sihova:","poem":1},{"text":"pea ʻoku fēfē hoʻomou pehē ki hoku laumālie, “Puna ʻo hangē ko e manu ki ho moʻunga?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He ʻoku teke ʻe he angahala ʻenau kaufana,","poem":1},{"text":"ʻoku nau ʻai ʻenau ngaahi ngahau ki he uka,","poem":2},{"lineBreak":true},{"text":"koeʻuhi ke nau fana fakafufū pē ki he angatonu ʻi loto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kapau ʻe ʻauha ʻae ngaahi tuʻunga,","poem":1},{"text":"ko e hā ʻe faʻa fai ʻe he kakai māʻoniʻoni?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‌ʻOku ʻi hono fale māʻoniʻoni ʻa Sihova,","poem":1},{"text":"ko e ʻafioʻanga ʻa Sihova ʻoku ʻi he langi:","poem":2},{"lineBreak":true},{"text":"ʻoku ʻafioʻi ʻe hono fofonga,","poem":2},{"lineBreak":true},{"text":"ʻoku ʻahiʻahiʻi ʻe hono lauʻifofonga,","poem":2},{"lineBreak":true},{"text":"ʻae ngaahi fānau ʻae tangata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku ʻahiʻahi ʻe Sihova ʻae māʻoniʻoni:","poem":1},{"text":"ka ko e angakovi mo ia ʻoku manako ki he fakamālohi ʻoku fehiʻa hono laumālie ki ai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Te ne fakaʻauha ki he ngaahi angahala ʻae ngaahi tauhele,","poem":1},{"text":"ko e afi, mo e sulifa, mo e afā fakailifia ʻaupito: ko e ʻinasi ia ʻo ʻenau ipu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He ʻoku ʻofa ʻa Sihova ko e māʻoniʻoni ki he māʻoniʻoni;","poem":1},{"text":"ʻoku ʻafio ʻe hono fofonga ki he angatonu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}