{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Mou fakamālō kia Sihova.","poem":1},{"text":"Fakamālō, ʻakimoutolu ko e kau tamaioʻeiki ʻa Sihova,","poem":2},{"lineBreak":true},{"text":"fakamālō ki he huafa ʻo Sihova.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fakafetaʻi ki he huafa ʻo Sihova mei he ʻaho ni ʻo taʻengata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ke fakamālō ki he huafa ʻo Sihova, mei he hopo hake ʻoe laʻā ʻo aʻu ki heʻene tō hifo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"‌ʻOku māʻolunga hake ʻa Sihova ʻi he ngaahi puleʻanga kotoa pē, mo hono nāunau ʻoku māʻolunga hake ʻi he ngaahi langi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko hai ʻoku na tatau mo Sihova ko hotau ʻOtua, ʻaia ʻoku ʻafio ʻi ʻolunga,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"‌ʻOku ne fakamoʻulaloaʻi ia ke ʻafio ki he ngaahi meʻa ʻoku ʻi he langi, pea mo māmani!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"‌ʻOku ne fokotuʻu hake ʻae masiva mei he efu,","poem":1},{"text":"mo ne hiki hake ʻae paea mei he tuʻunga ʻotoʻota;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Koeʻuhi ke ne fakataha mo e ngaahi ʻeiki,","poem":1},{"text":"pea ke kautaha mo e houʻeiki ʻo hono kakai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‌ʻOku ne ngaohi ʻae fefine paʻa ke tauhi ʻae fale,","poem":1},{"text":"pea ke hoko ʻi he fiefia ko e faʻē ʻae fānau.","poem":2},{"lineBreak":true},{"text":"Mou fakamālō kia Sihova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}