{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"‌ʻI he ʻalu atu ʻa ʻIsileli mei ʻIsipite,","poem":1},{"text":"ko e fale ʻo Sēkope mei he kakai ʻoe lea kehe;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ko hono faletapu ʻa Siuta,","poem":1},{"text":"mo hono puleʻanga ʻa ʻIsileli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naʻe mamata ki ai ʻae tahi, pea hola ai:","poem":1},{"text":"naʻe tekeʻi atu ʻo fakaholomui ʻa Sioatani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naʻe hopohopo ʻae ngaahi moʻunga ʻo hangē ko e fanga sipitangata,","poem":1},{"text":"mo e ngaahi foʻi moʻunga ʻo hangē ko e fanga lami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko e hā naʻe hoko kiate koe, ʻa koe ko e tahi, koeʻuhi naʻa ke hola ai?","poem":1},{"text":"ʻA koe Sioatani, koeʻuhi ke tekeʻi atu ʻo fakaholomui koe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"‌ʻAe ngaahi moʻunga, koeʻuhi naʻa mou hopohopo ai ʻo hangē ko e fanga sipitangata;","poem":1},{"text":"mo kimoutolu ʻae ngaahi foʻi moʻunga, ʻo hangē ko e fanga lami?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‌ʻA koe ko māmani, ke ke tetetete ʻi he ʻao ʻoe ʻEiki,","poem":1},{"text":"ʻi he ʻao ʻoe ʻOtua ʻo Sēkope;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‌ʻAia naʻa ne liliu ʻae maka ko e anovai,","poem":1},{"text":"mo e maka afi ko e matavai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}