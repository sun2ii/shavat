{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Ko e Hiva ʻae ʻalu hake."]},{"type":"verse","number":1,"content":[{"text":"Naʻaku tangi kia Sihova ʻi heʻeku mamahi,","poem":1},{"text":"pea naʻa ne ongoʻi au.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‌ʻE Sihova, fakahaofi hoku laumālie mei he loungutu loi,","poem":1},{"text":"pea mei he ʻelelo kākā.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko e hā ʻe ʻatu kiate koe?","poem":1},{"text":"He ko e hā ʻe fai kiate koe, ʻa koe ko e ʻelelo kākā?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‌ʻAe ngaahi ngahau māsila ʻae tangata mālohi,","poem":1},{"text":"mo e ngaahi malalaʻi afi ʻoe sunipa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku ou malaʻia, ko e meʻa ʻi heʻeku ʻāunofo ʻi Meseki,","poem":1},{"text":"koeʻuhi ko ʻeku nofo ʻi he ngaahi fale fehikitaki ʻo Keta!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuo nofo ʻo fuoloa ʻa hoku laumālie","poem":1},{"text":"fakataha mo ia ʻoku ne fehiʻa ki he melino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‌ʻOku ou loto ki he melino:","poem":1},{"text":"ka ʻi heʻeku lea ʻoku nau fie tau.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}