ālie,","poem":1},{"text":"pea mo e fehiʻa ʻae fielahi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}