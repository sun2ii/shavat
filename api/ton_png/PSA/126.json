{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Ko e Hiva ʻae ʻalu hake."]},{"type":"verse","number":1,"content":[{"text":"‌ʻI he toe liliu ʻe Sihova ʻae pōpula ʻo Saione,","poem":1},{"text":"naʻa tau tatau mo kinautolu ʻoku misi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pea naʻe toki fakapito ʻaki hotau ngutu ʻae kata,","poem":1},{"text":"mo hotau ʻelelo ʻi he hiva:","poem":2},{"lineBreak":true},{"text":"pea naʻe toki pehē ʻe he hiteni, “Kuo fai ʻe Sihova ʻae ngaahi meʻa lahi maʻanautolu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuo fai ʻe Sihova ʻae ngaahi meʻa lahi maʻatautolu;","poem":1},{"text":"pea ʻoku tau fiefia ai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‌ʻE Sihova, ke ke toe liliu ʻemau pōpula, ʻo hangē ko e ngaahi vaitafe ʻi he feituʻu tonga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ko kinautolu ʻoku tūtuuʻi ʻi he loʻimata te nau tuʻusi ʻi he fiefia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ko ia ʻoku ne ʻalu atu ʻo tangi, pea ʻave ʻae tenga mahuʻinga,","poem":1},{"text":"te ne toe haʻu ʻi he fiefia, mo ʻomi ʻene ngaahi ū uite fakataha mo ia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}