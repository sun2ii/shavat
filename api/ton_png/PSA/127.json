{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Ko e Hiva ʻae ʻalu hake maʻa Solomone."]},{"type":"verse","number":1,"content":[{"text":"Kapau ʻe ʻikai langa ʻe Sihova ʻae fale,","poem":1},{"text":"ʻoku taʻeʻaonga ʻae ngāue ʻanautolu ʻoku nau langa ia:","poem":2},{"lineBreak":true},{"text":"kapau ʻe ʻikai tauhi ʻe Sihova ʻae kolo,","poem":2},{"lineBreak":true},{"text":"ʻoku taʻeʻaonga ʻae ʻā ʻae tangata leʻo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‌ʻOku taʻeʻaonga hoʻomou tuʻu hake hengihengi pē,","poem":1},{"text":"mo nofo pē ʻo fuoloa ʻi he pō,","poem":2},{"lineBreak":true},{"text":"ke kai ʻae mā ʻoe mamahi:","poem":2},{"lineBreak":true},{"text":"he ʻoku ne foaki ʻae mohe ki heʻene pele.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vakai, ko e fānau ko e tofiʻa meia Sihova:","poem":1},{"text":"pea ko e fua ʻoe manāva ko ʻene totongi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hangē ko e ngaahi ngahau ʻi he nima ʻoe tangata mālohi;","poem":1},{"text":"ʻoku pehē ʻae fānau ʻae talavou.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku monūʻia ʻae tangata ʻaia ʻoku fonu ʻene hōfangahau ʻiate kinautolu:","poem":1},{"text":"ʻe ʻikai tenau mā, ka tenau lea ki he ngaahi fili ʻi he matapā.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}