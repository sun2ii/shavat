{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Ki he Takimuʻa, ko e Saame ʻa Tevita."]},{"type":"verse","number":1,"content":[{"text":"‌ʻE Sihova, ʻe fēfē hono fuoloa?","poem":1},{"text":"Mo hoʻo kei fakangalongaloʻi au? Ke taʻengata?","poem":2},{"lineBreak":true},{"text":"ʻE fēfē hono fuoloa ʻo hoʻo fufū ho fofonga ʻiate au?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‌ʻE fēfē hono fuoloa mo ʻeku lauloto mo hoku laumālie,","poem":1},{"text":"ʻo loto mamahi pē ʻi he ʻaho kotoa pē?","poem":2},{"lineBreak":true},{"text":"ʻE fēfē hono fuoloa mo e fielahi kiate au ʻa hoku fili?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‌ʻE Sihova ko hoku ʻOtua, ke ke tokanga mai pea ongoʻi au:","poem":1},{"text":"fakamaama hoku mata, telia naʻaku mohe ʻi he mohe ʻoe mate;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Telia naʻa pehē ʻe hoku fili, “Kuo u ikuna ia;”","poem":1},{"text":"pea fiefia ʻakinautolu ʻoku fakamamahiʻi au ʻo kau ka ngaue.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ka kuo u falala ki hoʻo ʻaloʻofa;","poem":1},{"text":"ʻo fiefia hoku loto ʻi hoʻo fakamoʻui.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Te u hiva kia Sihova,","poem":1},{"text":"ko e meʻa ʻi heʻene fai lelei lahi ʻaupito kiate au.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}