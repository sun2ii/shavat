{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Ko e Hiva ʻae ʻalu hake."]},{"type":"verse","number":1,"content":[{"text":"‌ʻE Sihova, naʻaku tangi kiate koe mei he ngaahi moana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"‌ʻE ʻEiki, ke ke ongoʻi hoku leʻo:","poem":1},{"text":"fakatokangaʻi ho fofonga ki he leʻo ʻo ʻeku ngaahi lotu tāumaʻu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kapau te ke fakaʻilonga, ʻE Sihova, ʻae ngaahi hia,","poem":1},{"text":"ʻE ʻEiki, ko hai ʻe faʻa tuʻu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ka ʻoku ʻiate koe ʻae fakamolemole,","poem":1},{"text":"koeʻuhi ke manavahē ai kiate koe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku ou tatali kia Sihova,","poem":1},{"text":"ʻoku tatali ʻa hoku laumālie,","poem":2},{"lineBreak":true},{"text":"pea ʻoku ou ʻamanaki lelei ki heʻene folofola.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"‌ʻOku tatali ʻa hoku laumālie kia Sihova ʻo lahi hake ʻiate kinautolu ʻoku nau leʻo ki he pongipongi:","poem":1},{"text":"ʻoku ou pehē, ʻo lahi hake ʻiate kinautolu ʻoku nau leʻo ki he pongipongi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ke ʻamanaki ʻa ʻIsileli kia Sihova:","poem":1},{"text":"he ʻoku ʻia Sihova ʻae ʻaloʻofa,","poem":2},{"lineBreak":true},{"text":"pea ʻoku ʻiate ia ʻae huhuʻi lahi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pea te ne huhuʻi ʻa ʻIsileli mei heʻene ngaahi hia kotoa pē.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}