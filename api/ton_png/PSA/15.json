{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["Ko e Saame ʻa Tevita."]},{"type":"verse","number":1,"content":[{"text":"‌ʻE Sihova, ko hai te ne nofo ʻi ho fale fehikitaki?","poem":1},{"text":"Ko hai te ne nofomaʻu ʻi ho moʻunga māʻoniʻoni?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ko ia ia ʻoku ʻeveʻeva ʻi he angatonu, pea ngāue ʻi he māʻoniʻoni,","poem":1},{"text":"mo lea ʻaki ʻae moʻoni ʻi hono loto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ko ia ʻoku ʻikai lauʻikovi ʻaki hono ʻelelo,","poem":1},{"text":"pe fai kovi ki hono kaungāʻapi,","poem":2},{"lineBreak":true},{"text":"pe toʻo hake ʻae lea kovi ki hono kaungāʻapi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‌ʻAia ʻoku kovi ki hono mata ʻae tangata fai kovi;","poem":1},{"text":"ka ʻoku ne fakaʻapaʻapa kiate kinautolu ʻoku manavahē kia Sihova.","poem":2},{"lineBreak":true},{"text":"ʻOku ne fuakava, pea kovi ai ia, ka ʻe ʻikai liliu ai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko ia ʻoku ʻikai ʻange ʻene ngaahi paʻanga koeʻuhi ko e totongi,","poem":1},{"text":"pe toʻo ʻe ia ʻae totongi ke fai kovi ki he māʻoniʻoni.","poem":2},{"lineBreak":true},{"text":"Ko ia ʻoku ne fai ʻae ngaahi meʻa ni ʻe ʻikai ueʻi ia ʻo taʻengata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}