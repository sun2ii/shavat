{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Ko e Saame ʻa Tevita."]},{"type":"verse","number":1,"content":[{"text":"Ko hoku tauhi ʻa Sihova;","poem":1},{"text":"ʻe ʻikai te u masiva.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‌ʻOku ne fakatokoto au ʻi he ngaahi ngoue lau maʻuiʻui:","poem":1},{"text":"ʻoku ne tataki au ki he veʻe vai ʻoku tafetafemālie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‌ʻOku ne fakamoʻui hoku laumālie:","poem":1},{"text":"ʻoku ne tataki au ʻi he ngaahi hala ʻoe māʻoniʻoni koeʻuhi ko hono huafa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‌ʻIo, neongo ʻeku ʻeveʻeva ʻi he teleʻa ʻoe malumalu ʻoe mate,","poem":1},{"text":"ʻe ʻikai te u manavahē ki ha kovi:","poem":2},{"lineBreak":true},{"text":"he ʻoku ke ʻiate au; ko hoʻo vaʻa ʻakau mo ho tokotoko ʻoku na fakafiemālieʻi au.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku ke teuteu ʻae keinangaʻanga maʻaku ʻi he ʻao ʻo hoku ngaahi fili:","poem":1},{"lineBreak":true},{"text":"ʻoku ke pani ʻaki hoku ʻulu ʻae lolo;","poem":1},{"text":"ʻoku fonu mahuohua ʻa ʻeku ipu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ko e moʻoni ʻe muimui ʻiate au ʻae lelei mo e ʻaloʻofa ʻi he ʻaho kotoa pē ʻo ʻeku moʻui:","poem":1},{"text":"pea te u nofo ʻi he fale ʻo Sihova ʻo lauikuonga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}