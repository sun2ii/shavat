{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"‌ʻE ʻOtua, ke ke fakamaau au, ʻo langomakiʻi au telia ʻae puleʻanga angakovi:","poem":1},{"text":"ke ke fakamoʻui au mei he tangata kākā mo taʻeangatonu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He ko koe ko e ʻOtua ʻo ʻeku mālohi: ko e hā ʻoku ke liʻaki ai au?","poem":1},{"text":"Ko e hā ʻoku ou ʻalu mamahi pe ʻi he taʻomia ʻe he fili?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ke ke fekau atu hoʻo maama mo hoʻo moʻoni:","poem":1},{"text":"tuku ke na tataki au;","poem":2},{"lineBreak":true},{"text":"tuku ke na ʻomi au ki ho moʻunga māʻoniʻoni,","poem":2},{"lineBreak":true},{"text":"mo ho ngaahi fale fehikitaki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko ia te u toki ʻalu atu ki he feilaulauʻanga ʻoe ʻOtua,","poem":1},{"text":"ki he ʻOtua ko hoku fiefiaʻanga lahi ʻaupito:","poem":2},{"lineBreak":true},{"text":"ʻio, ʻi he haʻape te u fakamālō kiate koe, ʻE ʻOtua ko hoku ʻOtua.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ko e hā ʻoku ke mapelu ai ki lalo, ʻE hoku laumālie?","poem":1},{"text":"pea ko e hā ʻoku ke maveuveu ai ʻi loto ʻiate au?","poem":2},{"lineBreak":true},{"text":"ʻAmanaki lelei ki he ʻOtua:","poem":2},{"lineBreak":true},{"text":"he ko e moʻoni te u fakafetaʻi kiate ia,","poem":2},{"lineBreak":true},{"text":"ʻaia ko e fakamoʻui ʻo hoku mata, mo hoku ʻOtua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}