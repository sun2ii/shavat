{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Ki he Takimuʻa ʻi he Nekina, ko e Saame pe ko e Hiva."]},{"type":"verse","number":1,"content":[{"text":"Ke ʻaloʻofa ʻae ʻOtua kiate kimautolu,","poem":1},{"text":"ʻo tāpuaki ʻakimautolu;","poem":2},{"lineBreak":true},{"text":"pea tuku ke ulo mai hono fofonga kiate kimautolu. Sila.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koeʻuhi ke ʻilo ai ho hala ʻi māmani,","poem":1},{"text":"mo hoʻo fakamoʻui ʻi he ngaahi puleʻanga kotoa pē.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuku ke fakamālō ʻae kakai kiate koe, ʻE ʻOtua;","poem":1},{"text":"ke fakamālō kiate koe ʻae kakai kotoa pē.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tuku ke fiefia ʻae ngaahi puleʻanga, pea hiva ʻi he nekeneka:","poem":1},{"text":"he te ke fakamaau māʻoniʻoni ʻae kakai,","poem":2},{"lineBreak":true},{"text":"pea tataki ʻae ngaahi puleʻanga ʻi māmani. Sila.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tuku ke fakamālō ʻae kakai kiate koe, ʻE ʻOtua;","poem":1},{"text":"ke fakamālō kiate koe ʻae kakai kotoa pē.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pea ʻe toki tuku mai ʻe he fonua hono tupu;","poem":1},{"text":"pea ko e ʻOtua, ʻio, ko hotau ʻOtua, te ne tāpuaki ʻakitautolu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‌ʻE tāpuaki ʻakitautolu ʻe he ʻOtua;","poem":1},{"text":"pea ʻe manavahē kiate ia ʻae ngataʻanga kotoa pē ʻo māmani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}