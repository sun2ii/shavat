ko au ʻoku ou masiva mo paea:","poem":1},{"text":"ʻE ʻOtua, ke ke haʻu vave kiate au:","poem":2},{"lineBreak":true},{"text":"ko koe ko hoku tokoni mo hoku fakamoʻui;","poem":2},{"lineBreak":true},{"text":"ʻE Sihova, ʻoua naʻa ke tatali.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}