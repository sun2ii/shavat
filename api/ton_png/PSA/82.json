{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Ko e Saame ʻa ʻAsafi."]},{"type":"verse","number":1,"content":[{"text":"‌ʻOku ʻafio ʻae ʻOtua ʻi he fakataha ʻoe kau mālohi;","poem":1},{"text":"ʻoku ne fakamaau ʻi he lotolotonga ʻoe ngaahi ʻotua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ʻE fēfē hono fuoloa mo hoʻomou fakamaau taʻetotonu,","poem":1},{"text":"pea filifilimānako ki he kakai angahala?” Sila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Fakamaau ʻae paea mo e tamai mate:","poem":1},{"text":"fai angatonu ki he mamahi mo e masiva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Fakahaofi ʻae masiva mo e paea:","poem":1},{"text":"fakamoʻui ʻakinautolu mei he nima ʻoe kau angahala.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku ʻikai te nau ʻilo,","poem":1},{"text":"pea ʻoku ʻikai te nau fie ʻilo;","poem":2},{"lineBreak":true},{"text":"ʻoku nau ʻalu pē ʻi he poʻuli:","poem":2},{"lineBreak":true},{"text":"kuo ueʻi ʻae ngaahi tuʻunga kotoa pē ʻo māmani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naʻaku pehē, “Ko e ngaahi ʻotua ʻakimoutolu;","poem":1},{"text":"pea ko e fānau ʻae Fungani Māʻolunga ʻakimoutolu kotoa pē.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka temou mate ʻo hangē ko e kau tangata,","poem":1},{"text":"pea tō ʻo hangē ko e tokotaha ʻoe houʻeiki.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tuʻu hake, ʻE ʻOtua, fakamaau ʻa māmani:","poem":1},{"text":"he te ke maʻu ʻae puleʻanga kotoa pē.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}