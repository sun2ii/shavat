{"translation":{"id":"ton_png","name":"KO E TOHI TAPU KĀTOA","website":"https://ebible.org/Scriptures/details.php?id=ton","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ton","licenseNotes":null,"shortName":"PNG","englishName":"Revised West Version","language":"ton","textDirection":"ltr","sha256":"f378043f225b34e0b1a9215e333806fc0272b8fe928cd00f8a08fe2f67dcee3a","availableFormats":["json"],"listOfBooksApiLink":"/api/ton_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"lea fakatonga","languageEnglishName":"Tongan"},"book":{"id":"PSA","translationId":"ton_png","name":"Saame","commonName":"Saame","title":"KO E TOHI ʻOE NGAAHI SAAME","order":19,"numberOfChapters":150,"sha256":"fc194b7b670c17dd8e2185dedd26e932e8f9ac40a42b173c9d22cefe7d1d9edc","firstChapterNumber":1,"firstChapterApiLink":"/api/ton_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ton_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"‌ʻOku pule ʻa Sihova, ʻoku kofuʻaki ia ʻae nāunau lahi;","poem":1},{"text":"ʻoku kofuʻaki ʻa Sihova ʻae māfimafi,","poem":2},{"lineBreak":true},{"text":"ʻaia kuo ne nonoʻo ʻaki ia kuo fokotuʻumaʻu foki ʻa māmani,","poem":2},{"lineBreak":true},{"text":"pea ʻe ʻikai faʻa ueʻi ia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"KUO fokotuʻumaʻu ho ʻafioʻanga talu mei muʻa:","poem":1},{"text":"ʻoku talu mei muʻa ʻae ʻafiona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‌ʻE Sihova, kuo hiki hake ʻe he ngaahi vaitafe,","poem":1},{"text":"kuo hiki hake ʻe he ngaahi vaitafe honau leʻo;","poem":2},{"lineBreak":true},{"text":"ʻoku hiki hake ʻe he ngaahi vaitafe lahi honau ngaahi peau.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ko Sihova ʻoku ʻi ʻolunga ʻoku mālohi lahi hake ia ʻi he ʻuʻulu ʻoe ngaahi vai lahi,","poem":1},{"text":"ʻio, ʻi he ngaahi peau mālohi ʻoe tahi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‌ʻOku moʻoni ʻaupito hoʻo ngaahi fakamoʻoni:","poem":1},{"text":"ʻE Sihova, ʻoku taau mo ho fale ʻae māʻoniʻoni ʻo lauikuonga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ton_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ton_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ton_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}