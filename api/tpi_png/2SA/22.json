em i sutim ol hap paia","poem":1},{"text":"i go nabaut.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Em i opim skai na i kam daun.","poem":1},{"text":"Na blakpela klaut i stap aninit","poem":2},{"text":"long lek bilong en.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"I olsem wanpela ensel i karim em","poem":1},{"text":"na i flai i kam.","poem":2},{"text":"Na i olsem win i gat wing","poem":1},{"text":"bilong pisin","poem":3},{"text":"na i karim God i kam hariap tru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Em i mekim tudak i kamap","poem":1},{"text":"olsem haus sel bilong en,","poem":3},{"text":"na ol blakpela klaut bilong ren","poem":2},{"text":"i karamapim em.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Tasol em i mekim ples i lait olgeta,","poem":1},{"text":"na ol hap paia i sut i kam ausait","poem":2},{"text":"long dispela lait.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Bikpela i stap long heven","poem":1},{"text":"na i bikmaus moa yet","poem":2},{"text":"olsem klaut i pairap.","poem":3},{"text":"God Antap Tru","poem":1},{"text":"i autim tok bilong en.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Em i mekim lait bilong klaut","poem":1},{"text":"i kamap olsem ol spia bilong en,","poem":3},{"text":"na em i sutim ol birua","poem":2},{"text":"na ol i ranawe nabaut.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Bikpela i krosim ol birua","poem":1},{"text":"na belhat bilong en","poem":2},{"text":"i olsem strongpela win i sakim ol.","poem":3},{"text":"Na belhat bilong en","poem":1},{"text":"i mekim solwara i drai olgeta,","poem":3},{"text":"na ol samting","poem":2},{"text":"bilong strongim graun","poem":3},{"text":"i kamap ples klia.","poem":4}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Bikpela i stap antap","poem":1},{"text":"na i putim han i kam daun","poem":2},{"text":"na i kisim bek mi.","poem":3},{"text":"Bikpela si i karamapim mi","poem":1},{"text":"tasol em i pulim mi i kam antap.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ol birua bilong mi i strong tru","poem":1},{"text":"na mi no inap winim ol.","poem":2},{"text":"Tasol Bikpela i kisim bek mi","poem":1},{"text":"long han bilong ol.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bipo taim nogut i painim mi","poem":1},{"text":"na ol birua i kam pait long mi.","poem":2},{"text":"Tasol Bikpela i bin was long mi.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Em i bin helpim mi na mi stap gut.","poem":2},{"text":"Em i laikim mi tumas,","poem":1},{"text":"olsem na em i kisim bek mi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mi bihainim stretpela pasin,","poem":1},{"text":"olsem na Bikpela i givim mi","poem":2},{"text":"planti gutpela samting.","poem":3},{"text":"Mi no mekim wanpela rong,","poem":1},{"text":"olsem na God","poem":2},{"text":"i mekim gut long mi.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Mi bihainim gut lo bilong Bikpela.","poem":1},{"lineBreak":true},{"text":"Mi no bin givim baksait","poem":1},{"text":"long God bilong mi","poem":3},{"text":"na mekim pasin nogut.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mi bin tingting oltaim","poem":1},{"text":"long ol lo bilong en,","poem":3},{"text":"na mi no bin givim baksait","poem":2},{"text":"long tok bilong en.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Em i save, mi no gat wanpela asua.","poem":1},{"lineBreak":true},{"text":"Mi bin was gut","poem":1},{"text":"long wokabaut bilong mi,","poem":3},{"text":"nogut mi mekim wanpela rong.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Olsem na Bikpela i tingim","poem":1},{"text":"stretpela pasin bilong mi,","poem":3},{"text":"na em i bekim","poem":2},{"text":"gutpela pasin long mi,","poem":3},{"text":"long wanem, mi stap klin","poem":2},{"text":"long ai bilong em.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Bikpela, sapos man i no lusim yu,","poem":1},{"text":"orait yu no save lusim em.","poem":2},{"text":"Sapos man i mekim stretpela pasin","poem":1},{"text":"na i no gat asua,","poem":3},{"text":"orait yu save bekim","poem":2},{"text":"stretpela pasin tasol long em.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Sapos wanpela man","poem":1},{"text":"i bihainim klinpela pasin,","poem":3},{"text":"orait yu save soim em","poem":2},{"text":"klinpela pasin bilong yu.","poem":3},{"text":"Tasol sapos man","poem":1},{"text":"i bihainim pasin nogut,","poem":3},{"text":"orait yu save bekim nogut","poem":2},{"text":"long em.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Yu save kisim bek","poem":1},{"text":"ol manmeri i daunim ol yet.","poem":2},{"text":"Tasol yu save daunim","poem":1},{"text":"ol manmeri bilong hambak.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Bikpela, yu yet yu lait bilong mi,","poem":1},{"text":"na yu save rausim tudak long mi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"God, sapos yu helpim mi,","poem":1},{"text":"bai mi inap daunim","poem":2},{"text":"bikpela lain birua.","poem":3},{"text":"Na sapos yu strongim mi,","poem":1},{"text":"bai mi inap kalapim","poem":2},{"text":"bikpela banis bilong taun.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Pasin bilong God i gutpela tru","poem":1},{"text":"na i stret olgeta.","poem":2},{"text":"Sapos em i promis","poem":1},{"text":"long mekim wanpela samting,","poem":3},{"text":"orait tok bilong en em i tru olgeta.","poem":2},{"text":"Bikpela i olsem","poem":1},{"text":"hap plang bilong pait,","poem":3},{"text":"na em i save lukautim gut","poem":2},{"text":"olgeta man i go long em","poem":3},{"text":"na ol i hait long ol birua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Bikpela tasol em i God tru.","poem":1},{"text":"Em wanpela tasol i banisim yumi","poem":2},{"text":"olsem bikpela ston.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"God em i strongpela ples hait","poem":1},{"text":"bilong mi.","poem":2},{"text":"Em i save stretim gutpela rot","poem":1},{"text":"bilong mi long wokabaut.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Em i mekim mi i wokabaut gut tru","poem":1},{"text":"olsem ol wel abus","poem":2},{"text":"antap long ol maunten,","poem":3},{"text":"na mi no inap pundaun.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Em i skulim mi","poem":1},{"text":"long pasin bilong pait,","poem":3},{"text":"na em i mekim han bilong mi","poem":2},{"text":"i strong.","poem":3},{"text":"Mi inap taitim strongpela banara","poem":1},{"text":"ol i wokim long bras.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bikpela, yu bin kisim bek mi","poem":1},{"text":"long han bilong ol birua.","poem":2},{"text":"Yu givim mi hap plang bilong yu","poem":1},{"text":"na mi hait i stap baksait long en.","poem":2},{"text":"Yu bin helpim","poem":1},{"noteId":24},{"text":"mi na mi gat biknem","poem":1},{"text":"long ai bilong ol manmeri.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yu bin givim gutpela rot long mi","poem":1},{"text":"na lek bilong mi i no wel.","poem":2},{"text":"Mi wokabaut na mi no pundaun.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Mi bin ranim ol birua","poem":1},{"text":"na bagarapim ol.","poem":2},{"text":"Mi mekim save tru long ol","poem":1},{"text":"na mi pinisim ol olgeta.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mi sutim olgeta na ol i pundaun.","poem":1},{"text":"Ol i slip i stap","poem":2},{"text":"klostu long lek bilong mi,","poem":4},{"text":"na ol i no kirap gen.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yu givim mi strong bilong pait.","poem":1},{"lineBreak":true},{"text":"Na yu putim ol birua","poem":1},{"text":"long han bilong mi,","poem":3},{"text":"na mi winim ol.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yu mekim ol birua i tanim baksait","poem":1},{"text":"na i ranawe long mi,","poem":3},{"text":"na mi pinisim ol dispela man","poem":2},{"text":"i no laikim mi.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"Ol i bin painim ol man","poem":1},{"text":"bilong helpim ol,","poem":3},{"text":"tasol i no gat man i stap.","poem":2},{"text":"Na ol i krai long yu, Bikpela,","poem":1},{"text":"tasol yu no harim prea bilong ol.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mi bagarapim ol tru","poem":1},{"text":"na ol i kamap olsem das.","poem":2},{"text":"Mi daunim na krungutim ol,","poem":1},{"text":"olsem mi wokabaut","poem":2},{"text":"antap long graun malumalum","poem":3},{"text":"long rot.","poem":4}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“Taim ol manmeri bilong mi","poem":1},{"text":"i birua long mi,","poem":3},{"text":"yu bin helpim mi","poem":2},{"text":"na ol i no bagarapim mi.","poem":3},{"text":"Na yu larim mi i stap bosman","poem":1},{"text":"bilong ol arapela lain manmeri tu.","poem":2},{"text":"Ol manmeri mi no bin save long ol,","poem":1},{"text":"nau ol i stap aninit long mi.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Ol manmeri","poem":1},{"text":"bilong ol arapela kantri,","poem":3},{"text":"ol i pret long mi,","poem":2},{"text":"na ol i kam brukim skru long mi.","poem":3},{"text":"Ol i harim tok","poem":1},{"text":"long biknem bilong mi,","poem":3},{"text":"na wantu ol i aninit long mi.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Strong bilong ol i lus pinis,","poem":1},{"text":"na ol i lusim","poem":2},{"text":"ol strongpela taun bilong ol,","poem":3},{"text":"na ol i guria guria i kam long mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Bikpela i stap oltaim.","poem":1},{"text":"Em i olsem bikpela ston","poem":2},{"text":"i b