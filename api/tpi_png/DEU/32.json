{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"DEU","translationId":"tpi_png","name":"LO","commonName":"LO","title":"Moses i autim gen Lo Bilong God o Diuteronomi","order":5,"numberOfChapters":34,"sha256":"e29e126f073ed9011638f0d8d3bc8554f8cd035434d9494ce083d5c4c8ee069b","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tpi_png/DEU/34.json","totalNumberOfVerses":939},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"“Heven na graun,","poem":1},{"text":"yutupela harim tok","poem":2},{"text":"bilong mi.","poem":3},{"text":"Putim yau gut long tok mi mekim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tok bilong mi bai i mekim gut","poem":1},{"text":"long yupela","poem":3},{"text":"olsem ren i kam daun","poem":2},{"text":"na mekim gras i kamap gutpela.","poem":3},{"text":"Tok bilong mi bai i olsem","poem":1},{"text":"ren i kam daun","poem":3},{"text":"na mekim ol nupela kru","poem":2},{"text":"bilong kaikai","poem":3},{"text":"i kamap strong na i go bikpela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Olsem na bai mi litimapim nem","poem":1},{"text":"bilong Bikpela,","poem":3},{"text":"na yupela bai i tokaut","poem":2},{"text":"long biknem bilong en.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"God bilong yumi","poem":1},{"text":"i save stap olsem oltaim.","poem":2},{"text":"Em i olsem","poem":1},{"text":"wanpela bikpela strongpela ston","poem":2},{"text":"i no save senis.","poem":3},{"text":"Oltaim em i save bihainim tok","poem":1},{"text":"bilong en","poem":3},{"text":"na em i no save giaman.","poem":2},{"text":"Na pasin bilong en","poem":1},{"text":"i gutpela na stretpela tasol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tasol yupela i no olsem.","poem":1},{"lineBreak":true},{"text":"Yupela i manmeri bilong giaman.","poem":1},{"lineBreak":true},{"text":"Yupela i save senisim tok","poem":1},{"text":"na brukim promis.","poem":2},{"text":"Yupela i manmeri","poem":1},{"text":"bilong mekim sin tasol.","poem":2},{"text":"Olsem na yupela i no inap","poem":1},{"text":"i stap lain pikinini bilong God.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tasol God em i papa bilong yupela.","poem":1},{"lineBreak":true},{"text":"Em i kamapim yupela olgeta.","poem":1},{"lineBreak":true},{"text":"Na em i mekim yupela i kamap","poem":1},{"text":"wanpela lain manmeri.","poem":2},{"text":"Olsem na bilong wanem","poem":1},{"text":"yupela i mekim dispela kain pasin","poem":2},{"text":"long em?","poem":3},{"text":"Yupela i longlong.","poem":1},{"text":"Yupela i no gat tingting tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Yupela tingim ol samting","poem":1},{"text":"i bin kamap bipo bipo tru.","poem":2},{"text":"Askim ol papa bilong yupela","poem":1},{"text":"long tokim yupela","poem":2},{"text":"long wanem samting i bin kamap.","poem":3},{"text":"Na askim ol lapun","poem":1},{"text":"long stori long yupela","poem":2},{"text":"long ol samting bilong bipo.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"God Antap Tru,","poem":1},{"text":"em yet i bin tilim graun","poem":2},{"text":"long ol lain manmeri","poem":3},{"text":"na em i tokim ol long ples","poem":2},{"text":"ol i mas sindaun long en.","poem":3},{"noteId":3},{"text":"Na em i bihainim namba","poem":1},{"text":"bilong ol manmeri bilong Israel","poem":3},{"text":"na makim graun","poem":2},{"text":"bilong ol arapela lain pipel","poem":3},{"lineBreak":true},{"text":"i ken i stap long en.*","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Tasol em i makim lain bilong Jekop","poem":1},{"text":"bilong em yet i lukautim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ol Israel i longlong","poem":1},{"text":"na raun nabaut","poem":2},{"text":"long ples wesan nogut,","poem":3},{"text":"em ples i gat bikpela win.","poem":2},{"text":"Na Bikpela i painim ol","poem":1},{"text":"na kisim ol","poem":2},{"text":"na helpim ol.","poem":3},{"text":"Em i was long ol,","poem":1},{"text":"olsem em i save was long em yet.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"God i helpim ol Israel gut","poem":1},{"text":"na ol i no bagarap,","poem":3},{"text":"olsem tarangau i lainim","poem":2},{"text":"pikinini bilong en long flai,","poem":3},{"text":"na taim pikinini i laik pundaun","poem":2},{"text":"tarangau i save go aninit","poem":3},{"text":"na karim em long wing","poem":4},{"text":"na pikinini i no bagarap.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"God wanpela tasol i soim rot","poem":1},{"text":"long ol manmeri bilong en.","poem":2},{"text":"Na i no gat wanpela god","poem":1},{"text":"bilong ol arapela ples","poem":3},{"text":"i helpim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“God i larim ol i bosim","poem":1},{"text":"ples maunten","poem":3},{"text":"na ol kaikai i kamap long gaden","poem":2},{"text":"ol i kisim na kaikai.","poem":3},{"text":"Na ol i kisim hani bilong binatang","poem":1},{"text":"long ston","poem":3},{"text":"na ol i kaikai.","poem":2},{"text":"Na ol diwai oliv bilong ol","poem":1},{"text":"i kamap gutpela","poem":2},{"text":"long graun i gat planti ston.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Ol i kisim planti susu","poem":1},{"text":"long ol bulmakau","poem":2},{"text":"na meme bilong ol.","poem":3},{"text":"Na ol bulmakau na sipsip na meme","poem":1},{"text":"bilong ol,","poem":3},{"text":"ol i pat nogut tru.","poem":2},{"text":"Na olgeta wit na wain bilong ol","poem":1},{"text":"i kamap nambawan tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ol manmeri bilong Bikpela","poem":1},{"text":"i kisim planti samting,","poem":2},{"text":"tasol ol i bikhet long em.","poem":3},{"text":"Ol i kaikai planti oltaim","poem":1},{"text":"na ol i pat nogut tru.","poem":2},{"text":"God i bin kamapim ol,","poem":1},{"text":"na long strong bilong em yet","poem":2},{"text":"em i kisim bek ol,","poem":3},{"text":"tasol ol i givim baksait long em","poem":2},{"text":"na i lusim em.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Ol i lotu long ol giaman god","poem":1},{"text":"na dispela pasin nogut bilong ol","poem":2},{"text":"i mekim Bikpela i bel nogut","poem":3},{"text":"na i kros long ol.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Ol i mekim ol ofa long ol masalai,","poem":1},{"text":"ol i no bin lotuim bipo.","poem":2},{"text":"Na ol i bihainim ol nupela god,","poem":1},{"text":"em ol tumbuna bilong ol","poem":2},{"text":"i no bin aninit long ol bipo.","poem":3},{"text":"Ol dispela samting i no god tru.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ol i lusim tingting","poem":1},{"text":"long strongpela God","poem":2},{"text":"em i bin kamapim ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Taim God i lukim","poem":1},{"text":"dispela pasin nogut","poem":2},{"text":"bilong ol pikinini bilong en,","poem":3},{"text":"em i belhat","poem":2},{"text":"na i givim baksait long ol.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Na em i tok, ‘Ol dispela lain","poem":1},{"text":"ol i manmeri bilong bikhet","poem":2},{"text":"na ol i no bihainim mi.","poem":3},{"text":"Maski sapos olkain hevi","poem":2},{"text":"i kamap long ol,","poem":3},{"text":"bai mi no inap helpim ol moa.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ol i bihainim ol giaman god,","poem":2},{"text":"em ol samting nating.","poem":3},{"text":"Na dispela pasin bilong ol","poem":2},{"text":"i mekim mi i bel nogut","poem":3},{"text":"na kros long ol.","poem":4},{"text":"Olsem na bai mi kisim","poem":2},{"text":"wanpela lain i no gat nem","poem":3},{"lineBreak":true},{"text":"na i samting nating,","poem":3},{"lineBreak":true},{"text":"na i olsem ol longlong man,","poem":3},{"text":"na bai mi salim ol dispela man","poem":2},{"text":"i go","poem":4},{"text":"bilong mekim ol Israel","poem":3},{"text":"i bel nogut na kros.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Long dispela taim","poem":2},{"text":"belhat bilong mi","poem":3},{"text":"bai i lait olsem paia","poem":4},{"text":"na bai i kukim","poem":3},{"text":"olgeta samting long graun.","poem":4},{"text":"Em bai i go aninit long graun,","poem":2},{"text":"long ples bilong ol man i dai pinis,","poem":3},{"text":"na em bai i kukim tru ol ston","poem":2},{"text":"ol maunten i sanap long en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“‘Bai mi mekim olkain bagarap","poem":2},{"text":"i kamap long ol,","poem":3},{"text":"olsem man i gat planti spia","poem":2},{"text":"na i sutim ol birua","poem":3},{"text":"long olgeta spia bilong en.","poem":4}]},{"type":"verse","number":24,"content":[{"text":"Bai mi mekim ol i hangre,","poem":2},{"text":"na bai ol i kisim","poem":3},{"text":"ol kain kain sik nogut","poem":4},{"text":"na bai ol i dai.","poem":3},{"text":"Bai mi salim ol kain kain wel abus","poem":2},{"text":"wantaim ol snek nogut","poem":3},{"text":"i go kaikaim ol.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Bai bikpela pait i kamap,","poem":2},{"text":"na sapos ol i stap long rot","poem":3},{"text":"ol birua bai i kilim ol i dai.","poem":4},{"text":"Na sapos ol i hait i stap long haus","poem":2},{"text":"ol bai i pret nogut tru,","poem":3},{"text":"na ol tu bai i dai.","poem":4},{"text":"Ol birua bai i kilim olgeta i dai,","poem":2},{"text":"ol yangpela man na meri","poem":3},{"lineBreak":true},{"text":"na ol nupela pikinini","poem":3},{"text":"na ol lapun.","poem":4}]},{"type":"verse","number":26,"content":[{"text":"Pastaim mi ting","poem":2},{"text":"long pinisim ol olgeta,","poem":3},{"text":"olsem na bai i no gat man","poem":2},{"text":"i ken tingim ol gen.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Tasol sapos mi mekim olsem,","poem":2},{"text":"ol birua bai i hambak na i tok,","poem":3},{"text":"“Mipela i daunim","poem":2},{"text":"ol manmeri bilong God","poem":3},{"text":"long strong bilong mipela yet.","poem":4},{"text":"Bikpela bilong ol i no bin mekim","poem":2},{"text":"dispela samting i kamap.”","poem":3},{"text":"Nogut ol birua i tok olsem,","poem":2},{"text":"olsem na mi no ken","poem":3},{"text":"pinisim ol olgeta.’","poem":4}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Ol lain Israel","poem":1},{"text":"i no gat gutpela tingting.","poem":2},{"text":"Tingting bilong ol i sot tru.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sapos ol i gat tingting,","poem":1},{"text":"ol inap save long as","poem":2},{"text":"bilong dispela samting","poem":3},{"text":"i bin bagarapim ol.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"Bilong wanem","poem":1},{"text":"na wanpela birua tasol","poem":2},{"text":"i winim 1,000 Israel?","poem":3},{"text":"Na bilong wanem tupela birua","poem":1},{"text":"i winim 10,000?","poem":2},{"text":"As bilong dispela i olsem.","poem":1},{"lineBreak":true},{"text":"God, Bikpela bilong ol,","poem":1},{"text":"em i les pinis long ol.","poem":2},{"text":"Strongpela God bilong ol","poem":1},{"text":"i givim baksait long ol.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ol birua i save,","poem":1},{"text":"ol giaman god bilong ol yet","poem":2},{"text":"i no gat strong.","poem":3},{"text":"Tasol God bilong Israel","poem":1},{"text":"i gat bikpela strong","poem":2},{"text":"olsem wanpela traipela ston.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Pasin bilong ol birua bilong ol Israel","poem":1},{"text":"i sting nogut tru,","poem":3},{"text":"olsem pasin bilong ol Sodom","poem":2},{"text":"na ol Gomora.","poem":3},{"text":"Ol i olsem diwai wain","poem":1},{"text":"i karim kaikai i sol tumas","poem":2},{"text":"na i gat pait.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Pasin bilong ol i olsem wain","poem":1},{"text":"ol i wokim long marasin nogut","poem":2},{"text":"bilong snek.","poem":3}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Bikpela i save tingting yet","poem":1},{"text":"long ol samting ol birua","poem":2},{"text":"bilong Israel i bin mekim.","poem":3},{"text":"Em i wetim taim","poem":1},{"text":"bilong mekim save long ol.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Na Bikpela bai i bekim","poem":1},{"text":"rong bilong ol","poem":3},{"text":"na mekim save long ol.","poem":2},{"text":"Sotpela taim tasol","poem":1},{"text":"na bai ol i pundaun","poem":2},{"text":"na bagarap olgeta.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Taim Bikpela i lukim","poem":1},{"text":"strong bilong ol manmeri","poem":2},{"text":"bilong en i pinis","poem":3},{"text":"na i gat wan wan man tasol i stap,","poem":2},{"lineBreak":true},{"text":"orait em bai i marimari","poem":2},{"text":"long ol dispela man","poem":3},{"text":"i mekim wok bilong en","poem":4},{"text":"na em bai i kisim bek ol.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Orait na Bikpela bai i tokim","poem":1},{"text":"ol manmeri bilong en olsem,","poem":3},{"text":"‘Yupela i ting ol dispela god","poem":2},{"text":"i gat strong bilong helpim yupela.","poem":3},{"text":"Tasol nau olsem wanem?","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Yupela i bin ofaim","poem":2},{"text":"gris bilong abus","poem":3},{"text":"na wain long ol.","poem":4},{"text":"Orait ol i ken helpim yupela nau.","poem":2},{"lineBreak":true},{"text":"Ol i ken kisim bek yupela","poem":2},{"text":"long ples nogut.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Yupela i mas save,","poem":2},{"text":"mi wanpela tasol","poem":3},{"text":"mi God tru.","poem":4},{"text":"Na i no gat wanpela god olsem mi.","poem":2},{"lineBreak":true},{"text":"Mi save givim laip long ol man","poem":2},{"text":"na mi save rausim laip long ol.","poem":3},{"text":"Mi save bagarapim man","poem":2},{"text":"na mekim em i orait gen.","poem":3},{"text":"Na sapos mi laik mekim","poem":2},{"text":"wanpela samting,","poem":3},{"text":"i no gat wanpela man","poem":2},{"text":"inap pasim mi.","poem":3}]},{"type":"verse","number":40,"content":[{"text":"Yes, tru tumas,","poem":2},{"lineBreak":true},{"text":"mi tasol mi God","poem":2},{"text":"bilong i stap oltaim.","poem":3},{"text":"Na mi mekim","poem":2},{"text":"strongpela promis olsem,","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Bai mi skelim stret","poem":2},{"text":"pasin bilong ol man.","poem":3},{"text":"Bai mi sapim bainat bilong mi","poem":2},{"text":"na em i sap moa","poem":3},{"text":"na i lait tumas.","poem":4},{"text":"Na bai mi kisim dispela bainat","poem":2},{"text":"na kilim ol birua bilong mi","poem":3},{"lineBreak":true},{"text":"na bagarapim ol man","poem":3},{"text":"i no laikim mi.","poem":4},{"text":"Bai mi sutim olgeta man","poem":2},{"text":"i laik pait long mi","poem":3},{"text":"na blut bilong ol","poem":2},{"text":"bai i ran i go daun","poem":3},{"text":"long ol spia bilong banara.","poem":4},{"text":"Na sapos sampela man","poem":2},{"text":"i no i dai long pait,","poem":3},{"text":"orait bai mi kilim ol tu.’","poem":2}]},{"type":"verse","number":43,"content":[{"text":"“Ol manmeri","poem":1},{"text":"bilong ol arapela kantri,","poem":3},{"text":"yupela i mas litimapim nem","poem":2},{"text":"bilong ol manmeri bilong God.","poem":3},{"text":"God i save bagarapim olgeta man","poem":1},{"text":"i save kilim i dai","poem":2},{"text":"ol manmeri bilong en.","poem":3},{"text":"Na em i save bekim rong","poem":1},{"text":"bilong ol birua.","poem":2},{"text":"Tasol em i mekim graun","poem":1},{"text":"bilong ol manmeri bilong en","poem":3},{"text":"i kamap klin tru","poem":2},{"text":"long ai bilong en.”","poem":3},{"noteId":4}]},{"type":"verse","number":44,"content":["Moses wantaim Josua, pikinini bilong Nun, tupela i bin autim tok bilong dispela song, na ol Israel i harim."]},{"type":"heading","content":["Tok bilong God em i as tru bilong yupela i ken i stap gut"]},{"type":"verse","number":45,"content":["Moses i autim pinis dispela olgeta tok bilong God long ol manmeri,"]},{"type":"verse","number":46,"content":["orait na em i tok moa olsem, “Yupela i mas lukaut gut na bihainim olgeta dispela lo nau mi givim yupela. Na yupela i mas toksave long ol pikinini bilong yupela, olsem bai ol tu i ken bihainim olgeta tok bilong God oltaim."]},{"type":"verse","number":47,"content":["Dispela tok bilong God i no toktok nating. Nogat. Em i as tru bilong yupela i ken i stap gut. Yupela i mas bihainim gut na bai yupela i stap longpela taim long graun long hapsait bilong wara Jordan, nau yupela i laik i go sindaun long en.”"]},{"type":"heading","content":["Moses i no inap i go long kantri Kenan"]},{"type":"verse","number":48,"content":["Long dispela de tasol God i tokim Moses,"]},{"type":"verse","number":49,"content":["“Yu go long ol maunten Abarim long graun bilong Moap. Ol dispela maunten i stap klostu long wara Jordan, na taun Jeriko i stap long hapsait. Yu go antap long dispela maunten Nebo na lukluk i go long kantri Kenan nau mi laik givim long yupela ol Israel."]},{"type":"verse","number":50,"content":["Na yu bai i dai antap long dispela maunten olsem brata bilong yu Aron i bin dai antap long maunten Hor, na yu tu bai i go i stap wantaim ol tumbuna bilong yu."]},{"type":"verse","number":51,"content":["Yutupela i mas i dai, long wanem, yutupela i no bihainim gut tok bilong mi na yutupela i daunim nem bilong mi long ai bilong ol Israel taim yutupela i stap long Meriba, klostu long taun Kades, long ples wesan nating bilong Sen."]},{"type":"verse","number":52,"content":["Olsem na yu ken lukim dispela graun, tasol yu no inap i go klostu long en. Na yu no inap i go insait long dispela graun nau mi givim long ol Israel.”"]}],"footnotes":[{"noteId":3,"caller":"+","text":"32.8 Dispela tok i stap namel long tupela sta, em i no klia tumas long tok Hibru. Bipo yet ol man i bin tanim dispela tok long tok Grik, na ol i bin raitim narapela kain tok olsem, “Na em i makim wan wan ensel bilong lukautim ol wan wan kantri.” Planti saveman i ting dispela kain tok i bin i stap pastaim long tok Hibru tu, na bihain sampela man i bin senisim.","reference":{"chapter":32,"verse":8}},{"noteId":4,"caller":"+","text":"32.43 Tok Hibru i no klia tumas long dispela hap.","reference":{"chapter":32,"verse":43}}]},"thisChapterLink":"/api/tpi_png/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":51}