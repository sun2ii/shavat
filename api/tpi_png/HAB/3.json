{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"HAB","translationId":"tpi_png","name":"HABAKUK","commonName":"HABAKUK","title":"Buk bilong Profet Habakuk","order":35,"numberOfChapters":3,"sha256":"78c12c7c9bd7d87a5f027c5b359f4e9742f644e57de5afcc7252440d137382b5","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tpi_png/HAB/3.json","totalNumberOfVerses":54},"chapter":{"number":3,"content":[{"type":"heading","content":["Profet i askim God long helpim ol Israel"]},{"type":"verse","number":1,"content":["Profet Habakuk i bin mekim prea long Bikpela olsem. Ol man i singim dispela prea, ol i mas bihainim pasin bilong ol song bilong sori. Na man i bosim musik i mas tokim ol man long paitim ol gita samting.",{"noteId":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bikpela, mi bin harim tok","poem":1},{"text":"long ol samting yu bin mekim","poem":2},{"text":"long strong bilong yu","poem":3},{"text":"na mi kirap nogut.","poem":2},{"text":"Ol bikpela bikpela samting","poem":1},{"text":"yu bin mekim bipo,","poem":3},{"text":"mi laik bai yu mekim gen","poem":2},{"text":"long taim bilong mipela,","poem":3},{"text":"bai ol man bilong dispela taim tu","poem":2},{"text":"i ken save long pasin bilong yu.","poem":3},{"text":"Tru, yu gat kros long mipela,","poem":1},{"text":"tasol yu God bilong sori,","poem":2},{"lineBreak":true},{"text":"na mi askim yu","poem":2},{"text":"long sori long mipela","poem":3},{"text":"na helpim mipela.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God i lusim graun Idom","poem":1},{"text":"na em i kam gen.","poem":2},{"text":"God bilong mekim","poem":1},{"text":"gutpela na stretpela pasin olgeta,","poem":3},{"text":"em i kirap long maunten Paran","poem":2},{"text":"na em i kam.","poem":3},{"lineBreak":true},{"text":"Strong bilong en i kamap olsem lait","poem":1},{"text":"na i karamapim","poem":2},{"text":"olgeta hap bilong skai.","poem":3},{"text":"Olgeta manmeri bilong graun","poem":1},{"text":"i lukim bikpela lait bilong en.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bikpela lait bilong strong bilong en","poem":1},{"text":"i sut i go long olgeta hap.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Em i salim ol kain kain sik","poem":1},{"text":"i go paslain long en.","poem":2},{"text":"Bikpela sik bilong kilim ol manmeri","poem":1},{"text":"i bihainim em i kam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Long taim em i sanap","poem":1},{"text":"olgeta graun i save guria.","poem":2},{"text":"Long taim em i lukim ol manmeri","poem":1},{"text":"ol i save surik na guria.","poem":2},{"text":"Ol bikpela strongpela maunten","poem":1},{"text":"i bruk na pundaun.","poem":2},{"text":"Ol liklik maunten","poem":1},{"text":"bipo em i save wokabaut long ol","poem":2},{"text":"ol i surik i go daun.","poem":3},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi lukim ol haus sel","poem":1},{"text":"bilong kantri Kusan","poem":3},{"text":"i bagarap nogut tru.","poem":2},{"text":"Ol haus bilong ol Midian","poem":1},{"text":"i pundaun nabaut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu salim win i kam","poem":1},{"text":"na yu mekim ol wara na solwara","poem":2},{"text":"i kirap strong.","poem":3},{"text":"Ating yu kros long ol","poem":1},{"text":"na yu mekim olsem, a?","poem":2},{"text":"Taim yu kam bilong helpim","poem":1},{"text":"ol manmeri bilong yu","poem":3},{"text":"na bilong winim ol birua,","poem":2},{"lineBreak":true},{"text":"ol klaut bilong ren","poem":2},{"text":"i olsem ol hos na karis bilong yu.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Yu bin redim banara bilong yu,","poem":1},{"text":"na bai yu tok","poem":3},{"text":"na ol spia bilong yu","poem":2},{"text":"bai i go long ples","poem":3},{"text":"yu makim bilong ol.","poem":4},{"lineBreak":true},{"text":"Taim ol maunten i lukim yu,","poem":1},{"text":"ol i guria.","poem":2},{"text":"Yu tromoi bikpela wara","poem":1},{"text":"i go daun long graun","poem":3},{"text":"na em i katim ol bikpela baret.","poem":2},{"text":"Bikpela tait i ran strong na i kam.","poem":1},{"lineBreak":true},{"text":"Ol wara aninit long graun tu","poem":1},{"text":"i pairap na solap i go antap","poem":2},{"text":"inap long skai.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol spia bilong yu i lait tumas","poem":1},{"text":"taim ol i spit i go,","poem":3},{"text":"na san wantaim mun","poem":2},{"text":"i sanap nating antap.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu gat bikpela kros long olgeta kantri","poem":1},{"text":"na yu wokabaut antap long graun","poem":2},{"text":"na krungutim olgeta ples.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Yu mekim olsem bilong kisim bek","poem":1},{"text":"ol manmeri bilong yu","poem":3},{"text":"wantaim dispela king","poem":2},{"text":"yu bin makim.","poem":3},{"text":"Yu bin paitim strong","poem":1},{"text":"het bilong haus bilong ol man nogut","poem":2},{"text":"na yu bagarapim haus olgeta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ol dispela birua i bin kam","poem":1},{"text":"olsem bikpela win,","poem":3},{"text":"bilong rausim mipela i go nabaut.","poem":2},{"text":"Ol i amamas long daunim mipela","poem":1},{"text":"olsem ol man i hait na wet","poem":2},{"text":"bilong mekim nogut","poem":3},{"text":"long ol manmeri i sot long ol samting.","poem":4},{"text":"Tasol yu bin sutim kepten","poem":1},{"text":"bilong ami bilong ol birua","poem":2},{"text":"long ol spia bilong em yet.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Yu bin sindaun long ol hos bilong yu","poem":1},{"text":"na ol i krungutim solwara na i go.","poem":2},{"text":"Na dispela i mekim biksi i kirap.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mi harim dispela olgeta samting","poem":1},{"text":"na mi guria.","poem":2},{"text":"Mi pret na maus bilong mi tu i guria.","poem":1},{"lineBreak":true},{"text":"Hanlek bilong mi i dai","poem":1},{"text":"na mi no gat strong moa.","poem":2},{"text":"Mi save, God bai i kam","poem":1},{"text":"na mekim save long ol man","poem":2},{"text":"i save bagarapim mipela,","poem":3},{"text":"olsem na mi stap isi","poem":2},{"text":"na wetim dispela taim.","poem":3},{"noteId":4}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sapos ol diwai fik","poem":1},{"text":"i no karim pikinini fik","poem":3},{"text":"na ol diwai wain","poem":2},{"text":"i no karim pikinini wain,","poem":3},{"text":"na sapos ol diwai oliv","poem":1},{"text":"i no karim pikinini","poem":3},{"text":"na i no gat kaikai long gaden,","poem":2},{"text":"na sapos olgeta sipsip i dai","poem":1},{"text":"na haus bilong ol bulmakau tu","poem":2},{"text":"i stap nating,","poem":3}]},{"type":"verse","number":18,"content":[{"text":"orait maski dispela olgeta hevi","poem":1},{"text":"i kamap,","poem":3},{"text":"bai mi amamas na belgut.","poem":2},{"text":"Long wanem, Bikpela em i God","poem":1},{"text":"na em i save kisim bek mi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"em i save givim strong long mi.","poem":2},{"text":"Em i mekim lek bilong mi i strong","poem":1},{"text":"olsem lek bilong ol wel abus","poem":3},{"text":"na em i mekim mi i wokabaut","poem":2},{"text":"antap long ol maunten.","poem":3}]}],"footnotes":[{"noteId":2,"caller":"+","text":"3.1 Long tok Hibru dispela tok bilong man i bosim musik, em i stap long pinis bilong lain 19.","reference":{"chapter":3,"verse":1}},{"noteId":3,"caller":"+","text":"3.6 Tok Hibru i no klia tumas long dispela hap.","reference":{"chapter":3,"verse":6}},{"noteId":4,"caller":"+","text":"3.16 Tok Hibru i no klia tumas long dispela hap.","reference":{"chapter":3,"verse":16}}]},"thisChapterLink":"/api/tpi_png/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":18}