{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"ISA","translationId":"tpi_png","name":"AISAIA","commonName":"AISAIA","title":"Buk bilong Profet Aisaia","order":23,"numberOfChapters":66,"sha256":"c773e407ce358b8fa6787264ed1b07e790735a1c39d03e89e7439d36986b8cdf","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tpi_png/ISA/66.json","totalNumberOfVerses":1263},"chapter":{"number":12,"content":[{"type":"heading","content":["Song bilong tenkyu"]},{"type":"verse","number":1,"content":["Long dispela taim yupela Israel bai i singim song olsem,",{"text":"“Bikpela, mi litimapim nem","poem":1},{"text":"bilong yu.","poem":2},{"text":"Yu bin belhat long mi,","poem":1},{"text":"tasol belhat bilong yu i pinis,","poem":2},{"text":"na yu mekim gut long mi.","poem":3},{"text":"Na nau bel bilong mi i stap gut.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“God i bin kisim bek mi.","poem":1},{"text":"Na bai mi bilip strong long em","poem":2},{"text":"na mi no ken pret.","poem":3},{"text":"God, Bikpela i save mekim mi","poem":1},{"text":"i stap strong","poem":3},{"text":"na mi singim song","poem":2},{"text":"bilong litimapim nem bilong en.","poem":3},{"text":"Long wanem, em i bin kisim bek mi.”","poem":1}]},{"type":"verse","number":3,"content":["Hul wara i no save pinis, em i save givim wara long ol samting, na ol i stap gut. Bikpela i olsem dispela wara i no save pinis. Oltaim em i save helpim yupela na mekim yupela i stap strong. Olsem na yupela bai i amamas long i go long Bikpela na askim em long helpim yupela."]},{"type":"verse","number":4,"content":["Na long dispela taim bai yupela i singim song olsem,",{"text":"“Kolim nem bilong Bikpela","poem":1},{"text":"na singaut long em","poem":2},{"text":"na tok tenkyu long em.","poem":3},{"text":"Tokaut long olgeta lain manmeri","poem":1},{"text":"long ol bikpela wok","poem":2},{"text":"em i bin mekim,","poem":3},{"text":"na tokim ol long em i gat biknem.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Singim ol song","poem":1},{"text":"na litimapim nem bilong Bikpela.","poem":2},{"text":"Em i kisim biknem","poem":1},{"text":"long ol gutpela gutpela wok","poem":2},{"text":"em i mekim.","poem":3},{"text":"Tokim olgeta lain manmeri","poem":1},{"text":"long ol gutpela gutpela wok","poem":2},{"text":"bilong en.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"God bilong Israel","poem":1},{"text":"em i God bilong mekim gutpela","poem":2},{"text":"na stretpela pasin olgeta.","poem":3},{"text":"Em i gat biknem","poem":1},{"text":"na em i stap wantaim yupela","poem":2},{"text":"ol manmeri bilong Saion.","poem":3},{"text":"Olsem na yupela i mas amamas","poem":1},{"text":"na singaut strong","poem":2},{"text":"na singim song long em.”","poem":3}]},{"type":"heading","content":["(Sapta 13-23)"]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}