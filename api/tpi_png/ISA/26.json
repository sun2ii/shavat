{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"ISA","translationId":"tpi_png","name":"AISAIA","commonName":"AISAIA","title":"Buk bilong Profet Aisaia","order":23,"numberOfChapters":66,"sha256":"c773e407ce358b8fa6787264ed1b07e790735a1c39d03e89e7439d36986b8cdf","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tpi_png/ISA/66.json","totalNumberOfVerses":1263},"chapter":{"number":26,"content":[{"type":"heading","content":["God bai i mekim ol manmeri bilong en i win"]},{"type":"verse","number":1,"content":["Wanpela taim bai i kamap bihain, na ol manmeri i stap long graun bilong Juda ol bai i singim dispela song.",{"text":"Taun bilong mipela i strongpela tru.","poem":1},{"lineBreak":true},{"text":"God yet em i stap strongpela banis","poem":1},{"text":"bilong mipela.","poem":3},{"text":"Em i kisim bek mipela pinis","poem":1},{"text":"na mekim mipela i win.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Opim ol bikpela dua bilong taun,","poem":1},{"text":"bai ol stretpela manmeri","poem":2},{"text":"i ken i kam insait.","poem":3},{"text":"Oltaim ol dispela lain","poem":1},{"text":"i save aninit long Bikpela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bikpela, ol i stap aninit long yu","poem":1},{"text":"na tingting bilong ol","poem":2},{"text":"i stap strong long yu tasol.","poem":3},{"text":"Olsem na yu save mekim pasin bel isi","poem":1},{"text":"i pulap tru long ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bikpela em i strongpela ples hait","poem":1},{"text":"bilong yumi.","poem":3},{"text":"Na em bai i stap olsem oltaim.","poem":2},{"text":"Olsem na yumi mas bilip tru long em","poem":1},{"text":"na aninit long em oltaim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bikpela i save daunim","poem":1},{"text":"ol manmeri i gat biknem.","poem":2},{"text":"Na em i save brukim","poem":1},{"text":"ol strongpela taun,","poem":3},{"text":"na ol i pundaun olgeta long graun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol dispela manmeri i bin mekim nogut","poem":1},{"text":"long ol rabisman,","poem":3},{"text":"na tarangu ol i sot tru","poem":2},{"text":"long ol samting.","poem":3},{"text":"Tasol nau ol rabisman i krungutim","poem":1},{"text":"na wokabaut antap","poem":2},{"text":"long ol hip pipia","poem":3},{"text":"bilong ol taun i bagarap pinis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rot ol stretpela manmeri","poem":1},{"text":"i wokabaut long en,","poem":3},{"text":"em i stap stret tasol.","poem":2},{"text":"Bikpela, yu stretpela God","poem":1},{"text":"na yu save stretim rot","poem":2},{"text":"ol i wokabaut long en.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, mipela i wokabaut","poem":1},{"text":"bihainim ol lo bilong yu","poem":3},{"text":"na mipela i lukluk long yu","poem":2},{"text":"na wetim yu tasol.","poem":3},{"text":"Mipela i laikim tumas","poem":1},{"text":"biknem bilong yu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Long nait, tingting bilong mi","poem":1},{"text":"i stap long yu tasol","poem":3},{"text":"na mi laikim tumas","poem":2},{"text":"long i stap wantaim yu,","poem":3},{"text":"long wanem, yu save kotim","poem":2},{"text":"ol manmeri bilong graun,","poem":3},{"text":"bilong skulim ol","poem":2},{"text":"long stretpela pasin bilong yu.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Tasol sapos yu marimari","poem":1},{"text":"long ol manmeri nogut,","poem":3},{"text":"bai ol i no kisim save","poem":2},{"text":"long ol stretpela pasin.","poem":3},{"text":"Maski ol i stap long graun","poem":1},{"text":"bilong ol stretpela manmeri,","poem":3},{"text":"ol bai i go het","poem":2},{"text":"long mekim ol pasin nogut","poem":3},{"text":"na bai ol i no tingim biknem","poem":2},{"text":"na strong bilong yu","poem":3},{"text":"na bai ol i no aninit long yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela, yu apim han bilong yu pinis","poem":1},{"text":"bilong mekim save","poem":2},{"text":"long ol manmeri nogut.","poem":3},{"text":"Tasol ol i no lukim.","poem":2},{"text":"Bikpela, larim ol i lukim olsem,","poem":1},{"text":"yu save laikim tumas long helpim","poem":2},{"text":"ol manmeri bilong yu.","poem":3},{"text":"Na bai ol man nogut i sem nogut tru.","poem":2},{"text":"Na dispela paia yu redim pinis","poem":1},{"text":"bilong ol birua bilong yu","poem":2},{"text":"i ken kukim olgeta dispela lain.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela, yu save kamapim","poem":1},{"text":"gutpela taim namel long mipela.","poem":2},{"text":"Yu save stiaim olgeta wok","poem":1},{"text":"bilong mipela","poem":3},{"text":"na mekim ol i kamap gutpela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"God, Bikpela bilong mipela,","poem":1},{"text":"ol arapela bikman","poem":2},{"text":"i bin bosim mipela,","poem":3},{"text":"tasol mipela i save givim biknem","poem":2},{"text":"long yu wanpela tasol.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Nau ol dispela bikman i dai pinis.","poem":1},{"text":"Ol i no i stap moa,","poem":2},{"text":"na bai ol i no inap kirap bek.","poem":3},{"text":"Yu bin daunim strong bilong ol","poem":1},{"text":"na mekim save tru long ol","poem":2},{"text":"na ol i bin bagarap olgeta.","poem":3},{"text":"Na ol manmeri i no tingim moa","poem":1},{"text":"nem bilong ol.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bikpela, yu surikim tru ol mak","poem":1},{"text":"bilong graun bilong mipela,","poem":3},{"text":"na mekim kantri bilong mipela","poem":2},{"text":"i kamap bikpela tru.","poem":3},{"text":"Na dispela i mekim biknem bilong yu","poem":1},{"text":"i kamap bikpela moa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bikpela, yu bin mekim save","poem":1},{"text":"long ol manmeri bilong yu,","poem":3},{"text":"na strong bilong ol i pinis.","poem":2},{"text":"Tasol ol i bin kam long yu","poem":1},{"text":"wantaim bikpela sori","poem":2},{"text":"na ol i bin beten long yu.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Long ai bilong yu,","poem":1},{"text":"mipela i bin i stap","poem":2},{"text":"olsem meri i pilim pen","poem":3},{"text":"bilong karim pikinini.","poem":4},{"text":"Mipela i bin karim","poem":1},{"text":"bikpela pen na hevi","poem":3},{"text":"na mipela i bin ting","poem":2},{"text":"wanpela gutpela samting","poem":3},{"text":"bai i kamap.","poem":4},{"text":"Tasol nogat. Mipela i no kamapim","poem":1},{"text":"wanpela samting.","poem":2},{"text":"Mipela i no bin i gat strong","poem":1},{"text":"bilong daunim ol birua","poem":3},{"noteId":42},{"text":"na mekim gutpela sindaun i kamap","poem":2},{"text":"long graun bilong mipela.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Tasol ol dispela lain bilong yu","poem":1},{"text":"i dai pinis","poem":2},{"text":"na ol i stap long ples tudak,","poem":3},{"text":"ol bai i kirap bek","poem":2},{"text":"na lukim lait.","poem":3},{"text":"Yu save givim laip","poem":1},{"text":"long ol man i dai pinis,","poem":3},{"text":"olsem wara bilong nait","poem":2},{"text":"i pundaun long graun i drai","poem":3},{"text":"na i mekim ol nupela gras i kamap.","poem":2},{"lineBreak":true},{"text":"Yupela ol lain i slip long matmat,","poem":1},{"text":"yupela kirap na amamas na singaut.","poem":2}]},{"type":"heading","content":["Bikpela i mekim save long ol manmeri bilong en na i mekim ol i stap gut gen"]},{"type":"verse","number":20,"content":["Yupela ol manmeri bilong mi, yupela go insait long ol haus bilong yupela na pasim ol dua. Yupela i mas hait i stap liklik taim tasol inap belhat bilong Bikpela i pinis."]},{"type":"verse","number":21,"content":["Bikpela i lusim pinis ples bilong em long heven na i kam nau, bilong mekim save long ol manmeri bilong graun, na bekim asua bilong ol sin bilong ol. Na graun bai i no inap haitim moa blut bilong ol man ol arapela i bin kilim i dai. Nogat. Em bai i kamapim olgeta pasin nogut ol man i bin mekim."]}],"footnotes":[{"noteId":42,"caller":"+","text":"26.17-18 Tok Hibru i no klia tumas long dispela hap.","reference":{"chapter":26,"verse":17}}]},"thisChapterLink":"/api/tpi_png/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":20}