{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"JDG","translationId":"tpi_png","name":"HETMAN","commonName":"HETMAN","title":"Ol Hetman bilong Israel","order":7,"numberOfChapters":21,"sha256":"937b6ce984d91ac8de3419140eafa464aef0754fed4ac8c098fabcc0367f0b73","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/tpi_png/JDG/21.json","totalNumberOfVerses":604},"chapter":{"number":5,"content":[{"type":"heading","content":["Song bilong Debora na Barak"]},{"type":"verse","number":1,"content":["Long dispela de Debora na Barak, pikinini bilong Abinoam, tupela i singim dispela song,"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Litimapim nem bilong Bikpela.","poem":1},{"lineBreak":true},{"text":"Ol Israel i tingting strong long pait.","poem":1},{"lineBreak":true},{"text":"Olgeta man i amamas","poem":1},{"text":"na ol i laik pait.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Harim, yupela ol king.","poem":1},{"lineBreak":true},{"text":"Putim yau gut, yupela ol hetman.","poem":1},{"lineBreak":true},{"text":"Bai mi singim wanpela song","poem":1},{"text":"na mekim musik long God,","poem":2},{"text":"Bikpela bilong yumi Israel.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Bikpela, taim yu lusim","poem":1},{"text":"ol maunten bilong Seir,","poem":3},{"text":"em kantri Idom,","poem":4},{"text":"na yu kam daun,","poem":3},{"text":"orait graun i guria","poem":2},{"text":"na ren i kam daun.","poem":3},{"text":"Tru tumas, wara i stap long ol klaut","poem":1},{"text":"i kapsait na i kam daun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ol maunten i guria","poem":1},{"text":"long ai bilong God,","poem":2},{"text":"Bikpela bilong Sainai,","poem":3},{"text":"long ai bilong God,","poem":2},{"text":"Bikpela bilong yumi Israel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Long taim bilong Samgar,","poem":1},{"text":"pikinini bilong Anat,","poem":3},{"text":"na long taim bilong Jael,","poem":2},{"lineBreak":true},{"text":"ol bisnisman i pret long ol raskol","poem":2},{"text":"na ol i no moa wokabaut","poem":3},{"text":"long ol bikpela rot.","poem":4},{"text":"Ol man i mas wokabaut i go i kam,","poem":1},{"text":"ol i save hait","poem":2},{"text":"na bihainim ol liklik rot tasol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Debora, ol Israel i no mekim","poem":1},{"text":"wanpela samting.","poem":2},{"text":"Ol i stap nating","poem":1},{"text":"inap long taim yu kamap.","poem":2},{"text":"Na yu olsem wanpela mama","poem":1},{"text":"bilong lukautim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Taim ol Israel","poem":1},{"text":"i bihainim ol nupela god,","poem":3},{"text":"pait i kamap long ol.","poem":2},{"text":"Ol Israel i gat 40,000 man","poem":1},{"text":"bilong pait,","poem":3},{"text":"tasol i no gat wanpela","poem":2},{"text":"i karim hap plang bilong pait","poem":3},{"lineBreak":true},{"text":"na i holim spia.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tingting bilong mi i stap wantaim","poem":1},{"text":"ol ofisa bilong ami bilong Israel,","poem":2},{"lineBreak":true},{"text":"na wantaim ol dispela man","poem":2},{"text":"i laik pait.","poem":3},{"text":"Litimapim nem bilong Bikpela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yupela man i save sindaun","poem":1},{"text":"long satel","poem":2},{"text":"long ol waitpela donki,","poem":3},{"text":"na yupela man i save wokabaut","poem":2},{"text":"long lek,","poem":3},{"text":"yupela i mas tokaut","poem":2},{"text":"long dispela samting.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Harim. Ol lain manmeri i bung","poem":1},{"text":"long ol hul wara","poem":3},{"text":"na i givim wara","poem":2},{"text":"long ol sipsip samting,","poem":3},{"text":"ol i tokaut long Bikpela i win.","poem":2},{"text":"Ol i tokaut","poem":1},{"text":"long ol man bilong Israel i win.","poem":2},{"text":"Na ol manmeri bilong Bikpela","poem":1},{"text":"i lusim taun bilong ol","poem":2},{"text":"na ol i kam daun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yu go pas, Debora, yu go pas.","poem":1},{"text":"Yu go pas na singim wanpela song.","poem":2},{"text":"Na yu go pas, Barak,","poem":1},{"text":"pikinini bilong Abinoam.","poem":2},{"text":"Yu kirap na wokabaut.","poem":1},{"text":"Yu kisim ol kalabusman i go.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ol gutpela man bilong pait","poem":1},{"text":"i kam bung long ol lida bilong ol.","poem":2},{"text":"Ol man bilong Bikpela","poem":1},{"text":"i kam long em","poem":2},{"text":"na ol i redi long pait.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Ol Efraim i kam daun","poem":1},{"text":"na wokabaut i go long ples stret.","poem":2},{"text":"Ol i bihainim ol man","poem":1},{"text":"bilong lain Benjamin.","poem":2},{"text":"Ol hetman bilong lain Makir","poem":1},{"text":"i kam daun","poem":3},{"text":"na ol ofisa bilong Sebulun","poem":2},{"text":"i kam daun.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ol lida bilong Isakar","poem":1},{"text":"i kam wantaim Debora.","poem":3},{"text":"Na Barak tu i go wantaim ol.","poem":2},{"text":"Ol Isakar i bihainim em","poem":1},{"text":"i go long ples stret.","poem":2},{"text":"Tasol ol man bilong Ruben","poem":1},{"text":"i gat tupela tingting","poem":2},{"text":"na ol i no inap i go.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Bilong wanem yupela ol Ruben","poem":1},{"text":"i stap wantaim ol sipsip?","poem":2},{"text":"Ating yupela i save laikim tumas","poem":1},{"text":"long harim ol wasman","poem":2},{"text":"i singautim ol sipsip, a?","poem":3},{"text":"Tru tumas, ol man bilong Ruben","poem":1},{"text":"i gat tupela tingting.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ol lain bilong Gat","poem":1},{"text":"i stap long wara Jordan","poem":2},{"text":"long hap sankamap.","poem":3},{"text":"Tasol bilong wanem lain bilong Dan","poem":1},{"text":"i wok long ol sip?","poem":2},{"text":"Lain bilong Aser","poem":1},{"text":"i stap long nambis bilong solwara.","poem":2},{"text":"Ol i stap nating","poem":1},{"text":"long nambis bilong ol yet.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tasol ol man bilong lain Sebulun","poem":1},{"text":"na lain Naptali,","poem":3},{"text":"klostu ol i kisim bagarap","poem":2},{"text":"long ples bilong pait.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ol king i kam long taun Tanak,","poem":1},{"text":"ol i pait klostu long wara","poem":2},{"text":"bilong Megido.","poem":3},{"text":"Ol king bilong Kenan i pait,","poem":1},{"text":"tasol ol i no win.","poem":3},{"text":"Ol i no kisim sampela silva i go.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ol sta long skai i pait.","poem":1},{"lineBreak":true},{"text":"Ol i bihainim rot bilong ol antap,","poem":1},{"text":"na ol i pait long Sisera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tait bilong wara Kison","poem":1},{"text":"i karim ol i go.","poem":2},{"text":"Dispela wara i stap bipo yet,","poem":1},{"text":"tait bilong en i strong tumas.","poem":2},{"lineBreak":true},{"text":"Bai mi taitim bun","poem":1},{"text":"na wokabaut strong i go.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Na ol hos i save ran i go kwiktaim,","poem":1},{"text":"ol i paitim graun","poem":2},{"text":"long lek bilong ol.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Ensel bilong Bikpela i tok,","poem":1},{"text":"“Taun Meros i mas kisim bagarap.","poem":2},{"lineBreak":true},{"text":"Na ol man i stap long dispela taun","poem":2},{"text":"ol tu i mas kisim bagarap.","poem":3},{"text":"Long wanem, ol i no bin i kam","poem":2},{"text":"bilong helpim Bikpela.","poem":3},{"text":"Ol i no i kam olsem ol soldia","poem":2},{"text":"bilong helpim Bikpela long pait.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Jael, meri bilong Heber","poem":1},{"text":"long lain bilong Kin,","poem":3},{"text":"em i ken amamas.","poem":2},{"text":"Amamas bilong en","poem":1},{"text":"i ken winim amamas","poem":2},{"text":"bilong ol arapela meri i save stap","poem":3},{"text":"long ol haus sel.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Sisera i bin askim em long wara,","poem":1},{"text":"tasol Jael i givim em susu.","poem":2},{"text":"Em i bringim gutpela susu i gat gris","poem":1},{"text":"long wanpela kap i luk nais tru.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Long wanpela han em i kisim","poem":1},{"text":"wanpela nil diwai","poem":2},{"text":"bilong pasim baklain","poem":3},{"text":"bilong haus sel,","poem":4},{"text":"na long narapela han em i holim","poem":2},{"text":"hama bilong ol wokman.","poem":3},{"text":"Em i paitim Sisera","poem":1},{"text":"na brukim het bilong en.","poem":2},{"text":"Em i sutim het bilong en","poem":1},{"text":"na brukim olgeta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sisera i pundaun","poem":1},{"text":"long skru bilong em,","poem":3},{"text":"na slip i stap","poem":2},{"text":"klostu long lek bilong Jael.","poem":3},{"text":"Em i pundaun na i dai pinis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mama bilong Sisera","poem":1},{"text":"i sanap long windo","poem":2},{"text":"na i lukluk i go.","poem":3},{"text":"Em i putim ai long hul bilong blain,","poem":1},{"text":"na lukluk i go.","poem":2},{"text":"Na em i tok,","poem":1},{"text":"“Bilong wanem karis bilong Sisera","poem":2},{"text":"i no kam kwik?","poem":3},{"text":"Bilong wanem ol hos bilong en","poem":2},{"text":"i no kam hariap?”","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Wanpela savemeri bilong en","poem":1},{"text":"i bekim tok olsem,","poem":3},{"text":"“Ating ol soldia i wok yet","poem":2},{"text":"long painim ol gutpela samting","poem":3},{"text":"na tilim.","poem":4},{"text":"Wanpela o tupela yangpela meri","poem":2},{"text":"bilong wan wan soldia,","poem":3},{"text":"na gutpela klos bilong Sisera","poem":2},{"lineBreak":true},{"text":"na ol naispela laplap","poem":2},{"text":"bilong bilasim","poem":3},{"text":"ol dispela yangpela meri.”","poem":4},{"text":"Na mama bilong Sisera tu","poem":1},{"text":"i tingting olsem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bikpela, olsem tasol","poem":1},{"text":"ol birua bilong yu i ken i dai.","poem":2},{"text":"Tasol ol pren bilong yu i ken lait","poem":1},{"text":"olsem lait bilong san i kamap.","poem":2},"Na bihain, ol Israel i no gat pait moa inap long 40 yia."]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}