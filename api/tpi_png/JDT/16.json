{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"JDT","translationId":"tpi_png","name":"JUDIT","commonName":"JUDIT","title":"Buk bilong Judit","order":68,"numberOfChapters":16,"isApocryphal":true,"sha256":"1b1d193e9b7c133afcf319f5cd355211b4271bd846a52b874c6ab4a3524d2ec9","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/JDT/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/tpi_png/JDT/16.json","totalNumberOfVerses":337},"chapter":{"number":16,"content":[{"type":"heading","content":["Prea bilong Judit"]},{"type":"verse","number":1,"content":["Olgeta Israel i stap wantaim Judit, na Judit i kirapim dispela singsing bilong tenkyu, na olgeta manmeri i bihainim maus bilong em."]},{"type":"verse","number":2,"content":[{"text":"“Yumi singsing long God bilong mi,","poem":1},{"text":"na paitim garamut.","poem":2},{"text":"Yumi singsing long Bikpela","poem":1},{"text":"wantaim ol kundu.","poem":2},{"text":"Litimapim nem bilong em","poem":1},{"text":"long nupela song.","poem":2},{"text":"Givim biknem long em","poem":1},{"text":"na kolim nem bilong em.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Long wanem, Bikpela","poem":1},{"text":"em i God bilong pinisim pait.","poem":2},{"text":"Em i kisim bek mi","poem":1},{"text":"long han bilong ol birua,","poem":3},{"text":"na em i putim mi bek long kem","poem":2},{"text":"bilong ol manmeri bilong em.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol Asiria i lusim","poem":1},{"text":"ol maunten long Not","poem":2},{"text":"na ol i kam daun.","poem":3},{"text":"Lain soldia bilong ol i moa yet,","poem":1},{"text":"na i pasim ol ples daun.","poem":2},{"text":"Na ol soldia i sindaun long ol hos","poem":1},{"text":"i karamapim ol maunten.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol i laik pretim mipela","poem":1},{"text":"na ol i tok olsem","poem":2},{"text":"ol bai i kukim graun bilong mipela.","poem":3},{"text":"Na ol bai i kilim ol yangpela man","poem":1},{"text":"long bainat.","poem":2},{"text":"Na ol bai i tromoim ol bebi","poem":1},{"text":"i go long graun.","poem":2},{"text":"Na ol bai i pulim ol pikinini","poem":1},{"text":"i go kalabus.","poem":2},{"text":"Na ol bai i spoilim ol yangpela meri","poem":1},{"text":"bilong mipela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tasol Bikpela I Gat Olgeta Strong","poem":1},{"text":"em i daunim ol","poem":2},{"text":"long han bilong wanpela meri.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"I no ol yangpela man","poem":1},{"text":"i bin bagarapim","poem":2},{"text":"bikman bilong ol. Nogat.","poem":3},{"text":"Na i no wanpela strongpela man","poem":1},{"text":"i kilim em i dai.","poem":3},{"text":"Nogat.","poem":2},{"text":"Judit wanpela tasol,","poem":1},{"text":"em pikinini bilong Merari,","poem":3},{"text":"em i trikim em","poem":2},{"text":"long naispela pes bilong em.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Em i rausim","poem":1},{"text":"klos bilong sori bilong em,","poem":3},{"text":"na em i litimapim","poem":2},{"text":"ol tarangu manmeri bilong Israel.","poem":3},{"text":"Em i welim pes bilong em yet","poem":1},{"text":"long sanda,","poem":3},{"text":"na em i pasim gras bilong em","poem":2},{"text":"long wanpela naispela laplap,","poem":3},{"text":"na i putim naispela klos","poem":2},{"text":"bilong grisim em.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bikpela lida i aigris","poem":1},{"text":"long lek bilong Judit,","poem":3},{"text":"na i lukim em i naispela meri moa.","poem":2},{"text":"Orait na bainat","poem":1},{"text":"i katim nek bilong em.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ol man bilong Persia","poem":1},{"text":"i guria long strong","poem":2},{"text":"bilong dispela meri.","poem":3},{"text":"Ol man bilong Midia i lukim em","poem":1},{"text":"i no pret long wanpela man,","poem":2},{"text":"na ol i seksek tru.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol lain bilong mipela","poem":1},{"text":"i bagarap bipo,","poem":3},{"text":"nau ol i amamas","poem":2},{"text":"na ol i singaut strong,","poem":3},{"text":"na ol birua i guria.","poem":2},{"text":"Ol i bikmaus tru,","poem":1},{"text":"na ol birua i ranawe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mipela ol pikinini","poem":1},{"text":"bilong ol wokmeri nating","poem":2},{"text":"i kilim ol i dai.","poem":3},{"text":"Mipela i sutim ol","poem":1},{"text":"olsem ol kalabusman i laik ranawe.","poem":2},{"text":"Ol i pinis olgeta","poem":1},{"text":"long han bilong ol ami","poem":2},{"text":"bilong Bikpela.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Bai mi singim wanpela nupela song","poem":1},{"text":"long God bilong mi.","poem":2},{"text":"Bikpela, yu moa moa yet.","poem":1},{"text":"Namba bilong yu i win tru.","poem":2},{"text":"Yu strong olgeta,","poem":1},{"text":"na i no gat wanpela samting","poem":2},{"text":"inap long winim yu. Nogat tru.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Olgeta samting yu wokim pinis","poem":1},{"text":"i mas i stap aninit long yu.","poem":2},{"text":"Yu bin tok tasol na ol i kamap.","poem":1},{"lineBreak":true},{"text":"Yu winim win bilong yu","poem":1},{"text":"na wantu ol samting","poem":2},{"text":"i kamap gutpela tru.","poem":3},{"text":"I no gat wanpela man","poem":1},{"text":"i ken sakim tok bilong yu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ol maunten na ol biksolwara","poem":1},{"text":"i save seksek.","poem":2},{"text":"Taim yu kamap klostu,","poem":1},{"text":"ol traipela ston","poem":2},{"text":"i save kamap wara nating.","poem":3},{"text":"Tasol yu save marimari long ol man","poem":1},{"text":"i bihainim tok bilong yu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Switpela smel bilong ofa","poem":1},{"text":"em i samting nating.","poem":2},{"text":"Na gris bilong bulmakau","poem":1},{"text":"ol i kukim long alta,","poem":3},{"text":"em i pipia nating.","poem":2},{"text":"Tasol man i bihainim tok","poem":1},{"text":"bilong Bikpela,","poem":3},{"text":"em i samting tru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wanem ol kantri i laik pait","poem":1},{"text":"long ol manmeri bilong mi,","poem":3},{"text":"ol i mas lukaut.","poem":2},{"text":"Bikpela I Gat Olgeta Strong","poem":1},{"text":"bai i bekim long ol","poem":2},{"text":"long de bilong bikpela kot.","poem":3},{"text":"Em bai i salim paia i go long ol,","poem":1},{"text":"na ol liklik snek","poem":2},{"text":"bai i kaikaim skin bilong ol.","poem":3},{"text":"Na bai ol i karim pen","poem":1},{"text":"na krai oltaim.”","poem":2}]},{"type":"heading","content":["Judit i gat biknem"]},{"type":"verse","number":18,"content":["Orait taim ol manmeri i kamap long Jerusalem, ol i lotu long God. Ol manmeri i kamap klin pinis long ai bilong God, orait ol i mekim ol ofa bilong paia i kukim olgeta na ol ofa ol manmeri i promis long givim long Bikpela na ol ofa ol i bringim long laik bilong ol yet."]},{"type":"verse","number":19,"content":["Olgeta samting bilong Holofernes, em ol manmeri i bin givim long Judit, Judit i givim long God. Na dispela taunam Judit yet i bin kisim long rum slip bilong Holofernes, em tu em i givim long God."]},{"type":"verse","number":20,"content":["Inap long tripela mun, ol manmeri i amamas i stap long Jerusalem klostu long tempel, na Judit tu i stap wantaim ol."]},{"type":"verse","number":21,"content":["Ol dispela de bilong amamas i pinis, orait olgeta manmeri i go bek long ples bilong ol. Na Judit i go bek long Betulia na i sindaun i stap long graun bilong em yet. Na stat long dispela taim i go inap em i dai, em i gat biknem long olgeta hap bilong Israel."]},{"type":"verse","number":22,"content":["Planti man i laik maritim em, long wanem, Manase man bilong en i dai pinis, na ol i bin planim em wantaim ol tumbuna bilong em. Tasol Judit i no marit moa inap em i dai."]},{"type":"verse","number":23,"content":["Nem bilong en i kamap bikpela moa. Na em i sindaun long haus bilong man bilong em inap em i gat 105 yia. Em i larim wokmeri nating bilong en i go fri. Na em i dai long Betulia na ol i planim em long matmat bilong man bilong em, Manase."]},{"type":"verse","number":24,"content":["Ol manmeri bilong Israel i krai sori long Judit inap long 7-pela de. Taim em i no dai yet, em i tilim ol samting bilong em i go long ol lain bilong man bilong em, Manase, na tu long ol wanlain bilong em yet."]},{"type":"verse","number":25,"content":["Long taim Judit i stap, na planti yia bihain long taim em i dai, i no gat wanpela man inap long pretim ol manmeri bilong Israel."]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/JDT/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/ESG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/JDT/15.json","previousChapterAudioLinks":{},"numberOfVerses":25}