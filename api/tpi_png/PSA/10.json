{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":10,"content":[{"type":"heading","content":["Man i beten bai God i helpim em10.0 Sampela man i ting Song 10 em i namba 2 hap bilong Song 9."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, bilong wanem","poem":1},{"text":"yu sanap i stap","poem":2},{"text":"longwe long mi?","poem":3},{"text":"Bilong wanem yu save hait long mi","poem":1},{"text":"long taim nogut?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ol man nogut i save hambak","poem":1},{"text":"na ranim ol rabisman","poem":2},{"text":"bilong bagarapim ol.","poem":3},{"text":"Ol i ken pundaun long ol hul","poem":1},{"text":"ol yet i bin wokim","poem":2},{"text":"bilong holimpas ol arapela man.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Man nogut i save hambak nabaut","poem":1},{"text":"long laik nogut bilong em.","poem":2},{"text":"Man i save mangalim","poem":1},{"text":"planti samting,","poem":3},{"text":"em i save tok nogut long Bikpela","poem":2},{"lineBreak":true},{"text":"na givim baksait long em.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Man nogut i ting em i save pinis","poem":1},{"text":"long olgeta samting.","poem":2},{"text":"Em i save tok olsem,","poem":1},{"text":"“God i no ken bekim","poem":2},{"text":"rong bilong mi.","poem":3},{"text":"Em i no save wari","poem":2},{"text":"long ol pasin mi mekim.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Olgeta samting em i mekim,","poem":1},{"text":"i save kamap gutpela.","poem":2},{"text":"Bikpela, dispela man i no save liklik","poem":1},{"text":"long ol tingting bilong yu.","poem":2},{"text":"Em i save tok bilas","poem":1},{"text":"long ol birua bilong en.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Em i save ting olsem,","poem":1},{"text":"“Mi sanap strong.","poem":2},{"lineBreak":true},{"text":"I no gat wanpela samting","poem":2},{"text":"inap sakim mi liklik.","poem":3},{"text":"Bai mi no inap painim hevi.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oltaim em i save tok nogut","poem":1},{"text":"bilong bagarapim ol arapela man.","poem":2},{"text":"Em i save tok giaman na autim tok","poem":1},{"text":"bilong pretim ol arapela man.","poem":2},{"text":"Kwiktaim em i save toktok","poem":1},{"text":"long mekim pasin nogut","poem":2},{"lineBreak":true},{"text":"na ol kain kain trabel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dispela man i save sindaun hait","poem":1},{"text":"insait long ples,","poem":3},{"text":"na i wetim gutpela man i kam","poem":2},{"lineBreak":true},{"text":"bai em i ken kilim em i dai.","poem":2},{"text":"Em i save hait na was","poem":1},{"text":"bilong bagarapim man","poem":2},{"text":"i no gat strong.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i save hait na was i stap","poem":1},{"text":"olsem laion i was i stap","poem":2},{"text":"insait long hul bilong en.","poem":3},{"text":"Em i save hait na was i stap","poem":1},{"text":"bilong holimpas ol rabisman.","poem":2},{"text":"Em i save holimpas ol","poem":1},{"text":"long umben bilong en","poem":3},{"text":"na pulim ol i go.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Em i save sindaun isi na wet i stap,","poem":1},{"text":"na wantu ol man i no gat strong","poem":2},{"text":"ol i bagarap tru.","poem":3},{"text":"Bikpela strong bilong man nogut","poem":1},{"text":"i winim ol.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Man nogut i save tingting olsem,","poem":1},{"text":"“God i no save wari","poem":2},{"text":"long ol pasin bilong mi.","poem":3},{"text":"Em i no inap lukim mi.","poem":2},{"lineBreak":true},{"text":"Em i pasim pinis ai bilong en.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela, yu kam.","poem":1},{"lineBreak":true},{"text":"God, mekim save long dispela man.","poem":1},{"lineBreak":true},{"text":"Yu no ken lusim tingting","poem":1},{"text":"long ol man i karim hevi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Man nogut i givim baksait long yu","poem":1},{"text":"na long bel bilong en","poem":2},{"text":"em i save tingting olsem,","poem":3},{"text":"“God i no inap bekim","poem":2},{"text":"ol rong bilong mi.”","poem":3},{"text":"Yu no laik pinisim tru","poem":1},{"text":"dispela kain tingting?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tasol yu save lukim pasin","poem":1},{"text":"bilong ol man nogut.","poem":2},{"text":"Yu save long pen na hevi","poem":1},{"text":"ol i givim","poem":2},{"text":"long ol arapela manmeri,","poem":3},{"text":"na yu redi long helpim","poem":2},{"text":"ol dispela lain i gat hevi.","poem":3},{"text":"Oltaim yu save helpim ol rabisman,","poem":1},{"text":"na man i no gat strong","poem":2},{"text":"i save putim em yet","poem":3},{"text":"long han bilong yu.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Yu mas pinisim strong","poem":1},{"text":"bilong ol man nogut","poem":3},{"text":"na bai yu no inap lukim moa","poem":2},{"text":"dispela rabis pasin ol i save mekim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bikpela i stap king","poem":1},{"text":"inap oltaim oltaim.","poem":2},{"text":"Em bai i rausim ol haiden","poem":1},{"text":"long graun bilong em","poem":3},{"text":"na bai ol i lus olgeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bikpela, bai yu harim beten","poem":1},{"text":"bilong ol manmeri","poem":2},{"text":"i aninit long yu,","poem":3},{"text":"na bai yu strongim bel bilong ol.","poem":2},{"text":"Bai yu harim krai","poem":1}]},{"type":"verse","number":18,"content":[{"text":"bilong ol pikinini i no gat papa","poem":2},{"lineBreak":true},{"text":"na bilong ol man i bel hevi.","poem":2},{"text":"Bai yu helpim ol na ol i winim kot.","poem":1},{"lineBreak":true},{"text":"Olsem bai ol man bilong graun","poem":1},{"text":"i no inap mekim nogut","poem":2},{"text":"long ol gen.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}