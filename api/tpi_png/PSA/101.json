{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":101,"content":[{"type":"heading","content":["Promis bilong king"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, mi singim song","poem":1},{"text":"long stretpela pasin","poem":3},{"text":"na long pasin","poem":2},{"text":"bilong bihainim yu tru.","poem":3},{"text":"Bikpela, mi tingting long yu","poem":1},{"text":"na mi mekim dispela song.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bai mi bihainim stretpela pasin tasol.","poem":1},{"text":"Bikpela, wanem taim","poem":2},{"text":"bai yu kam helpim mi?","poem":3},{"lineBreak":true},{"text":"Mi bai mekim stretpela pasin tasol","poem":1},{"text":"long haus bilong mi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mi no ken orait long pasin nogut.","poem":1},{"text":"Nogat tru.","poem":2},{"lineBreak":true},{"text":"Mi no laikim tru pasin bilong ol man","poem":1},{"text":"i save givim baksait long God.","poem":2},{"text":"Mi no ken wokabaut wantaim ol.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Mi no ken bihainim","poem":2},{"text":"pasin bilong giaman.","poem":3},{"text":"Na mi no ken tingting","poem":1},{"text":"long ol pasin nogut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bai mi bagarapim tru","poem":1},{"text":"man i save tok baksait","poem":2},{"text":"long ol arapela man.","poem":3},{"text":"Na bai mi no larim","poem":1},{"text":"ol bikhetman i stap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bai mi laikim ol man i bihainim God","poem":1},{"text":"na ol tasol i ken i stap wantaim mi","poem":2},{"text":"long haus bilong mi.","poem":3},{"text":"Na ol man i save mekim","poem":1},{"text":"gutpela pasin oltaim,","poem":3},{"text":"ol dispela man tasol","poem":2},{"text":"i ken mekim wok bilong mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ol man i save tok giaman,","poem":1},{"text":"ol i no ken i stap","poem":2},{"text":"long bikpela haus bilong mi.","poem":3},{"text":"Na ol man bilong giaman,","poem":1},{"text":"ol i no ken i stap wantaim mi.","poem":2},{"text":"Nogat tru.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Olgeta de","poem":1},{"text":"bai mi wok long bagarapim","poem":2},{"text":"ol man nogut","poem":3},{"text":"long kantri bilong mipela.","poem":4},{"text":"Mi bai rausim ol man","poem":1},{"text":"i save mekim pasin nogut","poem":3},{"text":"na ol i no ken i stap moa","poem":2},{"text":"long taun bilong Bikpela.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}