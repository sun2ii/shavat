{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":104,"content":[{"type":"heading","content":["God i bin wokim olgeta samting. Yumi litimapim nem bilong em."]},{"type":"verse","number":1,"content":[{"text":"Mi mas litimapim","poem":1},{"text":"nem bilong Bikpela.","poem":2},{"text":"God, Bikpela bilong mi, yu antap tru.","poem":1},{"lineBreak":true},{"text":"Yu nambawan king","poem":1},{"text":"na yu gat biknem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu save karamapim yu yet long lait","poem":1},{"text":"olsem man i karamapim","poem":2},{"text":"skin bilong en long laplap.","poem":3},{"text":"Na yu putim skai na olgeta sta i stap,","poem":1},{"text":"olsem man i sanapim haus sel","poem":2},{"text":"na taitim em long baklain","poem":3},{"text":"na i stap.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Na yu wokim haus bilong yu","poem":1},{"text":"long wara antap.","poem":2},{"text":"Ol klaut i olsem karis bilong yu,","poem":1},{"text":"na win i save karim yu i go.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yu save salim win","poem":1},{"text":"na win i bringim tok","poem":2},{"text":"bilong yu i go.","poem":3},{"text":"Na yu save mekim lait bilong klaut","poem":1},{"text":"i kamap wokman bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yu bin putim dispela graun i stap","poem":1},{"text":"long ples bilong en,","poem":2},{"text":"na graun i stap strong olgeta.","poem":3},{"text":"Em i no inap surik liklik. Nogat tru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yu bin putim solwara i stap","poem":1},{"text":"na i karamapim graun.","poem":2},{"text":"Na wara i karamapim","poem":1},{"text":"olgeta maunten.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tasol bihain yu tok strong","poem":1},{"text":"long solwara","poem":3},{"text":"na em i ranawe i go.","poem":2},{"text":"Solwara i harim yu i singaut strong,","poem":1},{"text":"na i ran i go olgeta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Solwara i lusim olgeta maunten","poem":1},{"text":"na ran i go long ples daun.","poem":2},{"text":"Yu makim dispela hap","poem":1},{"text":"bilong solwara i ken i stap long en","poem":2},{"text":"na nau em i stap olsem.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Yu putim mak pinis","poem":1},{"text":"na solwara i no ken kalapim","poem":2},{"text":"dispela mak.","poem":3},{"text":"Olsem na solwara i no inap","poem":1},{"text":"karamapim olgeta graun gen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yu save mekim wara i kamap","poem":1},{"text":"long ol hul bilong graun","poem":2},{"text":"long ples daun","poem":3},{"text":"namel long ol maunten,","poem":4},{"text":"na yu mekim wara i ran i go daun","poem":2},{"text":"long ples stret.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol wel abus i save dring","poem":1},{"text":"long dispela wara,","poem":3},{"text":"na ol wel donki tu i save dring,","poem":2},{"text":"na nek bilong ol i no drai moa.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol pisin i save wokim haus","poem":1},{"text":"long ol diwai i stap","poem":2},{"text":"long arere bilong wara,","poem":3},{"text":"na ol i sindaun","poem":2},{"text":"long ol han bilong diwai","poem":3},{"text":"na mekim toktok bilong ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yu stap long ples bilong yu antap","poem":1},{"text":"na yu save salim ren i kam daun","poem":2},{"text":"long ol maunten.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Yu save mekim gras i kamap","poem":1},{"text":"bilong ol bulmakau i ken kaikai,","poem":3},{"text":"na olkain samting","poem":2},{"text":"mipela manmeri i save planim,","poem":3},{"text":"em tu yu mekim i kamap","poem":2},{"text":"na mipela i kisim kaikai long en.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Na mipela i ken planim diwai wain","poem":1},{"text":"na wokim wain bilong dring,","poem":2},{"text":"bai bel bilong mipela i amamas.","poem":3},{"text":"Na mipela i ken kisim","poem":1},{"text":"wel bilong diwai oliv","poem":3},{"text":"na welim pes bai pes i lait.","poem":2},{"text":"Na mipela i ken planim wit","poem":1},{"text":"na wokim bret","poem":2},{"text":"bilong kaikai na strongim bodi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ren i save kam daun","poem":1},{"text":"na ol diwai bilong Lebanon","poem":2},{"text":"i save kisim planti wara.","poem":3},{"text":"Ol dispela diwai sida","poem":1},{"text":"i bilong Bikpela stret.","poem":2},{"text":"Bipo em yet i planim.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Ol pisin i save wokim haus","poem":1},{"text":"long ol dispela diwai sida.","poem":2},{"text":"Tasol pisin i gat longpela nek","poem":1},{"text":"i save wokim haus","poem":2},{"text":"long ol diwai pain.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Ol wel meme i save wokabaut","poem":1},{"text":"long ol bikpela maunten,","poem":3},{"text":"na ol mumut i hait","poem":2},{"text":"long ol bikpela ston","poem":3},{"text":"bilong ples maunten.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Yu bin wokim mun","poem":1},{"text":"na em i save makim","poem":2},{"text":"olgeta mun long yia.","poem":3},{"text":"Na san i save long taim","poem":1},{"text":"em i mas i go daun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yu save mekim tudak i kamap,","poem":1},{"text":"na long nait","poem":2},{"text":"ol wel abus i save wokabaut.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Ol yangpela laion i save painim abus","poem":1},{"text":"na ol i save singaut strong moa.","poem":2},{"text":"Ol i wok long painim abus","poem":1},{"text":"yu laik givim ol.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taim san i kamap,","poem":1},{"text":"ol i save go bek long hul bilong ol.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Na ol man i save kirap","poem":1},{"text":"na i go mekim wok bilong ol","poem":2},{"text":"inap long san i go daun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Bikpela, yu bin wokim","poem":1},{"text":"planti samting.","poem":2},{"text":"Yu gat bikpela save na yu wokim","poem":1},{"text":"olgeta dispela samting.","poem":2},{"text":"Ol samting yu bin wokim","poem":1},{"text":"i pulap tru long dispela graun.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Solwara i bikpela tru,","poem":1},{"text":"na planti bikpela pis na liklik pis","poem":2},{"text":"na ol arapela samting","poem":3},{"text":"i stap long en.","poem":4},{"text":"Mipela i no inap kaunim.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ol sip i save go i kam long solwara,","poem":1},{"text":"na ol traipela pis bipo yu wokim,","poem":3},{"text":"ol tu i save swim","poem":2},{"text":"na kalap kalap long solwara.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Olgeta i save wet long yu","poem":1},{"text":"long givim kaikai long ol","poem":2},{"text":"long taim ol i hangre.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Yu save givim kaikai long ol","poem":1},{"text":"na ol i kaikai.","poem":2},{"text":"Yu tasol yu givim ol","poem":1},{"text":"na bel bilong ol i pulap.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yu givim baksait long ol","poem":1},{"text":"na ol i save pret.","poem":2},{"text":"Na taim yu rausim win long ol,","poem":1},{"text":"ol i dai na kamap graun gen.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yu save givim win long ol","poem":1},{"text":"na ol i kisim laip.","poem":2},{"text":"Yu save mekim olgeta samting","poem":1},{"text":"i kamap nupela long graun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Biknem na laik bilong Bikpela","poem":1},{"text":"i mas i stap oltaim oltaim.","poem":2},{"text":"Na Bikpela i ken amamas","poem":1},{"text":"long olgeta samting","poem":2},{"text":"em i bin wokim.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Em i save lukluk long graun","poem":1},{"text":"na graun i guria.","poem":2},{"text":"Em i save putim han","poem":1},{"text":"long ol maunten","poem":3},{"text":"na smok i kamap","poem":2},{"text":"long ol maunten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Taim mi stap laip,","poem":1},{"text":"bai mi singim ol song","poem":2},{"text":"long Bikpela.","poem":3},{"text":"Bai mi singim ol song","poem":1},{"text":"bilong litimapim nem","poem":2},{"text":"bilong God bilong mi","poem":3},{"text":"inap long taim mi dai.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Em i save mekim mi i amamas,","poem":1},{"text":"olsem na mi laik","poem":2},{"text":"bai em i ken laikim","poem":3},{"text":"song bilong mi.","poem":4}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Bikpela, yu ken bagarapim","poem":1},{"text":"olgeta manmeri i save mekim sin.","poem":2},{"text":"Mi laik bai ol man nogut i lus tru.","poem":1},{"lineBreak":true},{"text":"Mi mas litimapim","poem":1},{"text":"nem bilong Bikpela.","poem":2},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}