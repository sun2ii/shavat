{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":106,"content":[{"type":"heading","content":["God i save mekim gutpela pasin long ol manmeri bilong en"]},{"type":"verse","number":1,"content":[{"text":"Litimapim nem","poem":1},{"text":"bilong Bikpela!","poem":2},{"text":"Yumi mas tok tenkyu long em,","poem":1},{"text":"long wanem, pasin bilong en","poem":2},{"text":"i gutpela olgeta,","poem":3},{"text":"na oltaim","poem":2},{"text":"em i save laikim yumi tumas.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Husat inap long stori","poem":1},{"text":"long ol bikpela samting","poem":2},{"text":"em i bin mekim?","poem":3},{"text":"Na husat i ken litimapim","poem":1},{"text":"nem bilong en","poem":3},{"text":"inap long gutpela pasin bilong en?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ol man i save bihainim tok","poem":1},{"text":"bilong en","poem":2},{"text":"na mekim stretpela pasin,","poem":3},{"text":"ol i ken amamas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bikpela, taim yu helpim","poem":1},{"text":"ol manmeri bilong yu,","poem":3},{"text":"yu mas tingting long mi.","poem":2},{"text":"Na taim yu kisim bek ol,","poem":1},{"text":"kisim bek mi tu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi laik lukim ol manmeri bilong yu","poem":1},{"text":"i sindaun gut","poem":2},{"text":"na i kisim ol gutpela samting,","poem":3},{"text":"na mi laik amamas wantaim ol.","poem":2},{"text":"Mipela bai i amamas,","poem":1},{"text":"long wanem, mipela i stap","poem":2},{"text":"lain bilong yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mipela i mekim sin pinis,","poem":1},{"text":"olsem bipo ol tumbuna i mekim.","poem":2},{"text":"Mipela i mekim","poem":1},{"text":"ol kain kain pasin nogut.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Long Isip ol tumbuna i no save gut","poem":1},{"text":"long ol bikpela wok yu bin mekim.","poem":2},{"text":"Yu bin helpim ol planti taim","poem":1},{"text":"na ol i save olsem yu laikim tru ol.","poem":2},{"text":"Tasol ol i lusim tingting long dispela,","poem":1},{"text":"na taim ol i kamap","poem":2},{"text":"long solwara Retsi","poem":3},{"text":"ol i bikhet long yu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tasol Bikpela i laik soim","poem":1},{"text":"bikpela strong bilong em long ol.","poem":2},{"text":"Olsem na em i kisim bek ol","poem":1},{"text":"na ol i no bagarap,","poem":2},{"text":"olsem em i bin promis long ol.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i tok strong long solwara Retsi","poem":1},{"text":"na solwara i kamap","poem":2},{"text":"olsem graun i drai.","poem":3},{"text":"Olsem na em i bringim","poem":1},{"text":"ol manmeri i go","poem":3},{"text":"na ol i brukim dispela solwara","poem":2},{"text":"olsem man i wokabaut","poem":3},{"text":"long graun i drai.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Em i kisim bek ol","poem":1},{"text":"long han bilong ol man","poem":2},{"text":"i birua long ol.","poem":3},{"text":"Em i helpim ol","poem":1},{"text":"na ol birua i no bagarapim ol.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tasol wara i karamapim ol birua","poem":1},{"text":"na ol i dai pinis.","poem":3},{"text":"Na i no gat wanpela i stap laip.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bikpela i mekim olsem,","poem":1},{"text":"na ol manmeri bilong en","poem":2},{"text":"ol i bilipim ol promis bilong en,","poem":3},{"text":"na ol i litimapim nem bilong en","poem":2},{"text":"long ol song bilong ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tasol kwiktaim ol i lusim tingting","poem":1},{"text":"long ol samting","poem":2},{"text":"Bikpela i bin mekim.","poem":3},{"text":"Na ol i no kisim","poem":1},{"text":"tok bilong God pastaim. Nogat.","poem":2},{"text":"Ol i mekim ol samting","poem":1},{"text":"long tingting bilong ol yet.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Long ples drai, bel bilong ol","poem":1},{"text":"i kirap strong long kaikai,","poem":3},{"text":"na ol i traim God.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ol i askim God long dispela samting","poem":1},{"text":"na em i givim ol,","poem":3},{"text":"tasol em i mekim bikpela sik tu","poem":2},{"text":"i kamap long ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ol i stap long ples drai","poem":1},{"text":"na sampela man","poem":2},{"text":"i mangalim wok","poem":3},{"text":"bilong Moses wantaim Aron,","poem":4},{"text":"dispela tupela wokman","poem":2},{"text":"bilong Bikpela yet.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Orait bikpela hul","poem":1},{"text":"i kamap long graun","poem":3},{"text":"na Datan wantaim Abiram","poem":2},{"text":"na ol lain bilong tupela","poem":3},{"text":"ol i pundaun long hul","poem":2},{"text":"na graun i pas na karamapim ol.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Na paia i kam daun","poem":1},{"text":"long ol man i bihainim ol","poem":3},{"text":"na i kukim","poem":2},{"text":"dispela ol manmeri nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ol i stap long maunten Horep","poem":1},{"text":"na ol i wokim wanpela bulmakau","poem":2},{"text":"long gol,","poem":3},{"text":"na ol i lotu","poem":2},{"text":"long dispela giaman god.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Ol i kisim piksa bilong bulmakau","poem":1},{"text":"i save kaikai gras,","poem":3},{"text":"na ol i lotu long em.","poem":2},{"text":"Long dispela pasin","poem":1},{"text":"ol i daunim biknem bilong God.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"God i bin mekim strongpela wok tru","poem":1},{"text":"long Isip,","poem":3},{"text":"na em i kisim bek ol Israel","poem":2},{"text":"long han bilong ol Isip.","poem":3},{"text":"Tasol ol Israel","poem":1},{"text":"i lusim tingting long em.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"God i bin mekim","poem":1},{"text":"ol bikpela nambawan wok","poem":2},{"text":"long Isip","poem":3},{"text":"na long solwara Retsi em i mekim","poem":2},{"text":"ol samting i narakain tru,","poem":3},{"text":"na ol manmeri i kirap nogut tru.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Orait God i tok bai em i bagarapim","poem":1},{"text":"ol manmeri bilong en.","poem":2},{"text":"Tasol Moses,","poem":1},{"text":"dispela wokman God i bin makim,","poem":2},{"text":"em i sanap long ai bilong God,","poem":3},{"text":"na em i helpim ol Israel","poem":2},{"lineBreak":true},{"text":"na i pasim belhat bilong God,","poem":2},{"lineBreak":true},{"text":"na God i no bagarapim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Na ol i no laikim","poem":1},{"text":"dispela gutpela graun,","poem":3},{"text":"long wanem, ol i no bilipim","poem":2},{"text":"promis bilong God.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Ol i stap long haus sel","poem":1},{"text":"na i tok kros long God,","poem":3},{"text":"na ol i no bihainim","poem":2},{"text":"tok bilong Bikpela.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Orait God i givim strongpela tok","poem":1},{"text":"long ol.","poem":2},{"text":"Em i tok olsem ol bai i dai","poem":1},{"text":"long ples drai i gat ston.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Na bai em i rausim","poem":1},{"text":"ol tumbuna i kamap bihain,","poem":3},{"text":"bai ol i go i stap","poem":2},{"text":"namel long ol arapela lain,","poem":3},{"text":"na bai ol i dai","poem":2},{"text":"long ol arapela kantri.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Bihain ol i lotu","poem":1},{"text":"long ol giaman god Bal","poem":2},{"text":"long ples Peor,","poem":3},{"text":"na ol i kaikai ol ofa ol i givim","poem":2},{"text":"long ol dispela god i no gat laip.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Long dispela pasin","poem":1},{"text":"ol i mekim Bikpela i kros,","poem":3},{"text":"na em i salim bikpela sik nogut","poem":2},{"text":"i go long ol.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Tasol Finias i kirap na mekim save","poem":1},{"text":"long ol man i mekim rong","poem":3},{"text":"na bikpela sik i pinis.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Na inap long nau mipela i tingim","poem":1},{"text":"dispela stretpela pasin bilong em,","poem":3},{"text":"na bihain bihain","poem":2},{"text":"olgeta manmeri bai i tingim yet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ol Israel i stap long wara Meriba","poem":1},{"text":"na ol i mekim God i kros,","poem":3},{"text":"na Moses i kisim hevi","poem":2},{"text":"bilong asua bilong ol.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Ol i mekim Moses i bel nogut tru","poem":1},{"text":"na em i mekim tok i no stret.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ol i no kilim i dai ol arapela lain","poem":1},{"text":"olsem Bikpela i tokim ol.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tasol ol Israel i marit long ol haiden","poem":1},{"text":"na bihainim pasin nogut bilong ol.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Na ol i lotu long ol giaman god","poem":1},{"text":"na dispela i mekim God","poem":2},{"text":"i bagarapim ol.","poem":3}]},{"type":"verse","number":37,"content":[{"text":"Ol i kilim ol pikinini man","poem":1},{"text":"na pikinini meri bilong ol","poem":3},{"text":"na ofaim long ol giaman god.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ol i kilim ol pikinini man","poem":1},{"text":"na pikinini meri bilong ol yet.","poem":2},{"text":"Ol pikinini i no bin mekim rong,","poem":1},{"text":"tasol ol i kilim ol na givim ol","poem":2},{"text":"long ol giaman god bilong Kenan","poem":3},{"text":"olsem ofa.","poem":4},{"text":"Na blut bilong ol","poem":1},{"text":"i mekim graun i kamap doti","poem":2},{"text":"long ai bilong God.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Dispela pasin i mekim ol yet","poem":1},{"text":"i kamap doti long ai bilong God,","poem":3},{"text":"na ol i givim baksait long God","poem":2},{"text":"na ol i no bihainim em.","poem":3}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Orait nau Bikpela i kros tru","poem":1},{"text":"long ol manmeri bilong em,","poem":3},{"text":"na em i no laikim ol moa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Na em i lusim ol","poem":1},{"text":"na larim ol arapela lain i bosim ol.","poem":2},{"text":"Olsem na ol i stap aninit","poem":1},{"text":"long han bilong ol birua.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ol birua i givim planti hevi long ol,","poem":1},{"text":"na ol i stap aninit tru","poem":2},{"text":"long strong bilong ol.","poem":3}]},{"type":"verse","number":43,"content":[{"text":"Planti taim Bikpela i helpim","poem":1},{"text":"ol manmeri bilong en,","poem":3},{"text":"tasol ol i bihainim laik","poem":2},{"text":"bilong ol yet","poem":3},{"text":"na ol i bikhet","poem":2},{"text":"na sakim tok bilong en,","poem":3},{"text":"na ol i mekim planti sin.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Tasol taim ol i beten long Bikpela,","poem":1},{"text":"em i harim beten bilong ol,","poem":2},{"text":"na em i sori long ol i stap nogut.","poem":3}]},{"type":"verse","number":45,"content":[{"text":"Em i sori tumas long ol","poem":1},{"text":"na i tingting bek","poem":2},{"text":"long kontrak bilong en.","poem":3},{"text":"Na em i senisim","poem":1},{"text":"tingting bilong en gen.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Em i kirapim tingting bilong ol birua","poem":1},{"text":"i bin kalabusim ol Israel","poem":3},{"text":"na ol i sori long ol Israel.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"God, Bikpela bilong mipela,","poem":1},{"text":"nau yu mas kisim bek mipela.","poem":2},{"text":"Mipela i stap namel","poem":1},{"text":"long ol arapela lain manmeri,","poem":3},{"text":"tasol yu mas bungim mipela","poem":2},{"text":"na bringim mipela i kam bek","poem":3},{"text":"long graun bilong mipela.","poem":4},{"text":"Olsem bai mipela i ken tingting","poem":2},{"text":"long biknem bilong yu","poem":3},{"lineBreak":true},{"text":"na tenkyu long yu.","poem":3},{"text":"Na mipela i ken amamas","poem":1},{"text":"long litimapim nem bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Yumi litimapim nem bilong God,","poem":1},{"text":"Bikpela bilong yumi Israel,","poem":2},{"text":"nau na olgeta taim bihain.","poem":3},{"text":"Na olgeta manmeri i mas tok,","poem":1},{"text":"“I tru.”","poem":2},{"text":"Litimapim nem bilong Bikpela!","poem":1}]},{"type":"heading","content":["(Song 107-150)"]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}