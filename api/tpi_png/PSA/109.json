{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":109,"content":[{"type":"heading","content":["Singaut bilong man i gat hevi"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em song bilong lotu. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, mi save litimapim","poem":1},{"text":"nem bilong yu.","poem":3},{"text":"Plis, yu mas harim prea bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Long wanem, ol man nogut","poem":1},{"text":"na ol man bilong giaman,","poem":3},{"text":"ol i birua long mi","poem":2},{"text":"na tok giaman long mi.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ol i tok nogut tru long mi,","poem":1},{"text":"tasol ol i tok nating.","poem":2},{"text":"I no gat as bilong tok.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi save laikim ol","poem":1},{"text":"na mi beten bilong helpim ol,","poem":2},{"text":"tasol ol i no laikim mi.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mi mekim gutpela pasin long ol,","poem":1},{"text":"tasol ol i bekim","poem":2},{"text":"pasin nogut long mi.","poem":3},{"text":"Mi save laikim ol tumas,","poem":1},{"text":"tasol ol i no laikim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Makim wanpela man nogut","poem":1},{"text":"bai em i ken skelim tok","poem":2},{"text":"bilong birua bilong mi long kot.","poem":3},{"text":"Wanpela birua bilong em yet","poem":1},{"text":"i ken kotim em.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Man i harim kot i ken painimaut","poem":1},{"text":"dispela man i gat asua,","poem":3},{"text":"na salim em i go long kalabus.","poem":2},{"text":"Na em i mas tingim ol beten tu","poem":1},{"text":"bilong dispela man,","poem":2},{"text":"em i sin.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Mi laik bai em i mas i dai kwiktaim,","poem":1},{"text":"na narapela man i ken kisim","poem":2},{"text":"wok bilong en.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Na mi laik bai em i dai","poem":1},{"text":"na ol pikinini bilong en","poem":2},{"text":"bai i no gat papa,","poem":3},{"text":"na meri bilong en i no gat man.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Na mi laik bai ol pikinini bilong en","poem":1},{"text":"ol i no gat haus","poem":2},{"lineBreak":true},{"text":"na ol i stap rabis tru.","poem":2},{"text":"Na ol man i ken rausim ol","poem":1},{"text":"long haus nogut ol i stap long en.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sapos dispela birua i gat dinau","poem":1},{"text":"long sampela man,","poem":3},{"text":"mi laik bai ol dispela man","poem":2},{"text":"i kam kisim graun samting","poem":3},{"text":"bilong en,","poem":4},{"text":"na bai ol man bilong narapela ples","poem":2},{"text":"i ken kisim olgeta samting","poem":3},{"text":"em i bin mekim wok bilong baim.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Mi laik bai i no gat wanpela man","poem":1},{"text":"i ken marimari long em,","poem":3},{"text":"na bai i no gat wanpela i sori","poem":2},{"text":"long ol pikinini bilong en","poem":3},{"text":"i no gat papa.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Mi laik bai ol pikinini bilong en","poem":1},{"text":"i ken i dai","poem":3},{"text":"na ol lain i kamap bihain","poem":2},{"text":"i no ken tingting moa","poem":3},{"text":"long nem bilong dispela man.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Mi laik bai Bikpela i ken tingting","poem":1},{"text":"long pasin nogut","poem":2},{"text":"ol tumbuna bilong en","poem":3},{"text":"i bin mekim.","poem":4},{"text":"Na em i no ken lusim sin","poem":1},{"text":"bilong mama bilong en.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bikpela i ken tingting oltaim","poem":1},{"text":"long sin bilong ol,","poem":3},{"text":"na ol manmeri","poem":2},{"text":"i ken lusim tingting olgeta","poem":3},{"text":"long lain bilong en.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Dispela man i no bin tingting","poem":1},{"text":"long marimari","poem":2},{"text":"long ol arapela man.","poem":3},{"text":"Em i birua long ol rabisman","poem":1},{"text":"na long ol man","poem":2},{"text":"i sot long ol samting","poem":3},{"text":"na long ol man i bel hevi,","poem":2},{"text":"na em i kilim ol i dai.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Bipo em i laik mekim tok nogut","poem":1},{"text":"long ol arapela man","poem":2},{"text":"i ken bagarap,","poem":3},{"text":"orait nau em yet i mas bagarap.","poem":2},{"text":"Em i no laik askim God","poem":1},{"text":"long mekim gut","poem":2},{"text":"long ol arapela man,","poem":3},{"text":"orait em tu i no ken kisim","poem":2},{"text":"blesing bilong God.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Oltaim em i save tok","poem":1},{"text":"long ol arapela man","poem":2},{"text":"i ken bagarap,","poem":3},{"text":"na dispela tok i kamap","poem":2},{"text":"olsem bilas bilong em yet.","poem":3},{"text":"Mobeta dispela tok bilong en","poem":1},{"text":"i go insait long bodi bilong en,","poem":2},{"text":"olsem wara,","poem":3},{"text":"na i go insait long ol bun bilong en","poem":2},{"text":"olsem wel.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Na dispela tok bilong en","poem":1},{"text":"i ken karamapim em olsem klos,","poem":2},{"text":"na raunim bel bilong en olsem let.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mi laik bai Bikpela","poem":1},{"text":"i ken mekim save olsem","poem":2},{"text":"long ol man i kotim mi,","poem":3},{"text":"long wanem, ol i save mekim","poem":2},{"text":"dispela tok nogut tru long mi.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Tasol God, Bikpela bilong mi,","poem":1},{"text":"mi laik bai yu helpim mi,","poem":2},{"text":"olsem yu promis pinis.","poem":3},{"text":"Yu gutpela na yu laikim mi oltaim,","poem":1},{"text":"olsem na yu mas kisim bek mi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mi stap rabisman tru","poem":1},{"text":"na mi stap nating,","poem":2},{"text":"na mi pilim nogut.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Mi laik i go pinis","poem":1},{"text":"olsem tewel san i mekim kamap","poem":2},{"lineBreak":true},{"text":"em i go pinis long apinun,","poem":2},{"text":"taim san i go daun.","poem":3},{"text":"Mi olsem binatang win i tromoi i go.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mi bin tambu long kaikai","poem":1},{"text":"na skru bilong mi i no gat strong.","poem":2},{"text":"Mi kamap bun nating","poem":1},{"text":"na olgeta bun bilong mi i slek tru.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ol manmeri i save lukim mi","poem":1},{"text":"na tok bilas long mi.","poem":2},{"text":"Ol i tantanim het na lap long mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"yu save laikim mi tru oltaim.","poem":3},{"text":"Yu ken helpim mi na kisim bek mi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mekim ol birua i save olsem,","poem":1},{"text":"yu tasol yu save helpim mi","poem":2},{"text":"na kisim bek mi.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Ol i ken tok","poem":1},{"text":"bai God i bagarapim mi,","poem":3},{"text":"tasol bai yu mekim gut tasol","poem":2},{"text":"long mi.","poem":3},{"text":"Mi laik bai yu daunim","poem":1},{"text":"ol man i mekim nogut long mi,","poem":3},{"text":"na bai mi, wokman bilong yu,","poem":2},{"text":"mi ken belgut.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Mi laik ol birua bilong mi","poem":1},{"text":"ol i pilim bikpela sem,","poem":3},{"text":"na ol manmeri i ken lukim","poem":2},{"text":"ol i sem nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tasol bai mi bikmaus","poem":1},{"text":"na tok tenkyu long Bikpela.","poem":2},{"text":"Long taim ol manmeri","poem":1},{"text":"i bung bilong lotu","poem":3},{"text":"bai mi litimapim nem bilong em.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Long wanem, em i save","poem":1},{"text":"helpim ol rabisman","poem":2},{"text":"na lukautim ol,","poem":3},{"text":"bai ol man i no inap kotim ol","poem":2},{"text":"na tok ol i mas i dai.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}