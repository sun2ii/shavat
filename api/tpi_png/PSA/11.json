ak":true},{"text":"Sapos olgeta manmeri","poem":2},{"text":"i no save mekim","poem":3},{"text":"stretpela pasin moa,","poem":4},{"text":"orait stretpela man","poem":2},{"text":"bai i mekim wanem?”","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God i stap long haus bilong em yet.","poem":1},{"lineBreak":true},{"text":"Em i stap king long heven,","poem":1},{"text":"na ai bilong en","poem":2},{"text":"i save lukim olgeta man.","poem":3},{"text":"Em i save long olgeta samting","poem":1},{"text":"ol i mekim.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Bikpela i save skelim","poem":1},{"text":"ol stretpela man na ol man nogut.","poem":2},{"text":"Em i no laikim tru","poem":1},{"text":"ol man i sakim lo bilong em.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Em i kapsaitim hatpela paia moa","poem":1},{"text":"antap long ol man nogut.","poem":2},{"text":"Na em i mekim save boinim","poem":1},{"text":"skin bilong ol.","poem":3},{"text":"Dispela em i pe bilong ol.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God yet i save mekim","poem":1},{"text":"stretpela pasin tasol,","poem":3},{"text":"na em i laikim stretpela pasin.","poem":2},{"text":"Ol man i bihainim tok bilong em","poem":1},{"text":"ol bai i lukim pes bilong em.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}