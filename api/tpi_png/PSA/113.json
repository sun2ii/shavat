{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":113,"content":[{"type":"heading","content":["Ol manmeri i amamas long God i mekim gut long ol"]},{"type":"verse","number":1,"content":[{"text":"Litimapim nem","poem":1},{"text":"bilong Bikpela!","poem":2},{"text":"Yupela wokman bilong Bikpela,","poem":1},{"text":"litimapim nem bilong em!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yumi olgeta i mas amamas","poem":1},{"text":"long nem bilong Bikpela,","poem":3},{"text":"nau na olgeta taim bihain.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Long hap bilong sankamap","poem":1},{"text":"i go inap hap bilong san i go daun,","poem":3},{"text":"yumi olgeta manmeri","poem":2},{"text":"i mas litimapim","poem":3},{"text":"nem bilong Bikpela.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Bikpela i save bosim","poem":1},{"text":"olgeta lain pipel.","poem":2},{"text":"Biknem bilong en i winim","poem":1},{"text":"olgeta samting long heven.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I no gat wanpela man","poem":1},{"text":"i olsem God, Bikpela bilong yumi.","poem":2},{"text":"Em i stap antap tru.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Em i save lukluk i kam daun","poem":1},{"text":"na lukim heven","poem":2},{"text":"na graun wantaim.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Em i save helpim ol rabisman","poem":1},{"text":"na ol i no i stap nogut moa.","poem":2},{"text":"Ol i stap gut tasol.","poem":3},{"text":"Em i save helpim ol man","poem":1},{"text":"i sot long ol samting","poem":2},{"text":"na ol i kisim inap.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Em i save putim ol i stap","poem":1},{"text":"wantaim ol hetman","poem":2},{"text":"bilong ol manmeri bilong en.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Na em i save mekim gut","poem":1},{"text":"long ol meri","poem":2},{"text":"i no save karim pikinini","poem":3},{"text":"na mekim ol","poem":2},{"text":"i karim planti pikinini,","poem":3},{"text":"na ol meri i amamas tru.","poem":2},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}