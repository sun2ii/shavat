{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":116,"content":[{"type":"heading","content":["God i kisim bek wanpela man na em i tenkyu long God"]},{"type":"verse","number":1,"content":[{"text":"Bikpela i save harim","poem":1},{"text":"singaut bilong mi.","poem":3},{"text":"Olsem na mi laikim em tumas.","poem":2},{"text":"Tru tumas, em i save harim","poem":1},{"text":"beten bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Em i save harim","poem":1},{"text":"olgeta singaut bilong mi.","poem":2},{"text":"Olsem na olgeta taim mi stap laip","poem":1},{"text":"bai mi beten long em.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dai i olsem rop i pasim mi.","poem":1},{"lineBreak":true},{"text":"Mi tingting long ples","poem":1},{"text":"bilong ol man i dai pinis,","poem":3},{"text":"na dispela i mekim mi","poem":2},{"text":"i pret nogut tru","poem":3},{"text":"na mi wari moa yet.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Olsem na mi singaut long Bikpela","poem":1},{"text":"na mi tok olsem,","poem":3},{"text":"“Bikpela, mi singaut","poem":2},{"text":"bai yu kisim bek mi,","poem":3},{"text":"nogut mi dai.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bikpela i save marimari long yumi","poem":1},{"text":"na i mekim gut long yumi.","poem":2},{"text":"God bilong yumi","poem":1},{"text":"em i save sori long yumi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bikpela i save lukautim ol man","poem":1},{"text":"i no inap helpim ol yet.","poem":2},{"text":"Bipo ol man i laik bagarapim mi","poem":1},{"text":"na em i kisim bek mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nau mi ken bel isi gen,","poem":1},{"text":"long wanem, Bikpela","poem":2},{"text":"i bin mekim gut tru long mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu kisim bek mi","poem":1},{"text":"na mi no bin i dai.","poem":2},{"text":"Yu mekim drai aiwara bilong mi,","poem":1},{"text":"na yu lukautim mi","poem":2},{"text":"na mi no pundaun.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Olsem na mi bai wokabaut","poem":1},{"text":"wantaim Bikpela","poem":3},{"text":"olgeta taim mi stap long graun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mi bilip long God","poem":1},{"text":"taim mi tok olsem,","poem":3},{"text":"“Bikpela hevi tru","poem":2},{"text":"i karamapim mi.”","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Na taim mi pret na mi tok,","poem":1},{"text":"“Mi no ken bilip","poem":2},{"text":"long wanpela man,”","poem":3},{"text":"long dispela taim tu","poem":2},{"text":"mi bilip long God.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela i bin mekim gut tru","poem":1},{"text":"long mi.","poem":2},{"text":"Olsem na bai mi givim","poem":1},{"text":"wanem samting long em?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bai mi bringim wanpela kap wain","poem":1},{"text":"long Bikpela","poem":3},{"text":"olsem ofa i soim olsem","poem":2},{"text":"God i kisim bek mi pinis.","poem":3},{"text":"Mi mekim olsem bilong tok tenkyu","poem":1},{"text":"long Bikpela i bin kisim bek mi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Long taim olgeta manmeri","poem":1},{"text":"bilong en","poem":2},{"text":"i kam bung,","poem":3},{"text":"mi bai mekim","poem":2},{"text":"olsem mi bin promis.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ol manmeri bilong God","poem":1},{"text":"ol i nambawan tru","poem":2},{"text":"long ai bilong en.","poem":3},{"text":"Na sapos wanpela i dai","poem":1},{"text":"em i no save ting","poem":2},{"text":"dispela em i samting nating.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Bikpela, mi wokman bilong yu.","poem":1},{"text":"Mi save mekim wok bilong yu,","poem":2},{"text":"olsem bipo mama i mekim.","poem":3},{"text":"Yu bin lusim ol rop i pasim mi","poem":1},{"text":"na mi kamap fri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bai mi mekim ofa","poem":1},{"text":"bilong tenkyu long yu,","poem":2},{"text":"na bai mi prea long yu.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Bipo mi bin mekim promis long yu,","poem":1},{"text":"na nau bai mi mekim","poem":2},{"text":"dispela samting long ai","poem":3},{"text":"bilong olgeta manmeri bilong yu.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Bikpela, bai mi mekim dispela ofa","poem":1},{"text":"long Jerusalem,","poem":3},{"text":"insait long haus bilong yu.","poem":2},{"text":"Yumi litimapim","poem":1},{"text":"nem bilong Bikpela!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/115.