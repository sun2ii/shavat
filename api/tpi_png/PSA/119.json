":"long wanem, mi save bihainim","poem":2},{"text":"lo bilong yu.","poem":3},{"text":"Olsem na mi laik","poem":1},{"text":"bai yu no ken larim ol","poem":2},{"text":"i mekim dispela kain tok long mi.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Ol hetman i kibung na painim rot","poem":1},{"text":"bilong kilim mi i dai.","poem":2},{"text":"Tasol maski, mi wokman bilong yu,","poem":1},{"text":"bai mi tingting oltaim","poem":2},{"text":"long stretpela lo bilong yu.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Mi laikim tumas tok yu givim mi","poem":1},{"text":"bilong stiaim lek bilong mi.","poem":2},{"text":"Tok bilong yu i save skulim mi","poem":1},{"text":"oltaim.","poem":2}]},{"type":"heading","content":["Man i strong long bihainim lo bilong God"]},{"type":"verse","number":25,"content":[{"text":"Ol i daunim mi","poem":1},{"text":"na mi slip nogut long graun.","poem":2},{"text":"Kirapim mi na strongim mi","poem":1},{"text":"olsem yu bin promis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mi bin tokim yu","poem":1},{"text":"long olgeta pasin bilong mi,","poem":3},{"text":"na yu bin bekim tok bilong mi.","poem":2},{"text":"Yu mas skulim mi","poem":1},{"text":"long olgeta lo bilong yu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Skulim mi","poem":1},{"text":"long bihainim lo bilong yu,","poem":3},{"text":"na bai mi tingting","poem":2},{"text":"long olgeta gutpela gutpela tok","poem":3},{"text":"bilong yu.","poem":4}]},{"type":"verse","number":28,"content":[{"text":"Bel bilong mi em i hevi tru.","poem":1},{"text":"Yu mas strongim mi","poem":2},{"text":"olsem yu bin promis.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Yu mas was long mi","poem":1},{"text":"bai mi no lusim rot bilong yu.","poem":2},{"text":"Mekim gutpela pasin long mi","poem":1},{"text":"na skulim mi long lo bilong yu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mi pasim tok","poem":1},{"text":"long mi bai bi