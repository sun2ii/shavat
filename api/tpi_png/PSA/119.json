:3}]},{"type":"verse","number":170,"content":[{"text":"Putim yau long prea bilong mi,","poem":1},{"text":"na kisim bek mi","poem":2},{"text":"olsem bipo yu tok.","poem":3}]},{"type":"verse","number":171,"content":[{"text":"Yu save skulim mi gut","poem":1},{"text":"long olgeta lo bilong yu,","poem":3},{"text":"olsem na bai mi litimapim","poem":2},{"text":"nem bilong yu oltaim.","poem":3}]},{"type":"verse","number":172,"content":[{"text":"Mi bai singim song","poem":1},{"text":"long lo bilong yu,","poem":3},{"text":"long wanem, olgeta lo bilong yu","poem":2},{"text":"i stretpela tasol.","poem":3}]},{"type":"verse","number":173,"content":[{"text":"Mi save bihainim lo bilong yu,","poem":1},{"text":"olsem na yu mas redi","poem":2},{"text":"long helpim mi oltaim.","poem":3}]},{"type":"verse","number":174,"content":[{"text":"Bikpela, bel bilong mi i krai long yu","poem":1},{"text":"long kisim bek mi,","poem":3},{"text":"na lo bilong yu i save mekim mi","poem":2},{"text":"i amamas.","poem":3}]},{"type":"verse","number":175,"content":[{"text":"Yu mas givim mi laip,","poem":1},{"text":"na bai mi litimapim","poem":2},{"text":"nem bilong yu.","poem":3},{"text":"Mi laik bai tok bilong yu","poem":1},{"text":"i ken helpim mi.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Mi lusim gutpela rot pinis","poem":1},{"text":"olsem sipsip i lus.","poem":2},{"text":"Olsem na yu mas kam painim mi,","poem":1},{"text":"wokman bilong yu.","poem":2},{"text":"Mi no save lusim tingting","poem":1},{"text":"long lo bilong yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}