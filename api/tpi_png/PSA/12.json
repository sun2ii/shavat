gris,","poem":2},{"lineBreak":true},{"text":"na pasim maus","poem":2},{"text":"bilong ol hambakman.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol dispela man i save tok olsem,","poem":1},{"text":"“Bai mipela i toktok","poem":2},{"text":"long laik bilong mipela yet.","poem":3},{"text":"I no gat wanpela man","poem":2},{"text":"inap pasim mipela.","poem":3},{"text":"Husat i bosim mipela?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tasol Bikpela i tok olsem,","poem":1},{"text":"“Nau bai mi kam, long wanem,","poem":2},{"text":"ol man i wok long daunim ol rabisman.","poem":3},{"text":"Na ol man i karim pen na hevi,","poem":2},{"text":"ol i krai i stap.","poem":3},{"text":"Bai mi givim ol","poem":2},{"text":"dispela gutpela sindaun","poem":3},{"text":"ol i wet long kisim.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tok bilong God i tru olgeta.","poem":1},{"lineBreak":true},{"text":"Tok bilong en i gutpela tumas","poem":1},{"text":"olsem silva ol i bin kukim","poem":2},{"text":"7-pela taim long paia","poem":3},{"text":"na i klin olgeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, lukautim mipela gut.","poem":1},{"lineBreak":true},{"text":"Was gut long mipela oltaim,","poem":1},{"text":"bai ol man nogut","poem":2},{"text":"i no ken bagarapim mipela.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ol man nogut i save raun nabaut","poem":1},{"text":"long olgeta hap.","poem":3},{"text":"Na olgeta manmeri","poem":1},{"text":"i save tingting olsem","poem":2},{"text":"pasin nogut em i gutpela samting.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}