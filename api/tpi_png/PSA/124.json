{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":124,"content":[{"type":"heading","content":["God em i Helpim bilong ol manmeri bilong en"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"“Sapos Bikpela","poem":1},{"text":"i no bin helpim mipela,","poem":2},{"text":"bai olsem wanem?”","poem":3},{"text":"Ol Israel i mas bekim dispela askim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Bipo ol man i belhat long yumi,","poem":1},{"text":"na ol i pait long yumi.","poem":3},{"text":"Na sapos Bikpela","poem":1},{"text":"i no bin helpim yumi,","poem":3},{"text":"ol birua inap bagarapim yumi tru","poem":2},{"text":"long belhat bilong ol.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Inap yumi lus","poem":1},{"text":"olsem tait i kisim yumi,","poem":3},{"text":"na olsem wara i karamapim yumi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inap dispela strongpela tait","poem":1},{"text":"i kisim yumi","poem":3},{"text":"na yumi dai pinis. Tasol nogat.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yumi mas tenkyu tru long Bikpela.","poem":1},{"text":"Em i no larim ol birua","poem":2},{"text":"i pinisim yumi.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Yumi lusim ol,","poem":1},{"text":"olsem pisin i lusim umben","poem":2},{"text":"wanpela man i bin putim,","poem":3},{"text":"na i flai i go.","poem":2},{"text":"Dispela umben i bruk pinis,","poem":1},{"text":"na yumi no moa pas long en.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela i bin wokim heven na graun,","poem":1},{"text":"em yet i save helpim yumi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}