em":1},{"text":"bilong ol manmeri bilong God oltaim.","poem":2},{"text":"Sapos ol inap mekim olsem,","poem":1},{"text":"ating bai ol manmeri","poem":2},{"text":"bilong God tu","poem":4},{"text":"i mekim pasin nogut.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Bikpela, yu mekim gutpela pasin","poem":1},{"text":"long ol gutpela manmeri,","poem":3},{"text":"em ol manmeri i save bihainim","poem":2},{"text":"ol lo bilong yu.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Tasol taim yu mekim save","poem":1},{"text":"long ol manmeri","poem":2},{"text":"i bihainim pasin nogut","poem":3},{"text":"bilong ol yet,","poem":4},{"text":"bai yu mekim save","poem":2},{"text":"long olgeta manmeri","poem":3},{"text":"i save lusim pasin bilong yu.","poem":4},{"text":"Ol Israel i ken i stap gut.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}