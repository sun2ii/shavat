{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":13,"content":[{"type":"heading","content":["Man i beten bai God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, wanem taim","poem":1},{"text":"bai yu tingim mi gen?","poem":3},{"text":"Ating yu lusim tingting long mi","poem":1},{"text":"inap oltaim oltaim, a?","poem":3},{"text":"Wanem taim bai yu larim mi","poem":1},{"text":"i lukim pes bilong yu gen?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wanem taim bai yu pinisim","poem":1},{"text":"dispela pen mi save karim?","poem":3},{"text":"Hamas de na nait","poem":1},{"text":"bel hevi bilong mi i mas i stap?","poem":2},{"text":"Wanem taim bai yu helpim mi","poem":1},{"text":"na mi no i stap moa","poem":2},{"text":"aninit long ol birua?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Bikpela, yu God bilong mi.","poem":1},{"text":"Yu mas tingting long mi","poem":2},{"text":"na harim prea bilong mi.","poem":3},{"text":"Strongim mi gen bai mi no ken i dai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Olsem bai ol birua i no inap tok,","poem":1},{"text":"“Mipela i winim em pinis.”","poem":2},{"text":"Na ol i no ken amamas","poem":1},{"text":"long lukim mi i pundaun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tasol mi bilip bai yu marimari","poem":1},{"text":"long mi oltaim.","poem":3},{"text":"Na mi amamas long yu","poem":1},{"text":"bai helpim mi.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yes, bai mi singim song","poem":1},{"text":"bilong litimapim nem","poem":2},{"text":"bilong Bikpela.","poem":3},{"text":"Long wanem,","poem":1},{"text":"em i bin mekim gut tru","poem":2},{"text":"long mi.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}