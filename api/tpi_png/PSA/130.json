ng yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi laikim tumas","poem":1},{"text":"Bikpela i helpim mi,","poem":2},{"text":"na mi wet long em.","poem":3},{"text":"Na mi bilip tru long tok bilong en.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi save wet long Bikpela,","poem":1},{"text":"na mi laikim tumas","poem":2},{"text":"bai em i helpim mi.","poem":3},{"text":"Na dispela em i winim laik","poem":1},{"text":"bilong ol wasman","poem":2},{"text":"i save wet long tulait i kamap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yumi ol Israel,","poem":1},{"text":"yumi mas bilip long Bikpela,","poem":3},{"text":"long wanem, oltaim","poem":2},{"text":"em i save laikim yumi tru.","poem":3},{"text":"Na oltaim em i laik helpim yumi","poem":1},{"text":"bai yumi no bagarap.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Em bai i kisim bek","poem":1},{"text":"ol manmeri bilong en,","poem":2},{"text":"em yumi Israel,","poem":3},{"text":"na rausim olgeta sin bilong yumi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}