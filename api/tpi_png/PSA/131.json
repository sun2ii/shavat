em":2}]},{"type":"verse","number":3,"content":[{"text":"Ol Israel, yupela i mas bilip","poem":1},{"text":"long Bikpela,","poem":3},{"text":"nau na olgeta taim bihain tu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}