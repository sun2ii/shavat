{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":132,"content":[{"type":"heading","content":["Ol i amamas long haus bilong God"]},{"type":"hebrew_subtitle","content":["Song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Bikpela,","poem":1},{"text":"yu no ken","poem":2},{"text":"lusim tingting long Devit","poem":3},{"text":"na long olgeta wok","poem":2},{"text":"em i bin mekim.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Strongpela God bilong Israel,","poem":1},{"text":"yu mas tingim gen ol promis","poem":2},{"text":"Devit i bin mekim long yu.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Em i tok olsem,","poem":1},{"text":"“Mi no ken i go long haus","poem":2},{"text":"na mi no ken slip long bet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi no ken malolo na slip yet.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pastaim mi mas wokim","poem":2},{"text":"wanpela haus bilong Bikpela,","poem":3},{"text":"Strongpela God bilong Israel,","poem":4},{"text":"bai em i ken i stap long en.","poem":3},{"text":"Na bihain bai mi malolo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Long Betlehem mipela i harim tok","poem":1},{"text":"long Bokis Kontrak","poem":2},{"text":"bilong Bikpela.","poem":3},{"text":"Na mipela i lukim em i stap","poem":1},{"text":"long graun bilong Kiriat Jearim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na mipela i tok, “Goan, yumi go","poem":1},{"text":"long haus bilong Bikpela.","poem":3},{"text":"Yumi go lotu klostu","poem":2},{"text":"long sia king bilong en.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu kam","poem":1},{"text":"wantaim Bokis Kontrak","poem":2},{"text":"bilong yu","poem":3},{"text":"na sindaun","poem":2},{"text":"long ples malolo bilong yu.","poem":3},{"text":"Dispela Bokis Kontrak em i mak","poem":1},{"text":"bilong bikpela strong bilong yu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yu ken helpim ol pris bilong yu,","poem":1},{"text":"bai ol i mekim","poem":2},{"text":"stretpela pasin oltaim.","poem":3},{"text":"Na dispela pasin bilong ol","poem":1},{"text":"i ken i stap","poem":2},{"text":"olsem gutpela bilas bilong ol.","poem":3},{"text":"Na ol manmeri bilong yu","poem":1},{"text":"i ken amamas na singaut.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bikpela, yu mas tingim","poem":1},{"text":"wokman bilong yu, Devit,","poem":3},{"text":"na yu no ken givim baksait","poem":2},{"text":"long king yu yet yu bin makim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela, bipo yu bin mekim","poem":1},{"text":"wanpela strongpela promis","poem":2},{"text":"long Devit,","poem":3},{"text":"na yu no inap senisim","poem":2},{"text":"tok bilong yu.","poem":3},{"text":"Yu bin tok olsem,","poem":1},{"text":"“Mi bai mekim wanpela","poem":2},{"text":"bilong ol lain pikinini bilong yu","poem":3},{"text":"i kamap king.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Sapos ol pikinini man bilong yu","poem":2},{"text":"i bihainim kontrak bilong mi,","poem":3},{"text":"na bihainim olgeta lo mi givim ol,","poem":4},{"text":"orait bihain ol pikinini man","poem":2},{"text":"bilong ol tumbuna bilong yu,","poem":3},{"text":"ol tu bai i kamap king,","poem":2},{"text":"i go inap olgeta taim bihain.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bikpela i makim Saion pinis","poem":1},{"text":"olsem taun bilong en,","poem":3},{"text":"na em i laik i stap oltaim long en.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Em i tok, “Bai mi stap oltaim oltaim","poem":1},{"text":"long dispela taun.","poem":3},{"text":"Mi makim dispela ples","poem":2},{"text":"bilong mi ken i stap king","poem":3},{"text":"long en.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Bai mi givim planti samting","poem":2},{"text":"long Saion","poem":3},{"text":"na bai ol manmeri i no inap sot","poem":2},{"text":"long ol samting.","poem":3},{"text":"Na bai mi givim kaikai","poem":2},{"text":"long ol rabisman","poem":3},{"text":"na ol bai i pulap tru.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bai mi givim wok","poem":2},{"text":"long ol pris bilong Saion,","poem":3},{"text":"bilong autim tok","poem":2},{"text":"long mi save kisim bek","poem":3},{"text":"ol manmeri bilong graun.","poem":4},{"text":"Na ol manmeri bilong Saion","poem":2},{"text":"i ken singim song","poem":3},{"text":"na amamas na singaut.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Bai mi kisim wanpela man","poem":2},{"text":"long lain bilong Devit","poem":3},{"text":"na mekim em i kamap king","poem":2},{"text":"long dispela ples,","poem":3},{"text":"na lain bilong en i no inap lus","poem":2},{"text":"long dispela wok.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Bai mi mekim ol birua bilong en","poem":2},{"text":"i sem nogut,","poem":3},{"text":"tasol ol lain manmeri em i bosim","poem":2},{"text":"bai ol i kamap gutpela","poem":3},{"text":"na i stap strong.”","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}