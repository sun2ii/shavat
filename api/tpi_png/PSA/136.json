 i mekim,","poem":1},{"text":"na solwara Retsi i bruk tuhap.","poem":2},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Em i go pas na bringim","poem":1},{"text":"ol manmeri bilong en i kam","poem":2},{"text":"na ol i brukim solwara.","poem":3},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Em i mekim king bilong Isip","poem":1},{"text":"na ol soldia bilong en","poem":2},{"text":"i dring wara na i dai.","poem":3},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Em i go paslain","poem":1},{"text":"long ol manmeri bilong en","poem":2},{"text":"long ples drai.","poem":3},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Em i bin kilim i dai","poem":1},{"text":"ol strongpela king.","poem":2},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Na em i kilim ol king i gat biknem.","poem":1},{"lineBreak":true},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Em i kilim Sihon,","poem":1},{"text":"king bilong ol Amor.","poem":2},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na em i kilim Ok,","poem":1},{"text":"king bilong Basan.","poem":2},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Na em i givim graun","poem":1},{"text":"bilong ol dispela king","poem":2},{"text":"long ol manmeri bilong en.","poem":3},{"text":"Oltaim oltaim","poem":1},{"text":"em i save laikim yumi moa yet.","poem":2}]},{"typ