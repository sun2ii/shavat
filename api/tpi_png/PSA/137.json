:"Kirapim wanpela song","poem":2},{"text":"bilong Saion.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tasol ol song bilong Bikpela,","poem":1},{"text":"olsem wanem bai mipela","poem":2},{"text":"inap singim ol","poem":3},{"text":"long dispela ples","poem":2},{"text":"i no kantri bilong mipela?","poem":3},{"text":"I no inap tru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jerusalem, sapos mi lusim tingting","poem":1},{"text":"long yu,","poem":3},{"text":"mobeta mi no inap","poem":2},{"text":"paitim gita gen.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jerusalem, sapos mi lusim tingting","poem":1},{"text":"long yu","poem":3},{"text":"na sapos mi no makim yu","poem":2},{"text":"i stap nambawan samting","poem":3},{"text":"mi save amamas long en,","poem":4},{"text":"orait mobeta nek bilong mi","poem":2},{"text":"i bagarap","poem":3},{"text":"na bai mi no inap","poem":2},{"text":"mekim song gen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, yu mas tingim gen","poem":1},{"text":"pasin ol Idom i mekim","poem":3},{"text":"taim ol i pait na kisim Jerusalem.","poem":2},{"lineBreak":true},{"text":"Tingim gen dispela tok bilong ol.","poem":2},{"text":"Ol i bin tok olsem,","poem":1},{"text":"“Brukim olgeta haus samting","poem":2},{"text":"bilong Jerusalem","poem":3},{"text":"na bagarapim olgeta.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babilon, harim.","poem":1},{"text":"Yu bai bagarap.","poem":2},{"text":"Man i bekim ol pasin nogut","poem":1},{"text":"yu bin mekim long mipela,","poem":3},{"text":"dispela man i ken amamas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dispela man i ken kisim","poem":1},{"text":"ol liklik pikinini bilong yu","poem":3},{"text":"na tromoi ol i go daun long ston","poem":2},{"text":"na bagarapim ol tru.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}