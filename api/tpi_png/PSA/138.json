{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":138,"content":[{"type":"heading","content":["Man i tok tenkyu long God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, bel bilong mi","poem":1},{"text":"i strong tru","poem":2},{"text":"long tenkyu long yu.","poem":3},{"text":"Long ai bilong olgeta giaman god","poem":1},{"text":"bai mi mekim song","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi brukim skru","poem":1},{"text":"long pes bilong haus bilong yu","poem":2},{"text":"na litimapim nem bilong yu.","poem":3},{"text":"Long wanem, oltaim","poem":1},{"text":"yu save laikim mi tru","poem":2},{"text":"na yu save lukautim mi gut.","poem":3},{"text":"Yu soim mipela pinis olsem,","poem":1},{"text":"yu wantaim tok bilong yu","poem":2},{"text":"i nambawan tru.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Taim mi singaut long yu,","poem":1},{"text":"yu bin harim prea bilong mi,","poem":3},{"text":"na yu givim strong bilong yu yet","poem":2},{"text":"long mi","poem":3},{"text":"na mi stap strong olgeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olgeta king bilong graun","poem":1},{"text":"i harim pinis tok bilong yu,","poem":3},{"text":"olsem na bai ol i litimapim","poem":2},{"text":"nem bilong yu.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Na bai ol i singim song","poem":1},{"text":"long ol samting yu bin mekim,","poem":3},{"text":"na mekim song tu","poem":2},{"text":"long biknem bilong yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bikpela, yu stap antap tru","poem":1},{"text":"na yu nambawan,","poem":3},{"text":"tasol yu save tingting","poem":2},{"text":"long ol manmeri i no bikhet.","poem":3},{"text":"Na ol bikhetman tu","poem":1},{"text":"i no inap hait long yu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taim planti hevi i kamap long mi,","poem":1},{"text":"yu save lukautim mi","poem":2},{"text":"na mi stap gut.","poem":3},{"text":"Ol birua i kros long mi,","poem":1},{"text":"tasol yu save pait long ol,","poem":3},{"text":"na long strong bilong yu tasol,","poem":2},{"text":"yu save kisim bek mi.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, mi save","poem":1},{"text":"bai yu mekim olgeta samting","poem":2},{"text":"olsem yu promis pinis long mi.","poem":3},{"text":"Na yu save laikim mi oltaim oltaim.","poem":1},{"text":"Mi laik bai yu pinisim","poem":2},{"text":"olgeta wok yu bin kirapim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}