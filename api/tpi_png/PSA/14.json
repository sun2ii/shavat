neBreak":true},{"text":"na ol i wok long painim God.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tasol nogat.","poem":1},{"lineBreak":true},{"text":"Olgeta i lusim gutpela rot pinis.","poem":1},{"lineBreak":true},{"text":"Olgeta i wankain tasol,","poem":1},{"text":"ol i man nogut tru.","poem":2},{"text":"I no gat wanpela bilong ol","poem":1},{"text":"i save mekim gutpela pasin.","poem":2},{"lineBreak":true},{"text":"Nogat tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God i tok olsem,","poem":1},{"text":"“Ol dispela man","poem":2},{"text":"i mekim pasin nogut,","poem":3},{"text":"ating ol i no gat save, a?","poem":2},{"lineBreak":true},{"text":"Ol i save pinisim","poem":2},{"text":"ol manmeri bilong mi","poem":3},{"text":"olsem ol i save kaikai bret.","poem":2},{"lineBreak":true},{"text":"Na ol i no save beten long mi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tasol ol dispela man","poem":1},{"text":"bai i pret nogut tru.","poem":2},{"text":"Long wanem, God i stap","poem":1},{"text":"wantaim ol man","poem":2},{"text":"i bihainim tok bilong en.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ol i save lap long ol samting","poem":1},{"text":"ol rabisman i laik mekim.","poem":2},{"text":"Long wanem, ol rabisman","poem":1},{"text":"i save bilip long Bikpela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi laikim tumas bai God","poem":1},{"text":"i salim wanpela man bilong Saion","poem":2},{"text":"i kam bilong kisim bek ol Israel.","poem":3},{"text":"Taim Bikpela i helpim","poem":1},{"text":"ol manmeri bilong en","poem":3},{"lineBreak":true},{"text":"na ol i stap gut gen,","poem":3},{"text":"orait ol Israel bai i amamas.","poem":2},{"text":"Yes, ol bai i stap belgut tru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}