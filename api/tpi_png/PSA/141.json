pe":"verse","number":4,"content":[{"text":"Yu no ken larim bel bilong mi","poem":1},{"text":"i kirap long mekim pasin nogut.","poem":2},{"text":"Na nogut yu larim mi","poem":1},{"text":"i bung wantaim ol man nogut","poem":2},{"text":"na mekim sampela rong.","poem":3},{"text":"Yu no ken larim mi","poem":1},{"text":"i sindaun wantaim ol","poem":2},{"text":"long pati bilong ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gutpela man i ken sori long mi","poem":1},{"text":"na mekim save long mi","poem":2},{"text":"na krosim mi.","poem":3},{"text":"Tasol mi no ken pren","poem":1},{"text":"wantaim ol man nogut.","poem":2},{"text":"Long wanem, oltaim mi save beten","poem":1},{"text":"long God","poem":3},{"text":"long em i ken bekim","poem":2},{"text":"pasin nogut bilong ol.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Taim sampela man i kisim","poem":1},{"text":"ol dispela man nogut","poem":2},{"text":"na bagarapim ol,","poem":3},{"text":"orait ol bai i save olsem,","poem":2},{"text":"tok bilong Bikpela i tru olgeta.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Na bai ol i tromoi bun","poem":1},{"text":"bilong ol dispela man","poem":2},{"text":"i go long ples matmat,","poem":3},{"text":"olsem man i brukim hap diwai","poem":2},{"text":"i go liklik liklik","poem":3},{"text":"na tromoi nabaut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tasol God, Bikpela,","poem":1},{"text":"mi save bilip long yu.","poem":2},{"text":"Lukautim mi gut,","poem":1},{"text":"yu no ken larim mi i dai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Banisim mi","poem":1},{"text":"bai mi no ken pas long ol umben","poem":2},{"text":"ol man nogut i haitim i stap.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mekim ol man nogut i pas tru","poem":1},{"text":"long ol umben ol yet i taitim.","poem":2},{"text":"Tasol mi nogat.","poem":3},{"text":"Mi ken wokabaut gut","poem":1},{"text":"na i no gat wanpela samting","poem":2},{"text":"i ken bagarapim mi.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}