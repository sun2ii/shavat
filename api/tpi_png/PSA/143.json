{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":143,"content":[{"type":"heading","content":["Wanpela man i prea long God long helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, mi laik bai yu","poem":1},{"text":"harim prea bilong mi.","poem":3},{"text":"Putim yau long krai bilong mi.","poem":2},{"text":"Yu stretpela","poem":1},{"text":"na yu save tok tru oltaim,","poem":2},{"text":"plis, harim beten bilong mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu no ken skelim mi,","poem":1},{"text":"wokman bilong yu,","poem":2},{"text":"long kot bilong yu.","poem":3},{"text":"Long wanem, i no gat wanpela man","poem":1},{"text":"i no gat asua","poem":3},{"text":"na i stap stret long ai bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Birua bilong mi em i ranim mi pinis","poem":1},{"text":"na i daunim mi tru.","poem":2},{"text":"Em i kalabusim mi long ples tudak,","poem":1},{"text":"na mi stap olsem man","poem":2},{"text":"i dai longtaim pinis.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Olsem na tingting bilong mi","poem":1},{"text":"i bagarap,","poem":3},{"text":"na bel bilong mi i hevi moa yet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nau mi tingting gen","poem":1},{"text":"long ol samting i bin kamap bipo.","poem":2},{"text":"Na mi tingting long ol samting","poem":1},{"text":"yu bin mekim","poem":2},{"text":"na long ol gutpela wok bilong yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mi save beten long yu","poem":1},{"text":"na spirit bilong mi i laikim yu tru","poem":3},{"text":"olsem nek bilong man i drai","poem":2},{"text":"na em i laikim tumas","poem":3},{"text":"long dring wara.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, yu ken harim","poem":1},{"text":"prea bilong mi nau,","poem":3},{"text":"long wanem, bilip bilong mi","poem":2},{"text":"i bagarap.","poem":3},{"text":"Yu no ken hait long mi,","poem":1},{"text":"nogut mi dai","poem":2},{"text":"na mi go long ples","poem":3},{"text":"bilong ol man i dai pinis.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Mi save bilip long yu,","poem":1},{"text":"olsem na long moningtaim","poem":2},{"text":"yu ken mekim mi i tingting gen","poem":3},{"text":"long bikpela sori bilong yu.","poem":4},{"text":"Mi save prea long yu tasol.","poem":1},{"text":"Olsem na yu mas soim rot long mi","poem":2},{"text":"na mi ken bihainim.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bikpela, mi go long yu","poem":1},{"text":"bilong yu lukautim mi.","poem":2},{"text":"Yu ken kisim bek mi","poem":1},{"text":"long han bilong ol birua","poem":2},{"text":"bilong mi.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Yu God bilong mi,","poem":1},{"text":"mi laik yu skulim mi gut","poem":2},{"text":"bai mi bihainim laik bilong yu.","poem":3},{"text":"Mi laik bai spirit bilong yu","poem":1},{"text":"i mekim gut long mi","poem":2},{"text":"na i stiaim mi long gutpela rot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela, yu mas kisim bek mi","poem":1},{"text":"olsem yu bin promis.","poem":2},{"text":"Yu gutpela tru,","poem":1},{"text":"olsem na yu ken kisim bek mi","poem":2},{"text":"long olgeta hevi i kamap long mi.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu save laikim mi moa yet,","poem":1},{"text":"olsem na yu ken kilim i dai ol birua","poem":2},{"text":"na ol man i bagarapim mi,","poem":3},{"text":"long wanem, mi wokman bilong yu.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}