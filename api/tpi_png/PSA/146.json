{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":146,"content":[{"type":"heading","content":["Ol i litimapim nem bilong God, em Helpim bilong ol"]},{"type":"verse","number":1,"content":[{"text":"Litimapim nem","poem":1},{"text":"bilong Bikpela.","poem":2},{"text":"Mi yet mi mas litimapim","poem":1},{"text":"nem bilong em.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Olgeta taim mi stap long graun","poem":1},{"text":"bai mi litimapim nem bilong em.","poem":2},{"text":"Bai mi mekim song","poem":1},{"text":"bilong litimapim nem","poem":2},{"text":"bilong God bilong mi","poem":3},{"text":"inap long taim mi dai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ol king na ol man bilong graun","poem":1},{"text":"i no inap kisim bek yu.","poem":3},{"text":"Olsem na nogut yu bilip long ol.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taim ol i dai","poem":1},{"text":"ol i tanim i kamap graun gen.","poem":2},{"text":"Na long dispela taim","poem":1},{"text":"ol i no inap mekim","poem":2},{"text":"olgeta samting","poem":3},{"text":"ol i bin tok long mekim.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sapos wanpela man i bilip","poem":1},{"text":"long God bilong Jekop","poem":2},{"text":"bai em i helpim em,","poem":3},{"text":"na sapos dispela man","poem":2},{"text":"i pas wantaim God,","poem":3},{"text":"Bikpela bilong em,","poem":4},{"text":"orait em i ken amamas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"God i bin mekim kamap","poem":1},{"text":"heven na graun na solwara","poem":2},{"text":"na olgeta samting i stap long en.","poem":3},{"text":"Na oltaim God i save bihainim","poem":1},{"text":"olgeta promis bilong em.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bikpela i save helpim ol manmeri","poem":1},{"text":"i stap nogut aninit long ol birua.","poem":2},{"text":"Na em i save givim kaikai","poem":1},{"text":"long ol manmeri i hangre.","poem":2},{"lineBreak":true},{"text":"Bikpela i save pinisim kalabus","poem":1},{"text":"bilong ol man i stap long kalabus.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na em i save mekim ol aipas","poem":1},{"text":"i lukluk gen,","poem":3},{"text":"na i save pinisim hevi","poem":2},{"text":"bilong ol man hevi i daunim ol.","poem":3},{"text":"Bikpela i save laikim tru","poem":1},{"text":"ol stretpela manmeri bilong en.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Em i save lukautim","poem":1},{"text":"ol man bilong narapela ples","poem":2},{"text":"i stap long graun bilong yumi.","poem":3},{"text":"Na em i save helpim ol meri,","poem":1},{"text":"man bilong ol i dai pinis,","poem":3},{"text":"na ol pikinini,","poem":2},{"text":"papa bilong ol i dai pinis.","poem":3},{"text":"Tasol em i save paulim ol samting","poem":1},{"text":"ol man nogut i laik mekim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bikpela bai i stap king","poem":1},{"text":"oltaim oltaim.","poem":2},{"text":"Yupela ol manmeri bilong Saion,","poem":1},{"text":"God bilong yupela","poem":2},{"text":"bai i stap king oltaim oltaim.","poem":3},{"lineBreak":true},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}