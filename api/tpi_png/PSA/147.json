{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":147,"content":[{"type":"heading","content":["Bikpela bilong yumi i gat biknem na i gat olgeta strong"]},{"type":"verse","number":1,"content":[{"text":"Litimapim nem","poem":1},{"text":"bilong Bikpela!","poem":2},{"text":"I gutpela long yumi singim song","poem":1},{"text":"na litimapim nem","poem":2},{"text":"bilong God bilong yumi.","poem":3},{"text":"Em i gutpela na stretpela pasin","poem":1},{"text":"long yumi litimapim","poem":2},{"text":"biknem bilong em.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Bikpela i sanapim Jerusalem gen","poem":1},{"text":"na i bringim i kam bek","poem":2},{"text":"ol manmeri","poem":3},{"text":"ol birua i bin kisim ol i go kalabus.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Em i save mekim orait ol manmeri,","poem":1},{"text":"hevi i bagarapim tingting bilong ol","poem":2},{"text":"na ol i pilim nogut.","poem":3},{"text":"Na em i pasim ol sua bilong ol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Em i makim pinis","poem":1},{"text":"namba bilong ol sta,","poem":3},{"text":"na em i save kolim nem","poem":2},{"text":"bilong ol sta wan wan.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Bikpela bilong yumi i gat biknem","poem":1},{"text":"na i gat olgeta strong.","poem":3},{"text":"Yumi no inap makim save bilong en.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Em i save litimapim ol man","poem":1},{"text":"i save daunim bel bilong ol yet,","poem":3},{"text":"tasol em i save","poem":2},{"text":"krungutim strong tru","poem":3},{"text":"ol manmeri nogut.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Singim ol song bilong litimapim","poem":1},{"text":"nem bilong Bikpela.","poem":2},{"text":"Paitim gita na mekim musik","poem":1},{"text":"long God bilong yumi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Em i save mekim ol klaut","poem":1},{"text":"i kamap long skai,","poem":3},{"text":"na salim ren i kam daun","poem":2},{"lineBreak":true},{"text":"na mekim gras i kamap","poem":2},{"text":"nabaut long ol maunten.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i save givim kaikai","poem":1},{"text":"long olgeta abus,","poem":3},{"text":"na taim ol yangpela kotkot","poem":2},{"text":"i singaut","poem":4},{"text":"em i save givim kaikai long ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bikpela i no save amamas","poem":1},{"text":"long ol strongpela hos","poem":2},{"text":"na ol strongpela soldia. Nogat.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Em i save amamas long ol manmeri","poem":1},{"text":"i save pret long em,","poem":3},{"text":"na long ol manmeri i save bilip","poem":2},{"text":"long em i save sori long ol oltaim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yupela ol Jerusalem,","poem":1},{"text":"litimapim nem bilong Bikpela!","poem":2},{"text":"Yes, yupela ol Saion,","poem":1},{"text":"litimapim nem","poem":2},{"text":"bilong God bilong yupela.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Em i save strongim ol dua","poem":1},{"text":"bilong banis bilong yu, Jerusalem,","poem":3},{"text":"na em i save mekim gut tru","poem":2},{"text":"long ol manmeri bilong yu.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Em i save lukautim","poem":1},{"text":"graun bilong yupela,","poem":3},{"text":"na mekim gutpela wit tru","poem":2},{"text":"i kamap long gaden","poem":3},{"text":"na yupela i kaikai na i pulap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sapos em i mekim wanpela tok,","poem":1},{"text":"orait wantu tasol","poem":2},{"text":"dispela tok i kam daun","poem":3},{"text":"long graun.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Em i save salim planti ais","poem":1},{"text":"i kam daun","poem":2},{"text":"na i karamapim graun.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Em i save salim planti ren ais","poem":1},{"text":"inap olsem wesan bilong nambis.","poem":2},{"text":"Na em i mekim ples i kamap kol tru","poem":1},{"text":"na i no gat man inap sakim kol.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Orait bihain em i tok gen","poem":1},{"text":"na ais i kamap wara.","poem":2},{"text":"Em i kirapim win","poem":1},{"text":"na win i mekim wara i ran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Em i givim tok bilong em","poem":1},{"text":"long Jekop.","poem":2},{"text":"Ol dispela tok na lo","poem":1},{"text":"em i givim long ol Israel.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Em i no save mekim olsem","poem":1},{"text":"long ol arapela lain.","poem":3},{"text":"Ol i no save ol lo bilong en.","poem":2},{"text":"Yumi litimapim","poem":1},{"text":"nem bilong Bikpela!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}