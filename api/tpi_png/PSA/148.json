"content":[{"text":"Heven antap tru,","poem":1},{"text":"litimapim nem bilong en!","poem":2},{"text":"Wara i stap antap long skai,","poem":1},{"text":"litimapim nem bilong en!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ol dispela samting i mas litimapim","poem":1},{"text":"nem bilong Bikpela,","poem":3},{"text":"long wanem, em yet i tok","poem":2},{"text":"na ol i kamap na i stap.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Em i tok na ol i stap oltaim","poem":1},{"text":"long hap bilong ol,","poem":3},{"text":"na ol i no inap sakim tok","poem":2},{"text":"bilong en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yupela ol traipela pis","poem":1},{"text":"na ol samting i stap","poem":2},{"text":"long as bilong solwara","poem":3},{"text":"i daun moa,","poem":4}]},{"type":"verse","number":8,"content":[{"text":"na lait i kamap long klaut","poem":2},{"lineBreak":true},{"text":"na ren ais na ol klaut nabaut","poem":2},{"lineBreak":true},{"text":"na strongpela win i save bihainim","poem":2},{"text":"tok bilong Bikpela,","poem":3},{"text":"yupela litimapim nem bilong en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yupela ol bikpela maunten","poem":1},{"text":"na ol liklik maunten,","poem":2},{"lineBreak":true},{"text":"na ol diwai i save karim kaikai","poem":2},{"lineBreak":true},{"text":"na ol diwai bilong bus,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"na olgeta abus","poem":2},{"text":"ol man i save bosim","poem":3},{"text":"na ol wel abus,","poem":2},{"lineBreak":true},{"text":"na ol pukpuk na ol pisin,","poem":2},{"lineBreak":true},{"text":"yupela litimapim","poem":2},{"text":"nem bilong Bikpela!","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yupela ol king","poem":1},{"text":"na olgeta lain manmeri,","poem":2},{"lineBreak":true},{"text":"na ol gavman","poem":2},{"lineBreak":true},{"text":"na olgeta arapela hetman,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"na ol yangpela man","poem":2},{"lineBreak":true},{"text":"na ol yangpela meri,","poem":2},{"lineBreak":true},{"text":"na ol lapun na ol pikinini,","poem":2},{"lineBreak":true},{"text":"yupela olgeta","poem":2},{"text":"litimapim nem bilong Bikpela!","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Tru tumas, olgeta i mas litimapim","poem":1},{"text":"nem bilong Bikpela.","poem":2},{"text":"Biknem bilong em wanpela","poem":1},{"text":"i winim tru","poem":2},{"text":"biknem bilong olgeta manmeri.","poem":3},{"text":"Biknem bilong en i antap tru,","poem":1},{"text":"i winim heven na graun.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Em i laikim tru ol Israel","poem":1},{"text":"na em i save strongim","poem":2},{"text":"ol manmeri bilong en,","poem":3},{"text":"olsem na ol i save litimapim","poem":2},{"text":"nem bilong en.","poem":3},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}