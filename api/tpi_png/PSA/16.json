{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":16,"content":[{"type":"heading","content":["Man i bilip na i beten long God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Miktam."]},{"type":"verse","number":1,"content":[{"text":"God, yu mas lukautim mi.","poem":1},{"lineBreak":true},{"text":"Mi kam long yu","poem":1},{"text":"bilong mi ken i stap gut.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi tokim God olsem,","poem":1},{"text":"“Yu Bikpela bilong mi.","poem":2},{"lineBreak":true},{"text":"Olgeta gutpela samting mi holim,","poem":2},{"text":"i kam long han bilong yu tasol.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ol manmeri bilong God,","poem":1},{"text":"ol i gutpela manmeri tru.","poem":2},{"text":"Mi save amamas tru","poem":1},{"text":"long i stap wantaim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ol manmeri i save ran i go","poem":1},{"text":"long ol giaman god,","poem":3},{"text":"bai ol i karim planti hevi.","poem":2},{"text":"Mi no ken bung wantaim ol","poem":1},{"text":"na mekim ofa,","poem":3},{"text":"na mi no ken lotu","poem":2},{"text":"long ol god bilong ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, yu tasol yu bilong mi","poem":1},{"text":"na mi no gat","poem":2},{"text":"narapela samting moa.","poem":3},{"text":"Na yu givim mi olgeta samting","poem":1},{"text":"mi sot long en.","poem":2},{"text":"Laip bilong mi i stap","poem":1},{"text":"long han bilong yu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi kisim olgeta gutpela samting","poem":1},{"text":"long yu tasol.","poem":2},{"text":"Tru tumas, ol dispela samting","poem":1},{"text":"i gutpela tru!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi litimapim nem bilong Bikpela,","poem":1},{"text":"long wanem, em i save stiaim mi.","poem":2},{"text":"Na long nait bel bilong mi","poem":1},{"text":"i save skulim mi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oltaim mi save pilim Bikpela","poem":1},{"text":"i stap klostu long mi.","poem":2},{"text":"Em i stap klostu","poem":1},{"text":"na i givim strong long mi,","poem":3},{"text":"olsem na i no gat wanpela samting","poem":2},{"text":"i ken mekim mi i pret na guria.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Olsem na bel bilong mi i gutpela tru,","poem":1},{"text":"na spirit bilong mi i amamas.","poem":2},{"text":"Na mi no save pret liklik","poem":1},{"text":"long wanpela samting.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Long wanem, bai yu no larim mi","poem":1},{"text":"i go i stap","poem":2},{"text":"long ples bilong ol man i dai pinis.","poem":3},{"text":"Na bai yu no larim","poem":1},{"text":"man bilong yu yet","poem":2},{"text":"i sting long matmat,","poem":3},{"text":"long wanem, yu laikim mi tumas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yu yet bai yu soim mi","poem":1},{"text":"rot bilong kisim laip.","poem":2},{"text":"Yu stap klostu long mi","poem":1},{"text":"na mi save amamas moa yet.","poem":2},{"text":"Yu save helpim mi","poem":1},{"text":"na bel bilong mi","poem":2},{"text":"i amamas oltaim oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}