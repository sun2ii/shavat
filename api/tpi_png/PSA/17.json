{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":17,"content":[{"type":"heading","content":["Beten bilong man i no bin mekim rong"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela beten."]},{"type":"verse","number":1,"content":[{"text":"God, harim singaut","poem":1},{"text":"bilong mi.","poem":2},{"text":"Mi wokabaut stret","poem":1},{"text":"na mi bringim ol wari bilong mi","poem":2},{"text":"i kam long yu.","poem":3},{"text":"Mi no giaman long beten,","poem":1},{"text":"olsem na mi laik bai yu harim mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bai yu helpim mi na mi winim kot.","poem":1},{"lineBreak":true},{"text":"Long wanem, yu save gut","poem":1},{"text":"long wanem pasin i stretpela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yu save long bel bilong mi.","poem":1},{"lineBreak":true},{"text":"Yu kam lukim mi long nait tu","poem":1},{"text":"na yu traim mi,","poem":2},{"lineBreak":true},{"text":"na yu no lukim tingting nogut","poem":2},{"text":"i stap long mi.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi no save mekim tok nogut","poem":1},{"text":"olsem sampela man i mekim.","poem":2},{"text":"Mi holim strong tok bilong yu,","poem":1},{"text":"na mi givim baksait","poem":2},{"text":"long pasin bilong kros pait.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Oltaim mi save wokabaut","poem":1},{"text":"long rot bilong yu,","poem":3},{"text":"na lek bilong mi i no abrus liklik.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God, yu save bekim prea bilong mi,","poem":1},{"text":"olsem na mi save beten long yu.","poem":2},{"text":"Yu ken putim yau","poem":1},{"text":"na harim prea bilong mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God, helpim bilong mipela,","poem":1},{"text":"soim bikpela marimari bilong yu","poem":2},{"text":"long mipela.","poem":3},{"text":"Mipela i stap klostu long yu","poem":1},{"text":"na hait long ol birua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lukautim mi","poem":1},{"text":"olsem yu save lukautim","poem":2},{"text":"ai bilong yu yet.","poem":3},{"text":"Haitim mi gut olsem kakaruk mama","poem":1},{"text":"i save karamapim ol pikinini","poem":2},{"text":"long wing bilong en.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Olsem bai ol man nogut","poem":1},{"text":"i no inap bagarapim mi.","poem":2},{"text":"Ol i birua nogut tru long mi,","poem":1},{"text":"na ol i wok long banisim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ol i no save marimari liklik","poem":1},{"text":"long ol arapela man.","poem":2},{"text":"Ol i save bikmaus","poem":1},{"text":"na litimapim nem bilong ol yet.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ol i bihainim lek bilong mi,","poem":1},{"text":"na nau ol i banisim mi.","poem":2},{"text":"Ol i makim mi pinis","poem":1},{"text":"na ol i wet long daunim mi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ol i olsem laion i laik kilim abus,","poem":1},{"text":"na olsem yangpela laion i hait","poem":2},{"text":"na i was i stap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bikpela, yu kam pait","poem":1},{"text":"long ol birua bilong mi","poem":3},{"text":"na daunim ol.","poem":2},{"text":"Kisim bainat bilong yu","poem":1},{"text":"na pait long ol","poem":3},{"text":"na kisim bek mi long han","poem":2},{"text":"bilong ol man bilong mekim sin.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Tru, God, yu mas helpim mi","poem":1},{"text":"long strong bilong yu,","poem":3},{"text":"na ol man i no inap pinisim mi.","poem":2},{"text":"Kisim bek mi","poem":1},{"text":"long han bilong ol dispela man","poem":2},{"text":"i save bungim ol samting","poem":3},{"text":"bilong graun tasol.","poem":4},{"text":"Yu redi pinis long bekim","poem":1},{"text":"pasin nogut bilong ol.","poem":2},{"text":"Orait nau yu ken mekim save","poem":1},{"text":"long ol.","poem":2},{"text":"Mekim save","poem":1},{"text":"long ol pikinini bilong ol","poem":3},{"text":"na long ol lain tumbuna","poem":2},{"text":"i kamap bihain.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Tasol mi stretpela man,","poem":1},{"text":"na bihain bai mi lukim yu tru.","poem":2},{"text":"Taim mi lusim slip na mi kirap","poem":1},{"text":"na mi pilim yu i stap wantaim mi,","poem":3},{"text":"bai mi amamas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}