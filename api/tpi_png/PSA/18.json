":"mi save go long en","poem":3},{"lineBreak":true},{"text":"na hait long ol birua.","poem":3},{"text":"Bikpela i olsem hap plang bilong mi","poem":1},{"text":"na em i haitim mi long ol birua.","poem":2},{"text":"Em i gat strong bilong kisim bek mi","poem":1},{"text":"na lukautim mi.","poem":2},{"text":"Em i olsem strongpela banis","poem":1},{"text":"bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mi beten long Bikpela","poem":1},{"text":"na em i helpim mi,","poem":3},{"text":"na ol birua","poem":2},{"text":"i no inap bagarapim mi.","poem":3},{"text":"Yumi mas litimapim nem","poem":1},{"text":"bilong Bikpela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Klostu dai i painim mi,","poem":1},{"text":"olsem ol baklain","poem":2},{"text":"i pasim mi strong,","poem":3},{"text":"na olsem si i kirap bikpela","poem":2},{"text":"na i laik karamapim mi.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Klostu dai i holim mi","poem":1},{"text":"na mi go long matmat","poem":3},{"text":"olsem umben i holimpas mi","poem":2},{"text":"na mi no inap long ranawe.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mi bel hevi nogut","poem":1},{"text":"na mi singaut strong long Bikpela.","poem":2},{"text":"Mi singaut long God bilong mi","poem":1},{"text":"bai em i helpim mi.","poem":2},{"text":"Em i stap long haus bilong en","poem":1},{"text":"na em i harim singaut bilong mi.","poem":2},{"text":"Na em i putim yau","poem":1},{"text":"long beten bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Orait nau Bikpela i kros","poem":1},{"text":"long ol birua bilong mi.","poem":2},{"text":"Olsem na em i mekim graun","poem":1},{"text":"i guria nogut tru,","poem":3},{"text":"na ol maunten i seksek moa yet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Smok i kamap","poem":1},{"text":"long nus bilong Bikpela.","poem":3},{"text":"Na paia i kamap","poem":1},{"text":"long maus bilong en","poem":3},{"text":"na kukim planti samting.","poem":2},{"text":"Na em i sutim ol hap paia","poem":1},{"text":"i go nabaut.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i opim skai na i kam daun.","poem":1},{"lineBreak":true},{"text":"Na blakpela klaut i stap aninit","poem":1},{"text":"long lek bilong en.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"I olsem wanpela ensel i karim em","poem":1},{"text":"na i flai i kam.","poem":2},{"text":"Na i olsem win i gat wing","poem":1},{"text":"bilong pisin","poem":3},{"text":"na i karim God i kam hariap tru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Em i mekim tudak i kamap","poem":1},{"text":"olsem haus sel","poem":2},{"text":"em i hait i stap long en,","poem":3},{"text":"na ol blakpela klaut bilong ren","poem":2},{"text":"i karamapim em.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Tasol em i mekim ol klaut","poem":1},{"text":"i lait olgeta,","poem":3},{"text":"na ol hap paia na ren ais","poem":2},{"text":"i sut i kam ausait","poem":3},{"text":"long ol dispela klaut.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Bikpela i stap long heven","poem":1},{"text":"na i bikmaus moa yet","poem":2},{"text":"olsem klaut i pairap.","poem":3},{"text":"God Antap Tru i autim tok","poem":1},{"text":"bilong en,","poem":3},{"text":"na ol hap paia na ren ais","poem":2},{"text":"i sut i kam daun.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Em i mekim lait bilong klaut","poem":1},{"text":"i kamap olsem ol spia bilong en,","poem":3},{"text":"na em i sutim ol birua","poem":2},{"text":"na ol i ranawe nabaut.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Bikpela, yu krosim ol birua","poem":1},{"text":"na belhat bilong yu","poem":2},{"text":"i olsem strongpela win i sakim ol.","poem":3},{"text":"Na belhat bilong yu","poem":1},{"text":"i mekim solwara i drai olgeta,","poem":3},{"text":"na ol samting","poem":2},{"text":"bilong strongim graun","poem":4},{"text":"i kamap ples klia.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bikpela i stap antap","poem":1},{"text":"na i putim han i kam daun","poem":2},{"lineBreak":true},{"text":"na i kisim bek mi.","poem":2},{"text":"Bikpela si i karamapim mi","poem":1},{"text":"tasol em i pulim mi i kam antap.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ol birua bilong mi i strong tru","poem":1},{"text":"na mi no inap winim ol.","poem":2},{"text":"Tasol Bikpela i kisim bek mi","poem":1},{"text":"long han bilong ol.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Bipo taim nogut i painim mi","poem":1},{"text":"na ol birua i kam pait long mi.","poem":2},{"text":"Tasol Bikpela i bin was long mi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Em i bin helpim mi na mi stap gut.","poem":1},{"lineBreak":true},{"text":"Em i laikim mi tumas,","poem":1},{"text":"olsem na em i kisim bek mi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mi bihainim stretpela pasin,","poem":1},{"text":"olsem na Bikpela i givim mi","poem":2},{"text":"planti gutpela samting.","poem":3},{"text":"Mi no mekim wanpela rong,","poem":1},{"text":"olsem na God","poem":2},{"text":"i mekim gut long mi.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Mi bihainim gut lo bilong Bikpela.","poem":1},{"lineBreak":true},{"text":"Mi no bin givim baksait","poem":1},{"text":"long God bilong mi","poem":3},{"text":"na mekim pasin nogut.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mi bin tingting oltaim","poem":1},{"text":"long ol lo bilong en,","poem":3},{"text":"na mi no bin sakim","poem":2},{"text":"gutpela tok bilong en.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Em i save, mi no gat wanpela asua.","poem":1},{"lineBreak":true},{"text":"Mi bin was gut","poem":1},{"text":"long wokabaut bilong mi,","poem":3},{"text":"nogut mi mekim wanpela rong.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Olsem na Bikpela i tingim","poem":1},{"text":"stretpela pasin bilong mi,","poem":3},{"text":"na em i bekim","poem":2},{"text":"gutpela pasin long mi,","poem":3},{"text":"long wanem, mi stap klin","poem":2},{"text":"long ai bilong em.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bikpela, sapos man i no lusim yu,","poem":1},{"text":"orait yu no save lusim em.","poem":2},{"text":"Sapos man i mekim stretpela pasin","poem":1},{"text":"na i no gat asua,","poem":3},{"text":"orait yu save bekim","poem":2},{"text":"stretpela pasin tasol long em.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Sapos wanpela man","poem":1},{"text":"i bihainim klinpela pasin,","poem":3},{"text":"orait yu save soim em","poem":2},{"text":"klinpela pasin bilong yu.","poem":3},{"text":"Tasol sapos man","poem":1},{"text":"i bihainim pasin nogut,","poem":3},{"text":"orait yu save bekim nogut","poem":2},{"text":"long em.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Yu save kisim bek","poem":1},{"text":"ol manmeri i daunim ol yet.","poem":2},{"text":"Tasol yu save daunim ol manmeri","poem":1},{"text":"i litimapim nem bilong ol yet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"God, Bikpela, yu save givim lait","poem":1},{"text":"long mi,","poem":3},{"text":"na yu save rausim tudak long mi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"God, sapos yu helpim mi,","poem":1},{"text":"bai mi inap daunim","poem":2},{"text":"bikpela lain birua.","poem":3},{"text":"Na sapos yu strongim mi,","poem":1},{"text":"bai mi inap kalapim","poem":2},{"text":"bikpela banis bilong taun.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Pasin bilong God i gutpela tru","poem":1},{"text":"na i stret olgeta.","poem":2},{"text":"Sapos em i promis","poem":1},{"text":"long mekim wanpela samting,","poem":3},{"text":"orait tok bilong en em i tru olgeta.","poem":2},{"text":"Bikpela i olsem","poem":1},{"text":"hap plang bilong pait,","poem":3},{"text":"na em i save lukautim gut","poem":2},{"text":"olgeta man i go long em","poem":3},{"text":"na ol i hait long ol birua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bikpela tasol em i God tru.","poem":1},{"lineBreak":true},{"text":"Em wanpela tasol i banisim yumi","poem":1},{"text":"olsem bikpela ston.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"God tasol i save mekim mi","poem":1},{"text":"i sanap strong","poem":3},{"text":"Na em i save lukautim mi gut","poem":1},{"text":"long taim mi wokabaut.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Em i mekim mi i wokabaut gut tru","poem":1},{"text":"olsem ol wel abus","poem":2},{"text":"antap long ol maunten,","poem":3},{"text":"na mi no inap pundaun.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Em i skulim mi","poem":1},{"text":"long pasin bilong pait,","poem":3},{"text":"na em i mekim han bilong mi","poem":2},{"text":"i strong.","poem":3},{"text":"Mi inap taitim strongpela banara","poem":1},{"text":"ol i wokim long bras.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bikpela, yu bin kisim bek mi","poem":1},{"text":"long han bilong ol birua.","poem":2},{"text":"Yu givim mi hap plang bilong yu","poem":1},{"text":"na mi hait i stap baksait long en.","poem":2},{"text":"Yu bin holim han bilong mi","poem":1},{"text":"na mi sanap strong.","poem":2},{"text":"Yu bin bekim singaut bilong mi,","poem":1},{"text":"olsem na mi gat biknem","poem":2},{"text":"long ai bilong ol manmeri.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Yu bin givim gutpela rot long mi","poem":1},{"text":"na lek bilong mi i no wel.","poem":2},{"text":"Mi wokabaut na mi no pundaun.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Mi bin ranim ol birua","poem":1},{"text":"na holimpasim ol.","poem":2},{"text":"Mi mekim save tru long ol","poem":1},{"text":"na mi pinisim ol olgeta.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mi sutim ol na ol i pundaun.","poem":1},{"lineBreak":true},{"text":"Ol i slip i stap","poem":1},{"text":"klostu long lek bilong mi,","poem":3},{"text":"na ol i no inap kirap gen.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yu givim mi strong bilong pait.","poem":1},{"lineBreak":true},{"text":"Na yu putim ol birua","poem":1},{"text":"long han bilong mi,","poem":3},{"text":"na mi winim ol.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yu mekim ol birua i tanim baksait","poem":1},{"text":"na i ranawe long mi,","poem":3},{"text":"na mi pinisim ol dispela man","poem":2},{"text":"i no laikim mi.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Ol i singaut","poem":1},{"text":"long ol man i mas i kam helpim ol,","poem":2},{"text":"tasol i no gat man i stap.","poem":3},{"text":"Ol i krai long Bikpela,","poem":1},{"text":"tasol em i no harim prea bilong ol.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Mi bagarapim ol tru","poem":1},{"text":"na ol i kamap olsem das","poem":2},{"text":"win i tromoi i go nabaut.","poem":3},{"text":"Mi rausim ol birua i go","poem":1},{"text":"na ol i stap nating","poem":2},{"text":"olsem graun malumalum","poem":3},{"text":"i stap long rot.","poem":4}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Taim ol manmeri i birua long mi,","poem":1},{"text":"yu bin helpim mi","poem":2},{"text":"na ol i no bagarapim mi.","poem":3},{"text":"Na yu larim mi i stap bosman","poem":1},{"text":"bilong ol arapela lain manmeri tu.","poem":2},{"text":"Ol manmeri mi no bin save long ol,","poem":1},{"text":"nau ol i stap aninit long mi.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ol manmeri bilong ol arapela kantri","poem":1},{"text":"i harim tok","poem":2},{"text":"long biknem bilong mi,","poem":4},{"text":"na w