 brukim hankap","poem":2},{"text":"bilong tupela.","poem":3},{"text":"Yumi rausim ol baklain","poem":2},{"text":"tupela i pasim yumi long en.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God i sindaun","poem":1},{"text":"long sia king bilong en","poem":2},{"text":"long heven,","poem":3},{"text":"na em i lap na tok bilas long ol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Em i belhat tru","poem":1},{"text":"na i givim strongpela tok long ol.","poem":2},{"text":"Na bikpela kros bilong en","poem":1},{"text":"i mekim ol i pret moa yet.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na em i tokim ol olsem,","poem":1},{"text":"“Mi makim pinis dispela man","poem":2},{"text":"bilong i stap king.","poem":3},{"text":"Mi yet mi putim em","poem":2},{"text":"i stap long Saion,","poem":3},{"text":"dispela maunten bilong mi yet.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"King i tok, “Nau bai mi autim tok","poem":1},{"text":"Bikpela i bin givim mi.","poem":3},{"text":"Em i tokim mi olsem,","poem":2},{"lineBreak":true},{"text":"‘Yu Pikinini bilong mi.","poem":2},{"lineBreak":true},{"text":"Nau mi kamap papa bilong yu.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Askim mi, na bai mi givim","poem":2},{"text":"olgeta lain manmeri long yu,","poem":3},{"text":"na bai yu bosim olgeta hap graun.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bai yu bosim ol","poem":2},{"text":"long strongpela han bilong yu.","poem":3},{"text":"Na bai yu brukim ol liklik liklik,","poem":2},{"text":"olsem man i brukim","poem":3},{"text":"sospen graun.’”","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Olsem na yupela ol king,","poem":1},{"text":"yupela putim gut yau","poem":2},{"lineBreak":true},{"text":"na stretim pasin bilong yupela.","poem":2},{"text":"Yupela ol hetman bilong graun,","poem":1},{"text":"yupela harim dispela tok","poem":2},{"text":"na yupela lukaut.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Yupela i mas pret long God","poem":1},{"text":"na aninit long em.","poem":2},{"text":"Yupela i mas guria long em","poem":1},{"text":"na amamas wantaim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yupela i mas aninit","poem":1},{"text":"long pikinini bilong en","poem":3},{"text":"na givim kis long em.","poem":2},{"text":"Nogut em i kros long yupela","poem":1},{"text":"na yupela i dai.","poem":2},{"text":"Long wanem,","poem":1},{"text":"em i save belhat hariap.","poem":2},{"text":"Man i save bilip long God","poem":1},{"text":"na pas tru long em,","poem":3},{"text":"em i ken amamas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}