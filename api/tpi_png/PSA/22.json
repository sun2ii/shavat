{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":22,"content":[{"type":"heading","content":["Krai bilong man i gat hevi na song bilong tenkyu long God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “Dia meri bilong moning.”"]},{"type":"verse","number":1,"content":[{"text":"God bilong mi,","poem":1},{"text":"God bilong mi,","poem":2},{"text":"bilong wanem yu lusim mi?","poem":3},{"text":"Bilong wanem yu no laik helpim mi?","poem":1},{"lineBreak":true},{"text":"Bilong wanem yu no harim","poem":1},{"text":"krai bilong mi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God, mi save singaut long yu","poem":1},{"text":"long san,","poem":3},{"text":"tasol yu no harim tok bilong mi.","poem":2},{"text":"Mi singaut long yu long nait tu,","poem":1},{"text":"na mi no malolo liklik.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tasol yu,","poem":1},{"text":"yu God bilong mekim gutpela","poem":2},{"text":"na stretpela pasin olgeta.","poem":3},{"text":"Yu stap king, na ol Israel","poem":1},{"text":"i save litimapim nem bilong yu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bipo ol tumbuna bilong mipela","poem":1},{"text":"ol i bilip long yu.","poem":2},{"text":"Ol i bilip na yu helpim ol","poem":1},{"text":"na ol birua i no daunim ol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol i beten long yu","poem":1},{"text":"na yu kisim bek ol","poem":2},{"text":"long han bilong ol birua.","poem":3},{"text":"Ol i bilip tru long yu","poem":1},{"text":"na bilip bilong ol i no lus nating.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tasol mi,","poem":1},{"text":"mi olsem liklik snek bilong graun.","poem":2},{"text":"Mi samting nating.","poem":1},{"lineBreak":true},{"text":"Olgeta man i krosim mi","poem":1},{"text":"na ol i givim baksait long mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olgeta manmeri i lukim mi","poem":1},{"text":"na ol i tok bilas long mi.","poem":2},{"text":"Ol i sutim tang long mi","poem":1},{"text":"na tromoi het bilong ol.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ol i tok, “Yu save bilip long God.","poem":1},{"text":"Bilong wanem em i no helpim yu","poem":2},{"text":"na kisim bek yu?","poem":3},{"text":"Sapos God i laikim yu,","poem":2},{"text":"bilong wanem","poem":3},{"text":"em i no helpim yu?”","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"God, yu tasol yu kisim mi","poem":1},{"text":"long bel bilong mama","poem":3},{"text":"na mi kamap gut.","poem":2},{"text":"Na yu lukautim mi","poem":1},{"text":"long taim mi dring susu yet.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mi bilip long yu,","poem":1},{"text":"taim mama i karim mi","poem":2},{"text":"na i kam inap nau.","poem":3},{"text":"Mama i karim mi nupela yet","poem":1},{"text":"na yu stap God bilong mi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hevi i kamap long mi nau,","poem":1},{"text":"olsem na yu no ken lusim mi.","poem":2},{"text":"Mi no gat wanpela man","poem":1},{"text":"bilong helpim mi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Planti birua i ranim mi","poem":1},{"text":"olsem ol bulmakau man.","poem":2},{"text":"Ol i strong tumas olsem","poem":1},{"text":"ol strongpela bulmakau man","poem":2},{"text":"bilong distrik Basan.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ol i redi long bagarapim mi,","poem":1},{"text":"olsem laion i singaut nogut","poem":2},{"lineBreak":true},{"text":"na i opim maus","poem":2},{"text":"bilong kaikai abus.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Strong bilong mi i pinis olgeta,","poem":1},{"text":"olsem wara ol i kapsaitim nating","poem":2},{"text":"na i pinis olgeta.","poem":3},{"text":"Olgeta skru bilong bun i lus.","poem":1},{"lineBreak":true},{"text":"Bel bilong mi i malumalum tru,","poem":1},{"text":"olsem gris i kamap olsem wara.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nek bilong mi em i drai pinis,","poem":1},{"text":"na tang bilong mi i pas long maus.","poem":2},{"text":"Yu yet yu lusim mi","poem":1},{"text":"na mi laik i dai olgeta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dispela ol man nogut","poem":1},{"text":"i raunim mi long olgeta hap","poem":3},{"text":"olsem ol dok i banisim wel abus.","poem":2},{"text":"Ol i sutim han na lek bilong mi","poem":1},{"text":"long tit bilong ol.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Olgeta bun bilong mi","poem":1},{"text":"i kamap ples klia.","poem":2},{"text":"Na dispela ol man i lukim mi,","poem":1},{"text":"na ol i amamas long mi bagarap.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ol i tilim klos bilong mi","poem":1},{"text":"na ol i kisim,","poem":3},{"text":"na ol i pilai satu","poem":2},{"text":"bilong makim wanem man","poem":3},{"text":"i ken kisim saket bilong mi.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bikpela, yu no ken i stap","poem":1},{"text":"longwe long mi.","poem":2},{"text":"Yu save helpim mi oltaim.","poem":1},{"lineBreak":true},{"text":"Na yu ken kam hariap","poem":1},{"text":"na helpim mi nau.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yu mas kisim bek mi","poem":1},{"text":"bai ol i no inap kilim mi i dai.","poem":2},{"text":"Helpim mi,","poem":1},{"text":"na dispela ol man i olsem ol dok","poem":2},{"text":"bai ol i no ken kilim mi i dai.","poem":3},{"text":"Bai mi stap laip.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ol i laik pinisim mi","poem":1},{"text":"olsem laion i kaikai wel abus.","poem":2},{"text":"Ol i stap olsem ol wel bulmakau","poem":1},{"text":"i laik sutim mi long kom bilong ol.","poem":2},{"text":"Yu mas kisim bek mi","poem":1},{"text":"long han bilong ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yu mekim olsem","poem":1},{"text":"na bai mi autim tok","poem":2},{"text":"long ol brata bilong mi","poem":3},{"text":"long strongpela wok","poem":2},{"text":"yu bin mekim.","poem":3},{"text":"Taim ol i bung bilong lotu","poem":1},{"text":"bai mi go namel long ol","poem":2},{"text":"na litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Bai mi tok olsem,","poem":1},{"text":"“Yupela ol lain bilong God,","poem":2},{"text":"litimapim nem bilong em.","poem":3},{"text":"Yupela lain bilong Jekop,","poem":2},{"text":"litimapim nem bilong Bikpela.","poem":3},{"text":"Yes, yupela lain bilong Israel,","poem":2},{"text":"yupela lotu long em.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Em i no save givim baksait","poem":2},{"text":"long ol rabisman.","poem":3},{"text":"Em i no save ting","poem":2},{"text":"hevi na pen bilong ol","poem":3},{"text":"em i samting nating.","poem":4},{"text":"Em i no save stap longwe long ol.","poem":2},{"text":"Nogat.","poem":3},{"text":"Em i save harim beten bilong ol.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Long bikpela bung bilong lotu","poem":1},{"text":"bai mi litimapim nem","poem":2},{"text":"bilong yu wanpela tasol.","poem":3},{"text":"Bai mi autim tok","poem":1},{"text":"long olgeta samting yu bin mekim.","poem":2},{"text":"Ofa bipo mi promis long mekim,","poem":1},{"text":"em bai mi mekim","poem":2},{"text":"long ai bilong ol manmeri","poem":3},{"text":"i save pret long yu.","poem":4}]},{"type":"verse","number":26,"content":[{"text":"Ol rabisman bai ol i kaikai","poem":1},{"text":"na i pulap tru.","poem":2},{"text":"Na ol man i go long God,","poem":1},{"text":"bai ol i litimapim nem bilong em.","poem":2},{"text":"God i ken mekim ol","poem":1},{"text":"i stap gut oltaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Olgeta manmeri bilong graun","poem":1},{"text":"bai ol i tingting long God,","poem":2},{"lineBreak":true},{"text":"na bai ol i kam bek long em.","poem":2},{"text":"Olgeta lain manmeri","poem":1},{"text":"bai ol i lotu long em.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Long wanem, Bikpela i stap king","poem":1},{"text":"na em i bosim","poem":2},{"text":"olgeta lain manmeri.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ol bikhetman bai ol i brukim skru","poem":1},{"text":"na lotu long em.","poem":2},{"text":"Ol man i save dai","poem":1},{"text":"na i no inap i stap laip,","poem":3},{"text":"em olgeta bai ol i brukim skru","poem":2},{"text":"na lotu long God.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Ol lain manmeri i kamap bihain","poem":1},{"text":"bai ol i mekim wok bilong em.","poem":2},{"text":"Ol man bai i tokaut long God","poem":1},{"text":"long ol lain i kamap bihain.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ol dispela lain i no kamap yet,","poem":1},{"text":"tasol taim ol i kamap pinis,","poem":2},{"text":"bai ol i tokim ol olsem,","poem":3},{"text":"“God yet i bin kisim bek","poem":2},{"text":"ol manmeri bilong em.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}