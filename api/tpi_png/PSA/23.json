{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":23,"content":[{"type":"heading","content":["Bikpela em i wasman bilong mi"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela em i wasman","poem":1},{"text":"bilong mi.","poem":2},{"text":"Olsem na mi no inap sot","poem":1},{"text":"long wanpela samting.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Em i mekim","poem":1},"Wasman bilong sipsip i holim stik na i bringim ol sipsip i go long ples bilong dring wara na malolo.",{"text":"mi i slip","poem":1},{"text":"long gutpela gras.","poem":3},{"text":"Na em i bringim mi i go","poem":1},{"text":"long ol liklik wara","poem":3},{"text":"na mi dring na mi malolo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Em i givim mi nupela strong.","poem":1},{"lineBreak":true},{"text":"Na em i save bringim mi","poem":1},{"text":"long ol gutpela rot,","poem":3},{"text":"olsem em i tok bipo long mekim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"God, maski mi wokabaut","poem":1},{"text":"long ples nogut na bikpela tudak,","poem":3},{"text":"mi no ken pret","poem":2},{"text":"long samting nogut,","poem":3},{"text":"long wanem, yu stap wantaim mi.","poem":2},{"text":"Mi lukim yu i holim stik","poem":1},{"text":"ol wasman bilong sipsip","poem":2},{"text":"i save holim,","poem":3},{"text":"olsem na bel bilong mi i stap isi.","poem":2},{"text":"Mi no inap bagarap.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yu redim gutpela kaikai bilong mi","poem":1},{"text":"long ples klia","poem":3},{"text":"na ol birua bilong mi","poem":2},{"text":"ol i lukim mi.","poem":3},{"text":"Yu kisim mi","poem":1},{"text":"i kam sindaun wantaim yu,","poem":3},{"text":"na yu lukautim mi gutpela tumas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bikpela, bai yu lukautim mi gut,","poem":1},{"text":"na olgeta de mi stap laip","poem":2},{"text":"bai yu marimari long mi.","poem":3},{"text":"Na bai mi stap oltaim oltaim","poem":1},{"text":"long haus bilong yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}