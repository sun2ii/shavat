{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":25,"content":[{"type":"heading","content":["Man i beten long God i ken stiaim em na lukautim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, nau mi beten","poem":1},{"text":"long yu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu God bilong mi.","poem":1},{"lineBreak":true},{"text":"Mi save bilip long yu tasol.","poem":1},{"lineBreak":true},{"text":"Helpim mi,","poem":1},{"text":"nogut mi bilip nating na mi sem.","poem":2},{"text":"Yu no ken larim ol birua","poem":1},{"text":"i daunim mi","poem":3},{"text":"na ol i amamas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ol man i bilip long yu,","poem":1},{"text":"yu no save lusim ol","poem":2},{"text":"na ol i bilip nating. Nogat.","poem":3},{"text":"Ol man i bikhet long yu,","poem":1},{"text":"ol tasol i mas pilim nogut","poem":2},{"lineBreak":true},{"text":"na sem long pasin ol i mekim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God, yu mas skulim mi","poem":1},{"text":"long gutpela pasin bilong yu,","poem":3},{"text":"na soim mi long rot bilong yu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lainim mi long bihainim","poem":1},{"text":"tok tru bilong yu,","poem":3},{"text":"long wanem, yu save kisim bek mi.","poem":2},{"text":"Long olgeta de mi save wet","poem":1},{"text":"long yu i helpim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bikpela, yu mas tingting","poem":1},{"text":"long marimari na sori bilong yu.","poem":2},{"text":"Yu save mekim dispela pasin","poem":1},{"text":"long bipo yet i kam inap nau.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God, yu no ken tingting moa","poem":1},{"text":"long sin na pasin nogut mi mekim","poem":2},{"text":"taim mi yangpela yet.","poem":3},{"text":"Yu God bilong sori","poem":1},{"text":"na yu gutpela oltaim.","poem":2},{"text":"Yu ken tingting long mi","poem":1},{"text":"na marimari long mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela i gutpela","poem":1},{"text":"na i stretpela olgeta.","poem":2},{"text":"Em i save skulim","poem":1},{"text":"ol man i save mekim sin","poem":3},{"text":"long pasin em i laik","poem":2},{"text":"bai ol i mas bihainim.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i save stiaim","poem":1},{"text":"ol man i stap aninit long em,","poem":3},{"text":"na ol i bihainim stretpela pasin.","poem":2},{"text":"Em i save skulim ol tu","poem":1},{"text":"long rot bilong em.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"God i save givim bel bilong em","poem":1},{"text":"long olgeta manmeri","poem":2},{"text":"i bihainim kontrak","poem":3},{"text":"na lo bilong em.","poem":4},{"text":"Na em i no save","poem":1},{"text":"senisim tingting bilong em.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"God, bihainim promis bilong yu,","poem":1},{"text":"na lusim ol planti sin mi bin mekim.","poem":2},{"text":"Yu ken lusim olgeta rong bilong mi","poem":1},{"text":"na bai mi litimapim","poem":2},{"text":"nem bilong yu.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Olgeta man i bihainim","poem":1},{"text":"tok bilong Bikpela,","poem":3},{"text":"bai God i soim gutpela rot long ol,","poem":2},{"text":"na ol i mas wokabaut long en.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ol kain man olsem","poem":1},{"text":"bai i stap gutpela tru,","poem":3},{"text":"na ol pikinini bilong ol","poem":2},{"text":"bai i stap gut","poem":3},{"text":"long dispela graun.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"God em i pren tru","poem":1},{"text":"bilong ol manmeri","poem":2},{"text":"i save stap aninit long em.","poem":3},{"text":"Na em i save skulim ol long kontrak","poem":1},{"text":"em i bin mekim wantaim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Olgeta taim mi save wetim God","poem":1},{"text":"i helpim mi.","poem":2},{"text":"Em i save kisim bek mi","poem":1},{"text":"long ol samting","poem":2},{"text":"i laik bagarapim mi.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"God, kam long mi gen","poem":1},{"text":"na marimari long mi,","poem":3},{"text":"long wanem, mi stap wanpis","poem":2},{"text":"na strong bilong mi i pinis.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Pinisim olgeta bel hevi bilong mi,","poem":1},{"text":"na bel bilong mi i ken i stap isi.","poem":2},{"text":"Helpim mi,","poem":1},{"text":"na ol hevi","poem":2},{"text":"bai i no inap daunim mi.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Tingting long olgeta bel pen na hevi","poem":1},{"text":"i stap long mi,","poem":3},{"text":"na lusim olgeta sin bilong mi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yu lukim ol birua bilong mi","poem":1},{"text":"ol i planti tumas.","poem":2},{"text":"Ol i no laikim mi liklik. Nogat tru.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kisim bek mi na lukautim mi gut,","poem":1},{"text":"na ol birua","poem":2},{"text":"i no inap bagarapim mi.","poem":3},{"text":"Yu save was long mi,","poem":1},{"text":"olsem na mi kam long yu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mi bilip long yu, olsem na","poem":1},{"text":"yu ken mekim olgeta gutpela","poem":2},{"text":"na stretpela pasin bilong mi","poem":3},{"text":"i lukautim mi oltaim.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"God, yu ken baim bek","poem":1},{"text":"olgeta manmeri bilong yu,","poem":2},{"text":"na olgeta kain kain hevi","poem":1},{"text":"bai i no inap daunim ol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}