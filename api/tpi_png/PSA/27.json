{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":27,"content":[{"type":"heading","content":["Prea bilong litimapim nem bilong God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"God em i lait bilong mi","poem":1},{"text":"na em i helpim bilong mi.","poem":2},{"text":"Olsem na mi no ken guria","poem":1},{"text":"long wanpela man.","poem":2},{"text":"Bikpela tasol i save lukautim mi,","poem":1},{"text":"olsem na mi no ken pret","poem":2},{"text":"long wanpela samting.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sapos ol man nogut i kam klostu","poem":1},{"text":"na traim long bagarapim mi,","poem":3},{"text":"samting bai i sutim lek","poem":2},{"text":"bilong ol dispela man","poem":3},{"text":"na bai ol i pundaun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maski sapos bikpela lain ami","poem":1},{"text":"i kam raunim mi,","poem":3},{"text":"bai mi no ken pret.","poem":2},{"text":"Maski sapos ol birua","poem":1},{"text":"i kam pait long mi,","poem":3},{"text":"mi bilip long God","poem":2},{"text":"na mi no ken surik.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi bin askim God","poem":1},{"text":"long wanpela samting tasol,","poem":3},{"text":"na mi laikim tumas","poem":2},{"text":"bai em i mekim olsem.","poem":3},{"text":"Mi askim em bai mi ken i stap","poem":1},{"text":"long haus bilong em","poem":2},{"text":"inap olgeta de mi gat laip.","poem":3},{"text":"Mi laik amamas","poem":1},{"text":"long em i gutpela tumas long mi.","poem":2},{"text":"Na mi laik askim em","poem":1},{"text":"long soim mi gutpela rot.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taim samting nogut i kamap long mi","poem":1},{"text":"bai em i haitim mi","poem":2},{"text":"long haus bilong em.","poem":3},{"text":"Bai em i pasim dua","poem":1},{"text":"na haitim mi gutpela tru.","poem":2},{"text":"Bai em i putim mi antap","poem":1},{"text":"long wanpela bikpela ston tru","poem":3},{"text":"na mi stap gut.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Olsem na bai mi winim","poem":1},{"text":"ol birua i raunim mi,","poem":3},{"text":"na bai mi daunim ol.","poem":2},{"text":"Bai mi singaut amamas moa yet","poem":1},{"text":"na mekim ofa","poem":2},{"text":"long haus bilong God.","poem":3},{"text":"Bai mi mekim song","poem":1},{"text":"bilong litimapim nem bilong em.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, taim mi singaut long yu,","poem":1},{"text":"yu ken marimari long mi","poem":2},{"text":"na harim beten bilong mi.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Yu tokim mi olsem,","poem":1},{"text":"“Yu kam long mi.”","poem":2},{"text":"Orait Bikpela, bai mi go long yu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yu no ken haitim yu yet long mi.","poem":1},{"lineBreak":true},{"text":"God, yu helpim bilong mi.","poem":1},{"lineBreak":true},{"text":"Mi wokman bilong yu,","poem":1},{"text":"na yu no ken belhat long mi","poem":2},{"text":"na rausim mi.","poem":3},{"text":"Yu bin helpim mi planti taim.","poem":1},{"lineBreak":true},{"text":"Yu no ken lusim mi.","poem":1},{"lineBreak":true},{"text":"Yu no ken ranawe long mi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maski papa na mama","poem":1},{"text":"i givim baksait long mi,","poem":3},{"text":"Bikpela bai i lukautim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela, yu ken lainim mi","poem":1},{"text":"long samting yu laik","poem":2},{"text":"bai mi mekim.","poem":3},{"text":"Mi gat planti birua i stap,","poem":1},{"text":"olsem na yu ken bringim mi","poem":2},{"text":"long gutpela rot.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu no ken lusim mi","poem":1},{"text":"bai ol birua i kisim mi.","poem":2},{"text":"Ol i save mekim tok giaman","poem":1},{"text":"na pretim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tru tumas, bihain bai mi lukim","poem":1},{"text":"God i mekim gut","poem":2},{"text":"long ol manmeri bilong em.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Yu mas bilip na wetim Bikpela","poem":1},{"text":"i kam helpim yu.","poem":2},{"text":"Sanap strong. Yu no ken bel hevi.","poem":1},{"lineBreak":true},{"text":"Yu mas bilip","poem":1},{"text":"na wetim Bikpela i helpim yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}