{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":3,"content":[{"type":"heading","content":["Long moning wanpela man i prea bilong kisim strong"]},{"type":"hebrew_subtitle","content":["Devit i ranawe long Apsalom, pikinini man bilong en, na long dispela taim em i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, ol birua bilong mi","poem":1},{"text":"i kamap planti moa.","poem":2},{"text":"Ol i wok long mekim nogut long mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ol i tokim mi olsem,","poem":1},{"text":"“God bai i no inap helpim yu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tasol tok bilong ol i no tru.","poem":1},{"lineBreak":true},{"text":"God, yu olsem hap plang bilong pait","poem":1},{"text":"i haitim mi.","poem":2},{"text":"Yu tasol yu mekim mi i win.","poem":1},{"lineBreak":true},{"text":"Yu tasol yu pinisim","poem":1},{"text":"bel hevi bilong mi","poem":3},{"text":"na mekim mi i sanap strong.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi save singaut","poem":1},{"text":"long God i helpim mi.","poem":2},{"text":"Em i stap long maunten","poem":1},{"text":"bilong em yet","poem":3},{"text":"na em i harim singaut bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi save slip long bet na mi slip i dai.","poem":1},{"lineBreak":true},{"text":"Na bihain mi save kirap gen","poem":1},{"text":"na mi stap gut, long wanem,","poem":2},{"text":"God i save lukautim mi.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"10,000 birua i banisim mi","poem":1},{"text":"long olgeta hap,","poem":3},{"text":"tasol mi no ken pret long ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, yu kam.","poem":1},{"lineBreak":true},{"text":"Yu God bilong mi,","poem":1},{"text":"yu kam helpim mi.","poem":2},{"text":"Yu save paitim nabaut","poem":1},{"text":"ol birua bilong mi.","poem":2},{"text":"Yu save brukim tit","poem":1},{"text":"bilong ol man nogut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu wanpela tasol","poem":1},{"text":"yu save kisim bek mipela","poem":2},{"lineBreak":true},{"text":"na mipela i no save bagarap.","poem":2},{"text":"Yu ken mekim gut","poem":1},{"text":"long ol manmeri bilong yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}