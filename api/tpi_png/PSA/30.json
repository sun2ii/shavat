{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":30,"content":[{"type":"heading","content":["Wanpela man i prea bilong tenkyu long God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Ol i singim taim ol i makim haus bilong God em i bilong God stret."]},{"type":"verse","number":1,"content":[{"text":"Bikpela,","poem":1},{"text":"yu kisim bek mi pinis,","poem":2},{"lineBreak":true},{"text":"na yu no larim ol birua","poem":2},{"text":"i daunim mi na amamas.","poem":3},{"text":"Olsem na mi litimapim","poem":1},{"text":"nem bilong yu moa yet.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bikpela, yu God bilong mi,","poem":1},{"text":"na mi bin beten","poem":2},{"text":"long yu helpim mi,","poem":3},{"text":"na yu mekim mi i orait pinis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bikpela, mi dai pinis","poem":1},{"text":"na yu kirapim mi bek gen.","poem":2},{"text":"Mi go daun pinis","poem":1},{"text":"long ples bilong ol man i dai pinis.","poem":2},{"text":"Tasol yu givim laip long mi gen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yupela manmeri bilong God,","poem":1},{"text":"yupela i mas singim song","poem":2},{"text":"bilong litimapim nem bilong em.","poem":3},{"text":"Tingim olgeta samting God i mekim","poem":1},{"text":"na tenkyu long em.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Em i save kros","poem":1},{"text":"long sotpela taim tasol.","poem":2},{"text":"Na em i tingting gutpela long yumi","poem":1},{"text":"na i mekim gut long yumi","poem":2},{"text":"olgeta taim yumi stap long graun.","poem":3},{"text":"Aiwara i ken kam daun long nait,","poem":1},{"text":"tasol long moningtaim","poem":2},{"text":"bai yu amamas gen.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bipo mi stap gut tru","poem":1},{"text":"na mi tok olsem,","poem":3},{"text":"“I no gat wanpela samting","poem":2},{"text":"inap long sakim mi liklik.”","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Bikpela, yu gutpela tumas long mi,","poem":1},{"text":"na mekim mi i sanap strong","poem":2},{"text":"olsem strongpela haus","poem":3},{"text":"i sanap long maunten.","poem":4},{"text":"Tasol taim yu hait long mi,","poem":1},{"text":"pret i save daunim mi tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Olsem na, Bikpela,","poem":1},{"text":"mi singaut long yu.","poem":2},{"text":"Mi beten strong long yu helpim mi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sapos mi dai pinis,","poem":1},{"text":"wanem gutpela samting","poem":2},{"text":"bai i kamap?","poem":3},{"text":"Sapos mi go long matmat,","poem":1},{"text":"dispela bai i helpim husat?","poem":2},{"text":"Ol man i dai pinis,","poem":1},{"text":"ol inap litimapim nem bilong yu?","poem":2},{"text":"Ating ol inap tokaut olsem","poem":1},{"text":"oltaim yu save mekim gut","poem":2},{"text":"long ol, a? Nogat.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"God, yu mas harim mi","poem":1},{"text":"na marimari long mi.","poem":2},{"text":"Bikpela, yu mas helpim mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yu rausim pinis bel hevi bilong mi","poem":1},{"text":"na yu mekim mi","poem":2},{"text":"i singsing amamas.","poem":3},{"text":"Pastaim mi olsem man","poem":1},{"text":"i krai sori long man i dai.","poem":2},{"text":"Tasol yu senisim krai bilong mi,","poem":1},{"text":"na mekim bel bilong mi","poem":2},{"text":"i amamas tru.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Olsem na mi no ken pasim","poem":1},{"text":"maus bilong mi.","poem":2},{"text":"Bai mi singim song","poem":1},{"text":"bilong litimapim nem bilong yu.","poem":2},{"text":"Bikpela, yu God bilong mi,","poem":1},{"text":"bai mi tenkyu long yu oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}