{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":31,"content":[{"type":"heading","content":["Bikpela i save lukautim gut tru ol man i stap aninit long em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, mi kam long yu","poem":1},{"text":"bai yu lukautim mi.","poem":2},{"text":"Yu mas helpim mi.","poem":1},{"lineBreak":true},{"text":"Yu no ken larim ol birua","poem":1},{"text":"i daunim mi.","poem":2},{"text":"Yu stretpela olgeta.","poem":1},{"text":"Kisim bek mi","poem":2},{"text":"na bai mi no inap bagarap.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu mas harim prea bilong mi,","poem":1},{"text":"na kisim bek mi kwiktaim.","poem":2},{"text":"Yu stap olsem bikpela maunten ston","poem":1},{"text":"mi ken hait long en.","poem":2},{"text":"Na yu mas banisim mi gut,","poem":1},{"text":"bai mi stap gut","poem":2},{"lineBreak":true},{"text":"na ol birua i no inap daunim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tru tumas, yu olsem","poem":1},{"text":"ples hait bilong mi","poem":3},{"text":"na yu lukautim mi.","poem":2},{"text":"Yu go pas long mi","poem":1},{"text":"na bringim mi i go","poem":2},{"text":"long gutpela rot,","poem":3},{"text":"olsem yu bin tok bipo","poem":2},{"text":"long mekim.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol birua i bin putim umben","poem":1},{"text":"bilong holimpas mi.","poem":2},{"text":"Yu mas lukautim mi","poem":1},{"text":"bai mi no kisim bagarap long en.","poem":2},{"text":"Long wanem, yu tasol","poem":1},{"text":"yu ples hait bilong mi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi putim spirit bilong mi","poem":1},{"text":"long han bilong yu.","poem":2},{"text":"Bikpela, yu God","poem":1},{"text":"bilong mekim pasin tru tasol,","poem":3},{"text":"yu kisim bek mi pinis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yu no save laikim tru","poem":1},{"text":"ol man i save lotu","poem":2},{"text":"long ol giaman god.","poem":3},{"text":"Tasol mi bilip long yu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yu sori long mi oltaim,","poem":1},{"text":"olsem na mi amamas long yu.","poem":2},{"text":"Yu lukim dispela hevi bilong mi,","poem":1},{"text":"na yu save long olgeta trabel","poem":2},{"text":"i kamap long mi.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Yu no bin larim ol birua","poem":1},{"text":"i kalabusim mi.","poem":2},{"text":"Yu bin helpim mi na mi stap gut.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bikpela, yu mas marimari long mi.","poem":1},{"lineBreak":true},{"text":"Mi gat bikpela hevi.","poem":1},{"lineBreak":true},{"text":"Mi krai planti","poem":1},{"text":"na ai bilong mi i solap pinis.","poem":2},{"text":"Ol bun bilong mi i slek olgeta.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bel hevi bilong mi yet","poem":1},{"text":"i sotim laip bilong mi.","poem":2},{"text":"Mi krai tumas,","poem":1},{"text":"olsem na mi no inap","poem":2},{"text":"i stap longpela taim.","poem":3},{"text":"Mi gat bikpela hevi moa,","poem":1},{"text":"olsem na strong bilong mi i pinis,","poem":2},{"lineBreak":true},{"text":"na olgeta bun bilong mi","poem":2},{"text":"i wok long bagarap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ol birua i save tok bilas long mi.","poem":1},{"lineBreak":true},{"text":"Ol wantok i tok nogut long mi,","poem":1},{"text":"na ol pren bilong mi","poem":2},{"text":"i pret nogut long mi.","poem":3},{"text":"Mi wokabaut long rot,","poem":1},{"text":"na ol man i lukim mi ol i ranawe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Olgeta man i lusim tingting long mi","poem":1},{"text":"olsem ol i save lusim tingting","poem":2},{"text":"long man i dai pinis.","poem":3},{"text":"Mi olsem sospen graun i bruk","poem":1},{"text":"na ol i tromoi pinis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mi harim planti birua","poem":1},{"text":"i tok baksait long mi.","poem":2},{"text":"Ol i laik pretim mi moa yet.","poem":1},{"lineBreak":true},{"text":"Na ol i bung wantaim na pasim tok","poem":1},{"text":"bilong mekim nogut long mi.","poem":2},{"text":"Ol i tok long kilim mi i dai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tasol maski.","poem":1},{"lineBreak":true},{"text":"Bikpela, mi save bilip long yu.","poem":1},{"lineBreak":true},{"text":"Mi tok olsem, yu God bilong mi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Oltaim mi save stap","poem":1},{"text":"long han bilong yu.","poem":2},{"text":"Yu mas kisim bek mi","poem":1},{"text":"long han bilong ol birua","poem":2},{"lineBreak":true},{"text":"na bilong ol man i ranim mi.","poem":2},{"text":"Nogut ol i bagarapim mi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mi wokman bilong yu,","poem":1},{"text":"na yu ken marimari long mi.","poem":2},{"text":"Yu save laikim mi tumas,","poem":1},{"text":"olsem na yu kisim bek mi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bikpela, mi singaut long yu","poem":1},{"text":"bai yu helpim mi.","poem":2},{"text":"Yu no ken larim ol birua i winim mi.","poem":1},{"lineBreak":true},{"text":"Tasol ol man nogut i ken bagarap.","poem":1},{"lineBreak":true},{"text":"Ol i ken i dai na go","poem":1},{"text":"long ples bilong ol man i dai pinis,","poem":3},{"text":"na maus bilong ol i ken pas.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ol dispela man i save bikhet","poem":1},{"text":"na tok bilas,","poem":2},{"lineBreak":true},{"text":"na tok nogut","poem":2},{"text":"long ol stretpela man.","poem":3},{"text":"Ol i tok giaman tasol.","poem":1},{"lineBreak":true},{"text":"Yu mas bagarapim ol","poem":1},{"text":"na maus bilong ol bai i pas tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yu save mekim gutpela wok tru","poem":1},{"text":"bilong helpim ol man","poem":2},{"text":"i stap aninit long yu.","poem":3},{"text":"Yu save lukautim gut","poem":1},{"text":"ol man i bilip long yu.","poem":2},{"text":"Yu save helpim ol moa yet","poem":1},{"text":"long ai bilong olgeta manmeri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yu save haitim ol dispela man","poem":1},{"text":"klostu long yu,","poem":3},{"text":"na ol man i pasim tok","poem":2},{"text":"bilong kilim ol,","poem":3},{"text":"ol i no inap.","poem":2},{"text":"Yu save haitim gut ol dispela man","poem":1},{"text":"i stap aninit long yu,","poem":3},{"text":"na tok nogut bilong ol birua","poem":2},{"text":"i no inap daunim ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Litimapim nem bilong Bikpela.","poem":1},{"lineBreak":true},{"text":"Em i givim bel bilong em moa yet","poem":1},{"text":"long mi.","poem":3},{"text":"Taim ol birua i raunim mi","poem":1},{"text":"na i laik bagarapim mi,","poem":3},{"text":"em i helpim mi","poem":2},{"text":"long strong bilong en","poem":3},{"text":"na mi stap gut.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bikpela, bipo mi pret tru","poem":1},{"text":"na mi ting yu rausim mi pinis","poem":2},{"lineBreak":true},{"text":"na mi no moa i stap","poem":2},{"text":"klostu long yu.","poem":3},{"text":"Tasol yu harim krai bilong mi","poem":1},{"text":"na yu helpim mi","poem":2},{"text":"taim mi singaut long yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ol manmeri bilong God,","poem":1},{"text":"yupela i mas laikim em tru.","poem":2},{"text":"Em i save lukautim gut","poem":1},{"text":"ol manmeri i bihainim em.","poem":2},{"text":"Tasol em i save bekim pe nogut","poem":1},{"text":"long ol manmeri i save bikhet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yupela olgeta manmeri","poem":1},{"text":"i bilip long Bikpela,","poem":3},{"text":"yupela sanap strong,","poem":2},{"lineBreak":true},{"text":"na bel bilong yupela","poem":2},{"text":"i ken kisim strong oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}