{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":32,"content":[{"type":"heading","content":["Man i autim sin long God na God i lusim sin bilong em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Maskil."]},{"type":"verse","number":1,"content":[{"text":"Sapos God i lusim pinis","poem":1},{"text":"rong bilong wanpela man,","poem":3},{"text":"na i rausim sin bilong em,","poem":2},{"text":"dispela man i ken amamas.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Sapos Bikpela i tok olsem,","poem":1},{"text":"dispela man i no gat rong nau,","poem":2},{"lineBreak":true},{"text":"na dispela man i no save bihainim","poem":2},{"text":"pasin giaman,","poem":3},{"text":"orait dispela man i ken amamas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God, taim mi no autim sin","poem":1},{"text":"bilong mi yet,","poem":3},{"text":"mi krai nogut","poem":2},{"text":"long san na long nait.","poem":3},{"text":"Olsem na bodi bilong mi","poem":1},{"text":"i slek olgeta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Long san na long nait","poem":1},{"text":"han bilong yu","poem":2},{"text":"i mekim save long mi.","poem":3},{"text":"Strong bilong mi i lus olgeta,","poem":1},{"text":"olsem bikpela san i boinim graun","poem":2},{"lineBreak":true},{"text":"na graun i drai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bihain mi bin autim sin bilong mi","poem":1},{"text":"long yu.","poem":3},{"text":"Mi no haitim pasin nogut bilong mi.","poem":1},{"lineBreak":true},{"text":"Mi ting olsem,","poem":1},{"text":"mi laik autim olgeta sin bilong mi","poem":2},{"text":"long Bikpela.","poem":3},{"text":"Mi autim pinis","poem":1},{"text":"na yu lusim asua bilong mi","poem":2},{"lineBreak":true},{"text":"na sin bilong mi tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Olsem na olgeta manmeri","poem":1},{"text":"i save bihainim yu,","poem":3},{"text":"ol i mas beten long yu","poem":2},{"text":"taim hevi i kamap.","poem":3},{"text":"Na sapos hevi","poem":1},{"text":"i kamap bikpela tumas,","poem":3},{"text":"olsem wara i tait bikpela","poem":2},{"text":"na i kisim man,","poem":3},{"text":"bai hevi i no inap daunim ol.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu tasol yu ples hait bilong mi.","poem":1},{"lineBreak":true},{"text":"Yu save lukautim mi","poem":1},{"text":"na hevi i no ken daunim mi.","poem":2},{"text":"Yu save kisim bek mi long hevi,","poem":1},{"text":"na dispela i mekim mi","poem":2},{"text":"i singsing bikpela moa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela i tok olsem,","poem":1},{"text":"“Mi laik skulim yu gut,","poem":2},{"text":"na soim yu long rot","poem":3},{"text":"yu mas wokabaut long en.","poem":4},{"text":"Bai mi skulim yu na lainim yu.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yu no ken kamap olsem hos","poem":2},{"text":"na donki.","poem":3},{"text":"Tupela i no gat save.","poem":2},{"lineBreak":true},{"text":"Yu mas putim ain","poem":2},{"text":"i gat longpela baklain","poem":3},{"text":"long maus bilong tupela,","poem":4},{"text":"na pulim baklain","poem":2},{"text":"bilong stiaim tupela.","poem":3},{"text":"Sapos yu no mekim olsem,","poem":2},{"text":"bai tupela i no inap","poem":3},{"text":"bihainim laik bilong yu.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Planti hevi i mas kamap","poem":1},{"text":"long ol man nogut.","poem":2},{"text":"Tasol Bikpela i save marimari","poem":1},{"text":"long ol manmeri","poem":2},{"text":"i bilip tru long em,","poem":3},{"text":"na lukautim ol gut.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yupela stretpela manmeri,","poem":1},{"text":"yupela i mas belgut na amamas","poem":2},{"text":"long olgeta gutpela samting","poem":3},{"text":"Bikpela i mekim.","poem":4},{"text":"Yupela olgeta lain manmeri","poem":1},{"text":"i stretpela long ai bilong God,","poem":3},{"text":"yupela i mas amamas na singaut.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}