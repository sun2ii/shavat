{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":34,"content":[{"type":"heading","content":["God i mekim gut long Devit, na em i litimapim nem bilong God"]},{"type":"hebrew_subtitle","content":["Devit i stap wantaim Abimelek, na em i giaman olsem em i longlong man na Abimelek i rausim em. Taim Devit i go pinis, em i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bai mi tenkyu long God.","poem":1},{"lineBreak":true},{"text":"Oltaim bai mi","poem":1},{"text":"litimapim nem bilong en.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi ting long God i bin helpim mi","poem":1},{"text":"na mi amamas long em.","poem":2},{"text":"Ol manmeri i karim hevi","poem":1},{"text":"ol i ken harim dispela tok","poem":2},{"text":"na ol i ken belgut tru.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Yumi tokaut long biknem","poem":1},{"text":"bilong God.","poem":2},{"text":"Yumi litimapim nem bilong em.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi bin beten long Bikpela","poem":1},{"text":"bai em i helpim mi,","poem":3},{"text":"na em i harim prea bilong mi.","poem":2},{"text":"Em i rausim olgeta pret","poem":1},{"text":"long bel bilong mi,","poem":3},{"text":"na nau mi stap bel isi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olgeta manmeri i gat hevi,","poem":1},{"text":"tasol ol i bilip long Bikpela,","poem":3},{"text":"ol i save amamas.","poem":2},{"text":"Olsem na bilip bilong ol","poem":1},{"text":"i no bagarap.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol rabisman i prea long Bikpela","poem":1},{"text":"na em i harim prea bilong ol,","poem":2},{"lineBreak":true},{"text":"na i helpim ol","poem":2},{"text":"long olgeta hevi bilong ol.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ensel bilong Bikpela i save stap","poem":1},{"text":"klostu long ol manmeri","poem":2},{"text":"i aninit long Bikpela,","poem":3},{"text":"na em i save helpim ol","poem":2},{"text":"bai ol i no kisim bagarap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela i save mekim gutpela pasin","poem":1},{"text":"long yumi.","poem":3},{"text":"Yupela yet i mas traim na lukim","poem":1},{"text":"na bai yupela i save olsem","poem":2},{"text":"Bikpela i gutpela tru.","poem":3},{"text":"Man i save bilip tru long Bikpela,","poem":1},{"text":"em i ken i stap belgut tru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ol manmeri bilong Bikpela,","poem":1},{"text":"yupela i mas i stap aninit long em.","poem":2},{"text":"Ol man i aninit long em","poem":1},{"text":"ol i no sot long wanpela samting.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ol yangpela laion","poem":1},{"text":"i save sot long abus","poem":2},{"text":"na ol i hangre.","poem":3},{"text":"Tasol ol manmeri i bihainim Bikpela","poem":1},{"text":"ol i no save sot","poem":2},{"text":"long ol gutpela samting.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ol pikinini, yupela i mas i kam","poem":1},{"text":"na putim yau gut","poem":2},{"text":"long tok bilong mi.","poem":3},{"text":"Mi laik skulim yupela","poem":1},{"text":"na bai yupela i stap","poem":2},{"text":"aninit long God oltaim.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu laik bai laip bilong yu","poem":1},{"text":"i kamap gutpela?","poem":2},{"text":"Na yu laik","poem":1},{"text":"bai yu stap laip longtaim tru,","poem":3},{"text":"na yu stap gut na amamas?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sapos yu laik i stap olsem,","poem":1},{"text":"orait yu no ken mekim tok nogut,","poem":2},{"lineBreak":true},{"text":"na yu no ken tok giaman.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yu mas givim baksait","poem":1},{"text":"long pasin nogut,","poem":3},{"text":"na bihainim gutpela pasin tasol.","poem":2},{"text":"Yu mas wok long kamap wanbel","poem":1},{"text":"wantaim ol arapela manmeri","poem":3},{"text":"na yu mas strong","poem":2},{"text":"long bihainim dispela pasin.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bikpela i save lukautim","poem":1},{"text":"ol stretpela manmeri,","poem":3},{"text":"na em i save harim","poem":2},{"text":"beten bilong ol.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Tasol Bikpela i no save laikim","poem":1},{"text":"ol manmeri nogut.","poem":2},{"text":"Na bai em i kilim ol i dai","poem":1},{"text":"na ol manmeri i no tingim ol gen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ol stretpela manmeri","poem":1},{"text":"i save beten long Bikpela","poem":3},{"text":"na em i save harim ol.","poem":2},{"text":"Em i save helpim ol","poem":1},{"text":"na hevi i no daunim ol.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"God i save stap klostu","poem":1},{"text":"long ol manmeri i gat hevi.","poem":2},{"text":"Na em i save helpim ol manmeri","poem":1},{"text":"bilip bilong ol i bagarap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Planti hevi i save kamap","poem":1},{"text":"long stretpela man,","poem":3},{"text":"tasol Bikpela i save helpim em","poem":2},{"lineBreak":true},{"text":"na ol dispela hevi i no daunim em.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bikpela i save lukautim em olgeta,","poem":1},{"text":"na i no gat wanpela bun bilong en","poem":2},{"text":"i bruk.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Ol kain kain samting nogut","poem":1},{"text":"bai i kilim i dai","poem":2},{"text":"ol man nogut.","poem":3},{"text":"Na Bikpela bai i mekim save","poem":1},{"text":"long ol man i save birua","poem":2},{"text":"long ol stretpela man.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"God i save kisim bek","poem":1},{"text":"ol wokman bilong en","poem":3},{"text":"na ol i stap laip.","poem":2},{"text":"Na olgeta manmeri i bilip long em","poem":1},{"text":"i lukautim ol,","poem":3},{"text":"bai ol i no inap lus. Nogat tru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}