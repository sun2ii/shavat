.","poem":2},{"text":"Tasol ol pikinini bilong ol man nogut","poem":1},{"text":"bai i bagarap tru.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ol stretpela man bai i kisim graun","poem":1},{"text":"God i givim ol,","poem":3},{"text":"na bai ol i stap oltaim long en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Stretpela man i gat gutpela save","poem":1},{"text":"na i autim gutpela tok tasol.","poem":2},{"text":"Em i save toktok","poem":1},{"text":"long stretpela pasin.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Lo bilong God","poem":1},{"text":"i stap long bel bilong en,","poem":3},{"text":"na em i save bihainim God,","poem":2},{"lineBreak":true},{"text":"na i no save lusim dispela lo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Man nogut i save hait","poem":1},{"text":"na was long stretpela man,","poem":3},{"text":"na i laik painim rot","poem":2},{"text":"bilong kilim em i dai.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Tasol Bikpela i no inap lusim","poem":1},{"text":"stretpela man","poem":3},{"text":"na larim man nogut","poem":2},{"text":"i kilim em i dai.","poem":3},{"text":"Nogat tru.","poem":1},{"lineBreak":true},{"text":"Na sapos man nogut","poem":1},{"text":"i kotim stretpela man,","poem":3},{"text":"Bikpela i no inap larim em","poem":2},{"text":"i winim stretpela man long kot.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Yu mas bilip long Bikpela","poem":1},{"text":"na prea long em","poem":2},{"lineBreak":true},{"text":"na bihainim pasin bilong em.","poem":2},{"text":"Sapos yu mekim olsem,","poem":1},{"text":"bai em i givim biknem long yu,","poem":2},{"lineBreak":true},{"text":"na yu ken holim dispela graun","poem":2},{"text":"em i givim yu.","poem":3},{"text":"Na bai yu lukim em","poem":1},{"text":"i bagarapim ol man nogut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Mi bin lukim man nogut","poem":1},{"text":"i gat bikpela strong,","poem":3},{"text":"na em i winim ol manmeri,","poem":2},{"text":"olsem traipela diwai sida","poem":3},{"text":"bilong Lebanon","poem":4},{"text":"i winim ol arapela diwai.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Tasol bihain mi wokabaut gen","poem":1},{"text":"long dispela hap,","poem":3},{"text":"na em i no moa i stap.","poem":2},{"text":"Mi wok long painim em,","poem":1},{"text":"tasol mi no lukim em. Nogat tru.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yu tingting long man i no gat asua","poem":1},{"text":"long wanpela samting,","poem":3},{"text":"na lukim pasin","poem":2},{"text":"bilong stretpela man.","poem":3},{"text":"Man i save sindaun isi","poem":1},{"text":"wantaim ol arapela manmeri,","poem":3},{"text":"lain bilong en bai i stap oltaim.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Tasol Bikpela i save bagarapim tru","poem":1},{"text":"ol man bilong mekim sin.","poem":2},{"text":"Ol lain tumbuna pikinini bilong ol","poem":1},{"text":"bai i lus olgeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Bikpela yet i save kisim bek","poem":1},{"text":"ol stretpela man.","poem":2},{"text":"Long taim hevi i kamap long ol,","poem":1},{"text":"ol i save ran i go long em","poem":2},{"text":"na em i lukautim ol.","poem":3}]},{"type":"verse","number":40,"content":[{"text":"Ol i save bilip long em,","poem":1},{"text":"olsem na em i save helpim ol.","poem":2},{"text":"Em i save kisim bek ol","poem":1},{"text":"long han bilong ol man nogut,","poem":3},{"text":"na ol i stap gut.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}