{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":38,"content":[{"type":"heading","content":["Beten bilong man i gat hevi"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, bilong mekim God i tingim ol hevi bilong en."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu gat kros,","poem":1},{"text":"tasol yu no ken krosim mi.","poem":2},{"text":"Yu belhat,","poem":1},{"text":"tasol yu no ken mekim save","poem":2},{"text":"long mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu sutim mi tru","poem":1},{"text":"long ol spia bilong yu,","poem":3},{"text":"na yu daunim mi","poem":2},{"text":"long han bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yu kros long mi,","poem":1},{"text":"olsem na mi sik nogut.","poem":2},{"text":"Mi gat sin,","poem":1},{"text":"olsem na bodi bilong mi","poem":2},{"text":"i no gat strong moa.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol rong bilong mi","poem":1},{"text":"i karamapim mi pinis,","poem":3},{"text":"na ol dispela rong i olsem kago","poem":2},{"text":"mi karim na i hevi tumas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ol sua long bodi bilong mi","poem":1},{"text":"i gat planti susu","poem":2},{"lineBreak":true},{"text":"na i sting tru.","poem":2},{"text":"Mi mekim pasin i kranki tru,","poem":1},{"text":"olsem na dispela i kamap long mi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bel bilong mi i gat bikpela hevi tru,","poem":1},{"text":"na mi bagarap.","poem":2},{"text":"Long olgeta de mi sori na krai tasol.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bodi bilong mi i hat moa","poem":1},{"text":"olsem paia i kukim,","poem":3},{"text":"na mi gat bikpela sik tru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mi bagarap tru na mi stap nogut,","poem":1},{"text":"olsem wanpela samting","poem":2},{"text":"i krungutim mi strong.","poem":3},{"text":"Bel bilong mi i pilim nogut tru,","poem":1},{"text":"na mi singaut long bikpela pen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bikpela, yu save long strongpela laik","poem":1},{"text":"bilong mi.","poem":3},{"text":"Bel bilong mi i krai nogut,","poem":1},{"text":"na dispela i no hait long yu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Klok bilong mi i wok strong tumas,","poem":1},{"text":"na strong bilong mi i pinis olgeta.","poem":2},{"text":"Ai bilong mi i tudak","poem":1},{"text":"na mi no moa lukluk gut.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ol pren na wantok bilong mi","poem":1},{"text":"ol i no laik i kam klostu long mi.","poem":2},{"text":"Ol i no laik lukim ol sua bilong mi.","poem":1},{"lineBreak":true},{"text":"Na ol famili bilong mi tu","poem":1},{"text":"i stap longwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ol man i laik kilim mi i dai,","poem":1},{"text":"ol i redim umben","poem":2},{"text":"bilong holimpas mi.","poem":3},{"text":"Ol man i laik bagarapim mi,","poem":1},{"text":"ol i save tok","poem":2},{"text":"long mekim nogut long mi.","poem":3},{"text":"Na oltaim ol i tingting","poem":1},{"text":"long mekim pasin nogut long mi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tasol mi olsem man i yaupas,","poem":1},{"text":"na mi no harim ol.","poem":2},{"text":"Mi olsem mauspas,","poem":1},{"text":"na mi no opim maus.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mi olsem wanpela man","poem":1},{"text":"i no inap harim toktok,","poem":3},{"text":"olsem na mi no bekim tok long ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tasol Bikpela, mi bilip long yu.","poem":1},{"lineBreak":true},{"text":"Bikpela, yu God bilong mi,","poem":1},{"text":"bai yu yet yu bekim tok long mi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mi beten olsem, yu no ken larim","poem":1},{"text":"ol birua i winim mi na amamas","poem":2},{"text":"long dispela pasin ol i mekim.","poem":3},{"text":"Taim mi pundaun liklik","poem":1},{"text":"yu no ken larim ol","poem":2},{"text":"i hambak na amamas.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Long wanem, klostu nau","poem":1},{"text":"mi laik pundaun,","poem":3},{"text":"na mi gat pen oltaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mi autim rong bilong mi long yu,","poem":1},{"text":"na mi sori long sin mi bin mekim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Olgeta birua bilong mi","poem":1},{"text":"i strong tumas.","poem":2},{"text":"Planti man moa","poem":1},{"text":"i birua nating long mi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mi mekim gutpela pasin long ol,","poem":1},{"text":"tasol ol i bekim pasin nogut","poem":2},{"text":"long mi.","poem":3},{"text":"Mi bihainim gutpela pasin,","poem":1},{"text":"na ol i tingting long dispela","poem":2},{"lineBreak":true},{"text":"na ol i kamap birua bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bikpela, yu no ken lusim mi.","poem":1},{"lineBreak":true},{"text":"God bilong mi,","poem":1},{"text":"yu no ken i stap longwe long mi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bikpela, yu man bilong helpim mi,","poem":1},{"text":"yu mas helpim mi kwiktaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}