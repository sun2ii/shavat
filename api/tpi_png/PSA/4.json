{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":4,"content":[{"type":"heading","content":["Long nait wanpela man i prea bilong kisim strong"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"God, yu save mekim mi i win.","poem":1},{"lineBreak":true},{"text":"Taim mi singaut long yu,","poem":1},{"text":"yu ken harim singaut bilong mi.","poem":2},{"text":"Bipo mi bel hevi nogut tru,","poem":1},{"text":"na yu bin pinisim","poem":2},{"text":"bel hevi bilong mi.","poem":3},{"text":"Yu ken marimari long mi nau","poem":1},{"text":"na harim prea bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yupela ol man, hamas taim","poem":1},{"text":"bai yupela i wok long daunim","poem":2},{"text":"biknem bilong mi?","poem":3},{"text":"Hamas taim bai yupela","poem":1},{"text":"i laikim tumas","poem":2},{"text":"ol kain kain rabis samting?","poem":3},{"text":"Hamas taim bai yupela i bihainim","poem":1},{"text":"ol pasin bilong giaman?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yupela i mas save gut","poem":1},{"text":"long dispela tok.","poem":2},{"text":"Ol man i save aninit tru","poem":1},{"text":"long Bikpela,","poem":3},{"text":"em i makim ol bilong em yet.","poem":2},{"text":"Na olgeta taim mi singaut long em,","poem":1},{"text":"em i save harim singaut bilong mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yupela i mas pret long God","poem":1},{"text":"na lusim pasin bilong mekim sin.","poem":2},{"text":"Taim yupela i slip long bet,","poem":1},{"text":"yupela i mas tingting gut","poem":2},{"text":"long dispela tok,","poem":3},{"text":"na pasim maus.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yupela i mas mekim olkain ofa","poem":1},{"text":"Bikpela i save laikim.","poem":2},{"text":"Na yupela i mas bilip tru long em.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Planti man i save tok olsem,","poem":1},{"text":"“Mipela i laik kisim","poem":2},{"text":"ol gutpela samting","poem":3},{"text":"bai mipela i ken amamas.”","poem":2},{"text":"Bikpela, yu ken marimari","poem":1},{"text":"long mipela","poem":3},{"text":"na helpim mipela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taim wit na wain","poem":1},{"text":"i kamap planti long gaden,","poem":3},{"text":"ol man i save amamas.","poem":2},{"text":"Tasol amamas yu bin putim","poem":1},{"text":"long bel bilong mi,","poem":3},{"text":"em i winim tru amamas bilong ol.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu tasol","poem":1},{"text":"yu save lukautim mi","poem":2},{"lineBreak":true},{"text":"na mi stap gut.","poem":2},{"text":"Mi no save pret","poem":1},{"text":"long wanpela samting.","poem":2},{"text":"Taim mi go long bet,","poem":1},{"text":"wantu mi save slip i dai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}