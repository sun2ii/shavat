{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":44,"content":[{"type":"heading","content":["Ol birua i mekim nogut long ol Israel na ol Israel i askim God long helpim ol"]},{"type":"hebrew_subtitle","content":["Dispela song em kain song ol i kolim Maskil, bilong ol lain Kora. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, ol tumbuna","poem":1},{"text":"bilong mipela","poem":2},{"text":"i bin stori long mipela","poem":3},{"text":"long ol strongpela wok","poem":2},{"text":"yu bin mekim longtaim bipo,","poem":3},{"text":"taim ol i stap yet long graun.","poem":2},{"text":"Na mipela yet","poem":1},{"text":"i harim pinis dispela stori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu yet yu bin rausim ol arapela lain","poem":1},{"text":"long graun bilong ol,","poem":3},{"text":"na yu givim dispela graun","poem":2},{"text":"long ol tumbuna,","poem":3},{"text":"na ol i stap strong long en.","poem":2},{"text":"Yu bin bekim pasin nogut","poem":1},{"text":"bilong ol arapela lain,","poem":3},{"text":"tasol yu mekim ol tumbuna","poem":2},{"text":"i stap gut","poem":3},{"text":"na kamap planti manmeri moa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ol tumbuna i bin pait,","poem":1},{"text":"tasol ol i no kisim dispela graun","poem":2},{"text":"long pasin bilong pait.","poem":3},{"text":"Strong bilong ol yet i no helpim ol","poem":1},{"text":"long winim pait. Nogat.","poem":2},{"text":"Yu laikim ol tru,","poem":1},{"text":"olsem na yu stap wantaim ol","poem":2},{"text":"na givim lait long ol.","poem":3},{"text":"Na strong bilong yu yet i winim pait.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yu king na God bilong mi.","poem":1},{"lineBreak":true},{"text":"Yu tok na ol lain bilong Jekop","poem":1},{"text":"i save winim pait.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Long strong bilong yu tasol","poem":1},{"text":"mipela i save rausim ol birua.","poem":2},{"text":"Yu stap wantaim mipela,","poem":1},{"text":"na mipela i save winim ol man","poem":2},{"text":"i pait long mipela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mi gat banara na spia samting,","poem":1},{"text":"tasol mi no bilip","poem":2},{"text":"bai ol dispela samting","poem":3},{"text":"i helpim mi long pait.","poem":4},{"text":"Mi gat bainat, tasol dispela tu","poem":1},{"text":"i no inap helpim mi long pait.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nogat. Yu tasol i bin helpim mipela","poem":1},{"text":"na ol birua i no daunim mipela.","poem":2},{"text":"Ol dispela man i no laikim mipela,","poem":1},{"text":"tasol yu bin pait long ol","poem":2},{"text":"na yu winim ol.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"God, oltaim mipela","poem":1},{"text":"i bin litimapim nem bilong yu.","poem":2},{"text":"Na bai mipela i tok tenkyu long yu","poem":1},{"text":"oltaim oltaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tasol nau olsem wanem?","poem":1},{"lineBreak":true},{"text":"Yu givim baksait pinis long mipela","poem":1},{"text":"na yu rabisim mipela,","poem":2},{"lineBreak":true},{"text":"na yu no moa i go","poem":2},{"text":"wantaim ol ami bilong mipela","poem":3},{"text":"long pait.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Yu mekim olsem","poem":1},{"text":"na mipela i ranawe long ol birua,","poem":2},{"lineBreak":true},{"text":"na ol i kisim pinis","poem":2},{"text":"ol samting bilong mipela.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Yu bin larim mipela","poem":1},{"text":"i kamap olsem ol sipsip","poem":2},{"text":"ol i laik kilim i dai.","poem":3},{"text":"Yu rausim mipela","poem":1},{"text":"long graun bilong mipela,","poem":3},{"text":"na mipela i go i stap nabaut","poem":2},{"text":"namel long ol arapela lain pipel.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu larim ol manmeri bilong yu","poem":1},{"text":"i kamap wokboi nating","poem":2},{"text":"bilong ol arapela lain,","poem":3},{"text":"na ol dispela lain i baim yu","poem":2},{"text":"long liklik pe tru.","poem":3},{"text":"Yu no kisim bikpela mani long ol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yu mekim olsem long mipela,","poem":1},{"text":"na ol lain i stap klostu long mipela","poem":2},{"text":"i save tok bilas long mipela.","poem":3},{"text":"Ol manmeri nabaut i save lap nogut","poem":1},{"text":"na tok sem long mipela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yu kirapim ol lain pipel","poem":1},{"text":"na ol i tok sem","poem":2},{"text":"long nem bilong mipela.","poem":3},{"text":"Ol i lap nogut tru","poem":1},{"text":"long samting i kamap long mipela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ol man i tok bilas","poem":1},{"text":"na tok nogut long mi,","poem":3},{"text":"na mi lukim ol birua","poem":2},{"lineBreak":true},{"text":"na ol man i bekim","poem":2},{"text":"pasin nogut long mi.","poem":3},{"text":"Olsem na mi pilim nogut oltaim","poem":1},{"text":"na mi sem tumas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"God, mipela i no lusim tingting","poem":1},{"text":"long yu","poem":3},{"text":"na mipela i no sakim tok","poem":2},{"text":"bilong kontrak bilong yu.","poem":3},{"text":"Tasol ol dispela samting","poem":1},{"text":"i bin kamap long mipela.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mipela i no givim baksait long yu","poem":1},{"text":"na mipela i no lusim rot bilong yu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tasol yu bagarapim mipela","poem":1},{"text":"long ples bilong ol wel abus.","poem":2},{"text":"Na yu karamapim mipela","poem":1},{"text":"long tudak nogut tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"God bilong mipela,","poem":1},{"text":"sapos mipela i lusim tingting pinis","poem":2},{"text":"long yu,","poem":3},{"text":"na mipela i prea","poem":2},{"text":"long ol giaman god,","poem":3},{"text":"yu bai save.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yu save long olgeta tingting","poem":1},{"text":"i hait i stap","poem":2},{"text":"long bel bilong mipela man.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Mipela i stap manmeri bilong yu,","poem":1},{"text":"olsem na long olgeta taim","poem":2},{"text":"ol i save kilim mipela i dai.","poem":3},{"text":"Ol i lukim mipela i olsem sipsip","poem":1},{"text":"bilong kilim i dai tasol.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bikpela, yu kirap.","poem":1},{"lineBreak":true},{"text":"Bilong wanem yu slip?","poem":1},{"lineBreak":true},{"text":"Yu kirap.","poem":1},{"lineBreak":true},{"text":"Yu no ken givim baksait oltaim","poem":1},{"text":"long mipela.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bilong wanem yu hait long mipela?","poem":1},{"lineBreak":true},{"text":"Ol man i mekim nogut long mipela","poem":1},{"text":"na mipela i karim","poem":2},{"text":"bikpela hevi moa.","poem":3},{"text":"Yu no ken lusim tingting","poem":1},{"text":"long hevi bilong mipela.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mipela i pundaun long graun,","poem":1},{"text":"na bodi bilong mipela i slip","poem":2},{"text":"olsem ol man i dai pinis.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"God, yu kirap","poem":1},{"text":"na yu kam helpim mipela.","poem":2},{"text":"Tingting long sori bilong yu,","poem":1},{"text":"na kisim bek mipela","poem":2},{"lineBreak":true},{"text":"bai mipela i no ken i dai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":25}