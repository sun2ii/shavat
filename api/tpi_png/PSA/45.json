{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":45,"content":[{"type":"heading","content":["Song bilong taim king i marit"]},{"type":"hebrew_subtitle","content":["Dispela song em kain song ol i kolim Maskil, bilong ol lain Kora. Em i song bilong man i laikim meri. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim “Naispela plaua.”"]},{"type":"verse","number":1,"content":[{"text":"Planti gutpela tok i stap","poem":1},{"text":"long tingting bilong mi.","poem":2},{"text":"Mi laik raitim dispela song","poem":1},{"text":"na givim long king.","poem":2},{"text":"Maus bilong mi i olsem ingpen","poem":1},{"text":"bilong gutpela kuskus.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"King, yu naispela man tru.","poem":1},{"text":"I no gat narapela man i olsem yu.","poem":2},{"lineBreak":true},{"text":"Tok bilong yu i gutpela tasol.","poem":2},{"text":"Olsem na oltaim","poem":1},{"text":"God i ken mekim gut long yu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu strongpela king.","poem":1},{"lineBreak":true},{"text":"Yu gat planti bilas,","poem":1},{"text":"na biknem bilong yu","poem":2},{"text":"i antap tumas.","poem":3},{"text":"Yu mas pasim bainat","poem":1},{"text":"na redi long pait.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yu nambawan king i gat biknem.","poem":1},{"lineBreak":true},{"text":"Yu sindaun long hos","poem":1},{"text":"na yu go long pait na winim pait.","poem":2},{"text":"Yu laik pait bai ol man","poem":1},{"text":"i no inap daunim tok tru.","poem":2},{"text":"Na yu pait bilong helpim ol man","poem":1},{"text":"bai ol i ken wokabaut stret.","poem":2},{"text":"Bai pait bilong yu","poem":1},{"text":"i kamap strong moa,","poem":3},{"text":"na i mekim ol man nogut","poem":2},{"text":"i pret tru long yu.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol spia bilong yu i sap tumas","poem":1},{"text":"na i sutim tru ol birua.","poem":2},{"text":"Yu daunim ol arapela lain long pait,","poem":1},{"text":"na ol i stap aninit long yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God, yu stap king oltaim oltaim.","poem":1},{"lineBreak":true},{"text":"Yu save bosim ol manmeri bilong yu","poem":1},{"text":"long stretpela pasin tasol.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu save laikim stretpela pasin","poem":1},{"text":"na yu no laikim tru pasin nogut.","poem":2},{"text":"Olsem na king, God bilong yu yet","poem":1},{"text":"em i bin kapsaitim wel long yu","poem":2},{"text":"bilong makim yu","poem":3},{"text":"olsem man i gat biknem.","poem":4},{"text":"Na dispela i mekim yu","poem":1},{"text":"i amamas moa yet.","poem":2},{"text":"Ol poroman bilong yu","poem":1},{"text":"ol i no inap amamas olsem yu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Longpela klos bilong yu","poem":1},{"text":"i gat gutpela smel moa","poem":2},{"text":"bilong ol kain kain sanda","poem":3},{"text":"olsem mea na kasia.","poem":4},{"text":"Ol i bin bilasim haus bilong king","poem":1},{"text":"long ol kain kain bilas","poem":2},{"text":"ol i wokim long tit bilong elefan,","poem":3},{"text":"na ol i mekim musik","poem":2},{"text":"bilong mekim yu i amamas.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ol pikinini meri bilong ol king","poem":1},{"text":"i stap long haus bilong yu","poem":2},{"text":"wantaim ol meri i gat biknem.","poem":3},{"text":"Kwin i sanap long han sut bilong yu.","poem":1},{"lineBreak":true},{"text":"Em i putim bilas gol ol i bin wokim","poem":1},{"text":"long gol bilong kantri Ofir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yu yangpela meri","poem":1},{"text":"i laik marit long king,","poem":3},{"text":"yu harim tok bilong mi","poem":2},{"text":"na tingting long en.","poem":3},{"text":"Yu mas lusim tingting","poem":1},{"text":"long ol manmeri","poem":2},{"text":"i stap long ples bilong yu,","poem":3},{"text":"na yu mas lusim tingting","poem":2},{"text":"long ol wanblut bilong yu.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Yu mekim olsem","poem":1},{"text":"na bai king i lukim yu","poem":2},{"text":"i naispela meri","poem":3},{"text":"na em bai i laikim yu tru.","poem":2},{"text":"Em i bikman bilong yu,","poem":1},{"text":"olsem na yu mas","poem":2},{"text":"bihainim tok bilong en.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol manmeri bilong taun Tair","poem":1},{"text":"bai ol i bringim presen long yu,","poem":3},{"text":"na ol maniman tu","poem":2},{"text":"bai i givim presen long yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yangpela meri bilong king","poem":1},{"text":"i stap long rum bilong em yet,","poem":3},{"text":"na em i luk nais tru.","poem":2},{"text":"Em i putim klos","poem":1},{"text":"ol i bin wokim na bilasim","poem":2},{"text":"long tret gol.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Dispela klos bilong en","poem":1},{"text":"i gat planti kala.","poem":2},{"text":"Nau ol i bringim dispela meri","poem":1},{"text":"i go long king.","poem":2},{"text":"Na ol yangpela meri","poem":1},{"text":"i poroman bilong em,","poem":3},{"text":"ol i bihainim em i go.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ol i amamas na belgut","poem":1},{"text":"na ol i go insait","poem":2},{"text":"long bikpela haus king.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Na yu, king,","poem":1},{"text":"bai yu gat planti pikinini man,","poem":2},{"lineBreak":true},{"text":"na bai ol i senisim","poem":2},{"text":"ol tumbuna bilong yu.","poem":3},{"text":"Bai yu givim bikpela namba long ol,","poem":1},{"text":"na bai ol i bosim ol manmeri","poem":2},{"text":"long olgeta hap bilong graun.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Bai mi tokaut long biknem bilong yu","poem":1},{"text":"na olgeta lain i kamap bihain","poem":2},{"text":"bai ol i tingim yu oltaim.","poem":3},{"text":"Olsem na ol manmeri nabaut","poem":1},{"text":"oltaim bai ol i litimapim nem bilong yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}