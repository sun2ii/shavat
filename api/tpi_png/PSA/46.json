":[{"text":"Na si i ken pairap strong moa","poem":1},{"text":"na bruk nabaut","poem":3},{"text":"na spet i ken kamap,","poem":2},{"lineBreak":true},{"text":"na biksi i ken kalap nabaut","poem":2},{"text":"na sakim ol maunten.","poem":3},{"text":"Tasol maski, yumi no ken pret.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taun bilong God,","poem":1},{"text":"em i ples God Antap Tru","poem":2},{"text":"i makim bilong em yet.","poem":3},{"text":"Wanpela bikpela wara","poem":1},{"text":"i stap namel long en,","poem":3},{"text":"na ol manmeri i save amamas","poem":2},{"text":"long dispela wara.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"God i stap long dispela taun,","poem":1},{"text":"olsem na taun i no inap bagarap.","poem":2},{"text":"I no tulait yet","poem":1},{"text":"na bai God i helpim em.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol lain manmeri i kirap nogut","poem":1},{"text":"na i pait wantaim.","poem":2},{"text":"Na ol king","poem":1},{"text":"wantaim ol manmeri bilong ol,","poem":3},{"text":"ol i bagarap.","poem":2},{"text":"God i bikmaus moa yet","poem":1},{"text":"na graun i kamap","poem":2},{"text":"olsem wara nating.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela I Gat Olgeta Strong","poem":1},{"text":"em i stap wantaim yumi.","poem":2},{"text":"God bilong Jekop","poem":1},{"text":"em i ples hait bilong yumi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kaman! Yupela lukim wok","poem":1},{"text":"Bikpela i mekim.","poem":2},{"text":"Bai bel bilong yupela i kirap nogut","poem":1},{"text":"long planti narakain samting","poem":2},{"text":"em i mekim long graun.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i save mekim i dai pait","poem":1},{"text":"long olgeta hap graun.","poem":2},{"text":"Em i save brukim","poem":1},{"text":"olgeta banara na spia,","poem":3},{"text":"na em i save kukim","poem":2},{"text":"ol hap plang long paia.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Em i tok olsem,","poem":1},{"text":"“Yupela i no ken pait moa.","poem":2},{"lineBreak":true},{"text":"Yupela i mas save gut long mi,","poem":2},{"text":"mi God tru.","poem":3},{"text":"Mi antap tru","poem":2},{"text":"na olgeta lain manmeri","poem":3},{"text":"i stap aninit long mi.","poem":4},{"text":"Long olgeta hap bilong graun","poem":2},{"text":"mi stap nambawan tru.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela I Gat Olgeta Strong","poem":1},{"text":"em i stap wantaim yumi.","poem":2},{"text":"God bilong Jekop","poem":1},{"text":"em i ples hait bilong yumi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}