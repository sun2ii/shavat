{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":49,"content":[{"type":"heading","content":["Man i tingting long mani na kago tasol, em i longlong man"]},{"type":"hebrew_subtitle","content":["Dispela song em i bilong ol lain Kora. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Yupela olgeta manmeri, harim.","poem":1},{"lineBreak":true},{"text":"Yupela olgeta manmeri","poem":1},{"text":"i stap long graun,","poem":3},{"text":"putim gut yau long tok bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yupela man i gat nem","poem":1},{"text":"na yupela man nating,","poem":3},{"lineBreak":true},{"text":"yupela maniman","poem":3},{"lineBreak":true},{"text":"na yupela rabisman,","poem":3},{"text":"yupela harim gut dispela tok.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bel bilong mi","poem":1},{"text":"i gat gutpela tingting tasol.","poem":2},{"text":"Olsem na bai mi autim gutpela tok","poem":1},{"text":"bilong givim save long yupela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bai mi autim","poem":1},{"text":"sampela tok bokis pastaim.","poem":2},{"text":"Na bai mi mekim musik long gita","poem":1},{"text":"na autim as bilong tok bokis","poem":2},{"text":"long yupela.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol man i ting planti mani","poem":1},{"text":"em inap strongim ol,","poem":3},{"text":"na ol i save bikmaus nabaut","poem":2},{"text":"long ol yet i gat planti samting,","poem":3},{"text":"ol dispela man i raunim mi","poem":2},{"text":"na i laik bagarapim mi.","poem":3},{"text":"Tasol bai mi no ken pret long ol.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yumi save, i no gat wanpela man","poem":1},{"text":"i ken baim bek em yet long mani.","poem":2},{"text":"Na em i no inap givim mani","poem":1},{"text":"long God","poem":3},{"text":"inap long baim laip bilong en.","poem":2},{"text":"Nogat tru.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Long wanem,","poem":1},{"text":"pe bilong baim bek man,","poem":2},{"text":"em i antap tumas.","poem":3},{"text":"Man i no inap baim God","poem":1},{"text":"bai God i larim em","poem":2},{"text":"i stap laip oltaim","poem":3},{"text":"na em i no ken i dai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yumi lukim ol saveman tu,","poem":1},{"text":"ol i save dai.","poem":3},{"text":"Na ol krankiman","poem":1},{"text":"na ol longlong man","poem":3},{"text":"ol i save dai.","poem":2},{"text":"Ol dispela man bai i lusim","poem":1},{"text":"mani samting bilong ol","poem":3},{"text":"na bai ol arapela man i kisim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pastaim ol dispela man","poem":1},{"text":"i gat graun bilong ol yet,","poem":3},{"text":"tasol nau matmat tasol","poem":2},{"lineBreak":true},{"text":"em i olsem ples","poem":2},{"text":"bai ol i stap oltaim oltaim long en.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Biknem bilong yumi","poem":1},{"text":"i no inap pasim yumi long dai.","poem":2},{"text":"Nogat.","poem":1},{"lineBreak":true},{"text":"Yumi bai i dai olsem ol abus tasol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dispela bai i kamap long ol man","poem":1},{"text":"i bilip tumas long ol yet","poem":2},{"text":"na long ol samting ol i holim.","poem":3},{"text":"Kain man olsem","poem":1},{"text":"i no gat gutpela tingting.","poem":2},{"text":"Ol dispela man i amamas nating","poem":1},{"text":"long ol samting ol i kisim,","poem":3},{"text":"bai ol i dai olsem.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"God i makim ol","poem":1},{"text":"bai ol i dai olsem ol sipsip","poem":2},{"lineBreak":true},{"text":"na i go long ples","poem":2},{"text":"bilong ol man i dai pinis.","poem":3},{"text":"Na bai Dai i stap","poem":1},{"text":"olsem wasman bilong ol.","poem":2},{"text":"Taim ol i lusim pinis","poem":1},{"text":"ol gutpela haus bilong ol,","poem":3},{"text":"na bodi bilong ol i sting olgeta,","poem":2},{"lineBreak":true},{"text":"na ol i stap long ples","poem":2},{"text":"bilong ol man i dai pinis,","poem":3},{"text":"orait ol stretpela man","poem":2},{"text":"i ken amamas","poem":4},{"text":"long samting i bin kamap","poem":3},{"text":"long ol.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Tasol bai God i kisim bek mi,","poem":1},{"text":"na ples bilong ol man i dai pinis","poem":2},{"text":"bai i no gat strong bilong holimpas mi.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Sapos narapela man","poem":1},{"text":"i kisim planti mani samting,","poem":3},{"text":"na i wokim bikpela haus","poem":2},{"text":"na i gat planti bilas,","poem":3},{"text":"maski, yu no ken wari","poem":2},{"text":"long dispela.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Yu save pinis, bihain em bai i dai,","poem":1},{"text":"na em i no inap kisim","poem":2},{"text":"wanpela samting i go wantaim em.","poem":3},{"text":"Haus na bilas na mani bilong en,","poem":1},{"text":"dispela olgeta samting","poem":2},{"text":"i no inap i go wantaim em","poem":3},{"text":"long ples bilong ol man i dai pinis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taim em i stap laip","poem":1},{"text":"em i save amamas","poem":2},{"text":"long ol dispela samting.","poem":3},{"text":"Em i wok strong","poem":1},{"text":"na kisim planti samting,","poem":3},{"text":"na ol man i tok,","poem":2},{"text":"“Em i gutpela man.”","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Tasol maski, em bai i dai","poem":1},{"text":"na i stap wantaim ol tumbuna","poem":2},{"text":"long ples ol i no save lukim","poem":3},{"text":"lait bilong san gen.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Biknem bilong yumi","poem":1},{"text":"i no inap pasim yumi long dai.","poem":2},{"text":"Bai yumi dai olsem ol abus tasol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":18}