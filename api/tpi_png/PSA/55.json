{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":55,"content":[{"type":"heading","content":["Man i askim God long helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Maskil. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"God, yu mas harim","poem":1},{"text":"beten bilong mi.","poem":2},{"text":"Yu no ken pasim yau","poem":1},{"text":"long krai bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Plis, yu mas harim gut","poem":1},{"text":"prea bilong mi,","poem":3},{"text":"na bekim tok long mi.","poem":2},{"text":"Dispela hevi i laik bagarapim mi tru.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ol birua i tok strong","poem":1},{"text":"long bagarapim mi.","poem":2},{"text":"Ol dispela man nogut","poem":1},{"text":"i save daunim mi.","poem":2},{"text":"Olsem na bel bilong mi","poem":1},{"text":"i pilim nogut tru.","poem":2},{"text":"Ol i putim planti hevi long mi","poem":1},{"text":"na ol i kros tumas","poem":2},{"text":"na ol i birua nogut long mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi pret moa yet long ol,","poem":1},{"text":"na mi tingting long i dai,","poem":3},{"text":"na dispela i mekim bel bilong mi","poem":2},{"text":"i hevi tru.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Yes, mi pret tumas","poem":1},{"text":"na skin bilong mi","poem":2},{"text":"i guria nogut tru.","poem":3},{"text":"Pret i daunim mi olgeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Orait mi tok olsem,","poem":1},{"text":"“Sori, mi laikim tumas","poem":2},{"text":"bai mi kisim wing","poem":3},{"text":"olsem ol pisin.","poem":4},{"text":"Na mi laik flai i go painim","poem":2},{"text":"wanpela ples bilong malolo","poem":3},{"text":"na bai mi sindaun i stap long en.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bai mi flai i go longwe tru","poem":2},{"text":"na bai mi stap olgeta","poem":3},{"text":"long hap i no gat man.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Bai mi flai hariap","poem":2},{"text":"na painim wanpela ples hait,","poem":3},{"text":"na bai mi hait","poem":2},{"text":"long strongpela win na ren.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mi lukim ol man i pait nabaut","poem":1},{"text":"insait long taun.","poem":2},{"text":"Olsem na Bikpela,","poem":1},{"text":"yu ken paulim toktok bilong ol","poem":2},{"lineBreak":true},{"text":"na pinisim ol tru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Long san na long nait","poem":1},{"text":"ol i save wokabaut","poem":2},{"text":"antap long banis ston bilong taun.","poem":3},{"text":"Na ol manmeri bilong taun","poem":1},{"text":"i save mekim planti rong","poem":2},{"text":"na trabel.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Long olgeta hap bilong taun","poem":1},{"text":"ol man i save bagarapim","poem":2},{"text":"ol arapela man","poem":3},{"lineBreak":true},{"text":"na ol samting nabaut.","poem":3},{"text":"Long arere bilong rot","poem":1},{"text":"na long ples bung","poem":3},{"text":"ol man i save daunim","poem":2},{"text":"ol arapela man,","poem":3},{"text":"na giamanim ol","poem":2},{"lineBreak":true},{"text":"bilong pulim ol samting bilong ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sapos wanpela birua","poem":1},{"text":"i tok nogut long mi,","poem":3},{"text":"maski, mi inap karim hevi","poem":2},{"text":"bilong tok bilong en.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Tasol nogat. Em yu tasol.","poem":2},{"text":"Yu nambawan pren bilong mi,","poem":1},{"text":"na yu poroman tru bilong mi.","poem":2},{"text":"Yu yet i mekim dispela pasin.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Bipo mitupela","poem":1},{"text":"i save wokabaut wantaim","poem":2},{"text":"na toktok gut wantaim,","poem":3},{"text":"na i go long haus bilong God","poem":2},{"text":"wantaim ol arapela man.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ol birua bilong mi,","poem":1},{"text":"pasin nogut i pulap tru","poem":2},{"text":"long bel bilong ol","poem":3},{"lineBreak":true},{"text":"na long haus bilong ol.","poem":3},{"text":"Orait mi laik bai ol i dai kwiktaim.","poem":2},{"text":"Taim ol i stap laip yet,","poem":1},{"text":"na ol i mas i go","poem":2},{"text":"long ples bilong ol man i dai pinis.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tasol mi prea long God i helpim mi.","poem":1},{"text":"Na bai em yet i kisim bek mi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Long moningtaim na long biksan","poem":1},{"text":"na long nait tu","poem":3},{"text":"mi save krai long em","poem":2},{"text":"long ol hevi i bagarapim mi.","poem":3},{"text":"Na bai em i harim prea bilong mi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Planti man i save pait long mi.","poem":1},{"text":"Tasol mi no kisim bagarap,","poem":2},{"text":"long wanem, God i lukautim mi","poem":3},{"text":"na bringim mi i kam bek gen.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Bipo tru God i stap king,","poem":1},{"text":"na nau tu em i stap king.","poem":2},{"text":"Bai em yet i harim prea bilong mi,","poem":1},{"text":"na bai em i winim ol birua","poem":2},{"text":"long pait.","poem":3},{"text":"Ol i no save pret long em,","poem":1},{"text":"olsem na ol i no inap","poem":2},{"text":"mekim wanpela samting","poem":3},{"text":"bilong helpim ol yet.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dispela pren bilong mi em i pait","poem":1},{"text":"long ol pren bilong em yet.","poem":2},{"text":"Na em i brukim dispela promis","poem":1},{"text":"em i bin mekim wantaim ol bipo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Long maus","poem":1},{"text":"em i save mekim switpela tok,","poem":3},{"text":"tasol long bel","poem":2},{"text":"em i save stap birua bilong mi.","poem":3},{"text":"Tok bilong en","poem":1},{"text":"i mekim mipela i stap bel isi.","poem":2},{"text":"Tasol dispela tok i sap tumas","poem":1},{"text":"olsem bainat,","poem":3},{"text":"na i katim mipela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Olgeta hevi yu karim,","poem":1},{"text":"em yu mas putim","poem":2},{"text":"long han bilong Bikpela,","poem":3},{"text":"bai em i karim","poem":2},{"text":"na bai em i strongim yu.","poem":3},{"text":"Bai em i no larim wanpela samting","poem":1},{"text":"i bagarapim ol stretpela man.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tasol God, bai yu rausim ol man","poem":1},{"text":"i save kilim ol man i dai,","poem":3},{"lineBreak":true},{"text":"na ol man bilong giaman,","poem":3},{"text":"na bai ol i go daun long ples nogut","poem":2},{"text":"na bai ol i lus.","poem":3},{"text":"Taim bilong ol i no pinis yet","poem":1},{"text":"na bai ol i dai.","poem":2},{"text":"Tasol mi yet,","poem":1},{"text":"bai mi bilip strong long yu oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}