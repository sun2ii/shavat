{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":58,"content":[{"type":"heading","content":["Man i beten bai God i mekim save long ol man nogut"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Miktam. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “No ken bagarapim.”"]},{"type":"verse","number":1,"content":[{"text":"Yupela ol hetman,","poem":1},{"text":"yupela i save mekim","poem":2},{"text":"stretpela tok long kot, a?","poem":3},{"text":"Ating yupela i save skelim gut","poem":1},{"text":"tok bilong olgeta man?","poem":2},{"text":"Nogat tru.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tingting bilong yupela i pas","poem":1},{"text":"long mekim pasin nogut tasol.","poem":2},{"text":"Na yupela i wok long bagarapim","poem":1},{"text":"ol man long olgeta hap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ol man nogut","poem":1},{"text":"i save lusim gutpela rot","poem":2},{"text":"long olgeta wokabaut bilong ol.","poem":3},{"text":"Taim ol i kamap nupela pikinini yet","poem":1},{"text":"i go inap ol i lapun,","poem":3},{"text":"ol i wok long giaman tasol.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tok bilong ol i olsem","poem":1},{"text":"marasin nogut bilong snek.","poem":2},{"text":"Ol i save pasim yau bilong ol,","poem":1},{"text":"olsem snek, yau bilong en i pas","poem":2},{"text":"na em i no inap harim tok.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Dispela snek i no save harim","poem":1},{"text":"tok bilong saveman,","poem":3},{"text":"taim em i mekim musik","poem":2},{"text":"bilong mekim snek i kirap","poem":3},{"text":"na singsing.","poem":4},{"text":"Maski saveman i save tumas","poem":1},{"text":"long winim mambu,","poem":3},{"text":"snek i no inap harim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God, yu mas bagarapim","poem":1},{"text":"ol dispela man nogut.","poem":2},{"text":"Bikpela, ol i olsem laion","poem":1},{"text":"bilong pait nogut,","poem":3},{"text":"olsem na yu mas brukim tit","poem":2},{"text":"bilong ol","poem":4},{"text":"na kamautim olgeta.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ol i mas lus olsem wara i ran i go","poem":1},{"text":"na i lus nating long graun.","poem":2},{"text":"Yu mas krungutim ol","poem":1},{"text":"olsem man i krungutim gras","poem":2},{"text":"na gras i drai.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ol i ken bagarap","poem":1},{"text":"olsem demdem i dai","poem":2},{"text":"na i sting long graun.","poem":3},{"text":"Na ol i ken i dai","poem":1},{"text":"olsem pikinini i dai","poem":2},{"text":"long bel bilong mama.","poem":3},{"text":"Bihain mama i karim em","poem":1},{"text":"na pikinini i no lukim san.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwiktaim tumas","poem":1},{"text":"God i bagarapim ol,","poem":3},{"text":"olsem man i katim liklik diwai.","poem":2},{"text":"Ol i stap laip yet","poem":1},{"text":"na God i belhat tru long ol","poem":2},{"text":"na em i tromoi ol olsem pipia.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ol stretpela man bai i amamas","poem":1},{"text":"long taim God i mekim save","poem":2},{"text":"long ol man bilong mekim sin.","poem":3},{"text":"Ol stretpela man","poem":1},{"text":"bai i wasim lek bilong ol","poem":2},{"text":"long blut bilong ol man nogut.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Na ol arapela man bai i tok olsem,","poem":1},{"text":"“Tru tumas,","poem":2},{"text":"God i save bekim gutpela pe","poem":3},{"text":"long ol stretpela man.","poem":4},{"text":"Tru tumas, God i stap,","poem":2},{"text":"na em i save skelim pasin","poem":3},{"text":"bilong olgeta manmeri long kot.”","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}