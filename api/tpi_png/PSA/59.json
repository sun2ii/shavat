{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":59,"content":[{"type":"heading","content":["Man i beten bai ol birua i no ken bagarapim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Miktam. Devit i raitim dispela song long taim King Sol i salim ol man i go was long haus bilong Devit, bai ol i ken holimpas em na kilim em i dai. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “No ken bagarapim.”"]},{"type":"verse","number":1,"content":[{"text":"God bilong mi,","poem":1},{"text":"yu mas kisim bek mi","poem":2},{"text":"long han bilong ol birua","poem":3},{"text":"bilong mi.","poem":4},{"text":"Yu mas lukautim mi","poem":1},{"text":"bai ol i no bagarapim mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu mas rausim mi","poem":1},{"text":"long han bilong ol man nogut,","poem":3},{"text":"na kisim bek mi","poem":2},{"text":"long han bilong ol man","poem":3},{"text":"i laik kilim mi i dai.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lukim ol. Ol i hait i stap","poem":1},{"text":"bilong kilim mi i dai.","poem":2},{"text":"Ol i man nogut bilong pait","poem":1},{"text":"na ol i bung bilong pait long mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bikpela, mi no mekim rong","poem":1},{"text":"na mi no bikhet long lo bilong yu,","poem":3},{"text":"na mi no gat asua","poem":2},{"text":"long wanpela samting.","poem":3},{"text":"Tasol ol i hariap i go sambai","poem":1},{"text":"bilong pait long mi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God, Bikpela I Gat Olgeta Strong,","poem":1},{"text":"yu mas hariap i kam helpim mi.","poem":2},{"text":"Yu God bilong Israel,","poem":1},{"text":"lukim ol dispela man.","poem":2},{"text":"Yu kam kwik na mekim save","poem":1},{"text":"long olgeta lain manmeri.","poem":2},{"text":"Yu no ken sori long ol.","poem":3},{"text":"Bekim tru ol dispela lain manmeri","poem":1},{"text":"i tok olsem ol i laik mekim","poem":2},{"text":"gutpela pasin,","poem":3},{"text":"tasol ol i tingting","poem":2},{"text":"long mekim pasin nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Long nait ol i kam bek long biktaun","poem":1},{"text":"na ol i raun raun long banis","poem":2},{"text":"na singaut olsem ol dok.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Harim. Tok bilong ol i nogut tru,","poem":1},{"text":"i olsem bainat i sap moa.","poem":2},{"text":"Tasol ol i tok,","poem":1},{"text":"“Husat bai i harim mipela?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tasol Bikpela,","poem":1},{"text":"yu save lap nogut long ol.","poem":2},{"text":"Yu save tok bilas","poem":1},{"text":"long olgeta lain manmeri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yu tasol i save strongim mi","poem":1},{"text":"na lukautim mi.","poem":2},{"text":"God, mi save go long yu tasol","poem":1},{"text":"na mi hait long ol birua.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"God bilong mi","poem":1},{"text":"em i save laikim mi tru,","poem":2},{"text":"na em bai i kam helpim mi.","poem":3},{"text":"God i larim mi","poem":1},{"text":"na bai mi lukim em","poem":2},{"text":"i winim ol birua bilong mi.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"God, mobeta yu no kilim ol i dai.","poem":1},{"lineBreak":true},{"text":"Nogut ol manmeri bilong mi","poem":1},{"text":"i lusim tingting long ol samting","poem":2},{"text":"yu mekim long ol man nogut.","poem":3},{"text":"Bikpela, yu wasman","poem":1},{"text":"bilong lukautim mipela.","poem":2},{"text":"Long strong bilong yu tasol,","poem":1},{"text":"yu mas rausim ol birua nabaut","poem":2},{"text":"na bagarapim ol.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Oltaim ol i tok long mekim sin tasol.","poem":2},{"text":"Larim ol i kisim bagarap","poem":1},{"text":"long pasin bikhet bilong ol.","poem":2},{"text":"Ol i save tok nogut","poem":1},{"text":"long nem bilong yu,","poem":3},{"text":"na ol i tok giaman oltaim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Olsem na mobeta yu belhat long ol","poem":1},{"text":"na yu kilim ol.","poem":3},{"text":"Pinisim tru ol dispela man nogut.","poem":2},{"text":"Yu mekim olsem,","poem":1},{"text":"na bai ol manmeri i ken save,","poem":2},{"text":"yu God, yu stap king","poem":3},{"text":"bilong ol Israel,","poem":4},{"text":"na yu king bilong olgeta hap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Long nait ol birua bilong mi","poem":1},{"text":"i kam bek long taun,","poem":3},{"text":"na ol i raun raun","poem":2},{"text":"na singaut olsem ol dok.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ol i wokabaut i go i kam","poem":1},{"text":"bilong painim kaikai,","poem":3},{"text":"na sapos bel bilong ol i no pulap,","poem":2},{"text":"ol i save singaut nogut tru.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Tasol mi bai singim song","poem":1},{"text":"long bikpela strong bilong yu.","poem":2},{"text":"Long moningtaim long olgeta de","poem":1},{"text":"bai mi singsing bikpela","poem":3},{"text":"bilong tingim yu","poem":2},{"text":"i save laikim mi tumas oltaim.","poem":3},{"text":"Long wanem, ol kain kain hevi","poem":1},{"text":"i kamap long mi bipo,","poem":3},{"text":"na yu bin lukautim mi gut","poem":2},{"text":"na yu stap olsem banis bilong mi.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"God, yu tasol yu strong bilong mi.","poem":1},{"lineBreak":true},{"text":"Mi laik mekim song","poem":1},{"text":"bilong litimapim nem bilong yu.","poem":2},{"text":"God, yu save laikim mi tru,","poem":1},{"text":"na yu strongpela banis bilong mi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}