{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":67,"content":[{"type":"heading","content":["Song bilong amamas long God"]},{"type":"hebrew_subtitle","content":["Dispela song em song bilong lotu. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"God, yu ken marimari","poem":1},{"text":"long mipela","poem":3},{"text":"na mekim gut long mipela.","poem":2},{"text":"Yu ken lukluk i kam long mipela","poem":1},{"text":"na helpim mipela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Olsem na olgeta manmeri i ken save","poem":1},{"text":"long pasin bilong yu,","poem":3},{"text":"na olgeta lain i ken save olsem","poem":2},{"text":"yu inap kisim bek ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God, mi laik bai olgeta manmeri","poem":1},{"text":"i ken amamas long yu","poem":2},{"text":"na litimapim nem bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olgeta lain manmeri i ken belgut","poem":1},{"text":"na singsing bilong amamas,","poem":3},{"text":"long wanem, yu bai skelim pasin","poem":2},{"text":"bilong olgeta manmeri","poem":3},{"text":"long stretpela kot bilong yu,","poem":4},{"text":"na yu save stiaim ol lain manmeri","poem":2},{"text":"long gutpela rot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, mi laik bai olgeta manmeri","poem":1},{"text":"i ken amamas long yu","poem":2},{"text":"na litimapim nem bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Planti gutpela kaikai i kamap pinis","poem":1},{"text":"long graun bilong mipela.","poem":2},{"text":"God, em i God bilong mipela,","poem":1},{"text":"em i bin mekim gut tru","poem":2},{"text":"long mipela.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Tru tumas,","poem":1},{"text":"God i mekim gut long mipela.","poem":2},{"text":"Olgeta manmeri bilong graun","poem":1},{"text":"i mas i stap aninit long em.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}