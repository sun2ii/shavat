{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":7,"content":[{"type":"heading","content":["Prea bilong man i gat hevi"]},{"type":"hebrew_subtitle","content":["Devit i bel hevi long pasin wanpela man bilong lain Benjamin, nem bilong en Kus, i mekim long em, olsem na em i singim dispela beten long Bikpela."]},{"type":"verse","number":1,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"mi kam long yu","poem":2},{"lineBreak":true},{"text":"na mi hait long ol birua.","poem":2},{"text":"Yu helpim mi,","poem":1},{"text":"na bai ol man i ranim mi","poem":2},{"text":"ol i no ken kilim mi i dai.","poem":3},{"text":"Yu kisim bek mi bai mi no bagarap.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nogut ol i bagarapim mi olsem laion","poem":1},{"text":"i brukim skin bilong man.","poem":2},{"text":"Nogut ol i pulim mi","poem":1},{"text":"i go long wanpela hap","poem":3},{"text":"na i no gat man inap kisim bek mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"sapos mi gat asua","poem":2},{"text":"long ol pasin nogut,","poem":3},{"text":"sapos mi bin mekim nogut","poem":2},{"text":"long narapela man,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"sapos mi bin trikim","poem":2},{"text":"pren bilong mi,","poem":3},{"text":"na sutim tok nating long en,","poem":2},{"lineBreak":true},{"text":"na sapos mi bin mekim nogut","poem":2},{"text":"nating long birua bilong mi,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"orait yu ken larim ol birua","poem":2},{"text":"i ranim mi na holimpas mi.","poem":3},{"text":"Ol i ken krungutim mi","poem":1},{"text":"na bagarapim mi olgeta","poem":2},{"lineBreak":true},{"text":"na larim bodi bilong mi","poem":2},{"text":"i slip i stap nating long graun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God, mi laik bai yu ken kirap.","poem":1},{"lineBreak":true},{"text":"Yu ken belhat long ol birua","poem":1},{"text":"i pait strong moa long mi","poem":3},{"text":"na yu ken mekim save long ol.","poem":2},{"text":"God bilong mi, yu save laikim","poem":1},{"text":"stretpela pasin tasol,","poem":3},{"text":"olsem na yu mas kirap","poem":2},{"text":"na helpim mi.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Yu mas sindaun","poem":1},{"text":"long sia king bilong yu long heven","poem":2},{"lineBreak":true},{"text":"na tokim olgeta lain manmeri","poem":2},{"text":"long kam bung klostu long yu.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu save skelim pasin","poem":1},{"text":"bilong olgeta lain manmeri.","poem":2},{"text":"Olsem na yu ken helpim mi","poem":1},{"text":"long winim kot,","poem":3},{"text":"long wanem, mi bin mekim","poem":2},{"text":"ol gutpela stretpela na pasin tasol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"God, yu stretpela olgeta.","poem":1},{"lineBreak":true},{"text":"Yu save skelim tingting na bel","poem":1},{"text":"bilong olgeta man.","poem":2},{"text":"Orait yu mas pinisim tru","poem":1},{"text":"ol pasin nogut","poem":2},{"text":"bilong ol man nogut.","poem":3},{"text":"Na yu ken helpim ol stretpela man","poem":1},{"text":"bai ol i sanap strong.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"God em i wasman bilong mi.","poem":1},{"lineBreak":true},{"text":"Em i save helpim ol man","poem":1},{"text":"i bihainim tok bilong em.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"God em i gutpela jas","poem":1},{"text":"na em i save mekim stretpela kot.","poem":2},{"text":"Oltaim em i save daunim","poem":1},{"text":"ol man bilong mekim pasin nogut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sapos ol man nogut i no tanim bel,","poem":1},{"text":"bai God i sapim bainat bilong en.","poem":2},{"text":"Na bai em i taitim banara","poem":1},{"text":"na i redi long pait.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Em i makim ol long spia i gat paia.","poem":1},{"lineBreak":true},{"text":"Em i redim pinis ol spia samting","poem":1},{"text":"bilong kilim ol dispela man i dai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lukim man nogut.","poem":1},{"lineBreak":true},{"text":"Em i pasim tingting pinis","poem":1},{"text":"long mekim ol pasin nogut.","poem":2},{"text":"Em i redi long mekim olkain trabel","poem":1},{"text":"na em i save giaman oltaim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Em i wokim bikpela hul long graun","poem":1},{"text":"bilong holimpas narapela man.","poem":2},{"text":"Tasol em yet bai i pundaun","poem":1},{"text":"long dispela hul em i bin wokim.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Olsem tasol rong em i mekim","poem":1},{"text":"bai i karamapim em yet.","poem":2},{"text":"Na kros pait em i laik mekim","poem":1},{"text":"long ol arapela man","poem":3},{"text":"bai i tanim na bagarapim em yet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"God em i stretpela olgeta,","poem":1},{"text":"na mi tenkyu long em.","poem":2},{"text":"Bai mi singim song","poem":1},{"text":"long God Antap Tru","poem":2},{"text":"bilong litimapim","poem":3},{"text":"nem bilong em.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}