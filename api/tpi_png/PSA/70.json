{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":70,"content":[{"type":"heading","content":["Man i beten long God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, bilong mekim God i tingim ol hevi bilong en. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, plis","poem":1},{"text":"yu ken kisim bek mi.","poem":2},{"text":"Bikpela, yu kam hariap","poem":1},{"text":"na helpim mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sampela man i laik kilim mi i dai.","poem":1},{"text":"Yu mas daunim ol na paulim ol,","poem":2},{"text":"bai ol i sem.","poem":3},{"text":"Na sampela man i amamas","poem":1},{"text":"long ol hevi bilong mi.","poem":2},{"text":"Yu mas rausim ol i go bek","poem":1},{"text":"na daunim nem bilong ol.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ol dispela man i tok bilas long mi,","poem":1},{"text":"yu mas semim ol moa yet,","poem":3},{"text":"bai ol i kirap nogut tru","poem":2},{"text":"long pasin bilong ol.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Tasol ol manmeri i save go long yu,","poem":1},{"text":"ol i ken belgut","poem":2},{"text":"na amamas long yu.","poem":3},{"text":"Dispela olgeta manmeri","poem":1},{"text":"yu bin kisim bek ol,","poem":3},{"text":"na ol i laikim tumas","poem":2},{"text":"dispela wok yu bin mekim long ol,","poem":3},{"text":"oltaim ol i ken tok olsem,","poem":2},{"text":"“God em i nambawan tru.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"God, mi no gat strong,","poem":1},{"text":"na mi no inap helpim mi yet.","poem":2},{"text":"Olsem na yu mas i kam long mi","poem":1},{"text":"kwiktaim.","poem":2},{"text":"Bikpela, yu yet","poem":1},{"text":"yu man bilong helpim mi","poem":2},{"text":"na kisim bek mi.","poem":3},{"text":"Yu no ken wet,","poem":1},{"text":"yu mas helpim mi kwik.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}