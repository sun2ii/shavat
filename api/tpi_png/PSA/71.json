{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":71,"content":[{"type":"heading","content":["Prea bilong lapun man"]},{"type":"verse","number":1,"content":[{"text":"Bikpela, mi save stap","poem":1},{"text":"wantaim yu,","poem":3},{"text":"na ol birua","poem":2},{"text":"i no inap bagarapim mi.","poem":3},{"text":"Yu no ken larim ol i winim mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu stretpela olgeta,","poem":1},{"text":"olsem na yu ken helpim mi","poem":3},{"text":"na kisim bek mi","poem":2},{"text":"long han bilong ol birua.","poem":3},{"text":"Yu ken harim prea bilong mi","poem":1},{"text":"na kisim bek mi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu stap olsem strongpela banis,","poem":1},{"text":"na olsem strongpela haus.","poem":2},{"text":"Bai mi go insait","poem":1},{"text":"na yu lukautim mi, long wanem,","poem":3},{"text":"mi ken i go long yu tasol","poem":2},{"text":"na mi hait.","poem":3},{"text":"Yu tasol inap lukautim mi","poem":1},{"text":"na mi stap gut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God bilong mi, kisim bek mi","poem":1},{"text":"long han bilong ol man nogut.","poem":2},{"text":"Ol i strong tumas","poem":1},{"text":"na pasin bilong ol i nogut tru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bikpela, mi save bilip","poem":1},{"text":"long yu tasol.","poem":2},{"text":"Mi yangpela yet na mi bilip long yu,","poem":1},{"text":"na mi bilip yet inap long nau.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oltaim mi stap","poem":1},{"text":"long han bilong yu tasol","poem":2},{"text":"na mi wokabaut.","poem":3},{"text":"Mama i karim mi","poem":1},{"text":"na yu bin lukautim mi","poem":2},{"text":"i kam inap long nau.","poem":3},{"text":"Olsem na bai mi litimapim","poem":1},{"text":"nem bilong yu oltaim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Planti manmeri i bin lukim mi","poem":1},{"text":"na ol samting i kamap long mi,","poem":2},{"text":"na ol i save,","poem":3},{"text":"yu tasol yu strong tumas","poem":2},{"text":"long lukautim mi.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Long olgeta de","poem":1},{"text":"mi save litimapim nem bilong yu","poem":3},{"text":"na tokaut long biknem bilong yu","poem":2},{"text":"long ol manmeri.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Nau mi lapun pinis","poem":1},{"text":"na mi no gat strong moa,","poem":3},{"text":"orait nogut yu lusim mi","poem":2},{"text":"na givim baksait long mi.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ol birua i laik kilim mi,","poem":1},{"text":"na ol i kibung","poem":2},{"text":"na pasim tok long bagarapim mi.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol i tok olsem,","poem":1},{"text":"“Goan, yumi ranim em","poem":2},{"text":"na holimpas em.","poem":3},{"text":"I no gat wanpela man i stap","poem":2},{"text":"bilong helpim em.","poem":3},{"text":"God i lusim em pinis.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Orait God, yu no ken i stap","poem":1},{"text":"longwe long mi.","poem":2},{"text":"God bilong mi,","poem":1},{"text":"yu mas i kam hariap na helpim mi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dispela ol man i sutim tok long mi,","poem":1},{"text":"yu ken daunim ol","poem":2},{"text":"na pinisim ol tru.","poem":3},{"text":"Ol i laik bagarapim mi,","poem":1},{"text":"olsem na yu mas paulim ol","poem":2},{"text":"na mekim ol i sem nogut tru.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Tasol bai mi bilip long yu oltaim","poem":1},{"text":"na mi wet long yu i helpim mi.","poem":2},{"text":"Bai mi litimapim nem bilong yu","poem":1},{"text":"moa yet.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bai mi tokim ol manmeri","poem":1},{"text":"long stretpela pasin yu bin mekim.","poem":2},{"text":"Mi no save gut","poem":1},{"text":"long as bilong olgeta samting","poem":2},{"text":"yu bin mekim,","poem":3},{"text":"tasol maski, long olgeta de","poem":2},{"text":"bai mi tokim ol","poem":3},{"text":"long yu bin kisim bek mi.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"God, Bikpela, bai mi tingim","poem":1},{"text":"bikpela strong bilong yu","poem":3},{"text":"na bai mi litimapim","poem":2},{"text":"nem bilong yu.","poem":3},{"text":"Bai mi autim tok olsem,","poem":1},{"text":"“Bikpela tasol em i stretpela.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"God, yu bin skulim mi","poem":1},{"text":"long taim mi liklik yet","poem":2},{"text":"na i kam inap long nau,","poem":3},{"text":"na mi save tokaut yet","poem":2},{"text":"long ol gutpela gutpela samting","poem":3},{"text":"yu bin mekim.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Nau mi lapun pinis","poem":1},{"text":"na gras bilong mi","poem":2},{"text":"i waitpela olgeta,","poem":3},{"text":"tasol God, yu no ken lusim mi.","poem":2},{"text":"Yu mas i stap wantaim mi","poem":1},{"text":"na bai mi autim tok","poem":2},{"text":"bilong bikpela strong bilong yu","poem":3},{"text":"long ol lain manmeri","poem":2},{"text":"i kamap bihain.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"God, stretpela pasin bilong yu","poem":1},{"text":"inapim olgeta hap,","poem":3},{"text":"na i stap ples klia","poem":2},{"text":"long ai bilong olgeta manmeri.","poem":3},{"text":"Yu bin mekim bikpela wok tru.","poem":2},{"text":"I no gat wanpela man bilong graun","poem":1},{"text":"i wankain olsem yu.","poem":3},{"text":"Nogat. Yu winim olgeta.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yu bin salim olkain hevi","poem":1},{"text":"i kam long mi.","poem":2},{"text":"Tasol mi save,","poem":1},{"text":"bai yu strongim mi gen.","poem":2},{"text":"I olsem mi stap long matmat","poem":1},{"text":"na yu kirapim mi gen.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bai yu mekim nem bilong mi","poem":1},{"text":"i go bikpela moa yet,","poem":3},{"text":"na bai yu mekim bel bilong mi","poem":2},{"text":"i isi gen.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Bai","poem":1},"Wanpela kain gita bilong ol Israel.",{"text":"mi paitim gita","poem":1},{"text":"na mekim musik","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3},{"text":"God bilong mi,","poem":1},{"text":"yu no save lusim mi,","poem":2},{"text":"na tok bilong yu i tru olgeta,","poem":3},{"text":"olsem na bai mi","poem":2},{"text":"litimapim nem bilong yu.","poem":3},{"text":"God bilong Israel,","poem":1},{"text":"yu God bilong mekim","poem":2},{"text":"gutpela na stretpela pasin olgeta.","poem":3},{"text":"Bai mi paitim gita na singim song","poem":1},{"text":"bilong litimapim nem bilong yu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mi mekim musik","poem":1},{"text":"na bai mi amamas na singaut.","poem":2},{"text":"Bai mi singim song long yu,","poem":1},{"text":"na mi no singim long maus tasol.","poem":2},{"text":"Nogat.","poem":3},{"text":"Mi bai singim long olgeta tingting","poem":1},{"text":"na bel wantaim,","poem":3},{"text":"long wanem,","poem":2},{"text":"yu kisim bek mi pinis.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Olsem na long olgeta de","poem":1},{"text":"bai mi tokaut long ol manmeri","poem":2},{"text":"long stretpela pasin bilong yu.","poem":3},{"text":"Long wanem, ol man","poem":1},{"text":"i bin traim long bagarapim mi,","poem":3},{"text":"tasol yu daunim ol","poem":2},{"text":"na mekim ol i sem tru.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}