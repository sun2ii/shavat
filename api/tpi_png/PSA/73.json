{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":73,"content":[{"type":"heading","content":["God bai i mekim save long ol man nogut"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"God i save gutpela tru","poem":1},{"text":"long ol Israel.","poem":2},{"text":"God i save gutpela tumas","poem":1},{"text":"long ol manmeri","poem":2},{"text":"bel bilong ol i stap klin.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tasol klostu mi laik pundaun","poem":1},{"text":"long sin.","poem":2},{"text":"Mi olsem lek i wel pinis","poem":1},{"text":"na mi laik pundaun na lusim bilip.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Long wanem, mi lukim","poem":1},{"text":"ol man nogut i kamap maniman","poem":3},{"text":"na mi mangal long ol samting","poem":2},{"text":"bilong ol dispela bikhetman.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ol i no save kisim pen","poem":1},{"text":"long bodi bilong ol.","poem":2},{"text":"Ol i strongpela man,","poem":1},{"text":"na bodi bilong ol i gutpela tasol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol i no save karim ol hevi","poem":1},{"text":"olsem ol arapela man i karim.","poem":2},{"text":"Ol arapela man i save kisim","poem":1},{"text":"ol kain kain hevi,","poem":3},{"text":"tasol dispela kain samting","poem":2},{"text":"i no save kamap long ol.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Olsem na ol i hambak nating","poem":1},{"text":"na amamas long skin bilong ol.","poem":2},{"text":"Na ol i save paitim nating","poem":1},{"text":"ol arapela man","poem":2},{"text":"na bagarapim ol.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Long bel na tingting bilong ol,","poem":1},{"text":"ol i save kamapim","poem":2},{"text":"ol kain kain pasin nogut","poem":3},{"text":"ol i gat laik long mekim.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Ol i save tok bilas","poem":1},{"text":"long ol arapela man","poem":3},{"text":"na ol i tok","poem":2},{"text":"long mekim pasin nogut","poem":3},{"text":"long ol dispela man.","poem":4},{"text":"Ol i bikhet tru na ol i tok","poem":1},{"text":"long painim rot bilong bagarapim","poem":2},{"text":"ol arapela manmeri.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ol i tok nogut","poem":1},{"text":"long God i stap long heven.","poem":2},{"text":"Na ol i litimapim nem bilong ol yet","poem":1},{"text":"na ol i strong tumas","poem":3},{"text":"long ol manmeri","poem":2},{"text":"i mas bihainim laik bilong ol.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Olsem na ol manmeri bilong God","poem":1},{"text":"i laikim tok bilong ol bikhetman","poem":2},{"text":"na ol i bilipim dispela tok.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol man nogut i save tok olsem,","poem":1},{"text":"“God i no inap save","poem":2},{"text":"long samting mipela i mekim.","poem":3},{"text":"God Antap Tru i no gat rot","poem":2},{"text":"bilong painimaut","poem":3},{"text":"pasin bilong mipela.”","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Ol man nogut i olsem.","poem":1},{"lineBreak":true},{"text":"Ol i gat planti samting,","poem":1},{"text":"tasol ol i wok long kisim moa yet.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mi bin lukaut gut","poem":1},{"text":"na bel bilong mi i stap klin,","poem":2},{"text":"na mi no bin mekim sampela sin.","poem":3},{"text":"Ating dispela em i lus nating, a?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Long wanem, God,","poem":1},{"text":"yu givim pen long mi","poem":2},{"text":"long san na long nait,","poem":3},{"text":"na olgeta moningtaim","poem":2},{"text":"yu mekim save long mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sapos mi bin mekim kain tok","poem":1},{"text":"olsem ol man nogut i save mekim","poem":2},{"text":"long ol manmeri bilong yu,","poem":3},{"text":"bai mi giamanim ol na paulim ol.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mi tingting planti","poem":1},{"text":"na mi traim long painimaut","poem":2},{"text":"as bilong dispela samting","poem":3},{"text":"ol man nogut i mekim.","poem":4},{"text":"Tasol i hat tumas long mi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"God, mi traim i go i go","poem":1},{"text":"inap long taim","poem":2},{"text":"mi go insait long haus bilong yu.","poem":3},{"text":"Mi stap long haus bilong yu","poem":1},{"text":"na tingting bilong mi i klia,","poem":3},{"text":"na mi save long ol samting","poem":2},{"text":"bai i kamap long ol man nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yu mekim ol i wokabaut","poem":1},{"text":"long rot i wel moa yet,","poem":3},{"text":"na yu mekim ol i pundaun","poem":2},{"text":"na ol i bagarap olgeta.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Ol i bagarap kwiktaim tumas.","poem":1},{"text":"Na dispela dai bilong ol","poem":2},{"text":"em i nogut tru.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Bikpela, ol i olsem man i driman","poem":1},{"text":"na driman i pinis nating","poem":2},{"text":"long moningtaim.","poem":3},{"text":"Man i kirap long moningtaim","poem":1},{"text":"na driman i no i stap moa","poem":2},{"text":"long tingting bilong em.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Long dispela taim","poem":1},{"text":"tingting bilong mi i kirap nogut,","poem":3},{"text":"na bel bilong mi","poem":2},{"text":"i pilim nogut tru.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Na tingting bilong mi i pas,","poem":1},{"text":"na mi no save","poem":2},{"text":"long pasin bilong yu.","poem":3},{"text":"Mi mekim pasin long ai bilong yu,","poem":1},{"text":"olsem wel abus i no gat tingting.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tasol mi stap wantaim yu oltaim","poem":1},{"text":"na yu save holim han bilong mi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yu save givim mi gutpela tok","poem":1},{"text":"bilong stiaim wokabaut bilong mi,","poem":3},{"text":"na bihain bai yu kisim mi","poem":2},{"text":"na mi stap wantaim yu","poem":3},{"text":"long heven.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Husat arapela i stap long heven","poem":1},{"text":"na i save lukautim mi?","poem":2},{"text":"I no gat narapela man,","poem":1},{"text":"yu wanpela tasol.","poem":2},{"text":"Orait God, mi laikim yu moa yet.","poem":1},{"text":"Mi no laikim","poem":2},{"text":"olgeta samting bilong graun","poem":3},{"text":"olsem mi laikim yu.","poem":4}]},{"type":"verse","number":26,"content":[{"text":"Sapos bodi na tingting bilong mi","poem":1},{"text":"i no gat strong moa,","poem":3},{"text":"orait God, yu yet","poem":2},{"text":"yu strong bilong mi.","poem":3},{"text":"Na yu stap wantaim mi","poem":1},{"text":"na mi inap tru oltaim oltaim.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tru tumas, ol manmeri","poem":1},{"text":"i givim baksait long yu","poem":2},{"text":"bai ol i lus olgeta.","poem":3},{"text":"Na ol man i bin bihainim yu bipo,","poem":1},{"text":"na nau ol i lusim yu pinis,","poem":2},{"text":"bai yu bagarapim ol.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Tasol mi, mi stap klostu long yu","poem":1},{"text":"na dispela i gutpela tru.","poem":2},{"text":"God, Bikpela,","poem":1},{"text":"yu banis tru bilong mi,","poem":3},{"text":"na mi laik tokaut","poem":2},{"text":"long olgeta samting yu bin mekim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}