i i pinis.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"God, hamas taim moa","poem":1},{"text":"bai ol birua","poem":2},{"text":"i tok bilas long mipela?","poem":3},{"text":"Bai ol i tok nogut oltaim","poem":1},{"text":"long nem bilong yu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bilong wanem","poem":1},{"text":"yu no laik helpim mipela?","poem":2},{"text":"Bilong wanem","poem":1},{"text":"yu sindaun nating tasol?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tasol God, bipo tru","poem":1},{"text":"yu bin i stap king bilong mipela,","poem":3},{"text":"na nau tu","poem":2},{"text":"yu stap king bilong mipela.","poem":3},{"text":"Na planti taim yu bin helpim mipela","poem":1},{"text":"na mipela i no bagarap long pait.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Long strong bilong yu tasol","poem":1},{"text":"yu brukim bikpela solwara,","poem":3},{"text":"na wara i sanap","poem":2},{"text":"long hap na long hap.","poem":3},{"text":"Na yu bagarapim","poem":1},{"text":"ol manmeri bilong Isip.","poem":2},{"text":"Ol i olsem ol traipela pis","poem":1},{"text":"bilong solwara.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Na yu brukim ol het","poem":1},{"text":"bilong bikpela pukpuk,","poem":3},{"lineBreak":true},{"text":"em hetman bilong Isip,","poem":3},{"text":"na yu givim bodi bilong em","poem":2},{"text":"long ol manmeri","poem":3},{"text":"long ples drai i gat wesan,","poem":4},{"text":"na ol i kaikai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yu bin mekim ol wara","poem":1},{"text":"i kamap long graun","poem":3},{"text":"na ol wara i ran i go.","poem":2},{"text":"Na yu mekim ol bikpela wara","poem":1},{"text":"i go drai olgeta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yu wokim tulait na tudak,","poem":1},{"text":"na yu putim san na mun","poem":2},{"text":"i stap antap.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Na yu putim pinis mak","poem":1},{"text":"bilong olgeta graun.","poem":2},{"text":"Na yu putim taim bilong san","poem":1},{"text":"na taim bilong ren","poem":2},{"text":"long olgeta yia.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bikpela, yu no ken lusim tingting.","poem":1},{"text":"Ol birua bilong yu","poem":2},{"text":"ol i save tok bilas long yu.","poem":3},{"text":"Ol i olsem longlong man","poem":1},{"text":"na ol i ting","poem":2},{"text":"yu olsem samting nating.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Ol manmeri bilong yu","poem":1},{"text":"i no gat strong.","poem":2},{"text":"Olsem na nogut yu lusim mipela","poem":1},{"text":"na ol dispela birua","poem":2},{"text":"i bagarapim mipela nogut.","poem":3},{"text":"Ol birua i mekim save","poem":1},{"text":"long mipela ol manmeri bilong yu.","poem":2},{"text":"Plis, yu no ken lusim tingting","poem":1},{"text":"long mipela.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Long olgeta hap","poem":1},{"text":"bilong graun bilong mipela","poem":3},{"text":"ol man i save pait nabaut.","poem":2},{"text":"Olsem na yu mas tingting gen","poem":1},{"text":"long dispela kontrak","poem":2},{"text":"yu bin mekim wantaim mipela.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Yu no ken larim ol man nogut","poem":1},{"text":"i krungutim ol arapela man","poem":2},{"text":"na daunim ol tru.","poem":3},{"text":"Yu mas helpim ol rabisman","poem":1},{"text":"i sot long ol samting,","poem":3},{"text":"bai ol i ken litimapim","poem":2},{"text":"nem bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"God, yu mas kam","poem":1},{"text":"na tok strong long ol birua.","poem":2},{"text":"Yu mas tingim ol bikhetman","poem":1},{"text":"i save tok bilas long yu","poem":2},{"text":"long olgeta de.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Ol birua bilong yu","poem":1},{"text":"i save bikmaus nabaut","poem":2},{"text":"na tok nogut long yu.","poem":3},{"text":"Ol i save singaut bikpela tru oltaim.","poem":2},{"text":"God, yu no ken lusim tingting","poem":1},{"text":"long pasin bilong ol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}