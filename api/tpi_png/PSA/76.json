{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":76,"content":[{"type":"heading","content":["God i winim pait"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song, em song bilong lotu. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"Ol Juda i save gut long God.","poem":1},{"text":"Na ol Israel i litimapim","poem":2},{"text":"biknem bilong em.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Haus bilong en","poem":1},{"text":"i stap long Jerusalem.","poem":2},{"text":"Na em i save stap oltaim","poem":1},{"text":"long maunten Saion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Long dispela ples em i brukim","poem":1},{"text":"ol spia na hap plang","poem":2},{"text":"na ol bainat bilong ol birua.","poem":3},{"text":"God i bagarapim pinis","poem":1},{"text":"olgeta samting bilong pait.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God, yu gat biknem","poem":1},{"text":"na yu nambawan king.","poem":2},{"text":"Yu antap moa","poem":1},{"text":"na biknem bilong yu","poem":2},{"text":"i winim tru biknem","poem":3},{"text":"bilong ol bikpela maunten.","poem":4},{"text":"Long ples maunten","poem":1},{"text":"yu bin pait long ol birua,","poem":3},{"text":"na yu winim ol","poem":2},{"text":"na yu kam bek pinis.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol i rausim ol gutpela samting","poem":1},{"text":"bilong ol strongpela soldia","poem":2},{"text":"bilong ol.","poem":3},{"text":"Na nau ol dispela soldia i dai pinis,","poem":1},{"text":"na i no gat man bilong kisim","poem":2},{"text":"ol samting bilong pait bilong ol.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"God bilong Jekop,","poem":1},{"text":"yu krosim ol pinis,","poem":3},{"text":"na ol hos wantaim ol man","poem":2},{"text":"i sindaun long ol hos,","poem":3},{"text":"olgeta i dai pinis,","poem":2},{"text":"na ol i slip i stap long graun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tasol God,","poem":1},{"text":"ol man i save pret moa long yu.","poem":2},{"text":"Sapos yu kros long ol,","poem":1},{"text":"bai husat inap sanap","poem":2},{"text":"long ai bilong yu?","poem":3},{"text":"I no gat wanpela inap.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yu stap long heven","poem":1},{"text":"na yu kotim olgeta manmeri.","poem":2},{"text":"Long dispela taim yu sanap","poem":1},{"text":"na yu toksave long ol man","poem":2},{"text":"long kot bilong ol,","poem":3},{"text":"na yu kam helpim ol manmeri","poem":2},{"text":"ol arapela man","poem":3},{"text":"i mekim nogut long ol.","poem":4},{"text":"Na olgeta manmeri i pret tumas","poem":1},{"text":"na i no gat tok.","poem":3},{"text":"Ol i pasim maus tasol.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ol man i save belhat,","poem":1},{"text":"tasol dispela i save mekim","poem":2},{"text":"ol arapela man","poem":3},{"text":"i litimapim nem bilong yu.","poem":4},{"text":"Na ol man i no bagarap long pait,","poem":1},{"text":"bai ol i lotu long yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yu mekim promis long God,","poem":1},{"text":"Bikpela bilong yu,","poem":3},{"text":"orait yu mas bihainim promis.","poem":2},{"text":"Yu no ken giaman.","poem":3},{"text":"Yumi mas pret long Bikpela,","poem":1},{"text":"olsem na olgeta manmeri","poem":2},{"text":"i mas bringim ol presen","poem":3},{"text":"i go long em.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Em i save daunim ol king i bikhet.","poem":1},{"text":"Em i save pretim tru","poem":2},{"text":"ol king bilong graun.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":11}