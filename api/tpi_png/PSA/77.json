{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":77,"content":[{"type":"heading","content":["Man i singaut long God long taim bilong hevi"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim Jedutun."]},{"type":"verse","number":1,"content":[{"text":"Mi singaut strong long God.","poem":1},{"text":"Mi laik bai em i harim beten","poem":2},{"text":"bilong mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Long taim bilong hevi","poem":1},{"text":"mi save prea long Bikpela.","poem":2},{"text":"Long olgeta nait","poem":1},{"text":"mi save prea long em,","poem":2},{"text":"tasol mi no kisim bel isi.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Mi tingting long God","poem":1},{"text":"na bel bilong mi i krai.","poem":2},{"text":"Mi tingting i stap","poem":1},{"text":"na bel bilong mi i hevi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God i no larim mi i slip.","poem":1},{"text":"Bel bilong mi i hevi tru,","poem":2},{"text":"olsem na mi no inap toktok.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mi tingting long guttaim","poem":1},{"text":"bilong bipo.","poem":2},{"text":"Tru tumas, mi tingim gen","poem":1},{"text":"ol dispela yia i go pinis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Long nait","poem":1},{"text":"mi wok long tingting i stap.","poem":2},{"text":"Mi tingting planti","poem":1},{"text":"na mi askim mi yet olsem,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"“Ating bai Bikpela","poem":2},{"text":"i givim baksait long mi oltaim?","poem":3},{"text":"Ating em i no moa laikim mi?","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Em i no laik sori long mi nau?","poem":2},{"text":"Promis bilong en","poem":3},{"text":"i pundaun pinis, a?","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Ating God i lusim tingting","poem":2},{"text":"na i no laik marimari","poem":3},{"text":"long mipela, a?","poem":4},{"text":"Ating kros bilong en","poem":2},{"text":"i pasim marimari?”","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mi tingting olsem na mi tok,","poem":1},{"text":"“God Antap Tru","poem":2},{"text":"i no laik helpim mi nau.","poem":3},{"text":"Olsem na mi bel hevi tru","poem":2},{"text":"long dispela samting.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"God, bai mi tingting gen","poem":1},{"text":"long ol bikpela wok bilong yu.","poem":2},{"text":"Yes, bai mi tingting bek","poem":1},{"text":"long ol kain kain bikpela samting","poem":2},{"text":"bipo yu bin mekim.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Bai mi tingting","poem":1},{"text":"long olgeta samting yu bin mekim.","poem":2},{"text":"Yu bin mekim ol strongpela wok,","poem":1},{"text":"na bai mi tingim dispela tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"God, olgeta pasin bilong yu","poem":1},{"text":"i gutpela na stretpela olgeta.","poem":2},{"text":"I no gat wanpela giaman god","poem":1},{"text":"inap wantaim yu.","poem":2},{"text":"Yu winim ol tru.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"God, yu wanpela tasol","poem":1},{"text":"yu save wokim ol mirakel.","poem":2},{"text":"Bipo yu bin soim","poem":1},{"text":"bikpela strong bilong yu","poem":2},{"text":"long olgeta lain manmeri.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Long strong bilong yu yet","poem":1},{"text":"yu kisim bek","poem":2},{"text":"ol manmeri bilong yu,","poem":3},{"text":"em ol lain tumbuna","poem":2},{"text":"bilong Jekop na Josep","poem":3},{"text":"i kamap bihain long tupela.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"God, bipo taim ol wara i lukim yu,","poem":1},{"text":"ol i pret,","poem":3},{"text":"na solwara daunbilo tru","poem":2},{"text":"i guria nabaut.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Bikpela ren tru i kam daun,","poem":1},{"text":"na klaut i pairap strong moa,","poem":3},{"text":"na lait bilong klaut","poem":2},{"text":"i sut i go i kam long olgeta hap.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Yu mekim klaut i pairap","poem":1},{"text":"namel long raunwin.","poem":2},{"text":"Lait bilong klaut i mekim","poem":1},{"text":"olgeta hap bilong graun i lait,","poem":2},{"text":"na graun yet i guria guria.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Yu bin wokabaut","poem":1},{"text":"namel long solwara.","poem":2},{"text":"Rot bilong yu i stap namel","poem":1},{"text":"long bikpela solwara.","poem":2},{"text":"Tasol mipela i no save lukim","poem":1},{"text":"mak bilong lek bilong yu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yu olsem wasman tru,","poem":1},{"text":"na yu go pas,","poem":2},{"text":"na ol manmeri i bihainim yu.","poem":3},{"text":"Yu givim wok","poem":1},{"text":"long Moses wantaim Aron,","poem":2},{"text":"na tupela i bosim ol.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}