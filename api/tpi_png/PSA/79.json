{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":79,"content":[{"type":"heading","content":["Ol Israel i beten bilong God i helpim ol"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"God, ol arapela lain","poem":1},{"text":"i kam pinis","poem":2},{"text":"long graun bilong mipela,","poem":3},{"text":"na ol i pait long mipela","poem":2},{"text":"ol manmeri bilong yu.","poem":3},{"text":"Ol i bin mekim nogut","poem":1},{"text":"long dispela haus","poem":2},{"text":"yu bin makim bilong yu yet,","poem":3},{"text":"na haus i kamap doti olgeta.","poem":2},{"text":"Na ol i bagarapim Jerusalem","poem":1},{"text":"nogut tru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ol i kilim ol manmeri","poem":1},{"text":"na ol wokman bilong yu,","poem":3},{"text":"na ol pisin wantaim ol wel abus","poem":2},{"text":"i kaikai bodi bilong ol.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ol birua i kilim i dai","poem":1},{"text":"ol manmeri bilong yu,","poem":3},{"text":"na blut bilong ol i kapsait","poem":2},{"text":"na i ran olsem wara","poem":3},{"text":"insait long Jerusalem.","poem":4},{"text":"Na i no gat wanpela man i stap","poem":1},{"text":"bilong planim bodi bilong ol.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ol lain manmeri","poem":1},{"text":"i stap klostu long mipela","poem":3},{"text":"ol i tok bilas na lap","poem":2},{"text":"na tok nogut long mipela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bikpela, hamas taim yet","poem":1},{"text":"bai yu kros long mipela?","poem":3},{"text":"Ating bai yu kros oltaim, a?","poem":2},{"text":"Bai kros bilong yu i stap","poem":1},{"text":"olsem paia i lait","poem":2},{"text":"na i no inap i dai, a?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mobeta yu kros","poem":1},{"text":"long ol lain manmeri","poem":2},{"text":"i no save lotu long yu,","poem":3},{"text":"em ol dispela manmeri","poem":2},{"text":"i givim baksait long yu.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ol dispela lain i bin kilim i dai","poem":1},{"text":"ol manmeri bilong mipela,","poem":3},{"text":"na ol i bagarapim tru","poem":2},{"text":"graun bilong mipela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nogut yu mekim save long mipela","poem":1},{"text":"long ol pasin nogut","poem":2},{"text":"ol tumbuna bilong mipela","poem":3},{"text":"i bin mekim.","poem":4},{"text":"Nau yu mas marimari long mipela,","poem":1},{"text":"long wanem, bilip bilong mipela","poem":2},{"text":"i slek pinis.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"God, yu God","poem":1},{"text":"bilong kisim bek mipela.","poem":2},{"text":"Tingting long biknem bilong yu","poem":1},{"text":"na helpim mipela.","poem":2},{"text":"Kisim bek mipela","poem":1},{"text":"na rausim olgeta sin","poem":2},{"text":"bilong mipela,","poem":3},{"text":"na bai mipela i litimapim","poem":2},{"text":"nem bilong yu.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Bilong wanem ol arapela lain","poem":1},{"text":"i save askim mipela olsem,","poem":3},{"text":"“We stap God bilong yupela?”","poem":2},{"text":"Mipela i laik lukim yu","poem":1},{"text":"i mekim save long ol arapela lain","poem":2},{"text":"bilong bekim blut bilong mipela,","poem":3},{"text":"long wanem, ol i kilim i dai","poem":2},{"text":"ol wokman bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yu harim krai bilong ol kalabusman.","poem":1},{"text":"Na long bikpela strong bilong yu,","poem":2},{"text":"yu mas kisim bek ol man","poem":3},{"text":"ol birua i tok pinis","poem":2},{"text":"bai ol i mas i dai.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol dispela birua","poem":1},{"text":"i bin tok nogut long yu.","poem":2},{"text":"Olsem na Bikpela, yu mas bekim","poem":1},{"text":"pasin nogut bilong ol","poem":2},{"text":"inap 7-pela taim.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Yu mekim olsem,","poem":1},{"text":"orait mipela","poem":2},{"text":"ol manmeri bilong yu,","poem":3},{"text":"mipela i olsem ol sipsip bilong yu,","poem":2},{"text":"bai mipela i tenkyu long yu","poem":3},{"text":"oltaim oltaim.","poem":4},{"text":"Na ol lain tumbuna i kamap bihain,","poem":1},{"text":"bai ol tu i litimapim","poem":2},{"text":"nem bilong yu.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}