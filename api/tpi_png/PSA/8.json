"poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Taim mi lukim skai yu bin wokim,","poem":1},{"text":"na taim mi lukim mun","poem":2},{"text":"na olgeta sta","poem":4},{"text":"yu bin putim i stap antap,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"mi save ting olsem.","poem":2},{"text":"Mipela man i wanem samting","poem":1},{"text":"na yu save tingting long mipela?","poem":2},{"text":"Mipela i samting nating.","poem":1},{"lineBreak":true},{"text":"Bilong wanem yu save was gut","poem":1},{"text":"long mipela?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yu bin wokim mipela","poem":1},{"text":"na yu putim mipela","poem":2},{"text":"i stap aninit long yu wanpela tasol.","poem":3},{"text":"Yu bin litimapim mipela","poem":1},{"text":"na givim mipela","poem":2},{"text":"biknem na namba.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yu bin makim mipela bilong bosim","poem":1},{"text":"olgeta samting yu bin wokim.","poem":2},{"text":"Yu putim olgeta samting","poem":1},{"text":"i stap aninit long mipela man.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yes, olgeta sipsip na bulmakau","poem":1},{"text":"na olgeta abus i stap long bus,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"na olgeta pisin i flai antap,","poem":2},{"lineBreak":true},{"text":"na olgeta pis bilong solwara,","poem":2},{"lineBreak":true},{"text":"na olgeta samting i save raun","poem":2},{"text":"insait long solwara,","poem":3},{"text":"olgeta i stap aninit long mipela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"God, yu Bikpela bilong mipela.","poem":1},{"lineBreak":true},{"text":"Long olgeta hap bilong graun","poem":1},{"text":"nem bilong yu i nambawan tru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/9.json","nextChapterAudioLinks":{},"previousChapterA