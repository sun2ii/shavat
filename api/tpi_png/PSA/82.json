oem":2},{"text":"na i no i stap gut,","poem":3},{"text":"yupela i mas mekim gut long ol.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ol manmeri i stap nogut","poem":2},{"text":"na i sot long ol samting,","poem":3},{"text":"yupela i mas kisim bek ol","poem":2},{"text":"long han bilong ol man nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Yupela i no gat save,","poem":2},{"text":"na yupela i longlong tru.","poem":3},{"text":"Yupela i save wokabaut","poem":2},{"text":"long tudak,","poem":4},{"text":"olsem na ol manmeri","poem":2},{"text":"i no save bihainim","poem":3},{"text":"stretpela pasin.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Mi tok olsem, ‘Yupela i god.","poem":2},{"text":"Yupela i pikinini","poem":3},{"text":"bilong God Antap Tru.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Tasol bai yupela i dai","poem":2},{"text":"wankain olsem ol man","poem":3},{"text":"i save dai.","poem":4},{"text":"Bai laip bilong yupela i pinis,","poem":2},{"text":"olsem laip","poem":3},{"text":"bilong ol pikinini bilong king i save pinis.’”","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"God, yu mas kam na bosim","poem":1},{"text":"olgeta manmeri bilong graun.","poem":2},{"text":"Olgeta lain manmeri i bilong yu tasol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}