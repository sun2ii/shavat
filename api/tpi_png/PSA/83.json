{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":83,"content":[{"type":"heading","content":["Man i prea bai God i pinisim olgeta birua bilong Israel"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song, em song bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"God, yu no ken pasim maus.","poem":1},{"text":"Yu no ken sindaun nating.","poem":2},{"text":"God, yu no ken i stap nating.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Lukim. Ol birua bilong yu","poem":2},{"text":"i kirapim pait.","poem":3},{"text":"Ol man i no laikim yu","poem":1},{"text":"ol i bikhet long yu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ol i hait na pasim tok","poem":1},{"text":"bilong mekim nogut","poem":2},{"text":"long ol manmeri bilong yu.","poem":3},{"text":"Yu save lukautim gut","poem":1},{"text":"ol dispela manmeri,","poem":3},{"text":"tasol ol birua i kibung","poem":2},{"text":"bilong bagarapim ol.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol i tok olsem, “Goan,","poem":1},{"text":"yumi pinisim tru ol Israel,","poem":3},{"text":"bai ol manmeri i no inap","poem":2},{"text":"tingting moa long ol.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol i wanbel","poem":1},{"text":"long mekim dispela samting.","poem":2},{"text":"Na ol i poroman wantaim","poem":1},{"text":"bilong daunim yu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol dispela lain i laik mekim olsem,","poem":1},{"text":"em ol Idom na ol Ismael","poem":2},{"text":"na ol Moap na ol Hakri","poem":3}]},{"type":"verse","number":7,"content":[{"text":"na ol Gebal na ol Amon","poem":2},{"text":"na ol Amalek.","poem":3},{"text":"Ol dispela lain i stap","poem":1},{"text":"long hap bilong kantri Filistia","poem":2},{"text":"na taun Tair.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ol Siria tu i bung wantaim ol.","poem":2},{"text":"Dispela strongpela lain i helpim","poem":1},{"text":"ol lain tumbuna bilong Lot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yu mas mekim wankain pasin","poem":1},{"text":"long ol,","poem":3},{"text":"olsem bipo yu bin mekim","poem":2},{"text":"long ol Midian,","poem":3},{"text":"na long Sisera na Jabin","poem":2},{"text":"long bikpela wara Kison.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Long dispela taim yu bagarapim ol","poem":1},{"text":"long taun Endor","poem":3},{"text":"na bodi bilong ol","poem":2},{"text":"i stap nabaut long graun","poem":3},{"text":"na i sting.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yu mas mekim save long ol kepten","poem":1},{"text":"bilong ami bilong ol,","poem":3},{"text":"olsem bipo yu bin mekim","poem":2},{"text":"long Orep na Sep.","poem":3},{"text":"Daunim ol hetman bilong ol,","poem":1},{"text":"olsem yu bin mekim","poem":2},{"text":"long Seba na Salmuna.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol dispela man i bin tok,","poem":1},{"text":"“Yumi mas kisim","poem":2},{"text":"dispela graun bilong God,","poem":3},{"text":"bai em i kamap graun","poem":2},{"text":"bilong yumi tasol.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"God bilong mi,","poem":1},{"text":"yu ken rausim ol i go nabaut","poem":2},{"text":"olsem das bilong graun.","poem":3},{"text":"Rausim ol,","poem":1},{"text":"olsem win i rausim skin rais","poem":2},{"text":"i go nabaut.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Paia i save kukim kunai,","poem":1},{"text":"na maunten i gat kunai","poem":2},{"text":"i save paia bikpela.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Olsem tasol yu mas salim","poem":1},{"text":"bikpela ren","poem":3},{"text":"na ranim ol dispela lain","poem":2},{"text":"bai ol i ranawe.","poem":3},{"text":"Na yu mas salim strongpela win tru","poem":1},{"text":"i go long ol bai ol i pret.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bikpela, daunim ol tru","poem":1},{"text":"na bai ol i sem nogut","poem":2},{"text":"na bai ol i laik bihainim yu.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Mi laik bai yu winim ol","poem":1},{"text":"na bai ol i pret nogut oltaim.","poem":3},{"text":"Mekim ol i sem na kilim ol i dai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mi laik bai yu mekim olsem,","poem":1},{"text":"na bai ol i ken save tru,","poem":3},{"text":"yu wanpela tasol, yu Bikpela,","poem":2},{"text":"na yu God Antap Tru,","poem":3},{"text":"na yu save bosim","poem":2},{"text":"olgeta hap bilong graun.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}