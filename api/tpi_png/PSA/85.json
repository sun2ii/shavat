{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":85,"content":[{"type":"heading","content":["Man i prea bai God i lukautim ol lain bilong en"]},{"type":"hebrew_subtitle","content":["Dispela song em song bilong ol lain Kora. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu bin mekim gut","poem":1},{"text":"long graun bilong yu.","poem":2},{"text":"Yu helpim mipela Israel gen","poem":1},{"text":"na mipela i stap gut tru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu bin rausim sin","poem":1},{"text":"bilong mipela","poem":2},{"text":"ol manmeri bilong yu","poem":3},{"text":"na yu lusim ol rong","poem":2},{"text":"mipela i bin mekim.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Bipo yu kros long mipela,","poem":1},{"text":"tasol nau yu no kros moa.","poem":2},{"text":"Tru, yu bin belhat long mipela,","poem":1},{"text":"tasol nau nogat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God, yu God","poem":1},{"text":"bilong kisim bek mipela.","poem":2},{"text":"Nau yu ken bringim mipela","poem":1},{"text":"i kam bek long yu.","poem":2},{"text":"Plis, yu no ken kros moa","poem":1},{"text":"long mipela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olsem wanem, bai yu kros oltaim","poem":1},{"text":"long mipela?","poem":3},{"text":"Bai kros bilong yu i no inap pinis, a?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Strongim laip bilong mipela gen,","poem":1},{"text":"bai mipela ol manmeri bilong yu","poem":2},{"text":"i ken amamas","poem":3},{"text":"na litimapim nem bilong yu.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Bikpela, soim mipela olsem","poem":1},{"text":"yu laikim mipela oltaim,","poem":3},{"text":"na kisim bek mipela","poem":2},{"text":"bai mipela i stap gut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mi putim yau long tok","poem":1},{"text":"God, Bikpela i autim.","poem":2},{"text":"Em i tok long givim bel isi","poem":1},{"text":"na gutpela sindaun long mipela,","poem":3},{"text":"sapos mipela i no i go bek","poem":2},{"text":"long pasin nogut","poem":3},{"text":"bipo mipela i mekim.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Tru tumas, em i redi pinis","poem":1},{"text":"long kisim bek ol manmeri","poem":2},{"text":"i save lotu long em","poem":3},{"text":"na i bihainim laik bilong en.","poem":4},{"text":"Na em bai i kisim bek mipela","poem":1},{"text":"na bai em yet i stap wantaim mipela","poem":2},{"text":"long graun bilong mipela.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Long dispela taim bai ol manmeri","poem":1},{"text":"i laikim tru ol arapela","poem":2},{"text":"na mekim gutpela pasin long ol.","poem":3},{"text":"Na bai ol i stap stret na bel isi","poem":1},{"text":"na sindaun gut wantaim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Long graun bai ol manmeri","poem":1},{"text":"i bihainim tru Bikpela,","poem":3},{"text":"na God long heven","poem":2},{"text":"bai i mekim ol i kamap stretpela.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Bikpela bai i helpim mipela","poem":1},{"text":"long sindaun gut","poem":3},{"text":"na ol samting mipela i mekim","poem":2},{"text":"bai i kamap gutpela.","poem":3},{"text":"Na graun bilong mipela","poem":1},{"text":"bai i karim planti kaikai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bikpela bai i mekim ol manmeri","poem":1},{"text":"i bihainim stretpela pasin","poem":3},{"text":"na dispela bai i redim rot","poem":2},{"text":"bilong em i kam.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}