{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":88,"content":[{"type":"heading","content":["Man i singaut long God i helpim em"]},{"type":"hebrew_subtitle","content":["Heman bilong lain Sera i raitim dispela song, em kain song ol i kolim Maskil. Em i song bilong lotu bilong ol lain Kora. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim Mahalat Leanot."]},{"type":"verse","number":1,"content":[{"text":"God, Bikpela,","poem":1},{"text":"yu helpim bilong mi.","poem":2},{"text":"Long san mi save singaut long yu","poem":1},{"text":"bai yu helpim mi,","poem":3},{"text":"na long tudak tu","poem":2},{"text":"mi save prea long yu.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Harim beten bilong mi.","poem":1},{"text":"Harim mi i singaut","poem":2},{"text":"long yu helpim mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Planti hevi i kamap long mi","poem":1},{"text":"na long dispela as tasol","poem":2},{"text":"klostu mi laik i dai.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi wankain olsem ol arapela man","poem":1},{"text":"i laik i dai.","poem":3},{"text":"Olgeta strong bilong mi i pinis tru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol i lusim mi","poem":1},{"text":"na mi stap wantaim","poem":2},{"text":"ol man i dai pinis.","poem":3},{"text":"Mi olsem man","poem":1},{"text":"narapela man i kilim i dai pinis","poem":2},{"text":"na i stap long matmat.","poem":3},{"text":"Mi olsem ol man","poem":1},{"text":"yu lusim tingting olgeta long ol,","poem":2},{"text":"na i no inap yu helpim ol moa.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yu tromoi mi pinis i go","poem":1},{"text":"long as bilong hul i daun tru,","poem":3},{"text":"na mi stap long ples i tudak olgeta","poem":2},{"text":"na i daunbilo tru.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Belhat bilong yu i daunim mi olgeta,","poem":1},{"text":"na i olsem biksi","poem":2},{"text":"i karamapim mi tru.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yu bin mekim ol pren bilong mi","poem":1},{"text":"i givim baksait long mi.","poem":2},{"text":"Yu mekim mi i kamap nogut tru","poem":1},{"text":"na ol i pret tumas long mi.","poem":2},{"text":"Dispela i kalabusim mi","poem":1},{"text":"na mi no inap lusim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mi karim pen","poem":1},{"text":"na ai bilong mi i bagarap","poem":2},{"text":"na mi no inap lukluk gut.","poem":3},{"text":"Na long olgeta de","poem":1},{"text":"mi save beten long yu","poem":2},{"text":"bai yu helpim mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yu save wokim ol mirakel","poem":1},{"text":"bilong helpim ol man","poem":2},{"text":"i dai pinis, a?","poem":3},{"text":"Ating ol man i dai pinis","poem":1},{"text":"i save kirap bek","poem":2},{"text":"na litimapim nem bilong yu?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol lain i slip pinis long matmat,","poem":1},{"text":"ol i save toktok","poem":2},{"text":"long yu laikim ol tumas,","poem":3},{"text":"o nogat?","poem":4},{"text":"Long ples bilong bagarap","poem":1},{"text":"ol i save tok","poem":2},{"text":"long yu bin lukautim ol gut, a?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ating ol man i stap long matmat","poem":1},{"text":"ol i lukim ol mirakel bilong yu?","poem":2},{"text":"Na ol man i stap","poem":1},{"text":"long ples bilong bagarap,","poem":3},{"text":"ol i save lukim","poem":2},{"text":"gutpela pasin bilong yu, a?","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bikpela, mi save singaut long yu","poem":1},{"text":"bilong yu helpim mi.","poem":2},{"text":"Long olgeta moning","poem":1},{"text":"mi save beten long yu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tasol Bikpela, bilong wanem","poem":1},{"text":"yu givim baksait long mi?","poem":3},{"text":"Bilong wanem yu hait long mi?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taim mi yangpela yet","poem":1},{"text":"i kam inap nau,","poem":3},{"text":"mi bin karim pen","poem":2},{"text":"na klostu mi laik i dai.","poem":3},{"text":"Yu mekim save long mi","poem":1},{"text":"na dispela i mekim","poem":2},{"text":"bun bilong mi i slek.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Bikpela belhat bilong yu","poem":1},{"text":"i karamapim mi.","poem":2},{"text":"Yu paitim mi nogut tru","poem":1},{"text":"na bagarapim mi olgeta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yu mekim olsem long mi","poem":1},{"text":"long san na long nait wantaim,","poem":3},{"text":"na ol man i raunim mi","poem":2},{"text":"long olgeta hap","poem":3},{"text":"olsem wara i tait","poem":2},{"lineBreak":true},{"text":"na i karamapim olgeta hap graun.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yu mekim ol gutpela pren bilong mi","poem":1},{"text":"i lusim mi.","poem":2},{"text":"Tudak tasol i stap pren bilong mi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}