"text":"Bai mi mekim graun bilong en","poem":2},{"text":"i stat","poem":3},{"text":"long biksolwara Mediterenian","poem":4},{"text":"na i go inap","poem":3},{"text":"long bikpela wara Yufretis.","poem":4}]},{"type":"verse","number":26,"content":[{"text":"Na em bai i tokim mi olsem,","poem":2},{"text":"‘Yu Papa na God bilong mi.","poem":3},{"text":"Yu save lukautim mi","poem":2},{"text":"na helpim mi oltaim.’","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Orait bai mi makim em i kamap","poem":2},{"text":"nambawan pikinini bilong mi,","poem":3},{"text":"na bai em","poem":2},{"text":"i kamap nambawan king","poem":3},{"text":"i winim olgeta king long graun.","poem":4}]},{"type":"verse","number":28,"content":[{"text":"Bai mi laikim em tumas oltaim.","poem":3},{"text":"Na bai mi mekim kontrak","poem":2},{"text":"wantaim em","poem":3},{"text":"na dispela kontrak","poem":2},{"text":"bai i stap oltaim oltaim.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Oltaim wanpela man","poem":2},{"text":"long lain bilong en","poem":3},{"text":"bai i stap king.","poem":4},{"text":"Na wanpela king","poem":2},{"text":"bilong lain bilong en","poem":3},{"text":"bai i bosim ol Israel oltaim,","poem":2},{"text":"olsem skai antap i stap oltaim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Tasol sapos ol lain tumbuna","poem":2},{"text":"bilong en","poem":3},{"text":"i sakim lo bilong mi,","poem":4},{"text":"na ol i no bihainim","poem":2},{"text":"pasin bilong mi,","poem":3}]},{"type":"verse","number":31,"content":[{"text":"na sapos ol i givim baksait","poem":2},{"text":"long tok bilong mi","poem":4},{"text":"na ol i no bihainim lo bilong mi,","poem":3}]},{"type":"verse","number":32,"content":[{"text":"orait bai mi tingim sin bilong ol","poem":2},{"text":"na mekim save long ol.","poem":3},{"text":"Na bai mi tingim rong","poem":2},{"text":"ol i bin mekim","poem":3},{"text":"na bai mi givim kanda long ol.","poem":2}]},{"type":"vers