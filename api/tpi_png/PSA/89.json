ext":"na bagarapim olgeta.","poem":3},{"text":"Na long bikpela strong bilong yu,","poem":1},{"text":"yu winim ol birua bilong yu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Heven na graun i bilong yu tasol.","poem":1},{"text":"Yu bin wokim graun","poem":2},{"text":"na olgeta samting i stap long en.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu bin wokim hap bilong not","poem":1},{"text":"na hap bilong saut wantaim.","poem":2},{"text":"Maunten Tabor","poem":1},{"text":"na maunten Hermon","poem":2},{"text":"i amamas na singim song long yu.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Yu gat bikpela strong tumas.","poem":1},{"text":"Strong bilong yu i moa yet.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yu stap king","poem":1},{"text":"na yu bosim ol manmeri","poem":2},{"text":"long stretpela pasin tasol.","poem":3},{"text":"Na yu save mekim","poem":1},{"text":"stretpela kot tasol.","poem":2},{"text":"Yu save laikim tru olgeta manmeri","poem":1},{"text":"na yu save bihainim","poem":2},{"text":"tok bilong yu oltaim","poem":3},{"text":"na yu no save senis nabaut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ol manmeri i save mekim song","poem":1},{"text":"na lotu long yu,","poem":3},{"text":"na i save wokabaut","poem":2},{"text":"long marimari bilong yu","poem":3},{"text":"olsem ol i wokabaut long lait,","poem":4},{"text":"ol i ken amamas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ol i save tingting long gutpela pasin","poem":1},{"text":"yu bin mekim long ol,","poem":3},{"text":"na olgeta de long san na long nait","poem":2},{"text":"ol i save amamas","poem":3},{"text":"na litimapim nem bilong yu.","poem":4}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yu tasol yu strong bilong mipela","poem":1},{"text":"na mipela i amamas moa long yu.","poem":2},{"text":"Yu save marimari long mipela","poem":1},{"text":"na helpim mipela i