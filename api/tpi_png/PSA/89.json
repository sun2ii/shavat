bin mekim","poem":2},{"text":"wantaim wokman bilong yu.","poem":3},{"text":"Yu tromoi hat king bilong en","poem":1},{"text":"i go long graun","poem":3},{"text":"na em i doti.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yu brukim pinis","poem":1},{"text":"ol banis bilong taun bilong en,","poem":3},{"text":"na ol strongpela haus bilong en","poem":2},{"text":"i bagarap pinis.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Olgeta manmeri i wokabaut klostu","poem":1},{"text":"ol i save stilim","poem":2},{"text":"ol samting bilong en.","poem":3},{"text":"Na ol wantok i tok bilas long em.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Yu bin larim ol birua","poem":1},{"text":"i winim em long pait,","poem":3},{"text":"na yu mekim bel bilong ol","poem":2},{"text":"i amamas tru.","poem":3}]},{"type":"verse","number":43,"content":[{"text":"Yu mekim ol soldia bilong en","poem":1},{"text":"i no strong long pait,","poem":3},{"text":"na yu larim em i lus long pait.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Yu daunim em","poem":1},{"text":"na em i no i stap king moa,","poem":2},{"text":"na em i no moa bosim ol manmeri.","poem":3}]},{"type":"verse","number":45,"content":[{"text":"Yu mekim em i kamap lapun","poem":1},{"text":"kwiktaim tumas,","poem":3},{"text":"na bikpela sem tru","poem":2},{"text":"i karamapim em.","poem":3}]},{"type":"heading","content":["Ol i beten long God i helpim ol"]},{"type":"verse","number":46,"content":[{"text":"Bikpela, hamas taim yet bai yu hait?","poem":1},{"text":"Inap oltaim, a?","poem":2},{"text":"Hamas taim bai belhat bilong yu","poem":1},{"text":"i hat tru olsem paia?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bikpela, plis yu mas tingim","poem":1},{"text":"mipela man","poem":2},{"text":"i save stap sotpela taim tasol.","poem":3},{"text":"Yu bin wokim mipela,","poem":1},{"text":"tasol mipela olgeta i mas i dai","poem":2},{"text":"na pinis nating.","poem":3}]},{"type":"verse","number":48,"content":[{"text":"Husat bai i stap oltaim oltaim","poem":1},{"text":"na i no inap i dai?","poem":2},{"text":"Husat inap i stap strong","poem":1},{"text":"bai em i no inap i go long matmat?","poem":2},{"text":"I no gat wanpela man. Nogat tru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Bikpela, olsem wanem?","poem":1},{"text":"Yu no laikim mipela nau, a?","poem":2},{"text":"Olsem wanem long ol promis","poem":1},{"text":"yu bin mekim wantaim mi, Devit?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bikpela, yu mas tingting long mi,","poem":1},{"text":"wokman bilong yu.","poem":3},{"text":"Ol man i tok bilas long mi.","poem":2},{"text":"Mi save karim hevi bilong tok nogut","poem":1},{"text":"bilong ol arapela lain.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Bikpela, yu bin makim mi","poem":1},{"text":"olsem king,","poem":3},{"text":"tasol ol birua","poem":2},{"text":"i save tok nogut long mi.","poem":3},{"text":"Long olgeta hap mi go long en","poem":1},{"text":"ol i save tok nogut long mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Yumi mas litimapim nem","poem":1},{"text":"bilong Bikpela oltaim oltaim.","poem":2},{"text":"I tru tumas.","poem":1}]},{"type":"heading","content":["(Song 90-106)"]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}