{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":90,"content":[{"type":"heading","content":["Toktok bilong God na man"]},{"type":"hebrew_subtitle","content":["Dispela song em i beten bilong Moses, dispela man bilong God."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu olsem haus tru","poem":1},{"text":"bilong mipela.","poem":2},{"text":"Ol tumbuna i bin i stap long yu,","poem":1},{"text":"na nau mipela tu i stap olsem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oltaim oltaim yu stap God,","poem":1},{"text":"long bipo na long bihain tu.","poem":2},{"text":"Olgeta maunten i no kamap yet,","poem":1},{"text":"na yu no bin wokim","poem":2},{"text":"olgeta samting bilong graun yet,","poem":3},{"text":"tasol yu stap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yu save mekim ol manmeri i dai","poem":1},{"text":"na ol i kamap graun gen.","poem":2},{"text":"Na yu tok olsem,","poem":1},{"text":"“Yupela manmeri bilong graun,","poem":2},{"text":"yupela i mas i dai","poem":3},{"text":"na tanim graun gen.”","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Long tingting bilong yu","poem":1},{"text":"1,000 yia i olsem wanpela de tasol,","poem":3},{"text":"na dispela taim i go pinis","poem":2},{"text":"kwiktaim tumas,","poem":3},{"text":"olsem asde tasol.","poem":2},{"text":"Na em i olsem sotpela taim","poem":1},{"text":"ol soldia i save stap sentri","poem":2},{"text":"long nait.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Yu save rausim ol man,","poem":1},{"text":"olsem wara i tait","poem":2},{"text":"na i kisim ol man na ol i dai.","poem":3},{"text":"Ol i stap sotpela taim","poem":1},{"text":"olsem driman tasol.","poem":2},{"text":"Ol i olsem gras i save kamap nupela","poem":1},{"text":"long moningtaim,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"na i kamap bikpela","poem":2},{"text":"na plaua i kamap.","poem":3},{"text":"Tasol long apinun em i drai olgeta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yu gat kros long mipela,","poem":1},{"text":"olsem na yu save bagarapim mipela.","poem":2},{"text":"Yu belhat long mipela,","poem":1},{"text":"olsem na mipela i pret nogut tru.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yu save lukim olgeta pasin nogut","poem":1},{"text":"bilong mipela.","poem":2},{"text":"Na olgeta sin","poem":1},{"text":"mipela i hait na mekim,","poem":3},{"text":"em yu putim ples klia","poem":2},{"text":"na yu lukim pinis.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kros bilong yu i save sotim taim","poem":1},{"text":"bilong mipela i stap long graun.","poem":2},{"text":"Tru tumas, taim bilong mipela","poem":1},{"text":"i save pinis kwik,","poem":3},{"text":"olsem mipela i pulim win","poem":2},{"text":"wanpela taim tasol.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mipela i save stap inap 70 yia tasol.","poem":1},{"text":"Na sapos mipela i gat strong,","poem":2},{"text":"mipela i ken i stap inap 80 yia.","poem":3},{"text":"Tasol long dispela olgeta yia","poem":1},{"text":"mipela i stap,","poem":3},{"text":"mipela i save hatwok","poem":2},{"text":"na painim hevi tasol.","poem":3},{"text":"Dispela olgeta yia i pinis kwiktaim,","poem":1},{"text":"na mipela tu i go pinis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Husat i save gut","poem":1},{"text":"long bikpela strong","poem":2},{"text":"bilong kros bilong yu?","poem":3},{"text":"Na husat i save long bikpela pret","poem":1},{"text":"i kamap long ol manmeri","poem":2},{"text":"taim yu kros long ol?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu skulim mipela gut","poem":1},{"text":"bai mipela i ken save olsem","poem":2},{"text":"mipela i no inap i stap","poem":3},{"text":"longpela taim long graun.","poem":4},{"text":"Olsem na bai mipela","poem":1},{"text":"i gat gutpela save tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bikpela, hamas taim yet","poem":1},{"text":"bai belhat bilong yu i stap?","poem":2},{"text":"Yu mas sori long mipela","poem":1},{"text":"ol wokman bilong yu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yu save laikim mipela oltaim,","poem":1},{"text":"na dispela i ken pulapim mipela","poem":2},{"text":"long olgeta moningtaim.","poem":3},{"text":"Olsem na long olgeta taim","poem":1},{"text":"mipela i stap laip","poem":2},{"text":"mipela i ken amamas na belgut.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Pastaim yu givim hevi long mipela.","poem":1},{"lineBreak":true},{"text":"Tasol nau yu ken mekim mipela","poem":1},{"text":"i amamas","poem":3},{"text":"bilong inapim ol dispela taim","poem":2},{"text":"mipela i karim hevi.","poem":3},{"text":"Planti yia mipela i stap nogut,","poem":1},{"text":"olsem na nau","poem":2},{"text":"yu ken givim amamas","poem":3},{"text":"long mipela","poem":4},{"text":"inap olsem olgeta yia nogut.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yu ken soim","poem":1},{"text":"ol strongpela wok bilong yu","poem":2},{"text":"long mipela ol wokman bilong yu.","poem":3},{"text":"Yu ken soim","poem":1},{"text":"gutpela gutpela strong bilong yu","poem":2},{"text":"long ol tumbuna pikinini","poem":3},{"text":"bilong mipela.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Bikpela, yu God bilong mipela,","poem":1},{"text":"mipela i laik bai yu marimari","poem":2},{"text":"long mipela","poem":3},{"text":"na mekim gut long mipela.","poem":2},{"text":"Na olgeta samting mipela i mekim","poem":1},{"text":"i ken kamap gutpela.","poem":2},{"text":"Tru tumas, yu ken strongim","poem":1},{"text":"olgeta samting mipela i mekim","poem":2},{"text":"na em bai i stap gut.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}