{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":92,"content":[{"type":"heading","content":["Song bilong litimapim nem bilong God"]},{"type":"hebrew_subtitle","content":["Dispela song em song bilong lotu, bilong singim long de Sabat."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu God Antap Tru,","poem":1},{"text":"i gutpela sapos","poem":2},{"text":"mi tenkyu long yu","poem":3},{"text":"na mekim ol song","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Na long olgeta moningtaim","poem":1},{"text":"i gutpela sapos mi tokaut","poem":2},{"text":"long yu laikim mi tumas,","poem":3},{"text":"na long olgeta nait mi tokaut","poem":2},{"text":"long yu bin lukautim mi gut.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Mi ken mekim gutpela musik","poem":1},{"text":"long gita samting","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi tingting","poem":1},{"text":"long strongpela wok bilong yu,","poem":3},{"text":"na mi belgut tru","poem":2},{"text":"na mi singim song bilong amamas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bikpela, yu save mekim","poem":1},{"text":"bikpela wok tumas.","poem":3},{"text":"Tingting bilong yu i bikpela tru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol man i no gat tingting","poem":1},{"text":"na ol longlong man,","poem":3},{"text":"ol i no inap save","poem":2},{"text":"long ol dispela samting hia.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ol man nogut i ken kamap gutpela","poem":1},{"text":"olsem gras,","poem":3},{"text":"na ol man i save mekim","poem":2},{"text":"pasin nogut,","poem":3},{"text":"ol i ken kisim planti samting,","poem":2},{"text":"na ol i ken i stap gut,","poem":3},{"text":"tasol bai yu bagarapim ol olgeta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Long wanem, Bikpela,","poem":1},{"text":"yu yet yu stap king oltaim oltaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mipela i save, ol man i birua long yu","poem":1},{"text":"bai ol i dai,","poem":3},{"text":"na bai yu daunim ol man","poem":2},{"text":"i save mekim samting nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yu bin givim bikpela strong long mi,","poem":1},{"text":"olsem strong","poem":2},{"text":"bilong wel bulmakau man.","poem":3},{"text":"Yu mekim gut long mi","poem":1},{"text":"na mi amamas tru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mi lukim pinis","poem":1},{"text":"ol birua bilong mi i bagarap,","poem":3},{"text":"na mi harim krai","poem":2},{"text":"bilong ol man nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ol stretpela manmeri","poem":1},{"text":"bai i kamap gutpela tru","poem":3},{"text":"olsem diwai","poem":2},{"text":"i karim gutpela kaikai,","poem":3},{"text":"na i kamap bikpela","poem":2},{"text":"olsem ol diwai sida","poem":3},{"text":"bilong Lebanon.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Ol i olsem ol diwai ol i planim pinis","poem":1},{"text":"long haus bilong Bikpela.","poem":2},{"text":"Ol i save kamap gutpela tru","poem":1},{"text":"insait long haus","poem":2},{"text":"bilong God bilong yumi.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Taim ol i olpela pinis,","poem":1},{"text":"ol i save karim kaikai yet.","poem":2},{"text":"Ol i stap strong, na ol i no save drai.","poem":1},{"text":"Lip bilong ol i stap grin oltaim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Long dispela pasin","poem":1},{"text":"ol i soim ol manmeri olsem,","poem":3},{"text":"Bikpela em i stretpela olgeta.","poem":2},{"text":"Em i save strong long helpim mi,","poem":1},{"text":"na i no gat rong long em.","poem":2},{"text":"Nogat tru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}