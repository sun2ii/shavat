t":"Bikpela, long bikpela strong","poem":1},{"text":"bilong yu,","poem":3},{"text":"yu bosim olgeta samting","poem":2},{"text":"long heven.","poem":3},{"text":"Strong bilong pairap bilong solwara","poem":1},{"text":"em i liklik tasol.","poem":2},{"text":"Tasol strong bilong yu","poem":1},{"text":"em i bikpela tru.","poem":2},{"text":"Biksi i save bruk","poem":1},{"text":"na pairap strong long nambis,","poem":3},{"text":"tasol strong bilong biksi","poem":2},{"text":"em i no inap","poem":3},{"text":"wantaim strong bilong yu.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olgeta lo bilong yu","poem":1},{"text":"i stap oltaim oltaim.","poem":2},{"text":"Tru tumas, Bikpela,","poem":1},{"text":"haus bilong yu i stap holi oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}