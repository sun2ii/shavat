{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":94,"content":[{"type":"heading","content":["God bai i daunim olgeta man nogut na i helpim olgeta stretpela man"]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu God","poem":1},{"text":"na yu mekim save","poem":2},{"text":"long ol manmeri i gat sin.","poem":3},{"text":"Nau yu ken soim kros bilong yu","poem":1},{"text":"long ol.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu bai mekim olgeta manmeri","poem":1},{"text":"i kamap long kot bilong yu.","poem":2},{"text":"Kam nau na bekim stret","poem":1},{"text":"pasin bilong ol bikhetman.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hamas taim i stap yet","poem":1},{"text":"bilong ol man nogut","poem":2},{"text":"i ken amamas","poem":3},{"text":"long pasin bilong ol?","poem":4},{"text":"Bikpela, ol i gat hamas taim moa","poem":1},{"text":"i stap?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hamas taim i stap yet","poem":1},{"text":"bilong ol man nogut i ken bikhet","poem":2},{"text":"na amamas long pasin nogut","poem":3},{"text":"ol i bin mekim?","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bikpela, ol i save daunim","poem":1},{"text":"ol manmeri bilong yu","poem":2},{"text":"na givim bikpela hevi long ol.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ol i save kilim i dai ol meri,","poem":1},{"text":"man bilong ol i dai pinis,","poem":3},{"text":"na ol pikinini,","poem":2},{"text":"papa bilong ol i dai pinis,","poem":3},{"text":"na ol manmeri bilong narapela hap","poem":2},{"text":"i stap long graun bilong mipela.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Na ol i tok olsem,","poem":1},{"text":"“Bikpela i no save lukim mipela.","poem":2},{"lineBreak":true},{"text":"God bilong Israel i no wari","poem":2},{"text":"long samting mipela i mekim.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yupela manmeri bilong mi,","poem":1},{"text":"olsem wanem na yupela","poem":2},{"text":"i mekim kranki pasin olsem?","poem":3},{"text":"Yupela ol longlong lain,","poem":1},{"text":"wanem taim bai yupela i gat save?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"God i bin wokim yau bilong yumi.","poem":1},{"text":"Olsem na ating","poem":2},{"text":"em i no inap harim, a?","poem":3},{"text":"Na God i bin wokim ai bilong yumi.","poem":1},{"text":"Orait ating em yet","poem":2},{"text":"i no inap lukluk, a?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Em i save bosim ol lain manmeri.","poem":1},{"text":"Orait ating em i no ken stretim ol, a?","poem":2},{"text":"Na em i tisa bilong olgeta manmeri.","poem":1},{"text":"Ating em i no gat save, a?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bikpela i save pinis long tingting","poem":1},{"text":"bilong olgeta manmeri.","poem":2},{"text":"Em i save, olgeta samting","poem":1},{"text":"ol i tingting long mekim,","poem":2},{"text":"ol bai i no inap kamap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela, sapos yu skulim","poem":1},{"text":"wanpela man long lo bilong yu,","poem":2},{"text":"dispela man i ken amamas.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Yu save mekim olsem","poem":1},{"text":"bilong givim malolo long em,","poem":2},{"text":"bai ol hevi i no ken painim em,","poem":3},{"text":"inap ol man nogut i dai","poem":2},{"text":"na i go long matmat.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Long wanem,","poem":1},{"text":"Bikpela i no inap lusim","poem":2},{"text":"ol manmeri bilong en.","poem":3},{"text":"Tru tumas, em i no inap","poem":1},{"text":"givim baksait","poem":2},{"text":"long ol manmeri bilong en.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Na bihain ol man i mekim kot,","poem":1},{"text":"bai ol i mekim i go stret tasol,","poem":2},{"text":"na bai ol stretpela man","poem":3},{"text":"i orait long en.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Husat i bin helpim mi","poem":1},{"text":"na i daunim ol man nogut?","poem":2},{"text":"Husat i helpim mi","poem":1},{"text":"na i sakim ol man","poem":2},{"text":"i save mekim rong?","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Sapos God i no bin helpim mi,","poem":1},{"text":"ating kwiktaim bai mi slip pinis","poem":2},{"text":"long matmat.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Mi tingting olsem,","poem":1},{"text":"“Lek bilong mi i wel.","poem":2},{"text":"Bai mi pundaun nau.”","poem":3},{"text":"Tasol nogat.","poem":2},{"text":"Bikpela, yu sori tumas long mi","poem":1},{"text":"na yu holim mi","poem":2},{"text":"na mi no pundaun long sin.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Na taim mi bel hevi","poem":1},{"text":"na mi gat planti tingting","poem":2},{"text":"long ol samting,","poem":3},{"text":"yu save mekim bel bilong mi","poem":2},{"text":"i stap isi","poem":3},{"text":"na yu mekim mi i amamas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yu no save wok","poem":1},{"text":"wantaim ol hetman nogut.","poem":2},{"text":"Ol dispela man i save putim lo","poem":1},{"text":"i tok orait long ol manmeri","poem":2},{"text":"i mekim pasin nogut.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Ol i save bung na pasim tok","poem":1},{"text":"bilong bagarapim gutpela man,","poem":3},{"text":"na ol i save kotim ol man","poem":2},{"text":"i no bin mekim rong,","poem":3},{"text":"bilong ol i ken kilim ol i dai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tasol Bikpela i strong tumas","poem":1},{"text":"long helpim mi.","poem":2},{"text":"God bilong mi","poem":1},{"text":"i save lukautim mi gut.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ol i bin mekim planti pasin nogut,","poem":1},{"text":"olsem na bai em i bekim","poem":2},{"text":"rong bilong ol.","poem":3},{"text":"Em i tingim sin bilong ol","poem":1},{"text":"na bai em i kilim ol i dai.","poem":2},{"text":"Em nau, God, Bikpela bilong yumi,","poem":1},{"text":"bai i bagarapim ol olgeta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}