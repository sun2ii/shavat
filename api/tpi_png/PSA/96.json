em":3},{"text":"“Bikpela i stap king.","poem":1},{"text":"Em i bin mekim graun","poem":2},{"text":"i stap strong","poem":4},{"text":"na graun i no inap surik.","poem":3},{"text":"Bihain bai Bikpela i mekim kot","poem":1},{"text":"na long stretpela pasin bilong en","poem":2},{"text":"em bai i skelim pasin","poem":3},{"text":"bilong olgeta lain manmeri.”","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Graun na skai,","poem":1},{"text":"yupela i mas amamas.","poem":2},{"text":"Solwara, yu mas amamas","poem":1},{"text":"na mekim bikpela nois.","poem":2},{"text":"Na yupela olgeta samting","poem":1},{"text":"i stap insait long solwara,","poem":3},{"text":"yupela tu i mas amamas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yupela ol gaden,","poem":1},{"text":"na yupela ol samting","poem":2},{"text":"i stap long ol gaden,","poem":3},{"text":"yupela olgeta i mas amamas.","poem":2},{"text":"Bikpela bai i kam.","poem":1},{"text":"Em bai i kam na i stap king","poem":2},{"lineBreak":true},{"text":"na bosim olgeta hap bilong graun.","poem":2},{"text":"Na long dispela taim","poem":1},{"text":"olgeta diwai bilong bikbus","poem":2},{"text":"bai i mekim song bilong amamas.","poem":3},{"text":"Long stretpela pasin bilong en","poem":1},{"text":"Bikpela bai i bosim","poem":2},{"text":"olgeta lain manmeri.","poem":3},{"text":"Na long tok tru bilong en","poem":1},{"text":"em bai i skelim pasin bilong ol.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"96.9 Tok Hibru i no klia tumas long dispela hap. Sampela man i ting mining bilong Hibru i olsem, “Yupela i mas pasim gutpela bilas bilong lotu na kam lotuim em.”","reference":{"chapter":96,"verse":9}}]},"thisChapterLink":"/api/tpi_png/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":12}