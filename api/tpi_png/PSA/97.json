{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"PSA","translationId":"tpi_png","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"68867904fd3fe291634288255b75683c355c74a0c610515a32c2f1933e2bea0c","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_png/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":97,"content":[{"type":"heading","content":["God em i nambawan king"]},{"type":"verse","number":1,"content":[{"text":"Bikpela i stap king.","poem":1},{"text":"Graun, yu mas amamas.","poem":2},{"text":"Na ol ailan, yupela i mas belgut.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Ol klaut na tudak","poem":1},{"text":"i save karamapim em,","poem":3},{"text":"na em i bosim ol manmeri","poem":2},{"text":"long stretpela pasin.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Paia i save go paslain long em","poem":1},{"text":"na i kukim ol birua","poem":2},{"text":"i raunim em i stap.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Em i save mekim","poem":1},{"text":"lait bilong klaut i kamap","poem":2},{"text":"na mekim graun i lait.","poem":3},{"text":"Graun i lukim na i save guria.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God em i Bikpela","poem":1},{"text":"bilong olgeta graun.","poem":2},{"text":"Em i kam na ol maunten","poem":1},{"text":"i kamap olsem wara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Skai antap i save autim tok","poem":1},{"text":"long stretpela pasin bilong em,","poem":3},{"text":"na olgeta lain manmeri","poem":2},{"text":"i lukim lait bilong en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ol manmeri i save lotu","poem":1},{"text":"long ol giaman god","poem":3},{"lineBreak":true},{"text":"na litimapim nem bilong ol,","poem":3},{"text":"ol i sem nogut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olgeta manmeri bilong Saion","poem":1},{"text":"na bilong ol taun bilong Juda,","poem":3},{"text":"ol i belgut na amamas","poem":2},{"text":"long kot bilong yu.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bikpela, yu God Antap Tru,","poem":1},{"text":"yu bosim olgeta hap graun.","poem":2},{"text":"Yu gat biknem","poem":1},{"text":"na yu winim olgeta giaman god.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bikpela i laikim tru ol manmeri","poem":1},{"text":"i no save laikim pasin nogut.","poem":2},{"text":"Em i save lukautim gut","poem":1},{"text":"ol manmeri bilong en","poem":3},{"text":"na kisim bek ol","poem":2},{"text":"long han bilong ol man nogut.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"God i save givim lait","poem":1},{"text":"long ol stretpela manmeri,","poem":3},{"text":"na i save mekim bel bilong ol","poem":2},{"text":"i amamas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yupela stretpela manmeri,","poem":1},{"text":"yupela i ken amamas","poem":2},{"text":"long ol samting","poem":3},{"text":"Bikpela i bin mekim.","poem":4},{"text":"Tingim dispela na tenkyu long em,","poem":1},{"text":"em God bilong mekim","poem":2},{"text":"gutpela na stretpela pasin olgeta.","poem":3}]}],"footnotes":[]},"thisChapter