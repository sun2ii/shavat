long mi,","poem":2},{"text":"o nogat?”","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi lusim ol na mi go","poem":1},{"text":"na wantu mi lukim pren bilong mi.","poem":2},{"text":"Mi go long en na mi holimpas em","poem":1},{"text":"na mi no laik em i lusim mi.","poem":2},{"text":"Mi bringim em i go long haus","poem":1},{"text":"bilong mama bilong mi,","poem":3},{"text":"na mitupela i go insait","poem":2},{"text":"long rum bilong mama.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol meri bilong Jerusalem,","poem":1},{"text":"yupela i mas ting","poem":2},{"text":"long ol gutpela wel abus","poem":3},{"text":"na mekim strongpela promis","poem":2},{"text":"long mi,","poem":3},{"text":"bai yupela i no ken kirapim bel","poem":2},{"text":"bilong mitupela.","poem":3},{"text":"Dispela i samting bilong mitupela yet.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Wanem samting i lusim ples drai","poem":1},{"text":"na i kam?","poem":2},{"text":"Dispela samting i olsem smok i kamap","poem":1},{"text":"taim ol i kukim olkain paura","poem":2},{"text":"i gat gutpela smel.","poem":3},{"text":"Na smel bilong en i olsem smel","poem":1},{"text":"bilong gutpela paura","poem":2},{"text":"ol bisnisman i save salim.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Lukim. Dispela em i","poem":1},{"text":"wanpela gutpela sia","poem":2},{"text":"ol man i karim i kam.","poem":3},{"text":"Na Solomon yet i sindaun long en.","poem":1},{"text":"Na 60 soldia i kam wantaim em.","poem":2},{"text":"Ol i strongpela soldia","poem":1},{"text":"bilong ami bilong Israel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olgeta i bin pait planti taim bipo.","poem":1},{"text":"Na ol i save tumas","poem":2},{"text":"long pait long bainat.","poem":3},{"text":"Olgeta wan wan i karim","poem":1},{"text":"bainat bilong ol.","poem":2},{"text":"Na ol i save was na redi,","poem":1},{"text":"nogut ol birua i kam pait long ol","poem":2},{"text":"long nait.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ol i bin kisim gutpela diwai","poem":1},{"text":"bilong kantri Lebanon","poem":3},{"text":"na wokim dispela sia bilong king","poem":2},{"text":"olsem wanpela liklik haus.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ol i wokim ol pos bilong sia","poem":1},{"text":"long silva,","poem":3},{"text":"na rop bilong en ol i wokim","poem":2},{"text":"long gol.","poem":3},{"text":"Na ples bilong sindaun,","poem":1},{"text":"ol i karamapim long retpela laplap","poem":2},{"text":"bilong king.","poem":3},{"text":"Ol meri bilong Jerusalem","poem":1},{"text":"i bin bilasim gut dispela sia.","poem":2},{"text":"Ol i laikim tumas long mekim","poem":1},{"text":"dispela wok bilong king.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yupela ol meri bilong Jerusalem,","poem":1},{"text":"yupela kam lukim King Solomon.","poem":2},{"text":"Hat bilong king i stap","poem":1},{"text":"long het bilong en.","poem":2},{"text":"Long de King Solomon i marit","poem":1},{"text":"mama bilong en i putim dispela hat","poem":2},{"text":"long het bilong en.","poem":3},{"text":"Na long dispela de","poem":1},{"text":"em i amamas moa yet.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}