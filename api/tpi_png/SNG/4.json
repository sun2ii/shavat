{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"SNG","translationId":"tpi_png","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"a5f225e13405073d84bd9aab74314c9f99f925154fd2b2a7b91b131f00330af4","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_png/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Pren bilong mi, yu naispela tumas.","poem":1},{"lineBreak":true},{"text":"Yu save pasim hap laplap long het","poem":1},{"text":"bilong haitim pes bilong yu,","poem":3},{"text":"tasol mi lukim ai bilong yu i lait,","poem":2},{"text":"long wanem, yu laikim mi tru.","poem":3},{"text":"Gras i hangamap long pes bilong yu","poem":1},{"text":"i olsem wanpela lain meme","poem":2},{"text":"i amamas","poem":3},{"text":"na kalap kalap i go daun","poem":2},{"text":"long ol liklik maunten","poem":3},{"text":"bilong Gileat.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Ol tit bilong yu i wait tru","poem":1},{"text":"olsem skin bilong waitpela sipsip","poem":2},{"text":"ol i bin katim gras bilong ol","poem":3},{"text":"na wasim ol nau tasol.","poem":4},{"text":"I no gat wanpela tit bilong yu i lus.","poem":1},{"text":"Nogat. Olgeta i stap gut.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maus bilong yu i retpela tru","poem":1},{"text":"olsem retpela laplap.","poem":2},{"lineBreak":true},{"text":"Maus bilong yu i naispela tru.","poem":2},{"text":"Laplap i haitim pes bilong yu,","poem":1},{"text":"tasol mi lukim pes bilong yu i lait.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nek bilong yu i naispela tru,","poem":1},{"text":"olsem gutpela taua","poem":2},{"text":"bilong King Devit.","poem":3},{"text":"Na naispela bis long nek bilong yu","poem":1},{"text":"i olsem ol hap plang","poem":2},{"text":"bilong planti soldia","poem":3},{"text":"i hangamap i stap long dispela taua.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tupela susu bilong yu","poem":1},{"text":"i olsem tupela gutpela wel abus","poem":2},{"text":"i kaikai gras namel long ol plaua.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yu olsem wanpela maunten","poem":1},{"text":"i pulap long ol samting","poem":2},{"text":"i gat gutpela smel.","poem":3},{"text":"Na bai mi go i stap","poem":1},{"text":"long dispela maunten","poem":3},{"text":"inap long san i go daun","poem":2},{"text":"na ples i kol.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Pren bilong mi, yu naispela tumas.","poem":1},{"text":"I no gat wanpela mak i stap","poem":2},{"text":"long skin bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Meri bilong mi, yu kam wantaim mi","poem":1},{"text":"na mitupela i lusim","poem":2},{"text":"ol maunten bilong Lebanon","poem":3},{"text":"na mitupela i go.","poem":2},{"text":"Yu lusim het bilong maunten Amana","poem":1},{"text":"na maunten Senir","poem":2},{"text":"na maunten Hermon","poem":3},{"text":"na yu kam daun.","poem":2},{"text":"Ol laion na ol arapela wel abus","poem":1},{"text":"i stap long ol dispela maunten.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yu meri bilong mi","poem":1},{"text":"na yu lewa tru bilong mi.","poem":2},{"text":"Yu lukim mi liklik tasol","poem":1},{"text":"na yu katim lewa bilong mi.","poem":2},{"text":"Mi lukim bis long nek bilong yu","poem":1},{"text":"na mi pundaun tru long yu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu meri bilong mi","poem":1},{"text":"na yu lewa tru bilong mi,","poem":3},{"text":"yu laikim mi tumas","poem":2},{"text":"na mi amamas tru.","poem":3},{"text":"Dispela laik bilong yu i swit tumas,","poem":1},{"text":"na i winim swit bilong wain.","poem":2},{"text":"Smel bilong sanda yu bilas long en","poem":1},{"text":"i winim smel","poem":2},{"text":"bilong olkain gutpela paura.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Yu gutpela meri bilong mi,","poem":1},{"text":"toktok bilong yu i swit","poem":2},{"text":"long yau bilong mi,","poem":3},{"text":"olsem hani i swit long maus.","poem":2},{"text":"Toktok bilong yu i gutpela tumas","poem":1},{"text":"olsem susu bilong dring.","poem":2},{"text":"Klos bilong yu i gat gutpela smel","poem":1},{"text":"olsem gutpela smel","poem":2},{"text":"bilong ol maunten bilong Lebanon.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Meri bilong mi,","poem":1},{"text":"yu lewa tru bilong mi.","poem":2},{"text":"Yu olsem wanpela gaden i gat banis,","poem":1},{"text":"na i no gat man i ken i go long en.","poem":2},{"text":"Yu olsem wanpela hul wara","poem":1},{"text":"i stap insait long dispela gaden.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yu olsem gutpela gaden","poem":1},{"text":"i gat ol gutpela gutpela diwai.","poem":2},{"text":"Sampela diwai i gat gutpela kaikai","poem":1},{"text":"na sampela i gat gutpela smel.","poem":2},{"text":"Sampela i bilong wokim gutpela sanda","poem":1},{"text":"na sampela i bilong mekim","poem":2},{"text":"kaikai i swit.","poem":3},{"text":"Sampela i bilong wokim olkain kala","poem":1},{"text":"na sampela i bilong wokim paura","poem":2},{"text":"bilong kamapim smok","poem":3},{"text":"i gat gutpela smel.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Yu olsem hul wara i pulap na kapsait","poem":1},{"text":"na ran i go givim wara","poem":2},{"text":"long dispela gaden.","poem":3},{"text":"Yu olsem ol liklik wara","poem":1},{"text":"i kamap long maunten Lebanon","poem":2},{"text":"na i ran i kam daun","poem":3},{"text":"long dispela gaden.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Win bilong hap not, yu kam.","poem":1},{"lineBreak":true},{"text":"Win bilong hap saut,","poem":1},{"text":"yu kam winim gaden bilong mi,","poem":3},{"text":"na mekim olgeta ples","poem":2},{"text":"i pulap long gutpela smel","poem":3},{"text":"bilong dispela gaden.","poem":4},{"text":"Na dispela pren mi laikim tumas","poem":1},{"text":"bai i kam long gaden bilong en","poem":2},{"text":"na kaikai ol gutpela pikinini","poem":3},{"text":"bilong diwai.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}