{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"SNG","translationId":"tpi_png","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"a5f225e13405073d84bd9aab74314c9f99f925154fd2b2a7b91b131f00330af4","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_png/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Yu naispela meri","poem":1},{"text":"na yu winim olgeta meri.","poem":2},{"text":"Pren bilong yu i go we?","poem":1},{"text":"Em i bihainim wanem rot na i go?","poem":2},{"text":"Mipela i laik helpim yu","poem":1},{"text":"long painim em.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pren bilong mi i go","poem":1},{"text":"long gaden bilong en.","poem":2},{"text":"Dispela gaden i pulap","poem":1},{"text":"long ol samting i gat gutpela smel.","poem":2},{"text":"Ol meme bilong en","poem":1},{"text":"i wok long kaikai gras","poem":3},{"text":"na em i wok long bungim","poem":2},{"text":"ol naispela plaua.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Dispela man em i bilong mi,","poem":1},{"text":"na mi meri bilong en.","poem":2},{"text":"Em i kisim ol meme bilong en i go","poem":1},{"text":"namel long ol naispela plaua","poem":2},{"text":"na ol meme i wok long kaikai gras.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Pren bilong mi, yu naispela tru","poem":1},{"text":"olsem gutpela taun Tirsa","poem":2},{"text":"na Jerusalem.","poem":3},{"text":"Mi lukim yu i naispela tru,","poem":1},{"text":"na tingting bilong mi i pas","poem":3},{"text":"olsem man i lukim","poem":2},{"text":"bikpela lain soldia","poem":3},{"text":"i kam wantaim ol plak bilong ol.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Mi no laik long yu lukluk long mi.","poem":1},{"text":"Yu lukluk long mi","poem":2},{"text":"na mi pundaun tru long yu.","poem":3},{"text":"Gras i hangamap long pes bilong yu","poem":1},{"text":"i olsem wanpela lain meme","poem":2},{"text":"i amamas","poem":3},{"text":"na kalap kalap i go daun","poem":2},{"text":"long ol liklik maunten","poem":3},{"text":"bilong Gileat.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Ol tit bilong yu i wait tru","poem":1},{"text":"olsem gras bilong waitpela sipsip","poem":2},{"text":"ol i bin wasim ol nau tasol.","poem":3},{"text":"I no gat wanpela tit bilong yu i lus.","poem":1},{"text":"Nogat. Olgeta i stap gut.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Laplap i haitim pes bilong yu","poem":1},{"text":"tasol mi lukim pes bilong yu i lait.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"King i gat planti meri.","poem":1},{"text":"60 i stap kwin,","poem":2},{"text":"na 80 ol i namba 2 lain meri.","poem":3},{"text":"Em i gat planti","poem":1},{"text":"arapela yangpela meri tu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tasol mi, mi gat wanpela pren tasol.","poem":1},{"text":"Em i namba wan tru","poem":2},{"text":"na mi laikim em tumas.","poem":3},{"text":"Mama bilong en i laikim em tumas","poem":1},{"text":"na i amamas tru long em.","poem":2},{"text":"Olgeta yangpela meri i lukim em","poem":1},{"text":"na ol i save litimapim nem","poem":2},{"text":"bilong en.","poem":3},{"text":"Ol kwin na ol arapela meri","poem":1},{"text":"bilong king","poem":3},{"text":"i save singim song","poem":2},{"text":"na amamas long em.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Husat tru i lukluk i kam long mi?","poem":1},{"lineBreak":true},{"text":"Pes bilong en i olsem san i laik kamap","poem":1},{"text":"na i lait olsem biksan,","poem":3},{"text":"na pes bilong en i klia tru","poem":2},{"text":"olsem lait bilong mun.","poem":3},{"text":"Mi lukim em","poem":1},{"text":"na tingting bilong mi i pas","poem":3},{"text":"olsem man i lukim","poem":2},{"text":"bikpela lain soldia","poem":3},{"text":"i kam wantaim ol plak bilong ol.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Mi kam daun pinis","poem":1},{"text":"na mi stap long gaden","poem":2},{"text":"i gat ol gutpela diwai","poem":3},{"text":"i save karim kaikai.","poem":4},{"text":"Mi kam bilong lukim ol nupela kru","poem":1},{"text":"bilong ol diwai samting","poem":2},{"text":"i kamap long ples daun.","poem":3},{"text":"Mi laik lukim ol nupela lip","poem":1},{"text":"bilong diwai wain","poem":3},{"text":"na ol plaua bilong diwai","poem":2},{"text":"i gat gutpela kaikai.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Pren bilong mi, mi lukim yu","poem":1},{"text":"na mi seksek long yu.","poem":2},{"text":"Mi pilim olsem mi stap long karis","poem":1},{"text":"bilong wanpela bikman tru.","poem":2},{"noteId":0}]},{"type":"verse","number":13,"content":[{"text":"Meri bilong Sulam,","poem":1},{"text":"kam bek, kam bek.","poem":2},{"text":"Yu kam bek na mipela i lukim yu.","poem":1},"Yangpela meri i singim song olsem",{"text":"Bilong wanem yupela i laik lukim mi,","poem":1},{"text":"taim mi danis","poem":2},{"text":"long ai bilong ol man?","poem":3}]}],"footnotes":[{"noteId":0,"caller":"+","text":"6.12 Tok Hibru i no klia tumas long dispela hap.","reference":{"chapter":6,"verse":12}}]},"thisChapterLink":"/api/tpi_png/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}