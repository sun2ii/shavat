{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"SNG","translationId":"tpi_png","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"a5f225e13405073d84bd9aab74314c9f99f925154fd2b2a7b91b131f00330af4","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_png/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Sapos mama bilong mi","poem":1},{"text":"i bin karim yu,","poem":2},{"text":"na i bin givim susu long yu,","poem":3},{"text":"olsem bai i gutpela.","poem":2},{"text":"Sapos olsem,","poem":1},{"text":"orait taim mi bungim yu","poem":2},{"text":"long bikrot,","poem":3},{"text":"mi inap kis long yu","poem":2},{"text":"na bai i no gat wanpela man","poem":3},{"text":"i tingting nogut long dispela.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Na bai mi inap kisim yu","poem":1},{"text":"i go long haus bilong mama","poem":2},{"text":"bilong yumi,","poem":3},{"text":"na bai yu skulim mi gut.","poem":2},{"text":"Bai mi kisim wain mi bin wokim","poem":1},{"text":"long gutpela pikinini","poem":2},{"text":"bilong diwai wain","poem":3},{"text":"na tanim wantaim switpela paura","poem":2},{"text":"na givim long yu.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Yu putim han kais bilong yu","poem":1},{"text":"aninit long het bilong mi.","poem":2},{"text":"Na long han sut bilong yu,","poem":1},{"text":"yu holim bodi bilong mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ol meri bilong Jerusalem,","poem":1},{"text":"yupela i mas mekim","poem":2},{"text":"strongpela promis long mi,","poem":3},{"text":"bai yupela i no ken kirapim bel","poem":2},{"text":"bilong mitupela.","poem":3},{"text":"Dispela i samting bilong mitupela yet.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Wanem dispela meri i lusim ples drai","poem":1},{"text":"na wokabaut i kam.","poem":2},{"text":"Em i holim han bilong pren bilong en","poem":1},{"text":"na tupela i kam.","poem":2},"Yangpela man i singim song olsem",{"text":"Yumi bin stap long as","poem":1},{"text":"bilong dispela diwai laulau","poem":3},{"text":"na mi bin kirapim yu.","poem":2},{"text":"Mama bilong yu i bin karim yu","poem":1},{"text":"aninit long dispela diwai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yu mas laikim mi wanpela tasol","poem":1},{"text":"na yu no ken laikim narapela meri.","poem":2},{"text":"Yu no ken holim narapela meri","poem":1},{"text":"long han bilong yu.","poem":3},{"text":"Yu mas holim mi tasol.","poem":2},{"text":"Laik bilong mi i strong tumas long yu","poem":1},{"text":"na bel bilong mi","poem":2},{"text":"i kirap strong tumas long yu","poem":3},{"text":"olsem dai i strong tumas","poem":2},{"text":"long daunim man.","poem":3},{"text":"Laik bilong mi","poem":1},{"text":"i kirap moa yet long yu","poem":2},{"text":"olsem paia i kirap bikpela tru.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Wara i no inap mekim i dai","poem":1},{"text":"dispela kain paia.","poem":2},{"text":"Sapos wanpela man","poem":1},{"text":"i givim olgeta mani bilong en","poem":2},{"text":"bilong mekim meri i laikim em,","poem":3},{"text":"bai em i lus tru","poem":2},{"text":"na meri i rabisim em tasol.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Susa bilong mipela i liklik yet","poem":1},{"text":"na susu bilong en i no kamap.","poem":2},{"text":"Taim em i bikpela pinis,","poem":1},{"text":"bai mipela i mekim wanem long em","poem":2},{"text":"sapos wanpela yangpela man","poem":3},{"text":"i laik maritim em?","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Sapos susa i stap gut","poem":1},{"text":"olsem banis bilong taun,","poem":3},{"text":"bai mipela i ken wokim taua silva","poem":2},{"text":"long dispela banis.","poem":3},{"text":"Tasol sapos em i olsem","poem":1},{"text":"dua bilong taun,","poem":3},{"text":"bai mipela i ken banisim em","poem":2},{"text":"long ol strongpela plang","poem":3},{"text":"bilong diwai sida.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Mi olsem wanpela banis,","poem":1},{"text":"na susu bilong mi","poem":2},{"text":"i olsem tupela taua.","poem":3},{"text":"Pren bilong mi i save gut olsem,","poem":1},{"text":"taim mi stap wantaim em,","poem":2},{"text":"mi stap gut tru","poem":3},{"text":"na bel bilong mi i stap isi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"King Solomon i gat gaden wain","poem":1},{"text":"long ples Balhamon.","poem":2},{"text":"Ol man i laik wokim dispela gaden","poem":1},{"text":"i mas givim 1,000 kina silva","poem":2},{"text":"long king.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Solomon i ken kisim","poem":1},{"text":"dispela 1,000 kina bilong en.","poem":2},{"text":"Na ol man i wokim gaden","poem":1},{"text":"i ken kisim 200 kina bilong ol.","poem":2},{"text":"Tasol mi no wari long ol.","poem":1},{"text":"Mi gat gaden wain bilong mi yet.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pren bilong mi, yu stap long gaden,","poem":1},{"text":"mi laik bai yu ken toktok","poem":3},{"text":"na ol poroman bilong mi","poem":2},{"text":"i ken harim nek bilong yu.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Gutpela pren bilong mi,","poem":1},{"text":"mi laik yu kam bek kwik","poem":3},{"text":"olsem wanpela gutpela wel abus","poem":2},{"lineBreak":true},{"text":"i ran i kam antap long ol maunten","poem":2},{"text":"i pulap long ol samting","poem":3},{"text":"i gat gutpela smel.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}