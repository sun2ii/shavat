{"translation":{"id":"tpi_png","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpi","licenseNotes":null,"shortName":"PNG","englishName":"Tok Pisin Bible with Deuterocanon","language":"tpi","textDirection":"ltr","sha256":"65725c98a1c65838bd6313ca220dfa0c3a98919fe98060ad797045326887eb0d","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":150,"totalNumberOfApocryphalVerses":4480},"book":{"id":"TOB","translationId":"tpi_png","name":"TOBIT","commonName":"TOBIT","title":"Buk bilong Tobit","order":67,"numberOfChapters":14,"isApocryphal":true,"sha256":"a508162bd63ef0312838ad39fa3ed92cfe4d4a26f2f380492e56681cf6f0b1f5","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_png/TOB/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tpi_png/TOB/14.json","totalNumberOfVerses":237},"chapter":{"number":13,"content":[{"type":"heading","content":["Tobit i singim songbilong litimapim nem bilong God"]},{"type":"verse","number":1,"content":["Orait Tobit i mekim dispela prea,",{"text":"‘Litimapim nem bilong God","poem":1},{"text":"i save stap oltaim.","poem":2},{"text":"Em i lukautim olgeta samting","poem":1},{"text":"gutpela tru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Em i mekim save long mipela,","poem":1},{"text":"tasol bihain em i marimari.","poem":2},{"text":"Em i salim mipela i go long hap","poem":1},{"text":"bilong ol man i dai pinis.","poem":2},{"text":"Tasol bihain em i rausim mipela gen","poem":1},{"text":"long matmat.","poem":2},{"text":"Tru tumas, i no gat wanpela","poem":1},{"text":"inap long ranawe","poem":2},{"text":"long han bilong em.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Yupela ol manmeri bilong Israel,","poem":1},{"text":"long taim yupela i stap namel","poem":2},{"text":"long ol arapela man","poem":3},{"text":"yupela i mas givim tenkyu","poem":2},{"text":"long God.","poem":3},{"text":"God i bin salim yupela i go kalabus","poem":1},{"text":"namel long ol lain pipel nabaut.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na long dispela hap tu","poem":1},{"text":"em i bin soim","poem":2},{"text":"bikpela strong bilong em.","poem":3},{"text":"Yumi litimapim nem bilong God.","poem":1},{"lineBreak":true},{"text":"Em i Bikpela,","poem":1},{"text":"na em i Papa bilong yumi.","poem":2},{"text":"Olsem bai olgeta lain pipel","poem":1},{"text":"i ken harim na i ken save olsem,","poem":3},{"text":"em i God tru bilong mipela","poem":2},{"text":"inap long oltaim tru.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tru, em i bin givim pen long yupela,","poem":1},{"text":"long wanem, yupela i bin mekim","poem":2},{"text":"olkain pasin nogut.","poem":3},{"text":"Tasol maski,","poem":1},{"text":"bihain bai em i marimari","poem":3},{"text":"na em bai i painim yupela","poem":2},{"text":"namel long ol arapela lain pipel","poem":3},{"text":"na em bai i bringim yupela","poem":2},{"text":"i kam bek","poem":3},{"text":"long kantri bilong yupela.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Yupela i mas tanim bel","poem":1},{"text":"bilong yupela","poem":2},{"text":"i go long God olgeta","poem":3},{"text":"na yupela i mas bihainim tru","poem":2},{"text":"tok bilong em,","poem":3},{"text":"na em bai i tanim pes bilong en","poem":2},{"text":"i go long yupela","poem":3},{"text":"na em bai i helpim yupela.","poem":2},{"text":"Em bai no i no inap hait moa,","poem":1},{"text":"na yupela bai inap long lukim gen","poem":2},{"text":"pes bilong em.","poem":3},{"text":"Yupela i no ken lusim tingting","poem":1},{"text":"long olgeta samting","poem":2},{"text":"God i bin mekim long yupela.","poem":3},{"text":"Yupela i mas givim tenkyu long em","poem":1},{"text":"long bel bilong yupela olgeta.","poem":2},{"text":"Yupela i mas litimapim nem","poem":1},{"text":"bilong God i stret olgeta.","poem":2},{"text":"Yupela i mas litimapim nem","poem":1},{"text":"bilong King i save stap oltaim.","poem":2},{"lineBreak":true},{"text":"“Maski mi stap kalabus","poem":1},{"text":"long narapela kantri,","poem":3},{"text":"mi laik tenkyu long Bikpela.","poem":2},{"text":"Na mi laik tokaut olsem","poem":1},{"text":"long ol dispela man","poem":2},{"text":"bilong mekim sin,","poem":3},{"text":"‘God i gat bikpela strong.","poem":1},{"text":"Yupela i mas lusim","poem":2},{"text":"ol pasin bilong sin,","poem":3},{"text":"na yupela i mas mekim ol samting","poem":2},{"text":"God i save laikim.","poem":3},{"text":"Ating em bai i belgut","poem":1},{"text":"long yupela gen,","poem":3},{"text":"na em bai i marimari long yupela.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mi litimapim nem","poem":1},{"text":"bilong God bilong mi","poem":3},{"text":"na mi amamas","poem":2},{"text":"long bikpela strong bilong em.","poem":3},{"text":"King bilong heven,","poem":1},{"text":"olgeta strong bilong mi","poem":2},{"text":"i litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Olgeta man i mas tokaut","poem":1},{"text":"long bikpela strong bilong God","poem":3},{"text":"na singsing long em","poem":2},{"text":"long Jerusalem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Jerusalem, yu biktaun","poem":1},{"text":"bilong God stret.","poem":2},{"text":"God bai i mekim save long yu,","poem":1},{"text":"long wanem, ol manmeri i stap","poem":2},{"text":"insait long banis bilong yu","poem":3},{"text":"ol i bin mekim sin.","poem":2},{"text":"Tasol em bai i marimari gen","poem":1},{"text":"long olgeta manmeri","poem":2},{"text":"i save mekim stretpela pasin.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Olsem na yu mas givim tenkyu","poem":1},{"text":"long God, em i gutpela.","poem":2},{"text":"Na litimapim nem","poem":1},{"text":"bilong King i save stap oltaim.","poem":2},{"text":"Bai ol i sanapim gen","poem":1},{"text":"haus lotu bilong yu","poem":3},{"text":"na olgeta manmeri bilong yu","poem":2},{"text":"bai i amamas gen.","poem":3},{"text":"Bikpela i ken mekim bel","poem":1},{"text":"bilong ol kalabusman bilong yu","poem":2},{"text":"i amamas gen.","poem":3},{"text":"Na ol manmeri i karim pen nau,","poem":1},{"text":"em i ken lukautim ol","poem":2},{"text":"i go inap long de bihain tru.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Jerusalem, bikpela lait bilong yu","poem":1},{"text":"bai i go","poem":2},{"text":"long olgeta hap bilong graun","poem":3},{"text":"na planti manmeri","poem":2},{"text":"bilong ol longwe ples","poem":3},{"text":"bai i kam long yu.","poem":2},{"text":"Olgeta lain pipel bai i kam","poem":1},{"text":"bilong givim biknem long God,","poem":2},{"text":"Bikpela bilong yu,","poem":3},{"text":"na ol bai i bringim ol presen","poem":2},{"text":"i kam long God,","poem":3},{"text":"em i King bilong heven.","poem":2},{"text":"Long olgeta rot bilong yu,","poem":1},{"text":"ol bai i singsing amamas long God.","poem":2},{"text":"Na nem bilong yu bai i stap bikpela","poem":1},{"text":"inap long oltaim,","poem":3},{"text":"long wanem, God i bin makim yu","poem":2},{"text":"olsem taun bilong em stret.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"God bai i bekim nogut long ol man","poem":1},{"text":"i save tok nogut long yu,","poem":3},{"text":"na long ol man i laik daunim yu","poem":2},{"text":"na brukim banis bilong yu,","poem":3},{"text":"na long ol man i pulim daun","poem":2},{"text":"ol taua","poem":3},{"text":"na kukim ol haus i stap insait","poem":2},{"text":"long banis bilong yu.","poem":3},{"text":"Tasol ol man i mekim gut long yu,","poem":1},{"text":"ol bai i kisim blesing bilong God","poem":2},{"text":"inap oltaim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Jerusalem, yu ken amamas","poem":1},{"text":"long ol stretpela manmeri","poem":2},{"text":"bilong yu.","poem":3},{"text":"Bihain bai ol i lusim kalabus","poem":1},{"text":"na kam bek,","poem":3},{"text":"na ol bai i bung","poem":2},{"text":"insait long banis bilong yu","poem":3},{"text":"na ol bai i litimapim nem","poem":2},{"text":"bilong Bikpela i stap oltaim.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Olgeta manmeri i laikim yu,","poem":1},{"text":"ol i ken belgut na amamas,","poem":3},{"text":"long wanem, ol i bin lukim yu","poem":2},{"text":"i kamap gutpela.","poem":3},{"text":"Olgeta dispela manmeri i sori nau,","poem":1},{"text":"long wanem, yu karim hevi,","poem":2},{"text":"bihain bai ol i amamas.","poem":3},{"text":"Na amamas bilong yu","poem":1},{"text":"bai i bringim gutpela taim long ol","poem":2},{"text":"i go inap oltaim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mi litimapim nem bilong God,","poem":1},{"text":"em i bikpela King.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ol bai i wokim bek Jerusalem","poem":1},{"text":"na em bai i stap ples","poem":2},{"text":"bilong God bilong oltaim.","poem":3},{"lineBreak":true},{"text":"“Jerusalem, mi bai amamas moa yet,","poem":1},{"text":"taim ol pikinini bilong mi i lukim","poem":2},{"text":"ol bilas bilong yu","poem":3},{"text":"na ol i givim tenkyu","poem":2},{"text":"long King bilong heven.","poem":3},{"text":"Ol bai i kisim ol gutpela gutpela","poem":1},{"text":"blupela na grinpela ston","poem":2},{"text":"na wokim ol dua bilong yu","poem":3},{"text":"na ol bai i wokim","poem":2},{"text":"olgeta banis bilong yu","poem":3},{"text":"long ol gutpela ston i dia tumas.","poem":2},{"text":"Ol bai i wokim ol taua bilong yu","poem":1},{"text":"long gol.","poem":2},{"text":"Ol bai i kisim gutpela gol tru","poem":1},{"text":"na wokim ol banis bilong yu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ol bai i wokim ol rot","poem":1},{"text":"long ol gutpela retpela ston","poem":2},{"text":"na long ol ston i lait tumas.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Long olgeta dua bilong yu","poem":1},{"text":"ol bai i harim","poem":2},{"text":"ol song bilong amamas,","poem":3},{"text":"na long ol haus bilong yu","poem":2},{"text":"ol manmeri bai i singsing olsem,","poem":3},{"text":"‘Aleluya, litimapim nem","poem":2},{"text":"bilong God bilong Israel.’","poem":3},{"text":"Jerusalem, God bai i blesim","poem":1},{"text":"ol manmeri bilong yu","poem":3},{"text":"na ol bai i litimapim","poem":2},{"text":"nem holi bilong em","poem":3},{"text":"inap oltaim oltaim.”","poem":4},"Long dispela tok Tobit i pinisim singsing bilong litimapim nem bilong God."]}],"footnotes":[]},"thisChapterLink":"/api/tpi_png/TOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_png/TOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_png/TOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":18}