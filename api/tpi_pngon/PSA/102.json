{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":102,"content":[{"type":"heading","content":["Prea bilong man i karim hevi"]},{"type":"hebrew_subtitle","content":["Dispela song em beten bilong man i karim bikpela hevi na strong bilong en i pinis olgeta, na em i laik tokim Bikpela long olgeta wari bilong en."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, harim prea","poem":1},{"text":"bilong mi.","poem":2},{"text":"Mi singaut long yu","poem":1},{"text":"bilong helpim mi.","poem":3},{"text":"Harim singaut bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taim mi karim bikpela hevi,","poem":1},{"text":"yu no ken hait long mi.","poem":3},{"text":"Harim beten bilong mi.","poem":2},{"text":"Taim mi singaut long yu,","poem":1},{"text":"yu ken harim kwik","poem":2},{"text":"singaut bilong mi","poem":3},{"text":"na helpim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Laip bilong mi","poem":1},{"text":"em i olsem smok bilong paia","poem":2},{"text":"i stap liklik taim tasol","poem":3},{"text":"na i go pinis.","poem":4},{"text":"Na skin bilong mi i hat","poem":1},{"text":"olsem bikpela paia i kukim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"God i daunim mi","poem":1},{"text":"olsem man i krungutim","poem":2},{"text":"gras i drai pinis.","poem":3},{"text":"Olsem na bel bilong mi","poem":1},{"text":"i no laikim kaikai moa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi pilim pen","poem":1},{"text":"na mi singaut nogut tru.","poem":2},{"text":"Na skin bilong mi i no moa patpela.","poem":1},{"text":"Mi bun nating tru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi stap nogut","poem":1},{"text":"olsem tarangau long ples drai,","poem":3},{"text":"na olsem wanpela pisin","poem":2},{"text":"bilong nait","poem":4},{"text":"i stap nating","poem":3},{"text":"long ples i bagarap,","poem":4},{"text":"na long ples i no gat man moa","poem":3},{"text":"i stap long en.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Mi slip long bet,","poem":1},{"text":"tasol ai bilong mi i op.","poem":2},{"text":"Tarangu, mi stap wanpis","poem":1},{"text":"olsem wanpela pisin","poem":2},{"text":"i stap antap long het bilong haus.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Long san na long nait","poem":1},{"text":"ol birua i tok nogut long mi.","poem":2},{"text":"Ol i tok bilas long mi","poem":1},{"text":"na kolim nem bilong mi","poem":2},{"text":"long taim ol i tok nogut","poem":3},{"text":"long mi painim bagarap.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yu gat bikpela kros long mi,","poem":1},{"text":"olsem na mi kaikai","poem":2},{"text":"sit bilong paia tasol,","poem":3},{"text":"na wara bilong ai","poem":2},{"text":"i pundaun long kap wara","poem":3},{"text":"na mi dringim.","poem":2},{"text":"Yu bin kisim mi","poem":1},{"text":"na tromoi mi long wanpela hap","poem":2},{"text":"olsem pipia.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Mi stap laip sotpela taim tasol,","poem":1},{"text":"inap olsem san i go daun","poem":2},{"text":"long apinun.","poem":3},{"text":"Mi olsem gras i drai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tasol Bikpela, yu stap king oltaim.","poem":1},{"text":"Olgeta lain manmeri","poem":2},{"text":"i kamap bihain,","poem":3},{"text":"bai ol i save long yu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nau bai yu kam","poem":1},{"text":"na marimari long taun Saion","poem":2},{"text":"na helpim em.","poem":3},{"text":"Taim i kamap pinis","poem":1},{"text":"bilong yu sori long en.","poem":3},{"text":"Nau tasol em i taim bilong sori.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taun Saion i bagarap,","poem":1},{"text":"tasol ol wokman bilong yu","poem":2},{"text":"i laikim em tumas.","poem":3},{"text":"Nau em i bagarap,","poem":1},{"text":"tasol ol i sori tru long en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Olgeta lain manmeri","poem":1},{"text":"bai i pret long Bikpela","poem":2},{"text":"na i stap aninit long em.","poem":3},{"text":"Na olgeta king bilong graun","poem":1},{"text":"bai ol i pret long strong bilong em.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bihain, taim God","poem":1},{"text":"i wokim Saion gen,","poem":3},{"text":"em bai i soim strong bilong en","poem":2},{"text":"long ol manmeri.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Na bai em i harim beten","poem":1},{"text":"bilong ol manmeri bilong en,","poem":3},{"text":"bipo em i bin lusim ol","poem":2},{"text":"na ol i stap nating.","poem":3},{"text":"Bai em i no ken givim baksait moa","poem":1},{"text":"long ol prea bilong ol.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dispela samting Bikpela i mekim,","poem":1},{"text":"yumi mas raitim long buk,","poem":3},{"text":"bai ol lain tumbuna","poem":2},{"text":"i kamap bihain","poem":4},{"text":"ol i ken save long en.","poem":3},{"text":"Bihain long mama i karim ol,","poem":1},{"text":"bai ol tu i ken harim stori","poem":2},{"text":"long wok bilong Bikpela,","poem":3},{"text":"na ol tu i ken litimapim","poem":2},{"text":"nem bilong em.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Yumi raitim tok olsem,","poem":1},{"text":"“Bikpela i stap antap","poem":2},{"text":"long ples bilong em yet","poem":3},{"text":"na i lukluk i go daun.","poem":4},{"text":"Em i stap long heven","poem":2},{"text":"na i lukluk","poem":3},{"text":"i go daun long graun.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Em i harim ol kalabus i krai","poem":2},{"text":"long hevi ol i karim.","poem":3},{"text":"Na em i laik helpim","poem":2},{"text":"ol man i kot pinis","poem":3},{"text":"na pinisim kalabus bilong ol,","poem":2},{"text":"bai ol i no ken i dai.”","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Olsem na long Jerusalem","poem":1},{"text":"bai ol manmeri i autim","poem":2},{"text":"nem bilong Bikpela,","poem":3},{"text":"na bai ol i tenkyu long em.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ol bai i mekim olsem,","poem":1},{"text":"taim ol lain manmeri","poem":2},{"text":"wantaim ol king bilong ol","poem":3},{"text":"i bung long Jerusalem","poem":2},{"text":"bilong lotu long Bikpela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mi yangpela yet","poem":1},{"text":"na Bikpela i bagarapim","poem":2},{"text":"strong bilong mi.","poem":3},{"text":"Mi no ken i stap laip longtaim.","poem":1},{"text":"Em i sotim taim bilong mi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"God bilong mi,","poem":1},{"text":"yu stap oltaim oltaim.","poem":2},{"text":"Yu no ken kisim mi nau.","poem":1},{"text":"Mi no lapun, mi yangpela yet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bipo tru yu bin wokim dispela graun","poem":1},{"text":"na em i stap strong.","poem":2},{"text":"Na long han bilong yu yet","poem":1},{"text":"yu bin wokim skai","poem":2},{"text":"na olgeta samting i stap antap.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Skai wantaim graun","poem":1},{"text":"bai i bagarap olgeta,","poem":3},{"text":"tasol yu save stap oltaim.","poem":2},{"text":"Tupela bai i bagarap","poem":1},{"text":"olsem laplap i olpela pinis","poem":2},{"text":"na i bagarap.","poem":3},{"text":"Na bai yu senisim tupela","poem":1},{"text":"olsem man i senisim klos,","poem":3},{"text":"na bai tupela i pinis olgeta","poem":2},{"text":"na i no moa i stap.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Tasol yu save stap olsem tasol.","poem":1},{"text":"Yu no save senis.","poem":2},{"text":"Na taim bilong yu i no inap pinis.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Olsem na bai yu lukautim","poem":1},{"text":"ol pikinini bilong mipela,","poem":2},{"text":"na bai ol i stap gut.","poem":3},{"text":"Na bai yu helpim","poem":1},{"text":"ol lain tumbuna bilong ol","poem":2},{"text":"i kamap bihain,","poem":3},{"text":"na ol i ken i stap","poem":2},{"text":"wantaim yu oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":27}