{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":103,"content":[{"type":"heading","content":["God i laikim yumi tumas"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Mi mas litimapim","poem":1},{"text":"nem bilong Bikpela.","poem":2},{"text":"Yes, bodi na tingting","poem":1},{"text":"na olgeta samting","poem":2},{"text":"i stap insait long mi","poem":3},{"text":"i mas litimapim","poem":2},{"text":"gutpela nem bilong Bikpela.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi mas litimapim","poem":1},{"text":"nem bilong Bikpela,","poem":3},{"text":"na mi no ken lusim tingting","poem":2},{"text":"long ol gutpela samting","poem":3},{"text":"em i bin mekim long mi.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Em i save lusim olgeta sin bilong mi,","poem":1},{"text":"na em i save mekim orait","poem":2},{"text":"olgeta sik bilong mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bikpela i kisim bek mi","poem":1},{"text":"na mi no i dai.","poem":2},{"text":"Em i save marimari","poem":1},{"text":"na sori moa yet long mi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olgeta taim mi stap long graun","poem":1},{"text":"Bikpela i save givim","poem":2},{"text":"ol gutpela samting long mi","poem":3},{"text":"na inapim mi.","poem":2},{"text":"Em i mekim olsem","poem":1},{"text":"na mi kamap yangpela gen","poem":2},{"text":"na mi stap strong olsem tarangau.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bikpela i mekim stretpela wok","poem":1},{"text":"bilong helpim ol manmeri","poem":3},{"text":"taim ol i stap aninit","poem":2},{"text":"long pasin nogut","poem":3},{"text":"bilong ol arapela man.","poem":4},{"text":"Na em i kirapim ol bek gen","poem":1},{"text":"na ol i stap gut.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bipo em i tokim Moses","poem":1},{"text":"long ol samting em i laik mekim.","poem":2},{"text":"Na em i larim","poem":1},{"text":"ol manmeri bilong Israel i lukim","poem":2},{"text":"ol strongpela wok em i mekim.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Bikpela i save sori moa yet","poem":1},{"text":"long yumi","poem":3},{"text":"na oltaim em i marimari","poem":2},{"text":"long yumi.","poem":3},{"text":"Em i no save belhat kwiktaim,","poem":1},{"text":"na em i save laikim tru yumi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Em i no save kros nating long yumi.","poem":1},{"text":"Na belhat bilong en","poem":2},{"text":"i no save stap longpela taim.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Yumi inap kisim pe nogut","poem":1},{"text":"bilong sin bilong yumi,","poem":3},{"text":"tasol em i no save givim","poem":2},{"text":"dispela pe nogut long yumi.","poem":3},{"text":"Yumi bin mekim planti pasin nogut,","poem":1},{"text":"na em inap bekim","poem":2},{"text":"bikpela hevi long yumi,","poem":3},{"text":"tasol em i no save mekim olsem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Em i save laikim tru ol manmeri","poem":1},{"text":"i save pret long em.","poem":2},{"text":"Em i gat bikpela laik tru long ol,","poem":1},{"text":"olsem skai i antap tru long graun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hap bilong sankamap","poem":1},{"text":"em i no klostu","poem":2},{"text":"long hap bilong san i go daun.","poem":3},{"text":"Em i longwe tru.","poem":2},{"text":"Olsem tasol God i save rausim","poem":1},{"text":"sin bilong yumi","poem":3},{"text":"na sin i stap longwe tumas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Papa i save sori","poem":1},{"text":"long ol pikinini bilong en.","poem":2},{"text":"Olsem tasol Bikpela i save sori","poem":1},{"text":"long ol manmeri i pret long em.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Em i save olsem","poem":1},{"text":"em i bin kisim graun","poem":2},{"text":"na wokim yumi","poem":3},{"text":"na em i tingim yumi","poem":2},{"text":"i olsem das tasol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Laip bilong yumi manmeri","poem":1},{"text":"i sotpela tru olsem gras.","poem":2},{"text":"Yumi stap sotpela taim","poem":1},{"text":"olsem plaua bilong gras","poem":2},{"text":"na yumi dai.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Win i naisim plaua na em i pundaun","poem":1},{"text":"na ol man i no moa lukim","poem":2},{"text":"plaua i stap.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Tasol Bikpela i save marimari","poem":1},{"text":"oltaim oltaim","poem":3},{"text":"long ol manmeri i aninit long en.","poem":2},{"text":"Na em i mekim gutpela pasin","poem":1},{"text":"long ol lain tumbuna","poem":2},{"text":"i kamap bihain tu.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Na sapos ol i bihainim","poem":1},{"text":"kontrak bilong Bikpela,","poem":3},{"text":"na ol i bihainim","poem":2},{"text":"olgeta lo bilong em,","poem":3},{"text":"orait em i save kolim ol","poem":2},{"text":"stretpela manmeri.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bikpela i stap king long heven,","poem":1},{"text":"na em i bos bilong olgeta samting.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yupela olgeta ensel bilong Bikpela,","poem":1},{"text":"yupela i gat bikpela strong.","poem":2},{"text":"Yupela i save bihainim","poem":1},{"text":"tok bilong en,","poem":3},{"text":"yupela i save putim yau gut","poem":2},{"text":"long tok bilong en.","poem":3},{"text":"Orait yupela i mas litimapim","poem":1},{"text":"nem bilong Bikpela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yupela ol wokman bilong Bikpela,","poem":1},{"text":"yupela i stap long heven","poem":2},{"text":"na i save bihainim laik bilong em,","poem":3},{"text":"yupela litimapim nem bilong em.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yupela olgeta samting","poem":1},{"text":"Bikpela i bin wokim","poem":2},{"text":"na i stap long olgeta hap,","poem":3},{"text":"na em yet i stap king","poem":2},{"text":"bilong yupela,","poem":3},{"text":"litimapim nem bilong Bikpela.","poem":2},{"text":"Na mi tu mi mas","poem":1},{"text":"litimapim nem bilong em.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}