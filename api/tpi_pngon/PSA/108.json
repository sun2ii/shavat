{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":108,"content":[{"type":"heading","content":["Man i prea bai God i helpim ol manmeri bilong en"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em song bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"God, long bel bilong mi,","poem":1},{"text":"mi bilip strong long yu.","poem":3},{"text":"Yes, mi bilip olgeta long yu.","poem":2},{"text":"Nau bai mi singim song","poem":1},{"text":"bilong litimapim nem bilong yu.","poem":2},{"text":"Mi mas kirap lusim slip.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mi mas paitim gita","poem":2},{"text":"na kulele samting.","poem":3},{"text":"Tulait i bruk,","poem":1},{"text":"orait bai mi mekim dispela musik.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bikpela, bai mi tenkyu long yu","poem":1},{"text":"namel long ol arapela lain.","poem":2},{"text":"Bai mi go long olgeta manmeri","poem":1},{"text":"na litimapim nem bilong yu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yu save laikim mipela moa yet.","poem":1},{"text":"Sapos mipela i laik makim dispela,","poem":2},{"text":"bai mak i go inap long skai.","poem":3},{"text":"Oltaim yu save bihainim","poem":1},{"text":"gutpela tok bilong yu.","poem":2},{"text":"Sapos mipela inap kaunim","poem":1},{"text":"olgeta taim yu bin mekim gut","poem":2},{"text":"long mipela,","poem":3},{"text":"bai mak i go inap long ol klaut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, mi laik bai ol manmeri","poem":1},{"text":"i litimapim nem bilong yu","poem":2},{"text":"antap tru.","poem":3},{"text":"Mekim strong bilong yu","poem":1},{"text":"i kamap ples klia","poem":2},{"text":"long olgeta hap bilong graun,","poem":3},{"text":"bai olgeta manmeri i ken save","poem":2},{"text":"long biknem bilong yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yu save laikim tru mipela,","poem":1},{"text":"olsem na harim prea bilong mi,","poem":3},{"text":"na kisim bek mipela","poem":2},{"text":"long bikpela strong bilong yu,","poem":3},{"text":"na bai mipela i ken i stap gut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God i stap long haus bilong en","poem":1},{"text":"na i tok,","poem":3},{"text":"“Mi winim pait pinis,","poem":2},{"text":"olsem na bai mi amamas","poem":3},{"text":"na tilim graun bilong Sekem","poem":2},{"lineBreak":true},{"text":"na ples daun bilong Sukot","poem":2},{"text":"long ol manmeri bilong mi.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Gileat wantaim Manase","poem":2},{"text":"i bilong mi.","poem":3},{"text":"Efraim i olsem hat kapa","poem":2},{"text":"bilong mi.","poem":3},{"text":"Na Juda i olsem","poem":2},{"text":"stik king bilong mi.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Tasol Moap i olsem","poem":2},{"text":"dis waswas bilong mi,","poem":3},{"text":"na Idom em i olsem ples","poem":2},{"text":"bilong putim su bilong mi.","poem":3},{"text":"Na bai mi winim ol Filistia","poem":2},{"text":"long pait,","poem":3},{"text":"na bai mi amamas na singaut.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"God, husat inap bringim mi i go","poem":1},{"text":"long dispela taun","poem":2},{"text":"i gat strongpela banis?","poem":3},{"text":"Na husat inap bringim mi","poem":1},{"text":"i go long Idom?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"God, yu givim baksait pinis","poem":1},{"text":"long mipela, a?","poem":2},{"text":"Yu no laik helpim","poem":1},{"text":"ol ami bilong mipela, a?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yu helpim mipela,","poem":1},{"text":"na bai mipela i pait","poem":2},{"text":"long ol birua.","poem":3},{"text":"Long wanem, helpim bilong ol man","poem":1},{"text":"em i samting nating tasol.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sapos God i helpim mipela,","poem":1},{"text":"mipela bai i winim pait.","poem":2},{"text":"Em yet bai i daunim","poem":1},{"text":"ol birua bilong mipela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}