{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":110,"content":[{"type":"heading","content":["Song bilong Bikpela wantaim king em i bin makim"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em song bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Bikpela i tokim","poem":1},{"text":"Bikpela bilong mi olsem,","poem":2},{"lineBreak":true},{"text":"“Yu sindaun","poem":2},{"text":"long han sut bilong mi","poem":3},{"text":"inap mi putim ol birua bilong yu","poem":2},{"text":"i stap aninit long yu.”","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Bikpela i stap long Saion,","poem":1},{"text":"na bai em i mekim yu","poem":2},{"text":"i bosim planti ples,","poem":4},{"text":"na em i tok,","poem":3},{"text":"“Yu bosim ol birua bilong yu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taim yu laik pait long ol birua","poem":1},{"text":"ol manmeri bilong yu","poem":2},{"text":"bai i go wantaim yu","poem":3},{"text":"na helpim yu,","poem":4},{"text":"na bai yupela i go antap","poem":2},{"text":"long maunten bilong God.","poem":3},{"text":"Olgeta nait, wara i save kamap","poem":1},{"text":"long gras,","poem":3},{"text":"na gras i kisim nupela strong.","poem":2},{"text":"Na bai yu tu yu kisim strong","poem":1},{"text":"long olgeta de.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bikpela i promis pinis long yu olsem,","poem":1},{"text":"“Bai yu stap pris oltaim oltaim.","poem":2},{"text":"Yu wankain pris","poem":3},{"text":"olsem Melkisedek.”","poem":4},{"text":"Bikpela i tok tru olgeta","poem":1},{"text":"na em i no inap senisim","poem":2},{"text":"tok bilong en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bikpela i sanap wantaim yu","poem":1},{"text":"bilong strongim yu.","poem":2},{"text":"Taim em i belhat","poem":1},{"text":"bai em i pait long ol king nabaut","poem":3},{"text":"na bai em i winim pait","poem":2},{"text":"na daunim ol tru.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Em bai i bekim rong","poem":1},{"text":"bilong ol lain manmeri,","poem":3},{"text":"na long ples bilong pait","poem":2},{"text":"bai em i kilim i dai planti man.","poem":3},{"text":"Em bai i daunim ol king","poem":1},{"text":"long olgeta hap bilong graun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Em bai i go long wara","poem":1},{"text":"i ran klostu long rot","poem":2},{"text":"na em bai i dring.","poem":3},{"text":"Olsem na bai em i kisim strong","poem":1},{"text":"na winim pait.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}