{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":113,"content":[{"type":"heading","content":["Ol manmeri i amamas long God i mekim gut long ol"]},{"type":"verse","number":1,"content":[{"text":"Litimapim nem","poem":1},{"text":"bilong Bikpela!","poem":2},{"text":"Yupela wokman bilong Bikpela,","poem":1},{"text":"litimapim nem bilong em!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yumi olgeta i mas amamas","poem":1},{"text":"long nem bilong Bikpela,","poem":3},{"text":"nau na olgeta taim bihain.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Long hap bilong sankamap","poem":1},{"text":"i go inap hap bilong san i go daun,","poem":3},{"text":"yumi olgeta manmeri","poem":2},{"text":"i mas litimapim","poem":3},{"text":"nem bilong Bikpela.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Bikpela i save bosim","poem":1},{"text":"olgeta lain pipel.","poem":2},{"text":"Biknem bilong en i winim","poem":1},{"text":"olgeta samting long heven.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I no gat wanpela man","poem":1},{"text":"i olsem God, Bikpela bilong yumi.","poem":2},{"text":"Em i stap antap tru.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Em i save lukluk i kam daun","poem":1},{"text":"na lukim heven","poem":2},{"text":"na graun wantaim.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Em i save helpim ol rabisman","poem":1},{"text":"na ol i no i stap nogut moa.","poem":2},{"text":"Ol i stap gut tasol.","poem":3},{"text":"Em i save helpim ol man","poem":1},{"text":"i sot long ol samting","poem":2},{"text":"na ol i kisim inap.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Em i save putim ol i stap","poem":1},{"text":"wantaim ol hetman","poem":2},{"text":"bilong ol manmeri bilong en.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Na em i save mekim gut","poem":1},{"text":"long ol meri","poem":2},{"text":"i no save karim pikinini","poem":3},{"text":"na mekim ol","poem":2},{"text":"i karim planti pikinini,","poem":3},{"text":"na ol meri i amamas tru.","poem":2},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}