{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":114,"content":[{"type":"heading","content":["Song bilong tingim God i bin kisim bek ol manmeri bilong en long solwara Retsi"]},{"type":"verse","number":1,"content":[{"text":"Bipo ol Israel i lusim Isip","poem":1},{"text":"na i go.","poem":2},{"text":"Dispela ol lain bilong Jekop","poem":1},{"text":"i lusim ples bilong ol arapela lain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taim ol i mekim olsem,","poem":1},{"text":"ol Juda i kamap","poem":2},{"text":"manmeri bilong Bikpela,","poem":3},{"text":"na ol Israel tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Solwara Retsi em i lukluk","poem":1},{"text":"na i ranawe,","poem":3},{"text":"na wara Jordan i sanap i stap","poem":2},{"text":"na wara i no ran moa.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol bikpela maunten i kalap kalap","poem":1},{"text":"olsem ol meme","poem":3},{"text":"na ol liklik maunten","poem":2},{"text":"i kalap nabaut","poem":3},{"text":"olsem ol sipsip.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Solwara, wanem samting i kamap","poem":1},{"text":"na yu ranawe?","poem":2},{"text":"Wara Jordan, olsem wanem","poem":1},{"text":"na yu no ran moa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol maunten, bilong wanem","poem":1},{"text":"yupela i kalap kalap","poem":2},{"text":"olsem ol meme?","poem":3},{"text":"Yupela ol liklik maunten,","poem":1},{"text":"olsem wanem na yupela","poem":2},{"text":"i kalap nabaut","poem":3},{"text":"olsem ol sipsip?","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Graun, nau Bikpela i kam","poem":1},{"text":"na yu mas guria.","poem":2},{"text":"God bilong Jekop i kam pinis","poem":1},{"text":"na yu mas guria.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Em i save mekim ston","poem":1},{"text":"i kamap hul wara,","poem":3},{"text":"na maunten ston","poem":2},{"text":"i kamap bikpela wara.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}