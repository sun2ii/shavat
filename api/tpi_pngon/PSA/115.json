{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":115,"content":[{"type":"heading","content":["God wanpela tasol em i God tru"]},{"type":"verse","number":1,"content":[{"text":"God, oltaim yu save","poem":1},{"text":"laikim tumas mipela,","poem":3},{"text":"na yu no save lusim mipela.","poem":2},{"text":"Olsem na mipela i mas litimapim","poem":1},{"text":"biknem bilong yu tasol.","poem":2},{"text":"Mipela i no ken litimapim","poem":1},{"text":"nem bilong mipela yet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bilong wanem ol arapela lain","poem":1},{"text":"i save askim mipela olsem,","poem":3},{"text":"“We stap God bilong yupela?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"God bilong yumi i stap long heven.","poem":1},{"text":"Sapos em i laik mekim","poem":2},{"text":"wanpela samting,","poem":4},{"text":"orait em i save mekim tasol.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ol arapela lain i bin wokim","poem":1},{"text":"ol giaman god bilong ol","poem":2},{"text":"long gol na silva.","poem":3},{"text":"Ol man tasol i bin wokim ol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol giaman god i gat maus,","poem":1},{"text":"tasol ol i no inap toktok.","poem":2},{"text":"Ol i gat ai,","poem":1},{"text":"tasol ol i no inap lukluk.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol i gat yau,","poem":1},{"text":"tasol ol i no inap harim toktok.","poem":2},{"text":"Ol i gat nus,","poem":1},{"text":"tasol ol i no inap smelim samting.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ol i gat han,","poem":1},{"text":"tasol ol i no inap holim samting.","poem":2},{"text":"Na ol i gat lek,","poem":1},{"text":"tasol ol i no inap wokabaut.","poem":2},{"text":"Na ol i no inap mekim","poem":1},{"text":"wanpela singaut na wanpela krai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ol man i wokim ol giaman god,","poem":1},{"text":"ol i ken kamap wankain","poem":2},{"text":"olsem ol giaman god","poem":3},{"text":"ol i bin wokim.","poem":4},{"text":"Na ol manmeri i save bilip","poem":1},{"text":"long ol giaman god,","poem":3},{"text":"ol tu i ken kamap olsem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yupela manmeri bilong Israel,","poem":1},{"text":"yupela i mas bilip long Bikpela.","poem":2},{"text":"Em i save helpim yupela","poem":1},{"text":"na lukautim yupela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yupela pris bilong God","poem":1},{"text":"long lain bilong Aron,","poem":3},{"text":"yupela i mas bilip long Bikpela.","poem":2},{"text":"Em i save helpim yupela","poem":1},{"text":"na lukautim yupela.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yupela manmeri i save pret","poem":1},{"text":"long Bikpela,","poem":3},{"text":"yupela i mas bilip long em.","poem":2},{"text":"Em wanpela tasol","poem":1},{"text":"i save helpim yupela","poem":2},{"text":"na lukautim yupela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela i save tingting oltaim","poem":1},{"text":"long yumi,","poem":3},{"text":"na bai em i mekim gut long yumi.","poem":2},{"text":"Em bai i mekim gut long ol Israel","poem":1},{"text":"na long lain pris bilong God.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bikpela bai i mekim gut","poem":1},{"text":"long olgeta manmeri","poem":2},{"text":"i save pret long em,","poem":3},{"text":"ol manmeri i gat nem","poem":2},{"text":"na ol manmeri i no gat nem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mi laik bai Bikpela i givim","poem":1},{"text":"planti pikinini long yupela","poem":3},{"text":"na long ol tumbuna bilong yupela","poem":2},{"text":"i kamap bihain.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Bikpela i bin mekim kamap","poem":1},{"text":"heven na graun,","poem":3},{"text":"em i ken mekim gut tru","poem":2},{"text":"long yupela.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Heven em i ples bilong God tasol,","poem":1},{"text":"na em i givim graun","poem":2},{"text":"long yumi manmeri.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Ol man i dai pinis i save go","poem":1},{"text":"long ples bilong ol,","poem":3},{"text":"na ol i no save litimapim","poem":2},{"text":"nem bilong Bikpela.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Tasol yumi lain i stap yet,","poem":1},{"text":"bai yumi tenkyu long Bikpela,","poem":2},{"text":"nau na bihain tu.","poem":3},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}