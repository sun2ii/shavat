ltaim.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mi gat bikpela hevi","poem":1},{"text":"na mi prea long Bikpela,","poem":3},{"text":"na em i harim mi","poem":2},{"text":"na i pinisim dispela hevi.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bikpela i stap wantaim mi","poem":1},{"text":"na mi no inap pret.","poem":2},{"text":"Ol man i no inap mekim","poem":1},{"text":"wanpela samting long mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bikpela yet i save helpim mi.","poem":1},{"lineBreak":true},{"text":"Olsem na bai mi lukim Bikpela","poem":1},{"text":"i daunim ol birua","poem":2},{"text":"na bagarapim ol.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"I gutpela sapos","poem":1},{"text":"yumi bilip long Bikpela,","poem":3},{"text":"na yumi no bilip long ol man.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I gutpela sapos","poem":1},{"text":"yumi bilip long Bikpela,","poem":3},{"text":"na yumi no bilip","poem":2},{"text":"long ol king na ol hetman.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Planti birua i raunim mi,","poem":1},{"text":"tasol long strong bilong Bikpela","poem":2},{"text":"mi pinisim ol.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol i raunim mi i stap","poem":1},{"text":"long olgeta hap,","poem":3},{"text":"tasol long strong bilong Bikpela","poem":2},{"text":"mi pinisim ol.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol i raunim mi olsem planti binatang.","poem":1},{"text":"Tasol ol i dai kwiktaim","poem":2},{"text":"olsem paia long kunai i dai.","poem":3},{"text":"Long strong bilong Bikpela","poem":1},{"text":"mi pinisim ol.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ol i pait strong tru wantaim mi","poem":1},{"text":"na mi laik lus.","poem":2},{"text":"Tasol Bikpela i helpim mi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bikpela i save mekim mi","poem":1},{"text":"i kamap strong tumas.","poem":3},{"text":"Em yet i save helpim mi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Harim ol manmeri bilong God","poem":1},{"text":"i singaut","poem":2},{"text":"insait long ol haus sel bilong ol.","poem":3},{"text":"Ol i tok,","poem":1},{"text":"“Strong bilong Bikpela tasol","poem":2},{"text":"i bin mekim dispela.”","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Bikpela strong bilong Bikpela","poem":1},{"text":"i helpim mipela","poem":2},{"text":"na mipela i winim pait.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Mi no ken i dai yet. Nogat.","poem":1},{"lineBreak":true},{"text":"Bai mi stap laip,","poem":1},{"text":"na bai mi stori long ol samting","poem":2},{"text":"Bikpela i bin mekim.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Bikpela i bin mekim save tru","poem":1},{"text":"long mi,","poem":3},{"text":"tasol em i no larim mi i dai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Opim ol dua","poem":1},{"text":"bilong haus bilong Bikpela","poem":3},{"text":"na mi ken i go insait","poem":2},{"text":"na litimapim nem bilong en.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Dispela hia em i dua bilong Bikpela.","poem":1},{"text":"Ol stretpela manmeri tasol","poem":2},{"text":"i ken i go insait long en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bikpela, yu bin harim prea","poem":1},{"text":"bilong mi,","poem":3},{"text":"na yu helpim mi na mi stap gut.","poem":2},{"text":"Olsem na mi litimapim","poem":1},{"text":"nem bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dispela ston ol kamda i ting","poem":1},{"text":"em i nogut na ol i rausim,","poem":3},{"text":"em i kamap nambawan ston","poem":2},{"text":"bilong strongim banis bilong haus.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Bikpela yet i mekim","poem":1},{"text":"dispela samting i kamap,","poem":3},{"text":"na mipela i lukim","poem":2},{"text":"em i gutpela tru.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Bikpela i givim yumi","poem":1},{"text":"dispela gutpela de.","poem":2},{"text":"Yumi mas amamas","poem":1},{"text":"na belgut long en.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bikpela, mipela i askim yu","poem":1},{"text":"long kisim bek mipela.","poem":2},{"text":"Yu helpim mipela","poem":1},{"text":"na olgeta samting mipela i mekim","poem":2},{"text":"bai i kamap gutpela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"God i ken mekim gut","poem":1},{"text":"long dispela man","poem":2},{"text":"i kam long nem bilong Bikpela.","poem":3},{"text":"Mipela i litimapim nem bilong em","poem":1},{"text":"long haus bilong Bikpela.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bikpela tasol em i God tru.","poem":1},{"text":"Em i bin lukautim yumi gut.","poem":2},{"text":"Holim ol han bilong diwai","poem":1},{"text":"na wokabaut i go raunim alta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yu God bilong mi","poem":1},{"text":"na mi laik tok tenkyu long yu.","poem":2},{"text":"Yu God bilong mi,","poem":1},{"text":"na bai mi litimapim","poem":2},{"text":"nem bilong yu.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Yupela tenkyu long Bikpela.","poem":1},{"text":"Em i mekim gutpela pasin","poem":2},{"text":"long yumi.","poem":3},{"text":"Em i save laikim yumi tru,","poem":1},{"text":"na i save marimari","poem":2},{"text":"long yumi oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}