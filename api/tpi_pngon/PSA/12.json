{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":12,"content":[{"type":"heading","content":["Man i beten bai God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long pilai musik long pasin namba 8."]},{"type":"verse","number":1,"content":[{"text":"God, yu mas helpim mi.","poem":1},{"lineBreak":true},{"text":"I no gat wanpela gutpela man","poem":1},{"text":"i stap.","poem":3},{"text":"Bai yu no inap lukim","poem":1},{"text":"wanpela stretpela man.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Olgeta man i save giaman","poem":1},{"text":"long ol arapela man.","poem":3},{"text":"Ol i save tok gris long ol","poem":1},{"text":"na trikim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bikpela, yu mas pasim maus","poem":1},{"text":"bilong ol man","poem":3},{"text":"i save mekim tok gris,","poem":2},{"lineBreak":true},{"text":"na pasim maus","poem":2},{"text":"bilong ol hambakman.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol dispela man i save tok olsem,","poem":1},{"text":"“Bai mipela i toktok","poem":2},{"text":"long laik bilong mipela yet.","poem":3},{"text":"I no gat wanpela man","poem":2},{"text":"inap pasim mipela.","poem":3},{"text":"Husat i bosim mipela?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tasol Bikpela i tok olsem,","poem":1},{"text":"“Nau bai mi kam, long wanem,","poem":2},{"text":"ol man i wok long daunim ol rabisman.","poem":3},{"text":"Na ol man i karim pen na hevi,","poem":2},{"text":"ol i krai i stap.","poem":3},{"text":"Bai mi givim ol","poem":2},{"text":"dispela gutpela sindaun","poem":3},{"text":"ol i wet long kisim.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tok bilong God i tru olgeta.","poem":1},{"lineBreak":true},{"text":"Tok bilong en i gutpela tumas","poem":1},{"text":"olsem silva ol i bin kukim","poem":2},{"text":"7-pela taim long paia","poem":3},{"text":"na i klin olgeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, lukautim mipela gut.","poem":1},{"lineBreak":true},{"text":"Was gut long mipela oltaim,","poem":1},{"text":"bai ol man nogut","poem":2},{"text":"i no ken bagarapim mipela.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ol man nogut i save raun nabaut","poem":1},{"text":"long olgeta hap.","poem":3},{"text":"Na olgeta manmeri","poem":1},{"text":"i save tingting olsem","poem":2},{"text":"pasin nogut em i gutpela samting.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}