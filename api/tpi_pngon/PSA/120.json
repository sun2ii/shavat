{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":120,"content":[{"type":"heading","content":["Man i prea long God i helpim em"]},{"type":"hebrew_subtitle","content":["Song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Taim hevi","poem":1},{"text":"i kamap long mi,","poem":3},{"text":"mi singaut long Bikpela,","poem":2},{"text":"na em i harim beten bilong mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi bin prea olsem,","poem":1},{"text":"“Bikpela, helpim mi.","poem":2},{"lineBreak":true},{"text":"Nogut ol man bilong giaman","poem":2},{"text":"i paulim mi.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yupela man bilong giaman,","poem":1},{"text":"God bai i mekim wanem","poem":2},{"text":"long yupela?","poem":3},{"text":"Olsem wanem bai em i mekim save","poem":1},{"text":"long yupela?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bai em i sutim yupela","poem":1},{"text":"long spia bilong ol soldia,","poem":3},{"text":"na kapsaitim hatpela paia","poem":2},{"text":"long yupela.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mi sindaun nogut","poem":1},{"text":"namel long yupela,","poem":3},{"text":"na dispela i wankain olsem","poem":2},{"text":"mi sindaun nogut","poem":3},{"text":"long kantri Mesek","poem":4},{"text":"na namel long ol Kedar.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mi stap longtaim tumas","poem":1},{"text":"wantaim ol man","poem":2},{"text":"i no laik sindaun gut","poem":3},{"text":"wantaim ol arapela manmeri.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Taim mi tok long sindaun gut,","poem":1},{"text":"ol i laik pait tasol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}