content":[{"text":"Bikpela em i wasman bilong yu.","poem":1},{"text":"Em i save sanap klostu long yu","poem":2},{"text":"na i was long yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"San i no inap kukim yu nogut,","poem":1},{"text":"na long nait","poem":2},{"text":"mun bai i no inap","poem":3},{"text":"bagarapim yu.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Bikpela bai i was long yu","poem":1},{"text":"bai samting nogut","poem":2},{"text":"i no ken bagarapim yu.","poem":3},{"text":"Em bai i lukautim yu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taim yu lusim haus","poem":1},{"text":"Bikpela bai i lukautim yu.","poem":2},{"text":"Na taim yu kam bek","poem":1},{"text":"em bai i was yet long yu,","poem":3},{"text":"nau na long olgeta taim bihain.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}