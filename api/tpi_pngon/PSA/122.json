":"long mekim.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Long dispela ples haus kot i stap","poem":1},{"text":"na king i save harim kot","poem":2},{"text":"na stretim tok.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yupela i mas prea","poem":1},{"text":"bai ol Jerusalem","poem":2},{"text":"i ken sindaun gut.","poem":3},{"text":"Yupela beten olsem,","poem":1},{"text":"“Ol manmeri i laikim Jerusalem,","poem":2},{"text":"ol i ken i stap gut tru.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ol manmeri i stap insait","poem":2},{"text":"long banis bilong Jerusalem,","poem":3},{"text":"ol i ken sindaun gut","poem":2},{"text":"na i no gat pait.","poem":3},{"text":"Na king wantaim ol hetman tu","poem":2},{"text":"i ken sindaun gut.”","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Mi tingim ol pren na wantok,","poem":1},{"text":"na mi tok olsem","poem":2},{"text":"long Jerusalem,","poem":3},{"text":"“Yu ken i stap gut","poem":2},{"text":"na i no gat pait.”","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Mi tingting long haus bilong God,","poem":1},{"text":"Bikpela bilong yumi,","poem":3},{"text":"olsem na mi beten","poem":2},{"text":"bai olgeta samting bilong yu","poem":3},{"text":"i ken kamap gut tru.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}