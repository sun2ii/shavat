em":3}]},{"type":"verse","number":4,"content":[{"text":"Longtaim tumas ol maniman","poem":1},{"text":"i bin tok bilas long mipela,","poem":3},{"text":"na ol bikhetman","poem":2},{"text":"i bin daunim mipela.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}