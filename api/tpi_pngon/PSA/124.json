"text":"Inap dispela strongpela tait","poem":1},{"text":"i kisim yumi","poem":3},{"text":"na yumi dai pinis. Tasol nogat.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yumi mas tenkyu tru long Bikpela.","poem":1},{"text":"Em i no larim ol birua","poem":2},{"text":"i pinisim yumi.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Yumi lusim ol,","poem":1},{"text":"olsem pisin i lusim umben","poem":2},{"text":"wanpela man i bin putim,","poem":3},{"text":"na i flai i go.","poem":2},{"text":"Dispela umben i bruk pinis,","poem":1},{"text":"na yumi no moa pas long en.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela i bin wokim heven na graun,","poem":1},{"text":"em yet i save helpim yumi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}