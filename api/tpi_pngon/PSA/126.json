{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":126,"content":[{"type":"heading","content":["Ol Israel i beten bai God i helpim ol"]},{"type":"hebrew_subtitle","content":["Song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Taim Bikpela","poem":1},{"text":"i bringim mipela","poem":2},{"text":"i kam bek long Saion,","poem":3},{"text":"mipela i ting","poem":2},{"text":"mipela i olsem driman nating.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Olsem na mipela i lap moa yet,","poem":1},{"text":"na mipela i singim song","poem":2},{"text":"bilong amamas moa yet.","poem":3},{"text":"Na ol lain haiden i tok olsem,","poem":1},{"text":"“Bikpela i bin mekim","poem":2},{"text":"bikpela wok tru","poem":4},{"text":"bilong helpim ol Israel.”","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Tru tumas, Bikpela i bin mekim","poem":1},{"text":"bikpela wok tru","poem":2},{"text":"bilong helpim mipela.","poem":3},{"text":"Olsem na mipela i belgut tru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bikpela, yu bringim mipela olgeta","poem":1},{"text":"i kam bek.","poem":2},{"text":"Dispela i olsem ol baret bilong bus","poem":1},{"text":"i drai pastaim,","poem":3},{"text":"tasol yu mekim ren i kam daun","poem":2},{"text":"na wara i pulap long ol baret.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol man i wok long krai","poem":1},{"text":"na planim kaikai,","poem":3},{"text":"bai ol i ken amamas","poem":2},{"text":"na kisim ol kaikai i mau.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Tru tumas, ol man i krai","poem":1},{"text":"na karim pikinini kaikai i go","poem":2},{"text":"bilong planim,","poem":3},{"text":"bihain bai ol i singim","poem":2},{"text":"song bilong amamas,","poem":3},{"text":"na kisim ol kaikai i mau na i kam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}