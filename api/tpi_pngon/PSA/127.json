{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":127,"content":[{"type":"heading","content":["God i mekim gutpela pasin long ol na ol i litimapim nem bilong en"]},{"type":"hebrew_subtitle","content":["Solomon i raitim dispela song. Em i song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Sapos Bikpela","poem":1},{"text":"i no wokim haus,","poem":3},{"text":"ol kamda i wok nating.","poem":2},{"text":"Sapos Bikpela i no lukautim","poem":1},{"text":"wanpela taun,","poem":3},{"text":"orait ol wasman i was nating.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yumi save kirap long moningtaim","poem":1},{"text":"na wok hat i go inap long nait","poem":2},{"text":"bilong kisim mani","poem":3},{"text":"na ol kaikai samting.","poem":4},{"text":"Tasol nogut yumi wok hat nating.","poem":1},{"text":"Long wanem, God","poem":2},{"text":"i save givim malolo","poem":3},{"text":"long ol manmeri","poem":2},{"text":"em i save laikim tumas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God i mekim gut long yumi","poem":1},{"text":"na givim yumi ol pikinini","poem":2},{"text":"olsem presen.","poem":3},{"text":"Ol i gutpela blesing tru","poem":1},{"text":"yumi kisim long God.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ol pikinini man","poem":1},{"text":"bilong yangpela man","poem":3},{"text":"i olsem ol spia i stap long han","poem":2},{"text":"bilong wanpela soldia.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Man i gat planti pikinini man","poem":1},{"text":"em i ken amamas.","poem":2},{"text":"Ol bai i helpim em","poem":1},{"text":"taim em i mekim kot","poem":2},{"text":"wantaim ol birua bilong em","poem":3},{"text":"long ples kot.","poem":4},{"text":"Na bai em i no ken lus long kot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}