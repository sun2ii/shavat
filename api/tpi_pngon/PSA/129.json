{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":129,"content":[{"type":"heading","content":["Ol Israel i beten long God i ken bagarapim ol birua bilong ol"]},{"type":"hebrew_subtitle","content":["Song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Israel, yu stori long mipela","poem":1},{"text":"long ol birua","poem":2},{"text":"i bin wok long mekim nogut tru","poem":3},{"text":"long yu,","poem":4},{"text":"long taim yu yangpela yet","poem":2},{"text":"i kam inap long nau.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yu tok olsem, “Ol birua i bin wok","poem":1},{"text":"long mekim nogut tru long mi","poem":2},{"text":"long taim mi yangpela yet","poem":3},{"text":"i kam inap nau.","poem":4},{"text":"Tasol ol i no winim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ol i wipim mi nogut","poem":2},{"text":"na wip i katim skin","poem":3},{"text":"long baksait bilong mi.","poem":4},{"text":"Ol i mekim planti longpela sua","poem":2},{"text":"i kamap","poem":4},{"text":"olsem ol baret long gaden.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"“Tasol Bikpela i stretpela olgeta,","poem":2},{"text":"na em i bin helpim mi","poem":3},{"text":"na kisim mi bek","poem":2},{"text":"long han bilong ol man nogut,","poem":3},{"text":"na mi no moa i stap","poem":2},{"text":"wokboi nating.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mi laik bai mipela i winim ol man","poem":1},{"text":"i save birua long Saion,","poem":3},{"text":"na ranim ol i go bek","poem":2},{"text":"long ples bilong ol.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mobeta ol i stap","poem":1},{"text":"olsem gras i save kamap","poem":2},{"text":"long het bilong ol haus.","poem":3},{"text":"Ol i no katim dispela gras yet,","poem":1},{"text":"na em i drai kwiktaim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I no gat wanpela man","poem":1},{"text":"i save bungim dispela gras,","poem":2},{"text":"na pasim mekpas na karim i go.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Na ol manmeri i wokabaut i go","poem":1},{"text":"klostu long ol,","poem":2},{"text":"bai ol i no inap tok olsem,","poem":3},{"text":"“Bikpela i ken mekim gut","poem":2},{"text":"long yupela.","poem":3},{"text":"Long nem bilong Bikpela,","poem":2},{"text":"mipela i givim blesing","poem":3},{"text":"long yupela.”","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}