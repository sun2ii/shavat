{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":13,"content":[{"type":"heading","content":["Man i beten bai God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, wanem taim","poem":1},{"text":"bai yu tingim mi gen?","poem":3},{"text":"Ating yu lusim tingting long mi","poem":1},{"text":"inap oltaim oltaim, a?","poem":3},{"text":"Wanem taim bai yu larim mi","poem":1},{"text":"i lukim pes bilong yu gen?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wanem taim bai yu pinisim","poem":1},{"text":"dispela pen mi save karim?","poem":3},{"text":"Hamas de na nait","poem":1},{"text":"bel hevi bilong mi i mas i stap?","poem":2},{"text":"Wanem taim bai yu helpim mi","poem":1},{"text":"na mi no i stap moa","poem":2},{"text":"aninit long ol birua?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Bikpela, yu God bilong mi.","poem":1},{"text":"Yu mas tingting long mi","poem":2},{"text":"na harim prea bilong mi.","poem":3},{"text":"Strongim mi gen bai mi no ken i dai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Olsem bai ol birua i no inap tok,","poem":1},{"text":"“Mipela i winim em pinis.”","poem":2},{"text":"Na ol i no ken amamas","poem":1},{"text":"long lukim mi i pundaun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tasol mi bilip bai yu marimari","poem":1},{"text":"long mi oltaim.","poem":3},{"text":"Na mi amamas long yu","poem":1},{"text":"bai helpim mi.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yes, bai mi singim song","poem":1},{"text":"bilong litimapim nem","poem":2},{"text":"bilong Bikpela.","poem":3},{"text":"Long wanem,","poem":1},{"text":"em i bin mekim gut tru","poem":2},{"text":"long mi.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}