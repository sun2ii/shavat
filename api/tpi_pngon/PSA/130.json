{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":130,"content":[{"type":"heading","content":["Man i prea long God i helpim em"]},{"type":"hebrew_subtitle","content":["Song bilong ol lain i wokabaut i go long ples bilong lotu."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, mi bel hevi tumas","poem":1},{"text":"na mi singaut long yu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bikpela, harim krai bilong mi.","poem":1},{"text":"Harim mi i singaut","poem":2},{"text":"long yu helpim mi.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Sapos yu kaunim","poem":1},{"text":"olgeta sin bilong mipela","poem":3},{"text":"bai husat inap long winim","poem":2},{"text":"kot bilong yu?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Tasol yu save rausim","poem":1},{"text":"ol sin bilong mipela,","poem":3},{"text":"olsem na mipela i mas pret","poem":2},{"text":"long yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi laikim tumas","poem":1},{"text":"Bikpela i helpim mi,","poem":2},{"text":"na mi wet long em.","poem":3},{"text":"Na mi bilip tru long tok bilong en.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi save wet long Bikpela,","poem":1},{"text":"na mi laikim tumas","poem":2},{"text":"bai em i helpim mi.","poem":3},{"text":"Na dispela em i winim laik","poem":1},{"text":"bilong ol wasman","poem":2},{"text":"i save wet long tulait i kamap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yumi ol Israel,","poem":1},{"text":"yumi mas bilip long Bikpela,","poem":3},{"text":"long wanem, oltaim","poem":2},{"text":"em i save laikim yumi tru.","poem":3},{"text":"Na oltaim em i laik helpim yumi","poem":1},{"text":"bai yumi no bagarap.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Em bai i kisim bek","poem":1},{"text":"ol manmeri bilong en,","poem":2},{"text":"em yumi Israel,","poem":3},{"text":"na rausim olgeta sin bilong yumi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}