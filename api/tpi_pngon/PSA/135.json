{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":135,"content":[{"type":"heading","content":["Song bilong amamas long Bikpela"]},{"type":"verse","number":1,"content":[{"text":"Litimapim nem","poem":1},{"text":"bilong Bikpela.","poem":2},{"text":"Yupela wokman bilong Bikpela,","poem":1},{"text":"yupela i mas litimapim","poem":2},{"text":"nem bilong en.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yupela i save sanap insait","poem":1},{"text":"long banis bilong Bikpela,","poem":3},{"text":"long haus bilong God","poem":2},{"text":"bilong yumi.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Litimapim nem bilong en,","poem":1},{"text":"long wanem, em i save","poem":2},{"text":"mekim gut tru long yumi.","poem":3},{"text":"Em i save marimari long yumi,","poem":1},{"text":"olsem na yumi mas singim ol song","poem":2},{"text":"bilong litimapim nem bilong en.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Bikpela i bin makim Jekop","poem":1},{"text":"bilong em yet,","poem":3},{"text":"olsem na ol Israel","poem":2},{"text":"ol i lain bilong God stret.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi save Bikpela i gat biknem tru,","poem":1},{"text":"na em i antap","poem":2},{"text":"long olgeta giaman god.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bikpela i laik mekim","poem":1},{"text":"wanem samting","poem":4},{"text":"long heven na long graun","poem":3},{"lineBreak":true},{"text":"na long solwara","poem":3},{"lineBreak":true},{"text":"na long as bilong solwara,","poem":3},{"text":"orait em i save mekim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Em i save mekim ol klaut bilong ren","poem":1},{"text":"i kamap long olgeta hap graun,","poem":3},{"text":"na em i save mekim","poem":2},{"text":"lait bilong klaut","poem":3},{"text":"i kamap wantaim ren,","poem":4},{"text":"na em i save kirapim win","poem":2},{"text":"na salim i go nabaut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Long Isip em i bin kilim i dai","poem":1},{"text":"ol nambawan pikinini","poem":2},{"text":"bilong ol Isip","poem":3},{"text":"na bilong ol abus bilong ol.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Na long Isip","poem":1},{"text":"em i wokim olkain mirakel","poem":3},{"text":"bilong mekim save long king","poem":2},{"text":"wantaim ol ofisa bilong en.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Bikpela i bagarapim planti kantri","poem":1},{"text":"na kilim i dai ol strongpela king.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Em i kilim Sihon,","poem":1},{"text":"king bilong ol Amor,","poem":3},{"text":"na Ok, king bilong Basan,","poem":2},{"text":"na olgeta king","poem":3},{"text":"bilong graun Kenan.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Na em i givim graun","poem":1},{"text":"bilong ol dispela king","poem":2},{"text":"long ol manmeri bilong en,","poem":3},{"text":"ol Israel.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bikpela, oltaim ol manmeri","poem":1},{"text":"bai i save","poem":2},{"text":"yu yet yu God tru.","poem":3},{"text":"Na olgeta lain i kamap bihain,","poem":1},{"text":"ol tu bai i tingim yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Na Bikpela bai i marimari","poem":1},{"text":"long ol manmeri bilong en","poem":3},{"text":"na sori long ol dispela wokman","poem":2},{"text":"bilong en.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ol arapela lain i bin wokim","poem":1},{"text":"ol giaman god bilong ol","poem":2},{"text":"long silva na gol.","poem":3},{"text":"Han bilong ol man yet","poem":1},{"text":"i bin wokim ol giaman god.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ol dispela giaman god i gat maus,","poem":1},{"text":"tasol ol i no inap toktok.","poem":2},{"text":"Na ol i gat ai,","poem":1},{"text":"tasol ol i no inap lukim samting.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Na ol i gat yau,","poem":1},{"text":"tasol ol i no inap harim samting,","poem":2},{"text":"na ol i no inap pulim win.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Mi laik bai ol man","poem":1},{"text":"i bin wokim ol giaman god","poem":3},{"text":"na i save bilip","poem":2},{"text":"long ol dispela samting,","poem":3},{"text":"ol i ken kamap wankain","poem":2},{"text":"olsem ol dispela giaman god.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yupela ol manmeri bilong Israel,","poem":1},{"text":"litimapim nem bilong Bikpela.","poem":2},{"text":"Yupela pris bilong Bikpela,","poem":1},{"text":"litimapim nem bilong en.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yupela ol lain bilong Livai,","poem":1},{"text":"litimapim nem bilong Bikpela.","poem":2},{"text":"Yupela ol manmeri","poem":1},{"text":"i save pret long Bikpela,","poem":3},{"text":"litimapim nem bilong em.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yupela ol manmeri","poem":1},{"text":"i stap long Saion,","poem":2},{"text":"em Jerusalem,","poem":3},{"text":"ples tru bilong Bikpela,","poem":4},{"text":"litimapim nem bilong em!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}