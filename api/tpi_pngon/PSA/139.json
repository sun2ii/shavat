{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":139,"content":[{"type":"heading","content":["God i save pinis long yumi na em i save was gut long yumi"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu skelim pinis","poem":1},{"text":"bel bilong mi,","poem":3},{"text":"na yu save tru long mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu save long olgeta samting","poem":1},{"text":"mi save mekim.","poem":2},{"text":"Yu stap longwe, tasol yu save","poem":1},{"text":"long olgeta tingting bilong mi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu save lukim mi","poem":1},{"text":"long taim mi mekim wok","poem":2},{"text":"na long taim mi slip.","poem":3},{"text":"Yu save long olgeta pasin bilong mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na sapos mi laik","poem":1},{"text":"mekim wanpela tok,","poem":3},{"text":"yu save pinis long dispela tok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yu raunim mi long olgeta hap","poem":1},{"text":"na yu save was long mi","poem":2},{"text":"long strong bilong yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Save bilong yu","poem":1},{"text":"i antap tru long mi","poem":3},{"text":"na i winim tingting bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bai mi go we na mi ken lusim","poem":1},{"text":"spirit bilong yu?","poem":2},{"text":"Na bai mi ranawe i go","poem":1},{"text":"long wanem hap","poem":3},{"text":"na mi ken hait long yu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sapos mi go antap","poem":1},{"text":"na mi stap long heven,","poem":2},{"text":"yu stap long heven.","poem":3},{"text":"Sapos mi go i stap","poem":1},{"text":"long ples bilong ol man i dai pinis,","poem":2},{"text":"yu stap long dispela ples tu.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Sapos mi flai i go longwe","poem":1},{"text":"long hap bilong sankamap,","poem":3},{"text":"o sapos mi go i stap","poem":2},{"text":"long wanpela ples","poem":3},{"text":"i stap longwe tumas","poem":4},{"text":"long hap bilong san i go daun,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"bai yu stap long dispela ples tu","poem":2},{"text":"bilong stiaim lek bilong mi","poem":3},{"lineBreak":true},{"text":"na bilong helpim mi.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Na sapos mi tok,","poem":1},{"text":"“Tudak i mas haitim mi,","poem":2},{"text":"na lait bilong san i raunim mi,","poem":3},{"text":"em i mas kamap tudak,”","poem":4}]},{"type":"verse","number":12,"content":[{"text":"maski, long tingting bilong yu","poem":2},{"text":"tudak em i no olsem tudak tru.","poem":3},{"text":"Na nait i save lait tru olsem san.","poem":2},{"text":"Tudak na tulait i wankain tasol","poem":1},{"text":"long ai bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yu bin wokim olgeta hap","poem":1},{"text":"bilong bodi bilong mi.","poem":2},{"text":"Yu wokim mi olgeta","poem":1},{"text":"insait long bel bilong mama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mi pret long yu,","poem":1},{"text":"olsem na mi save litimapim","poem":2},{"text":"nem bilong yu.","poem":3},{"text":"Olgeta samting yu wokim i narakain","poem":1},{"text":"na i nambawan tru.","poem":2},{"text":"Mi save gut long dispela samting","poem":1},{"text":"na mi pilim tru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taim mi kamap isi isi","poem":1},{"text":"long ples hait","poem":2},{"text":"insait long bel bilong mama,","poem":3},{"text":"yu bin lukim olgeta bun bilong mi","poem":2},{"text":"i kamap na i pas wantaim.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Yu lukim mi","poem":1},{"text":"taim mama i no karim mi yet.","poem":2},{"text":"Mi no kamap yet long graun,","poem":1},{"text":"tasol yu raitim pinis","poem":2},{"text":"long buk bilong yu","poem":3},{"text":"olgeta de yu laik","poem":2},{"text":"bai mi mas i stap long graun.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"God, i hat tumas long mi save","poem":1},{"text":"long olgeta tingting bilong yu.","poem":2},{"text":"Tingting bilong yu i no liklik,","poem":1},{"text":"na i no gat rot","poem":2},{"text":"long mi ken save long en.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Sapos mi kaunim ol samting","poem":1},{"text":"yu save tingting long en,","poem":3},{"text":"bai namba bilong ol","poem":2},{"text":"i winim namba bilong olgeta wesan long nambis.","poem":3},{"text":"Taim mi kirap long slip","poem":1},{"text":"mi stap yet wantaim yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"God, mi laik bai yu kilim i dai","poem":1},{"text":"ol man nogut.","poem":2},{"text":"Na mi laik bai ol man bilong pait i","poem":1},{"text":"mas lusim mi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ol dispela man","poem":1},{"text":"i save tok nogut long yu.","poem":2},{"text":"Na ol i save mekim","poem":1},{"text":"ol kain kain tok nogut","poem":2},{"text":"long nem bilong yu.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Bikpela, mi no laikim tru","poem":1},{"text":"ol man i no laikim yu.","poem":2},{"text":"Na mi bel nogut tru long ol man","poem":1},{"text":"i save bikhet long yu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tru tumas, mi no laikim tru","poem":1},{"text":"ol dispela man.","poem":2},{"text":"Mi lukim ol i olsem","poem":1},{"text":"ol birua bilong mi yet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"God, skelim mi gut na bai yu save","poem":1},{"text":"long olgeta tingting","poem":2},{"text":"i stap long bel bilong mi.","poem":3},{"text":"Traim mi, na bai yu save gut","poem":1},{"text":"long olgeta tingting bilong mi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Skelim mi gut,","poem":1},{"text":"nogut sampela tok giaman","poem":2},{"text":"i stap long tingting bilong mi.","poem":3},{"text":"Na yu mas bringim mi long rot","poem":1},{"text":"bilong kisim laip","poem":2},{"text":"bilong i stap gut oltaim oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}