{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":140,"content":[{"type":"heading","content":["Man i beten long God i was gut long em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu ken helpim mi","poem":1},{"text":"bai ol man nogut","poem":2},{"text":"i no inap bagarapim mi.","poem":3},{"text":"Yu ken lukautim mi gut","poem":1},{"text":"bai ol man bilong pait","poem":2},{"text":"i no inap birua long mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Oltaim ol i save tingting","poem":1},{"text":"long mekim pasin nogut,","poem":3},{"text":"na oltaim ol i save kirapim kros","poem":2},{"text":"namel long ol manmeri.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Toktok bilong ol i sap tumas","poem":1},{"text":"olsem tit bilong snek,","poem":3},{"text":"na tok bilong bagarapim man","poem":2},{"text":"i pulap long maus bilong ol","poem":3},{"text":"olsem marasin bilong snek nogut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bikpela, yu mas lukautim mi gut","poem":1},{"text":"bai strong bilong ol man nogut","poem":2},{"text":"i no inap winim mi.","poem":3},{"text":"Banisim mi na ol man bilong pait","poem":1},{"text":"i tok long bagarapim mi,","poem":3},{"text":"bai ol i no inap mekim","poem":2},{"text":"wanpela samting long mi.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol bikhetman i putim umben i stap","poem":1},{"text":"bilong holimpas mi.","poem":2},{"text":"Dispela umben","poem":1},{"text":"ol i wokim long baklain","poem":3},{"text":"ol i taitim long rot bilong mi","poem":2},{"text":"bilong kisim mi olsem abus.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mi tokim Bikpela olsem,","poem":1},{"text":"“Yu God bilong mi.”","poem":2},{"text":"Bikpela, helpim mi.","poem":1},{"text":"Harim singaut bilong mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bikpela, God bilong mi,","poem":1},{"text":"yu strongpela man","poem":2},{"text":"bilong kisim bek mi.","poem":3},{"text":"Bipo, taim mipela i pait","poem":1},{"text":"long ol birua,","poem":3},{"text":"yu bin lukautim mi gut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, ol samting","poem":1},{"text":"ol man nogut i laik kisim,","poem":2},{"text":"em yu no ken givim long ol.","poem":3},{"text":"Yu no ken larim ol","poem":1},{"text":"i mekim pasin nogut","poem":2},{"text":"em ol i pasim tok long mekim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yu no ken larim ol birua bilong mi","poem":1},{"text":"i winim mi long pait.","poem":3},{"text":"Ol i tok kros bilong pinisim mi.","poem":2},{"text":"Tasol dispela samting","poem":1},{"text":"ol i laik mekim long mi,","poem":3},{"text":"yu ken mekim i kamap long ol yet.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mobeta yu mekim paia","poem":1},{"text":"i pundaun antap long ol.","poem":2},{"text":"Na yu mas tromoi ol i go daun","poem":1},{"text":"long bikpela hul,","poem":3},{"text":"na bai ol i no inap","poem":2},{"text":"i kam antap gen.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ol man i kotim nating","poem":1},{"text":"ol arapela man,","poem":3},{"text":"yu no ken larim ol i winim kot.","poem":2},{"text":"Na mi laik bai samting nogut","poem":1},{"text":"i mas kamap","poem":2},{"text":"long ol man bilong pait,","poem":3},{"text":"na pinisim ol tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela, mi save olsem","poem":1},{"text":"yu save helpim ol rabisman","poem":2},{"text":"na ol manmeri i sot","poem":3},{"text":"long ol samting,","poem":4},{"text":"taim ol man i mekim nogut","poem":2},{"text":"long ol.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ol stretpela manmeri","poem":1},{"text":"bai i litimapim nem bilong yu,","poem":3},{"text":"na bai ol i stap wantaim yu oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}