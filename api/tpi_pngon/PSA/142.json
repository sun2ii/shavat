{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":142,"content":[{"type":"heading","content":["Wanpela man i prea long God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Maskil. Devit i stap long hul bilong ston na em i raitim dispela beten."]},{"type":"verse","number":1,"content":[{"text":"Mi singaut strong","poem":1},{"text":"long Bikpela","poem":2},{"text":"bilong em i helpim mi.","poem":3},{"text":"Mi wok strong long askim em","poem":1},{"text":"long helpim mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi save tokim em long olgeta wari","poem":1},{"text":"na olgeta hevi","poem":2},{"text":"i kamap long mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Taim bel bilong mi i hevi moa,","poem":1},{"text":"na mi ting bai mi bagarap,","poem":3},{"text":"Bikpela, yu save wanem samting","poem":2},{"text":"mi mas mekim.","poem":3},{"text":"Long rot bilong mi","poem":1},{"text":"ol man i haitim pinis","poem":2},{"text":"wanpela umben","poem":3},{"text":"bilong holimpas mi.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Mi lukluk klostu long mi,","poem":1},{"text":"tasol mi no lukim wanpela man","poem":2},{"text":"i ken helpim mi.","poem":3},{"text":"I no gat wanpela man i stap","poem":1},{"text":"bilong was long mi.","poem":2},{"text":"Na i no gat wanpela man","poem":1},{"text":"i sori long mi","poem":2},{"text":"na i laik helpim mi.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Olsem na Bikpela,","poem":1},{"text":"mi singaut long yu","poem":2},{"text":"bilong yu ken helpim mi.","poem":3},{"text":"Yu tasol yu wasman bilong mi.","poem":2},{"text":"Taim mi stap laip yet","poem":1},{"text":"mi laikim yu wanpela tasol","poem":2},{"text":"i mas i stap wantaim mi.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yu harim mi i singaut long yu","poem":1},{"text":"long helpim mi.","poem":2},{"text":"Long wanem, bel bilong mi","poem":1},{"text":"i hevi tru.","poem":2},{"text":"Ol man i mekim nogut long mi","poem":1},{"text":"ol i strong tumas,","poem":2},{"text":"na mi no inap winim ol.","poem":3},{"text":"Olsem na yu mas kisim bek mi","poem":1},{"text":"long han bilong ol.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kisim bek mi long dispela hevi","poem":1},{"text":"na mi ken i stap gut.","poem":2},{"text":"Olsem na long taim","poem":1},{"text":"ol manmeri bilong yu i bung","poem":3},{"text":"bai mi litimapim nem bilong yu.","poem":2},{"text":"Long wanem, yu bin mekim","poem":1},{"text":"gutpela pasin long mi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}