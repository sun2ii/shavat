{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":144,"content":[{"type":"heading","content":["King i tenkyu long God i helpim em long winim pait"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Mi litimapim nem","poem":1},{"text":"bilong God.","poem":3},{"text":"Em i strong long lukautim mi.","poem":2},{"text":"Em i save skulim mi gut","poem":1},{"text":"long pasin bilong pait,","poem":3},{"text":"na em i save mekim mi","poem":2},{"text":"i redi long pait.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Em i wasman bilong mi","poem":1},{"text":"na em i save banisim mi oltaim.","poem":2},{"text":"Na em i ples hait","poem":1},{"text":"na man bilong kisim bek mi.","poem":2},{"text":"Mi save bilip strong long em","poem":1},{"text":"na em i save mekim mi i stap gut.","poem":2},{"text":"Em i putim ol arapela lain manmeri","poem":1},{"text":"i stap aninit long mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bikpela, mipela manmeri","poem":1},{"text":"i wanem samting","poem":2},{"text":"na yu save tingting long mipela?","poem":3},{"text":"Mipela i olsem samting nating.","poem":2},{"text":"Olsem wanem na yu save wari","poem":1},{"text":"long mipela?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mipela i olsem win","poem":1},{"text":"i kamap wanpela taim tasol","poem":2},{"text":"long maus.","poem":3},{"text":"Mipela i stap sotpela taim tasol,","poem":1},{"text":"olsem tewel","poem":2},{"text":"san i save mekim i kamap","poem":3},{"text":"na i lus kwiktaim.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Bikpela, opim skai na kam daun.","poem":1},{"text":"Putim han bilong yu long ol maunten","poem":2},{"text":"na bai bikpela smok i kamap.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mekim lait bilong klaut i kamap","poem":1},{"text":"na rausim ol birua i go nabaut.","poem":2},{"text":"Sutim ol spia bilong yu","poem":1},{"text":"na mekim ol i ranawe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Putim han bilong yu i kam daun","poem":1},{"text":"na pulim mi i kam antap,","poem":3},{"text":"na bai mi lusim","poem":2},{"text":"bikpela wara i daun tumas,","poem":3},{"text":"na yu ken kisim bek mi","poem":2},{"text":"long han","poem":3},{"text":"bilong ol arapela lain manmeri.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Ol dispela man i no save tok tru,","poem":1},{"text":"ol i save giaman tasol","poem":2},{"text":"na mekim tok tru antap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"God, nau bai mi kirapim","poem":1},{"text":"nupela song long yu.","poem":2},{"text":"Bai mi paitim gita","poem":1},{"text":"na singim song long yu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu save helpim ol king i winim pait,","poem":1},{"text":"na yu kisim bek mi Devit,","poem":2},{"text":"wokman bilong yu.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Kisim bek mi","poem":1},{"text":"long han bilong ol birua","poem":2},{"text":"i save mekim nogut tru long mi.","poem":3},{"text":"Na kisim bek mi","poem":1},{"text":"long han bilong ol arapela lain.","poem":2},{"text":"Ol i no save tok tru.","poem":1},{"text":"Ol i save giaman tasol","poem":2},{"text":"na mekim tok tru antap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mipela i laik","poem":1},{"text":"bai ol yangpela pikinini man","poem":2},{"text":"bilong mipela","poem":3},{"text":"i ken kamap strong","poem":2},{"text":"olsem ol diwai.","poem":3},{"text":"Na mipela i laik bai ol pikinini meri","poem":1},{"text":"i ken kamap gutpela","poem":3},{"text":"olsem ol gutpela piksa","poem":2},{"text":"i save bilasim banis","poem":3},{"text":"bilong bikpela haus bilong king.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Mipela i laik bai ol gaden","poem":1},{"text":"i ken karim planti kaikai","poem":2},{"text":"na ol haus kaikai i ken pulap tru.","poem":3},{"text":"Na bai ol sipsip i ken karim","poem":1},{"text":"ol pikinini moa moa yet.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Na bai ol bulmakau","poem":1},{"text":"i ken karim planti pikinini","poem":3},{"text":"na i no gat pikinini i kamap nogut","poem":2},{"text":"na i no gat wanpela bai i dai.","poem":3},{"text":"Mipela i no laik","poem":1},{"text":"bai wanpela man o meri","poem":2},{"text":"i mas krai long hevi na pen","poem":3},{"text":"long ol rot bilong mipela.","poem":4}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lain manmeri i kisim","poem":1},{"text":"kain gutpela samting olsem,","poem":2},{"text":"ol i ken amamas.","poem":3},{"text":"Na ol manmeri i putim Bikpela","poem":1},{"text":"i stap God bilong ol,","poem":2},{"text":"ol tu i ken amamas.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}