yumi i sot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God, ol lain manmeri i stap nau","poem":1},{"text":"bai ol i tokaut long ol arapela lain","poem":2},{"text":"i kamap bihain","poem":3},{"text":"long ol samting yu mekim","poem":4},{"text":"na bai ol i litimapim","poem":2},{"text":"nem bilong yu.","poem":3},{"text":"Na bai ol i stori","poem":1},{"text":"long ol bikpela wok yu bin mekim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol man bai i tok","poem":1},{"text":"long strong bilong yu,","poem":2},{"text":"na long yu bikpela king tru.","poem":3},{"text":"Na mi yet bai mi tingting","poem":1},{"text":"long ol gutpela gutpela wok","poem":2},{"text":"bilong yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bai ol manmeri i stori","poem":1},{"text":"long ol strongpela wok","poem":2},{"text":"yu bin mekim,","poem":3},{"text":"na bai mi tokaut long yu","poem":2},{"text":"i gat biknem tru.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ol bai i stori","poem":1},{"text":"long ol gutpela pasin bilong yu","poem":3},{"text":"na ol bai i singim song","poem":2},{"text":"long marimari bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela i save laikim yumi tumas","poem":1},{"text":"na i save marimari long yumi.","poem":2},{"text":"Em i no save kros kwiktaim","poem":1},{"text":"na oltaim em i save sori","poem":2},{"text":"long yumi.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Em i save mekim gutpela pasin","poem":1},{"text":"long olgeta manmeri","poem":3},{"text":"na em i save marimari","poem":2},{"text":"long olgeta samting","poem":3},{"text":"em i bin wokim.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bikpela, olgeta samting","poem":1},{"text":"yu bin wokim","poem":2},{"text":"bai i litimapim nem bilong yu.","poem":3},{"text":"Na ol manmeri bilong yu","poem":1},{"text":"bai i tenkyu long yu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bai ol i tok long biknem bilong yu","poem":1},{"text":"i stap long olgeta ples yu bosim,","poem":3},{"text":"na bai ol i stori","poem":2},{"text":"long bikpela strong bilong yu.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Olsem na bai olgeta manmeri","poem":1},{"text":"i ken save long ol bikpela wok","poem":2},{"text":"yu bin mekim.","poem":3},{"text":"Na ol i ken save olsem","poem":1},{"text":"yu stap strongpela king,","poem":2},{"text":"na nem bilong yu i bikpela tru.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Yu bai i stap king","poem":1},{"text":"na bosim olgeta lain manmeri","poem":2},{"text":"oltaim oltaim.","poem":3},{"lineBreak":true},{"text":"God i save bihainim","poem":1},{"text":"ol promis bilong en.","poem":3},{"text":"Em i no save lusim wanpela.","poem":2},{"text":"Em i save mekim","poem":1},{"text":"ol gutpela samting tasol","poem":2},{"text":"bilong helpim yumi.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Em i save helpim","poem":1},{"text":"olgeta manmeri i gat hevi","poem":3},{"text":"na em i save litimapim","poem":2},{"text":"olgeta manmeri","poem":3},{"text":"ol arapela man i daunim ol.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Olgeta samting i gat laip","poem":1},{"text":"i save lukluk i go long em","poem":3},{"text":"na em i save givim kaikai long ol","poem":2},{"text":"taim ol i hangre.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Em i save givim kaikai samting","poem":1},{"text":"long olgeta","poem":2},{"text":"inap long ol i stap gut.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"God i save bihainim stretpela pasin","poem":1},{"text":"na em i save marimari long yumi","poem":2},{"text":"long olgeta samting","poem":3},{"text":"em i mekim.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Wanem ol manmeri i save bel tru","poem":1},{"text":"na i singaut long em,","poem":3},{"text":"em i save stap klostu long ol.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wanem ol manmeri","poem":1},{"text":"i save pret long em,","poem":3},{"text":"em i save givim ol samting long ol.","poem":2},{"text":"Na em i save harim krai bilong ol","poem":1},{"text":"na kisim bek ol.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Em i save was gut long ol manmeri","poem":1},{"text":"i save laikim em tru.","poem":2},{"text":"Tasol em bai i bagarapim","poem":1},{"text":"ol manmeri","poem":2},{"text":"i save mekim pasin nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bai mi litimapim","poem":1},{"text":"nem bilong Bikpela oltaim.","poem":2},{"text":"Na yupela olgeta samting","poem":1},{"text":"em i bin wokim,","poem":3},{"text":"yupela tu i mas litimapim","poem":2},{"text":"nem bilong en oltaim oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}