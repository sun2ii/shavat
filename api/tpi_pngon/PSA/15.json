{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":15,"content":[{"type":"heading","content":["Pasin God i laik yumi mekim"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, husat inap i stap","poem":1},{"text":"long haus bilong yu?","poem":2},{"text":"Husat inap sindaun long Saion,","poem":1},{"text":"dispela maunten bilong yu yet?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Man i bihainim laik bilong God","poem":1},{"text":"long olgeta samting,","poem":3},{"text":"na i mekim stretpela pasin oltaim,","poem":2},{"lineBreak":true},{"text":"na i save tok tru oltaim,","poem":2},{"lineBreak":true},{"text":"em bai i stap long haus bilong yu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Em i no save krungutim","poem":1},{"text":"gutpela nem bilong narapela man.","poem":2},{"text":"Em i no save mekim nogut","poem":1},{"text":"long ol pren,","poem":3},{"text":"na em i no save mekim","poem":2},{"text":"ol kain kain tok win","poem":3},{"text":"long ol arapela man.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Em i no laikim ol man","poem":1},{"text":"God i givim baksait pinis long ol.","poem":2},{"text":"Tasol em i givim biknem long ol man","poem":1},{"text":"i bihainim tok bilong God.","poem":2},{"text":"Em i save inapim ol promis","poem":1},{"text":"em i bin mekim,","poem":3},{"text":"maski dispela pasin i givim","poem":2},{"text":"bikpela hevi long em.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Em i save larim ol arapela man","poem":1},{"text":"i kisim dinau long em,","poem":3},{"text":"na taim ol i bekim,","poem":2},{"lineBreak":true},{"text":"em i no save pulim winmani","poem":2},{"text":"long ol.","poem":3},{"text":"Ol man i no inap grisim em","poem":1},{"text":"long mani","poem":3},{"text":"bilong mekim em i kotim","poem":2},{"text":"ol man i no gat rong.","poem":3},{"text":"Man i bihainim ol dispela pasin,","poem":1},{"text":"em i no inap pundaun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}