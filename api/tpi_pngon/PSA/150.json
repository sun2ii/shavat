:"Paitim ol gita samting","poem":1},{"text":"na mekim olkain musik","poem":3},{"text":"na litimapim nem bilong en.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Paitim kundu na mekim singsing","poem":1},{"text":"na litimapim nem bilong en.","poem":2},{"text":"Paitim gita na winim mambu","poem":1},{"text":"na litimapim nem bilong en.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Paitim ol plet bras","poem":1},{"text":"na mekim krai bilong en i go","poem":3},{"text":"na litimapim nem bilong Bikpela.","poem":2},{"text":"Paitim ol plet bras strong moa","poem":1},{"text":"bai krai i kamap bikpela","poem":3},{"text":"na litimapim nem bilong Bikpela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yupela olgeta samting i gat laip,","poem":1},{"text":"litimapim nem bilong Bikpela!","poem":2},{"text":"Litimapim nem bilong Bikpela!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}