{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":19,"content":[{"type":"heading","content":["Ol samting God i wokim i save soim yumi biknem bilong em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Skai i soim yumi olsem","poem":1},{"text":"God em i nambawan tru.","poem":2},{"text":"Olgeta samting bilong antap","poem":1},{"text":"i soim yumi","poem":2},{"text":"gutpela wok bilong em.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Olgeta de i save tokaut","poem":1},{"text":"long dispela samting.","poem":2},{"text":"Na olgeta nait i tokim yumi gen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tulait na tudak i no gat maus","poem":1},{"text":"na i no inap toktok.","poem":2},{"text":"Yumi no save harim nek","poem":1},{"text":"bilong dispela tupela samting.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tasol tulait na tudak","poem":1},{"text":"i skulim ol manmeri","poem":2},{"text":"long olgeta hap bilong graun.","poem":3},{"text":"Na tok bilong tupela","poem":1},{"text":"i go inap long olgeta ples.","poem":2},{"lineBreak":true},{"text":"Long skai God i sanapim","poem":1},{"text":"wanpela haus sel bilong san.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"San i kam ausait,","poem":1},{"text":"olsem man i marit na i belgut","poem":2},{"text":"na i lusim rum bilong en","poem":3},{"lineBreak":true},{"text":"na i kam ausait.","poem":3},{"text":"San i save amamas","poem":1},{"text":"na bihainim rot bilong en,","poem":3},{"text":"olsem man bilong ran","poem":2},{"text":"i redi long resis.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"San i save kamap","poem":1},{"text":"long arere bilong skai","poem":3},{"text":"na i wokabaut i go long hapsait.","poem":2},{"text":"I no gat wanpela samting","poem":1},{"text":"inap hait long hat bilong en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lo bilong Bikpela em i stret olgeta,","poem":1},{"text":"na i save givim","poem":2},{"text":"nupela laip long yumi.","poem":3},{"text":"Tok bilong Bikpela em i samting","poem":1},{"text":"yumi inap bilip tru long en.","poem":2},{"text":"Em i save givim gutpela tingting","poem":1},{"text":"long ol man i no gat planti save.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela i save skulim yumi","poem":1},{"text":"long gutpela tok tumas.","poem":2},{"text":"Dispela tok i save mekim","poem":1},{"text":"bel bilong yumi i amamas.","poem":2},{"text":"Lo bilong God i nambawan tru,","poem":1},{"text":"na i givim gutpela save long yumi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Man i lotu long Bikpela","poem":1},{"text":"em i mekim gutpela pasin.","poem":2},{"text":"Na dispela pasin","poem":1},{"text":"i save stap oltaim oltaim.","poem":2},{"text":"Bikpela i save tokim yumi","poem":1},{"text":"long olgeta pasin","poem":2},{"text":"yumi mas mekim,","poem":3},{"text":"na dispela tok i tru","poem":2},{"text":"na i stret olgeta.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Tok bilong Bikpela i winim gol.","poem":1},{"lineBreak":true},{"text":"Em i winim gol i gutpela tru,","poem":1},{"text":"olsem na yumi mas laikim","poem":2},{"text":"dispela tok moa moa yet.","poem":3},{"text":"Lo bilong Bikpela i swit tumas,","poem":1},{"text":"na i winim hani.","poem":2},{"text":"Em i winim tru","poem":1},{"text":"gutpela switpela hani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lo bilong yu i givim save","poem":1},{"text":"long mi, wokman bilong yu.","poem":2},{"text":"Mi bihainim lo bilong yu,","poem":1},{"text":"olsem na yu save mekim","poem":2},{"text":"sindaun bilong mi","poem":3},{"text":"i kamap gutpela tru.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tasol husat inap save","poem":1},{"text":"long olgeta rong bilong em yet?","poem":2},{"text":"Mi mekim sampela rong","poem":1},{"text":"em mi no save long ol,","poem":3},{"text":"olsem na yu mas rausim","poem":2},{"text":"ol dispela rong","poem":3},{"text":"na mekim mi i kamap klin","poem":2},{"text":"long ai bilong yu.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Mi wokman bilong yu,","poem":1},{"text":"na yu mas was gut long mi,","poem":2},{"text":"bai mi no ken bikhet.","poem":3},{"text":"Yu no ken larim pasin bilong bikhet","poem":1},{"text":"i bosim mi.","poem":2},{"text":"Olsem na bai mi stap stret","poem":1},{"text":"na mi no mekim bikpela rong.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bikpela, mi laik bai tok bilong mi","poem":1},{"text":"na tingting bilong mi","poem":2},{"text":"i ken i orait long ai bilong yu.","poem":3},{"text":"Bikpela, yu ples hait bilong mi","poem":1},{"text":"na helpim bilong mi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}