poem":1},{"text":"yu tingting pinis long mekim,","poem":3},{"text":"em i ken helpim yu","poem":2},{"text":"na bai yu inap mekim.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Olsem na taim yu winim pait pinis,","poem":1},{"text":"bai mipela i amamas long yu i win.","poem":2},{"text":"Na bai mipela i tingim dispela","poem":1},{"text":"na litimapim nem","poem":2},{"text":"bilong God bilong yumi.","poem":3},{"text":"Bikpela i ken harim","poem":1},{"text":"olgeta prea bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nau mi save pinis,","poem":1},{"text":"Bikpela i save helpim mi,","poem":2},{"text":"dispela king","poem":3},{"text":"em yet i bin makim.","poem":4},{"text":"Em i stap","poem":1},{"text":"long gutpela ples bilong em","poem":2},{"text":"long heven,","poem":3},{"text":"na em i harim prea bilong mi.","poem":2},{"text":"Long strong bilong em yet","poem":1},{"text":"em i helpim mi,","poem":3},{"text":"na mi save winim tru ol pait.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sampela lain i save bilip","poem":1},{"text":"long ol karis bilong pait,","poem":3},{"text":"na sampela lain i bilip","poem":2},{"text":"long ol hos bilong ol.","poem":3},{"text":"Tasol mipela i bilip","poem":1},{"text":"long strong bilong God,","poem":2},{"text":"Bikpela bilong mipela.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Dispela ol manmeri bai i pundaun","poem":1},{"text":"na lus olgeta.","poem":2},{"text":"Tasol mipela bai i kirap","poem":1},{"text":"na sanap strong.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bikpela, yu mas helpim mipela","poem":1},{"text":"na bai mipela i win.","poem":2},{"text":"Bikpela, yu King bilong mipela.","poem":1},{"lineBreak":true},{"text":"Yu mas helpim mipela","poem":1},{"text":"taim mipela i singaut long yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiL