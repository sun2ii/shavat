verse","number":4,"content":[{"text":"Man i no mekim pasin nogut,","poem":1},{"text":"na bel bilong en i klin,","poem":3},{"text":"man i no save lotu","poem":2},{"text":"long ol giaman god,","poem":3},{"text":"na man i no tok tru antap","poem":2},{"text":"bilong giamanim narapela man,","poem":3},{"text":"kain man olsem em inap.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God bai i mekim gut","poem":1},{"text":"long dispela kain man.","poem":2},{"text":"God bai i kisim bek em","poem":1},{"text":"na kolim em stretpela man.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kain man olsem i save painim God.","poem":1},{"lineBreak":true},{"text":"Em i save go klostu","poem":1},{"text":"long God bilong Jekop.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yupela dua, yupela op.","poem":1},{"lineBreak":true},{"text":"Yupela dua bilong bipo tru,","poem":1},{"text":"yupela op bikpela,","poem":3},{"text":"bai nambawan king","poem":2},{"text":"i ken i go insait.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Nambawan king, em husat?","poem":1},{"lineBreak":true},{"text":"Em God wanpela tasol.","poem":1},{"lineBreak":true},{"text":"Em i gat bikpela strong tru,","poem":1},{"text":"na i save win long ol pait.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yupela dua, yupela op.","poem":1},{"lineBreak":true},{"text":"Yupela dua bilong bipo tru,","poem":1},{"text":"yupela op bikpela,","poem":3},{"text":"bai nambawan king","poem":2},{"text":"i ken i go insait.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Nambawan king, em husat?","poem":1},{"lineBreak":true},{"text":"Em dispela God i save bosim","poem":1},{"text":"bikpela lain ami.","poem":2},{"text":"Em wanpela tasol","poem":1},{"text":"em i nambawan king.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/25.json","