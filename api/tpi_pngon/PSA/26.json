{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":26,"content":[{"type":"heading","content":["Prea bilong stretpela man"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, yu kolim mi","poem":1},{"text":"stretpela man.","poem":2},{"text":"Long wanem, mi save mekim","poem":1},{"text":"stretpela pasin,","poem":3},{"text":"na mi bilip olgeta long yu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God, traim olgeta pasin bilong mi.","poem":1},{"lineBreak":true},{"text":"Na skelim bel na tingting bilong mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yu save marimari long mi","poem":1},{"text":"na yu stiaim mi oltaim.","poem":2},{"text":"Yu save go paslain long mi oltaim","poem":1},{"text":"na yu no save lusim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi no save raun","poem":1},{"text":"wantaim ol man nogut.","poem":2},{"text":"Mi no save wokabaut","poem":1},{"text":"wantaim ol man bilong giaman.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mi no save laik tru","poem":1},{"text":"long raun wantaim ol man nogut.","poem":2},{"text":"Mi save abrusim ol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bikpela, mi wasim han bilong mi","poem":1},{"text":"bilong soim yu mi no gat rong.","poem":2},{"text":"Na mi wokabaut","poem":1},{"text":"raunim alta bilong yu,","poem":3},{"text":"na mi lotu long yu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mi mekim olsem,","poem":1},{"text":"na mi singim wanpela song","poem":2},{"text":"bilong tenkyu long yu,","poem":3},{"text":"na mi tokim ol manmeri","poem":2},{"text":"long ol gutpela wok yu bin mekim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela, mi laikim tru","poem":1},{"text":"haus bilong yu,","poem":3},{"text":"em dispela ples","poem":2},{"text":"biknem bilong yu i stap long en.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Taim yu mekim save","poem":1},{"text":"long ol man bilong mekim sin,","poem":3},{"text":"yu no ken pinisim laip bilong mi.","poem":2},{"text":"Yu no ken kilim mi i dai","poem":1},{"text":"wantaim ol man i save kilim","poem":2},{"text":"ol arapela man.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ol dispela man","poem":1},{"text":"i save mekim pasin nogut oltaim.","poem":2},{"text":"Ol i save givim mani long ol man","poem":1},{"text":"bilong grisim ol long mekim nogut","poem":2},{"text":"long ol arapela manmeri.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tasol mi yet","poem":1},{"text":"mi save mekim stretpela pasin.","poem":2},{"text":"Yu ken marimari long mi","poem":1},{"text":"na kisim bek mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mi save sanap strong.","poem":1},{"lineBreak":true},{"text":"I no gat wanpela samting","poem":1},{"text":"i ken bagarapim mi.","poem":2},{"text":"Bai mi litimapim","poem":1},{"text":"nem bilong yu, God,","poem":3},{"text":"namel long ol manmeri","poem":2},{"text":"i bung bilong lotu.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}