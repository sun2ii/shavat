","poem":2},{"text":"i save mekim rong.","poem":3},{"text":"Yu no ken daunim mi","poem":1},{"text":"wantaim ol man","poem":2},{"text":"i save mekim switpela tok,","poem":3},{"text":"tasol tingting nogut tasol","poem":2},{"text":"i save pulap long bel bilong ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mekim save long ol dispela man","poem":1},{"text":"inap long pasin nogut","poem":2},{"text":"ol i bin mekim.","poem":3},{"text":"Bekim pe nogut long ol.","poem":1},{"lineBreak":true},{"text":"Inapim olgeta sin bilong ol.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ol i no save tingting","poem":1},{"text":"long bikpela wok bilong Bikpela","poem":2},{"lineBreak":true},{"text":"na long ol samting","poem":2},{"text":"em i bin mekim.","poem":3},{"text":"Olsem na em bai i bagarapim ol,","poem":1},{"text":"na pinisim ol olgeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mi litimapim nem bilong Bikpela.","poem":1},{"lineBreak":true},{"text":"Mi krai long em","poem":1},{"text":"na em i harim mi pinis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God tasol i save was long mi","poem":1},{"text":"na banisim mi.","poem":2},{"text":"Olsem na mi save bilip long em.","poem":1},{"lineBreak":true},{"text":"Bikpela i save helpim mi,","poem":1},{"text":"olsem na mi amamas moa","poem":2},{"text":"long em,","poem":3},{"text":"na mi singim ol song","poem":2},{"text":"bilong litimapim nem","poem":3},{"text":"bilong em.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela i save lukautim","poem":1},{"text":"ol manmeri bilong em.","poem":2},{"text":"Em i sambai long king bilong em","poem":1},{"text":"na helpim em.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"God, helpim ol manmeri bilong yu.","poem":1},{"lineBreak":true},{"text":"Mekim gut","poem":1},{"text":"long dispela lain manmeri","poem":2},{"text":"yu makim bilong yu yet.","poem":3},{"text":"Yu ken i stap wasman bilong ol,","poem":1},{"text":"na lukautim ol gut oltaim oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}