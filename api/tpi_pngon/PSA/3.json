{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":3,"content":[{"type":"heading","content":["Long moning wanpela man i prea bilong kisim strong"]},{"type":"hebrew_subtitle","content":["Devit i ranawe long Apsalom, pikinini man bilong en, na long dispela taim em i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, ol birua bilong mi","poem":1},{"text":"i kamap planti moa.","poem":2},{"text":"Ol i wok long mekim nogut long mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ol i tokim mi olsem,","poem":1},{"text":"“God bai i no inap helpim yu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tasol tok bilong ol i no tru.","poem":1},{"lineBreak":true},{"text":"God, yu olsem hap plang bilong pait","poem":1},{"text":"i haitim mi.","poem":2},{"text":"Yu tasol yu mekim mi i win.","poem":1},{"lineBreak":true},{"text":"Yu tasol yu pinisim","poem":1},{"text":"bel hevi bilong mi","poem":3},{"text":"na mekim mi i sanap strong.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi save singaut","poem":1},{"text":"long God i helpim mi.","poem":2},{"text":"Em i stap long maunten","poem":1},{"text":"bilong em yet","poem":3},{"text":"na em i harim singaut bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi save slip long bet na mi slip i dai.","poem":1},{"lineBreak":true},{"text":"Na bihain mi save kirap gen","poem":1},{"text":"na mi stap gut, long wanem,","poem":2},{"text":"God i save lukautim mi.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"10,000 birua i banisim mi","poem":1},{"text":"long olgeta hap,","poem":3},{"text":"tasol mi no ken pret long ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bikpela, yu kam.","poem":1},{"lineBreak":true},{"text":"Yu God bilong mi,","poem":1},{"text":"yu kam helpim mi.","poem":2},{"text":"Yu save paitim nabaut","poem":1},{"text":"ol birua bilong mi.","poem":2},{"text":"Yu save brukim tit","poem":1},{"text":"bilong ol man nogut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu wanpela tasol","poem":1},{"text":"yu save kisim bek mipela","poem":2},{"lineBreak":true},{"text":"na mipela i no save bagarap.","poem":2},{"text":"Yu ken mekim gut","poem":1},{"text":"long ol manmeri bilong yu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}