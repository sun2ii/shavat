{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":33,"content":[{"type":"heading","content":["Song bilong litimapim nem bilong God"]},{"type":"verse","number":1,"content":[{"text":"Yupela ol stretpela manmeri,","poem":1},{"text":"yupela i mas amamas","poem":2},{"text":"long olgeta samting","poem":3},{"text":"Bikpela i mekim.","poem":4},{"text":"Yupela manmeri i save bihainim","poem":1},{"text":"tok bilong God,","poem":3},{"text":"yupela litimapim nem bilong em.","poem":2},{"text":"Dispela em i gutpela pasin","poem":1},{"text":"ol stretpela manmeri","poem":2},{"text":"i save mekim.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mekim musik long kulele","poem":1},{"text":"na litimapim nem bilong God.","poem":2},{"text":"Paitim gita i gat 10-pela string","poem":1},{"text":"na mekim musik long em.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Singim nupela song long em.","poem":1},{"lineBreak":true},{"text":"Paitim gita","poem":1},{"text":"na mekim gutpela musik tru,","poem":2},{"lineBreak":true},{"text":"na singaut strong wantaim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tok bilong Bikpela i tru olgeta.","poem":1},{"lineBreak":true},{"text":"Em i save bihainim stretpela pasin","poem":1},{"text":"na mekim olgeta wok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bikpela i laikim olgeta gutpela pasin","poem":1},{"text":"na olgeta samting i stret.","poem":2},{"text":"Oltaim Bikpela i save laikim","poem":1},{"text":"olgeta manmeri bilong graun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God i bin tok tasol,","poem":1},{"text":"na san na mun na ol sta","poem":2},{"text":"i kamap long skai.","poem":3},{"text":"Em i tok tasol","poem":1},{"text":"na olgeta samting i kamap antap.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Em i kisim solwara na bungim","poem":1},{"text":"long wanpela hap tasol,","poem":3},{"text":"olsem man i pulimapim wara","poem":2},{"text":"long wanpela sospen tasol.","poem":3},{"text":"Em i mekim as bilong solwara","poem":1},{"text":"i stap daunbilo tru","poem":2},{"text":"long ples bilong en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Olgeta manmeri long graun","poem":1},{"text":"i mas pret long Bikpela","poem":2},{"lineBreak":true},{"text":"na i stap aninit long em.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Long wanem, em i bin tok tasol,","poem":1},{"text":"na dispela graun i kamap.","poem":2},{"text":"Em i mekim strongpela tok,","poem":1},{"text":"na olgeta samting i stap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bikpela i save mekim tingting","poem":1},{"text":"bilong ol lain manmeri","poem":2},{"text":"i go lus nating.","poem":3},{"text":"Ol manmeri i save pasim tok","poem":1},{"text":"long wokim wanpela samting,","poem":3},{"text":"na em i save pasim rot bilong ol","poem":2},{"lineBreak":true},{"text":"na ol i no inap mekim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tasol taim Bikpela i tok","poem":1},{"text":"long mekim wanpela samting,","poem":3},{"text":"orait tok bilong en","poem":2},{"text":"i stap strong oltaim.","poem":3},{"text":"Em i tingting","poem":1},{"text":"long mekim wanpela samting,","poem":3},{"text":"na dispela tingting","poem":2},{"text":"i stap oltaim oltaim.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol dispela lain","poem":1},{"text":"Bikpela i stap God bilong ol,","poem":3},{"text":"ol i ken amamas.","poem":2},{"text":"Ol dispela manmeri","poem":1},{"text":"em i makim bilong em yet,","poem":3},{"text":"ol i ken amamas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"God i stap long heven","poem":1},{"text":"na i lukluk i go daun.","poem":2},{"text":"Em i lukim olgeta manmeri.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Em i stap king long ples bilong em,","poem":1},{"text":"na i lukluk i go daun","poem":2},{"text":"long olgeta manmeri bilong graun.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Em yet i save kamapim tingting","poem":1},{"text":"bilong olgeta manmeri,","poem":3},{"text":"na em i save lukim","poem":2},{"text":"olgeta pasin ol i mekim.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"King i no save winim pait","poem":1},{"text":"na rausim ol birua","poem":2},{"text":"long strong bilong bikpela ami tasol.","poem":3},{"text":"Soldia i no save winim ol birua","poem":1},{"text":"long strong bilong em yet.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ol hos bilong pait","poem":1},{"text":"i no inap helpim ol soldia","poem":2},{"text":"long winim pait.","poem":3},{"text":"Strong bilong hos","poem":1},{"text":"i no inap kisim bek","poem":2},{"text":"ol soldia i lus long pait.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Tasol harim.","poem":1},{"lineBreak":true},{"text":"Bikpela i save was long ol manmeri","poem":1},{"text":"i stap aninit long em.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Em i save lukautim","poem":1},{"text":"ol dispela manmeri","poem":3},{"text":"bai ol i no i dai.","poem":2},{"text":"Na em i save givim kaikai long ol","poem":1},{"text":"long taim bilong hangre,","poem":3},{"text":"bai ol i no ken i dai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yumi wetim Bikpela i helpim yumi.","poem":1},{"lineBreak":true},{"text":"Bikpela tasol i save helpim yumi.","poem":1},{"lineBreak":true},{"text":"Em i olsem hap plang bilong pait","poem":1},{"text":"na yumi hait long em.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yumi bilip tru","poem":1},{"text":"long gutpela nem bilong em.","poem":2},{"text":"Olsem na yumi amamas long em.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bikpela, mipela i bilip","poem":1},{"text":"na wet long yu i helpim mipela.","poem":2},{"text":"Yu mas marimari long mipela","poem":1},{"text":"oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}