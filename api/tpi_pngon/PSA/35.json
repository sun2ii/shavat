{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":35,"content":[{"type":"heading","content":["Man i prea long God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song."]},{"type":"verse","number":1,"content":[{"text":"Bikpela,","poem":1},{"text":"yu mas krosim ol man","poem":2},{"text":"i gat kros long mi.","poem":3},{"text":"Yu mas pait long ol man","poem":1},{"text":"i save pait long mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kisim klos pait","poem":1},{"text":"wantaim hap plang bilong pait,","poem":3},{"text":"na kam helpim mi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kisim spia na akis","poem":1},{"text":"na kam pait","poem":2},{"text":"long ol man i ranim mi.","poem":3},{"text":"Yu tokim mi olsem,","poem":1},{"text":"yu man bilong helpim mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ol dispela man i laik kilim mi i dai.","poem":1},{"lineBreak":true},{"text":"Yu mas winim ol long pait","poem":1},{"text":"na mekim ol i sem.","poem":2},{"text":"Ol i pasim tok bilong bagarapim mi.","poem":1},{"lineBreak":true},{"text":"Yu mas ranim ol na paulim ol tru.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bikpela, ensel bilong yu","poem":1},{"text":"i ken rausim","poem":2},{"text":"ol dispela man nogut,","poem":3},{"text":"olsem win i rausim pipia gras.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ensel bilong yu i ken ranim ol i go,","poem":1},{"text":"na mekim rot bilong ol","poem":2},{"text":"i kamap tudak na i wel nogut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi no bin mekim rong long ol,","poem":1},{"text":"tasol ol i haitim umben","poem":2},{"text":"bilong bagarapim mi.","poem":3},{"text":"Na ol i wokim wanpela hul","poem":1},{"text":"bilong mi ken pundaun long en.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tasol taim ol i no save yet,","poem":1},{"text":"yu mekim bagarap i kisim ol.","poem":2},{"text":"Na dispela umben ol i putim","poem":1},{"text":"bilong bagarapim mi,","poem":3},{"text":"yu mekim ol yet i bagarap long en.","poem":2},{"text":"Na ol yet bai i pundaun","poem":1},{"text":"long dispela hul ol i wokim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bikpela bai i mekim olsem,","poem":1},{"text":"na bai mi amamas long em.","poem":2},{"text":"Bai mi belgut long em i helpim mi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na bai mi tenkyu tru long God","poem":1},{"text":"na tok olsem,","poem":3},{"text":"“Bikpela, i no gat wanpela","poem":2},{"text":"olsem yu.","poem":3},{"text":"Yu save helpim gut","poem":2},{"text":"ol man i no gat strong,","poem":3},{"text":"na ol man i strong tumas","poem":2},{"text":"i no inap bagarapim ol.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ol man bilong giaman","poem":1},{"text":"i sutim tok long mi","poem":2},{"text":"long sampela pasin nogut","poem":3},{"text":"mi no bin mekim.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Mi save mekim gutpela pasin","poem":1},{"text":"long ol,","poem":3},{"text":"na ol i bekim pasin nogut long mi.","poem":2},{"text":"Olsem na bel bilong mi i hevi tru.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tasol mi no mekim olsem long ol.","poem":1},{"text":"Nogat tru.","poem":2},{"text":"Taim ol i gat sik mi sori nogut tru,","poem":1},{"text":"na mi pasim laplap bilong sori.","poem":2},{"text":"Mi tambu long kaikai","poem":1},{"text":"na dispela i givim hevi long mi yet.","poem":2},{"text":"Na mi beten bai yu ken helpim ol.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I olsem mi bel hevi","poem":1},{"text":"long pren na brata bilong mi.","poem":2},{"text":"Mi wokabaut olsem man i sori","poem":1},{"text":"na i krai long mama i bin dai.","poem":2},{"text":"Mi bel hevi tru","poem":1},{"text":"na mi krai na sori i stap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tasol taim mi painim hevi,","poem":1},{"text":"ol i bung na amamas.","poem":2},{"text":"Ol i bung bilong daunim mi.","poem":1},{"lineBreak":true},{"text":"Sampela man mi no save long ol,","poem":1},{"text":"ol i no malolo","poem":2},{"text":"long sutim tok nogut long mi.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Ol i tok bilas moa yet","poem":1},{"text":"na givim hevi long mi.","poem":2},{"text":"Ol i no laikim mi","poem":1},{"text":"na ol i pes strong long mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bikpela, hamas taim moa","poem":1},{"text":"bai yu larim ol?","poem":2},{"text":"Yu mas kisim bek mi","poem":1},{"text":"na ol i no ken bagarapim mi.","poem":2},{"text":"Ol i olsem laion i laik kilim mi,","poem":1},{"text":"olsem na yu mas kisim bek mi","poem":2},{"text":"long han bilong ol.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Sapos yu mekim olsem,","poem":1},{"text":"bai mi tenkyu long yu","poem":2},{"text":"namel long planti lain manmeri","poem":3},{"text":"i bung wantaim.","poem":4},{"text":"Tru tumas,","poem":1},{"text":"bai mi litimapim nem bilong yu","poem":2},{"text":"namel long bikpela lain manmeri.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sampela man i birua nating long mi.","poem":1},{"lineBreak":true},{"text":"Nogut yu larim ol i amamas","poem":1},{"text":"long daunim mi.","poem":2},{"text":"Ol i bel nogut nating long mi,","poem":1},{"text":"olsem na yu no ken larim ol","poem":2},{"text":"i amamas long ol hevi bilong mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ol i no save toktok liklik","poem":1},{"text":"long sindaun gut","poem":2},{"text":"wantaim ol arapela man.","poem":3},{"text":"Ol i tok long bagarapim ol man","poem":1},{"text":"i sindaun gut long ples.","poem":2},{"text":"Ol i save kibung","poem":1},{"text":"bilong giamanim ol gutpela man","poem":2},{"lineBreak":true},{"text":"na bagarapim ol.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ol i save bikmaus","poem":1},{"text":"na sutim tok long mi olsem,","poem":3},{"text":"“Tru tumas, mipela i lukim yu","poem":2},{"text":"i mekim ol pasin nogut.”","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Tasol Bikpela,","poem":1},{"text":"yu lukim pinis ol dispela man.","poem":2},{"text":"Olsem na nogut yu pasim maus","poem":1},{"text":"i stap.","poem":2},{"text":"Bikpela, yu no ken i stap","poem":1},{"text":"longwe long mi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yu God na Bikpela bilong mi,","poem":1},{"text":"yu kirap na kam helpim mi.","poem":2},{"text":"Sanap na tokaut","poem":1},{"text":"bilong strongim tok bilong mi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"yu save mekim stretpela pasin.","poem":2},{"text":"Yu helpim mi","poem":1},{"text":"na bai ol birua i save olsem","poem":2},{"text":"mi bihainim stretpela pasin.","poem":3},{"text":"Yu no ken larim ol i amamas","poem":1},{"text":"long lukim mi i bagarap.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yu no ken larim ol","poem":1},{"text":"i toktok long ol yet olsem,","poem":3},{"text":"“Gutpela tumas!","poem":2},{"lineBreak":true},{"text":"Samting yumi laik mekim,","poem":2},{"text":"nau yumi mekim pinis.”","poem":3},{"text":"Yu no ken larim ol i tok olsem,","poem":1},{"text":"“Yumi bagarapim em pinis.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ol i amamas","poem":1},{"text":"long hevi i kamap long mi,","poem":3},{"text":"olsem na yu mas semim ol","poem":2},{"text":"na paulim ol tru.","poem":3},{"text":"Ol i litimapim nem bilong ol yet","poem":1},{"text":"bilong daunim mi,","poem":3},{"text":"olsem na yu mas semim ol","poem":2},{"text":"na daunim nem bilong ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tasol ol man i laik","poem":1},{"text":"bai yu kolim mi stretpela man,","poem":3},{"text":"ol i ken singaut amamas","poem":2},{"text":"na i stap belgut.","poem":3},{"text":"Oltaim ol i ken tok olsem,","poem":1},{"text":"“Bikpela em i nambawan tru.","poem":2},{"lineBreak":true},{"text":"Em i save laikim tumas","poem":2},{"text":"bai wokman bilong en","poem":3},{"text":"i ken i stap gut.”","poem":4}]},{"type":"verse","number":28,"content":[{"text":"Olsem na bai mi tokaut","poem":1},{"text":"long stretpela pasin bilong yu,","poem":3},{"text":"na litimapim nem bilong yu oltaim,","poem":2},{"text":"long san na long nait.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}