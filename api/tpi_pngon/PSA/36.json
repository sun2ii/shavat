{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":36,"content":[{"type":"heading","content":["Pasin nogut bilong ol man"]},{"type":"hebrew_subtitle","content":["Devit, wokman bilong Bikpela, em i raitim dispela song. Em i song bilong man bilong bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Sin i stap long bel","poem":1},{"text":"bilong man nogut,","poem":3},{"text":"na i givim sampela tok long em.","poem":2},{"text":"Dispela kain man","poem":1},{"text":"i no save pret liklik long God.","poem":2},{"text":"Nogat tru.","poem":1},{"lineBreak":true},{"text":"Em i givim baksait long God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Em i save hambak long em yet","poem":1},{"text":"na i ting olsem,","poem":3},{"text":"“Mi namba wan tru.","poem":2},{"lineBreak":true},{"text":"God i no inap painimaut","poem":2},{"text":"long ol pasin nogut mi bin mekim,","poem":3},{"text":"na em i no inap kotim mi.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oltaim dispela man i save tok","poem":1},{"text":"long mekim pasin nogut","poem":2},{"lineBreak":true},{"text":"na long giamanim ol arapela man.","poem":2},{"text":"Em i no gat gutpela tingting moa","poem":1},{"text":"bilong mekim gutpela pasin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taim em i slip long bet,","poem":1},{"text":"na em i save tingting long ol rot","poem":2},{"text":"bilong mekim ol pasin nogut.","poem":3},{"text":"Em i save bihainim rot nogut tasol,","poem":1},{"text":"na em i no save givim baksait","poem":2},{"text":"long pasin nogut.","poem":3}]},{"type":"heading","content":["Gutpela pasin bilong God"]},{"type":"verse","number":5,"content":[{"text":"Bikpela, sori bilong yu i no liklik.","poem":1},{"lineBreak":true},{"text":"Mak bilong en i go inap long skai.","poem":1},{"lineBreak":true},{"text":"Yu bihainim pasin tru tasol,","poem":1},{"text":"na em tu i no liklik.","poem":2},{"text":"Mak bilong en i go","poem":1},{"text":"inap long ol klaut antap.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Stretpela pasin bilong yu i moa yet.","poem":1},{"lineBreak":true},{"text":"Em i antap tru","poem":1},{"text":"olsem ol maunten bilong God.","poem":2},{"text":"Mipela i no inap save long as","poem":1},{"text":"bilong stretpela kot yu mekim.","poem":2},{"text":"Em i daun tumas,","poem":1},{"text":"olsem solwara i daun tru.","poem":2},{"text":"Bikpela, yu save lukautim","poem":1},{"text":"ol man na ol abus","poem":3},{"text":"na ol i stap gut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God, sori bilong yu i gutpela tumas,","poem":1},{"text":"na mipela i save laikim tru.","poem":2},{"text":"Olsem na ol manmeri nabaut","poem":1},{"text":"i save go long yu na hait,","poem":3},{"text":"olsem ol pikinini kakaruk","poem":2},{"text":"i save hait aninit long wing","poem":3},{"text":"bilong mama kakaruk.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Yu gat planti kaikai","poem":1},{"text":"long haus bilong yu,","poem":3},{"text":"olsem na ol manmeri","poem":2},{"text":"i no sot long kaikai.","poem":3},{"text":"Ol gutpela samting bilong yu","poem":1},{"text":"i moa yet","poem":2},{"text":"olsem bikpela wara,","poem":3},{"text":"na yu givim ol bilong dring.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yu as tru bilong laip","poem":1},{"text":"bilong olgeta samting.","poem":2},{"text":"Na yu as bilong lait.","poem":1},{"lineBreak":true},{"text":"Mipela i save kisim lait","poem":1},{"text":"long yu tasol,","poem":3},{"text":"na mipela i stap gut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oltaim yu mas laikim tru","poem":1},{"text":"ol manmeri i save long yu.","poem":2},{"text":"Yu mas helpim ol stretpela man","poem":1},{"text":"bai ol i stap gut.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yu no ken larim ol bikhetman","poem":1},{"text":"i krungutim mi.","poem":2},{"text":"Na yu no ken larim ol man nogut","poem":1},{"text":"i rausim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lukim. Ol man nogut","poem":1},{"text":"i pundaun long graun","poem":2},{"lineBreak":true},{"text":"na i slip i stap.","poem":2},{"text":"Ol i no inap kirap gen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}