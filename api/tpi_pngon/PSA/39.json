{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":39,"content":[{"type":"heading","content":["Tok bilong man i gat hevi"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong Jedutun, em man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Mi tok pinis olsem,","poem":1},{"text":"mi bai was gut","poem":2},{"text":"long olgeta pasin mi mekim.","poem":3},{"text":"Nogut mi mekim sin","poem":1},{"text":"long toktok bilong mi.","poem":2},{"text":"Taim ol man nogut","poem":1},{"text":"i stap klostu long mi,","poem":3},{"text":"bai mi no ken mekim","poem":2},{"text":"wanpela tok.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Orait mi bin pasim maus,","poem":1},{"text":"na mi no mekim wanpela tok.","poem":2},{"text":"Na mi no mekim wanpela tok","poem":1},{"text":"long gutpela samting tu.","poem":2},{"text":"Tasol bel hevi bilong mi","poem":1},{"text":"i kamap bikpela moa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na bel bilong mi i wari tru.","poem":1},{"lineBreak":true},{"text":"Mi wok long tingting yet,","poem":1},{"text":"na bel bilong mi","poem":2},{"text":"i pilim nogut olgeta.","poem":3},{"text":"Orait nau mi no inap pasim maus.","poem":1},{"text":"Nogat.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi askim God olsem,","poem":1},{"lineBreak":true},{"text":"“Bikpela, hamas yia i stap yet","poem":1},{"text":"long laip bilong mi?","poem":3},{"text":"Wanem taim bai mi dai?","poem":2},{"lineBreak":true},{"text":"Ating laip bilong mi","poem":2},{"text":"em bai i sotpela tasol?","poem":3},{"text":"Yu mas toksave long mi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, yu makim sotpela taim tru","poem":1},{"text":"bilong mi.","poem":3},{"text":"Long ai bilong yu","poem":1},{"text":"dispela taim bilong mi","poem":2},{"text":"em i samting nating.","poem":3},{"text":"Olgeta man i olsem win tasol,","poem":1},{"text":"wanpela man i winim long maus.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Olgeta man i olsem","poem":1},{"text":"tewel bilong diwai","poem":3},{"text":"i stap long graun","poem":2},{"text":"long taim bilong san.","poem":3},{"text":"Ol i save hatwok","poem":1},{"text":"long kisim planti samting,","poem":3},{"text":"tasol hatwok bilong ol i lus nating.","poem":2},{"text":"Ol man i save bungim","poem":1},{"text":"planti samting,","poem":3},{"text":"tasol ol i no save husat bai i kisim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tasol Bikpela, nau mi wet","poem":1},{"text":"long wanem samting? Nogat.","poem":2},{"text":"Mi bilip long yu","poem":1},{"text":"na wetim yu tasol i helpim mi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yu ken kisim bek mi","poem":1},{"text":"na lusim olgeta sin bilong mi.","poem":2},{"text":"Yu no ken larim ol krankiman","poem":1},{"text":"i tok bilas long mi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tasol mi no ken toktok.","poem":1},{"lineBreak":true},{"text":"Mi bai pasim maus tasol.","poem":1},{"lineBreak":true},{"text":"Long wanem, yu yet yu mekim","poem":1},{"text":"dispela samting long mi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu no ken bagarapim mi moa.","poem":1},{"lineBreak":true},{"text":"Yu bin mekim save long mi,","poem":1},{"text":"na klostu mi laik i dai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yu save krosim wanpela man","poem":1},{"text":"na bekim sin bilong en,","poem":3},{"text":"na yu save pinisim tru","poem":2},{"text":"ol samting em i laikim tumas,","poem":3},{"text":"olsem binatang i kaikai laplap","poem":2},{"text":"na laplap i bagarap.","poem":3},{"text":"Tru tumas, olgeta man i olsem win","poem":1},{"text":"i kamap long maus tasol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bikpela, harim prea bilong mi.","poem":1},{"lineBreak":true},{"text":"Putim gut yau","poem":1},{"text":"long singaut bilong mi.","poem":2},{"text":"Yu no ken pasim yau","poem":1},{"text":"long taim mi singaut long yu.","poem":2},{"text":"Yu save pinis,","poem":1},{"text":"mi stap liklik taim tasol","poem":2},{"text":"wantaim yu long graun.","poem":3},{"text":"Mi wankain","poem":1},{"text":"olsem ol tumbuna bilong mi.","poem":2},{"text":"Ol tu i bin i stap","poem":1},{"text":"sotpela taim tasol long graun.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yu no ken mekim save moa long mi.","poem":1},{"lineBreak":true},{"text":"Larim mi pastaim","poem":1},{"text":"na mi ken belgut gen.","poem":2},{"text":"Na bihain mi ken i dai","poem":1},{"text":"na lusim graun olgeta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}