{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":4,"content":[{"type":"heading","content":["Long nait wanpela man i prea bilong kisim strong"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"God, yu save mekim mi i win.","poem":1},{"lineBreak":true},{"text":"Taim mi singaut long yu,","poem":1},{"text":"yu ken harim singaut bilong mi.","poem":2},{"text":"Bipo mi bel hevi nogut tru,","poem":1},{"text":"na yu bin pinisim","poem":2},{"text":"bel hevi bilong mi.","poem":3},{"text":"Yu ken marimari long mi nau","poem":1},{"text":"na harim prea bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yupela ol man, hamas taim","poem":1},{"text":"bai yupela i wok long daunim","poem":2},{"text":"biknem bilong mi?","poem":3},{"text":"Hamas taim bai yupela","poem":1},{"text":"i laikim tumas","poem":2},{"text":"ol kain kain rabis samting?","poem":3},{"text":"Hamas taim bai yupela i bihainim","poem":1},{"text":"ol pasin bilong giaman?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yupela i mas save gut","poem":1},{"text":"long dispela tok.","poem":2},{"text":"Ol man i save aninit tru","poem":1},{"text":"long Bikpela,","poem":3},{"text":"em i makim ol bilong em yet.","poem":2},{"text":"Na olgeta taim mi singaut long em,","poem":1},{"text":"em i save harim singaut bilong mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yupela i mas pret long God","poem":1},{"text":"na lusim pasin bilong mekim sin.","poem":2},{"text":"Taim yupela i slip long bet,","poem":1},{"text":"yupela i mas tingting gut","poem":2},{"text":"long dispela tok,","poem":3},{"text":"na pasim maus.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yupela i mas mekim olkain ofa","poem":1},{"text":"Bikpela i save laikim.","poem":2},{"text":"Na yupela i mas bilip tru long em.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Planti man i save tok olsem,","poem":1},{"text":"“Mipela i laik kisim","poem":2},{"text":"ol gutpela samting","poem":3},{"text":"bai mipela i ken amamas.”","poem":2},{"text":"Bikpela, yu ken marimari","poem":1},{"text":"long mipela","poem":3},{"text":"na helpim mipela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taim wit na wain","poem":1},{"text":"i kamap planti long gaden,","poem":3},{"text":"ol man i save amamas.","poem":2},{"text":"Tasol amamas yu bin putim","poem":1},{"text":"long bel bilong mi,","poem":3},{"text":"em i winim tru amamas bilong ol.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela, yu tasol","poem":1},{"text":"yu save lukautim mi","poem":2},{"lineBreak":true},{"text":"na mi stap gut.","poem":2},{"text":"Mi no save pret","poem":1},{"text":"long wanpela samting.","poem":2},{"text":"Taim mi go long bet,","poem":1},{"text":"wantu mi save slip i dai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}