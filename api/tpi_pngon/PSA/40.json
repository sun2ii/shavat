{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":40,"content":[{"type":"heading","content":["Song bilong litimapim nem bilong God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Mi sindaun isi","poem":1},{"text":"na mi wetim Bikpela","poem":2},{"text":"i helpim mi.","poem":3},{"text":"Na em i marimari long mi","poem":1},{"text":"na i harim prea bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi olsem man i stap insait","poem":1},{"text":"long bikpela hul i daun tumas","poem":2},{"text":"na mi laik bagarap,","poem":3},{"text":"tasol Bikpela i pulim mi","poem":2},{"text":"na mi kam antap.","poem":3},{"text":"Mi pas long tais i olsem sup tru,","poem":1},{"text":"na em i kamautim mi","poem":2},{"lineBreak":true},{"text":"na sanapim mi long ples ston,","poem":2},{"lineBreak":true},{"text":"na mi wokabaut strong gen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Em i givim mi wanpela nupela song,","poem":1},{"text":"em song bilong litimapim","poem":2},{"text":"nem bilong God,","poem":3},{"text":"em God yumi save bilip long em.","poem":2},{"text":"Bai planti man i lukim mi","poem":1},{"text":"na bai ol i pret","poem":2},{"text":"na bilip long Bikpela.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Man i save bilip long God,","poem":1},{"text":"em i ken amamas.","poem":2},{"text":"Kain man olsem em i no save","poem":1},{"text":"bihainim ol bikhetman,","poem":3},{"text":"na em i no save lusim Bikpela","poem":2},{"text":"na lotu long ol giaman god.","poem":3},{"text":"Nogat tru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"yu bin mekim planti gutpela wok","poem":2},{"text":"bilong helpim mipela.","poem":3},{"text":"I no gat man i olsem yu.","poem":1},{"lineBreak":true},{"text":"Yu winim ol tru.","poem":1},{"lineBreak":true},{"text":"Sapos mi autim tok long ol man","poem":1},{"text":"na tokim ol long wok","poem":2},{"text":"na tingting bilong yu, olaman!","poem":3},{"text":"Dispela i moa moa yet!","poem":1},{"lineBreak":true},{"text":"Mi no inap kaunim","poem":1},{"text":"ol samting yu bin mekim","poem":2},{"text":"bilong helpim mipela.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Yu no laikim ol abus","poem":1},{"text":"ol i save kilim bilong mekim ofa.","poem":2},{"text":"Ol ofa ol i save kukim olgeta","poem":1},{"text":"long paia","poem":3},{"text":"na ol ofa bilong rausim sin,","poem":2},{"text":"em tu yu no save laikim.","poem":3},{"text":"Tasol yu bin kirapim laik bilong mi,","poem":1},{"text":"na mi bihainim tok bilong yu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Orait nau mi tok olsem,","poem":1},{"text":"“God, mi kam pinis,","poem":2},{"lineBreak":true},{"text":"olsem bipo ol i raitim tok long mi","poem":2},{"text":"long buk.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"God bilong mi, mi laikim tumas","poem":2},{"text":"long bihainim laik bilong yu.","poem":3},{"text":"Lo bilong yu i stap","poem":2},{"text":"insait long bel bilong mi.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bikpela, mi bin autim gutnius","poem":1},{"text":"long taim ol planti lain manmeri","poem":2},{"text":"bilong yu i kam bung.","poem":3},{"text":"Mi tok olsem,","poem":1},{"text":"“Bikpela i save kisim bek yumi.”","poem":2},{"text":"Bikpela, yu save pinis,","poem":1},{"text":"bai mi autim dispela tok oltaim.","poem":2},{"text":"Mi no ken pasim maus.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yu bin helpim mi na kisim bek mi,","poem":1},{"text":"na mi no haitim dispela.","poem":2},{"text":"Mi tokaut pinis olsem","poem":1},{"text":"yu save bihainim tok tru bilong yu","poem":2},{"lineBreak":true},{"text":"na yu kisim bek mipela.","poem":2},{"text":"Yu save laikim olgeta manmeri","poem":1},{"text":"na yu bihainim pasin tru,","poem":3},{"text":"na mi no haitim dispela","poem":2},{"text":"long ol manmeri","poem":3},{"text":"i bung bilong lotu.","poem":4},{"text":"Nogat. Mi tokim ol pinis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela, mi save","poem":1},{"text":"yu no inap pasim sori bilong yu.","poem":2},{"text":"Nogat. Yu save sori long mi oltaim.","poem":1},{"lineBreak":true},{"text":"Yu save laikim mi","poem":1},{"text":"na bihainim tok tru bilong yu,","poem":3},{"text":"na long dispela pasin","poem":2},{"text":"yu save lukautim mi oltaim.","poem":3}]},{"type":"heading","content":["Man i prea long God i helpim em"]},{"type":"verse","number":12,"content":[{"text":"Planti hevi i save kamap long mi,","poem":1},{"text":"na mi no inap kaunim ol.","poem":2},{"text":"Ol pasin nogut mi bin mekim","poem":1},{"text":"ol i daunim mi pinis,","poem":2},{"text":"olsem na mi no moa lukluk gut.","poem":3},{"text":"Ol pasin nogut i kamap planti moa,","poem":1},{"text":"na i winim namba","poem":2},{"text":"bilong gras bilong het","poem":3},{"text":"bilong mi.","poem":4},{"text":"Bel bilong mi i malumalum,","poem":1},{"text":"na mi no gat strong moa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bikpela, plis yu ken kisim bek mi.","poem":1},{"lineBreak":true},{"text":"Bikpela, yu kam hariap","poem":1},{"text":"na helpim mi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sampela man i laik kilim mi i dai.","poem":1},{"lineBreak":true},{"text":"Yu mas daunim ol na paulim ol tru,","poem":1},{"text":"bai ol i sem nogut.","poem":2},{"text":"Na sampela man i save amamas","poem":1},{"text":"long ol hevi bilong mi.","poem":2},{"text":"Yu mas rausim ol i go bek","poem":1},{"text":"na daunim nem bilong ol.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ol dispela man i tok bilas long mi.","poem":1},{"lineBreak":true},{"text":"Yu mas semim ol moa yet,","poem":1},{"text":"bai ol i kirap nogut tru","poem":2},{"text":"long pasin ol i bin mekim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tasol ol manmeri i save go long yu,","poem":1},{"text":"ol i ken belgut","poem":2},{"text":"na amamas long yu.","poem":3},{"text":"Dispela olgeta manmeri","poem":1},{"text":"yu bin kisim bek ol,","poem":3},{"text":"na ol i laikim tumas dispela wok","poem":2},{"text":"yu bin mekim long ol,","poem":3},{"text":"ol i ken tok olsem,","poem":2},{"lineBreak":true},{"text":"“Bikpela em i nambawan tru.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mi no gat strong,","poem":1},{"text":"na mi no inap helpim mi yet.","poem":2},{"text":"Tasol yu, Bikpela,","poem":1},{"text":"yu save tingting long mi.","poem":2},{"text":"God, yu yet yu man","poem":1},{"text":"bilong helpim mi,","poem":3},{"text":"na yu save kisim bek mi.","poem":2},{"text":"Yu no ken wet,","poem":1},{"text":"yu mas helpim mi kwik.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}