{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":41,"content":[{"type":"heading","content":["Sikman i beten long God bai God i ken mekim em i orait gen"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Man i save tingim ol rabisman","poem":1},{"text":"na i helpim ol,","poem":3},{"text":"dispela man i ken amamas.","poem":2},{"text":"Bikpela bai i helpim em","poem":1},{"text":"long taim hevi i kamap long em.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God bai i lukautim em","poem":1},{"text":"na strongim laip bilong em.","poem":2},{"text":"Bikpela bai i mekim em i stap gut","poem":1},{"text":"long ples bilong em.","poem":2},{"text":"Na bai Bikpela i no larim ol birua","poem":1},{"text":"i bagarapim em.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taim dispela man i gat sik,","poem":1},{"text":"Bikpela bai i lukautim em.","poem":2},{"text":"Em bai i mekim orait sik bilong em,","poem":1},{"text":"na mekim em i kamap strong gen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tasol mi yet mi tok olsem,","poem":1},{"text":"“Bikpela, mi bin mekim sin","poem":2},{"text":"long yu.","poem":3},{"text":"Tasol yu ken marimari long mi,","poem":2},{"text":"na pinisim sik bilong mi.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ol birua bilong mi","poem":1},{"text":"ol i bel nogut long mi","poem":2},{"text":"na ol i tok,","poem":3},{"text":"“Mobeta em i dai kwik","poem":2},{"text":"na yumi ken lus tingting long em.”","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Sampela man i kam lukim mi,","poem":1},{"text":"na ol i save toktok nating long mi.","poem":2},{"text":"Ol i laik harim tok","poem":1},{"text":"long mi gat sik nogut.","poem":2},{"text":"Na bihain ol i go ausait gen,","poem":1},{"text":"na long olgeta hap","poem":2},{"text":"ol i stori long dispela sik bilong mi.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Olgeta man i no laikim mi tru","poem":1},{"text":"ol i save tok hait","poem":2},{"text":"long sik bilong mi.","poem":3},{"text":"Ol i ting samting nogut tru","poem":1},{"text":"i laik bagarapim mi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ol i tok olsem,","poem":1},{"text":"“Samting nogut i kisim em pinis.","poem":2},{"lineBreak":true},{"text":"Em i no inap kirap gen.","poem":2},{"text":"Bai em i dai.”","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Mi gat wanpela pren,","poem":1},{"text":"em i poroman tru bilong mi,","poem":2},{"lineBreak":true},{"text":"na em i save kaikai wantaim mi.","poem":2},{"text":"Tasol em tu i litimapim lek","poem":1},{"text":"bilong krungutim mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bikpela, yu ken marimari long mi","poem":1},{"text":"na pinisim sik bilong mi,","poem":3},{"text":"na bai mi inap bekim pasin","poem":2},{"text":"bilong ol dispela man.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Sapos ol birua i no daunim mi,","poem":1},{"text":"bai mi ken save yu laikim mi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yu bin lukim mi i wokabaut stret,","poem":1},{"text":"olsem na yu lukautim mi,","poem":2},{"lineBreak":true},{"text":"na yu holim mi","poem":2},{"text":"klostu long yu oltaim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yumi litimapim nem bilong Bikpela,","poem":1},{"text":"em i God bilong ol Israel.","poem":2},{"text":"Na olgeta lain i kamap bihain,","poem":1},{"text":"ol tu i ken litimapim","poem":2},{"text":"nem bilong en.","poem":3},{"text":"I tru.","poem":1}]},{"type":"heading","content":["(Song 42-72)"]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}