{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":42,"content":[{"type":"heading","content":["Beten bilong man i stap longwe long ples bilong en"]},{"type":"hebrew_subtitle","content":["Dispela song em kain song ol i kolim Mas-kil, bilong ol lain Kora. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"Wel abus i save dai long wara","poem":1},{"text":"na i ran i go long liklik wara","poem":2},{"text":"bilong dring.","poem":3},{"text":"Na olsem tasol, God,","poem":1},{"text":"mi laikim tumas","poem":2},{"text":"bai mi stap klostu long yu.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"God, yu God i gat laip,","poem":1},{"text":"na mi laikim yu tumas,","poem":2},{"lineBreak":true},{"text":"olsem man, nek bilong en i drai","poem":2},{"text":"na i laik dringim wara.","poem":3},{"text":"God, wanem taim","poem":1},{"text":"bai mi ken i go long yu","poem":2},{"text":"na lotu long yu?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Oltaim ol man","poem":1},{"text":"i save askim mi olsem,","poem":3},{"text":"“God bilong yu i stap we?”","poem":2},{"text":"Olsem na mi wok long krai oltaim.","poem":1},{"lineBreak":true},{"text":"Aiwara bilong mi","poem":1},{"text":"i olsem kaikai bilong mi","poem":2},{"text":"long san na long nait.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi save tingting","poem":1},{"text":"long gutpela taim bipo,","poem":3},{"text":"na bel bilong mi i hevi tumas.","poem":2},{"text":"Bipo mi save wokabaut","poem":1},{"text":"wantaim planti manmeri,","poem":3},{"text":"na mi go paslain","poem":2},{"lineBreak":true},{"text":"na bringim ol i go","poem":2},{"text":"long haus bilong God.","poem":3},{"text":"Mipela i save wokabaut i go","poem":1},{"text":"na singaut bilong amamas,","poem":2},{"lineBreak":true},{"text":"na mekim ol song","poem":2},{"text":"bilong tenkyu long God.","poem":3},{"text":"Long dispela taim mipela olgeta","poem":1},{"text":"i bung long de bilong lotu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bilong wanem mi bel hevi oltaim?","poem":1},{"lineBreak":true},{"text":"Bilong wanem bel bilong mi","poem":1},{"text":"i kirap nogut?","poem":2},{"text":"Mi mas bilip long God","poem":1},{"text":"na wetim em i helpim mi.","poem":2},{"text":"Em i God bilong mi","poem":1},{"text":"na em i save helpim mi.","poem":2},{"text":"Olsem na bai mi","poem":1},{"text":"litimapim nem bilong en gen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bel bilong mi i hevi moa,","poem":1},{"text":"olsem na mi tingting long yu.","poem":2},{"text":"Mi stap long hap bilong Jordan,","poem":1},{"text":"na long maunten Hermon","poem":2},{"text":"na maunten Misa,","poem":3},{"text":"na mi tingim yu gen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Solwara i daun tumas i save singaut","poem":1},{"text":"long narapela solwara i daun moa.","poem":2},{"text":"Na wara i ran long ples ston","poem":1},{"text":"na i kapsait i go daunbilo,","poem":3},{"text":"dispela wara i save pairap","poem":2},{"text":"moa yet.","poem":3},{"text":"Yu save mekim biksi i bruk","poem":1},{"text":"na kalap nabaut,","poem":3},{"text":"na karamapim graun long nambis.","poem":2},{"text":"Olsem tasol olgeta hevi","poem":1},{"text":"yu putim long mi","poem":3},{"text":"em i karamapim mi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tasol mi laik bai Bikpela","poem":1},{"text":"i ken marimari long mi long san.","poem":2},{"text":"Na long nait mi laik mekim song","poem":1},{"text":"bilong tenkyu long em,","poem":3},{"text":"na mi beten long God","poem":2},{"text":"i save givim laip long mi.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"God i save givim strong long mi","poem":1},{"text":"na mi tokim em olsem,","poem":2},{"lineBreak":true},{"text":"“Bilong wanem yu lusim tingting","poem":2},{"text":"long mi?","poem":3},{"text":"Bilong wanem yu larim ol birua","poem":2},{"text":"i daunim mi","poem":3},{"text":"na mekim mi i bel hevi nogut?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oltaim ol birua","poem":1},{"text":"i save tok nogut long mi olsem,","poem":3},{"text":"“We stap God bilong yu nau?”","poem":2},{"text":"Dispela tok i olsem spia","poem":1},{"text":"i sutim bodi bilong mi","poem":3},{"text":"na mi laik i dai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bilong wanem mi bel hevi oltaim?","poem":1},{"lineBreak":true},{"text":"Bilong wanem bel bilong mi","poem":1},{"text":"i kirap nogut?","poem":2},{"text":"Mi mas bilip long God","poem":1},{"text":"na wetim em i helpim mi.","poem":2},{"text":"Em i God bilong mi","poem":1},{"text":"na em i save helpim mi.","poem":2},{"text":"Olsem na bai mi","poem":1},{"text":"litimapim nem bilong en gen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}