{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":43,"content":[{"type":"heading","content":["Beten bilong man i lusim ples pinis"]},{"type":"verse","number":1,"content":[{"text":"God, ol man","poem":1},{"text":"i save givim baksait long yu,","poem":2},{"text":"ol i laik daunim mi.","poem":3},{"text":"Yu mas helpim mi","poem":1},{"text":"na katim tok nogut bilong ol,","poem":3},{"text":"na soim ol olsem","poem":2},{"text":"mi mekim gutpela pasin tasol.","poem":3},{"text":"Ol i man bilong tok giaman,","poem":1},{"text":"na pasin bilong ol i no stret.","poem":2},{"text":"Yu mas helpim mi","poem":1},{"text":"na kisim bek mi","poem":2},{"text":"long han bilong ol.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu tasol, yu God bilong mi.","poem":1},{"lineBreak":true},{"text":"Mi save go long yu","poem":1},{"text":"na hait long ol man nogut.","poem":2},{"text":"Orait bilong wanem","poem":1},{"text":"yu tingting lus long mi?","poem":2},{"text":"Bilong wanem ol birua i daunim mi","poem":1},{"text":"na mekim mi i bel hevi nogut?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu mas salim tok tru","poem":1},{"text":"na lait bilong yu i kam","poem":2},{"text":"na soim rot long mi,","poem":3},{"text":"bai mi go stret long Saion,","poem":2},{"text":"em maunten bilong yu yet,","poem":3},{"text":"na bai mi go long dispela haus","poem":2},{"text":"yu save stap long en.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Olsem na bai mi go","poem":1},{"text":"long alta bilong yu, God.","poem":2},{"text":"Long wanem, yu save mekim mi","poem":1},{"text":"i belgut na amamas.","poem":2},{"text":"Yu God bilong mi, bai mi kisim gita","poem":1},{"text":"na mekim musik,","poem":3},{"text":"na singim song bilong litimapim","poem":2},{"text":"nem bilong yu tasol.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Bilong wanem mi bel hevi oltaim?","poem":1},{"lineBreak":true},{"text":"Bilong wanem bel bilong mi","poem":1},{"text":"i kirap nogut?","poem":2},{"text":"Mi mas bilip long God","poem":1},{"text":"na wetim em i helpim mi.","poem":2},{"text":"Em i God bilong mi","poem":1},{"text":"na em i save helpim mi.","poem":2},{"text":"Olsem na bai mi","poem":1},{"text":"litimapim nem bilong en gen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}