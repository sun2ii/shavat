{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":48,"content":[{"type":"heading","content":["Taun Saion i gat biknem na gutpela bilas"]},{"type":"hebrew_subtitle","content":["Dispela song em i song bilong lotu. Em i bilong ol lain Kora."]},{"type":"verse","number":1,"content":[{"text":"Bikpela i gat biknem.","poem":1},{"lineBreak":true},{"text":"Yumi mas i go","poem":1},{"text":"antap long maunten bilong God,","poem":3},{"text":"na go insait long taun bilong en,","poem":2},{"lineBreak":true},{"text":"na yumi litimapim nem bilong em","poem":2},{"text":"moa yet.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Dispela maunten bilong God,","poem":1},{"text":"em i gutpela tru","poem":2},{"lineBreak":true},{"text":"na i antap moa.","poem":2},{"text":"Olgeta manmeri bilong graun","poem":1},{"text":"ol i laikim tumas maunten Saion.","poem":2},{"text":"Em i stap long hap bilong not,","poem":1},{"text":"na em i taun","poem":2},{"text":"bilong nambawan king.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"God i stap insait long taun","poem":1},{"text":"na em i save helpim ol manmeri","poem":2},{"text":"long taim bilong pait.","poem":3},{"text":"Olsem na ol i stap gut.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bipo ol king i laik pait long Saion.","poem":1},{"lineBreak":true},{"text":"Ol i bin bung wantaim","poem":1},{"text":"na i kam klostu long taun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol i lukim taun","poem":1},{"text":"na wantu ol i kirap nogut.","poem":2},{"text":"Na ol i pret moa yet na ol i ranawe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ol i guria nogut tru,","poem":1},{"text":"na ol i pilim bikpela pen,","poem":2},{"lineBreak":true},{"text":"olsem pen bilong meri","poem":2},{"text":"i laik karim pikinini.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God i save mekim bikpela win i kam","poem":1},{"text":"long hap bilong sankamap,","poem":3},{"text":"na i bagarapim ol bikpela sip","poem":2},{"text":"bilong taun Tarsis.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Mipela i bin harim tok","poem":1},{"text":"long dispela samting","poem":2},{"text":"God i bin mekim bipo,","poem":3},{"text":"na nau mipela i lukim em","poem":2},{"text":"i mekim olsem gen.","poem":3},{"text":"Mipela i stap long taun","poem":1},{"text":"bilong God bilong mipela,","poem":2},{"text":"em Bikpela I Gat Olgeta Strong,","poem":3},{"text":"na mipela i lukim em","poem":2},{"text":"i mekim dispela samting.","poem":3},{"text":"God i strongim taun bilong em,","poem":1},{"text":"na bai taun i stap oltaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"God, mipela i stap","poem":1},{"text":"long haus bilong yu,","poem":3},{"text":"na mipela i tingting","poem":2},{"text":"long sori bilong yu.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Long olgeta hap graun","poem":1},{"text":"ol manmeri i save litimapim","poem":2},{"text":"nem bilong yu.","poem":3},{"text":"Ol manmeri long olgeta hap","poem":1},{"text":"i save amamas","poem":2},{"text":"long biknem bilong yu.","poem":3},{"text":"Yu save bosim olgeta manmeri","poem":1},{"text":"long stretpela pasin tasol.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Olsem na olgeta manmeri","poem":1},{"text":"i stap long maunten Saion,","poem":3},{"text":"ol i ken amamas.","poem":2},{"text":"Yu save skelim stret","poem":1},{"text":"pasin bilong olgeta manmeri.","poem":2},{"text":"Olsem na ol manmeri","poem":1},{"text":"bilong ol taun bilong Juda,","poem":3},{"text":"ol i ken amamas tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yupela i mas wokabaut","poem":1},{"text":"long maunten Saion,","poem":3},{"text":"na raunim banis bilong taun","poem":2},{"lineBreak":true},{"text":"na kaunim ol taua bilong en.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yupela i mas tingting gut","poem":1},{"text":"long banis bilong Saion,","poem":3},{"text":"na lukim gut","poem":2},{"text":"ol strongpela haus bilong en.","poem":3},{"text":"Olsem na bai yupela i ken toksave","poem":1},{"text":"long ol lain i kamap bihain.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yupela i ken tokim ol olsem,","poem":1},{"text":"“Dispela God i lukautim mipela,","poem":2},{"text":"em i God bilong yumi","poem":3},{"text":"oltaim oltaim.","poem":4},{"text":"Na oltaim em bai i go pas","poem":2},{"text":"na soim rot long yumi.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}