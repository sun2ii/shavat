{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":5,"content":[{"type":"heading","content":["Man i prea long God i lukautim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long winim ol mambu."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, harim prea bilong mi","poem":1},{"text":"na putim yau","poem":2},{"text":"long tok bilong mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu king na God bilong mi,","poem":1},{"text":"mi prea long yu.","poem":2},{"text":"Yu ken harim singaut bilong mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bikpela, long olgeta moning","poem":1},{"text":"mi save beten long yu.","poem":2},{"text":"Long taim san i kam antap","poem":1},{"text":"mi save prea strong long yu.","poem":2},{"text":"Em i olsem ofa bilong mi.","poem":1},{"lineBreak":true},{"text":"Na mi wet","poem":1},{"text":"long yu bekim prea bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God, yu no save amamas","poem":1},{"text":"long pasin i no stret.","poem":2},{"text":"Ol man bilong mekim pasin nogut","poem":1},{"text":"i no ken i stap klostu long yu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yu no save larim ol hambakman","poem":1},{"text":"i sanap long ai bilong yu.","poem":2},{"text":"Na yu no laikim tru","poem":1},{"text":"ol man i mekim pasin nogut.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yu save bagarapim","poem":1},{"text":"olgeta man bilong giaman.","poem":2},{"text":"Na yu no laikim tru","poem":1},{"text":"ol man bilong kilim man i dai","poem":2},{"lineBreak":true},{"text":"na ol man bilong kusai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tasol yu save laikim mi tru.","poem":1},{"lineBreak":true},{"text":"Olsem na mi inap i go","poem":1},{"text":"long haus bilong yu.","poem":2},{"text":"Long gutpela haus bilong yu","poem":1},{"text":"bai mi brukim skru","poem":2},{"text":"na lotu long yu.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"God, ol birua i laik bagarapim mi.","poem":1},{"lineBreak":true},{"text":"Olsem na yu ken stiaim","poem":1},{"text":"lek bilong mi","poem":3},{"text":"na bai mi bihainim","poem":2},{"text":"stretpela pasin bilong yu.","poem":3},{"text":"Soim mi rot","poem":1},{"text":"yu laik mi wokabaut long en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ol birua bilong mi","poem":1},{"text":"i no save tok tru liklik.","poem":2},{"text":"Ol i tingting tasol","poem":1},{"text":"long bagarapim ol arapela man.","poem":2},{"text":"Maus bilong ol i olsem matmat","poem":1},{"text":"i op i stap.","poem":2},{"text":"Ol i mekim planti tok gris","poem":1},{"text":"bilong pulim ol man","poem":2},{"text":"long bihainim ol pasin ol i laikim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"God, yu ken kotim ol","poem":1},{"text":"na mekim save long ol.","poem":2},{"text":"Paulim ol tingting nogut bilong ol.","poem":1},{"lineBreak":true},{"text":"Ol i save bikhet long yu","poem":1},{"text":"na mekim planti sin,","poem":3},{"text":"olsem na yu ken rausim ol","poem":2},{"text":"i go longwe long pes bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tasol olgeta manmeri i save larim yu","poem":1},{"text":"i lukautim ol,","poem":3},{"text":"ol i ken amamas.","poem":2},{"text":"Ol i ken belgut tru","poem":1},{"text":"na singim song bilong amamas.","poem":2},{"text":"Yu save lukautim ol gut.","poem":1},{"lineBreak":true},{"text":"Ol manmeri i save laikim yu tru,","poem":1},{"text":"ol i ken amamas moa yet","poem":2},{"lineBreak":true},{"text":"na litimapim nem bilong yu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bikpela, yu save mekim gut","poem":1},{"text":"long ol man i bihainim tru","poem":2},{"text":"tok bilong yu.","poem":3},{"text":"Yu stap olsem hap plang bilong pait","poem":1},{"text":"na yu haitim ol.","poem":2},{"text":"Yu lukautim ol gut tumas","poem":1},{"text":"na ol i stap gut tru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}