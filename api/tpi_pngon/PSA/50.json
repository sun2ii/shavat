i stap isi. Nogat tru.","poem":1},{"lineBreak":true},{"text":"Paia bilong kukim ol samting","poem":1},{"text":"i go paslain long em,","poem":3},{"text":"na bikpela win na ren i raunim em.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Em i singautim heven na graun i kam","poem":1},{"text":"bilong lukim em i skelim gut","poem":2},{"text":"pasin bilong ol manmeri","poem":3},{"text":"bilong en.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God i tok olsem,","poem":1},{"text":"“Ol manmeri bilong mi,","poem":2},{"text":"yupela i bin mekim kontrak","poem":3},{"text":"wantaim mi,","poem":4},{"text":"na yupela i ofaim abus","poem":2},{"text":"bilong strongim","poem":3},{"text":"dispela kontrak.","poem":4},{"text":"Yupela kam bung wantaim mi.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Heven yet i save autim tok olsem,","poem":1},{"text":"“God i stretpela tumas.","poem":2},{"text":"Em yet i jas.”","poem":3}]},{"type":"verse","number":7,"content":[{"text":"God i tok,","poem":1},{"text":"“Yupela manmeri bilong mi,","poem":2},{"text":"harim.","poem":3},{"text":"Mi gat tok long yupela.","poem":2},{"lineBreak":true},{"text":"Yupela ol Israel,","poem":2},{"text":"mi laik kotim yupela.","poem":3},{"text":"Mi tasol mi God tru,","poem":2},{"text":"na mi God bilong yupela.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Mi no krosim yupela","poem":2},{"text":"long ol ofa yupela i mekim.","poem":3},{"text":"Nogat.","poem":4},{"text":"Oltaim mi save lukim yupela","poem":2},{"text":"i kukim ol ofa olgeta long paia.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Tasol mi no laik kisim","poem":2},{"text":"bulmakau man o meme man","poem":3},{"text":"long banis bilong yupela. Nogat.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Olgeta wel abus bilong bus","poem":2},{"lineBreak":true},{"text":"na olgeta bulmakau","poem":2},{"text":"i stap long olgeta maunten,","poem":3},{"text":"olgeta i bilong mi yet.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Olgeta pisin,","poem":2},{"lineBreak":true},{"text":"na ol abus na binatang samting","poem":2},{"text":"i save wokabaut long ples kunai,","poem":3},{"text":"em olgeta i bilong mi tasol.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sapos mi hangre,","poem":2},{"text":"mi no ken toksave long yupela.","poem":3},{"text":"Nogat.","poem":4},{"text":"Graun wantaim olgeta samting","poem":2},{"text":"i stap long en,","poem":3},{"text":"ol i bilong mi tasol.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ating mi save kaikai","poem":2},{"text":"mit bilong bulmakau man?","poem":3},{"text":"Ating mi save dringim","poem":2},{"text":"blut bilong meme, a? Nogat.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mobeta yupela i tenkyu tru","poem":2},{"text":"long mi.","poem":3},{"text":"Em kain ofa yupela i mas mekim.","poem":2},{"lineBreak":true},{"text":"Olgeta presen yupela i tok pinis","poem":2},{"text":"long givim long mi,","poem":3},{"text":"God Antap Tru,","poem":4},{"text":"em yupela i mas givim long mi.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yupela i mekim olsem,","poem":2},{"lineBreak":true},{"text":"na taim hevi i kamap,","poem":2},{"text":"yupela i ken singaut long mi,","poem":3},{"text":"na bai mi helpim yupela tru,","poem":2},{"lineBreak":true},{"text":"na yupela i ken litimapim nem","poem":2},{"text":"bilong mi.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tasol God i tok olsem","poem":1},{"text":"long ol man nogut,","poem":3},{"text":"“Watpo yupela i save kolim","poem":2},{"text":"olgeta lo bilong mi?","poem":3},{"text":"Na watpo yupela i toktok","poem":2},{"text":"long kontrak bilong mi?","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Yupela i no laik mi stretim yupela,","poem":2},{"text":"na oltaim yupela","poem":3},{"text":"i wok long sakim tok bilong mi.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Yupela i save lukim ol stilman","poem":2},{"text":"na yupela i kamap pren bilong ol.","poem":3},{"text":"Na yupela i wokabaut","poem":2},{"text":"wantaim ol manmeri","poem":3},{"text":"i brukim marit na pamuk nabaut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Oltaim yupela i wok long mekim","poem":2},{"text":"tok nogut na tok giaman.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Na yupela i wok long kotim","poem":2},{"text":"ol brata bilong yupela,","poem":3},{"text":"na yupela i tok baksait long ol.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yupela i bin mekim olsem,","poem":2},{"text":"na mi no mekim wanpela tok.","poem":3},{"text":"Olsem na yupela i ting","poem":2},{"text":"mi wankain olsem yupela yet.","poem":3},{"text":"Tasol nogat tru.","poem":2},{"lineBreak":true},{"text":"Nau mi laik krosim yupela","poem":2},{"text":"na kotim yupela long ples klia.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yupela manmeri","poem":2},{"text":"i save givim baksait long mi,","poem":3},{"text":"yupela harim.","poem":2},{"lineBreak":true},{"text":"Sapos yupela i stap olsem,","poem":2},{"text":"bai mi bagarapim yupela,","poem":3},{"text":"na i no gat wanpela man","poem":2},{"text":"inap long kisim bek yupela.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Man i givim tenkyu long mi","poem":2},{"text":"olsem ofa bilong en,","poem":4},{"text":"em i save litimapim nem","poem":3},{"text":"bilong mi.","poem":4},{"text":"Na bai mi kisim bek","poem":2},{"lineBreak":true},{"text":"ol man i bihainim tok bilong mi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/51.json","nextChapterAudioLinks":{},"previousChapt