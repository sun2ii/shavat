{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":51,"content":[{"type":"heading","content":["Man i beten bai God i lusim sin bilong en"]},{"type":"hebrew_subtitle","content":["Devit i bin mekim trabel long Batseba, na bihain profet Natan i kam sutim tok long em. Na Devit i tingting long sin bilong en na i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, yu as bilong sori,","poem":1},{"text":"yu ken marimari long mi.","poem":2},{"text":"Yu gat bikpela marimari tru,","poem":1},{"text":"olsem na mi laik bai yu rausim","poem":2},{"text":"olgeta pasin nogut bilong mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu mas wasim mi olgeta,","poem":1},{"text":"na bai pasin nogut","poem":2},{"text":"i no i stap moa long mi.","poem":3},{"text":"Rausim sin bilong mi","poem":1},{"text":"na mi ken kamap klin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mi save mi mekim rong pinis.","poem":1},{"lineBreak":true},{"text":"Mi no inap lusim tingting","poem":1},{"text":"long sin bilong mi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi mekim sin long yu wanpela tasol.","poem":1},{"lineBreak":true},{"text":"Mi mekim pasin nogut","poem":1},{"text":"long ai bilong yu.","poem":2},{"text":"Olsem na yu mekim","poem":1},{"text":"stretpela pasin tasol","poem":3},{"text":"na yu kotim mi","poem":2},{"lineBreak":true},{"text":"na yu bekim sin bilong mi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yu save pinis,","poem":1},{"text":"taim mama i karim mi,","poem":3},{"text":"mi kamap man","poem":2},{"text":"bilong mekim pasin nogut.","poem":3},{"text":"Taim mi stap yet","poem":1},{"text":"long bel bilong mama,","poem":3},{"text":"mi man bilong mekim sin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yu laikim tumas","poem":1},{"text":"long mi mas bihainim yu tru.","poem":2},{"text":"Olsem na mi laik bai yu lainim mi","poem":1},{"text":"long gutpela tingting bilong yu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu rausim sin bilong mi","poem":1},{"text":"bai mi kamap klin.","poem":2},{"text":"Yu wasim mi","poem":1},{"text":"na bai mi kamap klin olgeta,","poem":2},{"text":"na i winim ais i waitpela tru.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Yu mekim bel bilong mi","poem":1},{"text":"i amamas gen.","poem":2},{"text":"Tru tumas, yu bin daunim mi olgeta,","poem":1},{"text":"na yu bekim pinis sin bilong mi.","poem":2},{"text":"Tasol nau mi laik belgut gen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yu no ken lukluk","poem":1},{"text":"long sin bilong mi gen.","poem":2},{"text":"Na mi laik bai yu lusim","poem":1},{"text":"olgeta rong bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"God, yu ken wokim","poem":1},{"text":"nupela klinpela bel","poem":2},{"text":"insait long mi.","poem":3},{"text":"Putim nupela spirit insait long mi","poem":1},{"text":"na bai mi bihainim yu tasol.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nogut yu rausim mi","poem":1},{"text":"na mi stap longwe long yu.","poem":2},{"text":"Spirit bilong yu yet i stap long mi,","poem":1},{"text":"na yu no ken rausim long mi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bipo mi amamas long yu","poem":1},{"text":"i kisim bek mi,","poem":3},{"text":"na nau mi laik bai yu givim mi","poem":2},{"text":"dispela amamas gen.","poem":3},{"text":"Yu mas kirapim laik bilong mi","poem":1},{"text":"long bihainim tok bilong yu,","poem":3},{"text":"na yu ken strongim mi","poem":2},{"text":"long mekim olsem.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Na bai mi lainim","poem":1},{"text":"ol manmeri i save mekim sin,","poem":3},{"text":"bai ol i ken save","poem":2},{"text":"long pasin bilong yu,","poem":3},{"text":"na bai ol dispela manmeri","poem":2},{"text":"i kam bek long yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"God, yu God bilong kisim bek mi,","poem":1},{"text":"yu ken marimari long mi","poem":2},{"lineBreak":true},{"text":"na yu no ken kilim mi i dai.","poem":2},{"text":"Olsem na bai mi mekim planti song","poem":1},{"text":"long yu i bin mekim","poem":2},{"text":"stretpela pasin.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Bikpela, yu ken helpim mi","poem":1},{"text":"long tokaut stret,","poem":3},{"text":"na long litimapim nem bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yu no laik bai mi bringim abus","poem":1},{"text":"bilong mekim ofa long yu.","poem":2},{"text":"Sapos mi kilim abus bilong ofa","poem":1},{"text":"na paia i kukim olgeta, maski,","poem":2},{"text":"yu no amamas long dispela.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Orait God, mi daunim mi yet","poem":1},{"text":"na mi stap aninit long yu.","poem":2},{"text":"Dispela em i ofa bilong mi.","poem":1},{"lineBreak":true},{"text":"Mi save, yu no givim baksait","poem":1},{"text":"long man i pilim hevi long sin","poem":2},{"text":"na i daunim em yet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Long laik bilong yu yet,","poem":1},{"text":"yu ken mekim gut","poem":2},{"text":"long ol manmeri bilong Saion.","poem":3},{"text":"Yu ken sanapim gen","poem":1},{"text":"banis bilong Jerusalem.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Olsem na long dispela taim","poem":1},{"text":"bai yu laikim tumas","poem":2},{"text":"ol gutpela na stretpela ofa,","poem":3},{"text":"na olkain ofa paia i kukim olgeta.","poem":2},{"text":"Na bai mipela i ofaim","poem":1},{"text":"ol bulmakau man","poem":2},{"text":"long alta bilong yu.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}