apela man.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu no laikim gutpela pasin.","poem":1},{"text":"Yu laikim pasin nogut tasol.","poem":2},{"text":"Yu no laikim pasin bilong tok tru.","poem":1},{"text":"Yu save laikim pasin","poem":2},{"text":"bilong tok giaman tasol.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Yu man bilong giaman.","poem":1},{"text":"Yu save laikim tumas tok","poem":2},{"text":"bilong bagarapim ol arapela man.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tasol harim.","poem":1},{"text":"God bai i bagarapim yu olgeta.","poem":2},{"text":"Em bai i holimpas yu","poem":1},{"text":"na rausim yu long haus bilong yu.","poem":2},{"text":"Na bai em i pinisim yu olgeta","poem":1},{"text":"na yu no ken i stap moa","poem":2},{"text":"long graun.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ol stretpela man bai i lukim","poem":1},{"text":"dispela samting i kamap long yu","poem":2},{"text":"na bai ol i pret.","poem":3},{"text":"Bai ol i lap long yu na tok olsem,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"“Lukim. Dispela man i no laik","poem":2},{"text":"bai God i helpim em","poem":3},{"text":"na strongim em.","poem":4},{"text":"Em i bilip strong","poem":2},{"text":"long planti mani samting","poem":3},{"text":"bilong en,","poem":4},{"text":"na em i ting pasin nogut","poem":2},{"text":"bai i mekim em i stap gut.”","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Tasol mi no olsem.","poem":1},{"text":"Mi olsem diwai oliv","poem":2},{"text":"i stap klostu","poem":3},{"text":"long haus bilong God.","poem":4},{"text":"Mi bilip long God i save marimari","poem":1},{"text":"long mi oltaim oltaim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"God, yu bin helpim mi,","poem":1},{"text":"olsem na oltaim","poem":2},{"text":"bai mi tenkyu long yu.","poem":3},{"text":"Na long ai bilong ol manmeri","poem":1},{"text":"bilong yu","poem":3},{"text":"bai mi litimapim nem bilong yu","poem":2},{"lineBreak":true},{"text":"na tok, “God i mekim","poem":2},{"text":"gutpela pasin long mi.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}