{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":53,"content":[{"type":"heading","content":["Pasin kranki na pasin nogut bilong ol man"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Maskil. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim Mahalat."]},{"type":"verse","number":1,"content":[{"text":"Ol longlong man i save tok","poem":1},{"text":"long ol yet olsem,","poem":3},{"text":"“I no gat God i stap.”","poem":2},{"text":"Ol dispela man ol i man nogut tasol.","poem":1},{"text":"Ol i save mekim pasin i nogut tru.","poem":2},{"text":"I no gat wanpela","poem":1},{"text":"i save mekim gutpela pasin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"God i stap long heven","poem":1},{"text":"na i lukluk i go daun","poem":2},{"text":"long ol manmeri.","poem":3},{"text":"Em i laik painim sampela man","poem":1},{"text":"i gat gutpela save","poem":2},{"lineBreak":true},{"text":"na i wok long kisim save","poem":2},{"text":"long God.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Tasol nogat.","poem":2},{"text":"Olgeta wantaim i lusim rot pinis.","poem":1},{"text":"Olgeta i wankain tasol,","poem":2},{"text":"ol i man nogut tru.","poem":3},{"text":"I no gat wanpela bilong ol","poem":1},{"text":"i save mekim gutpela pasin.","poem":2},{"text":"Nogat tru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God i tok olsem,","poem":1},{"text":"“Ol dispela man","poem":2},{"text":"i mekim pasin nogut,","poem":4},{"text":"ating ol i no gat save, a?","poem":3},{"text":"Ol i save pinisim","poem":2},{"text":"ol manmeri bilong mi","poem":3},{"text":"olsem ol i kaikai bret.","poem":4},{"text":"Na ol i no save beten long mi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tasol bai ol i pret moa yet.","poem":1},{"text":"Bipo ol i no pret olsem. Nogat tru.","poem":2},{"text":"Long wanem, bai God i pinisim tru","poem":1},{"text":"olgeta birua bilong yupela.","poem":2},{"text":"Em i sakim ol pinis","poem":1},{"text":"na bai em i bagarapim ol tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mi laikim tumas bai God","poem":1},{"text":"i salim wanpela man bilong Saion","poem":2},{"text":"i kam bilong kisim bek ol Israel.","poem":3},{"text":"Taim God i helpim","poem":1},{"text":"ol manmeri bilong en","poem":2},{"text":"na ol i stap gut gen,","poem":3},{"text":"orait ol Israel bai i amamas.","poem":2},{"text":"Yes, bai ol i belgut tru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}