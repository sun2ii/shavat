{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":54,"content":[{"type":"heading","content":["Man i beten long God bai i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Maskil. Devit i raitim dispela song long taim ol man bilong Sif i go tokim Sol long Devit i hait i stap namel long ol. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"God, long strong bilong yu,","poem":1},{"text":"yu mas kisim bek mi","poem":2},{"text":"long han bilong ol man nogut.","poem":3},{"text":"Long bikpela strong bilong yu,","poem":1},{"text":"yu mekim mi i kamap fri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God, mi laik yu harim","poem":1},{"text":"prea bilong mi.","poem":2},{"text":"Mi laik yu putim yau","poem":1},{"text":"long tok bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ol bikhetman i kam pinis","poem":1},{"text":"na ol i laik pait long mi.","poem":2},{"text":"Ol dispela man i save bagarapim","poem":1},{"text":"ol arapela man,","poem":3},{"text":"ol i laik kilim mi i dai.","poem":2},{"text":"Ol dispela man i save ting","poem":1},{"text":"God em i samting nating.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tasol God yet i save helpim mi.","poem":1},{"lineBreak":true},{"text":"Tru tumas,","poem":1},{"text":"Bikpela i save lukautim mi","poem":2},{"text":"na mi stap gut.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"God i ken mekim save","poem":1},{"text":"long ol birua bilong mi.","poem":2},{"text":"Pasin nogut ol i bin mekim long mi,","poem":1},{"text":"em i ken mekim","poem":2},{"text":"dispela kain pasin","poem":3},{"text":"i kamap long ol yet.","poem":4},{"text":"God, yu no save lusim mi,","poem":1},{"text":"na yu ken pinisim tru","poem":2},{"text":"ol dispela birua.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bikpela, mi save laikim tumas","poem":1},{"text":"long givim ofa long yu.","poem":2},{"text":"Yu gutpela tumas,","poem":1},{"text":"olsem na mi tenkyu tru long yu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu bin helpim mi,","poem":1},{"text":"na olgeta hevi i kamap long mi","poem":2},{"text":"i no daunim mi.","poem":3},{"text":"Na mi lukim yu","poem":1},{"text":"i bagarapim ol birua bilong mi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}