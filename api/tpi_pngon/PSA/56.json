{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":56,"content":[{"type":"heading","content":["Prea bilong man i bilip long God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Miktam. Devit i raitim dispela song long taim ol Filistia i bin holimpas em long taun Get. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “Pisin i stap long ol longwe diwai.”"]},{"type":"verse","number":1,"content":[{"text":"God, yu mas marimari","poem":1},{"text":"long mi.","poem":2},{"text":"Ol man i save ranim mi","poem":1},{"text":"na pait long mi.","poem":2},{"text":"Oltaim ol birua","poem":1},{"text":"i mekim nogut long mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Long moning","poem":1},{"text":"i go inap long apinun tru,","poem":2},{"text":"ol birua i wok long pait long mi.","poem":3},{"text":"Planti man i birua long mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God Antap Tru,","poem":1},{"text":"taim mi pret","poem":2},{"text":"long wanpela samting,","poem":3},{"text":"mi bilip strong long yu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mi save bilip long God","poem":1},{"text":"na mi tingting","poem":2},{"text":"long tok tru bilong em.","poem":3},{"text":"Olsem na mi save","poem":1},{"text":"litimapim nem bilong en.","poem":2},{"text":"Mi save bilip long God,","poem":1},{"text":"na mi no ken pret","poem":2},{"text":"long wanpela samting.","poem":3},{"text":"Bai ol man inap mekim","poem":1},{"text":"wanem samting long mi? Nogat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olgeta samting mi laik mekim,","poem":1},{"text":"ol birua i traim long bagarapim.","poem":2},{"text":"Oltaim ol i tingting long painim rot","poem":1},{"text":"bilong bagarapim mi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol i save bung wantaim","poem":1},{"text":"na hait i stap.","poem":2},{"text":"Ol i was gut","poem":1},{"text":"long wokabaut bilong mi,","poem":3},{"text":"na ol i laik kilim mi i dai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God, yu mas mekim save long ol","poem":1},{"text":"long pasin nogut ol i mekim.","poem":2},{"text":"Yu mas belhat long ol na winim ol","poem":1},{"text":"na daunim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yu save long mi karim hevi","poem":1},{"text":"na mi pilim nogut tru long en,","poem":2},{"text":"na mi krai i stap.","poem":3},{"text":"Orait yu tingting yet long dispela,","poem":1},{"text":"na yu raitim pinis","poem":2},{"text":"long buk bilong yu.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"God, mi save pinis long yu.","poem":1},{"lineBreak":true},{"text":"Yu laik helpim mi,","poem":1},{"text":"olsem na bihain","poem":2},{"text":"bai mi beten long yu,","poem":3},{"text":"na bai yu ranim ol birua","poem":2},{"text":"na ol i ranawe.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mi save bilip long God,","poem":1},{"text":"na mi tingting","poem":2},{"text":"long promis bilong en.","poem":3},{"text":"Olsem na mi litimapim","poem":1},{"text":"nem bilong en.","poem":2},{"text":"Tru tumas, mi tingting","poem":1},{"text":"long promis bilong Bikpela,","poem":2},{"text":"na mi litimapim nem bilong en.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Mi save bilip long God,","poem":1},{"text":"olsem na mi no ken pret","poem":2},{"text":"long wanpela samting.","poem":3},{"text":"Bai ol man inap mekim","poem":1},{"text":"wanem samting long mi? Nogat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"God, samting bipo","poem":1},{"text":"mi promis long mekim,","poem":3},{"text":"em bai mi mekim.","poem":2},{"text":"Yu kisim bek mi pinis na mi no i dai.","poem":1},{"text":"Yu bin helpim mi","poem":2},{"text":"na ol birua i no daunim mi.","poem":3},{"text":"Olsem na God, mi save wokabaut","poem":1},{"text":"wantaim yu oltaim,","poem":3},{"text":"na bai mi wokabaut","poem":2},{"text":"long lait bilong yu","poem":3},{"text":"inap mi dai.","poem":4},{"text":"Na bai mi tenkyu tru long yu","poem":1},{"text":"na mekim wanpela ofa","poem":2},{"text":"bilong makim tenkyu bilong mi.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}