{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":57,"content":[{"type":"heading","content":["Man i prea long God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Miktam. Devit i raitim dispela song long taim em i ranawe long King Sol na i go hait i stap long hul bilong ston. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “No ken bagarapim.”"]},{"type":"verse","number":1,"content":[{"text":"God, yu mas marimari","poem":1},{"text":"long mi.","poem":2},{"text":"Mi go long yu","poem":1},{"text":"na mi laik bai yu lukautim mi.","poem":2},{"text":"Mi stap wantaim yu na mi stap gut,","poem":1},{"text":"olsem ol pikinini kakaruk","poem":2},{"text":"i save hait na stap gut","poem":3},{"text":"aninit long wing","poem":2},{"text":"bilong mama kakaruk.","poem":3},{"text":"Mi laik i stap olsem tasol","poem":1},{"text":"inap olgeta samting","poem":2},{"text":"bilong bagarapim mi i pinis.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi save singaut long God Antap Tru","poem":1},{"text":"bilong em i helpim mi.","poem":2},{"text":"Na em i save givim mi","poem":1},{"text":"olgeta samting mi sot long en.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Em i stap long heven","poem":1},{"text":"na bai em i harim prea bilong mi","poem":2},{"text":"na kisim bek mi.","poem":3},{"text":"Em bai i winim ol man","poem":1},{"text":"i laik bagarapim mi.","poem":2},{"text":"God i save laikim mi tru oltaim,","poem":1},{"text":"na em i no save lusim mi.","poem":2},{"text":"Nogat tru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi save slip namel long ol man","poem":1},{"text":"ol i olsem ol laion,","poem":3},{"text":"na ol i redi","poem":2},{"text":"long kaikai ol manmeri.","poem":3},{"text":"Tit bilong ol i sap tumas","poem":1},{"text":"olsem spia na supsup.","poem":2},{"text":"Tang bilong ol i olsem bainat","poem":1},{"text":"i sap tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, mekim wanpela samting","poem":1},{"text":"i kamap long skai","poem":3},{"text":"bilong soim olgeta manmeri","poem":2},{"text":"olsem,","poem":3},{"text":"yu yet yu nambawan tru","poem":2},{"text":"na yu stap antap long ol.","poem":3},{"text":"Mekim strong bilong yu","poem":1},{"text":"i kamap long ples klia","poem":2},{"text":"long olgeta hap bilong graun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ol birua i putim umben","poem":1},{"text":"bilong holimpas mi.","poem":2},{"text":"Olsem na bikpela hevi","poem":1},{"text":"i daunim mi tru.","poem":2},{"text":"Ol i wokim hul long rot bilong mi,","poem":1},{"text":"bilong mi pundaun long en.","poem":2},{"text":"Tasol mi no pundaun.","poem":1},{"lineBreak":true},{"text":"Ol yet i pundaun long dispela hul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God, long bel bilong mi,","poem":1},{"text":"mi bilip strong long yu.","poem":2},{"text":"Yes, mi bilip olgeta long yu.","poem":1},{"text":"Na bai mi singim song","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Mi mas kirap lusim slip.","poem":1},{"text":"Mi mas paitim gita","poem":2},{"text":"na kulele samting.","poem":3},{"text":"Tulait i bruk,","poem":1},{"text":"orait bai mi mekim dispela musik.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bikpela, bai mi tenkyu long yu","poem":1},{"text":"namel long ol arapela lain.","poem":2},{"text":"Bai mi go long olgeta manmeri","poem":1},{"text":"na litimapim nem bilong yu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu save laikim mipela moa yet.","poem":1},{"text":"Sapos mipela i laik makim dispela,","poem":2},{"text":"bai mak i go inap long skai.","poem":3},{"text":"Oltaim yu save bihainim","poem":1},{"text":"gutpela tok bilong yu.","poem":2},{"text":"Sapos mipela inap kaunim","poem":1},{"text":"olgeta taim yu bin mekim gut","poem":2},{"text":"long mipela,","poem":3},{"text":"bai mak i go antap","poem":2},{"text":"inap long ol klaut.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"God, mi laik bai ol manmeri","poem":1},{"text":"i litimapim nem bilong yu","poem":2},{"text":"antap tru.","poem":3},{"text":"Mekim strong bilong yu","poem":1},{"text":"i kamap ples klia","poem":2},{"text":"long olgeta hap bilong graun,","poem":3},{"text":"bai olgeta manmeri i ken save","poem":2},{"text":"long biknem bilong yu.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}