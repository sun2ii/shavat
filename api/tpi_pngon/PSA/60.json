{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":60,"content":[{"type":"heading","content":["Man i beten bilong God i kisim bek em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em kain song ol i kolim Miktam. Dispela song em i bilong givim skul long yumi. Devit i raitim dispela song long taim em i pait long ol Siria bilong graun Mesopotemia na kantri Soba na Joap i kam bek na i kilim i dai 12,000 man bilong kantri Idom long Ples Daun I Gat Planti Sol. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “Naispela plaua bilong kontrak.”"]},{"type":"verse","number":1,"content":[{"text":"God, yu bin lusim mipela,","poem":1},{"text":"na mekim mipela","poem":2},{"text":"i lus long pait.","poem":3},{"text":"Yu gat kros long mipela","poem":1},{"text":"na yu mekim olsem.","poem":2},{"text":"Tasol nau yu mas kam bek","poem":1},{"text":"na helpim mipela gen.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu bin mekim graun bilong mipela","poem":1},{"text":"i guria.","poem":2},{"text":"Yu brukim graun pinis","poem":1},{"text":"na bikpela hul i kamap.","poem":2},{"text":"Nau graun i laik bagarap olgeta.","poem":1},{"text":"Orait yu ken stretim bek gen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu bin givim planti hevi","poem":1},{"text":"long mipela ol manmeri bilong yu.","poem":2},{"text":"I olsem yu givim wain long mipela","poem":1},{"text":"na mekim mipela i dring.","poem":2},{"text":"Mipela i dring pinis","poem":1},{"text":"na mipela i kamap longlong tru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yu mas apim wanpela plak,","poem":1},{"text":"bai ol man i save aninit long yu","poem":2},{"text":"ol i ken lukim","poem":3},{"text":"na ranawe long ol birua","poem":4},{"text":"na kam kamap long dispela plak","poem":2},{"text":"na i stap gut.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Yu save laikim tru mipela,","poem":1},{"text":"olsem na harim prea bilong mi,","poem":3},{"text":"na kisim bek mipela","poem":2},{"text":"long bikpela strong bilong yu,","poem":3},{"text":"na bai mipela i ken i stap gut.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"God i stap long haus bilong em yet","poem":1},{"text":"na i tok olsem,","poem":3},{"text":"“Mi winim pait pinis,","poem":2},{"text":"olsem na bai mi amamas","poem":3},{"text":"na tilim graun bilong Sekem","poem":2},{"lineBreak":true},{"text":"na bilong ples daun bilong Sukot","poem":2},{"text":"long ol manmeri bilong mi.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Gileat wantaim Manase","poem":2},{"text":"i bilong mi.","poem":3},{"text":"Efraim i olsem","poem":2},{"text":"hat kapa bilong mi.","poem":3},{"text":"Juda i olsem stik king bilong mi.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tasol kantri Moap em i olsem","poem":2},{"text":"dis waswas bilong mi,","poem":3},{"text":"na kantri Idom i olsem","poem":2},{"text":"ples bilong putim su bilong mi.","poem":3},{"text":"Na bai mi winim ol Filistia","poem":2},{"text":"long pait,","poem":4},{"text":"na bai mi amamas na singaut.”","poem":3}]},{"type":"verse","number":9,"content":[{"text":"God,","poem":1},"“Jerusalem, ol bikpela sip i spit i kam bilong bringim ol pikinini bilong yu i kam bek long yu.”",{"text":"husat inap bringim mi","poem":1},{"text":"long dispela taun","poem":2},{"text":"i gat strongpela banis?","poem":3},{"text":"Na husat inap bringim mi","poem":1},{"text":"long Idom?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"God, yu bin givim baksait pinis","poem":1},{"text":"long mipela, a?","poem":2},{"text":"Yu no laik helpim","poem":1},{"text":"ol ami bilong mipela, a?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yu ken helpim mipela","poem":1},{"text":"na mipela i pait long ol birua.","poem":2},{"text":"Long wanem, helpim bilong ol man","poem":1},{"text":"em i samting nating tasol.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sapos God i helpim mipela,","poem":1},{"text":"bai mipela i winim pait.","poem":2},{"text":"Em yet bai i daunim","poem":1},{"text":"ol birua bilong mipela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}