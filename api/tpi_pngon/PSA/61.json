{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":61,"content":[{"type":"heading","content":["Man i prea long God i lukautim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long paitim ol gita samting."]},{"type":"verse","number":1,"content":[{"text":"God, harim mi","poem":1},{"text":"i singaut long yu.","poem":2},{"text":"Putim yau gut","poem":1},{"text":"long beten bilong mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi stap longwe long ples bilong mi,","poem":1},{"text":"na bel bilong mi i hevi tru.","poem":2},{"text":"Olsem na mi singaut long yu","poem":1},{"text":"bilong yu ken helpim mi.","poem":2},{"text":"Bringim mi i go","poem":1},{"text":"long wanpela ples hait,","poem":3},{"text":"bai ol birua i no inap","poem":2},{"text":"bagarapim mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Long wanem, yu tasol","poem":1},{"text":"yu save lukautim mi gut.","poem":2},{"text":"Yu tasol i strongpela banis","poem":1},{"text":"bilong mi,","poem":3},{"text":"olsem na ol birua","poem":2},{"text":"i no inap daunim mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi laikim tumas bai mi stap","poem":1},{"text":"long haus bilong yu","poem":2},{"text":"inap long taim mi dai.","poem":3},{"text":"Na mi laik i stap gut klostu long yu,","poem":1},{"text":"olsem pikinini kakaruk","poem":2},{"text":"i save stap gut","poem":3},{"text":"aninit long wing","poem":2},{"text":"bilong mama kakaruk.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"God, olgeta samting","poem":1},{"text":"mi promis pinis long yu,","poem":3},{"text":"em yu bin harim.","poem":2},{"text":"Na yu givim mi pinis ol samting,","poem":1},{"text":"olsem yu save givim","poem":3},{"text":"long ol manmeri","poem":2},{"text":"i save litimapim nem bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Larim king i stap laip planti yia.","poem":1},{"text":"Larim em i stap longpela taim","poem":2},{"text":"long graun.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"God, larim em i stap king oltaim","poem":1},{"text":"long ai bilong yu.","poem":2},{"text":"Yu save laikim em tumas,","poem":1},{"text":"olsem na oltaim","poem":2},{"text":"yu ken was gut long em.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Yu mekim olsem,","poem":1},{"text":"orait long olgeta de","poem":2},{"text":"bai mi bihainim ol promis","poem":3},{"text":"bipo mi tokim yu long en,","poem":4},{"text":"na oltaim bai mi singim song","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}