{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":62,"content":[{"type":"heading","content":["God wanpela tasol i save lukautim yumi"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim Jedutun."]},{"type":"verse","number":1,"content":[{"text":"Mi save bilip strong","poem":1},{"text":"long God wanpela tasol.","poem":2},{"text":"Em wanpela tasol","poem":1},{"text":"i save kisim bek mi","poem":2},{"text":"na mi stap laip.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Em wanpela tasol","poem":1},{"text":"i wasman bilong mi","poem":2},{"text":"na helpim bilong mi.","poem":3},{"text":"Em wanpela tasol","poem":1},{"text":"i strongpela banis bilong mi.","poem":2},{"text":"Olsem na mi no ken lus long pait.","poem":1},{"text":"Nogat tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hamas taim yet","poem":1},{"text":"yupela i laik pait long mi","poem":2},{"text":"bilong bagarapim mi?","poem":3},{"text":"Yupela i laik bai mi bagarap","poem":1},{"text":"olsem wanpela banis","poem":2},{"text":"i pundaun na i bruk olgeta.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi gat biknem,","poem":1},{"text":"tasol yupela i laik bagarapim","poem":2},{"text":"biknem bilong mi.","poem":3},{"text":"Yupela i laikim tumas tok giaman.","poem":2},{"text":"Yupela i save autim gutpela tok","poem":1},{"text":"long God i ken mekim gut","poem":2},{"text":"long mi,","poem":3},{"text":"tasol long bel bilong yupela","poem":2},{"text":"yupela i tok olsem,","poem":3},{"text":"“Mipela i laik bai God","poem":2},{"text":"i mas bagarapim em.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi save bilip strong","poem":1},{"text":"long God wanpela tasol.","poem":2},{"text":"Na mi wet long em wanpela tasol","poem":1},{"text":"i helpim mi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Em wanpela tasol","poem":1},{"text":"i wasman bilong mi","poem":2},{"text":"na helpim bilong mi.","poem":3},{"text":"Na em wanpela tasol","poem":1},{"text":"i strongpela banis bilong mi.","poem":2},{"text":"Olsem na mi no ken lus long pait.","poem":1},{"text":"Nogat tru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God wanpela tasol","poem":1},{"text":"i save kisim bek mi","poem":3},{"text":"na em yet i save givim biknem","poem":2},{"text":"long mi.","poem":3},{"text":"Em i strongpela wasman bilong mi.","poem":2},{"text":"God yet em i strongpela banis","poem":1},{"text":"bilong mi","poem":3},{"text":"na ol birua","poem":2},{"text":"i no inap bagarapim mi.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Yupela ol lain bilong mi,","poem":1},{"text":"oltaim yupela i mas bilip","poem":2},{"text":"long God.","poem":3},{"text":"Yupela i mas autim olgeta hevi","poem":1},{"text":"na olgeta tingting bilong yupela","poem":2},{"text":"long em.","poem":3},{"text":"Long wanem, yumi ken i go long em","poem":1},{"text":"na i stap gut.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ol manmeri nating","poem":1},{"text":"i olsem win nating","poem":2},{"text":"i kamap long maus.","poem":3},{"text":"Na ol man i gat bikpela namba","poem":1},{"text":"ol tu i samting nating tasol.","poem":2},{"text":"Sapos yumi skelim ol,","poem":1},{"text":"bai yumi lukim ol i no hevi tru.","poem":2},{"text":"Hevi bilong ol","poem":1},{"text":"i no inap wantaim hevi","poem":2},{"text":"bilong win bilong maus.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Yupela i no ken tingting olsem,","poem":1},{"text":"“Pasin bilong pait","poem":2},{"text":"na pasin","poem":3},{"text":"bilong stilim ol samting","poem":4},{"text":"em i gutpela pasin,","poem":3},{"text":"na em inap long mekim mipela","poem":2},{"text":"i kamap maniman.”","poem":3},{"text":"Sapos mani na olgeta samting","poem":1},{"text":"bilong yupela","poem":2},{"text":"i kamap planti,","poem":3},{"text":"orait yupela i no ken ting","poem":2},{"text":"ol dispela samting tasol","poem":3},{"text":"em i strong bilong yupela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Planti taim mi harim","poem":1},{"text":"God i tok olsem,","poem":3},{"text":"“Mi God, mi gat bikpela strong.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Na oltaim mi save laikim tumas","poem":3},{"text":"olgeta manmeri.”","poem":4},{"text":"Bikpela, yu save givim pe","poem":1},{"text":"long mipela olgeta manmeri","poem":2},{"text":"inap long pasin mipela i mekim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}