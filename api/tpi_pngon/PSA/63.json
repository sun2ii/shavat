{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":63,"content":[{"type":"heading","content":["Prea bilong man i laik bai God i stap wantaim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song long taim em i stap long distrik Juda long graun i no gat man."]},{"type":"verse","number":1,"content":[{"text":"God, yu God bilong mi.","poem":1},{"text":"Mi wok strong long painim yu.","poem":2},{"text":"Spirit bilong mi i laikim tumas","poem":1},{"text":"long i stap wantaim yu.","poem":2},{"text":"Bodi bilong mi i laikim tru","poem":1},{"text":"long i stap wantaim yu,","poem":3},{"text":"olsem man i stap long ples drai","poem":2},{"text":"i no gat wara long en","poem":3},{"text":"na i dai long wara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mi laik lukim yu long haus bilong yu","poem":1},{"text":"na mi laik yu soim mi","poem":2},{"text":"bikpela strong bilong yu","poem":3},{"text":"na namba bilong yu.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Laip bilong dispela graun i gutpela,","poem":1},{"text":"tasol marimari bilong yu","poem":2},{"text":"i nambawan tru.","poem":3},{"text":"Olsem na mi litimapim","poem":1},{"text":"nem bilong yu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bai mi tenkyu long yu","poem":1},{"text":"na litimapim nem bilong yu","poem":2},{"text":"inap mi dai.","poem":3},{"text":"Bai mi litimapim han bilong mi","poem":1},{"text":"na prea long yu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Spirit bilong mi","poem":1},{"text":"em i stap gutpela tru,","poem":3},{"text":"olsem man i kaikai","poem":2},{"text":"ol gutpela kaikai,","poem":3},{"text":"na em i kaikai inap pinis.","poem":2},{"text":"Na mi amamas","poem":1},{"text":"na litimapim nem bilong yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taim mi slip long bet","poem":1},{"text":"mi save tingting long yu.","poem":2},{"text":"Long nait mi save tingting","poem":1},{"text":"long yu tasol.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Long wanem,","poem":1},{"text":"yu bin helpim mi oltaim.","poem":2},{"text":"Mi stap klostu long yu,","poem":1},{"text":"olsem pikinini kakaruk","poem":2},{"lineBreak":true},{"text":"i stap aninit","poem":2},{"text":"long wing bilong mama,","poem":3},{"text":"na mi singim song bilong amamas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mi save wokabaut wantaim yu,","poem":1},{"text":"na yu save was gut long mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Na ol man i laik kilim mi i dai,","poem":1},{"text":"bai ol i go","poem":2},{"text":"long ples bilong ol man i dai pinis.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Bai ol i dai long pait,","poem":1},{"text":"na bai ol weldok","poem":2},{"text":"i kaikai bodi bilong ol.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Tasol mi king,","poem":1},{"text":"bai mi amamas long yu, God.","poem":2},{"text":"Ol man i mekim promis","poem":1},{"text":"long nem bilong yu","poem":2},{"text":"long ol bai i bihainim yu,","poem":3},{"text":"ol i ken amamas tru.","poem":2},{"text":"Tasol bai yu pasim maus","poem":1},{"text":"bilong ol man bilong giaman.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}