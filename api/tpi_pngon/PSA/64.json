{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":64,"content":[{"type":"heading","content":["Man i prea long God i lukautim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, mi gat bikpela hevi,","poem":1},{"lineBreak":true},{"text":"na yu ken harim","poem":1},{"text":"beten bilong mi.","poem":2},{"text":"Mi pret long ol birua.","poem":1},{"text":"Yu mas helpim mi","poem":2},{"text":"bai ol i no inap kilim mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Ol man nogut i painim rot","poem":1},{"text":"bilong bagarapim mi,","poem":3},{"text":"na ol i bung bilong paitim mi.","poem":2},{"text":"Olsem na yu mas lukautim mi","poem":1},{"text":"bai ol i no inap","poem":2},{"text":"mekim nogut long mi.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Tok bilong ol man i sap tumas","poem":1},{"text":"na i katim mi olsem bainat.","poem":2},{"text":"Tok nogut bilong ol em i makim mi,","poem":1},{"text":"olsem man i taitim banara","poem":2},{"text":"na makim man long spia.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol i hait i stap na sutim ol spia","poem":1},{"text":"long ol gutpela man.","poem":2},{"text":"Ol i no save pret,","poem":1},{"text":"olsem na ol i sut kwiktaim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ol i strongim ol yet","poem":1},{"text":"long mekim dispela pasin nogut.","poem":2},{"text":"Ol i toktok long ol hap ples","poem":1},{"text":"ol i laik putim umben","poem":2},{"text":"bilong holimpas ol arapela man.","poem":3},{"text":"Na ol i tingting olsem,","poem":1},{"text":"“I no gat wanpela man","poem":2},{"text":"bai i lukim mipela.”","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ol i pasim tok","poem":1},{"text":"long mekim sampela pasin nogut,","poem":2},{"text":"na ol i tok,","poem":3},{"text":"“Mipela i tingting pinis long rot","poem":2},{"text":"bilong mekim","poem":3},{"text":"wanpela pasin nogut.","poem":4},{"text":"Na i no gat wanpela man","poem":2},{"text":"inap painimaut dispela samting","poem":3},{"text":"mipela i laik mekim.”","poem":4},{"text":"Yumi no inap save","poem":1},{"text":"long tingting na bel bilong ol man.","poem":2},{"text":"Em i hait olgeta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tasol God bai i sutim ol","poem":1},{"text":"long spia bilong en,","poem":3},{"text":"na wantu bikpela sua bai i kamap.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ol i bin tok","poem":1},{"text":"long bagarapim narapela man,","poem":3},{"text":"olsem na bai God i bagarapim ol.","poem":2},{"text":"Ol man i lukim ol","poem":1},{"text":"bai ol i lap nogut long ol","poem":2},{"text":"na tromoi het.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bai olgeta manmeri i pret long God.","poem":1},{"text":"Na ol bai i toktok","poem":2},{"text":"long dispela samting","poem":3},{"text":"God i mekim,","poem":4},{"text":"na tingting oltaim long dispela.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Olgeta stretpela manmeri","poem":1},{"text":"bai ol i amamas long Bikpela,","poem":3},{"text":"na bai ol i go long em","poem":2},{"text":"na hait long samting nogut.","poem":3},{"text":"Na bai olgeta stretpela manmeri","poem":1},{"text":"ol i litimapim nem bilong Bikpela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}