{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":65,"content":[{"type":"heading","content":["Ol i amamas na tenkyu long God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em song bilong lotu. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, mipela i mas i go","poem":1},{"text":"long Saion","poem":2},{"text":"na litimapim nem bilong yu.","poem":3},{"text":"Na bai mipela inapim tru","poem":1},{"text":"olgeta samting","poem":2},{"text":"mipela i promis bipo long mekim.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yu save harim beten bilong mipela.","poem":1},{"text":"Olsem na mipela olgeta manmeri","poem":2},{"text":"i mas i go long yu.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Mipela i mas tingim","poem":1},{"text":"sin bilong mipela","poem":2},{"text":"na mekim olsem.","poem":3},{"text":"Rong bilong mipela","poem":1},{"text":"i daunim mipela tru,","poem":3},{"text":"tasol mipela i save","poem":2},{"text":"yu inap lusim sin bilong mipela.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol man yu save makim","poem":1},{"text":"na bringim i go","poem":2},{"text":"long haus bilong yu,","poem":3},{"text":"ol i ken amamas.","poem":2},{"text":"Long dispela haus bilong yu yet,","poem":1},{"text":"planti gutpela samting i stap.","poem":2},{"text":"Olsem na taim mipela i stap","poem":1},{"text":"long banis bilong yu,","poem":3},{"text":"mipela i save belgut tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God, yu tasol","poem":1},{"text":"yu save kisim bek mipela","poem":2},{"text":"na mipela i stap gut.","poem":3},{"text":"Yu ken harim prea bilong mipela.","poem":2},{"text":"Wok yu mekim","poem":1},{"text":"bilong kisim bek mipela","poem":3},{"text":"em i samting tru.","poem":2},{"text":"Ol pipel i stap longwe long mipela","poem":1},{"text":"long olgeta hap graun,","poem":3},{"text":"ol i save bilip strong long yu.","poem":2},{"text":"Sapos mipela i laik go long ol,","poem":1},{"text":"mipela i mas brukim","poem":2},{"text":"bikpela solwara.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Long strong bilong yu,","poem":1},{"text":"yu bin mekim ol maunten i kamap","poem":2},{"text":"na ol i stap long ples bilong ol.","poem":3},{"text":"Strong bilong yu i bikpela moa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu tasol i save mekim biksi i stap isi","poem":1},{"text":"na pairap bilong en i dai,","poem":3},{"text":"na yu save mekim i dai","poem":2},{"text":"pait bilong ol manmeri.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ol manmeri i lukim","poem":1},{"text":"ol dispela samting yu mekim,","poem":3},{"text":"na olgeta i pret long yu.","poem":2},{"text":"Long hap bilong sankamap","poem":1},{"text":"na san i go daun","poem":3},{"text":"ol i tingim","poem":2},{"text":"olgeta samting yu bin mekim,","poem":3},{"text":"na ol i singaut amamas long yu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yu save salim ren i kam","poem":1},{"text":"na long dispela pasin","poem":2},{"text":"yu lukautim gut graun.","poem":3},{"text":"Na yu mekim graun i gat planti gris,","poem":1},{"text":"na kaikai i kamap gut.","poem":2},{"text":"God, yu bin putim ol wara","poem":1},{"text":"long olgeta hap,","poem":3},{"text":"na ol i no save drai.","poem":2},{"text":"Dispela i save mekim","poem":1},{"text":"kaikai i kamap planti","poem":2},{"text":"na ol manmeri i kisim.","poem":3},{"text":"Dispela wok yu yet yu bin mekim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu save salim planti ren i kam daun","poem":1},{"text":"long olgeta gaden,","poem":3},{"text":"na wara i stap insait long graun.","poem":2},{"text":"Wara i save mekim graun i no strong","poem":1},{"text":"na kaikai i kamap gut.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yu gutpela tumas long mipela","poem":1},{"text":"na yu mekim kaikai","poem":2},{"text":"i kamap planti.","poem":3},{"text":"Sapos yu go long wanpela hap,","poem":1},{"text":"yu save mekim","poem":2},{"text":"planti gutpela kaikai","poem":3},{"text":"i kamap long dispela hap.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Ol bulmakau na sipsip i pulap","poem":1},{"text":"long olgeta ples i gat gras.","poem":2},{"text":"Na planti gaden i stap","poem":1},{"text":"long ol maunten,","poem":3},{"text":"olsem na ol maunten i amamas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Planti","poem":1},"Wit i pulap tru.",{"text":"sipsip tumas","poem":1},{"text":"i stap long ples i gat gras","poem":2},{"text":"na pulapim tru.","poem":3},{"text":"Wit i pulap tru long ol ples daun","poem":1},{"text":"namel long ol maunten.","poem":2},{"text":"Na olgeta samting i amamas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}