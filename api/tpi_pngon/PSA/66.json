m":2}]},{"type":"verse","number":11,"content":[{"text":"Yu bin holimpas mipela","poem":1},{"text":"long umben,","poem":3},{"text":"na yu putim bikpela hevi","poem":2},{"text":"long mipela.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yu bin larim ol birua","poem":1},{"text":"i krungutim mipela tru.","poem":2},{"text":"Na mipela i bin wokabaut","poem":1},{"text":"long paia na haiwara.","poem":2},{"text":"Tasol nau yu bringim mipela","poem":1},{"text":"i kam long gutpela ples.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bipo hevi i kamap long mi","poem":1},{"text":"na mi promis long givim yu","poem":2},{"text":"ol ofa bilong paia i kukim olgeta.","poem":3},{"text":"Mi tingim yet dispela promis,","poem":1},{"text":"olsem na bai mi bringim","poem":2},{"text":"ol dispela ofa long yu.","poem":3},{"text":"Bai mi bringim ol abus","poem":1},{"text":"long haus bilong yu","poem":3},{"text":"na kukim long paia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bai mi kukim ol patpela abus","poem":1},{"text":"long alta","poem":3},{"text":"na givim long yu olsem ofa.","poem":2},{"text":"Bai mi kukim ol sipsip man","poem":1},{"text":"na bai yu smelim gutpela smel","poem":2},{"text":"bilong dispela ofa.","poem":3},{"text":"Na bai mi kisim bulmakau man","poem":1},{"text":"na meme tu","poem":3},{"text":"na mekim ofa long yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yupela ol manmeri","poem":1},{"text":"i save stap aninit long God,","poem":3},{"text":"yupela kam harim tok bilong mi.","poem":2},{"text":"Bai mi toksave long yupela","poem":1},{"text":"long olgeta samting","poem":2},{"text":"God i bin mekim","poem":3},{"text":"bilong helpim mi.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Bipo mi singaut","poem":1},{"text":"long em i helpim mi,","poem":3},{"text":"na mi redi long singim ol song","poem":2},{"text":"bilong litimapim","poem":3},{"text":"nem bilong em.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Tasol sapos mi ting pasin nogut","poem":1},{"text":"em i samting nating,","poem":3},{"text":"orait Bikpela i no inap","poem":2},{"text":"harim beten bilong mi.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Tasol God i harim mi pinis.","poem":1},{"text":"Tru tumas,","poem":2},{"text":"em i harim beten bilong mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mi litimapim nem bilong God.","poem":1},{"lineBreak":true},{"text":"Long wanem, em i no givim baksait","poem":1},{"text":"long prea bilong mi,","poem":3},{"text":"na em i no lusim pasin","poem":2},{"text":"bilong sori oltaim long mi.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":19}