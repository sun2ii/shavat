{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":68,"content":[{"type":"heading","content":["Ol Israel i amamas long God i helpim ol"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, em song bilong lotu. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God i ken kam hariap","poem":1},{"text":"na rausim nabaut","poem":2},{"text":"ol birua bilong en.","poem":3},{"text":"Ol man i save birua long God,","poem":1},{"text":"ol i mas ranawe long em.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Win i save rausim smok i go pinis,","poem":1},{"text":"na olsem tasol","poem":2},{"text":"God bai i rausim ol birua.","poem":3},{"text":"Paia i save hatim gris bilong kandel","poem":1},{"text":"na gris i save kamap olsem wara.","poem":2},{"text":"Olsem tasol ol manmeri nogut","poem":1},{"text":"bai ol i bagarap","poem":2},{"text":"long ai bilong God.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Tasol ol stretpela man","poem":1},{"text":"bai i amamas,","poem":3},{"text":"na bai ol i belgut","poem":2},{"text":"long ai bilong God.","poem":3},{"text":"Ol bai i amamas moa yet.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yumi mas singim song","poem":1},{"text":"bilong litimapim nem bilong God.","poem":2},{"text":"Em i save sindaun long ol klaut","poem":1},{"text":"na wokabaut i go.","poem":2},{"lineBreak":true},{"text":"Stretim rot bilong em.","poem":2},{"text":"Nem bilong em Bikpela.","poem":1},{"text":"Yumi amamas long ai bilong em.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God i save stap","poem":1},{"text":"long ples bilong em yet,","poem":3},{"text":"na em i save lukautim ol pikinini,","poem":2},{"text":"papa bilong ol i dai pinis.","poem":3},{"text":"Na em i save helpim ol meri,","poem":1},{"text":"man bilong ol i dai pinis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Em i save givim haus","poem":1},{"text":"long ol man na meri i stap wanpis","poem":2},{"text":"na bai ol i sindaun gut long en.","poem":3},{"text":"Na em i save pinisim kalabus","poem":1},{"text":"bilong ol kalabusman","poem":3},{"text":"na ol i stap gut long ples.","poem":2},{"text":"Tasol ol bikhetman bai i go i stap","poem":1},{"text":"long ples nogut tru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God, bipo yu bin i go paslain","poem":1},{"text":"long ol manmeri bilong yu","poem":2},{"text":"na yu bringim ol i kam","poem":3},{"text":"na yu wokabaut long ples drai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Long dispela taim graun i guria,","poem":1},{"text":"na bikpela ren i kam daun,","poem":3},{"text":"long wanem, God, yu kam pinis.","poem":2},{"text":"Tru tumas, God bilong Israel,","poem":1},{"text":"yu kam pinis","poem":2},{"text":"na maunten Sainai","poem":3},{"text":"i guria moa yet.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"God, yu bin mekim traipela ren","poem":1},{"text":"i kam daun long graun bilong yu,","poem":3},{"text":"na yu mekim dispela graun nogut","poem":2},{"text":"i kamap gutpela gen.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ol manmeri bilong yu","poem":1},{"text":"i wokim ples long dispela graun.","poem":2},{"text":"Yu gutpela tumas","poem":1},{"text":"na yu givim kaikai samting","poem":2},{"text":"long ol dispela rabisman.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela i givim tok","poem":1},{"text":"long ol manmeri bilong en,","poem":3},{"text":"na planti meri","poem":2},{"text":"i go autim dispela tok.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Dispela tok i olsem, “Ol king","poem":1},{"text":"wantaim olgeta ami bilong ol,","poem":2},{"lineBreak":true},{"text":"olgeta i ranawe pinis.”","poem":2},{"text":"Na ol meri i bin i stap long ples,","poem":1},{"text":"ol i tilim ol samting","poem":2},{"text":"ol man i kisim long pait.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ol meri i bilas nogut tru","poem":1},{"text":"long silva na gol","poem":3},{"text":"na ol i luk nais","poem":2},{"text":"olsem gutpela pisin,","poem":3},{"text":"bodi bilong en i lait olsem silva","poem":2},{"lineBreak":true},{"text":"na wing bilong en","poem":2},{"text":"i lait olsem gol.","poem":3},{"text":"Tasol bilong wanem sampela man","poem":1},{"text":"i stap long banis bilong sipsip?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taim God I Gat Olgeta Strong","poem":1},{"text":"i rausim ol king","poem":2},{"text":"long maunten Salmon","poem":3},{"text":"na ol i ranawe nabaut,","poem":4},{"text":"orait em i mekim ren ais","poem":2},{"text":"i kam daun long dispela maunten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maunten bilong Basan","poem":1},{"text":"em i traipela maunten tru.","poem":2},{"text":"Em i gat planti kil moa.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Yu maunten i gat planti kil,","poem":1},{"text":"bilong wanem yu lukim","poem":2},{"text":"maunten God i bin makim","poem":3},{"text":"bilong em i ken sindaun long en","poem":4},{"text":"na yu ting","poem":2},{"text":"em i olsem samting nating?","poem":3},{"text":"Bikpela bai i stap oltaim oltaim","poem":1},{"text":"long dispela maunten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bikpela i lusim maunten Sainai","poem":1},{"text":"na i kam i stap","poem":2},{"text":"long haus bilong em yet.","poem":3},{"text":"Em i kam wantaim","poem":1},{"text":"ol soldia bilong en","poem":3},{"text":"ol i stap long planti tausen","poem":2},{"text":"strongpela karis bilong pait.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"God i bin i go antap","poem":1},{"text":"long maunten i antap moa,","poem":3},{"text":"na em i kisim bikpela lain kalabus","poem":2},{"text":"i go wantaim em.","poem":3},{"text":"Em i bin kisim ol presen","poem":1},{"text":"bilong ol bikhetman","poem":2},{"text":"i bin pait long em.","poem":3},{"text":"God, Bikpela bai i stap","poem":1},{"text":"long dispela maunten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yumi litimapim nem bilong Bikpela.","poem":1},{"lineBreak":true},{"text":"Olgeta de em i save karim ol hevi","poem":1},{"text":"bilong yumi.","poem":2},{"text":"God wanpela tasol","poem":1},{"text":"i save kisim bek yumi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"God bilong yumi yet","poem":1},{"text":"i save helpim yumi","poem":2},{"text":"na yumi stap gut.","poem":3},{"text":"God, Bikpela bilong yumi,","poem":1},{"text":"em i save helpim yumi","poem":2},{"text":"na yumi no i dai.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tru tumas, God bai i bagarapim tru","poem":1},{"text":"ol birua bilong en,","poem":3},{"text":"em dispela ol man i save","poem":2},{"text":"bihainim pasin nogut oltaim.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Bikpela i tok olsem,","poem":1},{"text":"“Bai mi kisim","poem":2},{"lineBreak":true},{"text":"ol birua bilong yupela long Basan","poem":2},{"text":"na bringim ol i kam bek.","poem":4},{"text":"Maski ol i stap daunbilo tru","poem":2},{"text":"long as bilong solwara,","poem":3},{"text":"bai mi bringim ol i kam bek.","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bai yupela i mekim save","poem":2},{"text":"long ol birua bilong yupela,","poem":3},{"text":"na yupela i ken belgut.","poem":2},{"lineBreak":true},{"text":"Na ol dok bilong yupela","poem":2},{"lineBreak":true},{"text":"i ken dringim blut bilong ol birua","poem":2},{"text":"inap long laik bilong ol.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"God na king bilong mi,","poem":1},{"text":"olgeta manmeri i lukim yu","poem":2},{"text":"i winim pinis dispela pait","poem":3},{"text":"na yu amamas i kam.","poem":2},{"text":"Olgeta i lukim yu i go insait","poem":1},{"text":"long haus bilong yu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ol man i singim song","poem":1},{"text":"ol i go pas,","poem":3},{"text":"na ol man bilong mekim musik","poem":2},{"text":"ol i kam bihain,","poem":3},{"text":"na ol yangpela meri","poem":2},{"text":"i save paitim ol liklik kundu,","poem":3},{"text":"ol i wokabaut namel.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ol i singim song olsem,","poem":1},{"text":"“Yumi manmeri bilong God,","poem":2},{"text":"yumi bung pinis,","poem":3},{"text":"orait yumi mas litimapim","poem":2},{"text":"nem bilong God.","poem":3},{"text":"Yumi ol lain bilong Israel,","poem":2},{"text":"yumi litimapim","poem":3},{"text":"nem bilong Bikpela.”","poem":4}]},{"type":"verse","number":27,"content":[{"text":"Ol liklik lain bilong Benjamin","poem":1},{"text":"ol i go pas.","poem":2},{"text":"Na ol hetman bilong Juda","poem":1},{"text":"wantaim ol manmeri bilong Juda","poem":2},{"text":"ol i bihainim ol Benjamin.","poem":3},{"text":"Na ol hetman","poem":1},{"text":"bilong Sebulun na Naptali","poem":2},{"text":"ol i kam bihain.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"God, yu mas soim strong","poem":1},{"text":"bilong yu long mipela.","poem":2},{"text":"Bipo yu bin helpim mipela","poem":1},{"text":"long dispela strong tasol.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ol king i bringim presen","poem":1},{"text":"na i givim long yu","poem":2},{"text":"long haus bilong yu","poem":3},{"text":"long Jerusalem.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"Yu ken krosim dispela wel abus","poem":1},{"text":"i stap long tais.","poem":2},{"noteId":0},{"text":"Yu ken krosim","poem":1},{"text":"ol dispela lain manmeri","poem":3},{"text":"i save mekim","poem":2},{"text":"olsem ol bulmakau man","poem":3},{"text":"na olsem ol pikinini bulmakau.","poem":2},{"text":"Krosim ol","poem":1},{"text":"inap ol i brukim skru long yu","poem":3},{"text":"na givim silva bilong ol long yu.","poem":2},{"text":"Rausim ol dispela manmeri","poem":1},{"text":"i laikim tumas long kirapim pait,","poem":2},{"text":"na ol i ken ranawe nabaut.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"King bilong Isip","poem":1},{"text":"bai i salim ol ofisa bilong en","poem":2},{"text":"i go long Jerusalem","poem":3},{"text":"bilong harim tok bilong yu.","poem":2},{"text":"Na bai ol Sudan i litimapim han","poem":1},{"text":"na i prea long yu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yupela ol arapela lain manmeri,","poem":1},{"text":"yupela i mas singim ol song","poem":2},{"text":"long God","poem":3},{"text":"bilong litimapim nem bilong em.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Em i save wokabaut long skai,","poem":1},{"text":"na dispela skai i stap bipo yet.","poem":2},{"text":"Harim. God i singaut strong moa.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yupela olgeta manmeri i mas tokaut","poem":1},{"text":"long bikpela strong bilong God.","poem":2},{"text":"Em i king bilong ol Israel.","poem":3},{"text":"Yumi inap lukim bikpela strong","poem":1},{"text":"bilong en long skai.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"God bilong Israel","poem":1},{"text":"i stap long haus bilong en,","poem":3},{"text":"na yumi mas pret long God.","poem":2},{"text":"Em i save givim bikpela strong","poem":1},{"text":"long ol manmeri bilong en.","poem":2},{"text":"Litimapim nem bilong God.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"68.30 Sampela man i ting “dispela wel abus i stap long tais,” em i tok bokis long kantri Isip.","reference":{"chapter":68,"verse":30}}]},"thisChapterLink":"/api/tpi_pngon/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}