{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":69,"content":[{"type":"heading","content":["Man i askim God long helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim “Naispela plaua.”"]},{"type":"verse","number":1,"content":[{"text":"God, helpim mi.","poem":1},{"text":"Wara i kam antap pinis","poem":2},{"text":"inap long nek bilong mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi go daun","poem":1},{"text":"insait long bikpela tais.","poem":2},{"text":"I no gat strongpela graun","poem":1},{"text":"bai mi sanap long en.","poem":2},{"text":"Mi wokabaut long wara i daun moa","poem":1},{"text":"na tait i laik karamapim mi olgeta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"God, mi wok long singaut singaut","poem":1},{"text":"long yu","poem":3},{"text":"na strong bilong mi i pinis.","poem":2},{"text":"Na nek bilong mi em i drai,","poem":1},{"text":"na ai bilong mi i pen, long wanem,","poem":2},{"text":"mi wet longtaim tumas","poem":3},{"text":"long yu i helpim mi.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Ol man i birua nating long mi,","poem":1},{"text":"ol i planti moa.","poem":2},{"text":"Namba bilong ol gras","poem":1},{"text":"bilong het bilong mi","poem":2},{"text":"i no inap long ol.","poem":3},{"text":"Ol birua i laik mekim","poem":1},{"text":"pasin nogut long mi,","poem":3},{"text":"na ol i giaman","poem":2},{"text":"long as bilong dispela pasin","poem":3},{"text":"ol i mekim.","poem":4},{"text":"Ol dispela man i strong tumas","poem":1},{"text":"na ol i laik kilim mi i dai.","poem":2},{"text":"Mi no bin stilim","poem":1},{"text":"wanpela samting bilong ol,","poem":3},{"text":"tasol ol i sutim planti tok","poem":2},{"text":"long mi.","poem":3},{"text":"Olsem na mi givim","poem":1},{"text":"ol samting bilong mi yet long ol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God, yu save pinis long mi,","poem":1},{"text":"mi krankiman tasol.","poem":2},{"text":"Ol sin bilong mi i no hait","poem":1},{"text":"long ai bilong yu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"God, Bikpela I Gat Olgeta Strong,","poem":1},{"text":"yu no ken larim mi","poem":2},{"text":"i mekim sampela pasin","poem":3},{"text":"i no stret","poem":4},{"text":"na bai ol man i save bilip long yu,","poem":2},{"text":"ol i sem.","poem":3},{"text":"God bilong mipela Israel,","poem":1},{"text":"yu no ken larim mi","poem":2},{"text":"i mekim sampela pasin","poem":3},{"text":"na bai ol man i tok nogut","poem":2},{"text":"long ol manmeri","poem":3},{"text":"i save lotu long yu.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Mi save bihainim yu,","poem":1},{"text":"olsem na ol man","poem":2},{"text":"i tok bilas long mi,","poem":3},{"text":"na ol i mekim mi i sem.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ol brata bilong mi ol i lukim mi","poem":1},{"text":"i olsem man bilong narapela lain.","poem":2},{"text":"Na ol famili bilong mi ol i lukim mi","poem":1},{"text":"i olsem man bilong longwe ples.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mi laikim tru haus bilong yu,","poem":1},{"text":"olsem na mi wok strong","poem":2},{"text":"long mekim dispela haus","poem":3},{"text":"i stap gut.","poem":4},{"text":"Ol man i tok nogut long yu,","poem":1},{"text":"na dispela tok i kalap long mi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mi save tambu long kaikai","poem":1},{"text":"na long dispela pasin","poem":2},{"text":"mi daunim mi yet","poem":3},{"text":"long ai bilong yu.","poem":4},{"text":"Tasol ol manmeri","poem":1},{"text":"i tok nogut long mi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mi pasim klos bilong sori,","poem":1},{"text":"tasol ol man i tok nogut","poem":2},{"text":"na tok bilas long mi.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ol man i bung long rot","poem":1},{"text":"na ol i toktok long mi.","poem":2},{"text":"Na ol man i spak long wain samting","poem":1},{"text":"ol i kirapim sampela song nogut","poem":2},{"text":"long mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tasol maski,","poem":1},{"text":"mi bai beten long yu, Bikpela.","poem":2},{"text":"God, long wanpela taim","poem":1},{"text":"yu yet yu makim,","poem":3},{"text":"yu ken bekim prea bilong mi.","poem":2},{"text":"Yu bai mekim olsem, long wanem,","poem":1},{"text":"yu save laikim mi tumas","poem":3},{"text":"na yu promis pinis","poem":2},{"text":"long kisim bek mi.","poem":3},{"text":"Na yu no save giaman. Nogat tru.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yu mas kisim bek mi","poem":1},{"text":"long dispela tais","poem":3},{"text":"bai mi no inap i go insait","poem":2},{"text":"na lus long en.","poem":3},{"text":"Yu lukautim mi bai ol birua","poem":1},{"text":"i no inap bagarapim mi,","poem":2},{"lineBreak":true},{"text":"na dispela wara i daun tumas","poem":2},{"text":"em i no inap karamapim mi.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Yu no ken larim dispela tait","poem":1},{"text":"i kisim mi.","poem":2},{"text":"Na yu no ken larim mi","poem":1},{"text":"i lus long wara i daun tru,","poem":2},{"text":"bai matmat i daunim mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bikpela, oltaim","poem":1},{"text":"yu save laikim mi tru","poem":2},{"text":"na dispela i gutpela tumas,","poem":3},{"text":"olsem na yu ken bekim prea","poem":2},{"text":"bilong mi.","poem":3},{"text":"Yu save marimari moa yet long mi,","poem":1},{"text":"olsem na nau","poem":2},{"text":"yu ken i kam helpim mi.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Mi wokman bilong yu,","poem":1},{"text":"olsem na yu no ken hait long mi.","poem":2},{"text":"Mi gat bikpela hevi,","poem":1},{"text":"olsem na yu mas hariap","poem":2},{"text":"na bekim beten bilong mi.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Yu kam klostu long mi","poem":1},{"text":"na kisim bek mi.","poem":2},{"text":"Kisim bek mi long han","poem":1},{"text":"bilong ol birua bilong mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yu save pinis long ol man","poem":1},{"text":"i save tok nogut long mi.","poem":2},{"text":"Na yu save long ol i mekim mi i sem","poem":1},{"text":"na daunim nem bilong mi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dispela tok nogut","poem":1},{"text":"i bagarapim tingting bilong mi,","poem":2},{"text":"na mekim mi i bel hevi moa yet.","poem":3},{"text":"Na mi no gat strong moa.","poem":2},{"text":"Mi bin ting bai sampela man","poem":1},{"text":"i sori long mi,","poem":3},{"text":"tasol i no gat wanpela.","poem":2},{"text":"Na mi ting bai sampela man","poem":1},{"text":"i givim mi gutpela tok","poem":2},{"text":"bilong strongim bel bilong mi,","poem":3},{"text":"tasol i no gat.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taim mi hangre","poem":1},{"text":"ol i givim marasin nogut long mi.","poem":2},{"text":"Nek bilong mi i drai","poem":1},{"text":"na ol i givim mi","poem":2},{"text":"wain nogut tasol bilong dring.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Orait taim ol i bung","poem":1},{"text":"long bikpela kaikai,","poem":3},{"text":"mi laik bai dispela taim","poem":2},{"text":"bilong amamas","poem":3},{"text":"i ken kamap samting","poem":2},{"text":"bilong bagarapim ol,","poem":3},{"text":"olsem umben i holim abus","poem":2},{"lineBreak":true},{"text":"na olsem hul","poem":2},{"text":"ol i ken pundaun long en.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Mekim ai bilong ol i tudak,","poem":1},{"text":"bai ol i no inap lukluk moa.","poem":2},{"text":"Bagarapim baksait bilong ol,","poem":1},{"text":"bai ol i no inap sanap strong.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yu ken kros moa long ol","poem":1},{"text":"na mekim save long ol.","poem":2},{"text":"Na belhat bilong yu i ken kisim ol,","poem":1},{"text":"na bai ol i lus.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ples ol i stap long en,","poem":1},{"text":"em i ken i stap nating,","poem":3},{"text":"na yu no ken larim wanpela man","poem":2},{"text":"i stap long ol haus sel bilong ol.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Sampela man yu bin bekim sin","poem":1},{"text":"bilong ol pastaim,","poem":3},{"text":"ol man nogut i wok yet","poem":2},{"text":"long mekim nogut long ol.","poem":3},{"text":"Yu bin brukim skin","poem":1},{"text":"bilong sampela man","poem":2},{"text":"na givim pen long ol,","poem":3},{"text":"na ol man nogut i tok bilas long ol","poem":2},{"text":"na givim hevi long ol.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Yu no ken lusim tingting","poem":1},{"text":"long sin bilong ol man nogut.","poem":2},{"text":"Na yu no ken larim ol i kam insait","poem":1},{"text":"long lain manmeri bilong yu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yu mas rausim nem bilong ol","poem":1},{"text":"long buk bilong laip.","poem":2},{"text":"Na yu no ken putim nem bilong ol","poem":1},{"text":"i stap wantaim nem","poem":2},{"text":"bilong ol stretpela manmeri.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tasol mi karim bikpela hevi","poem":1},{"text":"na pen.","poem":2},{"text":"God, kisim bek mi","poem":1},{"text":"na mekim mi i orait gen.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bai mi mekim song","poem":1},{"text":"na litimapim nem bilong God,","poem":3},{"text":"na bai mi tenkyu long em","poem":2},{"text":"na tokaut long biknem bilong em.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Na bai Bikpela i laikim tumas","poem":1},{"text":"dispela pasin mi mekim.","poem":2},{"text":"Em i no save laikim tumas","poem":1},{"text":"ol ofa bilong bulmakau.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ol manmeri i karim hevi","poem":1},{"text":"bai ol i lukim dispela","poem":2},{"text":"na bai ol i amamas.","poem":3},{"text":"Na ol manmeri i save lotu long God,","poem":1},{"text":"ol i ken kisim strong gen.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bikpela i save harim prea","poem":1},{"text":"bilong ol manmeri","poem":2},{"text":"i sot long ol samting,","poem":3},{"text":"na em i no save lusim tingting","poem":2},{"text":"long ol manmeri bilong en","poem":3},{"text":"ol i stap long kalabus.","poem":4}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Skai wantaim graun na solwara","poem":1},{"text":"na olgeta pis samting","poem":2},{"text":"i stap long solwara,","poem":3},{"text":"yupela olgeta i mas litimapim","poem":2},{"text":"nem bilong God.","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Long wanem, God bai i kisim bek","poem":1},{"text":"ol manmeri bilong Saion","poem":2},{"text":"long han bilong ol birua,","poem":3},{"text":"na bai em i wokim gen","poem":2},{"text":"ol taun bilong Juda.","poem":3},{"text":"Em i mekim olsem,","poem":1},{"text":"na bai ol manmeri bilong God","poem":2},{"text":"ol i ken i stap gut","poem":3},{"text":"long ol dispela taun","poem":4},{"text":"na kisim dispela graun olgeta.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ol tumbuna pikinini","poem":1},{"text":"bilong ol wokman bilong God","poem":2},{"text":"bai ol i kisim dispela graun,","poem":3},{"text":"na ol manmeri i laikim tru God,","poem":2},{"text":"bai ol i stap oltaim","poem":3},{"text":"long dispela graun.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}