{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":70,"content":[{"type":"heading","content":["Man i beten long God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song, bilong mekim God i tingim ol hevi bilong en. Em i song bilong man i bosim musik."]},{"type":"verse","number":1,"content":[{"text":"God, plis","poem":1},{"text":"yu ken kisim bek mi.","poem":2},{"text":"Bikpela, yu kam hariap","poem":1},{"text":"na helpim mi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sampela man i laik kilim mi i dai.","poem":1},{"text":"Yu mas daunim ol na paulim ol,","poem":2},{"text":"bai ol i sem.","poem":3},{"text":"Na sampela man i amamas","poem":1},{"text":"long ol hevi bilong mi.","poem":2},{"text":"Yu mas rausim ol i go bek","poem":1},{"text":"na daunim nem bilong ol.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ol dispela man i tok bilas long mi,","poem":1},{"text":"yu mas semim ol moa yet,","poem":3},{"text":"bai ol i kirap nogut tru","poem":2},{"text":"long pasin bilong ol.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Tasol ol manmeri i save go long yu,","poem":1},{"text":"ol i ken belgut","poem":2},{"text":"na amamas long yu.","poem":3},{"text":"Dispela olgeta manmeri","poem":1},{"text":"yu bin kisim bek ol,","poem":3},{"text":"na ol i laikim tumas","poem":2},{"text":"dispela wok yu bin mekim long ol,","poem":3},{"text":"oltaim ol i ken tok olsem,","poem":2},{"text":"“God em i nambawan tru.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"God, mi no gat strong,","poem":1},{"text":"na mi no inap helpim mi yet.","poem":2},{"text":"Olsem na yu mas i kam long mi","poem":1},{"text":"kwiktaim.","poem":2},{"text":"Bikpela, yu yet","poem":1},{"text":"yu man bilong helpim mi","poem":2},{"text":"na kisim bek mi.","poem":3},{"text":"Yu no ken wet,","poem":1},{"text":"yu mas helpim mi kwik.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}