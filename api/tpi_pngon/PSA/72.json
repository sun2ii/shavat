"text":"i bihainim stretpela pasin oltaim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"King i ken stretim gut","poem":1},{"text":"hevi bilong ol rabisman,","poem":3},{"text":"na em i ken helpim ol man","poem":2},{"text":"i sot long ol samting.","poem":3},{"text":"Na em i ken daunim ol man","poem":1},{"text":"i laik mekim nogut","poem":2},{"text":"long ol arapela man.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Taim san na mun i lait yet,","poem":1},{"text":"ol manmeri bilong yu","poem":2},{"text":"i ken lotu long yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yu ken mekim king","poem":1},{"text":"i kamap gutpela man,","poem":2},{"text":"bai pasin bilong en i gutpela","poem":3},{"text":"olsem ren i save kam daun","poem":2},{"text":"long ol gaden","poem":3},{"text":"na kaikai i kamap gutpela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na taim em i stap yet","poem":1},{"text":"ol manmeri i ken bihainim","poem":2},{"text":"stretpela pasin tasol.","poem":3},{"text":"Taim mun i lait yet,","poem":1},{"text":"planti gutpela samting","poem":2},{"text":"i ken kamap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Em bai i stap king","poem":1},{"text":"na bosim olgeta manmeri","poem":3},{"text":"long hap bilong solwara","poem":2},{"text":"i stap klostu","poem":3},{"text":"na i go inap long solwara","poem":2},{"text":"i stap longwe.","poem":3},{"text":"Na mak bilong graun bilong en","poem":1},{"text":"i ken stat long wara Yufretis","poem":3},{"text":"na i go inap","poem":2},{"text":"long olgeta hap bilong graun.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ol manmeri i stap","poem":1},{"text":"long ples drai i gat wesan","poem":3},{"text":"bai ol i stap aninit","poem":2},{"text":"long dispela king.","poem":3},{"text":"Na ol birua bilong en","poem":1},{"text":"bai ol i slip stret long graun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"King bilong Spen","poem":1},{"text":"na ol king bilong ol ailan nabaut,","poem":2},{"text":"bai ol i givim presen long em.","poem":3},{"text":"Na king bilong Arebia","poem":1},{"text":"na king bilong Seba,","poem":2},{"text":"bai ol i bringim takis long em.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Olgeta king","poem":1},{"text":"bai i brukim skru long em.","poem":2},{"text":"Na olgeta lain manmeri","poem":1},{"text":"bai i mekim wok bilong en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Em i save helpim","poem":1},{"text":"ol rabisman i singaut long em.","poem":2},{"text":"Na ol manmeri i sot long ol samting","poem":1},{"text":"na i no gat helpim,","poem":2},{"text":"orait em yet bai i helpim ol.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Em i save sori long ol manmeri","poem":1},{"text":"i no gat strong na i stap rabis.","poem":2},{"text":"Na ol manmeri i no gat samting","poem":1},{"text":"em i save kisim bek ol.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sapos ol man nogut","poem":1},{"text":"i laik daunim ol","poem":2},{"text":"na bagarapim ol,","poem":3},{"text":"em i save kisim bek ol.","poem":2},{"text":"Em i save laikim ol tumas","poem":1},{"text":"na em i mekim olsem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"King i ken i stap longtaim!","poem":1},{"text":"Ol Arebia i ken givim gol long em.","poem":2},{"text":"Na bai ol manmeri i ken beten","poem":1},{"text":"long God i helpim em oltaim,","poem":3},{"text":"na oltaim God i ken mekim gut","poem":2},{"text":"long em.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Planti rais na wit samting","poem":1},{"text":"i ken kamap","poem":2},{"text":"long ol gaden bilong ol manmeri,","poem":3},{"text":"inap olsem i save kamap","poem":2},{"text":"long Lebanon.","poem":3},{"text":"Na ol manmeri i ken kamap planti","poem":1},{"text":"long ol taun,","poem":3},{"text":"olsem gras i save kamap planti","poem":2},{"text":"long olgeta hap.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Na bai ol manmeri","poem":1},{"text":"i no ken lusim tingting","poem":2},{"text":"long nem bilong king,","poem":3},{"text":"na olgeta taim san i wok yet","poem":2},{"text":"long kam antap long skai,","poem":3},{"text":"ol man i ken wok","poem":2},{"text":"long givim biknem","poem":3},{"text":"long dispela king.","poem":4},{"text":"Na olgeta lain manmeri","poem":1},{"text":"i ken litimapim nem bilong en.","poem":2},{"text":"Na ol i ken askim God","poem":1},{"text":"long givim blesing long ol","poem":2},{"text":"na mekim gut long ol","poem":3},{"text":"long wankain pasin","poem":2},{"text":"olsem em i save mekim gut","poem":3},{"text":"long king.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Litimapim nem bilong God,","poem":1},{"text":"Bikpela bilong ol Israel.","poem":2},{"text":"Em wanpela tasol i save mekim","poem":1},{"text":"ol dispela gutpela samting.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Litimapim gutpela nem","poem":1},{"text":"bilong em oltaim oltaim.","poem":2},{"text":"Biknem bilong en","poem":1},{"text":"i ken inapim olgeta graun.","poem":2},{"text":"I tru tumas.","poem":1}]},{"type":"verse","number":20,"content":["Ol prea bilong Devit, pikinini man bilong Jesi, i pinis nau."]},{"type":"heading","content":["(Song 73-89)"]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}