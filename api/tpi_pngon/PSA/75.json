{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":75,"content":[{"type":"heading","content":["God i daunim ol man nogut na i helpim ol gutpela man"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song, em song bilong lotu. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “No ken bagarapim.”"]},{"type":"verse","number":1,"content":[{"text":"God, mipela i save tenkyu","poem":1},{"text":"long yu","poem":3},{"text":"na litimapim nem bilong yu","poem":2},{"text":"oltaim.","poem":3},{"text":"Na mipela i save tokaut","poem":1},{"text":"long biknem bilong yu,","poem":3},{"text":"na stori long ol kain kain","poem":2},{"text":"gutpela samting yu bin mekim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"God i tok olsem,","poem":1},{"text":"“Mi makim pinis","poem":2},{"text":"wanpela de bilong kot.","poem":3},{"text":"Na kot bilong mi","poem":2},{"text":"bai i go stret olgeta.","poem":3},{"text":"I no inap paul.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Graun wantaim ol manmeri","poem":2},{"text":"i stap long en","poem":3},{"text":"ol i ken lus.","poem":4},{"text":"Tasol as bilong graun bai mi holim","poem":2},{"text":"na em bai i stap strong.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mi tokim ol hambakman olsem,","poem":2},{"text":"‘Yupela i no ken bikhet.’","poem":3},{"text":"Na mi tokim ol man nogut,","poem":2},{"text":"‘Yupela i no ken litimapim","poem":3},{"text":"nem bilong yupela.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Yupela i no ken amamas","poem":2},{"text":"long strong bilong yupela yet,","poem":3},{"text":"na yupela i no ken bikmaus","poem":2},{"text":"na tok bilas long mi.’”","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wok bilong skelim pasin","poem":1},{"text":"bilong ol manmeri","poem":2},{"text":"i no kamap","poem":3},{"text":"long hap bilong sankamap","poem":2},{"lineBreak":true},{"text":"na long hap bilong san i go daun","poem":2},{"lineBreak":true},{"text":"na long hap bilong not","poem":2},{"lineBreak":true},{"text":"na long hap bilong saut.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God wanpela tasol","poem":1},{"text":"i save skelim pasin bilong yumi.","poem":2},{"text":"Em i save daunim narapela man","poem":1},{"text":"na litimapim narapela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela i holim wanpela kap","poem":1},{"text":"nupela wain i strong tumas","poem":2},{"text":"i pulap long en.","poem":3},{"text":"Em i kapsaitim","poem":1},{"text":"na olgeta man nogut i dring","poem":2},{"text":"na i pinisim tru.","poem":3},{"text":"Olsem tasol bai ol manmeri nogut","poem":1},{"text":"i mas kamap long kot bilong God","poem":2},{"text":"na bai ol i lus tru.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tasol oltaim bai mi tokaut","poem":1},{"text":"long God bilong Jekop,","poem":3},{"text":"na bai mi singim song moa yet","poem":2},{"text":"bilong litimapim","poem":3},{"text":"nem bilong em.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Bai God i pinisim strong","poem":1},{"text":"bilong ol man nogut,","poem":3},{"text":"tasol em bai i givim","poem":2},{"text":"bikpela strong moa","poem":3},{"text":"long ol stretpela man.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}