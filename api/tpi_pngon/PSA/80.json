{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":80,"content":[{"type":"heading","content":["Ol Israel i prea bai God i helpim ol long sanap gen"]},{"type":"hebrew_subtitle","content":["Asap i raitim dispela song. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim, “Ol naispela plaua bilong kontrak.”"]},{"type":"verse","number":1,"content":[{"text":"Wasman bilong Israel,","poem":1},{"text":"yu save stiaim wokabaut","poem":2},{"text":"bilong mipela ol sipsip bilong yu.","poem":3},{"text":"Harim krai bilong mipela.","poem":1},{"text":"Yu stap king antap long ol ensel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yu save sori","poem":1},{"text":"long ol Efraim na ol Benjamin","poem":2},{"text":"na ol Manase.","poem":3},{"text":"Mekim dispela sori","poem":1},{"text":"i kamap ples klia.","poem":2},{"text":"Soim bikpela strong bilong yu","poem":1},{"text":"long mipela,","poem":3},{"text":"na kam helpim mipela","poem":2},{"text":"bai mipela i no ken bagarap.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"God, bringim mipela","poem":1},{"text":"i kam bek long yu.","poem":2},{"text":"Marimari long mipela","poem":1},{"text":"na helpim mipela","poem":2},{"text":"bai mipela i no ken lus.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"God, Bikpela I Gat Olgeta Strong,","poem":1},{"text":"hamas taim yet bai yu kros","poem":2},{"text":"long ol prea","poem":3},{"text":"bilong ol manmeri bilong yu?","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Yu bin mekim mipela i krai tumas,","poem":1},{"text":"na aiwara bilong mipela","poem":2},{"text":"i olsem kaikai na dring","poem":3},{"text":"bilong mipela.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Yu larim ol arapela lain manmeri","poem":1},{"text":"i stap klostu long mipela","poem":3},{"text":"ol i kam pait bilong kisim","poem":2},{"text":"graun bilong mipela.","poem":3},{"text":"Na ol birua i tok bilas","poem":1},{"text":"na i lap long mipela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God I Gat Olgeta Strong,","poem":1},{"text":"yu ken kisim mipela","poem":2},{"text":"i go bek gen.","poem":3},{"text":"Yu ken marimari long mipela","poem":1},{"text":"na helpim mipela","poem":2},{"text":"bai mipela i no ken lus.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bipo yu bin kisim","poem":1},{"text":"wanpela diwai wain long Isip","poem":2},{"text":"na bringim i kam.","poem":3},{"text":"Na yu rausim ol arapela lain","poem":1},{"text":"long dispela graun,","poem":3},{"text":"na yu planim dispela diwai wain","poem":2},{"text":"long graun bilong ol.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Yu kliaim wanpela graun bilong en,","poem":1},{"text":"na yu planim pinis.","poem":2},{"text":"Em i kamap na rop bilong en","poem":1},{"text":"i go daun olgeta","poem":2},{"text":"na em i kamap bikpela tru","poem":3},{"text":"na i karamapim","poem":2},{"text":"olgeta hap bilong graun.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Na han bilong dispela diwai wain","poem":1},{"text":"i karamapim olgeta maunten","poem":2},{"text":"na ol traipela diwai sida.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Han bilong en i go inap","poem":1},{"text":"long biksolwara Mediterenian","poem":2},{"text":"na i go inap long wara Yufretis.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Tasol bilong wanem yu brukim pinis","poem":1},{"text":"ol banis i raunim gaden wain?","poem":2},{"text":"Nau ol manmeri","poem":1},{"text":"i wokabaut long rot,","poem":2},{"text":"ol i inap stilim kaikai bilong en.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Na ol welpik i save krungutim","poem":1},{"text":"na ol wel abus i save kaikai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"God I Gat Olgeta Strong,","poem":1},{"text":"yu mas tingting gen long mipela.","poem":2},{"text":"Yu stap long heven","poem":1},{"text":"na yu mas lukluk i kam daun","poem":2},{"text":"long mipela.","poem":3},{"text":"Mipela i olsem diwai wain bilong yu.","poem":1},{"text":"Kam helpim mipela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yu yet yu bin planim mipela","poem":1},{"text":"long strong bilong yu.","poem":3},{"text":"Nau yu mas kam helpim mipela.","poem":2},{"text":"Mipela i olsem yangpela diwai wain","poem":1},{"text":"yu bin mekim i kamap strong tru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ol birua bilong mipela i katim pinis","poem":1},{"text":"na kukim long paia.","poem":2},{"text":"Mobeta yu mas kros long ol","poem":1},{"text":"na bagarapim ol.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tasol mipela ol manmeri","poem":1},{"text":"yu bin makim bilong yu yet,","poem":3},{"text":"na yu bin mekim mipela","poem":2},{"text":"i kamap bikpela na strong,","poem":3},{"text":"olsem na yu mas helpim","poem":2},{"text":"na lukautim mipela.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Sapos yu mekim olsem,","poem":1},{"text":"orait bai mipela","poem":2},{"text":"i no inap lusim yu gen.","poem":3},{"text":"Yu helpim mipela i stap gut,","poem":1},{"text":"na bai mipela i beten long yu","poem":2},{"text":"na litimapim nem bilong yu.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"God, Bikpela I Gat Olgeta Strong,","poem":1},{"text":"yu mas kisim mipela","poem":2},{"text":"i kam bek long yu.","poem":3},{"text":"Marimari long mipela","poem":1},{"text":"na helpim mipela,","poem":2},{"text":"bai mipela i no ken lus.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}