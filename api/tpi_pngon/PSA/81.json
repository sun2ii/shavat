Israel.","poem":2},{"text":"God bilong Jekop","poem":1},{"text":"i givim dispela lo long yumi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taim bipo God i go pait","poem":1},{"text":"long ol Isip,","poem":3},{"text":"em i givim dispela lo","poem":2},{"text":"long yumi Israel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mi harim nek bilong wanpela man","poem":1},{"text":"na mi no save","poem":2},{"text":"em i nek bilong husat.","poem":3},{"text":"Em i tok olsem, “Mi rausim pinis","poem":1},{"text":"olgeta hevipela samting i stap","poem":2},{"text":"long sol bilong yupela.","poem":3},{"text":"Na mi larim yupela i putim","poem":2},{"text":"ol basket bilong wok","poem":3},{"text":"i go daun long graun.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Taim yupela i gat bikpela hevi","poem":2},{"text":"na yupela i singaut long mi,","poem":3},{"text":"mi bin helpim yupela","poem":2},{"text":"na yupela i stap gut.","poem":3},{"text":"Mi stap long ples hait bilong mi","poem":2},{"text":"namel long klaut i pairap","poem":3},{"text":"na mi harim prea bilong yupela.","poem":2},{"lineBreak":true},{"text":"Bipo yupela i stap","poem":2},{"text":"long ol hul wara bilong Meriba","poem":3},{"text":"na mi traim yupela.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ol manmeri bilong mi,","poem":2},{"text":"mi laik givim strongpela tok","poem":3},{"text":"long yupela.","poem":4},{"text":"Ol Israel, mi laikim tumas","poem":2},{"text":"long yupela i harim tok","poem":3},{"text":"bilong mi.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Yupela i no ken bihainim","poem":2},{"text":"ol giaman god","poem":3},{"text":"bilong ol arapela lain.","poem":4},{"text":"Na yupela i no ken lotu","poem":2},{"text":"long narapela god.","poem":3},{"text":"Yupela i mas lotu","poem":2},{"text":"long mi wanpela tasol.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mi tasol mi Bikpela,","poem":2},{"text":"mi God bilong yupela.","poem":3},{"text":"Mi yet mi bin kisim yupela","poem":2},{"text":"long Isip","poem":4},{"text":"na bringim yupela i kam.","poem":3},{"text":"Yupela opim maus","poem":2},{"text":"na bai mi putim kaikai","poem":3},{"lineBreak":true},{"text":"long maus bilong yupela.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Tasol ol manmeri bilong mi","poem":2},{"text":"i no laik harim tok bilong mi.","poem":3},{"text":"Tru tumas, ol Israel","poem":2},{"text":"i no laik bihainim tok bilong mi.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Olsem na mi larim ol","poem":2},{"text":"i bihainim pasin bikhet","poem":3},{"text":"bilong ol,","poem":4},{"text":"na ol i mekim ol samting","poem":2},{"text":"long laik bilong ol.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Mi laikim tumas","poem":2},{"text":"bai ol manmeri bilong mi","poem":3},{"text":"ol i harim tok bilong mi.","poem":4},{"text":"Na mi laik bai ol Israel","poem":2},{"text":"i bihainim laik bilong mi oltaim.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Sapos ol i mekim olsem,","poem":2},{"text":"orait kwiktaim bai mi daunim","poem":3},{"text":"ol birua bilong ol.","poem":4},{"text":"Bai mi pait long ol birua","poem":2},{"text":"na winim ol tru.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ol manmeri i no save laikim mi,","poem":2},{"text":"bai ol i pret nogut","poem":3},{"text":"na brukim skru long mi.","poem":4},{"text":"Na oltaim bai mi","poem":2},{"text":"mekim save long ol.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Tasol mi laik givim","poem":2},{"text":"gutpela kaikai tru long yupela,","poem":3},{"text":"na givim yupela hani bilong bus,","poem":2},{"text":"na bai bel bilong yupela","poem":3},{"text":"i pulap.”","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}