{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":84,"content":[{"type":"heading","content":["Man i laikim tru haus bilong God"]},{"type":"hebrew_subtitle","content":["Dispela song em song bilong ol lain Kora. Man i bosim musik i mas tokim ol man long paitim kain gita bilong taun Get."]},{"type":"verse","number":1,"content":[{"text":"Bikpela I Gat Olgeta Strong,","poem":1},{"text":"mi laikim tumas","poem":2},{"text":"haus bilong yu.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi laikim tumas bai mi stap long en.","poem":1},{"text":"Olgeta laik bilong mi","poem":2},{"text":"i laikim tumas haus bilong yu.","poem":3},{"text":"Long bodi na tingting olgeta","poem":1},{"text":"mi mekim song","poem":2},{"text":"bilong amamas long yu,","poem":3},{"text":"God i gat laip.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Bikpela I Gat Olgeta Strong,","poem":1},{"text":"yu king na God bilong mi.","poem":2},{"text":"Ol liklik pisin i bin wokim haus","poem":1},{"text":"klostu long alta bilong yu","poem":3},{"text":"na ol i save lukautim","poem":2},{"text":"ol pikinini bilong ol.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ol manmeri i save stap","poem":1},{"text":"long haus bilong yu,","poem":2},{"text":"ol i save belgut tru,","poem":3},{"text":"na oltaim ol i save singim song","poem":2},{"text":"bilong litimapim nem bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wanem ol manmeri","poem":1},{"text":"i save kisim strong long yu","poem":3},{"text":"na i laikim tumas long i go","poem":2},{"text":"long maunten Saion,","poem":3},{"text":"ol i ken amamas oltaim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol i wokabaut i go","poem":1},{"text":"long ples daun i drai,","poem":3},{"text":"na dispela ples i save kamap","poem":2},{"text":"ples i gat planti hul wara.","poem":3},{"text":"Na ren long moning i pundaun","poem":1},{"text":"na wara i save pulap long ol hul.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ol dispela man i wokabaut","poem":1},{"text":"na i kamap strong.","poem":2},{"text":"Bai ol i go kamap long Saion,","poem":1},{"text":"na lukim God i stap.","poem":2},{"text":"Em i God i antap","poem":1},{"text":"long olgeta giaman god.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"God, Bikpela I Gat Olgeta Strong,","poem":1},{"text":"harim prea bilong mi.","poem":2},{"text":"Yu God bilong Jekop, putim gut yau","poem":1},{"text":"na harim tok bilong mi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lukim king bilong mipela.","poem":1},{"text":"Em i save banisim mipela","poem":2},{"text":"na lukautim gut mipela,","poem":3},{"text":"olsem hap plang i banisim soldia","poem":2},{"text":"long taim bilong pait.","poem":3},{"text":"Bikpela, yu yet yu bin makim em","poem":1},{"text":"na em i stap king,","poem":3},{"text":"na yu ken mekim gut tru long em.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sapos mi stap wanpela de tasol","poem":1},{"text":"long haus bilong yu,","poem":3},{"text":"em i winim tru 1,000 de","poem":2},{"text":"long narapela ples.","poem":3},{"text":"Mi laikim tumas long sanap","poem":1},{"text":"long dua bilong haus","poem":2},{"text":"bilong God bilong mi.","poem":3},{"text":"Tasol mi no laik i stap","poem":1},{"text":"long haus bilong ol man nogut.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bikpela em i wasman bilong yumi","poem":1},{"text":"na em i lait bilong yumi.","poem":2},{"text":"Em i save marimari long yumi","poem":1},{"text":"na givim biknem long yumi.","poem":2},{"text":"Em i no save pasim","poem":1},{"text":"wanpela gutpela samting","poem":3},{"text":"long ol manmeri","poem":2},{"text":"i save wokabaut stret.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Bikpela I Gat Olgeta Strong,","poem":1},{"text":"ol manmeri i save bilip long yu,","poem":2},{"text":"ol i ken amamas oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}