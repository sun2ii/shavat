{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":86,"content":[{"type":"heading","content":["Man i prea bai God i helpim em"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela beten."]},{"type":"verse","number":1,"content":[{"text":"Bikpela, mi no gat strong","poem":1},{"text":"na mi no inap helpim mi yet.","poem":2},{"text":"Olsem na mi laik","poem":1},{"text":"bai yu harim prea bilong mi","poem":2},{"text":"na helpim mi.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Kisim bek mi na mi no ken i dai,","poem":1},{"text":"long wanem, mi save bihainim yu.","poem":2},{"text":"Mi wokman bilong yu,","poem":1},{"text":"na mi save bilip long yu,","poem":2},{"text":"olsem na yu mas helpim mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yu yet yu God bilong mi.","poem":1},{"text":"Plis, yu ken marimari long mi.","poem":2},{"text":"Olgeta de long san na long nait,","poem":1},{"text":"mi save beten long yu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bikpela, givim amamas","poem":1},{"text":"long bel bilong mi,","poem":2},{"text":"wokman bilong yu.","poem":3},{"text":"Long wanem, mi prea long yu tasol.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bikpela, yu gutpela tru","poem":1},{"text":"na yu save rausim","poem":2},{"text":"sin bilong mipela.","poem":3},{"text":"Yu save laikim tumas","poem":1},{"text":"olgeta manmeri","poem":2},{"text":"i save beten long yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bikpela, yu mas putim gut yau","poem":1},{"text":"long prea bilong mi.","poem":2},{"text":"Mi singautim yu bilong helpim mi.","poem":1},{"text":"Harim singaut bilong mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu save helpim mi","poem":1},{"text":"long taim mi singaut long yu.","poem":2},{"text":"Olsem na olgeta taim mi karim hevi","poem":1},{"text":"mi save beten long yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bikpela, i no gat wanpela god","poem":1},{"text":"i olsem yu.","poem":2},{"text":"Yu winim ol.","poem":3},{"text":"Na i no gat wanpela man","poem":1},{"text":"inap mekim wankain wok","poem":2},{"text":"olsem yu save mekim.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Olgeta lain manmeri","poem":1},{"text":"yu bin wokim ol,","poem":3},{"text":"bai ol i go brukim skru long yu,","poem":2},{"text":"na bai ol i litimapim","poem":3},{"text":"nem bilong yu.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Long wanem, yu tasol","poem":1},{"text":"yu gat bikpela strong.","poem":2},{"text":"Na yu tasol yu save mekim","poem":1},{"text":"ol kain kain","poem":2},{"text":"gutpela gutpela samting.","poem":3},{"text":"Yu wanpela tasol yu God tru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela, yu mas skulim mi gut","poem":1},{"text":"long pasin yu laik mi mekim,","poem":3},{"text":"na oltaim bai mi bihainim","poem":2},{"text":"laik bilong yu.","poem":3},{"text":"Lainim mi gut bai mi tingting","poem":1},{"text":"long yu wanpela tasol,","poem":3},{"text":"na mi mekim wok bilong yu","poem":2},{"text":"oltaim.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"God, Bikpela bilong mi,","poem":1},{"text":"mi givim bikpela tenkyu long yu.","poem":2},{"text":"Na mi laik litimapim","poem":1},{"text":"biknem bilong yu oltaim oltaim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Oltaim yu save laikim mi tumas.","poem":3},{"text":"Yu bin kisim bek mi long dai","poem":1},{"text":"na mi no i go","poem":2},{"text":"long ples bilong ol man i dai pinis.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"God, nau sampela bikhetman i kam","poem":1},{"text":"na i laik pait long mi.","poem":2},{"text":"Ol dispela man nogut","poem":1},{"text":"ol i no save marimari liklik","poem":3},{"text":"na ol i bung bilong kilim mi i dai.","poem":2},{"text":"Ol i no save bihainim tok bilong yu.","poem":1},{"text":"Ol i sakim yu tasol.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tasol Bikpela, sori na marimari","poem":1},{"text":"i pulap long yu,","poem":3},{"text":"na yu no save kros kwiktaim.","poem":2},{"text":"Yu save laikim mipela tumas,","poem":1},{"text":"na yu no save senisim","poem":2},{"text":"tok bilong yu.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Yu mas kam bek long mi","poem":1},{"text":"na sori long mi.","poem":2},{"text":"Strongim mi na kisim bek mi,","poem":1},{"text":"long wanem, mi save mekim","poem":2},{"text":"wok bilong yu","poem":3},{"text":"olsem mama bilong mi","poem":2},{"text":"i bin mekim.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Bikpela, mi laik yu mekim samting","poem":1},{"text":"bilong soim mi yu laikim mi.","poem":2},{"text":"Olsem na ol birua i ken luksave","poem":1},{"text":"long yu i bin helpim mi","poem":2},{"text":"na strongim mi.","poem":3},{"text":"Na ol i ken sem tru","poem":1},{"text":"long pasin bilong ol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}