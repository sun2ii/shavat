xt":"bai mi kaunim ol Isip na Babilon","poem":2},{"text":"wantaim ol.","poem":3},{"text":"Na bai mi tokim ol Filistia na Tair","poem":2},{"text":"na Itiopia olsem,","poem":3},{"text":"ol tu i bilong Jerusalem.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bai mi tok long Jerusalem olsem,","poem":2},{"text":"‘Em i ples","poem":3},{"text":"bilong olgeta lain manmeri.’”","poem":4},{"text":"Na God Antap Tru,","poem":1},{"text":"em yet bai i sanapim Jerusalem","poem":2},{"text":"na mekim em i stap strong olgeta.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Bikpela bai i raitim nem","poem":1},{"text":"bilong ol arapela lain manmeri,","poem":3},{"text":"na em bai i bungim ol","poem":2},{"text":"na kaunim ol wantaim ol manmeri","poem":3},{"text":"bilong Jerusalem.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Na ol manmeri","poem":1},{"text":"i stap long Jerusalem","poem":3},{"text":"bai ol i singsing na amamas.","poem":2},{"text":"Na bai ol i tok, “Jerusalem, yu as","poem":1},{"text":"bilong olgeta gutpela samting","poem":2},{"text":"mipela i gat.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}