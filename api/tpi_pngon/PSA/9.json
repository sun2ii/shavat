{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":9,"content":[{"type":"heading","content":["Man i tenkyu long God long ol stretpela pasin bilong God"]},{"type":"hebrew_subtitle","content":["Devit i raitim dispela song. Man i bosim musik i mas tokim ol man long singim song long nek ol i kolim Almut Laben."]},{"type":"verse","number":1,"content":[{"text":"God, long bel bilong mi,","poem":1},{"text":"mi laik tenkyu tru long yu.","poem":2},{"text":"Mi laik tokim ol manmeri","poem":1},{"text":"long olgeta gutpela wok","poem":2},{"text":"yu bin mekim.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Mi tingting long yu","poem":1},{"text":"na mi singim song bilong amamas.","poem":2},{"text":"God Antap Tru, bai mi singim song","poem":1},{"text":"bilong litimapim","poem":2},{"text":"biknem bilong yu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ol birua bilong mi i lukim yu","poem":1},{"text":"na ol i ranawe i go.","poem":2},{"text":"Ol i pundaun na i dai olgeta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yu sindaun long sia olsem jas","poem":1},{"text":"na yu mekim stretpela kot.","poem":2},{"text":"Yu skelim pasin bilong mi","poem":1},{"text":"na mi winim kot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yu bin kotim ol haiden.","poem":1},{"lineBreak":true},{"text":"Yu bagarapim pinis ol man nogut,","poem":1},{"text":"na oltaim oltaim bai i no gat man","poem":2},{"text":"i tingting moa long ol.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ol birua i bagarap pinis","poem":1},{"text":"na bai ol i stap olsem inap oltaim.","poem":2},{"text":"God, yu bagarapim pinis","poem":1},{"text":"ol taun bilong ol,","poem":3},{"text":"na i no gat man","poem":2},{"text":"bai i tingim ol gen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tasol Bikpela i stap king","poem":1},{"text":"inap oltaim.","poem":2},{"text":"Em i redi pinis long mekim kot.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Em i bosim olgeta lain manmeri","poem":1},{"text":"na ol lo bilong en i stretpela tru.","poem":2},{"text":"Na long stretpela pasin bilong en","poem":1},{"text":"em bai i skelim pasin","poem":2},{"text":"bilong olgeta lain manmeri.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bikpela i stap olsem","poem":1},{"text":"wanpela strongpela haus.","poem":2},{"text":"Ol man i kisim hevi long ol birua,","poem":1},{"text":"ol i ken i go i stap long en.","poem":2},{"text":"Long taim bilong hevi","poem":1},{"text":"ol i ken i go long em na hait.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bikpela, yu no save givim baksait","poem":1},{"text":"long ol manmeri i kam long yu.","poem":2},{"text":"Olsem na ol man i save long yu","poem":1},{"text":"bai ol i bilip tru long yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bikpela i stap king long taun Saion.","poem":1},{"lineBreak":true},{"text":"Singim song long em","poem":1},{"text":"na litimapim nem bilong em.","poem":2},{"text":"Tokaut long olgeta lain pipel","poem":1},{"text":"long ol bikpela wok","poem":2},{"text":"em i bin mekim.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Bikpela i save tingting","poem":1},{"text":"long ol man i karim pen.","poem":2},{"text":"Na em i no save pasim yau bilong en","poem":1},{"text":"long krai bilong ol.","poem":2},{"text":"Em i save bekim pe nogut","poem":1},{"text":"long ol man i mekim nogut","poem":2},{"text":"long ol.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"God, yu ken marimari long mi.","poem":1},{"lineBreak":true},{"text":"Lukim pen na hevi","poem":1},{"text":"ol birua i givim mi.","poem":2},{"text":"Yu save kisim bek mi","poem":1},{"text":"long taim klostu mi laik i dai,","poem":3},{"text":"na yu mekim mi i stap gut.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Olsem na mi ken stori","poem":1},{"text":"long olgeta samting yu bin mekim","poem":3},{"text":"na mi ken litimapim","poem":2},{"text":"nem bilong yu.","poem":3},{"text":"Mi ken sanap","poem":1},{"text":"long dua bilong taun Saion","poem":3},{"text":"na mi ken tokaut na amamas","poem":2},{"text":"long yu bin kisim bek mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ol haiden i wokim hul long graun","poem":1},{"text":"bilong holimpas mipela.","poem":2},{"text":"Tasol ol yet i pundaun long en.","poem":1},{"lineBreak":true},{"text":"Ol i taitim umben","poem":1},{"text":"bilong holimpas mipela,","poem":3},{"text":"tasol umben i pasim ol yet.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"God i soim pasin bilong em","poem":1},{"text":"long ol man","poem":3},{"text":"long taim em i mekim kot.","poem":2},{"text":"Ol man nogut i bin mekim","poem":1},{"text":"ol samting bilong bagarapim","poem":2},{"text":"ol arapela man,","poem":3},{"text":"tasol dispela ol samting i tanim","poem":2},{"text":"na i bagarapim ol yet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ol man nogut na ol lain manmeri","poem":1},{"text":"i save givim baksait long God,","poem":3},{"text":"olgeta i mas i go i stap","poem":2},{"text":"long ples bilong ol man i dai pinis.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Oltaim God i no save lusim tingting","poem":1},{"text":"long ol rabisman.","poem":2},{"text":"Ol man i gat bikpela hevi","poem":1},{"text":"ol i save bilip long God","poem":2},{"lineBreak":true},{"text":"na wetim em i helpim ol.","poem":2},{"text":"Na em bai i no inap larim ol","poem":1},{"text":"i wet nating.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"God, yu kam.","poem":1},{"lineBreak":true},{"text":"Yu no ken larim","poem":1},{"text":"ol man bilong graun","poem":3},{"text":"i luk pes long yu.","poem":2},{"text":"Yu mas mekim ol haiden i sanap","poem":1},{"text":"long kot bilong yu","poem":3},{"text":"na yu skelim pasin bilong ol.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bikpela, yu mas mekim ol","poem":1},{"text":"i pret nogut.","poem":2},{"text":"Yu mas mekim ol lain manmeri","poem":1},{"text":"i pilim olsem,","poem":3},{"text":"ol i samting nating tasol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}