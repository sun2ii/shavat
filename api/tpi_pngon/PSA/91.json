{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":91,"content":[{"type":"heading","content":["God em i wasman bilong yumi"]},{"type":"verse","number":1,"content":[{"text":"Man i go","poem":1},{"text":"long God Antap Tru,","poem":3},{"text":"bilong God i ken lukautim em,","poem":2},{"lineBreak":true},{"text":"em i stap klostu","poem":2},{"text":"long God I Gat Olgeta Strong,","poem":3},{"text":"na God i karamapim em.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bai dispela man","poem":1},{"text":"i tok long Bikpela olsem,","poem":3},{"text":"“Yu save banisim mi","poem":2},{"text":"na yu was gut long mi.","poem":3},{"text":"Yu God bilong mi.","poem":2},{"lineBreak":true},{"text":"Mi save bilip long yu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tru tumas,","poem":1},{"text":"bai God i lukautim yu gut","poem":3},{"text":"na samting i stap hait","poem":2},{"text":"i no inap bagarapim yu.","poem":3},{"text":"Na bai em i banisim yu","poem":1},{"text":"na ol sik nogut i no inap kisim yu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bai em i karamapim yu gut,","poem":1},{"text":"olsem kakaruk","poem":2},{"text":"i karamapim ol pikinini","poem":3},{"text":"long wing bilong en.","poem":4},{"text":"Yu ken hait gutpela tumas","poem":1},{"text":"aninit long wing bilong Bikpela,","poem":2},{"text":"na bai em i was long yu.","poem":3},{"text":"Em i no save giaman","poem":1},{"text":"long lukautim yu.","poem":2},{"text":"Olsem na yu ken i stap","poem":1},{"text":"wantaim Bikpela,","poem":3},{"text":"olsem man i hait baksait","poem":2},{"text":"long hap plang bilong pait.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Long nait yu no inap pret","poem":1},{"text":"long wanpela samting nogut.","poem":2},{"text":"Na long san yu no ken pret","poem":1},{"text":"long wanpela samting","poem":3},{"text":"i kamap kwik tumas","poem":2},{"text":"bilong bagarapim yu.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Na bai yu no inap pret","poem":1},{"text":"long bikpela sik i kamap long nait,","poem":3},{"text":"na long samting nogut","poem":2},{"text":"i kamap long biksan tu","poem":3},{"text":"na i laik bagarapim yu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sapos 1,000 man i dai","poem":1},{"text":"klostu long yu,","poem":3},{"text":"na 10,000 i dai","poem":2},{"text":"long han sut bilong yu,","poem":3},{"text":"maski, samting nogut","poem":2},{"text":"i no ken i kam klostu long yu.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Bai yu yet i lukim God","poem":1},{"text":"i bekim pasin nogut","poem":2},{"text":"ol man nogut i bin mekim.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yu save go long God","poem":1},{"text":"na hait long ol samting nogut,","poem":3},{"text":"na God Antap Tru","poem":2},{"text":"em i wasman tru bilong yu.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Olsem na samting nogut","poem":1},{"text":"i no inap kamap long yu.","poem":2},{"text":"Na bikpela sik i no inap i go klostu","poem":1},{"text":"long haus bilong yu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bikpela bai i givim wok long ol ensel","poem":1},{"text":"bilong was long yu","poem":2},{"text":"long olgeta wokabaut bilong yu.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Na bai ol i karim yu","poem":1},{"text":"long han bilong ol,","poem":3},{"text":"nogut wanpela ston","poem":2},{"text":"i sutim lek bilong yu.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Bai yu krungutim laion na snek","poem":1},{"text":"na yangpela laion","poem":2},{"text":"na bikpela snek nogut tu.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"God i tok olsem,","poem":1},{"text":"“Bai mi kisim bek","poem":2},{"text":"ol man i laikim mi tru,","poem":3},{"text":"na bai mi lukautim gut","poem":2},{"text":"ol man i save tru long mi.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Taim ol i prea long mi","poem":2},{"text":"bai mi harim prea bilong ol.","poem":3},{"text":"Na sapos hevi i kamap long ol","poem":2},{"text":"bai mi stap wantaim ol.","poem":3},{"text":"Na bai mi kisim bek ol","poem":2},{"text":"na givim biknem long ol.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Bai mi skruim laip bilong ol","poem":2},{"text":"i go longpela","poem":3},{"text":"olsem prais bilong ol.","poem":4},{"text":"Na bai mi kisim bek ol","poem":2},{"text":"na ol i stap wantaim mi.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}