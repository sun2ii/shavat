{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":93,"content":[{"type":"heading","content":["God i stap king"]},{"type":"verse","number":1,"content":[{"text":"Bikpela i stap king.","poem":1},{"text":"Em i gat biknem tru,","poem":2},{"text":"na i gat bikpela strong.","poem":3},{"text":"Em i bin mekim dispela graun","poem":1},{"text":"i stap strong olgeta","poem":2},{"text":"long ples bilong en.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Bikpela, long taim olgeta samting","poem":1},{"text":"i no kamap yet,","poem":2},{"text":"yu i stap.","poem":3},{"text":"Yu stap oltaim oltaim,","poem":1},{"text":"na yu stap king oltaim oltaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bikpela, solwara i daun tumas","poem":1},{"text":"i save pairap moa yet.","poem":2},{"text":"Em i pairap strong tumas.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Bikpela, long bikpela strong","poem":1},{"text":"bilong yu,","poem":3},{"text":"yu bosim olgeta samting","poem":2},{"text":"long heven.","poem":3},{"text":"Strong bilong pairap bilong solwara","poem":1},{"text":"em i liklik tasol.","poem":2},{"text":"Tasol strong bilong yu","poem":1},{"text":"em i bikpela tru.","poem":2},{"text":"Biksi i save bruk","poem":1},{"text":"na pairap strong long nambis,","poem":3},{"text":"tasol strong bilong biksi","poem":2},{"text":"em i no inap","poem":3},{"text":"wantaim strong bilong yu.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olgeta lo bilong yu","poem":1},{"text":"i stap oltaim oltaim.","poem":2},{"text":"Tru tumas, Bikpela,","poem":1},{"text":"haus bilong yu i stap holi oltaim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}