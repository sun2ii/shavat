{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":95,"content":[{"type":"heading","content":["Song bilong litimapim nem bilong God"]},{"type":"verse","number":1,"content":[{"text":"Yupela kam.","poem":1},{"lineBreak":true},{"text":"Yumi mekim song","poem":1},{"text":"bilong litimapim nem","poem":2},{"text":"bilong Bikpela.","poem":3},{"text":"Yumi tingting long strongpela God","poem":1},{"text":"em i kisim bek yumi,","poem":3},{"text":"na yumi singim song","poem":2},{"text":"na amamas long em.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Yumi go klostu long em","poem":1},{"text":"na tenkyu long em.","poem":2},{"text":"Yumi mekim sampela song","poem":1},{"text":"bilong amamas","poem":2},{"text":"na litimapim nem bilong em.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Long wanem, Bikpela","poem":1},{"text":"em i strongpela God.","poem":2},{"text":"Em i strongpela king","poem":1},{"text":"na em i antap","poem":2},{"text":"long olgeta giaman god.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Em i save bosim olgeta hap graun,","poem":1},{"text":"long olgeta ples i daun tumas","poem":2},{"text":"i go inap long olgeta maunten","poem":3},{"text":"i antap tru.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Em yet i wokim graun na solwara,","poem":1},{"text":"olsem na em i bosim ol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yupela kam, yumi daunim het","poem":1},{"text":"na lotu long em.","poem":2},{"text":"Bikpela i bin wokim yumi.","poem":1},{"text":"Orait yumi go klostu long em","poem":2},{"text":"na brukim skru.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Em yet i God bilong yumi.","poem":1},{"lineBreak":true},{"text":"Em yet i save lukautim","poem":1},{"text":"yumi manmeri bilong en","poem":2},{"text":"olsem ol sipsip,","poem":3},{"text":"na em i save givim kaikai","poem":2},{"text":"long yumi.","poem":3},{"text":"Nau yupela i mas harim","poem":1},{"text":"maus bilong em.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bikpela i tok,","poem":1},{"text":"“Yupela i no ken pasim strong","poem":2},{"text":"bel bilong yupela, olsem bipo","poem":3},{"text":"ol tumbuna bilong yupela i mekim","poem":2},{"text":"long Meriba na long Masa","poem":3},{"text":"long ples drai.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Ol i stap long ples drai","poem":2},{"text":"na ol i traim mi.","poem":3},{"text":"Na bihain ol i lukim","poem":2},{"text":"olgeta strongpela wok mi mekim.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mi bel nogut","poem":2},{"text":"long dispela lain manmeri","poem":3},{"text":"inap 40 yia.","poem":4},{"text":"Olsem na mi tok,","poem":2},{"text":"bel bilong ol","poem":3},{"text":"i no save bihainim mi.","poem":4},{"text":"Olgeta taim ol i save lusim rot","poem":2},{"text":"mi makim bilong ol.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Olsem na mi belhat","poem":2},{"text":"na mi tokim ol olsem,","poem":3},{"text":"‘Tru antap, yupela i no inap i go","poem":2},{"text":"insait long dispela ples","poem":3},{"text":"mi laik larim yupela i malolo long en.’”","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}