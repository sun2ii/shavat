{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":97,"content":[{"type":"heading","content":["God em i nambawan king"]},{"type":"verse","number":1,"content":[{"text":"Bikpela i stap king.","poem":1},{"text":"Graun, yu mas amamas.","poem":2},{"text":"Na ol ailan, yupela i mas belgut.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Ol klaut na tudak","poem":1},{"text":"i save karamapim em,","poem":3},{"text":"na em i bosim ol manmeri","poem":2},{"text":"long stretpela pasin.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Paia i save go paslain long em","poem":1},{"text":"na i kukim ol birua","poem":2},{"text":"i raunim em i stap.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Em i save mekim","poem":1},{"text":"lait bilong klaut i kamap","poem":2},{"text":"na mekim graun i lait.","poem":3},{"text":"Graun i lukim na i save guria.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God em i Bikpela","poem":1},{"text":"bilong olgeta graun.","poem":2},{"text":"Em i kam na ol maunten","poem":1},{"text":"i kamap olsem wara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Skai antap i save autim tok","poem":1},{"text":"long stretpela pasin bilong em,","poem":3},{"text":"na olgeta lain manmeri","poem":2},{"text":"i lukim lait bilong en.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ol manmeri i save lotu","poem":1},{"text":"long ol giaman god","poem":3},{"lineBreak":true},{"text":"na litimapim nem bilong ol,","poem":3},{"text":"ol i sem nogut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olgeta manmeri bilong Saion","poem":1},{"text":"na bilong ol taun bilong Juda,","poem":3},{"text":"ol i belgut na amamas","poem":2},{"text":"long kot bilong yu.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bikpela, yu God Antap Tru,","poem":1},{"text":"yu bosim olgeta hap graun.","poem":2},{"text":"Yu gat biknem","poem":1},{"text":"na yu winim olgeta giaman god.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bikpela i laikim tru ol manmeri","poem":1},{"text":"i no save laikim pasin nogut.","poem":2},{"text":"Em i save lukautim gut","poem":1},{"text":"ol manmeri bilong en","poem":3},{"text":"na kisim bek ol","poem":2},{"text":"long han bilong ol man nogut.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"God i save givim lait","poem":1},{"text":"long ol stretpela manmeri,","poem":3},{"text":"na i save mekim bel bilong ol","poem":2},{"text":"i amamas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Yupela stretpela manmeri,","poem":1},{"text":"yupela i ken amamas","poem":2},{"text":"long ol samting","poem":3},{"text":"Bikpela i bin mekim.","poem":4},{"text":"Tingim dispela na tenkyu long em,","poem":1},{"text":"em God bilong mekim","poem":2},{"text":"gutpela na stretpela pasin olgeta.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}