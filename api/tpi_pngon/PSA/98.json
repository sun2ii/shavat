{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"PSA","translationId":"tpi_pngon","name":"BUK SONG","commonName":"BUK SONG","title":"Buk Song bilong Lotu o Ol Sam","order":19,"numberOfChapters":150,"sha256":"f512b8ba4ad2eec83f0ca2723b5389994c541a86079057acd9cba3d76e3e00d1","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tpi_pngon/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":98,"content":[{"type":"heading","content":["God i king bilong olgeta manmeri"]},{"type":"hebrew_subtitle","content":["Dispela em i song."]},{"type":"verse","number":1,"content":[{"text":"Yumi singim nupela song","poem":1},{"text":"long Bikpela.","poem":2},{"text":"Em i bin mekim","poem":1},{"text":"ol kain kain gutpela samting.","poem":2},{"text":"Long bikpela strong na pasin holi","poem":1},{"text":"bilong em tasol,","poem":3},{"text":"em i bin winim pait.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bikpela i tokaut pinis","poem":1},{"text":"long em i bin winim pait,","poem":3},{"text":"na taim em i kisim bek ol Israel","poem":2},{"text":"em i soim strong bilong en","poem":3},{"text":"long ol lain manmeri.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Em i tingting yet","poem":1},{"text":"long promis bilong en","poem":3},{"text":"na em i sori long ol Israel","poem":2},{"text":"na i no lusim ol.","poem":3},{"text":"Olgeta manmeri bilong olgeta ples","poem":1},{"text":"i lukim pinis","poem":2},{"text":"God bilong yumi i winim pait","poem":3},{"text":"na i kisim bek yumi.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yupela ol manmeri bilong graun,","poem":1},{"text":"singsing na amamas long Bikpela.","poem":2},{"text":"Kirapim ol song bilong belgut","poem":1},{"text":"na litimapim nem bilong en.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Paitim gita na singim ol song","poem":1},{"text":"bilong litimapim","poem":2},{"text":"nem bilong Bikpela.","poem":3},{"text":"Mekim gutpela musik tru long gita.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Winim biugel na mambu","poem":1},{"text":"na singaut na amamas","poem":2},{"text":"long Bikpela, em i king.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na solwara, yu","poem":1},{"text":"wantaim olgeta pis samting","poem":2},{"text":"i stap long yu,","poem":3},{"text":"yupela singaut strong.","poem":2},{"text":"Na graun, yu","poem":1},{"text":"wantaim olgeta manmeri samting,","poem":2},{"text":"yupela i mas singim song.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Yupela ol bikpela solwara,","poem":1},{"text":"yupela i mas paitim han.","poem":2},{"text":"Yupela ol maunten, yupela","poem":1},{"text":"i mas singim song bilong amamas","poem":2},{"text":"long ai bilong Bikpela.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Long wanem, em i kam","poem":1},{"text":"bilong bosim olgeta hap graun.","poem":2},{"text":"Na em bai i stap king","poem":1},{"text":"na bosim olgeta manmeri","poem":2},{"text":"long stretpela pasin oltaim.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}