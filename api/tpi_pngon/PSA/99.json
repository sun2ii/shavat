ekim","poem":2},{"text":"gutpela na stretpela pasin olgeta.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}