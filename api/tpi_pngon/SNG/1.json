{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"SNG","translationId":"tpi_pngon","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"efd15a019d5ee1b9c8ffc1406fe72403b6de856ce5ec98b36166c9780e97df59","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_pngon/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Dispela song em i gutpela song na i winim olgeta song. Solomon yet i bin raitim dispela song.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Planti taim yu save kis long mi","poem":1},{"text":"na mi laik bai yu mekim olsem","poem":2},{"text":"moa yet.","poem":3},{"text":"Yu laikim mi na yu dai tru long mi.","poem":1},{"lineBreak":true},{"text":"Dispela i namba wan samting","poem":1},{"text":"na i winim swit bilong gutpela wain.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Skin bilong yu i gat gutpela smel.","poem":1},{"text":"Mi harim nem bilong yu","poem":2},{"text":"na mi amamas,","poem":3},{"text":"olsem mi save amamas","poem":2},{"text":"long gutpela sanda.","poem":3},{"text":"Ol meri i save laikim yu tumas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yu kisim mi na yumi ranawe i go.","poem":1},{"lineBreak":true},{"text":"Yu olsem king bilong mi,","poem":1},{"text":"na yu kisim mi i go","poem":2},{"text":"long rum bilong yu.","poem":3},{"text":"Bai yumi amamas wantaim.","poem":1},{"lineBreak":true},{"text":"Yu save laikim mi tumas,","poem":1},{"text":"olsem na yumi amamas tru.","poem":2},{"text":"Amamas bilong yumi i winim amamas","poem":1},{"text":"bilong ol man i laikim wain.","poem":2},{"text":"Yu moa yet.","poem":1},{"text":"Olsem na olgeta meri","poem":2},{"text":"i pundaun tru long yu.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Yupela ol meri bilong Jerusalem,","poem":1},{"text":"harim.","poem":2},{"text":"Skin bilong mi i blak,","poem":1},{"text":"tasol mi naispela tumas.","poem":2},{"text":"Skin bilong mi i blak","poem":1},{"text":"olsem ol haus sel bilong ol Kedar","poem":2},{"text":"long ples drai.","poem":3},{"text":"Tasol mi naispela tumas","poem":1},{"text":"olsem ol naispela laplap","poem":2},{"text":"i hangamap i stap","poem":3},{"text":"long haus bilong King Solomon.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Tru, skin bilong mi i blak,","poem":1},{"text":"tasol yupela i no ken ting","poem":2},{"text":"mi olsem wokmeri nating.","poem":3},{"text":"San i kukim mi","poem":1},{"text":"na skin i kamap olsem.","poem":2},{"text":"Ol brata bilong mi i bin kros long mi","poem":1},{"text":"na mekim mi i go","poem":2},{"text":"lukautim ol gaden wain.","poem":3},{"text":"Olsem na mi no inap lukautim gut","poem":1},{"text":"skin bilong mi yet.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu gutpela pren, mi laikim yu tumas.","poem":1},{"text":"Bai yu bringim ol meme bilong yu","poem":2},{"text":"i go we?","poem":3},{"text":"Bai ol i go long wanem hap","poem":1},{"text":"bilong painim gutpela gras","poem":2},{"text":"bilong kaikai?","poem":3},{"text":"Na long biksan bai ol i go hait we?","poem":2},{"text":"Yu tokim mi","poem":1},{"text":"na bai mi no ken hatwok","poem":2},{"text":"long painim yu.","poem":3},{"text":"Sapos yu no tokim mi","poem":1},{"text":"bai mi mas kisim laplap","poem":2},{"text":"na karamapim pes bilong mi","poem":3},{"text":"na painim yu namel long ol meme","poem":2},{"text":"bilong ol arapela wasman.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Pren bilong mi, yu naispela meri tru.","poem":1},{"lineBreak":true},{"text":"Sapos yu laik lukim mi,","poem":1},{"text":"orait yu bihainim mak bilong lek","poem":2},{"text":"bilong ol meme.","poem":3},{"text":"Yu bihainim i go","poem":1},{"text":"na bai yu lukim gutpela gras","poem":2},{"text":"bilong ol meme bilong yu","poem":3},{"text":"i ken kaikai.","poem":4},{"text":"Dispela gras i stap","poem":1},{"text":"klostu long ol haus sel","poem":2},{"text":"bilong ol wasman bilong sipsip.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"O yu naispela pren bilong mi,","poem":1},{"text":"bilas bilong yu i gutpela,","poem":3},{"text":"olsem bilas bilong ol hos","poem":2},{"text":"i pulim karis","poem":3},{"text":"bilong king bilong Isip.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Ol bilas i hangamap","poem":1},{"text":"long gras bilong yu","poem":2},{"text":"i mekim pes bilong yu i lait.","poem":3},{"text":"Na yu putim ol gutpela bis long nek","poem":1},{"text":"na nek bilong yu i lait tru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tasol bai mipela i wokim","poem":1},{"text":"sampela bilas gol","poem":2},{"lineBreak":true},{"text":"na ol arapela bilas silva,","poem":2},{"text":"na bai mipela i givim yu.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"King bilong mi i slip","poem":1},{"text":"long bet bilong en,","poem":3},{"text":"na em i smelim gutpela sanda","poem":2},{"text":"mi bilas long en.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Pren bilong mi, mi laikim tumas,","poem":1},{"text":"em i olsem wanpela mekpas paura","poem":2},{"text":"i gat gutpela smel","poem":3},{"text":"na i slip long bros bilong mi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Na em i olsem ol plaua","poem":1},{"text":"i gat gutpela smel","poem":3},{"text":"na i save kamap long ol gaden wain","poem":2},{"text":"bilong Engedi.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Yu naispela meri tru","poem":1},{"text":"na mi laikim yu tumas.","poem":2},{"text":"Na yu tu yu laikim mi","poem":1},{"text":"olsem na ai bilong yu i lait.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pren bilong mi, yu gutpela tumas.","poem":1},{"lineBreak":true},{"text":"Yu moa yet","poem":1},{"text":"na mi amamas tru long yu.","poem":2},{"text":"Dispela gutpela gras","poem":1},{"text":"i olsem bet bilong yumi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dispela ol han bilong ol diwai sida","poem":1},{"text":"i olsem pilo na sapnil","poem":2},{"text":"bilong haus bilong yumi.","poem":3},{"text":"Na ol diwai pain i olsem rup","poem":1},{"text":"bilong dispela haus.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}