{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"SNG","translationId":"tpi_pngon","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"efd15a019d5ee1b9c8ffc1406fe72403b6de856ce5ec98b36166c9780e97df59","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_pngon/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Tasol mi olsem wanpela plaua","poem":1},{"text":"bilong bus","poem":3},{"text":"i kamap long ples stret","poem":2},{"text":"bilong Saron.","poem":3},{"text":"Na mi olsem naispela plaua","poem":1},{"text":"i stap long ples daun","poem":2},{"text":"namel long ol maunten.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Pren bilong mi i stap namel","poem":1},{"text":"long ol arapela meri","poem":3},{"text":"olsem plaua i stap namel","poem":2},{"text":"long ol gras i gat nil.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Pren bilong mi i stap namel","poem":1},{"text":"long ol arapela man","poem":3},{"text":"olsem wanpela diwai","poem":2},{"text":"i gat gutpela kaikai","poem":3},{"text":"i stap namel long ol arapela diwai","poem":2},{"text":"long bus.","poem":3},{"text":"Long taim bilong biksan","poem":1},{"text":"mi laikim tumas long sindaun","poem":2},{"text":"long as bilong dispela diwai.","poem":3},{"text":"Pikinini bilong dispela diwai","poem":1},{"text":"i gutpela tumas","poem":2},{"text":"na i swit tru long maus bilong mi.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Em i kisim mi i go long bikpela kaikai","poem":1},{"text":"long bikpela haus bilong en.","poem":2},{"text":"Em i laikim mi tumas","poem":1},{"text":"na mi amamas long em","poem":3},{"text":"olsem mi amamas","poem":2},{"text":"long gutpela laplap","poem":3},{"text":"i bilasim haus kaikai.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Pren bilong mi, mi laikim yu tumas,","poem":1},{"text":"na bun bilong mi i slek.","poem":2},{"text":"Plis, yupela i mas givim mi","poem":1},{"text":"ol pikinini bilong diwai,","poem":2},{"lineBreak":true},{"text":"na ol pikinini bilong wain","poem":2},{"text":"ol i bin mekim drai.","poem":3},{"text":"Na bai mi kaikai na kisim strong.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pren bilong mi i putim","poem":1},{"text":"han kais bilong en","poem":2},{"text":"aninit long het bilong mi.","poem":3},{"text":"Na long han sut bilong en,","poem":1},{"text":"em i holim bodi bilong mi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ol meri bilong Jerusalem,","poem":1},{"text":"yupela i mas ting","poem":2},{"text":"long ol gutpela wel abus","poem":3},{"text":"na mekim strongpela promis","poem":2},{"text":"long mi,","poem":3},{"text":"bai yupela i no ken kirapim bel","poem":2},{"text":"bilong mitupela.","poem":3},{"text":"Dispela i samting bilong mitupela yet.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Pren bilong mi i kam long mi.","poem":1},{"lineBreak":true},{"text":"Em i kalap kalap na i ran i kam","poem":1},{"text":"antap long ol maunten","poem":3},{"text":"na mi harim nek bilong en.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Em i spit tumas","poem":1},{"text":"olsem wanpela strongpela wel abus.","poem":2},{"text":"Em i kam pinis","poem":1},{"text":"na sanap ausait long haus,","poem":2},{"text":"na i lukluk i kam insait long windo.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Na em i toktok long mi.","poem":1},"Yangpela man i singim song olsem",{"text":"Naispela pren bilong mi,","poem":1},{"text":"yu kam ausait,","poem":2},{"text":"na yu kam wantaim mi.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Yu no ken pret long ren.","poem":1},{"text":"Taim bilong ren i pinis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nau ol plaua i kamap pinis","poem":1},{"text":"long olgeta hap,","poem":3},{"text":"na em i taim bilong singsing.","poem":2},{"text":"Ol pisin i wok long singsing","poem":1},{"text":"nabaut long bus.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ol diwai fik i stat long karim kaikai.","poem":1},{"text":"Na olgeta rop bilong bus","poem":2},{"text":"i putim plaua,","poem":3},{"text":"na ol plaua i gat gutpela smel.","poem":2},{"text":"Naispela pren bilong mi,","poem":1},{"text":"yu kam ausait,","poem":2},{"text":"na yu kam wantaim mi.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Yu stap insait long haus bilong yu","poem":1},{"text":"olsem pisin i save hait","poem":2},{"text":"insait long liklik hul","poem":3},{"text":"long ples nogut bilong maunten.","poem":4},{"text":"Kam ausait na mi lukim","poem":1},{"text":"naispela pes bilong yu","poem":3},{"text":"na mi harim gutpela nek bilong yu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Holimpas dispela ol liklik weldok.","poem":1},{"lineBreak":true},{"text":"Nogut ol i kam insait","poem":1},{"text":"long gaden bilong yumi","poem":3},{"text":"na bagarapim ol plaua","poem":2},{"text":"bilong diwai wain.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Dispela pren em i man bilong mi","poem":1},{"text":"na mi meri bilong em.","poem":2},{"text":"Em i kisim ol meme bilong en","poem":1},{"text":"i go namel long ol naispela plaua","poem":2},{"text":"na ol i wok long kaikai gras.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Bai em i was long ol","poem":1},{"text":"i go inap long san i go daun","poem":2},{"text":"na ples i kol.","poem":3},{"text":"Gutpela pren bilong mi,","poem":1},{"text":"mi laik yu kam bek kwik","poem":3},{"text":"olsem wanpela gutpela wel abus","poem":2},{"text":"i ran i kam","poem":3},{"text":"antap long ol bikpela maunten.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}