{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"SNG","translationId":"tpi_pngon","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"efd15a019d5ee1b9c8ffc1406fe72403b6de856ce5ec98b36166c9780e97df59","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_pngon/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Meri bilong mi,","poem":1},{"text":"yu lewa tru bilong mi,","poem":3},{"text":"mi kam pinis long gaden bilong mi.","poem":2},{"text":"Na mi bungim ol samting","poem":1},{"text":"i gat gutpela smel.","poem":2},{"text":"Mi kaikai gutpela hani.","poem":1},{"text":"Na mi dring susu na wain bilong mi.","poem":2},"Ol meri i singim song olsem",{"text":"Yutupela gutpela pren tru,","poem":1},{"text":"yutupela kaikai na dring","poem":2},{"text":"inap yutupela i pulap tru.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Long nait mi slip i stap","poem":1},{"text":"tasol mi wok long tingting yet.","poem":2},{"text":"Na mi driman","poem":1},{"text":"na mi lukim man bilong mi","poem":2},{"text":"i paitim dua bilong haus bilong mi.","poem":3},"Yangpela man i singim song olsem",{"text":"Meri bilong mi na lewa tru bilong mi,","poem":1},{"text":"yu opim dua","poem":2},{"text":"na larim mi i kam insait.","poem":3},{"text":"Wara bilong nait i kam daun","poem":1},{"text":"na wasim het bilong mi.","poem":2},{"text":"Na wara i pulap long gras bilong mi.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mi rausim pinis klos bilong mi,","poem":1},{"text":"na mi les long putim klos gen.","poem":2},{"text":"Mi wasim pinis lek bilong mi","poem":1},{"text":"na mi les long kirap wokabaut","poem":2},{"text":"na mekim lek i doti gen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Tasol mi harim pren bilong mi","poem":1},{"text":"i holim handel bilong dua,","poem":3},{"text":"na bel bilong mi i kirap","poem":2},{"text":"na mi amamas.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mi kirap bilong opim dua.","poem":1},{"lineBreak":true},{"text":"Mi putim han long handel bilong dua","poem":1},{"text":"na sanda i stap long han bilong mi","poem":2},{"text":"i pas long handel bilong dua.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mi opim dua long pren bilong mi.","poem":1},{"text":"Tasol em i go pinis","poem":2},{"text":"na mi no lukim em.","poem":3},{"text":"Mi tingim toktok bilong en","poem":1},{"text":"na bel bilong mi i nogut tru.","poem":2},{"text":"Na mi wok long painim em,","poem":1},{"text":"tasol mi no lukim em.","poem":2},{"text":"Mi singautim em","poem":1},{"text":"tasol em i no bekim","poem":2},{"text":"singaut bilong mi.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ol wasman bilong banis bilong taun","poem":1},{"text":"i lukim mi.","poem":3},{"text":"Na ol i paitim mi","poem":1},{"text":"na bagarapim skin bilong mi,","poem":2},{"text":"na ol i kisim saket bilong mi.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ol meri bilong Jerusalem,","poem":1},{"text":"sapos yupela i lukim pren","poem":2},{"text":"bilong mi,","poem":3},{"text":"yupela i mas promis","poem":2},{"text":"long tokim em olsem,","poem":3},{"text":"mi laikim em tumas","poem":2},{"text":"na bun bilong mi i slek.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Yu naispela meri","poem":1},{"text":"na yu winim olgeta meri.","poem":2},{"text":"Dispela man bilong yu","poem":1},{"text":"em i wanem kain man?","poem":3},{"text":"Ating em i winim man","poem":1},{"text":"bilong mipela ol arapela meri","poem":3},{"text":"na yu laik bai mipela","poem":2},{"text":"i mekim promis olsem?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Pren bilong mi em i strongpela man","poem":1},{"text":"na pes bilong en i naispela tru,","poem":2},{"text":"na i winim pes","poem":3},{"text":"bilong planti tausen man.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Pes bilong en i lait olsem gol.","poem":2},{"text":"Gras bilong en i gutpela tumas","poem":1},{"text":"na i blakpela tru","poem":2},{"text":"olsem gras bilong blakpela pisin.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ai bilong en i lait tumas","poem":1},{"text":"olsem gras bilong pisin","poem":2},{"text":"i waswas pinis","poem":3},{"text":"na i sanap arere long wara.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Gras long wasket bilong en i gutpela","poem":1},{"text":"olsem gaden i pulap","poem":2},{"text":"long ol samting i gat gutpela smel.","poem":3},{"text":"Maus bilong en","poem":1},{"text":"i olsem naispela plaua.","poem":2},{"text":"Toktok bilong en i gutpela tumas","poem":1},{"text":"olsem sanda i gat gutpela smel.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han bilong en i gutpela tumas.","poem":1},{"text":"Na em i putim ol ring i dia tumas","poem":2},{"text":"long bilasim pinga bilong en.","poem":3},{"text":"Bodi bilong en i waitpela tru","poem":1},{"text":"na i lait moa yet.","poem":2},{"text":"Na let bilong en ol i bilasim","poem":1},{"text":"long ol blupela ston i dia tumas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lek bilong en i olsem tupela pos","poem":1},{"text":"ol i wokim","poem":2},{"text":"long gutpela waitpela ston,","poem":3},{"text":"na i sanap long tupela hap gol","poem":2},{"text":"i lait tumas.","poem":3},{"text":"Em i nambawan tru","poem":1},{"text":"olsem ol gutpela diwai sida","poem":2},{"lineBreak":true},{"text":"na olsem ol bikpela maunten","poem":2},{"text":"bilong Lebanon.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Taim em i kis long mi,","poem":1},{"text":"mi pilim em i swit moa.","poem":2},{"text":"Olgeta hap bodi bilong en","poem":1},{"text":"i gutpela tumas.","poem":2},{"text":"Yupela ol meri bilong Jerusalem,","poem":1},{"text":"man bilong mi","poem":2},{"text":"em i kain man olsem.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}