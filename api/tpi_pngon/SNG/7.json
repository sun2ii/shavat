{"translation":{"id":"tpi_pngon","name":"Buk Baibel long Tok Pisin","website":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tpiOTNT","licenseNotes":null,"shortName":"PNGON","englishName":"Tok Pisin Bible","language":"tpi","textDirection":"ltr","sha256":"dd871fd67285d0d4ac050f6dd4824ab44a8c626cfd4b38f49fc61c53007efaf5","availableFormats":["json"],"listOfBooksApiLink":"/api/tpi_pngon/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30362,"languageName":"Tok Pisin","languageEnglishName":"Tok Pisin"},"book":{"id":"SNG","translationId":"tpi_pngon","name":"SOLOMON","commonName":"SOLOMON","title":"Song bilong Solomon","order":22,"numberOfChapters":8,"sha256":"efd15a019d5ee1b9c8ffc1406fe72403b6de856ce5ec98b36166c9780e97df59","firstChapterNumber":1,"firstChapterApiLink":"/api/tpi_pngon/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tpi_pngon/SNG/8.json","totalNumberOfVerses":116},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Pren bilong mi, yu nambawan tru","poem":1},{"text":"olsem wanpela kwin.","poem":2},{"text":"Yu putim su,","poem":1},{"text":"na lek bilong yu i smat moa.","poem":2},{"text":"Lek bilong yu i naispela tru,","poem":1},{"text":"olsem wanpela piksa","poem":2},{"text":"saveman i bin katim long ston.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Namel bilong bel bilong yu","poem":1},{"text":"i olsem kap","poem":2},{"text":"i pulap long wain ol i bin tanim","poem":3},{"text":"wantaim switpela paura.","poem":4},{"text":"Bel bilong yu i naispela tru","poem":1},{"text":"olsem wanpela hip bilong wit","poem":2},{"text":"ol i bilasim long ol naispela plaua.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Tupela susu bilong yu","poem":1},{"text":"i olsem tupela gutpela wel abus.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nek bilong yu","poem":1},{"text":"i olsem wanpela waitpela taua.","poem":2},{"text":"Ai bilong yu i olsem liklik raunwara","poem":1},{"text":"klostu long dua","poem":2},{"text":"bilong bikpela taun Hesbon.","poem":3},{"text":"Nus bilong yu i gutpela tumas","poem":1},{"text":"olsem taua bilong ol wasman","poem":2},{"text":"bilong Lebanon","poem":3},{"text":"we ol i save was","poem":2},{"text":"long hap bilong Damaskus.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Het bilong yu i antap moa","poem":1},{"text":"olsem het bilong maunten Karmel.","poem":2},{"text":"Gras bilong yu i lait","poem":1},{"text":"olsem naispela laplap bilong king.","poem":2},{"text":"Na dispela gras inap long mekim king","poem":1},{"text":"i pundaun tru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pren bilong mi, yu naispela meri tru.","poem":1},{"lineBreak":true},{"text":"Mi laikim yu tumas","poem":1},{"text":"na olgeta samting bilong yu","poem":2},{"text":"i save mekim mi i amamas.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Yu gutpela tumas","poem":1},{"text":"olsem stretpela kokonas.","poem":2},{"text":"Na susu bilong yu","poem":1},{"text":"i olsem kaikai bilong en.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bai mi go antap long dispela kokonas","poem":1},{"text":"na kisim kaikai bilong en.","poem":2},{"text":"Mi lukim susu bilong yu","poem":1},{"text":"i olsem han bilong diwai wain","poem":2},{"text":"i gat planti kaikai.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Mi smelim maus bilong yu","poem":1},{"text":"olsem gutpela smel bilong laulau.","poem":2},{"text":"Yu kis long mi na i swit moa","poem":1},{"text":"olsem wain.","poem":2},"Yangpela meri i singim song olsem",{"text":"Pren bilong mi,","poem":1},{"text":"bai mi givim yu dispela wain.","poem":2},{"text":"Na long taim bilong slip tu","poem":1},{"text":"dispela kain wain i gutpela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mi bilong pren bilong mi","poem":1},{"text":"na em i laikim mi tumas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pren bilong mi, yu kam wantaim mi.","poem":1},{"text":"Na yumi go i stap long ol liklik ples.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Long moningtaim tru","poem":1},{"text":"bai yumi kirap i go","poem":2},{"text":"na lukim ol diwai wain.","poem":3},{"text":"Ating kru bilong ol i kamap","poem":1},{"text":"na plaua bilong ol i op, o nogat?","poem":2},{"text":"Na yumi lukim ol diwai","poem":1},{"text":"bilong karim gutpela kaikai.","poem":3},{"text":"Plaua bilong ol i op, o nogat?","poem":2},{"text":"Bai yumi stap long dispela gaden wain","poem":1},{"text":"na bai mi soim yu olsem,","poem":2},{"text":"mi laikim yu tru.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Pren bilong mi, mi bin kisim","poem":1},{"text":"ol gutpela gutpela","poem":2},{"text":"pikinini bilong diwai","poem":3},{"text":"na putim i stap klostu long dua,","poem":2},{"text":"bilong yu ken kaikai.","poem":3},{"text":"Sampela mi bin kisim bipo","poem":1},{"text":"na sampela nau tasol mi kisim.","poem":2},{"text":"Na yumi smelim ol gutpela rop","poem":1},{"text":"bilong kirapim laik bilong yumi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tpi_pngon/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tpi_pngon/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tpi_pngon/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}