{"translation":{"id":"tte_owb","name":"Buki Tabu Beyabeyana","website":"https://ebible.org/Scriptures/details.php?id=tteo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tteo","licenseNotes":null,"shortName":"OWB","englishName":"Bwanabwana OT","language":"tte","textDirection":"ltr","sha256":"f2218f845b694e79d9be57f9c92f8a3ed3aed5ba5db67d3f2ceac397a586aa29","availableFormats":["json"],"listOfBooksApiLink":"/api/tte_owb/books.json","numberOfBooks":13,"totalNumberOfChapters":344,"totalNumberOfVerses":7095,"languageName":"Bwanabwana","languageEnglishName":"Bwanabwana"},"book":{"id":"PSA","translationId":"tte_owb","name":"Same","commonName":"Same","title":"Same","order":19,"numberOfChapters":150,"sha256":"e3474c5b0cca7ddb69d6bcccdd4bceae0ed0fee606024661878c800a9d5363e2","firstChapterNumber":1,"firstChapterApiLink":"/api/tte_owb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tte_owb/PSA/150.json","totalNumberOfVerses":2427},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["O Yeoba ama Guyau, esam inamwanamwasosi yanuwa yaulina meuloina koina.",{"lineBreak":true},"Kam tobali isae bulibuli ikabitonan."]},{"type":"verse","number":2,"content":["Siya melumeluwo lalakili yo kikiuli kam tobali siwaliyan. Kam tokalomagigiliwo kupei-suwalagili koliwo yo kam kaleyayao kuyamwanouli."]},{"type":"line_break"},{"type":"verse","number":3,"content":["Saugana bulibuli yagitai, nimam ali paisowa, waikena yo utu, kupeili ali kaba miya mena kabo yawaloba,"]},{"type":"verse","number":4,"content":["“O Yaubada, tawae tomo, mwa kaiweli kunuwanuwatu? Tawae kaiwena tomo molosi ugite-kalatan yo kunuwanuwatu kaiwena?"]},{"type":"verse","number":5,"content":["Tomo molosine kupei-yatalu tupwana kana mwayaga iyai anelose yaulili mena yo yakasisi yo wasawasa kuwolena koina."]},{"type":"verse","number":6,"content":["Yo kupei ginauli meuloina iloinayan."]},{"type":"verse","number":7,"content":["Sipi yo bulumakau meuloili, yakayakan sokasokali,"]},{"type":"verse","number":8,"content":["man sievaeva-keikeile yo iye kalita mena yo yamayamayale kalita mena simiyamiya.”"]},{"type":"line_break"},{"type":"verse","number":9,"content":["O Yeoba, ama Guyau, esam inamwanamwasosi yanuwa yaulina meuloina koina."]}],"footnotes":[]},"thisChapterLink":"/api/tte_owb/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tte_owb/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tte_owb/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}