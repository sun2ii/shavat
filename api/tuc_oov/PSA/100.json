{"translation":{"id":"tuc_oov","name":"Maaron Saveeŋ Toni Patabuaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseNotes":null,"shortName":"OOV","englishName":"Saveeng Oov Bible","language":"tuc","textDirection":"ltr","sha256":"32c8abbe0b616af19faa6b0b859ea502de0d13ce6e1a8ff1c3a734ddcb18c848","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_oov/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12310,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_oov","name":"Mbouŋ to Yes Israela","commonName":"Mbouŋ to Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"8efb348e9e703157ab6290a9fc4ecb7780773ef69c0ef2cba3cfd7b9d13e77e0","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_oov/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_oov/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":100,"content":[{"type":"heading","content":["Lolood poia pa Maaron ve tapaiti"]},{"type":"verse","number":1,"content":[{"text":"Yam tamtoghon to aneep irau taan isob, tinimim iza pa Yoova, ve alool ve apaiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lolomim poia ve ambesmbees pani.","poem":1},{"text":"Anim alup gham ila nagho, ve ambou pani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lolomim imaagh pa Yoova malep. Aghilaala aghaze: Ye moghon to Maaron tau.","poem":1},{"text":"Ye to ighur ghiit, ve iit tamtoghon toni.","poem":2},{"lineBreak":true},{"text":"Iit sipsip toni. Tauto mata pait, ve iŋginŋgin ghiit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lolomim poia pani, ve ataghon ataam to Rumai Tiina, ve alooŋ ala.","poem":1},{"text":"Apaiti ve alooŋ ala sirsiir toni lolo.","poem":2},{"lineBreak":true},{"text":"Lolomim poia pani, ve apait iza pa poia toni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pasa, Yoova ŋgar toni, nene poia moghon.","poem":1},{"text":"Lolo ineep tuŋia ila to tamtoghon toni, ve iuluul di irau sawa isob.","poem":2},{"lineBreak":true},{"text":"Pale itaghon saveeŋ mbuaaŋ toni, itaghoni taghoni gha ila.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_oov/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_oov/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_oov/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}