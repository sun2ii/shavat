{"translation":{"id":"tuc_oov","name":"Maaron Saveeŋ Toni Patabuaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseNotes":null,"shortName":"OOV","englishName":"Saveeng Oov Bible","language":"tuc","textDirection":"ltr","sha256":"32c8abbe0b616af19faa6b0b859ea502de0d13ce6e1a8ff1c3a734ddcb18c848","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_oov/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12310,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_oov","name":"Mbouŋ to Yes Israela","commonName":"Mbouŋ to Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"8efb348e9e703157ab6290a9fc4ecb7780773ef69c0ef2cba3cfd7b9d13e77e0","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_oov/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_oov/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":117,"content":[{"type":"heading","content":["Ndug ndug pale tipait Maaron iza"]},{"type":"verse","number":1,"content":[{"text":"Yam tamtoghon to ndug ndug, apait Yoova!","poem":1},{"text":"Yam to aneep irau taan, asob andae iza ve apakuri. Ro 15:11","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pasa, poia toni, nene tiina le tiina kat.","poem":1},{"text":"Ye lolo ineep tuŋia ila to tamtoghon toni, ve iuluul di irau sawa isob.","poem":2},{"lineBreak":true},{"text":"Ve ŋgar to taghoniiŋ saveeŋ mbuaaŋ toni paam, inepneep tovene, itaghoni taghoni gha ila.","poem":2},{"lineBreak":true},{"text":"Aleluia, tapait Yoova!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_oov/PSA/117.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_oov/PSA/118.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_oov/PSA/116.json","previousChapterAudioLinks":{},"numberOfVerses":2}