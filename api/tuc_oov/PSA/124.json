{"translation":{"id":"tuc_oov","name":"Maaron Saveeŋ Toni Patabuaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseNotes":null,"shortName":"OOV","englishName":"Saveeng Oov Bible","language":"tuc","textDirection":"ltr","sha256":"32c8abbe0b616af19faa6b0b859ea502de0d13ce6e1a8ff1c3a734ddcb18c848","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_oov/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12310,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_oov","name":"Mbouŋ to Yes Israela","commonName":"Mbouŋ to Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"8efb348e9e703157ab6290a9fc4ecb7780773ef69c0ef2cba3cfd7b9d13e77e0","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_oov/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_oov/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":124,"content":[{"type":"heading","content":["Tapait Maaron pa ulaaŋ toni"]},{"type":"verse","number":1,"content":[{"text":"“Inimale Yoova ivool toit maau, tone tagham samia.”","poem":1},{"text":"Yam ival tiina to Israel irau asaav tovene:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Sawa to koiaad tipamundigin malmal pait,","poem":1},{"text":"inimale Yoova ivool toit maau, tone tipasob ghiit.","poem":2},{"lineBreak":true},{"text":"Pasa, atedi yabyab pait kat. Mbo 94:17; Ro 8:31","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pataŋani tonowen, nene inimale yawaaŋa ivot toman tapiri, ve izugua ghiit tala, ve mbeluuta ililiit ghiit.","poem":1},{"text":"Ve nene inimale lulu ilooŋ, ve iweu ghiit tala ve taghun te.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eemoghon Yoova ipul ghiit tala koiaad nimadi ve tiwaghamun ghiit maau.","poem":1},{"text":"Tovenen tapaiti pa poia toni!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sawa tonenen, iit tanimale man to liis ighami.","poem":1},{"text":"Eemoghon Yoova ipas ghiit tavot pa liis tonowen, ve taghau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yoova to ighur sambam ve taan.","poem":1},{"text":"Ye moghon to Ulaaŋa toit. Mbnp 1:1; Mbo 121:2","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_oov/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_oov/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_oov/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":6}