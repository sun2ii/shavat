{"translation":{"id":"tuc_oov","name":"Maaron Saveeŋ Toni Patabuaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseNotes":null,"shortName":"OOV","englishName":"Saveeng Oov Bible","language":"tuc","textDirection":"ltr","sha256":"32c8abbe0b616af19faa6b0b859ea502de0d13ce6e1a8ff1c3a734ddcb18c848","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_oov/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12310,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_oov","name":"Mbouŋ to Yes Israela","commonName":"Mbouŋ to Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"8efb348e9e703157ab6290a9fc4ecb7780773ef69c0ef2cba3cfd7b9d13e77e0","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_oov/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_oov/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":131,"content":[{"type":"heading","content":["Suŋuuŋ to tamtoghon to inumeer Maaron"]},{"type":"verse","number":1,"content":[{"text":"O Yoova, ŋgar pakuruuŋ eta ineep ila lolog maau,","poem":1},{"text":"ve matag izi pa nditag maau.","poem":2},{"lineBreak":true},{"text":"Ve nazuaria ghou pa nanim tiina maau.","poem":2},{"lineBreak":true},{"text":"Tovenen ŋgar ve uraat tintina to narau di maau, nazeev taug padi maau. Ro 12:16; 1Pe 5:5","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"You naghilaal Maaron. Tauto lolog imbumbu maau. Lolog poia ve ateg izi, nanimale pain kainaŋen to tina imbaada le lolo poia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O yam Israela, anumeer Yoova, ve aghur matamim pani pa ulaaŋ. To aazne, ve itaghoni taghoni gha ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_oov/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_oov/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_oov/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}