{"translation":{"id":"tuc_oov","name":"Maaron Saveeŋ Toni Patabuaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-o","licenseNotes":null,"shortName":"OOV","englishName":"Saveeng Oov Bible","language":"tuc","textDirection":"ltr","sha256":"32c8abbe0b616af19faa6b0b859ea502de0d13ce6e1a8ff1c3a734ddcb18c848","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_oov/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12310,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_oov","name":"Mbouŋ to Yes Israela","commonName":"Mbouŋ to Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"8efb348e9e703157ab6290a9fc4ecb7780773ef69c0ef2cba3cfd7b9d13e77e0","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_oov/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_oov/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":150,"content":[{"type":"heading","content":["Mbeb tisob tipait Maaron"]},{"type":"verse","number":1,"content":[{"text":"Aleluia, tapait Yoova!","poem":1},{"text":"Apait Maaron ila rumai toni patabuaŋ lolo!","poem":2},{"lineBreak":true},{"text":"Apaiti ila ina ariaŋa to sambam we!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apaiti pa uraat ariaŋadi to ye ighamgham di.","poem":1},{"text":"Apaiti pasa, ye iza tiina ilib pa mbeb tisob.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Avib tavuur ve apaiti.","poem":1},{"text":"Apambar ambam ve arab gita, ve apaiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Atok kakaap ve ator, ve apaiti.","poem":1},{"text":"Avib sab ve arab kulele, ve apaiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aŋgal ŋgiraam, ve apaiti.","poem":1},{"text":"Ve ighaze aŋgali, ghoro aŋgali tapirimim, leso avolutu tiina!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yam mbeb to aneep matamim iyaryaar, asob apait Yoova!","poem":1},{"text":"Aleluia, tapait Yoova! Syg 5:13","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_oov/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_oov/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_oov/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}