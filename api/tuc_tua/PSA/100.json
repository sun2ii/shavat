{"translation":{"id":"tuc_tua","name":"Maaron Saveeŋ Tooni Patabuyaaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseNotes":null,"shortName":"TUA","englishName":"Saveeng Tuam Bible","language":"tuc","textDirection":"ltr","sha256":"fcddb0db8bdd9fd527e23237bf9afe29658d49be250fa63887deddae1eaee7f1","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_tua/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12313,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_tua","name":"Mbouŋ To Yes Israela","commonName":"Mbouŋ To Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"380974fa59c5aa4cb3764e10be548fb94359fbe2962ef9058633848f55b59fb9","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_tua/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_tua/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":100,"content":[{"type":"heading","content":["Loloon poia pa Maaron ve tapaiti"]},{"type":"hebrew_subtitle","content":["Mbouŋ to tapait Maaron pa poia tooni"]},{"type":"verse","number":1,"content":[{"text":"Yam tamtamon to aleep irau taan isov, tintinmim pa Yoova, ve apaiti toman aliŋamim tiina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abesbees pani toman lolomim poia.","poem":1},{"text":"Alam alup gham ila i naagho, ve amboumbou pani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lolomim iveegh pa Yoova sov. Aghilaal aghe: I mon ta Maaron tauu.","poem":1},{"text":"I ta ighur ghiit, ve iit tamtamon tooni.","poem":2},{"lineBreak":true},{"text":"Iit sipsip tooni. Tauta maata pait ve iŋginŋgin ghiit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lolomim poia pani ve ataghon ataman to Rumei Tiina gha aloŋ ala.","poem":1},{"text":"Apaiti ve aloŋ ala sirsiir tooni loolo.","poem":2},{"lineBreak":true},{"text":"Lolomim poia pani ve apakur eeza pa poia tooni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pasaa, Yoova, ŋgar tooni poia mon.","poem":1},{"text":"I loolo isaghav tamtamon tooni ariaaŋ, ve iuluul zi irau saawe.","poem":2},{"lineBreak":true},{"text":"Ve itataghon saveeŋ mbuaaŋ tooni, taghon taghon gha ila.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_tua/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_tua/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_tua/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}