{"translation":{"id":"tuc_tua","name":"Maaron Saveeŋ Tooni Patabuyaaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseNotes":null,"shortName":"TUA","englishName":"Saveeng Tuam Bible","language":"tuc","textDirection":"ltr","sha256":"fcddb0db8bdd9fd527e23237bf9afe29658d49be250fa63887deddae1eaee7f1","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_tua/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12313,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_tua","name":"Mbouŋ To Yes Israela","commonName":"Mbouŋ To Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"380974fa59c5aa4cb3764e10be548fb94359fbe2962ef9058633848f55b59fb9","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_tua/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_tua/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":124,"content":[{"type":"heading","content":["Tapait Maaron pa uleeŋ tooni"]},{"type":"hebrew_subtitle","content":["Mbouŋ to yes tau tizala Yerusalem pa suŋuuŋ"]},{"type":"hebrew_subtitle","content":["Mbouŋ to David"]},{"type":"verse","number":1,"content":[{"text":"“Imin ta Yoova ivool toit mako, kanaŋ tagham saghat.”","poem":1},{"text":"Yam eval tiina to Israel irau asaav tauvene:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Saawe tau koiaanŋa tipaburigin malmal pait,","poem":1},{"text":"imin ta Yoova ivool toit mako, kanaŋ tipasov ghiit.","poem":2},{"lineBreak":true},{"text":"Pasaa, atezi yavyav pait kat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pataŋani tawe, ene imin yaa ivot toman tapiri ve izugh ghiit tala ve imbeluut ghiit.","poem":1},{"text":"Ve ene imin lulu iloŋ, ve igherev ghiit tala gha taghun te.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eemon Yoova ipul ghiit tala koiaanŋa nimazi to tivaghamun ghiit mako.","poem":1},{"text":"Tauvene tapaiti pa poia tooni!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Saawe tana, iit tamin man tau liis ighamu.","poem":1},{"text":"Eemon Yoova ipas ghiit pa liis tawe, ve taghau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yoova ta ighur sambam ve taan.","poem":1},{"text":"I mon ta Uleeŋa toit.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_tua/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_tua/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_tua/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":6}