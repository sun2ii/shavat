{"translation":{"id":"tuc_tua","name":"Maaron Saveeŋ Tooni Patabuyaaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseNotes":null,"shortName":"TUA","englishName":"Saveeng Tuam Bible","language":"tuc","textDirection":"ltr","sha256":"fcddb0db8bdd9fd527e23237bf9afe29658d49be250fa63887deddae1eaee7f1","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_tua/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12313,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_tua","name":"Mbouŋ To Yes Israela","commonName":"Mbouŋ To Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"380974fa59c5aa4cb3764e10be548fb94359fbe2962ef9058633848f55b59fb9","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_tua/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_tua/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":131,"content":[{"type":"heading","content":["Suŋuuŋ to ŋeer tau inumeer Maaron mon"]},{"type":"hebrew_subtitle","content":["Mbouŋ to yes tau tizala Yerusalem pa suŋuuŋ"]},{"type":"hebrew_subtitle","content":["Mbouŋ to David"]},{"type":"verse","number":1,"content":[{"text":"O Yoova, ŋgar pakuruuŋ eta igheen ila lolog mako,","poem":1},{"text":"ve matag izi pa zetagŋa mako,","poem":2},{"lineBreak":true},{"text":"ve nazuari ghau to namin tiina, paam mako.","poem":2},{"lineBreak":true},{"text":"Tauvene ŋgar ve uraat tintiina tau narao mako na, nazazain taug pazi mako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yau naghilaal Maaron. Tauta lolog bubu mako. Lolog iraurau, ve ateg izi,","poem":1},{"text":"imin ŋeer marani tau tiina imbaraara le loolo poia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O yam Israela, anumeer Yoova, ve aghur matamim pani pa uleeŋ. Ta aazne, ve taghon taghon gha ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_tua/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_tua/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_tua/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}