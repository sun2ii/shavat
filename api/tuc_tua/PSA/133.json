{"translation":{"id":"tuc_tua","name":"Maaron Saveeŋ Tooni Patabuyaaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseNotes":null,"shortName":"TUA","englishName":"Saveeng Tuam Bible","language":"tuc","textDirection":"ltr","sha256":"fcddb0db8bdd9fd527e23237bf9afe29658d49be250fa63887deddae1eaee7f1","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_tua/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12313,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_tua","name":"Mbouŋ To Yes Israela","commonName":"Mbouŋ To Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"380974fa59c5aa4cb3764e10be548fb94359fbe2962ef9058633848f55b59fb9","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_tua/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_tua/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":133,"content":[{"type":"heading","content":["Talup loloon imin eemon"]},{"type":"hebrew_subtitle","content":["Mbouŋ to yes tau tizala Yerusalem pa suŋuuŋ"]},{"type":"hebrew_subtitle","content":["Mbouŋ to David"]},{"type":"verse","number":1,"content":[{"text":"Isaav ighe tamtamon to Maaron tilup lolozi imin eemon itaghon ŋgar to toŋvetaz, ene pale paghuuna,","poem":1},{"text":"ve igham loloon poia kat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ene imin ŋgoreeŋ vaazi poia","poem":1},{"noteId":20},"tau tiliŋi izala Aron daaba,",{"text":"ve ireer izi itaghon aaze ooro,","poem":2},{"lineBreak":true},{"text":"le itaghon nonoghiiŋa tooni gha izila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ŋgar to loloon eemon, ene imin uwam tiina izi pa loloz tau tigharau nugh Zion, raraate imin uwam tau izizi ila loloz Ermon.","poem":1},{"text":"Onoon kat, ighe yes to nugh Zion tilup lolozi imin eemon, ene pale Yoova ighur poia tooni izaa toozi.","poem":2},{"lineBreak":true},{"text":"Ene lepoogh poia tau iseeŋga taghon taghon gha ila.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Saveeŋ to ŋgoreeŋ vaazi poia, ene izaa to poia to Maaron. Ve uwam, ene izaa to lepoogh poia tau i igham pait.","reference":{"chapter":133,"verse":2}}]},"thisChapterLink":"/api/tuc_tua/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_tua/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_tua/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}