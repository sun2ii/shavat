{"translation":{"id":"tuc_tua","name":"Maaron Saveeŋ Tooni Patabuyaaŋ","website":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tuc-t","licenseNotes":null,"shortName":"TUA","englishName":"Saveeng Tuam Bible","language":"tuc","textDirection":"ltr","sha256":"fcddb0db8bdd9fd527e23237bf9afe29658d49be250fa63887deddae1eaee7f1","availableFormats":["json"],"listOfBooksApiLink":"/api/tuc_tua/books.json","numberOfBooks":32,"totalNumberOfChapters":498,"totalNumberOfVerses":12313,"languageName":"Mutu","languageEnglishName":"Mutu"},"book":{"id":"PSA","translationId":"tuc_tua","name":"Mbouŋ To Yes Israela","commonName":"Mbouŋ To Yes Israela","title":"Mbouŋ To Yes Israela Buk Song—Psalms","order":19,"numberOfChapters":150,"sha256":"380974fa59c5aa4cb3764e10be548fb94359fbe2962ef9058633848f55b59fb9","firstChapterNumber":1,"firstChapterApiLink":"/api/tuc_tua/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tuc_tua/PSA/150.json","totalNumberOfVerses":2407},"chapter":{"number":23,"content":[{"type":"heading","content":["Yoova, i ŋginiiŋ toit"]},{"type":"hebrew_subtitle","content":["Mbouŋ to David"]},{"type":"verse","number":1,"content":[{"text":"Yoova, i ŋginiiŋ tsiau poia.","poem":1},{"text":"Irau nambool pa gabua eta mako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I ighegherev ghau nala pa kikiliiŋ popoia tau igheen yaa naliu ziige na.","poem":1},{"text":"Leso naghan, naghun yaa luuma, ve namariau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I igham tapirig ivot muul,","poem":1},{"text":"ve ipaduduuŋ ghau le nataghon eez tau iduduuŋ ila i maata.","poem":2},{"lineBreak":true},{"text":"Leso ipaghazoŋai eeza tiina ivot ighazooŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yoova, ighe nalaagh ila nugh sapsapu to mateegh, ve ndoroom tiina ikau ghau, ene irau naroi mako.","poem":1},{"text":"Pasaa, yo uleep tomani ghau.","poem":2},{"lineBreak":true},{"text":"Yau naghit ghom ukis zaab tsio tomania titi to upaduduuŋ sipsip pani, tauvene ateg izi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yau nalam namin loom payo, ve yo upakur ghau kat.","poem":1},{"text":"Yo ugham marewaaŋ tiina payau ila koiagŋa matazi.","poem":2},{"lineBreak":true},{"text":"Ve uliŋ ŋgoreeŋ izala dabag, ve ugham poghani ghau kat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Onoon kat, saawe isov tau naleep izi taan, yo lolom isaghav ghau, ve poia tsio izazaa tsiau itaghon saveeŋ mbuaaŋ tsio.","poem":1},{"text":"Rumei tsio aat imin niag to lepoogh le irau saawe tsiau isov.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tuc_tua/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tuc_tua/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tuc_tua/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}