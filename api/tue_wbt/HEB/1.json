{"translation":{"id":"tue_wbt","name":"Cõãmacʉ̃ mecʉ̃ã wedesei","website":"https://ebible.org/Scriptures/details.php?id=tue","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tue","licenseNotes":null,"shortName":"WBT","englishName":"Tuyuca NT","language":"tue","textDirection":"ltr","sha256":"af30de629b2db2cf659882a767f91f9c37cd8708ffc73bb4c87d6e9138b25593","availableFormats":["json"],"listOfBooksApiLink":"/api/tue_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7879,"languageName":"Tuyuca","languageEnglishName":"Tuyuca"},"book":{"id":"HEB","translationId":"tue_wbt","name":"Hebreos","commonName":"Hebreos","title":"HEBREOARE jóaripũ","order":58,"numberOfChapters":13,"sha256":"97ede1175cc8818ca3a6429f23c04dbd204bdaad7462be788b398357bd5239e6","firstChapterNumber":1,"firstChapterApiLink":"/api/tue_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/tue_wbt/HEB/13.json","totalNumberOfVerses":299},"chapter":{"number":1,"content":[{"type":"heading","content":["Cõãmacʉ̃ cʉ̃ʉ̃ macʉ̃mena basocáre wedeyigʉ"]},{"type":"verse","number":1,"content":["Too sʉgueropʉ Cõãmacʉ̃ cʉ̃ʉ̃yara profetamena marĩ ñecʉ̃sʉ̃mʉãrẽ wedeyigʉ; sĩcãrĩ mee wedeyigʉ. Cʉ̃ʉ̃ wederécõrõ merẽã dícʉ wederucuyigʉ."]},{"type":"verse","number":2,"content":["Atitó niiture bʉrecorire cʉ̃ʉ̃ macʉ̃mena marĩrẽ wederigʉ niiwĩ. Cõãmacʉ̃ cʉ̃ʉ̃ macʉ̃rẽ “niipetire mʉʉye pʉtʉáadacu” jĩĩyigʉ. Cʉ̃ʉ̃menarã atibʉ́recore bauanéyigʉ."]},{"type":"verse","number":3,"content":["Cʉ̃ʉ̃rã́ Cõãmacʉ̃ asibatére ãñurére cʉogʉ́ niiĩ. Cʉ̃ʉ̃rã́ sũcã Cõãmacʉ̃biro niirecʉtiqui. Cʉ̃ʉ̃ wedesere tutuare cʉorémena niipetire atibʉ́reco niirére ĩñanʉnʉsequi. Marĩ ñañaré tiirére cosetóagʉ, Cõãmacʉ̃ tutuanetõgʉ̃ pʉtopʉ diamacʉ̃́pe jeanuãjeayigʉ."]},{"type":"heading","content":["Cõãmacʉ̃ macʉ̃ ángelea nemorṍ ʉpʉtí macʉ̃ niiĩ"]},{"type":"verse","number":4,"content":["Cõãmacʉ̃ cʉ̃ʉ̃ macʉ̃rẽ Õpʉ̃ niirére sõnecoyigʉ. Teero tiigʉ́, ángelea nemorṍ ʉpʉtí macʉ̃ pʉtʉáyigʉ."]},{"type":"verse","number":5,"content":["Cõãmacʉ̃ cʉ̃ʉ̃ macʉ̃rẽ biiro jĩĩyigʉ:",{"text":"Mʉʉ yʉʉ macʉ̃ niiã.","poem":1},{"lineBreak":true},{"text":"Mecʉ̃ãmena yʉʉ mʉʉ pacʉ niirére masĩãdacua.","poem":1},{"noteId":0},"Sĩcʉ̃ ángelere teero jĩĩriyigʉ. Teero biiri cʉ̃ʉ̃ macʉ̃ye maquẽrẽ wedesegʉ, biiro jĩĩyigʉ:",{"text":"Yʉʉ cʉ̃ʉ̃ pacʉ niigʉ̃da.","poem":1},{"lineBreak":true},{"text":"Cʉ̃ʉ̃ yʉʉ macʉ̃ niigʉ̃daqui.","poem":1},{"noteId":1},"Sĩcʉ̃ ángelere teero jĩĩriyigʉ."]},{"type":"verse","number":6,"content":["Basocá sõwʉ̃ jĩĩgʉ̃́rẽ atibʉ́recopʉ ticodioconemorĩ, cʉ̃ʉ̃ jĩĩãdarere biiro jóanoã:",{"text":"Niipetira ángelea cʉ̃ʉ̃rẽ jeacũmu, padeoáro,","poem":1},"jĩĩ jóanoã."]},{"type":"verse","number":7,"content":["Ángeleapere cʉ̃ʉ̃ jĩĩrére biirope jóanoã:",{"text":"Ángelea Cõãmacʉ̃rẽ padecotera niicua;","poem":1},{"lineBreak":true},{"text":"cʉ̃ʉ̃ dutirére tiirá, wĩno tiiróbiro wáacua.","poem":1},{"lineBreak":true},{"text":"Cʉ̃́ãrã sũcã pecame tiiróbiro niicua.","poem":1},{"noteId":2}]},{"type":"verse","number":8,"content":["Cʉ̃ʉ̃ macʉ̃péreja biirope jóanoã:",{"text":"Mʉʉ Cõãmacʉ̃ niiã; mʉʉ Õpʉ̃ niiré petirícu.","poem":1},{"lineBreak":true},{"text":"Mʉʉ niipetirare diamacʉ̃́rã dutigʉdacu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mʉʉ diamacʉ̃́ tiirére booa; netõnʉcã́repere booría.","poem":1},{"lineBreak":true},{"text":"Teero tiigʉ́, Cõãmacʉ̃ mʉʉ Õpʉ̃ niigʉ̃́ mʉʉrẽ bese, õpʉ̃ sõnecowi.","poem":1},{"lineBreak":true},{"text":"Mʉʉ menamacãrã nemorṍ mʉʉrẽ ʉsenire painemorõ ticowi,","poem":1},{"noteId":3},"jĩĩ jóanoã."]},{"type":"verse","number":10,"content":["Atecã́ cʉ̃ʉ̃ macʉ̃péreja biiro jóanoã:",{"text":"Basocá Õpʉ̃, sicatopʉre mʉʉ basirora atibʉ́recore bauanéwʉ̃;","poem":1},{"lineBreak":true},{"text":"ʉ̃mʉã́se niirécãrẽ tiiwʉ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mʉʉ tiirígue petijṍããdacu;","poem":1},{"lineBreak":true},{"text":"mʉʉpeja niirucujãgʉ̃dacu.","poem":1},{"lineBreak":true},{"text":"Niipetire mʉʉ tiirígue suti tiiróbiro bóadiaadacu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mʉʉ teeré suti tiiróbiro tuupégʉdacu.","poem":1},{"lineBreak":true},{"text":"Niipetire wasonóãdacu.","poem":1},{"lineBreak":true},{"text":"Mʉʉpeja wasorícu.","poem":1},{"lineBreak":true},{"text":"Mʉʉ catiré petirícu,","poem":1},{"noteId":4},"jĩĩ jóanoã."]},{"type":"verse","number":13,"content":["Cõãmacʉ̃ atecã́rẽ cʉ̃ʉ̃ macʉ̃rẽ biiro jĩĩrigʉ niiwĩ:",{"text":"Yáa wãmo diamacʉ̃́niñape duiya,","poem":1},{"lineBreak":true},{"text":"tée mʉʉrẽ ĩñatutirare mʉʉ dutiriguere yʉʉ ãñurõ yʉʉri tiirípʉ.","poem":1},{"noteId":5},"Sĩcʉ̃ ángelere teero jĩĩriyigʉ."]},{"type":"verse","number":14,"content":["Niipetira ángelea bauhéra niiĩya. Cʉ̃́ã cʉ̃ʉ̃ dutirére tiicotéra niiĩya. Cʉ̃́ã cʉ̃ʉ̃ netõnénorirare tiiápudutigʉ ticodiocora niiĩya."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Salmo 2.7.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2 Samuel 7.14; 1 Crónicas 17.13.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Salmo 104.4.","reference":{"chapter":1,"verse":7}},{"noteId":3,"caller":"+","text":"Salmo 45.6-7.","reference":{"chapter":1,"verse":9}},{"noteId":4,"caller":"+","text":"Salmo 102.25-27.","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"+","text":"Salmo 110.1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/tue_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tue_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tue_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}