{"translation":{"id":"tur_obt","name":"Open Basic Turkish New Testament","website":"https://ebible.org/Scriptures/details.php?id=turobt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turobt","licenseNotes":null,"shortName":"OBT","englishName":"Open Basic Turkish New Testament","language":"tur","textDirection":"ltr","sha256":"c845298a378adeec9834977c908da252bff1759b51aebe6b3cfdd59ddea4841d","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_obt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7896,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HEB","translationId":"tur_obt","name":"İbraniler","commonName":"İbraniler","title":"İbranilerʼe Mektup","order":58,"numberOfChapters":13,"sha256":"a628ed46cf982db554034e21c26ffc58bdfd3a09401a0845c78da5f664ad78a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_obt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/tur_obt/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["İsa Mesih meleklerden üstündür"]},{"type":"verse","number":1,"content":["Eski zamanlarda Allah, sözünü birçok defa ve çeşitli yollardan atalarımıza peygamberler aracılığıyla bildirdi."]},{"type":"verse","number":2,"content":["Ama dünyanın bu son günlerinde sözünü bize kendi Oğlu aracılığıyla bildirdi. Oğluʼnu her şeyin mirasçısı kıldı. Oʼnun aracılığıyla da evreni yarattı."]},{"type":"verse","number":3,"content":["Oğul, Allahʼın görkemini yansıtır. O, Allah özünün gözle görünen şeklidir. Kendi güçlü sözüyle her şeyi devam ettirir. Günahlarımızdan temizlenmemizi sağladıktan sonra göklerde yüce Allahʼın sağına oturdu.",{"noteId":0}]},{"type":"verse","number":4,"content":["Oğul meleklerden daha üstün bir ad miras aldı, aynı şekilde kendisi de onlardan daha üstün oldu."]},{"type":"verse","number":5,"content":["Allah asla meleklerden birine şunu demedi:",{"text":"“Sen benim oğlumsun.","poem":1},{"text":"Bugün ben sana baba oldum.”","poem":2},{"noteId":1},"Ya da,",{"text":"“Ben ona baba olacağım,","poem":1},{"text":"o da bana oğul olacak.”","poem":2},{"noteId":2}]},{"type":"verse","number":6,"content":["Fakat Allah, ilk doğan olarak her şeyi miras alan Oğluʼnu dünyaya gönderirken şöyle buyurur:",{"text":"“Allahʼın bütün melekleri Oʼna tapınsınlar.”","poem":1},{"noteId":3}]},{"type":"verse","number":7,"content":["Ama melekler hakkında şöyle denir:",{"text":"“Allah meleklerini rüzgar,","poem":1},{"text":"hizmetkârlarını ateş alevi yapar.”","poem":2},{"noteId":4}]},{"type":"verse","number":8,"content":["Ama Oğul hakkında şöyle denir:",{"text":"“Senin tahtın, ey Allah, sonsuzlara kadar duracak.","poem":1},{"text":"Senin krallık değneğin adalet değneğidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Doğruluğu sevdin ve kötülükten nefret ettin.","poem":1},{"text":"Bu sebeple Allah, senin Allahın,","poem":2},{"lineBreak":true},{"text":"seni sevinç yağıyla meshetti,","poem":2},{"noteId":5},{"lineBreak":true},{"text":"arkadaşlarından üstün kıldı.”","poem":2},{"noteId":6}]},{"type":"verse","number":10,"content":["Yine şöyle denir:",{"text":"“Sen, ya Rab, zamanın başlangıcında dünyanın temelini attın.","poem":1},{"text":"Gökler de senin ellerinin eseridir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onlar yok olup gidecek, ama sen kalıcısın.","poem":1},{"text":"Onların hepsi bir elbise gibi eskiyecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gökleri bir kaftan gibi katlayacaksın,","poem":1},{"text":"Bir elbise gibi değiştirilecek.","poem":2},{"text":"Ama sen aynı kalıyorsun,","poem":1},{"text":"senin yıllarının sonu yok.”","poem":2},{"noteId":7}]},{"type":"verse","number":13,"content":["Allah hiçbir meleğe şöyle demedi:",{"text":"“Senin düşmanlarını ayaklarına basamak yapacağım.","poem":1},{"text":"O zamana kadar sağımda otur.”","poem":2},{"noteId":8}]},{"type":"verse","number":14,"content":["Meleklerin hepsi görevli ruhlar değil mi? Onlar kurtuluşu miras alacak olan insanlara hizmet etmek için gönderilmiyorlar mı?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Allahʼın sağına oturdu Allahʼın yanında en şerefli yere kavuştu, en üstün yetkiye sahip oldu.","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"Mezmur 2:7","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"2. Samuel 7:14; 1. Tarihler 17:13","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"Yasanın Tekrarı 32:43Bu aktarmanın Septuaginta adlı Tevratʼın Grekçe tercümesinden olduğu düşünülür.","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"Mezmur 104:4","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"Seni sevinç yağıyla meshetti Yani, seni kral seçerek sevindirdi. Eski zamanlarda kral olarak seçilen kişinin başına zeytinyağı dökülürdü.","reference":{"chapter":1,"verse":9}},{"noteId":6,"caller":"+","text":"Mezmur 45:6,7","reference":{"chapter":1,"verse":9}},{"noteId":7,"caller":"+","text":"Mezmur 102:25‑27","reference":{"chapter":1,"verse":12}},{"noteId":8,"caller":"+","text":"Mezmur 110:1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/tur_obt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_obt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_obt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}