{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"2SA","translationId":"tur_ytc","name":"2. SAMUEL","commonName":"2. SAMUEL","title":"2. SAMUEL","order":10,"numberOfChapters":24,"sha256":"f96b4d55778ed459f56c18385b902c6baeae4cd85654ae18afff4e1a5fd821a5","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/tur_ytc/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["David, Yahve'nin onu bütün düşmanlarının elinden ve Saul'un elinden kurtardığı gün, Yahve'ye bu ezginin sözlerini söyledi."]},{"type":"verse","number":2,"content":["Ve şöyle dedi:",{"text":"“Yahve benim kayam,","poem":1},{"text":"kalem, evet, kurtarıcımdır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tanrı kayamdır, O'na sığınırım;","poem":1},{"text":"kalkanım, kurtuluşumun boynuzu,","poem":2},{"lineBreak":true},{"text":"yüksek kulem ve sığınağımdır.","poem":2},{"lineBreak":true},{"text":"Kurtarıcım, beni zorbalıktan sen kurtarırsın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Övgüye layık olan Yahve'yi çağırıyorum;","poem":1},{"text":"böylece düşmanlarımdan kurtulacağım.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü ölüm dalgaları beni kuşattı.","poem":1},{"text":"Tanrısızlığın selleri beni korkuttu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Şeol'ün","poem":1},{"noteId":11},{"text":"ipleri çevremi sardı.","poem":1},{"text":"Ölüm tuzakları beni yakaladı.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sıkıntıda Yahve'yi çağırdım.","poem":1},{"text":"Evet, Tanrım'ı çağırdım.","poem":2},{"text":"Tapınağından sesimi duydu.","poem":1},{"text":"Feryadım O'nun kulaklarına ulaştı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sonra yeryüzü sarsıldı ve titredi.","poem":1},{"text":"Göğün temelleri oynadı ve sarsıldı,","poem":2},{"lineBreak":true},{"text":"çünkü O öfkelenmişti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Burnundan duman yükseldi.","poem":1},{"text":"Ağzından yiyip bitiren ateş çıktı.","poem":2},{"lineBreak":true},{"text":"Bundan közler tutuştu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gökleri de eğip aşağıya indi.","poem":1},{"text":"Ayaklarının altı koyu karanlıktı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bir Keruv'a binip uçtu. Evet, rüzgârın kanatları üzerinde göründü.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Karanlığı, göklerin koyu bulutlarını,","poem":1},{"text":"suların toplanmasını,","poem":2},{"lineBreak":true},{"text":"kendi çevresinde sığınak yaptı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Önündeki parlaklıkta, ateş közleri tutuştular.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yahve göklerden gürledi.","poem":1},{"text":"En Yüce Olan sesini duyurdu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oklar gönderip onları dağıttı,","poem":1},{"text":"şimşek çaktırıp onları şaşkına çevirdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sonra denizin kanalları göründü.","poem":1},{"text":"Dünyanın temelleri, Yahve'nin azarlamasıyla,","poem":2},{"lineBreak":true},{"text":"burun soluğunun şiddetinde açığa çıktı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yukarıdan gönderip beni aldı,","poem":1},{"text":"beni çok sulardan çıkardı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Beni güçlü düşmanımdan,","poem":1},{"text":"benden nefret edenlerden kurtardı,","poem":2},{"lineBreak":true},{"text":"çünkü onlar benden çok güçlüydüler.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Felaket günümde üzerime geldiler,","poem":1},{"text":"ama Yahve bana destek oldu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Beni geniş bir yere çıkardı.","poem":1},{"text":"Beni kurtardı, çünkü benden hoşnut oldu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yahve doğruluğuma göre beni ödüllendirdi,","poem":1},{"text":"ellerimin temizliğine göre bana karşılık verdi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü Yahve'nin yollarını tuttum,","poem":1},{"text":"kötülükle de Tanrım'dan ayrılmadım.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü bütün kuralları önümdeydi,","poem":1},{"text":"ilkelerine gelince, onlardan ayrılmadım.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ben de ona karşı kusursuzdum.","poem":1},{"text":"Kötülüğümden kendimi alıkoydum.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bu yüzden Yahve doğruluğuma göre,","poem":1},{"text":"gözündeki temizliğime göre beni ödüllendirdi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Merhametli olana kendini merhametli göstereceksin.","poem":1},{"text":"Kusursuz insana kendini kusursuz göstereceksin.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Pak olana kendini pak olarak göstereceksin.","poem":1},{"text":"Eğri olana kendini sert olarak göstereceksin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ezilenleri kurtaracaksın,","poem":1},{"text":"ama gözlerin onları alçaltmak için kibirlilerin üzerindedir.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Çünkü sen benim kandilimsin, ey Yahve.","poem":1},{"text":"Benim karanlığımı Yahve aydınlatacaktır.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Çünkü seninle askerlere karşı koşarım.","poem":1},{"text":"Tanrım'la suru aşarım.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tanrı'ya gelince, O'nun yolu kusursuzdur.","poem":1},{"text":"Yahve'nin sözü sınanmıştır.","poem":2},{"lineBreak":true},{"text":"O kendisine sığınanların hepsine kalkandır.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Çünkü Yahve dışında Tanrı kimdir?","poem":1},{"text":"Tanrımız'ın dışında kaya kimdir?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tanrı benim güçlü kalemdir.","poem":1},{"text":"Yolumu kusursuz kılar.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Onun ayaklarını geyik ayakları gibi yapar,","poem":1},{"text":"beni yüksek yerlerime yerleştirir.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ellerime savaşmayı öğretir,","poem":1},{"text":"kollarımla tunç bir yayı gereyim diye.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kurtarışının kalkanını da bana verdin.","poem":1},{"text":"Yumuşaklığın beni büyük yaptı.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Adımlarımı altımda genişlettin.","poem":1},{"text":"Ayaklarım kaymadı.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Düşmanlarımı kovaladım ve onları yok ettim.","poem":1},{"text":"Onlar tükenmeden geri dönmedim.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Onları tükettim ve vurdum,","poem":1},{"text":"artık kalkamazlar.","poem":2},{"lineBreak":true},{"text":"Evet, ayaklarımın altına düştüler.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Çünkü savaş için beni güçle donattın.","poem":1},{"text":"Bana karşı kalkanları altımda boyun eğdirdin.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Düşmanlarımın sırtını da bana çevirttin,","poem":1},{"text":"benden nefret edenleri yok edeyim diye.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Onlar baktılar, ama kurtaracak kimse yoktu;","poem":1},{"text":"Yahve'ye baktılar, ama onlara yanıt vermedi.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"O zaman onları yerin tozu gibi dövdüm,","poem":1},{"text":"onları sokakların çamuru gibi ezdim ve dağıttım.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Halkımın çekişmelerinden beni kurtardın.","poem":1},{"text":"ulusların başı olmam için beni korudun.","poem":2},{"lineBreak":true},{"text":"Bilmediğim bir halk bana hizmet edecek.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Yabancılar bana boyun eğecekler.","poem":1},{"text":"Benim hakkımda duyar duymaz bana itaat edecekler.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yabancılar zayıflayacaklar,","poem":1},{"text":"titreyerek kapalı yerlerinden çıkacaklar.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yahve yaşıyor! Kayam yücelsin!","poem":1},{"text":"Kurtuluşumun kayası, Tanrı yücelsin,","poem":2}]},{"type":"verse","number":48,"content":[{"text":"O'dur öcümü alan, halkları bana tabi kılan,","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"beni düşmanlarımdan uzaklaştıran Tanrı.","poem":1},{"lineBreak":true},{"text":"Evet, bana karşı ayaklananların üzerine beni sen yükseltirsin.","poem":1},{"text":"Beni zorba adamdan kurtarırsın.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bu yüzden, ey Yahve, uluslar arasında sana şükredeceğim,","poem":1},{"text":"adını ilahilerle öveceğim.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"O, kralına büyük kurtuluş verir,","poem":1},{"text":"meshedilmişine, David'e ve onun soyuna","poem":2},{"lineBreak":true},{"text":"Sonsuza dek sevgi dolu iyiliğini gösterir.”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":22,"verse":6}}]},"thisChapterLink":"/api/tur_ytc/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}