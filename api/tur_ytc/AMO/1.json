{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"AMO","translationId":"tur_ytc","name":"AMOS","commonName":"AMOS","title":"AMOS","order":30,"numberOfChapters":9,"sha256":"fe93dd2a6703080650b1241681eaf7be0fc0b11623175b3cc0c7e5ef664b966b","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tur_ytc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Tekoa çobanları arasında bulunan Amos'un sözleri, Yahuda Kralı Uzziya'nın günlerinde ve İsrael Kralı Yoaş oğlu Yarovam'ın günlerinde, depremden iki yıl önce İsrael hakkında gördü."]},{"type":"verse","number":2,"content":["Şöyle dedi:",{"text":"“Yahve","poem":1},{"noteId":0},{"text":"Siyon'dan kükreyecek,","poem":1},{"text":"ve Yeruşalem'den sesini duyuracak;","poem":2},{"text":"ve çobanların otlakları yas tutacak,","poem":1},{"text":"ve Karmel'in tepesi kuruyacak.”","poem":2}]},{"type":"verse","number":3,"content":["Yahve şöyle diyor:",{"text":"“Damaskus'un üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü Gilad'ı demirden dövenlerle dövdüler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ama Hazael'in evinin içine ateş göndereceğim,","poem":1},{"text":"ve Ben Hadad'ın saraylarını yiyip bitirecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Damaskus kapı sürgüsünü kıracağım,","poem":1},{"text":"ve Aven Vadisi'nden orada oturanı,","poem":2},{"lineBreak":true},{"text":"Aden evinden asa tutanı kesip atacağım;","poem":2},{"lineBreak":true},{"text":"ve Suriye halkı Kir'e sürülecek.”","poem":2},"diyor Yahve."]},{"type":"verse","number":6,"content":["Yahve şöyle diyor:",{"text":"“Gaza’nın üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim;","poem":2},{"lineBreak":true},{"text":"çünkü bütün topluluğu Edom’a teslim etmek için sürgün ettiler;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gaza suru üzerine ateş göndereceğim,","poem":1},{"text":"ve onun saraylarını yiyip bitirecek.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aşdod’dan orada oturanı,","poem":1},{"text":"Aşkelon’dan asa tutanı kesip atacağım;","poem":2},{"text":"ve elimi Ekron’a karşı çevireceğim;","poem":1},{"text":"ve Filistliler'in arta kalanı yok olacak.”","poem":2},"diyor Efendi",{"noteId":1},"Yahve."]},{"type":"verse","number":9,"content":["Yahve şöyle diyor:",{"text":"“Sur’un üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim;","poem":2},{"lineBreak":true},{"text":"çünkü bütün topluluğu Edom’a teslim ettiler,","poem":2},{"lineBreak":true},{"text":"ve kardeşlik antlaşmasını hatırlamadılar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama Sur'un suru üzerine ateş göndereceğim,","poem":1},{"text":"onun saraylarını yiyip bitirecek.”","poem":2}]},{"type":"verse","number":11,"content":["Yahve şöyle diyor:",{"text":"“Edom’un üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü kardeşini kılıçla kovaladı,","poem":2},{"lineBreak":true},{"text":"ve bütün acımasını yitirdi,","poem":2},{"lineBreak":true},{"text":"ve öfkesi sürekli köpürdü,","poem":2},{"lineBreak":true},{"text":"ve gazabını daima korudu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama ben Teman üzerine ateş göndereceğim,","poem":1},{"text":"ve Bostra'nın saraylarını yiyip bitirecek.”","poem":2}]},{"type":"verse","number":13,"content":["Yahve şöyle diyor:",{"text":"“Ammon'un çocuklarının üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü kendi sınırlarını genişletmek için","poem":2},{"lineBreak":true},{"text":"Gilad’ın gebe kadınlarının karınlarını yardılar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ama Rabba surunda ateş tutuşturacağım,","poem":1},{"text":"ve savaş gününde haykırışlarla,","poem":2},{"lineBreak":true},{"text":"kasırga gününde fırtınayla","poem":2},{"lineBreak":true},{"text":"onun saraylarını yiyip bitirecek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kralları ve beyleri","poem":1},{"text":"birlikte sürgüne gidecekler.”","poem":2},"diyor Yahve."]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/tur_ytc/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}