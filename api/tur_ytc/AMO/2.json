{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"AMO","translationId":"tur_ytc","name":"AMOS","commonName":"AMOS","title":"AMOS","order":30,"numberOfChapters":9,"sha256":"fe93dd2a6703080650b1241681eaf7be0fc0b11623175b3cc0c7e5ef664b966b","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tur_ytc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Yahve şöyle diyor:",{"text":"“Moav’ın üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü Edom Kralı'nın kemiklerini kireç edinceye dek yaktı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ama Moav’ın üzerine ateş göndereceğim,","poem":1},{"text":"ve Keriyot'un saraylarını yiyip bitirecek;","poem":2},{"lineBreak":true},{"text":"ve Moav kargaşayla, bağırışlarla ve boru sesiyle ölecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onun içinden hâkimi söküp atacağım,","poem":1},{"text":"ve onunla birlikte bütün beylerini öldüreceğim.”","poem":2},"diyor Yahve."]},{"type":"verse","number":4,"content":["Yahve şöyle diyor:",{"text":"“Yahuda’nın üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'nin Yasası'nı reddettiler,","poem":2},{"lineBreak":true},{"text":"ve O'nun kurallarına uymadılar,","poem":2},{"lineBreak":true},{"text":"ve yalanları onları saptırdı,","poem":2},{"lineBreak":true},{"text":"ataları da o yalanların ardında yürümüştü.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama Yahuda’nın üzerine ateş göndereceğim,","poem":1},{"text":"ve Yeruşalem'in saraylarını yiyip bitirecek.”","poem":2}]},{"type":"verse","number":6,"content":["Yahve şöyle diyor:",{"text":"“İsrael'in üç, hatta dört suçundan ötürü","poem":1},{"text":"cezasını geri çevirmeyeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü doğru kişiyi gümüşe,","poem":2},{"lineBreak":true},{"text":"ve yoksulu bir çift çarığa sattılar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onlar yoksulun başını yerin tozunda çiğniyor,","poem":1},{"text":"ve ezileni haktan yoksun bırakıyorlar.","poem":2},{"text":"Bir adam ve babası aynı kızı kullanarak kutsal adımı kirletiyorlar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Her sunağın yanında rehin alınan giysiler üzerinde yatıyorlar.","poem":1},{"lineBreak":true},{"text":"Tanrıları'nın","poem":1},{"noteId":2},{"text":"evinde cezaya çarptırılanların şarabını içiyorlar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ama onlardan önce Amorlular'ı yok ettim,","poem":1},{"text":"boyu sedirlerin yüksekliği gibiydi,","poem":2},{"lineBreak":true},{"text":"meşeler kadar da güçlüydü o;","poem":2},{"lineBreak":true},{"text":"yine de meyvesini yukarıdan,","poem":2},{"lineBreak":true},{"text":"ve kökünü aşağıdan yok ettim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sizi Mısır diyarından çıkardım,","poem":1},{"text":"ve Amorlular'ın diyarını mülk edinmeniz için","poem":2},{"lineBreak":true},{"text":"çölde size kırk yıl yol gösterdim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oğullarınızdan bazılarını peygamber,","poem":1},{"text":"gençlerinizden bazılarını da adanmış kişiler olarak yetiştirdim.","poem":2},{"text":"Ey İsrael'in çocukları,","poem":1},{"text":"bu doğru değil mi?” diyor Yahve.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Ama siz adanmış olanlara şarap içirdiniz,","poem":1},{"text":"ve peygamberlere, ‘Peygamberlik etmeyin!’ diye buyurdunuz.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İşte,","poem":1},{"noteId":3},{"text":"buğday dolu bir araba nasıl ezerse,","poem":1},{"text":"ben de sizi yerinizde öyle ezeceğim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çabuk koşan kaçamayacak.","poem":1},{"text":"Güçlü olan kendi kuvvetini gösteremeyecek.","poem":2},{"lineBreak":true},{"text":"Yiğit olan kendini kurtaramayacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yay çeken ayakta duramayacak.","poem":1},{"text":"Ayağı hızlı olan kaçamayacak.","poem":2},{"lineBreak":true},{"text":"At sırtında olan kendini kurtaramayacak.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yiğitler arasında cesur olan","poem":1},{"text":"o gün çıplak kaçacak.”","poem":2},"diyor Yahve."]}],"footnotes":[{"noteId":2,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":2,"verse":8}},{"noteId":3,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}