{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"AMO","translationId":"tur_ytc","name":"AMOS","commonName":"AMOS","title":"AMOS","order":30,"numberOfChapters":9,"sha256":"fe93dd2a6703080650b1241681eaf7be0fc0b11623175b3cc0c7e5ef664b966b","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tur_ytc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Ey İsrael'in çocukları, Mısır diyarından çıkardığı bütün soya karşı, Yahve'nin size karşı söylediği şu sözü dinleyin dedi:"]},{"type":"verse","number":2,"content":[{"text":"“Yeryüzünün bütün soyları arasından yalnız sizi seçtim.","poem":1},{"text":"Bu yüzden bütün günahlarınızın cezasını vereceğim.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İki kişi anlaşmadan","poem":1},{"text":"birlikte yürürler mi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Avı olmayan aslan","poem":1},{"text":"ormanda kükrer mi?","poem":2},{"text":"Genç aslan bir şey tutmadan","poem":1},{"text":"ininden sesini çıkarır mı?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tuzak kurulmadan","poem":1},{"text":"yerdeki kapana kuş düşer mi?","poem":2},{"text":"Bir şey yakalanmadan,","poem":1},{"text":"yerden kapan fırlar mı?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bir kentte boru çalınır da","poem":1},{"text":"halk korkmaz mı?","poem":2},{"text":"Bir kentin başına kötülük gelir de","poem":1},{"text":"Yahve onu yapmamış olur mu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gerçekten Efendi Yahve,","poem":1},{"text":"hizmetkârları peygamberlere sırrını açmadıkça hiçbir şey yapmaz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aslan kükrer de","poem":1},{"text":"kim korkmaz?","poem":2},{"text":"Efendi Yahve söyler de","poem":1},{"text":"kim peygamberlik etmez?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aşdod saraylarında,","poem":1},{"text":"ve Mısır diyarındaki saraylarda duyurun,","poem":2},{"text":"ve deyin, “Samariya dağları üzerinde toplanın,","poem":1},{"text":"ve onun içindeki kargaşayı,","poem":2},{"lineBreak":true},{"text":"ve onların arasındaki baskıyı görün.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve şöyle diyor:","poem":1},{"text":"“Gerçekten de onlar,","poem":2},{"lineBreak":true},{"text":"saraylarında ganimet ve yağma biriktirenler doğru olanı yapmayı bilmiyorlar.”","poem":2}]},{"type":"verse","number":11,"content":["Bu yüzden Efendi Yahve şöyle diyor:",{"text":"“Düşman ülkeyi istila edecek,","poem":2},{"lineBreak":true},{"text":"ve kalelerinizi yıkacak,","poem":2},{"lineBreak":true},{"text":"ve hisarlarınızı yağmalanacak.”","poem":2}]},{"type":"verse","number":12,"content":["Yahve şöyle diyor:",{"text":"“Çoban aslanın ağzından iki bacağı","poem":1},{"text":"ya da bir kulak parçasını nasıl kurtarırsa,","poem":2},{"lineBreak":true},{"text":"Samariya'da sedirin köşesinde ve yatağın ipekli yastıkları üzerinde oturan","poem":2},{"lineBreak":true},{"text":"İsrael'in çocukları da öyle kurtarılacak.”","poem":2}]},{"type":"verse","number":13,"content":["“Dinleyin ve Yakov evine karşı tanıklık edin” diyor Ordular Tanrısı Efendi Yahve."]},{"type":"verse","number":14,"content":[{"text":"“Çünkü İsrael'in suçlarını kendi üzerlerinde ziyaret ettiğim gün,","poem":1},{"text":"Beytel'in sunaklarını da ziyaret edeceğim;","poem":2},{"lineBreak":true},{"text":"ve sunağın boynuzları kesilecek,","poem":2},{"lineBreak":true},{"text":"ve yere düşecekler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kış evini yaz eviyle birlikte vuracağım;","poem":1},{"text":"ve fildişi evler yok olacak,","poem":2},{"lineBreak":true},{"text":"ve büyük evlerin sonu gelecek”","poem":2},"diyor Yahve."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}