{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"AMO","translationId":"tur_ytc","name":"AMOS","commonName":"AMOS","title":"AMOS","order":30,"numberOfChapters":9,"sha256":"fe93dd2a6703080650b1241681eaf7be0fc0b11623175b3cc0c7e5ef664b966b","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tur_ytc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Ey İsrael evi, sizin için ağıt olarak aldığım bu sözü dinleyin:"]},{"type":"verse","number":2,"content":[{"text":"“İsrael'in el değmemiş kızı düştü;","poem":1},{"text":"bir daha kalkamayacak;","poem":2},{"text":"ülkesinde yıkılmış;","poem":1},{"text":"onu kaldıracak kimse yok.”","poem":2}]},{"type":"verse","number":3,"content":["Çünkü Efendi Yahve şöyle diyor:",{"text":"“Bin kişi çıkan kentte yüz kişi kalacak,","poem":2},{"lineBreak":true},{"text":"ve yüz kişi çıkanın, İsrael evine on kişisi kalacak.”","poem":2}]},{"type":"verse","number":4,"content":["Çünkü Yahve İsrael evine şöyle diyor:",{"text":"“Beni arayın, yaşayacaksınız;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ama Beytel’i aramayın,","poem":1},{"text":"Gilgal’e girmeyin,","poem":2},{"lineBreak":true},{"text":"ve Beerşeva’ya geçmeyin;","poem":2},{"text":"çünkü Gilgal mutlaka sürgüne gidecek,","poem":1},{"text":"ve Beytel bir hiç olacak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve'yi arayın, yaşayacaksınız;","poem":1},{"text":"yoksa Yosef'in evinde bir ateş çıkar,","poem":2},{"lineBreak":true},{"text":"ve onu yakıp yok eder ve Beytel’de onu söndürecek kimse olmaz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey adaleti pelin otuna çevirenler,","poem":1},{"text":"ve doğruluğu yere atanlar!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ülker ve Orion takımyıldızlarını yaratanı,","poem":1},{"text":"ve ölüm gölgesini sabaha çevireni,","poem":2},{"lineBreak":true},{"text":"ve gündüzü geceyle karartanı,","poem":2},{"lineBreak":true},{"text":"denizin sularını çağıranı,","poem":2},{"lineBreak":true},{"text":"ve onları yeryüzüne dökeni arayın; O'nun adı Yahve'dir,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Güçlüyü ansızın yıkar, ki kalenin üzerine yıkım gelir.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kapıda azarlayandan nefret ederler,","poem":1},{"text":"ve doğrulukla konuşandan iğrenirler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bu yüzden, mademki yoksulu çiğneyip ondan buğday vergisi alıyorsunuz,","poem":1},{"text":"yontulmuş taştan evler yaptınız, ama onlarda oturmayacaksınız.","poem":2},{"text":"güzel bağlar diktiniz,","poem":1},{"text":"ama onların şarabını içmeyeceksiniz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü suçlarınızın ne kadar çok olduğunu,","poem":1},{"text":"ve günahlarınızın ne kadar büyük olduğunu biliyorum;","poem":2},{"lineBreak":true},{"text":"ey doğru kişiyi ezenler,","poem":2},{"lineBreak":true},{"text":"rüşvet alanlar,","poem":2},{"lineBreak":true},{"text":"ve mahkemelerde yoksulu kovan sizler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bu nedenle akıllı kişi böyle zamanlarda sessiz kalır,","poem":1},{"text":"çünkü zaman kötüdür.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kötülüğü değil, iyiliği arayın ki, yaşayasınız.","poem":1},{"text":"Ve böylece, söylediğiniz gibi,","poem":2},{"lineBreak":true},{"text":"Ordular Tanrısı Yahve sizinle birlikte olacaktır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kötülükten nefret edin,","poem":1},{"text":"ve iyiliği sevin ve mahkemelerde adaleti pekiştirin.","poem":2},{"lineBreak":true},{"text":"Belki Ordular Tanrısı Yahve, Yosef'in kalıntısına lütfeder.”","poem":2}]},{"type":"verse","number":16,"content":["Bu nedenle Ordular Tanrısı Efendi Yahve şöyle diyor:",{"text":"“Bütün geniş yollarda ağıt yakılacak.","poem":1},{"text":"Bütün sokaklarda, 'Ah! Ah' diye inleyecekler!","poem":2},{"lineBreak":true},{"text":"Çiftçiyi yasa,","poem":2},{"lineBreak":true},{"text":"ve ağıt yakmada usta olanları da feryada çağıracaklar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bütün bağlarda ağıt yakılacak,","poem":1},{"text":"çünkü aranızdan geçeceğim.” diyor Yahve.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Yahve'nin gününü isteyenlerin vay haline!","poem":1},{"text":"Yahve'nin gününü neden özlüyorsunuz?","poem":2},{"text":"O karanlıktır,","poem":1},{"text":"ve ışık değil.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nasıl bir adam aslandan kaçarken,","poem":1},{"text":"ayıyla karşılaşır;","poem":2},{"text":"ya da eve girip elini duvara dayar da yılan onu sokar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yahve'nin günü ışık değil, karanlık olmayacak mı?","poem":1},{"text":"Üstelik çok karanlık ve içinde hiç parıltı yok.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bayramlarınızdan nefret ediyorum, onları hor görüyorum,","poem":1},{"text":"ve kutsal toplantılarınıza dayanamıyorum.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Evet, yakmalık sunularınızı ve ekmek sunularınızı bana sunsanız bile,","poem":1},{"text":"kabul etmeyeceğim;","poem":2},{"lineBreak":true},{"text":"ve besili hayvanlarınızdan esenlik sunularına bakmayacağım.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Benden ezgilerinizin gürültüsünü uzaklaştırın!","poem":1},{"text":"Arplarınızın müziğini dinlemeyeceğim.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ama adalet ırmaklar gibi,","poem":1},{"text":"doğruluk da güçlü bir akarsu gibi aksın.”","poem":2}]},{"type":"verse","number":25,"content":["“Ey İsrael evi, çölde bana kırk yıl kurbanlar ve sunular mı getirdiniz?"]},{"type":"verse","number":26,"content":["Üstelik kralınızın çadırını, putlarınızın sandığını, kendiniz için yapmış olduğunuz ilâhınızın yıldızını taşıdınız."]},{"type":"verse","number":27,"content":["Bu yüzden sizi Damaskus'un ötesine sürgün edeceğim.” diyor Yahve, O'nun adı Ordular Tanrısı'dır."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}