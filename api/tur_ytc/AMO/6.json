{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"AMO","translationId":"tur_ytc","name":"AMOS","commonName":"AMOS","title":"AMOS","order":30,"numberOfChapters":9,"sha256":"fe93dd2a6703080650b1241681eaf7be0fc0b11623175b3cc0c7e5ef664b966b","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tur_ytc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Siyon'da kaygısız olanların,",{"text":"ve Samariya Dağı'nda güvenlikte olanların,","poem":2},{"lineBreak":true},{"text":"ulusların başının ileri gelenlerinin,","poem":2},{"lineBreak":true},{"text":"İsrael evinin kendilerine geldiği o adamların vay haline!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalne'ye gidip görün.","poem":1},{"text":"Oradan büyük Hamat'a gidin.","poem":2},{"lineBreak":true},{"text":"Sonra Filistliler'in Gat'ına inin.","poem":2},{"text":"Onlar bu krallıklardan daha mı iyiler?","poem":1},{"text":"Sınırları sizin sınırınızdan daha mı büyük?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kötü günü uzaklaştıranlar,","poem":1},{"text":"zorbalık kürsüsünü yaklaştıranlar,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"fildişi yataklar üzerinde yatanlar,","poem":1},{"text":"ve sedirler üzerinde uzananlar,","poem":2},{"lineBreak":true},{"text":"ve sürüden kuzuları,","poem":2},{"lineBreak":true},{"text":"ve ahırın içinden buzağıları alıp yiyenler,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"arpın tellerini tıngırdatanlar,","poem":1},{"text":"David gibi kendilerine müzik aletleri icat edenler,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kâselerde şarap içenler,","poem":1},{"text":"ve en iyi yağları sürünenler,","poem":2},{"lineBreak":true},{"text":"ama Yosef'in sıkıntısına üzülmeyen sizler vay halinize.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bu yüzden şimdi sürgünlerin başında sürülecekler.","poem":1},{"text":"Ziyafet çekme ve uzanma sona erecek.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Efendi Yahve kendi üzerine ant içti” diyor Ordular Tanrısı Yahve:","poem":1},{"text":"“Yakov’un gururundan nefret ediyorum,","poem":2},{"lineBreak":true},{"text":"ve kalelerinden tiksiniyorum.","poem":2},{"lineBreak":true},{"text":"Bu yüzden kenti ve içindeki her şeyi teslim edeceğim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eğer bir evde on kişi kalmışsa,","poem":1},{"text":"onlar da ölecekler.”","poem":2}]},{"type":"verse","number":10,"content":["“Bir adamın akrabası, onu yakan kişi, evden cesetleri çıkarmak için onu taşıdığında ve evin en iç tarafında olana, ‘Yanında daha var mı?’ diye sorduğunda ve o, ‘Hayır’ dediğinde; o zaman, ‘Sus! Gerçekten de Yahve'nin adını anmamalıyız.’ diyecek.”"]},{"type":"verse","number":11,"content":[{"text":"“Çünkü işte, Yahve buyuruyor, büyük ev ezilecek,","poem":1},{"text":"küçük ev de parçalanacak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Atlar kayalıklar üzerinde koşar mı?","poem":1},{"text":"Orada öküzlerle çift süren var mı?","poem":2},{"text":"Ama siz adaleti zehire,","poem":1},{"text":"doğruluğun meyvesini de acılığa çevirdiniz.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Siz hiçe sevinenler,","poem":1},{"text":"'Kendi gücümüzle kendimize boynuz almadık mı?' diyen sizler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü, işte, ben, İsrael evi, size karşı bir ulusu kaldıracağım.”","poem":1},{"text":"diyor Ordular Tanrısı Yahve;","poem":2},{"lineBreak":true},{"text":"“Ve onlar Hamat'ın girişinden Arava Vadisi'ne kadar sizi ezecekler.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}