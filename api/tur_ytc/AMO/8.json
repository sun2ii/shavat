{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"AMO","translationId":"tur_ytc","name":"AMOS","commonName":"AMOS","title":"AMOS","order":30,"numberOfChapters":9,"sha256":"fe93dd2a6703080650b1241681eaf7be0fc0b11623175b3cc0c7e5ef664b966b","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tur_ytc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Böylece Efendi Yahve bana gösterdi: İşte, bir sepet yaz meyvesi."]},{"type":"verse","number":2,"content":["“Amos, ne görüyorsun?” dedi. Ben de, “Bir sepet yaz meyvesi” dedim. O zaman Yahve bana şöyle dedi,",{"text":"“Halkım İsrael’in sonu geldi.","poem":1},{"text":"Bir daha onların yanından geçmeyeceğim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O gün tapınağınızın ezgileri ağıta dönecek.” diyor Efendi Yahve.","poem":1},{"text":"“Cesetler çok olacak. Her yerde sessizce dışarı atılacaklar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dinleyin bunu, yoksulları yutmak,","poem":1},{"text":"ve ülkenin yoksullarını mahvetmek isteyen sizler,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"şöyle diyorsunuz, ‘Ne zaman Yeni Ay geçecek de tahıl satacağız?","poem":1},{"text":"ve Şabat ne zaman geçecek ki, buğdayı pazara çıkaralım,","poem":2},{"lineBreak":true},{"text":"Efayı","poem":2},{"noteId":4},{"text":"küçültelim, şekeli","poem":2},{"noteId":5},{"text":"büyütelim, hileli terazilerle hileli işler yapalım da,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yoksulları gümüşle,","poem":1},{"text":"ve muhtaçları bir çift çarıkla satın alalım,","poem":2},{"lineBreak":true},{"text":"ve süprüntüleri buğdayla birlikte satalım?'”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve Yakov'un övüncü üzerine ant içti:","poem":1},{"text":"“Gerçekten onların işlerinden hiçbirini asla unutmayacağım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ülke bundan dolayı titremeyecek mi,","poem":1},{"text":"ve içinde oturan herkes yas tutmayacak mı?","poem":2},{"text":"Evet, ülke bütünüyle Irmak gibi yükselecek;","poem":1},{"text":"ve Mısır Irmağı gibi kabarıp yine inecek.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O gün öyle olacak ki” diyor Efendi Yahve,","poem":1},{"text":"“Öğleyin güneşi batıracağım,","poem":2},{"lineBreak":true},{"text":"ve güpegündüz yeryüzünü karartacağım.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bayramlarınızı yasa,","poem":1},{"text":"ve bütün ezgilerinizi ağıta çevireceğim;","poem":2},{"text":"ve bütün bedenlerinize çul kuşandıracağım,","poem":1},{"text":"ve her başın saçını yolduracağım.","poem":2},{"text":"Onu biricik oğul için tutulan yas gibi,","poem":1},{"text":"ve sonunu acı bir gün gibi yapacağım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İşte, günler geliyor” diyor Efendi Yahve,","poem":1},{"text":"“Ülkeye kıtlık göndereceğim;","poem":2},{"lineBreak":true},{"text":"ekmek kıtlığı değil,","poem":2},{"lineBreak":true},{"text":"ve suya susamışlık değil,","poem":2},{"lineBreak":true},{"text":"ancak Yahve'nin sözlerini duymak kıtlığı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Denizden denize,","poem":1},{"text":"ve kuzeyden doğuya kadar dolaşacaklar;","poem":2},{"lineBreak":true},{"text":"Yahve'nin sözünü aramak için oradan oraya koşacaklar,","poem":2},{"lineBreak":true},{"text":"ve bulamayacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O gün el değmemiş güzel kızlar,","poem":1},{"text":"ve genç erkekler susuzluktan bayılacaklar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Samariya günahı üzerine ant içenler,","poem":1},{"text":"'Ey Dan, senin ilâhının hayatı üzerine'","poem":2},{"lineBreak":true},{"text":"ve 'Beerşeva yolunun hayatı üzerine' diyenler","poem":2},{"lineBreak":true},{"text":"düşecek ve bir daha asla kalkamayacaklar.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"1 efa yaklaşık 22 litre veya bir kilenin yaklaşık 2/3'üdür","reference":{"chapter":8,"verse":5}},{"noteId":5,"caller":"+","text":"Normal bir şekel yaklaşık 10 gram veya 0,35 onstur.","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/tur_ytc/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}