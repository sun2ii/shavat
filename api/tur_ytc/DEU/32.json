{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"DEU","translationId":"tur_ytc","name":"YASA'NIN TEKRARI","commonName":"YASA'NIN TEKRARI","title":"YASA'NIN TEKRARI","order":5,"numberOfChapters":34,"sha256":"ce19f2c8b9aa923439cdc8b10f4b23098a96cedf23cabc3718380da00da3e390","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tur_ytc/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Ey gökler, kulak verin, konuşayım.","poem":1},{"text":"Ağzımın sözlerini yeryüzü duysun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Öğretim yağmur gibi damlayacak.","poem":1},{"text":"Sözüm düşecek, çiy gibi,","poem":2},{"lineBreak":true},{"text":"narin çimenlerin üzerindeki hafif yağmur gibi,","poem":2},{"lineBreak":true},{"text":"otların üzerindeki sağanaklar gibi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü Yahve'nin adını duyuracağım.","poem":1},{"text":"Tanrımız'a büyüklük verin!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaya: O'nun işi tamdır,","poem":1},{"text":"çünkü bütün yolları doğrudur. O haksızlık etmez,","poem":2},{"lineBreak":true},{"text":"adil ve doğru, sadık bir Tanrı'dır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O'na karşı çürük davrandılar.","poem":1},{"text":"Kusurlarından dolayı O'nun çocukları değillerdir.","poem":2},{"lineBreak":true},{"text":"Onlar sapık ve çarpık bir kuşaktır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey akılsız ve bilgelikten yoksun insanlar,","poem":1},{"text":"Yahve'ye böyle mi karşılık veriyorsunuz?","poem":2},{"lineBreak":true},{"text":"Seni satın alan Baban O değil mi?","poem":2},{"lineBreak":true},{"text":"Seni yarattı ve seni durdurdu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eski günleri hatırlayın.","poem":1},{"text":"Birçok kuşakların yıllarını düşünün.","poem":2},{"lineBreak":true},{"text":"Babana sor, o sana gösterecektir;","poem":2},{"lineBreak":true},{"text":"büyüklerine sor, onlar sana söyleyecektir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yüceler Yücesi uluslara miraslarını verdiğinde,","poem":1},{"text":"Adem'in çocuklarına ayırdığında,","poem":2},{"lineBreak":true},{"text":"halkların sınırlarını İsrael'in çocuklarının sayısına göre belirledi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü Yahve'nin payı kendi halkıdır.","poem":1},{"text":"Yakov O'nun mirasının hissesidir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onu kurak bir diyarda,","poem":1},{"text":"uluyan bir çölde buldu.","poem":2},{"lineBreak":true},{"text":"Onun çevresini sardı.","poem":2},{"lineBreak":true},{"text":"Onunla ilgilendi.","poem":2},{"lineBreak":true},{"text":"Onu kendi gözbebeği gibi korudu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yuvasını harekete geçiren,","poem":1},{"text":"yavrularının üzerinde kanat çırpan bir kartal gibi,","poem":2},{"lineBreak":true},{"text":"kanatlarını açtı, onları aldı,","poem":2},{"lineBreak":true},{"text":"onları kanatları üzerinde taşıdı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ona yalnızca Yahve önderlik etti.","poem":1},{"text":"Yanında yabancı bir ilâh yoktu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onu yeryüzünün yüksek yerlerine bindirdi.","poem":1},{"text":"Tarlanın ürününü yedi.","poem":2},{"lineBreak":true},{"text":"Ona kayadan bal, çakmaktaşından yağ emdirdi;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kuzuların yağıyla","poem":1},{"text":"sürünün tereyağını, koyunların sütünü,","poem":2},{"lineBreak":true},{"text":"buğdayın en iyisiyle,","poem":2},{"lineBreak":true},{"text":"başan cinsi koçları ve keçileri yedin.","poem":2},{"lineBreak":true},{"text":"Üzümün kanından şarap içtin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ama Yeşurun şişmanladı ve tekmeledi.","poem":1},{"text":"Sen şişmanladın. Sen kalınlaştın. Sen gösterişli oldun.","poem":2},{"lineBreak":true},{"text":"Sonra kendisini yaratan Tanrı'yı terk etti,","poem":2},{"lineBreak":true},{"text":"kurtuluşunun Kayası'nı reddetti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onu yabancı ilâhlarla kıskandırdılar.","poem":1},{"text":"İğrenç şeylerle O'nu öfkelendirdiler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanrı'ya değil iblislere,","poem":1},{"text":"bilmedikleri ilâhlara, atalarınızın korkmadığı,","poem":2},{"lineBreak":true},{"text":"son zamanlarda ortaya çıkan yeni ilâhlara kurban kestiler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Baban olan Kaya'yı aklından çıkardın,","poem":1},{"text":"seni dünyaya getiren Tanrı'yı unuttun.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahve, oğullarının ve kızlarının kışkırtmalarını gördü,","poem":1},{"text":"tiksindi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Yüzümü onlardan gizleyeceğim” dedi.","poem":1},{"text":"“Bakalım sonları ne olacak;","poem":2},{"lineBreak":true},{"text":"çünkü onlar çok sapkın bir kuşaktır,","poem":2},{"lineBreak":true},{"text":"kendilerinde sadakat bulunmayan çocuklardır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Beni Tanrı olmayanla kıskandırdılar.","poem":1},{"text":"Kibirleriyle beni öfkelendirdiler.","poem":2},{"lineBreak":true},{"text":"Ben de onları halk olmayanlarla kıskandıracağım.","poem":2},{"lineBreak":true},{"text":"Akılsız bir ulusla onları öfkelendireceğim.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü öfkemde,","poem":1},{"text":"Şeol'ün","poem":2},{"noteId":13},{"text":"en dibine kadar yanan bir ateş alevlendi,","poem":2},{"lineBreak":true},{"text":"ürünüyle yeryüzünü yiyip bitiriyor,","poem":2},{"lineBreak":true},{"text":"dağların temellerini ateşe veriyor.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Üzerlerine kötülükler yığacağım.","poem":1},{"text":"Oklarımı onların üzerinde tüketeceğim.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Açlıkla telef olacaklar,","poem":1},{"text":"Yakıcı ateşle ve acı yıkımla yenilip bitirilecekler.","poem":2},{"lineBreak":true},{"text":"Toprakta sürünen engerek zehiriyle birlikte,","poem":2},{"lineBreak":true},{"text":"hayvanların dişlerini üzerlerine göndereceğim.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hem genci, hem el değmemiş kızı, emzikteki çocukla, ak saçlı adamı,","poem":1},{"text":"dışarıda kılıç, içeride dehşet yok edecek.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Düşmanlar yanlış hüküm vermesinler,","poem":1},{"text":"'Bütün bunları yapan Yahve değildir,","poem":2},{"lineBreak":true},{"text":"bizim elimiz üstün geldi', demesinler diye,","poem":2},{"lineBreak":true},{"text":"düşmanın kışkırtmasından korkmasaydım;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Derdim: Onları uzaklara dağıtacağım,","poem":1},{"text":"insanlar arasından onların anısına son vereceğim'”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Çünkü onlar öğütten yoksun bir ulustur.","poem":1},{"text":"Onlarda anlayış yoktur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Keşke bilge olsalardı, bunu anlasalardı,","poem":1},{"text":"sonlarını da düşünselerdi!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kayaları onları satmış olmasaydı,","poem":1},{"text":"Yahve onları teslim etmiş olmasaydı,","poem":2},{"lineBreak":true},{"text":"nasıl biri bin kişiyi kovalardı ikisi de on bin kişiyi kaçırırdı?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Çünkü onların kayası bizim Kayamız gibi değil,","poem":1},{"text":"düşmanlarımız bile bunu kabul ediyor.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Çünkü onların asması Gomora kırlarındaki,","poem":1},{"text":"Sodom asmasındandır.","poem":2},{"lineBreak":true},{"text":"Üzümleri zehirli üzümdür. Salkımları acıdır.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Onların şarabı yılanların zehiri,","poem":1},{"text":"engereklerin zalim zehiridir.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"“Bu, hazinelerimin arasında mühürlenmiş,","poem":1},{"text":"yanımda saklı değil mi?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Öç benimdir ve ayaklarının kaydığı zaman karşılık veririm;","poem":1},{"text":"çünkü onların felaket günü yakındır.","poem":2},{"lineBreak":true},{"text":"Onların hükmü hızla onlara doğru geliyor.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Çünkü Yahve kendi halkını yargılayacak,","poem":1},{"text":"hizmetkârlarının gücünün tükendiğini,","poem":2},{"lineBreak":true},{"text":"kimsenin kalmadığını,","poem":2},{"lineBreak":true},{"text":"kapalı ya da serbest kimsenin kalmadığını görünce,","poem":2},{"lineBreak":true},{"text":"onlara acıyacaktır.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"O şöyle diyecek:","poem":1},{"text":"“Kurbanlarının yağını yiyen ve dökmelik sunu şarabını içen,","poem":2},{"lineBreak":true},{"text":"sığındıkları kaya olan ilâhları nerede?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kalkıp size yardım etsinler!","poem":1},{"text":"Onlar sizin korumanız olsun.”","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Bakın, şimdi ben, ben O'yum.","poem":1},{"text":"Yanımda başka ilâh yoktur. Ben öldürür ve ben yaşatırım.","poem":2},{"lineBreak":true},{"text":"Ben yaralar ve ben iyileştiririm.","poem":2},{"lineBreak":true},{"text":"Elimden kurtarabilecek kimse yoktur.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Çünkü elimi göğe kaldırıyorum,","poem":1},{"text":"ebedi varlığımın hakkı için şunu ilan ediyorum:","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Işıltılı kılıcımı bilersem,","poem":1},{"text":"Elim yargıda onu kavrarsa;","poem":2},{"lineBreak":true},{"text":"düşmanlarımdan öç alacağım,","poem":2},{"lineBreak":true},{"text":"benden nefret edenlere karşılığını vereceğim.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Oklarımı kanla sarhoş edeceğim.","poem":1},{"text":"Kılıcım, düşman önderlerinin başıyla,","poem":2},{"lineBreak":true},{"text":"öldürülmüş olanların ve esirlerin kanıyla et yiyecek.”","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ey, siz uluslar, O'nun halkıyla birlikte sevinin;","poem":1},{"text":"çünkü hizmetkârlarının kanının öcünü alacak.","poem":2},{"lineBreak":true},{"text":"Düşmanlarından öç alacak ve diyarı ve halkı için kefaret edecektir.","poem":2},{"noteId":14}]},{"type":"verse","number":44,"content":["Moşe Nun oğlu Yeşu ile geldi ve bu ezginin bütün sözlerini insanların kulaklarına söyledi."]},{"type":"verse","number":45,"content":["Moşe bu sözlerin tümünü bütün İsrael'e söylemeyi bitirdi."]},{"type":"verse","number":46,"content":["Onlara, “Bugün size tanıklık ettiğim, çocuklarınıza bu yasanın tüm sözlerini tutup yapmaya buyuracağınız bütün sözlere yüreğinizi koyun."]},{"type":"verse","number":47,"content":["Çünkü bu sizin için boş bir şey değildir, çünkü bu sizin yaşamınızdır, mülk edinmek için Yarden üzerinden geçmekte olduğunuz ülkede bununla günleriniz uzayacaktır.”"]},{"type":"verse","number":48,"content":["Yahve, aynı gün Moşe'ye konuşup dedi,"]},{"type":"verse","number":49,"content":["“Yeriha karşısında, Moav ülkesinde olan bu Avarim dağına, Nebo Dağı'na çık; mülk olarak İsrael'in çocuklarına vermekte olduğum Kenan diyarını gör."]},{"type":"verse","number":50,"content":["Kardeşin Aron Hor Dağı'nda ölüp halkına kavuştuğu gibi, sen de çıkmakta olduğun dağda öl ve halkına kavuş;"]},{"type":"verse","number":51,"content":["çünkü Zin Çölü'nde, Kadeş Meriva sularında, İsrael'in çocukları arasında bana karşı günah işlediniz; çünkü İsrael'in çocukları arasında kutsallığımı yukarıda tutmadınız."]},{"type":"verse","number":52,"content":["Ülkeyi uzaktan göreceksin; ama oraya İsrael'in çocuklarına vermekte olduğum diyara girmeyeceksin.”"]}],"footnotes":[{"noteId":13,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":32,"verse":22}},{"noteId":14,"caller":"+","text":"Bu ayet için LXX'te şöyle denmektedir: Ey gökler, onunla birlikte sevinin, ve Tanrı'nın bütün melekleri O'na tapınsın; ey uluslar, O'nun halkıyla birlikte sevinin, ve Tanrı oğullarının hepsi O'nda kendilerini güçlendirsinler; çünkü oğullarının kanının öcünü alacak, ve öç alacak, ve düşmanlarına adaleti sağlayacak, ve kendisinden nefret edenleri ödüllendirecek; ve Efendi, memleketi halkından temizleyecektir.","reference":{"chapter":32,"verse":43}}]},"thisChapterLink":"/api/tur_ytc/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}