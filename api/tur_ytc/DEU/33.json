{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"DEU","translationId":"tur_ytc","name":"YASA'NIN TEKRARI","commonName":"YASA'NIN TEKRARI","title":"YASA'NIN TEKRARI","order":5,"numberOfChapters":34,"sha256":"ce19f2c8b9aa923439cdc8b10f4b23098a96cedf23cabc3718380da00da3e390","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tur_ytc/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":["Bu, Tanrı adamı Moşe'nin ölümünden önce İsrael'in çocuklarına söylediği kutsama sözleridir."]},{"type":"verse","number":2,"content":["Şöyle dedi,",{"text":"“Yahve Sina'dan geldi, Seir'den onlara yükseldi.","poem":1},{"text":"Paran Dağı'ndan parladı.","poem":2},{"text":"On binlerce kutsalıyla geldi.","poem":1},{"text":"Sağ elinde onlar için ateşli bir yasa vardı.","poem":2},{"noteId":15}]},{"type":"verse","number":3,"content":[{"text":"Evet, halkları sever.","poem":1},{"text":"Bütün kutsalları senin elindedir.","poem":2},{"lineBreak":true},{"text":"Ayaklarının dibinde oturdular.","poem":2},{"lineBreak":true},{"text":"Her biri sözlerini kabul eder.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moşe bize bir yasa buyurdu,","poem":1},{"text":"Yakov'un topluluğu için bir miras.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İsrael'in bütün oymaklarıyla birlikte,","poem":1},{"text":"halkın başları toplandığı zaman,","poem":2},{"lineBreak":true},{"text":"Yeşurun'da O kraldı.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ruven yaşasın ve ölmesin;","poem":1},{"text":"adamları sayıca az olmasın.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahuda için budur dedi,","poem":1},{"text":"“Ey Yahve, Yahuda'nın sesini duy.","poem":2},{"lineBreak":true},{"text":"Onu halkının içine getir.","poem":2},{"lineBreak":true},{"text":"Elleriyle kendisi için uğraştı.","poem":2},{"lineBreak":true},{"text":"Düşmanlarına karşı yardımı sen olacaksın.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Levi hakkında şöyle dedi,","poem":1},{"text":"“Tummim'in ve Urim'in Tanrısal olanladır,","poem":2},{"lineBreak":true},{"text":"Massa'da onu denedin,","poem":2},{"lineBreak":true},{"text":"Meriva sularında onunla çekiştin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Babası ve annesi hakkında 'Onu görmedim' dedi.","poem":1},{"text":"Kardeşlerini tanımadı ve kendi çocuklarını bilmedi;","poem":2},{"lineBreak":true},{"text":"çünkü senin sözünü tuttular ve antlaşmanı korumaktalar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yakov'a ilkelerini,","poem":1},{"text":"İsrael'e yasanı öğretecekler.","poem":2},{"lineBreak":true},{"text":"Senin önünde buhur,","poem":2},{"lineBreak":true},{"text":"sunağının üzerine bütün yakmalık sunuyu koyacaklar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve onun becerilerini kutsa.","poem":1},{"text":"Ellerinin işini kabul et.","poem":2},{"lineBreak":true},{"text":"Ona karşı ayaklananların ve ondan nefret edenlerin,","poem":2},{"lineBreak":true},{"text":"yeniden kalkmasınlar diye kalçalarından vur.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Benyamin hakkında şöyle dedi,","poem":1},{"text":"“Yahve'nin sevgilisi O'nun yanında güvende oturacaktır.","poem":2},{"lineBreak":true},{"text":"Onu bütün gün boyunca örter.","poem":2},{"lineBreak":true},{"text":"O'nun omuzları arasında oturur.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yosef hakkında şöyle dedi,","poem":1},{"text":"“Diyarı Yahve tarafından, göklerin değerli şeyleriyle,","poem":2},{"lineBreak":true},{"text":"çiyle, altında yatan derinlikle,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"güneş ürününün değerli şeyleriyle,","poem":1},{"text":"ayların verdiği değerli şeylerle,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kadim dağların en iyi şeyleriyle,","poem":1},{"text":"Sonsuz tepelerin değerli şeyleriyle,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"yeryüzünün değerli şeyleriyle ve onun doluluğuyla,","poem":1},{"text":"çalıda","poem":2},{"noteId":16},{"text":"yaşayanın iyiliğiyle kutsansın.","poem":2},{"lineBreak":true},{"text":"Bunlar Yosef'in başı üzerine,","poem":2},{"lineBreak":true},{"text":"kardeşlerinden ayrı olanın başının tacı üzerine gelsin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Heybet, sürüsünün ilk doğanına aittir.","poem":1},{"text":"Onun boynuzları yaban öküzünün boynuzlarıdır.","poem":2},{"lineBreak":true},{"text":"Onlarla bütün halkları dünyanın uçlarına itecek.","poem":2},{"lineBreak":true},{"text":"Onlar Efraim'in on binleridir. Onlar Manaşe'nin binleridir.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zevulun hakkında şöyle dedi,","poem":1},{"text":"“Ey Zevulun, dışarı çıkışınla,","poem":2},{"lineBreak":true},{"text":"ey İssakar çadırlarında sevinin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Onlar halkları dağa çağıracaklar.","poem":1},{"text":"Orada doğruluk kurbanları sunacaklar,","poem":2},{"lineBreak":true},{"text":"çünkü denizlerin bolluğunu, kumun gizli hazinelerini çıkaracaklar.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gad hakkında şöyle dedi,","poem":1},{"text":"“Gad'ı genişleten kutsanmıştır.","poem":2},{"lineBreak":true},{"text":"Dişi aslan gibi oturuyor,","poem":2},{"lineBreak":true},{"text":"kolu da başın tacını da parçalar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kendisi için ilk parçayı sağladı,","poem":1},{"text":"çünkü kanun koyanın payı onun için ayrıldı.","poem":2},{"text":"Halkının başlarıyla geldi.","poem":1},{"text":"Yahve'nin doğruluğunu ve O'nun ilkelerini,","poem":2},{"lineBreak":true},{"text":"İsrael'le birlikte yerine getirdi.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dan hakkında şöyle dedi,","poem":1},{"text":"“Dan, Başan'dan sıçrayan bir aslan yavrusudur.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naftali hakkında şöyle dedi,","poem":1},{"text":"“Ey Naftali, lütufla doygundur,","poem":2},{"lineBreak":true},{"text":"Yahve'nin bereketiyle dolu,","poem":2},{"lineBreak":true},{"text":"batıyı ve güneyi mülk edin.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Aşer hakkında şöyle dedi,","poem":1},{"text":"“Aşer çocuklarla kutsanmıştır.","poem":2},{"lineBreak":true},{"text":"Kardeşleri tarafından kabul görsün.","poem":2},{"lineBreak":true},{"text":"Ayağını yağa batırsın.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sürgülerin demir ve tunç olacaktır.","poem":1},{"text":"Günlerin gibi, gücün öyle olacak.”","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“Ey Yeşurun, sana yardım için göklere,","poem":1},{"text":"haşmetiyle gökyüzüne binen Tanrı gibisi yoktur.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ebedi Tanrı senin konutundur.","poem":1},{"text":"Altında olan ebedi kollardır.","poem":2},{"lineBreak":true},{"text":"Düşmanı senin önünden itti ve 'Harap et!' dedi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"İsrael, tahıl ve yeni şarap ülkesinde,","poem":1},{"text":"yalnızca Yakov'un pınarı güvenlikte oturuyor.","poem":2},{"lineBreak":true},{"text":"Evet, O'nun gökleri çiy damlatıyor.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mutlusun, ey İsrael!","poem":1},{"text":"Senin gibi, yardımının kalkanı,","poem":2},{"lineBreak":true},{"text":"haşmetinin kılıcı olan,","poem":2},{"lineBreak":true},{"text":"Yahve tarafından kurtarılan bir halk var mı?","poem":2},{"text":"Düşmanların kendilerini sana teslim edecekler.","poem":1},{"text":"Onların yüksek yerlerine basacaksın.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Başka bir el yazmasında ise “Güneyden, dağ yamaçlarından binlerce kutsalıyla geldi.” yazıyor.","reference":{"chapter":33,"verse":2}},{"noteId":16,"caller":"+","text":"yani Çıkış 3:3-4'teki yanan çalı.","reference":{"chapter":33,"verse":16}}]},"thisChapterLink":"/api/tur_ytc/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}