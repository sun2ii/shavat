{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ECC","translationId":"tur_ytc","name":"VAİZ","commonName":"VAİZ","title":"VAİZ","order":21,"numberOfChapters":12,"sha256":"c64069c1251b5c6f059911e91f79c247f4bae056151c30b330bbb640806d176a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tur_ytc/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Kötü günler gelmeden,","poem":1},{"text":"“Onlardan zevk almıyorum” diyeceğin yıllar yaklaşmadan,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"güneş, ışık, ay ve yıldızlar kararmadan","poem":1},{"text":"ve yağmurdan sonra bulutlar geri dönmeden,","poem":2},{"lineBreak":true},{"text":"gençliğinin günlerinde seni Yaratanı hatırla;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"o gün evi bekleyenler titreyecek,","poem":1},{"text":"güçlü adamlar eğilecek,","poem":2},{"lineBreak":true},{"text":"öğütücüler az olduğu için duracak,","poem":2},{"lineBreak":true},{"text":"pencerelerden bakanlar kararacak,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"değirmen sesi alçalınca,","poem":1},{"text":"sokak kapıları kapanacak,","poem":2},{"lineBreak":true},{"text":"biri kuş sesine kalkacak,","poem":2},{"lineBreak":true},{"text":"bütün müzik kızlarının sesi kesilecek;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"evet, yükseklerden korkacaklar","poem":1},{"text":"yolda dehşetler olacak;","poem":2},{"lineBreak":true},{"text":"badem ağacı çiçek açacak,","poem":2},{"lineBreak":true},{"text":"çekirge yük olacak,","poem":2},{"lineBreak":true},{"text":"arzu zayıflayacak;","poem":2},{"lineBreak":true},{"text":"çünkü insan kendi ebedî evine gidiyor,","poem":2},{"lineBreak":true},{"text":"yas tutanlar da sokaklarda dolaşacak;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"gümüş kordon kopmadan,","poem":1},{"text":"ya da altın tas kırılmadan,","poem":2},{"lineBreak":true},{"text":"ya da testi pınarda parçalanmadan,","poem":2},{"lineBreak":true},{"text":"ya da sarnıçta makara kırılmadan,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"toprak yere, eski haline dönmeden","poem":1},{"text":"ve ruh onu veren Tanrı'ya dönmeden,","poem":2},{"lineBreak":true},{"text":"seni yaratanı hatırla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Boşların boşu. Her şey boş!” diyor Vaiz.","poem":1}]},{"type":"verse","number":9,"content":["Üstelik, Vaiz bilge olduğu için halka hâlâ bilgi öğretti. Evet, düşündü, araştırdı ve birçok özdeyişleri sıraya koydu."]},{"type":"verse","number":10,"content":["Vaiz, uygun sözleri ve kusursuzca yazılmış olanı, gerçeğin sözlerini bulmaya çalıştı."]},{"type":"verse","number":11,"content":["Bilgelerin sözleri üvendire gibidir; topluluk ustalarının sözleri iyi çakılmış çiviler gibidir, bir Çoban tarafından verilmişlerdir."]},{"type":"verse","number":12,"content":["Üstelik, oğlum, sakın: Çok kitap yapmanın sonu yoktur; çok okuma beden yorgunluğudur."]},{"type":"verse","number":13,"content":["İşte meselenin hepsi budur. Her şey duyuldu. Tanrı'dan kork ve buyruklarını tut; çünkü insanın bütün görevi budur."]},{"type":"verse","number":14,"content":["Çünkü Tanrı her gizli şeyle birlikte her işi, ister iyi olsun, ister kötü olsun, yargıya getirecektir."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}