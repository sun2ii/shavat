{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"EZK","translationId":"tur_ytc","name":"HEZEKİEL","commonName":"HEZEKİEL","title":"HEZEKİEL","order":26,"numberOfChapters":48,"sha256":"9ee100d264390b57fc9647fbf04e3f7d6164b1599fc37c1738d0447567a2aa36","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tur_ytc/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["“İsrael beyleri için de ağıt yak."]},{"type":"verse","number":2,"content":["ve de,",{"text":"‘Annen neydi?","poem":1},{"text":"Dişi bir aslan.","poem":2},{"text":"Aslanlar arasında yatar,","poem":1},{"text":"genç aslanların ortasında yavrularını beslerdi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yavrularından birini büyüttü.","poem":1},{"text":"Genç bir aslan oldu.","poem":2},{"text":"Avını yakalamayı öğrendi.","poem":1},{"text":"İnsanları yedi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uluslar da onun hakkında duydu.","poem":1},{"text":"Onların çukurlarında tutuldu;","poem":2},{"lineBreak":true},{"text":"ve onu kancalarla Mısır diyarına getirdiler.'”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“‘Şimdi boş yere beklediğini,","poem":1},{"text":"ve umudunun kaybolduğunu görünce,","poem":2},{"text":"o zaman yavrularından birini daha aldı,","poem":1},{"text":"ve onu genç bir aslan yaptı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aslanlar arasında yukarı aşağı dolaştı.","poem":1},{"text":"Genç bir aslan oldu.","poem":2},{"text":"Avını yakalamayı öğrendi.","poem":1},{"text":"İnsanları yedi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onların saraylarını biliyordu,","poem":1},{"text":"ve kentlerini harap etti.","poem":2},{"text":"Kükremesinin gürültüsünden dolayı","poem":1},{"text":"ülke tümüyle ıssız kaldı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O zaman uluslar illerden her yandan ona saldırdılar.","poem":1},{"text":"Onun üzerine ağlarını serptiler.","poem":2},{"lineBreak":true},{"text":"Onların çukurunda tutuldu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onu kancalı bir kafese koyup","poem":1},{"text":"Babil Kralı'na getirdiler.","poem":2},{"text":"İsrael dağlarında sesi bir daha duyulmasın diye","poem":1},{"text":"onu kalelerin içine getirdiler.'”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'“Annen kanında suların kıyısına dikilmiş bir asma gibiydi.","poem":1},{"text":"Bol sulardan dolayı verimli ve çok dallıydı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hükmedenlerin asaları için güçlü dalları vardı.","poem":1},{"text":"Boyları sık dallar arasında yükseliyordu.","poem":2},{"text":"Dallarının çokluğuyla kendi yüksekliğinde görünüyordu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ama öfkeyle söküldü.","poem":1},{"text":"Yere atıldı.","poem":2},{"text":"Ve doğu rüzgârı onun meyvesini kuruttu.","poem":1},{"text":"Güçlü dalları koparıldı ve kurudu.","poem":2},{"lineBreak":true},{"text":"Ateş onları yiyip bitirdi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Şimdi çölde,","poem":1},{"text":"kurak ve susuz bir diyarda dikildi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ateş onun dallarından çıktı.","poem":1},{"text":"Meyvesini yedi,","poem":2},{"lineBreak":true},{"text":"öyle ki içinde hükmetmek için bir asa olacak güçlü bir dal kalmadı.'","poem":2},"Bu bir ağıttır ve ağıt olarak kalacaktır.”"]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}