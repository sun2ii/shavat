{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"EZK","translationId":"tur_ytc","name":"HEZEKİEL","commonName":"HEZEKİEL","title":"HEZEKİEL","order":26,"numberOfChapters":48,"sha256":"9ee100d264390b57fc9647fbf04e3f7d6164b1599fc37c1738d0447567a2aa36","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tur_ytc/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["Yahve'nin sözü bana yine geldi ve şöyle dedi:"]},{"type":"verse","number":2,"content":["“Ey insanoğlu, Sur hükümdarına de, ‘Efendi Yahve şöyle diyor:",{"text":"“Çünkü yüreğin yükseldi,","poem":1},{"text":"ve ‘Ben ilâhım,","poem":2},{"text":"Tanrı'nın tahtında,","poem":1},{"text":"denizlerin ortasında oturuyorum’ dedin;","poem":2},{"text":"ancak sen insansın, ilâh değilsin,","poem":1},{"text":"yüreğini bir ilâh yüreği gibi yapmış olsan da—","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İşte, Daniel'den daha bilgesin.","poem":1},{"text":"Senden saklı hiçbir sır yoktur.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bilgeliğin ve anlayışınla kendine servet kazandın,","poem":1},{"text":"hazinelerine altın ve gümüş koydun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Büyük bilgeliğin","poem":1},{"text":"ve ticaretinle servetini artırdın,","poem":2},{"lineBreak":true},{"text":"zenginliğinden ötürü yüreğin yükseldi—”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“'Bu yüzden Efendi Yahve şöyle diyor:","poem":1},{"text":"“Çünkü yüreğini Tanrı'nın yüreği gibi yaptın,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bu yüzden, işte, yabancıları,","poem":1},{"text":"ulusların korkunçlarını senin üzerine getireceğim.","poem":2},{"text":"Bilgeliğinin güzelliğine karşı kılıçlarını çekecekler.","poem":1},{"text":"Senin parlaklığını kirletecekler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Seni çukura indirecekler.","poem":1},{"text":"Denizlerin yüreğinde sen öldürülenlerin ölümüyle öleceksin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Seni öldürenin önünde, ‘Ben Tanrı'yım’ mı diyeceksin?","poem":1},{"text":"Ama seni yaralayanın elinde,","poem":2},{"lineBreak":true},{"text":"sen insansın, Tanrı değil.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yabancıların eliyle,","poem":1},{"text":"sünnetsizlerin ölümüyle öleceksin;","poem":2},{"lineBreak":true},{"text":"çünkü bunu ben söyledim.” diyor Efendi Yahve.'”","poem":2}]},{"type":"verse","number":11,"content":["Ve Yahve'nin sözü bana geldi ve şöyle dedi:"]},{"type":"verse","number":12,"content":["“Ey insanoğlu, Sur Kralı için ağıt yak ve ona de, 'Efendi Yahve şöyle diyor:",{"text":"“Sen tam ölçünün mührüydün,","poem":1},{"text":"bilgelikle doluydun,","poem":2},{"lineBreak":true},{"text":"ve güzellikte kusursuzdun.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sen Tanrı'nın bahçesinde,","poem":1},{"text":"Aden'deydin.","poem":2},{"text":"Seni yakut, topaz, zümrüt, sarı yakut, oniks,","poem":1},{"text":"yeşim, safir,","poem":2},{"noteId":14},{"text":"turkuaz ve beril gibi","poem":2},{"lineBreak":true},{"text":"her türlü değerli taş süslüyordu.","poem":2},{"text":"Teflerin ve kavalların altın işçiliği sendeydi.","poem":1},{"text":"Bunlar yaratıldığın gün hazırlandı.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sen meshedilmiş koruyucu bir Keruv'dun.","poem":1},{"text":"O zaman seni Tanrı'nın kutsal dağına yerleştirdim.","poem":2},{"lineBreak":true},{"text":"Ateş taşlarının arasında aşağı yukarı yürüdün.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaratıldığın günden beri,","poem":1},{"text":"sende haksızlık bulunana dek yollarında kusursuzdun.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ticaretinin bolluğundan dolayı,","poem":1},{"text":"için zorbalıkla doldu","poem":2},{"lineBreak":true},{"text":"ve günah işledin.","poem":2},{"text":"Bu yüzden kirli şey gibi seni Tanrı'nın dağından attım.","poem":1},{"text":"Ey koruyucu Keruv,","poem":2},{"lineBreak":true},{"text":"ateş taşlarının arasından seni harap ettim.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Güzelliğinden ötürü yüreğin yükseldi.","poem":1},{"text":"Parlaklığından ötürü bilgeliğini bozdun.","poem":2},{"text":"Seni yere attım.","poem":1},{"text":"Seni görsünler diye kralların önüne koydum.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kötülüklerinin çokluğuyla,","poem":1},{"text":"ticaretinin haksızlığıyla,","poem":2},{"lineBreak":true},{"text":"kutsal yerlerini kirlettin.","poem":2},{"text":"Bu yüzden senin içinden ateş çıkardım.","poem":1},{"text":"Seni yiyip bitirdi.","poem":2},{"text":"Seni gören herkesin gözü önünde,","poem":1},{"text":"seni yeryüzünde küle çevirdim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Halklar arasında seni tanıyanların hepsi sana şaşacak.","poem":1},{"text":"Sen bir dehşet oldun,","poem":2},{"lineBreak":true},{"text":"artık yok olacaksın.\"”'","poem":2}]},{"type":"verse","number":20,"content":["Yahve'nin sözü bana geldi ve şöyle dedi:"]},{"type":"verse","number":21,"content":["“Ey insanoğlu, yüzünü Sayda'ya çevir ve ona karşı peygamberlik et."]},{"type":"verse","number":22,"content":["Ve de, ‘Efendi Yahve şöyle diyor:",{"text":"“İşte, sana karşıyım, ey Sayda.","poem":1},{"text":"Senin içinde yüceltileceğim.","poem":2},{"text":"O zaman, onun içinde yargılarımı yerine getirdiğimde,","poem":1},{"text":"ve onun içinde kutsal kılındığımda,","poem":2},{"lineBreak":true},{"text":"benim Yahve olduğumu bilecekler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü onun içine salgın hastalık,","poem":1},{"text":"sokaklarına kan göndereceğim.","poem":2},{"text":"Her yanından onun üzerindeki kılıçla","poem":1},{"text":"Yaralılar içinde düşecek.","poem":2},{"lineBreak":true},{"text":"O zaman benim Yahve olduğumu bilecekler.”'”","poem":2}]},{"type":"verse","number":24,"content":["“‘“İsrael evinin çevrelerinde olup onları küçümseyenlerin hiç birinden bir daha onlara batan bir çalı ve acıtan bir diken kalmayacak. O zaman benim Efendi Yahve olduğumu bilecekler.\"”'"]},{"type":"verse","number":25,"content":["“‘Efendi Yahve şöyle diyor: “İsrael evini, aralarına dağılmış oldukları halklardan topladığımda ve ulusların gözü önünde aralarında kutsallığımı gösterdiğimde, hizmetkârım Yakov'a vermiş olduğum kendi ülkelerinde oturacaklar."]},{"type":"verse","number":26,"content":["Orada güvenlik içinde oturacaklar. Evet, evler bina edecekler, bağlar dikecekler ve etraflarında onları küçümseyenlerin hepsini cezalandırdığımda güvenlik içinde oturacaklar. O zaman benim Tanrıları Yahve olduğumu bilecekler.\"”'"]}],"footnotes":[{"noteId":14,"caller":"+","text":"veya lapis lazuli","reference":{"chapter":28,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}