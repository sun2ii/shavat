{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"EZK","translationId":"tur_ytc","name":"HEZEKİEL","commonName":"HEZEKİEL","title":"HEZEKİEL","order":26,"numberOfChapters":48,"sha256":"9ee100d264390b57fc9647fbf04e3f7d6164b1599fc37c1738d0447567a2aa36","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tur_ytc/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Yahve'nin sözü bana yine geldi ve şöyle dedi:"]},{"type":"verse","number":2,"content":["“Ey insanoğlu, peygamberlik et ve de, ‘Efendi Yahve şöyle diyor:",{"text":"“'Ah o gün!' diye feryat edin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünkü gün yakındır,","poem":1},{"text":"Yahve'nin günü yakındır.","poem":2},{"text":"Bulutlar günü,","poem":1},{"text":"ulusların zamanı olacak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mısır'ın üzerine kılıç gelecek,","poem":1},{"text":"ve Etiyopya'da sıkıntı olacak,","poem":2},{"lineBreak":true},{"text":"Mısır'da öldürülenler düştüğünde.","poem":2},{"text":"Onun kalabalığını alıp götürecekler,","poem":1},{"text":"ve onun temelleri yıkılacak.\"”'","poem":2}]},{"type":"verse","number":5,"content":["““'Onlarla birlikte Etiyopya, Put, Lud, bütün karışık halk, Kub ve onlarla müttefik olan ülke çocukları kılıçla düşecekler.\"”'"]},{"type":"verse","number":6,"content":["“‘Yahve şöyle diyor:",{"text":"“Mısır'ı destekleyenler de düşecek.","poem":1},{"text":"Gücünün övünçü aşağı inecek.","poem":2},{"text":"Sevene Kulesi'nden ötesi kılıçla düşecekler.”","poem":1},{"text":"Diyor Efendi Yahve.”'","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Issız kalmış ülkeler arasında ıssız kalacaklar.","poem":1},{"text":"Onun kentleri harap olmuş kentler arasında olacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mısır'ı ateşe verdiğimde,","poem":1},{"text":"ve bütün yardımcıları yok olduğunda,","poem":2},{"lineBreak":true},{"text":"benim Yahve olduğumu bilecekler.”","poem":2}]},{"type":"verse","number":9,"content":["“‘“O gün, kaygısız Etiyopyalılar'ı korkutmak için gemilerle haberciler önümden çıkacaklar. Mısır gününde olduğu gibi, üzerlerinde sıkıntı olacak; çünkü işte, geliyor.\"”'"]},{"type":"verse","number":10,"content":["“‘Efendi Yahve şöyle diyor:",{"text":"“Mısır'ın kalabalığını da","poem":1},{"text":"Babil Kralı Nebukadnetsar'ın eliyle sona erdireceğim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O ve onunla birlikte olan halkını,","poem":1},{"text":"ulusların korkunçları, ülkeyi yok etmek için getirilecek.","poem":2},{"text":"Mısır'a karşı kılıçlarını çekecekler,","poem":1},{"text":"ve ülkeyi öldürülenlerle dolduracaklar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Irmakları kurutacağım,","poem":1},{"text":"ve ülkeyi kötü adamların eline satacağım.","poem":2},{"text":"Yabancıların eliyle ülkeyi,","poem":1},{"text":"ve içindekilerin hepsini harap edeceğim.","poem":2},{"lineBreak":true},{"text":"Bunu ben, Yahve söyledim.\"”'","poem":2}]},{"type":"verse","number":13,"content":["“'Efendi Yahve şöyle diyor:",{"text":"“Putları da yok edeceğim,","poem":1},{"text":"Memfis'ten suretleri de kaldırıp atacağım.","poem":2},{"text":"Mısır diyarından bir daha kimse bey olmayacak.","poem":1},{"text":"Mısır diyarına korku salacağım.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Patros'u harap edeceğim,","poem":1},{"text":"Soan'ı ateşe vereceğim,","poem":2},{"lineBreak":true},{"text":"No'yu cezalandıracağım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gazabımı Mısır'ın kalesi Sin'in üzerine dökeceğim.","poem":1},{"text":"No'nun kalabalığını kesip atacağım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mısır'ı ateşe vereceğim.","poem":1},{"text":"Sin büyük bir sıkıntı içinde olacak.","poem":2},{"text":"No yarılacak.","poem":1},{"text":"Memfis'in gündüzleri düşmanları olacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aven ve Pibeset gençleri kılıçla düşecekler.","poem":1},{"text":"Onlar sürgüne gidecekler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tehafnehes'te de Mısır'ın boyunduruklarını kırdığım zaman,","poem":1},{"text":"orada gün geri çekilecek.","poem":2},{"text":"Gücünün övüncü onda sona erecek.","poem":1},{"text":"Ona gelince, onu bir bulut örtecek,","poem":2},{"lineBreak":true},{"text":"ve kızları sürgüne gidecek.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Böylece Mısır'ı cezalandıracağım.","poem":1},{"text":"O zaman benim Yahve olduğumu bilecekler.\"”'","poem":2}]},{"type":"verse","number":20,"content":["On birinci yılda, birinci ayda, ayın yedinci gününde, Yahve'nin sözü bana geldi ve şöyle dedi:"]},{"type":"verse","number":21,"content":["“Ey insanoğlu, Mısır Kralı Firavun'un kolunu kırdım. İşte, ilaç sürülsün, bağlamak için ona sargı sarılsın da kılıcı tutmak için güçlensin diye, onu sarmadılar."]},{"type":"verse","number":22,"content":["Bu yüzden Efendi Yahve şöyle diyor: 'İşte, ben Mısır Kralı Firavun'a karşıyım, kollarını, güçlü kolunu ve kırılmış olanı da kıracağım. Kılıcı elinden düşüreceğim."]},{"type":"verse","number":23,"content":["Mısırlılar'ı ulusların arasına dağıtacağım ve onları ülkelere saçacağım."]},{"type":"verse","number":24,"content":["Babil Kralı'nın kollarını güçlendireceğim, kılıcımı eline vereceğim; ve Firavun'un kollarını kıracağım, ve o, ağır yaralı bir adam nasıl inlerse Babil Kralı'nın önünde öyle inleyecek."]},{"type":"verse","number":25,"content":["Babil Kralı'nın kollarını kaldıracağım, ama Firavun'un kolları düşecek. O zaman, kılıcımı Babil Kralı'nın eline koyduğumda ve onu Mısır diyarı üzerine uzattığında, benim Yahve olduğumu bilecekler."]},{"type":"verse","number":26,"content":["Mısırlılar'ı ulusların arasına dağıtacağım, onları ülkelere saçacağım. O zaman, benim Yahve olduğumu bilecekler.'”"]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}