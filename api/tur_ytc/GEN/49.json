{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"GEN","translationId":"tur_ytc","name":"YARATILIŞ","commonName":"YARATILIŞ","title":"YARATILIŞ","order":1,"numberOfChapters":50,"sha256":"f9906c6e6c6a9e64224726378e5fe04d2eba100cbe5ce006b49e140fa1fd6ce7","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/tur_ytc/GEN/50.json","totalNumberOfVerses":1527},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":["Yakov oğullarına seslenip şöyle dedi: “Toplanın da, gelecekte başınıza gelecekleri size bildireyim."]},{"type":"verse","number":2,"content":[{"text":"Toplanın ve dinleyin, ey Yakov'un oğulları.","poem":1},{"text":"Babanız İsrael'i dinleyin.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ruven, sen benim ilk oğlum, gücüm, gücümün başlangıcısın.","poem":1},{"text":"Saygı ve güçte birincisin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ama su gibi oynaksın, birinci olmayacaksın,","poem":1},{"text":"çünkü babanın yatağına girdin,","poem":2},{"lineBreak":true},{"text":"onu kirlettin. O benim yatağıma çıktı.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Şimon'la Levi kardeştir.","poem":1},{"text":"Kılıçları şiddet silahlarıdır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey canım, onların toplantılarına katılma.","poem":1},{"text":"Ey yüceliğim, toplantılarında onlarla bir olma","poem":2},{"lineBreak":true},{"text":"çünkü öfkelendiklerinde adam öldürdüler.","poem":2},{"lineBreak":true},{"text":"İsteyerek sığırları sakatladılar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lanet olsun öfkelerine, çünkü şiddetlidir.","poem":1},{"text":"Lanet olsun gazaplarına, çünkü zalimcedir.","poem":2},{"text":"Onları Yakov'da böleceğim,","poem":1},{"text":"Onları İsrael'de dağıtacağım.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Yahuda, kardeşlerin seni övecekler.","poem":1},{"text":"Elin düşmanlarının boynunda olacaktır.","poem":2},{"lineBreak":true},{"text":"Babanın oğulları önünde eğilecekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahuda bir aslan yavrusudur.","poem":1},{"text":"Oğlum benim! Avından yukarı çıktın.","poem":2},{"lineBreak":true},{"text":"O yere çöktü, aslan gibi, dişi aslan gibi yattı.","poem":2},{"lineBreak":true},{"text":"Kim onu kaldırabilir?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sahibi gelinceye dek,","poem":1},{"text":"saltanat asası Yahuda'dan,","poem":2},{"lineBreak":true},{"text":"hükümdarlık asası ayaklarının arasından ayrılmayacak.","poem":2},{"lineBreak":true},{"text":"Ulusların itaati ona olacaktır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sıpasını asmaya,","poem":1},{"text":"eşeğinin yavrusunu seçme bir asmaya bağlayarak,","poem":2},{"lineBreak":true},{"text":"giysilerini şarapta,","poem":2},{"lineBreak":true},{"text":"Kaftanını üzümlerin kanında yıkadı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gözleri şaraptan kızıl,","poem":1},{"text":"dişleri sütten beyaz olacak.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Zevulun deniz kıyısında oturacak.","poem":1},{"text":"Gemilere liman olacak.”","poem":2},{"lineBreak":true},{"text":"Sınırı Sayda’nın yanında olacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“İssakar heybelerin arasında yatan,","poem":1},{"text":"güçlü bir eşektir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İyi bir dinlenme yeri,","poem":1},{"text":"hoşuna giden bir memleket görürse,","poem":2},{"lineBreak":true},{"text":"omzunu yüke eğer,","poem":2},{"lineBreak":true},{"text":"Angaryada çalışan bir hizmetçi olur.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Dan İsrael oymaklarından biri olarak,","poem":1},{"text":"halkını yargılayacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dan yolda bir yılan,","poem":1},{"text":"toprak yolda bir engerek olacak,","poem":2},{"lineBreak":true},{"text":"atın topuklarını ısıran,","poem":2},{"lineBreak":true},{"text":"böylece binicisini sırtüstü düşüren bir engerek olacak.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ben senin kurtarışını bekledim, ey Yahve.”","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"“Bir birlik Gad'a saldıracak,","poem":1},{"text":"ama onların topuklarını ezecek.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Aşer'in yiyeceği zengin olacak.","poem":1},{"text":"Kraliyet lezzetleri üretecek.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Naftali salıverilmiş bir geyiktir,","poem":1},{"text":"güzel yavrular doğurur.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Yosef verimli bir asmadır,","poem":1},{"text":"kaynak başında verimli bir asma.","poem":2},{"lineBreak":true},{"text":"Onun dalları duvarın üzerinden aşar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Okçular onu çok hırpaladılar,","poem":1},{"text":"ok atıp ona zulmettiler.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ama onun yayı sağlam,","poem":1},{"text":"ellerinin kolları güçlü çıktı,","poem":2},{"lineBreak":true},{"text":"Yakov’un Kudretlisi’nin elleriyle,","poem":2},{"lineBreak":true},{"text":"(İsrael'in çobanı ve kayası oradandır),","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sana yardım edecek olan babanın Tanrısı’dır,","poem":1},{"text":"Her Şeye Gücü Yeten Tanrı’dır seni kutsayacak olan.","poem":2},{"lineBreak":true},{"text":"Yukarıdaki göğün,","poem":2},{"lineBreak":true},{"text":"aşağıda yatan derinliğin bereketleriyle,","poem":2},{"lineBreak":true},{"text":"memelerin ve rahmin bereketleriyle seni kutsayacak.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Babanın kutsamaları,","poem":1},{"text":"eski tepelerin sınırları üzerinden,","poem":2},{"lineBreak":true},{"text":"atalarının kutsamalarından üstün geldi.","poem":2},{"lineBreak":true},{"text":"Yosef’in başında olacak.”","poem":2},{"lineBreak":true},{"text":"Önderlik kardeşlerinden ayrı olanın başı üzerinde olacak.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Benyamin yırtıcı bir kurttur.","poem":1},{"text":"Sabah avını yutar.","poem":2},{"lineBreak":true},{"text":"Akşam ganimeti paylaşır.”","poem":2}]},{"type":"verse","number":28,"content":["Bunların hepsi İsrael'in on iki oymağıdır. Babaları bunları söyleyip onları kutsadı. Herkesi kendi bereketine göre kutsadı."]},{"type":"verse","number":29,"content":["Onlara buyruk verip şöyle dedi: “Ben halkımın arasına katılmak üzereyim. Beni atalarımın yanına Hititli Efron'un tarlasındaki mağaraya,"]},{"type":"verse","number":30,"content":["Avraham’ın mezar yeri olarak tarlasıyla birlikte Hititli Efron'dan satın almış olduğu Kenan diyarındaki, Mamre yakınlarında Makpela tarlasındaki mağaraya gömün."]},{"type":"verse","number":31,"content":["Avraham’la karısı Sarah'ı oraya gömdüler. İshak'la karısı Rebeka'yı da oraya gömdüler. Ben de Lea'yı oraya gömdüm."]},{"type":"verse","number":32,"content":["Tarla ve içindeki mağara Het'in çocuklarından satın alınmıştı."]},{"type":"verse","number":33,"content":["Yakov oğullarına verdiği buyrukları bitirdikten sonra ayaklarını yatağın içine çekti, son nefesini vererek halkına kavuştu."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}