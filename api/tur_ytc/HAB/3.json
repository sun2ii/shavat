{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HAB","translationId":"tur_ytc","name":"HABAKKUK","commonName":"HABAKKUK","title":"HABAKKUK","order":35,"numberOfChapters":3,"sha256":"13e49ce8379b503d0750e34344d2a05a277e98d94df51ec5963379a471fe61c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tur_ytc/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Peygamber Habakkuk'un zafer tınısına uyarlanmış duası."]},{"type":"verse","number":2,"content":[{"text":"Ey Yahve ününü duydum.","poem":1},{"text":"Ey Yahve, işlerinin karşısında hayrete düştüm.","poem":2},{"text":"Yılların ortasında kendi işini yenile.","poem":1},{"text":"Yılların ortasında bunu bildir.","poem":2},{"lineBreak":true},{"text":"Gazap içinde merhameti hatırla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tanrı Teman'dan,","poem":1},{"text":"Kutsal Olan Paran Dağı'ndan geldi. Selah.","poem":2},{"text":"Görkemi gökleri kapladı,","poem":1},{"text":"ve övgüsü yeryüzünü doldurdu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İhtişamı gün doğumu gibidir.","poem":1},{"text":"Elinden ışınlar parlar, gücü orada gizlidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Önünden veba geçti,","poem":1},{"text":"ve ayaklarını salgın hastalık izledi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O durdu ve yeryüzünü sarstı.","poem":1},{"text":"Baktı ve ulusları titretti.","poem":2},{"lineBreak":true},{"text":"Kadim dağlar yıkıldı.","poem":2},{"lineBreak":true},{"text":"Asırlık tepeler çöktü.","poem":2},{"lineBreak":true},{"text":"O'nun yolları ebedidir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kuşan çadırlarını sıkıntı içinde gördüm.","poem":1},{"text":"Midyan diyarının meskenleri titredi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve ırmaklardan mı hoşnutsuzdu?","poem":1},{"text":"Öfken ırmaklara karşı mı,","poem":2},{"lineBreak":true},{"text":"yoksa gazabın denize karşı mı ki,","poem":2},{"lineBreak":true},{"text":"atlarına, kurtuluş arabalarına bindin?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yayını açtın.","poem":1},{"text":"Ant oklarını çağırdın. Selah.","poem":2},{"lineBreak":true},{"text":"Yeryüzünü ırmaklarla yardın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dağlar seni görüp korktular.","poem":1},{"text":"Sular fırtınası akıp geçti.","poem":2},{"lineBreak":true},{"text":"Engin kükredi ve ellerini yukarıya kaldırdı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Güneş ve ay gökyüzünde yerlerinde durdular,","poem":1},{"text":"uçuşan oklarının ışığında,","poem":2},{"lineBreak":true},{"text":"ışıldayan mızrağının ışıltısında.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ülke içinden gazapla yürüdün,","poem":1},{"text":"ulusları öfkeyle çiğnedin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Halkının kurtuluşu için,","poem":1},{"text":"meshedilmiş olanın kurtuluşu için çıktın.","poem":2},{"text":"Kötülük diyarının başını ezdin.","poem":1},{"text":"Onları tepeden tırnağa soydun. Selah.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onun savaşçılarının başlarını kendi mızraklarıyla deldin.","poem":1},{"text":"Beni dağıtmak için kasırga gibi gelmişlerdi,","poem":2},{"lineBreak":true},{"text":"sanki düşkünü gizlice yutacakmış gibi seviniyorlardı.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Atlarınla denizi çiğnedin,","poem":1},{"text":"güçlü suları çalkaladın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Duydum ve bedenim titredi.","poem":1},{"text":"Dudaklarım sesten titredi.","poem":2},{"text":"Çürüklük kemiklerime girdi ve yerimde titriyorum,","poem":1},{"text":"çünkü sıkıntı gününü,","poem":2},{"lineBreak":true},{"text":"bizi istila edecek halkların çıkmasını sessizce beklemeliyim.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü incir ağacı çiçek açmasa,","poem":1},{"text":"asmalarda meyve olmasa,","poem":2},{"lineBreak":true},{"text":"zeytinin emeği boşa gitse,","poem":2},{"lineBreak":true},{"text":"tarlalar yiyecek vermese,","poem":2},{"lineBreak":true},{"text":"sürüler ağıldan kesilse,","poem":2},{"lineBreak":true},{"text":"ve ahırlarda sığır kalmasa da,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ben yine Yahve'de sevineceğim.","poem":1},{"text":"Kurtuluşumun Tanrısı'nda coşacağım!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahve, Efendi","poem":1},{"noteId":3},{"text":"benim gücümdür.","poem":1},{"text":"O benim ayaklarımı geyik ayakları gibi yapar,","poem":2},{"lineBreak":true},{"text":"yüksek yerlere çıkmamı sağlar.","poem":2},"Telli çalgılarımda, müzik şefi için."]}],"footnotes":[{"noteId":3,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":3,"verse":19}}]},"thisChapterLink":"/api/tur_ytc/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}