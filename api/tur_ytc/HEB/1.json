{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HEB","translationId":"tur_ytc","name":"İBRANİLER","commonName":"İBRANİLER","title":"İBRANİLER","order":58,"numberOfChapters":13,"sha256":"b7ae9bd77fba161bc1fa9eae1a26a4fe18e8071c51eabf8b7e66748da6b73207","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/tur_ytc/HEB/13.json","totalNumberOfVerses":296},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Tanrı eskiden peygamberler aracılığıyla birçok kez çeşitli yollarla atalarımıza konuştu."]},{"type":"verse","number":2,"content":["Bu son günlerde her şeye mirasçı atadığı ve aracılığıyla dünyaları yarattığı Oğlu’yla bize konuşmuştur."]},{"type":"verse","number":3,"content":["Oğul, O’nun yüceliğinin ışıltısı, Tanrı özünün tam suretidir. Güçlü sözüyle her şeyi bir arada tutar. Günahlarımızdan arınmayı sağladıktan sonra, yücelerde Heybetli’nin sağında oturdu."]},{"type":"verse","number":4,"content":["Meleklerden ne denli daha harika bir adı miras aldıysa, onlardan o denli daha üstün oldu."]},{"type":"verse","number":5,"content":["Çünkü Tanrı hiçbir zaman meleklerinden birine,",{"text":"“Sen benim Oğlum’sun.","poem":1},{"text":"Bugün senin baban oldum.”","poem":2},"Ya da,",{"text":"“O’na Baba olacağım,","poem":1},{"text":"O da bana Oğul olacak” demiş midir?","poem":2}]},{"type":"verse","number":6,"content":["Yine Tanrı ilk doğanı dünyaya getirirken, “Tanrı’nın bütün melekleri O’na tapınsın” diyor."]},{"type":"verse","number":7,"content":["Melekler için şöyle diyor:",{"text":"“Kendi meleklerini rüzgârlar,","poem":1},{"text":"ve hizmetkârlarını ateş alevi yapar.”","poem":2}]},{"type":"verse","number":8,"content":["Ama Oğul için şöyle diyor,",{"text":"“Ey Tanrı, tahtın sonsuza dek kalıcıdır.","poem":1},{"text":"doğruluk asası Krallığının asasıdır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Doğruluğu sevdin, kötülükten nefret ettin.","poem":1},{"text":"Bu nedenle Tanrı, senin Tanrın,","poem":2},{"lineBreak":true},{"text":"seni arkadaşlarından daha çok sevinç yağıyla meshetti.”","poem":2}]},{"type":"verse","number":10,"content":["Ve yine,",{"text":"“Efendi, başlangıçta yeryüzünün temelini sen attın.","poem":1},{"text":"Gökler senin ellerinin işleridir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onlar yok olacak, ama sen kalıcısın.","poem":1},{"text":"Hepsi bir giysi gibi eskiyecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onları kaftan gibi düreceksin,","poem":1},{"text":"ve değiştirilecekler.","poem":2},{"lineBreak":true},{"text":"Ama sen hep aynısın,","poem":2},{"lineBreak":true},{"text":"senin yılların tükenmeyecektir.”","poem":2}]},{"type":"verse","number":13,"content":["Tanrı hiçbir zaman meleklerinden birine,",{"text":"“Düşmanlarını ayaklarının altına serinceye dek,","poem":1},{"text":"sağımda otur” demiş midir?","poem":2}]},{"type":"verse","number":14,"content":["Meleklerin tümü, kurtuluşu miras alacak olanlara hizmet etmek üzere gönderilmiş görevli ruhlar değil midir?"]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}