{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["İsrael meyvesini veren bereketli bir asmadır.",{"text":"Meyvesinin bolluğuna göre sunaklarını çoğalttı.","poem":2},{"lineBreak":true},{"text":"Ülkeleri zenginleştikçe dikili taşlarını süslediler.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yürekleri bölündü.","poem":1},{"text":"Şimdi suçlu bulunacaklar.","poem":2},{"lineBreak":true},{"text":"Sunaklarını yıkacak.","poem":2},{"lineBreak":true},{"text":"Dikili taşlarını yok edecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gerçekten şimdi diyecekler, “Kralımız yok; çünkü Yahve'den korkmuyoruz;","poem":1},{"text":"ve kral, o bizim için ne yapabilir?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Antlaşma yaparken yalan yere ant içerek söz veriyorlar.","poem":1},{"text":"Bu yüzden yargı, tarlanın karıklarında zehirli otlar gibi bitiyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Samariya sakinleri, Beyt Aven'in buzağıları yüzünden dehşete düşecek,","poem":1},{"text":"çünkü halkı, onun görkemi için onun hakkında sevinen kâhinleriyle birlikte,","poem":2},{"lineBreak":true},{"text":"ona yas tutacaklar, çünkü ondan ayrıldı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Üstelik büyük krala armağan olarak Aşur'a götürülecek.","poem":1},{"text":"Efraim utanç duyacak,","poem":2},{"lineBreak":true},{"text":"ve İsrael kendi öğüdünden utanacak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samariya ve kralı suda bir dal gibi akıp gidecek.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"İsrael'in günahı, Aven'in yüksek yerleri de yok olacak.","poem":1},{"text":"Onların sunakları üzerinde diken ve devedikeni çıkacak.","poem":2},{"lineBreak":true},{"text":"Dağlara, “Bizi örtün!” ve tepelere, “Üzerimize düşün!” diyecekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ey İsrael, Giva günlerinden beri günah işledin.","poem":1},{"text":"Orada kaldılar.","poem":2},{"lineBreak":true},{"text":"Kötülük çocuklarına karşı olan savaş Giva'da onları yakalamaz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İstediğim zaman onları cezalandıracağım;","poem":1},{"text":"ve iki suçlarına bağlı oldukları zaman","poem":2},{"lineBreak":true},{"text":"uluslar onlara karşı toplanacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim harman dövmeyi seven eğitilmiş bir düvedir,","poem":1},{"text":"bu yüzden güzel boynuna bir boyunduruk koyacağım.","poem":2},{"lineBreak":true},{"text":"Efraim üzerine bir adam bindireceğim.","poem":2},{"lineBreak":true},{"text":"Yahuda saban sürecek.","poem":2},{"lineBreak":true},{"text":"Yakov tırmık çekecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Doğrulukla kendinize ekin,","poem":1},{"text":"iyiliğe göre biçin.","poem":2},{"text":"Nadasa bırakılmış toprağınızı sürün,","poem":1},{"text":"çünkü Yahve'yi aramanın zamanıdır,","poem":2},{"lineBreak":true},{"text":"ta ki gelip üzerinize doğruluk yağdırana dek.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kötülük sürdünüz,","poem":1},{"text":"haksızlık biçtiniz.","poem":2},{"lineBreak":true},{"text":"Yalanların meyvesini yediniz,","poem":2},{"lineBreak":true},{"text":"çünkü kendi yolunuza, yiğitlerinizin çokluğuna güvendiniz.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bu yüzden halkınızın arasında bir savaş kükremesi yükselecek,","poem":1},{"text":"ve bütün kaleleriniz yıkılacak,","poem":2},{"lineBreak":true},{"text":"tıpkı Şalman'ın savaş günü Beyt Arbel'i yıkması gibi.","poem":2},{"lineBreak":true},{"text":"Anne çocuklarıyla birlikte paramparça edildi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Büyük kötülüğünüz yüzünden Beytel de size aynısını yapacak.","poem":1},{"text":"Şafak vakti İsrael Kralı yıkılacak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}