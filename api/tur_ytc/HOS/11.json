{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["“İsrael çocukken onu sevdim,",{"text":"ve oğlumu Mısır’dan çağırdım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Onları çağırdıkça, onlar uzaklaştı onlardan.","poem":1},{"text":"Baallar'a kurban kestiler,","poem":2},{"lineBreak":true},{"text":"ve oyma putlara buhur yaktılar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ancak Efraim’e yürümeyi ben öğrettim.","poem":1},{"text":"Onları kollarıma aldım,","poem":2},{"lineBreak":true},{"text":"ama onları iyileştirenin ben olduğumu bilmediler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onları insan ipleriyle, sevgi bağlarıyla çektim;","poem":1},{"text":"ve onlara boyunlarındaki boyunduruğu kaldıran biri gibi oldum;","poem":2},{"lineBreak":true},{"text":"ve eğilip onu besledim.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Mısır diyarına dönmeyecekler;","poem":1},{"text":"ama Aşurlu onların kralı olacak,","poem":2},{"lineBreak":true},{"text":"çünkü tövbe etmeyi reddettiler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kılıç onların kentleri üzerine inecek,","poem":1},{"text":"ve kapılarının sürgülerini yok edecek,","poem":2},{"lineBreak":true},{"text":"ve onların tasarılarına son verecek.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Halkım benden dönmeye kararlı.","poem":1},{"text":"En Yüce Olan'a seslenseler bile,","poem":2},{"lineBreak":true},{"text":"kesinlikle onları yüceltmeyecek.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ey Efraim, senden nasıl vazgeçerim?","poem":1},{"text":"Ey İsrael, seni nasıl teslim ederim?","poem":2},{"lineBreak":true},{"text":"Seni nasıl Adma gibi yaparım?","poem":2},{"lineBreak":true},{"text":"Seni nasıl Sevoim gibi yaparım?","poem":2},{"text":"Yüreğim döndü, acımam kabardı.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Öfkemin kızgınlığını yerine getirmeyeceğim.","poem":1},{"text":"Efraim'i yok etmek için geri dönmeyeceğim.","poem":2},{"lineBreak":true},{"text":"Çünkü ben Tanrı'yım, insan değilim;","poem":2},{"lineBreak":true},{"text":"aranızdaki Kutsal Olan'ım.","poem":2},{"lineBreak":true},{"text":"Gazapla gelmeyeceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aslan gibi kükreyen","poem":1},{"text":"Yahve'nin ardından yürüyecekler;","poem":2},{"lineBreak":true},{"text":"çünkü O kükreyecek ve çocuklar batıdan titreyerek gelecekler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mısır'dan bir kuş gibi,","poem":1},{"text":"Aşur ülkesinden bir güvercin gibi titreyerek gelecekler;","poem":2},{"text":"ve onları evlerine yerleştireceğim.” diyor Yahve.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Efraim yalanla,","poem":1},{"text":"İsrael evi de beni hileyle kuşattı.","poem":2},{"lineBreak":true},{"text":"Yahuda hâlâ Tanrı'dan sapıyor,","poem":2},{"lineBreak":true},{"text":"ve Kutsal Olan'a sadakatsizlik ediyor.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}