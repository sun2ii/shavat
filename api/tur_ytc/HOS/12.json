{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Efraim rüzgârı güdüyor,",{"text":"doğu rüzgârını kovalıyor.","poem":2},{"lineBreak":true},{"text":"Sürekli yalanı ve yıkımı artırıyor.","poem":2},{"lineBreak":true},{"text":"Aşur'la antlaşma yapıyor,","poem":2},{"lineBreak":true},{"text":"ve yağ Mısır'a götürülüyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve'nin de Yahuda'yla bir davası var,","poem":1},{"text":"ve Yakov'u kendi yollarına göre cezalandıracak,","poem":2},{"lineBreak":true},{"text":"işlerine göre ona karşılık verecektir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rahimde kardeşinin topuğundan tuttu,","poem":1},{"text":"ve yetişkinliğinde Tanrı'yla çekişti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gerçekten Melek'le mücadele etti ve galip geldi;","poem":1},{"text":"ağlayıp O'na yalvardı.","poem":2},{"lineBreak":true},{"text":"O'nu Beytel'de buldu ve O orada bizimle konuştu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ordular Tanrısı Yahve.","poem":1},{"text":"O Yahve diye anılır!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu yüzden Tanrın'a dön.","poem":1},{"text":"İyiliği ve adaleti koru,","poem":2},{"lineBreak":true},{"text":"ve sürekli Tanrın'ı bekle.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bir tüccarın elinde hileli teraziler var.","poem":1},{"text":"O aldatmayı sever.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim, “Gerçekten zengin oldum” dedi.","poem":1},{"text":"“Kendim için varlık buldum.","poem":2},{"lineBreak":true},{"text":"Bütün servetimde günah olan hiçbir suç bulmayacaklar.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ama ben Mısır diyarından Tanrınız Yahve'yim.","poem":1},{"text":"Kutsal bayram günlerinde olduğu gibi.","poem":2},{"lineBreak":true},{"text":"Sizi yine çadırlarda oturtacağım,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"peygamberlere de söyledim,","poem":1},{"text":"ve görümleri çoğalttım;","poem":2},{"lineBreak":true},{"text":"ve peygamberlerin hizmetiyle benzetmeler kullandım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gilad kötüyse,","poem":1},{"text":"kesinlikle onlar değersizdirler.","poem":2},{"text":"Gilgal'da boğalar kurban ediyorlar.","poem":1},{"text":"Gerçekten de sunakları tarlanın karıklarındaki yığınlar gibidir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakov Aram ülkesine kaçtı.","poem":1},{"text":"İsrael bir karı edinmek için hizmet etti.","poem":2},{"lineBreak":true},{"text":"Bir karı için sürüleri ve sığırları güttü.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve bir peygamber aracılığıyla İsrael'i Mısır'dan çıkardı,","poem":1},{"text":"ve bir peygamber aracılığıyla o korundu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Efraim çok acı öfkelendirdi.","poem":1},{"text":"Bu yüzden kanı onun üzerinde kalacak,","poem":2},{"lineBreak":true},{"text":"ve Efendisi","poem":2},{"noteId":8},{"text":"onun aşağılamasını ödeyecek.”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":12,"verse":14}}]},"thisChapterLink":"/api/tur_ytc/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}