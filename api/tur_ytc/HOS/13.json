{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Efraim konuştuğunda titreme vardı.",{"text":"İsrael'de kendini yüceltti,","poem":2},{"lineBreak":true},{"text":"ama Baal yüzünden suçlu olunca öldü.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Şimdi günahları daha da çok artırıyorlar,","poem":1},{"text":"ve kendi anlayışlarına göre gümüşlerinden dökme suretler yaptılar,","poem":2},{"lineBreak":true},{"text":"hepsi de usta işi.","poem":2},{"lineBreak":true},{"text":"Onlar için, “İnsan kurban ediyorlar,","poem":2},{"lineBreak":true},{"text":"ve buzağıları öpüyorlar” diyorlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bu yüzden sabah sisi gibi,","poem":1},{"text":"erken eriyen çiy gibi,","poem":2},{"lineBreak":true},{"text":"harman yerinden kasırga ile savrulan saman çöpü gibi,","poem":2},{"lineBreak":true},{"text":"bacadan tüten duman gibi olacaklar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ancak ben Mısır diyarından Tanrınız Yahve'yim;","poem":1},{"text":"ve benden başka tanrı tanımayacaksınız,","poem":2},{"lineBreak":true},{"text":"ve benden başka kurtarıcı yoktur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ben seni çölde,","poem":1},{"text":"büyük kuraklık diyarında bildim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Otlaklarına göre doydular;","poem":1},{"text":"doydular ve yürekleri yükseldi.","poem":2},{"lineBreak":true},{"text":"Bu yüzden beni unuttular.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bundan ötürü onlara bir aslan gibiyim.","poem":1},{"text":"Bir leopar gibi, yol kenarında pusuya yatacağım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yavrularından yoksun kalmış bir ayı gibi onlarla karşılaşacağım,","poem":1},{"text":"ve yüreklerinin zarını yırtacağım.","poem":2},{"lineBreak":true},{"text":"Onları orada dişi aslan gibi yiyip bitireceğim.","poem":2},{"lineBreak":true},{"text":"Yabanıl hayvan onları parçalayacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yok oldun, ey İsrael, çünkü bana karşısın,","poem":1},{"text":"yardımcına karşısın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kralın şimdi nerede ki, bütün kentlerinde seni kurtarsın?","poem":1},{"text":"Ve hâkimlerin onlar hakkında, 'Bana bir kral ve beyler ver' demiştin?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sana öfkemde bir kral verdim,","poem":1},{"text":"ve gazabımda onu aldım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Efraim'in suçu birikti.","poem":1},{"text":"Günahı birikti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Doğuran kadının ağrıları onun üzerine gelecek.","poem":1},{"text":"O akılsız bir oğuldur,","poem":2},{"lineBreak":true},{"text":"çünkü zamanı gelmişken, rahmin ağzına gelmiyor.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onları Şeol'ün","poem":1},{"noteId":9},{"text":"elinden fidye ile kurtaracağım.","poem":1},{"text":"Onları ölümden kurtaracağım!","poem":2},{"lineBreak":true},{"text":"Ey ölüm, belaların nerede?","poem":2},{"lineBreak":true},{"text":"Ey Şeol, yıkımın nerede?”","poem":2},{"text":"“Gözlerimden acıma gizlenecek.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kardeşleri arasında verimli olsa bile, doğu rüzgârı gelecek,","poem":1},{"text":"Yahve'nin soluğu çölden yükselecek;","poem":2},{"lineBreak":true},{"text":"onun kaynağı kesilecek,","poem":2},{"lineBreak":true},{"text":"ve pınarı kuruyacak.","poem":2},{"lineBreak":true},{"text":"Hazine ambarını yağmalayacak.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Samariya suçunu taşıyacak,","poem":1},{"text":"çünkü Tanrısı'na başkaldırdı.","poem":2},{"lineBreak":true},{"text":"Kılıçla düşecekler.","poem":2},{"lineBreak":true},{"text":"Bebekleri parçalanacak,","poem":2},{"lineBreak":true},{"text":"ve gebe kadınların karnı yarılacak.”","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/tur_ytc/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}