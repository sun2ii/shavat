{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Ey İsrael, Tanrın Yahve'ye dön;",{"text":"çünkü günahın yüzünden düştün.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sözleri yanına al ve Yahve'ye dönün.","poem":1},{"text":"O'na deyin, “Bütün günahlarımızı bağışla,","poem":2},{"lineBreak":true},{"text":"ve iyi olanı kabul et;","poem":2},{"lineBreak":true},{"text":"öyle ki, dudaklarımızın adadığı gibi boğalar sunalım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aşur bizi kurtaramaz.","poem":1},{"text":"Atlar üzerine binmeyeceğiz;","poem":2},{"lineBreak":true},{"text":"ve ellerimizin işine artık 'İlâhlarımız!' demeyeceğiz.","poem":2},{"lineBreak":true},{"text":"Çünkü yetim sende merhamet bulur.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Onların dönekliklerini iyileştireceğim.","poem":1},{"text":"Onları gönülden seveceğim;","poem":2},{"lineBreak":true},{"text":"çünkü öfkem onlardan döndü.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İsrael'e çiy gibi olacağım.","poem":1},{"text":"Zambak gibi çiçek açacak,","poem":2},{"lineBreak":true},{"text":"ve köklerini Lübnan gibi salacak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dalları yayılacak,","poem":1},{"text":"ve güzelliği zeytin ağacı gibi,","poem":2},{"lineBreak":true},{"text":"ve kokusu Lübnan gibi olacak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İnsanlar onun gölgesinde oturacak.","poem":1},{"text":"Buğday gibi canlanacaklar,","poem":2},{"lineBreak":true},{"text":"asma gibi çiçek açacaklar.","poem":2},{"lineBreak":true},{"text":"Kokuları Lübnan şarabı gibi olacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim diyecek putlarla ne işim var artık?","poem":1},{"text":"Ben yanıt veriyorum ve ona bakacağım.","poem":2},{"lineBreak":true},{"text":"Ben yeşil bir selvi gibiyim;","poem":2},{"lineBreak":true},{"text":"senin meyven benden olur.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bu şeyleri anlamak için bilge olan kimdir?","poem":1},{"text":"Anlayışlı olan kimdir ki, bunları bilebilsin?","poem":2},{"lineBreak":true},{"text":"Çünkü Yahve'nin yolları doğrudur,","poem":2},{"lineBreak":true},{"text":"ve doğrular onlarda yürür,","poem":2},{"lineBreak":true},{"text":"ama başkaldıranlar onlarda tökezler.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}