{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Erkek kardeşlerinize, ‘Halkım!’,",{"noteId":4},{"text":"kız kardeşlerinize, ‘Sevdiğim!’","poem":2},{"noteId":5},{"text":"deyin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Annenizle çekişin!","poem":1},{"text":"Çekişin, çünkü o benim karım değil,","poem":2},{"lineBreak":true},{"text":"ben de onun kocası değilim.","poem":2},{"text":"Yüzünden fuhuşunu,","poem":1},{"text":"zinalarını bağrından atsın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yoksa onu çırılçıplak soyarım,","poem":1},{"text":"doğduğu günde olduğu gibi yaparım,","poem":2},{"text":"onu çöl ederim,","poem":1},{"text":"ve onu kurak bir yere çeviririm,","poem":2},{"lineBreak":true},{"text":"onu susuzluktan öldürürüm.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gerçekten onun çocuklarına merhamet etmeyeceğim,","poem":1},{"text":"çünkü onlar sadakatsizliğin çocuklarıdır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü anneleri fahişelik yaptı,","poem":1},{"text":"onlara gebe kalıp rezillik etti.","poem":2},{"text":"Çünkü dedi, 'Ekmeğimi, suyumu, yünümü,","poem":1},{"text":"ketenimi, yağımı ve içeceğimi bana veren","poem":2},{"lineBreak":true},{"text":"oynaşlarımın ardından gideceğim.'","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu yüzden işte,","poem":1},{"noteId":6},{"text":"onun yoluna dikenlerle çit çekeceğim,","poem":1},{"text":"ve yolunu bulamasın diye ona karşı bir duvar öreceğim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oynaşlarının peşinden gidecek,","poem":1},{"text":"ama onlara yetişemeyecek;","poem":2},{"lineBreak":true},{"text":"ve onları arayacak, ama bulamayacak.","poem":2},{"text":"O zaman diyecek, 'Gidip ilk kocama döneyim,","poem":1},{"text":"çünkü o zaman durumum şimdikinden daha iyiydi.'","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü ona buğdayı, yeni şarabı ve yağı verdiğimi,","poem":1},{"text":"ve Baal için kullandıkları gümüşü ve altını kendisine benim çoğalttığımı bilmedi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bu yüzden buğdayımı zamanında,","poem":1},{"text":"yeni şarabımı mevsiminde geri alacağım,","poem":2},{"lineBreak":true},{"text":"ve onun çıplaklığını örten yünümü ve ketenimi çekip alacağım.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Şimdi oynaşlarının gözü önünde onun ahlaksızlığını açığa vuracağım,","poem":1},{"text":"ve kimse onu elimden kurtaramayacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bütün kutlamalarını, bayramlarını, Yeni Aylar'ını, Şabatlar'ını,","poem":1},{"text":"ve bütün kutsal toplantılarını sona erdireceğim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asmalarını ve incir ağaçlarını harap edeceğim,","poem":1},{"text":"onlar hakkında, 'Bunlar oynaşlarımın bana verdiği ücrettir' diyordu,","poem":2},{"lineBreak":true},{"text":"ve onları ormana çevireceğim,","poem":2},{"lineBreak":true},{"text":"ve kırın hayvanları onları yiyecek.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kendilerine buhur yaktığı Baallar'ın günlerini onun üzerinde ziyaret edeceğim,","poem":1},{"lineBreak":true},{"text":"o zaman ki, halkalarıyla ve mücevherleriyle süslenmiş,","poem":1},{"text":"ve oynaşlarının peşinden gitmiş,","poem":2},{"lineBreak":true},{"text":"ve beni unutmuştu.” diyor Yahve.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Bu yüzden işte, onu kandıracağım,","poem":1},{"text":"ve onu çöle getireceğim,","poem":2},{"lineBreak":true},{"text":"ve ona şefkatle konuşacağım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oradan onun bağlarını vereceğim,","poem":1},{"text":"Akor Vadisi'ni de umut kapısı olarak vereceğim.","poem":2},{"text":"Gençlik günlerinde olduğu gibi,","poem":1},{"text":"Mısır diyarından çıktığı günkü gibi karşılık verecek.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"O gün” diyor Yahve,","poem":1},{"text":"“Bana 'kocam' diyeceksin,","poem":2},{"lineBreak":true},{"text":"ve artık bana 'efendim' demeyeceksin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü Baallar'ın adlarını onun ağzından kaldıracağım,","poem":1},{"text":"ve artık adlarıyla anılmayacaklar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"O gün onlar için kırdaki hayvanlarla,","poem":1},{"text":"gökyüzündeki kuşlarla, yerde sürünen yaratıklarla bir antlaşma yapacağım.","poem":2},{"text":"Ülkeden yayı, kılıcı ve savaşı kıracağım,","poem":1},{"text":"ve onları güvenlik içinde yatıracağım.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Seni sonsuza dek kendime nişanlayacağım.","poem":1},{"text":"Evet, seni doğruluk, adalet, sevgi dolu iyilikle ve merhametle kendime nişanlayacağım.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Seni sadakatle kendime nişanlayacağım,","poem":1},{"text":"ve Yahve'yi tanıyacaksın.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"O gün yanıt vereceğim.” diyor Yahve.","poem":1},{"text":"“Göklere yanıt vereceğim,","poem":2},{"lineBreak":true},{"text":"ve onlar da yere yanıt verecekler;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ve yer buğdaya, yeni şaraba ve yağa yanıt verecek;","poem":1},{"text":"onlar da Yizreel'e yanıt verecekler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Onu kendim için, toprağa ekeceğim;","poem":1},{"text":"ve merhamet bulmamış olana merhamet edeceğim;","poem":2},{"lineBreak":true},{"text":"ve halkım olmayanlara, 'Halkımsın' diyeceğim;","poem":2},{"lineBreak":true},{"text":"onlar da bana, 'Tanrım!' diyecekler.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"İbranice'de 'Ammi'","reference":{"chapter":2,"verse":1}},{"noteId":5,"caller":"+","text":"İbranice'de 'Ruhamah'","reference":{"chapter":2,"verse":1}},{"noteId":6,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/tur_ytc/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}