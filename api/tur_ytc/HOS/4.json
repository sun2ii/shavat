{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Ey İsrael'in çocukları, Yahve'nin sözünü dinleyin,",{"text":"çünkü Yahve'nin ülkede yaşayanlara karşı davası var:","poem":2},{"lineBreak":true},{"text":"“Gerçekten ülkede gerçek, iyilik,","poem":2},{"lineBreak":true},{"text":"ve Tanrı bilgisi yok.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lanet, yalan, adam öldürme, hırsızlık ve zina var;","poem":1},{"text":"sınırları ihlal ediyorlar ve kan üstüne kan dökülüyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bu yüzden ülke yas tutacak ve içinde oturan herkes,","poem":1},{"lineBreak":true},{"text":"ondaki bütün canlılarla birlikte yok olacak;","poem":1},{"text":"kırın hayvanları ve göğün kuşları bile;","poem":2},{"lineBreak":true},{"text":"evet, denizin balıkları da ölecek.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ancak hiç kimse çekişmesin, hiç kimse suçlamasın;","poem":1},{"text":"çünkü halkın kâhinle çekişenler gibidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sen gündüz tökezleyeceksin,","poem":1},{"text":"peygamber de gece seninle birlikte tökezleyecek;","poem":2},{"lineBreak":true},{"text":"ve senin anneni mahvedeceğim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkım bilgisizlik yüzünden mahvoldu.","poem":1},{"text":"Mademki sen bilgiyi reddettin, bana kâhin olmayasın diye ben de seni reddedeceğim.","poem":2},{"text":"Mademki sen Tanrı'nın Yasası'nı unuttun,","poem":1},{"text":"ben de senin çocuklarını unutacağım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çoğaldıkça bana karşı günah işlediler.","poem":1},{"text":"Onların görkemini utanca çevireceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Halkımın günahıyla besleniyorlar,","poem":1},{"text":"onların kötülüklerine yüreklerini veriyorlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halk, nasılsa kâhin de öyle olacak,","poem":1},{"text":"ve onları yollarından ötürü cezalandıracağım,","poem":2},{"lineBreak":true},{"text":"ve işlerinin karşılığını onlara ödeyeceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yiyecekler ve doymayacaklar.","poem":1},{"text":"Fahişelik edecekler ve çoğalmayacaklar;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'yi dinlemeyi bıraktılar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Fuhuş, şarap ve yeni şarap anlayışı ortadan kaldırır.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Halkım tahta puta danışıyor,","poem":1},{"text":"ve ağaçtan değnek ona yanıt veriyor.","poem":2},{"text":"Gerçekten fuhuş ruhu onları saptırdı,","poem":1},{"text":"ve kendi Tanrıları'na sadakatsiz oldular.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dağların başlarında kurban kesiyorlar,","poem":1},{"text":"ve tepelerde, meşe, kavak ve meşeliklerin altında buhur yakıyorlar,","poem":2},{"lineBreak":true},{"text":"çünkü onun gölgesi iyidir.","poem":2},{"text":"Bu yüzden kızlarınız fahişelik yapıyor, gelinleriniz zina ediyor.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kızlarınızı fahişelik yaptıklarında,","poem":1},{"text":"gelinlerinizi de zina ettiklerinde cezalandırmayacağım;","poem":2},{"text":"çünkü erkekler fahişelerle düşüp kalkıyor,","poem":1},{"text":"putperest tapınağının fahişeleriyle kurban kesiyorlar;","poem":2},{"lineBreak":true},{"text":"böylece anlayışsız halk yıkıma uğrayacak.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Sen, ey İsrael, fahişelik yapsan da,","poem":1},{"text":"Yahuda suç işlemese bari;","poem":2},{"lineBreak":true},{"text":"Gilgal'a gelmeyin,","poem":2},{"lineBreak":true},{"text":"Beyt Aven'e çıkmayın,","poem":2},{"lineBreak":true},{"text":"'Yaşayan Yahve'nin hakkı için' diye ant içmeyin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü İsrael, inatçı bir düve gibi son derece inatçı davrandı.","poem":1},{"text":"Öyleyse Yahve onları çayırda kuzu gibi nasıl güdecek?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efraim putlara bağlandı.","poem":1},{"text":"Bırak onu!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İçkileri ekşidi.","poem":1},{"text":"Sürekli fahişelik yapıyorlar.","poem":2},{"lineBreak":true},{"text":"Önderleri utanç verici yollarını çok seviyorlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Rüzgâr onu kanatlarıyla sardı;","poem":1},{"text":"ve kurbanları yüzünden hayal kırıklığına uğrayacaklar.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}