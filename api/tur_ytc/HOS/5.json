{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["“Ey kâhinler, dinleyin!",{"text":"Ey İsrael evi, dinleyin ve kulak verin,","poem":2},{"lineBreak":true},{"text":"ey kral evi!","poem":2},{"text":"Çünkü yargı size karşıdır;","poem":1},{"text":"çünkü Mitspa'da tuzak,","poem":2},{"lineBreak":true},{"text":"Tavor'da serilmiş bir ağ oldunuz.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Başkaldıranlar öldürmekte derine indiler,","poem":1},{"text":"ama ben onların hepsini terbiye edeceğim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Efraim'i tanıyorum,","poem":1},{"text":"ve İsrael benden gizli değil;","poem":2},{"text":"çünkü şimdi, ey Efraim, fahişelik yaptın.","poem":1},{"text":"İsrael kirlendi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaptıkları iş Tanrıları'na dönmelerine izin vermiyor,","poem":1},{"text":"çünkü içlerinde fahişelik ruhu var,","poem":2},{"lineBreak":true},{"text":"ve Yahve'yi tanımıyorlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İsrael'in gururu kendi yüzüne tanıklık ediyor.","poem":1},{"text":"Bu yüzden İsrael ve Efraim suçlarında tökezleyecekler.","poem":2},{"lineBreak":true},{"text":"Yahuda da onlarla birlikte tökezleyecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sürüleriyle ve sığırlarıyla Yahve'yi aramaya gidecekler,","poem":1},{"text":"ama O'nu bulamayacaklar.","poem":2},{"lineBreak":true},{"text":"O kendini onlardan geri çekti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve'ye sadakatsizdirler;","poem":1},{"text":"çünkü gayrimeşru çocuklar doğurdular.","poem":2},{"lineBreak":true},{"text":"Şimdi Yeni Ay onları tarlalarıyla birlikte yiyip bitirecek.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Giva'da boynuzu, Rama'da boruyu çalın!","poem":1},{"text":"Beyt Aven'de savaş narası atın, senin ardında, ey Benyamin!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraim azarlama gününde harap olacak.","poem":1},{"text":"İsrael oymaklar arasında, kesinlikle olacak olanı bildirdim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahuda beyleri, sınır taşlarının yerini değiştirenlere benzer.","poem":1},{"text":"Gazabımı su gibi onların üzerine dökeceğim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim baskı altında,","poem":1},{"text":"yargıda eziliyor,","poem":2},{"lineBreak":true},{"text":"çünkü putların peşinde koşmaya kararlı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bu yüzden Efraim'e güve,","poem":1},{"text":"Yahuda evine ise çürüklük gibiyim.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Efraim hastalığını,","poem":1},{"text":"Yahuda yarasını görünce,","poem":2},{"lineBreak":true},{"text":"Efraim Aşur'a gitti,","poem":2},{"lineBreak":true},{"text":"Ve Kral Yareb'e haber gönderdi;","poem":2},{"text":"ama o size şifa veremez,","poem":1},{"text":"yaranızı da iyileştiremez.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü ben Efraim'e bir aslan,","poem":1},{"text":"Yahuda evine de genç bir aslan gibi olacağım.","poem":2},{"text":"Ben kendim parçalayıp gideceğim.","poem":1},{"text":"Alıp götüreceğim, kurtaracak kimse olmayacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gidip yerime döneceğim,","poem":1},{"text":"ta ki suçlarını itiraf edip yüzümü arayıncaya dek.","poem":2},{"lineBreak":true},{"text":"Sıkıntılarında beni gayretle arayacaklar.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}