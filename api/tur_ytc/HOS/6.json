{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["“Gelin! Yahve'ye dönelim;",{"text":"çünkü O parçaladı,","poem":2},{"lineBreak":true},{"text":"ve bizi O iyileştirecek;","poem":2},{"text":"O bizi yaraladı,","poem":1},{"text":"ve yaralarımızı O saracak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İki gün sonra bizi diriltecek.","poem":1},{"text":"Üçüncü günde bizi ayağa kaldıracak,","poem":2},{"lineBreak":true},{"text":"ve O'nun önünde yaşayacağız.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve'yi tanıyalım.","poem":1},{"text":"Yahve'yi tanımak için ilerleyelim.","poem":2},{"text":"Güneşin kesin doğuşu gibi,","poem":1},{"text":"Yahve de görünecektir.","poem":2},{"lineBreak":true},{"text":"Yağmur gibi,","poem":2},{"lineBreak":true},{"text":"toprağı sulayan ilkbahar yağmuru gibi bize gelecektir.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Efraim, sana ne yapayım?","poem":1},{"text":"Yahuda, sana ne yapayım?","poem":2},{"lineBreak":true},{"text":"Çünkü sevgin sabah bulutu gibidir,","poem":2},{"lineBreak":true},{"text":"erkenden dağılan çiy gibidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bu yüzden onları peygamberler aracılığıyla parçaladım,","poem":1},{"text":"ağzımın sözleriyle onları öldürdüm.","poem":2},{"lineBreak":true},{"text":"Yargıların şimşek çakması gibidir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü ben kurban değil, merhamet isterim;","poem":1},{"text":"ve yakmalık sunulardan daha fazla Tanrı bilgisi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama onlar, Adem gibi, antlaşmayı bozdular.","poem":1},{"text":"Orada bana sadakatsizlik ettiler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilad, kötülük yapanların kentidir;","poem":1},{"text":"kanla lekelenmiştir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haydut çeteleri birini pusuya düşürmek için nasıl beklerse,","poem":1},{"text":"kâhinler takımı da Şekem yolunda öyle adam öldürüyor,","poem":2},{"lineBreak":true},{"text":"utanç verici suçlar işliyorlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İsrael evinde korkunç bir şey gördüm.","poem":1},{"text":"Efraim'de fuhuş var.","poem":2},{"lineBreak":true},{"text":"İsrael kirlendi.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ey Yahuda, halkımın durumunu düzelttiğim zaman,","poem":1},{"text":"senin için de atanmış bir hasat var.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}