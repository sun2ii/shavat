{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Ben İsrael'i iyileştirmek isterken,",{"text":"Efraim'in suçu, Samariya'nın kötülüğü meydana çıkıyor.","poem":2},{"lineBreak":true},{"text":"Çünkü hile yapıyorlar,","poem":2},{"lineBreak":true},{"text":"evlere hırsız giriyor,","poem":2},{"lineBreak":true},{"text":"haydut çeteleri de dışarıda talan ediyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yüreklerinde bütün kötülüklerini hatırladığımı düşünmezler.","poem":1},{"text":"Şimdi kendi işleri onların çevresini sardı.","poem":2},{"lineBreak":true},{"text":"Yüzümün önündedirler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kralı kötülükleriyle,","poem":1},{"text":"ve beyleri yalanlarıyla sevindiriyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hepsi zina yapanlardır.","poem":1},{"text":"Hamur yoğurulup mayalanana dek,","poem":2},{"lineBreak":true},{"text":"ateşi karıştırmayı bırakan fırıncının kızdırdığı fırın gibidirler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kralımızın gününde, beyler kendilerini şarap ateşinden hasta ettiler.","poem":1},{"text":"O da alaycılarla elini birleştirdi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü yüreklerini bir fırın gibi hazırladılar,","poem":1},{"text":"pusuda beklerken.","poem":2},{"lineBreak":true},{"text":"Öfkeleri bütün gece için için yanar.","poem":2},{"lineBreak":true},{"text":"Sabahleyin alevli ateş gibi yanar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hepsi fırın gibi sıcaktır,","poem":1},{"text":"ve hâkimlerini yutarlar.","poem":2},{"text":"Bütün kralları düştü.","poem":1},{"text":"İçlerinden bana seslenen yok.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim uluslarla karışıyor.","poem":1},{"text":"Efraim çevrilmeyen bir pidedir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yabancılar onun gücünü yediler ve o bunu fark etmiyor.","poem":1},{"text":"Gerçekten, saçına ak düştü ve o bunu fark etmiyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İsrael'in gururu kendi yüzüne tanıklık ediyor;","poem":1},{"text":"yine de Tanrıları Yahve'ye dönmediler,","poem":2},{"lineBreak":true},{"text":"ve bütün bunlara rağmen O'nu aramadılar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Efraim kolayca aldatılan bir güvercin gibidir, anlayışsızdır.","poem":1},{"text":"Mısır'ı çağırıyorlar.","poem":2},{"lineBreak":true},{"text":"Aşur'a gidiyorlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Giderken ağımı üzerlerine sereceğim.","poem":1},{"text":"Onları gökyüzünün kuşları gibi yere indireceğim.","poem":2},{"lineBreak":true},{"text":"Onların topluluklarının duyduğu gibi kendilerini cezalandıracağım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vay onların haline!","poem":1},{"text":"Çünkü benden uzaklaştılar.","poem":2},{"text":"Onlara yıkım!","poem":1},{"text":"Çünkü bana karşı suç işlediler.","poem":2},{"text":"Ben onları kurtarmak isterken,","poem":1},{"text":"onlar bana karşı yalan söylediler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yürekleriyle bana feryat etmediler,","poem":1},{"text":"yatakları üzerinde uluyorlar.","poem":2},{"text":"Buğday ve yeni şarap için toplanıyorlar.","poem":1},{"text":"Benden yüz çeviriyorlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onları eğitip kollarını güçlendirdiğim halde,","poem":1},{"text":"bana karşı kötülük tasarlıyorlar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dönüyorlar, ama Yüce Olan'a değil.","poem":1},{"text":"Kusurlu yay gibiler.","poem":2},{"lineBreak":true},{"text":"Beyleri dillerinin hiddeti yüzünden kılıçla düşecek.","poem":2},{"lineBreak":true},{"text":"Mısır diyarında onların alay konusu bu olacak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}