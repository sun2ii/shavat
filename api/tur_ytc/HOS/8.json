{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“Boruyu dudaklarına yerleştir!",{"text":"Kartal gibi bir şey Yahve'nin evi üzerindedir,","poem":2},{"lineBreak":true},{"text":"çünkü antlaşmamı bozdular ve yasama karşı geldiler.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‘Tanrım, biz İsrael, seni tanıyoruz!’ diye bana feryat ediyorlar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İsrael iyi olanı reddetti.","poem":1},{"text":"Düşman onu kovalayacak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Krallar diktiler, ama benim aracılığımla değil.","poem":1},{"text":"Beyler yaptılar, ama ben onaylamadım.","poem":2},{"lineBreak":true},{"text":"Kesilip atılsınlar diye gümüşlerinden ve altınlarından","poem":2},{"lineBreak":true},{"text":"kendilerine putlar yaptılar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Samariya onun buzağı putunu atsın!","poem":1},{"text":"Öfkem onlara karşı alevlendi!","poem":2},{"lineBreak":true},{"text":"Ne zamana dek temizliğe erişemeyecekler?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü bu İsrael'dendir!","poem":1},{"text":"Onu işçi yaptı, ve o Tanrı değildir;","poem":2},{"lineBreak":true},{"text":"gerçekten, Samariya'nın buzağısı parçalanacak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü rüzgâr ekiyorlar,","poem":1},{"text":"ve kasırga biçecekler.","poem":2},{"text":"Ayakta duran buğdayı yok.","poem":1},{"text":"Sap baş vermeyecek.","poem":2},{"lineBreak":true},{"text":"Verse bile, yabancılar onu yutacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İsrael yutuldu.","poem":1},{"text":"Şimdi uluslar arasında değersiz bir şey gibiler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü onlar yalnız başına dolaşan","poem":1},{"text":"yaban eşeği gibi Aşur'a çıktılar.","poem":2},{"lineBreak":true},{"text":"Efraim kendine ücretli sevgililer tuttu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama uluslar arasında kendilerini satmış olsalar da,","poem":1},{"text":"şimdi onları toplayacağım;","poem":2},{"lineBreak":true},{"text":"ve güçlülerin kralının baskısından ötürü tükenmeye başlıyorlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü Efraim günah işlemek için sunakları çoğalttı,","poem":1},{"text":"onlar da onun için günah işlemek için sunaklar oldular.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ona yasamın birçok şeyini yazdım,","poem":1},{"text":"ama bunlar garip bir şey gibi sayıldı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sunularımın kurbanlarına gelince,","poem":1},{"text":"et kurban edip onu yiyorlar,","poem":2},{"lineBreak":true},{"text":"ama Yahve onları kabul etmiyor.","poem":2},{"text":"Şimdi onların suçlarını hatırlayacak,","poem":1},{"text":"ve günahlarını cezalandıracak.","poem":2},{"lineBreak":true},{"text":"Onlar Mısır'a dönecekler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü İsrael Yaratıcısı'nı unuttu ve saraylar yaptı;","poem":1},{"text":"Yahuda ise surlu kentleri çoğalttı;","poem":2},{"lineBreak":true},{"text":"ama ben onun kentleri üzerine ateş göndereceğim,","poem":2},{"lineBreak":true},{"text":"ve onun kalelerini yiyip bitirecek.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}