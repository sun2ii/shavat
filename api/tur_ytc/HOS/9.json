{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"HOS","translationId":"tur_ytc","name":"HOŞEA","commonName":"HOŞEA","title":"HOŞEA","order":28,"numberOfChapters":14,"sha256":"3ec5ed677bf41a25440b18dc8562cbd15bd394d68b439b6989374587acc82f2e","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Ey İsrael, uluslar gibi sevinçle coşma;",{"text":"çünkü sen Tanrın'a vefasızlık ettin.","poem":2},{"lineBreak":true},{"text":"Her harman yerinde fahişelik ücretini sevdin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Harman yeri ve şarap teknesi onları doyurmayacak,","poem":1},{"text":"yeni şarap da onu yüzüstü bırakacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve'nin ülkesinde oturmayacaklar;","poem":1},{"text":"ama Efraim Mısır'a dönecek,","poem":2},{"lineBreak":true},{"text":"ve Aşur'da kirli yiyecekler yiyecekler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve'ye şarap sunuları dökmeyecekler,","poem":1},{"text":"ve O'nu hoşnut etmeyecekler.","poem":2},{"lineBreak":true},{"text":"Kurbanları onlar için yas tutanların ekmeği gibi olacak;","poem":2},{"lineBreak":true},{"text":"ondan yiyenlerin hepsi kirli olacak;","poem":2},{"lineBreak":true},{"text":"çünkü ekmekleri kendi iştahları için olacak.","poem":2},{"lineBreak":true},{"text":"Yahve'nin evine girmeyecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve'nin kutsal toplantı gününde,","poem":1},{"text":"ve Yahve'nin bayramı gününde ne yapacaksınız?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü işte, yıkımdan kaçtıkları zaman,","poem":1},{"text":"Mısır onları toplayacak.","poem":2},{"lineBreak":true},{"text":"Memfis onları gömecek.","poem":2},{"lineBreak":true},{"text":"Isırganlar onların gümüşten güzel şeylerini ele geçirecek.","poem":2},{"lineBreak":true},{"text":"Çadırlarında dikenler olacak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ziyaret günleri geldi.","poem":1},{"text":"Hesap günleri geldi.","poem":2},{"text":"Senin günahlarının çokluğundan,","poem":1},{"text":"ve düşmanlığın büyük olduğu için,","poem":2},{"lineBreak":true},{"text":"İsrael, peygamberi akılsız,","poem":2},{"lineBreak":true},{"text":"esin alan adamı deli sayacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tanrım'la birlikte bir peygamber Efraim'i gözetiyor.","poem":1},{"text":"Onun bütün yollarında kuşçu tuzağı,","poem":2},{"lineBreak":true},{"text":"ve Tanrısı'nın evinde düşmanlık var.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Giva günlerinde olduğu gibi","poem":1},{"text":"kendilerini derinden bozdular.","poem":2},{"lineBreak":true},{"text":"Suçlarını hatırlayacak,","poem":2},{"lineBreak":true},{"text":"günahları için onları cezalandıracak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İsrael'i çöldeki üzümler gibi buldum.","poem":1},{"text":"Atalarınızı incir ağacının ilk yılındaki turfandası gibi gördüm;","poem":2},{"lineBreak":true},{"text":"ama Baal Peor'a geldiler ve kendilerini utanç verici şeye adadılar,","poem":2},{"lineBreak":true},{"text":"ve sevdikleri şey gibi iğrenç oldular.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim'e gelince, onların görkemi bir kuş gibi uçup gidecek.","poem":1},{"text":"Ne doğum, ne gebelik, ne de gebe kalma olacak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çocuklarını büyütseler bile,","poem":1},{"text":"onları çocuklarından edeceğim, öyle ki kimse kalmayacak.","poem":2},{"lineBreak":true},{"text":"Gerçekten, onlardan ayrıldığımda vay başlarına!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Efraim'i, Sur gibi, hoş bir yere dikilmiş gördüm;","poem":1},{"text":"ama Efraim çocuklarını caniye götürecek.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onlara ver—ey Yahve, ne vereceksin?","poem":1},{"text":"Onlara düşük yapan bir rahim ve kuru memeler ver.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Bütün kötülükleri Gilgal'dadır;","poem":1},{"text":"çünkü orada onlardan nefret ettim.","poem":2},{"lineBreak":true},{"text":"Çünkü işlerinin kötülüğü yüzünden onları evimden kovacağım!","poem":2},{"lineBreak":true},{"text":"Onları artık sevmeyeceğim.","poem":2},{"lineBreak":true},{"text":"Bütün beyleri asidir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efraim vuruldu.","poem":1},{"text":"Kökleri kurudu.","poem":2},{"lineBreak":true},{"text":"Meyve vermeyecekler.","poem":2},{"lineBreak":true},{"text":"Doğursalar bile, yine de rahimlerinin sevgililerini öldüreceğim.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanrım onları reddedecek, çünkü O'nu dinlemediler;","poem":1},{"text":"ve uluslar arasında dolaşıp duracaklar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}