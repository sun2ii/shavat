{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["O gün diyeceksiniz, “Sana şükredeceğim, ey Yahve; çünkü bana kızmış olsan da öfken döndü ve beni avuttun."]},{"type":"verse","number":2,"content":["İşte, Tanrı benim kurtuluşumdur. Güveneceğim ve korkmayacağım; çünkü Yah, Yahve benim gücüm ve ezgimdir; O benim kurtuluşum oldu.”"]},{"type":"verse","number":3,"content":["Bu nedenle kurtuluş kuyularından sevinçle su çekeceksiniz."]},{"type":"verse","number":4,"content":["O gün, “Yahve'ye şükredin!” diyeceksiniz. O'nun adını çağırın! Yaptıklarını halklar arasında duyurun! O'nun adının yüce olduğunu ilan edin!"]},{"type":"verse","number":5,"content":["Yahve'ye ezgiler söyleyin, çünkü O harika işler yaptı! Bütün yeryüzünde bu bilinsin!"]},{"type":"verse","number":6,"content":["Ey, Siyon'da oturanlar, yüksek sesle haykırın ve bağırın; çünkü aranızda olan İsrael'in Kutsalı büyüktür!”"]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tu