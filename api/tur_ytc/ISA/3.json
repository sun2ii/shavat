{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Çünkü işte,","poem":1},{"noteId":5},{"text":"Ordular Yahve'si olan Efendi, Yeruşalem'den ve","poem":1},{"text":"Yahuda'dan erzağı ve desteği, bütün ekmek erzağını, bütün su erzağını, kaldırıyor;","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"yiğidi,","poem":2},{"lineBreak":true},{"text":"savaşçıyı,","poem":2},{"lineBreak":true},{"text":"hakimi,","poem":2},{"lineBreak":true},{"text":"peygamberi,","poem":2},{"lineBreak":true},{"text":"falcıyı,","poem":2},{"lineBreak":true},{"text":"ihtiyarı,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"elli başıyı,","poem":2},{"lineBreak":true},{"text":"saygın adamı,","poem":2},{"lineBreak":true},{"text":"danışmanı,","poem":2},{"lineBreak":true},{"text":"hünerli işçiyi,","poem":2},{"lineBreak":true},{"text":"becerikli büyücüyü.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gençleri onlara bey olarak vereceğim,","poem":1},{"text":"çocuklar da onları yönetecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Halk, karşılıklı birbirine,","poem":1},{"text":"herkes komşusuna baskı yapacak.","poem":2},{"lineBreak":true},{"text":"Çocuk yaşlı adama karşı, kötü adam da saygın adama karşı gururla davranacak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gerçekten bir adam, babasının evinde kardeşini tutup şöyle diyecek:","poem":1},{"text":"“Giysilerin var, hükümdarımız sen ol ve bu yıkım senin elinin altında olsun.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adam, o gün şöyle haykıracak: “Ben şifacı olmayacağım;","poem":1},{"text":"çünkü evimde ne ekmek ne de giyecek var.","poem":2},{"lineBreak":true},{"text":"Beni halkın hükümdarı yapmayacaksınız.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü Yeruşalem harabe oldu, Yahuda düştü;","poem":1},{"text":"çünkü O'nun yüceliğinin gözlerini öfkelendirmek için","poem":2},{"lineBreak":true},{"text":"onların dilleri ve işleri Yahve'ye karşıdır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yüzlerinin görünüşü onlara karşı tanıklık ediyor.","poem":1},{"text":"Günahlarını Sodom gibi sergiliyorlar.","poem":2},{"lineBreak":true},{"text":"Bunu gizlemiyorlar.","poem":2},{"lineBreak":true},{"text":"Yazıklar olsun onların canlarına!","poem":2},{"lineBreak":true},{"text":"Çünkü kendi üzerlerine felaket getirdiler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Doğruya, onlar için iyi olacağını söyle;","poem":1},{"text":"çünkü onlar işlerinin ürününü yiyecekler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yazıklar olsun kötülere! Felaket onların üzerinedir;","poem":1},{"text":"çünkü kendi elleriyle yaptıklarının karşılığı onlara ödenecektir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Benim halkıma gelince, çocuklar onlara zulmetmektedir,","poem":1},{"text":"ve kadınlar onlara hükmetmektedir.","poem":2},{"lineBreak":true},{"text":"Halkım, sana yol gösterenler seni saptırıyorlar,","poem":2},{"lineBreak":true},{"text":"patikalarının yolunu bozuyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve çekişmek için ayağa kalkıyor,","poem":1},{"text":"halkları yargılamak için duruyor.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yahve halkının ihtiyarları ve önderleriyle yargıya girecek:","poem":1},{"text":"“Bağı yiyip bitiren sizsiniz. Yoksulun yağması evlerinizdedir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Halkımı ezmekle,","poem":1},{"text":"yoksulların yüzünü övütmekle ne demek istiyorsunuz?” diyor","poem":2},{"lineBreak":true},{"text":"Ordular Yahve'si Efendi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dahası Yahve şöyle dedi:","poem":1},{"text":"“Çünkü Siyon kızları kibirlidirler, boyunlarını uzatıp göz kırparak zarif adımlarla yürüyorlar,","poem":2},{"lineBreak":true},{"text":"ayaklarındaki halkaları şıngırdatıyorlar;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"bu yüzden Efendi Siyon kadınlarının başlarının tepesinde yaralar açacak,","poem":1},{"text":"Yahve onların kafa derilerini de kel edecek.''","poem":2}]},{"type":"verse","number":18,"content":["O gün Yahve onların halhallarını, baş çatlığı, hilal kolyelerini,"]},{"type":"verse","number":19,"content":["küpelerini, bileziklerini, peçelerini,"]},{"type":"verse","number":20,"content":["baş örtülerini, ayak zincirlerini, kuşaklarını, koku şişelerini, nazarlıklarını,"]},{"type":"verse","number":21,"content":["mühürlerini, yüzüklerini, burun halkalarını,"]},{"type":"verse","number":22,"content":["güzel kaftanlarını, örtülerini, şallarını, keselerini,"]},{"type":"verse","number":23,"content":["el aynalarını, ince keten giysilerini, taçlarını ve atkılarını o gün kaldırıp atacak."]},{"type":"verse","number":24,"content":[{"text":"Öyle olacak ki, hoş koku yerine çürük koku;","poem":1},{"text":"kemer yerine ip; biçimli saç yerine kellik;","poem":2},{"lineBreak":true},{"text":"kaftan yerine çul; ve güzellik yerine dağlanma olacak.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Adamlarınız kılıçla,","poem":1},{"text":"güçlüleriniz de savaşta düşecek.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Siyon'un kapıları yas tutacak, ağıt tutacak.","poem":1},{"text":"O, ıssız kalıp yere oturacak.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}