{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"İşte, bir kral doğrulukla hüküm sürecek,","poem":1},{"text":"beyler de adaletle yönetecektir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İnsan rüzgârdan saklanacak bir yer gibi,","poem":1},{"text":"fırtınadan korunacak bir örtü gibi,","poem":2},{"lineBreak":true},{"text":"kurak yerdeki akarsular gibi,","poem":2},{"lineBreak":true},{"text":"yorucu diyardaki büyük kaya gölgesi gibi olacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Görenlerin gözleri kararmayacak,","poem":1},{"text":"işitenlerin kulakları da dinleyecek.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Acelecinin yüreği bilgiyi anlayacak,","poem":1},{"text":"kekemelerin dili de açıkça konuşmaya hazır olacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Artık ahmağa soylu denilmeyecek,","poem":1},{"text":"alçağa da saygı gösterilmeyecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü ahmak kötülük yapmak,","poem":1},{"text":"Yahve'ye karşı sapık sözler söylemek,","poem":2},{"lineBreak":true},{"text":"aç olanın canını boşaltmak,","poem":2},{"lineBreak":true},{"text":"susayanın içeceğini bozmak için ahmakça konuşacak,","poem":2},{"lineBreak":true},{"text":"yüreği de kötülük işleyecek.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alçağın yolları kötüdür.","poem":1},{"text":"Yoksul doğru konuşsa bile,","poem":2},{"lineBreak":true},{"text":"alçakgönüllüleri yalan sözlerle yok etmek için","poem":2},{"lineBreak":true},{"text":"kötü düzenler tasarlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama asil kişi asil şeyler tasarlar,","poem":1},{"text":"asil şeyleri sürdürür.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayağa kalkın, ey rahat kadınlar! Sesimi duyun!","poem":1},{"text":"Ey kaygısız kızlar, sözüme kulak verin!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ey kaygısız kadınlar, günler bir yılı aşınca sıkıntı çekeceksiniz;","poem":1},{"text":"çünkü bağbozumu boşa çıkacak. Hasat gelmeyecek.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Titreyin, ey siz rahat kadınlar!","poem":1},{"text":"Sıkıntı çekin, ey kaygısızlar! Kendinizi soyun,","poem":2},{"lineBreak":true},{"text":"kendinizi çıplak edin, belinize çul sarının.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hoş tarlalar için ve verimli asma için","poem":1},{"text":"göğsünüzü dövün.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Halkımın toprağı üzerinde,","poem":1},{"text":"evet, neşeli kentin bütün neşe evleri üzerinde dikenler ve çalılar çıkacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü saray terk edilecek.","poem":1},{"text":"Kalabalık kent ıssız kalacak. Tepe ve gözetleme kulesi sonsuza dek inler,","poem":2},{"lineBreak":true},{"text":"yaban eşekleri için bir eğlence, sürüler için otlak olacak,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ta ki Ruh üzerimize yukarıdan dökülünceye,","poem":1},{"text":"çöl verimli tarla haline gelinceye,","poem":2},{"lineBreak":true},{"text":"verimli tarla da orman sayılana dek.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"O zaman adalet çölde oturacak;","poem":1},{"text":"doğruluk da verimli tarlada kalacaktır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doğruluğun işi esenlik olacak,","poem":1},{"text":"doğruluğun sonucu da sonsuz sakinlik ve güven olacaktır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Halkım huzurlu yerleşimlerde,","poem":1},{"text":"güvenli meskenlerde,","poem":2},{"lineBreak":true},{"text":"sakin rahat yerlerde yaşayacak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ama dolu ormanı dümdüz edecek,","poem":1},{"text":"kent de tamamen yerle bir olacak.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne mutlu size, bütün suların yanında tohum ekenlere,","poem":1},{"text":"öküzle eşeğin ayaklarını salanlara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}