{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Vay sana, ey harap eden, ama sen harap edilmedin,","poem":1},{"text":"ey ihanet eden, ama sen kimse tarafından ihanete uğramadın!","poem":2},{"text":"Harap etmeyi bitirince sen de harap edileceksin;","poem":1},{"text":"ihanetin sona erdiğinde de ihanete uğrayacaksın.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve, bize lütfet. Seni bekledik.","poem":1},{"text":"Her sabah gücümüz ol,","poem":2},{"lineBreak":true},{"text":"sıkıntı anında da kurtuluşumuz ol.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gök gürültüsünden halklar kaçtı.","poem":1},{"text":"Kendini yükselttiğinde uluslar dağılır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tırtılın topladığı gibi, ganimetiniz de öyle toplanacak.","poem":1},{"text":"İnsanlar da çekirgelerin sıçradığı gibi üzerine atlayacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve yücedir, çünkü O yüksekte oturur.","poem":1},{"text":"O, Siyon'u adalet ve doğrulukla doldurdu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Senin zamanlarında, bolluk, kurtuluş, bilgelik ve bilgi olacak.","poem":1},{"text":"Yahve korkusu senin hazinendir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, onların yiğitleri dışarıda feryat ediyor;","poem":1},{"text":"barış elçileri acı acı ağlıyor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ana yolları ıssız.","poem":1},{"text":"Gezen kimse kalmadı.","poem":2},{"lineBreak":true},{"text":"Antlaşma bozuldu.","poem":2},{"lineBreak":true},{"text":"Kentleri küçümsedi.","poem":2},{"lineBreak":true},{"text":"İnsana saygı duymadı.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ülke yas tutuyor ve zayıflıyor.","poem":1},{"text":"Lübnan şaşkına döndü ve sönüp gitti.","poem":2},{"lineBreak":true},{"text":"Şaron çöle benziyor,","poem":2},{"lineBreak":true},{"text":"başan ile Karmel çıplak kaldı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Şimdi kalkacağım” diyor Yahve.","poem":1},{"text":"“Şimdi kendimi yukarı kaldıracağım. Artık yüceleceğim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Samana gebe kalacaksınız.","poem":1},{"text":"Anız doğuracaksınız.","poem":2},{"lineBreak":true},{"text":"Kendi soluğunuz sizi yiyip bitirecek bir ateştir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Halklar yanan kireç gibi,","poem":1},{"text":"kesilip ateşte yakılan dikenler gibi olacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ey uzakta olanlar, yaptıklarımı duyun;","poem":1},{"text":"yakınlardaki sizler de kudretimi tanıyın.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Siyon'daki günahkârlar korkuyor.","poem":1},{"text":"Tanrısızları titreme sardı.","poem":2},{"text":"Aramızdan kim yiyip bitiren ateşle yaşayabilir?","poem":1},{"text":"Aramızda kim sonsuz yanmayla yaşayabilir?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Doğrulukla yürüyen","poem":1},{"text":"suçsuz da konuşan,","poem":2},{"lineBreak":true},{"text":"baskıyla elde edilen kazancı küçümseyen,","poem":2},{"lineBreak":true},{"text":"ellerini silken, rüşvet almayı reddeden,","poem":2},{"lineBreak":true},{"text":"kan dökmeyi duymamak için kulaklarını tıkayan,","poem":2},{"lineBreak":true},{"text":"kötülüğü görmemek için gözlerini kapatan kişi,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"yüksekte oturacak.","poem":1},{"text":"Onun savunma yeri kayalardan kaleler olacak.","poem":2},{"lineBreak":true},{"text":"Ekmeği sağlanacak.","poem":2},{"lineBreak":true},{"text":"Suları emin olacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gözlerin kralı güzelliğinde görecek.","poem":1},{"text":"Onlar uzak bir diyarı görecekler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yüreğin dehşeti düşünecek.","poem":1},{"text":"Hani sayan nerede?","poem":2},{"lineBreak":true},{"text":"Hani tartan nerede?","poem":2},{"lineBreak":true},{"text":"Hani kuleleri sayan nerede?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kavrayamadığın karışık konuşması olan halkı,","poem":1},{"text":"anlayamadığın tuhaf bir dille konuşan o sert halkı artık görmeyeceksin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Belli bayramlarımızın kenti Siyon'a bak.","poem":1},{"text":"Gözlerin, sakin bir yerleşim yeri,","poem":2},{"lineBreak":true},{"text":"yerinden kaldırılmayacak bir çadır olan Yeruşalem'i görecek.","poem":2},{"lineBreak":true},{"text":"Onun kazıkları asla sökülmeyecek,","poem":2},{"lineBreak":true},{"text":"hiçbir ipi de kopmayacak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ama Yahve orada,","poem":1},{"text":"geniş ırmakların ve derelerin olduğu,","poem":2},{"lineBreak":true},{"text":"hiçbir kürekli geminin gitmeyeceği,","poem":2},{"lineBreak":true},{"text":"hiçbir güçlü geminin geçmeyeceği bir yerde","poem":2},{"lineBreak":true},{"text":"görkemiyle bizimle birlikte olacak.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü Yahve bizim yargıcımızdır.","poem":1},{"text":"Yahve bizim yasa koyucumuzdur.","poem":2},{"lineBreak":true},{"text":"Yahve bizim Kralımız'dır.","poem":2},{"lineBreak":true},{"text":"Bizi O kurtaracak.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İplerin çözüldü.","poem":1},{"text":"Direklerinin ayağını güçlendiremediler.","poem":2},{"lineBreak":true},{"text":"Yelkeni açamadılar.","poem":2},{"lineBreak":true},{"text":"O zaman büyük bir ganimet avı paylaşıldı.","poem":2},{"lineBreak":true},{"text":"Topallar avı aldı.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Orada oturan, “Hastayım” demeyecek.","poem":1},{"text":"Orada oturan halkın suçu bağışlanacak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}