{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"Ey uluslar, duymak için yaklaşın!","poem":1},{"text":"Dinleyin ey halklar.","poem":2},{"lineBreak":true},{"text":"Yeryüzü ve içindekilerin tümü,","poem":2},{"lineBreak":true},{"text":"dünya ve ondan gelen her şey işitsin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü Yahve bütün uluslara karşı kızgın,","poem":1},{"text":"onların bütün ordularına öfkeli.","poem":2},{"text":"Onları tümüyle yok etti.","poem":1},{"text":"Onları boğazlanmak üzere teslim etti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onların öldürülenleri de dışarı atılacak,","poem":1},{"text":"cesetlerinin pis kokusu da ortaya çıkacak.","poem":2},{"lineBreak":true},{"text":"Dağlar onların kanında eriyecek.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gökyüzünün ordusunun tümü eriyecek.","poem":1},{"text":"Gökyüzü bir tomar gibi dürülecek,","poem":2},{"lineBreak":true},{"text":"asma ya da incir ağacı yaprağın solması gibi","poem":2},{"lineBreak":true},{"text":"onun bütün orduları gözden kaybolacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü kılıcım gökte doyasıya içti.","poem":1},{"text":"İşte, hüküm için Edom'un ve lanet ettiğim halkın üzerine inecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve'nin kılıcı kanla dolu.","poem":1},{"text":"Yağla, kuzuların ve keçilerin kanıyla, koç böbreklerinin yağıyla kaplıdır;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'nin Bosra'da bir kurbanı,","poem":2},{"lineBreak":true},{"text":"Edom diyarında da büyük bir kıyımı var.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaban öküzleri ve güçlü boğalarla birlikte genç boğalar da onlarla birlikte inecek;","poem":1},{"text":"ülkeleri kanla sarhoş olacak,","poem":2},{"lineBreak":true},{"text":"toprağı da yağdan yağlanacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü Yahve'nin bir öç alma günü,","poem":1},{"text":"Siyon davasının karşılığının bir yılı vardır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onun dereleri zift,","poem":1},{"text":"tozu kükürt,","poem":2},{"lineBreak":true},{"text":"diyarı yanan zift olacak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gece gündüz sönmeyecek.","poem":1},{"text":"Dumanı sonsuza dek tütecektir.","poem":2},{"lineBreak":true},{"text":"Kuşaktan kuşağa ıssız kalacak.","poem":2},{"lineBreak":true},{"text":"Hiç kimse sonsuza dek içinden geçmeyecek.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ama onu pelikan ve kirpi mülk edinecektir.","poem":1},{"text":"Baykuş ve karga orada oturacak.","poem":2},{"text":"Onun üzerine şaşkınlık ipi ve boşluk çekülü gerecek.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onun soylularını krallığa çağıracaklar,","poem":1},{"text":"ama orada kimse olmayacak;","poem":2},{"lineBreak":true},{"text":"onun bütün beyleri de bir hiç olacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Saraylarında dikenler, kalelerinde ısırgan ve deve dikenleri bitecek;","poem":1},{"text":"çakalların meskeni, deve kuşlarının avlusu olacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çölün vahşi hayvanları kurtlarla buluşacak,","poem":1},{"text":"yaban keçisi hemcinsine bağıracak.","poem":2},{"lineBreak":true},{"text":"Evet, gece yaratığı","poem":2},{"noteId":21},{"text":"oraya yerleşecek,","poem":2},{"lineBreak":true},{"text":"kendine de bir dinlenme yeri bulacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ok yılanı orada yuvasını yapacak,","poem":1},{"text":"yumurtlayacak, yavrularını çıkaracak ve kendi gölgesinde toplayacak.","poem":2},{"lineBreak":true},{"text":"Evet çaylaklar orada,","poem":2},{"lineBreak":true},{"text":"her biri kendi eşiyle toplanacaklar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve'nin kitabında araştırın ve okuyun:","poem":1},{"text":"Bunlardan hiçbiri eksik kalmayacak.","poem":2},{"lineBreak":true},{"text":"Hiçbiri eşinden yoksun kalmayacak.","poem":2},{"lineBreak":true},{"text":"Çünkü ağzım buyurdu,","poem":2},{"lineBreak":true},{"text":"O'nun Ruhu da onları topladı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Onlar için kura çekti,","poem":1},{"text":"eli bir ölçü ipiyle kurayı onlara böldü.","poem":2},{"lineBreak":true},{"text":"Sonsuza dek onu mülk edinecekler.","poem":2},{"lineBreak":true},{"text":"Kuşaktan kuşağa orada oturacaklar.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"kelimenin tam anlamıyla, gece iblisi veya gece canavarı da olabilen lilit","reference":{"chapter":34,"verse":14}}]},"thisChapterLink":"/api/tur_ytc/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}