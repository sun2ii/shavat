{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"Çöl ve kurak toprak sevinecek.","poem":1},{"text":"Çöl sevinecek ve gül gibi çiçek açacak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bol bol çiçeklenecek,","poem":1},{"text":"sevinçle ezgi söyleyerek coşacak.","poem":2},{"lineBreak":true},{"text":"Lübnan'ın görkemi, Karmel ve Şaron'un üstünlüğü ona verilecek.","poem":2},{"lineBreak":true},{"text":"Yahve'nin yüceliğini, Tanrımız'ın üstünlüğünü görecekler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zayıf elleri güçlendirin,","poem":1},{"text":"güçsüz dizleri sağlamlaştırın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yüreği korkak olanlara şunu söyleyin:","poem":1},{"text":"“Güçlü ol! Korkma!","poem":2},{"lineBreak":true},{"text":"İşte, sizin Tanrınız öç almak için, Tanrı'nın misillemesiyle gelecek.","poem":2},{"lineBreak":true},{"text":"O gelip sizi kurtaracak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O zaman körlerin gözleri açılacak,","poem":1},{"text":"sağırların kulakları açılacak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O zaman topal kişi geyik gibi sıçrayacak,","poem":1},{"lineBreak":true},{"text":"dilsizin dili de ezgi söyleyecek;","poem":1},{"text":"çünkü çölde sular, bozkırda dereler fışkıracak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kızgın kum havuza,","poem":1},{"text":"susuz toprak su pınarlarına dönecek.","poem":2},{"lineBreak":true},{"text":"Çakalların mesken tuttuğu yerde kamış,","poem":2},{"lineBreak":true},{"text":"sazlıkla çayır olacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Orada bir anayol, bir yol olacak,","poem":1},{"text":"ona 'Kutsal Yol' denecek. Kirli kişi oradan geçmeyecek,","poem":2},{"lineBreak":true},{"text":"ancak Yol'da yürüyenler için olacak.","poem":2},{"lineBreak":true},{"text":"Aşağılık ahmaklar oraya gitmeyecekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Orada aslan olmayacak,","poem":1},{"text":"yırtıcı hayvan onun üzerine çıkmayacak.","poem":2},{"lineBreak":true},{"text":"Onlar orada bulunmayacaklar;","poem":2},{"lineBreak":true},{"text":"ancak kurtulmuş olanlar orada yürüyecekler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O zaman Yahve'nin fidye ile kurtardıkları dönecek,","poem":1},{"text":"ezgilerle Siyon'a gelecekler;","poem":2},{"lineBreak":true},{"text":"başlarında da sonsuz sevinç olacak.","poem":2},{"lineBreak":true},{"text":"Sevinç ve neşe bulacaklar, üzüntü ve inilti kaçıp gidecek.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}