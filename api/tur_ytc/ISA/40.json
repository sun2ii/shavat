{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["“Avutun, halkımı avutun” diyor Tanrınız."]},{"type":"verse","number":2,"content":["“Yeruşalem'e rahatlatıp söyleyin ve ona, savaşının tamamlandığını, suçunun bağışlandığını, bütün günahlarına karşılık Yahve'nin elinden iki kat karşılık aldığını haykırın.”"]},{"type":"verse","number":3,"content":[{"text":"Çağıranın sesi şöyle diyor,","poem":1},{"text":"“Çölde Yahve'nin yolunu hazırlayın!","poem":2},{"lineBreak":true},{"text":"Tanrımız için bozkırda düz ana yol yapın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Her vadi yükseltilecek,","poem":1},{"text":"her dağ ve tepe alçaltılacak.","poem":2},{"lineBreak":true},{"text":"Engebeli yerler düz, sarp yerler de ova edilecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve'nin görkemi ortaya çıkacak,","poem":1},{"text":"bütün insanlık onu hep birlikte görecekler;","poem":2},{"lineBreak":true},{"text":"çünkü bunu Yahve'nin ağzı söyledi.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Birinin sesi “Bağır!” diyor.","poem":1},{"text":"Biri “Ne bağırayım?” dedi.","poem":2},{"lineBreak":true},{"text":"“Bütün insanlık ot gibidir,","poem":2},{"lineBreak":true},{"text":"onun bütün yüceliği de kır çiçeğine benzer.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ot kurur, çiçek solar, çünkü üzerine Yahve'nin soluğu eser.","poem":1},{"text":"Kuşkusuz insanlar ot gibidir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ot kurur, çiçek solar;","poem":1},{"text":"ama Tanrımız'ın sözü sonsuza dek durur.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey Siyon'a müjde veren, yüksek dağa çık.","poem":1},{"text":"Ey Yeruşalem'e müjde veren, sesini kuvvetle yükselt!","poem":2},{"lineBreak":true},{"text":"Yükselt! Korkma! Yahuda kentlerine,","poem":2},{"lineBreak":true},{"text":"“İşte, Tanrınız!” de.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İşte, Efendi Yahve yiğit biri gibi gelecek,","poem":1},{"text":"O'nun kolu da kendisi için hüküm sürecek.","poem":2},{"lineBreak":true},{"text":"İşte, karşılığı kendi yanındadır,","poem":2},{"lineBreak":true},{"text":"ödülü de kendi önündedir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sürüsünü bir çoban gibi güdecek.","poem":1},{"text":"Kuzuları kollarına alacak,","poem":2},{"lineBreak":true},{"text":"bağrında taşıyacak onları.","poem":2},{"lineBreak":true},{"text":"Yavrularını usul usul güdecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Avucunun içiyle suları ölçen,","poem":1},{"text":"karışıyla gökyüzünü işaretleyen,","poem":2},{"lineBreak":true},{"text":"ölçü sepetinde yerin tozunu hesaplayan,","poem":2},{"lineBreak":true},{"text":"dağları kantarla, tepeleri teraziyle tartan kimdir?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve'nin Ruhu'nu kim yönlendirdi,","poem":1},{"text":"ya da öğütçüsü olup O'na öğretti?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kime danıştı da O'nu bilgilendirdi,","poem":1},{"text":"O'nu adalet yolunda eğitti,","poem":2},{"lineBreak":true},{"text":"O'na bilgiyi öğretti,","poem":2},{"lineBreak":true},{"text":"O'na anlayış yolunu gösterdi?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte uluslar kovadaki bir damla gibidir,","poem":1},{"text":"terazideki toz zerresi gibi sayılır.","poem":2},{"lineBreak":true},{"text":"İşte, adaları küçücük bir şeymiş gibi havaya kaldırır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lübnan yakmak için yetmez,","poem":1},{"text":"onun hayvanları da yakmalık sunu için yetmez.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"O'nun önünde bütün uluslar bir hiç gibidir.","poem":1},{"text":"O'nun için hiçten aşağı ve boş sayılır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Öyleyse Tanrı'yı kime benzeteceksiniz?","poem":1},{"text":"Ya da hangi benzerliği O'na kıyas tutacaksınız?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bir işçi bir suret yaptı,","poem":1},{"text":"kuyumcu onu altınla kapladı,","poem":2},{"lineBreak":true},{"text":"ona gümüş zincirler döktü.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Böyle bir sunuya gücü yetmeyen yoksul kişi,","poem":1},{"text":"çürümez bir ağaç seçer.","poem":2},{"lineBreak":true},{"text":"Kendisi için yerinden oynamayacak oyma bir suret diksin diye usta işçi arar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bilmediniz mi?","poem":1},{"text":"Duymadınız mı?","poem":2},{"lineBreak":true},{"text":"Başlangıçtan beri size söylenmedi mi?","poem":2},{"lineBreak":true},{"text":"Dünyanın temellerinden anlamadınız mı?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yeryüzü dairesi üzerinde oturan O'dur,","poem":1},{"text":"onun sakinleri de çekirge gibidirler;","poem":2},{"lineBreak":true},{"text":"gökleri bir perde gibi geren,","poem":2},{"lineBreak":true},{"text":"onları içinde oturulacak bir çadır gibi yayan da O'dur,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"beyleri bir hiç eden,","poem":1},{"text":"yeryüzü hakimlerini boş kılan O'dur.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neredeyse hiç dikilmemişler.","poem":1},{"text":"Neredeyse hiç ekilmemişler.","poem":2},{"lineBreak":true},{"text":"Kütükleri neredeyse hiç kök salmamış.","poem":2},{"lineBreak":true},{"text":"Sadece üzerlerine üflüyor ve kuruyorlar,","poem":2},{"lineBreak":true},{"text":"kasırga da onları anız gibi alıp götürüyor.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“Öyleyse beni kime benzeteceksin?","poem":1},{"text":"Benim eşitim kim?” diyor Kutsal Olan.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gözlerinizi yukarı kaldırın da bunları kimin yarattığını,","poem":1},{"text":"ordularını sayıca çıkaranın kim olduğunu görün.","poem":2},{"lineBreak":true},{"text":"Hepsini adlarıyla çağırır. Kudretinin büyüklüğü sayesinde,","poem":2},{"lineBreak":true},{"text":"güçte kudretli olduğu için onlardan biri bile eksilmez.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neden, ey Yakov, ey İsrael,","poem":1},{"text":"“Yolumu Yahve görmüyor,","poem":2},{"lineBreak":true},{"text":"Tanrım hakkımı saymadı?” diye, konuşuyorsun?”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bilmedin mi?","poem":1},{"text":"Duymadın mı?","poem":2},{"lineBreak":true},{"text":"Dünyanın uçlarının Yaratıcısı,","poem":2},{"lineBreak":true},{"text":"sonsuz Tanrı Yahve zayıflamaz.","poem":2},{"lineBreak":true},{"text":"O yorulmaz.","poem":2},{"lineBreak":true},{"text":"O'nun anlayışı incelenemez.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Zayıflara güç verir.","poem":1},{"text":"Gücü olmayanın gücünü artırır.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gençler bile zayıflar ve bitkin düşer,","poem":1},{"text":"gençler tümüyle düşerler;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ama Yahve'yi bekleyenler güçlerini tazeleyecekler.","poem":1},{"text":"Kartal gibi kanatlarla yükselecekler.","poem":2},{"lineBreak":true},{"text":"Koşacaklar ve yorulmayacaklar.","poem":2},{"lineBreak":true},{"text":"Yürüyecekler ve zayıflamayacaklar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}