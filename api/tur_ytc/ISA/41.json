{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“Ey adalar, önümde sessiz olun da halklar güçlerini tazelesin.","poem":1},{"text":"Yaklaşsınlar,","poem":2},{"lineBreak":true},{"text":"sonra konuşsunlar.","poem":2},{"lineBreak":true},{"text":"Yargı için bir araya gelelim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Doğudan birini kim yükseltti?","poem":1},{"text":"Kim onu doğrulukla ayağa kaldırdı?","poem":2},{"lineBreak":true},{"text":"Ulusları ona teslim eder ve krallara hükmetmesini sağlar.","poem":2},{"lineBreak":true},{"text":"Onları toz gibi onun kılıcına,","poem":2},{"lineBreak":true},{"text":"rüzgârın sürdüğü anız gibi onun yayına veriyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onları kovalıyor,","poem":1},{"text":"hiç ayak basmamış olduğu bir yoldan da sağ salim geçiyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Başlangıçtan beri kuşakları çağırarak bunu kim işledi ve yaptı?","poem":1},{"text":"Ben, Yahve, birinci ve sonuncularla birlikteyim,","poem":2},{"lineBreak":true},{"text":"Ben O'yum.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adalar gördü ve korktu.","poem":1},{"text":"Yeryüzünün uçları titriyor.","poem":2},{"lineBreak":true},{"text":"Onlar yaklaşıp geliyorlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Herkes komşusuna yardım ediyor.","poem":1},{"text":"Kardeşlerine “Güçlü ol!” diyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Böylece marangoz kuyumcuyu teşvik ediyor.","poem":1},{"text":"Çekiçle düzelten, örse vuranı lehim için,","poem":2},{"lineBreak":true},{"text":"“İyi oldu” diyerek cesaretlendiriyor;","poem":2},{"lineBreak":true},{"text":"sarsılmasın diye onu çivilerle de sabitliyor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ama sen, ey hizmetkârım İsrael,","poem":1},{"text":"seçtiğim Yakov,","poem":2},{"lineBreak":true},{"text":"dostum Avraham'ın soyu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Seni dünyanın uçlarından tutup köşelerinden çağırdım,","poem":1},{"text":"sana şöyle dedim,","poem":2},{"lineBreak":true},{"text":"'Sen benim hizmetkârımsın.","poem":2},{"lineBreak":true},{"text":"Ben seni seçtim ve seni bir kenara atmadım.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Korkma, çünkü ben seninleyim.","poem":1},{"text":"Korkma, çünkü ben senin Tanrın'ım.","poem":2},{"lineBreak":true},{"text":"Seni güçlendireceğim.","poem":2},{"lineBreak":true},{"text":"Evet sana yardım edeceğim.","poem":2},{"lineBreak":true},{"text":"Evet, doğruluğumun sağ eliyle sana destek olacağım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İşte, sana öfkelenenlerin hepsi hayal kırıklığına uğrayacak ve şaşkına dönecek.","poem":1},{"lineBreak":true},{"text":"Seninle uğraşanlar bir hiç gibi olacaklar ve yok olacaklar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Onları, seninle çekişenleri arayacaksın ama bulamayacaksın.","poem":1},{"text":"Sana karşı savaşanlar bir hiç gibi,","poem":2},{"lineBreak":true},{"text":"hiç varolmamış gibi olacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü ben, Tanrın Yahve,","poem":1},{"text":"sağ elinden tutup sana, 'Korkma' diyeceğim.","poem":2},{"lineBreak":true},{"text":"'Ben sana yardım edeceğim.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Korkma, ey Yakov,","poem":1},{"text":"toprak kurdu ve siz İsraelliler.","poem":2},{"lineBreak":true},{"text":"Ben sana yardım edeceğim” diyor Yahve.","poem":2},{"lineBreak":true},{"text":"“Kurtarıcınız İsrael'in Kutsalı'dır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte, seni yeni, dişli, keskin bir harman döveni yaptım.","poem":1},{"text":"Dağları dövecek, onları ufalayacak,","poem":2},{"lineBreak":true},{"text":"tepeleri saman gibi edeceksin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onları savuracaksın,","poem":1},{"text":"rüzgâr onları götürecek, kasırga onları dağıtacak.","poem":2},{"lineBreak":true},{"text":"Sen Yahve ile sevineceksin.","poem":2},{"lineBreak":true},{"text":"İsrael'in Kutsalı'yla övüneceksin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoksullar ve muhtaçlar su arıyor ama yok.","poem":1},{"text":"Susuzluktan dilleri kuruyor.","poem":2},{"lineBreak":true},{"text":"Ben, Yahve onlara yanıt vereceğim.","poem":2},{"lineBreak":true},{"text":"Ben, İsrael'in Tanrısı, onları bırakmayacağım.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çıplak tepeler üzerinde ırmaklar,","poem":1},{"text":"vadilerin ortasında pınarlar açacağım.","poem":2},{"lineBreak":true},{"text":"Çölü su havuzu, kuru toprakları su pınarları yapacağım.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Çölde sedir, akasya, mersin ve zeytin ağaçları koyacağım.","poem":1},{"text":"Bozkırda selvi, çam ve şimşir ağaçlarını birlikte dikeceğim;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ta ki, bunu Yahve'nin elinin yaptığını,","poem":1},{"text":"bunu İsrael'in Kutsalı'nın yarattığını görebilsinler,","poem":2},{"lineBreak":true},{"text":"bilsinler, düşünsünler ve birlikte anlasınlar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Davanızı ortaya koyun” diyor Yahve.","poem":1},{"text":"“Güçlü delillerinizi ortaya çıkarın!”","poem":2},{"lineBreak":true},{"text":"Yakov'un Kralı diyor.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Ne olacağını bize duyursunlar ve bildirsinler!","poem":1},{"text":"Önceki şeylerin ne olduğunu açıklayın,","poem":2},{"lineBreak":true},{"text":"onları düşünelim de sonlarını bilelim;","poem":2},{"lineBreak":true},{"text":"ya da bize gelecek şeyleri gösterin.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bundan sonra olacak şeyleri bildirin ki,","poem":1},{"text":"sizin ilâhlar olduğunuzu bilelim.","poem":2},{"lineBreak":true},{"text":"Evet, iyilik yapın ya da kötülük yapın ki,","poem":2},{"lineBreak":true},{"text":"dehşete düşelim de bunu birlikte görelim.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"İşte, siz bir hiçsiniz,","poem":1},{"text":"işiniz de bir hiçtir.","poem":2},{"lineBreak":true},{"text":"Sizi seçen iğrençtir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“Kuzeyden birini yükselttim o da gün doğusundan geldi;","poem":1},{"text":"adımı çağıran biri;","poem":2},{"lineBreak":true},{"text":"o, çömlekçinin balçığı çiğnediği gibi,","poem":2},{"lineBreak":true},{"text":"çamur üzerindeymiş gibi hükümdarların üzerine gelecek.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bilmemiz için bunu başlangıçtan kim bildirdi,","poem":1},{"text":"öncesinden ki, 'O haklı' diyebilelim?","poem":2},{"lineBreak":true},{"text":"Gerçekten bildiren kimse yok.","poem":2},{"lineBreak":true},{"text":"Gerçekten gösteren kimse yok.","poem":2},{"lineBreak":true},{"text":"Gerçekten senin sözlerini duyan kimse yok.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Siyon'a, 'İşte, onlara bak' diyen ilk benim;","poem":1},{"text":"ve Yeruşalem'e müjde getireni ben vereceğim.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Baktığımda, kimse yok,","poem":1},{"text":"sorduğumda bir söz yanıt verebilecek aralarında bir öğütçü yok.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"İşte onların bütün yaptıkları boştur ve hiçtir.","poem":1},{"text":"Dökme suretleri rüzgâr ve karışıklıktır.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}