{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"verse","number":1,"content":[{"text":"“İşte, destek olduğum, canımın hoşnut olduğu seçilmiş hizmetkârım;","poem":1},{"text":"onun üzerine Ruhu'mu koydum. Uluslara adaleti getirecek.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bağırmayacak, sesini yükseltmeyecek,","poem":1},{"text":"sokakta işittirmeyecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O, ezilmiş kamışı kırmayacak.","poem":1},{"text":"Tüten fitili söndürmeyecek.","poem":2},{"lineBreak":true},{"text":"Adaleti sadakatle getirecektir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeryüzünde adaleti yerleştirene,","poem":1},{"text":"adalar onun yasasını bekleyene dek bırakmayacak,","poem":2},{"lineBreak":true},{"text":"cesareti kırılmayacaktır.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gökleri yaratan ve onları geren,","poem":1},{"text":"yeryüzünü ve ondan çıkanları yayan,","poem":2},{"lineBreak":true},{"text":"halkına soluk ve onda yürüyenlere ruh veren","poem":2},{"lineBreak":true},{"text":"Tanrı Yahve şöyle diyor:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ben Yahve, seni doğrulukla çağırdım.","poem":1},{"text":"Elini tutacağım.","poem":2},{"lineBreak":true},{"text":"Seni koruyacağım,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kör gözleri açman, mahkûmları zindandan,","poem":1},{"text":"karanlıkta oturanları zindandan çıkarman için","poem":2},{"lineBreak":true},{"text":"seni halk için bir antlaşma,","poem":2},{"lineBreak":true},{"text":"uluslara ışık yapacağım.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ben Yahve'yim. Adım budur.","poem":1},{"text":"Yüceliğimi bir başkasına, övgümü de oyma suretlere vermeyeceğim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"İşte, eski şeyler oldu ve ben yeni şeyler bildiriyorum.","poem":1},{"text":"Onlar olmadan önce size söylüyorum.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ey denize inenler ve ondaki her şey,","poem":1},{"text":"adalar ve orada yaşayanlar,","poem":2},{"lineBreak":true},{"text":"Yahve'ye yeni bir ezgi söyleyin,","poem":2},{"lineBreak":true},{"text":"dünyanın öbür ucundan da O'na övgüler sunun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çöl ve onun kentleri,","poem":1},{"text":"Kedar'ın sakinleri köyleriyle birlikte seslerini yükseltsinler.","poem":2},{"lineBreak":true},{"text":"Sela sakinleri ezgi söylesin.","poem":2},{"lineBreak":true},{"text":"Dağların tepesinden bağırsınlar!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yahve'ye yücelik versinler,","poem":1},{"text":"adalarda da O'nun övgüsünü bildirsinler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve güçlü bir yiğit gibi çıkacak.","poem":1},{"text":"Bir savaş adamı gibi gayretini uyandıracak.","poem":2},{"lineBreak":true},{"text":"Savaş çığlığı atacak.","poem":2},{"lineBreak":true},{"text":"Evet, yüksek sesle bağıracak.","poem":2},{"lineBreak":true},{"text":"Düşmanlarına karşı zafer kazanacaktır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Uzun zamandır sessizdim.","poem":1},{"text":"Sessiz kaldım ve kendimi tuttum.","poem":2},{"lineBreak":true},{"text":"Şimdi doğum yapan bir kadın gibi feryat edeceğim.","poem":2},{"lineBreak":true},{"text":"Hem nefesimi tutacağım, hem kesik kesik soluyacağım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dağları, tepeleri harap edeceğim,","poem":1},{"text":"onların bütün otlarını kurutacağım.","poem":2},{"lineBreak":true},{"text":"Irmakları ada yapacağım, havuzları kurutacağım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Körleri bilmedikleri bir yoldan getireceğim.","poem":1},{"text":"Onlara bilmedikleri yollarda öncülük edeceğim.","poem":2},{"lineBreak":true},{"text":"Önlerindeki karanlığı ışık, eğri yerleri düz edeceğim.","poem":2},{"lineBreak":true},{"text":"Bunları yapacağım ve onları bırakmayacağım.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Oyma suretlere güvenenler,","poem":1},{"text":"dökme suretlere 'Siz bizim ilâhlarımızsınız' diyenler geri döndürülecek.","poem":2},{"lineBreak":true},{"text":"Tümüyle hayal kırıklığına uğrayacaklar.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Duyun, ey sağırlar,","poem":1},{"text":"bakın, ey körler, ki göresiniz.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Benim hizmetkârımdan başka kör olan kimdir?","poem":1},{"text":"Ya da gönderdiğim ulağım kadar sağır olan kimdir?","poem":2},{"lineBreak":true},{"text":"Kim esenlik içinde olan kadar kör,","poem":2},{"lineBreak":true},{"text":"Yahve'nin hizmetkârı kadar kör olan kimdir?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çok şey görüyorsun ama farketmiyorsun.","poem":1},{"text":"Kulakları açık ama dinlemiyor.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kendi doğruluğu uğruna yasayı büyütmek,","poem":1},{"text":"onu saygın kılmak Yahve'yi hoşnut etti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ama bu soyulmuş ve talan edilmiş bir halktır.","poem":1},{"text":"Hepsi çukurlar tarafından yakalanmış, zindanlarda kapanmışlardır.","poem":2},{"lineBreak":true},{"text":"Tutsak oldular, kurtaran yok, yağmalandılar ve kimse,","poem":2},{"lineBreak":true},{"text":"'Onları geri verin!' demiyor.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Aranızda buna kulak verecek kim var?","poem":1},{"text":"Gelecek zamanı kim dinleyecek ve duyacak?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yakov'u yağma olarak, İsrael'i soygunculara kim verdi?","poem":1},{"text":"Kendisine karşı günah işlediğimiz Yahve değil mi?","poem":2},{"lineBreak":true},{"text":"Çünkü O'nun yollarında yürümediler,","poem":2},{"lineBreak":true},{"text":"O'nun yasasına da itaatsizlik ettiler.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bu nedenle öfkesinin kızgınlığını ve savaşın gücünü onun üzerine döktü.","poem":1},{"text":"Her tarafı ateşe verdi ama o bilmiyordu.","poem":2},{"lineBreak":true},{"text":"Onu yaktı ama o bunu yüreğine koymadı.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}