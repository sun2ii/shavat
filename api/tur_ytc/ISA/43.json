{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ama şimdi ey Yakov, seni yaratan, ey İsrael,","poem":1},{"text":"sana biçim veren Yahve şöyle diyor:","poem":2},{"lineBreak":true},{"text":"“Korkma, çünkü seni kurtardım.","poem":2},{"lineBreak":true},{"text":"Seni adınla çağırdım.","poem":2},{"lineBreak":true},{"text":"Sen benimsin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sulardan geçtiğinde ben seninle olacağım,","poem":1},{"text":"ırmakların içinden geçerken senin üzerine taşmayacak.","poem":2},{"lineBreak":true},{"text":"Ateşin içinden yürürken yanmayacaksın,","poem":2},{"lineBreak":true},{"text":"alev de seni yakmayacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü ben senin Tanrın Yahve'yim,","poem":1},{"text":"İsrael'in Kutsalı, senin Kurtarıcın.","poem":2},{"lineBreak":true},{"text":"Fidye olarak Mısır'ı,","poem":2},{"lineBreak":true},{"text":"senin yerine Etiyopya'yı ve Seva'yı verdim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gözümde değerli ve saygın olduğun ve seni sevdiğim için,","poem":1},{"text":"senin yerine insanları, yaşamının yerine ulusları vereceğim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Korkma, çünkü ben seninleyim.","poem":1},{"text":"Senin soyunu doğudan getirip seni batıdan toplayacağım.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuzeye, 'Onları bırak'","poem":1},{"text":"güneye de, 'Onları alıkoyma!' diyeceğim.","poem":2},{"lineBreak":true},{"text":"'Oğullarımı uzaklardan,","poem":2},{"lineBreak":true},{"text":"kızlarımı da yeryüzünün uçlarından,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adımla çağırılan ve yüceliğim için yarattığım,","poem":1},{"text":"kendisine biçim verdiğim,","poem":2},{"lineBreak":true},{"text":"evet yarattığım herkesi getir'” diyeceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gözleri olan kör halkı,","poem":1},{"text":"kulakları olan sağırları dışarı çıkar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bütün uluslar bir araya toplansın,","poem":1},{"text":"halklar da toplansın.","poem":2},{"lineBreak":true},{"text":"İçlerinden kim bunu bildirebilir,","poem":2},{"lineBreak":true},{"text":"bize eski şeyleri gösterebilir?","poem":2},{"lineBreak":true},{"text":"Tanıklarını getirsinler ki, haklı çıksınlar,","poem":2},{"lineBreak":true},{"text":"ya da duysunlar da “Bu doğrudur” desinler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Sizler benim tanıklarımsınız” diyor Yahve,","poem":1},{"text":"“Seçmiş olduğum hizmetkârımla birlikte;","poem":2},{"lineBreak":true},{"text":"ta ki beni tanıyıp da inanasınız","poem":2},{"lineBreak":true},{"text":"ve benim O olduğumu anlayasınız.","poem":2},{"lineBreak":true},{"text":"Benden önce Tanrı yoktu,","poem":2},{"lineBreak":true},{"text":"benden sonra da olmayacaktır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ben kendim Yahve'yim.","poem":1},{"text":"Benden başka kurtarıcı yok.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ben bildirdim, ben kurtardım ve ben gösterdim;","poem":1},{"text":"aranızda yabancı bir ilâh yoktur.","poem":2},{"lineBreak":true},{"text":"Bu nedenle sizler benim tanıklarımsınız” diyor Yahve,","poem":2},{"lineBreak":true},{"text":"“Ve ben Tanrı'yım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Evet, gün gün olduğundan beri ben O'yum.","poem":1},{"text":"Elimden kurtarabilecek kimse yok.","poem":2},{"lineBreak":true},{"text":"Ben işleyeceğim ve buna kim engel olabilir?”","poem":2}]},{"type":"verse","number":14,"content":["Kurtarıcınız, İsrael'in Kutsalı Yahve şöyle diyor: “Sizin uğrunuza Babil'e gönderdim, Keldaniler'i, sevinç duydukları gemilerinde kaçak olarak, onların hepsini indireceğim."]},{"type":"verse","number":15,"content":["Kutsalınız, İsrael'in Yaratıcısı, Kralınız Yahve benim.”"]},{"type":"verse","number":16,"content":["Denizde yol, ve güçlü sularda yol açan,"]},{"type":"verse","number":17,"content":[{"text":"savaş arabasını ve atı,","poem":1},{"text":"orduyu ve yiğidi ortaya çıkaran (onlar birlikte yatıyorlar,","poem":2},{"lineBreak":true},{"text":"kalkmayacaklar; onlar söndüler, fitil gibi söndüler) Yahve şöyle diyor:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Geçmiş şeyleri anmayın,","poem":1},{"text":"eski şeyleri düşünmeyin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İşte yeni bir şey yapacağım.","poem":1},{"text":"Artık ortaya çıkıyor.","poem":2},{"lineBreak":true},{"text":"Bilmiyor musun?","poem":2},{"lineBreak":true},{"text":"Hatta çölde yol, bozkırda ırmaklar yapacağım.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kır hayvanları, çakallar ve devekuşları beni sayacaklar;","poem":1},{"text":"çünkü halkıma, seçtiklerime içirmesi için çölde su,","poem":2},{"lineBreak":true},{"text":"bozkırda da ırmaklar veriyorum,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"o halk ki, övgülerimi ilan etsinler diye,","poem":1},{"text":"ona kendim için biçim verdim.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yine de beni çağırmadın ey Yakov;","poem":1},{"text":"ama sen benden usandın ey İsrael.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yakmalık sunular olarak bana koyunlarından birini getirmedin,","poem":1},{"text":"kurbanlarınla da beni onurlandırmadın.","poem":2},{"lineBreak":true},{"text":"Ben sana sunularla yük olmadım,","poem":2},{"lineBreak":true},{"text":"günnükle de seni usandırmadım.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bana parayla şeker kamışı almadın,","poem":1},{"text":"kurbanlarının yağıyla da beni doyurmadın, ama günahlarını sırtıma yükledin.","poem":2},{"lineBreak":true},{"text":"Kötülüklerinle beni usandırdın.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ben kendi uğruma suçlarınızı silen benim;","poem":1},{"text":"senin günahlarını da hatırlamayacağım.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bana hatırlat. Gelin hep birlikte itiraz edelim.","poem":1},{"text":"Davanı açıkla ki, haklı çıkasın.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İlk atan günah işledi,","poem":1},{"text":"öğretmenlerin bana karşı suç işledi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bu yüzden kutsal yerin beylerini kirleteceğim; ve Yakov'u lanete, İsrael'i de aşağılanmaya döndüreceğim.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}