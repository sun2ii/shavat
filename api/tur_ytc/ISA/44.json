{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"verse","number":1,"content":[{"text":"Ama şimdi dinle, hizmetkârım Yakov,","poem":1},{"text":"seçtiğim İsrael.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Seni yaratan, rahimden sana biçim veren,","poem":1},{"text":"sana yardım edecek olan Yahve şöyle diyor:","poem":2},{"lineBreak":true},{"text":"“Korkma, ey hizmetkârım Yakov;","poem":2},{"lineBreak":true},{"text":"ve sen, ey seçtiğim Yeşurun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü susamış olanın üzerine su,","poem":1},{"text":"kuru toprağın üzerine dereler dökeceğim.","poem":2},{"text":"Ruhumu senin soyunun üzerine,","poem":1},{"text":"bereketimi senin yavrularının üzerine dökeceğim;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ve onlar akarsu kenarlarındaki söğüt ağaçları gibi","poem":1},{"text":"Otlar arasında bitecekler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Biri, 'Ben Yahve'ye aitim' diyecek.","poem":1},{"text":"Bir diğeri Yakov'un adıyla çağrılacak;","poem":2},{"lineBreak":true},{"text":"bir başkası eline 'Yahve için' yazacak ve İsrael'in adını yüceltecek.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"İsrael Kralı Yahve ve onun Kurtarıcısı Ordular Yahvesi şöyle diyor:","poem":1},{"text":"“İlk benim, son da benim;","poem":2},{"lineBreak":true},{"text":"benden başka Tanrı da yoktur.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kim bana benziyor?","poem":1},{"text":"Eski halkı kurduğumdan beri,","poem":2},{"lineBreak":true},{"text":"kim çağıracak,","poem":2},{"lineBreak":true},{"text":"bunu ilan edecek,","poem":2},{"lineBreak":true},{"text":"ve benim için düzene koyacak?","poem":2},{"lineBreak":true},{"text":"Gelecek şeyleri ve olacak şeyleri hadi bildirsin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çekinme, korkma.","poem":1},{"text":"Bunu sana çok önceden bildirip göstermemiş miydim?","poem":2},{"lineBreak":true},{"text":"Sizler benim tanıklarımsınız.","poem":2},{"lineBreak":true},{"text":"Benden başka Tanrı var mı?","poem":2},{"lineBreak":true},{"text":"Gerçekten yok.","poem":2},{"lineBreak":true},{"text":"Ben başka bir Kaya bilmiyorum.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oyma suret yapan herkes boştur.","poem":1},{"text":"Zevk buldukları şeyler fayda getirmez.","poem":2},{"lineBreak":true},{"text":"Kendi tanıkları bile onların hayal kırıklığına uğrayabileceklerini","poem":2},{"lineBreak":true},{"text":"görmezler ve bilmezler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kim bir ilâha şekil verdi,","poem":1},{"text":"ya da hiçbir yararı olmayan bir suret döktü?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İşte, onun bütün arkadaşları hayal kırıklığına uğrayacak;","poem":1},{"text":"işçiler yalnızca insandır.","poem":2},{"lineBreak":true},{"text":"Hepsi bir araya toplansın.","poem":2},{"lineBreak":true},{"text":"Onlar ayağa kalksınlar.","poem":2},{"lineBreak":true},{"text":"Korkacaklar.","poem":2},{"lineBreak":true},{"text":"Birlikte utandırılacaklar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Demirci bir balta alır,","poem":1},{"text":"korla işler,","poem":2},{"lineBreak":true},{"text":"onu çekiçlerle şekillendirir ve güçlü koluyla onu işler.","poem":2},{"lineBreak":true},{"text":"Acıkır ve gücü tükenir;","poem":2},{"lineBreak":true},{"text":"su içmez ve bitkin düşer.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Marangoz bir ip uzatır.","poem":1},{"text":"Kalemle işaretler.","poem":2},{"lineBreak":true},{"text":"Raspayla şekillendirir.","poem":2},{"lineBreak":true},{"text":"Pergelle işaretleyip, evde otursun diye,","poem":2},{"lineBreak":true},{"text":"onu insan güzelliğinde, insan biçiminde yapar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kendisi için sedir ağaçlarını keser,","poem":1},{"text":"selvi ve meşe ağaçlarını alır,","poem":2},{"lineBreak":true},{"text":"orman ağaçları arasında birini kendisi için güçlendirir.","poem":2},{"lineBreak":true},{"text":"Bir selvi ağacı diker ve yağmur onu besler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O zaman insana yakacak olur;","poem":1},{"text":"bir kısmını alıp kendini ısıtır.","poem":2},{"lineBreak":true},{"text":"Evet onu yakar ve ekmek pişirir.","poem":2},{"lineBreak":true},{"text":"Evet, bir ilâh yapar ve ona tapar;","poem":2},{"lineBreak":true},{"text":"onu oyma bir suret yapar, önünde de kapanır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bir kısmını ateşte yakar.","poem":1},{"text":"Bir kısmıyla da et yer.","poem":2},{"lineBreak":true},{"text":"Kızartmalığı kızartır ve doyar.","poem":2},{"lineBreak":true},{"text":"Evet, ısınır ve şöyle der:","poem":2},{"lineBreak":true},{"text":"“Oh! Isındım. Ateş gördüm.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Geri kalanını bir ilâh, kendine bir oyma suret yapar.","poem":1},{"text":"Ona eğilir, tapınır, dua eder ve şöyle der:","poem":2},{"lineBreak":true},{"text":"“Kurtar beni, çünkü sen benim ilâhımsın!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bilmezler ve düşünmezler;","poem":1},{"text":"çünkü O, onların göremeyen gözlerini,","poem":2},{"lineBreak":true},{"text":"onların anlayamayan yüreklerini kapatmıştır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kimsede bilgi ve anlayış yok ki, düşünüp desin,","poem":1},{"text":"“Bir kısmını ateşte yaktım.","poem":2},{"lineBreak":true},{"text":"Evet, közleri üzerinde ekmek de pişirdim.","poem":2},{"lineBreak":true},{"text":"Eti kızartıp yedim.","poem":2},{"lineBreak":true},{"text":"Geri kalanını iğrenç bir şey mi yapayım?","poem":2},{"lineBreak":true},{"text":"Bir ağaç gövdesinin önünde eğileyim mi?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Külle beslenir.","poem":1},{"text":"Aldanmış yürek onu saptırdı;","poem":2},{"lineBreak":true},{"text":"canını kurtaramıyor,","poem":2},{"lineBreak":true},{"text":"“Sağ elimde yalan yok mu?” diyemiyor.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ey Yakov ve ey İsrael, bu şeyleri hatırla;","poem":1},{"text":"çünkü sen benim hizmetkârımsın.","poem":2},{"lineBreak":true},{"text":"Ben sana biçim verdim.","poem":2},{"lineBreak":true},{"text":"Sen benim hizmetkârımsın.","poem":2},{"lineBreak":true},{"text":"İsrael, benim tarafımdan unutulmayacaksın.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Koyu bulut gibi günahlarını,","poem":1},{"text":"bulut gibi suçlarını sildim.","poem":2},{"lineBreak":true},{"text":"Bana dön, çünkü seni fidye ile kurtardım.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ezgi söyleyin, ey gökler, çünkü bunu Yahve yaptı!","poem":1},{"text":"Bağırın, ey siz, yeryüzünün aşağı kısımları!","poem":2},{"lineBreak":true},{"text":"Ey dağlar, ey orman, bütün ağaçlarınız ezgi söylemeye başlayın,","poem":2},{"lineBreak":true},{"text":"çünkü Yahve Yakov'u fidye ile kurtardı ve İsrael'de kendini yüceltecektir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Seni fidye ile kurtaran,","poem":1},{"text":"sana rahimde biçim veren Yahve şöyle diyor:","poem":2},{"lineBreak":true},{"text":"“Ben her şeyi yaratan, gökleri tek başına geren,","poem":2},{"lineBreak":true},{"text":"yeryüzünü kendi kendime seren;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"yalancıların belirtilerini boşa çıkaran,","poem":1},{"text":"falcıları çılgına çeviren;","poem":2},{"lineBreak":true},{"text":"bilgeleri geri döndüren,","poem":2},{"lineBreak":true},{"text":"bilgilerini saçmalık eden;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"hizmetkârının sözünü doğrulayan,","poem":1},{"text":"ulakların öğütlerini yerine getiren;","poem":2},{"lineBreak":true},{"text":"Yeruşalem için, 'Onda oturulacak',","poem":2},{"lineBreak":true},{"text":"Yahuda kentleri için de, 'Onlar bina olacaklar,","poem":2},{"lineBreak":true},{"text":"onun yıkık yerlerini ayağa kaldıracağım' diyen;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"derinliğe 'Kuru,","poem":1},{"text":"senin ırmaklarını da kurutacağım' diyen,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Koreş için, 'O benim çobanımdır,","poem":1},{"text":"benim bütün arzumu yerine getirecektir' diyen,","poem":2},{"lineBreak":true},{"text":"Yeruşalem için de 'O bina edilecektir',","poem":2},{"lineBreak":true},{"text":"tapınak için 'Temelin atılacaktır' diyen Yahve benim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}