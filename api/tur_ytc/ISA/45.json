{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":["Önündeki ulusları boyun eğdirmek ve kralların zırhlarını çıkarmak ve kapılar kapanmasın diye önündeki kapıları açmak için sağ elinden tuttuğum Koreş'e, meshedilmişine, Yahve şöyle diyor:"]},{"type":"verse","number":2,"content":[{"text":"“Senin önünden gideceğim,","poem":1},{"text":"engebeli yerleri düz edeceğim.","poem":2},{"lineBreak":true},{"text":"Tunç kapıları parçalayacağım,","poem":2},{"lineBreak":true},{"text":"demir sürgüleri kıracağım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sana karanlığın hazinelerini,","poem":1},{"text":"gizli yerlerin saklı zenginliklerini vereceğim;","poem":2},{"lineBreak":true},{"text":"öyle ki, seni adınla çağıranın ben, Yahve,","poem":2},{"lineBreak":true},{"text":"İsrael'in Tanrısı olduğumu bilesin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hizmetkârım Yakov ve seçtiğim İsrael uğruna,","poem":1},{"text":"seni adınla çağırdım.","poem":2},{"lineBreak":true},{"text":"Beni tanımadığın halde sana bir ünvan verdim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ben Yahve'yim ve başka biri yok.","poem":1},{"text":"Benden başka Tanrı yoktur.","poem":2},{"lineBreak":true},{"text":"Beni tanımadığın halde seni güçlendireceğim;","poem":2},{"noteId":24}]},{"type":"verse","number":6,"content":[{"text":"ta ki, gün doğusundan ve batıdan olanlar,","poem":1},{"text":"benden başka kimsenin olmadığını bilsinler.","poem":2},{"lineBreak":true},{"text":"Ben Yahve'yim ve başka kimse yok.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Işığı ben biçimlendiririm ve karanlığı yaratırım.","poem":1},{"text":"Ben barışı yaparım ve felaketi yaratırım.","poem":2},{"lineBreak":true},{"text":"Bütün bunları yapan Yahve benim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey gökler, yukarıdan yağmur yağdırın,","poem":1},{"text":"gökyüzünden doğruluk yağsın.","poem":2},{"lineBreak":true},{"text":"Yeryüzü açılsın ki, kurtuluş üretsin,","poem":2},{"lineBreak":true},{"text":"onunla birlikte doğruluk türetsin.","poem":2},{"lineBreak":true},{"text":"Ben, Yahve, onu yarattım.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vay haline, yerin toprak çömleklerinin arasında bir toprak çömlek olup da","poem":1},{"text":"Yaratıcısı'yla çekişen adamın! Balçık kendisini yapana 'Ne yapıyorsun'","poem":2},{"lineBreak":true},{"text":"ya da elinin işi sana 'Onun elleri yok' der mi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Babasına, 'Neyin babası oldun?' ya da annesine,","poem":1},{"text":"'Ne doğurdun?' diyenin vay haline.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İsrael'in Kutsalı ve Yaratıcısı Yahve şöyle diyor:","poem":1},{"text":"“Oğullarımla ilgili olacak şeyleri bana sorun,","poem":2},{"lineBreak":true},{"text":"ellerimin işini bana buyurun!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ben yeryüzünü yarattım,","poem":1},{"text":"onun üzerinde insanı yarattım.","poem":2},{"lineBreak":true},{"text":"Benim ellerim gökleri gerdi.","poem":2},{"lineBreak":true},{"text":"Onların bütün ordularına ben buyruk verdim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ben onu doğrulukla yükselttim,","poem":1},{"text":"onun bütün yollarını düz edeceğim.","poem":2},{"lineBreak":true},{"text":"Kentimi o bina edecek,","poem":2},{"lineBreak":true},{"text":"sürgünlerimi bedel ya da ödül karşılığı olmadan,","poem":2},{"lineBreak":true},{"text":"salıverecek” diyor Ordular Yahvesi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yahve şöyle diyor: “Mısır'ın emeği,","poem":1},{"text":"Etiyopya'nın malı ve uzun boylu Sabalılar yanınıza gelecek,","poem":2},{"lineBreak":true},{"text":"onlar sizin olacak. Senin peşinden gidecekler.","poem":2},{"lineBreak":true},{"text":"Zincirlere vurularak gelecekler.","poem":2},{"lineBreak":true},{"text":"Size boyun eğecekler.","poem":2},{"lineBreak":true},{"text":"Sana şöyle yalvaracaklar:","poem":2},{"lineBreak":true},{"text":"'Gerçekten Tanrı sendedir;","poem":2},{"lineBreak":true},{"text":"başka kimse yok. Başka ilâh yok.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sen kesinlikle kendini gizleyen bir Tanrı'sın,","poem":1},{"text":"İsrael'in Tanrısı, Kurtarıcı.'”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hepsi hayal kırıklığına uğrayacak,","poem":1},{"text":"evet, şaşkına dönecekler.","poem":2},{"lineBreak":true},{"text":"Put yapıcılar hep birlikte şaşkınlığa düşecekler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"İsrael, Yahve tarafından sonsuz bir kurtuluşla kurtarılacak.","poem":1},{"text":"Sonsuz çağlar boyunca hayal kırıklığına uğramayacaksınız,","poem":2},{"lineBreak":true},{"text":"şaşkına dönmeyeceksiniz.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gökleri yaratan Yahve,","poem":1},{"text":"yeryüzüne biçim veren ve onu yaratan,","poem":2},{"lineBreak":true},{"text":"onu kuran ve onu ıssız bırakmak için yaratmayan,","poem":2},{"lineBreak":true},{"text":"üzerinde oturulsun diye biçim veren Tanrı şöyle diyor:","poem":2},{"lineBreak":true},{"text":"“Ben Yahve'yim. Başkası yok.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ben karanlık diyarın bir yerinde gizlice konuşmadım.","poem":1},{"text":"Yakov'un soyuna, 'Beni boşuna arayın' demedim.","poem":2},{"lineBreak":true},{"text":"Ben, Yahve, doğruluk konuşuyorum.","poem":2},{"lineBreak":true},{"text":"Doğru olan şeyleri bildiriyorum.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Toplanın da gelin.","poem":1},{"text":"Ey uluslardan kaçmış olan sizler, bir arada yaklaşın.","poem":2},{"lineBreak":true},{"text":"Oyma suret odununu taşıyanların,","poem":2},{"lineBreak":true},{"text":"kurtaramayan bir ilâha dua edenlerin bilgisi yoktur.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bunu bildirin ve sunun.","poem":1},{"text":"Evet, birlikte öğüt alsınlar.","poem":2},{"text":"Bunu çok eski zamanlardan kim gösterdi?","poem":1},{"text":"Kim bunu eski zamandan bildirdi? Ben, Yahve, değil miyim?","poem":2},{"text":"Benden başka Tanrı, adil Tanrı, Kurtarıcı yoktur.","poem":1},{"text":"Benim dışında kimse yok.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Ey dünya uçları, bana bakın kurtulun;","poem":1},{"text":"çünkü ben Tanrı'yım ve başkası yok.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kendimle ant içtim.","poem":1},{"text":"Söz ağzımdan doğrulukla çıktı ve geri alınmayacak;","poem":2},{"lineBreak":true},{"text":"her diz önümde çökecek, her dil bana ant içecek.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Benim için, 'Doğruluk ve güç yalnızca Yahve'de vardır' diyecekler.”","poem":1},{"text":"İnsanlar O'na gelecekler.","poem":2},{"lineBreak":true},{"text":"O'na karşı hiddetlenenlerin hepsi hayal kırıklığına uğrayacak.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"İsrael'in bütün soyu Yahve'de aklanacak ve sevinecekler!","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"veya donatmak","reference":{"chapter":45,"verse":5}}]},"thisChapterLink":"/api/tur_ytc/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}