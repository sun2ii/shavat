{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"Bel alçalıyor. Nebo eğiliyor.","poem":1},{"text":"Putları hayvanlar ve büyükbaş hayvanların üzerinde taşınıyor.","poem":2},{"lineBreak":true},{"text":"Taşıdığınız şeyler ağır yüklerdir, yorgunlara yüktür.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eğiliyorlar ve birlikte alçalıyorlar.","poem":1},{"text":"Yükü kurtaramadılar,","poem":2},{"lineBreak":true},{"text":"ama esaret altına gittiler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ey Yakov evi,","poem":1},{"text":"İsrael evinin bütün artakalanları,","poem":2},{"lineBreak":true},{"text":"doğumlarından beri,","poem":2},{"lineBreak":true},{"text":"rahimden beri taşımakta olduğum sizler,","poem":2},{"lineBreak":true},{"text":"beni dinleyin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaşlılığınıza kadar da ben O'yum,","poem":1},{"text":"saçlarınız ağardığında bile sizi ben taşıyacağım.","poem":2},{"lineBreak":true},{"text":"Ben yaptım ve katlanacağım.","poem":2},{"lineBreak":true},{"text":"Evet ben taşıyacağım ve kurtaracağım.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Beni kiminle kıyaslayacaksınız,","poem":1},{"text":"bana eşit sayacaksınız,","poem":2},{"lineBreak":true},{"text":"sanki aynıymışız gibi beni karşılaştıracaksınız?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bazıları keseden altın döküp gümüşü terazide tartıyorlar.","poem":1},{"text":"Bir kuyumcu tutarlar ve o da onu ilâh yapar.","poem":2},{"lineBreak":true},{"text":"Yere kapanırlar, evet tapınırlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onu omuzlarında taşırlar.","poem":1},{"text":"Onu götürürler, yerine koyarlar, o da orada durur.","poem":2},{"lineBreak":true},{"text":"Bulunduğu yerden kımıldamaz.","poem":2},{"lineBreak":true},{"text":"Evet, biri ona feryat edebilir ama o yanıt veremez.","poem":2},{"lineBreak":true},{"text":"Onu sıkıntısından kurtaramaz”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Bunu hatırlayın da adam olduğunuzu gösterin.","poem":1},{"text":"Bunu tekrar aklınızda tutun, ey siz suçlular.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eskinin geçmiş şeylerini hatırla;","poem":1},{"text":"çünkü ben Tanrı'yım ve başkası yok.","poem":2},{"lineBreak":true},{"text":"Ben Tanrı'yım ve benim gibisi yok.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sonu baştan, henüz olmamış şeyleri çok eski zamanlardan bildiririm.","poem":1},{"text":"Derim ki: Öğüdüm yerinde duracak,","poem":2},{"lineBreak":true},{"text":"ve ne dilersem onu yapacağım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Doğudan yırtıcı bir kuşu,","poem":1},{"text":"uzak ülkeden öğüdümün adamını çağıran benim.","poem":2},{"lineBreak":true},{"text":"Evet söyledim.","poem":2},{"lineBreak":true},{"text":"Onu da yerine getireceğim.","poem":2},{"lineBreak":true},{"text":"Ben tasarladım. Onu da yapacağım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dinleyin beni, ey inatçı yürekliler,","poem":1},{"text":"doğruluktan uzak olanlar!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ben doğruluğumu yaklaştırıyorum.","poem":1},{"text":"Uzakta değil, kurtarışım da beklemeyecek.","poem":2},{"lineBreak":true},{"text":"Yüceliğim olan İsrael için Siyon'a kurtuluş vereceğim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}