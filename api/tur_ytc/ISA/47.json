{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":["“Ey Babil'in el değmemiş kızı, aşağı in de toza otur.",{"text":"Keldaniler'in kızı, tahtsız yere otur.","poem":1},{"text":"Çünkü sana artık nazik ve narin denmeyecek.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Değirmen taşlarını al da un öğüt.","poem":1},{"text":"Peçeni çıkar, eteğini kaldır,","poem":2},{"lineBreak":true},{"text":"bacaklarını aç da ırmaklardan yürü.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çıplaklığın açılacak.","poem":1},{"text":"Evet, utancın görülecek.","poem":2},{"lineBreak":true},{"text":"Ben öç alacağım,","poem":2},{"lineBreak":true},{"text":"kimseyi de esirgemeyeceğim.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kurtarıcımız,","poem":1},{"text":"Ordular Yahvesi'dir O'nun adı,","poem":2},{"lineBreak":true},{"text":"İsrael'in Kutsalı'dır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Sessizce otur ve karanlığa gir,","poem":1},{"text":"ey Keldaniler'in kızı.","poem":2},{"lineBreak":true},{"text":"Çünkü sana artık krallıklar hanımı denmeyecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkıma kızgındım.","poem":1},{"text":"Mirasımı kirlettim ve onları senin eline verdim.","poem":2},{"lineBreak":true},{"text":"Sen onlara hiç merhamet göstermedin.","poem":2},{"lineBreak":true},{"text":"Yaşlıların üzerine çok ağır bir boyunduruk yükledin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sen, 'Sonsuza dek kraliçe olacağım' dedin,","poem":1},{"text":"bu şeyleri yüreğine koymadın,","poem":2},{"lineBreak":true},{"text":"sonuçlarını da düşünmedin.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ey zevk düşkünü, güvenlik içinde oturan,","poem":1},{"text":"yüreğinde, 'Ben varım ve benden başka kimse yok' diyen","poem":2},{"lineBreak":true},{"text":"sen, şimdi şunu dinle.","poem":2},{"lineBreak":true},{"text":"'Dul bir kadın olarak oturmayacağım, evlatlar kaybını da bilmeyeceğim.'","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ama şu iki şey başına bir günde, bir anda gelecektir:","poem":1},{"text":"Evlatlar kaybı ve dulluk.","poem":2},{"lineBreak":true},{"text":"Büyücülüğünün çokluğuna,","poem":2},{"lineBreak":true},{"text":"büyülerinin bolluğuna rağmen üzerine gelecekler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü sen kendi kötülüğüne güvendin.","poem":1},{"text":"‘Beni kimse görmüyor’ dedin.","poem":2},{"lineBreak":true},{"text":"Bilgeliğin ve bilgin seni saptırdı.","poem":2},{"lineBreak":true},{"text":"Yüreğinden, 'Ben varım,","poem":2},{"lineBreak":true},{"text":"benden başka kimse yok' dedin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bu yüzden başına felaket gelecek.”","poem":1},{"text":"Onun ne zaman doğacağını bilemezsin.","poem":2},{"lineBreak":true},{"text":"Fesat senin üzerine düşecek.","poem":2},{"lineBreak":true},{"text":"Onu bir kenara koyamayacaksın.","poem":2},{"lineBreak":true},{"text":"Bilmediğin ıssızlık ansızın üzerine gelecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Şimdi, gençliğinden beri emek verdiğin büyücülüğünle,","poem":1},{"text":"bol büyülerinle,","poem":2},{"lineBreak":true},{"text":"sanki yarar görebilecekmişsin gibi,","poem":2},{"lineBreak":true},{"text":"sanki galip gelecekmişsin gibi dur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Öğütlerinin çokluğundan yoruldun.","poem":1},{"text":"Şimdi astrologlar, yıldızlara bakanlar, aylık kehanetçiler ayağa kalkıp başına gelecek şeylerden seni kurtarsınlar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İşte, onlar anıza benziyorlar.","poem":1},{"text":"Ateş onları yakacak.","poem":2},{"lineBreak":true},{"text":"Kendilerini alevin gücünden kurtaramayacaklar.","poem":2},{"lineBreak":true},{"text":"O ne ısınacak bir kor,","poem":2},{"lineBreak":true},{"text":"ne de yanında oturulacak bir ateş olacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Emek verdiğin şeyler şöyle olacak:","poem":1},{"text":"Gençliğinden beri seninle ticaret yapanların her biri","poem":2},{"lineBreak":true},{"text":"Kendi yolunda dolaşacak. Seni kurtaracak kimse olmayacak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}