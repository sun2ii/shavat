{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"“Ey Yakov evi,","poem":1},{"text":"İsrael adıyla çağrılan ve Yahuda sularından çıkan sizler,","poem":2},{"lineBreak":true},{"text":"şunu dinleyin.","poem":2},{"lineBreak":true},{"text":"Yahve'nin adıyla ant içersiniz,","poem":2},{"lineBreak":true},{"text":"İsrael'in Tanrısı'ndan söz edersiniz,","poem":2},{"lineBreak":true},{"text":"ama gerçekte ya da doğrulukta değil.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü onlar kendilerini kutsal kentin yurttaşlarıyız derler,","poem":1},{"text":"İsrael'in Tanrısı'na güvenirler;","poem":2},{"lineBreak":true},{"text":"Ordular Yahvesi'dir O'nun adı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eskiden beri geçmişin şeylerini bildirdim.","poem":1},{"text":"Evet, bunlar ağzımdan çıktı, ben de onları ortaya çıkardım.","poem":2},{"lineBreak":true},{"text":"Bunları ansızın yaptım ve oldular.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü inatçı olduğunu,","poem":1},{"text":"boynunun demirden sinir, alnının da tunç olduğunu biliyordum;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"bu nedenle bunu sana eskiden beri bildirdim;","poem":1},{"text":"olmadan önce sana gösterdim;","poem":2},{"lineBreak":true},{"text":"öyle ki, 'Onları benim putum yaptı.","poem":2},{"lineBreak":true},{"text":"Oyulmuş suretim ve dökme suretim onları buyurdu' demeyesin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bunu duydun.","poem":1},{"text":"Şimdi bütün bunlara bak.","poem":2},{"lineBreak":true},{"text":"Peki sen bunu bildirmeyecek misin?”","poem":2},{"lineBreak":true},{"text":"“Şimdiden sana yeni şeyler gösterdim, hatta bilmediğin gizli şeyleri bile.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onlar eskiden değil, şimdi yaratıldılar.","poem":1},{"text":"'İşte, onları biliyordum' demeyesin diye","poem":2},{"lineBreak":true},{"text":"bugünden önce onları duymadın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Evet, duymadın.","poem":1},{"text":"Evet bilmedin.","poem":2},{"lineBreak":true},{"text":"Evet, eskiden beri kulağın açılmadı,","poem":2},{"lineBreak":true},{"text":"çünkü çok hain davrandığını,","poem":2},{"lineBreak":true},{"text":"ana rahminden sana günahkâr dendiğini biliyordum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adım uğruna öfkemi geciktireceğim,","poem":1},{"text":"övgümden dolayı, seni kesip atmayayım diye,","poem":2},{"lineBreak":true},{"text":"onu senin için geri tutacağım.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İşte, seni arıttım ama gümüş gibi değil.","poem":1},{"text":"Ben seni ızdırap ocağında seçtim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kendim için, kendi hatırım için bunu yapacağım;","poem":1},{"text":"adıma nasıl leke sürülür?","poem":2},{"lineBreak":true},{"text":"Yüceliğimi bir başkasına vermeyeceğim.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Dinle beni, ey Yakov ve çağırdığım İsrael:","poem":1},{"text":"İlk benim.","poem":2},{"lineBreak":true},{"text":"Son da benim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Evet, elim yeryüzünün temelini attı,","poem":1},{"text":"sağ elim de gökleri yaydı.","poem":2},{"lineBreak":true},{"text":"Ben onları çağırdığımda, hep birlikte ayağa kalkarlar.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Hepiniz toplanın ve dinleyin!","poem":1},{"text":"Onların arasında kim bu şeyleri bildirdi?","poem":2},{"lineBreak":true},{"text":"Yahve'nin sevdiği kişi O'nun istediğini Babil'e yapacak,","poem":2},{"lineBreak":true},{"text":"kolu Keldaniler'e karşı olacaktır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ben, ben söyledim.","poem":1},{"text":"Evet, onu çağırdım.","poem":2},{"lineBreak":true},{"text":"Ben onu getirdim,","poem":2},{"lineBreak":true},{"text":"o yolunda başarılı olacak.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Yanıma gelin ve şunu dinleyin:","poem":1},{"lineBreak":true},{"text":"Başlangıçtan beri gizlice söylemedim;","poem":1},{"text":"gerçekleştiği zamandan beri oradaydım.”","poem":2},{"text":"Şimdi Efendi Yahve beni Ruhu'yla gönderdi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kurtarıcın, İsrael'in Kutsalı","poem":1},{"text":"Yahve şöyle diyor:","poem":2},{"text":"“Yararlı olanı sana öğreten,","poem":1},{"text":"gitmen gereken yolda sana öncülük eden,","poem":2},{"lineBreak":true},{"text":"ben Tanrın Yahve'yim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Keşke buyruklarımı dinleseydin!","poem":1},{"text":"O zaman esenliğin ırmak gibi,","poem":2},{"lineBreak":true},{"text":"doğruluğun da denizin dalgaları gibi olurdu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Soyun da kum gibi,","poem":1},{"text":"bedeninden çıkan torunların da onun taneleri gibi olurdu.","poem":2},{"lineBreak":true},{"text":"Onun adı benden kesilip atılmazdı, önümden yok olmazdı.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Babil'i terk edin!","poem":1},{"text":"Keldaniler'den kaçın!","poem":2},{"text":"Sevinç haykırışlarıyla bunu duyurun,","poem":1},{"text":"dünyanın öbür ucuna kadar anlatın;","poem":2},{"lineBreak":true},{"text":"“Yahve hizmetkârı Yakov'u fidye ile kurtardı!” deyin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onları çöllerde götürürken susamadılar.","poem":1},{"text":"Onlar için kayadan sular akıttı.","poem":2},{"lineBreak":true},{"text":"Kayayı da yardı, sular da fışkırdı.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yahve, “Kötüler için esenlik yoktur” diyor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}