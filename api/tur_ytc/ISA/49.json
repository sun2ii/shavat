{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":[{"text":"Ey adalar, beni dinleyin.","poem":1},{"text":"Ey uzaktaki halklar, dinleyin: Yahve beni ana rahminden çağırdı;","poem":2},{"lineBreak":true},{"text":"annemin içinden benim adımı andı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ağzımı keskin bir kılıç gibi yaptı.","poem":1},{"text":"Beni elinin gölgesine sakladı.","poem":2},{"text":"Beni cilalı bir ok yaptı.","poem":1},{"text":"Kendi okluğunda beni sakladı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bana, “Sen benim kendisinde yüceltileceğim","poem":1},{"text":"hizmetkârım İsrael'sin” dedi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ama ben şöyle dedim: “Boşuna emek verdim.","poem":1},{"text":"Gücümü hiç için boşuna harcadım;","poem":2},{"text":"ama kesin olarak hakkım olan adalet Yahve'nin yanındadır,","poem":1},{"text":"karşılığı Tanrım'ın yanındadır.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Şimdi, rahimden bana hizmetkârı olmak için biçim veren Yahve,","poem":1},{"text":"Yakov'u yeniden kendisine getirmemi ve İsrael'i de O'nun yanında toplamamı söylüyor;","poem":2},{"lineBreak":true},{"text":"çünkü ben Yahve'nin gözünde saygınım,","poem":2},{"lineBreak":true},{"text":"Tanrı da benim gücüm oldu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gerçekten de şöyle diyor:","poem":1},{"text":"“Yakov'un oymaklarını yükseltmek,","poem":2},{"lineBreak":true},{"text":"İsrael'in korunmuş olanlarını geri getirmek üzere benim hizmetkârım olman çok hafif bir şey.","poem":2},{"text":"Üstelik seni uluslara ışık olarak vereceğim ki,","poem":1},{"text":"dünyanın ucuna kadar benim kurtarışım olasın.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İsrael'in Kurtarıcısı ve Kutsalı Yahve,","poem":1},{"text":"insanın küçümsediği kişiye, ulusun nefret ettiği kişiye, hükümdarların hizmetçisine şöyle diyor:","poem":2},{"text":"“Sadık olan Yahve'den, seni seçmiş olan İsrael'in Kutsalı'ndan dolayı","poem":1},{"text":"krallar görüp ayağa kalkacaklar, beyler görecekler ve tapınacaklar.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve şöyle diyor: “Kabul görme zamanında sana yanıt verdim.","poem":1},{"text":"Kurtuluş gününde sana yardım ettim.","poem":2},{"text":"Ülkeyi yükseltmek, ıssız mirası onlara mülk edindirmek için","poem":1},{"text":"seni koruyacağım ve seni halka bir antlaşma olarak vereceğim;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bağlı olanlara, 'Çıkın!';","poem":1},{"text":"karanlıkta olanlara, ‘Kendinizi gösterin!’ diyesin.”","poem":2},{"text":"“Onlar yollarda otlayacaklar,","poem":1},{"text":"bütün çıplak tepelerde otlakları olacak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aç kalmayacaklar,","poem":1},{"text":"susamayacaklar;","poem":2},{"lineBreak":true},{"text":"onlara ne sıcak ne de güneş çarpacak;","poem":2},{"lineBreak":true},{"text":"çünkü onlara merhamet eden, onlara önderlik edecektir.","poem":2},{"lineBreak":true},{"text":"Onları su pınarları yanına götürecektir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bütün dağlarımı yol yapacağım,","poem":1},{"text":"ana yollarım da yükseltilecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İşte, bunlar uzaktan gelecek;","poem":1},{"text":"işte, bunlar da kuzeyden ve batıdan,","poem":2},{"lineBreak":true},{"text":"bunlar da Sinim diyarından gelecek.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ey gökler, ezgi söyleyin, ey yeryüzü sevinçle coş!","poem":1},{"text":"Ey dağlar, ezgi söylemeye başlayın!","poem":2},{"text":"Çünkü Yahve halkını avuttu,","poem":1},{"text":"kederli olanlarına da acıyacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ama Siyon, “Yahve beni terk etti,","poem":1},{"text":"Efendi de beni unuttu” dedi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Bir kadın, emzikteki çocuğunu unutabilir mi ki,","poem":1},{"text":"kendi rahminin oğluna acımasın?","poem":2},{"text":"Evet bunlar unutabilir,","poem":1},{"text":"Ama ben seni unutmayacağım!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İşte, seni avuçlarıma kazıdım.","poem":1},{"text":"Duvarların sürekli karşımda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çocukların acele ediyor.","poem":1},{"text":"Yok edicilerin ve seni harap edenler senden ayrılıyor.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çepeçevre gözlerini kaldır da bak;","poem":1},{"text":"bunların hepsi toplanıp da sana geliyor.","poem":2},{"text":"Varlığım hakkı için.” diyor Yahve, “Gerçekten bunların hepsini bir süs gibi takınacaksın,","poem":1},{"text":"bir gelin gibi onları giyeceksin.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Çünkü çorak yerlerine, ıssız yerlerine","poem":1},{"text":"ve harap olmuş diyarına gelince,","poem":2},{"text":"o diyar artık sakinleri için gerçekten çok dar olacak,","poem":1},{"text":"seni yutanlar çok uzakta olacaklar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yitik çocukların kulaklarına şöyle diyecekler:","poem":1},{"text":"'Burası benim için çok dar. Bana yaşayacak bir yer ver.'","poem":2}]},{"type":"verse","number":21,"content":[{"text":"O zaman yüreğinden şöyle diyeceksin,","poem":1},{"text":"'Ben çocuklarımı yitirdiğim, yalnız, sürgünde ve oradan oraya dolaştığım halde bunlara benim için kim gebe kaldı?","poem":2},{"text":"Bunları kim büyüttü?","poem":1},{"text":"İşte, yalnız kalmıştım. Bunlar neredeydi?'”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Efendi Yahve şöyle diyor:","poem":1},{"lineBreak":true},{"text":"“İşte, uluslara elimi kaldıracağım,","poem":1},{"text":"halklara sancağımı kaldıracağım.","poem":2},{"lineBreak":true},{"text":"Senin oğullarını kucaklarında getirecekler,","poem":2},{"lineBreak":true},{"text":"senin kızlarını omuzlarında taşıyacaklar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Krallar sana süt baba,","poem":1},{"text":"onların kraliçeleri de sana sütanne olacaklar.","poem":2},{"text":"Yüzleri yere doğru önünde eğilip","poem":1},{"text":"ayaklarının tozunu yalayacaklar.","poem":2},{"text":"O zaman benim Yahve olduğumu bileceksin;","poem":1},{"text":"beni bekleyenler de hayal kırıklığına uğramayacaklar.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Güçlüden ganimet alınacak mı,","poem":1},{"text":"ya da yasal tutsaklar kurtarılacak mı?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ama Yahve şöyle diyor:","poem":1},{"text":"“Güçlünün de tutsakları alınacak,","poem":2},{"lineBreak":true},{"text":"ganimet de zalimden geri alınacak;","poem":2},{"text":"çünkü seninle çekişenle ben çekişeceğim","poem":1},{"text":"ve senin çocuklarını kurtaracağım.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sana zulmedenleri kendi etleriyle doyuracağım;","poem":1},{"text":"tatlı şarap içmiş gibi kendi kanlarıyla sarhoş olacaklar.","poem":2},{"lineBreak":true},{"text":"O zaman bütün insanlık bilecek ki, ben Yahve, senin Kurtarıcın,","poem":2},{"lineBreak":true},{"text":"seni fidye ile kurtaran, Yakov'un Güçlüsü'yüm.''","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}