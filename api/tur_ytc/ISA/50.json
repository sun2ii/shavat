{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve şöyle diyor: “Annenizi onunla bıraktığım boşanma belgesi nerede?","poem":1},{"text":"Ya da sizi alacaklılarımdan hangisine sattım?","poem":2},{"text":"İşte, kötülükleriniz nedeniyle satıldınız,","poem":1},{"text":"anneniz de suçlarınız yüzünden bırakıldı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ben geldiğim zaman neden kimse yoktu?","poem":1},{"text":"Çağırdığımda neden yanıt verecek kimse yoktu?","poem":2},{"text":"Elim, fidye ile kurtaramayacak kadar kısa mı? Ya da kurtaracak gücüm yok mu?","poem":1},{"text":"İşte, azarlamamla denizi kuruturum.","poem":2},{"lineBreak":true},{"text":"Irmakları çöle çeviririm. Balıkları su olmadığı için kokar ve susuzluktan ölür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gökleri karanlıkla kaplarım.","poem":1},{"text":"Ben onların örtüsünü çul ederim.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Efendi Yahve bana eğitilenlerin dilini verdi,","poem":1},{"text":"öyle ki, yorgun olana sözlerle nasıl destek olacağımı bileyim.","poem":2},{"text":"O, her sabah uyandırır,","poem":1},{"text":"eğitilenler gibi duysun diye kulağımı uyandırır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Efendi Yahve kulağımı açtı.","poem":1},{"text":"Ben isyankâr değildim.","poem":2},{"lineBreak":true},{"text":"Geri dönmedim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beni dövenlere sırtımı,","poem":1},{"text":"saçımı yolanlara yanaklarımı verdim.","poem":2},{"lineBreak":true},{"text":"Utançtan ve tükürükten yüzümü gizlemedim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü Efendi Yahve bana yardım edecek.","poem":1},{"text":"Bu nedenle şaşkın değilim.","poem":2},{"text":"Bu yüzden yüzümü çakmaktaşı gibi ettim,","poem":1},{"text":"hayal kırıklığına uğramayacağımı da biliyorum.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Beni aklayan yakındır.","poem":1},{"text":"Kim bana karşı suçlamada bulunacak?","poem":2},{"text":"Gelin birlikte ayağa kalkalım.","poem":1},{"text":"Düşmanım kim?","poem":2},{"lineBreak":true},{"text":"O bana yaklaşsın.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"İşte, Efendi Yahve bana yardım edecek!","poem":1},{"text":"Beni suçlu çıkaracak olan kimdir?","poem":2},{"text":"İşte onların hepsi bir elbise gibi eskiyecekler.","poem":1},{"text":"Güveler onları yiyip bitirecek.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aranızda Yahve'den korkan,","poem":1},{"text":"Hizmetkârının sözünü dinleyen kimdir?","poem":2},{"text":"Karanlıkta yürüyen ve ışığı olmayan kişi,","poem":1},{"lineBreak":true},{"text":"Yahve'nin adına güvensin ve Tanrısı'na güvensin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"İşte, ateş tutuşturanlar,","poem":1},{"text":"etrafındaki meşalelerle kendini süsleyen sizler,","poem":2},{"text":"hepiniz ateşinizin alevinde,","poem":1},{"text":"ve tutuşturduğunuz meşalelerin arasında yürüyün.","poem":2},{"text":"Bunu elimden alacaksınız:","poem":1},{"text":"Acı içinde yatacaksınız.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}