{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"“Ey doğruluk peşinden gidenler,","poem":1},{"text":"Yahve'yi arayanlar, beni dinleyin.","poem":2},{"text":"Kesildiğin kayaya, kazıldığın taş ocağına bak.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Atanız Avraham'a, sizi doğuran Sarah'a bakın;","poem":1},{"lineBreak":true},{"text":"çünkü daha bir kişiyken onu çağırdım,","poem":1},{"text":"onu kutsadım ve çoğalttım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü Yahve Siyon'u avuttu.","poem":1},{"text":"Onun bütün ıssız yerlerini teselli etti,","poem":2},{"lineBreak":true},{"text":"onun çölünü Aden gibi,","poem":2},{"lineBreak":true},{"text":"bozkırını da Yahve'nin bahçesi gibi yaptı.","poem":2},{"text":"Onlarda neşe ve sevinç,","poem":1},{"text":"şükran ve nağme sesi bulunacak.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Dinle beni, ey halkım;","poem":1},{"text":"duy beni, ey ulusum,","poem":2},{"text":"çünkü benden yasa çıkacak,","poem":1},{"text":"halklara ışık olmak üzere adaletimi yerleştireceğim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doğruluğum yakındır.","poem":1},{"text":"Kurtarışım dışarı çıktı,","poem":2},{"lineBreak":true},{"text":"kollarım da halkları yargılayacak.","poem":2},{"text":"Adalar beni bekleyecek,","poem":1},{"text":"onlar da benim koluma güvenecekler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gözlerinizi göklere kaldırın,","poem":1},{"text":"aşağıdaki yeryüzüne bakın;","poem":2},{"text":"çünkü gökler duman gibi dağılacak,","poem":1},{"text":"yeryüzü de elbise gibi eskiyecek.","poem":2},{"text":"Onun sakinleri de aynı şekilde ölecekler","poem":1},{"text":"ama benim kurtarışım sonsuz olacak,","poem":2},{"lineBreak":true},{"text":"doğruluğum da ortadan kalkmayacak.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ey doğruluğu bilen sizler,","poem":1},{"text":"yüreğinde yasam bulunan halk, beni dinleyin.","poem":2},{"text":"İnsanların hakaretlerinden korkmayın,","poem":1},{"text":"onların sövmelerinden yılmayın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü güve onları giysi gibi yiyip bitirecek,","poem":1},{"text":"kurt da yün gibi yiyecek;","poem":2},{"text":"ama doğruluğum sonsuz,","poem":1},{"text":"ve kurtarışım tüm kuşaklara olacak.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uyan, uyan, gücü kuşan, ey Yahve'nin kolu!","poem":1},{"text":"Uyan, eski günlerde,","poem":2},{"lineBreak":true},{"text":"çok eski zaman kuşaklarında olduğu gibi.","poem":2},{"text":"Rahav'ı parçalayan,","poem":1},{"text":"canavarı delen sen değil misin?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Denizi, büyük derinliğin sularını kurutan","poem":1},{"text":"Sen değil misin?","poem":2},{"lineBreak":true},{"text":"Fidye ile kurtarılanların geçmesi için","poem":2},{"lineBreak":true},{"text":"denizin derinliklerini kim yol yaptı?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve'nin fidyeyle kurtardıkları geri dönecek,","poem":1},{"text":"ezgi söyleyerek Siyon'a gelecekler.","poem":2},{"lineBreak":true},{"text":"Başları üzerinde sonsuz sevinç olacak.","poem":2},{"text":"Sevinç ve neşe bulacaklar.","poem":1},{"text":"Keder ve inilti kaçıp gidecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Benim, seni avutan benim.","poem":1},{"text":"Sen kimsin ki ölecek insandan,","poem":2},{"lineBreak":true},{"text":"ot gibi olacak insanoğlundan korkuyorsun?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gökleri geren ve yeryüzünün temellerini atan","poem":1},{"text":"Yaratıcın Yahve'yi unuttun mu?","poem":2},{"text":"Zorba, yok etmek için hazırlanırken","poem":1},{"text":"hiddetinden ötürü bütün gün sürekli korku içinde mi yaşıyorsun?","poem":2},{"lineBreak":true},{"text":"Zorbanın hiddeti nerede?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sürgündeki tutsak hızla serbest bırakılacak.","poem":1},{"text":"Ölmeyecek ve çukura inmeyecek.","poem":2},{"lineBreak":true},{"text":"Ekmeği tükenmeyecek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Çünkü ben onun dalgaları kükresin diye,","poem":1},{"text":"denizi karıştıran senin Tanrın Yahve'yim.","poem":2},{"lineBreak":true},{"text":"Ordular Yahvesi'dir O'nun adı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gökleri dikmek, yeryüzünün temellerini atmak,","poem":1},{"text":"Siyon'a, 'Sen benim halkımsın' demek için sözlerimi ağzına koydum,","poem":2},{"lineBreak":true},{"text":"seni elimin gölgesiyle örttüm.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uyan, uyan!","poem":1},{"text":"Ayağa kalk, ey Yeruşalem,","poem":2},{"lineBreak":true},{"text":"Yahve'nin gazabının kâsesini elinden içmiş olan sizler.","poem":2},{"text":"Sersemlik kâsesini içtin ve onu boşalttın.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Doğurduğu bütün oğulları arasında ona yol gösteren kimse yok;","poem":1},{"text":"yetiştirdiği bütün oğulları arasında onun elinden tutan kimse yok.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Başına bu iki şey geldi;","poem":1},{"text":"kim seninle birlikte üzülecek?","poem":2},{"text":"Issızlık ve yıkım,","poem":1},{"text":"kıtlık ve kılıç;","poem":2},{"lineBreak":true},{"text":"seni nasıl avutayım?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oğulların bitkin düştü.","poem":1},{"text":"Ağa takılan geyik gibi, bütün sokak başlarında yatıyorlar.","poem":2},{"text":"Onlar Yahve'nin gazabıyla,","poem":1},{"text":"Tanrın'ın azarıyla dolu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ey dertli, sarhoşsun, ama şarapla değil,","poem":1},{"text":"bu nedenle şimdi şunu dinle;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Efendin Yahve,","poem":1},{"text":"halkının davasını savunan Tanrın şöyle diyor:","poem":2},{"text":"“İşte, elinden sersemlik kâsesini,","poem":1},{"text":"gazabımın kâsesini aldım.","poem":2},{"lineBreak":true},{"text":"Artık bir daha onu içmeyeceksin.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Onu sana eziyet edenlerin, canına,","poem":1},{"text":"'Eğil de senin üzerinden yürüyelim' diyenlerin eline vereceğim;","poem":2},{"lineBreak":true},{"text":"sen de sırtını toprak gibi, sokak gibi üzerinde yürüyenlere serdin.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}