{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Uyan, uyan! Gücünü kuşan ey Siyon.","poem":1},{"text":"Güzel giysilerini giyin, kutsal kent Yeruşalem;","poem":2},{"lineBreak":true},{"text":"çünkü bundan böyle sünnetsiz ve kirli olanlar artık sana girmeyecek.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kendini tozdan silkele!","poem":1},{"text":"Kalk, otur, Yeruşalem!","poem":2},{"lineBreak":true},{"text":"Kendini boynunun bağlarından kurtar, Siyon'un sürgün kızı!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü Yahve şöyle diyor: “Hiçe satıldınız;","poem":1},{"text":"parasız olarak da kurtarılacaksınız.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Efendi Yahve şöyle diyor:","poem":1},{"lineBreak":true},{"text":"“Halkım ilk başta orada yaşamak için Mısır'a indi;","poem":1},{"text":"Aşurlular da onlara nedensiz yere zulmettiler.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Halkımın bir hiç uğruna götürüldüğünü görünce","poem":1},{"text":"şimdi ben burada ne yapayım” diyor Yahve.","poem":2},{"text":"“Onlara hükmedenler alay ediyor” diyor Yahve,","poem":1},{"text":"“Gün boyu sürekli adıma küfrediliyor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu nedenle halkım adımı bilecek.","poem":1},{"text":"Bu yüzden o gün konuşanın ben olduğumu anlayacaklar.","poem":2},{"lineBreak":true},{"text":"İşte, O benim.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Müjde getirenin,","poem":1},{"text":"esenliği duyuranın,","poem":2},{"lineBreak":true},{"text":"iyi haberi getirenin,","poem":2},{"lineBreak":true},{"text":"kurtuluşu ilan edenin,","poem":2},{"lineBreak":true},{"text":"Siyon'a, “Tanrın hüküm sürüyor!” diyenin","poem":2},{"lineBreak":true},{"text":"dağlar üzerindeki ayakları ne güzeldir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nöbetçilerin seslerini yükseltiyor.","poem":1},{"text":"Birlikte ezgi söylüyorlar;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve Siyon'a döndüğünde onlar göz göze görecekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sevinmeye başlayın!","poem":1},{"text":"Birlikte ezgi söyleyin, ey Yeruşalem'in yıkık yerleri;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve halkını avuttu.","poem":2},{"lineBreak":true},{"text":"Yeruşalem'i fidyeyle kurtardı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve bütün ulusların gözü önünde kutsal kolunu apaçık gösterdi.","poem":1},{"text":"Yeryüzünün bütün uçları Tanrımız'ın kurtarışını gördü.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ayrılın! Ayrılın! Çıkın oradan! Kirli olan hiçbir şeye dokunmayın!","poem":1},{"text":"Onun içinden çıkın!","poem":2},{"lineBreak":true},{"text":"Ey Yahve'nin kaplarını taşıyanlar, kendinizi arındırın.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü aceleyle çıkmayacaksınız,","poem":1},{"text":"kaçarak da gitmeyeceksiniz;","poem":2},{"text":"çünkü Yahve önünüzden gidecek","poem":1},{"text":"ve İsrael'in Tanrısı ardınızda korumanız olacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İşte, hizmetkârım akıllıca davranacak.","poem":1},{"text":"O, yüceltilecek, yükseltilecek,","poem":2},{"lineBreak":true},{"text":"ve çok yüce olacaktır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Birçokları sana nasıl hayret ettiyse,","poem":1},{"text":"onun görünüşü herkesten daha çok, biçimi de insanoğullarından daha çok bozulmuştu;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O da birçok ulusu temizleyecek.","poem":1},{"noteId":25},{"text":"Krallar onun önünde ağızlarını kapatacaklar;","poem":2},{"lineBreak":true},{"text":"çünkü kendilerine söylenmemiş olanı görecekler,","poem":2},{"lineBreak":true},{"text":"duymadıklarını da anlayacaklar.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"veya serpmek","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/tur_ytc/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}