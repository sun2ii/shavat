{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Haberimize kim inandı?","poem":1},{"text":"Yahve'nin kolu kime açıklandı?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü o, onun önünde körpe bir fidan gibi,","poem":1},{"text":"kuru topraktan bir kök gibi büyüdü.","poem":2},{"text":"Ne güzelliği ne de heybeti vardı.","poem":1},{"text":"Ona baktığımızda onu arzulayalım diye hiçbir güzellik yoktu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O, insanlar tarafından hor görüldü ve reddedildi;","poem":1},{"text":"hastalıkları yakından tanıyan acılar adamıydı.","poem":2},{"text":"İnsanların kendisinden yüzlerini gizledikleri biri gibi hor görüldü;","poem":1},{"text":"ve biz ona saygı duymadık.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kesin olarak hastalıklarımızı o üstlendi,","poem":1},{"text":"acılarımızı da o taşıdı;","poem":2},{"text":"bizse onun cezalandırıldığını,","poem":1},{"text":"Tanrı tarafından vurulup acı çektiğini düşündük.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama bizim suçlarımız yüzünden o yaralandı.","poem":1},{"text":"Bizim kötülüklerimiz için o ezildi.","poem":2},{"text":"Esenliğimizi getiren ceza onun üzerindeydi;","poem":1},{"text":"ve onun yaralarıyla biz iyileştik.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koyunlar gibi hepimiz yoldan saptık.","poem":1},{"text":"Herkes kendi yoluna döndü;","poem":2},{"lineBreak":true},{"text":"Yahve de hepimizin kötülüğünü onun üzerine koydu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O zulme uğrayıp,","poem":1},{"text":"ezildiyse de ağzını açmadı.","poem":2},{"text":"Kesime götürülen kuzu gibi,","poem":1},{"text":"kırkıcıların önünde sessiz duran koyun gibi,","poem":2},{"lineBreak":true},{"text":"ağzını açmadı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zulüm ve yargı yüzünden götürüldü.","poem":1},{"text":"Onun kuşağına gelince,","poem":2},{"lineBreak":true},{"text":"yaşayanlar diyarından kesilip atılmasının,","poem":2},{"lineBreak":true},{"text":"vurulmasının halkımın başkaldırısı yüzünden olduğunu kim düşündü?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onun mezarını kötülerle birlikte yaptılar,","poem":1},{"text":"ölümünde zengin adamla birlikteydi,","poem":2},{"text":"oysa o hiç şiddete başvurmamıştı,","poem":1},{"text":"ağzında da hiç hile yoktu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yine de onu ezmek Yahve'yi hoşnut etti.","poem":1},{"text":"Ona acı çektirdi.","poem":2},{"text":"Onun canını günah sunusu yaptığında,","poem":1},{"text":"kendi soyunu görecektir.","poem":2},{"text":"Günlerini uzatacak,","poem":1},{"text":"Yahve'nin isteği de onun elinde başaracaktır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Canının çektiği acılardan sonra ışığı","poem":1},{"noteId":26},{"text":"görecek ve hoşnut olacak.","poem":1},{"lineBreak":true},{"text":"Doğru hizmetkârım, kendi bilgisiyle birçoklarını aklayacaktır;","poem":1},{"text":"onların kötülüklerini de o üstlenecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bu nedenle ona büyüklerle birlikte pay vereceğim.","poem":1},{"text":"Ganimeti güçlülerle birlikte paylaşacak,","poem":2},{"text":"çünkü canını ölüme döktü","poem":1},{"text":"ve suçlularla sayıldı;","poem":2},{"text":"yine de birçoklarının günahını o üstlendi","poem":1},{"text":"ve günahkarlar için aracılık etti.","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"Bu yüzden Ölü Deniz Tomarları'nı ve Septuagint'i okuyun. Masoretik Metin “ışığı” atlar.","reference":{"chapter":53,"verse":11}}]},"thisChapterLink":"/api/tur_ytc/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}