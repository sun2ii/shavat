{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"“Ey sen, doğurmamış olan kısır, ezgi söyle!","poem":1},{"text":"Ey doğum sancısı çekmemiş olan, ezgi söylemeye başla ve yüksek sesle haykır!","poem":2},{"lineBreak":true},{"text":"Çünkü terkedilmiş olanın çocukları evli kadının çocuklarından çoktur” diyor Yahve.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Çadırının yerini genişlet,","poem":1},{"text":"konutlarının perdelerini gersinler;","poem":2},{"lineBreak":true},{"text":"esirgeme; iplerini uzat ve kazıklarını güçlendir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü sağa ve sola yayılacaksın;","poem":1},{"text":"senin soyun ulusları mülk edinecek,","poem":2},{"lineBreak":true},{"text":"ve ıssız kentlere yerleşecek.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Korkma, çünkü utanmayacaksın.","poem":1},{"text":"Şaşırma, çünkü hayal kırıklığına uğramayacaksın.","poem":2},{"text":"Çünkü gençliğinin utancını unutacaksınız.","poem":1},{"text":"Artık dul kalmanın ayıbını hatırlamayacaksın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü Yaratıcın senin kocandır; Ordular Yahvesi'dir O'nun adı.","poem":1},{"text":"İsrael'in Kutsalı seni fidye ile kurtarandır.","poem":2},{"lineBreak":true},{"text":"O'na bütün yeryüzünün Tanrısı denecektir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü Yahve seni terk edilmiş ve ruhu kederli bir eş,","poem":1},{"text":"gençliğinde atılmış bir eş gibi çağırdı” diyor Tanrın.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Kısa bir an için seni bıraktım,","poem":1},{"text":"ama büyük merhametlerle seni toplayacağım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taşkın gazapla yüzümü bir anlığına senden gizledim,","poem":1},{"text":"ama sonsuz sevgi dolu iyiliğimle sana merhamet edeceğim” diyor seni fidye ile kurtaran Yahve.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Çünkü bu benim için Noa'nın suları gibidir;","poem":1},{"text":"çünkü Noa'nın suları artık yeryüzünden aşmayacak diye nasıl ant içtimse,","poem":2},{"lineBreak":true},{"text":"sana kızmayacağıma ve seni azarlamayacağıma da öyle ant içtim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü dağlar yerinden kalkabilir,","poem":1},{"text":"tepeler taşınabilir,","poem":2},{"text":"ama sevgi dolu iyiliğim senden ayrılmayacak,","poem":1},{"text":"esenlik antlaşmam ortadan kalkmayacak” diyor","poem":2},{"lineBreak":true},{"text":"sana merhamet eden Yahve.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ey, fırtınalarla savrulmuş ve avutulmamış, sarsılmış sen,","poem":1},{"text":"işte, taşlarını güzel renklerle yerine koyacağım,","poem":2},{"lineBreak":true},{"text":"temellerini de safirlerle atacağım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kale burçlarını yakutlardan,","poem":1},{"text":"kapılarını parlak mücevherlerden,","poem":2},{"lineBreak":true},{"text":"bütün duvarlarını değerli taşlardan yapacağım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bütün çocuklarınız Yahve tarafından eğitilecek,","poem":1},{"text":"ve çocuklarının esenliği büyük olacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Doğruluk içinde sabitleneceksiniz.","poem":1},{"text":"Baskıdan uzak olacaksın çünkü korkmayacaksın;","poem":2},{"lineBreak":true},{"text":"dehşetten uzak olacaksın çünkü sana yaklaşmayacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte, onlar toplanabilirler ama benden değil.","poem":1},{"text":"Sana karşı kim toplanırsa senden dolayı düşecektir.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“İşte, kömürleri alev içine üfleyen,","poem":1},{"text":"işi için silah döven demirciyi ben yarattım;","poem":2},{"lineBreak":true},{"text":"yok ediciyi yok etmesi için de ben yarattım.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sana karşı düzenlenen hiçbir silah galip gelmeyecek;","poem":1},{"text":"yargıda sana karşı çıkan her dili de suçlu çıkaracaksın.","poem":2},{"text":"Bu, Yahve hizmetkârlarının mirasıdır,","poem":1},{"text":"onların doğruluğu da bendendir” diyor Yahve.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}