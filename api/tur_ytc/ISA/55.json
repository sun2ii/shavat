{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"verse","number":1,"content":[{"text":"“Ey sizler, susayan herkes sulara gelsin!","poem":1},{"text":"Parası olmayanlar, alın ve yiyin!","poem":2},{"lineBreak":true},{"text":"Evet gelin, şarap ve sütü parasız ve bedelsiz alın.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neden paranızı ekmek olmayana,","poem":1},{"text":"emeğinizi doyurmayan şeye harcıyorsunuz?","poem":2},{"text":"Beni özenle dinleyin de iyi olanı yiyesiniz,","poem":1},{"text":"canınız da zenginlikte keyif alsın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kulağınızı çevirin de bana gelin.","poem":1},{"text":"Duyun ve canınız yaşayacak.","poem":2},{"lineBreak":true},{"text":"Sizinle David'in emin merhametlerini, sonsuza dek sürecek bir antlaşma yapacağım.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İşte onu halklara tanık,","poem":1},{"text":"halklara önder ve komutan olarak verdim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İşte, bilmediğin bir ulusu çağıracaksın;","poem":1},{"text":"ve seni bilmeyen bir ulus, Tanrın Yahve'den ve İsrael'in Kutsalı'ndan dolayı sana koşacak;","poem":2},{"lineBreak":true},{"text":"çünkü O seni yüceltti.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bulunabilirken Yahve'yi arayın.","poem":1},{"text":"Yakındayken O'nu çağırın.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötü kişi kendi yolunu, haksız kişi kendi düşüncelerini bıraksın.","poem":1},{"lineBreak":true},{"text":"Yahve'ye, Tanrımız'a dönsün, O da ona merhamet eder;","poem":1},{"text":"çünkü O serbestçe bağışlayacaktır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Çünkü benim düşüncelerim sizin düşünceleriniz değil,","poem":1},{"text":"sizin yollarınız da benim yollarım değil” diyor Yahve.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Çünkü gökler yeryüzünden nasıl yüksekse,","poem":1},{"text":"yollarım da sizin yollarınızdan,","poem":2},{"lineBreak":true},{"text":"düşüncelerim de sizin düşüncelerinizden öyle yüksektir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü yağmur ve kar nasıl gökten iner,","poem":1},{"text":"oraya geri dönmezlerse, ama yeryüzünü sular,","poem":2},{"lineBreak":true},{"text":"onu büyütür, tomurcuklandırır,","poem":2},{"lineBreak":true},{"text":"ekene tohum, yiyene ekmek verirse;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ağzımdan çıkan sözüm de öyledir:","poem":1},{"text":"Bana boş dönmeyecek, ama dilediğim şeyi yerine getirecek,","poem":2},{"lineBreak":true},{"text":"yapması için gönderdiğim işte başarılı olacaktır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü sevinçle çıkacak ve esenlikle götürüleceksiniz.","poem":1},{"lineBreak":true},{"text":"Dağlar ve tepeler önünüzde ezgi söylemeye başlayacaklar;","poem":1},{"text":"kırlardaki bütün ağaçlar da el çırpacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Diken yerine selvi ağacı çıkacak;","poem":1},{"text":"çalı yerine mersin ağacı çıkacak.","poem":2},{"text":"Bu, Yahve'ye bir ün olmak üzere,","poem":1},{"text":"hiç kesilip atılmayacak sonsuz bir belirti olmak üzere olacaktır.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}