{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve şöyle diyor:","poem":1},{"text":"“Adaleti koruyun","poem":2},{"lineBreak":true},{"text":"ve doğru olanı yapın;","poem":2},{"lineBreak":true},{"text":"çünkü kurtarışım yakındır,","poem":2},{"lineBreak":true},{"text":"doğruluğum da yakında meydana çıkacaktır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bunu yapan insana,","poem":1},{"text":"onu sımsıkı tutan insanoğluna ne mutlu;","poem":2},{"text":"o, Şabat'ı kirletmeden tutar,","poem":1},{"text":"elini her türlü kötülükten de alıkoyar.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve'ye bağlanan hiçbir yabancı,","poem":1},{"text":"“Yahve beni halkından kesin olarak ayıracak” diye konuşmasın.","poem":2},{"lineBreak":true},{"text":"Hadım, “İşte ben kuru bir ağacım” demesin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Yahve şöyle diyor: “Şabatlar'ı tutan,","poem":1},{"text":"beni hoşnut eden şeyleri seçen","poem":2},{"lineBreak":true},{"text":"ve antlaşmama sıkı sıkıya bağlı kalan hadımlara,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"evimde ve duvarlarımın içinde onlara oğullardan ve kızlardan daha iyi bir anıt ve bir ad vereceğim.","poem":1},{"text":"Onlara, kesilip atılmayacak, sonsuz bir ad vereceğim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Üstelik, O'na hizmet etmek, Yahve'nin adını sevmek, O'nun hizmetkârları olmak için Yahve'ye bağlanan yabancıları,","poem":1},{"text":"Şabat'ı kirletmemek için onu tutan ve antlaşmama sıkı sıkıya bağlı kalan herkesi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"onları kutsal dağıma getireceğim,","poem":1},{"text":"ve onları dua evimde sevindireceğim.","poem":2},{"text":"Onların yakmalık sunuları ve kurbanları sunağımda kabul edilecek;","poem":1},{"text":"çünkü evime bütün halkların dua evi denecek.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İsrael'in sürgünlerini toplayan Efendi Yahve şöyle diyor:","poem":1},{"text":"“Toplanılmışlarına ek olarak","poem":2},{"lineBreak":true},{"text":"başkalarını da onun yanına toplayacağım.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey kır hayvanları, ormandaki bütün hayvanlar, yiyip bitirmeye gelin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Onun bekçileri kördür.","poem":1},{"text":"Hepsi bilgisizdir.","poem":2},{"text":"Onların hepsi dilsiz köpeklerdir.","poem":1},{"text":"Havlayamazlar;","poem":2},{"lineBreak":true},{"text":"rüya görüp uzanırlar, uyuklamayı severler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Evet, köpekler açgözlüdür.","poem":1},{"text":"Asla yeterincesine sahip olamazlar.","poem":2},{"text":"Onlar anlayamayan çobanlardır.","poem":1},{"text":"Her taraftan, her biri kendi kazancına,","poem":2},{"lineBreak":true},{"text":"hepsi kendi yollarına döndüler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Gelin” diyorlar, “Şarap alayım,","poem":1},{"text":"ağır içkiye doyalım;","poem":2},{"lineBreak":true},{"text":"yarın da bugünkü gibi, haddinden fazla iyi olacak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}