{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Doğru kişi yok oluyor,","poem":1},{"text":"ama kimse bunu yüreğine koymuyor.","poem":2},{"text":"Merhametliler alınıp götürülüyor,","poem":1},{"text":"ama kimse doğrunun kötülüğün önünden alınıp götürüldüğünü görmüyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O esenliğe giriyor.","poem":1},{"text":"Doğrulukla yürüyenler, yataklarında dinleniyorlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama buraya yaklaşın, ey büyücünün oğulları,","poem":1},{"text":"ey zina edenlerin ve fahişelerin soyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kiminle alay ediyorsunuz?","poem":1},{"text":"Ağzınızı kime açıyorsunuz ve dil çıkarıyorsunuz?","poem":2},{"text":"Siz başkaldırı çocukları ve yalanın soyu değil misiniz?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Siz ki, meşelerin arasında, her yeşil ağacın altında kendinizi kızıştırır,","poem":1},{"text":"vadilerde, kayaların kovukları altında çocukları öldürürsünüz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vadinin düzgün taşları arasında senin payın var.","poem":1},{"text":"Onlar, onlar senin hissendir.","poem":2},{"text":"Onlara dökmelik sunu bile döktün.","poem":1},{"text":"Sunu sundun.","poem":2},{"lineBreak":true},{"text":"Bu şeylerden ötürü yatışacak mıyım?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yüksek ve yüce bir dağa yatağını yerleştirdin.","poem":1},{"text":"Kurban sunmak için de oraya çıktın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kapıların ve sövelerinin arkasına kendi anıtını koydun,","poem":1},{"text":"çünkü kendini benden başkasına soydun ve yukarı çıktın.","poem":2},{"text":"Yatağını genişlettin ve onlarla bir antlaşma yaptın.","poem":1},{"text":"Onların yatağında gördüklerini sevdin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Krala güzel kokulu yağla gittin, güzel kokularını çoğalttın,","poem":1},{"text":"elçilerini uzaklara gönderdin ve kendini Şeol'e","poem":2},{"noteId":27},{"text":"kadar alçalttın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yollarının uzunluğundan yoruldun;","poem":1},{"text":"yine de, 'Boşuna' demedin.","poem":2},{"text":"Gücünün canlanmasını buldun;","poem":1},{"text":"bu yüzden bitkin düşmedin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Kimden korktun ve çekindin ki,","poem":1},{"text":"yalan söylüyorsun,","poem":2},{"lineBreak":true},{"text":"beni anmadın ve kendi yüreğine bunu koymadın?","poem":2},{"text":"Uzun zamandır suskun kalmadım mı,","poem":1},{"text":"benden de korkmuyor musun?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Doğruluğunu ilan edeceğim,","poem":1},{"text":"ama işlerine gelince, onlar sana yarar sağlamayacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Feryat ettiğin zaman,","poem":1},{"text":"şu topladıkların seni kurtarsın,","poem":2},{"text":"ama rüzgâr onları alıp götürecek.","poem":1},{"text":"Bir soluk hepsini alıp götürecek,","poem":2},{"lineBreak":true},{"text":"ama bana sığınan ülkeyi mülk edinecek,","poem":2},{"lineBreak":true},{"text":"kutsal dağımı da miras alacak.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Kur, kur, yolu hazırla!","poem":1},{"text":"Halkımın yolundan tökezleme taşını kaldır.” diyecek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Çünkü yüce ve ulu Olan, sonsuzlukta yaşayan,","poem":1},{"text":"adı Kutsal olan şöyle diyor:","poem":2},{"text":"“Ben yüksek ve kutsal yerde otururum,","poem":1},{"text":"alçakgönüllülerin ruhunu canlandırmak,","poem":2},{"lineBreak":true},{"text":"ve ezilmişlerin yüreğini canlandırmak için","poem":2},{"lineBreak":true},{"text":"ezilmiş ve alçakgönüllü ruhlu olanla da birlikteyim.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü daima çekişmeyeceğim, sürekli öfkeli de olmayacağım;","poem":1},{"text":"çünkü yarattığım canlar ve ruh benim önümde hali bayılırdı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Onun açgözlülüğünün kötülüğünden ötürü öfkelendim ve onu vurdum.","poem":1},{"text":"Kendimi gizledim ve öfkelendim;","poem":2},{"lineBreak":true},{"text":"ve o yüreğinin yolunda döneklik etmeye devam etti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onun yollarını gördüm ve onu iyileştireceğim.","poem":1},{"text":"Ona öncülük edeceğim,","poem":2},{"lineBreak":true},{"text":"ve ona ve yas tutanlarına avunmalarını geri vereceğim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dudakların ürününü yaratıyorum:","poem":1},{"text":"Esenlik, esenlik, uzakta olana ve yakında olana”","poem":2},{"lineBreak":true},{"text":"diyor Yahve;","poem":2},{"lineBreak":true},{"text":"ve onları iyileştireceğim.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ama kötüler çalkantılı deniz gibidir;","poem":1},{"text":"çünkü rahat duramaz ve suları pislik ve çamur atar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Kötülere esenlik yoktur” diyor Tanrım.","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/tur_ytc/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}