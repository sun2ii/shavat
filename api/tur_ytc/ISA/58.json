{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"verse","number":1,"content":[{"text":"“Yüksek sesle bağır! Esirgeme! Boru gibi sesini yükselt!","poem":1},{"lineBreak":true},{"text":"Halkıma itaatsizliklerini, Yakov evine de günahlarını bildir.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Her gün beni arıyorlar, yollarımı bilmekten zevk alıyorlarmış.","poem":1},{"lineBreak":true},{"text":"Doğru olanı yapan ve","poem":1},{"text":"Tanrıları'nın buyruklarını terk etmeyen bir ulus olarak,","poem":2},{"text":"benden doğru yargılar istiyorlar.","poem":1},{"text":"Tanrı'ya yaklaşmaktan zevk alıyorlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Neden oruç tuttuk da görmüyorsun?' diyorlar,","poem":1},{"text":"'neden canımızı ezdik de fark etmiyorsun?'”","poem":2},{"text":"“İşte oruç tuttuğun gün zevk alıyorsun,","poem":1},{"text":"bütün işçilerine de baskı yapıyorsun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İşte, siz kavga ve çekişme için,","poem":1},{"text":"kötülüğün yumruğuyla vurmak için oruç tutuyorsunuz.","poem":2},{"lineBreak":true},{"text":"Bugün sesinin yüksekte duyulması için oruç tutmuyorsunuz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Benim seçtiğim oruç bu mu?","poem":1},{"text":"İnsanın canını alçaltma günü mü?","poem":2},{"text":"Başını saz gibi eğmek,","poem":1},{"text":"altına çul ve kül sermek mi?","poem":2},{"text":"Buna mı oruç ve Yahve'ye uygun gün diyeceksin?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Benim seçtiğim oruç, bu değil mi:","poem":1},{"text":"Kötülüğün bağlarını çözmek,","poem":2},{"lineBreak":true},{"text":"boyunduruğun kayışlarını açmak,","poem":2},{"lineBreak":true},{"text":"ezilenleri serbest bırakmak,","poem":2},{"lineBreak":true},{"text":"ve her boyunduruğu kırmak?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aç olanla ekmeğini paylaşmak,","poem":1},{"text":"sürgün edilmiş yoksulu evine getirmek,","poem":2},{"lineBreak":true},{"text":"çıplak gördüğün zaman onu örtmek,","poem":2},{"lineBreak":true},{"text":"kendi etinden kaçınmamak değil mi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O zaman ışığın sabah gibi parlayacak,","poem":1},{"text":"şifan hemen görünecek;","poem":2},{"text":"doğruluğun önünden gidecek,","poem":1},{"text":"Yahve'nin görkemi ardında koruman olacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O zaman çağıracaksın ve Yahve yanıt verecek.","poem":1},{"text":"Yardım için feryat edeceksin ve O, 'İşte buradayım' diyecek.”","poem":2},{"text":"“Eğer aranızdan boyunduruğu,","poem":1},{"text":"parmak uzatmayı ve","poem":2},{"lineBreak":true},{"text":"kötü konuşmayı kaldırırsan;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ve eğer canını aç olana dökersen,","poem":1},{"text":"dertli canı doyurursan,","poem":2},{"text":"o zaman ışığın karanlıkta yükselir,","poem":1},{"text":"karanlığın da öğle vakti gibi olur;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ve Yahve sana durmadan yol gösterecek,","poem":1},{"text":"kurak yerlerde canını doyuracak ve kemiklerini güçlendirecek.","poem":2},{"text":"Sulanmış bir bahçe gibi,","poem":1},{"text":"suları hiç tükenmeyen bir su kaynağı gibi olacaksın.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Senden olanlar eski harap yerleri yeniden kuracaklar.","poem":1},{"text":"Çok kuşakların temellerini yeniden kuracaksın.","poem":2},{"text":"Sana Gedik Onarıcı,","poem":1},{"text":"meskenlerle Yolları Yeniden Canlandıran denecek.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Eğer ayağını Şabat’ta, kutsal günümde","poem":1},{"text":"kendi zevkini yapmaktan çevirirsen,","poem":2},{"text":"Şabat’ı zevk, Yahve'nin kutsalını onurlu sayarsan,","poem":1},{"text":"onu da onurlandırırsan,","poem":2},{"lineBreak":true},{"text":"kendi yollarını yapmaz,","poem":2},{"lineBreak":true},{"text":"kendi zevkini aramaz,","poem":2},{"lineBreak":true},{"text":"kendi sözlerini söylemezsen,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"o zaman Yahve'de zevk bulacaksın,","poem":1},{"text":"seni yeryüzünün yüksek yerlerine bindireceğim,","poem":2},{"lineBreak":true},{"text":"atan Yakov’un mirasıyla da seni besleyeceğim.”","poem":2},{"lineBreak":true},{"text":"Çünkü bunu Yahve'nin ağzı söyledi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}