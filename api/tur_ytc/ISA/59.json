{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"verse","number":1,"content":[{"text":"İşte, Yahve'nin eli kısalmadı ki, kurtaramasın;","poem":1},{"text":"kulağı ağırlaşmadı ki, duymasın.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ama suçlarınız sizi ve Tanrınız'ı ayırdı,","poem":1},{"text":"günahlarınız O'nun yüzünü sizden gizledi,","poem":2},{"lineBreak":true},{"text":"böylece duymayacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü elleriniz kanla kirlendi,","poem":1},{"text":"parmaklarınız da kötülükle.","poem":2},{"text":"Dudaklarınız yalan söyledi,","poem":1},{"text":"diliniz kötülük fısıldıyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hiç kimse doğrulukla dava açmıyor,","poem":1},{"text":"kimse de gerçeği savunmuyor.","poem":2},{"text":"Boşluğa güveniyorlar ve yalan söylüyorlar.","poem":1},{"lineBreak":true},{"text":"Kötülüğe gebe kalıyorlar,","poem":1},{"text":"ve kötülük doğuruyorlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Engereğin yumurtalarını çatlatıyorlar,","poem":1},{"text":"ve örümcek ağı dokuyorlar.","poem":2},{"text":"Onların yumurtalarından yiyen ölür;","poem":1},{"text":"kırılanından da engerek çıkar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ağlarından giysi olmayacak,","poem":1},{"text":"kendilerini işleriyle örtmeyecekler.","poem":2},{"text":"Onların işleri kötülük işleridir","poem":1},{"text":"zorbalık eylemleri de onların ellerindedir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayakları kötülüğe koşar,","poem":1},{"text":"masum kanı dökmek için de acele ederler.","poem":2},{"text":"Düşünceleri kötülük düşünceleridir.","poem":1},{"text":"Yollarında harap ve yıkım vardır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Esenlik yolunu bilmezler,","poem":1},{"text":"yollarında da adalet yoktur.","poem":2},{"text":"kendilerine eğri yollar yaptılar;","poem":1},{"text":"onlarda yürüyenlerin hiçbiri esenliği bilmez.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bu yüzden adalet bizden uzaktır,","poem":1},{"text":"ve doğruluk da bize yetişmiyor.","poem":2},{"text":"Işık arıyoruz, ama karanlık görüyoruz;","poem":1},{"text":"parıltı arıyoruz, ama karanlıkta yürüyoruz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Körler gibi duvarı el yordamıyla arıyoruz.","poem":1},{"text":"Evet, gözleri olmayanlar gibi yokluyoruz.","poem":2},{"lineBreak":true},{"text":"Öğle vakti alacakaranlıktaymış gibi tökezliyoruz.","poem":2},{"lineBreak":true},{"text":"Güçlüler arasında ölüler gibiyiz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hepimiz ayılar gibi homurdanıyoruz,","poem":1},{"text":"güvercinler gibi de hüzünle inliyoruz.","poem":2},{"text":"Adalet arıyoruz, ama yok;","poem":1},{"text":"kurtuluş arıyoruz, ama bizden uzak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü suçlarımız senin önünde çoğaldı,","poem":1},{"text":"günahlarımız bize karşı tanıklık ediyor;","poem":2},{"text":"çünkü suçlarımız bizimle birlikte,","poem":1},{"text":"kötülüklerimiz ise, onları biliyoruz:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü günah işleyip Yahve'yi inkâr ettik,","poem":1},{"text":"Tanrımız'ın yolundan saptık,","poem":2},{"lineBreak":true},{"text":"zorbalık ve isyan dedik,","poem":2},{"lineBreak":true},{"text":"yürekten yalan sözler tasarlayıp söyledik.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Adalet tersine döndü,","poem":1},{"text":"doğruluk uzakta duruyor;","poem":2},{"text":"çünkü gerçek sokakta düştü,","poem":1},{"text":"doğruluk da içeri giremiyor.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Evet, gerçek eksik;","poem":1},{"text":"kötülükten uzak duran da kendini av yapıyor.","poem":2},{"text":"Yahve bunu gördü,","poem":1},{"text":"adaletin olmamasından da hoşnutsuzdu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hiçbir insanın olmadığını gördü,","poem":1},{"text":"aracılık edecek birinin de olmamasına şaştı.","poem":2},{"text":"Bu yüzden kendi kolu ona kurtuluş getirdi;","poem":1},{"text":"doğruluğu kendisine destek oldu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doğruluğu zırh gibi üzerine,","poem":1},{"text":"kurtuluş miğferini de başına giydi.","poem":2},{"text":"Öç alma giysilerini kuşandı,","poem":1},{"text":"gayreti de kaftan gibi sarındı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaptıklarına göre,","poem":1},{"text":"uygun karşılık verecek,","poem":2},{"lineBreak":true},{"text":"hasımlarına gazap,","poem":2},{"lineBreak":true},{"text":"düşmanlarına ceza.","poem":2},{"lineBreak":true},{"text":"Adalara hak ettiklerini ödeyecek.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Böylece batıdan olanlar Yahve'nin adından,","poem":1},{"text":"gün doğumundakiler de görkeminden korkacaklar;","poem":2},{"text":"çünkü Yahve'nin soluğunun önüne kattığı,","poem":1},{"text":"coşkun bir ırmak gibi o gelecek.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Fidye ile Kurtarıcı Siyon'a,","poem":1},{"text":"Yakov'daki itaatsizlikten dönenlere gelecek” diyor Yahve.","poem":2}]},{"type":"verse","number":21,"content":["“Benim için, bu benim onlarla yaptığım antlaşmadır” diyor Yahve. “Üzerinde olan Ruhum ve ağzına koymuş olduğum sözlerim, şimdiden sonsuza dek ağzından, soyunun ağzından, soyunun soyunun ağzından ayrılmayacak” diyor Yahve."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}