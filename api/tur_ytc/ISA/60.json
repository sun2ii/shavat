{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"“Kalk, parla; çünkü ışığın geldi,","poem":1},{"text":"ve Yahve'nin görkemi senin üzerine doğdu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü işte, karanlık yeryüzünü,","poem":1},{"text":"ve koyu karanlık halkları örtecek;","poem":2},{"text":"ama Yahve senin üzerine doğacak,","poem":1},{"text":"ve görkemi senin üzerinde görülecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uluslar senin ışığına,","poem":1},{"text":"krallar da senin doğuşunun parlaklığına gelecekler.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Gözlerini her yana kaldır ve bak:","poem":1},{"text":"Hepsi bir araya toplanıyor.","poem":2},{"lineBreak":true},{"text":"Sana geliyorlar.","poem":2},{"text":"Oğulların uzaktan gelecek, kızların da kucakta taşınacak.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O zaman göreceksin ve parlayacaksın,","poem":1},{"text":"ve yüreğin heyecanlanacak ve genişleyecek;","poem":2},{"text":"çünkü denizin bolluğu sana döndürülecek.","poem":1},{"text":"Ulusların zenginliği sana gelecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Midyan ve Efa'nın hecin develeri sürüsü seni kaplayacak.","poem":1},{"lineBreak":true},{"text":"Hepsi Şeba'dan gelecek.","poem":1},{"text":"Altın ve günnük getirecekler,","poem":2},{"lineBreak":true},{"text":"Yahve'nin de övgülerini ilan edecekler.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kedar'ın bütün sürüleri sana toplanacak.","poem":1},{"text":"Nevayot'un koçları sana hizmet edecek.","poem":2},{"lineBreak":true},{"text":"Sunağımın üzerinde onlar sunular olarak kabul görecekler,","poem":2},{"lineBreak":true},{"text":"görkemli evimi de süsleyeceğim.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Bulut gibi,","poem":1},{"text":"pencerelerine uçan kumrular gibi,","poem":2},{"lineBreak":true},{"text":"bu uçanlar kimlerdir?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kesinlikle adalar beni bekleyecekler,","poem":1},{"text":"ta ki, önce de Tarşiş gemileri,","poem":2},{"text":"oğullarını uzaktan, gümüşleri ve altınlarıyla birlikte,","poem":1},{"text":"Tanrın Yahve'nin adı ve İsrael'in Kutsalı için getirsinler,","poem":2},{"lineBreak":true},{"text":"çünkü o seni yüceltti.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Yabancılar duvarlarını bina edecekler,","poem":1},{"text":"kralları da sana hizmet edecekler;","poem":2},{"text":"çünkü gazabımla seni vurdum,","poem":1},{"text":"ama lütfumla sana merhamet ettim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kapıların da sürekli açık olacak; gece gündüz kapanmayacaklar ki, insanlar ulusların servetini ve onların tutsak edilmiş krallarını sana getirsin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Çünkü sana hizmet etmeyen ulus ve krallık yok olacak, evet, o uluslar tümüyle harap olacak.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"“Lübnan'ın görkemi, selvi ağacı, çam ve şimşir ağacı birlikte, konutumu süslemek için sana gelecekler. Ayaklarımın yerini görkemli kılacağım.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Seni ezenlerin oğulları sana eğilerek gelecekler.","poem":1},{"lineBreak":true},{"text":"Seni hor görenlerin hepsi ayak tabanlarına eğilecekler.","poem":1},{"text":"Sana Yahve'nin Kenti,","poem":2},{"lineBreak":true},{"text":"İsrael'in Kutsalı'nın Siyonu diyecekler.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Terk edilmiş ve nefret edilmişken,","poem":1},{"text":"senin içinden kimse geçmemişken,","poem":2},{"text":"seni sonsuz bir övünç, çok kuşakların sevinci yapacağım.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ulusların sütünü de içeceksin,","poem":1},{"text":"ve kraliyet memelerinden emeceksin.","poem":2},{"text":"O zaman ben, Yahve'nin Kurtarıcın,","poem":1},{"text":"fidye ile Kurtarıcın olan,","poem":2},{"lineBreak":true},{"text":"Yakov'un Güçlüsü olduğumu bileceksin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tunç yerine altın,","poem":1},{"text":"demir yerine gümüş,","poem":2},{"lineBreak":true},{"text":"ağaç yerine tunç,","poem":2},{"lineBreak":true},{"text":"taş yerine demir getireceğim.","poem":2},{"text":"Esenliği valin, doğruluğu da yöneticin yapacağım.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ülkende zorbalık,","poem":1},{"text":"sınırlarının içinde yıkım ve haraplık duyulmayacak.","poem":2},{"lineBreak":true},{"text":"Ama surlarına Kurtuluş, kapılarına Övgü diyeceksin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Güneş artık senin gündüz ışığın olmayacak,","poem":1},{"text":"Ay'ın parlaklığı da sana ışık vermeyecek.","poem":2},{"text":"Ama Yahve senin sonsuz ışığın olacak,","poem":1},{"text":"Tanrın da senin görkemin olacak.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Güneşin artık batmayacak,","poem":1},{"text":"Ay'ın da çekilmeyecek.","poem":2},{"text":"Çünkü Yahve senin sonsuz ışığın olacak,","poem":1},{"text":"ve yas günlerin sona erecek.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"O zaman senin halkının hepsi doğru olacak.","poem":1},{"text":"Onlar ben yüceltileyim diye,","poem":2},{"lineBreak":true},{"text":"diktiğim fidan, ellerimin işidirler,","poem":2},{"lineBreak":true},{"text":"ülkeyi sonsuza dek mülk edinecekler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Küçüğü bin,","poem":1},{"text":"azı güçlü bir ulus olacak.","poem":2},{"lineBreak":true},{"text":"Ben, Yahve, bunu zamanında çabucak yapacağım.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}