{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Efendi Yahve'nin Ruhu benim üzerimdedir,","poem":1},{"text":"çünkü Yahve alçakgönüllülere iyi haberi duyurmak için beni meshetti.","poem":2},{"text":"Kırık yüreklileri sarmak,","poem":1},{"text":"tutsaklara özgürlük,","poem":2},{"lineBreak":true},{"text":"bağlı olanlara serbest bırakılacaklarını","poem":2},{"noteId":28},{"text":"ilan etmek için,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve'nin lütuf yılını,","poem":1},{"text":"Tanrımız'ın öç gününü ilan etmek,","poem":2},{"lineBreak":true},{"text":"yas tutanların tümünü avutmak için,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Siyon'da yas tutanlara sağlamak üzere,","poem":1},{"text":"küller yerine çelenk,","poem":2},{"lineBreak":true},{"text":"yas yerine sevinç yağı,","poem":2},{"lineBreak":true},{"text":"ağırlık ruhu yerine övgü giysisi vermek için beni gönderdi.","poem":2},{"text":"Öyle ki, onlara doğruluk ağaçları,","poem":1},{"text":"Yahve'nin kendisinin yücelmesi için diktiği denilsin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eski yıkıntıları yeniden bina edecekler.","poem":1},{"text":"Eskiden harap olmuş yerleri yeniden kuracaklar.","poem":2},{"text":"Çok kuşaklardır harap olmuş yıkık kentleri onaracaklar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yabancılar durup sürülerinizi otlatacaklar.","poem":1},{"text":"Yabancılar tarlalarınızda ve bağlarınızda çalışacaklar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ama size Yahve'nin kâhinleri denilecek.","poem":1},{"text":"İnsanlar size Tanrımız'ın hizmetkârları diyecekler.","poem":2},{"text":"Ulusların servetini yiyeceksiniz.","poem":1},{"text":"Onların görkemiyle övüneceksiniz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Utancınıza karşılık iki katı olacak.","poem":1},{"text":"Aşağılanmaya karşılık onlar paylarıyla sevinecekler.","poem":2},{"text":"Bu nedenle kendi topraklarında iki kat mülk edinecekler.","poem":1},{"text":"Onlara sonsuz sevinç olacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Çünkü ben, Yahve, adaleti severim.","poem":1},{"text":"Soygundan ve haksızlıktan nefret ederim.","poem":2},{"text":"Onlara gerçekte ödüllerini vereceğim ve onlarla sonsuz bir antlaşma yapacağım.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Soyları uluslar arasında,","poem":1},{"text":"onların soyları da halklar arasında bilinecek.","poem":2},{"text":"Onları gören herkes,","poem":1},{"text":"Yahve'nin kutsadığı soy olduklarını kabul edecek.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve'de çok sevineceğim!","poem":1},{"text":"Canım Tanrım'da sevinç duyacak,","poem":2},{"text":"çünkü O beni kurtuluş giysisiyle sardı.","poem":1},{"text":"Damadın çelenkle süslenmesi gibi,","poem":2},{"lineBreak":true},{"text":"gelinin de mücevherleriyle süslenmesi gibi,","poem":2},{"lineBreak":true},{"text":"doğruluk kaftanıyla beni örttü.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü yeryüzü nasıl filiz verirse,","poem":1},{"text":"bahçe de içine ekilen şeyleri nasıl yetiştirirse,","poem":2},{"lineBreak":true},{"text":"Efendi Yahve de bütün ulusların önünde doğruluk ve övgüyü öyle yetiştirecektir.","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"LXX ve DSS şunu ekliyor: Körlerin gözünün açılması","reference":{"chapter":61,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}