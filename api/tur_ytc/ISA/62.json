{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"Siyon uğruna susmayacağım,","poem":1},{"text":"Yeruşalem uğruna dinlenmeyeceğim,","poem":2},{"text":"ta ki doğruluğu şafak gibi,","poem":1},{"text":"kurtuluşu yanan bir kandil gibi parlayıncaya dek.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uluslar senin doğruluğunu,","poem":1},{"text":"bütün krallar da senin görkemini görecek.","poem":2},{"text":"Yahve'nin ağzının vereceği yeni bir adla çağırılacaksın.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yahve'nin elinde güzellik tacı,","poem":1},{"text":"Tanrı'nın elinde kraliyet tacı olacaksın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Artık sana Terk Edilmiş denmeyecek,","poem":1},{"text":"ülkene de artık Harap denmeyecek.","poem":2},{"text":"Ama sana Heftsiva,","poem":1},{"noteId":29},{"text":"ülkene Beula","poem":2},{"noteId":30},{"text":"denecek.","poem":2},{"text":"Çünkü Yahve senden hoşnut olacak,","poem":1},{"text":"ülken de evli olacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü bir genç el değmemiş bir kızla nasıl evlenirse,","poem":1},{"text":"oğulların da seninle öyle evlenecek.","poem":2},{"text":"Damat gelini için nasıl sevinirse,","poem":1},{"text":"Tanrın da senin için öyle sevinecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Surlarına bekçiler yerleştirdim, ey Yeruşalem.","poem":1},{"text":"Gece gündüz susmayacaklar.","poem":2},{"text":"Ey Yahve'yi çağıranlar, dinlenmeyin,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yeruşalem'i pekiştirinceye dek,","poem":1},{"text":"yeryüzünde onu övünç yapıncaya dek,","poem":2},{"lineBreak":true},{"text":"O'na da rahat vermeyin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve sağ eliyle ve güçlü koluyla ant içti:","poem":1},{"lineBreak":true},{"text":"“Artık tahılını kesinlikle düşmanlarına yiyecek olarak vermeyeceğim,","poem":1},{"text":"yabancılar da emek verdiğin yeni şarabını içmeyecekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ama onu biçenler onu yiyecek,","poem":1},{"text":"ve Yahve'yi övecekler.","poem":2},{"lineBreak":true},{"text":"Onu toplayanlar onu kutsal yerimin avlularında içecekler.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Geçin, kapılardan geçin!","poem":1},{"text":"Halkın yolunu hazırlayın!","poem":2},{"text":"Yapın, ana yolu yapın!","poem":1},{"text":"Taşları toplayın!","poem":2},{"lineBreak":true},{"text":"Halklar için bir sancak kaldırın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İşte, Yahve yeryüzünün sonuna dek duyurdu:","poem":1},{"text":"“Siyon kızına de ki,","poem":2},{"lineBreak":true},{"text":"‘İşte, kurtuluşun geldi!","poem":2},{"lineBreak":true},{"text":"İşte, ödülü onunla birlikte, karşılığı da önündedir!’”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onlara “Kutsal Halk, Yahve'nin fidye ile Kurtardıkları” diyecekler.","poem":1},{"text":"Sana, “Aranan, Terk Edilmemiş Kent” denecek.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Heftsiva, “Ondan hoşlanıyorum” anlamına gelir.","reference":{"chapter":62,"verse":4}},{"noteId":30,"caller":"+","text":"Beula “evli” anlamına gelir.","reference":{"chapter":62,"verse":4}}]},"thisChapterLink":"/api/tur_ytc/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}