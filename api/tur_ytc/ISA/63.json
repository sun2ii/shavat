{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":[{"text":"Bosra'dan boyalı giysilerle","poem":1},{"text":"Edom'dan gelen bu kimdir?","poem":2},{"text":"Giysilerinde görkemli, gücünün büyüklüğü içinde","poem":1},{"text":"bu yürüyen kimdir?","poem":2},{"text":"“O, doğrulukla konuşan,","poem":1},{"text":"kurtarmakta kudretli olan benim.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neden giysilerin kırmızı,","poem":1},{"text":"giysilerin de üzüm teknesini çiğneyeninki gibi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Çukurda üzümü tek başıma çiğnedim.","poem":1},{"text":"Halklardan kimse yanımda değildi.","poem":2},{"text":"Evet, onları öfkemle çiğnedim, gazabımla da ezdim.","poem":1},{"text":"Kanı giysilerime sıçradı,","poem":2},{"lineBreak":true},{"text":"ve bütün giysilerimi kirlettim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü öç alma günü yüreğimdeydi,","poem":1},{"text":"fidye ile kurtardıklarımın yılı da gelmişti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baktım ve yardım edecek kimse yoktu;","poem":1},{"text":"destek olacak kimsenin olmayışına da şaştım.","poem":2},{"text":"Bu yüzden kendi kolum bana kurtuluş getirdi.","poem":1},{"text":"Kendi öfkem bana destek oldu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Öfkemle halkları çiğnedim,","poem":1},{"text":"gazabımla da onları sarhoş ettim.","poem":2},{"lineBreak":true},{"text":"Kanlarını yeryüzüne döktüm.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve'nin sevgi dolu iyiliklerini,","poem":1},{"text":"övgülerini, Yahve'nin bize verdiği her şeye,","poem":2},{"lineBreak":true},{"text":"İsrael evine olan büyük iyiliğine,","poem":2},{"lineBreak":true},{"text":"merhametlerine ve sevgi dolu iyiliklerinin çokluğuna göre anlatacağım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü, “Gerçekten onlar benim halkım,","poem":1},{"text":"hile yapmayacak çocuklardır” dedi;","poem":2},{"lineBreak":true},{"text":"böylece onların Kurtarıcısı oldu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bütün sıkıntılarında O sıkıntı çekti,","poem":1},{"text":"ve huzurunda duran melek onları kurtardı.","poem":2},{"text":"Sevgisiyle ve acımasıyla onları fidye ile kurtardı.","poem":1},{"text":"Onları taşıdı, eskiden beri de onları taşıdı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama isyan ettiler,","poem":1},{"text":"Kutsal Ruhu'nu da kederlendirdiler.","poem":2},{"text":"Bu yüzden döndü ve onların düşmanı oldu,","poem":1},{"text":"ve kendisi onlara karşı savaştı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sonra eski günleri,","poem":1},{"text":"Moşe'yi ve halkını anımsadı ve şöyle dedi:","poem":2},{"text":"“Onları sürüsünün çobanlarıyla birlikte denizden çıkaran nerede?","poem":1},{"text":"Kutsal Ruhu'nu aralarına koyan nerede?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Görkemli kolunu Moşe'nin sağında kim durdurdu?","poem":1},{"text":"Kim önlerinde suları yararak kendisine sonsuz bir ad yaptı?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onları bozkırdaki bir at gibi,","poem":1},{"text":"derinliklerden, tökezlemeden kim geçirdi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vadiye inen hayvanlar gibi,","poem":1},{"text":"Yahve'nin Ruhu onları dinlendirdi.","poem":2},{"lineBreak":true},{"text":"Böylece kendine görkemli bir ad yapmak için halkına yol gösterdin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gökten aşağı bak","poem":1},{"text":"ve kutsallığının ve görkeminin konutundan gör.","poem":2},{"text":"Gayretin ve kudretli işlerin nerede?","poem":1},{"text":"Yüreğinin hasreti ve şefkatin bana karşı kısıtlandı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü sen bizim Babamız'sın,","poem":1},{"text":"Avraham bizi tanımasa da,","poem":2},{"lineBreak":true},{"text":"İsrael bizi kabul etmese de.","poem":2},{"text":"Sen, ey Yahve, bizim Babamız'sın.","poem":1},{"text":"Sonsuzluktan beri adın Kurtarıcımız'dır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ey Yahve, neden bizi yollarından saptırıyorsun,","poem":1},{"text":"ve yüreğimizi de korkundan katılaştırıyorsun?","poem":2},{"text":"Hizmetkârların uğruna,","poem":1},{"text":"mirasının oymakları uğruna geri dön.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kutsal halkın onu kısa bir süre için mülk edindi.","poem":1},{"text":"Düşmanlarımız senin kutsal yerini çiğnediler.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hiçbir zaman üzerlerinde hüküm sürmediğin,","poem":1},{"text":"adınla çağrılmamış olanlar gibi olduk.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}