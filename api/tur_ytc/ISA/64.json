{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Ah, keşke gökleri yarıp insen de,","poem":1},{"text":"dağlar senin huzurunda sarsılsalar;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ateşin çalıyı tutuşturduğu gibi,","poem":1},{"text":"ateşin suyu kaynattığı gibi.","poem":2},{"text":"Adını düşmanlarına duyur ki,","poem":1},{"text":"uluslar senin huzurunda titresinler!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Beklemediğimiz korkunç şeyler yaptığın zaman indin,","poem":1},{"text":"dağlar da senin huzurunda sarsıldı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü eskiden beri insanlar duymadı,","poem":1},{"text":"kulak kavramadı,","poem":2},{"lineBreak":true},{"text":"göz de senden başka bir Tanrı görmedi,","poem":2},{"lineBreak":true},{"text":"o Tanrı ki, kendisini bekleyen için işler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sevinen ve doğru şeyler yapan kişiyi,","poem":1},{"text":"senin yollarında seni hatırlayanları karşılarsın.","poem":2},{"text":"İşte, öfkelendin, biz de günah işledik.","poem":1},{"text":"Uzun zamandır günah içindeyiz.","poem":2},{"lineBreak":true},{"text":"Kurtulacak mıyız biz?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü hepimiz kirli olana benzedik,","poem":1},{"text":"bütün doğruluğumuz da kirli bir giysi gibidir.","poem":2},{"text":"Hepimiz yaprak gibi soluyoruz;","poem":1},{"text":"suçlarımız da rüzgâr gibi, bizi alıp götürüyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adını çağıran,","poem":1},{"text":"sana tutunmak için kendini teşvik eden yok;","poem":2},{"text":"çünkü yüzünü bizden sakladın,","poem":1},{"text":"suçlarımızla da bizi tükettin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama şimdi, ey Yahve, sen bizim Babamız'sın.","poem":1},{"text":"Biz balçığız, sen de çömlekçimizsin.","poem":2},{"lineBreak":true},{"text":"Biz hepimiz senin elinin işiyiz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Öfkelenme, ey Yahve.","poem":1},{"text":"Kötülüğü sonsuza dek anma.","poem":2},{"text":"Bak ve gör, sana yalvarıyoruz,","poem":1},{"text":"biz hepimiz senin halkınız.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kutsal kentlerin çöl oldu.","poem":1},{"text":"Siyon çöl oldu,","poem":2},{"lineBreak":true},{"text":"Yeruşalem ıssız.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Atalarımızın seni övdüğü kutsal ve güzel evimiz","poem":1},{"text":"Ateşle yakıldı.","poem":2},{"lineBreak":true},{"text":"Bütün güzel yerlerimiz harap oldu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bunlar böyleyken kendini geri mi çekeceksin, ey Yahve?","poem":1},{"text":"Sessiz kalıp bizi ağır bir şekilde cezalandıracak mısın?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}