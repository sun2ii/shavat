{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ISA","translationId":"tur_ytc","name":"YEŞAYA","commonName":"YEŞAYA","title":"YEŞAYA","order":23,"numberOfChapters":66,"sha256":"597c971fffa02afc1100206c6aaebd525a9004c7b3ae76cfe6768434eb9d733a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tur_ytc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"verse","number":1,"content":[{"text":"“Beni sormayanlar tarafından soruldum.","poem":1},{"text":"Beni aramayanlar tarafından bulundum.","poem":2},{"lineBreak":true},{"text":"Adımla çağırılmayan bir ulusa, ‘Beni görün, beni görün’ dedim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ellerimi bütün gün,","poem":1},{"text":"kendi düşünceleri ardınca, iyi olmayan bir yolda yürüyen","poem":2},{"lineBreak":true},{"text":"asi bir halka uzattım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bahçelerde kurban keserek,","poem":1},{"text":"tuğlalarda buhur yakarak","poem":2},{"lineBreak":true},{"text":"sürekli yüzüme karşı beni kışkırtan;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mezarların arasında oturan,","poem":1},{"text":"gizli yerlerde geceleyen,","poem":2},{"text":"domuz eti yiyen,","poem":1},{"text":"kaplarında da iğrenç şeylerin suyu bulunan;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‘Yalnız kal, bana yaklaşma,","poem":1},{"text":"çünkü ben senden daha kutsalım’ diyen bir halk.","poem":2},{"text":"Bunlar burnumda duman, bütün gün yanan bir ateştir.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“İşte, önümde yazılıdır:","poem":1},{"text":"Susmayacağım, ama ödeyeceğim,","poem":2},{"lineBreak":true},{"text":"evet, onların koynuna ödeyeceğim","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kendi kötülüklerinizi ve atalarınızın kötülüklerini birlikte” diyor Yahve,","poem":1},{"text":"“Onlar dağlar üzerinde buhur yakanlar,","poem":2},{"lineBreak":true},{"text":"ve tepelerde bana küfür edenlerdir.","poem":2},{"lineBreak":true},{"text":"Bu yüzden önce onların işlerini koynuna ölçeceğim.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve diyor ki, “Yeni şarabın salkımda bulunduğu gibi,","poem":1},{"text":"birinin, ‘Onu yok etme, çünkü içinde bereket var’ dediği gibi;","poem":2},{"text":"ben de hepsini yok etmemek için,","poem":1},{"text":"hizmetkârlarım uğruna öyle yapacağım.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yakov’dan bir soy,","poem":1},{"text":"Yahuda’dan da dağlarımın mirasçısını çıkaracağım.","poem":2},{"text":"Seçtiklerim onu miras alacak,","poem":1},{"text":"hizmetkârlarım da orada oturacaklar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Beni arayan halkım için,","poem":1},{"text":"Şaron sürülerin ağılı,","poem":2},{"lineBreak":true},{"text":"Akor Vadisi de sürülerin yattığı yer olacak.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ama siz, Yahve'yi terk edenler,","poem":1},{"text":"kutsal dağımı unutanlar,","poem":2},{"lineBreak":true},{"text":"talih için sofra hazırlayanlar,","poem":2},{"lineBreak":true},{"text":"kısmet için karışık şarap dolduranlar,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"sizi kılıca kısmet edeceğim,","poem":1},{"text":"hepiniz boğazlanmak için eğileceksiniz;","poem":2},{"text":"çünkü sizi çağırdığım zaman yanıt vermediniz.","poem":1},{"text":"Konuştuğum zaman dinlemediniz;","poem":2},{"text":"ama gözümde kötü olanı yaptınız,","poem":1},{"text":"hoşlanmadığım şeyi seçtiniz.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bu yüzden Efendi Yahve şöyle diyor:","poem":1},{"text":"“İşte, hizmetkârlarım yiyecekler, ama siz aç kalacaksınız;","poem":2},{"text":"işte, hizmetkârlarım içecekler,","poem":1},{"text":"ama siz susuz kalacaksınız.","poem":2},{"text":"İşte, hizmetkârlarım sevinecekler,","poem":1},{"text":"ama siz hayal kırıklığına uğrayacaksınız.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İşte, hizmetkârlarım yüreklerinin sevincinden ezgi söyleyecekler,","poem":1},{"text":"ama siz yürek üzüntüsünden ağlayacak,","poem":2},{"lineBreak":true},{"text":"ruh sıkıntısından uluyacaksınız.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Adınızı seçilmişlerime lanet andı olarak bırakacaksınız,","poem":1},{"text":"Efendi Yahve de sizi öldürecek.","poem":2},{"text":"Hizmetkârlarını başka bir adla çağıracak,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"böylece yeryüzünde kendisini kutsayan kişi, gerçeğin Tanrısı'nda kendisini kutsayacak;","poem":1},{"text":"yeryüzünde ant içen de, gerçeğin Tanrısı'yla ant içecek;","poem":2},{"text":"çünkü önceki sıkıntılar unutuldu ve gözlerimden gizlendi.”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“Çünkü işte, yeni gökler ve yeni bir yer yaratıyorum;","poem":1},{"text":"önceki şeyler de hatırlanmayacak, akla gelmeyecek.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ama yaratmakta olduğumda sonsuza dek sevinin ve coşun;","poem":1},{"text":"çünkü işte, Yeruşalem'i zevk kaynağı,","poem":2},{"lineBreak":true},{"text":"ve halkını sevinç olarak yaratıyorum.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yeruşalem'de sevineceğim,","poem":1},{"text":"halkımdan da hoşnut olacağım;","poem":2},{"text":"artık onda ağlayış sesi ve feryat sesi duyulmayacak.”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"“Artık birkaç gün yaşayan bir bebek,","poem":1},{"text":"günlerini doldurmayan bir ihtiyar olmayacak.","poem":2},{"text":"Çünkü çocuk yüz yaşında ölecek,","poem":1},{"text":"yüz yaşında olan günahkâr da lanetli olacak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Evler yapacaklar ve onda oturacaklar.","poem":1},{"text":"Bağlar dikecekler ve ürününü yiyecekler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Onlar bina edip de başkası oturmayacak.","poem":1},{"text":"Onlar dikip de başkası yemeyecek.","poem":2},{"text":"Çünkü halkımın günleri ağacın günleri gibi olacak.","poem":1},{"text":"Seçtiklerim de kendi ellerinin işinden uzun süre zevk alacaklar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Boşuna emek vermeyecekler, felaket için de doğurmayacaklar.","poem":1},{"lineBreak":true},{"text":"Çünkü onlar, kendileriyle birlikte torunları da,","poem":1},{"text":"Yahve'nin kutsanmışlarının soyudur.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Öyle olacak ki, onlar çağırmadan önce ben yanıt vereceğim;","poem":1},{"text":"ve onlar daha konuşurken ben işiteceğim.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kurtla kuzu birlikte otlayacak.","poem":1},{"text":"Aslan öküz gibi saman yiyecek.","poem":2},{"lineBreak":true},{"text":"Toprak yılanın yemeği olacak.","poem":2},{"text":"Kutsal dağımın tümünde zarar vermeyecekler ve yok etmeyecekler.”","poem":1},{"text":"diyor Yahve.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}