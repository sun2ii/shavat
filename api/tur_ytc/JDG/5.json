{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JDG","translationId":"tur_ytc","name":"HÂKİMLER","commonName":"HÂKİMLER","title":"HÂKİMLER","order":7,"numberOfChapters":21,"sha256":"81fe3f90b1359616715d62f7453ebd075a02beec25b2a44917785d124b72e66c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/tur_ytc/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["O gün Devora ile Avinoam oğlu Barak ezgi söyleyip dediler:"]},{"type":"verse","number":2,"content":[{"text":"“İsrael'de önderler öncülük ettikleri için,","poem":1},{"text":"halk gönüllü olarak kendilerini sundukları için,","poem":2},{"text":"yücelsin Yahve!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“Duyun, ey krallar! Kulak verin ey beyler!","poem":1},{"lineBreak":true},{"text":"Ben, Yahve'ye ben ezgi söyleyeceğim.","poem":1},{"text":"İsrael'in Tanrısı Yahve'yi ezgiyle öveceğim.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ey Yahve, Seir'den çıktığın zaman,","poem":1},{"text":"Edom kırından yürüdüğün zaman","poem":2},{"text":"Yeryüzü sarsıldı, gökyüzü de damlattı.","poem":1},{"text":"Evet, bulutlar su damlattı.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dağlar Yahve'nin önünde,","poem":1},{"text":"Sina Dağı bile İsrael'in Tanrısı Yahve'nin önünde sarsıldı.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Anat oğlu Şamgar'ın günlerinde,","poem":1},{"text":"Yael'in günlerinde de ana yollar boştu.","poem":2},{"lineBreak":true},{"text":"Yolcular sapa yollardan geçtiler.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İsrael'de hâkimler sona erdi.","poem":1},{"text":"Ben Devora ayağa kalkana dek kesildiler;","poem":2},{"lineBreak":true},{"text":"ta ki, İsrael'de bir ana olarak ben ortaya çıkana dek.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onlar yeni ilâhlar seçtiler.","poem":1},{"text":"O zaman savaş kapılardaydı.","poem":2},{"lineBreak":true},{"text":"İsrael'de kırk bin arasında","poem":2},{"text":"kalkan ya da mızrak görüldü mü?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yüreğim kendilerini halkın arasında gönüllü olarak sunan","poem":1},{"text":"İsrael önderlerinden yanadır.","poem":2},{"lineBreak":true},{"text":"Yahve'yi yüceltin!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Ey beyaz eşeklere binenler,","poem":1},{"text":"ey gösterişli halılar üzerinde oturanlar","poem":2},{"lineBreak":true},{"text":"ve ey yolda yürüyenler, söyleyin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Okçuların gürültüsünden uzak, su çekilen yerlerde,","poem":1},{"text":"Yahve'nin doğru işlerini,","poem":2},{"lineBreak":true},{"text":"O'nun İsrael'deki yönetiminin doğru işlerini anlatacaklar.","poem":2},{"text":"“O zaman Yahve'nin halkı kapılara indi.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"'Uyan, uyan, Devora!","poem":1},{"text":"Uyan, uyan, bir ezgi söyle!","poem":2},{"lineBreak":true},{"text":"Kalk ey Barak, ey Abinoam oğlu, tutsaklarını götür.'”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Sonra soyluların ve halkın geri kalanları aşağı indi.","poem":1},{"text":"Yahve güçlülere karşı benim için indi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kökü Amalek'te olanlar, senin halklarının arasında","poem":1},{"text":"Senden sonra Benyamin'den, Efraim'den çıktılar.","poem":2},{"text":"Yöneticiler Makir'den indiler.","poem":1},{"text":"Mareşalin asasını idare edenler Zevulun'dan geldi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İssakar beyleri Devora'nın yanındaydı.","poem":1},{"text":"İssakar nasılsa Barak da öyleydi.","poem":2},{"lineBreak":true},{"text":"Ayaklarının dibindeki vadiye koştular.","poem":2},{"text":"Ruven'in su yollarının yanında","poem":1},{"text":"yüreğin önemli kararları vardı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neden koyun ağıllarının arasında oturdun?","poem":1},{"text":"Sürülerin ıslık sesini duymak için mi?","poem":2},{"text":"Ruven'in su yollarında yüreğin önemli arayışları vardı.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gilad Yarden'in ötesinde yaşıyordu.","poem":1},{"text":"Dan neden gemilerde kaldı?","poem":2},{"lineBreak":true},{"text":"Asher denizin limanında kıpırdamadan oturuyor","poem":2},{"lineBreak":true},{"text":"ve derelerinin kıyısında yaşıyordu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zevulun canlarını ölüme kadar tehlikeye atan bir halktı;","poem":1},{"text":"Naftali de meydanın yüksek yerlerindeydi.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Krallar gelip savaştılar;","poem":1},{"text":"sonra Kenan kralları Megiddo suları kıyısındaki Taanak'ta savaştılar.","poem":2},{"lineBreak":true},{"text":"Hiç gümüş yağmalamadılar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gökyüzünden yıldızlar savaştılar.","poem":1},{"text":"Sisera'ya karşı rotalarından savaştılar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kişon Irmağı, o eski ırmak,","poem":1},{"text":"Kişon Irmağı onları süpürüp attı.","poem":2},{"lineBreak":true},{"text":"Ey ruhum, üzerlerine güçle yürü.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sonra atların şahlanması yüzünden,","poem":1},{"text":"güçlülerinin şahlanması yüzünden,","poem":2},{"lineBreak":true},{"text":"at toynakları yere damga vurdular.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yahve'nin meleği,","poem":1},{"text":"'Meroz'a lanetleyin' dedi.","poem":2},{"lineBreak":true},{"text":"‘Orada yaşayanları ağır bir şekilde lanetleyin,","poem":2},{"lineBreak":true},{"text":"Çünkü onlar Yahve'nin yardımına,","poem":2},{"lineBreak":true},{"text":"Güçlülere karşı Yahve'nin yardımına gelmediler.’”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Kenli Hever'in karısı, Yael,","poem":1},{"text":"kadınlar arasında fazlasıyla kutsanacak;","poem":2},{"lineBreak":true},{"text":"çadır kadınları arasında fazlasıyla kutsansın.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Su istedi.","poem":1},{"text":"Kadın ona süt verdi.","poem":2},{"lineBreak":true},{"text":"Ona efendilere layık bir tabakta tereyağı getirdi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Elini çadır kazığına,","poem":1},{"text":"sağ elini de işçi tokmağına koydu.","poem":2},{"text":"Tokmakla Sisera'yı vurdu.","poem":1},{"text":"Kafasına çaktı.","poem":2},{"lineBreak":true},{"text":"Evet, şakaklarından delip geçirdi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Onun ayaklarına kapandı, düşüp yattı.","poem":1},{"text":"Ayaklarının dibinde eğildi, düştü.","poem":2},{"lineBreak":true},{"text":"Eğildiği o yere, ölü düştü.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"“Kadın pencereden dışarı baktı ve bağırdı:","poem":1},{"text":"Sisera'nın annesi kafesten baktı.","poem":2},{"text":"'Arabasının gelmesi neden bu kadar uzun sürüyor?","poem":1},{"text":"Arabalarının tekerlekleri neden bekliyor?'","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bilge hanımları ona yanıt verdi,","poem":1},{"text":"evet, kendi kendine yanıt verdi,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Bir kız, her erkeğe iki kız;","poem":1},{"lineBreak":true},{"text":"Sisera'ya boyalı giysi yağması,","poem":1},{"text":"işlenmiş boyalı giysi yağması,","poem":2},{"lineBreak":true},{"text":"yağma olarak iki yanı işlenmiş boyalı giysi,","poem":2},{"text":"ganimeti bulup da paylaşmadılar mı?'","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"“Bütün düşmanların yok olsun, ey Yahve,","poem":1},{"text":"ama O'nu sevenler, gücünde doğan güneş gibi olsunlar.”","poem":2},"Ondan sonra ülke kırk yıl rahat etti."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}