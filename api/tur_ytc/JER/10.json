{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Ey İsrael evi, Yahve'nin size söylediği sözü dinleyin!"]},{"type":"verse","number":2,"content":["Yahve şöyle diyor:",{"text":"“Ulusların yolunu öğrenmeyin,","poem":1},{"text":"gökyüzü belirtilerinden korkmayın;","poem":2},{"lineBreak":true},{"text":"çünkü uluslar onlardan korkar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü halkların gelenekleri boştur;","poem":1},{"text":"çünkü biri ormandan bir ağaç keser,","poem":2},{"lineBreak":true},{"text":"baltayla usta eli işidir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onu gümüşle ve altınla süslerler.","poem":1},{"text":"Çivilerle ve çekiçlerle sabitlerler,","poem":2},{"lineBreak":true},{"text":"böylece yerinden oynamaz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onlar tornacı işi palmiye ağacı gibidirler, ve konuşmazlar.","poem":1},{"lineBreak":true},{"text":"Taşınmaları gerekir,","poem":1},{"text":"çünkü hareket etmezler.","poem":2},{"text":"Onlardan korkmayın;","poem":1},{"text":"çünkü kötülük yapamazlar,","poem":2},{"lineBreak":true},{"text":"onlarda iyilik yapmak da yoktur.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Senin gibisi yoktur, ey Yahve.","poem":1},{"text":"Sen büyüksün,","poem":2},{"lineBreak":true},{"text":"ve adın kudretinde büyüktür.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senden kim korkmaz,","poem":1},{"text":"ey ulusların kralı?","poem":2},{"lineBreak":true},{"text":"Çünkü bu sana aittir.","poem":2},{"text":"Çünkü ulusların bütün bilgeleri","poem":1},{"text":"ve bütün krallıkları arasında,","poem":2},{"lineBreak":true},{"text":"senin gibisi yoktur.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama onlar hem budala hem de akılsızdır, putlar tarafından eğitilmişlerdir!","poem":1},{"text":"O yalnızca odundur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tarşiş'ten dövülmüş gümüş levhalar,","poem":1},{"text":"ve Ufaz'dan altın getirilir,","poem":2},{"lineBreak":true},{"text":"oymacı ve kuyumcu eli işidir.","poem":2},{"text":"Giysileri mavi ve mordur.","poem":1},{"text":"Hepsi usta adamların işidir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama gerçek Tanrı Yahve'dir.","poem":1},{"text":"O diri Tanrı ve ebedi Kral'dır.","poem":2},{"text":"Gazabından yeryüzü titrer.","poem":1},{"text":"Uluslar O'nun öfkesine dayanamazlar.","poem":2}]},{"type":"verse","number":11,"content":["“Onlara şöyle diyeceksin: ‘Gökleri ve yeri yaratmayan ilâhlar, yerden ve göklerin altından yok olacaklar.’”"]},{"type":"verse","number":12,"content":[{"text":"Tanrı, yeryüzünü kudretiyle yarattı.","poem":1},{"text":"Dünyayı bilgeliğiyle kurdu,","poem":2},{"lineBreak":true},{"text":"ve anlayışıyla gökleri gerdi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O ses verince göklerdeki sular gürler,","poem":1},{"text":"ve buharları yeryüzünün uçlarından yükseltir.","poem":2},{"text":"Yağmur için şimşekler yapar,","poem":1},{"text":"ve hazinelerinden rüzgâr çıkarır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Herkes budala ve bilgisiz oldu.","poem":1},{"text":"Her kuyumcu oyma suretinden dolayı hayal kırıklığına uğradı;","poem":2},{"text":"çünkü dökme putu yalandır,","poem":1},{"text":"ve onlarda soluk yoktur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onlar boştur, aldatıcı bir iştir.","poem":1},{"text":"Ziyaret edildikleri zaman yok olacaklar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yakov'un payı bunlara benzemez;","poem":1},{"text":"çünkü her şeyin yapıcısı O'dur;","poem":2},{"text":"ve İsrael O'nun mirasının boyudur.","poem":1},{"text":"Adı Ordular Yahvesi'dir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ey kuşatma altında yaşayanlar,","poem":1},{"text":"mallarınızı ülkeden toplayın.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü Yahve şöyle diyor,","poem":1},{"text":"“İşte, bu zamanda ülkenin sakinlerini sapanla atacağım,","poem":2},{"lineBreak":true},{"text":"ve onları sıkıntıya sokacağım, böylece hissedecekler.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yaram yüzünden vay halime!","poem":1},{"text":"Yaram ciddi;","poem":2},{"text":"ama dedim ki,","poem":1},{"text":"“Gerçekten bu benim kederim ve buna katlanmalıyım.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çadırım yıkıldı,","poem":1},{"text":"ve bütün iplerim koptu.","poem":2},{"text":"Çocuklarım benden uzaklaştı ve artık yoklar.","poem":1},{"text":"Artık çadırımı gerecek, perdelerimi dikecek kimse yok.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çobanların hepsi budala oldu,","poem":1},{"text":"ve Yahve’ye danışmadılar.","poem":2},{"text":"Bu yüzden başarılı olmadılar ve bütün sürüleri dağıldı.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"İşte haber sesi geliyor,","poem":1},{"text":"ve kuzey ülkesinden büyük bir kargaşalık,","poem":2},{"text":"Yahuda kentlerini ıssız bırakmak,","poem":1},{"text":"çakalların yurdu yapmak için.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ey Yahve, bilirim ki, insanın yolu kendi elinde değildir.","poem":1},{"text":"Adımlarını doğrultmak yürüyen insanın elinde değildir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ey Yahve, beni düzelt, ama yumuşak bir şekilde;","poem":1},{"text":"öfkenle değil, yoksa beni hiçe indirirsin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gazabını seni bilmeyen ulusların,","poem":1},{"text":"ve adını çağırmayan boyların üzerine dök;","poem":2},{"text":"çünkü Yakov'u onlar yediler,","poem":1},{"text":"evet, onu yiyip tükettiler,","poem":2},{"lineBreak":true},{"text":"ve onun yurdunu harap ettiler.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}