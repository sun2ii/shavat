{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Ne zaman seninle çekişsem,","poem":1},{"text":"sen haklısın, ey Yahve,","poem":2},{"text":"yine de seninle davamı savunmak istiyorum.","poem":1},{"text":"Kötülerin yolu neden başarılı oluyor?","poem":2},{"lineBreak":true},{"text":"Neden çok hainlik edenlerin hepsi rahat?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Onları sen diktin. Evet, kök saldılar.","poem":1},{"text":"Büyüdüler. Evet, ürün verdiler.","poem":2},{"text":"Ağızlarında yakınsın,","poem":1},{"text":"ve yüreklerinden uzaksın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama sen, ey Yahve, beni biliyorsun.","poem":1},{"text":"Beni görüyorsun ve yüreğimi sana karşı sınıyorsun.","poem":2},{"text":"Onları kesim koyunları gibi çıkar,","poem":1},{"text":"ve onları kesim gününe hazırla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ülke ne zamana dek yas tutacak,","poem":1},{"text":"ve bütün ülkenin otları ne zamana dek solacak?","poem":2},{"text":"Orada oturanların kötülüğü yüzünden","poem":1},{"text":"hayvanlar ve kuşlar yok oldu;","poem":2},{"text":"çünkü onlar, “Bizim sonumuzu görmeyecek” dediler.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Eğer yaya gidenlerle koştuysan,","poem":1},{"text":"ve seni yordularsa,","poem":2},{"lineBreak":true},{"text":"o zaman atlarla nasıl çekişebilirsin?","poem":2},{"text":"Esenlik ülkesinde güvende olsan da,","poem":1},{"text":"ama Yarden'in gururunda nasıl yapacaksın?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü kardeşlerin ve babanın evi bile,","poem":1},{"text":"sana hainlik ettiler!","poem":2},{"lineBreak":true},{"text":"Ardından yüksek sesle sana bağırdılar!","poem":2},{"text":"Sana güzel sözler söyleseler bile,","poem":1},{"text":"onlara inanma.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Evimi terk ettim,","poem":1},{"text":"mirasımı reddettim.","poem":2},{"lineBreak":true},{"text":"Canımın sevdiğini düşmanlarının eline verdim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mirasım ormandaki aslan gibi oldu bana.","poem":1},{"text":"Bana karşı sesini yükseltti.","poem":2},{"lineBreak":true},{"text":"Bu yüzden ondan nefret ettim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mirasım bana benekli bir yırtıcı kuş gibi mi oldu?","poem":1},{"text":"Her yandan yırtıcı kuşlar ona karşı mı?","poem":2},{"text":"Git, kırın bütün hayvanlarını toplayın.","poem":1},{"text":"Yiyip bitirmek için onları getirin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Birçok çoban bağımı mahvetti.","poem":1},{"text":"Payımı ayaklar altında çiğnediler.","poem":2},{"lineBreak":true},{"text":"Hoş payımı ıssız bir çöl ettiler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onlar onu perişan ettiler.","poem":1},{"text":"Kimsesiz karşımda yas tutuyor.","poem":2},{"text":"Bütün ülke ıssız oldu,","poem":1},{"text":"çünkü kimse aldırmıyor.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yıkıcılar çöldeki bütün çıplak tepeler üzerine geldiler;","poem":1},{"text":"çünkü Yahve'nin kılıcı ülkenin bir ucundan öbür ucuna kadar yiyip bitiriyor.","poem":2},{"lineBreak":true},{"text":"Hiçbir bedenin esenliği yok.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Buğday ektiler,","poem":1},{"text":"ve diken biçtiler.","poem":2},{"text":"Kendilerini tükettiler ve hiçbir yarar sağlamadılar.","poem":1},{"lineBreak":true},{"text":"Yahve'nin kızgın öfkesi yüzünden","poem":1},{"text":"ürünlerinizden utanacaksınız.”","poem":2}]},{"type":"verse","number":14,"content":["Yahve şöyle diyor, “Halkım İsrael'e miras olarak verdiğim mirasa dokunan bütün kötü komşularım için: İşte, onları topraklarından söküp atacağım, Yahuda evini de aralarından söküp atacağım."]},{"type":"verse","number":15,"content":["Öyle olacak ki, onları söküp attıktan sonra geri döneceğim ve onlara acıyacağım. Herkesi kendi mirasına, herkesi kendi toprağına, onları geri getireceğim."]},{"type":"verse","number":16,"content":["Halkıma Baal üzerine ant içmeyi öğrettikleri gibi, onlar da halkımın yollarını, 'Yahve'nin varlığı hakkı için' diye benim adımla ant içmeyi özenle öğrenirlerse, o zaman halkımın ortasında güçlenecekler."]},{"type":"verse","number":17,"content":["Ama dinlemezlerse, o ulusu söküp atacağım, söküp yok edeceğim.” diyor Yahve."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}