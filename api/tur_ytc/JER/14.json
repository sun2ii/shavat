{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Kuraklık hakkında Yeremya'ya gelen Yahve'nin sözü şudur:"]},{"type":"verse","number":2,"content":[{"text":"“Yahuda yas tutuyor,","poem":1},{"text":"ve kapıları solgun.","poem":2},{"text":"Yerde siyahlara bürünmüş oturuyorlar.","poem":1},{"text":"Yeruşalem'in feryadı yükseliyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Soyluları küçüklerini sulara gönderiyor.","poem":1},{"text":"Sarnıçlara geliyorlar,","poem":2},{"lineBreak":true},{"text":"ve su bulamıyorlar.","poem":2},{"text":"Kapları boş dönüyorlar.","poem":1},{"text":"Hayal kırıklığına uğruyorlar, şaşkına dönüp başlarını örtüyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çatlamış toprak yüzünden,","poem":1},{"text":"ülkede yağmur yağmadığı için,","poem":2},{"text":"çiftçiler hayal kırıklığına uğruyor.","poem":1},{"text":"Başlarını örtüyorlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Evet, kırdaki dişi geyik de","poem":1},{"text":"yavrusunu doğurup bırakıyor,","poem":2},{"lineBreak":true},{"text":"çünkü ot yok.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaban eşekleri çıplak tepeler üzerinde duruyor.","poem":1},{"text":"Çakallar gibi havayı hızlı hızlı soluyorlar.","poem":2},{"text":"Gözleri sönüyor,","poem":1},{"text":"çünkü yeşillik yok.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Suçlarımız bize karşı tanıklık etse de,","poem":1},{"text":"sen ey Yahve, kendi adın uğruna çalış;","poem":2},{"text":"çünkü isyanlarımız çoktur.","poem":1},{"text":"Sana karşı günah işledik.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey sen İsrael'in umudu,","poem":1},{"text":"sıkıntı zamanındaki onun Kurtarıcısı,","poem":2},{"text":"neden ülkede bir yabancı,","poem":1},{"text":"ve geceyi geçirmek için yolundan sapan bir yolcu gibi olasın?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neden ürkmüş biri gibi,","poem":1},{"text":"kurtarmaya güce yetmeyen bir yiğit gibi olasın?","poem":2},{"text":"Oysa sen, ey Yahve, aramızdasın,","poem":1},{"text":"ve biz senin adınla çağırılıyoruz.","poem":2},{"lineBreak":true},{"text":"Bizi bırakma.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve bu halka şöyle diyor:","poem":1},{"text":"“Böyle dolaşmayı sevdiler.","poem":2},{"lineBreak":true},{"text":"Ayaklarını alıkoymadılar.","poem":2},{"text":"Bu yüzden Yahve onları kabul etmiyor.","poem":1},{"text":"Şimdi suçlarını hatırlayacak,","poem":2},{"lineBreak":true},{"text":"ve günahları için onları cezalandıracak.”","poem":2}]},{"type":"verse","number":11,"content":["Yahve bana, “Bu halkın iyiliği için dua etme” dedi."]},{"type":"verse","number":12,"content":["“Oruç tuttuklarında feryatlarını duymayacağım, yakmalık sunu ve tahıl sunusu sunduklarında onları kabul etmeyeceğim; ama onları kılıçla, kıtlıkla ve vebayla tüketeceğim.”"]},{"type":"verse","number":13,"content":["O zaman şöyle dedim, “Ah, ey Efendi Yahve! İşte peygamberler onlara, ‘Kılıcı görmeyeceksiniz, kıtlık da çekmeyeceksiniz. Ama bu yerde size kesin esenlik vereceğim.’ diyor.”"]},{"type":"verse","number":14,"content":["O zaman Yahve bana şöyle dedi, “Peygamberler benim adıma yalan peygamberlik ediyor. Onları ben göndermedim, onlara buyurmadım, onlara söylemedim. Size yalan bir görüm, falcılık, hiçlik ve kendi yüreklerinin aldatmacasını peygamberlik ediyorlar."]},{"type":"verse","number":15,"content":["Bu yüzden Yahve, kendilerini göndermediğim halde benim adımla peygamberlik eden peygamberler hakkında şöyle diyor: ‘Bu ülkede kılıç ve kıtlık olmayacak’ diyorlar. Bu peygamberler kılıç ve kıtlıkla tükenecekler."]},{"type":"verse","number":16,"content":["Peygamberlik ettikleri halk kıtlık ve kılıç yüzünden Yeruşalem sokaklarına atılacak. Onları, kendilerini, karılarını, oğullarını ve kızlarını gömecek kimseleri olmayacak. Çünkü onların kötülüğünü kendi üzerlerine dökeceğim.”"]},{"type":"verse","number":17,"content":[{"text":"“Onlara şu sözü söyleyeceksin:","poem":1},{"text":"'“Gözlerim gece gündüz yaş akıtsın,","poem":2},{"lineBreak":true},{"text":"ve durmasın;","poem":2},{"text":"çünkü halkımın el değmemiş kızı büyük bir yarıkla,","poem":1},{"text":"çok ağır bir yarayla kırıldı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eğer kıra çıksam,","poem":1},{"text":"işte kılıçla öldürülenler!","poem":2},{"text":"Kente girsem,","poem":1},{"text":"işte kıtlıktan hasta olanlar!","poem":2},{"text":"Çünkü peygamber de kâhin de ülkede dolanıyor,","poem":1},{"text":"ama hiçbir şey bilmiyorlar.”'","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahuda’yı bütünüyle reddettin mi?","poem":1},{"text":"Canın Siyon’dan tiksindi mi?","poem":2},{"text":"Neden bizi vurdun, bize şifa yok?","poem":1},{"text":"Esenliği bekledik, ama iyilik gelmedi;","poem":2},{"lineBreak":true},{"text":"ve şifa zamanı bekledik, işte, dehşet!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ey Yahve, kötülüğümüzü,","poem":1},{"text":"ve atalarımızın suçunu kabul ediyoruz;","poem":2},{"lineBreak":true},{"text":"çünkü sana karşı günah işledik.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Adın uğruna bizden tiksinme.","poem":1},{"text":"Görkeminin tahtını utandırma.","poem":2},{"lineBreak":true},{"text":"Hatırla ve bizimle olan antlaşmanı bozma.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ulusların boş şeyleri arasında yağmur yağdırabilen var mı?","poem":1},{"text":"Ya da gökyüzü sağanak verebilir mi?","poem":2},{"lineBreak":true},{"text":"Sen Tanrımız Yahve değil misin?","poem":2},{"text":"Bu yüzden seni bekleyeceğiz;","poem":1},{"text":"çünkü bütün bu şeyleri sen yaptın.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}