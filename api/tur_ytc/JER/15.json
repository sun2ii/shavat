{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["O zaman Yahve bana şöyle dedi, “Moşe ve Samuel önümde dursalar bile, yine düşüncem bu halka yönelmez. Onları önümden at da çıksınlar!"]},{"type":"verse","number":2,"content":["Öyle olacak ki, sana, ‘Nereye çıkacağız?’ diye sorduklarında, onlara şöyle diyeceksin, ‘Yahve şöyle diyor:",{"text":"“Ölüm için olanlar ölüme,","poem":1},{"lineBreak":true},{"text":"kılıç için olanlar kılıca,","poem":1},{"lineBreak":true},{"text":"kıtlık için olanlar kıtlığa,","poem":1},{"lineBreak":true},{"text":"sürgün için olanlar sürgüne.\"”'","poem":1}]},{"type":"verse","number":3,"content":["Yahve şöyle diyor, “Onların üzerine dört çeşidini atayacağım: Öldürmek için kılıcı, parçalamak için köpekleri, yiyip bitirmek ve yok etmek için gökyüzünün kuşlarını ve yeryüzünün hayvanlarını."]},{"type":"verse","number":4,"content":["Yahuda Kralı Hizkiya oğlu Manaşşe’nin Yeruşalem’de yaptığı şeyler yüzünden, onları yeryüzünün bütün krallıkları arasında oradan oraya savuracağım."]},{"type":"verse","number":5,"content":[{"text":"Çünkü ey Yeruşalem, sana kim acıyacak?","poem":1},{"text":"Sana kim yas tutacak?","poem":2},{"lineBreak":true},{"text":"Halini sormaya kim gelecek?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beni reddettin.” diyor Yahve.","poem":1},{"text":"“Geri gittin.","poem":2},{"text":"Bu yüzden elimi sana karşı uzattım,","poem":1},{"text":"ve seni yok ettim.","poem":2},{"lineBreak":true},{"text":"Acımaktan yoruldum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ülkenin kapılarında onları yabayla savurdum.","poem":1},{"text":"Çocuksuz bıraktım.","poem":2},{"text":"Halkımı yok ettim.","poem":1},{"text":"Yollarından dönmediler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dul kadınları deniz kumundan daha çok çoğaldı.","poem":1},{"text":"Onlara, genç adamların anası üzerine öğleyin yok ediciyi getirdim.","poem":2},{"lineBreak":true},{"text":"Ansızın onun üzerine sıkıntı ve dehşetleri düşürdüm.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yedi çocuk doğuran kadın cansızlaşıp,","poem":1},{"text":"ruhunu teslim etti.","poem":2},{"text":"Onun güneşi daha gündüzken battı.","poem":1},{"text":"Hayal kırıklığına uğradı ve utandı.","poem":2},{"lineBreak":true},{"text":"Geriye kalanlarını düşmanlarının önünde kılıca teslim edeceğim.” diyor Yahve.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vay halime, ey anam!","poem":1},{"text":"Beni bütün dünya ile kavga ve çekişme adamı olarak doğurmuşsun!","poem":2},{"text":"Ben ödünç vermedim, kimse de bana ödünç vermedi;","poem":1},{"text":"yine de hepsi bana lanet ediyor.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve şöyle dedi,","poem":1},{"text":"“Elbette seni iyilik için güçlendireceğim.","poem":2},{"lineBreak":true},{"text":"Kesinlikle düşmanın kötülük zamanında,","poem":2},{"lineBreak":true},{"text":"ve sıkıntı zamanında sana yalvarmasını sağlayacağım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bir kimse demiri,","poem":1},{"text":"kuzeyden gelen demiri ve tuncu kırabilir mi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Malını ve hazinelerini bedelsiz olarak yağma edeceğim,","poem":1},{"text":"bunu da bütün günahların için, bütün sınırların boyunca.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onları düşmanlarınla birlikte bilmediğin bir ülkeye geçireceğim;","poem":1},{"text":"çünkü öfkemde bir ateş tutuştu,","poem":2},{"lineBreak":true},{"text":"sizin üzerinizde yanacak.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ey Yahve, sen bilirsin.","poem":1},{"text":"Beni hatırla, beni ziyaret et,","poem":2},{"lineBreak":true},{"text":"ve zulmedenlerimden öcümü al.","poem":2},{"text":"Sen sabırlısın, bu yüzden beni kaptırma.","poem":1},{"text":"Senin uğruna hakarete uğradığımı bil.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sözlerin bulundu,","poem":1},{"text":"ve onları yedim.","poem":2},{"text":"Sözlerin bana neşe ve yüreğime sevinç oldu,","poem":1},{"text":"çünkü senin adınla çağırılıyorum,","poem":2},{"lineBreak":true},{"text":"ey Ordular Tanrısı Yahve.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sevinip coşanlar topluluğunda oturmadım.","poem":1},{"text":"Senin elinden ötürü tek başıma oturdum,","poem":2},{"lineBreak":true},{"text":"çünkü beni öfkeyle doldurdun.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Acım neden sürekli,","poem":1},{"text":"iyileşmek istemeyen yaram neden çaresiz?","poem":2},{"text":"Gerçekten de bana aldatıcı bir dere,","poem":1},{"text":"tükenen sular gibi mi olacaksın?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bu yüzden Yahve şöyle diyor,","poem":1},{"text":"“Eğer dönersen, seni geri getireceğim,","poem":2},{"lineBreak":true},{"text":"ki önümde durasın;","poem":2},{"text":"ve eğer değerli olanı değersizden ayırırsan,","poem":1},{"text":"benim ağzımmış gibi olursun.","poem":2},{"text":"Onlar sana dönecekler,","poem":1},{"text":"ama sen onlara dönmeyeceksin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Seni bu halka sağlam bir tunç duvar yapacağım.","poem":1},{"text":"Sana karşı savaşacaklar,","poem":2},{"lineBreak":true},{"text":"ama sana karşı galip gelemeyecekler;","poem":2},{"text":"çünkü seni kurtarmak ve seni özgür kılmak için ben seninleyim.” diyor Yahve.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"“Seni kötülerin elinden özgür kılacağım,","poem":1},{"text":"ve seni korkunçların elinden fidyeyle kurtaracağım.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}