{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Yahve'nin sözü bana geldi ve şöyle dedi:"]},{"type":"verse","number":2,"content":["“Git, Yeruşalem'e duyurup şöyle de, ‘Yahve diyor ki,",{"text":"‘Gençliğindeki iyiliğini,","poem":1},{"text":"gelinliğindeki sevgini,","poem":2},{"text":"çölde, ekilmemiş bir ülkede ardımdan nasıl gittiğini hatırlıyorum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İsrael, Yahve'ye kutsal,","poem":1},{"text":"ürününün ilk meyvesiydi.","poem":2},{"text":"Onu yiyen herkes suçlu tutulacak.","poem":1},{"text":"Üzerlerine bela gelecek’ diyor Yahve.”","poem":2}]},{"type":"verse","number":4,"content":["Ey Yakov evi, İsrael evinin bütün boyları, Yahve'nin sözünü dinleyin!"]},{"type":"verse","number":5,"content":["Yahve şöyle diyor,",{"text":"‘Atalarınız bende ne haksızlık buldular da,","poem":1},{"text":"benden uzaklaştılar,","poem":2},{"text":"değersiz boşluğun ardından yürüdüler,","poem":1},{"text":"ve değersiz oldular?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Bizi Mısır diyarından çıkaran,","poem":1},{"text":"çölde, bozkırlar ve çukurlar diyarında,","poem":2},{"lineBreak":true},{"text":"kuraklık ve ölüm gölgesi diyarında,","poem":2},{"lineBreak":true},{"text":"hiç kimsenin geçmediği ve hiç kimsenin yaşamadığı bir diyarda","poem":2},{"lineBreak":true},{"text":"bizi yürüten Yahve nerede?” demediler.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Meyvesini ve iyiliğini yemeniz için","poem":1},{"text":"sizi bereketli bir diyara getirdim;","poem":2},{"text":"ama siz girince ülkemi kirlettiniz,","poem":1},{"text":"ve mirasımı iğrenç bir şey haline getirdiniz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Kâhinler, Yahve nerede?” demediler,","poem":1},{"text":"ve yasayı ellerinde tutanlar beni tanımadılar.","poem":2},{"text":"Yöneticiler de bana karşı suç işlediler,","poem":1},{"text":"ve peygamberler Baal ile peygamberlik ettiler,","poem":2},{"lineBreak":true},{"text":"ve yararsız şeylerin ardından gittiler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Bu yüzden sizinle daha çekişeceğim,” diyor Yahve,","poem":1},{"text":"“Ve çocuklarınızın çocuklarıyla çekişeceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü Kittim adalarına geçin ve görün.","poem":1},{"text":"Kedar'a gönderip dikkatle düşünün,","poem":2},{"lineBreak":true},{"text":"böyle bir şey olup olmadığını görün.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bir millet hiç ilâhlarını değiştirdi mi?","poem":1},{"text":"Ki onlar zaten ilâhlar değildir.","poem":2},{"lineBreak":true},{"text":"Ama benim halkım,","poem":2},{"lineBreak":true},{"text":"yararsız olanla kendi görkemini değiştirdi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Ey gökler, buna şaşın ve dehşet içinde korkun.","poem":1},{"text":"Çok perişan olun,” diyor Yahve.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Çünkü halkım iki kötülük yaptı:","poem":1},{"text":"Beni, diri suların kaynağını bıraktı,","poem":2},{"lineBreak":true},{"text":"ve kendileri için sarnıçlar, su tutmayan çatlak sarnıçlar kazdılar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İsrael köle mi?","poem":1},{"text":"Köle olarak mı doğdu?","poem":2},{"lineBreak":true},{"text":"Neden tutsak oldu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Genç aslanlar ona kükredi ve seslerini yükselttiler.","poem":1},{"text":"Ülkesini harap ettiler.","poem":2},{"lineBreak":true},{"text":"Kentleri yakıldı, oturan kimse kalmadı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Memfis ve Tahpanhes çocukları da","poem":1},{"text":"başının tacını kırdılar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Tanrın","poem":1},{"noteId":3},{"text":"Yahve seni yolda yürütürken,","poem":1},{"text":"O'nu bıraktığın için,","poem":2},{"lineBreak":true},{"text":"bunu başına kendin getirmedin mi?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Şimdi Şihor sularından içmek için Mısır'a gitmekle ne kazanıyorsun?","poem":1},{"text":"Ya da neden Irmak","poem":2},{"noteId":4},{"text":"sularından içmek için Aşur yoluna gidiyorsun?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Seni kendi kötülüğün terbiye edecek","poem":1},{"text":"ve dönekliğin seni azarlayacak.","poem":2},{"text":"Öyleyse bil ve gör ki,","poem":1},{"text":"Tanrın Yahve'yi bırakman,","poem":2},{"lineBreak":true},{"text":"ve benden korkun olmaması kötü ve acı bir şeydir.”","poem":2},{"lineBreak":true},{"text":"Diyor Efendi, Ordular Yahvesi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Çünkü boyunduruğunu uzun zaman önce kırdım,","poem":1},{"text":"bağlarını kopardım.","poem":2},{"text":"'Hizmet etmeyeceğim' dedin;","poem":1},{"text":"çünkü her yüksek tepenin üzerinde,","poem":2},{"lineBreak":true},{"text":"ve her yeşil ağacın altında eğilip fahişelik ettin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Oysa seni asil bir asma,","poem":1},{"text":"saf ve sadık bir tohum dikmiştim.","poem":2},{"lineBreak":true},{"text":"Öyleyse nasıl oldu da,","poem":2},{"lineBreak":true},{"text":"bana yabancı bir asmanın yozlaşmış çubuklarına döndün?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü kendini kül suyuyla yıkasan,","poem":1},{"text":"ve çok sabun kullansan da,","poem":2},{"lineBreak":true},{"text":"yine suçun önümde belirgin duruyor.” diyor Efendi Yahve.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Nasıl, ‘Ben kirlenmedim,","poem":1},{"text":"Baallar’ın peşinden gitmedim’ diyebiliyorsun?","poem":2},{"text":"Vadideki yoluna bak da ne yaptığını bil.","poem":1},{"lineBreak":true},{"text":"Sen yollarını kat eden hızlı bir hecin devesisin,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"çöle alışık, canı çektiğinde rüzgârı koklayan yaban eşeğisin.","poem":1},{"text":"Kızgınlık dönemindeyken onu kim geri çevirebilir?","poem":2},{"lineBreak":true},{"text":"Onu arayanların hiçbiri kendileri yorulmazlar.","poem":2},{"lineBreak":true},{"text":"Onun ayı gelince onu bulurlar.”","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“Ayaklarını çıplak, boğazını susuz bırakma.","poem":1},{"lineBreak":true},{"text":"Ama sen, ‘Boşuna’ dedin.","poem":1},{"text":"'Hayır, ben yabancıları sevdim,","poem":2},{"lineBreak":true},{"text":"ve onların peşinden gideceğim.'","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hırsız bulunduğunda nasıl utanırsa,","poem":1},{"text":"İsrael evi de kendileri,","poem":2},{"lineBreak":true},{"text":"kralları, beyleri, kâhinleri ve peygamberleri öyle utanıyorlar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ağaca, 'Sen babamsın,' taşa, 'Beni sen doğurdun' derler.","poem":1},{"lineBreak":true},{"text":"Çünkü sırtlarını bana döndürdüler, yüzlerini değil.","poem":1},{"text":"Sıkıntı zamanlarında, 'Kalk, bizi kurtar!' diyecekler.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"“Ama kendine yaptığın ilâhların nerede?","poem":1},{"text":"Sıkıntılı zamanınızda sizi kurtarabilirlerse, kalksınlar.","poem":2},{"lineBreak":true},{"text":"Çünkü kentlerinin çokluğu kadar ilâhların var, Ey Yahuda.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Neden benimle çekişiyorsunuz?","poem":1},{"text":"Hepiniz bana karşı suç işlediniz.” diyor Yahve.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Çocuklarınızı boşuna vurdum.","poem":1},{"text":"Terbiyeyi kabul etmediler.","poem":2},{"text":"Kendi kılıcın peygamberlerini yiyip bitirdi,","poem":1},{"text":"yok edici bir aslan gibi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ey kuşak, Yahve'nin sözünü düşünün.","poem":1},{"text":"Ben İsrael'e çöl mü oldum?","poem":2},{"lineBreak":true},{"text":"Ya da koyu karanlık bir diyar?","poem":2},{"text":"Halkım neden, 'Çözülüp kaçtık, artık sana gelmeyeceğiz' diyor?”","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"“El değmemiş kız kendi süslerini,","poem":1},{"text":"gelin kendi giysisini unutabilir mi?","poem":2},{"lineBreak":true},{"text":"Ancak halkım beni sayısız günler boyunca unuttu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Sevgi peşinde kendi yolunu ne de iyi hazırlıyorsun!","poem":1},{"text":"Bu yüzden kötü kadınlara bile kendi yollarını öğrettin.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Masum yoksulların canlarının kanı da senin eteklerinde bulunuyor.","poem":1},{"text":"Onları zorla içeri girerken bulmadın,","poem":2},{"lineBreak":true},{"text":"ama bu, bütün bu şeylerden dolayıdır.”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“Yine de, ‘Ben masumum’ dedin.","poem":1},{"text":"Kesin olarak öfkesi benden döndü.","poem":2},{"text":"“İşte, ‘Günah işlemedim’ dediğin için seni yargılayacağım.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Neden yollarını değiştirmek için bu kadar çok dolaşık gidiyorsun?","poem":1},{"text":"Aşur’dan utandığın gibi,","poem":2},{"lineBreak":true},{"text":"Mısır’dan da utanacaksın.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ellerini başının üstüne koyarak oradan da ayrılacaksın;","poem":1},{"text":"çünkü Yahve senin güvendiklerini reddetti,","poem":2},{"lineBreak":true},{"text":"ve onlarla başarılı olmayacaksın.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":2,"verse":17}},{"noteId":4,"caller":"+","text":"yani Fırat Irmağı","reference":{"chapter":2,"verse":18}}]},"thisChapterLink":"/api/tur_ytc/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}