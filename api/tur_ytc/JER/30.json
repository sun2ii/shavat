{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Yahve'den Yeremya'ya gelen söz şöyleydi:"]},{"type":"verse","number":2,"content":["“İsrael'in Tanrısı Yahve şöyle diyor, 'Sana söylediğim bütün sözleri bir kitaba yaz."]},{"type":"verse","number":3,"content":["Çünkü Yahve şöyle diyor, “işte, halkım İsrael ve Yahuda'nın sürgününü geri çevireceğim günler geliyor. 'Onları atalarına verdiğim ülkeye geri getireceğim ve orayı mülk edinecekler.'”"]},{"type":"verse","number":4,"content":["Yahve'nin İsrael ve Yahuda hakkında söylediği sözler bunlardı."]},{"type":"verse","number":5,"content":["Çünkü Yahve şöyle diyor:",{"text":"“Titreme sesi duyduk;","poem":1},{"text":"korku sesi, esenlik sesi değil.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Şimdi sorun da görün, bir erkek doğum sancısı çeker mi?","poem":1},{"text":"Neden her erkeğin ellerini beline koyduğunu,","poem":2},{"lineBreak":true},{"text":"bütün yüzlerinin solduğunu,","poem":2},{"lineBreak":true},{"text":"doğum sancısı çeken bir kadın gibi görüyorum?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ah, çünkü o gün öyle büyük ki, onun gibisi yoktur!","poem":1},{"text":"Yakov'un sıkıntı zamanıdır bu,","poem":2},{"lineBreak":true},{"text":"ama o bundan kurtulacaktır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ordular Yahvesi şöyle diyor, o gün öyle olacak ki, onun boyunduruğunu senin boynundan kırıp çıkaracağım,","poem":1},{"text":"bağlarını koparacağım.","poem":2},{"lineBreak":true},{"text":"Yabancılar artık onları kendilerine köle yapmayacaklar;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ama Tanrıları Yahve'ye,","poem":1},{"text":"ve kendilerine çıkaracağım kralları David'e hizmet edecekler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bu yüzden korkma, ey hizmetkârım Yakov, diyor Yahve.","poem":1},{"text":"Yılma, ey İsrael.","poem":2},{"text":"Çünkü işte, seni uzaktan kurtaracağım,","poem":1},{"text":"ve soyunu sürgün ülkesinden kurtaracağım.","poem":2},{"text":"Yakov dönecek, sakin ve rahat olacak.","poem":1},{"text":"Onu kimse korkutmayacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü seni kurtarmak için, ben seninleyim, diyor Yahve;","poem":1},{"text":"çünkü seni dağıttığım bütün ulusların bütünüyle sonunu getireceğim,","poem":2},{"lineBreak":true},{"text":"ama senin bütünüyle sonunu getirmeyeceğim;","poem":2},{"text":"ama seni ölçüyle yola getireceğim,","poem":1},{"text":"seni kesinlikle cezasız bırakmayacağım.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü Yahve şöyle diyor,","poem":1},{"text":"“Senin yaran tedavi edilemez.","poem":2},{"lineBreak":true},{"text":"Senin yaran ağır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Davanı savunacak kimse yok ki,","poem":1},{"text":"sana sargı vurulsun.","poem":2},{"lineBreak":true},{"text":"Şifa verecek ilaçların yok.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bütün sevgililerin seni unuttu,","poem":1},{"text":"seni aramıyorlar.","poem":2},{"text":"Çünkü suçunun büyüklüğü yüzünden seni düşman yarasıyla,","poem":1},{"text":"zalimin cezasıyla yaraladım,","poem":2},{"text":"çünkü günahların çoğaldı.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Neden yaran için feryat ediyorsun?","poem":1},{"text":"Ağrın tedavi edilemez.","poem":2},{"text":"Suçunun büyüklüğü yüzünden bunları sana yaptım,","poem":1},{"text":"çünkü günahların çoğaldı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bu yüzden seni yutanların hepsi yutulacak.","poem":1},{"text":"Bütün düşmanların, hepsi sürgüne gidecek.","poem":2},{"text":"Seni yağmalayanlar yağmalanacak.","poem":1},{"text":"Seni avlayanların hepsini av yapacağım.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü yine seni iyileştireceğim,","poem":1},{"text":"yaralarını iyileştireceğim.” diyor Yahve,","poem":2},{"text":"“Çünkü, 'O, hiç kimsenin aramadığı Siyon'dur’","poem":1},{"text":"diyerek senin adını sürgün koydular.”","poem":2}]},{"type":"verse","number":18,"content":["Yahve şöyle diyor:",{"text":"“İşte, Yakov’un çadırlarının sürgününü tersine çevireceğim,","poem":1},{"text":"onun meskenlerine acıyacağım.","poem":2},{"text":"Kent kendi tepesinde kurulacak,","poem":1},{"text":"saray da kendi yerinde duracak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Şükran, neşelenenlerin sesiyle birlikte","poem":1},{"text":"onlardan yükselecek.","poem":2},{"text":"Onları çoğaltacağım,","poem":1},{"text":"az olmayacaklar;","poem":2},{"text":"onları yücelteceğim,","poem":1},{"text":"küçük olmayacaklar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çocukları da eskisi gibi olacak,","poem":1},{"text":"onların topluluğu önümde sağlamlaştırılacak.","poem":2},{"lineBreak":true},{"text":"Onlara baskı yapan herkesi cezalandıracağım.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Beyleri onlardan biri olacak,","poem":1},{"text":"yöneticileri onların arasından çıkacak.","poem":2},{"text":"Onu yaklaştıracağım,","poem":1},{"text":"bana yaklaşacak;","poem":2},{"lineBreak":true},{"text":"çünkü kimdir o, bana yaklaşmaya cesaret eden?” diyor Yahve.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Siz benim halkım olacaksınız,","poem":1},{"text":"ben de sizin Tanrınız olacağım.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İşte, Yahve'nin kasırgası, gazabı çıktı,","poem":1},{"text":"süpürüp götüren bir kasırga;","poem":2},{"text":"kötülerin başına patlayacak.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yahve'nin kızgın öfkesi, yüreğinin tasarılarını yerine getirinceye,","poem":1},{"text":"ve onu tamamlayıncaya dek geri dönmeyecek.","poem":2},{"lineBreak":true},{"text":"Son günlerde bunu anlayacaksınız.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}