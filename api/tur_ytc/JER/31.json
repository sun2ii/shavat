{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["“O zaman,” diyor Yahve, “İsrael’in bütün boylarının Tanrısı olacağım ve onlar da benim halkım olacaklar.”"]},{"type":"verse","number":2,"content":["Yahve şöyle diyor, “Kılıçtan sağ kurtulan halk, İsrael, ben onu dinlendirmeye gittiğimde, çölde lütuf buldu.”"]},{"type":"verse","number":3,"content":["Yahve eskiden bana görünüp dedi,",{"text":"“Evet, seni sonsuz bir sevgiyle sevdim,","poem":1},{"text":"bu yüzden seni sevgi dolu iyiliğimle kendime çektim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seni yeniden bina edeceğim,","poem":1},{"text":"ve bina edileceksin, ey İsrael'in el değmemiş kızı.","poem":2},{"text":"Yine teflerinle süsleneceksin,","poem":1},{"text":"ve eğlenenlerin oyunlarına katılacaksın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yine Samariya dağlarında bağlar dikeceksin.","poem":1},{"text":"Bağcılar dikecek,","poem":2},{"lineBreak":true},{"text":"ve meyvesini tadacaklar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü Efraim tepelerindeki bekçilerin,","poem":1},{"text":"'Kalkın! Siyona'a, Tanrımız Yahve'ye çıkalım' diye bağıracakları bir gün olacak.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü Yahve şöyle diyor,","poem":1},{"text":"“Yakov için sevinçle ezgi söyleyin, ulusların başı için bağırın.","poem":2},{"text":"İlan edin, övün ve şöyle deyin,","poem":1},{"text":"‘Ey Yahve, halkını,","poem":2},{"lineBreak":true},{"text":"İsrael’in kalıntılarını kurtar!’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İşte, ben onları kuzey ülkesinden getireceğim,","poem":1},{"text":"ve onları dünyanın uçlarından,","poem":2},{"text":"onlarla birlikte körü, topalı, gebe kadını ve doğuran kadını toplayacağım.","poem":1},{"text":"Büyük bir topluluk olarak dönecekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ağlayarak gelecekler.","poem":1},{"text":"Yalvarışlarla onlara yol göstereceğim.","poem":2},{"text":"Onları su ırmakları boyunca,","poem":1},{"text":"tökezlemeyecekleri doğru yolda yürüteceğim.","poem":2},{"text":"Çünkü ben İsrael’in babasıyım.","poem":1},{"text":"Efraim ilk oğlumdur.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Ey uluslar, Yahve'nin sözünü dinleyin,","poem":1},{"text":"ve uzak adalarda duyurup deyin,","poem":2},{"text":"‘İsrael’i dağıtan onu toplayacak,","poem":1},{"text":"ve çoban sürüsünü nasıl korursa onu öyle koruyacak.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü Yahve Yakov’u kurtardı,","poem":1},{"text":"ve onu kendisinden daha güçlü olanın elinden fidye ile kurtardı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Siyon’un yüksek yerine gelip ezgi söyleyecekler,","poem":1},{"text":"ve Yahve'nin iyiliğine,","poem":2},{"text":"tahıla, yeni şaraba, yağa,","poem":1},{"text":"sürünün ve sığırın yavrularına akacaklar.","poem":2},{"text":"Canları sulanmış bir bahçe gibi olacak.","poem":1},{"text":"Artık hiç kederlenmeyecekler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O zaman gençlerle yaşlılar birlikte,","poem":1},{"text":"el değmemiş kız oynayıp sevinecek;","poem":2},{"text":"çünkü onların yasını sevince çevireceğim,","poem":1},{"text":"onları teselli edeceğim,","poem":2},{"lineBreak":true},{"text":"ve kederlerinden dolayı onları sevindireceğim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kâhinlerin canını yağla doyuracağım,","poem":1},{"text":"ve halkım iyiliğimle doyacak.” diyor Yahve.","poem":2}]},{"type":"verse","number":15,"content":["Yahve şöyle diyor:",{"text":"“Rama’da bir ses duyuluyor,","poem":2},{"lineBreak":true},{"text":"ağıt ve acı ağlama,","poem":2},{"text":"Rahel çocukları için ağlıyor.","poem":1},{"text":"Çocukları için teselli edilmeyi reddediyor,","poem":2},{"lineBreak":true},{"text":"çünkü onlar artık yok.”","poem":2}]},{"type":"verse","number":16,"content":["Yahve şöyle diyor:",{"text":"“Sesini ağlamaktan,","poem":1},{"text":"gözlerini gözyaşından alıkoy,","poem":2},{"lineBreak":true},{"text":"çünkü emeğin ödüllendirilecek” diyor Yahve.","poem":2},{"lineBreak":true},{"text":"“Düşman ülkesinden geri gelecekler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sonun için umut var.” diyor Yahve.","poem":1},{"text":"“Çocukların kendi topraklarına geri dönecekler.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Efraim’in böyle üzüldüğünü kesinlikle duydum,","poem":1},{"text":"‘Beni terbiye ettin,","poem":2},{"lineBreak":true},{"text":"ve terbiye edildim, terbiye edilmemiş bir dana gibi.","poem":2},{"text":"Beni döndür, ben de döneceğim,","poem":1},{"text":"çünkü Tanrım Yahve sensin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gerçekten ondan sonra döndüm.","poem":1},{"text":"Tövbe ettim.","poem":2},{"text":"Ondan sonra eğitildim.","poem":1},{"text":"Kalçamı vurdum.","poem":2},{"text":"Gençlik ayıbını taşıdığım için utandım,","poem":1},{"text":"rezil oldum.'","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Efraim benim değerli oğlum değil mi?","poem":1},{"text":"Sevgili çocuk değil mi?","poem":2},{"text":"Çünkü ona karşı ne zaman konuşsam,","poem":1},{"text":"onu hâlâ içtenlikle hatırlıyorum.","poem":2},{"text":"Bu yüzden yüreğim onu özlüyor.","poem":1},{"text":"Ona kesinlikle merhamet edeceğim.” diyor Yahve.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Yol işaretleri dik.","poem":1},{"text":"İşaret direkleri yap.","poem":2},{"text":"Yüreğini ana yola,","poem":1},{"text":"gittiğin yola koy.","poem":2},{"text":"Dön, el değmemiş İsrael kızı.","poem":1},{"text":"Dön bu kendi kentlerine.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ey dönek kız, ne zamana dek oradan oraya dolaşacaksın?","poem":1},{"lineBreak":true},{"text":"Çünkü Yahve yeryüzünde yeni bir şey yarattı:","poem":1},{"text":"Kadın erkeği koruyacak.”","poem":2}]},{"type":"verse","number":23,"content":["İsrael'in Tanrısı, Ordular Yahvesi şöyle diyor: “Ben onların sürgünlerini geri döndürünce, Yahuda ülkesinde ve kentlerinde yine şu sözü söyleyecekler: ‘Ey doğruluk yurdu, ey kutsal dağ, Yahve seni kutsasın.’"]},{"type":"verse","number":24,"content":["Yahuda ve bütün kentleri, çiftçiler ve sürüleriyle birlikte göç edenler, orada birlikte oturacaklar."]},{"type":"verse","number":25,"content":["Çünkü yorgun canı doyurdum, her kederli canı doldurdum.”"]},{"type":"verse","number":26,"content":["Bunun üzerine uyandım ve baktım; uykum bana tatlı geldi."]},{"type":"verse","number":27,"content":["“İşte, İsrael evini Yahuda evini insan tohumuyla ve hayvan tohumuyla ekeceğim günler geliyor” diyor Yahve."]},{"type":"verse","number":28,"content":["“Onları söküp atmak, yıkmak, devirmek, yok etmek ve sıkıntıya sokmak için nasıl gözetlediysem, bina etmek ve dikmek için de öyle gözetleyeceğim” diyor Yahve."]},{"type":"verse","number":29,"content":["“O günlerde artık,",{"text":"'Babalar koruk yedi,","poem":1},{"text":"çocukların dişleri kamaştı' demeyecekler.”","poem":2}]},{"type":"verse","number":30,"content":["Ama herkes kendi suçu yüzünden ölecek. Koruk yiyen herkesin kendi dişleri kamaşacak."]},{"type":"verse","number":31,"content":["“İşte, İsrael evi ve Yahuda eviyle yeni bir antlaşma yapacağım günler geliyor” diyor Yahve."]},{"type":"verse","number":32,"content":["“Bu, onları Mısır diyarından çıkarmak için ellerinden tuttuğum gün atalarıyla yaptığım antlaşmaya benzemiyor. Gerçi ben onlara kocaydım, o antlaşmamı bozdular.” diyor Yahve."]},{"type":"verse","number":33,"content":["“Ama o günlerden sonra İsrael eviyle yapacağım antlaşma şudur” diyor Yahve:",{"text":"“Yasamı içlerine koyacağım,","poem":1},{"text":"ve onu yüreklerine yazacağım.","poem":2},{"text":"Ben onların Tanrısı olacağım,","poem":1},{"text":"onlar da benim halkım olacaklar.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Artık hiçbiri komşusuna,","poem":1},{"text":"hiçbiri kardeşine, ‘Yahve'yi bilin’ diye öğretmeyecek.","poem":2},{"text":"Çünkü en küçüğünden en büyüğüne kadar","poem":1},{"text":"onların hepsi beni bilecek” diyor Yahve,","poem":2},{"text":"“Çünkü suçlarını bağışlayacağım,","poem":1},{"text":"ve günahlarını bir daha hatırlamayacağım.”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Gündüzün ışığı olarak güneşi,","poem":1},{"text":"gecenin ışığı olarak ayın ve yıldızların yasalarını veren,","poem":2},{"text":"denizi çalkalayıp dalgalarını gürleten Yahve,","poem":1},{"text":"adı Ordular Yahvesi olan şöyle diyor:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Eğer bu yasalar önümden kalkarsa,” diyor Yahve,","poem":1},{"text":"“o zaman İsrael soyundan gelenler de sonsuza dek önümde ulus olmaktan çıkacaktır.”","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yahve şöyle diyor: “Eğer yukarıdaki gökler ölçülebilirse,","poem":1},{"text":"yeryüzünün altındaki temeller araştırılabilirse,","poem":2},{"text":"ben de o zaman İsrael soyundan gelenleri bütün yaptıkları yüzünden atarım” diyor Yahve.","poem":1}]},{"type":"verse","number":38,"content":["“İşte, Hananel Kulesi'nden köşe kapısına kadar kentin Yahve için kurulacağı günler geliyor” diyor Yahve."]},{"type":"verse","number":39,"content":["“Ölçü ipi, daha öteye, dosdoğru Gareb Tepesi'ne kadar uzanacak ve Goah'a doğru dönecek."]},{"type":"verse","number":40,"content":["Cesetler ve küller vadisinin tamamı ve Kidron Vadisi'ne kadar, doğuya doğru At Kapısı'nın köşesine kadar bütün tarlalar Yahve için kutsal olacak. Artık sonsuza dek sökülmeyecek veya yıkılmayacak.”"]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}