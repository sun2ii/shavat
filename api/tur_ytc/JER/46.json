{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":["Yahve'nin Peygamber Yeremya'ya uluslar hakkında gelen sözü."]},{"type":"verse","number":2,"content":["Mısır hakkında: Mısır Kralı Firavun Neko'nun Fırat Irmağı yanında Karkemiş'te bulunan ordusu hakkında; Babil Kralı Nebukadnetsar, Yahuda Kralı Yoşiya oğlu Yehoyakim'in dördüncü yılında onu vurdu."]},{"type":"verse","number":3,"content":[{"text":"“Küçük kalkanı ve büyük kalkanı hazırlayın,","poem":1},{"text":"ve savaşa yaklaşın!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atları koşun ve binin, ey atlılar,","poem":1},{"text":"miğferlerinizi takıp dikilin.","poem":2},{"text":"Mızraklarınızı parlatın,","poem":1},{"text":"zırhlarınızı giyin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bunu neden gördüm?","poem":1},{"text":"Şaşkına döndüler ve geri döndüler.","poem":2},{"text":"Yiğitleri yere çalındı,","poem":1},{"text":"aceleyle kaçtılar,","poem":2},{"lineBreak":true},{"text":"ve geriye bakmadılar.","poem":2},{"text":"Dehşet her yanda.” diyor Yahve.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Hızlı olan kaçmasın,","poem":1},{"text":"yiğit kaçıp kurtulmasın.","poem":2},{"text":"Kuzeyde, Fırat Irmağı yanında","poem":1},{"text":"tökezleyip düştüler.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Nil gibi,","poem":1},{"text":"suları kabaran ırmaklar gibi yükselen bu kimdir?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mısır, Nil gibi,","poem":1},{"text":"suları kabaran ırmaklar gibi yükseliyor.","poem":2},{"text":"‘Yükseleceğim, yeryüzünü örteceğim.","poem":1},{"text":"Kentleri ve onların sakinlerini yok edeceğim.’ diyor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey atlar, şahlanın!","poem":1},{"text":"Öfkelenin, ey savaş arabaları!","poem":2},{"text":"Yiğitler:","poem":1},{"text":"Kalkanı kullanan Kuş ve Put;","poem":2},{"lineBreak":true},{"text":"yayı kullanan ve geren Ludim çıksınlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü o gün,","poem":1},{"lineBreak":true},{"text":"Ordular Yahvesi'nin, düşmanlarından öç alacağı","poem":1},{"text":"bir öç günüdür.","poem":2},{"text":"Kılıç onları yiyip bitirecek, doyacak,","poem":1},{"text":"ve kana kana onların kanından içecek.","poem":2},{"lineBreak":true},{"text":"Çünkü Ordular Yahvesi'nin,","poem":2},{"lineBreak":true},{"text":"Fırat Irmağı yanındaki kuzey ülkesinde bir kurbanı var.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gilad'a çık da merhem al,","poem":1},{"text":"ey sen, Mısır'ın el değmemiş kızı.","poem":2},{"lineBreak":true},{"text":"Boşuna çok ilaç kullanıyorsun.","poem":2},{"lineBreak":true},{"text":"Senin için şifa yok.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uluslar senin utancını duydular,","poem":1},{"text":"ve yeryüzü feryadınla doldu;","poem":2},{"lineBreak":true},{"text":"çünkü yiğit yiğide karşı tökezledi,","poem":2},{"lineBreak":true},{"text":"ikisi de birlikte düştüler.”","poem":2}]},{"type":"verse","number":13,"content":["Babil Kralı Nebukadnetsar'ın gelip Mısır ülkesini vuracağına dair Yahve'nin Peygamber Yeremya'ya söylediği söz:"]},{"type":"verse","number":14,"content":[{"text":"“Mısır'da ilan edin,","poem":1},{"text":"Migdol'da duyurun,","poem":2},{"lineBreak":true},{"text":"Memfis'te ve Tahpanhes'te duyurup şöyle deyin,","poem":2},{"text":"'Kalk ve hazırlan,","poem":1},{"text":"çünkü kılıç çevreni yiyip bitirdi.'","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Güçlülerin neden süpürüldüler?","poem":1},{"text":"Ayakta durmadılar, çünkü Yahve onları itti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Birçoğunu tökezletti.","poem":1},{"text":"Evet, birbirlerinin üzerine düştüler.","poem":2},{"text":"'Kalkın zalim kılıçtan halkımıza,","poem":1},{"text":"doğduğumuz diyara dönelim!' dediler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Orada, 'Mısır Kralı Firavun sadece bir gürültüdür;","poem":1},{"text":"belirlenmiş zamanı kaçırdı' diye bağırdılar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Varlığımın hakkı için”","poem":1},{"text":"diyor adı Ordular Yahvesi olan Kral,","poem":2},{"text":"“Kesinlikle dağlar arasında Tabor,","poem":1},{"text":"ve deniz yanındaki Karmel gibi gelecektir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ey sen, Mısır'da oturan kız,","poem":1},{"text":"sürgüne gitmeye kendini hazırla;","poem":2},{"text":"çünkü Memfis harap olacak,","poem":1},{"text":"ve yakılıp yıkılacak,","poem":2},{"lineBreak":true},{"text":"içinde oturan kalmayacak.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Mısır çok güzel bir düvedir;","poem":1},{"text":"ama kuzeyden yıkım geldi.","poem":2},{"lineBreak":true},{"text":"Geldi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onun içindeki ücretlileri de ahırdaki buzağılar gibidir,","poem":1},{"text":"çünkü onlar da geri döndüler.","poem":2},{"lineBreak":true},{"text":"Birlikte kaçtılar.","poem":2},{"text":"Ayakta durmadılar,","poem":1},{"text":"çünkü felaketlerinin günü, ziyaretlerinin vakti üzerlerine gelmişti.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sesi yürüyen yılan gibi olacak,","poem":1},{"text":"çünkü bir orduyla yürüyecekler,","poem":2},{"lineBreak":true},{"text":"ve odun kesenler gibi, baltalarla ona karşı gelecekler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ağaçları sayılamasa da,","poem":1},{"text":"yine ormanını kesecekler,” diyor Yahve;","poem":2},{"text":"“Çünkü çekirgelerden daha çoklar,","poem":1},{"text":"ve sayısızlar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mısır kızı hayal kırıklığına uğrayacak,","poem":1},{"text":"kuzey halkının eline teslim edilecek.”","poem":2}]},{"type":"verse","number":25,"content":["İsrael'in Tanrısı, Ordular Yahvesi şöyle diyor: “İşte, No'lu Amon'u, Firavun'u, Mısır'ı, onun ilâhlarını ve krallarını, Firavun'u ve ona güvenenleri cezalandıracağım."]},{"type":"verse","number":26,"content":["Onları hayatlarını arayanların eline, Babil Kralı Nebukadnetsar'ın eline ve hizmetkârlarının eline teslim edeceğim. Ondan sonra eski günlerde olduğu gibi orada oturulacak.” diyor Yahve."]},{"type":"verse","number":27,"content":[{"text":"“Ama korkma, ey hizmetkârım Yakov.","poem":1},{"text":"Yılma, ey İsrael.","poem":2},{"text":"Çünkü işte, seni uzaktan,","poem":1},{"text":"soyunu da sürgün edildikleri ülkeden ben kurtaracağım.","poem":2},{"text":"Yakov dönecek,","poem":1},{"text":"sakin ve rahat olacak.","poem":2},{"lineBreak":true},{"text":"Onu kimse korkutmayacak.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Korkma, ey hizmetkârım Yakov,” diyor Yahve,","poem":1},{"text":"“çünkü ben seninleyim.","poem":2},{"text":"Çünkü seni sürdüğüm bütün ulusların sonunu tamamen getireceğim,","poem":1},{"lineBreak":true},{"text":"ama senin tamamen sonunu getirmeyeceğim,","poem":1},{"text":"ama seni ölçüyle yola getireceğim,","poem":2},{"lineBreak":true},{"text":"ve seni hiç cezasız bırakmayacağım.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}