{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":["Firavun Gaza'yı vurmadan önce, Peygamber Yeremya'ya Filistliler hakkında gelen Yahve'nin sözü."]},{"type":"verse","number":2,"content":[{"text":"Yahve şöyle diyor:","poem":1},{"lineBreak":true},{"text":"“İşte, sular kuzeyden yükseliyor,","poem":1},{"text":"onlar taşkın bir sel olacak,","poem":2},{"text":"ülkeyi ve içindeki her şeyi, kenti ve içinde yaşayanları sular altında bırakacak.","poem":1},{"lineBreak":true},{"text":"İnsanlar bağıracak,","poem":1},{"text":"ve ülkenin bütün sakinleri feryat edecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Güçlülerinin nallarının sesinden,","poem":1},{"text":"savaş arabalarının vızıltısından,","poem":2},{"lineBreak":true},{"text":"tekerleklerinin gürültüsünden,","poem":2},{"text":"babalar dönüp çocuklarına bakmıyorlar,","poem":1},{"text":"çünkü elleri çok zayıf.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Sur ve Sayda'dan kalan her yardımcıyı kesip atmak üzere","poem":1},{"text":"bütün Filistliler'i yok etme günü geliyor;","poem":2},{"text":"çünkü Yahve Filistliler'i,","poem":1},{"text":"Kaftor adasının kalıntısını yok edecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaza üzerine kellik geldi;","poem":1},{"text":"Aşkelon hiçe indirildi.","poem":2},{"text":"Ey vadilerinin kalıntısı,","poem":1},{"text":"kendini ne zamana dek keseceksin?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“‘Ey Yahve'nin kılıcı,","poem":1},{"text":"ne zamana dek susmayacaksın?","poem":2},{"lineBreak":true},{"text":"Kendini kınına geri koy;","poem":2},{"lineBreak":true},{"text":"dinlen ve sakin ol.”'","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Yahve sana buyurmuşken,","poem":1},{"text":"nasıl sessiz kalabilirsin?","poem":2},{"text":"Onu Aşkelon’a ve deniz kıyısına karşı,","poem":1},{"text":"orası için saptadı.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}