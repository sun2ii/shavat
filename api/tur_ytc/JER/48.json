{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":["Moav hakkında. İsrael'in Tanrısı, Ordular Yahvesi şöyle diyor:",{"text":"“Vay başına Nevo!","poem":1},{"text":"Çünkü harap oldu.","poem":2},{"text":"Kiryatayim hayal kırıklığına uğradı.","poem":1},{"text":"Alındı.","poem":2},{"text":"Misgav","poem":1},{"noteId":8},{"text":"utandırıldı,","poem":1},{"text":"ve yıkıldı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moav'ın övgüsü artık yok.","poem":1},{"text":"Heşbon'da ona karşı kötülük tasarladılar:","poem":2},{"lineBreak":true},{"text":"'Gelin! Onu bir ulus olmaktan çıkaralım.'","poem":2},{"text":"Sen de, ey Madmen, susturulacaksın.","poem":1},{"text":"Seni kılıç kovalayacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Horonayim'den feryat sesi,","poem":1},{"text":"harabe ve büyük yıkım!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moav yıkıldı.","poem":1},{"text":"Yavrularının feryadı duyuldu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü Luhit yokuşundan ağlaya ağlaya çıkıyorlar.","poem":1},{"lineBreak":true},{"text":"Çünkü Horonayim'in inişinde yıkım çığlığının sıkıntısını duydular.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kaçın! Hayatınızı kurtarın!","poem":1},{"text":"Çöldeki ardıç çalısı gibi olun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü kendi işlerine ve hazinelerine güvendiğin için","poem":1},{"text":"sen de alınacaksın.","poem":2},{"text":"Kemoş, kâhinleri ve beyleri ile birlikte","poem":1},{"text":"Sürgüne çıkacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yıkıcı her kentin üzerine gelecek,","poem":1},{"text":"ve hiçbir kent kaçıp kurtulmayacak;","poem":2},{"text":"vadi de yok olacak ve ova harap olacak,","poem":1},{"text":"Yahve'nin söylemiş olduğu gibi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moav'a kanat verin de","poem":1},{"text":"uçup kaçabilsin;","poem":2},{"text":"ve onun kentleri harap olacak,","poem":1},{"text":"içlerinde oturacak kimse kalmayacak.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Yahve'nin işini savsaklayarak yapana lanet olsun;","poem":1},{"lineBreak":true},{"text":"ve kılıcını kandan alıkoyana lanet olsun.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"“Moav gençliğinden beri rahattı,","poem":1},{"text":"ve tortusuna yerleşti,","poem":2},{"text":"ve kaptan kaba boşaltılmadı,","poem":1},{"text":"ve sürgüne gitmedi;","poem":2},{"text":"bu yüzden tadı onda kaldı,","poem":1},{"text":"ve kokusu değişmedi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bu yüzden işte,” diyor Yahve,","poem":1},{"text":"“ona dökenleri göndereceğim günler geliyor,","poem":2},{"text":"ve onu dökecekler; kaplarını boşaltacaklar,","poem":1},{"text":"ve kaplarını parçalayacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İsrael evi güvendikleri Beytel'den nasıl utandılarsa,","poem":1},{"text":"Moav da Kemoş'tan öyle utanacak.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Nasıl, ‘Biz yiğitleriz,","poem":1},{"text":"ve savaş için cesur adamlarız’ diyorsunuz?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moav harap oldu,","poem":1},{"text":"ve kentlerine çıktılar,","poem":2},{"lineBreak":true},{"text":"seçme gençleri boğazlanmak için indiler.”","poem":2},{"lineBreak":true},{"text":"diyor adı Ordular Yahvesi olan Kral.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Moav'ın felaketi yaklaşıyor,","poem":1},{"text":"ve sıkıntısı hızla geliyor.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ey onun etrafındaki herkes,","poem":1},{"text":"ve onun adını bilenlerin hepsi, onun için ağıt yakın,","poem":2},{"text":"'Güçlü asa, güzel değnek nasıl da kırıldı!'”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"“Ey sen, Divon’da oturan kız,","poem":1},{"text":"görkeminden aşağı in,","poem":2},{"lineBreak":true},{"text":"ve susuz yerde otur;","poem":2},{"text":"Çünkü Moav’ın yıkıcısı sana karşı çıktı.","poem":1},{"text":"Senin kalelerini yıktı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ey sen, Aroer’de oturan, yol kenarında dur da gözetle.","poem":1},{"text":"Kaçan adama ve kaçıp kurtulan kadına sor:","poem":2},{"lineBreak":true},{"text":"‘Ne oldu?’ de.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moav hayal kırıklığına uğradı;","poem":1},{"text":"çünkü yıkıldı.","poem":2},{"text":"Ağla ve feryat et!","poem":1},{"text":"Arnon’un yanında Moav’ın harap olduğunu söyle.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yargı ovaya geldi:","poem":1},{"text":"Holon'a, Yahzah'a, Mefaat'a,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Divon'a, Nevo'ya, Beyt Diblatayim'e,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kiryatayim'e, Beyt Gamul'a, Beyt Meon'a,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Keriyot'a, Bosra'ya,","poem":1},{"text":"ve Moav ülkesinin uzak ya da yakın bütün kentlerine.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Moav'ın boynuzu kesildi,","poem":1},{"text":"kolu kırıldı,” diyor Yahve.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“Onu sarhoş edin,","poem":1},{"text":"çünkü Yahve'ye karşı kendini yüceltti.","poem":2},{"text":"Moav kendi kusmuğunda yuvarlanacak,","poem":1},{"text":"ve o da alay konusu olacak.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çünkü İsrael senin için alay konusu mu oldu?","poem":1},{"text":"Hırsızlar arasında mı bulundu?","poem":2},{"text":"Çünkü ondan söz ettikçe,","poem":1},{"text":"baş sallıyorsun.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ey sizler, Moav sakinleri, kentleri terk edin de kayada oturun.","poem":1},{"text":"Uçurumun ağzında yuvasını yapan güvercin gibi olun.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Moav'ın övüncünü duyduk.","poem":1},{"text":"Kendini beğenmişliğiyle, gururu, küstahlığı,","poem":2},{"lineBreak":true},{"text":"ve yüreğinin büyüklenmesi çok kibirli.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Onun gazabını bilirim,” diyor Yahve, “bir hiçtir;","poem":1},{"text":"övünmeleri bir şey yapmadı.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bu yüzden Moav için ağlayacağım.","poem":1},{"text":"Evet, bütün Moav için feryat edeceğim.","poem":2},{"lineBreak":true},{"text":"Kir Heres halkı için yas tutacaklar.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Senin için Yazer'in ağlayışından daha fazla ağlayacağım,","poem":1},{"text":"ey Sivma asması.","poem":2},{"text":"Dalların denizi aştı.","poem":1},{"text":"Yazer denizine kadar ulaştı.","poem":2},{"text":"Yok edici yaz meyvelerinin ve bağ bozumunun üzerine düştü.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Verimli tarladan ve Moav ülkesinden sevinç ve neşe kaldırıldı.","poem":1},{"lineBreak":true},{"text":"Üzüm sıkma çukurundan şarabı kestim.","poem":1},{"text":"Kimse bağırarak üzüm çiğnemeyecek.","poem":2},{"lineBreak":true},{"text":"O bağırış olmayacak.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Heşbon'un feryadından Elealeh'e, Yahaz'a kadar,","poem":1},{"text":"Tsoar'dan Horonayim'e, Eglat Şelişiya'ya kadar seslerini duyurdular;","poem":2},{"lineBreak":true},{"text":"çünkü Nimrim suları da harap olacak.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Üstelik Moav'da,” diyor Yahve,","poem":1},{"text":"yüksek yerde kurban sunanı,","poem":2},{"lineBreak":true},{"text":"ve ilâhlarına buhur yakanı sona erdireceğim.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bu yüzden yüreğim Moav için ney gibi inliyor,","poem":1},{"text":"yüreğim Kir Heresliler için ney gibi inliyor.","poem":2},{"lineBreak":true},{"text":"Bu yüzden kazandığı bolluk yok oldu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Çünkü her baş kel,","poem":1},{"text":"her sakal kesilmiş.","poem":2},{"text":"Bütün ellerde kesikler,","poem":1},{"text":"belde çul var.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Moav'ın bütün damlarında,","poem":1},{"text":"ve sokaklarında her yerde ağıt var;","poem":2},{"lineBreak":true},{"text":"çünkü Moav'ı kimsenin beğenmediği bir kap gibi kırdım.” diyor Yahve.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Nasıl yıkıldı!","poem":1},{"text":"Nasıl da ağlıyorlar!","poem":2},{"text":"Moav utançtan nasıl da sırtını döndü!","poem":1},{"text":"Böylece Moav çevresindekilerin hepsine","poem":2},{"lineBreak":true},{"text":"alay konusu ve dehşet olacak.”","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Çünkü Yahve şöyle diyor: “İşte, kartal gibi uçacak,","poem":1},{"text":"ve kanatlarını Moav'a karşı gerecek.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Keriyot alındı,","poem":1},{"text":"kaleler ele geçirildi.","poem":2},{"text":"O gün Moav'ın yiğitlerinin yüreği,","poem":1},{"text":"sancı çeken bir kadının yüreği gibi olacak.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moav, Yahve'ye karşı kendini yücelttiği için,","poem":1},{"text":"bir halk olmaktan çıkacak.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ey Moav sakini,","poem":1},{"text":"dehşet, çukur ve tuzak senin üzerindedir.” diyor Yahve.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Dehşetten kaçan çukura düşecek;","poem":1},{"text":"çukurdan çıkan da tuzağa tutulacak,","poem":2},{"text":"çünkü onun üzerine, Moav'ın üzerine,","poem":1},{"text":"ziyaretleri yılını getireceğim” diyor Yahve.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"“Kaçanlar Heşbon’un gölgesinde güçsüzce duruyorlar;","poem":1},{"text":"çünkü Heşbon’dan ateş çıktı,","poem":2},{"lineBreak":true},{"text":"Sihon’un ortasından alev,","poem":2},{"text":"Moav’ın köşesini ve gürültücülerin başlarının tepesini yiyip bitirdi.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Vay haline ey Moav!","poem":1},{"text":"Kemoş halkı mahvoldu;","poem":2},{"text":"çünkü oğulların sürgüne götürüldü,","poem":1},{"text":"kızların tutsaklığa gönderildi.”","poem":2}]},{"type":"verse","number":47,"content":[{"text":"“Ama son günlerde Moav’ın sürgününü geri döndüreceğim”","poem":1},{"text":"diyor Yahve.","poem":2},"Moav’ın yargısı buraya kadardır."]}],"footnotes":[{"noteId":8,"caller":"+","text":"veya kale","reference":{"chapter":48,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}