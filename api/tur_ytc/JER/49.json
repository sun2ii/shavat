{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":["Ammon'un çocukları hakkında. Yahve şöyle diyor:",{"text":"“İsrael’in oğulları yok mu?","poem":1},{"text":"Mirasçısı yok mu?","poem":2},{"text":"Öyleyse Malkam neden Gad’ı mülk ediniyor,","poem":1},{"text":"ve halkı onun kentlerinde oturuyor?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bu yüzden, işte günler geliyor,” diyor Yahve,","poem":1},{"lineBreak":true},{"text":"“Ammon'un çocuklarının Rabba’sına karşı savaş bağırışını işittireceğim,","poem":1},{"text":"ve orası ıssız bir yığın olacak ve onun kızları ateşle yakılacak;","poem":2},{"lineBreak":true},{"text":"o zaman İsrael kendisini mülk edinenleri mülk edinecek” diyor Yahve.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ağla, ey Heşbon, çünkü Ay yıkıldı!","poem":1},{"text":"Feryat edin, ey Rabba kızları!","poem":2},{"text":"Çul giyinin.","poem":1},{"text":"Ağıt yakın ve çitler arasında ileri geri koşun;","poem":2},{"text":"çünkü Malkam, kâhinleri ve beyleri sürgüne gidecek.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ey dönek kız, neden vadilerde,","poem":1},{"text":"sulak vadinle övünüyorsun?","poem":2},{"text":"Hazinelerine güvenip,","poem":1},{"text":"‘Kim bana gelecek?’ diyordun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İşte, senin üzerine çevrende bulunanların hepsinden","poem":1},{"text":"dehşet getireceğim,” diyor Ordular Efendisi Yahve,","poem":2},{"lineBreak":true},{"text":"hepiniz tamamen kovulacaksınız,","poem":2},{"lineBreak":true},{"text":"kaçakları toplayacak kimse olmayacak.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ama ondan sonra Ammon'un çocuklarının sürgününü geri döndüreceğim,”","poem":1},{"text":"diyor Yahve.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Edom hakkında, Ordular Yahvesi şöyle diyor:","poem":1},{"text":"“Teman’da bilgelik artık yok mu?","poem":2},{"lineBreak":true},{"text":"Akıllıların öğüdü tükendi mi?","poem":2},{"lineBreak":true},{"text":"Bilgelikleri yok mu oldu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kaçın! Geri dönün!","poem":1},{"text":"Derinliklerde oturun, ey Dedan sakinleri;","poem":2},{"lineBreak":true},{"text":"çünkü Esav’ın başına gelen felaketi onun başına getireceğim,","poem":2},{"lineBreak":true},{"text":"onu ziyaret ettiğimde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Üzüm toplayıcılar size gelse,","poem":1},{"text":"biraz artakalan üzüm bırakmazlar mı?","poem":2},{"text":"Hırsızlar gece gelse,","poem":1},{"text":"yeteri kadar çalmazlar mı?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama Esav'ı ben soydum,","poem":1},{"text":"gizli yerlerini açtım, artık saklanamayacak.","poem":2},{"text":"Kardeşleri ve komşularıyla birlikte soyu da yok oldu;","poem":1},{"text":"artık yok.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yetim çocuklarınızı bırakın.","poem":1},{"text":"Onları sağ bırakacağım.","poem":2},{"lineBreak":true},{"text":"Dullarınız bana güvensinler.”","poem":2}]},{"type":"verse","number":12,"content":["Çünkü Yahve şöyle diyor: “İşte, kâseden içmeye layık olmayanlar kesinlikle içecek; ve sen tamamen cezasız kalacak olan mısın? Cezasız kalmayacaksın, kesinlikle içeceksin."]},{"type":"verse","number":13,"content":["Çünkü kendi üzerime ant içtim,” diyor Yahve, “Bosra şaşılacak, utanılacak şey, çöl ve lanetlik olacak. Bütün kentleri ebedi harabeler olacak.”"]},{"type":"verse","number":14,"content":[{"text":"Yahve'den bir haber işittim,","poem":1},{"text":"ve uluslar arasında bir elçi gönderildi,","poem":2},{"text":"“Bir araya toplanın!","poem":1},{"text":"Ona karşı gelin!","poem":2},{"lineBreak":true},{"text":"Savaşa kalkın!” dedi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Çünkü işte, uluslar arasında seni küçülttüm,","poem":1},{"text":"insanlar arasında hor gördüm.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dehşetine gelince,","poem":1},{"text":"yüreğinin gururu seni aldattı,","poem":2},{"text":"ey kaya yarıklarında oturan,","poem":1},{"text":"tepenin doruğunu tutan,","poem":2},{"text":"yuvanı kartal kadar yüksek yapsan bile,","poem":1},{"text":"seni oradan indireceğim.” diyor Yahve.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Edom şaşılacak bir şey olacak.","poem":1},{"text":"Oradan geçen herkes şaşacak,","poem":2},{"lineBreak":true},{"text":"ve bütün onun belalarına ıslık çalacak.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sodom ve Gomora ve komşu kentlerinin yıkılışında olduğu gibi,” diyor Yahve,","poem":1},{"text":"“orada hiç kimse oturmayacak,","poem":2},{"lineBreak":true},{"text":"ve hiçbir insanoğlu orada yaşamayacak.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“İşte, güçlü yurda karşı Yarden'in gururundan aslan gibi çıkacak;","poem":1},{"lineBreak":true},{"text":"çünkü onları oradan ansızın kaçıracağım,","poem":1},{"lineBreak":true},{"text":"ve kim seçilirse,","poem":1},{"text":"onu onun üzerine koyacağım.","poem":2},{"text":"Benim gibi olan kimdir?","poem":1},{"text":"Bana vakit belirleyecek olan kimdir?","poem":2},{"lineBreak":true},{"text":"Önümde duracak çoban kimdir?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bu nedenle, Yahve'nin Edom'a karşı belirlemiş olduğu öğüdünü,","poem":1},{"text":"ve Teman sakinlerine karşı amaçlamış olduğu tasarıyı dinleyin:","poem":2},{"text":"Sürünün küçüklerini kesinlikle sürükleyecekler.","poem":1},{"text":"O, kesinlikle yurdunu üzerlerine yıkacak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yeryüzü onların düşüş sesinden titriyor;","poem":1},{"text":"Kızıldeniz'de duyulan çığlık, bir gürültü var.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"İşte, kartal gibi yükselip uçacak,","poem":1},{"text":"ve kanatlarını Bosra'ya karşı gerecek.","poem":2},{"lineBreak":true},{"text":"O gün Edom'un yiğitlerinin yüreği, sancı çeken bir kadının yüreği gibi olacak.","poem":2}]},{"type":"verse","number":23,"content":["Damaskus hakkında:",{"text":"“Hamat ve Arpad utandılar,","poem":1},{"text":"Çünkü kötü haber duydular.","poem":2},{"lineBreak":true},{"text":"Eridiler.","poem":2},{"text":"Denizde keder var.","poem":1},{"text":"Sakin kalamaz.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Damaskus zayıfladı,","poem":1},{"text":"kaçmak için döndü,","poem":2},{"lineBreak":true},{"text":"onu titreme aldı.","poem":2},{"text":"Doğuran kadın gibi,","poem":1},{"text":"onu ağrı ve sıkıntılar tuttu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Övgü kenti,","poem":1},{"text":"sevincimin kenti nasıl terk edilmez?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bu yüzden gençleri sokaklarında düşecek,","poem":1},{"text":"ve bütün savaşçılar o gün susturalacak.”","poem":2},{"lineBreak":true},{"text":"diyor Ordular Yahvesi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Damaskus surlarında ateş tutuşturacağım,","poem":1},{"text":"ve Ben Hadad'ın saraylarını yiyip bitirecek.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Babil Kralı Nebukadnetsar'ın vurduğu Kedar,","poem":1},{"text":"Ve Hasor krallıkları hakkında Yahve şöyle diyor:","poem":2},{"text":"“Kalkın, Kedar'a çıkın,","poem":1},{"text":"ve doğunun çocuklarını yok edin.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Çadırlarını ve sürülerini alacaklar,","poem":1},{"text":"perdelerini, bütün kaplarını,","poem":2},{"lineBreak":true},{"text":"ve develerini kendileri için götürecekler;","poem":2},{"lineBreak":true},{"text":"ve onlara bağıracaklar, 'Her yanda dehşet!'","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kaçın!","poem":1},{"text":"Uzaklara gidin!","poem":2},{"text":"Ey Hasor sakinleri, derinliklerde oturun,” diyor Yahve;","poem":1},{"text":"“çünkü Babil Kralı Nebukadnetsar size karşı öğüt aldı,","poem":2},{"lineBreak":true},{"text":"ve size karşı bir tasarı düşündü.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kalkın! Rahat olup","poem":1},{"text":"kaygısız oturan ulusun üzerine gidin,” diyor Yahve;","poem":2},{"lineBreak":true},{"text":"“onun kapıları ve sürgüleri yoktur,","poem":2},{"lineBreak":true},{"text":"tek başına oturur.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Develeri ganimet,","poem":1},{"text":"sürüleri yağma olacak.","poem":2},{"text":"Sakallarının köşeleri kesilmiş olanları her yana dağıtacağım,","poem":1},{"text":"felaketlerini her yandan getireceğim.”","poem":2},{"lineBreak":true},{"text":"diyor Yahve.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“Hasor çakalların meskeni,","poem":1},{"text":"sonsuza dek ıssız kalacak.","poem":2},{"text":"Orada kimse oturmayacak,","poem":1},{"text":"hiçbir insanoğlu orada yaşamayacak.”","poem":2}]},{"type":"verse","number":34,"content":["Yahuda Kralı Sidkiya'nın krallığının başlangıcında, Peygamber Yeremya'ya Elam hakkında Yahve'nin şu sözü geldi:"]},{"type":"verse","number":35,"content":["“Ordular Yahvesi şöyle diyor:",{"text":"'İşte, Elam'ın yayını,","poem":1},{"text":"güçlülerinin başını kıracağım.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Elam'ın üzerine gökyüzünün dört yanından dört rüzgârı getireceğim,","poem":1},{"text":"ve onları bütün o rüzgârlara dağıtacağım.","poem":2},{"lineBreak":true},{"text":"Elam'ın sürgünlerinin gelmediği hiçbir ulus kalmayacak.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Elam'ı düşmanlarının ve hayatlarını arayanların önünde","poem":1},{"text":"Dehşete düşüreceğim.","poem":2},{"text":"Onların üzerine kötülük, kızgın öfkemi getireceğim,' diyor Yahve;","poem":1},{"text":"'ve onları tüketinceye kadar arkalarından kılıç göndereceğim.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Elam'da tahtımı kuracağım,","poem":1},{"text":"ve oradan kral ve beyleri yok edeceğim.' diyor Yahve.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"'Ama son günlerde","poem":1},{"text":"Elam'ın sürgünlüğünü geri döndüreceğim' diyor Yahve.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}