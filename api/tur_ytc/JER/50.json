{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":["Yahve'nin Babil hakkında, Keldaniler ülkesi hakkında Yeremya Peygamber aracılığıyla söylediği söz."]},{"type":"verse","number":2,"content":[{"text":"“Uluslar arasında duyurun, ilan edin,","poem":1},{"text":"bayrak dikin;","poem":2},{"lineBreak":true},{"text":"ilan edin, gizlemeyin; şöyle deyin,","poem":2},{"text":"‘Babil alındı,","poem":1},{"text":"Bel hayal kırıklığına uğradı,","poem":2},{"lineBreak":true},{"text":"Merodak dehşete düştü!","poem":2},{"text":"Onun suretleri hayal kırıklığına uğradı.","poem":1},{"text":"Onun putları dehşete düştü.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü kuzeyden bir ulus ona karşı çıkıyor,","poem":1},{"text":"ülkesini ıssız bırakacak,","poem":2},{"lineBreak":true},{"text":"içinde kimse oturmayacak.","poem":2},{"text":"Kaçtılar.","poem":1},{"text":"İnsan da hayvan da gittiler.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“O günlerde ve o zamanda,” diyor Yahve,","poem":1},{"text":"“İsrael'in çocukları ve Yahuda'nın çocukları birlikte gelecekler;","poem":2},{"text":"ağlayarak yollarına devam edecekler,","poem":1},{"text":"ve Tanrıları Yahve'yi arayacaklar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yüzleri ona dönük olarak Siyon hakkında soracaklar ve,","poem":1},{"text":"'Gelin, unutulmayacak ebedi bir antlaşmayla","poem":2},{"lineBreak":true},{"text":"Yahve'yle birleşin' diyecekler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkım kaybolmuş koyunlar oldu.","poem":1},{"text":"Çobanları onları saptırdı.","poem":2},{"text":"Onları dağlarda salıverdiler.","poem":1},{"text":"Dağdan tepeye gittiler.","poem":2},{"lineBreak":true},{"text":"Kendi dinlenme yerlerini unuttular.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bulanların hepsi onları yedi.","poem":1},{"text":"Düşmanları, 'Biz suçlu değiliz,","poem":2},{"text":"çünkü onlar Yahve'ye karşı,","poem":1},{"text":"doğruluk yurduna,","poem":2},{"lineBreak":true},{"text":"atalarının umudu olan","poem":2},{"lineBreak":true},{"text":"Yahve'ye karşı günah işlediler' dediler.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Babil'in içinden kaçın!","poem":1},{"text":"Keldaniler ülkesinden çıkın,","poem":2},{"lineBreak":true},{"text":"ve sürülerin önündeki tekeler gibi olun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü işte,","poem":1},{"text":"Kuzey ülkesinden büyük uluslardan oluşan bir topluluğu Babil'e karşı kışkırtıp çıkaracağım;","poem":2},{"lineBreak":true},{"text":"ve ona karşı dizilecekler.","poem":2},{"text":"Oradan alınacak.","poem":1},{"text":"Okları usta bir yiğidin okları gibi olacak.","poem":2},{"lineBreak":true},{"text":"Hiçbiri boş dönmeyecek.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Keldan diyarı av olacak.","poem":1},{"text":"Onu avlayanların hepsi doyurulacak.” diyor Yahve.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Mademki seviniyorsunuz,","poem":1},{"text":"mademki sevinçle coşuyorsunuz,","poem":2},{"text":"ey sizler, mirasımı yağma edenler,","poem":1},{"text":"mademki harman döven düve gibi sıçrıyorsunuz,","poem":2},{"lineBreak":true},{"text":"ve aygır gibi kişniyorsunuz,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anneniz tümüyle hayal kırıklığına uğrayacak.","poem":1},{"text":"Sizi doğuran utanacak.","poem":2},{"text":"İşte, ulusların en küçüğü olacak,","poem":1},{"text":"çöl, kurak ve ıssız bir diyar olacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve'nin gazabı yüzünden orada kimse oturmayacak,","poem":1},{"text":"ama tümüyle ıssız olacak.","poem":2},{"text":"Babil'in yanından geçen herkes şaşacak,","poem":1},{"text":"ve bütün belalarından dolayı ıslık çalacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ey siz, bütün yay gerenler,","poem":1},{"text":"Babil'e karşı her yandan dizilin;","poem":2},{"lineBreak":true},{"text":"ona ok atın.","poem":2},{"text":"Okları esirgemeyin,","poem":1},{"text":"çünkü o, Yahve'ye karşı günah işledi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Her yanından ona karşı bağırın.","poem":1},{"text":"Kendini teslim etti.","poem":2},{"lineBreak":true},{"text":"Surları yıkıldı.","poem":2},{"text":"Duvarları yıkıldı,","poem":1},{"text":"çünkü bu Yahve'nin öcüdür.","poem":2},{"text":"Ondan öç alın.","poem":1},{"text":"O ne yaptıysa ona öyle yapın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ekin ekeni,","poem":1},{"text":"ve hasat zamanında orak tutanı Babil'den kesip atın.","poem":2},{"text":"Zalim kılıcın korkusuyla,","poem":1},{"text":"her biri kendi halkına dönecek,","poem":2},{"lineBreak":true},{"text":"ve her biri kendi diyarına kaçacak.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“İsrael dağılmış koyundur.","poem":1},{"text":"Aslanlar onu kaçırttı.","poem":2},{"text":"Önce Aşur Kralı onu yedi,","poem":1},{"text":"şimdi de en sonunda Babil Kralı Nebukadnetsar onun kemiklerini kırdı.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bu yüzden İsrael'in Tanrısı, Ordular Yahvesi şöyle diyor:","poem":1},{"lineBreak":true},{"text":"“İşte, Babil Kralı'nı ve ülkesini,","poem":1},{"text":"Aşur Kralı'nı cezalandırdığım gibi cezalandıracağım.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İsrael'i tekrar kendi otlağına getireceğim,","poem":1},{"text":"Karmel ve Başan'da otlayacak.","poem":2},{"lineBreak":true},{"text":"Canı Efraim tepelerinde ve Gilad'da doyacak.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"O günlerde ve o zamanda,” diyor Yahve,","poem":1},{"text":"“İsrael'in suçları aranacak,","poem":2},{"lineBreak":true},{"text":"ve bulunmayacak,","poem":2},{"text":"Yahuda'nın günahları da bulunmayacak.","poem":1},{"text":"Çünkü kalıntı olarak bıraktıklarımı bağışlayacağım.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Merataim ülkesine karşı,","poem":1},{"text":"ona ve Pekod sakinlerine karşı çık.","poem":2},{"text":"Öldür ve onları artlarından tamamen yok et,” diyor Yahve,","poem":1},{"text":"“ve sana buyurduğum her şeye göre yap.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ülkede savaş sesi,","poem":1},{"text":"ve büyük yıkım var.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bütün yeryüzünün çekici nasıl parçalanıp kırıldı!","poem":1},{"text":"Babil uluslar arasında nasıl harap oldu!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Senin için tuzak kurdum,","poem":1},{"text":"ve sen de farkında olmadan ona tutuldun, ey Babil.","poem":2},{"text":"Bulundun,","poem":1},{"text":"ve yakalandın,","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'ye karşı savaştın.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yahve silahhanesini açtı,","poem":1},{"text":"ve öfkesinin silahlarını çıkardı;","poem":2},{"lineBreak":true},{"text":"çünkü Ordular Yahvesi'nin, Keldaniler ülkesinde yapacağı işi var.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"En uzak sınırdan ona karşı gelin.","poem":1},{"text":"Ambarlarını açın.","poem":2},{"lineBreak":true},{"text":"Onu kümeler halinde yığın.","poem":2},{"text":"Onu tümüyle yok edin.","poem":1},{"text":"Ondan hiçbir şey kalmasın.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bütün boğalarını öldürün.","poem":1},{"text":"Kesime insinler.","poem":2},{"text":"Vay başlarına! Çünkü onların günü,","poem":1},{"text":"onların ziyaret zamanı geldi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tanrımız Yahve'nin öcünü,","poem":1},{"text":"tapınağının öcünü Siyon'da ilan etmek için,","poem":2},{"lineBreak":true},{"text":"Babil diyarından kaçıp kurtulanları dinleyin.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Okçuları, yay gerenlerin hepsini Babil'e karşı toplayın.","poem":1},{"lineBreak":true},{"text":"Ona karşı çepeçevre ordugâh kurun.","poem":1},{"text":"Hiçbiri ondan kaçıp kurtulmasın.","poem":2},{"text":"Ona yaptığı işe göre ödeyin.","poem":1},{"text":"Yaptığı her şeye göre ona aynısını yapın;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'ye,","poem":2},{"lineBreak":true},{"text":"İsrael'in Kutsal Olanı'na karşı gururlandı.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bu yüzden gençleri sokaklarında düşecek.","poem":1},{"text":"Onun bütün savaşçıları o gün susturalacak.” diyor Yahve.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“İşte, ey sen kibirli olan, ben sana karşıyım,”","poem":1},{"text":"diyor Efendi Ordular Yahvesi;","poem":2},{"lineBreak":true},{"text":"“çünkü senin günün,","poem":2},{"lineBreak":true},{"text":"seni ziyaret edeceğim zaman geldi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Gururlu kişi tökezleyip düşecek,","poem":1},{"text":"ve onu kimse kaldıramayacak.","poem":2},{"text":"Onun kentlerinde ateş tutuşturacağım,","poem":1},{"text":"ve çevresinde olanların hepsini yiyip bitirecek.”","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ordular Yahvesi şöyle diyor:","poem":1},{"text":"“İsrael'in çocukları ve Yahuda'nın çocukları birlikte eziliyor.","poem":2},{"lineBreak":true},{"text":"Onları sürgün edenlerin hepsi onları sıkı tutuyor,","poem":2},{"lineBreak":true},{"text":"salıvermeyi reddediyorlar.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Onların Kurtarıcısı güçlüdür.","poem":1},{"text":"Adı Ordular Yahvesi'dir.","poem":2},{"text":"Babil'in sakinlerine rahatsızlık verip","poem":1},{"text":"yeryüzüne rahat vermek için","poem":2},{"lineBreak":true},{"text":"onların davasını tümüyle görecektir.”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Yahve, “Keldaniler'in üzerine, Babil sakinlerinin üzerine,","poem":1},{"text":"onun beylerinin üzerine,","poem":2},{"lineBreak":true},{"text":"ve onun bilge adamlarının üzerine kılıç” diyor.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Övünenlerin üzerine kılıç,","poem":1},{"text":"ve onlar akılsız olacaklar.","poem":2},{"text":"Yiğitlerin üzerine kılıç,","poem":1},{"text":"Ve dehşete kapılacaklar.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Atları üzerine,","poem":1},{"text":"savaş arabaları üzerine,","poem":2},{"lineBreak":true},{"text":"ve içinde olan bütün karışık halk üzerine kılıç;","poem":2},{"lineBreak":true},{"text":"ve onlar kadın gibi olacaklar.","poem":2},{"text":"Hazineleri üzerine kılıç,","poem":1},{"text":"ve onlar soyulacaklar.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Suları üzerine kuraklık,","poem":1},{"text":"ve onlar kuruyacaklar;","poem":2},{"text":"çünkü orası oyma suretler ülkesidir,","poem":1},{"text":"ve putları yüzünden çıldırdılar.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bu yüzden çölün vahşi hayvanları","poem":1},{"text":"Kurtlarla birlikte orada oturacak.","poem":2},{"text":"Deve kuşları orada oturacak.","poem":1},{"text":"Artık sonsuza dek orada oturulmayacak,","poem":2},{"lineBreak":true},{"text":"ve kuşaktan kuşağa içinde yaşanmayacak.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Tanrı Sodom ve Gomora'yı ve komşu kentlerini devirdiği zaman olduğu gibi,” diyor Yahve,","poem":1},{"text":"“orada hiç kimse oturmayacak,","poem":2},{"lineBreak":true},{"text":"hiçbir insanoğlu orada yaşamayacak.”","poem":2}]},{"type":"verse","number":41,"content":[{"text":"“İşte, kuzeyden bir halk geliyor.","poem":1},{"text":"Yeryüzünün uçlarından büyük bir ulus ve birçok kral harekete geçirilecek.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Yay ve mızrak alıyorlar.","poem":1},{"text":"Zalimdirler ve merhametleri yoktur.","poem":2},{"lineBreak":true},{"text":"Sesleri deniz gibi kükrüyor.","poem":2},{"text":"Atlara binmişler,","poem":1},{"text":"her biri sana karşı dizilmiş,","poem":2},{"lineBreak":true},{"text":"bir savaşçı gibi, ey Babil kızı.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Babil Kralı onların haberini duydu,","poem":1},{"text":"ve elleri güçsüzleşti.","poem":2},{"text":"Onu sıkıntı,","poem":1},{"text":"doğuran kadın gibi ağrılar tuttu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"İşte, düşman Yarden çalılıklarından aslan gibi","poem":1},{"text":"güçlü yurda karşı çıkacak;","poem":2},{"lineBreak":true},{"text":"çünkü onları oradan ansızın kaçıracağım.","poem":2},{"text":"Kim seçilirse,","poem":1},{"text":"onu onun üzerine koyacağım,","poem":2},{"lineBreak":true},{"text":"Çünkü benim gibi olan kimdir?","poem":2},{"text":"Bana zaman tayin edecek olan kimdir?","poem":1},{"text":"Önümde durabilecek çoban kimdir?”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bu yüzden, Babil'e karşı aldığı kararı,","poem":1},{"lineBreak":true},{"text":"ve Keldaniler ülkesine karşı düşündüğü tasarıyı işitin:","poem":1},{"text":"Elbette onları, sürünün küçüklerini sürükleyip götürecekler.","poem":2},{"lineBreak":true},{"text":"Elbette onların yurdunu üzerlerine yıkacaklar.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Babil'in alınmasının gürültüsünden yeryüzü titriyor.","poem":1},{"text":"Uluslar arasında feryat duyuluyor.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}