{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve şöyle diyor:","poem":1},{"lineBreak":true},{"text":"“İşte, Babil’e ve Levkamay’da oturanlara karşı","poem":1},{"text":"yıkıcı bir rüzgâr kaldıracağım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Babil’e yabancılar göndereceğim,","poem":1},{"text":"onu savuracaklar.","poem":2},{"lineBreak":true},{"text":"Ülkesini boşaltacaklar;","poem":2},{"lineBreak":true},{"text":"çünkü sıkıntı gününde her yandan ona karşı olacaklar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yay gerene karşı,","poem":1},{"text":"ve zırhı ile övünene karşı okçu yayını gersin;","poem":2},{"text":"gençlerini esirgemeyin!","poem":1},{"text":"Bütün ordusunu tümüyle yok edin!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Keldaniler ülkesinde öldürülüp","poem":1},{"text":"sokaklarında delinecekler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü ülkeleri İsrael’in Kutsalı’na karşı suçla dolu olsa bile,","poem":1},{"text":"İsrael ve Yahuda,","poem":2},{"lineBreak":true},{"text":"Tanrısı Ordular Yahvesi tarafından terk edilmedi.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Babil’in ortasından kaçın!","poem":1},{"text":"Herkes kendi hayatını kurtarsın!","poem":2},{"text":"Onun kötülüğü içinde yok olmayın,","poem":1},{"text":"çünkü bu, Yahve'nin öç alma zamanıdır.","poem":2},{"lineBreak":true},{"text":"Ona karşılığını verecektir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babil, bütün dünyayı sarhoş eden","poem":1},{"text":"Yahve'nin elinde altın bir kâsedir.","poem":2},{"text":"Uluslar onun şarabından içtiler;","poem":1},{"text":"bu yüzden çıldırdılar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babil ansızın düştü ve yıkıldı!","poem":1},{"text":"Onun için ağıt yakın!","poem":2},{"text":"Ağrısı için merhem alın.","poem":1},{"text":"Belki iyileşir.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Babil'i iyileştirmek isterdik,","poem":1},{"text":"ama iyileşmedi.","poem":2},{"text":"Onu terk edin, gidelim,","poem":1},{"text":"her birimiz kendi ülkesine;","poem":2},{"text":"çünkü onun yargısı göğe erişiyor,","poem":1},{"text":"gökyüzüne kadar yükseliyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Yahve doğruluğumuzu ortaya koydu.","poem":1},{"text":"Gelin, Tanrımız Yahve'nin işini Siyon'da duyuralım.'”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Okları bileyin!","poem":1},{"text":"Kalkanları sıkıca tutun!","poem":2},{"text":"Yahve, Med krallarının ruhunu harekete geçirdi,","poem":1},{"text":"çünkü amacı Babil'e karşı, onu yok etmektir;","poem":2},{"text":"çünkü bu Yahve'nin öcü,","poem":1},{"text":"tapınağının öcüdür.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Babil surlarına karşı bayrak dikin!","poem":1},{"text":"Bekçileri güçlendirin!","poem":2},{"text":"Bekçileri dikin,","poem":1},{"text":"ve pusuları hazırlayın;","poem":2},{"text":"çünkü Yahve, Babil sakinleri için söylediğini","poem":1},{"text":"hem tasarladı hem de yaptı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ey sen, çok sular üzerine oturup bol hazineleri olan,","poem":1},{"text":"sonun geldi, açgözlülüğünün ölçeği doldu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ordular Yahvesi kendi üzerine ant içip şöyle dedi:","poem":1},{"text":"'Mutlaka seni çekirgelerle doldurur gibi insanlarla dolduracağım,","poem":2},{"lineBreak":true},{"text":"sana karşı seslerini yükseltecekler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Yeryüzünü gücüyle yarattı.","poem":1},{"text":"Dünyayı bilgeliğiyle kurdu.","poem":2},{"lineBreak":true},{"text":"Anlayışıyla gökleri gerdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ses verince göklerde sular kükrer,","poem":1},{"text":"buharları yeryüzünün uçlarından yükseltir.","poem":2},{"text":"Yağmur için şimşek yapar,","poem":1},{"text":"hazinelerinden rüzgâr çıkarır.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Herkes budala ve bilgisiz oldu.","poem":1},{"text":"Her kuyumcu kendi suretinden dolayı hayal kırıklığına uğradı,","poem":2},{"text":"çünkü dökme suretleri yalandır,","poem":1},{"text":"ve onlarda soluk yoktur.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onlar boşunadır,","poem":1},{"text":"aldatıcılığın işidir.","poem":2},{"lineBreak":true},{"text":"Ziyaretleri zamanında yok olacaklardır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yakov'un payı bunlara benzemez,","poem":1},{"text":"çünkü mirasının oymağı da dahil olmak üzere","poem":2},{"lineBreak":true},{"text":"her şeye biçim veren O'dur.","poem":2},{"lineBreak":true},{"text":"Adı Ordular Yahvesi'dir.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Sen benim savaş baltam ve savaş silahımsın.","poem":1},{"text":"Seninle ulusları parçalayacağım.","poem":2},{"lineBreak":true},{"text":"Seninle krallıkları yok edeceğim.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Seninle atı ve binicisini parçalayacağım.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Seninle savaş arabasını,","poem":1},{"text":"ve binicisini parçalayacağım.","poem":2},{"text":"Seninle erkeği,","poem":1},{"text":"ve kadını parçalayacağım.","poem":2},{"text":"Seninle yaşlıyı,","poem":1},{"text":"ve genci parçalayacağım.","poem":2},{"text":"Seninle genci,","poem":1},{"text":"ve el değmemiş kızı parçalayacağım.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Seninle çobanı ve sürüsünü parçalayacağım.","poem":1},{"lineBreak":true},{"text":"Seninle çiftçiyi ve boyunduruğunu parçalayacağım.","poem":1},{"lineBreak":true},{"text":"Seninle valileri ve kaymakamları parçalayacağım.”","poem":1}]},{"type":"verse","number":24,"content":["“Babil’e ve Keldani sakinlerinin hepsine, senin önünde Siyon’da yaptıkları bütün kötülükleri geri vereceğim” diyor Yahve."]},{"type":"verse","number":25,"content":[{"text":"“İşte, sana karşıyım,","poem":1},{"text":"bütün yeryüzünü mahveden,","poem":2},{"lineBreak":true},{"text":"ey yıkıcı dağ” diyor Yahve.","poem":2},{"text":"“Elimi senin üzerine uzatacağım,","poem":1},{"text":"seni kayalardan aşağı yuvarlayacağım,","poem":2},{"lineBreak":true},{"text":"ve seni yanmış bir dağ yapacağım.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Senden köşe taşı,","poem":1},{"text":"temel taşı almayacaklar;","poem":2},{"lineBreak":true},{"text":"ama sonsuza dek ıssız kalacaksın.” diyor Yahve.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Ülkede bayrak dikin!","poem":1},{"text":"Uluslar arasında boru çalın!","poem":2},{"text":"Ulusları ona karşı hazırlayın!","poem":1},{"text":"Ararat, Minni ve Aşkenaz krallıklarını ona karşı çağırın!","poem":2},{"text":"Ona karşı başkomutan atayın!","poem":1},{"text":"Atları çekirge sürüsü gibi çıkarın!","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ulusları, Med krallarını, valilerini, ve bütün kaymakamlarını,","poem":1},{"text":"ve hakimiyetleri altındaki bütün diyarı ona karşı hazırlayın!","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ülke titriyor ve acı çekiyor;","poem":1},{"text":"çünkü Babil ülkesini ıssız, kimsesiz kılmak için","poem":2},{"lineBreak":true},{"text":"Yahve'nin Babil'e karşı olan tasarıları yerinde duruyor.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Babil'in yiğitleri savaşmayı bıraktılar,","poem":1},{"text":"kalelerinde kaldılar.","poem":2},{"text":"Güçleri tükendi.","poem":1},{"text":"Kadın gibi oldular.","poem":2},{"text":"Meskenleri ateşe verildi.","poem":1},{"text":"Kapı sürgüleri kırıldı.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Babil Kralı'na kentinin her taraftan alındığını göstermek için,","poem":1},{"text":"bir koşucu diğerine,","poem":2},{"lineBreak":true},{"text":"bir haberci diğerine koşacak.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Böylece geçitler tutuldu.","poem":1},{"text":"Kamışları ateşle yaktılar.","poem":2},{"lineBreak":true},{"text":"Savaşçılar korktular.”","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Çünkü İsrael'in Tanrısı, Ordular Yahvesi şöyle diyor:","poem":1},{"text":"“Babil kızı, çiğnendiği zaman harman yerine benzer.","poem":2},{"lineBreak":true},{"text":"Biraz daha, onun da hasat zamanı gelecek.”","poem":2}]},{"type":"verse","number":34,"content":[{"text":"“Babil Kralı Nebukadnetsar beni yedi,","poem":1},{"text":"beni ezdi,","poem":2},{"lineBreak":true},{"text":"Beni boş bir kap yaptı.","poem":2},{"text":"Bir canavar gibi beni yuttu.","poem":1},{"text":"Ağzını lezzetli yiyeceklerimle doldurdu.","poem":2},{"lineBreak":true},{"text":"Beni kovdu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bana ve bedenime yapılan zorbalık","poem":1},{"text":"Babil'in üzerinde olsun!” diyecek Siyon sakinleri;","poem":2},{"text":"ve “Kanım Keldaniler'in üzerinde olsun!” diyecek Yeruşalem.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Bu yüzden Yahve şöyle diyor:","poem":1},{"text":"“İşte, davanı ben göreceğim,","poem":2},{"lineBreak":true},{"text":"senin için öç alacağım.","poem":2},{"text":"Onun denizini kurutacağım,","poem":1},{"text":"ve pınarının suyunu keseceğim.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Babil oturanı olmayan,","poem":1},{"text":"taş yığınları,","poem":2},{"lineBreak":true},{"text":"çakalların yurdu,","poem":2},{"lineBreak":true},{"text":"şaşılacak ve ıslık çalınacak bir şey olacak.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Genç aslanlar gibi birlikte kükreyecekler.","poem":1},{"text":"Aslan yavruları gibi homurdanacaklar.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Kızıştıklarında,","poem":1},{"text":"şölenlerini ben yapacağım,","poem":2},{"text":"sevinsinler,","poem":1},{"text":"ve ebedi uykuya dalsınlar da uyanmasınlar diye,","poem":2},{"lineBreak":true},{"text":"onları sarhoş edeceğim.” diyor Yahve.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“Onları kuzular gibi,","poem":1},{"text":"erkeçlerle koçlar gibi kesime indireceğim.”","poem":2}]},{"type":"verse","number":41,"content":[{"text":"“Şeşak nasıl alındı!","poem":1},{"text":"Bütün dünyanın övgüsü nasıl ele geçirildi!","poem":2},{"lineBreak":true},{"text":"Babil uluslar arasında nasıl harabeye döndü!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Babil'i deniz bastı.","poem":1},{"text":"Dalgalarının çokluğuyla örtüldü.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kentleri ıssız, kurak bir yer ve çöl,","poem":1},{"text":"kimsenin oturmadığı bir diyar oldu.","poem":2},{"lineBreak":true},{"text":"Hiçbir insan yanından geçmiyor.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Babil'de Bel'i yargılayacağım,","poem":1},{"text":"ve yuttuğunu ağzından çıkaracağım.","poem":2},{"text":"Uluslar artık ona akmayacak.","poem":1},{"text":"Evet, Babil'in duvarı düşecek.”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"“Halkım, onun içinden çık,","poem":1},{"text":"ve her biriniz kendinizi Yahve'nin kızgın öfkesinden kurtarın.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yüreğiniz bayılmasın.","poem":1},{"text":"Ülkede duyulacak haberden korkmayın.","poem":2},{"text":"Çünkü bir yıl haber gelir,","poem":1},{"text":"ondan sonraki yıl başka bir haber gelir,","poem":2},{"lineBreak":true},{"text":"ve ülkede zorbalık, hükümdar hükümdara karşı.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bu yüzden işte, Babil'in oyma suretlerini yargılayacağım günler geliyor;","poem":1},{"text":"ve bütün ülkesi utandırılacak.","poem":2},{"lineBreak":true},{"text":"Bütün öldürülmüşleri onun ortasında düşecek.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"O zaman gökler, yeryüzü,","poem":1},{"text":"ve içindekilerin hepsi","poem":2},{"text":"Babil için sevinçle ezgi söyleyecek;","poem":1},{"text":"Çünkü yıkıcılar kuzeyden ona gelecekler.” diyor Yahve.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"“Babil İsrael'in öldürülmüşlerini düşürdüğü gibi,","poem":1},{"text":"ülkenin bütün öldürülmüşleri de Babil'de öyle düşecek.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ey sizler, kılıçtan kaçıp kurtulanlar, gidin!","poem":1},{"text":"Durmayın!","poem":2},{"text":"Uzaktan Yahve'yi hatırlayın,","poem":1},{"text":"ve Yeruşalem aklınıza gelsin.”","poem":2}]},{"type":"verse","number":51,"content":[{"text":"“Ayıplamalar işittiğimiz için utandık.","poem":1},{"lineBreak":true},{"text":"Yüzümüz şaşkınlıkla örtüldü,","poem":1},{"text":"çünkü yabancılar Yahve'nin evinin kutsal yerlerine girdi.”","poem":2}]},{"type":"verse","number":52,"content":[{"text":"“Bu yüzden, işte, onun oyma suretlerini yargılayacağım günler geliyor”","poem":1},{"text":"diyor Yahve;","poem":2},{"lineBreak":true},{"text":"“Ve onun bütün ülkesinde yaralılar inleyecek.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Babil gökyüzüne de yükselse,","poem":1},{"text":"gücünün yüksekliğini de sağlamlaştırsa,","poem":2},{"lineBreak":true},{"text":"yine de benden ona yıkıcılar gelecek.” diyor Yahve.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"“Babil'den bir feryat,","poem":1},{"text":"ve Keldaniler ülkesinden büyük yıkım sesi geliyor!","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Çünkü Yahve Babil'i harap ediyor,","poem":1},{"text":"ve içinden büyük sesi yok ediyor!","poem":2},{"text":"Onun dalgaları çok sular gibi kükrüyor.","poem":1},{"text":"Seslerinin gürültüsü çıkıyor.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Çünkü yıkıcı onun üzerine,","poem":1},{"text":"Babil'in üzerine geldi.","poem":2},{"text":"Yiğitleri alındı.","poem":1},{"text":"Yayları parçalandı,","poem":2},{"text":"çünkü Yahve karşılıklar Tanrısı'dır.","poem":1},{"text":"Kesinlikle karşılığını verecektir.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Onun beylerini, bilgelerini,","poem":1},{"text":"valilerini, kaymakamlarını ve yiğitlerini sarhoş edeceğim.","poem":2},{"text":"Ebedi uykuya dalacaklar ve uyanmayacaklar.”","poem":1},{"text":"diyor Kral, adı Ordular Yahvesi olan.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ordular Yahvesi şöyle diyor:","poem":1},{"text":"“Babil'in geniş surları tamamen yıkılacak.","poem":2},{"lineBreak":true},{"text":"Yüksek kapıları ateşle yakılacak.","poem":2},{"text":"Halklar boşuna, uluslar ateş için çalışacak,","poem":1},{"text":"ve yorgun düşecekler.”","poem":2}]},{"type":"verse","number":59,"content":["Yahuda Kralı Sidkiya ile birlikte Babil'e gittiğinde, Mahseya oğlu Neriya oğlu Seraya'ya Peygamber Yeremya'nın buyurduğu söz. Seraya baş görevliydi."]},{"type":"verse","number":60,"content":["Yeremya, Babil'e gelecek bütün kötülükleri, Babil hakkında yazılmış olan bütün bu sözleri bir kitaba yazdı."]},{"type":"verse","number":61,"content":["Yeremya, Seraya'ya şöyle dedi: “Babil'e vardığında, o zaman bak, bütün bu sözleri oku."]},{"type":"verse","number":62,"content":["Ve de, 'Ey Yahve, bu yer hakkında, içinde hiç kimse, ne insan ne de hayvan oturmayacak, sonsuza dek ıssız kalacak diye onu yok etmek üzere sen söyledin.'"]},{"type":"verse","number":63,"content":["Bu kitabı okumayı bitirdiğinde, ona bir taş bağlayıp Fırat'ın ortasına atacaksın."]},{"type":"verse","number":64,"content":["O zaman, 'Babil böyle batacak ve onun başına getireceğim kötülük yüzünden bir daha kalkamayacak; onlar yorgun düşecekler' diyeceksin.” Yeremya'nın sözleri buraya kadardır."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}