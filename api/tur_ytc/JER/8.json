{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Yahve şöyle diyor, “O zaman Yahuda krallarının kemiklerini, beylerinin kemiklerini, kâhinlerin kemiklerini, peygamberlerin kemiklerini ve Yeruşalem sakinlerinin kemiklerini mezarlarından çıkaracaklar."]},{"type":"verse","number":2,"content":["Bunları, sevdikleri, hizmet ettikleri, ardından gittikleri, aradıkları ve taptıkları güneşin, ayın ve gökteki bütün ordunun önüne serecekler. Toplanmayacaklar ve gömülmeyecekler. Yerin yüzünde gübre gibi olacaklar."]},{"type":"verse","number":3,"content":["Bu kötü boyun geri kalanı, onları sürmüş olduğum bütün yerlerde kalanlar, yaşamdan çok ölümü seçecekler.” diyor Ordular Yahvesi."]},{"type":"verse","number":4,"content":["“Üstelik onlara diyeceksin, ‘Yahve şöyle diyor:",{"text":"“'İnsan düşer de kalkmaz mı?","poem":1},{"text":"Biri sapar da geri dönmez mi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Öyleyse Yeruşalem halkı neden sürekli döneklikle geri düştü?","poem":1},{"text":"Hileye sarılıyorlar.","poem":2},{"lineBreak":true},{"text":"Geri dönmeyi reddediyorlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dinledim ve duydum, ama doğru olanı söylemediler.","poem":1},{"text":"Kötülüğünden tövbe eden yok, kimse “Ne yaptım?” demiyor.","poem":2},{"text":"Herkes savaşta hızla koşan bir at gibi yoluna dönüyor.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Evet, gökyüzündeki leylek belli kendi zamanlarını biliyor.'”'”","poem":1},{"text":"Kumru, kırlangıç ve turna kendi geliş zamanlarını gözetiyor;","poem":2},{"lineBreak":true},{"text":"ama halkım Yahve'nin yasasını bilmiyor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“'Nasıl diyorsunuz, “Biz bilgeyiz,","poem":1},{"text":"ve Yahve'nin yasası bizimledir?”","poem":2},{"lineBreak":true},{"text":"Ama işte, yazıcıların düzmece kalemi bunu yalana döndürdü.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bilgeler hayal kırıklığına uğradı.","poem":1},{"text":"Korktular ve tuzağa düştüler.","poem":2},{"text":"İşte, Yahve'nin sözünü reddettiler.","poem":1},{"text":"İçlerinde nasıl bir bilgelik var?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bu yüzden karılarını başkalarına, Tarlalarını da onları mülk edinecek olanlara vereceğim.","poem":1},{"lineBreak":true},{"text":"Çünkü en küçüğünden en büyüğüne kadar herkes açgözlülüğe kapılmış;","poem":1},{"text":"peygamberden kâhine kadar hepsi hileyle davranıyor.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Halkımın kızının yarasını, esenlik olmadığı halde,","poem":1},{"text":"“Esenlik, esenlik” diyerek üstten iyileştirdiler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İğrençlik ettiklerinde utandılar mı?","poem":1},{"text":"Hayır, hiç utanmadılar.","poem":2},{"lineBreak":true},{"text":"Kızarmadılar.","poem":2},{"text":"Bu yüzden düşenlerin arasına onlar da düşecekler.","poem":1},{"text":"Ziyaret edildikleri zaman aşağı atılacaklar, diyor Yahve.”'","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Yahve şöyle diyor, 'Onları tümüyle bitireceğim.","poem":1},{"text":"Asmada üzüm olmayacak,","poem":2},{"lineBreak":true},{"text":"incir ağacında incir olmayacak,","poem":2},{"lineBreak":true},{"text":"yaprak da solacak.","poem":2},{"text":"Onlara verdiğim şeyler onlardan kaybolup gidecek.'”","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Neden oturup duruyoruz?","poem":1},{"text":"Toplanın!","poem":2},{"lineBreak":true},{"text":"Surlu kentlere girelim,","poem":2},{"lineBreak":true},{"text":"orada sessiz olalım;","poem":2},{"text":"çünkü Tanrımız Yahve bizi susturdu,","poem":1},{"text":"ve bize zehirli su içirdi,","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'ye karşı günah işledik.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Esenlik bekledik, ama iyilik gelmedi;","poem":1},{"text":"ve şifa zamanı, ve işte, dehşet!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Atlarının horultusu Dan'dan duyuluyor.","poem":1},{"text":"Bütün diyar güçlülerinin kişnemesinden titriyor;","poem":2},{"text":"çünkü gelip ülkeyi ve içindeki her şeyi,","poem":1},{"text":"kenti ve içinde oturanları yiyip bitirdiler.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Çünkü işte, aranıza yılanlar,","poem":1},{"text":"engerekler göndereceğim,","poem":2},{"lineBreak":true},{"text":"ki onlara büyü yapılmaz;","poem":2},{"lineBreak":true},{"text":"ve sizi sokacaklar.” diyor Yahve.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ah kedere karşı kendimi teselli edebilseydim!","poem":1},{"text":"Yüreğim içimde baygın.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İşte, halkımın kızının çok uzak bir ülkeden feryadının sesi:","poem":1},{"text":"“Yahve Siyon'da değil mi?","poem":2},{"lineBreak":true},{"text":"Kralı orada değil mi?”","poem":2},{"text":"“Neden oyma suretleriyle ve yabancı putlarla beni öfkelendirdiler?”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"“Hasat geçti.","poem":1},{"text":"Yaz bitti ve kurtulmadık.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Halkımın kızının yarasından yaralandım.","poem":1},{"text":"Yas tutuyorum.","poem":2},{"lineBreak":true},{"text":"Dehşet beni yakaladı.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gilad'da merhem yok mu?","poem":1},{"text":"Orada hekim yok mu?","poem":2},{"lineBreak":true},{"text":"Öyleyse halkımın kızı neden iyileşmedi?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}