{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JER","translationId":"tur_ytc","name":"YEREMYA","commonName":"YEREMYA","title":"YEREMYA","order":24,"numberOfChapters":52,"sha256":"fd4c5d61df6a64b463feb8aad5fd4a2bcbccc7cb3ac12fcaa717ccc19968aa86","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tur_ytc/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Keşke, başım sular,","poem":1},{"text":"gözlerim gözyaşı pınarı olsa da,","poem":2},{"text":"halkımın kızının öldürülmüş olanları için","poem":1},{"text":"gece gündüz ağlasam!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keşke çölde konaklayacak bir yerim olsaydı da,","poem":1},{"lineBreak":true},{"text":"halkımı bırakıp da yanlarından gitsem!","poem":1},{"text":"Çünkü hepsi zina edici,","poem":2},{"lineBreak":true},{"text":"hain bir topluluk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Dillerini yaylarıymış gibi yalana eğiyorlar.","poem":1},{"lineBreak":true},{"text":"Ülkede güçlendiler, ama gerçek için değil;","poem":1},{"text":"çünkü kötülükten kötülüğe gidiyorlar,","poem":2},{"lineBreak":true},{"text":"Ve beni bilmiyorlar.” diyor Yahve.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Herkes komşusundan sakınsın,","poem":1},{"text":"ve hiçbir kardeşe güvenmeyin;","poem":2},{"text":"çünkü her kardeş bütün bütün birbirinin ayağını kaydıracak,","poem":1},{"text":"her komşu iftiracı gibi dolaşacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dostlar birbirini aldatır,","poem":1},{"text":"gerçeği söylemez.","poem":2},{"text":"Dillerini yalan söylemeyi öğrettiler.","poem":1},{"text":"Kötülük işleyerek kendilerini yoruyorlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Meskenin hilenin ortasındadır.","poem":1},{"text":"Hile yüzünden beni tanımayı reddediyorlar.” diyor Yahve.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bu yüzden Ordular Yahvesi şöyle diyor,","poem":1},{"text":"“İşte onları eritip sınayacağım;","poem":2},{"lineBreak":true},{"text":"çünkü halkımın kızı yüzünden başka nasıl davranabilirdim?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dilleri öldürücü bir oktur.","poem":1},{"text":"Hile konuşur.","poem":2},{"text":"Bir kimse komşusuna ağzıyla esenlik der,","poem":1},{"text":"ama yüreğinde onu pusuya düşürmeyi bekler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bunlardan dolayı onları cezalandırmam gerekmez mi?” diyor Yahve.","poem":1},{"text":"“Böyle bir ulustan canım öç almamalı mı?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dağlar için ağlayıp yas tutacağım,","poem":1},{"text":"çölün otlakları için ağıt yakacağım,","poem":2},{"text":"çünkü yandılar, öyle ki kimse geçmiyor;","poem":1},{"text":"insanlar sürü sesini duyamıyor.","poem":2},{"text":"Hem gökyüzünün kuşları hem de hayvanlar kaçıp gittiler.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"“Yeruşalem’i taş yığınları,","poem":1},{"text":"çakal yeri yapacağım.","poem":2},{"text":"Yahuda kentlerini ıssız,","poem":1},{"text":"kimsesiz bırakacağım.”","poem":2}]},{"type":"verse","number":12,"content":["Bunu anlayacak kadar bilge olan kimdir? Yahve'nin ağzının bunu bildirmesi için konuştuğu kişi kimdir? Ülke neden mahvoldu ve çöl gibi yandı, öyle ki içinden kimse geçmiyor?"]},{"type":"verse","number":13,"content":["Yahve şöyle diyor: “Çünkü önlerine koyduğum yasayı terk ettiler, sözümü dinlemediler, yollarımda yürümediler,"]},{"type":"verse","number":14,"content":["ama kendi yüreklerinin inatçılığı ardından ve atalarının kendilerine öğrettiği Baallar’ın peşinden gittiler.”"]},{"type":"verse","number":15,"content":["Bu yüzden İsrael’in Tanrısı, Ordular Yahvesi şöyle diyor: “İşte, bu halkı pelin otu ile besleyeceğim, onlara zehirli su içireceğim."]},{"type":"verse","number":16,"content":["Ayrıca, ne kendilerinin ne de atalarının bilmediği ulusların arasına da dağıtacağım. Ben onları tüketinceye kadar peşlerinden kılıcı göndereceğim.”"]},{"type":"verse","number":17,"content":[{"text":"Ordular Yahvesi şöyle diyor,","poem":1},{"text":"“Düşünün ve yas tutan kadınları çağırın da gelsinler.","poem":2},{"lineBreak":true},{"text":"Becerikli kadınları çağırtın da gelsinler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Acele edip","poem":1},{"text":"bizim için ağıt yaksınlar da,","poem":2},{"text":"gözlerimiz yaşlar akıtsın,","poem":1},{"text":"göz kapaklarımız sularla fışkırsın.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Çünkü Siyon'dan bir ağıt sesi duyuluyor:","poem":1},{"text":"'Nasıl da mahvolduk!","poem":2},{"text":"Çok utandık çünkü ülkeyi terk ettik,","poem":1},{"text":"çünkü evlerimizi yıktılar.'”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ancak, ey kadınlar, Yahve'nin sözünü dinleyin.","poem":1},{"text":"Kulağınız O'nun ağzının sözünü kabul etsin.","poem":2},{"text":"Kızlarınıza yas tutmayı öğretin.","poem":1},{"text":"Herkes komşusuna ağıt öğretsin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü ölüm pencerelerimize çıktı,","poem":1},{"text":"çocukları dışarıdan,","poem":2},{"lineBreak":true},{"text":"gençleri sokaklardan kesip atmak için","poem":2},{"lineBreak":true},{"text":"saraylarımıza girdi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Söyle, “Yahve şöyle diyor,","poem":1},{"text":"‘İnsanların cesetleri açık kır üzerinde gübre gibi,","poem":2},{"lineBreak":true},{"text":"orakçının ardından düşen demet gibi düşecek.","poem":2},{"lineBreak":true},{"text":"Onları kimse toplamayacak.’”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yahve şöyle diyor,","poem":1},{"lineBreak":true},{"text":"“Bilge adam bilgeliğiyle övünmesin.","poem":1},{"text":"Güçlü adam gücüyle övünmesin.","poem":2},{"lineBreak":true},{"text":"Zengin adam zenginliğiyle övünmesin.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ama övünen bununla övünsün,","poem":1},{"text":"anlayışa sahip olmakla,","poem":2},{"text":"ve yeryüzünde sevgi dolu iyilik, adalet ve doğruluk yapanın","poem":1},{"lineBreak":true},{"text":"ben Yahve olduğumu bilmekle övünsün,","poem":1},{"text":"çünkü ben bunlardan hoşlanırım.” diyor Yahve.","poem":2}]},{"type":"verse","number":25,"content":["“İşte, günler geliyor,” diyor Yahve, “yalnız bedenen sünnetli olanların hepsini cezalandıracağım:"]},{"type":"verse","number":26,"content":["Mısır'ı, Yahuda'yı, Edom'u, Ammon'un çocuklarını, Moav'ı ve çölde oturan saçlarının köşeleri kesilmiş olanların hepsini. Çünkü bütün uluslar sünnetsizdir ve bütün İsrael evi yürekte sünnetsizdir.”"]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}