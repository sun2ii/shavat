{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"“Canım yaşamımdan bıktı.","poem":1},{"text":"Yakınmama serbestçe yol vereceğim.","poem":2},{"lineBreak":true},{"text":"Canımın acısıyla konuşacağım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanrı'ya diyeceğim ki, ‘Beni mahkûm etme.","poem":1},{"text":"Bana neden benimle çekiştiğini göster.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eziyet etmen, ellerinin işini hor görmen","poem":1},{"text":"ve kötülerin öğüdüne gülümsemen senin için iyi mi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sende insan gözü mü var?","poem":1},{"text":"Yoksa insanların gördüğü gibi mi görüyorsun?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Günlerin ölümlülerin günleri gibi,","poem":1},{"lineBreak":true},{"text":"yılların insan yılları gibi mi de,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kötülüğümü soruşturup","poem":1},{"text":"günahımı araştırıyorsun?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötü olmadığımı bildiğin halde,","poem":1},{"text":"senin elinden beni kurtaracak kimse yoktur.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“'Senin ellerin beni şekillendirdi ve tümüyle biçimlendirdi,","poem":1},{"text":"yine de sen beni mahvetmektesin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hatırla, yalvarırım, sen bana balçık gibi biçimlendirdin.","poem":1},{"text":"Beni yine toprağa mı döndüreceksin?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Beni süt gibi dökmedin mi,","poem":1},{"text":"peynir gibi katılaştırmadın mı?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Beni deri ve etle giydirdin,","poem":1},{"text":"kemiklerle ve sinirlerle ördün.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bana yaşam ve sevgi dolu iyilik verdin.","poem":1},{"text":"Senin ziyaretin ruhumu korudu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yine de bunları yüreğinde sakladın.","poem":1},{"lineBreak":true},{"text":"Şunun senin yanında olduğunu bilirim:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eğer günah işlersem beni izlersin.","poem":1},{"text":"Kötülüğümden beni suçsuz çıkarmazsın.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kötüysem vay halime!","poem":1},{"text":"Doğruysam bile,","poem":2},{"lineBreak":true},{"text":"utançla dolup sıkıntımın bilincinde olarak","poem":2},{"lineBreak":true},{"text":"başımı kaldırmam.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Başım dikse, aslan gibi beni avlarsın.","poem":1},{"text":"Yine kendini bana güçlü gösterirsin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bana karşı tanıklıklarını yenilersin, bana olan öfkeni artırırsın.","poem":1},{"text":"Benimle olan savaş üzerine savaş.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“'Öyleyse, beni neden rahimden çıkardın?","poem":1},{"text":"Keşke ruhumu teslim etseydim ve hiçbir göz beni görmeseydi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hiç olmamış gibi olurdum.","poem":1},{"text":"Rahimden mezara götürülürdüm.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Günlerim az değil mi?","poem":1},{"text":"Yeter!","poem":2},{"lineBreak":true},{"text":"Beni tek başıma bırak ki, biraz olsun teselli bulabileyim,","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"geri dönmeyeceğim bir yere,","poem":2},{"lineBreak":true},{"text":"karanlık ve ölüm gölgesi diyarına gitmeden önce;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"karanlığın gece yarısı,","poem":1},{"text":"ışığın da gece yarısı gibi olduğu,","poem":2},{"lineBreak":true},{"text":"ölüm gölgesi ve düzensizlik diyarına.’”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}