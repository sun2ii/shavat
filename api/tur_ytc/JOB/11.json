{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["O zaman Naamalı Sofar şöyle yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Söz çokluğu yanıtsız mı kalsın?","poem":1},{"text":"Çok konuşan haklı mı sayılsın?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senin övünmelerin insanları susturmalı mı?","poem":1},{"text":"Sen alay edince kimse seni utandırmasın mı?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü, ‘Öğretim temiz,","poem":1},{"text":"senin gözünde ben temizim’ diyorsun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama keşke Tanrı konuşsa,","poem":1},{"text":"sana karşı dudaklarını açsa,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"sana bilgeliğin sırlarını gösterse!","poem":1},{"text":"Çünkü gerçek bilgeliğin iki yüzü vardır.","poem":2},{"lineBreak":true},{"text":"Öyleyse Tanrı’nın senden, suçunun hak ettiğinden daha azını istediğini bil.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Tanrı’nın sırrını kavrayabilir misin?","poem":1},{"text":"Ya da Her Şeye Gücü Yeten’in sınırlarının derinliğine inebilir misin?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onlar gök kadar yüksektir.","poem":1},{"text":"Ne yapabilirsin? Şeol’den","poem":2},{"noteId":5},{"text":"daha derindir. Ne bilebilirsin?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ölçüsü yeryüzünden uzun,","poem":1},{"text":"denizden daha geniştir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eğer geçip giderse, ya da kapatırsa,","poem":1},{"text":"ya da mahkemeye çağırırsa, O'na kim karşı koyabilir?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü O yalancıları bilir.","poem":1},{"text":"Dikkat etmese bile kötülüğü görür.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İnsan yaban eşeğinin yavrusu olarak doğarsa,","poem":1},{"text":"boş kafalı insan da bilge olur.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Eğer yüreğini doğru tutarsan,","poem":1},{"text":"ellerini O'na doğru açarsan;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eğer elinde kötülük varsa, onu uzaklaştır,","poem":1},{"text":"çadırlarında haksızlığın barınmasın;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"o zaman mutlaka yüzünü lekesiz olarak kaldıracaksın.","poem":1},{"text":"Evet, sarsılmayacak ve korkmayacaksın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü sıkıntını unutacaksın.","poem":1},{"text":"Onu akıp geçmiş sular gibi hatırlayacaksın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hayat öğle vaktinden daha berrak olacak.","poem":1},{"text":"Karanlık olsa bile, sabah gibi olacak.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Emniyette olacaksın, çünkü umut var.","poem":1},{"text":"Evet, araştıracaksın ve güven içinde dinleneceksin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Üstelik yatacaksın ve kimse seni korkutmayacak.","poem":1},{"text":"Evet, birçokları senin lütfunu dileyecekler.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ama kötülerin gözleri sönecek.","poem":1},{"text":"Kaçacak yerleri olmayacak.","poem":2},{"lineBreak":true},{"text":"Onların umudu ruhlarını teslim etmek olacaktır.”","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":11,"verse":8}}]},"thisChapterLink":"/api/tur_ytc/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}