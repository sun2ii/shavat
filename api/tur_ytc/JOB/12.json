{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["İyov şöyle yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Kuşkusuz, siz halksınız,","poem":1},{"text":"bilgelik de sizinle birlikte ölecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama benim de sizin gibi anlayışım var;","poem":1},{"text":"sizden aşağı değilim.","poem":2},{"lineBreak":true},{"text":"Evet, böyle şeyleri kim bilmez?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ben komşusu için gülünç biri gibi oldum,","poem":1},{"text":"ben ki, Tanrı'yı çağırırdım, O da yanıt verirdi.","poem":2},{"lineBreak":true},{"text":"Doğru ve kusursuz adam gülünç oldu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rahat olan birisinin düşüncesinde felaketi küçümseme vardır.","poem":1},{"text":"Ayağı kayanlar için bu hazırdır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haydutların çadırları rahatlık içindedir.","poem":1},{"text":"Tanrı'yı kışkırtanlar, ellerinde ilâhını taşıyanlar güvendedir.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ama şimdi hayvanlara sorun, onlar da size öğretsinler;","poem":1},{"text":"gökyüzünün kuşlarına sorun, onlar da size anlatsınlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ya da yeryüzüne konuş, o da sana öğretsin.","poem":1},{"text":"Denizin balıkları sana bildirsinler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bütün bunların arasında,","poem":1},{"text":"Yahve'nin elinin bunu yapmış olduğunu kim bilmez ki?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Her canlının yaşamı,","poem":1},{"text":"bütün insanların soluğu O'nun elindedir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Damağın yediğini tattığı gibi,","poem":1},{"text":"kulak da sözleri sınamaz mı?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaşlılarda bilgelik,","poem":1},{"text":"uzun yaşamda anlayış vardır.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Bilgelik ve kudret Tanrı'dadır.","poem":1},{"text":"Öğüt ve anlayış O'nundur.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İşte, O yıkar ve bir daha bina edilemez.","poem":1},{"text":"Birini hapseder ve kurtuluş yoktur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte, suları tutar ve kurutur.","poem":1},{"text":"Yeniden salar ve yeryüzünü altüst ederler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kuvvet ve bilgelik O'ndadır.","poem":1},{"text":"Aldatılan da aldatan da O'nundur.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Danışmanları soyulmuş olarak sürer.","poem":1},{"text":"Hâkimleri akılsızlaştırır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kralların bağını çözer.","poem":1},{"text":"Bellerini kuşakla bağlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kâhinleri soyulmuş olarak sürer,","poem":1},{"text":"güçlüleri devirir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Güvenilenlerin sözlerini ortadan kaldırır,","poem":1},{"text":"ihtiyarların anlayışını alır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Beylerin üzerine aşağılama döker,","poem":1},{"text":"güçlülerin kuşaklarını çözer.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Karanlığın içinden derin şeyleri ortaya çıkarır,","poem":1},{"text":"ölüm gölgesini ışığa çıkarır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ulusları çoğaltır, onları yok eder.","poem":1},{"text":"Ulusları genişletir, onları sürgün eder.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yeryüzü halkları önderlerinin anlayışını alır,","poem":1},{"text":"onları yolu olmayan bir çölde dolaştırır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Işık olmadan karanlıkta el yordamıyla dolaşırlar.","poem":1},{"text":"Onları sarhoş biri gibi sendeletir.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}