{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“İşte, gözüm bütün bunları gördü.","poem":1},{"text":"Kulağım duydu ve onu anladı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sizin bildiğinizi ben de biliyorum.","poem":1},{"text":"Ben sizden aşağı değilim.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Elbette Yüce Olan'la konuşmak,","poem":1},{"text":"Tanrı ile tartışmak isterdim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ama siz yalan uyduruyorsunuz.","poem":1},{"text":"Hepiniz değersiz hekimlersiniz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Keşke tamamen sussanız!","poem":1},{"text":"O zaman bilge olurdunuz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Şimdi davamı duyun.","poem":1},{"text":"Dudaklarımın iddialarını dinleyin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tanrı adına haksızca mı söyleyeceksiniz,","poem":1},{"text":"O'nun için hileyle mi konuşacaksınız?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O'nun tarafını mı tutuyorsunuz?","poem":1},{"text":"Tanrı için mi çekişiyorsunuz?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sizi yoklarsa iyi mi?","poem":1},{"text":"Ya da O'nu da insan aldatır gibi aldatacak mısınız?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gizlice taraf tutarsanız,","poem":1},{"text":"sizi mutlaka azarlayacaktır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O'nun yüceliği sizi korkutmayacak mı,","poem":1},{"text":"dehşeti üzerinize düşmeyecek mi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akılda kalan sözleriniz küllerden özdeyişlerdir.","poem":1},{"text":"Savunmalarınız kilden savunmalardır.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Susun! Beni yalnız bırakın da konuşayım.","poem":1},{"text":"Başıma ne gelirse gelsin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neden etimi dişlerimin arasına alayım,","poem":1},{"text":"hayatımı avucumun içine koyayım?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte, O beni öldürecek. Umudum yok.","poem":1},{"text":"Yine de O'nun önünde yollarımı koruyacağım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bu da benim kurtuluşum olacak,","poem":1},{"text":"tanrısız bir adam O'nun önüne gelmeyecektir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sözümü dikkatle dinleyin.","poem":1},{"text":"Bildirim kulağınızda olsun.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İşte, davamı sıraladım.","poem":1},{"text":"Doğru olduğumu biliyorum.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Benimle çekişecek olan kimdir?","poem":1},{"text":"Çünkü o zaman susar ve ruhumu teslim ederdim.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Yalnız iki şeyi bana yapma,","poem":1},{"text":"o zaman kendimi senden saklamayacağım:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Elini benden uzaklaştır,","poem":1},{"text":"dehşetin beni korkutmasın.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"O zaman çağır da, ben yanıt vereyim,","poem":1},{"text":"ya da ben konuşayım da, sen bana yanıt ver.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Günahlarım ve suçlarım ne kadar çok?","poem":1},{"text":"Bana itaatsizliğimi ve günahımı bildir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neden yüzünü gizliyorsun,","poem":1},{"text":"beni düşmanın sayıyorsun?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sürülmüş bir yaprağa saldıracak mısın?","poem":1},{"text":"Kuru anızı kovalayacak mısın?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Çünkü bana karşı acı şeyler yazıyorsun,","poem":1},{"text":"bana miras olarak gençliğimin suçlarını veriyorsun.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ayaklarımı da tomruğa vuruyorsun,","poem":1},{"text":"bütün yollarımı işaretliyorsun.","poem":2},{"lineBreak":true},{"text":"Ayaklarımın tabanlarına bağ koydun,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ben ise çürümüş bir şey gibi bozulmaktayım,","poem":1},{"text":"güve yemiş bir giysi gibi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}