{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“İnsan, kadından doğar,","poem":1},{"text":"günleri azdır ve sıkıntı doludur.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çiçek gibi büyür ve kesilir.","poem":1},{"text":"Gölge gibi de kaçar ve durmaz.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gözlerini böyle birine mi açıyorsun,","poem":1},{"text":"ve beni kendinle yargı içine çekiyorsun?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kim kirli bir şeyden temiz bir şey çıkarabilir?","poem":1},{"text":"Hiç kimse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mademki onun günleri belirlenmiş,","poem":1},{"text":"aylarının sayısı senin yanındadır,","poem":2},{"lineBreak":true},{"text":"onun sınırlarını da sen koydun ve öteye geçemez.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ondan gözünü çevir de,","poem":1},{"text":"gününü doldurana dek dinlensin, ücretli bir işçi gibi.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Çünkü kesilen bir ağaç için umut vardır,","poem":1},{"text":"yeniden filizlenir, taze dalı tükenmez.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kökü toprakta yaşlansa,","poem":1},{"text":"gövdesi toprakta ölse bile,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yine de suyun kokusuyla filizlenir,","poem":1},{"text":"ve bir fidan gibi dallar verir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama insan ölür ve indirilir.","poem":1},{"text":"Evet, insan ruhunu teslim eder, hani, o nerede?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Denizden sular nasıl çekilir,","poem":1},{"text":"ırmak nasıl kurur ve tükenirse,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İnsan da öyle yatar ve kalkmaz.","poem":1},{"text":"Gökler yok oluncaya dek uyanmazlar,","poem":2},{"lineBreak":true},{"text":"ve uykularından uyandırılmazlar.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Keşke beni Şeol'e","poem":1},{"noteId":6},{"text":"saklasan,","poem":1},{"text":"gazabın geçinceye dek beni gizli tutsan,","poem":2},{"lineBreak":true},{"text":"bana belli bir zaman versen de beni ansan!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İnsan ölürse, yeniden dirilir mi?","poem":1},{"text":"Kurtuluşum gelinceye dek,","poem":2},{"lineBreak":true},{"text":"Savaş günlerimin hepsini beklerdim,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"sen çağırırdın, ben de sana yanıt verirdim.","poem":1},{"text":"Ellerinin işini isterdin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ama şimdi adımlarımı sayıyorsun.","poem":1},{"text":"Günahımı gözetmiyor musun?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"İtaatsizliğim bir torbaya mühürlendi.","poem":1},{"text":"Suçumu bağladın.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Ama düşen dağ yok olur.","poem":1},{"text":"Kaya yerinden kaldırılır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sular taşları aşındırır.","poem":1},{"text":"Selleri yeryüzünün toprağını yıkayıp götürür.","poem":2},{"lineBreak":true},{"text":"Böylece insanın umudunu yok edersin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ona daima üstün gelirsin ve o ayrılır.","poem":1},{"text":"Yüzünü değiştirip onu gönderirsin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Oğullarına saygınlık gelir ve o bunu bilmez.","poem":1},{"text":"Alçalırlar, ama onların durumunu anlamaz.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ama kendi bedeni üzerinde acı çeker,","poem":1},{"text":"kendi canı da içinde yas tutar.”","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":14,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}