{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Temanlı Elifaz şöyle karşılık verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Bilge biri boş bilgiyle yanıt vermeli,","poem":1},{"text":"ve kendini doğu rüzgârıyla doyurmalı mı?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İnsan yararsız konuşmalarla","poem":1},{"text":"ya da kendisine hiçbir faydası olmayan sözlerle tartışır mı?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Evet, korkuyu ortadan kaldırır,","poem":1},{"text":"Tanrı önünde de bağlılığı engellersin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü kötülüğün ağzını eğitiyor,","poem":1},{"text":"ve kurnazların dilini seçiyorsun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kendi ağzın seni mahkûm ediyor, ben değil.","poem":1},{"text":"Evet, dudakların sana karşı tanıklık ediyor.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Sen doğan ilk insan mısın?","poem":1},{"text":"Yoksa dağlardan önce mi çıkarıldın?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tanrı'nın gizli öğüdünü duydun mu?","poem":1},{"text":"Bilgeliği kendine mi saklıyorsun?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bizim bilmeyip de senin bildiğin nedir?","poem":1},{"text":"Bizde olmayıp da senin anladığın nedir?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bizde ak saçlı da, çok yaşlı adam da, var,","poem":1},{"text":"senin babandan da çok yaşlı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrı'nın tesellileri,","poem":1},{"text":"sana karşı olan yumuşak sözü","poem":2},{"lineBreak":true},{"text":"sana çok mu küçüktür?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yüreğin seni neden sürüklüyor?","poem":1},{"text":"Gözlerin neden şimşek çakıyor da,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ruhunu Tanrı'ya karşı döndürüyorsun,","poem":1},{"text":"ve ağzından böyle sözler çıkarıyorsun?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İnsan nedir ki, temiz olsun?","poem":1},{"text":"Kadından doğan kişi nedir ki, doğru olsun?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte, Tanrı kutsallarına güvenmiyor.","poem":1},{"text":"Gökler bile O'nun gözünde temiz değil;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nerede kaldı ki, iğrenç ve bozulmuş insan,","poem":1},{"text":"o insan ki, haksızlığı su gibi içmektedir!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Sana göstereyim, beni dinle;","poem":1},{"text":"gördüğümü bildireyim","poem":2}]},{"type":"verse","number":18,"content":[{"text":"(Atalarından aldıklarını bilge kişiler anlattılar","poem":1},{"text":"ve saklamadılar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yalnız onlara ülke verildi","poem":1},{"text":"ve aralarında yabancı geçmedi.)","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kötü adam bütün günleri boyunca acı içinde kıvranır,","poem":1},{"text":"zalim için yığılmış olan yıllar sayılıdır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kulaklarında dehşet sesleri vardır.","poem":1},{"text":"Bollukta yıkıcı onun üzerine gelir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Karanlıktan döneceğine inanmaz.","poem":1},{"text":"Kılıç onu beklemektedir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ekmek için dolaşıp, 'Nerede?' der.","poem":1},{"text":"Karanlık gününün yakınında, hazır olduğunu bilir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sıkıntı ve acı onu korkutur.","poem":1},{"text":"Savaşa hazır bir kral gibi ona üstün gelirler.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Çünkü Tanrı'ya karşı elini uzattı,","poem":1},{"text":"ve Yüce Olan'a karşı gururla davrandı,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"O'na karşı sert ense ile koşmaktadır;","poem":1},{"text":"kalın yumrulu kalkanıyla,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çünkü yüzünü şişmanlığıyla örttü,","poem":1},{"text":"beli üzerinde de yağ biriktirdi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Issız kentlerde,","poem":1},{"text":"yığın olmaya hazır, kimsenin oturmadığı evlerde yaşadı.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Zengin olmayacak, ve malı durmayacak,","poem":1},{"text":"malları da yeryüzünde genişlemeyecektir.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Karanlıktan ayrılmayacak.","poem":1},{"text":"Alev dallarını kurutacak.","poem":2},{"lineBreak":true},{"text":"Tanrı'nın ağzının soluğuyla gidecektir.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Boşluğa güvenip kendini aldatmasın,","poem":1},{"text":"çünkü boşluk onun ödülü olacak.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Zamanından önce tamam olacak.","poem":1},{"text":"Dalı yeşermeyecek.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Olgunlaşmamış üzümünü asma gibi silkeleyecek,","poem":1},{"text":"çiçeğini de zeytin ağacı gibi atacaktır.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Çünkü tanrısızların topluluğu kısır olacak,","poem":1},{"text":"ve ateş rüşvet çadırlarını yakıp yok edecek.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kötülüğe gebe kalırlar ve kötülük doğururlar.","poem":1},{"text":"Yürekleri hile hazırlar.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}