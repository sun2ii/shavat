{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["İyov şöyle yanıt verdi,"]},{"type":"verse","number":2,"content":[{"text":"“Böyle birçok şey duydum.","poem":1},{"text":"Hepiniz zavallı tesellicilersiniz!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Boş sözlerin sonu gelecek mi?","poem":1},{"text":"Ya da seni ne kışkırtıyor da yanıt veriyorsun?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ben de sizin gibi konuşabilirdim.","poem":1},{"text":"Canınız benim canımın yerinde olsaydı,","poem":2},{"lineBreak":true},{"text":"size karşı sözleri bir araya getirir,","poem":2},{"lineBreak":true},{"text":"size başımı sallardım,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama ağzımla sizi güçlendirirdim.","poem":1},{"text":"Dudaklarımın tesellisi sizi rahatlatırdı.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Konuşsam da, kederim dinmiyor.","poem":1},{"text":"Sussam da, ne rahatlarım ki?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama şimdi, Tanrım, beni gerçekten yıprattın.","poem":1},{"text":"Bütün topluluğumu sen ıssız ettin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Beni sıkıp buruşturdun. Bana karşı bu tanıktır.","poem":1},{"text":"Zayıflığım bana karşı kalkıyor.","poem":2},{"lineBreak":true},{"text":"Yüzüme karşı tanıklık ediyor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gazabıyla beni parçaladı ve bana zulmetti.","poem":1},{"text":"Üzerime dişlerini gıcırdattı.","poem":2},{"lineBreak":true},{"text":"Hasmım gözlerini benim üzerime bilemektedir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Üzerime ağızlarını açtılar.","poem":1},{"text":"Hakaretle yanağıma vurdular.","poem":2},{"lineBreak":true},{"text":"Bana karşı bir araya toplandılar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrı beni tanrısızların eline teslim ediyor,","poem":1},{"text":"kötülerin eline atıyor.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rahattım, beni O parçaladı.","poem":1},{"text":"Evet, boynumdan tuttu ve beni yıktı.","poem":2},{"lineBreak":true},{"text":"Beni kendisine hedef olarak da dikti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onun okçuları beni sarıyor.","poem":1},{"text":"Esirgemeden böbreklerimi yarıyor.","poem":2},{"lineBreak":true},{"text":"Ödümü yere döküyor.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bedenimde gedik üstüne gedik açıyor.","poem":1},{"text":"Bir dev gibi bana saldırıyor.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Derim üzerine çul diktim,","poem":1},{"text":"boynuzumu toprağa sapladım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ağlamaktan yüzüm kızardı.","poem":1},{"text":"Derin karanlık göz kapaklarımın üzerindedir,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ellerimde zorbalık yokken,","poem":1},{"text":"duam da pak olduğu halde.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Ey toprak, kanımı örtme.","poem":1},{"text":"Feryadımın dinlenecek yeri olmasın.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Şimdi bile, işte, tanığım göklerdedir.","poem":1},{"text":"Bana kefil olan yücelerdedir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dostlarım benimle alay ediyor.","poem":1},{"text":"Gözlerim Tanrı'ya gözyaşı döküyor,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tanrı kendisiyle insan arasında,","poem":1},{"text":"insanoğluyla komşusu arasında hak arasın diye!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü birkaç yıl geçince,","poem":1},{"text":"geri dönüşü olmayan yola gireceğim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}