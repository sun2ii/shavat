{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"“Ruhum tükendi.","poem":1},{"text":"Günlerim söndü","poem":2},{"lineBreak":true},{"text":"mezar benim için hazırdır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gerçekten alay edenler yanımdadır.","poem":1},{"text":"Gözüm onların kışkırtmaları üzerinde hayat sürüyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Şimdi rehin ver.”","poem":1},{"text":"Kendinle bana kefil ol.","poem":2},{"lineBreak":true},{"text":"Benimle el tutuşacak kim var?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü onların yüreğini anlayışa kapadın,","poem":1},{"text":"bu yüzden onları yükseltmeyeceksin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dostlarını yağma için ihbar edenin","poem":1},{"text":"çocuklarının gözleri bile söner.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ama beni halka alay konusu etti.","poem":1},{"text":"Yüzüme tükürüyorlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gözlerim de üzüntüden karardı. Bütün azalarım gölge gibi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Doğru adamlar buna şaşacak.","poem":1},{"text":"Suçsuz, tanrısızlara karşı kendini kışkırtacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ama doğru adam yolunu tutacak.","poem":1},{"text":"Elleri temiz olan, giderek güçlenecek.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama siz hepiniz, geri gelin.","poem":1},{"text":"Aranızda bilge bir adam bulmayacağım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Günlerim geçti.","poem":1},{"text":"Tasarılarım ve yüreğimin düşünceleri bozuldu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Karanlığın önünde, 'Işık yakındır' diyerek","poem":1},{"text":"geceyi gündüz yerine koyuyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Eğer evim olarak Şeol'ü","poem":1},{"noteId":7},{"text":"arıyorsam,","poem":1},{"text":"yatağımı karanlığa serdimse,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çöküşe, 'Sen babamsın',","poem":1},{"text":"kurda, 'Annem' ve 'Kız kardeşim' dedimse,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O zaman umudum nerede?","poem":1},{"text":"Umudumu, onu kim görecek?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Benimle birlikte o Şeol'ün","poem":1},{"noteId":8},{"text":"kapılarına inecek mi,","poem":1},{"text":"yoksa birlikte toprağa mı ineceğiz?”","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":17,"verse":13}},{"noteId":8,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":17,"verse":16}}]},"thisChapterLink":"/api/tur_ytc/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}