{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["O zaman Şuahlı Bildad şöyle yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Ne zamana kadar söz avcılığı edeceksiniz?","poem":1},{"text":"Düşünün de sonra konuşalım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neden hayvanlar gibi sayılıyoruz,","poem":1},{"text":"gözünüzde murdar olduk?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey öfkenle kendini parçalayan sen,","poem":1},{"text":"yeryüzü senin için terk mi edilecek?","poem":2},{"lineBreak":true},{"text":"Ya da kaya yerinden mi kaldırılacak?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Evet, kötülerin ışığı sönecek.","poem":1},{"text":"Ateşinin kıvılcımı parlamayacaktır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çadırındaki ışık karanlık olacak.","poem":1},{"text":"Üzerindeki kandili sönecektir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gücünün adımları kısalacak.","poem":1},{"text":"Kendi öğüdü onu yere serecektir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü kendi ayaklarıyla ağa atıldı,","poem":1},{"text":"ağın içinde dolaşıyor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tuzak onu topuğundan tutacak.","poem":1},{"text":"Kapan onu yakalayacak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yerde onun için saklı bir ilmik,","poem":1},{"text":"yolun üzerinde onun için kapan vardır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Her yandan dehşet onu korkutacak,","poem":1},{"text":"topukları ardınca onu kovalayacaklar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gücünü açlık bitirecek.","poem":1},{"text":"Felaket onun yanında hazır bulunacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bedeninin azaları yutulacak.","poem":1},{"text":"Ölümün ilk doğanı onun azalarını yutacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Güvendiği çadırından sökülüp atılacak.","poem":1},{"text":"Dehşet kralına götürülecek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Çadırında kendisinden olmayanlar oturacak.","poem":1},{"text":"Oturduğu yere kükürt saçılacak.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kökleri dipten kuruyacak.","poem":1},{"text":"Dalı yukarıdan kesilecek.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hatırası yeryüzünden silinecek.","poem":1},{"text":"Sokakta adı olmayacak.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Işıktan karanlığa sürülecek","poem":1},{"text":"ve dünyadan kovulacak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Halkının arasında ne oğlu ne de torunu olacak,","poem":1},{"text":"yaşadığı yerde de geride kalanı olmayacak.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Arkadan gelenler, öncekilerin korktuğu gibi,","poem":1},{"text":"onun gününe şaşacaklar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gerçekten de doğru olmayanların meskenleri böyledir.","poem":1},{"text":"Tanrı'yı bilmeyenin yeri burasıdır.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}