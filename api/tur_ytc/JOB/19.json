{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["İyov şöyle karşılık verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Ne zamana dek bana eziyet edeceksin,","poem":1},{"text":"beni sözlerle ezeceksiniz?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"On kezdir beni azarladınız.","poem":1},{"text":"Bana saldırmaktan utanmıyorsunuz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eğer gerçekten sapmışsam,","poem":1},{"text":"sapmışlığım bende kalır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gerçekten bana karşı kendinizi yüceltiyorsanız,","poem":1},{"text":"ve bana karşı utancımı öne sürüyorsanız,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"şimdi bilin ki, Tanrı beni devirdi,","poem":1},{"text":"ve beni ağıyla kuşattı.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“İşte, haksızlık diye feryat ediyorum, ama duyulmuyorum.","poem":1},{"text":"Yardım diye bağırıyorum, ama adalet yok.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Geçmeyeyim diye yoluma duvar çevirdi,","poem":1},{"text":"yollarıma karanlık koydu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Görkemimi üzerimden soydu,","poem":1},{"text":"ve başımın tacını aldı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Her yandan beni kırdı, ve yok oldum.","poem":1},{"text":"Umudumu bir ağaç gibi söktü.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bana karşı gazabını alevlendirdi.","poem":1},{"text":"Beni hasımları arasında sayıyor.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Askerleri bir araya gelip bana karşı bir kuşatma rampası kuruyor,","poem":1},{"text":"ve çadırımın etrafında ordugâh kuruyorlar.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Kardeşlerimi benden uzaklaştırdı.","poem":1},{"text":"Tanıdıklarım bana tamamen yabancılaştılar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akrabalarım gitti.","poem":1},{"text":"Yakın dostlarım beni unuttu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Evimde oturanlar ve hizmetçi kızlarım beni yabancı sayıyor.","poem":1},{"text":"Onların gözünde bir yabancı oldum.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hizmetçimi çağırıyorum, bana yanıt vermiyor.","poem":1},{"text":"Ağzımla yalvarıyorum.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Soluğum karıma iğrenç geliyor.","poem":1},{"text":"Kendi annemin çocuklarına iğrenç oldum.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Küçük çocuklar bile beni hor görüyor.","poem":1},{"text":"Ayağa kalktığımda bana karşı konuşuyorlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bütün yakın dostlarım benden iğreniyor.","poem":1},{"text":"Sevdiklerim benden yüz çevirdiler.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kemiklerim derimle ve etime yapışıyor.","poem":1},{"text":"Dişlerimin derisinden kaçıp kurtuldum.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Bana acıyın. Ey dostlarım, bana acıyın,","poem":1},{"text":"Çünkü Tanrı'nın eli bana dokundu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neden Tanrı gibi siz de bana zulüm ediyorsunuz,","poem":1},{"text":"ve etime doymuyorsunuz?”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Keşke sözlerim şimdi yazılmış olsaydı!","poem":1},{"text":"Keşke bir kitaba kaydolmuş olsalardı!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Demir kalem ve kurşunla","poem":1},{"text":"sonsuza dek kayaya kazınmış olsalardı!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ama bense biliyorum ki,","poem":1},{"text":"Kurtarıcım diridir.","poem":2},{"lineBreak":true},{"text":"Sonunda yerin üzerinde dikilecektir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Derim yok olduktan sonra,","poem":1},{"text":"o zaman Tanrı'yı bedenimde göreceğim,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ben, ben, O'nu yanımda göreceğim.","poem":1},{"text":"Gözlerim görecek, ve bir yabancı gibi değil.”","poem":2},{"text":"“Yüreğim içimde tükeniyor.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Eğer siz, 'Ona nasıl zulmedeceğiz!' derseniz,","poem":1},{"text":"çünkü meselenin kökü bende bulunuyor,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"kılıçtan korkun,","poem":1},{"text":"Çünkü gazap kılıcın cezalarını getirir,","poem":2},{"lineBreak":true},{"text":"ta ki, bir yargı olduğunu bilesiniz.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}