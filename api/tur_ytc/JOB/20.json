{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["O zaman Naamalı Sofar şöyle yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Bu yüzden düşüncelerim bana yanıt veriyor,","poem":1},{"text":"bu nedenle içimde telaş var.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Beni utandıran azarlamayı duydum.","poem":1},{"text":"Anlayışımın ruhu bana yanıt veriyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İnsan yeryüzüne yerleştirildiğinden beri,","poem":1},{"text":"eski zamandan beri bunu bilmiyor musun?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötülerin zaferi kısadır,","poem":1},{"text":"tanrısızların sevinci ise bir anlıktır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onun boyu göklere,","poem":1},{"text":"başı bulutlara ulaşsa bile,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kendi pisliği gibi sonsuza dek yok olacak.","poem":1},{"text":"Onu görmüş olanlar, ‘Nerede o?’ diyecek.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bir düş gibi uçup gidecek ve o bulunmayacak.","poem":1},{"text":"Evet, bir gece görümü gibi kovalanacaktır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onu görmüş olan göz bir daha onu görmeyecek,","poem":1},{"text":"yeri de artık onu görmeyecek.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çocukları yoksulların lütfunu arayacak.","poem":1},{"text":"Onun elleri kendi servetini geri verecek.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kemikleri gençliğiyle dolu,","poem":1},{"text":"ama gençlik onunla birlikte toprakta yatacak.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Kötülük ağzında tatlı olsa da,","poem":1},{"text":"dilinin altında onu saklasa da,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"onu esirgese, bırakmasa da,","poem":1},{"text":"ama ağzının içinde hâlâ saklasa da,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"yine de bağırsaklarındaki yiyecek değişir.","poem":1},{"text":"Onun içindeki kobra zehiridir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zenginlikler yuttu,","poem":1},{"text":"ve onları tekrar kusacak.","poem":2},{"lineBreak":true},{"text":"Tanrı onları karnından dışarı atacak.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kobra zehiri emecek.","poem":1},{"text":"Engereğin dili onu öldürecek.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Irmaklara,","poem":1},{"text":"akan bal ve tereyağına bakmayacak.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Emek verdiği şeyi geri verecek ve yutmayacak.","poem":1},{"text":"Ele geçirdiği mallara göre sevinmeyecek.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Çünkü yoksulları ezdi ve bıraktı.","poem":1},{"text":"Evi zorla çekip aldı ve onu bina etmeyecek.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Mademki içinde sakinliği bilmedi,","poem":1},{"text":"zevk aldığı şeylerden hiçbirini kurtarmayacaktır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Geride yutmadığı hiçbir şey kalmadı,","poem":1},{"text":"bu yüzden bolluğu uzun sürmeyecek.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bolluğunun yeterliliği içinde sıkıntı onu yakalayacak.","poem":1},{"text":"Sefalet içinde olan herkesin eli onun üzerine gelecek.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Karnını doyurmak üzereyken,","poem":1},{"text":"Tanrı gazabının kızgınlığını onun üzerine atacak.","poem":2},{"lineBreak":true},{"text":"Yemek yerken üzerine onu yağdıracak.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Demir silahtan kaçacak.","poem":1},{"text":"Tunç ok onu delecek.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Onu çekip çıkarır, o da bedeninden çıkar.","poem":1},{"text":"Evet, parıldayan ucu ciğerinden çıkar.","poem":2},{"lineBreak":true},{"text":"Dehşet onun üzerindedir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Onun hazineleri için her tür karanlık toplanmıştır.","poem":1},{"text":"Körüklenmemiş bir ateş onu yiyip bitirecektir.","poem":2},{"lineBreak":true},{"text":"Çadırında geride kalanları tüketecektir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Gökler onun suçunu açığa vuracaktır.","poem":1},{"text":"Yeryüzü ona karşı ayaklanacaktır.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Evinin ürünü gidecektir.","poem":1},{"text":"Onlar gazabının gününde hızla akıp gidecektir.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bu, kötü adamın Tanrı'dan payıdır,","poem":1},{"text":"Tanrı tarafından kendisine atanan mirastır.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}