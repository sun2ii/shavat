{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["İyov şöyle karşılık verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Sözümü dikkatle dinleyin.","poem":1},{"text":"Sizin teselliniz bu olsun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bırakın, ben de konuşayım.","poem":1},{"text":"Ben konuştuktan sonra alay edin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Benim yakınmam insana mı?","poem":1},{"text":"Neden sabırsızlanmayayım?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bana bakın da şaşın.","poem":1},{"text":"Elinizi ağzınıza koyun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hatırladıkça, sıkıntıya düşerim.","poem":1},{"text":"Dehşet bedenimi ele geçiriyor.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Kötüler neden yaşıyor,","poem":1},{"text":"yaşlanıyor, evet, güçleri artıyor?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çocukları kendileriyle birlikte onların önlerinde,","poem":1},{"text":"yavruları gözlerinin önünde pekişiyor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Evleri korkudan yana, güvenlik içindedir,","poem":1},{"text":"Tanrı'nın sopası da üzerlerinde değildir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Boğaları çiftleşir ve hiç boşa gitmez,","poem":1},{"text":"inekleri buzağılar ve düşük yapmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yavrularını sürü gibi salarlar.","poem":1},{"text":"Çocukları oynar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tef ve çenk eşliğinde ezgi söyler,","poem":1},{"text":"kaval sesine sevinirler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Günlerini bolluk içinde geçirirler. Bir anda Şeol'e","poem":1},{"noteId":9},{"text":"inerler.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tanrı'ya, 'Bizden uzak dur,","poem":1},{"text":"çünkü yollarını bilmek istemiyoruz' derler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Her Şeye Gücü Yeten nedir ki, O'na hizmet edelim?","poem":1},{"text":"O'na dua edersek ne kazancımız olur?'","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İşte, onların başarısı kendi ellerinde değildir.","poem":1},{"text":"Kötülerin öğüdü benden uzak olsun.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Kötülerin kandili kaç kez söndü,","poem":1},{"text":"felaketleri başlarına geldi,","poem":2},{"lineBreak":true},{"text":"Tanrı öfkesinde onlara pay olarak keder vermiştir?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kaç kez rüzgârın önündeki anız gibi,","poem":1},{"text":"fırtınanın savurduğu saman çöpü gibi olmuşlardır?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Siz, ‘Tanrı suçunu çocukları için saklıyor’ diyorsunuz.","poem":1},{"text":"Bunu kendisi ödesin ki, bilsin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kendi gözleri yıkımını görsün.","poem":1},{"text":"Her Şeye Gücü Yeten’in gazabından içsin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü aylarının sayısı kesilince,","poem":1},{"text":"kendisinden sonra evi için ne kaygısı olur?”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Kimse Tanrı’ya bilgi öğretebilir mi?","poem":1},{"text":"Çünkü yüksektekilere O hükmeder.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Birisi tam gücünde ölür,","poem":1},{"text":"tümüyle rahat ve sakindir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kovaları sütle doludur.","poem":1},{"text":"Kemiklerinin iliği canlıdır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Birisi can acılığı içinde ölür,","poem":1},{"text":"ve hiç iyilik tatmamıştır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Toprakta aynı şekilde yatarlar.","poem":1},{"text":"Onları kurt kaplar.”","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“İşte, düşüncelerinizi,","poem":1},{"text":"onlarla bana kötülük yapmak istediğiniz tasarıları biliyorum.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Çünkü diyorsunuz ki, ‘Beyin evi nerede?","poem":1},{"text":"Kötülerin yaşadığı çadır nerede?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yoldan geçenlere sormadın mı?","poem":1},{"text":"Onların kanıtlarını bilmiyor musun?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kötü adam felaket gününe kadar saklıdır,","poem":1},{"text":"gazap gününde onlara yol gösterilir.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kim kendi yolunu onun yüzüne bildirecek?","poem":1},{"text":"Kim ona yaptıklarını ödeyecek?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ancak o mezara götürülecek.","poem":1},{"text":"Mezarın başında bekçilik edecekler.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Vadinin toprakları ona tatlı gelecek.","poem":1},{"text":"Ondan önce sayısız olanlar gibi,","poem":2},{"lineBreak":true},{"text":"bütün insanlar onun ardınca sürüklenecek.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Öyleyse beni saçmalıklarla nasıl teselli edebilirsiniz,","poem":1},{"text":"çünkü sizin yanıtlarınızdan geriye kalan yalnızca yalandır?”","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":21,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}