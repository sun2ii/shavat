{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["Temanlı Elifaz şöyle yanıt verdi,"]},{"type":"verse","number":2,"content":[{"text":"“İnsan Tanrı'ya yararlı olabilir mi?","poem":1},{"text":"Elbette bilge olanın yararı kendisinedir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senin doğru olman Yüce Tanrı'ya zevk verir mi?","poem":1},{"text":"Ya da kendi yollarını kusursuzlaştırman O'na yarar sağlar mı?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seni azarlaması, seninle yargıya girmesi,","poem":1},{"text":"O'na olan saygından ötürü mü?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötülüğün büyük değil mi?","poem":1},{"text":"Ve suçlarının sonu yok.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü kardeşinden boşuna rehin aldın,","poem":1},{"text":"çıplakları da giysilerinden soydun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yorguna su vermedin,","poem":1},{"text":"açtan da ekmeği esirgedin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama güçlü adama gelince, toprak onun oldu.","poem":1},{"text":"Onurlu adam orada yaşadı.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dulları eli boş gönderdin,","poem":1},{"text":"yetimlerin de kolları kırıldı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bu yüzden tuzaklar çevrendedir.","poem":1},{"text":"Ansızın gelen korku seni sıkıntıya sokar,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ya da karanlık, öyle ki sen göremezsin,","poem":1},{"text":"Ve sel suları seni örter.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Tanrı göğün yükseklerinde değil midir?","poem":1},{"text":"Yıldızların yüksekliğine bak, ne kadar yüksektirler!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sen diyorsun ki: 'Tanrı ne bilir?","poem":1},{"text":"Koyu karanlığın içinden hükmedebilir mi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Koyu bulutlar ona bir örtüdür, öyle ki göremez.","poem":1},{"text":"Gökyüzü kubbesi üzerinde yürür.'","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kötülerin yürümüş olduğu","poem":1},{"text":"eski yolu mu tutacaksın?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zamanlarından önce kapıp götürülenler,","poem":1},{"text":"temeline ırmak dökülenler,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanrı'ya, ‘Bizden uzak dur!’","poem":1},{"text":"Ve, ‘Her Şeye Gücü Yeten bizim için ne yapabilir?’ diyenler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ancak evlerini iyilikle dolduran O'dur,","poem":1},{"text":"ama kötülerin öğüdü benden uzak olsun.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Doğrular bunu görüp sevinirler.","poem":1},{"text":"Masumlar onlarla alay ederler,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Gerçekten bize karşı ayaklananlar kesilip atıldılar.","poem":1},{"text":"Ateş onların kalıntılarını yakıp yok etti.' derler.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Şimdi O'nunla tanış da esenliğe kavuş.","poem":1},{"text":"Bununla sana iyilik gelir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lütfen O'nun ağzından öğretiyi al,","poem":1},{"text":"ve O'nun sözlerini yüreğinde biriktir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Eğer Yüce Olan'a dönerseniz,","poem":1},{"text":"çadırlarınızdan kötülüğü uzaklaştırırsanız,","poem":2},{"lineBreak":true},{"text":"bina edilirsiniz.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hazinenizi toprağa,","poem":1},{"text":"Ofir'in altını dere taşlarının arasına koyun.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yüce Olan senin hazinen,","poem":1},{"text":"ve sana değerli gümüş olur.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Çünkü o zaman Yüce Olan'da sevinç bulursun,","poem":1},{"text":"ve yüzünü Tanrı'ya kaldırırsın.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"O'na dua edersin ve seni işitir.","poem":1},{"text":"Kendi adaklarını ödersin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Üstelik sen bir şeye karar verirsin, o da sana yapılır.","poem":1},{"text":"Işık senin yollarının üzerinde parlar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Onlar aşağı attıklarında, sen, ‘kalk’ diyeceksin.","poem":1},{"text":"O, alçakgönüllü kişiyi kurtarır.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Suçsuz olmayanı bile kurtarır.","poem":1},{"text":"Evet, senin ellerinin temizliğiyle kurtulur.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}