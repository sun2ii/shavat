{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["O zaman İyov şöyle karşılık verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Bugün bile yakınmam isyankârdır.","poem":1},{"text":"İnlememe rağmen O'nun eli ağırdır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Keşke O'nu nerede bulabileceğimi bilseydim!","poem":1},{"text":"Tahtına kadar varabilseydim!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Davamı O'nun önünde sıraya koyar,","poem":1},{"text":"ağzımı delillerle doldururdum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bana yanıt vereceği sözleri bilir,","poem":1},{"text":"bana ne söyleyeceğini anlardım.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gücünün büyüklüğünde benimle çekişir miydi?","poem":1},{"text":"Hayır, ama O beni dinlerdi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Orada doğru kişi O'nunla davacı olabilirdi,","poem":1},{"text":"böylece Yargıcım'dan sonsuza dek kurtulurdum.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Doğuya gitsem, orada değildir.","poem":1},{"text":"Batıya gitsem, O'nu bulamam.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuzeye doğru çalışır, ama O'nu göremem.","poem":1},{"text":"Güney'e döner, ama O'nu bir an bile göremem.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama O benim tuttuğum yolu bilir.","poem":1},{"text":"Beni denediğinde, altın gibi çıkacağım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O'nun adımlarını ayağım sıkı tuttu.","poem":1},{"text":"Ben O'nun yolunu tuttum ve sapmadım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dudaklarının buyruğundan geri dönmedim.","poem":1},{"text":"Ağzının sözlerine günlük yiyeceğimden daha çok değer verdim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ama O tek başına duruyor ve O'na kim karşı koyabilir?","poem":1},{"text":"Canı ne isterse onu yapar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü benim için kararlaştırılmış olanı yapar.","poem":1},{"text":"O'nun yanında bunların niceleri vardır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bu yüzden O'nun önünde dehşete düşerim.","poem":1},{"text":"Düşündüğümde O'ndan korkarım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü Tanrı yüreğimi ürküttü.","poem":1},{"text":"Her Şeye Gücü Yeten beni dehşete düşürdü.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü karanlığın önünde kesilip atılmadım,","poem":1},{"text":"ne de yüzüme karşı koyu karanlığı örtmedi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}