{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"“Neden zamanlar Yüce Tanrı tarafından toplanmaz?","poem":1},{"text":"Neden O’nu tanıyanlar O'nun günlerini görmezler?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sınırları yerlerinden kaldıran insanlar var.","poem":1},{"text":"Sürüleri zorla götürüp otlatıyorlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yetimin eşeğini kaçırıyorlar,","poem":1},{"text":"dul kadının öküzünü rehin alıyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yoksulları yoldan saptırıyorlar.","poem":1},{"text":"Yeryüzünün yoksulları hep saklanmaktalar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İşte, çöldeki yaban eşekleri gibi,","poem":1},{"text":"işlerine çıkıyorlar, gayretle yiyecek arıyorlar.","poem":2},{"lineBreak":true},{"text":"Bozkır onlara çocukları için ekmek verir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yemlerini tarladan biçerler,","poem":1},{"text":"kötülerin bağından kalanı devşirirler.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gece boyunca giysisiz, çıplak yatarlar,","poem":1},{"text":"soğukta örtüleri yok.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dağların sağanağından ıslanırlar,","poem":1},{"text":"barınacak yer olmadığı için kayaya sarılıyorlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yetimleri memeden çekip ayıran,","poem":1},{"text":"yoksullardan da rehin alanlar var.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çıplak, giysisiz dolaşıyorlar.","poem":1},{"text":"Açken demetleri taşıyorlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bu adamların duvarları arasında zeytin yağı yapıyorlar.","poem":1},{"text":"Şarap için üzüm çiğniyorlar ve susuzluk çekiyorlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kalabalık kentten insanlar inliyor.","poem":1},{"text":"Yaralıların canı feryat ediyor, ancak Tanrı deliliğe aldırmıyor.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Bunlar ışığa isyan edenlerdendir.","poem":1},{"text":"Onun yollarını bilmezler, patikalarında da kalmazlar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Katil ışıkla birlikte kalkar.","poem":1},{"text":"Yoksulu ve muhtacı öldürür.","poem":2},{"lineBreak":true},{"text":"Geceleyin hırsız gibidir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zina edenin gözü de alacakaranlığı bekler,","poem":1},{"text":"‘Hiçbir göz beni görmez’ der.","poem":2},{"lineBreak":true},{"text":"Yüzünü gizler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Karanlıkta evleri delerler.","poem":1},{"text":"Gündüzleri kendilerini kapatırlar.","poem":2},{"lineBreak":true},{"text":"Işığı bilmezler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü sabah onların hepsi için koyu karanlık gibidir,","poem":1},{"text":"çünkü koyu karanlığın dehşetlerini bilirler.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Onlar suların yüzeyindeki köpüktürler.","poem":1},{"text":"Yeryüzünde onların payı lanetlidir.","poem":2},{"lineBreak":true},{"text":"Bağlar yoluna yönelmezler.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuraklık ve sıcaklık kar sularını tüketir,","poem":1},{"text":"Şeol'de","poem":2},{"noteId":10},{"text":"günah işleyenleri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rahim onu unutacaktır.","poem":1},{"text":"Kurt ondan tatlı tatlı beslenecektir.","poem":2},{"lineBreak":true},{"text":"Artık hatırlanmayacak.","poem":2},{"lineBreak":true},{"text":"Haksızlık bir ağaç gibi kırılacaktır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doğurmayan kısırları yutar.","poem":1},{"text":"Dul kadına şefkat göstermez.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ancak Tanrı güçlüleri kudretiyle korur.","poem":1},{"text":"Yaşam güvencesi olmayanları ayağa kaldırır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tanrı onlara güvenlik verir ve orada dinlenirler.","poem":1},{"text":"O'nun gözleri onların yolları üzerindedir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yükselirler; ancak kısa bir süre sonra yok olurlar.","poem":1},{"text":"Evet, alçalırlar, tüm diğerleri gibi alınıp götürülürler,","poem":2},{"lineBreak":true},{"text":"ve başak başı gibi kesilirler.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Eğer şimdi böyle değilse, kim beni yalancı çıkarır,","poem":1},{"text":"ve sözlerimi değersiz kılar?”","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":24,"verse":19}}]},"thisChapterLink":"/api/tur_ytc/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}