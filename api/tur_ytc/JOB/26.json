{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["O zaman İyov şöyle yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Gücü olmayana nasıl yardım ettin!","poem":1},{"text":"Kuvveti olmayan kolu nasıl kurtardın!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bilgeliği olmayana nasıl öğüt verdin,","poem":1},{"text":"sağlam bilgiyi bol bol duyurdun!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kime sözler söyledin?","poem":1},{"text":"Senden çıkan ruh kimin?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Ayrılmış olan ruhlar titriyor,","poem":1},{"text":"suların altındakiler ve onlarda yaşayanların hepsi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tanrı önünde Şeol","poem":1},{"noteId":11},{"text":"çıplaktır,","poem":1},{"text":"Avadon","poem":2},{"noteId":12},{"text":"da örtüsüzdür.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Boşluğun üzerine kuzeyi yayar,","poem":1},{"text":"hiçliğin üzerine de dünyayı asar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Suları kalın bulutlarıyla sarar,","poem":1},{"text":"ve bulut onların altında patlamaz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tahtının yüzünü kapatır,","poem":1},{"text":"ve üzerine bulutunu yayar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Suların yüzeyinde bir sınır çizdi,","poem":1},{"text":"ışık ve karanlığın sınırlarına kadar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Göklerin direkleri titrer,","poem":1},{"text":"ve O azarlayınca şaşarlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kudretiyle denizi çalkalar,","poem":1},{"text":"ve anlayışıyla Rahav'ı vurur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O'nun Ruhu'yla gökler süslenir.","poem":1},{"text":"O'nun eli hızlı yılanı deldi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İşte, bunlar yalnızca O'nun yollarının kenarlarıdır.","poem":1},{"text":"O'nun hakkında duyduğumuz fısıltı ne kadar da küçük!","poem":2},{"lineBreak":true},{"text":"Ama O'nun kudretinin gürlemesini kim anlayabilir?”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":26,"verse":6}},{"noteId":12,"caller":"+","text":"Avadon, Yıkıcı anlamına gelir..","reference":{"chapter":26,"verse":6}}]},"thisChapterLink":"/api/tur_ytc/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}