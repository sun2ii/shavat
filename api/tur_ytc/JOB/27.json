{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["İyov yine kendi benzetmesine dönüp şöyle dedi:"]},{"type":"verse","number":2,"content":[{"text":"“Hakkımı elimden alan Tanrı'nın varlık hakkı için,","poem":1},{"text":"ve canıma acılık katan Her Şeye Gücü Yeten'in hakkı için,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"(Çünkü ömrümün uzunluğu hâlâ içimde,","poem":1},{"text":"Tanrı'nın Ruhu burnumdadır);","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gerçekten dudaklarım haksızlık söylemeyecek,","poem":1},{"text":"dilimden de yalan çıkmayacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sizi doğru saymak benden uzak olsun.","poem":1},{"text":"Ölene dek doğruluğumu kendimden ayırmayacağım.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğruluğuma sımsıkı tutunuyorum, onu bırakmayacağım.","poem":1},{"text":"Yaşadığım sürece yüreğim beni kınamayacak.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Düşmanım kötüler gibi olsun.","poem":1},{"text":"Bana karşı ayaklanan, haksızlar gibi olsun.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü tanrısızın umudu nedir, kesilip atıldığında,","poem":1},{"text":"Tanrı yaşamını aldığında?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Başına sıkıntı geldiğinde,","poem":1},{"text":"Tanrı onun feryadını duyar mı?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Her Şeye Gücü Yeten'de zevk bulur mu,","poem":1},{"text":"ve her zaman Tanrı'yı çağırır mı?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrı'nın eli hakkında size öğreteceğim.","poem":1},{"text":"Her Şeye Gücü Yeten'in yanında olanı gizlemeyeceğim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İşte, siz hepiniz kendiniz gördünüz;","poem":1},{"text":"öyleyse neden tamamen boş adamlar oldunuz?”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Bu, kötü adamın Tanrı'daki payıdır,","poem":1},{"text":"zalimlerin mirasıdır, ki bunu Her Şeye Gücü Yeten'den alırlar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çocukları çoğalırsa, kılıç içindir.","poem":1},{"text":"Soyundan gelenler ekmekle doymayacaklar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ondan geriye kalanlar ölüme gömülecek.","poem":1},{"text":"Dul kadınları ağıt yakmayacak.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gümüşünü toprak gibi yığsa,","poem":1},{"text":"giysiyi çamur gibi hazırlasa bile;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kendisi hazırlayabilir, ama doğru kişi onu giyer,","poem":1},{"text":"gümüşü suçsuz olan paylaşır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Evini güve gibi,","poem":1},{"text":"korucunun kurduğu çardak gibi yapar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zengin olarak yatar, ama bir daha öyle yapmaz.","poem":1},{"text":"Gözlerini açar ve yok olmuştur.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dehşetler onu sular gibi yakalar.","poem":1},{"text":"Bir fırtına onu geceleyin çalıp götürür.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doğu rüzgârı onu alıp götürür ve o gider.","poem":1},{"text":"Onu yerinden süpürür.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü onu savurur, ama esirgemez,","poem":1},{"text":"Elinden kaçmaya çalışırken.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İnsanlar ona el çırparlar,","poem":1},{"text":"ve kendi yerinden ona ıslık çalarlar.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}