{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"“Elbette gümüş için bir maden,","poem":1},{"text":"ve arıttıkları altın için bir yer vardır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Demir topraktan çıkarılır,","poem":1},{"text":"ve bakır cevherden eritilir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İnsan karanlığı sona erdirir,","poem":1},{"text":"ve en uzak sınıra kadar,","poem":2},{"lineBreak":true},{"text":"Bilinmezliğin ve koyu karanlığın taşlarını araştırır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İnsanların yaşadığı yerden uzakta bir kuyu açar.","poem":1},{"text":"İnsan ayağının unuttuğu yerlerde,","poem":2},{"lineBreak":true},{"text":"insanlardan uzakta asılırlar, ileri geri sallanırlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Toprağa gelince, ondan ekmek çıkar.","poem":1},{"text":"Altı ateşle sıvanmış gibidir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kayalarından safir çıkar.","poem":1},{"text":"Altın tozu ondadır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O yolu hiçbir yırtıcı kuş bilmez,","poem":1},{"text":"ve şahinin gözü onu görmemiştir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gururlu hayvanlar oraya ayak basmamıştır,","poem":1},{"text":"ve azgın aslan oradan geçmemiştir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Elini çakmak taşına koyar,","poem":1},{"text":"ve dağları kökünden devirir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kayalar arasında kanallar yarar.","poem":1},{"text":"O'nun gözü her değerli şeyi görür.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sızmasınlar diye akarsuları bağlar.","poem":1},{"text":"Gizli olanı aydınlığa çıkarır.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Ama bilgelik nerede bulunur?","poem":1},{"text":"Anlayışın yeri nerededir?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İnsan onun değerini bilmez,","poem":1},{"text":"ve yaşayanlar diyarında bulunmaz.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Derinlik, 'Benim içimde değil' der.","poem":1},{"text":"Deniz, 'Benim yanımda değil' der.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Altınla elde edilemez,","poem":1},{"text":"ve gümüş ona bedel olarak tartılamaz.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ofir altınıyla,","poem":1},{"text":"değerli akikle, safirle","poem":2},{"noteId":13},{"text":"değer biçilemez.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Altın ve cam ona denk olamaz,","poem":1},{"text":"saf altından mücevherlerle değiştirilemez.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mercan ya da kristalin adı anılmaz.","poem":1},{"text":"Evet, bilgeliğin bedeli yakutlardan üstündür.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Etiyopya topazı ona denk olmaz.","poem":1},{"text":"Saf altınla ona değer biçilemez.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Öyleyse bilgelik nereden gelir?","poem":1},{"text":"Anlayışın yeri nerededir?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü o, bütün canlıların gözünden saklanmıştır,","poem":1},{"text":"ve gökyüzünün kuşlarından gizli tutulmuştur.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yıkım ve Ölüm,","poem":1},{"text":"'Kulaklarımızla onun söylentisini duyduk' derler.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Onun yolunu anlayan,","poem":1},{"text":"ve yerini bilen Tanrı'dır.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çünkü yeryüzünün uçlarına kadar bakar,","poem":1},{"text":"ve bütün gökyüzünün altında olanı görür.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Rüzgârın kuvvetini belirler.","poem":1},{"text":"Evet, suları ölçüyle ölçer.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yağmur için yasa,","poem":1},{"text":"ve gök gürültüsünün şimşeği için yol yaptığında,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"O zaman onu gördü ve bildirdi.","poem":1},{"text":"Evet, onu pekiştirdi ve ortaya çıkardı.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"İnsana şöyle dedi, 'İşte, Efendi","poem":1},{"noteId":14},{"text":"korkusu, bilgelik budur.","poem":1},{"text":"Kötülükten uzaklaşmak anlayıştır.'”","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"veya lapis lazuli","reference":{"chapter":28,"verse":16}},{"noteId":14,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":28,"verse":28}}]},"thisChapterLink":"/api/tur_ytc/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}