{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["İyov yine kendi benzetmesine dönüp şöyle dedi:"]},{"type":"verse","number":2,"content":[{"text":"“Keşke, eski aylarda,","poem":1},{"text":"Tanrı'nın beni gözettiği günlerdeki gibi olsaydım;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kandili başıma vurduğu,","poem":1},{"text":"ışığıyla karanlıkta yürüdüğüm zamanda,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"en güzel günlerimdeki gibi,","poem":1},{"text":"Tanrı'nın dostluğu çadırımın üzerinde olduğu zamanda olsaydım,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Her Şeye Gücü Yeten hâlâ benimleydi,","poem":1},{"text":"çocuklarım da çevremdeydi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"adımlarım tereyağıyla yıkanır,","poem":1},{"text":"kaya bana yağ ırmakları dökerdi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ben kent kapısına çıkınca,","poem":1},{"text":"sokakta kürsümü hazırladım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gençler beni görüp saklanırdı.","poem":1},{"text":"Yaşlılar ayağa kalkıp dikilirdi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Beyler konuşmaktan çekinirler,","poem":1},{"text":"ellerini ağızlarına koyarlardı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Soyluların sesi kesilirdi,","poem":1},{"text":"dili damaklarına yapışırdı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü kulak beni işitince, beni kutsardı;","poem":1},{"text":"göz beni görünce, beni överdi;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"çünkü feryat eden yoksulu,","poem":1},{"text":"ve kendisine yardım edecek kimsesi olmayan babasızı da kurtarırdım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ölüm tehlikesinde olanın kutsaması üzerime gelirdi,","poem":1},{"text":"ve dul kadının yüreğini sevinçle ezgi söylettirirdim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Doğruluğu giydim, ve o beni kuşandırdı.","poem":1},{"text":"Adaletim bir kaftan ve bir taç gibiydi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Köre göz,","poem":1},{"text":"topala ayak oldum.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yoksullara baba oldum.","poem":1},{"text":"Tanımadığım adamın davasını araştırırdım.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haksızın çenesini kırardım,","poem":1},{"text":"ve avı onun dişlerinin arasından koparırdım.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"O zaman şöyle derdim, 'Kendi evimde öleceğim,","poem":1},{"text":"günlerimi kum gibi sayacağım.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Köküm sulara kadar yayılmış.","poem":1},{"text":"Çiy bütün gece dalımda kalır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"İçimde yüceliğim tazedir.","poem":1},{"text":"Yayım elimde yenilenmiştir.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“İnsanlar beni dinler, beklerlerdi,","poem":1},{"text":"ve öğüdüm için susarlardı.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Benim sözlerimden sonra bir daha konuşmazlardı.","poem":1},{"text":"Sözüm üzerlerine dökülürdü.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yağmuru bekler gibi beni beklerlerdi.","poem":1},{"text":"Ağızları bahar yağmuru gibi içerdi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Güvenleri olmadığında ben onlara gülümserdim.","poem":1},{"text":"Yüzümün ışığını reddetmezlerdi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Onların yolunu ben seçerdim ve baş olarak otururdum.","poem":1},{"text":"Orduda bir kral gibi, yas tutanları teselli eden biri gibi yaşadım.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}