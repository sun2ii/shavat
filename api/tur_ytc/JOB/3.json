{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Bundan sonra İyov ağzını açtı ve doğduğu günü lanetledi."]},{"type":"verse","number":2,"content":["İyov şöyle yanıt verdi:"]},{"type":"verse","number":3,"content":[{"text":"“Doğduğum gün,","poem":1},{"text":"‘Bir erkek çocuğa gebe kaldı’ denen gece yok olsun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O gün karanlık olsun.","poem":1},{"text":"Yukarıdan Tanrı onu aramasın,","poem":2},{"lineBreak":true},{"text":"onun üzerine ışık parlamasın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Karanlık ve ölüm gölgesi ona sahip çıksınlar.","poem":1},{"text":"Üzerinde bir bulut dursun.","poem":2},{"lineBreak":true},{"text":"Günü karartan her şey onu dehşete soksun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O geceye gelince, onu koyu karanlık yakalasın.","poem":1},{"text":"Yılın günleri arasında sevinmesin.","poem":2},{"lineBreak":true},{"text":"Ayların sayısına girmesin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, o gece kısır olsun.","poem":1},{"text":"İçinde sevinç sesi duyulmasın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Günü lanetleyenler,","poem":1},{"text":"Levyatan'ı uyandırmaya hazır olanlar onu lanetlesin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alacakaranlığın yıldızları kararsın.","poem":1},{"text":"Işık arasın da olmasın,","poem":2},{"lineBreak":true},{"text":"sabahın göz kapaklarını da görmesin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü annemin rahminin kapılarını kapatmadı,","poem":1},{"text":"gözümden sıkıntıyı gizlemedi.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Neden rahimden çıkarken ölmedim?","poem":1},{"text":"Annem beni doğururken ruhumu neden teslim etmedim?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neden beni dizler,","poem":1},{"text":"emeyim diye memeler karşıladı?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü yatmış ve sessiz olurdum.","poem":1},{"text":"Uyumuş olurdum,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kendilerine harabeler yapmış olan,","poem":1},{"text":"yeryüzünün kralları ve danışmanlarıyla birlikte,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ya da evlerini gümüşle doldurmuş olan,","poem":1},{"text":"Altın sahibi beylerle birlikte rahat etmiş olurdum.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ya da hiç ışığı görmemiş bebekler gibi,","poem":1},{"text":"gizlilikte vaktinden önce doğmuş bir çocuk gibi olurdum.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Orada kötüler sıkıntı çektirmeyi bırakırlar.","poem":1},{"text":"Yorgunlar orada rahatlar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tutuklular orada hep rahattır.","poem":1},{"text":"Angaryacının sesini duymazlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Küçük de büyük de oradadır.","poem":1},{"text":"Hizmetçi efendisinden özgürdür.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Neden sefalet içinde olana ışık,","poem":1},{"text":"canı acı olana yaşam verilir?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onlar ki, ölümü özlerler, ama gelmez;","poem":1},{"text":"gizli hazinelerden daha çok onu ararlar,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mezarı bulduklarında,","poem":1},{"text":"fazlasıyla coşup sevinç duyarlar?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neden yolu gizli olan,","poem":1},{"text":"Tanrı'nın çitle çevirdiği adama ışık verilir?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çünkü inlemem ekmek yememden önce geliyor.","poem":1},{"text":"İnlemelerim su gibi dökülüyor.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Çünkü korktuğum şey başıma geliyor,","poem":1},{"text":"ve çekindiğim şey üzerime geliyor.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Rahat değilim, ne de sakinim, ne de dinlenmem var;","poem":1},{"text":"ama sıkıntı geliyor.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}