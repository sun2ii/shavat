{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"“Ama şimdi benden genç olanlar benimle alay ediyorlar,","poem":1},{"text":"onların babalarını sürümün köpekleriyle birlikte koymaya layık görmezdim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ellerinin gücü ne işime yarardı,","poem":1},{"text":"olgunluk çağını yitirmiş adamlardı?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yoksulluk ve kıtlıktan bitkinler.","poem":1},{"text":"Çoraklığın ve ıssızlığın karanlığında,","poem":2},{"lineBreak":true},{"text":"kuru toprak kemiriyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çalılıklardan tuzlu ot koparıyorlar.","poem":1},{"text":"Onların yiyeceği süpürge ağacının kökleridir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İnsanların arasından kovulurlar.","poem":1},{"text":"Hırsız ardından bağırır gibi onlara bağırırlar,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"böylece korkunç vadilerde,","poem":1},{"text":"yerin ve kayaların oyuklarında yaşarlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çalılıklar arasında anırırlar.","poem":1},{"text":"Isırgan otlarının altında toplanırlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Evet, ahmakların, kötü adamların çocuklarıdırlar.","poem":1},{"text":"Ülkeden kırbaçla kovulmuşlardır.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Şimdi onlara ezgi oldum.","poem":1},{"text":"Evet, onlar için bir özdeyişim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Benden tiksiniyorlar, benden uzak duruyorlar,","poem":1},{"text":"yüzüme tükürmekten çekinmiyorlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü ipini çözdü ve beni ezdi;","poem":1},{"text":"ve onlar benim önümde dizginleri sıyırdılar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sağ tarafımda ayaktakımı yükseliyor.","poem":1},{"text":"Ayaklarımı bir kenara itiyorlar.","poem":2},{"lineBreak":true},{"text":"Yıkım yollarını bana karşı kuruyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yolumu bozuyorlar.","poem":1},{"text":"Kimsenin yardımı olmadan yıkımımı teşvik ediyorlar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Geniş bir gedikten geliyorlarmış gibi,","poem":1},{"text":"yıkımın ortasında yuvarlanıyorlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dehşet üzerime döndü.","poem":1},{"text":"Rüzgâr gibi onurumu kovalıyorlar.","poem":2},{"lineBreak":true},{"text":"Mutluluğum bir bulut gibi geçip gitti.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Şimdi canım içimde dökülüyor.","poem":1},{"text":"Sıkıntı günleri beni yakaladı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gece vakti kemiklerim içimde deliniyor,","poem":1},{"text":"ve beni kemiren ağrılar hiç rahat vermiyor.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Büyük güç tarafından giysimin biçimi bozuldu.","poem":1},{"text":"Beni gömleğimin yakası gibi sarıyor.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Beni çamura attı.","poem":1},{"text":"Toz gibi ve kül gibi oldum.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Seni çağırıyorum,","poem":1},{"text":"ve bana yanıt vermiyorsun.","poem":2},{"lineBreak":true},{"text":"Ayağa kalkıyorum ve gözünü bana dikiyorsun.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bana karşı zalim oldun.","poem":1},{"text":"Elinin gücüyle beni eziyorsun.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Beni rüzgâra kaldırıyorsun,","poem":1},{"text":"onunla sürüyorsun. Fırtınada eritiyorsun.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü biliyorum ki beni ölüme,","poem":1},{"text":"yaşayan herkes için belirlenmiş eve götüreceksin.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Ancak biri düşerken elini uzatmaz mı?","poem":1},{"text":"Ya da felaketinde ondan ötürü yardım için çağırmaz mı?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ben sıkıntıda olan için ağlamaz mıydım?","poem":1},{"text":"Muhtaç için canım kederlenmez miydi?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ben iyilik ararken, kötülük geldi.","poem":1},{"text":"Ben ışık beklerken, karanlık geldi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yüreğim sıkkın ve rahatı yok.","poem":1},{"text":"Izdırap günleri üzerime geldi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Güneş olmadan yaslı dolaşıyorum.","poem":1},{"text":"Toplulukta ayağa kalkıp yardım çağırıyorum.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Çakallara kardeş,","poem":1},{"text":"deve kuşlarına yoldaş oldum.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Derim kararıyor ve üzerimden soyuluyor.","poem":1},{"text":"Kemiklerim ateşten yanıyor.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bu yüzden arpım yasa,","poem":1},{"text":"kavalım da ağlayanların sesine döndü.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}