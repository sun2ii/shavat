{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"“Gözlerimle bir antlaşma yaptım;","poem":1},{"text":"o zaman genç bir kadına şehvetle nasıl bakarım?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü yukarıdan, Tanrı'dan payı,","poem":1},{"text":"yücelerden Her Şeye Gücü Yeten'den mirası nedir?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bu, haksız için felaket,","poem":1},{"text":"kötülük işleyenler için bela değil midir?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O, yollarımı görmüyor mu,","poem":1},{"text":"ve bütün adımlarımı saymıyor mu?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Eğer yalanla yürüdüysem,","poem":1},{"text":"ve ayağım hileye koştuysa,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"(Doğru terazide tartılayım da,","poem":1},{"text":"Tanrı dürüstlüğümü bilsin);","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eğer adımım yoldan saptıysa,","poem":1},{"text":"eğer yüreğim gözlerimin ardından yürüdüyse,","poem":2},{"lineBreak":true},{"text":"eğer ellerime kir yapıştıysa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"o zaman ekeyim, başkası yesin.","poem":1},{"text":"Evet, tarlamın ürünü kökünden sökülsün.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Eğer gönlüm bir kadına kapılmışsa,","poem":1},{"text":"ve komşumun kapısında pusuya yatmışsam,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"o zaman karım başkası için öğütsün,","poem":1},{"text":"ve başkaları onunla yatsın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü bu çirkin bir suç olurdu.","poem":1},{"text":"Evet, hâkimler tarafından cezalandırılacak bir kötülük olurdu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"çünkü bu yıkıma kadar yakıp yok eden,","poem":1},{"text":"ve bütün ürünümü kökünden sökecek bir ateştir.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Eğer benimle çekiştikleri zaman,","poem":1},{"text":"erkek ya da kadın kölemin davasını hor gördüysem,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"o zaman Tanrı kalktığında ne yaparım?","poem":1},{"text":"Ziyaret ettiğinde, O'na ne yanıt veririm?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Beni rahimde yaratan onu da yaratmadı mı?","poem":1},{"text":"Rahimde bizi biçimlendiren bir değil mi?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Eğer yoksulu dileklerinden alıkoyduysam,","poem":1},{"text":"ya da dul kadının gözlerini söndürdüysem,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ya da lokmamı tek başıma yediysem,","poem":1},{"text":"babasız da ondan yemediyse,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"(Hayır, gençliğimden beri benimle birlikte büyüdü, baba yanındaymış gibi,","poem":1},{"text":"annemin rahminden beri dul kadına yol gösterdim),","poem":2}]},{"type":"verse","number":19,"content":[{"text":"eğer giysisi olmadığı için mahvolanı,","poem":1},{"text":"ya da örtüsü olmayan yoksulu gördüysem,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"onun yüreği beni kutsamadıysa,","poem":1},{"text":"koyunlarımın yünüyle ısınmadıysa,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kapıda yardımcım olduğunu gördüğüm için,","poem":1},{"text":"babasıza karşı elimi kaldırdıysam,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"o zaman omuzum kürek kemiğinden düşsün,","poem":1},{"text":"kolum kemiğinden kırılsın.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü Tanrı'nın felaketi bana dehşet verir,","poem":1},{"text":"O'nun görkemi yüzünden bir şey yapamam.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Eğer altını ümidim yaptıysam,","poem":1},{"text":"ve saf altına, ‘Sen benim güvencemsin’ dediysem;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"eğer servetim çok olduğu,","poem":1},{"text":"ve elim çok kazandığı için sevindiysem;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"eğer ışıldarken güneşe,","poem":1},{"text":"ya da ihtişamla hareket ederken aya bakıp da,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ve yüreğim gizlice kandırıldıysa,","poem":1},{"text":"ve elim ağzımdan bir öpücük attıysa;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"bu da hâkimler tarafından cezalandırılacak bir suç olurdu,","poem":1},{"text":"çünkü yukarıda olan Tanrı'yı inkâr etmiş olurdum.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Eğer benden nefret edenin yıkımına sevindiysem,","poem":1},{"text":"ya da kötülük onu bulduğunda kendimi yükselttiysem,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"(Kesinlikle, lanetle kimsenin canını dileyerek,","poem":1},{"text":"ağzımın günah işlemesine izin vermedim);","poem":2}]},{"type":"verse","number":31,"content":[{"text":"eğer çadırımın adamları,","poem":1},{"text":"'Onun yedirdiği ete doymamış kim vardır?' demedilerse,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"(Yabancı sokakta konaklamazdı,","poem":1},{"text":"oysa kapımı yolcuya açardım);","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Adem gibi suçlarımı örttüysem,","poem":1},{"text":"kötülüğümü yüreğimde sakladıysam,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"çünkü büyük kalabalıktan korktuğum için,","poem":1},{"text":"boyların hor görmesi beni dehşete düşürdü diye,","poem":2},{"lineBreak":true},{"text":"sustum ve kapıdan çıkmadıysam.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Keşke beni dinleyecek biri olsaydı!","poem":1},{"text":"İşte imzam! Her Şeye Gücü Yeten bana yanıt versin!","poem":2},{"lineBreak":true},{"text":"Suçlayıcı iddianamemi yazsın!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Elbette onu omzumda taşırdım,","poem":1},{"text":"ve taç gibi kendime bağlardım.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Adımlarımın sayısını ona bildirirdim.","poem":1},{"text":"Kendisine bir hükümdar gibi yaklaşırdım.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Eğer toprağım bana karşı feryat ediyorsa,","poem":1},{"text":"saban izleri hep birlikte ağlıyorsa;","poem":2}]},{"type":"verse","number":39,"content":[{"text":"eğer ürününü parasız yediysem,","poem":1},{"text":"ya da sahiplerinin hayatını kaybettirdiysem,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"buğday yerine diken,","poem":1},{"text":"arpa yerine kötü ot bitsin.”","poem":2},"İyov'un sözleri bitti."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}