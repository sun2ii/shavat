{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":["Böylece bu üç adam İyov'a yanıt vermekten vazgeçtiler, çünkü o kendi gözünde doğruydu."]},{"type":"verse","number":2,"content":["O zaman Ram ailesinden Buzlu Barakel oğlu Elihu'nun öfkesi İyov'a karşı alevlendi. Öfkesi, Tanrı'dan çok kendini haklı çıkarmış olduğu için alevlendi."]},{"type":"verse","number":3,"content":["Öfkesi, yanıt bulamadıkları ve yine de İyov'u mahkûm ettikleri için üç arkadaşına karşı da alevlendi."]},{"type":"verse","number":4,"content":["Elihu, İyov'la konuşmak için beklemişti, çünkü onlar kendisinden yaşça büyüktüler."]},{"type":"verse","number":5,"content":["Elihu, bu üç adamın ağzından yanıt gelmediğini görünce, öfkesi alevlendi."]},{"type":"verse","number":6,"content":["Buzlu Barakel oğlu Elihu,",{"text":"“Ben gencim, siz ise çok yaşlısınız” diye karşılık verdi,","poem":1},{"text":"“Bu yüzden kendimi tuttum ve size fikrimi açıklamaya cesaret edemedim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ben dedim ki, 'Günler konuşmalı,","poem":1},{"text":"yılların çokluğu bilgelik öğretmeli.'","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama insanda ruh vardır,","poem":1},{"text":"ve Yüce Olan'ın Ruhu","poem":2},{"noteId":15},{"text":"onlara anlayış verir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bilge olanlar büyükler değil,","poem":1},{"text":"doğruyu anlayanlar da yaşlılar değil.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bu yüzden dedim ki, 'Beni dinleyin,","poem":1},{"text":"ben de fikrimi göstereyim.'","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“İşte, sözlerinizi bekledim,","poem":1},{"text":"siz söz araştırırken,","poem":2},{"lineBreak":true},{"text":"düşüncelerinizi dinledim,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"evet, size tüm dikkatimi verdim,","poem":1},{"text":"ama aranızda İyov'u ikna eden","poem":2},{"lineBreak":true},{"text":"ya da sözlerine yanıt veren kimse olmadı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sakın, 'Biz bilgeliği bulduk.","poem":1},{"text":"Tanrı onu çürütebilir, insan değil' demeyin;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"çünkü o bana karşı sözlerini yöneltmedi,","poem":1},{"text":"ben de ona sizin sözlerinizle yanıt vermeyeceğim.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Şaşırdılar, artık yanıt vermiyorlar.","poem":1},{"text":"Söyleyecek sözleri yok.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Konuşmadıkları, durdukları,","poem":1},{"text":"ve artık onlar yanıt vermedikleri için bekleyeyim mi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ben de kendi payıma düşen yanıtı vereyim,","poem":1},{"text":"ben de fikrimi göstereyim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü sözlerle doluyum.","poem":1},{"text":"İçimdeki ruh beni sıkıştırıyor.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İşte göğsüm, açılmamış şarap gibidir;","poem":1},{"text":"patlamaya hazır yeni tulumlar gibidir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Söyleyeyim de ferahlayayım.","poem":1},{"text":"Dudaklarımı açayım da yanıt vereyim.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kimsenin şahsına itibar etmeyeyim,","poem":1},{"text":"kimseye de methedici ünvanlar vermeyeyim.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü methedici ünvanlar vermeyi bilmem,","poem":1},{"text":"yoksa Yaratıcım beni hemen alıp götürürdü.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"veya nefes","reference":{"chapter":32,"verse":8}}]},"thisChapterLink":"/api/tur_ytc/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}