{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“Ancak ey İyov, lütfen sözümü dinle,","poem":1},{"text":"ve bütün sözlerime kulak ver.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İşte, ağzımı açtım.","poem":1},{"text":"Dilim ağzımda konuşuyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sözlerim yüreğimin doğruluğunu dile getirecek.","poem":1},{"text":"Dudaklarımın bildiklerini içtenlikle söyleyecek.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tanrı'nın Ruhu beni yarattı,","poem":1},{"text":"ve Her Şeye Gücü Yeten'in soluğu bana hayat veriyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eğer elinden geliyorsa, bana yanıt ver.","poem":1},{"text":"Sözlerini önümde sıraya koy, karşımda dur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"İşte, ben de Tanrı'ya senin gibiyim.","poem":1},{"text":"Ben de balçıktan şekillendirildim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, dehşetim seni korkutmaz,","poem":1},{"text":"baskım sana ağır gelmez.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Gerçekten de ben dinlerken sen dedin,","poem":1},{"text":"senin sözlerini duydum,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'İtaatsizlik yok, ben temizim.","poem":1},{"text":"Suçsuzum, içimde kötülük yoktur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İşte, bana karşı bahane buluyor.","poem":1},{"text":"Beni düşmanı sayıyor.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ayaklarımı tomruğa vuruyor.","poem":1},{"text":"Bütün yollarımı mimliyor.'”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“İşte, sana yanıt vereyim. Bunda haklı değilsin,","poem":1},{"text":"çünkü Tanrı insandan büyüktür.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Meselelerinin hiçbiri için yanıt vermiyor diye,","poem":1},{"text":"neden O'nunla çekişiyorsun?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü Tanrı bir kez,","poem":1},{"text":"hatta iki kez konuşur, ama insan dikkat etmez.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Düşte, gece görümünde,","poem":1},{"text":"insanların üzerine derin uyku çöktüğünde,","poem":2},{"lineBreak":true},{"text":"Yatak üzerinde uyuklarken,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"o zaman insanların kulaklarını açar,","poem":1},{"text":"ve onlara öğretilen şeyleri mühürler,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"insanı amacından uzaklaştırmak,","poem":1},{"text":"ve gururu insandan gizlemek için.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Canını çukurdan,","poem":1},{"text":"ve hayatını kılıçtan esirger.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Yatağı üzerinde acıyla,","poem":1},{"text":"kemikleri içinde sürekli çekişmeyle de terbiye edilir,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"öyle ki, hayatı ekmekten,","poem":1},{"text":"canı da lezzetli yiyecekten tiksinir.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Eti öylesine tükenmiştir ki, görülmez olur.","poem":1},{"text":"Gözükmeyen kemikleri dışarı çıkar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Evet, canı çukura,","poem":1},{"text":"yaşamı da yok edicilere yaklaşır.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“İnsana kendisi için neyin doğru olduğunu göstersin diye,","poem":1},{"text":"eğer yanında bir melek, bin kişiden biri olan bir yorumcu varsa,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"o zaman Tanrı ona lütufta bulunur ve şöyle der:","poem":1},{"text":"‘Onu çukura inmekten kurtar,","poem":2},{"lineBreak":true},{"text":"ben fidye buldum.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Eti bir çocuğunkinden daha körpe olur.","poem":1},{"text":"Gençliğinin günlerine döner.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tanrı’ya dua eder ve O da ondan hoşnut olur,","poem":1},{"text":"öyle ki, yüzünü sevinçle görür. O, insana doğruluğunu geri verir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İnsanların önünde ezgi söyleyerek der:","poem":1},{"lineBreak":true},{"text":"'Günah işledim ve doğru olanı çarpıttım,","poem":1},{"text":"ama bana yararı olmadı.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Canımı çukura girmekten O kurtardı.","poem":1},{"text":"Yaşamım ışığı görecek.'”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“İşte, Tanrı bütün bunları bir adama iki kez,","poem":1},{"text":"hatta üç kez yapar,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"canını çukurdan çıkarmak için,","poem":1},{"text":"yaşayanların ışığıyla aydınlansın diye.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"İyi düşün ey İyov, beni dinle.","poem":1},{"text":"Sen sus da, ben konuşayım.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Söyleyecek bir şeyin varsa, bana yanıt ver.","poem":1},{"text":"Konuş, çünkü seni haklı çıkarmak isterim.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yoksa, beni dinle.","poem":1},{"text":"Sus da sana bilgelik öğreteyim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}