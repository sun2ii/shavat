{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Elihu yanıtına şöyle devam edip dedi:"]},{"type":"verse","number":2,"content":[{"text":"“Ey bilgeler, sözlerimi dinleyin.","poem":1},{"text":"Bilgi sahibi olanlar, bana kulak verin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü damağın yemeği tattığı gibi,","poem":1},{"text":"kulak da sözleri sınar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kendimiz için doğru olanı seçelim.","poem":1},{"text":"Kendi aramızda neyin iyi olduğunu bilelim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü İyov, ‘Ben doğruyum,","poem":1},{"text":"Tanrı hakkımı elimden aldı’ diyor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Hakkım varken yalancı sayıldım.","poem":1},{"text":"İtaatsizliğim yokken yaram devasız.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alayı gibi su içen,","poem":1},{"text":"kötülük işleyenlerle birlikte giden,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kötülerle birlikte yürüyen,","poem":1},{"text":"İyov gibisi var mı?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü O, 'İnsanın Tanrı ile hoşnut olmasının","poem":1},{"text":"hiçbir yararı yoktur' demiştir.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Bu nedenle, ey anlayışlı adamlar, beni dinleyin:","poem":1},{"text":"Kendisinden uzak olsun ki, Tanrı kötülük yapsın,","poem":2},{"lineBreak":true},{"text":"ve Her Şeye Gücü Yeten haksızlık yapsın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü O, insanın işini kendine öder,","poem":1},{"text":"ve herkese kendi yollarına göre buldurur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Elbette Tanrı kötülük yapmaz,","poem":1},{"text":"Her Şeye Gücü Yeten de adaleti çarpıtmaz.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O'nu yeryüzünün başına kim koydu?","poem":1},{"text":"Ya da O'nu bütün dünyanın üzerine kim atadı?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eğer yüreğini kendi üzerine çevirirse,","poem":1},{"text":"eğer ruhunu ve nefesini kendine toplarsa,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bütün bedenler birlikte yok olur,","poem":1},{"text":"ve insan yine toprağa döner.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Eğer şimdi sende anlayış varsa, bunu dinle.","poem":1},{"text":"Sözlerime kulak ver.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Adaletten nefret eden biri hiç hükmedebilir mi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bir krala, 'Yaramaz!' ya da beylere, 'Kötüsünüz!' diyen","poem":1},{"text":"Adil ve büyük Olanı mahkûm edecek misin?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Beylerin şahsına itibar etmez,","poem":1},{"text":"zenginleri fakirlerden daha çok saymaz,","poem":2},{"lineBreak":true},{"text":"çünkü hepsi O'nun ellerinin eseridir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bir anda, gece yarısı ölürler.","poem":1},{"text":"Halk sarsılır ve geçip gider.","poem":2},{"lineBreak":true},{"text":"Güçlüler el değmeden alınıp götürülür.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Çünkü gözleri adamın yolları üzerindedir.","poem":1},{"text":"Onun bütün gidişlerini görür.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kötülük işleyenlerin saklanabileceği","poem":1},{"text":"karanlık ya da koyu karanlık yoktur.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü Tanrı önüne mahkemeye gelsin diye,","poem":1},{"text":"O'nun bir adamı daha fazla araştırmasına gerek yoktur.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Güçlüleri araştırmadan parçalar,","poem":1},{"text":"ve onların yerine başkalarını diker.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bu yüzden onların işlerini bilir.","poem":1},{"text":"Geceleyin onları devirir,","poem":2},{"lineBreak":true},{"text":"böylece mahvolurlar.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kötü oldukları için onları vurur,","poem":1},{"text":"başkalarının gözü önünde;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"çünkü O'nu izlemekten saptılar,","poem":1},{"text":"yollarından hiçbirine dikkat etmediler,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"yoksulların feryadını O'na ulaştırdılar.","poem":1},{"text":"O, ezilenlerin feryadını duydu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"O sakinlik verdiğinde, kim suçlayabilir?","poem":1},{"text":"Yüzünü gizlediğinde, O'nu kim görebilir?","poem":2},{"lineBreak":true},{"text":"O, bir ulusa ya da bir adama karşı da aynıdır,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"tanrısız adam hüküm sürmesin diye,","poem":1},{"text":"Halkı tuzağa düşürecek kimse olmasın diye.”","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Çünkü Tanrı'ya, 'Suçluyum,","poem":1},{"text":"ama bir daha suç işlemeyeceğim' diyen oldu mu?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"'Görmediğimi sen bana öğret.","poem":1},{"text":"Eğer kötülük yaptıysam, bir daha yapmam' diyen oldu mu?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ödülü senin istediğin gibi mi olacak ki, reddediyorsun?","poem":1},{"text":"Çünkü sen seçmelisin, ben değil.","poem":2},{"lineBreak":true},{"text":"Bu yüzden bildiğini söyle.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anlayışlı adamlar bana,","poem":1},{"text":"beni dinleyen her bilge adam şöyle diyecek:","poem":2}]},{"type":"verse","number":35,"content":[{"text":"'İyov bilgisizce konuşuyor.","poem":1},{"text":"Onun sözleri bilgelikten yoksun.'","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Çünkü kötü adamlar gibi yanıt verdiğinden,","poem":1},{"text":"keşke İyov'un denenmesi sona dek sürse.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Çünkü günahına isyanı katıyor.","poem":1},{"text":"Aramızda ellerini çırpıyor,","poem":2},{"lineBreak":true},{"text":"ve Tanrı'ya karşı sözlerini çoğaltıyor.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}