{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Elihu yanıtına şöyle devam edip dedi:"]},{"type":"verse","number":2,"content":[{"text":"“Bunun senin hakkın olduğunu mu sanıyorsun,","poem":1},{"text":"yoksa, ‘Benim doğruluğum Tanrı’nın doğruluğundan daha çoktur’ mu diyorsun?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‘Sana ne yararı olacak?","poem":1},{"text":"Günah işlemiş olsaydım,","poem":2},{"lineBreak":true},{"text":"bundan daha fazla ne kazanırdım?’ diye soruyor musun?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sana ve seninle birlikte olan arkadaşlarına","poem":1},{"text":"yanıt vereceğim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Göklere bak da gör.","poem":1},{"text":"Senden daha yüksek olan gökleri gör.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eğer günah işlediysen, O'na ne etkin olur?","poem":1},{"text":"Suçların çoğalırsa, O'na yaptığın nedir?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eğer doğruysan, O'na verdiğin nedir?","poem":1},{"text":"Ya da senin elinden O'nun aldığı nedir?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kötülüğün senin gibi bir adama zarar verebilir,","poem":1},{"text":"ve doğruluğun bir insanoğluna yarar sağlayabilir.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Zorbalığın çokluğundan dolayı feryat ediyorlar.","poem":1},{"text":"Güçlülerin kolundan dolayı yardım için çağırıyorlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama hiç kimse,","poem":1},{"text":"'Geceleyin ezgiler veren,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yeryüzünün hayvanlarından daha çok bize öğreten,","poem":1},{"text":"ve göklerin kuşlarından bizi daha bilge kılan Tanrım, Yaradan'ım nerede?' demiyor.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Orada feryat ediyorlar,","poem":1},{"text":"ama kötü insanların gururu yüzünden","poem":2},{"lineBreak":true},{"text":"kimse yanıt vermiyor.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gerçekten Tanrı boş feryadı duymaz,","poem":1},{"text":"Her Şeye Gücü Yeten de onu dikkate almaz.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"O'nu görmediğini söylediğinde bile,","poem":1},{"text":"davan O'nun önündedir,","poem":2},{"lineBreak":true},{"text":"ve sen O'nu bekle!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ama şimdi, öfkesiyle ziyaret etmediği,","poem":1},{"text":"kibri de çok önemsemediği için,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"bu yüzden İyov boş konuşmayla ağzını açıyor,","poem":1},{"text":"ve bilgisizce sözleri çoğaltıyor.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}