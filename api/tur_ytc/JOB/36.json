{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":[{"text":"Elihu yine devam edip dedi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Biraz sabret de, sana göstereyim;","poem":1},{"text":"çünkü Tanrı adına daha söyleyeceklerim var.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uzaktan bilgi edineceğim,","poem":1},{"text":"ve Yaratıcıma hak vereceğim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü sözlerim gerçekten yalan değil.","poem":1},{"text":"Bilgide tam olan biri senin karşındadır.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“İşte, Tanrı güçlüdür ve kimseyi hor görmez.","poem":1},{"text":"Anlayış gücünde kudretlidir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kötü kişinin canını korumaz,","poem":1},{"text":"ama ezilenlere adalet sağlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gözlerini doğrudan ayırmaz,","poem":1},{"text":"ama taht üzerinde krallarla birlikte,","poem":2},{"lineBreak":true},{"text":"onları daima oturtur ve yükseltir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eğer zincirlere vurulurlarsa,","poem":1},{"text":"ve sıkıntı bağlarına tutulurlarsa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"o zaman onlara işlerini ve suçlarını,","poem":1},{"text":"gururla davranmış olduklarını gösterir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kulaklarını öğütlere açar,","poem":1},{"text":"ve kötülükten dönmelerini buyurur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eğer dinler ve O'na hizmet ederlerse,","poem":1},{"text":"günlerini bolluk içinde, yıllarını zevk içinde geçirirler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama dinlemezlerse, kılıçla yok olurlar;","poem":1},{"text":"bilgisizce ölürler.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Ama yüreği tanrısız olanlar öfke biriktirirler.","poem":1},{"text":"Onları bağladığı zaman, yardım için çağırmazlar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gençlikte ölürler.","poem":1},{"text":"Yaşamları kirli olanlar arasında yok olur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ezilenleri sıkıntılarından kurtarır,","poem":1},{"text":"baskıda onların kulağını açar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Evet, seni sıkıntıdan,","poem":1},{"text":"hiç darlığın olmadığı geniş bir yere çekmek isterdi.","poem":2},{"lineBreak":true},{"text":"Sofrana konulmuş olan, yağla dolu olurdu.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Ama sen kötü adamın hükmüyle dolusun.","poem":1},{"text":"Yargı ve adalet seni yakalıyor.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zenginlik seni gazaba doğru baştan çıkarmasın,","poem":1},{"text":"rüşvetin büyüklüğü seni saptırmasın.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zenginliğin sıkıntıda sana destek olur mu,","poem":1},{"text":"ya da gücünün bütün kuvveti?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"İnsanların yerlerinden kesildiği geceyi,","poem":1},{"text":"sen arzulama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dikkat et, kötülüğe bakma;","poem":1},{"text":"çünkü sen onu sıkıntıdan daha çok seçtin.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"İşte, Tanrı kudretiyle yücedir.","poem":1},{"text":"O'nun gibi öğretmen kimdir?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kim O'na yolunu çizdi?","poem":1},{"text":"Ya da kim O'na, 'Haksızlık yaptın' diyebilir?”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“O'nun işini yüceltmelisin,","poem":1},{"text":"hatırla bunu,","poem":2},{"lineBreak":true},{"text":"İnsanların ezgi söylemiş oldukları işi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bütün insanlar ona baktı.","poem":1},{"text":"İnsanlar onu uzaktan görür.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"İşte, Tanrı büyüktür ve biz O'nu bilmeyiz.","poem":1},{"text":"O'nun yıllarının sayısı araştırılamaz.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çünkü O, buharından yağmura dönüşen","poem":1},{"text":"su damlalarını yukarı çeker,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"göklerin döktüğü,","poem":1},{"text":"ve insanın üzerine bol bol düştüğü yağmuru.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Gerçekten, bulutların yayılmasını,","poem":1},{"text":"ve çadırının gök gürültülerini insan anlayabilir mi?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"İşte, ışığını kendi çevresine yayar.","poem":1},{"text":"Denizin dibini örter.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Çünkü halklara bunlarla hükmeder.","poem":1},{"text":"Bol yiyecek verir.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ellerini şimşekle örter,","poem":1},{"text":"ve ona hedefi vurmasını buyurur.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Onun gürültüsü Tanrı hakkında söylemekte,","poem":1},{"text":"ve yaklaşmakta olan fırtınadan hayvanlara da söz etmektedir.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}