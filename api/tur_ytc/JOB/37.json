{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“Evet, buna yüreğim titrer,","poem":1},{"text":"ve yerinden oynar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Duyun, O'nun gürleyen sesini,","poem":1},{"text":"ağzından çıkan sesi duyun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onu bütün gökyüzünün altına,","poem":1},{"text":"şimşeğini de yeryüzünün uçlarına gönderir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ardından bir ses gümbürder.","poem":1},{"text":"Görkemli sesiyle gürler.","poem":2},{"lineBreak":true},{"text":"Sesi duyulunca hiçbir şeyi alıkoymaz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tanrı sesiyle şaşılacak biçimde gürler.","poem":1},{"text":"Anlayamadığımız büyük şeyler yapar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü kara, ‘Yeryüzüne düş’ der,","poem":1},{"text":"aynı şekilde yağmur sağanağına,","poem":2},{"lineBreak":true},{"text":"ve güçlü yağmur sağanaklarına.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Her insanın elini mühürler,","poem":1},{"text":"öyle ki, yarattığı bütün insanlar bunu bilsin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sonra hayvanlar gizlenir,","poem":1},{"text":"ve inlerinde kalırlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Odasından fırtına,","poem":1},{"text":"kuzeyden soğuk gelir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanrı'nın soluğuyla buz verilir,","poem":1},{"text":"ve suların genişliği dondurulur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Evet, kalın bulutu nemle yükler.","poem":1},{"text":"Kendi şimşek bulutunu etrafa yayar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oturulan dünyanın yüzü üzerinde","poem":1},{"text":"onlara buyurduğu her şeyi yapsınlar diye,","poem":2},{"lineBreak":true},{"text":"O'nun yol göstermesiyle döner, çevrilir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İster cezalandırmak için, ister kendi ülkesi için,","poem":1},{"text":"ister iyilik dolu sevgisi için olsun, onun gelmesini sağlar.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Dinle ey İyov.","poem":1},{"text":"Dur da Tanrı'nın şaşılacak işlerini düşün.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tanrı'nın onları nasıl idare ettiğini,","poem":1},{"text":"ve bulutunun şimşeğini nasıl çaktırdığını biliyor musun?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bulutların işleyişini,","poem":1},{"text":"bilgide kusursuz olanın şaşılası işlerini biliyor musun?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Güney rüzgârı nedeniyle dünya durgunlaştığında,","poem":1},{"text":"giysileri sıcak olan sen misin?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"O'nunla birlikte, dökme metal ayna gibi sert olan","poem":1},{"text":"gökyüzünü yayabilir misin?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"O'na ne söyleyeceğimizi bize öğret,","poem":1},{"text":"çünkü karanlık yüzünden davamızı ortaya koyamıyoruz.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ben konuşmak istiyorum diye, O'na haber verilir mi?","poem":1},{"text":"Ya da insan hiç yutulmak ister mi?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Şimdi insanlar göklerde parlayan ışığı görmüyorlar,","poem":1},{"text":"ancak rüzgâr geçiyor da onları temizliyor.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kuzeyden altın ihtişam geliyor.","poem":1},{"text":"Tanrı ile birlikte korkunç bir görkem.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Her Şeye Gücü Yeten'e ulaşamayız.","poem":1},{"text":"O güçte yücedir.","poem":2},{"lineBreak":true},{"text":"Adaleti ve büyük doğruluğuyla kimseyi ezmez.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bu yüzden insanlar O'na saygı gösterir.","poem":1},{"text":"Yürekte bilge olanların hiç birini dikkate almaz.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}