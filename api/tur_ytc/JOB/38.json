{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":["O zaman Yahve kasırganın içinden İyov'a yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Kimdir bu bilgisizce sözlerle","poem":1},{"text":"Tasarıyı karartan?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Erkek gibi kuşağını beline vur,","poem":1},{"text":"sana sorayım da, bana yanıt ver!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ben dünyanın temellerini atarken sen neredeydin?","poem":1},{"text":"Sen de anlayış varsa, bildir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eğer biliyorsan onun ölçülerini kim saptadı?","poem":1},{"text":"Ya da ipi üzerine kim gerdi?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onun temelleri neyin üzerine dayandırıldı?","poem":1},{"text":"Ya da köşe taşını kim koydu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sabah yıldızları birlikte ezgi söylerken,","poem":1},{"text":"ve bütün Tanrı oğulları sevinçle haykırırken?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ya da denizi kapılarla kim kapattı,","poem":1},{"text":"rahimden çıkıp fışkırdığında,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bulutları onun giysisi yaptığımda,","poem":1},{"text":"ve onu koyu karanlığa sardığımda,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"sınırımı ona koyduğumda,","poem":1},{"text":"sürgüleri ve kapıları taktığımda,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ve, ‘Buraya kadar gelebilirsin, ama daha öteye gidemezsin,","poem":1},{"text":"gururlu dalgaların burada duracak’ dediğimde?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Sen kendi günlerinde sabaha buyurdun mu,","poem":1},{"text":"ve şafağa yerini bildirdin mi,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"yeryüzünün uçlarını tutsun,","poem":1},{"text":"ve kötüleri ondan silkip atsın diye?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"O mühür altındaki balçık gibi değişir,","poem":1},{"text":"ve giysi gibi ortaya koyulur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kötülerden ışıkları alıkonulur.","poem":1},{"text":"Kalkmış olan kol kırılır.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Denizin kaynaklarına girdin mi?","poem":1},{"text":"Ya da derinliğin yataklarında yürüdün mü?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ölümün kapıları sana gösterildi mi?","poem":1},{"text":"Ya da ölüm gölgesi kapılarını gördün mü?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yeryüzünün genişliğini kavradın mı?","poem":1},{"text":"Eğer hepsini biliyorsan, bildir.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Işığın oturduğu yerin, yolu nerededir?","poem":1},{"text":"Ya karanlık, onun yeri nerededir?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta ki, onu sınırına kadar götüresin,","poem":1},{"text":"ve evinin yollarını ayırt edesin?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Elbette biliyorsun, çünkü o zaman doğmuştun,","poem":1},{"text":"ve senin günlerinin sayısı çoktur!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Karın ambarlarına girdin mi,","poem":1},{"text":"ya da dolunun ambarlarını gördün mü?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ben onları sıkıntı zamanı için,","poem":1},{"text":"kavga ve savaş günü için saklarım?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Şimşeğin nerede dağıtıldığı,","poem":1},{"text":"ya da doğu rüzgârının yeryüzüne nerede saçıldığı?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sel sularına kanal,","poem":1},{"text":"yıldırıma yol açan kimdir?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"İnsanın bulunmadığı diyara,","poem":1},{"text":"insanın olmadığı çöle yağsın diye,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"çorak ve ıssız yeri doyursun,","poem":1},{"text":"taze ot yetiştirsin diye.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yağmurun babası var mıdır?","poem":1},{"text":"Ya da çiğ damlalarının babası kimdir?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Buz kimin rahminden çıktı?","poem":1},{"text":"Gökyüzünün gri kırağısını kim doğurdu?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Derin suların yüzeyi donunca,","poem":1},{"text":"sular taş gibi sertleşir.”","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Ülker takımyıldızını bağlayabilir misin,","poem":1},{"text":"ya da Orion'un bağlarını çözebilir misin?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Takımyıldızlarını mevsiminde çıkarabilir misin?","poem":1},{"text":"Ya da Büyük Ayı'ya yavrularıyla birlikte yol gösterebilir misin?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Göklerin yasalarını biliyor musun?","poem":1},{"text":"Onun hakimiyetini yeryüzünde kurabilir misin?”","poem":2}]},{"type":"verse","number":34,"content":[{"text":"“Sesini bulutlara yükseltebilir misin ki,","poem":1},{"text":"bol sular seni örtsün?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Şimşekleri gönderebilir misin ki, gitsinler?","poem":1},{"text":"Sana, 'İşte buradayız' diye haber verirler mi?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"İç kısımlara bilgelik koyan kimdir?","poem":1},{"text":"Ya da zihne anlayış veren kimdir?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bulutları bilgelikle kim sayabilir?","poem":1},{"text":"Ya da göğün kaplarını kim boşaltabilir,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"toprak sertleştiğinde,","poem":1},{"text":"Ve yerin parçaları birbirine yapıştığında?”","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Dişi aslan için sen av avlayabilir misin,","poem":1},{"text":"ya da genç aslanların karnını doyurabilir misin,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"inlerinde sindiklerinde,","poem":1},{"text":"ve çalılıkta pusuya yattıklarında?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yavruları Tanrı'ya feryat edip açlıktan dolaştıklarında,","poem":1},{"text":"kargaya avını kim sağlıyor?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}