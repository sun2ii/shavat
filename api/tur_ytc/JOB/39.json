{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“Dağ keçilerinin doğurduğu zamanı biliyor musun?","poem":1},{"text":"Geyik yavruladığında sen mi gözetliyorsun?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Doldurdukları ayları sayabilir misin?","poem":1},{"text":"Ya da doğurdukları zamanı biliyor musun?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eğilirler, yavrularını doğururlar,","poem":1},{"text":"sancılarından kurtulurlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yavruları güçlenir, kırda büyürler,","poem":1},{"text":"çıkarlar ve bir daha geri dönmezler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Yaban eşeğini kim serbest bıraktı?","poem":1},{"text":"Ya da çevik eşeğin bağlarını kim çözdü?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onun yurdunu bozkır,","poem":1},{"text":"meskenini de tuz diyarı yaptım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kentin gürültüsünü küçümser,","poem":1},{"text":"sürücünün bağırışını da duymaz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dağların otlağı onun otlağıdır.","poem":1},{"text":"Her yeşil şeyi araştırır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Yaban öküzü sana hizmet etmek ister mi?","poem":1},{"text":"Yoksa senin yemliğinin yanında kalır mı?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaban öküzünü koşum takımıyla karıkta tutabilir misin?","poem":1},{"text":"Ya da senin ardından vadileri sürer mi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gücü büyük olduğu için ona güvenir misin?","poem":1},{"text":"Ya da kendi işini ona bırakır mısın?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tohumunu eve getireceğine,","poem":1},{"text":"harman yerinin buğdayını toplayacağına güvenir misin?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Devekuşunun kanatları gururla dalgalanır,","poem":1},{"text":"ama bunlar tüyler ve sevgi tüyleri midir?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü yumurtalarını yere bırakır,","poem":1},{"text":"onları toz içinde ısıtır,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ve ayağın onları ezebileceğini,","poem":1},{"text":"ya da vahşi hayvanın onları çiğneyebileceğini unutur.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yavrularına sert davranır, sanki kendisinin değillermiş gibi.","poem":1},{"text":"Boşa çabalasa da korkusuzdur.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü Tanrı ondan bilgeliği esirgemiş,","poem":1},{"text":"ve anlayışta ona pay vermemiştir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kendini kaldırıp yükselttiğinde,","poem":1},{"text":"atı ve binicisini küçümser.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Ata sen mi güç verdin?","poem":1},{"text":"Dalgalanan yeleyi boynuna sen mi giydirdin?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Onu çekirge gibi sıçratan sen misin?","poem":1},{"text":"Onun kişnemesinin görkemi korkunçtur.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Vadide yeri eşeler ve gücüyle sevinir.","poem":1},{"text":"Silahlı adamları karşılamaya çıkar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Korkuyla alay eder, yılmaz,","poem":1},{"text":"kılıç önünden geri dönmez.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ona karşı ok kılıfı,","poem":1},{"text":"parlayan mızrak ve kargı şakırdar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yeri şiddetle ve öfkeyle yer,","poem":1},{"text":"boru sesine bile durmaz.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Boru çaldıkça, 'Hih!' diye kişner.","poem":1},{"text":"Savaşın kokusunu uzaktan alır,","poem":2},{"lineBreak":true},{"text":"komutanların gürleyen sesini ve bağrışmalarını duyar.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“Atmaca senin bilgeliğinle mi süzülüyor,","poem":1},{"text":"kanatlarını güneye doğru geriyor?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kartal senin buyruğunla mı yükseliyor da,","poem":1},{"text":"yuvasını yükseklerde yapıyor?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sarp kaya üzerinde oturuyor ve yuvasını yapıyor,","poem":1},{"text":"uçurumun ucunda ve sığınakta.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Avını oradan gözetler.","poem":1},{"text":"Gözleri onu uzaktan görür.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Onun yavruları da kan emer.","poem":1},{"text":"Leş neredeyse, o da oradadır.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}