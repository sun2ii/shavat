{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Temanlı Elifaz şöyle karşılık verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Eğer birisi seninle konuşmaya kalkışırsa kederlenir misin?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"İşte, birçok insana sen ders verdin,","poem":1},{"text":"zayıf elleri güçlendirdin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senin sözlerin düşene destek oldu,","poem":1},{"text":"güçsüz dizleri sağlamlaştırdın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama şimdi sana gelince sen bitkin düştün.","poem":1},{"text":"Sana dokununca rahatsız oldun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Senin güvendiğin kendi dindarlığın değil mi?","poem":1},{"text":"Umudun kendi yollarının doğruluğu değil mi?”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Şimdi hatırla, kim suçsuz olup mahvoldu?","poem":1},{"text":"Ya da dürüstler nerede kesilip atıldı?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Benim gördüğüme göre, kötülük sürenler","poem":1},{"text":"ve sıkıntı ekenler, onu biçiyorlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanrı'nın soluğuyla mahvoluyorlar.","poem":1},{"text":"Öfkesinin soluğuyla yok oluyorlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aslanın kükremesi,","poem":1},{"text":"kızgın aslanın sesi,","poem":2},{"lineBreak":true},{"text":"genç aslanların dişleri kırıldı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaşlı aslan av eksikliğinden yok oluyor.","poem":1},{"text":"Dişi aslanın yavruları dağılıyor.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Şimdi gizlice bana bir şey getirildi.","poem":1},{"text":"Ondan kulağım bir fısıltı aldı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gece görümlerinden gelen düşünceler içinde,","poem":1},{"text":"insanların üzerine derin uyku çöktüğünde,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"üzerime korku ve titreme geldi,","poem":1},{"text":"bütün kemiklerimi titretti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O zaman önümden bir ruh geçti.","poem":1},{"text":"Bedenimin tüyleri ürperdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yerinde durdu, ama görünüşünü seçemedim.","poem":1},{"text":"Gözlerimin önünde bir suret vardı.","poem":2},{"lineBreak":true},{"text":"Sessizlik oldu, o zaman bir ses duydum, şöyle diyordu:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ölümlü insan Tanrı'dan daha adil olur mu?","poem":1},{"text":"İnsan kendi Yaratıcısı'ndan daha temiz olur mu?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İşte, hizmetkârlarına güvenmiyor.","poem":1},{"text":"Meleklerini hatayla suçluyor.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Çamurdan evlerde oturanlar,","poem":1},{"text":"temelleri toprakta olanlar,","poem":2},{"lineBreak":true},{"text":"Güveden önce ezilenler ne kadar da çok!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sabah ile akşam arasında harap olurlar.","poem":1},{"text":"Kimse farkına varmadan sonsuza dek yok olurlar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"İçlerindeki çadır ipleri çekilip alınmıyor mu?","poem":1},{"text":"Ölüyorlar, ama bilgelik olmadan.'”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}