{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Yine Yahve İyov'a yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“İtiraz eden adam Her Şeye Gücü Yeten'le çekişsin mi?","poem":1},{"text":"Tanrı'ya itiraz eden yanıt versin.”","poem":2}]},{"type":"verse","number":3,"content":["O zaman İyov Yahve'ye yanıt verdi:"]},{"type":"verse","number":4,"content":[{"text":"“İşte, ben değersizim. Sana ne yanıt vereyim?","poem":1},{"text":"Elimi ağzıma koyuyorum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bir kez konuştum, yanıt vermem;","poem":1},{"text":"evet, ikinci kez, artık söylemem.”","poem":2}]},{"type":"verse","number":6,"content":["O zaman Yahve kasırganın içinden İyov'a yanıt verdi:"]},{"type":"verse","number":7,"content":[{"text":"“Şimdi adam gibi beline kuşağını vur.","poem":1},{"text":"Sana sorayım da, bana yanıt ver.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hükmümü dahi iptal mi edeceksin?","poem":1},{"text":"Haklı çıkmak için beni suçlu mu çıkaracaksın?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoksa senin Tanrı gibi kolun mu var?","poem":1},{"text":"O'nun gibi bir sesle gürleyebilir misin?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Şimdi kendini şan ve şerefle süsle.","poem":1},{"text":"Yücelik ve heybet giy.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Öfkenin hiddetini dök.","poem":1},{"text":"Her kibirliye bakıp onu alçalt.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Her kibirliye bakıp onu aşağıya indir.","poem":1},{"text":"Kötüleri yerlerinde ez.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onları birlikte toprağa sakla.","poem":1},{"text":"Yüzlerini gizli yerde bağla.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"O zaman sağ elinin seni kurtarabileceğini","poem":1},{"text":"ben de kabul ederim.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Şimdi seninle birlikte yarattığım behemota bak.","poem":1},{"text":"Öküz gibi ot yer.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İşte gücü belindedir.","poem":1},{"text":"Kuvveti karnının kaslarında.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuyruğunu sedir ağacı gibi oynatır.","poem":1},{"text":"Butlarının sinirleri birbirine kenetlenmiştir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kemikleri tunç borular gibidir.","poem":1},{"text":"Kaburgaları demir çubuklar gibi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tanrı usullerinin başıdır o.","poem":1},{"text":"Onu yaratan ona kılıcını vermiştir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gerçekten dağlar ona yiyecek üretir,","poem":1},{"text":"kırın bütün hayvanları orada oynaşır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nilüfer ağaçlarının altında,","poem":1},{"text":"kamışların örtüsünde, bataklıkta yatar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nilüferler onu gölgeleriyle örter,","poem":1},{"text":"derenin söğütleri onu çevreler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İşte, ırmak taşsa bile, o ürkmez.","poem":1},{"text":"Yarden onun ağzına kadar taşsa bile, o emindir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"O gözetlerken biri onu tutar mı,","poem":1},{"text":"ya da tuzakla burnunu deler mi?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}