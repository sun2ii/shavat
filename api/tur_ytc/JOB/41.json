{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“Levyatan’ı","poem":1},{"noteId":16},{"text":"çengelle çekebilir misin,","poem":1},{"text":"ya da onun dilini bağla bastırabilir misin?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Burnuna ip takabilir misin,","poem":1},{"text":"ya da çenesini kancayla delebilir misin?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sana çok yalvarır mı,","poem":1},{"text":"ya da sana tatlı sözler söyler mi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seninle bir antlaşma yapar mı ki,","poem":1},{"text":"onu daima hizmetkâr olarak alasın?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onunla kuşla oynar gibi oynar mısın?","poem":1},{"text":"Ya da onu kızların için bağlar mısın?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tacirler onun için pazarlık yapar mı?","poem":1},{"text":"Tüccarlar arasında onu pay ederler mi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Derisini kancalarla doldurabilir misin,","poem":1},{"text":"ya da başını balıkçı mızraklarıyla?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Elini onun üzerine koy.","poem":1},{"text":"Savaşı hatırla ve bir daha yapma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"İşte, ona olan umut boşunadır.","poem":1},{"text":"Biri onu görünce de yıkılmaz mı?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hiç kimse onu kışkırtmaya cürret edecek kadar sert değildir.","poem":1},{"text":"Öyleyse benim önümde durabilecek olan kimdir?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bana önce kim verdi ki, ona ödeyeyim?","poem":1},{"text":"Göklerin altında olan her şey benimdir.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Onun azaları, kudretli gücü,","poem":1},{"text":"ve güzel yapısı hakkında sessiz kalmayacağım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onun dış giysisini kim çıkarabilir?","poem":1},{"text":"Çenelerinin arasına kim girebilir?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yüzünün kapılarını kim açabilir?","poem":1},{"text":"Dişlerinin çevresinde dehşet vardır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onun gururu güçlü pullardır,","poem":1},{"text":"sıkı bir mühürle birbirine kapatılmıştır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Birbirine o kadar yakındır ki,","poem":1},{"text":"aralarına hava giremez.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Birbirlerine yapışmışlardır.","poem":1},{"text":"Birbirlerine bitişmişlerdir, öyle ki, birbirlerinden ayrılamazlar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aksırması ışık saçar.","poem":1},{"text":"Gözleri sabahın göz kapakları gibidir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ağzından alevli meşaleler çıkar.","poem":1},{"text":"Ateş kıvılcımları sıçrar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Burnundan duman çıkar,","poem":1},{"text":"kamış ateşinin üzerindeki kaynayan kazan gibi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Soluğu közleri tutuşturur.","poem":1},{"text":"Ağzından alev çıkar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Boynunda güç vardır.","poem":1},{"text":"Dehşet onun önünde oynamaktadır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Etinin katmerleri birbirine yapışmıştır.","poem":1},{"text":"Üzerinde sabittirler.","poem":2},{"lineBreak":true},{"text":"Kımıldatılamazlar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yüreği taş kadar serttir,","poem":1},{"text":"evet, değirmen taşının alt taşı gibi sert.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"O kendini kaldırdığında, güçlüler korkar.","poem":1},{"text":"Onun dayağı karşısında geri çekilirler.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ona kılıçla saldıran olsa, galip gelemez;","poem":1},{"text":"ne mızrak, ne cirit, ne de kargı.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Demiri saman,","poem":1},{"text":"tuncu da çürük odun sayar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ok onu kaçıramaz.","poem":1},{"text":"Sapan taşları ona saman çöpü gibidir.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Topuzlar anız sayılır.","poem":1},{"text":"Cirit atışlarına güler.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Alt tarafları keskin çömlek parçaları gibidir,","poem":1},{"text":"harman döveni gibi çamurda iz bırakır.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Derin suyu bir kazan gibi kaynatır.","poem":1},{"text":"Denizi merhem kazanı gibi yapar.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ardından yolu parlatır.","poem":1},{"text":"İnsan derinliğin ak saçlı olduğunu sanır.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yeryüzünde korkusuz olarak yaratılmış,","poem":1},{"text":"onun bir eşi benzeri yoktur.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yüksek olan her şeyi görür.","poem":1},{"text":"O, bütün gurur oğulları üzerinde kraldır.”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Levyatan, timsah veya benzeri bir yaratığın adıdır.","reference":{"chapter":41,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}