{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“Şimdi çağır; sana yanıt verecek biri var mı?","poem":1},{"text":"Kutsallardan hangisine yöneleceksin?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü kin, akılsızı öldürür,","poem":1},{"text":"kıskançlık da saf insanı öldürür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akılsızın kök saldığını gördüm,","poem":1},{"text":"ama hemen onun meskenini lanetledim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onun çocukları güvenlikten uzaktır.","poem":1},{"text":"Kapıda ezilirler.","poem":2},{"lineBreak":true},{"text":"Onları kurtaracak kimse de yoktur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Açlar onun ürününü yer,","poem":1},{"text":"dikenlerin arasından bile alır.","poem":2},{"lineBreak":true},{"text":"Tuzak onların malları için ağzını açmıştır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü sıkıntı topraktan çıkmaz,","poem":1},{"text":"dert de yerden bitmez.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama insan sıkıntıya doğar,","poem":1},{"text":"kıvılcımların yukarı uçtuğu gibi.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ama ben Tanrı'yı arardım.","poem":1},{"text":"Davamı Tanrı'ya bırakırdım.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anlaşılmaz büyük işler yapan,","poem":1},{"text":"sayısız şaşılacak şeyler yaratan Tanrı'ya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O ki, yeryüzüne yağmur verir,","poem":1},{"text":"tarlaların üzerine su gönderir;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"böylece alçak olanları yüksek yere koyar,","poem":1},{"text":"yas tutanları güvenliğe çıkarır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kurnazların planlarını bozar,","poem":1},{"text":"öyle ki, elleri düzenlerini yapamaz.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bilgeleri kendi kurnazlıklarında yakalar;","poem":1},{"text":"kurnazların öğüdü baş aşağı gider.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gündüz karanlıkla karşılaşırlar,","poem":1},{"text":"öğleyin de gece gibi el yordamıyla dolaşırlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ama kılıçtan, onların ağızlarından,","poem":1},{"text":"yoksulu güçlünün elinden kurtarır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Böylece yoksulun umudu olur,","poem":1},{"text":"adaletsizlik de ağzını kapatır.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“İşte, Tanrı'nın terbiye ettiği adam mutludur.","poem":1},{"text":"Bu yüzden Her Şeye Gücü Yeten'in terbiyesini hor görme.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü O incitir ve O sarar.","poem":1},{"text":"O yaralar, O'nun elleri iyileştirir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Seni altı sıkıntı içinde kurtaracak,","poem":1},{"text":"evet, yedisinde sana kötülük dokunmayacak.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kıtlıkta seni ölümden,","poem":1},{"text":"savaşta kılıcın gücünden kurtaracak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dilin kamçısından saklı kalacaksın,","poem":1},{"text":"yıkım gelince ondan korkmayacaksın.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yıkıma ve kıtlığa güleceksin,","poem":1},{"text":"yeryüzünün hayvanlarından korkmayacaksın.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü kırın taşlarıyla dost olacaksın.","poem":1},{"text":"Kırın hayvanları seninle barış içinde olacak.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çadırının barış içinde olduğunu bileceksin.","poem":1},{"text":"Ağılını ziyaret edeceksin ve hiçbir eksiğin olmayacak.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ve soyunun büyük olacağını,","poem":1},{"text":"soyunun","poem":2},{"noteId":3},{"text":"yeryüzünün otu gibi olacağını bileceksin.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tam ihtiyarlıkta mezarına geleceksin,","poem":1},{"text":"tıpkı mevsiminde gelen başak gibi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İşte, araştırdık. Böyledir.","poem":1},{"text":"Bunu işit de, kendi iyiliğin için bil.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"veya tohum","reference":{"chapter":5,"verse":25}}]},"thisChapterLink":"/api/tur_ytc/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}