{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["O zaman İyov şöyle karşılık verdi,"]},{"type":"verse","number":2,"content":[{"text":"“Keşke sıkıntım tartılsa,","poem":1},{"text":"bütün felaketim de teraziye konsa!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü şimdi deniz kumundan daha ağır olurdu,","poem":1},{"text":"bu yüzden sözlerim düşüncesizce oldu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Her Şeye Gücü Yeten’in okları içimde.","poem":1},{"text":"Ruhum onların zehirini içiyor.","poem":2},{"text":"Tanrı’nın dehşetleri bana karşı dizildiler.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eşek otu varken anırır mı?","poem":1},{"text":"Ya da öküz yeminin üzerine böğürür mü?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tadı olmayan şey tuzsuz yenir mi?","poem":1},{"text":"Ya da yumurtanın beyazında tat var mı?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Canım onlara dokunmayı reddediyor.","poem":1},{"text":"Onlar benim için iğrenç bir yiyecek gibidir.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Keşke yerine gelse,","poem":1},{"text":"özlediğim şeyi Tanrı verse,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanrı beni ezmeyi hoş görse,","poem":1},{"text":"elini serbest bıraksa da, beni kesip atsa!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bu benim tesellim olsun,","poem":1},{"text":"evet, esirgemeyen acının içinde sevineyim,","poem":2},{"lineBreak":true},{"text":"Kutsal Olan'ın sözlerini inkâr etmedim diye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gücüm nedir ki, bekleyeyim?","poem":1},{"text":"Sonum nedir ki, sabredeyim?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gücüm taşların gücü müdür?","poem":1},{"text":"Ya da etim tunçtan mıdır?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kendime yardımım yok mu,","poem":1},{"text":"bilgelik benden uzaklaştırıldı?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Bayılmaya hazır olana, dostundan şefkât gerek;","poem":1},{"text":"Yüce Olan'ın korkusunu terk etse bile.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kardeşlerim aldatıcı bir dere gibi,","poem":1},{"text":"geçip giden derelerin kanalı gibi davrandılar;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"o dereler ki, buz yüzünden karanlıktır,","poem":1},{"text":"kar onların içinde saklanır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kurak mevsimde yok olurlar.","poem":1},{"text":"Sıcak olduğunda yerlerinden tükenirler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yanlarında seyahat eden kervanlar sapar.","poem":1},{"text":"Çöle çıkarlar ve yok olurlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tema kervanları baktılar.","poem":1},{"text":"Şeba yolcuları onları bekliyorlar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Güvenmiş oldukları için sıkıntıya düştüler.","poem":1},{"text":"Oraya vardıklarında şaşkına döndüler.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü şimdi siz bir hiç oldunuz.","poem":1},{"text":"Bir dehşet görüyorsunuz ve korkuyorsunuz.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hiç, 'Bana verin'","poem":1},{"text":"ya da, 'Malınızdan bana bir armağan verin' dedim mi?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ya da, 'Beni düşmanın elinden kurtarın' dedim mi?","poem":1},{"text":"Ya da, 'Zulmedenlerin elinden beni kurtarın' dedim mi?”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Bana öğretin de susayım.","poem":1},{"text":"Bana hatamı anlatın.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Doğruluk sözleri ne kadar da güçlüdür!","poem":1},{"text":"Ama azarlamanız neyi azarlıyor?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Çaresizin sözleri rüzgâr gibi olduğundan,","poem":1},{"text":"sözleri mi azarlamayı düşünüyorsunuz?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Evet, yetimler için kura çekerdiniz,","poem":1},{"text":"dostunuz için de pazarlık ederdiniz.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Şimdi lütfedip bana bakın,","poem":1},{"text":"çünkü kesinlikle yüzünüze karşı yalan söylemeyeceğim.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lütfen geri dönün.","poem":1},{"text":"Haksızlık olmasın.","poem":2},{"lineBreak":true},{"text":"Evet, geri dönün.","poem":2},{"lineBreak":true},{"text":"Benim davam doğrudur.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dilimde haksızlık var mı?","poem":1},{"text":"Damağım kötü şeyleri ayırt etmez mi?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}