{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“Yeryüzünde insan zorla çalıştırılmıyor mu?","poem":1},{"text":"Günleri ücretli bir işçinin günleri gibi değil midir?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gölgeyi içtenlikle arzulayan bir hizmetçi,","poem":1},{"text":"ücretini arayan bir ücretli gibi,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Böylece sefalet ayları bana mülk edindirildi,","poem":1},{"text":"benim için yorucu geceler belirlendi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yattığımda, ‘Ne zaman kalkacağım ve gece geçecek?’ diyorum.","poem":1},{"text":"Gün doğana dek dönüp duruyorum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Etim kurtlarla ve topraktan kabuklarla kaplı.","poem":1},{"text":"Derim kapanıyor ve yine açılıyor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Günlerim dokumacının mekiğinden daha hızlı,","poem":1},{"text":"umutsuz bir şekilde tükeniyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hayatımın bir soluk olduğunu hatırla.","poem":1},{"text":"Gözüm artık iyilik görmeyecek.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Beni görmekte olanın gözü artık beni görmeyecek.","poem":1},{"text":"Senin gözlerin üzerimde olacak, ama ben olmayacağım.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bulut nasıl dağılıp yok olursa,","poem":1},{"text":"Şeol'e","poem":2},{"noteId":4},{"text":"inen de bir daha çıkamaz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Artık evine dönmeyecek,","poem":1},{"text":"yeri de onu tanımaz olacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bu yüzden susmayacağım.","poem":1},{"text":"Ruhumun sıkıntısıyla konuşacağım.","poem":2},{"lineBreak":true},{"text":"Canımın acılığıyla yakınacağım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ben deniz miyim ya da deniz canavarı mıyım ki,","poem":1},{"text":"üzerime bekçi koydun?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yatağım beni rahatlatacak,","poem":1},{"text":"döşeğim yakınmamı hafifletecek dediğimde,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"o zaman beni düşlerle korkutuyor,","poem":1},{"text":"Görümlerle dehşete düşürüyorsun.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Böylece canım boğulmayı,","poem":1},{"text":"kemiklerimden daha çok ölümü seçiyor.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hayatımdan nefret ediyorum.","poem":1},{"text":"Sonsuza dek yaşamak istemiyorum.","poem":2},{"lineBreak":true},{"text":"Beni tek başıma bırak, çünkü günlerim bir soluktan ibaret.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"İnsan nedir ki, onu büyütesin,","poem":1},{"text":"düşünceni onunla meşgul edesin,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"her sabah onu ziyaret edip","poem":1},{"text":"her an onu sınayasın?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne zamana dek benden gözünü ayırmayacaksın,","poem":1},{"text":"tükürüğümü yutuncaya dek beni tek başıma bırakmayacaksın?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Eğer günah işlediysem, sana ne yaptım, ey insan gözcüsü?","poem":1},{"text":"Neden beni kendine hedef koydun,","poem":2},{"lineBreak":true},{"text":"böylece ben kendime yük oldum?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neden itaatsizliğimi bağışlamıyor, suçumu ortadan kaldırmıyorsun?","poem":1},{"text":"Çünkü şimdi toprak içinde yatacağım.","poem":2},{"lineBreak":true},{"text":"Beni gayretle arayacaksın, ama ben olmayacağım.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":7,"verse":9}}]},"thisChapterLink":"/api/tur_ytc/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}