{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["O zaman Şuahlı Bildad şöyle karşılık verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Ne zamana dek bu şeyleri söyleyeceksin?","poem":1},{"text":"Ağzının sözleri güçlü bir rüzgâr mı olacak?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tanrı adaleti mi saptırıyor?","poem":1},{"text":"Yoksa Her Şeye Gücü Yeten doğruluğu mu saptırıyor?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çocukların O'na karşı günah işlediyse,","poem":1},{"text":"onları itaatsizliklerinin eline teslim etti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eğer Tanrı'yı gayretle aramak istiyorsan,","poem":1},{"text":"yakarışını Her Şeye Gücü Yeten'e yap.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eğer sen temiz ve doğru olsaydın,","poem":1},{"text":"O kesinlikle şimdi senin için uyanırdı","poem":2},{"lineBreak":true},{"text":"ve doğruluğunun meskenini başarılı kılardı.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Başlangıcın küçük olsa da,","poem":1},{"text":"sonun çok büyük olacak.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Lütfen geçmiş kuşaklara sor.","poem":1},{"text":"Atalarının ne öğrendiğini bulup çıkar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"(Çünkü biz daha dününkileriz,","poem":1},{"text":"bir şey de bilmiyoruz,","poem":2},{"lineBreak":true},{"text":"Çünkü yeryüzündeki günlerimiz bir gölgedir.)","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sana öğretmezler mi, anlatmazlar mı,","poem":1},{"text":"yüreklerinden sözler söylemezler mi?”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Papirüs bataklık olmadan büyür mü?","poem":1},{"text":"Sazlar susuz büyür mü?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Henüz yeşilken, kesilmeden,","poem":1},{"text":"her kamıştan önce kurur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tanrı'yı unutanların hepsinin yolları böyledir.","poem":1},{"text":"Tanrısız adamın umudu yok olur,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"güvendiği şey paramparça olur,","poem":1},{"text":"güvendiği bir örümcek ağıdır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Evine yaslanır, ama o ayakta durmaz.","poem":1},{"text":"Ona yapışır, ama o dayanmaz.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Güneşin önünde o yeşildir,","poem":1},{"text":"Filizleri bahçesinin üzerine uzanır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kökleri kaya yığınına sarılmıştır.","poem":1},{"text":"Taşların yerini görür.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eğer yerinden yıkılırsa,","poem":1},{"text":"o zaman o yer onu inkâr edecek ve 'Seni görmedim' diyecektir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İşte, O'nun yolunun sevinci budur.","poem":1},{"text":"Yeryüzünden başkaları çıkacaktır.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“İşte, Tanrı kusursuz bir adamı kendisinden atmayacak,","poem":1},{"text":"kötülük yapanlara destek olmayacaktır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Senin ağzını gülüşle,","poem":1},{"text":"dudaklarını haykırışla dolduracaktır.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Senden nefret edenler utançla örtülecek.","poem":1},{"text":"Kötülerin çadırı artık olmayacaktır.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}