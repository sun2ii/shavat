{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOB","translationId":"tur_ytc","name":"İYOV","commonName":"İYOV","title":"İYOV","order":18,"numberOfChapters":42,"sha256":"71d8bcbd4c080a2483c448d0f4230b2d596ca01e807ffe0539b4bbb6f651008c","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tur_ytc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["İyov şöyle yanıt verdi:"]},{"type":"verse","number":2,"content":[{"text":"“Gerçekten bilirim ki, öyledir,","poem":1},{"text":"ama insan Tanrı'ya karşı nasıl haklı olabilir?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eğer onunla çekişmek istese,","poem":1},{"text":"binde bir bile O'na yanıt veremez.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tanrı yüreğinde bilge, kudretinde güçlüdür.","poem":1},{"text":"O'na karşı kim kendini katılaştırdı da başarılı oldu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dağları yerinden oynatır, ama onlar bunu anlamazlar,","poem":1},{"text":"öfkesiyle onları devirdiğinde.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeryüzünü yerinden oynatır.","poem":1},{"text":"onun direkleri titrer.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Güneşe buyruk verir, o da doğmaz,","poem":1},{"text":"ve yıldızları mühürler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tek başına gökleri gerer","poem":1},{"text":"ve denizin dalgaları üzerinde yürür.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayı'yı, Oriyon'u ve Ülker'i,","poem":1},{"text":"güneyin odalarını yapan O'dur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Keşfedilemez büyük şeyler yapan,","poem":1},{"text":"evet, sayısız şaşılacak şeyler yapan O'dur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İşte yanımdan geçer, ama O'nu görmem.","poem":1},{"text":"Geçip gider, ama O'nu fark etmem.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İşte kapar götürür.","poem":1},{"text":"O'na kim engel olabilir?","poem":2},{"lineBreak":true},{"text":"Kim O'na, ‘Ne yapıyorsun?’ diye sorabilir?”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Tanrı öfkesini geri çekmeyecek.","poem":1},{"text":"Rahav’ın yardımcıları O'nun altında eğilecekler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nerede kaldı ki, ben O'na yanıt vereyim,","poem":1},{"text":"ve O'nunla çekişmek için sözlerimi seçeyim?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haklı olsam bile, yine de O'na yanıt vermezdim.","poem":1},{"text":"Hâkimime yalvarırdım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eğer çağırmış olsaydım ve bana yanıt vermiş olsaydı,","poem":1},{"text":"yine de sesime kulak verdi diye inanmazdım.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü beni fırtınayla kırıyor,","poem":1},{"text":"sebepsiz yere yaralarımı çoğaltıyor.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nefes almama izin vermiyor,","poem":1},{"text":"ama beni acıya doyuruyor.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Eğer güç meselesiyse, işte, O kudretlidir!","poem":1},{"text":"Eğer adalet meselesiyse,","poem":2},{"lineBreak":true},{"text":"O der ki, 'Kim beni çağıracak?'","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ben doğru olsam da,","poem":1},{"text":"kendi ağzım beni mahkûm edecektir.","poem":2},{"lineBreak":true},{"text":"Suçsuz olsam da, beni çarpık çıkaracaktır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ben suçsuzum.","poem":1},{"text":"Kendimi saymıyorum.","poem":2},{"lineBreak":true},{"text":"Hayatımı hor görüyorum.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Hepsi aynı.","poem":1},{"text":"Bu yüzden diyorum ki, suçsuzu da kötüyü de yok ediyor.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Eğer bela birden bire öldürürse,","poem":1},{"text":"masumun denenmesiyle alay edecektir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yeryüzü kötülerin eline verilmiş.","poem":1},{"text":"Hâkimlerinin yüzlerini örten O'dur.","poem":2},{"lineBreak":true},{"text":"Eğer O değilse, kimdir?”","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“Şimdi günlerim bir koşucudan daha hızlı.","poem":1},{"text":"İyilik görmeden kaçmaktalar.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hızlı gemiler gibi,","poem":1},{"text":"avına saldıran kartal gibi geçip gittiler.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Eğer 'Yakınmamı unutacağım,","poem":1},{"text":"üzgün yüzümü değiştirip neşeleneceğim' desem,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"bütün acılarımdan korkarım.","poem":1},{"text":"Beni suçsuz saymayacağını bilirim.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mahkûm olacağım.","poem":1},{"text":"Öyleyse neden boşuna çabalıyorum?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Eğer karla yıkansam,","poem":1},{"text":"ellerimi kül suyuyla temizlesem de,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yine beni pislik çukuruna daldırırsın.","poem":1},{"text":"Kendi giysilerim benden nefret eder.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Çünkü O benim gibi insan değil ki, O'na yanıt vereyim,","poem":1},{"text":"birlikte yargıya gireyim.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Aramızda bir hakem yok ki,","poem":1},{"text":"elini ikimizin üzerine koysun.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Değneğini benden çeksin.","poem":1},{"text":"O'nun dehşeti beni korkutmasın;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"o zaman konuşurdum ve O'ndan korkmazdım;","poem":1},{"text":"çünkü böyle ben kendimde değilim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}