{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOL","translationId":"tur_ytc","name":"YOEL","commonName":"YOEL","title":"YOEL","order":29,"numberOfChapters":3,"sha256":"20ccb4ca970152ac0de95a1a41879106ccb05026c1646c53199f36024d57f336","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tur_ytc/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Petuel oğlu Yoel'e gelen Yahve'nin",{"noteId":0},"sözü."]},{"type":"verse","number":2,"content":[{"text":"Ey ihtiyarlar,","poem":1},{"text":"duyun bunu, memleketin bütün sakinleri dinleyin!","poem":2},{"text":"Sizin günlerinizde ya da atalarınızın günlerinde","poem":1},{"text":"hiç böylesi oldu mu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çocuklarınıza bunu anlatın,","poem":1},{"text":"çocuklarınız kendi çocuklarına,","poem":2},{"lineBreak":true},{"text":"onların çocukları da başka kuşaklara anlatsınlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çekirgenin bıraktığını büyük çekirge yedi.","poem":1},{"text":"Büyük çekirgenin bıraktığını küçük çekirge yedi.","poem":2},{"lineBreak":true},{"text":"Onun bıraktığını tırtıl yedi.","poem":2}]},{"type":"verse","number":5,"content":["Ey sarhoşlar, ayılın da ağlayın!",{"text":"Ey şarap içenler, hepiniz, tatlı şarap yüzünden yas tutun,","poem":2},{"lineBreak":true},{"text":"çünkü ağzınızdan kesildi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü ülkemin üzerine güçlü ve sayılamaz bir ulus çıktı.","poem":1},{"text":"Onun dişleri aslan dişleri,","poem":2},{"lineBreak":true},{"text":"onda dişi aslan azı dişleri var.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asmamı harap etti,","poem":1},{"text":"incir ağacımı soydu.","poem":2},{"lineBreak":true},{"text":"Kabuğunu soyup attı.","poem":2},{"lineBreak":true},{"text":"Dalları ağardı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gençliğinin kocası için çul giymiş","poem":1},{"text":"el değmemiş bir kız gibi yas tut!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve'nin evinden ekmek sunusu ve dökmelik sunu kesildi.","poem":1},{"text":"Yahve'nin hizmetkârları olan kâhinler yas tutuyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarla harap oldu.","poem":1},{"text":"Toprak yas tutuyor, çünkü buğday yok oldu,","poem":2},{"lineBreak":true},{"text":"yeni şarap kurudu, yağ cılızlaştı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey çiftçiler, utanın!","poem":1},{"text":"Ey bağcılar, buğday ve arpa için ağıt yakın;","poem":2},{"lineBreak":true},{"text":"çünkü tarlanın ürünü yok oldu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asma kurudu, incir ağacı kurudu;","poem":1},{"text":"nar ağacı, palmiye ağacı da, elma ağacı,","poem":2},{"lineBreak":true},{"text":"tarlanın bütün ağaçları kurudu;","poem":2},{"lineBreak":true},{"text":"çünkü sevinç insanoğullarından kayboldu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ey kâhinler, çul giyin ve yas tutun!","poem":1},{"text":"Ey sunak hizmetkârları, ağıt yakın.","poem":2},{"text":"Ey Tanrım'ın","poem":1},{"noteId":1},{"text":"hizmetkârları gelin, bütün gece çulda yatın,","poem":1},{"text":"çünkü Tanrınız'ın evinden ekmek sunusu ve dökmelik sunu kesildi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Orucu kutsal sayın.","poem":1},{"text":"Toplantıya çağırın.","poem":2},{"lineBreak":true},{"text":"Yaşlıları ve ülkenin bütün sakinlerini Tanrınız Yahve'nin evine toplayın da","poem":2},{"lineBreak":true},{"text":"Yahve'ye feryat edin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vay o güne!","poem":1},{"text":"Çünkü Yahve'nin günü yakındır,","poem":2},{"lineBreak":true},{"text":"Her Şeye Gücü Yeten'den bir yıkım gelecek.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gözlerimizin önünden yiyecek,","poem":1},{"text":"Tanrımız'ın evinden sevinç ve neşe kesilmedi mi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tohumlar toprak kesikleri altında çürüyor.","poem":1},{"text":"Tahıl ambarları boş kalıyor.","poem":2},{"lineBreak":true},{"text":"Ambarlar yıkılıyor, çünkü buğday kalmadı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hayvanlar nasıl inliyor!","poem":1},{"text":"Sığır sürüleri şaşkın, çünkü otlakları yok.","poem":2},{"lineBreak":true},{"text":"Koyun sürüleri de perişan oldu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ey Yahve, sana feryat ediyorum,","poem":1},{"text":"çünkü ateş çölün otlaklarını yiyip bitirdi,","poem":2},{"lineBreak":true},{"text":"alev de bütün kır ağaçlarını yaktı.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Evet, kırın hayvanları soluyarak sana sesleniyor,","poem":1},{"text":"çünkü derelerin suyu kurudu,","poem":2},{"lineBreak":true},{"text":"ateş de çölün otlaklarını yiyip bitirdi.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}