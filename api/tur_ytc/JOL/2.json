{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOL","translationId":"tur_ytc","name":"YOEL","commonName":"YOEL","title":"YOEL","order":29,"numberOfChapters":3,"sha256":"20ccb4ca970152ac0de95a1a41879106ccb05026c1646c53199f36024d57f336","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tur_ytc/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Siyon'da boru çalın,","poem":1},{"text":"kutsal dağımda uyarı sesi verin!","poem":2},{"text":"Ülkenin bütün sakinleri titresin,","poem":1},{"text":"çünkü Yahve'nin günü geliyor,","poem":2},{"lineBreak":true},{"text":"çünkü yakındır:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Karanlık ve kasvet günü, bulut ve koyu karanlık günü.","poem":1},{"lineBreak":true},{"text":"Dağlara yayılan şafak gibi, büyük ve güçlü bir halk;","poem":1},{"text":"benzeri hiç olmadı,","poem":2},{"lineBreak":true},{"text":"onlardan sonra da çok kuşakların yıllarında bir daha olmayacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Önlerinde ateş yiyip bitiriyor,","poem":1},{"text":"arkalarında alev yakıyor.","poem":2},{"text":"Ülke önlerinde Aden bahçesi gibi,","poem":1},{"text":"arkalarında ıssız bir çöl.","poem":2},{"text":"Evet, onlardan kaçıp kurtulan kimse de yok.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Görünüşleri atların görünümü gibi,","poem":1},{"text":"atlılar gibi de koşuyorlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dağların tepelerinde savaş arabalarının gürültüsü gibi,","poem":1},{"text":"anızı yiyip bitiren ateş alevinin gürültüsü gibi,","poem":2},{"lineBreak":true},{"text":"savaş düzenine girmiş güçlü bir halk gibi sıçrıyorlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onların karşısında halklar sıkıntı içindeler.","poem":1},{"text":"Bütün yüzler soluyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yiğitler gibi koşuyorlar.","poem":1},{"text":"Savaşçılar gibi sura tırmanıyorlar.","poem":2},{"lineBreak":true},{"text":"Her biri kendi safında yürüyor ve sırasından sapmıyor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Birbirini itmiyorlar.","poem":1},{"text":"Her biri kendi yolunda yürüyor.","poem":2},{"lineBreak":true},{"text":"Savunmaları deliyorlar,","poem":2},{"lineBreak":true},{"text":"ama saflarını bozmuyorlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kente hücum ediyorlar.","poem":1},{"text":"Sur üzerinde koşuyorlar.","poem":2},{"lineBreak":true},{"text":"Evlerin içine tırmanıyorlar.","poem":2},{"lineBreak":true},{"text":"Hırsızlar gibi pencerelerden giriyorlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yer önlerinde sarsılıyor.","poem":1},{"text":"Gökler titriyor.","poem":2},{"lineBreak":true},{"text":"Güneş ve ay kararıyor,","poem":2},{"lineBreak":true},{"text":"yıldızlar da ışıltılarını geri çekiyor.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve ordusunun önünde sesiyle gürlüyor,","poem":1},{"text":"çünkü O'nun güçleri çok büyüktür;","poem":2},{"lineBreak":true},{"text":"çünkü O'nun buyruğuna uyan O, güçlüdür;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'nin günü büyük ve çok korkunçtur,","poem":2},{"lineBreak":true},{"text":"ve buna kim dayanabilir?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Şimdi bile” diyor Yahve,","poem":1},{"text":"“Bütün yüreğinizle, oruçla, ağlayışla ve yasla bana dönün.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Giysilerinizi değil, yüreğinizi yırtın","poem":1},{"text":"ve Tanrınız Yahve'ye dönün;","poem":2},{"lineBreak":true},{"text":"çünkü O lütufkârdır, merhametlidir,","poem":2},{"lineBreak":true},{"text":"Öfkelenmekte yavaştır, sevgi dolu iyiliği boldur","poem":2},{"lineBreak":true},{"text":"ve felaket göndermekten vazgeçer.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kim bilir? Belki döner de vazgeçer ve arkasında bereket,","poem":1},{"text":"Tanrınız Yahve için bir ekmek sunusu ve dökmelik sunu bırakır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Siyon'da boru çalın!","poem":1},{"text":"Orucu kutsal kılın.","poem":2},{"lineBreak":true},{"text":"Toplantıya çağırın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Halkı toplayın.","poem":1},{"text":"Toplantıyı kutsayın.","poem":2},{"lineBreak":true},{"text":"İhtiyarları toplayın.","poem":2},{"lineBreak":true},{"text":"Çocukları ve emzikte olanları toplayın.","poem":2},{"lineBreak":true},{"text":"Güvey odasından, gelin de gerdeğinden çıksın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yahve'nin hizmetkârları olan kâhinler, eyvanla sunak arasında ağlayıp desinler,","poem":1},{"text":"“Ey Yahve, halkını esirge, kendi mirasını aşağılanmaya verme ki,","poem":2},{"lineBreak":true},{"text":"uluslar onlara hakim olmasın.","poem":2},{"text":"Halklar arasında neden ‘Onların Tanrıları nerede?’ denilsin?”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O zaman Yahve ülkesi için kıskanç oldu","poem":1},{"text":"ve halkına acıdı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahve halkına yanıt verdi:","poem":1},{"text":"“İşte,","poem":2},{"noteId":2},{"text":"sana buğday, yeni şarap ve yağ göndereceğim,","poem":2},{"lineBreak":true},{"text":"onlarla doyacaksınız;","poem":2},{"lineBreak":true},{"text":"artık sizi uluslar arasında aşağılatmayacağım.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ama kuzey ordusunu senden uzaklaştıracağım,","poem":1},{"text":"onu çorak ve ıssız bir ülkeye,","poem":2},{"lineBreak":true},{"text":"onun önünü doğu denizine,","poem":2},{"lineBreak":true},{"text":"onun arkasını batı denizine süreceğim;","poem":2},{"lineBreak":true},{"text":"ve pis kokusu yükselecek,","poem":2},{"lineBreak":true},{"text":"ve kötü kokusu yükselecek.”","poem":2},{"text":"Gerçekten o, büyük işler yaptı.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ey diyar, korkma.","poem":1},{"text":"Sevin ve coş, çünkü Yahve büyük işler yaptı.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ey kır hayvanları, korkmayın;","poem":1},{"text":"çünkü çölün otlakları yeşeriyor,","poem":2},{"lineBreak":true},{"text":"ağaç meyvesini veriyor.","poem":2},{"lineBreak":true},{"text":"İncir ağacı ve asma gücünü veriyor.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Öyleyse sevinin, ey Siyon'un çocukları,","poem":1},{"text":"ve Tanrınız Yahve'yle coşun;","poem":2},{"lineBreak":true},{"text":"çünkü size ilk yağmuru tam ölçüsünde veriyor,","poem":2},{"lineBreak":true},{"text":"ve öncesinde olduğu gibi yağmuru,","poem":2},{"lineBreak":true},{"text":"ilk yağmuru ve son yağmuru sizin için yağdırıyor.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Harman yerleri buğdayla dolacak,","poem":1},{"text":"tekneler de yeni şarap ve yağla taşacak.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Size sürüyle uçan çekirgenin,","poem":1},{"text":"büyük çekirgenin, küçük çekirgenin ve tırtılın, aranıza gönderdiğim","poem":2},{"lineBreak":true},{"text":"büyük ordumun yediği yılları geri vereceğim.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bolca yiyip doyacaksınız,","poem":1},{"text":"sizin için şaşılası şeyler yapan Tanrınız Yahve'nin adını öveceksiniz.","poem":2},{"lineBreak":true},{"text":"Halkım bir daha asla hayal kırıklığına uğramayacak.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ben'im İsrael'in arasında olduğumu,","poem":1},{"text":"Tanrınız Yahve olduğumu,","poem":2},{"lineBreak":true},{"text":"ve başka kimsenin olmadığını bileceksiniz.","poem":2},{"lineBreak":true},{"text":"Halkım bir daha asla hayal kırıklığına uğramayacak.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ondan sonra, Ruhum'u bütün insanların üzerine dökeceğim.","poem":1},{"text":"Oğullarınız ve kızlarınız peygamberlik edecek.","poem":2},{"lineBreak":true},{"text":"Yaşlılarınız düşler görecek.","poem":2},{"lineBreak":true},{"text":"Gençleriniz görümler görecek.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ve o günlerde erkek ve kadın hizmetçilerin üzerine de","poem":1},{"text":"Ruhum'u dökeceğim.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Göklerde ve yerde belirtiler göstereceğim:","poem":1},{"text":"Kan, ateş ve duman direkleri.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yahve'nin büyük ve korkunç günü gelmeden önce","poem":1},{"text":"güneş karanlığa, ay kana dönecek.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Öyle olacak ki, her kim Yahve'nin adını çağırırsa kurtulacak;","poem":1},{"text":"çünkü Yahve'nin söylediği gibi,","poem":2},{"lineBreak":true},{"text":"Siyon Dağı'nda ve Yeruşalem'de kaçıp kurtulanlar,","poem":2},{"lineBreak":true},{"text":"geride kalanlar arasında Yahve'nin çağırdığı kimseler olacak.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":2,"verse":19}}]},"thisChapterLink":"/api/tur_ytc/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}