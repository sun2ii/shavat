{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JOL","translationId":"tur_ytc","name":"YOEL","commonName":"YOEL","title":"YOEL","order":29,"numberOfChapters":3,"sha256":"20ccb4ca970152ac0de95a1a41879106ccb05026c1646c53199f36024d57f336","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tur_ytc/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"“Çünkü işte, o günlerde ve o zamanda,","poem":1},{"text":"Yahuda ve Yeruşalem'in sürgünlerini geri getirdiğimde,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"bütün ulusları toplayacağım,","poem":1},{"text":"ve onları Yehoşafat Vadisi'ne indireceğim;","poem":2},{"lineBreak":true},{"text":"ve orada halkım ve mirasım olan İsrael için, onu uluslar arasında dağıttıkları için onları yargılayacağım.","poem":2},{"lineBreak":true},{"text":"Onlar ülkemi böldüler,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ve halkım için kura çektiler,","poem":1},{"text":"ve fahişeye ücreti için erkek çocuğu verdiler,","poem":2},{"lineBreak":true},{"text":"ve içebilsinler diye şarap karşılığında bir kız sattılar.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Hem de siz benim için nesiniz,","poem":1},{"text":"ey Sur ve Sayda ve bütün Filist bölgeleri?","poem":2},{"text":"Siz bana karşılık mı ödeyeceksiniz?","poem":1},{"text":"Ve eğer bana karşılığını ödeyecek olursanız,","poem":2},{"lineBreak":true},{"text":"ben karşılığını hemen ve çabucak kendi başınıza döndüreceğim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü gümüşümü ve altınımı aldın,","poem":1},{"text":"en değerli hazinelerimi tapınaklarına götürdün,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahuda'nın çocuklarını ve Yeruşalem'in çocuklarını","poem":1},{"text":"kendi sınırlarından uzaklaştırmak için","poem":2},{"lineBreak":true},{"text":"Grekler'in oğullarına sattınız.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, onları sattığın yerden harekete geçireceğim,","poem":1},{"text":"karşılığını kendi başınıza ödeyeceğim;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"oğullarını ve kızlarını Yahuda'nın çocuklarının eline satacağım,","poem":1},{"text":"onlar da onları uzak bir ulusa, Şevalılar'a satacaklar,","poem":2},{"lineBreak":true},{"text":"çünkü Yahve böyle söyledi.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uluslar arasında şunu ilan edin:","poem":1},{"text":"“Savaşa hazırlanın!","poem":2},{"lineBreak":true},{"text":"Yiğitleri harekete geçirin.","poem":2},{"text":"Bütün savaşçılar yaklaşsın.","poem":1},{"text":"Yukarı çıksınlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sabanlarınızı kılıçlara, bağcı bıçaklarınızı mızraklara döndürün.","poem":1},{"text":"Zayıf olan, 'Ben güçlüyüm' desin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çabuk gelin, ey çevredeki uluslar, toplanın.”","poem":1},{"lineBreak":true},{"text":"Ey Yahve, yiğitlerini oraya indir.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“Uluslar harekete geçip Yehoşafat Vadisi'ne çıksınlar;","poem":1},{"text":"çünkü orada oturup çevredeki bütün ulusları yargılayacağım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Orağı sallayın,","poem":1},{"text":"çünkü hasat olgunlaştı.","poem":2},{"lineBreak":true},{"text":"Gelin, çiğneyin, çünkü şarap teknesi doldu, tekneler taşıyor,","poem":2},{"lineBreak":true},{"text":"çünkü kötülükleri büyüktür.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kalabalıklar, Karar Vadisi'nde kalabalıklar!","poem":1},{"text":"Çünkü Karar Vadisi'nde Yahve'nin günü yakındır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Güneş ve ay karardı,","poem":1},{"text":"yıldızlar da ışıltılarını geri çekti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve Siyon'dan kükreyecek, Yeruşalem'den gürleyecek;","poem":1},{"text":"gökler de yeryüzü de sarsılacak;","poem":2},{"lineBreak":true},{"text":"ama Yahve, halkına sığınak, İsrael'in çocuklarına kale olacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Böylece, kutsal dağım Siyon'da oturan","poem":1},{"text":"Tanrınız Yahve'nin Ben olduğumu bileceksiniz.","poem":2},{"text":"O zaman Yeruşalem kutsal olacak,","poem":1},{"text":"ve bir daha ondan yabancı geçmeyecek.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"O gün dağlar tatlı şarap damlatacak,","poem":1},{"text":"tepeler süt akıtacak,","poem":2},{"lineBreak":true},{"text":"Yahuda'nın bütün derelerinde sular akacak;","poem":2},{"lineBreak":true},{"text":"Yahve'nin evinden bir kaynak çıkacak,","poem":2},{"lineBreak":true},{"text":"ve Şittim Vadisi'ni sulayacak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mısır ıssız kalacak,","poem":1},{"text":"Edom da Yahuda'nın çocuklarına yaptıkları zorbalık yüzünden","poem":2},{"lineBreak":true},{"text":"ıssız bir çöl olacak, çünkü ülkelerinde suçsuz kanı döktüler.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ama Yahuda daima,","poem":1},{"text":"Yeruşalem de kuşaktan kuşağa oturulacak yer olacak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onların temizlemediğim kanlarını temizleyeceğim,","poem":1},{"text":"çünkü Yahve Siyon'da oturuyor.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}