{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"JON","translationId":"tur_ytc","name":"YONA","commonName":"YONA","title":"YONA","order":32,"numberOfChapters":4,"sha256":"321bb6a9bc49de0278f4a887b844317931fe11867ed064b5c3d6678de98a5f2d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tur_ytc/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["O zaman Yona, balığın karnından Tanrısı Yahve'ye dua etti."]},{"type":"verse","number":2,"content":["Ve dedi:",{"text":"“Sıkıntımın içinden Yahve'yi çağırdım.","poem":1},{"text":"Bana yanıt verdi.","poem":2},{"text":"Şeol'ün","poem":1},{"noteId":4},{"text":"karnından haykırdım.","poem":1},{"text":"Sen benim sesimi duydun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü beni derinliklere,","poem":1},{"text":"denizlerin yüreğine attın.","poem":2},{"text":"Seller çevremi sardı.","poem":1},{"text":"Bütün dalgaların ve dev dalgaların üzerimden geçti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Senin gözünden kovuldum,","poem":1},{"text":"ama yine de kutsal tapınağına bakacağım' dedim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sular beni canıma kadar kuşattı.","poem":1},{"lineBreak":true},{"text":"Derinlik çevremi sardı.","poem":1},{"text":"Yosunlar başıma dolandı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dağların diplerine indim.","poem":1},{"text":"Yeryüzü bana sonsuza dek yasaklandı;","poem":2},{"lineBreak":true},{"text":"ama sen hayatımı çukurdan çıkardın, ey Tanrım Yahve.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Canım içimde bayıldığında, Yahve'yi hatırladım.","poem":1},{"text":"Duam sana, kutsal tapınağına ulaştı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Boş putlara bakanlar kendi merhametlerini terk ederler.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ama ben sana şükran sesiyle kurban sunacağım.","poem":1},{"text":"Adamış olduğumu ödeyeceğim.","poem":2},{"text":"Kurtuluş Yahve'ye aittir.”","poem":1}]},{"type":"verse","number":10,"content":["O zaman Yahve balığa konuştu ve balık Yona'yı kuru toprağa kustu."]}],"footnotes":[{"noteId":4,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":2,"verse":2}}]},"thisChapterLink":"/api/tur_ytc/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}