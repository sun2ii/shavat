{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"LAM","translationId":"tur_ytc","name":"AĞITLAR","commonName":"AĞITLAR","title":"AĞITLAR","order":25,"numberOfChapters":5,"sha256":"bf59660f9ad2dd08b8fb102110ab0d3199654753324782e9ee22d041e37c688f","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tur_ytc/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"İnsanlarla dolu olan kent,","poem":1},{"text":"nasıl da yapayalnız oturuyor!","poem":2},{"text":"Uluslar arasında büyük olan,","poem":1},{"text":"dul kadın gibi oldu!","poem":2},{"text":"Ülkeler arasında bey olan","poem":1},{"text":"Köle oldu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Geceleyin acı acı ağlıyor.","poem":1},{"text":"Gözyaşları yanaklarında.","poem":2},{"text":"Bütün sevgilileri arasında","poem":1},{"text":"onu teselli eden yok.","poem":2},{"text":"Bütün dostları ona hainlik etti.","poem":1},{"text":"Ona düşman oldular.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahuda sıkıntı çekmek,","poem":1},{"text":"ve ağır kölelik etmek için sürgüne gitti.","poem":2},{"text":"Uluslar arasında oturuyor.","poem":1},{"text":"Rahat bulamıyor.","poem":2},{"lineBreak":true},{"text":"Sıkıntısında bütün zulmedenleri ona yetişti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Siyon yolları yas tutuyor,","poem":1},{"text":"çünkü kimse kutsal toplantıya gelmiyor.","poem":2},{"text":"Bütün kapıları ıssız.","poem":1},{"text":"Kâhinleri inliyor.","poem":2},{"text":"El değmemiş kızları sıkıntıda,","poem":1},{"text":"kendisi de acı içinde.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Düşmanları baş oldu.","poem":1},{"text":"Düşmanlarının işi yolunda;","poem":2},{"text":"çünkü Yahve,","poem":1},{"noteId":0},{"text":"günahlarının çokluğu yüzünden onu sıkıntıya soktu.","poem":1},{"text":"Yavruları düşmanın önünde sürgüne gitti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siyon kızının bütün görkemi kendisinden ayrıldı.","poem":1},{"text":"Beyleri otlak bulamayan geyiklere döndüler.","poem":2},{"lineBreak":true},{"text":"Kovalayanın önünde güçsüz kaldılar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeruşalem, sıkıntı ve sefalet günlerinde,","poem":1},{"text":"eski günlerindeki bütün güzel şeylerini hatırlıyor;","poem":2},{"text":"onun halkı düşmanın eline düştüğünde ve kimse ona yardım etmediğinde,","poem":1},{"lineBreak":true},{"text":"düşmanlar onu gördüler.","poem":1},{"text":"Onun kimsesizliğiyle alay ettiler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeruşalem büyük günah işledi.","poem":1},{"text":"Bu yüzden kirli oldu.","poem":2},{"text":"Ona saygı gösterenlerin hepsi onu hor görüyor,","poem":1},{"text":"çünkü çıplaklığını gördüler.","poem":2},{"lineBreak":true},{"text":"Evet, inliyor ve arkasını dönüyor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kirliliği eteklerindeydi.","poem":1},{"text":"Kendi sonunu hatırlamadı.","poem":2},{"text":"Bu yüzden aşağı inmesi şaşılacak şeydi.","poem":1},{"text":"Teselli edeni yok.","poem":2},{"text":"“Ey Yahve, sıkıntımı gör;","poem":1},{"text":"çünkü düşman kendini yüceltti.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Düşman elini onun bütün güzel şeyleri üzerine uzattı;","poem":1},{"text":"çünkü ulusların kendi kutsal yerine girdiğini gördü,","poem":2},{"lineBreak":true},{"text":"onlar hakkında senin topluluğuna girmesinler diye buyurmuştun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bütün halkı inliyor.","poem":1},{"text":"Ekmek arıyor.","poem":2},{"lineBreak":true},{"text":"Canlarını ferahlatmak için güzel şeylerini yiyecek için verdiler.","poem":2},{"text":"“Bak, ey Yahve, ve gör,","poem":1},{"text":"çünkü sefil oldum.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Sizin için önemsiz mi bu,","poem":1},{"text":"ey bütün sizler, yoldan geçenler?","poem":2},{"lineBreak":true},{"text":"Bakın ve görün, benim başıma gelen,","poem":2},{"lineBreak":true},{"text":"Yahve'nin kızgın öfkesi gününde beni sıkıntıya soktuğu sıkıntı gibi","poem":2},{"lineBreak":true},{"text":"bir sıkıntı var mı?”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Yukarıdan kemiklerime ateş gönderdi,","poem":1},{"text":"ve onlara karşı galip geldi.","poem":2},{"text":"Ayaklarım için ağ serdi.","poem":1},{"text":"Beni geri çevirdi.","poem":2},{"lineBreak":true},{"text":"Beni harap etti ve bütün gün baygınım.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Günahlarımın boyunduruğu onun eliyle bağlandı.","poem":1},{"text":"Birbirine kenetlendiler.","poem":2},{"lineBreak":true},{"text":"Boynuma çıktılar.","poem":2},{"lineBreak":true},{"text":"Gücümü tüketti.","poem":2},{"text":"Karşı durmaya gücüm yetmeyenlerin ellerine Efendi","poem":1},{"noteId":1},{"text":"beni teslim etti.”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"“Efendi içimdeki bütün yiğitlerimi hiçe saydı.","poem":1},{"text":"Gençlerimi kırıp geçirmek için bana karşı heybetli bir topluluk çağırdı.","poem":2},{"lineBreak":true},{"text":"Efendi, Yahuda'nın el değmemiş kızını üzüm sıkma teknesinde çiğnedi.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Bunlardan dolayı ağlıyorum.","poem":1},{"text":"Gözüm, gözüm yaşlar akıtıyor,","poem":2},{"lineBreak":true},{"text":"çünkü canımı ferahlatacak olan tesellici benden uzak.","poem":2},{"lineBreak":true},{"text":"Çocuklarım harap oldu,","poem":2},{"lineBreak":true},{"text":"çünkü düşman galip geldi.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Siyon ellerini açtı.","poem":1},{"text":"Onu teselli eden yok.","poem":2},{"text":"Yahve, Yakov hakkında,","poem":1},{"text":"çevresindekiler ona düşman olsunlar diye buyurdu.","poem":2},{"lineBreak":true},{"text":"Yeruşalem onların arasında kirli bir şey oldu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Yahve adildir,","poem":1},{"text":"çünkü buyruğuna karşı isyan ettim.","poem":2},{"text":"Lütfen, ey bütün halklar,","poem":1},{"text":"dinleyin ve üzüntümü görün.","poem":2},{"lineBreak":true},{"text":"El değmemiş kızlarım ve gençlerim sürgüne gittiler.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Sevgililerimi çağırdım,","poem":1},{"text":"ama onlar beni aldattılar.","poem":2},{"text":"Canlarını tazelemek için kendilerine yiyecek ararken,","poem":1},{"text":"kâhinlerim ve ihtiyarlarım kentte ruhlarını teslim ettiler.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Bak, ey Yahve; çünkü sıkıntıdayım.","poem":1},{"text":"Yüreğim sıkılıyor.","poem":2},{"text":"Yüreğim içimde dönüyor,","poem":1},{"text":"çünkü ağır bir şekilde isyan ettim.","poem":2},{"text":"Dışarıda kılıç yoksun bırakmada.","poem":1},{"text":"Evde ölüm gibi.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“İnlediğimi duydular.","poem":1},{"text":"Beni teselli eden yok.","poem":2},{"text":"Bütün düşmanlarım sıkıntımı duydu.","poem":1},{"text":"Bunu yaptığın için seviniyorlar.","poem":2},{"text":"İlan ettiğin günü getireceksin,","poem":1},{"text":"ve onlar da benim gibi olacaklar.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Onların bütün kötülükleri senin önüne gelsin.","poem":1},{"text":"Bütün günahlarım için bana yaptığını onlara da yap.","poem":2},{"text":"Çünkü iniltilerim çok,","poem":1},{"text":"yüreğim de baygın.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/tur_ytc/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}