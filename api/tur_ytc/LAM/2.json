{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"LAM","translationId":"tur_ytc","name":"AĞITLAR","commonName":"AĞITLAR","title":"AĞITLAR","order":25,"numberOfChapters":5,"sha256":"bf59660f9ad2dd08b8fb102110ab0d3199654753324782e9ee22d041e37c688f","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tur_ytc/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Yahve öfkesiyle Siyon kızını nasıl bir bulutla örttü!",{"text":"İsrael'in güzelliğini gökten yeryüzüne indirdi,","poem":1},{"text":"öfkesi gününde ayağının taburesini hatırlamadı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve Yakov'un bütün yurtlarını acımadan yuttu.","poem":1},{"lineBreak":true},{"text":"Gazabıyla Yahuda kızının kalelerini yıktı,","poem":1},{"text":"onları yere kadar indirdi.","poem":2},{"lineBreak":true},{"text":"Krallığı ve beylerini bozdu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İsrael'in bütün boynuzunu kızgın öfkeyle kesti.","poem":1},{"text":"Sağ elini düşmanın önünden geri çekti.","poem":2},{"text":"Yakov'u her tarafını yiyip bitiren alevli ateş gibi yaktı.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Düşman gibi yayını gerdi,","poem":1},{"text":"sağ eliyle düşman gibi dikildi.","poem":2},{"text":"Göze hoş gelenlerin tümünü öldürdü.","poem":1},{"text":"Siyon kızının çadırı üzerine ateş gibi gazabını döktü.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Efendi sanki bir düşman gibi oldu.","poem":1},{"text":"İsrael'i yuttu.","poem":2},{"text":"Bütün saraylarını yuttu.","poem":1},{"text":"Kalelerini yıktı.","poem":2},{"lineBreak":true},{"text":"Yahuda kızında yas ve ağıdı artırdı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kendi çardağını,","poem":1},{"text":"bahçe çardağıymış gibi söküp attı.","poem":2},{"text":"Toplantı yerini yıktı.","poem":1},{"text":"Yahve Siyon'da kutsal toplantıyı ve Şabat'ı unutturdu.","poem":2},{"lineBreak":true},{"text":"Şiddetli öfkesiyle kralı ve kâhini hor gördü.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve sunağını kaldırıp attı.","poem":1},{"text":"Tapınağından nefret etti.","poem":2},{"text":"Yeruşalem saraylarının duvarlarını düşmanın eline verdi.","poem":1},{"text":"Yahve'nin evinde kutsal toplantı gününde olduğu gibi gürültü yaptılar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve Siyon kızının duvarını yıkmaya karar verdi.","poem":1},{"text":"İpi gerdi.","poem":2},{"lineBreak":true},{"text":"Elini yıkmaktan çekmedi;","poem":2},{"text":"siperlerle duvara ağıt yaktırdı. İkisi birlikte zayıfladılar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kapıları yere battı.","poem":1},{"text":"Kapı sürgülerini kırıp yok etti.","poem":2},{"text":"Kralı ve beyleri yasanın olmadığı uluslar arasındalar.","poem":1},{"text":"Evet, peygamberleri Yahve'den görüm bulmuyorlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Siyon kızının ihtiyarları yerde oturuyorlar.","poem":1},{"text":"Sessiz kalıyorlar.","poem":2},{"text":"Başları üzerine toprak attılar.","poem":1},{"text":"Çul giydiler.","poem":2},{"lineBreak":true},{"text":"Yeruşalem'in kızları başlarını yere eğdiler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaş dökmekten gözlerim tükendi.","poem":1},{"text":"Yüreğim sıkıntılı.","poem":2},{"text":"Halkımın kızının yıkımı yüzünden","poem":1},{"text":"Ciğerim yere döküldü,","poem":2},{"lineBreak":true},{"text":"çünkü çocuklar ve emziktekiler kentin sokaklarında bayılmakta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kent sokaklarında yaralılar gibi bayılınca,","poem":1},{"text":"canları annelerinin koynuna döküldüğü zaman,","poem":2},{"lineBreak":true},{"text":"annelerine, “Buğday ve şarap nerede?” diye soruyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sana ne tanıklık edeyim?","poem":1},{"text":"Ey Yeruşalem kızı, seni neye benzeteyim?","poem":2},{"text":"Neyi sana kıyas edeyim de,","poem":1},{"text":"teselli edeyim, ey Siyon'un el değmemiş kızı?","poem":2},{"text":"Çünkü sendeki gedik deniz kadar büyük.","poem":1},{"text":"Seni kim iyileştirebilir?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Peygamberlerin senin için sahte,","poem":1},{"text":"ve akılsızca görümler gördüler.","poem":2},{"lineBreak":true},{"text":"Senin suçunu açığa çıkarıp","poem":2},{"lineBreak":true},{"text":"sürgününü geri çevirmediler,","poem":2},{"lineBreak":true},{"text":"ama senin için sahte vahiyler ve sürgün nedenlerini gördüler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yoldan geçenlerin hepsi sana el çırpıyor.","poem":1},{"text":"Yeruşalem kızına baş sallayıp ıslık çalıyorlar,","poem":2},{"text":"“İnsanların 'Güzelliğin kusursuzluğu,","poem":1},{"text":"bütün dünyanın sevinci' dediği kent bu mu?” diyorlar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bütün düşmanların sana karşı ağızlarını kocaman açtılar.","poem":1},{"text":"Islık çalıp diş gıcırdatıyorlar.","poem":2},{"text":"Şöyle diyorlar, “Onu yuttuk. Gerçekten de beklediğimiz gün budur.","poem":1},{"text":"Onu bulduk.","poem":2},{"lineBreak":true},{"text":"Onu gördük.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yahve tasarladığını yaptı.","poem":1},{"text":"Eski günlerde buyurduğu sözünü yerine getirdi.","poem":2},{"text":"Yıktı, acımadı.","poem":1},{"lineBreak":true},{"text":"Düşmanı senin için sevindirdi.","poem":1},{"text":"Düşmanlarının boynuzunu yükseltti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yürekleri Yahve'ye feryat etti.","poem":1},{"text":"Ey Siyon kızının duvarı,","poem":2},{"lineBreak":true},{"text":"gözyaşların gece gündüz ırmak gibi aksın.","poem":2},{"text":"Rahatlama.","poem":1},{"text":"Gözlerin dinlenmesin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kalk, geceleyin, nöbetlerin başında bağır!","poem":1},{"lineBreak":true},{"text":"Yahve'nin yüzü önünde yüreğini su gibi dök.","poem":1},{"text":"Her sokak başında açlıktan bayılan çocuklarının canı için","poem":2},{"lineBreak":true},{"text":"Ellerini O'na doğru kaldır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Bak, ey Yahve, ve kime böyle yaptığını gör!","poem":1},{"text":"Kadınlar yavrularını, dizleri üzerinde tutup oynattıkları çocuklarını mı yesinler?","poem":2},{"lineBreak":true},{"text":"Kâhin ve peygamber Efendi'nin tapınağında mı öldürülsünler?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Gençler ve yaşlılar sokaklarda yerde yatıyorlar.","poem":1},{"text":"El değmemiş kızlarımla gençlerim kılıçla düştüler.","poem":2},{"text":"Öfken gününde onları öldürdün.","poem":1},{"text":"Boğazladın, ama acımadın.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Kutsal toplantı gününde olduğu gibi, her yandan dehşetlerimi çağırdın.","poem":1},{"text":"Yahve'nin öfkesi gününde kaçıp kurtulan ya da geride kalan olmadı.","poem":2},{"lineBreak":true},{"text":"Düşmanım, bakıp büyüttüğüm çocuklarımı tüketti.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}