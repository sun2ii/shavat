{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"LAM","translationId":"tur_ytc","name":"AĞITLAR","commonName":"AĞITLAR","title":"AĞITLAR","order":25,"numberOfChapters":5,"sha256":"bf59660f9ad2dd08b8fb102110ab0d3199654753324782e9ee22d041e37c688f","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tur_ytc/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ben, O'nun gazabının değneğiyle","poem":1},{"text":"sıkıntı gören adamım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beni güttü, ışıkta değil,","poem":1},{"text":"karanlıkta yürüttü.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gerçekten de bütün gün","poem":1},{"text":"elini bana karşı çevirip duruyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Etimi ve derimi yıprattı,","poem":1},{"text":"kemiklerimi kırdı.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Karşıma duvar yaptı,","poem":1},{"text":"beni acı ve sıkıntıyla kuşattı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uzun zamandır ölü olanlar gibi","poem":1},{"text":"beni karanlık yerlerde oturttu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çevreme duvar ördü, dışarı çıkamıyorum.","poem":1},{"text":"Zincirlerimi ağırlaştırdı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Evet, feryat edip yardım çağırınca,","poem":1},{"text":"duama set çekiyor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yollarıma yontma taşlarla duvar ördü,","poem":1},{"text":"yollarımı eğri etti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Benim için pusuda yatan bir ayı,","poem":1},{"text":"gizlenmiş bir aslandır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yolumu saptırdı,","poem":1},{"text":"ve beni paraladı.","poem":2},{"lineBreak":true},{"text":"Beni harap etti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yayını gerdi,","poem":1},{"text":"beni ok için hedef gibi dikti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kılıfındaki oklarını böbreklerime sapladı.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Halkımın tümüne alay konusu,","poem":1},{"text":"gün boyu onların türküsü oldum.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Beni acıyla doldurdu.","poem":1},{"text":"Beni pelinle doldurdu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dişlerimi çakıl taşlarıyla kırdı.","poem":1},{"text":"Üzerimi külle örttü.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Canımı esenlikten uzaklaştırdın.","poem":1},{"text":"Bolluğu unuttum.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Gücüm,","poem":1},{"text":"Yahve'den beklediğim umut da yok oldu” dedim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sıkıntımı, sefaletimi,","poem":1},{"text":"pelinle acıyı hatırla.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Canım onları hâlâ hatırlıyor,","poem":1},{"text":"ve içimde eğiliyor.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bunu aklıma getiriyorum,","poem":1},{"text":"bu yüzden umudum var.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yahve'nin sevgi dolu iyiliklerinden ötürü tükenmedik,","poem":1},{"text":"çünkü merhametleri son bulmaz.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Onlar her sabah yenilenir.","poem":1},{"text":"Senin sadakatin büyüktür.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Benim payım Yahve'dir” der canım.","poem":1},{"text":"“Bu yüzden O'na güvenirim.”","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yahve kendisini bekleyenlere,","poem":1},{"text":"kendisini arayan cana iyidir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"İnsanın umut etmesi,","poem":1},{"text":"ve Yahve'nin kurtarışını sessizce beklemesi iyidir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İnsanın gençliğinde boyunduruğu taşıması iyidir.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tek başına otursun da sussun,","poem":1},{"text":"çünkü üzerine onu koyan O'dur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ağzını toprağa koysun,","poem":1},{"text":"belki umut olur.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kendisine vurana yanağını uzatsın.","poem":1},{"text":"Utanca doysun.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Çünkü Yahve sonsuza dek kendisinden atmaz.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Çünkü O, kederlendirse de,","poem":1},{"text":"sevgi dolu iyiliklerinin çokluğuna göre yine merhamet eder.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Çünkü O, isteyerek sıkıntı vermez,","poem":1},{"text":"insanoğullarını kederlendirmez.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yeryüzünün bütün tutsaklarını ayak altında ezmeyi,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"yüceler Yücesi'nin yüzü önünde insanın hakkını saptırmayı,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"davasında insana haksızlık etmeyi, Efendi razı olmaz.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Efendi buyurmadıkça,","poem":1},{"text":"kim bir şey söyler de gerçekleşir?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kötülük de iyilik de Yüceler Yücesi'nin ağzından çıkmıyor mu?","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"İnsan, yaşayan insan,","poem":1},{"text":"neden günahlarının cezası için yakınır?","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yollarımızı araştıralım, deneyelim,","poem":1},{"text":"ve yine Yahve'ye dönelim.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Göklerdeki Tanrı'ya","poem":1},{"noteId":2},{"text":"ellerimizle birlikte yüreğimizi de yükseltelim.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"“Suç işledik ve isyan ettik.","poem":1},{"text":"Sen bağışlamadın.”","poem":2}]},{"type":"verse","number":43,"content":[{"text":"“Bizi öfkeyle örttün ve bizi kovaladın.","poem":1},{"text":"Öldürdün. Acımadın.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Kendini bulutla örttün,","poem":1},{"text":"böylece hiçbir dua ondan geçemiyor.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bizi halkların arasında pislik ve süprüntü yaptın.”","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"“Bütün düşmanlarımız bize karşı ağızlarını kocaman açtılar.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Dehşet ve çukur üzerimize geldi,","poem":1},{"text":"kırgın ve yıkım.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Halkımın kızının yıkımı yüzünden,","poem":1},{"text":"gözüm su ırmaklarıyla akıyor.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Gözüm hiç ara vermeden,","poem":1},{"text":"durmadan akıyor.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Yahve aşağı bakıp","poem":1},{"text":"gökten görene kadar.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Kentimin bütün kızları yüzünden,","poem":1},{"text":"gözlerim canımı sarstı.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Sebepsiz yere bana düşman olanlar","poem":1},{"text":"bir kuş gibi beni acımasızca kovaladılar.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Hayatımı zindanda kesip kopardılar,","poem":1},{"text":"üzerime taş attılar.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Başımın üstünden sular aktı.","poem":1},{"text":"“Kesip koparıldım” dedim.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Zindanının dibinden adını çağırdım,","poem":1},{"text":"ey Yahve.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Sesimi duydun:","poem":1},{"text":"“Kulağını inlememden,","poem":2},{"lineBreak":true},{"text":"ve feryadımdan gizleme.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Seni çağırdığım gün yaklaştın.","poem":1},{"text":"“Korkma” dedin.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ey Yahve, canımın davalarını sen gördün.","poem":1},{"text":"Hayatımı kurtardın.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Ey Yahve, bana olan haksızlığı gördün.","poem":1},{"text":"Davamı yargıla.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Bütün intikamlarını,","poem":1},{"text":"ve bana karşı yaptıkları bütün tasarıları gördün.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Ey Yahve, onların aşağılamasını,","poem":1},{"text":"ve bana karşı olan bütün tasarılarını,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"bana karşı çıkanların dudaklarını,","poem":1},{"text":"ve bütün gün bana karşı kurdukları düzenlerini duydun.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Oturuşlarını ve kalkışlarını görüyorsun.","poem":1},{"text":"Ben onların türküsü oldum.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Onlara ellerinin işine göre karşılık vereceksin, ey Yahve.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"Onlara yürek katılığı vereceksin,","poem":1},{"text":"lanetin onlara olsun.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Onları öfkeyle kovalayacak,","poem":1},{"text":"ve onları Yahve'nin göklerinin altından yok edeceksin.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":3,"verse":41}}]},"thisChapterLink":"/api/tur_ytc/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}