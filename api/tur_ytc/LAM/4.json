{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"LAM","translationId":"tur_ytc","name":"AĞITLAR","commonName":"AĞITLAR","title":"AĞITLAR","order":25,"numberOfChapters":5,"sha256":"bf59660f9ad2dd08b8fb102110ab0d3199654753324782e9ee22d041e37c688f","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tur_ytc/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Altın nasıl da donuklaştı!","poem":1},{"text":"Saf altın nasıl değişti!","poem":2},{"text":"Kutsal yerin taşları","poem":1},{"text":"her sokak başına döküldü.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Saf altınla kıyaslanan,","poem":1},{"text":"Siyon'un değerli oğulları,","poem":2},{"text":"nasıl oldu da çömlekçi elinin işi,","poem":1},{"text":"toprak testiler gibi sayıldılar!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çakallar bile memelerini verir,","poem":1},{"text":"yavrularını emzirirler.","poem":2},{"text":"Ama halkım kızı,","poem":1},{"text":"çöldeki devekuşları gibi acımasız oldu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Emzikteki çocuğun dili susuzluktan damağına yapışıyor.","poem":1},{"text":"Küçük çocuklar ekmek istiyor,","poem":2},{"lineBreak":true},{"text":"kimse onlar için koparmıyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lezzetli yiyecekler yiyenler sokaklarda perişan oldular.","poem":1},{"text":"Mor giysiler içinde büyütülenler gübre yığınlarını kucakladılar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü halkım kızının suçu,","poem":1},{"text":"el değmeden bir anda yıkılan Sodom'un günahından daha büyüktür.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Soyluları kardan daha temizdi.","poem":1},{"text":"Sütten daha beyazdı.","poem":2},{"text":"Bedence yakuttan daha kırmızıydı.","poem":1},{"text":"Safir gibi parlıyordu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Görünüşleri kömürden daha kara oldu.","poem":1},{"text":"Sokaklarda tanınmaz oldular.","poem":2},{"text":"Derileri kemiklerine yapıştı.","poem":1},{"text":"Kurudular.","poem":2},{"lineBreak":true},{"text":"Odun gibi oldular.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kılıçla öldürülenler kıtlığın öldürdüklerinden iyidir;","poem":1},{"text":"çünkü bunlar tarla ürünlerinin yokluğundan yıpranarak erimekteler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Merhametli kadınların elleri kendi çocuklarını kaynattı.","poem":1},{"text":"Onlar halkım kızının yıkımında yiyecekleri oldular.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve gazabını tamamladı.","poem":1},{"text":"Kızgın öfkesini döktü.","poem":2},{"lineBreak":true},{"text":"Siyon'da, onun temellerini yiyip bitiren bir ateş tutuşturdu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Düşman ve hasım Yeruşalem kapılarından içeri girecek diye,","poem":1},{"text":"yeryüzü kralları ve dünya sakinlerinin hiçbiri inanmazdı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Peygamberlerinin günahları,","poem":1},{"text":"ve kâhinlerinin suçları yüzünden bu,","poem":2},{"lineBreak":true},{"text":"çünkü onlar kentin ortasında doğruların kanını döktüler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sokaklarda körler gibi dolaşıyorlar.","poem":1},{"text":"Kanla kirlenmişler,","poem":2},{"lineBreak":true},{"text":"Öyle ki, insanlar giysilerine dokunamaz oldu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Çekilin!” diye bağırdılar onlara.","poem":1},{"text":"“Kirli! Çekilin! Çekilin! Dokunmayın!","poem":2},{"text":"Kaçıp başıboş dolaştıklarında, insanlar uluslar arasında.”","poem":1},{"text":"“Artık burada yaşayamazlar” dediler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve'nin öfkesi onları dağıttı.","poem":1},{"text":"Artık onlara bakmayacak.","poem":2},{"text":"Kâhinlere saygı göstermediler.","poem":1},{"text":"Yaşlıları kayırmadılar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Boş yere yardım beklerken,","poem":1},{"text":"artık gözlerimiz sönüyor,","poem":2},{"lineBreak":true},{"text":"bizi kurtaramayacak bir ulusu gözledikçe gözledik.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adımlarımızı avlıyorlar,","poem":1},{"text":"sokaklarımızda gezemiyoruz.","poem":2},{"text":"Sonumuz yakın.","poem":1},{"text":"Günlerimiz doldu,","poem":2},{"lineBreak":true},{"text":"çünkü sonumuz geldi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bizi kovalayanlar gökteki kartallardan daha hızlı.","poem":1},{"text":"Dağlarda bizi kovaladılar.","poem":2},{"lineBreak":true},{"text":"Çölde bize pusu kurdular.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yaşam soluğumuz,","poem":1},{"text":"Yahve'nin meshedilmişi,","poem":2},{"lineBreak":true},{"text":"onların çukurlarında yakalandı;","poem":2},{"text":"hani onun için,","poem":1},{"text":"Uluslar arasında onun gölgesinde yaşayacağız dediğimiz.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sevin ve coş, Uz diyarında oturan ey Edom kızı.","poem":1},{"lineBreak":true},{"text":"Kâse sana da geçecek.","poem":1},{"text":"Sarhoş olacaksın,","poem":2},{"lineBreak":true},{"text":"ve soyunacaksın.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Suçlarının cezası tamamlandı, ey Siyon kızı.","poem":1},{"text":"Artık seni sürgüne götürmeyecek.","poem":2},{"text":"Ey Edom kızı, senin suçlarını ziyaret edecek.","poem":1},{"text":"Senin günahlarını ortaya çıkaracak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}