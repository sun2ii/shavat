{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"LAM","translationId":"tur_ytc","name":"AĞITLAR","commonName":"AĞITLAR","title":"AĞITLAR","order":25,"numberOfChapters":5,"sha256":"bf59660f9ad2dd08b8fb102110ab0d3199654753324782e9ee22d041e37c688f","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tur_ytc/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ey Yahve, başımıza gelenleri hatırla.","poem":1},{"text":"Bak da utancımızı gör.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mirasımız yabancılara,","poem":1},{"text":"evlerimiz ellere verildi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yetim ve babasız kaldık.","poem":1},{"text":"Annelerimiz dul kadınlar gibi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Suyumuzu parayla içmek zorunda kaldık.","poem":1},{"text":"Odunumuz bize satılıyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bizi kovalayanlar ensemizde.","poem":1},{"text":"Yorgunuz ve rahatımız yok.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekmekle doymak için ellerimizi","poem":1},{"text":"Mısırlılar'a ve Aşurlular'a verdik.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atalarımız günah işledi, artık yoklar.","poem":1},{"text":"Onların suçlarını biz yüklendik.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Köleler bizi yönetiyor.","poem":1},{"text":"Onların elinden bizi kurtaracak kimse yok.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çöldeki kılıç yüzünden","poem":1},{"text":"ekmeğimizi hayatımız pahasına kazanıyoruz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kıtlığın yakıcı sıcağından","poem":1},{"text":"derimiz fırın gibi karardı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siyon'daki kadınların,","poem":1},{"text":"Yahuda kentlerindeki el değmemiş kızların ırzına geçtiler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Beyler ellerinden asıldı.","poem":1},{"text":"Yaşlıların yüzlerine saygı gösterilmedi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gençler değirmen taşı taşıdılar.","poem":1},{"text":"Çocuklar odun yükleri altında tökezledi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaşlılar kent kapısından,","poem":1},{"text":"gençler de ezgilerinden kesildi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yüreğimizin sevinci kesildi.","poem":1},{"text":"Oyunumuz yasa dönüştü.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Başımızdan taç düştü.","poem":1},{"text":"Vay halimize, çünkü günah işledik!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bu yüzden yüreğimiz baygın.","poem":1},{"text":"Bu şeylerden ötürü gözlerimiz karardı:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Siyon Dağı ıssız kalmış olduğu için,","poem":1},{"text":"onun üzerinde çakallar dolaşıyor.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sen, ey Yahve, sonsuza dek kalırsın.","poem":1},{"text":"Tahtın kuşaktan kuşağa sürer.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neden bizi daima unutuyorsun,","poem":1},{"text":"ve bizi bu kadar uzun bir süre bırakıyorsun?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bizi kendine döndür, ey Yahve, ve biz dönelim.","poem":1},{"text":"Günlerimizi eskisi gibi yenile.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ama sen bizi tümüyle reddettin.","poem":1},{"text":"Bize karşı çok öfkelisin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}