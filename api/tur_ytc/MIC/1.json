{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yahve'nin",{"noteId":0},"Yahuda kralları Yotam, Ahaz ve Hizkiya günlerinde Moraşet'li Mika'ya gelen sözü, Samariya ve Yeruşalem hakkında gördü."]},{"type":"verse","number":2,"content":[{"text":"Dinleyin, ey halklar, hepiniz!","poem":1},{"text":"Ey yeryüzü ve içindekilerin hepsi, dinleyin.","poem":2},{"text":"Efendi","poem":1},{"noteId":1},{"text":"Yahve, Efendi kutsal tapınağından size karşı tanıklık etsin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Çünkü işte,","poem":1},{"noteId":2},{"text":"Yahve yerinden çıkıyor,","poem":1},{"text":"ve inip yeryüzünün yüksek yerlerine basacak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dağlar O'nun altında eriyor,","poem":1},{"text":"ve vadiler ateşin önündeki balmumu gibi,","poem":2},{"lineBreak":true},{"text":"dik yerden dökülen sular gibi yarılıyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Bütün bunlar Yakov’un itaatsizliği,","poem":1},{"text":"ve İsrael evinin günahları yüzündendir.","poem":2},{"text":"Yakov’un itaatsizliği nedir?","poem":1},{"text":"Samariya değil mi?","poem":2},{"text":"Yahuda’nın yüksek yerleri nelerdir?","poem":1},{"text":"Yeruşalem değil mi?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu yüzden Samariya’yı tarlanın taş yığını,","poem":1},{"text":"bağ dikme yerleri gibi yapacağım;","poem":2},{"text":"ve onun taşlarını vadiye dökeceğim,","poem":1},{"text":"ve temellerini açığa çıkaracağım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bütün putları parça parça edilecek,","poem":1},{"text":"onun bütün tapınak armağanları ateşte yakılacak,","poem":2},{"lineBreak":true},{"text":"ve onun bütün suretlerini yok edeceğim;","poem":2},{"text":"çünkü onları fahişe ücretiyle topladı,","poem":1},{"text":"ve fahişe ücretine geri dönecekler.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bundan ötürü ağıt yakıp dövüneceğim.","poem":1},{"text":"Soyunmuş ve çıplak olarak gideceğim.","poem":2},{"lineBreak":true},{"text":"Çakallar gibi uluyacağım,","poem":2},{"lineBreak":true},{"text":"ve devekuşları gibi yas tutacağım.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü onun yaraları şifa bulmaz;","poem":1},{"text":"çünkü Yahuda'ya kadar geldi.","poem":2},{"text":"Halkımın kapısına,","poem":1},{"text":"Yeruşalem'e kadar ulaşıyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gat'ta söylemeyin bunu.","poem":1},{"text":"Hiç ağlamayın.","poem":2},{"lineBreak":true},{"text":"Kendimi Beyt Ofra'da","poem":2},{"noteId":3},{"text":"toz içinde yuvarladım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey sen, çıplaklık ve utanç içinde, Şafir'de oturan, geç git.","poem":1},{"text":"Zaanan'da oturan çıkmıyor.","poem":2},{"lineBreak":true},{"text":"Beyt Ezel'in ağıtı sizden korumasını alacak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü Marot'ta oturan malını kaygıyla bekliyor,","poem":1},{"text":"çünkü Yahve'den kötülük Yeruşalem kapısına indi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lakiş'te oturan, hızlı atını arabaya koş.","poem":1},{"text":"O, Siyon kızı için günahın başlangıcı oldu;","poem":2},{"lineBreak":true},{"text":"çünkü İsrael'in suçları sende bulundu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bu yüzden Moreşet Gat'a veda hediyesi vereceksin.","poem":1},{"text":"Akziv evleri İsrael kralları için aldatıcı bir şey olacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ey Mareşah sakinleri, sizi ele geçirecek olanı üzerinize getireceğim.","poem":1},{"text":"İsrael'in görkemi Adullam'a gelecek.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Başlarınızı tıraş edin,","poem":1},{"text":"ve sevincinizin çocukları için saçlarınızı yolun.","poem":2},{"text":"Kel saçlarınızı akbaba gibi genişletin,","poem":1},{"text":"çünkü onlar senin yanından sürüldüler!","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":1,"verse":2}},{"noteId":2,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":1,"verse":3}},{"noteId":3,"caller":"+","text":"Beyt Ofra, tam anlamıyla “Toz Evi” anlamına gelir.","reference":{"chapter":1,"verse":10}}]},"thisChapterLink":"/api/tur_ytc/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}