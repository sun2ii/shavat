{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Kötülük tasarlayan,","poem":1},{"text":"ve yataklarında kötülük yapanların vay haline!","poem":2},{"text":"Sabahın ilk ışıklarıyla bunu yaparlar,","poem":1},{"text":"çünkü onların elinden gelir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tarlalara göz dikiyorlar ve onları ellerinden alıyorlar,","poem":1},{"text":"evlere de göz dikiyorlar, onları da ellerinden alıyorlar.","poem":2},{"text":"Bir adamı ve evini,","poem":1},{"text":"bir adamı ve mirasını sıkıştırıyorlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bu nedenle Yahve şöyle diyor:","poem":1},{"text":"“İşte, bu halka karşı bir felaket tasarlıyorum;","poem":2},{"lineBreak":true},{"text":"ondan boyunlarınızı kaldırmayacaksınız,","poem":2},{"lineBreak":true},{"text":"ve kibirle yürümeyeceksiniz,","poem":2},{"lineBreak":true},{"text":"Çünkü bu kötü bir zamandır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O gün size karşı bir benzetme söyleyecekler,","poem":1},{"text":"ve hüzünlü bir ağıtla ağıt yakacaklar,","poem":2},{"lineBreak":true},{"text":"‘Tümüyle mahvolduk!","poem":2},{"lineBreak":true},{"text":"Halkımın mülkü paylaşıldı.","poem":2},{"lineBreak":true},{"text":"Gerçekten onu benden alıyor ve tarlalarımızı hainlere veriyor!’ diyecekler.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bu nedenle, Yahve'nin topluluğunda ülkeyi kura ile bölen kimse olmayacak.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Peygamberlik etmeyin!”—peygamberlik ediyorlar—","poem":1},{"text":"“Bu şeyler hakkında peygamberlik etmeyin.","poem":2},{"lineBreak":true},{"text":"Utanç bize erişmeyecek.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey Yakov evi denilen sen,","poem":1},{"text":"“Yahve'nin Ruhu öfkelendi mi?","poem":2},{"lineBreak":true},{"text":"Bunlar onun yaptıkları mı?","poem":2},{"lineBreak":true},{"text":"Sözlerim kusursuz yürüyene iyilik etmiyor mu?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama son zamanlarda halkım düşman olarak ayaklandı.","poem":1},{"text":"Savaştan dönüp kaygısızca geçenlerin kaftanını ve giysilerini soyuyorsunuz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halkımın kadınlarını güzel evlerinden kovuyorsunuz;","poem":1},{"text":"onların küçük çocuklarından sonsuza dek kutsamamı alıyorsunuz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kalkın ve gidin!","poem":1},{"text":"Çünkü burası sizin dinlenme yeriniz değil,","poem":2},{"lineBreak":true},{"text":"çünkü kirlilik yüzünden mahvolacak,","poem":2},{"lineBreak":true},{"text":"ağır bir yıkımla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eğer bir adam hile ruhu ile yürüyüp yalan söylerse,","poem":1},{"text":"“Ben sana şarap ve içki hakkında peygamberlik edeyim” derse,","poem":2},{"lineBreak":true},{"text":"o bu halkın peygamberi olacaktır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Yakov, hepinizi mutlaka toplayacağım.","poem":1},{"text":"İsrael'in arta kalanını mutlaka toplayacağım.","poem":2},{"text":"Onları Bostra koyunları gibi,","poem":1},{"text":"otlaklarının ortasındaki bir sürü gibi bir araya getireceğim.","poem":2},{"lineBreak":true},{"text":"İnsanlarla kaynaşacaklar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yolu açan önlerinden çıkıyor.","poem":1},{"text":"Onlar kapıyı delip çıkıyorlar.","poem":2},{"lineBreak":true},{"text":"Yahve başlarında olarak,","poem":2},{"lineBreak":true},{"text":"kralları önlerinden geçiyor.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}