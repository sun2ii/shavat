{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Şöyle dedim,",{"text":"“Ey Yakov önderleri,","poem":1},{"text":"İsrael evinin yöneticileri, lütfen dinleyin:","poem":2},{"lineBreak":true},{"text":"Adaleti bilmek size düşmez mi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İyilikten nefret eden,","poem":1},{"text":"kötülüğü seven,","poem":2},{"lineBreak":true},{"text":"derilerini ve etlerini kemiklerinden sıyıran sizler,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"halkımın etini yiyen,","poem":1},{"text":"ve derilerini sıyıran,","poem":2},{"lineBreak":true},{"text":"ve kemiklerini kıran,","poem":2},{"lineBreak":true},{"text":"ve tencere içinmiş gibi,","poem":2},{"lineBreak":true},{"text":"ve kazanda olan et gibi onları doğrayan sizlersiniz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O zaman Yahve'ye feryat edecekler,","poem":1},{"text":"ama onlara yanıt vermeyecek.","poem":2},{"text":"Evet, o zaman yüzünü onlardan gizleyecek,","poem":1},{"text":"çünkü işlerini kötü yaptılar.”","poem":2}]},{"type":"verse","number":5,"content":["Halkımı saptıran peygamberler hakkında Yahve şöyle diyor: Dişlerini doyuranlara gelince, “Esenlik!” diye bağırırlar ve kim onlara boğazları için vermezse, ona karşı savaş açarlar:"]},{"type":"verse","number":6,"content":[{"text":"Bu yüzden görümsüz gece üzerinizdedir,","poem":1},{"text":"ve falcılık yapmayasınız diye size karanlık olacak;","poem":2},{"lineBreak":true},{"text":"ve peygamberlerin üzerine güneş batacak,","poem":2},{"lineBreak":true},{"text":"ve gün üzerlerine kararacak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Görenler hayal kırıklığına uğrayacak,","poem":1},{"text":"ve falcılar şaşkına dönecek.","poem":2},{"text":"Evet, hepsi dudaklarını örtecek,","poem":1},{"text":"Çünkü Tanrı'dan","poem":2},{"noteId":4},{"text":"bir yanıt yok.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama ben, Yakov'a itaatsizliğini,","poem":1},{"text":"ve İsrael'e günahını bildirmek için","poem":2},{"lineBreak":true},{"text":"Yahve'nin Ruhu ile güç,","poem":2},{"lineBreak":true},{"text":"ve yargı ve kudret ile doluyum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey Yakov evinin önderleri,","poem":1},{"text":"ve İsrael evinin yöneticileri,","poem":2},{"lineBreak":true},{"text":"adaletten nefret eden,","poem":2},{"lineBreak":true},{"text":"ve her türlü tarafsızlığı bozan,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Siyon'u kanla,","poem":1},{"text":"ve Yeruşalem'i haksızlıkla kuran sizler,","poem":2},{"lineBreak":true},{"text":"lütfen bunu dinleyin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onun liderleri rüşvetle yargılıyor,","poem":1},{"text":"ve kâhinleri ücretle öğretiyor,","poem":2},{"lineBreak":true},{"text":"ve onun peygamberleri parayla fal bakıyorlar;","poem":2},{"lineBreak":true},{"text":"bununla birlikte Yahve'ye yaslanıp şöyle diyorlar,","poem":2},{"lineBreak":true},{"text":"“Yahve aramızda değil mi?","poem":2},{"lineBreak":true},{"text":"Başımıza felaket gelmeyecek.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bundan ötürü Siyon senin yüzünden tarla gibi sürülecek,","poem":1},{"text":"ve Yeruşalem moloz yığınına,","poem":2},{"lineBreak":true},{"text":"tapınağın dağı da ormandaki yüksek yerler gibi olacak.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":3,"verse":7}}]},"thisChapterLink":"/api/tur_ytc/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}