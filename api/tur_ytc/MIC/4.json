{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ama son günlerde, Yahve'nin Tapınağı'nın dağı dağların tepesinde pekiştirilecek,","poem":1},{"text":"ve tepelerden yukarı yükselecek,","poem":2},{"lineBreak":true},{"text":"ve halklar ona akın edecek.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Birçok ulus gidip,","poem":2},{"lineBreak":true},{"text":"“Hadi, Yahve'nin Dağı'na,","poem":2},{"lineBreak":true},{"text":"ve Yakov'un Tanrısı'nın evine çıkalım” diyecek.","poem":2},{"lineBreak":true},{"text":"O bize kendi yollarını öğretecek,","poem":2},{"lineBreak":true},{"text":"ve biz de O'nun yollarında yürüyeceğiz.","poem":2},{"text":"Çünkü yasa Siyon'dan,","poem":1},{"text":"Yahve'nin sözü Yeruşalem'den çıkacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çok halklar arasında yargıçlık edecek,","poem":1},{"text":"ve uzaktaki güçlü uluslar hakkında karar verecek.","poem":2},{"lineBreak":true},{"text":"Kılıçlarını saban demirleri,","poem":2},{"lineBreak":true},{"text":"ve mızraklarını bağcı bıçakları yapacaklar.","poem":2},{"text":"Ulus ulusa kılıç kaldırmayacak,","poem":1},{"text":"artık savaş eğitimi yapmayacaklar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ama herkes kendi asmasının, kendi incir ağacının altında oturacak. Kimse onları korkutmayacak, Çünkü Ordular Yahvesi'nin ağzı söyledi.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Gerçekten bütün uluslar kendi ilâhlarının adıyla yürüyorlar,","poem":2},{"lineBreak":true},{"text":"Ama biz daima Tanrımız Yahve'nin adıyla yürüyeceğiz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve şöyle diyor,","poem":1},{"text":"“O gün, topalı toplayacağım,","poem":2},{"lineBreak":true},{"text":"ve sürülmüş olanı,","poem":2},{"lineBreak":true},{"text":"ve ezmiş olduğumu bir araya getireceğim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Topalı bir kalıntı,","poem":1},{"text":"ve uzaklara atılmış olanı güçlü bir ulus yapacağım;","poem":2},{"lineBreak":true},{"text":"ve Yahve bundan böyle sonsuza dek Siyon Dağı'nda onların üzerinde hüküm sürecek.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sen, ey sürünün kulesi, Siyon kızının doruğu,","poem":1},{"text":"sana gelecek.","poem":2},{"text":"Evet, eski hâkimiyet,","poem":1},{"text":"Yeruşalem kızının krallığı gelecek.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Şimdi neden yüksek sesle bağırıyorsun?","poem":1},{"text":"Sende kral yok mu?","poem":2},{"lineBreak":true},{"text":"Senin öğütçün yok mu oldu da,","poem":2},{"lineBreak":true},{"text":"doğuran kadın gibi seni ağrılar tuttu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Siyon kızı, ağrı çek, doğuran kadın gibi ağrı çek.","poem":1},{"text":"Çünkü şimdi kentten çıkacaksın,","poem":2},{"lineBreak":true},{"text":"ve kırda oturacaksın,","poem":2},{"lineBreak":true},{"text":"ve Babil'e kadar varacaksın.","poem":2},{"text":"Orada kurtarılacaksın.","poem":1},{"text":"Orada Yahve seni düşmanlarının elinden kurtaracak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Şimdi sana karşı birçok ulus toplandı,","poem":1},{"text":"“O kirlensin,","poem":2},{"lineBreak":true},{"text":"ve gözlerimiz Siyon'u zevkle izlesin” diyorlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama Yahve'nin düşüncelerini bilmiyorlar,","poem":1},{"text":"O'nun tasarısını da anlamıyorlar.","poem":2},{"lineBreak":true},{"text":"Çünkü onları harman yerine demetler gibi topladı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kalk, harman döv, ey Siyon kızı,","poem":1},{"text":"çünkü boynuzunu demir yapacağım,","poem":2},{"lineBreak":true},{"text":"ve toynaklarını tunç yapacağım.","poem":2},{"text":"Birçok halkı ezeceksin.","poem":1},{"lineBreak":true},{"text":"Onların kazançlarını Yahve'ye,","poem":1},{"text":"ve mallarını da bütün yeryüzünün Efendisi'ne adayacağım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}