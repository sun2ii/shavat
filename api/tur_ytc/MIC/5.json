{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Şimdi sen, ey ordular kızı,","poem":1},{"text":"ordu halinde toplanacaksın.","poem":2},{"text":"O, bize karşı kuşatma kurdu.","poem":1},{"text":"İsrael yargıcının yanağına değnekle vuracaklar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ama sen, Yahuda boyları arasında küçük olan Beytlehem Efrata,","poem":1},{"text":"İsrael'de hükümdar olacak kişi bana senden çıkacak;","poem":2},{"lineBreak":true},{"text":"onun çıkışları eskiden, kadim zamanlardandır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bu yüzden, doğum sancısı çeken kadın doğurana dek onları terk edecek.","poem":1},{"text":"O zaman kardeşlerinin geri kalanı İsrael'in çocuklarına dönecek.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayağa kalkacak ve Tanrısı Yahve'nin gücüyle,","poem":1},{"text":"Tanrısı Yahve'nin adının görkemiyle sürüsünü güdecek.","poem":2},{"lineBreak":true},{"text":"Onlar yaşayacaklar, çünkü o zaman yeryüzünün sonlarına kadar o büyük olacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aşur ülkemize saldırdığında,","poem":1},{"text":"ve kalelerimize doğru ilerlediğinde,","poem":2},{"lineBreak":true},{"text":"o zaman ona karşı yedi çoban,","poem":2},{"lineBreak":true},{"text":"ve sekiz halk önderi dikeceğiz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kılıçla Aşur ülkesinde,","poem":1},{"text":"onun kapılarında Nimrod ülkesinde hüküm sürecekler.","poem":2},{"text":"Ülkemize saldırdığında ve sınırlarımızdan içeri girdiğinde,","poem":1},{"text":"bizi Aşur'dan o adam kurtaracak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yakov'un arta kalanı, birçok halkın arasında,","poem":1},{"text":"Yahve'nin çiği gibi,","poem":2},{"lineBreak":true},{"text":"insanı da insanoğullarını da beklemeyen","poem":2},{"lineBreak":true},{"text":"otların üzerine düşen sağanak yağmurlar gibi olacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yakov'un arta kalanı, uluslar arasında,","poem":1},{"text":"birçok halkın ortasında,","poem":2},{"lineBreak":true},{"text":"orman hayvanları arasında aslan gibi,","poem":2},{"lineBreak":true},{"text":"koyun sürüleri arasında genç aslan gibi olacak.","poem":2},{"lineBreak":true},{"text":"Eğer o geçerse çiğneyip parçalayacak,","poem":2},{"lineBreak":true},{"text":"ve kurtaracak kimse olmayacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Elin hasımlarının üzerine kalksın,","poem":1},{"text":"ve bütün düşmanların kesilip atılsın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve şöyle diyor, “O gün öyle olacak ki,","poem":1},{"text":"senden atlarını söküp atacağım,","poem":2},{"lineBreak":true},{"text":"ve senin savaş arabalarını yok edeceğim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ülkenin kentlerini söküp atacağım,","poem":1},{"text":"senin bütün kalelerini yıkacağım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Büyücülüğü elinden yok edeceğim.","poem":1},{"text":"Falcıların olmayacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aranızdan oyma suretlerinizi ve dikili taşlarını söküp atacağım;","poem":1},{"text":"ve artık kendi ellerinin işine tapmayacaksın.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Senden Aşera direklerini söküp atacağım;","poem":1},{"text":"ve senin kentlerini harap edeceğim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Söz dinlemeyen uluslardan öfke","poem":1},{"text":"ve gazapla öç alacağım.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}