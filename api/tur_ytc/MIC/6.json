{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Şimdi Yahve'nin ne dediğini dinleyin:",{"text":"“Kalk, davanı dağların önünde savun,","poem":1},{"text":"ve tepeler senin söyleyeceklerini duysun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ey dağlar, yeryüzünün sağlam temelleri,","poem":1},{"text":"Yahve'nin davasını dinleyin;","poem":2},{"lineBreak":true},{"text":"çünkü Yahve'nin halkına karşı davası var,","poem":2},{"lineBreak":true},{"text":"ve İsrael'le çekişecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey halkım, sana ne yaptım?","poem":1},{"text":"Sana nasıl yük oldum?","poem":2},{"lineBreak":true},{"text":"Bana yanıt ver!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü seni Mısır diyarından ben çıkardım,","poem":1},{"text":"ve seni kölelik evinden kurtardım.","poem":2},{"lineBreak":true},{"text":"Önünden Moşe'yi, Aron'u ve Miryam'ı gönderdim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey halkım, Yahve'nin doğru işlerini bilesin diye,","poem":1},{"text":"şimdi Moav Kralı Balak'ın ne öğütlediğini,","poem":2},{"lineBreak":true},{"text":"ve Beor oğlu Balam'ın Şittim'den Gilgal'a kadar","poem":2},{"lineBreak":true},{"text":"ona ne yanıt verdiğini hatırla.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve'nin önüne nasıl çıkacağım,","poem":1},{"text":"ve yüce Tanrı'nın önünde nasıl eğileceğim?","poem":2},{"text":"O'nun önüne yakmalık sunularla mı,","poem":1},{"text":"bir yıllık buzağılarla mı çıkayım?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve binlerce koçtan hoşnut olur mu?","poem":1},{"text":"On binlerce ırmak dolusu yağdan?","poem":2},{"text":"İlk doğanımı itaatsizliğim için,","poem":1},{"text":"canımın günahı için bedenimin ürününü mü vereyim?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey insan, O sana iyi olanı gösterdi.","poem":1},{"text":"Adil davranmandan, merhameti sevmenden ve Tanrın'la alçakgönüllülükle yürümenden başka","poem":2},{"lineBreak":true},{"text":"Yahve senden ne ister?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve'nin sesi kente sesleniyor,","poem":1},{"text":"ve bilgelik senin adından korkuyor,","poem":2},{"text":"“Değneği,","poem":1},{"text":"ve onu tayin edeni dinleyin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kötülük hazineleri,","poem":1},{"text":"ve lanetli eksik efa","poem":2},{"noteId":5},{"text":"hâlâ kötü insanın evinde mi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hileli terazilere,","poem":1},{"text":"hileli ağırlık torbalarına göz yumar mıyım?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onun zenginleri zorbalıkla doludur,","poem":1},{"text":"onda oturanlar yalan söyler,","poem":2},{"lineBreak":true},{"text":"ve dilleri sözlerinde aldatıcıdır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bu yüzden seni de ağır bir yarayla vurdum.","poem":1},{"text":"Günahların yüzünden seni perişan ettim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yiyeceksin, ama doymayacaksın.","poem":1},{"text":"Açlığın içinde olacak.","poem":2},{"lineBreak":true},{"text":"Biriktireceksin, ama tutamayacaksın.","poem":2},{"lineBreak":true},{"text":"Biriktirdiğini de kılıca teslim edeceğim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ekeceksin, ama biçmeyeceksin.","poem":1},{"text":"Zeytinleri basacaksın, ama üzerine yağ sürünmeyeceksin;","poem":2},{"lineBreak":true},{"text":"ve üzümleri sıkacaksın, ama şarabı içmeyeceksin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü Omri'nin kuralları,","poem":1},{"text":"ve Ahav'ın evinin bütün işleri tutuluyor.","poem":2},{"lineBreak":true},{"text":"Seni yıkıma uğratayım,","poem":2},{"lineBreak":true},{"text":"senin sakinlerine de ıslık çalsınlar diye","poem":2},{"lineBreak":true},{"text":"onların öğütlerinde yürüyorsunuz.","poem":2},{"lineBreak":true},{"text":"Halkımın utancını taşıyacaksınız.”","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Bir efa, bir hacim ölçüsüdür (yaklaşık 22 litre veya bir kilenin yaklaşık 2/3'ü) ve kısa bir efa, müşterileri aldatmak amacıyla tam bir efadan daha küçük yapılır.","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/tur_ytc/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}