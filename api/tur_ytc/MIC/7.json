{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"MIC","translationId":"tur_ytc","name":"MİKA","commonName":"MİKA","title":"MİKA","order":33,"numberOfChapters":7,"sha256":"5efe08cfff3ea8eaae85f5095cf40f01d95f3dd56d784a36e3c87f90344b4762","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tur_ytc/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Vay halime benim!","poem":1},{"text":"Gerçekten, ben yaz meyvelerini toplayan biri gibiyim, bağ bozumunun artakalanı gibi.","poem":2},{"lineBreak":true},{"text":"Yemek için bir salkım üzüm yok.","poem":2},{"lineBreak":true},{"text":"Canım turfanda incir arzuluyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanrısal adam yeryüzünden yok oldu,","poem":1},{"text":"ve insanlar arasında doğru kimse kalmadı.","poem":2},{"lineBreak":true},{"text":"Hepsi kan için pusuda bekliyor,","poem":2},{"lineBreak":true},{"text":"her adam kardeşini ağ ile avlıyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Elleri kötülük yapmak için gayretlidir.","poem":1},{"text":"Yönetici ve hâkim rüşvet istiyor.","poem":2},{"text":"Güçlü adam canının kötü arzusunu zorla kabul ettiriyor.","poem":1},{"text":"Böylece birlikte düzen kuruyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onların en iyileri çalı gibidir.","poem":1},{"text":"En doğruları dikenli çitten daha kötüdür.","poem":2},{"text":"Senin bekçilerinin günü,","poem":1},{"text":"ziyaret günün geldi;","poem":2},{"lineBreak":true},{"text":"Şimdi onlar için şaşkınlık zamanıdır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Komşuna güvenme.","poem":1},{"text":"Güvenini bir dosta bağlama.","poem":2},{"lineBreak":true},{"text":"Koynunda yatan kadından, ağzının sözlerine dikkat et!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü oğul babasına saygısızlık ediyor,","poem":1},{"text":"kız annesine karşı, gelin kaynanasına karşı çıkıyor;","poem":2},{"lineBreak":true},{"text":"bir adamın düşmanları kendi evinin adamlarıdır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama ben Yahve'ye bakacağım.","poem":1},{"text":"Kurtuluşumun Tanrısı'nı bekleyeceğim.","poem":2},{"lineBreak":true},{"text":"Tanrım beni duyacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey düşmanım, bana karşı sevinme. Ben düşersem kalkarım.","poem":1},{"text":"Karanlıkta oturursam, Yahve bana ışık olur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Davamı savunana,","poem":1},{"text":"ve benim için yargılayana dek","poem":2},{"lineBreak":true},{"text":"Yahve'nin öfkesine katlanacağım,","poem":2},{"lineBreak":true},{"text":"çünkü O'na karşı günah işledim.","poem":2},{"lineBreak":true},{"text":"O beni ışığa çıkaracak.","poem":2},{"lineBreak":true},{"text":"O'nun doğruluğunu göreceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O zaman düşmanım görecek ve bana,","poem":1},{"text":"“Tanrın Yahve nerede?” diyen onu utanç kaplayacak.","poem":2},{"text":"Gözlerim onu görecek.","poem":1},{"text":"Şimdi o, sokakların çamuru gibi çiğnenecek.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Duvarlarını bina etme günü!","poem":1},{"text":"O gün, sınırını genişletecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O gün Aşur'dan ve Mısır kentlerinden,","poem":1},{"text":"Mısır'dan Irmak'a,","poem":2},{"lineBreak":true},{"text":"Denizden denize,","poem":2},{"lineBreak":true},{"text":"ve dağdan dağa kadar sana gelecekler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yine de, içinde oturanlar yüzünden,","poem":1},{"text":"Yaptıklarının ürünü yüzünden ülke ıssız kalacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Halkını kendi değneğinle,","poem":1},{"text":"kendi başlarına ormanda oturan mirasının sürüsünü güt.","poem":2},{"text":"Eski günlerde olduğu gibi,","poem":1},{"text":"başan ve Gilad'da verimli otlakların ortasında otlasınlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Mısır diyarından çıktığın günlerde olduğu gibi,","poem":1},{"text":"onlara şaşılacak şeyler göstereceğim.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uluslar görüp bütün zorbalıklarından utanacaklar.","poem":1},{"text":"Ellerini ağızlarına koyacaklar.","poem":2},{"lineBreak":true},{"text":"Kulakları sağır olacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yılan gibi toprak yalayacaklar.","poem":1},{"text":"Yerin sürüngenleri gibi, inlerinden titreyerek çıkacaklar.","poem":2},{"lineBreak":true},{"text":"Tanrımız Yahve'ye korkuyla gelecekler,","poem":2},{"lineBreak":true},{"text":"ve senden ötürü korkacaklar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Suçları bağışlayan, mirasının kalanının itaatsizliğinin üzerinden geçen","poem":1},{"text":"senin gibi Tanrı kimdir?","poem":2},{"text":"Sonsuza dek öfkesini tutmaz,","poem":1},{"text":"çünkü sevgi dolu iyilikten hoşlanır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yine bize acıyacak.","poem":1},{"text":"Suçlarımızı ayaklar altına alacak.","poem":2},{"lineBreak":true},{"text":"Onların bütün günahlarını denizin derinliklerine atacaksın.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Eski günlerden beri atalarımıza ant içtiğin gibi,","poem":1},{"text":"Yakov'a sadakat,","poem":2},{"lineBreak":true},{"text":"Avraham'a da merhamet göstereceksin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}