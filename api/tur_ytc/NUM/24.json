{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"NUM","translationId":"tur_ytc","name":"SAYILAR","commonName":"SAYILAR","title":"SAYILAR","order":4,"numberOfChapters":36,"sha256":"c68bd541fafc2c3b6c0ddc49af74411a332c96c041b8c62066be8452d7f5e4bc","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/tur_ytc/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Balam, Yahve'nin İsrael'i kutsamaktan hoşnut olduğunu görünce, diğer seferler olduğu gibi kehanete başvurmak yerine yüzünü çöle çevirdi."]},{"type":"verse","number":2,"content":["Balam gözlerini kaldırdı ve İsrael'in oymaklarına göre oturduğunu gördü; ve onun üzerine Tanrı'nın Ruhu geldi."]},{"type":"verse","number":3,"content":["Benzetmesini şöyle sürdürdü ve dedi:",{"text":"“Beor oğlu Balam diyor ki,","poem":1},{"text":"gözleri açık olan adam diyor ki;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tanrı'nın sözlerini duyan,","poem":1},{"text":"Her Şeye Gücü Yeten'in görümünü gören,","poem":2},{"lineBreak":true},{"text":"yere kapanıp gözleri açılmış olan şöyle diyor:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çadırların ne kadar güzel,","poem":1},{"text":"ey Yakov, konutların da, ey İsrael!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vadiler gibi, ırmak kıyısındaki bahçeler gibi,","poem":1},{"text":"Yahve'nin diktiği öd ağaçları gibi,","poem":2},{"lineBreak":true},{"text":"su kıyısındaki sedir ağaçları gibi yayıldılar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onun kovalarından su akacaktır.","poem":1},{"text":"Onun tohumu birçok sularda olacaktır.","poem":2},{"lineBreak":true},{"text":"Onun Kralı Agag'dan daha üstün olacaktır.","poem":2},{"lineBreak":true},{"text":"Onun krallığı yüceltilecektir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tanrı onu Mısır'dan çıkarıyor.","poem":1},{"text":"Onun yaban öküzü gibi gücü var.","poem":2},{"lineBreak":true},{"text":"Düşmanları olan ulusları tüketecek, kemiklerini kıracak","poem":2},{"lineBreak":true},{"text":"ve oklarıyla onları delecektir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çömeldi, aslan gibi yattı,","poem":1},{"text":"dişi aslan gibi; onu kim kaldıracak?","poem":2},{"lineBreak":true},{"text":"Seni kutsayan herkes kutsansın.","poem":2},{"lineBreak":true},{"text":"Seni lanetleyen herkes lanetlensin.”","poem":2}]},{"type":"verse","number":10,"content":["Balak'ın öfkesi Balam'a karşı alevlendi ve ellerini birbirine vurdu. Balak, Balam'a şöyle dedi: “Seni düşmanlarıma lanet etmeye çağırdım ve işte, onları bu üç keredir yalnızca kutsadın."]},{"type":"verse","number":11,"content":["Bu nedenle şimdi yerine koş! Seni büyük bir saygınlıkla yükseltmeyi düşünmüştüm; ama işte, Yahve seni saygınlıktan yoksun bıraktı.”"]},{"type":"verse","number":12,"content":["Balam Balak'a şöyle dedi: “Bana gönderdiğin ulaklarına:"]},{"type":"verse","number":13,"content":["'Eğer Balak bana altın ve gümüş dolu evini verse bile, kendi fikrimle iyilik ya da kötülük etmek için Yahve'nin sözünün dışına çıkamam. Yahve'nin söylediğini söyleyeceğim' diye dememiş miydim?"]},{"type":"verse","number":14,"content":["İşte şimdi halkımın yanına gidiyorum. Gel, bu halkın son günlerde senin halkına ne yapacaklarını sana bildireyim.”"]},{"type":"verse","number":15,"content":["Benzetmesini şöyle sürdürdü ve dedi:",{"text":"“Beor oğlu Balam diyor ki,","poem":1},{"text":"gözleri açık olan adam şöyle diyor;","poem":2}]},{"type":"verse","number":16,"content":["Tanrı'nın sözlerini duyan,",{"text":"Yüceler Yücesi'nin bilgisini bilen","poem":2},{"lineBreak":true},{"text":"ve yere kapanıp gözleri açık olarak","poem":2},{"lineBreak":true},{"text":"Her Şeye Gücü Yeten'in görümünü gören şöyle diyor:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Onu görüyorum, ama şimdi değil.","poem":1},{"text":"Ona bakıyorum ama yakın değil.","poem":2},{"lineBreak":true},{"text":"Yakov'dan bir yıldız çıkacak. İsrael'den bir asa yükselecek,","poem":2},{"lineBreak":true},{"text":"Moav'ı dört bir yanından vuracak","poem":2},{"lineBreak":true},{"text":"ve Şet'in bütün oğullarını ezecek.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Edom mülk olacak.","poem":1},{"text":"İsrael yiğitçe bunu yaparken,","poem":2},{"lineBreak":true},{"text":"düşmanı Seir de mülk olacak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yakov'dan biri hüküm sürecek,","poem":1},{"text":"ve kentte artakalanları yok edecek.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amalek'e baktı, benzetmesini sürdürüp şöyle dedi:","poem":1},{"text":"“Amalek ulusların birincisiydi, ama onun sonu yıkım olacak.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kenli'ye baktı ve benzetmesini sürdürüp şöyle dedi:","poem":1},{"text":"“Mesken yerin güçlüdür.","poem":2},{"lineBreak":true},{"text":"Senin yuvan kaya içine koyulmuştur.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yine de Aşur seni tutsak alana dek","poem":1},{"text":"Keni harap olacaktır.”","poem":2}]},{"type":"verse","number":23,"content":["Benzetmesini sürdürdü ve şöyle dedi:",{"text":"“Ne yazık ki, Tanrı bunu yaptığı zaman kim yaşayacak?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ama Kittim kıyısından gemiler gelecek.","poem":1},{"text":"Aşur'u ve Ever'i sarsacaklar.","poem":2},{"lineBreak":true},{"text":"O da yıkıma uğrayacaktır.”","poem":2}]},{"type":"verse","number":25,"content":["Balam kalkıp gitti ve yerine döndü; Balak da kendi yoluna gitti."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}