{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["İsrael Kralı David oğlu Solomon'un özdeyişleri:"]},{"type":"verse","number":2,"content":[{"text":"Bilgeliği ve terbiyeyi bilmek,","poem":1},{"text":"anlayış sözlerini fark etmek,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"bilgece hareket etmek, terbiye edinip doğru,","poem":1},{"text":"haklı ve adil olanı yapmak,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"saf insana sağduyu,","poem":1},{"text":"genç insana bilgi ve sağgörü vermek,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"böylece sağlam öğüde ulaşabilmek için bilge kişi işitsin,","poem":1},{"text":"bilgisini artırsın,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"özdeyişi ve benzetmeyi, bilgelerin sözlerini","poem":1},{"text":"ve bilmecelerini anlasın.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve","poem":1},{"noteId":0},{"text":"korkusu bilginin başlangıcıdır,","poem":1},{"text":"ama akılsızlar bilgeliği ve terbiyeyi küçümser.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oğlum, babanın uyarısını dinle,","poem":1},{"text":"annenin öğretisini bırakma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü bunlar başını süsleyecek bir çelenk,","poem":1},{"text":"boynun için zincir olacaktır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oğlum, eğer günahkârlar seni ayartmaya kalkarsa","poem":1},{"text":"razı olma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eğer derlerse, “Bizimle gel, kan için pusuya yatalım,","poem":1},{"text":"sebepsiz yere masumları gizlice bekleyelim,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"onları Şeol","poem":1},{"noteId":1},{"text":"gibi diri diri, çukura inenler gibi","poem":1},{"text":"bütün olarak yutalım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Her türden değerli mal bulur,","poem":1},{"text":"evlerimizi ganimetle doldururuz.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aramızda senin de payın olsun.","poem":1},{"text":"Tek bir kesemiz olacak.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oğlum yolda onlarla yürüme.","poem":1},{"text":"Ayağını onların yolundan uzak tut.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü onların ayakları kötülüğe koşar.","poem":1},{"text":"Kan dökmek için acele ederler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ağ kuşun gözü önünde boşuna serilir,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"bunların yatıp beklemesi kendi kanları içindir.","poem":1},{"text":"Gizlice pusuya yatmaları kendi yaşamları içindir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kazanca düşkün olan herkesin yolları böyledir.","poem":1},{"text":"Sahiplerinin canını alır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bilgelik yüksek sesle sokaktan çağırıyor.","poem":1},{"text":"Meydanlardan ses veriyor.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gürültülü yerlerin başından çağırıyor.","poem":1},{"text":"Kent kapılarının girişinde sözlerini dile getiriyor:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Ey saf adamlar, saflığı ne zamanda dek seveceksiniz?","poem":1},{"text":"Alaycılar ne zamana dek alaycılıktan zevk alacak,","poem":2},{"lineBreak":true},{"text":"akılsızlar bilgelikten nefret edecek?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Azarladığımda geri dönün. İşte,","poem":1},{"noteId":2},{"text":"Ruhumu üzerinize dökeceğim.","poem":1},{"text":"Size sözlerimi bildireceğim.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çünkü sizi çağırdım ve siz reddettiniz,","poem":1},{"text":"elimi size uzattım ve kimse dikkate almadı,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ama bütün öğütlerimi görmezden geldiniz,","poem":1},{"text":"uyarılarımın hiçbirini istemediniz.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ben de felaketinize güleceğim.","poem":1},{"text":"Bela sizi yakaladığında,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"fırtına gibi bela sizi yakaladığında,","poem":1},{"text":"felaket kasırga gibi üzerinize geldiğinde,","poem":2},{"lineBreak":true},{"text":"sıkıntı ve endişe üzerinize indiğinde, sizinle alay edeceğim.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"O zaman beni çağıracaksınız,","poem":1},{"text":"ama yanıtlamayacağım.","poem":2},{"lineBreak":true},{"text":"Beni canla başla arayacaksınız,","poem":2},{"lineBreak":true},{"text":"ama bulamayacaksınız,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Çünkü bilgiden nefret ettiler,","poem":1},{"text":"Yahve korkusunu seçmediler.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hiçbir öğüdümü istemediler.","poem":1},{"text":"Bütün uyarılarımı küçümsediler.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bu nedenle kendi yollarının ürününü yiyecekler,","poem":1},{"text":"kendi entrikalarına doyacaklar.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Çünkü saf insanların yoldan sapmaları","poem":1},{"text":"onları öldürecek.","poem":2},{"lineBreak":true},{"text":"Akılsızların dikkatsiz rahatlığı onları yok edecektir.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ama kim beni dinlerse güvenlik içinde oturacak,","poem":1},{"text":"zarar görme korkusu duymadan rahat edecektir.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":1,"verse":7}},{"noteId":1,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":1,"verse":12}},{"noteId":2,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":1,"verse":23}}]},"thisChapterLink":"/api/tur_ytc/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}