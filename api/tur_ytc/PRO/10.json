{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Solomon'un özdeyişleri.","poem":1},{"text":"Bilge oğul babasını sevindirir,","poem":2},{"lineBreak":true},{"text":"ama akılsız oğul annesine keder getirir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kötülüğün hazineleri hiçbir işe yaramaz,","poem":1},{"text":"ama doğruluk ölümden kurtarır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve doğruların canının aç kalmasına izin vermez,","poem":1},{"text":"ama kötülerin dileğini iter.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tembel elle çalışan yoksullaşır,","poem":1},{"text":"ama özenle çalışanın eli servet getirir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yazın toplayan bilge oğuldur,","poem":1},{"text":"hasatta uyuyan oğul utanç getirir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bereket doğru insanın başı üzerindedir,","poem":1},{"text":"ama kötülerin ağzını zorbalık kaplar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Doğruların anısı kutsanır,","poem":1},{"text":"ama kötülerin adı çürür.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yüreğinde bilge olan buyrukları kabul eder,","poem":1},{"text":"ama gevezelik eden budala düşer.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kusursuzca yürüyen emin yürür,","poem":1},{"text":"ama yolları sapkın olan belli olur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Göz kırpan kedere neden olur,","poem":1},{"text":"gevezelik eden budala düşer.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Doğrunun ağzı yaşam pınarıdır,","poem":1},{"text":"ama kötülerin ağzını zorbalık kaplar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nefret çekişmeyi körükler,","poem":1},{"text":"ama sevgi tüm hataları örter.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bilgelik sezgiye sahip olanın dudaklarında bulunur,","poem":1},{"text":"ama değnek anlayıştan yoksun olanın sırtı içindir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bilge kişi bilgi biriktirir,","poem":1},{"text":"ama akılsızın ağzı yıkıma yakındır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zenginin serveti onun güçlü kentidir.","poem":1},{"text":"Fakirin yoksulluğu onun yıkımıdır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Doğrunun emeği yaşama yol açar.","poem":1},{"text":"Kötünün geliri günaha yol açar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Düzeltilmeyi önemseyen kişi yaşam yolundadır,","poem":1},{"text":"ama azarı terk eden başkalarını saptırır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nefreti gizleyen insanın yalancı dudakları vardır.","poem":1},{"text":"İftira atan budaladır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sözlerin çokluğunda itaatsizlik eksik olmaz,","poem":1},{"text":"ama dudaklarını tutan bilgece davranır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Doğru insanın dili seçme gümüş gibidir.","poem":1},{"text":"Kötülerin yüreğinin değeri azdır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doğruların dudakları birçok kişiyi besler,","poem":1},{"text":"ama budalalar anlayış yoksunluğundan ölür.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yahve'nin bereketi servet getirir,","poem":1},{"text":"ve O buna hiç dert katmaz.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kötülük yapmak akılsızın zevkidir,","poem":1},{"text":"ama bilgelik de anlayışlı adamın zevkidir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kötünün korkusu başına gelir,","poem":1},{"text":"ama doğruların dileği kabul edilir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kasırga geçtiği zaman kötü kişi kalmaz,","poem":1},{"text":"ama doğrular daima sağlam durur.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dişler için sirke, gözler için duman neyse,","poem":1},{"text":"kendisini gönderenler için tembel de öyledir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yahve korkusu günleri uzatır,","poem":1},{"text":"ama kötülerin günleri kısalır.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Doğruların umudu sevinçtir,","poem":1},{"text":"ama kötülerin umudu yok olur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yahve'nin yolu doğrular için kaledir,","poem":1},{"text":"ama kötülüğün işçileri için yıkımdır.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Doğrular asla ortadan kaldırılmaz,","poem":1},{"text":"ama kötüler ülkede oturamaz.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Doğrunun ağzı bilgelik üretir,","poem":1},{"text":"ama sapık dil kesilecektir.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Doğrunun dudakları neyin uygun olduğunu bilir,","poem":1},{"text":"ama kötülerin ağzı sapkındır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}