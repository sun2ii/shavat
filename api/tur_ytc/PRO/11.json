{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Hileli terazi Yahve için iğrençtir,","poem":1},{"text":"ama doğru tartı O'nun sevincidir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gurur gelince ardından utanç gelir,","poem":1},{"text":"ama alçakgönüllülükle bilgelik gelir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Doğruların dürüstlüğü onlara yol gösterir,","poem":1},{"text":"ama hainlerin sapkınlığı onları yok eder.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gazap gününde zenginlik fayda getirmez,","poem":1},{"text":"ama doğruluk ölümden kurtarır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Masumun doğruluğu ona yol gösterir,","poem":1},{"text":"ama kötü kişi kendi kötülüğüyle düşer.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğruların dürüstlüğü onları kurtarır,","poem":1},{"text":"ama sadık olmayan kişi kötü arzular tarafından tuzağa düşürülür.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötü kişi öldüğünde umut yok olur,","poem":1},{"text":"güç beklentisi ise boşa çıkar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Doğru kişi sıkıntıdan kurtulur,","poem":1},{"text":"onun yerini kötüler alır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanrısız kişi ağzıyla komşusunu yok eder,","poem":1},{"text":"ama doğrular bilgi sayesinde kurtulur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Doğruların işi yolunda gittiğinde kent sevinir.","poem":1},{"text":"Kötüler yok edilince bağrış vardır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dürüstlerin bereketiyle kent yükselir,","poem":1},{"text":"ama kötülerin ağzıyla kent yıkılır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Komşusunu küçümseyen bilgelikten yoksundur,","poem":1},{"text":"anlayışlı kişi esenliğini korur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dedikodu getiren kişi güvene ihanet eder,","poem":1},{"text":"güvenilir ruhlu kişi sır saklayandır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bilgece rehberliğin olmadığı yerde ulus düşer,","poem":1},{"text":"ama öğüt verenlerin çokluğunda zafer vardır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yabancı birine kefil olan kişi bunun acısını çeker,","poem":1},{"text":"teminat vermeyi reddeden kişi güvendedir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Merhametli kadın onur kazanır,","poem":1},{"text":"ama zorba erkekler zenginlik kazanır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Merhametli kişi kendi canına iyilik eder,","poem":1},{"text":"ama gaddar olan kendi bedenine sıkıntı verir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kötü kişi aldatıcı ücret kazanır,","poem":1},{"text":"ama doğruluk eken sağlam bir ödül biçer.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İçtenlikle doğru olan yaşam elde eder.","poem":1},{"text":"Kötülüğün peşinde olan ölüm elde eder.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yürekte sapkın olanlar Yahve için iğrençtir,","poem":1},{"text":"ama yolları kusursuz olanlar O'nun sevincidir.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kesinlikle kötü kişi cezasız kalmaz,","poem":1},{"text":"ama doğruların soyu","poem":2},{"noteId":7},{"text":"kurtulur.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Domuzun burnunda altın halka neyse,","poem":1},{"text":"sağduyudan yoksun olan güzel kadın da öyledir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Doğru insanın dileği yalnızca iyiliktir.","poem":1},{"text":"Kötülerin beklentisi gazaptır.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dağıtan ve daha da artıran birisi vardır.","poem":1},{"text":"Uygun olandan fazlasını alıkoyan ama yoksullaşan birisi vardır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Özgür can semiz olur.","poem":1},{"text":"Sulayanın kendisi de sulanacaktır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Halk buğday alıkoyanı lanetler,","poem":1},{"text":"ama kutsama onu satanın başı üzerindedir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İyiliği özenle arayan lütuf arar,","poem":1},{"text":"ama kötülüğü araştıranın kendisine kötülük gelir.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Zenginliğine güvenen düşer,","poem":1},{"text":"ama doğrular yeşil yaprak gibi gelişir.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kendi evini sıkıntıya sokanın mirası yeldir.","poem":1},{"text":"Akılsız kişi yüreği bilge olanın hizmetkârı olur.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Doğrunun meyvesi yaşam ağacıdır.","poem":1},{"text":"Bilge kişi canlar kazanır.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"İşte, yeryüzünde doğrulardan hesabı soruluyor,","poem":1},{"text":"kötülerle günahkarlardan ne kadar daha çok sorulacak!","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"veya tohum","reference":{"chapter":11,"verse":21}}]},"thisChapterLink":"/api/tur_ytc/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}