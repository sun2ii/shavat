{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Düzeltilmeyi seven bilgiyi sever,","poem":1},{"text":"ama azarlanmaktan nefret eden ahmaktır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İyi insan Yahve'den lütuf bulur,","poem":1},{"text":"ama O, kötü niyetleri olan insanı mahkûm eder.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İnsan kötülükle sağlamlaşmaz,","poem":1},{"text":"ama doğruların kökü sarsılmaz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Değerli kadın kocasının tacıdır,","poem":1},{"text":"ama utandıran kadın onun kemiklerindeki çürük gibidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doğruların düşünceleri adildir,","poem":1},{"text":"ama kötülerin öğüdü aldatıcıdır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kötülerin sözleri kan için pusuya yatmaktır,","poem":1},{"text":"ama doğruların konuşması onları kurtarır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötüler yıkılır ve yok olur,","poem":1},{"text":"ama doğruların evi ayakta kalır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İnsan bilgeliğine göre övülür,","poem":1},{"text":"ama çarpık zihne sahip kişi küçümsenir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Az tanınan ve bir hizmetçisi olan kişi,","poem":1},{"text":"kendini onurlandıran ve ekmeği olmayandan daha iyidir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Doğru kişi hayvanının hayatına saygı duyar,","poem":1},{"text":"ama kötünün sevecen merhameti zalimdir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Toprağını işleyenin bol ekmeği olur,","poem":1},{"text":"ama hayaller peşinde koşan anlayıştan yoksundur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kötüler kötülerin ganimetini arzular,","poem":1},{"text":"ama doğruların kökü gelişir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kötü kişi dudaklarının günahıyla kapana kıstırılır,","poem":1},{"text":"ama doğru kişi sıkıntıdan kurtulur.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İnsan ağzının meyvesiyle iyiliğe doyar.","poem":1},{"text":"Ellerinin işine göre insan ödüllendirilir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akılsızın yolu kendi gözünde doğrudur,","poem":1},{"text":"ama bilge kişi öğüdü dinler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akılsız öfkesini aynı gün belli eder,","poem":1},{"text":"ama hakareti görmezden gelen kişi sağduyuludur.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doğru sözlü dürüstçe tanıklık eder,","poem":1},{"text":"ama yalancı tanık yalan söyler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İnsan var ki, düşünmeden delip geçen kılıç gibi konuşur,","poem":1},{"text":"ama bilgelerin dili şifa verir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gerçeğin dudakları daima durur,","poem":1},{"text":"ama yalancı dil yalnızca geçicidir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hile kötülük tasarlayanların yüreğindedir,","poem":1},{"text":"ama esenliği destekleyene sevinç gelir.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doğruya hiç zarar gelmez,","poem":1},{"text":"ama kötüler kötülükle dolar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yalancı dudaklar Yahve için iğrençtir,","poem":1},{"text":"ama gerçeğe uyanlar O'nun sevincidir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sağduyulu kişi bilgisini korur,","poem":1},{"text":"ama akılsızların yürekleri ahmaklıklarını beyan eder.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çalışkanların elleri yönetir,","poem":1},{"text":"ama tembellik kölelikle sonuçlanır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yüreğindeki kaygı insanı çökertir,","poem":1},{"text":"ama hoş söz onun yüreğini sevindirir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Doğru kişi dostluk konusunda dikkatlidir,","poem":1},{"text":"ama kötülerin yolu onları saptırır.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tembel kişi avını pişirmez,","poem":1},{"text":"ama çalışkanların malları değerlidir.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Doğruluğun yolu yaşamdır,","poem":1},{"text":"onun yolunda ölüm yoktur.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}