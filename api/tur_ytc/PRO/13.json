{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Bilge oğul babasının öğrettiğini dinler,","poem":1},{"text":"ama alaycı azarı dinlemez.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dudaklarının meyvesiyle insan iyi şeylerden zevk alır,","poem":1},{"text":"ama sadakatsizler zorbalığa can atar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ağzını tutan canını korur.","poem":1},{"text":"Dudaklarını geniş açan mahvolur.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tembelin canı çeker ve hiçbir şeyi yoktur,","poem":1},{"text":"ama çalışkanın arzusu tümüyle karşılanır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doğru kişi yalandan nefret eder,","poem":1},{"text":"ama kötü kişi utanç ve rezalet getirir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğruluk dürüstlüğün yolunu korur,","poem":1},{"text":"ama kötülük günahkârı alaşağı eder.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bazıları var ki, hiçbir şeyi yokken kendini zengin gösterir,","poem":1},{"text":"Bazıları var ki, çok malı varken kendini yoksul gösterir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bir insanın hayatının fidyesi zenginliğidir,","poem":1},{"text":"ama yoksul tehditleri duymaz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Doğruların ışığı parlak yanar,","poem":1},{"text":"ama kötülerin kandili söner.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kibir yalnızca kavga doğurur,","poem":1},{"text":"ama bilgelik öğüt alan insanlarladır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dürüstçe kazanılmayan servet azalır,","poem":1},{"text":"ama elle toplayan çoğaltır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ertelenen umut yüreği hasta eder,","poem":1},{"text":"ama hasret giderildiğinde yaşam ağacıdır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyarıyı küçümseyen bedelini öder,","poem":1},{"text":"ama buyruğa uyan ödüllendirilir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ölüm tuzaklarından uzaklaştırmak için,","poem":1},{"text":"bilgelerin öğretisi yaşam pınarıdır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İyi anlayış lütuf verir,","poem":1},{"text":"ama sadakatsizlerin yolu zorludur.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Her tedbirli insan bilgiyle hareket eder,","poem":1},{"text":"ama akılsız ahmaklığını sergiler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kötü haberci belaya düşer,","poem":1},{"text":"ama güvenilir elçi şifa kazanır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Terbiyeyi reddeden insana yoksulluk ve utanç gelir,","poem":1},{"text":"ama düzeltilmeyi önemseyen onurlandırılır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yerine getirilen dilek cana tatlıdır,","poem":1},{"text":"ama akılsızlar kötülükten dönmekten nefret eder.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bilgelerle yürüyen bilgelikte büyür,","poem":1},{"text":"ama akılsızların arkadaşı zarar görür.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Felaket günahkârları kovalar,","poem":1},{"text":"ama bolluk doğruları ödüllendirir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"İyi insan çocuklarının çocuklarına miras bırakır,","poem":1},{"text":"ama günahkârın serveti doğrular için saklanır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yoksulların tarlasında bol yiyecek vardır,","poem":1},{"text":"ama adaletsizlik onu süpürüp atar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Değneği esirgeyen, oğlundan nefret eder,","poem":1},{"text":"ama onu seven terbiye etmeye dikkat eder.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Doğru kişi canı doyana kadar yer,","poem":1},{"text":"ama kötünün karnı aç kalır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}