{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Her bilge kadın kendi evini yapar,","poem":1},{"text":"ama ahmak kadın onu kendi elleriyle yıkar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Doğruluğunda yürüyen kişi Yahve'den korkar,","poem":1},{"text":"ama yollarında sapkın olan kişi O'nu küçümser.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahmağın konuşması sırtına değnek getirir,","poem":1},{"text":"ama bilgelerin dudakları kendilerini korur.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Öküzlerin olmadığı yerde, yemlik temizdir,","poem":1},{"text":"ama bol artış öküzün gücündendir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doğru tanık yalan söylemez,","poem":1},{"text":"ama yalancı tanık yalan saçar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alaycı bilgelik arar ve bulamaz,","poem":1},{"text":"ama bilgi anlayışlı insana kolaylıkla gelir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akılsız kişiden uzak dur,","poem":1},{"text":"çünkü onun dudaklarında bilgi bulamazsın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tedbirli insanın bilgeliği kendi yolu hakkında düşünmektir,","poem":1},{"text":"ama akılsızların ahmaklığı hiledir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akılsızlar günahların kefaretiyle alay ederler,","poem":1},{"text":"ama doğruların arasında iyi niyet vardır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yürek kendi acısını ve sevincini bilir,","poem":1},{"text":"bunları bir yabancıyla paylaşmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kötülerin evi yıkılacak, Ama doğruların çadırı gelişip güçlenecek.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Öyle yol vardır ki, insana doğru görünür,","poem":1},{"text":"ama sonu ölüme götürür.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gülerken bile yürek kederli olabilir,","poem":1},{"text":"neşenin sonu kasvet olabilir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sadakatsiz kendi yollarının karşılığını alacaktır,","poem":1},{"text":"aynı şekilde iyi insan kendi yolları için ödüllendirilecektir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saf kişi her şeye inanır,","poem":1},{"text":"ama tedbirli kişi kendi yollarını dikkatle düşünür.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bilge kişi kötülükten korkar ve sakınır,","poem":1},{"text":"ama akılsız kişi sinirli ve düşüncesizdir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çabuk öfkelenen kişi akılsızlık eder,","poem":1},{"text":"kurnaz kişiden nefret edilir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Saf insanlar akılsızlığı miras alır,","poem":1},{"text":"ama tedbirli olanlar bilgiyle taçlanır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kötüler iyilerin önünde,","poem":1},{"text":"aşağılık olanlar da doğruların kapılarında eğilir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yoksulun kendi komşusu bile ondan uzak durur,","poem":1},{"text":"ama zenginin dostları çoktur.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Komşusunu küçümseyen günah işler,","poem":1},{"text":"ama yoksula acıyan kutsanır.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kötülük tasarlayanlar yoldan çıkmaz mı?","poem":1},{"text":"Ama sevgi ve sadakat iyilik tasarlayanlarındır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Her ağır işte kazanç vardır,","poem":1},{"text":"ama dudakların konuşması yalnızca yoksulluğa götürür.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bilgelerin tacı onların zenginliğidir,","poem":1},{"text":"ama akılsızların ahmaklığı onları ahmaklıkla taçlandırır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Doğru tanık canlar kurtarır,","poem":1},{"text":"ama yalancı tanık aldatıcıdır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yahve korkusunun içi güvenli bir kaledir,","poem":1},{"text":"O, onun çocuklarına da sığınak olur.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yahve korkusu yaşam pınarıdır,","poem":1},{"text":"insanları ölüm tuzaklarından uzaklaştırır.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kralın yüceliği halkın çokluğundadır,","poem":1},{"text":"ama halkın yokluğunda beyin yıkımı olur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Geç öfkelenen insanın anlayışı büyüktür,","poem":1},{"text":"ama çabuk öfkelenen kişi akılsızlık gösterir.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bedenin yaşamı esenlik içindeki yürektedir,","poem":1},{"text":"ama kıskançlık kemikleri çürütür.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yoksulu ezen onu Yaradanı aşağılar,","poem":1},{"text":"ama muhtaca iyilik eden O'na saygı gösterir.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kötü kişi kendi felaketiyle yıkılır,","poem":1},{"text":"ama ölümde doğrunun sığınacak yeri vardır.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bilgelik anlayışlı insanın yüreğinde durur,","poem":1},{"text":"hatta kendini akılsızların arasında bile bildirir.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Doğruluk bir ulusu yüceltir,","poem":1},{"text":"ama günah herhangi bir halk için utançtır.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kralın lütfu akıllıca davranan hizmetkârı içindir,","poem":1},{"text":"ama öfkesi utanca neden olana karşıdır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}