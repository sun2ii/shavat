{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Yumuşak yanıt gazabı yatıştırır,","poem":1},{"text":"ama sert söz öfkeyi alevlendirir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bilgelerin dili bilgiyi över,","poem":1},{"text":"ama akılsızların ağzından ahmaklık fışkırır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve'nin gözleri her yerdedir,","poem":1},{"text":"iyiyi de kötüyü de gözetler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yumuşak dil yaşam ağacıdır,","poem":1},{"text":"ama dilin içindeki hile ruhu ezer.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akılsız kişi babasının uyarısını küçümser,","poem":1},{"text":"ama azarlamaya kulak veren sağduyu gösterir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğrunun evinde çok hazine vardır,","poem":1},{"text":"ama kötülerin geliri sıkıntı getirir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bilgelerin dudakları bilgi yayar,","poem":1},{"text":"akılsızların yüreği öyle değildir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kötülerin kurbanı Yahve için iğrençtir,","poem":1},{"text":"ama doğruların duası O'nun sevincidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve kötü insanın yolundan iğrenir,","poem":1},{"text":"ama doğruluğun ardından gideni sever.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yolu bırakan kişi için katı bir terbiye vardır.","poem":1},{"text":"Azarlanmaktan nefret eden ölür.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Şeol","poem":1},{"noteId":8},{"text":"ve Avadon","poem":1},{"noteId":9},{"text":"Yahve'nin önündedir,","poem":1},{"text":"nerede kaldı ki, insanoğullarının yürekleri!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alaycı azarlanmayı sevmez,","poem":1},{"text":"bilgenin yanına gitmez.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sevinçli yürek yüzü neşelendirir,","poem":1},{"text":"ama acılı yürek ruhu kırar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anlayışlı insanın yüreği bilgi arar,","poem":1},{"text":"ama akılsızların ağzı ahmaklıktan beslenir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dertlinin bütün günleri kötüdür,","poem":1},{"text":"ama neşeli yüreğe sahip olan sürekli ziyafet çeker.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve korkusuyla olan az şey,","poem":1},{"text":"sıkıntılı büyük hazineden iyidir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sevginin olduğu yerde sebzeli akşam yemeği,","poem":1},{"text":"düşmanlığın olduğu yerdeki besili danadan iyidir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Öfkeli kişi çekişmeyi kışkırtır,","poem":1},{"text":"ama yavaş öfkelenen kavgayı yatıştırır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tembelin yolu dikenli çit gibidir,","poem":1},{"text":"ama doğruların yolu ana yoldur.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bilge oğul babasını sevindirir,","poem":1},{"text":"ahmak kişi annesini küçümser.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bilgelikten yoksun olan için ahmaklık neşedir,","poem":1},{"text":"ama anlayışlı kişi yolunu doğru tutar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Öğüdün olmadığı yerde planlar başarısız olur,","poem":1},{"text":"ama danışmanların çokluğu ile onlar pekiştirilir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sevinç insana ağzının yanıtıyla gelir,","poem":1},{"text":"doğru zamanda edilen söz ne kadar güzeldir!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Şeol'e","poem":1},{"noteId":10},{"text":"inmesin diye,","poem":1},{"text":"yaşam yolu bilge kişiyi yukarıya doğru götürür.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yahve kibirlinin evini kökünden söker,","poem":1},{"text":"ama dul kadının sınırlarına dokundurmaz.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yahve kötülerin düşüncelerinden iğrenir,","poem":1},{"text":"ama pak olanların düşüncelerinden hoşnuttur.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kazanca düşkün kişi kendi evini sıkıntıya sokar,","poem":1},{"text":"ama rüşvetten nefret eden yaşar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Doğru insanın yüreği yanıtları tartar,","poem":1},{"text":"ama kötünün ağzı kötülük fışkırtır.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yahve kötülükten uzaktır,","poem":1},{"text":"ama doğruların duasını işitir.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gözlerin ışığı yüreği sevindirir.","poem":1},{"text":"İyi haber kemiklere sağlık verir.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yaşam terbiyesini dinleyen kulak,","poem":1},{"text":"bilgelerin arasında oturur.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Düzeltilmeyi reddeden kendi canını küçümser,","poem":1},{"text":"ama azarlamayı dinleyen anlayış kazanır.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yahve korkusu bilgelik öğretir.","poem":1},{"text":"Onurdan önce alçakgönüllülük gelir.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":15,"verse":11}},{"noteId":9,"caller":"+","text":"Avadon yıkım diyarıdır.","reference":{"chapter":15,"verse":11}},{"noteId":10,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":15,"verse":24}}]},"thisChapterLink":"/api/tur_ytc/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}