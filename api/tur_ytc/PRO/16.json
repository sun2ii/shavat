{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Yüreğin tasarıları insana aittir,","poem":1},{"text":"ama dilin yanıtı Yahve'dendir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İnsanın tüm yolları kendi gözünde temizdir,","poem":1},{"text":"ama niyetleri tartan Yahve'dir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İşlerini Yahve'ye teslim et,","poem":1},{"text":"o zaman tasarıların başarıya ulaşır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve her şeyi amacına göre yaptı,","poem":1},{"text":"evet, kötü kişiyi de kötü gün için.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yüreği kibirli olan herkes Yahve için iğrençtir,","poem":1},{"text":"kesinlikle cezasız kalmaz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kötülüğün kefareti merhamet ve gerçektir.","poem":1},{"text":"İnsan Yahve korkusuyla kötülükten ayrılır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bir insanın yolları Yahve'yi hoşnut ettiğinde,","poem":1},{"text":"düşmanlarını bile onunla barıştırır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Doğrulukla azıcık,","poem":1},{"text":"haksız çok gelirden iyidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"İnsanın yüreği gideceği yolu tasarlar,","poem":1},{"text":"ama adımlarını Yahve yönlendirir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Esinlenen hükümler kralın dudaklarındadır.","poem":1},{"text":"O kendi ağzına ihanet etmez.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Doğru terazi ve ölçekler Yahve'nindir,","poem":1},{"text":"torbadaki bütün ağırlıklar O'nun yapıtlarıdır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kralların haksızlık etmesi iğrençtir,","poem":1},{"text":"çünkü taht doğrulukla kurulur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Doğru dudaklar kralların sevincidir,","poem":1},{"text":"doğru konuşan insana değer verirler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kralın öfkesi ölümün habercisidir,","poem":1},{"text":"ama bilge kişi onu sakinleştirir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kralın yüzünün ışıltısı yaşamdır.","poem":1},{"text":"Onun lütfu bahar yağmurunun bulutu gibidir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bilgelik kazanmak altından ne kadar daha iyidir!","poem":1},{"text":"Evet, anlayış edinmek seçme gümüşten üstün tutulmalıdır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doğruların ana yolu kötülükten ayrılmaktır.","poem":1},{"text":"Yolunu koruyan kişi canını korur.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gurur yıkımdan önce gelir,","poem":1},{"text":"düşüşten önce de kibirli ruh.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kibirlilerle birlikte ganimet paylaşmaktansa,","poem":1},{"text":"Yoksullarla birlikte alçakgönüllü olmak daha iyidir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Söze kulak veren bolluk bulur,","poem":1},{"text":"Yahve'ye güvenen kutsanır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yürekte bilge olana sağduyulu denir.","poem":1},{"text":"Dudakların hoşluğu eğitimi teşvik eder.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anlayış, ona sahip olan için yaşam kaynağıdır,","poem":1},{"text":"ama akılsızların cezası ahmaklıklarıdır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bilgenin yüreği ağzına öğretir,","poem":1},{"text":"dudaklarına da bilgi katar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hoş sözler bal peteğidir,","poem":1},{"text":"cana tatlı, kemiklere sağlıktır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Öyle yol var ki, insana doğru görünür,","poem":1},{"text":"ama sonu ölüme götürür.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"İşçinin iştahı onun için çalışır,","poem":1},{"text":"boğazı onu sıkıştırır.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yaramaz kişi kötülük tasarlar.","poem":1},{"text":"Konuşması kavurucu ateş gibidir.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sapık kişi kavgayı kışkırtır.","poem":1},{"text":"Fısıltıcı yakın dostları ayırır.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Zorba adam komşusunu ayartır,","poem":1},{"text":"onu iyi olmayan bir yola götürür.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Sapıklık yapmak için göz kırpan ve","poem":1},{"text":"dudaklarını bastıran kişi kötülüğe yatkındır.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ağarmış saç yücelik tacıdır.","poem":1},{"text":"Doğru bir yaşamla erişilir.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yavaş öfkelenen kişi yiğitten iyidir,","poem":1},{"text":"kendi ruhuna hükmeden de kent ele geçirenden iyidir.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kura kucağa atılır,","poem":1},{"text":"ama onun her kararı Yahve'dendir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}