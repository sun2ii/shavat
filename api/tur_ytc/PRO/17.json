{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Huzurlu kuru bir lokma,","poem":1},{"text":"kavgayla ziyafet dolu bir evden iyidir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bilgece davranan hizmetçi,","poem":1},{"text":"utanç getiren oğula hükmeder,","poem":2},{"lineBreak":true},{"text":"kardeşler arasında mirastan pay alır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arıtma potası gümüş içindir, fırın da altın için,","poem":1},{"text":"ama yürekleri Yahve sınar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kötülük eden biri kötü dudakları dinler,","poem":1},{"text":"yalancı zararlı dile kulak verir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoksulu aşağılayan onu Yaradanı kınamış olur.","poem":1},{"text":"Felakete sevinen cezasız kalmaz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çocukların çocukları yaşlıların tacıdır,","poem":1},{"text":"çocukların görkemi anne babalarıdır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Harika konuşma bir ahmağa yakışmaz,","poem":1},{"text":"yalan söyleyen dudaklar da bir beye hiç yakışmaz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Rüşvet onu verenin gözünde değerli bir taştır,","poem":1},{"text":"nereye dönerse dönsün başarılı olur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Suçu örten kişi sevgiyi teşvik eder,","poem":1},{"text":"ama konuyu tekrarlayıp duran can dostlarını ayırır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anlayışlı insana bir azar,","poem":1},{"text":"akılsıza yüz vuruştan daha derin etki eder.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kötü kişi yalnızca isyan arar,","poem":1},{"text":"bundan ötürü ona zorba bir haberci gönderilir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İnsan ahmaklığı üzerinde bir akılsız yerine,","poem":1},{"text":"yavrularından edilmiş bir ayı ile karşılaşsın.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kim iyiliğe kötülükle karşılık verirse,","poem":1},{"text":"evinden kötülük ayrılmaz.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kavganın başlangıcı barajda gedik açmak gibidir,","poem":1},{"text":"bu nedenle kavga çıkmadan çekişmeyi bırak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kötüyü aklayan da, doğruyu mahkûm eden de,","poem":1},{"text":"Yahve için iğrençtir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akılsızın elinde bilgelik satın almak için neden para var?","poem":1},{"text":"Zaten hiç anlayışı yok.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dost her zaman sever,","poem":1},{"text":"ama sıkıntı için kardeş doğmuştur.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Anlayışı olmayan kişi el vuruşturur,","poem":1},{"text":"komşusunun önünde kefil olur.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Başkaldırıyı seven çekişmeyi sever.","poem":1},{"text":"Yüksek kapı yapan yıkım arar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yüreği sapık olan bolluk bulamaz,","poem":1},{"text":"aldatıcı dile sahip olan da sıkıntıya düşer.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akılsızın babası üzülür,","poem":1},{"text":"ahmağın babası tümüyle sevinçten yoksundur.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neşeli yürek iyi ilaçtır,","poem":1},{"text":"ama ezilmiş bir yürek kemikleri kurutur.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kötü kişi adaletin yollarını saptırmak için","poem":1},{"text":"gizlice rüşvet alır.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bilgelik anlayışlı adamın yüzünün önündedir,","poem":1},{"text":"ama akılsızın gözleri dünyanın uçlarına doğru gezinir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Akılsız oğul babasına dert,","poem":1},{"text":"onu taşıyan kadına acılık getirir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne doğruyu cezalandırmak,","poem":1},{"text":"ne de görevlileri dürüstlükleri için dövmek iyi değildir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sözünü esirgeyenin bilgisi vardır,","poem":1},{"text":"öfkesi dengeli kişi anlayışlıdır.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Akılsız bile sessiz kaldığında bilge sayılır.","poem":1},{"text":"Dudaklarını kapattığında anlayışlı diye düşünülür.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}