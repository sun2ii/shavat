{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Kendini soyutlayan kişi bencillik peşindedir,","poem":1},{"text":"her türlü sağduyuya karşı gelir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akılsız anlayıştan hoşlanmaz,","poem":1},{"text":"yalnızca kendi fikrini açığa vurmaktan hoşlanır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kötülük gelince aşağılanma da gelir,","poem":1},{"text":"utançla birlikte rezillik gelir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İnsanın ağzının sözleri derin sular gibidir.","poem":1},{"text":"Bilgelik pınarı akan bir ırmak gibidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötülerin yüzüne karşı taraf tutmak da,","poem":1},{"text":"suçsuzdan adaleti esirgemek de iyi değildir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akılsızın dudakları kavgaya girer,","poem":1},{"text":"ağzı da dayağı davet eder.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akılsızın ağzı kendisini yok eder,","poem":1},{"text":"dudakları da canına tuzaktır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dedikodu sözleri tatlı lokma gibidir,","poem":1},{"text":"insanın en derinliklerine kadar iner.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"İşinde gevşek olan kişi,","poem":1},{"text":"yıkım ustasına kardeştir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve'nin adı güçlü kuledir,","poem":1},{"text":"doğrular O'na koşar ve güvende olur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zengin insanın serveti onun güçlü kentidir,","poem":1},{"text":"kendi hayalinde aşılmaz bir sur gibidir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yıkımdan önce insanın yüreği gururlanır,","poem":1},{"text":"ama onurdan önce alçakgönüllülük gelir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dinlemeden yanıt vermek,","poem":1},{"text":"insan için ahmaklık ve utançtır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hastalıkta insanın ruhu ona destek olur,","poem":1},{"text":"ama ezilmiş ruha kim dayanabilir?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akıllı insanın yüreği bilgi edinir,","poem":1},{"text":"bilgelerin kulağı bilgi arar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İnsanın armağanı ona yer açar,","poem":1},{"text":"onu büyüklerin önüne getirir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Davasını ilk savunan haklı görünür,","poem":1},{"text":"ta ki başkası gelip onu sorgulayana dek.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kura anlaşmazlıkları çözer,","poem":1},{"text":"güçlüleri ayırır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kırgın kardeş surlu kentten daha zordur.","poem":1},{"text":"Çekişmeler kale sürgüleri gibidir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"İnsanın karnı ağzının meyvesiyle,","poem":1},{"text":"dudaklarının ürünüyle doyar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ölüm ve yaşam dilin gücündedir,","poem":1},{"text":"onu sevenler onun ürününü yiyecekler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Eş bulan iyilik bulur,","poem":1},{"text":"ve Yahve'nin lütfunu erer.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yoksul merhamet diler,","poem":1},{"text":"zengin sert yanıt verir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çok dostu olan kişi mahvolabilir,","poem":1},{"text":"ama kardeşten daha yakın olan dost vardır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}