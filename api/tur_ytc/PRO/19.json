{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Kendi dürüstlüğünde yürüyen yoksul,","poem":1},{"text":"akılsız olup da dudakları sapık olandan iyidir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bilgisiz heves de,","poem":1},{"text":"aceleci ayaklarla yolu kaçırmak da iyi değildir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İnsanın akılsızlığı kendi yolunu yıkar,","poem":1},{"text":"yüreği Yahve'ye karşı öfkelenir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Servet birçok dost ekler,","poem":1},{"text":"ama yoksul dostundan ayrılır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yalancı tanık cezasız kalmaz,","poem":1},{"text":"yalanlar saçan özgür kalmaz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Birçokları hükümdarın lütfunu diler,","poem":1},{"text":"herkes hediye verenin dostudur.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yoksulun bütün akrabaları ondan uzak durur,","poem":1},{"text":"dostları ne kadar daha uzak duracaktır!","poem":2},{"lineBreak":true},{"text":"Yalvarışlarla peşlerinden koşar, ama onlar gitmiştir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bilgelik edinen kendi canını sever.","poem":1},{"text":"Anlayışı tutan iyilik bulur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yalancı tanık cezasız kalmaz.","poem":1},{"text":"Yalan söyleyen yok olur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İnce bir yaşam akılsıza yakışmaz,","poem":1},{"text":"hizmetçinin beylere hükmetmesi de hiç yakışmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sağduyu insanı yavaş öfkelendirir.","poem":1},{"text":"Suçu görmezden gelmek onun yüceliğidir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kralın öfkesi aslanın kükremesine benzer,","poem":1},{"text":"ama lütfu çayır üzerindeki çiğ gibidir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akılsız bir oğul babasının felaketidir.","poem":1},{"text":"Bir kadının ağız kavgası kesintisiz bir damladır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ev ve zenginlik babalardan mirastır,","poem":1},{"text":"ama sağduyulu kadın Yahve'dendir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tembellik derin bir uyku içine atar.","poem":1},{"text":"Avare can açlık çeker.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Buyruğu tutan canını korur,","poem":1},{"text":"ama kendi yollarını küçümseyen ölür.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoksula acıyan Yahve'ye ödünç verir,","poem":1},{"text":"O da onu ödüllendirir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Oğlunu terbiye et, çünkü umut var,","poem":1},{"text":"onun ölümüne gönüllü ortak olma.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Öfkeli kişi cezasını çekmelidir,","poem":1},{"text":"çünkü onu kurtarırsan, bunu tekrar yapman gerekir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Öğüdü dinle, terbiyeyi kabul et ki,","poem":1},{"text":"kendi sonunda bilge olasın.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"İnsanın yüreğinde çok tasarılar vardır,","poem":1},{"text":"ama Yahve'nin öğüdü galip gelir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kişiyi arzu edilir kılan şey iyiliğidir.","poem":1},{"text":"Yoksul biri yalancıdan iyidir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yahve korkusu yaşama, ardından doygunluğa götürür,","poem":1},{"text":"o kişi dinlenir ve sıkıntı ona dokunmaz.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tembel elini tabağa sokar,","poem":1},{"text":"onu ağzına geri getirmek bile istemez.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Alaycıyı döv saf kişi sağduyu öğrenir,","poem":1},{"text":"anlayışlı kişiyi azarla bilgi kazanır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Babasını soyan ve annesini kovan kişi,","poem":1},{"text":"utanca neden olan ve yüz karası getiren bir oğuldur.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Eğer öğüt dinlemeyi bırakırsan oğlum,","poem":1},{"text":"Bilgi sözlerinden saparsın.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bozuk tanık adaletle alay eder,","poem":1},{"text":"kötülerin ağzı kötülük yutar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Alaycılar için cezalar,","poem":1},{"text":"akılsızların sırtı için dayaklar hazırdır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}