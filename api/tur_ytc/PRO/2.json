{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Oğlum, eğer sözlerimi kabul edersen,","poem":1},{"text":"buyruklarımı içinde saklarsan,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kulağını bilgeliğe çevirirsen,","poem":1},{"text":"yüreğini anlayışa yöneltirsen,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"evet, ayırt etmeyi çağırırsan,","poem":1},{"text":"anlayış için sesini yükseltirsen,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"eğer onu gümüş arar gibi ararsan,","poem":1},{"text":"saklı hazineler gibi onu araştırırsan,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"o zaman Yahve korkusunu anlayacak,","poem":1},{"text":"Tanrı","poem":2},{"noteId":3},{"text":"bilgisini bulacaksın.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü Yahve bilgelik verir.","poem":1},{"text":"O'nun ağzından bilgi ve anlayış çıkar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O doğrular için sağlam bilgelik saklar.","poem":1},{"text":"O dürüstçe yürüyenlere kalkandır,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ta ki, adalet yollarına bekçilik etsin,","poem":1},{"text":"Kutsallarının yolunu korusun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O zaman doğruluk ve adaleti,","poem":1},{"text":"hakkı ve her iyi yolu anlarsın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü bilgelik yüreğine girecek.","poem":1},{"text":"Bilgi canına tatlı gelecek.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sağgörü sana göz kulak olacak.","poem":1},{"text":"Anlayış seni koruyacak,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kötülük yolundan,","poem":1},{"text":"sapık şeyler konuşan adamlardan,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onlar ki, karanlığın yollarında yürümek için","poem":1},{"text":"doğruluk yolundan ayrılır,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kötülük yapmaktan sevinç duyar,","poem":1},{"text":"kötülüğün sapkınlığından zevk alırlar,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"yollarında eğri,","poem":1},{"text":"kendi patikalarında dik başlıdırlar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Seni yabancı kadınlardan,","poem":1},{"text":"sözleriyle yaltaklanan,","poem":2},{"lineBreak":true},{"text":"o yabancı kadınlardan kurtaracak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"O ki, gençlik dostunu bırakan,","poem":1},{"text":"Tanrısı'nın antlaşmasını unutandır,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"çünkü o kadının evi ölüme,","poem":1},{"text":"yolları göçüp gitmiş olan ruhlara götürür.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ona giden hiç kimse geri dönmez,","poem":1},{"text":"yaşam yollarına ulaşamazlar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bu nedenle iyilerin yolunda yürü,","poem":1},{"text":"doğruların yollarını koru.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü ülkede doğrular oturacak.","poem":1},{"text":"Kusursuzlar orada kalacak.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kötüler ülkeden kesilip atılacak.","poem":1},{"text":"Hainler ülkeden sökülecek.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":2,"verse":5}}]},"thisChapterLink":"/api/tur_ytc/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}