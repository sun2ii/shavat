{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Şarap alaycı, içki kavgacıdır.","poem":1},{"text":"Onlar tarafından baştan çıkarılan bilge değildir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kralın dehşeti aslanın kükremesi gibidir.","poem":1},{"text":"Onu öfkelendiren kendi yaşamını kaybeder.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kavgadan uzak durmak insan için onurdur,","poem":1},{"text":"her ahmak kavga eder.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tembel kış diye çift sürmez,","poem":1},{"text":"bu nedenle hasatta dilenir ve hiçbir şeyi olmaz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İnsanın yüreğindeki niyet derin su gibidir,","poem":1},{"text":"ama anlayışlı kişi onu çekip çıkarır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Birçok insan sevgisinin güvenilir olduğunu iddia eder,","poem":1},{"text":"ama sadık birini kim bulabilir?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Doğru kişi dürüstlük içinde yürür,","poem":1},{"text":"ne mutlu kendisinden sonraki çocuklarına.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yargı tahtında oturan kral,","poem":1},{"text":"gözleriyle tüm kötülükleri dağıtır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kim, “Yüreğimi pak kıldım.","poem":1},{"text":"Temiz ve günahsızım” diyebilir?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ağırlıkların ve ölçülerin farklı olması,","poem":1},{"text":"ikisi de Yahve için iğrençtir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çocuk bile yaptığı işin temiz ve doğru olup olmadığını,","poem":1},{"text":"eylemleriyle belli eder.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İşiten kulağı ve gören gözü,","poem":1},{"text":"ikisini de Yahve yapmıştır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uykuyu sevme, yoksa yoksullaşırsın.","poem":1},{"text":"Gözlerini aç, ekmeğe doyarsın.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Alıcı, “İyi değil, iyi değil” der,","poem":1},{"text":"ama kendi yoluna gidince övünür.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Altın ve bolca yakut vardır,","poem":1},{"text":"ama bilginin dudakları nadir bulunan mücevherdir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yabancıya kefil olanın giysilerini al,","poem":1},{"text":"onu aksi bir kadın için rehin olarak tut.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hileli yiyecek insana tatlı gelir,","poem":1},{"text":"ama sonradan ağzı çakılla dolar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tasarılar öğütle kurulur,","poem":1},{"text":"bilge yol gösterişle savaşı sürdür!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Laf taşıyan kişi sırları açığa vurur,","poem":1},{"text":"bu nedenle dudaklarını geniş açanla arkadaşlık etme.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kim babasına ya da annesine lanet ederse,","poem":1},{"text":"onun kandili koyu karanlıkta söndürülür.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Başlangıçta çabuk kazanılan miras,","poem":1},{"text":"sonunda bereketli olmaz.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Kötülüğün karşılığını vereceğim” deme,","poem":1},{"text":"Yahve'yi bekle, O seni kurtarır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yahve farklılık gösteren ağırlıklardan nefret eder,","poem":1},{"text":"dürüst olmayan terazi hoş değildir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"İnsanın adımları Yahve'dendir.","poem":1},{"text":"O zaman insan kendi yollarını nasıl anlayabilir?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kendini aceleyle adamak,","poem":1},{"text":"sonradan antlarını düşünmemek insan için bir tuzaktır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bilge kral kötüleri ayıklar,","poem":1},{"text":"harman döveni onların üzerine sürer.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İnsanın ruhu Yahve'nin kandilidir,","poem":1},{"text":"insanın en derin yerlerini araştırır.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sevgi ve sadakat kralı güvende tutar.","poem":1},{"text":"Onun tahtını sevgi destekler.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Gençlerin görkemi onların gücüdür.","poem":1},{"text":"Yaşlıların ihtişamı ak saçlarıdır.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yaralayıcı darbeler kötülüğü temizler,","poem":1},{"text":"dayak en derin yerleri arındırır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}