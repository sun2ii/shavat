{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Kralın yüreği dereler gibi Yahve'nin elindedir.","poem":1},{"text":"Onu dilediği yere çevirir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İnsanın her yolu kendi gözünde doğrudur,","poem":1},{"text":"ama yürekleri tartan Yahve'dir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Doğruluk ve adaleti yerine getirmek,","poem":1},{"text":"Yahve için kurbandan daha kabule layıktır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yüksekten bakmak ve gururlu yürek,","poem":1},{"text":"kötülerin kandili, günahtır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çalışkanın tasarıları mutlaka kazanca götürür,","poem":1},{"text":"acele eden herkes kesin olarak yoksulluğa koşar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yalancı dille hazineler edinmek,","poem":1},{"text":"ölümü arayanlar için geçici bir buğudur.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötülerin zorbalığı onları kovar,","poem":1},{"text":"çünkü doğru olanı yapmayı reddederler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Suçlunun yolu dolambaçlı,","poem":1},{"text":"ama masumun davranışı doğrudur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kavgacı bir kadınla aynı evi paylaşmaktansa,","poem":1},{"text":"damın köşesinde oturmak daha iyidir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kötünün canı kötülük çeker,","poem":1},{"text":"komşusu onun gözünde hiç merhamet bulmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Alaycı cezalandırıldığında saf kişi bilgelik kazanır.","poem":1},{"text":"Bilge kişi öğretildiğinde bilgi alır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Adil Olan, kötülerin evini göz önünde bulundurur,","poem":1},{"text":"kötüleri yıkıma uğratır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kim yoksulların feryadına kulaklarını tıkarsa,","poem":1},{"text":"o da feryat edecek ama duyulmayacaktır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gizlide verilen armağan öfkeyi,","poem":1},{"text":"örtülü rüşvet şiddetli gazabı yatıştırır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Doğru insan için adaleti yerine getirmek sevinçtir,","poem":1},{"text":"ama bu, kötülüğün işçileri için yıkımdır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anlayış yolundan ayrılan insan,","poem":1},{"text":"göçüp gitmiş olan ruhlar topluluğunda dinlenir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zevki seven yoksul olur,","poem":1},{"text":"şarap ve yağ seven zengin olmaz.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kötü insan doğru insanın fidyesidir,","poem":1},{"text":"hain de dürüstün.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kavgacı ve huysuz bir kadınla oturmaktansa,","poem":1},{"text":"çölde oturmak daha iyidir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bilgenin oturduğu yerde değerli hazine ve yağ vardır,","poem":1},{"text":"ama akılsız kişi onu yutar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doğruluğun, iyiliğin ardından giden,","poem":1},{"text":"yaşam, doğruluk ve onur bulur.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bilge adam güçlülerin kentine tırmanır,","poem":1},{"text":"onun güvendiği şeyin gücünü indirir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ağzına ve diline bekçilik eden,","poem":1},{"text":"canını sıkıntılardan korur.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gururlu ve kibirli adamın adı, “Alaycıdır”,","poem":1},{"text":"gururun kibrinde çalışır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tembelin isteği onu öldürür,","poem":1},{"text":"çünkü elleri çalışmayı reddeder.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gün boyu açgözlülükle imrenenler vardır,","poem":1},{"text":"ama doğrular verir ve esirgemez.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kötünün kurbanı iğrençtir,","poem":1},{"text":"hele onu kötü düşünceyle getirince!","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yalancı tanık yok olur.","poem":1},{"text":"Dinleyen kişi sonsuzluğa konuşur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kötü kişi yüzünü sertleştirir,","poem":1},{"text":"ama dürüst insan yollarını pekiştirir.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yahve'ye karşı ne bilgelik,","poem":1},{"text":"ne anlayış, ne de öğüt vardır.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"At savaş günü için hazırlanır,","poem":1},{"text":"ama zafer Yahve'yledir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}