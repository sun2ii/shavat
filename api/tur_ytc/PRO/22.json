{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"İyi ad büyük zenginlikten daha beğenilirdir,","poem":1},{"text":"sevgi dolu iyilik gümüş ve altından daha iyidir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zenginle yoksulun ortak yanı şu:","poem":1},{"text":"Hepsini yapan Yahve'dir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tedbirli kişi tehlikeyi görür ve saklanır,","poem":1},{"text":"ama saf kişi geçip gider ve bunun acısını çeker.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alçakgönüllülüğün ve Yahve korkusunun sonucu,","poem":1},{"text":"servet, onur ve yaşamdır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dikenler ve tuzaklar kötülerin yolundadır,","poem":1},{"text":"canını koruyan onlardan uzak durur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çocuğu gitmesi gereken yola göre eğit,","poem":1},{"text":"yaşlandığında da o yoldan ayrılmaz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zenginler yoksullara hükmeder.","poem":1},{"text":"Borç alan borç verenin hizmetkârıdır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kötülük eken bela biçer,","poem":1},{"text":"öfkesinin değneği yok olur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gözü cömert olan kutsanır,","poem":1},{"text":"çünkü yemeğini yoksullarla paylaşır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Alaycıyı kov, kavga sona erer,","poem":1},{"text":"evet, çekişmeler ve hakaretler son bulur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yürek paklığını seven,","poem":1},{"text":"lütufkâr konuşan kişi,","poem":2},{"lineBreak":true},{"text":"kralın dostudur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yahve'nin gözleri bilgiyi korur,","poem":1},{"text":"ama sadakatsizin sözlerini boşa çıkarır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tembel, “Dışarıda aslan var!","poem":1},{"text":"Sokaklarda öldürülürüm!” der.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zina eden kadının ağzı derin bir çukurdur.","poem":1},{"text":"Yahve'nin gazabı altında olan kişi oraya düşer.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akılsızlık çocuğun yüreğinde bağlıdır,","poem":1},{"text":"terbiye değneği onu ondan uzaklaştırır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kendi artışı için yoksulu ezen ve zengine veren kişi,","poem":1},{"text":"ikisi de yoksullaşır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kulağını çevir ve bilgelerin sözlerini dinle.","poem":1},{"text":"Yüreğin öğrettiklerimi uygulasın.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü onları içinde saklarsan,","poem":1},{"text":"eğer hepsi dudaklarında hazırsa hoştur bu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bugün sana, evet, sana öğretiyorum,","poem":1},{"text":"öyle ki güvenin Yahve'de olsun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sana öğüt ve bilgi içeren","poem":1},{"text":"otuz harika söz yazmadım mı?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sana gerçeği, güvenilir sözleri öğretmek","poem":1},{"text":"ve seni gönderenlere sağlam yanıtlar veresin diye.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yoksulu yoksul olduğu için sömürme,","poem":1},{"text":"muhtacı mahkemede ezme.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü Yahve onların davasını savunur,","poem":1},{"text":"onları soyanların canlarını soyar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Öfkeli kişiyle arkadaşlık etme,","poem":1},{"text":"hiddet barındıranla takılma.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yoksa onun yollarını öğrenir,","poem":1},{"text":"canını tuzağa düşürürsün.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"El vuruşturanlardan,","poem":1},{"text":"borca kefil olanlardan olma.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Eğer borcunu ödeyecek varlığın yoksa,","poem":1},{"text":"neden altındaki yatağını alsın?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Atalarının diktiği eski sınır taşını","poem":1},{"text":"yerinden oynatma.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"İşinde usta birini görüyor musun?","poem":1},{"text":"o krallara hizmet eder.","poem":2},{"lineBreak":true},{"text":"Tanınmayan insanlara hizmet etmez.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}