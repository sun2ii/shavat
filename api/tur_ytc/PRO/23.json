{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Bir hükümdarla yemeğe oturduğunda,","poem":1},{"text":"önünde olanı dikkatle düşün.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eğer iştahlı biriysen,","poem":1},{"text":"kendi boğazına bıçağı yerleştir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onun lezzetli yemeklerine heveslenme,","poem":1},{"text":"çünkü onlar hileli yemeklerdir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zengin olmak için kendini yorma.","poem":1},{"text":"Bilgeliğinle kendini dizginle.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olmayan şeye neden göz dikiyorsun?","poem":1},{"text":"Çünkü zenginlik mutlaka kanatlanır, kartal gibi gökyüzüne uçar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gözü cimri olanın yemeğini yeme,","poem":1},{"text":"onun lezzetlerini de canın çekmesin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü adam ne değer biçerse, kendisi de öyledir.","poem":1},{"text":"Sana, “Ye, iç!” der. Ama yüreği seninle değildir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yediğin lokmayı kusarsın,","poem":1},{"text":"hoş sözlerini de boşa harcarsın.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akılsızın kulağına konuşma,","poem":1},{"text":"çünkü sözlerindeki bilgeliği küçümser.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eski sınır taşını yerinden oynatma,","poem":1},{"text":"yetimlerin tarlalarına el sürme.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü onların Koruyucu'su güçlüdür.","poem":1},{"text":"Davalarını sana karşı savunur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yüreğini terbiyeye,","poem":1},{"text":"kulaklarını bilgi sözlerine ver.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Terbiyeyi çocuktan esirgeme.","poem":1},{"text":"Eğer onu değnekle döversen ölmez.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onu değnekle döversen,","poem":1},{"text":"canını da Şeol'den","poem":2},{"noteId":11},{"text":"kurtarırsın.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oğlum, eğer yüreğin bilgeyse,","poem":1},{"text":"o zaman yüreğim, evet, yüreğim sevinir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Evet, yüreğim sevinecek,","poem":1},{"text":"dudakların doğru olanı konuştuğunda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yüreğin günahkârlara imrenmesin,","poem":1},{"text":"aksine gün boyu Yahve'den kork.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gerçekten de geleceğe dair bir umut vardır,","poem":1},{"text":"umudun da yok edilemez.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Oğlum, dinle ve bilge ol,","poem":1},{"text":"yüreğini doğru yolda tut.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çok fazla şarap içenlerle,","poem":1},{"text":"ya da ete düşkün oburların arasında bulunma.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü sarhoşlar ve oburlar yoksullaşır,","poem":1},{"text":"uyuşukluk onlara paçavra giydirir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sana yaşam veren babanın sözünü dinle,","poem":1},{"text":"yaşlandığı zaman anneni küçümseme.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gerçeği satın al ve onu satma.","poem":1},{"text":"Bilgelik, terbiye ve anlayış edin.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Doğrunun babası büyük sevinç duyar.","poem":1},{"text":"Bilge çocuğun babası onunla sevinir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Babanla annen sevinsin!","poem":1},{"text":"Seni doğuran sevinsin!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Oğlum, yüreğini bana ver,","poem":1},{"text":"gözlerin yollarımda olsun.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Fahişe için derin bir çukur vardır,","poem":1},{"text":"dik başlı kadın dar bir kuyudur.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Evet, bir haydut gibi pusuda yatar,","poem":1},{"text":"insanlar arasında sadık olmayanları çoğaltır.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ah çeken kim?","poem":1},{"text":"Kim kederli?","poem":2},{"lineBreak":true},{"text":"Kim kavgalı?","poem":2},{"lineBreak":true},{"text":"Kimin yakınmaları var?","poem":2},{"lineBreak":true},{"text":"Kim boşuna yaralandı?","poem":2},{"lineBreak":true},{"text":"Kimin gözleri kan çanağı?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Şarabın başında uzun süre kalanlar, Karışık şarap aramaya gidenlerdir.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Şarabın kızıl olmasına,","poem":1},{"text":"kadehte ışıldamasına,","poem":2},{"lineBreak":true},{"text":"kolayca aşağı inivermesine bakma.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Sonunda yılan gibi ısırır,","poem":1},{"text":"engerek gibi zehirler.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Gözlerin tuhaf şeyler görür,","poem":1},{"text":"aklın da kafa karıştırıcı şeyler hayal eder.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Evet, denizin ortasında yatan,","poem":1},{"text":"ya da gemi direğinin başında yatan biri gibi olursun.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bana vurdular ama yaralanmadım!","poem":1},{"text":"Beni dövdüler ama hissetmedim!","poem":2},{"lineBreak":true},{"text":"Ne zaman ayılacağım?","poem":2},{"lineBreak":true},{"text":"Tekrar yapabilir, daha fazlasını ararım.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":23,"verse":14}}]},"thisChapterLink":"/api/tur_ytc/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}