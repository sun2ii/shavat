{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Kötü kişilere imrenme,","poem":1},{"text":"ne de onlarla birlikte olmayı dile.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü onların yürekleri zorbalık tasarlar,","poem":1},{"text":"dudakları kötülük hakkında konuşur.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ev bilgelikle yapılır,","poem":1},{"text":"anlayışla kurulur,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bilgi sayesinde odaları","poem":1},{"lineBreak":true},{"text":"her çeşit nadir ve güzel hazineyle dolar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bilge adamın büyük gücü vardır.","poem":1},{"text":"Anlayışlı adam gücünü artırır,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"çünkü bilgece rehberlikle savaşını yürütürsün,","poem":1},{"text":"zafer birçok danışmanla kazanılır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bilgelik akılsız için çok yüksektir.","poem":1},{"text":"Kent kapısında ağzını açmaz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kötülük tasarlayana","poem":1},{"text":"düzenbaz denir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akılsızın entrikaları günahtır.","poem":1},{"text":"Alaycıdan insanlar nefret eder.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sıkıntı zamanında yalpalarsan,","poem":1},{"text":"gücün azdır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ölüme götürülenleri kurtar!","poem":1},{"text":"Kıyıma sendeleyerek gidenleri durdur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Bak, bunu bilmiyorduk” dersen,","poem":1},{"text":"yürekleri tartan bunu görmez mi?","poem":2},{"lineBreak":true},{"text":"Senin canını koruyan, bunu bilmez mi?","poem":2},{"lineBreak":true},{"text":"Herkese işine göre geri vermez mi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Oğlum, bal ye, çünkü iyidir,","poem":1},{"text":"süzme bal damağına tatlıdır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bilgeliği bilmek de canın için öyledir.","poem":1},{"text":"Eğer onu bulduysan, ödülü de vardır,","poem":2},{"lineBreak":true},{"text":"umudun kesilmez.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ey kötü kişi, doğruların konutuna karşı pusuya yatma.","poem":1},{"text":"Onun dinlenme yerini yok etme.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü doğru kişi yedi kez düşer ve yeniden kalkar,","poem":1},{"text":"ama kötüler felaketle çöker.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Düşmanın düştüğünde sevinme.","poem":1},{"text":"O yıkılınca yüreğin memnun olmasın,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"yoksa Yahve bunu görür ve hoşuna gitmez,","poem":1},{"text":"ve gazabını ondan çevirir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kötülük edenler yüzünden kendini üzme,","poem":1},{"text":"ne de kötülere imren,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çünkü kötü insana ödül verilmeyecek.","poem":1},{"text":"Kötülerin kandili sönecek.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Oğlum Yahve'den ve kraldan kork.","poem":1},{"text":"Başkaldıranlara katılma.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü onların felaketi ansızın gelir.","poem":1},{"text":"Her ikisinden de nasıl bir yıkım geleceğini kim bilir?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bunlar da bilgelerin sözleridir:","poem":1},{"text":"Yargıda taraf tutmak iyi değildir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kötüye, “Sen doğrusun” diyeni,","poem":1},{"text":"halklar lanetler ve uluslar ondan tiksinir,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ama suçluyu mahkûm edenlerin durumu iyidir,","poem":1},{"text":"üstlerine zengin bereket gelir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Dürüst bir yanıt","poem":1},{"text":"dudakları öpmek gibidir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Dışardaki işini hazırla,","poem":1},{"text":"tarlalarını hazır duruma getir.","poem":2},{"lineBreak":true},{"text":"Ondan sonra evini yap.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Komşuna karşı nedensiz yere tanıklık etme.","poem":1},{"text":"Dudaklarınla aldatma.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Bana yaptığının aynısını ben de ona yapacağım.","poem":1},{"text":"Adama işine göre karşılık vereceğim” deme.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tembelin tarlasından,","poem":1},{"text":"anlayışsız insanın bağından geçtim.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"İşte, her yanında dikenler büyümüş,","poem":1},{"text":"üstü ısırganlarla kaplanmış,","poem":2},{"lineBreak":true},{"text":"taş duvarı da yıkılmıştı.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"O zaman gördüm, iyice düşündüm.","poem":1},{"text":"Baktım ve ders aldım:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Biraz uyku, biraz uyuklama,","poem":1},{"text":"Uyumak için biraz elleri kavuşturma,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"yoksulluğun da bir haydut gibi,","poem":1},{"text":"yokluğun silahını kuşanmış bir adam gibi öyle gelir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}