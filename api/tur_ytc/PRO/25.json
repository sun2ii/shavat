{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Bunlar da Yahuda Kralı Hizkiya'nın adamlarının derlediği,","poem":1},{"text":"Solomon'un özdeyişleridir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bir şeyi gizlemek Tanrı'nın yüceliğidir,","poem":1},{"text":"ama kralların yüceliği bir şeyi açığa çıkarmaktır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Göklerin yüksekliği ve yerin derinliği neyse,","poem":1},{"text":"kralların yürekleri de araştırılamaz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Cürufu gümüşten ayır,","poem":1},{"text":"işlenecek madde ortaya çıkar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötüleri kralın huzurundan uzaklaştır,","poem":1},{"text":"böylece onun tahtı doğrulukta pekişir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kralın önünde kendini yüceltme,","poem":1},{"text":"ya da büyüklerin arasında yer talep etme,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"çünkü gözlerinle gördüğün beyin önünde","poem":1},{"text":"aşağı indirilmendense,","poem":2},{"lineBreak":true},{"text":"sana, “Buraya çık” denmesi daha iyidir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Suçlamalarını mahkemeye getirmekte acele etme.","poem":1},{"text":"Komşun seni utandırınca, sonunda ne yapacaksın?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Davanı komşunla tartış,","poem":1},{"text":"ama başkasının güvenine ihanet etme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yoksa bunu duyan seni utandırır,","poem":1},{"text":"kötü ünün senden bir daha ayrılmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yerinde söylenen söz,","poem":1},{"text":"gümüş içinde dizilmiş altın elmalar gibidir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Altın küpe, saf altından süs neyse,","poem":1},{"text":"bilgenin azarı da söz dinleyen kulak için öyledir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hasat zamanıda karın soğuğu neyse,","poem":1},{"text":"sadık bir haberci de kendisini gönderenlere öyledir,","poem":2},{"lineBreak":true},{"text":"çünkü efendilerinin canını tazeler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yağmursuz bulutlar ve rüzgâr neyse,","poem":1},{"text":"yalan armağanlarla övünen kişi de öyledir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hükümdar sabırla ikna edilir.","poem":1},{"text":"Yumuşak dil kemiği kırar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bal buldun mu?","poem":1},{"text":"Kendine yetecek kadar ye,","poem":2},{"lineBreak":true},{"text":"yoksa çok yersen kusarsın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Komşunun evinde ayağın seyrek bulunsun,","poem":1},{"text":"yoksa bıkar ve senden nefret eder.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Komşusuna karşı yalancı tanıklık eden kişi,","poem":1},{"text":"sopa, kılıç ya da sivri ok gibidir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sıkıntı zamanında sadakatsiz birine güvenmek,","poem":1},{"text":"çürük dişe ya da topal ayağa benzer.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Soğuk havada giysilerini alan","poem":1},{"text":"ya da sodaya sirke neyse,","poem":2},{"lineBreak":true},{"text":"yüreği ağır olana ezgiler söyleyen kişi de öyledir.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Düşmanın acıkmışsa,","poem":1},{"text":"yemesi için ona yiyecek ver.","poem":2},{"lineBreak":true},{"text":"Susamışsa içmesi için ona su ver.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü onun başına korlar yığarsın,","poem":1},{"text":"Yahve de seni ödüllendirir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kuzey rüzgârı yağmur getirir,","poem":1},{"text":"iftiracı dil de yüzü öfkelendirir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kavgacı bir kadınla aynı evi paylaşmaktansa,","poem":1},{"text":"damın köşesinde oturmak daha iyidir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Susamış cana soğuk su nasılsa,","poem":1},{"text":"uzak ülkeden gelen iyi haber de öyledir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bulandırılmış pınar ve kirletilmiş kuyu nasılsa,","poem":1},{"text":"kötünün önünde çöken doğru kişi de öyledir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çok bal yemek iyi değildir,","poem":1},{"text":"insanın kendi saygınlığını araması da onurlu değildir.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ruhunu dizginlemeyen kişi,","poem":1},{"text":"yıkılmış sursuz kent gibidir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}