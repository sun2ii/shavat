{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Yazın kar, hasatta yağmur gibi,","poem":1},{"text":"onur da akılsıza yakışmaz.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Öteye beriye uçan serçe gibi,","poem":1},{"text":"ok gibi fırlayan kırlangıç gibi,","poem":2},{"lineBreak":true},{"text":"hak edilmemiş lanet de yer bulmaz.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ata kırbaç, eşeğe gem,","poem":1},{"text":"akılsızların sırtına da değnek!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akılsıza ahmaklığına göre yanıt verme,","poem":1},{"text":"yoksa sen de onun gibi olursun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akılsıza ahmaklığına göre yanıt ver,","poem":1},{"text":"yoksa kendi gözünde bilge olur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akılsız biriyle haber gönderen kişi,","poem":1},{"text":"kendi ayaklarını keser ve şiddet içer.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Topalın sarkık bacakları neyse,","poem":1},{"text":"akılsızların ağzındaki benzetme de öyledir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taşı sapana bağlayan biri neyse,","poem":1},{"text":"akılsızı da onurlandıran öyledir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sarhoşun elindeki dikenli çalı neyse,","poem":1},{"text":"akılsızların ağzındaki benzetme öyledir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Herkesi yaralayan okçu neyse,","poem":1},{"text":"akılsızı ya da yoldan geçenleri","poem":2},{"lineBreak":true},{"text":"ücretle tutan kişi de öyledir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kusmuğuna dönen köpek neyse,","poem":1},{"text":"ahmaklığını tekrarlayan akılsız da öyledir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kendi gözünde bilge olan bir kişiyi gördün mü?","poem":1},{"text":"Akılsız biri için ondan daha çok umut vardır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tembel, “Yolda aslan var!","poem":1},{"text":"Vahşi bir aslan sokaklarda dolaşıyor!” der.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kapının kendi menteşeleri üzerinde döndüğü gibi,","poem":1},{"text":"tembel de yatağında öyle döner.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tembel elini tabağa daldırır.","poem":1},{"text":"Onu tekrar ağzına götüremeyecek kadar tembeldir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tembel kendi gözünde,","poem":1},{"text":"akıllıca yanıt veren yedi kişiden daha bilgedir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoldan geçen köpeğin kulaklarından yakalayan biri neyse,","poem":1},{"text":"kendine ait olmayan kavgaya karışan da öyledir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Meşaleler, oklar ve ölüm saçan bir deli neyse,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"komşusunu aldatıp da,","poem":1},{"text":"“Şaka yapıyordum” diyen biri de öyledir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Odun olmadığında ateş söner.","poem":1},{"text":"Dedikodu olmadığında kavga biter.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kor için kömür, ateş için odun neyse,","poem":1},{"text":"kavgacı adam da çekişmeyi alevlendirmek için öyledir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fısıltıcının sözleri tatlı lokmalar gibidir,","poem":1},{"text":"en derin yerlere kadar iner.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kötü yürekli hararetli insanın dudakları,","poem":1},{"text":"toprak kap üstündeki gümüş cürufa benzer.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kötü kişi dudaklarıyla kendini gizler,","poem":1},{"text":"ama yüreğinde kötülük barındırır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Konuşması hoş olduğunda ona inanma,","poem":1},{"text":"çünkü yüreğinde yedi iğrenç şey vardır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kötülüğü hileyle gizlenmiş olabilir,","poem":1},{"text":"ama kötülüğü toplulukta meydana çıkar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çukur kazan içine düşer,","poem":1},{"text":"taş yuvarlayana taş geri döner.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yalancı dil incittiği kişilerden nefret eder,","poem":1},{"text":"yaltaklanan ağız da harap eder.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}