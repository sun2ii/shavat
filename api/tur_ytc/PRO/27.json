{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Yarınla övünme,","poem":1},{"text":"çünkü günün ne getireceğini bilemezsin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Seni kendi ağzın değil,","poem":1},{"text":"bir başkası övsün.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taş ağırdır, kum yüktür,","poem":1},{"text":"ama akılsızın kışkırtması ikisinden de ağırdır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Öfke acımasızdır, hiddet dayanılmazdır,","poem":1},{"text":"ama kıskançlığın karşısında kim durabilir?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Açık azarlama,","poem":1},{"text":"gizli sevgiden daha iyidir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Düşmanın öpücükleri bol olsa da,","poem":1},{"text":"dostun yaralamaları sadıktır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tok can petek balından tiksinir,","poem":1},{"text":"aç cana her acı şey tatlı gelir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yuvasından uzak kalan kuş neyse,","poem":1},{"text":"evinden uzak kalan insan da öyledir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Güzel koku ve buhur yüreği sevindirir,","poem":1},{"text":"bir adamın dostunun samimi öğüdü de öyle.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kendi dostunu, babanın dostunu da bırakma.","poem":1},{"text":"Felaket gününde kardeşinin evine gitme.","poem":2},{"lineBreak":true},{"text":"Yakın komşu uzak kardeşten iyidir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bilge ol, oğlum,","poem":1},{"text":"yüreğime sevinç getir,","poem":2},{"lineBreak":true},{"text":"o zaman bana eziyet edene yanıt verebilirim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tedbirli kişi tehlikeyi görür ve sığınır,","poem":1},{"text":"ama akılsız devam eder ve acısını çeker.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yabancıya kefil olanın elbisesini al.","poem":1},{"text":"Onu dikbaşlı kadın için tut.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sabah erkenden komşusunu yüksek sesle kutsayan kişi,","poem":1},{"text":"bu onun tarafından lanet sayılır.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yağmurlu günde dinmeyen damlayla","poem":1},{"text":"kavgacı kadın birbirine benzer.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onu dizginlemek rüzgârı dizginlemeye,","poem":1},{"text":"ya da yağı sağ elinde tutmaya benzer.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Demir demiri biler,","poem":1},{"text":"insan da dostunun yüzünü öyle biler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İncir ağacını budayan meyvesini yer.","poem":1},{"text":"Efendisine göz kulak olan kişi onurlandırılır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Suyun yüzü yansıttığı gibi,","poem":1},{"text":"insanın yüreği de insanı yansıtır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Şeol","poem":1},{"noteId":12},{"text":"ve Avadon","poem":1},{"noteId":13},{"text":"asla doymaz,","poem":1},{"text":"insanın gözü de asla doymaz.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Pota gümüş içindir,","poem":1},{"text":"ocak da altın için,","poem":2},{"lineBreak":true},{"text":"ama insanı arıtan onun övgüsüdür.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akılsızı havanda tahılla birlikte tokmakla dövsen de,","poem":1},{"text":"ahmaklığı ondan çıkmaz.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sürünün durumunu iyi bil,","poem":1},{"text":"sığırlarına da dikkat et.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çünkü zenginlik daimi değildir,","poem":1},{"text":"taç da tüm kuşaklar boyunca durur mu?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Saman kaldırılır, yeni ürün görünür,","poem":1},{"text":"tepelerin otları toplanır.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kuzular senin giysin içindir,","poem":1},{"text":"keçiler de tarlanın ücreti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Senin yiyeceğin için,","poem":1},{"text":"ailenin yiyeceği ve hizmetçi kızların beslenmesi için","poem":2},{"lineBreak":true},{"text":"bol miktarda keçilerin sütü vardır.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":27,"verse":20}},{"noteId":13,"caller":"+","text":"Avadon yıkım diyarıdır.","reference":{"chapter":27,"verse":20}}]},"thisChapterLink":"/api/tur_ytc/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}