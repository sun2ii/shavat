{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Kötü kişi kovalayan olmasa da kaçar,","poem":1},{"text":"ama doğrular aslan gibi cesurdur.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayaklanmada, ülkenin çok önderi olur,","poem":1},{"text":"ama düzen anlayışlı ve bilgili bir kişi tarafından sağlanır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yoksula zulmeden muhtaç kişi,","poem":1},{"text":"geride ürün bırakmayan sağanak yağmur gibidir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yasayı terk edenler kötüyü överler,","poem":1},{"text":"ama yasayı tutanlar onlarla uğraşırlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötüler adaletten anlamazlar,","poem":1},{"text":"ama Yahve'yi arayanlar onu tümüyle anlarlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kendi dürüstlüğünde yürüyen yoksul,","poem":1},{"text":"zengin olup da kendi sapkın yollarında yürüyenden iyidir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yasayı tutan bilge oğuldur,","poem":1},{"text":"ama oburlarla arkadaşlık eden babasını utandırır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Servetini aşırı faizle artıran,","poem":1},{"text":"onu yoksullara acıyan biri için toplar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yasayı duymaktan kulağını çevirenin,","poem":1},{"text":"duası bile iğrençtir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kim doğruları kötü yola saptırırsa,","poem":1},{"text":"o kişi kendi tuzağına düşer,","poem":2},{"lineBreak":true},{"text":"ama suçsuzlar iyiliği miras alacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zengin kişi kendi gözünde bilgedir,","poem":1},{"text":"ama anlayışlı yoksul onun içini görür.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Doğrular kazandığında büyük coşku olur,","poem":1},{"text":"ama kötüler yükseldiğinde insanlar saklanır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Günahlarını gizleyen başarılı olmaz,","poem":1},{"text":"ama onları itiraf edip bırakan merhamet bulur.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne mutlu her zaman korkan insana,","poem":1},{"text":"ama yüreğini katılaştıran belaya düşer.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kükreyen aslan ya da saldırgan ayı neyse,","poem":1},{"text":"çaresiz halk üzerindeki kötü hükümdar da öyledir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zalim hükümdar sağduyudan yoksundur.","poem":1},{"text":"Haksız kazançtan nefret edenin günleri uzun olur.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kan suçundan dolayı azap çeken adam,","poem":1},{"text":"ölene dek kaçak kalır.","poem":2},{"lineBreak":true},{"text":"Kimse ona destek çıkmaz.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Suçsuzca yürüyen güvenlikte olur,","poem":1},{"text":"sapık yolları olan ansızın düşer.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Toprağını işleyenin yiyeceği bol olur,","poem":1},{"text":"ama hayaller peşinde koşan yoksulluğa doyar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sadık insanın bereketleri boldur,","poem":1},{"text":"ama zengin olmaya heveslenen cezasız kalmaz.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taraf tutmak iyi değildir,","poem":1},{"text":"insan bir parça ekmek için suç işler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Cimri kişi zenginliğin peşinde koşar,","poem":1},{"text":"yoksulluğun kendisini beklediğini bilmez.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bir kişiyi azarlayan sonunda","poem":1},{"text":"diliyle pohpohlayandan daha çok lütuf bulur.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kim babasını ya da annesini soyar ve,","poem":1},{"text":"“Yanlış değil” derse,","poem":2},{"lineBreak":true},{"text":"yok ediciyle ortaktır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Açgözlü kişi çekişmeyi kışkırtır,","poem":1},{"text":"ama Yahve'ye güvenen başarılı olur.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kendine güvenen akılsızdır,","poem":1},{"text":"ama bilgelikte yürüyen güvenlikte olur.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yoksula verenin eksiği olmaz,","poem":1},{"text":"ama gözünü kapatanın laneti çok olur.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kötüler yükselince insanlar saklanır,","poem":1},{"text":"ama onlar yok olunca doğrular dallanıp budaklanır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}