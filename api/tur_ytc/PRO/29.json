{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Çok kez azarlanan ve ensesini sertleştiren kişi,","poem":1},{"text":"ansızın mahvolacak, çare yok.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Doğrular dallanıp budaklanınca halk sevinir,","poem":1},{"text":"ama kötüler hükmedince halk inler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bilgeliği seven babasına sevinç getirir,","poem":1},{"text":"fahişelerle dostluk eden servetini çarçur eder.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kral adaletle ülkeyi sağlamlaştırır,","poem":1},{"text":"ama rüşvet alan onu yerle bir eder.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Komşusunu pohpohlayan kişi,","poem":1},{"text":"onun ayakları için ağ serer.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kötü kişi kendi günahı tarafından tuzağa düşürülür,","poem":1},{"text":"ama doğru kişi şarkı söyleyip sevinebilir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Doğru kişi yoksullar için adalete önem verir.","poem":1},{"text":"Kötüler bilgiyle ilgilenmezler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Alaycılar kenti karıştırır,","poem":1},{"text":"ama bilgeler öfkeyi yatıştırır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eğer akıllı biri bir akılsızla mahkemeye giderse,","poem":1},{"text":"akılsız hiddetlenir ya da alay eder ve barış olmaz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kana susamışlar, dürüst kişiden nefret ederler,","poem":1},{"text":"ve onlar doğrunun hayatının peşindedirler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akılsız bütün öfkesini açığa vurur,","poem":1},{"text":"ama bilge kişi kendini denetler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eğer bir hükümdar yalanları dinlerse,","poem":1},{"text":"onun tüm görevlileri kötüdür.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yoksulla zalimin ortak yanı şudur:","poem":1},{"text":"İkisinin de gözünü açan Yahve'dir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yoksulları adaletle yargılayan kralın tahtı","poem":1},{"text":"Daima pekişir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Terbiye değneği bilgelik verir,","poem":1},{"text":"ama kendi başına bırakılan çocuk annesini utandırır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kötüler çoğalınca günah çoğalır,","poem":1},{"text":"ama doğrular onların düşüşünü görecektir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Oğlunu terbiye et, o da sana huzur verecektir,","poem":1},{"text":"evet, canına sevinç getirecektir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Esin olmadığında halk dizginleri çıkarıp atar,","poem":1},{"text":"ama yasayı tutan kutsanır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hizmetçi sözlerle terbiye edilmez,","poem":1},{"text":"anlasa da yanıt vermez.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sözlerinde aceleci birini görüyor musun?","poem":1},{"text":"Akılsız biri için ondan daha çok umut vardır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hizmetçisini çocukluğundan beri şımartan,","poem":1},{"text":"sonunda o kendisine bir oğul olur.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Öfkeli kişi çekişmeyi kışkırtır.","poem":1},{"text":"Hiddetli insanın de günahı bol olur.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İnsanın gururu onu alçaltır,","poem":1},{"text":"ama alçalmış ruh onur kazanır.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hırsızla ortak olan kendi canına düşmandır.","poem":1},{"text":"Ant içer ama tanıklık etmeye cesaret etmez.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"İnsan korkusu tuzaktır,","poem":1},{"text":"ama güvenini Yahve'ye bağlayan emniyette olur.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Birçokları hükümdarın lütfunu arar,","poem":1},{"text":"ama insanın adaleti Yahve'den gelir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Dürüst olmayan kişi doğru kişiden nefret eder,","poem":1},{"text":"kendi yollarında doğru olanlar kötülerden nefret eder.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}