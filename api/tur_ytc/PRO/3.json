{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Oğlum unutma öğrettiğimi,","poem":1},{"text":"yüreğin buyruklarımı tutsun,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"çünkü bunlar günlerine uzunluk,","poem":1},{"text":"ömrüne yıllar ve esenlik katacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İyilik ve gerçeğin seni bırakmasına","poem":1},{"text":"izin verme.","poem":2},{"lineBreak":true},{"text":"Onları boynuna bağla.","poem":2},{"lineBreak":true},{"text":"Yüreğinin levhasına yaz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Böylece Tanrı'nın ve insanların gözünde","poem":1},{"text":"lütuf ve iyi anlayış bulacaksın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bütün yüreğinle Yahve'ye güven,","poem":1},{"text":"kendi anlayışına dayanma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bütün yollarında O'nu tanı,","poem":1},{"text":"O senin yollarını düzeltir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kendi gözünde bilge olma.","poem":1},{"text":"Yahve'den kork, kötülükten uzaklaş.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bu, bedenin için şifa,","poem":1},{"text":"kemiklerine gıda olacaktır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Malınla, bütün artışının ilk ürünüyle","poem":1},{"text":"Yahve'yi onurlandır,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Böylece ambarların bollukla dolar,","poem":1},{"text":"teknelerin yeni şarapla taşar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oğlum Yahve'nin terbiye edişini küçümseme,","poem":1},{"text":"yola getirmesinden usanma,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"çünkü memnun olduğu oğlunu azarlayan bir baba gibi,","poem":1},{"text":"Yahve sevdiğini yola getirir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne mutlu bilgelik bulan adama,","poem":1},{"text":"anlayış kazanan insana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onun iyi kazancı gümüş kazanmaktan daha iyidir,","poem":1},{"text":"getirisi saf altından daha iyidir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O yakutlardan daha değerlidir.","poem":1},{"text":"Arzu edebileceğin hiçbir şey onunla kıyaslanamaz.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Günlerinin uzunluğu onun sağ elindedir.","poem":1},{"text":"Sol elinde zenginlik ve onur vardır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yolları tatlılık yollarıdır.","poem":1},{"text":"Bütün yolları esenliktir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onu tutanlar için yaşam ağacıdır.","poem":1},{"text":"Ne mutlu onu sıkı tutanlara.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahve bilgelikle kurdu yeryüzünü.","poem":1},{"text":"Anlayışla gökleri yerleştirdi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"O'nun bilgisiyle derinlikler yarıldı,","poem":1},{"text":"gökler çiğ damlattı.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Oğlum, onları gözünden ayırma.","poem":1},{"text":"Sağlam bilgeliği ve sağgörüyü koru,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"böylece onlar canına yaşam,","poem":1},{"text":"boynun için zarafet olacak.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"O zaman yolunda güvenlik içinde yürüyeceksin.","poem":1},{"text":"Ayağın tökezlemeyecek.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yattığın zaman korkmayacaksın.","poem":1},{"text":"Evet, yatacaksın, uykun tatlı olacak.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani korkudan,","poem":1},{"text":"ya da kötülerin başına gelen yıkımdan korkma,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"çünkü Yahve güvenin olacak,","poem":1},{"text":"ayağını tutulmaktan koruyacak.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İyilik yapmak elindeyken,","poem":1},{"text":"iyiliğe hakkı olanlardan esirgeme.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yanında varken komşuna,","poem":1},{"text":"“Git de tekrar gel, yarın vereyim” deme.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yanında güvenle oturan komşuna karşı","poem":1},{"text":"kötülük tasarlama.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Eğer sana zararı dokunmamışsa,","poem":1},{"text":"bir adamla sebepsiz yere çekişme.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Zorba insana imrenme.","poem":1},{"text":"Onun yollarından hiçbirini seçme.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Çünkü sapkın kişi Yahve'ye iğrençtir,","poem":1},{"text":"ama O'nun dostluğu doğrularladır.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yahve'nin laneti kötülerin evindedir,","poem":1},{"text":"ama doğruların oturduğu yeri kutsar.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Gerçekten O alaycılarla alay eder,","poem":1},{"text":"Ama alçakgönüllülere lütfeder.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bilgeler yüceliği miras alacak,","poem":1},{"text":"ama akılsızların terfisi utanç olacak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}