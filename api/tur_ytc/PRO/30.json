{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"Yake oğlu Agur'un sözleri; Vahiy:","poem":1},{"text":"Adam İtiel'e, İtiel'e ve Ukal'a şöyle diyor:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Gerçekten ben en cahil insanım,","poem":1},{"text":"ben de insan anlayışı yok.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ben bilgeliği öğrenmedim,","poem":1},{"text":"ne de Kutsal Olan'ın bilgisine sahibim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kim ğöğe çıkıp indi? Rüzgârı kim avuçlarında topladı?","poem":1},{"text":"Giysileriyle suları kim sınırlandırdı?","poem":2},{"lineBreak":true},{"text":"Dünyanın uçlarını kim kurdu?","poem":2},{"lineBreak":true},{"text":"Eğer biliyorsan, adı nedir, oğlunun adı nedir?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Tanrı'nın her sözü kusursuzdur.","poem":1},{"text":"Kendisine sığınanlara kalkandır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O'nun sözlerine bir şey katma,","poem":1},{"text":"yoksa seni azarlar, sen de yalancı çıkarsın.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Senden iki şey istedim.","poem":1},{"text":"Ben ölmeden onları benden yoksun bırakma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sahtekârlığı ve yalanları benden uzaklaştır.","poem":1},{"text":"Bana ne yoksulluk ne de zenginlik ver.","poem":2},{"lineBreak":true},{"text":"İhtiyacım olan yiyecekle beni besle,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yoksa doyup da seni inkâr eder,","poem":1},{"text":"'Yahve kimdir?' derim,","poem":2},{"lineBreak":true},{"text":"ya da yoksul olup hırsızlık yapar,","poem":2},{"lineBreak":true},{"text":"Tanrı'mın adını lekelerim.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Hizmetkârı efendisine kötüleme,","poem":1},{"text":"yoksa sana lanet eder, sen de suçlu çıkarsın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Babalarına lanet eden,","poem":1},{"text":"annelerini kutsamayan bir nesil var.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kendi gözlerinde temiz,","poem":1},{"text":"pisliğinden yıkanmamış bir nesil.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O nesil ki, gözleri ne yüksekte!","poem":1},{"text":"Göz kapakları yukarı kalkıktır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yeryüzünden yoksulları,","poem":1},{"text":"insanlar arasındaki muhtaçları yutmak için,","poem":2},{"lineBreak":true},{"text":"dişleri kılıç gibi, çeneleri bıçak gibi olan bir nesildir.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Sülüğün iki kızı vardır:","poem":1},{"text":"'Ver, ver'dir.”","poem":2},{"lineBreak":true},{"text":"“Asla doymayan üç şey,","poem":2},{"lineBreak":true},{"text":"'Yeter! demeyen dört şey:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Şeol,","poem":1},{"noteId":14},{"text":"kısır rahim, suya doymayan toprak,","poem":2},{"lineBreak":true},{"text":"'Yeter!' demeyen ateş.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Babasıyla alay eden,","poem":1},{"text":"annesine itaati küçümseyen gözü,","poem":2},{"lineBreak":true},{"text":"vadideki kargalar ayıracak,","poem":2},{"lineBreak":true},{"text":"kartal yavruları yiyecek.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Benim için hayret verici üç şey var,","poem":1},{"text":"anlamadığım dört şey:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kartalın havadaki yolu,","poem":1},{"text":"yılanın kaya üzerindeki yolu,","poem":2},{"lineBreak":true},{"text":"denizin ortasında geminin yolu","poem":2},{"lineBreak":true},{"text":"ve bir erkeğin bir kızla olan yolu.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Zina eden kadının yolu da öyledir:","poem":1},{"text":"Yer, ağzını siler,","poem":2},{"lineBreak":true},{"text":"ve 'Ben yanlış bir şey yapmadım' der.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Yeryüzü üç şey yüzünden sarsılır,","poem":1},{"text":"dört şeyin altında dayanamaz:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hizmetçi kral olduğunda,","poem":1},{"text":"akılsız yiyeceğe doyduğunda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sevilmeyen kadın evlendiğinde,","poem":1},{"text":"hizmetçisi hanımının yerine geçtiğinde.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Yeryüzünde dört küçük şey vardır,","poem":1},{"text":"ama onlar son derece bilgedir:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Karıncalar güçlü bir halk değildir,","poem":1},{"text":"yine de yiyeceklerini yazın sağlarlar.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kaya tavşanları zayıf bir halktır,","poem":1},{"text":"ama yine de yuvalarını kayalara yaparlar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çekirgelerin kralı yoktur,","poem":1},{"text":"ama sıralar halinde ilerlerler.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kertenkeleyi elle yakalayabilirsin,","poem":1},{"text":"ama o kralların saraylarındadır.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Yürüyüşte muhteşem üç şey var,","poem":1},{"text":"gidişi görkemli dört şey:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hayvanlar arasında en güçlü olan","poem":1},{"text":"ve hiçbir şekilde geri dönmeyen aslan,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"tazı, teke","poem":1},{"text":"ve kendisine karşı hiç başkaldırının olmadığı kral.”","poem":2}]},{"type":"verse","number":32,"content":[{"text":"“Eğer kendini yükselterek akılsızlık ettiysen,","poem":1},{"text":"ya da kötülük düşündüysen, Elini ağzının üzerine koy.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Çünkü sütü çalkalayınca yağ,","poem":1},{"text":"burnu sıkınca kan çıktığı gibi,","poem":2},{"lineBreak":true},{"text":"öfkeyi, zorlayınca da kavga çıkar.”","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":30,"verse":16}}]},"thisChapterLink":"/api/tur_ytc/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}