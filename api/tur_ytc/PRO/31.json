{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Kral Lamuel'in sözleri— annesinin ona öğrettiği vahiy."]},{"type":"verse","number":2,"content":[{"text":"“Oğlum!","poem":1},{"text":"Rahmimin oğlu!","poem":2},{"lineBreak":true},{"text":"Adaklarımın oğlu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gücünü kadınlara,","poem":1},{"text":"yollarını kralları yok eden şeylere verme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Krallar için değildir,","poem":1},{"text":"ey Lemuel, şarap içmek krallar için değildir,","poem":2},{"lineBreak":true},{"text":"ne de beylere, 'Ağır içki nerede?' demek olmaz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoksa içerler yasayı unuturlar,","poem":1},{"text":"adaleti de düşkünler için saptırırlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ağır içkiyi ölmeye yakın olana,","poem":1},{"text":"şarabı canında acılık bulunanlara verin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bırak içsin, yoksulluğunu unutsun,","poem":1},{"text":"artık sefaletini de hatırlamasın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ağzını dilsiz için,","poem":1},{"text":"bütün kimsesizlerin davası için aç.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ağzını aç, doğrulukla yargıla,","poem":1},{"text":"yoksullara ve muhtaçlara adalet ver.”","poem":2}]},{"type":"verse","number":10,"content":[{"noteId":15},{"text":"Değerli bir kadını kim bulabilir?","poem":1},{"text":"Onun değeri yakutların çok üstündedir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kocasının yüreği ona güvenir.","poem":1},{"text":"Adamın kazancı eksik olmaz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kadın ona kötülük değil,","poem":1},{"text":"yaşamının tüm günlerinde iyilik eder.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yün ve keten arar,","poem":1},{"text":"istekli bir şekilde elleriyle çalışır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ticaret gemileri gibidir.","poem":1},{"text":"Ekmeğini uzaktan getirir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Daha geceyken kalkar,","poem":1},{"text":"ev halkına yiyecek,","poem":2},{"lineBreak":true},{"text":"hizmetçi kızlarına paylarını verir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bir tarlayı gözüne kestirir ve satın alır.","poem":1},{"text":"Ellerinin ürünüyle bağ diker.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Belini güçle kuşatır,","poem":1},{"text":"ellerini güçlendirir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ticaretinin kazançlı olduğunun farkındadır.","poem":1},{"text":"Geceleyin kandili sönmez.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ellerini örekeye koyar,","poem":1},{"text":"elleri iği tutar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yoksullara kollarını açar,","poem":1},{"text":"evet, muhtaca ellerini uzatır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ev halkı için kardan korkmaz,","poem":1},{"text":"çünkü bütün ev halkı kırmızıyla kuşanmıştır.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kendisine halılar yapar,","poem":1},{"text":"giysileri ince keten ve mordur.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kocası ülkenin ihtiyarları arasında otururken,","poem":1},{"text":"kent kapısında saygı görür.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Keten giysiler yapar ve satar,","poem":1},{"text":"tüccara kuşaklar teslim eder.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Güç ve saygınlık onun giysisidir.","poem":1},{"text":"Geleceğe güler.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ağzını bilgelikle açar.","poem":1},{"text":"Hoş öğüt onun dilindedir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ev halkının işlerine iyi bakar,","poem":1},{"text":"tembellik ekmeği yemez.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Çocukları ayağa kalkar ve ona kutsanmış der.","poem":1},{"text":"Kocası da onu över:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Birçok kadın soylu işler yapar,","poem":1},{"text":"ama sen hepsinden üstünsün.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Çekicilik aldatıcıdır, güzellik de boştur,","poem":1},{"text":"ama Yahve'den korkan kadın övülür.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ellerinin ürününden ona verin!","poem":1},{"text":"İşleri onu kent kapısında övsün!","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Solomon'un Özdeyişleri 31:10-31, her bir dizenin İbranice alfabesinin her harfiyle sırayla başladığı bir akrostiş oluşturur.","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/tur_ytc/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}