{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Oğullarım, babanızın uyarılarına kulak verin.","poem":1},{"text":"Dikkat edin ve anlayışı bilin,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"çünkü size sağlam eğitim veriyorum.","poem":1},{"text":"Yasamı bırakmayın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ben babamın oğluydum,","poem":1},{"text":"annemin gözünde narin ve tek çocuğuydum.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bana öğretti ve şöyle dedi:","poem":1},{"text":"“Yüreğin sözlerimi sıkı tutsun,","poem":2},{"lineBreak":true},{"text":"buyruklarımı tut ve yaşa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bilgelik kazan.","poem":1},{"text":"Anlayış edin.","poem":2},{"lineBreak":true},{"text":"Unutma ve ağzımın sözlerinden sapma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ondan ayrılma, o da seni koruyacaktır.","poem":1},{"text":"Onu sev, o da sana gözkulak olacaktır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bilgelik yücedir. Bilgelik kazan.","poem":1},{"text":"Evet, tüm malına mal olsa da anlayış kazan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onu yüksek tut, o da seni yükseltecektir.","poem":1},{"text":"Onu kucakladığında sana saygınlık getirecektir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Başına zarif bir çelenk verecektir.","poem":1},{"text":"Sana ihtişam tacı sunacaktır.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dinle oğlum,","poem":1},{"text":"sözlerimi kabul et.","poem":2},{"lineBreak":true},{"text":"Ömrünün yılları uzun olsun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Seni bilgeliğin yolunda eğittim.","poem":1},{"text":"Seni dosdoğru yollara yönelttim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gittiğinde adımların takılmayacak.","poem":1},{"text":"Koştuğunda tökezlemeyeceksin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyarıya sıkı tutun.","poem":1},{"text":"Bırakma onu.","poem":2},{"lineBreak":true},{"text":"Onu koru, çünkü o senin yaşamındır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kötülerin yoluna girme.","poem":1},{"text":"Kötü kişilerin yolunda yürüme.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ondan sakın, yanından geçme.","poem":1},{"text":"Yönünü çevir ve geç.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü onlar kötülük etmedikçe uyumaz.","poem":1},{"text":"Birisini düşürmedikçe uykuları kaçar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü onlar kötülük ekmeği yerler,","poem":1},{"text":"zorbalık şarabından içerler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ama doğruların yolu şafak ışığı gibidir,","poem":1},{"text":"gün tamamına erene dek gitgide parlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kötülerin yolu karanlık gibidir,","poem":1},{"text":"neye takıldıklarını bilmezler.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oğlum sözlerime dikkatini ver,","poem":1},{"text":"dediklerime kulağını çevir.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bunları gözünden ayırma.","poem":1},{"text":"Yüreğinin merkezinde koru onları.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü onları bulanlar için yaşam,","poem":1},{"text":"bütün bedenleri için sağlıktır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yüreğini tam bir özenle koru,","poem":1},{"text":"çünkü yaşam ondan kaynaklanır.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sapık ağzı kendinden uzaklaştır.","poem":1},{"text":"Bozuk dudakları kendinden uzak tut.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gözlerin dosdoğru ileriye baksın.","poem":1},{"text":"Bakışını doğru önüne sabitle.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ayaklarının yolunu düzle.","poem":1},{"text":"Bütün yolların sağlam olsun.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne sağa sap, ne sola.","poem":1},{"text":"Ayağını kötülükten çek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}