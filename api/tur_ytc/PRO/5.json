{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Oğlum, bilgeliğime dikkat et.","poem":1},{"text":"Anlayışıma kulağını çevir,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"böylelikle sağgörüyü tutasın,","poem":1},{"text":"dudaklarınla bilgiyi koruyasın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zina eden kadının dudakları bal damlatır.","poem":1},{"text":"Ağzı yağdan yumuşaktır,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ama sonu pelin otu kadar acıdır,","poem":1},{"text":"iki ağızlı kılıç kadar keskindir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayakları ölüme iner.","poem":1},{"text":"Adımları doğrudan Şeol'e","poem":2},{"noteId":4},{"text":"götürür.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yaşam yolunu düşünmez.","poem":1},{"text":"Yolları çarpıktır ve bunu bilmez.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Şimdi oğullarım, beni dinleyin.","poem":1},{"text":"Ağzımın sözlerinden ayrılmayın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yolunuzu o kadından uzaklaştırın.","poem":1},{"text":"Evinin kapısına yaklaşmayın,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yoksa onurunuzu başkalarına,","poem":1},{"text":"yıllarınızı da zalime verirsiniz,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"yoksa yabancılar servetinizle ziyafet çekerler,","poem":1},{"text":"emekleriniz başka bir adamın evini zengin eder.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sonunda, etin ve bedenin tükendiğinde,","poem":1},{"text":"inlersin,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ve şöyle dersin,","poem":1},{"text":"“Uyarıdan ne kadar da nefret ettim,","poem":2},{"lineBreak":true},{"text":"yüreğim azarlanmayı küçümsedi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Öğretmenlerimin sesini dinlemedim,","poem":1},{"text":"ne de beni eğitenlere kulağımı çevirdim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Halkın ve topluluğun arasında","poem":1},{"text":"tam bir yıkımın eşiğine geldim.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Suyu kendi sarnıcından,","poem":1},{"text":"akan suyu kendi kuyundan iç.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pınarların sokaklara,","poem":1},{"text":"akarsuların meydanlara mı taşsın?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Onlar seninle birlikte yabancılar için değil,","poem":1},{"text":"yalnız senin için olsunlar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pınarın kutsansın.","poem":1},{"text":"Gençliğinin karısıyla sevin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sevimli geyik, zarif bir ceylan gibi,","poem":1},{"text":"onun memeleri seni daima doyursun.","poem":2},{"lineBreak":true},{"text":"Hep onun sevgisiyle cezbedil.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oğlum, neden zina eden bir kadınla büyülenesin,","poem":1},{"text":"başka birini kucaklayasın?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü insanın yolları Yahve'nin gözü önündedir.","poem":1},{"text":"O onun bütün yollarını sınar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kötülerin kötü işleri kendini tuzağa düşürür.","poem":1},{"text":"Kendi günahının ipleri onu sımsıkı tutar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Eğitim eksikliğinden ölecek,","poem":1},{"text":"ahmaklığının büyüklüğünden yoldan sapacak.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":5,"verse":5}}]},"thisChapterLink":"/api/tur_ytc/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}