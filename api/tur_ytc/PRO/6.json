{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Oğlum, eğer komşuna kefil oldunsa,","poem":1},{"text":"eğer bir yabancıya ellerini rehin olarak verdinse,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ağzının sözleriyle tuzağa düştün,","poem":1},{"text":"ağzının sözleriyle yakalandın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Komşunun eline düştüğüne göre,","poem":1},{"text":"oğlum, şimdi şunu yap ve kendini kurtar.","poem":2},{"lineBreak":true},{"text":"Git, kendini alçalt. Komşuna yalvar yakar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gözlerine uyku,","poem":1},{"text":"göz kapaklarına uyuklama verme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Avcının elinden ceylan gibi,","poem":1},{"text":"kuş avcısının elinden kuş gibi kurtar kendini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey tembel, karıncaya git.","poem":1},{"text":"Onun yollarını düşün de bilge ol.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Üzerinde baş, gözetmen ya da hükümdar yokken,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"yazın ekmeğini karşılar,","poem":1},{"text":"hasatta yiyeceğini toplar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey tembel, daha ne kadar uyuyacaksın?","poem":1},{"text":"Uykundan ne zaman kalkacaksın?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Biraz uyku, biraz uyuklama,","poem":1},{"text":"biraz elleri kavuşturup uyumak derken,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yoksulluk bir soyguncu,","poem":1},{"text":"kıtlık silahını kuşanmış bir adam gibi öyle gelecektir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sapık ağızla yürüyen kişi,","poem":1},{"text":"değersiz ve kötü birisidir,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"gözlerini kırpar, ayaklarıyla işaret verir,","poem":1},{"text":"parmaklarıyla hareket eder,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"sapkın yüreğinde sürekli kötülük tasarlar,","poem":1},{"text":"her zaman anlaşmazlık eker.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bunun için onun felaketi ansızın gelecektir.","poem":1},{"text":"Birdenbire kırılacak, çare yok.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve'nin nefret ettiği altı şey vardır,","poem":1},{"text":"evet, O'na iğrenç gelen yedi şey:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kibirli gözler, yalancı dil,","poem":1},{"text":"suçsuz kanı döken eller,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kötü düzenler kuran yürek,","poem":1},{"text":"kötülüğe çabuk koşan ayaklar,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"yalan söyleyen yalancı tanık,","poem":1},{"text":"kardeşler arasında anlaşmazlık eken kişi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oğlum, babanın buyruklarını tut,","poem":1},{"text":"annenin öğretisini bırakma.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onları sürekli yüreğinin üzerine bağla.","poem":1},{"text":"Onları boynuna tak.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yürüdüğünde, o sana yol gösterecektir.","poem":1},{"text":"Uyuduğunda, o sana göz kulak olacaktır.","poem":2},{"lineBreak":true},{"text":"Uyandığında o seninle konuşacaktır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Çünkü buyruk bir kandil, yasa ışıktır.","poem":1},{"text":"Uyarı azarlamaları yaşam yoludur,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"seni ahlaksız kadından,","poem":1},{"text":"dik başlı kadının yaltaklanan dilinden korumak için.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Onun güzelliğine yüreğinde tutku duyma,","poem":1},{"text":"göz kapakları seni büyülemesin.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Çünkü fahişe seni bir parça ekmeğe düşürür.","poem":1},{"text":"Zina eden kadın senin değerli yaşamını avlar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bir adam kucağına ateş koyar da,","poem":1},{"text":"giysileri yanmaz mı?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ya da bir adam kızgın korlar üzerinde yürür de,","poem":1},{"text":"ayakları kavrulmaz mı?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Komşusunun karısının yanına giren de öyledir.","poem":1},{"text":"Ona dokunan hiç kimse cezasız kalmaz.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Açken karnını doyurmak için çalan bir hırsızı","poem":1},{"text":"kimse küçümsemez,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ama onu bulurlarsa, yedi katını geri öder.","poem":1},{"text":"Evinin bütün malını verir.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bir kadınla zina eden kişi anlayıştan yoksundur.","poem":1},{"text":"Bunu yapan kendi canını yok eder.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yaralanır ve onurunu kaybeder.","poem":1},{"text":"Utancı silinmez.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Çünkü kıskançlık kocanın öfkesini uyandırır.","poem":1},{"text":"Öç alma gününde esirgemez.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hiçbir fidyeye bakmaz,","poem":1},{"text":"bir sürü armağan versen de,","poem":2},{"lineBreak":true},{"text":"razı olmaz.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}