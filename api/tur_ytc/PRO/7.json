{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Oğlum, sözlerimi tut.","poem":1},{"text":"Buyruklarımı içinde sakla.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Buyruklarımı tut ve yaşa!","poem":1},{"text":"Öğretimi göz bebeğin gibi koru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onları parmaklarına bağla.","poem":1},{"text":"Onları yüreğinin levhasının üzerine yaz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bilgeliğe, “Sen benim kız kardeşimsin” de.","poem":1},{"text":"Anlayışa akrabam diye çağır,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ta ki seni yabancı kadından,","poem":1},{"text":"sözleriyle yaltaklanan yabancıdan korusun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü evimin penceresinde,","poem":1},{"text":"kafesimden dışarı baktım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Safların arasında birini gördüm.","poem":1},{"text":"Gençlerin arasında anlayıştan yoksun bir genci fark ettim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O kadının köşesine yakın bir sokaktan geçiyordu,","poem":1},{"text":"onun evinin yolunu tuttu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alaca karanlıkta, günün akşamında,","poem":1},{"text":"gece yarısı, karanlıkta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İşte, orada fahişe kıyafetiyle,","poem":1},{"text":"sinsice onu bir kadın karşıladı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gürültücü ve dik başlı biridir.","poem":1},{"text":"Ayakları evinde durmaz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bir bakmışsın sokaklarda, bir bakmışsın meydanlardadır,","poem":1},{"text":"her köşede pusuda bekler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onu tuttu ve öptü.","poem":1},{"text":"Utanmaz bir yüzle ona şöyle dedi:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Esenlik sunuları yanımdadır.","poem":1},{"text":"Bugün adaklarımı ödedim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bu nedenle, yüzünü özenle aramak için","poem":1},{"text":"seni karşılamaya çıktım ve seni buldum.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yatağıma halılar,","poem":1},{"text":"Mısır ipliğinden çizgili örtü serdim.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yatağıma mür,","poem":1},{"text":"sarısabır ve tarçın serptim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gel, sabaha kadar aşka doyalım.","poem":1},{"text":"Aşkla kendimizi avutalım.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Çünkü kocam evde değil.","poem":1},{"text":"Uzun bir yola gitti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yanına para kesesini aldı.","poem":1},{"text":"Eve dolunayda gelecek.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"İkna edici sözlerle onu yoldan çıkardı.","poem":1},{"text":"Yaltaklanan dudaklarıyla onu baştan çıkardı.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kesime giden bir öküz gibi,","poem":1},{"text":"tuzağa adımını atan bir budala gibi","poem":2},{"lineBreak":true},{"text":"hemen onun peşinden gitti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kapana koşan bir kuş gibi,","poem":1},{"text":"ta ki ciğerine ok saplanana dek,","poem":2},{"lineBreak":true},{"text":"ve bunun yaşamına mal olacağını bilmeden.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Şimdi, oğullar, beni dinleyin.","poem":1},{"text":"Ağzımın sözlerine dikkat edin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yüreğin onun yollarına çevrilmesin.","poem":1},{"text":"Onun yollarında yoldan sapmayın.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Çünkü onun yere serdiği yaralılar çoktur.","poem":1},{"text":"Evet, öldürdükleri koca bir ordudur.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Onun evi Şeol'ün","poem":1},{"noteId":5},{"text":"yoludur,","poem":1},{"text":"ölüm odalarına iner.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":7,"verse":27}}]},"thisChapterLink":"/api/tur_ytc/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}