{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Bilgelik çağırmıyor mu?","poem":1},{"text":"Anlayış sesini yükseltmiyor mu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yol kenarındaki yüksek yerlerin başında,","poem":1},{"text":"yolların buluştuğu yerde o duruyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kapıların yanında, kentin girişinde,","poem":1},{"text":"giriş kapılarında yüksek sesle çağırıyor:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ey insanlar, sizi çağırıyorum!","poem":1},{"text":"Sesimi insanoğullarına gönderiyorum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey saflar, sağduyuyu anlayın!","poem":1},{"text":"Ey akılsızlar anlayışlı bir yürek olun!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dinleyin, harika şeyler söyleyeceğim.","poem":1},{"text":"Dudaklarımın açılışı doğru şeyler içindir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü ağzım gerçeği söyler.","poem":1},{"text":"Kötülük dudaklarım için iğrençtir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ağzımın bütün sözleri doğruluktadır.","poem":1},{"text":"Onlarda çarpık ya da sapıklık bulunmaz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anlayana onların hepsi açıktır,","poem":1},{"text":"bilgiyi bulanlar için doğrudur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gümüş yerine terbiyeyi,","poem":1},{"text":"seçme altın yerine bilgiyi alın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü bilgelik yakutlardan iyidir.","poem":1},{"text":"Arzu edilen bütün şeyler onunla kıyaslanamaz.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Ben bilgelik, sağduyuyu kendime mesken edindim.","poem":1},{"text":"Bilgi ve tedbiri öğrenin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve korkusu kötülükten nefret etmektir.","poem":1},{"text":"Kibirden, gururdan, kötülük yolundan,","poem":2},{"lineBreak":true},{"text":"sapık ağızdan nefret ederim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Öğüt ve sağlam bilgi benimdir.","poem":1},{"text":"Ben anlayışa ve güce sahibim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Benim aracılığımla krallar hüküm sürer,","poem":1},{"text":"beyler adalet buyurur.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Beyler, soylular ve dünyanın adil hükümdarları","poem":1},{"text":"benim sayemde hüküm sürer.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Beni sevenleri ben severim.","poem":1},{"text":"Özenle arayanlar beni bulur.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zenginlik, onur,","poem":1},{"text":"kalıcı zenginlik ve bolluk benimledir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Meyvem altından, evet, saf altından,","poem":1},{"text":"ürünüm seçme gümüşten daha iyidir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Doğruluk yolunda,","poem":1},{"text":"adalet yollarının ortasında yürürüm,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"böylelikle beni sevenlere servet veririm.","poem":1},{"text":"Hazinelerini doldururum.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Yahve, işinin başlangıcında,","poem":1},{"text":"kadim işlerinden önce beni tuttu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yeryüzü var olmadan önce,","poem":1},{"text":"sonsuzluktan beri, başlangıçta ben kuruldum.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Derinlikler yokken,","poem":1},{"text":"bol suyla dolu pınarlar yokken,","poem":2},{"lineBreak":true},{"text":"ben doğdum.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Dağlar yerine yerleştirilmeden,","poem":1},{"text":"tepelerden önce ben doğdum,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"henüz O, ne yeryüzünü, ne kırları,","poem":1},{"text":"ne de dünya toprağının başlangıcını yapmamıştı.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Gökleri kurduğunda, ben oradaydım.","poem":1},{"text":"Derinliğin yüzü üzerine çember koyduğunda,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"bulutları yukarıya yerleştirdiğinde,","poem":1},{"text":"derinliklerin kaynaklarını kuvvetlendirdiğinde,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sular O'nun buyruğunu çiğnemesin diye,","poem":2},{"lineBreak":true},{"text":"denize sınırlarını verdiğinde,","poem":2},{"lineBreak":true},{"text":"yeryüzünün temellerini işaretlediğinde,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"O'nun yanındaki usta bendim.","poem":1},{"text":"Her gün seviniyor, O'nun önünde hep coşuyordum,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"O'nun tüm dünyasında coşku duyuyordum.","poem":1},{"text":"Benim sevincim insanoğulları ile idi.”","poem":2}]},{"type":"verse","number":32,"content":[{"text":"“Şimdi, oğullarım, beni dinleyin,","poem":1},{"text":"çünkü ne mutlu yollarımı tutanlara.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Uyarımı duyun ve bilge olun.","poem":1},{"text":"Reddetmeyin.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ne mutlu beni duyan,","poem":1},{"text":"her gün kapılarımı gözleyen,","poem":2},{"lineBreak":true},{"text":"kapımın sövelerinde bekleyen insana.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Çünkü beni bulan yaşam bulur,","poem":1},{"text":"Yahve'nin iyiliğini kazanır.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bana karşı günah işleyen kendi canına haksızlık eder.","poem":1},{"text":"Benden nefret edenlerin hepsi ölümü severler.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}