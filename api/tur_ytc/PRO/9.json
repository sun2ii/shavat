{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PRO","translationId":"tur_ytc","name":"ÖZDEYİŞLER","commonName":"ÖZDEYİŞLER","title":"ÖZDEYİŞLER","order":20,"numberOfChapters":31,"sha256":"23d71285d1dfb55ba4e5e94953ecb649c2fd8efa53dff0466baeea0d6ff38e5d","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tur_ytc/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Bilgelik evini yaptı.","poem":1},{"text":"Yedi sütununu oydu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Etini hazırladı.","poem":1},{"text":"Şarabını karıştırdı.","poem":2},{"lineBreak":true},{"text":"Sofrasını da kurdu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Genç kızlarını gönderdi.","poem":1},{"text":"Kentin en yüksek yerlerinden çağırıyor:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Saf olan kimse, buraya gelsin!”","poem":1},{"text":"Anlayıştan yoksun olana şöyle diyor:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Gel, ekmeğinden biraz ye,","poem":1},{"text":"karıştırdığım şaraptan biraz iç!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saflık yollarını bırakın da yaşayın.","poem":1},{"text":"Anlayış yolunda yürüyün.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alaycıyı düzelten","poem":1},{"text":"aşağılanmaya davetiye çıkarır.","poem":2},{"lineBreak":true},{"text":"Kötü kişiyi azarlayan","poem":2},{"lineBreak":true},{"text":"hakarete davetiye çıkarır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Alaycıyı azarlama, yoksa senden nefret eder.","poem":1},{"text":"Bilge kişiyi azarlarsan, seni sever.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bilge kişiyi eğit, daha da bilge olur.","poem":1},{"text":"Doğru insana öğret, öğrenmesi çoğalır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve korkusu bilgeliğin başlangıcıdır.","poem":1},{"text":"Kutsal Olan'ın bilgisi anlayıştır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Benim sayemde günlerin katlanacak.","poem":1},{"text":"Yaşamının yılları artacak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eğer bilgeysen, kendin için bilgesin.","poem":1},{"text":"Eğer alay edersen, bunu yalnız kendin çekersin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akılsız kadın gürültücüdür,","poem":1},{"text":"düzensizdir ve bir şey bilmez.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Evinin kapısında,","poem":1},{"text":"kentin yüksek yerlerinde bir sandalyede oturur,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"yoldan geçenlere,","poem":1},{"text":"kendi yollarına doğru gidenlere çağırmak için,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Saf olan buraya gelsin.”","poem":1},{"text":"anlayıştan yoksun olan insana şöyle der:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Çalıntı su tatlıdır.","poem":1},{"text":"Gizlice yenilen yemek hoştur.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ama o kişi, göçüp giden ruhların orada olduğunu bilmez,","poem":1},{"text":"kadının konukları Şeol'ün","poem":2},{"noteId":6},{"text":"derinliklerindedir.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":9,"verse":18}}]},"thisChapterLink":"/api/tur_ytc/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}