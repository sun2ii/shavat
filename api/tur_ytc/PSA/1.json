{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ne mutlu kötülerin öğüdüyle yürümeyen,","poem":1},{"text":"günahkârların yolunda durmayan,","poem":2},{"lineBreak":true},{"text":"alaycıların sandalyesinde oturmayan insana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ancak onun zevki Yahve’nin","poem":1},{"noteId":0},{"text":"Yasası'dır.","poem":1},{"text":"gece gündüz onun üzerinde","poem":2},{"lineBreak":true},{"text":"derin derin düşünür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O kişi akarsu kıyısına dikilmiş ağaca benzer,","poem":1},{"text":"meyvesini mevsiminde verir,","poem":2},{"lineBreak":true},{"text":"yaprağı da solmaz.","poem":2},{"lineBreak":true},{"text":"Ne yaparsa başarır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kötüler böyle değildir,","poem":1},{"text":"ancak rüzgârın savurduğu saman çöpü gibidirler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bu nedenle kötüler yargılanınca ayakta kalamaz,","poem":1},{"text":"günahkârlar doğrular topluluğunda duramaz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü Yahve doğruların yolunu bilir,","poem":1},{"text":"ancak kötülerin yolu yok olur.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":1,"verse":2}}]},"thisChapterLink":"/api/tur_ytc/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}