{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Neden uzakta duruyorsun, ey Yahve?","poem":1},{"text":"Sıkıntı zamanlarında neden kendini saklıyorsun?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kötüler kibirle mazlumları avlıyor.","poem":1},{"text":"Mazlumlar kötülerin kurduğu tuzağa düşüyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü kötü kişi yüreğindeki arzularla övünür.","poem":1},{"text":"Açgözlüleri yüceltir ve Yahve’yi yerer.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kötü kişi gururlu yüzüyle,","poem":1},{"text":"düşüncelerinde Tanrı'ya yer vermez.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötünün yolları hep bolluk içindedir.","poem":1},{"text":"Kibirlidir ve senin yasaların onun gözlerinden uzaktır.","poem":2},{"lineBreak":true},{"text":"Düşmanlarının hepsini küçümser.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yüreğinden, “Ben sarsılmam.","poem":1},{"text":"Hiçbir devirde sıkıntıya düşmem.” der.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ağzı lanet, hile ve zulümle dolu.","poem":1},{"text":"Dilinin altında kötülük ve fesat vardır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Köylerin yakınında pusuda bekler.","poem":1},{"text":"Pusuda masumu öldürür.","poem":2},{"lineBreak":true},{"text":"Gözlerini gizlice çaresize dikmiştir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pusuya yatmış aslan gibi, gizlice pusudadır.","poem":1},{"text":"Çaresizi yakalamak için yatıp bekler.","poem":2},{"lineBreak":true},{"text":"Çaresizi ağına çekip yakalar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çaresiz onun gücünün altında","poem":1},{"text":"Çöküp ezilir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yüreğinden, “Tanrı unuttu” der.","poem":1},{"text":"“Yüzünü gizledi,","poem":2},{"lineBreak":true},{"text":"hiçbir zaman görmeyecek.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kalk, ey Yahve!","poem":1},{"text":"Tanrım, elini kaldır!","poem":2},{"lineBreak":true},{"text":"Çaresizi unutma.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kötü kişi neden Tanrı'yı suçlasın?","poem":1},{"text":"Yüreğinden “Tanrı hesap sormaz” desin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ama sen sıkıntı ve kederi görürsün.","poem":1},{"text":"Onu eline almayı düşünürsün.","poem":2},{"lineBreak":true},{"text":"Mağdura ve babasızlara yardım edersin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kötünün kolunu kır.","poem":1},{"text":"Kötüye gelince, kötülüğü kalmayıncaya kadar ondan hesabını sor.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve sonsuza dek Kraldır!","poem":1},{"text":"Uluslar O'nun diyarından yok olacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yahve, alçakgönüllülerin dileğini duydun.","poem":1},{"text":"Onların yüreğini hazırlayacaksın.","poem":2},{"lineBreak":true},{"text":"Kulağını onlara açacaksın,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yetimlerin ve ezilenlerin yargısını vermek için,","poem":1},{"text":"öyle ki toprak olan insan artık bir daha dehşet saçmasın.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}