{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Sevgi dolu iyiliğini ve adaletini ezgiyle söyleyeceğim.","poem":1},{"text":"Seni ilahilerle öveceğim, ey Yahve.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Temiz bir yaşam sürdürmeye dikkat edeceğim.","poem":1},{"text":"Bana ne zaman geleceksin?","poem":2},{"lineBreak":true},{"text":"Evimin içinde pak bir yürekle yürüyeceğim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hiçbir rezil şeyi gözümün önüne koymayacağım.","poem":1},{"text":"Güvenilmez insanların işlerinden nefret ederim.","poem":2},{"lineBreak":true},{"text":"Bana tutunmayacaklar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sapık yürek benden uzak olsun.","poem":1},{"text":"Kötülükle işim olmaz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Komşusuna gizlice kara çalanı sustururum.","poem":1},{"text":"Katlanamam küstah ve kibirli insana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gözlerim ülkedeki sadıkların üzerinde olacak,","poem":1},{"text":"ta ki, benimle otursunlar.","poem":2},{"lineBreak":true},{"text":"Kusursuzca yürüyen kişi,","poem":2},{"lineBreak":true},{"text":"bana hizmet edecek.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hileci kişi evimde oturmayacak.","poem":1},{"text":"Yalan söyleyen, gözümün önünde durmayacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Her sabah ülkedeki bütün kötüleri yok edeceğim,","poem":1},{"text":"Yahve’nin kentinden kötülüğün tüm işçilerini kesip atacağım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}