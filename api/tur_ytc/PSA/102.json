{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["Zayıf düşen ve derdini Yahve’ye döken mazlumun duası"]},{"type":"verse","number":1,"content":[{"text":"Duamı duy, ey Yahve!","poem":1},{"text":"Feryadım sana ulaşsın.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sıkıntılı günümde yüzünü benden saklama.","poem":1},{"text":"Kulağını bana çevir.","poem":2},{"lineBreak":true},{"text":"Çağırdığım gün bana hemen yanıt ver.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü günlerim duman gibi tükeniyor.","poem":1},{"text":"Kemiklerim meşale gibi yanıyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yüreğim ot gibi kurudu, soldu,","poem":1},{"text":"ekmek yemeyi unuttum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İniltimin sesinden,","poem":1},{"text":"kemiklerim derime yapışıyor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çölde yaşayan kaşıkçı kuşu gibiyim.","poem":1},{"text":"Çorak yerlerin baykuşu oldum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gözlüyorum, damda yalnız kalan bir serçeye döndüm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Düşmanlarım bütün gün beni aşağılıyor.","poem":1},{"text":"Bana kızgın olanlar adımı lanet için kullanıyorlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Külü ekmek gibi yedim,","poem":1},{"text":"içeceğime gözyaşları karıştırdım,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"senin öfken ve gazabın yüzünden,","poem":1},{"text":"çünkü sen beni kaldırıp yere çaldın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Günlerim uzayan gölge gibi.","poem":1},{"text":"Ot gibi kurudum.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama sen, ey Yahve, sonsuza dek kalıcısın,","poem":1},{"text":"ünün tüm kuşaklar boyunca sürer.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sen kalkıp Siyon'a merhamet edeceksin,","poem":1},{"text":"çünkü ona acıma vakti geldi.","poem":2},{"lineBreak":true},{"text":"Evet, belirlenen zaman geldi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü hizmetkârların onun taşlarından zevk alırlar,","poem":1},{"text":"onun tozuna acırlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Böylece uluslar Yahve’nin adından,","poem":1},{"text":"yeryüzü krallarının tümü görkeminden korkacaklar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü Yahve Siyon'u bina etti.","poem":1},{"text":"Yüceliğiyle göründü.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoksulun duasına yanıt verdi,","poem":1},{"text":"onların duasını küçümsemedi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bu, gelecek kuşak için yazılacak.","poem":1},{"text":"yaratılacak bir halk Yah'ı övecek,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Çünkü O yücelerdeki kutsal yerinden aşağıya baktı.","poem":1},{"text":"Yahve gökten yeryüzünü gördü,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"tutsakların iniltilerini duymak,","poem":1},{"text":"ölüme mahküm edilenleri serbest bırakmak için.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Böylece Yahve’ye hizmet etmek için","poem":1},{"text":"halklar ve krallıklar bir araya toplanınca,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Siyon’da Yahve’nin adını,","poem":1},{"text":"Yeruşalem’de övgüsünü ilan etsinler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yol boyunca gücümü zayıflattı.","poem":1},{"text":"Günlerimi kısalttı.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“Ey Tanrım, beni günlerimin ortasında alma” dedim.","poem":1},{"text":"“Senin yılların tüm kuşaklar boyuncadır.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yeryüzünün temelini eskiden sen attın.","poem":1},{"text":"Gökler senin ellerinin işidir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Onlar yok olacak, ama sen duracaksın.","poem":1},{"text":"Evet, hepsi bir giysi gibi eskiyecek.","poem":2},{"lineBreak":true},{"text":"Onları bir kaftan gibi değiştireceksin, onlar da değişecek.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ama sen aynısın.","poem":1},{"text":"Yıllarının sonu yoktur.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hizmetkârlarının çocukları devam edecek.","poem":1},{"text":"Onların soyu senin önünde sağlamlaştırılacak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}