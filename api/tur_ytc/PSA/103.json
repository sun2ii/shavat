{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve’yi öv, ey canım!","poem":1},{"text":"İçimde var olan her şey, O’nun kutsal adını övsün!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve’yi öv, ey canım,","poem":1},{"text":"iyiliklerinin hiçbirini unutma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bütün günahlarını bağışlayan,","poem":1},{"text":"bütün hastalıklarını iyileştiren,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"canını yıkımdan kurtaran,","poem":1},{"text":"sana sevgi dolu iyilikle","poem":2},{"lineBreak":true},{"text":"sevecen merhametler tacı giydiren,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"arzunu iyi şeylerle doyuran O’dur,","poem":1},{"text":"böylece gençliğin kartalınki gibi yenilenir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve ezilenlerin tümüne","poem":1},{"text":"hak ve adalet sağlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kendi yollarını Moşe’ye,","poem":1},{"text":"işlerini İsrael’in çocuklarına bildirdi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve merhametli ve lütufkârdır,","poem":1},{"text":"öfkelenmekte yavaş, sevgi dolu iyiliği boldur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hep suçlamaz;","poem":1},{"text":"sonsuza dek öfkeli kalmaz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bize günahlarımıza göre davranmadı,","poem":1},{"text":"ne de kötülüklerimizin karşılığını ödetti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü gökler yeryüzünden ne kadar yüksekse,","poem":1},{"text":"kendisinden korkanlara karşı","poem":2},{"lineBreak":true},{"text":"sevgi dolu iyiliği de o kadar büyüktür.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Doğu batıdan ne kadar uzaksa,","poem":1},{"text":"isyanlarımızı bizden o kadar uzaklaştırdı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bir baba çocuklarına nasıl acırsa,","poem":1},{"text":"Yahve kendisinden korkanlara öyle acır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü yaratılışımızı bilir.","poem":1},{"text":"Toprak olduğumuzu hatırlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İnsana gelince, günleri ota benzer.","poem":1},{"text":"Kır çiçeği gibi gelişir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Üzerine rüzgâr esince gelip geçer.","poem":1},{"text":"Bulunduğu yer artık onu hatırlamaz.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ama Yahve’nin sevgi dolu iyiliği","poem":1},{"text":"kendisinden korkanlara karşı sonsuzdur,","poem":2},{"lineBreak":true},{"text":"doğruluğu çocuklarının çocuklarınadır,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kurallarına uyanlara,","poem":1},{"text":"O’nun buyruklarına uymayı hatırlayanlaradır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahve tahtını göklerde kurdu.","poem":1},{"text":"O’nun krallığı her şeye hükmediyor.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yahve’yi övün, ey O’nun melekleri,","poem":1},{"text":"güçte büyük olup","poem":2},{"lineBreak":true},{"text":"sözünün sesine itaat eden","poem":2},{"lineBreak":true},{"text":"ve sözünü yerine getiren ey sizler.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yahve’yi övün, O’nun bütün orduları,","poem":1},{"text":"isteğini yerine getiren hizmetkârları.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hakimiyetinin her yerindeki bütün işleri","poem":1},{"text":"Yahve’yi övün,","poem":2},{"lineBreak":true},{"text":"Yahve’yi öv, ey canım!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}