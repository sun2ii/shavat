{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Ey canım, Yahve’yi öv,","poem":1},{"text":"ey Yahve, Tanrım, çok büyüksün.","poem":2},{"lineBreak":true},{"text":"Saygınlık ve heybetle giyinmişsin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O’dur bir giysi gibi kendini ışıkla örten.","poem":1},{"text":"Gökleri bir perde gibi geren.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O’dur odalarının en üstünü sular üzerine kuran,","poem":1},{"text":"bulutları kendine araba eden,","poem":2},{"lineBreak":true},{"text":"rüzgârın kanatları üzerinde yürüyen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O’dur habercilerini","poem":1},{"noteId":35},{"text":"rüzgârlar,","poem":1},{"text":"hizmetkârlarını ateş alevleri yapan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeryüzünün temellerini attın,","poem":1},{"text":"sonsuza dek sarsılmasın diye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bir kaftan gibi onu derinlikle kapladın.","poem":1},{"text":"Sular dağların üzerinde durdu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senin azarlamandan sular kaçtı,","poem":1},{"text":"gürleyişinin sesiyle hemen çekildiler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dağlar yükseldi,","poem":1},{"text":"vadiler battı,","poem":2},{"lineBreak":true},{"text":"onlar için belirlediğin yere doğru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Üstünden geçmesinler diye bir sınır çektin,","poem":1},{"text":"ta ki, yeryüzünü kaplamak için bir daha dönmesinler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vadilerde çıkarttığın pınarlar,","poem":1},{"text":"dağların arasında akarlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kırdaki bütün hayvanlara içecek verir.","poem":1},{"text":"Yaban eşekleri susuzluklarını giderirler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gökteki kuşlar onların yanında yuva yapar.","poem":1},{"text":"Dalların arasında öterler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dağları odalarından sular.","poem":1},{"text":"Yeryüzü işlerinin ürünüyle doldu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hayvanlar için ot,","poem":1},{"text":"insanın ekip biçmesi için bitkiler yetiştirirsin,","poem":2},{"lineBreak":true},{"text":"öyle ki, topraktan yiyecek çıkarsınlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İnsanın yüreğini sevindiren şarabı,","poem":1},{"text":"yüzünü aydınlatan yağı,","poem":2},{"lineBreak":true},{"text":"yüreğini güçlendiren ekmeği sen verirsin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve’nin ağaçları,","poem":1},{"text":"kendi diktiği Lübnan sedirleri iyi sulanır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuşlar orada yuva yaparlar.","poem":1},{"text":"Leylek ise evini selvi ağaçlarına yapar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yüksek dağlar yaban keçileri içindir.","poem":1},{"text":"Kayalar, kaya porsuklarının sığınağıdır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ayı mevsimler için belirledi.","poem":1},{"text":"Güneş batacağı zamanı bilir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Karartırsın, gece olur,","poem":1},{"text":"o zaman tüm orman hayvanları çıkar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Genç aslanlar avlarının peşinden kükrer,","poem":1},{"text":"Tanrı’dan yiyeceklerini isterler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Güneş doğar, çekilirler,","poem":1},{"text":"inlerinde yatarlar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İnsan işine gider,","poem":1},{"text":"akşama kadar çalışır.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ey Yahve, işlerin ne çoktur!","poem":1},{"text":"Hepsini bilgeliğinle yaptın.","poem":2},{"lineBreak":true},{"text":"Yeryüzü zenginliklerinle dolu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Deniz var, büyük ve geniş,","poem":1},{"text":"içinde sayısız küçük büyük hayvanlar,","poem":2},{"lineBreak":true},{"text":"canlı şeyler bulunur.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Oraya gemiler gider,","poem":1},{"text":"içinde oynasın diye yarattığın Livyatan oradadır.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hepsi seni bekliyor,","poem":1},{"text":"ta ki, onlara yiyeceklerini vaktinde veresin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Onlara verirsin ve toplarlar.","poem":1},{"text":"Elini açarsın, iyilikle doyarlar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yüzünü gizleyince sıkıntıya düşerler.","poem":1},{"text":"Soluklarını kesince ölüp toza dönerler.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ruhunu gönderirsin, yaratılırlar.","poem":1},{"text":"Yerin yüzünü yenilersin.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yahve’nin yüceliği sonsuza dek sürsün.","poem":1},{"text":"Yahve işleriyle sevinsin.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"O yeryüzüne bakar, yer titrer.","poem":1},{"text":"Dağlara dokunur ve onlar tüter.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yaşadığım sürece Yahve’ye ezgiler söyleyeceğim.","poem":1},{"text":"Var oldukça Tanrım’ı ezgilerle öveceğim.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Düşüncem O’na hoş görünsün.","poem":1},{"text":"Ben Yahve ile sevineceğim.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Günahkârlar yeryüzünde tükensin.","poem":1},{"text":"Artık kötüler olmasın.","poem":2},{"lineBreak":true},{"text":"Ey canım, Yahve’yi öv.","poem":2},{"lineBreak":true},{"text":"Yah’ı öv!","poem":2}]}],"footnotes":[{"noteId":35,"caller":"+","text":"veya melekler","reference":{"chapter":104,"verse":4}}]},"thisChapterLink":"/api/tur_ytc/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}