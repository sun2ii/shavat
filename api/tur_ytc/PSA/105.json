{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve’ye şükredin, adını çağırın!","poem":1},{"text":"Yaptıklarını halklar arasında bildirin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O’na ezgilerle, ilahiler söyleyin!","poem":1},{"text":"O’nun tüm şaşılası işlerini anlatın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kutsal adıyla övünün.","poem":1},{"text":"Yahve’yi arayanların yüreği sevinsin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve’yi ve O’nun gücünü arayın.","poem":1},{"text":"Yüzünü daima arayın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaptığı şaşılası işleri,","poem":1},{"text":"harikalarını ve ağzının hükümlerini hatırlayın:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey sizler, hizmetkârı Avraham’ın soyu,","poem":1},{"text":"Yakov’un çocukları, O’nun seçilmişleri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tanrımız Yahve O’dur.","poem":1},{"text":"O’nun hükümleri tüm yeryüzündedir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O, antlaşmasını,","poem":1},{"text":"bin kuşağa buyurduğu sözü,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Avraham’la yaptığı antlaşmayı,","poem":1},{"text":"İshak'a olan andını sonsuza dek hatırlar,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"bunu Yakov için bir kural,","poem":1},{"text":"İsrael'e sonsuz bir antlaşma olarak onayladı:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Mirasının payı olmak üzere,","poem":1},{"text":"Kenan ülkesini sana vereceğim.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O zaman için sayıca birkaç kişiydiler,","poem":1},{"text":"çok azdılar ve orada yabancıydılar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ulustan ulusa,","poem":1},{"text":"bir krallıktan öteki halka dolaşıp durdular.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kimsenin onlara kötülük etmesine izin vermedi.","poem":1},{"text":"Kralları bile onların uğruna azarladı:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Meshettiklerime dokunmayın!","poem":1},{"text":"Peygamberlerime zarar vermeyin!” dedi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ülkeye kıtlığı çağırdı.","poem":1},{"text":"Yiyecek kaynaklarını yok etti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Önlerinden bir adam gönderdi.","poem":1},{"text":"Yosef köle olmak üzere satıldı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ayaklarına pranga vurdular.","poem":1},{"text":"Boynunu demir halkayla bağladılar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sözü gerçekleşene dek,","poem":1},{"text":"Yahve’nin sözü onu sınadı.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kral gönderip onu özgür kıldı.","poem":1},{"text":"Halklara hükmeden onu salıverdi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onu evinin efendisi,","poem":1},{"text":"tüm malının yöneticisi yaptı,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Beylerini istediği gibi eğitsin,","poem":1},{"text":"ihtiyarlarına bilgelik öğretsin diye.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İsrael de Mısır'a geldi.","poem":1},{"text":"Yakov Ham ülkesinde yaşadı.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Halkını çok artırdı,","poem":1},{"text":"onları düşmanlarından daha güçlü yaptı.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hizmetkârlarına karşı düzen kursunlar diye,","poem":1},{"text":"onların yüreklerini halkından nefret etmeye yöneltti,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hizmetkârı Moşe'yi,","poem":1},{"text":"seçmiş olduğu Aron’u gönderdi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Aralarında mucizeler,","poem":1},{"text":"Ham diyarında harikalar gerçekleştirdiler.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Karanlık gönderip ortalığı kararttı.","poem":1},{"text":"Sözlerine karşı gelmediler.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sularını kana çevirdi,","poem":1},{"text":"balıklarını öldürdü.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ülkeleri kurbağalarla dolup taştı,","poem":1},{"text":"krallarının odalarında bile.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"O söyleyince sinek sürüleri,","poem":1},{"text":"tüm sınırları içine bitler geldi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Onlara yağmur yerine dolu,","poem":1},{"text":"ülkelerine yıldırım verdi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bağlarını, incir ağaçlarını vurdu,","poem":1},{"text":"ülkelerinin ağaçlarını parçaladı.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"O söyleyince, çekirgeler,","poem":1},{"text":"sayısız çekirgeler geldi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ülkelerinin bütün bitkilerini,","poem":1},{"text":"topraklarının ürününü yediler.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ülkelerinin ilk doğanlarının hepsini,","poem":1},{"text":"güçlerinin ilk ürünlerini vurdu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Onları altın ve gümüşle çıkardı.","poem":1},{"text":"Oymaklarının içinde tek bir zayıf insan bile yoktu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Onlar gidince Mısır sevindi,","poem":1},{"text":"çünkü onların korkusu üzerlerine çökmüştü.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Örtü olarak bulutu,","poem":1},{"text":"geceyi aydınlatmak için ateşi serdi.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"İstediler, O da bıldırcın getirdi,","poem":1},{"text":"onları gökyüzünün ekmeğiyle doyurdu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kayayı yardı ve sular fışkırdı.","poem":1},{"text":"Kurak yerlerde ırmak gibi aktı.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Çünkü kutsal sözünü,","poem":1},{"text":"hizmetkârı Avraham’ı hatırladı.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Halkını sevinçle,","poem":1},{"text":"seçmiş olduklarını ezgiyle dışarı çıkardı.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ulusların topraklarını onlara verdi.","poem":1},{"text":"Halkların emeğini miras aldılar,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ta ki O’nun kurallarını tutsunlar,","poem":1},{"text":"yasasını yerine getirsinler.","poem":2},{"lineBreak":true},{"text":"Yah’ı övün!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}