{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve’ye övgüler olsun!","poem":1},{"text":"Yahve’ye şükredin, çünkü O iyidir,","poem":2},{"lineBreak":true},{"text":"çünkü sevgi dolu iyiliği sonsuza dek sürer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve’nin büyük işlerini kim dile getirebilir?","poem":1},{"text":"Ya da tüm övgülerini tam olarak kim ilan edebilir?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne mutlu adaleti tutanlara.","poem":1},{"text":"Ne mutlu, her zaman doğru olanı yapan insana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Halkına gösterdiğin lütufla beni hatırla, ey Yahve.","poem":1},{"text":"Kurtarışınla beni ziyaret et,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"öyle ki, seçtiklerinin başarısını göreyim,","poem":1},{"text":"ulusunun sevinciyle coşayım,","poem":2},{"lineBreak":true},{"text":"Mirasınla birlikte övüneyim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atalarımızla birlikte günah işledik.","poem":1},{"text":"Suç işledik.","poem":2},{"lineBreak":true},{"text":"Kötülük yaptık.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atalarımız Mısır'daki harikalarını anlamadılar.","poem":1},{"text":"Sevgi dolu iyiliklerinin çokluğunu hatırlamadılar,","poem":2},{"lineBreak":true},{"text":"denizde, Kızıldeniz'de isyan ettiler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kudretli gücünü bildirsin diye,","poem":1},{"text":"yine de kendi adı uğruna onları kurtardı,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kızıldeniz'i de azarladı ve deniz kurudu,","poem":1},{"text":"çölden geçermiş gibi onları derinliklerden geçirdi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onları kendilerinden nefret edenin elinden kurtardı,","poem":1},{"text":"onları düşmanın elinden kurtardı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sular düşmanlarını örttü.","poem":1},{"text":"Geride onlardan biri bile kalmadı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O zaman sözlerine inandılar.","poem":1},{"text":"O’na ezgilerle övgülerini sundular.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O’nun işlerini hemen unuttular.","poem":1},{"text":"O’nun öğüdünü beklemediler,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ama çölde iştahlarına yenik düştüler,","poem":1},{"text":"ıssız yerde Tanrı'yı denediler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onlara istediklerini verdi,","poem":1},{"text":"ama canlarına zayıflık gönderdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ordugâhta da Moşe’yi,","poem":1},{"text":"Yahve'nin kutsalı Aron’u kıskandılar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yer yarıldı ve Datan'ı yuttu,","poem":1},{"text":"Aviram'ın yandaşlarını örttü.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onların arasında ateş tutuştu,","poem":1},{"text":"alevi kötüleri yaktı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Horev'de bir buzağı yaptılar,","poem":1},{"text":"dökme bir surete taptılar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Böylece ot yiyen bir öküzün sureti için","poem":1},{"text":"kendi yüceliklerini değiştiler.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kurtarıcılarını,","poem":1},{"text":"Mısır'da büyük şeyler,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ham diyarında harika işler,","poem":1},{"text":"Kızıldeniz'de korkunç şeyler yapmış olan","poem":2},{"lineBreak":true},{"text":"Tanrı'yı unuttular.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bu nedenle onları yok edeceğini söyledi,","poem":1},{"text":"seçtiği Moşe, yok etmesin diye,","poem":2},{"lineBreak":true},{"text":"gazabını döndürmek için","poem":2},{"lineBreak":true},{"text":"O’nun önünde gedikte durmasaydı,","poem":2},{"lineBreak":true},{"text":"onları yok edecekti.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Evet, güzel ülkeyi küçümsediler.","poem":1},{"text":"Sözüne inanmadılar,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ama çadırlarında söylendiler,","poem":1},{"text":"Yahve’nin sesini dinlemediler.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bu nedenle onları","poem":1},{"text":"çölde devirmeye,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Soylarını uluslar arasında düşürmeye,","poem":1},{"text":"onları ülkelere dağıtmaya onlara ant içti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Baal Peor'a da bağlandılar.","poem":1},{"text":"Ölülerin kurbanlarını yediler.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Böylece işleriyle O'nu öfkelendirdiler.","poem":1},{"text":"Üstlerine veba geldi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bunun üzerine Pinehas ayağa kalktı ve yargıyı gerçekleştirdi.","poem":1},{"text":"Böylece veba durduruldu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bu ona doğruluk sayıldı,","poem":1},{"text":"gelecek tüm kuşaklar için.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Meriva sularında da O'nu öfkelendirdiler;","poem":1},{"text":"Moşe onlardan ötürü sıkıntıya düştü;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"O'nun ruhuna karşı isyan ettikleri için","poem":1},{"text":"düşünmeden dudaklarıyla konuştu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yahve’nin onlara buyurduğu gibi,","poem":1},{"text":"halkları yok etmediler.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ama uluslara karıştılar,","poem":1},{"text":"onların işlerini öğrendiler.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Putlarına hizmet ettiler,","poem":1},{"text":"bu onlara tuzak oldu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Evet, oğullarını ve kızlarını iblislere kurban ettiler.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Suçsuz kanı döktüler,","poem":1},{"text":"oğullarının ve kızlarının kanlarını bile,","poem":2},{"lineBreak":true},{"text":"Kenan putlarına kurban olarak sundular.","poem":2},{"lineBreak":true},{"text":"Toprak kanla kirlendi.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Böylece işleriyle kirlendiler,","poem":1},{"text":"kendi eylemlerinde fahişelik ettiler.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bu yüzden Yahve’nin öfkesi halkına karşı tutuştu.","poem":1},{"text":"Mirasından nefret etti.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Onları ulusların eline verdi.","poem":1},{"text":"Onlardan nefret edenler onlara hükmetti.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Düşmanları da onlara zulmetti.","poem":1},{"text":"Onların eli altında boyun eğdirildiler.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Onları defalarca kurtardı,","poem":1},{"text":"ama kendi öğütlerinde isyankârdılar,","poem":2},{"lineBreak":true},{"text":"kötülükleri yüzünden alçaltıldılar.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Yine de onların sıkıntısını gördü,","poem":1},{"text":"onların yakarışlarını duyduğunda.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Onlar için antlaşmasını hatırladı,","poem":1},{"text":"sevgi dolu iyiliğinin çokluğuna göre","poem":2},{"lineBreak":true},{"text":"düşüncesinden vazgeçti.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Onları tutsak alanların","poem":1},{"text":"onlara acımasını sağladı.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Kurtar bizi, ey Tanrımız Yahve,","poem":1},{"text":"kutsal adına şükretmek,","poem":2},{"lineBreak":true},{"text":"övgünle zafer kazanmak için,","poem":2},{"lineBreak":true},{"text":"bizi ulusların arasından topla!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"İsrael'in Tanrısı Yahve’ye,","poem":1},{"text":"sonsuzluklar boyunca övgüler olsun!","poem":2},{"lineBreak":true},{"text":"Bütün halk “Amin” desin.","poem":2},{"lineBreak":true},{"text":"Yah’a övgüler olsun!","poem":2},{"text":"5. KİTAP","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}