{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve’ye","poem":1},{"noteId":36},{"text":"şükredin, çünkü O iyidir,","poem":1},{"text":"çünkü sevgi dolu iyiliği sonsuza dek sürer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve’nin kurtardıkları böyle desinler,","poem":1},{"text":"düşmanın elinden kurtardıkları,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"onları, doğudan ve batıdan,","poem":1},{"text":"kuzeyden ve güneyden,","poem":2},{"lineBreak":true},{"text":"ülkelerden topladı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çölde ıssız bir yolda dolaştılar.","poem":1},{"text":"Yaşanacak bir kent bulamadılar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aç ve susuz,","poem":1},{"text":"içlerindeki canları bitkin düştü.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O zaman sıkıntı içinde Yahve’ye yakardılar,","poem":1},{"text":"onları sıkıntılarından kurtardı,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"yaşamak için bir kente gidebilsinler diye,","poem":1},{"text":"onlara doğru yolda öncülük etti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve’ye sevgi dolu iyiliği için,","poem":1},{"text":"insanoğullarına olan harika işleri için,","poem":2},{"lineBreak":true},{"text":"övsünler!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü özlemle dolu canı doyurur.","poem":1},{"text":"Aç canı iyilikle doldurur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bazıları karanlıkta, ölümün gölgesinde,","poem":1},{"text":"ıstırap ve demirle bağlı oturmuştu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü Tanrı'nın","poem":1},{"noteId":37},{"text":"sözlerine isyan ettiler,","poem":1},{"text":"Yüceler Yücesi'ni küçümsediler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bu nedenle onların yüreğini emekle alçalttı.","poem":1},{"text":"Düştüler, yardım edecek kimse yoktu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O zaman sıkıntı içinde Yahve’ye yakardılar,","poem":1},{"text":"onları sıkıntılarından kurtardı.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onları karanlıktan ve ölümün gölgesinden çıkardı,","poem":1},{"text":"zincirlerini kırdı.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yahve’ye sevgi dolu iyiliği için,","poem":1},{"text":"insanoğullarına olan harika işleri için,","poem":2},{"lineBreak":true},{"text":"övsünler!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü tunç kapıları kırdı,","poem":1},{"text":"demir sürgüleri parçaladı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akılsızlar itaatsizliklerinden","poem":1},{"text":"ve kötülükleri yüzünden sıkıntı çekerler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Canları her türlü yiyecekten tiksinir.","poem":1},{"text":"Ölüm kapılarına yaklaşırlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"O zaman sıkıntı içinde Yahve’ye feryat ederler,","poem":1},{"text":"onları sıkıntılarından kurtarır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sözünü gönderip onları iyileştirir,","poem":1},{"text":"onları mezarlarından kurtarır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yahve’ye sevgi dolu iyiliği için,","poem":1},{"text":"insanoğullarına olan harika işleri için,","poem":2},{"lineBreak":true},{"text":"övsünler!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Şükran kurbanları sunsunlar,","poem":1},{"text":"işlerini ezgilerle ilan etsinler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gemilerle denize inenler,","poem":1},{"text":"büyük sularda iş yapanlar,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"onlar Yahve’nin işlerini,","poem":1},{"text":"derinlerdeki harikalarını görürler.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Çünkü O buyruk verir, fırtına rüzgârını kaldırır,","poem":1},{"text":"denizin dalgalarını yükseltir.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gökyüzüne yükselirler, yeniden derinlere inerler.","poem":1},{"text":"Sıkıntıdan ötürü canları erir.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sarhoş biri gibi ileri geri sallanıp, sendelerler,","poem":1},{"text":"akılları başlarından gider.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"O zaman sıkıntı içinde Yahve’ye feryat ederler,","poem":1},{"text":"onları sıkıntılarından kurtarır.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Fırtınayı yatıştırır,","poem":1},{"text":"dalgalar sakinleşir.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"O zaman ortalık sakinleştiği için sevinirler,","poem":1},{"text":"onları diledikleri limana götürür.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yahve’ye sevgi dolu iyiliği için,","poem":1},{"text":"insanoğullarına olan harika işleri için,","poem":2},{"lineBreak":true},{"text":"övsünler!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Halk topluluğunda O'nu yüceltsinler,","poem":1},{"text":"ihtiyarlar meclisinde O’nu övsünler.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Irmakları çöle,","poem":1},{"text":"pınarları kuru toprağa,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"verimli toprağı orada oturanların kötülüğü yüzünden","poem":1},{"text":"çorak alana döndürür.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Çölü su göletine,","poem":1},{"text":"kurak yeri su pınarlarına çevirir.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Yaşanacak bir kent hazırlasınlar diye","poem":1},{"text":"orada açları yaşatır.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Tarlalar ekerler, bağlar dikerler,","poem":1},{"text":"çoğalan ürünü toplarlar.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Onları da kutsar, böylece fazlasıyla çoğalırlar.","poem":1},{"text":"Hayvanlarının eksilmesine izin vermez.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Baskı, sıkıntı ve keder yüzünden","poem":1},{"text":"yine azalırlar ve alçalırlar.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Beylere hakaret yağdırır,","poem":1},{"text":"yolsuz çorak bir yerde onları dolaştırır.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yine de yoksulları sıkıntılarından kurtarır,","poem":1},{"text":"ailelerini sürü gibi çoğaltır.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Doğrular bunu görecek ve sevinecek.","poem":1},{"text":"Bütün kötüler ağzını kapayacak.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Bilge olan bunlara dikkat etsin.","poem":1},{"text":"Yahve’nin sevgi dolu iyiliklerini düşünsün.","poem":2}]}],"footnotes":[{"noteId":36,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":107,"verse":1}},{"noteId":37,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":107,"verse":11}}]},"thisChapterLink":"/api/tur_ytc/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}