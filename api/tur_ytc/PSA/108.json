{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Ezgi - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yüreğim kararlıdır, ey Tanrı.","poem":1},{"text":"Ezgi söyleyecek, canımla müzik yapacağım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uyan, ey arp ve lir!","poem":1},{"text":"Şafağı ben uyandırayım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uluslar arasında sana şükürler sunayım, ey Yahve.","poem":1},{"text":"Halkların arasında seni ilahilerle öveyim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü sevgi dolu iyiliğin göklerin üstünde büyüktür.","poem":1},{"text":"Sadakatin gökyüzüne ulaşır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Tanrı, göklerin üstünde yücel!","poem":1},{"text":"Görkemin tüm yeryüzünü kaplasın.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sevdiklerin kurtulsun diye,","poem":1},{"text":"sağ elinle kurtar ve yanıt ver bize.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tanrı kutsal yerinden şöyle konuştu:","poem":1},{"text":"“Zafer kazanacağım.","poem":2},{"lineBreak":true},{"text":"Şekem'i böleceğim,","poem":2},{"lineBreak":true},{"text":"Sukkot Vadisi’ni ölçeceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilad benimdir, Manaşşe de benim.","poem":1},{"text":"Efraim de başımın siperi,","poem":2},{"lineBreak":true},{"text":"Yahuda asamdır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moav yıkanma leğenimdir.","poem":1},{"text":"Edom'un üzerine çarığımı atacağım.","poem":2},{"lineBreak":true},{"text":"Filist üzerine zaferle haykıracağım.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kim beni surlu kente götürecek?","poem":1},{"text":"Bana kim Edom'a kadar yol gösterecek?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey Tanrı, sen bizi reddetmedin mi?","poem":1},{"text":"Ordularımızla yola çıkmıyorsun, ey Tanrı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Düşmana karşı bize yardım et,","poem":1},{"text":"çünkü insanın yardımı boştur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tanrı’yla yiğitlik ederiz,","poem":1},{"text":"çünkü düşmanlarımızı ezecek olan O’dur.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}