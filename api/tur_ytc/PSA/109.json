{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"verse","number":1,"content":[{"text":"Ey övgülerimin Tanrısı, sessiz kalma,","descriptive":true}]},{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":2,"content":[{"text":"Çünkü kötünün ağzını, hilekâr ağzını bana karşı açtılar.","poem":1},{"text":"Benimle yalancı bir dille konuştular.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nefret dolu sözlerle çevremi sarıp,","poem":1},{"text":"nedensiz yere bana karşı savaştılar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sevgime karşılık bana düşmandırlar,","poem":1},{"text":"bense dua etmekteyim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İyiliğe kötülükle,","poem":1},{"text":"sevgime nefretle karşılık verdiler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Başına kötü bir adam koy.","poem":1},{"text":"Sağ yanında bir düşman dursun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yargılandığı zaman suçlu çıksın.","poem":1},{"text":"Duası günaha dönsün.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Günleri az olsun.","poem":1},{"text":"Makamını bir başkası alsın.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çocukları yetim,","poem":1},{"text":"karısı dul kalsın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çocukları başıboş gezen dilenciler olsun.","poem":1},{"text":"Yıkık yerlerinden çıkıp aransınlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tefeci tüm malını kapsın.","poem":1},{"text":"Emeğinin ürününü yabancılar yağmalasın.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ona iyilik eden kimse olmasın,","poem":1},{"text":"yetimlerine acıyacak kimse olmasın.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Soyu kesilsin.","poem":1},{"text":"Gelecek kuşakta adları silinsin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Atalarının suçları Yahve tarafından hatırlansın.","poem":1},{"text":"Annesinin günahı silinmesin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sürekli Yahve’nin önünde bulunsunlar,","poem":1},{"text":"öyle ki, anılarını yeryüzünden kesip atsın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İyilik etmeyi hatırlamadı,","poem":1},{"text":"ama yoksulu ve muhtacı,","poem":2},{"lineBreak":true},{"text":"yüreği kırık olanı öldürmek için zulmetti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Laneti sevdi ve kendi başına geldi.","poem":1},{"text":"Kutsamaktan hoşlanmadı ve bu ondan uzak kaldı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Laneti giysisi gibi kuşandı.","poem":1},{"text":"Su gibi iç kısımlarına,","poem":2},{"lineBreak":true},{"text":"yağ gibi kemiklerine girdi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kendisini örteceği giysi gibi olsun ona,","poem":1},{"text":"hep kuşandığı bir kemer gibi olsun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Düşmanlarıma, canım için kötülük söyleyenlere","poem":1},{"text":"Yahve’nin verdiği karşılık budur.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ama sen, ey Efendim","poem":1},{"noteId":38},{"text":"Yahve,","poem":1},{"text":"adın uğruna benimle ilgilen,","poem":2},{"lineBreak":true},{"text":"çünkü sevgi dolu şefkatin iyidir, kurtar beni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü ben yoksul ve muhtacım.","poem":1},{"text":"Yüreğim içimde yaralı.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akşam gölgesi gibi kayboluyorum.","poem":1},{"text":"Çekirge gibi silkelenip atıldım.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dizlerim oruçtan zayıfladı.","poem":1},{"text":"Bedenim ince ve yağsız kaldı.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ben de onlara yüzkarası oldum.","poem":1},{"text":"Beni gördüklerinde başlarını sallıyorlar.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yardım et bana, ey Yahve Tanrım.","poem":1},{"text":"Sevgi dolu iyiliğin uyarınca beni kurtar;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"bilsinler ki bu senin elindir,","poem":1},{"text":"bunu yapan sensin ey Yahve.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Onlar lanet edebilir, ama sen kutsa.","poem":1},{"text":"Ayağa kalktıklarında utanacaklar,","poem":2},{"lineBreak":true},{"text":"ama senin hizmetkârın sevinecek.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Düşmanlarım rezilliği giyinsin.","poem":1},{"text":"Bir elbise gibi kendilerini kendi utançlarıyla örtsünler.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yahve’ye ağzımla çok şükürler sunacağım.","poem":1},{"text":"Kalabalığın arasında O’nu öveceğim.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Çünkü O, yoksulun canını yargılayanlardan","poem":1},{"text":"onu kurtarmak için sağında durur.","poem":2}]}],"footnotes":[{"noteId":38,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":109,"verse":21}}]},"thisChapterLink":"/api/tur_ytc/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}