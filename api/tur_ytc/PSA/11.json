{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ben Yahve’ye sığınırım.","poem":1},{"text":"Nasıl olur da canıma, “Kuş gibi dağa kaç” dersiniz?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü işte, kötüler yaylarını geriyor.","poem":1},{"text":"Karanlıkta dürüst yüreklileri vurmak için,","poem":2},{"lineBreak":true},{"text":"Oklarını kiriş üzerine yerleştirdiler.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Temeller yıkılırsa,","poem":2},{"lineBreak":true},{"text":"doğru kişi ne yapabilir?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve kutsal tapınağındadır.","poem":1},{"text":"Yahve gökte tahtındadır.","poem":2},{"lineBreak":true},{"text":"O’nun gözleri bakar.","poem":2},{"lineBreak":true},{"text":"Gözleri insanoğullarını sınar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve doğru kişiyi sınar,","poem":1},{"text":"ama O'nun canı kötüden ve zorbalığı sevenden nefret eder.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kötülerin üzerine kızgın korlar yağdıracak;","poem":1},{"text":"ateş, kükürt ve kavurucu rüzgâr onların kâsesine düşen pay olacak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü Yahve doğrudur.","poem":1},{"text":"Doğruluğu sever.","poem":2},{"lineBreak":true},{"text":"Doğru kişi O’nun yüzünü görecek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}