{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve Efendim’e:","poem":1},{"text":"“Ben düşmanlarını ayakların için tabure edene dek,","poem":2},{"lineBreak":true},{"text":"sağımda otur” dedi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve senin kuvvet asanı Siyon'dan gönderecek.","poem":1},{"text":"Düşmanlarının arasında hüküm sür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Halkın, gücünün gününde kutsal düzen içinde","poem":1},{"text":"kendilerini gönüllü olarak sunarlar.","poem":2},{"lineBreak":true},{"text":"Gençlerin sabahın rahminden doğan çiğ gibidir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve ant içti, düşüncesini değiştirmez:","poem":1},{"text":"“Melkisedek düzeninde sen sonsuza dek kâhinsin.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Efendi senin sağındadır.","poem":1},{"text":"Gazabının gününde kralları ezecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uluslar arasında hüküm verecek.","poem":1},{"text":"Cesetleri yığacak.","poem":2},{"lineBreak":true},{"text":"Bütün dünyanın hükümdarını ezecek.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yolda dereden içecek;","poem":1},{"text":"bu nedenle başını dik tutacak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}