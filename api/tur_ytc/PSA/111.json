{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Yah’ı övün!","poem":1},{"noteId":39},{"text":"Doğruların meclisinde ve topluluk içinde","poem":2},{"lineBreak":true},{"text":"bütün yüreğimle Yahve’ye şükürler sunacağım,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve’nin işleri büyüktür,","poem":1},{"text":"onlardan zevk alanların hepsi onları düşünür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O’nun işi saygınlık ve heybettir.","poem":1},{"text":"Doğruluğu sonsuza dek sürer.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Harika işlerinin hatırlanmasını sağladı.","poem":1},{"text":"Yahve lütufkâr ve merhametlidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kendisinden korkanlara yiyecek verir.","poem":1},{"text":"O her zaman antlaşmasını hatırlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ulusların mirasını onlara vermekle","poem":1},{"text":"halkına işlerinin gücünü gösterdi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ellerinin işleri gerçek ve adalettir.","poem":1},{"text":"O’nun bütün kuralları kesindir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onlar sonsuzluklar boyunca sabittir.","poem":1},{"text":"Gerçek ve doğrulukla yapılır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halkına kurtuluş gönderdi.","poem":1},{"text":"Antlaşmasını sonsuza dek atamıştır.","poem":2},{"lineBreak":true},{"text":"O’nun adı kutsal ve muhteşemdir!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve korkusu bilgeliğin başlangıcıdır.","poem":1},{"text":"O’nun işini yapanların hepsi iyi bir anlayışa sahiptir.","poem":2},{"lineBreak":true},{"text":"O’nun övgüsü sonsuza dek sürer!","poem":2}]}],"footnotes":[{"noteId":39,"caller":"+","text":"Mezmurlar 111, her bir dizesinde “Yah’a şükürler olsun!” ifadesinin yer aldığı bir akrostiş şiirdir; alfabedeki bir harfle başlar (Alef’ten Tav’a doğru sıralanmıştır).","reference":{"chapter":111,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}