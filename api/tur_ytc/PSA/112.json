{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Yah’ı övün!","poem":1},{"noteId":40},{"text":"Ne mutlu Yahve'den korkan insana,","poem":2},{"lineBreak":true},{"text":"O’nun buyruklarından büyük zevk alana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Onun soyu ülkede kudretli olacak.","poem":1},{"text":"Doğruların kuşağı kutsanacak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bolluk ve zenginlik onun evindedir.","poem":1},{"text":"Onun doğruluğu sonsuza dek sürer.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Doğrular için karanlıkta ışık doğar,","poem":1},{"text":"lütufkâr, merhametli ve adildir onlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lütfedenin ve ödünç verenin durumu iyidir.","poem":1},{"text":"Yargıda davasını sürdürür.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü o asla sarsılmaz.","poem":1},{"text":"Doğrular daima hatırlanır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötü haberden korkmaz.","poem":1},{"text":"Yüreği kararlıdır, Yahve’ye güvenir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yüreği sağlamdır.","poem":1},{"text":"Sonunda düşmanlarını gördüğünde korkmaz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O dağıttı, yoksullara verdi.","poem":1},{"text":"Doğruluğu sonsuza dek durur.","poem":2},{"lineBreak":true},{"text":"Boynuzu saygınlıkla yükselir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kötü kişi bunu görüp dertlenir.","poem":1},{"text":"Dişlerini gıcırdatır, eriyip gider.","poem":2},{"lineBreak":true},{"text":"Kötülerin dileği yok olur.","poem":2}]}],"footnotes":[{"noteId":40,"caller":"+","text":"Mezmurlar 112, her bir dizesinde “Yah’a şükürler olsun!” ifadesinin yer aldığı bir akrostiş şiirdir ve her beyit alfabedeki bir harfle başlar (Alef’ten Tav’a doğru sıralanmıştır).","reference":{"chapter":112,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}