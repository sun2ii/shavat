{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Bize değil, ey Yahve, bize değil.","poem":1},{"text":"Ama sevgi dolu iyiliğin ve gerçeğin uğruna,","poem":2},{"lineBreak":true},{"text":"kendi adına yücelik ver.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neden uluslar:","poem":1},{"text":"“Şimdi, onların Tanrısı nerede?” desin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama Tanrımız göklerdedir.","poem":1},{"text":"Ne isterse onu yapar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onların putları gümüş ve altındır,","poem":1},{"text":"insan ellerinin işi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ağızları var ama konuşmazlar.","poem":1},{"text":"Gözleri var ama görmezler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kulakları var ama duymazlar.","poem":1},{"text":"Burunları var ama koku almazlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Elleri var ama hissetmezler.","poem":1},{"text":"Ayakları var ama yürümezler,","poem":2},{"lineBreak":true},{"text":"boğazlarıyla da konuşmazlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onları yapanlar ve onlara güvenen herkes,","poem":1},{"text":"onlar gibi olacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey İsrael, Yahve’ye güven!","poem":1},{"text":"O’dur onların yardımcısı ve kalkanı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ey Aron Evi, Yahve’ye güvenin!","poem":1},{"text":"O’dur onların yardımcısı ve kalkanı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey sizler Yahve’den korkanlar, Yahve’ye güvenin!","poem":1},{"text":"O’dur onların yardımcısı ve kalkanı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yahve bizi hatırlar. O bizi kutsayacak.","poem":1},{"text":"İsrael'in evini kutsayacak.","poem":2},{"lineBreak":true},{"text":"Aron'un evini kutsayacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve'den korkanları,","poem":1},{"text":"küçüğü de büyüğü de kutsayacak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yahve sizi,","poem":1},{"text":"sizi ve çocuklarınızı fazlasıyla artırsın.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Göğü ve yeri yaratan Yahve","poem":1},{"text":"sizi kutsasın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gökler Yahve’nin gökleridir,","poem":1},{"text":"ama yeryüzünü insanoğullarına verdi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ölüler, sessizliğin içine inenler,","poem":1},{"text":"Yah'ı övmezler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ama biz şimdiden sonsuza dek,","poem":1},{"text":"Yah’ı öveceğiz,","poem":2},{"lineBreak":true},{"text":"Yah’ı övün!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}