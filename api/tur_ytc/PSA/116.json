{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve'yi seviyorum,","poem":1},{"text":"çünkü sesimi, feryadımı merhametiyle duyar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kulağını bana döndürdüğü için,","poem":1},{"text":"yaşadığım sürece O’nu çağıracağım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ölüm ipleri çevremi sarmıştı,","poem":1},{"text":"Şeol'ün","poem":2},{"noteId":41},{"text":"acıları beni ele geçirmişti.","poem":2},{"lineBreak":true},{"text":"Sıkıntı ve keder buldum.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O zaman Yahve’nin adını çağırdım:","poem":1},{"text":"“Ey Yahve, sana yalvarıyorum, canımı kurtar.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve lütufkâr ve doğrudur.","poem":1},{"text":"Merhametlidir Tanrımız.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve saf insanı korur.","poem":1},{"text":"Alçaltılmıştım ve O beni kurtardı.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey canım, rahatına dön,","poem":1},{"text":"çünkü Yahve sana cömertçe davrandı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü canımı ölümden,","poem":1},{"text":"gözlerimi gözyaşından,","poem":2},{"lineBreak":true},{"text":"ayaklarımı düşmekten kurtardın.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaşayanlar diyarında","poem":1},{"text":"Yahve’nin önünde yürüyeceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İman ettim, bu nedenle şöyle dedim:","poem":1},{"text":"“Çok acı çektim.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Telaşla şöyle dedim:","poem":1},{"text":"“Bütün insanlar yalancıdır.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bana yönelik tüm iyiliklerine karşılık","poem":1},{"text":"Yahve’ye ne vereyim?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kurtuluş kâsesini alıp","poem":1},{"text":"Yahve’nin adını çağıracağım.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bütün halkının önünde,","poem":1},{"text":"Yahve’ye adaklarımı yerine getireceğim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yahve’nin gözünde","poem":1},{"text":"kutsallarının ölümü değerlidir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ey Yahve, gerçekten ben senin hizmetkârınım.","poem":1},{"text":"Hizmetkârın, hizmetçi kızın oğluyum.","poem":2},{"lineBreak":true},{"text":"Zincirlerimden beni sen serbest bıraktın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sana şükran kurbanını sunacağım,","poem":1},{"text":"Yahve’nin adını çağıracağım.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yahve’ye adaklarımı yerine getireceğim,","poem":1},{"text":"bütün halkının önünde,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yahve'nin evinin avlularında,","poem":1},{"text":"senin ortanda, ey Yeruşalem.","poem":2},{"lineBreak":true},{"text":"Yah’ı övün!","poem":2}]}],"footnotes":[{"noteId":41,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":116,"verse":3}}]},"thisChapterLink":"/api/tur_ytc/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}