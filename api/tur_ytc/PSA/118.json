{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve’ye şükredin, çünkü O iyidir,","poem":1},{"text":"sevgi dolu iyiliği sonsuza dek sürer.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Şimdi İsrael,","poem":1},{"text":"“Sevgi dolu iyiliği sonsuza dek sürer” desin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Şimdi Aron'un evi,","poem":1},{"text":"“Sevgi dolu iyiliği sonsuza dek sürer” desin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Şimdi Yahve’den korkanlar,","poem":1},{"text":"“Sevgi dolu iyiliği sonsuza dek sürer” desin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sıkıntı içinde Yah’a seslendim.","poem":1},{"text":"Yah özgürlükle bana yanıt verdi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve benden yanadır. Korkmam.","poem":1},{"text":"İnsan bana ne yapabilir?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bana yardım edenlerin arasında","poem":1},{"text":"Yahve benden yanadır.","poem":2},{"lineBreak":true},{"text":"Bu nedenle benden nefret edenlere zaferle bakacağım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve’ye sığınmak,","poem":1},{"text":"insana güvenmekten iyidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve’ye sığınmak,","poem":1},{"text":"beylere güvenmekten iyidir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bütün uluslar çevremi sardı,","poem":1},{"text":"ama Yahve’nin adıyla kopardım onları.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çevremi sardılar, evet çevremi sardılar.","poem":1},{"text":"Yahve’nin adıyla gerçekten kopardım onları.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Arılar gibi çevremi sardılar.","poem":1},{"text":"Diken ateşi gibi söndüler.","poem":2},{"lineBreak":true},{"text":"Yahve’nin adıyla kopardım onları.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Düşeyim diye beni şiddetle geri ittin,","poem":1},{"text":"ama Yahve bana yardım etti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yah benim gücüm ve ezgimdir.","poem":1},{"text":"O benim kurtuluşum oldu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sevinç ve kurtuluş sesi doğruların çadırlarındadır.","poem":1},{"text":"“Yahve’nin sağ eli yiğitlik eder.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve’nin sağ eli yücedir!","poem":1},{"text":"Yahve’nin sağ eli yiğitlik eder!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ölmeyeceğim, yaşayacağım,","poem":1},{"text":"Yah'ın işlerini ilan edeceğim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yah beni ciddi bir şekilde cezalandırdı,","poem":1},{"text":"ama beni ölüme teslim etmedi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bana doğruluğun kapılarını aç.","poem":1},{"text":"Onların içine gireyim.","poem":2},{"lineBreak":true},{"text":"Yah’a şükürler sunayım.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yahve’nin kapısı işte budur;","poem":1},{"text":"doğrular oraya girer.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sana şükrederim, çünkü bana yanıt verdin,","poem":1},{"text":"benim kurtuluşum oldun.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yapıcıların reddettiği taş","poem":1},{"text":"köşe taşı","poem":2},{"noteId":42},{"text":"oldu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bu Yahve’nin işidir.","poem":1},{"text":"Gözümüzde şaşılacak bir iş.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yahve’nin yarattığı gün bu gündür.","poem":1},{"text":"İçinde sevinip coşalım!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bizi şimdi kurtar, ey Yahve, sana yalvarırız!","poem":1},{"text":"Sana yalvarırız, ey Yahve, şimdi bolluk gönder.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kutsansın Yahve’nin adıyla gelen!","poem":1},{"text":"Yahve’nin evinden seni kutsarız.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yahve Tanrı'dır ve bize ışık verdi.","poem":1},{"text":"Kurbanınızı sunağın boynuzlarına kadar iplerle bağlayın.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sen benim Tanrım’sın, sana şükrederim.","poem":1},{"text":"Sen benim Tanrım’sın, seni yüceltirim.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yahve’ye şükredin, çünkü O iyidir,","poem":1},{"text":"sevgi dolu iyiliği sonsuza dek sürer.","poem":2}]}],"footnotes":[{"noteId":42,"caller":"+","text":"Kelimenin tam anlamıyla köşenin başı","reference":{"chapter":118,"verse":22}}]},"thisChapterLink":"/api/tur_ytc/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}