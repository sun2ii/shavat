{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"hebrew_subtitle","content":["א ALEF"]},{"type":"verse","number":1,"content":[{"text":"Ne mutlu yolları kusursuz olanlara,","poem":1},{"text":"Yahve’nin yasasına göre yürüyenlere.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne mutlu O'nun kurallarına uyanlara,","poem":1},{"text":"O’nu tüm yüreğiyle arayanlara.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Evet, onlar hiç haksızlık etmezler.","poem":1},{"text":"O’nun yolunda yürürler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onlara tamamen uyalım diye,","poem":1},{"text":"ilkelerini buyurdun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Keşke yollarım sağlam olsaydı","poem":1},{"text":"yasalarına itaat etmek için!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O zaman hayal kırıklığına uğramazdım,","poem":1},{"text":"bütün buyruklarını göz önünde bulundurdukça.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sana dürüst bir yürekle şükredeceğim,","poem":1},{"text":"doğru hükümlerini öğrendikçe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kurallarına uyacağım.","poem":1},{"text":"Beni bütünüyle terk etme.","poem":2},{"text":"ב BEYT","descriptive":true}]},{"type":"verse","number":9,"content":[{"text":"Genç insan yolunu nasıl temiz tutabilir?","poem":1},{"text":"Sözüne göre yaşamakla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bütün yüreğimle seni aradım.","poem":1},{"text":"Buyruklarından sapmama izin verme.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sözünü yüreğimde sakladım,","poem":1},{"text":"sana karşı günah işlememek için.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Övgüler olsun sana, ey Yahve.","poem":1},{"text":"Bana kurallarını öğret.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dudaklarımla,","poem":1},{"text":"ağzından çıkan bütün hükümlerini ilan ederim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Senin tanıklıkların yolunda,","poem":1},{"text":"tüm zenginlikler benimmiş gibi sevindim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Senin ilkelerin üzerinde","poem":1},{"text":"derin derin düşüneceğim,","poem":2},{"lineBreak":true},{"text":"yollarını göz önünde bulunduracağım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Senin kurallarından zevk alırım.","poem":1},{"text":"Sözünü unutmam.","poem":2},{"text":"ג GİMEL","descriptive":true}]},{"type":"verse","number":17,"content":[{"text":"Hizmetkârına iyilik et de yaşayayım,","poem":1},{"text":"sözüne uyayım.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gözlerimi aç da","poem":1},{"text":"yasandaki şaşılası şeyleri göreyim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ben yeryüzünde bir yabancıyım.","poem":1},{"text":"Buyruklarını benden saklama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Canım her zaman senin hükümlerinin özlemiyle","poem":1},{"text":"yanıp tutuşuyor.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Senin buyruklarından sapan","poem":1},{"text":"lanetli küstahları azarladın.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Utancı ve hakareti benden uzaklaştır,","poem":1},{"text":"çünkü senin hükümlerini tuttum.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Beyler oturup bana iftira etse bile,","poem":1},{"text":"hizmetkârın senin ilkelerinin üzerinde","poem":2},{"lineBreak":true},{"text":"derin derin düşünecek.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gerçekten de senin ilkelerin benim zevkimdir,","poem":1},{"text":"danışmanlarımdır.","poem":2},{"text":"ד DALET","descriptive":true}]},{"type":"verse","number":25,"content":[{"text":"Canım toprağa serildi.","poem":1},{"text":"Sözün uyarınca dirilt beni!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yollarımı açıkladım, bana yanıt verdin.","poem":1},{"text":"Bana kurallarını öğret.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"İlkelerindeki öğretiyi anlamamı sağla!","poem":1},{"text":"O zaman senin şaşılası işlerinin","poem":2},{"lineBreak":true},{"text":"üzerinde derin derin düşünürüm.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Canım kederden bitkin,","poem":1},{"text":"sözün uyarınca güçlendir beni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Beni yalan yolundan uzak tut.","poem":1},{"text":"Yasanı bana lütufla bağışla!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ben gerçeğin yolunu seçtim.","poem":1},{"text":"Hükümlerini önüme koydum.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Senin kurallarına sarıldım, ey Yahve.","poem":1},{"text":"Hayal kırıklığına uğratma beni.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Buyruklarının yolunda koşuyorum,","poem":1},{"text":"çünkü yüreğimi özgür kıldın.","poem":2},{"text":"ה HE","descriptive":true}]},{"type":"verse","number":33,"content":[{"text":"Ey Yahve, bana yasalarının yolunu öğret.","poem":1},{"text":"Onları sonuna dek tutayım.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bana anlayış ver, yasana uyayım.","poem":1},{"text":"Evet, ona tüm yüreğimle itaat edeyim.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Buyruklarının yolunda bana yol göster,","poem":1},{"text":"çünkü onlardan zevk alırım.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Yüreğimi bencil kazanca değil,","poem":1},{"text":"senin kurallarına yönelt.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Gözlerimi değersiz şeylere bakmaktan çevir.","poem":1},{"text":"Beni kendi yollarınla canlandır.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Hizmetkârına verdiğin sözü yerine getir ki,","poem":1},{"text":"senden korkulsun.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Korktuğum hakareti benden uzaklaştır,","poem":1},{"text":"çünkü senin hükümlerin iyidir.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"İşte, senin ilkelerini özlüyorum!","poem":1},{"text":"Beni doğruluğunun içinde dirilt.","poem":2},{"text":"ו VAV","descriptive":true}]},{"type":"verse","number":41,"content":[{"text":"Sözün uyarınca, ey Yahve,","poem":1},{"text":"sevgi dolu iyiliğin, kurtarışın da bana gelsin.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Böylece bana hakaret edene bir yanıtım olsun,","poem":1},{"text":"çünkü senin sözüne güveniyorum.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Gerçeğin sözünü ağzımdan düşürme,","poem":1},{"text":"çünkü senin hükümlerine umut bağladım ben.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Bu yüzden yasana sürekli,","poem":1},{"text":"sonsuza dek uyacağım.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Özgürce yürüyeceğim,","poem":1},{"text":"çünkü senin ilkelerini aradım.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Kralların önünde de senin kuralların hakkında konuşacak,","poem":1},{"text":"hayal kırıklığına uğramayacağım.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Buyruklarından zevk alırım,","poem":1},{"text":"çünkü onları severim.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Sevdiğim buyruklarına ellerimi kaldırırım.","poem":1},{"text":"Senin kurallarının üzerinde derin derin düşüneyim.","poem":2},{"text":"ז ZAYİN","descriptive":true}]},{"type":"verse","number":49,"content":[{"text":"Hizmetkârına verdiğin sözü hatırla,","poem":1},{"text":"çünkü bana umut verdin.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Sıkıntımda tesellim budur,","poem":1},{"text":"çünkü senin sözün beni diriltti.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Küstahlar benimle çok alay ettiler,","poem":1},{"text":"ama senin yasandan sapmadım.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Eski hükümlerini hatırlarım, ey Yahve,","poem":1},{"text":"kendimi teselli ettim.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Öfke beni ele geçirdi,","poem":1},{"text":"yasanı terk eden kötüler yüzünden.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Senin kuralların yaşadığım evde","poem":1},{"text":"benim ezgilerim oldu.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Gece adını hatırladım, ey Yahve,","poem":1},{"text":"yasana uyarım.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Benim yolum budur;","poem":1},{"text":"senin ilkelerini tutmak.","poem":2},{"text":"ח HET","descriptive":true}]},{"type":"verse","number":57,"content":[{"text":"Benim payım Yahve’dir.","poem":1},{"text":"Sözlerine uyacağıma söz verdim.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Bütün yüreğimle lütfunu aradım.","poem":1},{"text":"Sözün uyarınca bana merhamet et.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Yollarımı düşündüm,","poem":1},{"text":"adımlarımı senin hükümlerine yönelttim.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Senin buyruklarını tutmak için","poem":1},{"text":"acele ettim, geç kalmadım.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Kötülerin ipleri beni bağladı,","poem":1},{"text":"ama yasanı unutmadım.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Doğru hükümlerin için","poem":1},{"text":"gece yarısı kalkıp sana şükrederim.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Senden korkan, ilkelerine uyan herkesin,","poem":1},{"text":"dostuyum ben.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Yeryüzü sevgi dolu iyiliğinle dolu, ey Yahve.","poem":1},{"text":"Bana kurallarını öğret.","poem":2},{"text":"ט TET","descriptive":true}]},{"type":"verse","number":65,"content":[{"text":"Sözün uyarınca","poem":1},{"text":"hizmetkârına iyilik ettin, ey Yahve.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Bana sağduyu ve bilgi öğret,","poem":1},{"text":"çünkü senin buyruklarına inanıyorum.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Acı çekmeden önce yoldan sapmıştım,","poem":1},{"text":"ama şimdi sözüne uyuyorum.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Sen iyisin ve iyilik edersin.","poem":1},{"text":"Bana kurallarını öğret.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Küstahlar yalanla bana kara çaldılar.","poem":1},{"text":"Ben bütün yüreğimle ilkelerini tutarım.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Onların yürekleri yağ gibi katılaştı,","poem":1},{"text":"bense yasandan zevk alırım.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Acı çekmem benim için iyi oldu,","poem":1},{"text":"ta ki, kurallarını öğreneyim.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Senin ağzının yasası","poem":1},{"text":"benim için binlerce altın ve gümüşten daha iyidir.","poem":2},{"text":"י YOD","descriptive":true}]},{"type":"verse","number":73,"content":[{"text":"Senin ellerin beni yarattı ve biçim verdi.","poem":1},{"text":"Bana anlayış ver ki, buyruklarını öğrenebileyim.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Senden korkanlar beni görecek ve sevinecek,","poem":1},{"text":"çünkü ben umudumu senin sözüne bağladım.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Ey Yahve, yargılarının doğru olduğunu bilirim,","poem":1},{"text":"sadakatinde bana acı verdin.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Hizmetkârına olan sözün uyarınca,","poem":1},{"text":"lütfen sevgi dolu iyiliğin bana teselli olsun.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Senin şefkatli merhametlerin bana gelsin, yaşayayım,","poem":1},{"text":"çünkü yasan benim zevkimdir.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Küstahlar hayal kırıklığına uğrasın,","poem":1},{"text":"çünkü haksız yere beni düşürdüler.","poem":2},{"lineBreak":true},{"text":"Ben senin ilkelerinin üzerinde","poem":2},{"lineBreak":true},{"text":"derin derin düşüneceğim.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Senden korkanlar bana dönsünler.","poem":1},{"text":"Yasalarını bilecekler.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Yüreğim senin hükümlerine karşı suçsuz olsun ki,","poem":1},{"text":"hayal kırıklığına uğramayayım.","poem":2},{"text":"כ KAF","descriptive":true}]},{"type":"verse","number":81,"content":[{"text":"Canım senin kurtarışın için bitkin durumda.","poem":1},{"text":"Senin sözüne umut bağladım.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Gözlerim senin sözün için sönüyor.","poem":1},{"text":"“Beni ne zaman teselli edeceksin?” diyorum.","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Çünkü dumanda kalmış şarap tulumu gibi oldum.","poem":1},{"text":"Senin kurallarını unutmuyorum.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Hizmetkârının günleri ne kadardır?","poem":1},{"text":"Bana zulmedenleri ne zaman yargılayacaksın?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Yasana aykırı olarak","poem":1},{"text":"küstahlar benim için çukur kazdılar.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Buyruklarının tümü sadakattir.","poem":1},{"text":"Bana haksız yere zulmediyorlar.","poem":2},{"lineBreak":true},{"text":"Yardım et bana!","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Neredeyse beni yeryüzünden sileceklerdi,","poem":1},{"text":"ama ben senin ilkelerini bırakmadım.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Sevgi dolu iyiliğin uyarınca koru canımı,","poem":1},{"text":"böylece ağzının kurallarını tutayım.","poem":2},{"text":"ל LAMED","descriptive":true}]},{"type":"verse","number":89,"content":[{"text":"Ey Yahve, sözün","poem":1},{"text":"Göklerde sonsuza dek kalıcıdır.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Sadakatin tüm kuşakları kapsar.","poem":1},{"text":"Yeryüzünü kurdun ve o duruyor.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Yasaların bugüne dek duruyor,","poem":1},{"text":"çünkü her şey sana hizmet eder.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Eğer yasan benim zevkim olmasaydı,","poem":1},{"text":"acım yüzünden yok olurdum.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"İlkelerini asla unutmayacağım,","poem":1},{"text":"çünkü onlarla beni dirilttin.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Ben seninim.","poem":1},{"text":"Kurtar beni, çünkü senin ilkelerini aradım.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Kötüler beni yok etmek için beklediler.","poem":1},{"text":"Ben senin kurallarını dikkate alıyorum.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Her kusursuzluğun bir sınırını gördüm,","poem":1},{"text":"ama senin buyrukların sınırsızdır.","poem":2},{"text":"מ MEM","descriptive":true}]},{"type":"verse","number":97,"content":[{"text":"Yasanı ne kadar severim!","poem":1},{"text":"Bütün gün düşüncem odur.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Buyrukların beni düşmanlarımdan daha bilge kılar,","poem":1},{"text":"çünkü buyrukların her zaman benimledir.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Bütün öğretmenlerimden daha anlayışlıyım,","poem":1},{"text":"çünkü tanıklıkların benim düşüncemdir.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Yaşlılardan daha iyi anlarım,","poem":1},{"text":"çünkü senin ilkelerine uydum.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Ayaklarımı her kötü yoldan uzak tuttum,","poem":1},{"text":"senin sözüne uymak için.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Senin hükümlerinden ayrılmadım,","poem":1},{"text":"çünkü bana sen öğrettin.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Vaatlerin damağıma ne tatlıdır,","poem":1},{"text":"ağzım için baldan tatlıdır!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"İlkelerin sayesinde anlayış kazanıyorum,","poem":1},{"text":"bunun için her yanlış yoldan nefret ediyorum.","poem":2},{"text":"נ NUN","descriptive":true}]},{"type":"verse","number":105,"content":[{"text":"Sözün ayaklarım için bir fener,","poem":1},{"text":"yolum için bir ışıktır.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Senin doğru hükümlerini yerine getireyim diye","poem":1},{"text":"ant içtim, andımı pekiştirdim.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Çok acı çekiyorum.","poem":1},{"text":"Sözün uyarınca beni dirilt, ey Yahve.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Yalvarırım sana, ağzımın gönüllü sunularını kabul et.","poem":1},{"text":"Ey Yahve, bana hükümlerini öğret.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Canım sürekli elimdedir,","poem":1},{"text":"yine de yasanı unutmam.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Kötüler bana tuzak kurdu,","poem":1},{"text":"yine de senin ilkelerinden sapmadım.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Senin tanıklıklarını sonsuza dek miras olarak aldım,","poem":1},{"text":"çünkü onlar yüreğimin sevincidir.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Kurallarını uygulamaya yüreğimi koydum,","poem":1},{"text":"ta sonuna, sonsuza dek.","poem":2},{"text":"ם SAMEH","descriptive":true}]},{"type":"verse","number":113,"content":[{"text":"Çift fikirli insanlardan nefret ederim","poem":1},{"text":"ama senin yasanı severim.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Saklanacak yerim ve kalkanım sensin.","poem":1},{"text":"Senin sözüne umut bağlarım.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Uzak durun benden,","poem":1},{"text":"ey siz kötülük edenler.","poem":2},{"lineBreak":true},{"text":"Ta ki, Tanrım’ın buyruklarını tutabileyim.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Sözün uyarınca bana destek ol ki, yaşayayım.","poem":1},{"text":"Umudumdan utanmayayım.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Beni tutup kaldır, güvende olurum,","poem":1},{"text":"senin kurallarına daima saygı duyarım.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Kurallarından sapan herkesi reddedersin,","poem":1},{"text":"çünkü onların hilesi boşunadır.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Yeryüzünün bütün kötülerini","poem":1},{"text":"süprüntü gibi bir kenara attın.","poem":2},{"lineBreak":true},{"text":"Bunun için tanıklıklarını severim.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Senin korkundan bedenim titrer.","poem":1},{"text":"Yargılarından korkarım.","poem":2},{"text":"ע AYİN","descriptive":true}]},{"type":"verse","number":121,"content":[{"text":"Adil ve doğru olanı yaptım.","poem":1},{"text":"Beni zalimlerin eline bırakma.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Hizmetkârının mutluluğunu güven altına al.","poem":1},{"text":"Küstahların beni ezmesine izin verme.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Gözlerim senin kurtarışını ve doğru sözünü,","poem":1},{"text":"aramayı bırakıyor.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Hizmetkârına sevgi dolu iyiliğine göre davran.","poem":1},{"text":"Bana kurallarını öğret.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Ben senin hizmetkârınım. Bana anlayış ver de","poem":1},{"text":"senin tanıklıklarını bileyim.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Harekete geçme zamanıdır, ey Yahve,","poem":1},{"text":"çünkü yasanı çiğniyorlar.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Bunun için senin buyruklarını,","poem":1},{"text":"altından, saf altından daha çok severim.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"Bu nedenle tüm ilkelerini doğru sayarım.","poem":1},{"text":"Her yanlış yoldan nefret ediyorum.","poem":2},{"text":"פ PE","descriptive":true}]},{"type":"verse","number":129,"content":[{"text":"Tanıklıkların harikadır,","poem":1},{"text":"bunun için canım onlara uyuyor.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Sözlerinin açılışı ışık verir,","poem":1},{"text":"saf insana anlayış.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Ağzımı genişçe açtım ve hasret kaldım.","poem":1},{"text":"Çünkü buyruklarını özlüyorum.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Bana yönel ve bana merhamet et,","poem":1},{"text":"adını sevenlere her zaman yaptığın gibi.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Adımlarımı sözünde pekiştir.","poem":1},{"text":"Hiçbir kötülük bana hakim olmasın.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Beni insanların baskısından kurtar da","poem":1},{"text":"ilkelerine uyayım.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Yüzünü hizmetkârının üzerinde parlat.","poem":1},{"text":"Bana kurallarını öğret.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Gözlerimden oluk oluk yaşlar akıyor,","poem":1},{"text":"çünkü yasana uymuyorlar.","poem":2},{"text":"צ TSADE","descriptive":true}]},{"type":"verse","number":137,"content":[{"text":"Sen doğrusun, ey Yahve.","poem":1},{"text":"Yargıların dosdoğrudur.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Kurallarını doğrulukla buyurdun.","poem":1},{"text":"Onlar tamamen güvenilirdir.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Gayretim beni tüketti,","poem":1},{"text":"çünkü düşmanlarım","poem":2},{"lineBreak":true},{"text":"senin sözlerini görmezden geliyor.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Vaatlerin tümüyle sınandı,","poem":1},{"text":"hizmetkârın onları sever.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Ben küçük ve hor görülen biriyim.","poem":1},{"text":"Senin ilkelerini unutmuyorum.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Senin doğruluğun sonsuz bir doğruluktur.","poem":1},{"text":"Yasan gerçektir.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Sıkıntı ve ıstırap beni ele geçirdi.","poem":1},{"text":"Buyrukların benim zevkimdir.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Tanıklıkların daima doğrudur.","poem":1},{"text":"Bana anlayış ver ki, yaşayayım.","poem":2},{"text":"ק KOF","descriptive":true}]},{"type":"verse","number":145,"content":[{"text":"Tüm yüreğimle çağırdım.","poem":1},{"text":"Yanıt ver bana, ey Yahve!","poem":2},{"lineBreak":true},{"text":"Senin kurallarını tutacağım.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Seni çağırdım. Kurtar beni!","poem":1},{"text":"Senin kurallarına uyacağım.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Şafaktan önce kalkıyorum","poem":1},{"text":"ve yardım için yakarıyorum.","poem":2},{"lineBreak":true},{"text":"Umudumu senin sözlerine bağladım.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Gece nöbetleri boyunca gözlerim açık kalıyor,","poem":1},{"text":"senin sözünü düşüneyim diye.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Sevgi dolu iyiliğine göre sesimi duy.","poem":1},{"text":"Hükümlerin uyarınca beni dirilt, ey Yahve.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Kötülüğün ardına düşenler yaklaşıyor.","poem":1},{"text":"Onlar senin yasandan uzaklar.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Sen yakınsın, ey Yahve.","poem":1},{"text":"Buyruklarının tümü gerçektir.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Eskiden beri tanıklıklarından bilirim ki,","poem":1},{"text":"sen onları sonsuza dek kurdun.","poem":2},{"text":"ר REŞ","descriptive":true}]},{"type":"verse","number":153,"content":[{"text":"Çektiğim sıkıntıyı gör ve kurtar beni,","poem":1},{"text":"çünkü senin yasanı unutmuyorum.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Davamı savun ve kurtar beni!","poem":1},{"text":"Sözün uyarınca beni dirilt.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Kurtuluş kötülerden uzaktır,","poem":1},{"text":"çünkü senin hükümlerini aramıyorlar.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Senin sevecen merhametlerin ne büyüktür, ey Yahve.","poem":1},{"text":"Beni hükümlerine göre dirilt.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Bana zulmedenler ve düşmanlarım çoktur.","poem":1},{"text":"Ben senin tanıklıklarından sapmadım.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Hainlere nefretle bakarım,","poem":1},{"text":"çünkü onlar senin sözünü tutmuyorlar.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"İlkelerini ne kadar sevdiğimi gör.","poem":1},{"text":"Sevgi dolu iyiliğine göre beni dirilt, ey Yahve.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Bütün sözlerin doğrudur.","poem":1},{"text":"Her doğru hükmün sonsuza dek durur.","poem":2},{"text":"ש SİN ve ŞİN","descriptive":true}]},{"type":"verse","number":161,"content":[{"text":"Beyler yok yere bana zulmettiler,","poem":1},{"text":"ama yüreğim sözlerine hayran kalır.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Büyük ganimet bulan biri gibi,","poem":1},{"text":"ben senin sözünde sevinirim.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Yalandan nefret ederim ve tiksinirim.","poem":1},{"text":"Yasanı severim.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Doğru hükümlerin için,","poem":1},{"text":"günde yedi kez seni överim.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Yasanı sevenler büyük esenliğe sahip olurlar.","poem":1},{"text":"Hiçbir şey onları tökezletemez.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Kurtarışına umut bağladım, ey Yahve.","poem":1},{"text":"Buyruklarını yerine getirdim.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Canım senin tanıklıklarını tuttu.","poem":1},{"text":"Onları fazlasıyla severim.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"İlkelerine ve tanıklıklarına uydum,","poem":1},{"text":"çünkü bütün yollarım senin önündedir.","poem":2},{"text":"ת TAV","descriptive":true}]},{"type":"verse","number":169,"content":[{"text":"Feryadım önüne gelsin, ey Yahve.","poem":1},{"text":"Sözün uyarınca bana anlayış ver.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Yalvarışım senin önüne gelsin.","poem":1},{"text":"Sözün uyarınca kurtar beni.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Dudaklarım övsün,","poem":1},{"text":"çünkü bana kurallarını öğretiyorsun.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Dilim senin sözünü ezgiye çevirsin,","poem":1},{"text":"çünkü bütün buyrukların doğruluktur.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Elin bana yardım etmeye hazır olsun,","poem":1},{"text":"çünkü ben senin ilkelerini seçtim.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Senin kurtarışını özledim, ey Yahve.","poem":1},{"text":"Yasan benim zevkimdir.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Canımı yaşat ki, seni öveyim.","poem":1},{"text":"Senin hükümlerin bana yardım etsin.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Kaybolmuş bir koyun gibi yoldan saptım.","poem":1},{"text":"Hizmetkârını ara,","poem":2},{"lineBreak":true},{"text":"çünkü ben senin buyruklarını unutmam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}