{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Sekiz telli sazlarla"]},{"type":"verse","number":1,"content":[{"text":"Yardım et, ey Yahve, çünkü tanrısal kişi kalmadı.","poem":1},{"text":"İnsanoğulları arasında sadık olanlar tükeniyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Herkes komşusuna yalan söylüyor.","poem":1},{"text":"Yaltaklanan dudaklarla, çift yürekle konuşuyorlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve tüm yaltaklanan dudakları,","poem":1},{"text":"ve övünen dilleri kessin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onlar, “Dilimizle galip geleceğiz.","poem":1},{"text":"Dudaklarımız bizimdir.","poem":2},{"lineBreak":true},{"text":"Kim bizim üzerimizde efendidir?” derler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Mazlumların ezilmesinden ve yoksulların iniltilerinden ötürü,","poem":1},{"text":"şimdi kalkacağım” diyor Yahve,","poem":2},{"text":"“Ona kötülük edenlerden kurtarıp güvenli bir yere koyacağım.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yahve’nin sözleri kusursuzdur,","poem":1},{"text":"toprak ocakta eritilmiş,","poem":2},{"lineBreak":true},{"text":"yedi kez arıtılmış gümüşe benzer.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sen onları koruyacaksın, ey Yahve.","poem":1},{"text":"Onları bu kuşaktan daima koruyacaksın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Alçaklık insanoğulları arasında yüceltildiğinde,","poem":1},{"text":"kötüler her yanda dolaşır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}