{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Sıkıntı içinde Yahve’yi çağırdım.","poem":1},{"text":"Bana yanıt verdi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ey Yahve, canımı yalancı dudaklardan,","poem":1},{"text":"aldatıcı dilden kurtar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey aldatıcı dil,","poem":1},{"text":"sana ne verilecek,","poem":2},{"lineBreak":true},{"text":"senin için daha çok ne yapılacak?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Güçlünün sivri oklarıyla,","poem":1},{"text":"ardıç kömürü.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vay halime, Meşek'te yaşadığım,","poem":1},{"text":"Kedar'ın çadırları arasında oturduğum için!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Canım uzun zamandır","poem":1},{"text":"esenlikten nefret edenle mesken tutuyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ben esenlikten yanayım,","poem":1},{"text":"ama ben konuşunca, onlar savaştan yana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}