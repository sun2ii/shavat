}]},{"type":"verse","number":8,"content":[{"text":"Şimdiden sonsuza dek,","poem":1},{"text":"Yahve senin gidişini gelişini koruyacak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}