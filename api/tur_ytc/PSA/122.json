{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["David’in hagga ilahisi"]},{"type":"verse","number":1,"content":[{"text":"Bana, “Hadi Yahve'nin evine gidelim!”","poem":1},{"text":"dediklerinde sevindim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayaklarımız senin kapılarında duruyor,","poem":1},{"text":"ey Yeruşalem,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"bitişik kurulmuş bir kenttir Yeruşalem,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"oymaklar, Yah’ın oymakları,","poem":1},{"text":"İsrael için olan kural uyarınca,","poem":2},{"lineBreak":true},{"text":"Yahve’nin adına şükretmek için oraya çıkarlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü yargı için kurulmuş tahtlar,","poem":1},{"text":"David'in evinin tahtları vardır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeruşalem'in esenliği için dua edin.","poem":1},{"text":"Seni sevenler bolluğa kavuşur.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Surlarının içinde esenlik,","poem":1},{"text":"saraylarında bolluk olsun.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kardeşlerim ve dostlarım için,","poem":1},{"text":"şimdi “Sende esenlik olsun” derim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanrımız Yahve’nin evi için,","poem":1},{"text":"senin iyiliğini ararım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}