ir kuş gibi kurtuldu.","poem":2},{"lineBreak":true},{"text":"Tuzak kırıldı, biz kurtulduk.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeri göğü yaratan","poem":1},{"text":"Yahve’nin adı yardımcımızdır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}