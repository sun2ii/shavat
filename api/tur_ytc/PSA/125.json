racak.","poem":2},{"lineBreak":true},{"text":"Esenlik İsrael’in üzerinde olsun.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}