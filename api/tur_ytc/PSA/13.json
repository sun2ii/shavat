{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ne zamana dek, ey Yahve?","poem":1},{"text":"Beni sonsuza dek mi unutacaksın?","poem":2},{"lineBreak":true},{"text":"Yüzünü benden daha ne kadar gizleyeceksin?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Her gün yüreğimde keder var,","poem":1},{"text":"ne zamana dek canımı teselli edeceğim?","poem":2},{"lineBreak":true},{"text":"Ne zamana dek düşmanım bana karşı zafer kazanacak?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bak ve yanıt ver bana, ey Tanrım Yahve.","poem":1},{"text":"Gözlerime ışık ver ki, ölüm uykusuna yatmayayım,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"öyle ki, düşmanım, “Onu yendim” demesin,","poem":1},{"text":"Düştüğümde düşmanlarım sevinmesin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama ben senin sevgi dolu iyiliğine güveniyorum.","poem":1},{"text":"Yüreğim senin kurtuluşunla seviniyor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve’ye ezgiler söyleyeceğim,","poem":1},{"text":"çünkü bana iyilik etti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}