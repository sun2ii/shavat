{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Hagga ilahisi"]},{"type":"verse","number":1,"content":[{"text":"Derinliklerden seni çağırdım, ey Yahve.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ey Efendim, sesimi duy.","poem":1},{"text":"Dikkatli olsun kulakların","poem":2},{"lineBreak":true},{"text":"dileklerimin sesine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey Yah, sen eğer günahların kaydını tutarsan,","poem":1},{"text":"kim ayakta durabilir, ey Efendim?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ama sende bağışlanma var,","poem":1},{"text":"bunun için senden korkulsun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve'yi bekliyorum.","poem":1},{"text":"Canım bekliyor.","poem":2},{"lineBreak":true},{"text":"O’nun sözüne umut bağlıyorum.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bekçilerin sabahı özlemesinden daha çok,","poem":1},{"text":"sabah bekçilerinden daha çok,","poem":2},{"lineBreak":true},{"text":"canım Efendi’yi özlüyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey İsrael, Yahve’ye umut bağla,","poem":1},{"text":"çünkü Yahve’nin sevgi dolu iyiliği vardır.","poem":2},{"lineBreak":true},{"text":"O’nda bol kurtuluş vardır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İsrael'i bütün günahlarından O kurtaracaktır.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}