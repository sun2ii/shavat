{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Hagga ilahisi"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, David’i ve bütün sıkıntılarını hatırla,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yahve’ye nasıl ant içtiğini,","poem":1},{"text":"Yakov'un Güçlüsü’ne olan adağını:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Gerçekten evimin içine girmeyeceğim,","poem":1},{"text":"yatağıma çıkmayacağım,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gözlerime uyku,","poem":1},{"text":"göz kapaklarıma uyuklama vermeyeceğim;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve’ye bir yer,","poem":1},{"text":"Yakov'un Güçlüsü'ne bir mesken bulana dek.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"İşte onun Efrata'da olduğunu duyduk.","poem":1},{"text":"Onu Yaar kırında bulduk:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“O’nun meskenine gidelim.","poem":1},{"text":"O’nun ayağının taburesinde tapınalım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sen ve gücünün sandığı, ey Yahve,","poem":1},{"text":"kendi dinlenme yerine çık,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kâhinleriniz doğrulukla giyinsin.","poem":1},{"text":"Kutsallarınız sevinçle haykırsın!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hizmetkârın David'in hatırı için,","poem":1},{"text":"meshetmiş olduğuna yüz çevirme.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve David'e gerçekle ant içti.","poem":1},{"text":"Ondan geri dönmez:","poem":2},{"lineBreak":true},{"text":"“Senin bedeninin ürününü tahtına oturtacağım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eğer çocukların antlaşmamı,","poem":1},{"text":"onlara öğreteceğim tanıklığımı tutarsa,","poem":2},{"lineBreak":true},{"text":"onların çocukları da daima","poem":2},{"lineBreak":true},{"text":"senin tahtında oturacaklar.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü Yahve Siyon'u seçti.","poem":1},{"text":"Kendine mesken olarak onu arzu etti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Burası benim sonsuza dek dinlenme yerimdir.","poem":1},{"text":"Burada yaşayacağım çünkü bunu ben arzuladım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onun erzağını bol bol bereketleyeceğim.","poem":1},{"text":"Yoksulunu ekmekle doyuracağım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kâhinlerine de kurtuluş giydireceğim.","poem":1},{"text":"Kutsalları sevinç içinde yüksek sesle haykıracaklar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Orada David'in boynuzunu yeşerteceğim.","poem":1},{"text":"Meshedilmişim için bir kandil atadım.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Düşmanlarını utançla örteceğim","poem":1},{"text":"ama kendi üzerindeki tacı parlayacak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}