{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Yah’ı övün!","poem":1},{"text":"Yahve’nin adını övün!","poem":2},{"lineBreak":true},{"text":"Ey Yahve'nin hizmetkârları, O'nu övün,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ey sizler Yahve’nin evinde,","poem":1},{"text":"Tanrımız’ın evinin avlularında duranlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve’yi övün, çünkü Yahve iyidir.","poem":1},{"text":"Adını ezgilerle övün, çünkü bu hoştur.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Yahve kendisi için Yakov'u,","poem":1},{"text":"kendi mülkü olarak İsrael’i seçti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü bilirim ki Yahve büyüktür,","poem":1},{"text":"Efendimiz bütün ilâhlardan üstündür.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve ne dilediyse onu yaptı,","poem":1},{"text":"gökte, yeryüzünde, denizlerde ve tüm derinliklerde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeryüzünün uçlarından bulutları yükseltir.","poem":1},{"text":"Yağmurla birlikte şimşekler yapar.","poem":2},{"lineBreak":true},{"text":"Rüzgârı hazinelerinden çıkarır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hem insanı hem hayvanı,","poem":1},{"text":"Mısır’ın ilk doğanlarını vurdu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"senin orta yerinde, ey Mısır,","poem":1},{"text":"Firavun'nun ve onun bütün hizmetkârlarının üzerine,","poem":2},{"lineBreak":true},{"text":"belirtiler ve harikalar gönderdi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Birçok ulusu vurdu,","poem":1},{"text":"güçlü kralları öldürdü,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amorlular'ın kralı Sihon’u,","poem":1},{"text":"Başan Kralı Og’u,","poem":2},{"lineBreak":true},{"text":"Kenan'ın bütün krallıklarını.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onların topraklarını mülk olarak,","poem":1},{"text":"kendi halkı İsrael'e miras olarak verdi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Adın, ey Yahve, sonsuza dek durur,","poem":1},{"text":"ünün, ey Yahve, tüm kuşaklar boyuncadır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü Yahve halkını yargılar,","poem":1},{"text":"hizmetkârlarına merhamet gösterir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ulusların putları gümüş ve altındır,","poem":1},{"text":"insan ellerinin işi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ağızları var ama konuşmazlar.","poem":1},{"text":"Gözleri var ama görmezler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kulakları var ama duymazlar.","poem":1},{"text":"Ağızlarında hiç soluk bulunmaz.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onları yapanlar ve onlara güvenen herkes,","poem":1},{"text":"onlar gibi olacak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ey İsrael evi, Yahve’yi övün!","poem":1},{"text":"Ey Aron evi, Yahve’yi övün!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ey Levi evi, Yahve’yi övün!","poem":1},{"text":"Ey Yahve'den korkanlar,","poem":2},{"lineBreak":true},{"text":"Yahve’yi övün!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yeruşalem’de oturan Yahve","poem":1},{"text":"Siyon'dan övülsün.","poem":2},{"text":"Yah’ı övün!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}