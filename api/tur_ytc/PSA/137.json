{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Babil ırmakları kıyısında,","poem":1},{"text":"orada oturduk.","poem":2},{"lineBreak":true},{"text":"Siyon'u hatırladığımızda, evet ağladık.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O diyardaki söğütlere,","poem":1},{"text":"arplarımızı astık.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü orada bizi tutsak edenler","poem":1},{"text":"bizden ezgiler.","poem":2},{"lineBreak":true},{"text":"Bize eziyet edenler","poem":2},{"lineBreak":true},{"text":"sevinç ezgileri istediler:","poem":2},{"lineBreak":true},{"text":"“Bize Siyon ezgilerinden birini söyleyin!” dediler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve'nin ezgisini","poem":1},{"text":"yabancı bir diyarda nasıl söyleriz?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eğer seni unutursam, ey Yeruşalem,","poem":1},{"text":"sağ elim becerisini unutsun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eğer seni hatırlamazsam","poem":1},{"text":"eğer Yeruşalem’i baş sevincimden üstün tutmazsam,","poem":2},{"lineBreak":true},{"text":"dilim damağıma yapışsın,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeruşalem gününde,","poem":1},{"text":"“Yıkın! Onu temeline kadar yıkın!” diyen","poem":2},{"lineBreak":true},{"text":"Edom'un çocuklarına karşı,","poem":2},{"lineBreak":true},{"text":"hatırla, ey Yahve.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey sen, yıkıma mahkûmsun ey Babil kızı,","poem":1},{"text":"bize yaptığının karşılığını,","poem":2},{"lineBreak":true},{"text":"sana ödetecek olana ne mutlu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Senin yavrularını alıp","poem":1},{"text":"kayaya çarpacak olana ne mutlu!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}