{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve, sen beni yokladın ve tanıdın.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oturuşumu ve kalkışımı bilirsin.","poem":1},{"text":"Düşüncelerimi uzaktan sezersin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yolumu ve yatışımı araştırırsın,","poem":1},{"text":"bütün yollarımı bilirsin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü dilimde tek söz yokken,","poem":1},{"text":"işte, ey Yahve, sen bunun hepsini bilirsin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Beni arkadan ve önden kuşattın.","poem":1},{"text":"Elini üzerime koydun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu bilgi beni aşıyor, yüce, ona erişemem.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Senin Ruhun’dan nereye gidebilirim?","poem":1},{"text":"Ya da senin varlığından nereye kaçabilirim?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Göğe çıksam oradasın.","poem":1},{"text":"Yatağımı Şeol'e","poem":2},{"noteId":44},{"text":"sersem, işte oradasın!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Şafağın kanatlarını alsam,","poem":1},{"text":"denizin en uzak uçlarına konsam,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"orada bile elin bana yol gösterir,","poem":1},{"text":"sağ elin beni tutar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Desem ki, “Karanlık beni mutlaka örter,","poem":1},{"text":"çevremdeki ışık gece olsun.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Karanlık bile senden gizlenemez,","poem":1},{"text":"gece gündüz gibi parlar.","poem":2},{"lineBreak":true},{"text":"Karanlık senin için ışık gibidir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü benim iç varlığımı sen biçimlendirdin.","poem":1},{"text":"Annemin rahminde beni sen ördün.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sana şükürler sunarım,","poem":1},{"text":"çünkü saygın ve harika yapılmışım.","poem":2},{"lineBreak":true},{"text":"Senin işlerin harikadır.","poem":2},{"lineBreak":true},{"text":"Canım bunu çok iyi bilir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gizlide yapıldığımda,","poem":1},{"text":"yeryüzünün derinliklerinde örüldüğümde,","poem":2},{"lineBreak":true},{"text":"bedenim senden gizli değildi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gözlerin bedenimi gördü.","poem":1},{"text":"Benim için tayin edilen günlerin,","poem":2},{"lineBreak":true},{"text":"henüz hiçbiri yokken,","poem":2},{"lineBreak":true},{"text":"hepsi senin kitabında yazılmıştı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Düşüncelerin benim için ne değerlidir, ey Tanrı!","poem":1},{"text":"Onların hesabı uçsuz bucaksızdır!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onları saysam, sayıları kumdan çoktur.","poem":1},{"text":"Uyandığımda yine seninleyim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Keşke sen, ey Tanrı, kötüleri öldürsen.","poem":1},{"text":"Uzak durun benden, siz kana susamış insanlar!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çünkü onlar sana karşı kötü konuşuyorlar.","poem":1},{"text":"Düşmanların adını boş yere anıyorlar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ey Yahve, senden nefret edenlerden nefret etmez miyim?","poem":1},{"text":"Sana karşı ayaklananlara kederlenmez miyim?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Onlardan katıksızca nefret ederim.","poem":1},{"text":"Onlar benim düşmanım oldular.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Beni yokla, ey Tanrı, yüreğimi bil.","poem":1},{"text":"Beni dene ve düşüncelerimi öğren.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bak, içimde kötü bir yol var mı,","poem":1},{"text":"sonsuzluk yolunda bana öncülük et.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":139,"verse":8}}]},"thisChapterLink":"/api/tur_ytc/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}