{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, kurtar beni kötü insanlardan.","poem":1},{"text":"Koru beni zalimden.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Onlar, yüreklerinde kötülük tasarlar,","poem":1},{"text":"sürekli savaş için toplanırlar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dillerini yılan gibi keskinleştirdiler.","poem":1},{"text":"Engerek zehri dudaklarının altındadır. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey Yahve, koru beni kötülerin elinden.","poem":1},{"text":"Ayaklarıma çelme takmaya kararlı","poem":2},{"lineBreak":true},{"text":"zalim insanlardan koru beni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Küstahlar bana tuzak kurdular,","poem":1},{"text":"yol kenarına ağ gerdiler.","poem":2},{"lineBreak":true},{"text":"Benim için kapan yerleştirdiler. Selah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve’ye, “Sen benim Tanrım’sın” dedim.","poem":1},{"text":"Dileklerimin feryadını dinle, ey Yahve.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kurtuluşumun gücü, ey Efendi Yahve,","poem":1},{"text":"savaş gününde başımı örttün.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey Yahve, kötülerin dileklerini verme.","poem":1},{"text":"Kötü planları başarıya ulaşmasın,","poem":2},{"lineBreak":true},{"text":"yoksa gurura kapılırlar. Selah.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Beni kuşatanların başına gelince,","poem":1},{"text":"kendi dudaklarının kötülüğü onları kaplasın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Üzerlerine kızgın korlar yağsın.","poem":1},{"text":"Ateşe atılsınlar,","poem":2},{"lineBreak":true},{"text":"asla çıkamayacakları","poem":2},{"lineBreak":true},{"text":"çamurlu çukurlara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kötülük konuşan yeryüzünde tutunamasın.","poem":1},{"text":"Kötülük, zalimi yıkmak için onu avlasın.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bilirim ki, Yahve dertlinin davasına bakar,","poem":1},{"text":"muhtacı haklı çıkarır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gerçekten doğrular senin adına şükredecekler.","poem":1},{"text":"Doğrular senin huzurunda oturur.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}