onu reddetmesin,","poem":2},{"lineBreak":true},{"text":"ama benim duam hep kötü işlere karşıdır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onların yargıçları kayanın yanına atıldı.","poem":1},{"text":"Sözlerimi duyacaklar,","poem":2},{"lineBreak":true},{"text":"çünkü yerinde söylenmiştir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Nasıl biri toprağı sürüp yararsa,","poem":1},{"text":"kemiklerimiz de Şeol'ün","poem":2},{"noteId":45},{"text":"ağzında","poem":2},{"lineBreak":true},{"text":"öyle dağılmış durumda.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü gözlerim senin üzerinde,","poem":1},{"text":"ey Efendimiz Yahve.","poem":2},{"lineBreak":true},{"text":"Sana sığınıyorum.","poem":2},{"lineBreak":true},{"text":"Canımı yoksul bırakma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bana kurdukları tuzaktan,","poem":1},{"text":"kötülük işçilerinin kapanlarından koru beni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ben geçip giderken,","poem":1},{"text":"kötüler hep birlikte kendi ağlarına düşsünler.","poem":2}]}],"footnotes":[{"noteId":45,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":141,"verse":7}}]},"thisChapterLink":"/api/tur_ytc/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}