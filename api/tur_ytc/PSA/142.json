{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["David’in Maskili - Mağaradayken ettiği dua"]},{"type":"verse","number":1,"content":[{"text":"Sesimle Yahve'ye yakarıyorum.","poem":1},{"text":"Sesimle Yahve'den merhamet diliyorum.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yakınmamı O’nun önünde döküyorum.","poem":1},{"text":"O’na dertlerimi anlatıyorum.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ruhum içimde bunaldığında,","poem":1},{"text":"sen yolumu bilirsin.","poem":2},{"lineBreak":true},{"text":"Yürüdüğüm yolda,","poem":2},{"lineBreak":true},{"text":"bana tuzak kurdular.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sağıma bak da gör,","poem":1},{"text":"çünkü beni düşünen kimse yok.","poem":2},{"lineBreak":true},{"text":"Sığınacak yer benden kaçtı.","poem":2},{"lineBreak":true},{"text":"Kimse canımı umursamıyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sana feryat ettim, ey Yahve.","poem":1},{"text":"“Sen benim sığınağımsın” dedim.","poem":2},{"lineBreak":true},{"text":"“Yaşayanlar diyarından benim payımsın.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Feryadımı dinle,","poem":1},{"text":"çünkü çok çaresizim.","poem":2},{"lineBreak":true},{"text":"Kurtar beni bana zulmedenlerden,","poem":2},{"lineBreak":true},{"text":"çünkü onlar benden güçlüdür.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Canımı zindandan çıkar da,","poem":1},{"text":"adına şükredeyim.","poem":2},{"lineBreak":true},{"text":"Doğrular çevremi saracak,","poem":2},{"lineBreak":true},{"text":"çünkü bana iyilik edeceksin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}