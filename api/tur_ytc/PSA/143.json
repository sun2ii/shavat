{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Duamı duy, ey Yahve.","poem":1},{"text":"Dileklerimi dinle.","poem":2},{"lineBreak":true},{"text":"Sadakatin ve doğruluğunla beni rahatlat.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hizmetkârınla yargıya girme,","poem":1},{"text":"çünkü senin önünde","poem":2},{"lineBreak":true},{"text":"yaşayanlardan hiçbiri doğru değildir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü düşman canımın peşinde.","poem":1},{"text":"Hayatımı yerle bir etti.","poem":2},{"lineBreak":true},{"text":"Çoktan ölmüş olanlar gibi","poem":2},{"lineBreak":true},{"text":"beni karanlık yerlerde yaşattı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bunun için ruhum içimde bunalmış durumda.","poem":1},{"text":"İçimde yüreğim kimsesiz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eski günleri hatırlıyorum.","poem":1},{"text":"Yaptıklarının tümü üzerinde derin derin düşünüyorum.","poem":2},{"lineBreak":true},{"text":"Ellerinin işi üzerinde düşünceye dalıyorum.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ellerimi sana açıyorum.","poem":1},{"text":"Kurak toprak gibi canım sana susamış. Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bana tez yanıt ver, ey Yahve.","poem":1},{"text":"Ruhum tükeniyor.","poem":2},{"lineBreak":true},{"text":"Yüzünü benden gizleme,","poem":2},{"lineBreak":true},{"text":"yoksa çukura inenler gibi olurum.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sabahleyin sevgi dolu iyiliğini duyur,","poem":1},{"text":"çünkü sana güveniyorum.","poem":2},{"lineBreak":true},{"text":"Yürümem gereken yolu bana bildir,","poem":2},{"lineBreak":true},{"text":"çünkü canımı sana kaldırıyorum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey Yahve, kurtar beni düşmanlarımdan.","poem":1},{"text":"Beni saklaman için sana kaçıyorum.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"İsteğini yapmayı bana öğret,","poem":1},{"text":"çünkü sen benim Tanrım’sın.","poem":2},{"lineBreak":true},{"text":"Senin Ruh’un iyidir.","poem":2},{"lineBreak":true},{"text":"Doğruluk diyarında bana öncülük et.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey Yahve, adın uğruna beni dirilt.","poem":1},{"text":"Doğruluğunla canımı sıkıntıdan kurtar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sevgi dolu iyiliğinle düşmanlarımı yok et,","poem":1},{"text":"canıma eziyet eden herkesi yok et,","poem":2},{"lineBreak":true},{"text":"çünkü ben senin hizmetkârınım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}