{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ellerime savaşmayı,","poem":1},{"text":"parmaklarıma mücadeleyi öğreten","poem":2},{"lineBreak":true},{"text":"kayam Yahve’ye övgüler olsun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O’dur sevgi dolu iyiliğim, kalem,","poem":1},{"text":"yüksek kulem, kurtarıcım,","poem":2},{"lineBreak":true},{"text":"kalkanım ve kendisine sığındığım;","poem":2},{"lineBreak":true},{"text":"halkımı bana boyun eğdiren.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey Yahve, insan nedir ki, ona değer veresin?","poem":1},{"text":"Ya da insanoğlu nedir ki, onu düşünesin?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İnsan soluğa benzer.","poem":1},{"text":"Günleri, geçip giden gölge gibidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Yahve, gökleri yar ve aşağı in.","poem":1},{"text":"Dağlara dokun da tütsünler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Şimşek çaktır, onları dağıt.","poem":1},{"text":"Oklarını gönder de onları bozguna uğrat.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yukarıdan elini uzat,","poem":1},{"text":"kurtar beni.","poem":2},{"lineBreak":true},{"text":"beni büyük sulardan,","poem":2},{"lineBreak":true},{"text":"yabancıların elinden özgür kıl.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ağızları hile söyler,","poem":1},{"text":"onların sağ eli yalanın sağ elidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sana yeni bir ezgi söyleyeyim, ey Tanrı.","poem":1},{"text":"On telli lirle sana ezgiler söyleyeyim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Krallara kurtuluş veren,","poem":1},{"text":"hizmetkârı David'i","poem":2},{"lineBreak":true},{"text":"ölümcül kılıçtan kurtaran sensin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Beni kurtar, yabancıların elinden özgür kıl,","poem":1},{"text":"onların ağızları yalan söyler,","poem":2},{"lineBreak":true},{"text":"onların sağ eli yalanın sağ elidir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O zaman oğullarımız iyi yetişmiş fidanlar gibi,","poem":1},{"text":"kızlarımız sarayın oymalı sütunları gibi olacak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ambarlarımız her türlü erzakla dolu.","poem":1},{"text":"otlaklarımızda koyunlarımız binlerce,","poem":2},{"lineBreak":true},{"text":"on binlerce yavru verecek.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Öküzlerimiz bol yük çekecek.","poem":1},{"text":"Saldırı ve sürgün,","poem":2},{"lineBreak":true},{"text":"sokaklarımızda çığlık olmayacak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne mutlu bu durumda olan halka.","poem":1},{"text":"Ne mutlu Tanrısı Yahve olan halka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}