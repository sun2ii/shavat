{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["David’in övgü mezmuru",{"noteId":46}]},{"type":"verse","number":1,"content":[{"text":"Seni yücelteceğim, ey Tanrım, ey Kral.","poem":1},{"text":"Adını daima öveceğim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Her gün seni öveceğim.","poem":1},{"text":"Adını daima yücelteceğim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve büyüktür, övgüye çok layıktır!","poem":1},{"text":"O’nun büyüklüğü keşfedilemez.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senin işlerini bir kuşak öbür kuşağa methedecek,","poem":1},{"text":"kudretli işlerini bildirecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Saygınlığının yüce heybeti,","poem":1},{"text":"şaşılası işlerinin üzerinde","poem":2},{"lineBreak":true},{"text":"derin derin düşüneceğim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"İnsanlar müthiş işlerinin gücünden söz edecekler.","poem":1},{"text":"Senin büyüklüğünü ilan edeceğim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senin büyük iyiliğinin anısını dile getirecekler,","poem":1},{"text":"doğruluğunu ezgiyle söyleyecekler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve lütufkârdır, merhametlidir,","poem":1},{"text":"yavaş öfkelenir, sevgi dolu iyiliği büyüktür.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve herkese iyidir.","poem":1},{"text":"O’nun sevecen merhametleri","poem":2},{"lineBreak":true},{"text":"bütün işlerinin üzerindedir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bütün işlerin sana şükreder, ey Yahve.","poem":1},{"text":"Kutsalların seni yüceltir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Krallığının görkeminden söz eder,","poem":1},{"text":"gücün hakkında konuşur,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"insanoğlu O’nun güçlü işlerini,","poem":1},{"text":"krallığının yüce heybetini bilsin diye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Senin krallığın sonsuz bir krallıktır.","poem":1},{"text":"Hakimiyetin tüm kuşaklar boyunca sürer.","poem":2},{"lineBreak":true},{"text":"Yahve bütün sözlerinde sadıktır,","poem":2},{"lineBreak":true},{"text":"tüm işlerinde sevgi doludur.","poem":2},{"noteId":47}]},{"type":"verse","number":14,"content":[{"text":"Yahve düşen herkese destek olur,","poem":1},{"text":"eğilenlerin hepsini doğrultur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hepsinin gözleri seni bekler.","poem":1},{"text":"Onlara yiyeceklerini mevsiminde verirsin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Elini açarsın,","poem":1},{"text":"her canlıyı dilediğince doyurursun.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yahve bütün yollarında doğrudur,","poem":1},{"text":"tüm işlerinde lütufkârdır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yahve kendisini çağıranların hepsine,","poem":1},{"text":"kendisini içtenlikle çağıran herkese yakındır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kendisinden korkanların dileklerini yerine getirir.","poem":1},{"text":"Onların feryadını işitir ve onları kurtarır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yahve kendisini seven herkesi korur,","poem":1},{"text":"ama kötülerin hepsini yok eder.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ağzım Yahve’yi över.","poem":1},{"text":"Bütün canlılar O’nun kutsal adını,","poem":2},{"lineBreak":true},{"text":"daima övsün.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"Bu, her dizesi (13. dizenin ikinci yarısı da dahil) İbranice alfabesinin ardışık bir harfiyle başlayan bir akrostiş mezmurdur.","reference":{"chapter":145,"verse":0}},{"noteId":47,"caller":"+","text":"Bazı yazmalarda bu son iki satır atlanmıştır.","reference":{"chapter":145,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}