{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Yah’ı övün!","poem":1},{"text":"Ey canım, Yahve’yi öv.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaşadıkça Yahve’yi öveceğim.","poem":1},{"text":"Var oldukça Tanrım’a ezgiler söyleyeceğim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Beylere,","poem":1},{"text":"kendisinde yardım olmayan","poem":2},{"lineBreak":true},{"text":"insanoğluna güvenmeyin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ruhu ayrılır, kendisi toprağa döner.","poem":1},{"text":"O gün fikirleri yok olur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne mutlu yardımcısı Yakov'un Tanrısı olana,","poem":1},{"text":"umudu Tanrısı Yahve olana:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O’dur göğü ve yeri,","poem":1},{"text":"Denizi ve içindeki her şeyi yaratan,","poem":2},{"lineBreak":true},{"text":"gerçeği sonsuza dek koruyan,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ezilenlere adalet sağlayan,","poem":1},{"text":"açlara yemek veren.","poem":2},{"lineBreak":true},{"text":"Yahve tutsakları özgür kılar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve körlerin gözlerini açar.","poem":1},{"text":"Yahve eğilmiş olanları doğrultur.","poem":2},{"lineBreak":true},{"text":"Yahve doğruları sever.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve yabancıları korur.","poem":1},{"text":"Yetime ve dul kadına destek olur,","poem":2},{"lineBreak":true},{"text":"kötülerin yolunuysa altüst eder.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve sonsuza dek,","poem":1},{"text":"ey Siyon, senin Tanrın tüm kuşaklar boyunca","poem":2},{"lineBreak":true},{"text":"hüküm sürecektir.","poem":2},{"lineBreak":true},{"text":"Yah’ı övün!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}