{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Yah’ı övün,","poem":1},{"text":"çünkü Tanrımız’a ilahiler söylemek iyidir;","poem":2},{"lineBreak":true},{"text":"çünkü O’nu övmek hoş ve yerindedir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve Yeruşalem'i bina ediyor.","poem":1},{"text":"İsrael'in sürgünlerini bir araya topluyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O, kırık yürekleri iyileştirir,","poem":1},{"text":"yaralarını sarar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yıldızların sayısını sayar.","poem":1},{"text":"Hepsini adlarıyla çağırır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Efendimiz büyüktür, güçte muazzamdır.","poem":1},{"text":"Anlayışı sonsuzdur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve alçakgönüllülere destek olur.","poem":1},{"text":"Kötüleri yere çalar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve’ye şükranla ilahi söyleyin.","poem":1},{"text":"Arpla, Tanrımız’a ezgiler söyleyin,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O’dur gökyüzünü bulutlarla kaplayan,","poem":1},{"text":"yeryüzü için yağmuru hazırlayan,","poem":2},{"lineBreak":true},{"text":"dağlarda ot bitiren.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O, hayvanlara yiyecek sağlar,","poem":1},{"text":"bağrışan kuzgun yavrularına.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Atın gücünden zevk almaz.","poem":1},{"text":"İnsanın bacaklarından memnun olmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve kendisinden korkanlardan,","poem":1},{"text":"sevgi dolu iyiliğine umut bağlayanlardan hoşlanır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Yeruşalem, Yahve’yi öv!","poem":1},{"text":"Ey Siyon, Tanrın’ı yücelt!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü kapılarınızın sürgülerini güçlendirdi.","poem":1},{"text":"İçindeki çocuklarını kutsadı.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sınırlarında esenlik sağlar.","poem":1},{"text":"Seni buğdayın en iyisiyle doyurur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Buyruğunu yeryüzüne gönderir.","poem":1},{"text":"Sözü çok hızlı gider.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yapağı gibi kar verir,","poem":1},{"text":"kırağıyı kül gibi saçar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doluyu çakıl taşları gibi yağdırır.","poem":1},{"text":"Kim O'nun soğuğuna dayanabilir?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sözünü gönderir ve onları eritir.","poem":1},{"text":"Rüzgârını estirir, sular akar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sözünü Yakov'a,","poem":1},{"text":"kurallarını ve hükümlerini İsrael'e gösterir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bunu hiçbir ulus için yapmadı.","poem":1},{"text":"Onlar O’nun hükümlerini bilmezler.","poem":2},{"lineBreak":true},{"text":"Yah’ı övün!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}