{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Yah’ı övün!","poem":1},{"text":"Yahve'yi göklerden övün!","poem":2},{"lineBreak":true},{"text":"O’nu yücelerde övün!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O'nu, övün, ey bütün melekleri!","poem":1},{"text":"O’nu övün, ey bütün ordusu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O'nu övün, ey güneş ve ay!","poem":1},{"text":"O’nu övün, ey bütün parlayan yıldızlar!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O'nu övün, ey göklerin gökleri,","poem":1},{"text":"göklerin üstündeki sular.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve’nin adını övsünler,","poem":1},{"text":"çünkü O buyurdu ve yaratıldılar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onları sonsuza dek yerleştirdi.","poem":1},{"text":"Bozulmayacak bir hüküm koydu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeryüzünden Yahve’yi övün,","poem":1},{"text":"ey büyük deniz yaratıkları ve tüm derinlikler,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"şimşek ve dolu, kar ve bulutlar,","poem":1},{"text":"O’nun sözünü yerine getiren kasırga,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"dağlar ve bütün tepeler;","poem":1},{"text":"meyve ağaçları ve bütün sedirler,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"yabanıl ve evcil bütün hayvanlar,","poem":1},{"text":"küçük yaratıklar ve uçan kuşlar,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yeryüzünün kralları ve bütün halklar,","poem":1},{"text":"beyler ve bütün dünya hakimleri,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"delikanlılar ve genç kızlar,","poem":1},{"text":"yaşlılar ve çocuklar,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve’nin adını övsünler,","poem":1},{"text":"çünkü yalnızca O’nun adı yücedir.","poem":2},{"lineBreak":true},{"text":"O’nun görkemi yeryüzünün ve göklerin üstündedir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Halkının boynuzunu yükseltti,","poem":1},{"text":"tüm kutsallarını,","poem":2},{"lineBreak":true},{"text":"kendisine yakın olan halkı,","poem":2},{"lineBreak":true},{"text":"İsrael’in çocuklarını methettirdi.","poem":2},{"lineBreak":true},{"text":"Yah’ı övün!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}