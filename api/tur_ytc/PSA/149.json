{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve’yi övün!","poem":1},{"text":"Yahve'ye yeni bir ezgi söyleyin,","poem":2},{"lineBreak":true},{"text":"kutsallar topluluğunda övgüsünü sunun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"İsrael kendisini yapanla sevinsin.","poem":1},{"text":"Siyon çocukları Kralları’yla coşsun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dans ederek O'nun adını övsünler!","poem":1},{"text":"Tef ve arp çalarak O'nu ilahilerle yüceltsinler!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Yahve halkından hoşlanır.","poem":1},{"text":"Alçakgönüllüleri kurtuluşla taçlandırır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kutsallar onur içinde sevinsinler.","poem":1},{"text":"Yataklarında sevinçle ezgi söylesinler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ağızlarında Tanrı'ya yüce övgüler,","poem":1},{"text":"ellerinde iki ağızlı kılıçla,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"uluslardan öç alsınlar,","poem":1},{"text":"halkları cezalandırsınlar,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"krallarını zincirlerle,","poem":1},{"text":"soylularını demir prangalarla bağlasınlar,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ta ki, yazılı hükmü","poem":1},{"text":"onlara karşı yerine getirsinler.","poem":2},{"lineBreak":true},{"text":"O'nun bütün kutsalları bu onuru taşır.","poem":2},{"text":"Yah’ı övün!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}