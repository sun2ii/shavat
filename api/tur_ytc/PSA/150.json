ytc/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}