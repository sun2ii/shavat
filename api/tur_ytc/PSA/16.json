{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["David'in şiiri"]},{"type":"verse","number":1,"content":[{"text":"Koru beni, ey Tanrı,","poem":1},{"text":"çünkü sana sığınıyorum.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Canım, Yahve’ye şöyle dedi:","poem":1},{"text":"“Efendim sensin.","poem":2},{"lineBreak":true},{"text":"Senden ayrı bana iyilik yoktur.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yeryüzündeki kutsallara gelince,","poem":1},{"text":"harikadır onlar, bütün zevkim onlardadır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Başka ilâha armağan sunanların kederi çoğalacak.","poem":1},{"text":"Onların kan sunularını ben sunmayacağım,","poem":2},{"lineBreak":true},{"text":"ne de adlarını ağzıma alacağım.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve payımı, kâsemi belirledi.","poem":1},{"text":"Benim hissemi güvende tutan sensin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sınırlar hoş yerlerde düştü bana.","poem":1},{"text":"Evet, iyi bir mirasım var.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bana öğüt veren Yahve’yi yücelteceğim.","poem":1},{"text":"Evet, geceleyin yüreğim beni uyarır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve’yi hep önüme koydum.","poem":1},{"text":"O benim sağımda olduğu için sarsılmam.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bu nedenle yüreğim coşku dolu, dilim sevinir.","poem":1},{"text":"Bedenim de güvenlik içinde yaşar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü sen canımı Şeol'e","poem":1},{"noteId":9},{"text":"terk etmeyeceksin,","poem":1},{"text":"kutsalının çürümesine izin vermeyeceksin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bana yaşam yolunu göstereceksin.","poem":1},{"text":"Senin huzurunda bol sevinç vardır.","poem":2},{"lineBreak":true},{"text":"Sağ elinde sonsuz zevkler vardır.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":16,"verse":10}}]},"thisChapterLink":"/api/tur_ytc/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}