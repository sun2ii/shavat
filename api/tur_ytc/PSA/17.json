{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["David’in bir duasıdır."]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, haklı yakarışımı işit.","poem":1},{"text":"Hileli dudaklardan çıkmayan duama kulak ver.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hükmüm senin huzurundan çıksın.","poem":1},{"text":"Senin gözlerin adalete baksın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yüreğimi denedin.","poem":1},{"text":"Geceleyin beni ziyaret ettin.","poem":2},{"lineBreak":true},{"text":"Beni yokladın ama hiçbir şey bulmadın.","poem":2},{"lineBreak":true},{"text":"Ağzımdan itaatsiz söz çıkarmamaya kararlıyım.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İnsanların yaptıklarına gelince,","poem":1},{"text":"senin dudaklarının sözüyle,","poem":2},{"lineBreak":true},{"text":"şiddet yollarından kendimi uzak tuttum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adımlarım senin yollarını sımsıkı tuttu.","poem":1},{"text":"Ayaklarım kaymadı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sana seslendim, çünkü bana yanıt verirsin, Tanrım.","poem":1},{"text":"Kulak ver bana.","poem":2},{"lineBreak":true},{"text":"Sözümü duy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İyilikle dolu muhteşem sevgini göster,","poem":1},{"text":"sana sığınanları sağ elinle düşmanlarından kurtaran sensin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gözbebeğin gibi koru beni.","poem":1},{"text":"Beni kanatlarının gölgesinde sakla,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bana baskı yapan kötülerden,","poem":1},{"text":"Etrafımı saran ölümcül düşmanlarımdan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Duygusuz yüreklerini kapatırlar.","poem":1},{"text":"Ağızlarıyla gururla konuşurlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Artık adımlarımızın çevresini sardılar.","poem":1},{"text":"Bizi yere çalmak için gözlerini diktiler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Avına karşı doyumsuz bir aslan,","poem":1},{"text":"pusuya yatmış genç bir aslan gibi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kalk, ey Yahve, onunla uğraş.","poem":1},{"text":"Yere çal onu.","poem":2},{"lineBreak":true},{"text":"Kılıcınla kurtar canımı kötülerden,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"elinle insanlardan, ey Yahve,","poem":1},{"text":"payı bu yaşamda olan dünya insanlarından.","poem":2},{"lineBreak":true},{"text":"Değer verdiklerinin karnını doyurursun.","poem":2},{"lineBreak":true},{"text":"Oğulların bolluk içindedir,","poem":2},{"lineBreak":true},{"text":"onlar da çocukları için servet biriktirirler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bana gelince, yüzünü doğrulukla göreceğim.","poem":1},{"text":"Uyandığımda senin suretini görmeye doyacağım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}