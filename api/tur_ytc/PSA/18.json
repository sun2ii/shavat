{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Yahve’nin hizmetkârı David'in mezmuru - Yahve kendisini bütün düşmanlarının pençesinden ve Saul'un elinden kurtardığı gün David Yahve’ye şu ezgiyi okudu:"]},{"type":"verse","number":1,"content":[{"text":"Seni seviyorum, ey Yahve, gücüm sensin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yahve benim kayam, kalem ve kurtarıcımdır,","poem":1},{"text":"Tanrım, kayam, sığındığımdır,","poem":2},{"lineBreak":true},{"text":"kalkanım ve kurtuluşumun boynuzu, yüksek kulem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Övülmeye layık olan Yahve’yi çağırırım,","poem":1},{"text":"ve kurtulurum düşmanlarımdan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ölüm ipleri sarmıştı beni.","poem":1},{"text":"Tanrısızlık selleri beni ürküttü.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Şeol'ün","poem":1},{"noteId":10},{"text":"ipleri çevremdeydi.","poem":1},{"text":"Ölüm tuzakları üzerime indi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sıkıntı içinde Yahve’yi çağırdım,","poem":1},{"text":"Tanrım’a haykırdım.","poem":2},{"lineBreak":true},{"text":"Duydu sesimi tapınağından.","poem":2},{"lineBreak":true},{"text":"Önündeki feryadım kulaklarına erişti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O zaman yeryüzü sarsılıp titredi.","poem":1},{"text":"Dağların temelleri de yerinden oynadı,","poem":2},{"lineBreak":true},{"text":"çünkü Yahve öfkelenmişti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Burnundan duman yükseldi.","poem":1},{"text":"Ağzından yakıp tüketen bir ateş çıktı.","poem":2},{"lineBreak":true},{"text":"Ondan korlar tutuştu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gökleri yarıp indi.","poem":1},{"text":"Ayakları altında koyu bir karanlık vardı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bir keruva binip uçtu.","poem":1},{"text":"Ve rüzgârın kanatları üzerinde süzüldü.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Karanlığı kendisine saklanacak yer,","poem":1},{"text":"karanlık suları, gökyüzünün koyu bulutlarını,","poem":2},{"lineBreak":true},{"text":"çevresine çardak yaptı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Önündeki parıltıdan dolu ve alevli korlarla,","poem":1},{"text":"O’nun koyu bulutları geçti.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve gökte gürledi.","poem":1},{"text":"Yüceler Yücesi ses verdi,","poem":2},{"lineBreak":true},{"text":"dolu ve alevli korlarla.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Oklarını gönderip onları dağıttı.","poem":1},{"text":"Onları büyük yıldırımlarla bozguna uğrattı.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ey Yahve senin azarlamandan,","poem":1},{"text":"burnundan çıkan güçlü soluktan,","poem":2},{"lineBreak":true},{"text":"suların yatakları göründü,","poem":2},{"lineBreak":true},{"text":"dünyanın temelleri belirdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yukarıdan gönderdi.","poem":1},{"text":"Beni tuttu.","poem":2},{"lineBreak":true},{"text":"Beni çok sulardan çıkardı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Beni güçlü düşmanımdan,","poem":1},{"text":"benden nefret edenlerden kurtardı.","poem":2},{"lineBreak":true},{"text":"Çünkü onlar benden çok güçlüydüler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Felaket günümde üzerime geldiler,","poem":1},{"text":"ama Yahve bana destek çıktı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Beni geniş bir yere çıkardı.","poem":1},{"text":"Kurtardı beni çünkü benden hoşlandı.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yahve doğruluğuma göre ödüllendirdi beni.","poem":1},{"text":"Ellerimin temizliğine göre bana karşılık verdi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü Yahve'nin yollarını tuttum,","poem":1},{"text":"ve kötülükle Tanrım’dan uzaklaşmadım.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü O'nun bütün ilkeleri önümdedir.","poem":1},{"text":"Kurallarını kendimden uzaklaştırmadım.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"O’nunla suçsuzum.","poem":1},{"text":"Günahımdan kendimi uzak tuttum.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bu nedenle Yahve beni doğruluğuma göre,","poem":1},{"text":"ellerimin O’nun gözündeki temizliğine göre ödüllendirdi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Merhametli olana merhametini,","poem":1},{"text":"kusursuz olana kusursuzluğunu gösterirsin.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pak olana paklığını,","poem":1},{"text":"çarpık olana sertliğini gösterirsin.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çünkü mazlum insanları kurtarırsın,","poem":1},{"text":"ama kibirli gözleri alaşağı edersin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Işığımı sen yakacaksın ey Yahve.","poem":1},{"text":"Tanrım karanlığımı aydınlatacaksın.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Çünkü senin sayende akıncıların üstüne çıkarım,","poem":1},{"text":"Tanrım’la surları aşarım.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tanrı'ya gelince, O’nun yolu kusursuzdur.","poem":1},{"text":"Yahve’nin sözü sınandı.","poem":2},{"lineBreak":true},{"text":"O, kendisine sığınan herkese kalkandır.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Çünkü Yahve'den başka Tanrı kimdir?","poem":1},{"text":"Tanrımız’dan başka kaya kimdir?","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"O Tanrı ki, beni güçle donatır ve yolumu kusursuz kılar.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ayaklarımı geyik ayakları gibi eder,","poem":1},{"text":"beni yüksek yerlerime diker.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ellerime savaşmayı öğretir,","poem":1},{"text":"kollarımla tunç bir yayı gereyim diye.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bana kurtuluşunun kalkanını da verdin.","poem":1},{"text":"Sağ elin destekler beni.","poem":2},{"lineBreak":true},{"text":"Senin sevecenliğin beni büyük etti.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Adımlarımın yerini genişlettin,","poem":1},{"text":"ayaklarım kaymadı.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Düşmanlarımı kovalayıp onlara yetişirim,","poem":1},{"text":"onlar yok olana dek geri dönmem.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Onları ezerim, kalkamazlar,","poem":1},{"text":"ayaklarımın altına serilirler.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Çünkü savaş için bana güç verdin.","poem":1},{"text":"Bana karşı çıkanları bana boyun eğdirdin.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Benden nefret edenleri yok edeyim diye,","poem":1},{"text":"düşmanlarımın sırtını bana çevirttin.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Feryat ettiler ama kurtaracak kimse yoktu,","poem":1},{"text":"Yahve’yi bile çağırdılar ama O yanıt vermedi.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"O zaman onları yelin önündeki toz gibi ezdim.","poem":1},{"text":"Onları sokak çamuru gibi dışarı fırlattım.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Halkın çekişmelerinden beni kurtardın.","poem":1},{"text":"Beni ulusların başı yaptın.","poem":2},{"lineBreak":true},{"text":"Tanımadığım bir halk bana hizmet edecek.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Duyar duymaz benim sözümü dinleyecekler.","poem":1},{"text":"Yabancılar bana boyun eğecekler.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Yabancılar yok olup gidecek,","poem":1},{"text":"kalelerinden titreyerek çıkacaklar.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yahve yaşıyor! Kayam’a övgüler olsun!","poem":1},{"text":"Kurtuluşumun Tanrısı yücelsin!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Benim için öç alan,","poem":1},{"text":"halkları bana boyun eğdiren Tanrı O’dur.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Düşmanlarımdan kurtarır.","poem":1},{"text":"Bana karşı çıkanların üstüne çıkarırsın beni.","poem":2},{"lineBreak":true},{"text":"Beni zorbadan kurtarırsın.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Bunun için uluslar arasında sana şükredeceğim, ey Yahve,","poem":1},{"text":"adını ilahilerle öveceğim.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"O, kralına büyük bir kurtuluş verir,","poem":1},{"text":"meshedilmiş olanına, David ve soyuna,","poem":2},{"noteId":11},{"lineBreak":true},{"text":"sonsuza dek sevgi dolu iyiliğini gösterir.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":18,"verse":5}},{"noteId":11,"caller":"+","text":"veya tohum","reference":{"chapter":18,"verse":50}}]},"thisChapterLink":"/api/tur_ytc/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}