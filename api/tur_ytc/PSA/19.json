{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Gökler Tanrı'nın görkemini bildirir.","poem":1},{"text":"Gök boşluğu ellerinin eserini sergiler.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gün güne söz söyler,","poem":1},{"text":"gece geceye bilgi gösterir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne konuşma ne de dil vardır,","poem":1},{"text":"sesleri duyulmaz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sesleri tüm yeryüzüne,","poem":1},{"text":"sözleri dünyanın sonuna dek ulaşır.","poem":2},{"text":"Göklerde güneş için çadır kurdu Tanrı.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gerdekten çıkan güveye benzer güneş,","poem":1},{"text":"yarışını koşan güçlü bir adam gibi sevinir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Göklerin bir ucundan çıkar,","poem":1},{"text":"öbür ucuna dek döner.","poem":2},{"lineBreak":true},{"text":"Sıcaklığından hiçbir şey saklanmaz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve'nin yasası kusursuzdur, canı tazeler.","poem":1},{"text":"Yahve’nin antlaşması emindir, saf kişiyi bilge kılar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve’nin kuralları doğrudur, yüreği sevindirir.","poem":1},{"text":"Yahve’nin buyruğu paktır, gözleri aydınlatır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve korkusu temizdir, sonsuza dek kalıcıdır.","poem":1},{"text":"Yahve’nin ilkeleri gerçektir ve tamamıyla doğrudur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Altından, bol miktarda saf altından daha çok arzu edilir,","poem":1},{"text":"baldan, süzme petek balından daha tatlıdır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Üstelik hizmetkârını uyaran onlardır.","poem":1},{"text":"Onlara uyanların ödülü büyüktür.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kusurlarını kim fark edebilir?","poem":1},{"text":"Gizli kusurlarımdan dolayı beni bağışla.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hizmetkârını bilerek işlenen günahlardan uzak tut.","poem":1},{"text":"Üzerimde hakimiyet kurmasınlar.","poem":2},{"lineBreak":true},{"text":"O zaman doğru olurum.","poem":2},{"lineBreak":true},{"text":"Büyük isyandan suçsuz ve masum çıkarım.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ağzımdan çıkan sözler ve yüreğimin düşüncesi","poem":1},{"text":"senin önünde kabul görsün,","poem":2},{"lineBreak":true},{"text":"ey Yahve, kayam ve kurtarıcım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}