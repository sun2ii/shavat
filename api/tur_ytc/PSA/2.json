{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Uluslar neden öfkeleniyor,","poem":1},{"text":"halklar neden boş düzen kuruyor?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dünyanın kralları ayağa kalkıyor,","poem":1},{"text":"hükümdarlar birbiriyle öğütleşiyor,","poem":2},{"lineBreak":true},{"text":"Yahve’ye ve Mesihi’ne","poem":2},{"noteId":1},{"text":"karşı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Koparalım onların bağlarını” diyorlar,","poem":1},{"text":"“İplerini üzerimizden atalım.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Göklerde oturan gülecek.","poem":1},{"text":"Efendi","poem":2},{"noteId":2},{"text":"onlarla alay edecek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O zaman hiddetle konuşacak onlara,","poem":1},{"text":"gazabıyla onları dehşete düşürecek:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ben Kralımı kutsal dağım Siyon'a oturttum.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kararı bildireceğim:","poem":1},{"text":"Yahve bana, “Sen benim oğlumsun” dedi.","poem":2},{"lineBreak":true},{"text":"“Bugün ben senin baban oldum.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dile benden, mirasın olarak sana ulusları,","poem":1},{"text":"mülk olarak yeryüzünün en uzak köşelerini vereyim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onları demir sopayla kıracaksın,","poem":1},{"text":"çömlekçi kabı gibi parçalayacaksın.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ey krallar, şimdi akıllı olun.","poem":1},{"text":"Ey dünya hâkimleri, ders alın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve’ye korkuyla hizmet edin,","poem":1},{"text":"titreyerek sevinin.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oğul'a içtenlikle saygı gösterin ki","poem":1},{"noteId":3},{"text":"öfkelenmesin,","poem":1},{"text":"yoksa yolunuzda mahvolursunuz.","poem":2},{"lineBreak":true},{"text":"Çünkü hiddeti yakında alevlenecek.","poem":2},{"lineBreak":true},{"text":"Ne mutlu O'na sığınanlara.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"“Meshedilmiş” kelimesi “Mesih” kelimesiyle aynıdır","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":2,"verse":4}},{"noteId":3,"caller":"+","text":"veya Oğul'u öpün","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/tur_ytc/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}