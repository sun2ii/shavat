{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için- David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve sıkıntılı gününde sana yanıt versin.","poem":1},{"text":"Yakov'un Tanrısı'nın adı seni yükseltsin,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kutsal yerden sana yardım göndersin,","poem":1},{"text":"Siyon’dan destek versin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bütün sunularını hatırlasın,","poem":1},{"text":"yakmalık sunularını kabul etsin. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sana yüreğine göre versin,","poem":1},{"text":"ve bütün öğütlerini yerine getirsin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senin kurtarışında zafer kazanacağız.","poem":1},{"text":"Tanrı’nın adıyla sancaklarımızı dikeceğiz.","poem":2},{"lineBreak":true},{"text":"Yahve bütün dileklerini yerine getirsin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Şimdi biliyorum ki, Yahve meshettiğini kurtarıyor.","poem":1},{"text":"Sağ elinin kurtarıcı gücüyle,","poem":2},{"lineBreak":true},{"text":"kutsal cennetten ona yanıt veriyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bazıları savaş arabalarına, bazıları atlara güvenir,","poem":1},{"text":"ama biz Tanrımız Yahve’nin adına güveniriz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onlar eğildiler ve düştüler,","poem":1},{"text":"ama biz kalktık ve dik durduk.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kurtar, ey Yahve!","poem":1},{"text":"Seslendiğimizde Kral bize yanıt versin!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}