{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Kral senin gücüne sevinir, ey Yahve!","poem":1},{"text":"Kurtarışınla ne büyük sevinç duyar!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yüreğinin isteğini ona verdin,","poem":1},{"text":"dudaklarının dileğini geri çevirmedin. Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü iyilik bereketleriyle onu karşıladın.","poem":1},{"text":"Başına saf altından taç koydun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senden yaşam istedi,","poem":1},{"text":"sonsuza dek sürecek uzun günler verdin ona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senin kurtarışınla yüceliği büyüktür.","poem":1},{"text":"Ona saygınlık ve yücelik giydirdin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü sen onu daima en kutsanmış kıldın.","poem":1},{"text":"Huzurunda onu sevinçle coşturdun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü kral Yahve’ye güvenir,","poem":1},{"text":"Yüceler Yücesi'nin sevgi dolu iyiliği sayesinde sarsılmaz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Elin bütün düşmanlarını bulacak.","poem":1},{"text":"Sağ elin senden nefret edenleri bulacaktır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Öfkelendiğin zaman onları kızgın fırına çevireceksin.","poem":1},{"text":"Yahve gazabıyla onları yutacak.","poem":2},{"lineBreak":true},{"text":"Ateş onları yiyip bitirecektir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onların soyunu yeryüzünden,","poem":1},{"text":"gelecek kuşaklarını insanoğulları arasından yok edeceksin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü sana karşı kötülük etmeye niyetlendiler.","poem":1},{"text":"Sana karşı başarılı olamayacak bir kötülük tasarladılar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü sırtlarını döndüreceksin,","poem":1},{"text":"gerilmiş yayını yüzlerine doğrulttuğunda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gücünle yüksel, ey Yahve,","poem":1},{"text":"ezgiler söyleyip kudretini övelim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}