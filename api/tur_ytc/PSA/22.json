{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Tan Geyiği” makamında - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Tanrım, Tanrım, beni neden bıraktın?","poem":1},{"text":"Neden bana yardım etmekten, iniltimin sözlerinden bu kadar uzaksın?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanrım, gündüz çağırıyorum ama yanıt vermiyorsun,","poem":1},{"text":"geceleyin ve sessiz kalmıyorum.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oysa sen kutsalsın,","poem":1},{"text":"meskenini İsrael'in övgüleri üzerine kurarsın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atalarımız sana güvendi.","poem":1},{"text":"Güvendiler ve sen de onları kurtardın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sana seslendiler ve kurtuldular.","poem":1},{"text":"Sana güvendiler ve hayal kırıklığına uğramadılar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ama toprak kurduyum ben, insan değilim,","poem":1},{"text":"insanların yüz karasıyım, halkın hor gördüğü biri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Beni görenlerin hepsi benimle alay ediyor.","poem":1},{"text":"Dudaklarıyla beni aşağılıyorlar. Başlarını sallayıp şöyle diyorlar:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Yahve’ye güvendi.","poem":1},{"text":"Onu kurtarsın.","poem":2},{"lineBreak":true},{"text":"Madem ondan hoşlanıyor, onu kurtarsın bakalım!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oysa beni rahimden sen çıkardın.","poem":1},{"text":"Ana kucağındayken güvenmemi sağladın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ana rahminden sana teslim edildim.","poem":1},{"text":"Doğumumdan beri Tanrım sensin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Benden uzak durma, çünkü sıkıntı yakın.","poem":1},{"text":"Çünkü yardım edecek kimse yok.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Birçok boğalar beni kuşattı.","poem":1},{"text":"Başan'ın güçlü boğaları çevremi sardı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bana karşı ağızlarını sonuna kadar açıyorlar,","poem":1},{"text":"avını parçalayan aslanlar gibi kükrüyorlar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Su gibi dökülüyorum.","poem":1},{"text":"Bütün kemiklerim eklemlerinden çıktı.","poem":2},{"lineBreak":true},{"text":"Yüreğim balmumu gibi,","poem":2},{"lineBreak":true},{"text":"içimde eriyor.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gücüm çömlek parçası gibi kurudu.","poem":1},{"text":"Dilim damağıma yapışıyor.","poem":2},{"lineBreak":true},{"text":"Beni ölüm toprağına yatırdın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü köpekler çevremi sardı.","poem":1},{"text":"Kötüler sürüsü beni kuşattı.","poem":2},{"lineBreak":true},{"text":"Ellerimi ve ayaklarımı deldiler.","poem":2},{"noteId":12}]},{"type":"verse","number":17,"content":[{"text":"Bütün kemiklerimi sayabilirim.","poem":1},{"text":"Gözlerini dikmiş, bana bakıyorlar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Giysilerimi aralarında paylaşıyorlar.","poem":1},{"text":"Elbisem için kura çekiyorlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ama sen, ey Yahve, uzak durma!","poem":1},{"text":"Sensin benim yardımcım. Bana yardım etmek için acele et!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Canımı kılıçtan,","poem":1},{"text":"değerli yaşamımı köpeğin gücünden kurtar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Aslanın ağzından kurtar beni!","poem":1},{"text":"Evet, beni yaban öküzlerinin boynuzlarından kurtardın.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Adını kardeşlerime duyuracağım.","poem":1},{"text":"Topluluğun ortasında seni öveceğim.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ey Yahve'den korkanlar, O’nu övün!","poem":1},{"text":"Ey Yakov soyu, O'nu yüceltin!","poem":2},{"lineBreak":true},{"text":"Ey İsrael soyu, O'ndan korkun!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Çünkü O, mazlumun sıkıntısını küçümsemedi, tiksinmedi.","poem":1},{"text":"Yüzünü de ondan gizlemedi;","poem":2},{"lineBreak":true},{"text":"ama mazlum O’na seslenince, O sesini duydu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Büyük toplulukta övgüm sendendir.","poem":1},{"text":"O’ndan korkanların önünde adaklarımı yerine getireceğim.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Alçakgönüllüler yiyip doyacak.","poem":1},{"text":"O’nu arayanlar Yahve'ye şükredecekler.","poem":2},{"lineBreak":true},{"text":"Yürekleriniz sonsuza dek yaşasın.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yeryüzünün bütün uçları hatırlayacak ve Yahve’ye dönecek.","poem":1},{"text":"Ulusların bütün soyları senin önünde tapınacaklar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Çünkü krallık Yahve’nindir.","poem":1},{"text":"Uluslar üzerinde hükümdar O’dur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dünyanın bütün zenginleri yiyecek ve tapınacaklar.","poem":1},{"text":"Toprağa inen herkes O’nun önünde eğilecek,","poem":2},{"lineBreak":true},{"text":"canını hayatta tutamayanlar bile.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gelecek kuşaklar O’na hizmet edecek.","poem":1},{"text":"Sonraki kuşaklara Efendi anlatılacak.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Gelip O'nun doğruluğunu henüz doğmamış halka bildirecekler.","poem":1},{"text":"Çünkü bunu O yaptı.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Ölü Deniz Tomarları. Masoretik Metinde şöyle yazar: “Bir aslan gibi, ellerimi ve ayaklarımı iğneliyorlar.","reference":{"chapter":22,"verse":16}}]},"thisChapterLink":"/api/tur_ytc/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}