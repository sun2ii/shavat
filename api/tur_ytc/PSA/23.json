{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve benim çobanımdır,","poem":1},{"text":"hiç eksiğim olmaz.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beni yeşil çayırlarda yatırır.","poem":1},{"text":"Sakin suların yanına götürür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Canımı yeniler.","poem":1},{"text":"Adı uğruna doğruluk yollarında bana rehberlik eder.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ölüm gölgesindeki vadiden geçsem bile,","poem":1},{"text":"kötülükten hiç korkmam, çünkü sen benimlesin.","poem":2},{"text":"Senin asan, değneğin,","poem":1},{"text":"onlar rahatlatır beni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Düşmanlarımın huzurunda,","poem":1},{"text":"önüme sofra kurarsın.","poem":2},{"text":"Başımı yağla meshedersin.","poem":1},{"text":"Kâsem taşmakta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kesin olarak yaşamımın bütün günlerinde iyilik ve sevgi izleyecek beni,","poem":1},{"text":"ve daima Yahve’nin evinde oturacağım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}