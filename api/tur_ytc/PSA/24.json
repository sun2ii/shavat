{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve’nindir yeryüzü, doluluğuyla birlikte.","poem":1},{"text":"Dünya ve onda oturanlar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü O’dur onu denizlerin üzerinde kuran,","poem":1},{"text":"taşkınlar üzerinde durduran.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve’nin dağına kim çıkabilir?","poem":1},{"text":"Kim O’nun kutsal yerinde durabilir?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Elleri temiz, yüreği pak olan;","poem":1},{"text":"canını yalana kaptırmamış,","poem":2},{"lineBreak":true},{"text":"hileyle yemin etmemiştir böylesi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O kişi Yahve’nin bereketini,","poem":1},{"text":"kurtuluşunun Tanrısı’ndan gelen doğruluğu alacaktır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu O'nu arayanların kuşağıdır,","poem":1},{"text":"senin yüzünü arayanların— Yakov gibi. Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaldırın başınızı, ey kapılar!","poem":1},{"text":"Yükselin, ey ebedi kapılar,","poem":2},{"lineBreak":true},{"text":"yücelik Kralı içeri girsin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kimdir o Yücelik Kralı?","poem":1},{"text":"Yahve’dir O, güçlü ve kudretli,","poem":2},{"lineBreak":true},{"text":"Yahve savaşta kudretlidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaldırın başınızı, ey kapılar,","poem":1},{"text":"yükselin ey ebedi kapılar,","poem":2},{"lineBreak":true},{"text":"yücelik Kralı içeri girsin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kimdir o yücelik Kralı?","poem":1},{"text":"Ordular Yahvesi, yücelik Kralı O’dur! Selah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}