{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, canımı sana kaldırıyorum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tanrım, sana güvendim,","poem":1},{"text":"utandırma beni.","poem":2},{"lineBreak":true},{"text":"Düşmanlarımın bana galip gelmesine izin verme.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Seni bekleyen hiç kimse utanmayacak.","poem":1},{"text":"Sebepsiz yere hainlik edenler utanacaklar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bana yollarını göster, ey Yahve.","poem":1},{"text":"Bana yönlerini bildir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bana kendi gerçeğinde yol göster ve öğret,","poem":1},{"text":"çünkü sen kurtuluşumun Tanrısı’sın,","poem":2},{"lineBreak":true},{"text":"bütün gün seni bekliyorum.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey Yahve, sevecen merhametlerini ve sevgi dolu iyiliğini hatırla,","poem":1},{"text":"çünkü onlar eski zamanlardan beri aynıdır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gençlik günahlarımı ve gençlik isyanlarımı anma.","poem":1},{"text":"Beni sevgi dolu iyiliğinle,","poem":2},{"lineBreak":true},{"text":"iyiliğine göre hatırla, ey Yahve.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve iyi ve doğrudur,","poem":1},{"text":"bu nedenle günahkârlara yolu gösterir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alçakgönüllülere adalet yolunda yol gösterecek.","poem":1},{"text":"Kendi yolunu onlara öğretecek.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Antlaşmasını ve tanıklıklarını tutanlar için,","poem":1},{"text":"Yahve’nin bütün yolları sevgi dolu iyilik ve gerçektir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Adın uğruna, ey Yahve,","poem":1},{"text":"günahımı bağışla, çünkü günahım büyüktür.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yahve'den korkan adam kimdir?","poem":1},{"text":"Yahve ona seçeceği yolu bildirecektir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onun canı rahat edecek.","poem":1},{"text":"Soyu ülkeyi miras alacaktır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yahve’nin dostluğu kendisinden korkanlarladır.","poem":1},{"text":"Onlara antlaşmasını gösterecektir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gözlerim hep Yahve’nin üstündedir,","poem":1},{"text":"çünkü ayaklarımı ağdan O çıkarır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bana yüzünü çevir ve merhamet et,","poem":1},{"text":"çünkü kimsesiz ve dertliyim.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yüreğimin darlıkları çoğaldı.","poem":1},{"text":"Beni sıkıntılarımdan kurtar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çektiğim sıkıntıları ve acıları gör de,","poem":1},{"text":"bütün günahlarımı bağışla.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Düşmanlarıma bak, çünkü çokturlar.","poem":1},{"text":"Şiddetle benden nefret ediyorlar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Canımı koru, kurtar beni.","poem":1},{"text":"Hayal kırıklığına uğramayayım, çünkü sana sığınıyorum.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Beni dürüstlük ve doğruluk korusun,","poem":1},{"text":"çünkü seni bekliyorum.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ey Tanrı, İsrael'i bütün sıkıntılarından kurtar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}