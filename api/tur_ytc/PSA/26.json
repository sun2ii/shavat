{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Beni yargıla, ey Yahve, çünkü dürüstlüğümle yürüdüm.","poem":1},{"text":"Sarsılmadan Yahve'ye güvendim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beni dene, ey Yahve, sına beni.","poem":1},{"text":"Yüreğimi ve aklımı yokla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü sevgi dolu iyiliğin gözlerimin önündedir.","poem":1},{"text":"Senin gerçeğinde yürüdüm.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hilekâr adamlarla oturmadım,","poem":1},{"text":"ikiyüzlülerin arasına da girmem.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötülük yapanlar topluluğundan nefret ederim,","poem":1},{"text":"kötülerle birlikte oturmam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ellerimi masumiyetle yıkar,","poem":1},{"text":"sunağının etrafında dönerim, ey Yahve,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ta ki, şükran sesini duyurayım","poem":1},{"text":"ve tüm harika işlerini anlatayım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey Yahve, oturduğun evi,","poem":1},{"text":"görkeminin bulunduğu yeri severim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Canımı günahkârlarla,","poem":1},{"text":"hayatımı kana susamış adamlarla bir araya getirme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kötülük ellerindedir,","poem":1},{"text":"sağ elleri rüşvetle doludur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ama ben dürüstlüğümle yürüyeceğim.","poem":1},{"text":"Beni kurtar ve bana merhamet et.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayağım düzlükte durur.","poem":1},{"text":"Topluluklarda Yahve'yi yücelteceğim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}