{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve benim ışığım ve kurtuluşumdur.","poem":1},{"text":"Kimden çekineyim?","poem":2},{"text":"Yahve yaşamımın gücüdür.","poem":1},{"text":"Kimden korkayım?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kötüler etimi yemek için üzerime geldiklerinde,","poem":1},{"text":"hasımlarım ve düşmanlarım bile tökezlediler ve düştüler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bana karşı bir ordu konaklasa,","poem":1},{"text":"yüreğim korkmaz.","poem":2},{"lineBreak":true},{"text":"Bana karşı savaş açılsa,","poem":2},{"lineBreak":true},{"text":"yine de güvenimi korurum.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve'den tek bir şey diledim ve onu ararım:","poem":1},{"text":"Yahve’nin güzelliğini görüp,","poem":2},{"lineBreak":true},{"text":"O’nun tapınağında hayran olmak için,","poem":2},{"lineBreak":true},{"text":"Hayatımın bütün günlerinde Yahve’nin evinde oturmaktır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü sıkıntı gününde beni gizlice çardağında tutacak.","poem":1},{"text":"Beni çadırının gizli yerinde saklayacak.","poem":2},{"lineBreak":true},{"text":"Kaya üzerinde beni yükseltecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Artık başım çevremdeki düşmanlarımın üzerinde yükselecek.","poem":1},{"text":"O’nun çadırında sevinç kurbanları sunacağım.","poem":2},{"lineBreak":true},{"text":"Ezgilerle, ilahilerle Yahve’yi öveceğim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sesimle çağırdığımda duy, ey Yahve.","poem":1},{"text":"Bana merhamet et, yanıtla beni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Yüzümü ara” dediğin zaman,","poem":1},{"text":"yüreğim sana, “Yüzünü arıyorum, ey Yahve” dedi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yüzünü benden gizleme.","poem":1},{"text":"Hizmetkârını öfkeyle uzaklaştırma.","poem":2},{"lineBreak":true},{"text":"Yardımcım sen oldun.","poem":2},{"lineBreak":true},{"text":"Bırakma, terk etme beni,","poem":2},{"lineBreak":true},{"text":"ey kurtuluşumun Tanrısı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Babamla annem beni terk ettiğinde,","poem":1},{"text":"Yahve beni yukarı kaldırır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bana kendi yolunu öğret, ey Yahve.","poem":1},{"text":"Düşmanlarımdan ötürü bana doğru yolda rehber ol.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Beni hasımlarımın keyfine bırakma,","poem":1},{"text":"Çünkü yalancı tanıklar karşıma dikildi,","poem":2},{"lineBreak":true},{"text":"şiddet soluyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaşayanlar diyarında Yahve’nin iyiliğini göreceğimden","poem":1},{"text":"ben hâlâ eminim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yahve’yi bekle.","poem":1},{"text":"Güçlü ol ve yüreğin cesaretli olsun.","poem":2},{"lineBreak":true},{"text":"Evet, Yahve'yi bekle.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}