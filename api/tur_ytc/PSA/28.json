{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, sana sesleniyorum,","poem":1},{"text":"kayam benim, kulak tıkama sesime,","poem":2},{"lineBreak":true},{"text":"bana karşı sessiz kalırsan,","poem":2},{"lineBreak":true},{"text":"çukura inenler gibi olurum.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sana haykırdığımda,","poem":1},{"text":"ellerimi En Kutsal Yerine doğru kaldırdığımda,","poem":2},{"lineBreak":true},{"text":"dileklerimin sesini duy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Beni kötülerle, kötülüğün işçileriyle aynı yere çekme.","poem":1},{"text":"Onlar komşularıyla barış konuşurlar ama yüreklerinde kötülük vardır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onlara yaptıklarına göre, işledikleri kötülüğün karşılığına göre ver.","poem":1},{"text":"Ellerinin işlerine göre onlara ver.","poem":2},{"lineBreak":true},{"text":"Onlara hak ettiklerinin karşılığını ver.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Madem Yahve’nin işlerine,","poem":1},{"text":"ellerinin işine saygı duymuyorlar,","poem":2},{"lineBreak":true},{"text":"Yahve onları yıkacak ve bina etmeyecektir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahve’ye övgüler olsun,","poem":1},{"text":"çünkü dileklerimin sesini duydu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve benim gücüm ve kalkanımdır.","poem":1},{"text":"Yüreğim O’na güvendi ve yardım buldum.","poem":2},{"lineBreak":true},{"text":"Bu nedenle yüreğim coşuyor.","poem":2},{"lineBreak":true},{"text":"Ezgimle O’na şükredeceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve onların gücüdür.","poem":1},{"text":"O, meshettiğinin kurtuluş kalesidir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halkını kurtar,","poem":1},{"text":"mirasını kutsa.","poem":2},{"lineBreak":true},{"text":"Onların çobanı ol,","poem":2},{"lineBreak":true},{"text":"ve onları daima taşı.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}