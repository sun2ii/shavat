{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey kudretli olanın oğulları, Yahve’ye verin,","poem":1},{"text":"Yahve’ye yücelik ve güç verin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Adından ötürü yüceliği Yahve’ye verin.","poem":1},{"text":"Kutsal düzen içinde Yahve’ye tapının.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve'nin sesi suların üstündedir.","poem":1},{"text":"Yücelik Tanrısı,","poem":2},{"lineBreak":true},{"text":"Yahve birçok sular üstünde gürlüyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve'nin sesi güçlüdür.","poem":1},{"text":"Yahve’nin sesi heybetle doludur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve’nin sesi sedir ağaçlarını kırar.","poem":1},{"text":"Evet, Yahve Lübnan sedirlerini parçalar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onları buzağı gibi,","poem":1},{"text":"Lübnan’ı ve Siryon’u yaban öküzü yavrusu gibi sıçratır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve’nin sesi şimşek gibi çakar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yahve'nin sesi çölü sarsar.","poem":1},{"text":"Yahve Kadeş Çölü’nü sarsar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve’nin sesi geyikleri doğurtur,","poem":1},{"text":"ormanları çıplak bırakır.","poem":2},{"lineBreak":true},{"text":"O’nun tapınağındaki her şey “Yücesin!” diyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve Tufan'da tahtına oturdu.","poem":1},{"text":"Evet, Yahve sonsuza dek Kral olarak oturur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve halkına güç verir.","poem":1},{"text":"Yahve halkını esenlikle kutsar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}