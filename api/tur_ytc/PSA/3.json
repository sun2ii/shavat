{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["David’in oğlu Avşalom'dan kaçtığı zaman yazdığı mezmur"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, düşmanlarım nasıl da çoğaldı!","poem":1},{"text":"Bana karşı ayaklananlar çoktur.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Canım için birçoğu,","poem":1},{"text":"“Tanrı","poem":2},{"noteId":4},{"text":"katında ona yardım yoktur” diyor. Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama sen, ey Yahve, çevremde kalkansın,","poem":1},{"text":"yüceliğim ve başımı yükselten sensin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve’ye seslenirim,","poem":1},{"text":"kutsal dağından bana yanıt verir. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yattım ve uyudum.","poem":1},{"text":"Uyandım, çünkü Yahve bana destek oldu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Her yönden bana karşı koyan","poem":1},{"text":"on binlerden korkmam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kalk, ey Yahve!","poem":1},{"text":"Tanrım, kurtar beni!","poem":2},{"text":"Çünkü sen tüm düşmanlarımın çene kemiğine vurdun.","poem":1},{"text":"Kötülerin dişlerini kırdın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kurtuluş Yahve’nindir.","poem":1},{"text":"Kutsaman halkının üzerinde olsun! Selah.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/tur_ytc/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}