{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Tapınak adanırken söylenen bir ilahi"]},{"type":"verse","number":1,"content":[{"text":"Seni överim, ey Yahve, çünkü beni ayağa kaldırdın,","poem":1},{"text":"düşmanlarımı bana sevindirmedin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ey Yahve Tanrım, sana seslendim,","poem":1},{"text":"ve bana şifa verdin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey Yahve, canımı Şeol'den","poem":1},{"noteId":13},{"text":"çıkardın.","poem":1},{"text":"Çukura inmeyeyim diye beni hayatta tuttun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey O’nun kutsalları, Yahve’yi ilahilerle övün.","poem":1},{"text":"O'nun kutsal adına şükredin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü öfkesi bir an içindir.","poem":1},{"text":"Lütfu ise bir ömür.","poem":2},{"text":"Ağlayış bir gece kalabilir,","poem":1},{"text":"ama sabahleyin sevinç gelir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bense, bolluk içinde şöyle dedim:","poem":1},{"text":"“Asla sarsılmayacağım.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey Yahve, lütfunla dağımı sağlamlaştırdın;","poem":1},{"text":"ama sen yüzünü gizleyince sıkıntı duydum.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey Yahve, sana seslendim.","poem":1},{"text":"Efendime rica ettim:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Eğer çukura inersem, yıkımımın ne yararı olur?","poem":1},{"text":"Toprak seni över mi?","poem":2},{"lineBreak":true},{"text":"Senin gerçeğini ilan eder mi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Duy, ey Yahve, bana merhamet et.","poem":1},{"text":"Yardımcım ol, ey Yahve!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yasımı benim için raksa çevirdin.","poem":1},{"text":"Çulumu çıkardın ve bana sevinç giydirdin,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ta ki yüreğim seni ilahilerle övsün ve susmasın.","poem":1},{"text":"Ey Yahve Tanrım, sana daima şükredeceğim!","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":30,"verse":3}}]},"thisChapterLink":"/api/tur_ytc/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}