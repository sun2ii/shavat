{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, sana sığınıyorum,","poem":1},{"text":"hiçbir zaman beni hayal kırıklığına uğratma.","poem":2},{"lineBreak":true},{"text":"Beni kendi doğruluğunla kurtar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kulak ver bana.","poem":1},{"text":"Beni tez kurtar.","poem":2},{"lineBreak":true},{"text":"Bana güçlü bir kaya,","poem":2},{"lineBreak":true},{"text":"beni kurtarmak için sığınacak ev ol.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü sen benim kayam ve kalemsin,","poem":1},{"text":"bu nedenle, adın uğruna bana yol göster ve bana rehber ol.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Benim için gizlice kurdukları ağdan beni çekip çıkar,","poem":1},{"text":"çünkü sen benim kalemsin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ruhumu ellerine emanet ediyorum.","poem":1},{"text":"Gerçeğin Tanrısı, ey Yahve, beni kurtar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yalancı putlara saygı duyanlardan nefret ederim,","poem":1},{"text":"ancak Yahve’ye güvenirim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senin sevgi dolu iyiliğinle sevinip coşacağım,","poem":1},{"text":"çünkü çektiğim sıkıntıyı gördün.","poem":2},{"lineBreak":true},{"text":"Canımı sıkıntılar içinde bildin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Beni düşmanın eli içinde kapatmadın.","poem":1},{"text":"Ayaklarımı geniş bir yere yerleştirdin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bana merhamet et, ey Yahve, çünkü sıkıntıdayım.","poem":1},{"text":"Gözüm, canım, bedenim kederden eriyip gidiyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü ömrüm kederle geçti,","poem":1},{"text":"yıllarım iniltiyle,","poem":2},{"lineBreak":true},{"text":"suçumdan ötürü gücüm tükeniyor.","poem":2},{"lineBreak":true},{"text":"Kemiklerim eriyip gidiyor.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bütün düşmanlarım yüzünden","poem":1},{"text":"komşularıma karşı büsbütün aşağılık birisi,","poem":2},{"lineBreak":true},{"text":"tanıdıklarım için dehşet oldum.","poem":2},{"lineBreak":true},{"text":"Beni sokakta görenler benden kaçar oldu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ölü bir adam gibi yüreklerinden unutulup gittim.","poem":1},{"text":"Kırık bir çömlek gibiyim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü birçok insanın iftiralarını duydum,","poem":1},{"text":"her tarafta dehşet içinde.","poem":2},{"lineBreak":true},{"text":"Onlar bana karşı düzen kurarken,","poem":2},{"lineBreak":true},{"text":"canımı almak için anlaştılar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ama ben sana güveniyorum, ey Yahve.","poem":1},{"text":"“Tanrım sensin” dedim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vakitlerim senin elinde.","poem":1},{"text":"Beni düşmanlarımın elinden ve bana zulmedenlerden kurtar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yüzün hizmetkârının üzerinde parlasın.","poem":1},{"text":"Beni sevgi dolu iyiliğinle kurtar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hayal kırıklığına uğramayayım, ey Yahve, çünkü seni çağırdım.","poem":1},{"text":"Kötüler hayal kırıklığına uğrasınlar.","poem":2},{"lineBreak":true},{"text":"Şeol'de","poem":2},{"noteId":14},{"text":"sessiz kalsınlar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yalan söyleyen dudaklar sessiz kalsın,","poem":1},{"text":"doğruların aleyhinde küstahça,","poem":2},{"lineBreak":true},{"text":"Gurur ve küçümsemeyle konuşurlar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Senden korkanlar için sakladığın,","poem":1},{"text":"sana sığınanlar için yaptığın,","poem":2},{"lineBreak":true},{"text":"İnsanoğlunun önündeki, iyiliğin ne büyüktür!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Onları huzurunun barınağında,","poem":1},{"text":"insanların tuzaklarından gizlersin.","poem":2},{"lineBreak":true},{"text":"Kavgacı dillerden bir çardakta onları saklarsın.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yahve’ye övgüler olsun,","poem":1},{"text":"çünkü güçlü bir kentte","poem":2},{"lineBreak":true},{"text":"bana şaşılası sevgi dolu iyiliğini gösterdi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bana gelince, aceleyle, “Gözlerinin önünden atıldım” dedim.","poem":1},{"text":"Yine de sana seslendiğimde dileklerimin sesini duydun.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yahve’yi sevin, ey O’nun kutsalları!","poem":1},{"text":"Yahve sadıkları korur,","poem":2},{"lineBreak":true},{"text":"kibirli davrananlara tam karşılığını verir.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ey sizler, Yahve’ye umut bağlayanlar, hepiniz,","poem":1},{"text":"güçlü olun ve yüreğiniz cesaretli olsun.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":31,"verse":17}}]},"thisChapterLink":"/api/tur_ytc/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}