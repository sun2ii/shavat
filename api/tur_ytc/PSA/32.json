{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru - Maskil"]},{"type":"verse","number":1,"content":[{"text":"Ne mutlu itaatsizliği bağışlanmış,","poem":1},{"text":"günahı örtülmüş olan insana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne mutlu Yahve tarafından suçu sayılmayan,","poem":1},{"text":"ruhunda hile olmayan insana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sustuğumda gün boyu inlemelerimden","poem":1},{"text":"kemiklerim eridi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gece gündüz elin üzerimde ağırdı.","poem":1},{"text":"Yaz sıcağında gücüm tükendi. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Günahımı sana itiraf ettim.","poem":1},{"text":"Suçumu saklamadım.","poem":2},{"text":"“Yahve'ye isyanlarımı itiraf edeceğim” dedim.","poem":1},{"text":"Günahımın suçunu bağışladın. Selah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bunun için, bulunabileceğin sırada,","poem":1},{"text":"tanrısal olan herkes sana dua etsin.","poem":2},{"lineBreak":true},{"text":"Büyük sular taştığında kesinlikle ona erişemezler.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sensin benim sığınağım.","poem":1},{"text":"Beni sıkıntıdan korursun.","poem":2},{"lineBreak":true},{"text":"Beni kurtuluş ezgileriyle kuşatırsın. Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eğiteceğim seni, gideceğin yolu sana öğreteceğim.","poem":1},{"text":"Gözüm üzerinde, sana öğüt vereceğim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anlayışsız at ya da katır gibi olmayın.","poem":1},{"text":"Onları tutmak için gem ve dizgin olmazsa,","poem":2},{"lineBreak":true},{"text":"sana yaklaşamazlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çok keder gelir kötülerin başına,","poem":1},{"text":"ama güveni Yahve olanı sevgi dolu iyilik kuşatacaktır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey doğrular, Yahve ile sevinin ve coşun!","poem":1},{"text":"Ey yüreği doğru olanlar, sevinçle haykırın!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}