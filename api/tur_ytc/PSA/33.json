{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Ey doğrular, Yahve ile sevinin!","poem":1},{"text":"Doğrulara övgü yaraşır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lir çalarak Yahve’ye şükredin.","poem":1},{"text":"On telli arpla O'nu ilahilerle övün.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O’na yeni bir ezgi söyleyin.","poem":1},{"text":"Sevinç çığlığıyla ustaca çalın!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Yahve’nin sözü doğrudur.","poem":1},{"text":"Bütün işlerini sadakatle yapar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doğruluğu ve adaleti sever.","poem":1},{"text":"Dünya Yahve’nin sevgi dolu iyiliğiyle doludur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gökler Yahve’nin sözüyle,","poem":1},{"text":"onların bütün orduları ağzının soluğuyla yaratıldı.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Denizin sularını bir yığın gibi toplar.","poem":1},{"text":"Derinliklerini ambarlarda yığar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bütün yeryüzü Yahve'den korksun.","poem":1},{"text":"Dünyada yaşayan herkes O’na hayranlık duysun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü O söyledi ve oldu.","poem":1},{"text":"O buyurdu ve sağlam durdu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yahve ulusların öğüdünü boşa çıkarır.","poem":1},{"text":"Halkların düşüncelerini hiç eder.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve’nin öğüdü sonsuza dek,","poem":1},{"text":"yüreğinin düşünceleri tüm kuşaklar boyunca yerinde durur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne mutlu Tanrısı Yahve olan ulusa,","poem":1},{"text":"kendi mirası olarak seçtiği halka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve gökten bakar.","poem":1},{"text":"Bütün insanoğullarını görür.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaşadığı yerden yeryüzünde yaşayanların tümünü gözler.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Her birinin yüreğine biçim veren,","poem":1},{"text":"onların bütün işlerini tartan O’dur.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asker çokluğuyla kurtulan kral yoktur.","poem":1},{"text":"Ne de büyük gücüyle kurtulan bir yiğit vardır.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Güvenlik için at boştur,","poem":1},{"text":"büyük gücüne karşın kimseyi kurtarmaz.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İşte, Yahve’nin gözü kendisinden korkanların,","poem":1},{"text":"O’nun sevgi dolu iyiliğine umut bağlayanların üzerindedir.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Böylece onları ölümden kurtarır,","poem":1},{"text":"kıtlık içinde onları yaşatır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Canımız Yahve’yi bekler.","poem":1},{"text":"O bizim yardımımız ve kalkanımızdır.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yüreğimiz O’nda sevinç bulur,","poem":1},{"text":"çünkü biz O'nun kutsal adına güvendik.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Madem umudumuz sende,","poem":1},{"text":"sevgi dolu iyiliğin üzerimizde olsun, ey Yahve!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}