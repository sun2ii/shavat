{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru Avimelek’in önünde kendini deli gibi gösterip kovulduğu, Gittiği zaman"]},{"type":"verse","number":1,"content":[{"noteId":15},{"text":"Yahve’yi her zaman öveceğim.","poem":1},{"text":"O’nun övgüsü hep ağzımda olacak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Canım Yahve ile övünür.","poem":1},{"text":"Alçakgönüllüler bunu duyup sevinsin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve'yi benimle birlikte övün.","poem":1},{"text":"Adını hep birlikte yüceltelim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve’yi aradım ve bana yanıt verdi,","poem":1},{"text":"ve beni tüm korkularımdan kurtardı.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O’na baktılar, ışıl ışıl parladılar.","poem":1},{"text":"Yüzlerini asla utanç kaplamayacak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu yoksul adam yakardı ve Yahve onu duydu,","poem":1},{"text":"ve onu bütün sıkıntılarından kurtardı.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve’nin meleği kendisinden korkanların çevresinde,","poem":1},{"text":"ordugâh kurar, onları kurtarır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tadın ve görün, Yahve ne iyidir.","poem":1},{"text":"Ne mutlu O'na sığınan insana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve'den korkun, ey O’nun kutsalları,","poem":1},{"text":"çünkü O'ndan korkanların eksiği olmaz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Genç aslanlar muhtaç olur, açlık çekerler,","poem":1},{"text":"ama Yahve’yi arayanlar hiçbir iyilikten yoksun kalmaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gelin ey çocuklar, beni dinleyin.","poem":1},{"text":"Size Yahve korkusunu öğreteyim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kimdir yaşamı arzulayan kişi,","poem":1},{"text":"iyilik görmek için uzun günler seven?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dilini kötülükten,","poem":1},{"text":"dudaklarını yalan söylemekten uzak tutsun.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kötülükten uzak durun, iyilik yapın.","poem":1},{"text":"Esenliği arayın ve ardınca gidin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yahve’nin gözleri doğruların üzerindedir.","poem":1},{"text":"Kulakları onların feryadını duyar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve’nin yüzü kötülük yapanlara karşıdır,","poem":1},{"text":"onların anılarını yeryüzünden kesip atar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doğrular feryat eder, Yahve duyar,","poem":1},{"text":"onları bütün sıkıntılarından kurtarır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yahve yüreği kırık olanlara yakındır,","poem":1},{"text":"ruhu ezilmiş olanları kurtarır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Doğrunun dertleri çoktur,","poem":1},{"text":"ama Yahve onu hepsinden kurtarır.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bütün kemiklerini korur.","poem":1},{"text":"Onlardan hiçbiri kırılmaz.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kötüyü kötülük öldürür.","poem":1},{"text":"Doğru kişiden nefret edenler mahkûm olurlar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yahve hizmetkârının canını kurtarır.","poem":1},{"text":"O’na sığınanların hiçbiri mahkûm olmaz.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Mezmurlar 34, her ayetin alfabedeki bir harfle başladığı (Alef'ten Tav'a doğru sıralanmış) bir akrostiş şiirdir.","reference":{"chapter":34,"verse":1}}]},"thisChapterLink":"/api/tur_ytc/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}