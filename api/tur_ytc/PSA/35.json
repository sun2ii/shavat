{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, benimle çekişenlerle sen çekiş,","poem":1},{"text":"bana karşı savaşanlarla sen savaş.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Küçük ve büyük kalkanı al,","poem":1},{"text":"yardımım için ayağa kalk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mızrağı savur ve beni kovalayanları engelle.","poem":1},{"text":"Canıma, “Senin kurtuluşun benim.” de.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Canımı almak isteyenler hayal kırıklığına uğrayıp rezil olsunlar.","poem":1},{"text":"Bana kötülük düşünenler geri dönüp şaşkına dönsünler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rüzgârın önündeki saman çöpü gibi olsunlar,","poem":1},{"text":"Yahve’nin meleği onları sürsün.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yolları karanlık ve kaygan olsun,","poem":1},{"text":"Yahve'nin meleği onların peşlerine düşsün.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü nedensiz yere benim için ağlarını çukurda gizlediler.","poem":1},{"text":"Hiçbir sebep yokken canıma çukur kazdılar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Habersiz yıkım üzerine gelsin.","poem":1},{"text":"Gizlediği ağ kendisini yakalasın.","poem":2},{"lineBreak":true},{"text":"O yıkımın içine kendisi düşsün.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Canım Yahve’de sevinç bulacak.","poem":1},{"text":"O’nun kurtarışıyla sevinecek.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bütün kemiklerim şöyle diyecek:","poem":1},{"text":"“Senin gibisi var mı, ey Yahve,","poem":2},{"lineBreak":true},{"text":"yoksulu kendisine göre çok güçlü olanın elinden,","poem":2},{"lineBreak":true},{"text":"yoksulu, muhtacı soyguncudan kurtaran?”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yalancı tanıklar ayağa kalkıyor.","poem":1},{"text":"Bilmediğim şeyleri bana soruyorlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Canımı kederlendirmek için,","poem":1},{"text":"iyiliğe karşı bana kötülük ediyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ben ise, onlar hastalandıklarında çul kuşanırdım.","poem":1},{"text":"Oruçla canımı alçaltırdım.","poem":2},{"lineBreak":true},{"text":"Duam kendi bağrıma dönerdi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onlara dostum ya da kardeşimmiş gibi davranırdım.","poem":1},{"text":"Annesi için yas tutan birisi gibi yas tutarak yere kapanırdım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ama benim sıkıntım karşısında sevindiler ve bir araya toplandılar.","poem":1},{"text":"Saldırganlar bana karşı toplandılar ve ben bunu bilmiyordum.","poem":2},{"lineBreak":true},{"text":"Bana saldırdılar ve durmadılar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ziyafetlerdeki kirli soytarılar gibi,","poem":1},{"text":"bana dişlerini gıcırdattılar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ey Efendim, ne zamana dek bakacaksın?","poem":1},{"text":"Canımı onların yok edişinden,","poem":2},{"lineBreak":true},{"text":"yaşamımı genç aslanlardan kurtar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Büyük toplantıda sana şükürler sunacağım.","poem":1},{"text":"Kalabalığın ortasında seni öveceğim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Düşmanlarım haksız yere bana karşı sevinmesinler;","poem":1},{"text":"benden nedensiz yere nefret edenler,","poem":2},{"lineBreak":true},{"text":"göz kırpmasınlar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Çünkü onlar esenlikten söz etmezler,","poem":1},{"text":"ama ülkenin sakin insanlarına karşı","poem":2},{"lineBreak":true},{"text":"hileli sözler uydururlar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bana karşı ağızlarını sonuna kadar açtılar.","poem":1},{"text":"“Oh! Oh! Gözümüz bunu gördü!” diyorlar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sen bunu gördün, ey Yahve. Sessiz kalma.","poem":1},{"text":"Ey Efendim benden uzak durma.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ey Tanrım, uyan, kalk ve savun beni!","poem":1},{"text":"Ey Efendim, benim için gayrete gel!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Doğruluğuna göre beni haklı çıkar, ey Yahve Tanrım.","poem":1},{"text":"Bana karşı sevinmelerine izin verme.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yüreklerinde, “Oh! Dileğimiz buydu,","poem":1},{"text":"onu yuttuk!” demesinler.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Felaketime sevinenler,","poem":1},{"text":"hayal kırıklığına uğrayıp şaşkına dönsünler.","poem":2},{"lineBreak":true},{"text":"Bana karşı kendilerini yüceltenler,","poem":2},{"lineBreak":true},{"text":"utanç ve rezilliğe bürünsünler.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Haklı davamı destekleyenler,","poem":1},{"text":"sevinçle haykırıp coşsunlar.","poem":2},{"lineBreak":true},{"text":"Sürekli şöyle desinler:","poem":2},{"lineBreak":true},{"text":"“Hizmetkârının bolluk içinde olmasından hoşlanan","poem":2},{"lineBreak":true},{"text":"Yahve yücelsin!”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Dilim gün boyu senin doğruluğundan,","poem":1},{"text":"övgülerinden söz edecek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}