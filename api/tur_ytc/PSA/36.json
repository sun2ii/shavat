{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için- Yahve’nin hizmetkârı David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Kötünün itaatsizliği hakkında yüreğimde bir esin var:","poem":1},{"text":"“Gözünde Tanrı korkusu yoktur.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kendini beğendiği için,","poem":1},{"text":"günahını fark edemez ve ondan nefret etmez.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ağzının sözleri kötülük ve hiledir.","poem":1},{"text":"Akıllı olmayı ve iyilik yapmayı bırakmıştır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yatağında kötülük tasarlar.","poem":1},{"text":"Kendini iyi olmayan bir yola sokar.","poem":2},{"lineBreak":true},{"text":"Kötülükten nefret etmez.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sevgi dolu iyiliğin, ey Yahve, göklerdedir.","poem":1},{"text":"Sadakatin gökyüzüne ulaşır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğruluğun Tanrı'nın dağları,","poem":1},{"text":"yargıların büyük derinlik gibidir.","poem":2},{"lineBreak":true},{"text":"Ey Yahve, insanı ve hayvanı koruyan sensin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sevgi dolu iyiliğin ne değerli, ey Tanrı!","poem":1},{"text":"İnsanoğulları kanatlarının gölgesine sığınır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Evinin bolluğuyla bol bol doyacaklar.","poem":1},{"text":"Senin zevklerinin ırmağından onlara içireceksin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü yaşamın kaynağı sendedir.","poem":1},{"text":"Senin ışığında ışığı göreceğiz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Seni tanıyanlara sevgi dolu iyiliğini,","poem":1},{"text":"yüreği doğru olanlara karşı doğruluğunu sürdür.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gururlunun ayağının bana karşı gelmesine,","poem":1},{"text":"kötünün elinin beni kovmasına izin verme.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Orada kötülük yapanlar düştü.","poem":1},{"text":"Yıkıldılar ve kalkamazlar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}