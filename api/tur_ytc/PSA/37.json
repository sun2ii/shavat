{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Kötülük edenler yüzünden üzülme,","poem":1},{"text":"haksızlık yapanlara da özenme.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü yakında ot gibi biçilecekler,","poem":1},{"text":"yeşil bitki gibi solup gidecekler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve’ye güven ve iyilik et.","poem":1},{"text":"Ülkede otur ve güvenli otlakların tadını çıkar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahve’den de zevk al,","poem":1},{"text":"O da sana yüreğinin dileklerini verecektir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yolunu Yahve'ye teslim et.","poem":1},{"text":"O’na güven,","poem":2},{"lineBreak":true},{"text":"O da şunu yapacaktır:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğruluğunu ışık gibi,","poem":1},{"text":"hakkını öğlen güneşi gibi parlatacaktır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahve’ye güven, O’nu sabırla bekle.","poem":1},{"text":"Üzülme işi yolunda olup da,","poem":2},{"lineBreak":true},{"text":"kötü planlarını gerçekleştiren kişi için.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kızmaktan vazgeç, öfkeyi bırak.","poem":1},{"text":"Üzülme, bu yalnızca kötülüğe sürükler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü kötülük edenler kesilip atılacak,","poem":1},{"text":"ama Yahve’yi bekleyenler ülkeyi miras alacak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kısa bir süre sonra kötüler yok olacak.","poem":1},{"text":"Yerini arasan bile artık orada bulunmayacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ama alçakgönüllüler ülkeyi miras alacaklar,","poem":1},{"text":"taşkın esenlikten tad alacaklar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kötü doğruya karşı düzen kurar,","poem":1},{"text":"ve ona diş gıcırdatır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Efendi ona güler,","poem":1},{"text":"çünkü onun gününün geldiğini görür.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kötüler kılıç çekip yaylarını gerdiler,","poem":1},{"text":"yoksulları ve muhtaçları yere sermek,","poem":2},{"lineBreak":true},{"text":"yolu doğru olanları öldürmek için.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onların kılıcı kendi yüreklerine girecek,","poem":1},{"text":"yayları kırılacaktır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Doğrunun azı,","poem":1},{"text":"birçok kötünün bolluğundan daha iyidir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü kötülerin gücü kırılacak,","poem":1},{"text":"ama Yahve doğrulara destek olur.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yahve kusursuz olanların günlerini bilir.","poem":1},{"text":"Onların mirası daima kalıcıdır.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kötülük zamanında hayal kırıklığına uğramayacaklar.","poem":1},{"text":"Kıtlık günlerinde doyurulacaklar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ama kötüler yok olacaklar.","poem":1},{"text":"Yahve’nin düşmanları kırların güzelliğine benzeyecek.","poem":2},{"lineBreak":true},{"text":"Duman gibi dağılıp yok olacak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kötü kişi ödünç alır da geri vermez,","poem":1},{"text":"ama doğru kişi cömertçe verir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü O’nun kutsadıkları ülkeyi miras alacak.","poem":1},{"text":"O’nun lanetledikleri kesilip atılacaktır.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"İnsanın adımları Yahve tarafından pekiştirilir.","poem":1},{"text":"Onun yolundan hoşnuttur.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tökezlese de düşmez,","poem":1},{"text":"çünkü elinden tutan Yahve’dir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gençtim, şimdi yaşlandım,","poem":1},{"text":"yine de doğruların terk edildiğini,","poem":2},{"lineBreak":true},{"text":"ve de çocuklarının ekmek dilendiğini hiç görmedim.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bütün gün merhametle davranır ve ödünç verir.","poem":1},{"text":"Onun soyu kutsanır.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kötülükten uzak dur, iyilik et.","poem":1},{"text":"Sonsuza dek güven içinde yaşa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Çünkü Yahve adaleti sever,","poem":1},{"text":"kutsallarını terk etmez.","poem":2},{"lineBreak":true},{"text":"Onlar daima korunur,","poem":2},{"lineBreak":true},{"text":"ama kötülerin soyu kesilip atılacak.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Doğrular ülkeyi miras alacak,","poem":1},{"text":"ve daima içinde yaşayacaklar.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Doğrunun ağzı bilgelik konuşur.","poem":1},{"text":"Dili adaleti söyler.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tanrısı’nın yasası yüreğindedir.","poem":1},{"text":"Adımlarından hiçbiri kaymaz.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kötü doğruyu gözetler,","poem":1},{"text":"onu öldürmenin yolunu arar.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yahve onu kötünün eline bırakmaz,","poem":1},{"text":"yargılandığında onu mahkûm etmez.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yahve'yi bekle, O’nun yolunu tut,","poem":1},{"text":"ülkeyi miras almak için seni yükseltecektir.","poem":2},{"lineBreak":true},{"text":"Kötüler kesilip atıldığı zaman, bunu göreceksin.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kötüyü büyük güç içinde gördüm,","poem":1},{"text":"yeşil bir ağaç gibi bittiği yerde yayılmış.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ama gelip geçti işte, artık o yok.","poem":1},{"text":"Onu aradım ama bulunamadı.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Kusursuz adamın üzerine bir nişan koy, doğru adama bak,","poem":1},{"text":"çünkü gelecek esenlik adamınındır.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"İsyan edenlere gelince, onlar hep birlikte yok edilecekler.","poem":1},{"text":"Kötülerin geleceği kesilip atılacaktır.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ama doğruların kurtuluşu Yahve'dendir.","poem":1},{"text":"O, sıkıntı zamanlarında onların kalesidir.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yahve onlara yardım eder ve onları kurtarır.","poem":1},{"text":"Onları kötülerin elinden kurtarıp özgür kılar,","poem":2},{"lineBreak":true},{"text":"çünkü O’na sığındılar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}