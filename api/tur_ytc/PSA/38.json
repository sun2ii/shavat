{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["Anma sunusu için David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, öfkenle beni azarlama,","poem":1},{"text":"gazapla beni yola getirme.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü okların beni deldi,","poem":1},{"text":"elin üzerime ağır basıyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Öfken yüzünden bedenime rahat yok,","poem":1},{"text":"günahımdan ötürü kemiklerimde de hiç sağlık kalmadı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü kötülüklerim başımı aştı.","poem":1},{"text":"Ağır bir yük gibi, bana çok ağır geldiler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akılsızlığım yüzünden,","poem":1},{"text":"yaralarım iğrenç ve irinlidir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Acı çekiyorum, iki büklüm eğildim.","poem":1},{"text":"Bütün gün yas içindeyim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü belim ateşle dolu.","poem":1},{"text":"Bedenimde hiçbir rahat yok.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baygınım ve alabildiğine yaralıyım.","poem":1},{"text":"Yüreğimin acısından inliyorum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey Efendim, bütün dileğim senin önündedir.","poem":1},{"text":"İnlemelerim senden gizli değil.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yüreğim çarpıyor.","poem":1},{"text":"Gücüm tükeniyor.","poem":2},{"lineBreak":true},{"text":"Gözlerimin feri de beni terk etti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sevenlerim ve dostlarım felaketimden uzak duruyorlar.","poem":1},{"text":"Akrabalarım da uzakta durmaktalar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Canımı almanın yolunu arayanlar da tuzak kuruyorlar.","poem":1},{"text":"Zararımı arayanlar kötü söz söylüyorlar,","poem":2},{"lineBreak":true},{"text":"gün boyu hileler düşünüyorlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ama ben sağır biri gibi duymuyorum.","poem":1},{"text":"Ağzını açmayan dilsiz gibiyim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ağzında yanıt olmayan,","poem":1},{"text":"duymayan biri gibiyim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Çünkü ben sana güveniyorum, ey Yahve.","poem":1},{"text":"Sen yanıtlayacaksın, ey Efendi Tanrım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü dedim ki, “Benden ötürü sevinmesinler,","poem":1},{"text":"ayağım kayınca böbürlenmesinler.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü ben düşmek üzereyim.","poem":1},{"text":"Kederim hep önümde.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü suçumu itiraf ederim.","poem":1},{"text":"Günahımdan ötürü üzgünüm.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ama düşmanlarım güçlü ve çoktur.","poem":1},{"text":"Benden nedensiz yere nefret edenler çoktur.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"İyiliğe karşılık kötülük yapanlar bana karşıdırlar,","poem":1},{"text":"çünkü ben iyilik peşindeyim.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Beni bırakma, ey Yahve!","poem":1},{"text":"Ey Tanrım, benden uzak durma.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tez yardım et bana,","poem":1},{"text":"ey Efendim, kurtuluşum benim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}