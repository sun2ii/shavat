{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["Müzik Şefi Yedutun için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Şöyle dedim: “Dilimle günah işlemeyeyim diye","poem":1},{"text":"yollarıma dikkat edeceğim.","poem":2},{"lineBreak":true},{"text":"Kötü kişi karşımdayken,","poem":2},{"lineBreak":true},{"text":"ağzıma gem vuracağım.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dilimi tutup sessiz kaldım.","poem":1},{"text":"İyilik için bile sustum.","poem":2},{"lineBreak":true},{"text":"Acım katlandı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yüreğim yandı içimde.","poem":1},{"text":"Derin derin düşünürken ateş alevlendi.","poem":2},{"lineBreak":true},{"text":"Dilimle dedim:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ey Yahve, bana sonumu göster,","poem":1},{"text":"günlerimin ölçüsü nedir?","poem":2},{"lineBreak":true},{"text":"Ne kadar kırılgan olduğumu bana bildir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İşte günlerimi bir karış kıldın.","poem":1},{"text":"Ömrüm senin önünde bir hiç gibidir.","poem":2},{"lineBreak":true},{"text":"Besbelli herkes bir soluktur.” Selah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Her insan kuşkusuz gölge gibi dolaşır.","poem":1},{"text":"Gerçekten boş yere didinir durur.","poem":2},{"lineBreak":true},{"text":"Yığar ama onu kimin toplayacağını bilmez.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Şimdi, ey Efendim, ben neyi bekliyorum?","poem":1},{"text":"Umudum sende.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Beni bütün suçlarımdan kurtar.","poem":1},{"text":"Akılsızların beni ayıplamasına izin verme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sustum,","poem":1},{"text":"ağzımı açmadım.","poem":2},{"lineBreak":true},{"text":"Çünkü sen bunu yaptın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kamçını benden uzaklaştır.","poem":1},{"text":"Elinin vuruşuyla mahvoldum.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İnsanı suçundan ötürü","poem":1},{"text":"azarlayıp yola getirdiğinde,","poem":2},{"lineBreak":true},{"text":"servetini güve gibi tüketirsin.","poem":2},{"lineBreak":true},{"text":"Kesinlikle her insan yalnızca bir soluktur.” Selah.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Duamı işit, ey Yahve, feryadıma kulak ver.","poem":1},{"text":"Gözyaşlarıma sessiz kalma.","poem":2},{"lineBreak":true},{"text":"Çünkü senin yanında ben bir garibim.","poem":2},{"lineBreak":true},{"text":"Bütün atalarım gibi bir yabancı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Beni esirge de gücüme kavuşayım,","poem":1},{"text":"göçüp yok olmadan önce.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}