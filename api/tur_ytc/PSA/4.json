{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Seslenince yanıtla beni, doğruluğumun Tanrısı!","poem":1},{"text":"Beni sıkıntımdan kurtar.","poem":2},{"lineBreak":true},{"text":"Bana merhamet et ve duamı duy.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ey insanoğulları, ne zamana dek yüceliğim utanca çevrilecek?","poem":1},{"text":"Boş şeyleri sevip yalanın peşinden mi gideceksiniz? Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama Yahve’nin tanrısal olanı kendine ayırdığını bilin.","poem":1},{"text":"Kendisine seslenince Yahve beni duyar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Titreyin ve günah işlemeyin.","poem":1},{"text":"Yatağınızda yüreğinizi yoklayın ve sakin olun. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Doğruluk kurbanları sunun.","poem":1},{"text":"Yahve’ye güvenin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Bize kim iyilik gösterecek?” diyenler çoktur.","poem":1},{"text":"Yüzünün ışığı üzerimizde parlasın, ey Yahve.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yüreğime verdiğin sevinç,","poem":1},{"text":"onların tahıllarının ve yeni şaraplarının çoğaldığı zamankinden fazladır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Esenlik içinde hem yatar, hem uyurum.","poem":1},{"text":"Çünkü yalnız sen, ey Yahve,","poem":2},{"lineBreak":true},{"text":"güvenlik içinde yaşatırsın beni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}