{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve’yi sabırla bekledim.","poem":1},{"text":"Bana döndü ve feryadımı duydu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beni korkunç bir çukurdan, balçıktan çıkardı,","poem":1},{"text":"ayaklarımı bir kaya üzerinde durdurdu.","poem":2},{"lineBreak":true},{"text":"Ayakta durabileceğim sağlam bir yer verdi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ağzıma yeni bir ezgi,","poem":1},{"text":"Tanrımız’a bir övgü ilahisi koydu.","poem":2},{"lineBreak":true},{"text":"Birçokları bunu görüp korkacak,","poem":2},{"lineBreak":true},{"text":"ve Yahve’ye güvenecekler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mutlu Yahve’ye güvenen insana,","poem":1},{"text":"kibirlilere, yalana sapanlara saygı duymayana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Yahve, Tanrım, yaptığın harikalar,","poem":1},{"text":"bize yönelik düşüncelerin ne çoktur.","poem":2},{"lineBreak":true},{"text":"Onlar sana geri bildirilemezler.","poem":2},{"lineBreak":true},{"text":"İlan edip anlatmak istesem,","poem":2},{"lineBreak":true},{"text":"sayılamayacak kadar çoktur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kurban ve sunuyu istemedin.","poem":1},{"text":"Kulaklarımı açtın.","poem":2},{"lineBreak":true},{"text":"Yakmalık sunu ve günah sunusunu da istemedin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O zaman şöyle dedim: “İşte geldim.","poem":1},{"text":"Kutsal Yazı tomarında benim için yazılmıştır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İsteğini yerine getirmekten zevk alırım, ey Tanrım.","poem":1},{"text":"Yasan yüreğimin içindedir.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Büyük toplulukta doğruluk müjdesini ilan ettim.","poem":1},{"text":"İşte, dudaklarımı mühürlemeyeceğim,","poem":2},{"lineBreak":true},{"text":"ey Yahve, sen bilirsin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Doğruluğunu yüreğimin içinde saklamadım.","poem":1},{"text":"Sadakatini ve kurtuluşunu ilan ettim.","poem":2},{"lineBreak":true},{"text":"Sevgi dolu iyiliğini ve gerçeğini büyük topluluktan gizlemedim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sevecen merhametlerini benden esirgeme, ey Yahve.","poem":1},{"text":"Sevgi dolu iyiliğin ve gerçeğin beni hep korusun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü sayısız kötülük çevremi sardı.","poem":1},{"text":"Suçlarım beni ele geçirdi, artık başımı kaldıramıyorum.","poem":2},{"lineBreak":true},{"text":"Onlar başımdaki saçlardan daha çoktur.","poem":2},{"lineBreak":true},{"text":"Yüreğim beni bıraktı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ey Yahve, beni kurtarmaya razı ol.","poem":1},{"text":"Ey Yahve, tez yardımıma koş.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Canımı almanın yolunu arayanlar,","poem":1},{"text":"hepsi hayal kırıklığına uğrayıp utansınlar.","poem":2},{"lineBreak":true},{"text":"Acı çekmemden zevk duyanlar,","poem":2},{"lineBreak":true},{"text":"geri dönüp rezil olsunlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bana, “Oh! Oh” çekenler","poem":1},{"text":"utançlarından perişan olsunlar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Seni arayanların hepsi","poem":1},{"text":"sende sevinip coşsunlar.","poem":2},{"lineBreak":true},{"text":"Kurtarışını sevenler sürekli şöyle söylesin: “Yahve yücelsin!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ama ben yoksul ve muhtacım.","poem":1},{"text":"Efendim beni düşünsün.","poem":2},{"lineBreak":true},{"text":"Sen benim yardımcım ve kurtarıcımsın.","poem":2},{"lineBreak":true},{"text":"Gecikme, ey Tanrım.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}