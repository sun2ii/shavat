{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için- David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ne mutlu yoksulu düşünen insana.","poem":1},{"text":"Yahve kurtarır onu kötü günde.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve onu korur ve yaşatır.","poem":1},{"text":"Yeryüzünde onu kutsar.","poem":2},{"lineBreak":true},{"text":"Onu düşmanlarının keyfine bırakmaz.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahve hasta yatağında ona destek olur,","poem":1},{"text":"hastalık yatağından kaldırır onu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ey Yahve, bana merhamet et!” dedim.","poem":1},{"text":"“Beni iyileştir, çünkü sana karşı günah işledim.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Düşmanlarım bana karşı kötülük konuşuyor:","poem":1},{"text":"“Ne zaman ölecek ve adı yok olacak?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eğer biri beni görmeye gelirse yalan konuşuyor.","poem":1},{"text":"Yüreği kendine kötülük biriktiriyor.","poem":2},{"lineBreak":true},{"text":"Dışarı çıktığında bunu söylüyor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Benden nefret edenlerin hepsi bana karşı fısıldaşıyor.","poem":1},{"text":"Benim için en kötüsünü düşünüyorlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Kötü bir hastalık bulaştı ona” diyorlar.","poem":1},{"text":"“İşte yattı, bir daha kalkamaz.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ekmeğimi yiyen,","poem":1},{"text":"güvendiğim yakın dostum bile,","poem":2},{"lineBreak":true},{"text":"bana karşı topuklarını kaldırdı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama sen, ey Yahve, bana merhamet et,","poem":1},{"text":"beni kaldır ki, onlara karşılığını vereyim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bununla benden hoşnut olduğunu bileceğim.","poem":1},{"text":"Çünkü düşmanım bana galip gelemeyecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bana gelince, dürüstlüğümde bana destek olur,","poem":1},{"text":"sonsuza dek beni huzurunda durdurursun.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İsrael'in Tanrısı Yahve'ye öncesizlikten sonsuza dek,","poem":1},{"text":"övgüler olsun!","poem":2},{"lineBreak":true},{"text":"Amin ve amin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}