{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Korahoğulları’nın Maskili"]},{"type":"verse","number":1,"content":[{"text":"Geyiğin akarsuları özlediği gibi,","poem":1},{"text":"canım da seni öyle özler, ey Tanrı.","poem":2},{"noteId":16}]},{"type":"verse","number":2,"content":[{"text":"Canım Tanrı'ya, yaşayan Tanrı'ya susadı.","poem":1},{"text":"Ne zaman gelip Tanrı'nın önünde görüneceğim?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gözyaşlarım gece gündüz yemeğim oldu,","poem":1},{"text":"bana sürekli “Tanrın nerede?” diye soruyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Şunları hatırlıyor, canımı içime döküyorum;","poem":1},{"text":"sevinç ve övgü sesiyle nasıl gider,","poem":2},{"lineBreak":true},{"text":"Kutsal Günü kutlayan toplulukla birlikte,","poem":2},{"lineBreak":true},{"text":"onları Tanrı'nın evine nasıl götürürdüm.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neden umutsuzsun, ey canım?","poem":1},{"text":"Neden içim huzursuz?","poem":2},{"lineBreak":true},{"text":"Tanrı’ya umut bağla!","poem":2},{"lineBreak":true},{"text":"Çünkü kurtaran varlığınla yardımcım olduğun için","poem":2},{"lineBreak":true},{"text":"O’nu yine de öveceğim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey Tanrım, canım iç varlığımda umutsuzluk içinde.","poem":1},{"text":"Bu yüzden Yarden diyarından,","poem":2},{"lineBreak":true},{"text":"Hermon dağlarından, Misar Tepesi’nden seni hatırlıyorum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çağlayanların ses çıkarınca derin derinliğe sesleniyor.","poem":1},{"text":"Bütün dalgaların ve sellerin üzerimden geçti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve","poem":1},{"noteId":17},{"text":"gündüz vakti","poem":1},{"text":"sevgi dolu iyiliğini buyurur.","poem":2},{"lineBreak":true},{"text":"Gece vakti O’nun ezgisi,","poem":2},{"lineBreak":true},{"text":"yaşamımın Tanrısı’na dua benimledir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kayam olan Tanrı'ya diyeceğim: “Beni neden unuttun?","poem":1},{"text":"Düşmanın zulmü yüzünden neden yas tutuyorum?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Düşmanlarım kemiklerime saplanmış bir kılıç gibi,","poem":1},{"text":"hakaret ediyorlar,","poem":2},{"lineBreak":true},{"text":"bana sürekli “Tanrın nerede?” diye soruyorlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neden umutsuzsun, ey canım?","poem":1},{"text":"Neden içim huzursuz?","poem":2},{"lineBreak":true},{"text":"Tanrı’ya umut bağla! Çünkü yine de O’nu öveceğim,","poem":2},{"lineBreak":true},{"text":"yüzümün kurtuluşu ve Tanrım O’dur.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":42,"verse":1}},{"noteId":17,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":42,"verse":8}}]},"thisChapterLink":"/api/tur_ytc/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}