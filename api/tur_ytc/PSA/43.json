{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Davamı gör, ey Tanrım,","poem":1},{"text":"tanrısız ulusa karşı davamı savun.","poem":2},{"lineBreak":true},{"text":"Beni hileci ve kötü insanlardan kurtar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü sen benim gücümün Tanrısı’sın.","poem":1},{"text":"Beni neden reddettin?","poem":2},{"lineBreak":true},{"text":"Düşmanın zulmünden ötürü neden yas tutayım?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Işığını ve gerçeğini gönder.","poem":1},{"text":"Bana yol göstersinler.","poem":2},{"lineBreak":true},{"text":"Beni kutsal dağına, çadırına götürsünler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O zaman Tanrı'nın sunağına,","poem":1},{"text":"büyük sevincim olan Tanrım'a gideceğim.","poem":2},{"lineBreak":true},{"text":"Seni arpla öveceğim, Tanrım, Tanrım benim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neden umutsuzluk içindesin, ey canım?","poem":1},{"text":"Neden içim huzursuz?","poem":2},{"lineBreak":true},{"text":"Tanrı’ya umut bağla!","poem":2},{"lineBreak":true},{"text":"Çünkü yine O’nu öveceğim.","poem":2},{"lineBreak":true},{"text":"Kurtarıcım, yardımcım, Tanrım benim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}