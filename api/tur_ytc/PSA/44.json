{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Korahoğulları’nın Maskili"]},{"type":"verse","number":1,"content":[{"text":"Kulaklarımızla duyduk, ey Tanrı,","poem":1},{"text":"atalarımız onların günlerinde, eski günlerde,","poem":2},{"lineBreak":true},{"text":"yaptığın işi bize anlattı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ulusları elinle kovdun,","poem":1},{"text":"ama onları diktin.","poem":2},{"lineBreak":true},{"text":"Halkları kırdın,","poem":2},{"lineBreak":true},{"text":"ama onları yaydın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü ülkeyi kendi kılıçlarıyla mülk edinmediler,","poem":1},{"text":"onları kurtaran kendi kolları da değildi.","poem":2},{"lineBreak":true},{"text":"Ancak senin sağ elin, kolun ve yüzünün ışığıydı.","poem":2},{"lineBreak":true},{"text":"Çünkü sen onları kayırdın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey Tanrı, sensin benim Kralım.","poem":1},{"text":"Yakov için zaferleri buyur!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senin sayende düşmanlarımızı devireceğiz.","poem":1},{"text":"Bize karşı ayaklananları senin adınla ezeceğiz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü ben yayıma güvenmem,","poem":1},{"text":"kılıcım da beni kurtarmaz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama sensin bizi düşmanlarımızdan kurtaran,","poem":1},{"text":"bizden nefret edenleri utandıran.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bütün gün Tanrı'yla övünürüz.","poem":1},{"text":"Adına daima şükrederiz. Selah.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ama şimdi sen bizi reddettin ve bizi utandırdın,","poem":1},{"text":"ordularımızla yola çıkmıyorsun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bizi düşmanın önünde geri döndürüyorsun.","poem":1},{"text":"Bizden nefret edenler kendileri için yağma topluyorlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bizi yenilecek koyun gibi ettin,","poem":1},{"text":"bizi ulusların arasına dağıttın.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Halkını bedavaya sattın,","poem":1},{"text":"satışından da hiçbir şey kazanmadın.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bizi komşularımıza yüzkarası,","poem":1},{"text":"çevremizdekiler için eğlence ve alay konusu ettin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Halklar arasında baş sallansın diye,","poem":1},{"text":"bizi ulusların diline düşürdün.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Rezilliğim gün boyu gözümün önünde,","poem":1},{"text":"utanç yüzümü kaplıyor,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"hakaret ve sövgüde bulunanın alayıyla,","poem":1},{"text":"düşmanın ve intikamcının yüzünden.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bütün bunlar başımıza geldi,","poem":1},{"text":"yine de seni unutmadık.","poem":2},{"lineBreak":true},{"text":"Antlaşmana ihanet etmedik.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yüreğimiz geriye dönmedi,","poem":1},{"text":"adımlarımız da senin yolundan sapmadı,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"oysa sen bizi çakalların yerinde ezdin,","poem":1},{"text":"Üstümüzü ölümün gölgesiyle örttün.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Eğer Tanrımız'ın adını unuttuysak,","poem":1},{"text":"ya da ellerimizi yabancı bir ilâha uzattıysak,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tanrı bunu araştırmaz mıydı?","poem":1},{"text":"Çünkü O, yürekteki gizleri bilir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Evet, senin uğruna bütün gün öldürülüyoruz.","poem":1},{"text":"Kasaplık koyunlar gibi görülüyoruz.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Uyan!","poem":1},{"text":"Neden uyuyorsun ey Efendim?","poem":2},{"noteId":18},{"lineBreak":true},{"text":"Kalk!","poem":2},{"lineBreak":true},{"text":"Bizi sonsuza dek reddetme.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neden yüzünü gizliyorsun?","poem":1},{"text":"Çektiğimiz acıyı, üzerimizdeki baskıyı unutacak mısın?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Çünkü canımız toprağa kadar eğildi.","poem":1},{"text":"Bedenimiz toprağa yapıştı.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kalk, yardım et bize.","poem":1},{"text":"Sevgi dolu iyiliğin uğruna bizi kurtar.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":44,"verse":23}}]},"thisChapterLink":"/api/tur_ytc/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}