{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Zambaklar” makamında Korahoğulları’nın Maskili - Bir düğün ilahisi"]},{"type":"verse","number":1,"content":[{"text":"Yüreğim asil bir temayla dolup taşıyor.","poem":1},{"text":"Kral için okuyorum şiirlerimi.","poem":2},{"lineBreak":true},{"text":"Dilim usta bir yazarın kalemi gibidir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sen insanoğullarının en harikasısın.","poem":1},{"text":"Dudakların lütufla meshedilmiş.","poem":2},{"lineBreak":true},{"text":"Bunun için Tanrı seni sonsuza dek kutsamış.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey kudretli, kılıcını beline,","poem":1},{"text":"ihtişamını ve heybetini kuşan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gerçek, alçakgönüllülük ve doğruluk uğruna,","poem":1},{"text":"heybetinle zaferle ilerle.","poem":2},{"lineBreak":true},{"text":"Sağ elin harika işler sergilesin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Okların sivridir.","poem":1},{"text":"Kral düşmanlarının yüreğine saplanır,","poem":2},{"lineBreak":true},{"text":"uluslar altında yıkılır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tahtın sonsuza dek kalıcıdır, ey Tanrı.","poem":1},{"text":"Krallığının asası adalet asasıdır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Doğruluğu sevdin ve kötülükten nefret ettin.","poem":1},{"text":"Bunun için Tanrı, senin Tanrın,","poem":2},{"lineBreak":true},{"text":"seni akranlarından daha çok sevinç yağıyla meshetti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bütün giysilerin mür, öd ve tarçın kokar.","poem":1},{"text":"Fildişi saraylardan telli çalgılar seni sevindirir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kral kızları senin saygın kadınların arasındadır.","poem":1},{"text":"Kraliçe, Ofir altınları içinde senin sağında duruyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dinle kızım, düşün ve kulak ver.","poem":1},{"text":"Halkını, babanın evini de unut.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Böylece Kral senin güzelliğini arzulayacak,","poem":1},{"text":"saygı duy O'na, çünkü efendin O'dur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sur kızı bir hediyeyle geliyor.","poem":1},{"text":"Halkın zenginleri senin lütfunu dileyecekler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tüm ihtişamıyla kral kızı içerdedir.","poem":1},{"text":"Giysileri altınla dokunmuştur.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İşlemeli giysiler içinde kralın huzuruna çıkarılacak.","poem":1},{"text":"Onu takip eden arkadaşları, el değmemiş kızlar sana getirilecek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sevinç ve coşkuyla götürülecekler.","poem":1},{"text":"Kralın sarayına girecekler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oğulların atalarının yerini alacak.","poem":1},{"text":"Onları bütün dünyaya beyler yapacaksın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Adını kuşaklar boyu anımsatacağım.","poem":1},{"text":"Bunun için halklar daima sana şükredecekler.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}