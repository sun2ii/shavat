{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Alamot",{"noteId":19},"- Korahoğulları ezgisi"]},{"type":"verse","number":1,"content":[{"text":"Tanrı sığınağımız ve gücümüzdür,","poem":1},{"text":"sıkıntıda hemen yardıma hazırdır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bu nedenle, dünya altüst olsa,","poem":1},{"text":"dağlar denizlerin bağrına yıkılsa,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"suları kükreyip çalkalansa,","poem":1},{"text":"kabaran deniz dağları titretse bile,","poem":2},{"lineBreak":true},{"text":"biz korkmayız. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bir ırmak var ki,","poem":1},{"text":"suları Tanrı kentini,","poem":2},{"text":"Yüceler Yücesi'nin kutsal çadırlarını sevindirir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tanrı onun ortasındadır. Sarsılmaz o.","poem":1},{"text":"Gün doğarken Tanrı ona yardım eder.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uluslar hiddetlendi. Krallıklar sarsıldı.","poem":1},{"text":"O sesini yükseltince dünya eriyip gitti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ordular Yahvesi bizimledir.","poem":1},{"text":"Yakov’un Tanrısı bizim sığınağımızdır. Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gelin, Yahve’nin işlerini görün,","poem":1},{"text":"yeryüzünde ne büyük yıkımlar yaptı.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dünyanın ucuna kadar savaşları durdurur.","poem":1},{"text":"Yayı kırar, mızrağı parçalar.","poem":2},{"lineBreak":true},{"text":"Savaş arabalarını ateşte yakar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Sakin olun, bilin ki, Tanrı benim!","poem":1},{"text":"Uluslar arasında yüceleceğim.","poem":2},{"lineBreak":true},{"text":"Yeryüzünde yüceleceğim.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ordular Yahvesi bizimledir.","poem":1},{"text":"Yakov’un Tanrısı bizim sığınağımızdır. Selah.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"Alamot bir müzik terimidir.","reference":{"chapter":46,"verse":0}}]},"thisChapterLink":"/api/tur_ytc/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}