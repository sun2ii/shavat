{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Korahoğulları’nın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey bütün uluslar, el çırpın.","poem":1},{"text":"Zafer sesiyle Tanrı'ya sesinizi yükseltin!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü Yüce Yahve muhteşemdir.","poem":1},{"text":"O, tüm dünyanın üzerinde büyük Kral’dır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulusları altımıza,","poem":1},{"text":"halkları ayaklarımızın altına serdi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sevdiği Yakov’un yüceliği olan mirasımızı,","poem":1},{"text":"O bizim için seçti. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tanrı yüksek sesle,","poem":1},{"text":"Yahve boru sesiyle yükseldi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tanrı'yı ezgilerle övün! Övün!","poem":1},{"text":"Kralımız’ı ezgilerle övün! Övün!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü Tanrı tüm dünyanın Kralı’dır.","poem":1},{"text":"Anlayışla övün.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tanrı ulusların üzerinden hüküm sürer.","poem":1},{"text":"Tanrı kutsal tahtında oturur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Avraham’ın Tanrısı’na halk olmak üzere,","poem":1},{"text":"halkların beyleri bir araya toplandılar.","poem":2},{"lineBreak":true},{"text":"Çünkü yeryüzünün kalkanları Tanrı’ya aittir.","poem":2},{"lineBreak":true},{"text":"O çok yücedir!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}