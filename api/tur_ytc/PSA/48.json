{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["İlahi - Korahoğulları’nın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yahve büyüktür, Tanrımız’ın kentinde,","poem":1},{"text":"kutsal dağında övülmeye çok lâyıktır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yüksekliği güzel, tüm dünyanın sevinci,","poem":1},{"text":"kuzey taraflarındaki Siyon Dağı,","poem":2},{"lineBreak":true},{"text":"Büyük Kral’ın kenti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tanrı onun kalelerinde kendini sığınak olarak gösterdi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Çünkü işte, krallar toplandılar,","poem":1},{"text":"birlikte geçtiler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onu görünce hayrete düştüler.","poem":1},{"text":"Dehşet içinde","poem":2},{"lineBreak":true},{"text":"aceleyle kaçıştılar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğum sancısı çeken bir kadın gibi,","poem":1},{"text":"orada onları bir titreme aldı.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Doğu rüzgârıyla Tarşiş'in gemilerini parçalarsın.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nasıl duyduysak öyle gördük,","poem":1},{"text":"Ordular Yahvesi'nin kentinde, Tanrımız’ın kentinde.","poem":2},{"text":"Tanrı onu sonsuza dek pekiştirecektir. Selah.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ey Tanrı, tapınağının ortasında,","poem":1},{"text":"senin sevgi dolu iyiliğini düşündük.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Adın gibi, ey Tanrı,","poem":1},{"text":"övgün de yeryüzünün dört bir bucağına kadar öyledir.","poem":2},{"lineBreak":true},{"text":"Sağ elin doğrulukla doludur.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siyon Dağı sevinsin!","poem":1},{"text":"Yahuda kızları senin hükümlerinden ötürü coşsunlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Siyon'un çevresinde gezin, etrafını dolanın.","poem":1},{"text":"Kulelerini sayın.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Surlarına dikkatle bakın.","poem":1},{"text":"Saraylarını düşünün ki,","poem":2},{"lineBreak":true},{"text":"gelecek kuşağa anlatasınız.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü bu Tanrı sonsuza dek bizim Tanrımız’dır.","poem":1},{"text":"Ölüme dek O bize yol gösterecektir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}