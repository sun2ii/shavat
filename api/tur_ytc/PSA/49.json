{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Korahoğulları’nın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey bütün halklar, şunu işitin,","poem":1},{"text":"ey bütün dünya sakinleri,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"hem aşağıdakiler hem yüksektekiler,","poem":1},{"text":"zengin ve yoksul birlikte dinleyin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ağzım bilgelik sözleri konuşacak.","poem":1},{"text":"Yüreğim anlayış dile getirecek.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Özdeyişe kulak vereceğim.","poem":1},{"text":"Bilmecemi arpla çözeceğim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötü günlerde neden korkayım ki,","poem":1},{"text":"alçakların kötülüğü beni kuşattığında?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mallarına güveniyorlar,","poem":1},{"text":"zenginliklerinin çokluğuyla övünüyorlar;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"onların hiçbiri kardeşini kurtaramaz,","poem":1},{"text":"Tanrı’ya onun için fidye veremez.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü canlarının kurtuluşu pahalıdır,","poem":1},{"text":"hiçbir şey bedelini karşılayamaz.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yoksa sonsuza dek yaşar insan,","poem":1},{"text":"çürüme yüzü görmezdi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü insan bilgelerin öldüğünü görür;","poem":1},{"text":"budala ve akılsız da aynı şekilde yok olur,","poem":2},{"lineBreak":true},{"text":"mallarını başkalarına bırakırlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"İçlerindeki düşünce,","poem":1},{"text":"meskenlerinin tüm kuşaklar boyunca,","poem":2},{"lineBreak":true},{"text":"evlerinin daima kalacağıdır.","poem":2},{"lineBreak":true},{"text":"Topraklarına kendi adlarını verirler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama insan zenginliğine rağmen dayanamaz.","poem":1},{"text":"Yok olup giden hayvanlara benzer.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akılsızların,","poem":1},{"text":"ve onların dediklerini onaylayanların varacakları yer budur. Selah.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onlar Şeol'e","poem":1},{"noteId":20},{"text":"atanmış sürüye benzer.","poem":1},{"text":"Ölüm onlara çobanlık edecektir.","poem":2},{"lineBreak":true},{"text":"Doğrular sabahleyin onlara hâkim olacak.","poem":2},{"lineBreak":true},{"text":"Konutlarından çok uzakta,","poem":2},{"lineBreak":true},{"text":"güzellikleri Şeol'de","poem":2},{"noteId":21},{"text":"çürüyecektir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ama Tanrı canımı Şeol'ün","poem":1},{"noteId":22},{"text":"ölüler elinden kurtaracak.","poem":1},{"text":"Çünkü beni kabul edecektir. Selah.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bir adam zengin olursa,","poem":1},{"text":"evinin görkemi artarsa korkma.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü öldüğünde yanında hiçbir şey götüremez.","poem":1},{"text":"Görkemi onun ardınca inmez.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gerçi yaşarken canını kutsadıysa da—","poem":1},{"text":"kendin için iyilik ettiğinde insanlar seni överler—","poem":2}]},{"type":"verse","number":19,"content":[{"text":"atalarının nesline gidecektir.","poem":1},{"text":"Işığı bir daha göremeyecekler.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anlayıştan yoksun zenginlik sahibi olan insan,","poem":1},{"text":"yok olup giden hayvanlara benzer.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":49,"verse":14}},{"noteId":21,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":49,"verse":14}},{"noteId":22,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":49,"verse":15}}]},"thisChapterLink":"/api/tur_ytc/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}