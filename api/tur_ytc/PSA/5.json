{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Telli sazlarla - David'in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Sözlerime kulak ver, ey Yahve.","poem":1},{"text":"İçine daldığım düşünceleri gör.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Feryadıma kulak ver, ey Kralım ve Tanrım;","poem":1},{"text":"çünkü sana dua ediyorum.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sabahları sesimi işiteceksin, ey Yahve,","poem":1},{"text":"sabahları dileklerimi önüne serip umutla bekleyeceğim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü sen kötülükten hoşlanan bir Tanrı değilsin.","poem":1},{"text":"Kötülük seninle yaşayamaz.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kibirliler önünde duramaz.","poem":1},{"text":"Kötülüğün tüm işçilerinden nefret edersin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yalan söyleyenleri yok edersin.","poem":1},{"text":"Yahve kana susamış ve düzenbaz adamdan nefret eder.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bense senin sevgi dolu iyiliğinin bolluğuyla evine gireceğim.","poem":1},{"text":"Sana saygıyla kutsal tapınağına doğru eğileceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey Yahve, düşmanlarıma karşı doğruluğunla bana yol göster.","poem":1},{"text":"Yolunu önümde düzle.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü ağızlarında sadakat yoktur.","poem":1},{"text":"Yürekleri yıkımdır.","poem":2},{"lineBreak":true},{"text":"Boğazları açık bir mezar.","poem":2},{"lineBreak":true},{"text":"Dilleriyle yaltaklanırlar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onları suçlu çıkar, ey Tanrım!","poem":1},{"text":"Kendi öğütleriyle düşsünler.","poem":2},{"lineBreak":true},{"text":"İsyanlarının çokluğunda onları kov,","poem":2},{"lineBreak":true},{"text":"çünkü sana karşı isyan ettiler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ama sana sığınanların hepsi sevinsinler.","poem":1},{"text":"Her zaman sevinç çığlıkları atsınlar, çünkü onları savunan sensin.","poem":2},{"lineBreak":true},{"text":"Adını sevenler de sende sevinçle coşsunlar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü sen doğru kişiyi kutsayacaksın, ey Yahve","poem":1},{"text":"çevresini kalkan gibi lütfunla saracaksın.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}