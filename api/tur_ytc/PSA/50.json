{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Kudretli Olan Tanrı, Yahve konuşuyor,","poem":1},{"text":"gün doğumundan gün batımına kadar yeryüzüne sesleniyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Güzelliğin kusursuzluğu Siyon'dan,","poem":1},{"text":"Tanrı parlıyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tanrımız geliyor ve susmuyor.","poem":1},{"text":"Önününde ateş yiyip bitiriyor.","poem":2},{"lineBreak":true},{"text":"Çevresi şiddetli fırtınayla kaplı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yukarıdaki göklere sesleniyor,","poem":1},{"text":"halkını yargılamak için yeryüzüne:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Benimle kurban sunarak antlaşma yapan,","poem":1},{"text":"kutsallarımı yanıma toplayın.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gökler O’nun doğruluğunu ilan edecek,","poem":1},{"text":"çünkü yargıç Tanrı'nın kendisidir. Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ey halkım, dinle de konuşayım.","poem":1},{"text":"Ey İsrael, sana karşı tanıklık edeyim.","poem":2},{"lineBreak":true},{"text":"Ben Tanrı'yım, senin Tanrın’ım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kurbanlarından ötürü seni azarlamıyorum.","poem":1},{"text":"Yakmalık sunuların sürekli önümde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne ahırından bir boğaya,","poem":1},{"text":"ne de ağıllarından tekelere ihtiyacım var.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü tüm orman hayvanları,","poem":1},{"text":"binlerce dağlardaki sığırlar benimdir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dağların bütün kuşlarını bilirim.","poem":1},{"text":"Kırdaki yabani hayvanlar benimdir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aç olsam sana söylemezdim,","poem":1},{"text":"çünkü dünya ve içindeki her şey benimdir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ben boğa eti yer miyim?","poem":1},{"text":"Ya da keçilerin kanını içer miyim?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tanrı'ya şükran kurbanı sun.","poem":1},{"text":"Yüceler Yücesi’ne adaklarını öde.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sıkıntılı gününde beni çağır.","poem":1},{"text":"Seni kurtarırım ve sen de beni yüceltirsin.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ama kötüye Tanrı şöyle diyor:","poem":1},{"text":"“Kurallarımı ilan etmeye,","poem":2},{"lineBreak":true},{"text":"antlaşmamı ağzına almaya ne hakkın var?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yola getirilmekten nefret ettiğin için,","poem":1},{"text":"sözlerimi arkana mı atacaksın?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bir hırsız görünce ona uyuyor,","poem":1},{"text":"zina edenlerle bir oluyorsun.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Kötülüğe ağzını veriyorsun","poem":1},{"text":"dilinle hile uyduruyorsun.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oturup kardeşinin aleyhinde konuşuyor,","poem":1},{"text":"kendi annenin oğluna iftira ediyorsun.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sen bunları yaptın, bense sustum.","poem":1},{"text":"Beni de tıpkı kendin gibi mi sandın.","poem":2},{"lineBreak":true},{"text":"Seni azarlıyor, gözlerinin önünde seni suçluyorum.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Ey siz Tanrı’yı unutanlar, şimdi şunu iyi tartın,","poem":1},{"text":"yoksa sizi parçalarım, kurtaran kimse olmaz.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kim şükran kurbanını sunarsa beni yüceltir;","poem":1},{"text":"kendisine Tanrı’nın kurtuluşunu göstermem için yolunu hazırlamış olur.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}