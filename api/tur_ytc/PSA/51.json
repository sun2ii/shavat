{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için. Bat-Şeva’nın yanına girdikten sonra Peygamber Natan ona geldiği zaman, David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrım, sevgi dolu iyiliğin uyarınca merhamet et bana.","poem":1},{"text":"Sevecen merhametinin bolluğuna göre sil isyanlarımı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beni suçumdan büsbütün yıka.","poem":1},{"text":"Beni günahımdan temizle.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü isyanlarımı biliyorum.","poem":1},{"text":"Günahım sürekli karşımda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sana karşı ve yalnızca sana karşı günah işledim,","poem":1},{"text":"senin gözünde kötü olanı yaptım,","poem":2},{"lineBreak":true},{"text":"bunun için söylediklerinde haklı,","poem":2},{"lineBreak":true},{"text":"yargılarında adilsin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İşte, ben suç içinde doğdum.","poem":1},{"text":"Annem günah içinde bana hamile kaldı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"İşte, sen yürekten gerçeği istiyorsun.","poem":1},{"text":"Bilgelik öğret bana en derinliklerimde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Beni mercanköşk otuyla arındır, temiz olayım.","poem":1},{"text":"Yıka beni, kardan beyaz olayım.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sevinç ve coşkuyu duyur bana,","poem":1},{"text":"öyle ki, kırdığın kemikler sevinsin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Günahlarıma karşı yüzünü ört,","poem":1},{"text":"bütün suçlarımı sil.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bende temiz bir yürek yarat, ey Tanrım.","poem":1},{"text":"İçimdeki doğru ruhu tazele.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Beni huzurundan atma,","poem":1},{"text":"ve Kutsal Ruhun’u benden alma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kurtuluş sevincini bana geri ver.","poem":1},{"text":"İstekli bir ruhla bana destek ol.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"O zaman isyan edenlere senin yollarını öğreteceğim.","poem":1},{"text":"Günahkârlar sana geri dönecek.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Beni kan dökme suçundan kurtar,","poem":1},{"text":"ey Tanrı, kurtuluşumun Tanrısı.","poem":2},{"lineBreak":true},{"text":"Dilim senin doğruluğunu yüksek sesle ezgilerle söylesin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ey Efendim, dudaklarımı aç.","poem":1},{"text":"Ağzım senin övgünü ilan etsin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Çünkü sen kurbandan hoşlanmazsın,","poem":1},{"text":"yoksa sunardım sana.","poem":2},{"lineBreak":true},{"text":"Yakmalık sunudan zevk almazsın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanrı'nın kurbanları kırık bir ruhtur.","poem":1},{"text":"Ey Tanrı, sen kırık ve pişman bir yüreği hor görmezsin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Siyon'a iyi arzunla iyilik et.","poem":1},{"text":"Yeruşalem’in surlarını yap.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"O zaman doğruluk kurbanlarından,","poem":1},{"text":"yakmalık sunulardan ve tümüyle yakmalık sunulardan zevk alırsın.","poem":2},{"lineBreak":true},{"text":"O zaman sunağında boğalar sunulur.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}