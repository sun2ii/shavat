{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için David’in Maskili Edomlu Doek gelip Saul’a “David Ahimelek’in evine girdi” diye bildirdiği zaman."]},{"type":"verse","number":1,"content":[{"text":"Neden kötülükle övünürsün, ey zorba?","poem":1},{"text":"Tanrı’nın sevgi dolu iyiliği kalıcıdır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dilin yıkım tasarlar,","poem":1},{"text":"keskin bir ustura gibi hileyle çalışır.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İyilikten çok kötülüğü,","poem":1},{"text":"doğruyu konuşmaktan çok yalanı seversin. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey seni aldatıcı dil,","poem":1},{"text":"yıkıcı her sözü seversin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tanrı da seni sonsuza dek yıkacak.","poem":1},{"text":"Seni alıp çadırından çıkaracak,","poem":2},{"lineBreak":true},{"text":"seni yaşayanlar diyarından kovacak. Selah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Doğru kişi de bunu görüp korkacak,","poem":1},{"text":"ve ona gülüp şöyle diyecek:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“İşte, Tanrı'yı kendine kuvvet edinmeyen,","poem":1},{"text":"zenginliğinin bolluğuna güvenen,","poem":2},{"lineBreak":true},{"text":"Kötülüğünde güçlenen adam budur.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama ben Tanrı'nın evindeki yeşil zeytin ağacı gibiyim.","poem":1},{"text":"Sonsuza dek Tanrı'nın sevgi dolu iyiliğine güvenirim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaptıkların için daima sana şükredeceğim.","poem":1},{"text":"Kutsallarının önünde senin adına umut bağlarım,","poem":2},{"lineBreak":true},{"text":"çünkü adın iyidir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}