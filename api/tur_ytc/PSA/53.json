{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Mahalat makamında David’in Maskili"]},{"type":"verse","number":1,"content":[{"text":"Akılsız, yüreğinde “Tanrı yoktur” dedi.","poem":1},{"text":"Yozlaştılar ve iğrenç şeyler yaptılar.","poem":2},{"lineBreak":true},{"text":"İyilik eden kimse yok.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anlayan, Tanrı’yı arayan birinin olup olmadığını görmek için,","poem":1},{"text":"Tanrı gökten insanoğullarına baktı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hepsi geri döndü.","poem":1},{"text":"Birlikte kirlendiler.","poem":2},{"lineBreak":true},{"text":"İyilik eden kimse yok, bir kişi bile.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kötülük edenlerin bilgisi yok mu?","poem":1},{"text":"Halkımı ekmek yer gibi yiyor,","poem":2},{"lineBreak":true},{"text":"Tanrı'yı çağırmıyorlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Korkunun olmadığı yerde çok korktular.","poem":1},{"text":"Çünkü Tanrı sana karşı ordugâh kuranın kemiklerini dağıttı.","poem":2},{"lineBreak":true},{"text":"Onları utandırdın,","poem":2},{"lineBreak":true},{"text":"çünkü Tanrı onları reddetti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Keşke İsrael'in kurtuluşu Siyon'dan gelseydi!","poem":1},{"text":"Tanrı, halkını sürgünden geri getirince,","poem":2},{"lineBreak":true},{"text":"Yakov sevinecek,","poem":2},{"lineBreak":true},{"text":"İsrael coşacak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}