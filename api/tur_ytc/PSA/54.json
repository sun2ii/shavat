{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Telli sazlarla David’in Maskili Zifliler gelip Saul’a: “David aramızda gizleniyor” dedikleri zaman"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, adınla kurtar beni.","poem":1},{"text":"Gücünle beni haklı çıkar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ey Tanrı, duamı duy.","poem":1},{"text":"Ağzımdan çıkan sözlere kulak ver.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü yabancılar bana karşı ayaklandı.","poem":1},{"text":"Zorbalar canımın peşindeler.","poem":2},{"lineBreak":true},{"text":"Tanrı’yı önlerine koymadılar. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İşte, Tanrı benim yardımcımdır.","poem":1},{"text":"Canıma destek olan Efendim’dir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Düşmanlarıma yaptıkları kötülüğün karşılığını verecektir.","poem":1},{"text":"Onları kendi gerçeğinle yok et.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sana gönülden kurban sunacağım.","poem":1},{"text":"Ey Yahve adına şükredeceğim,","poem":2},{"lineBreak":true},{"text":"çünkü adın iyidir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü beni her sıkıntıdan kurtardı.","poem":1},{"text":"Gözüm düşmanlarıma karşı zaferi gördü.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}