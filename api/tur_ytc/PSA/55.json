{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Telli sazlarla David’in Maskili"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, duamı dinle.","poem":1},{"text":"Yalvarışımdan kendini saklama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dikkatini ver, yanıtla beni.","poem":1},{"text":"Sıkıntı ve inilti içinde huzursuzum","poem":2}]},{"type":"verse","number":3,"content":[{"text":"düşmanın sesi, kötünün zulmü yüzünden.","poem":1},{"text":"Çünkü üstüme sıkıntı getiriyorlar.","poem":2},{"lineBreak":true},{"text":"Öfkeyle bana kin besliyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yüreğim sızlıyor içimde.","poem":1},{"text":"Ölüm dehşeti çöktü üzerime.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Üzerime korku ve titreme geldi.","poem":1},{"text":"Dehşet içimi sardı.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Keşke güvercin gibi kanatlarım olsaydı!” dedim.","poem":1},{"text":"Uçup gider, rahatlardım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, o zaman uzaklara gider,","poem":1},{"text":"çölde konaklardım. Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Sert rüzgârdan ve kasırgadan","poem":1},{"text":"hemen sığınağa koşardım.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akıllarını ve dillerini karıştır, ey Efendim,","poem":1},{"text":"çünkü kentte şiddet ve çekişme gördüm.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gece gündüz kent surları üzerinde geziniyorlar.","poem":1},{"text":"Kötülük ve gaddarlık kentin içindedir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yıkıcı güçler onun içindedir.","poem":1},{"text":"Tehdit ve yalanlar sokaklardan çıkmaz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü beni aşağılayan bir düşman değildi,","poem":1},{"text":"yoksa buna katlanabilirdim.","poem":2},{"lineBreak":true},{"text":"Benden nefret eden de bir hasım değildi,","poem":2},{"lineBreak":true},{"text":"yoksa ondan gizlenirdim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ama sendin, benim gibi biri,","poem":1},{"text":"arkadaşım ve yakın dostum.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Birlikte tatlı tatlı dostluk ederdik.","poem":1},{"text":"Toplulukla Tanrı'nın evine yürürdük.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ölüm üzerlerine ansızın gelsin.","poem":1},{"text":"Diri diri Şeol'e","poem":2},{"noteId":23},{"text":"insinler.","poem":2},{"lineBreak":true},{"text":"Çünkü kötülük onların arasında, evlerinin içindedir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bense, Tanrı'ya seslenirim.","poem":1},{"text":"Yahve kurtarır beni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akşam, sabah ve öğle vakti sıkıntı içinde feryat ederim.","poem":1},{"text":"O sesimi duyar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bana karşı yapılan savaştan","poem":1},{"text":"esenlik içinde kurtarır canımı,","poem":2},{"lineBreak":true},{"text":"gerçi bana karşı çıkanlar da çoktur.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sonsuzluktan beri tahtında oturan Tanrı,","poem":1},{"text":"işitecek ve onlara karşılık verecektir. Selah.","poem":2},{"lineBreak":true},{"text":"Onlar asla değişmez,","poem":2},{"lineBreak":true},{"text":"Tanrı’dan da korkmazlar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dostlarına karşı elini kaldırdı,","poem":1},{"text":"yaptığı antlaşmayı bozdu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ağzı tereyağı gibi sakin,","poem":1},{"text":"ama yüreği savaşçıdır.","poem":2},{"lineBreak":true},{"text":"Sözleri yağdan yumuşak,","poem":2},{"lineBreak":true},{"text":"ama onlar yalın kılıçtırlar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yükünü Yahve’ye bırak,","poem":1},{"text":"O sana destek olur.","poem":2},{"lineBreak":true},{"text":"Doğrunun sarsılmasına","poem":2},{"lineBreak":true},{"text":"asla izin vermez.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ama sen, ey Tanrı,","poem":1},{"text":"Onları yıkım çukuruna indireceksin.","poem":2},{"lineBreak":true},{"text":"Kana susamış ve hilekâr adamlar","poem":2},{"lineBreak":true},{"text":"günlerinin yarısını bile yaşayamayacaklar.","poem":2},{"lineBreak":true},{"text":"Bense sana güvenirim.","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":55,"verse":15}}]},"thisChapterLink":"/api/tur_ytc/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}