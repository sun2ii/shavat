{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için “Uzak Yabanıl Fıstık Ağaçlarındaki Güvercin” makamında David’in Miktamı - Gar Kenti’nde Filistliler onu yakaladığı zaman"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı merhamet et bana,","poem":1},{"text":"çünkü insan beni yutmak istiyor.","poem":2},{"lineBreak":true},{"text":"Gün boyu bana saldırıp baskı yapıyor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Düşmanlarım gün boyu beni yutmak istiyorlar,","poem":1},{"text":"çünkü bana karşı gururla savaşanlar çoktur.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Korktuğumda,","poem":1},{"text":"sana güvenirim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tanrı’ya, sözünü överim.","poem":1},{"text":"Tanrı’ya güvenirim, korkmam.","poem":2},{"lineBreak":true},{"text":"İnsan bana ne yapabilir?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gün boyu sözlerimi çarpıtıyorlar.","poem":1},{"text":"Bana karşı bütün düşünceleri kötülük içindir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kötülük için anlaşıp pusuya yatıyorlar,","poem":1},{"text":"adımlarımı izleyip,","poem":2},{"lineBreak":true},{"text":"canımı almaya hevesleniyorlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onlar kötülükle mi kurtulacaklar?","poem":1},{"text":"Ey Tanrı, öfkeyle halkları yere çal.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Avare avare dolaşmalarımı saydın.","poem":1},{"text":"Gözyaşlarımı kabına koydun.","poem":2},{"lineBreak":true},{"text":"Onlar senin kitabında değil mi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Seslendiğim gün düşmanlarım geri çekilecek.","poem":1},{"text":"Biliyorum, Tanrı benden yanadır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanrı’ya, sözünü överim.","poem":1},{"text":"Yahve’ye, sözünü överim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrı'ya güvenirim, korkmam.","poem":1},{"text":"İnsan bana ne yapabilir?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Tanrı, adakların üzerimdedir,","poem":1},{"text":"sana şükran kurbanları sunacağım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü canımı ölümden kurtardın,","poem":1},{"text":"ayaklarımın kaymasına engel oldun,","poem":2},{"lineBreak":true},{"text":"öyle ki, yaşayanların ışığında Tanrı'nın önünde yürüyeyim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}