{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Yok etme” makamında David’in Miktamı Saul’dan kaçıp mağaraya sığındığı zaman"]},{"type":"verse","number":1,"content":[{"text":"Merhamet et bana, ey Tanrı, bana merhamet et,","poem":1},{"text":"çünkü canım sana sığınıyor.","poem":2},{"lineBreak":true},{"text":"Felaket geçene dek","poem":2},{"lineBreak":true},{"text":"kanatlarının gölgesine sığınacağım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yüce Tanrı'ya,","poem":1},{"text":"benim için isteklerimi yerine getiren Tanrı’ya sesleniyorum.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gökten gönderip beni kurtaracak,","poem":1},{"text":"beni kovalayanı azarlayacak. Selah.","poem":2},{"lineBreak":true},{"text":"Tanrı sevgi dolu iyiliğini ve gerçeğini gönderecektir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Canım aslanların arasında.","poem":1},{"text":"Yakıcı insanoğulları arasında yatıyorum,","poem":2},{"lineBreak":true},{"text":"dişleri mızrak ve ok,","poem":2},{"lineBreak":true},{"text":"dilleri keskin bir kılıçtır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Tanrı, göklerin üstünde yücel!","poem":1},{"text":"Yüceliğin tüm yeryüzünü kaplasın!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Adımlarıma ağ kurdular.","poem":1},{"text":"Canım çöktü.","poem":2},{"lineBreak":true},{"text":"Önüme çukur kazdılar.","poem":2},{"lineBreak":true},{"text":"İçine kendileri düştüler. Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yüreğim değişmez, ey Tanrı.","poem":1},{"text":"Yüreğim değişmez.","poem":2},{"lineBreak":true},{"text":"Ezgiler, ilahiler söyleyeceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uyan, ey görkemim! Uyan, ey ut ve arp!","poem":1},{"text":"Şafağı ben uyandırayım.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halkların arasında sana şükredeceğim ey Efendim.","poem":1},{"text":"Uluslar arasında seni ilahilerle öveceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü senin muazzam sevgi dolu iyiliğin göklere,","poem":1},{"text":"gerçeğin gökyüzüne ulaşır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey Tanrı, göklerin üstünde yücel!","poem":1},{"text":"Yüceliğin tüm yeryüzünü kaplasın!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}