{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Yok Etme” makamında David’in Miktamı"]},{"type":"verse","number":1,"content":[{"text":"Ey siz susanlar, gerçekten doğrulukla mı konuşursunuz?","poem":1},{"text":"Ey insanoğulları, kusursuzca mı yargılarsınız?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hayır, yüreğinizde haksızlık tasarlarsınız.","poem":1},{"text":"Yeryüzünü ellerinizin zorbalığıyla ölçersiniz.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kötüler ana rahmindeyken yoldan saparlar.","poem":1},{"text":"Doğdukları andan itibaren dik başlıdırlar,","poem":2},{"lineBreak":true},{"text":"yalan söylerler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onların zehiri yılanın zehiri gibidir,","poem":1},{"text":"kulağını tıkayan sağır bir kobraya benzerler,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"büyücülerin sesine kulak vermez,","poem":1},{"text":"büyücü ne kadar hünerli olursa olsun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey Tanrı, kır onların ağızlarındaki dişleri.","poem":1},{"text":"Sök genç aslanların azı dişlerini, ey Yahve.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akıp giden su gibi yok olup gitsinler.","poem":1},{"text":"Yaylarını gerdiklerinde oklarının ucu kırılsın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eriyip giden salyangoz gibi,","poem":1},{"text":"güneşi görmeden düşük çocuk gibi olsunlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kazanlarınız diken ateşini daha duymadan,","poem":1},{"text":"yeşili de, tutuşmuş olanı da süpürüp atacaktır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Doğru kişi alınan öcü görünce sevinecek.","poem":1},{"text":"Ayaklarını kötünün kanıyla yıkayacak,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"o zaman insanlar şöyle diyecekler:","poem":1},{"text":"“Kuşkusuz doğruların ödülü var.","poem":2},{"lineBreak":true},{"text":"Kuşkusuz yeryüzünü yargılayan bir Tanrı var.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}