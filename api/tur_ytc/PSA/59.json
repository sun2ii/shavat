{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Yok Etme” makamında David’in Miktamı - Saul’un David’i öldürtmek için adam gönderip evini gözetlediği zaman"]},{"type":"verse","number":1,"content":[{"text":"Kurtar beni düşmanlarımdan, ey Tanrım.","poem":1},{"text":"Bana karşı ayaklananlardan beni yükseğe çıkar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kurtar beni kötülüğün işçilerinden.","poem":1},{"text":"Kurtar beni kana susamış insanlardan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü işte, canım için pusuya yatmış bekliyorlar.","poem":1},{"text":"Güçlüler bana karşı toplanıyorlar,","poem":2},{"lineBreak":true},{"text":"itaatsizliğim ya da günahımdan dolayı değil, ey Yahve.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Suç işlemediğim halde bana saldırmaya hazırlanıyorlar.","poem":1},{"text":"Bana yardım etmek için kalk ve bak!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sen, Ordular Tanrısı Yahve, İsrael'in Tanrısı,","poem":1},{"text":"ulusları cezalandırmak için uyan.","poem":2},{"lineBreak":true},{"text":"Bu kötü hainlere merhamet gösterme. Selah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akşamleyin köpekler gibi uluyarak geri dönerler,","poem":1},{"text":"kentte dolaşırlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, ağızlarıyla kusuyorlar.","poem":1},{"text":"Dudaklarında kılıç var,","poem":2},{"lineBreak":true},{"text":"“Bizi kim duyacak ki?” diyorlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama sen, ey Yahve, onlara gülersin.","poem":1},{"text":"Bütün uluslarla eğlenirsin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey Gücüm, sana bakıyorum,","poem":1},{"text":"çünkü Tanrı benim yüksek kulemdir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanrım sevgi dolu iyiliğiyle önümde yürüyecek.","poem":1},{"text":"Tanrı düşmanlarıma zaferle bakmamı sağlayacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Öldürme onları, yoksa halkım unutur.","poem":1},{"text":"Gücünle onları dağıt ve alaşağı et,","poem":2},{"lineBreak":true},{"text":"ey kalkanımız olan Efendi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ağızlarının günahı ve dudaklarının sözleri için,","poem":1},{"text":"ettikleri lanetler ve söyledikleri yalanlar için,","poem":2},{"lineBreak":true},{"text":"kibirleri onları yakalasın.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Öfkeyle tüket onları.","poem":1},{"text":"Tüket onları, yok olsunlar.","poem":2},{"lineBreak":true},{"text":"Bilsinler ki, yeryüzünün sonlarına kadar","poem":2},{"lineBreak":true},{"text":"Yakov’da hüküm süren Tanrı’dır. Selah.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akşam dönsünler.","poem":1},{"text":"Köpek gibi ulusunlar, kentte dolaşsınlar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yiyecek bulmak için bir aşağı bir yukarı gezinsinler,","poem":1},{"text":"doymazlarsa bütün gece bekleyecekler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bense gücüne ezgiler söyleyeceğim.","poem":1},{"text":"Evet, sabahları sevgi dolu iyiliğini yüksek sesle ezgiyle dile getireceğim.","poem":2},{"lineBreak":true},{"text":"Çünkü sen benim yüksek kulem,","poem":2},{"lineBreak":true},{"text":"sıkıntılı günümde sığınağım oldun.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Seni ilahilerle öveceğim, ey gücüm.","poem":1},{"text":"Çünkü Tanrı benim yüksek kulemdir, merhametimin Tanrısı’dır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}