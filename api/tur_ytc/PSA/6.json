gece yatağım su içinde.","poem":2},{"lineBreak":true},{"text":"Gözyaşlarımla döşeğimi ıslatıyorum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gözüm kederden sönüyor,","poem":1},{"text":"bütün düşmanlarımdan ötürü yaşlanıyor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey kötülük yapanların hepsi benden uzak durun,","poem":1},{"text":"çünkü Yahve ağlayışımı duydu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve yalvarışımı işitti.","poem":1},{"text":"Yahve duamı kabul edecektir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bütün düşmanlarım utanıp dehşet içinde kalacak.","poem":1},{"text":"Dönecekler, ansızın rezil olacaklar.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":6,"verse":5}}]},"thisChapterLink":"/api/tur_ytc/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}