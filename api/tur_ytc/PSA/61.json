{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Telli sazlarla - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, feryadımı duy,","poem":1},{"text":"duamı dinle.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yüreğim bunaldığında sana seslenirim","poem":1},{"text":"yeryüzünün öbür ucundan.","poem":2},{"lineBreak":true},{"text":"Beni benden daha yüksek olan kayaya götür.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü sen bana sığınak,","poem":1},{"text":"düşmana karşı güçlü bir kule oldun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sonsuza dek çadırında kalayım.","poem":1},{"text":"Kanatlarının koruması altına sığınayım. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü sen, ey Tanrı, adaklarımı duydun.","poem":1},{"text":"Adından korkanların mirasını bana verdin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kralın ömrünü uzat.","poem":1},{"text":"Onun yılları kuşaklar boyunca sürsün,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"sonsuza dek Tanrı'nın huzurunda tahta otursun.","poem":1},{"text":"Sevgi dolu iyiliğini ve gerçeğini sapta ki, onu korusunlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Böylece daima ismine ilahiler söyleyeceğim,","poem":1},{"text":"ta ki, adaklarımı her gün yerine getirebileyim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}