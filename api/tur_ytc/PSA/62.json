{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi Yedutun için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Canım yalnız Tanrı'da dinlenir.","poem":1},{"text":"Kurtuluşum O’ndandır.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kayam, kurtuluşum ve kalem yalnız O’dur.","poem":1},{"text":"Asla şiddetli sarsılmam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eğik bir duvar, sallanan bir çit gibi,","poem":1},{"text":"ne vakte kadar, hepiniz bir adamı ezmek için,","poem":2},{"lineBreak":true},{"text":"ona saldıracaksınız?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bütün düşünceleri onu bulunduğu yücelikten","poem":1},{"text":"Aşağıya atmaktır.","poem":2},{"lineBreak":true},{"text":"Yalanlardan zevk alırlar.","poem":2},{"lineBreak":true},{"text":"Ağızlarıyla kutsarken,","poem":2},{"lineBreak":true},{"text":"İçlerinden lanet okurlar. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey canım, sessizce yalnız Tanrı’yı bekle,","poem":1},{"text":"çünkü umudum O’ndandır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kayam, kurtuluşum ve kalem yalnız O’dur.","poem":1},{"text":"Sarsılmam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kurtuluşum ve onurum Tanrı'yladır.","poem":1},{"text":"Gücümün kayası ve sığınağım Tanrı'dadır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey halkım, O'na her zaman güven.","poem":1},{"text":"Yüreğini O’nun önünde dök.","poem":2},{"lineBreak":true},{"text":"Tanrı bizim için bir sığınaktır. Selah.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kesinlikle aşağı tabakadaki insanlar yalnızca bir soluktur;","poem":1},{"text":"yukarı tabakadaki insanlar da bir yalan.","poem":2},{"lineBreak":true},{"text":"Onlar tartıda kaldırıldıklarında,","poem":2},{"lineBreak":true},{"text":"birlikte soluktan daha hafiftir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaddarlığa güvenmeyin.","poem":1},{"text":"Soygunculukla övünmeyin.","poem":2},{"lineBreak":true},{"text":"Zenginlik artarsa,","poem":2},{"lineBreak":true},{"text":"ona gönül bağlamayın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrı bir kez konuştu;","poem":1},{"text":"Ben şunu iki kez işittim:","poem":2},{"lineBreak":true},{"text":"Güç Tanrı’ya aittir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sevgi dolu iyilik de sana aittir, ey Efendim,","poem":1},{"text":"çünkü sen herkesi yaptığı işe göre ödüllendirirsin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}