{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Yahuda kırlarında bulunduğu zaman - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrım, sensin benim Tanrım.","poem":1},{"text":"Gayretle seni arıyorum.","poem":2},{"lineBreak":true},{"text":"Canım sana susamış.","poem":2},{"lineBreak":true},{"text":"Bedenim seni özlüyor,","poem":2},{"lineBreak":true},{"text":"kurak, yorucu, susuz bir diyarda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kutsal yerde sana baktım,","poem":1},{"text":"gücünü ve görkemini görmek için.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dudaklarım seni över,","poem":1},{"text":"çünkü senin sevgi dolu iyiliğin yaşamdan daha iyidir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaşadığım sürece seni böyle yücelteceğim.","poem":1},{"text":"Senin adınla ellerimi kaldıracağım.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Canım zengin yiyeceklere doyar gibi doyacak.","poem":1},{"text":"Ağzım neşeli dudaklarla seni övecek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Seni yatağımda hatırladığımda,","poem":1},{"text":"gece nöbetlerinde seni düşünürüm.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü sen bana yardımcı oldun.","poem":1},{"text":"Kanatlarının gölgesinde sevineceğim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Canım sana yakın durur.","poem":1},{"text":"Sağ elin bana destek olur.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ama yok etmek için canımı arayanlar,","poem":1},{"text":"yerin diplerine inecekler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onlar kılıcın gücüne teslim edilecekler.","poem":1},{"text":"Çakallara yem olacaklar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ama kral Tanrı’yla sevinecek.","poem":1},{"text":"O’nunla ant içenlerin hepsi O'nu övecekler,","poem":2},{"lineBreak":true},{"text":"yalan söyleyenlerin ağızlarıysa susturulacak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}