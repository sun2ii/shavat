{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Yakındığımda sesimi duy, ey Tanrı.","poem":1},{"text":"Yaşamımı düşman korkusundan koru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kötülerin gizli tasarılarından,","poem":1},{"text":"fesat işleyenlerin gürültücü kalabalığından sakla beni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dillerini kılıç gibi keskinleştiren,","poem":1},{"text":"ölümcül sözlerle oklarını kuran,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"masum insanları vurmak için pusuda yatan onlardır.","poem":1},{"text":"Ansızın onu vururlar hiç korkmadan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kötü tasarılar için birbirlerini teşvik ederler.","poem":1},{"text":"Gizlice tuzak kurmaktan söz ederler.","poem":2},{"lineBreak":true},{"text":"“Onları kim görecek ki?” derler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Kusursuz bir plan yaptık!” deyip,","poem":1},{"text":"adaletsizlik için düzen kurarlar.","poem":2},{"lineBreak":true},{"text":"Besbelli insanın aklı ve yüreği kurnazdır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama Tanrı onlara ok atacaktır.","poem":1},{"text":"Ansızın bir okla vurulacaklar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kendi dilleri onları yıkıma uğratacak.","poem":1},{"text":"Onları gören herkes başını sallayacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bütün insanlar korkacak.","poem":1},{"text":"Tanrı’nın işini ilan edecekler,","poem":2},{"lineBreak":true},{"text":"O’nun yaptıklarını bilgece ölçüp tartacaklar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Doğru kişi Yahve'de sevinecek,","poem":1},{"text":"O’na sığınacaktır.","poem":2},{"lineBreak":true},{"text":"Yüreği doğru olanların hepsi O'nu övecekler!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}