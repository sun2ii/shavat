{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru - İlahi"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, Siyon'da seni övgü bekliyor.","poem":1},{"text":"Adaklar yerine getirilecek.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ey Sen duayı işiten,","poem":1},{"text":"bütün insanlar Sana gelecek.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Günahlar beni bunalttı,","poem":1},{"text":"ama Sen suçlarımızın kefaretini ödedin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mutlu, avlularında otursun diye","poem":1},{"text":"seçip yaklaştırdığın insana.","poem":2},{"lineBreak":true},{"text":"Evinin, kutsal tapınağının","poem":2},{"lineBreak":true},{"text":"iyiliğiyle doyacağız.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Müthiş doğruluk işleriyle bizi yanıtlarsın.","poem":1},{"text":"Ey kurtuluşumuzun Tanrısı.","poem":2},{"lineBreak":true},{"text":"Ey Sen, dünyanın bütün uçlarının,","poem":2},{"lineBreak":true},{"text":"uzak denizde bulunanların umudusun.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Güçle kuşanmış olarak,","poem":1},{"text":"kuvvetinle dağlara biçim veren,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"denizlerin kükremesini,","poem":1},{"text":"dalgalarının uğultusunu,","poem":2},{"lineBreak":true},{"text":"ve ulusların kargaşasını yatıştıran sensin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzaklarda oturanlar da","poem":1},{"text":"senin harikalarından korkarlar.","poem":2},{"lineBreak":true},{"text":"Sabahın şafağını ve akşamı sevinç ezgileriyle çağırırsın.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeryüzünü ziyaret edip onu sularsın.","poem":1},{"text":"Onu çok zenginleştirirsin.","poem":2},{"lineBreak":true},{"text":"Tanrı’nın nehri suyla doludur.","poem":2},{"lineBreak":true},{"text":"Onlara tahıl sağlarsın,","poem":2},{"lineBreak":true},{"text":"çünkü bunu sen buyurdun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saban yarıklarını bolca sular,","poem":1},{"text":"sırtlarını düzeltirsin.","poem":2},{"lineBreak":true},{"text":"Yağmurlar yumuşatır,","poem":2},{"lineBreak":true},{"text":"onu mahsulle kutsarsın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yılı bolluğunla taçlandırırsın.","poem":1},{"text":"Arabaların bereketle dolup taşar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çöller yeşillikle taşar.","poem":1},{"text":"Tepeler neşeye bürünür.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Otlaklar sürülerle kaplanır.","poem":1},{"text":"Vadiler de buğdayla örtünür.","poem":2},{"lineBreak":true},{"text":"Sevinçle bağrışır, ezgi söylerler.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}