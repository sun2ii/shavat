{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - İlahi - Mezmur"]},{"type":"verse","number":1,"content":[{"text":"Ey bütün yeryüzü,","poem":1},{"text":"Tanrı’ya, sevinçle haykırın!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Adının yüceliğine ilahi söyleyin!","poem":1},{"text":"Görkem ve övgü sunun!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“İşlerin ne muhteşemdir!” deyin Tanrı’ya,","poem":1},{"text":"“Gücünün büyüklüğünden","poem":2},{"lineBreak":true},{"text":"düşmanların önünde boyun eğiyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bütün yeryüzü sana tapınacak,","poem":1},{"text":"sana ilahi söyleyip","poem":2},{"lineBreak":true},{"text":"Adına ezgiler söyleyecekler.” Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gelin ve Tanrı'nın yaptıklarını görün.","poem":1},{"text":"İnsanlar adına muhteşem bir yapıt.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Denizi kuru toprağa çevirdi.","poem":1},{"text":"Onlar ırmağı yürüyerek geçtiler.","poem":2},{"lineBreak":true},{"text":"Orada O’nda sevindik.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O, kudretiyle sonsuza dek hüküm sürer.","poem":1},{"text":"Gözleri ulusları gözler.","poem":2},{"lineBreak":true},{"text":"Asiler O’na karşı baş kaldırmasın. Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey halklar, Tanrımız’ı övün!","poem":1},{"text":"Övgüsünün sesini duyurun,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Diriler arasında yaşamımızı koruyan,","poem":1},{"text":"ayaklarımızın kaymasına izin vermeyen O’dur.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sen bizi sınadın, ey Tanrı.","poem":1},{"text":"Gümüş arıtır gibi, arıttın bizi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bizi zindana verdin.","poem":1},{"text":"Sırtımıza yük koydun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İnsanların başımıza çıkmasına izin verdin.","poem":1},{"text":"Ateşin ve suyun içinden geçtik,","poem":2},{"lineBreak":true},{"text":"ama bizi bolluğun bulunduğu yere getirdin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yakmalık sunularla tapınağına geleceğim.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sıkıntıdayken ağzımın söylemiş olduğu,","poem":1},{"text":"dudaklarımın sana vaat ettiği adaklarımı yerine getireceğim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sana yakmalık sunu olarak semiz hayvanlar sunacağım,","poem":1},{"text":"koçlarla birlikte, boğalar, keçiler sunacağım. Selah.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ey Tanrı'dan korkanlar, gelin ve dinleyin.","poem":1},{"text":"Canım için neler yapmış olduğunu bildireyim.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ağzımla O’na yakardım.","poem":1},{"text":"Dilimle O övüldü.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Günaha yüreğimde yer verseydim,","poem":1},{"text":"Efendi dinlemezdi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ama kesinlikle, Tanrı dinledi.","poem":1},{"text":"Duamın sesini işitti.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Duamı geri çevirmeyen,","poem":1},{"text":"sevgi dolu iyiliğini benden esirgemeyen","poem":2},{"lineBreak":true},{"text":"Tanrı'ya övgüler olsun!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}