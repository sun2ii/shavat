{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - David’in mezmuru- İlahi"]},{"type":"verse","number":1,"content":[{"text":"Tanrı kalksın!","poem":1},{"text":"Düşmanları dağılsın!","poem":2},{"lineBreak":true},{"text":"O’ndan nefret edenler önünden kaçsınlar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dumanın dağıldığı gibi,","poem":1},{"text":"onları öyle dağıt.","poem":2},{"lineBreak":true},{"text":"Ateşin önünde eriyen balmumu gibi,","poem":2},{"lineBreak":true},{"text":"kötüler Tanrı'nın önünde öyle yok olsun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ama doğrular sevinsin.","poem":1},{"text":"Tanrı'nın önünde coşsunlar.","poem":2},{"lineBreak":true},{"text":"Evet, neşeyle coşsunlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tanrı'ya ilahi söyleyin! O’nun adına ezgiler söyleyin!","poem":1},{"text":"Bulutlar üzerine binmiş olanı yüceltin:","poem":2},{"lineBreak":true},{"text":"Yah’dır, O’nun adı!","poem":2},{"lineBreak":true},{"text":"O’nun önünde coşun!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kutsal konutundaki Tanrı,","poem":1},{"text":"yetimin babası ve dul kadınların savunucusudur.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tanrı yalnızlara aile kurar.","poem":1},{"text":"Tutsakları ezgi söyleyerek dışarı çıkarır,","poem":2},{"lineBreak":true},{"text":"ama isyan edenler güneşin kavurduğu ülkede yaşar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey Tanrı, halkının önüne çıktığında,","poem":1},{"text":"çölde yürüdüğünde... Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yer sarsıldı,","poem":1},{"text":"ve Sina Tanrısı’nın önünde gökten yağmur yağdı,","poem":2},{"lineBreak":true},{"text":"Tanrı’nın, İsrael’in Tanrısı önünde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sen, ey Tanrı, bol yağmur gönderdin.","poem":1},{"text":"Yorulduğu zaman mirasına kuvvet verdin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Topluluğun orada yaşadı.","poem":1},{"text":"Sen, ey Tanrı, iyiliğini yoksullar için hazırladın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efendi sözünü duyurdu.","poem":1},{"text":"Bunu ilan edenler büyük bir topluluktu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Orduların kralları kaçıyor! Kaçıyorlar!”","poem":1},{"text":"Evde bekleyen kadın ganimeti bölüştürür,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"sen kamp ateşinin arasında uyurken,","poem":1},{"text":"tüyleri altın renkli,","poem":2},{"lineBreak":true},{"text":"kanatları gümüşle kaplanmış bir güvercin gibi parlarsın.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Her Şeye Gücü Yeten orada kralları dağıttığında,","poem":1},{"text":"Salmon'a kar yağdı.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Başan Dağları heybetli dağlardır.","poem":1},{"text":"Başan Dağları sarptır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ey sarp dağlar, neden kıskançlıkla bakıyorsunuz?","poem":1},{"text":"Tanrı'nın hüküm sürmek için seçtiği dağa?","poem":2},{"lineBreak":true},{"text":"Evet, Yahve sonsuza dek orada oturacak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanrı'nın savaş arabaları on binlerce, binlerce bindir.","poem":1},{"text":"Efendi, Sina Dağı'ndan kutsal yere kadar onların ortasındadır.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yükseğe çıktın.","poem":1},{"text":"Tutsakları götürdün.","poem":2},{"lineBreak":true},{"text":"İnsanlardan, isyan edenlerden bile armağanlar aldın,","poem":2},{"lineBreak":true},{"text":"oraya yerleşmek için ey Yah Tanrı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Her gün yüklerimizi taşıyan Efendi’ye,","poem":1},{"text":"kurtuluşumuz olan Tanrı’ya övgüler olsun. Selah.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tanrı bizim için kurtuluş Tanrısı’dır.","poem":1},{"text":"Ölümden kurtarış, Efendi Yahve’ye aittir.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ama Tanrı düşmanlarının başını,","poem":1},{"text":"suçunda ısrar edenin kıllı kafasını ezer.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Efendi şöyle dedi: “Seni Başan'dan geri getireceğim.","poem":1},{"text":"Seni yeniden denizin derinliklerinden geri getireceğim,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"öyle ki, ayağını kana batırıp onları ezesin,","poem":1},{"text":"köpeklerinin dili de senin düşmanlarından payını alsın.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ey Tanrı, senin alaylarını","poem":1},{"text":"Tanrım’ın, Kralım'ın kutsal yere doğru alaylarını gördüler.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tef çalan kızlar arasında,","poem":1},{"text":"önde okuyucular, arkada çalgıcılar yürüdü.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"“Topluluklarda Tanrı'yı,","poem":1},{"text":"İsrael topluluğunda Efendi’yi övün!”","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Onların hükümdarı küçük Benyamin,","poem":1},{"text":"Yahuda beyleri ve topluluğu,","poem":2},{"lineBreak":true},{"text":"Zevulun beyleri ve Naftali beyleri oradadırlar.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Senin gücünü Tanrı buyurdu.","poem":1},{"text":"Bizim için yaptıklarını güçlendir, ey Tanrı.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yeruşalem'deki tapınağın uğruna,","poem":1},{"text":"krallar sana hediyeler getirecek.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Azarla kamışlar arasında yaşayan vahşi hayvanı,","poem":1},{"text":"halkların buzağılarını ve boğalar sürüsünü.","poem":2},{"lineBreak":true},{"text":"Gümüş külçe getirenleri alçalt,","poem":2},{"lineBreak":true},{"text":"savaştan zevk alan ulusları dağıt.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mısır'dan beyler gelecek.","poem":1},{"text":"Etiyopya ellerini Tanrı'ya uzatmak için acele edecek.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ey yeryüzünün krallıkları, Tanrı'ya ezgi söyleyin!","poem":1},{"text":"Efendi’ye ilahiler söyleyin—Selah—","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kadim göklerin göğü üstüne binmiş olana.","poem":1},{"text":"İşte, sesini ortaya koyuyor, heybetli sesini.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Gücü Tanrı'ya atfedin!","poem":1},{"text":"O’nun yüceliği İsrael'in üzerindedir,","poem":2},{"lineBreak":true},{"text":"gücü göklerdedir.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kutsal yerlerinde muhteşemsin, ey Tanrı.","poem":1},{"text":"İsrael'in Tanrısı halkına güç ve kudret verir.","poem":2},{"lineBreak":true},{"text":"Övgüler olsun Tanrı’ya!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}