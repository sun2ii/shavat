{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Zambaklar” makamında - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Kurtar beni ey Tanrı,","poem":1},{"text":"çünkü sular boynuma kadar geldi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayak basılacak yerin olmadığı","poem":1},{"text":"derin bataklığa batmaktayım.","poem":2},{"lineBreak":true},{"text":"Sellerin beni aştığı derin sulara geldim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ağlamaktan yoruldum.","poem":1},{"text":"Boğazım kurudu.","poem":2},{"lineBreak":true},{"text":"Gözlerim Tanrı’yı aramayı bırakıyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nedensiz yere benden nefret edenler","poem":1},{"text":"başımın saçından çoktur.","poem":2},{"lineBreak":true},{"text":"Beni yok etmek isteyen haksız düşmanlarım güçlüdür.","poem":2},{"lineBreak":true},{"text":"Almadığım şeyi geri vermem gerekiyor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Tanrı, akılsızlığımı biliyorsun.","poem":1},{"text":"Günahlarım senden gizli değil.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Seni bekleyenler benim yüzümden utanmasın,","poem":1},{"text":"ey Orduların Efendisi Yahve.","poem":2},{"lineBreak":true},{"text":"Ey İsrael'in Tanrısı benim yüzümden","poem":2},{"lineBreak":true},{"text":"seni arayanlar rezil olmasın.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü senin uğruna aşağılanmaya katlandım.","poem":1},{"text":"Utanç yüzümü kapladı.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kardeşlerime yabancı,","poem":1},{"text":"annemin çocuklarına el oldum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü senin evinin gayreti beni tüketti.","poem":1},{"text":"Sana edilen hakaretler benim üzerime düştü.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ağlayıp oruç tuttuğumda,","poem":1},{"text":"bu da bana ayıp sayıldı.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Giysimi çul yaptığımda,","poem":1},{"text":"onlar için bir masal oldum.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kent kapısında oturanlar hakkımda konuşuyorlar.","poem":1},{"text":"Sarhoşların şarkısı oldum.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bense ey Yahve, uygun zamanda duam sanadır.","poem":1},{"text":"Ey Tanrı, sevgi dolu iyiliğinin bolluğuyla,","poem":2},{"lineBreak":true},{"text":"kurtarışının gerçeğiyle yanıtla beni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Beni çamurdan kurtar, batmayayım.","poem":1},{"text":"Benden nefret edenlerden ve derin sulardan kurtulayım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sel suları beni boğmasın,","poem":1},{"text":"derinlik beni yutmasın,","poem":2},{"lineBreak":true},{"text":"çukur üzerime ağzını kapamasın.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yanıtla beni, ey Yahve, çünkü sevgi dolu iyiliğin iyidir.","poem":1},{"text":"Sevecen merhametlerinin bolluğuna göre bana yönel.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yüzünü hizmetkârından gizleme,","poem":1},{"text":"çünkü sıkıntıdayım.","poem":2},{"lineBreak":true},{"text":"Bana tez yanıt ver!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Canıma yaklaş ve onu kurtar.","poem":1},{"text":"Düşmanlarımdan ötürü beni fidyeyle kurtar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bana edilen hakareti, utancı, rezaleti bilirsin.","poem":1},{"text":"Düşmanlarımın hepsi senin önündedir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aşağılanma kalbimi kırdı ve içim ağırlaştı.","poem":1},{"text":"Acıyacak birilerini aradım ama yoktu,","poem":2},{"lineBreak":true},{"text":"teselli edecek kimseyi bulamadım.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yiyecek için bana zehir verdiler.","poem":1},{"text":"Susadığımda içmem için bana sirke verdiler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Önlerindeki sofra tuzak olsun,","poem":1},{"text":"bu onlara ceza ve kapan olsun.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gözleri kararsın ki göremesinler.","poem":1},{"text":"Sırtları hep bükük olsun.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gazabını üzerlerine dök.","poem":1},{"text":"Öfkenin şiddeti onlara yetişsin.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yaşadıkları yer ıssız olsun.","poem":1},{"text":"Çadırında oturan olmasın.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Çünkü yaraladığın insana zulmediyorlar.","poem":1},{"text":"Yaraladığın insanın acısını anlatıyorlar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Onların cezalarına ceza kat.","poem":1},{"text":"Senin doğruluğuna girmelerine izin verme.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Onlar yaşam kitabından silinsinler,","poem":1},{"text":"doğrularla birlikte yazılmasınlar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bense acı ve sıkıntı içindeyim.","poem":1},{"text":"Senin kurtarışın, ey Tanrı, beni korusun.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tanrı'nın adını bir ezgiyle öveceğim,","poem":1},{"text":"O’nu şükranla yücelteceğim.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yahve’yi bir öküzden,","poem":1},{"text":"boynuzlu, tırnaklı bir boğadan","poem":2},{"lineBreak":true},{"text":"daha çok memnun eder bu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Alçakgönüllüler bunu gördü ve sevindi.","poem":1},{"text":"ey Tanrı'yı arayan sizler, yüreğiniz yaşasın.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Çünkü Yahve yoksulu duyar,","poem":1},{"text":"kendi tutsak halkını hor görmez.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Gök ve yeryüzü,","poem":1},{"text":"denizler ve içinde kımıldayan her şey O’nu övsün!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Çünkü Tanrı Siyon'u kurtaracak,","poem":1},{"text":"Yahuda kentlerini yeniden inşa edecek.","poem":2},{"lineBreak":true},{"text":"Onlar oraya yerleşip mülk edinecekler.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Hizmetkârının çocukları da onu miras alacaklar.","poem":1},{"text":"O’nun adını sevenler orada oturacaklar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}