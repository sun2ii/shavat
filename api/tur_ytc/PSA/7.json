{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Benyaminli Kûş'un sözlerine ilişkin David’in Yahve’ye okuduğu şigayon"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, Tanrım, sana sığınıyorum.","poem":1},{"text":"Peşime düşenlerin hepsinden kurtar beni, özgür kıl.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kurtaracak kimse yok diye,","poem":1},{"text":"aslan gibi canımı parçalamasınlar,","poem":2},{"lineBreak":true},{"text":"paramparça etmesinler onu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey Yahve, Tanrım, eğer şunu yaptıysam,","poem":1},{"text":"eğer elimde kötülük varsa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"benimle barış içinde olan birine kötülükle karşılık verdiysem","poem":1},{"text":"(evet, sebepsiz yere düşmanımı soyduysam),","poem":2}]},{"type":"verse","number":5,"content":[{"text":"düşman canımın peşine düşsün ve ele geçirsin beni,","poem":1},{"text":"hayatımı yere çalsın,","poem":2},{"lineBreak":true},{"text":"yüceliğimi toza katsın. Selah.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Öfkeyle kalk, ey Yahve.","poem":1},{"text":"Düşmanlarımın öfkesine karşı yüksel.","poem":2},{"lineBreak":true},{"text":"Benim için uyan. Yargıyı sen buyurdun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uluslar topluluğu çevreni sarsın.","poem":1},{"text":"Yücelerden onları yönet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve halkları yargılar,","poem":1},{"text":"beni doğruluğuma göre yargıla, ey Yahve,","poem":2},{"lineBreak":true},{"text":"dürüstlüğüme göre.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kötülerin kötülüğü son bulsun,","poem":1},{"text":"ama doğru olanı pekiştir,","poem":2},{"lineBreak":true},{"text":"onların akıllarını ve yüreklerini araştıran adil Tanrı’dır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Benim kalkanım Tanrı’yla olmaktır,","poem":1},{"text":"yüreği doğru olanı O kurtarır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrı adil bir yargıçtır,","poem":1},{"text":"evet, her gün öfkelenen bir Tanrı’dır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Biri tövbe etmezse kılıcını biler,","poem":1},{"text":"eğip yayını gerer.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ona karşı ölüm silahlarını hazırlamıştır.","poem":1},{"text":"Alevli okları hazırdır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"İşte","poem":1},{"noteId":6},{"text":"o kişi, kötülük sancısı çekiyor.","poem":1},{"text":"Kötülüğe gebe kalıp,","poem":2},{"lineBreak":true},{"text":"yalan doğurdu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bir çukur kazdı,","poem":1},{"text":"kazdığı çukura kendisi düştü.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neden olduğu bela kendisine dönecek.","poem":1},{"text":"Zorbalığı kendi başına inecek.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Doğruluğundan ötürü Yahve’ye şükredeceğim,","poem":1},{"text":"yüce Yahve'nin adını ilahilerle öveceğim.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/tur_ytc/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}