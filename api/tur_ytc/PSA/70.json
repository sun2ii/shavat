{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Anma sunusu için - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, beni kurtarmak için acele et.","poem":1},{"text":"Yardımıma koş, ey Yahve.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Canımı arayanlar","poem":1},{"text":"hayal kırıklığına uğrayıp","poem":2},{"lineBreak":true},{"text":"şaşkına dönsünler.","poem":2},{"lineBreak":true},{"text":"Mahvolmamı isteyenler","poem":2},{"lineBreak":true},{"text":"rezil olup geri dönsünler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bana “Oh! Oh!” diyenler","poem":1},{"text":"utançlarından geri dönsünler.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bütün seni arayanlar","poem":1},{"text":"sende sevinip coşsunlar.","poem":2},{"lineBreak":true},{"text":"Senin kurtarışını sevenler sürekli,","poem":2},{"lineBreak":true},{"text":"“Tanrı yücelsin!” desinler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bense yoksul ve muhtacım.","poem":1},{"text":"Tez bana gel, ey Tanrı.","poem":2},{"lineBreak":true},{"text":"Sensin benim yardımcım ve kurtarıcım.","poem":2},{"lineBreak":true},{"text":"Geç kalma ey Yahve.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}