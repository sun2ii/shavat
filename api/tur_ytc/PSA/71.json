{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Sana sığınıyorum, ey Yahve.","poem":1},{"text":"Hayal kırıklığına uğratma beni hiçbir zaman.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beni kendi doğruluğunla kurtar,","poem":1},{"text":"bana yardım et.","poem":2},{"lineBreak":true},{"text":"Kulak ver bana ve beni kurtar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Her zaman gidebileceğim","poem":1},{"text":"sığınacak kayam ol.","poem":2},{"lineBreak":true},{"text":"Kurtulmam için buyruk ver,","poem":2},{"lineBreak":true},{"text":"çünkü kayam ve kalem sensin benim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey Tanrı, kurtar beni,","poem":1},{"text":"kötünün, haksızın, zalimin elinden.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü benim umudum,","poem":1},{"text":"gençliğimden beri güvendiğim","poem":2},{"lineBreak":true},{"text":"sensin, ey Efendi Yahve.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ana rahminden beri sana güvendim.","poem":1},{"text":"Beni ana rahminden çıkaran sensin.","poem":2},{"lineBreak":true},{"text":"Seni hep öveceğim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Birçokları için şaşılacak biriyim,","poem":1},{"text":"ama sen benim güçlü sığınağımsın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ağzım senin övgünle,","poem":1},{"text":"gün boyu senin yüceliğinle dolu olacak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaşlılığımda beni reddetme.","poem":1},{"text":"Gücüm tükendiğinde beni bırakma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü düşmanlarım hakkımda konuşuyor.","poem":1},{"text":"Canımı gözleyenler birlikte düzen kuruyorlar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Tanrı onu terk etti” diyorlar.","poem":1},{"text":"“Peşine düşün ve yakalayın, çünkü onu kurtaracak kimse yok.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Tanrı, benden uzak durma.","poem":1},{"text":"Tanrım, yardımıma koş.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Beni suçlayanlar hayal kırıklığıyla yok olsunlar.","poem":1},{"text":"Bana zarar vermek isteyenleri,","poem":2},{"lineBreak":true},{"text":"rezillik ve utanç kaplasın.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ama ben hep umut ederim,","poem":1},{"text":"övgülerine övgü eklerim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ağzım senin doğruluğunu,","poem":1},{"text":"tam ölçüsünü bilmesem de,","poem":2},{"lineBreak":true},{"text":"tüm gün senin kurtuluşundan söz edecek.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efendi Yahve’nin büyük işleriyle geleceğim.","poem":1},{"text":"Senin doğruluğundan,","poem":2},{"lineBreak":true},{"text":"yalnızca senin doğruluğundan söz edeceğim.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ey Tanrı, gençliğimden beri bana öğrettin.","poem":1},{"text":"Şimdiye dek şaşılası işlerini ilan ettim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Evet, yaşlanıp saçlarıma ak düşse de, ey Tanrı","poem":1},{"text":"Gücünü gelecek kuşağa,","poem":2},{"lineBreak":true},{"text":"büyüklüğünü gelecek olanların hepsine bildirene dek,","poem":2},{"lineBreak":true},{"text":"beni bırakma,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ey Tanrı, doğruluğun göklere erişiyor.","poem":1},{"text":"Büyük işler yaptın.","poem":2},{"lineBreak":true},{"text":"Senin gibisi var mı, ey Tanrı?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Sen ki, bize çok acı dertler gösterdin,","poem":1},{"text":"beni yaşatacak,","poem":2},{"lineBreak":true},{"text":"yerin derinliklerinden bizi yeniden çıkaracaksın.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Saygınlığımı artır,","poem":1},{"text":"beni yeniden rahatlat.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ben de seni sadakatinden ötürü","poem":1},{"text":"seni arpla öveceğim, ey Tanrım.","poem":2},{"lineBreak":true},{"text":"Lirle sana ilahiler söyleyeceğim, ey İsrael'in Kutsalı.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dudaklarım sevinçle haykıracak!","poem":1},{"text":"Kurtarmış olduğun canım","poem":2},{"lineBreak":true},{"text":"seni ezgilerle övecek!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dilim de bütün gün senin doğruluğundan söz edecek,","poem":1},{"text":"çünkü bana zarar vermek isteyenler,","poem":2},{"lineBreak":true},{"text":"hayal kırıklığına uğrayıp kahroldular.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}