{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["Şolomon’un mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, adaletini krala,","poem":1},{"text":"doğruluğunu kral oğluna ver.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Halkını doğrulukla,","poem":1},{"text":"yoksullarını adaletle yargılasın.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dağlar halka bolluk getirsin.","poem":1},{"text":"Tepeler doğruluğun meyvesini versin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Halkının yoksullarına hakkını versin.","poem":1},{"text":"Muhtaçların çocuklarını kurtarsın,","poem":2},{"lineBreak":true},{"text":"zalimi parçalasın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Güneş ve ay durdukça,","poem":1},{"text":"tüm nesiller boyunca senden korksunlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeni biçilmiş çayıra düşen yağmur gibi,","poem":1},{"text":"toprağı sulayan bol yağmurlar gibi olsun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onun günlerinde doğrular serpilip gelişsin,","poem":1},{"text":"ay yok olana dek esenlik çoğalsın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Denizden denize,","poem":1},{"text":"ırmak'tan dünyanın sonlarına dek hüküm sürsün.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çölde yaşayanlar önünde eğilsin.","poem":1},{"text":"Düşmanları toz yalasın,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarşiş ve ada kralları ona haraç getirsin.","poem":1},{"text":"Saba ve Seva kralları armağanlar sunsun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bütün krallar önünde yere kapansın.","poem":1},{"text":"Bütün uluslar ona hizmet etsin.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü yardım için haykıran muhtacı,","poem":1},{"text":"destekçisi olmayan yoksulu kurtarır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yoksula ve muhtaca merhamet eder.","poem":1},{"text":"Muhtaçların canlarını kurtarır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Canlarını baskı ve şiddetten kurtarır.","poem":1},{"text":"Gözünde onların kanı değerlidir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onlar yaşasınlar ve ona Saba altınından verilsin.","poem":1},{"text":"Onun için sürekli dua etsinler.","poem":2},{"lineBreak":true},{"text":"Bütün gün onu kutsasınlar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ülkenin her yerinde tahıl bolluğu olsun.","poem":1},{"text":"Meyvesi Lübnan gibi dalgalansın.","poem":2},{"lineBreak":true},{"text":"Toprağın çayırı gibi serpilip gelişsin.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Adı sonsuza dek dursun.","poem":1},{"text":"Güneş durdukça adı dursun.","poem":2},{"lineBreak":true},{"text":"İnsanlar onun tarafından kutsansın.","poem":2},{"lineBreak":true},{"text":"Bütün uluslar ona kutsanmış desinler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İsrael'in Tanrısı, Yahve Tanrı'ya övgüler olsun.","poem":1},{"text":"Şaşılacak işler yapan yalnızca O’dur.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"O'nun yüce adına sonsuza dek övgüler olsun!","poem":1},{"text":"Bütün yeryüzü O’nun yüceliğiyle dolsun!","poem":2},{"lineBreak":true},{"text":"Amin ve amin.","poem":2}]},{"type":"verse","number":20,"content":["Böylece Yişay oğlu David'in duası sona erer."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}