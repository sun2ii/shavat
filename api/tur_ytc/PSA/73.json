{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Tanrı","poem":1},{"noteId":24},{"text":"kesinlikle İsrael’e,","poem":1},{"text":"yüreği temiz olanlara karşı iyidir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ama benim ayaklarım neredeyse tükenmişti.","poem":1},{"text":"Adımlarım az kalsın kaymıştı.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü kötülerin bolluk içinde olduğunu görünce,","poem":1},{"text":"kibirlileri kıskandım.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü ölümlerinde çırpınma yoktur,","poem":1},{"text":"güçleri sağlamdır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İnsan yüklerinden özgürdürler,","poem":1},{"text":"öteki insanlar gibi dertli de değiller.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bu nedenle gurur onların boynundaki zincir gibi,","poem":1},{"text":"şiddet onları saran bir giysi gibidir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gözleri şişmanlıktan dışarı fırlamış,","poem":1},{"text":"akılları kibrin sınırlarını aşmıştır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Alay ederler ve kötü niyetle konuşurlar.","poem":1},{"text":"Kibirle, baskıyla tehdit ederler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ağızlarını göklere çevirdiler.","poem":1},{"text":"Dilleri yeryüzünde dolaşır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bu nedenle onların halkları onlara geri döner,","poem":1},{"text":"bolluk sularından içerler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onlar, “Tanrı nereden biliyor?” derler.","poem":1},{"text":"“Yüceler Yücesi'nde bilgi var mı?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"İşte, kötüler bunlardır.","poem":1},{"text":"Daima rahatlar ve zenginliklerini artırırlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gerçekten yüreğimi boşuna temizlemişim,","poem":1},{"text":"ellerimi masumiyetle yıkamışım,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"gün boyunca sıkıntı çektim,","poem":1},{"text":"her sabah cezalandırıldım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eğer “Ben böyle konuşayım” deseydim,","poem":1},{"text":"işte, senin çocuklarının nesline ihanet etmiş olurdum.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bunu anlamaya çalıştığımda,","poem":1},{"text":"bana çok acı verdi,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta ki, Tanrı’nın tapınağına girip,","poem":1},{"text":"onların sonunu anlayana kadar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gerçekten onları kaygan yerlere koyarsın.","poem":1},{"text":"Onları yıkıma atarsın.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nasıl da ansızın yok oluyorlar!","poem":1},{"text":"Dehşet içinde büsbütün süpürülüp atıldılar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyanınca görülen bir rüya gibi,","poem":1},{"text":"sen de ey Efendi,","poem":2},{"noteId":25},{"lineBreak":true},{"text":"uyanınca onların hayallerini hor göreceksin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Çünkü canım acı çekiyordu.","poem":1},{"text":"Yüreğim buruktu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bense o denli akılsız ve bilgisiz,","poem":1},{"text":"önünde vahşi bir hayvan gibiydim.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ama yine de sürekli seninleyim.","poem":1},{"text":"Sağ elimden tuttun.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Öğüdünle bana yol gösterirsin,","poem":1},{"text":"sonunda beni yüceliğe alırsın.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gökte kimim var?","poem":1},{"text":"Yeryüzünde senden başkasını istemem.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bedenim ve yüreğim tükeniyor,","poem":1},{"text":"ama Tanrı yüreğimin gücü,","poem":2},{"lineBreak":true},{"text":"sonsuza dek bana düşen paydır.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Çünkü işte, senden uzak olanlar yok olur.","poem":1},{"text":"Sana sadakatsiz olanların hepsini yok ettin.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ama Tanrı'ya yaklaşmak benim için iyidir.","poem":1},{"text":"Senin bütün işlerini bildireyim diye,","poem":2},{"lineBreak":true},{"text":"Efendi Yahve’yi","poem":2},{"noteId":26},{"text":"kendime sığınak yaptım.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":73,"verse":1}},{"noteId":25,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":73,"verse":20}},{"noteId":26,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":73,"verse":28}}]},"thisChapterLink":"/api/tur_ytc/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}