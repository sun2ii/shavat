{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["Asaf’ın Maskili"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, neden bizi sonsuza dek reddettin?","poem":1},{"text":"Otlağının koyunlarına karşı öfken","poem":2},{"lineBreak":true},{"text":"neden için için yanıyor?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eskiden satın aldığın topluluğunu,","poem":1},{"text":"mirasın olmak üzere kurtardığın oymağı,","poem":2},{"lineBreak":true},{"text":"üzerinde yaşadığın Siyon Dağı’nı hatırla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayaklarını sonsuz yıkıntılara doğru kaldır,","poem":1},{"text":"düşman kutsal yerde her kötülüğü etti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Düşmanların senin toplantı yerinin ortasında kükrüyor.","poem":1},{"text":"İşaret olarak kendi bayraklarını diktiler.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gür bir ormanı kesen","poem":1},{"text":"baltalı adamlar gibi davrandılar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Şimdi onun bütün oyma işlerini","poem":1},{"text":"balta ve çekiçlerle kırıyorlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tapınağını yakıp yıktılar.","poem":1},{"text":"Adını taşıyan konutu kirlettiler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yüreklerinde, “Onları tamamen ezeceğiz” dediler.","poem":1},{"text":"Ülkede Tanrı'ya tapınılan her yeri yaktılar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hiçbir mucizevi belirti görmüyoruz.","poem":1},{"text":"Artık peygamber yok,","poem":2},{"lineBreak":true},{"text":"içimizde ne kadar süreceğini bilen de yok.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Düşman ne zamana dek azarlayacak, ey Tanrı?","poem":1},{"text":"Düşman sonsuza dek mi senin ismine sövecek?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Elini, sağ elini niçin geri çekiyorsun?","poem":1},{"text":"Onu göğsünden çıkar ve onları yakıp kül et!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama Tanrı eski zamanlardan beri Kralım’dır,","poem":1},{"text":"tüm yeryüzünde kurtuluş sağlar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gücünle denizi yardın.","poem":1},{"text":"Sulardaki deniz canavarlarının kafasını kırdın.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sen Livyatan'ın başlarını parçaladın.","poem":1},{"text":"Onu yiyecek olarak insanlara ve çöl canlılarına verdin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sen pınarı ve kaynağı fışkırttın.","poem":1},{"text":"Güçlü ırmakları kuruttun.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gündüz senindir, gece de senin.","poem":1},{"text":"Işığı ve güneşi sen hazırladın.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yeryüzünün bütün sınırlarını sen belirledin.","poem":1},{"text":"Yazı ve kışı yaratan sensin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Düşmanın seninle alay ettiğini unutma, ey Yahve.","poem":1},{"text":"Akılsız bir halk senin adına küfretti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kendi kumrunun canını canavarlara teslim etme.","poem":1},{"text":"Yoksullarının yaşamını sonsuza dek unutma.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Antlaşmanı say,","poem":1},{"text":"çünkü yeryüzünün karanlık yerleri","poem":2},{"lineBreak":true},{"text":"Zorbalık inleriyle dolmuş.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ezilen utanç içinde geri dönmesin.","poem":1},{"text":"Yoksul ve muhtaçlar senin adını yüceltsinler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kalk, ey Tanrı! Kendi davanı savun.","poem":1},{"text":"Akılsızın bütün gün seninle nasıl alay ettiğini hatırla.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Düşmanlarının sesini unutma.","poem":1},{"text":"Sana karşı ayaklananların patırtısı sürekli yükseliyor.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}