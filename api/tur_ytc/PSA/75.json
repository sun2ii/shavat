{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Yok Etme” makamında - Asaf’ın mezmuru - İlahi"]},{"type":"verse","number":1,"content":[{"text":"Sana şükrederiz ey Tanrı.","poem":1},{"text":"Şükrederiz, çünkü adın yakındır.","poem":2},{"lineBreak":true},{"text":"İnsanlar senin şaşılası işlerini anlatırlar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Belirlenen vakti seçtiğimde,","poem":1},{"text":"kusursuzca ben yargılayacağım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yeryüzünde oturanların tümü sarsılıyor.","poem":1},{"text":"Onun direklerini sağlam bir şekilde ben tutuyorum. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kibirlilere, “Övünmeyin!”,","poem":1},{"text":"kötülere, “Boynuzu yukarı kaldırmayın” dedim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Boynuzunuzu kaldırmayın.","poem":1},{"text":"Sert boyunla konuşmayın.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Çünkü ne doğudan, ne de batıdan,","poem":1},{"text":"ne de güneyden gelir yükselme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yargıç ancak Tanrı'dır.","poem":1},{"text":"Birini alçaltır, ötekini yükseltir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Çünkü Yahve’nin elinde bir kase var,","poem":1},{"text":"baharatla karıştırılmış köpüklü şarapla dolu.","poem":2},{"lineBreak":true},{"text":"Ondan döker.","poem":2},{"lineBreak":true},{"text":"Gerçekten dünyanın kötüleri","poem":2},{"lineBreak":true},{"text":"onun tortusuna dek yalayıp içerler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bense daima bunu ilan edeceğim,","poem":1},{"text":"Yakov'un Tanrısı'nı ilahilerle öveceğim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kötülerin bütün boynuzlarını kıracağım,","poem":1},{"text":"doğruların boynuzlarıysa yükseltilecektir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}