{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Telli sazlarla - Asaf’ın mezmuru - İlahi"]},{"type":"verse","number":1,"content":[{"text":"Yahuda'da Tanrı bilinir.","poem":1},{"text":"İsrael'de adı büyüktür.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Konutu Şalem’dedir,","poem":1},{"text":"meskeni Siyon'da.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Orada yayın alevli oklarını,","poem":1},{"text":"kalkanı, kılıcı ve savaş silahlarını kırdı. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne yüce, ne muhteşemsin,","poem":1},{"text":"av dağlarından daha yüce.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yiğitler yağmalanmış halde yatıyor,","poem":1},{"text":"son uykuya yattılar.","poem":2},{"lineBreak":true},{"text":"Hiçbir savaş eri elini kaldıramaz.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ey Yakov'un Tanrısı, sen azarlayınca,","poem":1},{"text":"savaş arabası da atlar da ölüm uykusuna daldılar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yalnız sensin korkulması gereken.","poem":1},{"text":"Öfkelendiğinde kim karşında durabilir?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeryüzünde acı çekenleri kurtarmak için","poem":1},{"text":"Tanrı yargılamaya kalktığında,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yargını gökten bildirdin,","poem":1},{"text":"yer korktu ve sustu. Selah.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Elbette insanın gazabı seni över.","poem":1},{"text":"Gazabından sağ kurtulanlar dizginlendi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tanrınız Yahve’ye adak adayın,","poem":1},{"text":"onları yerine getirin!","poem":2},{"lineBreak":true},{"text":"Armağanlar sunun korkulması gereken O’na,","poem":2},{"lineBreak":true},{"text":"ey siz çevresindekiler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O, beylerin ruhunu kırar.","poem":1},{"text":"Yeryüzü kralları O’ndan korkar.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}