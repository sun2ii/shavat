{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["Müzik Şefi Yedutun için - Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Haykırışım Tanrı’yadır!","poem":1},{"text":"Yardım için,","poem":2},{"lineBreak":true},{"text":"beni duysun diye Tanrı'ya haykırırım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sıkıntılı günde Efendi’yi aradım.","poem":1},{"text":"Geceleyin elimi açtım ve gevşemedi.","poem":2},{"lineBreak":true},{"text":"Canım teselli edilmeyi reddetti.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tanrı'yı anıyorum ve inliyorum.","poem":1},{"text":"Yakınıyorum ve ruhum bunalmış durumda. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Göz kapaklarımı açık tutuyorsun.","poem":1},{"text":"Konuşamayacak kadar çok sıkıntılıyım.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eski günleri,","poem":1},{"text":"geçmiş devirlerin yıllarını düşünmekteyim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gece ilahimi hatırlıyorum.","poem":1},{"text":"Kendi yüreğimi düşünüyorum;","poem":2},{"lineBreak":true},{"text":"ruhum inceden inceye soruyor:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Efendi bizi sonsuza dek mi reddedecek?","poem":1},{"text":"Bir daha lütuf göstermeyecek mi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O’nun sevgi dolu iyiliği sonsuza dek mi yok oldu?","poem":1},{"text":"Nesiller boyunca verdiği söz boşa mı çıkıyor?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanrı lütufkâr olmayı unuttu mu?","poem":1},{"text":"Merhametini öfkeyle geri mi çekti?” Selah.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sonra şöyle düşündüm:","poem":1},{"text":"“Yüceler Yücesi'nin sağ elinin yıllarını anacağım.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yah'ın yaptıklarını hatırlayacağım;","poem":1},{"text":"çünkü senin eski harikalarını anarım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ben de senin bütün işlerin üzerinde derin derin düşünürüm,","poem":1},{"text":"yaptıklarını dikkate alırım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Senin yolun, ey Tanrı, kutsal yerdedir.","poem":1},{"text":"Hangi ilâh Tanrı kadar büyüktür?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sen harikalar yaratan Tanrı’sın.","poem":1},{"text":"Gücünü halklar arasında bildirdin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Halkını kolunla,","poem":1},{"text":"Yakov ve Yosef’in oğullarını kurtardın. Selah.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sular seni gördü, ey Tanrı.","poem":1},{"text":"Sular seni gördü ve çalkalandı.","poem":2},{"lineBreak":true},{"text":"Derinlikler de sarsıldı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bulutlar suyunu boşalttı.","poem":1},{"text":"Gökler gök gürültüsüyle ses verdi.","poem":2},{"lineBreak":true},{"text":"Okların da etrafta ışık çaktı.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gürleyişinin sesi kasırgadaydı.","poem":1},{"text":"Şimşekler dünyayı aydınlattı.","poem":2},{"lineBreak":true},{"text":"Yer titredi ve sarsıldı.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Senin yolun denizden geçiyordu;","poem":1},{"text":"yolların büyük sulardaydı.","poem":2},{"lineBreak":true},{"text":"Ayak izlerin belli değildi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moşe ve Aron’un eliyle,","poem":1},{"text":"halkını sürü gibi güttün.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}