{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["Asaf’ın Maskili"]},{"type":"verse","number":1,"content":[{"text":"Öğrettiğime kulak verin, ey halkım.","poem":1},{"text":"Ağzımdan çıkan sözlere kulaklarınızı çevirin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ağzımı bir benzetmeyle açacağım.","poem":1},{"text":"Eskilerin sırlarını söyleyeceğim,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"onları işittik ve bildik,","poem":1},{"text":"atalarımız bize anlattı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onları çocuklarından saklamayacağız,","poem":1},{"text":"Yahve’nin övgülerini,","poem":2},{"lineBreak":true},{"text":"gücünü ve yaptığı şaşılası işleri,","poem":2},{"lineBreak":true},{"text":"gelecek kuşağa anlatacağız.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü Yakov'la bir antlaşma yaptı,","poem":1},{"text":"İsrael'de bir öğreti atadı,","poem":2},{"lineBreak":true},{"text":"atalarımıza bunları çocuklarına öğretmelerini buyurdu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gelecek nesiller, hatta doğmamış çocuklar bilsin de,","poem":1},{"text":"onlar da kalkıp kendi çocuklarına anlatsınlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Böylece umutlarını Tanrı'ya bağlasınlar,","poem":1},{"text":"Tanrı’nın yaptıklarını unutmasınlar,","poem":2},{"lineBreak":true},{"text":"buyruklarını tutsunlar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ataları gibi inatçı ve asi,","poem":1},{"text":"yürekleri vefasız,","poem":2},{"lineBreak":true},{"text":"ruhları Tanrı’ya sadakatsiz bir nesil olmasınlar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Silahlı, yay taşıyan Efraim'in çocukları,","poem":1},{"text":"savaş gününde geri döndüler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanrı'nın antlaşmasına uymadılar,","poem":1},{"text":"O’nun yasasında yürümeyi reddettiler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"O’nun yaptıklarını,","poem":1},{"text":"onlara göstermiş olduğu şaşılası işlerini unuttular.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mısır diyarında, Soan kırında,","poem":1},{"text":"atalarımızın önünde şaşılacak işler yaptı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Denizi yardı ve onları içinden geçirdi.","poem":1},{"text":"Suları yığın gibi durdurdu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gündüzleri bulutla,","poem":1},{"text":"gece boyu ateş ışığıyla onlara yol gösterdi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Çölde kayaları yardı,","poem":1},{"text":"derinliklerden geliyormuşçasına onlara bol bol içirdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kayadan dereler çıkardı,","poem":1},{"text":"suları ırmaklar gibi akıttı.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yine de O’na karşı günah işlemeye devam ettiler.","poem":1},{"text":"En Yüce Olan'a isyan ettiler.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"İştahlarına göre yemek isteyerek,","poem":1},{"text":"yüreklerinde Tanrı’yı denediler.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tanrı'ya karşı konuşup,","poem":1},{"text":"“Tanrı çölde sofra kurabilir mi?” dediler.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“İşte kayaya vurdu ve sular fışkırdı,","poem":1},{"text":"ırmaklar taştı.","poem":2},{"lineBreak":true},{"text":"Ekmek de verebilir mi?","poem":2},{"lineBreak":true},{"text":"Halkına et sağlayabilir mi?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bunun üzerine Yahve işitip öfkelendi.","poem":1},{"text":"Yakov'a karşı ateş tutuştu,","poem":2},{"lineBreak":true},{"text":"ve öfke İsrael'e karşı yükseldi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Çünkü Tanrı'ya inanmadılar,","poem":1},{"text":"O’nun kurtarışına güvenmediler.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yine de yukarıda göklere buyurdu,","poem":1},{"text":"göklerin kapılarını açtı.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yemek için üzerlerine man yağdırdı,","poem":1},{"text":"onlara gökten yiyecek verdi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"İnsanlar meleklerin ekmeğini yedi.","poem":1},{"text":"Onlara doyasıya yiyecek gönderdi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gökte doğu rüzgârını estirdi.","poem":1},{"text":"Gücüyle güney rüzgârına yol gösterdi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Üzerlerine toz gibi et,","poem":1},{"text":"denizlerin kumu gibi kanatlı kuşlar yağdırdı.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Onları ordugâhlarının ortasına,","poem":1},{"text":"oturdukları yerlerin çevresine düşürdü.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Böylece yediler ve iyice doydular.","poem":1},{"text":"Onlara dilediklerini verdi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Arzularından vazgeçmediler.","poem":1},{"text":"Yiyecekleri hâlâ ağızlarındayken","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tanrı'nın öfkesi onlara karşı yükseldi,","poem":1},{"text":"en şişmanlarından bazılarını öldürdü,","poem":2},{"lineBreak":true},{"text":"İsrael'in gençlerini yere serdi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bütün bunlara rağmen yine günah işlediler,","poem":1},{"text":"O’nun şaşılası işlerine inanmadılar.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bu yüzden günlerini boşlukla,","poem":1},{"text":"yıllarını dehşetle tüketti.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kendilerini öldürdüğü zaman O'nu araştırdılar.","poem":1},{"text":"Geri döndüler ve gayretle Tanrı'yı aradılar.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tanrı'nın kayaları olduğunu,","poem":1},{"text":"yüce Tanrı’nın kurtarıcıları olduğunu hatırladılar.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ama ağızlarıyla O'nu överken,","poem":1},{"text":"dilleriyle O’na yalan söylediler.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Çünkü yürekleri O’nunla doğru değildi,","poem":1},{"text":"ne de O’nun antlaşmasına sadıklardı.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ama O, merhametli davranarak","poem":1},{"text":"kötülüğü bağışladı ve onları yok etmedi.","poem":2},{"lineBreak":true},{"text":"Evet, birçok kez öfkesini yatıştırdı,","poem":2},{"lineBreak":true},{"text":"gazabını tümüyle uyandırmadı.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Onların yalnızca insan olduğunu hatırladı,","poem":1},{"text":"geçip giden ve bir daha dönmeyen bir yel.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Çölde O’na kaç kez isyan ettiler,","poem":1},{"text":"ıssız yerde O’nu gücendirdiler!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Dönüp dönüp Tanrı'yı denediler,","poem":1},{"text":"ve İsrael'in Kutsalı’nı kışkırttılar.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"O’nun elini, düşmandan kurtardığı günü hatırlamadılar.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Mısır'da gerçekleştirdiği belirtileri,","poem":1},{"text":"Soan bölgesindeki şaşılası işleri,","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ırmaklarını ve akarsularını,","poem":1},{"text":"içmesinler diye kana çevirdi.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Aralarına onları yiyip bitiren sinek sürüleri,","poem":1},{"text":"onları yok eden kurbağalar gönderdi.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Onların mahsullerini tırtıla,","poem":1},{"text":"emeğini çekirgeye verdi.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Bağlarını doluyla,","poem":1},{"text":"yabanıl incir ağaçlarını kırgınla yok etti.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Hayvanlarını doluya,","poem":1},{"text":"sürüleri yakıcı yıldırımlara teslim etti.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Kızgın öfkesini üzerlerine,","poem":1},{"text":"gazap, hışım ve sıkıntı,","poem":2},{"lineBreak":true},{"text":"bir alay kötülük meleği gönderdi.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Öfkesine yol açtı,","poem":1},{"text":"canlarını ölümden esirgemedi,","poem":2},{"lineBreak":true},{"text":"yaşamlarını vebaya teslim etti,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Mısır'da ilk doğanların hepsini,","poem":1},{"text":"Ham'ın çadırlarındaki güçlerinin ilkini vurdu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Ama kendi halkını koyun gibi götürdü,","poem":1},{"text":"çölde onları sürü gibi güttü.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Onları güvenlik içinde götürdü ve korkmadılar.","poem":1},{"text":"Ama deniz düşmanlarını alt etti.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Onları kendi tapınağının sınırına,","poem":1},{"text":"sağ elinin götürdüğü bu dağa getirdi.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Önlerinden ulusları da kovdu,","poem":1},{"text":"onlara miras olarak sırayla pay verdi,","poem":2},{"lineBreak":true},{"text":"İsrael oymaklarını çadırlarında oturttu.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ama yine de Yüce Tanrı'yı deneyip O’na isyan ettiler.","poem":1},{"text":"O’nun tanıklıklarını tutmadılar.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ataları gibi geri dönüp hainlik yaptılar.","poem":1},{"text":"Aldatıcı bir yay gibi eğrildiler.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Çünkü yüksek yerleriyle O'nu öfkelendirdiler,","poem":1},{"text":"oyma suretleriyle O’nu kıskandırdılar.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Tanrı bunu duyunca öfkelendi,","poem":1},{"text":"İsrael'den büsbütün iğrendi,","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Böylece insanlar arasında kurduğu çadırı,","poem":1},{"text":"Şilo çadırını terk etti,","poem":2}]},{"type":"verse","number":61,"content":[{"text":"gücünü sürgüne,","poem":1},{"text":"yüceliğini düşmanın eline teslim etti.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Halkını da kılıca teslim etti,","poem":1},{"text":"mirasına öfkelenmişti.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Gençlerini ateş yuttu.","poem":1},{"text":"El değmemiş kızların düğün şarkısı yoktu.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Kâhinleri kılıçla düştüler,","poem":1},{"text":"dul karıları ağlayamadı.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Bunun üzerine Efendi uykudan uyanan biri gibi,","poem":1},{"text":"şaraptan bağıran güçlü bir adam gibi uyandı.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Düşmanlarını arkadan vurdu.","poem":1},{"text":"Onları sonsuz utanç içinde bıraktı.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Üstelik Yosef'in çadırını da reddetti,","poem":1},{"text":"Efraim oymağını seçmedi,","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Ama Yahuda oymağını,","poem":1},{"text":"sevdiği Siyon Dağı’nı seçti.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Tapınağını yükseklikler gibi,","poem":1},{"text":"sonsuza dek kurduğu yeryüzü gibi yaptı.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Ve hizmetkârı David'i seçti;","poem":1},{"text":"onu koyun ağıllarından aldı,","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Halkı Yakov’u ve mirası İsrael’in çobanı olmak üzere,","poem":1},{"text":"onu yavru kuzuların peşinden getirdi.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Böylece yüreğinin dürüstlüğüne göre onların çobanı oldu,","poem":1},{"text":"becerikli elleriyle onlara yol gösterdi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}