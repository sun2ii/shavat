{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, uluslar senin mirasına girdiler.","poem":1},{"text":"Kutsal tapınağını kirlettiler.","poem":2},{"lineBreak":true},{"text":"Yeruşalem’i taş yığınlarına döndürdüler.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hizmetkârlarının cesetlerini gökteki kuşlara,","poem":1},{"text":"kutsallarının etini yeryüzündeki hayvanlara yem olsun diye verdiler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kanlarını Yeruşalem'in çevresine su gibi döktüler.","poem":1},{"text":"Onları gömecek kimse yok.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Komşularımıza yüz karası,","poem":1},{"text":"etrafımızdakilere eğlence ve alay konusu olduk.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne zamana dek, ey Yahve?","poem":1},{"text":"Sonsuza dek kızgın mı kalacaksın?","poem":2},{"lineBreak":true},{"text":"Kıskançlığın ateş gibi yanacak mı?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Öfkeni seni tanımayan ulusların üzerine,","poem":1},{"text":"senin adını anmayan krallıkların üzerine dök.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü onlar Yakov'u yuttular,","poem":1},{"text":"yurdunu yok ettiler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atalarımızın suçlarını bize karşı tutma.","poem":1},{"text":"Sevecen merhametlerin bizimle tez buluşsun,","poem":2},{"lineBreak":true},{"text":"çünkü çok muhtacız.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adının yüceliği uğruna bize yardım et,","poem":1},{"text":"ey kurtuluşumuzun Tanrısı.","poem":2},{"lineBreak":true},{"text":"Adın uğruna bizi kurtar ve günahlarımızı bağışla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uluslar neden “Nerede onların Tanrısı?” desin?","poem":1},{"text":"Hizmetkârlarının dökülen kanının intikamı alındığı,","poem":2},{"lineBreak":true},{"text":"gözlerimizin önünde, uluslar arasında bilinsin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tutsakların iniltisi senin önüne gelsin.","poem":1},{"text":"Gücünün büyüklüğüne göre, ölüme mahkûm olanları koru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Komşularımıza sana ettikleri hakaretin aşağılanmasını,","poem":1},{"text":"onların bağrına yedi kat geri öde, ey Efendimiz.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Böylece biz, senin halkın ve otlağının koyunları,","poem":1},{"text":"sana daima şükredeceğiz.","poem":2},{"lineBreak":true},{"text":"Tüm nesiller boyunca seni daima öveceğiz.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}