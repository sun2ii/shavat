{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Gittit üzerine - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Efendimiz Yahve,","poem":1},{"text":"ne yüce adın var bütün yeryüzünde!","poem":2},{"lineBreak":true},{"text":"Görkemini göklerin üstüne yükselttin!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sana düşman olanlardan ötürü,","poem":1},{"text":"düşmanı ve öç alanı susturmak için","poem":2},{"lineBreak":true},{"text":"çocukların ve bebeklerin dudaklarından gücü kurdun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senin göklerini, ellerinin eserini,","poem":1},{"text":"koyduğun ay ve yıldızları düşününce dedim:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“İnsan ne ki, onu düşünesin?","poem":1},{"text":"İnsanoğlu nedir ki, ona değer veresin?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onu meleklerden","poem":1},{"noteId":7},{"text":"biraz aşağı kıldın,","poem":1},{"text":"ve onu yücelik ve saygınlıkla taçlandırdın.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ellerinin işleri üzerinde onu hâkim kıldın.","poem":1},{"text":"Her şeyi ayaklarının altına serdin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tüm koyunları ve sığırları,","poem":1},{"text":"kır hayvanlarını,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gökteki kuşları, denizdeki balıkları,","poem":1},{"text":"denizlerin yollarından geçen her şeyi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey Efendimiz Yahve,","poem":1},{"text":"ne yüce adın var bütün yeryüzünde!","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"İbranice: Elohim. Burada kullanılan Elohim kelimesi genellikle “Tanrı” anlamına gelir, ancak “tanrılar”, “beyler” veya “melekler” anlamına da gelebilir. Septuagint burada “melekler” olarak okunur. Ayrıca İbraniler 2:7’deki Septuagint’ten alıntıya da bakın.","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/tur_ytc/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}