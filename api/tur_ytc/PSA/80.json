{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi - “Zambaklar Antlaşması” makamında - Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Duy bizi, ey İsrael’in Çobanı,","poem":1},{"text":"Yosef'i sürü gibi güden,","poem":2},{"lineBreak":true},{"text":"keruvlar üzerinde oturan sensin,","poem":2},{"lineBreak":true},{"text":"saç ışığını.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Efraim, Benyamin ve Manaşşe'nin önünde","poem":1},{"text":"uyandır gücünü!","poem":2},{"lineBreak":true},{"text":"Gel ve kurtar bizi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey Tanrı, bizi döndür,","poem":1},{"text":"yüzün parlasın,","poem":2},{"lineBreak":true},{"text":"biz de kurtuluruz.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ordular Tanrısı Yahve,","poem":1},{"text":"halkının duasına karşı daha ne kadar öfkeleneceksin?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onları gözyaşı ekmeğiyle besledin,","poem":1},{"text":"onlara içmeleri için bol miktarda gözyaşı verdin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bizi komşularımızla çekişme kaynağı haline getirdin.","poem":1},{"text":"Düşmanlarımız kendi aralarında gülüşüyorlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bizi döndür, ey Ordular Tanrısı.","poem":1},{"text":"Yüzün parlasın,","poem":2},{"lineBreak":true},{"text":"biz de kurtuluruz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mısır'dan bir asma getirdin.","poem":1},{"text":"Ulusları kovdun ve onu diktin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onun için toprağı temizledin.","poem":1},{"text":"Derin kök saldı ve ülkeyi doldurdu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dağlar onun gölgesiyle kaplandı.","poem":1},{"text":"Dalları Tanrı’nın sedirleri gibiydi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dalları denize,","poem":1},{"text":"filizleri nehre kadar uzandı.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Duvarlarını neden yıktın,","poem":1},{"text":"yoldan geçen herkes onu neden koparıyor?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ormandan çıkan domuz onu harap ediyor.","poem":1},{"text":"Kırdaki yabanıl hayvanlar ondan besleniyor.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sana yalvarıyoruz, ey Ordular Tanrısı, geri dön","poem":1},{"text":"gökten aşağıya bak ve gör bu asmayı,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"sağ elinin diktiği çubuğu,","poem":1},{"text":"Kendin için kuvvetlendirdiğin dalı ziyaret et.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ateşle yandı.","poem":1},{"text":"Kesildi.","poem":2},{"lineBreak":true},{"text":"Senin azarlamanla yok olup gidiyorlar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Senin elin, sağ elinin adamı üzerinde,","poem":1},{"text":"kendin için kuvvetlendirdiğin insanoğlunun üzerinde olsun.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Böylece senden ayrılmayacağız.","poem":1},{"text":"Canlandır bizi, biz de senin adını çağıralım.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ey Ordular Tanrısı Yahve, bizi döndür,","poem":1},{"text":"yüzün parlasın, biz de kurtuluruz.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}