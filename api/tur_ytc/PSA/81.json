{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Gittit üzerine - Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Gücümüz olan Tanrı'ya yüksek sesle ilahi söyleyin!","poem":1},{"text":"Yakov'un Tanrısı'na sevinçle haykırın!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bir ilahi yükseltin,","poem":1},{"text":"tefi, arpla birlikte hoş liri buraya getirin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yeni Ay’da, dolunayda,","poem":1},{"text":"bayram günümüzde boru çalın.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü bu İsrael için bir yasadır,","poem":1},{"text":"Yakov'un Tanrısı'nın bir fermanıdır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mısır diyarından çıktığı zaman,","poem":1},{"text":"bunu Yosef için bir antlaşma olarak belirledi.","poem":2},{"lineBreak":true},{"text":"Orada bilmediğim bir dili duydum.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Onun omzunu yükten kurtardım.","poem":1},{"text":"Elleri küfeden kurtuldu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sıkıntıda çağırdın ve sizi kurtardım.","poem":1},{"text":"Gök gürültüsünün gizli yerinden sana yanıt verdim.","poem":2},{"lineBreak":true},{"text":"Seni Meriva sularında sınadım.” Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Dinle ey halkım, size tanıklık edeceğim.","poem":1},{"text":"Ey İsrael, eğer beni dinlersen!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sende yabancı bir ilâh olmayacak,","poem":1},{"text":"yabancı bir ilâha tapmayacaksın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ben senin Tanrın Yahve'yim,","poem":1},{"text":"seni Mısır diyarından kim çıkardı?","poem":2},{"lineBreak":true},{"text":"Ağzını iyice aç da onu doldurayım.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ama halkım sesimi dinlemedi.","poem":1},{"text":"İsrael beni istemedi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ben de onları yüreklerindeki inatçılığın ardından salıverdim,","poem":1},{"text":"kendi öğütlerince yürüsünler diye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Keşke halkım beni dinleseydi,","poem":1},{"text":"İsrael benim yollarımda yürüseydi!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Düşmanlarını hemen boyun eğdirir,","poem":1},{"text":"elimi düşmanlarına karşı çevirirdim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yahve'den nefret edenler O'nun önünde sinerdi,","poem":1},{"text":"onların cezası sonsuza dek sürerdi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ve onu buğdayın en iyisiyle de beslerdim.","poem":1},{"text":"Seni kayadan bal ile doyururdum.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}