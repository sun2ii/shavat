{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Tanrı büyük toplantıyı yönetir.","poem":1},{"text":"İlahlar arasında hükmeder.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Ne vakte kadar haksızca yargılayacak,","poem":1},{"text":"kötüden yana taraf tutacaksınız?” Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Zayıfı, yoksulu ve yetimi savunun.","poem":1},{"text":"Yoksulun ve ezilenin hakkını koruyun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Güçsüzü, muhtaç olanı kurtarın.","poem":1},{"text":"Onları kötülerin elinden özgür kılın.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bilmiyorlar ve anlamıyorlar.","poem":1},{"text":"Karanlıkta ileri geri yürüyorlar.","poem":2},{"lineBreak":true},{"text":"Yeryüzünün bütün temelleri sarsılıyor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Sizler ilâhlarsınız” dedim.","poem":1},{"text":"“Hepiniz Yüceler Yücesi'nin oğullarısınız.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yine de insanlar gibi öleceksiniz,","poem":1},{"text":"hükümdarlardan biri gibi düşeceksiniz.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kalk, ey Tanrı, yeryüzünü yargıla,","poem":1},{"text":"çünkü bütün ulusları sen miras alacaksın.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}