{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["İlahi - Asaf’ın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Tanrı, susma.","poem":1},{"text":"Sessiz ve sakin kalma, ey Tanrı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü işte, düşmanların ayağa kalkıyor.","poem":1},{"text":"Senden nefret edenler başlarını kaldırdılar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Halkına karşı kurnazca düzen kuruyorlar.","poem":1},{"text":"Değer verdiğin insanlara karşı öğütleşiyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Gelin” diyorlar, “Onları ulus olarak yok edelim.","poem":1},{"text":"Öyle ki, İsrael’in adı bir daha anılmasın.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tek bir akılla düzen kudular.","poem":1},{"text":"Sana karşı ittifak oluşturdular.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Edom'un ve İsmailoğulları'nın çadırları,","poem":1},{"text":"Moavlılar ve Hagarlılar,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geval, Ammon ve Amalek,","poem":1},{"text":"Filist ve Sur halkı,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aşur da onlara katıldı.","poem":1},{"text":"Lut'un çocuklarına yardım ettiler. Selah.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onlara Midyan’a, Kişon Irmağı’nda","poem":1},{"text":"Sisera’ya ve Yavin’e yaptığının aynısını yap,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onlar En-dor’da yok oldular.","poem":1},{"text":"Toprak için gübre gibi oldular.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onların soylularını Orev ve Zeev gibi,","poem":1},{"text":"beylerini Zevah ve Salmunna’ya yaptığın gibi yap.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onlar ki, “Tanrı'nın otlaklarını","poem":1},{"text":"kendimize mülk edinelim” dediler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tanrım, onları çalı gibi,","poem":1},{"text":"rüzgârın önündeki saman çöpü gibi yap.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ormanı yakan ateş gibi,","poem":1},{"text":"dağları tutuşturan alev gibi,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"fırtınanla onların peşlerine düş,","poem":1},{"text":"kasırganla dehşet içinde bırak onları.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yüzlerini şaşkınlıkla kaplat,","poem":1},{"text":"ta ki, adını arasınlar, ey Yahve.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sonsuza dek hayal kırıklığı içinde kalsınlar,","poem":1},{"text":"dehşete düşsünler.","poem":2},{"lineBreak":true},{"text":"Şaşkınlık içinde kalıp yok olsunlar,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"bilsinler ki, yalnız sen, adı Yahve olan,","poem":1},{"text":"tüm yeryüzü üzerinde En Yüce’dir.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}