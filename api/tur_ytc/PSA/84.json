{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Gittit üzerine - Korahoğulları’nın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Ordular Yahvesi,","poem":1},{"text":"meskenlerin ne kadar güzeldir!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Canım Yahve’nin avlularını,","poem":1},{"text":"bayılırmış gibi özlüyor.","poem":2},{"lineBreak":true},{"text":"Yüreğim ve bedenim yaşayan Tanrı’ya haykırıyor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Serçe bile bir yuva,","poem":1},{"text":"kırlangıç yavrularını koyabilecek bir yuva buldu,","poem":2},{"lineBreak":true},{"text":"senin sunaklarının yanında,","poem":2},{"lineBreak":true},{"text":"ey Ordular Yahvesi, Kralım ve Tanrım benim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mutlu senin evinde oturanlara.","poem":1},{"text":"Sürekli seni överler. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne mutlu, gücü sende olanlara,","poem":1},{"text":"yüreklerini Siyon’u ziyaret etmeye koyanlara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ağlama Vadisi'nden geçerken orayı pınarlara çevirirler.","poem":1},{"text":"Sonbahar yağmuru onu bereketle kaplar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gittikçe güçlenirler.","poem":1},{"text":"Her biri Siyon'da Tanrı'nın önünde görünür.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ordular Tanrısı ey Yahve, duamı duy.","poem":1},{"text":"Dinle, ey Yakov'un Tanrısı. Selah.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ey kalkanımız olan Tanrı, bak,","poem":1},{"text":"meshettiğinin yüzünü gör.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü, avlularında bir gün, bin günden iyidir.","poem":1},{"text":"Kötülük çadırlarında oturmaktansa,","poem":2},{"lineBreak":true},{"text":"Tanrım’ın evinin kapıcısı olmayı yeğlerim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü Yahve Tanrı bir güneş, bir kalkandır.","poem":1},{"text":"Yahve lütuf ve yücelik verir.","poem":2},{"lineBreak":true},{"text":"Suçsuz olarak yürüyenlerden hiçbir iyiliği esirgemez.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Ordular Yahvesi,","poem":1},{"text":"ne mutlu sana güvenen insana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}