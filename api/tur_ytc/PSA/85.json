{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - Korahoğulları’nın mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, ülkene iyilik ettin.","poem":1},{"text":"Yakov'un zenginliğini geri getirdin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Halkının suçunu bağışladın.","poem":1},{"text":"Bütün günahlarını örttün. Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bütün gazabını uzaklaştırdın.","poem":1},{"text":"Öfkenin kızgınlığından geri döndün.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Döndür bizi, kurtuluşumuzun Tanrısı,","poem":1},{"text":"bize olan öfkeni dindir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sonsuza dek bize kızgın mı kalacaksın?","poem":1},{"text":"Öfkeni tüm nesillere yayacak mısın?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Halkın sende sevinsin diye,","poem":1},{"text":"bizi yeniden diriltmeyecek misin?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bize sevgi dolu iyiliğini göster, ey Yahve.","poem":1},{"text":"Kurtuluşunu bize bağışla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahve Tanrı’nın ne söyleyeceğini dinleyeceğim.","poem":1},{"text":"Çünkü halkına, kutsallarına esenlik konuşacak,","poem":2},{"lineBreak":true},{"text":"ama onlar bir daha akılsızlığa dönmesinler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kesinlikle O'nun kurtarışı, kendisinden korkanlara yakındır;","poem":1},{"text":"ta ki görkem topraklarımızda otursun.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Merhamet ve gerçek buluştular.","poem":1},{"text":"Doğruluk ve esenlik öpüştüler.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gerçek yerden bitecek.","poem":1},{"text":"Doğruluk gökten aşağıya bakacak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Evet, Yahve iyi olanı verecek.","poem":1},{"text":"Diyarımız, artarak ürün verecektir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Doğruluk O’nun önünden gidecektir,","poem":1},{"text":"adımlarına yol hazırlayacaktır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}