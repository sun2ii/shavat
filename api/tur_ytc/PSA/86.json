{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["David’in duası"]},{"type":"verse","number":1,"content":[{"text":"Duy, ey Yahve, yanıtla beni,","poem":1},{"text":"çünkü ben yoksul ve muhtacım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Canımı koru, çünkü ben tanrısal biriyim.","poem":1},{"text":"Sen Tanrım, sana güvenen hizmetkârını kurtar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bana merhamet et, ey Efendim,","poem":1},{"text":"çünkü bütün gün sana sesleniyorum.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hizmetkârının canını sevindir,","poem":1},{"text":"çünkü canımı sana kaldırıyorum, ey Efendim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü sen iyisin, bağışlamaya hazırsın, ey Efendi","poem":1},{"text":"seni çağıran herkese karşı","poem":2},{"lineBreak":true},{"text":"boldur sevgi dolu iyiliğin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Duamı duy, ey Yahve.","poem":1},{"text":"Dileklerimin sesine kulak ver.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sıkıntılı günümde seni çağırırım,","poem":1},{"text":"çünkü sen beni yanıtlarsın.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"İlahlar arasında senin gibisi yoktur, ey Efendim,","poem":1},{"text":"işlerin de benzersizdir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yarattığın bütün uluslar gelip sana tapınacaklar, ey Efendim.","poem":1},{"text":"Adını yüceltecekler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Çünkü sen büyüksün ve şaşılası işler yaparsın.","poem":1},{"text":"Yalnız Tanrı sensin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey Yahve, yolunu bana öğret.","poem":1},{"text":"Senin gerçeğinde yürüyeyim.","poem":2},{"lineBreak":true},{"text":"Adından korkmak için yüreğimi tam kıl.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Efendi Tanrım, bütün yüreğimle seni öveceğim.","poem":1},{"text":"Adını daima yücelteceğim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü bana karşı sevgi dolu iyiliğin büyüktür.","poem":1},{"text":"Canımı Şeol'ün","poem":2},{"noteId":27},{"text":"derinliğinden kurtardın.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ey Tanrı, gururlular bana karşı ayağa kalktılar.","poem":1},{"text":"Zorbalar takımı canımın peşine düştü,","poem":2},{"lineBreak":true},{"text":"kendi önlerinde sana saygıları yoktur.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ama sen, ey Efendim merhametli ve lütufkâr bir Tanrı’sın.","poem":1},{"text":"Yavaş öfkelenirsin, sevgi dolu iyiliğin ve gerçeğin boldur.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bana dön de merhamet et!","poem":1},{"text":"Gücünü hizmetkârına ver.","poem":2},{"lineBreak":true},{"text":"Hizmetkârının oğlunu kurtar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bana iyiliğinin bir işaretini göster,","poem":1},{"text":"ta ki, benden nefret edenler bunu görüp utansınlar,","poem":2},{"lineBreak":true},{"text":"çünkü sen, ey Yahve, bana yardım ettin ve beni teselli ettin.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":86,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}