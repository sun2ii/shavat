n sayacak,","poem":1},{"text":"“Bu orada doğmuştur.” Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dans edenlerle şarkı söyleyenler şöyle diyecek:","poem":1},{"text":"“Bütün kaynaklarım sendedir.”","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Rahav Mısır'a atıf yapmaktadır.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/tur_ytc/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}