{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["Korahoğulları’nın mezmuru - İlahi - Müzik şefi için - “Mahalat Leannot” makamında - Ezrahlı Heman Maskili"]},{"type":"verse","number":1,"content":[{"text":"Ey Yahve, kurtuluşumun Tanrısı,","poem":1},{"text":"gündüz ve gece senin önünde yakardım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Duam senin önüne gelsin.","poem":1},{"text":"Yakarışıma kulağını eğ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü canım sıkıntılarla dolu.","poem":1},{"text":"Hayatım Şeol'e","poem":2},{"noteId":29},{"text":"yaklaştı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çukura inenler arasında sayılıyorum.","poem":1},{"text":"Yardımcısı olmayan biri gibiyim,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ölüler arasına ayrılmış,","poem":1},{"text":"artık hatırlamadığın,","poem":2},{"lineBreak":true},{"text":"Mezarda yatan öldürülmüşler gibiyim.","poem":2},{"lineBreak":true},{"text":"Onlar senin elinden ayrılmıştır.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beni en derin çukura,","poem":1},{"text":"en karanlık derinliklerde koydun.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gazabının ağırlığı üzerimdedir.","poem":1},{"text":"Bütün dalgalarınla beni ezdin. Selah.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dostlarımı benden aldın.","poem":1},{"text":"Beni onlara iğrenç kıldın.","poem":2},{"lineBreak":true},{"text":"Kapatıldım ve kaçamıyorum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kederden gözlerim sönüyor.","poem":1},{"text":"Her gün seni çağırdım, ey Yahve.","poem":2},{"lineBreak":true},{"text":"Ellerimi sana açtım.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Harikalarını ölülere mi göstereceksin?","poem":1},{"text":"Göçüp gitmiş olan ruhlar mı kalkıp seni övecek? Selah.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sevgi dolu iyiliğin mezarda,","poem":1},{"text":"sadakatin yıkım diyarında mı ilan edilir?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Harikaların karanlıkta,","poem":1},{"text":"sadakatin unutulmuşluk diyarında mı bilinir?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ama ben ey Yahve, sana yakardım.","poem":1},{"text":"Sabahleyin duam huzuruna gelir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ey Yahve, canımı neden reddediyorsun?","poem":1},{"text":"Neden yüzünü benden gizliyorsun?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gençliğimden beri dertliyim ve ölmeye hazırım.","poem":1},{"text":"Senin dehşetlerine katlanırken, şaşkınım.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Şiddetli öfken üzerime çöktü.","poem":1},{"text":"Dehşetlerin beni yok etti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bütün gün su gibi çevremi sardılar.","poem":1},{"text":"Beni tamamen içine aldılar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sevgiliyi, dostu benden uzaklaştırdın,","poem":1},{"text":"dostlarım da karanlıktadır.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":88,"verse":3}}]},"thisChapterLink":"/api/tur_ytc/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}