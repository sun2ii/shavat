{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["Ezrahlı Eytan’ın Maskili"]},{"type":"verse","number":1,"content":[{"text":"Yahve’nin sevgi dolu iyiliğini daima ezgilerle öveceğim.","poem":1},{"text":"Senin sadakatini bütün kuşaklara ağzımla duyuracağım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Doğrusu şunu derim:","poem":1},{"text":"“Sevgi sonsuza dek durur.","poem":2},{"lineBreak":true},{"text":"Gökleri sen kurdun.","poem":2},{"lineBreak":true},{"text":"Senin sadakatin onlardadır.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Seçtiğim kişiyle antlaşma yaptım,","poem":1},{"text":"hizmetkârım David’e ant içtim:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Senin soyunu daima sürdüreceğim,","poem":1},{"text":"tahtını bütün nesiller için kuracağım.’” Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Yahve, gökler harikalarını,","poem":1},{"text":"sadakatini de kutsallar topluluğunda överler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Göklerde kim Yahve’yle kıyaslanabilir?","poem":1},{"text":"Göksel varlıkların oğulları arasında","poem":2},{"lineBreak":true},{"text":"Yahve’ye benzeyen kimdir?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kutsallar topluluğunda çok heybetli bir Tanrı’dır,","poem":1},{"text":"çevresinde olanların hepsinden korkunçtur.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey Yahve, Ordular Tanrısı,","poem":1},{"text":"senin gibi güçlü olan kimdir?","poem":2},{"lineBreak":true},{"text":"Ey Yah, sadakatin de çevrendedir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Denizin gururuna hükmedersin.","poem":1},{"text":"Dalgaları kabardığında onları sakinleştirirsin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Rahav'ı öldürülmüş bir adam gibi parçaladın.","poem":1},{"text":"Güçlü kolunla düşmanlarını dağıttın.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gökler senindir.","poem":1},{"text":"Dünya ve onun doluluğuyla birlikte,","poem":2},{"lineBreak":true},{"text":"yeryüzü de senindir.","poem":2},{"lineBreak":true},{"text":"Onları sen kurdun.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuzeyi ve güneyi sen yarattın.","poem":1},{"text":"Tabor ve Hermon senin adınla sevinirler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Güçlü kolun var.","poem":1},{"text":"Elin kuvvetlidir, sağ elin yücedir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Doğruluk ve adalet tahtının temelidir.","poem":1},{"text":"Sevgi dolu iyilik ve gerçek yüzünün önünden gider.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne mutlu seni alkışlamayı öğrenen halka.","poem":1},{"text":"Senin varlığının ışığında yürürler, ey Yahve.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bütün gün senin adınla sevinirler.","poem":1},{"text":"Senin doğruluğunla yükselirler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü sen onların gücünün yüceliğisin.","poem":1},{"text":"Senin lütfunla, boynuzumuz yükselir.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü kalkanımız Yahve’ye aittir,","poem":1},{"text":"Kralımız İsrael'in Kutsalı'na.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sonra kutsallarına görümde konuşup şöyle dedin:","poem":1},{"text":"“Savaşçıya güç verdim.","poem":2},{"lineBreak":true},{"text":"Bir genci halkın arasından yükselttim.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hizmetkârım David'i buldum.","poem":1},{"text":"Onu kutsal yağımla meshettim,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"elimi onunla pekiştireceğim.","poem":1},{"text":"Kolum da onu güçlendirecektir.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hiçbir düşman ondan haraç almayacak.","poem":1},{"text":"Hiçbir kötü kişi onu ezmeyecektir.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Düşmanlarını onun önünde yere sereceğim,","poem":1},{"text":"ondan nefret edenleri vuracağım.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ama sadakatim ve sevgi dolu iyiliğim onunla birlikte olacak.","poem":1},{"text":"Onun boynuzu benim adımla yükselecektir.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Elini de deniz üzerine,","poem":1},{"text":"sağ elini ırmakların üzerine koyacağım.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bana şöyle seslenecek: ‘Sen benim Babamsın,","poem":1},{"text":"Tanrım ve kurtuluşumun kayası!’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ben de onu ilk oğlum,","poem":1},{"text":"dünya krallarının en yücesi olarak atayacağım.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ona olan sevgi dolu iyiliğimi sonsuza dek sürdüreceğim.","poem":1},{"text":"Onunla antlaşmamı sabit kılacağım.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Soyunu da sonsuza dek kalıcı,","poem":1},{"text":"tahtını göğün günleri gibi yapacağım.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Eğer çocukları yasamı terkederse,","poem":1},{"text":"kurallarıma göre yürümezlerse;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"eğer yasalarımı çiğnerlerse,","poem":1},{"text":"buyruklarımı tutmazlarsa;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"o zaman günahlarını değnekle,","poem":1},{"text":"kötülüklerini sopayla cezalandıracağım.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ama sevgi dolu iyiliğimi ondan tümüyle geri almam.","poem":1},{"text":"Sadakatimi boşa çıkarmam.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Antlaşmamı bozmayacak,","poem":1},{"text":"dudaklarımın söylediklerini değiştirmeyeceğim.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bir kere kutsallığım üzerine ant içtim,","poem":1},{"text":"David'e yalan söylemeyeceğim.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Onun soyu sonsuza dek,","poem":1},{"text":"tahtı önümde güneş gibi duracak.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Gökyüzündeki sadık tanık ay gibi,","poem":1},{"text":"sonsuza dek duracak.” Selah.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ama sen reddettin ve attın.","poem":1},{"text":"Meshettiğine öfkelendin.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Hizmetkârının antlaşmasından vazgeçtin.","poem":1},{"text":"Onun tacını toz toprakla kirlettin.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Onun bütün surlarını yıktın.","poem":1},{"text":"Kalelerini harabeye çevirdin.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yoldan geçen herkes onu soydu.","poem":1},{"text":"Komşuları için bir utanç haline geldi.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Düşmanlarının sağ elini yükselttin.","poem":1},{"text":"Bütün düşmanlarını sevindirdin.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kılıcının ağzını da döndürdün,","poem":1},{"text":"savaşta ona destek olmadın.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Onun ihtişamına son verdin,","poem":1},{"text":"tahtını yere çaldın.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Gençlik günlerini kısalttın.","poem":1},{"text":"Onu utançla kapladın. Selah.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ne vakte kadar, ey Yahve?","poem":1},{"text":"Kendini sonsuza dek mi gizleyeceksin?","poem":2},{"lineBreak":true},{"text":"Ne vakte kadar, gazabın ateş gibi yanacak?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Zamanımın ne kadar kısa olduğunu hatırla,","poem":1},{"text":"insanoğullarının hepsini ne denli boş yaratmışsın!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Yaşayıp da ölümü görmeyen,","poem":1},{"text":"Şeol'ün","poem":2},{"noteId":30},{"text":"gücünden canını kurtaran biri var mı? Selah.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Ey Efendim, nerede o eski sevgi dolu iyiliğin,","poem":1},{"text":"sadakatinle David’e ant içttiğin?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Unutma, ey Efendi, hizmetkârının aşağılanmasını,","poem":1},{"text":"bütün güçlü halkların alaylarını nasıl bağrımda taşıdığımı,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"düşmanların onunla alay ettiler, ey Yahve,","poem":1},{"text":"meshettiğinin ayak izleriyle alay ettiler.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Sonsuza dek övgüler olsun Yahve’ye.","poem":1},{"text":"Amin ve Amin.","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":89,"verse":48}}]},"thisChapterLink":"/api/tur_ytc/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}