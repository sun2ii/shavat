{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["Müzik şefi için - “Oğulun Ölümü” makamında - David’in mezmuru"]},{"type":"verse","number":1,"content":[{"text":"Bütün yüreğimle Yahve’ye şükredeceğim.","poem":1},{"text":"Şaşkınlık verici işlerinin hepsini anlatacağım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sende sevinip coşacağım.","poem":1},{"text":"Adına ilahiler söyleyeceğim, ey Yüceler Yücesi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Düşmanlarım geri çekilirken,","poem":1},{"text":"senin önünde tökezleyip yok oluyorlar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü haklı davamı sen gördün.","poem":1},{"text":"Tahtında oturur adil şekilde yargılarsın.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ulusları azarladın.","poem":1},{"text":"Kötüleri yok ettin.","poem":2},{"lineBreak":true},{"text":"Adlarını sonsuza dek sildin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Düşman sonsuz yıkıma uğradı.","poem":1},{"text":"Yerinden söküp attığın kentlerin anıları bile yok oldu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ama Yahve sonsuza dek hüküm sürer.","poem":1},{"text":"Tahtını yargı için hazırlamıştır.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dünyayı doğrulukla yargılayacak.","poem":1},{"text":"O, halkları doğrulukla yargılayacaktır.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve ezilenler için bir sığınak,","poem":1},{"text":"sıkıntılı zamanlarda yüksek bir kuledir.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Adını bilenler sana güvenecekler,","poem":1},{"text":"çünkü sen, ey Yahve, seni arayanları terk etmezsin.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siyon'da oturan Yahve’yi ilahilerle övün,","poem":1},{"text":"yaptıklarını halklar arasında ilan edin.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Çünkü kanın öcünü alan onları hatırlar.","poem":1},{"text":"Mazlumların feryadını unutmaz.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bana merhamet et, ey Yahve.","poem":1},{"text":"Benden nefret edenler yüzünden çektiğim acıyı gör,","poem":2},{"lineBreak":true},{"text":"beni ölümün kapılarından kaldır da,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"övgülerinin tümünü gösterebileyim.","poem":1},{"text":"Siyon kızının kapılarında kurtarışınla sevineceğim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uluslar kazdıkları çukura düştüler.","poem":1},{"text":"Gizledikleri ağ kendi ayaklarına takıldı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yahve kendisini tanıttı.","poem":1},{"text":"Yargısını gerçekleştirdi.","poem":2},{"lineBreak":true},{"text":"Kötü kişi kendi ellerinin işiyle tuzağa düştü. Higayon - Selah.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kötüler Şeol'e","poem":1},{"noteId":8},{"text":"döndürüleceklerdir.","poem":1},{"text":"Tanrı’yı unutan tüm uluslar da.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Çünkü yoksullar hep unutulmayacak,","poem":1},{"text":"mazlumun umudu sonsuza dek yok olmayacak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kalk, ey Yahve! İnsan galip çıkmasın.","poem":1},{"text":"Uluslar senin önünde yargılansın.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Onları korkut, ey Yahve.","poem":1},{"text":"Uluslar, yalnızca insan olduklarını bilsinler. Selah.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":9,"verse":17}}]},"thisChapterLink":"/api/tur_ytc/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}