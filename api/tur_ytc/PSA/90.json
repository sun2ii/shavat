{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["Tanrı",{"noteId":31},"adamı Moşe’nın duası"]},{"type":"verse","number":1,"content":[{"text":"Ey Efendi,","poem":1},{"noteId":32},{"text":"bütün kuşaklar boyunca","poem":1},{"text":"sen bizim meskenimiz oldun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dağlar doğmadan önce,","poem":1},{"text":"sen yeryüzünü ve dünyayı yaratmadan önce,","poem":2},{"lineBreak":true},{"text":"öncesizlikten sonsuza dek, Tanrı sensin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İnsanı yıkıp şöyle dersin:","poem":1},{"text":"“Geri dönün, insanoğulları.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü senin gözünde bin yıl geçmiş dün gibi,","poem":1},{"text":"gece nöbeti gibidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyuduklarında onları süpürürsün.","poem":1},{"text":"Sabahleyin biten ot gibidirler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sabahleyin filizlenip yeşerir,","poem":1},{"text":"akşama doğru solup kurur.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Çünkü senin öfkenle tükeniriz.","poem":1},{"text":"Gazabınla şaşkına döneriz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kötülüklerimizi önüne,","poem":1},{"text":"gizli günahlarımızı senin varlığının ışığına koydun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü bütün günlerimiz senin gazabında geçiyor.","poem":1},{"text":"Yıllarımızı bir soluk gibi bitirmekteyiz.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yıllarımızın günleri yetmiş,","poem":1},{"text":"ya da gücünle sekseni bulursa,","poem":2},{"lineBreak":true},{"text":"yine de onların en parlak zamanı emek ve kederdir,","poem":2},{"lineBreak":true},{"text":"çünkü çabuk geçiyor ve uçup gidiyoruz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Öfkenin gücünü,","poem":1},{"text":"gazabını sana duyulan korkuya göre kim bilebilir?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Öyleyse bize günlerimizi saymayı öğret,","poem":1},{"text":"öyle ki, bilge bir yürek kazanalım.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Acı, ey Yahve!","poem":1},{"noteId":33},{"text":"Ne vakte kadar?","poem":2},{"lineBreak":true},{"text":"Hizmetkârlarına merhamet et!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sabahleyin bizi sevgi dolu iyiliğinle doyur,","poem":1},{"text":"öyle ki, tüm günlerimiz boyunca sevinip mutlu olalım.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bizi sıkıntıya soktuğun günler kadar,","poem":1},{"text":"lötülük gördüğümüz yıllar kadar bizi sevindir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İşin hizmetkârlarına,","poem":1},{"text":"yüceliğin onların çocuklarına görünsün.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanrımız Yahve’nin lütfu üzerimizde olsun.","poem":1},{"text":"Ellerimizin işini bizim için pekiştir.","poem":2},{"lineBreak":true},{"text":"Evet, ellerimizin işini pekiştir.","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"“Tanrı” olarak tercüme edilen İbranice kelime “אֱלֹהִ֑ים” (Elohim)’dir.","reference":{"chapter":90,"verse":0}},{"noteId":32,"caller":"+","text":"“Efendi” olarak tercüme edilen sözcük “Adonay”dır.","reference":{"chapter":90,"verse":1}},{"noteId":33,"caller":"+","text":"“Yahve” Tanrı’nın asıl ismidir, diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harflerle) olarak çevrilir.","reference":{"chapter":90,"verse":13}}]},"thisChapterLink":"/api/tur_ytc/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}