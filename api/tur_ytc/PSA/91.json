{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Yüceler Yücesi'nin gizli yerinde oturan","poem":1},{"text":"Her Şeye Gücü Yeten’in gölgesinde dinlenir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve için derim: “O benim sığınağım ve kalemdir,","poem":1},{"text":"Tanrım’dır, O’na güvenirim.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü O seni avcı tuzağından,","poem":1},{"text":"ölümcül salgından kurtarır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Seni kanatlarıyla örter.","poem":1},{"text":"O’nun kanatları altına sığınırsın.","poem":2},{"lineBreak":true},{"text":"O’nun sadakati senin kalkanın ve siperindir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne gecenin dehşetinden korkarsın,","poem":1},{"text":"ne de gündüz uçan oktan,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne karanlıkta dolaşan salgın hastalıktan,","poem":1},{"text":"ne de öğle vakti bitiren yıkımdan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yanında bin kişi,","poem":1},{"text":"sağında on bin kişi düşebilir,","poem":2},{"lineBreak":true},{"text":"ama sana yaklaşmaz.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sen yalnız gözlerinle bakacak,","poem":1},{"text":"kötülerin cezasını göreceksin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü sen Yahve’yi sığınak,","poem":1},{"text":"En Yüce Olan’ı kendine konut edindiğin için,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"başına kötülük gelmeyecek,","poem":1},{"text":"evine felaket yaklaşmayacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Çünkü tüm yollarında seni korusunlar diye,","poem":1},{"text":"senin için meleklerini sorumlu kılacak,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayağın bir taşa çarpmasın diye,","poem":1},{"text":"seni elleri üzerinde taşıyacaklar,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aslanın ve kobranın üzerine basacaksın.","poem":1},{"text":"Genç aslanı ve yılanı ayaklarının altında çiğneyeceksin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Sevgisini bana bağladığı için onu kurtaracağım.","poem":1},{"text":"Adımı bildiği için onu yücelteceğim.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Beni çağıracak, ben de ona yanıt vereceğim.","poem":1},{"text":"Sıkıntıda onun yanında olacağım.","poem":2},{"lineBreak":true},{"text":"Onu kurtaracak ve yücelteceğim.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onu uzun ömürle doyuracağım,","poem":1},{"text":"ona kurtarışımı göstereceğim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}