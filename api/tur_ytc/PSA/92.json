{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Mezmur - Şabat Günü için ilahi"]},{"type":"verse","number":1,"content":[{"text":"Yahve’ye şükretmek,","poem":1},{"text":"ey Yüceler Yücesi, adını ilahilerle övmek,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"sabahları sevgi dolu iyiliğini,","poem":1},{"text":"her gece sadakatini,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"on telli sazla, arpla,","poem":1},{"text":"lirin ezgisiyle duyurmak ne iyidir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü, ey Yahve, işinle beni sevindirdin.","poem":1},{"text":"Senin ellerinin işleriyle zafer kazanıyorum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İşlerin ne büyüktür, ey Yahve!","poem":1},{"text":"Düşüncelerin çok derindir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akılsız insan bilmez,","poem":1},{"text":"budala da bunu anlamaz:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kötüler ot gibi bitse de,","poem":1},{"text":"kötülük edenlerin tümü serpilip gelişse de,","poem":2},{"lineBreak":true},{"text":"onlar sonsuza dek yok edilecekler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ama sen, ey Yahve, sonsuza dek yücelerdesin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Çünkü işte, senin düşmanların, ey Yahve,","poem":1},{"text":"çünkü işte, düşmanların yok olacak.","poem":2},{"lineBreak":true},{"text":"Bütün kötülük yapanlar dağılacaktır.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ama sen benim boynuzumu","poem":1},{"text":"yaban öküzünki gibi yükselttin.","poem":2},{"lineBreak":true},{"text":"Taze yağla meshedildim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gözüm düşmanlarımı da gördü.","poem":1},{"text":"Kulaklarım bana karşı çıkan kötü düşmanları duydu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Doğrular palmiye ağacı gibi serpilip gelişecektir.","poem":1},{"text":"Lübnan'daki sedir ağacı gibi büyüyecektir.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onlar Yahve’nin evine dikilmişlerdir.","poem":1},{"text":"Tanrımız’ın avlularında serpilip gelişeceklerdir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onlar yaşlılıklarında da meyve verecekler.","poem":1},{"text":"Taze ve yemyeşil olacaklar,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ta ki, Yahve’nin doğru olduğunu göstersinler.","poem":1},{"text":"O benim kayamdır,","poem":2},{"lineBreak":true},{"text":"ve O’nda hiç haksızlık bulunmaz.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}