{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"Ey Yahve, sen öcün sahibi olan Tanrı’sın,","poem":1},{"text":"ey öcün sahibi olan Tanrı, parla.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalk, ey yeryüzünün yargıcı.","poem":1},{"text":"Küstahlara hak ettikleri karşılığı ver.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ey Yahve, kötüler ne zamana dek,","poem":1},{"text":"ne zamana dek zafer kazanacaklar?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Küstahça sözler saçıyorlar.","poem":1},{"text":"Kötülük edenlerin hepsi övünüyorlar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Yahve, halkını parçalıyorlar,","poem":1},{"text":"mirasına eziyet ediyorlar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dul kadını ve garibi katlediyorlar,","poem":1},{"text":"yetimleri öldürüyorlar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Yah görmez” diyorlar,","poem":1},{"text":"“Yakov'un Tanrısı dikkate almaz.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey sizler, halk arasındaki akılsızlar, dikkat edin,","poem":1},{"text":"siz ey ahmaklar, ne zaman akıllanacaksınız?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kulağı yerleştiren duymaz mı?","poem":1},{"text":"Göze biçim veren görmez mi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ulusları terbiye eden, cezalandırmaz mı?","poem":1},{"text":"İnsana öğreten bilir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahve insanın düşüncelerinin,","poem":1},{"text":"boş olduğunu bilir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey Yah, ne mutlu terbiye ettiğin,","poem":1},{"text":"yasanı öğrettiğin insana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kötüler için çukur kazılıncaya dek,","poem":1},{"text":"sıkıntılı günlerde ona rahat verirsin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Çünkü Yahve halkını geri çevirmez,","poem":1},{"text":"mirasını da bırakmaz.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Çünkü yargı adalete dönecektir.","poem":1},{"text":"Dürüst yüreklilerin hepsi onu izleyecektir.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kötülere karşı benim için kim kalkacak?","poem":1},{"text":"Kötülük edenlere karşı kim beni savunacak?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yahve yardımcım olmasaydı,","poem":1},{"text":"canım hemen sessizlik içinde çökerdi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Ayağım kayıyor!” dediğimde,","poem":1},{"text":"sevgi dolu iyiliğin beni ayakta tuttu, ey Yahve.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"İçimdeki düşüncelerin çokluğunda,","poem":1},{"text":"senin avutmaların canımı sevindiriyor.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yasayla kötülük eden şer tahtı,","poem":1},{"text":"seninle paydaşlık içinde olur mu?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doğru insanın canına karşı toplanıyorlar,","poem":1},{"text":"masum kanı mahkûm ediyorlar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ama Yahve benim yüksek kulem oldu,","poem":1},{"text":"Tanrım sığındığım kaya oldu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"kötülüklerini başlarına döndürdü,","poem":1},{"text":"kendi kötülükleriyle onları kesip atacaktır.","poem":2},{"lineBreak":true},{"text":"Tanrımız Yahve onları kesip atacaktır.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}