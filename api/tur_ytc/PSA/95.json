{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Gelin, Yahve'ye ezgiler söyleyelim.","poem":1},{"text":"Kurtuluşumuzun kayasına yüksek sesle haykıralım!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Şükranla huzuruna çıkalım.","poem":1},{"text":"O’nu ezgilerle yüceltelim!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Çünkü Yahve büyük Tanrı’dır,","poem":1},{"text":"tüm ilâhların üstünde büyük Kral’dır.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yerin derinlikleri O’nun elindedir.","poem":1},{"text":"Dağların tepeleri de O’nundur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Deniz O’nundur ve onu yaratan kendisidir.","poem":1},{"text":"Karaya biçim veren O’nun elleridir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gelin, tapınalım, eğilelim.","poem":1},{"text":"Yaratıcımız Yahve'nin önünde diz çökelim,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"çünkü Tanrımız O’dur.","poem":1},{"text":"Biz O’nun otlağının halkı,","poem":2},{"lineBreak":true},{"text":"gözetimindeki koyunlarız.","poem":2},{"lineBreak":true},{"text":"Keşke bugün O’nun sesini duysanız!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Meriva'da ve o gün Masa Çölü’nde olduğu gibi","poem":1},{"text":"yüreğinizi katılaştırmayın,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"atalarınız beni denediklerinde,","poem":1},{"text":"beni sınadıklarında, işimi de görmüşlerdi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kırk yıl boyunca o kuşakla kederlendim,","poem":1},{"text":"“Bunlar, yürekleri kusurlu bir halktır” dedim.","poem":2},{"lineBreak":true},{"text":"“Yollarımı bilmediler.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bunun için öfkemle ant içtim:","poem":1},{"text":"“Benim dinlenme yerime girmeyecekler.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}