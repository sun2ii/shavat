{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve’ye yeni bir ezgi söyleyin!","poem":1},{"text":"Tüm yeryüzü Yahve’ye ezgi söyleyin.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ezgi söyleyin Yahve’ye!","poem":1},{"text":"Adını yüceltin!","poem":2},{"lineBreak":true},{"text":"Kurtarışını günden güne duyurun!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Görkemini uluslar arasında,","poem":1},{"text":"şaşılası işlerini bütün halklar arasında ilan edin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Çünkü Yahve büyüktür, fazlasıyla övülmeye layıktır!","poem":1},{"text":"Bütün ilâhlardan çok O’ndan korkulmalıdır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Çünkü halkların bütün ilâhları puttur,","poem":1},{"text":"gökleri yaratansa Yahve’dir.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saygınlık ve ululuk O’nun önündedir.","poem":1},{"text":"Güç ve güzellik O’nun tapınağındadır.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey ulusların soyları, Yahve’ye verin,","poem":1},{"text":"yüceliği ve gücü Yahve’ye verin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Adından ötürü yüceliği Yahve’ye verin.","poem":1},{"text":"Sunu getirip avlularına girin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve’ye kutsal düzen içinde tapının.","poem":1},{"text":"Önünde titreyin, tüm yeryüzü.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uluslar arasında, “Yahve hüküm sürüyor” deyin.","poem":1},{"text":"Dünya da pekiştirilmiştir, sarsılmaz.","poem":2},{"lineBreak":true},{"text":"Halkları adaletle yargılar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gökler sevinsin, yeryüzü coşsun.","poem":1},{"text":"Deniz ve içindeki doluluk gürlesin!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kır ve içindekilerin tümü coşsun!","poem":1},{"text":"O zaman ormandaki bütün ağaçlar,","poem":2},{"lineBreak":true},{"text":"sevinçle şarkı söyleyecek,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yahve’nin önünde,","poem":1},{"text":"çünkü O geliyor,","poem":2},{"lineBreak":true},{"text":"yeryüzünü yargılamaya geliyor.","poem":2},{"lineBreak":true},{"text":"Dünyaya doğrulukla,","poem":2},{"lineBreak":true},{"text":"halklara gerçeğiyle hükmedecek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}