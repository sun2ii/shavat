{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve hükmediyor, coşsun yeryüzü!","poem":1},{"text":"Bütün adalar sevinsin!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bulutlar ve karanlık çevresindedir.","poem":1},{"text":"Doğruluk ve adalet O’nun tahtının temelidir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O’nun önünden ateş yürüyor,","poem":1},{"text":"düşmanlarını her yandan yakıyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Şimşeği dünyayı aydınlatır.","poem":1},{"text":"Yeryüzü görüp titrer.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahve’nin önünde,","poem":1},{"text":"tüm yeryüzünün Efendisi önünde dağlar balmumu gibi eridi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gökler O’nun doğruluğunu ilan eder.","poem":1},{"text":"Bütün halklar O’nun yüceliğini gördü.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oyma putlara hizmet edenlerin hepsi,","poem":1},{"text":"putlarıyla övünenler, utansınlar.","poem":2},{"lineBreak":true},{"text":"Ey bütün ilâhlar,","poem":2},{"noteId":34},{"text":"O’na tapın!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siyon duydu ve sevindi.","poem":1},{"text":"Senin hükümlerinden ötürü, ey Yahve,","poem":2},{"lineBreak":true},{"text":"Yahuda kızları coştu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Çünkü, ey Yahve, tüm yeryüzünde En Yüce Olan sensin.","poem":1},{"text":"Bütün ilâhların üstünde çok yücesin.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ey sizler, Yahve’yi sevenler, kötülükten nefret edin!","poem":1},{"text":"O, kutsallarının canlarını korur.","poem":2},{"lineBreak":true},{"text":"Onları kötülerin elinden kurtarır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Doğru için ışık,","poem":1},{"text":"yüreği dürüst olanlara sevinç ekilmiştir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey doğrular, Yahve’de sevinin!","poem":1},{"text":"O’nun kutsal Adına şükredin.","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"LXX'te “ilâhlar” yerine “melekler” ifadesi yer alıyor.","reference":{"chapter":97,"verse":7}}]},"thisChapterLink":"/api/tur_ytc/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}