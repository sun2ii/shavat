{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Mezmur"]},{"type":"verse","number":1,"content":[{"text":"Yahve’ye yeni bir ezgi söyleyin,","poem":1},{"text":"çünkü O şaşılası şeyler yaptı!","poem":2},{"lineBreak":true},{"text":"Sağ eli ve kutsal kolu kendisi için kurtuluş sağladı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve kurtarışını bildirdi.","poem":1},{"text":"Doğruluğunu ulusların önünde açıkça gösterdi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İsrael halkına olan sevgi dolu iyiliğini ve sadakatini hatırladı.","poem":1},{"text":"Yeryüzünün bütün uçları Tanrımız’ın kurtarışını gördü.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey bütün yeryüzü Yahve’ye sevinçle haykırın!","poem":1},{"text":"Neşeyle ortalığı çınlatın, ezgiler söyleyin!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Arpla Yahve’ye ezgiler söyleyin,","poem":1},{"text":"arp ve melodiyle ezgiler söyleyin.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Borularla ve koç boynuzu sesiyle,","poem":1},{"text":"Kral olan Yahve’nin önünde sevinçle haykırın.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deniz doluluğuyla,","poem":1},{"text":"dünya ve onda oturanlar gürlesin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Irmaklar el çırpsın.","poem":1},{"text":"Dağlar hep birlikte sevinçle haykırsın.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahve’nin önünde ezgi söylesinler,","poem":1},{"text":"çünkü O geliyor, yeryüzüne hükmetmeye.","poem":2},{"text":"Dünyayı doğrulukla,","poem":1},{"text":"halklara adaletle hükmedecek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}