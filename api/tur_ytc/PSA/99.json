{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"PSA","translationId":"tur_ytc","name":"MEZMURLAR","commonName":"MEZMURLAR","title":"MEZMURLAR","order":19,"numberOfChapters":150,"sha256":"ae55d5b7a0164f864476490c9205e8014393f61affa013f17ba423cc97363fc4","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tur_ytc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Yahve hüküm sürüyor! Titresin halklar.","poem":1},{"text":"Keruvlar arasında tahtında oturmuş.","poem":2},{"lineBreak":true},{"text":"Sarsılsın yeryüzü.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahve Siyon'da büyüktür.","poem":1},{"text":"O, bütün halkların üstünde yücedir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Büyük ve heybetli adını övsünler.","poem":1},{"text":"O Kutsal’dır!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kral’ın gücü adaleti de sever.","poem":1},{"text":"Doğruluğu sen kurarsın.","poem":2},{"lineBreak":true},{"text":"Yakov'da adalet ve doğruluğu sen gerçekleştirirsin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tanrımız Yahve’yi yüceltin.","poem":1},{"text":"Ayaklarının taburesinde tapının.","poem":2},{"lineBreak":true},{"text":"O Kutsal’dır!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moşe'yle Aron O’nun kâhinleri arasındaydı.","poem":1},{"text":"Samuel adını çağıranlar arasındaydı.","poem":2},{"lineBreak":true},{"text":"Yahve’yi çağırdılar, O da onlara yanıt verdi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bulut sütunu içinde onlarla konuştu.","poem":1},{"text":"O’nun tanıklıklarını ve kendilerine vermiş olduğu kuralları tuttular.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ey Tanrımız Yahve, sen onlara yanıt verdin,","poem":1},{"text":"yaptıklarının karşılığını ödetmiş olsan da,","poem":2},{"lineBreak":true},{"text":"onları bağışlayan bir Tanrı oldun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tanrımız Yahve’yi yüceltin.","poem":1},{"text":"Kutsal dağında tapının,","poem":2},{"lineBreak":true},{"text":"çünkü Tanrımız Yahve kutsaldır!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}