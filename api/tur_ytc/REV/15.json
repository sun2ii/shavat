{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"REV","translationId":"tur_ytc","name":"VAHİY","commonName":"VAHİY","title":"VAHİY","order":66,"numberOfChapters":22,"sha256":"7ec5aa45432f7b964ccedd41d20e968da63824cfba991dde67335b9490294e5a","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/tur_ytc/REV/22.json","totalNumberOfVerses":402},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Gökyüzünde büyük şaşkınlık verici başka bir belirti gördüm: Son yedi belayı taşıyan yedi melekti. Çünkü Tanrı’nın gazabı onlarla sona eriyordu."]},{"type":"verse","number":2,"content":["Ateşle karışık camdan deniz gibi bir şey gördüm. Canavarı, onun suretini ve adının sayısını yenenler cam denizin üzerinde ellerinde Tanrı’nın arplarıyla durmuşlardı."]},{"type":"verse","number":3,"content":["Tanrı’nın hizmetkârı Moşe’nin ezgisini ve Kuzu’nun ezgisini söylüyorlardı:",{"text":"“Her Şeye Gücü Yeten Efendi Tanrı,","poem":1},{"text":"senin işlerin büyük ve şaşılasıdır,","poem":2},{"lineBreak":true},{"text":"ey ulusların Kralı,","poem":2},{"lineBreak":true},{"text":"senin yolların doğru ve adildir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ey Efendimiz senden kim korkmaz,","poem":1},{"text":"adını kim yüceltmez?","poem":2},{"text":"Çünkü yalnız sen kutsalsın.","poem":1},{"text":"Bütün uluslar gelip önünde tapınacaklar.","poem":2},{"lineBreak":true},{"text":"Çünkü doğru işlerin ortaya çıktı.”","poem":2}]},{"type":"verse","number":5,"content":["Bunlardan sonra gökte tanıklık çadırı tapınağının açıldığını gördüm."]},{"type":"verse","number":6,"content":["Yedi belayı taşıyan yedi melek, pak, parlak keten giysiler giymiş, göğüslerine altın kuşaklar takmış olarak dışarı çıktılar."]},{"type":"verse","number":7,"content":["Dört canlı yaratıktan biri yedi meleğe, sonsuzluklar boyunca yaşayan Tanrı’nın gazabıyla dolu yedi altın tas verdi."]},{"type":"verse","number":8,"content":["Tapınak, Tanrı’nın görkeminden ve gücünden çıkan dumanla doldu. Yedi meleğin yedi belası bitene dek kimse tapınağa giremedi."]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}