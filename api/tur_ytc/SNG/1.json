{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ezgiler ezgisi, Solomon'undur."]},{"type":"verse","number":2,"content":[{"text":"Ağzının öpüşleriyle beni öpsün;","poem":1},{"text":"çünkü senin sevgin şaraptan daha iyidir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Esansının kokusu hoştur.","poem":1},{"text":"Senin adın dökülmüş esanstır,","poem":2},{"lineBreak":true},{"text":"bu yüzden kızlar seni seviyor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Beni seninle birlikte al götür.","poem":1},{"text":"Haydi koşalım.","poem":2},{"lineBreak":true},{"text":"Kral beni odalarına götürdü.","poem":2},"Dostlar",{"text":"Sende sevineceğiz ve coşacağız.","poem":1},{"text":"Senin sevgini şaraptan daha çok öveceğiz!","poem":2},"Sevgili",{"text":"Seni sevmekte haklılar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ben esmerim, ama güzelim,","poem":1},{"text":"ey Yeruşalem kızları,","poem":2},{"lineBreak":true},{"text":"kedar çadırları gibi,","poem":2},{"lineBreak":true},{"text":"Solomon'un perdeleri gibi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Esmer olduğuma bakmayın,","poem":1},{"text":"çünkü beni güneş yaktı.","poem":2},{"text":"Annemin oğulları bana kızdılar.","poem":1},{"text":"Beni bağlara bekçi yaptılar.","poem":2},{"lineBreak":true},{"text":"Kendi bağıma bakmadım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Söyle bana, ey sen, canımın sevdiği,","poem":1},{"text":"sürünü nerede otlatıyorsun,","poem":2},{"lineBreak":true},{"text":"öğleyin onları nerede yatırıyorsun?","poem":2},{"lineBreak":true},{"text":"Çünkü neden arkadaşlarının sürülerinin yanında","poem":2},{"lineBreak":true},{"text":"Örtünen biri gibi olayım?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eğer bilmiyorsan, kadınların en güzeli,","poem":1},{"text":"koyun izlerini takip et.","poem":2},{"lineBreak":true},{"text":"Oğlaklarını çoban çadırlarının yanında otlat.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Seni, sevgilim,","poem":1},{"text":"Firavun'un arabalarındaki bir ata benzetirim.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yanakların küpelerle,","poem":1},{"text":"boynun mücevher dizileriyle ne güzel.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sana altın küpeler yapacağız,","poem":1},{"text":"gümüş düğmelerle.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kral sofrasında otururken,","poem":1},{"text":"benim kokum güzel kokusunu yaydı.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sevgilim benim için memelerimin","poem":1},{"text":"arasında yatan bir mür kesesidir.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sevgilim benim için En Gedi bağlarında","poem":1},{"text":"bir salkım kına çiçeğidir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"İşte,","poem":1},{"noteId":0},{"text":"güzelsin, sevgilim.","poem":1},{"text":"İşte, güzelsin.","poem":2},{"lineBreak":true},{"text":"Gözlerin güvercinler gibi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"İşte, güzelsin, sevgilim, evet, hoşsun;","poem":1},{"text":"ve yatağımız yemyeşil.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Evimizin kirişleri sedirlerdir.","poem":1},{"text":"Tavanlarımız köknarlardır.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“İşte”, “הִנֵּה” kelimesinden gelir ve bakmak, farkına varmak, gözlemlemek, görmek veya dik dik bakmak anlamına gelir. Genellikle bir ünlem olarak kullanılır.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/tur_ytc/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}