{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ben Şaron gülüyüm,","poem":1},{"text":"vadilerin zambağıyım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dikenler arasında zambak nasılsa,","poem":1},{"text":"kızlar arasında sevgilim öyledir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Orman ağaçları arasında elma ağacı nasılsa,","poem":1},{"text":"oğlanlar arasında sevgilim öyledir.","poem":2},{"text":"Onun gölgesinde büyük bir zevkle oturdum,","poem":1},{"text":"meyvesi damağıma tatlı geldi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Beni ziyafet salonuna götürdü.","poem":1},{"text":"Onun üzerimdeki sancağı sevgidir.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Beni kuru üzümle güçlendirin,","poem":1},{"text":"elmayla beni canlandırın;","poem":2},{"lineBreak":true},{"text":"çünkü ben aşktan bitkinim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sol eli başımın altında olsun.","poem":1},{"text":"Sağ eli beni kucaklasın.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ey Yeruşalem kızları,","poem":1},{"text":"dişi ceylanlar ve kırın dişi geyikleri üzerine","poem":2},{"lineBreak":true},{"text":"size ant ettiriyorum ki,","poem":2},{"lineBreak":true},{"text":"sevgiyi ayıltmayın ve uyandırmayın,","poem":2},{"lineBreak":true},{"text":"ta ki o arzu edene kadar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sevgilimin sesi!","poem":1},{"text":"İşte geliyor,","poem":2},{"lineBreak":true},{"text":"dağların üzerinden sekerek,","poem":2},{"lineBreak":true},{"text":"tepelerin üzerinden sıçrayarak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sevgilim bir ceylan ya da geyik yavrusuna benzer.","poem":1},{"text":"İşte, duvarımızın arkasında duruyor!","poem":2},{"text":"Pencerelerden içeri bakıyor.","poem":1},{"text":"Kafeslerden bakış atıyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sevgilim konuşup bana şöyle dedi,","poem":1},{"text":"“Sevgilim, güzelim, kalk da gel.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Çünkü işte, kış geçti.","poem":1},{"text":"Yağmurlar geçip gitti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yerde çiçekler görünüyor.","poem":1},{"text":"Ezgi söyleme zamanı geldi,","poem":2},{"lineBreak":true},{"text":"ve diyarımızda kumru sesi duyuldu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"İncir ağacı ham incirlerini yetiştirmekte.","poem":1},{"text":"Asmalar çiçek açtı.","poem":2},{"lineBreak":true},{"text":"Güzel kokular yaymaktalar.","poem":2},{"text":"Sevgilim, güzelim, kalk da gel.”","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Kaya kovuklarındaki,","poem":1},{"text":"dağ yamaçlarının gizli yerlerindeki güvercinim,","poem":2},{"lineBreak":true},{"text":"yüzünü bana göster.","poem":2},{"lineBreak":true},{"text":"Sesini bana duyur;","poem":2},{"lineBreak":true},{"text":"çünkü sesin tatlı, yüzün güzeldir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bizim için tilkileri,","poem":1},{"text":"bağları yağmalayan küçük tilkileri yakalayın;","poem":2},{"lineBreak":true},{"text":"çünkü bağlarımız çiçek açtı.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sevgilim benimdir, ben de onun.","poem":1},{"text":"Zambakların arasında gezinir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gün serinleyip gölgeler kaçıncaya dek,","poem":1},{"text":"dön, sevgilim,","poem":2},{"lineBreak":true},{"text":"yarılmış dağlar üzerinde ceylan ya da geyik yavrusu gibi ol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}