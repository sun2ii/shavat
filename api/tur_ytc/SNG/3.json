{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Geceleyin yatağımın üzerinde,",{"text":"onu, canımın sevdiğini aradım.","poem":2},{"lineBreak":true},{"text":"Aradım, ama onu bulamadım.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Şimdi kalkıp kenti dolaşayım;","poem":1},{"text":"sokaklarda ve meydanlarda","poem":2},{"lineBreak":true},{"text":"onu, canımın sevdiğini arayayım.","poem":2},{"lineBreak":true},{"text":"Aradım, ama onu bulamadım.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kentte dolaşan bekçiler beni buldular;","poem":1},{"text":"“Onu, canımın sevdiğini gördünüz mü?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Onlardan ayrılır ayrılmaz,","poem":1},{"text":"onu, canımın sevdiğini buldum.","poem":2},{"text":"Onu tuttum ve bırakmadım;","poem":1},{"text":"ta ki onu annemin evine,","poem":2},{"lineBreak":true},{"text":"bana gebe kalan kadının odasına götürene dek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ey Yeruşalem kızları,","poem":1},{"text":"dişi ceylanlar ve kırın dişi geyikleri üzerine","poem":2},{"lineBreak":true},{"text":"size ant ettiriyorum ki,","poem":2},{"lineBreak":true},{"text":"sevgiyi ayıltmayın ve uyandırmayın,","poem":2},{"lineBreak":true},{"text":"ta ki o arzu edene kadar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Duman sütunları gibi çölden çıkan,","poem":1},{"text":"mür ve günlükle,","poem":2},{"lineBreak":true},{"text":"tüccarın bütün baharatlarıyla","poem":2},{"lineBreak":true},{"text":"kokulandırılmış olan bu kimdir?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"İşte, Solomon'un arabası!","poem":1},{"text":"İsrael'in yiğitlerinden,","poem":2},{"lineBreak":true},{"text":"altmış yiğit onun çevresinde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hepsi kılıç kullanır ve savaşta ustadır.","poem":1},{"text":"Gecenin dehşetinden,","poem":2},{"lineBreak":true},{"text":"her birinin kılıcı belindedir.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kral Solomon,","poem":1},{"text":"kendine Lübnan ağacından bir araba yaptı.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sütunlarını gümüşten,","poem":1},{"text":"tabanını altından,","poem":2},{"lineBreak":true},{"text":"koltuğunu mordan yaptı,","poem":2},{"lineBreak":true},{"text":"içi Yeruşalem kızlarından sevgiyle döşendi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey Siyon kızları, çıkın,","poem":1},{"text":"Kral Solomon'u, düğünü gününde,","poem":2},{"lineBreak":true},{"text":"yüreğinin sevinci gününde,","poem":2},{"lineBreak":true},{"text":"annesinin ona giydirdiği taçla görün.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}