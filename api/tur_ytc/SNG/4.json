{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Ah, ne güzelsin, sevgilim.",{"text":"Ah, ne güzelsin.","poem":2},{"text":"Gözlerin peçenin ardındaki güvercinler gibi.","poem":1},{"text":"Saçların Gilad Dağı'ndan inen keçi sürüsü gibi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dişlerin yıkanmaktan çıkmış,","poem":1},{"text":"yeni kırkılmış bir sürüye benzer.","poem":2},{"lineBreak":true},{"text":"Her birinin ikizi var.","poem":2},{"lineBreak":true},{"text":"Aralarında yavrusuz olan yok.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dudakların al iplik gibi.","poem":1},{"text":"Ağzın ne güzel.","poem":2},{"lineBreak":true},{"text":"Yanakların peçenin ardındaki nar parçası gibi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Boynun David'in silah evi için yapılmış kulesine benzer,","poem":1},{"text":"üzerine bin kalkan asılmış,","poem":2},{"lineBreak":true},{"text":"hepsi yiğit kalkanları.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"İki memen, sanki bir çift geyik yavrusu,","poem":1},{"text":"zambaklar arasında otlayan,","poem":2},{"lineBreak":true},{"text":"ikiz ceylan yavrusu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gün serinleyince, gölgeler kaçıp gidinceye dek,","poem":1},{"text":"mür dağına,","poem":2},{"lineBreak":true},{"text":"günnük tepesine gideceğim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tümüyle güzelsin, sevgilim.","poem":1},{"text":"Sende hiç kusur yok.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lübnan'dan benimle gel,","poem":1},{"text":"ey gelinim, benimle Lübnan'dan.","poem":2},{"lineBreak":true},{"text":"Amana Tepesi'nden,","poem":2},{"lineBreak":true},{"text":"senir ve Hermon'un tepelerinden,","poem":2},{"lineBreak":true},{"text":"aslanların inlerinden,","poem":2},{"lineBreak":true},{"text":"parsların dağlarından bak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yüreğimi çaldın, kız kardeşim, gelinim.","poem":1},{"text":"Bir bakışınla, boynunun bir zinciriyle yüreğimi çaldın.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sevgin ne kadar güzel, kız kardeşim, gelinim!","poem":1},{"text":"Sevgin şaraptan ne kadar daha hoş,","poem":2},{"lineBreak":true},{"text":"esansının kokusu her türlü baharattan daha güzel!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ey gelinim, bal damlatır dudakların.","poem":1},{"text":"Balla süt dilinin altındadır.","poem":2},{"lineBreak":true},{"text":"Giysilerinin kokusu sanki Lübnan kokusu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kız kardeşim, gelinim, kapalı bir bahçedir;","poem":1},{"text":"kapalı bir kaynak, mühürlü bir pınardır.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Fidanların nar bahçesidir,","poem":1},{"text":"değerli meyvelerle, kına ve nardin fidanlarıyla,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nardin ve safran,","poem":1},{"text":"kamış ve tarçın, her türlü günnük ağacıyla,","poem":2},{"lineBreak":true},{"text":"mür ve öd ağacı, en iyisinden her çeşit baharatlarla,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bahçelerin pınarı,","poem":1},{"text":"diri suların kuyusu,","poem":2},{"lineBreak":true},{"text":"Lübnan'dan akan dereler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uyan, ey kuzey rüzgârı,","poem":1},{"text":"sen de gel, ey güney!","poem":2},{"lineBreak":true},{"text":"Bahçeme es de, onun baharatları aksın.","poem":2},{"text":"Sevgilim bahçesine gelsin,","poem":1},{"text":"ve değerli meyvelerini tatsın.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}