{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Bahçeme girdim, kız kardeşim, gelinim.","poem":1},{"text":"Baharatımla mürümü topladım;","poem":2},{"lineBreak":true},{"text":"balımla peteğimi yedim;","poem":2},{"lineBreak":true},{"text":"sütümle şarabımı içtim.","poem":2},"Dostlar",{"text":"Yiyin, ey dostlar! İçin, evet, bol bol için, ey sevgililer.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Uyuyordum, ama yüreğim uyanıktı.","poem":1},{"text":"Kapıyı çalan sevgilimin sesi:","poem":2},{"lineBreak":true},{"text":"“Aç bana, kız kardeşim, aşkım, güvercinim, lekesizim;","poem":2},{"lineBreak":true},{"text":"çünkü başım çiyle dolu,","poem":2},{"lineBreak":true},{"text":"saçlarım da gecenin nemiyle.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Entarimi çıkardım. Gerçekten giymeli miyim?","poem":1},{"text":"Ayaklarımı yıkadım. Gerçekten onları kirletmeli miyim?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sevgilim elini sürgü deliğinden içeri uzattı.","poem":1},{"text":"Kalbim onun için çarpıyordu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sevgilime kapıyı açmak için kalktım.","poem":1},{"text":"Ellerimden mür damladı,","poem":2},{"lineBreak":true},{"text":"parmaklarımdan aktı,","poem":2},{"lineBreak":true},{"text":"sürgü tokmakları üzerine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sevgilime açtım;","poem":1},{"text":"ama sevgilim ayrılıp gitmişti.","poem":2},{"text":"O konuşurken ben kendimden geçmiştim.","poem":1},{"text":"Onu aradım, ama bulamadım.","poem":2},{"lineBreak":true},{"text":"Onu çağırdım, ama o yanıt vermedi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kentte dolaşan bekçiler beni buldular.","poem":1},{"text":"Beni dövdüler,","poem":2},{"lineBreak":true},{"text":"beni yaraladılar.","poem":2},{"lineBreak":true},{"text":"Sur bekçileri üzerimden şalımı alıp götürdüler.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Size ant içiriyorum, ey Yeruşalem kızları,","poem":1},{"text":"eğer sevgilimi bulursanız,","poem":2},{"lineBreak":true},{"text":"ona aşktan bitkin olduğumu söyleyin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kadınların en güzeli,","poem":1},{"text":"senin sevgilin öteki sevgililerden nasıl daha iyidir?","poem":2},{"lineBreak":true},{"text":"Senin sevgilin öteki sevgililerden nasıl daha iyidir ki,","poem":2},{"lineBreak":true},{"text":"bize böyle ant içiriyorsun?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sevgilim beyaz ve kızıldır.","poem":1},{"text":"On binler arasında en iyisidir.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Başı en saf altına benzer.","poem":1},{"text":"Saçları gür, kuzgun gibi siyahtır.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gözleri akarsu kenarındaki güvercinler gibidir,","poem":1},{"text":"sütle yıkanmış, mücevher gibi takılmış.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yanakları güzel kokulu çiçeklik gibidir,","poem":1},{"text":"güzel kokular yığınlarıyla.","poem":2},{"lineBreak":true},{"text":"Dudakları zambaklar gibidir, mür yağı damlatır.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Elleri beril kakmalı altın yüzükler gibidir.","poem":1},{"text":"Gövdesi safirlerle kaplı fildişi işi gibidir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bacakları saf altın ayaklıklar üzerine yerleştirilmiş","poem":1},{"text":"mermer sütunlar gibidir.","poem":2},{"lineBreak":true},{"text":"Görünüşü Lübnan gibidir,","poem":2},{"lineBreak":true},{"text":"sedirler kadar harikadır.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ağzı tatlıdır; evet, her yönüyle sevimlidir.","poem":1},{"lineBreak":true},{"text":"Bu benim sevgilimdir ve bu benim dostumdur,","poem":1},{"text":"ey Yeruşalem kızları.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}