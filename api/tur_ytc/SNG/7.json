{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Sandaletler içinde ayakların ne güzel, ey bey kızı!",{"text":"Yuvarlak kalçaların mücevher gibi,","poem":2},{"lineBreak":true},{"text":"usta ellerinin işi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vücudun yuvarlak bir kadeh gibi,","poem":1},{"text":"karışık şaraptan yoksun değil.","poem":2},{"lineBreak":true},{"text":"Belin zambaklarla süslenmiş bir buğday yığını gibi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"İki memen sanki bir çift geyik vayrusu,","poem":1},{"text":"ikiz ceylan yavrusu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Boynun fildişi kulesine benzer.","poem":1},{"text":"Gözlerin Batrabbim Kapısı yanındaki Heşbon havuzları gibi.","poem":2},{"lineBreak":true},{"text":"Burnun Damaskus'a bakan Lübnan Kulesi gibi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Üzerindeki başın Karmel gibi.","poem":1},{"text":"Başındaki saçlar mora çalıyor.","poem":2},{"lineBreak":true},{"text":"Kral senin kaküllerine tutsak oldu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zevkler için,","poem":1},{"text":"sen ne güzelsin, ne hoşsun, ey aşk!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bu senin boyun palmiye ağacına benzer,","poem":1},{"text":"memelerin onun meyvesi gibi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Hurma ağacına çıkayım, meyvesini tutayım.” dedim.","poem":1},{"lineBreak":true},{"text":"Memelerin asma salkımları gibi olsun,","poem":1},{"text":"soluğunun kokusu da elma gibi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ağzın en iyi şarap gibi,","poem":1},{"text":"sevgilim için kolayca akan,","poem":2},{"lineBreak":true},{"text":"uyuyanların dudaklarından kayan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ben sevgiliminim.","poem":1},{"text":"Onun arzusu banadır.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gel, sevgilim! Kıra çıkalım.","poem":1},{"text":"Köylerde geceleyelim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sabahleyin erkenden bağlara çıkalım.","poem":1},{"text":"Asma tomurcuk verdi mi,","poem":2},{"lineBreak":true},{"text":"çiçeği açtı mı,","poem":2},{"lineBreak":true},{"text":"narlar çiçeklendi mi görelim.","poem":2},{"lineBreak":true},{"text":"Orada sana sevgimi vereceğim.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Adamotları hoş koku saçıyor.","poem":1},{"text":"Kapılarımızın önünde","poem":2},{"lineBreak":true},{"text":"Taze ve kuru her çeşit değerli meyve var,","poem":2},{"lineBreak":true},{"text":"onları senin için sakladım, ey sevgilim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}