{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"SNG","translationId":"tur_ytc","name":"SOLOMON'UN EZGİSİ","commonName":"SOLOMON'UN EZGİSİ","title":"SOLOMON'UN EZGİSİ","order":22,"numberOfChapters":8,"sha256":"a83fbb2abad6d365689975c72f5bc632d37e9ef0535a563a3698a3f2963e0350","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tur_ytc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Ah, keşke sen annemin memelerinden süt emmiş kardeşim gibi olsaydın!",{"text":"Seni dışarıda bulsam, öperdim;","poem":2},{"lineBreak":true},{"text":"kimse de beni kınamazdı.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sana yol gösterir,","poem":1},{"text":"beni eğiten annemin evine götürürdüm.","poem":2},{"lineBreak":true},{"text":"Sana baharatlı şaraptan,","poem":2},{"lineBreak":true},{"text":"narımın suyundan içirirdim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sol eli başımın altında olurdu.","poem":1},{"text":"Sağ eli beni kucaklardı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Size ant içiriyorum, ey Yeruşalem kızları,","poem":1},{"text":"sevgiyi ayıltmayasınız, uyandırmayasınız diye,","poem":2},{"lineBreak":true},{"text":"ta ki öyle arzu edene kadar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sevgilisine yaslanarak çölden çıkan bu kimdir?","poem":1},"Sevgili,",{"text":"Elma ağacının altında seni uyandırdım.","poem":1},{"text":"Orada annen sana gebe kaldı.","poem":2},{"lineBreak":true},{"text":"Orada doğum sancıları çekti ve seni doğurdu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beni yüreğine bir mühür,","poem":1},{"text":"kolunun üzerine bir mühür gibi koy;","poem":2},{"lineBreak":true},{"text":"çünkü sevgi ölüm kadar güçlüdür.","poem":2},{"lineBreak":true},{"text":"Kıskançlık Şeol","poem":2},{"noteId":1},{"text":"kadar zalimdir.","poem":2},{"lineBreak":true},{"text":"Onun ışıltıları ateş ışıltılarıdır,","poem":2},{"lineBreak":true},{"text":"Yah'ın","poem":2},{"noteId":2},{"text":"gerçek alevidir.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Büyük sular sevgiyi söndüremez,","poem":1},{"text":"seller de onu boğamaz.","poem":2},{"text":"Bir adam sevgisi için evinin bütün servetini verse,","poem":1},{"text":"tümüyle hor görülür.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Küçük bir kız kardeşimiz var.","poem":1},{"text":"Onun daha memeleri yok.","poem":2},{"lineBreak":true},{"text":"Onun için söz söyleneceği gün,","poem":2},{"lineBreak":true},{"text":"kız kardeşimiz için ne yapacağız?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eğer o bir duvarsa,","poem":1},{"text":"üzerine gümüş bir kule yaparız.","poem":2},{"lineBreak":true},{"text":"Eğer bir kapıysa,","poem":2},{"lineBreak":true},{"text":"onu sedir tahtalarıyla kapatırız.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ben bir duvarım, memelerim de kuleler gibi,","poem":1},{"text":"o zaman onun gözünde esenlik bulan biri gibi oldum.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Solomon'un Baal Hamon'da bir bağı vardı.","poem":1},{"text":"Bağı tutanlara kiraladı.","poem":2},{"lineBreak":true},{"text":"Her biri ürünü için bin şekel","poem":2},{"noteId":3},{"text":"gümüş getirirdi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Benim kendi bağım önümdedir.","poem":1},{"text":"Bini senin olsun, ey Solomon,","poem":2},{"lineBreak":true},{"text":"iki yüzü de ürününe bakanların olsun.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bahçelerde oturan,","poem":1},{"text":"dostlarınla birlikte hazır bulunan ey sen,","poem":2},{"lineBreak":true},{"text":"sesini duyur bana!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kaç gel, sevgilim!","poem":1},{"text":"Hoş kokulu dağların üzerinde,","poem":2},{"lineBreak":true},{"text":"bir ceylan gibi, ya da geyik yavrusu gibi ol!","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Şeol ölüler diyarıdır.","reference":{"chapter":8,"verse":6}},{"noteId":2,"caller":"+","text":"“Yah”, Tanrı’nın özel ismi olan “Yahve”nin kısaltılmış halidir ve diğer çevirilerde bazen “RAB=EFENDİ” (tamamı büyük harfle) olarak çevrilir.","reference":{"chapter":8,"verse":6}},{"noteId":3,"caller":"+","text":"Bir şekel yaklaşık 10 gram veya 0,35 onstur, dolayısıyla 1000 şekel yaklaşık 10 kilogram veya 22 pounddur.","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/tur_ytc/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}