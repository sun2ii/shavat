{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ZEC","translationId":"tur_ytc","name":"ZEKARiYA","commonName":"ZEKARiYA","title":"ZEKARİYA","order":38,"numberOfChapters":14,"sha256":"db44872b7bcb8756a2c519e753f09a5d828114849ecee154de80ae13e6ca1e90","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Baharda yağmur dileyin Yahve'den,","poem":1},{"text":"fırtına bulutları yaratan,","poem":2},{"lineBreak":true},{"text":"ve tarladaki bitkiler için herkese sağanak yağmurlar veren Yahve'dir.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Çünkü terafim","poem":1},{"noteId":6},{"text":"boş şeyler söyledi,","poem":1},{"text":"ve falcılar yalan gördü,","poem":2},{"lineBreak":true},{"text":"ve yalan düşler anlattı.","poem":2},{"text":"Boşuna avutuyorlar.","poem":1},{"text":"Bu yüzden koyun gibi yollarına gidiyorlar.","poem":2},{"lineBreak":true},{"text":"Eziliyorlar, çünkü çoban yok.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Öfkem çobanlara karşı alevlendi,","poem":1},{"text":"ve tekeleri cezalandıracağım,","poem":2},{"lineBreak":true},{"text":"çünkü Ordular Yahvesi kendi sürüsünü, Yahuda evini ziyaret etti,","poem":2},{"lineBreak":true},{"text":"ve savaşta onları kendi görkemli atı gibi yapacak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ondan köşe taşı,","poem":1},{"text":"ondan çadır kazığı,","poem":2},{"lineBreak":true},{"text":"ondan savaş yayı,","poem":2},{"lineBreak":true},{"text":"hüküm sahiplerinin hepsi birlikte ondan çıkacak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Savaşta çamurlu yolları çiğneyen yiğitler gibi olacaklar.","poem":1},{"lineBreak":true},{"text":"Savaşacaklar, çünkü Yahve onlarla birliktedir.","poem":1},{"text":"Atlı biniciler şaşkına dönecekler.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Yahuda evini güçlendireceğim,","poem":1},{"text":"Ve Yosef evini kurtaracağım.","poem":2},{"text":"Onları geri getireceğim,","poem":1},{"text":"çünkü onlara merhamet ettim.","poem":2},{"text":"Sanki onları reddetmemişim gibi olacaklar,","poem":1},{"text":"çünkü ben onların Tanrısı Yahve'yim,","poem":2},{"lineBreak":true},{"text":"ve onları duyacağım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Efraim yiğit gibi olacak,","poem":1},{"lineBreak":true},{"text":"ve yürekleri şarap içmiş gibi sevinecek.","poem":1},{"lineBreak":true},{"text":"Evet, çocukları bunu görüp sevinecek.","poem":1},{"text":"Yürekleri Yahve'de sevinç bulacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onlara işaret verip toplayacağım,","poem":1},{"text":"çünkü onları fidye ile kurtardım.","poem":2},{"lineBreak":true},{"text":"Eskiden olduğu gibi çoğalacaklar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onları halkların arasına ekeceğim.","poem":1},{"text":"Uzak ülkelerde beni hatırlayacaklar.","poem":2},{"lineBreak":true},{"text":"Çocuklarıyla birlikte yaşayacaklar ve geri dönecekler.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onları Mısır diyarından yine geri getireceğim,","poem":1},{"text":"ve Aşur'dan onları toplayacağım.","poem":2},{"text":"Onları Gilad diyarına ve Lübnan'a getireceğim;","poem":1},{"text":"ve onlar için yeterince yer bulunmayacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sıkıntı denizinden geçecek,","poem":1},{"text":"ve denizde dalgaları vuracak,","poem":2},{"lineBreak":true},{"text":"ve Nil'in bütün derinlikleri kuruyacak;","poem":2},{"lineBreak":true},{"text":"ve Aşur'un gururu yıkılacak,","poem":2},{"lineBreak":true},{"text":"ve Mısır'ın asası elden gidecek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onları Yahve'de güçlendireceğim.","poem":1},{"text":"O'nun adıyla dolaşacaklar,” diyor Yahve.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Teraphim, ev eşyalarına ilişkin miras haklarıyla ilişkilendirilebilecek aile putlarıydı..","reference":{"chapter":10,"verse":2}}]},"thisChapterLink":"/api/tur_ytc/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}