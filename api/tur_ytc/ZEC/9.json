{"translation":{"id":"tur_ytc","name":"Yorumsuz Türkçe Çeviri (YTC)","website":"https://ebible.org/Scriptures/details.php?id=turytc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=turytc","licenseNotes":null,"shortName":"YTC","englishName":"Turkish WEB","language":"tur","textDirection":"ltr","sha256":"7ce24846075d100685b27ea256f91c6b67a287d56e9810d9846a75ce0971534c","availableFormats":["json"],"listOfBooksApiLink":"/api/tur_ytc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31064,"languageName":"Türkçe","languageEnglishName":"Turkish"},"book":{"id":"ZEC","translationId":"tur_ytc","name":"ZEKARiYA","commonName":"ZEKARiYA","title":"ZEKARİYA","order":38,"numberOfChapters":14,"sha256":"db44872b7bcb8756a2c519e753f09a5d828114849ecee154de80ae13e6ca1e90","firstChapterNumber":1,"firstChapterApiLink":"/api/tur_ytc/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tur_ytc/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Vahiy.",{"text":"Yahve'nin sözü Hadrak diyarına yöneliktir,","poem":1},{"text":"ve Damaskus'un üzerinde duracaktır;","poem":2},{"text":"çünkü insanların,","poem":1},{"text":"ve İsrael’in bütün oymaklarının gözü Yahve'ye dönüktür;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"bu vahiy onun sınırında olan Hamat'a da,","poem":1},{"text":"Sur ve Sayda'ya yöneliktir, çünkü onlar çok bilgedirler.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sur kendine bir kale yaptı,","poem":1},{"text":"ve toz gibi gümüş,","poem":2},{"lineBreak":true},{"text":"ve sokakların çamuru gibi saf altın yığdı.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"İşte, Efendi onu mülksüz bırakacak,","poem":1},{"text":"ve denizde onun gücünü vuracak;","poem":2},{"lineBreak":true},{"text":"ve o, ateşle yutulacaktır.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aşkelon bunu görüp korkacak;","poem":1},{"text":"Gaza da acı içinde kıvranacak;","poem":2},{"lineBreak":true},{"text":"Ekron da öyle, çünkü beklentisi boşa çıkacak;","poem":2},{"lineBreak":true},{"text":"ve kral Gaza’dan yok olacak,","poem":2},{"lineBreak":true},{"text":"ve Aşkelon’da oturan olmayacak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yabancılar Aşdod'da oturacaklar,","poem":1},{"text":"ve Filistliler'in gururunu kıracağım.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ağzından kanını, dişlerinin arasından iğrençliklerini alacağım;","poem":1},{"lineBreak":true},{"text":"ve o da Tanrımız için bir kalıntı olacak;","poem":1},{"text":"ve Yahuda'da bir bey gibi,","poem":2},{"lineBreak":true},{"text":"Ekron'da da bir Yevuslu gibi olacak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Orduya karşı evimin etrafında ordugâh kuracağım,","poem":1},{"text":"öyle ki kimse geçip gitmesin, geri dönmesin;","poem":2},{"lineBreak":true},{"text":"ve bir daha hiçbir zalim onların içinden geçmeyecek;","poem":2},{"lineBreak":true},{"text":"çünkü şimdi kendi gözlerimle gördüm.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Büyük sevinçle coş, ey Siyon kızı!","poem":1},{"text":"Bağır, ey Yeruşalim kızı!","poem":2},{"text":"İşte, Kralın! O adil kurtarıcı ve alçakgönüllüdür.","poem":1},{"text":"Eşeğe, evet, bir eşek yavrusu sıpaya binmiş sana geliyor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Efraim'den savaş arabasını,","poem":1},{"text":"ve Yeruşalem'den atı kesip atacağım.","poem":2},{"text":"Savaş yayı kesilip atılacak;","poem":1},{"text":"O, uluslara esenlik sözü konuşacak.","poem":2},{"text":"Hâkimiyeti denizden denize,","poem":1},{"text":"ırmaktan yeryüzünün uçlarına kadar olacak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sana gelince,","poem":1},{"text":"antlaşmanın kanı yüzünden,","poem":2},{"lineBreak":true},{"text":"senin tutsaklarını susuz çukurdan kurtardım.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ey siz umut tutsakları, kaleye dönün!","poem":1},{"text":"Tam bugün size iki katını geri vereceğimi ilan ediyorum.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Çünkü ben Yahuda'yı kendim için bir yay gibi gerdim.","poem":1},{"text":"Yayı Efraim'le doldurdum.","poem":2},{"text":"Ey Siyon, senin oğullarını harekete geçireceğim,","poem":1},{"text":"ey Yunan diyarı, senin oğullarına karşı,","poem":2},{"lineBreak":true},{"text":"ve seni bir yiğit kılıcı gibi yapacağım.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yahve onların üzerinde görünecek.","poem":1},{"text":"Oku şimşek gibi çakacak.","poem":2},{"lineBreak":true},{"text":"Efendi Yahve boruyu çalacak,","poem":2},{"lineBreak":true},{"text":"ve güneyin kasırgalarıyla gidecek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ordular Yahvesi onları koruyacak.","poem":1},{"text":"Sapan taşlarıyla yıkıp yenecekler.","poem":2},{"text":"İçecekler ve şarap içmiş gibi gürleyecekler.","poem":1},{"text":"Leğenler gibi,","poem":2},{"lineBreak":true},{"text":"sunağın köşeleri gibi dolacaklar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tanrıları Yahve, o gün onları halkının sürüsü olarak kurtaracak;","poem":1},{"text":"çünkü onlar,","poem":2},{"lineBreak":true},{"text":"O'nun ülkesi üzerinde yükselen bir tacın mücevherleri gibidirler.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Çünkü O'nun iyiliği ne büyük, O'nun güzelliği ne büyük!","poem":1},{"text":"Gençleri buğdayla,","poem":2},{"lineBreak":true},{"text":"el değmemiş kızları da yeni şarapla güzelleşecek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tur_ytc/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tur_ytc/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tur_ytc/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}