{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_aka","name":"Amos","commonName":"Amos","title":"Odiyifo Amos Nhoma","order":30,"numberOfChapters":9,"sha256":"aacc7300739986d39248cc72dce8c4428af2a4d9f017fc59bcb54e53417911fe","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_aka/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Amos, Tekoa nguanhwɛfo no mu baako nsɛm ni. Onyaa saa anisoadehu yi a ɛfa Israel ho mfe abien ansa na asase wosowee, bere a Usia di hene wɔ Yuda na Yoas babarima Yeroboam nso di hene wɔ Israel no."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["Ɔkae se,",{"text":"“Awurade bobɔ mu fi Sion bepɔw so","poem":1},{"text":"na ɔde aprannaa nnyigyei nso fi Yerusalem;","poem":2},{"text":"nguanhwɛfo mmoa adidibea rehyew","poem":1},{"text":"na Karmel atifi nso kisa.”","poem":2}]},{"type":"heading","content":["Atemmu A Ɛfa Amanamanmufo Ahorow Ho"]},{"type":"verse","number":3,"content":["Nea Awurade se ni:",{"text":"“Damasko ayɛ bɔne bebree ama no atra so","poem":1},{"text":"ɛno nti, merennan mʼabufuw.","poem":2},{"text":"Efisɛ ɔde awiporowbea ade a ɛwɔ dade se","poem":1},{"text":"dwerɛw Gilead.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mede ogya bɛto Hasael fi","poem":1},{"text":"na ahyew Ben-Hadad aban no.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mebubu Damasko apon,","poem":1},{"text":"na mɛsɛe ɔhene a ɔwɔ Awen bon no mu no","poem":2},{"text":"ne nea okura ahempema wɔ Bet Eden no.","poem":1},{"text":"Na Aramfo bɛkɔ nnommum mu wɔ Kir,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nea Awurade se ni:","poem":1},{"lineBreak":true},{"text":"“Gasa ayɛ bɔne bebree ama no atra so,","poem":1},{"text":"ɛno nti, merennan mʼabufuw no.","poem":2},{"text":"Ɔfaa ɔman mu no nyinaa nnommum","poem":1},{"text":"na ɔtɔn wɔn maa Edomfo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mede ogya bɛto Gasa afasu mu,","poem":1},{"text":"na ahyew nʼaban no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɛsɛe Asdod hene no","poem":1},{"text":"ne nea okura ahempema wɔ Askelon no.","poem":2},{"text":"Mɛdan me nsa atia Ekron,","poem":1},{"text":"kosi sɛ Filistini a otwa to no bewu,”","poem":2},{"text":"sɛnea Asafo Awurade se ni.","poem":1}]},{"type":"verse","number":9,"content":["Nea Awurade se ni:",{"text":"“Tiro ayɛ bɔne bebree ama no atra so,","poem":1},{"text":"ɛno nti, merennan mʼabufuw.","poem":2},{"text":"Ɔfaa ɔmanmu no nnommum","poem":1},{"text":"na ɔtɔn wɔn maa Edomfo,","poem":2},{"lineBreak":true},{"text":"a wankae onuadɔ apam.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mede ogya bɛto Tiro afasu no mu,","poem":1},{"text":"na ahyew nʼaban.”","poem":2}]},{"type":"verse","number":11,"content":["Nea Awurade se ni:",{"text":"“Edom ayɛ bɔne bebree ama no atra so,","poem":2},{"text":"ɛno nti, merennan mʼabufuw.","poem":1},{"text":"Ɔde afoa taataa ne nua,","poem":2},{"lineBreak":true},{"text":"a wannya ayamhyehye biara.","poem":2},{"text":"Efisɛ ne bo kɔɔ so fuwii,","poem":1},{"text":"na obiara antumi annwudwo nʼabufuw no ano.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mede ogya bɛto Teman mu,","poem":1},{"text":"na ahyew Bosra aban.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sɛnea Awurade se ni:","poem":1},{"text":"“Amon ayɛ bɔne bebree ama no atra so,","poem":2},{"lineBreak":true},{"text":"ɛno nti, merennan mʼabufuw.","poem":2},{"text":"Ɔde afoa paapaee Gilead apemfo yafunu mu","poem":1},{"text":"de trɛw nʼahye mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mede ogya bɛto Raba afasu mu","poem":1},{"text":"na ahyew nʼaban","poem":2},{"text":"wɔ ɔko da mu nteɛteɛmu","poem":1},{"text":"ne ahum da mfɛtɛ mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Na ne hene ne mmapɔmma","poem":1},{"text":"bɛbɔ mu akɔ nnommum mu,”","poem":2},{"text":"sɛnea Awurade se ni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}