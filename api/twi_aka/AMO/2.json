{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_aka","name":"Amos","commonName":"Amos","title":"Odiyifo Amos Nhoma","order":30,"numberOfChapters":9,"sha256":"aacc7300739986d39248cc72dce8c4428af2a4d9f017fc59bcb54e53417911fe","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_aka/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Nea Awurade se ni:",{"text":"“Moab ayɛ bɔne bebree ama no atra so,","poem":2},{"text":"ɛno nti, merennan mʼabufuw.","poem":1},{"text":"Ɔhyew Edomhene nnompe,","poem":2},{"lineBreak":true},{"text":"maa ɛdan nsõ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mede ogya bɛto Moab mu,","poem":1},{"text":"na ahyew Keriot aban.","poem":2},{"text":"Moab bɛhwe ase wɔ huuyɛ,","poem":1},{"text":"ɔko nteɛteɛmu ne torobɛnto nnyigyei mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɛsɛe ne hene","poem":1},{"text":"na makunkum ne mmapɔmma aka ne ho,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nea Awurade se ni:","poem":1},{"text":"“Yuda ayɛ bɔne bebree ama no atra so,","poem":2},{"text":"ɛno nti, merennan mʼabufuw.","poem":1},{"text":"Wɔapo Awurade mmara no","poem":2},{"text":"na wɔanni nʼahyɛde so","poem":1},{"text":"efisɛ atoro anyame no","poem":2},{"text":"ama wɔafom ɔkwan no,","poem":1},{"text":"anyame a wɔn nenanom dii akyi no.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mede ogya bɛto Yuda mu","poem":1},{"text":"na ahyew Yerusalem aban.”","poem":2}]},{"type":"heading","content":["Israel Atemmu"]},{"type":"verse","number":6,"content":["Nea Awurade se ni:",{"text":"“Israel ayɛ bɔne bebree ama no atra so,","poem":1},{"text":"ɛno nti, merennan mʼabufuw.","poem":2},{"text":"Wɔtɔn atreneefo de gye dwetɛ,","poem":1},{"text":"ne ahiafo de gye mpaboa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wotiatia ahiafo so","poem":1},{"text":"te sɛnea wɔyɛ fam mfutuma","poem":2},{"text":"na wɔma atɛntrenee bɔ mmɔborɔfo.","poem":1},{"text":"Agya ne ne ba ne ɔbea baako da","poem":2},{"lineBreak":true},{"text":"de gu me din kronkron no ho fi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔdeda afɔremuka biara ho","poem":1},{"text":"wɔ wɔn awowa ntama so.","poem":2},{"text":"Wɔn anyame fi mu no,","poem":1},{"text":"wɔnom nsa a wɔagye sɛ mmaratode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mesɛee Amorifo no wɔ wɔn anim,","poem":1},{"text":"ɛwɔ mu sɛ wɔwoware te sɛ sida.","poem":2},{"lineBreak":true},{"text":"Wɔn ho nso yɛ den sɛ odum.","poem":2},{"text":"Nanso mesɛee nʼaba wɔ ne soro,","poem":1},{"text":"ne ne ntin wɔ nʼase.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Miyii mo fii Misraim,","poem":1},{"text":"na midii mo anim mfirihyia aduanan wɔ sare so","poem":2},{"text":"sɛnea mede Amorifo asase bɛma mo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Miyiyii mo mmabarima no bi yɛɛ wɔn adiyifo,","poem":1},{"text":"ne mo mmerante ebinom sɛ Naserefo.","poem":2},{"text":"Na ɛnte saa ana, Israelfo?”","poem":1},{"text":"Nea Awurade bisa ni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Nanso momaa Naserefo no nom nsa","poem":1},{"text":"na mohyɛɛ adiyifo no sɛ wɔnnhyɛ nkɔm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Na afei, mɛdwerɛw mo","poem":1},{"text":"sɛnea teaseɛnam a aduan ayɛ no ma mia asase no.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ahoɔharefo rentumi nguan.","poem":1},{"text":"Ahoɔdenfo rennya ahoɔden,","poem":2},{"text":"na ɔkofo rennya ne ti nnidi mu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Agyantowfo rentumi nnyina nea ogyina.","poem":1},{"text":"Asraafo ahoɔharefo rentumi nguan,","poem":2},{"lineBreak":true},{"text":"na ɔpɔnkɔsotefo rentumi mpere ne nkwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mpo akofo akokodurufo","poem":1},{"text":"de adagyaw beguan wɔ saa da no,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}