{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_aka","name":"Amos","commonName":"Amos","title":"Odiyifo Amos Nhoma","order":30,"numberOfChapters":9,"sha256":"aacc7300739986d39248cc72dce8c4428af2a4d9f017fc59bcb54e53417911fe","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_aka/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Wɔfrɛ Nnansefo Tia Israel"]},{"type":"verse","number":1,"content":["Muntie saa asɛm a Awurade aka atia mo yi, Israelfo, nea etia abusua a miyii wɔn fii Misraim no nyinaa:"]},{"type":"verse","number":2,"content":[{"text":"“Mo nko ara na mayi mo","poem":1},{"text":"wɔ mmusua a ɛwɔ asase so nyinaa mu;","poem":2},{"lineBreak":true},{"text":"enti mɛtwe mo aso","poem":2},{"lineBreak":true},{"text":"wɔ mo bɔne nyinaa ho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nnipa baanu betumi abɔ mu anantew,","poem":1},{"text":"wɔ bere a wɔnyɛɛ nokoro ana?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gyata bobɔ mu wɔ ɔdɔtɔ ase","poem":1},{"text":"wɔ bere a onhuu hanam biara ana?","poem":2},{"text":"Ɔbobɔ mu wɔ ne tu mu","poem":1},{"text":"wɔ bere a ɔnkyeree hanam biara ana?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anomaa bɛtɔ afiri mu wɔ fam","poem":1},{"text":"wɔ baabi a wonsum afiri ana?","poem":2},{"text":"Afiri huan konkɔn hɔ wɔ","poem":1},{"text":"bere a enyii aboa ana?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sɛ wɔhyɛn torobɛnto wɔ kuropɔn mu a","poem":1},{"text":"nnipa no ho mpopo ana?","poem":2},{"text":"Sɛ atoyerɛnkyɛm ba kuropɔn bi mu a","poem":1},{"text":"ɛnyɛ Awurade na ɔyɛe ana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ampa ara, Otumfo Awurade nyɛ biribi","poem":1},{"text":"a ɔnna ne nhyehyɛe adi","poem":2},{"lineBreak":true},{"text":"nkyerɛ nʼAsomafo adiyifo no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gyata no abobɔ mu,","poem":1},{"text":"hena na onnsuro?","poem":2},{"text":"Otumfo Awurade akasa,","poem":1},{"text":"hena na ɔrenhyɛ ho nkɔm?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mompae mu nka nkyerɛ Asdod aban","poem":1},{"text":"ne Misraim aban:","poem":2},{"text":"“Mommoaboa mo ho ano wɔ Samaria mmepɔw so;","poem":1},{"text":"hwɛ basabasayɛ a ɛwɔ no so","poem":2},{"lineBreak":true},{"text":"ne nhyɛso a ɛwɔ ne nkurɔfo mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Wonnim sɛnea wɔyɛ nea eye,”","poem":1},{"text":"sɛnea Awurade se ni.","poem":2},{"text":"“Wɔde nneɛma a wɔafow ne nea wɔawia","poem":1},{"text":"sie wɔ wɔn aban mu.”","poem":2}]},{"type":"verse","number":11,"content":["Ɛno nti, sɛɛ na Otumfo Awurade se,",{"text":"“Ɔtamfo bi betwiw afa mo asase no so;","poem":1},{"text":"Obebubu mo bammɔ agu,","poem":2},{"lineBreak":true},{"text":"na wɔafow mo aban.”","poem":2}]},{"type":"verse","number":12,"content":["Nea Awurade se ni:",{"text":"“Sɛnea oguanhwɛfo gye","poem":2},{"text":"anan abien nnompe anaa aso sin pɛ","poem":1},{"text":"fi gyata anum no,","poem":2},{"text":"saa ara na wobegye Israelfo nkwa,","poem":1},{"text":"wɔn a wɔtete wɔn mpa ntwea so wɔ Samaria,","poem":2},{"lineBreak":true},{"text":"ne wɔn a wɔdeda nkongua pa mu wɔ Damasko no.”","poem":2}]},{"type":"verse","number":13,"content":["“Tie eyi, na di adanse tia Yakobfi,”",{"text":"sɛnea Awurade, Asafo Awurade Nyankopɔn se ni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Da a mɛtwe Israel aso wɔ ne nnebɔne ho no,","poem":1},{"text":"mɛsɛe afɔremuka a ɛwɔ Bet-El;","poem":2},{"text":"wobetwitwa afɔremuka no mmɛn","poem":1},{"text":"na abu ahwe fam.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Medwiriw awɔwbere mu ofi","poem":1},{"text":"ne ahuhurubere mu ofi agu;","poem":2},{"text":"na afi a wɔde asonse adura ho no wɔbɛsɛe no","poem":1},{"text":"na afi akɛse no nso wobebubu agu,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}