{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_aka","name":"Amos","commonName":"Amos","title":"Odiyifo Amos Nhoma","order":30,"numberOfChapters":9,"sha256":"aacc7300739986d39248cc72dce8c4428af2a4d9f017fc59bcb54e53417911fe","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_aka/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Adwotwa Ne Adwensakra Ho Frɛ"]},{"type":"verse","number":1,"content":["Tie asɛm yi, mo Israelfo, saa adwotwa yi fa mo ho:"]},{"type":"verse","number":2,"content":[{"text":"“Ɔbabun Israel ahwe ase","poem":1},{"text":"a ɔrensɔre bio,","poem":2},{"text":"wɔapo no wɔ nʼankasa asase so,","poem":1},{"text":"na onni obi a ɔbɛma no so.”","poem":2}]},{"type":"verse","number":3,"content":["Nea Otumfo Awurade se ni:",{"text":"“Kuropɔn a ɔde mmarima ahoɔdenfo apem ko ma Israel no,","poem":1},{"text":"mu ɔha pɛ na wɔbɛka;","poem":2},{"text":"Kurow a ɔde ahoɔdenfo ɔha no,","poem":1},{"text":"mu du pɛ na wɔbɛka.”","poem":2}]},{"type":"verse","number":4,"content":["Nea Awurade ka kyerɛ Israelfo ni:",{"text":"“Monhwehwɛ me na munnya nkwa;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Monnhwehwɛ Bet-El,","poem":2},{"lineBreak":true},{"text":"monnkɔ Gilgal,","poem":2},{"text":"na munntu kwan nkɔ Beer-Seba nso.","poem":1},{"text":"Ampa ara Gilgal bɛkɔ nnommum mu","poem":2},{"lineBreak":true},{"text":"na wɔbɛhwe Bet-El ase koraa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Monhwehwɛ Awurade na munnya nkwa,","poem":1},{"lineBreak":true},{"text":"anyɛ saa a ɔbɛpra Yosef fi te sɛ ogya;","poem":1},{"text":"ɛbɛhyew,","poem":2},{"lineBreak":true},{"text":"na Bet-El rennya obi anum no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mo a moma atemmu yɛ nwen","poem":1},{"text":"na mototo trenee ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nea ɔbɔɔ nsoromma, Akokɔbeatan ne ne mma,","poem":1},{"lineBreak":true},{"text":"nea ɔdan sum yɛ no adekyee","poem":1},{"text":"na ɔma awia dan adesae.","poem":2},{"text":"Nea ɔboaboa po mu nsu ano","poem":1},{"text":"na ohwie gu asase so,","poem":2},{"lineBreak":true},{"text":"ne din ne Awurade.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔsɛe abandennen ntɛm so","poem":1},{"text":"na obubu kuropɔn a wɔabɔ ho ban nso,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"motan nea ɔteɛteɛ wɔ asennii","poem":1},{"text":"na mubu nea ɔka nokware animtiaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mutiatia ohiani so","poem":1},{"text":"na mohyɛ no gye aduan fi ne nkyɛn.","poem":2},{"text":"Enti ɛwɔ mu sɛ mode abo a wɔatwa asisi afi akɛse de,","poem":1},{"text":"nanso morentena mu;","poem":2},{"text":"ɛwɔ mu sɛ moayɛ bobe nturo a ɛyɛ fɛ de","poem":1},{"text":"nanso morennom mu nsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Na minim mo mmarato dodow","poem":1},{"text":"ne mo bɔne akɛse no.","poem":2},{"lineBreak":true},{"text":"Mohyɛ atreneefo so na mugye adanmude","poem":1},{"text":"mubu ahiafo ntɛnkyew wɔ asennii.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ɛno nti, onyansafo yɛ komm saa mmere yi mu,","poem":1},{"text":"efisɛ ɛyɛ mmere bɔne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Monhwehwɛ papa, na moanya nkwa","poem":1},{"text":"na ɛnyɛ bɔne.","poem":2},{"text":"Na Asafo Awurade Nyankopɔn bɛka wo ho,","poem":1},{"text":"sɛnea moka sɛ ɔyɛ no.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Munkyi bɔne, na monnɔ papa;","poem":1},{"text":"Mummu atɛntrenee wɔ asennii.","poem":2},{"text":"Ebia, Asafo Awurade Nyankopɔn","poem":1},{"text":"benya ahummɔbɔ ama","poem":2},{"lineBreak":true},{"text":"Yosef nkae no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti nea Awurade, Asafo Awurade Nyankopɔn se ni:","poem":1},{"text":"“Adwotwa bɛba mmorɔn nyinaa so","poem":2},{"text":"na ɔyaw ne apinisi bɛba mmɔnten so.","poem":1},{"text":"Wɔbɛfrɛ akuafo ama wɔabesu","poem":2},{"lineBreak":true},{"text":"na agyamfo abetwa adwo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wobetwa adwo wɔ bobeturo nyinaa mu,","poem":1},{"text":"efisɛ mɛnantew mo mu,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]},{"type":"heading","content":["Awurade Da No"]},{"type":"verse","number":18,"content":[{"text":"Nnome nka wɔn a","poem":1},{"text":"wɔpɛ sɛ Awurade da no ba!","poem":2},{"text":"Dɛn nti na mopɛ sɛ Awurade da no ba?","poem":1},{"text":"Saa da no bɛyɛ sum, na ɛnyɛ hann.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ɛbɛyɛ te sɛ onipa a oguan fi gyata anim","poem":1},{"text":"na okohyia sisi,","poem":2},{"text":"sɛnea owura ne fi","poem":1},{"text":"de ne nsa to ɔfasu so,","poem":2},{"lineBreak":true},{"text":"na ɔwɔ ka no.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na Awurade da no bɛyɛ sum; ɛrenyɛ hann,","poem":1},{"text":"ɛbɛyɛ sum kabii a hann nsinsan biara nni mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mikyi na mepo mo nyamesom mu aponto;","poem":1},{"text":"mʼani nnye mo afahyɛ nhyiamu ho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ɛwɔ mu sɛ mode ɔhyew afɔre ne aduan afɔre brɛ me de,","poem":1},{"text":"nanso merennye.","poem":2},{"text":"Mode asomdwoe afɔre brɛ me","poem":1},{"text":"nanso mʼani rensɔ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Momfa mo nnwonto gyegyeegye no mfi me so!","poem":1},{"text":"Merentie mo asankuten so nnwom.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mmom, momma atɛntrenee nteɛ sɛ asubɔnten,","poem":1},{"text":"na trenee nyɛ sɛ asuten a ɛrenyow da!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Israelfo, ɛnyɛ me na mode afɔrebɔde ne ayɛyɛde brɛɛ me","poem":1},{"text":"mfe aduanan wɔ sare so ana?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mode mo ho nyinaa ato Molok nyame,","poem":1},{"lineBreak":true},{"text":"ne mo honi Rɛfan so;","poem":1},{"text":"wɔyɛ ahoni a moayɛ sɛ mobɛsom wɔn.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɛno nti, metwa mo asu akɔ Damasko nohɔ,”","poem":1},{"text":"sɛnea Awurade a ne din ne Asafo Onyankopɔn se ni.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}