{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ECC","translationId":"twi_aka","name":"Ɔsɛnkafo","commonName":"Ɔsɛnkafo","title":"Ɔsɛnkafo","order":21,"numberOfChapters":12,"sha256":"b6eb550ab55fa377683c30cc74f4c008275e54a3949178bef06663aeea2a9308","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/twi_aka/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Biribiara Yɛ Adehuhuw"]},{"type":"verse","number":1,"content":["Eyinom ne nsɛm a Ɔsɛnkafo, ɔhene Dawid babarima a ɔyɛ ɔhene wɔ Yerusalem se:"]},{"type":"verse","number":2,"content":[{"text":"“Ahuhude! Ahuhude!”","poem":1},{"text":"Ɔsɛnkafo no na ose.","poem":2},{"text":"“Ahuhude mu ahuhude","poem":1},{"text":"Biribiara yɛ ahuhude.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dɛn na onipa nya fi nʼadwumayɛ nyinaa mu,","poem":1},{"text":"nea okum ne ho yɛ no owia so no?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Awo ntoatoaso ba na ɛkɔ,","poem":1},{"text":"nanso asase tim hɔ daa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Owia pue na owia kɔtɔ,","poem":1},{"text":"na ɛyɛ ntɛm kɔ nea epue fii hɔ no.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mframa bɔ kɔ anafo fam","poem":1},{"text":"na ɛdan hwɛ atifi fam;","poem":2},{"text":"ekyinkyin kɔ baabiara,","poem":1},{"text":"na ɛsan bɔ fa ne kwan so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nsubɔnten nyinaa sen kogu po mu,","poem":1},{"text":"nanso po nyɛ ma da.","poem":2},{"text":"Faako a nsubɔnten no fi no","poem":1},{"text":"hɔ na wɔsan kɔ bio.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Biribiara yɛ ɔbrɛ","poem":1},{"text":"a ɛboro nea obi bɛka so.","poem":2},{"text":"Ani nhwɛ ade nwie da","poem":1},{"text":"na aso nso ntie nsɛm mma ɛnyɛ mma da.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nea aba no bɛba bio,","poem":1},{"text":"nea wɔayɛ no, wɔbɛyɛ bio;","poem":2},{"lineBreak":true},{"text":"ade foforo biara nni owia yi ase.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Biribi wɔ hɔ a wobetumi aka wɔ ho se:","poem":1},{"text":"“Hwɛ! eyi yɛ ade foforo” ana?","poem":2},{"text":"Ɛwɔ hɔ dedaw fi tete nteredee;","poem":1},{"text":"ɛwɔ hɔ ansa na wɔwoo yɛn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔnkae tetefo no,","poem":1},{"text":"na wɔn a wonnya nnwoo wɔn no nso,","poem":2},{"text":"wɔn a wobedi wɔn akyi no","poem":1},{"text":"renkae wɔn.","poem":2}]},{"type":"heading","content":["Nimdeɛ Yɛ Ahuhude"]},{"type":"verse","number":12,"content":["Me, Ɔsɛnkafo, na meyɛ Israelhene wɔ Yerusalem."]},{"type":"verse","number":13,"content":["Mituu me ho sii hɔ sɛ mede nimdeɛ besua ayɛ nhwehwɛmu wɔ biribiara a wɔyɛ no owia yi ase ho. Adesoa duruduru a Onyankopɔn de ato adesamma so!"]},{"type":"verse","number":14,"content":["Mahu biribiara a wɔyɛ no owia yi ase; ne nyinaa nka hwee, ɛte sɛnea obi tu mmirika taa mframa."]},{"type":"verse","number":15,"content":[{"text":"Nea akyea no wontumi nteɛ;","poem":1},{"text":"na nea enni hɔ no wontumi nkan.","poem":2}]},{"type":"verse","number":16,"content":["Mekaa wɔ me tirim se, “Hwɛ, manyin na manya nimdeɛ bebree asen obiara a watena Yerusalem ahengua so ansa na merebedi ade. Manya nhumu ne nimdeɛ mu osuahu.”"]},{"type":"verse","number":17,"content":["Afei meyɛɛ mʼadwene sɛ mɛhwehwɛ na mate nimdeɛ, ne adammɔsɛm ne nkwaseasɛm ase. Nanso mihuu sɛ eyi nso te sɛnea obi tu mmirika taa mframa."]},{"type":"verse","number":18,"content":[{"text":"Nimdeɛ bebree de awerɛhow na ɛba;","poem":1},{"text":"nyansa dɔɔso a, awerɛhowdi dɔɔso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}