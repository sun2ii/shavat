{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ECC","translationId":"twi_aka","name":"Ɔsɛnkafo","commonName":"Ɔsɛnkafo","title":"Ɔsɛnkafo","order":21,"numberOfChapters":12,"sha256":"b6eb550ab55fa377683c30cc74f4c008275e54a3949178bef06663aeea2a9308","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/twi_aka/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Kae wo Bɔfo","poem":1},{"text":"wɔ wo mmerantebere mu,","poem":2},{"text":"ansa na nnabɔne no aba","poem":1},{"text":"na mfe a wobɛka se,","poem":2},{"lineBreak":true},{"text":"“Minni mu anigye biara” no reba,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ansa na owia ne hann,","poem":1},{"text":"ɔsram ne nsoromma aduru sum,","poem":2},{"lineBreak":true},{"text":"na omununkum asan aba osutɔ akyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bere a ofi no awɛmfo ho popo,","poem":1},{"text":"na mmarima ahoɔdenfo akom,","poem":2},{"text":"bere a awiyamfo agyae adwumayɛ, sɛ wosua nti","poem":1},{"text":"na wɔn a wɔhwɛ pema mu no ani so ayɛ kusuu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bere a wɔatoto abɔnten no apon mu","poem":1},{"text":"na awiyambea nnyigyei ano abrɛ ase;","poem":2},{"text":"bere a nnipa te nnomaa su na wɔanyan,","poem":1},{"text":"nanso wɔn nnwonto ano abrɛ ase;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"bere a nnipa suro sorokɔ","poem":1},{"text":"ne mmɔnten so amanenyasɛm;","poem":2},{"text":"bere a “ɔsonkoran” dua begu nhwiren","poem":1},{"text":"na tɛwtɛw twe ne ho kɔ no","poem":2},{"lineBreak":true},{"text":"na nkatede ho adwudwo.","poem":2},{"text":"Afei onipa kɔ ne daa home mu","poem":1},{"text":"na agyaadwotwafo tu gu mmɔnten so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kae no, ansa na dwetɛ hama no atew,","poem":1},{"text":"anaasɛ sikakɔkɔɔ asanka no abɔ;","poem":2},{"text":"ansa na sukuruwa no abobɔ wɔ asuten ho,","poem":1},{"text":"anaasɛ asubura so nkyimii abubu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"na dɔte san kɔ asase a efi mu bae,","poem":1},{"text":"na honhom no tu kɔ Onyankopɔn a ɔde mae no nkyɛn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ahuhude mu ahuhude” ɔsɛnkafo no na ose.","poem":1},{"text":"“Biribiara yɛ ahuhude!”","poem":2}]},{"type":"heading","content":["Asɛm No Awiei"]},{"type":"verse","number":9,"content":["Ɔsɛnkafo no yɛ onyansafo na ɔde nimdeɛ maa nnipa nso. Ɔdwenee na ɔyɛɛ nhwehwɛmu na obubuu mmɛ bebree."]},{"type":"verse","number":10,"content":["Ɔsɛnkafo no hwehwɛɛ sɛ obenya nsɛm a ɛfata, na nea ɔkyerɛw no yɛ pɛ na ɛyɛ nokware nso."]},{"type":"verse","number":11,"content":["Anyansafo nsɛm te sɛ nantwikafo mpeaw. Wɔn nsɛm a wɔaboa ano te sɛ nnadewa a wɔde abobɔ dua mu ma akɔ mu yiye. Saa nsɛm yi nyinaa fi Oguanhwɛfo baako nkyɛn."]},{"type":"verse","number":12,"content":["Mebɔ wo kɔkɔ sɛ twe wo ho fi biribiara a ɛka eyinom ho, me babarima. Nhoma bebrebe nkyerɛw nni awiei, na ne sua pii no ma honam yɛ mmerɛw."]},{"type":"verse","number":13,"content":[{"text":"Afei ne nyinaa atɔ asom;","poem":1},{"text":"nsɛm no awiei ni:","poem":2},{"text":"Suro Onyankopɔn na di nʼahyɛde so,","poem":1},{"text":"na onipa asɛde nyinaa ni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onyankopɔn bebu nneyɛe biara atɛn,","poem":1},{"text":"nea wɔayɛ asie nso ka ho,","poem":2},{"lineBreak":true},{"text":"sɛ ɛyɛ papa anaa bɔne.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}