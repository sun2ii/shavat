{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EXO","translationId":"twi_aka","name":"2 Mose (Ɛksodɔs)","commonName":"2 Mose (Ɛksodɔs)","title":"Mose Nhoma A Ɛto So Abien Ɛksodɔs","order":2,"numberOfChapters":40,"sha256":"fec7dd60236bf1dba4e305d6bc5e4f20c9997aeac3e80e6ba6e2e94349980915","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/twi_aka/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Ogye Ho Dwom"]},{"type":"verse","number":1,"content":["Na Mose ne Israelfo no too saa dwom yi de kamfoo Awurade:",{"text":"“Mɛto dwom ama Awurade, efisɛ","poem":1},{"text":"wadi nkonim anuonyam mu;","poem":2},{"text":"Watow ɔpɔnkɔ ne ne sotefo no","poem":1},{"text":"agu po mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Awurade yɛ mʼahoɔden, me dwom","poem":1},{"text":"ne me nkwagye.","poem":2},{"text":"Ɔyɛ me Nyankopɔn, na mɛkamfo no.","poem":1},{"text":"Ɔyɛ mʼagya Nyankopɔn, mɛma no so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade yɛ ɔkofo;","poem":1},{"text":"ne din ne Awurade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Farao nteaseɛnam ne nʼakofo, watow wɔn agu po mu.","poem":1},{"text":"Wɔamemem wɔ Po Kɔkɔɔ mu.","poem":2},{"text":"Misraim akofo atitiriw","poem":1},{"text":"awuwu asorɔkye ase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nsu akata wɔn so.","poem":1},{"text":"Wɔmemem asubun mu sɛ ɔbo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wo nsa nifa, Awurade,","poem":1},{"text":"tumi ne anuonyam ahyɛ no ma;","poem":2},{"text":"wo nsa nifa, Awurade,","poem":1},{"text":"atetew atamfo mu pasaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wo tumi kɛse no mu","poem":1},{"text":"na wonam tuu wɔn a wotia wo no gui.","poem":2},{"text":"Womaa wʼabufuw","poem":1},{"text":"bɛhyew wɔn sɛnea ogya hyew sare.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wugu ahome a,","poem":1},{"text":"nsu mu pae.","poem":2},{"text":"Egyinaa sɛ afasu","poem":1},{"text":"maa po taa fa ne fa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔtamfo kae se,","poem":1},{"text":"‘Mɛtaa wɔn, mɛto wɔn, asɛe wɔn.","poem":2},{"text":"Mɛtwe mʼafoa wɔ wɔn so","poem":1},{"text":"atwitwa wɔn asinasin.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nanso Onyankopɔn bɔɔ ne mframa","poem":1},{"text":"ma po kataa wɔn so.","poem":2},{"text":"Wɔmemem sɛ sumpii","poem":1},{"text":"wɔ subun no mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hena na ɔte sɛ Awurade wɔ anyame mu?","poem":1},{"text":"Hena na ɔte sɛ wo?","poem":2},{"text":"Obirɛmpɔn, wɔ kronkronyɛ mu;","poem":1},{"text":"nea yɛde osuro kronkron ma nʼanuonyam,","poem":2},{"lineBreak":true},{"text":"Ɔnwonwani Nyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Woteɛɛ wo nsa nifa","poem":1},{"text":"na asase menee wɔn.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Woadi nnipa a wugyee wɔn no anim.","poem":1},{"text":"Wʼayamye mu,","poem":2},{"text":"wubedi wo nkurɔfo a woagye wɔn anim.","poem":1},{"text":"Wʼahoɔden mu, wobɛkyerɛ wɔn kwan","poem":2},{"lineBreak":true},{"text":"akɔ wo tenabea kronkron hɔ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amanaman bɛte ama wɔn ho apopo.","poem":1},{"text":"Ehu bɛka nnipa a wɔwɔ Filistia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Edom mpanyimfo besuro.","poem":1},{"text":"Atumfo a wɔwɔ Moab ho bɛwosow.","poem":2},{"text":"Na nnipa a wɔwɔ Kanaan nyinaa bɛbɔ huboa.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ehu ne suro bɛtɔ wɔn so.","poem":2},{"text":"Awurade, wo tumi nti,","poem":1},{"text":"wɔremma yɛn so!","poem":2},{"text":"Wo nkurɔfo a wotɔɔ wɔn","poem":1},{"text":"Betwa wɔn ho asomdwoe mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wode wɔn bɛba abedua wɔn","poem":1},{"text":"wɔ wo bepɔw so,","poem":2},{"text":"wo ara wo fi hɔ, Awurade—","poem":1},{"text":"Kronkronbea a woasiesie sɛ wo tenabea no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Awurade bedi hene","poem":1},{"text":"akosi daa.”","poem":2}]},{"type":"verse","number":19,"content":["Farao apɔnkɔ, nʼapɔnkɔkafo ne ne nteaseɛnam pɛɛ sɛ wɔfa po no mu; nanso Awurade buu nsu afasu no guu wɔn so bere a na Israelfo no nam mu sɛ asase wosee so."]},{"type":"verse","number":20,"content":["Ɛhɔ na Odiyifobea Miriam a ɔyɛ Aaron nuabea faa akyene bi bɔ de dii mmea no anim ma wɔsawee."]},{"type":"verse","number":21,"content":["Ɛnna Miriam too saa dwom yi:",{"text":"“Monto dwom mma Awurade","poem":1},{"text":"na wadi nkonim anuonyam mu.","poem":2},{"text":"Wama ɔpɔnkɔ ne ne sotefo","poem":1},{"text":"amem po ase.”","poem":2}]},{"type":"verse","number":22,"content":["Afei, Mose dii Israelfo no anim ne wɔn tu fii Po Kɔkɔɔ no ho kɔɔ Sur sare so. Na wɔnantew sare no so nnansa a wɔannya nsu annom."]},{"type":"verse","number":23,"content":["Woduu Mara no, wɔantumi annom ɛhɔ nsu, efisɛ na ɛyɛ nwene. Ɛno nti na wɔfrɛ hɔ Mara no; ase ne: Nweenwen."]},{"type":"verse","number":24,"content":["Enti nnipa no nwiinwii tiaa Mose sɛ, “Dɛn na yɛnnom?”"]},{"type":"verse","number":25,"content":["Mose srɛɛ Awurade sɛ ɔmmoa wɔn, na Awurade kyerɛɛ no dubaa bi. Na ɔtow too nsu no mu, na ɛyɛɛ dɛ maa wotumi nomee. Mara hɔ na Awurade hyɛɛ saa mmara yi maa wɔn se,"]},{"type":"verse","number":26,"content":["“Sɛ mubetie Awurade mo Nyankopɔn nne, na moayɛ osetie ayɛ ade trenee de a, ɔyare a mema ɛbɔɔ Misraimfo no, meremma bi mmɔ mo, efisɛ mene Awurade a mesa mo nyarewa.”"]},{"type":"verse","number":27,"content":["Wɔbaa Elim a ɛhɔ na na mmura dumien ne mmedua aduɔson wɔ, nti wosisii wɔn ntamadan, tenaa mmura no ho."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}