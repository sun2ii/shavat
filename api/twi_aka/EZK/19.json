ne ba foforo","poem":1},{"text":"yɛɛ no gyata ɔhoɔdenfo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okyinkyin gyata no mu","poem":1},{"text":"efisɛ na wayɛ gyata hoɔdenfo.","poem":2},{"text":"Osuaa sɛnea wɔtetew hanam mu","poem":1},{"text":"na ɔwee nnipa nam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obubuu wɔn abandennen","poem":1},{"text":"na ɔsɛee wɔn nkurow.","poem":2},{"text":"Asase no ne wɔn a wɔte so nyinaa no,","poem":1},{"text":"ne mmubomu bɔɔ wɔn hu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Afei amanaman no sɔre tiaa no,","poem":1},{"text":"wɔn a wofi nsase a atwa ahyia no so.","poem":2},{"text":"Woguu no asau kyeree no","poem":1},{"text":"wɔ wɔn amoa mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔde nnarewa twee no kɔhyɛɛ buw mu","poem":1},{"text":"na wɔde no brɛɛ Babilonia hene.","poem":2},{"text":"Wɔde no too afiase,","poem":1},{"text":"na wɔante ne mmubomu no bio","poem":2},{"lineBreak":true},{"text":"wɔ Israel mmepɔw no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Na wo na te sɛ bobedua","poem":1},{"text":"a wɔatɛw no asu ho wɔ wo bobeturo mu.","poem":2},{"text":"Na ɛsow aba, na eyiyii mman","poem":1},{"text":"nsu a onya no bebree no nti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne mman yɛɛ den yiye;","poem":1},{"text":"edi mu sɛ wɔde yɛ ahemfo ahempema.","poem":2},{"text":"Ɛkorɔn, bunkam faa nhaban a ayɛ kuhaa no so,","poem":1},{"text":"ne sorokɔ ne ne mman bebree no","poem":2},{"lineBreak":true},{"text":"maa no yɛɛ sononko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso wɔde abufuwhyew tuu nʼase","poem":1},{"text":"de no hwee fam.","poem":2},{"text":"Apuei mframa maa no kasae,","poem":1},{"text":"ɛsow aba tetew gui;","poem":2},{"text":"na ne mman a ɛwɔ ahoɔden no twintwamee","poem":1},{"text":"na ogya hyewee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei wɔakɔtɛw no wɔ sare so","poem":1},{"text":"asase kesee a nsu nni mu mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ogya trɛw fii ne mman baako so","poem":1},{"text":"na ɛhyew nʼaba.","poem":2},{"text":"Anka mman a ɛwɔ ahoɔden baako mpo wɔ so;","poem":1},{"text":"nea wɔde yɛ ahemfo ahempema ma ɛyɛ yiye no.’","poem":2},"Eyi yɛ kwadwom na ma wɔnto no saa.”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}