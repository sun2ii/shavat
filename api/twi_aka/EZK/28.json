{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EZK","translationId":"twi_aka","name":"Hesekiel","commonName":"Hesekiel","title":"Odiyifo Hesekiel Nhoma","order":26,"numberOfChapters":48,"sha256":"6437dbb17ccbf08ce3cb1c36c9a59b41150c1538f3a89f29a61af04c150b3e71","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/twi_aka/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Nkɔmhyɛ A Etia Tirohene"]},{"type":"verse","number":1,"content":["Awurade asɛm baa me nkyɛn se:"]},{"type":"verse","number":2,"content":["“Onipa ba, ka kyerɛ Tiro sodifo no se: ‘Sɛɛ na Otumfo Awurade se:",{"text":"“ ‘Wufi wʼahantan koma mu ka se,","poem":1},{"text":"“Meyɛ onyame;","poem":2},{"text":"mete onyame bi ahengua so","poem":1},{"text":"wɔ po mfimfini.”","poem":2},{"text":"Nanso woyɛ onipa, wonyɛ onyame,","poem":1},{"text":"ɛwɔ mu, wudwen sɛ wunim nyansa sɛ onyame bi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wunim nyansa sen Daniel ana?","poem":1},{"text":"Wunim kokoamsɛm biara ana?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wonam wo nyansa ne nhumu so","poem":1},{"text":"anya ahode ama wo ho,","poem":2},{"text":"woapɛ sikakɔkɔɔ ne dwetɛ bebree","poem":1},{"text":"agu wʼadekoradan mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wonam wʼaguadi mu nyansa so","poem":1},{"text":"ama wʼahonya adɔɔso,","poem":2},{"text":"na wʼahonya nti","poem":1},{"text":"woahoran wɔ wo koma mu.","poem":2}]},{"type":"verse","number":6,"content":["“ ‘Ɛno nti sɛɛ na Otumfo Awurade se:",{"text":"“ ‘Esiane sɛ wudwen sɛ wunim nyansa","poem":1},{"text":"te sɛ Onyame nti,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mede ananafo reba abetia wo,","poem":1},{"text":"amanaman no mu ɔdesɛefo pa ara;","poem":2},{"text":"wɔbɛtwetwe wɔn afoa","poem":1},{"text":"wɔ wʼahoɔfɛ ne wo nyansa so","poem":2},{"lineBreak":true},{"text":"na wɔahwirew wʼanuonyam no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔde wo bɛto amoa no mu,","poem":1},{"text":"na wubewu owu yaayaw","poem":2},{"lineBreak":true},{"text":"wɔ ɛpo mfimfini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Afei wobɛka se, “Meyɛ onyame,”","poem":1},{"text":"wɔ wɔn a wokum wo no anim ana?","poem":2},{"text":"Wobɛyɛ onipa na ɛnyɛ onyame,","poem":1},{"text":"wɔ wɔn a wokum wo no nsam.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wubewu momonotofo wu","poem":1},{"text":"wɔ ananafo nsam.","poem":2},"Me na maka, Otumfo Awurade asɛm ni.’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["Awurade asɛm baa me nkyɛn se:"]},{"type":"verse","number":12,"content":["“Onipa ba, ma kwadwom a ɛfa Tirohene ho so na ka kyerɛ no se: ‘Sɛɛ na Otumfo Awurade se:",{"text":"“ ‘Na anka woyɛ pɛyɛ nhwɛso,","poem":1},{"text":"na wowɔ nyansa na woyɛ ahoɔfɛdua.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Na anka wowɔ Eden","poem":1},{"text":"Onyankopɔn turo no mu.","poem":2},{"text":"Wɔde abohemaa nyinaa siesie wo:","poem":1},{"text":"bogyanambo, akraatebo ne bɔwerɛbo","poem":2},{"lineBreak":true},{"text":"sikabereɛbo, apopobibiribo ne ahwehwɛbo,","poem":2},{"lineBreak":true},{"text":"hoabo, nsrammabo ne ahabammono bo;","poem":2},{"text":"wɔde sika kɔkɔɔ na ayɛ wʼahyehyɛde,","poem":1},{"text":"wosiesiee ne nyinaa da a wɔbɔɔ wo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wɔsraa wo ngo sɛ ɔhwɛfo kerub,","poem":1},{"text":"efisɛ saa na mehyɛɛ wo.","poem":2},{"text":"Na wowɔ Onyankopɔn bepɔw kronkron no so;","poem":1},{"text":"wonantew ogya abo mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Na anka wʼakwan ho nni asɛm","poem":1},{"text":"efi da a wɔbɔɔ wo no","poem":2},{"text":"kosii sɛ wohuu amumɔyɛ wɔ wo mu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wʼaguadi a mu trɛw no nti","poem":1},{"text":"wɔde akakabensɛm hyɛɛ wo ma","poem":2},{"lineBreak":true},{"text":"na woyɛɛ bɔne.","poem":2},{"text":"Ɛno nti mepam wo fii","poem":1},{"text":"Onyankopɔn bepɔw no so wɔ animguase mu,","poem":2},{"text":"na miyii wo adi, ɔhwɛfo kerub,","poem":1},{"text":"fii ogya abo no mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wohyerɛn wɔ wo koma mu","poem":1},{"text":"wʼahoɔfɛ nti","poem":2},{"text":"na womaa wo nyansa porɔwee,","poem":1},{"text":"wʼanuonyam no nti.","poem":2},{"text":"Enti metow wo kyenee fam;","poem":1},{"text":"na mede wo yɛɛ ahwɛde wɔ ahemfo anim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wode wo nnebɔne ne aguadi mu asisi","poem":1},{"text":"agu wo kronkrommea ho fi","poem":2},{"text":"ɛno nti memaa ogya fii wo mu","poem":1},{"text":"na ɛhyew wo,","poem":2},{"text":"na memaa wo dan nsõ wɔ fam","poem":1},{"text":"wɔ wɔn a na wɔrehwɛ no nyinaa anim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aman a na wonim wo nyinaa","poem":1},{"text":"ho adwiriw wɔn wɔ wo ho:","poem":2},{"text":"wʼawiei ayɛ ahometew","poem":1},{"text":"na wɔrenhu wo bio.’ ”","poem":2}]},{"type":"heading","content":["Nkɔmhyɛ A Etia Sidon"]},{"type":"verse","number":20,"content":["Awurade asɛm baa me nkyɛn se:"]},{"type":"verse","number":21,"content":["“Onipa ba, fa wʼani kyerɛ Sidon na hyɛ nkɔm tia no"]},{"type":"verse","number":22,"content":["na ka se: ‘Sɛɛ na Otumfo Awurade se:",{"text":"“ ‘Me ne wo anya, Sidon","poem":1},{"text":"na mɛda mʼanuonyam adi wɔ mo mu.","poem":2},{"text":"Wubehu sɛ mene Awurade no,","poem":1},{"text":"bere a mede asotwe aba ne so","poem":2},{"lineBreak":true},{"text":"na mada me ho adi sɛ ɔkronkronni wɔ ne mu no.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mɛma ɔyaredɔm aba ne so","poem":1},{"text":"na mama mogya ateɛ wɔ ne mmɔnten so.","poem":2},{"text":"Apirafo bɛtotɔ wɔ ne mu,","poem":1},{"text":"bere a afoa redi ahim wɔ ne ho nyinaa.","poem":2},{"lineBreak":true},{"text":"Afei na wobehu sɛ mene Awurade no.","poem":2}]},{"type":"verse","number":24,"content":["“ ‘Na Israelfo rennya yɔnkonom a wɔwɔ adwemmɔne, wɔn a wɔwowɔ yayaayaw sɛ ohwirem ne nsɔe bio. Afei na wobehu sɛ mene Otumfo Awurade no."]},{"type":"verse","number":25,"content":["“ ‘Sɛɛ na Otumfo Awurade se: Sɛ meboa Israelfo ano fi aman a wabɔ wɔn apete no so a, mɛda me kronkronyɛ adi wɔ wɔn mu, ama amanaman no ahu. Afei wɔbɛtena wɔn ankasa asase a mede maa me somfo Yakob no so."]},{"type":"verse","number":26,"content":["Wɔbɛtena hɔ asomdwoe mu na wobesisi adan, ayeyɛ bobe nturo; Wɔbɛtena ase asomdwoe mu wɔ bere a matwe ne yɔnkonom a wɔkasa tiaa no no nyinaa aso. Afei wobehu sɛ mene Awurade, wɔn Nyankopɔn no.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}