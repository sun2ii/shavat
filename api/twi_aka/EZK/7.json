{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EZK","translationId":"twi_aka","name":"Hesekiel","commonName":"Hesekiel","title":"Odiyifo Hesekiel Nhoma","order":26,"numberOfChapters":48,"sha256":"6437dbb17ccbf08ce3cb1c36c9a59b41150c1538f3a89f29a61af04c150b3e71","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/twi_aka/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Awiei No Aba"]},{"type":"verse","number":1,"content":["Awurade asɛm baa me nkyɛn se,"]},{"type":"verse","number":2,"content":["“Onipa ba, eyi ne asɛm a Otumfo Awurade ka kyerɛ Israel asase no:",{"text":"“ ‘Awiei no! Awiei no adu","poem":1},{"text":"asase no ntwea anan no so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awiei no adu wɔ wo so,","poem":1},{"text":"na mehwie mʼabufuwhyew agu wo so.","poem":2},{"text":"Megyina wʼabrabɔ so abu wo atɛn na","poem":1},{"text":"matua wo ka wɔ wo nneyɛe bɔne nyinaa ho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Merenhu wo mmɔbɔ","poem":1},{"text":"na meremfa wo ho nkyɛ wo.","poem":2},{"text":"Ampa ara metua wo ka wɔ wo suban","poem":1},{"text":"ne nneyɛe bɔne a ɛwɔ wo mu no ho,","poem":2},"na moahu sɛ mene Awurade.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“Sɛɛ na Otumfo Awurade se:",{"text":"“ ‘Atoyerɛnkyɛm! Atoyerɛnkyɛm a wontee da","poem":1},{"text":"nam kwan so reba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awiei no aba!","poem":1},{"text":"Awiei no aba!","poem":2},{"text":"Ama ne ho so atia wo.","poem":1},{"text":"Aba!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔsɛe aba mo so,","poem":1},{"text":"aba mo a mote asase no so no so.","poem":2},{"text":"Bere no adu, da no abɛn;","poem":1},{"text":"huboabɔ a ɛnyɛ mmepɔw so ahosɛpɛw.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Merebehwie mʼabufuwhyew agu wo so","poem":1},{"text":"de awie mʼabufuw a etia wo no.","poem":2},{"text":"Megyina wo nneyɛe so abu wo atɛn,","poem":1},{"text":"na matua wo nneyɛe bɔne nyinaa so ka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Merenhu wo mmɔbɔ,","poem":1},{"text":"na meremfa wo ho nkyɛ wo.","poem":2},{"text":"Metua wo ka wɔ wo suban","poem":1},{"text":"ne nneyɛe bɔne a ɛwɔ wo mu no ho.","poem":2},"Afei mubehu sɛ me, Awurade, na mebobɔ mo."]},{"type":"verse","number":10,"content":[{"text":"“ ‘Da no ni;","poem":1},{"text":"hwɛ, aba!","poem":2},{"text":"Atemmuda no apue,","poem":1},{"text":"abaa no afefɛw,","poem":2},{"lineBreak":true},{"text":"ahantan ahaahan!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kitikitiyɛ asɔre, abaa","poem":1},{"text":"a wɔde twe amumɔyɛ aso.","poem":2},{"text":"Ɛrenka nnipa no mu biara,","poem":1},{"text":"dɔm no mu biara,","poem":2},{"lineBreak":true},{"text":"ahonyade ne nea ɛsom bo biara renka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bere no aso,","poem":1},{"text":"da no adu.","poem":2},{"text":"Mma adetɔni ani nnye","poem":1},{"text":"anaa ɔdetɔnfo werɛ nhow,","poem":2},{"lineBreak":true},{"text":"efisɛ abufuwhyew wɔ nnipadɔm no nyinaa so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nea ɔtɔn no nsa renka asase","poem":1},{"text":"a watɔn no bio","poem":2},{"lineBreak":true},{"text":"wɔ bere a wɔn baanu te ase,","poem":2},{"text":"efisɛ anisoadehu a ɛfa nnipadɔm","poem":1},{"text":"no nyinaa ho no rensesa.","poem":2},{"text":"Wɔn bɔne nti, wɔn mu baako koraa","poem":1},{"text":"remfa ne ho nni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘Wɔahyɛn akobɛn no,","poem":1},{"text":"na wɔboaboa biribiara ano de,","poem":2},{"text":"nanso obiara renkɔ ɔsa,","poem":1},{"text":"efisɛ mʼabufuwhyew wɔ nnipakuw no nyinaa so.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Afoa wɔ mfikyiri","poem":1},{"text":"na ɔyaredɔm ne ɔkɔm wɔ fie;","poem":2},{"text":"wɔn a wɔwɔ ɔman no mu","poem":1},{"text":"bɛtotɔ wɔ afoa ano.","poem":2},{"text":"Wɔn a wɔwɔ kuropɔn no mu no,","poem":1},{"text":"ɔyaredɔm ne ɔkɔm bekum wɔn.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔn a wɔanya wɔn ti adidi mu","poem":1},{"text":"na wɔaguan no bɛtena mmepɔw no so.","poem":2},{"text":"Na wɔakurum te sɛ","poem":1},{"text":"aku mu mmorɔnoma,","poem":2},{"lineBreak":true},{"text":"wɔn mu biara bɔne nti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nsa nyinaa bedwudwo","poem":1},{"text":"na nkotodwe nyinaa ayɛ mmrɛw sɛ nsu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wobefurafura atweaatam","poem":1},{"text":"na wɔabɔ huboa.","poem":2},{"text":"Aniwu bɛkata wɔn anim","poem":1},{"text":"na wɔayi wɔn tinwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘Wɔbɛtow wɔn dwetɛ agu mmɔnten so,","poem":1},{"text":"na wɔn sikakɔkɔɔ bɛyɛ ade a ɛho ntew.","poem":2},{"text":"Wɔn dwetɛ ne sikakɔkɔɔ","poem":1},{"text":"rentumi nnye wɔn","poem":2},{"lineBreak":true},{"text":"Awurade abufuwhyew da no.","poem":2},{"text":"Ɛrenkum wɔn kɔm","poem":1},{"text":"na ɛrenhyɛ wɔn yafunu ma,","poem":2},{"lineBreak":true},{"text":"efisɛ ayɛ wɔn hintidua de wɔn akɔ bɔne mu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na wɔde wɔn nnwinne afɛfɛ no hoahoa wɔn ho,","poem":1},{"text":"na wɔde yeyɛɛ wɔn ahoni a ɛyɛ akyiwade","poem":2},{"text":"ne nsɛsode tantan.","poem":1},{"text":"Enti mɛdan eyinom nneɛma a ho ntew no ama wɔn.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mede ne nyinaa bɛma ananafo sɛ asade","poem":1},{"text":"na mede ama asase so atirimɔdenfo sɛ akorɔnne,","poem":2},{"lineBreak":true},{"text":"na wobegu ho fi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Meyi mʼani afi wɔn so","poem":1},{"text":"na wobegu beae a ɛsom me bo no ho fi.","poem":2},{"text":"Akorɔmfo bewura hɔ","poem":1},{"text":"na wɔagu ho fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘Monyɛ nkɔnsɔnkɔnsɔn,","poem":1},{"text":"efisɛ mogyahwiegu ayɛ asase no so ma,","poem":2},{"lineBreak":true},{"text":"na akakabensɛm ahyɛ kuropɔn no ma.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɛma aman no mu otirimɔdenfo pa ara","poem":1},{"text":"abɛfa wɔn afi;","poem":2},{"text":"mɛma ɔhoɔdenfo ahomaso aba awiei,","poem":1},{"text":"na wɔn kronkrommea ho begu fi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sɛ ehu ba a,","poem":1},{"text":"wɔbɛhwehwɛ asomdwoe akyi kwan nanso ɛbɛbɔ wɔn.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Atoyerɛnkyɛm bedi atoyerɛnkyɛm akyi aba;","poem":1},{"text":"huhuhuhu bedi huhuhuhu akyi.","poem":2},{"text":"Wɔbɛpɛ sɛ wobenya anisoadehu afi odiyifo no hɔ,","poem":1},{"text":"asɔfo no nkyerɛkyerɛ a ɛfa mmara no ho no bɛbɔ wɔn,","poem":2},{"lineBreak":true},{"text":"saa ara na wɔrennya afotu mfi mpanyimfo hɔ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɔhene no betwa adwo,","poem":1},{"text":"ɔheneba no befura abawpa,","poem":2},{"lineBreak":true},{"text":"na asase no so nnipa nsa bɛpopo.","poem":2},{"text":"Me ne wɔn bedi no sɛnea wɔn nneyɛe te","poem":1},{"text":"na megyina wɔn tebea so abu wɔn atɛn.","poem":2},"Afei wobehu sɛ me ne Awurade no.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}