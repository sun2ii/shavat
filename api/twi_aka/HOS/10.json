{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israel yɛɛ bobe a ɛtrɛtrɛw;","poem":1},{"text":"ɔsow aba maa ne ho.","poem":2},{"text":"Bere a nʼaba redɔɔso no,","poem":1},{"text":"osisii afɔremuka bebree;","poem":2},{"text":"nʼasase rekɔ so yɛ yiye no","poem":1},{"text":"osiesie nʼabosom dum kronkron no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaadaasɛm wɔ wɔn koma mu,","poem":1},{"text":"nti ɛsɛ sɛ wonya wɔn afɔdi so asotwe.","poem":2},{"text":"Awurade bebubu wɔn afɔremuka,","poem":1},{"text":"na wasɛe wɔn abosom dum kronkron no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Afei, wɔbɛka se, “Yenni ɔhene,","poem":1},{"text":"efisɛ, yɛamfa nidi amma Awurade.","poem":2},{"text":"Mpo sɛ na yɛwɔ ɔhene koraa a,","poem":1},{"text":"dɛn na anka obetumi ayɛ ama yɛn?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔhyɛ bɔ ahorow bebree,","poem":1},{"text":"wɔka ntamhunu","poem":2},{"text":"na wɔyɛ apam ahorow;","poem":1},{"text":"ɛno nti mansotwe sɔresɔre","poem":2},{"text":"te sɛ wura a bɔre wɔ mu","poem":1},{"text":"a afifi asase a wɔafuntum so so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nnipa a wɔte Samaria no suro ma","poem":1},{"text":"Bet-Awen nantwi ba ohoni no.","poem":2},{"text":"Ne nkurɔfo besu.","poem":1},{"text":"Saa ara na nʼakɔmfo nso bɛyɛ,","poem":2},{"text":"wɔn a wogyee wɔn ani wɔ nʼanuonyam ho no.","poem":1},{"text":"Efisɛ wɔafa no afi wɔn nkyɛn kɔ nnommum mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔde no bɛkɔ Asiria,","poem":1},{"text":"de akɔhyɛ ɔhene kɛse no anuonyam.","poem":2},{"text":"Ebegu Efraim anim ase;","poem":1},{"text":"na Israel ani bewu wɔ ne nnua ahoni ho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria na ne hene bɛsen akɔ","poem":1},{"text":"te sɛ abaa a ɛtɛn nsu ani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔbɛsɛe abosonnan a wodi awurukasɛm ne bɔne wɔ mu no.","poem":1},{"lineBreak":true},{"text":"Nsɔe ne nnɛnkyɛnse befifi hɔ,","poem":1},{"text":"na akata wɔn afɔremuka so.","poem":2},{"text":"Afei wɔbɛka akyerɛ mmepɔw se, “Mommɛkata yɛn so!”","poem":1},{"text":"na wase nkoko se, “Munnwiriw ngu yɛn so!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Efi Gibea bere so, woayɛ bɔne, Israel,","poem":1},{"text":"na hɔ na woaka.","poem":2},{"text":"Na ɔko rentwiw amfa","poem":1},{"text":"amumɔyɛfo a wɔwɔ Gibea no so ana?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bere a mepɛ no, mɛtwe wɔn aso;","poem":1},{"text":"aman bɛboaboa wɔn ho ano atia wɔn.","poem":2},{"lineBreak":true},{"text":"Wɔde mpokyerɛ begu wɔn wɔ wɔn bɔne dodow ho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim yɛ nantwi ba a wɔayɛn no,","poem":1},{"text":"a ɔpɛ awiporowbea adwuma,","poem":2},{"text":"enti mede konnua","poem":1},{"text":"bɛto ne kɔn fɛɛfɛ mu.","poem":2},{"text":"Mɛkyerɛ Efraim ɔkwan,","poem":1},{"text":"ɛsɛ sɛ Yuda funtum asase no,","poem":2},{"text":"na Yakob nso siesie so.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dua trenee aba ma wo ho,","poem":1},{"text":"twa ɔdɔ aba a ɛtena hɔ daa,","poem":2},{"text":"siesie wʼasase a womfuntumii so no;","poem":1},{"text":"na bere adu sɛ wohwehwɛ Awurade,","poem":2},{"text":"kosi sɛ ɔbɛba","poem":1},{"text":"abɛpete trenee agu wo so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nanso woadua atirimɔden aba,","poem":1},{"text":"na woatwa aba bɔne.","poem":2},{"text":"Woadi nnaadaa aba.","poem":1},{"text":"Efisɛ wode wo ho ato wʼahoɔden","poem":2},{"text":"ne wʼakofo bebrebe no so,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ɔko mu huuyɛ bɛsɔre atia wo nkurɔfo,","poem":1},{"text":"na wʼaban nyinaa bɛsɛe,","poem":2},{"text":"sɛnea Salman sɛee Bet Arbel ɔko da no,","poem":1},{"text":"da a wɔde ɛnanom ne wɔn mma hwehwee fam no.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saa ara na ɛbɛba wo so, Bet-El,","poem":1},{"text":"efisɛ wʼatirimɔdensɛm no dɔɔso.","poem":2},{"text":"Sɛ da no du a,","poem":1},{"text":"Wɔbɛsɛe Israelhene no koraa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}