{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efraim de mframa ayɛ aduan;","poem":1},{"text":"odi apuei mframa akyi daa","poem":2},{"text":"na odi atoro yɛ akakabensɛm bebree.","poem":1},{"text":"Ɔne Asiria yɛ apam","poem":2},{"lineBreak":true},{"text":"na ɔde ngo kɔ Misraim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade wɔ sobo de bɔ Yuda;","poem":1},{"text":"ɔbɛtwe Yakob aso wɔ nʼakwan ho","poem":2},{"lineBreak":true},{"text":"na watua no ne nneyɛe so ka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔyafunu mu na osoo ne nua nantin;","poem":1},{"text":"onyinii no, ɔne Onyankopɔn peperee so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔne ɔbɔfo tentam dii ne so nkonim;","poem":1},{"text":"ɔde nusu srɛɛ ne nkyɛn adom.","poem":2},{"text":"Ohuu no wɔ Bet-El","poem":1},{"text":"ne no kasaa wɔ hɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asafo Awurade Nyankopɔn,","poem":1},{"text":"Awurade ne ne din a ahyeta!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛsɛ sɛ wosan kɔ wo Nyankopɔn nkyɛn.","poem":1},{"text":"Tena ɔdɔ ne trenee mu,","poem":2},{"lineBreak":true},{"text":"na twɛn wo Nyankopɔn daa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oguadini de asisi nsania yɛ nʼadwuma;","poem":1},{"text":"nʼani gye asisi ho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim hoahoa ne ho sɛ,","poem":1},{"text":"“Meyɛ ɔdefo; manya me ho.","poem":2},{"text":"Mʼahonya nyinaa mu wɔrenhu","poem":1},{"text":"amumɔyɛ biara wɔ me ho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mene Awurade wo Nyankopɔn,","poem":1},{"text":"a miyii wo fii Misraim.","poem":2},{"text":"Mɛma woakɔtena ntamadan mu bio","poem":1},{"text":"sɛnea na woyɛ wɔ wʼaponto afahyɛ nna mu no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mekasa kyerɛɛ adiyifo,","poem":1},{"text":"memaa wɔn anisoadehu bebree","poem":2},{"lineBreak":true},{"text":"na mefaa wɔn so kaa mmebusɛm.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gilead yɛ otirimɔdenfo ana?","poem":1},{"text":"Emu nnipa no yɛ ahuhufo!","poem":2},{"text":"Wɔde anantwi bɔ afɔre wɔ Gilgal ana?","poem":1},{"text":"Wɔn afɔremuka bɛyɛ te sɛ abo","poem":2},{"lineBreak":true},{"text":"a wɔahɔre no siw wɔ asase a wɔafuntum so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakob guan kɔɔ Aramfo asase so;","poem":1},{"text":"Israel som de nyaa ɔyere,","poem":2},{"lineBreak":true},{"text":"ɔhwɛɛ nguan de tuaa ti nsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Awurade nam odiyifo so","poem":1},{"text":"yii Israel fii Misraim,","poem":2},{"lineBreak":true},{"text":"ɔnam odiyifo so hwɛɛ no.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nanso Efraim ahyɛ no abufuw yayaayaw;","poem":1},{"text":"nʼAwurade bɛma ne mogyahwiegu ho afɔdi ada no so","poem":2},{"text":"na obetua nʼanimtiaabu no so ka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}