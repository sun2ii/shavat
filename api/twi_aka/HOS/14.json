{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Ahonu De Nhyira Ba"]},{"type":"verse","number":1,"content":[{"text":"Israel, san wʼakyi kɔ Awurade wo Nyankopɔn nkyɛn.","poem":1},{"text":"Wʼasehwe fi wo bɔne!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fa wo nsɛm a wowɔ","poem":1},{"text":"san kɔ Awurade nkyɛn.","poem":2},{"text":"Ka kyerɛ no se,","poem":1},{"text":"“Fa yɛn bɔne nyinaa kyɛ yɛn,","poem":2},{"text":"na fa ahummɔbɔ gye yɛn,","poem":1},{"text":"na yɛatumi ayi wo ayɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asiria rentumi nnye yɛn;","poem":1},{"text":"yɛrentena akofo apɔnkɔ so.","poem":2},{"text":"Yɛrenka bio da se, ‘Yɛn anyame’","poem":1},{"text":"nkyerɛ nea yɛn ara de yɛn nsa ayɛ,","poem":2},{"lineBreak":true},{"text":"na wo mu na ayisaa nya mmɔborɔhunu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mɛsa wɔn asoɔden yare.","poem":1},{"text":"Mefi me koma mu adɔ wɔn,","poem":2},{"lineBreak":true},{"text":"efisɛ mʼabufuw nni wɔn so bio.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɛyɛ sɛ obosu ama Israel.","poem":1},{"text":"Ɔbɛfefɛw ayɛ frɔmfrɔm te sɛ sukooko.","poem":2},{"text":"Te sɛ Lebanon sida no,","poem":1},{"text":"ɔde ne ntin betim fam;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ne mman bɛdennan.","poem":2},{"text":"Nʼahoɔfɛ bɛyɛ sɛ ngodua,","poem":1},{"text":"na ne hua ayɛ sɛ Lebanon sida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nnipa bɛtena ne nwini ase bio.","poem":1},{"text":"Obenyin ayɛ frɔmfrɔm te sɛ aburow.","poem":2},{"text":"Ɔbɛfefɛw ayɛ frɔmfrɔm te sɛ bobe,","poem":1},{"text":"na ne din a ahyeta bɛyɛ sɛ nsa a efi Lebanon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim dɛn na me ne ahoni wɔ yɛ bio?","poem":1},{"text":"Megye no so na mʼani aku ne ho.","poem":2},{"text":"Mete sɛ dua a nʼahaban mpo;","poem":1},{"text":"sɛ wobɛsow aba a, egyina me so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hena ne onyansafo? Obehu eyinom mu.","poem":1},{"text":"Hena na ɔwɔ nhumu? Ɔbɛte eyinom ase.","poem":2},{"text":"Awurade akwan teɛ.","poem":1},{"text":"Atreneefo nantew so,","poem":2},{"lineBreak":true},{"text":"nanso asoɔdenfo hintiw wɔ mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}