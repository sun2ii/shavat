{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Atemmu A Etia Israel"]},{"type":"verse","number":1,"content":[{"text":"“Muntie, mo asɔfo!","poem":1},{"noteId":2},{"text":"Monhyɛ eyi nso, mo Israelfo!","poem":2},{"text":"Monyɛ asow, adehyefi!","poem":1},{"lineBreak":true},{"text":"Saa atemmu yi tia mo:","poem":1},{"text":"Moayɛ afiri wɔ Mispa,","poem":2},{"lineBreak":true},{"text":"ne asau a wɔagu no Tabor so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Atuatewfo adɔ mogyahwiegu mu asukɔ.","poem":1},{"text":"Mɛtwe wɔn nyinaa aso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Minim Efraim ho nsɛm nyinaa;","poem":1},{"text":"wɔmfaa Israel nhintaw me ɛ.","poem":2},{"text":"Efraim, mprempren de wobɔ aguaman;","poem":1},{"text":"na Israel aporɔw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Wɔn nneyɛe mma wɔ kwan","poem":1},{"text":"mma wɔnnkɔ Nyankopɔn nkyɛn.","poem":2},{"text":"Aguamammɔ honhom wɔ wɔn koma mu;","poem":1},{"text":"wonnye Awurade nto mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Israel ahantan di tia no.","poem":1},{"text":"Israelfo no, mpo Efraim hintihintiw wɔ wɔn amumɔyɛ mu;","poem":2},{"lineBreak":true},{"text":"Yuda nso ne wɔn hintiw saa ara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sɛ wɔne wɔn nguan ne wɔn anantwi","poem":1},{"text":"kɔhwehwɛ Awurade a","poem":2},{"text":"Wɔrenhu no,","poem":1},{"text":"efisɛ watwe ne ho afi wɔn ho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔanni Awurade nokware.","poem":1},{"text":"Wɔwowoo aguaman mma.","poem":2},{"text":"Sɛ wodi wɔn Ɔsram Foforo Afahyɛ a,","poem":1},{"text":"ɔbɛsɛe wɔn nsase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Hyɛn torobɛnto no wɔ Gibea.","poem":1},{"text":"Hyɛn mmɛn no wɔ Rama.","poem":2},{"text":"Momma ɔko nteɛmu so wɔ Bet Awen;","poem":1},{"text":"Benyamin, monsɔre nni anim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraim bɛda mpan","poem":1},{"text":"wɔ akontaabu da.","poem":2},{"text":"Israel mmusuakuw no mu no","poem":1},{"text":"mepae mu ka nea ɛwɔ mu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yuda sodifo no te sɛ","poem":1},{"text":"wɔn a woyiyi ahye so abo.","poem":2},{"text":"Mehwie mʼabufuw agu wɔn so","poem":1},{"text":"te sɛ nsuyiri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔhyɛ Efraim so,","poem":1},{"text":"wotiatia ne so wɔ atemmu mu,","poem":2},{"lineBreak":true},{"text":"wasi nʼadwene pi sɛ obedi ahoni akyi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɛyɛ sɛ nwewee ama Efraim","poem":1},{"text":"na mayɛ Yudafo sɛ dua a aporɔw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Bere a Efraim huu ne yare,","poem":1},{"text":"na Yuda nso huu nʼakuru no,","poem":2},{"text":"Efraim de nʼani kyerɛɛ Asiria.","poem":1},{"text":"Ɔsoma kɔɔ ɔhenkɛse no hɔ kɔpɛɛ mmoa.","poem":2},{"text":"Nanso wantumi ansa no yare,","poem":1},{"text":"na akuru no nso anwuwu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti mɛyɛ sɛ gyata ama Efraim","poem":1},{"text":"na mayɛ sɛ gyata hoɔdenfo ama Yuda.","poem":2},{"text":"Mɛtetew wɔn mu nketenkete, na makɔ;","poem":1},{"text":"Mɛsoa wɔn akɔ, na obiara rentumi nnye wɔn.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Afei mɛsan akɔ me nkyi","poem":1},{"text":"kosi sɛ wobenya ahonu.","poem":2},{"text":"Na wɔbɛhwehwɛ mʼakyi kwan;","poem":1},{"text":"wɔn awerɛhow mu, wɔbɛhwehwɛ me anibere so.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"5.1 Asɔfo, Israelfo ne ahemfo, saa akuw abiɛsa yi na na ɛsɛ sɛ wɔhwɛ bu atɛntrenee, nanso wɔn nyinaa buu ntɛnkyew.","reference":{"chapter":5,"verse":1}}]},"thisChapterLink":"/api/twi_aka/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}