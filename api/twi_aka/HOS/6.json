{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israel Nni Ahonu"]},{"type":"verse","number":1,"content":[{"text":"“Mommra, momma yɛnsan nkɔ Awurade nkyɛn.","poem":1},{"text":"Watetew yɛn mu asinasin","poem":2},{"text":"nanso ɔbɛsa yɛn yare.","poem":1},{"text":"Wapirapira yɛn","poem":2},{"lineBreak":true},{"text":"nanso ɔbɛkyekyere yɛn apirakuru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaanu akyi, ɔbɛma yɛanya ahoɔden;","poem":1},{"text":"nansa so, ɔde yɛn besi yɛn sibea","poem":2},{"lineBreak":true},{"text":"na yɛanya nkwa wɔ nʼanim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Momma yennye Awurade nto mu;","poem":1},{"text":"momma yɛnkɔ so nnye no nto mu.","poem":2},{"text":"Sɛnea owia pue da biara no, obepue;","poem":1},{"text":"ɔbɛba yɛn nkyɛn te sɛ osu a ɛtɔ awɔwbere mu","poem":2},{"lineBreak":true},{"text":"anaa asusow bere mu su a ɛfɔw asase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Dɛn na metumi de wo ayɛ, Efraim?","poem":1},{"text":"Dɛn na metumi de wo ayɛ, Yuda?","poem":2},{"text":"Mo dɔ te sɛ anɔpa bɔ,","poem":1},{"text":"ɛte sɛ anɔpa bosu a etu yera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mede mʼadiyifo twitwaa mo mu asinasin,","poem":1},{"text":"mede mʼanom nsɛm kunkum mo;","poem":2},{"text":"mʼatemmu baa mo so sɛ anyinam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mepɛ ahummɔbɔ na ɛnyɛ afɔrebɔ,","poem":1},{"text":"mepɛ Onyankopɔn ho nimdeɛ sen ɔhyew afɔre.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔabu apam no so sɛnea Adam yɛe.","poem":1},{"text":"Wɔanni me nokware wɔ hɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead yɛ atirimɔdenfo kuropɔn","poem":1},{"text":"a mogya anammɔn akeka hɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛnea akwamukafo ka kwan mu no","poem":1},{"text":"saa ara na asɔfokuw no nso yɛ;","poem":2},{"text":"wodi awu wɔ Sekem tempɔn so,","poem":1},{"text":"yɛ nnebɔne a ɛyɛ animguase.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mahu ahodwiriwde wɔ Israelfi.","poem":1},{"text":"Ɛhɔ, Efraim kɔ aguamammɔ mu","poem":2},{"lineBreak":true},{"text":"Israel gu ne ho fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Na wo Yuda nso,","poem":1},{"text":"wɔahyɛ otwa bere ama wo.","poem":2},{"lineBreak":true},{"text":"“Bere biara a mede me nkurɔfo siade bɛsan ama wɔn no,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}