{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"bere biara a mɛsa Israel yare no,","poem":2},{"text":"Efraim nnebɔne da adi.","poem":1},{"text":"Samaria awurukasɛm nso da adi.","poem":2},{"text":"Wɔyɛ nnaadaafo","poem":1},{"text":"akorɔmfo a wobubu adan ani kɔ afi mu,","poem":2},{"lineBreak":true},{"text":"ne akwamukafo a wɔbɔ korɔn wɔ mmɔnten so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na wonhu sɛ","poem":1},{"text":"mekae wɔn nnebɔne nyinaa.","poem":2},{"text":"Wɔn bɔne bunkam wɔn so;","poem":1},{"text":"egu mʼanim bere biara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Wɔde atirimɔdensɛm gyigye ɔhene no ani,","poem":1},{"text":"na wɔde atoro nso gyigye ahenemma no ani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔn nyinaa yɛ aguamammɔfo","poem":1},{"text":"a akɔnnɔ redɛw wɔ wɔn mu.","poem":2},{"text":"Wɔte sɛ fononoo a wɔasɔ mu gya","poem":1},{"text":"bere a brodotofo ahyɛ ase refɔtɔw nʼasikresiam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Da a ɔhene rehyɛ fa no","poem":1},{"text":"ahenemma bow nsa,","poem":2},{"lineBreak":true},{"text":"na ɔhene no fɛwdifo ne wɔn bɔ mu goru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔn koma te sɛ fononoo;","poem":1},{"text":"wɔde atirimpɔw bɔne kɔ ɔhene anim.","poem":2},{"text":"Wɔn nsusuwii bɔne no dɛɛdɛɛ anadwo mu nyinaa;","poem":1},{"text":"anɔpa, ɛdɛw te sɛ ogyatannaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔn nyinaa ayɛ hyew sɛ fononoo.","poem":1},{"text":"Wokunkum wɔn sodifo.","poem":2},{"text":"Wɔn ahemfo nyinaa hwehwe ase","poem":1},{"text":"na wɔn mu biara nsu mfrɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efraim ne aman no adi afra;","poem":1},{"text":"Efraim yɛ ɔfam a anyinya a wonkisae.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ananafo twe nʼahoɔden,","poem":1},{"text":"nanso onhu.","poem":2},{"text":"Dwen aba ne ti so,","poem":1},{"text":"nanso nʼani mmaa so ɛ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Israel ahantan di adanse tia no,","poem":1},{"text":"nanso eyi nyinaa akyi no","poem":2},{"text":"ɔnnsan nkɔ Awurade ne Nyankopɔn nkyɛn,","poem":1},{"text":"na ɔnhwehwɛ no nso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efraim te sɛ aborɔnoma,","poem":1},{"text":"wotumi daadaa no na onni adwene.","poem":2},{"text":"Ɔfrɛ Misraim,","poem":1},{"text":"na wadan akɔ Asiria.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ wɔkɔ a, mɛtow mʼasau agu wɔn so;","poem":1},{"text":"atwe wɔn aba fam te sɛ wim nnomaa.","poem":2},{"text":"Sɛ mete sɛ wɔretu abɔ mu a,","poem":1},{"text":"mɛkyere wɔn.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nnome nka wɔn,","poem":1},{"text":"efisɛ wɔatwe wɔn ho afi me ho!","poem":2},{"text":"Ɔsɛe mmra wɔn so","poem":1},{"text":"efisɛ wɔatew me so atua!","poem":2},{"text":"anka mepɛ sɛ migye wɔn","poem":1},{"text":"nanso wutwa atoro fa me ho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wommfi wɔn koma mu nsu mfrɛ me,","poem":1},{"text":"mmom wotwa adwo wɔ wɔn mpa so.","poem":2},{"text":"Wɔboaboa wɔn ho ano kɔhwehwɛ aduan ne nsa foforo,","poem":1},{"text":"nanso wɔtwe wɔn ho fi me ho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Metetew wɔn, hyɛɛ wɔn den,","poem":1},{"text":"nanso wɔbɔ pɔw bɔne tia me.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔnhwehwɛ Ɔsorosoroni no;","poem":1},{"text":"wɔte sɛ tadua a asɛe,","poem":2},{"text":"wɔn ntuanofo bɛtotɔ wɔ afoa ano","poem":1},{"text":"efisɛ, wɔnkasa obu so.","poem":2},{"text":"Eyi nti wobedi wɔn ho fɛw","poem":1},{"text":"wɔ Misraim asase so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}