{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israel Betwa Mfɛtɛ Aba"]},{"type":"verse","number":1,"content":[{"text":"“Monhyɛn torobɛnto!","poem":1},{"text":"Ɔkɔre bi wɔ Awurade fifo so","poem":2},{"text":"efisɛ nnipa no abu mʼapam so","poem":1},{"text":"na wɔasɔre atia me mmara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Afei Israel su frɛ me se,","poem":1},{"text":"‘Yɛn Nyankopɔn, yegye wo to mu!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanso Israel apo nea eye;","poem":1},{"text":"ɔtamfo bɛtaa no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wosisi ahemfo a minnim ho hwee,","poem":1},{"text":"wɔpaw ahenemma wɔ bere a mempenee so ɛ.","poem":2},{"text":"Wɔde wɔn dwetɛ ne wɔn sikakɔkɔɔ yɛ ahoni ma wɔn ho","poem":1},{"text":"de sɛe wɔn ankasa ho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tow wo nantwi ba ohoni no kyene, Samaria!","poem":1},{"text":"Mʼabufuwhyew reba wɔn so.","poem":2},{"text":"Wɔbɛtena nea ɛho ntew mu akosi da bɛn?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Wofi Israel!","poem":2},{"text":"Saa nantwi ba yi, odwumfo bi na osenii;","poem":1},{"text":"ɛnyɛ Onyankopɔn!","poem":2},{"text":"Wobebubu mu asinasin,","poem":1},{"text":"saa Samaria nantwi ba no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wodua mframa","poem":1},{"text":"na wotwa mfɛtɛ.","poem":2},{"text":"Awi a egyina hɔ no nni ti;","poem":1},{"text":"nti wɔrennya siam mfi mu.","poem":2},{"text":"Sɛ ɛsow aduan mpo a,","poem":1},{"text":"ahɔho na wobedi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔamene Israel;","poem":1},{"text":"afei ɔfra aman no mu","poem":2},{"text":"te sɛ ade a so nni mfaso biara.","poem":1},{"noteId":3}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na wɔakɔ Asiria","poem":1},{"text":"te sɛ wuram afurum a ɔno nko ara nenam.","poem":2},{"lineBreak":true},{"text":"Efraim nso atɔn ne ho ama adɔfo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɛwɔ mu, wɔatɔn wɔn ho wɔ amanaman no mu de,","poem":1},{"text":"nanso mɛboaboa wɔn ano.","poem":2},{"text":"Wɔn so befi ase atew","poem":1},{"text":"wɔ ɔhene kɛse bi nhyɛso ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ɛwɔ mu sɛ Efraim sisii afɔremuka bebree a wɔbɔ bɔnefakyɛ afɔre wɔ so de,","poem":1},{"text":"ɛno nti abɛyɛ afɔremuka a wɔyɛ bɔne wɔ so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mekyerɛw me mmara a ɛfa nneɛma bebree ho maa wɔn,","poem":1},{"text":"nanso wɔfaa no sɛ ananafo ade.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔde mʼayɛyɛde bɔ afɔre","poem":1},{"text":"na wɔwe nam no,","poem":2},{"text":"nanso wɔnsɔ Awurade ani.","poem":1},{"text":"Afei ɔbɛkae wɔn atirimɔdensɛm","poem":2},{"text":"na wɔatwe wɔn aso wɔ wɔn bɔne ho:","poem":1},{"text":"Wɔbɛsan akɔ Misraim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israel werɛ afi ne yɛfo","poem":1},{"text":"na wasisi ahemfi akɛseakɛse;","poem":2},{"text":"Yuda abɔ nkurow bebree ho ban.","poem":1},{"text":"Nanso mɛto ne nkuropɔn mu gya","poem":2},{"lineBreak":true},{"text":"a ɛbɛhyew wɔn aban.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"8.8 Wɔfaa Israel sɛ Onyankopɔn ankasa nkurɔfo (2 Mose 19.5; Amos 3.2). Nanso esiane sɛ ɔde ne ho akɔma aman foforo bi nti, nʼanuonyam pa ma ɔbɛyɛɛ animguaseman maa Onyankopɔn.","reference":{"chapter":8,"verse":8}}]},"thisChapterLink":"/api/twi_aka/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}