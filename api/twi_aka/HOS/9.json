{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_aka","name":"Hosea","commonName":"Hosea","title":"Odiyifo Hosea Nhoma","order":28,"numberOfChapters":14,"sha256":"0a7de27321aec4730970bc523eb888c34a3b2da524130f2f9cf02e77a6abbf30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_aka/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Israel Asotwe"]},{"type":"verse","number":1,"content":[{"text":"Nni ahurusi, Israel;","poem":1},{"text":"nsɛpɛw wo ho te sɛ aman a aka no.","poem":2},{"text":"Efisɛ woanni wo Nyankopɔn nokware,","poem":1},{"text":"wʼani gye aguamammɔ ho","poem":2},{"lineBreak":true},{"text":"wɔ awiporowbea nyinaa so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awiporowbea ne nsakyiamoa rentumi mma nnipa no aduan;","poem":1},{"text":"nsa foforo nso bɛbɔ wɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔrentena Awurade asase no so bio;","poem":1},{"text":"Efraim bɛsan akɔ Misraim","poem":2},{"lineBreak":true},{"text":"na wadi aduan a ɛho ntew wɔ Asiria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔremmɔ ahwiesa afɔre mma Awurade,","poem":1},{"text":"na wɔn afɔrebɔ nso nsɔ nʼani.","poem":2},{"text":"Saa afɔrebɔ yi bɛyɛ sɛ asufo brodo de ama wɔn;","poem":1},{"text":"wɔn a wodi nyinaa ho begu fi.","poem":2},{"text":"Saa aduan no bɛyɛ wɔn ankasa dea","poem":1},{"text":"na wɔrentumi mmfa nkɔ Awurade asɔredan mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dɛn na mobɛyɛ wɔ mo aponto da no","poem":1},{"text":"ne Awurade afahyɛnna no nso?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mpo sɛ woguan fi ɔsɛe mu a","poem":1},{"text":"Misraim bɛboaboa wɔn ano,","poem":2},{"lineBreak":true},{"text":"na Memfis besie wɔn.","poem":2},{"text":"Wɔn dwetɛ ahonyade befuw wura,","poem":1},{"text":"na wɔn ntamadan adan nsɔe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asotwe nna no reba,","poem":1},{"text":"akontaabu nna no adu;","poem":2},{"text":"ma Israel nhu eyi.","poem":1},{"text":"Esiane mo bɔne bebrebe","poem":2},{"text":"ne mo akokoakoko a adɔɔso nti","poem":1},{"text":"mofa no sɛ odiyifo yɛ kwasea,","poem":2},{"lineBreak":true},{"text":"na nea honhom akanyan no no yɛ ɔbɔdamfo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Odiyifo no ne me Nyankopɔn","poem":1},{"text":"yɛ Efraim so wɛmfo,","poem":2},{"text":"nanso wɔasum no afiri wɔ nʼakwan nyinaa so,","poem":1},{"text":"na ɔtan ahyɛ ne Nyankopɔn fi ma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔadu porɔwee bun mu,","poem":1},{"text":"sɛnea na ɛte wɔ Gibea nna no mu.","poem":2},{"text":"Onyankopɔn bɛkae wɔn atirimɔden","poem":1},{"text":"na watwe wɔn aso wɔ wɔn bɔne ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Bere a mihuu Israel no,","poem":1},{"text":"na ɛte sɛ nea mahu bobe wɔ nweatam so;","poem":2},{"text":"bere a mihuu mo agyanom no,","poem":1},{"text":"na ɛte sɛ nea mahu borɔdɔma aba a edi kan wɔ ne dua so.","poem":2},{"text":"Nanso bere a wɔbaa Baal-Peor nkyɛn no","poem":1},{"text":"wodwiraa wɔn ho maa ohoni nimguaseni no.","poem":2},{"lineBreak":true},{"text":"Wɔn ho yɛɛ nwini te sɛ ohoni a wɔdɔ no no ara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim anuonyam betu akɔ sɛ anomaa,","poem":1},{"text":"nyinsɛn ne awo nni ne mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mpo sɛ wɔtetew mmofra a,","poem":1},{"text":"mɛma mmofra no awuwu wɔ wɔn nsa mu.","poem":2},{"text":"Wonnue,","poem":1},{"text":"sɛ miyi mʼani fi wɔn so a!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mahu Efraim te sɛ Tiro,","poem":1},{"text":"a ɛda baabi a eye.","poem":2},{"text":"Nanso Efraim de ne mma","poem":1},{"text":"bɛbrɛ okumfo no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Fa ma wɔn, Awurade,","poem":1},{"text":"dɛn na wode bɛma wɔn?","poem":2},{"text":"Ma wɔn ɔyafunu a ɛpɔn","poem":1},{"text":"ne nufu a nufusu nni mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Wɔn atirimɔdensɛm nyinaa a wodii wɔ Gilgal nti,","poem":1},{"text":"mefaa wɔn ho tan wɔ hɔ.","poem":2},{"text":"Wɔn nnebɔne nti","poem":1},{"text":"mɛpam wɔn afi me fi.","poem":2},{"text":"Merennɔ wɔn bio;","poem":1},{"text":"efisɛ wɔn ntuanofo nyinaa yɛ atuatewfo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efraim agyigya,","poem":1},{"text":"wɔn ntin akisa,","poem":2},{"text":"nti wɔnsow aba.","poem":1},{"text":"Sɛ wɔwo mma mpo a,","poem":2},{"lineBreak":true},{"text":"mekunkum wɔn mma a wɔdɔ wɔn no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Me Nyankopɔn bɛpo wɔn,","poem":1},{"text":"efisɛ, wɔanyɛ osetie amma no;","poem":2},{"lineBreak":true},{"text":"Wobekyinkyin aman no mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}