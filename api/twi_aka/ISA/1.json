{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Saa anisoadehu a ɛfa Yuda ne Yerusalem ho no baa Amos babarima Yesaia so wɔ Yuda ahemfo Usia, Yotam, Ahas ne Hesekia mmere so."]},{"type":"line_break"},{"type":"heading","content":["Atuatewman"]},{"type":"verse","number":2,"content":[{"text":"Ɔsoro, muntie! Asase, yɛ aso!","poem":1},{"text":"Na Awurade akasa:","poem":2},{"text":"“Matetew mma ama wɔanyinyin,","poem":1},{"text":"nanso wɔatew me so atua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nantwi nim ne wura,","poem":1},{"text":"afurum nso nim ne wura mmoa adididaka,","poem":2},{"text":"nanso Israel nnim,","poem":1},{"text":"me nkurɔfo nte ase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nnome nka, amumɔyɛ man,","poem":1},{"text":"ɔman a wɔn afɔdi so,","poem":2},{"text":"nnebɔneyɛfo kuw,","poem":1},{"text":"mma a porɔwee ahyɛ wɔn ma!","poem":2},{"text":"Wɔatwe wɔn ho afi Awurade ho;","poem":1},{"text":"wɔapo Israel Kronkronni no,","poem":2},{"lineBreak":true},{"text":"wɔadan wɔn akyi akyerɛ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Adɛn nti na mopɛ sɛ wɔkɔ so boro mo?","poem":1},{"text":"Adɛn nti na moda so tew atua?","poem":2},{"text":"Wɔapira mo ti,","poem":1},{"text":"na mo koma nso di yaw.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Efi mo nan ase kosi mo ti so,","poem":1},{"text":"ahomeka biara nni mu,","poem":2},{"text":"apirakuru ne ahonhon nko ara","poem":1},{"text":"akuru a anim deda hɔ","poem":2},{"text":"na wɔnhohoro so anaa wɔnkyekyeree","poem":1},{"text":"anaa wɔmfaa ngo nsrasraa so ɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mo man ada mpan,","poem":1},{"text":"wɔde ogya ahyehyew mo nkuropɔn;","poem":2},{"text":"ananafo regye mo mfuw","poem":1},{"text":"a mo ani tua,","poem":2},{"lineBreak":true},{"text":"na asɛe sɛnea ɛyɛɛ bere a ahɔho tuu mo gui no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔagyaw Ɔbabea Sion","poem":1},{"text":"te sɛ bobeturo mu sese","poem":2},{"text":"te sɛ akuraa a esi ɛfere afuw mu,","poem":1},{"text":"te sɛ kuropɔn a atamfo atwa ho ahyia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛ Asafo Awurade","poem":1},{"text":"annyaw yɛn asefo a,","poem":2},{"text":"anka yɛayɛ sɛ Sodom,","poem":1},{"text":"na yɛadan ayɛ sɛ Gomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muntie Awurade asɛm,","poem":1},{"text":"mo Sodom sodifo;","poem":2},{"text":"muntie yɛn Nyankopɔn mmara,","poem":1},{"text":"mo Gomorafo!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Mo afɔrebɔ ahorow bebree no,","poem":1},{"text":"dɛn na ɛyɛ ma me?”","poem":2},{"lineBreak":true},{"text":"Sɛnea Awurade se ni.","poem":2},{"text":"“Mewɔ ɔhyew afɔrebɔde ma ɛboro so,","poem":1},{"text":"nea ɛyɛ adwennini ne mmoa a wɔadɔ srade;","poem":2},{"text":"mʼani nnye","poem":1},{"text":"anantwinini, nguantenmma ne mpapo mogya ho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ moba mʼanim a","poem":1},{"text":"hena na obisa eyi fi mo hɔ,","poem":2},{"lineBreak":true},{"text":"sɛ mutiatia me fi yi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Munnyae afɔrebɔde a ɛmfra a mode ba no!","poem":1},{"text":"Mo aduhuam yɛ me tan.","poem":2},{"text":"Ɔsram foforo, homenna ne nhyiamu ahorow,","poem":1},{"text":"mo nhyiamu hunu no afono me.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mo ɔsram foforo afahyɛ ne mo aponto a moahyehyɛ,","poem":1},{"text":"me kra kyi.","poem":2},{"text":"Ayɛ adesoa ama me;","poem":1},{"text":"masoa abrɛ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sɛ momema mo nsa so bɔ mpae a,","poem":1},{"text":"meyi mʼani ato nkyɛn.","poem":2},{"text":"Sɛ mobɔ mpae bebree mpo a","poem":1},{"text":"merentie.","poem":2},{"lineBreak":true},{"text":"“Mogya bebree agu mo nsa ho fi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Munnwira mo ho na mo ho ntew.","poem":1},{"text":"Munnyi mo nnebɔne mfi mʼani so!","poem":2},{"lineBreak":true},{"text":"Munnyae bɔneyɛ,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Monyɛ papa! Monhwehwɛ atɛntrenee.","poem":1},{"text":"Monhyɛ wɔn a wɔhyɛ wɔn so nkuran","poem":2},{"text":"Munni mma ayisaa,","poem":1},{"text":"monka akunafo nsɛm mma wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Afei mommra na yennwen mmɔ mu,”","poem":1},{"text":"sɛnea Awurade se ni.","poem":2},{"text":"“Sɛ mo bɔne te sɛ ɔkɔben a,","poem":1},{"text":"ɛbɛyɛ fitaa sɛ sukyerɛmma;","poem":2},{"text":"mpo sɛ ɛyɛ kɔkɔɔ te sɛ mogya a","poem":1},{"text":"ɛbɛyɛ fitaa sɛ asaawa mfuturu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sɛ mopene so na moyɛ osetie a,","poem":1},{"text":"mubedi asase no so nnepa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na sɛ moampene na motew atua a,","poem":1},{"text":"afoa bedi mo nam.”","poem":2},{"lineBreak":true},{"text":"Awurade na wakasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hwɛ sɛnea kuropɔn nokwafo no","poem":1},{"text":"adan oguamanfo.","poem":2},{"text":"Bere bi, na atɛntrenee ahyɛ no ma","poem":1},{"text":"na anka trenee te ne mu,","poem":2},{"lineBreak":true},{"text":"nanso mprempren, awudifo ahyɛ mu ma!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wo dwetɛ adan ade a so nni mfaso,","poem":1},{"text":"wɔde nsu afra wo nsa papa mu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wo sodifo yɛ atuatewfo,","poem":1},{"text":"akorɔmfo yɔnkonom;","poem":2},{"text":"wɔn nyinaa pɛ adanmude,","poem":1},{"text":"na wɔpere akyɛde ho.","poem":2},{"text":"Wonni mma ayisaa;","poem":1},{"text":"na akunafo nsɛm nkɔ wɔn anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Enti, Awurade, Asafo Awurade,","poem":1},{"text":"nea ɔyɛ Ɔkɛse ma Israel no ka se,","poem":2},{"text":"“Aa, menya ahomegye afi mʼatamfo hɔ","poem":1},{"text":"na matɔ wɔn so were.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mɛma me nsa so, atia mo;","poem":1},{"text":"mɛhohoro mo ho fi korakora","poem":2},{"lineBreak":true},{"text":"na mayi mo ho nkekae nyinaa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mɛma mo atemmufo bio sɛ kan no,","poem":1},{"text":"ne mo afotufo sɛnea na ɛte, mfiase no.","poem":2},{"text":"Eyi akyi no, wɔbɛfrɛ wo","poem":1},{"text":"Kuropɔn Trenee,","poem":2},{"lineBreak":true},{"text":"Kuropɔn Nokwafo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Wɔde atɛntrenee begye Sion bio,","poem":1},{"text":"na wɔn a wonu wɔn ho no, wɔde trenee begye wɔn.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nanso atuatewfo ne nnebɔneyɛfo de, wɔbɛdwerɛw wɔn abɔ mu,","poem":1},{"text":"na wɔn a wɔpa Awurade akyi bɛyera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mo ani bewu, esiane odum anyame a","poem":1},{"text":"munyaa wɔn mu anigye no;","poem":2},{"text":"wobegu mo anim ase, esiane nturo","poem":1},{"text":"a mosom abosom wɔ mu no nti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mobɛyɛ sɛ odum a ne nhaban apo,","poem":1},{"text":"ne turo a ennya nsu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ɔhoɔdenfo bɛyɛ sɛ ade a ɛhyew ntɛm","poem":1},{"text":"nʼadwuma bɛyɛ sɛ ogya a aturuw;","poem":2},{"text":"abien no bɛhyew abɔ mu,","poem":1},{"text":"a obiara rentumi nnum.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}