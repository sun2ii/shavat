{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Ayeyi Nnwom"]},{"type":"verse","number":1,"content":["Saa da no, wobɛka se:",{"text":"“Mɛkamfo wo, Awurade!","poem":1},{"lineBreak":true},{"text":"Ɛwɔ mu wo bo fuw me de,","poem":1},{"lineBreak":true},{"text":"nanso afei wʼabufuw ano adwo.","poem":1},{"text":"Na woakyekye me werɛ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokware, Onyankopɔn ne mʼagyenkwa;","poem":1},{"text":"mede me ho bɛto no so, na merensuro.","poem":2},{"text":"Awurade, Awurade ne mʼahoɔden ne me dwom;","poem":1},{"text":"na wabɛyɛ me nkwagye.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wode anigye bɛsaw nsu","poem":1},{"text":"afi nkwagye mmura mu.","poem":2}]},{"type":"verse","number":4,"content":["Saa da no wobɛka se,",{"text":"“Da Awurade ase, bɔ ne din","poem":1},{"text":"ma amanaman nhu nea wayɛ,","poem":2},{"text":"na pae mu ka se wɔama ne din so.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To dwom ma Awurade, efisɛ, wayɛ nea ɛwɔ anuonyam bebree.","poem":1},{"lineBreak":true},{"text":"Da eyi adi kyerɛ wiase nyinaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Momma mo nne so nto dwom anigye so","poem":1},{"text":"mo a mowɔ Sion,","poem":2},{"text":"efisɛ Israel Kronkronni a ɔte mo mu no yɛ ɔkɛse.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}