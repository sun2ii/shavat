{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Nkɔmhyɛ A Etia Moab"]},{"type":"verse","number":1,"content":["Adehu a ɛfa Moab ho:",{"text":"Wɔasɛe Ar a ɛwɔ Moab","poem":1},{"text":"Da koro anadwo bi,","poem":2},{"text":"wɔasɛe Kir a ɛwɔ Moab","poem":1},{"text":"da koro anadwo bi!","poem":2},{"noteId":2}]},{"type":"verse","number":2,"content":[{"text":"Dibon foro kɔ nʼasɔredan mu,","poem":1},{"text":"ɔkɔ ne sorɔnsorɔmmea kosu;","poem":2},{"lineBreak":true},{"text":"Moab twa adwo wɔ Nebo ne Medeba ho.","poem":2},{"text":"Wɔayi eti biara so nwi","poem":1},{"text":"na abogyesɛ biara nso wɔatwitwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wofurafura atweaatam wɔ mmɔnten so;","poem":1},{"text":"wɔ adan atifi ne ɔman ahyiae","poem":2},{"text":"wɔn nyinaa retwa adwo,","poem":1},{"text":"wɔdeda fam na wosu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hesbon ne Eleale teɛ mu su,","poem":1},{"text":"wɔte wɔn nne kodu Yahas nohɔ.","poem":2},{"text":"Enti Moab mmarima akofo teɛ mu su,","poem":1},{"text":"na wɔbotobotow.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Midi Moab ho awerɛhow wɔ me koma mu;","poem":1},{"text":"nʼaguanfo guan kodu Soar,","poem":2},{"lineBreak":true},{"text":"ne Eglat Selisiya.","poem":2},{"text":"Wɔforo kɔ Luhit,","poem":1},{"text":"wɔrekɔ nyinaa na wɔresu;","poem":2},{"text":"Horonaim kwan so nso","poem":1},{"text":"wodi wɔn sɛe ho awerɛhow.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimrim nsuwansuwa ayoyow","poem":1},{"text":"na sare no ahyew","poem":2},{"text":"afifide nyinaa ayera","poem":1},{"text":"na ɛnkaa wura biara a ɛyɛ amono.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti ahonyade a wɔapɛ agu hɔ no","poem":1},{"text":"wɔsoa de kotwa mpampuro bon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔn nkekawmu gyigye wɔ Moab ahye so;","poem":1},{"text":"wɔn agyaadwotwa kodu Eglaim","poem":2},{"lineBreak":true},{"text":"na wɔn abubuwbɔ kodu Beer Elim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dimon nsu ayɛ mogya nko ara","poem":1},{"text":"nanso mɛkɔ so ne no adi","poem":2},{"text":"gyata bɛba Moab aguanfo so","poem":1},{"text":"ne wɔn a wɔbɛka asase no so no so.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"15.1 Ar ne Kir yɛ Moabfo nkurow atitiriw abien.","reference":{"chapter":15,"verse":1}}]},"thisChapterLink":"/api/twi_aka/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}