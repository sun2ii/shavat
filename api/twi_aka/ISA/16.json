{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Momfa nguantenmma sɛ sonkahiri","poem":1},{"text":"nkɔma asase no sodifo,","poem":2},{"text":"efi Sela fa nweatam no so,","poem":1},{"text":"kɔka Ɔbabea Sion bepɔw no so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Te sɛ nnomaa a wɔaka wɔn afi berebuw mu","poem":1},{"text":"na wotu nenam wim no","poem":2},{"text":"saa na Moabfo mmea te","poem":1},{"text":"wɔ Arnon asutwabea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Moab ka se, “Munsi mo adwene pi,","poem":1},{"text":"monna mo gyinaesi adi.","poem":2},{"text":"Monyɛ mo sunsuma sɛ anadwo,","poem":1},{"text":"awia ketee.","poem":2},{"text":"Momfa aguanfo no nhintaw","poem":1},{"text":"munnyi atubrafo no mma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Momma Moabfo aguanfo no ne mo ntena;","poem":1},{"text":"monyɛ wɔn bammɔ wɔ ɔsɛefo no ho.”","poem":2},{"lineBreak":true},{"text":"Ɔhyɛsoni no bɛba nʼawie","poem":1},{"text":"na adesɛe to betwa;","poem":2},{"lineBreak":true},{"text":"opoobɔfo no bɛyera wɔ asase no so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɔdɔ mu na Onyankopɔn besi ahengua bi;","poem":1},{"text":"ɔbarima bi de nokwaredi bɛtena so,","poem":2},{"lineBreak":true},{"text":"obi a ofi Dawid fi,","poem":2},{"text":"nea atemmu mu no ɔpɛ atɛntrenee","poem":1},{"text":"na ɔntwentwɛn adetreneeyɛ ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yɛate Moab ahantan a ɔyɛ,","poem":1},{"text":"nʼani a atra ne ntɔn mmoroso,","poem":2},{"text":"nʼahomaso ne nʼasoɔden","poem":1},{"text":"nanso hwee nni nʼahomaso no mu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti Moabfo twa adwo,","poem":1},{"text":"wɔbɔ mu su ma Moab.","poem":2},{"text":"Wodi awerɛhow na wɔbɔ abubuw,","poem":1},{"text":"ma Kir Hereset bobe aba ɔfam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hesbon mfuw no hyew,","poem":1},{"text":"Sibma bobe mfuw nso saa ara.","poem":2},{"text":"Aman sodifo no atiatia bobe papa no so,","poem":1},{"text":"nea kan na wɔde kɔ Yaser","poem":2},{"text":"na ɛtrɛtrɛw kɔ nweatam so no.","poem":1},{"text":"Wɔn mman trɛtrɛw kɔka mpoano pɛɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti misu sɛnea Yaser su,","poem":1},{"text":"de ma Sibma bobe mfuw.","poem":2},{"text":"Hesbon ne Eleale,","poem":1},{"text":"mede misu fɔw mo!","poem":2},{"text":"Mo aduaba a abere ho ahurusi","poem":1},{"text":"ne otwabere de no aka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ahosɛpɛw ne anigye nni mfikyifuw no mu;","poem":1},{"text":"obiara nto dwom, na ɔnteɛteɛ mu wɔ bobeturo mu;","poem":2},{"text":"obiara nkyi nsa wɔ nsakyiamoa so,","poem":1},{"text":"efisɛ mede nteɛteɛmu aba nʼawiei.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Misi apini wɔ me koma mu wɔ Moab ho","poem":1},{"text":"te sɛ sankuten so kwadwom;","poem":2},{"lineBreak":true},{"text":"na me yam hyehye me ma Kir Hereset.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ Moab kɔ ne sorɔnsorɔmmea a","poem":1},{"text":"ɔhaw ne ho kwa;","poem":2},{"text":"sɛ ɔkɔ nʼabosonnan mu kɔbɔ mpae a,","poem":1},{"text":"ɛrenkosi hwee.","poem":2}]},{"type":"verse","number":13,"content":["Eyi ne asɛm a Awurade aka dedaw afa Moab ho."]},{"type":"verse","number":14,"content":["Nanso mprempren Awurade ka se, “Mfe abiɛsa mu, sɛnea akoa a nhyehyɛe kyekyere no no bebu nna no, wobebu Moab anuonyam ne ne nkurɔfo dodow no nyinaa animtiaa, na ne nkae no bɛyɛ kakraa bi a wonni ahoɔden.”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}