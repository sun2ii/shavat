{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Awurade Bepɔw No"]},{"type":"verse","number":1,"content":["Eyi ne nea Amos babarima Yesaia hui, a ɛfa Yuda ne Yerusalem ho."]},{"type":"line_break"},{"type":"verse","number":2,"content":["Nna a edi akyi no mu no,",{"text":"Awurade asɔredan bepɔw no betim","poem":1},{"text":"sɛ mmepɔw no nyinaa ti;","poem":2},{"text":"ebegye din aboro nkoko nyinaa so","poem":1},{"text":"na aman nyinaa bɛbɔ yuu akɔ hɔ.","poem":2}]},{"type":"verse","number":3,"content":["Aman bebree bɛba abɛka se,",{"text":"“Mommra mma yɛnkɔ Awurade bepɔw no so,","poem":1},{"text":"nkɔ Yakob Nyankopɔn fi.","poem":2},{"text":"Ɔbɛkyerɛkyerɛ yɛn nʼakwan","poem":1},{"text":"sɛnea ɛbɛyɛ a yɛbɛnantew nʼatempɔn so.”","poem":2},{"text":"Mmara no befi Sion aba,","poem":1},{"text":"na Awurade asɛm afi Yerusalem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obebu amanaman ntam atɛn","poem":1},{"text":"na obesiesie nnipa bebree ntam asɛm.","poem":2},{"text":"Wɔde wɔn afoa bɛbobɔ nsɔw","poem":1},{"text":"na wɔde wɔn mpeaw ayɛ asosɔw.","poem":2},{"text":"Ɔman bi rentwe ɔman foforo so afoa,","poem":1},{"text":"na wɔrenyɛ ahoboa biara mma ɔko bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mommra. Yakob fifo,","poem":1},{"text":"momma yɛnnantew Awurade hann mu.","poem":2}]},{"type":"heading","content":["Awurade Da No"]},{"type":"verse","number":6,"content":[{"text":"Awurade, woagyaw wo nkurɔfo,","poem":1},{"text":"Yakob fifo.","poem":2},{"text":"Gyidihunu a efi apuei fam ahyɛ wɔn ma;","poem":1},{"text":"wɔhyɛ nkɔm sɛ Filistifo","poem":2},{"lineBreak":true},{"text":"na wɔne abosonsomfo fa ayɔnko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dwetɛ ne sikakɔkɔɔ ahyɛ wɔn asase no so ma;","poem":1},{"text":"wɔn ademude dɔɔso bebree.","poem":2},{"text":"Apɔnkɔ ayɛ wɔn asase no so ma;","poem":1},{"text":"na wɔn nteaseɛnam dodow nni ano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ahoni ahyɛ wɔn asase no so ma;","poem":1},{"text":"wɔkotow sɔre wɔn ankasa nsa ano adwuma,","poem":2},{"lineBreak":true},{"text":"nea wɔn nsateaa ayɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti, Awurade bɛbrɛ onipa ase","poem":1},{"text":"na wama adesamma abotow,","poem":2},{"text":"mfa wɔn ho nkyɛ wɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kɔhyɛn abotan no mu,","poem":1},{"text":"fa wo ho kosie asase no mu esiane Awurade ho hu","poem":2},{"lineBreak":true},{"text":"ne nʼanuonyam kɛseyɛ nti!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔbɛbrɛ ɔhantanni ase,","poem":1},{"text":"na wɔde nnipa ahomaso ahwe fam;","poem":2},{"text":"Awurade nko ara na wɔbɛma no so da no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asafo Awurade ahyɛ da bi","poem":1},{"text":"ama ahomasofo nyinaa","poem":2},{"text":"ne nea ɛma ne ho so nyinaa","poem":1},{"text":"(wɔbɛbrɛ wɔn ase),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lebanon","poem":1},{"noteId":0},{"text":"sida nyinaa, atenten ne nea ɛkorɔn,","poem":1},{"text":"ne Basan odum nnua no,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mmepɔw atenten nyinaa","poem":1},{"text":"ne nkoko a ɛwowaree nyinaa,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ne abantenten a ɛkorɔn","poem":1},{"text":"ne ɔfasu biara a ɛyɛ den,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"aguadi hyɛn biara","poem":1},{"text":"ne hyɛn kɛse fɛfɛ biara.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔbɛbrɛ ɔhantanni ase,","poem":1},{"text":"na wɔde nnipa ahomaso ahwe fam;","poem":2},{"text":"Awurade nko ara na wɔbɛma no so da no,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"na ahoni no bɛyera korakora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nnipa beguan akɔhyɛ abodan a ɛwɔ abotan mu","poem":1},{"text":"ne ntokuru a ɛdeda asase mu","poem":2},{"text":"esiane Awurade ho hu","poem":1},{"text":"ne nʼanuonyam kɛseyɛ nti,","poem":2},{"lineBreak":true},{"text":"bere a ɔbɛsɔre awosow asase.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saa da no, nnipa bɛtow","poem":1},{"text":"wɔn dwetɛ ne sikakɔkɔɔ ahoni","poem":2},{"text":"a wɔyɛɛ sɛ wɔbɛsom no","poem":1},{"text":"agu ama akisi ne mpan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wobeguan akɔhyɛ abotan mu ntokuru mu","poem":1},{"text":"ne abotan mpaapae mu","poem":2},{"text":"esiane Awurade ho hu","poem":1},{"text":"ne nʼanuonyam kɛseyɛ nti,","poem":2},{"lineBreak":true},{"text":"bere a ɔbɛsɔre awosow asase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Munnyae sɛ mode mo ho to nnipa,","poem":1},{"text":"a wɔwɔ ɔhome kɛkɛ so.","poem":2},{"lineBreak":true},{"text":"Wɔyɛ dɛn koraa?","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.13 Lebanon yɛ ɔmantam bi a na ɛda Yordan apuei fam a, ɛnam sida ne anantwi a na ɛwɔ hɔ no nti, agye din.","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/twi_aka/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}