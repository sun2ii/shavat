{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Nkɔmhyɛ A Etia Babilonia"]},{"type":"verse","number":1,"content":["Nkɔmhyɛ a ɛfa Nweatam a ɛda Po ho no ho:",{"text":"Te sɛ mfɛtɛ a ɛbɔ fa anafo fam asase so no,","poem":1},{"text":"ɔtamfo bi fi nweatam so reba,","poem":2},{"lineBreak":true},{"text":"ofi asase a ɛyɛ ahuabɔbrim so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wɔde adaeso a ɛyɛ nwonwa akyerɛ me:","poem":1},{"lineBreak":true},{"text":"Ɔfatwafo di huammɔ, ɔfomfo fa asade.","poem":1},{"lineBreak":true},{"text":"Elam tow hyɛ so! Media bɔ pampim!","poem":1},{"text":"Mede apinisi a ɔde bae no nyinaa bɛba awiei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Eyi ama ɔyaw bi abɛhyɛ me mu,","poem":1},{"text":"ɔyaw aka me, te sɛ ɔbea a awo aka no;","poem":2},{"text":"nea metee no nti mintumi nnyina me nan so,","poem":1},{"text":"nea mihu no ama me ho adwiriw me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me koma bɔ kitirikitiri,","poem":1},{"text":"ehu ma me ho popo;","poem":2},{"text":"na hann a mepɛɛ sɛ mihu no","poem":1},{"text":"abɛyɛ aninyanne ama me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wɔto pon,","poem":1},{"text":"wɔde kuntu akɛtɛ sesɛw fam,","poem":2},{"lineBreak":true},{"text":"wodidi, na wɔnom!","poem":2},{"text":"Monsɔre, mo asraafo mpanyimfo,","poem":1},{"text":"momfa ngo nsrasra mo akatabo ho!","poem":2}]},{"type":"verse","number":6,"content":["Sɛɛ na Awurade ka kyerɛ me:",{"text":"“Fa ɔwɛmfo kogyina hɔ","poem":1},{"text":"na ɔnka nea ohu nkyerɛ wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sɛ ohu nteaseɛnam","poem":1},{"text":"ne apɔnkɔ akuwakuw,","poem":2},{"text":"wɔn a wɔtete mfurum so","poem":1},{"text":"ne wɔn a wɔtete yoma so a,","poem":2},{"text":"ɔnwɛn nʼaso,","poem":1},{"text":"nwɛn no pa ara.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na ɔwɛmfo no teɛɛ mu se,","poem":1},{"text":"“Me wura, da biara migyina ɔwɛn aban no so","poem":2},{"text":"Anadwo biara, migyina hɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hwɛ, ɔbarima bi a ɔte teaseɛnam mu na ɔreba yi","poem":1},{"text":"ɔne apɔnkɔ dɔm.","poem":2},{"text":"Na ɔwɛmfo no kae se,","poem":1},{"text":"‘Babilon ahwe ase, wahwe ase!","poem":2},{"text":"Nʼanyame ne nʼahoni nyinaa","poem":1},{"text":"abubu agu fam!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ao, me nkurɔfo a, wɔadwerɛw mo wɔ awiporowbea ase","poem":1},{"text":"meka nea mate kyerɛ mo","poem":2},{"text":"nea efi Asafo Awurade,","poem":1},{"text":"nea efi Israel Nyankopɔn hɔ.","poem":2}]},{"type":"heading","content":["Nkɔmhyɛ A Etia Edom"]},{"type":"verse","number":11,"content":["Adehu a ɛfa Duma ho:",{"text":"Obi frɛ me fi Seir,","poem":1},{"text":"“Ɔwɛmfo, bere bɛn na ade bɛkyɛ?","poem":2},{"lineBreak":true},{"text":"Ɔwɛmfo, aka nnɔnhwerew ahe ansa na ade akye?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔwɛmfo no bua se,","poem":1},{"text":"“Ade rekye, nanso ade bɛsa.","poem":2},{"text":"Sɛ wubebisa bio a","poem":1},{"text":"san bra bebisa.”","poem":2}]},{"type":"heading","content":["Nkɔmhyɛ A Etia Arabia"]},{"type":"verse","number":13,"content":["Adehu a ɛfa Arabia ho:",{"text":"Mo Dedan akwantufo a","poem":1},{"text":"mosoɛ wɔ Arabia adɔtɔ ase,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Momfa nsu mmrɛ wɔn a osukɔm de wɔn;","poem":2},{"text":"mo a motete Tema,","poem":1},{"text":"mommrɛ aguanfo no aduan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Woguan fi afoa a watwe","poem":1},{"text":"tadua a wɔakuntun mu","poem":2},{"text":"ne ɔko a egyina mu ano.","poem":1}]},{"type":"verse","number":16,"content":["Sɛɛ na Awurade ka kyerɛ me, “Afe baako mu, sɛnea ɔsomfo a wayɛ nhyehyɛe bebubu nna no, Kedar kɛseyɛ to betwa."]},{"type":"verse","number":17,"content":["Na agyantowfo a wɔbɛka ne Kedar akofo bɛyɛ kakraa bi.” Nea Awurade, Israel Nyankopɔn, aka ni."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}