{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Nkɔmhyɛ A Ɛfa Tiro Ho"]},{"type":"verse","number":1,"content":["Nkɔmhyɛ a ɛfa Tiro ho:",{"text":"Tarsis ahyɛn, muntwa adwo!","poem":1},{"text":"Efisɛ wɔasɛe Tiro","poem":2},{"lineBreak":true},{"text":"na wɔannyaw no ofi anaa hyɛngyinabea.","poem":2},{"text":"Wufi Kipro asase so","poem":1},{"text":"abɛka asɛm akyerɛ wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Monyɛ komm, mo nnipa a mowɔ supɔw no so","poem":1},{"text":"ne mo Sidon aguadifo a","poem":2},{"lineBreak":true},{"text":"po so adwumayɛfo ama mo ayɛ adefo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nsu akɛse no so","poem":1},{"text":"na aduan fi Sihor nam bae;","poem":2},{"text":"Nil ho nnɔbae na ɛyɛɛ Tiro foto,","poem":1},{"text":"na ɔbɛyɛɛ amanaman aguadibea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Animguase nka wo, Sidon, ne wo, po so abandennen,","poem":1},{"text":"efisɛ po akasa se,","poem":2},{"text":"“Menkyemee da, na menwoo da;","poem":1},{"text":"mentetew mmabarima anaa mmabea da.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sɛ asɛm no du Misraim a,","poem":1},{"text":"wobedi yaw wɔ nkra a efi Tiro no ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muntwa nkɔ Tarsis;","poem":1},{"text":"muntwa adwo, mo a mowɔ supɔw no so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eyi ne mo ahosɛpɛw kuropɔn no,","poem":1},{"text":"teteete kuropɔn no,","poem":2},{"text":"nea wɔatu akɔtena","poem":1},{"text":"akyirikyiri nsase so no ana?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hena na ɔbɔɔ atirimpɔw yi de tiaa Tiro,","poem":1},{"text":"nea ɔkyekyɛ ahenkyɛw,","poem":2},{"text":"nea nʼaguadifo yɛ ahenemma,","poem":1},{"text":"na nʼadetɔnfo agye din wɔ asase so?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asafo Awurade na ɔbɔɔ ne tirimpɔw se,","poem":1},{"text":"ɔbɛbrɛ anuonyam mu ahomaso ase","poem":2},{"lineBreak":true},{"text":"na wabrɛ wɔn a wɔagye din wɔ asase yi so nyinaa ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yɛ wʼasase so adwuma te sɛnea wɔyɛ wɔ Nil ho no","poem":1},{"text":"Tarsis Babea,","poem":2},{"lineBreak":true},{"text":"efisɛ wunni hyɛngyinabea bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade ama ne nsa so wɔ po no so","poem":1},{"text":"ama ahenni ahorow a ɛwɔ hɔ no repopo.","poem":2},{"text":"Wahyɛ Kanaan ho mmara se,","poem":1},{"text":"wɔnsɛe nʼaban.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔkae se, “Wʼahurisidi no nso ha ara,","poem":1},{"text":"Sidon Babea Ɔbabun a wɔadwerɛw wo!","poem":2},{"lineBreak":true},{"text":"“Sɔre, twa kɔ Kipro;","poem":1},{"text":"hɔ mpo worennya ahotɔ.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Monhwɛ Babiloniafo asase no","poem":1},{"text":"saa nnipa a mprempren wɔnka hwee no!","poem":2},{"text":"Asiriafo ayɛ no","poem":1},{"text":"baabi a nweatam so mmoa te;","poem":2},{"text":"wosisii wɔn anotua aban bebree,","poem":1},{"text":"wodwiriw nʼaban gui","poem":2},{"lineBreak":true},{"text":"ma ɛdan nnwiriwii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Muntwa adwo, Tarsis ahyɛn;","poem":1},{"text":"wɔasɛe wʼaban!","poem":2}]},{"type":"verse","number":15,"content":["Saa bere no wɔrenkae Tiro mfe aduɔson a ɛyɛ ɔhene nkwanna. Nanso mfe aduɔson akyi no, nea ɛbɛto Tiro no bɛyɛ sɛnea ɛwɔ oguamanfo no dwom mu no:"]},{"type":"verse","number":16,"content":[{"text":"“Ma sankuten no so, pase fa kuropɔn no mu,","poem":1},{"text":"oguamanfo a wɔnnkae wo;","poem":2},{"text":"bɔ sankuten no yiye, to nnwom bebree,","poem":1},{"text":"sɛnea wɔbɛkae wo.”","poem":2}]},{"type":"verse","number":17,"content":["Mfe aduɔson akyi, Awurade ne Tiro bedi. Ɔbɛsan akodi ne paa sɛ oguamanfo na ɔne ahenni a ɛwɔ asase so nyinaa adi gua."]},{"type":"verse","number":18,"content":["Nanso nea obenya ne ne mfaso nyinaa wɔde bɛto hɔ ama Awurade; wɔremmoaboa ano na wɔremfa nsie. Ne mfaso no bɛkɔ wɔn a wɔsom wɔ Awurade anim no nkyɛn, na wɔanya aduan bebree ne ntade pa."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}