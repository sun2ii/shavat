{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Ayeyi Nka Awurade"]},{"type":"verse","number":1,"content":[{"text":"Awurade, wo ne me Nyankopɔn;","poem":1},{"text":"mɛma wo so na mayi wo din ayɛ,","poem":2},{"text":"efisɛ wufi nokwaredi mu,","poem":1},{"text":"ayɛ anwonwade bebree,","poem":2},{"lineBreak":true},{"text":"nneɛma a wɔahyehyɛ fi teteete.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woayɛ kuropɔn no nnwiriwii siw,","poem":1},{"text":"kurow no a ɛwɔ bammɔ no asɛe;","poem":2},{"text":"ananafo abandennen no nyɛ kuropɔn bio;","poem":1},{"text":"na wɔrensi bio.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti aman a wɔyɛ den bedi wo ni","poem":1},{"text":"atutuwpɛfo aman bɛhyɛ wo anuonyam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Woayɛ ahiafo guankɔbea,","poem":1},{"text":"ohiani mmɔborɔni guankɔbea,","poem":2},{"text":"ahum ano ahintawee","poem":1},{"text":"ɔhyew mu nwini","poem":2},{"text":"na atirimɔdenfo home","poem":1},{"text":"te sɛ ahum a ɛrebɔ dwira ɔfasu","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ne ɔhyew a ɛwɔ nweatam so.","poem":2},{"text":"Wobrɛ ananafo huuyɛ ase;","poem":1},{"text":"sɛnea omununkum brɛ owia hyew ano ase no,","poem":2},{"lineBreak":true},{"text":"saa ara na atirimɔdenfo nnwom nso begyae.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asafo Awurade bɛto pon wɔ saa bepɔw yi so","poem":1},{"lineBreak":true},{"text":"obesiesie nnuan pa ne nsa a adi nna;","poem":1},{"text":"nam pa ne nsa pa ama nnipa nyinaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔ bepɔw yi so, ɔbɛsɛe","poem":1},{"text":"ntama a ɛkata nnipa nyinaa ho","poem":2},{"text":"ne nkataso a ɛkata aman nyinaa so no;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Ɔbɛmene owu afebɔɔ.","poem":2},{"text":"Asafo Awurade bɛpepa","poem":1},{"text":"ani so nusu nyinaa.","poem":2},{"text":"Obeyi ne nkurɔfo ahohora,","poem":1},{"text":"afi nsase nyinaa so.","poem":2},{"lineBreak":true},{"text":"Awurade, na waka.","poem":2}]},{"type":"verse","number":9,"content":["Saa da no, wɔbɛka se,",{"text":"“Ampa ara yɛn Nyankopɔn ni;","poem":1},{"text":"yɛde yɛn ho too no so na ogyee yɛn;","poem":2},{"text":"Awurade no ni, yegyee no dii;","poem":1},{"text":"momma yenni ahurusi na yɛn ani nnye wɔ ne nkwagye no mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade nsa bɛda saa bepɔw yi so;","poem":1},{"text":"nanso obetiatia Moab so","poem":2},{"lineBreak":true},{"text":"te sɛ sare a wotiatia so de fra sumina.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔbɛtrɛtrɛw wɔn nsa mu wɔ so,","poem":1},{"text":"sɛnea asuguarefo trɛtrɛw wɔn nsa mu de guare.","poem":2},{"text":"Onyankopɔn bɛbrɛ wɔn ahomaso ase","poem":1},{"text":"a ɔrenhwɛ wɔn nsa ano dwumadi ho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Obebubu mo bammɔ afasu atenten no agu,","poem":1},{"text":"obebubu agu fam","poem":2},{"lineBreak":true},{"text":"ama ayɛ mfutuma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}