{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusalem Ne Yuda Atemmu"]},{"type":"verse","number":1,"content":[{"text":"Afei hwɛ, Awurade,","poem":1},{"text":"Asafo Awurade,","poem":2},{"text":"rebegyae nea ɔde ma","poem":1},{"text":"wɔ Yerusalem ne Yuda nyinaa:","poem":2},{"lineBreak":true},{"text":"aduan ne nsu a ɔde ma wɔn nyinaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dɔmmarima ne akofo,","poem":1},{"text":"otemmufo ne odiyifo,","poem":2},{"lineBreak":true},{"text":"nkɔmhyɛni ne ɔpanyin,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"aduonum so panyin ne nea ɔwɔ dibea,","poem":1},{"text":"ɔfotufo, odwumfo nyansafo ne nkaberekyerefo onifirifo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mede mmerantewa bɛyɛ wɔn nnwuma so mpanyimfo;","poem":1},{"text":"na mmofra adi wɔn so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nnipa bɛhyɛ wɔn ho wɔn ho so,","poem":1},{"text":"ɔbarima betia ɔbarima, ɔyɔnko betia ne yɔnko.","poem":2},{"text":"Mmabun bɛsɔre atia wɔn mpanyimfo,","poem":1},{"text":"apapahwekwa betia onuonyamfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɔbarima beso ne nuanom mu baako mu","poem":1},{"text":"wɔ nʼagya fi aka se,","poem":2},{"text":"“Wowɔ atade, bɛyɛ yɛn dikanfo;","poem":1},{"text":"wɔ kurow a adan mmubui siw yi so.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nanso da no ɔbɛteɛ mu se,","poem":1},{"text":"“Minni nea mede bɛyɛ.","poem":2},{"text":"Minni aduan anaa ntama wɔ me fi;","poem":1},{"text":"mfa me nyɛ nnipa no so kannifo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalem retɔ ntintan,","poem":1},{"text":"Yuda rehwe ase;","poem":2},{"text":"wɔn nsɛm ne nneyɛe tia Awurade.","poem":1},{"text":"Wommu nʼanuonyam a ɛwɔ wɔn mu no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛnea wɔn anim te no di adanse tia wɔn;","poem":1},{"text":"wɔda wɔn bɔne adi te sɛ Sodom;","poem":2},{"lineBreak":true},{"text":"wɔmmfa nsie.","poem":2},{"text":"Nnome nka wɔn!","poem":1},{"text":"Wɔakɔfa amanehunu aba wɔn ho so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ka kyerɛ atreneefo se ebesi wɔn yiye,","poem":1},{"text":"efisɛ wobedi wɔn nneyɛe so aba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nnome nka amumɔyɛfo!","poem":1},{"text":"Amanehunu wɔ wɔn so!","poem":2},{"text":"Wobetua wɔn nea","poem":1},{"text":"wɔn nsa ayɛ no so ka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mmabun hyɛ me nkurɔfo so,","poem":1},{"text":"mmea di wɔn so.","poem":2},{"text":"Me nkurɔfo, mo akwankyerɛfo ma moyera;","poem":1},{"text":"wɔma moman fi ɔtempɔn no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Awurade tena ase wɔ nʼasennii.","poem":1},{"text":"Ɔma ne mu so bu nkurɔfo no atɛn.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Awurade bu atɛn","poem":1},{"text":"de tia ne nkurɔfo mpanyimfo ne akannifo se,","poem":2},{"text":"“Mo na moasɛe me bobeturo;","poem":1},{"text":"apoobɔde a efi ahiafo nkyɛn wɔ mo afi mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ase ne dɛn nti na modwerɛw me nkurɔfo","poem":1},{"text":"na mode ahiafo anim twitwiw fam?”","poem":2},{"lineBreak":true},{"text":"Sɛnea Asafo Awurade se ni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Awurade kasa se,","poem":1},{"text":"“Sion mmabea yɛ ahantan;","poem":2},{"text":"wɔnantew toto wɔn kɔn,","poem":1},{"text":"wɔdeda wɔn ani akyi,","poem":2},{"text":"wotutu wɔn anammɔn ntiantia,","poem":1},{"text":"na wɔn anan ase nkaa gyigye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti Awurade bɛma tikuru abegu Sion mmea ti ho.","poem":1},{"text":"Awurade bɛma wɔn ti so apa.”","poem":2}]},{"type":"verse","number":18,"content":["Da no Awurade beyiyi wɔn afɛfɛde: nkaa, ntamabamma ne kɔnmuade,"]},{"type":"verse","number":19,"content":["asokaa, nkapo ne nkataanim,"]},{"type":"verse","number":20,"content":["Wɔn mmotiri, anan ase ntweaban, nkyekyeremu, nnuhuam ntoa ne nkabere,"]},{"type":"verse","number":21,"content":["nsɔwano mpɛtea ne hwenem nkaa,"]},{"type":"verse","number":22,"content":["ntade atenten pa, nguguso tiaa a enni nsa, ntade yuu ne sika nkotoku;"]},{"type":"verse","number":23,"content":["nhwehwɛ, sirikyi ntade, tinwi so nkaa ne mmati so nguguso."]},{"type":"verse","number":24,"content":[{"text":"Nkabɔne besi nea ɛyɛ huam anan mu;","poem":1},{"text":"ntampehama besi nkatakɔnmu anan mu;","poem":2},{"text":"ti a ɛso apa besi tinwi a wɔasiesie anan mu;","poem":1},{"text":"atweaatam besi ntama pa anan mu;","poem":2},{"lineBreak":true},{"text":"honam ani atwaatwa besi ahoɔfɛ anan mu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wo mmarima bɛtotɔ afoa ano,","poem":1},{"text":"wʼakofo wɔ ɔko mu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sion apon betwa adwo, adi awerɛhow;","poem":1},{"text":"onnibi, ɔbɛtena fam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}