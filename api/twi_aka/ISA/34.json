{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Atemmu A Etia Amanaman No"]},{"type":"verse","number":1,"content":[{"text":"Muntwiw mmɛn, mo amanaman, na muntie;","poem":1},{"text":"monyɛ aso, mo ɔmanfo!","poem":2},{"text":"Momma asase ne nea ɛwɔ so nyinaa ntie,","poem":1},{"text":"wiase ne nea efi mu ba nyinaa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade bo afuw amanaman nyinaa;","poem":1},{"text":"nʼabufuwhyew no tia wɔn asraafo nyinaa.","poem":2},{"text":"Ɔbɛsɛe wɔn pasaa,","poem":1},{"text":"ɔbɛma wɔakunkum wɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔbɛtow wɔn mu atɔfo no agu,","poem":1},{"text":"wɔn afunu no beyi hua;","poem":2},{"lineBreak":true},{"text":"wɔn mogya afɔw mmepɔw no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔsoro nsoromma nyinaa bɛyera","poem":1},{"text":"na wɔbɛbobɔw ɔsoro te sɛ nhoma mmobɔwee;","poem":2},{"text":"ɔsoro atumfo bɛhwe ase","poem":1},{"text":"sɛnea nhaban tew fi bobe so,","poem":2},{"lineBreak":true},{"text":"sɛnea mman a awo pan fi borɔdɔma dua ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mʼafoa anom nea ɛmee no no wɔ ɔsoro;","poem":1},{"text":"hwɛ, ɛresian de atemmu aba Edom so,","poem":2},{"lineBreak":true},{"text":"wɔn a masɛe wɔn koraa no.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mogya aguare Awurade afoa ho,","poem":1},{"text":"wɔde srade asra ho,","poem":2},{"text":"nguantenmma ne mmirekyi mogya,","poem":1},{"text":"adwennini asaabo mu srade.","poem":2},{"text":"Awurade wɔ afɔre bi bɔ wɔ Bosra","poem":1},{"text":"ne okum kɛse wɔ Edom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anantwi anuɔdenfo ne wɔn bɛtotɔ,","poem":1},{"text":"anantwinini nketewa ne akɛse.","poem":2},{"text":"Mogya afɔw wɔn asase no,","poem":1},{"text":"na srade ayɛ so dɔte no sɔkyee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na Awurade wɔ aweretɔ da","poem":1},{"text":"ananmuhyɛ afe, a obedi ama Sion.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Edom nsuwansuwa bɛdan agodibea,","poem":1},{"text":"ne dɔte bɛdan sufre a ɛdɛw","poem":2},{"lineBreak":true},{"text":"nʼasase bɛyɛ agoprama a ɛdɛw!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɛrennum awia anaa anadwo;","poem":1},{"text":"ne wusiw befi a ɛto rentwa da.","poem":2},{"text":"Ɛbɛda mpan fi awo ntoatoaso akosi awo ntoatoaso;","poem":1},{"text":"obiara remfa ho bio koraa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nweatam so patu ne ɔbonsamnoma","poem":1},{"text":"begye hɔ afa;","poem":2},{"text":"patu ne kwaakwaadabi bɛtena hɔ.","poem":1},{"text":"Onyankopɔn bɛtwe wɔ Edom so","poem":2},{"text":"basabasayɛ susuhama","poem":1},{"text":"ne amamfoyɛ kirebennyɛ susudua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nʼatitiriw rennya biribiara a ɛbɛma wɔafrɛ no ahenni,","poem":1},{"text":"nʼahenemma mmarima nyinaa betu ayera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nsɔe begye nʼabankɛse afa,","poem":1},{"text":"nsansono ne nsɔe befuw wɔ nʼabankɛse hɔ.","poem":2},{"text":"Hɔ bɛyɛ adompo atu,","poem":1},{"text":"ne mpatu tenabea.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nweatam so mmoa ne mpataku behyia adi afra,","poem":1},{"text":"mmirekyi anuɔdenfo besu akyerɛ wɔn ho wɔn ho;","poem":2},{"text":"hɔ na anadwommoa bɛdeda","poem":1},{"text":"na wɔde ayɛ wɔn homebea.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɛhɔ na patu bɛyɛ ne berebuw, na watow ne nkesua.","poem":1},{"text":"Obesow ne mma, na ɔde ne ntaban akata wɔn so;","poem":2},{"text":"ɛhɔ na nkorɔma bɛboaboa wɔn ho ano,","poem":1},{"text":"obiara ne nea ɔka ne ho.","poem":2}]},{"type":"verse","number":16,"content":["Hwɛ Awurade nhoma mmobɔwee no mu, na kenkan:",{"text":"Eyinom mu biara renyera,","poem":1},{"text":"obiara benya nea ɔka ne ho.","poem":2},{"text":"Efisɛ nʼanom na ɔhyɛ asɛm no fi,","poem":1},{"text":"na ne honhom bɛboaboa wɔn ano.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɔde wɔn kyɛfa ma wɔn;","poem":1},{"text":"ɔde ne nsa yɛ susudua kyekyɛ.","poem":2},{"text":"Wɔbɛfa no sɛ wɔn de afebɔɔ","poem":1},{"text":"na wofi awo ntoatoaso akosi awo ntoatoaso atena hɔ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}