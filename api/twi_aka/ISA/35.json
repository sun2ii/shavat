{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Wɔn A Wɔagye Wɔn No Ahosɛpɛw"]},{"type":"verse","number":1,"content":[{"text":"Nweatam ne asase a awo no ani begye;","poem":1},{"text":"sare bedi ahurusi na ayɛ frɔmfrɔm.","poem":2},{"text":"Te sɛ nhwiren no,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ɛbɛpae ayɛ fɛfɛɛfɛ","poem":1},{"text":"ebedi ahurusi na ɛde anigye ateɛ mu,","poem":2},{"text":"wɔde Lebanon anuonyam bɛma no","poem":1},{"text":"Karmel ne Saron ahoɔfɛ;","poem":2},{"text":"wobehu Awurade anuonyam,","poem":1},{"text":"yɛn Nyankopɔn tumi no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hyɛ nsa a emu agow no mu den,","poem":1},{"text":"hyɛ nkotodwe a ahodwow no mu den;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ka kyerɛ wɔn a wɔn koma atu no se,","poem":1},{"text":"“Monhyɛ mo ho den, na munnsuro;","poem":2},{"text":"mo Nyankopɔn bɛba,","poem":1},{"text":"ɔde aweretɔ bɛba;","poem":2},{"text":"ananmuhyɛ a efi ɔsoro","poem":1},{"text":"bɛba abegye mo nkwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɛno na wobebue anifuraefo ani,","poem":1},{"text":"na wɔama asotifo aso ate asɛm.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛno na mpakye behuruw te sɛ ɔforote,","poem":1},{"text":"na mum tɛkrɛma de anigye ateɛ mu.","poem":2},{"text":"Nsu betue wɔ sare so,","poem":1},{"text":"na nsuwansuwa apue wɔ nweatam so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nwea a so yɛ hyew no bɛdan ɔtare,","poem":1},{"text":"na nsuwansuwa atue wɔ asase wosee so.","poem":2},{"text":"Atu a anka sakraman te mu no,","poem":1},{"text":"ɛhɔ na sare ne demmire ne paparɔso befifi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na ɔtempɔn bɛda hɔ;","poem":1},{"text":"wɔbɛfrɛ no Ahotefo Kwan.","poem":2},{"text":"Wɔn a wɔn ho ntew rentu kwan wɔ so;","poem":1},{"text":"ɛbɛda hɔ ama wɔn a wɔnantew saa Kwan no so;","poem":2},{"lineBreak":true},{"text":"amumɔyɛfo nkwaseafo rennantenantew so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gyata biara rentena hɔ,","poem":1},{"text":"na akekaboa biara rensi so;","poem":2},{"lineBreak":true},{"text":"wɔrenhu wɔn wɔ hɔ.","poem":2},{"text":"Na wɔn a wɔagye wɔn nko ara na wɔbɛfa so,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"na wɔn a Awurade agye wɔn no bɛsan aba.","poem":2},{"text":"Wɔde nnwonto bɛhyɛn Sion;","poem":1},{"text":"anigye a ɛnsa da bɛyɛ wɔn ahenkyɛw.","poem":2},{"text":"Wobenya anigye ne ahosɛpɛw mmoroso,","poem":1},{"text":"na awerɛhow ne apinisi beguan akɔ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}