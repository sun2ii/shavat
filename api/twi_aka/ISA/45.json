{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“Sɛɛ na Awurade ka kyerɛ nea wasra no ngo,","poem":1},{"text":"Kores a maso ne nsa nifa mu","poem":2},{"text":"sɛ ɔmmrɛ aman ase wɔ nʼanim","poem":1},{"text":"na onnye ahemfo akode mfi wɔn nsam","poem":2},{"text":"sɛ ommuebue apon a ɛwɔ nʼanim","poem":1},{"text":"sɛnea kurow apon no mu rentoto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Medi wʼanim","poem":1},{"text":"mɛyɛ mmepɔw tamaa;","poem":2},{"text":"mebubu kɔbere mfrafrae apon agu","poem":1},{"text":"na matwitwa nnade adaban mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mede sum mu ademude bɛma wo","poem":1},{"text":"ahonyade a wɔde asie kokoa mu","poem":2},{"text":"sɛnea wubehu sɛ, mene Awurade,","poem":1},{"text":"Israel Nyankopɔn, a ɔbɔ wo din frɛ wo no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me somfo Yakob nti,","poem":1},{"text":"Israel a mapaw no nti,","poem":2},{"text":"mebɔ wo din frɛ wo","poem":1},{"text":"na mɛma wo anuonyamhyɛ abodin,","poem":2},{"lineBreak":true},{"text":"ɛwɔ mu sɛ wunnyee me ntoo mu de.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mene Awurade, obiara nni hɔ bio;","poem":1},{"text":"Onyankopɔn biara nni hɔ ka me ho.","poem":2},{"text":"Mɛhyɛ wo den,","poem":1},{"text":"ɛwɔ mu sɛ wunnyee me ntoo mu de,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"sɛnea ɛbɛyɛ a efi nea owia pue","poem":1},{"text":"kosi beae a ɛtɔ no","poem":2},{"text":"nnipa behu sɛ obiara nka me ho.","poem":1},{"text":"Mene Awurade, na obiara nni hɔ bio.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meyɛ hann, na mebɔ sum.","poem":1},{"text":"Mede yiyedi ba na mede ɔhaw ba;","poem":2},{"lineBreak":true},{"text":"Me, Awurade, na meyɛ eyinom nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mo ɔsorosoro munhwie trenee ngu fam;","poem":1},{"text":"momma emfi omununkum mu ntɔ","poem":2},{"text":"momma asase mu mmue kɛse,","poem":1},{"text":"na nkwagye mpue mfi mu,","poem":2},{"text":"na trenee ne no nnyin;","poem":1},{"text":"Me, Awurade na mayɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nnome nka nea ɔne ne Yɛfo ham","poem":1},{"text":"ɛnka nea ɔmfra te sɛ kyɛmfɛre a ɛfra nea egugu fam mu.","poem":2},{"text":"Dɔte betumi abisa ɔnwemfo se,","poem":1},{"text":"‘Dɛn na woreyɛ yi?’","poem":2},{"text":"Wʼadwuma betumi abisa wo se","poem":1},{"text":"‘Wunni nsa’?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nnome nka nea ose nʼagya se","poem":1},{"text":"‘Dɛn na woawo yi?’","poem":2},{"text":"Anaa obisa ne na se,","poem":1},{"text":"‘Dɛn na wokyem woe?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Sɛɛ na Awurade se,","poem":1},{"text":"Israel Ɔkronkronni ne ne Yɛfo;","poem":2},{"text":"Nea ɛfa nneɛma a ɛreba ho no,","poem":1},{"text":"wubisa me nsɛm a ɛfa me mma ho,","poem":2},{"lineBreak":true},{"text":"anaa wohyɛ me wɔ me nsa ano adwuma ho?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɛyɛ me na meyɛɛ asase","poem":1},{"text":"na mebɔɔ adesamma guu so.","poem":2},{"text":"Me ara me nsa na mede trɛw ɔsoro mu;","poem":1},{"text":"nsoromma ahorow nyinaa hyɛ mʼase.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɛma Kores so wɔ me trenee mu;","poem":1},{"text":"meteɛteɛ nʼakwan nyinaa.","poem":2},{"text":"Ɔbɛsan akyekyere me kuropɔn","poem":1},{"text":"na wagyaa me nnommumfo,","poem":2},{"text":"nanso ɔrennye akatua anaa akyɛde,","poem":1},{"text":"Asafo Awurade na ose.”","poem":2}]},{"type":"verse","number":14,"content":["Sɛɛ na Awurade se:",{"text":"“Nneɛma a efi Misraim ne aguade a efi Kus,","poem":1},{"text":"ne Sebafo atenten no,","poem":2},{"text":"wɔbɛba wo nkyɛn","poem":1},{"text":"abɛyɛ wo dea;","poem":2},{"text":"wobedi wʼakyi brɛoo aba a","poem":1},{"text":"wogu nkɔnsɔnkɔnsɔn mu.","poem":2},{"text":"Wobebu nkotodwe wʼanim","poem":1},{"text":"na wɔasrɛ wo aka se,","poem":2},{"text":"‘Ampa ara, Onyankopɔn ka wo ho, na obi nni hɔ;","poem":1},{"text":"onyame biara nni hɔ.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ampa ara, woyɛ Onyankopɔn a ɔde ne ho sie,","poem":1},{"text":"Ao Onyankopɔn ne Israel Agyenkwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔn a wɔyɛ ahoni nyinaa bɛfɛre na wɔn anim agu ase;","poem":1},{"text":"wɔbɛbɔ mu akɔ animguase mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nanso Awurade begye Israel nkwa,","poem":1},{"text":"ɔde daapem nkwagye;","poem":2},{"text":"wɔremma wʼani nwu na wʼanim rengu ase bio","poem":1},{"text":"kosi daapem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Na sɛɛ na Awurade se,","poem":1},{"text":"nea ɔbɔɔ ɔsorosoro no","poem":2},{"text":"ɔno ne Onyankopɔn;","poem":1},{"text":"nea ɔmaa asase, ne tebea na ɔbɔe no,","poem":2},{"text":"ɔno na ɔtoo ne fapem;","poem":1},{"text":"wammɔ no sɛ so nna hɔ kwa,","poem":2},{"text":"mmom, ɔyɛe se nnipa ntena so,","poem":1},{"text":"ɔka se:","poem":2},{"text":"“Mene Awurade,","poem":1},{"text":"na obi nni hɔ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Menkasaa wɔ kokoa mu,","poem":1},{"text":"mfi asase so baabi a aduru sum;","poem":2},{"text":"menka nkyerɛɛ Yakob asefo se,","poem":1},{"text":"‘Monhwehwɛ me na munhu me.’","poem":2},{"text":"Me Awurade, meka nokware no;","poem":1},{"text":"meka nea eye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mommoaboa mo ho ano na mommra;","poem":1},{"text":"munhyia mu, mo aguanfo a mufi amanaman so.","poem":2},{"text":"Wɔn a wonnim de na wɔsoa nnua ahoni de kyinkyin","poem":1},{"text":"wɔn a wɔbɔ anyame a wontumi nnye nkwa no mpae.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mompae mu nka nea ebesi, momfa nto gua,","poem":1},{"text":"ma wɔmmɔ mu ntu agyina.","poem":2},{"text":"Hena na odii kan kaa no teteete,","poem":1},{"text":"hena na ɔdaa no adi fi tete nteredee?","poem":2},{"text":"Ɛnyɛ me Awurade ana?","poem":1},{"text":"Onyankopɔn bi nni hɔ ka me ho,","poem":2},{"text":"trenee Nyankopɔn ne Agyenkwa;","poem":1},{"text":"obiara nni hɔ sɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Monnan mmra me nkyɛn na munnya nkwa,","poem":1},{"text":"mo a mowɔ asase ano nyinaa;","poem":2},{"text":"efisɛ mene Onyankopɔn, na obiara nni hɔ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Maka me ho ntam,","poem":1},{"text":"mʼano aka wɔ nokwaredi nyinaa mu","poem":2},{"lineBreak":true},{"text":"asɛm a wɔntwe nsan sɛ:","poem":2},{"text":"obiara bebu nkotodwe wɔ mʼanim.","poem":1},{"text":"Na obiara bɛpae mu aka se, mene Onyankopɔn.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wɔbɛka me ho asɛm se, ‘Awurade nko ara mu","poem":1},{"text":"na trenee ne ahoɔden wɔ.’ ”","poem":2},{"text":"Wɔn a wɔn bo huru tia no nyinaa","poem":1},{"text":"bɛba ne nkyɛn na wɔn anim begu ase.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nanso Awurade mu, Israel asefo nyinaa","poem":1},{"text":"wobebu wɔn bem, na wɔahoahoa wɔn ho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}