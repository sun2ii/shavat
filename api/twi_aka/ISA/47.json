{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Babilonia Asehwe"]},{"type":"verse","number":1,"content":[{"text":"“Sian kɔ, tena mfutuma mu,","poem":1},{"text":"Ɔbabea Babilonia;","poem":2},{"text":"tena fam na mfa ahengua,","poem":1},{"text":"Babiloniafo hemmea kuropɔn.","poem":2},{"text":"Wɔremfrɛ wo bio se,","poem":1},{"text":"nsiforo anaa nea ne ho yɛ na.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fa awiyammo na yam esiam;","poem":1},{"text":"yi wo nkataanim no.","poem":2},{"text":"Ma wʼatade so kɔ soro, na wo nan ho ngu hɔ,","poem":1},{"text":"na fa nsuwansuwa no mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wʼadagyaw bɛda adi","poem":1},{"text":"na wʼanimguase so renkata.","poem":2},{"text":"Mɛtɔ were;","poem":1},{"text":"meremfa obiara ho nkyɛ no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yɛn Gyefo, Asafo Awurade ne ne din,","poem":1},{"text":"ɔno ne Israel Kronkronni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tena ase dinn, kɔhyɛ sum mu,","poem":1},{"text":"Babiloniafo hemmea kurow;","poem":2},{"text":"wɔremfrɛ wo bio se","poem":1},{"text":"ahenni ahorow so hemmea.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Me bo fuw me nkurɔfo,","poem":1},{"text":"na miguu mʼagyapade ho fi;","poem":2},{"text":"mede wɔn hyɛɛ wo nsa,","poem":1},{"text":"na woanhu wɔn mmɔbɔ.","poem":2},{"text":"Nkwakoraa koraa mpo,","poem":1},{"text":"wosoaa wɔn konnua duruduru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wokae se, ‘Mɛkɔ so daa,","poem":1},{"text":"ayɛ ɔhemmea afebɔɔ.’","poem":2},{"text":"Nanso woannwen saa nneɛma yi ho","poem":1},{"text":"na woansusuw nea ebetumi asi ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Afei tie, wo oguamanfo,","poem":1},{"text":"woredwudwo wo ho wɔ wo bammɔ mu","poem":2},{"text":"na woka kyerɛ wo ho se,","poem":1},{"text":"‘me ne no, na obiara nni hɔ sɛ me.","poem":2},{"text":"Merenyɛ okunafo da","poem":1},{"text":"na merenni awommawu.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saa nneɛma abien yi bɛto wo","poem":1},{"text":"prɛko pɛ, da koro pɛ:","poem":2},{"text":"awommawu ne kunayɛ.","poem":1},{"text":"Saa nneɛma yi bɛba wo so pa ara,","poem":2},{"text":"wʼabayisɛm bebrebe yi","poem":1},{"text":"ne ntafowayi a mu yɛ den nyinaa akyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wode wo ho ato wʼamumɔyɛ so","poem":1},{"text":"na waka se, ‘Obiara nhu me.’","poem":2},{"text":"Wo nyansa ne nimdeɛ ma wo fom kwan","poem":1},{"text":"bere a woka kyerɛ wo ho se,","poem":2},{"lineBreak":true},{"text":"‘Me ne no, obiara nni hɔ ka me ho.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amanehunu bɛto wo,","poem":1},{"text":"na worenhu ɔkwan ko a wobɛfa so ayi afi hɔ.","poem":2},{"text":"Ɔhaw bi bɛba wo so","poem":1},{"text":"a worentumi mfa mpata nyi mfi hɔ;","poem":2},{"text":"atoyerɛnkyɛm a ɛnnaa ne ho adi nkyerɛɛ wo","poem":1},{"text":"bɛba wo so mpofirim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kɔ so yɛ wo ntafowayi","poem":1},{"text":"ne wʼabayisɛm bebrebe","poem":2},{"lineBreak":true},{"text":"a wode adi dwuma fi wo mmofraase no.","poem":2},{"text":"Ebia wubedi nkonim,","poem":1},{"text":"ebia wode ehu bɛba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Woabrɛ wɔ afotufo bebrebe a woanya no mu!","poem":1},{"text":"Ma wo nsoromma ho anyansafo mmra anim,","poem":2},{"text":"wɔn a wɔhwɛ nsoromma mu no, ka nea ɛreba ɔsram biara mu no,","poem":1},{"text":"ma wonnye wo mfi nea ɛreba wo so no mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokwarem, wɔte sɛ gyentia;","poem":1},{"text":"ogya bɛhyew wɔn.","poem":2},{"text":"Na wontumi nnye wɔn ankasa ho","poem":1},{"text":"mfi ogyaframa anoden no ho.","poem":2},{"text":"Nnyansramma biara nni ha a ɛbɛka obiara hyew;","poem":1},{"text":"ogya biara nni ha a wɔbɛtena ho ato.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nea wobetumi ayɛ ama wo ara ne no,","poem":1},{"text":"eyinom na wo ne wɔn abrɛ","poem":2},{"lineBreak":true},{"text":"na wo ne wɔn anantew fi mmofraase.","poem":2},{"text":"Wɔn mu biara kɔ so yɛ ne mfomso;","poem":1},{"text":"ɔbaako mpo nni hɔ a obetumi agye wo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}