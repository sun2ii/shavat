{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Afoforo Nkwagye"]},{"type":"verse","number":1,"content":["Sɛɛ na Awurade se:",{"text":"“Monkɔ so mmu atɛntrenee","poem":1},{"text":"na monyɛ nea eye,","poem":2},{"text":"efisɛ me nkwagye abɛn","poem":1},{"text":"na ɛrenkyɛ me trenee bɛda adi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nhyira nka onipa a ɔyɛ eyi,","poem":1},{"text":"onipa a okura mu dennen,","poem":2},{"text":"nea ɔkae Homeda na ɔyɛ no kronkron,","poem":1},{"text":"na ɔkame ne ho fi bɔneyɛ ho.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mma ɔnanani a ɔde ne ho ama Awurade nka se,","poem":1},{"text":"“Ampa ara Awurade renkan me mfra ne nkurɔfo mu.”","poem":2},{"text":"Na piamni biara nso nwiinwii sɛ,","poem":1},{"text":"“Meyɛ duwui.”","poem":2}]},{"type":"verse","number":4,"content":["Sɛɛ na Awurade se,",{"text":"“Piamfo a wɔkae me homenna,","poem":2},{"text":"wɔn a wɔyɛ nea ɛsɔ mʼani","poem":1},{"text":"na wokura mʼapam mu dennen,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mɛma wɔn, wɔ mʼasɔredan ne ho afasu no","poem":1},{"text":"nkae ade ne din a,","poem":2},{"lineBreak":true},{"text":"ɛkyɛn mmabarima ne mmabea;","poem":2},{"text":"mɛma wɔn din a ɛbɛtena hɔ afebɔɔ","poem":1},{"text":"din a ɛrentwa mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na ananafo a wɔde wɔn ho bata Awurade ho","poem":1},{"text":"sɛ wɔbɛsom no,","poem":2},{"text":"sɛ wɔbɛdɔ Awurade din,","poem":1},{"text":"na wɔasɔre no,","poem":2},{"text":"wɔn a wɔkae Homeda na wɔyɛ no kronkron nyinaa","poem":1},{"text":"na wokura mʼapam mu dennen,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"eyinom na mede wɔn bɛba me bepɔw kronkron no so","poem":1},{"text":"na mama wɔn anigye wɔ me mpaebɔfi.","poem":2},{"text":"Wɔn ɔhyew afɔrebɔde ne afɔrebɔ ahorow no","poem":1},{"text":"megye wɔ mʼafɔremuka so;","poem":2},{"text":"na wɔbɛfrɛ me fi","poem":1},{"text":"aman nyinaa mpaebɔfi.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Otumfo Awurade,","poem":1},{"text":"nea ɔboaboa Israelfo a wɔatwa wɔn asu ano no ka se:","poem":2},{"text":"“Mɛkɔ so aboaboa afoforo ano aka wɔn ho","poem":1},{"text":"aka wɔn a maboa wɔn ano dedaw no ho.”","poem":2}]},{"type":"heading","content":["Onyankopɔn Sobo A Etia Amumɔyɛfo"]},{"type":"verse","number":9,"content":[{"text":"Mommra, mo wuram mmoadoma nyinaa,","poem":1},{"text":"mummedidi, mo kwae mu mmoa nyinaa!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Israel awɛmfo yɛ anifuraefo,","poem":1},{"text":"wɔn mu biara nni nimdeɛ;","poem":2},{"text":"wɔn nyinaa yɛ akraman mum,","poem":1},{"text":"wontumi mmobɔ mu;","poem":2},{"text":"wɔdeda hɔ na wɔsoso dae,","poem":1},{"text":"nna yɛ wɔn dɛ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔyɛ akraman a wɔpɛ aduan yiye;","poem":1},{"text":"wonnidi mmee da.","poem":2},{"text":"Wɔyɛ nguanhwɛfo a wonni ntease;","poem":1},{"text":"wɔn nyinaa fa wɔn kwan,","poem":2},{"lineBreak":true},{"text":"obiara pɛ nʼankasa mfaso.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Mommra,” obiara teɛ mu se, “momma me nsa!","poem":1},{"text":"Momma yɛnnom bobesa mmow!","poem":2},{"text":"Na ɔkyena bɛyɛ sɛ nnɛ,","poem":1},{"text":"ebia ɛbɛsen nnɛ koraa.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}