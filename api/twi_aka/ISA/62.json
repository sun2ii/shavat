{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Sion Din Foforo"]},{"type":"verse","number":1,"content":[{"text":"Sion nti, merenyɛ komm,","poem":1},{"text":"Yerusalem nti, merenyɛ dinn,","poem":2},{"text":"kosi sɛ ne trenee bɛhyerɛn sɛ adekyee,","poem":1},{"text":"na ne nkwagye adɛw sɛ ogyatɛn.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amanaman no behu wo trenee,","poem":1},{"text":"na ahemfo nyinaa ahu wʼanuonyam;","poem":2},{"text":"wɔbɛfrɛ wo din foforo","poem":1},{"text":"a Awurade de bɛto wo no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wobɛyɛ anuonyam ahenkyɛw wɔ Awurade nsam,","poem":1},{"text":"ne adehye anuonyam abotiri wɔ wo Nyankopɔn nsam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔremfrɛ wo amamfo bio,","poem":1},{"text":"anaa wʼasase sɛ amamfo.","poem":2},{"text":"Na mmom wɔbɛfrɛ wo Hefsiba anaa anisɔ Kuropɔn","poem":1},{"text":"ne wʼasase sɛ Beula anaa ɔwarefo","poem":2},{"text":"efisɛ Awurade ani begye wo ho,","poem":1},{"text":"na ɔbɛware wʼasase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sɛnea aberante ware ababaa no,","poem":1},{"text":"saa ara na wo mmabarima bɛware wo;","poem":2},{"text":"sɛ ayeforokunu ani gye nʼayeforo ho no,","poem":1},{"text":"saa ara na wo Nyankopɔn ani begye wo ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mede awɛmfo agyinagyina wʼafasu so, Yerusalem;","poem":1},{"text":"wɔremmua wɔn ano awia anaa anadwo.","poem":2},{"text":"Mo a musu frɛ Awurade no,","poem":1},{"text":"monnhome koraa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"na mommma onnye nʼahome kosi sɛ, ɔbɛma Yerusalem atim","poem":1},{"text":"na wayɛ no nea asase nyinaa bɛkamfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade de ne basa nifa aka ntam","poem":1},{"text":"ne basa a ɛyɛ den no se,","poem":2},{"text":"“Meremfa mo awi","poem":1},{"text":"mma mo atamfo sɛ wɔn aduan bio,","poem":2},{"text":"na ananafo rennom nsa foforo","poem":1},{"text":"a moabrɛ ho no bio;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wɔn a wotwa no na wobedi","poem":1},{"text":"na wɔakamfo Awurade,","poem":2},{"text":"na wɔn a wɔboaboa bobe ano no bɛnom","poem":1},{"text":"wɔ me kronkronbea adiwo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Momfa mu, momfa kuropɔn apon no mu!","poem":1},{"text":"Munsiesie ɔkwan no mma nkurɔfo no.","poem":2},{"text":"Mompae, mompae ɔtempɔn no!","poem":1},{"text":"Munyiyi so abo no.","poem":2},{"text":"Munsi frankaa mma amanaman no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awurade abɔ no dawuru","poem":1},{"text":"akosi nsase ano se,","poem":2},{"text":"“Monka nkyerɛ Ɔbabea Sion se,","poem":1},{"text":"‘Hwɛ, wo Agyenkwa reba!","poem":2},{"text":"Hwɛ nʼakatua ka ne ho,","poem":1},{"text":"na nʼanamuhyɛde nso ka ne ho.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔbɛfrɛ wɔn Nnipa Kronkron,","poem":1},{"text":"wɔn a Awurade Agye Wɔn;","poem":2},{"text":"na wɔbɛfrɛ wo Nea Wɔrehwehwɛ Nʼakyi Kwan,","poem":1},{"text":"Kuropɔn a Ɛrenyɛ Amamfo Bio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}