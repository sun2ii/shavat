{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_aka","name":"Yesaia","commonName":"Yesaia","title":"Odiyifo Yesaia Nhoma","order":23,"numberOfChapters":66,"sha256":"e52cc14b86ba4dcff7580e88232c6de0cc8e76915299b38550c516a9f87aada2","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_aka/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Wɔawo Akokoaa Ama Yɛn"]},{"type":"verse","number":1,"content":["Nanso wɔn a na wɔwɔ ahohiahia mu no renni awerɛhow bio. Kan no ɔbrɛɛ Sebulon ne Naftali nsase no ase, nanso daakye bi ɔbɛhyɛ Galilea a ɛyɛ amanamanmufo man na ne kwan da Yordan ne po ntam no anuonyam."]},{"type":"verse","number":2,"content":[{"text":"Nnipa a wɔnam sum mu","poem":1},{"text":"ahu Hann kɛse;","poem":2},{"text":"wɔn a wɔte asase a so sum kabii no,","poem":1},{"text":"hann bi apue wɔn so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woatrɛw ɔman no mu","poem":1},{"text":"woama wɔn ani agye mmoroso","poem":2},{"text":"wodi ahurusi wɔ wʼanim","poem":1},{"text":"sɛnea nnipa di ahurusi otwabere,","poem":2},{"text":"sɛnea nnipa ho sɛpɛw wɔn","poem":1},{"text":"wɔ bere a wɔrekyɛ asade no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Te sɛ da a Midian dii nkogu no,","poem":1},{"text":"woadwerɛw konnua a ɛda wɔn so no,","poem":2},{"text":"abaa a ɛda wɔn mmati,","poem":1},{"text":"wɔn nhyɛsofo pema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɔkofo mpaboa a wɔhyɛ de kɔ sa","poem":1},{"text":"ne atade biara a mogya akeka mu,","poem":2},{"text":"wobegyaw agu hɔ na wɔahyew;","poem":1},{"text":"ɛbɛyɛ nea ɛma ogya dɛw.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na wɔawo akokoaa ama yɛn,","poem":1},{"text":"wɔama yɛn ɔbabarima,","poem":2},{"text":"na amammui no bɛda ne mmati so.","poem":1},{"text":"Na wɔbɛfrɛ no","poem":2},{"text":"Ɔfotufo Nwonwani, Otumfo Nyankopɔn,","poem":1},{"text":"Daa Agya, Asomdwoe Wura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nʼamammui no nkɔso ne Nʼasomdwoe","poem":1},{"text":"bɛtena hɔ daa.","poem":2},{"text":"Ɔbɛtena Dawid ahengua so","poem":1},{"text":"abu Nʼahenni,","poem":2},{"text":"Ɔde atɛntrenee ne treneeyɛ","poem":1},{"text":"befi ase na wama atim","poem":2},{"text":"afi saa bere no akosi daa apem.","poem":1},{"text":"Asafo Awurade mmɔdemmɔ","poem":2},{"lineBreak":true},{"text":"bɛyɛ eyi.","poem":2}]},{"type":"heading","content":["Awurade Abufuw A Etia Israel"]},{"type":"verse","number":8,"content":[{"text":"Awurade ama Yakob nkra a etia no,","poem":1},{"text":"na ɛbɛka Israel.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nnipa no nyinaa behu,","poem":1},{"text":"Efraim ne wɔn a wɔtete Samaria","poem":2},{"text":"a wɔde ahohoahoa","poem":1},{"text":"ne ahomaso koma kasa no,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Ntayaa no abubu agu fam","poem":1},{"text":"nanso yɛde abo a wɔatwa bɛto bio.","poem":2},{"text":"Wɔabubu borɔdɔma nnua no","poem":1},{"text":"nanso yɛde sida besi anan mu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanso Awurade ahyɛ Resin atamfo den atia wɔn,","poem":1},{"text":"na ɔhyɛ wɔn atamfo no nkuran.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aramfo a wofi apuei fam,","poem":1},{"text":"Filistifo a wofi atɔe fam,","poem":2},{"lineBreak":true},{"text":"abue wɔn anom amene Israel.","poem":2},{"lineBreak":true},{"text":"Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,","poem":1},{"text":"na ne nsa da so wɔ soro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nanso nnipa no nsan nkɔɔ nea ɔtwee wɔn aso no nkyɛn,","poem":1},{"text":"na wɔnhwehwɛɛ Asafo Awurade no akyi kwan nso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti Awurade betwa eti ne dua afi Israel ho","poem":1},{"text":"na berɛw ne demmire nso, ɔde da koro pɛ;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mpanyimfo ne akunini no ne eti no,","poem":1},{"text":"na atoro adiyifo no ne dua no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔn a wɔkyerɛ nnipa yi kwan no, nkyerɛ wɔn ɔkwan pa,","poem":1},{"text":"na wɔn a wonya akwankyerɛ no nso, fom kwan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti Awurade ani rennye mmerante no ho,","poem":1},{"text":"na ɔrenhu ayisaa ne akunafo mmɔbɔ","poem":2},{"text":"efisɛ, obiara nni nyamesu na wɔyɛ amumɔyɛfo,","poem":1},{"text":"ano biara ka ahuhusɛm.","poem":2},{"lineBreak":true},{"text":"Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,","poem":1},{"text":"na ne nsa da so wɔ soro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nokware, atirimɔden hye te sɛ ogya;","poem":1},{"text":"ɛhyew nnɛnkyɛnse ne nsɔe,","poem":2},{"text":"ɛde ogya to kwaeberentuw mu hyew no,","poem":1},{"text":"na ɛnam wusiw kumɔnn mu foro kɔ soro.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ɛnam Asafo Awurade abufuw so,","poem":1},{"text":"asase no bɛkyen","poem":2},{"text":"na nnipa bɛyɛ mmabaa ama ogya no;","poem":1},{"text":"na obiara remfa ne nua ho nkyɛ no.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nifa so, wɔbɛfom aduan adi,","poem":1},{"text":"nanso ɔkɔm bɛde wɔn;","poem":2},{"text":"benkum so wobedidi,","poem":1},{"text":"nanso wɔremmee.","poem":2},{"text":"Obiara bɛwe ne ba nam.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase bɛdan Efraim na Efraim adan Manase","poem":2},{"lineBreak":true},{"text":"na wɔbɛbɔ mu atia Yuda.","poem":2},{"lineBreak":true},{"text":"Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,","poem":1},{"text":"na ne nsa da so wɔ soro.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}