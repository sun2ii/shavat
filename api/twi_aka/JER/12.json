{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Yeremia Anwiinwii"]},{"type":"verse","number":1,"content":[{"text":"Woyɛ ɔtreneeni bere biara, Awurade,","poem":1},{"text":"sɛ mede asɛm to wʼanim a.","poem":2},{"text":"Nso me ne wo bɛkasa afa wʼatɛntrenee ho:","poem":1},{"text":"Adɛn nti na amumɔyɛfo kwan si wɔn yiye?","poem":2},{"lineBreak":true},{"text":"Adɛn nti na wɔn a wonni gyidi ho dwo wɔn?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woadua wɔn, na wɔagye ntin;","poem":1},{"text":"wonyinyin na wɔsow aba.","poem":2},{"text":"Wɔbɔ wo din bere biara","poem":1},{"text":"nanso wɔn koma mmɛn wo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanso wunim me, Awurade;","poem":1},{"text":"wuhu me, na wosɔ mʼadwene a mewɔ wɔ wo ho no hwɛ.","poem":2},{"text":"Twe wɔn kɔ sɛ nguan a wɔrekotwitwa wɔn mu!","poem":1},{"text":"Yi wɔn si nkyɛn ma okumda!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asase no nkyen nkosi da bɛn","poem":1},{"text":"na prama so sare nguan nkosi da bɛn?","poem":2},{"text":"Esiane sɛ wɔn a wɔte so no yɛ amumɔyɛfo nti","poem":1},{"text":"mmoa ne nnomaa a wɔwɔ so awuwu.","poem":2},{"text":"Na nnipa no da so ka se,","poem":1},{"text":"“Ɔrenhu nea ɛba yɛn so.”","poem":2}]},{"type":"heading","content":["Onyankopɔn Mmuae"]},{"type":"verse","number":5,"content":[{"text":"“Sɛ wo ne mmarima atu mmirika","poem":1},{"text":"ama woabrɛ a,","poem":2},{"lineBreak":true},{"text":"ɛbɛyɛ dɛn na wo ne apɔnkɔ besi mmirikakan?","poem":2},{"text":"Sɛ wuhintiw wɔ asase petee so a,","poem":1},{"text":"ɛno de, dɛn na wobɛyɛ wɔ Yordan ho nkyɛkyerɛ mu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wo nuabarimanom, wʼankasa abusuafo,","poem":1},{"text":"wɔn mpo ayi wo ama;","poem":2},{"lineBreak":true},{"text":"wɔteɛ mu dennen tia wo.","poem":2},{"text":"Mfa wo ho nto wɔn so,","poem":1},{"text":"sɛ mpo wɔka wo ho asɛm pa a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Megyaw me fi,","poem":1},{"text":"ato mʼagyapade asaworam;","poem":2},{"text":"mede nea medɔ no no","poem":1},{"text":"bɛhyɛ nʼatamfo nsa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mʼagyapade ayɛ me sɛ","poem":1},{"text":"gyata a ɔwɔ kwae mu.","poem":2},{"text":"Ɔbobɔ mu gu me so;","poem":1},{"text":"ɛno nti metan no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"So mʼagyapade nyɛɛ me sɛ anomaa","poem":1},{"text":"a nkekae sisi ne ho a ɔkyere mmoa","poem":2},{"lineBreak":true},{"text":"na nnomaa foforo a wɔkyere mmoa atwa ne ho ahyia resosɔw no ana?","poem":2},{"text":"Monkɔboaboa nkekaboa nyinaa ano.","poem":1},{"text":"Momfa wɔn mmra na wonkum wɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nguanhwɛfo bebree bɛsɛe me bobeturo,","poem":1},{"text":"na wɔatiatia me mfuw so;","poem":2},{"text":"wɔbɛdan me mfuw fɛɛfɛ no","poem":1},{"text":"ayɛ no asase hunu a ɛda mpan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɛbɛyɛ asase a ada mpan a,","poem":1},{"text":"awo wosee na ɛda hɔ kwa wɔ mʼanim;","poem":2},{"text":"asase no nyinaa bɛda mpan","poem":1},{"text":"efisɛ obiara nni hɔ a ɔhwɛ so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nkoko wosee a ɛwɔ nweatam no nyinaa so no","poem":1},{"text":"na asɛefo bɛba abegu bebree,","poem":2},{"text":"Awurade afoa bekunkum wɔn","poem":1},{"text":"afi asase ano de akosi ano nohɔ;","poem":2},{"lineBreak":true},{"text":"obiara remfa ne ho nni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wobedua atoko, nso wobetwa nsɔe;","poem":1},{"text":"wɔbɛbrɛ wɔn ho nanso wɔrennya hwee.","poem":2},{"text":"Wɔn ani bewu wɔ wɔn nnɔbaetwa ho.","poem":1},{"text":"Awurade abufuwhyew nti.”","poem":2}]},{"type":"verse","number":14,"content":["Nea Awurade se ni: “Na me yɔnkonom amumɔyɛfo a wɔfa agyapade a, mede maa me nkurɔfo Israelfo no de, metu wɔn afi wɔn nsase so na metu Yudafi afi wɔn mu."]},{"type":"verse","number":15,"content":["Na sɛ mitu wɔn wie a, mehu wɔn mmɔbɔ bio, na mede wɔn mu biara bɛba nʼagyapade, ne nʼasase so."]},{"type":"verse","number":16,"content":["Na sɛ wosua me nkurɔfo akwan yiye na wɔbɔ me din ka ntam se, ‘Nokware sɛ Awurade te ase yi’ a, ɛwɔ mu sɛ mmere bi wɔkyerɛɛ me nkurɔfo ma wɔde Baal kaa ntam de, nanso wɔn ase betim wɔ me nkurɔfo mu."]},{"type":"verse","number":17,"content":["Nanso sɛ ɔman bi antie a, metu nʼase, na masɛe no korakora,” Awurade na ose."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}