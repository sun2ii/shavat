{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel Pa Onyankopɔn Akyi"]},{"type":"verse","number":1,"content":["Awurade asɛm baa me so:"]},{"type":"verse","number":2,"content":["“Kɔpae mu ka ma Yerusalem nte:",{"text":"“ ‘Mekae sɛnea wode wo ho maa me wo mmabun bere mu,","poem":1},{"text":"sɛnea wodɔɔ me wɔ wʼayeforo bere mu","poem":2},{"text":"na wudii mʼakyi wɔ sare so,","poem":1},{"text":"asase a wonnuaa hwee wɔ so no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na Israel yɛ kronkron ma Awurade,","poem":1},{"text":"ne twabere mu aduankan;","poem":2},{"text":"wɔn a wodii nʼani no wobuu wɔn fɔ,","poem":1},{"text":"na amanehunu baa wɔn so,’ ”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade, se ni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muntie Awurade asɛm, mo Yakob asefo,","poem":1},{"text":"mo Israel mmusuakuw nyinaa.","poem":2}]},{"type":"verse","number":5,"content":["Eyi ne nea Awurade se:",{"text":"“Mfomso bɛn na mo agyanom huu wɔ me ho a","poem":1},{"text":"ɛma wɔtwee wɔn ho kɔɔ akyirikyiri sɛɛ?","poem":2},{"text":"Wodii ahoni a wɔn so nni mfaso akyi,","poem":1},{"text":"maa wɔn ankasa bɛyɛɛ ahuhufo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔammisa se, ‘Ɛhe na Awurade wɔ?","poem":1},{"text":"Nea oyii yɛn fii Misraim","poem":2},{"text":"na ɔde yɛn faa sare wosee so,","poem":1},{"text":"nweatam ne abonabon asase","poem":2},{"text":"a awo na ayɛ owubon no.","poem":1},{"text":"Asase a obiara mfa so na obiara nte so no.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mede mo beduaa asasebere so","poem":1},{"text":"sɛ munni so nnuaba ne ɛso nnepa.","poem":2},{"text":"Nanso mubeguu mʼasase ho fi,","poem":1},{"text":"na moyɛɛ mʼagyapade akyiwade.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asɔfo no ammisa se,","poem":1},{"text":"‘Ɛhe na Awurade wɔ?’","poem":2},{"text":"Wɔn a wɔde mmara yɛ adwuma no anhwehwɛ me;","poem":1},{"text":"ntuanofo sɔre tiaa me.","poem":2},{"text":"Adiyifo no de Baal hyɛɛ nkɔm,","poem":1},{"text":"na wodii ahoni huhuw akyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ɛno nti, merebɔ mo kwaadu bio,”","poem":1},{"text":"nea Awurade se ni.","poem":2},{"lineBreak":true},{"text":"“Na mɛbɔ mo mma mma kwaadu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Muntwa nkɔ Kitim mpoano nkɔhwɛ,","poem":1},{"text":"monsoma nkɔ Kedar nkɔhwehwɛ mu yiye;","poem":2},{"lineBreak":true},{"text":"monhwɛ sɛ biribi a ɛte sɛɛ asi wɔ hɔ:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɔman bi asesa wɔn anyame pɛn ana?","poem":1},{"text":"Nso wɔnnyɛ anyame mpo.","poem":2},{"text":"Nanso me nkurɔfo de wɔn anuonyam","poem":1},{"text":"asesa ahoni huhuw.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mo ɔsorosoro, momma mo ho nnwiriw mo wɔ eyi ho,","poem":1},{"text":"na mo ho nwosow wɔ akomatu mu,”","poem":2},{"lineBreak":true},{"text":"nea Awurade se ni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Me nkurɔfo ayɛ bɔne ahorow abien:","poem":1},{"lineBreak":true},{"text":"Wɔapa me,","poem":1},{"text":"me a meyɛ nkwa asubura no,","poem":2},{"text":"na wɔatutu wɔn ankasa mmura amoa,","poem":1},{"text":"mmura a apaapae a entumi nkora nsu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israel yɛ akoa anaa ɔsomfo fi awo mu ana?","poem":1},{"text":"Adɛn nti na wayɛ asade yi?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gyata abobɔ mu;","poem":1},{"text":"wɔaworo so akyerɛ no.","poem":2},{"text":"Wɔama nʼasase ada mpan;","poem":1},{"text":"wɔahyehyew ne nkurow ayɛ no amamfo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Afei Memfis ne Tapanhes mmarima","poem":1},{"text":"ayi wo ti so nwi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɛnyɛ wo na woama eyi aba wo so","poem":1},{"text":"sɛ wopaa Awurade wo Nyankopɔn akyi,","poem":2},{"lineBreak":true},{"text":"wɔ bere a ɔrekyerɛ wo kwan no?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Afei adɛn nti na wokɔ Misraim","poem":1},{"text":"kɔnom Sihor mu nsu?","poem":2},{"text":"Na adɛn nti na wokɔ Asiria","poem":1},{"text":"kɔnom Asubɔnten no mu nsu?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wo amumɔyɛ bɛtwe wʼaso;","poem":1},{"text":"wo nsanakyi bɛka wʼanim.","poem":2},{"text":"Enti dwene ho na hu sɛ,","poem":1},{"text":"sɛ wopa Awurade wo Nyankopɔn akyi","poem":2},{"text":"na woannya ne ho suro a,","poem":1},{"text":"ɛyɛ bɔne ne ɔyaw ma wo.”","poem":2},{"lineBreak":true},{"text":"Awurade, Asafo Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Tete mmere no, wububuu wo konnua mu,","poem":1},{"text":"na wotetew wo nkɔnsɔnkɔnsɔn mu;","poem":2},{"text":"na wokae se, ‘Merensom wo!’","poem":1},{"text":"Ampa, wɔ koko biara so","poem":2},{"text":"ne dua biara a adennan ase","poem":1},{"text":"na wotena bɔɔ aguaman.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Miduaa wo sɛ bobe ankasa","poem":1},{"text":"a efi bobe a ase ye pa ara mu.","poem":2},{"text":"Na ɛyɛɛ dɛn na wodan wʼakyi kyerɛɛ me","poem":1},{"text":"bɛyɛɛ bobe a anyin asɛe wɔ wura mu yi?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sɛ wode soda","poem":1},{"text":"ne samina bebree guare mpo a,","poem":2},{"text":"wʼafɔdi nkekae da so wɔ mʼanim ara,”","poem":1},{"text":"sɛnea Otumfo Awurade se ni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ɛbɛyɛ dɛn na woaka se, ‘Me ho nguu fi ɛ;","poem":1},{"text":"minnii Baalnom akyi ɛ’?","poem":2},{"text":"Hwɛ sɛnea woyɛɛ wo ho wɔ obon no mu;","poem":1},{"text":"dwene nea woayɛ no ho.","poem":2},{"text":"Woyɛ yomabere hoɔharefo","poem":1},{"text":"a wutu mmirika kɔ ha ba ha,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"wura mu afurum a nweatam so tena akokwaw no,","poem":1},{"text":"ohuahua bere a ɔpɛ sɛ onini hyia no.","poem":2},{"lineBreak":true},{"text":"Sɛ nʼakɔnnɔ no ano yɛ den a hena na obesianka no?","poem":2},{"text":"Anini biara a wɔtaa no no nhaw wɔn ho bebree;","poem":1},{"text":"edu bere a ɛsɛ sɛ wohyia no a wobenya no.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ntu mmirika nkosi sɛ wʼanan ase bɛyɛ kwaterekwa,","poem":1},{"text":"na wo mene mu bɛyow.","poem":2},{"text":"Nanso wokae se, ‘So nni mfaso!","poem":1},{"text":"Mepɛ ananafo anyame,","poem":2},{"lineBreak":true},{"text":"na ɛsɛ sɛ midi wɔn akyi.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Sɛnea wɔkyere ɔkorɔmfo a wogu nʼanim ase no,","poem":1},{"text":"saa na wɔagu Israelfi anim ase,","poem":2},{"text":"wɔn ankasa, wɔn ahemfo ne wɔn adwumayɛfo,","poem":1},{"text":"wɔn asɔfo ne wɔn adiyifo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wɔka kyerɛ dua se, ‘Woyɛ mʼagya,’","poem":1},{"text":"ne ɔbo se, ‘Wo na wowoo me.’","poem":2},{"text":"Wɔadan wɔn akyi akyerɛ me","poem":1},{"text":"na ɛnyɛ wɔn anim;","poem":2},{"text":"nanso sɛ amanehunu bi ba wɔn so a, wɔka se,","poem":1},{"text":"‘Bra begye yɛn!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Anyame a moyɛ maa mo ho no wɔ he?","poem":1},{"lineBreak":true},{"text":"Momma wɔmmra sɛ wobetumi agye mo","poem":1},{"text":"bere a mowɔ amanehunu mu!","poem":2},{"text":"Efisɛ mowɔ anyame bebree","poem":1},{"text":"te sɛ nea mowɔ nkurow bebree no, Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Adɛn nti na mobɔ me sobo?","poem":1},{"text":"Mo nyinaa ayɛ dɔm atia me,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Metwee mo nkurɔfo aso kwa;","poem":1},{"text":"wɔamfa me nteɛso.","poem":2},{"text":"Wʼafoa akunkum wʼadiyifo","poem":1},{"text":"te sɛ gyata a nʼani abere.","poem":2}]},{"type":"verse","number":31,"content":["“Mo nnɛmmafo, munnwen Awurade asɛm ho:",{"text":"“Mayɛ sɛ, nweatam ama Israel ana?","poem":1},{"text":"Anaasɛ asase a so aduru sum kabii ana?","poem":2},{"text":"Adɛn nti na me nkurɔfo ka se, ‘Yɛwɔ ho kwan sɛ yekyinkyin;","poem":1},{"text":"yɛremma wo nkyɛn bio.’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ɔbabun werɛ fi ne mpempranne,","poem":1},{"text":"ayeforo werɛ befi nʼahyehyɛde ana?","poem":2},{"text":"Nanso me nkurɔfo werɛ afi me","poem":1},{"text":"nna a wontumi nkan.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hwɛ nyansa a mowɔ de pɛ mo adɔfo!","poem":1},{"text":"Mmea a wɔnsɛ hwee koraa tumi sua mo akwan.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mo adurade mu wɔ","poem":1},{"text":"ahiafo a wodi bem mogya,","poem":2},{"lineBreak":true},{"text":"nanso moankyere wɔn sɛ wɔrebubu akɔ mu.","poem":2},{"text":"Eyinom nyinaa akyi","poem":1}]},{"type":"verse","number":35,"content":[{"text":"woka se, ‘Midi bem;","poem":2},{"lineBreak":true},{"text":"ne bo mfuw me.’","poem":2},{"text":"Nanso mebu wo atɛn","poem":1},{"text":"efisɛ woka se, ‘Menyɛɛ bɔne biara ɛ.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Adɛn nti na wukyinkyin sɛɛ,","poem":1},{"text":"sesa wʼakwan?","poem":2},{"text":"Misraim bedi wo huammɔ","poem":1},{"text":"sɛnea Asiria yɛe no.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Afei wubefi saa beae hɔ","poem":1},{"text":"a wo nsa gu wo ti so.","poem":2},{"text":"Efisɛ Awurade apo wɔn a wode wo ho too wɔn so no;","poem":1},{"text":"wɔremmoa wo.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}