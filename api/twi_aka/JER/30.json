{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Wogye Israel Si Hɔ"]},{"type":"verse","number":1,"content":["Asɛm a efi Awurade nkyɛn baa Yeremia hɔ ni:"]},{"type":"verse","number":2,"content":["“Sɛɛ na Awurade, Israel Nyankopɔn, se: ‘Kyerɛw nsɛm a maka akyerɛ wo nyinaa gu nhoma mu."]},{"type":"verse","number":3,"content":["Nna bi reba,’ sɛnea Awurade se, ‘a mede me nkurɔfo Israelfo ne Yudafo befi nnommum mu asan aba na mede wɔn aba asase a mede maa wɔn agyanom sɛ wɔmfa ntena so no so,’ Awurade na ose.”"]},{"type":"verse","number":4,"content":["Eyi ne nsɛm a Awurade ka faa Israel ne Yuda ho:"]},{"type":"verse","number":5,"content":["“Nea Awurade se ni:",{"text":"“ ‘Akomatu nteɛteɛmu na mete,","poem":1},{"text":"mete basabasayɛ, na ɛnyɛ asomdwoe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mummisa na munhu:","poem":1},{"text":"Ɔbarima betumi awo mma ana?","poem":2},{"text":"Afei, adɛn nti na mihu ɔbarima hoɔdenfo biara","poem":1},{"text":"sɛ ne nsa gu ne yafunu so te sɛ ɔbea a ɔwɔ awoko mu,","poem":2},{"lineBreak":true},{"text":"na anim biara ayɛ bosaa saa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sɛnea da no bɛyɛ hu afa!","poem":1},{"text":"Da biara renyɛ sɛ ɛno.","poem":2},{"text":"Ɛbɛyɛ amanehunu bere ama Yakob,","poem":1},{"text":"nanso wobeyi no afi mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Saa da no,’ Asafo Awurade na ose,","poem":1},{"text":"‘Mebubu konnua no afi wɔn kɔn mu,","poem":2},{"text":"na matetew wɔn nkyehama no mu;","poem":1},{"text":"ananafo remfa wɔn nyɛ nkoa bio.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Na mmom wɔbɛsom Awurade, wɔn Nyankopɔn","poem":1},{"text":"ne Dawid, wɔn hene,","poem":2},{"lineBreak":true},{"text":"a mɛpagyaw no ama wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Enti nsuro, Yakob, me somfo;","poem":1},{"text":"mma wʼaba mu mmu, Israel,’","poem":2},{"lineBreak":true},{"text":"nea Awurade se ni.","poem":2},{"text":"‘Nokware, megye wo afi akyirikyiri,","poem":1},{"text":"ne wʼasefo afi wɔn nnommum asase so.","poem":2},{"text":"Yakob bɛsan anya asomdwoe ne bammɔ","poem":1},{"text":"na obiara renhunahuna no bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Me ne wo wɔ hɔ na megye wo nkwa,’","poem":1},{"text":"Awurade na ose.","poem":2},{"text":"‘Ɛwɔ mu, mesɛe amanaman no nyinaa pasaa,","poem":1},{"text":"emu na mebɔ mo ahwete kɔ,","poem":2},{"lineBreak":true},{"text":"nanso merensɛe mo korakora.","poem":2},{"text":"Mɛteɛteɛ mo, nanso mɛyɛ no wɔ trenee kwan so;","poem":1},{"text":"meremma mo mfa mo ho nni koraa a merentwe mo aso.’","poem":2}]},{"type":"verse","number":12,"content":["“Sɛɛ na Awurade se:",{"text":"“ ‘Wʼapirakuru ayɛ akisikuru,","poem":1},{"text":"na wontumi nsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obiara nni hɔ a ɔbɛka bi ama wo,","poem":1},{"text":"wo kuru no rennya aduru,","poem":2},{"lineBreak":true},{"text":"na worennya ayaresa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wʼapamfo nyinaa werɛ afi wo;","poem":1},{"text":"wo ho biribiara mfa wɔn ho.","poem":2},{"text":"Mabɔ wo sɛnea wo tamfo bɛyɛ","poem":1},{"text":"na matwe wʼaso sɛnea otirimɔdenfo bɛtwe,","poem":2},{"text":"efisɛ wʼafɔdi so dodo","poem":1},{"text":"na wʼamumɔyɛ nso dɔɔso.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Adɛn nti na wusu dennen wɔ wʼapirakuru,","poem":1},{"text":"wo yawdi a ano nni aduru no ho?","poem":2},{"text":"Wʼafɔdi kɛse ne wʼamumɔyɛ bebrebe nti","poem":1},{"text":"na mede saa nneɛma yi ayɛ wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘Nanso wɔbɛsɛe wɔn a wɔsɛe mo;","poem":1},{"text":"mo atamfo nyinaa bɛkɔ nnommum mu.","poem":2},{"text":"Wɔn a wɔfow mo no wɔbɛfow wɔn","poem":1},{"text":"wɔn a wɔtow hyɛɛ mo so no, mɛtow ahyɛ wɔn so.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nanso mɛma wo ahoɔden bio","poem":1},{"text":"na masa wʼapirakuru,’","poem":2},{"lineBreak":true},{"text":"Awurade na ose,","poem":2},{"text":"‘efisɛ wɔfrɛ wo nea wɔapam no,","poem":1},{"text":"Sion a wo ho nhia obiara.’ ”","poem":2}]},{"type":"verse","number":18,"content":["Sɛɛ na Awurade se:",{"text":"“ ‘Mɛsan de Yakob ntamadan mu ahonyade aba","poem":1},{"text":"na manya ayamhyehye ama nʼatenae ahorow no;","poem":2},{"text":"wɔbɛkyekye kuropɔn no bio wɔ ne mmubui so,","poem":1},{"text":"na ahemfi no besi nea ɛsɛ sɛ esi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wɔn mu na aseda nnwom befi aba","poem":1},{"text":"ne ahosɛpɛw nnyigyei.","poem":2},{"text":"Mɛma wɔadɔɔso,","poem":1},{"text":"na wɔn dodow no so rentew;","poem":2},{"text":"mɛhyɛ wɔn anuonyam,","poem":1},{"text":"na wɔremmu wɔn abomfiaa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wɔn mma bedi yiye sɛ kan no,","poem":1},{"text":"mɛma wɔn asafo atim wɔ mʼanim;","poem":2},{"lineBreak":true},{"text":"wɔn a wɔhyɛ wɔn so nyinaa mɛtwe wɔn aso.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wɔn kannifo bɛyɛ wɔn ankasa nipa;","poem":1},{"text":"na wɔn sodifo befi wɔn mu.","poem":2},{"text":"Mɛka no abata me ho na wabɛn me,","poem":1},{"text":"na hena na ɔde ne ho bɛma","poem":2},{"text":"sɛ ɔbɛbɛn me?’ ”","poem":1},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ ‘Enti mobɛyɛ me nkurɔfo,","poem":1},{"text":"na mayɛ mo Nyankopɔn.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hwɛ, Awurade ahum","poem":1},{"text":"betu abufuwhyew mu,","poem":2},{"text":"mfɛtɛ bedi kyinhyia wɔ","poem":1},{"text":"amumɔyɛfo mpampam.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Awurade abufuw rennwo","poem":1},{"text":"kosi sɛ obewie","poem":2},{"lineBreak":true},{"text":"ne koma mu nhyehyɛe nyinaa.","poem":2},{"text":"Nna a ɛreba no mu no","poem":1},{"text":"mobɛte eyi ase.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}