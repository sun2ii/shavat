{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["“Saa bere no,” Awurade na ose, “Mɛyɛ Israel mmusuakuw no nyinaa Nyankopɔn, na wɔbɛyɛ me nkurɔfo.”"]},{"type":"verse","number":2,"content":["Nea Awurade se ni:",{"text":"“Nnipa a wotumi gyinaa wɔ afoa ano no","poem":2},{"text":"benya adom wɔ nweatam so;","poem":1},{"text":"mede ahomegye bɛbrɛ Israel.”","poem":2}]},{"type":"verse","number":3,"content":["Awurade daa ne ho adi kyerɛɛ yɛn kan no na ɔkae se,",{"text":"“Mede ɔdɔ a ɛnsa da adɔ mo","poem":1},{"text":"mede adɔe atwe mo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mede mo besi hɔ bio","poem":1},{"text":"na wɔbɛsan de wo, Ɔbabun Israel, asi hɔ.","poem":2},{"text":"Wobɛfa wʼakasae bio","poem":1},{"text":"na woafi adi ne anigyefo akɔsaw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bio, mobɛyɛ bobe nturo","poem":1},{"text":"wɔ Samaria nkoko so;","poem":2},{"text":"akuafo no bedua","poem":1},{"text":"na wɔadi so aba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Da bi bɛba a, awɛmfo bɛteɛ mu","poem":1},{"text":"wɔ Efraim nkoko so se,","poem":2},{"text":"‘Mommra, momma yɛnforo nkɔ Sion,","poem":1},{"text":"nkɔ Awurade yɛn Nyankopɔn nkyɛn.’ ”","poem":2}]},{"type":"verse","number":7,"content":["Nea Awurade se ni:",{"text":"“Momfa ahosɛpɛw nto nnwom mma Yakob;","poem":1},{"text":"Monteɛ mu mma amanaman mu kannifo.","poem":2},{"text":"Momma wɔnte mo ayeyi na monka se,","poem":1},{"text":"‘Awurade, gye wo nkurɔfo,","poem":2},{"lineBreak":true},{"text":"Israel nkae no.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hwɛ, mede wɔn befi atifi fam asase so aba","poem":1},{"lineBreak":true},{"text":"na maboa wɔn ano afi nsase ano.","poem":1},{"text":"Wɔn mu bi bɛyɛ anifuraefo, mpakye,","poem":2},{"text":"apemfo ne mmea a wɔwɔ awoko mu;","poem":1},{"text":"dɔm kɛse bɛsan aba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔde osu na ɛbɛba;","poem":1},{"text":"wɔbɛbɔ mpae bere a mede wɔn resan aba no.","poem":2},{"text":"Mede wɔn bɛfa nsuwa ho;","poem":1},{"text":"ɔkwan tamaa a wɔrenhintiw wɔ so,","poem":2},{"text":"efisɛ mɛyɛ Israel agya,","poem":1},{"text":"na Efraim yɛ me babarima piesie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Muntie Awurade asɛm, mo amanaman;","poem":1},{"text":"mommɔ no dawuru wɔ mpoano nsase a ɛwɔ akyirikyiri so se,","poem":2},{"text":"‘Nea ɔbɔɔ Israel petee no bɛboaboa wɔn ano","poem":1},{"text":"na wahwɛ ne nguankuw so sɛ oguanhwɛfo.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Na Awurade begyina mu ama Yakob","poem":1},{"text":"na wagye wɔn afi wɔn a","poem":2},{"lineBreak":true},{"text":"wɔwɔ ahoɔden sen wɔn no nsam.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔbɛba na wɔde ahurusi ateɛ mu wɔ Sion sorɔnsorɔmmea;","poem":1},{"lineBreak":true},{"text":"wɔbɛsɛpɛw wɔn ho wɔ akyɛde bebrebe a","poem":1},{"lineBreak":true},{"text":"efi Awurade hɔ mu,","poem":1},{"lineBreak":true},{"text":"atoko, nsa foforo ne ngo,","poem":1},{"text":"nguantenmma ne anantwi.","poem":2},{"text":"Wɔbɛyɛ sɛ turo a wɔagugu so nsu yiye,","poem":1},{"text":"na wɔrenni awerɛhow bio.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei mmabaa bɛsaw na wɔn ani agye,","poem":1},{"text":"mmerante ne nkwakoraa nso ka ho.","poem":2},{"text":"Mɛma wɔn awerɛhow adan anigye;","poem":1},{"text":"mɛma wɔn ahotɔ ne ahosɛpɛw de asi awerɛhow anan mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɛma asɔfo no nea ehia wɔn ama abu so,","poem":1},{"text":"na mama mʼakyɛde bebrebe amee me nkurɔfo,”","poem":2},{"lineBreak":true},{"text":"Awurade, na ose.","poem":2}]},{"type":"verse","number":15,"content":["Sɛɛ na Awurade se:",{"text":"“Wɔte nne bi wɔ Rama,","poem":2},{"text":"awerɛhow ne agyaadwotwa bebree,","poem":1},{"text":"Rahel resu ne mma","poem":2},{"text":"na ɔmpɛ sɛ wɔkyekye ne werɛ,","poem":1},{"text":"efisɛ ne mma nni hɔ bio.”","poem":2}]},{"type":"verse","number":16,"content":["Sɛɛ na Awurade se:",{"text":"“Hyɛ wo ho so na woansu,","poem":1},{"text":"mia wʼani na woante nusu,","poem":2},{"text":"efisɛ wobetua wʼadwumayɛ so ka,”","poem":1},{"text":"Awurade na ose.","poem":2},{"lineBreak":true},{"text":"“Wɔbɛsan afi atamfo no asase so aba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti anidaso wɔ hɔ ma wo daakye.”","poem":1},{"text":"Awurade na ose.","poem":2},{"lineBreak":true},{"text":"Wo mma bɛsan aba wɔn ankasa asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ampa ara mate sɛ Efraim resu se,","poem":1},{"text":"‘Woteɛteɛɛ me so sɛ nantwi ba a nʼani yɛ den,","poem":2},{"lineBreak":true},{"text":"na manya ahohyɛso.","poem":2},{"text":"Gye me bio, na mɛsan aba,","poem":1},{"text":"efisɛ wo ne Awurade, me Nyankopɔn.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Meman akyi no,","poem":1},{"text":"minyaa adwensakra;","poem":2},{"text":"na akyiri a minyaa ntease no,","poem":1},{"text":"mebɔɔ me koko so.","poem":2},{"text":"Mʼanim guu ase na mefɛree,","poem":1},{"text":"efisɛ me mmabun mu animguase da so so me.’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Efraim nyɛ me babarima dɔfo,","poem":1},{"text":"ɔba a ɔsɔ mʼani ana?","poem":2},{"text":"Ɛwɔ mu, metaa kasa tia no de,","poem":1},{"text":"nanso meda so kae no.","poem":2},{"text":"Enti me koma pere hwehwɛ no;","poem":1},{"text":"mewɔ ayamhyehye ma no,”","poem":2},{"lineBreak":true},{"text":"sɛɛ na Awurade se.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Momfa agyiraehyɛde nsisi akwan ho;","poem":1},{"text":"munsisi akwankyerɛ afadum.","poem":2},{"text":"Monhyɛ ɔtempɔn no nsow,","poem":1},{"text":"ɔkwan a monam so ba.","poem":2},{"text":"San wʼakyi, Ɔbabun Israel,","poem":1},{"text":"san bra wo nkurow so.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wubekyinkyin akosi da bɛn,","poem":1},{"text":"Ɔbabea Israel sesafo?","poem":2},{"text":"Awurade bɛyɛ ade foforo wɔ asase so,","poem":1},{"text":"ɔbea bɛbɔ ɔbarima ho ban.”","poem":2}]},{"type":"verse","number":23,"content":["Sɛɛ na Asafo Awurade, Israel Nyankopɔn no se: “Sɛ mesan de wɔn fi nnommum mu ba a, nnipa a wɔwɔ Yuda asase ne nkurow so bɛsan aka saa nsɛm yi se, ‘Awurade nhyira wo, wo yiyeyɛ kuropɔn ne bepɔw kronkron.’"]},{"type":"verse","number":24,"content":["Nnipa bɛbɔ mu atena ase wɔ Yuda ne ne nkurow nyinaa so, akuafo ne wɔn a wɔde wɔn nguankuw nenam."]},{"type":"verse","number":25,"content":["Mɛma nea wabrɛ no anya ahoɔden foforo, na nea watɔ piti no nso mɛma no amee.”"]},{"type":"verse","number":26,"content":["Minyanee, na mehwɛɛ me ho hyiae. Medaa hatee."]},{"type":"verse","number":27,"content":["“Nna bi reba,” Awurade na ose, “A mede nnipa mma ne mmoa mma bedua Israel ne Yuda fi."]},{"type":"verse","number":28,"content":["Sɛnea mehwɛ ma wotutui, wodwiriwii, wobubui, wɔsɛee na wɔde amanehunu bae no, saa ara na mɛhwɛ ama wɔasi na wɔadua,” sɛnea Awurade se ni."]},{"type":"verse","number":29,"content":["Saa nna no mu, nnipa renka bio se,",{"text":"“ ‘Agyanom adi bobe nwennaa,","poem":1},{"text":"na mma se afem.’","poem":2}]},{"type":"verse","number":30,"content":["Mmom, obiara bewu wɔ ɔno ara bɔne ho; nea obedi bobe nwennaa no ɔno na ne se bɛfem."]},{"type":"verse","number":31,"content":[{"text":"“Bere no reba,” Awurade na ose,","poem":1},{"text":"“a me ne Israelfi","poem":2},{"lineBreak":true},{"text":"ne Yudafi bɛyɛ apam foforo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ɛrenyɛ sɛ apam a","poem":1},{"text":"me ne wɔn agyanom yɛe no","poem":2},{"text":"bere a misoo wɔn nsa,","poem":1},{"text":"dii wɔn anim fii Misraim,","poem":2},{"text":"esiane sɛ wobuu mʼapam so,","poem":1},{"text":"wɔ bere a na meyɛ okunu ma wɔn no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“Eyi ne apam a me ne Israelfi bɛyɛ saa bere no akyi,”","poem":1},{"text":"Awurade na ose.","poem":2},{"text":"“Mede me mmara bɛhyɛ wɔn adwene mu,","poem":1},{"text":"na makyerɛw wɔ wɔn koma so.","poem":2},{"text":"Mɛyɛ wɔn Nyankopɔn,","poem":1},{"text":"na wɔbɛyɛ me nkurɔfo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Na obiara renkyerɛkyerɛ ne yɔnko bio,","poem":1},{"text":"anaa ne nua se, ‘Hu Awurade,’","poem":2},{"text":"Efisɛ, wɔn nyinaa behu me,","poem":1},{"text":"efi wɔn mu akumaa so, kosi ɔkɛse so,”","poem":2},{"lineBreak":true},{"text":"Sɛnea Awurade se ni.","poem":2},{"text":"“Na mede wɔn amumɔyɛ bɛkyɛ wɔn,","poem":1},{"text":"na merenkae wɔn bɔne bio.”","poem":2}]},{"type":"verse","number":35,"content":["Sɛɛ na Awurade se,",{"text":"nea ɔma owia hyerɛn adekyee,","poem":1},{"text":"na ɔhyɛ ɔsram ne nsoromma","poem":2},{"text":"sɛ wɔnhyerɛn anadwo;","poem":1},{"text":"nea ɔkanyan ɛpo","poem":2},{"text":"ma nʼasorɔkye bobɔ mu,","poem":1},{"text":"Asafo Awurade ne ne din.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Saa ahyɛde yi twa mu mʼani so a,”","poem":1},{"text":"Awurade na ose,","poem":2},{"text":"“ɛno ansa na Israel begyae","poem":1},{"text":"ɔmanyɛ wɔ mʼanim.”","poem":2}]},{"type":"verse","number":37,"content":["Sɛɛ na Awurade se:",{"text":"“Sɛ wobetumi asusuw wim ntrɛwmu","poem":1},{"text":"na wɔatumi ahwehwɛ asase ase fapem mu a","poem":2},{"text":"ɛno de, mɛpo Israel asefo nyinaa,","poem":1},{"text":"esiane nea wɔayɛ nyinaa nti,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":38,"content":["“Nna no reba,” Awurade na ose, “a wɔbɛkyekye kuropɔn yi bio ama me, fi Hananel abantenten kosi Twɔtwɔw so Pon."]},{"type":"verse","number":39,"content":["Wɔbɛtwe susuhama no mu, afi hɔ de akosi Gareb koko so, na akɔntɔn akɔ Goa."]},{"type":"verse","number":40,"content":["Obon a wɔtow afunu ne nsõ gu mu no nyinaa ne asase a ɛkɔ Kidron bon mu wɔ apuei fam, kosi apɔnkɔ pon no twɔtwɔw so bɛyɛ kronkron ama Awurade. Wɔrentutu na wɔrensɛe kuropɔn no da.”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}