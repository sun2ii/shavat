{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Sɛ wo, Israel, wobɛsan wʼakyi a,","poem":1},{"text":"san bra me nkyɛn,”","poem":2},{"lineBreak":true},{"text":"sɛɛ na Awurade se.","poem":2},{"text":"“Sɛ wuyi wʼahoni a ɛyɛ akyiwade fi mʼani so","poem":1},{"text":"na sɛ woamman bio,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na sɛ wufi nokware, pɛpɛyɛ ne trenee mu","poem":1},{"text":"ka ntam se, ‘Sɛ Awurade te ase yi,’ a","poem":2},{"text":"afei wobehyira aman no","poem":1},{"text":"na ne mu na wobenya anuonyam.”","poem":2}]},{"type":"verse","number":3,"content":["Eyi ne asɛm a, Awurade ka kyerɛ Yuda mmarima ne Yerusalem:",{"text":"“Munsiesie mo asase a womfuntum da,","poem":1},{"text":"na munnnua wɔ nsɔe mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muntwitwa mo ho twetia mma Awurade","poem":1},{"text":"muntwitwa mo koma twetia,","poem":2},{"lineBreak":true},{"text":"mo Yuda mmarima ne Yerusalemfo,","poem":2},{"text":"anyɛ saa a mʼabufuwhyew bɛsɔre na adɛw sɛ ogya","poem":1},{"text":"mo bɔne a moayɛ nti,","poem":2},{"lineBreak":true},{"text":"ɛbɛhyew a obiara rennum.”","poem":2}]},{"type":"heading","content":["Amanehunu A Efi Atifi Fam"]},{"type":"verse","number":5,"content":[{"text":"“Bɔ nkae wɔ Yuda na pae mu ka wɔ Yerusalem se","poem":1},{"text":"‘Hyɛn torobɛnto no wɔ asase no nyinaa so!’","poem":2},{"text":"Teɛ mu dennen se:","poem":1},{"text":"‘Mommoaboa mo ho ano!","poem":2},{"lineBreak":true},{"text":"Momma yenguan nkɔ nkuropɔn a wɔabɔ ho ban no mu!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Momma frankaa so na monkɔ Sion","poem":1},{"text":"munguan nkɔbɔ mo ho aguaa!","poem":2},{"text":"Efisɛ mede amanehunu fi atifi fam reba,","poem":1},{"text":"ɔsɛe a ɛyɛ hu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gyata bi afi ne tu mu;","poem":1},{"text":"ɔbɔɔaman bi asi mu.","poem":2},{"text":"Wafi ne tenabea","poem":1},{"text":"sɛ ɔrebɛsɛe wʼasase.","poem":2},{"text":"Wo nkurow bebubu","poem":1},{"text":"na ada mpan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti fura atweaatam,","poem":1},{"text":"di awerɛhow na twa adwo,","poem":2},{"text":"efisɛ Awurade abufuwhyew no","poem":1},{"text":"nnan mfii yɛn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Saa da no,” Awurade na ose,","poem":1},{"text":"“ɔhene no ne adwumayɛfo no bɛbɔ hu,","poem":2},{"text":"asɔfo no bo betu,","poem":1},{"text":"na adiyifo no ho bedwiriw wɔn.”","poem":2}]},{"type":"verse","number":10,"content":["Afei, mekae se, “Aa, Otumfo Awurade, woadaadaa nnipa yi ne Yerusalem, wokae se, ‘Mubenya asomdwoe,’ wɔ bere a afoa da yɛn mene mu.”"]},{"type":"verse","number":11,"content":["Saa bere no wɔbɛka akyerɛ nnipa yi ne Yerusalem se, “Mframa a emu yɛ hyew bɛbɔ afi nkoko wosee a ɛwɔ nweatam so aba me nkurɔfo so, ɛnyɛ nea ɛpo ho anaa ehuhuw so;"]},{"type":"verse","number":12,"content":["mframa a ano yɛ den boro saa no fi me nkyɛn. Afei mepae mu ka mʼatemmu a etia wɔn.”"]},{"type":"verse","number":13,"content":[{"text":"Hwɛ! ɔreba sɛ omununkum,","poem":1},{"text":"ne nteaseɛnam reba sɛ mfɛtɛ,","poem":2},{"text":"nʼapɔnkɔ ho yɛ hare sen akɔre.","poem":1},{"text":"Yennue! Yɛawu!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yerusalem, yi bɔne fi wo koma mu na woanya nkwa.","poem":1},{"text":"Wode adwemmɔne bɛhyɛ wo mu akosi da bɛn?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nne bi rebɔ amanneɛ fi Dan,","poem":1},{"text":"ɛrebɔ amanehunu ho dawuru fi Efraim nkoko so.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Monka eyi nkyerɛ aman no,","poem":1},{"text":"mommɔ no dawuru nkyerɛ Yerusalem se,","poem":2},{"text":"‘Atuafo dɔm fi akyirikyiri asase bi so reba,","poem":1},{"text":"wɔma ɔko nteɛmu so de tia Yuda nkuropɔn.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wotwa ne ho hyia sɛ mmarima a wɔrewɛn afuw,","poem":1},{"text":"efisɛ watew me so atua,’ ”","poem":2},{"lineBreak":true},{"text":"sɛɛ na Awurade se.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Wo ankasa abrabɔ ne nneyɛe,","poem":1},{"text":"na ɛde eyi aba wo so.","poem":2},{"text":"Eyi yɛ wʼasotwe.","poem":1},{"text":"Ɛyɛ nwen!","poem":2},{"lineBreak":true},{"text":"Ɛwowɔ koma!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ao, mʼahoyeraw, mʼahoyeraw!","poem":1},{"text":"midi me mu yaw.","poem":2},{"text":"Me koma mu yawdi!","poem":1},{"text":"Me koma bɔ kitirikitiri wɔ me mu,","poem":2},{"lineBreak":true},{"text":"mintumi nyɛ komm.","poem":2},{"text":"Efisɛ, mate torobɛnto no nnyigye;","poem":1},{"text":"mate ɔko frɛ no.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amanehunu di amanehunu akyi;","poem":1},{"text":"asase no nyinaa asɛe.","poem":2},{"text":"Wɔasɛe me ntamadan prɛko pɛ,","poem":1},{"text":"ne me hintabea mpofirim.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ɛsɛ sɛ mehwɛ ɔko frankaa no","poem":1},{"text":"na mitie torobɛnto no nnyigye kosi da bɛn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Me nkurɔfo yɛ nkwaseafo;","poem":1},{"text":"wonnim me.","poem":2},{"text":"Wɔyɛ mma a wonni adwene;","poem":1},{"text":"wɔnte hwee ase.","poem":2},{"text":"Wɔwɔ bɔneyɛ ho nyansa;","poem":1},{"text":"na wonnim sɛnea wɔyɛ papa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mehwɛɛ asase no,","poem":1},{"text":"na enni bɔbea, na ɛda mpan;","poem":2},{"text":"mehwɛɛ ɔsorosoro, na wɔn hann no nni hɔ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mehwɛɛ mmepɔw no,","poem":1},{"text":"na wɔrewosowosow,","poem":2},{"lineBreak":true},{"text":"na nkoko no nyinaa rehinhim.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mehwɛe, na nnipa nni hɔ;","poem":1},{"text":"wim anomaa biara atu kɔ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mehwɛe, na nsasebere no adan nweatam","poem":1},{"text":"na ne nkurow nyinaa asɛe","poem":2},{"lineBreak":true},{"text":"wɔ Awurade anim, wɔ nʼabufuwhyew ano.","poem":2}]},{"type":"verse","number":27,"content":["Sɛnea Awurade se:",{"text":"“Wɔbɛsɛe asase no nyinaa;","poem":1},{"text":"mmom, merensɛe no korakora.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti asase bedi awerɛhow","poem":1},{"text":"na ɔsorosoro beduru sum,","poem":2},{"text":"efisɛ makasa na merentwe nsan;","poem":1},{"text":"masi gyinae na merennan no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Apɔnkɔsotefo ne agyantowfo nnyigyei","poem":1},{"text":"ma kurow biara sofo guan.","poem":2},{"text":"Ebinom kɔhyɛ nkyɛkyerɛ mu,","poem":1},{"text":"ebinom foro kɔ abotan mu.","poem":2},{"text":"Nkurow no nyinaa so adeda mpan;","poem":1},{"text":"na obiara nte so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dɛn na woreyɛ, wo a wɔasɛe wo?","poem":1},{"text":"Adɛn na wufura ɔkɔben","poem":2},{"lineBreak":true},{"text":"de sikakɔkɔɔ agude asiesie wo ho?","poem":2},{"text":"Adɛn na wode nnuru keka wʼani?","poem":1},{"text":"Wohyehyɛ wo ho kwa.","poem":2},{"text":"Wʼadɔfo bu wo animtiaa;","poem":1},{"text":"wɔrehwehwɛ wo akum wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Mete osu bi te sɛ ɔbea a ɔwɔ awoko mu,","poem":1},{"text":"apinisi te sɛ ɔbea a ɔrewo nʼabakan,","poem":2},{"text":"Ɔbabea Sion resu te sɛ nea osi apini,","poem":1},{"text":"ɔtrɛw ne nsa mu na ɔreka se,","poem":2},{"text":"“Afei de meretɔ piti;","poem":1},{"text":"wɔde me nkwa ama awudifo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}