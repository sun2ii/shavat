{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Nsɛm A Ɛfa Moab Ho"]},{"type":"verse","number":1,"content":["Nea ɛfa Moab ho:",{"lineBreak":true},"Sɛɛ na Awurade, Israel Nyankopɔn se:",{"text":"“Nebo nnue, na wɔbɛsɛe no.","poem":1},{"text":"Wobegu Kiriataim anim ase, na wɔafa;","poem":2},{"lineBreak":true},{"text":"wobegu aban dennen no anim ase, na wɔadwiriw agu fam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wɔrenkamfo Moab bio;","poem":1},{"text":"Hesbon mmarima bɛbɔ nʼasehwe ho pɔw;","poem":2},{"lineBreak":true},{"text":"‘Mommra, momma yɛnkɔbɔ saa ɔman yi.’","poem":2},{"text":"Mo nso, Madmen mmarima mobɛka mo ano ato mu;","poem":1},{"text":"afoa no bɛtaa mo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muntie osu a efi Horonaim,","poem":1},{"text":"adesɛe ne ɔsɛe ho su.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔbɛbɔ Moab:","poem":1},{"text":"na ne mma nketewa bɛteɛteɛ mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔforo kɔ Luhit,","poem":1},{"text":"wɔde agyaadwotwa a mu yɛ den na ɛrekɔ;","poem":2},{"text":"ɔkwan a ɛkɔ Horonaim so no","poem":1},{"text":"wɔte ahoyeraw nteɛteɛmu wɔ adesɛe no ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munguan! muntu mmirika mpere mo nkwa.","poem":1},{"text":"Monyɛ sɛ wura wɔ nweatam so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Esiane sɛ mode mo ho to mo nneyɛe ne mo ahonya so nti,","poem":1},{"text":"mo nso wɔbɛfa mo nnommum,","poem":2},{"text":"na Kemos bɛkɔ nnommum mu,","poem":1},{"text":"ɔne nʼasɔfo ne adwumayɛfo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔsɛefo no betu kurow biara so sa,","poem":1},{"text":"na mu biara rennya ne ho ntetew.","poem":2},{"text":"Wɔbɛsɛe obon no","poem":1},{"text":"na wasɛe mmepɔw mpampam a ɛyɛ tamaa no,","poem":2},{"lineBreak":true},{"text":"efisɛ Awurade akasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momfa nkyene nhyɛ Moab,","poem":1},{"text":"efisɛ wɔrebɛsɛe no;","poem":2},{"text":"ne nkurow bɛda mpan a","poem":1},{"text":"obiara rentena mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nnome nka nea ɔtwentwɛn ne nan ase wɔ Awurade adwumayɛ ho!","poem":1},{"text":"Nnome nka nea ɔmmfa nʼafoa nhwie mogya ngu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moab atena ase asomdwoe mu fi ne mmerantebere mu,","poem":1},{"text":"te sɛ nsa ase puw a ataa dinn,","poem":2},{"text":"wonnhwie mfi ahina mu nkogu ahina foforo mu,","poem":1},{"text":"ɔnkɔɔ nnommum mu da.","poem":2},{"text":"Enti ɔte sɛ nea ɔte ara,","poem":1},{"text":"na ne ho hua nsakrae ɛ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso nna bi reba,”","poem":1},{"text":"Awurade na ose,","poem":2},{"text":"“a mɛsoma mmarima a wohwie fi ahina mu,","poem":1},{"text":"na wobehwie no agu;","poem":2},{"text":"wɔbɛma nʼahina mu ayɛ hwee","poem":1},{"text":"na wɔabobɔ ne nkuruwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei Kemos ho bɛyɛ Moab aniwu,","poem":1},{"text":"sɛnea Israelfi anim guu ase","poem":2},{"lineBreak":true},{"text":"bere a wɔde wɔn ho too Bet-El so no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ɛbɛyɛ dɛn na wutumi ka se, ‘Yɛyɛ dɔmmarima,","poem":1},{"text":"mmarima akokodurufo wɔ ɔsa mu’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wɔbɛsɛe Moab na wɔatu ne nkurow so sa;","poem":1},{"text":"wobekunkum ne mmerante a wɔte apɔw no,”","poem":2},{"lineBreak":true},{"text":"nea Ɔhene a wɔfrɛ no Asafo Awurade no se ni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Moab asehwe abɛn;","poem":1},{"text":"nʼamanehunu bɛba ntɛm.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Munsu no, mo a motete ne ho nyinaa,","poem":1},{"text":"ne mo a munim ne din nyinaa;","poem":2},{"text":"monka se, ‘Ɛyɛɛ dɛn na wɔabubu ahempema a ɛyɛ den yi","poem":1},{"text":"ɛyɛɛ dɛn wɔabu anuonyam pema fɛfɛ yi mu!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Fi wʼanuonyam mu,","poem":1},{"text":"na bɛtena asase wosee no so,","poem":2},{"text":"wo a wote Dibon Babea,","poem":1},{"text":"efisɛ nea ɔsɛe Moab no","poem":2},{"text":"betu aba wo so","poem":1},{"text":"abɛsɛe wo nkuropɔn a ɛwɔ bammɔ no.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gyina kwankyɛn na hwɛ,","poem":1},{"text":"wo a wote Aroer.","poem":2},{"text":"Bisa ɔbarima a ɔreguan no ne ɔbea a ɔrefi mu afi,","poem":1},{"text":"bisa wɔn se, ‘Asɛm bɛn na asi?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moab anim agu ase, efisɛ wɔabubu no pasaa;","poem":1},{"text":"muntwa adwo na monteɛteɛ mu!","poem":2},{"text":"Mommɔ dawuru wɔ Arnon ho se","poem":1},{"text":"wɔasɛe Moab.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Atemmu aba bepɔw tamaa so","poem":1},{"text":"wɔ Holon, Yahas ne Mefaat,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dibon ne Nebo ne Bet-Diblataim","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ne Kiriataim ne Bet Gamul ne Bet Meon","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ne Keriot ne Bosra","poem":2},{"lineBreak":true},{"text":"wɔ Moab nkurow nyinaa, nea ɛwɔ akyirikyiri ne nea ɛbɛn.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wɔatwa Moab mmɛn;","poem":1},{"text":"na ne basa abu,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Momma no mmow nsa,","poem":1},{"text":"efisɛ wabu Awurade animtiaa.","poem":2},{"text":"Momma Moab nyantam wɔ ne fe mu;","poem":1},{"text":"momma no nyɛ nea wodi ne ho fɛw.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɛnyɛ Israel na na wudi ne ho fɛw?","poem":1},{"text":"Wɔkyeree no akorɔmfo mu ana,","poem":2},{"text":"a enti mowosow mo ti animtiaabu so","poem":1},{"text":"bere biara a mobɛka ne ho asɛm?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mumfifi mo nkurow so nkɔtena abotan mu,","poem":1},{"text":"mo a motete Moab.","poem":2},{"text":"Monyɛ sɛ aborɔnoma a ɔyɛ ne berebuw","poem":1},{"text":"wɔ ɔbodan ano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Yɛate Moab ahantan no","poem":1},{"text":"nʼahomaso ne gye a ogye ne ho di mmoroso;","poem":2},{"text":"nʼahantan ne nʼahomaso,","poem":1},{"text":"ne ne koma mu ahohoahoa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Minim nʼasoɔden nanso ɛyɛ ɔkwa,”","poem":1},{"text":"Awurade na ose,","poem":2},{"lineBreak":true},{"text":"“na nʼahohoahoa mfa hwee mma.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Enti mitwa adwo ma Moab,","poem":1},{"lineBreak":true},{"text":"misu teɛ mu ma Moabfo nyinaa,","poem":1},{"text":"midi awerɛhow ma nnipa a wɔwɔ Kir Hereset.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Misu ma mo sɛnea Yaser su,","poem":1},{"text":"mo Sibma bobe.","poem":2},{"text":"Mo mman dennan kɔɔ po ho pɛɛ;","poem":1},{"text":"koduu Yaser po ho.","poem":2},{"text":"Ɔsɛefo no abegu","poem":1},{"text":"mo nnuaba a abere ne mo bobe no so.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ahosɛpɛw ne anigye atu afi","poem":1},{"text":"Moab nnuaba nturo ne mfuw so.","poem":2},{"text":"Matwa nsa a ɛteɛ fi nsakyiamoa no so;","poem":1},{"text":"obiara mmfa ahosɛpɛw ntiatia bobe no so.","poem":2},{"text":"Ɛwɔ mu nteɛteɛmu wɔ hɔ de,","poem":1},{"text":"nanso ɛnyɛ ahosɛpɛw nteɛteɛmu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Wɔn su ano den gyigye fi","poem":1},{"text":"Hesbon kɔ Eleale ne Yahas,","poem":2},{"text":"fi Soar de kosi Horonaim ne Eglat Selisiya,","poem":1},{"text":"mpo, nsu a ɛwɔ Nimrim no ayow.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Moab mu,","poem":1},{"text":"mede sorɔnsorɔmmea afɔrebɔ ne nnuhuam","poem":2},{"text":"a wɔhyew ma wɔn anyame no, bɛba awiei,”","poem":1},{"text":"Awurade, na ose.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Enti me koma su sɛ atɛntɛbɛn ma Moab;","poem":1},{"text":"esu sɛ atɛntɛbɛn ma nnipa a wɔwɔ Kir Hereset.","poem":2},{"lineBreak":true},{"text":"Ahonyade a wɔpɛe no kɔ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wɔabɔ eti biara tikwaw","poem":1},{"text":"na wɔayi abogyesɛ biara;","poem":2},{"text":"nsa nyinaa ho ayɛ akamakam","poem":1},{"text":"na atweaatam sisi obiara asen.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Adan a ɛwɔ Moab nyinaa atifi","poem":1},{"text":"ne ɔmanfo aguabɔbea nyinaa;","poem":2},{"text":"biribiara nni hɔ sɛ awerɛhow,","poem":1},{"text":"efisɛ mabubu Moab","poem":2},{"lineBreak":true},{"text":"ayɛ no sɛ ahina a obiara mpɛ,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Hwɛ sɛnea wabubu afa! Hwɛ sɛnea wɔretwa adwo!","poem":1},{"text":"Na hwɛ sɛnea Moab de aniwu dan nʼakyi!","poem":2},{"text":"Moab ayɛ nea wodi ne ho fɛw,","poem":1},{"text":"ne ahodwiriwde ama wɔn a wɔatwa ne ho ahyia nyinaa.”","poem":2}]},{"type":"verse","number":40,"content":["Sɛɛ na Awurade se:",{"text":"“Monhwɛ! ɔkɔre rebɔ hoo aba fam.","poem":1},{"text":"Watrɛw ne ntaban mu wɔ Moab so.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wɔbɛfa Keriot nnommum","poem":1},{"text":"na wɔafa nʼabandennen no.","poem":2},{"text":"Saa da no Moab dɔmmarima koma","poem":1},{"text":"betu sɛ ɔbea a ɔrekyem wɔ awo so.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wɔbɛsɛe Moab na ɛrenyɛ ɔman bio,","poem":1},{"text":"efisɛ obuu Awurade animtiaa.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ehu, nkonomoa ne afiri retwɛn mo,","poem":1},{"text":"Moabfo,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Nea oguan nea ɛyɛ hu no","poem":1},{"text":"bɛtɔ nkonomoa mu,","poem":2},{"text":"nea ɔbɛforo afi nkonomoa no mu no","poem":1},{"text":"afide beyi no;","poem":2},{"text":"na mede Moab asotwe afe no bɛba ne so,”","poem":1},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Hesbon nwini ase","poem":1},{"text":"na aguanfo no gyinagyina a wonni mmoa biara,","poem":2},{"text":"efisɛ ogya bi atu afi Hesbon;","poem":1},{"text":"ogyaframa bi fi Sihon mfimfini;","poem":2},{"text":"ɛhyew Moab moma,","poem":1},{"text":"ne ahohoahoafo a wɔn ano yɛ den no ti koraa.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Nnome nka wo, wo Moab!","poem":1},{"text":"Wɔasɛe Kemos nkurɔfo no;","poem":2},{"text":"wɔde wo mmabarima kɔ nnommum mu","poem":1},{"text":"na wo mmabea nso kɔ nkoasom mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Nanso mede Moab adenya bɛsan ama no","poem":1},{"text":"wɔ nna a ɛbɛba no mu,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2},"Moab atemmu no awiei ni."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}