{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Asɛm A Ɛfa Amon Ho"]},{"type":"verse","number":1,"content":["Nea ɛfa Amonfo ho:",{"lineBreak":true},"Sɛɛ na Awurade se:",{"text":"“Israel nni mmabarima ana?","poem":1},{"text":"Onni wɔn a wobedi nʼade?","poem":2},{"text":"Ɛno de adɛn nti na Molek afa Gad ayɛ ne de yi?","poem":1},{"text":"Adɛn nti na ne nkurɔfo tete ne nkurow mu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nanso nna no reba,”","poem":1},{"text":"Awurade na ose.","poem":2},{"text":"“Bere a mɛbobɔ mu de afrɛ ɔko","poem":1},{"text":"atia Raba a ɛyɛ Amonfo de;","poem":2},{"text":"ɛbɛyɛ afabo siw,","poem":1},{"text":"wɔbɛto nkuraa a atwa ne ho ahyia no mu gya.","poem":2},{"text":"Na Israel bɛpam wɔn a","poem":1},{"text":"wɔpam no no,”","poem":2},{"lineBreak":true},{"text":"sɛɛ na Awurade se.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Twa adwo. Hesbon, efisɛ wɔasɛe Ai!","poem":1},{"text":"Monteɛ mu, mo a mowɔ Raba!","poem":2},{"text":"Mumfura ayitam na munni awerɛhow;","poem":1},{"text":"mommɔ nnyenyen wɔ afasu no mu,","poem":2},{"text":"efisɛ Molek bɛkɔ nnommum mu,","poem":1},{"text":"ɔne nʼasɔfo ne nʼadwumayɛfo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adɛn nti na wode wʼabon ahorow no hoahoa wo ho,","poem":1},{"text":"wʼabon a wunya mu aba bebree no nti?","poem":2},{"text":"Amon Babea a Onni nokware,","poem":1},{"text":"wode wo ho to wʼahonya so na woka se,","poem":2},{"lineBreak":true},{"text":"‘Hena na ɔbɛtow ahyɛ me so?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mede ehu bɛba wo so,","poem":1},{"lineBreak":true},{"text":"ebefi wɔn a wɔatwa wo ho ahyia no nyinaa,”","poem":1},{"text":"Awurade na ose, Asafo Awurade no.","poem":2},{"text":"“Wɔbɛpam mo nyinaa,","poem":1},{"text":"na obiara remmoaboa akobɔfo ano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nanso akyiri no, mɛsan de Amonfo adenya ama wɔn,”","poem":1},{"text":"sɛe na Awurade se.","poem":2}]},{"type":"heading","content":["Asɛm A Ɛfa Edom Ho"]},{"type":"verse","number":7,"content":["Nea ɛfa Edom ho:",{"lineBreak":true},"Sɛɛ na Asafo Awurade se:",{"text":"“Nyansa nni Teman bio ana?","poem":1},{"text":"Afotu ayera wɔ anyansafo mu ana?","poem":2},{"lineBreak":true},{"text":"Wɔn nyansa no aporɔw ana?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Monnan mo ho na munguan,","poem":1},{"text":"monkɔtetɛw abodan a mu dɔ mu,","poem":2},{"lineBreak":true},{"text":"mo a motete Dedan,","poem":2},{"text":"efisɛ mede amanehunu bɛba Esau so","poem":1},{"text":"wɔ bere a mɛtwe nʼaso no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛ bobetetewfo no baa mo nkyɛn a","poem":1},{"text":"anka wɔrennya bobe no kakra ana?","poem":2},{"text":"Sɛ akorɔmfo baa ɔdasu mu a,","poem":1},{"text":"anka wɔrenwia ade dodow a wɔpɛ ana?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Na mɛma Esau ada adagyaw.","poem":1},{"text":"Mɛda ne hintabea ahorow adi,","poem":2},{"lineBreak":true},{"text":"sɛnea ɔrentumi mfa ne ho nhintaw.","poem":2},{"text":"Ne mma, nʼabusuafo ne ne mfɛfo bewuwu,","poem":1},{"text":"na wɔrenhu no bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Munnyaw mo ayisaa, mɛbɔ wɔn nkwa ho ban.","poem":1},{"text":"Mo akunafo nso betumi de wɔn ho ato me so.”","poem":2}]},{"type":"verse","number":12,"content":["Nea Awurade se ni: “Sɛ ɛsɛ sɛ wɔn a wɔmfata sɛ wɔnom kuruwa no nom a, ɛno de adɛn nti na ɛnsɛ sɛ wɔtwe mo aso? Wɔbɛtwe mo aso na mobɛnom nso."]},{"type":"verse","number":13,"content":["Meka me ho ntam sɛ wɔbɛsɛe Bosra na ayɛ ahodwiriwde, ahohorade ne nnome; na ne nkurow nyinaa bɛsɛe afebɔɔ,” Awurade na ose."]},{"type":"verse","number":14,"content":[{"text":"Mate asɛm a efi Awurade nkyɛn:","poem":1},{"text":"wɔsomaa ananmusini bi sɛ ɔnkɔka nkyerɛ amanaman no se,","poem":2},{"text":"“Mommoaboa mo ho ano nkɔtow nhyɛ no so!","poem":1},{"text":"Monsɔre nkɔ ɔko!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Na mɛyɛ wo ketewa wɔ aman no mu,","poem":1},{"text":"na wɔabu wo animtiaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ehu a wobɔ","poem":1},{"text":"ne koma mu ahomaso adaadaa wo,","poem":2},{"text":"wo a wote abotan ntokuru mu,","poem":1},{"text":"na wote koko no sorɔnsorɔmmea.","poem":2},{"text":"Ɛwɔ mu, woyɛ wo berebuw wɔ sorosoro sɛ ɔkɔre de,","poem":1},{"text":"nanso hɔ na mefi de wo aba fam,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Edom bɛyɛ ahodwiriwde;","poem":1},{"text":"wɔn a wotwa mu wɔ hɔ no nyinaa ho bedwiriw wɔn na wɔadi ne ho fɛw","poem":2},{"lineBreak":true},{"text":"esiane nʼapirakuru nyinaa nti.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sɛnea wɔdan Sodom ne Gomora","poem":1},{"text":"ne wɔn nkurow gui no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose,","poem":2},{"text":"“saa ara na obiara rentena hɔ;","poem":1},{"text":"onipa biara rentena mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Sɛnea gyata a ofi Yordan nkyɛkyerɛ mu","poem":1},{"text":"rekɔ adidibea frɔmfrɔm no,","poem":2},{"text":"saa ara na mɛtaa Edom afi nʼasase so wɔ bere tiaa bi mu.","poem":1},{"text":"Hena ne nea mayi no sɛ ɔnyɛ eyi?","poem":2},{"text":"Hena na ɔte sɛ me, na hena na obetumi ne me adi asi?","poem":1},{"text":"Na oguanhwɛfo bɛn na obetumi asɔre atia me?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Enti tie nea Awurade ahyehyɛ atia Edom,","poem":1},{"text":"nea wabɔ ne tirim sɛ ɔbɛyɛ de atia wɔn a wɔte Teman ni:","poem":2},{"text":"Nguankuw no mu nkumaa no wɔbɛtwe wɔn akɔ;","poem":1},{"text":"wɔn nti ɔbɛsɛe adidibea no koraa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wɔn asehwe nnyigyei bɛma asase awosow;","poem":1},{"text":"wɔn nteɛteɛmu gyegyeegye akodu Po Kɔkɔɔ ho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Monhwɛ! Ɔkɔre bi betu akɔ soro na wabɔ hoo aba fam a","poem":1},{"text":"watrɛtrɛw ne ntaban mu wɔ Bosra so.","poem":2},{"text":"Saa da no Edom dɔmmarima koma","poem":1},{"text":"betu sɛ ɔbea a ɔrekyem wɔ awo so.","poem":2}]},{"type":"heading","content":["Asɛm A Ɛfa Damasko Ho"]},{"type":"verse","number":23,"content":["Nea ɛfa Damasko ho:",{"text":"“Hamat ne Arpad di yaw,","poem":1},{"text":"efisɛ wɔate asɛmmɔne.","poem":2},{"text":"Wɔn koma abotow","poem":1},{"text":"te sɛ po a ayɛ hagyahagya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Damasko ayɛ mmerɛw,","poem":1},{"text":"wayɛ sɛ ɔrebeguan","poem":2},{"lineBreak":true},{"text":"wabɔ huboa;","poem":2},{"text":"ahoyeraw ne ɔyaw akyekyere no,","poem":1},{"text":"ɔyaw a ɛte sɛ ɔbea a, ɔrekyem wɔ awo so.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Adɛn nti na wonnyaw kuropɔn a agye din yi ntoo hɔ,","poem":1},{"text":"kurow a mʼani gye mu?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ampa ara ne mmerante bɛtotɔ wɔ mmɔnten so;","poem":1},{"text":"wɔbɛma nʼasraafo nyinaa aka wɔn ano ato mu saa da no,”","poem":2},{"lineBreak":true},{"text":"sɛɛ na Asafo Awurade se.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Mede ogya bɛto Damasko afasu mu;","poem":1},{"text":"na ɛbɛhyew Ben-Hadad aban.”","poem":2}]},{"type":"heading","content":["Asɛm A Ɛfa Kedar Ne Hasor Ho"]},{"type":"verse","number":28,"content":["Nea ɛfa Kedar ne Hasor ahenni, a Babiloniahene Nebukadnessar tow hyɛɛ so no.",{"lineBreak":true},"Sɛɛ na Awurade se:",{"text":"“Sɔre na kɔtow hyɛ Kedar so","poem":1},{"text":"na sɛe nnipa a wɔwɔ apuei fam no.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wɔbɛfa wɔn ntamadan ne wɔn nguankuw;","poem":1},{"text":"wɔbɛfa wɔn nkataso,","poem":2},{"lineBreak":true},{"text":"ne wɔn ho nneɛma ne yoma akɔ.","poem":2},{"text":"Nnipa bɛteɛteɛ mu se,","poem":1},{"text":"‘Ehu wɔ baabiara!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Munguan nkɔ ntɛmntɛm!","poem":1},{"text":"Monhyehyɛ abodan a mu dɔ mu, mo a motete Hasor,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2},{"text":"“Babiloniahene Nebukadnessar apam mo ti so;","poem":1},{"text":"wayɛ nhyehyɛe a etia mo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Sɔre kɔtow hyɛ ɔman bi so a woremmrɛ,","poem":1},{"lineBreak":true},{"text":"ɔman a wɔte ahotoso mu,”","poem":1},{"text":"Awurade na ose,","poem":2},{"text":"“ɔman a wonni apon anaa akwanside;","poem":1},{"text":"na emu nnipa nko ara na wɔte.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wɔn mfurum bɛyɛ asade,","poem":1},{"text":"na wɔn anantwikuw akɛse no bɛyɛ asade.","poem":2},{"text":"Mɛbɔ saa nnipa a wɔtete akyirikyiri no ahwete ama mframa no,","poem":1},{"text":"na mede amanehunu befi afa nyinaa aba wɔn so,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“Hasor bɛyɛ ahade ama adompo,","poem":1},{"text":"ɛbɛda mpan afebɔɔ.","poem":2},{"text":"Obiara rentena hɔ;","poem":1},{"text":"onipa biara rentena mu.”","poem":2}]},{"type":"heading","content":["Asɛm A Ɛfa Elam Ho"]},{"type":"verse","number":34,"content":["Eyi ne asɛm a, efi Awurade nkyɛn baa odiyifo Yeremia hɔ a ɛfa Elam ho, wɔ Yudahene Sedekia adedi mfiase:"]},{"type":"verse","number":35,"content":["Sɛɛ na Asafo Awurade se:",{"text":"“Hwɛ mebubu Elam agyan mu,","poem":1},{"lineBreak":true},{"text":"nea wɔn ahoɔden gyina so no.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Mede mframa anan no bɛba Elam so","poem":1},{"text":"afi ɔsorosoro afanan;","poem":2},{"text":"mɛbɔ wɔn ahwete mframa anan no mu,","poem":1},{"text":"na ɔman biara nni hɔ a","poem":2},{"lineBreak":true},{"text":"Elam atubrafo renkɔ so.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mɛbɔ Elam ahwete wɔ wɔn atamfo anim,","poem":1},{"text":"wɔ wɔn a wɔrehwehwɛ wɔn akum wɔn no anim;","poem":2},{"text":"mede amanehunu bɛba wɔn so","poem":1},{"text":"mpo mʼabufuwhyew no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2},{"text":"“Mede afoa bɛtaa wɔn","poem":1},{"text":"kosi sɛ, mewie wɔn korakora.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mesi mʼahengua wɔ Elam","poem":1},{"lineBreak":true},{"text":"na masɛe ne hene ne nʼadwumayɛfo,”","poem":1},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Nanso mɛsan de Elam adenya ama no","poem":1},{"text":"nna a ɛreba no mu,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}