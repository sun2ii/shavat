{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Asɛm A Ɛfa Babilonia Ho"]},{"type":"verse","number":1,"content":["Asɛm a Awurade nam odiyifo Yeremia so ka faa Babilonia ne Babiloniafo asase ho ni:"]},{"type":"verse","number":2,"content":[{"text":"“Mommɔ no dawuru na mompae mu nka wɔ amanaman mu.","poem":1},{"text":"Momma frankaa so na mompae mu nka;","poem":2},{"lineBreak":true},{"text":"na momma wɔnte sɛ,","poem":2},{"text":"‘Wɔbɛfa Babilonia;","poem":1},{"text":"wobegu Bel anim ase,","poem":2},{"lineBreak":true},{"text":"na ehu bɛhyɛ Merodak ma.","poem":2},{"text":"Wobegu ne nsɛsode anim ase","poem":1},{"text":"na ehu bɛhyɛ nʼahoni ma.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔman bi fi atifi fam bɛtow ahyɛ ne so","poem":1},{"text":"na wɔbɛyɛ nʼasase amamfo.","poem":2},{"text":"Obiara rentena so;","poem":1},{"text":"nnipa ne mmoa beguan afi so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nna no mu ne saa bere no,”","poem":1},{"text":"Awurade na ose,","poem":2},{"text":"“Israelfo ne Yudafo bɛka abɔ mu","poem":1},{"text":"de nusu akɔhwehwɛ wɔn Awurade, wɔn Nyankopɔn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wobebisa ɔkwan a ɛkɔ Sion","poem":1},{"text":"na wɔde wɔn ani akyerɛ hɔ.","poem":2},{"text":"Wɔbɛba de wɔn ho abɛbɔ Awurade","poem":1},{"text":"wɔ daa apam a","poem":2},{"lineBreak":true},{"text":"werɛ remfi mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Me nkurɔfo ayɛ nguan a wɔayera;","poem":1},{"text":"wɔn nguanhwɛfo ama wɔafom ɔkwan","poem":2},{"lineBreak":true},{"text":"ma wokyinkyin mmepɔw so.","poem":2},{"text":"Wokyinkyin bepɔw ne koko so","poem":1},{"text":"na wɔn werɛ fii wɔn ankasa homebea.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obiara a ohuu wɔn no tetew wɔn mu:","poem":1},{"text":"wɔn atamfo kae se, ‘Yenni fɔ,","poem":2},{"text":"efisɛ wɔyɛɛ bɔne tiaa Awurade, wɔn nokware didibea no,","poem":1},{"text":"Awurade wɔn agyanom anidaso no.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Munguan mfi Babilonia;","poem":1},{"text":"mumfi Babiloniafo asase so,","poem":2},{"lineBreak":true},{"text":"na monyɛ sɛ mpapo a wodi nguankuw anim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɛkanyan amanaman akɛse nkabom","poem":1},{"text":"afi atifi fam asase so de wɔn abɛko atia Babilonia.","poem":2},{"text":"Wobegyinagyina wɔn afa atia no,","poem":1},{"text":"wobefi atifi fam ako afa no.","poem":2},{"text":"Wɔn agyan bɛyɛ sɛ dɔmmarima a wɔakwadaw akodi mu,","poem":1},{"text":"wɔn a wɔmmfa nsapan nsan wɔn akyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti wɔbɛfow Babilonia;","poem":1},{"text":"wɔn a wɔfow no nyinaa benya asade bebree,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Esiane sɛ mo ani gye na mudi ahurusi,","poem":1},{"text":"mo a mofow mʼagyapade,","poem":2},{"text":"sɛ muhuruhuruw anigye so te sɛ nantwiforo a ɔwɔ sare frɔmfrɔm mu","poem":1},{"text":"na musu te sɛ apɔnkɔnini nti,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wo na ani bewu pa ara;","poem":1},{"text":"nea ɔwoo wo anim begu ase.","poem":2},{"text":"Ɔbɛyɛ akumaa wɔ amanaman no mu,","poem":1},{"text":"sare, asase wosee ne nweatam.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Awurade abufuw nti, obiara rentena hɔ","poem":1},{"text":"na ɛbɛda mpan korakora.","poem":2},{"text":"Wɔn a wotwa mu wɔ Babilonia nyinaa ho bedwiriw wɔn na wɔadi ne ho fɛw","poem":1},{"text":"esiane nʼapirakuru nyinaa nti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Munnyinagyina mo afa ntwa Babilonia ho nhyia,","poem":1},{"text":"mo a motow agyan nyinaa.","poem":2},{"text":"Montow no! Munnyaw bɛmma biara,","poem":1},{"text":"efisɛ wayɛ bɔne atia Awurade.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Monteɛ mu ntia no wɔ afanan nyinaa!","poem":1},{"text":"Ɔma ne nsa so, nʼabandennen bubu,","poem":2},{"lineBreak":true},{"text":"wodwiriw nʼafasu gu fam.","poem":2},{"text":"Esiane sɛ eyi yɛ Awurade aweretɔ no nti,","poem":1},{"text":"montɔ ne so were;","poem":2},{"lineBreak":true},{"text":"monyɛ no sɛnea wayɛ afoforo no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munyi ogufo mfi Babilonia,","poem":1},{"text":"ɔne otwafo a okura ne kantankrankyi wɔ otwabere mu no.","poem":2},{"text":"Esiane nhyɛsofo no afoa nti","poem":1},{"text":"obiara nsan nkɔ ne nkurɔfo mu,","poem":2},{"lineBreak":true},{"text":"obiara nguan nkɔ nʼankasa asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Israel yɛ nguankuw a wɔahwete","poem":1},{"text":"a gyata apam wɔn.","poem":2},{"text":"Nea odii kan tetew ne mu","poem":1},{"text":"yɛ Asiriahene;","poem":2},{"text":"na nea ɔdwerɛwee ne nnompe akyiri no","poem":1},{"text":"yɛ Babiloniahene Nebukadnessar.”","poem":2}]},{"type":"verse","number":18,"content":["Ɛno nti, sɛɛ na Asafo Awurade, Israel Nyankopɔn se:",{"text":"“Mɛtwe Babiloniahene ne nʼasase aso","poem":1},{"text":"sɛnea metwee Asiriahene aso no.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Na mede Israel bɛsan aba nʼankasa didibea,","poem":1},{"text":"na obedidi wɔ Karmel ne Basan;","poem":2},{"lineBreak":true},{"text":"ɔbɛmee wɔ Efraim ne Gilead nkoko so.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saa nna no ne saa bere no,”","poem":1},{"text":"Awurade na ose,","poem":2},{"text":"“Wɔbɛhwehwɛ Israel afɔbu mu,","poem":1},{"text":"nanso wɔrennya bi,","poem":2},{"text":"wɔbɛhwehwɛ Yuda nnebɔne mu,","poem":1},{"lineBreak":true},{"text":"nanso wɔrenhu bi,","poem":1},{"text":"efisɛ, mede nkae a migyaa wɔn no bɔne bɛkyɛ wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Montow nhyɛ Merataim asase so","poem":1},{"text":"ne nnipa a wɔte Pekod.","poem":2},{"text":"Montaa wɔn, munkunkum wɔn","poem":1},{"text":"na monsɛe wɔn korakora,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2},{"lineBreak":true},{"text":"“Monyɛ biribiara a mahyɛ mo no.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ɔko mu gyegyeegye wɔ asase no so,","poem":1},{"text":"ɔsɛe kɛse nnyigyei!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hwɛ sɛnea wɔabubu na wɔabobɔ","poem":1},{"text":"asase nyinaa so asae!","poem":2},{"text":"Hwɛ sɛnea Babilonia ada mpan","poem":1},{"text":"wɔ amanaman no mu!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Misum wo afiri, Babilonia,","poem":1},{"lineBreak":true},{"text":"na eyii wo ansa na worehu;","poem":1},{"text":"wohuu wo kyeree wo","poem":2},{"lineBreak":true},{"text":"efisɛ woko tiaa Awurade.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Otumfo Awurade abue nʼakode adekoradan","poem":1},{"text":"na wayi nʼabufuwhyew akode de apue,","poem":2},{"text":"efisɛ Asafo Awurade wɔ adwuma yɛ","poem":1},{"text":"wɔ Babiloniafo asase so.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mumfi akyirikyiri mmra ne so.","poem":1},{"text":"Mummubu nʼasan no ani;","poem":2},{"lineBreak":true},{"text":"monhɔre no siw sɛ awi akuwakuw.","poem":2},{"text":"Monsɛe no korakora","poem":1},{"text":"na munnyaw nkae biara mma no.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Munkunkum nʼanatwinini nyinaa;","poem":1},{"text":"momfa wɔn nkɔ mma wonkokum wɔn!","poem":2},{"text":"Mmusu nka wɔn! Efisɛ wɔn da no adu,","poem":1},{"text":"bere a wɔde bɛtwe wɔn aso no.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Muntie akobɔfo ne aguanfo a wofi Babilonia no","poem":1},{"text":"sɛ wɔreka wɔ Sion","poem":2},{"text":"sɛnea Awurade, yɛn Nyankopɔn atɔ were,","poem":1},{"text":"nʼasɔrefi ho aweretɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Momfrɛ agyantowfo nkɔtoa Babilonia,","poem":1},{"text":"wɔn a wɔtow agyan nyinaa.","poem":2},{"text":"Muntwa ne ho nhyia;","poem":1},{"text":"mommma obiara nguan.","poem":2},{"text":"Muntua ne nneyɛe so ka;","poem":1},{"text":"monyɛ no sɛnea wayɛ.","poem":2},{"text":"Efisɛ wabu Awurade animtiaa,","poem":1},{"text":"Israel kronkronni no.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Enti ne mmerante bɛtotɔ wɔ mmɔnten so;","poem":1},{"text":"wɔbɛtɔre nʼasraafo nyinaa ase saa da no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Hwɛ, mikyi wo; ɔhantanni.”","poem":1},{"text":"Awurade, Asafo Awurade na ose,","poem":2},{"text":"“efisɛ wo da no adu","poem":1},{"text":"bere a wɔde bɛtwe wʼaso no.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ɔhantanni no behintiw na wahwe ase,","poem":1},{"text":"obiara remmoa no mma ɔnnsɔre;","poem":2},{"text":"mɛto ne nkurow mu gya","poem":1},{"text":"na ahyew wɔn a atwa ne ho ahyia nyinaa.”","poem":2}]},{"type":"verse","number":33,"content":["Sɛɛ na Asafo Awurade se:",{"text":"“Wɔhyɛ Israelfo so,","poem":1},{"text":"na Yudafo nso saa ara.","poem":2},{"text":"Wɔn nnommumfafo no kura wɔn dennen","poem":1},{"text":"a wɔmpɛ sɛ wogyaa wɔn ma wɔkɔ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nanso wɔn Gyefo yɛ ɔhoɔdenfo;","poem":1},{"text":"ne din ne Asafo Awurade.","poem":2},{"text":"Obedi wɔn asɛm ama wɔn anibere so,","poem":1},{"text":"sɛnea ɔde ahotɔ bɛba wɔn asase no so,","poem":2},{"lineBreak":true},{"text":"na wɔn a wɔte Babilonia no nea wahyɛ wɔn ahometew.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Afoa a etia Babiloniafo!”","poem":1},{"text":"Awurade na ose,","poem":2},{"text":"“etia wɔn a wɔte Babilonia","poem":1},{"text":"na etia nʼadwumayɛfo ne nʼanyansafo!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Afoa a etia nʼatoro adiyifo!","poem":1},{"text":"Wɔbɛdan nkwaseafo.","poem":2},{"text":"Afoa a etia nʼakofo!","poem":1},{"lineBreak":true},{"text":"Ehu bɛhyɛ wɔn ma.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Afoa a etia nʼapɔnkɔ ne ne nteaseɛnam","poem":1},{"text":"ne ananafo a wɔwɔ wɔn mu nyinaa!","poem":2},{"lineBreak":true},{"text":"Wɔbɛdan mmea.","poem":2},{"text":"Afoa a etia nʼademude!","poem":1},{"text":"Wɔbɛfom.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ɔyow wɔ nʼasu ahorow so!","poem":1},{"text":"Ɛbɛyoyow.","poem":2},{"text":"Efisɛ ɛyɛ ahoni asase,","poem":1},{"text":"ahoni a ehu bɛma wɔabobɔ adam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Enti sare so mmoa ne mpataku bɛtena hɔ,","poem":1},{"text":"na ɛhɔ na patu bɛtena.","poem":2},{"text":"Obiara rentena so bio","poem":1},{"text":"efi awo ntoatoaso kosi awo ntoatoaso.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Sɛnea Onyankopɔn tuu Sodom ne Gomora","poem":1},{"text":"ne wɔn nkurow gui no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose,","poem":2},{"text":"“saa ara na obiara rentena hɔ;","poem":1},{"text":"onipa biara rentena mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Monhwɛ! Asraafo bi fi atifi fam reba;","poem":1},{"text":"ɔman kɛse ne ahemfo bebree,","poem":2},{"lineBreak":true},{"text":"wɔrehwanyan wɔn afi nsase ano.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wokurakura bɛmma ne mpeaw;","poem":1},{"text":"wɔn tirim yɛ den, na wonni ahummɔbɔ.","poem":2},{"text":"Wɔn nnyigyei te sɛ po a ɛworo so.","poem":1},{"text":"Sɛ wɔtete wɔn apɔnkɔ so a,","poem":2},{"text":"wɔba sɛ mmarima a wɔrekɔ sa","poem":1},{"text":"abɛtow ahyɛ wo so, Ɔbabea Babilonia.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Babiloniahene ate wɔn ho nsɛm,","poem":1},{"text":"ne nsa sesa ne ho kwa.","poem":2},{"text":"Ahohiahia akyekyere no","poem":1},{"text":"ɔyaw a ɛte sɛ ɔbea a ɔrekyem wɔ awo so.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Sɛnea gyata a ofi Yordan nkyɛkyerɛ mu","poem":1},{"text":"rekɔ adidibea frɔmfrɔm no,","poem":2},{"text":"saa ara na mɛtaa Babilonia fi nʼasase so wɔ bere tiaa bi mu.","poem":1},{"text":"Hena ne nea mayi no sɛ ɔnyɛ eyi?","poem":2},{"text":"Hena na ɔte sɛ me, na hena na obetumi ne me adi asi?","poem":1},{"text":"Na oguanhwɛfo bɛn na obetumi asɔre atia me?”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Enti tie nea Awurade ahyehyɛ atia Babilonia,","poem":1},{"text":"nea wabɔ ne tirim sɛ ɔbɛyɛ de atia Babiloniafo asase ni:","poem":2},{"text":"Nguankuw no mu nkumaa no wɔbɛtwe wɔn akɔ;","poem":1},{"text":"wɔn nti ɔbɛsɛe adidibea no koraa.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Babilonia nnommumfa nnyigyei bɛma asase awosow;","poem":1},{"text":"ne nteɛteɛmu gyegyeegye wɔ amanaman no mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}