{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Sɛɛ na Awurade se:",{"text":"“Monhwɛ, mɛkanyan ɔsɛefo bi honhom","poem":1},{"text":"atia Babilonia ne nnipa a wɔwɔ Leb Kamai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛsoma ananafo akɔ Babilonia","poem":1},{"text":"sɛ wonkohuhuw ne so na wɔnsɛe nʼasase;","poem":2},{"text":"wobetia no wɔ afanan nyinaa","poem":1},{"text":"wɔ nʼamanehunu da no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mma agyantowni pema nʼagyan,","poem":1},{"text":"mma ɔnhyɛ ne nkatabo.","poem":2},{"text":"Mma ne mmerante mfa wɔn ho nni;","poem":1},{"text":"sɛe nʼasraafo no pasaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔbɛhwehwe ase a wɔatotɔ wɔ Babilonia,","poem":1},{"text":"a wɔapirapira yiye wɔ ne mmɔnten so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na Israel Nyankopɔn, Asafo Awurade no,","poem":1},{"text":"nnyaw Israel ne Yuda hɔ ɛ,","poem":2},{"text":"ɛwɔ mu, afɔdi ahyɛ wɔn asase no so ma","poem":1},{"text":"wɔ Israel Ɔkronkronni no anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Munguan mfi Babilonia!","poem":1},{"text":"Muntu mmirika mpere mo nkwa!","poem":2},{"lineBreak":true},{"text":"Mommma wɔnnsɛe mo esiane ne bɔne nti.","poem":2},{"text":"Awurade aweretɔbere aso;","poem":1},{"text":"ɔde nea ɛfata no betua no ka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na Babilonia yɛ sikakɔkɔɔ kuruwa wɔ Awurade nsam;","poem":1},{"text":"ɔmaa asase nyinaa bow nsa.","poem":2},{"text":"Aman no nom ne nsa;","poem":1},{"text":"ɛno nti, afei wɔabobɔ adam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babilonia bɛhwe ase abubu mpofirim.","poem":1},{"text":"Muntwa ne ho agyaadwo!","poem":2},{"text":"Mompɛ ne yaw no ano aduru;","poem":1},{"text":"ebia ne ho bɛtɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Anka yɛbɛsa Babilonia yare,","poem":1},{"text":"nanso wontumi nsa no yare;","poem":2},{"text":"momma yennyaw no hɔ na obiara nkɔ nʼankasa asase so,","poem":1},{"text":"efisɛ nʼatemmu du sorosoro;","poem":2},{"lineBreak":true},{"text":"ɛforo soro te sɛ omununkum.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Awurade abu yɛn bem.","poem":1},{"text":"Mommra, momma yɛnka wɔ Sion,","poem":2},{"lineBreak":true},{"text":"nea Awurade, yɛn Nyankopɔn ayɛ.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Monsew agyan no ano!","poem":1},{"text":"Momfa nkatabo no!","poem":2},{"text":"Awurade ahwanyan Mede ahemfo no,","poem":1},{"text":"efisɛ ne botae ne sɛ ɔbɛsɛe Babilonia.","poem":2},{"text":"Awurade bɛtɔ were,","poem":1},{"text":"ɔbɛtɔ were ama nʼasɔrefi no.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mompagyaw frankaa bi ntia Babilonia afasu!","poem":1},{"text":"Mummia bammɔ mu,","poem":2},{"text":"momma awɛmfo no nnyinagyina.","poem":1},{"text":"Munsiesie ahintawee!","poem":2},{"text":"Awurade bɛma nʼatirimpɔw aba mu,","poem":1},{"text":"nea wahyɛ atia Babilonia no.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mo a motete nsuwansuwa bebree ho","poem":1},{"text":"na nnwetɛbona abu mo so,","poem":2},{"text":"mo awiei aba,","poem":1},{"text":"bere a ɛsɛ sɛ wotwa mo kyene no.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asafo Awurade, aka ne ho ntam sɛ:","poem":1},{"text":"mede nnipa bɛhyɛ wo ma sɛ tɛwtɛw,","poem":2},{"text":"na wɔabɔ ose wɔ wo so.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ɔde ne tumi bɔɔ asase;","poem":1},{"lineBreak":true},{"text":"ɔtoo wiase fapem wɔ ne nyansa mu","poem":1},{"text":"na ɔde ne nhumu trɛw ɔsorosoro mu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sɛ ɔbobɔ mu a, ɔsoro nsu woro so;","poem":1},{"text":"ɔma omununkum ma ne ho so fi nsase ano.","poem":2},{"text":"Ɔsoma anyinam ka osu ho","poem":1},{"text":"na ɔma mframa bɔ fi ne koradan mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Onipa biara nnim nyansa, na onni nimdeɛ;","poem":1},{"text":"sikadwumfo biara anim gu ase, esiane nʼahoni nti.","poem":2},{"text":"Ne nsɛsode yɛ atoro;","poem":1},{"text":"wonni ɔhome biara wɔ wɔn mu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔn so nni mfaso, wɔn ho yɛ serew;","poem":1},{"text":"sɛ wɔn atemmu du so a, wɔbɛyera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nea ɔyɛ Yakob Kyɛfa no nte sɛ eyinom,","poem":1},{"text":"efisɛ ɔno ne ade nyinaa Yɛfo","poem":2},{"text":"a Israel, abusua a ɛyɛ nʼagyapade nso ka ho.","poem":1},{"text":"Asafo Awurade ne ne din.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Woyɛ me ko abaa,","poem":1},{"text":"mʼakode a mede kɔ sa","poem":2},{"text":"mede wo dwerɛw amanaman,","poem":1},{"text":"mede wo sɛe ahenni bebree,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"mede wo bobɔ ɔpɔnkɔ ne ne sotefo,","poem":1},{"text":"teaseɛnam ne ne kafo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"mede wo dwerɛw ɔbarima ne ɔbea,","poem":1},{"text":"mede wo dwerɛw akwakoraa ne ɔbabun,","poem":2},{"lineBreak":true},{"text":"mede wo dwerɛw aberante ne ababaa,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"mede wo dwerɛw oguanhwɛfo ne nguankuw,","poem":1},{"text":"mede wo dwerɛw okuafo ne anantwi,","poem":2},{"lineBreak":true},{"text":"mede wo dwerɛw amradofo ne adwumayɛfo.","poem":2}]},{"type":"verse","number":24,"content":["“Metua Babilonia ne wɔn a wɔtete Babilonia ka wɔ mfomso a, wɔayɛ wɔ Sion nyinaa, wɔ wʼanim,” Awurade na ose."]},{"type":"verse","number":25,"content":[{"text":"“Bepɔw sɛefo, me ne wo anya,","poem":1},{"text":"wo a wosɛe asase nyinaa no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2},{"text":"“Mɛteɛ me nsa wɔ wo so","poem":1},{"text":"mepia wo afi abotan no so,","poem":2},{"lineBreak":true},{"text":"na mayɛ wo sɛ bepɔw a ɛnka hwee.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wɔremfa ɔbo biara mfi wo so nyɛ tweatibo","poem":1},{"text":"anaasɛ fapem mpo,","poem":2},{"text":"efisɛ wobɛda mpan afebɔɔ,”","poem":1},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Momma frankaa so wɔ asase no so!","poem":1},{"text":"Monhyɛn torobɛnto no wɔ amanaman no mu!","poem":2},{"text":"Munsiesie amanaman no mma wontu no so sa;","poem":1},{"text":"Momfrɛfrɛ saa ahenni ahorow yi mma wɔnko ntia no:","poem":2},{"lineBreak":true},{"text":"Ararat, Mini ne Askenas.","poem":2},{"text":"Munnyi ɔsahene ntia no;","poem":1},{"text":"momfa apɔnkɔ manyamanya te sɛ tɛwtɛw mmra.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Munsiesie amanaman no mma wontu no so sa,","poem":1},{"text":"mo Mede ahemfo,","poem":2},{"text":"wɔn amradofo ne wɔn adwumayɛfo nyinaa,","poem":1},{"text":"ne aman a wodi so nyinaa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Asase no wosow, na onukunuku ne mu,","poem":1},{"text":"efisɛ Awurade atirimpɔw a etia Babilonia","poem":2},{"text":"sɛ ɔbɛsɛe Babilonia asase a","poem":1},{"text":"obiara rentumi ntena so no nsakraa ɛ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Babilonia dɔmmarima agyae ko","poem":1},{"text":"wɔhyehyɛ wɔn aban mu.","poem":2},{"text":"Wɔn ahoɔden asa;","poem":1},{"text":"wɔayɛ sɛ mmea.","poem":2},{"text":"Wɔatoto nʼatenae ahorow no mu gya,","poem":1},{"text":"na wɔabubu nʼapon akyi adaban.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abɔfo didi so","poem":1},{"text":"na asomafo didi so a","poem":2},{"text":"wɔrekɔbɔ Babiloniahene amanneɛ se,","poem":1},{"text":"wɔafa ne kuropɔn no,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"wɔagye asutwabea ahorow a ɛdeda asubɔnten no ano no afa,","poem":1},{"text":"na wɔde ogya ato ɔwora no mu,","poem":2},{"lineBreak":true},{"text":"na asraafo no abɔ huboa.”","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Sɛɛ na Asafo Awurade, Israel Nyankopɔn, se:","poem":1},{"lineBreak":true},{"text":"“Babilonia Babea ayɛ sɛ, awiporowbea","poem":1},{"text":"wɔ bere a wɔretiatia hɔ.","poem":2},{"lineBreak":true},{"text":"Aka kakraa bi, na bere a ɛsɛ sɛ wotwa no sɛ nnɔbae no adu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Babiloniahene Nebukadnessar adwerɛw yɛn,","poem":1},{"text":"ɔde yɛn ato ɔhaw mu,","poem":2},{"lineBreak":true},{"text":"wayɛ yɛn sɛ ahina a hwee nni mu.","poem":2},{"text":"Wamene yɛn sɛ ɔwɔ no","poem":1},{"text":"na ɔde yɛn nneɛma a ɛyɛ dɛ ahyɛ ne yafunu ma,","poem":2},{"lineBreak":true},{"text":"na wapuw yɛn afi nʼanom agu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ma ayakayakade a wɔde dii yɛn honam no mmra Babilonia so,”","poem":1},{"text":"nnipa a wɔtete Sion na wɔka.","poem":2},{"text":"“Ma yɛn mogya ngu wɔn a wɔtete Babilonia so,”","poem":1},{"text":"Yerusalem na ɔka.","poem":2}]},{"type":"verse","number":36,"content":["Enti sɛɛ na Awurade se:",{"text":"“Hwɛ, medi mo asɛm ama mo","poem":1},{"text":"na matɔ were ama mo;","poem":2},{"text":"Mɛma po a ɛyɛ ne de no ayow","poem":1},{"text":"na mama ne nsubɔnten ayoyow.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Babilonia bɛyɛ mmubui siw,","poem":1},{"text":"sakraman atu","poem":2},{"text":"ahodwiriwde ne fɛwdi,","poem":1},{"text":"baabi a obiara nte.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ne nkurɔfo nyinaa bobɔ mu sɛ gyata,","poem":1},{"text":"wɔbobɔ mu te sɛ gyatamma.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Nanso bere a wɔahwanyan wɔn ho no,","poem":1},{"text":"mɛto pon ama wɔn","poem":2},{"lineBreak":true},{"text":"na mama wɔabobow nsa,","poem":2},{"text":"sɛnea wɔde nteɛteɛmu bedi ahurusi,","poem":1},{"text":"na wɔadeda a wɔrennyan bio,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“Mede wɔn bɛba","poem":1},{"text":"te sɛ nguantenmma a wɔrekokum wɔn,","poem":2},{"lineBreak":true},{"text":"te sɛ adwennini ne mpapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Sɛnea wɔbɛfa Sesak,","poem":1},{"text":"wɔbɛfa asase nyinaa so ahohoahoa!","poem":2},{"text":"Babilonia bɛyɛ ahodwiriwde","poem":1},{"text":"wɔ amanaman no mu!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Po bebunkam afa Babilonia so;","poem":1},{"text":"na nʼasorɔkye bɛkata ne so.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ne nkurow bɛda mpan,","poem":1},{"text":"nweatam a so awo,","poem":2},{"text":"asase a obiara nte so,","poem":1},{"text":"na obiara ntu kwan mfa so.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Mɛtwe Bel aso wɔ Babilonia","poem":1},{"text":"na mama wapuw nea wamene agu.","poem":2},{"text":"Amanaman no rento santen nkɔ ne nkyɛn bio.","poem":1},{"text":"Na Babilonia fasu bebubu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Me nkurɔfo, mumfi ne mu!","poem":1},{"text":"Muntu mmirika mpere mo nkwa!","poem":2},{"lineBreak":true},{"text":"Munguan mfi Awurade abufuwhyew ano.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Mommma mo koma ntu na munnsuro","poem":1},{"text":"sɛ mote huhuhuhu wɔ asase no so a;","poem":2},{"text":"huhuhuhu ba afe yi na foforo ba afe a ɛbɛba,","poem":1},{"text":"basabasayɛ ho huhuhuhu wɔ asase no so","poem":2},{"lineBreak":true},{"text":"ɛfa ɔhene a ɔsɔre tia ɔfoforo ho.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Na ampa ara bere no bɛba","poem":1},{"text":"a mɛtwe Babilonia ahoni aso;","poem":2},{"text":"nʼasase no nyinaa anim begu ase","poem":1},{"text":"na nʼatɔfo nyinaa bɛtotɔ ase wɔ ne so.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ɔsoro ne asase ne nea ɛwɔ mu nyinaa","poem":1},{"text":"de ahosɛpɛw bɛteɛ mu agu Babilonia so,","poem":2},{"text":"efisɛ ɔsɛefo befi atifi fam","poem":1},{"text":"abɛtow ahyɛ ne so,”","poem":2},{"lineBreak":true},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Ɛsɛ sɛ Babilonia hwe ase, esiane Israel atɔfo nti","poem":1},{"text":"sɛnea atɔfo a wɔwɔ wiase nyinaa ahwehwe ase","poem":2},{"lineBreak":true},{"text":"esiane Babilonia nti no.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Mo a mo aguan afi afoa ano,","poem":1},{"text":"monkɔ, na monntwentwɛn mo nan ase!","poem":2},{"text":"Monkae Awurade wɔ akyirikyiri asase so,","poem":1},{"text":"na munnwen Yerusalem ho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Wɔagu yɛn anim ase,","poem":1},{"text":"efisɛ wayeyaw yɛn","poem":2},{"lineBreak":true},{"text":"na fɛre akata yɛn anim,","poem":2},{"text":"efisɛ ananafo ahyɛn","poem":1},{"text":"Awurade fi kronkronbea ahorow hɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“Nanso nna bi reba,” Awurade na ose,","poem":1},{"text":"“a mɛtwe nʼahoni aso,","poem":2},{"text":"na nʼasase so nyinaa","poem":1},{"text":"apirafo besi apini.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Sɛ Babilonia kɔka soro mpo,","poem":1},{"text":"na omiamia nʼaban tenten bammɔ mu a,","poem":2},{"text":"mɛsoma ɔsɛefo ne no abedi asi,”","poem":1},{"text":"Awurade na ose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Osu nnyigyei bi fi Babilonia,","poem":1},{"text":"ɔsɛe kɛse bi nnyigyei","poem":2},{"lineBreak":true},{"text":"fi Babiloniafo asase so.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Awurade bɛsɛe Babilonia;","poem":1},{"text":"ɔbɛma nʼasotuatua nnyigyei no agyae.","poem":2},{"text":"Atamfo a wɔte sɛ ahum betu sɛ nsu akɛse;","poem":1},{"text":"wɔn mmubomu bɛyɛ gyegyeegye.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ɔsɛefo bi bɛsɔre atia Babilonia;","poem":1},{"text":"wɔbɛfa ne dɔmmarima nnommum","poem":2},{"lineBreak":true},{"text":"na wobebubu wɔn tadua mu.","poem":2},{"text":"Efisɛ Awurade yɛ Onyankopɔn a ɔhyɛ anan mu;","poem":1},{"text":"obetua so ka pɛpɛɛpɛ.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Mɛma nʼadwumayɛfo ne nʼanyansafo abow nsa","poem":1},{"text":"nʼamradonom, ne mpanyimfo ne dɔmmarima nso saa ara;","poem":2},{"text":"wɔbɛdeda afebɔɔ a wɔrennyan,”","poem":1},{"text":"sɛɛ na ɔhempɔn a ne din ne Asafo Awurade, no se.","poem":2}]},{"type":"verse","number":58,"content":["Sɛɛ na Asafo Awurade, se:",{"text":"“Wobedwiriw Babilonia afasu a ɛtrɛw no agu fam","poem":1},{"text":"na wɔbɛto nʼapon atenten no mu gya;","poem":2},{"text":"nnipa no haw wɔn ho kwa,","poem":1},{"text":"ɔman no adwumayɛ ma ogya no dɛw mmom.”","poem":2}]},{"type":"verse","number":59,"content":["Eyi ne asɛm a Yeremia ka kyerɛɛ Neria babarima Seraia a ɔyɛ adwumayɛfo panyin na ɔyɛ Maseia nena no, bere a ɔne Yudahene Sedekia kɔɔ Babilonia wɔ nʼadedi afe a ɛto so anan no mu."]},{"type":"verse","number":60,"content":["Na Yeremia akyerɛw amanehunu a ɛbɛba Babilonia so no nyinaa agu nhoma mmobɔwee so, nea wakyerɛw a ɛfa Babilonia ho nyinaa."]},{"type":"verse","number":61,"content":["Ɔka kyerɛɛ Seraia se, “Sɛ wudu Babilonia a, hwɛ sɛ wobɛkenkan saa nsɛm yi nyinaa sɛnea obiara bɛte."]},{"type":"verse","number":62,"content":["Afei ka se, ‘Awurade, woaka se wobɛsɛe beae yi sɛnea onipa anaa aboa biara rentumi ntena so; na ɛbɛda mpan afebɔɔ.’"]},{"type":"verse","number":63,"content":["Sɛ wokenkan nhoma mmobɔwee yi wie a, kyekyere fam ɔbo ho, na tow kyene Asubɔnten Eufrate mu."]},{"type":"verse","number":64,"content":["Afei ka se, ‘Sɛɛ na Babilonia ne ne nkurɔfo bɛmem a wɔrensɔre bio, esiane amanehunu a mede bɛba ne so no nti.’ ” Yeremia nsɛm no awiei ni."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}