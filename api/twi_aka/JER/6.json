{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Atamfo Atwa Yerusalem Ho Ahyia"]},{"type":"verse","number":1,"content":[{"text":"“Benyaminfo, munguan nkɔbɔ mo ho aguaa!","poem":1},{"text":"Munguan mfi Yerusalem!","poem":2},{"text":"Monhyɛn torobɛnto no wɔ Tekoa!","poem":1},{"text":"Munsi frankaa no wɔ Bet-Hakerem!","poem":2},{"text":"Efisɛ amanehunu bobɔw fi atifi fam,","poem":1},{"text":"ɔsɛe bi a ɛyɛ hu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛsɛe Ɔbabea Sion,","poem":1},{"text":"ɔhoɔfɛfo sɔɔnɔ no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nguanhwɛfo ne wɔn nguankuw bɛba abetia no;","poem":1},{"text":"wobesisi wɔn ntamadan atwa ne ho ahyia,","poem":2},{"lineBreak":true},{"text":"wɔn mu biara bɛhwɛ ne kyɛfa so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Munsiesie mo ho ne no nkɔko!","poem":1},{"text":"Monsɔre, momma yɛnkɔtow nhyɛ ne so owigyinae!","poem":2},{"text":"Nanso hwɛ, onwini redwo,","poem":1},{"text":"na anwummere sunsuma reware.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti monsɔre, momma yɛnkɔtow nhyɛ ne so anadwo","poem":1},{"text":"na yɛnsɛe nʼaban ahorow!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Nea Asafo Awurade se ni:",{"text":"“Muntwitwa nnua no ngu fam","poem":1},{"text":"na muntwa Yerusalem ho dantaban.","poem":2},{"text":"Ɛsɛ sɛ wɔtwe kuropɔn yi aso;","poem":1},{"text":"nhyɛso ahyɛ no ma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sɛnea abura puw ne nsu no,","poem":1},{"text":"saa ara na opuw nʼamumɔyɛ.","poem":2},{"text":"Wɔte awurukasɛm ne ɔsɛe nka wɔ ne mu;","poem":1},{"text":"ne yare ne nʼapirakuru wɔ mʼanim daa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fa kɔkɔbɔ, Yerusalem,","poem":1},{"text":"anyɛ saa metwe me ho afi wo ho","poem":2},{"text":"na mama wʼasase ada mpan","poem":1},{"text":"a obiara ntumi ntena so.”","poem":2}]},{"type":"verse","number":9,"content":["Nea Asafo Awurade se ni:",{"text":"“Ma wonyiyi Israel nkae no mu yiye","poem":1},{"text":"sɛnea woyiyi bobe mu yiye no;","poem":2},{"text":"fa wo nsa fa mman no so bio,","poem":1},{"text":"sɛ obi a ɔretetew bobe aba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hena na metumi akasa akyerɛ no na mabɔ no kɔkɔ?","poem":1},{"text":"Hena na obetie me?","poem":2},{"text":"Wɔn aso asisiw","poem":1},{"text":"enti wɔnte asɛm.","poem":2},{"text":"Awurade asɛm yɛ akyiwade ma wɔn,","poem":1},{"text":"na wɔn ani nnye ho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanso Awurade abufuwhyew ahyɛ me ma,","poem":1},{"text":"na mintumi nkora so.","poem":2},{"lineBreak":true},{"text":"“Hwie gu mmofra a wɔwɔ mmɔnten so","poem":1},{"text":"ne mmerante a wɔahyia;","poem":2},{"text":"ɛbɛka okunu ne ɔyere,","poem":1},{"text":"mmasiriwa, wɔn a onyin ahunhuan wɔn no so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔbɛdan wɔn afi ama afoforo,","poem":1},{"text":"wɔn mfuw ne wɔn yerenom bɛka ho;","poem":2},{"text":"sɛ meteɛ me nsa","poem":1},{"text":"wɔ wɔn a wɔte asase no so a,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Efi akumaa so kosi ɔkɛse so,","poem":1},{"text":"wɔn nyinaa yɛ adifudepɛfo de pɛ ahonya;","poem":2},{"text":"adiyifo ne asɔfo te saa,","poem":1},{"text":"wɔn nyinaa yɛ asisifo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wɔtoto me nkurɔfo apirakuru","poem":1},{"text":"te sɛnea ɛnyɛ hu.","poem":2},{"text":"Wɔka se, ‘Asomdwoe, asomdwoe’","poem":1},{"text":"wɔ mmere a asomdwoe nni hɔ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wɔn ani wu wɔ wɔn animguase nneyɛe no ho ana?","poem":1},{"text":"Dabi da, wɔn ani nnwu koraa;","poem":2},{"lineBreak":true},{"text":"wonnim fɛre mpo.","poem":2},{"text":"Enti wɔbɛtotɔ wɔ atɔfo mu;","poem":1},{"text":"wɔbɛhwehwe ase, sɛ metwe wɔn aso a,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]},{"type":"verse","number":16,"content":["Eyi ne nea Awurade se,",{"text":"“Munnyina nkwantanan no so na monhwɛ;","poem":1},{"text":"mummisa tete akwan no,","poem":2},{"text":"mummisa faako a ɔkwan pa no da na monnantew so,","poem":1},{"text":"na mubenya home ama mo akra.","poem":2},{"lineBreak":true},{"text":"Nanso mokae se, ‘yɛnnantew so.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mede awɛmfo sisii mo so na mekae se,","poem":1},{"text":"‘Muntie torobɛnto nnyigyei no!’","poem":2},{"text":"Nanso mokae se, ‘Yɛrentie.’","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɛno nti monyɛ aso, mo amanaman;","poem":1},{"text":"mo a moyɛ nnansefo, monhwɛ,","poem":2},{"lineBreak":true},{"text":"monhwɛ nea ɛbɛto wɔn.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tie, wo asase:","poem":1},{"text":"Mede amanehunu reba saa nnipa yi so,","poem":2},{"lineBreak":true},{"text":"wɔn nneyɛe so aba,","poem":2},{"text":"efisɛ wɔantie me nsɛm","poem":1},{"text":"na wɔapo me mmara.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nnuhuam a efi Seba","poem":1},{"text":"anaa ahwerew pa a efi akyirikyiri asase so fa me ho bɛn?","poem":2},{"text":"Minnye wo hyew afɔre no nto mu,","poem":1},{"text":"wʼafɔrebɔ ahorow no nsɔ mʼani.”","poem":2}]},{"type":"verse","number":21,"content":["Ɛno nti, nea Awurade se ni:",{"text":"“Mede akwanside begu saa nkurɔfo yi anim.","poem":1},{"text":"Agyanom ne mmabarima nyinaa behintiw wɔ so;","poem":2},{"lineBreak":true},{"text":"yɔnkonom ne nnamfonom bɛyera.”","poem":2}]},{"type":"verse","number":22,"content":["Sɛnea Awurade se ni:",{"text":"“Monhwɛ, nsraadɔm bi reba,","poem":1},{"text":"wofi atifi fam asase so;","poem":2},{"text":"wɔrehwanyan wɔn","poem":1},{"text":"afi nsase ano.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wokurakura bɛmma ne mpeaw;","poem":1},{"text":"wɔn tirim yɛ den, na wonni ahummɔbɔ.","poem":2},{"text":"Wɔn nnyigyei te sɛ po asorɔkye.","poem":1},{"text":"Sɛ wɔtete wɔn apɔnkɔ so a,","poem":2},{"text":"wɔba te sɛ mmarima a wɔrekɔ ɔko.","poem":1},{"text":"Wɔrebɛtow ahyɛ wo so, Ɔbabea Sion.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yɛate wɔn ho nsɛm,","poem":1},{"text":"na yɛn nsa sesa yɛn ho sɛ nea awuwu.","poem":2},{"text":"Awerɛhow akyekyere yɛn","poem":1},{"text":"yɛte yaw sɛ ɔbea a ɔreko awo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mfi adi nkɔ wuram","poem":1},{"text":"na nnantew akwan no so,","poem":2},{"text":"efisɛ ɔtamfo no wɔ afoa,","poem":1},{"text":"na baabiara ayɛ hu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Me nkurɔfo, mumfura atweaatam","poem":1},{"text":"na mommunummunum wɔ nsõ mu,","poem":2},{"text":"momfa adwadwotwa yaayaw nni awerɛhow","poem":1},{"text":"sɛnea wosu ma ɔbabarima koro,","poem":2},{"text":"efisɛ ɔsɛefo no","poem":1},{"text":"bɛba yɛn so mpofirim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Mayɛ wo obi a ɔsɔ agude hwɛ","poem":1},{"text":"na me nkurɔfo dadeben,","poem":2},{"text":"a wobɛhwɛ","poem":1},{"text":"na woasɔ wɔn akwan ahwɛ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wɔn nyinaa yɛ atuatewfo a wɔyɛ den,","poem":1},{"text":"wɔnenam di nseku.","poem":2},{"text":"Wɔyɛ kɔbere ne dade;","poem":1},{"text":"wɔn nyinaa yɛ wɔn ade wɔ porɔwee kwan so.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Afa no bɔ mframa dennen","poem":1},{"text":"de ogya nan sumpii no,","poem":2},{"text":"nanso ɔnan no yɛ ɔkwa.","poem":1},{"text":"Entumi nyiyii bɔne no mfii wɔn mu ɛ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Wɔfrɛ wɔn dwetɛ a wɔapo,","poem":1},{"text":"efisɛ Awurade apo wɔn.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}