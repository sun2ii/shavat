{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_aka","name":"Yeremia","commonName":"Yeremia","title":"Odiyifo Yeremia Nhoma","order":24,"numberOfChapters":52,"sha256":"008c5d9532493e7cae40387b857dc0a4726ac23c24e20fd5b4c0ab57038031ed","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_aka/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘Saa bere no, sɛnea Awurade se ni, wobeyiyi Yuda ahemfo ne adwumayɛfo nnompe, asɔfo ne adiyifo nnompe ne Yerusalemfo nnompe afi wɔn nna mu."]},{"type":"verse","number":2,"content":["Wɔbɛsɛw no kɛtɛ wɔ owia ne ɔsram ne ɔsorosoro nsoromma nyinaa a wɔdɔe, na wɔsomee, na wodii akyi kɔɔ so abisa na wɔsɔree no ase. Wɔremmoa wɔn ano na wɔrensie wɔn; mmom, wɔbɛyɛ sɛ sumina a egugu fam."]},{"type":"verse","number":3,"content":["Baabiara a metwa saa ɔman bɔne yi nkae no asu akɔ no, wɔbɛpɛ sɛ wobewu sen sɛ wɔbɛtena nkwa mu, sɛnea Asafo Awurade se ni.’"]},{"type":"heading","content":["Bɔne Ne Asotwe"]},{"type":"verse","number":4,"content":["“Ka kyerɛ wɔn se, ‘Nea Awurade se ni:",{"text":"“ ‘Sɛ nnipa hwe ase a, wɔnsɔre ana?","poem":1},{"text":"Sɛ onipa dan ne ho a, ɔnsan nʼakyi ana?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afei adɛn nti na saa nnipa yi adan wɔn ho?","poem":1},{"text":"Adɛn nti na Yerusalem dan ne ho daa yi?","poem":2},{"text":"Wokura nnaadaa mu pintinn;","poem":1},{"text":"na wɔmpɛ sɛ wɔsan wɔn akyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mawɛn mʼaso atie,","poem":1},{"text":"nanso wɔnnka nea ɛteɛ.","poem":2},{"text":"Wɔn mu biara nnu ne ho wɔ nʼamumɔyɛ ho,","poem":1},{"text":"na ɔka se, “Dɛn na mayɛ?”","poem":2},{"text":"Obiara fa ne kwan","poem":1},{"text":"te sɛ ɔpɔnkɔ a ɔrepem akɔ akono.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mpo aturukuku a ɔwɔ wim","poem":1},{"text":"nim ne mmere a wɔahyehyɛ ama no,","poem":2},{"text":"na asukɔnkɔn, asomfena ne agyenkuku","poem":1},{"text":"hu bere a wotu kɔtena baabi,","poem":2},{"text":"nanso me nkurɔfo nnim","poem":1},{"text":"nea Awurade hwehwɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Adɛn na mutumi ka se, “Yenim nyansa,","poem":1},{"text":"efisɛ yɛwɔ Awurade mmara,”","poem":2},{"text":"wɔ bere a akyerɛwfo kyerɛwdua torofo","poem":1},{"text":"de atoro adannan mu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anyansafo no anim begu ase;","poem":1},{"text":"wɔn ho bedwiriw wɔn na afide ayi wɔn.","poem":2},{"text":"Sɛ wɔapo Awurade asɛm no a,","poem":1},{"text":"na nyansa bɛn na wɔwɔ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mede wɔn yerenom bɛma mmarima afoforo","poem":1},{"text":"ne wɔn mfuw nso ama afoforo.","poem":2},{"text":"Efi akumaa so kosi ɔkɛse so,","poem":1},{"text":"wɔn nyinaa yɛ adifudepɛfo de pɛ ahonya;","poem":2},{"text":"adiyifo ne asɔfo te saa,","poem":1},{"text":"wɔn nyinaa yɛ asisifo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔtoto me nkurɔfo apirakuru","poem":1},{"text":"te sɛnea ɛnyɛ hu.","poem":2},{"text":"Wɔka se, “Asomdwoe, asomdwoe”","poem":1},{"text":"wɔ mmere a asomdwoe nni hɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔn ani wu wɔ wɔn animguase nneyɛe no ho ana?","poem":1},{"text":"Dabi da, wɔn ani nnwu koraa;","poem":2},{"text":"wonnim fɛre mpo.","poem":1},{"text":"Enti wɔbɛtotɔ wɔ atɔfo mu;","poem":2},{"text":"wɔbɛhwehwe ase, sɛ metwe wɔn aso a,","poem":1},{"text":"sɛnea Awurade se ni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Mɛfa wɔn twabere nnɔbae akɔ,","poem":1},{"text":"nea Awurade se ni.","poem":2},{"lineBreak":true},{"text":"Aba biara remma bobe nnua no so.","poem":2},{"text":"Aba biara remma borɔdɔma nnua no so,","poem":1},{"text":"ɛso nhaban begunguan.","poem":2},{"text":"Nea mede ama wɔn no,","poem":1},{"text":"wobegye afi wɔn nsam.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Adɛn nti na yɛtete ha?","poem":1},{"text":"Mommoaboa mo ho ano!","poem":2},{"text":"Momma yenguan nkɔ nkuropɔn a ɛwɔ bammɔ mu","poem":1},{"text":"na yenkowuwu wɔ hɔ!","poem":2},{"text":"efisɛ Awurade yɛn Nyankopɔn abu yɛn kumfɔ","poem":1},{"text":"na wama yɛn nsu a awuduru wɔ mu sɛ yɛnnom,","poem":2},{"lineBreak":true},{"text":"efisɛ yɛayɛ bɔne atia no.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yɛhwɛɛ kwan sɛ yebenya asomdwoe","poem":1},{"text":"nanso biribi pa biara amfi mu amma,","poem":2},{"text":"yɛhwɛɛ ayaresabere kwan","poem":1},{"text":"nanso ehu nko ara na ɛkaa yɛn.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔte atamfo no apɔnkɔ home","poem":1},{"text":"fii Dan;","poem":2},{"text":"na wɔn apɔnkɔnini su","poem":1},{"text":"ma asase no nyinaa wosow.","poem":2},{"text":"Wɔaba sɛ wɔrebɛsɛe","poem":1},{"text":"asase no ne so nneɛma nyinaa,","poem":2},{"lineBreak":true},{"text":"kuropɔn no ne wɔn a wɔtete mu nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Hwɛ, mɛsoma awɔ a wɔn ano wɔ bɔre aba mo mu,","poem":1},{"text":"nhurutoa a wontumi nnwudwo wɔn,","poem":2},{"text":"na wɔbɛkeka mo,”","poem":1},{"text":"nea Awurade se ni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wone mʼawerɛhow mu Werɛkyekyefo,","poem":1},{"text":"me koma abotow wɔ me mu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tie me nkurɔfo sufrɛ;","poem":1},{"text":"a efi akyirikyiri asase so:","poem":2},{"text":"“Awurade nni Sion ana?","poem":1},{"text":"Ne Hene no nni hɔ bio ana?”","poem":2},{"lineBreak":true},{"text":"“Adɛn nti na wɔde wɔn nsɛsode ahyɛ me abufuw,","poem":1},{"text":"wɔn ananafo ahoni huhuw no?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Otwabere no atwa mu,","poem":1},{"text":"ahuhuru bere no aba awiei,","poem":2},{"lineBreak":true},{"text":"na wonnnyee yɛn nkwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sɛ wɔadwerɛw me nkurɔfo no nti, wɔadwerɛw me;","poem":1},{"text":"midi awerɛhow, na ahodwiriw akyekyere me.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Aduru bi nni Gilead ana?","poem":1},{"text":"Ɔyaresafo bi nni hɔ ana?","poem":2},{"text":"Na afei adɛn nti na ayaresa nni hɔ","poem":1},{"text":"mma me nkurɔfo apirakuru?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}