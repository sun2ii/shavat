{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JOB","translationId":"twi_aka","name":"Hiob","commonName":"Hiob","title":"Hiob Nhoma","order":18,"numberOfChapters":42,"sha256":"907f297bf31c59b22a502662f214cd579ad0d10c69ed9088823afd5f69d988cf","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/twi_aka/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Hiob Kyerɛ Nyankopɔn Kɛseyɛ"]},{"type":"verse","number":1,"content":["Na Hiob kasaa bio se,"]},{"type":"verse","number":2,"content":[{"text":"“Woaboa nea onni tumi!","poem":1},{"text":"Woagye basa a enni ahoɔden!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woatu nea onnim nyansa fo!","poem":1},{"text":"Na woada nhumu pa ara adi!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hena na ɔboaa wo ma wokaa saa nsɛm yi?","poem":1},{"text":"Hena honhom na ɛkasa faa wo mu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Awufo wɔ ahoyeraw kɛse mu,","poem":1},{"text":"wɔn a wɔwɔ nsu ase ne nea ɛte mu nyinaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asaman da adagyaw Onyankopɔn anim;","poem":1},{"text":"Ɔsɛe nso nni nkataso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔtrɛw wim atifi fam kata nea ɛda mpan so;","poem":1},{"text":"na ɔde asase sensɛn ohunu so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔbɔ nsu boa hyɛ ne omununkum mu,","poem":1},{"text":"nanso nsu no mu duru ntumi mpae no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔtrɛw ne omununkum mu","poem":1},{"text":"de kata ɔsram ani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɔhyɛ agyirae wɔ nsu so","poem":1},{"text":"de to ɔhye wɔ hann ne sum ntam.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɔsoro nnyinaso wosow,","poem":1},{"text":"na nʼanimka ma wɔn ho dwiriw wɔn.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔde ne tumi wosow po","poem":1},{"text":"ne nyansa mu, otwitwaa Rahab mu asinasin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ɔde ne home maa wim tewee;","poem":1},{"text":"na ne nsa wɔɔ ɔwɔ a ɔrewea.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eyinom yɛ ne nnwuma kakraa bi;","poem":1},{"text":"ne tumi kakraa bi kɛkɛ!","poem":2},{"lineBreak":true},{"text":"Na hena na obetumi ate ne tumi mmubomu no ase?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}