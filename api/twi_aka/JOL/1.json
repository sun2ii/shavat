{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JOL","translationId":"twi_aka","name":"Yoɛl","commonName":"Yoɛl","title":"Odiyifo Yoɛl Nhoma","order":29,"numberOfChapters":3,"sha256":"5e3c2ea4cc0018a3c2daa63d20475416c4205060b36bb9f8a4850dfb001a922f","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Awurade asɛm a ɛbaa Petuel babarima Yoel so ni."]},{"type":"heading","content":["Mmoadabi San Tue"]},{"type":"verse","number":2,"content":[{"text":"Muntie saa asɛm yi, mo mpanyimfo;","poem":1},{"text":"muntie, mo a mote asase no so nyinaa.","poem":2},{"text":"Asɛm bi a ɛte sɛɛ asi mo mmere so","poem":1},{"text":"anaa mo mpanyimfo mmere so pɛn?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monka nkyerɛ mo mma,","poem":1},{"text":"na mo mma nso nka nkyerɛ wɔn mma","poem":2},{"lineBreak":true},{"text":"na wɔn mma nso nka nkyerɛ awo ntoatoaso a edi so no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nea mmoadabikuw no gyawee no,","poem":1},{"text":"mmoadabi akɛse no awe;","poem":2},{"text":"nea mmoadabi akɛse no gyawee no,","poem":1},{"text":"mmoadabi nkumaa no awe;","poem":2},{"text":"nea mmoadabi nkumaa no gyawee no,","poem":1},{"text":"mmoadabi afoforo awe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mo asabowfo, munnyan, na munsu!","poem":1},{"text":"Mo a monom bobesa nyinaa, muntwa adwo;","poem":2},{"text":"muntwa adwo, nsa foforo no nti,","poem":1},{"text":"efisɛ wɔahuam afi mo ano.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔman bi atu mʼasase so sa;","poem":1},{"text":"dɔm a wɔyɛ den na wontumi nkan wɔn;","poem":2},{"text":"wɔn se te sɛ gyata se","poem":1},{"text":"na wɔwɔ gyatabere sebɔmmɔfo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wasɛe me bobe","poem":1},{"text":"ne me borɔdɔma nnua.","poem":2},{"text":"Wawaawae nnua no ho bona,","poem":1},{"text":"atow agu","poem":2},{"lineBreak":true},{"text":"agyaw ne mman ho fitaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Di awerɛhow sɛ ababaa a ofura atweaatam","poem":1},{"text":"na ɔresu ne kunu a ɔwaree no ne mmabaabere mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aduan ne ahwiesa afɔrebɔde,","poem":1},{"text":"wɔayi afi Awurade fi.","poem":2},{"text":"Asɔfo no retwa adwo,","poem":1},{"text":"wɔn a wɔsom wɔ Awurade anim no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mfuw asɛe,","poem":1},{"text":"asase no so awo wosee","poem":2},{"text":"aduan no asɛe","poem":1},{"text":"nsa foforo no ayow","poem":2},{"lineBreak":true},{"text":"ngo nyinaa asa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mo ani nwu, mo akuafo,","poem":1},{"text":"muntwa adwo, mo a mudua bobe;","poem":2},{"text":"Munsi apini mma awi ne atoko,","poem":1},{"text":"efisɛ otwabere no asɛe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bobe no akisa","poem":1},{"text":"na borɔdɔma nnua no awuwu.","poem":2},{"text":"Atoaa nnua, mmedua, aprɛ ne","poem":1},{"text":"nnua a ɛwɔ mfuw no so nyinaa ahyew.","poem":2},{"text":"Nokware, anigye a nnipa wɔ no","poem":1},{"text":"atu ayera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mumfura atweaatam na munni awerɛhow, asɔfo;","poem":1},{"text":"mo a mosom wɔ afɔremuka anim, muntwa adwo.","poem":2},{"text":"Mumfura atweaatam mmesi pɛ,","poem":1},{"text":"mo a mosom wɔ Onyankopɔn anim;","poem":2},{"text":"efisɛ aduan ne ahwiesa afɔrebɔde no","poem":1},{"text":"to atwa wɔ Onyankopɔn fi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mommɔ mmuadadi kronkron ho dawuru;","poem":1},{"text":"momfrɛ nhyiamu kronkron.","poem":2},{"text":"Momfrɛ mpanyimfo","poem":1},{"text":"ne wɔn a wɔte asase no so nyinaa","poem":2},{"text":"mmra Awurade mo Nyankopɔn fi","poem":1},{"text":"na wommesu mfrɛ Awurade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"A, da no de!","poem":1},{"text":"Awurade da no abɛn;","poem":2},{"lineBreak":true},{"text":"Ɛbɛba sɛ ɔsɛe a efi Otumfo hɔ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"So aduan ho nkɔɔ wɛn, a yɛani tua,","poem":1},{"text":"anigye ne ahosɛpɛw to atwa","poem":2},{"lineBreak":true},{"text":"wɔ yɛn Nyankopɔn fi ana?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aba no wu wɔ asase wosee mu,","poem":1},{"text":"adekoradan abubu,","poem":2},{"text":"aburowpata nso so nni mfaso,","poem":1},{"text":"efisɛ nnuan no ahyew.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sɛnea anantwi su!","poem":1},{"text":"na anantwikuw kyinkyin kwa.","poem":2},{"text":"Nguankuw mpo rebrɛ","poem":1},{"text":"efisɛ wonni didibea.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Awurade, wo na misu frɛ wo,","poem":1},{"text":"efisɛ ogya ahyew sare so adidibea,","poem":2},{"lineBreak":true},{"text":"na ogyatannaa ahyew mfuw no so nnua nyinaa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wuram mmoa mpo pere hwehwɛ wo.","poem":1},{"text":"Nsuwansuwa ayoyow,","poem":2},{"lineBreak":true},{"text":"na ogya ahyew sare so adidibea.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}