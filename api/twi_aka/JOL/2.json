{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JOL","translationId":"twi_aka","name":"Yoɛl","commonName":"Yoɛl","title":"Odiyifo Yoɛl Nhoma","order":29,"numberOfChapters":3,"sha256":"5e3c2ea4cc0018a3c2daa63d20475416c4205060b36bb9f8a4850dfb001a922f","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Mmoadabi Dɔm"]},{"type":"verse","number":1,"content":[{"text":"Hyɛn torobɛnto no wɔ Sion;","poem":1},{"text":"hyɛn abɛn no wɔ me bepɔw kronkron no so.","poem":2},{"text":"Ma wɔn a wɔte asase no so nyinaa ho mpopo,","poem":1},{"text":"efisɛ Awurade da no reba,","poem":2},{"lineBreak":true},{"text":"na abɛn koraa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sum ne kusukuukuu da.","poem":1},{"noteId":0},{"text":"Omununkum ne sum kabii da.","poem":2},{"text":"Sɛnea adekyee hann trɛtrɛw wɔ mmepɔw so no,","poem":1},{"text":"saa ara na asraafo a wɔdɔɔso na wɔyɛ den ba no te.","poem":2},{"text":"Wonhuu wɔn sɛso bi da,","poem":1},{"text":"na wɔrenhu ne sɛso nso da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ogya rehyew wɔ wɔn anim,","poem":1},{"text":"ogyatannaa dɛw wɔ wɔn akyi,","poem":2},{"text":"asase a ɛda wɔn anim no te sɛ Eden turo,","poem":1},{"text":"nea ɛda wɔn akyi no te sɛ nweatam,","poem":2},{"lineBreak":true},{"text":"hwee nguan wɔn.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔte sɛ apɔnkɔ.","poem":1},{"text":"Wohuruhuruw te sɛ apɔnkɔsotefo asraafo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔyɛ gyegyeegye te sɛ nteaseɛnam","poem":1},{"text":"na wotu fa mmepɔw atifi,","poem":2},{"text":"wɔte sɛ ogyatannaa a ɛhyew nwuraguanee","poem":1},{"text":"wɔte sɛ asraafo akantinka a wɔrekɔ ɔsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aman ani bɔ wɔn so a, ehu bɔ wɔn;","poem":1},{"text":"na wɔn anim hoa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔko kɔ wɔn anim te sɛ akofo;","poem":1},{"text":"wɔforo afasu te sɛ asraafo","poem":2},{"text":"na wɔn nyinaa kɔ wɔn anim tee,","poem":1},{"text":"na wɔmman benkum anaa nifa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wontwintwan wɔn ho wɔn ho anan mu;","poem":1},{"text":"obiara nantew kɔ nʼanim tee.","poem":2},{"text":"Wobu fa abandennen so,","poem":1},{"text":"na wɔpem kɔ wɔn anim ara.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔtow hyɛ kuropɔn no so","poem":1},{"text":"wotu mmirika fa afasu no so","poem":2},{"text":"wɔforo kɔ afi mu,","poem":1},{"text":"wɔfa mfɛnsere mu te sɛ akorɔmfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Asase wosow wɔ wɔn anim,","poem":1},{"text":"na ɔsoro hinhim.","poem":2},{"text":"Owia ne ɔsram duru sum,","poem":1},{"text":"na nsoromma nhyerɛn bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade bobɔ mu","poem":1},{"text":"de di nʼasraafo no anim.","poem":2},{"text":"Nʼakofo no dɔɔso bebree,","poem":1},{"text":"ahoɔdenfo ne wɔn a wodi nʼahyɛde so.","poem":2},{"text":"Awurade da no yɛ kɛse na ɛyɛ hu;","poem":1},{"text":"hena na obetumi agyina ano?","poem":2}]},{"type":"heading","content":["Ahonu"]},{"type":"verse","number":12,"content":[{"text":"“Na afei,” sɛnea Awurade se ni,","poem":1},{"text":"“San fa wo koma nyinaa bra me nkyɛn,","poem":2},{"lineBreak":true},{"text":"wɔ akɔnkyen, osu ne awerɛhow mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sunsuan wo koma","poem":1},{"text":"na ɛnyɛ wo ntade mu.","poem":2},{"text":"San bra Awurade wo Nyankopɔn nkyɛn,","poem":1},{"text":"efisɛ, ɔyɛ ɔdomfo, ne yam ye.","poem":2},{"text":"Ne bo kyɛ fuw na ne dɔ boro so,","poem":1},{"text":"na ɛnyɛ no anigye sɛ ɔtwe yɛn aso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hena na onim? Ebia ɔbɛsesa nʼadwene na wahu mmɔbɔ","poem":1},{"text":"na wagyaw nhyira,","poem":2},{"text":"a ɛyɛ aduan ne ahwiesa afɔrebɔde","poem":1},{"text":"a mode ma Awurade mo Nyankopɔn no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hyɛn torobɛnto wɔ Sion!","poem":1},{"text":"Mommɔ akɔnkyen kronkron ho dawuru,","poem":2},{"text":"momfrɛ nhyiamu kronkron.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mommoaboa nnipa no ano","poem":1},{"text":"montew nhyiamu no ho na ɛnyɛ kronkron;","poem":2},{"text":"mommoaboa mpanyimfo,","poem":1},{"text":"mmofra ne mmea a wɔrema nufu ano.","poem":2},{"lineBreak":true},{"text":"Ma ayeforo ne ayeforokunu mfi wɔn pia mu mmra.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Asɔfo a wɔsom wɔ Awurade anim no,","poem":1},{"text":"nsu wɔ afɔremuka no ne abrannaa no ntam;","poem":2},{"text":"na wɔnka se, “Awurade fa wo nkurɔfo ho kyɛ wɔn.","poem":1},{"text":"Mma wʼagyapade nyɛ ahohorade","poem":2},{"lineBreak":true},{"text":"anaa fɛwdi wɔ aman no mu.","poem":2},{"text":"Adɛn nti na ɛsɛ sɛ wubisa wɔ nnipa no mu se,","poem":1},{"text":"‘Wɔn Nyame no wɔ he?’ ”","poem":2}]},{"type":"heading","content":["Awurade Mmuae"]},{"type":"verse","number":18,"content":[{"text":"Na Awurade bɛtwe ninkunu wɔ nʼasase ho","poem":1},{"text":"na ne nkurɔfo ayɛ no mmɔbɔ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Awurade bebua se,","poem":1},{"text":"“Merebrɛ mo aduan, nsa foforo ne ngo,","poem":2},{"text":"a ɛbɛso mo ama moamee pintinn.","poem":1},{"text":"Merenyɛ mo ahohorade","poem":2},{"lineBreak":true},{"text":"mma aman no bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mɛpam atifi fam asraafo no afi wo nkyɛn akɔ akyirikyiri,","poem":1},{"text":"mepia wɔn akɔ asase a awo na ɛyɛ kesee so.","poem":2},{"text":"Nifa dɔm no bɛmem wɔ Nkyene Po no mu,","poem":1},{"text":"na kyidɔm no bɛmem wɔ Ntam Po no mu.","poem":2},{"text":"Na afunu no bɛbɔn","poem":1},{"text":"na ne nka betu.”","poem":2},{"lineBreak":true},{"text":"Nokware wayɛ nneɛma akɛse!","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Munnsuro, me nkurɔfo!","poem":2},{"lineBreak":true},{"text":"Momma mo ani nnye, na monsɛpɛw mo ho.","poem":2},{"text":"Nokware Awurade ayɛ nneɛma akɛse.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Munnsuro, mo wuram mmoa!","poem":2},{"lineBreak":true},{"text":"Efisɛ sare so adidibea reyɛ frɔmfrɔm.","poem":2},{"text":"Nnua no resow wɔn aba;","poem":1},{"text":"borɔdɔma ne bobe nso resow wɔn aba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Momma mo ani nnye, mo Sion mma,","poem":1},{"text":"Munni ahurusi wɔ Awurade mo Nyankopɔn mu,","poem":2},{"text":"efisɛ watɔ asusowsu ama mo,","poem":1},{"text":"ne nokwaredi nti.","poem":2},{"text":"Watɔ osu bebree ama mo","poem":1},{"text":"wɔ ne bere mu te sɛ kan no.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Aduan bɛyɛ awiporowbea hɔ ma,","poem":1},{"text":"nsa foforo ne ngo bebu so wɔ kyi amoa mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Mɛhyɛ mo anan mu,","poem":1},{"text":"nea mohweree","poem":2},{"lineBreak":true},{"text":"mfe dodow a mmoadabi bɛsɛee mo nneɛma,","poem":2},{"text":"mmoadabi akɛse ne nkumaa,","poem":1},{"text":"ne wɔn a aka no nyinaa,","poem":2},{"lineBreak":true},{"text":"me dɔm a mesomaa wɔn baa mo so no.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mubedidi amee,","poem":1},{"text":"na mubeyi Awurade mo Nyankopɔn din ayɛ.","poem":2},{"text":"Ɔno na wayɛ anwonwade ama mo;","poem":1},{"text":"me nkurɔfo ani renwu bio.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Afei, mubehu sɛ, mewɔ Israel,","poem":1},{"text":"mubehu sɛ mene Awurade, mo Nyankopɔn,","poem":2},{"text":"na obiara nni hɔ sɛ me;","poem":1},{"text":"Me nkurɔfo ani renwu bio da.”","poem":2}]},{"type":"heading","content":["Awurade Da"]},{"type":"verse","number":28,"content":[{"text":"“Na akyiri no,","poem":1},{"text":"mehwie me honhom agu nnipa nyinaa so,","poem":2},{"text":"mo mmabarima ne mo mmabea bɛhyɛ nkɔm,","poem":1},{"text":"mo nkwakoraa bɛsoso adae,","poem":2},{"text":"mo mmerante benya anisoadehu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Saa mmere no mu no,","poem":1},{"text":"mehwie me Honhom agu","poem":2},{"text":"mʼasomfo so, mmarima ne mmea.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Mɛyɛ anwonwade wɔ ɔsoro ne asase so,","poem":1},{"text":"mede mogya, ogya ne wusiw kumɔnn.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ansa na Awurade da kɛse no bɛba no, owia beduru sum na ɔsram nso ayɛ sɛ mogya.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Na obiara a ɔbɔ Awurade din no,","poem":1},{"text":"wobegye no nkwa.","poem":2},{"text":"Efisɛ nkwagye bɛba","poem":1},{"text":"ama wɔn a wɔanya wɔn ti adidi mu","poem":2},{"lineBreak":true},{"text":"a Awurade afrɛ wɔn","poem":2},{"lineBreak":true},{"text":"wɔ Sion bepɔw so ne Yerusalem nyinaa,”","poem":2},{"text":"sɛnea Awurade aka no.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.2 Sum…da. Sum yɛ daa daa adiyisɛm a wɔka fa Awurade da no ho. (Amos 5.18; Sef 1.15).","reference":{"chapter":2,"verse":2}}]},"thisChapterLink":"/api/twi_aka/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}