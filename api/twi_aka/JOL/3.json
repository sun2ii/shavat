{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JOL","translationId":"twi_aka","name":"Yoɛl","commonName":"Yoɛl","title":"Odiyifo Yoɛl Nhoma","order":29,"numberOfChapters":3,"sha256":"5e3c2ea4cc0018a3c2daa63d20475416c4205060b36bb9f8a4850dfb001a922f","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Aman No Atemmu"]},{"type":"verse","number":1,"content":[{"text":"“Saa nna no mu,","poem":1},{"text":"mede Yuda ne Yerusalem ahonyade bɛsan aba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛboa aman nyinaa ano,","poem":1},{"text":"na mede wɔn aba Yehosafat bon mu.","poem":2},{"text":"Ɛhɔ na mebu wɔn atɛn","poem":1},{"text":"wɔ nea wɔyɛɛ mʼagyapade, a ɛyɛ Israelfo ho,","poem":2},{"text":"efisɛ wɔbɔɔ me nkurɔfo hwetee aman so,","poem":1},{"text":"na wɔkyekyɛɛ mʼasase mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔbɔɔ me nkurɔfo so ntonto,","poem":1},{"text":"Wɔtɔn mmerantewa de mu sika bɔɔ aguaman.","poem":2},{"text":"Wɔtɔn mmeawa nso de gyee nsa,","poem":1},{"text":"a wɔbɛnom.","poem":2}]},{"type":"verse","number":4,"content":["“Dɛn na mowɔ tia me, Tiro ne Sidon ne mo Filisti amantam nyinaa? Mopɛ sɛ motɔ me so were ana? Sɛ saa na ɛte de a, monhwɛ yiye. Mɛyɛ ntɛm, atua mo biribiara a moayɛ no so ka."]},{"type":"verse","number":5,"content":["Mofaa me dwetɛ ne me sikakɔkɔɔ ne mʼagyapade a ɛsom bo, na mosoa koguu mo abosonnan mu."]},{"type":"verse","number":6,"content":["Motontɔn nnipa a wɔte Yuda ne Yerusalem maa Helafo",{"noteId":1},"sɛnea ɛbɛyɛ a, wobefi wɔn asase so akɔ akyirikyiri."]},{"type":"verse","number":7,"content":["“Nanso, mɛsan de wɔn afi faako a mokɔtɔn wɔn no aba, na nea moayɛ no nyinaa, metua mo so ka."]},{"type":"verse","number":8,"content":["Mɛtontɔn mo mmabarima ne mo mmabea ama Yudafo, na wɔn nso atɔn wɔn ama Arabfo, ɔman a ɛwɔ akyirikyiri no.” Me, Awurade, na makasa."]},{"type":"verse","number":9,"content":[{"text":"Mompae mu nka eyi wɔ aman so:","poem":1},{"text":"Munsiesie mo ho mma ɔko!","poem":2},{"text":"Monkanyan asraafo!","poem":1},{"text":"Momma mo mmarima akofo no ntwiw mmra, na wɔmmɛko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Momfa mo funtumnnade no mmɔ afoa,","poem":1},{"text":"na momfa mo asosɔw mmɔ mpeaw.","poem":2},{"text":"Ma nea wɔayɛ mmerɛw nka se,","poem":1},{"text":"“mewɔ ahoɔden!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Monyɛ ntɛm mmra,","poem":1},{"text":"mo amanaman a moatwa ahyia,","poem":2},{"text":"mommɛboa mo ho ano wɔ hɔ.","poem":1},{"lineBreak":true},{"text":"Fa wʼakofo bra, Awurade!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Wɔnkanyan aman no;","poem":1},{"text":"wontu nteɛ nkɔ Yehosafat bon no mu,","poem":2},{"text":"efisɛ ɛhɔ na mɛtena","poem":1},{"text":"na mabu aman a atwa ahyia no nyinaa atɛn.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Munhwim kantankrankyi no,","poem":1},{"text":"efisɛ otwabere no adu so.","poem":2},{"text":"Mommra, muntiatia bobe no so,","poem":1},{"text":"efisɛ nsakyiamoa no ayɛ ma","poem":2},{"text":"na ahina no ayɛ ma abu so.","poem":1},{"text":"Saa ara na wɔn amumɔyɛ dɔɔso!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nnipadɔm, nnipadɔm","poem":1},{"text":"wɔ gyinaesi subon no mu!","poem":2},{"text":"Awurade da no abɛn","poem":1},{"text":"wɔ gyinaesi subon no mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Owia ne ɔsram beduru sum,","poem":1},{"text":"na nsoromma renhyerɛn bio.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Awurade bɛbobɔ mu afi Sion,","poem":1},{"text":"ne nne gyegyeegye afi Yerusalem,","poem":2},{"lineBreak":true},{"text":"asase ne ɔsoro bɛwosow.","poem":2},{"text":"Nanso Awurade bɛyɛ guankɔbea ama ne nkurɔfo,","poem":1},{"text":"ɔbɛyɛ abandennen ama Israelfo.","poem":2}]},{"type":"heading","content":["Onyankopɔn Nkurɔfo Nhyira"]},{"type":"verse","number":17,"content":[{"text":"“Afei mubehu sɛ, me Awurade, mo Nyankopɔn,","poem":1},{"text":"mete Sion, me bepɔw kronkron so.","poem":2},{"text":"Yerusalem bɛyɛ kronkron;","poem":1},{"text":"na ananafo rentu wɔn so sa bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Saa da no, nsa foforo bɛsosɔ afi mmepɔw no mu,","poem":1},{"text":"na nufusu ateɛ wɔ nkoko so;","poem":2},{"text":"Nsu bɛba Yuda nsuwansuwa mu,","poem":1},{"text":"na asuti betue afi Awurade fi,","poem":2},{"lineBreak":true},{"text":"na agugu akasia subon no so nsu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nanso Misraim bɛdan amamfo,","poem":1},{"text":"na Edom nso bɛyɛ nweatam,","poem":2},{"text":"esiane awurukasɛm a wɔyɛ de tiaa nnipa a wɔwɔ Yuda nti.","poem":1},{"text":"Ɛhɔ na wohwiee mogya a enni fɔ gui.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nnipa bɛtena Yuda afebɔɔ","poem":1},{"text":"na Yerusalem de, wɔbɛtena hɔ awo ntoatoaso nyinaa mu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"So merentɔ wɔn mogya a edi bem no so were ana?","poem":1},{"text":"Mɛtɔ kɛ.”","poem":2},"Awurade te Sion!"]}],"footnotes":[{"noteId":1,"caller":"+","text":"3.6 Helafo ne Foenikefo dii gua fi afe 800 AWA.","reference":{"chapter":3,"verse":6}}]},"thisChapterLink":"/api/twi_aka/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}