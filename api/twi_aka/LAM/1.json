{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_aka","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"7b494f912f17c8f89268983dbb8f54f2680d7fb89866bf0399763261cf38db18","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_aka/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Sɛnea kuropɔn no adan amamfo ni,","poem":1},{"text":"kuropɔn a anka nnipa ahyɛ no ma!","poem":2},{"text":"Adɛn nti na wayɛ okunafobea a","poem":1},{"text":"kan no na anka ɔyɛ ɔkɛse wɔ amanaman no mu?","poem":2},{"text":"Nea na ɔyɛ ɔhemmea wɔ amantam no mu no","poem":1},{"text":"abɛyɛ afenaa nnɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Osu yayaayaw anadwo,","poem":1},{"text":"nusu sensan nʼafono so.","poem":2},{"text":"Nʼadɔfo nyinaa mu no,","poem":1},{"text":"obiara nni hɔ a ɔkyekyee ne werɛ.","poem":2},{"text":"Ne nnamfonom nyinaa ayi no ama","poem":1},{"text":"Wɔayɛ nʼatamfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amanehunu ne adwumaden akyi no,","poem":1},{"text":"Yuda kɔ nnommum mu.","poem":2},{"text":"Ɔte amanaman no mu","poem":1},{"text":"na onni ahomegyebea.","poem":2},{"text":"Wɔn a wɔtaa no nyinaa ato no","poem":1},{"text":"wɔ nʼahokyere mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akwan a ɛkɔ Sion no resu,","poem":1},{"text":"efisɛ obiara nkɔ nʼafahyɛ ase.","poem":2},{"text":"Nʼapon nyinaa adeda mpan,","poem":1},{"text":"na nʼasɔfo si apini,","poem":2},{"text":"ne mmabaa di yaw,","poem":1},{"text":"na ɔwɔ yawdi a mu yɛ den mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nʼatamfo abɛyɛ ne wuranom;","poem":1},{"text":"wɔn a wɔne no ayɛ adɔm ho adwo wɔn.","poem":2},{"text":"Awurade ama awerɛhow aba ne so","poem":1},{"text":"nʼamumɔyɛ bebrebe nti.","poem":2},{"text":"Ne mma kɔ nnommum mu.","poem":1},{"text":"Wɔayɛ nneduafo ama ɔtamfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anuonyam nyinaa atu","poem":1},{"text":"afi Ɔbabea Sion so kɔ.","poem":2},{"text":"Ne mmapɔmma ayɛ sɛ aforote","poem":1},{"text":"a wonnya adidibea;","poem":2},{"text":"na wɔde mmerɛwyɛ aguan","poem":1},{"text":"wɔ wɔn ataafo anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nʼamanehunu ne akyinkyinakyinkyin nna mu no,","poem":1},{"text":"Yerusalem kae ademude nyinaa","poem":2},{"lineBreak":true},{"text":"a na ɛwɔ no wɔ nna a atwa mu no mu.","poem":2},{"text":"Ne nkurɔfo kɔtɔɔ ɔtamfo no nsa mu no,","poem":1},{"text":"na obiara nni hɔ a ɔbɛboa no.","poem":2},{"text":"Nʼatamfo de wɔn ani hwɛɛ no","poem":1},{"text":"na wɔserew ne sɛe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalem ayɛ bɔne kɛse","poem":1},{"text":"enti ne ho agu fi.","poem":2},{"text":"Wɔn a wodi no ni no sopa no,","poem":1},{"text":"efisɛ wɔahu nʼadagyaw;","poem":2},{"text":"ɔno ankasa gu ahome","poem":1},{"text":"na ɔdan nʼani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nʼafideyɛ atu aka ne ntade mu;","poem":1},{"text":"wannwene ne daakye ho.","poem":2},{"text":"Nʼasehwe yɛ nwonwa;","poem":1},{"text":"obiara ankyekye ne werɛ.","poem":2},{"text":"“Awurade, hwɛ mʼamanehunu,","poem":1},{"text":"efisɛ ɔtamfo adi nkonim.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔtamfo no de ne nsa too","poem":1},{"text":"nʼademude nyinaa so;","poem":2},{"text":"ohuu sɛ amanaman","poem":1},{"text":"rehyɛn ne kronkronbea hɔ,","poem":2},{"text":"nnipa a woabra sɛ","poem":1},{"text":"wɔnnhyɛn wʼasafo mu no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ne nkurɔfo nyinaa si apini","poem":1},{"text":"bere a wɔrehwehwɛ aduan;","poem":2},{"text":"wɔde wɔn ademude sesa aduan","poem":1},{"text":"de nya ahoɔden.","poem":2},{"text":"“Awurade, hwɛ na dwene me ho,","poem":1},{"text":"efisɛ wobu me animtiaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ɛmfa mo ho ana, mo a mutwa mu wɔ hɔ nyinaa?","poem":1},{"text":"Monhwɛ na munhu.","poem":2},{"text":"Ɔyaw bi wɔ hɔ a ɛte sɛ me de","poem":1},{"text":"a wɔma ɛbaa me so yi,","poem":2},{"text":"nea Awurade de baa me so","poem":1},{"text":"wɔ nʼabufuwhyew da no ana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ɔsomaa ogya fii ɔsoro,","poem":1},{"text":"ma ɛbaa me nnompe mu.","poem":2},{"text":"Osum afiri maa mʼanan","poem":1},{"text":"na ɔsan me kɔɔ mʼakyi.","poem":2},{"text":"Ɔyɛɛ me pasaa,","poem":1},{"text":"metɔɔ beraw da mu nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Woakyekyere me bɔne ahyɛ konnua mu;","poem":1},{"text":"ɔde ne nsa nwen bɔɔ mu.","poem":2},{"text":"Wɔde asɛn me kɔn mu","poem":1},{"text":"na Awurade atwe mʼahoɔden.","poem":2},{"text":"Ɔde me ahyɛ wɔn a","poem":1},{"text":"merentumi nnyina wɔn anim no nsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Awurade apo","poem":1},{"text":"akofo a wɔwɔ me ntam nyinaa;","poem":2},{"text":"wafrɛ asraafo atia me","poem":1},{"text":"sɛ wɔmmɛdwerɛw me mmerante.","poem":2},{"text":"Awurade atiatia Ɔbabea Ɔbabun Yuda so","poem":1},{"text":"wɔ ne nsakyiamoa mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Eyinom nti na misu","poem":1},{"text":"na nusu aguare me.","poem":2},{"text":"Obiara mmɛn a ɔbɛkyekye me werɛ,","poem":1},{"text":"nea ɔbɛhyɛ me honhom den nni hɔ.","poem":2},{"text":"Me mma agyigya","poem":1},{"text":"efisɛ ɔtamfo no adi nkonim.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sion trɛw ne nsa mu","poem":1},{"text":"nanso obiara nni hɔ a ɔbɛkyekye ne werɛ.","poem":2},{"text":"Awurade ahyɛ ama Yakob se","poem":1},{"text":"ne mfɛfo bɛyɛ nʼatamfo;","poem":2},{"text":"Yerusalem abɛyɛ","poem":1},{"text":"afide wɔ wɔn mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Awurade yɛ ɔtreneeni,","poem":1},{"text":"nanso manni nʼahyɛde so.","poem":2},{"text":"Muntie, mo amanaman nyinaa","poem":1},{"text":"monhwɛ me yaw.","poem":2},{"text":"Me mmerante ne mmabaa","poem":1},{"text":"kɔ nnommum mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Mefrɛɛ mʼadɔfo","poem":1},{"text":"nanso woyii me mae.","poem":2},{"text":"Mʼasɔfo ne me mpanyimfo","poem":1},{"text":"ase tɔree wɔ kuropɔn no mu,","poem":2},{"text":"bere a wɔrehwehwɛ aduan adi","poem":1},{"text":"na wɔanwuwu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Awurade, hwɛ me mmɔbɔ!","poem":1},{"text":"Meredi yaw wɔ me mu,","poem":2},{"text":"na me koma mu nso minni ahotɔ,","poem":1},{"text":"efisɛ mayɛ otuatewfo kɛse.","poem":2},{"text":"Afoa hyɛ me awerɛhow wɔ abɔnten so;","poem":1},{"text":"ofie nso yɛ owu nko ara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nnipa ate mʼapinisi,","poem":1},{"text":"nanso obiara nni hɔ a ɔbɛkyekye me werɛ.","poem":2},{"text":"Mʼatamfo nyinaa ate mʼamanehunu","poem":1},{"text":"wɔn ani gye nea woayɛ no ho.","poem":2},{"text":"Ma nna a woahyɛ no mmra","poem":1},{"text":"sɛnea wɔbɛyɛ sɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Fa wɔn atirimɔdensɛm nyinaa si wʼanim;","poem":1},{"text":"na wo ne wɔn nni","poem":2},{"text":"sɛnea wo ne me adi;","poem":1},{"text":"esiane mʼamumɔyɛ no nti.","poem":2},{"text":"Mʼapinisi dɔɔso","poem":1},{"text":"na me koma abotow.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}