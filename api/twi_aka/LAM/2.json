{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_aka","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"7b494f912f17c8f89268983dbb8f54f2680d7fb89866bf0399763261cf38db18","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_aka/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Sɛnea Awurade de nʼabufuwhyew mununkum","poem":1},{"text":"akata Ɔbabea Sion so ni?","poem":2},{"text":"Watow Israel anuonyam","poem":1},{"text":"afi ɔsoro abɛhwe fam;","poem":2},{"text":"wankae ne nan ntiaso","poem":1},{"text":"wɔ nʼabufuw da no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade annya ahummɔbɔ","poem":1},{"text":"na wamene Yakob atenae nyinaa;","poem":2},{"text":"nʼabufuwhyew mu, wadwiriw","poem":1},{"text":"Yuda Babea abandennen no agu fam.","poem":2},{"text":"Wagu nʼahenni ne ne mmapɔmma","poem":1},{"text":"ho fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɔde abufuwhyew atwitwa","poem":1},{"text":"Israel mmɛn nyinaa.","poem":2},{"text":"Wayi ne bammɔ","poem":1},{"text":"wɔ bere a atamfo no reba.","poem":2},{"text":"Wasɔ wɔ Yakob mu sɛ ogyatannaa","poem":1},{"text":"a ɛhyew biribiara a atwa ho ahyia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wapema ne bɛmma sɛ ɔtamfo;","poem":1},{"text":"ne nsa nifa ayɛ krado.","poem":2},{"text":"Te sɛ ɔtamfo no, wakunkum","poem":1},{"text":"wɔn a wɔyɛ fɛ wɔ ani so nyinaa;","poem":2},{"text":"wahwie nʼabufuwhyew sɛ ogya","poem":1},{"text":"agu Ɔbabea Sion ntamadan so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade ayɛ sɛ ɔtamfo;","poem":1},{"text":"wamene Israel.","poem":2},{"text":"Wamene nʼahemfi nyinaa","poem":1},{"text":"asɛe nʼabandennen.","poem":2},{"text":"Wama awerɛhowdi ne agyaadwotwa adɔɔso","poem":1},{"text":"ama Yuda Babea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wama nʼatenae ada mpan sɛ turo;","poem":1},{"text":"wasɛe nʼaguabɔbea.","poem":2},{"text":"Awurade ama Sion werɛ afi","poem":1},{"text":"nʼafahyɛ ne homenna;","poem":2},{"text":"nʼabufuwhyew mu no","poem":1},{"text":"wabu ɔhene ne ɔsɔfo animtiaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade apo nʼafɔremuka","poem":1},{"text":"na wagyaa ne kronkronbea mu.","poem":2},{"text":"Ɔde nʼahemfi afasu","poem":1},{"text":"ahyɛ nʼatamfo nsa.","poem":2},{"text":"Wɔteɛ mu wɔ Awurade fi","poem":1},{"text":"te sɛ afahyɛ da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade sii nʼadwene pi sɛ ɔbɛsɛe","poem":1},{"text":"Ɔbabea Sion fasu a atwa ne ho ahyia no.","poem":2},{"text":"Ɔde susuhama too ho","poem":1},{"text":"na wannyae ɔsɛe no.","poem":2},{"text":"Ɔmaa pie ne afasu dii abooboo;","poem":1},{"text":"wɔn nyinaa sɛee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nʼapon amem fam;","poem":1},{"text":"wɔn adaban nso, wabubu mu asɛe no.","poem":2},{"text":"Ne hene ne ne mmapɔmma, watwa wɔn asu kɔ amanaman no mu,","poem":1},{"text":"mmara nni hɔ bio,","poem":2},{"text":"na nʼadiyifo nnya anisoadehu a","poem":1},{"text":"efi Awurade hɔ bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔbabea Sion mpanyimfo","poem":1},{"text":"tete fam ayɛ komm;","poem":2},{"text":"wɔde mfutuma agu wɔn tirim","poem":1},{"text":"afurafura atweaatam.","poem":2},{"text":"Yerusalem mmabaa","poem":1},{"text":"asisi wɔn ti ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mʼani rentumi nnyae nisutew,","poem":1},{"text":"me yafunu mu retwa me,","poem":2},{"text":"me koma retew atɔ fam,","poem":1},{"text":"efisɛ wɔasɛe me nkurɔfo,","poem":2},{"text":"efisɛ mmofra ne mmotafowa totɔ piti","poem":1},{"text":"wɔ kuropɔn no mmɔnten so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wobisa wɔn nanom se,","poem":1},{"text":"“Ɛhe na brodo ne nsa wɔ?”","poem":2},{"text":"Bere a wɔtotɔ beraw sɛ apirafo","poem":1},{"text":"wɔ kuropɔn no mmɔnten so,","poem":2},{"text":"bere a wɔn nkwa resa","poem":1},{"text":"wɔ wɔn nanom abasa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Asɛm bɛn na metumi aka ama wo?","poem":1},{"text":"Dɛn ho na metumi de wo atoto,","poem":2},{"text":"Ɔbabea Yerusalem?","poem":1},{"text":"Dɛn na metumi de asusuw wo,","poem":2},{"text":"de akyekye wo werɛ,","poem":1},{"text":"Sion Babea Ɔbabun?","poem":2},{"text":"Wʼapirakuru so sɛ po.","poem":1},{"text":"Hena na obetumi asa wo yare?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wʼadiyifo anisoadehu","poem":1},{"text":"yɛ atoro a so nni mfaso;","poem":2},{"text":"wɔanna mo amumɔyɛ adi","poem":1},{"text":"ansiw mo nnommumfa ano.","poem":2},{"text":"Nkɔmhyɛ a wɔde maa mo no","poem":1},{"text":"yɛ atoro ne nnaadaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wɔn a wotwa mu wo kwan so nyinaa","poem":1},{"text":"bobɔ wɔn nsam gu wo so;","poem":2},{"text":"wodi wo ho fɛw na wɔwosow wɔn ti","poem":1},{"text":"gu Yerusalem Babea so ka se,","poem":2},{"text":"“Eyi ne kuropɔn a na wɔfrɛ no","poem":1},{"text":"ahoɔfɛ a edi mu no?","poem":2},{"lineBreak":true},{"text":"Asase nyinaa anigyede no ni?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wʼatamfo nyinaa baa wɔn anom","poem":1},{"text":"tɛtrɛɛ tia wo;","poem":2},{"text":"wɔserew na wɔtwɛre wɔn se","poem":1},{"text":"na wɔka se, “Yɛamene no.","poem":2},{"text":"Da a na yɛretwɛn no ni;","poem":1},{"text":"Yɛatena ase ahu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Awurade ayɛ nea ɔhyehyɛe;","poem":1},{"text":"wama nʼasɛm a","poem":2},{"text":"ɔhyɛɛ dedaada no aba mu.","poem":1},{"lineBreak":true},{"text":"Watu wo agu a wanhu wo mmɔbɔ,","poem":1},{"text":"wama ɔtamfo no ani agye","poem":2},{"lineBreak":true},{"text":"wama wʼatamfo no mmɛn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nnipa no koma","poem":1},{"text":"su frɛ Awurade.","poem":2},{"text":"Ɔbabea Sion afasu,","poem":1},{"text":"momma mo nusu nsen sɛ asubɔnten","poem":2},{"lineBreak":true},{"text":"awia ne anadwo;","poem":2},{"text":"munnye mo ahome","poem":1},{"text":"momma mo ani nso nnya ɔhome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sɔre, su dennen anadwo,","poem":1},{"text":"ɔdasu mu mfiase;","poem":2},{"text":"hwie wo koma mu nsɛm sɛ nsu","poem":1},{"text":"gu Awurade anim.","poem":2},{"text":"Ma wo nsa so kyerɛ no","poem":1},{"text":"wo mma nkwa nti,","poem":2},{"text":"wɔn a ɔkɔm ama wɔatotɔ beraw","poem":1},{"text":"wɔ mmɔnten so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Hwɛ na dwene ho, Awurade:","poem":1},{"text":"Hena na wode no afa saa ɔkwan yi so pɛn?","poem":2},{"text":"Ɛsɛ sɛ mmea we wɔn yafunumma nam ana,","poem":1},{"text":"mma a wɔahwɛ wɔn?","poem":2},{"text":"Ɛsɛ sɛ wokunkum ɔsɔfo ne odiyifo","poem":1},{"text":"wɔ Awurade kronkronbea ana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mmofra ne mpanyin da adabum","poem":1},{"text":"wɔ mmɔnten so mfutuma mu so,","poem":2},{"text":"me mmerante ne mmabaa","poem":1},{"text":"atotɔ wɔ afoa ano.","poem":2},{"text":"Woakum wɔn wɔ wʼabufuwda;","poem":1},{"text":"woayam wɔn na woannya ahummɔbɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Sɛnea wotoo wo nsa frɛ wɔ aponto da no,","poem":1},{"text":"saa ara na wofrɛfrɛɛ","poem":2},{"lineBreak":true},{"text":"amanehunu fii afanan nyinaa tiaa me.","poem":2},{"text":"Awurade abufuw da no,","poem":1},{"text":"obiara anguan na anka obiara:","poem":2},{"text":"wɔn a mehwɛɛ wɔn na metetew wɔn no,","poem":1},{"text":"me tamfo adwerɛw wɔn.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}