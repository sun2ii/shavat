{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_aka","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"7b494f912f17c8f89268983dbb8f54f2680d7fb89866bf0399763261cf38db18","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_aka/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Mene ɔbarima a mahu amane","poem":1},{"text":"wɔ nʼabufuw abaa ano.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wapam me afi ne ho ama manantew","poem":1},{"text":"sum mu na ɛnyɛ hann mu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ampa ara wama nsa so atia me","poem":1},{"text":"mpɛn bebree, da mu nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wama me were ne me nam anyin","poem":1},{"text":"Na wabubu me nnompe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waka me ahyɛ mu, na watua me ano","poem":1},{"text":"ɔde nweenwen ne ahokyere atwa me ho ahyia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wama matena sum mu","poem":1},{"text":"sɛ wɔn a wɔawuwu dedaw no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wato ɔfasu atwa me ho ahyia enti mintumi nguan;","poem":1},{"text":"wagu me nkɔnsɔnkɔnsɔn ama matɔ beraw.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mpo sɛ mefrɛ anaasɛ mebɔ mpae srɛ mmoa a","poem":1},{"text":"osiw me mpaebɔ ano.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔde abotan asiw me kwan;","poem":1},{"text":"wama mʼakwan ayɛ kɔntɔnkye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Te sɛ sisi a ɔda hɔ retwɛn,","poem":1},{"text":"te sɛ gyata a watɛw,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ɔtwee me fii ɔkwan no mu bebaree me","poem":1},{"text":"na ogyaw me a minni mmoa biara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Okuntun ne ta mu","poem":1},{"text":"na ɔde ne bɛmma kyerɛɛ me so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɔde bɛmma a efi ne kotoku mu","poem":1},{"text":"hwirew me koma mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Meyɛɛ akyiwade maa me nkurɔfo nyinaa;","poem":1},{"text":"wɔto akutia nnwom","poem":2},{"lineBreak":true},{"text":"de di me ho fɛw da mu nyinaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɔde nhaban nweenwen ahyɛ me ma.","poem":1},{"text":"Wama me bɔnwoma anom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔde mmosea abubu me se;","poem":1},{"text":"na watiatia me so wɔ mfutuma mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔama asomdwoe abɔ me;","poem":1},{"text":"na me werɛ afi yiyedi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enti mise, “Mʼanuonyam asa,","poem":1},{"text":"nea mede mʼani too so Awurade mu no nyinaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mekae mʼamanehunu wɔ mʼakyinkyinakyinkyin mu,","poem":1},{"text":"nweenwen ne bɔnwoma mu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mekae yiye,","poem":1},{"text":"na me kra abotow wɔ me mu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nanso midwen eyi ho;","poem":1},{"text":"saa nti mewɔ anidaso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Awurade dɔ kɛse nti yɛnsɛee ɛ.","poem":1},{"text":"Nʼayamhyehye nni huammɔ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ɛyɛ foforo anɔpa biara;","poem":1},{"text":"wo nokwaredi yɛ kɛse.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Meka kyerɛ me ho se,","poem":1},{"text":"“Awurade yɛ me kyɛfa, enti mɛtwɛn no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Awurade ye ma wɔn a wɔn anidaso wɔ ne mu,","poem":1},{"text":"onipa a ɔhwehwɛ no no;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Eye sɛ wɔyɛ komm","poem":1},{"text":"de twɛn Awurade nkwagye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Eye ma ɔbarima sɛ ɔsoa konnua no","poem":1},{"text":"wɔ ne mmerantebere mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ma ɔntena ase komm,","poem":1},{"text":"efisɛ Awurade de ato ne so.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ma ɔmfa nʼanim nsie wɔ mfutuma mu,","poem":1},{"text":"ebia anidaso wɔ hɔ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ma ɔmfa nʼafono mma nea ɔpɛɛ sɛ ɔbɔ no no","poem":1},{"text":"na ɔnhyɛ no aniwu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Na Awurade ntow onipa biara nkyene koraa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ɛwɔ mu, ɔde awerɛhow ba de, nanso obenya ayamhyehye.","poem":1},{"text":"Ne dɔ kɛse no to rentwa da.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ofi amemenemfe mu de amanehunu","poem":1},{"text":"anaa awerɛhow brɛ nnipa mma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Sɛ wɔde wɔn nan dwerɛw","poem":1},{"text":"nneduafo a wɔwɔ asase no so a,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"sɛ wotiatia obi ahofadi so","poem":1},{"text":"wɔ Ɔsorosoroni no anim a,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"anaa sɛ wobu obi ntɛnkyew a,","poem":1},{"text":"Awurade renhu saa nneɛma yi ana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Hena na obetumi aka na wama aba mu","poem":1},{"text":"wɔ bere a ɛnyɛ Awurade na ɔhyɛe?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ɛnyɛ Ɔsorosoroni no anom","poem":1},{"text":"na mmusu ne nnepa fi ana?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Adɛn nti na ɛsɛ sɛ ɔteasefo nwiinwii","poem":1},{"text":"bere a wɔatwe nʼaso wɔ ne bɔne ho?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Momma yɛnhwehwɛ yɛn akwan mu na yɛnsɔ nhwɛ,","poem":1},{"text":"na yɛnsan nkɔ Awurade nkyɛn.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Momma yɛmma yɛn koma ne yɛn nsa so,","poem":1},{"text":"nkyerɛ Onyankopɔn wɔ ɔsoro, na yɛnka se:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Yɛayɛ bɔne, na yɛatew atua","poem":1},{"text":"na wamfa ankyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Wode abufuw akata wo ho ataa yɛn;","poem":1},{"text":"na woakunkum a woannya ahummɔbɔ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Wode wo ho asie omununkum mu","poem":1},{"text":"nti mpaebɔ biara nnu wo nkyɛn.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Woayɛ yɛn atantanne ne nwura","poem":1},{"text":"wɔ amanaman no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Yɛn atamfo nyinaa abaa wɔn anom tɛtrɛɛ","poem":1},{"text":"de tia yɛn.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yɛabrɛ ne ahunahuna ne akukuruhwease,","poem":1},{"text":"mmubui ne ɔsɛe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Me nusu sen sɛ asuten","poem":1},{"text":"efisɛ wɔasɛe me nkurɔfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Me nusu bɛsen ara,","poem":1},{"text":"na ɛrennyae,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"kosi sɛ Awurade bɛhwɛ","poem":1},{"text":"afi ɔsoro, na wahu.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Nea mihu no ma me kra werɛ how,","poem":1},{"text":"me kuropɔn no mu mmea nyinaa nti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Mʼatamfo a menyɛɛ wɔn hwee","poem":1},{"text":"pampam me sɛ anomaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":53,"content":[{"text":"Wɔpɛɛ sɛ wotwa me nkwa so","poem":1},{"text":"na wosiw me abo wɔ amoa mu;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"nsu bu faa me ti so,","poem":1},{"text":"na ɛyɛɛ me sɛnea wɔrewie me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Mebɔɔ wo din, Awurade","poem":1},{"text":"fii amoa no ase tɔnn.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Wotee me sufrɛ: “Nsiw wʼaso","poem":1},{"text":"wɔ me gye sufrɛ ho.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Wutwiw bɛn me bere a mefrɛɛ wo no,","poem":1},{"text":"na wokae se, “Nsuro.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Wo Awurade, wudii mʼasɛm maa me;","poem":1},{"text":"na wugyee me nkwa.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Woahu bɔne a wɔayɛ me, Awurade.","poem":1},{"text":"Di mʼasɛm ma me!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Woahu wɔn aweretɔ no mu den,","poem":1},{"text":"wɔn pɔw a wɔbɔ tia me no nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Awurade, woate wɔn ntwirii,","poem":1},{"text":"wɔn pɔw a wɔbɔ tia me no nyinaa,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"nea mʼatamfo ka no asomsɛm na wɔka no brɛoo","poem":1},{"text":"de tia me da mu nyinaa.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Hwɛ wɔn! Sɛ wogyinagyina hɔ anaasɛ wɔtete hɔ,","poem":1},{"lineBreak":true},{"text":"wɔto akutia nnwom de di me ho fɛw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Fa nea ɛfata tua wɔn so ka, Awurade,","poem":1},{"text":"nea wɔn nsa ayɛ nti.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Pirim wɔn koma,","poem":1},{"text":"na ma wo nnome mmra wɔn so.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Fa abufuw taa wɔn, na sɛe wɔn","poem":1},{"text":"fi Awurade ɔsorosoro ase.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}