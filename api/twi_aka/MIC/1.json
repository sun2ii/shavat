{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_aka","name":"Mika","commonName":"Mika","title":"Odiyifo Mika Nhoma","order":33,"numberOfChapters":7,"sha256":"3321b6ffac8bc90ad2e603004230d7d547d10a1e8ae57672a07bbd95c1642095","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_aka/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Awurade de saa nsɛm yi brɛɛ Moresetni Mika",{"noteId":0},"bere a na Yotam, Ahas ne Hesekia di ade wɔ Yuda no. Anisoade a ohu faa Samaria ne Yerusalem ho."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Monyɛ aso, mo nnipa nyinaa,","poem":1},{"text":"muntie, asase ne mo a mote so nyinaa.","poem":2},{"text":"Otumfo Awurade redi adanse atia mo,","poem":1},{"text":"ɔkasa fi nʼasɔredan kronkron no mu.","poem":2}]},{"type":"heading","content":["Atemmu A Etia Samaria Ne Yerusalem"]},{"type":"verse","number":3,"content":[{"text":"Monhwɛ! Awurade fi nʼatenae reba;","poem":1},{"text":"ɔresian na ɔnam asase sorɔnsorɔmmea so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mmepɔw nan wɔ nʼase,","poem":1},{"text":"aku mu paapae","poem":2},{"text":"te sɛ ama a aka ogya,","poem":1},{"text":"te sɛ nsu a ɛresian waa fi koko so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eyi nyinaa yɛ Yakob nnebɔne,","poem":1},{"text":"ne bɔne ahorow a ɛwɔ Israel fi nti.","poem":2},{"text":"Yakob nnebɔne ne dɛn?","poem":1},{"text":"Ɛnyɛ Samaria ana?","poem":2},{"text":"Na he ne Yuda sorɔnsorɔmmea?","poem":1},{"text":"Ɛnyɛ Yerusalem ana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Enti mɛyɛ Samaria kurow no nnwiriwii siw,","poem":1},{"text":"baabi a wɔbɛyɛ bobe turo.","poem":2},{"text":"Mehwie nʼabo agu obon mu","poem":1},{"text":"ama ne fapem ho ada hɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wobebubu nʼahoni nyinaa mu asinasin;","poem":1},{"text":"wɔde ogya bɛhyew nʼasɔredan mu ayɛyɛde nyinaa.","poem":2},{"lineBreak":true},{"text":"Mɛsɛe ne nsɛsode nyinaa.","poem":2},{"text":"Esiane sɛ nʼakyɛde a waboa ano no nyinaa,","poem":1},{"text":"onya fii nguamanfo akatua mu no nti","poem":2},{"lineBreak":true},{"text":"wɔde bɛma nguamanfo.”","poem":2}]},{"type":"heading","content":["Osu Ne Awerɛhow"]},{"type":"verse","number":8,"content":[{"text":"Eyinom nti mesu atwa agyaadwo;","poem":1},{"text":"mede adagyaw bɛnantew na merenhyɛ mpaboa.","poem":2},{"text":"Mɛworo so sɛ odompo","poem":1},{"text":"na masu sɛ patu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nʼapirakuru no wu ayɛ den;","poem":1},{"text":"abedu Yuda.","poem":2},{"text":"Abedu me nkurɔfo pon ano","poem":1},{"text":"mpo adu Yerusalem ankasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Monnka no wɔ Gat","poem":1},{"text":"munnsu koraa","poem":2},{"text":"Mo a mowɔ Bet-Leafra de,","poem":1},{"text":"monyantam mfutuma mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Monsen nkɔ adagyaw ne aniwu mu,","poem":1},{"text":"mo a mote Safir.","poem":2},{"text":"Wɔn a wɔte Saanan ntumi mpue.","poem":1},{"text":"Bet-Esel wɔ awerɛhow mu;","poem":2},{"lineBreak":true},{"text":"efisɛ, wo hɔ na onya ne bammɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔn a wɔte Marot de ɔyaw nunununu wɔn mu","poem":1},{"text":"de twɛn mmoa,","poem":2},{"text":"efisɛ amanehunu a efi Awurade hɔ aba","poem":1},{"text":"abedu Yerusalem pon ano.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mo a mote Lakis,","poem":1},{"text":"munsiesie nteaseɛnam no.","poem":2},{"text":"Mone bɔne farebae","poem":1},{"text":"ma Ɔbabea Sion,","poem":2},{"text":"na mudii Israel anim kɔɔ bɔne mu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Enti mode ntetewmu akyɛde bɛma Moreset-Gat,","poem":1},{"text":"Aksib kurow bɛdaadaa Israel ahemfo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mede nkonimdifo bɛtoa mo;","poem":1},{"text":"mo a mote Maresa.","poem":2},{"text":"Nea ɔyɛ Israel onuonyamfo no","poem":1},{"text":"bɛba Adulam.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Munyi mo tinwi mfa nni awerɛhow,","poem":1},{"text":"wɔ mma a mo ani gye wɔn ho no ho;","poem":2},{"text":"mommɔ tikwaw te sɛ opete,","poem":1},{"text":"efisɛ, wɔbɛfa wɔn afi mo nkyɛn","poem":2},{"lineBreak":true},{"text":"akɔ nnommum mu.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 Mika nkyerɛase ne “Hena na ɔte sɛ Awurade,” a ɛfa Samaria ne Yerusalem ho: Saa nkuropɔn abien yi gyina hɔ ma Israel ne Yuda. Atemmu a Mika hyɛɛ ho nkɔm no fa aman abien no ho na ɛmfa wɔn nkuropɔn no nko ho.","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/twi_aka/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}