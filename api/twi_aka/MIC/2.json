{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_aka","name":"Mika","commonName":"Mika","title":"Odiyifo Mika Nhoma","order":33,"numberOfChapters":7,"sha256":"3321b6ffac8bc90ad2e603004230d7d547d10a1e8ae57672a07bbd95c1642095","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_aka/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Onipa Ne Onyankopɔn Nhyehyɛe"]},{"type":"verse","number":1,"content":[{"text":"Nnome nka wɔn a wɔfa amumɔyɛ ho adwene,","poem":1},{"text":"wɔn a wɔbɔ pɔw bɔne wɔ wɔn mpa so!","poem":2},{"text":"Wɔsɔre anɔpa kodi dwuma no,","poem":1},{"text":"efisɛ wɔwɔ tumi sɛ wɔyɛ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wɔn ani bere mfuw, na wogye.","poem":1},{"text":"Na afi nso wɔfa.","poem":2},{"text":"Wɔde nyansakorɔn gye nkurɔfo afi,","poem":1},{"text":"na wɔn agyapade nso wogye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti, sɛnea Awurade se ni,","poem":1},{"text":"“Meredwene amanehunu a etia saa nkurɔfo yi ho","poem":2},{"text":"na worentumi nyi wo ho mfi mu.","poem":1},{"text":"Worentumi nnantew ahantan so bio,","poem":2},{"lineBreak":true},{"text":"efisɛ ɛbɛyɛ bere bɔne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Saa da no, nnipa bɛserew mo.","poem":1},{"text":"Wɔde saa awerɛhow dwom yi","poem":2},{"text":"bedi mo ho fɛw se:","poem":1},{"text":"‘wɔasɛe yɛn koraa;","poem":2},{"text":"wɔakyekyɛ me nkurɔfo ahode mu.","poem":1},{"text":"Ogye fi me nsam!","poem":2},{"lineBreak":true},{"text":"Na ɔde yɛn mfuw ma akɔnkɔnsafo.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Enti morennya obi wɔ","poem":1},{"text":"Awurade asafo mu","poem":2},{"text":"a ɔde ntontobɔ bɛkyɛ asase no.","poem":1}]},{"type":"heading","content":["Atoro Adiyifo"]},{"type":"verse","number":6,"content":[{"text":"“Monnhyɛ nkɔm,” saa na wɔn nkɔmhyɛfo no ka.","poem":1},{"text":"“Monnhyɛ saa nneɛma yi ho nkɔm;","poem":2},{"lineBreak":true},{"text":"animguase rento yɛn.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mo Yakobfi, so wɔnka se,","poem":1},{"text":"“Awurade Honhom nni boasetɔ ana?","poem":2},{"lineBreak":true},{"text":"Ɔyɛ nneɛma a ɛte sɛɛ ana?","poem":2},{"lineBreak":true},{"text":"“Ne nsɛm nyɛ nea nʼakwan teɛ","poem":1},{"text":"no yiye ana?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akyiri no me nkurɔfo asɔre","poem":1},{"text":"te sɛ ɔtamfo.","poem":2},{"text":"Moworɔw ntade pa fi","poem":1},{"text":"wɔn a wɔretwa mu a ɛmfa mo ho,","poem":2},{"lineBreak":true},{"text":"ma wɔyɛ te sɛ asraafo a wofi akono.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mopam mmea a wɔwɔ me nkurɔfo mu","poem":1},{"text":"fi wɔn afi afɛɛfɛ mu.","poem":2},{"text":"Mugye me nhyira","poem":1},{"text":"fi wɔn mma nsam afebɔɔ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sɔre, fi ha kɔ!","poem":1},{"text":"Ha nyɛ faako a wɔhome,","poem":2},{"text":"efisɛ ho agu fi,","poem":1},{"text":"Wɔasɛe no, na ɛrenyɛ yiye bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sɛ ɔtorofo ne ɔdaadaafo ba bɛka se,","poem":1},{"text":"‘Mɛhyɛ nkɔm ama moanya nsa bebree a’","poem":2},{"lineBreak":true},{"text":"ɔbɛyɛ odiyifo a saa nkurɔfo yi pɛ.”","poem":2}]},{"type":"heading","content":["Ogye Ho Bɔhyɛ"]},{"type":"verse","number":12,"content":[{"text":"“Mɛboaboa mo nyinaa ano Yakob;","poem":1},{"text":"nokware mɛka Israel nkae no nyinaa abɔ mu.","poem":2},{"text":"Mɛka wɔn abɔ mu te sɛ nguan a wogu nguannan mu,","poem":1},{"text":"te sɛ nguankuw a wɔwɔ adidibea;","poem":2},{"lineBreak":true},{"text":"nnipa bɛhyɛ beae hɔ manyamanya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nea obue ɔkwan no bedi wɔn anim;","poem":1},{"text":"wobebu apon no na wɔafi akɔ.","poem":2},{"text":"Wɔn Hene no bɛsen adi wɔn anim,","poem":1},{"text":"Awurade bɛyɛ wɔn ti.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}