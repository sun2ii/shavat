{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_aka","name":"Mika","commonName":"Mika","title":"Odiyifo Mika Nhoma","order":33,"numberOfChapters":7,"sha256":"3321b6ffac8bc90ad2e603004230d7d547d10a1e8ae57672a07bbd95c1642095","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_aka/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Akannifo Ne Adiyifo Animka"]},{"type":"verse","number":1,"content":["Afei mekae se,",{"text":"“Muntie, mo Yakob akannifo,","poem":1},{"text":"mo a mudi Israelfi so.","poem":2},{"text":"Ɛsɛ sɛ muhu nea ɛyɛ atɛntrenee,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mo a mukyi nea eye na modɔ bɔne","poem":2},{"text":"moworɔw me nkurɔfo were","poem":1},{"text":"na motetew nam no fi wɔn nnompe ho;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mowe me nkurɔfo nam,","poem":1},{"text":"mowae wɔn were,","poem":2},{"lineBreak":true},{"text":"bubu wɔn nnompe mu nketenkete;","poem":2},{"text":"mutwitwa wɔn sɛ nam a","poem":1},{"text":"mode regu kutu mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Afei wobesu afrɛ Awurade,","poem":1},{"text":"nanso ɔrennye wɔn so.","poem":2},{"text":"Saa bere no ɔde nʼanim besie wɔn,","poem":1},{"text":"bɔne a wɔayɛ nti.","poem":2}]},{"type":"verse","number":5,"content":["Nea Awurade se ni:",{"text":"“Adiyifo a","poem":1},{"text":"wɔdaadaa me nkurɔfo no de,","poem":2},{"text":"obi ma wɔn biribi di a","poem":1},{"text":"wɔpae mu ka asomdwoe nsɛm,","poem":2},{"text":"na sɛ wɔamma wɔn biribi anni a,","poem":1},{"text":"adiyifo no siesie wɔn ho sɛ wobetu wɔn so sa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti ade bɛsa mo a morennya adaeso,","poem":1},{"text":"sum beduru mo a morennya ahintasɛm biara.","poem":2},{"text":"Owia bɛtɔ ama adiyifo no,","poem":1},{"text":"na adekyee bɛdan sum ama wɔn.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adehufo ani bewu","poem":1},{"text":"na wobegu asamanfrɛfo anim ase.","poem":2},{"text":"Wɔn nyinaa bɛkatakata wɔn anim,","poem":1},{"text":"efisɛ mmuae biara mfi Onyankopɔn hɔ mma.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nanso me de, tumi ahyɛ me ma,","poem":1},{"text":"Awurade Honhom ahyɛ me ma","poem":2},{"text":"trenee ne ahoɔden","poem":1},{"text":"a mede bɛpae mu aka","poem":2},{"text":"Yakob amumɔyɛ ne Israel bɔne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Muntie, mo Yakobfi akannifo,","poem":1},{"text":"mo a mudi Israel so,","poem":2},{"text":"a mukyi atɛntrenee","poem":1},{"text":"na mokyea nea ɛteɛ nyinaa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mo a mode mogyahwiegu kyekyeree Sion","poem":1},{"text":"ne awurukasɛm kyekyeree Yerusalem.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nʼakannifo no gye adanmude ansa na wobu atɛn,","poem":1},{"text":"nʼasɔfo gye sika ansa na wɔakyerɛkyerɛ,","poem":2},{"text":"nʼadiyifo de nkɔmhyɛ ayɛ sikapɛ.","poem":1},{"text":"Nanso wɔdan Awurade, na wɔka se,","poem":2},{"text":"“Awurade nni yɛn ntam ana?","poem":1},{"text":"Ɔhaw biara remma yɛn so.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Na mo nti,","poem":1},{"text":"wobefuntum Sion te sɛ afuw,","poem":2},{"text":"Yerusalem bɛyɛ nnwiriwii siw,","poem":1},{"text":"na asɔredan no pampa bɛyɛ nkɔmoa so nkyɛkyerɛ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}