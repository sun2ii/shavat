{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_aka","name":"Mika","commonName":"Mika","title":"Odiyifo Mika Nhoma","order":33,"numberOfChapters":7,"sha256":"3321b6ffac8bc90ad2e603004230d7d547d10a1e8ae57672a07bbd95c1642095","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_aka/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Awurade Bepɔw No"]},{"type":"verse","number":1,"content":["Nna a edi akyi no mu no,",{"text":"Awurade asɔredan bepɔw no betim","poem":1},{"text":"sɛ mmepɔw no nyinaa ti;","poem":2},{"text":"ebegye din aboro nkoko nyinaa,","poem":1},{"text":"na nnipa ahorow bɛbɔ yuu akɔ hɔ.","poem":2}]},{"type":"verse","number":2,"content":["Aman bebree bɛba abɛka se,",{"text":"“Mommra mma yɛnkɔ Awurade bepɔw no so,","poem":1},{"text":"nkɔ Yakob Nyankopɔn fi.","poem":2},{"text":"Ɔbɛkyerɛkyerɛ yɛn nʼakwan","poem":1},{"text":"sɛnea ɛbɛyɛ a yɛbɛnantew nʼatempɔn so.”","poem":2},{"text":"Mmara no befi Sion aba,","poem":1},{"text":"na Awurade asɛm afi Yerusalem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obebu amanaman ntam atɛn","poem":1},{"text":"na obesiesie nnipa bebree ntam asɛm.","poem":2},{"text":"Wɔde wɔn afoa bɛbobɔ nsɔw","poem":1},{"text":"na wɔde wɔn mpeaw ayɛ asosɔw.","poem":2},{"text":"Ɔman bi rentwe ɔman foforo so afoa,","poem":1},{"text":"na wɔrenyɛ ahoboa biara mma ɔko bio.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obiara bɛtena ne bobe","poem":1},{"text":"anaa ne borɔdɔma nnua ase,","poem":2},{"text":"na obiara remmehunahuna wɔn,","poem":1},{"text":"efisɛ, Asafo Awurade akasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amanaman no nyinaa betumi anantew","poem":1},{"text":"wɔn anyame din mu,","poem":2},{"text":"na yɛn de, yɛbɛnantew Awurade,","poem":1},{"text":"yɛn Nyankopɔn Din mu daa daa.","poem":2}]},{"type":"heading","content":["Awurade Atirimpɔw"]},{"type":"verse","number":6,"content":[{"text":"“Saa da no,” sɛnea Awurade se ni,","poem":1},{"text":"“Mɛboaboa mmubuafo, atukɔfo","poem":2},{"lineBreak":true},{"text":"ɛne wɔn a mede awerɛhow aba wɔn so ano.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɛma mmubuafo ayɛ me nkurɔfo wɔ asase no so,","poem":1},{"text":"atukɔfo no bɛyɛ ɔman kɛse.","poem":2},{"text":"Awurade bedi wɔn so hene wɔ Sion bepɔw so","poem":1},{"text":"afi da no akosi daa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na wo, nguankuw no abantenten,","poem":1},{"text":"Ɔbabea Sion, abandennen,","poem":2},{"text":"wɔde wo tete tumidi no bɛsan abrɛ wo;","poem":1},{"text":"Ɔbabea Yerusalem nsa bɛsan aka nʼahenni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Adɛn nti na afei woresu dennen,","poem":1},{"text":"wunni ɔhene ana?","poem":2},{"text":"Wo futufo ayera, na enti","poem":1},{"text":"ɔyaw aka wo sɛ ɔbea a ɔwɔ awoko mu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bukabukaw wo mu wɔ yawdi mu, Ɔbabea Sion,","poem":1},{"text":"te sɛ ɔbea a awo aka no,","poem":2},{"text":"mprempren ɛsɛ sɛ wufi kuropɔn no mu","poem":1},{"text":"kɔtena sare so.","poem":2},{"text":"Wobɛkɔ Babilonia;","poem":1},{"text":"na hɔ na wobegye wo.","poem":2},{"text":"Ɛhɔ na Awurade begye wo","poem":1},{"text":"afi wʼatamfo nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mprempren de, aman bebree aka abɔ mu atia wo.","poem":1},{"text":"Wɔka se, “Wongu Sion ho fi,","poem":2},{"text":"na yɛmfa yɛn ani nhwɛ no!”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanso wonnim Awurade adwene.","poem":1},{"text":"Wɔnte nʼagyinatu ase.","poem":2},{"text":"Wonnim sɛ ɔno na ɔboaboa wɔn ano te sɛ afiafi","poem":1},{"text":"de kɔ awiporowbea.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Sɔre, na porow, Ɔbabea Sion,","poem":1},{"text":"mɛma wo dade mmɛn;","poem":2},{"text":"mɛma wo kɔbere tɔte","poem":1},{"text":"na wubebubu aman bebree mu nketenkete.”","poem":2},{"text":"Wode wɔn mfaso a wɔampɛ no ɔkwan pa so bɛbrɛ Awurade,","poem":1},{"text":"wode wɔn ahonyade bɛbrɛ asase nyinaa so wura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}