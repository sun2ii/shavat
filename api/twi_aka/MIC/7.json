{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_aka","name":"Mika","commonName":"Mika","title":"Odiyifo Mika Nhoma","order":33,"numberOfChapters":7,"sha256":"3321b6ffac8bc90ad2e603004230d7d547d10a1e8ae57672a07bbd95c1642095","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_aka/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel Ahohia"]},{"type":"verse","number":1,"content":[{"text":"Mayɛ mmɔbɔ!","poem":1},{"lineBreak":true},{"text":"Mete sɛ otwabere nnuaba tasefo a","poem":1},{"text":"otwabere akyi mikodi mpɛpɛ wɔ bobeturo mu;","poem":2},{"text":"minnya bobe kasiaw na madi,","poem":1},{"text":"borɔdɔma aba a edi kan a mekɔn dɔ nso, saa ara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wɔapra Onyamefɛrefo nyinaa afi asase so.","poem":1},{"text":"Anka ɔbaako a ɔteɛ mpo.","poem":2},{"text":"Nnipa nyinaa tetɛw na wɔhwehwɛ sɛ wɔbɛka mogya agu;","poem":1},{"text":"wɔde ɔtan sunsum wɔn ho wɔn ho mfiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nsa abien no nyinaa akokwaw bɔneyɛ mu;","poem":1},{"text":"ɔsodifo bisa akyɛde,","poem":2},{"text":"otemmufo gye adanmude,","poem":1},{"text":"wɔn a tumi wɔ wɔn nsa mu no yɛ nea wɔpɛ,","poem":2},{"lineBreak":true},{"text":"wɔn nyinaa bɔ mu dwene amumɔyɛ ho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nea oye wɔ wɔn mu no te sɛ ohwirem;","poem":1},{"text":"nea ɔteɛ pa ara no, nsɔeban ye sen no.","poem":2},{"text":"Wʼatemmuda no aso,","poem":1},{"text":"da a Onyankopɔn reba wo nsrahwɛ.","poem":2},{"lineBreak":true},{"text":"Eyi ne bere a wɔn ani so bɛyɛ wɔn totɔtotɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nnye obiara nni;","poem":1},{"text":"mfa wo werɛ nhyɛ adamfo mu.","poem":2},{"text":"Mpo, ɔbea a ɔda wo koko mu no","poem":1},{"text":"to wo tɛkrɛma nnareka wɔ ne ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔbabarima twiri nʼagya,","poem":1},{"text":"Ɔbabea sɔre tia ne na,","poem":2},{"text":"asebea nso tia nʼase","poem":1},{"text":"onipa atamfo ne nʼankasa ne fifo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me de, mede anidaso hwɛ Awurade,","poem":1},{"text":"Metwɛn me Nkwagye Nyankopɔn;","poem":2},{"lineBreak":true},{"text":"na me Nyankopɔn betie me.","poem":2}]},{"type":"heading","content":["Israel Bɛsɔre"]},{"type":"verse","number":8,"content":[{"text":"Mma wʼani nnye, me tamfo!","poem":1},{"text":"Mahwe ase de, nanso mɛsɔre.","poem":2},{"text":"Sum aduru me de,","poem":1},{"text":"nanso Awurade bɛyɛ me hann.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛ mayɛ bɔne atia no nti,","poem":1},{"text":"Awurade abufuw bɛba me so,","poem":2},{"text":"kosi sɛ ɔbɛka mʼasɛm ama me","poem":1},{"text":"na wada me bembu adi.","poem":2},{"text":"Ɔde me bɛba hann no mu;","poem":1},{"text":"na mehu ne trenee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Afei, mʼatamfo behu","poem":1},{"text":"na wɔn ani bewu,","poem":2},{"text":"nea osee me sɛ,","poem":1},{"text":"“Ɛhe na Awurade wo Nyankopɔn no wɔ?”","poem":2},{"text":"Mʼani behu nʼasehwe;","poem":1},{"text":"mpo mprempren no, wobetiatia no so","poem":2},{"lineBreak":true},{"text":"te sɛ dontori a ɛwɔ mmɔnten so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Da a wɔbɛto wʼafasu no bɛba,","poem":1},{"text":"da a wɔbɛtrɛw wʼahye mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Da no, nnipa bɛba wo nkyɛn","poem":1},{"text":"afi Asiria ne Misraim nkuropɔn mu,","poem":2},{"text":"mpo wobefi Misraim akosi Eufrate","poem":1},{"text":"afi po akosi po","poem":2},{"lineBreak":true},{"text":"ne bepɔw so akosi bepɔw so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asase no bɛyɛ amamfo, esiane nnipa a wɔtete so","poem":1},{"text":"ne wɔn nneyɛe nti.","poem":2}]},{"type":"heading","content":["Mpaebɔ Ne Nkamfo"]},{"type":"verse","number":14,"content":[{"text":"Fa wo pema di wo nkurɔfo anim,","poem":1},{"text":"nguan a wɔyɛ wʼagyapade no,","poem":2},{"text":"a wɔn nko ara tete kwae mu,","poem":1},{"text":"wura frɔmfrɔm adidibea hɔ.","poem":2},{"text":"Ma wonnidi wɔ Basan ne Gilead","poem":1},{"text":"sɛ tete nna no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mɛyɛ anwonwade akyerɛ wo,","poem":1},{"text":"sɛnea meyɛɛ nna a wufi Misraim bae mu no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aman behu wo na wɔn ani bewu,","poem":1},{"text":"wɔn a tumi nyinaa afi wɔn nsa no.","poem":2},{"text":"Wɔde wɔn nsa betuatua wɔn ano","poem":1},{"text":"na wɔn aso besisiw.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wobedi dɔte sɛ awɔ,","poem":1},{"text":"ne mmoa a wɔwea wɔ fam.","poem":2},{"text":"Wɔde ahopopo befi wɔn abon mu aba;","poem":1},{"text":"wɔde osuro bɛdan wɔn ho ama Awurade yɛn Nyankopɔn,","poem":2},{"lineBreak":true},{"text":"na wobesuro wo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hena na ɔte sɛ wo,","poem":1},{"text":"Onyankopɔn a wode bɔne kyɛ?","poem":2},{"text":"Wo a wode agyanom asefo nkae amumɔyɛ kyɛ wɔn.","poem":1},{"text":"Wʼabufuw ntena hɔ daa,","poem":2},{"lineBreak":true},{"text":"na mmom wʼani gye sɛ wobɛda mmɔborɔhunu adi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wubehu yɛn mmɔbɔ bio,","poem":1},{"text":"wubetiatia yɛn bɔne so,","poem":2},{"lineBreak":true},{"text":"na woatow yɛn amumɔyɛ agu po bun mu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wobɛyɛ ɔnokwafo ama Yakob","poem":1},{"text":"na woahu Abraham mmɔbɔ","poem":2},{"text":"sɛnea wokaa yɛn agyanom ntam","poem":1},{"text":"teteete no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}