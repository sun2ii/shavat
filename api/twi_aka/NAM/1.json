{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"NAM","translationId":"twi_aka","name":"Nahum","commonName":"Nahum","title":"Odiyifo Nahum Nhoma","order":34,"numberOfChapters":3,"sha256":"42bc260b438d47ce56cebcbe153324a271bf9e6267db86610ed4ac6bcae02c30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Elkosini Nahum anisoadehu nhoma a ɛyɛ nkɔmhyɛ a ɛfa Ninewe ho."]},{"type":"heading","content":["Awurade Abufuw A Etia Ninewe"]},{"type":"verse","number":2,"content":[{"text":"Awurade yɛ ninkufo ne aweretɔ Nyankopɔn,","poem":1},{"text":"Awurade tɔ were, na abufuw ahyɛ no ma.","poem":2},{"text":"Awurade tɔ nʼatamfo so were,","poem":1},{"text":"na nʼabufuw tena wɔn so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade bo kyɛ fuw, na ne tumi so,","poem":1},{"text":"na ɔtwe ɔfɔdifo aso.","poem":2},{"text":"Ne kwan wɔ mfɛtɛ ne ahum mu,","poem":1},{"text":"omununkum yɛ nʼanan ase mfutuma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔteɛteɛ po na ɔma ɛyow;","poem":1},{"text":"ɔma nsubɔnten nyinaa yoyow.","poem":2},{"text":"Basan ne Karmel twintwam,","poem":1},{"text":"na Lebanon frɔmfrɔmyɛ nso kisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mmepɔw wosow biribiri nʼanim","poem":1},{"text":"na nkoko nan.","poem":2},{"text":"Asase, wiase ne wɔn a wɔwɔ mu nyinaa","poem":1},{"text":"wosow nʼanim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hena na obetumi agyina nʼabufuw ano?","poem":1},{"text":"Hena na obetumi atena nʼabufuwhyew mu?","poem":2},{"text":"Nʼabufuw hwie te sɛ ogya;","poem":1},{"text":"abotan yam wɔ nʼanim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade ye,","poem":1},{"text":"ɔyɛ ahohia mu guankɔbea.","poem":2},{"text":"Nʼani wɔ wɔn a wɔde wɔn ho to no so no so.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Nanso, ɔnam nsuyiri nwonwaso so","poem":2},{"text":"bɛma Ninewe aba awiei.","poem":1},{"text":"Ɔbɛtaa nʼatamfo akodu sum kabii mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pɔw biara a wɔbɛbɔ atia Awurade no,","poem":1},{"text":"ɔbɛsɛe no;","poem":2},{"lineBreak":true},{"text":"ɔhaw biara remma nto so mprenu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wɔde nsɔe bɛkyekyere wɔn ho,","poem":1},{"text":"na bere a wɔn nsa abow wɔn no","poem":2},{"lineBreak":true},{"text":"wɔbɛhyew wɔn sɛ nwuraguanee a wɔaboa ano.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ninewe, wo mu na","poem":1},{"text":"nea ɔbɔ pɔw bɔne tia Awurade","poem":2},{"text":"na otu fo bɔne no fi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nea Awurade se ni:","poem":1},{"text":"“Ɛwɔ mu sɛ wɔwɔ nnamfonom a wɔdɔɔso de,","poem":2},{"text":"nanso wɔbɛsɛe wɔn ama wɔayera.","poem":1},{"text":"Yuda, ɛwɔ mu sɛ mama ɔhaw aba wo so,","poem":2},{"lineBreak":true},{"text":"nanso merenyɛ saa bio.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei, mebubu konnua a ɛda wo kɔn mu","poem":1},{"text":"na matetew nkɔnsɔnkɔnsɔn no mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ninewe, Awurade aka ɔhyɛ asɛm a ɛfa wo ho:","poem":1},{"text":"“Worennya asefo a wo din bɛda wɔn so.","poem":2},{"text":"Mɛsɛe nsɛsode a wɔasen ne ahoni a wɔagu","poem":1},{"text":"a esisi wʼabosonnan mu no.","poem":2},{"text":"Mesiesie wo da","poem":1},{"text":"efisɛ woadan ayɛ atantanne.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hwɛ mmepɔw no so,","poem":1},{"text":"nea ɔde asɛmpa no ba no anammɔn","poem":2},{"lineBreak":true},{"text":"ɔno na ɔka asomdwoesɛm!","poem":2},{"text":"Yuda di wʼafahyɛ na","poem":1},{"text":"di wɔ bɔhyɛ so.","poem":2},{"text":"Nnipabɔne rentu wo so sa bio;","poem":1},{"text":"Wɔbɛsɛe wɔn pasaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}