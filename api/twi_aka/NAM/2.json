{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"NAM","translationId":"twi_aka","name":"Nahum","commonName":"Nahum","title":"Odiyifo Nahum Nhoma","order":34,"numberOfChapters":3,"sha256":"42bc260b438d47ce56cebcbe153324a271bf9e6267db86610ed4ac6bcae02c30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Ninewe Asehwe"]},{"type":"verse","number":1,"content":[{"text":"Ɔtamfo reba wo so, Ninewe","poem":1},{"text":"bɔ aban no ho ban,","poem":2},{"text":"wɛn ɔkwan no,","poem":1},{"text":"bɔ wo ho so","poem":2},{"text":"na boa wʼahoɔden nyinaa ano!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade de Yakob anuonyam bɛsan ama no","poem":1},{"text":"te sɛ Israel de no,","poem":2},{"text":"ɛwɔ mu sɛ, asɛefo no ama ada mpan","poem":1},{"text":"na wɔasɛe ne bobe mfuw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asraafo no nkatabo yɛ kɔkɔɔ;","poem":1},{"text":"akofo no hyehyɛ ɔkɔben akotade.","poem":2},{"text":"Nnade a wɔde yɛɛ nteaseɛnam no","poem":1},{"text":"twa yerɛw yerɛw sɛ da a wɔyɛɛ no;","poem":2},{"lineBreak":true},{"text":"mpeaw a wɔapema wɔ nnua so no rehim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nteaseɛnam no twiw fa mmɔnten so,","poem":1},{"text":"na wodi akɔneaba.","poem":2},{"text":"Wɔte sɛ ogyatɛn a ɛredɛw;","poem":1},{"text":"wɔbɔ yerɛdɛ te sɛ anyinam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɔfrɛfrɛɛ nʼakofo a wodi mu,","poem":1},{"text":"nanso wohintihintiw wɔ ɔkwan mu.","poem":2},{"text":"Wɔde mmirika kɔ kuropɔn no afasu ho;","poem":1},{"text":"na wɔyɛ wɔn nkataanim krado.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wobuebue asubɔnten apon no,","poem":1},{"text":"na ahemfi no dwiriw gu fam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔhyɛ mmaraden sɛ","poem":1},{"text":"wɔmfa kuropɔn no nnommum","poem":2},{"text":"na wɔmfa wɔn nkɔ.","poem":1},{"text":"Ne mfenaa de wɔn nsa gu wɔn koko so","poem":2},{"lineBreak":true},{"text":"su te sɛ mmorɔnoma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninewe te sɛ ɔtare a","poem":1},{"text":"mu nsu resen kɔ.","poem":2},{"text":"Wɔteɛ mu se, “Munnyina hɔ! Munnyina hɔ!”","poem":1},{"text":"Nanso, obiara ansan nʼakyi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momfom dwetɛ no!","poem":1},{"text":"Momfom sikakɔkɔɔ no!","poem":2},{"text":"Ahonyade a ɛwɔ adekoradan mu nyinaa!","poem":1},{"text":"Na ahonyade no dɔɔso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wɔabɔ Ninewe korɔn, wɔayɛ no pasaa!","poem":1},{"text":"Koma botow, na nkotodwe wosowosow,","poem":2},{"lineBreak":true},{"text":"nnipa ho popo na wɔn anim hoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mprempren he na gyata buw no wɔ,","poem":1},{"text":"faako a wɔma wɔn mma aduan no,","poem":2},{"text":"faako a gyatanini ne gyatabere kɔe","poem":1},{"text":"na wɔn mma nso kɔ a wonsuro?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gyata akum nea ɛbɛmee ne mma.","poem":1},{"text":"Wabobɔ hanam ama gyatabere no.","poem":2},{"text":"Ɔde nea wakum ahyɛ ne bon ma","poem":1},{"text":"na ɔde hanam ahyɛ nʼatu amaama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Me ne wo nka,”","poem":1},{"text":"sɛnea Asafo Awurade se ni,","poem":2},{"text":"“Mɛhyew wo nteaseɛnam na adan wusiw","poem":1},{"text":"na afoa bekunkum wo gyatamma.","poem":2},{"text":"Merennyaw wo hanam biara wɔ asase so.","poem":1},{"text":"Wɔrente wʼasomafo no nne bio.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}