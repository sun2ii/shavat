{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"NAM","translationId":"twi_aka","name":"Nahum","commonName":"Nahum","title":"Odiyifo Nahum Nhoma","order":34,"numberOfChapters":3,"sha256":"42bc260b438d47ce56cebcbe153324a271bf9e6267db86610ed4ac6bcae02c30","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Ninewe Nnome"]},{"type":"verse","number":1,"content":[{"text":"Nnome nka mogya kuropɔn","poem":1},{"text":"a atoro ne korɔn ahyɛ no ma","poem":2},{"lineBreak":true},{"text":"na amanehunufo mpa mu da!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apɔnkɔkafo abaa regyigye,","poem":1},{"text":"nteaseɛnam nhankare reyɛ kirididi","poem":2},{"text":"Apɔnkɔ rehuruhuruw","poem":1},{"text":"ne nteaseɛnam redankyidankyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Apɔnkɔ ne wɔn sotefo ko kɔ wɔn anim;","poem":1},{"text":"afoa twa yerɛw yerɛw,","poem":2},{"lineBreak":true},{"text":"na mpeaw nso pa yerɛw yerɛw.","poem":2},{"text":"Atɔfo bebree,","poem":1},{"text":"awufo a bi deda bi so,","poem":2},{"text":"afunu a wontumi nkan wɔn dodow","poem":1},{"text":"a nnipa tiatia so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eyi nyinaa fi oguamanfo bi akɔnnɔ,","poem":1},{"text":"ntafowayifo no nnaadaa dodow no.","poem":2},{"text":"Ɔno na ɔde nʼaguamammɔ tɔn amanaman","poem":1},{"text":"na ɔde ne ntafowayi tɔn nnipa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Me ne wo nka,” sɛnea Asafo Awurade se ni,","poem":1},{"text":"“Mɛpagyaw wʼatade akɔ soro.","poem":2},{"text":"Mɛma amanaman ahu wʼadagyaw","poem":1},{"text":"na ahenni ahorow nso ahu wʼanimguase.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mede fi bɛsra wo ho,","poem":1},{"text":"mebu wo animtiaa","poem":2},{"lineBreak":true},{"text":"na mama nnipa ahwɛ wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obiara a obehu wo beguan afi wo ho aka se,","poem":1},{"text":"‘Ninewe adwiriw, na hena na obesu no?’","poem":2},{"lineBreak":true},{"text":"Ɛhe na menya obi akyekye wo werɛ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wuye sen Tebes a","poem":1},{"text":"ɛda Asubɔnten Nil ho a","poem":2},{"lineBreak":true},{"text":"nsu atwa ne ho ahyia ana?","poem":2},{"text":"Asubɔnten bɔ ne ho ban","poem":1},{"text":"na nsu yɛ ne fasu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kus ne Misraim yɛ ne dɔm a wontumi nkan wɔn.","poem":1},{"text":"Put ne Libia ka nʼadomfo ho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nanso wɔfaa no nnommum","poem":1},{"text":"twaa no asu.","poem":2},{"text":"Wɔtow ne nkokoaa hwehwee fam","poem":1},{"text":"ma wɔtetee wɔ mmɔnten so.","poem":2},{"text":"Wɔbɔɔ nʼadehye so ntonto,","poem":1},{"text":"na nʼatitiriw nso wɔde nkɔnsɔnkɔnsɔn guguu wɔn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wo nso wobɛbow","poem":1},{"text":"Na wubehintaw wo ho","poem":2},{"lineBreak":true},{"text":"de akɔpɛ guankɔbea wɔ atamfo nkyɛn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wʼaban nyinaa te sɛ borɔdɔma nnua","poem":1},{"text":"a asow aba foforo:","poem":2},{"text":"sɛ wɔwosow a","poem":1},{"text":"aba no tetew gu ma nea ɔrehwehwɛ bi adi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hwɛ wʼakofo","poem":1},{"text":"wɔn nyinaa yɛ mmea!","poem":2},{"text":"Wʼasase so apon ano deda hɔ ma wʼatamfo;","poem":1},{"text":"ogya ahyew wʼapon no akyi adaban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sesaw nsu sie ma bere a wɔatua mo ano no.","poem":1},{"text":"Yere wo bammɔ mu!","poem":2},{"text":"Wɔw dɔte no","poem":1},{"text":"na siesie ntayaa a wɔato no!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɛhɔ na ogya bɛhyew wo;","poem":1},{"text":"afoa betwa wo ahwe fam,","poem":2},{"text":"wobedi wo nam sɛ mmoadabikuw.","poem":1},{"text":"Monnɔ sɛ tɛwtɛw,","poem":2},{"lineBreak":true},{"text":"mo ase mfɛe sɛ mmoadabi!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Woama wʼaguadifo adɔɔso,","poem":1},{"text":"wɔn dodow asen ɔsoro nsoromma,","poem":2},{"text":"nanso wɔte sɛ mmoadabi a wɔbɔ asase no kwaterekwa","poem":1},{"text":"na afei wotu kɔ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wʼawɛmfo te sɛ mmoadabi.","poem":1},{"text":"Wʼadwumayɛfo te sɛ mmoadabi akuw","poem":2},{"lineBreak":true},{"text":"a wɔsensam ban ho awɔw da.","poem":2},{"text":"Nanso sɛ owia pue a wotu kɔ,","poem":1},{"text":"na obi nnim faako a wɔkɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Asiriahene wo nguanhwɛfo retɔ nko.","poem":1},{"text":"Wʼanuonyamfo deda hɔ rehome.","poem":2},{"text":"Wo nkurɔfo abɔ apete wɔ mmepɔw no so","poem":1},{"text":"a wonni anoboaboafo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aduru biara rentumi nkum wʼapirakuru no;","poem":1},{"text":"wo kuru no bekum wo.","poem":2},{"text":"Obiara a ɔte wo nka no","poem":1},{"text":"bɔ ne nsam wɔ wʼasehwe ho,","poem":2},{"text":"Na hena koraa na wʼatirimɔdensɛm","poem":1},{"text":"no bi nkaa no da?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}