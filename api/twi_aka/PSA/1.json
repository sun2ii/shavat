{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Nhyira ne onipa a","poem":1},{"text":"ontie amumɔyɛfo afotu","poem":2},{"text":"na onni nnebɔneyɛfo nhwɛso akyi","poem":1},{"text":"na ɔntena fɛwdifo tenabea.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na mmom, Awurade mmara sɔ nʼani,","poem":1},{"text":"na osusuw ho awia ne anadwo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔte sɛ dua a wɔatɛw wɔ asuten ho,","poem":1},{"text":"na ɛsow nʼaba ne bere mu a","poem":2},{"text":"nʼahaban no nguan da.","poem":1},{"text":"Nea ɔyɛ biara yɛ yiye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso nnebɔneyɛfo nte saa;","poem":1},{"text":"wɔte sɛ ntɛtɛ a","poem":2},{"lineBreak":true},{"text":"mframa bɔ gu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti amumɔyɛfo rentumi nnyina atemmu no ano,","poem":1},{"text":"na nnebɔneyɛfo nso rentena atreneefo asafo mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Efisɛ Awurade kyerɛ ɔtreneeni kwan","poem":1},{"text":"nanso amumɔyɛfo kwan de, ɛbɛyera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}