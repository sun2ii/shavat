{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["Ayeyi Dwom."]},{"type":"verse","number":1,"content":[{"text":"Mommɔ ose mma Awurade, asase nyinaa.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Momfa ahosɛpɛw nsom Awurade;","poem":2},{"lineBreak":true},{"text":"momfa anigye nnwom mmra nʼanim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munhu sɛ Awurade yɛ Onyankopɔn;","poem":1},{"text":"ɔno na ɔyɛɛ yɛn, na yɛyɛ ne de;","poem":2},{"lineBreak":true},{"text":"yɛyɛ ne nkurɔfo ne ne didibea nguan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Momfa aseda nhyɛn nʼapon mu,","poem":1},{"text":"na momfa nkamfo nkɔ nʼadiwo;","poem":2},{"lineBreak":true},{"text":"momfa aseda mma no, na monkamfo ne din.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awurade ye; na nʼadɔe wɔ hɔ daa;","poem":1},{"text":"ne nokwaredi kodu awo ntoatoaso nyinaa so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}