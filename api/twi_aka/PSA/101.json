{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Dawid Dwom."]},{"type":"verse","number":1,"content":[{"text":"Mɛto wo dɔ ne wo trenee ho nnwom;","poem":1},{"text":"Awurade, mɛto ayeyi nnwom ama wo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛhwɛ yiye abu ɔbra a ho tew;","poem":1},{"text":"da bɛn na wobɛba me nkyɛn?","poem":2},{"lineBreak":true},{"text":"Mede koma a afɔdi nni mu","poem":1},{"text":"bɛhwɛ me fi so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Merennye ade a ɛyɛ tan","poem":1},{"text":"biara nto mu.","poem":2},{"lineBreak":true},{"text":"Mikyi nnipa a wonni gyidi nneyɛe;","poem":1},{"text":"meremfa me ho mmata ho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nnipa a wɔn koma yɛ kɔntɔnkye remmɛn me;","poem":1},{"text":"me ne bɔne nni hwee yɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Obiara a odi ne yɔnko ho nseku wɔ kokoa mu no,","poem":1},{"text":"ɔno na mɛsɛe;","poem":2},{"text":"nea ɔwɔ ahantan ani ne ahomaso koma,","poem":1},{"text":"ɔno na merennyigye no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mʼani bɛkɔ anokwafo a wɔwɔ asase no so no so","poem":1},{"text":"na me ne wɔn atena;","poem":2},{"text":"nea ne nantew ho nni asɛm no","poem":1},{"text":"ɔno na ɔbɛsom me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nea ɔyɛ ɔdaadaafo biara","poem":1},{"text":"rentena me fi;","poem":2},{"text":"nea otwa nkontompo no","poem":1},{"text":"rennyina mʼanim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Adekyee biara,","poem":1},{"text":"mɛsɛe amumɔyɛfo a wɔwɔ asase yi so nyinaa;","poem":2},{"text":"na mapam ɔdebɔneyɛni biara","poem":1},{"text":"afi Awurade kuropɔn mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}