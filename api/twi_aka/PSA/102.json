{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["Aberante mmɔborɔni mpaebɔ. Osu kyerɛ Awurade bere a ɔwɔ ahohia mu."]},{"type":"verse","number":1,"content":[{"text":"Awurade, tie me mpaebɔ;","poem":1},{"text":"na ma me mmoa ho sufrɛ nnu wʼanim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mmfa wʼanim nhintaw me","poem":1},{"text":"bere a mewɔ ahohia mu.","poem":2},{"text":"Brɛ wʼaso ase ma me;","poem":1},{"text":"na sɛ misu frɛ wo a, gye me so ntɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Me nkwanna reyera te sɛ wusiw;","poem":1},{"text":"me nnompe adɔ sɛ nyansramma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me koma abotow na akisa sɛ sare;","poem":1},{"text":"na me kɔn nnɔ aduan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mʼapinisi dennen nti","poem":1},{"text":"maka ɔhonam ne nnompe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mete sɛ sare so patu,","poem":1},{"text":"te sɛ patu a ɔte nnwiriwii mu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meda hɔ a, mʼani gu so; mayɛ sɛ","poem":1},{"text":"anomaa bi a ɔno nko ara si ɔdan atifi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Da mu nyinaa mʼatamfo bɔ me akutia.","poem":1},{"text":"Wɔn a wodi me ho fɛw no bɔ me din de dome.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mede nsõ ayɛ mʼaduan","poem":1},{"text":"na mede nusu fra me nsu mu","poem":2}]},{"type":"verse","number":10,"content":[{"text":"esiane wʼabufuwhyew dennen no nti,","poem":1},{"text":"woama me so, ayi me asi nkyɛn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Me nkwa nna te sɛ anwummere sunsuma;","poem":1},{"text":"na mehyew sɛ sare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nanso wo Awurade, woyɛ ɔhene daa daa;","poem":1},{"text":"na wo din a ahyeta no te hɔ daa awo ntoatoaso nyinaa mu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wobɛsɔre na woahu Sion mmɔbɔ;","poem":1},{"text":"bere adu sɛ wuhu no mmɔbɔ;","poem":2},{"lineBreak":true},{"text":"bere a wohyɛe no aso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nʼabo som bo ma wʼasomfo;","poem":1},{"text":"ne mfutuma hyɛ wɔn awerɛhow.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amanaman no besuro Awurade din;","poem":1},{"text":"asase so ahemfo nyinaa bedi wʼanuonyam ni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Awurade bɛkyekyere Sion bio,","poem":1},{"text":"na wapue wɔ nʼanuonyam mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Obetie mmɔborɔfo mpaebɔ;","poem":1},{"text":"na ɔremmu nʼani ngu wɔn sufrɛ so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Monkyerɛw eyi mma nkyirimma,","poem":1},{"text":"sɛnea ɛbɛyɛ a wɔn a wonnya nwoo wɔn no bɛkamfo Awurade;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Awurade hwɛɛ fam fi ne kronkronbea wɔ ɔsoro hɔ;","poem":1},{"text":"ofi ɔsoro hwɛɛ asase,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"sɛnea ɔbɛte nneduafo apinisi,","poem":1},{"text":"na wɔagyaa wɔn a wɔabu wɔn kumfɔ no.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Enti wɔbɛpae mu abɔ Awurade din wɔ Sion","poem":1},{"text":"na wɔakamfo no wɔ Yerusalem,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"bere a amanaman ne ahenni ahorow","poem":1},{"text":"behyia mu na wɔasom Awurade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ɔmaa me yɛɛ mmerɛw wɔ bere a merenyin.","poem":1},{"text":"Otwaa me nkwa nna so.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti mekae se,","poem":1},{"text":"“Me Onyankopɔn, mfa me nkɔ, wɔ me nkwa nna mfimfini;","poem":2},{"lineBreak":true},{"text":"wo mfe wɔ hɔ daa kodu awo ntoatoaso nyinaa mu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mfiase no wotoo asase fapem,","poem":1},{"text":"na ɔsoro yɛ wo nsa ano adwuma.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne nyinaa betwa mu na wo de, wobɛtena hɔ daa;","poem":1},{"text":"wɔbɛtetew te sɛ atade.","poem":2},{"text":"Wobɛsesa wɔn te sɛ ntama,","poem":1},{"text":"na wɔbɛtow wɔn agu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nanso wote sɛnea wote,","poem":1},{"text":"na wo mfe to rentwa da.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wʼasomfo mma bɛtena nkwa mu wɔ wʼanim;","poem":1},{"text":"na wɔn asefo ase betim wɔ wʼanim.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}