{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Onyankopɔn, me koma asi pi;","poem":1},{"text":"mede me kra nyinaa bɛto wʼayeyi nnwom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Munnyan, sanku ne bɛnta!","poem":1},{"text":"Menyan anɔpahema.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade, mɛkamfo wo wɔ aman mu;","poem":1},{"text":"mɛto wo ho nnwom wɔ nnipa no mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wʼadɔe so, ɛkorɔn sen ɔsoro;","poem":1},{"text":"wo nokwaredi du wim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onyankopɔn, ɛsɛ sɛ wɔma wo so tra ɔsoro,","poem":1},{"text":"na ama wʼanuonyam aba asase nyinaa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fa wo nsa nifa gye yɛn na boa yɛn,","poem":1},{"text":"na ama wɔn a wodɔ wɔn no anya nkwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onyankopɔn akasa afi ne kronkronbea se,","poem":1},{"text":"“Nkonim mu na mɛkyɛ Sekem mu","poem":2},{"lineBreak":true},{"text":"na masusuw Sukot Bon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead yɛ me de; Manase nso saa ara;","poem":1},{"text":"Efraim yɛ me dade kyɛw,","poem":2},{"lineBreak":true},{"text":"Yuda yɛ mʼahempema.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moab yɛ me guasɛn,","poem":1},{"text":"Edom so na metow me mpaboa gu;","poem":2},{"lineBreak":true},{"text":"na meteɛ mu nkonimdi so gu Filistifo so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hena na ɔde me bɛkɔ kuropɔn a wɔabɔ ho ban no mu?","poem":1},{"text":"Hena na obedi mʼanim akɔ Edom?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onyankopɔn, ɛnyɛ wo na woapo yɛn","poem":1},{"text":"na wo ne yɛn asraafo nkɔ ɔsa bio ana?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Boa yɛn tia ɔtamfo no,","poem":1},{"text":"na ɔdesani mmoa nka hwee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onyankopɔn wɔ yɛn afa yi, yebedi nkonim,","poem":1},{"text":"na obetiatia yɛn atamfo so.","poem":2},{"text":"Wɔde ma dwonkyerɛfo no.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}