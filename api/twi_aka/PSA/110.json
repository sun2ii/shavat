{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade ka kyerɛɛ me Wura se,","poem":1},{"text":"“Tena me nifa so","poem":2},{"text":"kosi sɛ mede wʼatamfo","poem":1},{"text":"bɛyɛ wʼanan ase ntiaso.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade bɛterɛw wʼahempema dennen mu afi Sion;","poem":1},{"text":"na wubedi hene wɔ wʼatamfo so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wʼasraafo beyi wɔn koma mu","poem":1},{"text":"da a wobɛkɔ ɔsa.","poem":2},{"text":"Tumi kronkron bɛyɛ wʼadurade","poem":1},{"text":"na wo mmabun bɛba wo nkyɛn","poem":2},{"lineBreak":true},{"text":"sɛnea obosu gugu anɔpahema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awurade aka ntam","poem":1},{"text":"na ɔrensesa nʼadwene:","poem":2},{"text":"“Woyɛ daapem sɔfo","poem":1},{"text":"sɛ Melkisedek sɛso.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade wɔ wo nifa so;","poem":1},{"text":"ɔbɛdwerɛw ahemfo wɔ nʼabufuwhyew da no.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obebu amanaman atɛn aboaboa awufo ano;","poem":1},{"text":"na wadwerɛw asodifo a wɔwɔ asase so nyinaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔbɛnom asuwa a ɛda ɔkwankyɛn mu nsu","poem":1},{"text":"enti obedi nkonim.","poem":2},{"text":"Ɔhene no bɛnom asuwa a ɛda ɔkwankyɛn mu nsu,","poem":1},{"text":"na wanya ahoɔden, na wagyina nkonimdi mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}