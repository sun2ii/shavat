{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade!","poem":1},{"lineBreak":true},{"text":"Mefi me koma nyinaa mu ama Awurade so","poem":1},{"text":"wɔ atreneefo aguabɔ ne asafo no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade nnwuma yɛ akɛse;","poem":1},{"text":"wɔn a wɔn ani gye ho nyinaa susuw ho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne nnwuma yɛ tumi ne anuonyam,","poem":1},{"text":"na ne trenee wɔ hɔ daa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔma yɛkae nʼanwonwade;","poem":1},{"text":"Awurade yɛ ɔdomfo ne mmɔborɔhunufo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɔma wɔn a wosuro no no aduan;","poem":1},{"text":"ɔkae nʼapam no daa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wakyerɛ ne nkurɔfo tumi a ɛwɔ ne nnwuma mu,","poem":1},{"text":"sɛ ɔde aman afoforo nsase ama wɔn.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne nsa ano nnwuma yɛ nokware na ɛteɛ;","poem":1},{"text":"nʼahyɛde nyinaa mu wɔ ahotoso.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Etim hɔ daa daa,","poem":1},{"text":"nokware ne trenee mu na ɔyɛe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔde ogye maa ne nkurɔfo;","poem":1},{"text":"ɔde nʼapam sii hɔ afebɔɔ,","poem":2},{"lineBreak":true},{"text":"ne din yɛ kronkron na ɛyɛ hu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade suro yɛ nyansa mfiase;","poem":1},{"text":"wɔn a wodi nʼahyɛde so nyinaa wɔ nhumu pa.","poem":2},{"lineBreak":true},{"text":"Ɔno na daa ayeyi wɔ no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}