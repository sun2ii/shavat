{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Nhyira nka onipa a osuro Awurade","poem":1},{"text":"na onya nʼahyɛde mu anigye pii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ne mma bɛyɛ atumfo wɔ asase no so;","poem":1},{"text":"atreneefo awo ntoatoaso benya nhyira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahonya ne sika wɔ ne fi,","poem":1},{"text":"na ne trenee tena hɔ daa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sum mu mpo hann pue ma nnipa a wɔteɛ,","poem":1},{"text":"ma ɔdomfo, mmɔborɔhunufo ne ɔnokwafo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yiyedi bɛba wɔn a wɔn tirim yɛ mmerɛw na wɔde fɛm kwa,","poem":1},{"text":"wɔn a wɔde atɛntrenee yɛ wɔn nneɛma no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ampa ara ɔrenhinhim da biara da;","poem":1},{"text":"wɔbɛkae onipa trenee daa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔte asɛmmɔne a, ɛmmɔ no hu;","poem":1},{"text":"ne koma si pi wɔ Awurade mu ahotoso mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne koma wɔ bammɔ, na onsuro;","poem":1},{"text":"awiei no ɔde nkonimdi behyia nʼatamfo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔtow nʼakyɛde pete aman so ma ahiafo nea wohia,","poem":1},{"text":"nʼadɔe no tena hɔ daa;","poem":2},{"lineBreak":true},{"text":"wɔbɛkae wɔn daa na wɔahyɛ wɔn anuonyam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omumɔyɛfo behu ama ayɛ no yaw,","poem":1},{"text":"ɔbɛtwɛre ne se na wafɔn;","poem":2},{"lineBreak":true},{"text":"omumɔyɛfo tirimpɔw bɛyɛ ɔkwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}