{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Monkamfo Awurade, mo a moyɛ nʼasomfo no,","poem":1},{"text":"monkamfo Awurade din.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Momma wɔnkamfo Awurade din,","poem":1},{"text":"mprempren ne daa nyinaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Efi faako a owia pue kosi faako a ɛkɔtɔ,","poem":1},{"text":"ma wɔnkamfo Awurade din.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wɔama Awurade so aman nyinaa so,","poem":1},{"text":"nʼanuonyam tra ɔsorosoro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hena na ɔte sɛ Awurade yɛn Nyankopɔn,","poem":1},{"text":"Ɔbaako no a odi hene wɔ ɔsorosoro,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ɔno na ɔbɔ ne mu ase","poem":1},{"text":"hwɛ ɔsorosoro ne asase?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɔma ahiafo so fi mfutuma mu","poem":1},{"text":"na ɔma onnibi so fi nso siw so;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ɔde wɔn tena mmapɔmma mu,","poem":1},{"text":"wɔn nkurɔfo mmapɔmma mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔbɔ obonin atenase wɔ ne fi","poem":1},{"text":"sɛ ɔbeatan a nʼani gye.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}