{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Bere a Israelfo fii Misraim,","poem":1},{"text":"na Yakobfifo fii ananafo asase so no,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuda bɛyɛɛ Awurade kronkronbea","poem":1},{"text":"na Israel bɛyɛɛ nʼaheman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Po no hwɛe, na eguanee,","poem":1},{"text":"Yordan san nʼakyi;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mmepɔw huruhuruwii sɛ adwennini,","poem":1},{"text":"nkoko nso huruhuruwii sɛ nguantenmma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dɛn na ɛbae, ɛpo, na wuguanee?","poem":1},{"text":"Yordan, adɛn, na wosan wʼakyi?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mmepɔw, adɛn, na muhuruhuruw sɛ adwennini,","poem":1},{"text":"na mo nkoko, muhuruhuruw sɛ nguantenmma yi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Asase, ma wo ho mpopo wɔ Awurade anim,","poem":1},{"text":"wɔ Yakob Nyankopɔn anim,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ɔno na ɔmaa ɔbotan no dan asubura,","poem":1},{"text":"na ɔbotan dennen dan nsuwa aniwa no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}