{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Ɛnyɛ yɛn, Awurade, ɛnyɛ yɛn,","poem":1},{"text":"na wo din na anuonyam nka,","poem":2},{"lineBreak":true},{"text":"wʼadɔe ne wo nokwaredi nti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Adɛn nti na aman no bisa se,","poem":1},{"text":"“Wɔn Nyankopɔn wɔ he?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yɛn Nyankopɔn wɔ ɔsoro;","poem":1},{"text":"nea ɔpɛ biara na ɔyɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso wɔn ahoni yɛ dwetɛ ne sikakɔkɔɔ a","poem":1},{"text":"wɔde onipa nsa na ayɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔwɔ ano, nanso wontumi nkasa;","poem":1},{"text":"wɔwɔ ani, nanso wonhu ade.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔwɔ aso, nanso wɔnte asɛm;","poem":1},{"text":"wɔwɔ hwene, nanso wɔnte hua.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔwɔ nsa, nanso wɔnte nka;","poem":1},{"text":"wɔwɔ anan, nanso wɔnnantew.","poem":2},{"text":"Wontumi mma nnyigyei bi mfi wɔn mene mu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,","poem":1},{"text":"saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mo Israelfo nyinaa, momfa mo ho nto Awurade so,","poem":1},{"text":"ɔyɛ mo boafo ne kyɛm.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ao Aaronfi, momfa mo ho nto Awurade so,","poem":1},{"text":"ɔyɛ mo boafo ne kyɛm.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mo a musuro no, momfa mo ho nto Awurade so,","poem":1},{"text":"ɔyɛ mo boafo ne kyɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Awurade kae yɛn na obehyira yɛn:","poem":1},{"text":"Obehyira Israelfi,","poem":2},{"lineBreak":true},{"text":"obehyira Aaronfi","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obehyira wɔn a wosuro Awurade,","poem":1},{"text":"nketewa ne akɛse nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Awurade mma wʼase nnɔ,","poem":1},{"text":"wo ne wo mma.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Awurade nhyira wo,","poem":1},{"text":"ɔsoro ne asase Yɛfo no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔsorosoro tɔnn yɛ Awurade de,","poem":1},{"text":"nanso asase de, ɔde ama onipa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɛnyɛ awufo na wɔkamfo Awurade","poem":1},{"text":"wɔn a wɔkɔ fam dinn no.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yɛn na yɛma Awurade so","poem":1},{"text":"nnɛ ne daa nyinaa.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}