{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Medɔ Awurade efisɛ, ɔtee me nne.","poem":1},{"text":"Ɔtee me mmɔborɔsu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Esiane sɛ ɔbrɛɛ nʼaso ase maa me nti,","poem":1},{"text":"mɛfrɛ no wɔ bere a mete ase yi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Owu ahama bebaree me,","poem":1},{"text":"ɔda ho yawdi baa me so,","poem":2},{"lineBreak":true},{"text":"ɔhaw ne awerɛhow hyɛɛ me so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Afei mebɔɔ Awurade din kae se,","poem":1},{"text":"“Awurade, gye me nkwa!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade yɛ ɔdomfo ne ɔtreneeni;","poem":1},{"text":"ayamhyehye ahyɛ yɛn Nyankopɔn ma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awurade bɔ ɔwɛmfo ho ban;","poem":1},{"text":"bere a mewɔ ahohia mu no, ogyee me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nya abotɔyam bio, me kra,","poem":1},{"text":"efisɛ Awurade ne wo adi no yiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na wo, Awurade, woagye me kra afi owu mu;","poem":1},{"text":"woamma mʼani amporow nisu,","poem":2},{"lineBreak":true},{"text":"na woamma mʼanan anhintiw","poem":2}]},{"type":"verse","number":9,"content":[{"text":"sɛ mɛnantew Awurade anim","poem":1},{"text":"wɔ ateasefo asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Migye dii; ɛno nti mekae se,","poem":1},{"text":"“Mewɔ ahohia kɛse mu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Na mʼahokyere mu mekae se,","poem":1},{"text":"“Nnipa nyinaa yɛ atorofo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dɛn na metumi de atua Awurade ka","poem":1},{"text":"wɔ ne papa a wayɛ me nyinaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɛma nkwagye kuruwa no so","poem":1},{"text":"na mabɔ Awurade din.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Medi bɔ a mahyɛ Awurade no nyinaa so","poem":1},{"text":"wɔ ne nkurɔfo nyinaa anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Awurade nkoa nokwafo wu","poem":1},{"text":"som bo wɔ Awurade ani so.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Awurade, ampa ara meyɛ wo somfo;","poem":1},{"text":"meyɛ wo somfo, wʼafenaa babarima;","poem":2},{"lineBreak":true},{"text":"woayi me afi me mpokyerɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɛbɔ aseda afɔre ama wo","poem":1},{"text":"na mabɔ Awurade din.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Medi me ntam a maka Awurade no so","poem":1},{"text":"wɔ ne nkurɔfo nyinaa anim,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"wɔ adiwo a ɛwɔ Awurade fi no,","poem":1},{"text":"wɔ wʼanim, Yerusalem.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}