{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Boa yɛn, Awurade, na nyamesurofo asa;","poem":1},{"text":"nokwafo ayera wɔ nnipa mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Obiara di atoro kyerɛ ne yɔnko;","poem":1},{"text":"wɔn ano a ɛdɛfɛdɛfɛ no ka nnaadaasɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma Awurade ntwa nnaadaa ano","poem":1},{"text":"ne tɛkrɛma biara a ɛhoahoa ne ho nkyene;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nea ɛka se, “Yɛde yɛn tɛkrɛma bedi nkonim;","poem":1},{"text":"yɛn ano bedi ama yɛn, na hena na odi yɛn so tumi?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Esiane ɔhyɛ a wɔde hyɛ mmɔborɔni","poem":1},{"text":"ne ohiani apinisi no nti,","poem":2},{"text":"mɛsɔre afei,” Awurade na ose.","poem":1},{"text":"“Mɛbɔ wɔn ho ban afi wɔn a wɔhaw wɔn no ho.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awurade asɛm yɛ nokware","poem":1},{"text":"te sɛ dwetɛ a wɔasɔn so wɔ fononoo mu,","poem":2},{"lineBreak":true},{"text":"na wɔahoa ho mpɛn ason.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade, wobɛkora mmɔborɔni","poem":1},{"text":"na woabɔ yɛn ho ban afi saa nnipa yi ho afebɔɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amumɔyɛfo nenam sɛnea wɔpɛ,","poem":1},{"text":"bere a adesamma de nidi ma afide.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}