{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Ɔsoroforo dwom."]},{"type":"verse","number":1,"content":[{"text":"Misu frɛ Awurade wɔ mʼahohiahia mu,","poem":1},{"text":"na ogye me so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade, gye me fi atoro ano,","poem":1},{"text":"ne nnaadaa tɛkrɛma nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dɛn na ɔbɛyɛ wo,","poem":1},{"text":"na dɛn na ɛka ho bio, wo nnaadaa tɛkrɛma?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔde asraafo bɛmma a ano yɛ nnam","poem":1},{"text":"ne nnyansramma bɛtwe wʼaso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nnome nka me sɛ metena Mesek,","poem":1},{"text":"na mete Kedar ntamadan mu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matena wɔn a wokyi asomdwoe","poem":1},{"text":"mu akyɛ dodo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meyɛ asomdwoe nipa;","poem":1},{"text":"nanso sɛ mekasa a, wɔde yɛ ɔko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}