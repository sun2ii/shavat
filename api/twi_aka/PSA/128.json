ma.","poem":1},{"text":"Asomdwoe nka Israel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}