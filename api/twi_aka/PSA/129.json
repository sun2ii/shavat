","number":7,"content":[{"lineBreak":true},{"text":"na nnɔbaetwafo ntumi nnya biribi mfi mu nhyɛ ne nsa ma,","poem":1},{"text":"na nea ɔboaboa ano nso nnya hwee nhyɛ nʼabasa ma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mma wɔn a wotwa mu wɔ hɔ no nka se,","poem":1},{"text":"“Awurade nhyira mmra mo so;","poem":2},{"lineBreak":true},{"text":"yehyira mo wɔ Awurade din mu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}