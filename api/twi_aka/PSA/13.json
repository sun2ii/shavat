{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade enkosi da bɛn? Wo werɛ befi me afebɔɔ ana?","poem":1},{"text":"Enkosi da bɛn na wode wʼanim behintaw me?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enkosi da bɛn na mene mʼadwennwene bedi aperepere","poem":1},{"text":"na awerɛhow ahyɛ me koma mu daa?","poem":2},{"lineBreak":true},{"text":"Mʼatamfo nni me so nkonim nkosi da bɛn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Twa wʼani hwɛ me na bua me, Awurade, me Nyankopɔn.","poem":1},{"text":"Ma mʼani so nyɛ hann, na manna owu nna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me tamfo bɛka se, “Madi ne so nkonim.”","poem":1},{"text":"Na mʼahohiahiafo bedi ahurusi bere a mahwe ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nanso mede me ho to wo dɔ a ɛnsa da no so;","poem":1},{"text":"me koma di ahurusi wɔ wo nkwagye mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɛto dwom ama Awurade,","poem":1},{"text":"efisɛ ɔne me adi no yiye.","poem":2},{"text":"Wɔde ma dwonkyerɛfo no.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}