{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Ɔsoroforo dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade, mifi bun mu su frɛ wo;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Awurade, tie me nne.","poem":2},{"text":"Wɛn wʼaso","poem":1},{"text":"ma me nkotosrɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Awurade, sɛ wubu yɛn bɔne ho nkontaa a,","poem":1},{"text":"anka hena na obetumi agyina ano?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso wowɔ bɔnefakyɛ;","poem":1},{"text":"ɛno nti wosuro wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Metwɛn Awurade, me mu ade nyinaa twɛn,","poem":1},{"text":"na nʼasɛm mu na mede mʼanidaso ahyɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Metwɛn Awurade","poem":1},{"text":"sen sɛnea awɛmfo twɛn adekyee,","poem":2},{"lineBreak":true},{"text":"sen sɛnea awɛmfo twɛn adekyee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel, ma wʼani nna Awurade so,","poem":1},{"text":"efisɛ Awurade wɔ adɔe a enni huammɔ","poem":2},{"lineBreak":true},{"text":"na ogye ankasa wɔ ne mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔno ankasa begye Israel","poem":1},{"text":"afi wɔn bɔne nyinaa mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}