{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Ɔsoroforo dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade kae Dawid","poem":1},{"text":"ne ɔhaw ahorow a ogyinaa ano no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɔkaa Awurade ntam,","poem":1},{"text":"na ɔhyɛɛ nea ɔyɛ Otumfo ma Yakob no bɔ se,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Merenhyɛn me fi","poem":1},{"text":"na merenkɔda me mpa so,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"meremma nna mmfa me","poem":1},{"text":"na meremma mʼani nkum,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kosi sɛ menya baabi ama Awurade,","poem":1},{"text":"baabi a nea ɔyɛ Otumfo ma Yakob No bɛtena.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yɛtee wɔ Efrata,","poem":1},{"text":"yɛbɛtoo so wɔ Yaar mfuw so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Momma yɛnkɔ nʼatenae;","poem":1},{"text":"momma yɛnsom wɔ ne nan ntiaso hɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘Awurade, sɔre bra wʼahomegyebea,","poem":1},{"text":"wo ne wo tumi adaka no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ma trenee nyɛ sɛ ntade mma wʼasɔfo;","poem":1},{"text":"ma wʼahotefo nto ahurusi nnwom.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wo somfo Dawid nti,","poem":1},{"text":"nyi wʼani mfi nea woasra no ngo no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awurade kaa ntam kyerɛɛ Dawid,","poem":1},{"text":"nokware ntam a ɔntwe nsan se,","poem":2},{"text":"“Wʼasefo no mu baako","poem":1},{"text":"na mede no bɛtena wʼahengua so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ wo mmabarima di mʼapam so","poem":1},{"text":"na wotie me nkyerɛkyerɛ a,","poem":2},{"text":"ɛno de wɔn mmabarima bɛtena","poem":1},{"text":"wʼahengua so afebɔɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Awurade ayi Sion,","poem":1},{"lineBreak":true},{"text":"ɔde hɔ ayɛ nʼatenae:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Ɛha ne mʼahomegyebea daa nyinaa;","poem":1},{"text":"ɛha na mɛtena adi hene, efisɛ ha na mepɛ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mede nneɛma pa bebree behyira no","poem":1},{"text":"na mama nʼahiafo adidi amee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mede nkwagye befura nʼasɔfo,","poem":1},{"text":"na nʼahotewfo ato ahurusi nnwom daa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mɛma obirɛmpɔn bi apue wɔ Dawid ahenni mu,","poem":1},{"text":"na mede kanea asi hɔ ama nea masra no ngo no.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mede aniwu befura nʼatamfo,","poem":1},{"text":"nanso wɔbɛhyɛ no ahenkyɛw a ɛhyerɛn.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}