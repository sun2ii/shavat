{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Monkamfo Awurade din;","poem":1},{"text":"monkamfo no, mo Awurade asomfo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mo a mosom wɔ Awurade fi,","poem":1},{"text":"wɔ adiwo a ɛwɔ yɛn Nyankopɔn fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Monkamfo Awurade efisɛ oye;","poem":1},{"text":"monto ayeyi nnwom mma ne din, na ɛno na ɛyɛ anisɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Awurade ayi Yakob sɛ ɔnyɛ ne de,","poem":1},{"text":"wayi Israel sɛ nʼade a ɛsom bo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Minim sɛ Awurade so;","poem":1},{"text":"Ɔso sen anyame nyinaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awurade yɛ nea ɔpɛ biara","poem":1},{"text":"wɔ ɔsoro ne asase so,","poem":2},{"lineBreak":true},{"text":"po ne mu bun nyinaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔma omununkum ma ne ho so fi asase ano ba;","poem":1},{"text":"ɔsoma anyinam ka osu ho","poem":2},{"lineBreak":true},{"text":"na ɔma ahum tu fi ne koradan mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Okum Misraim mmakan,","poem":1},{"text":"nnipa ne mmoa mmakan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔsomaa ne nsɛnkyerɛnne ne nʼanwonwade baa mo mfimfini, Misraim,","poem":1},{"text":"de tiaa Farao ne nʼasomfo nyinaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɔsɛee amanaman pii,","poem":1},{"text":"na okunkum ahemfo akɛse,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amorifo hene, Sihon","poem":1},{"text":"Basan hene, Og","poem":2},{"lineBreak":true},{"text":"ne Kanaan ahemfo nyinaa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"na ɔde wɔn nsase maa sɛ agyapade","poem":1},{"text":"ɔde maa ne nkurɔfo Israelfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Awurade, wo din wɔ hɔ daa.","poem":1},{"text":"Awurade wo din ahyeta awo ntoatoaso nyinaa mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Awurade bedi ama ne nkurɔfo","poem":1},{"lineBreak":true},{"text":"na obehu nʼasomfo mmɔbɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Amanaman no ahoni yɛ dwetɛ ne sikakɔkɔɔ","poem":1},{"text":"a wɔde onipa nsa na ayɛ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔwɔ ano, nanso wontumi nkasa,","poem":1},{"text":"wɔwɔ ani, nanso wonhu ade;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"wɔwɔ aso, nanso wɔnte asɛm,","poem":1},{"text":"na ɔhome nso nni wɔn anom.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,","poem":1},{"text":"saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Monkamfo Awurade, mo Israelfo nyinaa;","poem":1},{"text":"monkamfo Awurade, Aaron fi;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"monkamfo Awurade, Lewi fi;","poem":1},{"text":"monkamfo Awurade, mo a musuro no.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mumfi Sion nkamfo Awurade,","poem":1},{"text":"monkamfo nea ɔte Yerusalem no.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}