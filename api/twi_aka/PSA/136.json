{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Monna Awurade ase na oye.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":2,"content":[{"text":"Monna anyame mu Nyankopɔn no ase.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":3,"content":[{"text":"Monna awuranom mu Awurade no ase.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":4,"content":[{"text":"Ɔno nko ara na ɔyɛ anwonwade akɛse.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":5,"content":[{"text":"Ɔno na ofi ne ntease mu bɔɔ ɔsoro.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":6,"content":[{"text":"Ɔno na ɔtrɛw asase mu de kataa nsu so.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":7,"content":[{"text":"Ɔno na ɔbɔɔ akanea akɛse no.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":8,"content":[{"text":"Ɔbɔɔ owia sɛ enni adekyee so.","poem":1},"Nʼadɔe wɔ hɔ daa;"]},{"type":"verse","number":9,"content":[{"text":"Ɔbɔɔ sram ne nsoromma sɛ wonni adesae so no.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔno na okunkum Misraimfo mmakan,","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":11,"content":[{"text":"na oyii Israelfo fii wɔn mu no.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":12,"content":[{"text":"Ɔde nsa kɛse ne basa a wateɛ mu.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":13,"content":[{"text":"Ɔno na ɔpaee Po Kɔkɔɔ no mu no,","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":14,"content":[{"text":"na ɔde Israelfo faa mfimfini no.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":15,"content":[{"text":"Nanso ɔpraa Farao ne nʼasraafo guu Po Kɔkɔɔ mu no.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔno na odii ne nkurɔfo anim wɔ sare no so.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ɔno na okum ahemfo akɛse no,","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":18,"content":[{"text":"na okum ahemfo akunini no.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":19,"content":[{"text":"Okum Amorifo hene, Sihon,","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":20,"content":[{"text":"ne Basanhene, Og.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":21,"content":[{"text":"Na ɔde wɔn nsase maa sɛ agyapade.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":22,"content":[{"text":"Ɔde maa ne somfo Israel sɛ agyapade.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ɔkaee yɛn, yɛn mmerɛwyɛ mu.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":24,"content":[{"text":"Na ogyee yɛn fii yɛn atamfo nsam.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"verse","number":25,"content":[{"text":"Ɔno na ɔma abɔde biara aduan.","poem":1},"Nʼadɔe wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Monna ɔsorosoro Nyankopɔn no ase.","poem":1},"Nʼadɔe wɔ hɔ daa."]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}