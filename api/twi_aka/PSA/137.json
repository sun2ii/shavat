{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Babilonia nsubɔnten ho, ɛhɔ na yɛtena suu","poem":1},{"text":"bere a yɛkaee Sion no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɛhɔ konkɔn so nnua mu","poem":1},{"text":"na yɛde yɛn asanku sensɛnee,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ɛhɔ na yɛn nnommumfafo kaa se yɛnto nnwom,","poem":1},{"text":"yɛn ahohiafo hwehwɛɛ anigye nnwom fii yɛn nkyɛn;","poem":2},{"lineBreak":true},{"text":"wɔkae se, “Monto Sion nnwom baako nkyerɛ yɛn!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɛbɛyɛ dɛn na yɛatumi ato Awurade nnwom,","poem":1},{"text":"bere a yɛwɔ ananafo asase so?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yerusalem, sɛ me werɛ fi wo a","poem":1},{"text":"ma me nsa nifa werɛ mfi sankubɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sɛ mankae wo a,","poem":1},{"text":"ma me tɛkrɛma nka ntare mʼanom","poem":2},{"text":"sɛ mamfa Yerusalem","poem":1},{"text":"sɛ mʼanigyede kɛse pa ara a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kae, Awurade, nea Edomfo yɛɛ","poem":1},{"text":"da a Yerusalem hwee ase no.","poem":2},{"text":"Wɔteɛɛ mu se, “Munnwiriw,","poem":1},{"text":"munnwiriw ngu fam nkɔka ne fapem!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔbabea Babilonia, wɔadome wo akɔ ɔsɛe mu,","poem":1},{"text":"nea otua wo ka bio ani gye","poem":2},{"lineBreak":true},{"text":"wɔ nea wode ayɛ yɛn no ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nea ɔkyere wo nkokoaa","poem":1},{"text":"de wɔn dwiradwira abotan no ani gye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}