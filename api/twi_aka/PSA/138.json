{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Dawid de."]},{"type":"verse","number":1,"content":[{"text":"Awurade, mede me koma nyinaa ayi wo ayɛ;","poem":1},{"text":"mɛto wʼayeyi dwom wɔ “anyame” no anim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mede mʼani bɛkyerɛ wʼasɔredan kronkron no, akotow wo","poem":1},{"text":"na makamfo wo din","poem":2},{"lineBreak":true},{"text":"wɔ wʼadɔe a enni huammɔ ne wo nokwaredi nti,","poem":2},{"text":"efisɛ woama wʼahyɛde no so yiye;","poem":1},{"text":"ama asen wo titiriwyɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bere a misu frɛɛ wo no, wugyee me so;","poem":1},{"text":"woma minyaa akokoduru ne nnamyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awurade, sɛ ahemfo a wɔwɔ wiase nyinaa te nea woahyɛ no a,","poem":1},{"text":"ma wɔnkamfo wo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ma wɔnto Awurade akwan ho nnwom,","poem":1},{"text":"na Awurade anuonyam yɛ kɛse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɛwɔ mu sɛ Awurade wɔ ɔsorosoro de, nanso ɔhwɛ mmɔborɔfo,","poem":1},{"text":"na ahantanfo de, ohu wɔn wɔ akyirikyiri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɛwɔ mu sɛ menam ɔhaw mu de,","poem":1},{"text":"nanso wobɔ me nkwa ho ban;","poem":2},{"text":"woteɛ wo nsa wɔ mʼatamfo abufuw so,","poem":1},{"text":"na wode wo nsa nifa gye me nkwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade bɛma nea wahyehyɛ ama me no aba mu;","poem":1},{"text":"Awurade, wʼadɔe wɔ hɔ daa,","poem":2},{"lineBreak":true},{"text":"nnyaa wo nsa ano nnwuma akyidi.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}