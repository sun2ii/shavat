{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ɔkwasea ka wɔ ne koma mu se,","poem":1},{"text":"“Onyankopɔn bi nni hɔ.”","poem":2},{"text":"Wɔaporɔw, na wɔn nneyɛe yɛ fi","poem":1},{"text":"na wɔn mu biara nni hɔ a ɔyɛ ade pa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade fi ɔsoro hwɛ","poem":1},{"text":"adesamma wɔ fam","poem":2},{"text":"sɛ obehu wɔn mu bi a wɔwɔ ntease,","poem":1},{"text":"anaa ebinom a wɔhwehwɛ Onyankopɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanso nnipa nyinaa atwe wɔn ho afi Onyankopɔn ho;","poem":1},{"text":"wɔn nyinaa ayɛ bɔne.","poem":2},{"text":"Obiara nni hɔ a ɔyɛ papa.","poem":1},{"text":"Ɔbaako mpo nni hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Enti abɔnefo rensua nyansa ana?","poem":1},{"lineBreak":true},{"text":"Wɔwe me nkurɔfo te sɛnea nnipa di aduan.","poem":1},{"text":"Wonnsu mfrɛ Awurade?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nanso wonni, ehu akyekyere wɔn,","poem":1},{"text":"efisɛ Onyankopɔn te wɔn a wɔteɛ mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mo nnebɔneyɛfo sɛe ahiafo nhyehyɛe,","poem":1},{"text":"nanso, Awurade ne wɔn guankɔbea.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ao, Israel nkwagye mfi Sion mmra!","poem":1},{"text":"Awurade bɛsan de ne nkurɔfo agyapade ama wɔn.","poem":2},{"lineBreak":true},{"text":"Na Yakob adi ahurusi, na Israel ani agye!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}