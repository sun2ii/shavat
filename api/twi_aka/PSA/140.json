{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade, gye me fi nnebɔneyɛfo nsam;","poem":1},{"text":"bɔ me ho ban fi basabasayɛfo nsam,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"wɔn a wodwen bɔne wɔ wɔn koma mu","poem":1},{"text":"na wɔhwanyan ɔko mu da biara.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔsew wɔn tɛkrɛma ano te sɛ ɔwɔ de;","poem":1},{"text":"nhurutoa bɔre wɔ wɔn ano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awurade, yi me fi amumɔyɛfo nsam;","poem":1},{"text":"bɔ me ho ban fi basabasayɛfo a","poem":2},{"lineBreak":true},{"text":"wodwen sɛ wobetwintwan mʼanan mu no ho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ahantanfo asum me afiri;","poem":1},{"text":"wɔatrɛtrɛw wɔn asau ahama mu","poem":2},{"lineBreak":true},{"text":"wɔasunsum me mfiri wɔ me kwan so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Awurade, meka kyerɛ wo se, “Wone me Nyankopɔn.”","poem":1},{"text":"Awurade, tie me mmɔborɔsu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Otumfo Awurade, me gyefo hoɔdenfo,","poem":1},{"text":"wokata me ti so wɔ ɔko da,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nyɛ amumɔyɛfo abisade mma wɔn, Awurade;","poem":1},{"text":"mma wɔn nhyehyɛe nnyɛ yiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wɔatwa me ho ahyia,","poem":1},{"text":"nanso, ma amumɔyɛsɛm a efi wɔn anom no nsɛe wɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ma nnyansramma ngu wɔn so;","poem":1},{"text":"ma wɔntow wɔn ngu ogya mu,","poem":2},{"lineBreak":true},{"text":"ngu dontori amoa mu a wɔrensɔre bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mma dinsɛefo ase ntim asase no so;","poem":1},{"text":"ma amanehunu ntaataa kitikitiyɛfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Minim sɛ Awurade bu ahiafo atɛntrenee","poem":1},{"text":"na odi onnibi asɛm ma no.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ampa ara, atreneefo bɛkamfo wo din","poem":1},{"text":"na wɔn a wɔnam tee no bɛtena nkwa mu wɔ wʼanim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}