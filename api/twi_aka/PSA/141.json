{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade, misu frɛ wo, bra me nkyɛn ntɛm so.","poem":1},{"text":"Sɛ misu frɛ wo a, gye me so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ma me mpaebɔ mmra wʼanim sɛ aduhuam;","poem":1},{"text":"ma me nsa a mema so no nyɛ sɛ anwummere afɔrebɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Awurade, ma ɔwɛmfo nwɛn mʼano;","poem":1},{"text":"na wɛn mʼano pon.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mma wɔnntwe me koma nnkɔ nea ɛyɛ bɔne ho,","poem":1},{"text":"na ankɔyɛ nea amumɔyɛfo yɛ no bi,","poem":2},{"text":"mma me ne abɔnefo","poem":1},{"text":"nni wɔn nnɔkɔnnɔkɔwade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma ɔtreneeni mmɔ me, ɛyɛ ayamye;","poem":1},{"text":"ma ɔnka mʼanim, ɛyɛ me ti so ngo.","poem":2},{"text":"Me ti rempo.","poem":1},{"text":"Me mpaebɔ da so tia abɔnefo nneyɛe daa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wɔbɛtow wɔn sodifo afi ɔbotan so abɛhwe fam;","poem":1},{"text":"na amumɔyɛfo behu sɛ me nsɛm no yɛ nokware.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔbɛka se, “Sɛnea obi funtum na otutu asase no,","poem":1},{"text":"saa ara na wɔabɔ yɛn nnompe ahwete ɔda ano.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nanso Otumfo Awurade, mʼani wɔ wo so;","poem":1},{"text":"wo mu na mihintaw, nnyaw me mma owu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bɔ me ho ban fi mfiri a wɔasunsum me no ho,","poem":1},{"text":"mfiri a abɔnefo asunsum no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ma amumɔyɛfo no ankasa ɔtan nyi wɔn,","poem":1},{"text":"bere a mitwa mu kɔ dwoodwoo no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}