{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Dawid de. Bere a na ɔwɔ ɔbodan mu no. Mpaebɔ."]},{"type":"verse","number":1,"content":[{"text":"Meteɛ mu su frɛ Awurade;","poem":1},{"text":"mema me nne so su frɛ Awurade sɛ onhu me mmɔbɔ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mihwie mʼahiasɛm gu nʼanim;","poem":1},{"text":"meka me haw kyerɛ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sɛ me kra tɔ beraw wɔ me mu a,","poem":1},{"text":"ɛyɛ wo na wunim me kwan.","poem":2},{"text":"Ɔkwan a menam so no","poem":1},{"text":"nnipa asum me afiri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hwɛ na hu, obiara nni me nifa so;","poem":1},{"text":"mʼasɛm mfa obiara ho;","poem":2},{"text":"minni guankɔbea bi;","poem":1},{"text":"me nkwa mfa obiara ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade, misu frɛ wo;","poem":1},{"text":"mise, “Wone me guankɔbea,","poem":2},{"lineBreak":true},{"text":"me kyɛfa wɔ ateasefo asase so.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tie me sufrɛ,","poem":1},{"text":"na mewɔ ahohia kɛse mu;","poem":2},{"text":"gye me fi mʼataafo nsam,","poem":1},{"text":"efisɛ wɔn ho yɛ den sen me.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yi me fi mʼafiase,","poem":1},{"text":"na makamfo wo din.","poem":2},{"lineBreak":true},{"text":"Afei atreneefo betwa me ho ahyia","poem":1},{"text":"esiane wo papa a woayɛ me no nti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}