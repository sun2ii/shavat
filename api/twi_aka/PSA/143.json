{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade, tie me mpaebɔ,","poem":1},{"text":"tie me mmɔborɔsu;","poem":2},{"text":"fi wo nokwaredi ne trenee mu","poem":1},{"text":"bra bɛboa me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mfa wʼakoa nkɔ atemmu mu,","poem":1},{"text":"na ɔteasefo biara nteɛ wɔ wʼanim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔtamfo no taa me,","poem":1},{"text":"ɔbɔ me hwe fam;","poem":2},{"text":"ɔma me tena sum mu","poem":1},{"text":"te sɛ wɔn a wowuwuu dedaada.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɛno nti me honhom atɔ beraw wɔ me mu;","poem":1},{"text":"na me koma di yaw wɔ me mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mekae tete nna no;","poem":1},{"text":"midwinnwen wo nnwuma","poem":2},{"lineBreak":true},{"text":"ne nea wo nsa ayɛ nyinaa ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mema me nsa so kyerɛ wo;","poem":1},{"text":"wo ho sukɔm de me kra sɛ asase kesee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade, gye me so ntɛm;","poem":1},{"text":"me honhom tɔ piti.","poem":2},{"text":"Mfa wʼanim nhintaw me","poem":1},{"text":"anyɛ saa a mɛyɛ sɛ wɔn a wɔkɔ amoa mu no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ma mente wʼadɔe a ɛnsa da no ho asɛm daa anɔpa,","poem":1},{"text":"na mede me ho ato wo so.","poem":2},{"text":"Kyerɛ me ɔkwan a memfa so,","poem":1},{"text":"na wo na mema me kra so kyerɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade gye me fi mʼatamfo nsam,","poem":1},{"text":"na wo mu na mede me ho hintaw.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kyerɛ me na menyɛ wʼapɛde,","poem":1},{"text":"na wo ne me Nyankopɔn;","poem":2},{"text":"ma wo honhom pa no","poem":1},{"text":"nkogya me asasetaw so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awurade, wo din nti, kyɛe me nkwa so;","poem":1},{"text":"wo trenee mu, yi me fi ɔhaw mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Fi wʼadɔe a ɛnsa da no mu mua mʼatamfo ano;","poem":1},{"text":"na sɛe wɔn a wokyi me no nyinaa,","poem":2},{"lineBreak":true},{"text":"na meyɛ wo somfo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}