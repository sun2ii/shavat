{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Me kra, kamfo Awurade!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɛkamfo Awurade me nkwanna nyinaa;","poem":1},{"text":"mɛto ayeyi dwom ama me Nyankopɔn, sɛ mete ase yi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mommfa mo ho nto mmapɔmma so,","poem":1},{"text":"adesamma a wɔrentumi nnye nkwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sɛ wɔn honhom tu kɔ a, wɔsan kɔ dɔte mu,","poem":1},{"text":"saa da no ara wɔn nsusuwii nyinaa yɛ ɔkwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhyira ne nea ne boafo ne Yakob Nyankopɔn,","poem":1},{"text":"nea nʼanidaso wɔ Awurade, ne Nyankopɔn mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɔno ne ɔsoro ne asase Yɛfo,","poem":1},{"text":"po ne biribiara a ɛwɔ mu nyinaa","poem":2},{"lineBreak":true},{"text":"Awurade a ɔyɛ nokwafo daa no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Odi ma wɔn a wɔhyɛ wɔn so,","poem":1},{"text":"na ɔma wɔn a ɔkɔm de wɔn aduan.","poem":2},{"lineBreak":true},{"text":"Awurade gyaa nneduafo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade ma anifuraefo hu ade.","poem":1},{"text":"Awurade ma wɔn a wɔakom no so,","poem":2},{"lineBreak":true},{"text":"Awurade dɔ atreneefo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade hwɛ ahɔho so,","poem":1},{"text":"na ɔwowaw ayisaa ne akunafo,","poem":2},{"lineBreak":true},{"text":"na amumɔyɛfo akwan de, ɔdan ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade di hene daa daa,","poem":1},{"text":"Ao, Sion, wo Nyankopɔn, wɔ awo ntoatoaso nyinaa so.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}