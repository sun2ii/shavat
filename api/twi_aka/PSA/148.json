{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade!","poem":1},{"lineBreak":true},{"text":"Monkamfo Awurade mfi ɔsorosoro,","poem":1},{"text":"monkamfo no wɔ ɔsoro sorɔnsorɔmmea.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nʼabɔfo nyinaa, monkamfo no,","poem":1},{"text":"ne ɔsoro asafo nyinaa, monkamfo no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Owia ne ɔsram, monkamfo no,","poem":1},{"text":"nsoromma a ɛhyerɛn nyinaa, monkamfo no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Monkamfo no, ɔsoro mu soro","poem":1},{"text":"ne mo nsu a mowɔ ɔsoro atifi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Momma wɔn nyinaa nkamfo Awurade din,","poem":1},{"text":"efisɛ ɔno na ɔhyɛ ma wɔbɔɔ wɔn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔde wɔn sisii hɔ afebɔɔ;","poem":1},{"text":"na ɔmaa ɔhyɛ nsɛm bi a ɛrentwa mu da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Monkamfo Awurade mfi asase so,","poem":1},{"text":"mo po kɛse mu abɔde ne po bun nyinaa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"anyinam ne mparuwbo, sukyerɛmma ne omununkum,","poem":1},{"text":"ahum a moyɛ nʼapɛde,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"mo mmepɔw ne nkoko nyinaa,","poem":1},{"text":"nnua a ɛsow aba ne sida nyinaa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nwura mu mmoa ne anantwi,","poem":1},{"text":"abɔde nketewa ne nnomaa a wotu,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"asase ne amanaman nyinaa so ahemfo,","poem":1},{"text":"mo mmapɔmma ne asase sodifo nyinaa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mmerante ne mmabaa,","poem":1},{"text":"mmasiriwa ne mmofra nso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma wɔnkamfo Awurade din,","poem":1},{"text":"na ne din so sen din biara;","poem":2},{"lineBreak":true},{"text":"nʼanuonyam korɔn wɔ asase ne ɔsoro so.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wapagyaw mmɛn bi ama ne nkurɔfo,","poem":1},{"text":"nʼahotewfo nyinaa nkamfo;","poem":2},{"lineBreak":true},{"text":"Israelfo, nnipa a wɔda ne koma so no nkamfo.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}