{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Monto dwom foforo mma Awurade,","poem":1},{"text":"monkamfo no wɔ ahotefo asafo mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ma Israel ani nnye ne Yɛfo mu.","poem":1},{"text":"Ma Sion mma ani nnye wɔn Hene mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma wɔmfa asaw nkamfo ne din","poem":1},{"text":"na wɔmfa sanku ne akasaa nto dwom mma no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na Awurade ani sɔ ne nkurɔfo;","poem":1},{"text":"ɔde nkwagye kyɛw hyɛ ahobrɛasefo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momma ahotefo nni ahurusi wɔ anuonyam yi mu;","poem":1},{"text":"na wɔnto ahosɛpɛw dwom wɔ wɔn mpa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Onyankopɔn nkamfo nhyɛ wɔn anom,","poem":1},{"text":"na ɛnyɛ afoa anofanu wɔ wɔn nsam,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"sɛ wɔmfa ntɔ were wɔ amanaman no so","poem":1},{"text":"ne asotwe wɔ nnipa no so,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"sɛ wɔmfa nyɛ nkɔnsɔnkɔnsɔn nkyekyere wɔn ahemfo,","poem":1},{"text":"ne dade mpokyerɛ ngu wɔn atitiriw,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"sɛ wɔmfa mmu atɛn, sɛnea wɔakyerɛw atia wɔn no.","poem":1},{"text":"Eyi ne nʼahotewfo nyinaa anuonyam.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}