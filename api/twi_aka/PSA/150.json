amfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}