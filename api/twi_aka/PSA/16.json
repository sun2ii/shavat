{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Dawid mpaebɔ."]},{"type":"verse","number":1,"content":[{"text":"Bɔ me ho ban, me Nyankopɔn,","poem":1},{"text":"na wo mu na minya guankɔbea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Meka kyerɛɛ Awurade se,","poem":1},{"text":"“MʼAwurade ne wo;","poem":2},{"lineBreak":true},{"text":"minni ade pa biara ka wo ho.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahotefo a wɔwɔ asase no so de,","poem":1},{"text":"wɔne anuonyamfo a","poem":2},{"lineBreak":true},{"text":"mʼanigye wɔ wɔn mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔn a wodi anyame afoforo akyi no,","poem":1},{"text":"wɔn awerɛhow bɛdɔɔso.","poem":2},{"text":"Merengu mogya nsa mma saa anyame no","poem":1},{"text":"na meremfa mʼano mmɔ wɔn din.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade, wode me kyɛfa ne me kuruwa ama me;","poem":1},{"text":"woama me kyɛfa anya bammɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mʼahye akɔdeda mmeae a eye ama me;","poem":1},{"text":"ampa ara mewɔ agyapade a ho yɛ anigye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɛkamfo Awurade a otu me fo;","poem":1},{"text":"na anadwo mpo, me koma kyerɛkyerɛ me.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mihu Awurade wɔ mʼani so daa nyinaa.","poem":1},{"text":"Esiane sɛ ɔwɔ me nsa nifa nti, merenhinhim da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛno nti, me kra ani gye, na mede me tɛkrɛma di ahurusi;","poem":1},{"text":"me nipadua nso bɛhome asomdwoe mu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"efisɛ, worennyaw me awufo mu.","poem":1},{"text":"Na woremma wo Kronkronni no mporɔw.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Woakyerɛ me nkwagye kwan,","poem":1},{"text":"na wobɛma mʼani agye wɔ wʼanim,","poem":2},{"lineBreak":true},{"text":"na anigye a ɛrensa da wɔ wo nifa so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}