{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["Dawid Mpaebɔ."]},{"type":"verse","number":1,"content":[{"text":"Awurade, tie me trenee abisade;","poem":1},{"text":"tie me sufrɛ.","poem":2},{"text":"Yɛ aso ma me mpaebɔ;","poem":1},{"text":"nea emfi nnaadaa anofafa mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ma me bembu mfi wo;","poem":1},{"text":"ma wʼani nhu nea ɛyɛ pɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wopɛɛpɛɛ me koma mu,","poem":1},{"text":"wohwehwɛ me mu anadwo,","poem":2},{"text":"na wosɔ me hwɛ de, nanso wubehu sɛ minsusuw bɔne bi ɛ;","poem":1},{"text":"mʼano nkaa bɔne bi ɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nnipa nneyɛe fam no,","poem":1},{"text":"anom asɛm nti","poem":2},{"text":"matwe me ho afi","poem":1},{"text":"basabasayɛfo akwan ho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Menam wʼakwan so daa;","poem":1},{"text":"me nan nhintiw ɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Misu mefrɛ wo, Onyankopɔn","poem":1},{"text":"na wubegye me so;","poem":2},{"lineBreak":true},{"text":"yɛ aso ma me na tie me mpaebɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Da wo dɔ nwonwaso no adi;","poem":1},{"text":"wo a wode wo nsa nifa","poem":2},{"text":"gye wɔn a wɔde wɔn ho to wo so no nkwa","poem":1},{"text":"fi wɔn atamfo nsam no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hwɛ me so sɛ obi a wodɔ no;","poem":1},{"text":"fa me sie wo ntaban nwini no ase,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"fi amumɔyɛfo a wɔretaataa me no nsam,","poem":1},{"text":"mʼatamfo a wɔatwa me ho ahyia no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wopirim wɔn koma,","poem":1},{"text":"na wɔkasa ahantan so.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔadi me ntɛntɛ, afei wɔatwa me ho ahyia;","poem":1},{"text":"wɔn ani abere sɛ wɔbɛbɔ me ahwe fam.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔte sɛ gyata a hanam ho kɔm de no,","poem":1},{"text":"te sɛ gyata kɛse bi a wabutuw wɔ ahintawee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sɔre, Awurade!","poem":1},{"text":"Wone wɔn mfa mmɔ ani na ka wɔn hyɛ;","poem":2},{"lineBreak":true},{"text":"fa wʼafoa no gye me fi amumɔyɛfo no nsam.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Awurade, fa wo nsa","poem":1},{"text":"gye me fi nnipa a wɔte sɛɛ nsam;","poem":2},{"lineBreak":true},{"text":"asase so nnipa a wɔn akatua wɔ nkwa yi mu no.","poem":2},{"text":"Womma ɔkɔm nne wɔn a wʼani ku wɔn ho;","poem":1},{"text":"wɔn mmabarima wɔ bebree,","poem":2},{"lineBreak":true},{"text":"na wɔkora agyapade ma wɔn mma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Na me trenee mu, mehu wʼanim;","poem":1},{"text":"sɛ minyan na mihu wo a me koma bɛtɔ me yam.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}