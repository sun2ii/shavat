{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ɔsoro ka Onyankopɔn anuonyam!","poem":1},{"text":"Wim pae mu ka ne nsa ano adwuma,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Da biara, wɔkasa;","poem":1},{"text":"anadwo biara, wɔda nimdeɛ adi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wonni ɔkasa, wɔnnka nsɛm;","poem":1},{"text":"wɔnnte wɔn nne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔn nne akodu asase so mmaa nyinaa,","poem":1},{"text":"na wɔn nsɛm nso akodu asase ano.","poem":2},{"lineBreak":true},{"text":"Onyankopɔn asi ntamadan ama owia wɔ ɔsoro hɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Ɛte sɛ ayeforokunu a ofi ne pia mu,","poem":2},{"lineBreak":true},{"text":"te sɛ ɔbran a ne ho pere no sɛ obetu ne mmirika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Epue wɔ ɔsoro fa baabi","poem":1},{"text":"na atwa ne ho akosi ano;","poem":2},{"lineBreak":true},{"text":"biribiara nsiw ne hyew ho kwan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade mmara yɛ pɛ,","poem":1},{"text":"ɛkanyan ɔkra no.","poem":2},{"text":"Ahotoso wɔ Awurade nhyehyɛe mu,","poem":1},{"text":"ɛma nea onnim nyansa hu nyansa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade ahyɛde teɛ;","poem":1},{"text":"ɛma koma mu anigye.","poem":2},{"text":"Awurade ɔhyɛ nsɛm mu da hɔ;","poem":1},{"text":"na ebue ani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade suro yɛ kronkron,","poem":1},{"text":"ɛte hɔ daa.","poem":2},{"text":"Awurade mmara nsɛm yɛ nokware","poem":1},{"text":"na ne nyinaa teɛ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɛsom bo sen sikakɔkɔɔ","poem":1},{"text":"ɛsen sikakɔkɔɔ kann;","poem":2},{"text":"ɛyɛ dɛ sen ɛwo,","poem":1},{"text":"ɛsen ɛwo a efi ɛwokyɛm mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔnam so bɔ wo somfo kɔkɔ se,","poem":1},{"text":"sodi so akatua yɛ bebree.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hena na ohu nʼankasa mfomso?","poem":1},{"text":"Fa me mfomso a ahintaw kyɛ me.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bɔ wʼakoa ho ban fi ɔboayɛ bɔne ho,","poem":1},{"text":"na anhyɛ me so.","poem":2},{"text":"Ɛno na ɛbɛma madi bem,","poem":1},{"text":"a merenni fɔ wɔ bɔne akɛse ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ma mʼanom nsɛm ne me koma mu adwene","poem":1},{"text":"nyɛ nea ɛsɔ wʼani, Awurade","poem":2},{"lineBreak":true},{"text":"me Botan ne me Gyefo.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}