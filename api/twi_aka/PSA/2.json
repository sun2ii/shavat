{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Adɛn nti na amanaman no hyehyɛ bɔne ho","poem":1},{"text":"na nnipa no bɔ pɔw hunu yi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asase so ahemfo sɔre gyina","poem":1},{"text":"na sodifo ka wɔn ho bɔ mu","poem":2},{"lineBreak":true},{"text":"tia Awurade ne Nea Wɔasra no no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔka se,","poem":1},{"text":"“Momma yemmubu wɔn nkɔnsɔnkɔnsɔn","poem":2},{"lineBreak":true},{"text":"na yɛntow wɔn mpokyerɛ ngu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nea ɔte agua so wɔ ɔsoro no serew;","poem":1},{"text":"Awurade di wɔn ho fɛw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afei ɔka wɔn anim wɔ nʼabufuw mu,","poem":1},{"text":"hunahuna wɔn wɔ nʼabufuwhyew mu, ka se,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Masi me Hene","poem":1},{"text":"wɔ Sion, me bepɔw kronkron no so.”","poem":2}]},{"type":"verse","number":7,"content":["Mɛpae mu aka Awurade ahyɛde:",{"text":"Ɔka kyerɛɛ me se, “Woyɛ me Ba;","poem":1},{"text":"nnɛ mayɛ wʼAgya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bisa me,","poem":1},{"text":"na mede amanaman nyinaa bɛyɛ wʼagyapade,","poem":2},{"lineBreak":true},{"text":"asase ano nyinaa bɛyɛ wo de.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wode dade ahempema bedi wɔn so;","poem":1},{"text":"na woabobɔ wɔn sɛ ɔnwemfo ahina.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Enti mo ahemfo, munsua nyansa;","poem":1},{"text":"monkae kɔkɔbɔ yi, mo asase sodifo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Momfa osuro nsom Awurade","poem":1},{"text":"na monsɛpɛw mo ho ahopopo mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mumfew Ɔba no ano, na ne bo amfuw","poem":1},{"text":"na mo akwan de mo bɛkɔ ɔsɛe mu,","poem":2},{"text":"efisɛ nʼabufuwhyew tumi sɔre mpofirim.","poem":1},{"text":"Nhyira ne wɔn a woguan toa no nyinaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}