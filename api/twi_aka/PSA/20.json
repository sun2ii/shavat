{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade ntie wo wɔ wʼahohia mu;","poem":1},{"text":"Yakob Nyankopɔn din mmɔ wo ho ban.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɔmfa mmoa mfi kronkronbea hɔ mmrɛ wo,","poem":1},{"text":"na omfi Sion mmɛhyɛ wo den.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔnkae wʼafɔrebɔ nyinaa,","poem":1},{"text":"na ɔmma wo hyew afɔre nsɔ nʼani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔmma wo nea wo koma pɛ,","poem":1},{"text":"na wo nhyehyɛe nyinaa nyɛ yiye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yɛbɛbɔ ose bere a woadi nkonim,","poem":1},{"text":"na yɛama yɛn frankaa so wɔ yɛn Nyankopɔn din mu.","poem":2},{"lineBreak":true},{"text":"Awurade nyɛ wʼabisade nyinaa mma wo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Afei mahu sɛ Awurade ma nea wasra no no nkonimdi,","poem":1},{"text":"ofi ne kronkronbea wɔ ɔsoro gye no so,","poem":2},{"lineBreak":true},{"text":"ɔde ne nkonimdi tumi a ɛwɔ ne nsa nifa mu no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ebinom de wɔn ho to wɔn nteaseɛnam so","poem":1},{"text":"na afoforo nso, wɔn apɔnkɔ so,","poem":2},{"lineBreak":true},{"text":"nanso yɛn de, yɛde yɛn ho to Awurade yɛn Nyankopɔn din so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔbrɛ wɔn ase ma wɔhwehwe ase,","poem":1},{"text":"na yɛn de, yɛsɔre gyina kirebenn.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade, ma ɔhene nkonimdi!","poem":1},{"text":"Yɛfrɛ a, gye yɛn so!","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}