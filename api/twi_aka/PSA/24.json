{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Asase ne nea ɛwɔ mu nyinaa yɛ Awurade de;","poem":1},{"text":"wiase ne wɔn a wɔte mu nyinaa wɔ no;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"efisɛ ɔno na ɔtoo ne fapem wɔ po so","poem":1},{"text":"na ɔde sii nsu ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hena na obetumi aforo Awurade bepɔw no?","poem":1},{"text":"Hena na obetumi agyina ne tenabea kronkron hɔ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nea ɔyɛ ade trenee na ne koma mu tew,","poem":1},{"text":"nea ne kra nni ahoni akyi","poem":2},{"lineBreak":true},{"text":"na ɔnka ntamhunu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Obenya Awurade nsam nhyira","poem":1},{"text":"ne bembu a efi ne Nkwagye Nyankopɔn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saa na awo ntoatoaso a wɔhwehwɛ Awurade no te","poem":1},{"text":"wɔn a wɔhwehwɛ wʼanim no, Yakob Nyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mo aponkɛse, momma mo ti so;","poem":1},{"text":"wɔmma mo so, mo tete apon,","poem":2},{"lineBreak":true},{"text":"na Anuonyam Hene nhyɛn mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hena ne saa Anuonyam Hene yi?","poem":1},{"text":"Ɔno ne Awurade hoɔdenfo ne otumfo no","poem":2},{"lineBreak":true},{"text":"Awurade a ɔyɛ ɔko mu nkonimdifo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momma mo ti so, mo aponkɛse","poem":1},{"text":"momma wɔn so, mo tete apon,","poem":2},{"lineBreak":true},{"text":"na anuonyam Hene no nkɔ mu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hena ne saa anuonyam Hene yi?","poem":1},{"text":"Asafo Awurade no,","poem":2},{"lineBreak":true},{"text":"ɔno ne anuonyam Hene no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}