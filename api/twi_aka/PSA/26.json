{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Bu me bem, Awurade,","poem":1},{"text":"efisɛ, mabɔ bra a asɛm nni ho:","poem":2},{"text":"mede me ho too Awurade so","poem":1},{"text":"na manhinhim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sɔ me hwɛ, Awurade,","poem":1},{"text":"hwehwɛ me koma ne mʼadwene mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wʼadɔe wɔ mʼanim daa","poem":1},{"text":"na mɛnantew wo nokware mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Me ne nnaadaafo ntena","poem":1},{"text":"na me ne nyaatwomfo nso nni hwee yɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mikyi nnebɔneyɛfo guabɔ","poem":1},{"text":"na mempɛ sɛ me ne amumɔyɛfo tena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mehohoro me nsa wɔ bembu mu,","poem":1},{"text":"na mekɔ wʼafɔremuka ho ahyia, Awurade,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"na mepae mu ka wʼayeyi","poem":1},{"text":"na meka wʼanwonwade nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mʼani gye ofi a wote mu ho, Awurade,","poem":1},{"text":"faako a wʼanuonyam wɔ no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfa me kra nka nnebɔneyɛfo de ho nkɔ,","poem":1},{"text":"ne me nkwa nka mogyapɛfo de ho,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"wɔn a amumɔyɛ nhyehyɛe wɔ wɔn nsam","poem":1},{"text":"na adanmude ayɛ wɔn nsa nifa ma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nanso mebɔ ɔbra a ho tew;","poem":1},{"text":"hu me mmɔbɔ na gye me nkwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mʼanan sisi asase tamaa so;","poem":1},{"text":"na guabɔ kɛse ase na mɛkamfo Awurade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}