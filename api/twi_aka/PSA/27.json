{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade ne me hann ne me nkwagye;","poem":1},{"text":"hena na minsuro no?","poem":2},{"text":"Awurade ne me nkwa ahoɔden,","poem":1},{"text":"na hena anim na me ho mpopo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sɛ nnipa bɔne bɔ toa me","poem":1},{"text":"pɛ sɛ wokum me,","poem":2},{"text":"sɛ mʼatamfo tow hyɛ me so a,","poem":1},{"text":"wobehintihintiw ahwehwe ase.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛ dɔm mpo twa me ho hyia a,","poem":1},{"text":"me koma rentu;","poem":2},{"text":"mpo sɛ wotu me so sa a,","poem":1},{"text":"ɛno mu koraa na minya awerehyɛmu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ade baako na mibisa Awurade;","poem":1},{"text":"na ɛno na mehwehwɛ;","poem":2},{"text":"sɛ mɛtena Awurade fi","poem":1},{"text":"me nkwanna nyinaa,","poem":2},{"text":"na mahwɛ Awurade ahoɔfɛ","poem":1},{"text":"na mahwehwɛ no wɔ nʼasɔrefi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hiada mu no,","poem":1},{"text":"ɔde me besie nʼatenae dwoodwoo;","poem":2},{"text":"ɔbɛkora me wɔ Ahyiae Ntamadan kronkron mu","poem":1},{"text":"ɔde me si ɔbotan so wɔ sorosoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Afei ɔbɛma me ti so","poem":1},{"text":"wɔ atamfo a wɔatwa me ho ahyia no so;","poem":2},{"text":"mede anigye bɛbɔ afɔre wɔ nʼAhyiae Ntamadan mu;","poem":1},{"text":"na mɛto dwom, ahyehyɛ nnwom ama Awurade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade, sɛ misu frɛ wo a, tie me!","poem":1},{"text":"Hu me mmɔbɔ na gye me so!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Me koma ka wɔ wo ho se, “Hwehwɛ nʼanim!”","poem":1},{"text":"Wʼanim, Awurade na mɛhwehwɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfa wʼanim nhintaw me,","poem":1},{"text":"mfa abufuw mpam wo somfo","poem":2},{"lineBreak":true},{"text":"me boafo ne wo.","poem":2},{"text":"Mpo me, na nnyaw me,","poem":1},{"text":"mʼAgyenkwa Nyankopɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mʼagya ne me na begyaw me hɔ de,","poem":1},{"text":"nanso Awurade begye me.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kyerɛ me wʼakwan, Awurade;","poem":1},{"text":"fa me fa ɔkwan tee so,","poem":2},{"lineBreak":true},{"text":"me nhyɛsofo nti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nnyaa me mma sɛnea mʼatamfo pɛ,","poem":1},{"text":"nnansekurumfo sɔre tia me","poem":2},{"lineBreak":true},{"text":"na wopuw awurukasɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Meda so wɔ saa anidaso yi sɛ:","poem":1},{"text":"mehu Awurade ayamye","poem":2},{"lineBreak":true},{"text":"wɔ ateasefo asase so.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Twɛn Awurade.","poem":1},{"text":"Hyɛ wo ho den na ma wo bo nyɛ duru","poem":2},{"lineBreak":true},{"text":"na twɛn Awurade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}