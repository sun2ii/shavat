{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Wo na misu frɛ wo,","poem":1},{"text":"Awurade me Botan;","poem":2},{"lineBreak":true},{"text":"nsiw wʼaso wɔ me ho.","poem":2},{"text":"Sɛ woyɛ komm a,","poem":1},{"text":"mɛyɛ sɛ wɔn a wɔasian kɔ amoa mu no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tie me mmɔborɔsu","poem":1},{"text":"bere a mefrɛ wo apɛ mmoa,","poem":2},{"text":"bere a mema me nsa so","poem":1},{"text":"kyerɛ wo Tenabea Kronkron hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mfa me mfra amumɔyɛfo mu ntwe me nkɔ,","poem":1},{"text":"mfa me nka wɔn a wɔyɛ bɔne no ho.","poem":2},{"text":"Wɔne wɔn yɔnkonom kasa fɛfɛ,","poem":1},{"text":"nanso wɔde ɔtan sie wɔn koma mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Twe wɔn aso wɔ nea wɔayɛ no so;","poem":1},{"text":"wɔn adwuma bɔne no so;","poem":2},{"text":"tua nea wɔde wɔn nsa ayɛ so ka","poem":1},{"text":"na fa nea ɛfata wɔn san bra wɔn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sɛ wommu nea Awurade ayɛ","poem":1},{"text":"ne nea ɔde ne nsa ayɛ no nti","poem":2},{"text":"ɔbɛbrɛ wɔn ase","poem":1},{"text":"na ɔremma wɔnnsɔre bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ayeyi nka Awurade,","poem":1},{"text":"efisɛ watie me mmɔborɔsu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade ne mʼahoɔden ne me nkatabo","poem":1},{"text":"me koma wɔ ne mu ahotoso, na ɔboa me.","poem":2},{"text":"Me koma di ahurusi","poem":1},{"text":"na mede dwonto bɛda no ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade yɛ ahoɔden ma ne nkurɔfo;","poem":1},{"text":"ne nkwagye nsraban ma nea wɔasra no ngo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gye wo nkurɔfo na hyira wʼagyapade;","poem":1},{"text":"yɛ wɔn hwɛfo, na wo ne wɔn nnantew afebɔɔ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}