{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Momfa mma Awurade no, mo ɔsoro abɔde,","poem":1},{"text":"momfa anuonyam ne tumi mma Awurade.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Momfa anuonyam a ɛfata Awurade din mma no;","poem":1},{"text":"monsɔre Awurade wɔ nʼanuonyam kronkron mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Awurade nne wɔ nsu no so;","poem":1},{"text":"anuonyam Nyankopɔn bobɔ mu,","poem":2},{"text":"Awurade bobɔ mu wɔ nsu akɛse so.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Awurade nne mu wɔ tumi;","poem":1},{"text":"Awurade nne mu wɔ anuonyam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awurade nne bubu sida;","poem":1},{"text":"Awurade nne bubu Lebanon sida mu nketenkete","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔma Lebanon huruhuruw te sɛ nantwi ba,","poem":1},{"text":"na Sirion nso sɛ ɛko ba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade nne pa ma anyinam gya dɛw.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Awurade nne wosow sare so;","poem":1},{"text":"Awurade wosow Kades sare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade nne kyinkyim adum","poem":1},{"text":"na ɛma kwae yɛ kwaterekwa.","poem":2},{"text":"Nʼasɔredan mufo nyinaa teɛ mu ka se,","poem":1},{"text":"“Anuonyam nka Onyankopɔn!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade di hene wɔ nsuyiri so;","poem":1},{"text":"wɔasi Awurade hene afebɔɔ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade ma ne nkurɔfo ahoɔden,","poem":1},{"text":"na ɔde asomdwoe hyira wɔn.","poem":2},{"text":"Dwom a wɔto de buee Asɔredan no ano.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}