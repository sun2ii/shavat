{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom a ɔtoe bere a ɔreguan afi ne babarima Absalom anim."]},{"type":"verse","number":1,"content":[{"text":"Awurade, hwɛ sɛnea mʼatamfo dɔɔso fa!","poem":1},{"text":"dodow no ara na wɔsɔre tia me!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bebree no ara ka fa me ho se,","poem":1},{"text":"“Onyankopɔn rennye no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nanso wo, Awurade, woyɛ nkatabo a atwa me ho ahyia","poem":1},{"text":"mʼanuonyam, nea Ɔpagyaw me ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meteɛ mu su frɛ Awurade,","poem":1},{"text":"na ogye me so fi ne bepɔw kronkron no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Metɔ hɔ na meda a,","poem":1},{"text":"minyan bio, efisɛ Awurade ma migyina.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Merensuro atamfo mpem mpem a","poem":1},{"text":"wɔatwa me ho ahyia no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sɔre, Awurade!","poem":1},{"text":"Gye me, me Nyankopɔn!","poem":2},{"text":"Bobɔ mʼatamfo nyinaa abogye;","poem":1},{"text":"na tutu amumɔyɛfo se.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade hɔ na ogye fi ba.","poem":1},{"text":"Ma wo nhyira mmra wo nkurɔfo so.","poem":2},{"text":"Wɔde ma dwonkyerɛfo. Wɔto wɔ sankuhama so.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}