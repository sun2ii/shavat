{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Mɛma wo so, Awurade,","poem":1},{"text":"efisɛ, woayi me afi bun mu","poem":2},{"lineBreak":true},{"text":"na woamma mʼatamfo anserew me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade me Nyankopɔn, misu frɛɛ wo sɛ boa me","poem":1},{"text":"na wosaa me yare.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade, wuyii me fii ɔda mu;","poem":1},{"text":"wode me ho kyɛɛ me na woamma mankɔ amoa mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Monto ayeyi nnwom mma Awurade;","poem":1},{"text":"mo a moyɛ nʼahotewfo!","poem":2},{"text":"Monkamfo ne din kronkron no.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nʼabufuw nkyɛ,","poem":1},{"text":"na nʼadɔe wɔ hɔ daa;","poem":2},{"text":"agyaadwotwa bɛwɔ hɔ anadwo,","poem":1},{"text":"nanso ahosɛpɛw bɛba anɔpa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Metee nka sɛ mewɔ bammɔ no, mekae se,","poem":1},{"text":"“Merenhinhim da.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade, woyɛɛ me adom no","poem":1},{"text":"womaa me bepɔw gyinaa pintinn","poem":2},{"text":"na wode wʼanim hintaw me no,","poem":1},{"text":"me koma tui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wo, Awurade na mefrɛɛ wo;","poem":1},{"text":"wo hɔ na misu mesrɛɛ mmɔborɔhunu se:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Mfaso bɛn na ɛwɔ me sɛe so,","poem":1},{"text":"sɛ mɛkɔ amoa mu?","poem":2},{"text":"Mfutuma beyi wo ayɛ ana?","poem":1},{"text":"Ɛbɛpae mu aka wo nokwaredi ana?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tie me, Awurade, na hu me mmɔbɔ!","poem":1},{"text":"Awurade, yɛ me boafo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wodan mʼagyaadwotwa yɛɛ no asaw;","poem":1},{"text":"wuyii mʼatweaatam fii me ho","poem":2},{"lineBreak":true},{"text":"na wode anigye furaa me,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"sɛ me koma bɛto nnwom ama wo na ɛrenyɛ komm.","poem":1},{"text":"Awurade me Nyankopɔn, meyi wo ayɛ daa.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}