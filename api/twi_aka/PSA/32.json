{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Nhyira ne wɔn a","poem":1},{"text":"wɔde wɔn amumɔyɛ akyɛ wɔn,","poem":2},{"lineBreak":true},{"text":"na wɔakata wɔn bɔne so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nhyira nka onipa a","poem":1},{"text":"Awurade mmu ne bɔne ngu no so","poem":2},{"lineBreak":true},{"text":"na nnaadaa nni ne honhom mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bere a meyɛɛ komm no,","poem":1},{"text":"me nnompe yɛɛ mmrɛw,","poem":2},{"lineBreak":true},{"text":"apini a misii no da mu nyinaa nti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Awia ne anadwo","poem":1},{"text":"wo nsa yɛɛ den wɔ me so;","poem":2},{"text":"mʼahoɔden sae","poem":1},{"text":"te sɛ awia bere mu ɔhyew.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afei, migyee me bɔne too mu.","poem":1},{"text":"Mankata mʼamumɔyɛ so.","poem":2},{"text":"Mekae se, “Mɛka","poem":1},{"text":"me bɔne akyerɛ Awurade,”","poem":2},{"lineBreak":true},{"text":"na wode me bɔne ho afɔdi kyɛɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Enti, ma agyidifo nyinaa mmɔ wo mpae","poem":1},{"text":"bere a wohu wo;","poem":2},{"text":"ampa ara sɛ asu akɛse yiri a,","poem":1},{"text":"ɛrenka no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wone me hintabea;","poem":1},{"text":"wobɛbɔ me ho ban wɔ amanehunu mu","poem":2},{"lineBreak":true},{"text":"na wode nkwagye nnwom atwa me ho ahyia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɛkyerɛkyerɛ wo ɔkwan a wobɛfa so","poem":1},{"text":"metu wo fo na mahwɛ wo so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɛnyɛ sɛ ɔpɔnkɔ anaa afurumpɔnkɔ a","poem":1},{"text":"onni ntease nti","poem":2},{"text":"wɔde nnareka ne hama na ɛdannan no,","poem":1},{"text":"sɛ ɛbɛyɛ a wɔbɛba wo nkyɛn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omumɔyɛfo amanehunu dɔɔso,","poem":1},{"text":"nanso Awurade adɔe a ɛnsa da no","poem":2},{"lineBreak":true},{"text":"twa onipa a ɔde ne ho to no so no ho hyia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Munni ahurusi na mo ani nnye wɔ Awurade mu, mo atreneefo;","poem":1},{"text":"monto dwom, mo a mo koma mu tew.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}