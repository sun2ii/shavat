{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Awurade somfo Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Nkɔmhyɛ bi wɔ me koma mu a efi Onyankopɔn hɔ","poem":1},{"text":"a ɛfa omumɔyɛfo mmarato ho.","poem":2},{"text":"Onyankopɔn suro nni wɔn ani so.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na ɔno ankasa ani so no ɔdaadaa no ho dodo,","poem":1},{"text":"nti ɛmma onhu ne bɔne nnyae yɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nʼanom nsɛm yɛ atirimɔden ne nnaadaa;","poem":1},{"text":"onnim nyansa bio na wayɛ papa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔda ne mpa so mpo a ɔbɔ pɔw bɔne;","poem":1},{"text":"na ogyaa ne ho ma bɔne kwan","poem":2},{"lineBreak":true},{"text":"na ɔmpo nea enye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade, wʼadɔe du ɔsorosoro","poem":1},{"text":"wo nokwaredi du wim tɔnn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wo trenee te sɛ mmepɔw akɛse.","poem":1},{"text":"Wʼatɛntrenee mu dɔ sɛ po bun.","poem":2},{"text":"Ao Awurade, wokora nnipa ne mmoa nyinaa so.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Wʼadɔe a ɛnsa da no som bo!","poem":2},{"text":"Nnipa mu akɛse ne nketewa","poem":1},{"text":"nya guankɔbea wɔ wo ntaban nwini ase.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wodi nea abu so wɔ wo fi,","poem":1},{"text":"woma wɔnom fi wʼanika asuten no mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wo nkyɛn na nkwa asuti wɔ;","poem":1},{"text":"wo hann mu na yehu hann.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kɔ so dɔ wɔn a wonim wo,","poem":1},{"text":"ma wo trenee ntena wɔn a wɔteɛ, koma mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mma ɔhantanni nan ntia me","poem":1},{"text":"anaa omumɔyɛfo nsa nnsunsum me.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hwɛ sɛnea nnebɔneyɛfo ahwehwe ase,","poem":1},{"text":"wɔdeda hɔ a wɔrentumi nsɔre bio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}