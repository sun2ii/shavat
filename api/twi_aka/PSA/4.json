{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Sɛ misu frɛ wo a, gye me so,","poem":1},{"text":"me trenee Nyankopɔn.","poem":2},{"text":"Ma me ɔhome wɔ mʼahohia mu;","poem":1},{"text":"hu me mmɔbɔ na tie me mpaebɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Enkosi da bɛn na mobɛdan mʼanuonyam ahohora?","poem":1},{"text":"Enkosi da bɛn na mobɛdɔ nneɛma hunu na moadi ahoni ahuhuw akyi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hu sɛ Awurade ayi nea ɔwɔ nyamesu ama ne ho;","poem":1},{"text":"Awurade betie, sɛ misu mefrɛ no a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sɛ mo bo fuw a, monnyɛ bɔne;","poem":1},{"text":"sɛ modeda mo mpa so a,","poem":2},{"lineBreak":true},{"text":"monyɛ komm na monhwehwɛ mo koma mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mommɔ afɔre a ɛfata","poem":1},{"text":"na momfa mo werɛ nhyɛ Awurade mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nnipa bebree bisa se:","poem":1},{"text":"“Hena na ɔde yiyeyɛ bɛbrɛ yɛn?”","poem":2},{"lineBreak":true},{"text":"Awurade, ma wʼanim hann no nhyerɛn yɛn so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fa anigye mmoroso hyɛ me koma ma","poem":1},{"text":"bere a wɔn aburow ne nsa foforo abu so no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɛtɔ hɔ, na mada asomdwoe mu,","poem":1},{"text":"efisɛ wo nko ara, Awurade,","poem":2},{"lineBreak":true},{"text":"na woma metena dwoodwoo.","poem":2},{"text":"Wɔde ma dwonkyerɛfo sɛ wɔmfa atɛntɛbɛn nto.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}