{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Nhyira ne onipa a mmɔborɔni asɛm ho hia no;","poem":1},{"text":"Awurade gye no wɔ amanehunu bere mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade bɛbɔ ne ho ban na wakora ne kra;","poem":1},{"text":"obehyira no wɔ asase no so;","poem":2},{"lineBreak":true},{"text":"ɔrennyaa no mma nʼatamfo apɛde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade bɛhwɛ no wɔ ne yare mpa so","poem":1},{"text":"na wagye no asi hɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mekae se, “Ao Awurade hu me mmɔbɔ;","poem":1},{"text":"sa me yare, efisɛ mayɛ bɔne atia wo.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mʼatamfo de adwene bɔne ka fa me ho se:","poem":1},{"text":"“Da bɛn na obewu ama ne din ayera?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bere biara a obi ba me nkyɛn no,","poem":1},{"text":"ɔka atosɛm, na ne koma hɔre dinsɛe;","poem":2},{"lineBreak":true},{"text":"ofi adi kɔ a, ɔde kodi nseku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mʼatamfo nyinaa keka asomsɛm fa me ho;","poem":1},{"text":"wosusuw bɔne ma me na wɔka se:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ɔyare bɔne bi abɔ no;","poem":1},{"text":"ɔrensɔre mfi nea ɔda hɔ bio.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mpo me yɔnko pa ara a mede me ho too no so,","poem":1},{"text":"nea me ne no too nsa didii no,","poem":2},{"lineBreak":true},{"text":"asɔre atia me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nanso wo, Awurade, hu me mmɔbɔ;","poem":1},{"text":"ma me so, na mintua wɔn so ka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Minim sɛ wʼani sɔ me,","poem":1},{"text":"na me tamfo renni me so nkonim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Me nokwaredi mu, wukura me mu","poem":1},{"text":"na wode me gyina wʼanim afebɔɔ.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nhyira nka Awurade, Israel Nyankopɔn,","poem":1},{"text":"nnɛ ne daa nyinaa.","poem":2},"Amen! ne Amen!",{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}