{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Me Nyankopɔn, bu me bem,","poem":1},{"text":"na ka mʼasɛm a etia ɔman a wonsuro wo no ma me;","poem":2},{"lineBreak":true},{"text":"gye me fi nnaadaafo ne amumɔyɛfo nsam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woyɛ Onyankopɔn, mʼabandennen.","poem":1},{"text":"Adɛn nti na woapo me?","poem":2},{"text":"Adɛn nti na ɛsɛ sɛ menantenantew twa adwo","poem":1},{"text":"mʼatamfo nhyɛso nti?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Soma wo hann ne wo nokware","poem":1},{"text":"ma wɔnkyerɛ me kwan;","poem":2},{"text":"ma wɔmfa me mmra wo Bepɔw Kronkron no so,","poem":1},{"text":"faako a wote no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Afei, mɛkɔ Onyankopɔn afɔremuka anim,","poem":1},{"text":"mʼanigye ne mʼahosɛpɛw Nyankopɔn nkyɛn.","poem":2},{"text":"Mede sanku beyi wo ayɛ,","poem":1},{"text":"Onyankopɔn, me Nyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Me kra, adɛn, na woabotow?","poem":1},{"text":"Adɛn na woayɛ basaa wɔ me mu saa?","poem":2},{"text":"Fa wo ho to Onyankopɔn so,","poem":1},{"text":"na mɛkɔ so ayi no ayɛ,","poem":2},{"lineBreak":true},{"text":"mʼAgyenkwa ne me Nyankopɔn.","poem":2},{"text":"Dwom a wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}