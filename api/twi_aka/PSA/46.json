{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Koramma dwom. Wɔto no “alamot” sanku nne so."]},{"type":"verse","number":1,"content":[{"text":"Onyankopɔn ne yɛn guankɔbea ne yɛn ahoɔden,","poem":1},{"text":"amanehunu mu boafo a ɔwɔ hɔ bere biara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti sɛ asase ani dan butuw,","poem":1},{"text":"na mmepɔw tutu kogu po ase a, yɛrensuro,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"sɛ po bɔ asorɔkye na ehuru","poem":1},{"text":"na ɛma nkoko wosow mpo a, yɛrensuro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Asuten bi wɔ hɔ a","poem":1},{"text":"ne nsuwansuwa de anigye ba Onyankopɔn kuropɔn mu,","poem":2},{"lineBreak":true},{"text":"beae kronkron a Ɔsorosoroni no te.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onyankopɔn te kuropɔn no mu, na ɔrenhwe ase;","poem":1},{"text":"Onyankopɔn bɛboa no anɔpahema.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amanaman yɛ hoo, na ahenni hwehwe ase;","poem":1},{"text":"ɔma ne nne so ma asase nan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Asafo Awurade ka yɛn ho.","poem":1},{"text":"Yakob Nyankopɔn yɛ yɛn aban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bra bɛhwɛ Awurade nnwuma,","poem":1},{"text":"ɔsɛe a ɔde aba asase no so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔma akodi gyae kosi asase ano.","poem":1},{"text":"Obubu agyan mu na ɔsɛe peaw;","poem":2},{"lineBreak":true},{"text":"ɔde ogya hyew nkatabo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Monyɛ komm na munhu sɛ me ne Onyankopɔn;","poem":1},{"text":"wɔbɛma me so wɔ amanaman no mu,","poem":2},{"lineBreak":true},{"text":"wɔbɛma me so wɔ asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Asafo Awurade ka yɛn ho;","poem":1},{"text":"Yakob Nyankopɔn yɛ yɛn aban.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}