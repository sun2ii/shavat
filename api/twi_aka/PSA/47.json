nnwom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Efisɛ Onyankopɔn yɛ asase nyinaa so Hene.","poem":1},{"text":"Monto ahurusi nnwom mma no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onyankopɔn di hene wɔ amanaman no so;","poem":1},{"text":"Onyankopɔn te nʼahengua kronkron so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amanaman no mu akunini boaboa wɔn ho ano","poem":1},{"text":"sɛ Abraham Nyankopɔn nkurɔfo,","poem":2},{"text":"efisɛ asase so ahemfo yɛ Onyankopɔn de;","poem":1},{"text":"na wɔma no so kɛse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}