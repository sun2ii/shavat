{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Koramma dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade yɛ ɔkɛse na ɔsɛ nkamfo,","poem":1},{"text":"wɔ yɛn Nyankopɔn kuropɔn mu, ne bepɔw kronkron so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne sorokɔ ma ɛyɛ fɛ,","poem":1},{"text":"ɛyɛ wiase nyinaa anigyede.","poem":2},{"text":"Bepɔw Sion te sɛ Safon sorɔnsorɔmmea,","poem":1},{"text":"Ɔhenkɛse no kuropɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onyankopɔn te nʼabankɛse mu","poem":1},{"text":"wada ne ho adi sɛ ɔyɛ nʼabandennen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bere a ahemfo yi boaa wɔn ho ano,","poem":1},{"text":"na wotuu ɔsa bɔɔ mu no,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wohuu no ma ɛyɛɛ wɔn ahodwiriw,","poem":1},{"text":"na wɔde ehu guanee.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔbɔɔ huboa wɔ hɔ,","poem":1},{"text":"ɔyaw a ɛte sɛ ɔbea a awo aka no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wosɛe wɔn sɛ Tarsis ahyɛn a","poem":1},{"text":"apuei mframa abɔ adwira wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sɛnea yɛate no,","poem":1},{"text":"saa ara na yɛahu","poem":2},{"text":"wɔ Asafo Awurade kuropɔn no mu,","poem":1},{"text":"yɛn Nyankopɔn kuropɔn mu;","poem":2},{"lineBreak":true},{"text":"Onyankopɔn ma etim hɔ afebɔɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wʼasɔredan no mu; Ao, Onyankopɔn,","poem":1},{"text":"na yɛdwene wo dɔ a enni huammɔ da no ho,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ao, Onyankopɔn, wʼayeyi du asase ano","poem":1},{"text":"te sɛ wo din te;","poem":2},{"lineBreak":true},{"text":"trenee ayɛ wo nsa nifa mu ma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sion bepɔw di ahurusi,","poem":1},{"text":"Yuda nkuraase no ani gye","poem":2},{"text":"esiane wʼatemmu no nti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nantew Sion na twa ho hyia,","poem":1},{"text":"kan nʼabantenten dodow,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"dwene nʼafasu ho yiye,","poem":1},{"text":"hwɛ nʼabankɛse no,","poem":2},{"lineBreak":true},{"text":"na woaka ho asɛm akyerɛ nkyirimma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Saa Onyankopɔn yi yɛ yɛn Nyankopɔn daa daa;","poem":1},{"text":"ɔbɛyɛ yɛn kwankyerɛfo akosi awiei mpo.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}