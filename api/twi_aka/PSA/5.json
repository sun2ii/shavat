{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade, yɛ aso ma me nsɛm","poem":1},{"text":"na dwen mʼapinisi ho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tie me mmoa ho sufrɛ,","poem":1},{"text":"me Hene ne me Nyankopɔn,","poem":2},{"lineBreak":true},{"text":"efisɛ wo na mebɔ wo mpae.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade, wote me nne anɔpa;","poem":1},{"text":"anɔpa, mede mʼadesrɛ ba wʼanim","poem":2},{"lineBreak":true},{"text":"na mede anidaso twɛn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wonyɛ Onyankopɔn a wʼani gye bɔne ho;","poem":1},{"text":"na amumɔyɛfo rentumi ne wo ntena.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ahantanfo rentumi nnyina wʼanim;","poem":1},{"text":"wukyi wɔn a wɔyɛ bɔne nyinaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wosɛe wɔn a wɔka atosɛm;","poem":1},{"text":"Awurade kyi","poem":2},{"lineBreak":true},{"text":"mogyapɛfo ne asisifo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nanso me, wo mmɔborɔhunu bebrebe nti,","poem":1},{"text":"mɛba wo fi;","poem":2},{"text":"na nidi mu na mɛkotow","poem":1},{"text":"akyerɛ wʼasɔredan kronkron no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade kyerɛ me kwan","poem":1},{"text":"wɔ wo trenee mu","poem":2},{"lineBreak":true},{"text":"mʼatamfo nti,","poem":2},{"lineBreak":true},{"text":"bɔ wo kwan tee wɔ mʼanim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔn anom asɛm baako mpo nyɛ nokware;","poem":1},{"text":"ɔsɛe ahyɛ wɔn koma ma.","poem":2},{"text":"Wɔn menewa yɛ ɔda a so abue","poem":1},{"text":"wɔde wɔn tɛkrɛma ka nnaadaasɛm.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onyankopɔn, bu wɔn fɔ!","poem":1},{"text":"Ma wɔn pɔw bɔne nyɛ wɔn asehwe.","poem":2},{"text":"Pam wɔn; esiane wɔn bɔne dodow no nti,","poem":1},{"text":"efisɛ wɔasɔre atia wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nanso ma wɔn a woguan ba wo nkyɛn no ani nnye;","poem":1},{"text":"ma wɔmfa anigye nto dwom daa.","poem":2},{"text":"Trɛw wo bammɔ mu wɔ wɔn so,","poem":1},{"text":"na wɔn a wɔdɔ wo din no","poem":2},{"lineBreak":true},{"text":"ma wɔn ani nnye wɔ wo mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awurade, ampa ara, wuhyira atreneefo;","poem":1},{"text":"na wode wʼayamye twa wɔn ho hyia sɛ nkatabo.","poem":2},{"text":"Wɔde ma dwonkyerɛfo sɛ ɔmfa sankuhama nto wɔ Seminit nne so.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}