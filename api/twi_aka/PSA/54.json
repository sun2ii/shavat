{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Dawid “maskil” dwom. Ɔtoo no bere a Sififo kɔka kyerɛɛ Saulo se, “Dawid abehintaw wɔ yɛn mu.”"]},{"type":"verse","number":1,"content":[{"text":"Ao, Onyankopɔn, gye me wɔ wo din mu;","poem":1},{"text":"fa wo tumi bu me bem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ao, Onyankopɔn, tie me mpaebɔ;","poem":1},{"text":"tie mʼanom nsɛm.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahɔho retow ahyɛ me so.","poem":1},{"text":"Atirimɔdenfo rehwehwɛ me akum me;","poem":2},{"lineBreak":true},{"text":"nnipa a wɔmmfa Onyankopɔn nyɛ hwee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ampa ara, Onyankopɔn ne me boafo;","poem":1},{"text":"Awurade ne me hwɛfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma mmusu nkyim mmra wɔn a wodi me ho nseku no so;","poem":1},{"text":"wo nokwaredi mu, sɛe wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mefi me pɛ mu abɔ afɔre ama wo;","poem":1},{"text":"Awurade, meyi wo din ayɛ,","poem":2},{"lineBreak":true},{"text":"efisɛ eye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Woagye me afi me haw nyinaa mu,","poem":1},{"text":"na mʼani ahu nkonimdi wɔ mʼatamfo so.","poem":2},{"text":"Wɔde ma dwonkyerɛfo. Wɔde sanku na ɛto.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}