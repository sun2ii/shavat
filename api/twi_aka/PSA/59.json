{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Wɔto no sɛnea wɔto “Nsɛe No” sanku nne so. Dawid “miktam” dwom. Ɔtoo no bere a Saulo soma kɔwɛn Dawid fi sɛ wonkokum no no."]},{"type":"verse","number":1,"content":[{"text":"Ao, Onyankopɔn, gye me fi mʼatamfo nsam;","poem":1},{"text":"bɔ me ho ban fi wɔn a wɔtaa me no ho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gye me fi amumɔyɛfo nsam.","poem":1},{"text":"Gye me nkwa fi mogyapɛfo nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hwɛ sɛnea wɔatɛw rehwehwɛ me akum me!","poem":1},{"text":"Nnipa a wɔn ho yɛ hu bɔ pɔw bɔne tia me","poem":2},{"lineBreak":true},{"text":"a emfi me mfomso anaa bɔne bi, Awurade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Menyɛɛ mfomso bi, nanso wɔayɛ krado sɛ wɔbɛtow ahyɛ me so.","poem":1},{"text":"Sɔre begye me; hwɛ mʼamanehunu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wo, Awurade Nyankopɔn, Israel Nyankopɔn,","poem":1},{"text":"ma wo ho so na twe amanaman no nyinaa aso;","poem":2},{"lineBreak":true},{"text":"nhu amumɔyɛfo nkontompofo no mmɔbɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wɔsan ba anwummere,","poem":1},{"text":"wɔbobɔ mu sɛ akraman,","poem":2},{"lineBreak":true},{"text":"na wokyinkyin kuropɔn no mu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hwɛ nea wɔfe fi wɔn anom,","poem":1},{"text":"wɔn anofafa mu nsɛm ano yɛ nnam sɛ mfoa,","poem":2},{"lineBreak":true},{"text":"na wosusuw se: “Hena na ɔbɛte yɛn nka?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nanso wo Awurade, woserew wɔn;","poem":1},{"text":"wudi saa aman no nyinaa ho fɛw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wone mʼAhoɔden, mehwɛ wo kwan;","poem":1},{"text":"wo, Onyankopɔn, ne mʼabandennen,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"me Nyankopɔn a metumi atweri no.","poem":2},{"lineBreak":true},{"text":"Onyankopɔn bedi mʼanim","poem":1},{"text":"na ɔbɛma mahwɛ wɔn a wɔbɔ me ahohora no haw.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanso nkum wɔn, Awurade, yɛn nkatabo,","poem":1},{"text":"na me nkurɔfo werɛ amfi wɔn.","poem":2},{"text":"Wo tumi mu no tutu wɔn ase,","poem":1},{"text":"na brɛ wɔn ase.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bɔne a efi wɔn anom,","poem":1},{"text":"ne wɔn ano nsɛm nti","poem":2},{"text":"ma wɔn ahomaso nkyekyere wɔn.","poem":1},{"text":"Abususɛm a wɔka ne atoro a wotwa nti,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"sɛe wɔn wɔ abufuwhyew mu,","poem":2},{"lineBreak":true},{"text":"kosi sɛ wɔn ase bɛtɔre.","poem":2},{"text":"Afei ɛbɛma asase so mmaa nyinaa ahu","poem":1},{"text":"sɛ Onyankopɔn di Yakob so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wɔsan ba anwummere,","poem":1},{"text":"wɔbobɔ mu sɛ akraman,","poem":2},{"lineBreak":true},{"text":"na wokyinkyin kuropɔn no mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wokyinkyin pɛ aduan","poem":1},{"text":"na sɛ wɔammee a, wosu bobɔ mu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nanso mɛto wʼahoɔden ho dwom,","poem":1},{"text":"mɛto wʼadɔe ho dwom anɔpa;","poem":2},{"text":"efisɛ woyɛ mʼabandennen,","poem":1},{"text":"me guankɔbea wɔ ahohia mmere mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ao mʼAhoɔden, mɛto ayeyi dwom ama wo;","poem":1},{"text":"wo, Onyankopɔn, ne mʼabandennen, me Nyankopɔn a ɔyɛ ɔdɔ.","poem":2},{"text":"Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Susan Edut.”","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}