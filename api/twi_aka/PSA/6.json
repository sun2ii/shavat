{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade nka mʼanim wɔ wʼabufuw mu,","poem":1},{"text":"na ntwe mʼaso nso wɔ wʼabufuwhyew mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hu me mmɔbɔ, Awurade, efisɛ meyɛ mmrɛw;","poem":1},{"text":"Awurade sa me yare","poem":2},{"lineBreak":true},{"text":"na me nnompe wɔ ahoyeraw mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Me kra wɔ ahohia mu.","poem":1},{"text":"Enkosi da bɛn, Ao Awurade, enkosi da bɛn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"San bra, Awurade, na begye me nkwa;","poem":1},{"text":"gye me, wo dɔ a enni nhuammɔ no nti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obi a wawu no renkae wo da,","poem":1},{"text":"hena na ofi ɔda mu kamfo wo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Apinisi ama mayɛ mmerɛw.","poem":1},{"text":"Anadwo mu nyinaa mede agyaadwotwa fɔw me mpa,","poem":2},{"lineBreak":true},{"text":"na me nusu fɔw me sumii.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awerɛhow ama mʼani so ayɛ me kusuu.","poem":1},{"text":"Ɛredum; mʼatamfo nyinaa nti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mo nnebɔneyɛfo, montwe mo ho mfi me ho!","poem":1},{"text":"efisɛ Awurade ate me sufrɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade ate me mmɔborɔsu;","poem":1},{"text":"Awurade tie me sufrɛ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mʼatamfo nyinaa anim begu ase","poem":1},{"text":"na wɔn ho adwiriw wɔn;","poem":2},{"lineBreak":true},{"text":"na wɔapatuw de fɛre asan wɔn akyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}