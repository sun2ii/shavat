{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao, Onyankopɔn, tie me sufrɛ;","poem":1},{"text":"tie me mpaebɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mifi asase ano frɛ wo,","poem":1},{"text":"mefrɛ wo, efisɛ me koma atɔ beraw;","poem":2},{"lineBreak":true},{"text":"fa me kɔ ɔbotan a ɛware sen me no so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woayɛ me guankɔbea,","poem":1},{"text":"aban a ɛyɛ den ma ɔtamfo no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Me kɔn dɔ sɛ metena wo ntamadan no mu afebɔɔ","poem":1},{"text":"na manya guankɔbea wɔ wo ntaban nwini ase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woate me bɔ a mehyɛe no, Onyankopɔn;","poem":1},{"text":"na wode wɔn a wosuro wo din no agyapade ama me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"To ɔhene nkwanna mu bebree;","poem":1},{"text":"na ne mfe mfi awo ntoatoaso nkodu awo ntoatoaso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ma onni hene wɔ Onyankopɔn anim daa","poem":1},{"text":"fa wʼadɔe ne wo nokware bɔ ne ho ban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Afei mɛto ayeyi dwom ama wo din daa","poem":1},{"text":"na madi me bɔhyɛ so daa nyinaa.","poem":2},{"text":"Wɔde ma dwonkyerɛfo. De ma Yedutun.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}