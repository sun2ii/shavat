{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom. Bere a ɔwɔ Yuda Sare so no na ɔtoe."]},{"type":"verse","number":1,"content":[{"text":"Wo, Onyankopɔn, ne me Nyankopɔn","poem":1},{"text":"Mehwehwɛ wo anibere so;","poem":2},{"text":"wo ho sukɔm de me kra,","poem":1},{"text":"me nipadua ani agyina wo,","poem":2},{"text":"wɔ asase a awo na asade nni mu so,","poem":1},{"text":"faako a nsu nni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mahu wo wɔ Kronkronbea hɔ","poem":1},{"text":"mahu wo tumi ne wʼanuonyam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Esiane sɛ wʼadɔe di mu sen nkwa nti","poem":1},{"text":"mʼanofafa bɛhyɛ wo anuonyam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sɛ mete ase yi, mɛkamfo wo,","poem":1},{"text":"na wo din mu na mɛma me nsa so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Me kra bɛmee sɛnea wadi aduan papa bi;","poem":1},{"text":"mede anofafa a ɛto dwom beyi wo ayɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Meda me mpa so a, mekae wo.","poem":1},{"text":"Anadwo dasu mu nyinaa, midwen wo ho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Efisɛ wone me boafo,","poem":1},{"text":"wo ntaban ase nwini mu na mɛto dwom.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Me kra bata wo ho;","poem":1},{"text":"na wo nsa nifa kura me mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wɔn a wɔpɛ me akum me no bɛsɛe;","poem":1},{"text":"wɔbɛkɔ asase ase tɔnn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wɔbɛdan wɔn ama afoa","poem":1},{"text":"na wɔbɛyɛ aduan ama sakraman.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nanso ɔhene bedi ahurusi wɔ Onyankopɔn mu;","poem":1},{"text":"wɔn a wɔka ntam wɔ Onyankopɔn din mu nyinaa bɛkamfo no,","poem":2},{"lineBreak":true},{"text":"na wobemua atorofo ano.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}