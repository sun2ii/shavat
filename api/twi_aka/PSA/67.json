":1},{"text":"na Onyankopɔn, yɛn Nyankopɔn ahyira yɛn.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onyankopɔn behyira yɛn,","poem":1},{"text":"na asase mmaa nyinaa besuro no.","poem":2},{"text":"Wɔde ma dwonkyerɛfo.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}