{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Dawid adesrɛ dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao, Onyankopɔn, yɛ ntɛm gye me nkwa;","poem":1},{"text":"Awurade bra ntɛm bɛboa me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ma wɔn a wɔhwehwɛ me kra no","poem":1},{"text":"anim ngu ase na wɔnyɛ basaa;","poem":2},{"text":"ma wɔn a wɔhwehwɛ me sɛe no nyinaa","poem":1},{"text":"mfa animguase nsan wɔn akyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma wɔn a wɔka, “Ɔtwea! Ɔtwea!” kyerɛ me no","poem":1},{"text":"nsan wɔn akyi, esiane wɔn aniwu nti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso ma wɔn a wɔhwehwɛ wo nyinaa","poem":1},{"text":"nsɛpɛw wɔn ho na wɔn ani nnye wɔ wo mu;","poem":2},{"text":"ma wɔn a wɔdɔ wo nkwagye no nka da biara se,","poem":1},{"text":"“Onyankopɔn yɛ ɔkɛse!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Me de meyɛ ohiani a minni ɔboafo;","poem":1},{"text":"Ao, Onyankopɔn, bra me nkyɛn ntɛm.","poem":2},{"text":"Wo ne me boafo ne me gyefo;","poem":1},{"text":"Awurade, ntwentwɛn wʼanan ase.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}