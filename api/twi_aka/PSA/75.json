{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Asaf dwom."]},{"type":"verse","number":1,"content":[{"text":"Onyankopɔn, yɛda wo ase,","poem":1},{"text":"yɛda wo ase, efisɛ wo Din abɛn;","poem":2},{"lineBreak":true},{"text":"nnipa ka wʼanwonwade kyerɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Woka se, “Me na mehyɛɛ bere a ɛsɛ no;","poem":1},{"text":"ɛyɛ me na mibu atɛntrenee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛ asase ne so nnipa nyinaa wosow a,","poem":1},{"text":"me na mema nʼafadum gyina hɔ pintinn.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meka kyerɛ ahantanfo se, ‘Monnhoahoa mo ho bio,’","poem":1},{"text":"na meka kyerɛ amumɔyɛfo nso se, ‘Mommma mo mmɛn so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mommma mo mmɛn so ntia ɔsoro;","poem":1},{"text":"mommfa animtiaabu nkasa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Obiara mmfi apuei anaa atɔe","poem":1},{"text":"anaa sare no so a obetumi ama obi so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɛyɛ Onyankopɔn na obu atɛn:","poem":1},{"text":"Ɔbrɛ ɔbaako ase, na ɔma ɔfoforo so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuruwa bi hyɛ Awurade nsam","poem":1},{"text":"nsa bi a etwa ahuru a wɔde nnuhuam afra ahyɛ no ma;","poem":2},{"text":"ohwie, na asase so amumɔyɛfo nyinaa","poem":1},{"text":"nom ma ɛka ase puw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Me de, mɛpae mu aka eyi daa daa;","poem":1},{"text":"mɛto ayeyi dwom ama Yakob Nyankopɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mebubu amumɔyɛfo nyinaa mmɛn,","poem":1},{"text":"na atreneefo mmɛn de, wɔbɛma so.","poem":2},{"text":"Wɔde ma dwonkyerɛfo. Wɔde sanku na ɛto.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}