{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade, yɛn Awurade,","poem":1},{"text":"wo din kɛseyɛ ada adi wiase mmaa nyinaa.","poem":2},{"lineBreak":true},{"text":"Wode wʼanuonyam","poem":1},{"text":"atimtim ɔsoro nohɔ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mmofra ne nkokoaa mpo de wɔn ano","poem":1},{"text":"kamfo wo, wʼatamfo nti;","poem":2},{"lineBreak":true},{"text":"na wode bɔ atamfo ne aweretɔfo ano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sɛ mehwɛ wo ɔsorosoro,","poem":1},{"text":"wo nsateaa ano adwuma;","poem":2},{"text":"ɔsram ne nsoromma a","poem":1},{"text":"wode obiara asi nʼafa a,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"onipa ne hena a wokae no,","poem":1},{"text":"na onipa ba nso ne hena a wʼani ku ne ho?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wobɔɔ no ma ɔyɛɛ akumaa kakra sen abɔfo","poem":1},{"text":"na wode wʼanuonyam ne nidi abɔ no abotiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Woyɛɛ no ɔsodifo maa wo nsa ano nnwuma","poem":1},{"text":"wode nneɛma nyinaa ahyɛ nʼanan ase:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nguankuw ne anantwikuw nyinaa","poem":1},{"text":"ne wuram mmoa nso,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"wim nnomaa","poem":1},{"text":"ne po mu mpataa,","poem":2},{"lineBreak":true},{"text":"nea ɛnenam po mu akwan so nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Awurade, yɛn Awurade,","poem":1},{"text":"wo din yɛ kɛse wɔ asase nyinaa so!","poem":2},{"text":"Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Ɔba no wu”.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}