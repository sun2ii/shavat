{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Asaf dwom."]},{"type":"verse","number":1,"content":[{"text":"Onyankopɔn di hene wɔ ɔsoro asafo mu;","poem":1},{"text":"obu atɛn wɔ “anyame” mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Wobɛbɔ wɔn a wɔnteɛ ho ban","poem":1},{"text":"na woayɛ nhwɛanim ama amumɔyɛfo akosi da bɛn?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monka mmɔborɔfo ne ayisaa asɛm mma wɔn;","poem":1},{"text":"mommɔ ahiafo ne wɔn a wɔhyɛ wɔn so yiyedi ho ban.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munnye ɔbrɛfo ne ahiafo;","poem":1},{"text":"munnye wɔn mfi amumɔyɛfo nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Anyame no nnim de, na wɔnte hwee ase.","poem":1},{"text":"Wokyinkyin wɔ sum mu;","poem":2},{"lineBreak":true},{"text":"na asase fapem nyinaa wosow.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mekae se, ‘Moyɛ “anyame;”","poem":1},{"text":"mo nyinaa yɛ Ɔsorosoroni no mma.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nanso mubewuwu sɛ nnipa pɛ;","poem":1},{"text":"na moahwe ase sɛ ɔsodifo biara.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ao Onyankopɔn, sɔre, bu wiase atɛn;","poem":1},{"text":"efisɛ amanaman nyinaa yɛ wo de.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}