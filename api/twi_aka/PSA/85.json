{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Koramma dwom."]},{"type":"verse","number":1,"content":[{"text":"Wo Awurade, wodom wʼasase;","poem":1},{"text":"wode Yakob ahonyade san maa no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wode wo nkurɔfo bɔne kyɛɛ wɔn","poem":1},{"text":"na wokataa wɔn nnebɔne nyinaa so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wode wʼabufuw nyinaa too nkyɛn","poem":1},{"text":"na wodan fii wʼabufuwhyew ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"San gye yɛn bio, Onyankopɔn, yɛn Gyefo,","poem":1},{"text":"na ma wʼani nnye yɛn ho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wo bo befuw yɛn akosi daa ana?","poem":1},{"text":"Wʼabufuw bɛtoa so akɔ awo ntoantoaso nyinaa so ana?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worenhyɛ yɛn den bio,","poem":1},{"text":"na ama wo nkurɔfo asɛpɛw wɔn ho wɔ wo mu ana?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade, kyerɛ yɛn wo dɔ a ɛnsa da no,","poem":1},{"text":"na ma yɛn wo nkwagye no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Metie nea Awurade Nyankopɔn bɛka;","poem":1},{"text":"ɔde asomdwoe hyɛ ne nkurɔfo, ahotefo no bɔ,","poem":2},{"lineBreak":true},{"text":"enti ɛnsɛ sɛ wɔsan kɔ agyimisɛm ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ampa ara, ne nkwagye bɛn wɔn a wosuro no,","poem":1},{"text":"na nʼanuonyam bɛtena yɛn asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔdɔ ne nokwaredi behyia,","poem":1},{"text":"na trenee ne asomdwoe befew wɔn ho wɔn ho ano.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokwaredi bepue afi asase no so,","poem":1},{"text":"na trenee ahwɛ afi ɔsoro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awurade bɛma yɛn nea eye ampa ara","poem":1},{"text":"na yɛn asase bɛma ne nnɔbae.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Trenee di nʼanim","poem":1},{"text":"siesie ɔkwan ma nʼanammɔntu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}