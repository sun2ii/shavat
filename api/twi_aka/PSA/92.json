{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Dwom a wɔto no Homeda."]},{"type":"verse","number":1,"content":[{"text":"Eye sɛ wɔkamfo wo Awurade","poem":1},{"text":"na wɔto dwom de hyɛ wo anuonyam, Ɔsorosoroni,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na wɔpae mu ka wʼadɔe anɔpa","poem":1},{"text":"ne wo nokware anadwo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"wɔ hama du sanku so","poem":1},{"text":"ne sankuten nnwom mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awurade, wo nneyɛe ma mʼani gye;","poem":1},{"text":"mede anigye to nnwom, wo nsa ano nnwuma nti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awurade, wo nnwuma yɛ akɛse,","poem":1},{"text":"na wo nyansa mu dɔ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Agyimifo nnim","poem":1},{"text":"na nkwaseafo nte ase,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"amumɔyɛfo benyin sɛ sare","poem":1},{"text":"na abɔnefo bɛyɛ frɔmfrɔm de,","poem":2},{"text":"nanso wɔbɛsɛe wɔn pasaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na wo Awurade, wɔayɛ wo ɔkɛse afebɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Awurade, ampa ara,","poem":1},{"text":"wʼatamfo bɛyera;","poem":2},{"lineBreak":true},{"text":"na wɔbɛhwete abɔnefo nyinaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Woama me ahoɔden te sɛ ɛko;","poem":1},{"text":"woahwie ngohuam papa agu me so.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mahu mʼatamfo nkogu a wɔadi,","poem":1},{"text":"mate sɛnea mʼatamfo atirimɔdenfo aguan afi akono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Atreneefo bɛyɛ frɔmfrɔm te sɛ abedua,","poem":1},{"text":"wobenyin sɛ Lebanon sida;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nea wɔadua wɔ Awurade fi,","poem":1},{"text":"wobenyin frɔmfrɔm wɔ yɛn Nyankopɔn adiwo hɔ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wɔbɛkɔ so asow aba, onyinkyɛ mu mpo,","poem":1},{"text":"wɔbɛyɛ frɔmfrɔm sɛ ahabammono,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"de akyerɛ sɛ, “Awurade yɛ ɔtreneeni;","poem":1},{"text":"ɔyɛ me botan, na atirimɔdensɛm biara nni ne mu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}