{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Awurade di hene, wɔde tumi ahentade ahyɛ no;","poem":1},{"text":"wɔde tumi ahentade ahyɛ Awurade","poem":2},{"lineBreak":true},{"text":"na wɔde ahoɔden ayɛ nʼakode.","poem":2},{"text":"Wɔde wiase atim hɔ pintinn;","poem":1},{"text":"na wɔrentumi ntutu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wʼahengua tim hɔ fi tete;","poem":1},{"text":"na wowɔ hɔ fi mmeresanten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Awurade, po ama wɔn ho so,","poem":1},{"text":"po ama wɔn nne so;","poem":2},{"lineBreak":true},{"text":"po ama wɔn asorɔkye a ɛbɔ dennen no so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nea ɔwɔ tumi sen nsu akɛse mmubomu,","poem":1},{"text":"nea ɔwɔ tumi sen po nworoso,","poem":2},{"lineBreak":true},{"text":"Awurade a ɔte ɔsoro no yɛ ɔkɛse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade, wo nhyehyɛe gyina hɔ pintinn;","poem":1},{"text":"kronkronyɛ hyɛ wo fi anuonyam","poem":2},{"lineBreak":true},{"text":"daa nyinaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}