{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Mommra mma yɛnto dwom wɔ anigye so mma Awurade;","poem":1},{"text":"momma yɛmmɔ ose mma yɛn nkwagye Botan no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Momma yɛmfa aseda mmra nʼanim,","poem":1},{"text":"na yɛmfa ahosɛpɛw nnwom mma no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Efisɛ Awurade yɛ Onyankopɔn kɛse,","poem":1},{"text":"ɔhenkɛse wɔ anyame nyinaa so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne nsam na asase mu nneɛma nyinaa wɔ,","poem":1},{"text":"na mmepɔw mpampam wɔ no.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Po wɔ no, ɔno na ɔbɔe,","poem":1},{"text":"na ne nsa na ɛnwenee asase kesee no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mommra, mma yɛnkotow nsom no.","poem":1},{"text":"Momma yemmu nkotodwe wɔ Awurade yɛn Yɛfo no anim!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔyɛ yɛn Nyankopɔn;","poem":1},{"text":"yɛyɛ ne didibea nnipa,","poem":2},{"lineBreak":true},{"text":"ne nguankuw a ɔhwɛ wɔn so.","poem":2},{"lineBreak":true},{"text":"Nnɛ, sɛ mote ne nne a,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"mummpirim mo koma sɛnea moyɛɛ wɔ Meriba no,","poem":2},{"lineBreak":true},{"text":"sɛnea moyɛɛ da no wɔ Masa, sare no so no,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɛhɔ no, mo mpanyimfo sɔɔ no hwɛe,","poem":1},{"text":"a na wonim nea meyɛ maa wɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Me bo fuw saa nnipa no mfe aduanan","poem":1},{"text":"na mekae se, “Wɔyɛ nnipa a wɔn koma aman afi me ho,","poem":2},{"lineBreak":true},{"text":"na wɔanhu mʼakwan.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɛno nti mekaa ntam wɔ mʼabufuw mu se,","poem":1},{"text":"“Wɔrenhyɛn mʼahomegye mu da.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}