{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Dwom."]},{"type":"verse","number":1,"content":[{"text":"Monto dwom foforo mma Awurade,","poem":1},{"text":"efisɛ wayɛ anwonwade bebree;","poem":2},{"text":"ne nsa nifa ne ne basa kronkron no","poem":1},{"text":"anya nkwagye ama no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade ama wɔahu ne nkwagye","poem":1},{"text":"na wada ne trenee adi akyerɛ amanaman no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakae nʼadɔe","poem":1},{"text":"ne ne nokware a odi kyerɛɛ Israelfo no;","poem":2},{"text":"asase ano nyinaa ahu","poem":1},{"text":"yɛn Nyankopɔn nkwagye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Asase nyinaa mommɔ ose mma Awurade,","poem":1},{"text":"momfa nnwonto nni ahurusi;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momfa sanku nto dwom mma Awurade,","poem":1},{"text":"sanku ne nnwonto nnyigyei,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"momfa torobɛnto ne adwennini mmɛn,","poem":1},{"text":"nteɛ mu ahosɛpɛw so wɔ Awurade, yɛn hene no anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Momma po ne abɔde a ɛwɔ mu nyinaa nhuru so;","poem":1},{"text":"asase ne wɔn a wɔte so nyinaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Momma nsubɔnten mmɔ wɔn nsam,","poem":1},{"text":"mmepɔw nka mmom nto ahurusi nnwom;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ma wɔnto nnwom wɔ Awurade anim,","poem":1},{"text":"efisɛ ɔreba abebu wiase atɛn.","poem":2},{"text":"Ɔde trenee bebu wiase atɛn","poem":1},{"text":"na ɔde pɛpɛyɛ abu nnipa atɛn.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}