{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_aka","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"9fe2459113e7392ea81276ff55af744109202def8503c8921bbc72a080c85c5a","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_aka/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Awurade di hene,","poem":1},{"text":"momma amanaman no ho mpopo;","poem":2},{"text":"ɔte nʼahengua so wɔ kerubim ntam,","poem":1},{"text":"ma asase nwosow.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade a ɔwɔ Sion yɛ ɔkɛse;","poem":1},{"text":"wɔama no so wɔ amanaman nyinaa mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma wɔnkamfo wo din a ɛso na ɛyɛ nwonwa no,","poem":1},{"text":"ɔyɛ ɔkronkron.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɔhene no yɛ ɔkɛse, ɔdɔ atɛntrenee,","poem":1},{"text":"woama pɛpɛyɛ atim;","poem":2},{"text":"wayɛ nea eye na ɛteɛ","poem":1},{"text":"wɔ Yakob mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momma Awurade, yɛn Nyankopɔn so","poem":1},{"text":"na monsɔre no wɔ ne nan ntiaso anim;","poem":2},{"lineBreak":true},{"text":"ɔyɛ ɔkronkron.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Na Mose ne Aaron ka nʼasɔfo no ho,","poem":1},{"text":"na Samuel ka wɔn a wɔbɔɔ ne din no ho;","poem":2},{"text":"wɔfrɛɛ Awurade,","poem":1},{"text":"na ogyee wɔn so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ofi omununkum dum mu kasa kyerɛɛ wɔn;","poem":1},{"text":"wodii mmara ne ahyɛde a ɔmaa wɔn no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade, yɛn Nyankopɔn,","poem":1},{"text":"wugyee wɔn so;","poem":2},{"text":"woyɛɛ bɔnefakyɛ Nyankopɔn maa Israel,","poem":1},{"text":"nanso wotwee wɔn aso wɔ wɔn nnebɔne ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momma Awurade yɛn Nyankopɔn so","poem":1},{"text":"na monsɔre no wɔ ne bepɔw kronkron no so,","poem":2},{"lineBreak":true},{"text":"na Awurade yɛn Nyankopɔn yɛ ɔkronkron.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}