{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"SNG","translationId":"twi_aka","name":"Nnwom Mu Dwom","commonName":"Nnwom Mu Dwom","title":"Nnwom Mu Dwom","order":22,"numberOfChapters":8,"sha256":"9282b0c7cc703065dba0ca6416c706b0461b0a13f5d413add434378ca8df8345","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/twi_aka/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Meyɛ Saron nhwiren","poem":1},{"noteId":2},{"text":"ne abon mu sukooko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sɛnea sukooko a ɛwɔ nsɔe mu te no,","poem":1},{"text":"saa ara na me dɔfo te wɔ mmabaa mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛnea aprɛ te wɔ kwae mu nnua mu no,","poem":1},{"text":"saa ara na me dɔfo te wɔ mmerante mu.","poem":2},{"text":"Sɛ metena ne nwini mu a minya ahomeka","poem":1},{"text":"na nʼaba nso yɛ mʼanom dɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔde me akɔ aponto ase,","poem":1},{"text":"na mʼagyiraehyɛde yɛ ɔdɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momma me bobe aba na minya ahoɔden,","poem":1},{"text":"momma me aprɛ na ennwudwo me,","poem":2},{"lineBreak":true},{"text":"efisɛ ɔdɔ ama matɔ beraw.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne nsa benkum da mʼatiko,","poem":1},{"text":"na ne nsa nifa aka me afam ne bo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yerusalem mmabea, mede atwewa","poem":1},{"text":"ne wuram ɔforote hyɛ mo sɛ:","poem":2},{"text":"Monnkanyan na munnyan ɔdɔ","poem":1},{"text":"kosi bere a ɛsɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tie! me dɔfo!","poem":1},{"text":"Hwɛ! ɔno na ɔreba no,","poem":2},{"text":"ɔrehuruhuruw wɔ mmepɔw no so","poem":1},{"text":"na ɔbɔ pentenkwa wɔ nkoko no so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Me dɔfo te sɛ ɔtwe anaa ɔforote.","poem":1},{"text":"Hwɛ! ogyina yɛn fasu akyi,","poem":2},{"text":"ɔhwɛ mfɛnsere no mu,","poem":1},{"text":"wagyen nʼani rehwɛ mfɛnsere no mu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Me dɔfo kasa kyerɛɛ me se,","poem":1},{"text":"“Sɔre, me dɔfo ne mʼahoɔfɛ","poem":2},{"lineBreak":true},{"text":"na bra me nkyɛn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hwɛ! awɔwbere atwa mu;","poem":1},{"text":"na asusow atwa mu kɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nhwiren afifi asase ani:","poem":1},{"text":"nnwonto bere aso.","poem":2},{"text":"Wɔte mmorɔnoma su","poem":1},{"text":"wɔ yɛn asase so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Borɔdɔma agu nhwiren;","poem":1},{"text":"na bobe hua agye baabiara.","poem":2},{"text":"Sɔre bra, me dɔfo;","poem":1},{"text":"mʼahoɔfɛ, bra me nkyɛn.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mʼaborɔnoma a wohyɛ abotan ntokuru mu,","poem":1},{"text":"ahintaw wɔ mmepɔw so,","poem":2},{"text":"ma minhu wʼanim;","poem":1},{"text":"ma mente wo nne;","poem":2},{"text":"wo nne yɛ dɛ,","poem":1},{"text":"na wʼanim yɛ fɛ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Monkyekyere sakraman no mma yɛn,","poem":1},{"text":"sakraman nketewa no","poem":2},{"text":"a wɔsɛe bobe nturo,","poem":1},{"text":"yɛn bobe nturo a ayɛ frɔmfrɔm no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Me dɔfo yɛ me dea, na mewɔ no;","poem":1},{"text":"ɔhwehwɛ sukooko no mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enkosi sɛ ade bɛkyɛ","poem":1},{"text":"na sunsuma bɛsen akɔ no,","poem":2},{"text":"dan wo ho, me dɔfo,","poem":1},{"text":"na yɛ sɛ ɔtwewa","poem":2},{"text":"anaa ɔforote a","poem":1},{"text":"ɔwɔ nkoko mmonkyi mmonka no so.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"2.1 Yehu Saron nhwiren wɔ Karmel mpoano anafo fam.","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/twi_aka/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}