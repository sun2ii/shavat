{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"SNG","translationId":"twi_aka","name":"Nnwom Mu Dwom","commonName":"Nnwom Mu Dwom","title":"Nnwom Mu Dwom","order":22,"numberOfChapters":8,"sha256":"9282b0c7cc703065dba0ca6416c706b0461b0a13f5d413add434378ca8df8345","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/twi_aka/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Wo ho yɛ fɛ, me dɔfo!","poem":1},{"text":"Ao, wo ho yɛ fɛ!","poem":2},{"lineBreak":true},{"text":"Wʼaniwa a ɛhyehyɛ wo nkataanim mu no te sɛ aborɔnoma.","poem":2},{"text":"Wo nwi te sɛ mpapokuw a","poem":1},{"text":"wɔresian Gilead Bepɔw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wo se te sɛ nguankuw a wɔatwitwa wɔn ho nwi foforo,","poem":1},{"text":"a wofi aguaree.","poem":2},{"text":"Baako mpo nyeraa ɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wʼanofafa te sɛ koogyan hama;","poem":1},{"text":"wʼano yɛ fɛ.","poem":2},{"text":"Wʼasontɔre a ɛhyɛ wo nkataanim mu","poem":1},{"text":"te sɛ ntunkum aduaba fa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wo kɔn te sɛ Dawid abantenten,","poem":1},{"text":"a wɔasi no fɛɛfɛ;","poem":2},{"text":"na akokyɛm apem sensɛn ho,","poem":1},{"text":"a ne nyinaa yɛ akofo kyɛm.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wo nufu te sɛ atwemma abien,","poem":1},{"text":"atwemma nta a","poem":2},{"lineBreak":true},{"text":"wodidi wɔ sukooko mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enkosi sɛ ade bɛkye,","poem":1},{"text":"ama honhom aguan no,","poem":2},{"text":"mɛkɔ kurobow bepɔw","poem":1},{"text":"ne aduhuam nkoko no so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me dɔfo, wo ho yɛ fɛ papa;","poem":1},{"text":"wo ho nni dɛm biara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma yemfi Lebanon, mʼayeforo,","poem":1},{"text":"wo ne me mfi Lebanon nkɔ.","poem":2},{"text":"Sian fi Amana atifi bra,","poem":1},{"text":"fi Senir atifi, Hermon apampam hɔ,","poem":2},{"text":"fi gyata buw mu","poem":1},{"text":"ne mmepɔw a asebɔ dɛɛdɛɛ hɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Woagye me koma abɔ so, me nuabea, mʼayeforo;","poem":1},{"text":"woagye me koma abɔ so;","poem":2},{"text":"wode wʼani a ɛbɔɔ me so,","poem":1},{"text":"ne wo kɔnmuade mu ɔbohemaa baako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wo dɔ yɛ anigye, me nuabea, mʼayeforo!","poem":1},{"text":"Hwɛ, wo dɔ sɔ ani sen bobesa,","poem":2},{"lineBreak":true},{"text":"na wʼaduhuam yɛ huam sen pɛprɛ biara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asɛm dɛdɛ fi wʼano sɛ ɛwokyɛm, mʼayeforo;","poem":1},{"text":"nufusu ne ɛwo wɔ wo tɛkrɛma ase.","poem":2},{"lineBreak":true},{"text":"Wo ntade mu hua te sɛ Lebanon de.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wote sɛ turo a wɔato ano pon mu, me nuabea, mʼayeforo;","poem":1},{"text":"woyɛ asuti a wɔagye ho ban, asubura a wɔasɔw ano.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wo nnua yɛ nnuabafuw so ntunkum","poem":1},{"text":"a ɛsow aba pa,","poem":2},{"lineBreak":true},{"text":"ahuahaa ne nnuannua,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nnuannua ne mmetire,","poem":2},{"lineBreak":true},{"text":"osiko ne sinamon,","poem":2},{"lineBreak":true},{"text":"a ohuamfufu nnua ahorow,","poem":2},{"lineBreak":true},{"text":"kurobow ne dupapo","poem":2},{"lineBreak":true},{"text":"ne pɛprɛ papa ahorow nyinaa ka ho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Woyɛ asubura turo,","poem":1},{"text":"abura a nsu sen fi mu","poem":2},{"lineBreak":true},{"text":"a ɛsen fi Lebanon.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sɔre, atifi fam mframa!","poem":1},{"text":"Bra, anafo fam mframa!","poem":2},{"noteId":3},{"text":"Bɔ fa me turo mu,","poem":1},{"text":"sɛnea ɛbɛyɛ a ne hua no begyigye afa baabiara.","poem":2},{"text":"Ma me dɔfo mmra ne turo mu","poem":1},{"text":"na ɔmmɛka ne nnuaba papa no nhwɛ.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"4.16 Mframa a ɛbɔ fi atifi fam no mu dwo enti ɛma nnuaba yɛ foforo daa. Mframa a ɛbɔ fi anafo fam no mu yɛ hyew na ɛma nnuaba no bere. Ne abien ka bɔ mu a, ɛma mframa a ɛyɛ huam fa turo no mu.","reference":{"chapter":4,"verse":16}}]},"thisChapterLink":"/api/twi_aka/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}