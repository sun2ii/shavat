{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"SNG","translationId":"twi_aka","name":"Nnwom Mu Dwom","commonName":"Nnwom Mu Dwom","title":"Nnwom Mu Dwom","order":22,"numberOfChapters":8,"sha256":"9282b0c7cc703065dba0ca6416c706b0461b0a13f5d413add434378ca8df8345","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/twi_aka/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Maba me turo mu, me nuabea, mʼayeforo;","poem":1},{"text":"maboaboa me kurobow ne me nnuhuam ano.","poem":2},{"text":"Madi me wokyɛm ne ɛwo;","poem":1},{"text":"manom me bobesa ne me nufusu.","poem":2},"Nnamfonom:",{"text":"Nnamfonom, munnidi na monnom;","poem":1},{"text":"Adɔfonom, monnom nea ɛbɛmee mo dɔ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Medae, nanso me koma anna.","poem":1},{"text":"Tie! me dɔfo rebɔ pon no mu;","poem":2},{"text":"“Bue me, me nuabea, me dɔ,","poem":1},{"text":"mʼaborɔnoma, a ne ho nni dɛm.","poem":2},{"text":"Obosu afɔw me tirim,","poem":1},{"text":"anadwo mu bosu afɔw me nwi.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maworɔw mʼatade,","poem":1},{"text":"mensan mfa nhyɛ ana?","poem":2},{"text":"Mahohoro mʼanan ase,","poem":1},{"text":"memma ho nyɛ fi bio ana?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me dɔfo yɛɛ sɛ ɔrebue pon no","poem":1},{"text":"me koma fii ase bɔɔ kim kim wɔ me mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mesɔree sɛ merekobue me dɔfo,","poem":1},{"text":"na me nsa ho kurobow","poem":2},{"text":"ne me nsateaa ho aduhuam,","poem":1},{"text":"yɛɛ korɔkorɔ no nsa ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mibue maa me dɔfo no,","poem":1},{"text":"nanso na ɔkɔ.","poem":2},{"lineBreak":true},{"text":"Ne kɔ no maa me ho dwiriw me.","poem":2},{"text":"Mehwehwɛɛ no nanso manhu no baabiara.","poem":1},{"text":"Mefrɛɛ no nanso wannye me so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awɛmfo no huu me","poem":1},{"text":"bere a wɔrebɔ aporɔw wɔ kuropɔn no mu.","poem":2},{"text":"Wɔbobɔɔ me pirapiraa me;","poem":1},{"text":"woyii mʼatade kɔe;","poem":2},{"lineBreak":true},{"text":"saa awɛmfo a wɔwɛn afasu no!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yerusalem mmabea, mehyɛ mo,","poem":1},{"text":"sɛ muhu me dɔfo no a,","poem":2},{"text":"asɛm bɛn na mobɛka akyerɛ no?","poem":1},{"text":"Monka nkyerɛ no se ɔdɔ ama matɔ beraw.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dɛn na wo dɔfo de sen afoforo,","poem":1},{"text":"mmea ahoɔfɛfo mu ahoɔfɛ?","poem":2},{"text":"Dɛn na wo dɔfo de sen afoforo a","poem":1},{"text":"enti wohyɛ yɛn sɛɛ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Me dɔfo ho twa na ogyigye,","poem":1},{"text":"wɔfa mpem du a, ɔyɛ sononko.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne ti yɛ sikakɔkɔɔ ankasa;","poem":1},{"text":"ne ti so nwi yɛ kuhaa,","poem":2},{"lineBreak":true},{"text":"na ɛyɛ tuntum sɛ kwaakwaadabi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nʼaniwa aba te sɛ aborɔnoma a","poem":1},{"text":"ogyina asuwa bi ho;","poem":2},{"text":"ɛte sɛ nea wɔde nufusu aguare no,","poem":1},{"text":"na etuatua hɔ sɛ abohemaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nʼafono te sɛ pɛprɛ a wɔasɛw no kɛtɛ.","poem":1},{"text":"Ɛho hua te sɛ aduhuam.","poem":2},{"text":"Nʼanofafa te sɛ sukooko","poem":1},{"text":"a ɛsosɔ kurobow.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nʼabasa te sɛ sikakɔkɔɔ abaa","poem":1},{"text":"a wɔde sikabereɛbo asisi mu.","poem":2},{"text":"Ne nipadua te sɛ asonse a wɔatwiw ho","poem":1},{"text":"na wɔde hoabo adura ho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nʼanan te sɛ abohemaa afadum a","poem":1},{"text":"esisi sikakɔkɔɔ ankasa nnyinaso so.","poem":2},{"text":"Ne bɔbea te sɛ Lebanon a","poem":1},{"text":"ɔyɛ sononko sɛ ne sida.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nʼano te sɛ ɔdɛ ankasa;","poem":1},{"text":"ɔkwan biara so, ne ho yɛ fɛ.","poem":2},{"text":"Me dɔfo ni, mʼadamfo ni,","poem":1},{"text":"Yerusalem mmabea.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}