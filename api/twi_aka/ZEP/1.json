{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ZEP","translationId":"twi_aka","name":"Sefania","commonName":"Sefania","title":"Odiyifo Sefania Nhoma","order":36,"numberOfChapters":3,"sha256":"c1e84433b2feca12fdb4315d1a89401dc3d5c78446047d1820961438b886e2e3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Awurade asɛm a ɛbaa Sefania a ɔyɛ Kusi ba, Gedalia ba, Amaria ba, Hesekia ba nkyɛn ni. Ɛbaa Yudahene Yosia a ɔyɛ Amon ba no bere so."]},{"type":"heading","content":["Atemmu A Etia Yuda"]},{"type":"verse","number":2,"content":[{"text":"“Mɛpra biribiara afi asase so”","poem":1},{"text":"nea Awurade se ni,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Mɛpra nnipa ne mmoa nyinaa;","poem":1},{"text":"mɛpra nnomaa a wɔwɔ wim","poem":2},{"text":"ne mpataa a wɔwɔ po mu nyinaa.","poem":1},{"text":"Atirimɔdenfo benya wura a esum hɔ nko ara,","poem":2},{"text":"sɛ mesɛe adesamma a wɔwɔ asase yi so a,”","poem":1},{"text":"nea Awurade se ni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Mɛteɛ me nsa wɔ Yuda","poem":1},{"text":"ne wɔn a wɔte Yerusalem nyinaa so;","poem":2},{"text":"na mɛsɛe Baal ho biribiara a aka wɔ ha,","poem":1},{"text":"na masɛe abosonsomfo ne akɔmfo asɔfo no din","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wɔn a wɔkotow sɔre wɔn adan atifi,","poem":1},{"text":"de sɔre abɔde a ɛwɔ wim,","poem":2},{"text":"wɔn a wɔkotow de Awurade ka ntam","poem":1},{"text":"na wɔde Molek nso ka ntam,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wɔn nso a wogyae Awurade akyidi","poem":1},{"text":"na wɔnhwehwɛ Awurade anaa wommisa nʼase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Monyɛ komm wɔ Asafo Awurade anim,","poem":1},{"text":"efisɛ, Awurade da no abɛn.","poem":2},{"text":"Awurade asiesie afɔrebɔde;","poem":1},{"text":"wadwira wɔn a wato nsa afrɛ wɔn no ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Awurade afɔrebɔ da no,","poem":1},{"text":"mɛtwe mmapɔmma","poem":2},{"lineBreak":true},{"text":"ne ahenemma","poem":2},{"text":"ne wɔn a wɔhyehyɛ","poem":1},{"text":"ananafo ntade nyinaa aso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saa da no mɛtwe wɔn","poem":1},{"text":"a wɔkwati apongua no nyinaa aso.","poem":2},{"text":"Wɔn a wɔde akakabensɛm","poem":1},{"text":"ne asisi hyehyɛ wɔn abosomfi amaama no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Saa da no,”","poem":1},{"text":"sɛnea Awurade se ni,","poem":2},{"text":"“Osu befi Mpataa Pon ano,","poem":1},{"text":"agyaadwotwa befi Atenae Foforo","poem":2},{"lineBreak":true},{"text":"na nnyigyei a ano yɛ den afi nkoko no so aba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muntwa adwo, mo a mote adetɔnbea hɔ no","poem":1},{"text":"wɔbɛtɔre wɔn a mo ne wɔn di gua ase,","poem":2},{"lineBreak":true},{"text":"dwetɛ aguadifo nyinaa nso wɔbɛsɛe wɔn.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mede akanea bekyin ahwehwɛ Yerusalem mu","poem":1},{"text":"na matwe wɔn a wogyaagyaa wɔn ho aso,","poem":2},{"lineBreak":true},{"text":"wɔn a wɔte sɛ bobesa puw no,","poem":2},{"text":"a wodwen se, ‘Awurade renyɛ hwee","poem":1},{"text":"sɛ ɛyɛ papa anaa bɔne no.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔbɛfom wɔn ahonyade,","poem":1},{"text":"na wɔabubu wɔn afi agu.","poem":2},{"text":"Wobesisi afi, nanso wɔrentena mu","poem":1},{"text":"wɔbɛyɛ bobe mfuw","poem":2},{"lineBreak":true},{"text":"nanso wɔrennom mu nsa.”","poem":2}]},{"type":"heading","content":["Awurade Da Kɛse No"]},{"type":"verse","number":14,"content":[{"text":"Awurade da kɛse no abɛn,","poem":1},{"text":"abɛn na ɛreba ntɛm so.","poem":2},{"text":"Tie! Osu a wobesu Awurade da no bɛyɛ yaw,","poem":1},{"text":"ɔkofo a ɔwɔ hɔ nso nteɛmu bɛyɛ saa ara.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saa da no bɛyɛ abufuw da,","poem":1},{"text":"ɛyɛ ahoyeraw ne ɔyaw da;","poem":2},{"text":"ɛyɛ amanehunu ne ɔsɛe da,","poem":3},{"text":"ɛyɛ esum ne kusukuukuu da","poem":2},{"text":"ɛyɛ omununkum ne kusuuyɛ da,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"ɛyɛ ntorobɛntohyɛn ne ɔko nteɛmu","poem":2},{"text":"a etia nkuropɔn a ɛwɔ bammɔ","poem":1},{"text":"ne ntwɔtwɔw so abantenten da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mede awerɛhow bɛba nnipa no so","poem":1},{"text":"na wɔbɛnantew sɛ anifuraefo,","poem":2},{"lineBreak":true},{"text":"efisɛ wɔayɛ bɔne atia Awurade.","poem":2},{"text":"Wobehwie wɔn mogya agu sɛ mfutuma,","poem":1},{"text":"na wɔn ayamde nso sɛ atantanne.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔn dwetɛ anaa sikakɔkɔɔ","poem":1},{"text":"rentumi nnye wɔn nkwa","poem":2},{"text":"wɔ Awurade abufuw da no.”","poem":1},{"lineBreak":true},{"text":"Ne ninkutwe mu gya no","poem":2},{"text":"bɛhyew ɔman no nyinaa,","poem":1},{"text":"na ɔbɛma asase no so tefo nyinaa nkwa","poem":2},{"lineBreak":true},{"text":"aba awiei mpofirim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}