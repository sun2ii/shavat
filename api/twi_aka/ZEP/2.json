{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ZEP","translationId":"twi_aka","name":"Sefania","commonName":"Sefania","title":"Odiyifo Sefania Nhoma","order":36,"numberOfChapters":3,"sha256":"c1e84433b2feca12fdb4315d1a89401dc3d5c78446047d1820961438b886e2e3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mommoaboa mo ho ano, mommoaboa mo ho ano,","poem":1},{"text":"mo, animguaseman,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ansa na bere a wɔahyɛ no adu,","poem":1},{"text":"na da no resen te sɛ ntɛtɛ,","poem":2},{"text":"ansa na Awurade abufuwhyew no","poem":1},{"text":"aba mo so,","poem":2},{"text":"ansa na Awurade abufuw da no","poem":1},{"text":"aba mo so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monhwehwɛ Awurade, ahobrɛasefo a mowɔ asase so,","poem":1},{"text":"mo a moyɛ nʼahyɛde.","poem":2},{"text":"Monhwehwɛ trenee, monhwehwɛ ahobrɛase;","poem":1},{"text":"ebia ɔbɛkora mo so","poem":2},{"lineBreak":true},{"text":"Awurade abufuw da no.","poem":2}]},{"type":"heading","content":["Atemmu A Etia Filistia"]},{"type":"verse","number":4,"content":[{"text":"Wobegyaw Gasa","poem":1},{"text":"na wɔagyaw Askelon sɛ amamfo.","poem":2},{"text":"Owigyinae na wɔbɛma Asdod ada mpa mu","poem":1},{"text":"na wɔatutu Ekron ase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munnue, mo a mote mpoano,","poem":1},{"text":"mo Keretifo;","poem":2},{"text":"Awurade asɛm tia mo.","poem":1},{"text":"Kanaan, Filistifo asase.","poem":2},{"text":"Mɛtɔre mo ase,","poem":1},{"text":"na obiara renka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asase a ɛda mpoano, faako a Keretifo te","poem":1},{"text":"bɛyɛ atenae ama nguanhwɛfo","poem":2},{"lineBreak":true},{"text":"ne wɔn nguannan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saa asase no bɛyɛ Yudafi nkae no de;","poem":1},{"text":"ɛhɔ na wobenya mmoa adidibea.","poem":2},{"text":"Anwummere, wɔbɛdeda wɔ","poem":1},{"text":"Askelon afi mu.","poem":2},{"text":"Na Awurade, wɔn Nyankopɔn bɛhwɛ wɔn,","poem":1},{"text":"na ɔde wɔn ahonyade nyinaa bɛsan ama wɔn.","poem":2}]},{"type":"heading","content":["Atemmu A Etia Moab Ne Amon"]},{"type":"verse","number":8,"content":[{"text":"“Mate Moab nsopa ne","poem":1},{"text":"Amonfo atweetwee;","poem":2},{"text":"wɔn a wɔsopaa me nkurɔfo","poem":1},{"text":"na wohunahunaa wɔn wɔ wɔn asase ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti sɛ mete ase yi,”","poem":1},{"text":"sɛnea Asafo Awurade,","poem":2},{"lineBreak":true},{"text":"Israel Nyankopɔn, se ni,","poem":2},{"text":"“Ampa ara Moab bɛyɛ sɛ Sodom,","poem":1},{"text":"na Amonfo ayɛ sɛ Gomora,","poem":2},{"text":"faako a nwura ne nkyene amoa wɔ,","poem":1},{"text":"bɛyɛ asase a ɛda mpan afebɔɔ.","poem":2},{"text":"Me man nkae bɛfow wɔn afa;","poem":1},{"text":"me manfo a wobenya wɔn ti adidi mu no bɛfa wɔn asase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wɔn ahantan so akatua a wobenya ni,","poem":1},{"text":"sɛ wɔyeyaw na wodi Asafo Awurade nkurɔfo ho fɛw nti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade ho suro bɛba wɔn so","poem":1},{"text":"bere a ɔbɛsɛe asase no so anyame nyinaa.","poem":2},{"text":"Mpoano aman nyinaa bɛsɔre no,","poem":1},{"text":"wɔ wɔn ankasa wɔn asase so.","poem":2}]},{"type":"heading","content":["Atemmu A Etia Kus"]},{"type":"verse","number":12,"content":[{"text":"“Mo Etiopiafo nso,","poem":1},{"text":"mʼafoa ano na wobekunkum mo.”","poem":2}]},{"type":"heading","content":["Atemmu A Etia Asiria"]},{"type":"verse","number":13,"content":[{"text":"Awurade bɛteɛ ne nsa wɔ atifi aman so","poem":1},{"text":"na wasɛe Asiria,","poem":2},{"text":"na wama Ninewe ada mpan koraa","poem":1},{"text":"na so awo wosee sɛ nwea pradada so.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nguankuw ne anantwi bɛdeda hɔ,","poem":1},{"text":"mmoadoma nyinaa.","poem":2},{"text":"Sare so patu ne abonsamnoma","poem":1},{"text":"bɛtena nʼadum no so.","poem":2},{"lineBreak":true},{"text":"Wɔn su begyigye afa mfɛnsere mu,","poem":2},{"text":"nnwiriwii besisiw apon ano akwan,","poem":1},{"text":"mpuran a wɔde sida ayɛ no ho bɛdeda hɔ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eyi ne kuropɔn a edi ahurusi","poem":1},{"text":"na ɛte asomdwoe mu.","poem":2},{"text":"Ɔhoahoaa ne ho se,","poem":1},{"text":"“Me ne no, obiara nte sɛ me.”","poem":2},{"text":"Hwɛ sɛnea atetew apansam,","poem":1},{"text":"na ayɛ nkekammoa atenae!","poem":2},{"text":"Obiara a otwa mu wɔ hɔ no serew no,","poem":1},{"text":"him ne nsa fɛwdi so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}