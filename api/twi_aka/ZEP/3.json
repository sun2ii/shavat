{"translation":{"id":"twi_aka","name":"Biblica® Wonhia ɛho kwamma nhoma Akuapem Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twi","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twi","licenseNotes":null,"shortName":"AKA","englishName":"Akuapem Twi Bible","language":"twi","textDirection":"ltr","sha256":"699f78e214e4470bc3f1a31b28084894e9d1582da1f9ab874002499466c1cba4","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_aka/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ZEP","translationId":"twi_aka","name":"Sefania","commonName":"Sefania","title":"Odiyifo Sefania Nhoma","order":36,"numberOfChapters":3,"sha256":"c1e84433b2feca12fdb4315d1a89401dc3d5c78446047d1820961438b886e2e3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_aka/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_aka/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusalem Daakye"]},{"type":"verse","number":1,"content":[{"text":"Nnome nka nhyɛsofo kuropɔn","poem":1},{"text":"atuatew kuropɔn a ho agu fi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɔnyɛ osetie mma obiara","poem":1},{"text":"onnye nteɛso biara nto mu.","poem":2},{"text":"Ɔmfa ne ho nto Awurade so.","poem":1},{"text":"Ontwiw mmɛn ne Nyankopɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nʼakannifo yɛ gyata a wɔbobɔ mu,","poem":1},{"text":"ne sodifo yɛ mpataku a wɔnam anadwo,","poem":2},{"text":"a wonnya biribiara mma adekyee.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne nkɔmhyɛfo yɛ ahantan;","poem":1},{"text":"wɔyɛ afatwafo.","poem":2},{"text":"Nʼasɔfo gu kronkronbea ho fi.","poem":1},{"text":"Wɔnam mmara no so di nsɛmmɔne.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awurade a ɔte ne mu no yɛ ɔtreneeni;","poem":1},{"text":"ɔnyɛ mfomso biara.","poem":2},{"text":"Adekyee biara, ɔda ne trenee adi,","poem":1},{"text":"na onni huammɔ da,","poem":2},{"lineBreak":true},{"text":"nanso amumɔyɛfo de, wonnim aniwu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Masɛe amanaman;","poem":1},{"text":"madwiriw wɔn abandennen agu.","poem":2},{"text":"Wɔn mmorɔn so adeda mpan,","poem":1},{"text":"a obiara ntwa mu hɔ.","poem":2},{"text":"Wɔasɛe wɔn nkuropɔn;","poem":1},{"text":"a obiara renka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meka kyerɛɛ kuropɔn no se,","poem":1},{"text":"‘ampa ara wubesuro me","poem":2},{"text":"na woagye nteɛso ato mu!’","poem":1},{"lineBreak":true},{"text":"Na afei ne tenabea rensɛe,","poem":1},{"text":"na mʼasotwe biara nso remma no so.","poem":2},{"text":"Nanso wɔn ho peree wɔn","poem":1},{"text":"sɛ wɔbɛkɔ so ayɛ bɔne, wɔn nneyɛe nyinaa mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti twɛn me,” sɛnea Awurade se ni,","poem":1},{"text":"“na da no mɛsɔre adi adanse.","poem":2},{"text":"Mayɛ mʼadwene sɛ mɛboaboa amanaman","poem":1},{"text":"ne ahenni ano","poem":2},{"text":"na mahwie mʼabufuw agu wɔn so","poem":1},{"text":"mʼabufuwhyew nyinaa.","poem":2},{"text":"Me ninkutwe abufuw gya mu no,","poem":1},{"text":"asase nyinaa bɛhyew.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Afei medwira nnipa no ano,","poem":1},{"text":"na wɔn nyinaa abɔ Awurade din","poem":2},{"lineBreak":true},{"text":"na wɔaka abɔ mu asom no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mʼasomfo, me nkurɔfo a wɔabɔ ahwete no","poem":1},{"text":"befi nsubɔnten a ɛwɔ Kus nohɔ","poem":2},{"lineBreak":true},{"text":"de wɔn afɔrebɔde abrɛ me.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saa da no, wo Yerusalem, wɔrengu wʼanim ase","poem":1},{"text":"wɔ nneyɛe bɔne a woayɛ atia me ho,","poem":2},{"text":"efisɛ meyi afi saa kuropɔn yi mu,","poem":1},{"text":"wɔn a wodi ahantan mu ahurusi,","poem":2},{"text":"na worenyɛ ahantan bio","poem":1},{"text":"wɔ me bepɔw kronkron no so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso megyaw wɔ wo mu","poem":1},{"text":"wɔn a wodwo na wɔbrɛ wɔn ho ase,","poem":2},{"lineBreak":true},{"text":"na wɔde wɔn ho to Awurade so no.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔrenyɛ bɔne biara;","poem":1},{"text":"wɔrenka nkontomposɛm,","poem":2},{"text":"na wɔn ano renka nnaadaasɛm","poem":1},{"text":"wobedidi na wɔada,","poem":2},{"lineBreak":true},{"text":"na obiara renyi wɔn hu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"To dwom, Ɔbabea Sion;","poem":1},{"text":"teɛ mu dennen, Israel!","poem":2},{"text":"Ma wʼani nnye, na di ahurusi wɔ wo koma nyinaa mu,","poem":1},{"text":"Ɔbabea Yerusalem!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Efisɛ Awurade ayi wʼasotwe afi wo so,","poem":1},{"text":"wama wo tamfo asan nʼakyi.","poem":2},{"text":"Awurade, Israelhene ka wo ho;","poem":1},{"text":"worensuro ɔhaw biara bio.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saa da no, wɔbɛka akyerɛ Yerusalem se,","poem":1},{"text":"“Nsuro, Sion!","poem":2},{"lineBreak":true},{"text":"Mma wo nsa mu ngow.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Awurade wo Nyankopɔn ne wo wɔ hɔ,","poem":1},{"text":"Ɔyɛ ogyefo ɔhoɔdenfo.","poem":2},{"text":"Nʼani begye wo ho","poem":1},{"text":"ne dɔ mu, ɔrenka wʼanim bio,","poem":2},{"lineBreak":true},{"text":"ɔde nnwonto bedi wo ho anigye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Meyi wɔn a wodi awerɛhow","poem":1},{"text":"wɔ wʼafahyɛnna ahorow a woahwere;","poem":2},{"lineBreak":true},{"text":"a ayɛ adesoa ne animguase ama wo no ho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Saa bere no me ne wɔn","poem":1},{"text":"a wɔhyɛɛ wo so nyinaa bedi.","poem":2},{"text":"Megye mmerɛwyɛfo","poem":1},{"text":"na mɛboaboa wɔn a wɔabɔ wɔn ahwete no ano.","poem":2},{"text":"Mɛkamfo wɔn ahyɛ wɔn anuonyam","poem":1},{"text":"asase biara a woguu wɔn anim ase wɔ so no so.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saa bere no, mɛboaboa mo ano;","poem":1},{"text":"saa bere no, mede mo bɛba fie.","poem":2},{"text":"Mɛhyɛ wo anuonyam na makamfo mo","poem":1},{"text":"wɔ asase so nnipa nyinaa mu","poem":2},{"text":"bere a mede mo ahonyade bɛsan ama wo","poem":1},{"text":"na mode mo ani behu no,”","poem":2},{"lineBreak":true},{"text":"sɛnea Awurade se ni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_aka/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_aka/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_aka/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}