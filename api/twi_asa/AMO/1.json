{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_asa","name":"Amos","commonName":"Amos","title":"Odiyifoɔ Amos Nwoma","order":30,"numberOfChapters":9,"sha256":"22b0562f7e34ccb09a353d8993aa0ebe3db43d343f7f769dfb0d065054d688cb","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_asa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Amos, Tekoa nnwanhwɛfoɔ no mu baako nsɛm nie. Ɔnyaa saa anisoadehunu yi a ɛfa Israel ho mfeɛ mmienu ansa na asase wosooɛ no, ɛberɛ a Usia di ɔhene wɔ Yuda na Yoas babarima Yeroboam nso di ɔhene wɔ Israel no."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["Ɔkaa sɛ:",{"text":"“Awurade bobom firi Sion bepɔ so","poem":1},{"text":"na ɔde aprannaa nnyegyeeɛ nso firi Yerusalem;","poem":2},{"text":"nnwanhwɛfoɔ mmoa adidibea rehye","poem":1},{"text":"na Karmel atifi nso kusa.”","poem":2}]},{"type":"heading","content":["Atemmuo A Ɛfa Amanamanmufoɔ Ahodoɔ Ho"]},{"type":"verse","number":3,"content":["Deɛ Awurade seɛ nie:",{"text":"“Damasko ayɛ bɔne bebree ama no atra so","poem":1},{"text":"ɛno enti, merennane mʼabufuo.","poem":2},{"text":"Ɛfiri sɛ, ɔde ayuporeeɛ adeɛ a ɛwɔ dadeɛ se","poem":1},{"text":"dwerɛɛ Gilead.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mede ogya bɛto Hasael efie","poem":1},{"text":"na ahye Ben-Hadad aban no.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɛbubu Damasko apono,","poem":1},{"text":"na mɛsɛe ɔhene a ɔwɔ Awen bɔnhwa no mu no","poem":2},{"text":"ne deɛ ɔkura ahempoma wɔ Bet Eden no.","poem":1},{"text":"Na Aramfoɔ bɛkɔ nnommumfa mu wɔ Kir,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Deɛ Awurade seɛ nie:","poem":1},{"lineBreak":true},{"text":"“Gasa ayɛ bɔne bebree ama no atra so,","poem":1},{"text":"ɛno enti, merennane mʼabufuo no.","poem":2},{"text":"Ɔfaa ɔman mu no nyinaa nnommum","poem":1},{"text":"na ɔtɔnee wɔn maa Edomfoɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mede ogya bɛto Gasa afasuo mu,","poem":1},{"text":"na ahye nʼaban no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɛsɛe Asdod ɔhene no","poem":1},{"text":"ne deɛ ɔkura ahempoma wɔ Askelon no.","poem":2},{"text":"Mɛdane me nsa atia Ekron,","poem":1},{"text":"kɔsi sɛ Filistini a ɔtwa toɔ no bɛwu,”","poem":2},{"text":"sɛdeɛ Asafo Awurade seɛ nie.","poem":1}]},{"type":"verse","number":9,"content":["Deɛ Awurade seɛ nie:",{"text":"“Tiro ayɛ bɔne bebree ama no atra so,","poem":1},{"text":"ɛno enti, merennane mʼabufuo.","poem":2},{"text":"Ɔfaa ɔman mu no nnommum","poem":1},{"text":"na ɔtɔnee wɔn maa Edomfoɔ,","poem":2},{"lineBreak":true},{"text":"a wankae onuadɔ apam.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mede ogya bɛto Tiro afasuo no mu,","poem":1},{"text":"na ahye nʼaban.”","poem":2}]},{"type":"verse","number":11,"content":["Deɛ Awurade seɛ nie:",{"text":"“Edom ayɛ bɔne bebree ama no atra so,","poem":2},{"text":"ɛno enti, merennane mʼabufuo.","poem":1},{"text":"Ɔde akofena taataa ne nua,","poem":2},{"lineBreak":true},{"text":"a wannya ayamhyehyeɛ biara.","poem":2},{"text":"Ɛfiri sɛ ne bo kɔɔ so fuiɛ","poem":1},{"text":"na obiara antumi annwodwo nʼabufuo no ano.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mede ogya bɛto Teman mu,","poem":1},{"text":"na ahye Bosra aban.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sɛdeɛ Awurade seɛ nie:","poem":1},{"text":"“Amon ayɛ bɔne bebree ama no atra so,","poem":2},{"lineBreak":true},{"text":"ɛno enti, merennane mʼabufuo.","poem":2},{"text":"Ɔde akofena paepaee Gilead apemfoɔ yafunu mu","poem":1},{"text":"de trɛɛ nʼahyeɛ mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mede ogya bɛto Raba afasuo mu","poem":1},{"text":"na ahye nʼaban","poem":2},{"text":"wɔ ɔko da mu nteateam","poem":1},{"text":"ne ahum da ntwaho mframa mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Na ne ɔhene ne mmapɔmma","poem":1},{"text":"bɛbom akɔ nnommumfa mu,”","poem":2},{"text":"sɛdeɛ Awurade seɛ nie.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}