{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_asa","name":"Amos","commonName":"Amos","title":"Odiyifoɔ Amos Nwoma","order":30,"numberOfChapters":9,"sha256":"22b0562f7e34ccb09a353d8993aa0ebe3db43d343f7f769dfb0d065054d688cb","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_asa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Deɛ Awurade seɛ nie:",{"text":"“Moab ayɛ bɔne bebree ama no atra so,","poem":2},{"text":"ɛno enti, merennane mʼabufuo.","poem":1},{"text":"Ɔhyee Edomhene nnompe,","poem":2},{"lineBreak":true},{"text":"ma ɛdanee nsõ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mede ogya bɛto Moab mu,","poem":1},{"text":"na ahye Keriot aban.","poem":2},{"text":"Moab bɛhwe ase wɔ hooyɛ,","poem":1},{"text":"ɔko nteateamu ne totorobɛnto nnyegyeeɛ mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɛsɛe ne sodifoɔ","poem":1},{"text":"na makunkum ne mmapɔmma aka ne ho,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deɛ Awurade seɛ nie:","poem":1},{"text":"“Yuda ayɛ bɔne bebree ama no atra so,","poem":2},{"text":"ɛno enti, merennane mʼabufuo.","poem":1},{"text":"Wɔapo Awurade mmara no","poem":2},{"text":"na wɔanni nʼahyɛdeɛ so","poem":1},{"text":"ɛfiri sɛ atorɔ anyame no","poem":2},{"text":"ama wɔafom ɛkwan no,","poem":1},{"text":"anyame a wɔn nananom dii akyire no.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mede ogya bɛto Yuda mu","poem":1},{"text":"na ahye Yerusalem aban.”","poem":2}]},{"type":"heading","content":["Israel Atemmuo"]},{"type":"verse","number":6,"content":["Deɛ Awurade seɛ nie:",{"text":"“Israel ayɛ bɔne bebree ama no atra so,","poem":1},{"text":"ɛno enti, merennane mʼabufuo.","poem":2},{"text":"Wɔtɔn ateneneefoɔ de gye dwetɛ,","poem":1},{"text":"ne ahiafoɔ de gye mpaboa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔtiatia ahiafoɔ so","poem":1},{"text":"te sɛ deɛ wɔyɛ fam mfuturo","poem":2},{"lineBreak":true},{"text":"na wɔma atɛntenenee bɔ mmɔborɔwafoɔ.","poem":2},{"text":"Agya ne ne ba ne ɔbaa baako da","poem":1},{"text":"de gu me din kronkron no ho fi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔdeda afɔrebukyia biara ho","poem":1},{"text":"wɔ wɔn awowa ntoma so.","poem":2},{"text":"Wɔ wɔn anyame efie no mu no","poem":1},{"text":"wɔnom nsã a wɔagye sɛ mmaratodeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mesɛee Amorifoɔ no wɔ wɔn anim,","poem":1},{"text":"ɛwom sɛ wɔware te sɛ ntweneduro.","poem":2},{"lineBreak":true},{"text":"Wɔn ho nso yɛ den sɛ odum.","poem":2},{"text":"Mesɛee nʼaba wɔ ne soro,","poem":1},{"text":"ne ne nhini wɔ nʼase.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meyii wo firii Misraim,","poem":1},{"text":"na medii wʼanim mfirinhyia aduanan wɔ ɛserɛ so","poem":2},{"text":"sɛdeɛ mede Amorifoɔ asase bɛma wo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Meyiyii mo mmammarima no bi yɛɛ wɔn adiyifoɔ,","poem":1},{"text":"ne mo mmeranteɛ binom sɛ Nasarefoɔ.","poem":2},{"text":"Na ɛnte saa anaa, Israelfoɔ?”","poem":1},{"text":"Deɛ Awurade bisa nie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Nanso momaa Nasarefoɔ no nom nsã","poem":1},{"text":"na mohyɛɛ adiyifoɔ no sɛ wɔnnhyɛ nkɔm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Na afei, mɛdwerɛ mo","poem":1},{"text":"sɛdeɛ teaseɛnam a aduane ayɛ no ma mia asase no.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ahoɔherɛfoɔ rentumi nnwane.","poem":1},{"text":"Ahoɔdenfoɔ rennya ahoɔden,","poem":2},{"text":"na akofoɔ rennya ne ho ntete.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Agyantofoɔ rentumi nnyina deɛ ɔgyina.","poem":1},{"text":"Asraafoɔ ahoɔherɛfoɔ rentumi nnwane,","poem":2},{"lineBreak":true},{"text":"na pɔnkɔsotefoɔ rentumi mpere ne nkwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mpo akofoɔ akokoɔdurufoɔ","poem":1},{"text":"de adagya bɛdwane wɔ saa da no,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}