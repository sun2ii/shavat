{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_asa","name":"Amos","commonName":"Amos","title":"Odiyifoɔ Amos Nwoma","order":30,"numberOfChapters":9,"sha256":"22b0562f7e34ccb09a353d8993aa0ebe3db43d343f7f769dfb0d065054d688cb","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_asa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Wɔfrɛ Adansefoɔ Tia Israel"]},{"type":"verse","number":1,"content":["Montie saa asɛm a Awurade aka atia mo yi, Ao, Israelfoɔ, deɛ ɛtia abusua a meyii wɔn firii Misraim no nyinaa:"]},{"type":"verse","number":2,"content":[{"text":"“Mo nko ara na mayi mo","poem":1},{"text":"wɔ mmusua a ɛwɔ asase so nyinaa mu;","poem":2},{"lineBreak":true},{"text":"enti mɛtwe mo aso","poem":2},{"lineBreak":true},{"text":"wɔ mo bɔne nyinaa ho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nnipa baanu bɛtumi abom anante,","poem":1},{"text":"wɔ ɛberɛ a wɔnyɛɛ anokorɔ anaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gyata bobom wɔ dɔtɔ ase","poem":1},{"text":"wɔ ɛberɛ a ɔnhunuu ahaboa biara anaa?","poem":2},{"text":"Ɔpɔ so wɔ ne buo mu","poem":1},{"text":"wɔ ɛberɛ a ɔnkyeree ahaboa biara anaa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anomaa bɛtɔ afidie mu wɔ fam","poem":1},{"text":"wɔ baabi a wɔnnsum afidie anaa?","poem":2},{"text":"Afidie hwan wɔ","poem":1},{"text":"ɛberɛ a ɛnyii aboa anaa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sɛ wɔhyɛn totorobɛnto wɔ kuropɔn mu a","poem":1},{"text":"nnipa no ho mpopo anaa?","poem":2},{"text":"Sɛ atoyerɛnkyɛm ba kuropɔn bi mu a","poem":1},{"text":"ɛnyɛ Awurade na ɔyɛeɛ anaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ampa ara, Otumfoɔ Awurade nnyɛ biribi","poem":1},{"text":"a ɔnna ne nhyehyeɛ adi","poem":2},{"lineBreak":true},{"text":"nkyerɛ nʼAsomafoɔ adiyifoɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gyata no abobom,","poem":1},{"text":"hwan na ɔnnsuro?","poem":2},{"text":"Otumfoɔ Awurade akasa,","poem":1},{"text":"hwan na ɔrenhyɛ ho nkɔm?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mompae mu nka nkyerɛ Asdod aban","poem":1},{"text":"ne Misraim aban:","poem":2},{"text":"“Mommoaboa mo ho ano wɔ Samaria mmepɔ so;","poem":1},{"text":"hwɛ basabasayɛ a ɛwɔ ne so","poem":2},{"lineBreak":true},{"text":"ne nhyɛsoɔ a ɛwɔ ne nkurɔfoɔ mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Wɔnnim sɛdeɛ wɔyɛ deɛ ɛyɛ,”","poem":1},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2},{"text":"Wɔde nneɛma a wɔafo ne deɛ wɔawia","poem":1},{"text":"sie wɔ wɔn aban mu.","poem":2}]},{"type":"verse","number":11,"content":["Ɛno enti, yei ne deɛ Otumfoɔ Awurade seɛ,",{"text":"“Ɔtamfoɔ bi bɛtwi afa asase no so;","poem":1},{"text":"Ɔbɛbubu wʼabanbɔeɛ agu,","poem":2},{"lineBreak":true},{"text":"na wafo wʼaban.”","poem":2}]},{"type":"verse","number":12,"content":["Deɛ Awurade seɛ nie:",{"text":"“Sɛdeɛ odwanhwɛfoɔ gye","poem":2},{"text":"nnyawa mmienu nnompe anaa aso sin","poem":1},{"text":"firi gyata anom no,","poem":2},{"text":"saa ara na wɔbɛgye Israelfoɔ nkwa,","poem":1},{"text":"wɔn a wɔtete wɔn mpa twea so wɔ Samaria,","poem":2},{"lineBreak":true},{"text":"ne wɔn a wɔdeda nkonwa pa mu wɔ Damasko.”","poem":2}]},{"type":"verse","number":13,"content":["“Tie yei, na di adanseɛ tia Yakob efie,” sɛdeɛ Awurade, Asafo Awurade Onyankopɔn seɛ nie."]},{"type":"verse","number":14,"content":[{"text":"“Ɛda a mɛtwe Israel aso wɔ ne nnebɔne ho no,","poem":1},{"text":"mɛsɛe afɔrebukyia a ɛwɔ Bet-El;","poem":2},{"text":"wɔbɛtwitwa afɔrebukyia no mmɛn","poem":1},{"text":"na abu ahwe fam.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɛdwiri awɔberɛ efie","poem":1},{"text":"ne ahuhuro berɛ efie agu;","poem":2},{"text":"na afie a wɔde asonse adura ho no wɔbɛsɛe no","poem":1},{"text":"na afie akɛseɛ no nso wɔbɛbubu agu,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}