{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"AMO","translationId":"twi_asa","name":"Amos","commonName":"Amos","title":"Odiyifoɔ Amos Nwoma","order":30,"numberOfChapters":9,"sha256":"22b0562f7e34ccb09a353d8993aa0ebe3db43d343f7f769dfb0d065054d688cb","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/twi_asa/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Ahunu Ne Adwensakyera"]},{"type":"verse","number":1,"content":["Tie asɛm yi, mo Israelfoɔ, saa mmenabɔ yi fa mo ho:"]},{"type":"verse","number":2,"content":[{"text":"“Ɔbabunu Israel ahwe ase","poem":1},{"text":"a ɔrensɔre bio,","poem":2},{"text":"wɔapo no ɔno ara asase so,","poem":1},{"text":"na ɔnni obi a ɔbɛpagya no.”","poem":2}]},{"type":"verse","number":3,"content":["Deɛ Otumfoɔ Awurade seɛ nie:",{"text":"“Kuropɔn a ɔde mmarima ahoɔdenfoɔ apem ko ma Israel no,","poem":1},{"text":"emu ɔha pɛ na ɛbɛka;","poem":2},{"text":"Kuro a ɔde ahoɔdenfoɔ ɔha no,","poem":1},{"text":"emu edu pɛ na ɛbɛka.”","poem":2}]},{"type":"verse","number":4,"content":["Deɛ Awurade ka kyerɛ Israelfoɔ nie:",{"text":"“Monhwehwɛ me na monnya nkwa;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Monnhwehwɛ Bet-El,","poem":2},{"lineBreak":true},{"text":"monnkɔ Gilgal,","poem":2},{"text":"na monntu ɛkwan nkɔ Beer-Seba nso.","poem":1},{"text":"Ampa ara Gilgal bɛkɔ nnommumfa mu","poem":2},{"lineBreak":true},{"text":"na wɔbɛhwe Bet-El ase koraa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Monhwehwɛ Awurade na monnya nkwa,","poem":1},{"lineBreak":true},{"text":"anyɛ saa a ɔbɛpra Yosef efie te sɛ ogya;","poem":1},{"text":"ɛbɛhye,","poem":2},{"lineBreak":true},{"text":"na Bet-El rennya obi nnum no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mo a moma atemmuo yɛ nwono","poem":1},{"text":"na mototo tenenee ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Deɛ ɔbɔɔ nsoromma, Akokɔbaatan ne ne mma,","poem":1},{"lineBreak":true},{"text":"deɛ ɔdane esum yɛ no adekyeeɛ","poem":1},{"text":"na ɔma awia dane adesaeɛ.","poem":2},{"text":"Deɛ ɔboaboa ɛpo mu nsuo ano","poem":1},{"text":"na ɔhwie gu asase so,","poem":2},{"lineBreak":true},{"text":"ne din ne Awurade.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔsɛe abandenden ntɛm so","poem":1},{"text":"na ɔbubu kuropɔn a wɔabɔ ho ban nso,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"motane deɛ ɔtenetene wɔ asɛnniiɛ","poem":1},{"text":"na mobu deɛ ɔka nokorɛ animtiaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Motiatia ohiani so","poem":1},{"text":"na mohyɛ no gye aduane firi ne nkyɛn.","poem":2},{"text":"Enti, ɛwom sɛ mode aboɔ a wɔatwa asisi afie akɛseɛ deɛ,","poem":1},{"text":"nanso morentena mu;","poem":2},{"text":"ɛwom sɛ moayɛ bobe nturo a ɛyɛ fɛ deɛ","poem":1},{"text":"nanso morennom emu nsã.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Na menim mo mmarato dodoɔ","poem":1},{"text":"ne mo bɔne akɛseɛ no.","poem":2},{"lineBreak":true},{"text":"Mohyɛ teneneefoɔ so na mogye adanmudeɛ","poem":1},{"text":"mobu ahiafoɔ ntɛnkyea wɔ asɛnniiɛ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ɛno enti, ɔnyansafoɔ yɛ komm saa mmerɛ yi mu,","poem":1},{"text":"ɛfiri sɛ, ɛyɛ mmerɛ bɔne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Monhwehwɛ papa, na moanya nkwa","poem":1},{"text":"na ɛnyɛ bɔne.","poem":2},{"text":"Na Asafo Awurade Onyankopɔn bɛka wo ho,","poem":1},{"text":"sɛdeɛ moka sɛ ɔyɛ no.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Monkyiri bɔne, na monnɔ papa;","poem":1},{"text":"Monni atɛn tenenee wɔ asɛnniiɛ.","poem":2},{"text":"Ebia, Asafo Awurade Onyankopɔn","poem":1},{"text":"bɛnya ahummɔborɔ ama","poem":2},{"lineBreak":true},{"text":"Yosef nkaeɛfoɔ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti deɛ Awurade, Asafo Awurade Onyankopɔn seɛ nie:","poem":1},{"text":"“Mmenabɔ bɛba mmorɔno nyinaa so","poem":2},{"text":"na ɔyea ne apinisie bɛba mmɔntene so.","poem":1},{"text":"Wɔbɛfrɛ akuafoɔ ama wɔabɛsu","poem":2},{"lineBreak":true},{"text":"na agyamfoɔ abɛtwa adwo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔbɛbɔ mmena wɔ bobeturo nyinaa mu,","poem":1},{"text":"ɛfiri sɛ mɛnante mo mu,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"heading","content":["Awurade Ɛda No"]},{"type":"verse","number":18,"content":[{"text":"Nnome nka wɔn a","poem":1},{"text":"wɔpɛ sɛ Awurade da no ba!","poem":2},{"text":"Deɛn enti na mopɛ sɛ Awurade da no ba?","poem":1},{"text":"Saa ɛda no bɛyɛ esum, na ɛnnyɛ hann.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ɛbɛyɛ te sɛ ɔnipa a ɔdwane firi gyata anim","poem":1},{"text":"na ɔkohyia sisire,","poem":2},{"text":"sɛ deɛ owura ne fie","poem":1},{"text":"de ne nsa to ɔfasuo so,","poem":2},{"lineBreak":true},{"text":"na ɔwɔ ka no.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na Awurade da no bɛyɛ esum; ɛrenyɛ hann,","poem":1},{"text":"ɛbɛyɛ esum kabii a ɛhan nsensaneɛ biara nni mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mekyiri na mepo mo nyamesom mu apontoɔ;","poem":1},{"text":"mʼani nnye mo afahyɛ nhyiamu ho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ɛwom sɛ mode ɔhyeɛ afɔdeɛ ne aduane afɔdeɛ brɛ me deɛ,","poem":1},{"text":"nanso merennye.","poem":2},{"text":"Mode asomdwoeɛ afɔdeɛ brɛ me","poem":1},{"text":"nanso mʼani rensɔ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Momfa mo nnwontoɔ gyegyeegye no mfiri me so!","poem":1},{"text":"Merentie mo asankuten so nnwom.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mmom, momma atɛntenenee ntene sɛ asubɔnten,","poem":1},{"text":"na tenenee nyɛ sɛ asutene a ɛrenwe da!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Israelfoɔ, ɛnyɛ me na mode afɔrebɔdeɛ ne ayɛyɛdeɛ brɛɛ me","poem":1},{"text":"mfeɛ aduanan wɔ ɛserɛ so anaa?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mode mo ho nyinaa ato Molek nyame,","poem":1},{"lineBreak":true},{"text":"ne mo honi Rɛfan so;","poem":1},{"text":"wɔyɛ ahoni a moayɛ sɛ mobɛsom wɔn.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɛno enti, mɛtwa mo asuo akɔ Damasko nohoa,”","poem":1},{"text":"sɛdeɛ Awurade a ne din ne Onyankopɔn Otumfoɔ seɛ nie.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}