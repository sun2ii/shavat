{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EXO","translationId":"twi_asa","name":"2 Mose (Ɛksodɔs)","commonName":"2 Mose (Ɛksodɔs)","title":"Ɛksodɔs Mose Nwoma A Ɛtɔ So Mmienu","order":2,"numberOfChapters":40,"sha256":"cad7e00d3ece9a82459e3fa59eb417c15a4e6e903f90015ca4701e5b765279f5","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/twi_asa/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Ɔgyeɛ Ho Dwom"]},{"type":"verse","number":1,"content":["Afei, Mose ne Israelfoɔ too saa dwom yi de kamfoo Awurade:",{"text":"“Mɛto dwom mama Awurade, ɛfiri sɛ,","poem":1},{"text":"wadi nkonim animuonyam mu;","poem":2},{"text":"Wato ɔpɔnkɔ ne ne sotefoɔ no","poem":1},{"text":"agu ɛpo mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Awurade yɛ mʼahoɔden, me dwom","poem":1},{"text":"ne me nkwagyeɛ.","poem":2},{"text":"Ɔyɛ me Onyankopɔn, na mɛkamfo no.","poem":1},{"text":"Ɔyɛ mʼagya Onyankopɔn—Mɛma no so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade yɛ ɔkofoɔ;","poem":1},{"text":"Aane, ne din ne Awurade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Farao nteaseɛnam ne nʼakodɔm, wato wɔn agu","poem":1},{"text":"Ama wɔamem Ɛpo Kɔkɔɔ mu.","poem":2},{"text":"Misraim akofoɔ atitire","poem":1},{"text":"awuwu asorɔkye ase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nsuo akata wɔn so.","poem":1},{"text":"Wɔmemem subunu mu sɛ ɛboɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wo nsa nifa, Ao, Awurade,","poem":1},{"text":"tumi ne animuonyam ahyɛ no ma.","poem":2},{"text":"Wo nsa nifa, Ao, Awurade,","poem":1},{"text":"atete atamfoɔ mu pasaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wo tumi kɛseɛ no mu,","poem":1},{"text":"wotuu wɔn a wɔtia wo no guiɛ.","poem":2},{"text":"Womaa wʼabufuhyeɛ","poem":1},{"text":"bɛhyee wɔn sɛ ogya hye ɛserɛ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wogu ahome a,","poem":1},{"text":"nsuo mu pae.","poem":2},{"text":"Ɛgyinaa sɛ afasuo","poem":1},{"text":"ma ɛpo taa ɛfa ne ɛfa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔtamfoɔ de ahomasoɔ kaeɛ sɛ,","poem":1},{"text":"‘Mɛtaa wɔn, mɛto wɔn, asɛe wɔn.","poem":2},{"text":"Na makyɛ afodeɛ no mu.","poem":1},{"text":"Mɛtwe mʼakofena wɔ wɔn so","poem":2},{"lineBreak":true},{"text":"atwitwa wɔn asinasini.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nanso, Onyankopɔn bɔɔ ne mframa","poem":1},{"text":"maa ɛpo kataa wɔn so.","poem":2},{"text":"Wɔmemem sɛ sumpii","poem":1},{"text":"wɔ subunu no mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hwan na ɔte sɛ Awurade wɔ anyame mu?","poem":1},{"text":"Hwan na ɔte sɛ wo?","poem":2},{"text":"Ɔberempɔn wɔ kronkronyɛ mu;","poem":1},{"text":"deɛ yɛde surokronkron ma nʼanimuonyam,","poem":2},{"lineBreak":true},{"text":"na ɔyɛ anwanwadeɛyɛfoɔ Onyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Wotenee wo nsa nifa","poem":1},{"text":"na asase menee wɔn.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Woadi nnipa a wogyee wɔn no anim,","poem":1},{"text":"wʼayamyɛ mu.","poem":2},{"text":"Wonam anwanwakwan so adi wɔn anim","poem":1},{"text":"de wɔn aba wʼasase kronkron no so.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amanaman tee asɛm a ɛsiiɛ ma wɔn ho popoeɛ.","poem":1},{"text":"Ehu aka nnipa a wɔwɔ Filistia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Edom mpanimfoɔ ho adwiri wɔn.","poem":1},{"text":"Atumfoɔ a wɔwɔ Moab ho woso.","poem":2},{"text":"Na nnipa a wɔwɔ Kanaan nyinaa abɔ huboa.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ehu ne suro afa wɔn so.","poem":2},{"text":"Ao, Awurade, wo tumi enti,","poem":1},{"text":"wɔremma yɛn so!","poem":2},{"text":"Wo nkurɔfoɔ a wotɔɔ wɔn","poem":1},{"text":"bɛtwa wɔn ho asomdwoeɛ mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wode wɔn bɛba abɛdua wɔn","poem":1},{"text":"wɔ wo bepɔ so,","poem":2},{"text":"wo ara wo efie hɔ, Awurade—","poem":1},{"text":"Kronkronbea a woasiesie sɛ wo tenabea no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Awurade bɛdi ɔhene","poem":1},{"text":"akɔsi daa.”","poem":2}]},{"type":"verse","number":19,"content":["Farao apɔnkɔ, nʼapɔnkɔkafoɔ ne ne nteaseɛnam pɛɛ sɛ wɔfa ɛpo no mu; nanso, Awurade buu nsuo afasuo no guu wɔn so ɛberɛ a na Israelfoɔ no nam mu sɛ asase wesee no."]},{"type":"verse","number":20,"content":["Ɛhɔ na Odiyifoɔ baa Miriam a ɔyɛ Aaron nuabaa faa twene bi bɔ de dii mmaa no anim ma wɔsaeɛ."]},{"type":"verse","number":21,"content":["Ɛnna Miriam too saa dwom yi:",{"text":"“Monto dwom mma Awurade","poem":1},{"text":"na wadi nkonim animuonyam mu.","poem":2},{"text":"Wama ɔpɔnkɔ ne ne sotefoɔ","poem":1},{"text":"amem ɛpo ase.”","poem":2}]},{"type":"verse","number":22,"content":["Afei, Mose dii Israelfoɔ no anim ne wɔn tu firii Ɛpo Kɔkɔɔ no ho kɔɔ Sur ɛserɛ so. Na wɔnantee ɛserɛ no so nnansa a wɔannya nsuo annom."]},{"type":"verse","number":23,"content":["Wɔduruu Mara no, wɔantumi annom ɛhɔ nsuo, ɛfiri sɛ, na ɛyɛ nwono. Ɛno enti na wɔfrɛ hɔ Mara no; aseɛ ne: Nwononwono."]},{"type":"verse","number":24,"content":["Afei, nnipa no danee wɔn ani tiaa Mose sɛ, “Osukɔm nku yɛn anaa?”"]},{"type":"verse","number":25,"content":["Mose srɛɛ Awurade sɛ ɔmmoa wɔn, na Awurade kyerɛɛ no dua bi. Na ɔtoo dubaa no too nsuo no mu, na ɛyɛɛ dɛ maa wɔtumi nomeeɛ. Mara hɔ na Awurade hyɛɛ saa mmara yi maa wɔn sɛ,"]},{"type":"verse","number":26,"content":["“Sɛ mobɛtie Awurade mo Onyankopɔn nne, na moayɛ ɔsetie, ayɛ ade tenenee deɛ a, yadeɛ a mema ɛbɔɔ Misraimfoɔ no, meremma bi mmɔ mo, ɛfiri sɛ, mene Awurade a mesa mo nyarewa.”"]},{"type":"verse","number":27,"content":["Wɔbaa Elim a ɛhɔ na na nsubura dumienu ne mmɛdua aduɔson wɔ enti, wɔsisii wɔn ntomadan, tenaa nsubura no ho."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}