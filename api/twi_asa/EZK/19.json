{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EZK","translationId":"twi_asa","name":"Hesekiel","commonName":"Hesekiel","title":"Odiyifoɔ Hesekiel Nwoma","order":26,"numberOfChapters":48,"sha256":"e2d52d9ca3692dc26e0383b201a943cc442e4b0e1f592a34a4525419938cbd5e","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/twi_asa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Israel Mmapɔmma Ho Kwadwom"]},{"type":"verse","number":1,"content":["“Momma Israel mmapɔmma ho kwadwom"]},{"type":"verse","number":2,"content":["na monka sɛ:",{"text":"“ ‘Na wo maame yɛ gyatabereɛ mu soronko","poem":1},{"text":"wɔ agyata mu!","poem":2},{"text":"Ɔdaa gyataburuwa mu","poem":1},{"text":"yɛnee ne mma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔyɛn ne mma no mu baako","poem":1},{"text":"ma ɔbɛyɛɛ gyata ɔhoɔdenfoɔ.","poem":2},{"text":"Ɔsuaa sɛdeɛ wɔtete ahaboa mu,","poem":1},{"text":"na ɔwee nnipa nam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amanaman no tee ne nka,","poem":1},{"text":"na wɔn amena yii no.","poem":2},{"text":"Wɔguu no nkapo de no kɔɔ","poem":1},{"text":"Misraim asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Ɛberɛ a ɔhunuu sɛ nʼanidasoɔ anyɛ hɔ,","poem":1},{"text":"na deɛ ɔrehwɛ anim ayera no,","poem":2},{"text":"ɔfaa ne ba foforɔ","poem":1},{"text":"yɛɛ no gyata ɔhoɔdenfoɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔkyinkyinii agyata no mu","poem":1},{"text":"ɛfiri sɛ na wayɛ gyata hoɔdenfoɔ.","poem":2},{"text":"Ɔsuaa sɛdeɛ wɔtete ahaboa mu","poem":1},{"text":"na ɔwee nnipa nam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔbubuu wɔn abandenden","poem":1},{"text":"na ɔsɛee wɔn nkuro.","poem":2},{"text":"Asase no ne wɔn a wɔte so nyinaa no,","poem":1},{"text":"ne mmobomu bɔɔ wɔn hu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Afei amanaman no sɔre tiaa no,","poem":1},{"text":"wɔn a wɔfiri nsase a atwa ahyia no so.","poem":2},{"text":"Wɔguu no asau kyeree no","poem":1},{"text":"wɔ wɔn amena mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔde nnarewa twee no kɔhyɛɛ ebuo mu","poem":1},{"text":"na wɔde no brɛɛ Babilonia ɔhene.","poem":2},{"text":"Wɔde no too nneduafie,","poem":1},{"text":"na wɔante ne mmobomu no bio","poem":2},{"lineBreak":true},{"text":"wɔ Israel mmepɔ no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Na wo maame te sɛ bobedua","poem":1},{"text":"a wɔtɛɛ no nsuo ho wɔ wo bobeturo mu.","poem":2},{"text":"Na ɛso aba, na ɛyiyii mman","poem":1},{"text":"nsuo a ɔnya no bebree no enti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne mman yɛɛ den yie","poem":1},{"text":"ɛdi mu sɛ wɔde yɛ ahemfo ahempoma.","poem":2},{"text":"Ɛkorɔn, bunkam faa nhahan a ayɛ kuhaa no so,","poem":1},{"text":"ne sorokɔ ne ne mman bebree no","poem":2},{"lineBreak":true},{"text":"maa no yɛɛ sononko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso wɔde abufuhyeɛ tuu nʼase","poem":1},{"text":"de no hwee fam.","poem":2},{"text":"Apueeɛ mframa maa no kasaeɛ,","poem":1},{"text":"ɛso aba tete guiɛ;","poem":2},{"text":"na ne mman a ɛwɔ ahoɔden no twintwameeɛ","poem":1},{"text":"na ogya hyeeɛ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei wɔakɔtɛ no wɔ ɛserɛ so","poem":1},{"text":"asase wesee a nsuo nni muo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ogya trɛ firii ne mman baako so","poem":1},{"text":"na ɛhyee nʼaba.","poem":2},{"text":"Anka mman a ɛwɔ ahoɔden baako mpo wɔ so","poem":1},{"text":"deɛ wɔde yɛ ahemfo ahempoma ma ɛyɛ yie no.’","poem":2},"Yei yɛ kwadwom, na ma wɔnto no saa ara.”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}