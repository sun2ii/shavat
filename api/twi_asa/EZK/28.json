{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EZK","translationId":"twi_asa","name":"Hesekiel","commonName":"Hesekiel","title":"Odiyifoɔ Hesekiel Nwoma","order":26,"numberOfChapters":48,"sha256":"e2d52d9ca3692dc26e0383b201a943cc442e4b0e1f592a34a4525419938cbd5e","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/twi_asa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Nkɔmhyɛ A Ɛtia Tirohene"]},{"type":"verse","number":1,"content":["Awurade asɛm baa me nkyɛn sɛ:"]},{"type":"verse","number":2,"content":["“Onipa ba, ka kyerɛ Tiro sodifoɔ no sɛ: ‘Yei ne deɛ Otumfoɔ Awurade seɛ:",{"text":"“ ‘Wofiri wʼahantan akoma mu ka sɛ,","poem":1},{"text":"“Meyɛ onyame;","poem":2},{"text":"mete onyame bi ahennwa so","poem":1},{"text":"wɔ ɛpo mfimfini.”","poem":2},{"text":"Nanso woyɛ onipa, wonyɛ onyame,","poem":1},{"text":"ɛwom, wodwene sɛ wonim nyansa sɛ onyame bi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wonim nyansa sene Daniel anaa?","poem":1},{"text":"Wonim kokoamsɛm biara anaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wonam wo nyansa ne nhunumu so","poem":1},{"text":"anya ahodeɛ ama wo ho.","poem":2},{"text":"Woapɛ sikakɔkɔɔ ne dwetɛ bebree","poem":1},{"text":"agu wʼakoradan mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wonam wʼadwadie mu nyansa so","poem":1},{"text":"ama wʼahonya adɔɔso,","poem":2},{"text":"na wʼahonya enti","poem":1},{"text":"wahoran wɔ wʼakoma mu.","poem":2}]},{"type":"verse","number":6,"content":["“ ‘Ɛno enti sei na Otumfoɔ Awurade seɛ:",{"text":"“ ‘Esiane sɛ wodwene sɛ wonim nyansa","poem":1},{"text":"te sɛ Onyame enti,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mede ananafoɔ reba abɛtia wo,","poem":1},{"text":"amanaman no mu ɔdesɛefoɔ pa ara;","poem":2},{"text":"wɔbɛtwetwe wɔn akofena","poem":1},{"text":"wɔ wʼahoɔfɛ ne wo nyansa so","poem":2},{"lineBreak":true},{"text":"na wɔahwire wʼanimuonyam no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔde wo bɛto amena no mu,","poem":1},{"text":"na wobɛwu owu yaaya","poem":2},{"lineBreak":true},{"text":"wɔ ɛpo mfimfini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Afei wobɛka sɛ, “Meyɛ onyame,”","poem":1},{"text":"wɔ wɔn a wɔkumm woɔ no anim anaa?","poem":2},{"text":"Wobɛyɛ onipa na ɛnyɛ onyame","poem":1},{"text":"wɔ wɔn a wɔkumm woɔ no nsam.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wobɛwu momonotofoɔ wuo","poem":1},{"text":"wɔ ananafoɔ nsam.","poem":2},"Me na maka, Otumfoɔ Awurade asɛm nie.’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["Awurade asɛm baa me nkyɛn sɛ:"]},{"type":"verse","number":12,"content":["“Onipa ba, ma kwadwom a ɛfa Tirohene ho a ka kyerɛ no sɛ: ‘Yei ne deɛ Otumfoɔ Awurade seɛ:",{"text":"“ ‘Na anka woyɛ pɛyɛ nhwɛsodeɛ,","poem":1},{"text":"na wowɔ nyansa na woyɛ ahoɔfɛ dua.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Na anka wowɔ Eden","poem":1},{"text":"Onyankopɔn turo no mu.","poem":2},{"text":"Wɔde abohemaa nyinaa siesie wo:","poem":1},{"text":"bogyanamboɔ, akarateboɔ ne bɔwerɛboɔ","poem":2},{"lineBreak":true},{"text":"sikabereɛboɔ, apopobibirieboɔ ne ahwehwɛboɔ,","poem":2},{"lineBreak":true},{"text":"aboɔdemmoɔ, nsrammaboɔ ne ahahammonoboɔ.","poem":2},{"text":"Wɔde sika kɔkɔɔ na ayɛ wʼahyehyɛdeɛ,","poem":1},{"text":"wɔsiesiee ne nyinaa ɛda a wɔbɔɔ woɔ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wɔsraa wo ngo sɛ ɔhwɛfoɔ Kerub,","poem":1},{"text":"ɛfiri sɛ saa na mehyɛɛ woɔ.","poem":2},{"text":"Na wowɔ Onyankopɔn bepɔ kronkron no so;","poem":1},{"text":"wonantee ogya aboɔ mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Na anka wʼakwan ho nni asɛm","poem":1},{"text":"ɛfiri ɛda a wɔbɔɔ woɔ no","poem":2},{"text":"kɔsii sɛ wɔhunuu amumuyɛ wɔ wo mu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wʼadwadie a emu trɛ no enti","poem":1},{"text":"wɔde akakabensɛm hyɛɛ wo ma","poem":2},{"lineBreak":true},{"text":"na woyɛɛ bɔne.","poem":2},{"text":"Ɛno enti mepamoo wo firii","poem":1},{"text":"Onyankopɔn bepɔ no so wɔ animguaseɛ mu,","poem":2},{"text":"na meyii wo adi, Ao ɔhwɛfoɔ Kerub,","poem":1},{"text":"firii ogya aboɔ no mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wo horanee wɔ wʼakoma mu","poem":1},{"text":"wʼahoɔfɛ enti,","poem":2},{"text":"na womaa wo nyansa porɔeɛ,","poem":1},{"text":"wʼanimuonyam no enti.","poem":2},{"text":"Enti metoo wo twenee fam;","poem":1},{"text":"na mede wo yɛɛ ahwɛdea wɔ ahemfo anim.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wode wo nnebɔne ne adwadie mu nsisie","poem":1},{"text":"agu wo kronkrommea ho fi,","poem":2},{"text":"ɛno enti memaa ogya firii wo mu","poem":1},{"text":"na ɛhyee wo,","poem":2},{"text":"na mema wo danee nsõ","poem":1},{"text":"wɔ wɔn a na wɔrehwɛ no nyinaa anim.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aman a na wɔnim woɔ nyinaa","poem":1},{"text":"ho adwiri wɔn wɔ wo ho:","poem":2},{"text":"wʼawieeɛ ayɛ ahomete","poem":1},{"text":"na wɔrenhunu wo bio.’ ”","poem":2}]},{"type":"heading","content":["Nkɔmhyɛ A Ɛtia Sidon"]},{"type":"verse","number":20,"content":["Awurade asɛm baa me nkyɛn sɛ:"]},{"type":"verse","number":21,"content":["“Onipa ba, fa wʼani kyerɛ Sidon na hyɛ nkɔm tia no"]},{"type":"verse","number":22,"content":["na ka sɛ: ‘Yei ne deɛ Otumfoɔ Awurade seɛ:",{"text":"“ ‘Me ne wo anya, Ao Sidon","poem":1},{"text":"na mɛnya animuonyam wɔ wo mu.","poem":2},{"text":"Wɔbɛhunu sɛ mene Awurade no,","poem":1},{"text":"ɛberɛ a mede asotwe aba wo so","poem":2},{"lineBreak":true},{"text":"na mada me ho adi sɛ ɔkronkronni wɔ wo mu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mɛma ɔyaredɔm aba wo so","poem":1},{"text":"na mama mogya atene wɔ wo mmɔntene so.","poem":2},{"text":"Apirafoɔ bɛtotɔ wɔ wo mu,","poem":1},{"text":"ɛberɛ a akofena redi ahim wɔ wo ho nyinaa.","poem":2},{"lineBreak":true},{"text":"Afei na wɔbɛhunu sɛ mene Awurade no.","poem":2}]},{"type":"verse","number":24,"content":["“ ‘Na Israelfoɔ rennya ayɔnkofoɔ a wɔwɔ adwemmɔne, wɔn a wɔwowɔ yayaaya sɛ ɔhwerɛm ne nkasɛɛ bio. Afei na wɔbɛhunu sɛ mene Otumfoɔ Awurade no."]},{"type":"verse","number":25,"content":["“ ‘Yei ne deɛ Otumfoɔ Awurade seɛ: Sɛ meboa Israelfoɔ ano firi aman a wabɔ wɔn apete no so a, mɛda me kronkronyɛ adi wɔ wɔn mu, ama amanaman no ahunu. Afei wɔbɛtena wɔn ankasa asase a mede maa me ɔsomfoɔ Yakob no so."]},{"type":"verse","number":26,"content":["Wɔbɛtena hɔ asomdwoeɛ mu na wɔbɛsisi adan, ayeyɛ bobe nturo; Wɔbɛtena ase asomdwoeɛ mu wɔ ɛberɛ a matwe nʼayɔnkofoɔ a wɔkasa tiaa no no nyinaa aso. Afei wɔbɛhunu sɛ mene Awurade, wɔn Onyankopɔn no.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}