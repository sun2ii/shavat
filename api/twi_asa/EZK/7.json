{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"EZK","translationId":"twi_asa","name":"Hesekiel","commonName":"Hesekiel","title":"Odiyifoɔ Hesekiel Nwoma","order":26,"numberOfChapters":48,"sha256":"e2d52d9ca3692dc26e0383b201a943cc442e4b0e1f592a34a4525419938cbd5e","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/twi_asa/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Awieeɛ No Aba"]},{"type":"verse","number":1,"content":["Awurade asɛm baa me nkyɛn sɛ,"]},{"type":"verse","number":2,"content":["“Onipa ba, yei ne asɛm a Otumfoɔ Awurade ka kyerɛ Israel asase no:",{"text":"“ ‘Awieeɛ no, awieeɛ no aduru","poem":1},{"text":"asase no ntweaso ɛnan no so!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awieeɛ no aduru wɔ wo so,","poem":1},{"text":"na mɛhwie mʼabufuhyeɛ agu wo so.","poem":2},{"text":"Mɛgyina wʼabrabɔ so abu wo atɛn, na","poem":1},{"text":"matua wo ka wɔ wʼakyiwadeɛ nyinaa so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Merenhunu wo mmɔbɔ","poem":1},{"text":"na meremfa wo ho nkyɛ wo.","poem":2},{"text":"Ampa ara mɛtua wo ka wɔ wo nneyɛɛ","poem":1},{"text":"ne wʼakyiwadeɛ a ɛwɔ wo mu no,","poem":2},"na moahunu sɛ me ne Awurade.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“Yei ne deɛ Otumfoɔ Awurade seɛ:",{"text":"“ ‘Atoyerɛnkyɛm! Atoyerɛnkyɛm a wontee da","poem":1},{"text":"nam ɛkwan so reba!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awieeɛ no aba!","poem":1},{"text":"Awieeɛ no aba!","poem":2},{"text":"Apagya ne ho atia wo.","poem":1},{"text":"Aba!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔsɛeɛ aduru mo,","poem":1},{"text":"mo a mote asase no so.","poem":2},{"text":"Ɛberɛ no aduru, ɛda no abɛn;","poem":1},{"text":"huboabɔ ɛberɛ a ɛnyɛ mmepɔ no so ahosɛpɛ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Merebɛhwie mʼabufuhyeɛ agu wo so","poem":1},{"text":"de awie mʼabufuo a ɛtia wo no.","poem":2},{"text":"Mɛgyina wo nneyɛɛ so abu wo atɛn,","poem":1},{"text":"na matua wo ka wɔ wʼakyiwadeɛ nyinaa so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Merenhunu wo mmɔbɔ,","poem":1},{"text":"na meremfa wo ho nkyɛ wo.","poem":2},{"text":"Mɛtua wo ka wɔ wo nneyɛɛ","poem":1},{"text":"ne wʼakyiwadeɛ a ɛwɔ wo mu no.","poem":2},"Afei mobɛhunu sɛ me, Awurade, na mebobɔ."]},{"type":"verse","number":10,"content":[{"text":"“ ‘Ɛda no nie!","poem":1},{"text":"Hwɛ aba!","poem":2},{"text":"Atemmuo da no apue,","poem":1},{"text":"abaa no afefɛ,","poem":2},{"lineBreak":true},{"text":"ahantan ahanehane!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Akakabensɛm ayɛ abaa","poem":1},{"text":"a wɔde twe amumuyɛ aso.","poem":2},{"text":"Nnipa no mu biara renka,","poem":1},{"text":"nnipakuo no mu biara,","poem":2},{"lineBreak":true},{"text":"ahonyadeɛ ne deɛ ɛsom bo biara renka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɛberɛ no aso!","poem":1},{"text":"Ɛda no aduru.","poem":2},{"text":"Mma ɔdetɔfoɔ ani nnnye","poem":1},{"text":"anaa ɔdetɔnfoɔ werɛ nho,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ abufuhyeɛ wɔ nnipakuo no nyinaa so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Deɛ ɔtɔn no nsa renka asase","poem":1},{"text":"a watɔn no bio","poem":2},{"lineBreak":true},{"text":"wɔ ɛberɛ a wɔn mmienu te ase,","poem":2},{"text":"Ɛfiri sɛ anisoadehunu a ɛfa nnipakuo","poem":1},{"text":"no nyinaa no rensesa.","poem":2},{"text":"Wɔn bɔne enti, wɔn mu baako koraa","poem":1},{"text":"remfa ne ho nni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘Ɛwom, wɔhyɛne totorobɛnto,","poem":1},{"text":"na wɔboaboa biribiara ano deɛ,","poem":2},{"text":"nanso obiara renkɔ ɔsa,","poem":1},{"text":"ɛfiri sɛ mʼabufuhyeɛ wɔ nnipakuo no nyinaa so.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akofena wɔ mfikyire;","poem":1},{"text":"na ɔyaredɔm ne ɛkɔm wɔ efie.","poem":2},{"text":"Wɔn a wɔwɔ ɔman no mu","poem":1},{"text":"bɛtotɔ wɔ akofena ano.","poem":2},{"text":"Wɔn a wɔwɔ kuropɔn no mu no,","poem":1},{"text":"ɔyaredɔm ne ɛkɔm bɛkum wɔn.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔn a wɔanya wɔn tiri adidi mu","poem":1},{"text":"na wɔadwane no bɛtena mmepɔ no so.","poem":2},{"text":"Na wɔakurum te sɛ","poem":1},{"text":"mmɔnhwa mu mmorɔnoma","poem":2},{"lineBreak":true},{"text":"wɔ wɔn mu biara bɔne enti.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nsa nyinaa bɛdwodwo","poem":1},{"text":"na nkotodwe nyinaa ayɛ mmrɛ sɛ nsuo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔbɛfirafira ayitoma","poem":1},{"text":"na wɔabɔ huboa.","poem":2},{"text":"Aniwuo bɛkata wɔn anim","poem":1},{"text":"na wɔayi wɔn tirinwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘Wɔbɛto wɔn dwetɛ agu mmɔntene so,","poem":1},{"text":"na wɔn sikakɔkɔɔ bɛyɛ adeɛ a ɛho nteɛ.","poem":2},{"text":"Wɔn dwetɛ ne sikakɔkɔɔ","poem":1},{"text":"rentumi nnye wɔn","poem":2},{"lineBreak":true},{"text":"Awurade abufuhyeɛ ɛda no.","poem":2},{"text":"Ɛrenkum wɔn kɔm","poem":1},{"text":"na ɛrenhyɛ wɔn yafunu ma,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ ayɛ wɔn suntidua de wɔn akɔ bɔne mu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na wɔde wɔn mpompranneɛ fɛfɛ no hoahoa wɔn ho,","poem":1},{"text":"na wɔde yeyɛɛ wɔn ahoni a ɛyɛ akyiwadeɛ","poem":2},{"text":"ne nsɛsodeɛ tantane;","poem":1},{"text":"enti mɛdane yeinom a ɛho nteɛ ama wɔn.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mede ne nyinaa bɛma ananafoɔ sɛ afodeɛ","poem":1},{"text":"na mede ama asase so atirimuɔdenfoɔ sɛ korɔnodeɛ,","poem":2},{"lineBreak":true},{"text":"na wɔbɛgu ho fi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɛyi mʼani afiri wɔn so","poem":1},{"text":"na akorɔmfoɔ bɛgu beaeɛ a ɛsom me bo ho fi.","poem":2},{"text":"Wɔbɛwura hɔ","poem":1},{"text":"na wɔagu ho fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘Monyɛ nkɔnsɔnkɔnsɔn!","poem":1},{"text":"Ɛfiri sɛ mogyahwiegu ayɛ asase no so ma,","poem":2},{"lineBreak":true},{"text":"na akakabensɛm ahyɛ kuropɔn no ma.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɛma aman no mu otirimuɔdenfoɔ pa ara","poem":1},{"text":"abɛfa wɔn afie;","poem":2},{"text":"mɛma ɔhoɔdenfoɔ ahomasoɔ aba awieeɛ,","poem":1},{"text":"na wɔn kronkrommea ho bɛgu fi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sɛ ehu ba a,","poem":1},{"text":"wɔbɛhwehwɛ asomdwoeɛ akyiri ɛkwan, nanso ɛbɛbɔ wɔn.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Atoyerɛnkyɛm bɛdi atoyerɛnkyɛm akyi aba;","poem":1},{"text":"atesɛm bɛdi atesɛm akyi.","poem":2},{"text":"Wɔbɛpɛ sɛ wɔbɛnya anisoadehunu afiri odiyifoɔ no hɔ,","poem":1},{"text":"Ɔsɔfoɔ nkyerɛkyerɛ a ɛfa mmara no ho no bɛbɔ wɔn.","poem":2},{"lineBreak":true},{"text":"Saa ara na wɔrennya afotuo mfiri mpanimfoɔ hɔ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɔhene no bɛtwa adwo,","poem":1},{"text":"ɔheneba no bɛfira abasamutuo,","poem":2},{"lineBreak":true},{"text":"na asase no so nnipa nsa bɛpopo.","poem":2},{"text":"Me ne wɔn bɛdi no sɛdeɛ wɔn nneyɛɛ teɛ,","poem":1},{"text":"na mɛgyina wɔn pɛpɛyɛ so abu wɔn atɛn.","poem":2},"Afei wɔbɛhunu sɛ me ne Awurade no.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}