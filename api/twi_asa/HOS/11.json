{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Onyankopɔn Dɔ A Ɔdɔ Israel"]},{"type":"verse","number":1,"content":[{"text":"“Ɛberɛ a Israel yɛ abɔfra no, na me dɔ no,","poem":1},{"text":"na Misraim na mefrɛɛ me babarima firiiɛ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nanso mpɛn dodoɔ a mefrɛɛ Israel no,","poem":1},{"text":"saa ara na wɔdwane firii me nkyɛn.","poem":2},{"text":"Wɔbɔɔ afɔdeɛ maa Baal ahoni,","poem":1},{"text":"na wɔhyee nnuhwam maa nsɛsodeɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Me na megyegyee Efraim taataa,","poem":1},{"text":"meturu no wɔ mʼabasa so;","poem":2},{"text":"nanso, wɔnkae sɛ","poem":1},{"text":"me na mesaa wɔn yadeɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mede ayamyɛ ahoma","poem":1},{"text":"ne ɔdɔ dii wɔn anim;","poem":2},{"text":"meyii kɔnnua no firii wɔn kɔn mu","poem":1},{"text":"na mekoto maa wɔn aduane diiɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wɔbɛsane akɔ Misraim,","poem":1},{"text":"na Asiria adi wɔn so,","poem":2},{"lineBreak":true},{"text":"ɛsiane sɛ wɔannu wɔn ho enti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akofena bɛdi ahim wɔ wɔn kuropɔn mu","poem":1},{"text":"na ɛbɛsɛe wɔn apono akyi adaban","poem":2},{"lineBreak":true},{"text":"na wɔn nhyehyɛeɛ to bɛtwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me nkurɔfoɔ asi no pi sɛ wɔbɛtwe wɔn ho afiri me nkyɛn.","poem":1},{"text":"Sɛ wosu frɛ Ɔsorosoroni no mpo a","poem":2},{"text":"ɔrempagya wɔn ɛkwan biara so.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ɛbɛyɛ dɛn na mɛyi wo ama, Efraim?","poem":1},{"lineBreak":true},{"text":"Ɛbɛyɛ dɛn ma mɛyi wo ama, Israel?","poem":1},{"text":"Ɛbɛyɛ dɛn na mɛyɛ wo sɛ Adma?","poem":2},{"text":"Ɛbɛyɛ dɛn na mɛyɛ wo sɛ Seboim?","poem":1},{"text":"Mʼakoma asesa wɔ me mu;","poem":2},{"lineBreak":true},{"text":"na mʼahummɔborɔ ahwanyane.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Merenyɛ mʼabufuhyeɛsoɔ adeɛ,","poem":1},{"text":"ɛna merennane me ho ɛnsɛe Efraim nso.","poem":2},{"text":"Meyɛ Onyankopɔn na mennyɛ onipa.","poem":1},{"text":"Meyɛ Ɔkronkronni a ɔwɔ mu mu.","poem":2},{"lineBreak":true},{"text":"Meremma wɔ abufuo mu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wɔbɛdi Awurade akyi.","poem":1},{"text":"Ɔbɛbobɔ mu te sɛ gyata.","poem":2},{"text":"Na sɛ ɔbobɔm a,","poem":1},{"text":"ne mma de ahopopoɔ bɛfiri atɔeɛ aba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔde ahopopoɔ bɛba","poem":1},{"text":"te sɛ nnomaa a wɔfiri Misraim","poem":2},{"text":"te sɛ mmorɔnoma a wɔfiri Asiria.","poem":1},{"text":"Mɛbɔ wɔn atenaseɛ wɔ wɔn afie mu,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"heading","content":["Israel Bɔne"]},{"type":"verse","number":12,"content":[{"text":"Efraim de atorɔ atwa me ho ahyia,","poem":1},{"text":"Israel efie nso wɔde nnaadaa.","poem":2},{"text":"Yuda abɔ Onyankopɔn so ko","poem":1},{"text":"mpo ɔde tia Ɔkronkronni nokwafoɔ no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}