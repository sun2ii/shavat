{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efraim de mframa ayɛ aduane;","poem":1},{"text":"ɔdi apueeɛ mframa akyi daa","poem":2},{"text":"na ɔdi atorɔ yɛ akakabensɛm bebree.","poem":1},{"text":"Ɔne Asiria yɛ apam","poem":2},{"lineBreak":true},{"text":"na ɔde ngo kɔ Misraim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade wɔ soboɔ de bɔ Yuda;","poem":1},{"text":"ɔbɛtwe Yakob aso, wɔ nʼakwan ho","poem":2},{"lineBreak":true},{"text":"na watua no ne nneyɛeɛ so ka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔyafunu mu na ɔsɔɔ ne nua nantin;","poem":1},{"text":"ɔnyiniiɛ no, ɔne Onyankopɔn pepree so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔne ɔbɔfoɔ tentameeɛ dii ne so nkonim;","poem":1},{"text":"ɔde nisuo srɛɛ ne nkyɛn adom.","poem":2},{"text":"Ɔhunuu no wɔ Bet-El","poem":1},{"text":"ne no kasaa wɔ hɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asafo Awurade Onyankopɔn,","poem":1},{"text":"Awurade ne ne din a ahyeta!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛsɛ sɛ wo sane kɔ wo Onyankopɔn nkyɛn.","poem":1},{"text":"Tena ɔdɔ ne tenenee mu,","poem":2},{"lineBreak":true},{"text":"na twɛn wo Onyankopɔn daa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔdwadini de nsisie nsania yɛ nʼadwuma;","poem":1},{"text":"nʼani gye nsisie ho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim hoahoa ne ho sɛ,","poem":1},{"text":"“Meyɛ ɔdefoɔ; manya me ho.","poem":2},{"text":"Mʼahonya nyinaa mu wɔrenhunu","poem":1},{"text":"amumuyɛ biara wɔ me ho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mene Awurade wo Onyankopɔn,","poem":1},{"text":"a meyii wo firii Misraim.","poem":2},{"text":"Mɛma woakɔtena ntomadan mu bio","poem":1},{"text":"sɛdeɛ na woyɛ wɔ wʼapontoɔ afahyɛ nna mu no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mekasa kyerɛɛ adiyifoɔ,","poem":1},{"text":"memaa wɔn anisoadehunu bebree","poem":2},{"lineBreak":true},{"text":"na mefaa wɔn so kaa mmɛbusɛm.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gilead yɛ otirimuɔdenfoɔ anaa?","poem":1},{"text":"Emu nnipa no yɛ ahuhufoɔ!","poem":2},{"text":"Wɔde anantwie bɔ afɔdeɛ wɔ Gilgal anaa?","poem":1},{"text":"Wɔn afɔrebukyia bɛyɛ te sɛ aboɔ","poem":2},{"lineBreak":true},{"text":"a wɔahɔre no sie wɔ asase a wɔafuntum soɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakob dwane kɔɔ Aramfoɔ asase so;","poem":1},{"text":"Israel someeɛ de nyaa yere,","poem":2},{"lineBreak":true},{"text":"ɔhwɛɛ nnwan de tua etiri nsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Awurade nam odiyifoɔ so","poem":1},{"text":"yii Israel firii Misraim,","poem":2},{"lineBreak":true},{"text":"ɔnam odiyifoɔ so hwɛɛ no.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nanso, Efraim ahyɛ no abufuo yaayaaya;","poem":1},{"text":"nʼAwurade bɛma ne mogyahwiegu ho afɔdie ada ne so","poem":2},{"text":"na ɔbɛtua nʼanimtiabuo no so ka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}