{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Ahonu De Nhyira Ba"]},{"type":"verse","number":1,"content":[{"text":"Ao Israel, sane wʼakyi kɔ Awurade wo Onyankopɔn nkyɛn.","poem":1},{"text":"Wʼahweaseɛ firi wo bɔne!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fa wo nsɛm a wowɔ","poem":1},{"text":"sane kɔ Awurade nkyɛn.","poem":2},{"text":"Ka kyerɛ no sɛ,","poem":1},{"text":"“Fa yɛn bɔne nyinaa kyɛ yɛn,","poem":2},{"text":"na fa ahummɔborɔ gye yɛn,","poem":1},{"text":"na yɛatumi ayi wo ayɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asiria rentumi nnye yɛn;","poem":1},{"text":"yɛrentena akofoɔ apɔnkɔ so.","poem":2},{"text":"Yɛrenka bio da sɛ, ‘Yɛn anyame’","poem":1},{"text":"nkyerɛ deɛ yɛn ara de yɛn nsa ayɛ,","poem":2},{"lineBreak":true},{"text":"na wo mu na nwisiaa nya ahummɔborɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mɛsa wɔn asobrakyeɛ yadeɛ.","poem":1},{"text":"Mɛfiri mʼakoma mu adɔ wɔn,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ mʼabufuo nni wɔn so bio.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɛyɛ sɛ obosuo ama Israel.","poem":1},{"text":"Ɔbɛfefɛ ayɛ frɔmm te sɛ sukooko.","poem":2},{"text":"Te sɛ Lebanon ntweneduro no","poem":1},{"text":"ɔde ne nhini bɛtim fam;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ne mman bɛdennan.","poem":2},{"text":"Nʼahoɔfɛ bɛyɛ sɛ ngo dua,","poem":1},{"text":"na ne hwa ayɛ sɛ Lebanon ntweneduro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nnipa bɛtena ne nwunu ase bio.","poem":1},{"text":"Ɔbɛnyini ayɛ frɔmm te sɛ aburoo.","poem":2},{"text":"Ɔbɛfefɛ ayɛ frɔmm te sɛ bobe,","poem":1},{"text":"na ne din a ahyeta bɛyɛ sɛ nsã a ɛfiri Lebanon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ao, Efraim ɛdeɛn na me ne ahoni wɔ yɛ bio?","poem":1},{"text":"Mɛgye no so na mʼani aku ne ho.","poem":2},{"text":"Mete sɛ dua a nʼahahan mpo;","poem":1},{"text":"sɛ wobɛso aba a, ɛgyina me so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hwan ne onyansafoɔ? Ɔbɛhunu yeinom mu.","poem":1},{"text":"Hwan na ɔwɔ nhunumu? Ɔbɛte yeinom ase.","poem":2},{"text":"Awurade akwan tene.","poem":1},{"text":"Ateneneefoɔ nante so,","poem":2},{"lineBreak":true},{"text":"nanso asoɔdenfoɔ sunti so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}