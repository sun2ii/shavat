{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Wɔbɔ Israel Kwaadu"]},{"type":"verse","number":1,"content":[{"text":"Montie Awurade asɛm, mo Israelfoɔ","poem":1},{"text":"ɛfiri sɛ Awurade wɔ kwaadu de bɔ","poem":2},{"lineBreak":true},{"text":"mo a mote asase no so:","poem":2},{"text":"“Nokorɛ, ɔdɔ, anaa Onyankopɔn ho nimdeɛ nni asase no so.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nnome nko ara, atorɔtwa ne awudie,","poem":1},{"text":"korɔnobɔ, ne awaresɛeɛ","poem":2},{"text":"na moyɛ ma ɛtra so,","poem":1},{"text":"na mogyahwiegu ba ntoasoɔ ntoasoɔ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yei enti asase no di awerɛhoɔ","poem":1},{"text":"na wɔn a ɛte so nyinaa wuwu;","poem":2},{"text":"ewiram mmoa, ewiem nnomaa","poem":1},{"text":"ne ɛpo mu nam rewuwu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mma obiara mmɔ kwaadu,","poem":1},{"text":"mma obiara mmɔ ɔfoforɔ soboɔ.","poem":2},{"text":"Na mmom, mo asɔfoɔ","poem":1},{"text":"mo na me ne mo anya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mosunti awia ne anadwo,","poem":1},{"text":"na adiyifoɔ no ne mo sunti.","poem":2},{"text":"Ɛno enti mɛsɛe mo ɔman.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Nimdeɛ a me nkurɔfoɔ nni enti wɔresɛe.","poem":2},{"lineBreak":true},{"text":"“Sɛ moapo nimdeɛ enti,","poem":1},{"text":"me nso mapo mo sɛ mʼasɔfoɔ;","poem":2},{"text":"sɛ moabu moani agu mo Onyankopɔn mmara so enti,","poem":1},{"text":"me nso mabu mʼani agu mo mma so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asɔfoɔ no redɔɔso no","poem":1},{"text":"na bɔne a ɛboro soɔ na wɔyɛ tia me.","poem":2},{"lineBreak":true},{"text":"Wɔde wɔn Animuonyam asesa deɛ ɛyɛ animguaseɛ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔdidi me nkurɔfoɔ bɔne ho","poem":1},{"text":"ɛno enti wɔn ani gye atirimuɔdensɛm ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛdeɛ nnipa no teɛ no, saa ara na asɔfoɔ no nso teɛ.","poem":1},{"text":"Metwe wɔn mmienu aso wɔ wɔn akwan ho","poem":2},{"lineBreak":true},{"text":"na matua wɔn wɔn nneyɛeɛ so ka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Wɔbɛdidi, nanso wɔremmee.","poem":1},{"text":"Wɔbɛbɔ adwaman, nanso wɔrennɔre,","poem":2},{"text":"ɛfiri sɛ, wɔagya Awurade hɔ,","poem":1},{"text":"de wɔn ho ama","poem":2}]},{"type":"verse","number":11,"content":[{"text":"adwamammɔ,","poem":2},{"lineBreak":true},{"text":"nsã dada ne foforɔ,","poem":2},{"lineBreak":true},{"text":"a ɛma me nkurɔfoɔ","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nteaseɛ tu yera.","poem":1},{"lineBreak":true},{"text":"Wɔkɔ abisa wɔ ahoni a wɔde nnua asene nkyɛn","poem":1},{"text":"na duasin bi ama wɔn mmuaeɛ.","poem":2},{"text":"Adwamammɔ honhom rema wɔn ayera ɛkwan;","poem":1},{"text":"wɔnni wɔn Onyankopɔn nokorɛ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔbɔ afɔdeɛ wɔ mmepɔ atifi","poem":1},{"text":"na wɔhye afɔrebɔdeɛ wɔ nkokoɔ so:","poem":2},{"text":"odum, duafufuo ne odupɔn ase,","poem":1},{"text":"deɛ onwunu yɛ fɔmm hɔ.","poem":2},{"text":"Ɛno enti, wo mmammaa dane adwamammɔfoɔ","poem":1},{"text":"na mo nsenom mmaa nso yɛ awaresɛefoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Merentwe mo mmammaa aso","poem":1},{"text":"sɛ wɔadane adwamanfoɔ,","poem":2},{"text":"anaa mo nsenom mmaa aso","poem":1},{"text":"sɛ wɔasɛe awadeɛ.","poem":2},{"text":"Ɛfiri sɛ, mo mmarima, mo nso mote saa ara.","poem":1},{"text":"Mo ne baasifoɔ ne abosomfieso adwamanfoɔ","poem":2},{"lineBreak":true},{"text":"di hwebom.","poem":2},{"text":"Nnipa a wɔnni nteaseɛ bɛkɔ ɔsɛeɛ mu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ɛwom sɛ woyɛ ɔwaresɛefoɔ deɛ, Ao Israel,","poem":1},{"text":"nanso, mma Yuda nni ho fɔ.","poem":2},{"lineBreak":true},{"text":"“Nkɔ Gilgal;","poem":1},{"text":"na ɛmforo nkɔ Bet Awen.","poem":2},{"text":"Na nnka ntam sɛ, ‘Sɛ Awurade te ase yi!’","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Israelfoɔ yɛ asoɔdenfoɔ","poem":1},{"text":"te sɛ, nantwie ba a ɔyɛ asowuiɛ","poem":2},{"text":"ɛbɛyɛ dɛn na Awurade ahwɛ wɔn so","poem":1},{"text":"sɛ nnwammaa a wɔwɔ adidibea?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efraim de ne ho abɔ ahoni;","poem":1},{"text":"Gyaa no!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sɛ wɔn nsã sa koraa a,","poem":1},{"text":"wɔtoa wɔn adwamammɔ so;","poem":2},{"text":"wɔn sodifoɔ ani gye aniwudeɛ ho yie.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ntwaho mframa bɛpra wɔn akɔ,","poem":1},{"text":"na wɔn afɔrebɔ de animguaseɛ bɛbrɛ wɔn.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}