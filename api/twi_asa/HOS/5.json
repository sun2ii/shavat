{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Atemmuo A Ɛtia Israel"]},{"type":"verse","number":1,"content":[{"text":"“Montie mo asɔfoɔ!","poem":1},{"text":"Monhyɛ yei nso, mo Israelfoɔ!","poem":2},{"text":"Monyɛ aso, Ao adehyefie!","poem":1},{"lineBreak":true},{"text":"Saa atemmuo yi tia mo:","poem":1},{"text":"Moayɛ afidie wɔ Mispa,","poem":2},{"lineBreak":true},{"text":"ne asau a wɔagu no Tabor so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Atuatefoɔ adɔ mogyahwiegu mu asukɔ.","poem":1},{"text":"Mɛtwe wɔn nyinaa aso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Menim Efraim ho nsɛm nyinaa;","poem":1},{"text":"wɔmfaa Israel nhintaa me.","poem":2},{"text":"Efraim, seesei deɛ wobɔ adwaman;","poem":1},{"text":"na Israel aprɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Wɔn nneyɛeɛ mma wɔn ɛkwan","poem":1},{"text":"mma wɔnkɔ Onyankopɔn nkyɛn.","poem":2},{"text":"Adwamammɔ honhom wɔ wɔn akoma mu;","poem":1},{"text":"wɔnnye Awurade nto mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Israel ahantan di tia no.","poem":1},{"text":"Israelfoɔ, mpo Efraim suntisunti wɔ wɔn amumuyɛ mu;","poem":2},{"lineBreak":true},{"text":"Yuda nso ne wɔn sunti saa ara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sɛ wɔne wɔn nnwan ne wɔn anantwie","poem":1},{"text":"kɔhwehwɛ Awurade a","poem":2},{"text":"Wɔrenhunu no,","poem":1},{"text":"ɛfiri sɛ, watwe ne ho afiri wɔn ho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔanni Awurade nokorɛ.","poem":1},{"text":"Wɔwowoo adwamam mma.","poem":2},{"text":"Afei wɔn Bosome Foforɔ Afahyɛ","poem":1},{"text":"bɛsɛe wɔn ne wɔn nsase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Hyɛn totorobɛnto no wɔ Gibea.","poem":1},{"text":"Hyɛn abɛn no wɔ Rama.","poem":2},{"text":"Momma ɔko nteam so wɔ Bet Awen;","poem":1},{"text":"Ao, Benyamin akofoɔ, monsɔre nni anim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔbɛsɛe Efraim","poem":1},{"text":"wɔ akontabuo da.","poem":2},{"text":"Israel mmusuakuo no mu no","poem":1},{"text":"mepae mu ka deɛ ɛwom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yuda sodifoɔ no te sɛ","poem":1},{"text":"wɔn a wɔyiyi ahyeɛso aboɔ.","poem":2},{"text":"Mɛhwie mʼabufuo agu wɔn so","poem":1},{"text":"te sɛ nsuyire.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔhyɛ Efraim so,","poem":1},{"text":"wɔtiatia ne so wɔ atemmuo mu,","poem":2},{"lineBreak":true},{"text":"wasi nʼadwene pi sɛ ɔbɛdi ahoni akyi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɛyɛ sɛ nweweboa ama Efraim","poem":1},{"text":"na mayɛ Yudafoɔ sɛ dua a aporɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ɛberɛ a Efraim hunuu ne yadeɛ,","poem":1},{"text":"na Yuda nso hunuu nʼakuro no,","poem":2},{"text":"Efraim de nʼani kyerɛɛ Asiria.","poem":1},{"text":"Ɔsoma kɔɔ ɔhene kɛseɛ no hɔ kɔpɛɛ mmoa.","poem":2},{"text":"Nanso wantumi ansa no yadeɛ,","poem":1},{"text":"na akuro no nso anwuwu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti mɛyɛ sɛ gyata ama Efraim","poem":1},{"text":"na mayɛ sɛ gyata hoɔdenfoɔ ama Yuda.","poem":2},{"text":"Mɛtete wɔn mu nkete nkete, na makɔ;","poem":1},{"text":"Mɛsoa wɔn akɔ, na obiara rentumi nnye wɔn.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Afei, mɛsane akɔ me nkyi","poem":1},{"text":"kɔsi sɛ wobɛnya ahonu.","poem":2},{"text":"Na wɔbɛhwehwɛ mʼakyiri ɛkwan;","poem":1},{"text":"wɔn awerɛhoɔ mu, wɔbɛhwehwɛ me anibereɛ so.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}