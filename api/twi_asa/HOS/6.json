{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israel Nni Ahonu"]},{"type":"verse","number":1,"content":[{"text":"“Mommra, momma yɛnsane nkɔ Awurade nkyɛn.","poem":1},{"text":"Wɔatete yɛn mu asinasini","poem":2},{"text":"nanso ɔbɛsa yɛn yadeɛ.","poem":1},{"text":"Wapirapira yɛn","poem":2},{"lineBreak":true},{"text":"nanso ɔbɛkyekyere yɛn apirakuro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnanu akyiri, ɔbɛma yɛanya ahoɔden;","poem":1},{"text":"nansa so, ɔde yɛn bɛsi yɛn siberɛ","poem":2},{"lineBreak":true},{"text":"na yɛanya nkwa wɔ nʼanim.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Momma yɛnnye Awurade nto mu;","poem":1},{"text":"momma yɛn nkɔ so nnye no nto mu.","poem":2},{"text":"Sɛdeɛ awia pue da biara no, ɔbɛpue;","poem":1},{"text":"ɔbɛba yɛn nkyɛn te sɛ osuo a ɛtɔ awɔberɛ mu","poem":2},{"lineBreak":true},{"text":"anaa osutɔberɛ mu nsuo a ɛfɔ asase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ɛdeɛn na mɛtumi de wo ayɛ, Efraim?","poem":1},{"text":"Ɛdeɛn na mɛtumi de wo ayɛ, Yuda?","poem":2},{"text":"Mo dɔ te sɛ anɔpa bɔ,","poem":1},{"text":"ɛte sɛ anɔpa bosuo a ɛtu yera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mede mʼadiyifoɔ twitwaa mo mu asinasini,","poem":1},{"text":"mede mʼanum nsɛm kunkumm mo;","poem":2},{"text":"mʼatemmuo baa mo so sɛ anyinam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mepɛ ahummɔborɔ na ɛnyɛ afɔrebɔ,","poem":1},{"text":"mepɛ Onyankopɔn ho nimdeɛ sene ɔhyeɛ afɔdeɛ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔabu apam no so sɛdeɛ Adam yɛeɛ.","poem":1},{"text":"Wɔanni me nokorɛ wɔ hɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead yɛ atirimuɔdenfoɔ kuropɔn","poem":1},{"text":"a mogya anammɔn akeka hɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛdeɛ akwanmukafoɔ ka ɛkwan mu no","poem":1},{"text":"saa ara na asɔfo kuo no nso yɛ;","poem":2},{"text":"wɔdi awu wɔ Sekem kwantempɔn so","poem":1},{"text":"yɛ nnebɔne a ɛyɛ animguaseɛ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mahunu ahodwiredeɛ wɔ Israel fie.","poem":1},{"text":"Ɛhɔ, Efraim kɔ adwamammɔ mu","poem":2},{"lineBreak":true},{"text":"Israel gu ne ho fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Na wo Yuda nso,","poem":1},{"text":"wɔahyɛ otwa berɛ ama wo.","poem":2},{"lineBreak":true},{"text":"“Ɛberɛ biara a mede me nkurɔfoɔ ahonya asane ama wɔn,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}