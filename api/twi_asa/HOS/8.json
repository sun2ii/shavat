{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israel Bɛtwa Ntwahoframa Aba"]},{"type":"verse","number":1,"content":[{"text":"“Monhyɛn totorobɛnto!","poem":1},{"text":"Ɔkɔdeɛ bi wɔ Awurade fiefoɔ so","poem":2},{"text":"ɛfiri sɛ nnipa no abu mʼapam so","poem":1},{"text":"na wɔasɔre atia me mmara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Afei, Israel su frɛ me sɛ,","poem":1},{"text":"‘Ao, yɛn Onyankopɔn, yɛgye wo to mu!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanso, Israel apo deɛ ɛyɛ;","poem":1},{"text":"ɔtamfoɔ bɛtaa no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔsisi ahemfo a mennim ho hwee","poem":1},{"text":"wɔpa ahenemma wɔ ɛberɛ a mempenee so.","poem":2},{"text":"Wɔde wɔn dwetɛ ne wɔn sikakɔkɔɔ yɛ ahoni ma wɔn ho","poem":1},{"text":"de sɛeɛ wɔn ankasa ho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"To wo nantwie ba ohoni no twene, Ao, Samaria!","poem":1},{"text":"Mʼabufuhyeɛ reba wɔn so.","poem":2},{"text":"Wɔbɛtena deɛ ɛho nteɛ mu, akɔsi da bɛn?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Wɔfiri Israel!","poem":2},{"text":"Saa nantwie ba yi, odwumfoɔ bi na ɔseneeɛ;","poem":1},{"text":"ɛnyɛ Onyankopɔn!","poem":2},{"text":"Wɔbɛbubu mu asinasini,","poem":1},{"text":"saa Samaria nantwie ba no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wɔdua mframa","poem":1},{"text":"na wɔtwa ntwahoframa.","poem":2},{"text":"Awuo a ɛgyina hɔ no nni tire;","poem":1},{"text":"enti wɔrennya esam mfiri mu.","poem":2},{"text":"Sɛ ɛso aduane mpo a,","poem":1},{"text":"ahɔhoɔ na wɔbɛdi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔamene Israel;","poem":1},{"text":"afei ɔfra aman no mu","poem":2},{"text":"te sɛ adeɛ a ɛho nni mfasoɔ biara.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na wɔakɔ Asiria","poem":1},{"text":"te sɛ wiram afunumu a ɔno nko ara nenam.","poem":2},{"lineBreak":true},{"text":"Efraim nso atɔn ne ho ama adɔfoɔ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɛwom, wɔatɔn wɔn ho wɔ amanaman no mu deɛ,","poem":1},{"text":"nanso mɛboaboa wɔn ano.","poem":2},{"text":"Wɔn so bɛfiri aseɛ ate","poem":1},{"text":"wɔ ɔhene kɛseɛ bi nhyɛsoɔ ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ɛwom sɛ Efraim sisii afɔrebukyia bebree a wɔbɔ bɔne fakyɛ afɔdeɛ wɔ so deɛ,","poem":1},{"text":"ɛno enti abɛyɛ afɔrebukyia a wɔyɛ bɔne wɔ so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Metwerɛɛ me mmara a ɛfa nneɛma bebree ho maa wɔn,","poem":1},{"text":"nanso wɔfaa no sɛ ananafoɔ adeɛ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔde mʼayɛyɛdeɛ bɔ afɔdeɛ","poem":1},{"text":"na wɔwe ɛnam no,","poem":2},{"text":"nanso wɔnsɔ Awurade ani.","poem":1},{"text":"Afei, ɔbɛkae wɔn atirimuɔdensɛm","poem":2},{"text":"na watwe wɔn aso wɔ wɔn bɔne ho:","poem":1},{"text":"Wɔbɛsane akɔ Misraim.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israel werɛ afiri ne yɛfoɔ","poem":1},{"text":"na wasisi ahemfie akɛseakɛseɛ;","poem":2},{"text":"Yuda abɔ nkuro bebree ho ban.","poem":1},{"text":"Nanso, mɛto ne nkuropɔn mu ogya","poem":2},{"lineBreak":true},{"text":"a ɛbɛhye wɔn aban.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}