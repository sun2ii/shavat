{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"HOS","translationId":"twi_asa","name":"Hosea","commonName":"Hosea","title":"Odiyifoɔ Hosea Nwoma","order":28,"numberOfChapters":14,"sha256":"aaea12e10f1dfc2f3218c339eac5fbf785687b4bead624e1e6b74ab47d67d5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/twi_asa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Israel Asotwe"]},{"type":"verse","number":1,"content":[{"text":"Nni ahurisie, Ao Israel;","poem":1},{"text":"nsɛpɛ wo ho te sɛ aman a aka no.","poem":2},{"text":"Ɛfiri sɛ woanni wo Onyankopɔn nokorɛ,","poem":1},{"text":"wʼani gye adwamammɔ ho","poem":2},{"lineBreak":true},{"text":"wɔ ayuporobea nyinaa so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayuporobea ne nsakyimena rentumi mma nnipa no aduane;","poem":1},{"text":"nsã foforɔ nso bɛbɔ wɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔrentena Awurade asase no so bio;","poem":1},{"text":"Efraim bɛsane akɔ Misraim","poem":2},{"lineBreak":true},{"text":"na wadi aduane a ɛho nteɛ wɔ Asiria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔremmɔ ahwiesa afɔdeɛ mma Awurade,","poem":1},{"text":"na wɔn afɔrebɔ nso nsɔ nʼani.","poem":2},{"text":"Saa afɔrebɔ yi bɛyɛ sɛ aduane a ayiasefoɔ de wɔn nsa aka;","poem":1},{"text":"wɔn a wɔdi nyinaa ho bɛgu fi.","poem":2},{"text":"Saa aduane no bɛyɛ wɔn ankasa dea","poem":1},{"text":"na wɔrentumi mmfa nkɔ Awurade asɔredan mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɛdeɛn na mobɛyɛ wɔ mo apontoɔ da no","poem":1},{"text":"ne Awurade afahyɛ nna no nso?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mpo sɛ wɔdwane firi ɔsɛeɛ mu a","poem":1},{"text":"Misraim bɛboaboa wɔn ano,","poem":2},{"lineBreak":true},{"text":"na Memfis bɛsie wɔn.","poem":2},{"text":"Wɔn dwetɛ ahonyadeɛ bɛfu wira,","poem":1},{"text":"na wɔn ntomadan adane nkasɛɛ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asotwe nna no reba,","poem":1},{"text":"akontabuo nna no aduru;","poem":2},{"text":"ma Israel nhunu yei.","poem":1},{"text":"Esiane mo bɔne bebrebe","poem":2},{"text":"ne mo akokoakoko a adɔɔso enti","poem":1},{"text":"mofa no sɛ odiyifoɔ yɛ kwasea","poem":2},{"lineBreak":true},{"text":"na deɛ honhom akanyane noɔ no yɛ ɔbɔdamfoɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Odiyifoɔ no ne me Onyankopɔn","poem":1},{"text":"yɛ Efraim so wɛmfoɔ,","poem":2},{"text":"nanso wɔasum no afidie wɔ nʼakwan nyinaa so,","poem":1},{"text":"na ɔtane ahyɛ ne Onyankopɔn fie ma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wɔaduru porɔeɛ bunu mu,","poem":1},{"text":"sɛdeɛ na ɛteɛ wɔ Gibea nna no mu.","poem":2},{"text":"Onyankopɔn bɛkae wɔn atirimuɔden","poem":1},{"text":"na watwe wɔn aso wɔ wɔn bɔne ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ɛberɛ a mehunuu Israel no,","poem":1},{"text":"na ɛte sɛ deɛ mahunu bobe wɔ anweatam so;","poem":2},{"text":"ɛberɛ a mehunuu mo agyanom no,","poem":1},{"text":"na ɛte sɛ deɛ mahunu borɔdɔma aba a ɛdi ɛkan wɔ ne dua so.","poem":2},{"text":"Nanso ɛberɛ a wɔbaa Baal-peor nkyɛn no","poem":1},{"text":"wɔdwiraa wɔn ho maa ohoni nimguaseni no.","poem":2},{"lineBreak":true},{"text":"Wɔn ho yɛɛ abofono te sɛ ohoni a wɔdɔ no no.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim animuonyam bɛtu akɔ sɛ anomaa,","poem":1},{"text":"nyinsɛn ne awoɔ nni ne mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mpo sɛ wɔtete mmɔfra a,","poem":1},{"text":"mɛma mmɔfra no awuwu wɔ wɔn nsa mu.","poem":2},{"text":"Wɔnnue,","poem":1},{"text":"sɛ meyi mʼani firi wɔn so a!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mahunu Efraim te sɛ Tiro,","poem":1},{"text":"a ɛda baabi a ɛyɛ.","poem":2},{"text":"Nanso Efraim de ne mma","poem":1},{"text":"bɛbrɛ okumfoɔ no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Fa ma wɔn, Ao, Awurade,","poem":1},{"text":"ɛdeɛn na wode bɛma wɔn?","poem":2},{"text":"Ma wɔn yafunu a ɛpɔn","poem":1},{"text":"ne nufoɔ a nufosuo nni muo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Wɔn atirimuɔdensɛm nyinaa a wɔdii wɔ Gilgal enti,","poem":1},{"text":"mefaa wɔn ho tan wɔ hɔ.","poem":2},{"text":"Wɔn nnebɔne enti","poem":1},{"text":"mɛpam wɔn afiri me fie.","poem":2},{"text":"Merennɔ wɔn bio;","poem":1},{"text":"ɛfiri sɛ wɔn ntuanofoɔ nyinaa yɛ atuatefoɔ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efraim agyigya,","poem":1},{"text":"ne nhini akusa,","poem":2},{"text":"enti wɔnso aba.","poem":1},{"text":"Sɛ wɔwo mma mpo a,","poem":2},{"lineBreak":true},{"text":"mɛkunkum wɔn mma a wɔdɔ wɔn no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Me Onyankopɔn bɛpo wɔn,","poem":1},{"text":"ɛfiri sɛ, wɔannyɛ ɔsetie amma no;","poem":2},{"lineBreak":true},{"text":"Wɔbɛkyinkyini aman no mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}