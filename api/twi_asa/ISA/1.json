{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Saa anisoadehunu a ɛfa Yuda ne Yerusalem ho no baa Amos babarima Yesaia so wɔ Yuda ahemfo Usia, Yotam, Ahas ne Hesekia berɛ so."]},{"type":"line_break"},{"type":"heading","content":["Atuateman"]},{"type":"verse","number":2,"content":[{"text":"Ao, ɔsoro, montie! Ao, asase yɛ aso!","poem":1},{"text":"Na Awurade akasa:","poem":2},{"text":"“Matete mma ama wɔanyini,","poem":1},{"text":"nanso wɔate me so atua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nantwie nim ne wura,","poem":1},{"text":"afunumu nso nim ne wura mmoa adididaka,","poem":2},{"text":"nanso Israel nnim,","poem":1},{"text":"me nkurɔfoɔ nte aseɛ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aa, amumuyɛ ɔman,","poem":1},{"text":"ɔman a afɔdie adesoa ahyɛ wɔn ma,","poem":2},{"text":"nnebɔneyɛfoɔ kuo,","poem":1},{"text":"mma a porɔeɛ ahyɛ wɔn ma!","poem":2},{"text":"Wɔatwe wɔn ho afiri Awurade ho;","poem":1},{"text":"Wɔapo Israel Kronkronni no,","poem":2},{"lineBreak":true},{"text":"wɔadane wɔn akyi akyerɛ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Adɛn enti na mopɛ sɛ wɔkɔ so boro mo?","poem":1},{"text":"Adɛn enti na moda so te atua?","poem":2},{"text":"Wɔapira mo tiri,","poem":1},{"text":"na mo akoma nso di yea.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛfiri mo nan ase kɔsi mo tiri so","poem":1},{"text":"ahomeka biara nni mu,","poem":2},{"text":"apirakuro ne nsoasoaeɛ nko ara","poem":1},{"text":"akuro a anim deda hɔ","poem":2},{"text":"na wɔnhohoro so anaa Wɔnkyekyereeɛ","poem":1},{"text":"anaa wɔmfaa ngo nsrasraa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mo ɔman ada mpan,","poem":1},{"text":"wɔde ogya ahyehye mo nkuropɔn;","poem":2},{"text":"ananafoɔ regye mo mfuo","poem":1},{"text":"a mo ani tua,","poem":2},{"lineBreak":true},{"text":"na asɛe sɛdeɛ ɛyɛɛ ɛberɛ a ahɔhoɔ tuu mo guiɛ no.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔagya Ɔbabaa Sion","poem":1},{"text":"te sɛ bobe turo mu sese","poem":2},{"text":"te sɛ akuraa a ɛsi ɛferɛ afuo mu,","poem":1},{"text":"te sɛ kuropɔn a atamfoɔ atwa ho ahyia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛ Awurade","poem":1},{"text":"tumfoɔ no annya yɛn asefoɔ a,","poem":2},{"text":"anka yɛayɛ sɛ Sodom,","poem":1},{"text":"na yɛadane ayɛ sɛ Gomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Montie Awurade asɛm,","poem":1},{"text":"mo Sodom sodifoɔ;","poem":2},{"text":"montie yɛn Onyankopɔn mmara,","poem":1},{"text":"mo Gomorafoɔ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Mo afɔrebɔ ahodoɔ bebree no,","poem":1},{"text":"ɛdeɛn na ɛyɛ ma me?”","poem":2},{"lineBreak":true},{"text":"Sɛdeɛ Awurade seɛ nie.","poem":2},{"text":"“Mewɔ ɔhyeɛ afɔrebɔdeɛ ma ɛboro so,","poem":1},{"text":"deɛ ɛyɛ nnwennini ne mmoa a wɔadɔre sradeɛ;","poem":2},{"text":"mʼani nnye","poem":1},{"text":"anantwinini, nnwammaa ne mpapo mogya ho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ moba mʼanim a","poem":1},{"text":"hwan na ɔbisa yei firi mo hɔ?","poem":2},{"lineBreak":true},{"text":"Hwan na ɔsomaa mo sɛ monnantenante me efie yi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Monnyae afɔrebɔdeɛ a mode ba a ɛmfra no!","poem":1},{"text":"Mo aduhwam yɛ me tan.","poem":2},{"text":"Ɔbosome foforɔ, home nna ne nhyiamu ahodoɔ ne","poem":1},{"text":"mo nhyiamu fi no afono me.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mo bosome foforɔ afahyɛ ne mo apontoɔ a moahyehyɛ no,","poem":1},{"text":"me kra kyiri.","poem":2},{"text":"Ayɛ adesoa ama me;","poem":1},{"text":"masoa mabrɛ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sɛ mopagya mo nsa bɔ mpaeɛ a,","poem":1},{"text":"mɛyi mʼani ato nkyɛn.","poem":2},{"text":"Sɛ mobɔ mpaeɛ bebree mpo a","poem":1},{"text":"merentie.","poem":2},{"lineBreak":true},{"text":"“Mogya bebree agu mo nsa ho fi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Monnwira mo ho na mo ho nte.","poem":1},{"text":"Monnyi mo nnebɔne mfiri mʼani so!","poem":2},{"lineBreak":true},{"text":"Monnyae bɔne yɛ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Monyɛ papa; monhwehwɛ atɛntenenee","poem":1},{"text":"Monhyɛ wɔn a wɔhyɛ wɔn so nkuran.","poem":2},{"text":"Monni mma nwisiaa,","poem":1},{"text":"monka akunafoɔ nsɛm mma wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Afei mommra na yɛnnwene mmɔ mu,”","poem":1},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2},{"text":"“Sɛ mo bɔne te sɛ kɔben a,","poem":1},{"text":"ɛbɛyɛ fitaa sɛ sukyerɛmma;","poem":2},{"text":"mpo sɛ ɛyɛ kɔkɔɔ te sɛ mogya a","poem":1},{"text":"ɛbɛyɛ fitaa sɛ asaawa foturo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sɛ mopene so na moyɛ ɔsetie a,","poem":1},{"text":"mobɛdi asase no so nnepa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na sɛ moampene na mote atua a,","poem":1},{"text":"akofena bɛdi mo nam.”","poem":2},{"lineBreak":true},{"text":"Awurade na wakasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hwɛ sɛdeɛ kuropɔn nokwafoɔ no","poem":1},{"text":"adane odwamanfoɔ.","poem":2},{"text":"Ɛberɛ bi na atɛntenenee ahyɛ no ma","poem":1},{"text":"na anka tenenee te ne mu,","poem":2},{"lineBreak":true},{"text":"nanso seesei awudifoɔ ahyɛ mu ma!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wo dwetɛ adane adeɛ a ɛho nni mfasoɔ,","poem":1},{"text":"wɔde nsuo afra wo nsã papa mu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wo sodifoɔ yɛ atuatefoɔ,","poem":1},{"text":"akorɔmfoɔ yɔnkonom;","poem":2},{"text":"wɔn nyinaa pɛ adanmudeɛ,","poem":1},{"text":"na wɔpere akyɛdeɛ ho.","poem":2},{"text":"Wɔnni mma nwisiaa;","poem":1},{"text":"na akunafoɔ nsɛm nkɔ wɔn anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Enti, Awurade, Otumfoɔ Awurade,","poem":1},{"text":"deɛ ɔyɛ Kɛseɛ ma Israel no ka sɛ,","poem":2},{"text":"“Aa, mɛnya ahomegyeɛ afiri mʼatamfoɔ hɔ","poem":1},{"text":"na matɔ wɔn so were.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mɛma me nsa so, atia mo;","poem":1},{"text":"mɛhohoro wo ho fi korakora","poem":2},{"lineBreak":true},{"text":"na mayi mo ho nkekaawa nyinaa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mɛma mo atemmufoɔ bio sɛ kane no,","poem":1},{"text":"ne mo afutufoɔ sɛdeɛ na ɛteɛ, ahyɛaseɛ no.","poem":2},{"text":"Yei akyi no, wɔbɛfrɛ wo","poem":1},{"text":"Kuropɔn Tenenee","poem":2},{"lineBreak":true},{"text":"Kuropɔn Nokwafoɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Wɔde atɛntenenee bɛgye Sion bio,","poem":1},{"text":"na wɔn a wɔnu wɔn ho no, wɔde tenenee bɛgye wɔn.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nanso atuatefoɔ ne nnebɔneyɛfoɔ deɛ, wɔbɛdwɛre wɔn abɔ mu,","poem":1},{"text":"na wɔn a wɔpa Awurade akyi bɛyera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mo ani bɛwu ɛsiane odum anyame a","poem":1},{"text":"monyaa wɔn mu anigyeɛ no;","poem":2},{"text":"wɔbɛgu mo anim ase ɛsiane nturo","poem":1},{"text":"a mosom abosom wɔ mu no enti.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mobɛyɛ sɛ odum a ne nhahan apo,","poem":1},{"text":"ne turo a ɛnnya nsuo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ɔhoɔdenfoɔ bɛyɛ sɛ adeɛ a ɛhye ntɛm;","poem":1},{"text":"nʼadwuma bɛyɛ sɛ ogya nturueɛ;","poem":2},{"text":"ne mmienu no bɛhye abɔ mu,","poem":1},{"text":"a obiara rentumi nnum.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}