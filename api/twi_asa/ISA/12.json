{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Ayɛyie Nnwom"]},{"type":"verse","number":1,"content":["Saa ɛda no, wobɛka sɛ:",{"text":"“Mɛkamfo wo Ao Awurade!","poem":1},{"lineBreak":true},{"text":"Ɛwom sɛ wo bo fuu me deɛ,","poem":1},{"lineBreak":true},{"text":"nanso afei wʼabofuo ano adwo.","poem":1},{"text":"Na woakyekyere me werɛ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nokorɛ, Onyankopɔn ne mʼagyenkwa;","poem":1},{"text":"mede me ho bɛto ne so, na merensuro.","poem":2},{"text":"Awurade, Awurade ne mʼahoɔden ne me dwom;","poem":1},{"text":"na wabɛyɛ me nkwagyeɛ.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wode anigyeɛ bɛsa nsuo","poem":1},{"text":"afiri nkwagyeɛ nsubura mu.","poem":2}]},{"type":"verse","number":4,"content":["Saa ɛda no wobɛka sɛ,",{"text":"“Ɛda Awurade ase, bɔ ne din","poem":1},{"text":"Ma amanaman nhunu deɛ wayɛ,","poem":2},{"text":"na pae mu ka sɛ wɔama ne din so.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To dwom ma Awurade, ɛfiri sɛ, wayɛ deɛ ɛwɔ animuonyam bebree.","poem":1},{"lineBreak":true},{"text":"Da yei adi kyerɛ ewiase nyinaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Momma mo nne so nto dwom anigyeɛ so,","poem":1},{"text":"mo a mowɔ Sion,","poem":2},{"text":"ɛfiri sɛ, Israel Kronkronni a ɔte mo mu no yɛ kokuroko.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}