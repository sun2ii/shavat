{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Nkɔmhyɛ A Ɛtia Moab"]},{"type":"verse","number":1,"content":["Adehunu a ɛfa Moab ho:",{"text":"Wɔasɛe Ar a ɛwɔ Moab","poem":1},{"text":"anadwo koro pɛ!","poem":2},{"text":"Wɔasɛe Kir a ɛwɔ Moab","poem":1},{"text":"anadwo koro pɛ!","poem":2},{"noteId":2}]},{"type":"verse","number":2,"content":[{"text":"Dibon foro kɔ nʼasɔredan mu,","poem":1},{"text":"ɔkɔ ne sorɔnsorɔmmea kɔ su;","poem":2},{"lineBreak":true},{"text":"Moab twa adwo wɔ Nebo ne Medeba ho.","poem":2},{"text":"Wɔayi eti biara so nwi","poem":1},{"text":"na abɔgyesɛ biara nso wɔatwitwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔfirafira ayitoma wɔ mmɔntene so;","poem":1},{"text":"wɔ adan atifi ne ɔman ahyiaeɛ","poem":2},{"text":"wɔn nyinaa retwa adwo,","poem":1},{"text":"wɔdeda fam na wɔsu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hesbon ne Eleale teaam su,","poem":1},{"text":"wɔte wɔn nne kɔduru Yahas nohoa.","poem":2},{"text":"Enti Moab mmarimma akofoɔ teaam su,","poem":1},{"text":"na wɔabotoboto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Medi Moab ho awerɛhoɔ wɔ mʼakoma mu;","poem":1},{"text":"nʼadwanefoɔ dwane kɔduru Soar,","poem":2},{"lineBreak":true},{"text":"ne Eglat Selisiya.","poem":2},{"text":"Wɔforo kɔ Luhit,","poem":1},{"text":"wɔrekɔ nyinaa na wɔresu;","poem":2},{"text":"Horonaim ɛkwan so nso","poem":1},{"text":"wɔdi wɔn sɛeɛ ho awerɛhoɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimrim nsuwansuwa awewe","poem":1},{"text":"na ɛserɛ no ahye","poem":2},{"text":"afifideɛ nyinaa ayera","poem":1},{"text":"na ɛnkaa wira biara a ɛyɛ mono.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti ahonyadeɛ a wɔapɛ agu hɔ no","poem":1},{"text":"wɔsoa de kɔtwa mpampuro bɔnhwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔn nkekamu gyegye wɔ Moab ahyeɛ so;","poem":1},{"text":"wɔn agyaadwotwa kɔduru Eglaim","poem":2},{"lineBreak":true},{"text":"na wɔn abubuobɔ kɔduru Beer Elim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dimon nsuo ayɛ mogya nkoaa","poem":1},{"text":"nanso mɛkɔ so ne no adi.","poem":2},{"text":"Gyata bɛba Moab adwanefoɔ no so","poem":1},{"text":"ne wɔn a wɔbɛka asase no so.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"15.1 Ar ne Kir yɛ Moabfoɔ nkuro atitire mmienu.","reference":{"chapter":15,"verse":1}}]},"thisChapterLink":"/api/twi_asa/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}