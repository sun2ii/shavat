{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Awurade Bepɔ No"]},{"type":"verse","number":1,"content":["Yei ne deɛ Amos babarima Yesaia hunuiɛ, a ɛfa Yuda ne Yerusalem ho."]},{"type":"line_break"},{"type":"verse","number":2,"content":["Nna a ɛdi akyire no mu no,",{"text":"Awurade asɔredan bepɔ no bɛtim","poem":1},{"text":"sɛ mmepɔ no nyinaa ti;","poem":2},{"text":"ɛbɛgye edin aboro nkokoɔ nyinaa so","poem":1},{"text":"na aman nyinaa bɛbɔ yuu akɔ hɔ.","poem":2}]},{"type":"verse","number":3,"content":["Nnipa bebree bɛba abɛka sɛ,",{"text":"“Mommra mma yɛnkɔ Awurade bepɔ no so,","poem":1},{"text":"nkɔ Yakob Onyankopɔn efie.","poem":2},{"text":"Ɔbɛkyerɛkyerɛ yɛn nʼakwan","poem":1},{"text":"sɛdeɛ ɛbɛyɛ a yɛbɛnante nʼakwantempɔn so.”","poem":2},{"text":"Mmara no bɛfiri Sion aba","poem":1},{"text":"na Awurade asɛm afiri Yerusalem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔbɛbu amanaman ntam atɛn","poem":1},{"text":"na ɔbɛsiesie nnipa bebree ntam asɛm;","poem":2},{"text":"wɔde wɔn akofena bɛbobɔ nsɔ","poem":1},{"text":"na wɔde wɔn mpea ayɛ nsɔsɔ.","poem":2},{"text":"Ɔman bi rentwe ɔman foforɔ so akofena,","poem":1},{"text":"na wɔrenyɛ ahoboa biara mma ɔko bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mommra, Ao Yakob fiefoɔ,","poem":1},{"text":"momma yɛnnante Awurade hann mu.","poem":2}]},{"type":"heading","content":["Awurade Da No"]},{"type":"verse","number":6,"content":[{"text":"Awurade, Woagya wo nkurɔfoɔ,","poem":1},{"text":"Yakob fiefoɔ.","poem":2},{"text":"Gyedihunu a ɛfiri apueeɛ fam ahyɛ wɔn ma;","poem":1},{"text":"wɔhyɛ nkɔm sɛ Filistifoɔ","poem":2},{"lineBreak":true},{"text":"na wɔ ne abosonsomfoɔ di hwebom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dwetɛ ne sikakɔkɔɔ ahyɛ wɔn asase no so ma;","poem":1},{"text":"wɔn ademudeɛ dɔɔso bebree.","poem":2},{"text":"Apɔnkɔ ayɛ wɔn asase no so ma;","poem":1},{"text":"na wɔn nteaseɛnam dodoɔ nni ano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ahoni ahyɛ wɔn asase no so ma;","poem":1},{"text":"wɔkoto sɔre wɔn ankasa nsa ano adwuma,","poem":2},{"lineBreak":true},{"text":"deɛ wɔn nsateaa ayɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti, Awurade bɛbrɛ onipa ase","poem":1},{"text":"na wama adasamma aboto.","poem":2},{"text":"Ɔmmfa wɔn ho nkyɛ wɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kɔhyɛne abotan no mu,","poem":1},{"text":"fa wo ho kɔsie asase no mu ɛsiane Awurade ho hu","poem":2},{"lineBreak":true},{"text":"ne nʼanimuonyam kɛseyɛ nti!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔbɛbrɛ ɔhantanni ase,","poem":1},{"text":"na wɔde nnipa ahomasoɔ ahwe fam;","poem":2},{"text":"Awurade nko ara na wɔbɛma no so da no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asafo Awurade ahyɛ da bi","poem":1},{"text":"ama ahomasofoɔ nyinaa","poem":2},{"text":"ne deɛ ɛma ne ho so nyinaa","poem":1},{"text":"(wɔbɛbrɛ wɔn ase),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lebanon","poem":1},{"noteId":0},{"text":"ntweneduro nyinaa, atentene ne deɛ ɛkrɔn,","poem":1},{"text":"ne Basan odum nnua no,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mmepɔ atentene nyinaa","poem":1},{"text":"ne nkokoɔ a ɛwowareɛ nyinaa,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ne abantenten a ɛkorɔn","poem":1},{"text":"ne ɔfasuo biara a ɛyɛ den,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"adwadie hyɛn biara","poem":1},{"text":"ne ɛhyɛn kɛseɛ fɛfɛ biara.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔbɛbrɛ ɔhantanni ase,","poem":1},{"text":"na wɔde nnipa ahomasoɔ ahwe fam;","poem":2},{"text":"Awurade nko ara na wɔbɛma no so da no,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"na ahoni no bɛyera korakora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nnipa bɛdwane akɔhyɛ abodan a ɛwɔ abotan mu","poem":1},{"text":"ne ntokuro a ɛdeda asase mu","poem":2},{"text":"ɛsiane Awurade ho hu","poem":1},{"text":"ne nʼanimuonyam kɛseyɛ enti,","poem":2},{"lineBreak":true},{"text":"ɛberɛ a ɔbɛsɔre awoso asase.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saa ɛda no, nnipa bɛto","poem":1},{"text":"wɔn dwetɛ ne sikakɔkɔɔ ahoni","poem":2},{"text":"a wɔyɛɛ sɛ wɔbɛsom no","poem":1},{"text":"agu ama akusie ne mpan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wɔbɛdwane akɔhyɛne abotan mu ntokuro mu","poem":1},{"text":"ne abotan mpaapaeɛ mu","poem":2},{"text":"ɛsiane Awurade ho hu","poem":1},{"text":"ne nʼanimuonyam kɛseyɛ enti,","poem":2},{"lineBreak":true},{"text":"ɛberɛ a ɔbɛsɔre awoso asase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Monnyae sɛ mode mo ho to nnipa,","poem":1},{"text":"a wɔwɔ ahome kɛkɛ so.","poem":2},{"lineBreak":true},{"text":"Wɔyɛ ɛdeɛn koraa?","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.13 Lebanon yɛ ɔmantam bi a na ɛda Yordan apueeɛ fam a, ɛnam ntweneduro ne anantwie a na ɛwɔ hɔ no enti, agye din.","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/twi_asa/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}