{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Nkɔmhyɛ A Ɛtia Babilonia"]},{"type":"verse","number":1,"content":["Nkɔmhyɛ a ɛfa Babilonia, anweatam no a ɛda Po no ho:",{"text":"Sɛdeɛ twahoframa a ɛbɔ fa anafoɔ fam asase so no yɛ no,","poem":1},{"text":"saa ara na ɔtohyɛsoɔni bi firi anweatam so reba.","poem":2},{"lineBreak":true},{"text":"Ɔfiri asase a ɛyɛ hunabɔbrim so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wɔde anisoadehunu a ɛyɛ nwanwa akyerɛ me:","poem":1},{"lineBreak":true},{"text":"Ɔfatwafoɔ bi redi hwammɔ. Ɔfomfoɔ bi refa afodeɛ.","poem":1},{"lineBreak":true},{"text":"Elam reto ahyɛ ɔman bi so! Media rebɔ pampim!","poem":1},{"text":"Mede apinisie a Babilonia de baeɛ no nyinaa bɛba awieeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yei ama ɔyea bi abɛhyɛ me mu,","poem":1},{"text":"ɔyea aka me, te sɛ ɔbaa a awoɔ aka no;","poem":2},{"text":"deɛ meteɛ no enti mentumi nnyina me nan so,","poem":1},{"text":"deɛ mehunu no ama me ho adwiri me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mʼakoma bɔ paripari,","poem":1},{"text":"ehu ma me ho popo;","poem":2},{"text":"na ɛhan a mepɛɛ sɛ mehunu no","poem":1},{"text":"abɛyɛ adeɛ a ɛbɔ me hu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wɔto ɛpono,","poem":1},{"text":"wɔde kuntu akɛtɛ sesɛ fam,","poem":2},{"lineBreak":true},{"text":"wɔdidi, na wɔnom!","poem":2},{"text":"Monsɔre mo asraafoɔ mpanimfoɔ,","poem":1},{"text":"momfa ngo nsrasra mo akyɛm ho!","poem":2}]},{"type":"verse","number":6,"content":["Yei ne deɛ Awurade ka kyerɛ me:",{"text":"“Fa ɔwɛmfoɔ kɔgyina hɔ","poem":1},{"text":"na ɔnka deɛ ɔhunu nkyerɛ wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sɛ ɔhunu nteaseɛnam","poem":1},{"text":"ne apɔnkɔ akuakuo,","poem":2},{"text":"wɔn a wɔtete mfunumu so","poem":1},{"text":"ne wɔn a wɔtete nyoma so a,","poem":2},{"text":"ɔnwɛn nʼaso","poem":1},{"text":"wɛn pa ara.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na ɔwɛmfoɔ no teaam sɛ,","poem":1},{"text":"“Me wura da biara megyina ɔwɛn aban no so","poem":2},{"text":"anadwo biara, megyina hɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hwɛ, ɔbarima bi a ɔte teaseɛnam mu na ɔreba yi","poem":1},{"text":"ɔne apɔnkɔ dɔm.","poem":2},{"text":"Na ɔwɛmfoɔ no kaa sɛ,","poem":1},{"text":"‘Babilonia ahwe ase, wahwe ase!","poem":2},{"text":"Nʼanyame ne nʼahoni nyinaa","poem":1},{"text":"abubu agu fam!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ao, me nkurɔfoɔ a wɔadwera mo wɔ ayuporeeɛ ase","poem":1},{"text":"meka deɛ mateɛ kyerɛ mo,","poem":2},{"text":"deɛ ɛfiri Asafo Awurade,","poem":1},{"text":"deɛ ɛfiri Israel Onyankopɔn hɔ.","poem":2}]},{"type":"heading","content":["Nkɔmhyɛ A Ɛtia Edom"]},{"type":"verse","number":11,"content":["Nkɔmhyɛ a ɛfa Duma ho:",{"text":"Obi frɛ me firi Seir,","poem":1},{"text":"“Ɔwɛmfoɔ, berɛ bɛn na adeɛ bɛkye?","poem":2},{"lineBreak":true},{"text":"Ɔwɛmfoɔ, aka nnɔnhwere ahe ansa na adeɛ akye?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔwɛmfoɔ no bua sɛ,","poem":1},{"text":"“Adeɛ rekye, nanso adeɛ bɛsa.","poem":2},{"text":"Sɛ wobɛbisa bio a","poem":1},{"text":"sane bra bɛbisa.”","poem":2}]},{"type":"heading","content":["Nkɔmhyɛ A Ɛtia Arabia"]},{"type":"verse","number":13,"content":["Adehunu a ɛfa Arabia ho:",{"text":"Mo Dedan akwantufoɔ a","poem":1},{"text":"mosoɛ wɔ Arabia adɔtɔ ase,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Momfa nsuo mmrɛ wɔn a sukɔm de wɔn;","poem":2},{"text":"mo a motete Tema,","poem":1},{"text":"mommrɛ adwanefoɔ aduane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wɔdwane firi akofena a watwe","poem":1},{"text":"tadua a wɔakuntun mu","poem":2},{"text":"ne ɔko a ɛgyina mu ano.","poem":1}]},{"type":"verse","number":16,"content":["Yei ne deɛ Awurade ka kyerɛ me, “Afe baako mu no, sɛdeɛ wɔkan ɔpaani mfeɛ no, Kedar kɛseyɛ to bɛtwa."]},{"type":"verse","number":17,"content":["Na agyantofoɔ a wɔbɛka ne Kedar akofoɔ bɛyɛ kakraa bi.” Deɛ Awurade, Israel Onyankopɔn, aka nie."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}