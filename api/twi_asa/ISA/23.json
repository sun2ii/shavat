{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Nkɔmhyɛ A Ɛfa Tiro Ho"]},{"type":"verse","number":1,"content":["Nkɔmhyɛ a ɛfa Tiro ho:",{"text":"Ao, Tarsis ahyɛn, montwa adwo!","poem":1},{"text":"Ɛfiri sɛ wɔasɛe Tiro","poem":2},{"lineBreak":true},{"text":"na anka no afie anaa ɛhyɛngyinabea.","poem":2},{"text":"Wɔfiri Kipro asase so","poem":1},{"text":"abɛka akyerɛ wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Monyɛ komm, mo nnipa a mowɔ supɔ no so","poem":1},{"text":"ne mo Sidon adwadifoɔ a","poem":2},{"lineBreak":true},{"text":"ɛpo so adwumayɛfoɔ ama mo ayɛ adefoɔ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nsuo akɛseɛ no so","poem":1},{"text":"na aduane firi Sihor nam baeɛ;","poem":2},{"text":"Nil ho nnɔbaeɛ na ɛyɛɛ Tirofoɔ toɔ,","poem":1},{"text":"na ɔbɛyɛɛ amanaman adwadibea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Animguaseɛ nka wo, Ao Sidon, ne wo, Ao ɛpo so aban,","poem":1},{"text":"ɛfiri sɛ ɛpo akasa sɛ,","poem":2},{"text":"“Menkyemee da na menwoo da;","poem":1},{"text":"mentetee mmammarima anaa mmammaa da.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sɛ asɛm no duru Misraim a,","poem":1},{"text":"wɔn ho bɛdwiri wɔn wɔ nkra a ɛfiri Tiro no ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Montwa nkɔ Tarsis;","poem":1},{"text":"montwa adwo, mo a mowɔ supɔ no so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yei ne mo ahosɛpɛ kuropɔn no?","poem":1},{"text":"Yei ne teteete kuropɔn no a","poem":2},{"text":"watu akɔtena","poem":1},{"text":"akyirikyiri nsase soɔ no anaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hwan na ɔbɔɔ atirimpɔ yei de tiaa Tiro,","poem":1},{"text":"deɛ ɔkyekyɛ ahenkyɛ,","poem":2},{"text":"deɛ nʼadwadifoɔ yɛ ahene mma,","poem":1},{"text":"na nʼadetɔnfoɔ agye din wɔ asase so?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asafo Awurade na ɔbɔɔ ne tirimpɔ sɛ,","poem":1},{"text":"ɔbɛbrɛ animuonyam mu ahomasoɔ ase","poem":2},{"lineBreak":true},{"text":"na wabrɛ wɔn a wɔagye din wɔ asase yi so nyinaa ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yɛ wʼasase so adwuma te sɛ deɛ wɔyɛ wɔ Nil ho no","poem":1},{"text":"Ao Ɔbabaa Tarsis,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ wonni hyɛngyinabea bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade apagya ne nsa wɔ ɛpo no so","poem":1},{"text":"ama ahennie ahodoɔ a ɛwɔ hɔ no repopo.","poem":2},{"text":"Wahyɛ Kanaan ho mmara sɛ,","poem":1},{"text":"wɔnsɛe nʼaban.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔkaa sɛ, “Wʼahurisidie no nso ha ara,","poem":1},{"text":"Ao Ɔbabaa bunu Sidon a wɔadwera wo!","poem":2},{"lineBreak":true},{"text":"“Sɔre, tware kɔ Kipro;","poem":1},{"text":"ɛhɔ mpo worennya ahotɔ.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Monhwɛ Babiloniafoɔ asase no,","poem":1},{"text":"saa nnipa a seesei wɔnka hwee no!","poem":2},{"text":"Asiriafoɔ ayɛ no","poem":1},{"text":"beaeɛ a anweatam so mmoa teɛ;","poem":2},{"text":"wɔsisii wɔn ntua aban bebree,","poem":1},{"text":"wɔdwirii nʼaban guiɛ","poem":2},{"lineBreak":true},{"text":"ma ɛdanee mmubuiɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Montwa adwo, Tarsis ahyɛn;","poem":1},{"text":"wɔasɛe wʼaban!","poem":2}]},{"type":"verse","number":15,"content":["Saa ɛberɛ no wɔrenkae Tiro mfeɛ aduɔson, a ɛyɛ ɔhene nkwanna. Nanso mfeɛ aduɔson akyi no, deɛ ɛbɛto Tiro no bɛyɛ sɛdeɛ ɛwɔ odwamanfoɔ no dwom mu no:"]},{"type":"verse","number":16,"content":[{"text":"“Ma sankuten no so, pase fa kuropɔn no mu,","poem":1},{"text":"Ao odwamanfoɔ a wɔnnkae wo;","poem":2},{"text":"bɔ sankuten no yie, to nnwom bebree,","poem":1},{"text":"sɛdeɛ wɔbɛkae wo.”","poem":2}]},{"type":"verse","number":17,"content":["Mfeɛ aduɔson akyi, Awurade ne Tiro bɛdi. Ɔbɛsane akɔdi ne paa sɛ odwamanfoɔ na ɔne ahennie a ɛwɔ asase so nyinaa adi dwa."]},{"type":"verse","number":18,"content":["Nanso, deɛ ɔbɛnya ne ne mfasoɔ nyinaa, wɔde bɛto hɔ ama Awurade; wɔremmoaboa ano na wɔremfa nsie. Ne mfasoɔ no bɛkɔ wɔn a wɔsom wɔ Awurade anim, na wɔanya aduane bebree ne ntadeɛ pa."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}