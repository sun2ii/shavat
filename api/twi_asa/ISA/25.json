{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Ayɛyie Nka Awurade"]},{"type":"verse","number":1,"content":[{"text":"Ao, Awurade, wone me Onyankopɔn;","poem":1},{"text":"mɛma wo so na mayi wo din ayɛ,","poem":2},{"text":"ɛfiri sɛ wofiri nokorɛdie mu","poem":1},{"text":"ayɛ anwanwadeɛ bebree,","poem":2},{"lineBreak":true},{"text":"nneɛma a wɔahyehyɛ firi teteete.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woayɛ kuropɔn no mmubuiɛ sie,","poem":1},{"text":"kuro no a ɛwɔ banbɔ no asɛe;","poem":2},{"text":"ananafoɔ abandenden no nyɛ kuropɔn bio;","poem":1},{"text":"na wɔrensi bio.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti aman a wɔyɛ den bɛdi wo ni","poem":1},{"text":"atutupɛfoɔ aman bɛhyɛ wo animuonyam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Woayɛ ahiafoɔ dwanekɔbea,","poem":1},{"text":"ohiani mmɔborɔni dwanekɔbea,","poem":2},{"text":"ahum ano ahintaeɛ","poem":1},{"text":"ɔhyeɛ mu nwunu","poem":2},{"text":"na atutupɛfoɔ ahome","poem":1},{"text":"te sɛ ahum a ɛrebɔ dwira ɔfasuo","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ne ɔhyew a ɛwɔ anweatam so.","poem":2},{"text":"Wobrɛ ananafoɔ hooyɛ ase;","poem":1},{"text":"sɛdeɛ omununkum brɛ owia ɔhyeɛ ano ase no,","poem":2},{"lineBreak":true},{"text":"saa ara na atutupɛfoɔ nnwom nso bɛgyaeɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asafo Awurade bɛto ɛpono wɔ saa bepɔ yi so.","poem":1},{"lineBreak":true},{"text":"Ɔbɛsiesie nnuane pa ne nsã a adi nna,","poem":1},{"text":"ɛnam pa ne nsã pa ama nnipa nyinaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔ bepɔ yi so, ɔbɛsɛe","poem":1},{"text":"owuo ntoma a ɛkata nnipa nyinaa ho","poem":2},{"text":"ne owuo nkatasoɔ a ɛkata aman nyinaa so;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Ɔbɛmene owuo afebɔɔ.","poem":2},{"text":"Asafo Awurade bɛpepa","poem":1},{"text":"aniso nisuo nyinaa.","poem":2},{"text":"Ɔbɛyi ne nkurɔfoɔ ahohora,","poem":1},{"text":"afiri nsase nyinaa so.","poem":2},{"lineBreak":true},{"text":"Awurade na waka.","poem":2}]},{"type":"verse","number":9,"content":["Saa ɛda no, wɔbɛka sɛ,",{"text":"“Ampa ara yɛn Onyankopɔn nie;","poem":1},{"text":"yɛde yɛn ho too no so na ɔgyee yɛn;","poem":2},{"text":"Awurade no nie, yɛgyee no diiɛ;","poem":1},{"text":"momma yɛnni ahurisie na yɛn ani nnye wɔ ne nkwagyeɛ no mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade nsa bɛda saa bepɔ yi so;","poem":1},{"text":"nanso ɔbɛtiatia Moab so","poem":2},{"lineBreak":true},{"text":"te sɛ ɛserɛ a wɔtiatia so de fra sumena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔbɛtrɛtrɛ wɔn nsa mu wɔ so,","poem":1},{"text":"sɛdeɛ osudwarefoɔ trɛtrɛ ne nsa mu de dwareɛ.","poem":2},{"text":"Onyankopɔn bɛbrɛ wɔn ahomasoɔ ase","poem":1},{"text":"a ɔrenhwɛ wɔn nsa ano dwumadie ho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔbɛbubu mo banbɔ afasuo atentene no agu;","poem":1},{"text":"ɔbɛbubu agu fam","poem":2},{"lineBreak":true},{"text":"ama ayɛ mfuturo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}