{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusalem Ne Yuda Atemmuo"]},{"type":"verse","number":1,"content":[{"text":"Afei hwɛ, Awurade,","poem":1},{"text":"Asafo Awurade,","poem":2},{"text":"rebɛgyae deɛ ɔde ma","poem":1},{"text":"wɔ Yerusalem ne Yuda nyinaa:","poem":2},{"lineBreak":true},{"text":"aduane ne nsuo a ɔde ma wɔn nyinaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnɔmmarima ne akofoɔ,","poem":1},{"text":"ɔtemmufoɔ ne odiyifoɔ,","poem":2},{"lineBreak":true},{"text":"nkɔmhyɛni ne ɔpanin,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"aduonum so panin ne deɛ ɔwɔ diberɛ,","poem":1},{"text":"ɔfotufoɔ, odwumfoɔ nyansafoɔ ne nkaberɛkyerefoɔ oniferefoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mede mmerantewaa bɛyɛ wɔn nnwuma so mpanimfoɔ;","poem":1},{"text":"na mmɔfra adi wɔn so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nnipa bɛhyɛ wɔn ho wɔn ho so,","poem":1},{"text":"ɔbarima bɛtia ɔbarima, ɔyɔnko bɛtia ne yɔnko.","poem":2},{"text":"Mmabunu bɛsɔre atia wɔn mpanimfoɔ,","poem":1},{"text":"apapahwekwaa bɛtia onimuonyamfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɔbarima bɛsɔ ne nuanom baako mu","poem":1},{"text":"wɔ nʼagya efie aka sɛ,","poem":2},{"text":"“Wowɔ atadeɛ, bɛyɛ yɛn dikanfoɔ;","poem":1},{"text":"wɔ kuro a adane mmubuiɛ sie yi so.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nanso, ɛda no ɔbɛteam sɛ,","poem":1},{"text":"“Menni deɛ mede bɛyɛ.","poem":2},{"text":"Menni aduane anaa ntoma wɔ me fie;","poem":1},{"text":"mfa me nyɛ nnipa no so dikanfoɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalem retɔ ntintan,","poem":1},{"text":"Yuda rehwe ase;","poem":2},{"text":"wɔn nsɛm ne nneyɛeɛ tia Awurade.","poem":1},{"text":"Wɔmmu nʼanimuonyam a ɛwɔ wɔn mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛdeɛ wɔn anim teɛ no di adanseɛ tia wɔn;","poem":1},{"text":"wɔda wɔn bɔne adi te sɛ Sodom;","poem":2},{"lineBreak":true},{"text":"wɔmmfa nsie.","poem":2},{"text":"Nnome nka wɔn!","poem":1},{"text":"Wɔakɔfa amanehunu aba wɔn ho so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ka kyerɛ teneneefoɔ sɛ ɛbɛsi wɔn yie,","poem":1},{"text":"ɛfiri sɛ wɔbɛdi wɔn nneyɛeɛ so aba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nnome nka amumuyɛfoɔ!","poem":1},{"text":"Amanehunu wɔ wɔn so!","poem":2},{"text":"Wɔbɛtua wɔn so ka","poem":1},{"text":"wɔ deɛ wɔn nsa ayɛ no ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mmabunu hyɛ me nkurɔfoɔ so,","poem":1},{"text":"mmaa di wɔn so.","poem":2},{"text":"Ao me nkurɔfoɔ, mo akwankyerɛfoɔ ma mo yera;","poem":1},{"text":"wɔma mo mane firi kwantempɔn no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Awurade tena ase wɔ nʼasɛnniiɛ.","poem":1},{"text":"Ɔma ne mu so bu nkurɔfoɔ no atɛn.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Awurade bu atɛn","poem":1},{"text":"de tia ne nkurɔfoɔ mpanimfoɔ ne akannifoɔ sɛ,","poem":2},{"text":"“Mo na moasɛe me bobe turo;","poem":1},{"text":"apoobɔdeɛ a ɛfiri ahiafoɔ nkyɛn wɔ mo afie mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aseɛ ne sɛn enti na modwɛre me nkurɔfoɔ","poem":1},{"text":"na mode ahiafoɔ anim twitwiri fam?”","poem":2},{"lineBreak":true},{"text":"Sɛdeɛ Asafo Awurade seɛ nie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Awurade kasa sɛ,","poem":1},{"text":"“Sion mmammaa yɛ ahantan;","poem":2},{"text":"wɔnante toto wɔn kɔn,","poem":1},{"text":"wɔdeda wɔn ani akyi,","poem":2},{"text":"wɔtutu wɔn anammɔn ntiawa ntiawa,","poem":1},{"text":"na wɔn nan ase nkawa gyegye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti Awurade bɛma tikuro abɛgu Sion mmaa tiri ho.","poem":1},{"text":"Awurade bɛma wɔn tiri so apa.”","poem":2}]},{"type":"verse","number":18,"content":["Ɛda no Awurade bɛyiyi wɔn afɛfɛdeɛ: nkawa, ntomaban ne kɔnmuadeɛ,"]},{"type":"verse","number":19,"content":["nsomuadeɛ, nkapo ne nkatanimu,"]},{"type":"verse","number":20,"content":["Wɔn mmɔtire, ananse ntweaban, abɔwomu, nnuhwam ntoa ne nkaberɛ,"]},{"type":"verse","number":21,"content":["ntimsoɔ mpɛtea ne hwenemu nkawa,"]},{"type":"verse","number":22,"content":["ntadetenten pa, ngugusoɔ tiawa a ɛnni nsa, ntadeɛ yuu ne sika nkotokuo;"]},{"type":"verse","number":23,"content":["nhwehwɛ, serekye ntadeɛ, tirinwi so nkawa ne abatiri so ngugusoɔ."]},{"type":"verse","number":24,"content":[{"text":"Nkabɔne bɛsi deɛ ɛyɛ hwam anan mu;","poem":1},{"text":"ntampehoma bɛsi nkatakɔnmu anan mu;","poem":2},{"text":"tire a ɛso apa bɛsi tirinwi a wɔasiesie anan mu;","poem":1},{"text":"ayitoma bɛsi ntoma pa anan mu;","poem":2},{"lineBreak":true},{"text":"honam ani atwaatwa bɛsi ahoɔfɛ anan mu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wo mmarima bɛtotɔ akofena ano,","poem":1},{"text":"wʼakofoɔ bɛtotɔ wɔ ɔko mu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sion apono bɛtwa adwo, adi awerɛhoɔ;","poem":1},{"text":"na deɛ ɔnnibie bɛtena fam asu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}