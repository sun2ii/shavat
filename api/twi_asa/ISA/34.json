{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Atemmuo A Ɛtia Amanaman No"]},{"type":"verse","number":1,"content":[{"text":"Montwi mmɛn, mo amanaman, na montie;","poem":1},{"text":"monyɛ aso, mo ɔmanfoɔ!","poem":2},{"text":"Momma asase ne deɛ ɛwɔ so nyinaa ntie,","poem":1},{"text":"ewiase ne deɛ ɛfiri mu ba nyinaa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade bo afu amanaman no;","poem":1},{"text":"nʼabufuhyeɛ no tia wɔn akodɔm nyinaa.","poem":2},{"text":"Ɔbɛsɛe wɔn pasaa,","poem":1},{"text":"ɔbɛma wɔakunkum wɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔbɛto wɔn mu atɔfoɔ no agu,","poem":1},{"text":"wɔn afunu no bɛyi hwa;","poem":2},{"lineBreak":true},{"text":"wɔn mogya bɛfɔ mmepɔ no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔsoro nsoromma nyinaa bɛyera","poem":1},{"text":"na wɔbɛbobɔ ɔsoro te sɛ nwoma mmobɔeɛ;","poem":2},{"text":"ɔsoro atumfoɔ bɛhwe ase","poem":1},{"text":"sɛdeɛ nhahan te firi bobe so,","poem":2},{"lineBreak":true},{"text":"sɛdeɛ mman a awo firi borɔdɔma dua ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mʼakofena anom deɛ ɛmee no wɔ soro;","poem":1},{"text":"hwɛ, ɛresiane de atemmuo aba Edom so,","poem":2},{"lineBreak":true},{"text":"wɔn a masɛe wɔn koraa no.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mogya adware Awurade akofena ho,","poem":1},{"text":"wɔde sradeɛ asra ho,","poem":2},{"text":"nnwammaa ne mpɔnkye mogya,","poem":1},{"text":"nnwennini sawa mu sradeɛ.","poem":2},{"text":"Awurade wɔ afɔrebɔ bi bɔ wɔ Bosra","poem":1},{"text":"ne okum kɛseɛ wɔ Edom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anantwie aniɔdenfoɔ ne wɔn bɛtotɔ,","poem":1},{"text":"anantwinini nketewa ne akɛseɛ.","poem":2},{"text":"Mogya bɛfɔ wɔn asase no,","poem":1},{"text":"na sradeɛ ayɛ ɛso dɔteɛ no sɔkyee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na ɛyɛ Awurade aweretɔ da","poem":1},{"text":"a ɔbɛdi ama Sion.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Edom nsuwa nsuwa bɛdane agodibea,","poem":1},{"text":"ne dɔteɛ bɛdane sɔfe a ɛdɛre","poem":2},{"lineBreak":true},{"text":"nʼasase bɛyɛ agoprama a ɛdɛre!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɛrennum awia anaa anadwo;","poem":1},{"text":"ne wisie bɛfiri a ɛtoɔ rentwa da.","poem":2},{"text":"Ɛbɛda mpan firi awoɔ ntoatoasoɔ akɔsi awoɔ ntoatoasoɔ;","poem":1},{"text":"obiara remfa ho bio koraa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anweatam so patuo ne ɔbonsamnoma","poem":1},{"text":"bɛgye hɔ afa;","poem":2},{"text":"ɔpatuo ne anene bɛtena hɔ.","poem":1},{"text":"Onyankopɔn bɛtwe basabasayɛ ahoma","poem":2},{"text":"wɔ Edom so,","poem":1},{"text":"ɔde bɛsɛe ɔman no.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nʼatitire renya biribiara a ɛbɛma wɔafrɛ no ahennie,","poem":1},{"text":"nʼahenemma mmarima nyinaa bɛtu ayera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nkasɛɛ bɛgye nʼabankɛsewa afa,","poem":1},{"text":"nsansono ne nkasɛɛ bɛfu wɔ nʼabankɛsewa hɔ.","poem":2},{"text":"Ɛhɔ bɛyɛ adompo atuo,","poem":1},{"text":"ne apatuo tenabea.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anweatam so mmoa ne mpataku bɛhyia adi afra,","poem":1},{"text":"mpɔnkye aniɔdenfoɔ bɛsu akyerɛ wɔn ho;","poem":2},{"text":"ɛhɔ na anadwo mmoa bɛdeda","poem":1},{"text":"na wɔde ayɛ wɔn homebea.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɛhɔ na ɔpatuo bɛyɛ ne pirebuo, na wato ne nkosua.","poem":1},{"text":"Ɔbɛhwane ne mma, na ɔde ne ntaban akata wɔn so;","poem":2},{"text":"ɛhɔ na nkorɔma bɛboaboa wɔn ho ano,","poem":1},{"text":"obiara ne deɛ ɔka ne ho.","poem":2}]},{"type":"verse","number":16,"content":["Hwɛ Awurade nwoma mmobɔeɛ no mu, na kenkan:",{"text":"Yeinom mu biara renyera,","poem":1},{"text":"obiara bɛnya deɛ ɔka ne ho.","poem":2},{"text":"Ɛfiri sɛ nʼanom na ɔhyɛ asɛm no firie,","poem":1},{"text":"na ne honhom bɛboaboa wɔn ano.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɔde wɔn kyɛfa rema wɔn;","poem":1},{"text":"ɔde ne nsa yɛ susudua kyekyɛ.","poem":2},{"text":"Wɔbɛfa no sɛ wɔn dea afebɔɔ","poem":1},{"text":"na wɔfiri awoɔ ntoatoasoɔ akɔsi awoɔ ntoatoasoɔ atena hɔ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}