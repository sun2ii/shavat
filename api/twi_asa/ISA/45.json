{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“Yei ne deɛ Awurade ka kyerɛ deɛ wasra no ngo,","poem":1},{"text":"Kores a wasɔ ne nsa nifa mu","poem":2},{"text":"sɛ ɔmmrɛ aman ase wɔ nʼanim","poem":1},{"text":"na ɔnnye ahemfo akodeɛ mfiri wɔn nsam","poem":2},{"text":"na ɔmmuebue apono a ɛwɔ nʼanim","poem":1},{"text":"sɛdeɛ kuro apono no mu rentoto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛdi wʼanim","poem":1},{"text":"mɛyɛ mmepɔ no asase tamaa;","poem":2},{"text":"mɛbubu kɔbere mfrafraeɛ apono agu","poem":1},{"text":"na matwitwa dadeɛ adaban mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mede esum mu ademudeɛ bɛma wo","poem":1},{"text":"ahonyadeɛ a wɔde asie kɔkoam","poem":2},{"text":"sɛdeɛ wobɛhunu sɛ, mene Awurade,","poem":1},{"text":"Israel Onyankopɔn, a ɔbɔ wo din frɛ woɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me ɔsomfoɔ Yakob enti,","poem":1},{"text":"Israel a mapa no enti,","poem":2},{"text":"mebɔ wo din frɛ wo","poem":1},{"text":"na mɛma wo animuonyamhyɛ abodin,","poem":2},{"lineBreak":true},{"text":"ɛwom sɛ wonnyee me ntoo mu deɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mene Awurade, obiara nni hɔ bio;","poem":1},{"text":"Onyankopɔn biara nni hɔ ka me ho.","poem":2},{"text":"Ɛwom sɛ wonnyee me ntoo mu deɛ,","poem":1},{"text":"nanso mɛhyɛ wo den,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"sɛdeɛ ɛbɛyɛ a ɛfiri deɛ owia pue","poem":1},{"text":"kɔsi beaeɛ a ɛtɔ no","poem":2},{"text":"nnipa bɛhunu sɛ obiara nka me ho.","poem":1},{"text":"Mene Awurade, na obiara nni hɔ bio.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meyɛ hann, na mebɔ esum.","poem":1},{"text":"Mede yiedie ba na mede ɔhaw ba;","poem":2},{"lineBreak":true},{"text":"Me, Awurade, na meyɛ yeinom nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mo ɔsorosoro, monhwie tenenee ngu fam;","poem":1},{"text":"momma ɛmfiri omununkum mu ntɔ","poem":2},{"text":"momma asase mu mmue kɛseɛ,","poem":1},{"text":"na nkwagyeɛ mpue mfiri mu,","poem":2},{"text":"na tenenee ne no nnyini;","poem":1},{"text":"Me, Awurade na mayɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nnome nka deɛ ɔne ne Yɛfoɔ ham","poem":1},{"text":"Ɛnka deɛ ɔmfra te sɛ kyɛmferɛ a ɛfra deɛ ɛgugu fam mu.","poem":2},{"text":"Dɔteɛ bɛtumi abisa ɔnwomfoɔ sɛ,","poem":1},{"text":"‘ɛdeɛn na woreyɛ yi?’","poem":2},{"text":"Wo nsa ano adwuma bɛtumi abisa wo sɛ,","poem":1},{"text":"‘Wonni nsa’?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nnome nka deɛ ɔse nʼagya sɛ","poem":1},{"text":"‘Adɛn enti na wowoo me?’","poem":2},{"text":"Anaa ɔbisa ne maame sɛ,","poem":1},{"text":"‘Adɛn enti na wokyem me woeɛ?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Sei na Awurade seɛ,","poem":1},{"text":"Israel Ɔkronkronni ne ne Yɛfoɔ;","poem":2},{"text":"ɛfa nneɛma a ɛreba ho no.","poem":1},{"text":"Wobisa me nsɛm a ɛfa me mma ho,","poem":2},{"lineBreak":true},{"text":"anaa wohyɛ me wɔ me nsa ano adwuma ho?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɛyɛ me na meyɛɛ asase","poem":1},{"text":"na mebɔɔ adasamma guu so.","poem":2},{"text":"Me ara me nsa na mede trɛɛ ɔsoro mu;","poem":1},{"text":"nsoromma ahodoɔ nyinaa hyɛ mʼase.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɛma Kores so wɔ me tenenee mu;","poem":1},{"text":"mɛtenetene nʼakwan nyinaa.","poem":2},{"text":"Ɔbɛsane akyekyere me kuropɔn","poem":1},{"text":"na wagyaa mʼatukɔfoɔ,","poem":2},{"text":"nanso ɔrennye akatua anaa akyɛdeɛ,","poem":1},{"text":"Asafo Awurade na ɔseɛ.”","poem":2}]},{"type":"verse","number":14,"content":["Sei na Awurade seɛ:",{"text":"“Nneɛma a ɛfiri Misraim ne adwadeɛ a ɛfiri Kus,","poem":1},{"text":"ne Sebafoɔ atentene no,","poem":2},{"text":"wɔbɛba wo nkyɛn","poem":1},{"text":"abɛyɛ wo dea;","poem":2},{"text":"wɔbɛdi wʼakyi brɛoo aba a","poem":1},{"text":"wɔgu nkɔnsɔnkɔnsɔn mu.","poem":2},{"text":"Wɔbɛbu nkotodwe wʼanim","poem":1},{"text":"na wɔasrɛ wo aka sɛ,","poem":2},{"text":"‘Ampa ara, Onyankopɔn ka wo ho, na ɔbi nni hɔ;","poem":1},{"text":"onyame biara nni hɔ.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ampa ara, woyɛ Onyankopɔn a ɔde ne ho sie,","poem":1},{"text":"Ao Onyankopɔn ne Israel Agyenkwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔn a wɔyɛ ahoni nyinaa bɛfɛre na wɔn anim agu ase;","poem":1},{"text":"wɔbɛbɔ mu akɔ animguaseɛ mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nanso, Awurade bɛgye Israel nkwa,","poem":1},{"text":"ɔde daapem nkwagyeɛ;","poem":2},{"text":"Wɔremma wʼani nwu na wʼanim renguase bio","poem":1},{"text":"kɔsi daapem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Na sei na Awurade seɛ,","poem":1},{"text":"deɛ ɔbɔɔ ɔsorosoro no","poem":2},{"text":"ɔno ne Onyankopɔn;","poem":1},{"text":"deɛ ɔmaa asase, na ɔbɔeɛ no,","poem":2},{"text":"ɔno na ɔtoo ne fapem;","poem":1},{"text":"wammɔ no sɛ ɛso nna hɔ kwa,","poem":2},{"text":"mmom ɔyɛeɛ sɛ nnipa ntena so,","poem":1},{"text":"ɔka sɛ:","poem":2},{"text":"“Me ne Awurade,","poem":1},{"text":"na obi nni hɔ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Menkasaa wɔ kɔkoam,","poem":1},{"text":"mfiri asase so baabi a aduru sum;","poem":2},{"text":"manka ankyerɛ Yakob asefoɔ sɛ,","poem":1},{"text":"‘Sɛ mohwehwɛ me a monnhunu me.’","poem":2},{"text":"Me Awurade, meka nokorɛ no;","poem":1},{"text":"meka deɛ ɛyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mommoaboa mo ho ano na mommra;","poem":1},{"text":"monhyia mu, mo adwanefoɔ a mofiri amanaman so,","poem":2},{"text":"mo a monnim de na moasoa nnua ahoni de kyinkyini,","poem":1},{"text":"mo a mobɔ anyame a wɔntumi nnye nkwa no mpaeɛ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mompae mu nka deɛ ɛbɛsi. Momfa nto dwa","poem":1},{"text":"na wɔn mmɔ mu ntu agyina.","poem":2},{"text":"Hwan na ɔdii ɛkan kaa no teteete,","poem":1},{"text":"hwan na ɔdaa no adi firi tete nteredee?","poem":2},{"text":"Ɛnyɛ me Awurade anaa?","poem":1},{"text":"Onyankopɔn bi nni hɔ ka me ho,","poem":2},{"text":"tenenee Onyankopɔn ne Agyenkwa;","poem":1},{"text":"obiara nni hɔ sɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Monnane mmra me nkyɛn na monnya nkwa,","poem":1},{"text":"mo a mowɔ asase ano nyinaa;","poem":2},{"text":"ɛfiri sɛ mene Onyankopɔn, na obiara nni hɔ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Maka me ho ntam,","poem":1},{"text":"mʼano aka wɔ nokorɛdie nyinaa mu,","poem":2},{"lineBreak":true},{"text":"asɛm a wɔntwe nsane sɛ:","poem":2},{"text":"obiara bɛbu nkotodwe wɔ mʼanim.","poem":1},{"text":"Na obiara bɛpae mu aka sɛ, mene Onyankopɔn.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wɔbɛka me ho asɛm sɛ, ‘Awurade nko ara mu","poem":1},{"text":"na tenenee ne ahoɔden wɔ.’ ”","poem":2},{"text":"Wɔn a wɔn bo huru tia no nyinaa","poem":1},{"text":"bɛba ne nkyɛn na wɔn anim bɛgu ase.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nanso Awurade mu,","poem":1},{"text":"wɔbɛbu Israel asefoɔ nyinaa bem,","poem":2},{"lineBreak":true},{"text":"na wɔahoahoa wɔn ho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}