{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Babilonia Asehweɛ"]},{"type":"verse","number":1,"content":[{"text":"“Siane kɔ, tena mfuturo mu,","poem":1},{"text":"Ɔbabaa bunu Babilonia;","poem":2},{"text":"tena fam. Worentena ahennwa so bio,","poem":1},{"text":"Ɔbabaa Babiloniafoɔ.","poem":2},{"text":"Wɔremfrɛ wo bio sɛ,","poem":1},{"text":"ɔbaabereɛ a wɔkorɔkorɔ no bio.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fa owiyammoɔ na yam esiam;","poem":1},{"text":"yi wo nkatanimu no.","poem":2},{"text":"Pagya wʼatadeɛ kɔ soro, na wo nan ho ngu hɔ,","poem":1},{"text":"na fa nsuwansuwa no mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wʼadagya bɛda adi","poem":1},{"text":"na wʼanimguaseɛ so renkata.","poem":2},{"text":"Mɛtɔ were;","poem":1},{"text":"memfa obiara ho nkyɛ no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yɛn Gyefoɔ, Asafo Awurade ne ne din,","poem":1},{"text":"ɔno ne Israel Kronkronni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tena ase dinn, kɔhyɛ esum mu,","poem":1},{"text":"Ɔbabaa Babilonia;","poem":2},{"text":"wɔremfrɛ wo bio sɛ","poem":1},{"text":"ahennie ahodoɔ so hemaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Me bo fuu me nkurɔfoɔ,","poem":1},{"text":"na meguu mʼagyapadeɛ ho fi;","poem":2},{"text":"mede wɔn hyɛɛ wo nsa,","poem":1},{"text":"na woanhunu wɔn mmɔbɔ.","poem":2},{"text":"Nkɔkoraa koraa mpo","poem":1},{"text":"wosoaa wɔn kɔnnua duruduru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wokaa sɛ, ‘Mɛkɔ so daa,","poem":1},{"text":"ayɛ ɔhemmaa afebɔɔ.’","poem":2},{"text":"Nanso woannwene saa nneɛma yi ho","poem":1},{"text":"na woansusu deɛ ɛbɛtumi asie ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Afei tie, wo odwamanfoɔ,","poem":1},{"text":"woredwodwo wo ho wɔ wo banbɔ mu","poem":2},{"text":"na woka kyerɛ wo ho sɛ,","poem":1},{"text":"‘me ne no, na obiara nni hɔ sɛ me.","poem":2},{"text":"Merenyɛ okunafoɔ da","poem":1},{"text":"na merenni abawuo.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saa nneɛma mmienu yi bɛto wo","poem":1},{"text":"prɛko pɛ, dakoro pɛ:","poem":2},{"text":"abawuo ne kunayɛ.","poem":1},{"text":"Saa nneɛma yi bɛba wo so pa ara,","poem":2},{"text":"wʼabayisɛm bebrebe yi","poem":1},{"text":"ne ntafowayie a emu yɛ den nyinaa akyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wode wo ho ato wʼamumuyɛ so","poem":1},{"text":"na waka sɛ, ‘Obiara nhunu me.’","poem":2},{"text":"Wo nyansa ne nimdeɛ ma wo fom kwan","poem":1},{"text":"ɛberɛ a woka kyerɛ wo ho sɛ,","poem":2},{"lineBreak":true},{"text":"‘Me ne no, obiara nni hɔ ka me ho.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amanehunu bɛto wo,","poem":1},{"text":"na worenhunu ɛkwan ko a wobɛfa so ayi afiri hɔ.","poem":2},{"text":"Ɔhaw bi bɛba wo so","poem":1},{"text":"a worentumi mfa mpatadeɛ nyi mfiri hɔ;","poem":2},{"text":"atoyerɛnkyɛm a ɛnnaa ne ho adi nkyerɛɛ wo","poem":1},{"text":"bɛba wo so mpofirim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kɔ so yɛ wo ntafowayie","poem":1},{"text":"ne wʼabayisɛm bebrebe","poem":2},{"lineBreak":true},{"text":"a wode adi dwuma firi wo mmɔfraase no.","poem":2},{"text":"Ebia wobɛdi nkonim,","poem":1},{"text":"ebia wode ehu bɛba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Woabrɛ wɔ afotufoɔ bebrebe a woanya no mu!","poem":1},{"text":"Ma wo nsoromma ho anyansafoɔ mmra anim,","poem":2},{"text":"wɔn a wɔhwɛ nsoromma mu no ka deɛ ɛreba bosome biara mu no,","poem":1},{"text":"ma wɔnnnye wo mfiri deɛ ɛreba wo so no mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nokorɛm, wɔte sɛ nnyentia;","poem":1},{"text":"ogya bɛhye wɔn.","poem":2},{"text":"Na wɔntumi nnye wɔn ankasa ho","poem":1},{"text":"mfiri egyadɛreɛ ano den no ho.","poem":2},{"text":"Ogyasramma biara nni ha a ɛbɛka wo hye;","poem":1},{"text":"ogya biara nni ha a wɔbɛtena ho ato.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Deɛ wɔbɛtumi ayɛ ama wo ara ne no,","poem":1},{"text":"yeinom na wo ne wɔn abrɛ","poem":2},{"lineBreak":true},{"text":"na wo ne wɔn anante firi mmɔfraase.","poem":2},{"text":"Wɔn mu biara afa ne kwan;","poem":1},{"text":"ɔbaako mpo nni hɔ a ɔbɛtumi agye woɔ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}