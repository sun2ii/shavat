{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israel Ɔsoɔdenfoɔ"]},{"type":"verse","number":1,"content":[{"text":"“Montie yei, Ao, Yakob fiefoɔ","poem":1},{"text":"mo a wɔde Israel din frɛ mo,","poem":2},{"text":"na moyɛ Yuda asefoɔ,","poem":1},{"text":"mo a mobɔ Awurade din ka ntam,","poem":2},{"text":"na mofrɛ Israel Onyankopɔn,","poem":1},{"text":"nanso ɛnyɛ nokorɛ anaa tenenee mu;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mo a mofrɛ mo ho kuro kronkron no mma","poem":1},{"text":"na mode mo ho to Israel Onyankopɔn so.","poem":2},{"lineBreak":true},{"text":"Asafo Awurade ne ne din.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nneɛma a atwam no medii ɛkan kaeɛ,","poem":1},{"text":"mebɔɔ nkaeɛ, na medaa no adi;","poem":2},{"lineBreak":true},{"text":"afei mpofirim mekekaa me ho na ɛbaa mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na menim sɛdeɛ moyɛ asoɔden.","poem":1},{"text":"Mo kɔn ho ntini yɛ dadeɛ","poem":2},{"lineBreak":true},{"text":"na mo moma yɛ kɔbere mfrafraeɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti, mekaa saa nneɛma yi kyerɛɛ mo dadaada.","poem":1},{"text":"Ansa na ɛrebɛsisi no mebɔɔ mo nkaeɛ","poem":2},{"text":"sɛdeɛ morentumi nka sɛ,","poem":1},{"text":"‘Mʼahoni na ɔyɛeɛ:","poem":2},{"lineBreak":true},{"text":"me dua nsɛsodeɛ ne me dadeɛ nyame na ɔhyɛeɛ.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moate yeinom nyinaa; moahunu ne nyinaa.","poem":1},{"text":"Morennye nto mu anaa?","poem":2},{"lineBreak":true},{"text":"“Ɛfiri saa ɛberɛ yi de rekorɔ mɛka nneɛma foforɔ akyerɛ mo,","poem":1},{"text":"nneɛma a ahinta a monnim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afei na ɛreba koraa, ɛnkyɛreɛ;","poem":1},{"text":"ɛbɛsi ɛnnɛ no, na anka montee ho hwee da.","poem":2},{"text":"Enti morentumi nka sɛ,","poem":1},{"text":"‘Aane na menim dada!’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wonteeɛ, na wontee aseɛ;","poem":1},{"text":"ɛfiri tete nyinaa wʼaso asi.","poem":2},{"text":"Na menim sɛ woyɛ ɔfatwafoɔ;","poem":1},{"text":"wɔfrɛɛ wo otuatefoɔ firi yafunu mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Medin enti metwentwɛne mʼabufuo so;","poem":1},{"text":"mʼayɛyie enti meyi firii wo so,","poem":2},{"lineBreak":true},{"text":"sɛdeɛ mentwa wo ntwene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hwɛ, mahoa mo ho, nanso ɛnyɛ sɛdeɛ wɔhoa dwetɛ ho;","poem":1},{"text":"mmom, masɔ wo mahwɛ wɔ amanehunu fononoo mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Me enti, me enti, na meyɛ yei.","poem":1},{"text":"Adɛn enti na ɛsɛ sɛ mema ho kwan na wɔsɛe me din?","poem":2},{"lineBreak":true},{"text":"Memma obi nnye mʼanimuonyam.”","poem":2}]},{"type":"heading","content":["Israel Ahofadie"]},{"type":"verse","number":12,"content":[{"text":"“Tie me, Ao, Yakob,","poem":1},{"text":"Israel a mafrɛ no;","poem":2},{"text":"Me ne no;","poem":1},{"text":"Me ne Ahyɛaseɛ ne Awieeɛ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Me ara me nsa na ɛtoo asase fapem,","poem":1},{"text":"na me nsa na ɛtrɛɛ ɔsorosoro mu;","poem":2},{"text":"sɛ mefrɛ wɔn a,","poem":1},{"text":"wɔn nyinaa bɔ mu sɔre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mo nyinaa mommɔ mu mmra mmɛtie:","poem":1},{"text":"ahoni no mu deɛ ɔwɔ he na waka saa nneɛma yi dada?","poem":2},{"text":"Awurade ɔboafoɔ a wapa no","poem":1},{"text":"bɛma nʼatirimpɔ a ɛtia Babilonia aba mu;","poem":2},{"lineBreak":true},{"text":"ne basa bɛtia Babiloniafoɔ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Me, me na makasa;","poem":1},{"text":"aane, mafrɛ no.","poem":2},{"text":"Mede no bɛba,","poem":1},{"text":"na ɔbɛwie nʼadwuma nkonimdie so.","poem":2}]},{"type":"verse","number":16,"content":["“Montwe mmɛn me na montie yei:",{"text":"“Ɛfiri nkaebɔ a ɛdi ɛkan no, menkasaa kɔkoam;","poem":1},{"text":"ɛberɛ biara a ɛbɛsi no, na mewɔ hɔ.”","poem":2},{"lineBreak":true},{"text":"Na afei Asafo Awurade","poem":1},{"text":"de ne Honhom asoma me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yei ne deɛ Awurade seɛ,","poem":1},{"text":"mo gyefoɔ, Israel Kronkronni no:","poem":2},{"text":"“Mene Awurade mo Onyankopɔn,","poem":1},{"text":"deɛ ɔkyerɛ mo deɛ ɛyɛ ma mo,","poem":2},{"lineBreak":true},{"text":"na ɔkyerɛ mo ɛkwan a ɛsɛ sɛ mofa soɔ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sɛ modii mʼahyɛdeɛ so a,","poem":1},{"text":"anka mo asomdwoeɛ ayɛ sɛ asubɔnten,","poem":2},{"lineBreak":true},{"text":"na mo tenenee ayɛ sɛ ɛpo asorɔkye.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anka mo asefoɔ ayɛ sɛ anwea,","poem":1},{"text":"na mo mma ayɛ sɛ nʼaboseaa a wɔntumi nkane;","poem":2},{"text":"wɔn din rempepa da.","poem":1},{"text":"Wɔrensɛe mfiri mʼanim.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Momfiri Babilonia,","poem":1},{"text":"monnwane mfiri Babiloniafoɔ nkyɛn!","poem":2},{"text":"Momfa osebɔ nteam mmɔ nkaeɛ","poem":1},{"text":"na mo mpae mu nka yei.","poem":2},{"text":"Momfa nkɔ nsase ano;","poem":1},{"text":"monka sɛ, “Awurade abɛgye ne ɔsomfoɔ Yakob.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Osukɔm anne wɔn ɛberɛ a ɔdii wɔn anim, wɔ anweatam ahodoɔ so no,","poem":1},{"text":"ɔmaa nsuo firi ɔbotan mu ba maa wɔn;","poem":2},{"lineBreak":true},{"text":"ɔpaee ɔbotan no mu, maa nsuo tue firii mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Asomdwoeɛ nni hɔ mma amumuyɛfoɔ.” Sei na Awurade seɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}