{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Osukɔm Ho Ɔfrɛ"]},{"type":"verse","number":1,"content":[{"text":"“Mommra, mo a osukɔm de mo nyinaa,","poem":1},{"text":"mommra nsuo no ho;","poem":2},{"text":"na mo a monni sika,","poem":1},{"text":"mommra mmɛtɔ na monni!","poem":2},{"text":"Mommra mmɛtɔ nsã ne nufosuo","poem":1},{"text":"a monntua hwee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Adɛn enti na mosɛe sika wɔ deɛ ɛnyɛ aduane ho","poem":1},{"text":"ne mo ahoɔden wɔ deɛ ɛmmee ho?","poem":2},{"text":"Montie, montie me na monni deɛ ɛyɛ,","poem":1},{"text":"na mo kra ani bɛgye nnepa a ɛwɔ akatua pa ho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monyɛ aso, na mommra me nkyɛn;","poem":1},{"text":"montie me, na mo kra anya nkwa.","poem":2},{"text":"Me ne mo bɛyɛ apam a ɛte hɔ daa,","poem":1},{"text":"me dɔ a ɛtoɔ ntwa da a mede hyɛɛ Dawid bɔ no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hwɛ, mede no ayɛ adansedie ama nnipa no,","poem":1},{"text":"wɔn ɔkandifoɔ ne ɔsahene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ampa ara mobɛfrɛ aman a monnim wɔn,","poem":1},{"text":"na aman a wonnim mo no bɛyɛ ntɛm aba mo nkyɛn,","poem":2},{"text":"Awurade, mo Onyankopɔn enti,","poem":1},{"text":"Israel Ɔkronkronni no,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ wahyɛ mo animuonyam.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Monhwehwɛ Awurade ɛberɛ a mobɛhunu no.","poem":1},{"text":"Momfrɛ no ɛberɛ a ɔbɛn.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ma omumuyɛfoɔ ntwe ne ho mfiri nʼakwan ho","poem":1},{"text":"na ɔbɔnefoɔ nso mfiri ne nsusuiɛ ho.","poem":2},{"text":"Ma ɔnnane nkɔ Awurade nkyɛn, na ɔbɛhunu no mmɔbɔ,","poem":1},{"text":"ɔnnane nkɔ yɛn Onyankopɔn nkyɛn, na ɔde ne ho bɛkyɛ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Na mʼadwene nnyɛ mo adwene,","poem":1},{"text":"na mo akwan nso nnyɛ mʼakwan,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Sɛdeɛ ɔsoro korɔn sene asase no,","poem":1},{"text":"saa ara na mʼakwan korɔn sene mo akwan,","poem":2},{"lineBreak":true},{"text":"na mʼadwene nso korɔn sene mo adwene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Osuo ne sukyerɛmma","poem":1},{"text":"tɔ firi soro gu fam,","poem":2},{"text":"na ɛnsane nkɔ hɔ bio","poem":1},{"text":"gye sɛ afɔ asase","poem":2},{"text":"ama afifideɛ ɛgu nhwiren,","poem":1},{"text":"sɛdeɛ ɛbɛso aba ama ogufoɔ na aduane nso aba ama deɛ ɔdie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saa ara na mʼasɛm a ɛfiri mʼanum teɛ:","poem":1},{"text":"Ɛrensane mma me nkyɛn kwa.","poem":2},{"text":"Mmom ɛbɛyɛ deɛ mepɛ","poem":1},{"text":"na awie botaeɛ a ɛno enti mesomaa no.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mode ahosɛpɛ bɛpue","poem":1},{"text":"na wɔagya mo kwan asomdwoeɛ mu;","poem":2},{"text":"mmepɔ ne nkokoɔ","poem":1},{"text":"bɛto nnwom wɔ mo anim,","poem":2},{"text":"na mfuo so nnua nyinaa","poem":1},{"text":"bɛbɔ wɔn nsam.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nkyɛkyerɛ ananmu, pepeaa bɛfifiri,","poem":1},{"text":"na nnɛnkyɛnse ananmu, ohwam dua bɛfifiri.","poem":2},{"text":"Yei bɛyɛ deɛ ɛhyɛ Awurade animuonyam,","poem":1},{"text":"ɛbɛyɛ daapem nsɛnkyerɛnneɛ,","poem":2},{"lineBreak":true},{"text":"a ɛrentwam da.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}