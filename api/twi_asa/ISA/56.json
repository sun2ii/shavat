{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Afoforɔ Nkwagyeɛ"]},{"type":"verse","number":1,"content":["Yei ne deɛ Awurade seɛ:",{"text":"“Monkɔ so mmu atɛntenenee","poem":1},{"text":"na monyɛ deɛ ɛyɛ,","poem":2},{"text":"ɛfiri sɛ me nkwagyeɛ abɛn","poem":1},{"text":"na ɛrenkyɛre me tenenee bɛda adi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nhyira nka onipa a ɔyɛ yeinom,","poem":1},{"text":"onipa a ɔkura mu denden:","poem":2},{"text":"deɛ ɔkae Homeda na ɔyɛ no kronkron,","poem":1},{"text":"na ɔkame ne ho firi bɔneyɛ ho.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mma ɔnanani a ɔde ne ho ama Awurade nka sɛ,","poem":1},{"text":"“Ampa ara Awurade renkane me mfra ne nkurɔfoɔ mu.”","poem":2},{"text":"Na opiani biara nso nwiinwii sɛ,","poem":1},{"text":"“Meyɛ duawuiɛ.”","poem":2}]},{"type":"verse","number":4,"content":["Sei na Awurade seɛ,",{"text":"“Apiafoɔ a wɔkae me home nna,","poem":2},{"text":"wɔn a wɔyɛ deɛ ɛsɔ mʼani","poem":1},{"text":"na wɔkura mʼapam mu denden,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mɛma wɔn, wɔ mʼasɔredan ne ɛho afasuo no mu,","poem":1},{"text":"nkaedeɛ ne edin a","poem":2},{"lineBreak":true},{"text":"ɛkyɛn mmammarima ne mmammaa;","poem":2},{"text":"mɛma wɔn edin a ɛbɛtena hɔ afebɔɔ,","poem":1},{"text":"edin a ɛrentwam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na ananafoɔ a wɔde wɔn ho ama Awurade","poem":1},{"text":"sɛ wɔbɛsom no,","poem":2},{"text":"sɛ wɔbɛdɔ Awurade din,","poem":1},{"text":"na wɔasɔre no,","poem":2},{"text":"wɔn a wɔkae Homeda na wɔyɛ no kronkron nyinaa,","poem":1},{"text":"na wɔkura mʼapam mu denden;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"yeinom na mede wɔn bɛba me bepɔ kronkron no so","poem":1},{"text":"na mama wɔn anigyeɛ wɔ me mpaeɛbɔ efie.","poem":2},{"text":"Wɔn ɔhyeɛ afɔrebɔdeɛ ne afɔrebɔ ahodoɔ no,","poem":1},{"text":"mɛgye wɔ mʼafɔrebukyia so;","poem":2},{"text":"na wɔbɛfrɛ me fie beaeɛ a","poem":1},{"text":"aman nyinaa bɔ mpaeɛ.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Otumfoɔ Awurade,","poem":1},{"text":"deɛ ɔboaboa Israel atukɔfoɔ ano no ka sɛ:","poem":2},{"text":"“Mɛkɔ so aboaboa afoforɔ ano aka wɔn ho","poem":1},{"text":"aka wɔn a maboa wɔn ano dada no ho.”","poem":2}]},{"type":"heading","content":["Onyankopɔn Soboɔ A Ɛtia Amumuyɛfoɔ"]},{"type":"verse","number":9,"content":[{"text":"Mommra, mo wiram mmoadoma nyinaa,","poem":1},{"text":"mommɛdidi, mo kwaeɛm mmoa nyinaa!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Israel awɛmfoɔ yɛ anifirafoɔ,","poem":1},{"text":"wɔn mu biara nni nimdeɛ;","poem":2},{"text":"wɔn nyinaa yɛ nkraman mum,","poem":1},{"text":"wɔntumi mmobɔ mu;","poem":2},{"text":"wɔdeda hɔ na wɔsoso daeɛ,","poem":1},{"text":"nna yɛ wɔn dɛ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔyɛ nkraman a wɔpɛ aduane yie;","poem":1},{"text":"wɔnnidi mmee da.","poem":2},{"text":"Wɔyɛ nnwanhwɛfoɔ a wɔnni nteaseɛ;","poem":1},{"text":"wɔn nyinaa fa wɔn ɛkwan,","poem":2},{"lineBreak":true},{"text":"obiara pɛ nʼankasa mfasoɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Mommra,” obiara team sɛ, “momma me nsã!","poem":1},{"text":"Momma yɛnnom nsaden mmoro!","poem":2},{"text":"Na ɔkyena bɛyɛ sɛ ɛnnɛ,","poem":1},{"text":"ebia ɛbɛsene ɛnnɛ koraa.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}