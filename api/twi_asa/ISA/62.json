{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Sion Edin Foforɔ"]},{"type":"verse","number":1,"content":[{"text":"Sion enti, merenyɛ komm,","poem":1},{"text":"Yerusalem enti, merenyɛ dinn,","poem":2},{"text":"kɔsi sɛ ne tenenee bɛhyerɛn sɛ adekyeɛ,","poem":1},{"text":"na ne nkwagyeɛ adɛre sɛ ogyatɛn.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amanaman no bɛhunu wo tenenee,","poem":1},{"text":"na ahemfo nyinaa ahunu wo animuonyam;","poem":2},{"text":"wɔbɛfrɛ wo din foforɔ","poem":1},{"text":"a Awurade de bɛto wo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wobɛyɛ animuonyam ahenkyɛ wɔ Awurade nsam,","poem":1},{"text":"ne adehyeɛ abɔtiten wɔ wo Onyankopɔn nsam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔremfrɛ wo atugya bio,","poem":1},{"text":"anaa wʼasase sɛ amanfo.","poem":2},{"text":"Na mmom wɔbɛfrɛ wo Hefsiba anaa anisɔ Kuropɔn","poem":1},{"text":"ne wʼasase sɛ Beula anaa ɔwarefoɔ","poem":2},{"text":"ɛfiri sɛ Awurade ani bɛgye wo ho,","poem":1},{"text":"na ɔbɛware wʼasase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sɛdeɛ aberanteɛ ware ababaawa no,","poem":1},{"text":"saa ara na wo mmammarima bɛware wo;","poem":2},{"text":"sɛdeɛ ayeforɔkunu ani gye nʼayeforɔ ho no,","poem":1},{"text":"saa ara na wo Onyankopɔn ani bɛgye wo ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mede awɛmfoɔ agyinagyina wʼafasuo so Ao, Yerusalem;","poem":1},{"text":"wɔremmua wɔn ano awia anaa anadwo.","poem":2},{"text":"Mo a musu frɛ Awurade no,","poem":1},{"text":"monnhome koraa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"na mommma ɔnnye nʼahome kɔsi sɛ ɔbɛma Yerusalem atim","poem":1},{"text":"na wayɛ no deɛ asase nyinaa bɛkamfo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade de ne basa nifa aka ntam,","poem":1},{"text":"ne basa a ɛyɛ den no sɛ,","poem":2},{"text":"“Meremfa mo ayuo","poem":1},{"text":"mma mo atamfoɔ sɛ wɔn aduane bio,","poem":2},{"text":"na ananafoɔ rennom nsã foforɔ","poem":1},{"text":"a moabrɛ ho no bio;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wɔn a wɔtwa no na wɔbɛdi","poem":1},{"text":"na wɔakamfo Awurade,","poem":2},{"text":"na wɔn a wɔboaboa bobe ano no bɛnom","poem":1},{"text":"wɔ me kronkronbea adihɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Momfa mu, momfa kuropɔn apono no mu!","poem":1},{"text":"Monsiesie kwan no mma nkurɔfoɔ no.","poem":2},{"text":"Mompae, mompae kwantempɔn no!","poem":1},{"text":"Monyiyi so aboɔ no.","poem":2},{"text":"Monsi frankaa mma amanaman no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awurade abɔ no dawuro","poem":1},{"text":"akɔsi nsase ano sɛ,","poem":2},{"text":"“Monka nkyerɛ Ɔbabaa Sion sɛ,","poem":1},{"text":"‘Hwɛ, wo Agyenkwa reba!","poem":2},{"text":"Hwɛ nʼakatua ka ne ho,","poem":1},{"text":"na nʼanamuhyɛdeɛ nso ka ne ho.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔbɛfrɛ wɔn Nnipa Kronkron,","poem":1},{"text":"wɔn a Awurade Agye Wɔn;","poem":2},{"text":"na wɔbɛfrɛ wo Deɛ Wɔrehwehwɛ Nʼakyiri Ɛkwan,","poem":1},{"text":"Kuropɔn a Ɛrenyɛ Afo Bio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}