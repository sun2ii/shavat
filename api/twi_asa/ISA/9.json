{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ISA","translationId":"twi_asa","name":"Yesaia","commonName":"Yesaia","title":"Odiyifoɔ Yesaia Nwoma","order":23,"numberOfChapters":66,"sha256":"c63702322ffdd6ab67a605118cca0d2b733016956abf6896ed5ac2f4d066085c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/twi_asa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Wɔawo Akokoaa Ama Yɛn"]},{"type":"verse","number":1,"content":["Nanso, wɔn a na wɔwɔ ahohiahia mu no, wɔrenni awerɛhoɔ bio. Kane no ɔbrɛɛ Sebulon ne Naftali nsase no ase, nanso daakye bi ɔbɛhyɛ Galilea a ɛyɛ amanamanmufoɔ ɔman na ne kwan da Yordan ne ɛpo ntam no animuonyam."]},{"type":"verse","number":2,"content":[{"text":"Nnipa a wɔnam sum mu","poem":1},{"text":"ahunu hann kɛseɛ;","poem":2},{"text":"wɔn a wɔte asase a ɛso sum kabii soɔ no,","poem":1},{"text":"hann bi apue wɔn so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woatrɛ ɔman no mu;","poem":1},{"text":"woama wɔn ani agye mmoroso;","poem":2},{"text":"wɔdi ahurisie wɔ wʼanim","poem":1},{"text":"sɛdeɛ nnipa di ahurisie otwaberɛ,","poem":2},{"text":"sɛdeɛ nnipa ho sɛpɛ wɔn","poem":1},{"text":"wɔ ɛberɛ a wɔrekyɛ afodeɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sɛdeɛ da a Midian dii nkoguo no,","poem":1},{"text":"saa ara na woadwɛre kɔnnua a ɛda wɔn so no;","poem":2},{"text":"saa ara na woayi nhyɛsofoɔ poma","poem":1},{"text":"a ɛda wɔn mmatire so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɔkofoɔ mpaboa a wɔhyɛ de kɔ sa","poem":1},{"text":"ne atadeɛ biara a mogya akeka mu no","poem":2},{"text":"wɔbɛgya agu hɔ na wɔahye.","poem":1},{"text":"Wɔde bɛsɔ ogya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛfiri sɛ, wɔawo akokoaa ama yɛn,","poem":1},{"text":"wɔama yɛn ɔbabanin,","poem":2},{"text":"na amammuo no bɛda ne mmati so.","poem":1},{"text":"Na wɔbɛfrɛ no","poem":2},{"text":"Ɔfotufoɔ Nwanwani, Otumfoɔ Onyankopɔn,","poem":1},{"text":"Daa Agya, Asomdwoeɛ Wura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nʼamammuo no nkɔsoɔ ne nʼasomdwoeɛ","poem":1},{"text":"bɛtena hɔ daa.","poem":2},{"text":"Ɔbɛtena Dawid ahennwa so","poem":1},{"text":"abu nʼahennie,","poem":2},{"text":"Ɔde atɛntenenee ne teneneeyɛ","poem":1},{"text":"bɛhyɛ aseɛ na wama atim","poem":2},{"text":"afiri saa ɛberɛ no akɔsi daa apem.","poem":1},{"text":"Asafo Awurade mmɔdemmɔ","poem":2},{"lineBreak":true},{"text":"bɛyɛ yei.","poem":2}]},{"type":"heading","content":["Awurade Abufuo A Ɛtia Israel"]},{"type":"verse","number":8,"content":[{"text":"Awurade ato Yakob nkra a ɛtia no,","poem":1},{"text":"na ɛbɛka Israel.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nnipa no nyinaa bɛhunu,","poem":1},{"text":"Efraim ne wɔn a wɔtete Samaria","poem":2},{"text":"a wɔde ahohoahoa","poem":1},{"text":"ne ahomasoɔ akoma kasa no,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Ntayaa no abubu agu fam","poem":1},{"text":"nanso yɛde aboɔ a wɔatwa bɛto bio.","poem":2},{"text":"Wɔabubu borɔdɔma nnua no","poem":1},{"text":"nanso yɛde ntweneduro bɛsi anan mu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanso Awurade ahyɛ Resin atamfoɔ den atia wɔn,","poem":1},{"text":"na ɔhyɛ wɔn atamfoɔ no nkuran.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aramfoɔ a wɔfiri apueeɛ fam,","poem":1},{"text":"Filistifoɔ a wɔfiri atɔeɛ fam,","poem":2},{"lineBreak":true},{"text":"abue wɔn anom amene Israel.","poem":2},{"lineBreak":true},{"text":"Nanso yeinom nyinaa akyiri no ne bo nnwooɛ","poem":1},{"text":"na ne nsa da so wɔ soro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nanso nnipa no nsane nkɔɔ deɛ ɔtwee wɔn aso no nkyɛn,","poem":1},{"text":"na wɔmmpɛɛ Asafo Awurade no akyiri kwan nso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti Awurade bɛtwa etire ne dua afiri Israel ho","poem":1},{"text":"na ɛberɛ ne demmire nso, ɔde da koro pɛ bɛtwa;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mpanimfoɔ ne akunini no ne etire no,","poem":1},{"text":"na atorɔ adiyifoɔ no ne dua no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔn a wɔkyerɛ nnipa yi kwan no nnkyerɛ wɔn kwan pa,","poem":1},{"text":"na wɔn a wɔnya akwankyerɛ no nso fom kwan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti Awurade ani rennye mmeranteɛ no ho,","poem":1},{"text":"na ɔrenhunu nwisiaa ne akunafoɔ mmɔbɔ","poem":2},{"text":"ɛfiri sɛ, obiara nni nyamesu na wɔyɛ amumuyɛfoɔ.","poem":1},{"text":"Ano biara ka ahuhusɛm.","poem":2},{"lineBreak":true},{"text":"Nanso yeinom nyinaa akyi no, ne bo nnwooɛ,","poem":1},{"text":"na ne nsa da so wɔ soro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nokorɛm atirimuɔden hye te sɛ ogya;","poem":1},{"text":"ɛhye nnɛnkyɛnse ne nkasɛɛ,","poem":2},{"text":"ɛde ogya to kwaeɛbirentuo mu hye no,","poem":1},{"text":"na ɛnam wisie kumɔnn mu foro kɔ soro.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asafo Awurade abufuo so enti,","poem":1},{"text":"asase no bɛkyene","poem":2},{"text":"na nnipa bɛyɛ mmabaa ama ogya no;","poem":1},{"text":"na obiara remfa ne nua ho nkyɛ no.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nifa so, wɔbɛfom aduane adi,","poem":1},{"text":"nanso ɛkɔm bɛde wɔn;","poem":2},{"text":"benkum so, wɔbɛdidi,","poem":1},{"text":"nanso wɔremmee.","poem":2},{"text":"Obiara bɛwe ne ba ɛnam.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase bɛdane Efraim na Efraim adane Manase","poem":2},{"lineBreak":true},{"text":"na wɔbɛbɔ mu atia Yuda.","poem":2},{"lineBreak":true},{"text":"Nanso yeinom nyinaa akyi no, ne bo nnwoeɛ,","poem":1},{"text":"na wama ne nsa so ayɛ krado.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}