{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Yeremia Anwiinwii"]},{"type":"verse","number":1,"content":[{"text":"Ao Awurade, sɛ mede asɛm to wʼanim ɛberɛ biara a","poem":1},{"text":"mehunu sɛ wobu atɛntenenee.","poem":2},{"text":"Ɛno enti, mepɛ sɛ mene wo bɛkasa afa wʼatɛntenenee ho:","poem":1},{"text":"Adɛn enti na amumuyɛfoɔ ɛkwan si wɔn yie?","poem":2},{"lineBreak":true},{"text":"Adɛn enti na wɔn a wɔnni gyidie ho dwo wɔn?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woadua wɔn, na wɔagye nhini;","poem":1},{"text":"wɔnyinyini na wɔso aba.","poem":2},{"text":"Wɔbɔ wo din ɛberɛ biara","poem":1},{"text":"nanso wɔn akoma mmɛn wo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanso, wonim me, Ao Awurade;","poem":1},{"text":"wohunu me, na wosɔ mʼadwene a mewɔ wɔ wo ho hwɛ.","poem":2},{"text":"Twe wɔn kɔ sɛ nnwan a wɔrekɔkum wɔn!","poem":1},{"text":"Yi wɔn si nkyɛn ma okum da!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asase no ntwɛn nkɔsi da bɛn?","poem":1},{"text":"Prama so ɛserɛ no mpo adwan.","poem":2},{"text":"Esiane sɛ wɔn a wɔte so no yɛ amumuyɛfoɔ enti","poem":1},{"text":"mmoa ne nnomaa a wɔwɔ so awuwu.","poem":2},{"text":"Na nnipa no da so ka sɛ,","poem":1},{"text":"“Ɔrenhunu deɛ ɛba yɛn so.”","poem":2}]},{"type":"heading","content":["Onyankopɔn Mmuaeɛ"]},{"type":"verse","number":5,"content":[{"text":"“Sɛ wo ne mmarima tu mmirika","poem":1},{"text":"na sɛ wɔma wo abrɛ a,","poem":2},{"lineBreak":true},{"text":"ɛbɛyɛ dɛn na wo ne apɔnkɔ asi mmirikakan?","poem":2},{"text":"Sɛ wosunti wɔ asase petee so a,","poem":1},{"text":"ɛnneɛ wobɛyɛ dɛn wɔ Yordan ho nkyɛkyerɛ mu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wo nuammarima, wʼankasa abusuafoɔ,","poem":1},{"text":"wɔn mpo ayi wo ama;","poem":2},{"lineBreak":true},{"text":"wɔteam denden tia wo.","poem":2},{"text":"Sɛ mpo wɔka wo ho asɛm pa a,","poem":1},{"text":"mfa wo ho nto wɔn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Magya me nkurɔfoɔ,","poem":1},{"text":"mato mʼagyapadeɛ agu;","poem":2},{"text":"mede deɛ medɔ noɔ no","poem":1},{"text":"bɛhyɛ nʼatamfoɔ nsa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mʼagyapadeɛ ayɛ me sɛ","poem":1},{"text":"gyata a ɔwɔ kwaeɛm.","poem":2},{"text":"Ɔbobɔ mu gu me so;","poem":1},{"text":"ɛno enti metane no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mʼagyapadeɛ ayɛ sɛ anomaa a","poem":1},{"text":"nkekaeɛ sisi ne ho a ɔkyere mmoa,","poem":2},{"lineBreak":true},{"text":"nanso, nnomaa a wɔkyere mmoa atwa ne ho ahyia resosɔ no.","poem":2},{"text":"Monkɔboaboa nkekaboa nyinaa ano.","poem":1},{"text":"Momfa wɔn mmra na wɔnkum wɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nnwanhwɛfoɔ bebree bɛsɛe me bobeturo,","poem":1},{"text":"na wɔatiatia me mfuo so;","poem":2},{"text":"wɔbɛdane me mfuo fɛfɛ no","poem":1},{"text":"ayɛ no asase wesee a ada mpan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɛbɛyɛ asase a ada mpan a","poem":1},{"text":"awo wesee na ɛda hɔ kwa wɔ mʼanim;","poem":2},{"text":"asase no nyinaa bɛda mpan","poem":1},{"text":"ɛfiri sɛ obiara nni hɔ a ɔhwɛ soɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔ nkokoɔ wesee a ɛwɔ anweatam no nyinaa so no,","poem":1},{"text":"asɛefoɔ bɛba abɛgu so bebree,","poem":2},{"text":"Awurade akofena bɛkunkum wɔn","poem":1},{"text":"afiri asase ano de akɔsi ano nohoa;","poem":2},{"lineBreak":true},{"text":"obiara remfa ne ho nni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔbɛdua atokoɔ, nso wɔbɛtwa nkasɛɛ;","poem":1},{"text":"wɔbɛbrɛ wɔn ho, nanso wɔrennya hwee.","poem":2},{"text":"Enti ma wʼani nwu wɔ wo otwa berɛ ho.","poem":1},{"text":"Awurade abufuhyeɛ nti.”","poem":2}]},{"type":"verse","number":14,"content":["Deɛ Awurade seɛ nie: “Na amumuyɛfoɔ a wɔfa agyapadeɛ a mede maa me nkurɔfoɔ Israelfoɔ no deɛ, mɛtu wɔn afiri wɔn nsase so na mɛtu Yudafie afiri wɔn mu."]},{"type":"verse","number":15,"content":["Na sɛ metu wɔn wie a, mɛhunu wɔn mmɔbɔ bio, na mede wɔn mu biara bɛba nʼagyapadeɛ ne nʼasase so."]},{"type":"verse","number":16,"content":["Na sɛ wɔsua me nkurɔfoɔ akwan yie na wɔbɔ me din ka ntam sɛ, ‘Nokorɛm sɛ Awurade te ase yi’ a, ɛwom sɛ mmerɛ bi wɔkyerɛɛ me nkurɔfoɔ sɛdeɛ wɔde Baal kaa ntam deɛ, nanso wɔn ase bɛtim wɔ me nkurɔfoɔ mu."]},{"type":"verse","number":17,"content":["Nanso, sɛ ɔman bi antie a, mɛtu nʼase, na masɛe no korakora,” Awurade na ɔseɛ."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}