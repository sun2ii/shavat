{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel Pa Onyankopɔn Akyi"]},{"type":"verse","number":1,"content":["Awurade asɛm baa me so:"]},{"type":"verse","number":2,"content":["“Kɔpae mu ka ma Yerusalem nte:",{"text":"“Mekae sɛdeɛ wode wo ho maa me wo mmabunu berɛ mu,","poem":1},{"text":"sɛdeɛ wo dɔɔ me wʼayeforɔ berɛ mu","poem":2},{"text":"na wodii mʼakyi wɔ ɛserɛ so,","poem":1},{"text":"asase a wɔnnuaa so hwee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na Israel yɛ kronkron ma Awurade,","poem":1},{"text":"ne twaberɛ mu abukan;","poem":2},{"text":"wɔn a wɔdii nʼani no, wɔbuu wɔn fɔ,","poem":1},{"text":"na amanehunu baa wɔn so,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade, seɛ nie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Montie Awurade asɛm, Ao Yakob fiefoɔ,","poem":1},{"text":"mo Israel mmusuakuo nyinaa.","poem":2}]},{"type":"verse","number":5,"content":["Yei ne deɛ Awurade seɛ:",{"text":"“Mfomsoɔ bɛn na mo agyanom hunuu wɔ me ho a","poem":1},{"text":"ɛma wɔtwee wɔn ho kɔɔ akyirikyiri sei?","poem":2},{"text":"Wɔdii ahoni a wɔn ho nni mfasoɔ akyi,","poem":1},{"text":"ma wɔn ankasa bɛyɛɛ ahuhufoɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔammisa sɛ, ‘Ɛhe na Awurade wɔ?","poem":1},{"text":"Deɛ ɔyii yɛn firii Misraim","poem":2},{"text":"na ɔde yɛn faa ɛserɛ wesee so,","poem":1},{"text":"anweatam ne amenamena asase","poem":2},{"text":"a awo na ayɛ owubɔn no.","poem":1},{"text":"Na ɛyɛ asase a obiara mfa so na obiara nte soɔ no.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mede mo bɛduaa asase bereɛ so","poem":1},{"text":"sɛ monni so nnuaba ne ɛso nnepa.","poem":2},{"text":"Nanso mobɛguu mʼasase ho fi","poem":1},{"text":"na moyɛɛ mʼagyapadeɛ akyiwadeɛ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asɔfoɔ no ammisa sɛ,","poem":1},{"text":"‘Ɛhe na Awurade wɔ?’","poem":2},{"text":"Wɔn a wɔde mmara yɛ adwuma no anhwehwɛ me;","poem":1},{"text":"ntuanofoɔ sɔre tiaa me.","poem":2},{"text":"Adiyifoɔ no de Baal hyɛɛ nkɔm,","poem":1},{"text":"na wɔdii ahoni huhuo akyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ɛno enti, merebɔ mo kwaadu bio,”","poem":1},{"text":"deɛ Awurade seɛ nie.","poem":2},{"lineBreak":true},{"text":"“Na mɛbɔ mo mma mma kwaadu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Montwa nkɔ Kitim mpoano nkɔ hwɛ,","poem":1},{"text":"monsoma nkɔ Kedar nkɔhwehwɛ mu yie;","poem":2},{"lineBreak":true},{"text":"monhwɛ sɛ biribi a ɛte sei asi wɔ hɔ:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɔman bi asesa wɔn anyame pɛn anaa?","poem":1},{"text":"Nso wɔnnyɛ anyame mpo.","poem":2},{"text":"Nanso me nkurɔfoɔ de wɔn animuonyam","poem":1},{"text":"asesa ahoni huhuo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ao ɔsorosoro, momma mo ho nnwiri mo yei ho,","poem":1},{"text":"na mo ho nwoso akomatuo mu,”","poem":2},{"lineBreak":true},{"text":"deɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Me nkurɔfoɔ ayɛ bɔne ahodoɔ mmienu:","poem":1},{"lineBreak":true},{"text":"Wɔapa mʼakyi,","poem":1},{"text":"me a meyɛ nkwa asutire no,","poem":2},{"text":"na wɔatutu wɔn ankasa nsukora amena,","poem":1},{"text":"amena a ɛho apaapae a ɛntumi nkora nsuo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israel yɛ akoa anaa ɔsomfoɔ firi awoɔ mu anaa?","poem":1},{"text":"Adɛn enti na wayɛ afodeɛ yi?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Agyata abobɔ mu;","poem":1},{"text":"wɔapɔ no so.","poem":2},{"text":"Wɔasɛe nʼasase;","poem":1},{"text":"wɔahyehye ne nkuro ayɛ no amanfo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Afei, Memfis ne Tapanhes mmarima","poem":1},{"text":"ayi wo tiri so nwi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɛnyɛ wo na woama yei aba wo so","poem":1},{"text":"sɛ wopaa Awurade wo Onyankopɔn akyi,","poem":2},{"lineBreak":true},{"text":"wɔ ɛberɛ a ɔrekyerɛ wo ɛkwan?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Afei adɛn enti na mokɔ Misraim","poem":1},{"text":"kɔnom Sihor mu nsuo?","poem":2},{"text":"Na adɛn enti na mokɔ Asiria","poem":1},{"text":"kɔnom Asubɔnten no mu nsuo?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wo amumuyɛ bɛtwe wʼaso;","poem":1},{"text":"wʼakyirisane bɛka wʼanim.","poem":2},{"text":"Enti dwene ho na hunu sɛ,","poem":1},{"text":"sɛ wopa Awurade wo Onyankopɔn akyi","poem":2},{"text":"na woannya ne ho suro a,","poem":1},{"text":"ɛyɛ bɔne ne ɔyea ma wo.”","poem":2},{"lineBreak":true},{"text":"Awurade, Asafo Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mmerɛ bi atwam, wobubuu wo kɔnnua mu,","poem":1},{"text":"na wotetee wo nkɔnsɔnkɔnsɔn mu;","poem":2},{"text":"na wokaa sɛ, ‘Merensom wo!’","poem":1},{"text":"Nokorɛm, wɔ kokoɔ biara so","poem":2},{"text":"ne dua biara a adendan ase","poem":1},{"text":"na wotena bɔɔ adwaman.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Meduaa wo sɛ bobe amapa","poem":1},{"text":"a ɛfiri bobe ase a ɛyɛ pa ara mu.","poem":2},{"text":"Na ɛyɛɛ dɛn na wodanee wʼakyi kyerɛɛ me","poem":1},{"text":"bɛyɛɛ bobe a anyini asɛeɛ wɔ wura mu yi?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sɛ wode soda","poem":1},{"text":"ne samina bebree dware mpo a,","poem":2},{"text":"wʼafɔdie nkekaawa da so wɔ hɔ ara,”","poem":1},{"text":"sɛdeɛ Otumfoɔ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ɛbɛyɛ dɛn na woaka sɛ, ‘Meho nguu fi;","poem":1},{"text":"mennii Baalnom akyi’?","poem":2},{"text":"Hwɛ sɛdeɛ woyɛɛ wo ho wɔ bɔnhwa no mu;","poem":1},{"text":"dwene deɛ woayɛ no ho.","poem":2},{"text":"Woyɛ yoma bereɛ hoɔharefoɔ","poem":1},{"text":"a wotu mmirika kɔ ha ba ha,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"wiram afunumu a anweatam so tena akokwa no,","poem":1},{"text":"ɔhuahua ɛberɛ a ɔpɛ sɛ onini hyia no.","poem":2},{"lineBreak":true},{"text":"Sɛ nʼakɔnnɔ no ano yɛ den a hwan na ɔbɛsianka no?","poem":2},{"text":"Anini biara a wɔtaa no no nha wɔn ho bebree;","poem":1},{"text":"ɛduru ɛberɛ a wɔhyia no a, wɔbɛnya no.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ntu mmirika kɔsi sɛ wobɛyi wo mpaboa","poem":1},{"text":"na wo mene mu bɛwe.","poem":2},{"text":"Nanso wokaa sɛ, ‘Ɛho nni mfasoɔ!","poem":1},{"text":"Mepɛ ananafoɔ anyame,","poem":2},{"lineBreak":true},{"text":"na ɛsɛ sɛ medi wɔn akyi.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Sɛdeɛ wɔkyere ɔkorɔmfoɔ a wɔgu nʼanim ase no,","poem":1},{"text":"saa na wɔagu Israel efie anim ase,","poem":2},{"text":"wɔn ankasa, wɔn ahemfo ne wɔn adwumayɛfoɔ,","poem":1},{"text":"wɔn asɔfoɔ ne wɔn adiyifoɔ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wɔka kyerɛ dua sɛ, ‘Woyɛ mʼagya,’","poem":1},{"text":"ne ɛboɔ sɛ, ‘Wo na wowoo me.’","poem":2},{"text":"Wɔadane wɔn akyi akyerɛ me","poem":1},{"text":"na ɛnyɛ wɔn anim;","poem":2},{"text":"nanso sɛ amanehunu bi ba wɔn so a, wɔka sɛ,","poem":1},{"text":"‘Bra bɛgye yɛn!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Anyame a moyɛ maa mo ho no wɔ he?","poem":1},{"lineBreak":true},{"text":"Momma wɔmmra sɛ wobɛtu agye mo","poem":1},{"text":"ɛberɛ a mowɔ amanehunu mu!","poem":2},{"text":"Ɛfiri sɛ mowɔ anyame bebree","poem":1},{"text":"te sɛ deɛ mowɔ nkuro bebree no, Ao Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Adɛn enti na mobɔ me soboɔ?","poem":1},{"text":"Mo nyinaa ayɛ dɔm atia me,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Metwee mo nkurɔfoɔ aso kwa;","poem":1},{"text":"wɔamfa me ntenesoɔ.","poem":2},{"text":"Wʼakofena akunkum wʼadiyifoɔ","poem":1},{"text":"te sɛ gyata a nʼani abereɛ.","poem":2}]},{"type":"verse","number":31,"content":["“Mo nnɛmmafoɔ, monnwene Awurade asɛm ho:",{"text":"“Mayɛ sɛ anweatam ama Israel anaa?","poem":1},{"text":"Anaasɛ asase a ɛso aduru sum kabii anaa?","poem":2},{"text":"Adɛn enti na me nkurɔfoɔ ka sɛ, ‘Yɛwɔ ho ɛkwan sɛ yɛkyinkyin;","poem":1},{"text":"yɛremma wo nkyɛn bio.’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ɔbaabunu werɛ firi ne mpompranneɛ,","poem":1},{"text":"ayeforɔyere werɛ bɛfiri nʼahyehyɛdeɛ anaa?","poem":2},{"text":"Nanso me nkurɔfoɔ werɛ afiri me,","poem":1},{"text":"nna a wɔntumi nkan.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hwɛ nyansa a mowɔ de pɛ mo adɔfoɔ!","poem":1},{"text":"Mmaa a wɔnsɛ hwee koraa tumi sua mo akwan.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mo aduradeɛ mu, nnipa hunu","poem":1},{"text":"ahiafoɔ a wɔdi bem mogya,","poem":2},{"lineBreak":true},{"text":"nanso moankyere wɔn sɛ wɔrebubu akɔ mo dan mu.","poem":2},{"text":"Yeinom nyinaa akyi","poem":1}]},{"type":"verse","number":35,"content":[{"text":"woka sɛ, ‘Medi bem;","poem":2},{"lineBreak":true},{"text":"ne bo mfuu me.’","poem":2},{"text":"Nanso mɛbu wo atɛn","poem":1},{"text":"ɛfiri sɛ wo ka sɛ, ‘Menyɛɛ bɔne biara.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Adɛn enti na wokyinkyini se,","poem":1},{"text":"sesa wʼakwan?","poem":2},{"text":"Misraim bɛdi wo hwammɔ","poem":1},{"text":"sɛdeɛ Asiria yɛeɛ no.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Afei wobɛfiri saa beaeɛ hɔ","poem":1},{"text":"a wo nsa gu wo tiri so.","poem":2},{"text":"Ɛfiri sɛ Awurade apo wɔn a wode wo ho too wɔn so no;","poem":1},{"text":"wɔremmoa wo.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}