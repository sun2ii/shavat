{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Sɛ wobɛsane wʼakyi a Ao, Israel,","poem":1},{"text":"sane bra me nkyɛn,”","poem":2},{"lineBreak":true},{"text":"sei na Awurade seɛ.","poem":2},{"text":"“Sɛ woyi wʼahoni a ɛyɛ akyiwadeɛ firi mʼani so","poem":1},{"text":"na sɛ woammane bio,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na sɛ, nokorɛ, pɛyɛ ne tenenee mu","poem":1},{"text":"woka ntam sɛ, ‘Sɛ Awurade te ase yi,’ a","poem":2},{"text":"afei mobɛyɛ nhyira ama aman no","poem":1},{"text":"na ne mu na wɔbɛnya animuonyam.”","poem":2}]},{"type":"verse","number":3,"content":["Yei ne asɛm a Awurade ka kyerɛ Yuda mmarima ne Yerusalem:",{"text":"“Monsiesie mo asase a wɔmfuntum da","poem":1},{"text":"na monnnua wɔ nkasɛɛ mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Montwitwa mo ho twetia mma Awurade","poem":1},{"text":"montwitwa mo akoma twetia,","poem":2},{"lineBreak":true},{"text":"mo Yuda mmarima ne Yerusalemfoɔ,","poem":2},{"text":"anyɛ saa a mʼabufuhyeɛ bɛsɔre na adɛre sɛ ogya.","poem":1},{"text":"Mo bɔne a moayɛ enti,","poem":2},{"lineBreak":true},{"text":"ɛbɛhye a obiara rennum.”","poem":2}]},{"type":"heading","content":["Amanehunu A Ɛfiri Atifi Fam"]},{"type":"verse","number":5,"content":[{"text":"“Bɔ nkaeɛ wɔ Yuda na pae mu ka wɔ Yerusalem sɛ,","poem":1},{"text":"‘Hyɛn totorobɛnto no wɔ asase no nyinaa so!’","poem":2},{"text":"Team denden sɛ:","poem":1},{"text":"‘Mommoaboa mo ho ano!","poem":2},{"lineBreak":true},{"text":"Momma yɛn nnwane nkɔ kuropɔn a wɔabɔ ho ban no so!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Momma frankaa so na monkɔ Sion","poem":1},{"text":"monnwane nkɔbɔ mo ho adwaa!","poem":2},{"text":"Ɛfiri sɛ mede amanehunu firi atifi fam reba,","poem":1},{"text":"ɔsɛeɛ a ɛyɛ hu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gyata bi afiri ne tu mu;","poem":1},{"text":"ɔbɔaman bi asi mu.","poem":2},{"text":"Wafiri ne tenabea","poem":1},{"text":"sɛ ɔrebɛsɛe wʼasase.","poem":2},{"text":"Wo nkuro bɛbubu","poem":1},{"text":"na ada mpan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti fira ayitoma,","poem":1},{"text":"di awerɛhoɔ na twa adwo,","poem":2},{"text":"ɛfiri sɛ Awurade abufuhyeɛ no","poem":1},{"text":"nnane mfirii yɛn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Saa ɛda no,” Awurade na ɔseɛ,","poem":1},{"text":"“ɔhene no ne adwumayɛfoɔ no bɛbɔ hu,","poem":2},{"text":"asɔfoɔ no bo bɛtu,","poem":1},{"text":"na adiyifoɔ no ho bɛdwiri wɔn.”","poem":2}]},{"type":"verse","number":10,"content":["Afei, mekaa sɛ, “Aa, Otumfoɔ Awurade, woadaadaa nnipa yi ne Yerusalem. Wokaa sɛ, ‘Mobɛnya asomdwoeɛ,’ wɔ ɛberɛ a akofena da yɛn mene mu.”"]},{"type":"verse","number":11,"content":["Saa ɛberɛ no wɔbɛka akyerɛ nnipa yi ne Yerusalem sɛ, “Mframa a emu yɛ hyeɛ bɛbɔ afiri nkokoɔ wesee a ɛwɔ anweatam so aba me nkurɔfoɔ so, ɛnyɛ deɛ ɛpɔ ho anaa ɛhuhu soɔ;"]},{"type":"verse","number":12,"content":["mframa a ano yɛ den boro saa no firi me nkyɛn. Afei, mepae mu ka mʼatemmuo a ɛtia wɔn.”"]},{"type":"verse","number":13,"content":[{"text":"Hwɛ! Ɔreba sɛ omununkum,","poem":1},{"text":"ne nteaseɛnam reba sɛ, ntwahoframa,","poem":2},{"text":"nʼapɔnkɔ ho yɛ herɛ sene akɔdeɛ.","poem":1},{"text":"Yɛnnue! Yɛawu!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ao, Yerusalem, yi bɔne firi wʼakoma mu na woanya nkwa.","poem":1},{"text":"Wode adwemmɔne bɛhyɛ wo mu akɔsi da bɛn?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɛnne bi rebɔ kaseɛ firi Dan,","poem":1},{"text":"ɛrebɔ amanehunu ho dawuro firi Efraim nkokoɔ so.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Monka yei nkyerɛ aman no,","poem":1},{"text":"mommɔ no dawuro nkyerɛ Yerusalem sɛ,","poem":2},{"text":"‘Atuafoɔ dɔm firi akyirikyiri asase bi so reba,","poem":1},{"text":"wɔma ɔko nteamu so de tia Yuda nkuropɔn.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔtwa kuropɔn no ho hyia sɛ mmarima a wɔrewɛn afuo,","poem":1},{"text":"ɛfiri sɛ me nkurɔfoɔ ate me so atua,’ ”","poem":2},{"lineBreak":true},{"text":"sei na Awurade seɛ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Wʼankasa abrabɔ ne nneyɛeɛ","poem":1},{"text":"na ɛde yei aba wo so.","poem":2},{"text":"Yei yɛ wʼasotwe.","poem":1},{"text":"Ɛyɛ nwono!","poem":2},{"lineBreak":true},{"text":"Ɛwowɔ akoma!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ao mʼahoyera, mʼahoyera!","poem":1},{"text":"Mede ɔyea nukanuka me mu.","poem":2},{"text":"Ao mʼakoma ɔyeadie!","poem":1},{"text":"Mʼakoma bɔ paripari wɔ me mu,","poem":2},{"lineBreak":true},{"text":"mentumi nyɛ komm.","poem":2},{"text":"Ɛfiri sɛ, mate totorobɛnto no nnyegyeɛ;","poem":1},{"text":"mate ɔko frɛ no.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amanehunu di amanehunu akyi;","poem":1},{"text":"asase no nyinaa asɛe.","poem":2},{"text":"Wɔasɛe me ntomadan prɛko pɛ,","poem":1},{"text":"ne me hintabea mpofirim.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ɛsɛ sɛ mehwɛ ɔko frankaa no","poem":1},{"text":"na metie totorobɛnto no nnyegyeeɛ kɔsi da bɛn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Me nkurɔfoɔ yɛ nkwaseafoɔ;","poem":1},{"text":"wɔnnim me.","poem":2},{"text":"Wɔyɛ mma a wɔnni adwen;","poem":1},{"text":"wɔnte hwee ase.","poem":2},{"text":"Wɔwɔ bɔneyɛ ho nyansa;","poem":1},{"text":"na wɔnnim sɛdeɛ wɔyɛ papa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mehwɛeɛ asase no,","poem":1},{"text":"na ɛnni bɔbea na hwee nni so;","poem":2},{"text":"mehwɛɛ ɔsorosoro, na wɔn hann no nni hɔ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mehwɛeɛ mmepɔ no,","poem":1},{"text":"na wɔrewosowoso,","poem":2},{"lineBreak":true},{"text":"na nkokoɔ no nyinaa rehinhim.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mehwɛeɛ, na nnipa nni hɔ;","poem":1},{"text":"ewiem anomaa biara atu kɔ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mehwɛeɛ, na nsasebereɛ no adane anweatam","poem":1},{"text":"na ne nkuro nyinaa asɛe","poem":2},{"lineBreak":true},{"text":"wɔ Awurade anim, wɔ nʼabufuhyeɛ anim.","poem":2}]},{"type":"verse","number":27,"content":["Sei na Awurade seɛ:",{"text":"“Wɔbɛsɛe asase no nyinaa,","poem":1},{"text":"mmom merensɛe no korakora.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti asase bɛdi awerɛhoɔ","poem":1},{"text":"na ɔsorosoro bɛduru sum,","poem":2},{"text":"ɛfiri sɛ makasa na merentwe nsan.","poem":1},{"text":"Masi gyinaeɛ na mennane no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Apɔnkɔsotefoɔ ne agyantofoɔ nnyegyeeɛ","poem":1},{"text":"ma kuro biara sofoɔ dwane.","poem":2},{"text":"Ebinom kɔhyɛ nkyɛkyerɛ mu","poem":1},{"text":"ebinom foro kɔ abotan mu.","poem":2},{"text":"Nkuro no nyinaa so ada mpan;","poem":1},{"text":"na obiara nte so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ɛdeɛn na woreyɛ Ao wo a woasɛe woɔ?","poem":1},{"text":"Adɛn na wofira kɔben","poem":2},{"lineBreak":true},{"text":"de sikakɔkɔɔ agudeɛ asiesie wo ho?","poem":2},{"text":"Adɛn na wode nnuro keka wʼani?","poem":1},{"text":"Wohyehyɛ wo ho kwa.","poem":2},{"text":"Wʼadɔfoɔ bu wo animtia;","poem":1},{"text":"wɔrepɛ wo akum wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Mete osu bi te sɛ ɔbaa a awoɔ aka no,","poem":1},{"text":"mete apinisie te sɛ ɔbaa a ɔrebɔne awoɔ,","poem":2},{"text":"Ɔbabaa Sion su te sɛ deɛ nisupɔporɔ ahini no,","poem":1},{"text":"ɔtrɛ ne nsa mu na ɔka sɛ,","poem":2},{"text":"“Afei deɛ, meretɔ baha;","poem":1},{"text":"wɔde me kra ama awudifoɔ.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}