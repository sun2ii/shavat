{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Nsɛm A Ɛfa Moab Ho"]},{"type":"verse","number":1,"content":["Asɛm a ɛfa Moab ho no nie:",{"lineBreak":true},"Yei ne deɛ Awurade, Israel Onyankopɔn seɛ:",{"text":"“Nebo nnue, na wɔbɛsɛe no.","poem":1},{"text":"Wɔbɛgu Kiriataim anim ase, na wɔakye no;","poem":2},{"lineBreak":true},{"text":"wɔbɛgu aban denden no anim ase, na wɔadwiri agu fam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wɔrenkamfo Moab bio;","poem":1},{"text":"Hesbon mmarima bɛbɔ nʼasehweɛ ho pɔ;","poem":2},{"lineBreak":true},{"text":"‘Mommra, momma yɛn nkɔbɔ saa ɔman yi.’","poem":2},{"text":"Mo nso, Madmen mmarima mobɛka mo ano atom;","poem":1},{"text":"akofena no bɛtaa mo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Montie osu a ɛfiri Horonaim,","poem":1},{"text":"adesɛeɛ ne ɔsɛeɛ ho su.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔbɛbɔ Moab:","poem":1},{"text":"na ne mma nketewa bɛteateam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔforo kɔ Luhit,","poem":1},{"text":"wɔde agyaadwotwa a emu yɛ den na ɛrekɔ;","poem":2},{"text":"ɛkwan a ɛkɔ Horonaim so no","poem":1},{"text":"wɔte ahoyera mu agyaadwotwa wɔ adesɛeɛ no ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Monnwane! Montu mmirika mpere mo nkwa.","poem":1},{"text":"Momfa mo ho nsie sɛ wira wɔ anweatam so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Esiane sɛ mode mo ho to mo nneyɛɛ ne mo ahonya so enti,","poem":1},{"text":"mo nso wɔbɛfa mo nnommum,","poem":2},{"text":"na Kemos bɛkɔ nnommumfa mu,","poem":1},{"text":"ɔne nʼasɔfoɔ ne adwumayɛfoɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔsɛefoɔ no bɛtu kuro biara so sa,","poem":1},{"text":"na emu biara renya ne ho ntete.","poem":2},{"text":"Wɔbɛsɛe bɔnhwa no","poem":1},{"text":"na wɔasɛe mmepɔ mpampam a ɛyɛ tamaa no,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ Awurade akasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momfa nkyene nhyɛ Moab,","poem":1},{"text":"ɛfiri sɛ wɔrebɛsɛe no;","poem":2},{"text":"ne nkuro bɛda mpan a","poem":1},{"text":"obiara rentena soɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nnome nka deɛ ɔtwentwɛnee ne nan ase wɔ Awurade adwumayɛ ho!","poem":1},{"text":"Nnome nka deɛ ɔmmfa nʼakofena nhwie mogya nguo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moab atena ase asomdwoeɛ mu firi ne mmerante ɛberɛ mu,","poem":1},{"text":"te sɛ nsã ase puo a ataa dinn","poem":2},{"text":"a wɔnnhwie mfirii ahina mu nkɔguu ahina foforɔ mu da;","poem":1},{"text":"saa ara na Moab nso nkɔɔ nnommumfa mu da.","poem":2},{"text":"Enti ɔte sɛ deɛ ɔte ara,","poem":1},{"text":"na ne ho hwa nsesa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso, nna bi reba,”","poem":1},{"text":"Awurade na ɔseɛ,","poem":2},{"text":"“a mɛsoma mmarima a wɔhwie nsã firi ahina mu,","poem":1},{"text":"na wɔbɛhwie no agu;","poem":2},{"text":"wɔbɛma nʼahina mu ayɛ hwee","poem":1},{"text":"na wɔabobɔ ne nkuruwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei Kemos ho bɛyɛ Moab aniwu,","poem":1},{"text":"sɛdeɛ Israel efie anim guu ase","poem":2},{"lineBreak":true},{"text":"ɛberɛ a wɔde wɔn ho too Bet-El soɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ɛyɛ dɛn na wotumi ka sɛ, ‘Yɛyɛ nnɔmmarima,","poem":1},{"text":"mmarima akokoɔdurufoɔ wɔ ɔsa mu’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wɔbɛsɛe Moab na wɔatu ne nkuro so sa;","poem":1},{"text":"ne mmeranteɛ a wɔte apɔ no, wɔbɛkunkum wɔn,”","poem":2},{"lineBreak":true},{"text":"deɛ Ɔhene a wɔfrɛ no Asafo Awurade no seɛ nie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Moab asehweɛ abɛn;","poem":1},{"text":"nʼamanehunu bɛba ntɛm.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Monsu no, mo a motete ne ho nyinaa,","poem":1},{"text":"ne mo a monim ne din nyinaa;","poem":2},{"text":"monka sɛ, ‘Ɛyɛɛ dɛn na wɔabubu ahempoma a ɛyɛ den yi?","poem":1},{"text":"Ɛyɛɛ dɛn na wɔabu animuonyam poma fɛfɛ yi mu?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Firi wʼanimuonyam mu,","poem":1},{"text":"na bɛtena asase wesee no so,","poem":2},{"text":"wo a wote Ɔbabaa Dibon mu,","poem":1},{"text":"ɛfiri sɛ deɛ ɔsɛe Moab no","poem":2},{"text":"bɛtu aba wo so;","poem":1},{"text":"abɛsɛe wo nkuropɔn a ɛwɔ banbɔ no.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gyina kwankyɛn na hwɛ,","poem":1},{"text":"wo a wote Aroer.","poem":2},{"text":"Bisa ɔbarima a ɔredwane no ne ɔbaa a ɔrefiri mu afi,","poem":1},{"text":"bisa wɔn sɛ, ‘Asɛm bɛn na asie?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moab anim agu ase, ɛfiri sɛ wɔabubu no pasaa;","poem":1},{"text":"montwa adwo na monteateam!","poem":2},{"text":"Mommɔ dawuro wɔ Arnon ho sɛ","poem":1},{"text":"wɔasɛe Moab.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Atemmuo aba bepɔ tamaa so","poem":1},{"text":"wɔ Holon, Yahas ne Mefaat,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dibon ne Nebo ne Bet-Diblataim","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ne Kiriataim ne Bet Gamul ne Bet Meon","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ne Keriot ne Bosra","poem":2},{"lineBreak":true},{"text":"wɔ Moab nkuro nyinaa, deɛ ɛwɔ akyirikyiri ne deɛ ɛbɛn.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wɔatwa Moab abɛn;","poem":1},{"text":"na ne basa abu,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Momma no mmoro nsã,","poem":1},{"text":"ɛfiri sɛ wabu Awurade animtia.","poem":2},{"text":"Momma Moab nyantam wɔ ne feɛ mu;","poem":1},{"text":"momma no nyɛ fɛdideɛ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɛnyɛ Israel na na ɔyɛ mo fɛdideɛ?","poem":1},{"text":"Wɔkyeree no akorɔmfoɔ mu anaa,","poem":2},{"text":"a enti mowoso mo ti animtiabuo so","poem":1},{"text":"ɛberɛ biara a mobɛka ne ho asɛm?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Monfifiri mo nkuro so nkɔtena abotan mu,","poem":1},{"text":"mo a motete Moab.","poem":2},{"text":"Monyɛ sɛ aborɔnoma a ɔyɛ ne pirebuo","poem":1},{"text":"wɔ ɔbodan ano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Yɛate Moab ahantan no","poem":1},{"text":"nʼahomasoɔ ne gye a ɔgye ne ho di mmorosoɔ;","poem":2},{"text":"nʼahantan ne nʼahomasoɔ,","poem":1},{"text":"ne nʼakoma mu ahohoahoa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Menim nʼasoɔden nanso ɛyɛ ɔkwa,”","poem":1},{"text":"Awurade na ɔseɛ,","poem":2},{"lineBreak":true},{"text":"“na nʼahohoahoa mfa hwee mma.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Enti metwa adwo ma Moab,","poem":1},{"lineBreak":true},{"text":"mesu team ma Moabfoɔ nyinaa,","poem":1},{"text":"medi awerɛhoɔ ma nnipa a wɔwɔ Kir Hereset.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mesu ma mo sɛdeɛ Yaser su,","poem":1},{"text":"Ao Sibma bobe.","poem":2},{"text":"Mo mman dendane kɔɔ ɛpo ho pɛɛ;","poem":1},{"text":"kɔduruu Yaser ɛpo ho.","poem":2},{"text":"Ɔsɛefoɔ no abɛgu","poem":1},{"text":"mo nnuaba a abereɛ ne mo bobe no so.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ahosɛpɛ ne anigyeɛ atu afiri","poem":1},{"text":"Moab nnuaba nturo ne mfuo so.","poem":2},{"text":"Matwa nsã a ɛtene firi nsakyimena no so;","poem":1},{"text":"obiara mmfa ahosɛpɛ ntiatia bobe no so.","poem":2},{"text":"Ɛwom sɛ nteateam wɔ hɔ deɛ,","poem":1},{"text":"nanso ɛnyɛ ahosɛpɛ nteateam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Wɔn su ano den gyegye firi","poem":1},{"text":"Hesbon de kɔsi Eleale ne Yahas,","poem":2},{"text":"firi Soar de kɔsi Horonaim ne Eglat Selisiya.","poem":1},{"text":"Mpo, nsuo a ɛwɔ Nimrim no awe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Moab hɔ no,","poem":1},{"text":"mede sorɔnsorɔmmea afɔrebɔ ne nnuhwam","poem":2},{"text":"a wɔhye ma wɔn anyame no bɛba awieeɛ,”","poem":1},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Enti mʼakoma su sɛ atɛntɛbɛn ma Moab;","poem":1},{"text":"esu sɛ atɛntɛbɛn ma nnipa a wɔwɔ Kir Hereset.","poem":2},{"lineBreak":true},{"text":"Ahonyadeɛ a wɔpɛeɛ no kɔ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wɔabɔ etire biara tikwa","poem":1},{"text":"na wɔayi abɔgyesɛ biara;","poem":2},{"text":"nsa nyinaa ho ayɛ akamakam","poem":1},{"text":"na ayitoma sisi obiara asene.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Adan a ɛwɔ Moab nyinaa atifi","poem":1},{"text":"ne ɔmanfoɔ adwaberem nyinaa,","poem":2},{"text":"biribiara nni hɔ sɛ awerɛhoɔ,","poem":1},{"text":"ɛfiri sɛ mabubu Moab","poem":2},{"lineBreak":true},{"text":"ayɛ no sɛ ahina a obiara mpɛ,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Hwɛ sɛdeɛ wabubuo afa! Hwɛ sɛdeɛ wɔretwa adwoɔ!","poem":1},{"text":"Na hwɛ sɛdeɛ Moab de aniwuo dane nʼakyi!","poem":2},{"text":"Moab ayɛ fɛdideɛ","poem":1},{"text":"ne ahodwiredeɛ ama wɔn a wɔatwa ne ho ahyia nyinaa.”","poem":2}]},{"type":"verse","number":40,"content":["Yei ne deɛ Awurade seɛ:",{"text":"“Monhwɛ! Ɔkɔdeɛ reto hoo aba fam.","poem":1},{"text":"Watrɛ ne ntaban mu wɔ Moab so.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wɔbɛfa Keriot nnommum","poem":1},{"text":"na wafa nʼaban denden no.","poem":2},{"text":"Saa ɛda no Moab nnɔmmarima akoma","poem":1},{"text":"bɛtu sɛ ɔbaa a ɔrekyem awoɔ so.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wɔbɛsɛe Moab na ɛrenyɛ ɔman bio,","poem":1},{"text":"ɛfiri sɛ, ɔbuu Awurade animtia.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ehu, nkomena ne mfidie retwɛn mo,","poem":1},{"text":"Ao Moabfoɔ,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Deɛ ɔdwane deɛ ɛyɛ hu no","poem":1},{"text":"bɛtɔ nkomena mu,","poem":2},{"text":"deɛ ɔbɛforo afiri nkomena no mu no,","poem":1},{"text":"afidie bɛyi no;","poem":2},{"text":"na mede Moab asotwe afe no bɛba ne so,”","poem":1},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Hesbon nwunu ase","poem":1},{"text":"na adwanefoɔ no gyinagyina a wɔnni mmoa biara,","poem":2},{"text":"ɛfiri sɛ ogya bi atu afiri Hesbon;","poem":1},{"text":"ɛgyadɛreɛ bi firi Sihon mfimfini;","poem":2},{"text":"ɛhye Moabfoɔ moma,","poem":1},{"text":"ne ahohoahoafoɔ a wɔn ano yɛ den no ti kwankoraa.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Nnome nka wo Ao, Moab!","poem":1},{"text":"Wɔasɛe Kemos nkurɔfoɔ no;","poem":2},{"text":"wɔde wo mmammarima kɔ nnommumfa mu","poem":1},{"text":"na wo mmammaa nso kɔ nkoasom mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Nanso mede Moab adenya bɛsane ama no","poem":1},{"text":"wɔ nna a ɛbɛba no mu,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2},"Moab atemmuo no awieeɛ nie."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}