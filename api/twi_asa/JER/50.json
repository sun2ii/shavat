{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Asɛm A Ɛfa Babilonia Ho"]},{"type":"verse","number":1,"content":["Asɛm a Awurade nam odiyifoɔ Yeremia so ka faa Babilonia ne Babiloniafoɔ asase ho nie:"]},{"type":"verse","number":2,"content":[{"text":"“Mommɔ no dawuro na mompae mu nka wɔ amanaman mu.","poem":1},{"text":"Mompagya frankaa na mompae mu nka;","poem":2},{"lineBreak":true},{"text":"na momma wɔnte sɛ,","poem":2},{"text":"‘Wɔbɛfa Babilonia;","poem":1},{"text":"wɔbɛgu Bel anim ase,","poem":2},{"lineBreak":true},{"text":"na ehu bɛhyɛ Merodak ma.","poem":2},{"text":"Wɔbɛgu ne nsɛsodeɛ anim ase","poem":1},{"text":"na ehu bɛhyɛ nʼahoni ma.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔman bi firi atifi fam bɛto ahyɛ ne so","poem":1},{"text":"na wɔbɛyɛ nʼasase amanfo.","poem":2},{"text":"Obiara rentena so;","poem":1},{"text":"nnipa ne mmoa bɛdwane afiri so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nna no mu ne saa ɛberɛ no,”","poem":1},{"text":"Awurade na ɔseɛ,","poem":2},{"text":"“Israelfoɔ ne Yudafoɔ bɛka abom","poem":1},{"text":"de nisuo akɔhwehwɛ wɔn Awurade, wɔn Onyankopɔn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔbɛbisa ɛkwan a ɛkɔ Sion","poem":1},{"text":"na wɔde wɔn ani akyerɛ hɔ.","poem":2},{"text":"Wɔbɛba de wɔn ho abɛbɔ Awurade","poem":1},{"text":"wɔ daa apam a wɔn","poem":2},{"lineBreak":true},{"text":"werɛ remfiri mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Me nkurɔfoɔ ayɛ nnwan a wɔayera;","poem":1},{"text":"wɔn nnwanhwɛfoɔ ama wɔafom ɛkwan","poem":2},{"lineBreak":true},{"text":"ma wɔkyinkyinii mmepɔ so.","poem":2},{"text":"Wɔkyinkyinii bɛpɔ ne kokoɔ so","poem":1},{"text":"na wɔn werɛ firii wɔn ankasa homebea.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obiara a ɔhunuu wɔn no tetee wɔn mu;","poem":1},{"text":"wɔn atamfoɔ kaa sɛ, ‘Yɛn nni fɔ,","poem":2},{"text":"ɛfiri sɛ wɔyɛɛ bɔne tiaa Awurade, wɔn nokorɛ didibea no,","poem":1},{"text":"Awurade wɔn agyanom anidasoɔ no.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Monnwane mfiri Babilonia;","poem":1},{"text":"momfiri Babiloniafoɔ asase so,","poem":2},{"lineBreak":true},{"text":"na monyɛ sɛ mpapo a wɔdi nnwankuo anim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɛkanyane amanaman akɛseɛ nkabom","poem":1},{"text":"afiri atifi fam asase so de wɔn abɛtia Babilonia.","poem":2},{"text":"Wɔbɛgyinagyina wɔn afa atia no,","poem":1},{"text":"wɔbɛfiri atifi fam ako afa no.","poem":2},{"text":"Wɔn agyan bɛyɛ sɛ nnɔmmarima a wɔakwadare akodie mu,","poem":1},{"text":"wɔn a wɔmmfa nsapan nsane wɔn akyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti wɔbɛfom Babilonia;","poem":1},{"text":"wɔn a wɔfom no nyinaa bɛnya afodeɛ bebree,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Esiane sɛ mo ani gye na modi ahurisie,","poem":1},{"text":"mo a mofom mʼagyapadeɛ,","poem":2},{"text":"sɛ mohurihuri anigyeɛ so te sɛ nantwiforo a ɔwɔ ɛserɛ frɔmm mu","poem":1},{"text":"na mosu te sɛ apɔnkɔnini enti,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wo maame ani bɛwu pa ara;","poem":1},{"text":"deɛ ɔwoo woɔ anim bɛgu ase.","poem":2},{"text":"Ɔbɛyɛ akumaa wɔ amanaman no mu,","poem":1},{"text":"ɛserɛ, asase wesee ne anweatam.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Awurade abufuo enti, obiara rentena hɔ","poem":1},{"text":"na ɛbɛda mpan korakora.","poem":2},{"text":"Wɔn a wɔtwam wɔ Babilonia nyinaa ho bɛdwiri wɔn na wɔadi ne ho fɛ","poem":1},{"text":"ɛsiane nʼapirakuro nyinaa enti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Monnyinagyina mo afa ntwa Babilonia ho nhyia,","poem":1},{"text":"mo a moto agyan nyinaa.","poem":2},{"text":"Monto no! Monnnya bɛmma biara,","poem":1},{"text":"ɛfiri sɛ wayɛ bɔne atia Awurade.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Monteam ntia no wɔ afanan nyinaa!","poem":1},{"text":"Ɔma ne nsa so, nʼaban denden bubu,","poem":2},{"lineBreak":true},{"text":"wɔdwiri nʼafasuo gu fam.","poem":2},{"text":"Esiane sɛ yei yɛ Awurade aweretɔ no enti,","poem":1},{"text":"montɔ ne so were;","poem":2},{"lineBreak":true},{"text":"monyɛ no sɛdeɛ wayɛ afoforɔ no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Monyi ogufoɔ mfiri Babilonia,","poem":1},{"text":"ɔne ɔtwafoɔ a ɔkura ne kantankrankyi wɔ ɔtwa berɛ mu no.","poem":2},{"text":"Esiane ɔhyɛsofoɔ no akofena enti","poem":1},{"text":"obiara nsane nkɔ ne nkurɔfoɔ mu,","poem":2},{"lineBreak":true},{"text":"obiara nnwane nkɔ nʼankasa asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Israel yɛ nnwankuo a wɔahwete","poem":1},{"text":"a agyata apam wɔn.","poem":2},{"text":"Deɛ ɔdii ɛkan tetee ne mu","poem":1},{"text":"yɛ Asiriahene;","poem":2},{"text":"na deɛ ɔdwerɛɛ ne nnompe akyire no","poem":1},{"text":"yɛ Babiloniahene Nebukadnessar.”","poem":2}]},{"type":"verse","number":18,"content":["Ɛno enti, yei ne deɛ Asafo Awurade, Israel Onyankopɔn seɛ:",{"text":"“Mɛtwe Babiloniahene ne nʼasase aso","poem":1},{"text":"sɛdeɛ metwee Asiriahene aso no.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Na mede Israel bɛsane aba nʼankasa adidibea.","poem":1},{"text":"Ɔbɛdidi wɔ Karmel ne Basan;","poem":2},{"lineBreak":true},{"text":"ɔbɛmee wɔ Efraim ne Gilead nkokoɔ so.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saa nna no ne saa ɛberɛ no,”","poem":1},{"text":"Awurade na ɔsɛ,","poem":2},{"text":"“Wɔbɛhwehwɛ Israel afɔbuo mu,","poem":1},{"text":"nanso wɔrennya bi,","poem":2},{"text":"wɔbɛhwehwɛ Yuda nnebɔne mu,","poem":1},{"lineBreak":true},{"text":"nanso wɔrenhunu bi,","poem":1},{"text":"ɛfiri sɛ, mede nkaeɛfoɔ a megyaa wɔn no bɔne bɛkyɛ wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Monto nhyɛ Merataim asase so","poem":1},{"text":"ne nnipa a wɔte Pekod.","poem":2},{"text":"Montaa wɔn, monkunkum wɔn","poem":1},{"text":"na monsɛe wɔn korakora,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2},{"lineBreak":true},{"text":"“Monyɛ biribiara a mahyɛ mo no.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ɔko mu gyegyeegye wɔ asase no so,","poem":1},{"text":"ɔsɛeɛ kɛseɛ nnyegyeɛ!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hwɛ sɛdeɛ wɔabubu na wɔabobɔ","poem":1},{"text":"asase nyinaa so asaeɛ!","poem":2},{"text":"Hwɛ sɛdeɛ Babilonia ada mpan","poem":1},{"text":"wɔ amanaman no mu!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mesum wo afidie Ao Babilonia,","poem":1},{"lineBreak":true},{"text":"na ɛyii wo ansa na worehunu;","poem":1},{"text":"wɔhunu wo kyeree wo","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ woko tiaa Awurade.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Awurade abue nʼakodeɛ akoradan","poem":1},{"text":"na wayi nʼabufuhyeɛ akodeɛ de apue,","poem":2},{"text":"ɛfiri sɛ Otumfoɔ Awurade wɔ adwuma yɛ","poem":1},{"text":"wɔ Babiloniafoɔ asase so.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Momfiri akyirikyiri mmra ne so.","poem":1},{"text":"Mommubu nʼasan no ani;","poem":2},{"lineBreak":true},{"text":"monhɔre no sie sɛ ayuo akuakuo.","poem":2},{"text":"Monsɛe no korakora","poem":1},{"text":"na monnnya no nkaeɛfoɔ biara.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Monkunkum nʼanantwinini nyinaa;","poem":1},{"text":"momfa wɔn nkɔ ma wɔnkum wɔn!","poem":2},{"text":"Musuo nka wɔn! Ɛfiri sɛ wɔn da no aduru,","poem":1},{"text":"ɛberɛ a wɔde bɛtwe wɔn aso no.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Montie akobɔfoɔ ne adwanefoɔ a wɔfiri Babilonia no","poem":1},{"text":"sɛ wɔreka wɔ Sion","poem":2},{"text":"sɛdeɛ Awurade, yɛn Onyankopɔn atɔ were","poem":1},{"text":"nʼasɔrefie ho aweretɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Momfrɛ agyantofoɔ nkɔtoa Babilonia,","poem":1},{"text":"wɔn a wɔto agyan nyinaa.","poem":2},{"text":"Montwa ne ho nhyia;","poem":1},{"text":"momma obiara nnwane.","poem":2},{"text":"Montua ne nneyɛɛ so ka;","poem":1},{"text":"monyɛ no sɛdeɛ wayɛ.","poem":2},{"text":"Ɛfiri sɛ, wabu Awurade animtia,","poem":1},{"text":"Israel kronkronni no.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Enti ne mmeranteɛ bɛtotɔ wɔ mmɔntene so;","poem":1},{"text":"wɔbɛtɔre nʼasraafoɔ nyinaa ase saa ɛda no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Hwɛ, mekyiri wo, Ao ɔhantanni.”","poem":1},{"text":"Awurade, Asafo Awurade na ɔseɛ,","poem":2},{"text":"“ɛfiri sɛ wo da no aduru","poem":1},{"text":"ɛberɛ a wɔde bɛtwe wʼaso no.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ɔhantanni no bɛsunti na wahwe ase","poem":1},{"text":"obiara rempagya no;","poem":2},{"text":"mɛto ne nkuro mu ogya","poem":1},{"text":"na ahye wɔn a atwa ne ho ahyia nyinaa.”","poem":2}]},{"type":"verse","number":33,"content":["Yei ne deɛ Asafo Awurade seɛ:",{"text":"“Wɔhyɛ Israelfoɔ so,","poem":1},{"text":"na Yudafoɔ nso saa ara.","poem":2},{"text":"Wɔn nnommumfafoɔ no kura wɔn denden","poem":1},{"text":"a wɔmpɛ sɛ wɔgyaa wɔn ma wɔkɔ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nanso, wɔn Gyefoɔ yɛ ɔhoɔdenfoɔ;","poem":1},{"text":"ne din ne Asafo Awurade.","poem":2},{"text":"Ɔbɛdi wɔn asɛm ama wɔn anibereɛ so","poem":1},{"text":"sɛdeɛ ɔde ahotɔ bɛba wɔn asase no so,","poem":2},{"lineBreak":true},{"text":"na wɔn a wɔte Babilonia no deɛ, wahyɛ wɔn ahometeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Akofena bi bɛsɔre atia Babiloniafoɔ!”","poem":1},{"text":"Awurade na ɔseɛ.","poem":2},{"text":"“Ɛbɛtia wɔn a wɔte Babilonia","poem":1},{"text":"na atia nʼadwumayɛfoɔ ne nʼanyansafoɔ!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Akofena bi bɛsɔre atia nʼadiyifoɔ atorofoɔ!","poem":1},{"text":"Wɔbɛdane nkwaseafoɔ.","poem":2},{"text":"Akofena bi bɛsɔre atia nʼakofoɔ!","poem":1},{"lineBreak":true},{"text":"Ehu bɛhyɛ wɔn ma.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Akofena bi bɛsɔre atia nʼapɔnkɔ ne ne nteaseɛnam","poem":1},{"text":"ne amanfrafoɔ a wɔwɔ wɔn mu nyinaa!","poem":2},{"lineBreak":true},{"text":"Wɔbɛdane mmaa.","poem":2},{"text":"Akofena bi bɛsɔre atia nʼademudeɛ!","poem":1},{"text":"Wɔbɛfom.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ɔweɛ wɔ ne nsuo ahodoɔ so!","poem":1},{"text":"Ɛbɛwewe.","poem":2},{"text":"Ɛfiri sɛ ɛyɛ ahoni asase,","poem":1},{"text":"ahoni a ehu bɛma wɔabobɔ adam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Enti ɛserɛ so mmoa ne mpataku bɛtena hɔ,","poem":1},{"text":"na ɛhɔ na ɔpatuo bɛtena.","poem":2},{"text":"Obiara rentena so bio","poem":1},{"text":"ɛfiri awoɔ ntoatoasoɔ kɔsi awoɔ ntoatoasoɔ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Sɛdeɛ Onyankopɔn tuu Sodom ne Gomora","poem":1},{"text":"ne wɔn nkurotoɔ guiɛ no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ,","poem":2},{"text":"“saa ara na obiara rentena hɔ;","poem":1},{"text":"onipa biara rentena mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Monhwɛ! Akodɔm bi firi atifi fam reba;","poem":1},{"text":"ɔman kɛseɛ ne ahemfo bebree,","poem":2},{"lineBreak":true},{"text":"wɔrehwanyane wɔn afiri nsase ano.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wɔkurakura bɛmma ne pea;","poem":1},{"text":"wɔn tirim yɛ den, na wɔnni ahummɔborɔ.","poem":2},{"text":"Wɔn nnyegyeeɛ te sɛ ɛpo a ɛrehuru soɔ.","poem":1},{"text":"Sɛ wɔtete wɔn apɔnkɔ so a,","poem":2},{"text":"wɔba sɛ mmarima a wɔrekɔ sa","poem":1},{"text":"abɛto ahyɛ wo so, Ao Ɔbabaa Babilonia.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Babiloniahene ate wɔn ho nsɛm,","poem":1},{"text":"ne nsa sesa ne ho kwa.","poem":2},{"text":"Ahohiahia akyekyere no;","poem":1},{"text":"ɔyea a ɛte sɛ ɔbaa a ɔrekyem awoɔ so.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Sɛdeɛ gyata a ɔfiri Yordan nkyɛkyerɛ mu","poem":1},{"text":"rekɔ adidibea frɔmfrɔm no,","poem":2},{"text":"saa ara na mɛtaa Babilonia so afiri nʼasase so wɔ ɛberɛ tiawa bi mu.","poem":1},{"text":"Hwan ne deɛ mayi no sɛ ɔnyɛ yei?","poem":2},{"text":"Hwan na ɔte sɛ me, na hwan na ɔbɛtumi ne me adi asie?","poem":1},{"text":"Na odwanhwɛfoɔ bɛn na ɔbɛtumi asɔre atia me?”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Enti tie deɛ Awurade ahyehyɛ atia Babilonia,","poem":1},{"text":"deɛ wabɔ ne tirim sɛ ɔbɛyɛ de atia Babiloniafoɔ asase nie:","poem":2},{"text":"Nnwankuo no mu nkumaa no mpo, wɔbɛtwe wɔn akɔ;","poem":1},{"text":"wɔn enti ɔbɛsɛe adidibea no koraa.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Babilonia nnommumfa nnyegyeeɛ bɛma asase awoso;","poem":1},{"text":"ne nteateam bɛgyegye wɔ amanaman no mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}