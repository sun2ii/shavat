{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Yei ne deɛ Awurade seɛ:",{"text":"“Monhwɛ, mɛkanyane ɔsɛefoɔ bi honhom","poem":1},{"text":"atia Babilonia ne nnipa a wɔwɔ Leb Kamai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛsoma amanfrafoɔ akɔ Babilonia","poem":1},{"text":"sɛ wɔnkɔhuhu ne so na wɔnsɛe nʼasase;","poem":2},{"text":"wɔbɛtia no wɔ afanan nyinaa","poem":1},{"text":"wɔ nʼamanehunu da no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mma agyantoni mpoma nʼagyan,","poem":1},{"text":"mma ɔnhyɛ ne nkataboɔ.","poem":2},{"text":"Mma ne mmeranteɛ mfa wɔn ho nni;","poem":1},{"text":"sɛe nʼakodɔm no pasaa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔbɛhwehwe ase a wɔatotɔ wɔ Babilonia,","poem":1},{"text":"a wɔapirapira yie wɔ ne mmɔntene so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na Asafo Onyankopɔn Awurade,","poem":1},{"text":"nnyaa Israel ne Yuda hɔ.","poem":2},{"text":"Ɛwom sɛ afɔdie ahyɛ wɔn asase no so ma","poem":1},{"text":"wɔ Israel Ɔkronkronni no anim, nanso ɔkɔ so ara yɛ wɔn Onyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Monnwane mfiri Babilonia!","poem":1},{"text":"Montu mmirika mpere mo nkwa!","poem":2},{"lineBreak":true},{"text":"Mommma wɔnsɛe mo ɛsiane wɔn bɔne enti.","poem":2},{"text":"Awurade aweretɔberɛ aso;","poem":1},{"text":"ɔde deɛ ɛfata no bɛtua wɔn ka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na Babilonia yɛ sikakɔkɔɔ kuruwa wɔ Awurade nsam;","poem":1},{"text":"ɔmaa asase nyinaa boroo nsã.","poem":2},{"text":"Aman no nom ne nsã;","poem":1},{"text":"ɛno enti, afei, wɔabobɔ adam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babilonia bɛhwe ase abubu mpofirim.","poem":1},{"text":"Montwa ne ho agyaadwoɔ!","poem":2},{"text":"Mompɛ ne yea no ano aduro;","poem":1},{"text":"ebia ne ho bɛtɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Anka yɛbɛsa Babilonia yadeɛ,","poem":1},{"text":"nanso wɔntumi nsa no yadeɛ;","poem":2},{"text":"momma yɛnnya no hɔ na obiara nkɔ nʼankasa asase so,","poem":1},{"text":"ɛfiri sɛ nʼatemmuo aduru ɔsorosoro.","poem":2},{"lineBreak":true},{"text":"Ɛforo ɔsoro te sɛ omununkum.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Awurade abu yɛn bem.","poem":1},{"text":"Mommra, momma yɛnka wɔ Sion,","poem":2},{"lineBreak":true},{"text":"deɛ Awurade yɛn Onyankopɔn ayɛ.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Monse agyan no ano!","poem":1},{"text":"Momfa nkataboɔ no!","poem":2},{"text":"Awurade ahwanyane Mede ahemfo no,","poem":1},{"text":"ɛfiri sɛ ne botaeɛ ne sɛ ɔbɛsɛe Babilonia.","poem":2},{"text":"Awurade bɛtɔ were","poem":1},{"text":"aweretɔ ama nʼasɔrefie no.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mompagya frankaa bi ntia Babilonia afasuo!","poem":1},{"text":"Mommia banbɔ mu,","poem":2},{"text":"momma awɛmfoɔ no nnyinagyina.","poem":1},{"text":"Monsiesie ahintaeɛ!","poem":2},{"text":"Awurade bɛma nʼatirimpɔ aba mu,","poem":1},{"text":"deɛ wahyɛ atia Babilonia no.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mo a motete nsuwansuwa bebree ho","poem":1},{"text":"na akoradeɛ abu mo so,","poem":2},{"text":"mo awieeɛ aba,","poem":1},{"text":"ɛberɛ a ɛsɛ sɛ wɔtwa mo twene no.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asafo Awurade aka ne ho ntam sɛ:","poem":1},{"text":"mede nnipa bɛhyɛ wo ma sɛ mmɛbɛ,","poem":2},{"text":"na wɔabɔ ose wɔ wo so.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ɔde ne tumi bɔɔ asase;","poem":1},{"lineBreak":true},{"text":"ɔtoo ewiase fapem wɔ ne nyansa mu","poem":1},{"text":"na ɔde ne nhunumu trɛɛ ɔsorosoro mu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sɛ ɔbobɔm a, ɔsoro nsuo woro so;","poem":1},{"text":"ɔma omununkum ma ne ho so firi nsase ano.","poem":2},{"text":"Ɔsoma anyinam ka ɔsutɔ ho","poem":1},{"text":"na ɔma mframa bɔ firi nʼakoradan mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Onipa biara nnim nyansa, na ɔnni nimdeɛ;","poem":1},{"text":"sikadwumfoɔ biara anim agu ase, ɛsiane nʼahoni enti.","poem":2},{"text":"Ne nsɛsodeɛ yɛ atorɔ;","poem":1},{"text":"wɔnni ahome biara wɔ wɔn mu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔn ho nni mfasoɔ, wɔyɛ aseredeɛ nneɛma;","poem":1},{"text":"sɛ wɔn atemmuo duru so a, wɔbɛyera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Deɛ ɔyɛ Yakob Kyɛfa no nte sɛ yeinom,","poem":1},{"text":"ɛfiri sɛ ɔno ne adeɛ nyinaa Yɛfoɔ","poem":2},{"text":"a nʼadedie abusuakuo ka ho bi.","poem":1},{"text":"Asafo Awurade ne ne din.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Woyɛ me ko asaeɛ,","poem":1},{"text":"mʼakodeɛ a mede kɔ ɔsa;","poem":2},{"text":"mede wo dwerɛ amanaman,","poem":1},{"text":"mede wo sɛe ahennie bebree,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"mede wo bobɔ apɔnkɔ ne wɔn sotefoɔ,","poem":1},{"text":"teaseɛnam ne wɔn kafoɔ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"mede wo dwerɛ mmarima ne mmaa,","poem":1},{"text":"mede wo dwerɛ nkɔkoraa ne mmabunu,","poem":2},{"lineBreak":true},{"text":"mede wo dwerɛ mmeranteɛ ne mmabaawa,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"mede wo dwerɛ nnwanhwɛfoɔ ne nnwankuo,","poem":1},{"text":"mede wo dwerɛ akuafoɔ ne anantwie,","poem":2},{"lineBreak":true},{"text":"mede wo dwerɛ amradofoɔ ne adwumayɛfoɔ.","poem":2}]},{"type":"verse","number":24,"content":["“Mɛtua Babilonia ne wɔn a wɔtete Babilonia ka wɔ mfomsoɔ a wɔayɛ wɔ Sion nyinaa, wɔ wʼanim,” Awurade na ɔseɛ."]},{"type":"verse","number":25,"content":[{"text":"“Ao, bepɔ sɛefoɔ me ne wo anya,","poem":1},{"text":"wo a wosɛe asase nyinaa no,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2},{"text":"“Mɛtene me nsa wɔ wo so","poem":1},{"text":"mɛpia wo afiri abotan no so,","poem":2},{"lineBreak":true},{"text":"na mayɛ wo sɛ bepɔ a ɛnka hwee.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wɔremfa ɔboɔ biara mfiri wo so nyɛ tweatiboɔ","poem":1},{"text":"anaa sɛ fapem mpo,","poem":2},{"text":"ɛfiri sɛ wobɛda mpan afebɔɔ,”","poem":1},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Mompagya frankaa wɔ asase no so!","poem":1},{"text":"Monhyɛn totorobɛnto no wɔ amanaman no mu!","poem":2},{"text":"Monsiesie amanaman no ma wɔnkɔko ntia no;","poem":1},{"text":"Momfrɛfrɛ saa ahennie ahodoɔ yi ntia no:","poem":2},{"lineBreak":true},{"text":"Ararat, Mini ne Askenas.","poem":2},{"text":"Monnyi ɔsahene ntia no;","poem":1},{"text":"momfa apɔnkɔdɔm te sɛ mmɛbɛ mmra.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Monsiesie amanaman no ma wɔntu ne so sa,","poem":1},{"text":"mo ne Mede ahemfo,","poem":2},{"text":"wɔn amradofoɔ ne wɔn adwumayɛfoɔ nyinaa,","poem":1},{"text":"ne aman a wɔdi wɔn so nyinaa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Asase no woso, na ɔnukanuka ne mu,","poem":1},{"text":"ɛfiri sɛ Awurade atirimpɔ a ɛtia Babilonia","poem":2},{"text":"sɛ ɔbɛsɛe Babilonia asase a","poem":1},{"text":"obiara rentumi ntena so no nsesaeɛ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Babilonia nnɔmmarima agyae ko;","poem":1},{"text":"wɔhyehyɛ wɔn aban mu.","poem":2},{"text":"Wɔn ahoɔden asa;","poem":1},{"text":"wɔayɛ sɛ mmaa.","poem":2},{"text":"Wɔatoto nʼatenaeɛ ahodoɔ no mu ogya,","poem":1},{"text":"na wɔabubu nʼapono akyi adaban.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abɔfoɔ didi so","poem":1},{"text":"asomafoɔ didi so a","poem":2},{"text":"wɔrekɔbɔ Babiloniahene amaneɛ sɛ,","poem":1},{"text":"wɔafa ne kuropɔn no,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"wɔagye atwaeɛ a ɛdeda asubɔnten no so afa,","poem":1},{"text":"na wɔde ogya ato ɔwora no mu,","poem":2},{"lineBreak":true},{"text":"na asraafoɔ no abɔ huboa.”","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yei ne deɛ Asafo Awurade, Israel Onyankopɔn, seɛ:","poem":1},{"lineBreak":true},{"text":"“Ɔbabaa Babilonia ayɛ sɛ ayuporobea","poem":1},{"text":"wɔ ɛberɛ a wɔretiatia hɔ.","poem":2},{"lineBreak":true},{"text":"Aka kakraa bi, na ɛberɛ a ɛsɛ sɛ wɔtwa no sɛ nnɔbaeɛ no aduru.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Babiloniahene Nebukadnessar adwerɛ yɛn,","poem":1},{"text":"ɔde yɛn ato ɔhaw mu,","poem":2},{"lineBreak":true},{"text":"wayɛ yɛn sɛ ahina a hwee nni muo.","poem":2},{"text":"Wamene yɛn sɛ ɔtweaseɛ no","poem":1},{"text":"na ɔde yɛn nneɛma a ɛyɛ dɛ ahyɛ ne yafunu ma,","poem":2},{"lineBreak":true},{"text":"na wape yɛn afiri nʼanom agu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ma ayakayakadeɛ a wɔde dii yɛn honam no mmra Babilonia so,”","poem":1},{"text":"nnipa a wɔtete Sion na wɔka.","poem":2},{"text":"“Ma yɛn mogya ngu wɔn a wɔtete Babilonia so,”","poem":1},{"text":"Yerusalem na ɔka.","poem":2}]},{"type":"verse","number":36,"content":["Enti yei ne deɛ Awurade seɛ:",{"text":"“Hwɛ, mɛdi mo asɛm ama mo","poem":1},{"text":"na matɔ were ama mo;","poem":2},{"text":"Mɛma ɛpo a ɛwɔ no no awe","poem":1},{"text":"na mama ne asutene awewe.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Babilonia bɛyɛ mmubuiɛ sie,","poem":1},{"text":"sakraman atu","poem":2},{"text":"ahodwiredeɛ ne fɛdideɛ,","poem":1},{"text":"baabi a obiara nteɛ.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ne nkurɔfoɔ nyinaa bobom sɛ agyata,","poem":1},{"text":"wɔpɔ so te sɛ agyata mma.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Nanso ɛberɛ a wɔahwanyane wɔn ho no","poem":1},{"text":"mɛto ɛpono ama wɔn","poem":2},{"lineBreak":true},{"text":"na mama wɔaboboro nsã","poem":2},{"text":"sɛdeɛ wɔde nteateam bɛdi ahurisie,","poem":1},{"text":"na wɔadeda a wɔrennyane bio,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“Mede wɔn bɛba","poem":1},{"text":"te sɛ nnwammaa a wɔrekɔkum wɔn,","poem":2},{"lineBreak":true},{"text":"te sɛ, nnwennini ne mpapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Wɔbɛfa Sesak,","poem":1},{"text":"Sesak a agye asase nyinaa ayɛyie no!","poem":2},{"text":"Babilonia bɛyɛ ahodwiredeɛ","poem":1},{"text":"wɔ amanaman no mu!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ɛpo bɛbunkam afa Babilonia so;","poem":1},{"text":"na nʼasorɔkye bɛkata ne so.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ne nkuro bɛda mpan.","poem":1},{"text":"Ɛbɛyɛ anweatam a ɛso awo,","poem":2},{"text":"asase a obiara nte soɔ,","poem":1},{"text":"na obiara nntu ɛkwan mfa so.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Mɛtwe Bel aso wɔ Babilonia","poem":1},{"text":"na mama wape deɛ wamene agu.","poem":2},{"text":"Amanaman no nnto santene nkɔ ne nkyɛn bio.","poem":1},{"text":"Na Babilonia ɔfasuo bɛbubu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Me nkurɔfoɔ, Momfiri ne mu mfi!","poem":1},{"text":"Montu mmirika mpere mo nkwa!","poem":2},{"lineBreak":true},{"text":"Monnwane mfiri Awurade abufuhyeɛ ano.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Mommma mo bo ntu na monnsuro","poem":1},{"text":"sɛ mote atesɛm wɔ asase no so a;","poem":2},{"text":"atesɛm bɛba afeɛ yi na foforɔ bɛba afedan,","poem":1},{"text":"basabasayɛ ho atesɛm bɛba asase no so","poem":2},{"lineBreak":true},{"text":"a ɛfa sodifoɔ a wɔsɔre tia afoforɔ ho.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Na ampa ara ɛberɛ no bɛba","poem":1},{"text":"a mɛtwe Babilonia ahoni aso;","poem":2},{"text":"nʼasase no nyinaa anim bɛgu ase","poem":1},{"text":"na nʼatɔfoɔ nyinaa bɛhwehwe ase wɔ ne so.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ɔsoro ne asase ne deɛ ɛwo mu nyinaa","poem":1},{"text":"de ahosɛpɛ bɛteam agu Babilonia so,","poem":2},{"text":"ɛfiri sɛ ɔsɛefoɔ bɛfiri atifi fam","poem":1},{"text":"abɛto ahyɛ ne so,”","poem":2},{"lineBreak":true},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Ɛsɛ sɛ Babilonia hwe ase, ɛsiane Israel atɔfoɔ enti,","poem":1},{"text":"sɛdeɛ atɔfoɔ a wɔwɔ ewiase nyinaa ahwehwe ase","poem":2},{"lineBreak":true},{"text":"ɛsiane Babilonia enti no.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Mo a mo adwane afiri akofena ano,","poem":1},{"text":"monkɔ na monntwentwɛn mo nan ase!","poem":2},{"text":"Monkae Awurade wɔ akyirikyiri asase so,","poem":1},{"text":"na monnwene Yerusalem ho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Wɔagu yɛn anim ase,","poem":1},{"text":"ɛfiri sɛ wasopa yɛn","poem":2},{"lineBreak":true},{"text":"na fɛreɛ akata yɛn anim,","poem":2},{"text":"ɛfiri sɛ amanfrafoɔ ahyɛne","poem":1},{"text":"Awurade efie kronkronbea ahodoɔ hɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“Nanso nna bi reba,” Awurade na ɔseɛ,","poem":1},{"text":"“a mɛtwe nʼahoni aso,","poem":2},{"text":"na nʼasase so nyinaa","poem":1},{"text":"apirafoɔ bɛsi apinie.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Sɛ Babilonia kɔka ɔsoro mpo,","poem":1},{"text":"na ɔmiamia nʼaban tenten banbɔ mu a,","poem":2},{"text":"mɛsoma ɔsɛefoɔ abɛtia no,”","poem":1},{"text":"Awurade na ɔseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Osu nnyegyeeɛ bi firi Babilonia,","poem":1},{"text":"ɔsɛeɛ kɛseɛ bi nnyegyeeɛ","poem":2},{"lineBreak":true},{"text":"firi Babiloniafoɔ asase so.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Awurade bɛsɛe Babilonia;","poem":1},{"text":"ɔbɛma nʼasotuatua nnyegyeeɛ no agyae.","poem":2},{"text":"Atamfoɔ a wɔte sɛ ahum bɛtu sɛ nsuo akɛseɛ aba ne so;","poem":1},{"text":"wɔn mmobom bɛgyegye.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ɔsɛefoɔ bi bɛba abɛtia Babilonia;","poem":1},{"text":"wɔbɛfa ne nnɔmmarima nnommum","poem":2},{"lineBreak":true},{"text":"na wɔbɛbubu wɔn tadua mu.","poem":2},{"text":"Ɛfiri sɛ Awurade yɛ Onyankopɔn a ɔhyɛ anan mu;","poem":1},{"text":"ɔbɛtua so ka pɛpɛɛpɛ.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Mɛma nʼadwumayɛfoɔ ne nʼanyansafoɔ aboro nsã,","poem":1},{"text":"nʼamradofoɔ, ne mpanimfoɔ ne nnɔmmarima nso saa ara;","poem":2},{"text":"wɔbɛdeda afebɔɔ a wɔrennyane,”","poem":1},{"text":"sei na ɔhempɔn a ne din ne Asafo Awurade no seɛ.","poem":2}]},{"type":"verse","number":58,"content":["Yei ne deɛ Asafo Awurade seɛ:",{"text":"“Wɔbɛdwiri Babilonia afasuo a ɛtrɛ no agu fam","poem":1},{"text":"na wɔbɛto nʼapono a ɛwoware no mu ogya;","poem":2},{"text":"nnipa no ha wɔn ho kwa,","poem":1},{"text":"ɔman no adwumayɛ ma ogya no dɛre mmom.”","poem":2}]},{"type":"verse","number":59,"content":["Yei ne asɛm a Yeremia ka kyerɛɛ Neria babarima Seraia a ɔyɛ adwumayɛfoɔ panin na ɔyɛ Maseia nana no, ɛberɛ a ɔne Yudahene Sedekia kɔɔ Babilonia wɔ nʼadedie afe a ɛtɔ so ɛnan no mu."]},{"type":"verse","number":60,"content":["Na Yeremia atwerɛ amanehunu a ɛbɛba Babilonia so no nyinaa agu nwoma mmobɔeɛ so, deɛ watwerɛ a ɛfa Babilonia ho nyinaa."]},{"type":"verse","number":61,"content":["Ɔka kyerɛɛ Seraia sɛ, “Sɛ woduru Babilonia a, hwɛ sɛ wo bɛkenkan saa nsɛm yi nyinaa sɛdeɛ obiara bɛte."]},{"type":"verse","number":62,"content":["Afei, ka sɛ, ‘Ao Awurade, woaka sɛ wobɛsɛe beaeɛ yi sɛdeɛ onipa anaa aboa biara rentumi ntena so; na ɛbɛda mpan afebɔɔ.’"]},{"type":"verse","number":63,"content":["Sɛ wokenkane nwoma mmobɔeɛ yi wie a, kyekyere fam ɛboɔ ho, na to twene Asubɔnten Eufrate mu."]},{"type":"verse","number":64,"content":["Afei ka sɛ, ‘Sei na Babilonia ne ne nkurɔfoɔ bɛmem a wɔrensɔre bio, ɛsiane amanehunu a mede bɛba ne so no enti.’ ” Yeremia nsɛm no awieeɛ nie."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}