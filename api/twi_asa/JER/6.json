{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Atamfoɔ Atwa Yerusalem Ho Ahyia"]},{"type":"verse","number":1,"content":[{"text":"“Benyaminfoɔ monnwane nkɔbɔ mo ho adwaa!","poem":1},{"text":"Monnwane mfiri Yerusalem!","poem":2},{"text":"Monhyɛne totorobɛnto no wɔ Tekoa!","poem":1},{"text":"Monsi frankaa no wɔ Bet-Hakerem!","poem":2},{"text":"Ɛfiri sɛ amanehunu bobɔ firi atifi fam,","poem":1},{"text":"ɔsɛeɛ bi a ɛyɛ hu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛsɛe Ɔbabaa Sion","poem":1},{"text":"ɔhoɔfɛfoɔ sɔɔnɔ no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Atamfoɔ bɛba abɛtwa ne ho ahyia te sɛ nnwanhwɛfoɔ;","poem":1},{"text":"wɔbɛsisi wɔn ntomadan atwa ne ho ahyia","poem":2},{"lineBreak":true},{"text":"na wɔn mu biara bɛhwɛ ne kyɛfa so.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Monsiesie mo ho ne no nkɔko!","poem":1},{"text":"Monsɔre, momma yɛnkɔto nhyɛ ne so owigyinaeɛ!","poem":2},{"text":"Nanso, hwɛ, onwunu redwo,","poem":1},{"text":"na anwummerɛ sunsumma reyɛ tenten.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti, monsɔre momma yɛnkɔto nhyɛ ne so anadwo","poem":1},{"text":"na yɛnsɛe nʼaban hodoɔ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Deɛ Asafo Awurade seɛ nie:",{"text":"“Montwitwa nnua no ngu fam","poem":1},{"text":"na monsisi epie ntia Yerusalem.","poem":2},{"text":"Ɛsɛ sɛ wɔtwe kuropɔn yi aso;","poem":1},{"text":"nhyɛsoɔ ahyɛ no ma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sɛdeɛ abura pu ne nsuo no,","poem":1},{"text":"saa ara nso na ɔpu nʼamumuyɛ.","poem":2},{"text":"Wɔte awurukasɛm ne ɔsɛeɛ nka wɔ ne mu;","poem":1},{"text":"ne yadeɛ ne nʼapirakuro wɔ mʼanim daa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fa kɔkɔbɔ, Ao Yerusalem,","poem":1},{"text":"anyɛ saa a metwe me ho afiri wo ho","poem":2},{"text":"na mama wʼasase ada mpan","poem":1},{"text":"a obiara ntumi ntena soɔ.”","poem":2}]},{"type":"verse","number":9,"content":["Deɛ Asafo Awurade seɛ nie:",{"text":"“Ma wɔnyiyi Israel nkaeɛfoɔ no mu yie","poem":1},{"text":"sɛdeɛ wɔyiyi bobe mu;","poem":2},{"text":"fa wo nsa fa mman no so bio,","poem":1},{"text":"sɛ obi a ɔretete bobe aba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hwan na mɛtumi akasa akyerɛ no na mabɔ no kɔkɔ?","poem":1},{"text":"Hwan na ɔbɛtie me?","poem":2},{"text":"Wɔn aso asisi","poem":1},{"text":"enti wɔnte asɛm.","poem":2},{"text":"Awurade asɛm yɛ akyiwadeɛ ma wɔn","poem":1},{"text":"na wɔn ani nnye ho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanso Awurade abufuhyeɛ ahyɛ me ma,","poem":1},{"text":"na mentumi nkora so.","poem":2},{"lineBreak":true},{"text":"“Hwie gu mmɔfra a wɔwɔ mmɔntene so","poem":1},{"text":"ne mmaranteɛ a wɔahyia;","poem":2},{"text":"ɛbɛka okunu ne ɔyere,","poem":1},{"text":"mmasiriwa ne wɔn a onyini adoko wɔn.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ metene me nsa","poem":1},{"text":"wɔ wɔn a wɔte asase no so a","poem":2},{"text":"wɔbɛdane wɔn afie ama afoforɔ,","poem":1},{"text":"na wɔn mfuo ne wɔn yerenom bɛka ho,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Ɛfiri akumaa so kɔsi ɔkɛseɛ so,","poem":1},{"text":"wɔn nyinaa yɛ adifudepɛfoɔ de pɛ ahonya;","poem":2},{"text":"adiyifoɔ ne asɔfoɔ te saa,","poem":1},{"text":"wɔn nyinaa yɛ asisifoɔ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wɔmia me nkurɔfoɔ apirakuro","poem":1},{"text":"te sɛ deɛ ɛnyɛ hu.","poem":2},{"text":"Wɔka sɛ, ‘Asomdwoeɛ, asomdwoeɛ’","poem":1},{"text":"wɔ mmerɛ a asomdwoeɛ nni hɔ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wɔn ani wu wɔ wɔn animguaseɛ nneyɛɛ no ho anaa?","poem":1},{"text":"Dabi, wɔn ani nnwu koraa;","poem":2},{"lineBreak":true},{"text":"wɔnnim fɛreɛ mpo.","poem":2},{"text":"Enti sɛ metwe wɔn aso a, wɔbɛtotɔ wɔ atɔfoɔ mu;","poem":1},{"text":"wɔbɛhwehwe ase,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":16,"content":["Yei ne deɛ Awurade seɛ,",{"text":"“Monnyina nkwantanan no so na monhwɛ;","poem":1},{"text":"mommisa tete akwan no,","poem":2},{"text":"mommisa baabi a ɛkwan pa no da na monnante so,","poem":1},{"text":"na mobɛnya homeɛ ama mo akra.","poem":2},{"lineBreak":true},{"text":"Nanso mokaa sɛ, ‘yɛnnante so.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mede awɛmfoɔ sisii mo so na mekaa sɛ,","poem":1},{"text":"‘Montie totorobɛnto nnyegyeeɛ no!’","poem":2},{"text":"Nanso, mokaa sɛ, ‘Yɛrentie.’","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɛno enti, monyɛ aso, Ao amanaman;","poem":1},{"text":"monhwɛ, Ao adansefoɔ,","poem":2},{"lineBreak":true},{"text":"deɛ ɛbɛto wɔn.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yɛ aso, Ao asase:","poem":1},{"text":"Mede amanehunu reba saa nnipa yi so,","poem":2},{"lineBreak":true},{"text":"wɔn nneyɛɛ so aba,","poem":2},{"text":"ɛfiri sɛ wɔantie me nsɛm","poem":1},{"text":"na wɔapo me mmara.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nnuhwam a ɛfiri Seba","poem":1},{"text":"anaa ahwedeɛ pa a ɛfiri akyirikyiri asase so fa me ho bɛn?","poem":2},{"text":"Mennye wo hyeɛ afɔdeɛ no nto mu;","poem":1},{"text":"wʼafɔrebɔ ahodoɔ no nsɔ mʼani.”","poem":2}]},{"type":"verse","number":21,"content":["Ɛno enti, deɛ Awurade seɛ nie:",{"text":"“Mede akwansideɛ bɛgu saa nkurɔfoɔ yi anim.","poem":1},{"text":"Agyanom ne mmammarima nyinaa bɛsuntisunti wɔ so;","poem":2},{"lineBreak":true},{"text":"ayɔnkofoɔ ne nnamfonom bɛyera.”","poem":2}]},{"type":"verse","number":22,"content":["Sɛdeɛ Awurade seɛ nie:",{"text":"“Monhwɛ, akodɔm bi reba,","poem":1},{"text":"wɔfiri atifi fam asase so;","poem":2},{"text":"wɔrekanyane ɔman kɛseɛ bi","poem":1},{"text":"afiri nsase ano.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wɔkurakura bɛmma ne pea;","poem":1},{"text":"wɔn tirim yɛ den, na wɔnni ahummɔborɔ.","poem":2},{"text":"Wɔn nnyegyeeɛ te sɛ ɛpo asorɔkye.","poem":1},{"text":"Sɛ wɔtete wɔn apɔnkɔ so a,","poem":2},{"text":"wɔba te sɛ mmarima a wɔrekɔ ɔko.","poem":1},{"text":"Wɔrebɛto ahyɛ wo so, Ao Ɔbabaa Sion.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yɛate wɔn ho nsɛm,","poem":1},{"text":"na yɛn nsa sesa yɛn ho sɛ deɛ awu.","poem":2},{"text":"Ehu akyekyere yɛn","poem":1},{"text":"ɔyea aba wɔn so, te sɛ ɔbaa a ɔreko awoɔ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mfiri adi nkɔ wiram","poem":1},{"text":"na nnante akwan no so,","poem":2},{"text":"ɛfiri sɛ ɔtamfoɔ no wɔ akofena,","poem":1},{"text":"na baabiara ayɛ hu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ao me nkurɔfoɔ, monfira ayitoma","poem":1},{"text":"na mommunimuni nsõ mu.","poem":2},{"text":"Momfa adwadwotwa yaaya nni awerɛhoɔ","poem":1},{"text":"sɛdeɛ wɔsu ma ɔbabarima korɔ,","poem":2},{"text":"ɛfiri sɛ mpofirim ara ɔsɛefoɔ no","poem":1},{"text":"bɛba yɛn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Mayɛ wo obi a ɔsɔ fagudeɛ hwɛ","poem":1},{"text":"na me nkurɔfoɔ yɛ dadeben,","poem":2},{"text":"a wobɛhwɛ wɔn","poem":1},{"text":"na woasɔ wɔn akwan ahwɛ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wɔn nyinaa yɛ atuatefoɔ a wɔyɛ den,","poem":1},{"text":"wɔnenam di nsekuro.","poem":2},{"text":"Wɔyɛ den sɛ kɔbere ne dadeɛ;","poem":1},{"text":"wɔn nyinaa yɛ wɔn adeɛ wɔ porɔeɛ ɛkwan so.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Afa no bɔ mframa denden","poem":1},{"text":"de ogya nane sumpii no,","poem":2},{"text":"nanso ahobereɛ no yɛ ɔkwa.","poem":1},{"text":"Ɛntumi nyiyii bɔne no mfirii wɔn mu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mɛfrɛ wɔn dwetɛ a wɔapo,","poem":1},{"text":"ɛfiri sɛ Awurade apo wɔn.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}