{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JER","translationId":"twi_asa","name":"Yeremia","commonName":"Yeremia","title":"Odiyifoɔ Yeremia Nwoma","order":24,"numberOfChapters":52,"sha256":"4eb0b6405756ce0fc7bbc28697f5af72f4e29ac1f409829e24a198a2de9fb71b","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/twi_asa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘Saa ɛberɛ no, sɛdeɛ Awurade seɛ nie, wɔbɛyiyi Yuda ahemfo ne adwumayɛfoɔ nnompe, asɔfoɔ ne adiyifoɔ nnompe ne Yerusalemfoɔ nnompe afiri wɔn nnamena mu."]},{"type":"verse","number":2,"content":["Wɔbɛsɛ no kɛtɛ wɔ awia ne ɔsrane ne ɔsorosoro nsoromma nyinaa a wɔdɔɔɛ na wɔsomeeɛ na wɔdii akyire no ase. Wɔremmoa wɔn ano na wɔrensie wɔn, mmom, wɔbɛyɛ sɛ sumina a ɛgugu fam."]},{"type":"verse","number":3,"content":["Saa ɔman bɔne yi nkaeɛfoɔ no, baabiara a mɛtwa wɔn asuo akɔ no, wɔbɛpɛ sɛ wɔbɛwu sene sɛ wɔbɛtena nkwa mu, sɛdeɛ Asafo Awurade seɛ nie.’"]},{"type":"heading","content":["Bɔne Ne Asotwe"]},{"type":"verse","number":4,"content":["“Ka kyerɛ wɔn sɛ, ‘Deɛ Awurade seɛ nie:",{"text":"“ ‘Sɛ nnipa hwe ase a, wɔnsɔre anaa?","poem":1},{"text":"Sɛ onipa dane ne ho a, ɔnsane nʼakyi anaa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afei adɛn enti na saa nnipa yi adane wɔn ho?","poem":1},{"text":"Adɛn enti na Yerusalem dane ne ho daa yi?","poem":2},{"text":"Wɔkura nnaadaa mu pintinn;","poem":1},{"text":"na wɔmpɛ sɛ wɔsane wɔn akyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mawɛn maso matie,","poem":1},{"text":"nanso wɔnnka deɛ ɛtene.","poem":2},{"text":"Wɔn mu biara nnu ne ho wɔ nʼamumuyɛ ho,","poem":1},{"text":"na ɔka sɛ, “Ɛdeɛn na mayɛ?”","poem":2},{"text":"Obiara fa ɔno ara ɛkwan so","poem":1},{"text":"te sɛ ɔpɔnkɔ a ɔrebɔ hyia dɔm.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mpo asukɔnkɔn a ɔwɔ ewiem","poem":1},{"text":"nim ne mmerɛ a wɔahyehyɛ ama no,","poem":2},{"text":"na aturukuku, asomfena ne anyankuku","poem":1},{"text":"hunu ɛberɛ a wɔtu kɔtena baabi,","poem":2},{"text":"nanso me nkurɔfoɔ nnim","poem":1},{"text":"deɛ Awurade hwehwɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Adɛn na motumi ka sɛ, “Yɛnim nyansa,","poem":1},{"text":"ɛfiri sɛ yɛwɔ Awurade mmara,”","poem":2},{"text":"wɔ ɛberɛ a atwerɛfoɔ twerɛdua torofoɔ","poem":1},{"text":"de atorɔ adanedane mu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anyansafoɔ no anim bɛgu ase;","poem":1},{"text":"wɔn ho bɛdwiri wɔn na afidie ayi wɔn.","poem":2},{"text":"Sɛ wɔapo Awurade asɛm no a,","poem":1},{"text":"na ɛdeɛn nyansa na wɔwɔ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mede wɔn yerenom bɛma mmarimma foforɔ","poem":1},{"text":"ne wɔn mfuo nso ama afoforɔ.","poem":2},{"text":"Ɛfiri akumaa so kɔsi ɔkɛseɛ so,","poem":1},{"text":"wɔn nyinaa yɛ adifudepɛfoɔ de pɛ ahonya;","poem":2},{"text":"adiyifoɔ ne asɔfoɔ te saa,","poem":1},{"text":"wɔn nyinaa yɛ asisifoɔ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔmia me nkurɔfoɔ apirakuro","poem":1},{"text":"te sɛ deɛ ɛnyɛ hu.","poem":2},{"text":"Wɔka sɛ, “Asomdwoeɛ, asomdwoeɛ”","poem":1},{"text":"wɔ mmerɛ a asomdwoeɛ nni hɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔn ani wu wɔ wɔn animguaseɛ nneyɛɛ no ho anaa?","poem":1},{"text":"Dabi, wɔn ani nnwu koraa;","poem":2},{"text":"wɔnnim fɛreɛ mpo.","poem":1},{"text":"Enti wɔbɛtotɔ wɔ atɔfoɔ mu;","poem":2},{"text":"sɛ metwe wɔn aso a, wɔbɛhwehwe ase,","poem":1},{"text":"sɛdeɛ Awurade seɛ nie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Mɛfa wɔn otwa berɛ nnɔbaeɛ akɔ,","poem":1},{"text":"deɛ Awurade seɛ nie.","poem":2},{"lineBreak":true},{"text":"Aba biara remma bobe nnua no so.","poem":2},{"text":"Aba biara remma borɔdɔma nnua no so,","poem":1},{"text":"ɛso nhahan bɛdwindwan.","poem":2},{"text":"Deɛ mede ama wɔn no","poem":1},{"text":"wɔbɛgye afiri wɔn nsam.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Adɛn enti na yɛtete ha?","poem":1},{"text":"Mommoaboa mo ho ano!","poem":2},{"text":"Momma yɛnnwane nkɔ nkuropɔn a ɛwɔ banbɔ mu","poem":1},{"text":"na yɛnkɔwuwu wɔ hɔ!","poem":2},{"text":"Ɛfiri sɛ Awurade yɛn Onyankopɔn abu yɛn kumfɔ","poem":1},{"text":"na wama yɛn nsuo a awuduro wɔ mu sɛ yɛnnom,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ yɛayɛ bɔne atia no.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yɛhwɛɛ ɛkwan sɛ yɛbɛnya asomdwoeɛ","poem":1},{"text":"nanso biribi pa biara amfiri mu amma,","poem":2},{"text":"yɛhwɛɛ ayaresa berɛ ɛkwan","poem":1},{"text":"nanso ehu nko ara na ɛkaa yɛn.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔte atamfoɔ no apɔnkɔ homee","poem":1},{"text":"firi Dan;","poem":2},{"text":"na wɔn apɔnkɔnini su","poem":1},{"text":"ma asase no nyinaa woso.","poem":2},{"text":"Wɔaba sɛ wɔrebɛsɛe","poem":1},{"text":"asase no ne ɛso nneɛma nyinaa,","poem":2},{"lineBreak":true},{"text":"kuropɔn no ne wɔn a wɔtete mu nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Hwɛ, mɛsoma awɔ a wɔn ano wɔ borɔ aba mo mu,","poem":1},{"text":"nhurutoa a wɔntumi nnwodwo wɔn,","poem":2},{"text":"na wɔbɛkeka mo,”","poem":1},{"text":"deɛ Awurade seɛ nie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ao mʼawerɛhoɔ mu ɔwerɛkyekyefoɔ,","poem":1},{"text":"mʼakoma aboto wɔ me mu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tie me nkurɔfoɔ sufrɛ","poem":1},{"text":"a ɛfiri akyirikyiri asase so:","poem":2},{"text":"“Awurade nni Sion anaa?","poem":1},{"text":"Ne Ɔhene no nni hɔ bio anaa?”","poem":2},{"lineBreak":true},{"text":"“Adɛn enti na wɔde wɔn nsɛsodeɛ ahyɛ me abufuo,","poem":1},{"text":"wɔn ananafoɔ ahoni huhuo no?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Otwa berɛ no atwam,","poem":1},{"text":"ahuhuro berɛ no aba awieeɛ,","poem":2},{"lineBreak":true},{"text":"na wɔnnyee yɛn nkwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sɛ wɔadwerɛ me nkurɔfoɔ no enti, wɔadwerɛ me;","poem":1},{"text":"medi awerɛhoɔ, na ahodwirie akyekyere me.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Aduro bi nni Gilead anaa?","poem":1},{"text":"Ɔyaresafoɔ bi nni hɔ anaa?","poem":2},{"text":"Na afei adɛn enti na ayaresa nni hɔ","poem":1},{"text":"mma me nkurɔfoɔ apirakuro?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}