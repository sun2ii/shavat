{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JOB","translationId":"twi_asa","name":"Hiob","commonName":"Hiob","title":"Hiob Nwoma","order":18,"numberOfChapters":42,"sha256":"102d81475d0a97eba8b68c90f84dbf8daf5b3217e750395c85e6e15cd13885bd","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/twi_asa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Hiob Kyerɛ Onyankopɔn Kɛseyɛ"]},{"type":"verse","number":1,"content":["Na Hiob kasaa bio sɛ,"]},{"type":"verse","number":2,"content":[{"text":"“Woaboa deɛ ɔnni tumi!","poem":1},{"text":"Woagye basa a ɛnni ahoɔden!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woatu deɛ ɔnnim nyansa fo!","poem":1},{"text":"Na woada nhunumu pa ara adi!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hwan na ɔboaa wo ma wokaa saa nsɛm yi?","poem":1},{"text":"Hwan honhom na ɛkasa faa wo mu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Awufoɔ wɔ ahoyera kɛseɛ mu,","poem":1},{"text":"wɔn a wɔwɔ nsuo ase ne deɛ ɛte mu nyinaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asamando da adagya Onyankopɔn anim;","poem":1},{"text":"Ɔsɛeɛ nso nni nkatasoɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔtrɛ atifi fam ewiem wɔ deɛ ɛda mpan so;","poem":1},{"text":"na ɔde asase sensɛn ohunu so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔkyekyere nsuo hyɛ ne omununkum mu,","poem":1},{"text":"nanso nsuo no mu duru ntumi mpae no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔtrɛ ne omununkum mu","poem":1},{"text":"de kata ɔsrane ani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɔhyɛ agyiraeɛ wɔ nsuo so","poem":1},{"text":"de to hyeɛ wɔ hann ne esum ntam.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɔsoro nnyinasoɔ woso,","poem":1},{"text":"na nʼanimka ma wɔn ho dwiri wɔn.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔde ne tumi wɔsoo ɛpo","poem":1},{"text":"ne nyansa mu, ɔtwitwaa ɛpobɔpɔn mu asinasini.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ɔde nʼahomeɛ maa ewiem teeɛ;","poem":1},{"text":"na ne nsa wɔɔ ɔtweaseɛ a ɔrewea.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yeinom yɛ ne nnwuma mfeafeaho;","poem":1},{"text":"ɔka asomusɛm brɛoo kyerɛ yɛn!","poem":2},{"lineBreak":true},{"text":"Na hwan na ɔbɛtumi ate ne tumi mmobɔmu no ase.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}