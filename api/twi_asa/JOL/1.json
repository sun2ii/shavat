{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"JOL","translationId":"twi_asa","name":"Yoɛl","commonName":"Yoɛl","title":"Odiyifoɔ Yoɛl Nwoma","order":29,"numberOfChapters":3,"sha256":"db38a739a81daf864c35aeba69fd799869f6f714526ffb55392c1a2a8f00962c","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Awurade asɛm a ɛbaa Petuel babarima Yoɛl so nie."]},{"type":"heading","content":["Ɛda A Ntutummɛ No Bɛba"]},{"type":"verse","number":2,"content":[{"text":"Montie saa asɛm yi, mo mpanimfoɔ;","poem":1},{"text":"montie, mo a mote asase no so nyinaa.","poem":2},{"text":"Asɛm bi a ɛte sɛi asi mo mmerɛ so","poem":1},{"text":"anaa mo mpanimfoɔ mmerɛ so pɛn?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monka nkyerɛ mo mma,","poem":1},{"text":"na mo mma nso nka nkyerɛ wɔn mma","poem":2},{"lineBreak":true},{"text":"na wɔn mma nso nka nkyerɛ awoɔ ntoatoasoɔ a ɛdi soɔ no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deɛ ntutummɛ kuo no gyaeɛ no","poem":1},{"text":"ntutummɛ akɛseɛ no awe","poem":2},{"text":"deɛ ntutummɛ akɛseɛ no gyaeɛ no","poem":1},{"text":"ntutummɛ nkumaa no awe","poem":2},{"text":"deɛ ntutummɛ nkumaa no gyaeɛ no","poem":1},{"text":"ntutummɛ afoforɔ awe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mo asabofoɔ, monyane, na monsu!","poem":1},{"text":"Mo a monom bobesa nyinaa, montwa adwo;","poem":2},{"text":"montwa adwo ɛfiri sɛ nsã foforɔ no","poem":1},{"text":"wɔayi afiri mo ano.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔman bi atu mʼasase so sa","poem":1},{"text":"ɛdɔm a wɔyɛ den na wɔntumi nkane wɔn;","poem":2},{"text":"wɔn se te sɛ gyata se","poem":1},{"text":"na wɔwɔ gyatabereɛ sebɔmmɔfoɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔasɛe me bobe","poem":1},{"text":"ne me borɔdɔma nnua.","poem":2},{"text":"Wawaawae nnua no ho bona,","poem":1},{"text":"ato agu","poem":2},{"lineBreak":true},{"text":"agya ne mman a ayɛ fitaa hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Di awerɛhoɔ sɛ ababaawa a ɔfira ayitoma","poem":1},{"text":"na ɔresu ne kunu a ɔwaree no ne mmabaawaberɛ mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aduane ne ahwiesa afɔrebɔdeɛ,","poem":1},{"text":"wɔayi afiri Awurade efie.","poem":2},{"text":"Asɔfoɔ no retwa adwoɔ,","poem":1},{"text":"wɔn a wɔsom wɔ Awurade anim no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mfuo asɛe,","poem":1},{"text":"asase no so awo wesee","poem":2},{"text":"aduane no asɛe","poem":1},{"text":"nsã foforɔ no awe","poem":2},{"lineBreak":true},{"text":"ngo nyinaa asa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mo ani nwu, mo akuafoɔ,","poem":1},{"text":"mo ntwa adwo, mo a modua bobe;","poem":2},{"text":"Monsi apinie mma ayuo ne atokoɔ,","poem":1},{"text":"ɛfiri sɛ otwaberɛ no asɛe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bobe no akusa","poem":1},{"text":"na borɔdɔma nnua no awuwu.","poem":2},{"text":"Ateaa nnua, mmɛdua, aperɛ ne","poem":1},{"text":"nnua a ɛwɔ mfuo no so nyinaa ahye.","poem":2},{"text":"Nokorɛm, anigyeɛ a nnipa wɔ no","poem":1},{"text":"atu ayera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Momfira ayitoma na monni awerɛhoɔ, Ao asɔfoɔ;","poem":1},{"text":"mo a mosom afɔrebukyia anim, montwa adwo.","poem":2},{"text":"Momfira ayitoma mmɛsiri pɛ","poem":1},{"text":"mo a mosom Onyankopɔn anim;","poem":2},{"text":"ɛfiri sɛ aduane ne ahwiesa afɔrebɔdeɛ no","poem":1},{"text":"ɛto atwa wɔ Onyankopɔn efie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mommɔ mmuadadie kronkron ho dawuro;","poem":1},{"text":"momfrɛ nhyiamu kronkron.","poem":2},{"text":"Monfrɛ mpanimfoɔ","poem":1},{"text":"ne wɔn a wɔte asase no so nyinaa","poem":2},{"text":"mmra Awurade mo Onyankopɔn efie","poem":1},{"text":"na wɔmmesu mfrɛ Awurade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ɛda no aba!","poem":1},{"text":"Awurade ɛda no abɛn;","poem":2},{"lineBreak":true},{"text":"Ɛbɛba sɛ ɔsɛeɛ a ɛfiri Otumfoɔ hɔ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yɛnnhunuu sɛ aduane ho ayɛ na,","poem":1},{"text":"sɛ anigyeɛ ne ahosɛpɛ nso to atwa","poem":2},{"lineBreak":true},{"text":"wɔ yɛn Onyankopɔn efie anaa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aba no wu wɔ asase wesee mu,","poem":1},{"text":"adekoradan abubu,","poem":2},{"text":"aburopata nso ho nni mfasoɔ,","poem":1},{"text":"ɛfiri sɛ nnuane no ahye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sɛdeɛ anantwie su!","poem":1},{"text":"Na anantwikuo kyinkyini kwa.","poem":2},{"text":"Nnwankuo mpo rebrɛ","poem":1},{"text":"ɛfiri sɛ wɔnni adidibea.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Awurade, wo na mesu frɛ wo,","poem":1},{"text":"ɛfiri sɛ ogya ahye ɛserɛ so adidibea","poem":2},{"lineBreak":true},{"text":"na ogyaframa ahye mfuo no so nnua nyinaa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wiram mmoa mpo pere hwehwɛ wo.","poem":1},{"text":"Nsuwansuwa awewe,","poem":2},{"lineBreak":true},{"text":"na ogya ahye ɛserɛ so adidibea.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}