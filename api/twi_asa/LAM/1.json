{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_asa","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"b77ee58f75fc55ec26af2f52f9f9c747afc1db6dc6c021e0f3c4cac00d506423","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_asa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ao, sɛdeɛ kuropɔn no adane amamfo nie,","poem":1},{"text":"kuropɔn a anka nnipa ahyɛ no ma?","poem":2},{"text":"Ɛdeɛn enti na wayɛ okunafoɔ baa a","poem":1},{"text":"kane no na anka woyɛ kɛseɛ wɔ amanaman no mu?","poem":2},{"text":"Deɛ na ɔyɛ ɔhemmaa wɔ amantam no mu no","poem":1},{"text":"abɛyɛ afenaa ɛnnɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɔsu yaayaaya anadwo,","poem":1},{"text":"nisuo sensane nʼafono so.","poem":2},{"text":"Nʼadɔfoɔ nyinaa mu no,","poem":1},{"text":"ɔbiara nni hɔ a ɔkyekyere ne werɛ.","poem":2},{"text":"Nʼayɔnkofoɔ nyinaa adi no hwammɔ","poem":1},{"text":"Wɔayɛ nʼatamfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amanehunu ne adwumaden akyi no,","poem":1},{"text":"Yuda kɔ nnommumfa mu.","poem":2},{"text":"Ɔte amanaman no mu","poem":1},{"text":"na ɔnni ahomegyebea","poem":2},{"text":"Wɔn a wɔtaa no nyinaa ati no","poem":1},{"text":"wɔ nʼahokyere mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akwan a ɛkɔ Sion no di awerɛhoɔ,","poem":1},{"text":"ɛfiri sɛ obiara nkɔ nʼafahyɛ ase.","poem":2},{"text":"Nʼapono nyinaa adeda mpan,","poem":1},{"text":"na nʼasɔfoɔ si apinie,","poem":2},{"text":"ne mmabaawa di yea,","poem":1},{"text":"na ɔwɔ yeadie a emu yɛ den.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nʼatamfoɔ abɛyɛ ne wuranom;","poem":1},{"text":"wɔn a wɔ ne no ayɛ dom ho adwo wɔn.","poem":2},{"text":"Awurade ama awerɛhoɔ aba ne so","poem":1},{"text":"nʼamumuyɛ bebrebe enti.","poem":2},{"text":"Ne mma kɔ nnommumfa mu.","poem":1},{"text":"Wɔayɛ nneduafoɔ ama ɔtamfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Animuonyam nyinaa atu","poem":1},{"text":"afiri Ɔbabaa Sion so kɔ.","poem":2},{"text":"Ne mmapɔmma ayɛ sɛ aforoteɛ","poem":1},{"text":"a wɔnnya adidibea;","poem":2},{"text":"na wɔde mmerɛyɛ adwane","poem":1},{"text":"wɔ wɔn ataafoɔ anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nʼamanehunu ne ananteananteɛ nna mu no,","poem":1},{"text":"Yerusalem kae ademudeɛ nyinaa","poem":2},{"lineBreak":true},{"text":"a na ɛwɔ no wɔ nna a atwam no mu.","poem":2},{"text":"Ne nkurɔfoɔ kɔtɔɔ ɔtamfoɔ no nsa mu no,","poem":1},{"text":"na obiara nni hɔ a ɔbɛboa no.","poem":2},{"text":"Nʼatamfoɔ de wɔn ani hwɛɛ no","poem":1},{"text":"na wɔseree ne sɛeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalem ayɛ bɔne kɛseɛ","poem":1},{"text":"enti ne ho agu fi.","poem":2},{"text":"Wɔn a wɔdi no ni no sopa no,","poem":1},{"text":"ɛfiri sɛ wɔahunu nʼadagya;","poem":2},{"text":"ɔno ankasa gu ahome","poem":1},{"text":"na ɔdane nʼani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nʼafideyɛ atu aka ne ntadeɛ mu;","poem":1},{"text":"wannwene ne daakye ho.","poem":2},{"text":"Nʼasehweɛ yɛ nwanwa;","poem":1},{"text":"obiara ankyekyere ne werɛ.","poem":2},{"text":"“Ao Awurade hwɛ mʼamanehunu,","poem":1},{"text":"ɛfiri sɛ ɔtamfoɔ adi nkonim.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔtamfoɔ no de ne nsa too","poem":1},{"text":"nʼademudeɛ nyinaa so;","poem":2},{"text":"ɔhunuu sɛ amanaman","poem":1},{"text":"rehyɛne ne kronkronbea hɔ,","poem":2},{"text":"nnipa a woabra sɛ","poem":1},{"text":"wɔnnhyɛne wʼasafo mu no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ne nkurɔfoɔ nyinaa si apinie","poem":1},{"text":"ɛberɛ a wɔrepɛ aduane;","poem":2},{"text":"wɔde wɔn ademudeɛ sesa aduane","poem":1},{"text":"de nya ahoɔden.","poem":2},{"text":"“Ao, Awurade, hwɛ na dwene me ho,","poem":1},{"text":"ɛfiri sɛ wɔbu me animtia.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ɛmfa mo ho anaa, mo a motwam hɔ nyinaa?","poem":1},{"text":"Monhwɛ na monhunu.","poem":2},{"text":"Ɛyea bi wɔ hɔ a ɛte sɛ me deɛ","poem":1},{"text":"a wɔma ɛbaa me soɔ yi anaa?","poem":2},{"text":"Deɛ Awurade de baa me so","poem":1},{"text":"wɔ nʼabufuhyeɛ da no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ɔsomaa ogya firi ɔsoro,","poem":1},{"text":"ma ɛbaa me nnompe mu.","poem":2},{"text":"Ɔsum afidie maa me nan","poem":1},{"text":"na ɔsane me kɔɔ mʼakyi.","poem":2},{"text":"Ɔyɛɛ me pasaa,","poem":1},{"text":"metɔɔ bira da mu nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Woakyekyere me bɔne sɛ adesoa;","poem":1},{"text":"ɔde ne nsa nwene bɔɔ mu.","poem":2},{"text":"Abɛda me kɔn mu","poem":1},{"text":"na Awurade atwe mʼahoɔden.","poem":2},{"text":"Ɔde me ahyɛ wɔn a","poem":1},{"text":"merentumi nnyina wɔn anim no nsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Awurade apo","poem":1},{"text":"ahoɔdenfoɔ a wɔwɔ me ntam nyinaa;","poem":2},{"text":"wafrɛ akodɔm atia me","poem":1},{"text":"sɛ wɔmmɛdwɛre me mmeranteɛ.","poem":2},{"text":"Awurade atiatia Ɔbabaa Yuda Bunu so","poem":1},{"text":"wɔ ne nsakyiamena hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Yeinom enti na mesu","poem":1},{"text":"na nisuo adware me.","poem":2},{"text":"Obiara mmɛn a ɔbɛkyekye me werɛ.","poem":1},{"text":"Deɛ ɔbɛhyɛ me honhom den nni hɔ.","poem":2},{"text":"Me mma agyigya","poem":1},{"text":"ɛfiri sɛ ɔtamfoɔ no adi nkonim.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sion trɛ ne nsa mu","poem":1},{"text":"nanso obiara nni hɔ a ɔbɛkyekye ne werɛ","poem":2},{"text":"Awurade ahyɛ ama Yakob sɛ","poem":1},{"text":"ne mfɛfoɔ bɛyɛ nʼatamfoɔ;","poem":2},{"text":"Yerusalem abɛyɛ","poem":1},{"text":"afideɛ wɔ wɔn mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Awurade yɛ ɔteneneeni,","poem":1},{"text":"nanso manni nʼahyɛdeɛ so.","poem":2},{"text":"Montie, mo amanaman nyinaa","poem":1},{"text":"monhwɛ me yea.","poem":2},{"text":"Me mmeranteɛ ne mmabaawa","poem":1},{"text":"kɔ nnommumfa mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Mefrɛɛ mʼapamfoɔ","poem":1},{"text":"nanso wɔyii me maeɛ.","poem":2},{"text":"Mʼasɔfoɔ ne me mpanimfoɔ","poem":1},{"text":"ase tɔreɛ wɔ kuropɔn no mu,","poem":2},{"text":"ɛberɛ a wɔrepɛ aduane adi","poem":1},{"text":"na wɔanwuwu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ao Awurade, hwɛ me mmɔborɔ!","poem":1},{"text":"Meredi ɛyea wɔ me mu,","poem":2},{"text":"na mʼakoma mu nso menni ahotɔ,","poem":1},{"text":"ɛfiri sɛ mayɛ otuatefoɔ kɛseɛ.","poem":2},{"text":"Akofena hyɛ me awerɛhoɔ wɔ abɔntene so;","poem":1},{"text":"efie nso yɛ owuo nko ara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nnipa ate mʼapinisie,","poem":1},{"text":"nanso obiara nni hɔ a ɔbɛkyekye me werɛ.","poem":2},{"text":"Mʼatamfoɔ nyinaa ate mʼamanehunu","poem":1},{"text":"wɔn ani gye deɛ woayɛ no ho.","poem":2},{"text":"Ma nna a woahyɛ no mmra","poem":1},{"text":"sɛdeɛ wɔbɛyɛ sɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Fa wɔn atirimuɔdensɛm nyinaa si wʼanim;","poem":1},{"text":"na wo ne wɔn nni","poem":2},{"text":"sɛdeɛ wo ne me adie","poem":1},{"text":"ɛsiane mʼamumuyɛ no enti.","poem":2},{"text":"Mʼapinisie dɔɔso","poem":1},{"text":"na mʼakoma aboto.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}