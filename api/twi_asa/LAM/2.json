{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_asa","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"b77ee58f75fc55ec26af2f52f9f9c747afc1db6dc6c021e0f3c4cac00d506423","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_asa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Sɛdeɛ Awurade de nʼabufuhyeɛ omununkum","poem":1},{"text":"akata Ɔbabaa Sion so nie?","poem":2},{"text":"Wato Israel animuonyam","poem":1},{"text":"firi soro abɛhwe fam;","poem":2},{"text":"wankae ne nan ntiasoɔ","poem":1},{"text":"wɔ nʼabufuo da no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade annya ahummɔborɔ","poem":1},{"text":"na wamene Yakob atenaeɛ nyinaa;","poem":2},{"text":"nʼabufuhyeɛ mu, wadwiri","poem":1},{"text":"Yuda Ɔbabaa aban denden no agu fam.","poem":2},{"text":"Wagu nʼahennie ne ne mmapɔmma","poem":1},{"text":"ho fi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɔde abufuhyeɛ atwitwa","poem":1},{"text":"Israel mmɛn nyinaa.","poem":2},{"text":"Wayi ne banbɔ","poem":1},{"text":"wɔ ɛberɛ a atamfoɔ no reba.","poem":2},{"text":"Wasɔ wɔ Yakob mu sɛ ogyadɛreɛ","poem":1},{"text":"a ɛhye biribiara a atwa ho ahyia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wapoma ne bɛmma te sɛ ɔtamfoɔ;","poem":1},{"text":"ne nsa nifa ayɛ krado.","poem":2},{"text":"Sɛdeɛ ɔtamfoɔ yɛ no, wakunkum","poem":1},{"text":"wɔn a wɔyɛ fɛ wɔ anisoɔ nyinaa;","poem":2},{"text":"wahwie nʼabufuhyeɛ sɛ ogya","poem":1},{"text":"agu Ɔbabaa Sion ntomadan so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade ayɛ sɛ ɔtamfoɔ;","poem":1},{"text":"wamene Israel.","poem":2},{"text":"Wamene nʼahemfie nyinaa","poem":1},{"text":"asɛe nʼabandenden.","poem":2},{"text":"Wama awerɛhoɔdie ne agyaadwotwa adɔɔso","poem":1},{"text":"ama Yuda Ɔbabaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wama nʼatenaeɛ ada mpan sɛ turo;","poem":1},{"text":"wasɛe ne dwabirem.","poem":2},{"text":"Awurade ama Sion werɛ afiri","poem":1},{"text":"nʼafahyɛ ne home nna;","poem":2},{"text":"wɔ nʼabufuhyeɛ mu no","poem":1},{"text":"wabu ɔhene ne ɔsɔfoɔ animtia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade apo nʼafɔrebukyia","poem":1},{"text":"na wagyae ne kronkronbea mu.","poem":2},{"text":"Ɔde nʼahemfie afasuo","poem":1},{"text":"ahyɛ nʼatamfoɔ nsa.","poem":2},{"text":"Wɔteam wɔ Awurade efie","poem":1},{"text":"te sɛ afahyɛ da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade sii nʼadwene pi sɛ ɔbɛsɛe","poem":1},{"text":"Ɔbabaa Sion ɔfasuo a atwa ne ho ahyia no.","poem":2},{"text":"Ɔde susuhoma too ho","poem":1},{"text":"na wannyae ɔsɛeɛ no.","poem":2},{"text":"Ɔmaa apie ne afasuo dii abooboo;","poem":1},{"text":"wɔn nyinaa sɛeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nʼapono amem fam;","poem":1},{"text":"wɔn adaban nso, wabubu mu asɛe no.","poem":2},{"text":"Ne ɔhene ne ne mmapɔmma, watwa wɔn asuo kɔ amanaman no mu,","poem":1},{"text":"mmara nni hɔ bio,","poem":2},{"text":"na nʼadiyifoɔ nnnya anisoadehunu a","poem":1},{"text":"ɛfiri Awurade hɔ bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔbabaa Sion mpanimfoɔ","poem":1},{"text":"tete fam ayɛ komm;","poem":2},{"text":"wɔde mfuturo agu wɔn tirim","poem":1},{"text":"afirafira ayitoma.","poem":2},{"text":"Yerusalem mmabaawa","poem":1},{"text":"asisi wɔn tiri ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mʼani rentumi nnyae nisuteɛ,","poem":1},{"text":"me yafunu mu retwa me,","poem":2},{"text":"mʼakoma rete atɔ fam,","poem":1},{"text":"ɛfiri sɛ wɔasɛe me nkurɔfoɔ,","poem":2},{"text":"ɛfiri sɛ mmɔfra ne mmotafowa totɔ piti","poem":1},{"text":"wɔ kuropɔn no mmɔntene so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wɔbisa wɔn maamenom sɛ,","poem":1},{"text":"“Ɛhe na aduane ne nsã wɔ?”","poem":2},{"text":"Ɛberɛ a wɔtotɔ piti sɛ apirafoɔ","poem":1},{"text":"wɔ kuropɔn no mmɔntene so,","poem":2},{"text":"ɛberɛ a wɔn nkwa resa","poem":1},{"text":"wɔ wɔn maamenom abasa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɛdeɛn na mɛtumi aka ama woɔ?","poem":1},{"text":"Ɛdeɛn ho na mɛtumi de wo atoto,","poem":2},{"text":"Ao, Yerusalem Ɔbabaa?","poem":1},{"text":"Ɛdeɛn na mɛtumi de asusu woɔ,","poem":2},{"text":"de akyekyere wo werɛ,","poem":1},{"text":"Ao, Sion Ɔbabaa Bunu?","poem":2},{"text":"Wʼapirakuro so sɛ ɛpo.","poem":1},{"text":"Hwan na ɔbɛtumi asa ama woɔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wʼadiyifoɔ anisoadehunu","poem":1},{"text":"yɛ atorɔ a ɛho nni mfasoɔ;","poem":2},{"text":"wɔanna mo amumuyɛ adi","poem":1},{"text":"ansi mo nnommumfa ano.","poem":2},{"text":"Nkɔmhyɛ a wɔde maa mo no","poem":1},{"text":"yɛ atorɔ ne nnaadaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wɔn a wɔtwam wo ɛkwan soɔ nyinaa","poem":1},{"text":"bobɔ wɔn nsam gu wo so;","poem":2},{"text":"wɔdi wo ho fɛ na wɔwoso wɔn tiri","poem":1},{"text":"gu Yerusalem Ɔbabaa so ka sɛ,","poem":2},{"text":"“Yei ne kuropɔn a na wɔfrɛ no","poem":1},{"text":"ahoɔfɛ a ɛdi mu no?","poem":2},{"lineBreak":true},{"text":"Asase nyinaa anigyedeɛ no nie?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wʼatamfoɔ nyinaa baeɛ wɔn anom","poem":1},{"text":"kakraa tia wo;","poem":2},{"text":"wɔsere na wɔtwɛre wɔn se","poem":1},{"text":"na wɔka sɛ, “Yɛamene no.","poem":2},{"text":"Ɛda a na yɛretwɛn no nie;","poem":1},{"text":"Yɛatena ase ahunu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Awurade ayɛ deɛ ɔhyehyɛeɛ;","poem":1},{"text":"wama nʼasɛm a","poem":2},{"text":"ɔhyɛɛ dadaada no aba mu.","poem":1},{"lineBreak":true},{"text":"Watu wo agu a wanhunu wo mmɔbɔ,","poem":1},{"text":"wama ɔtamfoɔ no ani agye","poem":2},{"lineBreak":true},{"text":"wama wʼatamfoɔ no mmɛn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nnipa no akoma","poem":1},{"text":"su frɛ Awurade.","poem":2},{"text":"Ao, Sion Ɔbabaa fasuo,","poem":1},{"text":"ma wo nisuo nsene sɛ asubɔnten","poem":2},{"lineBreak":true},{"text":"awia ne anadwo;","poem":2},{"text":"nnye wʼahome","poem":1},{"text":"mma wʼani nso nnya ahomeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sɔre, su denden anadwo","poem":1},{"text":"ɔdasuom mfitiaseɛ;","poem":2},{"text":"hwie wʼakoma mu nsɛm sɛ nsuo","poem":1},{"text":"gu Awurade anim.","poem":2},{"text":"Ma wo nsa so kyerɛ no","poem":1},{"text":"wo mma nkwa enti,","poem":2},{"text":"wɔn a ɛkɔm ama wʼatotɔ baha","poem":1},{"text":"wɔ mmɔntene so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Hwɛ na dwene ho, Ao, Awurade:","poem":1},{"text":"Hwan na wode no afa saa ɛkwan yi so pɛn?","poem":2},{"text":"Ɛsɛ sɛ mmaa we wɔn yafunu mma nam anaa,","poem":1},{"text":"mma a wɔahwɛ wɔn?","poem":2},{"text":"Ɛsɛ sɛ wɔkum ɔsɔfoɔ ne odiyifoɔ","poem":1},{"text":"wɔ Awurade kronkronbea anaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mmɔfra ne mpanin adeda abɔ mu","poem":1},{"text":"mfuturo mu wɔ mmɔntene so,","poem":2},{"text":"me mmeranteɛ ne mmabaawa","poem":1},{"text":"atotɔ wɔ akofena ano.","poem":2},{"text":"Wakum wɔn wɔ wʼabufuo da;","poem":1},{"text":"wayam wɔn na wannya ahummɔborɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Sɛdeɛ wotoo wo nsa frɛ wɔ apontoɔ da no,","poem":1},{"text":"saa ara na wofrɛfrɛɛ","poem":2},{"lineBreak":true},{"text":"amanehunu firi afanan nyinaa tiaa me.","poem":2},{"text":"Awurade abufuo da no,","poem":1},{"text":"obiara annwane na obiara anka:","poem":2},{"text":"wɔn a mehwɛɛ wɔn na metetee wɔn no,","poem":1},{"text":"me ɔtamfoɔ adwerɛ wɔn.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}