{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_asa","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"b77ee58f75fc55ec26af2f52f9f9c747afc1db6dc6c021e0f3c4cac00d506423","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_asa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Mene ɔbarima a mahunu amane","poem":1},{"text":"wɔ nʼabufuo abaa ano.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wapam me afiri ne ho ama manante","poem":1},{"text":"sum mu na ɛnyɛ hann mu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ampa ara wama nsa so atia me","poem":1},{"text":"mpɛn bebree, ɛda mu nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wama me wedeɛ ne me nam anyini","poem":1},{"text":"Na wabubu me nnompe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waka me ahyɛ mu,","poem":1},{"text":"ɔde nwononwono ne ahokyere atwa me ho ahyia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wama matena esum mu","poem":1},{"text":"sɛ wɔn a wɔawuwu dada no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wato ɔfasuo atwa me ho ahyia enti mentumi nnwane;","poem":1},{"text":"wagu me nkɔnsɔnkɔnsɔn ama matɔ baha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mpo sɛ mefrɛ anaasɛ mebɔ mpaeɛ srɛ mmoa a","poem":1},{"text":"ɔsi me mpaeɛbɔ ano.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔde abotan asi me ɛkwan;","poem":1},{"text":"wama mʼakwan ayɛ kɔntɔnkye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Te sɛ sisi a ɔda hɔ retwɛn,","poem":1},{"text":"te sɛ gyata a watɛ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ɔtwee me firi ɛkwan no mu dwerɛɛ me","poem":1},{"text":"na ɔgyaa me a menni mmoa biara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɔkuntunuu ne tadua mu","poem":1},{"text":"na ɔde ne bɛmma kyerɛɛ me so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɔde bɛmma a ɛfiri ne kotokuo mu","poem":1},{"text":"hwiree mʼakoma mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Meyɛɛ asredeɛ maa me nkurɔfoɔ nyinaa;","poem":1},{"text":"wɔto akutia nnwom","poem":2},{"lineBreak":true},{"text":"de di me ho fɛ ɛda mu nyinaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɔde nhahan nwononwono ahyɛ me ma.","poem":1},{"text":"Wama me bɔnwoma anom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔde aboseaa abubu me se;","poem":1},{"text":"na watiatia me so wɔ mfuturo mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔama asomdwoeɛ abɔ me;","poem":1},{"text":"na mewerɛ afiri yiedie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enti mese, “Mʼanimuonyam asa,","poem":1},{"text":"deɛ mede mʼani too so Awurade mu no nyinaa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mekae mʼamanehunu wɔ mʼakyinkyini mu,","poem":1},{"text":"nwononwono ne bɔnwoma mu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mekae yie,","poem":1},{"text":"na me kra aboto wɔ me mu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nanso, mekae yei","poem":1},{"text":"ne saa enti, mewɔ anidasoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Awurade dɔ kɛseɛ enti yɛnnsɛeɛ.","poem":1},{"text":"Nʼayamhyehyeɛ nni hwammɔ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ɛyɛ foforɔ anɔpa biara;","poem":1},{"text":"wo nokorɛdie yɛ kɛseɛ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Meka kyerɛ me ho sɛ,","poem":1},{"text":"“Awurade yɛ me kyɛfa, enti mɛtwɛn no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Awurade yɛ ma wɔn a wɔn anidasoɔ wɔ ne mu,","poem":1},{"text":"onipa a ɔhwehwɛ noɔ no;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ɛyɛ sɛ wɔyɛ komm","poem":1},{"text":"de twɛn Awurade nkwagyeɛ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ɛyɛ ma ɔbarima sɛ ɔsoa kɔnnua no","poem":1},{"text":"wɔ ne mmeranteɛ ɛberɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ma ɔntena ase komm,","poem":1},{"text":"ɛfiri sɛ Awurade de ato no so.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ma ɔmfa nʼanim nsie wɔ mfuturo mu,","poem":1},{"text":"ebia anidasoɔ wɔ hɔ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ma ɔmfa nʼafono mma deɛ ɔpɛɛ sɛ ɔbɔ no","poem":1},{"text":"na ɔnhyɛ no aniwuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Na Awurade nto nnipa ntwene koraa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ɛwom, ɔde awerɛhoɔ ba deɛ, nanso ɔbɛnya ayamhyehyeɛ.","poem":1},{"text":"Ne dɔ kɛseɛ no to rentwa da.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ɔfiri amemenemfe mu de amanehunu","poem":1},{"text":"anaa awerɛhoɔ brɛ nnipa mma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Sɛ wɔde wɔn nan dwerɛ","poem":1},{"text":"nneduafoɔ a wɔwɔ asase no so a,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"sɛ wɔtiatia obi ahofadie so","poem":1},{"text":"wɔ Ɔsorosoroni no anim a,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"anaa sɛ wɔbu obi ntɛnkyea a,","poem":1},{"text":"Awurade nhunu saa nneɛma yi anaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Hwan na ɔbɛtumi aka na wama aba mu","poem":1},{"text":"wɔ ɛberɛ a ɛnyɛ Awurade na ɔhyɛeɛ?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ɛnyɛ Ɔsorosoroni no anom","poem":1},{"text":"na musuo ne nnepa firi anaa?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Adɛn enti na ɛsɛ sɛ ɔteasefoɔ nwiinwii","poem":1},{"text":"ɛberɛ a wɔatwe nʼaso wɔ ne bɔne ho?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Momma yɛnhwehwɛ yɛn akwan mu na yɛnsɔ nhwɛ,","poem":1},{"text":"na yɛnsane nkɔ Awurade nkyɛn.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Momma yɛmma yɛn akoma ne yɛn nsa so,","poem":1},{"text":"nkyerɛ Onyankopɔn wɔ ɔsoro, na yɛnka sɛ:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Yɛayɛ bɔne, na yɛate atua","poem":1},{"text":"na woamfa ankyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Wode abufuo akata wo ho ataa yɛn;","poem":1},{"text":"na wakunkum a woannya ahummɔborɔ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Wode wo ho asie omununkum mu","poem":1},{"text":"enti mpaeɛbɔ biara nnuru wo nkyɛn.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Woayɛ yɛn atantanneɛ ne wira","poem":1},{"text":"wɔ amanaman no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Yɛn atamfoɔ nyinaa abae wɔn anom tɛtrɛɛ","poem":1},{"text":"de tia yɛn.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yɛabrɛ ne ahunahuna ne akukuruhweaseɛ,","poem":1},{"text":"mmubuiɛ ne ɔsɛeɛ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Me nisuo sene sɛ asutene","poem":1},{"text":"ɛfiri sɛ wɔasɛe me nkurɔfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Me nisuo bɛsene ara,","poem":1},{"text":"na ɛrennyae,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"kɔsi sɛ Awurade bɛhwɛ","poem":1},{"text":"afiri ɔsoro, na wahu.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Deɛ mehunu no ma me kra werɛ ho","poem":1},{"text":"me kuropɔn no mu mmaa nyinaa enti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Mʼatamfoɔ a menyɛɛ wɔn hwee","poem":1},{"text":"pampam me sɛ anomaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":53,"content":[{"text":"Wɔpɛɛ sɛ wɔtwa me nkwa so","poem":1},{"text":"na wɔsi me aboɔ wɔ amena mu;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"nsuo bu faa me tiri so,","poem":1},{"text":"na ɛyɛɛ me sɛdeɛ wɔrewie me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Mebɔɔ wo din, Ao Awurade","poem":1},{"text":"firi amena no ase tɔnn.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Wotee me sufrɛ: “Nsi wʼaso","poem":1},{"text":"wɔ me gyeɛ sufrɛ ho.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Wotwe bɛnee me ɛberɛ a mefrɛɛ woɔ no,","poem":1},{"text":"na wokaa sɛ, “Nsuro.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Ao Awurade, wodii mʼasɛm maa me;","poem":1},{"text":"na wogyee me nkwa.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Woahunu bɔne a wɔayɛ me, Ao Awurade.","poem":1},{"text":"Di mʼasɛm ma me!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Woahunu wɔn aweretɔ no mu den,","poem":1},{"text":"wɔn pɔ a wɔbɔ tia me no nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Ao Awurade, woate wɔn sopa,","poem":1},{"text":"wɔn pɔ a wɔbɔ tia me no nyinaa,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"deɛ mʼatamfoɔ ka no sɛ asomusɛm na wɔka no brɛoo","poem":1},{"text":"de tia me da mu nyinaa.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Hwɛ wɔn! Sɛ wɔgyinagyina hɔ anaa sɛ wɔtete hɔ,","poem":1},{"lineBreak":true},{"text":"wɔto akutia nnwom de di me ho fɛw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Fa deɛ ɛfata tua wɔn so ka, Ao Awurade,","poem":1},{"text":"deɛ wɔn nsa ayɛ enti.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Pirim wɔn akoma,","poem":1},{"text":"na ma wo nnome mmra wɔn so.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Fa abufuo taa wɔn, na sɛe wɔn","poem":1},{"text":"firi Awurade sorosoro ase.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}