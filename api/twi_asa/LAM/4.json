{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"LAM","translationId":"twi_asa","name":"Kwadwom","commonName":"Kwadwom","title":"Kwadwom","order":25,"numberOfChapters":5,"sha256":"b77ee58f75fc55ec26af2f52f9f9c747afc1db6dc6c021e0f3c4cac00d506423","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/twi_asa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Sɛdeɛ sikakɔkɔɔ a anka ɛhyerɛn no nie?","poem":1},{"text":"Sikakɔkɔɔ amapa no ho abiri!","poem":2},{"text":"Wɔatoto aboɔdemmoɔ kronkron apete","poem":1},{"text":"wɔ mmɔntene biara so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hwɛ sɛdeɛ Sion mmammarima a wɔdi mu","poem":1},{"text":"na anka wɔsom bo sɛ sika kɔkɔɔ no ayɛ,","poem":2},{"text":"seesei wɔfa wɔn sɛ dɔteɛ nkukuo,","poem":1},{"text":"ɔnwomfoɔ nsa ano adwuma!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mpo sakraman yi wɔn nufoɔ","poem":1},{"text":"ma wɔn mma enum,","poem":2},{"text":"nanso me nkurɔfoɔ ayɛ atirimuɔdenfoɔ","poem":1},{"text":"sɛ sohori a ɔwɔ ɛserɛ so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Osukɔm enti, akokoaa tɛkrɛma","poem":1},{"text":"fam ne dodo mu;","poem":2},{"text":"mmɔfra no su pɛ aduane,","poem":1},{"text":"nanso obiara mfa mma wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wɔn a na anka wɔdi nnuane pa no","poem":1},{"text":"ohia buruburo aka wɔn wɔ mmɔntene so.","poem":2},{"text":"Wɔn a wɔde serekye tetee wɔn no","poem":1},{"text":"seesei wɔdeda nso nkɔfie so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Me nkurɔfoɔ asotwe","poem":1},{"text":"so sene Sodom a","poem":2},{"text":"wɔtuu wɔn mpofirim no deɛ,","poem":1},{"text":"a wɔannya ɔboafoɔ biara no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na wɔn ahenemma ho twa sene sukyerɛmma,","poem":1},{"text":"na wɔhoa sene nufosuo,","poem":2},{"text":"na wɔn onipadua no bere na ɛwɔ ahoɔden te sɛ abohemaa,","poem":1},{"text":"na wɔte sɛ aboɔdemmoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nanso, seesei deɛ, wɔbiri sene wisiapunu;","poem":1},{"text":"na wɔnhunu wɔn yie wɔ mmɔntene so.","poem":2},{"text":"Wɔn wedeɛ atwintwam wɔ wɔn nnompe so;","poem":1},{"text":"ɛho awo wesee sɛ abaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wɔn a wɔtotɔ wɔ akofena ano no yɛ koraa","poem":1},{"text":"sene wɔn a ɛkɔm kunkumm wɔn;","poem":2},{"text":"ɛkɔm tware wɔn, ma wɔwuwu","poem":1},{"text":"ɛsiane aduane a ɛnni mfuo so enti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mmaa a wɔwɔ ayamhyehyeɛ","poem":1},{"text":"de wɔn nsa anoa wɔn ankasa mma,","poem":2},{"text":"ayɛ wɔn aduane","poem":1},{"text":"ɛberɛ a wɔsɛee me nkurɔfoɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awurade ada nʼabufuhyeɛ nyinaa adi;","poem":1},{"text":"wahwie nʼabufuo a ano yɛ den no.","poem":2},{"text":"Ɔsɔɔ ogya ano wɔ Sion","poem":1},{"text":"ma ɛhyee ne fapem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asase so ahemfo annye anni,","poem":1},{"text":"ewiase mu nnipa nso annye anni","poem":2},{"text":"sɛ atamfoɔ bɛtumi ahyɛne","poem":1},{"text":"Yerusalem apono mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nanso ɛsiiɛ, nʼadiyifoɔ no bɔne","poem":1},{"text":"ne nʼasɔfoɔ amumuyɛ enti,","poem":2},{"text":"wɔn na wɔhwiee teneneefoɔ mogya","poem":1},{"text":"guu wɔ kuropɔn no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Afei wɔkeka wɔ mmɔntene so","poem":1},{"text":"te sɛ nnipa a wɔn ani afira.","poem":2},{"text":"Mogya a ama wɔn ho agu fi no enti","poem":1},{"text":"obiara suro sɛ ɔde ne ho bɛka wɔn ntadeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nnipa teateaam gu wɔn so sɛ, “Momfiri ha nkɔ! Mo ho nnte!","poem":1},{"text":"Monkɔ, monkɔ! Mommfa mo ho nka yɛn.”","poem":2},{"text":"Sɛ wɔdwane kɔnenam a","poem":1},{"text":"amanaman no mu nnipa ka sɛ,","poem":2},{"lineBreak":true},{"text":"“Wɔrentumi ntena ha bio.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Awurade ankasa abɔ wɔn ahwete;","poem":1},{"text":"nʼani nni wɔn so bio.","poem":2},{"text":"Wɔmmfa anidie mma asɔfoɔ,","poem":1},{"text":"na wɔn ani nnsɔ mpanimfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Deɛ ɛka ho bio, yɛn ani anni ammoa yɛn,","poem":1},{"text":"yɛpɛɛ sɛ yɛbɛnya mmoa, nanso ɛyɛɛ ɔkwa;","poem":2},{"text":"yɛfiri yɛn abantenten so de yɛn ani too","poem":1},{"text":"ɔman a wɔrentumi nnye yɛn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nnipa dii yɛn ntɛntɛ wɔ yɛn anammɔntuo mu,","poem":1},{"text":"enti yɛantumi annante yɛn mmɔntene so.","poem":2},{"text":"Yɛn awieeɛ bɛneeɛ, na wɔkanee yɛn nna,","poem":1},{"text":"ɛfiri sɛ na yɛn awieeɛ aduru so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yɛn ataafoɔ ho yɛ hare","poem":1},{"text":"sene akɔdeɛ a wɔwɔ ewiem;","poem":2},{"text":"wɔtaa yɛn faa mmepɔ so","poem":1},{"text":"na wɔtɛɛ yɛn wɔ ɛserɛ so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Deɛ Awurade asra no ngo, yɛn ankasa yɛn nkwa no,","poem":1},{"text":"ɔtɔɔ wɔn mfidie mu.","poem":2},{"text":"Yɛgye dii sɛ ne nwunu ase","poem":1},{"text":"yɛbɛnya nkwa wɔ amanaman no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Di ahurisie na ma wʼani nnye, Ao Edom Ɔbabaa,","poem":1},{"text":"wo a wote Us asase so.","poem":2},{"text":"Wɔde kuruwa no bɛma wo nso bi;","poem":1},{"text":"wobɛboro na wɔabɔ wo adagya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ao Ɔbabaa Sion, wʼasotwe bɛba awieeɛ;","poem":1},{"text":"ɔremma wonkɔ so ntena nnommumfa mu.","poem":2},{"text":"Nanso, Ao Ɔbabaa Edom, ɔbɛtua wo bɔne so ka","poem":1},{"text":"na wada wʼamumuyɛ adi.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}