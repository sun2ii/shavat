{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_asa","name":"Mika","commonName":"Mika","title":"Odiyifoɔ Mika Nwoma","order":33,"numberOfChapters":7,"sha256":"765357658e8213927712b3bf343fe70f09c7b2022b1aba8e96c5c8dbe45e58c8","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_asa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Awurade de saa nsɛm yi brɛɛ Moresetni Mika",{"noteId":0},"ɛberɛ a na Yotam, Ahas ne Hesekia di adeɛ wɔ Yuda no. Anisoadehunu a ɔhunuiɛ fa Samaria ne Yerusalem ho."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Monyɛ aso, mo nnipa nyinaa,","poem":1},{"text":"montie, asase ne mo a mote so nyinaa.","poem":2},{"text":"Otumfoɔ Awurade redi adanseɛ atia mo,","poem":1},{"text":"ɔkasa firi nʼasɔredan kronkron no mu.","poem":2}]},{"type":"heading","content":["Atemmuo A Ɛtia Samaria Ne Yerusalem"]},{"type":"verse","number":3,"content":[{"text":"Monhwɛ! Awurade firi nʼatenaeɛ reba;","poem":1},{"text":"ɔresiane na ɔnante asase sorɔnsorɔmmea so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mmepɔ nane wɔ nʼase,","poem":1},{"text":"mmɔnhwa mu paepae","poem":2},{"text":"te sɛ ama a aka ogya,","poem":1},{"text":"te sɛ nsuo a ɛsiane ɔherɛ so firi kokoɔ so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yei nyinaa yɛ Yakob nnebɔne,","poem":1},{"text":"ne bɔne ahodoɔ a ɛwɔ Israel efie enti.","poem":2},{"text":"Yakob nnebɔne ne sɛn?","poem":1},{"text":"Ɛnyɛ Samaria anaa?","poem":2},{"text":"Na ɛhe ne Yuda sorɔnsorɔmmea?","poem":1},{"text":"Ɛnyɛ Yerusalem anaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Enti mɛyɛ Samaria kuro no mmubuiɛ sie,","poem":1},{"text":"baabi a wɔbɛyɛ bobe turo.","poem":2},{"text":"Mehwie nʼaboɔ agu bɔnhwa mu","poem":1},{"text":"ama ne fapem ho ada hɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔbɛbubu nʼahoni nyinaa mu asinasini;","poem":1},{"text":"wɔde ogya bɛhyɛ nʼasɔredan mu ayɛyɛdeɛ nyinaa.","poem":2},{"lineBreak":true},{"text":"Mɛsɛe ne nsɛsodeɛ nyinaa.","poem":2},{"text":"Esiane sɛ nʼakyɛdeɛ a waboa ano no nyinaa","poem":1},{"text":"ɔnya firii adwamanfoɔ akatua mu no enti","poem":2},{"lineBreak":true},{"text":"wɔde bɛma adwamanfoɔ.”","poem":2}]},{"type":"heading","content":["Osu Ne Awerɛhoɔ"]},{"type":"verse","number":8,"content":[{"text":"Yeinom enti mɛsu atwa agyaadwoɔ;","poem":1},{"text":"mede adagya bɛnante na mennhyɛ mpaboa.","poem":2},{"text":"Mɛpɔ so sɛ odompo","poem":1},{"text":"na masu sɛ ɔpatuo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nʼapirakuro no wuo ayɛ den;","poem":1},{"text":"abɛduru Yuda.","poem":2},{"text":"Abɛduru me nkurɔfoɔ ɛpono ano","poem":1},{"text":"mpo aduru Yerusalem ankasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Monnka no wɔ Gat","poem":1},{"text":"monnsu koraa","poem":2},{"text":"Mo a mowɔ Bet-Leafra deɛ","poem":1},{"text":"monyantam mfuturo mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Monsene nkɔ adagya ne aniwuo mu,","poem":1},{"text":"mo a mote Safir.","poem":2},{"text":"Wɔn a wɔte Saanan ntumi mpue","poem":1},{"text":"Bet-Esel wɔ awerɛhoɔ mu;","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ, wo hɔ na ɔnya ne banbɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wɔn a wɔte Marot de ɔyea nukanuka wɔ mu","poem":1},{"text":"de twɛn mmoa,","poem":2},{"text":"ɛfiri sɛ amanehunu a ɛfiri Awurade hɔ aba","poem":1},{"text":"abɛduru Yerusalem ɛpono ano.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mo a mote Lakis,","poem":1},{"text":"monsiesie nteaseɛnam no.","poem":2},{"text":"Mo ne bɔne farebae","poem":1},{"text":"ma Ɔbabaa Sion,","poem":2},{"text":"na modii Israel anim kɔɔ bɔne mu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Enti mode ntetemu akyɛdeɛ bɛma Moreset-Gat,","poem":1},{"text":"Aksib kuro bɛdaadaa Israel ahemfo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mede nkonimdifoɔ bɛtoa mo","poem":1},{"text":"mo a mote Maresa.","poem":2},{"text":"Deɛ ɔyɛ Israel onimuonyamfoɔ no","poem":1},{"text":"bɛba Adulam.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Monyi mo tirinwi mfa nni awerɛhoɔ,","poem":1},{"text":"wɔ mma a mo ani gye wɔn ho no ho;","poem":2},{"text":"mommɔ tikwa te sɛ ɔpete,","poem":1},{"text":"ɛfiri sɛ, wɔbɛfa wɔn afiri mo nkyɛn","poem":2},{"lineBreak":true},{"text":"akɔ nnommumfa mu.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 Mika asekyerɛ ne “Hwan na ɔte sɛ Awurade.” Samaria ne Yerusalem: Saa nkuropɔn mmienu yi gyina hɔ ma Israel ne Yuda. Atemmuo a Mika hyɛɛ ho nkɔm no fa aman mmienu no ho na ɛmfa wɔn nkuropɔn no nko ho.","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/twi_asa/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}