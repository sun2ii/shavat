{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_asa","name":"Mika","commonName":"Mika","title":"Odiyifoɔ Mika Nwoma","order":33,"numberOfChapters":7,"sha256":"765357658e8213927712b3bf343fe70f09c7b2022b1aba8e96c5c8dbe45e58c8","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_asa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Onipa Ne Onyankopɔn Nhyehyɛeɛ"]},{"type":"verse","number":1,"content":[{"text":"Nnome nka wɔn a wɔfa amumuyɛ ho adwene,","poem":1},{"text":"wɔn a wɔbɔ ɛpɔ bɔne wɔ wɔn mpa so!","poem":2},{"text":"Wɔsɔre anɔpa kɔdi dwuma no","poem":1},{"text":"ɛfiri sɛ wɔwɔ tumi sɛ wɔyɛ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wɔn ani bere mfuo na wɔgye.","poem":1},{"text":"Na afie nso wɔfa.","poem":2},{"text":"Wɔde nyansa korɔno gye nkurɔfoɔ afie,","poem":1},{"text":"na ayɔnkofoɔ agyapadeɛ nso wɔgye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti, sɛdeɛ Awurade seɛ nie,","poem":1},{"text":"“Meredwene amanehunu a ɛtia saa nkurɔfoɔ yi ho","poem":2},{"text":"na worentumi nnyi wo ho mfiri mu.","poem":1},{"text":"Worentumi nnante ahantan so bio,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ ɛbɛyɛ ɛberɛ bɔne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Saa ɛda no, nnipa bɛsere mo.","poem":1},{"text":"Wɔde saa awerɛhoɔ dwom yi","poem":2},{"text":"bɛdi mo ho fɛ sɛ:","poem":1},{"text":"‘wɔasɛe yɛn koraa;","poem":2},{"text":"wɔakyekyɛ me nkurɔfoɔ ahodeɛ mu.","poem":1},{"text":"Ɔgye firi me nsa mu!","poem":2},{"lineBreak":true},{"text":"Na ɔde yɛn mfuo ma akɔnkɔnsafoɔ.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Enti morennya obi wɔ","poem":1},{"text":"Awurade asafo mu","poem":2},{"text":"a ɔde ntontobɔ bɛkyɛ asase no.","poem":1}]},{"type":"heading","content":["Atorɔ Adiyifoɔ"]},{"type":"verse","number":6,"content":[{"text":"“Monnhyɛ nkɔm,” saa na wɔn nkɔmhyɛfoɔ no ka.","poem":1},{"text":"“Monnhyɛ saa nneɛma yi ho nkɔm;","poem":2},{"lineBreak":true},{"text":"animguaseɛ rento yɛn.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ao, Yakob efie, mma monnka nsɛm a ɛte saa.","poem":1},{"text":"Awurade Honhom nni boasetɔ?","poem":2},{"lineBreak":true},{"text":"Ɔyɛ nneɛma a ɛte sei anaa?","poem":2},{"lineBreak":true},{"text":"“Ne nsɛm nyɛ deɛ nʼakwan tene","poem":1},{"text":"no yie anaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akyire no, me nkurɔfoɔ asɔre","poem":1},{"text":"te sɛ asraafoɔ.","poem":2},{"text":"Moworɔ ntadeɛ pa firi","poem":1},{"text":"wɔn a wɔretwam a wɔnni adwemmɔne biara ho,","poem":2},{"lineBreak":true},{"text":"ma wɔyɛ te sɛ asraafoɔ a wɔfiri akono.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mopam mmaa a wɔwɔ me nkurɔfoɔ mu","poem":1},{"text":"firi wɔn afie fɛfɛ mu.","poem":2},{"text":"Mogye me nhyira","poem":1},{"text":"firi wɔn mma nsam afebɔɔ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sɔre, firi ha kɔ!","poem":1},{"text":"Ɛha nyɛ beaeɛ a wɔhome,","poem":2},{"text":"ɛfiri sɛ ɛho agu fi,","poem":1},{"text":"Wɔasɛe no, na ɛrenyɛ yie bio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sɛ ɔtorofoɔ ne ɔdaadaafoɔ ba bɛka sɛ,","poem":1},{"text":"‘Mɛhyɛ nkɔm ama moanya nsã bebree a’","poem":2},{"lineBreak":true},{"text":"ɔbɛyɛ odiyifoɔ a saa nkurɔfoɔ yi pɛ.","poem":2}]},{"type":"heading","content":["Ɔgyeɛ Ho Bɔhyɛ"]},{"type":"verse","number":12,"content":[{"text":"“Mɛboaboa mo nyinaa ano Ao, Yakob;","poem":1},{"text":"nokorɛm mɛka Israel nkaeɛfoɔ no nyinaa abɔ mu.","poem":2},{"text":"Mɛka wɔn abɔ mu te sɛ nnwan a wɔgu nnwammuo mu,","poem":1},{"text":"te sɛ nnwankuo a wɔwɔ adidibea;","poem":2},{"lineBreak":true},{"text":"nnipa bɛhyɛ beaeɛ ho manyamanya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Deɛ ɔbɔ ɛkwan no bɛdi wɔn anim","poem":1},{"text":"wɔbɛbu apono no na wɔafiri akɔ.","poem":2},{"text":"Wɔn ɔhene bɛsene adi wɔn anim,","poem":1},{"text":"Awurade bɛyɛ wɔn ti.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}