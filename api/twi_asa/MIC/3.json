{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_asa","name":"Mika","commonName":"Mika","title":"Odiyifoɔ Mika Nwoma","order":33,"numberOfChapters":7,"sha256":"765357658e8213927712b3bf343fe70f09c7b2022b1aba8e96c5c8dbe45e58c8","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_asa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Ntuanofoɔ Ne Adiyifoɔ Animka"]},{"type":"verse","number":1,"content":["Afei mekaa sɛ,",{"text":"“Montie, mo Yakob ntuanofoɔ,","poem":1},{"text":"mo sodifoɔ a mowɔ Israel efie.","poem":2},{"text":"Ɛsɛ sɛ mohunu deɛ ɛyɛ atɛntenenee,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mo a mokyiri deɛ ɛyɛ na modɔ bɔne","poem":2},{"text":"moworɔ me nkurɔfoɔ wedeɛ","poem":1},{"text":"na motete ɛnam no firi wɔn nnompe ho;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mowe me nkurɔfoɔ nam,","poem":1},{"text":"mowae wɔn wedeɛ,","poem":2},{"lineBreak":true},{"text":"bubu wɔn nnompe mu nketenkete;","poem":2},{"text":"motwitwa wɔn sɛ ɛnam a","poem":1},{"text":"mode regu kwansɛn mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Afei wɔbɛsu afrɛ Awurade,","poem":1},{"text":"nanso ɔrennye wɔn so.","poem":2},{"text":"Saa ɛberɛ no ɔde nʼanim bɛsie wɔn,","poem":1},{"text":"bɔne a wɔayɛ enti.","poem":2}]},{"type":"verse","number":5,"content":["Deɛ Awurade seɛ nie:",{"text":"“Adiyifoɔ a","poem":1},{"text":"wɔdaadaa me nkurɔfoɔ no deɛ,","poem":2},{"text":"obi ma wɔn biribi di a","poem":1},{"text":"wɔpae mu ka asomdwoeɛ nsɛm,","poem":2},{"text":"na sɛ wɔamma wɔn biribi anni a,","poem":1},{"text":"adiyifoɔ no siesie wɔn ho sɛ wɔbɛtu wɔn so sa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti adeɛ bɛsa mo a morennya anisoadehunu,","poem":1},{"text":"esum bɛduru mo a morennya ahintasɛm biara.","poem":2},{"text":"Owia bɛtɔ ama adiyifoɔ no,","poem":1},{"text":"na adekyeɛ bɛdane esum ama wɔn.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Adepɛmuhunufoɔ ani bɛwu","poem":1},{"text":"na wɔbɛgu nsamanfrɛfoɔ anim ase.","poem":2},{"text":"Wɔn nyinaa bɛkatakata wɔn anim,","poem":1},{"text":"ɛfiri sɛ mmuaeɛ biara mfiri Onyankopɔn hɔ mma.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nanso me deɛ tumi ahyɛ me ma,","poem":1},{"text":"Awurade Honhom ahyɛ me ma","poem":2},{"text":"tenenee ne ahoɔden","poem":1},{"text":"a mede bɛpae mu aka","poem":2},{"text":"Yakob amumuyɛ ne Israel bɔne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Montie, mo Yakob efie ntuanofoɔ,","poem":1},{"text":"mo a moyɛ Israel sodifoɔ,","poem":2},{"text":"a mokyiri atɛntenenee","poem":1},{"text":"na mokyea deɛ ɛtene nyinaa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mo a mode mogyahwiegu kyekyeree Sion","poem":1},{"text":"ne awurukasɛm kyekyeree Yerusalem.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nʼadikanfoɔ no gye adanmudeɛ ansa na wabu atɛn,","poem":1},{"text":"nʼasɔfoɔ gye sika ansa na wɔakyerɛkyerɛ,","poem":2},{"text":"nʼadiyifoɔ de nkɔmhyɛ ayɛ sikapɛ.","poem":1},{"text":"Nanso wɔdan Awurade, na wɔka sɛ,","poem":2},{"text":"“Awurade nni yɛn ntam anaa?","poem":1},{"text":"Ɔhaw biara remma yɛn so.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Na mo enti,","poem":1},{"text":"wɔbɛfuntum Sion te sɛ afuo,","poem":2},{"text":"Yerusalem bɛyɛ mmubuiɛ,","poem":1},{"text":"na asɔredan no kokoɔ bɛyɛ sɛ nkɔfie a nkyɛkyerɛ afu wɔ so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}