{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_asa","name":"Mika","commonName":"Mika","title":"Odiyifoɔ Mika Nwoma","order":33,"numberOfChapters":7,"sha256":"765357658e8213927712b3bf343fe70f09c7b2022b1aba8e96c5c8dbe45e58c8","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_asa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Awurade Bepɔ No"]},{"type":"verse","number":1,"content":["Nna a ɛdi akyire no mu no,",{"text":"Awurade asɔredan bepɔ no bɛtim","poem":1},{"text":"sɛ mmepɔ no nyinaa ti;","poem":2},{"text":"ɛbɛgye din aboro nkokoɔ nyinaa,","poem":1},{"text":"na nnipa ahodoɔ bɛbɔ yuu akɔ hɔ.","poem":2}]},{"type":"verse","number":2,"content":["Aman bebree bɛba abɛka sɛ,",{"text":"“Mommra mma yɛnkɔ Awurade bepɔ so,","poem":1},{"text":"Yakob Onyankopɔn efie.","poem":2},{"text":"Ɔbɛkyerɛ yɛn nʼakwan,","poem":1},{"text":"sɛdeɛ yɛbɛnante soɔ.”","poem":2},{"text":"Na mmara no bɛfiri Sion aba","poem":1},{"text":"Awurade asɛm bɛfiri Yerusalem aba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade bɛdi amanaman ntam nsɛm","poem":1},{"text":"Aane ɔbɛsiesie ntawantawa ama aman a wɔyɛ den wɔ mmaa nyinaa.","poem":2},{"text":"Wɔde wɔn akofena bɛbɔ funtumdadeɛ","poem":1},{"text":"wɔde wɔn mpea bɛbɔ nsɔsɔwa.","poem":2},{"text":"Ɔman bi ntwe ɔman foforɔ so akofena,","poem":1},{"text":"na wɔrenyɛ ahoboa biara mma ɔko bio.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obiara bɛtena ne bobe","poem":1},{"text":"anaa ne borɔdɔma nnua ase,","poem":2},{"text":"na obiara remmɛhunahuna wɔn,","poem":1},{"text":"ɛfiri sɛ, Asafo Awurade akasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amanaman no nyinaa bɛtumi anante","poem":1},{"text":"wɔn anyame din mu,","poem":2},{"text":"na yɛn deɛ, yɛbɛnante Awurade,","poem":1},{"text":"yɛn Onyankopɔn Din mu daa daa.","poem":2}]},{"type":"heading","content":["Awurade Atirimpɔ"]},{"type":"verse","number":6,"content":[{"text":"“Saa ɛda no,” sɛdeɛ Awurade seɛ nie,","poem":1},{"text":"“Mɛboaboa mmubuafoɔ, atukɔfoɔ","poem":2},{"lineBreak":true},{"text":"ɛne wɔn a mede awerɛhoɔ aba wɔn so ano.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɛma mmubuafoɔ ayɛ me nkurɔfoɔ wɔ asase no so,","poem":1},{"text":"atukɔfoɔ no bɛyɛ ɔman kɛseɛ.","poem":2},{"text":"Awurade bɛdi wɔn so ɔhene wɔ Sion bepɔ so","poem":1},{"text":"afiri da no akɔsi daa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Na wo, nnwankuo no abantenten,","poem":1},{"text":"Ao, Ɔbabaa Sion, abandenden,","poem":2},{"text":"wɔde wo tete tumidie no bɛsane abrɛ wo;","poem":1},{"text":"Ɔbabaa Yerusalem nsa bɛsane aka nʼahennie.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛdeɛn enti na afei woresu denden,","poem":1},{"text":"wonni ɔhene anaa?","poem":2},{"text":"Wo futufoɔ ayera, na enti,","poem":1},{"text":"ɔyea aka wo sɛ ɔbaa ɔwɔ awokoɔ mu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɔyea enti, nukanuka wo mu, Ao Ɔbabaa Sion,","poem":1},{"text":"te sɛ ɔbaa a awoɔ aka no,","poem":2},{"text":"seesei ɛsɛ sɛ wofiri kuropɔn no mu","poem":1},{"text":"kɔtena ɛserɛ so.","poem":2},{"text":"Wobɛkɔ Babilonia;","poem":1},{"text":"na ɛhɔ na wɔbɛgye woɔ.","poem":2},{"text":"Ɛhɔ na Awurade bɛgye wo","poem":1},{"text":"afiri wʼatamfoɔ nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Seesei deɛ, aman bebree","poem":1},{"text":"aka abɔ mu atia wo.","poem":2},{"text":"Wɔka sɛ, “Wɔngu Sion ho fi,","poem":1},{"text":"na yɛmfa yɛn ani nhwɛ no!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso, wɔnnim Awurade adwene.","poem":1},{"text":"Wɔnte nʼagyinatuo ase.","poem":2},{"text":"Wɔnnim sɛ ɔno na ɔboaboa wɔn ano te sɛ afiafi","poem":1},{"text":"de kɔ ayuporobea.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Sɔre, na pore, Ao Ɔbabaa Sion,","poem":1},{"text":"mɛma wo dadeɛ mmɛn;","poem":2},{"text":"mɛma wo kɔbere ntɔte","poem":1},{"text":"na wobɛbubu aman bebree mu nketenkete.”","poem":2},{"text":"Wode wɔn mfasodeɛ a wɔampɛ no ɛkwan pa so bɛbrɛ Awurade,","poem":1},{"text":"wode wɔn ahonyadeɛ bɛbrɛ asase nyinaa so wura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}