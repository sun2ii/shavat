{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"MIC","translationId":"twi_asa","name":"Mika","commonName":"Mika","title":"Odiyifoɔ Mika Nwoma","order":33,"numberOfChapters":7,"sha256":"765357658e8213927712b3bf343fe70f09c7b2022b1aba8e96c5c8dbe45e58c8","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/twi_asa/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel Ahohia"]},{"type":"verse","number":1,"content":[{"text":"Mayɛ mmɔbɔ!","poem":1},{"lineBreak":true},{"text":"Mete sɛ aduaba tefoɔ a","poem":1},{"text":"otwa berɛ akyi mekɔdi mpɛpɛ wɔ bobe turo mu;","poem":2},{"text":"mennya bobe siaw na madi,","poem":1},{"text":"borɔdɔma aba a ɛdi ɛkan a me kɔn dɔ nso, saa ara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moapra Nyamefɛrefoɔ nyinaa afiri asase so.","poem":1},{"text":"Anka ɔbaako a ɔtene mpo.","poem":2},{"text":"Nnipa nyinaa tetɛ na wɔhwehwɛ sɛ wɔbɛka mogya agu;","poem":1},{"text":"wɔsunsum wɔn ho wɔn ho mfidie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nsa mmienu no nyinaa akokwa bɔneyɛ mu;","poem":1},{"text":"sodifoɔ bisa akyɛdeɛ,","poem":2},{"text":"ɔtemmufoɔ gye adanmudeɛ,","poem":1},{"text":"wɔn a tumi wɔ wɔn nsa mu no yɛ deɛ wɔpɛ,","poem":2},{"lineBreak":true},{"text":"wɔn nyinaa bɔ mu dwene amumuyɛ ho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deɛ ɔyɛ wɔ wɔn mu no te sɛ hwerɛmo;","poem":1},{"text":"deɛ ɔtene pa ara no, nkasɛɛ ban yɛ sene no.","poem":2},{"text":"Wʼatɛmmuda no aso,","poem":1},{"text":"ɛda a Onyankopɔn reba wo nsrahwɛ.","poem":2},{"lineBreak":true},{"text":"Yei ne ɛberɛ a wɔn ani so bɛyɛ wɔn totɔtotɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nnye obiara nni;","poem":1},{"text":"mfa wo werɛ nhyɛ adamfo mu.","poem":2},{"text":"Mpo ɔbaa a ɔda wo koko mu no","poem":1},{"text":"to wo tɛkrɛma nnareka wɔ ne ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔbabarima twiri nʼagya,","poem":1},{"text":"Ɔbabaa sɔre tia ne maame,","poem":2},{"text":"asebaa nso tia nʼase","poem":1},{"text":"na onipa biara atamfoɔ bɛfiri ɔno ankasa ne fiefoɔ mu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me deɛ, mede anidasoɔ hwɛ Awurade,","poem":1},{"text":"Metwɛn me Nkwagyeɛ Onyankopɔn;","poem":2},{"lineBreak":true},{"text":"na me Onyankopɔn bɛtie me.","poem":2}]},{"type":"heading","content":["Israel Bɛsɔre"]},{"type":"verse","number":8,"content":[{"text":"Mma wʼani nnye, me ɔtamfoɔ!","poem":1},{"text":"Mahwe ase deɛ, nanso mɛsɔre.","poem":2},{"text":"Esum aduru me deɛ,","poem":1},{"text":"nanso Awurade bɛyɛ me hann.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sɛ mayɛ bɔne atia no enti,","poem":1},{"text":"Awurade abufuo bɛba me so,","poem":2},{"text":"kɔsi sɛ ɔbɛka mʼasɛm ama me","poem":1},{"text":"na wada me bembuo adi.","poem":2},{"text":"Ɔde me bɛba hann no mu;","poem":1},{"text":"na mɛhunu ne tenenee.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Afei, mʼatamfoɔ bɛhunu","poem":1},{"text":"na wɔn ani bɛwu,","poem":2},{"text":"deɛ ɔsee me sɛ,","poem":1},{"text":"“Ɛhe na Awurade wo Onyankopɔn no wɔ?”","poem":2},{"text":"Mʼani bɛhunu nʼahweaseɛ;","poem":1},{"text":"mpo seesei no, wɔbɛtiatia ne so","poem":2},{"lineBreak":true},{"text":"te sɛ atɛkyɛ a ɛwɔ mmɔntene so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ɛda a wɔbɛto wʼafasuo no bɛba,","poem":1},{"text":"ɛda a wɔbɛtrɛ wʼahyeɛ mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ɛda no, nnipa bɛba wo nkyɛn","poem":1},{"text":"firi Asiria ne Misraim nkuropɔn mu,","poem":2},{"text":"mpo wɔbɛfiri Misraim akɔsi Eufrate","poem":1},{"text":"afiri ɛpo akɔsi ɛpo","poem":2},{"lineBreak":true},{"text":"ne bepɔ so akɔsi bepɔ so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asase no bɛyɛ amanfo ɛsiane nnipa a wɔtete so","poem":1},{"text":"ne wɔn nneyɛɛ enti.","poem":2}]},{"type":"heading","content":["Mpaeɛbɔ Ne Nkamfoɔ"]},{"type":"verse","number":14,"content":[{"text":"Fa wo poma di wo nkurɔfoɔ anim,","poem":1},{"text":"nnwan a wɔyɛ wʼagyapadeɛ no,","poem":2},{"text":"a wɔn nko ara tete kwaeɛ mu","poem":1},{"text":"wira frɔmfrɔm adidibea hɔ.","poem":2},{"text":"Ma wɔn nnidi wɔ Basan ne Gilead","poem":1},{"text":"sɛ tete nna no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mɛyɛ anwanwadeɛ akyerɛ wo,","poem":1},{"text":"sɛdeɛ meyɛɛ nna a wofiri Misraim baeɛ mu no.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aman bɛhunu wo na wɔn ani bɛwu,","poem":1},{"text":"wɔn a tumi nyinaa afiri wɔn nsa no.","poem":2},{"text":"Wɔde wɔn nsa bɛtuatua wɔn ano","poem":1},{"text":"na wɔn aso bɛsisi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wɔbɛdi dɔteɛ sɛ awɔ,","poem":1},{"text":"ne mmoa a wɔwea fam.","poem":2},{"text":"Wɔde ahopopoɔ bɛfiri wɔn abɔn mu aba;","poem":1},{"text":"wɔde suro bɛdane wɔn ho ama Awurade yɛn Onyankopɔn,","poem":2},{"lineBreak":true},{"text":"na wɔbɛsuro wo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hwan na ɔte sɛ wo,","poem":1},{"text":"Onyankopɔn a wode bɔne kyɛ?","poem":2},{"text":"Wo a wode agyanom asefoɔ nkaeɛ amumuyɛ kyɛ wɔn.","poem":1},{"text":"Wʼabofuo nntena hɔ daa","poem":2},{"lineBreak":true},{"text":"na mmom wʼani gye sɛ wobɛda mmɔborɔhunu adi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wobɛhunu yɛn mmɔbɔ bio,","poem":1},{"text":"wobɛtiatia yɛn bɔne so,","poem":2},{"lineBreak":true},{"text":"na woato yɛn amumuyɛ agu ɛpo bunu mu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wobɛyɛ nokwafoɔ ama Yakob","poem":1},{"text":"na wahunu Abraham mmɔbɔ","poem":2},{"text":"sɛdeɛ wokaa yɛn agyanom ntam","poem":1},{"text":"teteete no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}