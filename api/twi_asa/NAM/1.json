{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"NAM","translationId":"twi_asa","name":"Nahum","commonName":"Nahum","title":"Odiyifoɔ Nahum Nwoma","order":34,"numberOfChapters":3,"sha256":"007274d3e176c58f1b971ded19ff099b45672690d809e9786054306d1ec3d8a7","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Elkosini Nahum anisoadehunu nwoma a ɛyɛ nkɔmhyɛ a ɛfa Ninewe ho."]},{"type":"heading","content":["Awurade Abufuo A Ɛtia Ninewe"]},{"type":"verse","number":2,"content":[{"text":"Awurade yɛ ninkunfoɔ ne aweretɔ Onyankopɔn,","poem":1},{"text":"Awurade tɔ wedeɛ na abufuo ahyɛ no ma.","poem":2},{"text":"Awurade tɔ nʼatamfoɔ so wedeɛ","poem":1},{"text":"na nʼabufuo tena wɔn so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade bo kyɛre fu, na ne tumi so,","poem":1},{"text":"na ɔtwe ɔfɔdifoɔ aso.","poem":2},{"text":"Ne kwan wɔ ntwahoframa ne ahum mu,","poem":1},{"text":"omununkum yɛ ne nan ase mfuturo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔteatea ɛpo na ɔma ɛwe;","poem":1},{"text":"ɔma nsubɔntene nyinaa wewe.","poem":2},{"text":"Basan ne Karmel twintwam","poem":1},{"text":"na Lebanon frɔmfrɔmyɛ nso kusa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mmepɔ woso biribiri nʼanim","poem":1},{"text":"na nkokoɔ nane.","poem":2},{"text":"Asase, ewiase ne wɔn a wɔwɔ mu nyinaa","poem":1},{"text":"woso nʼanim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hwan na ɔbɛtumi agyina nʼabufuo ano?","poem":1},{"text":"Hwan na ɔbɛtumi atena nʼabufuhyeɛ mu?","poem":2},{"text":"Nʼabufuo hwie te sɛ ogya;","poem":1},{"text":"abotan yam wɔ nʼanim.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade yɛ,","poem":1},{"text":"ɔyɛ ahohia mu dwanekɔbea.","poem":2},{"text":"Nʼani wɔ wɔn a wɔde wɔn ho to no so no so.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Nanso, ɔnam nsuyire nwanwasoɔ so","poem":2},{"text":"bɛma Ninewe aba awieeɛ.","poem":1},{"text":"Ɔbɛtaa nʼatamfoɔ akɔduru esum kabii mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛpɔ biara a wɔbɛbɔ atia Awurade no,","poem":1},{"text":"ɔbɛsɛe no;","poem":2},{"lineBreak":true},{"text":"ɔhaw biara remma ne mprenu so.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wɔde nkasɛɛ bɛkyekyere wɔn ho,","poem":1},{"text":"na ɛberɛ a wɔn nsa aboro wɔn no","poem":2},{"lineBreak":true},{"text":"wɔbɛhye wɔn sɛ wira dwaneeɛ a wɔaboa ano.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ao, Ninewe, wo mu na","poem":1},{"text":"deɛ ɔbɔ ɛpɔ bɔne tia Awurade","poem":2},{"text":"na ɔtu fo bɔne no firie.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Deɛ Awurade seɛ nie:","poem":1},{"text":"“Ɛwom sɛ wɔwɔ apamfoɔ a wɔdɔɔso deɛ,","poem":2},{"text":"nanso wɔbɛsɛe wɔn ama wɔayera.","poem":1},{"text":"Ao Yuda, ɛwom sɛ mama ɔhaw aba wo so,","poem":2},{"lineBreak":true},{"text":"nanso merenyɛ saa bio.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afei, mɛbubu kɔnnua a ɛda wo kɔn mu","poem":1},{"text":"na matete nkɔnsɔnkɔnsɔn no mu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ninewe, Awurade aka ɔhyɛ asɛm a ɛfa wo ho:","poem":1},{"text":"“Worennya asefoɔ a wo din bɛda wɔn so.","poem":2},{"text":"Mɛsɛe nsɛsodeɛ a wɔasene ne ahoni a wɔaguo","poem":1},{"text":"a ɛsisi wʼabosonnan mu no.","poem":2},{"text":"Mɛsiesie wʼadamena","poem":1},{"text":"ɛfiri sɛ wadane ayɛ atantanneɛ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hwɛ mmepɔ no so,","poem":1},{"text":"deɛ a ɔde asɛmpa no ba no anammɔn","poem":2},{"lineBreak":true},{"text":"ɔno na ɔka asomdwoesɛm!","poem":2},{"text":"Ao, Yuda di wʼafahyɛ na","poem":1},{"text":"di wɔ bɔhyɛ so.","poem":2},{"text":"Nnipa bɔne rentu wo so sa bio;","poem":1},{"text":"Wɔbɛsɛe wɔn pasaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}