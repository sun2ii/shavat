{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"NAM","translationId":"twi_asa","name":"Nahum","commonName":"Nahum","title":"Odiyifoɔ Nahum Nwoma","order":34,"numberOfChapters":3,"sha256":"007274d3e176c58f1b971ded19ff099b45672690d809e9786054306d1ec3d8a7","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Ninewe Asehweɛ"]},{"type":"verse","number":1,"content":[{"text":"Ɔtohyɛsoɔni reba wo so, Ninewe","poem":1},{"text":"bɔ aban no ho ban,","poem":2},{"text":"wɛn ɛkwan no,","poem":1},{"text":"bɔ wo ho so","poem":2},{"text":"na boa wʼahoɔden nyinaa ano!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade de Yakob animuonyam bɛsane ama no","poem":1},{"text":"te sɛ Israel deɛ no,","poem":2},{"text":"ɛwom sɛ, asɛefoɔ no ama ada mpan","poem":1},{"text":"na wɔasɛe ne bobe mfuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asraafoɔ no akokyɛm yɛ kɔkɔɔ;","poem":1},{"text":"akofoɔ no hyehyɛ kɔben akotaadeɛ.","poem":2},{"text":"Nnadeɛ a wɔde yɛɛ nteaseɛnam no","poem":1},{"text":"twa nyinam nyinam sɛ da a wɔyɛeɛ no;","poem":2},{"lineBreak":true},{"text":"mpea a wapoma wɔ nnua so no rehim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nteaseɛnam no twi fa mmɔntene so,","poem":1},{"text":"na wɔdi akɔneaba.","poem":2},{"text":"Wɔte sɛ ogyatɛn a ɛrederɛ;","poem":1},{"text":"wɔbɔ yerɛdɛ te sɛ anyinam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɔfrɛfrɛɛ nʼakofoɔ a wodi mu","poem":1},{"text":"nanso wɔsuntisunti wɔ ɛkwan mu.","poem":2},{"text":"Wɔde mmirika kɔ kuropɔn no afasuo ho;","poem":1},{"text":"na wɔyɛ wɔn akokyɛm krado.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔbuebue asubɔnten apono no,","poem":1},{"text":"na ahemfie no dwiri gu fam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔhyɛ mmaraden sɛ","poem":1},{"text":"wɔmfa kuropɔn no nnommum","poem":2},{"text":"na wɔmfa wɔn nkɔ.","poem":1},{"text":"Ne mfenaa de wɔn nsa gu wɔn koko so","poem":2},{"lineBreak":true},{"text":"su te sɛ mmorɔnoma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninewe te sɛ ɔtadeɛ a","poem":1},{"text":"emu nsuo resene korɔ.","poem":2},{"text":"Woteam sɛ, “Monnyina hɔ! Monnyina hɔ!”","poem":1},{"text":"Nanso, obiara ansane nʼakyi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momfom dwetɛ no!","poem":1},{"text":"Momfom sikakɔkɔɔ no!","poem":2},{"text":"Ahonyadeɛ a ɛwɔ akoradan mu nyinaa!","poem":1},{"text":"Na ahonyadeɛ no dɔɔso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wɔabɔ Ninewe korɔno, wɔayɛ no pasaa!","poem":1},{"text":"Akoma boto, na nkotodwe woso woso,","poem":2},{"lineBreak":true},{"text":"nnipa ho popo na wɔn anim to hoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Seesei ɛhe na gyatabuo no wɔ,","poem":1},{"text":"baabi a wɔma wɔn mma aduane no,","poem":2},{"text":"baabi a gyatanini ne gyatabereɛ korɔ","poem":1},{"text":"na wɔn mma nso kɔ a wɔnsuro?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gyata akum deɛ ɛbɛmee ne mma.","poem":1},{"text":"Wabobɔ ahaboa ama gyatabereɛ no.","poem":2},{"text":"Ɔde deɛ wakum ahyɛ ne bɔn ma","poem":1},{"text":"na ɔde ahaboa ahyɛ nʼatuo mama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Me ne wo nnka,”","poem":1},{"text":"sɛdeɛ Asafo Awurade seɛ ni,","poem":2},{"text":"“Mɛhye wo nteaseɛnam na adane wisie","poem":1},{"text":"na akofena bɛkunkum wʼagyata mma.","poem":2},{"text":"Merennya wo ahaboa biara wɔ asase so.","poem":1},{"text":"Wɔrente wʼasomafoɔ no nne bio.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}