{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"NAM","translationId":"twi_asa","name":"Nahum","commonName":"Nahum","title":"Odiyifoɔ Nahum Nwoma","order":34,"numberOfChapters":3,"sha256":"007274d3e176c58f1b971ded19ff099b45672690d809e9786054306d1ec3d8a7","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Ninewe Nnome"]},{"type":"verse","number":1,"content":[{"text":"Nnome nka mogya kuropɔn","poem":1},{"text":"a atorɔ ne korɔno ahyɛ no ma","poem":2},{"lineBreak":true},{"text":"na amanehunufoɔ mmpa mu da!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apɔnkɔkafoɔ abaa regyegye,","poem":1},{"text":"nteaseɛnam nhankra reyɛ kirididi","poem":2},{"text":"Apɔnkɔ rehurihuri","poem":1},{"text":"ne nteaseɛnam redenkye denkye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Apɔnkɔ ne wɔn sotefoɔ ko kɔ wɔn anim","poem":1},{"text":"akofena twa nyinam nyinam","poem":2},{"lineBreak":true},{"text":"na mpea nso pa yerɛ yerɛ.","poem":2},{"text":"Atɔfoɔ bebree,","poem":1},{"text":"awufoɔ a ebi deda ebi soɔ,","poem":2},{"text":"afunu a wɔntumi nkan wɔn dodoɔ","poem":1},{"text":"a nnipa tiatia soɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yei nyinaa firi odwamanfoɔ bi akɔnnɔ,","poem":1},{"text":"ntafowayifoɔ no nnaadaa dodoɔ no.","poem":2},{"text":"Ɔno na ɔde nʼadwamammɔ tɔn amanaman","poem":1},{"text":"na ɔde nʼabayisɛm tɔn nnipa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Me ne wo nnka,” sɛdeɛ Asafo Awurade seɛ ni,","poem":1},{"text":"“Mɛpagya wʼatadeɛ akɔ soro.","poem":2},{"text":"Mɛma amanaman ahunu wʼadagya","poem":1},{"text":"na ahennie ahodoɔ nso ahunu wʼanimguaseɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mede efi bɛfɔre wo ho,","poem":1},{"text":"mɛbu wo animtia","poem":2},{"lineBreak":true},{"text":"na mama nnipa ahwɛ wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obiara a ɔbɛhunu wo bɛdwane afiri wo ho aka sɛ,","poem":1},{"text":"‘Ninewe abɔ, na hwan na ɔbɛsu no?’","poem":2},{"lineBreak":true},{"text":"Ɛhe na menya obi akyekyere wo werɛ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Woyɛ sene Tebes a","poem":1},{"text":"ɛda Asubɔnten Nil ho a","poem":2},{"lineBreak":true},{"text":"nsuo atwa he ho ahyia anaa?","poem":2},{"text":"Asubɔnten bɔ ne ho ban","poem":1},{"text":"na nsuo yɛ ne fasuo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kus ne Misraim yɛ ne dɔm a wɔntumi nkan wɔn.","poem":1},{"text":"Put ne Libia ka nʼadomfoɔ ho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nanso wɔfaa no dommum","poem":1},{"text":"twaa no asuo.","poem":2},{"text":"Wɔtoo ne mmadoma hwehwee fam","poem":1},{"text":"ma wɔtetee wɔ mmɔntene so.","poem":2},{"text":"Wɔbɔɔ nʼaberempɔn so ntonto,","poem":1},{"text":"na nʼatitire nso wɔde nkɔnsɔnkɔnsɔn guguu wɔn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wo nso wʼani so bɛyɛ wo hagyahagya sɛ ɔsabofoɔ","poem":1},{"text":"Na wo bɛhinta wo ho","poem":2},{"lineBreak":true},{"text":"de akɔpɛ dwanekɔbea wɔ atamfoɔ nkyɛn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wʼaban nyinaa te sɛ borɔdɔma nnua","poem":1},{"text":"a aso aba foforɔ:","poem":2},{"text":"sɛ wɔwoso a","poem":1},{"text":"aba no tete gu ma deɛ ɔrepɛ bi adi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hwɛ wʼakofoɔ","poem":1},{"text":"wɔn nyinaa yɛ mmaa!","poem":2},{"text":"Wʼasase so apono ano deda hɔ ma wʼatamfoɔ;","poem":1},{"text":"ogya ahye wʼapono no akyiri adaban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sesa nsuo sie ma otua no.","poem":1},{"text":"Yere wo banbɔ mu!","poem":2},{"text":"Wɔ dɔteɛ no","poem":1},{"text":"na siesie ntayaa a wato no!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɛhɔ na ogya bɛhye woɔ;","poem":1},{"text":"akofena bɛtwa wo ahwe fam,","poem":2},{"text":"na ayɛ wo sɛdeɛ mmɛbɛ adi wo nam.","poem":1},{"text":"Mo nnɔre sɛ mmɛbɛ anaa ntutummɛ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wama wʼadwadifoɔ adɔɔso,","poem":1},{"text":"wɔn dodoɔ asene ɔsoro nsoromma,","poem":2},{"text":"nanso wɔte sɛ ntutummɛ a wɔbɔ asase no kwaterekwa","poem":1},{"text":"na afei wɔtu kɔ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wʼawɛmfoɔ te sɛ ntutummɛ.","poem":1},{"text":"Wʼadwumayɛfoɔ te sɛ ntutummɛ akuo","poem":2},{"lineBreak":true},{"text":"a wɔsensam ban ho awɔ da.","poem":2},{"text":"Adekyeɛ mu owia pue a wɔtu kɔ,","poem":1},{"text":"na obi nnim faako a wɔkɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ao, Asiriahene wo nnwanhwɛfoɔ retɔ nko.","poem":1},{"text":"Wʼanimuonyamfoɔ deda hɔ rehome.","poem":2},{"text":"Wo nkurɔfoɔ abɔ apete wɔ mmepɔ no so","poem":1},{"text":"a wɔnni anoboaboafoɔ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aduro biara ntumi nkum wʼapirakuro no;","poem":1},{"text":"wo pira no mu yɛ den.","poem":2},{"text":"Obiara a ɔte wo nka no","poem":1},{"text":"bɔ ne nsam wɔ wʼasehweɛ ho,","poem":2},{"text":"Na hwan koraa na wommɔɔ","poem":1},{"text":"no atirimuɔden da?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}