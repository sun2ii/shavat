{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Nhyira ne onipa a","poem":1},{"text":"ɔntie amumuyɛfoɔ afotuo","poem":2},{"text":"na ɔnni nnebɔneyɛfoɔ nhwɛsoɔ akyi","poem":1},{"text":"na ɔntena fɛdifoɔ tenabea.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na mmom, Awurade mmara sɔ nʼani,","poem":1},{"text":"na ɔdwene ho awia ne anadwo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔte sɛ dua a wɔatɛ wɔ asutene ho,","poem":1},{"text":"na ɛso nʼaba ne berɛ mu a","poem":2},{"text":"nʼahahan no nnwan.","poem":1},{"text":"Deɛ ɔyɛ biara yɛ yie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso nnebɔneyɛfoɔ nte saa;","poem":1},{"text":"wɔte sɛ ntɛtɛ a","poem":2},{"lineBreak":true},{"text":"mframa bɔ guo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti amumuyɛfoɔ rentumi nnyina atemmuo no ano,","poem":1},{"text":"na nnebɔneyɛfoɔ nso rentena teneneefoɔ asafo mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɛfiri sɛ Awurade kyerɛ ɔteneneeni kwan","poem":1},{"text":"nanso amumuyɛfoɔ kwan deɛ, ɛbɛyera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}