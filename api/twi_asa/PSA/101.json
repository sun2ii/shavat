{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Dawid Dwom."]},{"type":"verse","number":1,"content":[{"text":"Mɛto wo dɔ ne wo tenenee ho dwom;","poem":1},{"text":"Ao Awurade, mɛto ayɛyie dwom ama wo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɛhwɛ yie abu ɔbra a ɛho teɛ.","poem":1},{"text":"Dabɛn na wobɛba me nkyɛn?","poem":2},{"lineBreak":true},{"text":"Mede akoma a afɔdie nni mu","poem":1},{"text":"bɛnante me fie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meremfa mʼani nsi","poem":1},{"text":"adeɛ a ɛyɛ tane biara so.","poem":2},{"lineBreak":true},{"text":"Mekyiri nnipa a wɔnni gyidie;","poem":1},{"text":"Me ne wɔn nni hwee yɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nnipa a wɔn akoma yɛ kontonkyi remmɛn me;","poem":1},{"text":"me ne bɔne nni hwee yɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Obiara a ɔdi ne yɔnko ho nsekuro wɔ kɔkoam no,","poem":1},{"text":"ɔno na mɛsɛe;","poem":2},{"text":"deɛ ɔwɔ ahantan ani ne ahomasoɔ akoma,","poem":1},{"text":"ɔno na merennyegye ne so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mʼani bɛkɔ anokwafoɔ a wɔwɔ asase no soɔ no so","poem":1},{"text":"na me ne wɔn atena;","poem":2},{"text":"deɛ ne nanteɛ ho nni asɛm no,","poem":1},{"text":"ɔno na ɔbɛsom me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Deɛ ɔyɛ ɔdaadaafoɔ biara","poem":1},{"text":"rentena me fie;","poem":2},{"text":"deɛ ɔtwa nkontompo no","poem":1},{"text":"rennyina mʼanim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Adekyeeɛ biara,","poem":1},{"text":"mɛsɛe amumuyɛfoɔ a wɔwɔ asase yi so nyinaa;","poem":2},{"text":"na mapam ɔdebɔneyɛfoɔ biara","poem":1},{"text":"afiri Awurade kuropɔn mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}