{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, mʼakoma atɔ me yam;","poem":1},{"text":"mede me kra nyinaa bɛto wʼayɛyie dwom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Monyane, sankuo ne bɛnta!","poem":1},{"text":"Mɛnyane anɔpahema.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ao Awurade, mɛkamfo wo wɔ aman no mu;","poem":1},{"text":"mɛto wo ho dwom wɔ nnipa no mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wʼadɔeɛ so, ɛkorɔn sene ɔsoro;","poem":1},{"text":"wo nokorɛdie duru ewiem.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ao Onyankopɔn, ɛsɛ sɛ wɔma wo so tra ɔsoro,","poem":1},{"text":"na ama wʼanimuonyam aba asase nyinaa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fa wo nsa nifa gye yɛn na boa yɛn,","poem":1},{"text":"na ama wɔn a wodɔ wɔn no anya nkwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Onyankopɔn akasa afiri ne kronkronbea sɛ,","poem":1},{"text":"“Nkonim mu na mɛkyɛ Sekem mu","poem":2},{"lineBreak":true},{"text":"na masusu Sukot Bɔnhwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead yɛ me dea; Manase nso saa ara;","poem":1},{"text":"Efraim yɛ me dadeɛ kyɛ,","poem":2},{"lineBreak":true},{"text":"Yuda yɛ mʼahempoma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moab yɛ me dwaresɛn,","poem":1},{"text":"Edom so na meto me mpaboa guo;","poem":2},{"lineBreak":true},{"text":"Filistia so na mebɔ ose.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hwan na ɔde me bɛkɔ kuropɔn a wɔabɔ ho ban no mu?","poem":1},{"text":"Hwan na ɔbɛdi mʼanim akɔ Edom?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ao Onyankopɔn, ɛnyɛ wo na woapo yɛn?","poem":1},{"text":"Wo ne yɛn nsraadɔm renkɔ ɔsa bio anaa?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Boa yɛn tia ɔtamfoɔ no,","poem":1},{"text":"na ɔdasani mmoa nka hwee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onyankopɔn wɔ yɛn afa yi, yɛbɛdi nkonim,","poem":1},{"text":"na ɔbɛtiatia yɛn atamfoɔ so.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ no.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}