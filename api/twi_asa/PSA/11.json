{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade mu na mede me werɛ ahyɛ.","poem":1},{"text":"Adɛn na wotumi ka kyerɛ me sɛ,","poem":2},{"lineBreak":true},{"text":"“Tu te sɛ anomaa kɔ wo bepɔ so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na hwɛ, amumuyɛfoɔ akuntunu wɔn tadua mu,","poem":1},{"text":"na wɔde wɔn mmɛmma asisi nhoma so","poem":2},{"text":"sɛ wɔbɛto wɔ esum mu","poem":1},{"text":"de awɔ akoma mu ahotefoɔ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛ wɔresɛe fapem no a,","poem":1},{"text":"ɛdeɛn na ɔteneneeni bɛtumi ayɛ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awurade wɔ nʼasɔredan kronkron no mu;","poem":1},{"text":"Awurade te ne soro ahennwa so.","poem":2},{"text":"Ɔhwɛ nnipa mma,","poem":1},{"text":"nʼani hwehwɛ wɔn mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awurade hwehwɛ ɔteneneeni mu,","poem":1},{"text":"na amumuyɛfoɔ ne wɔn a wɔpɛ basabasayɛ deɛ,","poem":2},{"lineBreak":true},{"text":"ne kra kyiri wɔn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔbɛtɔ gyaframa ne sɔfe a ɛrederɛ","poem":1},{"text":"agu Amumuyɛfoɔ so;","poem":2},{"lineBreak":true},{"text":"na mframa a emu yɛ hyeɛ bɛyɛ wɔn kyɛfa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade yɛ ɔteneneeni,","poem":1},{"text":"na ɔpɛ atɛntenenee;","poem":2},{"lineBreak":true},{"text":"wɔn a wɔtene no bɛhunu nʼanim.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ sɛ wɔnto no wɔ “Seminit” sankuo nne so.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}