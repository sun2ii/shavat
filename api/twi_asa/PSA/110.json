e":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade wɔ wo nifa so;","poem":1},{"text":"ɔbɛdwerɛ ahemfo wɔ nʼabufuhyeɛ da no.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɔbɛbu amanaman atɛn aboaboa afunu ano;","poem":1},{"text":"na wadwerɛ sodifoɔ a wɔwɔ asase so nyinaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔbɛnom asuwa a ɛda ɛkwan nkyɛn mu nsuo","poem":1},{"text":"enti ɔbɛdi nkonim.","poem":2},{"text":"Ɔhene no bɛnom asuwa a ɛda kwankyɛn mu nsuo,","poem":1},{"text":"na wanya ahoɔden, na wagyina nkonimdie mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}