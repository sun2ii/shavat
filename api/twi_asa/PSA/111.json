{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade!","poem":1},{"lineBreak":true},{"text":"Mɛfiri mʼakoma nyinaa mu ama Awurade so","poem":1},{"text":"wɔ ateneneefoɔ adwabɔ ne asafo no mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade nnwuma yɛ kɛseɛ;","poem":1},{"text":"wɔn a wɔn ani gye ho nyinaa susu ho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne nnwuma yɛ tumi ne animuonyam,","poem":1},{"text":"na ne tenenee wɔ hɔ daa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔma yɛkae nʼanwanwadeɛ;","poem":1},{"text":"Awurade yɛ ɔdomfoɔ ne mmɔborɔhunufoɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɔma wɔn a wosuro no no aduane;","poem":1},{"text":"ɔkae nʼapam no daa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wakyerɛ ne nkurɔfoɔ tumi a ɛwɔ ne nnwuma mu,","poem":1},{"text":"sɛ ɔde aman afoforɔ nsase ama wɔn.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne nsa ano nnwuma yɛ nokorɛ na ɛtene;","poem":1},{"text":"nʼahyɛdeɛ nyinaa mu wɔ ahotosoɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɛtim hɔ daa daa,","poem":1},{"text":"nokorɛ ne tenenee mu na ɔyɛeɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔde ɔgyeɛ maa ne nkurɔfoɔ;","poem":1},{"text":"ɔde nʼapam sii hɔ afebɔɔ,","poem":2},{"lineBreak":true},{"text":"ne din yɛ kronkron na ɛyɛ hu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade suro yɛ nyansa mfitiaseɛ;","poem":1},{"text":"wɔn a wɔdi nʼahyɛdeɛ so nyinaa wɔ nhunumu pa.","poem":2},{"lineBreak":true},{"text":"Ɔno na daa ayɛyie wɔ no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}