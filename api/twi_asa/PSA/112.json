{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Nhyira nka onipa a ɔsuro Awurade","poem":1},{"text":"na ɔnya nʼahyɛdeɛ mu anigyeɛ pii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ne mma bɛyɛ atumfoɔ wɔ asase no so;","poem":1},{"text":"teneneefoɔ awoɔ ntoatoasoɔ bɛnya nhyira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahonya ne sika wɔ ne fie,","poem":1},{"text":"na ne tenenee tena hɔ daa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Esum mu mpo hann pue ma nnipa a wɔtene,","poem":1},{"text":"ma ɔdomfoɔ, mmɔborɔhunufoɔ ne ɔnokwafoɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yiedie bɛba deɛ ne tirim yɛ mmrɛ na ɔde fɛm kwa.","poem":1},{"text":"Yiedie bɛba deɛ ɔde atɛntenenee yɛ ne nneɛma so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ampa ara, ɔrenhinhim da biara da;","poem":1},{"text":"wɔbɛkae onipa tenenee daa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔte asɛmmɔne a, ɛmmɔ ne hu;","poem":1},{"text":"nʼakoma atim wɔ Awurade mu ahotosoɔ mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nʼakoma wɔ banbɔ, na ɔnsuro;","poem":1},{"text":"awieeɛ no, ɔde nkonimdie bɛhyia nʼatamfoɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔto nʼakyɛdeɛ pete aman so ma ahiafoɔ,","poem":1},{"text":"ne tenenee wɔ hɔ daa;","poem":2},{"lineBreak":true},{"text":"wɔbɛkae wɔn daa na wɔahyɛ wɔn animuonyam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omumuyɛfoɔ bɛhunu ama ayɛ no yea,","poem":1},{"text":"ɔbɛtwere ne se na wafɔn;","poem":2},{"lineBreak":true},{"text":"omumuyɛfoɔ tirimpɔ bɛyɛ kwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}