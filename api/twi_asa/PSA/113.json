"content":[{"text":"Ɔma ahiafoɔ so firi mfuturo mu","poem":1},{"text":"na ɔpagya onnibie firi nso sie so;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ɔde wɔn tena mmapɔmma mu,","poem":1},{"text":"wɔn nkurɔfoɔ mmapɔmma mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔbɔ obonini atenaseɛ wɔ ne fie","poem":1},{"text":"sɛ ɔbaatan a nʼani gyeɛ.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}