ntent":[{"text":"Asase, ma wo ho mpopo wɔ Awurade anim,","poem":1},{"text":"wɔ Yakob Onyankopɔn anim,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ɔno na ɔmaa ɔbotan no danee asubura,","poem":1},{"text":"na abotan a ɛyɛ den danee nsuwa nsuwa no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}