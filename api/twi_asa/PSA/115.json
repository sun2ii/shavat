{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Ɛnyɛ yɛn, Ao Awurade, ɛnyɛ yɛn","poem":1},{"text":"na wo din na animuonyam nka,","poem":2},{"lineBreak":true},{"text":"wʼadɔeɛ ne wo nokorɛdie enti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Adɛn enti na aman no bisa sɛ,","poem":1},{"text":"“Wɔn Onyankopɔn wɔ he?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yɛn Onyankopɔn wɔ ɔsoro;","poem":1},{"text":"deɛ ɔpɛ biara na ɔyɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso wɔn ahoni yɛ dwetɛ ne sikakɔkɔɔ a","poem":1},{"text":"wɔde onipa nsa na ayɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔwɔ ano, nanso wɔntumi nkasa;","poem":1},{"text":"wɔwɔ ani, nanso wɔnhunu adeɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wɔwɔ aso, nanso wɔnte asɛm;","poem":1},{"text":"wɔwɔ hwene, nanso wɔnte hwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wɔwɔ nsa, nanso wɔnte nka;","poem":1},{"text":"Wɔwɔ nan, nanso wɔnnante.","poem":2},{"text":"Wɔntumi mma nnyegyeeɛ bi mfiri wɔn mene mu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,","poem":1},{"text":"saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ao Israelfoɔ, momfa mo ho nto Awurade so,","poem":1},{"text":"ɔyɛ mo ɔboafoɔ ne kyɛm.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ao Aaron fie, momfa mo ho nto Awurade so,","poem":1},{"text":"ɔyɛ mo ɔboafoɔ ne kyɛm.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mo a mosuro no, momfa mo ho nto Awurade so,","poem":1},{"text":"ɔyɛ mo ɔboafoɔ ne kyɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Awurade kae yɛn na ɔbɛhyira yɛn:","poem":1},{"text":"Ɔbɛhyira Israel fie,","poem":2},{"lineBreak":true},{"text":"ɔbɛhyira Aaron fie","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ɔbɛhyira wɔn a wɔsuro Awurade,","poem":1},{"text":"nkumaa ne akɛseɛ nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Awurade mma wʼase nnɔre,","poem":1},{"text":"wo ne wo mma.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Awurade nhyira wo,","poem":1},{"text":"ɔsoro ne asase Yɛfoɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔsorosoro yɛ Awurade dea,","poem":1},{"text":"nanso asase deɛ, ɔde ama onipa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɛnyɛ awufoɔ na wɔkamfo Awurade,","poem":1},{"text":"wɔn a wɔkɔ fam dinn no rentumi nkamfo Awurade.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yɛn na yɛma Awurade so","poem":1},{"text":"ɛnnɛ ne daa nyinaa.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}