{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Medɔ Awurade ɛfiri sɛ, ɔtee me nne.","poem":1},{"text":"Ɔtee me mmɔborɔhunu su.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Esiane sɛ ɔbrɛɛ nʼaso maa me enti,","poem":1},{"text":"mɛfrɛ no wɔ ɛberɛ a mete ase yi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Owuo nhoma kyekyeree me,","poem":1},{"text":"ɛda ho ahometeɛ baa me so,","poem":2},{"lineBreak":true},{"text":"ɔhaw ne awerɛhoɔ hyɛɛ me so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Afei mebɔɔ Awurade din kaa sɛ,","poem":1},{"text":"“Ao Awurade, gye me nkwa!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade yɛ ɔdomfoɔ ne ɔteneneeni;","poem":1},{"text":"ayamhyehyeɛ ahyɛ yɛn Onyankopɔn ma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awurade bɔ ɔwɛmfoɔ ho ban;","poem":1},{"text":"ɛberɛ a mewɔ ahohiahia mu no, ɔgyee me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nya abotɔyam bio, Ao me kra,","poem":1},{"text":"ɛfiri sɛ Awurade ne wo adi no yie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na wo, Ao Awurade, woagye me kra afiri owuo mu;","poem":1},{"text":"woamma mʼani amporo nisuo,","poem":2},{"lineBreak":true},{"text":"na woamma me nan ansunti,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"sɛ mɛnante Awurade anim","poem":1},{"text":"wɔ ateasefoɔ asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Megye diiɛ; ɛno enti mekaa sɛ,","poem":1},{"text":"“Mewɔ ahohia kɛseɛ mu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Na mʼabasamtuo mu, mekaa sɛ,","poem":1},{"text":"“Nnipa nyinaa yɛ atorofoɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɛdeɛn na mɛtumi de atua Awurade ka","poem":1},{"text":"wɔ ne papa a wayɛ ama me nyinaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɛma nkwagyeɛ kuruwa no so","poem":1},{"text":"na mabɔ Awurade din.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɛdi ɛbɔ a mahyɛ Awurade no nyinaa so","poem":1},{"text":"wɔ ne nkurɔfoɔ nyinaa anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nʼahotefoɔ wuo","poem":1},{"text":"yɛ aboɔden wɔ Awurade ani so.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ao Awurade, ampa ara meyɛ wo ɔsomfoɔ;","poem":1},{"text":"meyɛ wo ɔsomfoɔ, wʼafenaa babarima;","poem":2},{"lineBreak":true},{"text":"wayi me afiri me mpɔkyerɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɛbɔ aseda afɔdeɛ ama wo","poem":1},{"text":"na mabɔ Awurade din.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɛdi me bɔ a mahyɛ Awurade no so","poem":1},{"text":"wɔ ne nkurɔfoɔ nyinaa anim,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"wɔ adihɔ a ɛwɔ Awurade fie","poem":1},{"text":"wɔ wo mfimfini, Ao Yerusalem.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}