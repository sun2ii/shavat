{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Boa yɛn, Awurade, na nyamesurofoɔ asa;","poem":1},{"text":"nokwafoɔ ayera wɔ nnipa mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Obiara di atorɔ kyerɛ ne yɔnko;","poem":1},{"text":"wɔn ano a ɛdɛfɛdɛfɛ no ka nnaadaasɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma Awurade ntwa nnaadaa ano","poem":1},{"text":"ne tɛkrɛma biara a ɛhoahoa ne ho ntwene;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"wɔn a wɔse, “Yɛde yɛn tɛkrɛma bɛdi nkonim;","poem":1},{"text":"yɛn ano yɛ yɛn dea, na hwan ne yɛn wura?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Esiane nhyɛ a wɔde hyɛ mmɔborɔni no","poem":1},{"text":"ne ohiani apenesie no enti,","poem":2},{"text":"mɛsɔre afei,” Awurade na ɔseɛ.","poem":1},{"text":"“Mɛbɔ wɔn ho ban afiri wɔn a wɔha wɔn ho.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awurade asɛm yɛ nokorɛ","poem":1},{"text":"te sɛ dwetɛ a wɔasɔne so wɔ fononoo mu,","poem":2},{"lineBreak":true},{"text":"na wɔahoa ho mprɛnson.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ao Awurade, wobɛkora yɛn","poem":1},{"text":"na woabɔ yɛn ho ban afebɔɔ afiri saa abɔnefoɔ yi ho,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"abɔnefoɔ a wɔnenam sɛdeɛ wɔpɛ","poem":1},{"text":"ɛberɛ a adasamma de anidie ma afideɛ.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}