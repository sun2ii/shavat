text":"Awurade bɛbɔ wo ho ban afiri ɔhaw nyinaa ho,","poem":1},{"text":"ɔbɛhwɛ wo nkwa so;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade bɛhwɛ wʼadifire ne wo efieba so,","poem":1},{"text":"seesei ne daa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}