{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["Ɔsoroforɔ dwom."]},{"type":"verse","number":1,"content":[{"text":"Wɔn a wɔde wɔn ho to Awurade so no te sɛ Bepɔ Sion,","poem":1},{"text":"a ɛnwosoɔ na ɛtim hɔ daa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sɛdeɛ mmepɔ atwa Yerusalem ho ahyia no,","poem":1},{"text":"saa ara na Awurade atwa ne nkurɔfoɔ ho ahyia","poem":2},{"lineBreak":true},{"text":"seesei ne daa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amumuyɛfoɔ ahempoma renka asase a","poem":1},{"text":"wɔde ama teneneefoɔ so.","poem":2},{"text":"Sɛ ɛba saa a, teneneefoɔ","poem":1},{"text":"nam wɔn so bɛyɛ bɔne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ao Awurade, wɔn a wɔyɛ papa no, yɛ wɔn papa,","poem":1},{"text":"wɔn a wɔtene wɔ akoma mu no, yɛ wɔn papa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na wɔn a wɔmane fa akwan kɔntɔnkye so no deɛ,","poem":1},{"text":"Awurade bɛpamo wɔn ne nnebɔneyɛfoɔ.","poem":2},{"lineBreak":true},{"text":"Asomdwoeɛ nka Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}