{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Ɔsoroforɔ dwom. Salomo deɛ."]},{"type":"verse","number":1,"content":[{"text":"Sɛ Awurade ansi ɛdan no a,","poem":1},{"text":"adansifoɔ no yɛ ho adwuma kwa.","poem":2},{"text":"Sɛ Awurade ammɔ kuropɔn no ho ban a,","poem":1},{"text":"awɛmfoɔ no wɛn kwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɔkwa ara na wosɔre anɔpahema","poem":1},{"text":"na woyɛ adwumaden brɛ kɔsi anadwo,","poem":2},{"text":"ansa na woanya wʼano aduane.","poem":1},{"text":"Ɛyɛ kwa, ɛfiri sɛ, wɔn a ɔdɔ wɔn no, ɔma wɔda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mmammarima yɛ agyapadeɛ a ɛfiri Awurade hɔ,","poem":1},{"text":"na mma yɛ akatua a ɛfiri noɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mmammarima a wɔwo wɔn mmeranteberɛ mu no","poem":1},{"text":"te sɛ agyan a ɛhyɛ ɔsraani nsam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhyira ne onipa a","poem":1},{"text":"nʼagyan kotokuo ayɛ ma.","poem":2},{"text":"Wɔn anim rengu ase","poem":1},{"text":"ɛberɛ a wɔahyia wɔn atamfoɔ wɔ kuro ɛpono ano.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}