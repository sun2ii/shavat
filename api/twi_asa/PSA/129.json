","number":7,"content":[{"lineBreak":true},{"text":"Ɛremma otwafoɔ nya biribi wɔ ne nsam,","poem":1},{"text":"na deɛ ɔboaboa ano nso renya hwee nʼabasa so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mma wɔn a wɔtwam hɔ nnka sɛ,","poem":1},{"text":"“Awurade nhyira mmra mo so;","poem":2},{"lineBreak":true},{"text":"yɛhyira mo wɔ Awurade din mu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}