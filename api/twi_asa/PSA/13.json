{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao, Awurade, ɛnkɔsi da bɛn? Wo werɛ bɛfiri me afebɔɔ anaa?","poem":1},{"text":"Ɛnkɔsi da bɛn na wode wʼanim bɛhinta me?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɛnkɔsi da bɛn na mene mʼadwendwene bɛdi apereapereɛ","poem":1},{"text":"na awerɛhoɔ ahyɛ mʼakoma mu daa?","poem":2},{"lineBreak":true},{"text":"Mʼatamfoɔ nni me so nkonim nkɔsi da bɛn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Te wʼani hwɛ me na bua me, Ao, Awurade, me Onyankopɔn.","poem":1},{"text":"Ma mʼani so nyɛ hann, na manna owuo nna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me ɔtamfoɔ bɛka sɛ, “Madi ne so nkonim.”","poem":1},{"text":"Na mʼahohiahiafoɔ bɛdi ahurisie ɛberɛ a mahwe ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nanso mede me ho to wo dɔ a ɛnsa da no so;","poem":1},{"text":"mʼakoma di ahurisie wɔ wo nkwagyeɛ mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɛto dwom ama Awurade,","poem":1},{"text":"ɛfiri sɛ ɔne me adi no yie.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ no.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}