{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Ɔsorokorɔ dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao Awurade, mefiri ebunu mu resu frɛ wo;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ao Awurade tie me nne.","poem":2},{"text":"Wɛn wʼaso","poem":1},{"text":"ma me nkotosrɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ao Awurade, sɛ wobu yɛn bɔne ho nkonta a,","poem":1},{"text":"anka hwan na ɔbɛtumi agyina ano?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso, wowɔ bɔnefakyɛ;","poem":1},{"text":"ɛno enti wɔsuro wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Metwɛn Awurade, me kra twɛn,","poem":1},{"text":"na nʼasɛm mu na mede mʼanidasoɔ ahyɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Me kra twɛne Awurade","poem":1},{"text":"sene sɛdeɛ awɛmfoɔ twɛne adekyeɛ,","poem":2},{"lineBreak":true},{"text":"sene sɛdeɛ awɛmfoɔ twene adekyeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ao Israel, ma wʼani nna Awurade so,","poem":1},{"text":"ɛfiri sɛ Awurade wɔ adɔeɛ a ɛwɔ hɔ daa","poem":2},{"lineBreak":true},{"text":"na ɔgyeɛ amapa wɔ ne mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ɔno ankasa bɛgye Israel","poem":1},{"text":"afiri wɔn bɔne nyinaa mu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}