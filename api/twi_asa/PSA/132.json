"text":"momma yɛnsom wɔ ne nan ntiasoɔ hɔ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘Ao Awurade, sɔre bra wʼahomegyebea,","poem":1},{"text":"wo ne wo tumi Adaka no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ma tenenee nyɛ sɛ ntadeɛ mma wʼasɔfoɔ;","poem":1},{"text":"ma wʼahotefoɔ nto ahurisie dwom.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wo ɔsomfoɔ Dawid enti,","poem":1},{"text":"nyi wʼani mfiri deɛ woasra no ngo no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Awurade kaa ntam kyerɛɛ Dawid,","poem":1},{"text":"nokorɛ ntam a ɔrentwe nsane sɛ,","poem":2},{"text":"“Wʼasefoɔ no mu baako","poem":1},{"text":"na mede no bɛtena wʼahennwa so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sɛ wo mmammarima di mʼapam so","poem":1},{"text":"na wɔtie me nkyerɛkyerɛ a,","poem":2},{"text":"ɛnneɛ wɔn mmammarima bɛtena","poem":1},{"text":"wʼahennwa so afebɔɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Awurade ayi Sion,","poem":1},{"lineBreak":true},{"text":"ɔde hɔ ayɛ nʼatenaeɛ:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Ɛha ne mʼahomegyebea daa nyinaa;","poem":1},{"text":"ɛha na mɛtena adi ɔhene, ɛfiri sɛ ɛha na mepɛ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mede nneɛma pa bebree bɛhyira no","poem":1},{"text":"na mama nʼahiafoɔ adidi amee.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mede nkwagyeɛ bɛfira nʼasɔfoɔ","poem":1},{"text":"na nʼahotefoɔ ato ahurisie dwom daa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mɛma ɔberempɔn bi apue wɔ Dawid ahennie mu","poem":1},{"text":"na mede kanea asi hɔ ama deɛ masra no ngo no.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mede aniwuo bɛfira nʼatamfoɔ,","poem":1},{"text":"nanso nʼahenkyɛ bɛhyerɛn wɔ ne tiri so.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}