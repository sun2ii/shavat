{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Monkamfo Awurade din;","poem":1},{"text":"monkamfo no, mo Awurade asomfoɔ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mo a mosom wɔ Awurade fie,","poem":1},{"text":"wɔ adihɔ a ɛwɔ yɛn Onyankopɔn fie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Monkamfo Awurade ɛfiri sɛ ɔyɛ;","poem":1},{"text":"monto ayɛyie dwom mma ne din, na ɛno na ɛyɛ anisɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Awurade ayi Yakob sɛ ɔnyɛ ne deɛ,","poem":1},{"text":"wayi Israel sɛ nʼadeɛ a ɛsom bo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Menim sɛ Awurade so;","poem":1},{"text":"Ɔso sene anyame nyinaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awurade yɛ deɛ ɔpɛ biara,","poem":1},{"text":"wɔ ɔsoro ne asase so,","poem":2},{"lineBreak":true},{"text":"ɛpo ne emu abunu nyinaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔma omununkum ma ne ho so firi asase ano ba;","poem":1},{"text":"ɔsoma anyinam ka osutɔ ho","poem":2},{"lineBreak":true},{"text":"na ɔma ahum tu firi nʼakoradan mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɔkumm Misraim mmakan,","poem":1},{"text":"nnipa ne mmoa mmakan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔsomaa ne nsɛnkyerɛnneɛ ne nʼanwanwadeɛ baa mo mfimfini, Ao Misraim,","poem":1},{"text":"de tiaa Farao ne nʼasomfoɔ nyinaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɔsɛee amanaman pii","poem":1},{"text":"na ɔkunkumm ahemfo akɛseɛ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amorifoɔ ɔhene, Sihon","poem":1},{"text":"Basan ɔhene, Og","poem":2},{"lineBreak":true},{"text":"ne Kanaan ahemfo nyinaa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"na ɔde wɔn nsase maa sɛ agyapadeɛ;","poem":1},{"text":"ɔde maa ne nkurɔfoɔ Israelfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ao Awurade, wo din wɔ hɔ daa.","poem":1},{"text":"Ao Awurade wo din ahyeta awoɔ ntoatoasoɔ nyinaa mu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Awurade bɛdi ama ne nkurɔfoɔ","poem":1},{"lineBreak":true},{"text":"na ɔbɛhunu nʼasomfoɔ mmɔbɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Amanaman no ahoni yɛ dwetɛ ne sikakɔkɔɔ","poem":1},{"text":"a wɔde onipa nsa na ayɛ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wɔwɔ ano, nanso wɔntumi nkasa,","poem":1},{"text":"wɔwɔ ani, nanso wɔnhunu adeɛ;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"wɔwɔ aso, nanso wɔnte asɛm,","poem":1},{"text":"na ahomeɛ nso nni wɔn anom.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,","poem":1},{"text":"saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Monkamfo Awurade, Ao Israel fiefoɔ;","poem":1},{"text":"monkamfo Awurade, Ao Aaron fiefoɔ;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"monkamfo Awurade, Ao Lewi fiefoɔ;","poem":1},{"text":"monkamfo Awurade, mo a mosuro no.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Momfiri Sion nkamfo Awurade,","poem":1},{"text":"monkamfo deɛ ɔte Yerusalem no.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}