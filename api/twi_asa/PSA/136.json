{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Monna Awurade ase na ɔyɛ.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":2,"content":[{"text":"Monna anyame mu Onyankopɔn ase.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":3,"content":[{"text":"Monna awuranom mu Awurade no ase.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":4,"content":[{"text":"Ɔno nko ara na ɔyɛ anwanwadeɛ akɛseɛ.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":5,"content":[{"text":"Ɔno na ɔfiri ne nteaseɛ mu bɔɔ ɔsoro.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":6,"content":[{"text":"Ɔno na ɔtrɛɛ asase mu de kataa nsuo so.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":7,"content":[{"text":"Ɔno na ɔbɔɔ nkanea akɛseɛ no.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":8,"content":[{"text":"Ɔbɔɔ owia sɛ ɛnni adekyeeɛ so.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":9,"content":[{"text":"Ɔbɔɔ ɔsrane ne nsoromma sɛ wɔnni adesaeɛ so no.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔno na ɔkunkumm Misraimfoɔ mmakan,","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":11,"content":[{"text":"na ɔyii Israelfoɔ firii wɔn mu no.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":12,"content":[{"text":"Ɔde nsa kɛseɛ ne basa a watene mu.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":13,"content":[{"text":"Ɔno na ɔpaee Ɛpo Kɔkɔɔ no mu no,","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":14,"content":[{"text":"na ɔde Israelfoɔ faa mfimfini no.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":15,"content":[{"text":"Nanso, ɔpraa Farao ne nʼasraafoɔ guu Ɛpo Kɔkɔɔ mu no.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔno na ɔdii ne nkurɔfoɔ anim wɔ ɛserɛ no so.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ɔno na ɔkumm ahemfo akɛseɛ no,","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":18,"content":[{"text":"na ɔkumm ahemfo akunini no.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":19,"content":[{"text":"Ɔkumm Amorifoɔ ɔhene, Sihon,","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":20,"content":[{"text":"ne Basanhene, Og.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":21,"content":[{"text":"Na ɔde wɔn nsase maa sɛ agyapadeɛ.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":22,"content":[{"text":"Ɔde maa ne ɔsomfoɔ Israel sɛ agyapadeɛ.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ɔkaee yɛn, yɛn mmerɛyɛ mu.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":24,"content":[{"text":"Na ɔgyee yɛn firii yɛn atamfoɔ nsam.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"verse","number":25,"content":[{"text":"Ɔno na ɔma abɔdeɛ biara aduane.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Monna ɔsorosoro Onyankopɔn no ase.","poem":1},"Nʼadɔeɛ wɔ hɔ daa."]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}