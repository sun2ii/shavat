{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Babilonia nsubɔntene ho, ɛhɔ na yɛtena suiɛ","poem":1},{"text":"ɛberɛ a yɛkaee Sion no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɛhɔ nsukakye nnua so","poem":1},{"text":"na yɛde yɛn asankuo sensɛneeɛ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ɛhɔ na yɛn nnommumfafoɔ bisaa yɛn nnwom,","poem":1},{"text":"yɛn ahohiahiafoɔ pɛɛ yɛn hɔ ahurisie nnwom;","poem":2},{"lineBreak":true},{"text":"wɔkaa sɛ, “Monto Sion nnwom baako mma yɛn!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɛbɛyɛ dɛn na yɛatumi ato Awurade nnwom","poem":1},{"text":"ɛberɛ a yɛwɔ ananafoɔ asase so?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ao Yerusalem, sɛ mewerɛ firi wo a","poem":1},{"text":"ma me nsa nifa werɛ mfiri sankubɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sɛ mankae wo sɛ mʼanigyedeɛ kɛseɛ pa ara a,","poem":1},{"text":"ma me tɛkrɛma nka mfam mʼanomu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ao Awurade, kae deɛ Edomfoɔ yɛeɛ","poem":1},{"text":"wɔ ɛda a Yerusalem hwee ase no.","poem":2},{"text":"Wɔteam sɛ, “Monnwiri,","poem":1},{"text":"monnwiri ngu fam nkɔka nʼafapem!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ao Babilonia babaa a wɔahyɛ sɛ wɔbɛsɛe wo,","poem":1},{"text":"nhyira nka deɛ ɔtua wo ka","poem":2},{"lineBreak":true},{"text":"wɔ deɛ wode ayɛ yɛn so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nhyira nka deɛ ɔkyekyee wo nkokoaa","poem":1},{"text":"de wɔn bobɔɔ abotan so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}