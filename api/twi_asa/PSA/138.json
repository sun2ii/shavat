{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Dawid deɛ."]},{"type":"verse","number":1,"content":[{"text":"Ao Awurade, mɛfiri mʼakoma nyinaa mu ayi wo ayɛ;","poem":1},{"text":"mɛto wʼayɛyie dwom wɔ anyame no anim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mede mʼani bɛkyerɛ wʼasɔredan kronkron no, akoto wo","poem":1},{"text":"na makamfo wo din","poem":2},{"lineBreak":true},{"text":"wɔ wʼadɔeɛ ne wo nokorɛdie enti","poem":2},{"text":"ɛfiri sɛ wɔapagya wo din ne wʼasɛm no","poem":1},{"text":"asene nneɛma nyinaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɛberɛ a mesu mefrɛɛ wo no, wogyee me so;","poem":1},{"text":"womaa me nyaa akokoɔduru ne nnamyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ao Awurade, sɛ ahemfo a ɛwɔ ewiase nyinaa te wʼanomu asɛm a","poem":1},{"text":"ma wɔn nkamfo wo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ma wɔnto Awurade akwan ho nnwom,","poem":1},{"text":"na Awurade animuonyam yɛ kɛseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɛwom sɛ Awurade wɔ ɔsorosoro deɛ, nanso ɔhwɛ mmɔborɔfoɔ,","poem":1},{"text":"na ahantanfoɔ deɛ, ɔhunu wɔn akyirikyiri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɛwom sɛ menam ɔhaw mu deɛ,","poem":1},{"text":"nanso wobɔ me nkwa ho ban;","poem":2},{"text":"wotene wo nsa wɔ mʼatamfoɔ abufuo so,","poem":1},{"text":"na wode wo nsa nifa gye me nkwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade bɛma deɛ wahyehyɛ ama me no aba mu;","poem":1},{"text":"Ao Awurade, wʼadɔeɛ wɔ hɔ daa,","poem":2},{"lineBreak":true},{"text":"nnyaa wo nsa ano adwuma hɔ.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}