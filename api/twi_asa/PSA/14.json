{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ɔkwasea ka wɔ nʼakoma mu sɛ,","poem":1},{"text":"“Onyankopɔn bi nni hɔ.”","poem":2},{"text":"Wɔaporɔ, na wɔn nneyɛɛ yɛ fi","poem":1},{"text":"na wɔn mu biara nni hɔ a ɔyɛ ade pa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awurade firi ɔsoro hwɛ","poem":1},{"text":"adasamma","poem":2},{"text":"sɛ ɔbɛhunu wɔn mu bi a wɔwɔ nteaseɛ,","poem":1},{"text":"anaa ebinom a wɔhwehwɛ Onyankopɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanso nnipa nyinaa atwe wɔn ho afiri Onyankopɔn ho;","poem":1},{"text":"wɔn nyinaa ayɛ bɔne.","poem":2},{"text":"Obiara nni hɔ a ɔyɛ papa.","poem":1},{"text":"Ɔbaako mpo nni hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Enti nnebɔneyɛfoɔ rensua nyansa anaa?","poem":1},{"lineBreak":true},{"text":"Wɔwe me nkurɔfoɔ te sɛ deɛ nnipa di aduane.","poem":1},{"text":"Wɔnnsu mfrɛ Awurade?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔn nie, ehu akyekyere wɔn,","poem":1},{"text":"ɛfiri sɛ Onyankopɔn te wɔn a wɔtene mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mo nnebɔneyɛfoɔ sɛe ahiafoɔ nhyehyɛeɛ,","poem":1},{"text":"nanso, Awurade ne wɔn dwanekɔbea.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ao, ma Israel nkwagyeɛ mfiri Sion mmra!","poem":1},{"text":"Awurade bɛsane de ne nkurɔfoɔ agyapadeɛ ama wɔn.","poem":2},{"lineBreak":true},{"text":"Na Yakob adi ahurisie, na Israel ani agye!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}