{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Dawid deɛ. Ɛberɛ a na ɔwɔ ɔbodan mu no. Mpaeɛbɔ."]},{"type":"verse","number":1,"content":[{"text":"Meteam mesu frɛ Awurade;","poem":1},{"text":"me ma me nne so su frɛ Awurade sɛ ɔnhunu me mmɔbɔ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mehwie mʼahiasɛm megu nʼanim;","poem":1},{"text":"meka me haw kyerɛ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sɛ me ɔkra tɔ baha wɔ me mu a,","poem":1},{"text":"ɛyɛ wo na wonim mʼakwan.","poem":2},{"text":"Ɛkwan a menam so no","poem":1},{"text":"nnipa asum me afidie wɔ so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hwɛ me nifa so na hunu sɛ;","poem":1},{"text":"mʼasɛm mfa obiara ho;","poem":2},{"text":"menni dwanekɔbea bi;","poem":1},{"text":"me nkwa mfa obiara ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ao Awurade, mesu mefrɛ wo;","poem":1},{"text":"mese, “Wone me dwanekɔbea,","poem":2},{"lineBreak":true},{"text":"me kyɛfa wɔ ateasefoɔ asase so.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tie me sufrɛ,","poem":1},{"text":"na mewɔ ahohia kɛseɛ mu;","poem":2},{"text":"gye me firi mʼataafoɔ nsam,","poem":1},{"text":"ɛfiri sɛ wɔn ho yɛ den sene me.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yi me firi me nneduadan mu,","poem":1},{"text":"na makamfo wo din.","poem":2},{"lineBreak":true},{"text":"Afei teneneefoɔ bɛtwa me ho ahyia","poem":1},{"text":"ɛsiane wo papa a woayɛ me enti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}