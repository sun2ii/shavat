{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Ao me ɔkra, kamfo Awurade!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɛkamfo Awurade me nkwa nna nyinaa;","poem":1},{"text":"mɛto ayɛyi dwom ama me Onyankopɔn, sɛ mete ase yi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mommfa mo ho nto mmapɔmma so,","poem":1},{"text":"adasamma a wɔrentumi nnye nkwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sɛ wɔn honhom tu kɔ a, wɔsane kɔ dɔteɛ mu,","poem":1},{"text":"saa da no ara wɔn nsusuiɛ nyinaa yɛ kwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhyira ne deɛ ne ɔboafoɔ ne Yakob Onyankopɔn,","poem":1},{"text":"deɛ nʼanidasoɔ wɔ Awurade, ne Onyankopɔn mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɔno ne ɔsoro ne asase Yɛfoɔ,","poem":1},{"text":"ɛpo ne biribiara a ɛwɔ mu nyinaa","poem":2},{"lineBreak":true},{"text":"Awurade a ɔyɛ nokwafoɔ daa no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔdi ma wɔn a wɔhyɛ wɔn so,","poem":1},{"text":"na ɔma wɔn a ɛkɔm de wɔn aduane.","poem":2},{"lineBreak":true},{"text":"Awurade gyaa nneduafoɔ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade ma anifirafoɔ hunu adeɛ.","poem":1},{"text":"Awurade pagya wɔn a wɔakom.","poem":2},{"lineBreak":true},{"text":"Awurade dɔ teneneefoɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade hwɛ ahɔhoɔ so","poem":1},{"text":"na ɔwowa nwisiaa ne akunafoɔ,","poem":2},{"lineBreak":true},{"text":"na amumuyɛfoɔ akwan deɛ, ɔdane ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sion, Awurade wo Onyankopɔn di ɔhene daa daa,","poem":1},{"text":"wɔ awoɔ ntoatoasoɔ nyinaa so.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}