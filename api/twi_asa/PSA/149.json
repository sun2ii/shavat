{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Monkamfo Awurade.","poem":1},{"lineBreak":true},{"text":"Monto dwom foforɔ mma Awurade,","poem":1},{"text":"monkamfo no wɔ ahotefoɔ asafo mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ma Israel ani nnye ne Yɛfoɔ mu.","poem":1},{"text":"Ma Sion mma ani nnye wɔn Ɔhene mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma wɔmfa asa nkamfo ne din","poem":1},{"text":"na wɔmfa sankuo ne akasaeɛ nto dwom mma no.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na Awurade ani sɔ ne nkurɔfoɔ;","poem":1},{"text":"ɔde nkwagyeɛ kyɛ hyɛ ahobrɛasefoɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momma ahotefoɔ nni ahurisie wɔ animuonyam yi mu;","poem":1},{"text":"na wɔnto ahosɛpɛ dwom wɔ wɔn mpa so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Onyankopɔn nkamfo nhyɛ wɔn anomu","poem":1},{"text":"na ɛnyɛ akofena anofanu wɔ wɔn nsam,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"sɛ wɔmfa ntɔ werɛ wɔ amanaman no so","poem":1},{"text":"ne asotwe wɔ nnipa no so,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"sɛ wɔmfa nyɛ nkɔnsɔnkɔnsɔn nkyekyere wɔn ahemfo,","poem":1},{"text":"ne dadeɛ mpɔkyerɛ ngu wɔn atitire,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"sɛ wɔmfa mmu atɛn sɛdeɛ wɔatwerɛ atia wɔn no.","poem":1},{"text":"Yei ne nʼahotefoɔ nyinaa animuonyam.","poem":2},{"lineBreak":true},{"text":"Monkamfo Awurade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}