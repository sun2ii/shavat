{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Dawid mpaeɛbɔ."]},{"type":"verse","number":1,"content":[{"text":"Bɔ me ho ban, Ao Onyankopɔn,","poem":1},{"text":"na wo mu na menya hintabea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Meka kyerɛɛ Awurade sɛ,","poem":1},{"text":"“MʼAwurade ne wo;","poem":2},{"lineBreak":true},{"text":"menni adepa biara ka wo ho.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahotefoɔ a wɔwɔ asase no so deɛ,","poem":1},{"text":"wɔne animuonyamfoɔ a","poem":2},{"lineBreak":true},{"text":"mʼanigyeɛ wɔ wɔn mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wɔn a wɔdi anyame afoforɔ akyire no","poem":1},{"text":"wɔn awerɛhoɔ bɛdɔɔso.","poem":2},{"text":"Merenyi wɔn mogya apaeɛ no bi","poem":1},{"text":"na meremfa mʼano memmɔ wɔn din.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade, wode me kyɛfa ne me kuruwa ama me;","poem":1},{"text":"woama me kyɛfa anya banbɔ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mʼahyeɛ akɔdeda mmea a ɛhɔ yɛ ahomeka;","poem":1},{"text":"ampa ara mewɔ agyapadeɛ a ɛho yɛ anigye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɛkamfo Awurade a ɔtu me fo;","poem":1},{"text":"na anadwo mpo mʼakoma kyerɛkyerɛ me.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mehunu Awurade wɔ mʼani so daa nyinaa.","poem":1},{"text":"Esiane sɛ ɔwɔ me nsa nifa enti, merenhinhim da.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛno enti, me kra ani gye, na mede me tɛkrɛma di ahurisie;","poem":1},{"text":"me onipadua nso bɛhome asomdwoeɛ mu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ɛfiri sɛ, worennya me awufoɔ mu.","poem":1},{"text":"Na woremma wo Kronkronni no mporɔ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Woakyerɛ me nkwagyeɛ kwan,","poem":1},{"text":"na wobɛma mʼani agye wɔ wʼanim,","poem":2},{"lineBreak":true},{"text":"na anika a ɛrensa da wɔ wo nifa so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}