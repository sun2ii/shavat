{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ɔsoro ka Onyankopɔn animuonyam ho asɛm!","poem":1},{"text":"Ewiem pae mu ka ne nsa ano adwuma,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɛda biara, wɔkasa;","poem":1},{"text":"anadwo biara, wɔkyerɛ nimdeɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔkasa anaa nsɛm nnim","poem":1},{"text":"na wɔnnte wɔn nne.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso wɔn asɛm akɔduru asase so mmaa nyinaa,","poem":1},{"text":"wɔn nsɛm nso akɔduru asase ano.","poem":2},{"lineBreak":true},{"text":"Wɔ ɔsoro hɔ, wasi ntomadan ama owia,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"a ɔte sɛ ayeforɔkunu a ɔfiri ne pia mu,","poem":2},{"lineBreak":true},{"text":"te sɛ ɔbrane a ne ho pere no sɛ ɔbɛtu ne mmirika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛpue wɔ ɔsoro fa baabi","poem":1},{"text":"na atwa ne ho akɔsi ano;","poem":2},{"lineBreak":true},{"text":"biribiara nhinta ne hyeɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Awurade mmara yɛ pɛ,","poem":1},{"text":"ɛkanyane ɔkra no.","poem":2},{"text":"Ahotosoɔ wɔ Awurade nhyehyɛeɛ mu,","poem":1},{"text":"ɛma deɛ ɔnnim nyansa hunu nyansa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awurade ahyɛdeɛ tene;","poem":1},{"text":"ɛma akoma mu anigyeɛ.","poem":2},{"text":"Awurade ɔhyɛ nsɛm mu da hɔ;","poem":1},{"text":"na ɛbue ani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade suro yɛ kronn,","poem":1},{"text":"ɛte hɔ daa.","poem":2},{"text":"Awurade mmaransɛm yɛ nokorɛ","poem":1},{"text":"na ne nyinaa tene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɛsom bo sene sikakɔkɔɔ","poem":1},{"text":"sene sikakɔkɔɔ amapa mpo;","poem":2},{"text":"ɛyɛ dɛ sene ɛwoɔ,","poem":1},{"text":"sene ɛwoɔ a ɛfiri ɛwokyɛm mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wɔnam so bɔ wo ɔsomfoɔ kɔkɔ sɛ,","poem":1},{"text":"ɛsodie so akatua yɛ bebree.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hwan na ɔhunu nʼankasa mfomsoɔ?","poem":1},{"text":"Fa me mfomsoɔ a ahinta kyɛ me.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bɔ wʼakoa ho ban firi ɔboayɛ bɔne ho,","poem":1},{"text":"na anhyɛ me so.","poem":2},{"text":"Ɛno na ɛbɛma madi bem,","poem":1},{"text":"a merenni fɔ wɔ bɔne akɛseɛ ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ma mʼanom nsɛm ne mʼakoma mu mpaeɛbɔ","poem":1},{"text":"nyɛ deɛ ɛsɔ wʼani, Ao Awurade","poem":2},{"lineBreak":true},{"text":"me Botan ne me Gyefoɔ.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}