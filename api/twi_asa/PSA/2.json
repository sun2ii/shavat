{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Adɛn enti na amanamanmufoɔ no bo afu?","poem":1},{"text":"Adɛn enti na wɔsɛe mmerɛ yɛ nhyehyɛeɛ hunu yi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asase so ahemfo sɔre gyina","poem":1},{"text":"na atumfoɔ bom tu agyina","poem":2},{"lineBreak":true},{"text":"tia Awurade ne Deɛ Wɔasra no no.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wɔka sɛ,","poem":1},{"text":"“Momma yɛmmubu wɔn nkɔnsɔnkɔnsɔn","poem":2},{"lineBreak":true},{"text":"na yɛnto wɔn mpokyerɛ ngu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Deɛ ɔte adwa so wɔ soro no sere;","poem":1},{"text":"Awurade di wɔn ho fɛw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afei ɔka wɔn anim wɔ nʼabufuo mu","poem":1},{"text":"hunahuna wɔn wɔ nʼabufuhyeɛ mu, ka sɛ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Masi me Ɔhene","poem":1},{"text":"wɔ Sion, me bepɔ kronkron no so.”","poem":2}]},{"type":"verse","number":7,"content":["Mɛpae mu aka Awurade ahyɛdeɛ:",{"text":"Ɔka kyerɛɛ me sɛ, “Woyɛ me Babarima;","poem":1},{"text":"ɛnnɛ mayɛ wʼAgya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bisa me,","poem":1},{"text":"na mede amanaman nyinaa bɛyɛ wʼagyapadeɛ,","poem":2},{"lineBreak":true},{"text":"asase ano nyinaa bɛyɛ wo dea.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wode dadeɛ ahempoma bɛdi wɔn so;","poem":1},{"text":"na woabobɔ wɔn sɛ ɔnwomfoɔ ahina.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Enti mo ahemfo, monsua nyansa;","poem":1},{"text":"monkae kɔkɔbɔ yi, mo asase sodifoɔ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Momfa suro nsom Awurade","poem":1},{"text":"na monsɛpɛ mo ho ahopopoɔ mu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Momfe Ɔba no ano, na ne bo amfu","poem":1},{"text":"ansɛe mo wɔ mo akwan so,","poem":2},{"text":"ɛfiri sɛ nʼabufuhyeɛ tumi sɔre ntɛm so.","poem":1},{"text":"Nhyira ne wɔn a wɔdwane toa no nyinaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}