{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade ntie wo wɔ wʼahohia mu;","poem":1},{"text":"Yakob Onyankopɔn din mmɔ wo ho ban.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɔmfa mmoa mfiri kronkronbea hɔ mmrɛ wo","poem":1},{"text":"na ɔmfiri Sion mmɛhyɛ wo den.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ɔnkae wʼafɔrebɔ nyinaa","poem":1},{"text":"na ɔmma wo hyeɛ afɔdeɛ nsɔ nʼani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔmma wo deɛ wʼakoma pɛ,","poem":1},{"text":"na wo nhyehyɛeɛ nyinaa nyɛ yie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yɛbɛbɔ ose ɛberɛ a woadi nkonim","poem":1},{"text":"na yɛama yɛn frankaa so wɔ yɛn Onyankopɔn din mu.","poem":2},{"lineBreak":true},{"text":"Awurade nyɛ wʼabisadeɛ nyinaa mma wo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Afei mahunu sɛ Awurade gye deɛ wasra no no nkwa;","poem":1},{"text":"ɔgye no so wɔ ne soro kronkron hɔ","poem":2},{"lineBreak":true},{"text":"ɔde tumi a ɛfiri ne nsa nifa mu no ma no nkwagyeɛ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ebinom de wɔn ho to wɔn nteaseɛnam so","poem":1},{"text":"na afoforɔ nso, wɔn apɔnkɔ so,","poem":2},{"lineBreak":true},{"text":"nanso yɛn deɛ, yɛde yɛn ho to Awurade yɛn Onyankopɔn din so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Saa nkurɔfoɔ no, wɔbrɛ wɔn ase ma wɔhwehwe ase,","poem":1},{"text":"na yɛn deɛ, yɛsɔre gyina pintinn.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ao Awurade gye ɔhene nkwa!","poem":1},{"text":"Na sɛ yɛfrɛ nso a, gye yɛn so.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}