{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Asase ne deɛ ɛwɔ mu nyinaa yɛ Awurade dea;","poem":1},{"text":"ewiase ne wɔn a wɔte soɔ nyinaa wɔ no;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ɛfiri sɛ ɔno na ɔtoo ne fapem wɔ ɛpo so","poem":1},{"text":"na ɔde sii nsuo ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hwan na ɔbɛtumi aforo Awurade bepɔ no?","poem":1},{"text":"Hwan na ɔbɛtumi agyina ne tenabea kronkron hɔ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deɛ ɔyɛ ade tenenee na nʼakoma mu teɛ,","poem":1},{"text":"deɛ ne kra nni ahoni akyi","poem":2},{"lineBreak":true},{"text":"na ɔnnka ntanhunu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɔbɛnya Awurade nsam nhyira","poem":1},{"text":"ne bembuo a ɛfiri ne Nkwagyeɛ Onyankopɔn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saa na awoɔ ntoatoasoɔ a wɔhwehwɛ Awurade no teɛ,","poem":1},{"text":"wɔn a wɔhwehwɛ wʼanim no, Ao Yakob Onyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mo apono, mommuebue","poem":1},{"text":"mommuebue, mo tete apono,","poem":2},{"lineBreak":true},{"text":"na Animuonyam Ɔhene nhyɛne mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hwan ne saa Animuonyam Ɔhene yi?","poem":1},{"text":"Ɔno ne Awurade ɔhoɔdenfoɔ ne otumfoɔ no;","poem":2},{"lineBreak":true},{"text":"Awurade a ɔyɛ ɔko mu nkonimdifoɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mommuebue, Ao mo apono","poem":1},{"text":"mommuebue, mo tete apono,","poem":2},{"lineBreak":true},{"text":"na animuonyam Ɔhene no nkɔ mu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hwan ne saa animuonyam Ɔhene yi?","poem":1},{"text":"Asafo Awurade no,","poem":2},{"lineBreak":true},{"text":"ɔno ne animuonyam Ɔhene no.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}