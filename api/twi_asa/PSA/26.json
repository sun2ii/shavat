{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Bu me bem, Ao Awurade,","poem":1},{"text":"ɛfiri sɛ, mabɔ bra a asɛm nni ho:","poem":2},{"text":"mede me ho too Awurade so","poem":1},{"text":"na manhinhim.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sɔ me hwɛ, Ao Awurade,","poem":1},{"text":"hwehwɛ mʼakoma ne mʼadwene mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wʼadɔeɛ wɔ mʼanim daa","poem":1},{"text":"na mɛnante wo nokorɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Me ne nnaadaafoɔ ntena","poem":1},{"text":"na me ne nyaatwomfoɔ nso nni hwee yɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mekyiri nnebɔneyɛfoɔ dwabɔ","poem":1},{"text":"na mempɛ sɛ me ne amumuyɛfoɔ tena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mehohoro me nsa wɔ bembuo mu,","poem":1},{"text":"na makɔ wʼafɔrebukyia ho ahyia, Ao Awurade,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"na mepae mu ka wʼayɛyie","poem":1},{"text":"na meka wʼanwanwadeɛ nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mʼani gye efie a wote mu ho, Ao Awurade,","poem":1},{"text":"baabi a wʼanimuonyam wɔ no.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfa me kra nka nnebɔneyɛfoɔ deɛ ho nkɔ.","poem":1},{"text":"Mfa me nkwa nka mogyapɛfoɔ deɛ ho,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"wɔn a amumuyɛ nhyehyɛeɛ wɔ wɔn nsam","poem":1},{"text":"na adanmudeɛ ayɛ wɔn nsa nifa ma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nanso mebɔ ɔbra a ɛho teɛ.","poem":1},{"text":"Hu me mmɔbɔ na gye me nkwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Me nan sisi asase tamaa so;","poem":1},{"text":"na dwabɔ akɛseɛ ase na mɛkamfo Awurade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}