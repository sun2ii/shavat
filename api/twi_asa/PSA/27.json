{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade ne me hann ne me nkwagyeɛ;","poem":1},{"text":"hwan na mensuro no?","poem":2},{"text":"Awurade ne me nkwa ahoɔden,","poem":1},{"text":"na hwan anim na me ho mpopoɔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sɛ nnipa bɔne toa me","poem":1},{"text":"pɛ sɛ wɔkum me a,","poem":2},{"text":"sɛ mʼatamfoɔ to hyɛ me so a","poem":1},{"text":"wɔbɛsuntisunti ahwehwe ase.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛ dɔm mpo twa me ho hyia a,","poem":1},{"text":"mʼakoma rentu;","poem":2},{"text":"mpo sɛ wɔtu me so sa a,","poem":1},{"text":"ɛno mu koraa na menya awerɛhyɛmu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Adeɛ baako na mebisa Awurade;","poem":1},{"text":"na ɛno na mehwehwɛ;","poem":2},{"text":"sɛ mɛtena Awurade fie","poem":1},{"text":"me nkwa nna nyinaa,","poem":2},{"text":"na mahwɛ Awurade ahoɔfɛ","poem":1},{"text":"na mahwehwɛ no wɔ nʼasɔrefie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔ hia ɛda mu no","poem":1},{"text":"ɔde me sie nʼatenaeɛ;","poem":2},{"text":"ɔkora me wɔ Ahyiaeɛ Ntomadan mu.","poem":1},{"text":"Ɔde me si ɔbotan so wɔ ɔsorosoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Afei ɔbɛma me tiri so","poem":1},{"text":"wɔ atamfoɔ a wɔatwa me ho ahyia no so;","poem":2},{"text":"mede anigyeɛ bɛbɔ afɔdeɛ wɔ nʼAhyiaeɛ Ntomadan mu;","poem":1},{"text":"na mɛto dwom, ahyehyɛ nnwom ama Awurade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ao, Awurade, sɛ mesu frɛ wo a, tie me!","poem":1},{"text":"Hu me mmɔbɔ na gye me so!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mʼakoma ka wɔ wo ho sɛ, “Hwehwɛ nʼanim!”","poem":1},{"text":"Wʼanim, Ao Awurade na mɛhwehwɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfa wʼanim nhinta me,","poem":1},{"text":"mfa abufuo mpamo wo ɔsomfoɔ","poem":2},{"lineBreak":true},{"text":"me ɔboafoɔ ne wo.","poem":2},{"text":"Mpo me na nnya me,","poem":1},{"text":"Ao me Nkwagyeɛ Onyankopɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mʼagya ne me maame bɛgya me hɔ deɛ,","poem":1},{"text":"nanso Awurade bɛgye me.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kyerɛ me wʼakwan, Ao Awurade;","poem":1},{"text":"fa me fa ɛkwan tee so,","poem":2},{"lineBreak":true},{"text":"me nhyɛsofoɔ enti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nnyaa me mma sɛdeɛ mʼatamfoɔ pɛ,","poem":1},{"text":"adansekurumfoɔ sɔre tia me","poem":2},{"lineBreak":true},{"text":"na wɔpu awurukasɛm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Meda so wɔ saa anidasoɔ yi sɛ:","poem":1},{"text":"mɛhunu Awurade ayamyɛ","poem":2},{"lineBreak":true},{"text":"wɔ ateasefoɔ asase so.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Twɛn Awurade.","poem":1},{"text":"Hyɛ wo ho den na ma wo bo nyɛ duru","poem":2},{"lineBreak":true},{"text":"na twɛn Awurade.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}