{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Wo na mesu mefrɛ wo,","poem":1},{"text":"Ao Awurade me Botan;","poem":2},{"lineBreak":true},{"text":"nsi wʼaso wɔ me enti.","poem":2},{"text":"Sɛ woyɛ komm a,","poem":1},{"text":"mɛyɛ sɛ wɔn a wɔasiane kɔ amena mu no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tie me mmɔborɔ su","poem":1},{"text":"ɛberɛ a mefrɛ wo pɛ mmoa","poem":2},{"text":"ɛberɛ a mema me nsa so","poem":1},{"text":"kyerɛ wo Tenabea Kronkron hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mfa me mfra amumuyɛfoɔ mu ntwe me nkɔ","poem":1},{"text":"wɔn a wɔyɛ bɔne no.","poem":2},{"text":"Wɔne wɔn yɔnkonom kasa fɛfɛ","poem":1},{"text":"nanso wɔde ɔtan sie wɔn akoma mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Twe wɔn aso wɔ deɛ wɔayɛ no so;","poem":1},{"text":"wɔn adwuma bɔne no so;","poem":2},{"text":"tua deɛ wɔde wɔn nsa ayɛ so ka","poem":1},{"text":"na fa deɛ ɛfata wɔn sane bra wɔn so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sɛ wɔmmu deɛ Awurade ayɛ","poem":1},{"text":"ne deɛ ɔde ne nsa ayɛ no enti,","poem":2},{"text":"ɔbɛbrɛ wɔn ase","poem":1},{"text":"na ɔremma wɔnnsɔre bio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ayɛyie nka Awurade,","poem":1},{"text":"ɛfiri sɛ watie me mmɔborɔ su.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade ne mʼahoɔden ne mʼakokyɛm;","poem":1},{"text":"mʼakoma wɔ ne mu ahotosoɔ, na ɔboa me.","poem":2},{"text":"Mʼakoma di ahurisie","poem":1},{"text":"na mede dwomtoɔ bɛda no ase.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade yɛ ahoɔden ma ne nkurɔfoɔ;","poem":1},{"text":"ne nkwagyeɛ nsraban ma deɛ wɔasra no ngo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gye wo nkurɔfoɔ na hyira wʼagyapadeɛ;","poem":1},{"text":"yɛ wɔn hwefoɔ, na wo ne wɔn nnante afebɔɔ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}