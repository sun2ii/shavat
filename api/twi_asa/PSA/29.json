huri te sɛ nantwie ba,","poem":1},{"text":"na Sirion nso sɛ ɛkoɔ ba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awurade nne pa ma anyinam ogya dɛre","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Awurade nne woso ɛserɛ so;","poem":1},{"text":"Awurade woso Kades serɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade nne kyinkyim adum","poem":1},{"text":"na ɛma kwaeɛ yɛ kwaterekwa.","poem":2},{"text":"Nʼasɔredan mufoɔ nyinaa team ka sɛ,","poem":1},{"text":"“Animuonyam nka Onyankopɔn!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awurade di ɔhene wɔ nsuyire so;","poem":1},{"text":"wɔasi Awurade ɔhene afebɔɔ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade ma ne nkurɔfoɔ ahoɔden,","poem":1},{"text":"na ɔde asomdwoeɛ hyira wɔn.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}