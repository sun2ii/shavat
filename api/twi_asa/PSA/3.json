{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom a ɔtoeɛ ɛberɛ a ɔredwane afiri ne babarima Absalom anim."]},{"type":"verse","number":1,"content":[{"text":"Ao Awurade, hwɛ sɛdeɛ mʼatamfoɔ dɔɔso fa!","poem":1},{"text":"Dodoɔ no ara na wɔsɔre tia me!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bebree no ara ka fa me ho sɛ,","poem":1},{"text":"“Onyankopɔn rennye no”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nanso, Ao Awurade, woyɛ akokyɛm a atwa me ho ahyia","poem":1},{"text":"wohyɛ me animuonyam na wopagya me ti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meteam su frɛ Awurade,","poem":1},{"text":"na ɔgye me so firi ne bepɔ kronkron no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Metɔ hɔ na meda a,","poem":1},{"text":"menyane bio, ɛfiri sɛ Awurade kora me so.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Merensuro atamfoɔ mpem mpem a","poem":1},{"text":"wɔatwa me ho ahyia no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sɔre, Ao Awurade!","poem":1},{"text":"Gye me, Ao me Onyankopɔn!","poem":2},{"text":"Bobɔ mʼatamfoɔ nyinaa apantan;","poem":1},{"text":"na tutu amumuyɛfoɔ se.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awurade hɔ na ɔgyeɛ firi ba.","poem":1},{"text":"Ma wo nhyira mmra wo nkurɔfoɔ so.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ. Wɔto wɔ sankuhoma so.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}