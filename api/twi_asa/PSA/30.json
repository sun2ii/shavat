{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Dwom a wɔto de buee Asɔredan no ano. Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Mema wo so, Ao Awurade,","poem":1},{"text":"ɛfiri sɛ, woayi me afiri ebunu mu","poem":2},{"lineBreak":true},{"text":"na woamma mʼatamfoɔ ansere me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ao Awurade me Onyankopɔn, mesu frɛɛ wo sɛ boa me","poem":1},{"text":"na wosaa me yadeɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ao Awurade, woyii me firii damena mu;","poem":1},{"text":"wode me ho kyɛɛ me na woamma mankɔ amena mu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Monto ayɛyie nnwom mma Awurade;","poem":1},{"text":"mo a moyɛ nʼahotefoɔ!","poem":2},{"text":"Monkamfo ne din kronkron no.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nʼabufuo nkyɛre,","poem":1},{"text":"na nʼadɔeɛ wɔ hɔ daa;","poem":2},{"text":"agyaadwotwa bɛwɔ hɔ anadwo,","poem":1},{"text":"nanso ahosɛpɛ bɛba anɔpa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Metee nka sɛ mewɔ banbɔ no, mekaa sɛ,","poem":1},{"text":"“Merenhinhim da.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ao Awurade, woyɛɛ me adom no","poem":1},{"text":"womaa me bepɔ gyinaa pintinn","poem":2},{"text":"na wode wʼanim hintaa me no,","poem":1},{"text":"me bo tuiɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wo, Awurade na mefrɛɛ woɔ;","poem":1},{"text":"wo hɔ na mesu mesrɛɛ mmɔborɔhunu sɛ:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Mfasoɔ bɛn na ɛwɔ me sɛeɛ ho,","poem":1},{"text":"sɛ mɛkɔ amena mu?","poem":2},{"text":"Mfuturo bɛyi wo ayɛ anaa?","poem":1},{"text":"Ɛbɛpae mu aka wo nokorɛdie anaa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tie me, Ao Awurade, na hunu me mmɔbɔ!","poem":1},{"text":"Ao Awurade, yɛ me ɔboafoɔ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wodanee mʼagyaadwotwa yɛɛ no asa;","poem":1},{"text":"woyii mʼayitoma firii me ho","poem":2},{"lineBreak":true},{"text":"na wode anigyeɛ firaa me,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"sɛ mʼakoma bɛto nnwom ama wo na ɛrenyɛ komm.","poem":1},{"text":"Ao Awurade me Onyankopɔn, mɛda wo ase daa.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}