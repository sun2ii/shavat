{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Nhyira ne wɔn a","poem":1},{"text":"wɔde wɔn amumuyɛ akyɛ wɔn,","poem":2},{"lineBreak":true},{"text":"na wɔakata wɔn bɔne so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nhyira nka onipa a","poem":1},{"text":"Awurade mmu ne bɔne ngu ne so,","poem":2},{"lineBreak":true},{"text":"na nnaadaa nni ne honhom mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɛberɛ a meyɛɛ komm no,","poem":1},{"text":"me nnompe yɛɛ mmrɛ","poem":2},{"lineBreak":true},{"text":"apinie a mesii no da mu nyinaa enti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Awia ne anadwo","poem":1},{"text":"wo nsa yɛɛ den wɔ me so;","poem":2},{"text":"mʼahoɔden saeɛ","poem":1},{"text":"sɛdeɛ awiaberɛ mu hyeɛ ma biribi yɛ mmerɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afei, megyee me bɔne too mu.","poem":1},{"text":"Mankata mʼamumuyɛ so.","poem":2},{"text":"Mekaa sɛ, “Mɛka","poem":1},{"text":"me bɔne akyerɛ Awurade,”","poem":2},{"lineBreak":true},{"text":"na wode me bɔne ho afɔdie kyɛɛ me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Enti, ma obiara a ɔwɔ nyamesu mmɔ wo mpaeɛ","poem":1},{"text":"ɛberɛ a wɔhunu woɔ;","poem":2},{"text":"ampa ara sɛ nsuo akɛseɛ yiri a,","poem":1},{"text":"ɛrenka no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wone me hintabea;","poem":1},{"text":"wobɛbɔ me ho ban wɔ amanehunu mu","poem":2},{"lineBreak":true},{"text":"na wode nkwagyeɛ nnwom atwa me ho ahyia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɛkyerɛkyerɛ wo ɛkwan a wobɛfa soɔ","poem":1},{"text":"mɛtu wo fo na mahwɛ wo so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyɛ sɛ ɔpɔnkɔ anaa afunumpɔnkɔ a","poem":1},{"text":"ɔnni nteaseɛ enti","poem":2},{"text":"wɔde nnareka ne ahoma na ɛdanedane no","poem":1},{"text":"sɛ ɛbɛyɛ a wɔbɛba wo nkyɛn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ɔmumuyɛfoɔ amanehunu dɔɔso,","poem":1},{"text":"nanso Awurade adɔeɛ a ɛnsa da no,","poem":2},{"lineBreak":true},{"text":"ɛtwa onipa a ɔde ne ho to no so no ho hyia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Monni ahurisie na mo ani nnye wɔ Awurade mu, mo teneneefoɔ;","poem":1},{"text":"monto dwom, mo a mo akoma mu teɛ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}