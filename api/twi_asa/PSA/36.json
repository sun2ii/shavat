{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Awurade ɔsomfoɔ Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Nkɔmhyɛ bi da mʼakoma so","poem":1},{"text":"a ɛfa omumuyɛfoɔ mmarato ho.","poem":2},{"text":"Wɔnnsuro Onyankopɔn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na ɔno ankasa ani so no, ɔdaadaa ne ho dodo","poem":1},{"text":"enti mma ɔnhunu ne bɔne nnyae yɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nʼanom nsɛm yɛ atirimuɔden ne nnaadaa;","poem":1},{"text":"ɔnnim nyansa bio, na wayɛ papa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔda ne mpa so mpo a, ɔbɔ pɔ bɔne;","poem":1},{"text":"na ɔgyaa ne ho ma bɔne ɛkwan","poem":2},{"lineBreak":true},{"text":"na ɔmpo deɛ ɛnyɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awurade, wʼadɔeɛ duru sorosoro","poem":1},{"text":"wo nokorɛdie duru ewiem tɔnn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wo tenenee te sɛ mmepɔ akɛseɛ.","poem":1},{"text":"Wʼatɛntenenee mu dɔ sɛ ɛpo bunu.","poem":2},{"text":"Ao Awurade, wokora nnipa ne mmoa nyinaa so.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Wʼadɔeɛ a ɛnsa da no som bo!","poem":2},{"text":"Nnipa mu akɛseɛ ne nketewa","poem":1},{"text":"nya hintabea wɔ wo ntaban nwunu ase.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wɔdi deɛ abu soɔ wɔ wo fie","poem":1},{"text":"woma wɔnom firi wʼanika asutene no mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wo nkyɛn na nkwa asutire wɔ;","poem":1},{"text":"wo hann mu na yɛhunu hann.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kɔ so dɔ wɔn a wɔnim wo,","poem":1},{"text":"ma wo tenenee ntena wɔn a wɔtene akoma mu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mma ɔhantanni nan ntia me","poem":1},{"text":"anaa omumuyɛfoɔ nsa nnsunsum me.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hwɛ sɛdeɛ nnebɔneyɛfoɔ ahwehwe ase,","poem":1},{"text":"wɔdeda hɔ a wɔrentumi nsɔre bio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}