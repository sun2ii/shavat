{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Nhyira ne onipa a mmɔborɔni asɛm ho hia no.","poem":1},{"text":"Awurade gye no wɔ amanehunu berɛ mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade bɛbɔ ne ho ban na wakora ne kra.","poem":1},{"text":"Ɔbɛhyira no wɔ asase no so;","poem":2},{"lineBreak":true},{"text":"ɔrennyaa no mma nʼatamfoɔ apɛdeɛ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Awurade bɛhwɛ no wɔ ne yadeɛ mpa so","poem":1},{"text":"na wagye no asi hɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mekaa sɛ, “Ao Awurade hunu me mmɔbɔ;","poem":1},{"text":"sa me yadeɛ, ɛfiri sɛ mayɛ bɔne atia wo.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mʼatamfoɔ de adwene bɔne ka wɔ me ho sɛ:","poem":1},{"text":"“Da bɛn na ɔbɛwu ama ne din ayera?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛberɛ biara a obi ba me nkyɛn no,","poem":1},{"text":"ɔka atorɔsɛm, na nʼakoma hɔre dinsɛeɛ;","poem":2},{"lineBreak":true},{"text":"ɔfiri adi kɔ a, ɔde kɔdi nsekuro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mʼatamfoɔ nyinaa keka asomusɛm fa me ho;","poem":1},{"text":"wɔsusu bɔne ma me na wɔka sɛ:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Yare bɔne bi abɔ no;","poem":1},{"text":"ɔrensɔre mfiri deɛ ɔda hɔ bio.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mpo me yɔnko pa ara a mede me ho too ne soɔ,","poem":1},{"text":"deɛ me ne no too nsa didiiɛ no,","poem":2},{"lineBreak":true},{"text":"asɔre atia me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nanso wo, Awurade, hunu me mmɔbɔ;","poem":1},{"text":"pagya me, na mentua wɔn so ka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Menim sɛ wʼani sɔ me,","poem":1},{"text":"na me ɔtamfoɔ renni me so nkonim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Me nokorɛdie mu, wokura me mu","poem":1},{"text":"na wode me gyina wʼanim afebɔɔ.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nhyira nka Awurade, Israel Onyankopɔn,","poem":1},{"text":"ɛnnɛ ne daa nyinaa.","poem":2},"Amen ne Amen!",{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}