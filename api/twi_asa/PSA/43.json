{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, bu me bem,","poem":1},{"text":"na ka mʼasɛm a ɛtia ɔman a wɔnnsuro wo no ma me;","poem":2},{"lineBreak":true},{"text":"gye me firi nnaadaafoɔ ne amumuyɛfoɔ nsam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woyɛ Onyankopɔn, mʼabandenden.","poem":1},{"text":"Adɛn enti na woapo me?","poem":2},{"text":"Adɛn enti na ɛsɛ sɛ menantenante twa adwo","poem":1},{"text":"mʼatamfoɔ nhyɛsoɔ nti?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Soma wo hann ne wo nokorɛ","poem":1},{"text":"ma wɔn nkyerɛ me ɛkwan;","poem":2},{"text":"ma wɔmmfa me mmra wo Bepɔ Kronkron no so,","poem":1},{"text":"faako a woteɛ hɔ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Afei, mɛkɔ Onyankopɔn afɔrebukyia anim","poem":1},{"text":"mʼanigyeɛ ne mʼahosɛpɛ Onyankopɔn nkyɛn.","poem":2},{"text":"Mede sankuo bɛyi wo ayɛ,","poem":1},{"text":"Ao Onyankopɔn, me Onyankopɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Adɛn enti na woaboto, Ao me kra?","poem":1},{"text":"Adɛn enti na woteetee wɔ me mu saa?","poem":2},{"text":"Fa wo ho to Onyankopɔn so,","poem":1},{"text":"na mɛkɔ so ayi no ayɛ,","poem":2},{"lineBreak":true},{"text":"mʼAgyenkwa ne me Onyankopɔn.","poem":2},{"text":"Dwom a wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}