{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Kora mma dwom. Wɔto no “alamot” sankuo nne so."]},{"type":"verse","number":1,"content":[{"text":"Onyankopɔn ne yɛn dwanekɔbea ne yɛn ahoɔden,","poem":1},{"text":"amanehunu mu ɔboafoɔ a ɔwɔ hɔ ɛberɛ biara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti sɛ asase ani dane butu","poem":1},{"text":"na mmepɔ tutu kɔgu ɛpo ase a, yɛrensuro,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"sɛ ɛpo bɔ asorɔkye na ɛhuru","poem":1},{"text":"na ɛma nkokoɔ woso mpo a, yɛrensuro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Asutene bi wɔ hɔ a","poem":1},{"text":"ne nsuwansuwa de anigyeɛ ba Onyankopɔn kuropɔn mu,","poem":2},{"lineBreak":true},{"text":"beaeɛ kronkron a Ɔsorosoroni no teɛ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onyankopɔn te kuropɔn no mu, na ɔrenhwe ase;","poem":1},{"text":"Onyankopɔn bɛboa no anɔpahema.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amanaman yɛ hoo, na ahennie hwehwe ase;","poem":1},{"text":"ɔma ne nne so ma asase nane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Otumfoɔ Awurade ka yɛn ho.","poem":1},{"text":"Yakob Onyankopɔn yɛ yɛn aban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bra bɛhwɛ Awurade nnwuma,","poem":1},{"text":"ɔsɛeɛ a ɔde aba asase no so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɔma akodie gyae kɔsi asase ano.","poem":1},{"text":"Ɔbubu agyan mu na ɔsɛe pea;","poem":2},{"lineBreak":true},{"text":"ɔde ogya hye nkataboɔ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Monyɛ komm na monhunu sɛ me ne Onyankopɔn;","poem":1},{"text":"wɔbɛma me so wɔ amanaman no mu,","poem":2},{"lineBreak":true},{"text":"wɔbɛma me so wɔ asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Otumfoɔ Awurade ka yɛn ho;","poem":1},{"text":"Yakob Onyankopɔn yɛ yɛn aban.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}