{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Kora mma dwom."]},{"type":"verse","number":1,"content":[{"text":"Awurade yɛ kɛseɛ na ɔsɛ nkamfo","poem":1},{"text":"wɔ yɛn Onyankopɔn kuropɔn mu, ne bepɔ kronkron so.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuropɔn no ɔsorokɔ yɛ fɛ,","poem":1},{"text":"ɛyɛ ewiase nyinaa anigyedeɛ.","poem":2},{"text":"Bepɔ Sion te sɛ Safon sorɔnsorɔmmea,","poem":1},{"text":"Ɔhene Kɛseɛ no kuropɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onyankopɔn te nʼabankɛsewa mu.","poem":1},{"text":"Wada ne ho adi sɛ ɔyɛ nʼaban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɛberɛ a ahemfo yi boaa wɔn ho ano,","poem":1},{"text":"na wɔtuu ɔsa bɔɔ mu no,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wɔhunuu no ma ɛyɛɛ wɔn ahodwirie,","poem":1},{"text":"na wɔde ehu dwaneeɛ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nketenkete kyeree wɔn wɔ hɔ,","poem":1},{"text":"ɔyea a ɛte sɛ ɔbaa a awoɔ aka no.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wosɛee wɔn sɛ Tarsis ahyɛn a","poem":1},{"text":"apueeɛ mframa abɔ adwira wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sɛdeɛ yɛate no,","poem":1},{"text":"saa ara na yɛahunu","poem":2},{"text":"wɔ Otumfoɔ Awurade kuropɔn no mu,","poem":1},{"text":"yɛn Onyankopɔn kuropɔn mu;","poem":2},{"lineBreak":true},{"text":"Onyankopɔn ma ɛtim hɔ afebɔɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wʼasɔredan no mu, Ao Onyankopɔn,","poem":1},{"text":"na yɛdwene wo dɔ a ɛnsa da no ho,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ao Onyankopɔn, wʼayɛyie duru asase ano","poem":1},{"text":"te sɛ wo din;","poem":2},{"lineBreak":true},{"text":"tenenee ayɛ wo nsa nifa mu ma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sion bepɔ di ahurisie,","poem":1},{"text":"Yuda nkuraase no ani gye","poem":2},{"text":"ɛsiane wʼatemmuo no enti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nante Sion na twa ho hyia,","poem":1},{"text":"kan nʼabantenten dodoɔ,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"dwene nʼafasuo ho yie,","poem":1},{"text":"hwɛ nʼabankɛsewa no,","poem":2},{"lineBreak":true},{"text":"na woaka ho asɛm akyerɛ nkyirimma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Saa Onyankopɔn yi yɛ yɛn Onyankopɔn daa daa;","poem":1},{"text":"mpo ɔbɛyɛ yɛn kwankyerɛfoɔ akɔsi awieeɛ.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}