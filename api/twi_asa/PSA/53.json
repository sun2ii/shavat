{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ɔkwasea ka nʼakoma mu sɛ,","poem":1},{"text":"“Onyankopɔn bi nni hɔ.”","poem":2},{"text":"Wɔaporɔ, na wɔn akwan yɛ animguaseɛ.","poem":1},{"text":"Baako koraa nni hɔ a ɔyɛ ade pa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Onyankopɔn firi soro hwɛ adasamma wɔ fam","poem":1},{"text":"sɛ ɔbɛhunu wɔn mu bi a","poem":2},{"text":"wɔwɔ nteaseɛ,","poem":1},{"text":"anaa ebinom a wɔhwehwɛ Onyankopɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obiara amane;","poem":1},{"text":"wɔn nyinaa ayɛ bɔne;","poem":2},{"text":"wɔn mu bi nni hɔ a ɔyɛ papa;","poem":1},{"text":"ɔbaako mpo nni hɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Enti abɔnefoɔ rensua nyansa anaa?","poem":1},{"text":"Wɔwe me nkurɔfoɔ sɛdeɛ nnipa di aduane.","poem":2},{"lineBreak":true},{"text":"Wɔnnsu mfrɛ Onyankopɔn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wɔn na wɔwɔ hɔ a wɔabɔ huboa!","poem":1},{"text":"Wɔn ho popo wɔ beaeɛ a ehu nni hɔ.","poem":2},{"text":"Onyankopɔn bɛhwete wʼatamfoɔ no nnompe agu;","poem":1},{"text":"wobɛgu wɔn anim ase, ɛfiri sɛ Onyankopɔn abu wɔn animtiaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ao, ma Israel nkwagyeɛ mfiri Sion mmra!","poem":1},{"text":"Onyankopɔn bɛsane de ne nkurɔfoɔ agyapadeɛ ama wɔn.","poem":2},{"lineBreak":true},{"text":"Na Yakob adi ahurisie, na Israel ani agye!","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ. Wɔbɔ no sankuo so.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}