{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Dawid “maskil” dwom. Ɔtoo no ɛberɛ a Sififoɔ kɔka kyerɛɛ Saulo sɛ, “Dawid abɛhinta wɔ yɛn mu.”"]},{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, gye me wɔ wo din mu;","poem":1},{"text":"fa wo tumi di mʼasɛm ma me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ao Onyankopɔn, tie me mpaeɛbɔ;","poem":1},{"text":"tie mʼanom nsɛm.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahɔhoɔ reto ahyɛ me so.","poem":1},{"text":"Atirimuɔdenfoɔ repɛ me akum me;","poem":2},{"lineBreak":true},{"text":"nnipa a wɔmmfa Onyankopɔn nyɛ hwee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ampa ara, Onyankopɔn ne me ɔboafoɔ;","poem":1},{"text":"Awurade ne me hwɛfoɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma mmusuo nkyim mmra wɔn a wɔdi me ho nsekuro so;","poem":1},{"text":"wo nokorɛdie mu, sɛe wɔn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɛfiri me pɛ mu abɔ afɔdeɛ ama wo;","poem":1},{"text":"Ao Awurade, mɛyi wo din ayɛ,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ ɛyɛ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Woagye me afiri me haw nyinaa mu,","poem":1},{"text":"na mʼani ahunu nkonimdie wɔ mʼatamfoɔ so.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ. Wɔde sankuo na ɛtoeɛ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}