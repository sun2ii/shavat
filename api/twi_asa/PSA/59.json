{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Wɔto no sɛdeɛ wɔto “Mma Ɛnsɛe No” sankuo nne so. Dawid “miktam” dwom. Ɔtoo no ɛberɛ a Saulo soma kɔwɛn Dawid fie sɛ wɔbɛkum no."]},{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, gye me firi mʼatamfoɔ nsam;","poem":1},{"text":"bɔ me ho ban firi wɔn a wɔtaa me so no ho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gye me firi amumuyɛfoɔ nsam.","poem":1},{"text":"Gye me nkwa firi mogyapɛfoɔ nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hwɛ sɛdeɛ wɔatɛ repɛ me akum me","poem":1},{"text":"akokobirefoɔ bɔ pɔ bɔne tia me","poem":2},{"lineBreak":true},{"text":"a ɛnyɛ mfomsoɔ anaa bɔne bi a mayɛ enti, Ao Awurade.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Menyɛɛ mfomsoɔ bi, nanso wɔayɛ krado sɛ wɔbɛto ahyɛ me so.","poem":1},{"text":"Sɔre bɛgye me; hwɛ mʼamanehunu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ao Asafo Awurade Onyankopɔn, Israel Onyankopɔn,","poem":1},{"text":"ma wo ho so na twe amanaman no nyinaa aso;","poem":2},{"lineBreak":true},{"text":"nhunu amumuyɛfoɔ nkontompofoɔ no mmɔbɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wɔsane ba anwummerɛ,","poem":1},{"text":"wɔpɔ so sɛ nkraman,","poem":2},{"lineBreak":true},{"text":"na wɔkyinkyin kuropɔn no mu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hwɛ deɛ wɔfe firi wɔn anomu,","poem":1},{"text":"wɔfe akofena firi wɔn anomu","poem":2},{"lineBreak":true},{"text":"na wɔka sɛ: “Hwan na ɔteɛ”?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nanso, wo Awurade, wosere wɔn;","poem":1},{"text":"wodi saa aman no nyinaa ho fɛw.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ao mʼAhoɔden, mehwɛ wo;","poem":1},{"text":"wo, Ao Onyankopɔn ne mʼabankɛseɛ,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"me Onyankopɔn a ɔyɛ ɔdɔ.","poem":2},{"lineBreak":true},{"text":"Onyankopɔn bɛdi mʼanim","poem":1},{"text":"na ɔbɛma mahwɛ wɔn a wɔbɔ me ahohora no haa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nanso nkum wɔn, Ao Awurade yɛn akokyɛm,","poem":1},{"text":"na me nkurɔfoɔ werɛ amfiri wɔn.","poem":2},{"text":"Wo tumi mu no ma wɔnnantenante,","poem":1},{"text":"na brɛ wɔn ase.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bɔne a ɛfiri wɔn anomu,","poem":1},{"text":"ne wɔn ano nsɛm enti","poem":2},{"text":"ma wɔn ahomasoɔ nkyekyere wɔn.","poem":1},{"text":"Abususɛm a wɔka ne atorɔ a wɔtwa enti,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"sɛe wɔn wɔ abufuhyeɛ mu,","poem":2},{"lineBreak":true},{"text":"kɔsi sɛ wɔn ase bɛtɔre.","poem":2},{"text":"Afei ɛbɛma asase so afanan nyinaa ahunu","poem":1},{"text":"sɛ Onyankopɔn di Yakob so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wɔsane ba anwummerɛ,","poem":1},{"text":"wɔpɔ so sɛ nkraman","poem":2},{"lineBreak":true},{"text":"na wɔkyinkyin kuropɔn no mu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wɔkyinkyini pɛ aduane","poem":1},{"text":"na sɛ wɔammee a, wɔsu bobom.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nanso mɛto wʼahoɔden ho dwom,","poem":1},{"text":"mɛto wʼadɔeɛ ho dwom anɔpa;","poem":2},{"text":"ɛfiri sɛ woyɛ mʼabankɛseɛ,","poem":1},{"text":"mʼahintaeɛ wɔ ahohia mmerɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ao mʼAhoɔden, mɛto ayɛyi dwom ama wo;","poem":1},{"text":"wo, Ao Onyankopɔn, ne mʼabankɛseɛ, me Onyankopɔn a ɔyɛ ɔdɔ.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Susan Edut.”","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}