{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao, Awurade nka mʼanim wɔ wʼabofuo mu,","poem":1},{"text":"na ntwe mʼaso nso wɔ wʼabufuhyeɛ mu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hu me mmɔbɔ, Awurade, ɛfiri sɛ meyɛ mmrɛ;","poem":1},{"text":"Ao Awurade sa me yadeɛ","poem":2},{"lineBreak":true},{"text":"na me nnompe wɔ ahoyera mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Me kra wɔ ahohia mu.","poem":1},{"text":"Ɛnkɔsi da bɛn, Ao Awurade, ɛnkɔsi da bɛn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sane bra, Ao Awurade, na bɛgye me nkwa;","poem":1},{"text":"gye me, wo dɔ a ɛnni hwammɔ no enti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obi a wawuo no renkae wo da,","poem":1},{"text":"hwan na ɔfiri damena mu kamfo woɔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Apinisie ama mayɛ mmerɛ.","poem":1},{"text":"Anadwo mu nyinaa mede agyaadwotwa fɔ me mpa","poem":2},{"lineBreak":true},{"text":"na me nisuo fɔ me sumiiɛ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awerɛhoɔ ama mʼani so ayɛ me kusuu.","poem":1},{"text":"Ɛredum mʼatamfoɔ nyinaa enti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mo nnebɔneyɛfoɔ, montwe mo ho mfiri me ho,","poem":1},{"text":"ɛfiri sɛ Awurade ate me sufrɛ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awurade ate me mmɔborɔ su;","poem":1},{"text":"Awurade tie me sufrɛ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mʼatamfoɔ nyinaa anim bɛgu ase","poem":1},{"text":"na wɔn ho adwiri wɔn;","poem":2},{"lineBreak":true},{"text":"na wɔapatu de fɛreɛ asane wɔn akyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}