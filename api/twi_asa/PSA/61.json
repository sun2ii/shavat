{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Dawid dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, tie me sufrɛ;","poem":1},{"text":"tie me mpaeɛbɔ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mefiri asase ano frɛ wo,","poem":1},{"text":"mefrɛ wo ɛfiri sɛ mʼakoma atɔ baha;","poem":2},{"lineBreak":true},{"text":"fa me kɔ ɔbotan a ɛware sene me no so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woayɛ me dwanekɔbea,","poem":1},{"text":"aban a ɛyɛ den ma ɔtamfoɔ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Me kɔn dɔ sɛ metena wo ntomadan no mu afebɔɔ","poem":1},{"text":"na manya hintabea wɔ wo ntaban nwunu ase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woate me bɔhyɛ, Ao Onyankopɔn;","poem":1},{"text":"na wode wɔn a wɔsuro wo din no agyapadeɛ ama me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"To ɔhene nkwa nna mu bebree;","poem":1},{"text":"na ne mfeɛ mfiri awoɔ ntoatoasoɔ nkɔduru awoɔ ntoatoasoɔ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ma ɔnni ɔhene wɔ Onyankopɔn anim daa.","poem":1},{"text":"Fa wʼadɔeɛ ne wo nokorɛ bɔ ne ho ban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Afei mɛto ayɛyie dwom ama wo din daa","poem":1},{"text":"na madi me bɔhyɛ so daa nyinaa.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ Yedutun.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}