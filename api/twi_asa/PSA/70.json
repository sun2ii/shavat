{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Dawid adesrɛ dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, yɛ ntɛm gye me nkwa;","poem":1},{"text":"Ao Awurade bra ntɛm bɛboa me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ma wɔn a wɔhwehwɛ me kra no","poem":1},{"text":"anim ngu ase na wɔnyɛ basaa;","poem":2},{"text":"ma wɔn a wɔhwehwɛ me sɛeɛ no nyinaa","poem":1},{"text":"mfa animguaseɛ nsane wɔn akyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma wɔn a wɔka, “Ɔtwea! Ɔtwea!” kyerɛ me no","poem":1},{"text":"nsane wɔn akyi ɛsiane wɔn aniwuo enti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanso ma wɔn a wɔhwehwɛ wo nyinaa","poem":1},{"text":"nsɛpɛ wɔn ho na wɔn ani nnye wɔ wo mu;","poem":2},{"text":"ma wɔn a wɔdɔ wo nkwagyeɛ no nka da biara sɛ,","poem":1},{"text":"“Onyankopɔn yɛ kɛseɛ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Meyɛ ohiani a menni ɔboafoɔ;","poem":1},{"text":"Ao Onyankopɔn, bra me nkyɛn ntɛm.","poem":2},{"text":"Wo ne me ɔboafoɔ ne me gyefoɔ;","poem":1},{"text":"Ao Awurade, ntwentwɛn wo nan ase.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}