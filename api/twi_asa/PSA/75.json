{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Asaf dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao Onyankopɔn, yɛda wo ase,","poem":1},{"text":"yɛda wo ase, ɛfiri sɛ wo Din abɛn;","poem":2},{"lineBreak":true},{"text":"nnipa ka wʼanwanwadeɛ kyerɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Woka sɛ, “Me na mehyɛɛ ɛberɛ a ɛsɛ no;","poem":1},{"text":"ɛyɛ me na mebu atɛntenenee.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛ asase ne ɛso nnipa nyinaa woso a,","poem":1},{"text":"me na mema nʼafadum gyina hɔ pintinn.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meka kyerɛ ahantanfoɔ sɛ, ‘Monnhoahoa mo ho bio,’","poem":1},{"text":"na meka kyerɛ amumuyɛfoɔ nso sɛ, ‘Mommma mo mmɛn so.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mommma mo mmɛn so ntia ɔsoro;","poem":1},{"text":"mommfa animtiabuo nkasa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Obiara mmfiri apueeɛ anaa atɔeɛ","poem":1},{"text":"anaa ɛserɛ no so a ɔbɛtumi ama obi so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɛyɛ Onyankopɔn na ɔbu atɛn:","poem":1},{"text":"Ɔbrɛ ɔbaako ase, na ɔma ɔfoforɔ so.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuruwa bi hyɛ Awurade nsam","poem":1},{"text":"nsã bi a ɛtwa ahuro a wɔde nnuhwam afra ahyɛ no ma;","poem":2},{"text":"ɔhwie, na asase so amumuyɛfoɔ nyinaa","poem":1},{"text":"nom ma ɛka aseɛ puo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Me deɛ, mɛpae mu aka yei daa daa;","poem":1},{"text":"mɛto ayɛyi dwom ama Yakob Onyankopɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɛbubu amumuyɛfoɔ nyinaa mmɛn,","poem":1},{"text":"nanso mɛma ateneneefoɔ ahoɔden foforɔ.","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ. Wɔde sankuo na ɛtoɔ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}