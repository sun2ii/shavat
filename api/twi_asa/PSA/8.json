sene abɔfoɔ","poem":1},{"text":"na wode wʼanimuonyam ne anidie abɔ no abotire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Woyɛɛ no sodifoɔ maa wo nsa ano adwuma","poem":1},{"text":"wode nneɛma nyinaa ahyɛ ne nan ase:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nnwankuo ne nantwikuo nyinaa","poem":1},{"text":"ne wiram mmoa nso,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ewiem nnomaa","poem":1},{"text":"ne ɛpo mu mpataa,","poem":2},{"lineBreak":true},{"text":"deɛ ɛnenam ɛpo mu akwan so nyinaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ao, Awurade, yɛn Awurade,","poem":1},{"text":"wo din yɛ kɛseɛ wɔ asase nyinaa so!","poem":2},{"text":"Wɔde ma dwomkyerɛfoɔ. Wɔto no sɛdeɛ wɔto “Ɔba no wuo”.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}