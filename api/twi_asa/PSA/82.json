{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Asaf dwom."]},{"type":"verse","number":1,"content":[{"text":"Onyankopɔn di ɔhene wɔ ɔsoro asafo mu;","poem":1},{"text":"ɔbu atɛn wɔ “anyame” mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Wobɛbɔ wɔn a wɔnteneɛ ho ban","poem":1},{"text":"na woayɛ animhwɛ ama amumuyɛfoɔ akɔsi da bɛn?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monka mmɔborɔfoɔ ne nwisiaa asɛm mma wɔn;","poem":1},{"text":"mommɔ ahiafoɔ ne wɔn a wɔhyɛ wɔn so yiedie ho ban.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Monnye ɔbrɛfoɔ ne ohiani;","poem":1},{"text":"monnye wɔn mfiri amumuyɛfoɔ nsam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wɔnnim hwee, na wɔnte hwee ase.","poem":1},{"text":"Wɔkyinkyini wɔ esum mu;","poem":2},{"lineBreak":true},{"text":"na asase fapem nyinaa woso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mekaa sɛ, ‘Moyɛ “anyame”;","poem":1},{"text":"mo nyinaa yɛ Ɔsorosoroni no mma.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nanso, mobɛwuwu sɛ nnipa pɛ;","poem":1},{"text":"na moahwe ase sɛ sodifoɔ biara.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ao Onyankopɔn, sɔre na bɛbu ewiase atɛn;","poem":1},{"text":"ɛfiri sɛ amanaman nyinaa yɛ wo dea.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}