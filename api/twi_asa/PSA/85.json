{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Kora mma dwom."]},{"type":"verse","number":1,"content":[{"text":"Ao Awurade wohunuu wʼasase mmɔbɔ;","poem":1},{"text":"wode Yakob ahonyadeɛ sane maa no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wode wo nkurɔfoɔ bɔne kyɛɛ wɔn","poem":1},{"text":"na wokataa wɔn nnebɔne nyinaa so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wode wʼabofuo too nkyɛn","poem":1},{"text":"na wodane firii wʼabufuhyeɛ ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sane gye yɛn bio, Ao Onyankopɔn, yɛn Gyefoɔ,","poem":1},{"text":"na ma wʼani nnye yɛn ho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wo bo bɛfu yɛn akɔsi daa anaa?","poem":1},{"text":"Wʼabofuo bɛtoa so akɔ awoɔ ntoantoasoɔ nyinaa so anaa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Worenhyɛ yɛn den bio,","poem":1},{"text":"na ama wo nkurɔfoɔ asɛpɛ wɔn ho wɔ wo mu anaa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ao Awurade, kyerɛ yɛn wo dɔ a ɛnsa da no,","poem":1},{"text":"na ma yɛn wo nkwagyeɛ no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɛtie deɛ Awurade Onyankopɔn bɛka.","poem":1},{"text":"Ɔde asomdwoeɛ hyɛ ne nkurɔfoɔ, ahotefoɔ no bɔ,","poem":2},{"lineBreak":true},{"text":"enti ɛnsɛ sɛ wɔsane kɔ agyimisɛm ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ampa ara, ne nkwagyeɛ bɛne wɔn a wɔsuro no,","poem":1},{"text":"na nʼanimuonyam bɛtena yɛn asase so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɔdɔ ne nokorɛdie bɛhyia,","poem":1},{"text":"na tenenee ne asomdwoeɛ bɛfe wɔn ho wɔn ho ano.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nokorɛdie bɛpue afiri asase no so,","poem":1},{"text":"na tenenee ahwɛ afiri soro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awurade bɛma yɛn deɛ ɛyɛ ampa ara","poem":1},{"text":"na yɛn asase bɛma ne nnɔbaeɛ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tenenee di nʼanim","poem":1},{"text":"siesie ɛkwan ma nʼanammɔntuo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}