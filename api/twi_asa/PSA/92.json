{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Dwom a wɔto no Homeda."]},{"type":"verse","number":1,"content":[{"text":"Ɛyɛ sɛ wɔkamfo wo Awurade","poem":1},{"text":"na wɔto dwom de hyɛ wo animuonyam, Ao Ɔsorosoroni,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na wɔpae mu ka wʼadɔeɛ anɔpa","poem":1},{"text":"ne wo nokorɛ anadwo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"wɔ ahoma edu sankuo so","poem":1},{"text":"ne sankuten nnwom mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ao Awurade, wo nneyɛɛ ma mʼani gye;","poem":1},{"text":"mede anigyeɛ bɛto dwom, wo nsa ano nnwuma enti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ao Awurade, wo nnwuma yɛ akɛseɛ,","poem":1},{"text":"na wo nyansa mu dɔ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ogyimifoɔ nnim","poem":1},{"text":"na nkwaseafoɔ nte aseɛ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"amumuyɛfoɔ bɛnyini sɛ ɛserɛ","poem":1},{"text":"na abɔnefoɔ bɛyɛ frɔmfrɔm deɛ,","poem":2},{"text":"nanso wɔbɛsɛe wɔn pasaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Na wo Awurade, woyɛ kɛseɛ afebɔɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ao Awurade ampa ara,","poem":1},{"text":"wʼatamfoɔ bɛyera;","poem":2},{"lineBreak":true},{"text":"na wobɛhwete abɔnefoɔ nyinaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Woama me ahoɔden te sɛ ɛkoɔ;","poem":1},{"text":"woahwie ngohwam papa agu me so.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mahunu mʼatamfoɔ nkoguo a wɔadi,","poem":1},{"text":"mate sɛdeɛ mʼatamfoɔ atirimuɔdenfoɔ adwane afiri akono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ateneneefoɔ bɛyɛ frɔmm te sɛ abedua,","poem":1},{"text":"wɔbɛnyini sɛ Lebanon ntweneduro;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"deɛ wɔadua wɔ Awurade fie,","poem":1},{"text":"wɔbɛnyini frɔmfrɔm wɔ yɛn Onyankopɔn adihɔ hɔ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wɔbɛkɔ so aso aba, onyinkyerɛ mu mpo,","poem":1},{"text":"wɔbɛyɛ frɔmm sɛ ahahammono,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"de akyerɛ sɛ, “Awurade yɛ ɔteneneeni;","poem":1},{"text":"ɔyɛ me botan, na atirimuɔdensɛm biara nni ne mu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}