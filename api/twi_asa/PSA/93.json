{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Awurade di ɔhene, wɔde tumi ahentadeɛ ahyɛ no;","poem":1},{"text":"wɔde tumi ahentadeɛ ahyɛ Awurade","poem":2},{"lineBreak":true},{"text":"na wɔde ahoɔden ayɛ nʼakodeɛ.","poem":2},{"text":"Wɔde ewiase atim hɔ pintinn;","poem":1},{"text":"na wɔrentumi ntutu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wʼahennwa tim hɔ firi tete;","poem":1},{"text":"na wowɔ hɔ firi mmerɛsanten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ao Awurade, ɛpo ama wɔn ho so,","poem":1},{"text":"ɛpo ama wɔn nne so;","poem":2},{"lineBreak":true},{"text":"ɛpo ama wɔn asorɔkye a ɛbɔ denden no so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Woyɛ deɛ ɔwɔ tumi sene nsuo akɛseɛ aprannaa,","poem":1},{"text":"deɛ ɔwɔ tumi sene ɛpo nworosoɔ.","poem":2},{"lineBreak":true},{"text":"Awurade a ɔte ɔsoro no yɛ kɛseɛ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ao Awurade, wo nhyehyɛeɛ gyina hɔ pintinn;","poem":1},{"text":"kronkronyɛ hyɛ wo fie animuonyam","poem":2},{"lineBreak":true},{"text":"daa nyinaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}