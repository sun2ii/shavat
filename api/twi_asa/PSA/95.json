{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Mommra mma yɛnto dwom wɔ anigyeɛ so mma Awurade;","poem":1},{"text":"momma yɛmmɔ ose mma yɛn nkwagyeɛ Botan no.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Momma yɛmfa aseda mmra nʼanim,","poem":1},{"text":"na yɛmfa ahosɛpɛ nnwom mma no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɛfiri sɛ, Awurade yɛ Onyankopɔn kɛseɛ,","poem":1},{"text":"ɔhenkɛseɛ wɔ anyame nyinaa so.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne nsam na asase mu nneɛma nyinaa wɔ,","poem":1},{"text":"na mmepɔ mpampam wɔ no.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ɛpo wɔ no. Ɔno na ɔbɔeɛ,","poem":1},{"text":"na ne nsa na ɛnwonoo asase kesee no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mommra mma yɛnkoto nsom no.","poem":1},{"text":"Momma yɛmmu nkotodwe wɔ Awurade yɛn Yɛfoɔ no anim!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔyɛ yɛn Onyankopɔn;","poem":1},{"text":"yɛyɛ nʼadidibea nnipa,","poem":2},{"lineBreak":true},{"text":"ne nnwankuo a ɔhwɛ wɔn so.","poem":2},{"lineBreak":true},{"text":"Ɛnnɛ, sɛ mote ne nne a,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"mommpirim mo akoma sɛdeɛ moyɛɛ wɔ Meriba no,","poem":2},{"lineBreak":true},{"text":"sɛdeɛ moyɛɛ da no wɔ Masa, ɛserɛ no so no,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɛhɔ no, mo mpanimfoɔ sɔɔ me hwɛeɛ,","poem":1},{"text":"a na wɔnim deɛ meyɛ maa wɔn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Me bo fuu saa nnipa no mfeɛ aduanan","poem":1},{"text":"na mekaa sɛ, “Wɔyɛ nnipa a wɔn akoma amane afiri me ho,","poem":2},{"lineBreak":true},{"text":"na wɔanhunu mʼakwan.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ɛno enti mekaa ntam wɔ mʼabufuo mu sɛ,","poem":1},{"text":"“Wɔrenhyɛne mʼahomegyeɛ mu da.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}