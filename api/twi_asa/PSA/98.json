:2}]},{"type":"verse","number":6,"content":[{"text":"momfa totorobɛnto ne nnwennini mmɛn,","poem":1},{"text":"nteam ahosɛpɛ so wɔ Awurade, yɛn ɔhene no anim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɛpo ne abɔdeɛ a ɛwɔ mu nyinaa monworo so;","poem":1},{"text":"asase ne wɔn a wɔte soɔ nyinaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Momma nsubɔntene mmɔ wɔn nsam,","poem":1},{"text":"mmepɔ nka mmom nto ahurisie dwom;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ma wɔnto dwom wɔ Awurade anim,","poem":1},{"text":"ɛfiri sɛ ɔreba abɛbu ewiase atɛn.","poem":2},{"text":"Ɔde tenenee bɛbu ewiase atɛn","poem":1},{"text":"na ɔde pɛpɛyɛ abu nnipa atɛn.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}