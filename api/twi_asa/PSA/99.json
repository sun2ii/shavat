{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"PSA","translationId":"twi_asa","name":"Nnwom","commonName":"Nnwom","title":"Nnwom","order":19,"numberOfChapters":150,"sha256":"975de7bca50a6c260e1ac8eaa5342acaa28c923b4bfa5cf64b161a786ac4e160","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/twi_asa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Awurade di ɔhene,","poem":1},{"text":"momma amanaman no ho mpopo;","poem":2},{"text":"ɔte nʼahennwa so wɔ Kerubim ntam,","poem":1},{"text":"ma asase nwoso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awurade a ɔwɔ Sion yɛ kɛseɛ;","poem":1},{"text":"wɔama ne so wɔ amanaman nyinaa mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma wɔnkamfo wo din a ɛso na ɛyɛ nwanwa no.","poem":1},{"text":"Ɔyɛ kronkron.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɔhene no yɛ kɛseɛ, ɔdɔ atɛntenenee,","poem":1},{"text":"woama pɛpɛyɛ atim;","poem":2},{"text":"wayɛ deɛ ɛyɛ na ɛtene","poem":1},{"text":"wɔ Yakob mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momma Awurade, yɛn Onyankopɔn so","poem":1},{"text":"na monsɔre no wɔ ne nan ntiasoɔ anim;","poem":2},{"lineBreak":true},{"text":"ɔyɛ kronkron.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Na Mose ne Aaron ka nʼasɔfoɔ no ho,","poem":1},{"text":"na Samuel ka wɔn a wɔbɔɔ ne din no ho;","poem":2},{"text":"wɔfrɛɛ Awurade,","poem":1},{"text":"na ɔgyee wɔn so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ɔfiri omununkum dum mu kasa kyerɛɛ wɔn;","poem":1},{"text":"wɔdii mmara ne ahyɛdeɛ a ɔmaa wɔn no so.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ao Awurade, yɛn Onyankopɔn,","poem":1},{"text":"wogyee wɔn so;","poem":2},{"text":"woyɛɛ bɔnefakyɛ Onyankopɔn maa Israel,","poem":1},{"text":"nanso wɔtwee wɔn aso wɔ wɔn nnebɔne ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Momma Awurade yɛn Onyankopɔn so","poem":1},{"text":"na monsɔre no wɔ ne bepɔ kronkron no so,","poem":2},{"lineBreak":true},{"text":"na Awurade yɛn Onyankopɔn yɛ kronkron.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}