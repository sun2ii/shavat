{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"SNG","translationId":"twi_asa","name":"Nnwom Mu Dwom","commonName":"Nnwom Mu Dwom","title":"Nnwom Mu Dwom","order":22,"numberOfChapters":8,"sha256":"37ff5a8cb4fad02103397129220639518ae80772b0107763e0d9dfbcba706145","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/twi_asa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Meyɛ Saron nhwiren","poem":1},{"noteId":2},{"text":"ne bɔnhwa mu sukooko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sɛdeɛ sukooko a ɛwɔ nkasɛɛ mu teɛ no","poem":1},{"text":"saa ara na me dɔfoɔ te wɔ mmabaawa mu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sɛdeɛ aprɛ teɛ wɔ kwaeɛ mu nnua mu no","poem":1},{"text":"saa ara na me dɔfoɔ teɛ wɔ mmaranteɛ mu.","poem":2},{"text":"Sɛ metena ne nwunu mu a, menya ahomeka","poem":1},{"text":"na nʼaba nso yɛ mʼanom dɛ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ɔde me akɔ apontoɔ ase,","poem":1},{"text":"na mʼahyɛnsodeɛ yɛ ɔdɔ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Momma me bobe aba na menya ahoɔden,","poem":1},{"text":"momma me aprɛ na ɛnnwodwo me,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ ɔdɔ ama matɔ baha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne nsa benkum da mʼatikɔ,","poem":1},{"text":"na ne nsa nifa aka me afam ne bo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yerusalem mmammaa, mehyɛ mo sɛ,","poem":1},{"text":"Momfa wiram atwewa ne ɔforoteɛ nka ntam sɛ","poem":2},{"text":"morennyane, na morenhwanyane ɔdɔ mu","poem":1},{"text":"kɔsi ɛberɛ a ɛsɛ mu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tie! Me dɔfoɔ!","poem":1},{"text":"Hwɛ! Ɔno na ɔreba no,","poem":2},{"text":"ɔrehurihuri wɔ mmepɔ no so","poem":1},{"text":"na ɔbɔ pentenkwa wɔ nkokoɔ no so.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Me dɔfoɔ te sɛ ɔtwe anaa ɔforoteɛ.","poem":1},{"text":"Hwɛ! Ɔgyina yɛn ɔfasuo akyi,","poem":2},{"text":"ɔhwɛ mpomma no mu,","poem":1},{"text":"wagyene nʼani hwɛ ntokua no mu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Me dɔfoɔ kasa kyerɛɛ me sɛ,","poem":1},{"text":"“Sɔre, me dɔfoɔ ne mʼahoɔfɛ","poem":2},{"lineBreak":true},{"text":"na bra me nkyɛn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hwɛ! Awɔberɛ atwam;","poem":1},{"text":"na osutɔ atwam kɔ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nhwiren afifiri asase ani:","poem":1},{"text":"nnwontoɔ berɛ aso.","poem":2},{"text":"Wɔte mmorɔnoma su","poem":1},{"text":"wɔ yɛn asase so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Borɔdɔma agu nhyerɛnne;","poem":1},{"text":"na bobe hwa agye baabiara.","poem":2},{"text":"Sɔre bra, me dɔfoɔ;","poem":1},{"text":"mʼahoɔfɛ bra me nkyɛn.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mʼaborɔnoma a wohyɛ abotan ntokuro mu","poem":1},{"text":"ahinta wɔ mmepɔ so,","poem":2},{"text":"ma me nhunu wʼanim;","poem":1},{"text":"ma mente wo nne;","poem":2},{"text":"wo nne yɛ dɛ,","poem":1},{"text":"na wʼanim yɛ fɛ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Monkyekyere sakraman no mma yɛn,","poem":1},{"text":"sakraman nketewa no","poem":2},{"text":"a wɔsɛe bobe nturo,","poem":1},{"text":"yɛn bobe nturo a ayɛ frɔmm no.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Me dɔfoɔ yɛ me dea, na mewɔ no;","poem":1},{"text":"ɔhwehwɛ sukooko no mu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ɛnkɔsi sɛ adeɛ bɛkye","poem":1},{"text":"na sunsumma bɛsene akɔ no,","poem":2},{"text":"dane wo ho me dɔfoɔ,","poem":1},{"text":"na yɛ sɛ ɔtwewa","poem":2},{"text":"anaa ɔforoteɛ a","poem":1},{"text":"ɔwɔ nkokoɔ mmɔnkyi mmɔnka no so.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"2.1 Yɛhunu Saron nhwiren wɔ Karmel mpoano anafoɔ fam.","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/twi_asa/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}