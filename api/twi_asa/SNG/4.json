{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"SNG","translationId":"twi_asa","name":"Nnwom Mu Dwom","commonName":"Nnwom Mu Dwom","title":"Nnwom Mu Dwom","order":22,"numberOfChapters":8,"sha256":"37ff5a8cb4fad02103397129220639518ae80772b0107763e0d9dfbcba706145","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/twi_asa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Wo ho yɛ fɛ, me dɔfoɔ!","poem":1},{"text":"Ao, wo ho yɛ fɛ!","poem":2},{"lineBreak":true},{"text":"Wʼaniwa a ɛhyehyɛ wo nkatanimu mu no te sɛ aborɔnoma.","poem":2},{"text":"Wo nwi te sɛ mpapokuo a","poem":1},{"text":"wɔresiane Gilead Bepɔ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wo se te sɛ nnwankuo a wɔatwitwa wɔn ho nwi foforɔ,","poem":1},{"text":"a wɔfiri adwareɛ.","poem":2},{"text":"Wɔnam mmienu mmienu","poem":1},{"text":"na wɔn mu biara nyɛ ankonam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wʼanofafa te sɛ koogyan ahoma;","poem":1},{"text":"wʼano yɛ fɛ.","poem":2},{"text":"Wʼasontorɔ mu a ɛhyɛ wo nkatanimu mu","poem":1},{"text":"te sɛ ateaa aduaba fa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wo kɔn te sɛ Dawid abantenten,","poem":1},{"text":"a wɔasi no fɛɛfɛ;","poem":2},{"text":"na akokyɛm apem sensɛn ho,","poem":1},{"text":"a ne nyinaa yɛ akofoɔ kyɛm.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wo nufu mmienu te sɛ atwe mma mmienu,","poem":1},{"text":"atwe mma ntafoɔ a","poem":2},{"lineBreak":true},{"text":"wɔdidi wɔ sukooko mu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ɛnkɔ si sɛ adeɛ bɛkye,","poem":1},{"text":"ama sunsum adwane no,","poem":2},{"text":"mɛkɔ kurobo bepɔ","poem":1},{"text":"ne aduhwam nkokoɔ no so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me dɔfoɔ, wo ho yɛ fɛ papa;","poem":1},{"text":"wo ho nni ɛdɛm biara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma yɛn mfiri Lebanon, mʼayeforɔ,","poem":1},{"text":"wo ne me mfiri Lebanon nkɔ.","poem":2},{"text":"Siane firi Amana atifi bra,","poem":1},{"text":"firi Senir atifi, Hermon apampam hɔ,","poem":2},{"text":"firi agyata buo mu","poem":1},{"text":"ne mmepɔ a asebɔ dɛɛdɛɛ hɔ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Woagye mʼakoma abɔ so, me nuabaa, mʼayeforɔ;","poem":1},{"text":"woagye mʼakoma abɔ so","poem":2},{"text":"wode wʼani a ɛbɔɔ me soɔ,","poem":1},{"text":"ne wo kɔnmuadeɛ mu ɔbohemaa baako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wo dɔ yɛ ahomeka, me nuabaa, mʼayeforɔ!","poem":1},{"text":"Hwɛ wo dɔ sɔ ani sene bobesa,","poem":2},{"lineBreak":true},{"text":"na wʼaduhwam yɛ hwam sene pɛperɛ biara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Adɔdɔdeɛ firi wʼano sɛ ɛwokyɛm, mʼayeforɔ;","poem":1},{"text":"nufosuo ne ɛwoɔ wɔ wo tɛkrɛma ase.","poem":2},{"lineBreak":true},{"text":"Wo ntadeɛ mu hwa te sɛ Lebanon deɛ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wote sɛ turo a wɔato ano ɛpono mu, me nuabaa, mʼayeforɔ;","poem":1},{"text":"woyɛ asutire a wɔagye ho ban, asubura a wɔasɔ ano.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wo nnua yɛ nnuabafuo so ateaa","poem":1},{"text":"a ɛso aba pa,","poem":2},{"lineBreak":true},{"text":"ahuahaa ne nnuannua,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nnuannua ne mmɛtire,","poem":2},{"lineBreak":true},{"text":"osiko ne sinamon,","poem":2},{"lineBreak":true},{"text":"a ohwamfufuo nnua hodoɔ,","poem":2},{"lineBreak":true},{"text":"kurobo ne dupapoɔ","poem":2},{"lineBreak":true},{"text":"ne pɛperɛ papa ahodoɔ nyinaa ka ho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Woyɛ turo mu asubura.","poem":1},{"text":"Woyɛ ɔtadeɛ a nsuo tene firi mu","poem":2},{"lineBreak":true},{"text":"sane firi Lebanon.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sɔre, atifi fam mframa!","poem":1},{"text":"Bra, anafoɔ fam mframa!","poem":2},{"noteId":3},{"text":"Bɔ fa me turo mu,","poem":1},{"text":"sɛdeɛ ɛbɛyɛ a ne hwa no bɛgyegye hɔ.","poem":2},{"text":"Ma me dɔfoɔ mmra ne turo mu","poem":1},{"text":"na ɔmmɛka ne nnuaba papa no nhwɛ.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"4.16 Mframa a ɛbɔ firi atifi fam no mu dwo enti ɛma nnuaba yɛ foforɔ daa. Mframa a ɛbɔ firi anafoɔ fam no mu yɛ hye na ɛma nnuaba no bere. Ne mmienu ka bɔ mu a, ɛma mframa a ɛyɛ hwam fa turo no mu.","reference":{"chapter":4,"verse":16}}]},"thisChapterLink":"/api/twi_asa/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}