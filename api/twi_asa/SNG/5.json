{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"SNG","translationId":"twi_asa","name":"Nnwom Mu Dwom","commonName":"Nnwom Mu Dwom","title":"Nnwom Mu Dwom","order":22,"numberOfChapters":8,"sha256":"37ff5a8cb4fad02103397129220639518ae80772b0107763e0d9dfbcba706145","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/twi_asa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Maba me turo mu, me nuabaa, mʼayeforɔ;","poem":1},{"text":"maboaboa me kurobo ne me nnuhwam ano.","poem":2},{"text":"Madi me woɔkyɛm ne ɛwoɔ;","poem":1},{"text":"manom me bobesa ne me nufosuo.","poem":2},"Nnamfonom:",{"text":"Ao, nnamfonom, monnidi na monnom;","poem":1},{"text":"Ao, adɔfonom, monnom deɛ ɛbɛmee mo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Medaeɛ nanso mʼakoma anna.","poem":1},{"text":"Tie! Me dɔfoɔ rebɔ ɛpono no mu;","poem":2},{"text":"“Bue me, me nuabaa, me dɔ,","poem":1},{"text":"mʼaborɔnoma, a ne ho nni dɛm.","poem":2},{"text":"Obosuo afɔ me tirim,","poem":1},{"text":"anadwo mu bosuo afɔ me nwi.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maworɔ mʼatadeɛ,","poem":1},{"text":"mensane mfa nhyɛ anaa?","poem":2},{"text":"Mahohoro me nan ase,","poem":1},{"text":"memma ho nyɛ fi bio anaa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Me dɔfoɔ yɛɛ sɛ ɔrebue ɛpono no","poem":1},{"text":"mʼakoma firi aseɛ bɔɔ kimkim wɔ me mu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mesɔree sɛ merekɔhini me dɔfoɔ,","poem":1},{"text":"na me nsa ho kurobo","poem":2},{"text":"ne me nsateaa ho aduhwam,","poem":1},{"text":"yɛɛ apratwom no ho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mebue maa me dɔfoɔ no,","poem":1},{"text":"nanso na ɔkɔ.","poem":2},{"lineBreak":true},{"text":"Ne korɔ no maa me ho dwirii me.","poem":2},{"text":"Mehwehwɛɛ no nanso manhunu no baabiara.","poem":1},{"text":"Mefrɛɛ no nanso wannye me so.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awɛmfoɔ no hunuu me","poem":1},{"text":"ɛberɛ a wɔrebɔ aporɔ wɔ kuropɔn no mu.","poem":2},{"text":"Wɔbobɔɔ me pirapiraa me;","poem":1},{"text":"wɔyii mʼatadeɛ kɔreɛ","poem":2},{"lineBreak":true},{"text":"saa awɛmfoɔ a wɔwɛn afasuo no!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ao, Yerusalem mmammaa, mehyɛ mo,","poem":1},{"text":"sɛ mohunu me dɔfoɔ no a,","poem":2},{"text":"asɛm bɛn na mobɛka akyerɛ no?","poem":1},{"text":"Monka nkyerɛ no sɛ ɔdɔ ama matɔ piti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ɛdeɛn na wo dɔfoɔ de sene afoforɔ,","poem":1},{"text":"mmaa ahoɔfɛfoɔ mu ahoɔfɛ?","poem":2},{"text":"Ɛdeɛn na wo dɔfoɔ de sene afoforɔ a","poem":1},{"text":"enti wohyɛ yɛn sei?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Me dɔfoɔ ho twa na ɔgyegye,","poem":1},{"text":"wɔfa mpemdu a ɔda mu fua.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne ti yɛ sikakɔkɔɔ amapa;","poem":1},{"text":"ne tiri so nwi yɛ kuhaa,","poem":2},{"lineBreak":true},{"text":"na ɛyɛ tuntum sɛ kwaakwaadabi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nʼaniwa aba te sɛ aborɔnoma a","poem":1},{"text":"ɔgyina asuwa bi ho;","poem":2},{"text":"ɛte sɛ deɛ wɔde nufosuo adware no,","poem":1},{"text":"na ɛsisi hɔ sɛ abohemaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nʼafono te sɛ pɛperɛ a wɔasɛ no kɛtɛ.","poem":1},{"text":"Ɛho hwa te sɛ aduhwam.","poem":2},{"text":"Nʼanofafa te sɛ sukooko","poem":1},{"text":"a ɛsosɔ kurobo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nʼabasa te sɛ sikakɔkɔɔ abaa","poem":1},{"text":"a wɔde sikabereɛboɔ asisi mu.","poem":2},{"text":"Ne onipadua te sɛ asonse a wɔatwi ho","poem":1},{"text":"na wɔde aboɔdemmoɔ adura ho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne nan te sɛ abohemaa afadum a","poem":1},{"text":"ɛsisi sikakɔkɔɔ amapa nnyinasoɔ so.","poem":2},{"text":"Ne bɔberɛ te sɛ Lebanon a","poem":1},{"text":"ɔyɛ sononko sɛ ne ntweneduro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nʼano te sɛ ɔdɛ ankasa;","poem":1},{"text":"ɛkwan biara so, ne ho yɛ fɛ.","poem":2},{"text":"Me dɔfoɔ nie, mʼadamfo nie,","poem":1},{"text":"Ao, Yerusalem mmammaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}