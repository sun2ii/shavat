{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ZEP","translationId":"twi_asa","name":"Sefania","commonName":"Sefania","title":"Odiyifoɔ Sefania Nwoma","order":36,"numberOfChapters":3,"sha256":"c9aea752d27c71788905952342efea60dbf67d5bc128f049c538a1e8cafaaf3d","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Awurade asɛm a ɛbaa Sefania a ɔyɛ Kusi ba, Gedalia ba, Amaria ba, Hesekia ba nkyɛn nie. Ɛbaa Yudahene Yosia a ɔyɛ Amon ba berɛ so."]},{"type":"heading","content":["Atemmuo A Ɛtia Yuda"]},{"type":"verse","number":2,"content":[{"text":"“Mɛpra biribiara afiri asase so”","poem":1},{"text":"deɛ Awurade seɛ nie,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Mɛpra nnipa ne mmoa nyinaa;","poem":1},{"text":"mɛpra nnomaa a wɔwɔ ewiem","poem":2},{"text":"ne mpataa a wɔwɔ ɛpo mu nyinaa.","poem":1},{"text":"Atirimuɔdenfoɔ bɛnya wira a ɛsum hɔ nko ara","poem":2},{"text":"sɛ mesɛe adasamma a wɔwɔ asase yi so a,”","poem":1},{"text":"deɛ Awurade seɛ nie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Mɛtene me nsa wɔ Yuda","poem":1},{"text":"ne wɔn a wɔte Yerusalem nyinaa so;","poem":2},{"text":"na mɛsɛe Baal ho biribiara a aka wɔ ha,","poem":1},{"text":"na masɛe abosonsomfoɔ ne abosomfoɔ asɔfoɔ no din","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wɔn a wɔkoto sɔre wɔn adan atifi,","poem":1},{"text":"de sɔre abɔdeɛ a ɛwɔ ewiem,","poem":2},{"text":"wɔn a wɔkoto de Awurade ka ntam","poem":1},{"text":"na wɔde Molek nso ka ntam,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wɔn nso a wɔgyae Awurade akyiridie","poem":1},{"text":"na wɔnhwehwɛ Awurade anaa wɔmmisa nʼase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Monyɛ komm wɔ Asafo Awurade anim,","poem":1},{"text":"ɛfiri sɛ, Awurade ɛda no abɛn.","poem":2},{"text":"Awurade asiesie afɔrebɔdeɛ;","poem":1},{"text":"wadwira wɔn a wato nsa afrɛ wɔn no ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Awurade afɔrebɔ ɛda no,","poem":1},{"text":"mɛtwe mmapɔmma","poem":2},{"lineBreak":true},{"text":"ne ahenemma","poem":2},{"text":"ne wɔn a wɔhyehyɛ","poem":1},{"text":"ananafoɔ ntadeɛ nyinaa aso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saa ɛda no mɛtwe wɔn","poem":1},{"text":"a wɔkwati aponnwa no nyinaa aso.","poem":2},{"text":"Wɔn a wɔde akakabensɛm","poem":1},{"text":"ne nsisie hyehyɛ wɔn abosomfie ma no.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Saa ɛda no,”","poem":1},{"text":"sɛdeɛ Awurade seɛ nie,","poem":2},{"text":"“Esu bɛfiri Mpataa Ɛpono ano,","poem":1},{"text":"agyaadwotwa bɛfiri Atenaeɛ Foforɔ","poem":2},{"lineBreak":true},{"text":"na nnyegyeeɛ a ano yɛ den afiri nkokoɔ no so aba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Montwa adwo, mo a mote adetɔnbea hɔ no","poem":1},{"text":"wɔbɛtɔre wɔn a mo ne wɔn di dwa ase,","poem":2},{"lineBreak":true},{"text":"dwetɛ adwadifoɔ nyinaa nso wɔbɛsɛe wɔn.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mede nkanea bɛkyini ahwehwɛ Yerusalem mu","poem":1},{"text":"na matwe wɔn a wɔgyaagyaa wɔn ho aso,","poem":2},{"lineBreak":true},{"text":"wɔn a wɔte sɛ bobesa puo no,","poem":2},{"text":"a wɔdwene sɛ, ‘Awurade nnyɛ wɔn hwee","poem":1},{"text":"sɛ ɛyɛ papa anaa bɔne.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wɔbɛfom wɔn ahonyadeɛ,","poem":1},{"text":"na wɔabubu wɔn afie agu.","poem":2},{"text":"Wɔbɛsisi afie, nanso wɔrentena mu","poem":1},{"text":"wɔbɛyɛ bobe mfuo","poem":2},{"lineBreak":true},{"text":"nanso wɔrennom emu nsã.”","poem":2}]},{"type":"heading","content":["Awurade Ɛda Kɛseɛ No"]},{"type":"verse","number":14,"content":[{"text":"Awurade ɛda kɛseɛ no abɛn,","poem":1},{"text":"abɛn na ɛreba ntɛm so.","poem":2},{"text":"Tie! Osu a wɔbɛsu Awurade ɛda no bɛyɛ ya,","poem":1},{"text":"ɔkofoɔ a ɔwɔ hɔ nso nteamu bɛyɛ saa ara.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saa ɛda no bɛyɛ abufuo ɛda,","poem":1},{"text":"ɛyɛ ahoyera ne ɔyea ɛda;","poem":2},{"text":"ɛyɛ amanehunu ne ɔsɛeɛ ɛda,","poem":3},{"text":"ɛyɛ esum ne kusukuukuu ɛda","poem":2},{"text":"ɛyɛ omununkum ne kusuuyɛ ɛda,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"ɛyɛ totorobɛnto hyɛn ne ɔko nteam","poem":2},{"text":"a ɛtia nkuropɔn a ɛwɔ banbɔ","poem":1},{"text":"ne ntwɛtwɛaso abantenten ɛda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mede awerɛhoɔ bɛba nnipa no so","poem":1},{"text":"na wɔbɛnante sɛ anifirafoɔ,","poem":2},{"lineBreak":true},{"text":"ɛfiri sɛ wɔayɛ bɔne atia Awurade.","poem":2},{"text":"Wɔbɛhwie wɔn mogya agu sɛ mfuturo,","poem":1},{"text":"na wɔn ayamdeɛ nso sɛ atantanneɛ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wɔn dwetɛ anaa sikakɔkɔɔ","poem":1},{"text":"rentumi nnye wɔn nkwa","poem":2},{"text":"wɔ Awurade abufuo ɛda no.”","poem":1},{"lineBreak":true},{"text":"Ne ninkuntwe mu ogya no","poem":2},{"text":"bɛhye ɔman no nyinaa,","poem":1},{"text":"na ɔbɛma asase no so tefoɔ nyinaa nkwa","poem":2},{"lineBreak":true},{"text":"aba awieeɛ mpofirim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}