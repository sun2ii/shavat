{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ZEP","translationId":"twi_asa","name":"Sefania","commonName":"Sefania","title":"Odiyifoɔ Sefania Nwoma","order":36,"numberOfChapters":3,"sha256":"c9aea752d27c71788905952342efea60dbf67d5bc128f049c538a1e8cafaaf3d","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mommoaboa mo ho ano, mommoaboa mo ho ano,","poem":1},{"text":"Ao, animguaseɛ ɔman,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ansa na ɛberɛ a wɔahyɛ no aduru,","poem":1},{"text":"na ɛda no resene te sɛ ntɛtɛ,","poem":2},{"text":"ansa na Awurade abufuhyeɛ no","poem":1},{"text":"aba mo so,","poem":2},{"text":"ansa na Awurade abufuo ɛda no","poem":1},{"text":"aba mo so.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Monhwehwɛ Awurade, ahobrɛasefoɔ a mowɔ asase so,","poem":1},{"text":"mo a moyɛ nʼahyɛdeɛ.","poem":2},{"text":"Monhwehwɛ tenenee, monhwehwɛ ahobrɛaseɛ;","poem":1},{"text":"ebia ɔbɛkora mo","poem":2},{"lineBreak":true},{"text":"Awurade abufuo ɛda no.","poem":2}]},{"type":"heading","content":["Atemmuo A Ɛtia Filistia"]},{"type":"verse","number":4,"content":[{"text":"Wɔbɛgya Gasa","poem":1},{"text":"na wɔagya Askelon sɛ kurofo.","poem":2},{"text":"Owigyinaeɛ na ɔbɛma Asdod ada mpam","poem":1},{"text":"na wɔatutu Ekron ase.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Monnue mo a mote mpoano,","poem":1},{"text":"Ao, mo Keretifoɔ;","poem":2},{"text":"Awurade asɛm tia mo.","poem":1},{"text":"Ao, Kanaan, Filistifoɔ asase.","poem":2},{"text":"Mɛtɔre mo ase,","poem":1},{"text":"na obiara renka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asase a ɛda mpoano, baabi a Keretifoɔ teɛ","poem":1},{"text":"bɛyɛ atenaeɛ ama nnwanhwɛfoɔ","poem":2},{"lineBreak":true},{"text":"ne wɔn nnwammuo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saa asase no bɛyɛ Yudafie nkaeɛfoɔ no dea;","poem":1},{"text":"ɛhɔ na wɔbɛnya mmoa adidibea.","poem":2},{"text":"Anwummerɛ wɔbɛdeda wɔ","poem":1},{"text":"Askelon afie mu.","poem":2},{"text":"Na Awurade, wɔn Onyankopɔn bɛhwɛ wɔn,","poem":1},{"text":"na ɔde wɔn ahonyadeɛ nyinaa bɛsane ama wɔn.","poem":2}]},{"type":"heading","content":["Atemmuo A Ɛtia Moab Ne Amon"]},{"type":"verse","number":8,"content":[{"text":"“Mate Moab nsopa ne","poem":1},{"text":"Amonfoɔ atweetweɛ;","poem":2},{"text":"wɔn a wɔsopaa me nkurɔfoɔ","poem":1},{"text":"na wɔhunahunaa wɔn wɔ wɔn asase ho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti, sɛ mete ase yi,”","poem":1},{"text":"sɛdeɛ Asafo Awurade,","poem":2},{"lineBreak":true},{"text":"Israel Onyankopɔn, seɛ nie,","poem":2},{"text":"“Ampa ara Moab bɛyɛ sɛ Sodom,","poem":1},{"text":"na Amonfoɔ ayɛ sɛ Gomora,","poem":2},{"text":"baabi a ewira ne nkyɛn amena wɔ,","poem":1},{"text":"asase a ɛda mpan afebɔɔ.","poem":2},{"text":"Me ɔman nkaeɛ bɛfom wɔn afa;","poem":1},{"text":"me manfoɔ a wɔbɛnya wɔn ti adidim bɛfa wɔn asase.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wɔn ahantan so akatua a wɔbɛnya nie,","poem":1},{"text":"sɛ wɔsopa na wɔtwetwe Asafo Awurade nkurɔfoɔ enti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awurade ho suro bɛba wɔn so","poem":1},{"text":"ɛberɛ a ɔbɛsɛe asase no so anyame nyinaa.","poem":2},{"text":"Mpoano aman nyinaa bɛsɔre no,","poem":1},{"text":"wɔ wɔn ankasa wɔn asase so.","poem":2}]},{"type":"heading","content":["Atemmuo A Ɛtia Kus"]},{"type":"verse","number":12,"content":[{"text":"“Mo Etiopiafoɔ nso,","poem":1},{"text":"mʼakofena ano na wɔbɛkunkum mo.”","poem":2}]},{"type":"heading","content":["Atemmuo A Ɛtia Asiria"]},{"type":"verse","number":13,"content":[{"text":"Awurade bɛtene ne nsa wɔ atifi aman so","poem":1},{"text":"na wasɛe Asiria,","poem":2},{"text":"na wama Ninewe ada mpan koraa","poem":1},{"text":"na ɛso awo wesee sɛ anwea pradada so.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nnwankuo ne anantwie bɛdeda hɔ,","poem":1},{"text":"mmoadoma nyinaa.","poem":2},{"text":"Ɛserɛ so patuo ne ɔbonsam anoma","poem":1},{"text":"bɛtena nʼadum no so.","poem":2},{"lineBreak":true},{"text":"Wɔn su bɛgyegye mpomma mu,","poem":2},{"text":"mmubuiɛ bɛsisi apono ano akwan,","poem":1},{"text":"mpunan a wɔde ntweneduro ayɛ no ho bɛdeda hɔ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yei ne kuropɔn a ɛdi ahurisie","poem":1},{"text":"na ɛte asomdwoeɛ mu.","poem":2},{"text":"Ɔhoahoa ne ho sɛ,","poem":1},{"text":"“Me ne no, obiara nte sɛ me.”","poem":2},{"text":"Hwɛ sɛ deɛ atete apansam,","poem":1},{"text":"na ayɛ nkeka mmoa atenaeɛ!","poem":2},{"text":"Obiara a ɔtwam hɔ no sere no,","poem":1},{"text":"hugya ne nsa fɛdie so.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}