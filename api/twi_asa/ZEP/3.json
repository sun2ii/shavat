{"translation":{"id":"twi_asa","name":"Biblica® Wɔnhia ɛho kwamma nwoma Asante Twi Nkwa Asɛm","website":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseUrl":"https://ebible.org/Scriptures/details.php?id=twiasante","licenseNotes":null,"shortName":"ASA","englishName":"Asante Twi Bible","language":"twi","textDirection":"ltr","sha256":"58c1388e9b1bcfd5b5ccba2f1a075a20e962ec5481a66c7c22d5aed92e3c620b","availableFormats":["json"],"listOfBooksApiLink":"/api/twi_asa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"Akan","languageEnglishName":"Akan"},"book":{"id":"ZEP","translationId":"twi_asa","name":"Sefania","commonName":"Sefania","title":"Odiyifoɔ Sefania Nwoma","order":36,"numberOfChapters":3,"sha256":"c9aea752d27c71788905952342efea60dbf67d5bc128f049c538a1e8cafaaf3d","firstChapterNumber":1,"firstChapterApiLink":"/api/twi_asa/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/twi_asa/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusalem Daakye"]},{"type":"verse","number":1,"content":[{"text":"Nnome nka nhyɛsofoɔ kuropɔn","poem":1},{"text":"atuateɛ kuropɔn a ɛho agu fi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɔnnyɛ ɔsetie mma obiara","poem":1},{"text":"ɔnnye nteɛsoɔ biara nto mu.","poem":2},{"text":"Ɔmfa ne ho nto Awurade so.","poem":1},{"text":"Ɔntwi mmɛn ne Onyankopɔn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nʼakandifoɔ yɛ agyata a wɔbobɔ mu,","poem":1},{"text":"ne sodifoɔ yɛ mpataku a wɔnam anadwo,","poem":2},{"text":"a wɔnnya biribiara mma adekyeɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne nkɔmhyɛfoɔ yɛ ahantan;","poem":1},{"text":"wɔyɛ afatwafoɔ.","poem":2},{"text":"Nʼasɔfoɔ gu kronkronbea ho fi.","poem":1},{"text":"Wɔnam mmara no so di nsɛmmɔne.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awurade a ɔte ne mu no yɛ ɔteneneeni;","poem":1},{"text":"ɔnnyɛ mfomsoɔ biara.","poem":2},{"text":"Adekyeeɛ biara ɔda ne tenenee adi,","poem":1},{"text":"na ɔnni hwammɔ da,","poem":2},{"lineBreak":true},{"text":"nanso amumuyɛfoɔ deɛ wonnim aniwuo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Masɛe amanaman;","poem":1},{"text":"madwiri wɔn abandenden agu.","poem":2},{"text":"Wɔn mmorɔno so adeda mpan,","poem":1},{"text":"a obiara ntwa mu hɔ.","poem":2},{"text":"Wɔaseɛ wɔn nkuropɔn;","poem":1},{"text":"a obi biara renka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meka kyerɛɛ kuropɔn no sɛ,","poem":1},{"text":"‘ampa ara wobɛsuro me","poem":2},{"text":"na woagye nteɛsoɔ ato mu!’","poem":1},{"lineBreak":true},{"text":"Na afei ne tenaberɛ rensɛe,","poem":1},{"text":"na mʼasotwe biara nso remma ne so.","poem":2},{"text":"Nanso, wɔn ho peree wɔn","poem":1},{"text":"sɛ wɔbɛkɔso ayɛ bɔne wɔn nneyɛeɛ nyinaa mu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti, twɛn me,” sɛdeɛ Awurade seɛ nie,","poem":1},{"text":"“na ɛda no mɛsɔre adi adanseɛ.","poem":2},{"text":"Mayɛ mʼadwene sɛ mɛboaboa amanaman","poem":1},{"text":"ne ahennie ano","poem":2},{"text":"na mahwie mʼabufuo agu wɔn so","poem":1},{"text":"mʼabufuhyeɛ nyinaa.","poem":2},{"text":"Me ninkuntwe abufuo ogya mu no,","poem":1},{"text":"asase nyinaa bɛhye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Afei mɛdwira nnipa no ano,","poem":1},{"text":"na wɔn nyinaa abɔ Awurade din","poem":2},{"lineBreak":true},{"text":"na wɔaka abɔ mu asom no.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mʼasomfoɔ, me nkurɔfoɔ a wɔabɔ ahwete no","poem":1},{"text":"bɛfiri nsubɔntene a ɛwɔ Kus nohoa","poem":2},{"lineBreak":true},{"text":"de wɔn afɔrebɔdeɛ abrɛ me.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saa ɛda no, wo Yerusalem, wɔrengu wʼanim ase","poem":1},{"text":"wɔ nneyɛeɛ bɔne a woayɛ atia me ho,","poem":2},{"text":"ɛfiri sɛ mɛyi afiri saa kuropɔn yi mu,","poem":1},{"text":"wɔn a wodi ahantan mu ahurisie","poem":2},{"text":"na worenyɛ ahantan bio","poem":1},{"text":"wɔ me bepɔ kronkron no so.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nanso mɛgya wɔ wo mu","poem":1},{"text":"wɔn a wɔdwo na wɔbrɛ wɔn ho ase,","poem":2},{"lineBreak":true},{"text":"na wɔde wɔn ho to Awurade so.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Israel nkaeɛfoɔ renyɛ bɔne","poem":1},{"text":"Wɔrenka nkontonpo nsɛm,","poem":2},{"text":"na wɔn ano renka nnaadaa nsɛm","poem":1},{"text":"wɔbɛdidi na wɔada","poem":2},{"lineBreak":true},{"text":"na obiara renyi wɔn hu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"To dwom Ao, Ɔbabaa Sion;","poem":1},{"text":"team denden Ao, Israel!","poem":2},{"text":"Ma wʼani nnye, na di ahurisie wɔ wʼakoma nyinaa mu,","poem":1},{"text":"Ao, Ɔbabaa Yerusalem!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ɛfiri sɛ, Awurade ayi wʼasotweɛ afiri wo so,","poem":1},{"text":"wama wo ɔtamfoɔ asane nʼakyi.","poem":2},{"text":"Awurade Israelhene ka wo ho;","poem":1},{"text":"worensuro ɔhaw biara bio.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saa ɛda no, wɔbɛka akyerɛ Yerusalem sɛ,","poem":1},{"text":"“Mma nsuro, Ao Sion!","poem":2},{"lineBreak":true},{"text":"Mma wo nsa mu nhodwo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Awurade wo Onyankopɔn ne wo wɔ hɔ,","poem":1},{"text":"Ɔyɛ ɔgyefoɔ ɔhoɔdenfoɔ.","poem":2},{"text":"Nʼani bɛgye wo ho","poem":1},{"text":"ɔfiri ne dɔ mu bɛdwodwo wo,","poem":2},{"lineBreak":true},{"text":"ɔde nnwontoɔ bɛma nʼani agye wo ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Mo awerɛhoɔ to bɛtwa","poem":1},{"text":"ɛfiri sɛ mobɛnya ɛkwan adi mo afahyɛ no;","poem":2},{"lineBreak":true},{"text":"mo anim rengu ase bio.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Saa ɛberɛ no me ne wɔn","poem":1},{"text":"a wɔhyɛɛ wo so nyinaa bɛdi;","poem":2},{"text":"Mɛgye mmerɛyɛfoɔ","poem":1},{"text":"na mɛboaboa wɔn a wɔabɔ wɔn ahwete no ano.","poem":2},{"text":"Mɛkamfo wɔn ahyɛ wɔn animuonyam","poem":1},{"text":"asase biara a wɔguu wɔn anim ase wɔ so no so.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saa ɛda no, mɛboaboa wo ano,","poem":1},{"text":"na mede wo aba fie.","poem":2},{"text":"Mɛhyɛ wo animuonyam na makamfo wo","poem":1},{"text":"wɔ asase so nnipa nyinaa mu","poem":2},{"text":"na mede wʼahonyadeɛ bɛsane ama wo","poem":1},{"text":"na wode wʼani bɛhunu,”","poem":2},{"lineBreak":true},{"text":"sɛdeɛ Awurade ka nie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/twi_asa/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/twi_asa/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/twi_asa/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}