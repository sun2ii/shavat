{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Mom’bor mii gom wathi/ a’di jin diki ya e bway jin","poem":1},{"lineBreak":true},{"text":"logoma ’kwanin thus gwo mo,","poem":1},{"lineBreak":true},{"text":"walla dosh e bway gi imanmii miinthus mo,","poem":1},{"lineBreak":true},{"text":"walla c̱a’b mo e moŋ’ko gi uni gun ’theḵ shushi mis mo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"hili mom’bor bwam piti mo tani di’d e gwoŋḵan gi Tap̱a Arumgimis jin c̱inu mo,","poem":1},{"lineBreak":true},{"text":"dhali e gwoŋḵan piti jin c̱inu mo tani a’di ki c̱i is ki a’di montee mo dhali mon’thiny mo be.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A’di wana e ki cwa","poem":1},{"lineBreak":true},{"text":"jin c̱u’thkunu e shemen yi’de/ jin guski’d mo,","poem":1},{"lineBreak":true},{"text":"a’di jin gwono’dki maman ki yil piti mo,","poem":1},{"lineBreak":true},{"text":"dhali ’cemen piti diki ḵu’th mo.","poem":1},{"lineBreak":true},{"text":"Eya ris to ’baar kun miina a’di mo tani a’di rusa/ rus mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imanmii tonthus mo tani yisa wakana,","poem":1},{"lineBreak":true},{"text":"hili uni wana e ka ’pi’b jin ’dashkina ’tham mo be.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wakan imanmii tonthus mo tani mini ’koki dosh mo ka tee gi gwon dwall jin toru gwo ’twa/a ’cesh mo","poem":1},{"lineBreak":true},{"text":"walla imanmii miinthus si’da/ e dhan mo ma tul ’kup̱ gi ’kwani ma ḵar/e mo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"haali/ Tap̱a Arumgimis mishki bway gi a’diŋ ḵar/e mo,","poem":1},{"lineBreak":true},{"text":"hili bway gi uni gun mii tonthus mo tani ta mony’ce’d sho’k mo be.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/EXO/20.json","previousChapterAudioLinks":{},"numberOfVerses":6}