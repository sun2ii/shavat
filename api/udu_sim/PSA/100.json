{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["Gway jin yuḵu mo gom mo jin ’boruwa ’borim bwa i is gom to jin ’ciṯẖu/ ’kus mo."]},{"type":"verse","number":1,"content":[{"text":"Ḵumi cuuwa/ ki moŋ’kuny bwa e Tap̱a mo, aris um ’kwaniny’cesh mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miiyi Tap̱a to ki bwaŋ ’kunyka/ mo.","poem":1},{"lineBreak":true},{"text":"Iiyu/ i buŋ’kusi a’di ki gway ilu/ mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mishi mo mo ki a’di ta Tap̱a jin ta’da Arumgimis mo.","poem":1},{"lineBreak":true},{"text":"A’di ta a’di jin uḵki ana mo dhali ana tana kum piti mo be.","poem":1},{"lineBreak":true},{"text":"Ana tana ’kwanim piti mo dhali ana tana ḵa’bal ma shon dhii/i’d piti mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cic̱i e ’twaŋkal ma goŋ piti ki mo jin ’boruwa ’bor bwa i is mo,","poem":1},{"lineBreak":true},{"text":"dhali e mom piti jin di ’kup̱ ḵany nyaḵki mo jin maŋuwa maŋ mo.","poem":1},{"lineBreak":true},{"text":"C̱iyi a’di mo jin ’boruwa ’bor bwa i is mo, dhali ’bori gway piti mii mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haali/ Tap̱a a’di ’bora’bor mo.","poem":1},{"lineBreak":true},{"text":"Mo/en piti jin ṯelu sho’k mo tani a’di ’dimki ’kup̱ ki sule/ sule/ mo,","poem":1},{"lineBreak":true},{"text":"dhali mo ma isiŋ ganam piti eya risa nyaḵum yil ki ’kwani mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}