{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Maŋi Tap̱a mo.","poem":1},{"lineBreak":true},{"text":"Maŋi amaŋ mo, ayy um c̱iŋkina/ gi Tap̱a mo,","poem":1},{"lineBreak":true},{"text":"maŋi gway gi Tap̱a mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mom’bor mii midi di mo gom gway gi Tap̱a mo","poem":1},{"lineBreak":true},{"text":"’pena tee yansan mo dhali ki sule/ sule/ mo dhali ki sule/ sule/ mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"’Peni mo jin sul ma tente/ mo tani dhali mo jin yula a’di mo tani","poem":1},{"lineBreak":true},{"text":"gway gi Tap̱a a’di iminu maŋ mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tap̱a a’di iḵa’damaḵa’dam ap̱owa ris kal gi ’kwaniny’cesh mo,","poem":1},{"lineBreak":true},{"text":"dhali monycam piti a’di diki’da p̱o/ momis mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaja a’di iwakina e ki Tap̱a Arumgimis bana mo,","poem":1},{"lineBreak":true},{"text":"a’di jin c̱a’bki’d e mo jin ḵa’dama/ ḵa’dam mo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"a’di jin hilki mo ka luŋgu’b","poem":1},{"lineBreak":true},{"text":"’pena p̱o/ momis mo dhali mony’cesh mo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A’di ki ’de’k ’kwani kun hatha’ko’d ki ha’th ’peni bu’da’cesh mo","poem":1},{"lineBreak":true},{"text":"dhali a’di ki ’de’k uni kun mini mii ta gi to mo ’pena duhal ’piny mo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mmodhu uni mmonyaḵ ’ko ki iya/ gi imaliḵ mo,","poem":1},{"lineBreak":true},{"text":"dhali nyaḵki iya/ gi imaliḵ gi ’kwanim piti mo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A’di ki c̱iya ’boma burum pa mo mmoc̱a’b mo,","poem":1},{"lineBreak":true},{"text":"mmokara yim mmo’kuny bwa ki ’kuny jin shiyi’d mo me’d kum gi uc̱i mo.","poem":1},{"lineBreak":true},{"text":"Maŋi Tap̱a mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}