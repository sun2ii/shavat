{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Me’d jin yakin ma Israyiil ka pije/ ’peni Pam Masir mo tani","poem":1},{"lineBreak":true},{"text":"gu’b ma Yakuub ’peni ’kwani kun wal ’twan tiya mo tani","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yahuuda/ warki’d ki mom piti jin ḵogu mo,","poem":1},{"lineBreak":true},{"text":"dhala Israyiil a’di ta mo jin tanu tap̱a ki sule/ sule/ mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dhan ḵumma/ yi’de/ hilki mo mo dhali ya ŋwac̱a/ mo.","poem":1},{"lineBreak":true},{"text":"Dhali Ḵumma/ Yi’de/ Uurdun doḵki’d ka nyaŋ’ko’d mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"’Kuwosha turga/ p̱ekina ŋalbothoŋ ki ’thir ’thir mo me’d gwasiŋ ḵa’bal mo,","poem":1},{"lineBreak":true},{"text":"dhali ushi wosha gwa’dga/ wana e ki ushi ḵa’bal mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ata mii /eye, ayy ḵumma/ yi’de/, ki /e guskin kan mo?","poem":1},{"lineBreak":true},{"text":"Ayy Uurdun, katinta doḵkina /e ka nyaŋ’ko’d mo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ayy ’kuwosha turga/, ata p̱ekina um ki ’thir ’thir me’d gwasiŋ ḵa’bal kan mo?","poem":1},{"lineBreak":true},{"text":"Dhali um ushi wosha gwa’dga/ kun wana e ki ushi ḵa’bal mo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Deeyi ma ki bir bir mo, ayy mony’cesh, e buŋ’kus gi Tap̱a mo,","poem":1},{"lineBreak":true},{"text":"e buŋ’kus ma Arumgimis ma Yakuub mo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"a’di jin ṯu’kki wosh mo mmota a/al gom yi’de/ mo","poem":1},{"lineBreak":true},{"text":"dhali wosh jin biliṯki o’d mo tani warki’d ki yi’de/ jin kasha e mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}