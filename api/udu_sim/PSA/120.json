{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"E mo ma c̱is mo tani aha/ gwokina ’twa/i Tap̱a mo,","poem":1},{"lineBreak":true},{"text":"ki a’di midi ’taki thoḵ aha/ ’twa/ mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"’Cuḵi aha/ mo, ayy Tap̱a,","poem":1},{"lineBreak":true},{"text":"’peni ’twa/ pem jin ta’da ṯor mo,","poem":1},{"lineBreak":true},{"text":"dhali ’pena le’d pem jin he’kki’da he’k e mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ata a’di iminu c̱i /e mo?","poem":1},{"lineBreak":true},{"text":"Dhali tonta a’di iminu mii gom /e mo,","poem":1},{"lineBreak":true},{"text":"/e jin tana le’d jin he’kki’da he’k e mo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Athop̱a/ jin kaaka jin ḵala wathi/ ma mee","poem":1},{"lineBreak":true},{"text":"nyaḵka ’cila’th o’d jin shwa’d ki bar bar mo ’peni cwa jin wana e ka shilgwalish mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wayyi e aha/ ki aha/ yakina yanyc̱a/ e Pam Maashik mo,","poem":1},{"lineBreak":true},{"text":"ki aha/ c̱a’bkina e bwaman gu’b burrinye/ ma Gidar mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ki rash rash mo tani aha/ c̱a’bkina","poem":1},{"lineBreak":true},{"text":"e bwaman uni gwansan kun shi/ki moŋḵu’th isi e mo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aha/ tana gom moŋḵu’th is mo,","poem":1},{"lineBreak":true},{"text":"hili ki aha/ okina gwo mo tani","poem":1},{"lineBreak":true},{"text":"uni ŋap̱kina nyor mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}