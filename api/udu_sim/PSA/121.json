{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"Aha/ ’deka em pem ’kup̱ ki wosh kun turatur mo.","poem":1},{"lineBreak":true},{"text":"’Peni mana imina woṯẖ pem ip̱u’du/ mo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mowoṯẖ pem p̱u’dki’d ’peni Tap̱a mo,","poem":1},{"lineBreak":true},{"text":"a’di jin uḵki momis dhali mony’cesh mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A’di midi diki dhal sho’k pini bway ki a’di minu joc̱ mo,","poem":1},{"lineBreak":true},{"text":"a’di yan jin kar /e mo tani mina e diki ’ce’d mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hili mo mo ma, a’di jin dhu ’Kwani ma Israyiil mo tani","poem":1},{"lineBreak":true},{"text":"a’di mina e diki ’ce’d mo walla midi diki ish e mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tap̱a a’di ita’da mankar /e mo.","poem":1},{"lineBreak":true},{"text":"Tap̱a a’di ita’da la goma bim poros pini mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atente/ midi diki ’kosh /e montee mo","poem":1},{"lineBreak":true},{"text":"walla appe midi diki ’kosh /e mon’thiny mo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tap̱a midi kar /e ’pena ris tonthusi ’baar mo.","poem":1},{"lineBreak":true},{"text":"A’di midi kar mondiki/em pini mo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tap̱a a’di imidi kara kar mo gom yam pini jin mina /e ya ka pije/ mo dhali kul pini jin mina /e kulu/ ka nyaŋ’ko’d mo,","poem":1},{"lineBreak":true},{"text":"’pena tee yansan mo dhali ki sule/ sule/ ya ye ’ba/ mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}