{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"E /e mo tani aha/ ’deka em pem ’kup̱ ki mis mo,","poem":1},{"lineBreak":true},{"text":"ayy /e jin dikin eya ḵursi ma maliḵ e momis mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hili mo mo ma, me’d jin hila e gi c̱iŋkina/ me’d gi tap̱am buni mo,","poem":1},{"lineBreak":true},{"text":"dhali me’d jin hila e gi nyara/ me’d ma yim jin karu mmohil c̱iŋkina/ nyara/ mo tani","poem":1},{"lineBreak":true},{"text":"wakan em bana si’da/ hil ’kup̱ ki Tap̱a Arumgimis bana mo,","poem":1},{"lineBreak":true},{"text":"ntagi a’di midi miimii ap̱o/ ana mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Miiyi mii ap̱o/ aman mo ma, ayy Tap̱a, miiyi mii ap̱o/ aman mo","poem":1},{"lineBreak":true},{"text":"haali/ aman tana ga dhana waḵ jin uri ’kup̱ mo ba/.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ki rash rash mo tani aḵashiram bam ’tu’dkunu mo","poem":1},{"lineBreak":true},{"text":"ki mo jin ṯẖunyu aman ’twa/ i is mo ki uni gwansan kun ’ko ki ’ko ’penkap̱an mo,","poem":1},{"lineBreak":true},{"text":"ka waḵ buni uni gun dhu is buni ki ca mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}