{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"Ki Tap̱a warki’da shamaneṯṯan ma Sihyuun is mo tani","poem":1},{"lineBreak":true},{"text":"ana wana e ki uni gwansan kun shu’bki jan mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yan’ko’d ’twam bana ’tu’dkunu ki piny piny ki momp̱e’th mo,","poem":1},{"lineBreak":true},{"text":"dhali ale’d bana a’di ḵumki cuuwa/ gom moŋ’kuny bwa mo.","poem":1},{"lineBreak":true},{"text":"Dhali yan’ko’d uni oki gwo e bwaman kal gi ’kwanin tiya mo ki:","poem":1},{"lineBreak":true},{"text":"Tap̱a miiki dhan to jin caaca gom uni mo be.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tap̱a miiki dhan to jin caaca gom ana mo be.","poem":1},{"lineBreak":true},{"text":"Ana ’borkina bwa mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wara shamaneṯṯan bam is mo ma, ayy Tap̱a,","poem":1},{"lineBreak":true},{"text":"mmowa e ki boṯan yi’de/ e mo ma Januub mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dhalki uni gwansan kun si to ki kony jabu’th mo tani","poem":1},{"lineBreak":true},{"text":"dhalki uni ’ciṯẖ to ki cuuwa/ jin ḵumu/ ki bwaŋ ’kunyka/ mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A’diyin jin yaki gwolu/","poem":1},{"lineBreak":true},{"text":"mmoḵal emen to mmosi mo tani","poem":1},{"lineBreak":true},{"text":"midi kulu/ bway pa ki cuuwa/ jin ’thera a’di ki bwaŋ ’kunyka/ mo,","poem":1},{"lineBreak":true},{"text":"mmoḵali cwalman maman to jin sina a’di mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}