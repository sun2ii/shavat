{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"Mom’bor mii goma ris uni ’baar ka ’deṯe/ ’deṯe/ kun ḵo/ki Tap̱a mo,","poem":1},{"lineBreak":true},{"text":"a’di jin yaki’d e bway piti mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"/E mini shwa maman cwa ma ṯu’c ki me’d pini mo,","poem":1},{"lineBreak":true},{"text":"dhali /e mina bwa ’bor mo, dhali a’di midi ha me’d gom /e mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ashim pini a’di mina e waki cwa jin dho’th maman mo","poem":1},{"lineBreak":true},{"text":"e bwaŋ gu’b pini mo.","poem":1},{"lineBreak":true},{"text":"Uc̱im pini uni mina e waki cwa seṯuun kun ’kan ki biṯẖi/ biṯẖi/","poem":1},{"lineBreak":true},{"text":"mmo’kama tharabeesam pini is mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hili mo mo ma, wakan wathi/ minu ’bor mii mo,","poem":1},{"lineBreak":true},{"text":"a’di jin ḵo/ki Tap̱a mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tap̱a ’borki /e mii mo ’pena Sihyuun mo.","poem":1},{"lineBreak":true},{"text":"Dhalki /e p̱ari mo jin midi rusa/ rus e gom Pa Urushaliim mo","poem":1},{"lineBreak":true},{"text":"ka risa tee gi mondiki/em pini ’baar mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dhalki /e hili uc̱i gi uc̱im pini mo.","poem":1},{"lineBreak":true},{"text":"Moŋḵu’th is midi di ap̱owa Israyiil mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}