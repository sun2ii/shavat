{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"Ka daran duŋ gana/ mo tani uni wo’cki aha/ is she/ mo ’peni dhuru’c pem jin taka/ mo,","poem":1},{"lineBreak":true},{"text":"dhalka Israyiil o gwo wakan shwane/ mo –","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ka daran duŋ gana/ mo tani uni wo’cki aha/ is she/ mo ’peni dhuru’c pem jin taka/ mo,","poem":1},{"lineBreak":true},{"text":"hili uni ’koki p̱i gwo jip̱i/ ap̱o/ aha/ mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Imangora ’cesh uni gorkina ’cesha p̱owa p̱om pem mo.","poem":1},{"lineBreak":true},{"text":"Dhali uni dherki gwan’thim buni ki tur tur mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tap̱a a’di ta’da ḵar/e mo.","poem":1},{"lineBreak":true},{"text":"A’di ’ciṯẖki’da shi/ gi ’kwani kun ta thus ki thus bwa mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dhalki uni gwansan kun shi/kina Sihyuuni e mo tani","poem":1},{"lineBreak":true},{"text":"dhunu ki mo ma ’the is mo dhali dhuwa bor ki tar mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dhalki uni wana e ka shoŋ ’kuŋgu’b mo","poem":1},{"lineBreak":true},{"text":"kun ḵu’thkin mo iṯwa/a/ ki uni ’koki ca mo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"a’di jin din ma man’ciṯẖ to ki ’tu’d me’d piti mo,","poem":1},{"lineBreak":true},{"text":"walla aman’de’k cwalman maman to ki ḵala bor piti mo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ki ’kwani gwansan kun iin mo mmope a’di mo tani ’koki o gwo mo ki:","poem":1},{"lineBreak":true},{"text":"Mom’bor mii gi Tap̱a midi di ap̱o/ /e mo.","poem":1},{"lineBreak":true},{"text":"Aman ’bora /e mii ki gway gi Tap̱a mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}