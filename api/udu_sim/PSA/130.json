{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Gway jin yuḵu mmo/ii ka gagamis mo."]},{"type":"verse","number":1,"content":[{"text":"’Peni mo jin ’kula’kul mo tani aha/ gwokina ’twa/ e /e mo, ayy Tap̱a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tap̱a, ciḵi ’twa/ pem mo ma.","poem":1},{"lineBreak":true},{"text":"Dhalki ’cem pini c̱i’da hirdhe/ mo","poem":1},{"lineBreak":true},{"text":"ki ’twa/ pem jin ’thoka/ to ka di’b me’di is mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ayy Tap̱a, waḵki/ /e mini ’taki nyiṯẖa ris mony’coḵka/ mo tani","poem":1},{"lineBreak":true},{"text":"Tap̱a, kaja a’di imidi dosh mo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hili mo jin gwamkina /eya gwam mo tani di’d e /e mo,","poem":1},{"lineBreak":true},{"text":"ki /e a’di minu ’taki ḵo/ moyi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aha/ c̱orkina Tap̱a mo, aḵashiram pem c̱orki’da c̱or mo","poem":1},{"lineBreak":true},{"text":"dhali e gwom pini mo tani aha/ tana ga ’teŋ kap̱e/ mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aḵashiram pem c̱orki Tap̱a mo","poem":1},{"lineBreak":true},{"text":"mmobola ris ’kwani kun thimki mon’thamo/ e mo,","poem":1},{"lineBreak":true},{"text":"mmobola ris ’kwani kun thimki mon’thamo/ e mo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ayy Israyiil, tayi gi mo ma ’teŋ kap̱e/ e Tap̱a mo.","poem":1},{"lineBreak":true},{"text":"Haali/ gom Tap̱a mo tani mo/en jin ṯelu sho’k diki’d mo","poem":1},{"lineBreak":true},{"text":"dhali e a’di mo tani mo ma enthus jin wanuwa wan ’ba/ ishki’d mo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dhali a’di midi wana Israyiil ’ba/ mo","poem":1},{"lineBreak":true},{"text":"’pena ris miim piti kun ’coḵa’coḵ mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}