{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Gway ma Dawuu’d"]},{"type":"verse","number":1,"content":[{"text":"Ayy Tap̱a, aja a’di imidi c̱a’b ki c̱a’b yilkina/ e gu’b burrinyem pini mo?","poem":1},{"lineBreak":true},{"text":"Dhali aja a’di imidi c̱a’b e ’kuwosh pini jin ḵogu mo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A’di jin ya’d ki dar gi mii ’ba/ mo, dhali mii miim ’boro’d mo,","poem":1},{"lineBreak":true},{"text":"dhali ṯor gwoŋ gana/ ’pena dum piti mo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"a’di jin diki thutha thu’th ’pen ka le’d piti mo,","poem":1},{"lineBreak":true},{"text":"dhali diki mii tonthus ka kam piti mo,","poem":1},{"lineBreak":true},{"text":"walla ḵal mo jin waḵuwa waḵ ap̱owa mannyaḵ c̱a’b piti jin ’dish a’di is mo,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"dhali e jis/em piti mo tani aman/ush gwo gam is mo tani waḵkina a’di mo,","poem":1},{"lineBreak":true},{"text":"hili a’di taḵ uni gwansan kun ḵo/ki Tap̱a mo,","poem":1},{"lineBreak":true},{"text":"dhali a’di jin thulki gwom piti me’da p̱o/ mo ki to jin shi/ki a’di mo tani dhali diki aḵ gwom piti e mo be,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"a’di jin diki kara guurush piti e mo jin nyunyu/ to mo,","poem":1},{"lineBreak":true},{"text":"dhali a’di diki bu’th mo jin wanu is ap̱o/ a’di jin di’d ka po/ mo be.","poem":1},{"lineBreak":true},{"text":"A’di jin mii to gwansan mo tani minu mol joc̱ ki sule/ mo be.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}