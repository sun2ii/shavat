{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"Maŋi Tap̱a mo.","poem":1},{"lineBreak":true},{"text":"Maŋi Arumgimis e mom piti jin ḵogu mo.","poem":1},{"lineBreak":true},{"text":"Maŋi a’di e mo ma balany piti mo jin c̱a’bki dem dem mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maŋi a’di gom miin to ma dem dem piti mo.","poem":1},{"lineBreak":true},{"text":"Maŋi a’di isi ki dhan miiny cam piti jin cana a’di mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maŋi a’di ki ko ma poome/ jin dhalu me’d mo.","poem":1},{"lineBreak":true},{"text":"Maŋi a’di ka dheŋdhenye/ jin ’kon ma shu/i ’kume’d mo jin buḵu ki dar ga yi’c mo dhala dheŋdhenye/ mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maŋi a’di ka dheŋdhenye/ jin p̱inu ki me’d mo dhali iiyi imis mo.","poem":1},{"lineBreak":true},{"text":"Maŋi a’di ka shun dheŋdhenye/ mo dhala bargum mo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maŋi a’di ki ko ma sahana shu e mo.","poem":1},{"lineBreak":true},{"text":"Maŋi a’di ki ’kal ’kal ki ko ma sahana shu e mo jin tirkunu mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dhalka ris to ’baar mo kun shi/irrkin mo maŋi Tap̱a mo.","poem":1},{"lineBreak":true},{"text":"Maŋi Tap̱a mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}