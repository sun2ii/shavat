{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["Gway ma Dawuu’d."]},{"type":"verse","number":1,"content":[{"text":"Tap̱a a’di ta’da Manhil aha/ mo.","poem":1},{"lineBreak":true},{"text":"Aha/ mina diki har to mo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A’di karki aha/ mmo/ish ’ko’da shon dhii/i’d mo.","poem":1},{"lineBreak":true},{"text":"A’di suski aha/ e shemen yi’de/ jin doshki’d mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A’di warki aha/ aḵashiram pem is mo.","poem":1},{"lineBreak":true},{"text":"A’di suski aha/ e bway mii ma ḵar/e mo","poem":1},{"lineBreak":true},{"text":"gom gway gi gway piti mo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ba isi waḵki/ aha/ mina ya e embul wosh ma la gi mowu mo tani","poem":1},{"lineBreak":true},{"text":"aha/ yisa mina ḵo/ tonthus yisa,","poem":1},{"lineBreak":true},{"text":"haali/ /e nyaḵki di ki aha/ mo.","poem":1},{"lineBreak":true},{"text":"Ajap̱p̱am pini dhali cwam pini uni malaski aha/ mo be.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"/E thosonki tonṯe/ ibwambori aha/ mo","poem":1},{"lineBreak":true},{"text":"e buŋ’kus ma ris uni gun ta ’kup̱ ki aha/ mo.","poem":1},{"lineBreak":true},{"text":"/E ’koshki aha/ ’kup̱ pem ka yin mo.","poem":1},{"lineBreak":true},{"text":"Aḵubbaayam pem a’di ’tu’dki’d iwol ’kup̱a sho mo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ka jiŋ gana/ miim ’boron dhali momiimii mo tani uni mini baṯẖ aha/ nsho’k mo","poem":1},{"lineBreak":true},{"text":"ka teem pemi ’baar mo jin dika/ ki e mo,","poem":1},{"lineBreak":true},{"text":"dhali aha/ mina c̱a’b e gu’b gi Tap̱a ki sule/ sule/ ya ye ’ba/ mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}