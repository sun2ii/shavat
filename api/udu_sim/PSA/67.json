{"translation":{"id":"udu_sim","name":"Gwo Ma Arumgimis","website":"https://ebible.org/Scriptures/details.php?id=udu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=udu","licenseNotes":null,"shortName":"SIM","englishName":"Uduk Bible","language":"udu","textDirection":"ltr","sha256":"936aeecd274518a75499424a77dbef6d589d67fadea7e40ef3caba98d0cf1d7b","availableFormats":["json"],"listOfBooksApiLink":"/api/udu_sim/books.json","numberOfBooks":30,"totalNumberOfChapters":480,"totalNumberOfVerses":12496,"languageName":"Uduk","languageEnglishName":"Uduk"},"book":{"id":"PSA","translationId":"udu_sim","name":"GWAY GI IDAWUU’D","commonName":"GWAY GI IDAWUU’D","title":"Gway gi iDawuu’d","order":19,"numberOfChapters":150,"sha256":"f6120b45c387105914075d28f83a465e9715451d7a2a20438fad2889ab964632","firstChapterNumber":1,"firstChapterApiLink":"/api/udu_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/udu_sim/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Eya manyuḵ gway mo ka shu/ kun buḵu mo. Gway jin yuḵu mo jin ta gway mo."]},{"type":"verse","number":1,"content":[{"text":"Dhalka Arumgimis mii mii ma ’the gom am mo dhali ’bor am mii mo","poem":1},{"lineBreak":true},{"text":"dhali kar bwam/em piti mmokush mo ap̱o/ aman mo, Doshi ma dhali ’cunycuri yan mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ki bway pini minu mish mo ap̱o/ mony’cesh mo,","poem":1},{"lineBreak":true},{"text":"dhali mom’bi’th pini jin tana /e ata is ki me’d mo e bwaman kal gi ’kwaniny’cesh mo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dhalki ’kwani maŋ /e mo, ayy Arumgimis.","poem":1},{"lineBreak":true},{"text":"Dhalka ris ’kwani ’baar mo maŋ /e mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dhalki kal gi ’kwaniny’cesh yuḵ gway ki mom’bor bwa mo dhali ki moŋ’kuny bwa mo,","poem":1},{"lineBreak":true},{"text":"haali/ /e dwallki ’kwani gwo ki dar gi mii ma gwar ’de/ mo,","poem":1},{"lineBreak":true},{"text":"dhali shu kal gi ’kwaniny’cesh bway ap̱o/ mony’cesh mo. Doshi ma dhali ’cunycuri yan mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dhalki ’kwani maŋ /e mo, ayy Arumgimis.","poem":1},{"lineBreak":true},{"text":"Dhalka ris ’kwani ’baar mo maŋ /e mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mony’cesh gwono’dki maman piti jin markina a’di is mo.","poem":1},{"lineBreak":true},{"text":"Arumgimis jin ta’da Arumgimis bam mo, a’di ’borki am mii mo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Arumgimis ’borki am mii mo.","poem":1},{"lineBreak":true},{"text":"Dhalka ris ’kwani kun ’kon e ’pemen gi mony’cesh mo ḵo/ a’di mo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/udu_sim/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/udu_sim/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/udu_sim/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}