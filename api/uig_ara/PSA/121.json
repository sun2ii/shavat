"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_ara/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}