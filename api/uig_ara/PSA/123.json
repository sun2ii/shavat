{"translation":{"id":"uig_ara","name":"مۇقېددېس كالام (يەنگى يېزىق)","website":"https://ebible.org/Scriptures/details.php?id=uigara","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigara","licenseNotes":null,"shortName":"ARA","englishName":"Uyghur Bible (arabic script)","language":"uig","textDirection":"rtl","sha256":"4d4a0bb499e2377e9329456410c1f975cff0b95b472c87473a1d880b84a6c819","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_ara/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_ara","name":"زەبۇر","commonName":"زەبۇر","title":"زەبۇر","order":19,"numberOfChapters":150,"sha256":"79cab28dcbd061dac122cea71385425e0886135a10ab9856254a54454f4a3678","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_ara/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_ara/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":123,"content":[{"type":"heading","content":["123-كۈي •••• زور خارلىق ئاستىدا"]},{"type":"verse","number":1,"content":["«يۇقىرىغا چىقىش ناخشىسى»",{"lineBreak":true},"ئى ئەرشلەردە تۇرغۇچىسەن، ساڭا بېشىمنى كۆتۈرۈپ قارايمەن؛",{"noteId":379}]},{"type":"verse","number":2,"content":["مانا، قۇللىرىڭنىڭ كۆزى ئۆز خوجايىنىنىڭ قوللىرىغا قانداق قارىغان بولسا، دېدەكلەرنىڭ كۆزى ئۆز ساھىبەسىنىڭ قوللىرىغا قانداق قارىغان بولسا، بىزنىڭ كۆزىمىز پەرۋەردىگار خۇدايىمىزغا شۇنداق قارايدۇ. تا بىزگە شەپقەت كۆرسەتكۈچە قارايدۇ."]},{"type":"verse","number":3,"content":["بىزگە شەپقەت كۆرگۈزگەيسەن، ئى پەرۋەردىگار، بىزگە شەپقەت كۆرگۈزگەيسەن؛ چۈنكى بىز يەتكۈچە خورلۇق تارتقانمىز."]},{"type":"verse","number":4,"content":["جېنىمىز غوجاملارنىڭ مازاقلىرىنى، ھاكاۋۇرلارنىڭ خورلۇقلىرىنى يەتكۈچە تارتقاندۇر."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":379,"caller":"□","text":"«ساڭا بېشىمنى كۆتۈرۈپ قارايمەن» ــ ئىبرانىي تىلىدا: «ساڭا كۆزلىرىمنى كۆتۈرۈپ قارايمەن».","reference":{"chapter":123,"verse":1}}]},"thisChapterLink":"/api/uig_ara/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}