["ئېرىشكەن ياردىمىمىز پەرۋەردىگارنىڭ نامىدىدۇر، ئاسمان-زېمىن ياراتقۇچىنىڭ نامىدىدۇر!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_ara/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}