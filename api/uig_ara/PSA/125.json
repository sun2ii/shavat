{"translation":{"id":"uig_ara","name":"مۇقېددېس كالام (يەنگى يېزىق)","website":"https://ebible.org/Scriptures/details.php?id=uigara","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigara","licenseNotes":null,"shortName":"ARA","englishName":"Uyghur Bible (arabic script)","language":"uig","textDirection":"rtl","sha256":"4d4a0bb499e2377e9329456410c1f975cff0b95b472c87473a1d880b84a6c819","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_ara/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_ara","name":"زەبۇر","commonName":"زەبۇر","title":"زەبۇر","order":19,"numberOfChapters":150,"sha256":"79cab28dcbd061dac122cea71385425e0886135a10ab9856254a54454f4a3678","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_ara/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_ara/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":125,"content":[{"type":"heading","content":["125-كۈي •••• خۇدانىڭ زور ھىمايىسى"]},{"type":"verse","number":1,"content":["«يۇقىرىغا چىقىش ناخشىسى»",{"lineBreak":true},"پەرۋەردىگارغا تايانغانلار زىئون تېغىدەكتۇر؛ ئۇنى تەۋرەتكىلى بولمايدۇ، ئۇ مەڭگۈلۈك تۇرىدۇ."]},{"type":"verse","number":2,"content":["يېرۇسالېم! تاغلار ئۇنىڭ ئەتراپىنى ئورۇغان، ھەم پەرۋەردىگار ھازىردىن تا ئەبەدگىچە ئۆز خەلقىنىڭ ئەتراپىنى ئورايدۇ."]},{"type":"verse","number":3,"content":["چۈنكى رەزىللەرنىڭ ھوقۇق ھاسىسى ھەققانىيلارنىڭ نېسىۋىسىنى باشقۇرمايدۇ؛ بولمىسا ھەققانىيلارمۇ قوللىرىنى قەبىھلىككە ئۇزارتىشى مۇمكىن."]},{"type":"verse","number":4,"content":["پەرۋەردىگار، مېھرىبانلارغا مېھرىبانلىق قىلغايسەن؛ كۆڭلى دۇرۇسلارغىمۇ شۇنداق بولسۇن."]},{"type":"verse","number":5,"content":["بىراق ئەگرى يوللارغا بۇرۇلۇپ كەتكەنلەرنى بولسا، پەرۋەردىگار ئۇلارنى قەبىھلىك قىلغۇچىلار بىلەن تەڭ شاللايدۇ. ئىسرائىلغا ئامان-خاتىرجەملىك بولغاي!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_ara/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}