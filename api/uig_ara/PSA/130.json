{"translation":{"id":"uig_ara","name":"مۇقېددېس كالام (يەنگى يېزىق)","website":"https://ebible.org/Scriptures/details.php?id=uigara","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigara","licenseNotes":null,"shortName":"ARA","englishName":"Uyghur Bible (arabic script)","language":"uig","textDirection":"rtl","sha256":"4d4a0bb499e2377e9329456410c1f975cff0b95b472c87473a1d880b84a6c819","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_ara/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_ara","name":"زەبۇر","commonName":"زەبۇر","title":"زەبۇر","order":19,"numberOfChapters":150,"sha256":"79cab28dcbd061dac122cea71385425e0886135a10ab9856254a54454f4a3678","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_ara/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_ara/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":130,"content":[{"type":"heading","content":["130-كۈي •••• ئازابلىق پەرياد"]},{"type":"verse","number":1,"content":["«يۇقىرىغا چىقىش ناخشىسى»",{"lineBreak":true},"چوڭقۇر يەرلەردىن ساڭا پەرياد كۆتۈرىمەن، ئى پەرۋەردىگار؛"]},{"type":"verse","number":2,"content":["ئى رەب، ئاۋازىمنى ئاڭلىغايسەن؛ قۇلاقلىرىڭنى يېلىنىش سادايىمغا سالغايسەن؛"]},{"type":"verse","number":3,"content":["ئەگەر سەن ياھ، قەبىھلىكلەرنى سۈرۈشتۈرۈپ سانىساڭ، ئەمدى رەب، كىم تىك تۇرالايدۇ؟"]},{"type":"verse","number":4,"content":["بىراق سەندە مەغپىرەت-كەچۈرۈم باردۇر؛ شۇڭا سەندىن ئەيمىنىشكە بولىدۇ."]},{"type":"verse","number":5,"content":["پەرۋەردىگارنى كۈتۈۋاتىمەن؛ جېنىم كۈتۈۋاتىدۇ؛ ئۇنىڭ سۆزىگە ئۈمىد باغلىدىم."]},{"type":"verse","number":6,"content":["تۈن جېسەكچىلىرىنىڭ سەھەرگە بولغان تەشناسىدىن ئارتۇق، بەرھەق، تۈن جېسەكچىلىرىنىڭ سەھەرگە بولغان تەشناسىدىن ئارتۇق، جېنىم رەبكە تەشنا بولۇپ كۈتمەكتە."]},{"type":"verse","number":7,"content":["ئى ئىسرائىل، پەرۋەردىگارغا ئۈمىد باغلاڭلار؛ چۈنكى پەرۋەردىگاردا ئۆزگەرمەس مۇھەببەت باردۇر؛ ئۇنىڭدا زور نىجاتلىقلارمۇ بار؛"]},{"type":"verse","number":8,"content":["ئۇ ئىسرائىلنى بارلىق قەبىھلىكلىرىدىن بەدەل تۆلەپ قۇتقۇزىدۇ."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_ara/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}