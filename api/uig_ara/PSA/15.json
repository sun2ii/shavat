{"translation":{"id":"uig_ara","name":"مۇقېددېس كالام (يەنگى يېزىق)","website":"https://ebible.org/Scriptures/details.php?id=uigara","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigara","licenseNotes":null,"shortName":"ARA","englishName":"Uyghur Bible (arabic script)","language":"uig","textDirection":"rtl","sha256":"4d4a0bb499e2377e9329456410c1f975cff0b95b472c87473a1d880b84a6c819","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_ara/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_ara","name":"زەبۇر","commonName":"زەبۇر","title":"زەبۇر","order":19,"numberOfChapters":150,"sha256":"79cab28dcbd061dac122cea71385425e0886135a10ab9856254a54454f4a3678","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_ara/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_ara/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":15,"content":[{"type":"heading","content":["15-كۈي •••• كىم خۇدا ئالدىدا تۇرالايدۇ؟"]},{"type":"verse","number":1,"content":["داۋۇت يازغان كۈي: ــ",{"lineBreak":true},"پەرۋەردىگار، كىم چېدىرىڭدا تۇرالايدۇ؟ كىم پاك-مۇقەددەس تېغىڭدا ماكانلىشىدۇ؟"]},{"type":"verse","number":2,"content":["كىمكى تامامەن دۇرۇسلۇقتا ماڭسا، ھەققانىيلىقنى يۈرگۈزسە، كۆڭلىدە ھەقىقەتنى سۆزلىسە؛"]},{"type":"verse","number":3,"content":["تىلى بىلەن گەپ توشۇمىسا، ئۆز يېقىنىغا يامانلىق قىلمىسا، قوشنىسىنىڭ ئەيىبىنى كولاپ ئاچمىسا،"]},{"type":"verse","number":4,"content":["پەس ئادەمنى كۆزگە ئىلمىسا، پەرۋەردىگاردىن ئەيمىنىدىغانلارنى ھۆرمەتلىسە، ئۆزىگە زىيانلىق بولغان تەقدىردىمۇ ئىچكەن قەسىمىنى ئۆزگەرتمىسە،"]},{"type":"verse","number":5,"content":["پۇلنى خەقلەرگە ئۆسۈمگە بەرمىسە، بىگۇناھلارنىڭ زىيىنىغا پارا ئالمىسا؛ كىمكى مۇشۇلارنى قىلسا، مەڭگۈگە تەۋرەنمەس."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_ara/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api