{"translation":{"id":"uig_ara","name":"مۇقېددېس كالام (يەنگى يېزىق)","website":"https://ebible.org/Scriptures/details.php?id=uigara","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigara","licenseNotes":null,"shortName":"ARA","englishName":"Uyghur Bible (arabic script)","language":"uig","textDirection":"rtl","sha256":"4d4a0bb499e2377e9329456410c1f975cff0b95b472c87473a1d880b84a6c819","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_ara/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_ara","name":"زەبۇر","commonName":"زەبۇر","title":"زەبۇر","order":19,"numberOfChapters":150,"sha256":"79cab28dcbd061dac122cea71385425e0886135a10ab9856254a54454f4a3678","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_ara/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_ara/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":70,"content":[{"type":"heading","content":["70-كۈي •••• «پەرۋەردىگار، تېز كەلگەيسەن!»"]},{"type":"verse","number":1,"content":["نەغمىچىلەرنىڭ بېشىغا تاپشۇرۇلۇپ، «ئەسلىتىش ئۈچۈن» ئوقۇلسۇن دەپ، داۋۇت يازغان كۈي: ــ",{"lineBreak":true},"پەرۋەردىگار، مېنى قۇتقۇزۇشقا ئالدىرىغايسەن! پەرۋەردىگار، تېز كېلىپ ماڭا ياردەم قىلغايسەن!"]},{"type":"verse","number":2,"content":["مېنىڭ جېنىمنى ئىزدەۋاتقانلار يەرگە قارىتىلىپ رەسۋا قىلىنسۇن؛ مېنىڭ زىيىنىمدىن خۇرسەن بولغانلار كەينىگە ياندۇرۇلۇپ شەرمەندە بولغاي."]},{"type":"verse","number":3,"content":["مېنى: ــ «ۋاھ! ۋاھ!» دەپ مەسخىرە قىلغانلار ئۆز شەرمەندىلىكىدىن كەينىگە يانغاي!"]},{"type":"verse","number":4,"content":["بىراق سېنى ئىزدىگۈچىلەرنىڭ ھەممىسى سەندە شادلىنىپ خۇشال بولغاي! نىجاتلىقىڭنى سۆيگەنلەر ھەمىشە: «خۇدا ئۇلۇغلانسۇن» دېيىشكەي."]},{"type":"verse","number":5,"content":["بىراق مەن ئېزىلگەنمەن، ھەم يوقسۇلمەن؛ يېنىمغا تېزدىن كەل، ئى خۇدا! سەن مېنىڭ ياردەمچىم، مېنىڭ ئازاد قىلغۇچىم؛ ئى پەرۋەردىگار، كېچىكمەي كەلگەيسەن!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_ara/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}