{"translation":{"id":"uig_ara","name":"مۇقېددېس كالام (يەنگى يېزىق)","website":"https://ebible.org/Scriptures/details.php?id=uigara","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigara","licenseNotes":null,"shortName":"ARA","englishName":"Uyghur Bible (arabic script)","language":"uig","textDirection":"rtl","sha256":"4d4a0bb499e2377e9329456410c1f975cff0b95b472c87473a1d880b84a6c819","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_ara/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_ara","name":"زەبۇر","commonName":"زەبۇر","title":"زەبۇر","order":19,"numberOfChapters":150,"sha256":"79cab28dcbd061dac122cea71385425e0886135a10ab9856254a54454f4a3678","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_ara/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_ara/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":93,"content":[{"type":"heading","content":["93-كۈي •••• پەرۋەردىگار قۇدرەتلىك ھۆكۈمراندۇر"]},{"type":"verse","number":1,"content":["پەرۋەردىگار ھۆكۈم سۈرىدۇ! ئۇ ھەيۋەتنى كىيىم قىلىپ كىيگەن؛ پەرۋەردىگار كىيىنگەن، ئۇ بېلىنى قۇدرەت بىلەن باغلىغان؛ بەرھەق، شۇڭا دۇنيا مەزمۇت قىلىنغان، ئۇ تەۋرەنمەس ئەسلا."]},{"type":"verse","number":2,"content":["سېنىڭ تەختىڭ قەدىمدىلا بەرپا قىلىنغان؛ سەن ئەزەلدىن بار بولغۇچىسەن!"]},{"type":"verse","number":3,"content":["كەلكۈن-تاشقىنلار ئۆز ساداسىنى كۆتۈردى، ئى پەرۋەردىگار، كەلكۈن-تاشقىنلار ئۆز ساداسىنى كۆتۈردى! كەلكۈن-تاشقىنلار ئۇرغۇچى دولقۇنلىرىنى يۇقىرى كۆتۈردى!"]},{"type":"verse","number":4,"content":["كۆپ سۇلارنىڭ شاۋقۇنلىرىدىن، دېڭىز-ئوكياندىكى قۇدرەتلىك دولقۇنلاردىن، ئۈستۈن تۇرغان پەرۋەردىگار قۇدرەتلىكتۇر!",{"noteId":306}]},{"type":"verse","number":5,"content":["سېنىڭ ئاگاھ-گۇۋاھلىقلىرىڭ نېمىدېگەن ئىشەنچلىكتۇر! كۈنلەر يوق بولغۇچە، ئى پەرۋەردىگار، ئۆيۈڭگە پاك-مۇقەددەسلىك ئەبەدىلئەبەد راۋادۇر."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":306,"caller":"□","text":"«دېڭىز-ئوكياندىكى قۇدرەتلىك دولقۇنلار» ــ «دولقۇنلار» ئىبرانىي تىلىدا «چېقىۋەتكۈچىلەر».","reference":{"chapter":93,"verse":4}}]},"thisChapterLink":"/api/uig_ara/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_ara/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_ara/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}