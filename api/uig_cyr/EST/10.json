{"translation":{"id":"uig_cyr","name":"Муқеддес Калам (кирил йезиқ)","website":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseNotes":null,"shortName":"CYR","englishName":"Uyghur Bible (cyrillic script)","language":"uig","textDirection":"ltr","sha256":"41409aebff40aa440c1be48b9a8964a39157398018514d3e903ccd48129dc7c5","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_cyr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"EST","translationId":"uig_cyr","name":"Әстәр","commonName":"Әстәр","title":"Әстәр","order":17,"numberOfChapters":10,"sha256":"794784e202219b03974f009c4001b45299513f0b558a334511771f7ca0cdf025","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_cyr/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/uig_cyr/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["Мордикайниң шөһрити вә утуғи"]},{"type":"verse","number":1,"content":["Падиша Аһашверош қуруқлуқ вә деңиз араллиридики аһалиләрниң һәммисигә алван төлигүзәтти."]},{"type":"verse","number":2,"content":["Униң нопуз-һәйвити вә қудритини аян қилған барлиқ қилған-әткәнлири, шундақла Мордикайниң падишаниң өстүрүши билән еришкән катта шөһрити тоғрисидики тәпсилатлар Медиа вә Парс падишалириниң тарих-тәзкирилиридә пүтүлгән әмәсму?"]},{"type":"verse","number":3,"content":["Чүнки Йәһудий Мордикайниң мәртивиси падиша Аһашвероштин кейинла иккинчи орунда туратти; у дайим өз хәлиқ-миллитиниң бәхитини көзләп, барлиқ нәслидикиләргә аман-есәнлик тиләк сөзлирини қилатти, Йәһудийларниң арисида зор иззәт-һөрмәт тепип, қериндашлириниң қәдирлишигә еришкән еди."]}],"footnotes":[]},"thisChapterLink":"/api/uig_cyr/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_cyr/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_cyr/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}