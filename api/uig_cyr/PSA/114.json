{"translation":{"id":"uig_cyr","name":"Муқеддес Калам (кирил йезиқ)","website":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseNotes":null,"shortName":"CYR","englishName":"Uyghur Bible (cyrillic script)","language":"uig","textDirection":"ltr","sha256":"41409aebff40aa440c1be48b9a8964a39157398018514d3e903ccd48129dc7c5","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_cyr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_cyr","name":"Зәбур","commonName":"Зәбур","title":"Зәбур","order":19,"numberOfChapters":150,"sha256":"fd5963e2969dfc462cef9914e3a852469517c11c748efee4094629120b8db071","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_cyr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_cyr/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":114,"content":[{"type":"heading","content":["114-күй •••• Худаниң илтипатиға гувалиқ бериш"]},{"type":"verse","number":1,"content":["Мән Пәрвәрдигарни сөйимән, Чүнки У мениң авазимни, йелинишлиримни аңлиған."]},{"type":"verse","number":2,"content":["Чүнки У қулиқини маңа салди, Шуңа мән барлиқ күнлиримдә Униңға илтиҗа қилип чақиримән."]},{"type":"verse","number":3,"content":["Өлүм асарәтлири мени чирмивалди; Тәһтисараниң дәрдлири мени тутувалди; Мән пешкәлликкә йолуқтум, әләм тарттим;"]},{"type":"verse","number":4,"content":["Шуниң билән мән Пәрвәрдигарниң намиға тохтимай нида қилдим: — «Сәндин өтүнимән, и Пәрвәрдигар, Җенимни қутулдурғайсән!"]},{"type":"verse","number":5,"content":["Шәпқәтликтур Пәрвәрдигар, һәққанийдур; Худайимиз рәһимдилдур."]},{"type":"verse","number":6,"content":["Пәрвәрдигар наданни сақлайду; Мән харап әһвалға чүшүрүлдум, У мени қутқузди."]},{"type":"verse","number":7,"content":["Һәй җеним, қайтидин хатирҗәм бол; Чүнки Пәрвәрдигар сехийлик, меһриванлиқ көрсәтти;"]},{"type":"verse","number":8,"content":["Чүнки Сән җенимни өлүмдин, көзлиримни яшлардин, Аяқлиримни путлишиштин қутқузғансән."]},{"type":"verse","number":9,"content":["Мән Пәрвәрдигар алдида тирикләрниң зиминида маңимән: –"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_cyr/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_cyr/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_cyr/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":9}