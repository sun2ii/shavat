{"translation":{"id":"uig_cyr","name":"Муқеддес Калам (кирил йезиқ)","website":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseNotes":null,"shortName":"CYR","englishName":"Uyghur Bible (cyrillic script)","language":"uig","textDirection":"ltr","sha256":"41409aebff40aa440c1be48b9a8964a39157398018514d3e903ccd48129dc7c5","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_cyr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_cyr","name":"Зәбур","commonName":"Зәбур","title":"Зәбур","order":19,"numberOfChapters":150,"sha256":"fd5963e2969dfc462cef9914e3a852469517c11c748efee4094629120b8db071","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_cyr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_cyr/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":129,"content":[{"type":"heading","content":["129-күй •••• Азаплиқ пәряд"]},{"type":"verse","number":1,"content":["«Жуқириға чиқиш нахшиси»",{"lineBreak":true},"Чоңқур йәрләрдин Саңа пәряд көтиримән, и Пәрвәрдигар;"]},{"type":"verse","number":2,"content":["И Рәб, авазимни аңлиғайсән; Қулақлириңни йелиниш садайимға салғайсән;"]},{"type":"verse","number":3,"content":["Әгәр Сән Яһ, қәбиһликләрни сүрүштүрүп санисаң, Әнди Рәб, ким тик туралайду?"]},{"type":"verse","number":4,"content":["Бирақ Сәндә мәғпирәт-кәчүрүм бардур; Шуңа Сәндин әйминишкә болиду."]},{"type":"verse","number":5,"content":["Пәрвәрдигарни күтүватимән; Җеним күтүватиду; Униң сөзигә үмүт бағлидим."]},{"type":"verse","number":6,"content":["Түн җесәкчилириниң сәһәргә болған тәшнасидин артуқ, Бәрһәқ, түн җесәкчилириниң сәһәргә болған тәшнасидин артуқ, Җеним Рәбкә тәшна болуп күтмәктә."]},{"type":"verse","number":7,"content":["И Исраил, Пәрвәрдигарға үмүт бағлаңлар; Чүнки Пәрвәрдигарда өзгәрмәс муһәббәт бардур; Униңда зор ниҗатлиқларму бар;"]},{"type":"verse","number":8,"content":["У Исраилни барлиқ қәбиһликлиридин бәдәл төләп қутқузиду."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_cyr/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_cyr/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_cyr/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}