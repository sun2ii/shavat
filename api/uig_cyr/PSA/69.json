{"translation":{"id":"uig_cyr","name":"Муқеддес Калам (кирил йезиқ)","website":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseNotes":null,"shortName":"CYR","englishName":"Uyghur Bible (cyrillic script)","language":"uig","textDirection":"ltr","sha256":"41409aebff40aa440c1be48b9a8964a39157398018514d3e903ccd48129dc7c5","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_cyr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_cyr","name":"Зәбур","commonName":"Зәбур","title":"Зәбур","order":19,"numberOfChapters":150,"sha256":"fd5963e2969dfc462cef9914e3a852469517c11c748efee4094629120b8db071","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_cyr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_cyr/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":69,"content":[{"type":"heading","content":["69-күй •••• «Пәрвәрдигар, тез кәлгәйсән!»"]},{"type":"verse","number":1,"content":["Нәғмичиләрниң бешиға тапшурулуп, «әслитиш үчүн» оқулсун дәп, Давут язған күй: —",{"lineBreak":true},"Пәрвәрдигар, мени қутқузушқа алдириғайсән! Пәрвәрдигар, тез келип маңа ярдәм қилғайсән!"]},{"type":"verse","number":3,"content":["Мениң җенимни издәватқанлар йәргә қаритилип рәсва қилинсун; Мениң зийинимдин хурсән болғанлар кәйнигә яндурулуп шәрмәндә болғай."]},{"type":"verse","number":4,"content":["Мени: — «Ваһ! Ваһ!» дәп мәсқирә қилғанлар өз шәрмәндилигидин кәйнигә янғай!"]},{"type":"verse","number":5,"content":["Бирақ Сени издигүчиләрниң һәммиси Сәндә шатлинип хошал болғай! Ниҗатлиғиңни сөйгәнләр һемишә: «Худа улуқлансун» дейишкәй."]},{"type":"verse","number":6,"content":["Бирақ мән езилгәнмән, һәм йоқсулмән; Йенимға тездин кәл, и Худа! Сән мениң ярдәмчим, мениң азат қилғучим; И Пәрвәрдигар, кечикмәй кәлгәйсән!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_cyr/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_cyr/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_cyr/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":5}