":306,"caller":"□","text":"«Деңиз-океандики қудрәтлик долқунлар» — «долқунлар» ибраний тилида «чеқивәткүчиләр».","reference":{"chapter":92,"verse":4}}]},"thisChapterLink":"/api/uig_cyr/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_cyr/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_cyr/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}