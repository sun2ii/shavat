{"translation":{"id":"uig_cyr","name":"Муқеддес Калам (кирил йезиқ)","website":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigcyr","licenseNotes":null,"shortName":"CYR","englishName":"Uyghur Bible (cyrillic script)","language":"uig","textDirection":"ltr","sha256":"41409aebff40aa440c1be48b9a8964a39157398018514d3e903ccd48129dc7c5","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_cyr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_cyr","name":"Зәбур","commonName":"Зәбур","title":"Зәбур","order":19,"numberOfChapters":150,"sha256":"fd5963e2969dfc462cef9914e3a852469517c11c748efee4094629120b8db071","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_cyr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_cyr/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":99,"content":[{"type":"heading","content":["99-күй •••• Пүткүл йәр йүзи Пәрвәрдигарға мәдһийә яңритиңлар!"]},{"type":"verse","number":1,"content":["Тәшәккүр ейтиш үчүн йезилған күй: —",{"lineBreak":true},"И пүткүл йәр-җаһан, Пәрвәрдигарға авазиңларни көтириңлар!"]},{"type":"verse","number":2,"content":["Хошаллиқ билән Пәрвәрдигарниң хизмитидә болуңлар, Һозуриға тәнтәнә-нахшилар билән йеқинлишиңлар!"]},{"type":"verse","number":3,"content":["Билип қоюңларки, Пәрвәрдигар һәқ Худадур; Бизни яратқан Униң Өзидур, биз әмәс! Биз униң хәлқидурмиз, Өз яйлиғида баққан қойлиридурмиз.",{"noteId":317}]},{"type":"verse","number":4,"content":["Дәрвазилириға тәшәккүр ейтишлар билән, Һойлилириға мәдһийәләр билән кириңлар; Уни мәдһийиләп, намиға тәшәккүр-мәдһийә қайтуруңлар!"]},{"type":"verse","number":5,"content":["Чүнки Пәрвәрдигар меһривандур; Униң меһир-муһәббити әбәдил-әбәткичә, Униң һәқиқәт-садақити әвлаттин-әвлатқичидур!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":317,"caller":"□","text":"«Бизни яратқан Униң Өзидур, биз әмәс!» — йәнә бир хил тәрҗимиси: «У бизни яратқан, биз Униңкидурмиз».","reference":{"chapter":99,"verse":3}}]},"thisChapterLink":"/api/uig_cyr/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_cyr/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_cyr/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":5}