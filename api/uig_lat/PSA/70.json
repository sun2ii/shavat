{"translation":{"id":"uig_lat","name":"Muqeddes Kalam (latin yéziq)","website":"https://ebible.org/Scriptures/details.php?id=uiglat","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uiglat","licenseNotes":null,"shortName":"LAT","englishName":"Uyghur Bible (modern latin script)","language":"uig","textDirection":"ltr","sha256":"30fd3764e1a45a28ccb13be58f64a9fbe0612119045da564ab3ef7979bc653cb","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_lat/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_lat","name":"Zebur","commonName":"Zebur","title":"Zebur","order":19,"numberOfChapters":150,"sha256":"81672ed6913c1e529f6e835ce148dafee323bfc958d9514ba89247c7117cd3e7","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_lat/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_lat/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":70,"content":[{"type":"heading","content":["70-küy •••• «Perwerdigar, téz kelgeysen!»"]},{"type":"verse","number":1,"content":["Neghmichilerning béshigha tapshurulup, «eslitish üchün» oqulsun dep, Dawut yazghan küy: —",{"lineBreak":true},"Perwerdigar, méni qutquzushqa aldirighaysen! Perwerdigar, téz kélip manga yardem qilghaysen!"]},{"type":"verse","number":2,"content":["Méning jénimni izdewatqanlar yerge qaritilip reswa qilinsun; Méning ziyinimdin xursen bolghanlar keynige yandurulup shermende bolghay."]},{"type":"verse","number":3,"content":["Méni: — «Wah! Wah!» dep mesxire qilghanlar öz shermendilikidin keynige yan’ghay!"]},{"type":"verse","number":4,"content":["Biraq Séni izdigüchilerning hemmisi Sende shadlinip xushal bolghay! Nijatliqingni söygenler hemishe: «Xuda ulughlansun» déyishkey."]},{"type":"verse","number":5,"content":["Biraq men ézilgenmen, hem yoqsulmen; Yénimgha tézdin kel, i Xuda! Sen méning yardemchim, méning azad qilghuchim; I Perwerdigar, kéchikmey kelgeysen!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_lat/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_lat/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_lat/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}