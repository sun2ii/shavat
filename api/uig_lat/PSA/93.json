{"translation":{"id":"uig_lat","name":"Muqeddes Kalam (latin yéziq)","website":"https://ebible.org/Scriptures/details.php?id=uiglat","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uiglat","licenseNotes":null,"shortName":"LAT","englishName":"Uyghur Bible (modern latin script)","language":"uig","textDirection":"ltr","sha256":"30fd3764e1a45a28ccb13be58f64a9fbe0612119045da564ab3ef7979bc653cb","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_lat/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30825,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_lat","name":"Zebur","commonName":"Zebur","title":"Zebur","order":19,"numberOfChapters":150,"sha256":"81672ed6913c1e529f6e835ce148dafee323bfc958d9514ba89247c7117cd3e7","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_lat/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_lat/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":93,"content":[{"type":"heading","content":["93-küy •••• Perwerdigar qudretlik hökümrandur"]},{"type":"verse","number":1,"content":["Perwerdigar höküm süridu! U heywetni kiyim qilip kiygen; Perwerdigar kiyin’gen, U bélini qudret bilen baghlighan; Berheq, shunga dunya mezmut qilin’ghan, U tewrenmes esla."]},{"type":"verse","number":2,"content":["Séning texting qedimdila berpa qilin’ghan; Sen ezeldin bar bolghuchisen!"]},{"type":"verse","number":3,"content":["Kelkün-tashqinlar öz sadasini kötürdi, i Perwerdigar, Kelkün-tashqinlar öz sadasini kötürdi! Kelkün-tashqinlar urghuchi dolqunlirini yuqiri kötürdi!"]},{"type":"verse","number":4,"content":["Köp sularning shawqunliridin, Déngiz-okyandiki qudretlik dolqunlardin, Üstün turghan Perwerdigar qudretliktur!",{"noteId":306}]},{"type":"verse","number":5,"content":["Séning agah-guwahliqliring némidégen ishenchliktur! Künler yoq bolghuche, i Perwerdigar, Öyüngge pak-muqeddeslik ebedil’ebed rawadur."]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":306,"caller":"□","text":"«Déngiz-okyandiki qudretlik dolqunlar» — «dolqunlar» ibraniy tilida «chéqiwetküchiler».","reference":{"chapter":93,"verse":4}}]},"thisChapterLink":"/api/uig_lat/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_lat/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_lat/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}