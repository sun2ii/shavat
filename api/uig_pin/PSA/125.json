{"translation":{"id":"uig_pin","name":"Muⱪeddes Kalam (yǝngi yeziⱪ)","website":"https://ebible.org/Scriptures/details.php?id=uigpin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigpin","licenseNotes":null,"shortName":"PIN","englishName":"Uyghur Bible (former latin script)","language":"uig","textDirection":"ltr","sha256":"41b2d5c154a373d87d507e913bf4a76c9e48d68d888bd15709946317471f3b46","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_pin/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_pin","name":"Zǝbur","commonName":"Zǝbur","title":"Zǝbur","order":19,"numberOfChapters":150,"sha256":"e64810fe3482e238b6ca12044d47a94dcf92487cbbcbadbdfa2fadcf5e5f8b13","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_pin/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_pin/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":125,"content":[{"type":"heading","content":["125-küy •••• Hudaning zor ⱨimayisi"]},{"type":"verse","number":1,"content":["«Yuⱪiriƣa qiⱪix nahxisi»",{"lineBreak":true},"Pǝrwǝrdigarƣa tayanƣanlar Zion teƣidǝktur; Uni tǝwrǝtkili bolmaydu, U mǝnggülük turidu."]},{"type":"verse","number":2,"content":["Yerusalem! Taƣlar uning ǝtrapini oruƣan, Ⱨǝm Pǝrwǝrdigar ⱨazirdin ta ǝbǝdgiqǝ Ɵz hǝlⱪining ǝtrapini oraydu."]},{"type":"verse","number":3,"content":["Qünki rǝzillǝrning ⱨoⱪuⱪ ⱨasisi ⱨǝⱪⱪaniylarning nesiwisini baxⱪurmaydu; Bolmisa ⱨǝⱪⱪaniylarmu ⱪollirini ⱪǝbiⱨlikkǝ uzartixi mumkin."]},{"type":"verse","number":4,"content":["Pǝrwǝrdigar, meⱨribanlarƣa meⱨribanliⱪ ⱪilƣaysǝn; Kɵngli duruslarƣimu xundaⱪ bolsun."]},{"type":"verse","number":5,"content":["Biraⱪ ǝgri yollarƣa burulup kǝtkǝnlǝrni bolsa, Pǝrwǝrdigar ularni ⱪǝbiⱨlik ⱪilƣuqilar bilǝn tǝng xallaydu. Israilƣa aman-hatirjǝmlik bolƣay!"]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/uig_pin/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/uig_pin/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/uig_pin/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}