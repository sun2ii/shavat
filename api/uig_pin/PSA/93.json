{"translation":{"id":"uig_pin","name":"Muⱪeddes Kalam (yǝngi yeziⱪ)","website":"https://ebible.org/Scriptures/details.php?id=uigpin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=uigpin","licenseNotes":null,"shortName":"PIN","englishName":"Uyghur Bible (former latin script)","language":"uig","textDirection":"ltr","sha256":"41b2d5c154a373d87d507e913bf4a76c9e48d68d888bd15709946317471f3b46","availableFormats":["json"],"listOfBooksApiLink":"/api/uig_pin/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30824,"languageName":"ئۇيغۇرچە","languageEnglishName":"Uyghur"},"book":{"id":"PSA","translationId":"uig_pin","name":"Zǝbur","commonName":"Zǝbur","title":"Zǝbur","order":19,"numberOfChapters":150,"sha256":"e64810fe3482e238b6ca12044d47a94dcf92487cbbcbadbdfa2fadcf5e5f8b13","firstChapterNumber":1,"firstChapterApiLink":"/api/uig_pin/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/uig_pin/PSA/150.json","totalNumberOfVerses":2443},"chapter":{"number":93,"content":[{"type":"heading","content":["93-küy •••• Pǝrwǝrdigar ⱪudrǝtlik ⱨɵkümrandur"]},{"type":"verse","number":1,"content":["Pǝrwǝrdigar ⱨɵküm süridu! U ⱨǝywǝtni kiyim ⱪilip kiygǝn; Pǝrwǝrdigar kiyingǝn, U belini ⱪudrǝt bilǝn baƣliƣan; Bǝrⱨǝⱪ, xunga dunya mǝzmut ⱪilinƣan, U tǝwrǝnmǝs ǝsla."]},{"type":"verse","number":2,"content":["Sening tǝhting ⱪǝdimdila bǝrpa ⱪilinƣan; Sǝn ǝzǝldin bar bolƣuqisǝn!"]},{"type":"verse","number":3,"content":["Kǝlkün-taxⱪinlar ɵz sadasini kɵtürdi, i Pǝrwǝrdigar, Kǝlkün-taxⱪinlar ɵz sadasini kɵtürdi! Kǝlkün-taxⱪinlar urƣuqi dolⱪunlirini yuⱪiri kɵtürdi!"]},{"type":"verse","number":4,"content":["Kɵp sularning xawⱪunliridin, Dengiz-okyandiki ⱪudrǝtlik dolⱪunlardin, Üstün turƣan Pǝrwǝrdigar ⱪudrǝtliktur!",{"noteId":306}]},{"type":"verse","number":5,"content":["Sening agaⱨ-guwaⱨliⱪliring nemidegǝn ixǝnqliktur! Künlǝr yoⱪ bolƣuqǝ, i Pǝrwǝrdigar, Ɵyünggǝ pak-muⱪǝddǝslik ǝbǝdil’ǝbǝd rawadur."]},{"type":"line_break"},{"type":"line_break"}],"footno