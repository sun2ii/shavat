]},"thisChapterLink":"/api/ukr_1996/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}