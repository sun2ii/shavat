{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":["Посходня пісня. Як вертав Господь невольників Сиона, були ми, наче в снї нам здавалось."]},{"type":"verse","number":2,"content":["Тодї були уста наші повні втїхи, а з губ наших піснї лунали. Тодї між народами казали: Велике дїло сотворив Господь над ними!"]},{"type":"verse","number":3,"content":["Велике диво явив Господь над нами; ми радїли серцем."]},{"type":"verse","number":4,"content":["Верни, Господи, невільників наших, як потоки на спражену землю!"]},{"type":"verse","number":5,"content":["Хто сїє з сльозами, той збере з піснями."]},{"type":"verse","number":6,"content":["Іде з плачом, несе сїмя сїяти; вертає домів веселий, несучи снопи свої."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}