{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["Аллилуя! Хвали, душе моя, Господа!"]},{"type":"verse","number":2,"content":["Буду хвалити Господа, поки життя мого, буду сьпівати псальми Богові моєму, поки мене стане."]},{"type":"verse","number":3,"content":["Не вповайте на князїв, на сина чоловічого; нема в його спасення!"]},{"type":"verse","number":4,"content":["Вийде дух з його, знов до землї своєї він вертає; того ж дня самого задуми його марою стали."]},{"type":"verse","number":5,"content":["Щасливий той, кому дає поміч Бог Якова, в кого надїя на Господа Бога його!"]},{"type":"verse","number":6,"content":["Що сотворив небо і землю, море і все, що в йому; що стереже вірність по віки;"]},{"type":"verse","number":7,"content":["Творить правосуддє пригнобленим, дає хлїба голодним. Господь вязнїв визволяє."]},{"type":"verse","number":8,"content":["Господь слїпим очі вітворяє, Господь пригноблених підносить, Господь любить праведних;"]},{"type":"verse","number":9,"content":["Господь захожих заступає, він сироту і вдову піддержує; а дорогу беззаконних на бік повертає."]},{"type":"verse","number":10,"content":["Да царствує по віки Господь, Бог твій, Сионе, з роду в рід. Аллилуя!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}