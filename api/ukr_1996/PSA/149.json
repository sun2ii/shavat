{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":["Аллилуя! Засьпівайте Господеві нову пісню, хвалу його в соборі праведних його!"]},{"type":"verse","number":2,"content":["Да звеселиться Ізраїль Сотворительом своїм; сини Сиона да зрадуються Царем своїм!"]},{"type":"verse","number":3,"content":["Да хвалять імя його хором, при тимпанах і гуслях засьпівають йому похвальні піснї!"]},{"type":"verse","number":4,"content":["Бо Господь любується своїм народом; він украшає смиренних спасеннєм."]},{"type":"verse","number":5,"content":["Да торжествують праведні в славі, радуються на ложах своїх!"]},{"type":"verse","number":6,"content":["Славославія Богу в устах їх, і обосторонь гострий меч в руцї їх,"]},{"type":"verse","number":7,"content":["На одмщеннє народам і кару племенам;"]},{"type":"verse","number":8,"content":["Щоб царів їх в кайдани забити, й дуків їх в желїзні пута закувати;"]},{"type":"verse","number":9,"content":["Сповнити над ними суд написаний. Така слава для всїх угодників його. Хвалїте Господа!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}