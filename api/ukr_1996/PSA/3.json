{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Сю псальму зложив Давид, як втїкав перед своїм сином Авесаломом. Господи! скілько напастників моїх, скілько тих, що постають проти мене."]},{"type":"verse","number":2,"content":["Многі кажуть душі моїй: нема йому спасення в Бозї!"]},{"type":"verse","number":3,"content":["Но ти, Господи, оборонний щит передо мною, ти слава моя, ти підносиш голову мою."]},{"type":"verse","number":4,"content":["Голосом моїм кличу до Господа, і він чує мене з гори сьвятої своєї."]},{"type":"verse","number":5,"content":["Я положився і спав; я проснувся, бо Господь заступив мене."]},{"type":"verse","number":6,"content":["Не боюсь і десятків тисячей народу, що кругом проти мене встали."]},{"type":"verse","number":7,"content":["Встань, Господи, спаси мене, мій Боже! бо ти розбивав щелепи ворогів моїх, ти торощив зуби беззаконним."]},{"type":"verse","number":8,"content":["Від Господа спасеннє; твоє благословеннє над народом твоїм."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}