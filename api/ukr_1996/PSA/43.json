{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Суди мене, Боже, і розсуди мою справу проти безсердешного народу! Від чоловіка лукавого і неправдивого визволи мене!"]},{"type":"verse","number":2,"content":["Бо ти єси Бог сили моєї. За що ж ти відкинув мене? Чому ходжу сумуючи задля ворожого гнету?"]},{"type":"verse","number":3,"content":["Пошли сьвітло твоє і правду; вони нехай ведуть мене і заведуть на твою гору сьвятую до чертогів твоїх!"]},{"type":"verse","number":4,"content":["І так прийду я до жертівника Божого, до Бога, що сповняє мене превеликою радостю, і прославлю на гуслях тебе, Боже, мій Боже!"]},{"type":"verse","number":5,"content":["Чого хиляєшся, душе моя, і чого непокоїшся в менї? Вповай на Бога! Буду бо ще прославляти його, котрий є спасеннє лиця мого і Бог мій!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}