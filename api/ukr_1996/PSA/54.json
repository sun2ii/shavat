{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["Проводиреві хора: при струнах; наука Давида, коли прийшли Зифеї і сказали Саулові: Чи Давид не сховався між нами? Боже, імям твоїм спаси мене, і силою твоєю допоможи правдї моїй."]},{"type":"verse","number":2,"content":["Боже, почуй молитву мою, вислухай слова уст моїх!"]},{"type":"verse","number":3,"content":["Бо чужі піднялись на мене, і розбишаки чигають на життє моє; не мають вони в серцї Бога."]},{"type":"verse","number":4,"content":["Ось, Бог мій помічник; Господь між тими, що піддержують життє моє. Він відверне лихо на ворогів моїх; по правдї твоїй знищи їх!"]},{"type":"verse","number":5,"content":["Радо принесу жертву тобі; прославлю імя твоє, Господи; благе бо є."]},{"type":"verse","number":6,"content":["Він бо вибавив мене з усякої біди; і на помсту ворогам моїм дивляться очі мої."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/55.json","