{"translation":{"id":"ukr_1996","name":"Біблія","website":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1996","licenseNotes":null,"shortName":"1996","englishName":"Ukrainian Bible, BJU 1996","language":"ukr","textDirection":"ltr","sha256":"f9818920efab1e78d63fc6a1d8d35ab845f0a477f14a93cc61ea70489e899e58","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_1996/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_1996","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"d3ededf5dba5176de11a05e1efabeeceb134cd8616e4f47e4e61249db26ef290","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_1996/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_1996/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":["Для синів Корея; псальма, до сьпіву. Оселя його на сьвятих горах."]},{"type":"verse","number":2,"content":["Любить Господь брами Сиона більше, як всї домівки Якова."]},{"type":"verse","number":3,"content":["Преславні речі говорено про тебе, місто Боже."]},{"type":"verse","number":4,"content":["Згадаю про Египет і Вавилон перед тими, що знають мене; дивись, Филистея і Тир вкупі з Етіопією скажуть: той родився там."]},{"type":"verse","number":5,"content":["А про Сиона скажуть: Той і той родився там; і Всевишнїй, він утвердить його."]},{"type":"verse","number":6,"content":["Господь напише в переписї народів: Той родився там."]},{"type":"verse","number":7,"content":["Тому сьпівають і веселяться тобою всї жерела життя мого!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_1996/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_1996/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_1996/PSA/86.