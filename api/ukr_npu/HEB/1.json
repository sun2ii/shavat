{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"HEB","translationId":"ukr_npu","name":"Євреїв","commonName":"Євреїв","title":"Послання до Євреїв","order":58,"numberOfChapters":13,"sha256":"fc9fe1810fc67e6e2805de48b06a248dda214ccf4eba8f4f70fb88d62ab5a9a2","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ukr_npu/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Бог говорив через Свого Сина"]},{"type":"verse","number":1,"content":["У минулому Бог багато разів і по-різному говорив до наших батьків через пророків,"]},{"type":"verse","number":2,"content":["а в ці останні дні Він промовив до нас через Свого Сина, Якого призначив Спадкоємцем усього й через Якого створив віки."]},{"type":"verse","number":3,"content":["Син – сяйво Божої слави й повне відображення Його сутності, Що утримує все силою Свого Слова. Очистивши нас від гріхів, Він сів праворуч від Величності на небесах."]},{"type":"verse","number":4,"content":["Він перевершив ангелів, оскільки ім’я, яке Він успадкував, перевершує їхнє ім’я."]},{"type":"heading","content":["Син вищий від ангелів"]},{"type":"verse","number":5,"content":["Бо кому з ангелів Бог коли-небудь сказав:",{"text":"«Ти Мій Син,","poem":1},{"text":"Я сьогодні породив Тебе?»","poem":2},{"noteId":0},"Або:",{"text":"«Я буду Йому Отцем,","poem":1},{"text":"а Він буде Мені Сином?»","poem":2},{"noteId":1}]},{"type":"verse","number":6,"content":["І знову, коли Бог приводить Свого Первістка у всесвіт, Він каже:",{"text":"«Нехай усі Божі ангели вклоняться Йому».","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["А про ангелів говорить:",{"text":"«Він робить ангелів Своїх духами","poem":1},{"noteId":3},{"text":",","poem":1},{"text":"Своїх слуг – полум’ям вогню».","poem":2},{"noteId":4}]},{"type":"verse","number":8,"content":["А про Сина каже:",{"text":"«Престол Твій, Боже, – повік-віків,","poem":1},{"text":"жезл справедливості – жезл Твого Царства.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ти полюбив правду й зненавидів беззаконня;","poem":1},{"text":"тому помазав Тебе Бог, Твій Бог, олією радощів","poem":2},{"noteId":5},{"lineBreak":true},{"text":"більше, ніж Твоїх друзів».","poem":2},{"noteId":6}]},{"type":"verse","number":10,"content":["І ще:",{"text":"«На початку Ти, Господи, заклав основи землі,","poem":1},{"text":"і небеса – діяння рук Твоїх.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Вони згинуть, а Ти існуватимеш завжди;","poem":1},{"text":"усі вони, як одяг, зносяться.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ти поміняєш їх, немов старі шати, і вони зміняться.","poem":1},{"text":"Але Ти – Той самий,","poem":2},{"lineBreak":true},{"text":"і роки Твої нескінченні».","poem":2},{"noteId":7}]},{"type":"verse","number":13,"content":["Кому з ангелів Бог сказав коли-небудь:",{"text":"«Сядь праворуч від Мене,","poem":1},{"text":"доки Я не покладу ворогів Твоїх,","poem":2},{"lineBreak":true},{"text":"як підніжок для Твоїх ніг».","poem":2},{"noteId":8}]},{"type":"verse","number":14,"content":["Чи не всі ангели є духами служіння, посланими служити тим, хто має успадкувати спасіння?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Див. Пс. 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"Див. 2 Сам. 7:14.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Див. Повт. 32:43.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Або: вітрами.","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"Див. Пс. 103:4.","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"Або: тому, Боже, Твій Бог помазав Тебе олією радощів.","reference":{"chapter":1,"verse":9}},{"noteId":6,"caller":"+","text":"Див. Пс. 44:7-8.","reference":{"chapter":1,"verse":9}},{"noteId":7,"caller":"+","text":"Див. Пс. 101:26-28.","reference":{"chapter":1,"verse":12}},{"noteId":8,"caller":"+","text":"Див. Пс. 109:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/ukr_npu/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}