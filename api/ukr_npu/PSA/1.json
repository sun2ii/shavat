{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Блаженна та людина,","poem":1},{"text":"що не ходить на раду нечестивих,","poem":2},{"text":"не стоїть на дорозі грішників","poem":1},{"text":"і не сидить на зборищі глумливих","poem":2},{"noteId":0},{"text":"!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Але в Законі Господнім","poem":1},{"noteId":1},{"text":"її насолода","poem":1},{"text":"і про Закон Його роздумує вдень та вночі.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"І буде вона як дерево, посаджене над водними потоками,","poem":1},{"text":"що плід свій дає вчасно,","poem":2},{"text":"і листя його не зів’яне.","poem":1},{"text":"Що б вона не робила, щаститиме їй.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Не так нечестиві!","poem":1},{"text":"Вони – як полова,","poem":2},{"lineBreak":true},{"text":"що вітер розносить усюди.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Тому не встоять нечестиві на суді","poem":1},{"text":"ані грішники – на зборах праведних.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Адже знає Господьжиттєвий шлях праведних,","poem":1},{"text":"а шлях нечестивих загине.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Або: блюзніри, циніки.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Словом Господь тут і далі передано давньоєврейське ім’я-тетраграму YHWH (יהוה) Сущий; Той, Хто існує.","reference":{"chapter":1,"verse":2}}]},"thisChapterLink":"/api/ukr_npu/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":6}