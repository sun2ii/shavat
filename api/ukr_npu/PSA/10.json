{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true},{"text":"На Господа я надію покладаю.","poem":1},{"text":"Як же ви можете казати мені:","poem":2},{"text":"«Лети-но на гору, мов птах!»","poem":1},{"noteId":21}]},{"type":"verse","number":2,"content":[{"text":"Бо ось нечестиві натягують луки,","poem":2},{"text":"прикладають стріли на тятиву,","poem":1},{"text":"щоб у темряві стріляти в справедливих серцем.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Адже коли руйнуються підвалини,","poem":1},{"text":"що може зробити праведний?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господь у Своєму святому Храмі,","poem":1},{"text":"Господь на Своєму небесному престолі.","poem":2},{"text":"Його очі бачать,","poem":1},{"text":"Його повіки випробовують синів людських.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Господь випробовує праведного,","poem":1},{"text":"а нечестивого й того, хто любить насильство,","poem":2},{"lineBreak":true},{"text":"ненавидить Його душа.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Він проллє дощем на нечестивих","poem":1},{"text":"нещастя, вогонь, сірку,","poem":2},{"lineBreak":true},{"text":"і вітер палючий – їхня частка з чаші гніву.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Бо праведний Господь, любить правду;","poem":1},{"text":"тому тільки справедливі побачать Його обличчя.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Або: Віддалися на ваші гори, птахо!","reference":{"chapter":10,"verse":1}}]},"thisChapterLink":"/api/ukr_npu/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":7}