{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Про милість і справедливість заспіваю;","poem":1},{"text":"Тобі, Господи, я співатиму.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Я уважно стежитиму за дорогою невинною.","poem":1},{"text":"Коли Ти прийдеш до мене?","poem":2},{"lineBreak":true},{"text":"Ходитиму в невинності мого серця","poem":1},{"text":"серед дому свого.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Не покладу перед очима своїми","poem":1},{"text":"нічого підступного.","poem":2},{"lineBreak":true},{"text":"Я ненавиджу вчинки невірних,","poem":1},{"text":"вони не пристануть до мене.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Зіпсоване серце віддалене буде від мене;","poem":1},{"text":"я не знатиму зла.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Того, хто таємно зводить наклепи на ближнього свого,","poem":1},{"text":"я знищу;","poem":2},{"text":"зарозуміло піднятих очей і гордого серця не терпітиму.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Очі мої – на вірних землі,","poem":1},{"text":"щоб мешкали вони зі мною;","poem":2},{"text":"Той, хто ходить невинним шляхом,","poem":1},{"text":"мені служитиме.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Віроломний не житиме в домі моєму,","poem":1},{"text":"і той, хто говорить неправду, не встоїть перед моїми очима.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Щоранку знищуватиму всіх нечестивців землі,","poem":1},{"text":"щоб викорінити із міста Господнього всіх, хто чинить гріх.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":8}