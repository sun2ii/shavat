{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"Молитва страдника, коли він знемагає й виливає перед Господом свій жаль.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Господи, почуй мою молитву,","poem":1},{"text":"і нехай дійде до Тебе мій зойк.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Не ховай від мене Твого обличчя","poem":1},{"text":"у день, коли мені тісно,","poem":2},{"text":"нахили до мене вухо Твоє.","poem":1},{"text":"Того дня, коли я кличу, дай мені відповідь негайно.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Бо дні мої щезли, мов дим,","poem":1},{"text":"і кості мої обгоріли, наче купа золи.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Немов витоптана трава, висохло серце моє,","poem":1},{"text":"так що я забуваю їсти свій хліб.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Від голосу мого зітхання","poem":1},{"text":"прилипли кості мої до тіла.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Я уподібнився до сича в пустелі,","poem":1},{"text":"став немов пугач на руїнах.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Не сплю, став наче птах,","poem":1},{"text":"що самотньо сидить на даху.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Щодня вороги мої ганьблять мене,","poem":1},{"text":"неславлять мене, промовляють ім’я моє, як прокляття.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Я їм попіл замість хліба","poem":1},{"text":"й питво моє зі сльозами змішую","poem":2}]},{"type":"verse","number":11,"content":[{"text":"через гнів Твій і лють,","poem":1},{"text":"бо Ти підняв мене й кинув додолу.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Дні мої – немов нахилена тінь,","poem":1},{"text":"я сохну, наче трава.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"А Ти, Господи, житимеш повіки,","poem":1},{"text":"і пам’ять про Тебе – із роду в рід.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ти встанеш, змилуєшся над Сіоном,","poem":1},{"text":"бо настав час помилувати його,","poem":2},{"lineBreak":true},{"text":"бо прийшла пора.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Адже слуги Твої уподобали навіть каміння його,","poem":1},{"text":"і милим став для них його пил.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Тоді будуть боятися народи імені Господа,","poem":1},{"text":"і всі царі землі – слави Твоєї.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Бо відбудує Господь Сіон,","poem":1},{"text":"з’явиться Він у славі Своїй.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Зглянеться на молитву нужденних","poem":1},{"text":"і не знехтує благаннями їхніми.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Нехай записано це буде для прийдешнього покоління,","poem":1},{"text":"і народ майбутнього","poem":2},{"noteId":173},{"text":"прославлятиме Господа.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Бо Він поглянув із висот святині Своєї,","poem":1},{"text":"Господь із небес подивився на землю,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"щоб почути стогони в’язня","poem":1},{"text":"й звільнити приречених на смерть,","poem":2},{"noteId":174}]},{"type":"verse","number":22,"content":[{"text":"щоб сповістити на Сіоні ім’я Господа","poem":1},{"text":"й хвалу Його – в Єрусалимі,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"коли зберуться народи й царства разом,","poem":1},{"text":"щоб служити Господеві.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Він виснажив силу мою в дорозі,","poem":1},{"text":"скоротив мої дні.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Я сказав: «Боже мій, не забирай мене в середині днів моїх,","poem":1},{"text":"Той, Чиї роки – із роду в рід.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"На початку Ти заклав основи землі,","poem":1},{"text":"і небеса – діяння рук Твоїх.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Вони згинуть, а Ти існуватимеш завжди;","poem":1},{"text":"усі вони, як одяг, зносяться,","poem":2},{"text":"і Ти поміняєш їх, немов старі шати,","poem":1},{"text":"і вони зміняться.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Але Ти – Той самий,","poem":1},{"text":"і роки Твої нескінченні.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Сини рабів Твоїх житимуть,","poem":1},{"text":"і нащадки їхні міцно стоятимуть перед Твоїм обличчям».","poem":2}]}],"footnotes":[{"noteId":173,"caller":"+","text":"Буквально: народ, що буде створений.","reference":{"chapter":101,"verse":19}},{"noteId":174,"caller":"+","text":"Буквально: синів смерті.","reference":{"chapter":101,"verse":21}}]},"thisChapterLink":"/api/ukr_npu/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":29}