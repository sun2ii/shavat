{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":102,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давида.","descriptive":true},{"text":"Благослови, душе моя, Господа,","poem":1},{"text":"і все нутро моє прослав святе ім’я Його!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Благослови, душе моя, Господа,","poem":1},{"text":"і не забувай усіх добрих діянь Його!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Він прощає всі беззаконня твої,","poem":1},{"text":"зцілює всі твої хвороби,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"визволяє від безодні смерті життя твоє;","poem":1},{"text":"Хто вінчає тебе милістю й щедротами,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"задовольняє бажання твої добром –","poem":1},{"text":"тоді оновлюється, немов орел, юність твоя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Господь творить справедливість","poem":1},{"text":"і правосуддя всім пригніченим.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Він показав шляхи Свої Мойсею","poem":1},{"text":"і діяння Свої – синам Ізраїлевим.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Милостивий і милосердний Господь,","poem":1},{"text":"довготерпеливий і щедрий на доброту.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він не буде постійно вести судову суперечку","poem":1},{"text":"й гнів триматиме не вічно.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Не за нашими гріхами Він вчинив нам","poem":1},{"text":"і віддячив нам не так,","poem":2},{"lineBreak":true},{"text":"як ми заслужили нашими переступами.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Адже як високо небо над землею,","poem":1},{"text":"так звеличилася милість Його над тими, хто Його боїться.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Як далеко схід від заходу,","poem":1},{"text":"так віддалив Він від нас наші беззаконня.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Як милує батько синів,","poem":1},{"text":"так милує Господь тих, хто боїться Його.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Бо Він знає нашу сутність,","poem":1},{"text":"пам’ятає, що ми – порох.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Дні людини – немов трава;","poem":1},{"text":"як цвіт польовий, так цвіте вона.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Як тільки вітер пронесеться над ним, не стане його,","poem":1},{"text":"і більше не впізнає його місце, де він ріс.","poem":2},{"noteId":175}]},{"type":"verse","number":17,"content":[{"text":"А милість Господа споконвіку й навіки","poem":1},{"text":"над тими, хто боїться Його,","poem":2},{"lineBreak":true},{"text":"і праведність Його – на синах синів,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"що бережуть Його Завіт","poem":1},{"lineBreak":true},{"text":"і пам’ятають настанови Його,","poem":1},{"text":"щоб їх виконувати.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Господь на небесах утвердив престол Свій,","poem":1},{"text":"і Царство Його панує над усім.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Благословіть Господа, ангели Його,","poem":1},{"text":"могутні силою, що виконують сказане Ним,","poem":2},{"lineBreak":true},{"text":"слухаючись голосу Його слова!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Благословіть Господа, усі воїнства Його,","poem":1},{"text":"слуги Його, що виконують Його волю!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Прославте Господа, усі діяння Його,","poem":1},{"text":"на всіх місцях Його панування!","poem":2},{"lineBreak":true},{"text":"Благослови, душе моя, Господа!","poem":1}]}],"footnotes":[{"noteId":175,"caller":"+","text":"Буквально: ніхто не впізнає місця його.","reference":{"chapter":102,"verse":16}}]},"thisChapterLink":"/api/ukr_npu/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":22}