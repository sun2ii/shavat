{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":103,"content":[{"type":"verse","number":1,"content":[{"text":"Благослови, душе моя, Господа!","poem":1},{"lineBreak":true},{"text":"Господи, Боже мій, Ти звеличився,","poem":1},{"text":"зодягнувся у славу й велич.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Він огортається світлом, немов шатами;","poem":1},{"text":"розстилає небеса, як покривало;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"закладає на водах основи Своїх вишніх світлиць.","poem":1},{"text":"Він робить хмари Своєю колісницею,","poem":2},{"text":"крокує на крилах вітру.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Він робить Своїми посланцями вітри,","poem":1},{"text":"Своїми слугами – полум’я вогню.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Він заклав землю на її основах,","poem":1},{"text":"тому не похитнеться вона повік-віків!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ти вкрив її безоднею, мов одягом,","poem":1},{"text":"на горах стояли води,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"та від грізного крику Твого побігли вони,","poem":1},{"text":"від голосу грому Твого пустилися навтіки.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Піднялися були в гори вони","poem":1},{"text":"та спустилися в долини,","poem":2},{"lineBreak":true},{"text":"до місця, яке Ти влаштував для них.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ти поклав межу, яку вони не перейдуть,","poem":1},{"text":"не вкриють вони знову землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ти посилаєш води джерела в річища,","poem":1},{"text":"між горами течуть вони,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"напувають усіх звірів польових;","poem":1},{"text":"там втамовують свою спрагу дикі віслюки.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"При водах тих живуть птахи небесні,","poem":1},{"text":"з-поміж гілля подають голос.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Він напуває гори з вишніх світлиць Своїх.","poem":1},{"text":"Від плоду діянь Твоїх насичується земля.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ти вирощуєш траву для худоби","poem":1},{"text":"й збіжжя для потреб людини,","poem":2},{"text":"щоб вивести їжу із землі,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"і вино, що серце людське веселить,","poem":1},{"text":"щоб сяяло обличчя від олії","poem":2},{"lineBreak":true},{"text":"і хлібом зміцнилося серце людини.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Насичуються дерева Господні,","poem":1},{"text":"кедри ліванські, які Він насадив.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Там птахи в’ють гнізда,","poem":1},{"text":"домівка лелеки – на кипарисах.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Високі гори диким козлам належать,","poem":1},{"text":"скелі – притулок даманів.","poem":2},{"noteId":176}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Він створив місяць, щоб час визначати;","poem":1},{"text":"сонце знає, коли йому заходити.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ти наводиш темряву, і настає ніч,","poem":1},{"text":"коли рухаються всі звірі лісові.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Молоді леви ричать за здобиччю,","poem":1},{"text":"просячи собі у Бога їжу.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Сходить сонце – вони збираються разом","poem":1},{"text":"і лягають у своє лігво.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Людина виходить на свою працю","poem":1},{"text":"й на роботу свою аж до вечора.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Які численні діяння Твої, Господи!","poem":1},{"text":"Усе Ти мудро створив;","poem":2},{"lineBreak":true},{"text":"земля наповнена створіннями Твоїми.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ось море велике й просторе,","poem":1},{"text":"там живина кишить без ліку,","poem":2},{"lineBreak":true},{"text":"живі істоти – малі й великі.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Там ходять кораблі,","poem":1},{"text":"там цей Левіятан,","poem":2},{"noteId":177},{"text":"якого Ти створив, щоб бавився він у морі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Усі вони очікують від Тебе,","poem":1},{"text":"що Ти даси їм їжу своєчасно.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ти даєш їм – вони приймають,","poem":1},{"text":"відкриваєш руку Твою – насичуються благом.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Сховаєш обличчя Своє –","poem":1},{"text":"вони бентежаться.","poem":2},{"text":"Забираєш дух їхній – гинуть","poem":1},{"text":"і повертаються в порох земний.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Пошлеш духа Свого –","poem":1},{"text":"вони створюються,","poem":2},{"lineBreak":true},{"text":"і Ти оновлюєш обличчя землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Нехай буде слава Господня навіки,","poem":1},{"text":"нехай радіє Господь діянням Своїм!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Він погляне на землю, і вона затремтить;","poem":1},{"text":"торкнеться до гір, і вони задимлять.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Я співатиму Господевіусе життя моє;","poem":1},{"text":"співатиму Богові моєму, поки існую.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Нехай буде приємним Йому мій роздум:","poem":1},{"text":"я радітиму в Господі.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Нехай згинуть грішники із землі","poem":1},{"text":"й нечестивих більше не буде.","poem":2},{"lineBreak":true},{"text":"Благослови, душе моя, Господа!","poem":1},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[{"noteId":176,"caller":"+","text":"Даман (євр. шафа́н) – травоїдні ссавці, розміром із зайця; мають особливі, лапки з присосками, завдяки яким можуть спритно лазити по прямовисним скелям і стовбурам дерев. У Біблії згадуються також в Лев. 11:5; Повт. 14:7; Пр. 30:26.","reference":{"chapter":103,"verse":18}},{"noteId":177,"caller":"+","text":"Левіятан – морське чудовисько; Див. Йов 3:8; 40:20–41:26; Пс. 73:14; Іс. 27:1-2.","reference":{"chapter":103,"verse":26}}]},"thisChapterLink":"/api/ukr_npu/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":35}