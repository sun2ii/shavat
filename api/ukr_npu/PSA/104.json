{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Славте Господа, кличте ім’я Його;","poem":1},{"text":"серед народів звіщайте діяння Його!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Співайте Йому, грайте для Нього,","poem":1},{"text":"звіщайте всі чудеса Його,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"хваліться іменем Його святим!","poem":1},{"text":"Нехай веселиться серце тих, хто шукає Господа!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Прагніть Господа й сили Його,","poem":1},{"text":"шукайте обличчя Його завжди.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Пам’ятайте про чудеса Його, які Він здійснив,","poem":1},{"text":"про знамення та суди Його.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"О нащадки Авраама, слуги Його,","poem":1},{"text":"сини Якова, Його обранці!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Він – Господь, Бог наш;","poem":1},{"text":"суди Його справедливі по всій землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Він вічно пам’ятає Завіт Свій,","poem":1},{"text":"слово, яке Він заповів для тисяч поколінь, –","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Завіт, який Він уклав з Авраамом,","poem":1},{"text":"і присягу Його Ісааку.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Він встановив його статутом для Якова,","poem":1},{"text":"як Завіт вічний для Ізраїля,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"кажучи: «Тобі віддам Я землю Ханаану","poem":1},{"text":"як долю вашого спадку».","poem":2},{"noteId":178}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Коли вони були людом нечисленним,","poem":1},{"text":"незначним, і мешкали як приходьки на ній,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"то мандрували вони від народу до народу,","poem":1},{"text":"від одного царства до іншого племені.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Він не дозволяв нікому їх гнобити","poem":1},{"text":"й докоряв за них царям:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«Не чіпайте помазанців Моїх","poem":1},{"text":"і пророкам Моїм не робіть зла».","poem":2},{"noteId":179}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Він накликав голод на землю,","poem":1},{"text":"зламав стебло хлібне.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Послав перед ними чоловіка –","poem":1},{"text":"у рабство був проданий Йосиф.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Його ноги стисли кайданами,","poem":1},{"text":"на шию йому наклали залізо,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"до того часу, поки не здійснилося сказане Господом,","poem":1},{"text":"поки слово Господа не очистило його.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Послав цар слуг своїх і розв’язав його;","poem":1},{"text":"правитель народів звільнив його.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Він поставив його володарем над домом своїм","poem":1},{"text":"і правителем над усім своїм майном,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"щоб він князів його міг стримувати","poem":1},{"noteId":180},{"text":"на свій розсуд","poem":1},{"text":"і старійшин його повчав.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Тоді прийшов Ізраїль до Єгипту,","poem":1},{"text":"оселився Яків у землі Хамовій.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"І дуже розмножив Бог народ Свій","poem":1},{"text":"і зробив його сильнішим від супротивників його,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"чиї серця Він налаштував, щоб ненавиділи Його народ,","poem":1},{"text":"щоб лукавили вони з Його рабами.","poem":2},{"noteId":181}]},{"type":"verse","number":26,"content":[{"text":"Він послав Мойсея, слугу Свого,","poem":1},{"text":"і Аарона, якого обрав Собі.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Вони з’явили знамення Його серед них","poem":1},{"text":"і чудеса – у землі Хамовій.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Він послав морок, і стало темно,","poem":1},{"text":"і вони не посміли суперечити Його слову.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Він перетворив води їхні на кров","poem":1},{"text":"і умертвив рибу в них.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Закишіла земля їхня жабами,","poem":1},{"text":"навіть у покоях царів їхніх були вони.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Він сказав, і прийшли рої мух,","poem":1},{"text":"комарі були на всіх теренах їхніх.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Він дав їм замість дощу град,","poem":1},{"text":"палючий вогонь – на землю їхню;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"він побив у них виноград та смоковницю,","poem":1},{"text":"зламав дерева в їхньому краї.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Сказав Він, і прийшла сарана і гусінь –","poem":1},{"text":"немає їм ліку!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"І з’їли вони всю траву в землі їхній,","poem":1},{"text":"пожерли плоди їхніх ґрунтів.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Тоді вразив Він усіх первістків у землі їхній –","poem":1},{"text":"першоплоди сили чоловічої.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"І вивів Він ізраїльтян зі сріблом і золотом,","poem":1},{"text":"не було серед племен їхніх того, хто спотикався.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Зрадів Єгипет, коли вони вийшли,","poem":1},{"text":"бо страх напав на нього через них.","poem":2},{"noteId":182}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Розгорнув Бог хмару, як покривало, вдень,","poem":1},{"text":"і вогонь, щоб світити вночі.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Просив народ, і послав їм Господь перепілок","poem":1},{"text":"і хлібом небесним наситив їх.","poem":2},{"noteId":183}]},{"type":"verse","number":41,"content":[{"text":"Відкрив Він скелю – і полилися води,","poem":1},{"text":"потекли рікою в сухій землі.","poem":2},{"noteId":184}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Бо згадав Він слово Своє святе,","poem":1},{"text":"що дав Авраамові, слузі Своєму.","poem":2},{"noteId":185}]},{"type":"verse","number":43,"content":[{"text":"І вивів Він народ Свій у радості,","poem":1},{"text":"обраних Своїх – із вигуком переможним.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Він дав їм землі народів,","poem":1},{"text":"і вспадкували здобутки праці їхньої,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"щоб вони дотримувалися Його постанов","poem":1},{"text":"і берегли закони Його.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[{"noteId":178,"caller":"+","text":"Див. Бут. 15:18-21; 26:3-4; 28:13-14.","reference":{"chapter":104,"verse":11}},{"noteId":179,"caller":"+","text":"Див. Бут. 12:10-20; 20:1-18.","reference":{"chapter":104,"verse":15}},{"noteId":180,"caller":"+","text":"Або: ув’язнити на свій розсуд міг.","reference":{"chapter":104,"verse":22}},{"noteId":181,"caller":"+","text":"Див. Вих. 1:1-14.","reference":{"chapter":104,"verse":25}},{"noteId":182,"caller":"+","text":"Див. Вих. 1–14.","reference":{"chapter":104,"verse":38}},{"noteId":183,"caller":"+","text":"Див. Вих. 16.","reference":{"chapter":104,"verse":40}},{"noteId":184,"caller":"+","text":"Див. Вих. 17:1-7.","reference":{"chapter":104,"verse":41}},{"noteId":185,"caller":"+","text":"Див. Бут. 12:1-3; 15 і 17 розділи.","reference":{"chapter":104,"verse":42}}]},"thisChapterLink":"/api/ukr_npu/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":45}