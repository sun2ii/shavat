{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Славте Господа,","poem":1},{"text":"бо Він добрий, бо навіки Його милосердя!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Хто може виразити словами могутність Господа","poem":1},{"text":"й сповістити всю хвалу Його?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Блаженні ті, хто стереже правосуддя,","poem":1},{"text":"хто справедливо діє повсякчасно!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Згадай мене, Господи, заради прихильності до Свого народу,","poem":1},{"text":"з’яви Себе мені в порятунку Твоєму,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"щоб міг я побачити добробут обраних Тобою,","poem":1},{"text":"радіти радістю за народ Твій,","poem":2},{"lineBreak":true},{"text":"похвалитися разом зі спадком Твоїм.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Згрішили ми, як і предки наші,","poem":1},{"text":"вчинили беззаконно, діяли нечестиво.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Батьки наші в Єгипті не збагнули Його чудес,","poem":1},{"text":"не пам’ятали величі милості Твоєї,","poem":2},{"lineBreak":true},{"text":"але збунтувалися біля моря, моря Червоного.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Та Він все ж врятував їх заради Свого імені,","poem":1},{"text":"щоб виявити Свою могутність.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Пригрозив Він морю Червоному,","poem":1},{"noteId":186},{"text":"і висохло воно,","poem":1},{"text":"і провів Він їх через безодні морські, як по пустелі.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"І врятував їх від руки ненависника,","poem":1},{"text":"визволив від руки ворога.","poem":2},{"noteId":187}]},{"type":"verse","number":11,"content":[{"text":"Покрили води супротивників їхніх –","poem":1},{"text":"жоден з них не лишився живим.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Тоді повірили вони словам Його","poem":1},{"text":"й заспівали Йому хвалу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Та швидко забули Його діяння,","poem":1},{"text":"не чекали на пораду від Нього.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Запалали пристрастю в пустелі","poem":1},{"text":"й випробовували Бога в дикій землі.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Тоді Він задовольнив прохання їхнє,","poem":1},{"text":"але послав виснаження їхнім душам.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Та вони позаздрили Мойсею у стані","poem":1},{"text":"й Аарону, святому Господа.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Відкрилася земля, і поглинула Датана,","poem":1},{"text":"і накрила все зборище Авірама.","poem":2},{"noteId":188}]},{"type":"verse","number":18,"content":[{"text":"Запалав вогонь серед їхнього зборища,","poem":1},{"text":"полум’я пожерло нечестивих.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Вони зробили теля на Хориві","poem":1},{"text":"й вклонилися істукану, вилитому з металу,","poem":2},{"noteId":189}]},{"type":"verse","number":20,"content":[{"text":"проміняли Славу свою","poem":1},{"text":"на зображення бика, що їсть траву.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Забули Бога, Рятівника свого,","poem":1},{"text":"Що звершив великі діяння в Єгипті,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"чудеса в землі Хамовій,","poem":1},{"text":"дії страшні на морі Червоному.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Він наказав би знищити їх,","poem":1},{"text":"якби Мойсей, обранець Його,","poem":2},{"text":"не став перед Ним у проломі,","poem":1},{"text":"щоб відвернути гнів Його,","poem":2},{"lineBreak":true},{"text":"аби Він не погубив їх.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"І знехтували вони Землею Бажаною,","poem":1},{"text":"не повірили Його слову,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"і ремствували в шатрах своїх,","poem":1},{"text":"і не слухали голосу Господа.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Тоді Він простягнув руку Свою на них,","poem":1},{"text":"щоб повалити їх в пустелі,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"і розкидати нащадків їхніх поміж народами,","poem":1},{"text":"і розсіяти їх по чужих землях.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Вони пристали до Ваал-Пеора","poem":1},{"text":"і їли жертви мертвим богам.","poem":2},{"noteId":190}]},{"type":"verse","number":29,"content":[{"text":"І гнівили Бога вчинками своїми,","poem":1},{"text":"тоді спалахнула серед них моровиця.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Постав Пінхас і вчинив суд,","poem":1},{"text":"і моровиця припинилася.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Це зараховано було йому в праведність","poem":1},{"text":"з роду в рід, навіки.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"І розлютили Його при водах Мериви,","poem":1},{"text":"і Мойсей зазнав через них лиха,","poem":2},{"noteId":191}]},{"type":"verse","number":33,"content":[{"text":"бо засмутили вони його дух,","poem":1},{"text":"і він говорив нерозсудливо своїми вустами.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Вони не знищили народів,","poem":1},{"text":"про які сказав їм Господь,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"але змішалися з народами","poem":1},{"text":"й навчилися діяти за їхніми вчинками;","poem":2}]},{"type":"verse","number":36,"content":[{"text":"служили ідолам їхнім,","poem":1},{"text":"які стали для них пасткою.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Приносили синів своїх і доньок","poem":1},{"text":"у жертву бісам","poem":2}]},{"type":"verse","number":38,"content":[{"text":"і проливали невинну кров,","poem":1},{"text":"кров своїх синів і доньок,","poem":2},{"text":"яких вони приносили в жертву ідолам ханаанським,","poem":1},{"text":"і осквернилася земля кров’ю.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Вони стали нечистими через свої діяння,","poem":1},{"text":"розпусно поводилися у своїх вчинках.","poem":2},{"noteId":192}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Тоді спалахнула лють Господа на народ Його,","poem":1},{"text":"гидким став Йому спадок Його.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"І віддав Він їх у руки народів,","poem":1},{"text":"і ненависники їхні панували над ними.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Вороги гнобили їх,","poem":1},{"text":"і вони підкорилися під їхню руку.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Він багато разів визволяв їх,","poem":1},{"text":"але вони бунтували у своїх задумах","poem":2},{"lineBreak":true},{"text":"і занурилися у гріхи свої.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Але Він зглянувся на скорботу їхню,","poem":1},{"text":"коли почув їхнє волання,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"і згадав про Завіт Свій з ними,","poem":1},{"text":"і змилувався через велике Своє милосердя.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"І викликав співчуття до них","poem":1},{"text":"у тих, хто тримав їх у полоні.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Врятуй нас, Господи, Боже наш,","poem":1},{"text":"і збери нас з-поміж народів,","poem":2},{"text":"щоб прославити Твоє святе ім’я,","poem":1},{"text":"піднесено співати Тобі хвалу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Благословенний Господь, Бог Ізраїлю,","poem":1},{"text":"споконвіку й повіки!","poem":2},{"lineBreak":true},{"text":"І нехай скаже увесь народ: «Амінь!»","poem":1},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[{"noteId":186,"caller":"+","text":"Червоне море – так передано цю географічну назву в більшості перекладів завдяки грецькому перекладу (Септуаґінта), у єврейському тексті вжито назву Очеретяне море йам-су́ф, що позначає, імовірно, Акабську затоку (1 Цар. 9:6).","reference":{"chapter":105,"verse":9}},{"noteId":187,"caller":"+","text":"Див. Вих. 14:30.","reference":{"chapter":105,"verse":10}},{"noteId":188,"caller":"+","text":"Див. Чис. 16.","reference":{"chapter":105,"verse":17}},{"noteId":189,"caller":"+","text":"Див. Вих. 32.","reference":{"chapter":105,"verse":19}},{"noteId":190,"caller":"+","text":"Див. Чис. 13; 14.","reference":{"chapter":105,"verse":28}},{"noteId":191,"caller":"+","text":"Див. Вих. 17:1-7; Чис. 20:2-13.","reference":{"chapter":105,"verse":32}},{"noteId":192,"caller":"+","text":"Див. Повт. 7:1-6; 18:9-13; Суд. 1:19–2:5.","reference":{"chapter":105,"verse":39}}]},"thisChapterLink":"/api/ukr_npu/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":48}