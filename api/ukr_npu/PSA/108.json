{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":108,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true},{"text":"Боже моєї хвали,","poem":1},{"text":"не мовчи,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"адже нечестиві й підступні люди","poem":1},{"text":"відкрили на мене вуста свої,","poem":2},{"lineBreak":true},{"text":"говорять зі мною брехливим язиком.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Оточили мене словами ненависті","poem":1},{"text":"й даремно воюють зі мною.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"За любов мою ворогують зі мною,","poem":1},{"text":"а я заглиблюся в молитву.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Вони віддячують мені злом за добро","poem":1},{"text":"й ненавистю – за мою любов.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Постав над ним нечестивця,","poem":1},{"text":"і обвинувач","poem":2},{"noteId":197},{"text":"нехай стане по його правиці.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Коли постане він перед судом, нехай виявиться винним","poem":1},{"text":"і молитва його нехай вважається гріхом.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Нехай дні його будуть нечисленними,","poem":1},{"text":"нехай інший займе його становище.","poem":2},{"noteId":198}]},{"type":"verse","number":9,"content":[{"text":"Нехай діти його стануть сиротами,","poem":1},{"text":"а дружина його – вдовою.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Нехай нащадки його тиняються й жебрають,","poem":1},{"text":"нехай просять на руїнах своїх домівок.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нехай захопить лихвар усе, що є в нього,","poem":1},{"text":"і чужі пограбують плоди його праці.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Нехай не буде нікого, хто виявив би йому співчуття,","poem":1},{"text":"і над сиротами його нехай ніхто не змилується.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Нехай будуть викорінені його нащадки","poem":1},{"text":"й зітреться ім’я його в наступному поколінні.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Нехай згадаються перед Господом беззаконня його предків","poem":1},{"text":"і гріх матері його не буде стертий.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Нехай гріхи його будуть завжди перед Господом","poem":1},{"text":"і нехай викорінена буде з землі пам’ять його","poem":2}]},{"type":"verse","number":16,"content":[{"text":"за те, що він не пам’ятав виявляти іншим милість,","poem":1},{"text":"але переслідував пригніченого, бідного","poem":2},{"lineBreak":true},{"text":"й зламаного серцем, щоб умертвити його.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Він любив прокляття –","poem":1},{"text":"воно прийде до нього;","poem":2},{"text":"йому не подобалося благословення –","poem":1},{"text":"воно від нього віддалиться.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Оскільки він вдягався в прокляття, мов у шати,","poem":1},{"text":"воно просякло, як вода, в його нутро,","poem":2},{"lineBreak":true},{"text":"і, немов олія, – у його кістки.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Нехай стане воно для нього одягом,","poem":1},{"text":"у який він огортається,","poem":2},{"lineBreak":true},{"text":"і поясом, яким він завжди підперізується.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Така відплата від Господа тому, хто ворогує проти мене,","poem":1},{"text":"і тим, хто зле говорить на душу мою.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ти ж, Господи, Володарю,","poem":1},{"text":"вступися за мене заради імені Твого;","poem":2},{"lineBreak":true},{"text":"через доброту милосердя Твого визволи мене.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Адже я пригнічений і бідний","poem":1},{"text":"і серце моє зранене в нутрі моєму.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Я сную, немов похилена тінь,","poem":1},{"text":"як сарану, струшують мене.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Мої коліна ослабли від посту,","poem":1},{"text":"і тіло моє геть виснажилося без олії.","poem":2},{"noteId":199}]},{"type":"verse","number":25,"content":[{"text":"Я став посміховищем для них:","poem":1},{"text":"ті, що бачать мене, похитують глузливо головами своїми.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Допоможи мені, Господи, Боже мій,","poem":1},{"text":"врятуй мене за милістю Твоєю.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Нехай же знають, що це рука Твоя,","poem":1},{"text":"що це Ти зробив, Господи.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Нехай вони проклинають, а Ти благослови;","poem":1},{"text":"вони повстануть, але посоромляться,","poem":2},{"lineBreak":true},{"text":"а слуга Твій радітиме.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Нехай вдягнуться в безчестя ті, хто проти мене ворогує,","poem":1},{"text":"і огорнуться ганьбою, немов шатами.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Я буду славити вустами моїми Господа завзято","poem":1},{"text":"й серед велелюддя хвалитиму Його.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Бо Він стоїть по правиці від бідняка,","poem":1},{"text":"щоб врятувати його від тих, хто судить його душу.","poem":2}]}],"footnotes":[{"noteId":197,"caller":"+","text":"Давньоєврейське слово сата́н означає «той, хто звинувачує»; у грецькому перекладі тут вжито слово діа́болос, що первинно має таке ж значення: «обвинувач», «супротивник» (Див. Зах. 3:1); це слово також вживається в Біблії в значенні «сатана», «диявол».","reference":{"chapter":108,"verse":6}},{"noteId":198,"caller":"+","text":"Див. Повт. 28:30-45; 1 Цар. 22; Дії 1:20.","reference":{"chapter":108,"verse":8}},{"noteId":199,"caller":"+","text":"Буквально: позбавлене жиру.","reference":{"chapter":108,"verse":24}}]},"thisChapterLink":"/api/ukr_npu/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":31}