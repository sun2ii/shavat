{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":109,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"noteId":200},{"text":"Промовив Господь Володареві моєму:","poem":1},{"lineBreak":true},{"text":"«Сядь праворуч від Мене,","poem":1},{"text":"доки Я не покладу ворогів Твоїх,","poem":2},{"lineBreak":true},{"text":"як підніжок для Твоїх ніг».","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Жезл сили Твоєї простягне Господь із Сіону –","poem":1},{"text":"пануй серед ворогів Твоїх!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Народ Твій готовий","poem":1},{"text":"у день з’явлення сили Твоєї,","poem":2},{"text":"він вишикувався у величний святий стрій.","poem":1},{"text":"Із надр досвітньої зорі,","poem":2},{"text":"немов вранішня роса, народження Твоє.","poem":3},{"noteId":201}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Поклявся Господь","poem":1},{"text":"і не відмовиться:","poem":2},{"lineBreak":true},{"text":"«Ти – священник навіки за чином Мельхіседека».","poem":2},{"noteId":202}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Володар по правиці від Тебе,","poem":1},{"text":"Він вразить царів у день гніву Свого.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Судитиме Він народи,","poem":1},{"text":"вкриє землю трупами,","poem":2},{"lineBreak":true},{"text":"вразить голову ворога на широкому полі.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Питиме із потоку при дорозі,","poem":1},{"text":"тому підніме голову.","poem":2}]}],"footnotes":[{"noteId":200,"caller":"+","text":"Цей псалом, подібно до Пс. 2, присвячений інавгурації царя Ізраїлю: Господь (Ягве́) звертається тут до Володаря (Адона́й), тобто царя, якого Він «помазав» на царство. Оскільки в Новому Заповіті цей псалом представлений як пророцтво про Ісуса Христа (Мт. 22:41-46; Дії 2:34-36; Євр. 5:5-10), займенник «Тебе», «Твій» щодо царя у перекладі написано з великої літери.","reference":{"chapter":109,"verse":1}},{"noteId":201,"caller":"+","text":"Про «народження» як день «помазання» (інавгурації) царя, Див. Пс. 2:7.","reference":{"chapter":109,"verse":3}},{"noteId":202,"caller":"+","text":"Мельхіседек був одночасно царем і священником і не належав до нащадків Аарона (Бут. 14:17-20; Євр. 5:4-10; 7:1-28).","reference":{"chapter":109,"verse":4}}]},"thisChapterLink":"/api/ukr_npu/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":7}