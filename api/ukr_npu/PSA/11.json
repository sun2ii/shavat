{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. У супроводі восьмиструнного інструмента. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Врятуй, Господи, бо не стало справедливого,","poem":1},{"text":"бо зникли вірні з-посеред синів людських!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Марне говорять одне одному,","poem":1},{"text":"вуста слизькі в них,","poem":2},{"lineBreak":true},{"text":"глибоко в серці промовляють інше.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Нехай розрубає Господь кожні слизькі вуста","poem":1},{"text":"й зухвалий язик тих,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"що говорять: «Нашим язиком здолаємо кого завгодно;","poem":1},{"text":"вуста наші з нами – то хто нам пан?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Через те, що грабують пригноблених,","poem":1},{"text":"що бідняки стогнуть,","poem":2},{"lineBreak":true},{"text":"нині повстану Я, – говорить Господь, –","poem":2},{"lineBreak":true},{"text":"врятую від тих, хто зводить на них наклеп».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Слова Господні – слова чисті,","poem":1},{"text":"немов срібло, що в горнилі земляному очищене,","poem":2},{"lineBreak":true},{"text":"сім разів переплавлене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ти, Господи, берегтимеш нужденних,","poem":1},{"text":"стерегтимеш нас від роду цього злого повіки,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"поки навколо тиняються нечестиві","poem":1},{"text":"й людська нікчемність у пошані.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":9}