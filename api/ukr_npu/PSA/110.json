{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Я Господа славити буду всім серцем","poem":1},{"text":"на раді справедливих і в зібранні.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Діяння Господа величні,","poem":1},{"text":"бажані для всіх, хто вподобав їх.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Слава й велич – діяння Його,","poem":1},{"text":"і правда Його перебуватиме повіки.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Пам’ятними зробив Він чудеса Свої;","poem":1},{"text":"милостивий і милосердний Господь.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Їжу дає Він тим, хто боїться Його,","poem":1},{"text":"пам’ятає вічно Завіт Свій.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Силу діянь Своїх з’явив Він народові Своєму,","poem":1},{"text":"віддавши їм спадщину народів.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Діяння рук Його – істина й справедливість,","poem":1},{"text":"усі настанови Його варті довіри.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Вони утверджені на віки вічні,","poem":1},{"text":"засновані на істині й справедливості.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він послав визволення Своєму народові,","poem":1},{"text":"уклав навіки Свій Завіт.","poem":2},{"lineBreak":true},{"text":"Святе й грізне ім’я Його.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Початок мудрості – страх Господній.","poem":1},{"text":"Добре розуміння мають усі, хто виконує Його настанови.","poem":2},{"lineBreak":true},{"text":"Хвала Йому перебуватиме повіки!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":10}