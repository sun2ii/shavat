{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Блаженний той, хто Господа боїться","poem":1},{"text":"і в заповідях Його має велике задоволення!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Будуть сильними на землі нащадки його;","poem":1},{"text":"покоління справедливих благословиться.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Достаток і багатство в домі його,","poem":1},{"text":"і праведність його повік перебуватиме.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Сяє в темряві світло для справедливих:","poem":1},{"text":"милостиве, милосердне й праведне воно.","poem":2},{"noteId":203}]},{"type":"verse","number":5,"content":[{"text":"Добре тому, хто милує й позичає,","poem":1},{"text":"хто справи свої веде правосудно!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Бо він не похитнеться повіки;","poem":1},{"text":"праведник буде у вічній пам’яті.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Не злякається лихої чутки,","poem":1},{"text":"серце його непохитне, упевнене в Господі.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Утверджене його серце, не злякається,","poem":1},{"text":"аж поки не побачить падіння ворогів своїх.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він щедро роздав бідним,","poem":1},{"text":"його праведність стоятиме повіки,","poem":2},{"lineBreak":true},{"text":"ріг його піднесеться у славі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Нечестивий побачить це й розгнівається,","poem":1},{"text":"заскрегоче зубами своїми й розтане.","poem":2},{"lineBreak":true},{"text":"Бажання нечестивців загине.","poem":2}]}],"footnotes":[{"noteId":203,"caller":"+","text":"Або: Сяє в темряві світло для справедливих, (бо Бог) милостивий, милосердний і праведний.","reference":{"chapter":111,"verse":4}}]},"thisChapterLink":"/api/ukr_npu/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}