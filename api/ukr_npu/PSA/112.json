{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Хваліть, раби Господні,","poem":1},{"text":"хваліть ім’я Господа!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Нехай буде ім’я Господнє благословенне","poem":1},{"text":"віднині й повіки!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Від сходу сонця й до його заходу","poem":1},{"text":"прославлене ім’я Господа!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господь піднісся високо над усіма народами,","poem":1},{"text":"вище небес Його слава.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Хто подібний до Господа, Бога нашого,","poem":1},{"text":"Який, мешкаючи на висотах,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"схиляється подивитися","poem":1},{"text":"на небеса і землю?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Він піднімає із пилу вбогого,","poem":1},{"text":"із купи сміття підносить бідняка,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"щоб посадити його зі шляхетними,","poem":1},{"text":"зі шляхетними його народу.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він неплідну жінку вселяє в дім","poem":1},{"text":"радісною матір’ю дітей.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":9}