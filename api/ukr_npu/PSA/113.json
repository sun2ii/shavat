{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Коли Ізраїль виходив з Єгипту,","poem":1},{"text":"Яків від народу чужоземного,","poem":2},{"noteId":204}]},{"type":"verse","number":2,"content":[{"text":"тоді Юда став Його святинею,","poem":1},{"text":"Ізраїль – Його володінням.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Море побачило це й кинулося навтіки,","poem":1},{"text":"Йордан повернувся назад.","poem":2},{"noteId":205}]},{"type":"verse","number":4,"content":[{"text":"Гори скакали, немов барани,","poem":1},{"text":"пагорби – наче ягнята.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Що з тобою, море, що ти втікаєш,","poem":1},{"text":"і з тобою, Йордане, що ти назад повертаєшся?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Що це ви, гори, скакаєте, як барани,","poem":1},{"text":"і ви, пагорби, – немов ягнята?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Тремти, земле, перед Володарем,","poem":1},{"text":"перед Богом Якова,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Який перетворює скелю на водойму,","poem":1},{"text":"кремінь – на джерело води.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Не нам, Господи, не нам,","poem":1},{"text":"але імені Твоєму дай славу","poem":2},{"lineBreak":true},{"text":"за милість і вірність Твою.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Чому б народи говорили:","poem":1},{"text":"«Де ж це Бог їхній?»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"А Бог наш на небесах,","poem":1},{"text":"Він чинить усе, що Йому до вподоби.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ідоли їхні – срібло й золото,","poem":1},{"text":"витвір рук людських.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"У них є вуста, але вони не говорять;","poem":1},{"text":"у них є очі, але вони не бачать;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"у них є вуха, але не чують;","poem":1},{"text":"вони мають ніздрі, але не відчувають запаху;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"у них є руки, але не відчувають дотику;","poem":1},{"text":"вони мають ноги, але не ходять;","poem":2},{"lineBreak":true},{"text":"не видають звуків своєю гортанню.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Подібними до них нехай стануть ті, хто їх робить,","poem":1},{"text":"усі, хто на них надію покладає!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ізраїлю, покладай надію на Господа –","poem":1},{"text":"Він для них допомога й щит!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Доме Ааронів, покладай надію на Господа –","poem":1},{"text":"Він для них допомога й щит!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ті, хто Господа боїться, покладайте надію на Господа –","poem":1},{"text":"Він для них допомога й щит!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Господь пам’ятає нас і благословить:","poem":1},{"text":"благословить дім Ізраїлів,","poem":2},{"lineBreak":true},{"text":"благословить дім Ааронів,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"благословить тих, хто боїться Господа,","poem":1},{"text":"малих і великих.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Нехай Господь примножить вам добро,","poem":1},{"text":"вам і нащадкам вашим!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Благословенні ви у Господа,","poem":1},{"text":"Творця неба і землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Небеса – Господеві належить небо,","poem":1},{"text":"а землю Він дав синам людським.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Не мертві хвалитимуть Господа","poem":1},{"text":"і не всі, хто сходить у країну мовчання,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"але ми благословлятимемо Господа","poem":1},{"text":"віднині й повіки.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[{"noteId":204,"caller":"+","text":"Див. Вих. 13:3.","reference":{"chapter":113,"verse":1}},{"noteId":205,"caller":"+","text":"Див. Вих. 14; 15; Іс. Нав. 3.","reference":{"chapter":113,"verse":3}}]},"thisChapterLink":"/api/ukr_npu/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":26}