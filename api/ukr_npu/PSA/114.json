{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Люблю я Господа,","poem":1},{"text":"бо Він чує мій голос,","poem":2},{"lineBreak":true},{"text":"мої благання.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Через те, що прихилив Він вухо Своє до мене,","poem":1},{"text":"я буду кликати до Нього всі дні мої.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Облягли мене кайдани смерті,","poem":1},{"text":"муки царства мертвих спіткали мене,","poem":2},{"lineBreak":true},{"text":"знайшов я скорботу й страждання.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Тоді я кликав ім’я Господа:","poem":1},{"text":"«Господи, благаю, врятуй мою душу!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Милостивий Господь і праведний,","poem":1},{"text":"милосердний Бог наш.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Господь береже недосвідчених:","poem":1},{"text":"я знемігся, та Він врятує мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Повернися, душе моя, до свого спокою,","poem":1},{"text":"адже Господь віддячив тобі добром.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Бо Ти визволив душу мою від смерті,","poem":1},{"text":"очі мої – від сліз,","poem":2},{"lineBreak":true},{"text":"ногу мою – від спотикання.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Я буду ходити перед обличчям Господа","poem":1},{"text":"на землі живих.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":9}