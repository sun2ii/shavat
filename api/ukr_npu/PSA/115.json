{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Я вірив Богові, коли говорив:","poem":1},{"text":"«Я дуже пригнічений».","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Сказав я у розпачі:","poem":1},{"text":"«Кожна людина говорить неправду!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Чим я віддячу Господеві","poem":1},{"text":"за всі Його добродійства для мене?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Піднесу келих спасіння","poem":1},{"text":"й покличу ім’я Господнє.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Виконаю усі свої обітниці Господеві","poem":1},{"text":"перед усім народом Його.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Цінна в очах Господніх","poem":1},{"text":"смерть Його вірних.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Благаю, Господи, я ж раб Твій,","poem":1},{"text":"я раб Твій і син служниці Твоєї;","poem":2},{"lineBreak":true},{"text":"Ти розв’язав мої пута!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Тобі принесу я жертву подяки","poem":1},{"text":"й покличу ім’я Господа.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Виконаю усі свої обітниці Господеві","poem":1},{"text":"перед усім народом Його,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"у дворах дому Господнього,","poem":1},{"text":"посеред тебе, Єрусалиме!","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":10}