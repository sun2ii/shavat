{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":117,"content":[{"type":"verse","number":1,"content":[{"text":"Славте Господа, бо Він добрий,","poem":1},{"text":"бо навіки Його милосердя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Нехай скаже Ізраїль:","poem":1},{"text":"«Бо навіки Його милосердя!»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Нехай скаже дім Ааронів:","poem":1},{"text":"«Бо навіки Його милосердя!»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нехай скажуть ті, що бояться Господа:","poem":1},{"text":"«Бо навіки Його милосердя!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Із тісноти покликав я Господа –","poem":1},{"text":"Господь відповів мені,","poem":2},{"lineBreak":true},{"text":"вивів мене на просторе місце.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Господь зі мною – не боятимуся!","poem":1},{"text":"Що зробить мені людина?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Господь зі мною, щоб допомагати мені –","poem":1},{"text":"буду дивитися переможно на моїх ненависників.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Краще захисту шукати в Господа,","poem":1},{"text":"ніж надіятися на людину.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Краще захисту шукати в Господа,","poem":1},{"text":"ніж надіятися на шляхетних мужів.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Усі народи оточили мене,","poem":1},{"text":"та іменем Господнім я знищив їх.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Оточили мене, обступили з усіх боків,","poem":1},{"text":"та іменем Господнім я знищив їх.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Оточили мене, як бджоли,","poem":1},{"text":"та згасли, немов вогонь у терені:","poem":2},{"lineBreak":true},{"text":"іменем Господнім я знищив їх.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ти штовхнув мене, вороже,","poem":1},{"text":"так сильно, щоб я впав,","poem":2},{"lineBreak":true},{"text":"та Господь допоміг мені.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Сила моя і пісня моя – Господь;","poem":1},{"text":"Він став моїм спасінням.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Голос радості й перемоги в наметах праведників:","poem":1},{"text":"правиця Господня діє могутньо!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Правиця Господня піднята вгору,","poem":1},{"text":"правиця Господня діє могутньо!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Не помру, але буду жити","poem":1},{"text":"й розповідати про діяння Господа.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Господь покарав мене тяжко,","poem":1},{"text":"та не віддав мене на смерть.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Відчиніть мені брами правди,","poem":1},{"text":"я увійду до них, прославлю Господа.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Це брама Господня,","poem":1},{"text":"у яку входять праведні.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Прославлю Тебе, бо Ти відповів мені","poem":1},{"text":"й став моїм спасінням.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Камінь, який відкинули будівничі,","poem":1},{"text":"став наріжним каменем!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Від Господа це було,","poem":1},{"text":"як дивно це в очах наших!","poem":2},{"noteId":206}]},{"type":"verse","number":24,"content":[{"text":"Цей день створив Господь:","poem":1},{"text":"веселімося й радіймо сьогодні!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"О Господи, врятуй же,","poem":1},{"text":"о Господи, даруй нам успіх!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Благословенний Той, Хто йде в ім’я Господа!","poem":1},{"text":"Благословляємо вас із дому Господнього!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Бог – це Господь,","poem":1},{"text":"і Він осяяв нас.","poem":2},{"text":"В’яжіть мотузками жертву святкову,","poem":1},{"text":"ведіть до рогів жертовника.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ти – мій Бог, і я прославлю Тебе.","poem":1},{"text":"Боже мій, я величатиму Тебе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Славте Господа, бо Він добрий,","poem":1},{"text":"бо навіки Його милосердя.","poem":2}]}],"footnotes":[{"noteId":206,"caller":"+","text":"Див. Мк. 12:10-11; Дії 4:11; 1 Пет. 2:7.","reference":{"chapter":117,"verse":23}}]},"thisChapterLink":"/api/ukr_npu/PSA/117.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/118.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/116.json","previousChapterAudioLinks":{},"numberOfVerses":29}