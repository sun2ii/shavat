{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Блаженні ті, чия дорога невинна,","poem":1},{"text":"хто ходить по ній за Законом Господнім.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Блаженні ті, що дотримуються одкровень Його,","poem":1},{"text":"усім серцем шукають Його.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Вони не чинять беззаконня,","poem":1},{"text":"ходять Його шляхами.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ти заповів настанов Твоїх","poem":1},{"text":"триматися твердо.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"О, якби утверджувалися дороги мої","poem":1},{"text":"в дотриманні постанов Твоїх!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Тоді не посоромився б я,","poem":1},{"text":"дивлячись на всі Твої заповіді.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Буду славити Тебе в щирості серця,","poem":1},{"text":"навчаючись законів правосуддя Твого.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Постанов Твоїх я дотримуватися буду,","poem":1},{"text":"не покидай же мене назавжди.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Як зможе юнак тримати стежку свою в чистоті?","poem":1},{"text":"Дотримуючись Твого слова.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Усім серцем моїм шукаю Тебе,","poem":1},{"text":"не дай мені ухилитися від заповідей Твоїх.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"У серці моєму сховав я сказане Тобою,","poem":1},{"text":"щоб не згрішив я проти Тебе.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Благословенний Ти, Господи!","poem":1},{"text":"Навчи мене постанов Твоїх.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Вустами моїми я звіщаю","poem":1},{"text":"усі закони правосуддя із уст Твоїх.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"На шляху одкровень Твоїх радію я,","poem":1},{"text":"ніби великими статками.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Про настанови Твої я роздумую","poem":1},{"text":"й стежки Твої споглядаю.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Я підбадьорююся постановами Твоїми,","poem":1},{"text":"не забуваю Твого слова.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Віддяч добром слузі Своєму,","poem":1},{"text":"я житиму й буду дотримуватися слова Твого.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Відкрий мої очі,","poem":1},{"text":"і я побачу чудеса Закону Твого.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Приходьком живу я на землі,","poem":1},{"text":"не приховуй від мене заповідей Твоїх.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Зомліла душа моя,","poem":1},{"text":"прагнучи повсякчасно Твоїх законів правосуддя.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ти звинуватив проклятих зухвальців,","poem":1},{"text":"що від заповідей Твоїх ухиляються.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Зніми з мене ганьбу й сором,","poem":1},{"text":"адже одкровень Твоїх я дотримуюся.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Хоча князі сидять і змовляються проти мене,","poem":1},{"text":"та слуга Твій роздумує над постановами Твоїми.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Одкровення ж Твої – мої радощі,","poem":1},{"text":"порадники мої.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Прилинула до пороху душа моя,","poem":1},{"text":"оживи мене згідно зі словом Твоїм.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Я розповів Тобі про дороги свої,","poem":1},{"text":"і Ти відповів мені;","poem":2},{"lineBreak":true},{"text":"навчи мене постанов Своїх.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Дай мені зрозуміти шлях настанов Твоїх,","poem":1},{"text":"і я роздумувати буду над чудесами Твоїми.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Розпливлася від смутку душа моя,","poem":1},{"text":"зміцни мене згідно зі словом Твоїм.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Дорогу неправди віддали від мене","poem":1},{"text":"і Законом Твоїм як милістю мене обдаруй.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Я обрав дорогу істини,","poem":1},{"text":"закони правосуддя поставив перед собою.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Я прилинув до одкровень Твоїх, Господи,","poem":1},{"text":"не дай мені осоромитися.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Побіжу я дорогою заповідей Твоїх,","poem":1},{"text":"коли ти розуміння моє","poem":2},{"noteId":207},{"text":"розшириш.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Навчи мене, Господи, шляху постанов Твоїх,","poem":1},{"text":"і я буду дотримуватися його до кінця.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Дай мені розуміння, і я дотримуватися Закону Твого буду","poem":1},{"text":"й виконуватиму його всім серцем.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Поведи мене стежкою заповідей Твоїх,","poem":1},{"text":"адже на ній я знаходжу задоволення.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Прихили серце моє до Твоїх одкровень,","poem":1},{"text":"а не до корисливості.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Відведи очі мої, щоб не бачили марноти;","poem":1},{"text":"оживляй мене на шляху Твоєму.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Виконай усе сказане Тобою рабові Своєму,","poem":1},{"text":"який боїться Тебе.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Відверни від мене ганьбу, якої я жахаюся,","poem":1},{"text":"адже закони правосуддя Твого добрі.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"О, як я прагну настанов Твоїх!","poem":1},{"text":"Оживляй мене праведністю Своєю.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Нехай прийде до мене, Господи, милість Твоя,","poem":1},{"text":"спасіння Твоє згідно зі словом Твоїм.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Тоді відповім я тому, хто словом ганьбить мене,","poem":1},{"text":"адже я слову Твоєму довіряю.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ніколи не забирай слова істини від моїх вуст,","poem":1},{"text":"бо на суди Твої справедливі я сподіваюся.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Я буду дотримуватися Закону Твого завжди,","poem":1},{"text":"повік-віків,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"і ходитиму вільно,","poem":1},{"text":"бо настанов Твоїх я шукаю.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"І говоритиму я про одкровення Твої перед царями,","poem":1},{"text":"і не буду осоромлений;","poem":2}]},{"type":"verse","number":47,"content":[{"text":"і радітиму Твоїм заповідям,","poem":1},{"text":"які я полюбив.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Тоді простягну долоні свої до заповідей Твоїх,","poem":1},{"text":"які я полюбив,","poem":2},{"lineBreak":true},{"text":"і роздумувати буду про постанови Твої.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Згадай слово Своє до слуги Твого,","poem":1},{"text":"на яке Ти заповів мені сподіватися.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Це – втіха у скорботі моїй,","poem":1},{"text":"що слово Твоє оживляє мене.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Зухвальці надмірно насміхаються з мене,","poem":1},{"text":"та від Закону Твого я не ухиляюся.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Згадую Твої одвічні закони правосуддя, Господи,","poem":1},{"text":"і втішаюся я.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Жах охоплює мене через нечестивців,","poem":1},{"text":"що Закон Твій полишають.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Співом стали для мене постанови Твої","poem":1},{"text":"в домі, де я мешкаю.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Я згадую вночі ім’я Твоє, Господи,","poem":1},{"text":"і дотримуюся Закону Твого.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Моїм він став,","poem":1},{"text":"бо настанов Твоїх я дотримуюся.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Господи, – сказав я, – доля моя –","poem":1},{"text":"дотримуватися Твоїх слів.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Шукав я прихильності обличчя Твого усім серцем:","poem":1},{"text":"помилуй мене згідно зі словом Твоїм.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Я обдумував дороги свої","poem":1},{"text":"й повертав ноги мої до одкровень Твоїх,","poem":2}]},{"type":"verse","number":60,"content":[{"text":"поспішав і не зволікав","poem":1},{"text":"виконувати заповіді Твої.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Кайдани нечестивців облягли мене,","poem":1},{"text":"та не забув я Закону Твого.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Опівночі вставав я славити Тебе","poem":1},{"text":"за справедливі суди Твої.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Я спільник усім, хто боїться Тебе","poem":1},{"text":"й хто дотримується настанов Твоїх.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Милістю Твоєю, Господи, наповнена земля;","poem":1},{"text":"навчи мене постанов Твоїх.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Добре вчинив Ти зі слугою Своїм","poem":1},{"text":"згідно зі словом Твоїм, Господи.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Доброго розуміння й пізнання навчи мене,","poem":1},{"text":"адже я повірив заповідям Твоїм.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Перш ніж я зазнав страждання мого, я блукав,","poem":1},{"text":"але тепер слова Твого дотримуюся.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Добрий Ти і чиниш добро,","poem":1},{"text":"тож навчи мене постанов Своїх.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Плетуть зухвальці на мене неправду,","poem":1},{"text":"я ж усім серцем триматимусь настанов Твоїх.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Нечулим, немов лій, стало їхнє серце,","poem":1},{"text":"я ж Законом Твоїм себе підбадьорюю.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Добре мені, що постраждав я,","poem":1},{"text":"щоб навчитися постанов Твоїх.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Ліпший для мене Закон Твій,","poem":1},{"text":"аніж тисячі зливків золота й срібла.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Руки Твої створили й утвердили мене;","poem":1},{"text":"дай мені розуміння, і я навчуся заповідей Твоїх.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Побачать мене ті, хто боїться Тебе, і зрадіють,","poem":1},{"text":"бо на слово Твоє я сподіваюся.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Я знаю, Господи, що справедливі суди Твої,","poem":1},{"text":"і через вірність Свою Ти дав мені зазнати страждання.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Нехай милість Твоя стане втіхою моєю,","poem":1},{"text":"згідно зі словом Твоїм, даним слузі Твоєму.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Нехай прийде до мене милосердя Твоє, і я оживу,","poem":1},{"text":"адже Закон Твій – втіха моя.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Нехай же посоромляться зухвальці за те,","poem":1},{"text":"що безвинно пригнічують мене;","poem":2},{"lineBreak":true},{"text":"а я роздумувати буду над настановами Твоїми.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Нехай навернуться до мене ті, хто боїться Тебе","poem":1},{"text":"й знає одкровення Твої.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Нехай серце моє буде невинним щодо постанов Твоїх,","poem":1},{"text":"щоб я не осоромився.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Знемагає душа моя від туги за спасінням Твоїм,","poem":1},{"text":"але я на слово Твоє сподіваюся.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Тануть очі мої, на слово Твоє чекаючи","poem":1},{"text":"й кажучи: «Коли Ти втішиш мене?»","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Бо я став, немов міх у диму,","poem":1},{"text":"та постанов Твоїх я не забуваю.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Скільки днів відведено слузі Твоєму?","poem":1},{"text":"Коли ж Ти вчиниш суд над переслідувачами моїми?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Зухвальці викопали мені ями","poem":1},{"text":"всупереч Закону Твоєму.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Усі заповіді Твої – істина.","poem":1},{"text":"Мене неправедно переслідують, допоможи мені.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Мало не згубили мене на землі,","poem":1},{"text":"та настанов Твоїх я не залишив.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"За милістю Своєю оживи мене,","poem":1},{"text":"і я буду дотримуватися одкровення вуст Твоїх.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Навіки, Господи, слово Твоє","poem":1},{"text":"утверджене на небесах;","poem":2}]},{"type":"verse","number":90,"content":[{"text":"з роду в рід – вірність Твоя.","poem":1},{"text":"Ти утвердив землю, і вона стоїть;","poem":2}]},{"type":"verse","number":91,"content":[{"text":"за Твоїми законами правосуддя все стоїть донині,","poem":1},{"text":"бо все Тобі служить.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Якби Закон Твій не був моєю втіхою,","poem":1},{"text":"то я загинув би в скорботі своїй.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Я повіки не забуду настанов Твоїх,","poem":1},{"text":"адже ними Ти оживляєш мене.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Я – Твій, врятуй же мене,","poem":1},{"text":"адже прагну я настанов Твоїх.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Нечестиві очікують, щоб погубити мене,","poem":1},{"text":"та я роздумую над одкровеннями Твоїми.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Я бачив межу всілякої досконалості,","poem":1},{"text":"та заповідь Твоя безмежно широка!","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Як люблю я Закон Твій!","poem":1},{"text":"Роздумую над ним цілий день.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Заповіддю Своєю Ти зробив мене мудрішим від ворогів моїх,","poem":1},{"text":"бо вона навіки зі мною.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Я став розумнішим від усіх вчителів моїх,","poem":1},{"text":"бо одкровення Твої – мої роздуми.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Я розумію більше, ніж старці,","poem":1},{"text":"бо настанови Твої дотримую.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Від усілякої лихої стежки утримую ноги мої,","poem":1},{"text":"щоб виконувати Твоє слово.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Від Твоїх законів правосуддя не відступаю,","poem":1},{"text":"адже Ти навчаєш мене.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Які солодкі для мого піднебіння слова Твої!","poem":1},{"text":"Вони солодші, ніж мед, для вуст моїх.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Від настанов Твоїх я набираюсь розуміння,","poem":1},{"text":"тому ненавиджу всяку стежку неправди.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Слово Твоє – світильник для ноги моєї","poem":1},{"text":"і світло для стежки моєї.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Присягнув я виконувати справедливі закони правосуддя Твого","poem":1},{"text":"і виконаю це.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Постраждав я занадто, Господи,","poem":1},{"text":"оживи мене згідно зі словом Твоїм.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Добровільні жертви вуст моїх","poem":1},{"text":"нехай приємними будуть Тобі, Господи,","poem":2},{"lineBreak":true},{"text":"і навчи мене Твоїх законів правосуддя.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Душа моя завжди в моїй руці,","poem":1},{"noteId":208},{"text":"та Закону Твого я не забуваю.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Нечестиві розставили тенета для мене,","poem":1},{"text":"але від настанов Твоїх я не ухиляюся.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Я прийняв, як вічний спадок, одкровення Твої,","poem":1},{"text":"адже вони – радість мого серця.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Нахилив я серце своє до того,","poem":1},{"text":"щоб дотримувати постанови Твої повіки, до кінця.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Ненавиджу двоєдушних людей,","poem":1},{"noteId":209},{"text":"а Закон Твій люблю.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Ти – сховище моє й щит;","poem":1},{"text":"на слово Твоє сподіваюся.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Відступіться від мене, злодії,","poem":1},{"text":"і я буду дотримуватися заповідей Бога мого.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Підтримай мене згідно зі словом Твоїм, і я житиму;","poem":1},{"text":"і не дай мені осоромитися в надії моїй.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Підтримай мене, і я буду врятований,","poem":1},{"text":"і постанови Твої завжди споглядатиму.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Ти відкидаєш усіх, хто ухиляється від постанов Твоїх,","poem":1},{"text":"бо хитрощі їхні – неправда.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Немов золу, відкинеш Ти усіх нечестивців землі;","poem":1},{"text":"тому я полюбив одкровення Твої.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Тремтить від страху перед Тобою тіло моє,","poem":1},{"text":"і судів Твоїх я боюся.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Я чинив правосудно й справедливо, –","poem":1},{"text":"не залишай же мене на поталу моїм гнобителям.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Заступися за слугу Свого на добро,","poem":1},{"text":"не дай зухвалим пригнічувати мене.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Очі мої тануть, чекаючи на Твій порятунок","poem":1},{"text":"і на слова Твоєї правди.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Вчини з рабом Своїм за милістю Твоєю","poem":1},{"text":"й навчи мене постанов Своїх.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Я – слуга Твій, настав мене,","poem":1},{"text":"і я пізнаю одкровення Твої.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Час діяти, Господи:","poem":1},{"text":"Законом Твоїм знехтували.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Тому полюбив я заповіді Твої","poem":1},{"text":"більше від золота, щирого золота;","poem":2}]},{"type":"verse","number":128,"content":[{"text":"тому всі настанови Твої визнаю справедливими,","poem":1},{"text":"а всіляку стежку неправди ненавиджу.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Дивовижні одкровення Твої,","poem":1},{"text":"тому душа моя береже їх.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Розкриття Твоїх слів просвітлює,","poem":1},{"text":"напоумлює простих.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Уста свої розкриваю й прагну,","poem":1},{"text":"бо жадаю заповідей Твоїх.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Обернися до мене й змилуйся,","poem":1},{"text":"як зазвичай поводишся Ти справедливо","poem":2},{"lineBreak":true},{"text":"з тими, хто любить ім’я Твоє.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Зміцни мої стопи словом Твоїм","poem":1},{"text":"і не дай жодному беззаконню оволодіти мною.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Визволи мене від гноблення людського,","poem":1},{"text":"і я дотримуватися буду настанов Твоїх.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Обличчям Своїм осяй слугу Твого","poem":1},{"text":"й навчи мене постанов Твоїх.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Потоками водними течуть мої очі,","poem":1},{"text":"бо не дотримуються Закону Твого.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Праведний Ти, Господи,","poem":1},{"text":"і справедливі суди Твої.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Одкровення, заповідані Тобою,","poem":1},{"text":"досконало справедливі й істинні.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Знесилився я через ревність мою,","poem":1},{"text":"бо забули мої супротивники слова Твої.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Слово Твоє випробуване досконало,","poem":1},{"text":"і слуга Твій любить його.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Я нікчемний і зганьблений,","poem":1},{"text":"але настанов Твоїх не забуваю.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Правда Твоя – правда вічна,","poem":1},{"text":"і Закон Твій – істина.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Тіснота й скорбота спіткали мене,","poem":1},{"text":"але заповіді Твої – втіха моя.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Правда одкровень Твоїх вічна,","poem":1},{"text":"напоум мене, і я житиму.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Я кличу всім серцем – дай мені відповідь, Господи,","poem":1},{"text":"і я буду дотримуватися постанов Твоїх.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Я кличу Тебе, врятуй мене,","poem":1},{"text":"і я буду дотримуватись одкровень Твоїх.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Перед ранковими сутінками волаю я,","poem":1},{"text":"на слово Твоє сподіваюся.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Випереджають очі мої ранкову сторожу,","poem":1},{"noteId":210},{"text":"щоб роздумувати над словом Твоїм.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Почуй мій голос заради милості Твоєї, Господи,","poem":1},{"text":"відповідно до справедливого суду Твого оживи мене.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Наблизилися до мене зловмисники,","poem":1},{"text":"та від Закону Твого віддалилися.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Ти ж близько, Господи,","poem":1},{"text":"і всі заповіді Твої – істина.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Здавна знаю я про одкровення Твої,","poem":1},{"text":"що Ти їх встановив навіки.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Поглянь на приниження моє й визволи мене,","poem":1},{"text":"адже Закону Твого не забуваю я.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Вступися в судову тяганину мою й визволи мене,","poem":1},{"text":"оживи мене згідно зі словом Твоїм.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Далеке від нечестивців спасіння,","poem":1},{"text":"бо не шукають постанов Твоїх.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Щедроти Твої численні, Господи,","poem":1},{"text":"оживи мене відповідно до справедливого суду Твого.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Численні переслідувачі й супротивники мої,","poem":1},{"text":"але від одкровень Твоїх я не ухиляюся.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Дивлюся на відступників з огидою,","poem":1},{"text":"бо слова Твого вони не дотримують.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Подивися, як люблю я Твої настанови,","poem":1},{"text":"Господи, заради милості Твоєї оживи мене.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Сутність слів Твоїх – істина,","poem":1},{"text":"вічні справедливі закони правосуддя Твого.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Князі переслідують мене безвинно,","poem":1},{"text":"але серце моє боїться Твого слова.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Радію я слову Твоєму,","poem":1},{"text":"наче спіткав здобич велику.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Я ненавиджу неправду, бриджуся нею,","poem":1},{"text":"Закон же Твій люблю.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Сім разів на день прославляю Тебе","poem":1},{"text":"за справедливі суди Твої.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Великий мир у тих, хто любить Закон Твій,","poem":1},{"text":"немає в них спотикання.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Очікую спасіння Твого, Господи,","poem":1},{"text":"і виконую заповіді Твої.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Душа моя береже одкровення Твої","poem":1},{"text":"і любить їх дуже.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Я дотримуюсь настанов і одкровень Твоїх,","poem":1},{"text":"бо всі дороги мої перед Тобою.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Нехай наблизиться волання моє до обличчя Твого, Господи,","poem":1},{"text":"дай мені розуміння, що відповідає слову Твоєму.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Нехай прийде благання моє перед обличчя Твоє,","poem":1},{"text":"визволи мене за словом Твоїм.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Переливатимуться вуста мої хвалою,","poem":1},{"text":"коли Ти навчиш мене постанов Своїх.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Проголошуватиме язик мій слово Твоє,","poem":1},{"text":"бо всі заповіді Твої – справедливі.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Нехай рука Твоя буде мені допомогою,","poem":1},{"text":"адже я обрав Твої настанови.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Я прагну спасіння Твого, Господи,","poem":1},{"text":"і Закон Твій – втіха моя.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Нехай живе душа моя й прославляє Тебе","poem":1},{"text":"і нехай допоможуть мені Твої закони правосуддя.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Заблукав я, немов вівця загублена.","poem":1},{"text":"Шукай слугу Свого, адже заповідей Твоїх я не забув.","poem":2}]}],"footnotes":[{"noteId":207,"caller":"+","text":"Буквально: серце моє.","reference":{"chapter":118,"verse":32}},{"noteId":208,"caller":"+","text":"Або: завжди в небезпеці.","reference":{"chapter":118,"verse":109}},{"noteId":209,"caller":"+","text":"Буквально: розділених.","reference":{"chapter":118,"verse":113}},{"noteId":210,"caller":"+","text":"У давнину нічний час поділявся на три сторожі відповідно до трьох змін варти на міських мурах: від заходу сонця до півночі, від півночі до глибокої ночі, від глибокої ночі до світанку (ранкова сторожа).","reference":{"chapter":118,"verse":148}}]},"thisChapterLink":"/api/ukr_npu/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":176}