{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Доки, Господи? Невже Ти забув мене навіки?","poem":1},{"text":"Доки ховатимеш обличчя Своє від мене?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Доки тяжкі роздуми носитиму я в душі своїй","poem":1},{"text":"і муку в серці своєму день у день?","poem":2},{"lineBreak":true},{"text":"Доки величатиметься ворог мій наді мною?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Зглянься ж, дай мені відповідь, Господи, Боже мій!","poem":1},{"text":"Очі мої просвіти,","poem":2},{"lineBreak":true},{"text":"щоб сном смертним я не заснув,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"щоб не говорив мій ворог: «Я здолав його!»","poem":1},{"text":"Щоб не раділи супротивники мої, коли я похитнуся.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Я ж бо на милість Твою покладаю надію,","poem":1},{"text":"радітиме серце моє через порятунок, посланий Тобою,","poem":2},{"text":"співатиму я Господеві,","poem":1},{"text":"бо Він виявив до мене прихильність.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}