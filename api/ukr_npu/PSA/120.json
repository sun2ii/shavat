{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження.","descriptive":true},{"text":"Зводжу очі свої на гори –","poem":1},{"text":"звідки ж прийде мені допомога?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Допомога моя від Господа,","poem":1},{"text":"Творця небес і землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Він не дасть захитатися нозі твоїй,","poem":1},{"text":"не задрімає Той, Хто береже тебе.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Так, не задрімає й не засне","poem":1},{"text":"Той, Хто стереже Ізраїля.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Господь – сторож твій;","poem":1},{"text":"Господь – тінь твоя по правиці твоїй.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Сонце не вразить тебе вдень,","poem":1},{"text":"ані місяць – вночі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Господь оберігатиме тебе від усякого зла;","poem":1},{"text":"Господь стерегтиме душу твою.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Господь оберігатиме тебе,","poem":1},{"text":"коли ти будеш виходити й входити,","poem":2},{"text":"віднині й навіки.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}