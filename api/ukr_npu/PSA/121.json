{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження Давидова.","descriptive":true},{"text":"Зрадів я, коли мені сказали:","poem":1},{"text":"«Ходімо до дому Господнього!»","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Наші ноги стоять","poem":1},{"text":"у воротах твоїх, Єрусалиме.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Єрусалиме, що збудований щільно","poem":1},{"text":"як місто, з’єднане в одне ціле,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"куди піднімаються племена, Господні племена,","poem":1},{"text":"згідно з одкровенням, даним Ізраїлю,","poem":2},{"lineBreak":true},{"text":"щоб прославляти там ім’я Господа.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Бо там стоять престоли судні,","poem":1},{"text":"престоли дому Давидового.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Просіть миру для Єрусалима:","poem":1},{"text":"«Нехай у добробуті живуть ті, хто любить тебе!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Нехай мир буде в укріпленнях твоїх","poem":1},{"text":"і добробут – у палацах твоїх!»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Заради братів моїх і друзів","poem":1},{"text":"скажу я: «Мир тобі!»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Заради дому Господа, Бога нашого,","poem":1},{"text":"я щиро бажатиму тобі добра, Єрусалиме!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":9}