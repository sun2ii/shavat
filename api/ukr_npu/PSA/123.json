{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження Давидова.","descriptive":true},{"text":"Якби не був із нами Господь, –","poem":1},{"text":"нехай скаже Ізраїль, –","poem":2}]},{"type":"verse","number":2,"content":[{"text":"якби не був із нами Господь,","poem":1},{"text":"коли повстали проти нас люди,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"то вони живцем поглинули б нас,","poem":1},{"text":"коли на нас спалахнув їхній гнів.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Тоді води потопили б нас,","poem":1},{"text":"потік пройшов би над нашою душею;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"тоді пронеслися б над нашою душею води бурхливі.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Благословенний Господь,","poem":1},{"text":"Який не дав нас на здобич ненависникам нашим!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Душа наша, мов птах, що звільнився з сильця ловців:","poem":1},{"text":"тенета розірвалися, а ми визволені!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Допомога наша – в імені Господа,","poem":1},{"text":"Творця небес і землі.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}