{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження.","descriptive":true},{"text":"Ті, хто надію покладає на Господа, – немов гора Сіон,","poem":1},{"text":"яка не захитається, але повік перебуває.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Як гори навколо Єрусалима,","poem":1},{"text":"так Господь навколо Свого народу","poem":2},{"text":"віднині й повіки.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Не спочине жезл нечестивих","poem":1},{"text":"над долею праведних,","poem":2},{"text":"щоб не простягнули праведні руки свої","poem":1},{"text":"до беззаконня.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господи, будь добрим до добрих","poem":1},{"text":"і справедливих у серцях своїх!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"А тих, хто блукає манівцями своїми,","poem":1},{"text":"нехай полишить Господь ходити разом із тим,","poem":2},{"lineBreak":true},{"text":"хто чинить беззаконня.","poem":2},{"lineBreak":true},{"text":"Мир над Ізраїлем!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":5}