{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження.","descriptive":true},{"text":"Блаженний той, хто боїться Господа,","poem":1},{"text":"хто ходить Його шляхами.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ти їстимеш плоди праці рук своїх;","poem":1},{"text":"блаженний ти і добре тобі!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Дружина твоя – немов плодовита лоза","poem":1},{"text":"в покоях твого дому,","poem":2},{"text":"діти твої – як віття олив","poem":1},{"text":"навколо твого столу.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ось так благословенний буде муж,","poem":1},{"text":"що боїться Господа.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Нехай благословить тебе Господь із Сіону,","poem":1},{"text":"щоб ти міг бачити процвітання","poem":2},{"noteId":216},{"text":"Єрусалима","poem":2},{"lineBreak":true},{"text":"в усі дні життя свого","poem":2}]},{"type":"verse","number":6,"content":[{"text":"і щоб побачив ти синів своїх синів.","poem":1},{"text":"Мир над Ізраїлем!","poem":2}]}],"footnotes":[{"noteId":216,"caller":"+","text":"Буквально: добро Єрусалима.","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/ukr_npu/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":6}