{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження.","descriptive":true},{"text":"Досить пригнічували мене ще з юності, –","poem":1},{"text":"нехай скаже Ізраїль, –","poem":2}]},{"type":"verse","number":2,"content":[{"text":"досить пригнічували мене ще з юності,","poem":1},{"text":"та не здолали мене!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"На спині моїй орали орачі,","poem":1},{"text":"протягнули свої довгі борозни.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Господь праведний:","poem":1},{"text":"Він розсік пута нечестивців.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Нехай осоромляться й назад відсахнуться","poem":1},{"text":"всі, хто ненавидить Сіон.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Нехай стануть вони, як трава на даху,","poem":1},{"text":"що засихає, перш ніж виросте,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"якою жнець не наповнить долоні своєї,","poem":1},{"text":"і той, хто снопи в’яже, не візьме її оберемком.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"І не скажуть перехожі:","poem":1},{"text":"«Благословення Господнього вам!","poem":2},{"lineBreak":true},{"text":"Благословляємо вас іменем Господа!»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}