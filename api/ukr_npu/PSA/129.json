{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження.","descriptive":true},{"text":"Із глибин кличу я до Тебе, Господи.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Володарю, почуй же мій голос,","poem":2},{"text":"нехай схиляться вуха Твої до голосу благання мого!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Якщо беззаконня Ти, Господи, пильнуватимеш,","poem":1},{"text":"хто ж встояти зможе, Владико?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Але в Тебе прощення,","poem":1},{"text":"щоб мали страх перед Тобою.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Я покладаю надію на Господа, надію має душа моя,","poem":1},{"text":"і на слово Його сподіваюся.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Душа моя на Владику чекає","poem":1},{"text":"більше, ніж сторожа ранку,","poem":2},{"text":"так, більше, ніж сторожа ранку!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Нехай Ізраїль сподівається на Господа,","poem":1},{"text":"адже в Господа милість","poem":2},{"lineBreak":true},{"text":"і велике визволення – у Нього.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"І Він визволить Ізраїля","poem":1},{"text":"від усіх його беззаконь.","poem":2},{"noteId":217}]}],"footnotes":[{"noteId":217,"caller":"+","text":"Див. Мт. 1:21.","reference":{"chapter":129,"verse":8}}]},"thisChapterLink":"/api/ukr_npu/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}