{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Давидів.","descriptive":true},{"text":"Промовив безумний","poem":1},{"noteId":22},{"text":"у своєму серці: «Немає Бога».","poem":1},{"text":"Розбестились вони,","poem":2},{"text":"огидними стали їхні вчинки,","poem":1},{"text":"немає нікого, хто б чинив добро.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Господь із небес поглядає на синів людських,","poem":1},{"text":"щоб побачити, чи є серед них розумний,","poem":2},{"lineBreak":true},{"text":"що шукає Бога.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Усі як один вони збочили з дороги,","poem":1},{"text":"зіпсувалися;","poem":2},{"text":"немає того, хто робив би добро,","poem":1},{"text":"жодного немає.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Невже не схаменуться всі ті, хто чинить беззаконня,","poem":1},{"text":"хто пожирає народ мій, немов хліб,","poem":2},{"lineBreak":true},{"text":"хто Господа не кличе?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Там, на шляху їхньому, охопить їх страх,","poem":1},{"text":"адже Бог серед праведного роду.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ви глузуєте зі сподівань пригнобленого,","poem":1},{"text":"але Господь – його притулок.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"О, хто дав би із Сіону порятунок Ізраїлеві!","poem":1},{"text":"Коли Господь поверне з полону народ Свій,","poem":2},{"text":"веселитиметься Яків, радітиме Ізраїль!","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Або: навіжений, нестриманий, буйний (Див. Повт. 32:6; 2 Сам. 3:33; Єз. 13:3).","reference":{"chapter":13,"verse":1}}]},"thisChapterLink":"/api/ukr_npu/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":7}