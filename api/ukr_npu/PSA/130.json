{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження Давидова.","descriptive":true},{"text":"Господи, не гордилося серце моє,","poem":1},{"text":"і не підносилися очі мої,","poem":2},{"text":"не втручався я у великі","poem":1},{"text":"й недосяжні для мене дива.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Хіба не втихомирював і не заспокоював я душі своєї,","poem":1},{"text":"немов немовля, від грудей матері відлучене?","poem":2},{"lineBreak":true},{"text":"Як відлучене від грудей немовля – душа моя в мені.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Нехай Ізраїль сподівається на Господа","poem":1},{"text":"віднині й повіки!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":3}