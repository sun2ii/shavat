{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня сходження.","descriptive":true},{"text":"Згадай, Господи, Давида","poem":1},{"text":"й усі смирення його,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"коли він присягнув Господеві,","poem":1},{"text":"дав обітницю Могутньому Богові Якова:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"«Не увійду в шатро свого дому,","poem":1},{"text":"не ляжу на постіль мого ложа,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"не дам сну очам моїм","poem":1},{"text":"і повікам моїм дрімання,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"аж поки не знайду місця для Господа,","poem":1},{"text":"помешкання для Могутнього Якового Бога».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ось ми чули про нього в Ефраті,","poem":1},{"text":"знайшли його на полях Яара.","poem":2},{"noteId":218}]},{"type":"verse","number":7,"content":[{"text":"Підійдімо ж до Його помешкання,","poem":1},{"text":"вклонімося біля Його підніжжя.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Повстань, Господи, прийди до місця Свого спокою,","poem":1},{"text":"Ти й ковчег могутності Твоєї.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Священники Твої нехай зодягнуться правдою","poem":1},{"text":"і вірні Твої нехай радісно співають.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Заради Давида, слуги Свого,","poem":1},{"text":"не відвертай обличчя від Твого помазанця.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Істинно присягався Господь Давидові,","poem":1},{"text":"не зречеться Він цього:","poem":2},{"text":"«Нащадка від плоду утроби твоєї","poem":1},{"text":"посаджу на свій престол.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Якщо дотримуватися будуть сини твої Завіту Мого","poem":1},{"text":"й одкровень Моїх, яких Я навчу їх,","poem":2},{"text":"то й сини їхні повік-віків","poem":1},{"text":"на престолі твоїм сидітимуть».","poem":2},{"noteId":219}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Адже обрав Господь Сіон,","poem":1},{"text":"уподобав мешкати на ньому:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«Це місце спочинку Мого на віки вічні,","poem":1},{"text":"тут мешкати буду, бо Я вподобав його.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Щедро благословлю його їжею,","poem":1},{"text":"бідняків його насичу хлібом.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Священників його зодягну спасінням,","poem":1},{"text":"а вірні його будуть радісно співати.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Там Я дам розростися рогові Давидовому,","poem":1},{"text":"встановлю світильника Моєму помазанцеві.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ворогів його зодягну соромом,","poem":1},{"text":"а на ньому сяятиме вінок його».","poem":2}]}],"footnotes":[{"noteId":218,"caller":"+","text":"про нього, тобто про ковчег заповіту; Ефрата – місцевість поблизу Віфлеєма (Див. Бут. 35:16; 48:7; Рут. 4:11), Яар – імовірно, скорочена назва Кір’ят-Йеаріма, де зупинився віз із ковчегом заповіту йде ковчег перебував 20 років; Див. 1 Сам. 7:2.","reference":{"chapter":131,"verse":6}},{"noteId":219,"caller":"+","text":"Див. 2 Сам. 7:11-16.","reference":{"chapter":131,"verse":12}}]},"thisChapterLink":"/api/ukr_npu/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":18}