{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":134,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Хваліть ім’я Господа!","poem":1},{"text":"Хваліть, слуги Господні,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"що стоять у домі Господньому,","poem":1},{"text":"у дворах дому Бога нашого!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Хваліть Господа, бо добрий Господь;","poem":1},{"text":"співайте імені Його, бо це приємно,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"адже Господь вибрав Собі Якова,","poem":1},{"text":"Ізраїля – як власність для Себе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Бо пізнав я, що великий Господь","poem":1},{"text":"і Володар наш вищий від усіх богів.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Усе, що бажає Господь, Він робить","poem":1},{"text":"на небесах і на землі,","poem":2},{"lineBreak":true},{"text":"у морях і в усіх безоднях океану.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Піднімає хмари від краю землі,","poem":1},{"text":"творить блискавки з дощем,","poem":2},{"lineBreak":true},{"text":"виводить вітер зі Своїх сховищ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Він вразив первістків Єгипту,","poem":1},{"text":"від людини до худоби.","poem":2},{"noteId":221}]},{"type":"verse","number":9,"content":[{"text":"Послав знамення й чудеса посеред тебе, о Єгипте,","poem":1},{"text":"на фараона й на всіх його слуг.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Він вразив численні народи","poem":1},{"text":"й убив могутніх царів:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Сіхона, царя аморейського,","poem":1},{"text":"Оґа, царя Башану,","poem":2},{"lineBreak":true},{"text":"і всі царства Ханаану,","poem":2},{"noteId":222}]},{"type":"verse","number":12,"content":[{"text":"і віддав землі їхні у спадок,","poem":1},{"text":"у спадок народові Своєму, Ізраїлеві.","poem":2},{"noteId":223}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Господи, ім’я Твоє – навіки;","poem":1},{"text":"Господи, пам’ять про Тебе – з роду в рід.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Адже судитиме Господь народ Свій","poem":1},{"text":"і змилується над рабами Своїми.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ідоли народів – лише срібло й золото,","poem":1},{"text":"витвір рук людських.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Є в них вуста, але вони не говорять;","poem":1},{"text":"у них є очі, але вони не бачать;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"у них є вуха, але вони не чують,","poem":1},{"text":"і немає дихання в устах їхніх.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Подібними до них нехай стануть ті,","poem":1},{"text":"хто їх робить, усі, хто на них надію покладає.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Доме Ізраїлів, благослови Господа!","poem":1},{"text":"Доме Ааронів, благослови Господа!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Доме Левіїв, благослови Господа!","poem":1},{"text":"Ті, хто Господа боїться, благословіть Господа!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Благословенний із Сіону Господь,","poem":1},{"text":"Який мешкає в Єрусалимі!","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[{"noteId":221,"caller":"+","text":"Див. Вих. 11.","reference":{"chapter":134,"verse":8}},{"noteId":222,"caller":"+","text":"Див. Чис. 21:21-35.","reference":{"chapter":134,"verse":11}},{"noteId":223,"caller":"+","text":"Див. Чис. 21:21-35; Іс. Нав. 12.","reference":{"chapter":134,"verse":12}}]},"thisChapterLink":"/api/ukr_npu/PSA/134.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/135.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/133.json","previousChapterAudioLinks":{},"numberOfVerses":21}