{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Славте Господа, бо Він добрий,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Славте Бога над богами,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Славте Владику над владиками,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Того, Хто лише один здійснює чудеса великі,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Того, Хто створив небеса розумно,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Того, Хто розкинув землю над водами,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Того, Хто створив світила великі,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"сонце, щоб панувати над днем,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"місяць і зорі, щоб керувати ніччю,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Він вразив Єгипет через його первістків,","poem":1},{"text":"бо навіки Його милість;","poem":2},{"noteId":224}]},{"type":"verse","number":11,"content":[{"text":"і вивів Ізраїля з-поміж них,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"рукою сильною й плечем простягнутим,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Того, Хто Море Червоне розділив навпіл,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"і провів Ізраїля посеред нього,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"але жбурнув фараона й військо його в Море Червоне,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Він провів народ Свій через пустелю,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Він вразив великих царів,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"убив могутніх царів,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Сіхона, царя аморейського,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"й Оґа, царя Башану,","poem":1},{"text":"бо навіки Його милість;","poem":2},{"noteId":225}]},{"type":"verse","number":21,"content":[{"text":"і віддав їхню землю у спадок,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"у спадок Ізраїлеві, слузі Своєму,","poem":1},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Того, Хто згадав нас у приниженні нашому,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"і визволив нас від супротивників наших,","poem":1},{"text":"бо навіки Його милість;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Того, Хто дає їжу всьому живому,","poem":1},{"noteId":226},{"text":"бо навіки Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Славте Бога небес,","poem":1},{"text":"бо навіки Його милість.","poem":2}]}],"footnotes":[{"noteId":224,"caller":"+","text":"Див. Вих. 11.","reference":{"chapter":135,"verse":10}},{"noteId":225,"caller":"+","text":"Див. Чис. 21:21-35.","reference":{"chapter":135,"verse":20}},{"noteId":226,"caller":"+","text":"Буквально: всякій плоті.","reference":{"chapter":135,"verse":25}}]},"thisChapterLink":"/api/ukr_npu/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":26}