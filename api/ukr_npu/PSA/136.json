{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Біля річок Вавилона, там сиділи ми й плакали,","poem":1},{"text":"згадуючи Сіон.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"На вербах посеред міста","poem":1},{"text":"ми повісили наші арфи,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"бо там поневолювачі наші просили від нас слів пісні","poem":1},{"text":"й гнобителі наші вимагали від нас радості:","poem":2},{"lineBreak":true},{"text":"«Заспівайте нам одну з пісень Сіону!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Як можемо ми пісню Господню","poem":1},{"text":"на землі чужій співати?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Якщо я забуду тебе, Єрусалиме,","poem":1},{"text":"нехай забуде правиця моя рухи свої.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Нехай прилипне язик мій до піднебіння,","poem":1},{"text":"якщо я не пам’ятатиму тебе,","poem":2},{"text":"якщо я не піднесу Єрусалима","poem":1},{"text":"як найвищу радість мою.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Нагадай, Господи, синам Едомовим","poem":1},{"text":"день захоплення Єрусалима,","poem":2},{"text":"коли вони говорили: «Руйнуйте,","poem":1},{"text":"руйнуйте його до самих підвалин!»","poem":2},{"noteId":227}]},{"type":"verse","number":8,"content":[{"text":"Донько Вавилона, приречена на спустошення,","poem":1},{"text":"блаженний той, хто віддасть тобі за те,","poem":2},{"lineBreak":true},{"text":"що ти накоїла нам!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Блаженний той, хто схопить","poem":1},{"text":"і розіб’є об скелю твоїх немовлят!","poem":2}]}],"footnotes":[{"noteId":227,"caller":"+","text":"Буквально: Оголюйте, оголюйте її (доньку Сіону, Єрусалим) до самих основ!","reference":{"chapter":136,"verse":7}}]},"thisChapterLink":"/api/ukr_npu/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":9}