{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Буду славити Тебе всім серцем своїм,","poem":1},{"text":"співатиму Тобі перед богами","poem":2},{"noteId":228},{"text":".","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Поклонюся перед Храмом святині Твоєї","poem":1},{"text":"і прославлю ім’я Твоє","poem":2},{"text":"за милість Твою й істину,","poem":1},{"text":"бо звеличив Ти понад усе","poem":2},{"text":"ім’я Твоє й Слово Твоє.","poem":3},{"noteId":229}]},{"type":"verse","number":3,"content":[{"text":"Того дня, коли я кликав Тебе, Ти відповів мені,","poem":1},{"text":"розбудив у душі моїй силу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Прославлять Тебе, Господи, усі царі земні,","poem":1},{"text":"коли почують слова вуст Твоїх,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"і будуть оспівувати дороги Господні,","poem":1},{"text":"бо велика слава Господа.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Хоч високо Господь, але бачить смиренного","poem":1},{"text":"й гордого впізнає здалека.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Навіть якщо я йтиму серед скорботи,","poem":1},{"text":"Ти оживиш мене,","poem":2},{"text":"простягнеш руку Твою проти гніву ворогів моїх,","poem":1},{"text":"і врятує мене правиця Твоя.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Господь здійснить правосуддя для мене.","poem":1},{"text":"Милість Твоя, Господи, повіки:","poem":2},{"lineBreak":true},{"text":"не полишай того, що зробили руки Твої.","poem":2}]}],"footnotes":[{"noteId":228,"caller":"+","text":"Слово боги може означати не тільки язичницьких богів, але й ангелів або суддів; Див. Вих. 21:6; Пс. 81:1.","reference":{"chapter":137,"verse":1}},{"noteId":229,"caller":"+","text":"Або: бо звеличив Ти понад усяке ім’я Твоє Слово – так у грецькому (Септуаґінта) та сирійському (Пешитта) перекладах.","reference":{"chapter":137,"verse":2}}]},"thisChapterLink":"/api/ukr_npu/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":8}