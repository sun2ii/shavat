{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":139,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Врятуй мене, Господи, від людини злої,","poem":1},{"text":"оберігай мене від насильників,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"які зло задумують у серці,","poem":1},{"text":"щодня збурюють війни.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Гострять язики свої, наче змії;","poem":1},{"text":"отрута аспидова на губах у них. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Оберігай мене, Господи, від рук нечестивця,","poem":1},{"text":"врятуй мене від насильників,","poem":2},{"lineBreak":true},{"text":"що задумали похитнути мої стопи.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Горді приховали пастку й мотузки для мене,","poem":1},{"text":"розтягнули сіті вздовж стежки,","poem":2},{"lineBreak":true},{"text":"розставили мені тенета.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Я сказав Господеві: «Ти – мій Бог!","poem":1},{"text":"Почуй, Господи, голос мого благання!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Господи, Владико, сило спасіння мого,","poem":1},{"text":"Ти прикрив голову мою в день битви.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Не дай, Господи, нечестивому того, що він бажає,","poem":1},{"text":"не дай здійснитися його задуму,","poem":2},{"text":"бо він загордиться». Села","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Голови тих, хто оточив мене,","poem":1},{"text":"нехай накриє лихо їхніх вуст.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нехай впаде на них розжарене вугілля,","poem":1},{"text":"нехай будуть вкинуті у вогонь,","poem":2},{"lineBreak":true},{"text":"у провалля бездонне, щоб не встали більше.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Людина зі злим язиком не утвердиться на землі;","poem":1},{"text":"насильника нехай вполює зло йому на погибель.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Я знаю, що Господь здійснить суд бідному,","poem":1},{"text":"вчинить правосуддя пригнобленому.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Так, прославлятимуть праведні ім’я Твоє,","poem":1},{"text":"житимуть справедливі перед обличчям Твоїм!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":14}