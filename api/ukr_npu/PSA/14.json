{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Господи, хто може мешкати у Твоєму наметі?","poem":1},{"text":"Хто житиме на Твоїй святій горі?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Той, хто ходить бездоганно життєвим шляхом","poem":1},{"text":"і хто чинить правду;","poem":2},{"lineBreak":true},{"text":"хто істину говорить у своєму серці","poem":2}]},{"type":"verse","number":3,"content":[{"text":"і наклепів язиком своїм не зводить;","poem":1},{"text":"не чинить зла ближньому своєму","poem":2},{"lineBreak":true},{"text":"і нічого ганебного на свого ближнього не намовляє;","poem":2},{"noteId":23}]},{"type":"verse","number":4,"content":[{"text":"очима своїми він не гляне на негідника,","poem":1},{"noteId":24},{"text":"але тих, хто Господа боїться, шанує;","poem":2},{"lineBreak":true},{"text":"навіть коли він склав собі присягу на збиток,","poem":2},{"lineBreak":true},{"text":"то не змінить свого слова.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Срібла свого він на лихву не позичає","poem":1},{"text":"і хабара проти невинного на суді не бере.","poem":2},{"lineBreak":true},{"text":"Хто чинить усе це,","poem":1},{"text":"той повіки не захитається.","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"У грецькому та сирійському текстах: не приймає.","reference":{"chapter":14,"verse":3}},{"noteId":24,"caller":"+","text":"Буквально: Негідник знехтуваний в очах його.","reference":{"chapter":14,"verse":4}}]},"thisChapterLink":"/api/ukr_npu/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":5}