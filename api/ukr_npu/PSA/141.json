{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"Роздуми Давидові, коли він був у печері.","descriptive":true},{"noteId":232},{"text":"Молитва.","descriptive":true},{"text":"Голосно до Господа волаю,","poem":1},{"text":"голосно Господа благаю.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Виливаю перед Ним скаргу мою,","poem":1},{"text":"розповів Йому про скорботу свою.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Коли знемагав у мені дух,","poem":1},{"text":"Ти знав стежину мою.","poem":2},{"text":"На дорозі, якою я йшов,","poem":1},{"text":"вони сховали для мене пастку.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Поглянь, Господи, праворуч і побач:","poem":1},{"text":"ніхто не впізнає мене,","poem":2},{"text":"загинув притулок мій,","poem":1},{"text":"нікому немає діла до душі моєї.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"До Тебе волаю я, Господи,","poem":1},{"text":"кажучи: «Ти – пристановище моє,","poem":2},{"lineBreak":true},{"text":"доля моя на землі живих».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Прислухайся до волання мого,","poem":1},{"text":"бо знемігся я дуже;","poem":2},{"text":"визволи мене від моїх переслідувачів,","poem":1},{"text":"адже вони сильніші за мене.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Виведи з в’язниці душу мою,","poem":1},{"text":"щоб прославити мені ім’я Твоє.","poem":2},{"text":"Зберуться праведні довкола мене,","poem":1},{"text":"коли Ти мені віддячиш.","poem":2}]}],"footnotes":[{"noteId":232,"caller":"+","text":"Див. 1 Цар. 22:1-2.","reference":{"chapter":141,"verse":1}}]},"thisChapterLink":"/api/ukr_npu/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":7}