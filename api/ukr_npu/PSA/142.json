{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Господи, почуй мою молитву,","poem":1},{"text":"прислухайся до благань моїх.","poem":2},{"text":"Заради вірності й праведності Своєї","poem":1},{"text":"дай мені відповідь.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Не судися з рабом Своїм,","poem":1},{"text":"бо ніхто із живих не виправдається перед Тобою.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Бо ворог переслідує душу мою,","poem":1},{"text":"втоптав у землю моє життя,","poem":2},{"text":"змусив мене мешкати в темних закутках,","poem":1},{"text":"подібно до померлих навіки.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Знемігся в мені дух мій,","poem":1},{"text":"скам’яніло в мені серце моє.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Я згадую дні прадавні,","poem":1},{"text":"роздумую про всі діяння Твої,","poem":2},{"lineBreak":true},{"text":"споглядаю те, що зробили руки Твої.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Простягаю руки свої до Тебе;","poem":1},{"text":"душа моя, як виснажена земля, Тебе прагне. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Поспіши відповісти мені, Господи,","poem":1},{"text":"бо знемагає мій дух.","poem":2},{"text":"Не ховай обличчя Твого від мене,","poem":1},{"text":"бо стану я подібним до тих, хто сходить до прірви.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Дай мені почути вранці про милість Твою,","poem":1},{"text":"адже на Тебе я надію покладаю.","poem":2},{"text":"Покажи мені дорогу, якою мені йти,","poem":1},{"text":"адже до Тебе я підношу душу мою.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Визволи мене від ворогів моїх, Господи,","poem":1},{"text":"бо біля Тебе я шукаю притулок.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Навчи мене виконувати волю Твою,","poem":1},{"text":"адже Ти – Бог мій.","poem":2},{"text":"Дух Твій добрий нехай веде мене","poem":1},{"text":"по рівній землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Заради імені Твого, Господи, оживи мене;","poem":1},{"text":"заради праведності Твоєї виведи душу мою зі скорботи.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"За милістю Своєю знищ ворогів моїх","poem":1},{"text":"і вигуби всіх, хто пригнічує мою душу,","poem":2},{"text":"адже я слуга Твій.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":12}