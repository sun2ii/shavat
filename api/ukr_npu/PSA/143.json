{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Благословенний Господь, скеля моя,","poem":1},{"text":"Що привчає руки мої до битви","poem":2},{"lineBreak":true},{"text":"й пальці мої – до війни.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Він – милість моя, твердиня моя,","poem":1},{"text":"пристановище моє й визволитель мій,","poem":2},{"text":"щит мій, на Нього я надію покладаю;","poem":1},{"text":"Він підкорює мені народ мій.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Господи, хто така людина, що Ти знаєш про неї,","poem":1},{"text":"і син людський, що Ти думаєш про нього?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Людина – немов подих вітру;","poem":1},{"text":"дні її – немов тінь, що минає.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Господи, нахили небеса і зійди,","poem":1},{"text":"торкнися гір – і вони задимляться.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Блисни блискавкою й розсій їх,","poem":1},{"text":"випусти стріли Свої й нажахай їх.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Простягни руку Твою з висоти,","poem":1},{"text":"визволи мене й врятуй від великих вод,","poem":2},{"lineBreak":true},{"text":"від рук чужинців,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"що вустами своїми марне промовляють","poem":1},{"text":"і чия правиця діє неправедно.","poem":2},{"noteId":233}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Боже, пісню нову заспіваю Тобі,","poem":1},{"text":"на лірі десятиструнній Тобі заграю –","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Тому, Хто дає перемогу царям,","poem":1},{"text":"визволяє Давида, слугу Свого,","poem":2},{"lineBreak":true},{"text":"від лютого меча.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Визволи мене й врятуй","poem":1},{"text":"від рук чужинців,","poem":2},{"text":"що вустами своїми марне промовляють","poem":1},{"text":"і чия правиця діє неправедно.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Тоді будуть сини наші","poem":1},{"text":"немов молоді пагони, що розрослися,","poem":2},{"text":"а наші доньки – наче різьблені колони","poem":1},{"text":"майстерно збудованого палацу;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"комори будуть повні","poem":1},{"text":"різноманітним збіжжям;","poem":2},{"text":"дрібної худоби нашої будуть тисячі,","poem":1},{"text":"десятки тисяч на пасовищах наших;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"бики наші будуть витривалими;","poem":1},{"text":"не буде ні пролому в стіні, ні виходу в полон,","poem":2},{"lineBreak":true},{"text":"ані зойку на вулицях наших.","poem":2},{"noteId":234}]},{"type":"verse","number":15,"content":[{"text":"Блаженний народ, що так йому ведеться;","poem":1},{"text":"блаженний народ, чий Бог – Господь!","poem":2}]}],"footnotes":[{"noteId":233,"caller":"+","text":"Буквально: чия правиця – правиця неправди.","reference":{"chapter":143,"verse":8}},{"noteId":234,"caller":"+","text":"Або: не буде ні збитку, ані втрати.","reference":{"chapter":143,"verse":14}}]},"thisChapterLink":"/api/ukr_npu/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":15}