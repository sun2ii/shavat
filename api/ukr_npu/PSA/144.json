{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":144,"content":[{"type":"verse","number":1,"content":[{"text":"Хвала Давидова.","descriptive":true},{"text":"Величатиму Тебе, Боже мій, Царю,","poem":1},{"text":"і благословлятиму ім’я Твоє повік-віків","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Щодня благословлятиму Тебе","poem":1},{"text":"й хвалитиму ім’я Твоє повік-віків.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Великий Господь і вельми прославлений,","poem":1},{"text":"і велич Його – неосяжна.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Покоління поколінню хвалитиме діяння Твої","poem":1},{"text":"і про могутність Твою звіщатиме.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Про дивну славу величі Твоєї","poem":1},{"text":"й про чудові діяння Твої я роздумувати буду.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Коли говоритимуть про силу грізних діянь Твоїх,","poem":1},{"text":"і я звіщатиму про велич Твою.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"На згадку про велику доброту Твою будуть промовляти","poem":1},{"text":"й про праведність Твою радісно співатимуть.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Милостивий і милосердний Господь,","poem":1},{"text":"довготерпеливий і багатий милістю.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Добрий Господь до всіх,","poem":1},{"text":"і милосердя Його над усіма Його творіннями.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Прославлять Тебе, Господи, усі творіння Твої,","poem":1},{"text":"і вірні Твої благословлятимуть Тебе.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Про славу Царства Твого розповідатимуть","poem":1},{"text":"і про могутність Твою промовлятимуть,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"щоб звістити синам людським","poem":1},{"text":"про могутність Твою","poem":2},{"lineBreak":true},{"text":"і про славу величі Царства Твого.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Царство Твоє – царство на всі віки,","poem":1},{"text":"і панування Твоє – на всі покоління.","poem":2},{"lineBreak":true},{"text":"Вірний Господь словам Своїм","poem":1},{"text":"і праведний в усіх Своїх діяннях.","poem":2},{"noteId":235}]},{"type":"verse","number":14,"content":[{"text":"Господь підтримує усіх, хто падає,","poem":1},{"text":"і випростовує всіх зігнутих.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Очі всіх на Тебе звернені з надією,","poem":1},{"text":"і Ти даєш їм їжу своєчасно.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Відкриваєш руку Свою","poem":1},{"text":"й зичливо насичуєш усе живе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Праведний Господь в усіх Своїх дорогах","poem":1},{"text":"і милостивий в усіх Своїх діяннях.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Близький Господь до всіх, хто кличе Його,","poem":1},{"text":"до всіх, хто кличе Його істинно.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Бажання тих, хто боїться Його, Він здійснює,","poem":1},{"text":"благання їхні чує і дає їм порятунок.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Оберігає Господь усіх, хто любить Його,","poem":1},{"text":"а всіх нечестивих знищить.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Хвалу Господеві проголосять уста мої,","poem":1},{"text":"і благословлятиме усе живе","poem":2},{"noteId":236},{"lineBreak":true},{"text":"Його святе ім’я повік-віків!","poem":2}]}],"footnotes":[{"noteId":235,"caller":"+","text":"Цих двох рядків немає в більшості єврейських рукописів, проте вони є в одному рукописі з Кумрану, а також у грецькому (Септуаґінта) та сирійському (Пешитта) перекладах.","reference":{"chapter":144,"verse":13}},{"noteId":236,"caller":"+","text":"Буквально: кожна плоть.","reference":{"chapter":144,"verse":21}}]},"thisChapterLink":"/api/ukr_npu/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":21}