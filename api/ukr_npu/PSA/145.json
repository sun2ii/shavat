{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":145,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Хвали, душе моя, Господа!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Буду Господа хвалити все життя моє,","poem":1},{"text":"співатиму Богові моєму, поки живу.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Не покладайте надії на мужів шляхетних,","poem":1},{"text":"на людину, у якій немає порятунку.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Дух її виходить, і вона повертається в землю, –","poem":1},{"text":"у той же день зникають усі її задуми.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Блаженний той, чия допомога – Бог Яковів,","poem":1},{"text":"хто надію покладає на Господа, Бога свого,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Того, Хто створив небеса, землю,","poem":1},{"text":"море й усе, що наповнює його,","poem":2},{"lineBreak":true},{"text":"Хто вічно береже вірність Свою;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Того, Хто правосуддя чинить для пригнічених,","poem":1},{"text":"дає хліб голодним.","poem":2},{"lineBreak":true},{"text":"Господь звільняє в’язнів,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Господь відкриває очі сліпим,","poem":1},{"text":"Господь випростовує зігнутих,","poem":2},{"lineBreak":true},{"text":"Господь любить праведних.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Господь оберігає приходьків,","poem":1},{"text":"сироту й вдову підтримує,","poem":2},{"lineBreak":true},{"text":"а дорогу нечестивих викривлює.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Буде царювати Господь повіки,","poem":1},{"text":"Бог твій, Сіоне, – з роду в рід.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":10}