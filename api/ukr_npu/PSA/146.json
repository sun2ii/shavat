{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Як добре співати Богові нашому,","poem":1},{"text":"яка ж приємна належна Йому хвала!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Господь відбудовує Єрусалим,","poem":1},{"text":"збирає вигнанців Ізраїля;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"зцілює розбитих серцем","poem":1},{"text":"і перев’язує їхні рани;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"обчислює кількість зірок","poem":1},{"text":"і кожну називає поіменно.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Великий Володар наш і вельми сильний,","poem":1},{"text":"розум Його безмірний.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Господь підтримує пригноблених,","poem":1},{"text":"а нечестивих принижує аж до землі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Віддайте Господеві подяку,","poem":1},{"text":"співайте Богові нашому на арфі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Він небеса вкриває хмарами,","poem":1},{"text":"готуючи дощ для землі,","poem":2},{"lineBreak":true},{"text":"Хто на горах вирощує траву,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"дає худобі їжу","poem":1},{"text":"й пташенятам ворона, коли вони кричать.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Не міць коня Йому до вподоби,","poem":1},{"text":"не силу стегон людських Він уподобав;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Господь уподобав тих, хто боїться Його,","poem":1},{"text":"хто на милість Його сподівається.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":11}