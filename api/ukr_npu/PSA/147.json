{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Хвали, Єрусалиме, Господа;","poem":1},{"text":"прославляй Бога твого, Сіоне!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Бо Він зміцнив засуви воріт твоїх,","poem":1},{"text":"благословив синів твоїх посеред тебе.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Він встановлює мир на твоїх кордонах,","poem":1},{"text":"насичує тебе відбірною пшеницею.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Він посилає наказ Свій землі,","poem":1},{"text":"швидко біжить Його Слово.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Він дає сніг, немов вовну,","poem":1},{"text":"розпорошує паморозь, наче попіл,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"кидає кригу Свою, ніби дрібні камінці;","poem":1},{"text":"хто може встояти перед Його морозом?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Він пошле слово Своє, і все розтане,","poem":1},{"text":"подує вітром Своїм – потечуть води.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Він звіщає слово Своє Якову,","poem":1},{"text":"постанови й закони правосуддя – Ізраїлеві.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він не зробив такого жодному іншому народові,","poem":1},{"text":"і правосуддя законів","poem":2},{"noteId":237},{"text":"вони не знають.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[{"noteId":237,"caller":"+","text":"Або: судів Його.","reference":{"chapter":147,"verse":9}}]},"thisChapterLink":"/api/ukr_npu/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":9}