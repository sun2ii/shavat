{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Алілуя!","poem":1},{"lineBreak":true},{"text":"Хваліть Господа з небес,","poem":1},{"text":"прославляйте Його на висотах.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Хваліть Його, усі ангели Його,","poem":1},{"text":"прославляйте Його, усі воїнства Його.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Хваліть Його, сонце і місяць,","poem":1},{"text":"прославляйте Його, усі ясні зорі.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Хваліть Його, небеса небес,","poem":1},{"text":"і води, що над небесами.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Хваліть ім’я Господа,","poem":1},{"text":"бо Він наказав – і вони були створені.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Він утвердив їх на віки вічні –","poem":1},{"text":"дав постанову, що не буде скасована.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Хваліть Господа з землі,","poem":1},{"text":"морські чудовиська й усі безодні океану,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"вогонь і град, сніг і туман,","poem":1},{"text":"вітер бурхливий, що виконує Його слово,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"гори й усі пагорби,","poem":1},{"text":"дерева плодоносні й усі кедри,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"звірі й уся худоба,","poem":1},{"text":"живина плазуюча й птахи крилаті,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"царі земні й усі племена,","poem":1},{"text":"князі й усі судді землі,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"юнаки й дівчата,","poem":1},{"text":"старі з юними –","poem":2}]},{"type":"verse","number":13,"content":[{"text":"хваліть ім’я Господа,","poem":1},{"text":"бо лише Його ім’я піднесене","poem":2},{"lineBreak":true},{"text":"й велич Його – над землею й небесами!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Він підняв ріг народу Свого,","poem":1},{"text":"прославив вірних Своїх –","poem":2},{"lineBreak":true},{"text":"синів Ізраїлевих, народу, що близький Йому.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}