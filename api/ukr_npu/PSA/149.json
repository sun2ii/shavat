меч обосічний у їхній руці,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"щоб вчинити помсту народам,","poem":1},{"text":"здійснити покарання над племенами,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"щоб зв’язати царів їхніх кайданами","poem":1},{"text":"й вельмож їхніх – залізними ланцюгами,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"щоб звершити над ними записаний вирок.","poem":1},{"text":"Така честь належить усім вірним Йому.","poem":2},{"lineBreak":true},{"text":"Алілуя!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}