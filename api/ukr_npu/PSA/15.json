{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Міхтам","descriptive":true},{"noteId":25},{"text":"Давидів.","descriptive":true},{"text":"Бережи мене, Боже,","poem":1},{"text":"адже на Тебе я надію покладаю!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Сказав я Господеві: «Ти мій Володар,","poem":1},{"text":"немає в мене іншого блага, окрім Тебе».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Також до святих, що на землі,","poem":1},{"text":"і до шляхетних – до них моє бажання.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нехай же численні скорботи спіткають тих,","poem":1},{"text":"хто іншим богам прагне служити.","poem":2},{"noteId":26},{"text":"Я не литиму їм крові жертовних виливань,","poem":1},{"text":"не згадуватиму імен тих богів моїми вустами.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ЛишеГосподь – наділений мені спадок і мій келих;","poem":1},{"noteId":27},{"text":"Ти тримаєш мій жереб.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Межі мого наділу пролягли через приємні місця –","poem":1},{"text":"так, гарний спадок для мене!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Благословлю я Господа, Який дає мені поради,","poem":1},{"text":"навіть уночі моє нутро","poem":2},{"noteId":28},{"text":"наставляє мене.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"В уяві своїй завжди я бачу перед собою Господа,","poem":1},{"text":"адже Він по правиці моїй,","poem":2},{"lineBreak":true},{"text":"щоб я не похитнувся.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Тому радіє серце моє й веселиться слава моя,","poem":1},{"noteId":29},{"text":"також тіло моє перебуватиме в безпеці,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"бо не залишиш Ти душі моєї в царстві мертвих,","poem":1},{"text":"не дозволиш вірному Твоєму побачити тління.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ти стежку життя мені показуєш;","poem":1},{"text":"наповнив мене радощами перед обличчям Твоїм,","poem":2},{"lineBreak":true},{"text":"насолодою по правиці Твоїй навіки.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Буквально: напис або припис; можливо, музичний термін, значення якого невідоме.","reference":{"chapter":15,"verse":1}},{"noteId":26,"caller":"+","text":"Буквально: поспішає.","reference":{"chapter":15,"verse":4}},{"noteId":27,"caller":"+","text":"Келих або чаша – символ долі (Див. Пс. 22:5; 74:9; Мт. 26:39).","reference":{"chapter":15,"verse":5}},{"noteId":28,"caller":"+","text":"Буквально: нирки.","reference":{"chapter":15,"verse":7}},{"noteId":29,"caller":"+","text":"Слава моя – так у єврейському тексті, у грецькому перекладі (Септуаґінта) – язик мій.","reference":{"chapter":15,"verse":9}}]},"thisChapterLink":"/api/ukr_npu/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":11}