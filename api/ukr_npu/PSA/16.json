{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Молитва Давидова.","descriptive":true},{"text":"Почуй, о Господи, благання про правду;","poem":1},{"text":"прислухайся до мого волання,","poem":2},{"text":"зваж на мою молитву,","poem":1},{"text":"що з вуст нелукавих лине.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Від Тебе Самого нехай прийде мені суд справедливий,","poem":2},{"text":"нехай очі Твої побачать правду.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ти випробував моє серце,","poem":1},{"text":"дослідив мене вночі,","poem":2},{"text":"переплавив мене, але не знайшов того,","poem":1},{"text":"щоб слова мої розходилися з думками.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Щодо справ людських,","poem":2},{"text":"то згідно зі словом, що вийшло з вуст Твоїх,","poem":1},{"text":"я зберіг себе від того, щоб стати на шлях гнобителя.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Стопи мої крокували тільки Твоїми стежками,","poem":1},{"text":"ноги мої не оступалися.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Я кличу до Тебе, бо Ти відповіси мені, Боже;","poem":1},{"text":"нахили вухо Твоє до мене, почуй мову мою.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"З’яви дивну милість Твою,","poem":1},{"text":"о Визволителю, Що рятуєш правицею Своєю тих,","poem":2},{"lineBreak":true},{"text":"хто надію покладає на Тебе в протистоянні з ворогами.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Бережи мене мов зіницю ока,","poem":1},{"text":"у тіні крил Твоїх","poem":2},{"noteId":30},{"text":"сховай мене","poem":2}]},{"type":"verse","number":9,"content":[{"text":"від нечестивих, що грабують мене,","poem":1},{"text":"від смертельних ворогів моїх, що мене оточили.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Вони заплили жиром,","poem":1},{"text":"вуста їхні говорять пихато.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Підкрадалися до мене таємно, а тепер оточили мене,","poem":1},{"text":"їхні очі шукають нагоди,","poem":2},{"lineBreak":true},{"text":"аби кинути мене на землю.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Немов той лев, що прагне терзати здобич,","poem":1},{"text":"і як лев молодий, що в засідці залягає.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Піднімися, Господи, стань перед ним, кинь додолу його;","poem":1},{"text":"мечем Своїм визволи душу мою від нечестивого,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"рукою Твоєю від мужів, Господи, –","poem":1},{"text":"від людей плинного світу, чия доля лише в цьому житті.","poem":2},{"text":"То нехай же їхнє черево наповниться із Твоєї скарбниці","poem":1},{"text":"нехай діти їхні наситяться","poem":2},{"text":"і залишок передадуть малюкам своїм.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"А я в правді побачу обличчя Твоє,","poem":1},{"text":"прокинувшись, образом Твоїм насичуватися буду.","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Див. Повт. 32:11-12, де Бог порівнюється з орлом, що піклується про своїх пташенят.","reference":{"chapter":16,"verse":8}}]},"thisChapterLink":"/api/ukr_npu/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":15}