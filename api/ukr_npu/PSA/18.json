{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Небеса проголошують славу Божу,","poem":1},{"text":"і про діяння рук Його сповіщає небесна твердь.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"День у день виливають вони мову свою","poem":1},{"text":"й щоночі відкривають знання.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Хоча без слів їхня мова","poem":1},{"text":"і не чути звуків від них,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"по всій землі розходиться їхній голос,","poem":1},{"text":"і до краю всесвіту – їхні слова.","poem":2},{"lineBreak":true},{"text":"У небесах поставив Він шатро для сонця,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"і воно виходить із нього, немов наречений із весільної світлиці,","poem":1},{"text":"і радіє, наче бігун","poem":2},{"noteId":33},{"text":", що пробігти має свою стежину.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"З одного краю небес воно виходить,","poem":1},{"text":"пробігає коло до іншого краю,","poem":2},{"lineBreak":true},{"text":"і ніщо не сховається від його спекоти.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Закон Господа бездоганний,","poem":1},{"text":"оновлює душу.","poem":2},{"text":"Одкровення Господні гідні довіри,","poem":1},{"text":"мудрими роблять простих.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Настанови Господні справедливі,","poem":1},{"text":"радують серце.","poem":2},{"text":"Заповідь Господа промениста,","poem":1},{"text":"просвітлює очі.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Страх Господній чистий,","poem":1},{"text":"перебуває повіки.","poem":2},{"text":"Закони правосуддя Господа істинні,","poem":1},{"text":"усі вони праведні.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Вони бажаніші від золота,","poem":1},{"text":"навіть від безлічі золота щирого;","poem":2},{"text":"і солодші вони від меду,","poem":1},{"text":"меду стільникового.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Тож Твій слуга бережеться ними;","poem":1},{"text":"за їх дотримання – велика нагорода.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"А помилки свої – хто їх помітити може?","poem":1},{"text":"Від неумисних провин очисти мене","poem":2}]},{"type":"verse","number":14,"content":[{"text":"і від свідомих гріхів стримай раба Твого –","poem":1},{"text":"нехай не панують наді мною.","poem":2},{"text":"Тоді я буду досконалий","poem":1},{"text":"і чистий від великого беззаконня.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Нехай приємні Тобі будуть слова вуст моїх","poem":1},{"text":"і роздуми серця мого,","poem":2},{"text":"Господи, Скеле моя й Відкупителю мій!","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"Або: воїн, герой, силач.","reference":{"chapter":18,"verse":6}}]},"thisChapterLink":"/api/ukr_npu/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":15}