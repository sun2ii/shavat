{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Нехай відповість тобі Господь у день скорботи.","poem":1},{"text":"Нехай підніме тебе ім’я Бога Якова.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Нехай пошле Він тобі допомогу зі Святилища","poem":1},{"text":"і підтримає тебе із Сіону.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нехай Він згадає усі твої жертвоприношення з прихильністю","poem":1},{"text":"і твоїми цілопаленнями задоволений буде. Села","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Нехай Він дасть тобі те, чого бажає твоє серце,","poem":1},{"text":"здійснить усі твої наміри.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ми радісно гукатимемо про твою перемогу,","poem":1},{"text":"і в ім’я Бога нашого піднімемо знамена.","poem":2},{"lineBreak":true},{"text":"Нехай виконає Господь усі прохання твої.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Тепер я знаю, що рятує Господь помазанця Свого,","poem":1},{"text":"відповідає йому зі святих небес Своїх","poem":2},{"lineBreak":true},{"text":"переможною силою правиці Своєї.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Дехто хвалиться колісницями, дехто – конями,","poem":1},{"text":"а ми хвалитися будемо іменем Господа, Бога нашого.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Вони похилилися й впали,","poem":1},{"text":"а ми встали й зміцнюємося.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Господи, даруй перемогу!","poem":1},{"text":"Нехай Цар відповість нам того дня, коли ми кличемо до Нього!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":10}