{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Господи, цар радіє міці Твоїй","poem":1},{"text":"і порятунком Твоїм надзвичайно веселиться.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ти дав йому те, чого бажало його серце,","poem":1},{"text":"і благання вуст його не відхилив. Села","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Але зустрів його рясними благословеннями,","poem":1},{"text":"поклав йому на голову вінок зі щирого золота.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Він просив життя у Тебе – Ти дав йому,","poem":1},{"text":"навіки наділив довголіттям.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Велика слава в нього через перемоги, даровані Тобою;","poem":1},{"text":"Ти наділив Його славою й величчю.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ти обдарував його благословеннями навіки,","poem":1},{"text":"звеселив його радістю від присутності Твоєї.","poem":2},{"noteId":34}]},{"type":"verse","number":8,"content":[{"text":"Бо на Господа цар покладає надію,","poem":1},{"text":"і завдяки милості Всевишнього він не похитнеться.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Знайде рука Твоя всіх ворогів Твоїх,","poem":1},{"text":"правиця Твоя досягне Твоїх ненависників.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ти зробиш їх подібними до вогняної печі","poem":1},{"text":"у час Твого з’явлення.","poem":2},{"text":"У гніві Своєму Господь знищить їх,","poem":1},{"text":"і вогонь їх спалить.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нащадків їхніх Ти знищиш із землі,","poem":1},{"text":"і насіння їхнє – з-поміж синів людських.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Бо вони задумують зло проти Тебе,","poem":1},{"text":"плетуть каверзи, але не досягнуть мети.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ти зробиш їх ціллю для лука Свого,","poem":1},{"text":"проти облич їхніх натягнеш тятиву.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Піднімися, о Господи, у міці Твоїй!","poem":1},{"text":"Ми співатимемо й хвалитимемо могутність Твою.","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"Буквально: радістю обличчя Твого.","reference":{"chapter":20,"verse":7}}]},"thisChapterLink":"/api/ukr_npu/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":14}