{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів","descriptive":true},{"text":"Господь – мій Пастир,","poem":1},{"text":"я нічого більше не потребую.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Він дає мені спочинок на трав’янистих пасовищах,","poem":1},{"text":"водить мене до тихих вод.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Він оживляє мою душу,","poem":1},{"text":"веде мене стежками правди","poem":2},{"text":"заради Свого імені.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Навіть коли я піду долиною тіней смерті,","poem":1},{"text":"то не боятимусь зла,","poem":2},{"text":"адже Ти зі мною;","poem":1},{"text":"Твій жезл і Твій посох –","poem":2},{"lineBreak":true},{"text":"вони заспокоюють мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ти готуєш для мене святковий стіл","poem":1},{"text":"на очах у моїх супротивників,","poem":2},{"text":"Ти намастив мою голову олією,","poem":1},{"text":"мій келих наповнений вщерть.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Тож нехай добро й милість супроводжують мене","poem":1},{"text":"в усі дні мого життя,","poem":2},{"text":"а я перебуватиму в домі Господньому повіки.","poem":1},{"noteId":37}]}],"footnotes":[{"noteId":37,"caller":"+","text":"Буквально: довгі дні; цей вираз вживається в значенні навіки, повіки, Див. Пс. 92:5.","reference":{"chapter":22,"verse":6}}]},"thisChapterLink":"/api/ukr_npu/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":6}