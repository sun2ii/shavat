{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів","descriptive":true},{"text":"Господеві належить земля і все, що її наповнює,","poem":1},{"text":"всесвіт і все, що живе в ньому.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Адже Він заклав її основи в глибинах морів","poem":1},{"text":"і над ріками встановив її.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Хто може зійти на гору Господню?","poem":1},{"text":"Хто зможе стати на Його святому місці?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Той, чиї долоні чисті й серце невинне,","poem":1},{"text":"хто не надимався марно своєю душею","poem":2},{"lineBreak":true},{"text":"й оманливо не присягався.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Отримає він благословення від Господа","poem":1},{"text":"й виправдання від Бога, Спасителя Свого.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ось такий рід тих, хто шукає Його,","poem":1},{"text":"шукає обличчя Твого, Боже","poem":2},{"noteId":38},{"text":"Якова. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ворота, підніміть ваші верхи,","poem":1},{"noteId":39},{"text":"підніміться, о двері вічні,","poem":2},{"lineBreak":true},{"text":"щоб увійшов Цар слави!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Хто ж Він, цей Цар слави?","poem":1},{"text":"Господь могутній і сильний,","poem":2},{"lineBreak":true},{"text":"Господь сильний у битві.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ворота, підніміть ваші верхи,","poem":1},{"text":"підніміться, о двері вічні,","poem":2},{"lineBreak":true},{"text":"щоб увійшов Цар слави!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Хто Він, цей Цар слави?","poem":1},{"text":"Господь Воїнств,","poem":2},{"text":"Він – Цар слави! Села","poem":1}]}],"footnotes":[{"noteId":38,"caller":"+","text":"Слова «Бог» немає в більшості єврейських рукописів, воно зустрічається в грецькому (Септуаґінта) та сирійському (Пешитта) перекладах, а також у двох варіантах єврейського тексту.","reference":{"chapter":23,"verse":6}},{"noteId":39,"caller":"+","text":"Ворота в стародавніх містах і фортецях часто відчинялися не врізнобіч, а піднімалися вгору, коли треба було впустити когось у місто.","reference":{"chapter":23,"verse":7}}]},"thisChapterLink":"/api/ukr_npu/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":10}