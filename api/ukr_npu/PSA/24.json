{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"До Тебе, Господи, я підношу мою душу.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Боже мій, на Тебе надію покладаю;","poem":1},{"text":"тож не дай мені вкритися соромом,","poem":2},{"text":"нехай вороги не радіють перемозі наді мною.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Не дай жодному з тих, хто на Тебе надію покладає,","poem":2},{"text":"бути посоромленим,","poem":1},{"text":"але нехай вкриються ганьбою ті,","poem":2},{"text":"хто безпідставно чинить віроломство.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Покажи мені, шляхи Твої, Господи,","poem":1},{"text":"навчи мене стежок Твоїх.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Веди мене істиною Твоєю й навчи мене,","poem":1},{"text":"адже Ти – Бог спасіння мого,","poem":2},{"lineBreak":true},{"text":"на Тебе я надію покладаю щодня.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Згадай, Господи, любов Твою й Твоє милосердя,","poem":1},{"text":"адже вони споконвіку.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Гріхів юності моєї","poem":1},{"text":"й беззаконь моїх не згадуй,","poem":2},{"text":"але заради милосердя Твого згадай мене,","poem":1},{"text":"заради доброти Твоєї, Господи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Добрий і справедливий Господь,","poem":1},{"text":"тому наставляє грішників на істинний шлях.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він спрямовує смиренних до справедливості","poem":1},{"text":"й покірливих навчає дороги Своєї.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Усі стежки Господні – милість та істина","poem":1},{"text":"для тих, хто дотримується Його Завіту й одкровень.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Заради імені Твого, Господи,","poem":1},{"text":"прости беззаконня моє,","poem":2},{"lineBreak":true},{"text":"бо велике воно.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Хто той муж, що Господа боїться?","poem":1},{"text":"Вкаже йому Бог дорогу, яку треба обрати.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Душа його житиме в достатку,","poem":1},{"text":"і нащадки його успадкують землю.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Таємницю СвоюГосподьдовіряє тим, хто боїться Його,","poem":1},{"text":"і Завіт Свій відкриває їм.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Очі мої завжди звернені до Господа,","poem":1},{"text":"бо Він звільняє ноги мої із пастки.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Зглянься на мене й змилуйся наді мною,","poem":1},{"text":"бо я самотній і пригнічений.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Скорботи мого серця примножилися –","poem":1},{"text":"виведи мене зі страждань моїх.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Поглянь на приниження моє й муку мою","poem":1},{"text":"і прости усі гріхи мої.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Подивися на ворогів моїх, які численні вони стали","poem":1},{"text":"і якою ненавистю лютою ненавидять мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Збережи мою душу й визволи мене,","poem":1},{"text":"не дай мені вкритися ганьбою,","poem":2},{"lineBreak":true},{"text":"адже на Тебе надію покладаю.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Невинність і справедливість нехай стережуть мене,","poem":1},{"text":"бо на Тебе я покладаю надію.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Визволи, Боже, Ізраїля","poem":1},{"text":"від усіх скорбот його!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":22}