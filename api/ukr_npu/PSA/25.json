{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Суди мене, Господи,","poem":1},{"text":"адже я ходив бездоганно,","poem":2},{"lineBreak":true},{"text":"і на Господа я покладав надію непохитно.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Випробуй мене, Господи, оціни мене,","poem":1},{"text":"досліди серце моє й моє нутро.","poem":2},{"noteId":40}]},{"type":"verse","number":3,"content":[{"text":"Бо милість Твоя перед моїми очима,","poem":1},{"text":"тому я завжди ходжу в істині Твоїй.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Я не сиджу з нікчемними людьми","poem":1},{"text":"й не піду з підступними.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Я ненавиджу зборище злодіїв","poem":1},{"text":"і не сяду з нечестивими.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Омиватиму свої руки в невинності","poem":1},{"text":"й навколо жертовника Твого, Господи, ходитиму,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"голосно звіщаючи подяку","poem":1},{"text":"й проголошуючи всі чудеса Твої.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Господи, я полюбив оселю Твого дому,","poem":1},{"text":"те місце, де мешкає Твоя слава.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Не дай душі моїй загинути з грішниками","poem":1},{"text":"й не згуби життя мого з людьми кровожерними,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"у чиїх руках злий задум","poem":1},{"text":"і чиї правиці повні хабарів.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"А я бездоганно ходжу життєвим шляхом.","poem":1},{"text":"Визволи мене й помилуй!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Нога моя стоїть на рівній землі;","poem":1},{"text":"серед присутніх на великих зборах благословлятиму Господа.","poem":2}]}],"footnotes":[{"noteId":40,"caller":"+","text":"Буквально: нирки.","reference":{"chapter":25,"verse":2}}]},"thisChapterLink":"/api/ukr_npu/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}