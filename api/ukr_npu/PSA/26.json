{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Господь – моє світло й моє спасіння:","poem":1},{"text":"кого мені боятись?","poem":2},{"text":"Господь – твердиня мого життя:","poem":1},{"text":"кого мені лякатись?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Коли наблизяться до мене злодії,","poem":1},{"text":"щоб пожерти моє тіло,","poem":2},{"noteId":41},{"text":"коли супротивники й вороги мої повстануть проти мене,","poem":1},{"text":"вони спіткнуться й впадуть.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Якщо військо стане табором проти мене,","poem":1},{"text":"моє серце страх не охопить;","poem":2},{"text":"якщо війна спалахне проти мене –","poem":1},{"text":"і тоді я почуватимусь у безпеці.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Одного лиш просив я в Господа,","poem":1},{"text":"тільки того шукаю:","poem":2},{"text":"щоб мешкати мені в домі Господньому","poem":1},{"text":"всі дні життя мого,","poem":2},{"text":"щоб споглядав я спокій","poem":1},{"noteId":42},{"text":"Господа","poem":1},{"text":"й поринав у роздуми в Храмі Його.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Бо Він сховає мене в помешканні Своєму в день лиха,","poem":1},{"text":"убереже мене під подолом Свого шатра","poem":2},{"lineBreak":true},{"text":"й здійме мене на скелю.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Тоді піднесеться голова моя над ворогами моїми, що оточують мене,","poem":1},{"text":"і принесу я біля шатра Його","poem":2},{"text":"жертви з вигуком радості,","poem":1},{"text":"співатиму й гратиму для Господа.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Почуй, Господи, мій голос, адже кличу я,","poem":1},{"text":"помилуй мене і дай мені відповідь.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«До Тебе!» – каже серце моє.","poem":1},{"text":"«Шукайте обличчя Моє!»","poem":2},{"lineBreak":true},{"text":"Обличчя Твоє, Господи, шукатиму я.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Не відвертай обличчя Твого від мене,","poem":1},{"text":"не відкинь у гніві раба Твого,","poem":2},{"text":"адже Ти був допомогою моєю.","poem":1},{"text":"Не покинь мене, не залиши,","poem":2},{"text":"Боже спасіння мого!","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Хоча мої батько й мати полишили мене,","poem":1},{"text":"але Господь прийме мене.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Покажи мені, Господи, дорогу Твою","poem":1},{"text":"і стежкою справедливості веди мене","poem":2},{"lineBreak":true},{"text":"заради ворогів моїх.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Не віддавай мене на поталу супротивникам моїм,","poem":1},{"text":"бо свідки неправдиві повстали проти мене","poem":2},{"lineBreak":true},{"text":"й дихають насильством.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Однак я твердо вірю,","poem":1},{"text":"що побачу доброту Господню на землі живих.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Надійся на Господа,","poem":1},{"text":"будь мужнім і серце своє зміцни.","poem":2},{"lineBreak":true},{"text":"Надійся на Господа!","poem":2}]}],"footnotes":[{"noteId":41,"caller":"+","text":"Пожерти тіло – це образний вислів, що означає зводити наклеп, доносити; Див. Дан. 3:8, де вжито аналогічний вираз арамейською «пожерли їхні шматки», тобто «звели на них наклеп».","reference":{"chapter":26,"verse":2}},{"noteId":42,"caller":"+","text":"Буквально: приємність, спокій, насолода.","reference":{"chapter":26,"verse":4}}]},"thisChapterLink":"/api/ukr_npu/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}