{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"До Тебе, Господи, я кличу,","poem":1},{"text":"Скеле моя, не будь байдужим","poem":2},{"noteId":43},{"text":"до мене!","poem":2},{"text":"Якщо Ти мовчатимеш,","poem":1},{"text":"я стану подібним до тих,","poem":2},{"lineBreak":true},{"text":"що сходять до прірви.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Почуй голос благань моїх,","poem":1},{"text":"коли я волаю до Тебе,","poem":2},{"text":"коли я піднімаю руки свої","poem":1},{"text":"до Святая Святих","poem":2},{"noteId":44},{"text":"Храму Твого.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Не став мене на один рівень із нечестивими,","poem":1},{"noteId":45},{"text":"з тими, що роблять беззаконня,","poem":2},{"text":"що про мир говорять із ближніми своїми,","poem":1},{"text":"та в серцях у них зло.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Віддай їм за їхніми вчинками,","poem":1},{"text":"за мірою зла у їхніх справах.","poem":2},{"text":"Так, як вчинили руки їхні, віддай їм,","poem":1},{"text":"поверни їм те, що вони заслужили.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"За те, що не задумуються вони над звершеннями Господа","poem":1},{"text":"й над діянням рук Його,","poem":2},{"text":"Він їх зруйнує й не відбудує знов.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Благословенний Господь,","poem":1},{"text":"бо почув Він голос моїх благань.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Господь – твердиня моя й щит мій;","poem":1},{"text":"на Нього покладалося моє серце.","poem":2},{"text":"Він допоміг мені, і серце моє зраділо,","poem":1},{"text":"тож піснею своєю я прославлю Його.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Господь – сила Свого народу,","poem":1},{"text":"Він – рятівна твердиня для Свого помазанця.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Врятуй народ Твій і благослови Свій спадок;","poem":1},{"text":"Будь їхнім Пастирем і веди їх повік!","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"Буквально: не будь глухим.","reference":{"chapter":27,"verse":1}},{"noteId":44,"caller":"+","text":"Цей вираз означає найсвятіше відділення Храму, Див. 1 Цар. 6:16.","reference":{"chapter":27,"verse":2}},{"noteId":45,"caller":"+","text":"Буквально: не тягни мене з нечествими, тобто не поводься зі мною так, як із ними.","reference":{"chapter":27,"verse":3}}]},"thisChapterLink":"/api/ukr_npu/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":9}