{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів.","descriptive":true},{"text":"Віддайте Господеві, о сини Божі,","poem":1},{"text":"віддайте Господеві славу й могутність!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Віддайте імені Господа славу,","poem":1},{"text":"вклоніться Господеві в Його величному святилищі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Голос Господа – над водами;","poem":1},{"text":"Бог слави гримить,","poem":2},{"lineBreak":true},{"text":"Господь – над водами могутніми.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Голос Господа сильний;","poem":1},{"text":"Голос Господа величний.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Голос Господа ламає кедри,","poem":1},{"text":"Господь ламає кедри Лівану.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Він змушує їх танцювати, як телят,","poem":1},{"text":"а гори Ліван та Сиріон – немов молодого дикого бика.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Голос Господа викрешує язики полум’я.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Голос Господа змушує тремтіти пустелю,","poem":2},{"text":"Господь потрясає пустелю Кадеш.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Голос Господа гне дуби","poem":2},{"noteId":46},{"text":"й оголює ліси,","poem":1},{"text":"а в Храмі Його всі вигукують: «Слава!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Господь сидів над водами потопу;","poem":1},{"text":"Господь як Цар сидітиме навіки!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Господь дає міць Своєму народові;","poem":1},{"text":"Господь благословляє народ Свій миром.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"Або: дає силу народжувати ланям.","reference":{"chapter":28,"verse":9}}]},"thisChapterLink":"/api/ukr_npu/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":11}