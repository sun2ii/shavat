{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів, коли він втікав від свого сина Авесалома.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Господи, як багато супротивників у мене стало!","poem":1},{"text":"Як багато тих, хто повстає проти мене!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Багато хто каже про мене:","poem":1},{"text":"«Немає йому порятунку від Бога». Села","poem":2},{"noteId":6}]},{"type":"verse","number":4,"content":[{"text":"Але Ти, Господи, – щит для мене,","poem":1},{"text":"слава моя,","poem":2},{"text":"Ти підносиш мою голову.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Голосом моїм я кличу до Господа,","poem":1},{"text":"і Він відповідає мені зі святої гори Своєї. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Я лягаю і сплю, прокидаюся знову,","poem":1},{"text":"адже Господь мене підтримує.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Не боятимусь я десятків тисяч людей,","poem":1},{"text":"що з усіх боків мене обступили.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Повстань, Господи!","poem":1},{"text":"Врятуй мене, Боже мій!","poem":2},{"text":"Адже Ти вражав усіх ворогів моїх у щелепу,","poem":1},{"text":"трощив зуби нечестивих.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Тільки в Господа спасіння!","poem":1},{"text":"Над народом Твоїм благословення Твоє, Господи. Села","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Давньоєврейський музичний термін се́ла, що вказує на підвищення тону або паузу.","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/ukr_npu/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}