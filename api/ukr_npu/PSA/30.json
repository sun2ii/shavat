{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"На Тебе, я Господи, покладаю надію,","poem":1},{"text":"тож нехай не посоромлюся повіки!","poem":2},{"lineBreak":true},{"text":"Врятуй мене у Своїй праведності!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Схили до мене вухо Твоє,","poem":1},{"text":"поспіши визволити мене,","poem":2},{"text":"будь для мене скелею пристановища,","poem":1},{"text":"домом твердині, щоб врятувати мене.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Бо Ти моя скеля й твердиня моя;","poem":1},{"text":"заради імені Твого веди мене й керуй мною.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Витягни мене з тенет, які вони для мене таємно розставили,","poem":1},{"text":"адже ти моє пристановище.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"У руки Твої я ввіряю дух мій;","poem":1},{"text":"визволи мене, Господи, Боже істини.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ненавиджу тих, що шанують марних ідолів;","poem":1},{"text":"я ж надію покладаю на Господа.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Веселитимусь і радітиму Твоєму милосердю,","poem":1},{"text":"бо Ти побачив моє пригнічення,","poem":2},{"lineBreak":true},{"text":"дізнався про скорботи мого серця","poem":2}]},{"type":"verse","number":9,"content":[{"text":"й не віддав мене в руки ворога мого на поталу,","poem":1},{"text":"але поставив мої ноги на просторому місці.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Помилуй мене, Господи, бо тісно мені,","poem":1},{"text":"згасли від смутку мої очі,","poem":2},{"lineBreak":true},{"text":"моя душа й нутро моє.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Бо життя моє згасає в журбі,","poem":1},{"text":"і роки мої – у зітханнях.","poem":2},{"text":"Моя сила спіткнулася через гріхи мої,","poem":1},{"text":"і кістки мої виснажилися.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Через усіх супротивників моїх","poem":1},{"text":"став я ганьбою для своїх сусідів","poem":2},{"text":"і страхом для тих, хто добре знав мене;","poem":1},{"text":"хто бачить мене на вулиці – тікає від мене.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Забутий я в серцях їхніх, немов померлий;","poem":1},{"text":"став я немов розбитий глек.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Бо чую я наклепи від багатьох,","poem":1},{"text":"жах навколо.","poem":2},{"text":"Змовляються вони разом проти мене,","poem":1},{"text":"задумують життя моє забрати.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Але я на Тебе надію покладаю, Господи!","poem":1},{"text":"Кажу я: «Ти мій Бог!»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"У Твоїй руці час мого життя;","poem":1},{"text":"визволи мене від руки ворогів моїх","poem":2},{"lineBreak":true},{"text":"і від тих, хто мене переслідує.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Нехай засяє обличчя Твоє над рабом Твоїм,","poem":1},{"text":"врятуй мене в милості Твоїй.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Господи, нехай не буде мені соромно,","poem":1},{"text":"що я до Тебе кличу.","poem":2},{"text":"Нехай соромно стане нечестивим,","poem":1},{"text":"нехай замовкнуть вони в царстві смерті.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Нехай оніміють вуста брехливі,","poem":1},{"text":"що проти праведника говорять зухвало,","poem":2},{"lineBreak":true},{"text":"пихато й з презирством.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Які ж великі Твої блага,","poem":1},{"text":"котрі приховав Ти для тих, хто боїться Тебе,","poem":2},{"text":"які Ти здійснюєш на очах синів людських","poem":1},{"noteId":48},{"text":"для тих, хто надію покладає на Тебе!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ти вкриваєш їх покровом Свого обличчя","poem":1},{"noteId":49},{"text":"від підступних змов людських,","poem":2},{"text":"ховаєш їх у наметі Своєму","poem":1},{"text":"від лайливих язиків.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Благословенний Господь,","poem":1},{"text":"Що з’явив мені дивовижну Свою милість,","poem":2},{"lineBreak":true},{"text":"коли я був в оточеному ворогами місті.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Я ж сказав у тривозі моїй:","poem":1},{"text":"«Я вигнаний геть від очей Твоїх!»","poem":2},{"text":"Але Ти почув голос благань моїх,","poem":1},{"text":"коли я волав до Тебе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Любіть Господа, усі вірні Його!","poem":1},{"text":"Оберігає Господь відданих Йому","poem":2},{"lineBreak":true},{"text":"та відплачує сповна гордим.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Будьте мужніми й зміцніться серцем,","poem":1},{"text":"усі, хто на Господа сподівається.","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"Буквально: перед синами людськими.","reference":{"chapter":30,"verse":20}},{"noteId":49,"caller":"+","text":"Або: присутності Своєї.","reference":{"chapter":30,"verse":21}}]},"thisChapterLink":"/api/ukr_npu/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":25}