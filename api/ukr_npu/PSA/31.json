{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів. Повчання.","descriptive":true},{"text":"Блаженний той, чиї беззаконня прощені,","poem":1},{"text":"чиї гріхи покриті!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Блаженна та людина,","poem":1},{"text":"якій Господь не залічить її гріха,","poem":2},{"lineBreak":true},{"text":"у дусі якої немає підступності!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Поки я мовчав,","poem":1},{"text":"виснажилися мої кості","poem":2},{"lineBreak":true},{"text":"через моє щоденне стогнання.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Бо вдень і вночі","poem":1},{"text":"тяжіла наді мною рука Твоя;","poem":2},{"text":"волога життєдайна в мені","poem":1},{"text":"перетворилася на літню посуху. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Та визнав я свій гріх перед Тобою","poem":1},{"text":"й не приховав моєї провини.","poem":2},{"text":"Я сказав: «Визнаю перед Господом мої беззаконня»,","poem":1},{"text":"і Ти простив провину мого гріха. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Тому помолиться Тобі кожен вірний","poem":1},{"text":"у той час, коли можна знайти Тебе,","poem":2},{"text":"і навіть потік могутніх вод","poem":1},{"text":"до нього не підступить.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ти – потаємний притулок для мене;","poem":1},{"text":"Ти стерегтимеш мене від лиха,","poem":2},{"lineBreak":true},{"text":"оточиш мене вигуками радості визволення. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Я тебе наставлятиму й спрямовувати тебе буду","poem":1},{"text":"на шлях, яким належить тобі йти.","poem":2},{"text":"Я буду давати поради,","poem":1},{"text":"Моє око наглядає за тобою».","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Тож не будьте як кінь чи мул,","poem":1},{"text":"що не мають розуміння,","poem":2},{"text":"чий норов треба стримувати вудилом і вуздечкою,","poem":1},{"text":"бо інакше не наблизяться вони до тебе.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Багато скорбот у нечестивого,","poem":1},{"text":"а того, хто надію на Господа покладає,","poem":2},{"lineBreak":true},{"text":"оточує Його милість.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Радійте в Господі й веселіться, праведні!","poem":1},{"text":"Голосно співайте, усі щирі серцем!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":11}