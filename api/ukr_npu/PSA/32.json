{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Веселіться, праведні, у Господі!","poem":1},{"text":"Справедливим личить хвалити Його.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Славте Господа під звуки арфи,","poem":1},{"text":"співайте для Нього під ліру десятиструнну!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Співайте Йому нову пісню,","poem":1},{"text":"грайте майстерно, зі звуком сурми!","poem":2},{"noteId":50}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Бо Слово Господа справедливе","poem":1},{"text":"і всі Його дії гідні довіри.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Він любить праведність і справедливість;","poem":1},{"text":"земля повна милості Господньої.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Словом Господа створені небеса,","poem":1},{"text":"і духом вуст Його – усе воїнство їхнє.","poem":2},{"noteId":51}]},{"type":"verse","number":7,"content":[{"text":"Він збирає грудами води моря,","poem":1},{"text":"кладе безодні океану в сховища.","poem":2},{"noteId":52}]},{"type":"verse","number":8,"content":[{"text":"Нехай боїться Господа вся земля;","poem":1},{"text":"нехай тремтять перед Ним усі мешканці всесвіту.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Бо Він сказав – і стало,","poem":1},{"text":"Він заповів – і з’явилося.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Господь руйнує намір народів,","poem":1},{"text":"знищує задуми племен.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"А намір Господа стоятиме повіки,","poem":1},{"text":"задуми Його серця – з роду в рід.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Блаженний народ, чиїм Богом є Господь,","poem":1},{"text":"народ, який Він обрав Собі у спадок.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Господь поглядає з небес,","poem":1},{"text":"бачить усіх синів людських.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Із місця Свого перебування приглядається пильно","poem":1},{"text":"до всіх, хто живе на землі, –","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Творець усіх сердець їхніх","poem":1},{"text":"із розумінням вникає в усі їхні дії.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Царя не врятує численне військо,","poem":1},{"text":"воїна не визволить велика сила.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Кінь ненадійний для порятунку:","poem":1},{"text":"великою силою своєю він не врятує.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ось очі Господні звернені на тих, хто боїться Його,","poem":1},{"text":"хто на милість Його сподівається,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"щоб від смерті врятувати їх","poem":1},{"text":"і живити під час голоду.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Душа наша в надії чекає на Господа,","poem":1},{"text":"Він – наша допомога і щит.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ним радіє наше серце,","poem":1},{"text":"бо на святе Його ім’я ми покладаємось.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Нехай милість Твоя, Господи, буде над нами,","poem":1},{"text":"як ми на Тебе й сподіваємося.","poem":2}]}],"footnotes":[{"noteId":50,"caller":"+","text":"Або: із радісним вигуком.","reference":{"chapter":32,"verse":3}},{"noteId":51,"caller":"+","text":"Воїнство небесне – поетична назва зірок; Див. Бут. 2:1; Неєм. 9:6; Іс. 40:26.","reference":{"chapter":32,"verse":6}},{"noteId":52,"caller":"+","text":"Давньоєврейське слово тего́м означає морські / океанські глибини; Див. Бут. 1:2; 7:11; Пс. 135:6.","reference":{"chapter":32,"verse":7}}]},"thisChapterLink":"/api/ukr_npu/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}