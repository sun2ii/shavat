{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору Єдутуну. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Я сказав: «Я стежитиму за своїми життєвими дорогами,","poem":1},{"text":"від гріха утримуватиму язик свій,","poem":2},{"text":"вустам моїм поставлю перепону,","poem":1},{"text":"поки нечестивий переді мною».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Я онімів, затих,","poem":1},{"text":"мовчав навіть про добре,","poem":2},{"lineBreak":true},{"text":"та біль мій внутрішній лише роз’ятрився,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"серце моє запалало зсередини.","poem":2},{"text":"Коли я роздумував, загорівся вогонь,","poem":1},{"text":"тоді я промовив язиком своїм:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Дай мені знати, Господи, час мого кінця","poem":1},{"text":"і яка кількість моїх днів?","poem":2},{"lineBreak":true},{"text":"Хотів би я знати, наскільки швидкоплинне життя моє.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ось Ти дав мені днів лише на ширину долоні,","poem":1},{"text":"і тривалість мого життя – як ніщо перед Тобою.","poem":2},{"lineBreak":true},{"text":"Справді, кожна людина, що існує, – лише пара. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Так, людина снує в сутінках,","poem":1},{"text":"марно клопочеться,","poem":2},{"lineBreak":true},{"text":"накопичує, та не знає, хто забере все це.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Тож на що мені тепер надіятися, мій Володарю?","poem":1},{"text":"Лише на Тебе моє сподівання.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Визволи мене від усіх беззаконь моїх,","poem":1},{"text":"не віддавай мене на глузування нерозумним.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Я онімів, не відкриваю вуст моїх,","poem":1},{"text":"бо Ти зробив так.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Відведи від мене удар Твій;","poem":1},{"text":"від стусанів Твоїх я гину.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Докорами за беззаконня Ти караєш людину","poem":1},{"text":"й нищиш її красу, як міль.","poem":2},{"lineBreak":true},{"text":"Справді, кожна людина – марнота. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Почуй молитву мою, Господи,","poem":1},{"text":"і прислухайся до зойку мого;","poem":2},{"text":"не мовчи щодо сліз моїх,","poem":1},{"text":"адже я лише приходько в Тебе,","poem":2},{"lineBreak":true},{"text":"тимчасовий поселенець, як і всі прабатьки мої.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Відведи Свій суворий погляд від мене, щоб я трохи порадів,","poem":1},{"text":"перш ніж я піду й мене не стане».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":14}