{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На струнних інструментах. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Коли я кличу, дай мені відповідь,","poem":1},{"text":"Боже моєї правди!","poem":2},{"text":"Коли мені було тісно, Ти давав мені простір.","poem":1},{"text":"Змилуйся наді мною і почуй мою молитву.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"О сини людські, доки ви честь мою безчестити будете?","poem":1},{"text":"Доки будете любити марне","poem":2},{"text":"й прагнути неправди? Села","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Знайте ж, що Господь відокремив для Себе вірного слугу,","poem":1},{"text":"Він чує, коли я кличу до Нього.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Тремтіть перед Ним","poem":1},{"noteId":7},{"text":"і не грішіть;","poem":1},{"text":"поміркуйте в серцях ваших на ложах ваших і заспокойтеся. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Принесіть жертви правди","poem":1},{"text":"і надію на Господа покладайте.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Багато хто каже: «Хто нам покаже добро?»","poem":1},{"text":"Пролий на нас світло Твого обличчя, Господи!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ти дав моєму серцю більшу радість,","poem":1},{"text":"ніж у них в той час, коли зарясніло їхнє зерно й молоде вино.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"У повному спокої я ляжу й засну,","poem":1},{"text":"бо тільки Ти, Господи,","poem":2},{"text":"даєш мені жити в безпеці.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Або: Гнівайтеся, та не грішіть.","reference":{"chapter":4,"verse":5}}]},"thisChapterLink":"/api/ukr_npu/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}