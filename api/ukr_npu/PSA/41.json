{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Повчання синів Кореєвих.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Як олень лине до потоків води,","poem":1},{"text":"так душа моя лине до Тебе, Боже.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Душа моя спрагла Бога, живого Бога.","poem":1},{"text":"Коли ж прийду я й постану перед Богом?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Сльози мої були для мене хлібом вдень і вночі,","poem":1},{"text":"коли говорили мені щодня:","poem":2},{"text":"«Де твій Бог?»","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ось про що я згадую, і виливається від туги душа моя:","poem":1},{"text":"коли проходив я у велелюдній ході,","poem":2},{"text":"підступаючи до дому Божого","poem":1},{"text":"із вигуками радості й слави","poem":2},{"text":"серед святкового натовпу.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Чому ти сумуєш, душе моя,","poem":1},{"text":"і чому журишся в мені?","poem":2},{"text":"Сподівайся на Бога,","poem":1},{"text":"адже я ще прославлятиму Його –","poem":2},{"lineBreak":true},{"text":"мого Спасителя!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Боже мій, за Тобою сумує душа моя,","poem":1},{"text":"тому я згадую про Тебе","poem":2},{"text":"із землі Йордану,","poem":1},{"text":"із висот Хермону, з гори Міцар.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Безодня до безодні кличе","poem":1},{"text":"шумом Твоїх водоспадів;","poem":2},{"text":"усі Твої буруни та хвилі","poem":1},{"text":"пройшли наді мною.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Удень заповість Господь Своїй милості прийти до мене,","poem":1},{"text":"а вночі у мене лине Йому пісня,","poem":2},{"lineBreak":true},{"text":"молитва Богові мого життя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Скажу-но я Богові, скелі моїй:","poem":1},{"text":"«Чому Ти забув мене?","poem":2},{"text":"Чому я ходжу понуро,","poem":1},{"text":"пригнічений ворогом?»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"У кістках моїх – виснаження;","poem":1},{"text":"глузують з мене мої супротивники,","poem":2},{"text":"щодня промовляючи до мене:","poem":1},{"text":"«Де твій Бог?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Чому ти сумуєш, душе моя,","poem":1},{"text":"і чому журишся в мені?","poem":2},{"text":"Сподівайся на Бога,","poem":1},{"text":"адже я ще прославлятиму Його –","poem":2},{"text":"Спасителя мого й Бога мого.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":12}