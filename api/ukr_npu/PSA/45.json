{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Синів Кореєвих пісня. На мотив аламот.","descriptive":true},{"noteId":65}]},{"type":"verse","number":2,"content":[{"text":"Бог – пристановище наше й міць,","poem":1},{"text":"допомога в скорботах, що завжди знаходиться поруч.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Тому ми не злякаємось,","poem":1},{"text":"хоч би навіть земля здригнулася","poem":2},{"lineBreak":true},{"text":"й гори ринули в морську безодню","poem":2},{"noteId":66},{"text":",","poem":2}]},{"type":"verse","number":4,"content":[{"text":"так що заревли б і запінилися води від їхнього падіння,","poem":1},{"text":"і скелі б затремтіли від того збурення води. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Річкові потоки радують місто Боже,","poem":1},{"text":"святилище, де мешкає Всевишній.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Бог посеред нього – воно не захитається;","poem":1},{"text":"Бог допоможе йому ще вдосвіта.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Збентежилися народи, похитнулися царства,","poem":1},{"text":"подав Він Свій голос – тане земля.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Господь Воїнств","poem":1},{"noteId":67},{"text":"із нами;","poem":1},{"text":"Твердиня наша – Бог Якова. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Підіть-но, погляньте на діяння Господа,","poem":1},{"text":"які спустошення здійснив Він на землі,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"припиняючи війни аж до краю землі.","poem":1},{"text":"Він ламає лук і розщеплює древко списа,","poem":2},{"lineBreak":true},{"text":"колісниці","poem":2},{"noteId":68},{"text":"спалює вогнем.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"«Вгамуйтеся й пізнайте, що Я – Бог;","poem":1},{"text":"Я буду звеличений серед народів,","poem":2},{"lineBreak":true},{"text":"звеличений на землі».","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Господь Воїнств із нами,","poem":1},{"text":"Твердиня наша – Бог Якова. Села","poem":2}]}],"footnotes":[{"noteId":65,"caller":"+","text":"Музичний термін, можливо, означає виконання високим голосом (євр. альма́– жінка).","reference":{"chapter":45,"verse":1}},{"noteId":66,"caller":"+","text":"Буквально: у серце морів.","reference":{"chapter":45,"verse":3}},{"noteId":67,"caller":"+","text":"Передачу давньоєврейського словосполучення Ягве́ Цевао́т, яке в деяких перекладах передано із збереженням без перекладу другого слова: Господь Саваот.","reference":{"chapter":45,"verse":8}},{"noteId":68,"caller":"+","text":"Буквально: щити.","reference":{"chapter":45,"verse":10}}]},"thisChapterLink":"/api/ukr_npu/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":12}