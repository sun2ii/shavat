{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом синів Кореєвих.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Усі народи, плескайте в долоні,","poem":1},{"text":"вигуки радості нехай лунають на славу Богові.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Бо Господь Всевишній грізний,","poem":1},{"text":"Він Цар великий над усією землею!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Він підкорив нам народи","poem":1},{"text":"й племена кинув під наші ноги.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Він обрав для нас спадок –","poem":1},{"text":"гордість Якова, якого полюбив. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Бог піднявся під радісні вигуки,","poem":1},{"text":"Господь піднісся під голос сурми.","poem":2},{"noteId":69}]},{"type":"verse","number":7,"content":[{"text":"Співайте Богові, співайте!","poem":1},{"text":"Співайте Цареві нашому, співайте!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Бо Цар усієї землі – Бог,","poem":1},{"text":"співайте псалом із розумінням.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Бог царює над народами,","poem":1},{"text":"Бог сидить на Своєму святому престолі.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Шляхетні з народів зібралися","poem":1},{"text":"разом із народом Бога Авраамового,","poem":2},{"text":"адже Богу належать захисники землі","poem":1},{"noteId":70},{"text":"–","poem":1},{"text":"Він високо піднесений над ними.","poem":2}]}],"footnotes":[{"noteId":69,"caller":"+","text":"Буквально: під голос шофару; шофар – вигнутий баранячий ріг, що використовувався як духовий музичний інструмент у храмових обрядах Лев. 25:9; 2 Сам. 6:15.","reference":{"chapter":46,"verse":6}},{"noteId":70,"caller":"+","text":"Буквально: адже Божі щити землі, тобто ті, хто оберігає землю. Можливо, ідеться про майбутнє Царство Месії Іс. 60:3.","reference":{"chapter":46,"verse":10}}]},"thisChapterLink":"/api/ukr_npu/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":10}