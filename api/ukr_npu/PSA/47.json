{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня. Псалом синів Кореєвих.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Великий Господь і прославлений вельми","poem":1},{"text":"у місті нашого Бога,","poem":2},{"lineBreak":true},{"text":"на Своїй святій горі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Краса невимовна,","poem":1},{"text":"радість усієї землі –","poem":2},{"text":"гора Сіон на північних околицях,","poem":1},{"noteId":71},{"text":"місто великого Царя.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Бог перебуває в її палацах,","poem":1},{"text":"Він знаний як твердиня.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ось царі зібралися,","poem":1},{"text":"пішли разом проти нас","poem":2}]},{"type":"verse","number":6,"content":[{"text":"та, побачивши таку святість, здивувалися,","poem":1},{"text":"збентежилися, пустилися навтіки.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Трепет охопив їх там,","poem":1},{"text":"мука, як у породіллі.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Східним вітром розбив Ти","poem":1},{"text":"кораблі Таршишу.","poem":2},{"noteId":72}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Про що ми чули раніше,","poem":1},{"text":"те й побачили","poem":2},{"text":"у місті Господа Воїнств,","poem":1},{"text":"місті Бога нашого:","poem":2},{"text":"Бог утверджує його навіки. Села","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ми роздумували, Боже, про милість Твою","poem":1},{"text":"всередині Твого Храму.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Як ім’я Твоє, Боже, так і хвала Твоя –","poem":1},{"text":"до самого краю землі!","poem":2},{"lineBreak":true},{"text":"Твоя правиця сповнена правди.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Радіє гора Сіон,","poem":1},{"text":"веселяться доньки Юдеї","poem":2},{"lineBreak":true},{"text":"через Твоє правосуддя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Обійдіть навколо Сіон,","poem":1},{"text":"порахуйте його вежі.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"уважно розгляньте його укріплення,","poem":1},{"text":"пройдіть між палацами,","poem":2},{"lineBreak":true},{"text":"щоб потім ви розповіли наступному поколінню.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Адже це – Бог, наш Бог на віки вічні!","poem":1},{"text":"Він вестиме нас аж до смерті.","poem":2}]}],"footnotes":[{"noteId":71,"caller":"+","text":"Храмова гора знаходиться в північно-східній частині Єрусалима.","reference":{"chapter":47,"verse":3}},{"noteId":72,"caller":"+","text":"Таршиш – віддалене від Землі Ізраїлю місто в басейні Середземного моря, можливо, на території сучасної Іспанії, за іншими даними – на узбережжі Малої Азії або на острові Родос. Відоме своїми кораблями, що здатні були долати далекі відстані, коштовностями та торгівлею взагалі 1 Цар. 10:22; 22:49; 2 Хр. 20:36; Іс. 2:16; 23:1, 10; 60:9; Йона. 1:3.","reference":{"chapter":47,"verse":8}}]},"thisChapterLink":"/api/ukr_npu/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}