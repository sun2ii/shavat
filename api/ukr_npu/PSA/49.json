{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Асафів.","descriptive":true},{"text":"Бог богів – Господь!","poem":1},{"text":"Він промовляє, закликає землю","poem":2},{"lineBreak":true},{"text":"від сходу сонця аж до заходу.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Із Сіону, досконалої краси,","poem":1},{"text":"Бог з’явився в сяйві.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Іде наш Бог і не мовчить;","poem":1},{"text":"вогонь перед Ним пожирає","poem":2},{"lineBreak":true},{"text":"й навколо Нього сильно вирує.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Він закликає небеса вгорі","poem":1},{"text":"і землю на суд зі Своїм народом:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Зберіть-но до Мене Моїх вірних,","poem":1},{"text":"хто уклав Завіт зі Мною при жертві».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"І небеса сповіщатимуть правду Його,","poem":1},{"text":"адже Суддя – Сам Бог! Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Слухай, народе Мій, Я говоритиму;","poem":1},{"text":"Ізраїлю, Я свідчити буду проти тебе:","poem":2},{"lineBreak":true},{"text":"Я – Бог, твій Бог.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Не за жертвоприношення твої Я докорятиму тобі –","poem":1},{"text":"твої цілопалення завжди переді Мною.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Я не прийму вола із твого дому,","poem":1},{"text":"ані козлів із твоїх кошар.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Адже всі тварини в лісі – Мої,","poem":1},{"text":"і худоба на тисячі пагорбів.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Я знаю кожного птаха в горах,","poem":1},{"text":"і все, що рухається на полях, – зі Мною.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Якби Я був голодний,","poem":1},{"text":"то не сказав би тобі про це,","poem":2},{"text":"адже Мені належить всесвіт","poem":1},{"text":"і все, що його наповнює.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Хіба Я їм м’ясо биків","poem":1},{"text":"чи п’ю кров козлів?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Принеси Богові в жертву подяку","poem":1},{"text":"й виконай перед Всевишнім твої обітниці.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Поклич Мене в день скорботи –","poem":1},{"text":"Я визволю тебе, а ти Мене прославиш».","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Нечестивому ж говорить Бог:","poem":1},{"text":"«Як ти смієш Мої постанови сповіщати","poem":2},{"lineBreak":true},{"text":"і Завіт Мій в устах своїх носити?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ти ж ненавидиш настанови","poem":1},{"text":"й кидаєш Слова Мої позад себе?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Коли ти бачиш крадія, заводиш із ним приязні стосунки;","poem":1},{"text":"і від перелюбників маєш свою частку.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Вуста твої вживаєш для зла,","poem":1},{"text":"і язик твій плете підступні каверзи.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Сидиш на суді, намовляєш на брата твого,","poem":1},{"text":"проти сина своєї матері свідчиш ганебне.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ти чинив це, а Я мовчав,","poem":1},{"text":"тому уявив ти собі, що Я такий, як ти.","poem":2},{"text":"Я покараю тебе","poem":1},{"text":"й виставлю звинувачення перед очима твоїми.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Зрозумійте ж це ті, хто забуває Бога,","poem":1},{"text":"щоб Я не розтерзав вас,","poem":2},{"lineBreak":true},{"text":"і не буде кому врятувати.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Той, хто приносить у жертву подяку, шанує Мене;","poem":1},{"text":"і тому, хто торує дорогу правди,","poem":2},{"text":"покажу Я спасіння Боже».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":23}