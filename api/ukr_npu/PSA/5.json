{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Для виконання в супроводі сопілок. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Зваж на слова мої, Господи,","poem":1},{"text":"зрозумій мій стогін!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Прислухайся до звуків мого зойку,","poem":1},{"text":"Царю мій і Боже мій,","poem":2},{"lineBreak":true},{"text":"бо Тобі я молюся.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господи, вранці Ти почуй мій голос,","poem":1},{"text":"вранці я постану перед Тобою","poem":2},{"lineBreak":true},{"text":"й чекатиму.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Адже Ти не той Бог, Якому до вподоби беззаконня,","poem":1},{"text":"зло не мешкатиме поряд із Тобою.","poem":2},{"noteId":8}]},{"type":"verse","number":6,"content":[{"text":"Не встоять пихаті перед Твоїми очима,","poem":1},{"text":"Ти ненавидиш усіх тих, хто поводиться свавільно.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ти знищиш тих, що промовляють неправду;","poem":1},{"text":"людина кровожерна й підступна гидка для Тебе, Господи.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Але я, завдяки великій Твоїй милості,","poem":1},{"text":"увійду до дому Твого,","poem":2},{"text":"поклонюся у бік Храму святині Твоєї,","poem":1},{"text":"сповнений страхом побожним перед Тобою.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Господи, веди мене Твоєю правдою","poem":1},{"text":"заради ворогів моїх;","poem":2},{"lineBreak":true},{"text":"вирівняй шлях Твій переді мною.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Адже немає у вустах їхніх щирості,","poem":1},{"text":"їхній внутрішній світ – руїна,","poem":2},{"text":"гортань у них – відкрита могила,","poem":1},{"noteId":9},{"text":"язики у них слизькі.","poem":2},{"noteId":10}]},{"type":"verse","number":11,"content":[{"text":"Оголоси їм вирок, Боже!","poem":1},{"text":"Нехай впадуть вони через підступні задуми свої,","poem":2},{"text":"відкинь їх через численні беззаконня їхні,","poem":1},{"text":"адже вони повстали проти Тебе.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"І тоді радітимуть усі,","poem":1},{"text":"хто на Тебе надію покладає;","poem":2},{"text":"їхні вигуки щастя лунатимуть вічно.","poem":1},{"text":"Простягни Свій покров над ними,","poem":2},{"lineBreak":true},{"text":"і звеселяться Тобою ті,","poem":2},{"lineBreak":true},{"text":"що ім’я Твоє люблять.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Бо Ти благословляєш праведного, Господи,","poem":1},{"text":"наче великим щитом","poem":2},{"noteId":11},{"text":", вкриваєш його Твоєю прихильністю.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Або: злий не мешкатиме поряд із Тобою.","reference":{"chapter":5,"verse":5}},{"noteId":9,"caller":"+","text":"У Сиро-Ханаанському регіоні в давні часи померлих ховали в печерах або в збудованих із кам’яних брил могилах – так званих дольменах або цистах; вхід до печери або верх могили закривали пласким каменем, тому сказано відкрита, а не розкопана могила.","reference":{"chapter":5,"verse":10}},{"noteId":10,"caller":"+","text":"Буквально: язик їхній ковзає.","reference":{"chapter":5,"verse":10}},{"noteId":11,"caller":"+","text":"Використане тут давньоєврейське слово цинна́ означає великий щит, який використовували важкоозброєні піхотинці.","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/ukr_npu/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}