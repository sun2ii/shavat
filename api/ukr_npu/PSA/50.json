{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"коли приходив до нього пророк Натан, після того, як Давид учинив перелюб із Вірсавією.","descriptive":true},{"noteId":77}]},{"type":"verse","number":3,"content":[{"text":"Помилуй мене, Боже,","poem":1},{"text":"заради милості Твоєї,","poem":2},{"text":"заради великого милосердя Твого","poem":1},{"text":"загладь мої беззаконня.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Обмий мене від переступу мого","poem":1},{"text":"й від гріха мого мене очисти,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"адже я усвідомлюю беззаконня своє,","poem":1},{"text":"і гріх мій завжди переді мною.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Проти Тебе Самого згрішив я","poem":1},{"text":"і зло вчинив у Твоїх очах.","poem":2},{"text":"Тому Ти справедливо виконуєш Свій вирок,","poem":1},{"text":"бездоганно здійснюєш Твій суд.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ось у беззаконні я народжений,","poem":1},{"text":"і мати моя зачала мене в гріху.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ось істину Ти вподобав у надрах внутрішнього світу","poem":1},{"noteId":78},{"text":"і мудрість сповіщаєш мені утаємничено.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Очисти мене гісопом від гріха – і буду чистий;","poem":1},{"text":"ретельно обмий мене – і буду біліший від снігу.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Дай мені почути звуки веселощів і радості,","poem":1},{"text":"нехай зрадіють кістки, вражені Тобою.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Відверни обличчя Своє від гріхів моїх","poem":1},{"text":"і загладь усі мої беззаконня.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Створи в мені серце чисте, Боже,","poem":1},{"text":"і дух непохитний обнови всередині мене.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Не відштовхни мене від обличчя Свого","poem":1},{"text":"й не забирай від мене Твого Святого Духа.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Поверни мені радість Твого спасіння","poem":1},{"text":"і Духом Твоїм турботливим підтримай мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Тоді беззаконних я навчатиму шляхів Твоїх","poem":1},{"text":"і грішники навернуться до Тебе.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Зніми з мене тягар вини кровопролиття, Боже,","poem":1},{"text":"Боже мого спасіння,","poem":2},{"lineBreak":true},{"text":"тоді язик мій радісно прославлятиме Твою праведність.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Володарю, відкрий вуста мої,","poem":1},{"text":"і вони сповіщатимуть Тобі хвалу.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Бо жертвоприношення Тобі не до вподоби – я приніс би його,","poem":1},{"text":"цілопалення Ти не бажаєш.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Жертва Богові – дух зламаний;","poem":1},{"text":"серцем зламаним і розбитим","poem":2},{"lineBreak":true},{"text":"Ти не знехтуєш, Боже.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ощаслив Сіон прихильністю Твоєю,","poem":1},{"text":"збудуй стіни Єрусалима.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Тоді приємними Тобі будуть жертви правди,","poem":1},{"text":"цілопалення та жертвоприношення,","poem":2},{"lineBreak":true},{"text":"тоді покладуть на жертовник Твій волів.","poem":2}]}],"footnotes":[{"noteId":77,"caller":"+","text":"Див. 2 Сам. 11:1–12:23.","reference":{"chapter":50,"verse":2}},{"noteId":78,"caller":"+","text":"Буквально: у прихованих місцях; ідеться про глибинний внутрішній світ людини.","reference":{"chapter":50,"verse":8}}]},"thisChapterLink":"/api/ukr_npu/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":21}