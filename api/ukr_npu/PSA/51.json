{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Повчання Давидове,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"коли прийшов Доеґ-едомітянин до Саула й повідомив йому: «Давид у домі Ахімелеха».","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Чому ти хизуєшся злодійством, сильний?","poem":1},{"text":"Милість Божа зі мною цілий день!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Язик твій задумує загибель,","poem":1},{"text":"він у тебе – немов нагострене лезо, підступнику!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ти полюбив зло більше, ніж добро,","poem":1},{"text":"брехню – сильніше, ніж правду говорити. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ти любиш усілякі згубні слова,","poem":1},{"text":"о, підступний язику!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Але Бог уразить тебе навіки;","poem":1},{"text":"вирве тебе й викине із шатра,","poem":2},{"lineBreak":true},{"text":"і коріння твоє – із землі живих. Села","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Тоді побачать це праведні й сповняться страхом,","poem":1},{"text":"і сміятимуться над ним:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«Ось муж,","poem":1},{"text":"що не Бога зробив своєю твердинею,","poem":2},{"text":"а покладався на безліч свого багатства,","poem":1},{"text":"зміцнював себе згубною пристрастю своєю!»","poem":2},{"noteId":79}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"А я, немов ряснолиста маслина в домі Божому,","poem":1},{"text":"на милість Божу сподіватимусь повік-віків.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Прославлятиму Тебе вічно перед Твоїми вірними за те,","poem":1},{"text":"що Ти зробив,","poem":2},{"lineBreak":true},{"text":"і надію покладатиму на ім’я Твоє,","poem":2},{"text":"бо воно добре.","poem":1}]}],"footnotes":[{"noteId":79,"caller":"+","text":"Давньоєврейське слово гавва́ означає загибель, і пристрасть.","reference":{"chapter":51,"verse":9}}]},"thisChapterLink":"/api/ukr_npu/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":11}