{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив махалат.","descriptive":true},{"noteId":80},{"text":"Повчання Давидове.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Промовив безумний у своєму серці: «Немає Бога».","poem":1},{"text":"Розбестились вони, вчинили огидні беззаконня,","poem":2},{"lineBreak":true},{"text":"немає нікого, хто б чинив добро.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Бог із небес поглядає на синів людських,","poem":1},{"text":"щоб побачити, чи є серед них розумний,","poem":2},{"lineBreak":true},{"text":"що шукає Бога.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Усі як один збочили з дороги, зіпсувалися;","poem":1},{"text":"немає того, хто робив би добро,","poem":2},{"lineBreak":true},{"text":"жодного немає.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Невже не схаменуться всі ті, хто чинить беззаконня,","poem":1},{"text":"хто пожирає народ мій, немов хліб,","poem":2},{"lineBreak":true},{"text":"хто Бога не кличе?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Там охопить їх страх,","poem":1},{"text":"де немає чого боятися,","poem":2},{"text":"Бо розкидає Бог кістки тих, хто оточив тебе;","poem":1},{"text":"ти вкриєш їх ганьбою,","poem":2},{"lineBreak":true},{"text":"адже Бог відцурався від них.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"О, хто дав би із Сіону порятунок Ізраїлеві!","poem":1},{"text":"Коли Бог поверне з полону народ Свій,","poem":2},{"text":"веселитиметься Яків, радітиме Ізраїль!","poem":1}]}],"footnotes":[{"noteId":80,"caller":"+","text":"Цей музичний термін, можливо, означає виконання на мотив співу в хороводі, від євр. махо́л – хоровод.","reference":{"chapter":52,"verse":1}}]},"thisChapterLink":"/api/ukr_npu/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":7}