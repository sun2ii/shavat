{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На струнних інструментах. Повчання Давидове,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"коли прийшли зіф’яни й сказали Саулові: «Хіба не у нас ховається Давид?»","descriptive":true},{"noteId":81}]},{"type":"verse","number":3,"content":[{"text":"Боже, врятуй мене іменем Твоїм","poem":1},{"text":"і могутністю Своєю вступися на суді за мене!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Боже, почуй мою молитву,","poem":1},{"text":"прислухайся до слів уст моїх.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Бо чужинці повстали проти мене","poem":1},{"text":"й жорстокі серцем шукають душі моєї –","poem":2},{"lineBreak":true},{"text":"ті, хто Бога не уявляє перед собою. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ось Бог мені допомагає;","poem":1},{"text":"Володар Вишній серед тих,","poem":2},{"lineBreak":true},{"text":"хто підтримує мою душу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Він віддячить за зло моїм супротивникам,","poem":1},{"text":"знищить їх заради вірності Своєї.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Із доброї волі принесу я Тобі жертву,","poem":1},{"text":"прославлю ім’я Твоє, Господи,","poem":2},{"text":"бо добре воно.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Адже від усіх скорбот Ти врятував мене,","poem":1},{"text":"і око моє переможно дивилося на моїх ворогів.","poem":2}]}],"footnotes":[{"noteId":81,"caller":"+","text":"Див. 1 Сам. 23:19-28; 26:1-2.","reference":{"chapter":53,"verse":2}}]},"thisChapterLink":"/api/ukr_npu/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":9}