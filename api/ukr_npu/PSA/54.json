{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На струнних інструментах. Повчання Давидове.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Прислухайся, Боже, до моєї молитви,","poem":1},{"text":"не ховайся від мого благання;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"прислухайся до мене і дай мені відповідь!","poem":1},{"text":"Я блукаю в тяжких думках своїх і зітхаю","poem":2}]},{"type":"verse","number":4,"content":[{"text":"від голосу ворога,","poem":1},{"text":"від утисків нечестивого.","poem":2},{"text":"Бо вони наводять на мене беззаконня","poem":1},{"text":"й гнівно ворогують зі мною.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Серце моє тремтить у моєму нутрі,","poem":1},{"text":"жахи смерті напали на мене.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Страх і трепет увійшли в мене,","poem":1},{"text":"і тремтіння охопило мене.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Сказав я: «Хто б дав мені крила голубині!","poem":1},{"text":"Я полетів би й віднайшов спокій,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"полинув би вдалечінь,","poem":1},{"text":"спочив би в пустелі. Села","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Поспішив би знайти собі прихисток","poem":1},{"text":"від рвучкого вітру й бурі».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Збентеж їх, Владико, розділи їм язики,","poem":1},{"text":"бо бачу я насильство й заколот у місті.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Удень та вночі вони обходять його на стінах,","poem":1},{"text":"беззаконня й утиск всередині нього.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Погибель серед міста,","poem":1},{"text":"його гноблення й підступ не покидають вулиць.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Адже не ворог ганьбить мене, –","poem":1},{"text":"я перетерпів би це, –","poem":2},{"text":"не ненависник мій величається наді мною, –","poem":1},{"text":"я сховався б від нього.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Але ти, кого я вважав одним цілим із собою,","poem":1},{"text":"приятель мій, щирий друг мій,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"з ким разом ми насолоджувалися щирим спілкуванням,","poem":1},{"text":"у дім Божий ми ходили однодушно.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Нехай же смерть спіткає їх,","poem":1},{"text":"нехай вони зійдуть живими до царства мертвих,","poem":2},{"lineBreak":true},{"text":"бо зло в їхніх помешканнях та в нутрощах їхніх.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Я ж до Бога кличу,","poem":1},{"text":"і Господь врятує мене.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Увечері, вранці й опівдні","poem":1},{"text":"я бідкаюся й бентежуся,","poem":2},{"lineBreak":true},{"text":"і Він чує мій голос.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Він мирно визволить мою душу","poem":1},{"text":"від битви проти мене,","poem":2},{"lineBreak":true},{"text":"бо численні ті, хто повстав на мене.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Бог почує та упокорить їх,","poem":1},{"text":"Той, Хто справіку сидить на престолі. Села","poem":2},{"text":"Бо вони не змінюються","poem":1},{"text":"й Бога не бояться.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Підняв товариш мій руки свої на близьких друзів,","poem":1},{"text":"знехтував своїм заповітом.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Вуста його слизькі, немов масло,","poem":1},{"text":"але війна в його серці;","poem":2},{"text":"слова його ніжніші за олію,","poem":1},{"text":"але вони – оголені мечі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Переклади свій тягар на Господа –","poem":1},{"text":"і Він підтримає тебе;","poem":2},{"lineBreak":true},{"text":"Він ніколи не дасть праведникові похитнутися.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Але Ти, Боже, скинеш їх","poem":1},{"text":"до прірви загибелі.","poem":2},{"text":"Люди кровожерні й підступні","poem":1},{"text":"не дотягнуть навіть до половини своїх днів.","poem":2},{"lineBreak":true},{"text":"А я на Тебе покладаюся.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":24}