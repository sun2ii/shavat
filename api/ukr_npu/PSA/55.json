{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":55,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив «Голубка в далекій діброві». Міхтам","descriptive":true},{"noteId":82},{"text":"Давидів, коли филистимляни схопили його в Ґаті.","descriptive":true},{"noteId":83}]},{"type":"verse","number":2,"content":[{"text":"Помилуй мене, Боже,","poem":1},{"text":"бо цькує мене людина,","poem":2},{"lineBreak":true},{"text":"цілий день, нападаючи, тисне на мене.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Цькують мене супротивники цілий день:","poem":1},{"text":"багато-бо тих, хто гордовито воює проти мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"У день страху","poem":1},{"text":"я на Тебе покладаю надію.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Я сподіваюся на Бога,","poem":1},{"text":"Чиє слово прославляю,","poem":2},{"text":"на Бога тільки й не боюся:","poem":1},{"text":"що зробить мені тілесна істота?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Цілий день мої слова перекручують,","poem":1},{"text":"усі їхні думки щодо мене – лише зло.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Вони сперечаються, спостерігають,","poem":1},{"text":"стежать за моїми кроками,","poem":2},{"lineBreak":true},{"text":"чатують на мою душу.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Не дай же їм уникнути кари за беззаконня;","poem":1},{"text":"у гніві, Боже, кинь долілиць народи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"О, якби полічив Ти мої поневіряння!","poem":1},{"text":"Збери мої сльози в посудину,","poem":2},{"noteId":84},{"text":"–","poem":2},{"lineBreak":true},{"text":"хіба ж вони не у Твоїй книзі?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Тоді вороги мої обернуться назад,","poem":1},{"text":"коли я покличу Тебе.","poem":2},{"lineBreak":true},{"text":"Через це дізнаюсь я, що Бог зі мною.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"На Бога, Чиє слово я прославляю,","poem":1},{"text":"на Господа, Чиє слово я славлю,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"на Бога покладаюсь я,","poem":1},{"text":"тому не боятимуся:","poem":2},{"lineBreak":true},{"text":"що зробить мені людина?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"На мені, Боже, обітниці, що дав я Тобі, –","poem":1},{"text":"я виконаю обіцяні Тобі жертви подяки.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Бо Ти визволив мою душу від смерті,","poem":1},{"text":"не дав спіткнутися нозі моїй,","poem":2},{"text":"щоб я ходив перед Богом","poem":1},{"text":"у світлі життя.","poem":2}]}],"footnotes":[{"noteId":82,"caller":"+","text":"Див. Пс. 15:1.","reference":{"chapter":55,"verse":1}},{"noteId":83,"caller":"+","text":"Див. 1 Сам. 21:10-15; 27:1-4.","reference":{"chapter":55,"verse":1}},{"noteId":84,"caller":"+","text":"Буквально: бурдюк, шкіряний міх для води або вина.","reference":{"chapter":55,"verse":9}}]},"thisChapterLink":"/api/ukr_npu/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":14}