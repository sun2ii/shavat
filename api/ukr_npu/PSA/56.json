{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив «Не згуби». Міхтам","descriptive":true},{"noteId":85},{"text":"Давидів, коли він втік від Саула в печеру.","descriptive":true},{"noteId":86}]},{"type":"verse","number":2,"content":[{"text":"Помилуй мене, Боже, помилуй мене!","poem":1},{"text":"Бо в Тобі лише знаходить притулок душа моя","poem":2},{"text":"і в тіні Твоїх крил сховається,","poem":1},{"text":"поки лихо мине.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Я кличу до Бога Всевишнього,","poem":1},{"text":"до Бога, Який віддячує за мене ворогам моїм.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Він пошле з небес і врятує мене,","poem":1},{"text":"посоромить того, хто прагне мене схопити; Села","poem":2},{"lineBreak":true},{"text":"пошле Бог милість Свою й істину.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Душа моя – посеред левів;","poem":1},{"text":"лежу я серед тих, що дихають полум’ям,","poem":2},{"text":"серед синів людських, чиї зуби – списи й стріли,","poem":1},{"text":"а язики їхні – гострий меч.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Піднімися понад небесами, Боже;","poem":1},{"text":"над усією землею – слава Твоя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Вони розкинули тенета стопам моїм;","poem":1},{"text":"понурилася душа моя.","poem":2},{"text":"Викопали переді мною яму –","poem":1},{"text":"самі упали в неї! Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Серце моє непохитне, Боже, непохитне серце моє!","poem":1},{"text":"Співати буду й грати!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Прокинься, славо моя!","poem":1},{"text":"Прокинься, ліро й арфо!","poem":2},{"lineBreak":true},{"text":"Розбуджу-но я зорю досвітню!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Прославлю Тебе серед народів, Владико,","poem":1},{"text":"співатиму Тобі поміж племенами.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Бо велика аж до небес милість Твоя","poem":1},{"text":"і аж до хмар – істина Твоя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Піднімися понад небесами, Боже;","poem":1},{"text":"над усією землею – слава Твоя.","poem":2}]}],"footnotes":[{"noteId":85,"caller":"+","text":"Див. Пс. 51:1.","reference":{"chapter":56,"verse":1}},{"noteId":86,"caller":"+","text":"Див. 1 Сам. 22:1-2; 24.","reference":{"chapter":56,"verse":1}}]},"thisChapterLink":"/api/ukr_npu/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}