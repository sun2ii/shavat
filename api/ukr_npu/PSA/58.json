{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":58,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив «Не згуби». Міхтам Давидів, коли Саул послав людей стерегти його дім, щоб убити його.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Визволи мене від ворогів Моїх, Боже мій,","poem":1},{"text":"захисти мене від тих, хто підноситься проти мене.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Від тих, що чинять беззаконня, визволи мене","poem":1},{"text":"і від людей кровожерних врятуй мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ось вони чатують на душу мою,","poem":1},{"text":"сильні змовляються проти мене","poem":2},{"lineBreak":true},{"text":"не за беззаконня моє чи гріх, Господи.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Немає беззаконня в мене,","poem":1},{"text":"але збігаються вони й готуються до нападу.","poem":2},{"lineBreak":true},{"text":"Піднімися назустріч мені й поглянь.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ти, Господи, Боже Воїнств, Боже Ізраїлю,","poem":1},{"text":"пробудися, щоб покарати всі народи;","poem":2},{"lineBreak":true},{"text":"не помилуй жодного з нечестивих зрадників! Села","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Вони повертаються в сутінках вечірніх,","poem":1},{"text":"виють, немов пси,","poem":2},{"lineBreak":true},{"text":"обступають місто звідусіль.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ось вивергають вони ганьбу,","poem":1},{"text":"в устах у них – мечі!","poem":2},{"lineBreak":true},{"text":"На їхніх язиках приказка: «Хто чує?»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Але Ти, Господи, посмієшся з них,","poem":1},{"text":"поглузуєш з усіх народів.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Сило моя, Тебе я пильную очікуючи,","poem":1},{"text":"адже Ти, Боже, твердиня моя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Бог, Що милує мене,","poem":1},{"lineBreak":true},{"text":"піде поперед мене переможно;","poem":1},{"text":"Бог покаже мені падіння супротивників моїх.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Не вбивай їх,","poem":1},{"text":"щоб не забув мій народ;","poem":2},{"text":"розкидай їх силою Своєю","poem":1},{"text":"і кинь їх долілиць, щите наш, Владико!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Гріх вуст їхніх –","poem":1},{"text":"це слова, що губи їхні промовили.","poem":2},{"text":"Нехай впіймані вони будуть гординею своєю","poem":1},{"text":"за прокляття й кривду, що вони розповсюджують.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Знищ їх у гніві, знищ,","poem":1},{"text":"щоб не було їх!","poem":2},{"text":"Тоді відомо стане аж до країв землі,","poem":1},{"text":"що Бог володарює серед Якова. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"А вони повертаються в сутінках вечірніх,","poem":1},{"text":"виють, немов пси,","poem":2},{"lineBreak":true},{"text":"обступають місто звідусіль. Села","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Вони вештаються в пошуках їжі,","poem":1},{"text":"та, не наситившись, ночують.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"А я буду співати про міць Твою","poem":1},{"text":"і вранці радісно про милість Твою виспівувати.","poem":2},{"text":"Адже Ти був для мене прихистком,","poem":1},{"text":"притулком у день моєї скорботи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Сило моя, Тобі я співатиму,","poem":1},{"text":"адже Ти, Боже, твердиня моя,","poem":2},{"lineBreak":true},{"text":"Бог, Який милує мене.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":18}