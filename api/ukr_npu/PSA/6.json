{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. У супроводі струнних інструментів. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Господи, не докоряй мені у гніві Твоєму,","poem":1},{"text":"І не карай мене в люті Своїй.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Помилуй мене, Господи, бо я знемігся.","poem":1},{"text":"Зціли мене, Господи,","poem":2},{"lineBreak":true},{"text":"бо кістки мої зомліли.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Душа моя вкрай збентежена.","poem":1},{"text":"А Ти, Господи, доки мовчатимеш?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Повернися до мене, Господи, визволи мою душу,","poem":1},{"text":"врятуй мене заради милості Твоєї.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Адже в смерті немає згадки про Тебе.","poem":1},{"text":"Хто прославить Тебе в царстві мертвих","poem":2},{"noteId":12},{"text":"?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Я виснажився від стогнання мого,","poem":1},{"text":"щоночі обливаю постіль свою плачем,","poem":2},{"lineBreak":true},{"text":"сльозами ложе своє зволожую.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Очі мої змарніли від смутку,","poem":1},{"text":"виснажилися через погрози моїх супротивників.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Відступіться геть від мене всі ті, хто поводиться свавільно,","poem":1},{"text":"бо почув Господь голос плачу мого!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Почув Господь благання моє,","poem":1},{"text":"Господь прийняв молитву мою.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нехай засоромлені будуть і збентежені вкрай усі вороги мої,","poem":1},{"text":"обернуться назад і вкриються ганьбою зненацька.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Давньоєврейське слово шео́л означає місце нижче землі, куди сходять померлі (Бут. 37:35; 1 Цар. 2:6; Йов 17:16).","reference":{"chapter":6,"verse":6}}]},"thisChapterLink":"/api/ukr_npu/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}