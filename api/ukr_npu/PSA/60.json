{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На струнних інструментах. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Почуй, Боже, моє волання,","poem":1},{"text":"зваж на мою молитву!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Від краю землі я кличу до Тебе","poem":1},{"text":"в немочі мого серця.","poem":2},{"lineBreak":true},{"text":"Підніми мене на скелю, що вища від мене.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Адже Ти – пристановище для мене,","poem":1},{"text":"міцна вежа від нападів ворога.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Нехай би мешкав я в шатрі Твоєму вічно,","poem":1},{"text":"спочивав би під покровом крил Твоїх безпечно. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Адже Ти, Боже, почув мої обітниці,","poem":1},{"text":"дав мені спадщину тих, хто боїться Твого імені.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Додай цареві днів життя,","poem":1},{"text":"продовж роки його в майбутніх поколіннях.","poem":2},{"noteId":96}]},{"type":"verse","number":8,"content":[{"text":"Нехай він перебуває вічно перед Богом,","poem":1},{"text":"накажи милості й істині оберігати його.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Тоді я співатиму імені Твоєму повік,","poem":1},{"text":"виконуючи мої обітниці щодня.","poem":2}]}],"footnotes":[{"noteId":96,"caller":"+","text":"Або: з роду в рід.","reference":{"chapter":60,"verse":7}}]},"thisChapterLink":"/api/ukr_npu/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":9}