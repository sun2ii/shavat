{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору, Єдутуну.","descriptive":true},{"noteId":97},{"text":"Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Лише в Бозі спокій моєї душі,","poem":1},{"text":"від Нього моє спасіння.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Тільки Він – моя скеля і мій порятунок,","poem":1},{"text":"твердиня моя – не захитаюся дуже.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Доки ви будете нападати на людину,","poem":1},{"text":"усі разом добивати її,","poem":2},{"lineBreak":true},{"text":"як похилену стіну, немов розхитану огорожу?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Радяться лише про те,","poem":1},{"text":"щоб скинути її з високого місця,","poem":2},{"text":"задоволення знаходять у брехні.","poem":1},{"text":"Устами своїми благословляють,","poem":2},{"lineBreak":true},{"text":"а в серці проклинають. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Лише в Бозі заспокоюйся, душе моя;","poem":1},{"text":"бо лише на Нього надія моя.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Тільки Він – моя скеля і мій порятунок,","poem":1},{"text":"твердиня моя – не захитаюся.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"У Бозі спасіння моє і слава моя;","poem":1},{"text":"Він – могутня скеля моя,","poem":2},{"lineBreak":true},{"text":"пристановище моє в Бозі.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Народе, покладайся на Нього повсякчас,","poem":1},{"text":"серця ваші виливайте перед Ним;","poem":2},{"lineBreak":true},{"text":"Бог – пристановище наше. Села","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Сини людські – лише марнота,","poem":1},{"text":"сини мужів – омана;","poem":2},{"text":"якщо покласти їх на ваги,","poem":1},{"text":"усі разом вони легші від пари.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Не покладайтеся на гноблення інших","poem":1},{"text":"і не хизуйтеся грабунком.","poem":2},{"text":"Коли сила зростає,","poem":1},{"text":"не прикладайте до неї серця.","poem":2},{"noteId":98}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Один раз Бог промовив,","poem":1},{"text":"двічі я почув це:","poem":2},{"text":"у Бога могутність,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"у Тебе, Володарю, милість.","poem":2},{"text":"Адже Ти віддячуєш кожному за його вчинки.","poem":1}]}],"footnotes":[{"noteId":97,"caller":"+","text":"Єдутун та його сини були співаками й музикантами, що їх призначив цар Давид прославляти Бога у святилищі; Див. 1 Хр. 16:41, 42.","reference":{"chapter":61,"verse":1}},{"noteId":98,"caller":"+","text":"Або: не надавайте їй значення.","reference":{"chapter":61,"verse":11}}]},"thisChapterLink":"/api/ukr_npu/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":13}