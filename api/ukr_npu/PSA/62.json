{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Давидів, коли він був у пустелі Юдейській.","descriptive":true},{"noteId":99}]},{"type":"verse","number":2,"content":[{"text":"Боже, Ти – мій Бог, Тебе я пристрасно шукаю.","poem":1},{"text":"Душа моя спрагла Тебе,","poem":2},{"text":"тіло моє тужить за Тобою","poem":1},{"text":"у землі висохлій і виснаженій, де немає води.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Так я споглядав Тебе у святилищі,","poem":1},{"text":"щоб побачити могутність Твою і славу.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Бо милість Твоя краща від самого життя,","poem":1},{"text":"тому вуста мої хвалитимуть Тебе.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Я благословлятиму Тебе, поки житиму,","poem":1},{"text":"в ім’я Твоє піднесу мої руки.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Неначе лоєм і олією, насичується душа моя,","poem":1},{"text":"і вуста мої радісно прославляють Тебе,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"коли я згадую Тебе на моєму ложі,","poem":1},{"text":"у нічні години роздумую про Тебе.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Бо Ти був мені допомогою,","poem":1},{"text":"і в тіні Твоїх крил я радітиму.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Прилинула до Тебе душа моя,","poem":1},{"text":"правиця ж Твоя підтримує мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"А ті, хто прагне загибелі для душі моєї,","poem":1},{"text":"нехай зійдуть у глибини землі.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нехай віддані мечу,","poem":1},{"text":"вони стануть здобиччю лисиць","poem":2},{"noteId":100},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Цар же нехай радіє Богом,","poem":1},{"text":"нехай прославляють Його всі, хто Ним присягає,","poem":2},{"text":"та замовкнуть вуста тих, хто промовляє неправду.","poem":1}]}],"footnotes":[{"noteId":99,"caller":"+","text":"Див. 1 Сам. 23–24; 2 Сам. 15:13–17:29.","reference":{"chapter":62,"verse":1}},{"noteId":100,"caller":"+","text":"Або: здобиччю шакалів.","reference":{"chapter":62,"verse":11}}]},"thisChapterLink":"/api/ukr_npu/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}