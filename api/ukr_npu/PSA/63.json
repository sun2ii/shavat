{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Боже, почуй мій голос, коли я скаржуся;","poem":1},{"text":"убережи мою душу від погроз ворога.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Сховай мене від таємних задумів злочинців,","poem":1},{"text":"від збурення тих, хто чинить беззаконня.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Вони нагострили язики свої, немов мечі,","poem":1},{"text":"націлили свої стріли – гіркі слова,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"щоб стріляти зі своїх засідок у невинного.","poem":1},{"text":"Вони стріляють зненацька й не бояться.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Підбадьорюють себе у справі лихій,","poem":1},{"text":"радяться, як таємно розставити тенета,","poem":2},{"lineBreak":true},{"text":"і кажуть: «Хто їх побачить?»","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ретельно обдумують свої майбутні беззаконня:","poem":1},{"text":"«Ми склали змову досконало!»","poem":2},{"text":"Справді, глибока внутрішність людини та її серце!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Але Бог випустить у них стрілу зненацька –","poem":1},{"text":"вони будуть уражені.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він зробить так,","poem":1},{"text":"що вони спіткнуться через язик свій і впадуть;","poem":2},{"text":"відсахнуться від них усі,","poem":1},{"text":"хто їх побачить.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Тоді страх охопить усіх людей,","poem":1},{"text":"і будуть сповіщати про діяння Бога","poem":2},{"lineBreak":true},{"text":"й про справи Його роздумувати.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Нехай праведник радіє в Господі","poem":1},{"text":"й покладає на Нього надію.","poem":2},{"text":"Тоді прославлені будуть усі щирі серцем.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}