{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів. Пісня.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Тобі, Боже, належить тиха хвала на Сіоні,","poem":1},{"text":"і перед Тобою будуть виконані обітниці.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ти чуєш молитву;","poem":1},{"text":"усе живе приходить до Тебе.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Здолали мене справи беззаконні,","poem":1},{"text":"але Ти очистиш нас від переступів наших.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Блаженний той, кого Ти обираєш і наближуєш,","poem":1},{"text":"щоб він мешкав у Твоїх дворах!","poem":2},{"text":"Ми наситимося благами Твого дому,","poem":1},{"text":"святого Твого Храму.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ти справедливо відповідаєш нам діяннями, що страх наводять,","poem":1},{"text":"Боже, Рятівнику наш,","poem":2},{"text":"надіє всіх країв землі","poem":1},{"text":"й далеких морів!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ти, підперезаний могутністю,","poem":1},{"text":"утверджуєш гори Своєю силою.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ти втихомирюєш шум морів,","poem":1},{"text":"шум їхніх хвиль і рик племен.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"І злякаються мешканці країв землі","poem":1},{"text":"через знаменні діяння Твої.","poem":2},{"text":"Вихід ранку й захід вечора","poem":1},{"text":"Ти вигуками радості наповнюєш","poem":2},{"noteId":101},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ти турбуєшся про землю й напуваєш її,","poem":1},{"text":"збагачуєш її щедро.","poem":2},{"text":"Потік Божий повний води –","poem":1},{"text":"Ти готуєш людям зерно,","poem":2},{"lineBreak":true},{"text":"бо так влаштував Ти землю.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ти зволожуєш її ріллю,","poem":1},{"text":"рівняєш її борозни,","poem":2},{"text":"розм’якшуєш рясними дощами,","poem":1},{"text":"благословляєш її збіжжя.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ти увінчуєш рік добротою Своєю,","poem":1},{"text":"і стежки Твої крапають жиром.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Крапають вологою пустельні пасовища,","poem":1},{"text":"і радістю оперізуються пагорби.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Луги вдяглися отарами худоби,","poem":1},{"text":"і долини вкрилися зерном.","poem":2},{"lineBreak":true},{"text":"Усі радісно вигукують і співають!","poem":2}]}],"footnotes":[{"noteId":101,"caller":"+","text":"Або: на сході й на заході.","reference":{"chapter":64,"verse":9}}]},"thisChapterLink":"/api/ukr_npu/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":14}