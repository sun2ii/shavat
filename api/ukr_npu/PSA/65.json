{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":65,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Пісня. Псалом.","descriptive":true},{"text":"Радісно вигукни Богові, уся земле!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Співайте славу імені Його,","poem":1},{"text":"хвалу Йому гідно віддайте.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Скажіть Богові: «Які грізні діяння Твої!","poem":1},{"text":"Заради великої могутності Твоєї","poem":2},{"lineBreak":true},{"text":"плазують перед Тобою вороги Твої.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Уся земля вклоняється Тобі","poem":1},{"text":"й співає Тобі,","poem":2},{"lineBreak":true},{"text":"співає славу імені Твоєму». Села","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Прийдіть, погляньте на звершення Бога –","poem":1},{"text":"Його справи викликають страх у синів людських.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Він перетворив море на суходіл,","poem":1},{"noteId":102},{"text":"через річку перейшли вони ногами,","poem":2},{"noteId":103},{"lineBreak":true},{"text":"там ми раділи в Ньому.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Він панує в могутності Своїй вічно,","poem":1},{"text":"Його очі стежать пильно за народами –","poem":2},{"lineBreak":true},{"text":"нехай не підносяться бунтівники! Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Благословляйте, народи, Бога нашого","poem":1},{"text":"й звіщайте голосно хвалу Йому.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Він зберіг серед живих душу нашу","poem":1},{"text":"й не дав ногам нашим похитнутися.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ти випробував нас, Боже,","poem":1},{"text":"переплавив нас, як переплавляють срібло.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ти завів нас у сіть,","poem":1},{"text":"поклав тягар на наші стегна.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Дозволив вершникам проїхати по головам нашим.","poem":1},{"text":"Ми пройшли крізь вогонь і воду,","poem":2},{"text":"але Ти вивів нас на благодатне місце.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Увійду я до дому Твого із цілопаленнями,","poem":1},{"text":"виконаю для Тебе всі мої обітниці,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"що їх висловили вуста мої","poem":1},{"text":"і промовив язик мій у скорботі.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Цілопалення жирних овець піднесу Тобі","poem":1},{"text":"разом із димом від спалення баранів;","poem":2},{"lineBreak":true},{"text":"я принесу Тобі в жертву биків і козлів. Села","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Прийдіть, послухайте,","poem":1},{"text":"усі, хто боїться Бога,","poem":2},{"lineBreak":true},{"text":"і я сповіщу вам, що Він зробив для душі моєї.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"До Нього я кликав моїми вустами,","poem":1},{"text":"і хвала піднесена на язиці у мене.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Якби я бачив беззаконня у своєму серці,","poem":1},{"text":"то не почув би мене Володар.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Але Бог почув,","poem":1},{"text":"зважив на голос моєї молитви!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Благословенний Бог,","poem":1},{"text":"Що не відхилив моєї молитви","poem":2},{"lineBreak":true},{"text":"й не забрав від мене милості Своєї!","poem":2}]}],"footnotes":[{"noteId":102,"caller":"+","text":"Див. Вих. 14.","reference":{"chapter":65,"verse":6}},{"noteId":103,"caller":"+","text":"Див. Іс. Нав. 3.","reference":{"chapter":65,"verse":6}}]},"thisChapterLink":"/api/ukr_npu/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":20}