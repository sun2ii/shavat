{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":66,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На струнних інструментах. Псалом. Пісня.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Боже, змилуйся над нами й благослови нас;","poem":1},{"text":"нехай засяє над нами Твоє обличчя, Села","poem":2}]},{"type":"verse","number":3,"content":[{"text":"щоб на землі пізнали Твої дороги,","poem":1},{"text":"і в усіх народах – Твоє спасіння.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Нехай прославлять Тебе народи, Боже,","poem":1},{"text":"нехай прославлять Тебе усі народи!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Нехай радіють і радісно вигукують племена,","poem":1},{"text":"бо Ти судиш народи справедливо","poem":2},{"lineBreak":true},{"text":"й керуєш племенами на землі. Села","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Нехай прославлять Тебе народи, Боже,","poem":1},{"text":"нехай прославлять Тебе усі народи!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Земля принесла свій врожай;","poem":1},{"text":"нехай благословить нас Бог, наш Бог!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Нехай благословить нас Бог,","poem":1},{"text":"і боятимуться Його всі краї землі.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":8}