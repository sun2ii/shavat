{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів. Пісня.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Нехай устане Бог, нехай розсіються вороги Його;","poem":1},{"text":"нехай втікають від Його обличчя ненависники Його!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Як розвіюється дим, так Ти їх розсій!","poem":1},{"text":"Як тане віск від вогню,","poem":2},{"lineBreak":true},{"text":"так нехай згинуть нечестивці від обличчя Божого.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"А праведники нехай радіють,","poem":1},{"text":"нехай веселяться перед Богом","poem":2},{"lineBreak":true},{"text":"і тішаться в радості.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Співайте Богові, грайте, підносьте ім’я Того, Села","poem":1},{"text":"Хто на хмарах, як на колісниці, їде,","poem":2},{"text":"Чиє ім’я – Господь;","poem":1},{"text":"радійте перед обличчям Його!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Батько сиріт і Суддя вдів –","poem":1},{"text":"Бог у Своїй Святій оселі.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Бог поселяє самотніх у дім,","poem":1},{"text":"звільняє в’язнів на благодатні простори,","poem":2},{"text":"а непокірні мешкають на виснаженій землі.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Боже, коли Ти йшов перед народом,","poem":1},{"text":"коли Ти крокував дикою пустелею, Села","poem":2}]},{"type":"verse","number":9,"content":[{"text":"земля здригалася,","poem":1},{"text":"навіть небеса розпливалися перед обличчям Бога;","poem":2},{"text":"перед Тим, Хто на Синаї,","poem":1},{"text":"перед обличчям Бога Ізраїлю.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Рясним дощем Ти зрошував, Боже,","poem":1},{"text":"Свій спадок – землю Твою.","poem":2},{"text":"А коли вона виснажувалася,","poem":1},{"text":"Ти підтримував її.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Твій люд поселився на ній;","poem":1},{"text":"за добротою Твоєю, Боже, Ти підтримував пригнобленого.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Володар промовив слово –","poem":1},{"text":"сила-силенна благовісників передають його:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«Царі з військами зазнають поразки й втікають,","poem":1},{"text":"а жінка, що мешкає вдома, ділить здобич війни.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Навіть якщо ви затишно спочиваєте вдома,","poem":1},{"noteId":104},{"text":"ви будете як та голубка,","poem":2},{"text":"чиї крила вкриті сріблом,","poem":1},{"text":"а пір’я її – переливним золотом».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Коли Всемогутній розсіяв царів на обраній Ним землі,","poem":1},{"text":"це було як сніг, що випадає на гору Цальмон.","poem":2},{"noteId":105}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Гора Божа – гора Башан;","poem":1},{"text":"гора кількох вершин – гора Башан!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Чому ви заздрісно поглядаєте, гори з кількома вершинами,","poem":1},{"text":"на гору, яку вподобав Бог, щоб перебувати на ній?","poem":2},{"lineBreak":true},{"text":"Господь буде перебувати там повіки!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Колісниць Божих – десятки тисяч, тисячі тисяч.","poem":1},{"text":"Володар прийшов від Синаю у Своє святилище.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ти піднявся на висоту, полонив бранців,","poem":1},{"text":"прийняв дари від людей,","poem":2},{"text":"навіть від непокірних,","poem":1},{"text":"щоб вони могли мешкати там, Господи Боже.","poem":2},{"noteId":106}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Благословенний Володар!","poem":1},{"text":"Він щоденно носить тягарі наші;","poem":2},{"text":"Він – Бог, Який рятує нас. Села","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Бог для нас – Бог спасіння,","poem":1},{"text":"і в Господа Володаря – визволення від смерті.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Так, Бог вразить голову ворогів Своїх,","poem":1},{"text":"волохату маківку того, хто вперто ходить у своїх гріхах.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Сказав Володар: «Із Башану поверну тебе,","poem":1},{"text":"витягну з безодні морської,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"щоб ти занурив ногу твою у кров ворогів","poem":1},{"text":"і язики твоїх псів почастувалися нею».","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Побачили вони ходу Твою, Боже, –","poem":1},{"text":"як іде Бог мій, Цар мій у Святилищі.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Попереду співаки йдуть,","poem":1},{"text":"позаду – ті, хто грає на струнах,","poem":2},{"lineBreak":true},{"text":"посередині – дівчата дзвенять на бубнах.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Благословіть Бога на зборах,","poem":1},{"text":"благословітьГоспода, нащадки Ізраїля.","poem":2},{"noteId":107}]},{"type":"verse","number":28,"content":[{"text":"Там їх веде наймолодший Веніамін,","poem":1},{"text":"потім князі Юди гуртом великим,","poem":2},{"lineBreak":true},{"text":"а також князі Зевулонові й Нефалимові йдуть.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Наказав Бог Твій зміцнити тебе.","poem":1},{"noteId":108},{"text":"Дай, Боже, сили, як Ти робив це для нас раніше.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Заради Храму Твого в Єрусалимі","poem":1},{"text":"царі принесуть Тобі дари.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Пригрози тому звірові в очереті,","poem":1},{"noteId":109},{"text":"отому зібранню найсильніших телят народів,","poem":2},{"text":"які забруднюють себе заради шматків срібла;","poem":1},{"text":"розсій народи, що бажають війни.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Прийдуть вельможні","poem":1},{"noteId":110},{"text":"з Єгипту,","poem":1},{"text":"Куш","poem":2},{"noteId":111},{"text":"простягне свої руки до Бога.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Царства землі, співайте Богові!","poem":1},{"text":"Грайте на славу Володареві нашому, Села","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Який їде на колісниці в небесах споконвічних:","poem":1},{"text":"ось Він подасть Свій могутній голос.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Визнайте, що сила у Бога,","poem":1},{"text":"над Ізраїлем – Його велич,","poem":2},{"lineBreak":true},{"text":"і могутність Його – на хмарах.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Страшний Бог у святилищі Своєму,","poem":1},{"text":"Бог Ізраїлю, Який дає силу й міць народові.","poem":2},{"lineBreak":true},{"text":"Благословенний Бог!","poem":1}]}],"footnotes":[{"noteId":104,"caller":"+","text":"Тут вжито метафору навіть якщо ви між саквами спочиваєте, що означає жити спокійно й затишно.","reference":{"chapter":67,"verse":14}},{"noteId":105,"caller":"+","text":"Гора Цальмон, імовірно, те ж саме, що й гора Хермон (у грецькому перекладі Суд. 9:48стоїть саме Хермон як відповідник євр. Цальмо́н). Гора Хермон і сьогодні відома в Ізраїлі як місце, де взимку регулярно випадає сніг.","reference":{"chapter":67,"verse":15}},{"noteId":106,"caller":"+","text":"У цьому вірші Бог зображений як переможець народів, Який отримує дари від них на знак лояльності, а потім дарує їм право жити на підкореній Ним землі.","reference":{"chapter":67,"verse":19}},{"noteId":107,"caller":"+","text":"Буквально: ті, хто від джерела Ізраїля.","reference":{"chapter":67,"verse":27}},{"noteId":108,"caller":"+","text":"Так у єврейському тексті; у грецькому та сирійському перекладах: Збери, Боже, силу Свою.","reference":{"chapter":67,"verse":29}},{"noteId":109,"caller":"+","text":"Звір в очереті, тобто крокодил або гіпопотам – образ Єгипту.","reference":{"chapter":67,"verse":31}},{"noteId":110,"caller":"+","text":"Або: вдягнені у бронзові обладунки.","reference":{"chapter":67,"verse":32}},{"noteId":111,"caller":"+","text":"Куш – давня назва Етіопії.","reference":{"chapter":67,"verse":32}}]},"thisChapterLink":"/api/ukr_npu/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":36}