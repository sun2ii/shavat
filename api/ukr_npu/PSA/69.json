{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":69,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом Давидів. На спомин.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Боже, визволи мене!","poem":1},{"text":"Господи, поспіши мені на допомогу!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Нехай посоромляться й ганьбою вкриються ті,","poem":1},{"text":"хто шукає душі моєї.","poem":2},{"text":"Нехай відсахнуться назад і спіткнуться ті,","poem":1},{"text":"хто бажає мені зла.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нехай назад обернуться через свій сором ті,","poem":1},{"text":"що говорять мені: «Ага! Ага!»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Нехай же веселяться й радіють Тобою всі,","poem":1},{"text":"хто шукає Тебе.","poem":2},{"text":"Нехай ті, хто любить спасіння Твоє, говорять безупинно:","poem":1},{"text":"«Звеличився Бог!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Я ж принижений та бідний.","poem":1},{"text":"Боже, поспіши до мене!","poem":2},{"text":"Допомога моя і Визволитель мій – Ти;","poem":1},{"text":"Господи, не зволікай!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":6}