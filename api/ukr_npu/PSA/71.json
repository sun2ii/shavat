{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Про Соломона.","descriptive":true},{"text":"Боже, даруй Твоє правосуддя цареві","poem":1},{"text":"і праведність Твою – синові царя.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Нехай судить він народ Твій справедливо","poem":1},{"text":"й страдників Твоїх – чесно.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Нехай гори принесуть народові мир,","poem":1},{"text":"а пагорби – праведність.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нехай судить він пригнічених народу,","poem":1},{"text":"врятує дітей бідняків","poem":2},{"lineBreak":true},{"text":"і вразить гнобителя.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Будуть боятися Тебе, аж поки сонце і місяць існують,","poem":1},{"text":"із роду в рід.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Нехай зійде він як дощ на покіс,","poem":1},{"text":"як рясний дощ, що зрошує землю.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"У дні його нехай процвітає праведник","poem":1},{"text":"і мир великий не припиняється,","poem":2},{"text":"аж поки місяць не згасне.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Він пануватиме від моря й до моря","poem":1},{"text":"і від ріки","poem":2},{"noteId":115},{"text":"аж до країв землі.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Схилять перед ним коліна мешканці пустель,","poem":1},{"text":"і вороги його лизатимуть пил.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Царі Таршишу","poem":1},{"noteId":116},{"text":"й віддалених берегів платитимуть йому данину,","poem":1},{"text":"царі Шеви і Севи","poem":2},{"noteId":117},{"text":"піднесуть дари на знак покори.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"І вклоняться йому всі царі,","poem":1},{"text":"усі народи служитимуть йому.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Бо врятує він бідного, коли той волатиме,","poem":1},{"text":"і пригніченого, у якого немає помічника.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Він милість виявить убогому й бідняку","poem":1},{"text":"і врятує душі злидарів.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Викупить душі їхні з-під влади насильства,","poem":1},{"text":"адже кров їхня буде дорогоцінна в очах його.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Нехай він живе довго,","poem":1},{"text":"і нехай дано йому буде золото Шеви.","poem":2},{"text":"Нехай моляться за нього завжди,","poem":1},{"text":"нехай цілий день благословляють його!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Нехай пшениці буде вдосталь на землі;","poem":1},{"text":"на вершинах пагорбів нехай коливається колосся,","poem":2},{"lineBreak":true},{"text":"немов на Лівані,","poem":2},{"text":"і люд рясніє в містах,","poem":1},{"text":"немов трава на землі.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Нехай ім’я його перебуває вічно,","poem":1},{"text":"аж поки існує сонце.","poem":2},{"lineBreak":true},{"text":"Через нього благословенними будуть усі народи;","poem":1},{"text":"вони вважатимуть його тим, що щастя приносить.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Благословенний Господь, Бог Ізраїля,","poem":1},{"text":"Який один лиш творить чудеса!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Благословенне ім’я слави Його повік,","poem":1},{"text":"і вся земля наповниться Його славою!","poem":2},"Амінь і амінь!"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Завершилися молитви Давида, сина Єссеєвого.","poem":1}]}],"footnotes":[{"noteId":115,"caller":"+","text":"Імовірно, мається на увазі ріка Євфрат: саме так передано цей вираз у Тарґумі на Книгу Псалмів (переклад арамейською).","reference":{"chapter":71,"verse":8}},{"noteId":116,"caller":"+","text":"Див. примітку до Пс. 47:8.","reference":{"chapter":71,"verse":10}},{"noteId":117,"caller":"+","text":"Шева і Сева – назви держави в Південній Аравії, що з давніх часів славилася своєю високою культурою і багатством (Єз. 27:22, 23; 38:13); цариця Шеви приходила послухати мудрості царя Соломона (1 Цар. 10:1-13).","reference":{"chapter":71,"verse":10}}]},"thisChapterLink":"/api/ukr_npu/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":20}