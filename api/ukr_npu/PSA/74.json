{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":74,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив «Не згуби». Псалом Асафа. Пісня.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Славимо Тебе, Боже, славимо,","poem":1},{"text":"бо близьке ім’я Твоє;","poem":2},{"lineBreak":true},{"text":"люди проголошують чудеса Твої.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Бо Ти сказав: «Я оберу певний час","poem":1},{"text":"і справедливо судитиму.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Тане земля","poem":1},{"noteId":122},{"text":"й мешканці її –","poem":1},{"text":"Я утверджу її стовпи». Села","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Сказав Я зухвалим: «Не бундючтеся!» –","poem":1},{"text":"і нечестивим: «Не підносьте рога!»","poem":2},{"noteId":123}]},{"type":"verse","number":6,"content":[{"text":"Не підносьте високо роги ваші,","poem":1},{"text":"не говоріть зухвало, твердо поставивши шию.","poem":2},{"noteId":124}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Бо не зі сходу, не із заходу","poem":1},{"text":"й не з пустелі приходить піднесення.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Адже Бог – Суддя:","poem":1},{"text":"одного принижує, іншого підносить.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Бо чаша в руці Господа –","poem":1},{"text":"пінисте вино, повна суміші вона,","poem":2},{"text":"і Він виливає з неї;","poem":1},{"text":"навіть гущу її висмокчуть і вип’ють","poem":2},{"text":"усі нечестивці землі.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"А я звіщатиму це повіки,","poem":1},{"text":"співатиму Богові Якова:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"«Усі роги нечестивих повідрубую,","poem":1},{"text":"а роги праведних піднесуться».","poem":2}]}],"footnotes":[{"noteId":122,"caller":"+","text":"Танення або коливання землі вживаються часто як образ нехтування правосуддям людьми, Див. Пс. 10:4.","reference":{"chapter":74,"verse":4}},{"noteId":123,"caller":"+","text":"Ріг – символ могутності і влади; див. також вірші 6 та 11.","reference":{"chapter":74,"verse":5}},{"noteId":124,"caller":"+","text":"Або: вперто, зарозуміло.","reference":{"chapter":74,"verse":6}}]},"thisChapterLink":"/api/ukr_npu/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":11}