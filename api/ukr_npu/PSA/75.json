{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На струнних інструментах. Псалом Асафа. Пісня.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Відомий в Юдеї Бог,","poem":1},{"text":"в Ізраїлі величне ім’я Його.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Був у Салемі","poem":1},{"noteId":125},{"text":"намет Його,","poem":1},{"text":"і помешкання Його – на Сіоні.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Там зламав Він полум’яні стріли лука,","poem":1},{"text":"щит і меч, і війну припинив. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ти осяяний величчю","poem":1},{"text":"більше, ніж ті гори, що здобичі повні.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Міцні серцем стали здобиччю,","poem":1},{"text":"заснули сном своїм останнім;","poem":2},{"lineBreak":true},{"text":"Сильні мужі не можуть поворухнути своїми руками.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Від грізних докорів Твоїх, Боже Якова,","poem":1},{"text":"застигли колісниця і кінь.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ти – грізний,","poem":1},{"text":"хто встоїть перед обличчям Твоїм","poem":2},{"lineBreak":true},{"text":"у час гніву Твого?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"З небес Ти проголосив суд –","poem":1},{"text":"земля злякалась і затихла,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"коли повстав Бог, щоб судити,","poem":1},{"text":"щоб врятувати всіх пригнічених землі. Села","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Адже навіть гнів людський обернеться на славу Тобі,","poem":1},{"text":"а рештою гніву Ти переможно оперезаєш Себе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Давайте обітниці Господеві, Богові вашому, і виконуйте їх;","poem":1},{"text":"усі, хто навколо Нього, нехай принесуть дар Грізному.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Він приборкує дух вождів,","poem":1},{"text":"страшний Він для царів землі.","poem":2}]}],"footnotes":[{"noteId":125,"caller":"+","text":"Салим – давня назва Єрусалима, див Бут. 14:18.","reference":{"chapter":75,"verse":3}}]},"thisChapterLink":"/api/ukr_npu/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":13}