{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору, Єдутуну.","descriptive":true},{"noteId":126},{"text":"Псалом Асафів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Голосом своїм я волатиму до Бога,","poem":1},{"text":"голосом моїм – до Бога, і Він прислухається до мене.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"У день скорботи моєї я шукав Володаря;","poem":1},{"text":"цілу ніч моя рука була простягнута й не затерпла.","poem":2},{"text":"Моя душа відмовлялася від втіхи.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Згадаю про Бога – і охопить мене трепет;","poem":1},{"text":"пороздумую – і знемагає дух мій. Села.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ти тримав розплющеними повіки очей моїх;","poem":1},{"text":"я вражений і не можу говорити.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Подумав я про дні давноминулі,","poem":1},{"text":"про роки давні.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Згадую наспіви мої вночі,","poem":1},{"text":"із серцем своїм веду розмову,","poem":2},{"lineBreak":true},{"text":"і дух мій дошукується:","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Невже навіки покинув нас Володар","poem":1},{"text":"і більше не буде прихильним?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Невже назавжди зникла Його милість,","poem":1},{"text":"припинилося Його слово на всі наступні покоління?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Хіба забув Бог, як милувати,","poem":1},{"text":"чи замкнув у гніві милосердя Своє? Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Тоді сказав я: «Що гнітить мене,","poem":1},{"text":"так це те, що Всевишній змінив дію правиці Своєї щодо нас».","poem":2},{"noteId":127}]},{"type":"verse","number":12,"content":[{"text":"Згадаю я про діяння Господа;","poem":1},{"text":"нагадаю-но собі про чудеса стародавні.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Споглядатиму всі справи Твої","poem":1},{"text":"і про звершення Твої роздумувати буду.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Боже, у святості шлях Твій!","poem":1},{"text":"Який бог настільки великий, як наш Бог?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ти – Бог, Який творить чудеса;","poem":1},{"text":"Ти з’явив могутність Свою серед народів.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ти визволив рукою Своєю народ Твій,","poem":1},{"text":"синів Якова і Йосифа. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Побачили Тебе води, Боже,","poem":1},{"text":"побачили Тебе води й затремтіли,","poem":2},{"lineBreak":true},{"text":"здригнулися безодні.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Потоками лилася вода із темних хмар,","poem":1},{"text":"свій голос подали хмарини,","poem":2},{"lineBreak":true},{"text":"і стріли Твої розліталися.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Гуркіт Твого грому на небокраї,","poem":1},{"text":"спалахи блискавок освітлювали всесвіт,","poem":2},{"lineBreak":true},{"text":"земля тремтіла й здригалася.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Шлях Твій пролягав через море,","poem":1},{"text":"і стежки Твої – через води великі,","poem":2},{"lineBreak":true},{"text":"та слідів Твоїх не було видно.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ти вів, немов отару, народ Свій","poem":1},{"text":"рукою Мойсея і Аарона.","poem":2}]}],"footnotes":[{"noteId":126,"caller":"+","text":"Див. Пс. 61:1; 1 Хр. 16:41, 42.","reference":{"chapter":76,"verse":1}},{"noteId":127,"caller":"+","text":"Тобто змінив Своє ставлення до нас.","reference":{"chapter":76,"verse":11}}]},"thisChapterLink":"/api/ukr_npu/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":21}