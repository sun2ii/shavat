{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":77,"content":[{"type":"verse","number":1,"content":[{"text":"Повчання Асафові.","descriptive":true},{"text":"Послухай-но, народе мій, настанову мою,","poem":1},{"text":"схиліть вуха свої до слів моїх вуст!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Відкрию в притчі вуста мої,","poem":1},{"text":"промовлю загадки прадавніх часів,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"які ми чули й пізнали","poem":1},{"text":"і які розповідали нам предки наші.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Не будемо приховувати їх від синів наших,","poem":1},{"text":"розкажемо наступному поколінню","poem":2},{"text":"про хвалу Господа й могутність Його,","poem":1},{"text":"про чудеса, які Він здійснив.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Він засвідчив одкровення Своє Якову","poem":1},{"text":"й встановив в Ізраїлі Закон Свій,","poem":2},{"text":"який заповідав предкам нашим,","poem":1},{"text":"щоб вони навчили нащадків своїх,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"щоб знало наступне покоління,","poem":1},{"text":"щоб діти, що народитися мають,","poem":2},{"lineBreak":true},{"text":"сповістили свого часу й своїм нащадкам.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Тоді вони сподівання своє покладуть на Бога,","poem":1},{"text":"і не забуватимуть діянь Божих,","poem":2},{"lineBreak":true},{"text":"і будуть дотримуватися Його заповідей.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Вони не будуть подібні до своїх предків,","poem":1},{"text":"покоління впертого й бунтівного,","poem":2},{"text":"роду, чиє серце непевне","poem":1},{"text":"і чий дух невірний Богові.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Сини Єфремові, хоча й озброєні стрільці з лука,","poem":1},{"text":"назад повернулися у день битви.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Не дотримувалися вони Завіту Божого","poem":1},{"text":"й відмовилися ходити в Законі Божому.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Вони забули про Його звершення й чудеса,","poem":1},{"text":"що Він їм показав.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Перед предками їхніми здійснив Він чудо","poem":1},{"text":"в землі Єгипту, в околицях Цоану","poem":2},{"noteId":128},{"text":".","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Він розділив навпіл море й провів їх через нього,","poem":1},{"text":"і поставив води грудами.","poem":2},{"noteId":129}]},{"type":"verse","number":14,"content":[{"text":"Вів їх хмарою вдень,","poem":1},{"text":"і цілу ніч – світлом вогню.","poem":2},{"noteId":130}]},{"type":"verse","number":15,"content":[{"text":"Він розсікав скелі в пустелі","poem":1},{"text":"й напував їх, немов із великої безодні.","poem":2},{"noteId":131}]},{"type":"verse","number":16,"content":[{"text":"Із скелі вивів потоки,","poem":1},{"text":"і потекли рікою води.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Але вони продовжували грішити проти Нього,","poem":1},{"text":"бунтувати проти Всевишнього на висохлій землі.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Випробовували Бога в серцях своїх,","poem":1},{"text":"вимагаючи їжу за своїми примхами.","poem":2},{"noteId":132}]},{"type":"verse","number":19,"content":[{"text":"Вони говорили зухвало проти Бога, кажучи:","poem":1},{"text":"«Чи не міг би Бог накрити стіл у пустелі?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ось Він вдарив скелю, і потекли води,","poem":1},{"text":"хлинули потоки.","poem":2},{"text":"Хіба ж не може Він дати хліба","poem":1},{"text":"чи приготувати м’яса народові Своєму?»","poem":2},{"noteId":133}]},{"type":"verse","number":21,"content":[{"text":"Тому, коли почув це Господь, то розгнівався:","poem":1},{"text":"вогонь загорівся проти Якова,","poem":2},{"lineBreak":true},{"text":"і гнів Його спалахнув на Ізраїля,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"бо не повірили вони Богові","poem":1},{"text":"й не покладали надії на Його спасіння.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Тож наказав Він хмарам вгорі,","poem":1},{"text":"і відчинив ворота небес,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"і дощем пролив на них манну, щоб їли,","poem":1},{"text":"і дав їм зерно небесне.","poem":2},{"noteId":134}]},{"type":"verse","number":25,"content":[{"text":"Хліб могутніх","poem":1},{"noteId":135},{"text":"їла людина,","poem":1},{"text":"Він послав їм їжі вдосталь.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Він здійняв східний вітер у небесах","poem":1},{"text":"і навів Своєю могутністю вітер південний.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Дощем пролив Він на них м’ясо, немов пил,","poem":1},{"text":"і, неначе пісок морський, – птахів крилатих,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"яких розкидав Він серед табору,","poem":1},{"text":"навколо помешкань їхніх.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Вони їли й добре наситилися –","poem":1},{"text":"Він задовольнив бажання їхнє.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Та ще не встигли вони вгамувати своєї примхи,","poem":1},{"text":"ще їжа була в них на вустах,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"як гнів Божий піднявся проти них,","poem":1},{"text":"і вигубив найбільш пишних із них,","poem":2},{"text":"і повалив додолу юнаків Ізраїля.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Та попри все це вони далі грішили","poem":1},{"text":"й не вірили чудесам Його.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Тому Він загубив дні їхні в марноті","poem":1},{"text":"й роки їхні – у смутку.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Коли Він вбивав їх, тоді вони шукали Його,","poem":1},{"text":"і наверталися, і прагнули Бога.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"І згадували, що Бог – їхня скеля","poem":1},{"text":"і що Бог Всевишній – їхній Визволитель.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Тоді промовляли Йому лестощі устами своїми","poem":1},{"text":"і язиками своїми неправду перед Ним говорили;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"та серцями своїми не були вони з Ним щирі","poem":1},{"text":"й не берегли вірності Його Завітові.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Та Він, милостивий,","poem":1},{"text":"прощав гріх","poem":2},{"text":"і не знищував їх.","poem":1},{"text":"Багато разів відвертав гнів Свій","poem":2},{"lineBreak":true},{"text":"і не будив усієї Своєї люті.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Він пам’ятав, що вони – тіло,","poem":1},{"text":"вітер, що йде й не повертається.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Скільки разів вони бунтували проти Нього в пустелі,","poem":1},{"text":"засмучували Його в дикій землі!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Знову й знову випробовували Бога","poem":1},{"text":"й засмучували Святого Ізраїлевого.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Не пам’ятали ні діянь руки Його,","poem":1},{"text":"ні того дня, коли Він визволив їх від ворога,","poem":2}]},{"type":"verse","number":43,"content":[{"text":"коли ознаки Свої показав у Єгипті","poem":1},{"text":"й чудеса Свої в околицях Цоану.","poem":2},{"noteId":136}]},{"type":"verse","number":44,"content":[{"text":"Він перетворив їхні ріки на кров,","poem":1},{"text":"і з потоків своїх вони пити не могли.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Він послав на них рої комах,","poem":1},{"text":"які пожирали їх,","poem":2},{"lineBreak":true},{"text":"і жаб, що губили їх.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Він віддав врожай їхній гусені","poem":1},{"text":"й збіжжя їхнє – сарані.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Побив виноградники їхні градом","poem":1},{"text":"і шовковиці – кригою.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Він віддав на поталу градові їхню худобу","poem":1},{"text":"й отари їхні – блискавкам.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Він послав на них полум’я Свого гніву,","poem":1},{"text":"лють, обурення й біду –","poem":2},{"lineBreak":true},{"text":"посольство злих ангелів.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Вирівняв стежку для гніву Свого;","poem":1},{"text":"не утримав їхніх душ від смерті,","poem":2},{"lineBreak":true},{"text":"але віддав життя їхнє на поталу моровиці.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"І вразив усіх первістків у Єгипті –","poem":1},{"text":"перші плоди сили чоловічої в шатрах Хамових.","poem":2},{"noteId":137}]},{"type":"verse","number":52,"content":[{"text":"Немов овець отару, Він вивів народ Свій,","poem":1},{"text":"і, неначе стадо, провадив їх у пустелі.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Вів їх у безпеці, так що вони не боялися,","poem":1},{"text":"а ворогів їхніх вкрило море.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"І привів їх до границь святині Своєї,","poem":1},{"text":"до тієї гори, яку здобула Його правиця.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Прогнав перед ними народи,","poem":1},{"text":"і простягнув мотузку землемірну,","poem":2},{"lineBreak":true},{"text":"щоб спадок їхній переділити,","poem":2},{"text":"і в наметах їхніх поселив племена Ізраїлеві.","poem":1}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Але вони випробовували Бога Всевишнього,","poem":1},{"text":"бунтували проти Нього","poem":2},{"lineBreak":true},{"text":"й не дотримувалися Його одкровень.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"І відступали, і зраджували, як і батьки їхні;","poem":1},{"text":"викручувалися, як висковзує з рук кривий лук.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Гнівили Його в капищах на своїх пагорбах","poem":1},{"text":"та ідолами своїми будили Його ревнощі.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Почув Бог, і запалав гнівом,","poem":1},{"text":"і геть відцурався Ізраїля.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Покинув Оселю Свою в Шило –","poem":1},{"text":"шатро, в якому Він мешкав серед людей.","poem":2},{"noteId":138}]},{"type":"verse","number":61,"content":[{"text":"І віддав Він могутність Свою у полон","poem":1},{"text":"і красу Свою – у руки ворога.","poem":2},{"noteId":139}]},{"type":"verse","number":62,"content":[{"text":"Віддав Він народ Свій мечу на поталу","poem":1},{"text":"й гнівом запалав на спадщину Свою.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Юнаків їхніх пожер вогонь,","poem":1},{"text":"а їхнім дівчатам весільних пісень не співали.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Священники його попадали від меча,","poem":1},{"text":"а вдови його не плакали.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Тоді прокинувся Володар, немов від сну,","poem":1},{"text":"неначе воїн, що витверезився від вина.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"І вразив ворогів його ззаду,","poem":1},{"text":"вкрив їх вічною ганьбою.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Тоді відцурався Він шатра Йосифового","poem":1},{"text":"й не обрав племені Єфремового.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Але вибрав Він плем’я Юди,","poem":1},{"text":"гору Сіон, яку полюбив.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Він збудував, немов висоти небес, святилище Своє,","poem":1},{"text":"і, як землю, заклав основи його навіки.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"І обрав Свого слугу Давида,","poem":1},{"text":"узявши його від кошар овечих,","poem":2},{"noteId":140}]},{"type":"verse","number":71,"content":[{"text":"привів його від овечок дійних,","poem":1},{"text":"щоб пасти Якова, народ Свій,","poem":2},{"text":"Ізраїля, Свій спадок.","poem":3}]},{"type":"verse","number":72,"content":[{"text":"І він пас їх у невинності свого серця","poem":1},{"text":"і вів їх розумно руками своїми.","poem":2}]}],"footnotes":[{"noteId":128,"caller":"+","text":"Цоан – те саме, що й Раамсес. Див. Вих. 1:11; Чис. 13:22.","reference":{"chapter":77,"verse":12}},{"noteId":129,"caller":"+","text":"Див. Вих. 14.","reference":{"chapter":77,"verse":13}},{"noteId":130,"caller":"+","text":"Див. Вих. 13:21.","reference":{"chapter":77,"verse":14}},{"noteId":131,"caller":"+","text":"Див. Вих. 17:1-7; Чис. 20:2-13.","reference":{"chapter":77,"verse":15}},{"noteId":132,"caller":"+","text":"Буквально: за душею своєю, тобто як їхня душа бажала.","reference":{"chapter":77,"verse":18}},{"noteId":133,"caller":"+","text":"Див. Чис. 11.","reference":{"chapter":77,"verse":20}},{"noteId":134,"caller":"+","text":"Див. Вих. 16:4-5.","reference":{"chapter":77,"verse":24}},{"noteId":135,"caller":"+","text":"У грецькому перекладі хліб ангелів.","reference":{"chapter":77,"verse":25}},{"noteId":136,"caller":"+","text":"Див. вірш 12-й, а також Вих. 7–11.","reference":{"chapter":77,"verse":43}},{"noteId":137,"caller":"+","text":"Єгиптяни були нащадками Хама. Див. Бут. 10:6-10.","reference":{"chapter":77,"verse":51}},{"noteId":138,"caller":"+","text":"Шатро або Оселя знаходилася в Шило в той час. Див. Іс. Нав. 18:1.","reference":{"chapter":77,"verse":60}},{"noteId":139,"caller":"+","text":"Див. 1 Сам. 4.","reference":{"chapter":77,"verse":61}},{"noteId":140,"caller":"+","text":"Див. 1 Сам. 16:1-13.","reference":{"chapter":77,"verse":70}}]},"thisChapterLink":"/api/ukr_npu/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":72}