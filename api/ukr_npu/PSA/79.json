{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":79,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив «Лілея». Свідчення. Псалом Асафів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Почуй нас, о Пастирю Ізраїля!","poem":1},{"text":"Ти, Що ведеш Йосифа, немов отару овець,","poem":2},{"text":"Котрий сидиш на престолі між херувимами, з’яви Себе","poem":1}]},{"type":"verse","number":3,"content":[{"text":"перед Єфремом, Веніаміном і Манассією!","poem":2},{"text":"Пробуди могутність Свою","poem":1},{"text":"й прийди, щоб врятувати нас!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Боже, віднови нас,","poem":1},{"text":"засяй обличчям Твоїм,","poem":2},{"lineBreak":true},{"text":"і ми будемо врятовані!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Господи, Боже Воїнств,","poem":1},{"text":"доки таїтимеш гнів","poem":2},{"lineBreak":true},{"text":"на молитви народу Свого?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ти нагодував нас хлібом скорботним,","poem":1},{"text":"напоїв нас сльозами сповна,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"зробив нас причиною суперечки між сусідами нашими,","poem":1},{"text":"і глузують з нас вороги наші.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Боже Воїнств, віднови нас,","poem":1},{"text":"засяй обличчям Твоїм,","poem":2},{"lineBreak":true},{"text":"і ми будемо врятовані!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ти приніс з Єгипту виноградну галузку,","poem":1},{"text":"прогнав народи, а її насадив.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ти очистив місце для неї –","poem":1},{"text":"вона пустила своє коріння","poem":2},{"text":"й наповнила землю.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Гори вкрилися її тінню,","poem":1},{"text":"і кедри могутні – її гілками.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Розкинула свої пагони аж до моря","poem":1},{"text":"і аж до ріки Євфрат – своє молоде галуззя.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Навіщо ж зруйнував Ти її огорожу,","poem":1},{"text":"так що плоди її зривають усі перехожі?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Підриває її вепр лісовий,","poem":1},{"text":"і все, що рухається на полях, об’їдає її.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Боже Воїнств, повернися до нас,","poem":1},{"text":"поглянь із небес, на нас подивися!","poem":2},{"text":"Збережи цю виноградну лозу,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"це коріння, яке насадила Твоя правиця,","poem":2},{"text":"галуззя,","poem":1},{"noteId":142},{"text":"яке Ти зміцнив для Себе.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Вогнем обпалена, обсічена лоза,","poem":1},{"text":"від докорів Твоїх гине люд Твій.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Нехай рука Твоя буде над мужем правиці Твоєї,","poem":1},{"text":"над сином людським,","poem":2},{"lineBreak":true},{"text":"якого Ти зміцнив для Себе.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Тоді ми не відступимо від Тебе;","poem":1},{"text":"оживи нас,","poem":2},{"lineBreak":true},{"text":"і будемо кликати ім’я Твоє.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Господи, Боже Воїнств, віднови нас!","poem":1},{"text":"Нехай засяє над нами обличчя Твоє, і ми будемо врятовані!","poem":2}]}],"footnotes":[{"noteId":142,"caller":"+","text":"Буквально: сина.","reference":{"chapter":79,"verse":16}}]},"thisChapterLink":"/api/ukr_npu/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":20}