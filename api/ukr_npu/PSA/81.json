{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":81,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом Асафів.","descriptive":true},{"text":"Бог стоїть у божественному зібранні,","poem":1},{"text":"судить серед богів:","poem":2},{"noteId":147}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Доки ви будете судити беззаконно","poem":1},{"text":"й догоджати нечестивим? Села","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Судіть чесно бідняка й сироту,","poem":1},{"text":"виправдайте приниженого й злидаря.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Визволяйте вбогого й бідного,","poem":1},{"text":"рятуйте їх від руки нечестивих.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Не знають, не розуміють судді,","poem":1},{"text":"вони ходять у темряві.","poem":2},{"lineBreak":true},{"text":"Здригаються всі основи землі.","poem":2},{"noteId":148}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Я сказав: „Ви – боги,","poem":1},{"text":"усі ви – сини Всевишнього“,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"але ви помрете, як люди,","poem":1},{"text":"попадаєте, як будь-хто інший із князів».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Повстань, Боже, суди землю,","poem":1},{"text":"адже Ти приймеш у спадок усі народи!","poem":2}]}],"footnotes":[{"noteId":147,"caller":"+","text":"Богами іноді називаються в Біблії судді або старійшини народу; Див. Вих. 21:6.","reference":{"chapter":81,"verse":1}},{"noteId":148,"caller":"+","text":"Хитання основ землі – це образ несправедливості у світі; Див. Пс. 10:3.","reference":{"chapter":81,"verse":5}}]},"thisChapterLink":"/api/ukr_npu/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":8}