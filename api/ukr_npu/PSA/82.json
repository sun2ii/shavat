{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Пісня. Псалом Асафів.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Боже, не залишайся в тиші,","poem":1},{"text":"не мовчи й не заспокоюйся, о Боже!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Адже вороги Твої гомонять","poem":1},{"text":"і ненависники Твої підняли голови.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Складають змову проти Твого народу","poem":1},{"text":"й радяться проти тих, кого Ти бережеш.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Сказали вони: «Ходімо, знищимо їх з-поміж народів,","poem":1},{"text":"і не згадається більше ім’я Ізраїля».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Змовилися одностайно,","poem":1},{"text":"уклали проти Тебе угоду –","poem":2}]},{"type":"verse","number":7,"content":[{"text":"шатри Едомові й ізмаїльтяни,","poem":1},{"text":"Моав і аґаряни,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ґевал, Аммон і Амалик,","poem":1},{"text":"Филистея із жителями Тира.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Навіть Ассирія приєдналася до них,","poem":1},{"text":"ставши сильним плечем для синів Лотових. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Зроби з ними так, як із Мідіаном,","poem":1},{"noteId":149},{"text":"як із Сісерою й Явіном при потоці Кішон,","poem":2},{"noteId":150}]},{"type":"verse","number":11,"content":[{"text":"що були знищені в Ен-Дорі","poem":1},{"text":"й стали гноєм землі.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Учини з вельможами їхніми, як з Оревом і Зевом,","poem":1},{"noteId":151},{"text":"і з князями їхніми, як із Зевахом і Цальманом,","poem":2},{"noteId":152}]},{"type":"verse","number":13,"content":[{"text":"що говорили: «Візьмемо собі у спадок","poem":1},{"text":"угіддя Божі».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Боже мій, нехай будуть вони, як курява,","poem":1},{"text":"як полова на вітрі.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Як вогонь пожирає ліс","poem":1},{"text":"і як полум’я обпікає гори,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"так Ти пожени їх Своєю бурею","poem":1},{"text":"й вихором Своїм збентеж їх.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Вкрий їхні обличчя безчестям,","poem":1},{"text":"і нехай шукають вони ім’я Твоє, Господи!","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Нехай вони посоромляться й збентежаться навіки,","poem":1},{"text":"нехай вкриються ганьбою й загинуть.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Нехай пізнають, що Ти, Чиє ім’я – Господь,","poem":1},{"text":"лише Ти один Всевишній над усією землею.","poem":2}]}],"footnotes":[{"noteId":149,"caller":"+","text":"Див. Суд. 7:1-25.","reference":{"chapter":82,"verse":10}},{"noteId":150,"caller":"+","text":"Див. Суд. 4:1-24.","reference":{"chapter":82,"verse":10}},{"noteId":151,"caller":"+","text":"Див. Суд. 7:25.","reference":{"chapter":82,"verse":12}},{"noteId":152,"caller":"+","text":"Див. Суд. 8:4-21.","reference":{"chapter":82,"verse":12}}]},"thisChapterLink":"/api/ukr_npu/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":19}