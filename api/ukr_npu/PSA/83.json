{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":83,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. На мотив ґіттіт. Псалом синів Кореєвих.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Які любі оселі Твої,","poem":1},{"text":"Господи Воїнств!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Душа моя охоплена прагненням і тужить","poem":1},{"text":"за дворам Господа,","poem":2},{"lineBreak":true},{"text":"серце моє і тіло волають до Бога живого.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Навіть пташка знаходить собі домівку","poem":1},{"text":"й ластівка – гніздо собі,","poem":2},{"lineBreak":true},{"text":"щоби покласти пташенят своїх","poem":2},{"text":"біля жертовників Твоїх,","poem":1},{"text":"Господи Воїнств, Царю мій і Боже мій.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Блаженні ті, що живуть у домі Твоєму –","poem":1},{"text":"вони безупинно прославлятимуть Тебе. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Блаженна людина, чия міць у Тобі,","poem":1},{"text":"у чиєму серці стежки спрямовані до храму.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Проходячи долиною плачу,","poem":1},{"text":"вони джерела води в ній відкривають,","poem":2},{"lineBreak":true},{"text":"і ранній дощ","poem":2},{"noteId":153},{"text":"вкриває її благословеннями.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Зростають їхні сили,","poem":1},{"noteId":154},{"text":"з’являються вони перед Богом на Сіоні.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Господи, Боже Воїнств, почуй мою молитву,","poem":1},{"text":"прислухайся, Боже Яковів! Села","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Щите наш, Боже, подивися,","poem":1},{"text":"поглянь на обличчя Твого помазанця.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Адже один день у Твоїх дворах","poem":1},{"text":"кращий від тисячі днів деінде.","poem":2},{"text":"Я вибрав би перебувати біля порогу дому Бога мого,","poem":1},{"text":"аніж мешкати в наметах нечестивців.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Бо сонце і щит – Господь Бог!","poem":1},{"text":"Він нагороджує милістю й славою Своєю;","poem":2},{"text":"не позбавить Він добра тих,","poem":1},{"text":"хто ходить у невинності.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Господи Воїнств! Блаженна людина,","poem":1},{"text":"що на Тебе покладає надію!","poem":2}]}],"footnotes":[{"noteId":153,"caller":"+","text":"Ранній дощ випадав восени, після завершення періоду літньої спеки.","reference":{"chapter":83,"verse":7}},{"noteId":154,"caller":"+","text":"Буквально: йдуть від сили до сили.","reference":{"chapter":83,"verse":8}}]},"thisChapterLink":"/api/ukr_npu/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":13}