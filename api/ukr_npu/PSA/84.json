{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":84,"content":[{"type":"verse","number":1,"content":[{"text":"Керівнику хору. Псалом синів Кореєвих.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ти вподобав землю Свою, Господи,","poem":1},{"text":"повернув із полону Якова.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ти простив беззаконня народу Твого,","poem":1},{"text":"покрив усі гріхи його. Села","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ти забрав від нас увесь Свій гнів,","poem":1},{"text":"відвернув усю лють обличчя Твого.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Віднови нас, Боже спасіння нашого,","poem":1},{"text":"і припини Свій гнів на нас.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Невже Ти гніватимешся на нас вічно,","poem":1},{"text":"продовжуватимеш гнів Свій із роду в рід?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Невже не оживиш нас знову,","poem":1},{"text":"щоб народ Твій радів Тобою?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"З’яви нам, Господи, милість Свою","poem":1},{"text":"і даруй нам Твоє спасіння.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Послухаю-но, що скаже Бог, Господь,","poem":1},{"text":"адже Він скаже: «Мир!»","poem":2},{"text":"народові Своєму й вірним Своїм.","poem":1},{"text":"Лише б вони знову не повернулися до безглуздя!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Справді, близьке спасіння Його до тих, хто Його боїться,","poem":1},{"text":"щоб слава Його замешкала в землі нашій.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Милість та істина зустрінуться,","poem":1},{"text":"правда і мир поцілуються.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Істина проросте із землі,","poem":1},{"text":"і правда з небес поглядатиме,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"і дасть Господь добро,","poem":1},{"text":"і земля наша принесе врожай.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Правда піде перед Ним,","poem":1},{"text":"поставить на дорогу свої кроки.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":14}