{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":89,"content":[{"type":"verse","number":1,"content":[{"text":"Молитва Мойсея, чоловіка Божого.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Владико, Ти був пристановищем нашим","poem":1},{"text":"з роду в рід.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Перш ніж народилися гори","poem":1},{"text":"й Ти утворив землю і всесвіт,","poem":2},{"text":"від віку й до віку Ти – Бог.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ти повертаєш людину назад у порох","poem":1},{"text":"і кажеш: «Поверніться назад, сини людські!»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Адже тисяча років в очах Твоїх,","poem":1},{"text":"немов день вчорашній, що минає,","poem":2},{"lineBreak":true},{"text":"як сторожа вночі.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Потоком Ти несеш людей,","poem":1},{"text":"немов сон минули вони;","poem":2},{"text":"як трава, що вранці сходить,","poem":1},{"text":"вранці цвіте й рясніє,","poem":2},{"text":"а ввечері в’яне й засихає.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ми щезаємо у гніві Твоєму,","poem":1},{"text":"і через лють Твою ми збентежені.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ти поклав наші беззаконня перед Собою,","poem":1},{"text":"наші приховані гріхи вивів на світло Твого обличчя.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Бо всі дні наші проходять у люті Твоїй;","poem":1},{"text":"роки наші згасають, немов стогін.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Днів наших – сімдесят років,","poem":1},{"text":"а якщо є сила, то вісімдесят років,","poem":2},{"text":"і найкраще в них забирає праця й смуток;","poem":1},{"text":"вони минають швидко, і ми відлітаємо.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Хто знає силу гніву Твого?","poem":1},{"text":"Страх перед Тобою, настільки великий,","poem":2},{"lineBreak":true},{"text":"як і лють Твоя.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Навчи нас так лічити дні наші,","poem":1},{"text":"щоб ми набули мудре серце.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Повернися ж, Господи, доки так буде?","poem":1},{"text":"Змилуйся над рабами Твоїми!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Насичуй нас милістю Твоєю вранці,","poem":1},{"text":"тоді ми веселитися й радіти будемо по всі дні наші.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Дай нам порадіти за ті дні, коли Ти упокорював нас,","poem":1},{"text":"за ті роки, коли ми бачили лихо.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Нехай з’явиться Твоє діло рабам Твоїм,","poem":1},{"text":"і велич Твоя – синам їхнім.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"І нехай перебуватиме прихильність Володаря, Бога нашого, на нас.","poem":1},{"text":"Справу рук наших утверди для нас,","poem":2},{"text":"справу рук наших зміцни нам.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":17}