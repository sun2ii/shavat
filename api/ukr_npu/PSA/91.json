{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом. Пісня на день суботній.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Як добре славити Господа","poem":1},{"text":"й співати імені Твоєму, Всевишній,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"звіщати вранці милість Твою","poem":1},{"text":"і вірність Твою вночі","poem":2}]},{"type":"verse","number":4,"content":[{"text":"на лірі десятиструнній","poem":1},{"text":"і на арфі мелодійній!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Бо Ти порадував мене, Господи, діянням Своїм,","poem":1},{"text":"я веселюся справами рук Твоїх.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Які величні діяння Твої, Господи,","poem":1},{"text":"і які глибокі задуми Твої!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Невіглас не знає,","poem":1},{"text":"і нерозумний не збагне цього.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Хоча нечестиві розростаються, як трава,","poem":1},{"text":"і розквітають усі, хто чинить беззаконня,","poem":2},{"lineBreak":true},{"text":"це лише, щоб зникнути навіки.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ти ж, Господи, навіки піднесений.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Бо справді, вороги Твої, Господи,","poem":1},{"text":"справді, вороги Твої загинуть,","poem":2},{"lineBreak":true},{"text":"розсіються усі, хто чинить беззаконня.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"А Ти підніс мій ріг, як ріг тура,","poem":1},{"noteId":165},{"text":"–","poem":1},{"text":"я намащений свіжою олією.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Око моє бачить падіння ворогів моїх,","poem":1},{"text":"про злочинців, що проти мене повстали,","poem":2},{"lineBreak":true},{"text":"чують мої вуха.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Праведник цвіте, мов пальма,","poem":1},{"text":"височить неначе кедр на Лівані.","poem":2},{"noteId":166}]},{"type":"verse","number":14,"content":[{"text":"Посаджені в домі Господньому,","poem":1},{"text":"вони цвістимуть у дворах Бога нашого.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Навіть у старості принесуть плоди,","poem":1},{"text":"будуть соковитими та свіжими,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"щоб звіщати, що справедливий Господь, скеля моя,","poem":1},{"text":"і немає у Ньому кривди.","poem":2}]}],"footnotes":[{"noteId":165,"caller":"+","text":"Або: зубр або єдиноріг.","reference":{"chapter":91,"verse":11}},{"noteId":166,"caller":"+","text":"Ліван – гірське пасмо на північ від Ханаану, у давнину на його схилах росли кедри.","reference":{"chapter":91,"verse":13}}]},"thisChapterLink":"/api/ukr_npu/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}