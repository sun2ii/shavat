{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":[{"text":"Господь царює.","poem":1},{"text":"Зодягнений Він у велич,","poem":2},{"text":"Господь зодягнений і підперезаний силою.","poem":1},{"text":"Тому твердо стоїть всесвіт,","poem":2},{"lineBreak":true},{"text":"не захитається.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Престол Твій утверджений спрадавна,","poem":1},{"text":"Ти – споконвіку.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Піднесли ріки, Господи,","poem":1},{"text":"піднесли ріки Свій голос,","poem":2},{"lineBreak":true},{"text":"підносять ріки хвилі свої.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Та могутніший, ніж шум вод великих,","poem":1},{"text":"ніж могутні хвилі морські, –","poem":2},{"lineBreak":true},{"text":"Господь могутній на висотах небес.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Одкровення Твої, безсумнівно, надійні;","poem":1},{"text":"дому Твоєму, Господи,","poem":2},{"lineBreak":true},{"text":"личить святість на довгії дні.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}