{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"О Боже помсти, Господи,","poem":1},{"text":"Боже помсти, з’яви Себе!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Піднімися, Судде землі,","poem":1},{"text":"віддай гордим по заслугам!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Аж доки нечестиві, Господи,","poem":1},{"text":"доки нечестиві торжествувати будуть?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Вивергають, промовляють вони пиху,","poem":1},{"text":"нахваляються всі, хто чинить гріх.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Народ Твій, Господи, вони вражають ударами","poem":1},{"text":"й пригнічують Твій спадок.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Вдову й приходька вбивають,","poem":1},{"text":"сироту гублять","poem":2}]},{"type":"verse","number":7,"content":[{"text":"кажучи: «Не бачить Господь,","poem":1},{"text":"і не вникає в це Бог Якова».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Схаменіться, невігласи серед народу!","poem":1},{"text":"Коли ви станете розумнішими, безумці?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Той, Хто насадив вухо, хіба не почує?","poem":1},{"text":"Чи Той, Хто око створив, не побачить?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Той, Хто народи карає, хіба не докорить?","poem":1},{"text":"Той, Хто сам людині дає знання?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Господь знає думки людини,","poem":1},{"text":"що вони – марнота.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Блаженний муж, якого Ти наставляєш, Господи,","poem":1},{"text":"і Законом Твоїм навчаєш його,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"щоб заспокоїти його у дні лиха,","poem":1},{"text":"поки буде викопана яма нечестивому!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Адже не покине Господь народу Свого","poem":1},{"text":"й спадку Свого не полишить.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Суд знову стане справедливим,","poem":1},{"text":"і підуть услід за ним усі, праведні серцем.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Хто стане за мене проти злодіїв?","poem":1},{"text":"Хто стоятиме за мене проти тих, що чинять гріх?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Якби Господь не був допомогою моєю,","poem":1},{"text":"то оселилася б душа моя в країні мовчання.","poem":2},{"noteId":167}]},{"type":"verse","number":18,"content":[{"text":"Коли сказав я: «Хитається нога моя»,","poem":1},{"text":"милість Твоя, Господи, підтримала мене.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Коли тривожні думки множаться в нутрі моєму,","poem":1},{"text":"Твоя втіха збадьорює мою душу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Хіба може мати щось спільне з Тобою престол загибелі,","poem":1},{"text":"що діє всупереч постанові Закону?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Натовпом тиснуть вони на душу праведника,","poem":1},{"text":"і кров невинну засуджують на страту.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Але Господь став моєю твердинею,","poem":1},{"text":"і Бог мій – скеля мого притулку.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Він поверне проти них їхні власні гріхи","poem":1},{"text":"і їхніми ж злодійствами знищить їх;","poem":2},{"lineBreak":true},{"text":"знищить їх Господь, Бог наш.","poem":2}]}],"footnotes":[{"noteId":167,"caller":"+","text":"Країна мовчання – образ смерті.","reference":{"chapter":93,"verse":17}}]},"thisChapterLink":"/api/ukr_npu/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":23}