{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"Прийдіть, заспіваємо радісно Господу,","poem":1},{"text":"вигукнемо піднесено скелі спасіння нашого.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Прийдемо перед обличчя Його з подякою,","poem":1},{"text":"піснями прославимо Його.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Адже Господь – Бог великий","poem":1},{"text":"і Цар могутніший від усіх богів.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"У руці Його глибини землі,","poem":1},{"text":"і вершини гір належать Йому;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"море – Його, Він створив його,","poem":1},{"text":"і суходіл Його руки утворили.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Прийдіть, поклонімося, впадемо долілиць,","poem":1},{"text":"схилимо коліна перед Господом, Творцем нашим,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"бо Він – наш Бог, а ми – народ Його пасовища,","poem":1},{"text":"вівці, про яких Він піклується.","poem":2},{"noteId":168},{"lineBreak":true},{"text":"Сьогодні, коли ви почуєте Його голос,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"не зачерствійте серцями вашими, як у Мериві,","poem":1},{"text":"як було того дня у Массі в пустелі,","poem":2},{"noteId":169}]},{"type":"verse","number":9,"content":[{"text":"де спокушали Мене предки ваші,","poem":1},{"text":"випробовували Мене, хоча й бачили Моє діяння.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Сорок років дратував Мене цей рід,","poem":1},{"text":"тоді сказав Я: «Вони народ, що блукає серцем,","poem":2},{"lineBreak":true},{"text":"не знають шляхів Моїх.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Тому присягнув Я у гніві Моєму:","poem":1},{"text":"не увійдуть вони до Мого спокою!»","poem":2}]}],"footnotes":[{"noteId":168,"caller":"+","text":"Буквально: вівці руки Його.","reference":{"chapter":94,"verse":7}},{"noteId":169,"caller":"+","text":"Див. Вих. 17:1-7; Чис. 20:1-13.","reference":{"chapter":94,"verse":8}}]},"thisChapterLink":"/api/ukr_npu/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":11}