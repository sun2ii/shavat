{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Співайте Господеві нову пісню;","poem":1},{"text":"співай Господеві, уся земле!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Співайте Господеві, благословляйте ім’я Його,","poem":1},{"text":"звіщайте день у день Його спасіння!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Розповідайте серед народів про славу Його,","poem":1},{"text":"серед усіх племен – про чудеса Його.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господь великий і вельми прославлений;","poem":1},{"text":"Він грізніший за усіх богів.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Адже всі боги народів – лише ідоли,","poem":1},{"text":"а Господь створив небеса.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Слава й велич перед обличчям Його,","poem":1},{"text":"сила й краса у Його святилищі.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Віддайте Господеві, сім’ї народів,","poem":1},{"text":"віддайте Господеві славу й силу.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Віддайте Господеві славу, належну Його імені.","poem":1},{"text":"Несіть дар і йдіть у двори Його.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Вклоніться Господеві у величі святині.","poem":1},{"text":"Тремти перед обличчям Його, уся земле!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Скажіть серед народів: «Господь царює!»","poem":1},{"text":"Тому всесвіт утверджений непохитно;","poem":2},{"lineBreak":true},{"text":"Він судитиме народи справедливо.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Нехай радіють небеса й веселиться земля;","poem":1},{"text":"нехай гуркотить море і все, що наповнює його.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Нехай радіє поле і все, що в ньому;","poem":1},{"text":"нехай вигукують піднесено усі дерева лісові","poem":2}]},{"type":"verse","number":13,"content":[{"text":"перед обличчям Господа, бо Він іде,","poem":1},{"text":"іде судити землю.","poem":2},{"text":"Він судитиме всесвіт справедливо","poem":1},{"text":"і народи – за Своєю істиною.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":13}