{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Господь царює!","poem":1},{"text":"Нехай веселиться земля,","poem":2},{"lineBreak":true},{"text":"радіють численні острови!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Хмара й імла навколо Нього;","poem":1},{"text":"справедливість і правосуддя – основа Його престолу.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Вогонь іде перед Ним","poem":1},{"text":"і спалює навкруги ворогів Його.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Блискавки Його освітлюють всесвіт,","poem":1},{"text":"земля бачить і тремтить.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Гори тануть, немов віск, перед обличчям Господа,","poem":1},{"text":"перед обличчям Володаря всієї землі.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Небеса сповіщають Його правду,","poem":1},{"text":"усі народи бачать Його славу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Нехай соромом вкриються всі, хто служить ідолам,","poem":1},{"text":"хто хвалиться нікчемними божками.","poem":2},{"lineBreak":true},{"text":"Вклоніться Йому, усі боги!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Почув це Сіон і зрадів,","poem":1},{"text":"звеселилися доньки Юди","poem":2},{"lineBreak":true},{"text":"через суди Твої, Господи.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Адже Ти, Господи, Всевишній над усією землею,","poem":1},{"text":"піднесений високо над усіма богами.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ті, хто Господа любить, ненавидьте зло!","poem":1},{"text":"Він береже душі Своїх вірних,","poem":2},{"lineBreak":true},{"text":"визволяє їх від руки нечестивих.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Світло посіяне у праведника,","poem":1},{"noteId":170},{"text":"і радість – у щирих серцем.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Радійте, праведні, у Господі,","poem":1},{"text":"і славте пам’ять Його святині!","poem":2},{"noteId":171}]}],"footnotes":[{"noteId":170,"caller":"+","text":"Так у єврейському тексті, у грецькому перекладі: світло сходить для праведника.","reference":{"chapter":96,"verse":11}},{"noteId":171,"caller":"+","text":"Або: святе ім’я Його. Про пам’ять як метафору імені Божого Див. Вих. 3:15; Пс. 29:5.","reference":{"chapter":96,"verse":12}}]},"thisChapterLink":"/api/ukr_npu/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":12}