{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Псалом.","descriptive":true},{"text":"Співайте Господеві нову пісню,","poem":1},{"text":"бо Він здійснив чудеса;","poem":2},{"text":"перемогу принесла Йому правиця Його","poem":1},{"text":"і рамено Його святе.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Звістив Господь спасіння Своє,","poem":1},{"text":"відкрив перед очима народів праведність Свою.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Згадав Він милість Свою","poem":1},{"text":"й вірність Свою дому Ізраїля.","poem":2},{"text":"Усі краї землі побачили","poem":1},{"text":"спасіння Бога нашого.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Вигукни радісно Господеві, уся земле!","poem":1},{"text":"Кричи від радості, веселися й співай!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Грайте Господеві на арфі,","poem":1},{"text":"на арфі зі звуками співу!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Під звуки труб і сурми","poem":1},{"noteId":172},{"text":"вигукуйте радісно перед Царем, Господом!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Нехай гуркотить море і все, що його наповнює,","poem":1},{"text":"всесвіт і все, що мешкає в ньому.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Нехай ріки плещуть у долоні,","poem":1},{"text":"нехай гори веселяться разом","poem":2}]},{"type":"verse","number":9,"content":[{"text":"перед обличчям Господа,","poem":1},{"text":"бо Він іде судити землю.","poem":2},{"text":"Він судитиме всесвіт праведно","poem":1},{"text":"й народи – справедливо.","poem":2}]}],"footnotes":[{"noteId":172,"caller":"+","text":"Сурма – мається на увазі шофар; Див. Пс. 46:6.","reference":{"chapter":97,"verse":6}}]},"thisChapterLink":"/api/ukr_npu/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":9}