{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_npu","name":"Книга Псалмів","commonName":"Книга Псалмів","title":"Книга Псалмів","order":19,"numberOfChapters":150,"sha256":"438b71dc7180aa02db90c3cd1462a779154cbe9a84de57ebcd3a53690c0a4082","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_npu/PSA/150.json","totalNumberOfVerses":2526},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"Господь царює –","poem":1},{"text":"нехай тремтять народи!","poem":2},{"text":"Він сидить на херувимах –","poem":1},{"text":"нехай здригнеться земля!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Господь великий на Сіоні,","poem":1},{"text":"Він піднесений над усіма народами.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Нехай прославлять вони ім’я Твоє велике й грізне:","poem":1},{"text":"воно святе!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Могутнє правління Царя любить правосуддя.","poem":1},{"text":"Ти утвердив справедливість,","poem":2},{"lineBreak":true},{"text":"здійснив суд і правду у Якова.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Піднесено славте Господа, Бога нашого,","poem":1},{"text":"і вклоняйтеся біля підніжжя Його: Він святий!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Мойсей і Аарон серед священників Його,","poem":1},{"text":"і Самуїл серед тих, хто кличе Його ім’я;","poem":2},{"text":"кликали вони до Господа,","poem":1},{"text":"і Він відповідав їм.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"У хмарному стовпі говорив до них;","poem":1},{"text":"вони ж дотримувалися Його одкровень","poem":2},{"lineBreak":true},{"text":"і постанов, які Він дав їм.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Господи, Боже наш, Ти відповідав їм!","poem":1},{"text":"Ти був для них Богом, Який прощає,","poem":2},{"lineBreak":true},{"text":"але й карав їх за провини їхні.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Піднесено славте Господа, Бога нашого,","poem":1},{"text":"і вклоняйтеся на горі Його святій,","poem":2},{"text":"бо святий Господь, Бог наш.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/ukr_npu/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}