{"translation":{"id":"ukr_npu","name":"Бібліка ® Відкрита Новий Переклад Українською","website":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukronpu","licenseNotes":null,"shortName":"NPU","englishName":"New Ukranian Translation NT+Psalms","language":"ukr","textDirection":"ltr","sha256":"1f1167527be4dcad3999a4caade0b81f037bc84244652d52442da9b66fa13d3f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_npu/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10483,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"REV","translationId":"ukr_npu","name":"Об’явлення","commonName":"Об’явлення","title":"Об’явлення","order":66,"numberOfChapters":22,"sha256":"f36728748eb46c7a4afc3a658dda0931e6293e9a7e084c3fdab9efa05de78060","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_npu/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/ukr_npu/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":15,"content":[{"type":"heading","content":["Сім ангелів із сімома карами"]},{"type":"verse","number":1,"content":["Я побачив на небі ще одне велике й дивовижне знамення: сім ангелів із сімома останніми карами, бо ними закінчується Божий гнів."]},{"type":"verse","number":2,"content":["І я побачив щось схоже на скляне море, змішане з вогнем, і тих, хто переміг звіра, його образ та число його імені. Вони стояли біля моря й тримали Божі арфи."]},{"type":"verse","number":3,"content":["Вони співали пісню раба Божого Мойсея",{"noteId":32},"та Агнця, кажучи:",{"text":"«Великі та дивовижні діла Твої,","poem":1},{"text":"Господи Боже, Вседержителю!","poem":2},{"text":"Праведні та правдиві шляхи Твої,","poem":1},{"text":"Царю народів!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Хто не боятиметься Тебе, Господи,","poem":1},{"text":"і не принесе слави Твоєму імені?","poem":2},{"text":"Бо Ти один святий.","poem":1},{"lineBreak":true},{"text":"Усі народи прийдуть","poem":1},{"text":"і поклонятимуться перед Тобою,","poem":2},{"text":"бо відкрились Твої праведні вчинки!»","poem":1},{"noteId":33}]},{"type":"verse","number":5,"content":["Після цього я подивився й побачив на небі відкритий Храм – Оселю одкровення."]},{"type":"verse","number":6,"content":["Із Храму вийшли сім ангелів із сімома карами. Вони були одягнені в чистий блискучий льняний одяг і були оперезані на грудях золотими поясами."]},{"type":"verse","number":7,"content":["Тоді одна з чотирьох живих істот дала семи ангелам сім золотих чаш, наповнених гнівом Бога, Який живе навіки-віків."]},{"type":"verse","number":8,"content":["І Храм наповнився димом від слави Божої та від Його сили, і ніхто не міг увійти до Храму, поки не буде закінчено сім кар сімох ангелів."]}],"footnotes":[{"noteId":32,"caller":"+","text":"Див. Вих. 15:1.","reference":{"chapter":15,"verse":3}},{"noteId":33,"caller":"+","text":"Див. Пс. 85:9; Єр. 10:7.","reference":{"chapter":15,"verse":4}}]},"thisChapterLink":"/api/ukr_npu/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_npu/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_npu/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}