terAudioLinks":{},"nextChapterApiLink":"/api/ukr_pan/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_pan/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}