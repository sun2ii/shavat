{"translation":{"id":"ukr_pan","name":"Біблія в пер. П.Куліша та І.Пулюя, 1905","website":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseNotes":null,"shortName":"PAN","englishName":"Ukrainian Bible by P. Kulish","language":"ukr","textDirection":"ltr","sha256":"6767adfc94b6f42c32ea13c58ebaec5e2282b8201edb96fe06a59af457b7a73f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_pan/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_pan","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"426fc6a9549b4e7704cd23b9157df31b3ad9f2077e66e8829e48395fb7d6ffc7","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_pan/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_pan/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":["Посходня пісня Давидова. Як би не Господь, що був з нами — скажи бо Ізраїлю! —"]},{"type":"verse","number":2,"content":["Як би не був Господь з нами, коли люде проти нас встали,"]},{"type":"verse","number":3,"content":["То живцем проковтнули б нас, як запалав гнїв їх проти нас;"]},{"type":"verse","number":4,"content":["Затопили би нас води, рвучі потоки залили б душу нашу;"]},{"type":"verse","number":5,"content":["З шумом пронесли б ся буйні води понад душею нашою."]},{"type":"verse","number":6,"content":["Благословен Господь, що не дав нас зубам їх на здобич."]},{"type":"verse","number":7,"content":["Душа наша спаслась, як пташина із сельця птахоловця; сельце розірвалось, і ми спаслися."]},{"type":"verse","number":8,"content":["Поміч наша в імени Господа, що сотворив небо і землю."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_pan/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/u