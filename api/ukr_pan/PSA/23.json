{"translation":{"id":"ukr_pan","name":"Біблія в пер. П.Куліша та І.Пулюя, 1905","website":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseNotes":null,"shortName":"PAN","englishName":"Ukrainian Bible by P. Kulish","language":"ukr","textDirection":"ltr","sha256":"6767adfc94b6f42c32ea13c58ebaec5e2282b8201edb96fe06a59af457b7a73f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_pan/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_pan","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"426fc6a9549b4e7704cd23b9157df31b3ad9f2077e66e8829e48395fb7d6ffc7","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_pan/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_pan/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Псальма Давидова. Господь пастирь мій, не мати му недостатку."]},{"type":"verse","number":2,"content":["Дав менї оселю серед лугів зелених, він веде мене до тихих потоків."]},{"type":"verse","number":3,"content":["Він справляє душу мою; він веде мене по праведній дорозї задля імени свого."]},{"type":"verse","number":4,"content":["Хоч би я ходив по долинї тїни смертної, то не боюся жадного лиха, ти бо єси зо мною; твоя палиця і підпора дає менї духа."]},{"type":"verse","number":5,"content":["Ти наповняєш стіл мій перед очима ворогів моїх; ти помазав голову мою і кубок мій повний, аж переливається."]},{"type":"verse","number":6,"content":["Так, милосердє і благодать будуть провожати мене по всї днї життя мого; і жити му в домі Господнїм по всї днї."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_pan/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_pan/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_pan/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}