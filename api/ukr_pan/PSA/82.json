{"translation":{"id":"ukr_pan","name":"Біблія в пер. П.Куліша та І.Пулюя, 1905","website":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseNotes":null,"shortName":"PAN","englishName":"Ukrainian Bible by P. Kulish","language":"ukr","textDirection":"ltr","sha256":"6767adfc94b6f42c32ea13c58ebaec5e2282b8201edb96fe06a59af457b7a73f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_pan/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_pan","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"426fc6a9549b4e7704cd23b9157df31b3ad9f2077e66e8829e48395fb7d6ffc7","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_pan/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_pan/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":["Псальма Асафова. Бог стоїть серед громади Божої, серед суддїв судить він:"]},{"type":"verse","number":2,"content":["Доки будете судити не по правдї, будете дивитись на лице беззаконних?"]},{"type":"verse","number":3,"content":["Признайте правду бідному і сиротинї; оправдайте нужденного і вбогого."]},{"type":"verse","number":4,"content":["Визволяйте бідолашного і нужденного, спасайте його з руки беззаконних!"]},{"type":"verse","number":5,"content":["Не знають нїчого, не розуміють нїчого; у тьмі блукають вони: всї основи землї хитаються."]},{"type":"verse","number":6,"content":["Сказав я: Ви божі, і всї ви сини Всевишнього!"]},{"type":"verse","number":7,"content":["Тілько ж, як той чоловік, помрете ви, як кожний князь, упадете."]},{"type":"verse","number":8,"content":["Встань, Боже! Суди землю, ти бо маєш право судити всї народи."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_pan/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_pan/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_pan/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}