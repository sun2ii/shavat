{"translation":{"id":"ukr_pan","name":"Біблія в пер. П.Куліша та І.Пулюя, 1905","website":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukr1871","licenseNotes":null,"shortName":"PAN","englishName":"Ukrainian Bible by P. Kulish","language":"ukr","textDirection":"ltr","sha256":"6767adfc94b6f42c32ea13c58ebaec5e2282b8201edb96fe06a59af457b7a73f","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_pan/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_pan","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"426fc6a9549b4e7704cd23b9157df31b3ad9f2077e66e8829e48395fb7d6ffc7","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_pan/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_pan/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":["Для синів Корея; псальма, до сьпіву. Оселя його на сьвятих горах."]},{"type":"verse","number":2,"content":["Любить Господь брами Сиона більше, як всї домівки Якова."]},{"type":"verse","number":3,"content":["Преславні речі говорено про тебе, місто Боже."]},{"type":"verse","number":4,"content":["Згадаю про Египет і Вавилон перед тими, що знають мене; дивись, Филистея і Тир вкупі з Етіопією скажуть: той родився там."]},{"type":"verse","number":5,"content":["А про Сиона скажуть: Той і той родився там; і Всевишнїй, він утвердить його."]},{"type":"verse","number":6,"content":["Господь напише в переписї народів: Той родився там."]},{"type":"verse","number":7,"content":["Тому сьпівають і веселяться тобою всї жерела життя мого!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_pan/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_pan/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_pan/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}