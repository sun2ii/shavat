{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"JOB","translationId":"ukr_ufb","name":"КНИГА ЙОВА","commonName":"КНИГА ЙОВА","title":"КНИГА ЙОВА.","order":18,"numberOfChapters":42,"sha256":"23e9c71b44a4868132610051b9c5cbea71912479873d60f3b9b8e7b1b824482d","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ukr_ufb/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["І відказав Йов і рече:"]},{"type":"verse","number":2,"content":["Ой, як же ти поміг менї, безсильному, як піддержав руку слабому!"]},{"type":"verse","number":3,"content":["Що ж то за раду подав єси немудрому, й як основно вияснив річ!"]},{"type":"verse","number":4,"content":["Кому говорив ти оті слова, і чий дух промовив із тебе?"]},{"type":"verse","number":5,"content":["Рефаїми",{"noteId":6},"дрожать під водами й все, що в них животїє."]},{"type":"verse","number":6,"content":["Нага перед ним безодня, й не закритий Аваддон",{"noteId":7},"."]},{"type":"verse","number":7,"content":["Північний вітер розпускає він в порожню (воздушну), повісив землю нї на чім."]},{"type":"verse","number":8,"content":["Він завязав води в хмарах своїх, і хмари не розсїдаються від них."]},{"type":"verse","number":9,"content":["Він укрив престол свій кругом, розпростерши над ним облак свій."]},{"type":"verse","number":10,"content":["Він обвів круг гряничний водами аж до гряниць між сьвітлом і тьмою."]},{"type":"verse","number":11,"content":["Стовпи небес",{"noteId":8},"тремтять і лякаються від погрози його."]},{"type":"verse","number":12,"content":["Силою своєю розбурхує він море, й розумом своїм гнуздає буту його."]},{"type":"verse","number":13,"content":["Дух його прикрасив небо, рука його утворила бистрого скорпіона",{"noteId":9},"."]},{"type":"verse","number":14,"content":["Се ж тілько частинки дїл його, й як то ще не багато чували ми про його! А хто ж би зміг зрозуміти всю велич могучостї його?"]}],"footnotes":[{"noteId":6,"caller":"+","text":"Велетнї морські, кити.","reference":{"chapter":26,"verse":5}},{"noteId":7,"caller":"+","text":"Пекло.","reference":{"chapter":26,"verse":6}},{"noteId":8,"caller":"+","text":"Значить: або сама твердиня небесна, або гори, сягаючі в хмари.","reference":{"chapter":26,"verse":11}},{"noteId":9,"caller":"+","text":"Блискавку.","reference":{"chapter":26,"verse":13}}]},"thisChapterLink":"/api/ukr_ufb/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}