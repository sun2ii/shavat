{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":["Псальма Давидова. Сказав Господь моєму Господеві: Сядь праворуч коло мене, доки не положу ворогів твоїх підніжком тобі в ноги!"]},{"type":"verse","number":2,"content":["Жезло сили твоєї пришле Господь із Сиона; царюй серед ворогів твоїх!"]},{"type":"verse","number":3,"content":["В день потуги твоєї буде нарід твій готовий у сьвятій оздобі; з лона зарева раннього спаде тобі роса молодостї твоєї."]},{"type":"verse","number":4,"content":["Клявся Господь, і не пожалує того: Ти сьвященник по віки по постанові Мелхизедека."]},{"type":"verse","number":5,"content":["Господь по правицї в тебе сокрушає царів в день гнїву свого."]},{"type":"verse","number":6,"content":["Він зробить суд між народами, покривши землю трупом; розбивши голову, що над великою країною панує."]},{"type":"verse","number":7,"content":["По дорозї пити ме з потока, тому підніме він голову."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/110.json","thisChapterAudioLi