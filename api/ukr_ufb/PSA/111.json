{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":["Аллилуя! Прославлю тебе, Господи, всїм серцем, в радї праведних і в зборі."]},{"type":"verse","number":2,"content":["Дїла Господнї великі, явні всїм, хто любується ними."]},{"type":"verse","number":3,"content":["Дїла його краса і величиє; і справедливість його по віки."]},{"type":"verse","number":4,"content":["Чудесні дїла його незабуті; благий і милосердний Господь."]},{"type":"verse","number":5,"content":["Він дає поживу тим, що бояться його; памятає вічно свій заповіт."]},{"type":"verse","number":6,"content":["Явив силу дїл своїх народові свойму, щоб дати їм наслїддє народів."]},{"type":"verse","number":7,"content":["Дїла руки його правда і правосуддє; всї заповідї його вірні;"]},{"type":"verse","number":8,"content":["Установлені на віки вічні; в правдї і правотї виповнені."]},{"type":"verse","number":9,"content":["Післав збавленнє народові свому, поставивши на віки заповіт свій; сьвяте і страшне імя його."]},{"type":"verse","number":10,"content":["Страх перед Господом — початок мудростї; добрий розум у всїх, що заповідї сповняють. Хвала його по віки вічні."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}