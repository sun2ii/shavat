{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":["Посходня пісня Соломонова. Коли Господь не будує дому, даремно трудяться будівничі; коли Господь не стереже міста; даремне пильнує сторожа."]},{"type":"verse","number":2,"content":["Даремне встаєте ви рано, лягаєте пізно, і їсьте хлїб гіркий; дає він і сон тим, кого любить."]},{"type":"verse","number":3,"content":["Ось і дїти, наслїддє Господнє, плід тїлесний народа."]},{"type":"verse","number":4,"content":["Як стріли в руках сильного, так сини молодого віку."]},{"type":"verse","number":5,"content":["Щасливий чоловік, що наповнив ними сагайдака свого!"]},{"type":"verse","number":6,"content":["Не осоромляться вони, говоривши у воротях з ворогами."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":6}