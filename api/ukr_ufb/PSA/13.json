{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Проводиреві хора: Псальма Давидова. Доки Господи, будеш мене все забувати? Доки будеш ховати лице твоє від мене?"]},{"type":"verse","number":2,"content":["Доки носити менї щодня думу в душі моїй, журбу в серцї моїм? Доки буде підніматись ворог мій надо мною?"]},{"type":"verse","number":3,"content":["Зглянься ж, дай відповідь, Господи, Боже мій! Просьвіти очі мої, щоб я не заснув смертю."]},{"type":"verse","number":4,"content":["Щоб не сказав ворог мій: я подужав його. Щоб не зрадїли гонителї мої, коли захитаюсь."]},{"type":"verse","number":5,"content":["Я же вповаю на доброту твою; серце моє нехай зрадується спасеннєм твоїм. Сьпівати му Господеві, він бо сотворив добро менї."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses