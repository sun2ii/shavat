{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":["Посходня пісня. З глибинї кличу до тебе, Господи!"]},{"type":"verse","number":2,"content":["Господи, почуй голос мій! Нехай слухи твої повернуться до голосу мого благання!"]},{"type":"verse","number":3,"content":["Коли ти, Господи, будеш памятати несправедливостї, — Господи, хто встоїть?"]},{"type":"verse","number":4,"content":["Та в тебе є помилуваннє, щоб люде благовіли перед тобою."]},{"type":"verse","number":5,"content":["Надїюсь на Господа; душа моя надїється, і вповаю на слово його."]},{"type":"verse","number":6,"content":["Душа моя дожидає Господа, більше як сторожа ранку, як сторожі ранку."]},{"type":"verse","number":7,"content":["Вповай, Ізраїлю, на Господа! Бо в Господа милість і багацтво спасення в його."]},{"type":"verse","number":8,"content":["І він спасе Ізраїля від всїх несправедливостей його."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}