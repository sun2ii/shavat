{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["Аллилуя! Хвали, душе моя, Господа!"]},{"type":"verse","number":2,"content":["Буду хвалити Господа, поки життя мого, буду сьпівати псальми Богові моєму, поки мене стане."]},{"type":"verse","number":3,"content":["Не вповайте на князїв, на сина чоловічого; нема в його спасення!"]},{"type":"verse","number":4,"content":["Вийде дух з його, знов до землї своєї він вертає; того ж дня самого задуми його марою стали."]},{"type":"verse","number":5,"content":["Щасливий той, кому дає поміч Бог Якова, в кого надїя на Господа Бога його!"]},{"type":"verse","number":6,"content":["Що сотворив небо і землю, море і все, що в йому; що стереже вірність по віки;"]},{"type":"verse","number":7,"content":["Творить правосуддє пригнобленим, дає хлїба голодним. Господь вязнїв визволяє."]},{"type":"verse","number":8,"content":["Господь слїпим очі вітворяє, Господь пригноблених підносить, Господь любить праведних;"]},{"type":"verse","number":9,"content":["Господь захожих заступає, він сироту і вдову піддержує; а дорогу беззаконних на бік повертає."]},{"type":"verse","number":10,"content":["Да царствує по віки Господь, Бог твій, Сионе, з роду в рід. Аллилуя!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}