{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":["Аллилуя! Засьпівайте Господеві нову пісню, хвалу його в соборі праведних його!"]},{"type":"verse","number":2,"content":["Да звеселиться Ізраїль Сотворительом своїм; сини Сиона да зрадуються Царем своїм!"]},{"type":"verse","number":3,"content":["Да хвалять імя його хором, при тимпанах і гуслях засьпівають йому похвальні піснї!"]},{"type":"verse","number":4,"content":["Бо Господь любується своїм народом; він украшає смиренних спасеннєм."]},{"type":"verse","number":5,"content":["Да торжествують праведні в славі, радуються на ложах своїх!"]},{"type":"verse","number":6,"content":["Славославія Богу в устах їх, і обосторонь гострий меч в руцї їх,"]},{"type":"verse","number":7,"content":["На одмщеннє народам і кару племенам;"]},{"type":"verse","number":8,"content":["Щоб царів їх в кайдани забити, й дуків їх в желїзні пута закувати;"]},{"type":"verse","number":9,"content":["Сповнити над ними суд написаний. Така слава для всїх угодників його. Хвалїте Господа!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}