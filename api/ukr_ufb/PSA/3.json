{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Сю псальму зложив Давид, як втїкав перед своїм сином Авесаломом. Господи! скілько напастників моїх, скілько тих, що постають проти мене."]},{"type":"verse","number":2,"content":["Многі кажуть душі моїй: нема йому спасення в Бозї!"]},{"type":"verse","number":3,"content":["Но ти, Господи, оборонний щит передо мною, ти слава моя, ти підносиш голову мою."]},{"type":"verse","number":4,"content":["Голосом моїм кличу до Господа, і він чує мене з гори сьвятої своєї."]},{"type":"verse","number":5,"content":["Я положився і спав; я проснувся, бо Господь заступив мене."]},{"type":"verse","number":6,"content":["Не боюсь і десятків тисячей народу, що кругом проти мене встали."]},{"type":"verse","number":7,"content":["Встань, Господи, спаси мене, мій Боже! бо ти розбивав щелепи ворогів моїх, ти торощив зуби беззаконним."]},{"type":"verse","number":8,"content":["Від Господа спасеннє; твоє благословеннє над народом твоїм."]}],"footnotes":[]},"thisChapte