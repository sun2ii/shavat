{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Суди мене, Боже, і розсуди мою справу проти безсердешного народу! Від чоловіка лукавого і неправдивого визволи мене!"]},{"type":"verse","number":2,"content":["Бо ти єси Бог сили моєї. За що ж ти відкинув мене? Чому ходжу сумуючи задля ворожого гнету?"]},{"type":"verse","number":3,"content":["Пошли сьвітло твоє і правду; вони нехай ведуть мене і заведуть на твою гору сьвятую до чертогів твоїх!"]},{"type":"verse","number":4,"content":["І так прийду я до жертівника Божого, до Бога, що сповняє мене превеликою радостю, і прославлю на гуслях тебе, Боже, мій Боже!"]},{"type":"verse","number":5,"content":["Чого хиляєшся, душе моя, і чого непокоїшся в менї? Вповай на Бога! Буду бо ще прославляти його, котрий є спасеннє лиця мого і Бог мій!"]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}