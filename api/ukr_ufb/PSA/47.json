{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":["Проводиреві хора: для синів Корея; псальма. Ви, всї народи, плещіть у долонї! Звеселяйтесь Господеві радісними піснями!"]},{"type":"verse","number":2,"content":["Бо Господь всевишний страшний, великий царь на всю землю."]},{"type":"verse","number":3,"content":["Він покорив нам людей і народи під ноги наші."]},{"type":"verse","number":4,"content":["Він вибрав для нас наслїдчину нашу, славу Якова, котрого він полюбив."]},{"type":"verse","number":5,"content":["Піднїсся Бог серед веселого гукання, Господь серед голосів трубних."]},{"type":"verse","number":6,"content":["Сьпівайте псальми Богу нашому сьпівайте; сьпівайте цареві нашому, сьпівайте!"]},{"type":"verse","number":7,"content":["Бог бо царь на всю землю; сьпівайте псальми в науку."]},{"type":"verse","number":8,"content":["Бог править народами; Бог сидить на престолї сьвятостї своєї."]},{"type":"verse","number":9,"content":["Люде доброї волї між народами зібрались до купи, народ Бога Авраамового; бо щити на землї Божі; вознїсся вельми він."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}