{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["Проводиреві хора: при струнах; наука Давида, коли прийшли Зифеї і сказали Саулові: Чи Давид не сховався між нами? Боже, імям твоїм спаси мене, і силою твоєю допоможи правдї моїй."]},{"type":"verse","number":2,"content":["Боже, почуй молитву мою, вислухай слова уст моїх!"]},{"type":"verse","number":3,"content":["Бо чужі піднялись на мене, і розбишаки чигають на життє моє; не мають вони в серцї Бога."]},{"type":"verse","number":4,"content":["Ось, Бог мій помічник; Господь між тими, що піддержують життє моє. Він відверне лихо на ворогів моїх; по правдї твоїй знищи їх!"]},{"type":"verse","number":5,"content":["Радо принесу жертву тобі; прославлю імя твоє, Господи; благе бо є."]},{"type":"verse","number":6,"content":["Він бо вибавив мене з усякої біди; і на помсту ворогам моїм дивляться очі мої."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":6}