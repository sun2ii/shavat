{"translation":{"id":"ukr_ufb","name":"Біблія свободи","website":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ukrfb","licenseNotes":null,"shortName":"UFB","englishName":"Ukrainian Freedom Bible","language":"ukr","textDirection":"ltr","sha256":"11506d7a257daa1f8ec1f22e0ecf7b8b7c659fca1e8c3adc60bcade38825aa54","availableFormats":["json"],"listOfBooksApiLink":"/api/ukr_ufb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31082,"languageName":"українська","languageEnglishName":"Ukrainian"},"book":{"id":"PSA","translationId":"ukr_ufb","name":"ПСАЛЬМА","commonName":"ПСАЛЬМА","title":"ПСАЛТИРЬ.","order":19,"numberOfChapters":150,"sha256":"2e838f3cea21ed2d477e7b13c81aaa8fdc979790b400a226ce82dd5498aa24d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ukr_ufb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ukr_ufb/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":["Проводиреві хора; при струнах; псальма, пісня. Нехай милує нас Бог і благословить, нехай засьвітить лице його над нами!"]},{"type":"verse","number":2,"content":["Щоб пізнали на землї дорогу твою, між усїма народами твоє спасеннє."]},{"type":"verse","number":3,"content":["Нехай славлять народи тебе, Боже! Нехай прославляють тебе всї народи!"]},{"type":"verse","number":4,"content":["Нехай радуються і веселяться племена; ти бо будеш правотою судити народи, і роди на землї — ти поведеш їх."]},{"type":"verse","number":5,"content":["Нехай славлять народи тебе, Боже, нехай прославляють тебе всї народи!"]},{"type":"verse","number":6,"content":["Земля дає плоди свої; Бог, наш Бог, благословити ме нас."]},{"type":"verse","number":7,"content":["Бог буде благословити нас, і цїла земля від краю до краю буде благовіти перед ним."]}],"footnotes":[]},"thisChapterLink":"/api/ukr_ufb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ukr_ufb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ukr_ufb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}