{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"JOB","translationId":"urd_gvh","name":"अय्यूब","commonName":"अय्यूब","title":"अय्यूब","order":18,"numberOfChapters":42,"sha256":"46da5933567f85ca4d878889b72d779f499179f8767ca788186e908fac99b9e1","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/urd_gvh/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["बिलदद : अल्लाह के सामने कोई रास्तबाज़ नहीं ठहर सकता"]},{"type":"verse","number":1,"content":["फिर बिलदद सूख़ी ने जवाब देकर कहा,"]},{"type":"verse","number":2,"content":["“अल्लाह की हुकूमत दहशतनाक है। वही अपनी बुलंदियों पर सलामती क़ायम रखता है।"]},{"type":"verse","number":3,"content":["क्या कोई उसके दस्तों की तादाद गिन सकता है? उसका नूर किस पर नहीं चमकता?"]},{"type":"verse","number":4,"content":["तो फिर इनसान अल्लाह के सामने किस तरह रास्तबाज़ ठहर सकता है? जो औरत से पैदा हुआ वह किस तरह पाक-साफ़ साबित हो सकता है?"]},{"type":"verse","number":5,"content":["उस की नज़र में न चाँद पुरनूर है, न सितारे पाक हैं।"]},{"type":"verse","number":6,"content":["तो फिर इनसान किस तरह पाक ठहर सकता है जो कीड़ा ही है? आदमज़ाद तो मकोड़ा ही है।”"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/JOB/24.json","previousChapterAudi