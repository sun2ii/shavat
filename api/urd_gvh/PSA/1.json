{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["दो राहें"]},{"type":"verse","number":1,"content":["मुबारक है वह जो न बेदीनों के मशवरे पर चलता, न गुनाहगारों की राह पर क़दम रखता, और न तानाज़नों के साथ बैठता है"]},{"type":"verse","number":2,"content":["बल्कि रब की शरीअत से लुत्फ़अंदोज़ होता और दिन-रात उसी पर ग़ौरो-ख़ौज़ करता रहता है।"]},{"type":"verse","number":3,"content":["वह नहरों के किनारे पर लगे दरख़्त की मानिंद है। वक़्त पर वह फल लाता, और उसके पत्ते नहीं मुरझाते। जो कुछ भी करे उसमें वह कामयाब है।"]},{"type":"line_break"},{"type":"verse","number":4,"content":["बेदीनों का यह हाल नहीं होता। वह भूसे की मानिंद हैं जिसे हवा उड़ा ले जाती है।"]},{"type":"verse","number":5,"content":["इसलिए बेदीन अदालत में क़ायम नहीं रहेंगे, और गुनाहगार का रास्तबाज़ों की मजलिस में मक़ाम नहीं होगा।"]},{"type":"verse","number":6,"content":["क्योंकि रब रास्तबाज़ों की राह की पहरादारी करता है जबकि बेदीनों की राह तबाह हो जाएगी।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}