{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["अल्लाह की सताइश करो!"]},{"type":"verse","number":1,"content":["शुक्रगुज़ारी की क़ुरबानी के लिए ज़बूर। ऐ पूरी दुनिया, ख़ुशी के नारे लगाकर रब की मद्हसराई करो!"]},{"type":"verse","number":2,"content":["ख़ुशी से रब की इबादत करो, जशन मनाते हुए उसके हुज़ूर आओ!"]},{"type":"verse","number":3,"content":["जान लो कि रब ही ख़ुदा है। उसी ने हमें ख़लक़ किया, और हम उसके हैं, उस की क़ौम और उस की चरागाह की भेड़ें।"]},{"type":"line_break"},{"type":"verse","number":4,"content":["शुक्र करते हुए उसके दरवाज़ों में दाख़िल हो, सताइश करते हुए उस की बारगाहों में हाज़िर हो। उसका शुक्र करो, उसके नाम की तमजीद करो!"]},{"type":"verse","number":5,"content":["क्योंकि रब भला है। उस की शफ़क़त अबदी है, और उस की वफ़ादारी पुश्त-दर-पुश्त क़ायम है।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/99.json","previousChapterAudioLinks":