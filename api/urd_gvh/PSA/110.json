{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["अबदी बादशाह और इमाम"]},{"type":"verse","number":1,"content":["दाऊद का ज़बूर। रब ने मेरे रब से कहा, “मेरे दहने हाथ बैठ, जब तक मैं तेरे दुश्मनों को तेरे पाँवों की चौकी न बना दूँ।”"]},{"type":"verse","number":2,"content":["रब सिय्यून से तेरी सलतनत की सरहद्दें बढ़ाकर कहेगा, “आस-पास के दुश्मनों पर हुकूमत कर!”"]},{"type":"verse","number":3,"content":["जिस दिन तू अपनी फ़ौज को खड़ा करेगा तेरी क़ौम ख़ुशी से तेरे पीछे हो लेगी। तू मुक़द्दस शानो-शौकत से आरास्ता होकर तुलूए-सुबह के बातिन से अपनी जवानी की ओस पाएगा।"]},{"type":"line_break"},{"type":"verse","number":4,"content":["रब ने क़सम खाई है और इससे पछताएगा नहीं, “तू अबद तक इमाम है, ऐसा इमाम जैसा मलिके-सिद्क़ था।”"]},{"type":"verse","number":5,"content":["रब तेरे दहने हाथ पर रहेगा और अपने ग़ज़ब के दिन दीगर बादशाहों को चूर चूर करेगा।"]},{"type":"verse","number":6,"content":["वह क़ौमों में अदालत करके मैदान को लाशों से भर देगा और दूर तक सरों को पाश पाश करेगा।"]},{"type":"verse","number":7,"content":["रास्ते में वह नदी से पानी पी लेगा, इसलिए अपना सर उठाए फिरेगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}