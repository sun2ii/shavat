{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["अल्लाह की अज़मत और मेहरबानी"]},{"type":"verse","number":1,"content":["रब की हम्द हो! ऐ रब के ख़ादिमो, रब के नाम की सताइश करो, रब के नाम की तारीफ़ करो।"]},{"type":"verse","number":2,"content":["रब के नाम की अब से अबद तक तमजीद हो।"]},{"type":"verse","number":3,"content":["तुलूए-सुबह से ग़ुरूबे-आफ़ताब तक रब के नाम की हम्द हो।"]},{"type":"verse","number":4,"content":["रब तमाम अक़वाम से सरबुलंद है, उसका जलाल आसमान से अज़ीम है।"]},{"type":"verse","number":5,"content":["कौन रब हमारे ख़ुदा की मानिंद है जो बुलंदियों पर तख़्तनशीन है"]},{"type":"verse","number":6,"content":["और आसमानो-ज़मीन को देखने के लिए नीचे झुकता है?"]},{"type":"verse","number":7,"content":["पस्तहाल को वह ख़ाक में से उठाकर पाँवों पर खड़ा करता, मुहताज को राख से निकालकर सरफ़राज़ करता है।"]},{"type":"verse","number":8,"content":["वह उसे शुरफ़ा के साथ, अपनी क़ौम के शुरफ़ा के साथ बिठा देता है।"]},{"type":"verse","number":9,"content":["बाँझ को वह औलाद अता करता है ताकि वह घर में ख़ुशी से ज़िंदगी गुज़ार सके। रब की हम्द हो!"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}