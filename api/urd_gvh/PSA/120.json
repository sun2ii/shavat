{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["तोहमत लगानेवालों से रिहाई के लिए दुआ"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। मुसीबत में मैंने रब को पुकारा, और उसने मेरी सुनी।"]},{"type":"verse","number":2,"content":["ऐ रब, मेरी जान को झूटे होंटों और फ़रेबदेह ज़बान से बचा।"]},{"type":"verse","number":3,"content":["ऐ फ़रेबदेह ज़बान, वह तेरे साथ किया करे, मज़ीद तुझे क्या दे?"]},{"type":"verse","number":4,"content":["वह तुझ पर जंगजू के तेज़ तीर और दहकते कोयले बरसाए!"]},{"type":"line_break"},{"type":"verse","number":5,"content":["मुझ पर अफ़सोस! मुझे अजनबी मुल्क मसक में, क़ीदार के ख़ैमों के पास रहना पड़ता है।"]},{"type":"verse","number":6,"content":["इतनी देर से अमन के दुश्मनों के पास रहने से मेरी जान तंग आ गई है।"]},{"type":"verse","number":7,"content":["मैं तो अमन चाहता हूँ, लेकिन जब कभी बोलूँ तो वह जंग करने पर तुले होते हैं।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/121.json","nextChapterAudioLinks