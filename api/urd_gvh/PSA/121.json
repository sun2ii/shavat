{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["इनसान का वफ़ादार मुहाफ़िज़"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। मैं अपनी आँखों को पहाड़ों की तरफ़ उठाता हूँ। मेरी मदद कहाँ से आती है?"]},{"type":"verse","number":2,"content":["मेरी मदद रब से आती है, जो आसमानो-ज़मीन का ख़ालिक़ है।"]},{"type":"line_break"},{"type":"verse","number":3,"content":["वह तेरा पाँव फिसलने नहीं देगा। तेरा मुहाफ़िज़ ऊँघने का नहीं।"]},{"type":"verse","number":4,"content":["यक़ीनन इसराईल का मुहाफ़िज़ न ऊँघता है, न सोता है।"]},{"type":"verse","number":5,"content":["रब तेरा मुहाफ़िज़ है, रब तेरे दहने हाथ पर सायबान है।"]},{"type":"verse","number":6,"content":["न दिन को सूरज, न रात को चाँद तुझे ज़रर पहुँचाएगा।"]},{"type":"verse","number":7,"content":["रब तुझे हर नुक़सान से बचाएगा, वह तेरी जान को महफ़ूज़ रखेगा।"]},{"type":"verse","number":8,"content":["रब अब से अबद तक तेरे आने जाने की पहरादारी करेगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}