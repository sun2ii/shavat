{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["यरूशलम पर बरकत"]},{"type":"verse","number":1,"content":["दाऊद का ज़ियारत का गीत। मैं उनसे ख़ुश हुआ जिन्होंने मुझसे कहा, “आओ, हम रब के घर चलें।”"]},{"type":"verse","number":2,"content":["ऐ यरूशलम, अब हमारे पाँव तेरे दरवाज़ों में खड़े हैं।"]},{"type":"verse","number":3,"content":["यरूशलम शहर यों बनाया गया है कि उसके तमाम हिस्से मज़बूती से एक दूसरे के साथ जुड़े हुए हैं।"]},{"type":"verse","number":4,"content":["वहाँ क़बीले, हाँ रब के क़बीले हाज़िर होते हैं ताकि रब के नाम की सताइश करें जिस तरह इसराईल को फ़रमाया गया है।"]},{"type":"verse","number":5,"content":["क्योंकि वहाँ तख़्ते-अदालत करने के लिए लगाए गए हैं, वहाँ दाऊद के घराने के तख़्त हैं।"]},{"type":"verse","number":6,"content":["यरूशलम के लिए सलामती माँगो! “जो तुझसे प्यार करते हैं वह सुकून पाएँ।"]},{"type":"verse","number":7,"content":["तेरी फ़सील में सलामती और तेरे महलों में सुकून हो।”"]},{"type":"verse","number":8,"content":["अपने भाइयों और हमसायों की ख़ातिर मैं कहूँगा, “तेरे अंदर सलामती हो!”"]},{"type":"verse","number":9,"content":["रब हमारे ख़ुदा के घर की ख़ातिर मैं तेरी ख़ुशहाली का तालिब रहूँगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}