{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"heading","content":["अल्लाह हम पर मेहरबानी करे"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। मैं अपनी आँखों को तेरी तरफ़ उठाता हूँ, तेरी तरफ़ जो आसमान पर तख़्तनशीन है।"]},{"type":"verse","number":2,"content":["जिस तरह ग़ुलाम की आँखें अपने मालिक के हाथ की तरफ़ और लौंडी की आँखें अपनी मालिकन के हाथ की तरफ़ लगी रहती हैं उसी तरह हमारी आँखें रब अपने ख़ुदा पर लगी रहती हैं, जब तक वह हम पर मेहरबानी न करे।"]},{"type":"verse","number":3,"content":["ऐ रब, हम पर मेहरबानी कर, हम पर मेहरबानी कर! क्योंकि हम हद से ज़्यादा हिक़ारत का निशाना बन गए हैं।"]},{"type":"verse","number":4,"content":["सुकून से ज़िंदगी गुज़ारनेवालों की लान-तान और मग़रूरों की तहक़ीर से हमारी जान दूभर हो गई है।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}