{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["चारों तरफ़ से क़ौम की हिफ़ाज़त"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। जो रब पर भरोसा रखते हैं वह कोहे-सिय्यून की मानिंद हैं जो कभी नहीं डगमगाता बल्कि अबद तक क़ायम रहता है।"]},{"type":"verse","number":2,"content":["जिस तरह यरूशलम पहाड़ों से घिरा रहता है उसी तरह रब अपनी क़ौम को अब से अबद तक चारों तरफ़ से महफ़ूज़ रखता है।"]},{"type":"verse","number":3,"content":["क्योंकि बेदीनों की रास्तबाज़ों की मीरास पर हुकूमत नहीं रहेगी, ऐसा न हो कि रास्तबाज़ बदकारी करने की आज़माइश में पड़ जाएँ।"]},{"type":"verse","number":4,"content":["ऐ रब, उनसे भलाई कर जो नेक हैं, जो दिल से सीधी राह पर चलते हैं।"]},{"type":"verse","number":5,"content":["लेकिन जो भटककर अपनी टेढ़ी-मेढ़ी राहों पर चलते हैं उन्हें रब बदकारों के साथ ख़ारिज कर दे। इसराईल की सलामती हो!"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}