{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["रब अपने क़ैदियों को रिहाई देता है"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। जब रब ने सिय्यून को बहाल किया तो ऐसा लग रहा था कि हम ख़ाब देख रहे हैं।"]},{"type":"verse","number":2,"content":["तब हमारा मुँह हँसी-ख़ुशी से भर गया, और हमारी ज़बान शादमानी के नारे लगाने से रुक न सकी। तब दीगर क़ौमों में कहा गया, “रब ने उनके लिए ज़बरदस्त काम किया है।”"]},{"type":"verse","number":3,"content":["रब ने वाक़ई हमारे लिए ज़बरदस्त काम किया है। हम कितने ख़ुश थे, कितने ख़ुश!"]},{"type":"line_break"},{"type":"verse","number":4,"content":["ऐ रब, हमें बहाल कर। जिस तरह मौसमे-बरसात में दश्ते-नजब के ख़ुश्क नाले पानी से भर जाते हैं उसी तरह हमें बहाल कर।"]},{"type":"verse","number":5,"content":["जो आँसू बहा बहाकर बीज बोएँ वह ख़ुशी के नारे लगाकर फ़सल काटेंगे।"]},{"type":"verse","number":6,"content":["वह रोते हुए बीज बोने के लिए निकलेंगे, लेकिन जब फ़सल पक जाए तो ख़ुशी के नारे लगाकर पूले उठाए अपने घर लौटेंगे।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}