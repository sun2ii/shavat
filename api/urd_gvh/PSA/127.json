{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["अल्लाह ही हमारा घर तामीर करता है"]},{"type":"verse","number":1,"content":["सुलेमान का ज़ियारत का गीत। अगर रब घर को तामीर न करे तो उस पर काम करनेवालों की मेहनत अबस है। अगर रब शहर की पहरादारी न करे तो इनसानी पहरेदारों की निगहबानी अबस है।"]},{"type":"verse","number":2,"content":["यह भी अबस है कि तुम सुबह-सवेरे उठो और पूरे दिन मेहनत-मशक़्क़त के साथ रोज़ी कमाकर रात गए सो जाओ। क्योंकि जो अल्लाह को प्यारे हैं उन्हें वह उनकी ज़रूरियात उनके सोते में पूरी कर देता है।"]},{"type":"line_break"},{"type":"verse","number":3,"content":["बच्चे ऐसी नेमत हैं जो हम मीरास में रब से पाते हैं, औलाद एक अज्र है जो वही हमें देता है।"]},{"type":"verse","number":4,"content":["जवानी में पैदा हुए बेटे सूरमे के हाथ में तीरों की मानिंद हैं।"]},{"type":"verse","number":5,"content":["मुबारक है वह आदमी जिसका तरकश उनसे भरा है। जब वह शहर के दरवाज़े पर अपने दुश्मनों से झगड़ेगा तो शरमिंदा नहीं होगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/127.json","thisChapterAudioLinks":{},"n