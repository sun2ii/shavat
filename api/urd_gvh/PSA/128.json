{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["जिस ख़ानदान को अल्लाह बरकत देता है"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। मुबारक है वह जो रब का ख़ौफ़ मानकर उस की राहों पर चलता है।"]},{"type":"verse","number":2,"content":["यक़ीनन तू अपनी मेहनत का फल खाएगा। मुबारक हो, क्योंकि तू कामयाब होगा।"]},{"type":"verse","number":3,"content":["घर में तेरी बीवी अंगूर की फलदार बेल की मानिंद होगी, और तेरे बेटे मेज़ के इर्दगिर्द बैठकर ज़ैतून की ताज़ा शाख़ों",{"noteId":16},"की मानिंद होंगे।"]},{"type":"verse","number":4,"content":["जो आदमी रब का ख़ौफ़ माने उसे ऐसी ही बरकत मिलेगी।"]},{"type":"verse","number":5,"content":["रब तुझे कोहे-सिय्यून से बरकत दे। वह करे कि तू जीते-जी यरूशलम की ख़ुशहाली देखे,"]},{"type":"verse","number":6,"content":["कि तू अपने पोतों-नवासों को भी देखे। इसराईल की सलामती हो!"]}],"footnotes":[{"noteId":16,"caller":"+","text":"इससे मुराद है पैवंदकारी के लिए दरख़्त से काटी गई टहनियाँ।","reference":{"chapter":128,"verse":3}}]},"thisChapterLink":"/api/urd_gvh/PSA/128.json","thisChapte