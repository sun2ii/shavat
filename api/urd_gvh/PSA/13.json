{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["मदद के लिए दुआ"]},{"type":"verse","number":1,"content":["दाऊद का ज़बूर। मौसीक़ी के राहनुमा के लिए। ऐ रब, कब तक? क्या तू मुझे अबद तक भूला रहेगा? तू कब तक अपना चेहरा मुझसे छुपाए रखेगा?"]},{"type":"verse","number":2,"content":["मेरी जान कब तक परेशानियों में मुब्तला रहे, मेरा दिल कब तक रोज़ बरोज़ दुख उठाता रहे? मेरा दुश्मन कब तक मुझ पर ग़ालिब रहेगा?"]},{"type":"line_break"},{"type":"verse","number":3,"content":["ऐ रब मेरे ख़ुदा, मुझ पर नज़र डालकर मेरी सुन! मेरी आँखों को रौशन कर, वरना मैं मौत की नींद सो जाऊँगा।"]},{"type":"verse","number":4,"content":["तब मेरा दुश्मन कहेगा, “मैं उस पर ग़ालिब आ गया हूँ!” और मेरे मुख़ालिफ़ शादियाना बजाएंगे कि मैं हिल गया हूँ।"]},{"type":"line_break"},{"type":"verse","number":5,"content":["लेकिन मैं तेरी शफ़क़त पर भरोसा रखता हूँ, मेरा दिल तेरी नजात देखकर ख़ुशी मनाएगा।"]},{"type":"verse","number":6,"content":["मैं रब की तमजीद में गीत गाऊँगा, क्योंकि उसने मुझ पर एहसान किया है।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}