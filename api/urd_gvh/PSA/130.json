{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["बड़ी मुसीबत से रिहाई की दुआ (तौबा का छटा ज़बूर)"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। ऐ रब, मैं तुझे गहराइयों से पुकारता हूँ।"]},{"type":"verse","number":2,"content":["ऐ रब, मेरी आवाज़ सुन! कान लगाकर मेरी इल्तिजाओं पर ध्यान दे!"]},{"type":"verse","number":3,"content":["ऐ रब, अगर तू हमारे गुनाहों का हिसाब करे तो कौन क़ायम रहेगा? कोई भी नहीं!"]},{"type":"verse","number":4,"content":["लेकिन तुझसे मुआफ़ी हासिल होती है ताकि तेरा ख़ौफ़ माना जाए।"]},{"type":"line_break"},{"type":"verse","number":5,"content":["मैं रब के इंतज़ार में हूँ, मेरी जान शिद्दत से इंतज़ार करती है। मैं उसके कलाम से उम्मीद रखता हूँ।"]},{"type":"verse","number":6,"content":["पहरेदार जिस शिद्दत से पौ फटने के इंतज़ार में रहते हैं, मेरी जान उससे भी ज़्यादा शिद्दत के साथ, हाँ ज़्यादा शिद्दत के साथ रब की मुंतज़िर रहती है।"]},{"type":"line_break"},{"type":"verse","number":7,"content":["ऐ इसराईल, रब की राह देखता रह! क्योंकि रब के पास शफ़क़त और फ़िद्या का ठोस बंदोबस्त है।"]},{"type":"verse","number":8,"content":["वह इसराईल के तमाम गुनाहों का फ़िद्या देकर उसे नजात देगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}