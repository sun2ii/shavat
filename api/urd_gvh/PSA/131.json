{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"heading","content":["बच्चे का-सा ईमान"]},{"type":"verse","number":1,"content":["ज़ियारत का गीत। ऐ रब, न मेरा दिल घमंडी है, न मेरी आँखें मग़रूर हैं। जो बातें इतनी अज़ीम और हैरानकुन हैं कि मैं उनसे निपट नहीं सकता उन्हें मैं नहीं छेड़ता।"]},{"type":"verse","number":2,"content":["यक़ीनन मैंने अपनी जान को राहत और सुकून दिलाया है, और अब वह माँ की गोद में बैठे छोटे बच्चे की मानिंद है, हाँ मेरी जान छोटे बच्चे",{"noteId":17},"की मानिंद है।"]},{"type":"verse","number":3,"content":["ऐ इसराईल, अब से अबद तक रब के इंतज़ार में रह!"]}],"footnotes":[{"noteId":17,"caller":"+","text":"जिस बच्चे ने माँ का दूध पीना छोड़ दिया है।","reference":{"chapter":131,"verse":2}}]},"thisChapterLink":"/api/urd_gvh/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}