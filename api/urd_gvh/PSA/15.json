{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["कौन अल्लाह के हुज़ूर क़ायम रह सकता है?"]},{"type":"verse","number":1,"content":["दाऊद का ज़बूर। ऐ रब, कौन तेरे ख़ैमे में ठहर सकता है? किस को तेरे मुक़द्दस पहाड़ पर रहने की इजाज़त है?"]},{"type":"verse","number":2,"content":["वह जिसका चाल-चलन बेगुनाह है, जो रास्तबाज़ ज़िंदगी गुज़ारकर दिल से सच बोलता है।"]},{"type":"verse","number":3,"content":["ऐसा शख़्स अपनी ज़बान से किसी पर तोहमत नहीं लगाता। न वह अपने पड़ोसी पर ज़्यादती करता, न उस की बेइज़्ज़ती करता है।"]},{"type":"verse","number":4,"content":["वह मरदूद को हक़ीर जानता लेकिन ख़ुदातरस की इज़्ज़त करता है। जो वादा उसने क़सम खाकर किया उसे पूरा करता है, ख़ाह उसे कितना ही नुक़सान क्यों न पहुँचे।"]},{"type":"verse","number":5,"content":["वह सूद लिए बग़ैर उधार देता है और उस की रिश्वत क़बूल नहीं करता जो बेगुनाह का हक़ मारना चाहता है। ऐसा शख़्स कभी डाँवाँडोल नहीं होगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}