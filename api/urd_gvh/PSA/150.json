{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"heading","content":["रब की हम्दो-सना"]},{"type":"verse","number":1,"content":["रब की हम्द हो! अल्लाह के मक़दिस में उस की सताइश करो। उस की क़ुदरत के बने हुए आसमानी गुंबद में उस की तमजीद करो।"]},{"type":"verse","number":2,"content":["उसके अज़ीम कामों के बाइस उस की हम्द करो। उस की ज़बरदस्त अज़मत के बाइस उस की सताइश करो।"]},{"type":"verse","number":3,"content":["नरसिंगा फूँककर उस की हम्द करो, सितार और सरोद बजाकर उस की तमजीद करो।"]},{"type":"verse","number":4,"content":["दफ़ और लोकनाच से उस की हम्द करो। तारदार साज़ और बाँसरी बजाकर उस की सताइश करो।"]},{"type":"verse","number":5,"content":["झाँझों की झंकारती आवाज़ से उस की हम्द करो, गूँजती झाँझ से उस की तारीफ़ करो।"]},{"type":"verse","number":6,"content":["जिसमें भी साँस है वह रब की सताइश करे। रब की हम्द हो!।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}