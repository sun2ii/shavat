{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["अच्छा चरवाहा"]},{"type":"verse","number":1,"content":["दाऊद का ज़बूर। रब मेरा चरवाहा है, मुझे कमी न होगी।"]},{"type":"verse","number":2,"content":["वह मुझे शादाब चरागाहों में चराता और पुरसुकून चश्मों के पास ले जाता है।"]},{"type":"verse","number":3,"content":["वह मेरी जान को ताज़ादम करता और अपने नाम की ख़ातिर रास्ती की राहों पर मेरी क़ियादत करता है।"]},{"type":"verse","number":4,"content":["गो मैं तारीकतरीन वादी में से गुज़रूँ मैं मुसीबत से नहीं डरूँगा, क्योंकि तू मेरे साथ है, तेरी लाठी और तेरा असा मुझे तसल्ली देते हैं।"]},{"type":"line_break"},{"type":"verse","number":5,"content":["तू मेरे दुश्मनों के रूबरू मेरे सामने मेज़ बिछाकर मेरे सर को तेल से तरो-ताज़ा करता है। मेरा प्याला तेरी बरकत से छलक उठता है।"]},{"type":"verse","number":6,"content":["यक़ीनन भलाई और शफ़क़त उम्र-भर मेरे साथ साथ रहेंगी, और मैं जीते-जी रब के घर में सुकूनत करूँगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}