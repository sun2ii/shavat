{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["तमाम क़ौमें अल्लाह की तारीफ़ करें"]},{"type":"verse","number":1,"content":["ज़बूर। तारदार साज़ों के साथ गाना है। मौसीक़ी के राहनुमा के लिए। अल्लाह हम पर मेहरबानी करे और हमें बरकत दे। वह अपने चेहरे का नूर हम पर चमकाए (सिलाह)"]},{"type":"verse","number":2,"content":["ताकि ज़मीन पर तेरी राह और तमाम क़ौमों में तेरी नजात मालूम हो जाए।"]},{"type":"line_break"},{"type":"verse","number":3,"content":["ऐ अल्लाह, क़ौमें तेरी सताइश करें, तमाम क़ौमें तेरी सताइश करें।"]},{"type":"line_break"},{"type":"verse","number":4,"content":["उम्मतें शादमान होकर ख़ुशी के नारे लगाएँ, क्योंकि तू इनसाफ़ से क़ौमों की अदालत करेगा और ज़मीन पर उम्मतों की क़ियादत करेगा। (सिलाह)"]},{"type":"line_break"},{"type":"verse","number":5,"content":["ऐ अल्लाह, क़ौमें तेरी सताइश करें, तमाम क़ौमें तेरी सताइश करें।"]},{"type":"line_break"},{"type":"verse","number":6,"content":["ज़मीन अपनी फ़सलें देती है। अल्लाह हमारा ख़ुदा हमें बरकत दे!"]},{"type":"verse","number":7,"content":["अल्लाह हमें बरकत दे, और दुनिया की इंतहाएँ सब उसका ख़ौफ़ मानें।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}