{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["दुश्मन से नजात की दुआ"]},{"type":"verse","number":1,"content":["दाऊद का ज़बूर। मौसीक़ी के राहनुमा के लिए। याददाश्त के लिए। ऐ अल्लाह, जल्दी से आकर मुझे बचा! ऐ रब, मेरी मदद करने में जल्दी कर!"]},{"type":"verse","number":2,"content":["मेरे जानी दुश्मन शरमिंदा हो जाएँ, उनकी सख़्त रुसवाई हो जाए। जो मेरी मुसीबत देखने से लुत्फ़ उठाते हैं वह पीछे हट जाएँ, उनका मुँह काला हो जाए।"]},{"type":"verse","number":3,"content":["जो मेरी मुसीबत देखकर क़हक़हा लगाते हैं वह शर्म के मारे पुश्त दिखाएँ।"]},{"type":"verse","number":4,"content":["लेकिन तेरे तालिब शादमान होकर तेरी ख़ुशी मनाएँ। जिन्हें तेरी नजात प्यारी है वह हमेशा कहें, “अल्लाह अज़ीम है!”"]},{"type":"verse","number":5,"content":["लेकिन मैं नाचार और मुहताज हूँ। ऐ अल्लाह, जल्दी से मेरे पास आ! तू ही मेरा सहारा और मेरा नजातदहिंदा है। ऐ रब, देर न कर!"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}