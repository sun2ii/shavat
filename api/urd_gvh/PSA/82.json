{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["सबसे आला मुंसिफ़"]},{"type":"verse","number":1,"content":["आसफ़ का ज़बूर। अल्लाह इलाही मजलिस में खड़ा है, माबूदों के दरमियान वह अदालत करता है,"]},{"type":"verse","number":2,"content":["“तुम कब तक अदालत में ग़लत फ़ैसले करके बेदीनों की जानिबदारी करोगे? (सिलाह)"]},{"type":"verse","number":3,"content":["पस्तहालों और यतीमों का इनसाफ़ करो, मुसीबतज़दों और ज़रूरतमंदों के हुक़ूक़ क़ायम रखो।"]},{"type":"verse","number":4,"content":["पस्तहालों और ग़रीबों को बचाकर बेदीनों के हाथ से छुड़ाओ।”"]},{"type":"line_break"},{"type":"verse","number":5,"content":["लेकिन वह कुछ नहीं जानते, उन्हें समझ ही नहीं आती। वह तारीकी में टटोल टटोलकर घुमते-फिरते हैं जबकि ज़मीन की तमाम बुनियादें झूमने लगी हैं।"]},{"type":"verse","number":6,"content":["बेशक मैंने कहा, “तुम ख़ुदा हो, सब अल्लाह तआला के फ़रज़ंद हो।"]},{"type":"verse","number":7,"content":["लेकिन तुम फ़ानी इनसान की तरह मर जाओगे, तुम दीगर हुक्मरानों की तरह गिर जाओगे।”"]},{"type":"line_break"},{"type":"verse","number":8,"content":["ऐ अल्लाह, उठकर ज़मीन की अदालत कर! क्योंकि तमाम अक़वाम तेरी ही मौरूसी मिलकियत हैं।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}