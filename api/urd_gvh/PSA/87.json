{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["सिय्यून अक़वाम की माँ है"]},{"type":"verse","number":1,"content":["क़ोरह की औलाद का ज़बूर। गीत। उस की बुनियाद मुक़द्दस पहाड़ों पर रखी गई है।"]},{"type":"verse","number":2,"content":["रब सिय्यून के दरवाज़ों को याक़ूब की दीगर आबादियों से कहीं ज़्यादा प्यार करता है।"]},{"type":"line_break"},{"type":"verse","number":3,"content":["ऐ अल्लाह के शहर, तेरे बारे में शानदार बातें सुनाई जाती हैं। (सिलाह)"]},{"type":"verse","number":4,"content":["रब फ़रमाता है, “मैं मिसर और बाबल को उन लोगों में शुमार करूँगा जो मुझे जानते हैं।” फिलिस्तिया, सूर और एथोपिया के बारे में भी कहा जाएगा, “इनकी पैदाइश यहीं हुई है।”"]},{"type":"line_break"},{"type":"verse","number":5,"content":["लेकिन सिय्यून के बारे में कहा जाएगा, “हर एक बाशिंदा उसमें पैदा हुआ है। अल्लाह तआला ख़ुद उसे क़ायम रखेगा।”"]},{"type":"verse","number":6,"content":["जब रब अक़वाम को किताब में दर्ज करेगा तो वह साथ साथ यह भी लिखेगा, “यह सिय्यून में पैदा हुई हैं।” (सिलाह)"]},{"type":"verse","number":7,"content":["और लोग नाचते हुए गाएँगे, “मेरे तमाम चश्मे तुझमें हैं।”"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}