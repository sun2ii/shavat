{"translation":{"id":"urd_gvh","name":"किताबे-मुक़द्दस","website":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvh","licenseNotes":null,"shortName":"GVH","englishName":"Urdu Geo Bible, Hindi Script","language":"urd","textDirection":"ltr","sha256":"174edb1ea3e5a5ccb89fa9f9ccbd0a6bd153eb052c7658f2d992344f13704830","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvh/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvh","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"25b9ea67a401560abda9f70fecd9f9db60650138c53a8a6b75e38570ffd644f9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvh/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvh/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["अल्लाह अबदी बादशाह है"]},{"type":"verse","number":1,"content":["रब बादशाह है, वह जलाल से मुलब्बस है। रब जलाल से मुलब्बस और क़ुदरत से कमरबस्ता है। यक़ीनन दुनिया मज़बूत बुनियाद पर क़ायम है, और वह नहीं डगमगाएगी।"]},{"type":"line_break"},{"type":"verse","number":2,"content":["तेरा तख़्त क़दीम ज़माने से क़ायम है, तू अज़ल से मौजूद है।"]},{"type":"verse","number":3,"content":["ऐ रब, सैलाब गरज उठे, सैलाब शोर मचाकर गरज उठे, सैलाब ठाठें मारकर गरज उठे।"]},{"type":"verse","number":4,"content":["लेकिन एक है जो गहरे पानी के शोर से ज़्यादा ज़ोरावर, जो समुंदर की ठाठों से ज़्यादा ताक़तवर है। रब जो बुलंदियों पर रहता है कहीं ज़्यादा अज़ीम है।"]},{"type":"line_break"},{"type":"verse","number":5,"content":["ऐ रब, तेरे अहकाम हर तरह से क़ाबिले-एतमाद हैं। तेरा घर हमेशा तक क़ुद्दूसियत से आरास्ता रहेगा।"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvh/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvh/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvh/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}