{"translation":{"id":"urd_gvr","name":"Kitab-i Muqaddas","website":"https://ebible.org/Scriptures/details.php?id=urdgvr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvr","licenseNotes":null,"shortName":"GVR","englishName":"The Holy Bible in Urdu, Urdu Geo Version, Roman Script","language":"urd","textDirection":"ltr","sha256":"1b5d9c21648713cf06dbacf411f11c3a13b583a1e6724f3224e462143a8c9324","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvr","name":"Zabūr","commonName":"Zabūr","title":"Zabūr","order":19,"numberOfChapters":150,"sha256":"52313cf778b8fa959c3a66eef5b47217c66b2b39c9d58c3299dd17f27c3f9891","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvr/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Insān kā Wafādār Muhāfiz"]},{"type":"verse","number":1,"content":["Ziyārat kā gīt. Maiṅ apnī āṅkhoṅ ko pahāṛoṅ kī taraf uṭhātā hūṅ. Merī madad kahāṅ se ātī hai?"]},{"type":"verse","number":2,"content":["Merī madad Rab se ātī hai, jo āsmān-o-zamīn kā Ḳhāliq hai."]},{"type":"line_break"},{"type":"verse","number":3,"content":["Wuh terā pāṅw phisalne nahīṅ degā. Terā muhāfiz ūṅghne kā nahīṅ."]},{"type":"verse","number":4,"content":["Yaqīnan Isrāīl kā muhāfiz na ūṅghtā hai, na sotā hai."]},{"type":"verse","number":5,"content":["Rab terā muhāfiz hai, Rab tere dahne hāth par sāebān hai."]},{"type":"verse","number":6,"content":["Na din ko sūraj, na rāt ko chāṅd tujhe zarar pahuṅchāegā."]},{"type":"verse","number":7,"content":["Rab tujhe har nuqsān se bachāegā, wuh terī jān ko mahfūz rakhegā."]},{"type":"verse","number":8,"content":["Rab ab se abad tak tere āne jāne kī pahrādārī karegā."]}],"footnotes":[]},"thisChapterLink":"/api/urd_gv