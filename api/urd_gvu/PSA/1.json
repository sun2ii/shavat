{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["دو راہیں"]},{"type":"verse","number":1,"content":["مبارک ہے وہ جو نہ بےدینوں کے مشورے پر چلتا، نہ گناہ گاروں کی راہ پر قدم رکھتا، اور نہ طعنہ زنوں کے ساتھ بیٹھتا ہے"]},{"type":"verse","number":2,"content":["بلکہ رب کی شریعت سے لطف اندوز ہوتا اور دن رات اُسی پر غور و خوض کرتا رہتا ہے۔"]},{"type":"verse","number":3,"content":["وہ نہروں کے کنارے پر لگے درخت کی مانند ہے۔ وقت پر وہ پھل لاتا، اور اُس کے پتے نہیں مُرجھاتے۔ جو کچھ بھی کرے اُس میں وہ کامیاب ہے۔"]},{"type":"line_break"},{"type":"verse","number":4,"content":["بےدینوں کا یہ حال نہیں ہوتا۔ وہ بھوسے کی مانند ہیں جسے ہَوا اُڑا لے جاتی ہے۔"]},{"type":"verse","number":5,"content":["اِس لئے بےدین عدالت میں قائم نہیں رہیں گے، اور گناہ گار کا راست بازوں کی مجلس میں مقام نہیں ہو گا۔"]},{"type":"verse","number":6,"content":["کیونکہ رب راست بازوں کی راہ کی پہرا داری کرتا ہے جبکہ بےدینوں کی راہ تباہ ہو جائے گی۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}