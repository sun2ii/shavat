ل دیا۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}