{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["یروشلم پر برکت"]},{"type":"verse","number":1,"content":["داؤد کا زیارت کا گیت۔ مَیں اُن سے خوش ہوا جنہوں نے مجھ سے کہا، ”آؤ، ہم رب کے گھر چلیں۔“"]},{"type":"verse","number":2,"content":["اے یروشلم، اب ہمارے پاؤں تیرے دروازوں میں کھڑے ہیں۔"]},{"type":"verse","number":3,"content":["یروشلم شہر یوں بنایا گیا ہے کہ اُس کے تمام حصے مضبوطی سے ایک دوسرے کے ساتھ جُڑے ہوئے ہیں۔"]},{"type":"verse","number":4,"content":["وہاں قبیلے، ہاں رب کے قبیلے حاضر ہوتے ہیں تاکہ رب کے نام کی ستائش کریں جس طرح اسرائیل کو فرمایا گیا ہے۔"]},{"type":"verse","number":5,"content":["کیونکہ وہاں تخت عدالت کرنے کے لئے لگائے گئے ہیں، وہاں داؤد کے گھرانے کے تخت ہیں۔"]},{"type":"verse","number":6,"content":["یروشلم کے لئے سلامتی مانگو! ”جو تجھ سے پیار کرتے ہیں وہ سکون پائیں۔"]},{"type":"verse","number":7,"content":["تیری فصیل میں سلامتی اور تیرے محلوں میں سکون ہو۔“"]},{"type":"verse","number":8,"content":["اپنے بھائیوں اور ہم سایوں کی خاطر مَیں کہوں گا، ”تیرے اندر سلامتی ہو!“"]},{"type":"verse","number":9,"content":["رب ہمارے خدا کے گھر کی خاطر مَیں تیری خوش حالی کا طالب رہوں گا۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}