{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["رب اپنے قیدیوں کو رِہائی دیتا ہے"]},{"type":"verse","number":1,"content":["زیارت کا گیت۔ جب رب نے صیون کو بحال کیا تو ایسا لگ رہا تھا کہ ہم خواب دیکھ رہے ہیں۔"]},{"type":"verse","number":2,"content":["تب ہمارا منہ ہنسی خوشی سے بھر گیا، اور ہماری زبان شادمانی کے نعرے لگانے سے رُک نہ سکی۔ تب دیگر قوموں میں کہا گیا، ”رب نے اُن کے لئے زبردست کام کیا ہے۔“"]},{"type":"verse","number":3,"content":["رب نے واقعی ہمارے لئے زبردست کام کیا ہے۔ ہم کتنے خوش تھے، کتنے خوش!"]},{"type":"line_break"},{"type":"verse","number":4,"content":["اے رب، ہمیں بحال کر۔ جس طرح موسمِ برسات میں دشتِ نجب کے خشک نالے پانی سے بھر جاتے ہیں اُسی طرح ہمیں بحال کر۔"]},{"type":"verse","number":5,"content":["جو آنسو بہا بہا کر بیج بوئیں وہ خوشی کے نعرے لگا کر فصل کاٹیں گے۔"]},{"type":"verse","number":6,"content":["وہ روتے ہوئے بیج بونے کے لئے نکلیں گے، لیکن جب فصل پک جائے تو خوشی کے نعرے لگا کر پُولے اُٹھائے اپنے گھر لوٹیں گے۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/126.json","thisCha