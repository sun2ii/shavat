{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["مدد کے لئے اسرائیل کی دعا"]},{"type":"verse","number":1,"content":["زیارت کا گیت۔ اسرائیل کہے، ”میری جوانی سے ہی میرے دشمن بار بار مجھ پر حملہ آور ہوئے ہیں۔"]},{"type":"verse","number":2,"content":["میری جوانی سے ہی وہ بار بار مجھ پر حملہ آور ہوئے ہیں۔ توبھی وہ مجھ پر غالب نہ آئے۔“"]},{"type":"verse","number":3,"content":["ہل چلانے والوں نے میری پیٹھ پر ہل چلا کر اُس پر اپنی لمبی لمبی ریگھاریاں بنائی ہیں۔"]},{"type":"verse","number":4,"content":["رب راست ہے۔ اُس نے بےدینوں کے رسّے کاٹ کر مجھے آزاد کر دیا ہے۔"]},{"type":"line_break"},{"type":"verse","number":5,"content":["اللہ کرے کہ جتنے بھی صیون سے نفرت رکھیں وہ شرمندہ ہو کر پیچھے ہٹ جائیں۔"]},{"type":"verse","number":6,"content":["وہ چھتوں پر کی گھاس کی مانند ہوں جو صحیح طور پر بڑھنے سے پہلے ہی مُرجھا جاتی ہے"]},{"type":"verse","number":7,"content":["اور جس سے نہ فصل کاٹنے والا اپنا ہاتھ، نہ پُولے باندھنے والا اپنا بازو بھر سکے۔"]},{"type":"verse","number":8,"content":["جو بھی اُن سے گزرے وہ نہ کہے، ”رب تمہیں برکت دے۔“ ہم رب کا نام لے کر تمہیں برکت دیتے ہیں!"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}