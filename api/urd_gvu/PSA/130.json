{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["بڑی مصیبت سے رِہائی کی دعا (توبہ کا چھٹا زبور)"]},{"type":"verse","number":1,"content":["زیارت کا گیت۔ اے رب، مَیں تجھے گہرائیوں سے پکارتا ہوں۔"]},{"type":"verse","number":2,"content":["اے رب، میری آواز سن! کان لگا کر میری التجاؤں پر دھیان دے!"]},{"type":"verse","number":3,"content":["اے رب، اگر تُو ہمارے گناہوں کا حساب کرے تو کون قائم رہے گا؟ کوئی بھی نہیں!"]},{"type":"verse","number":4,"content":["لیکن تجھ سے معافی حاصل ہوتی ہے تاکہ تیرا خوف مانا جائے۔"]},{"type":"line_break"},{"type":"verse","number":5,"content":["مَیں رب کے انتظار میں ہوں، میری جان شدت سے انتظار کرتی ہے۔ مَیں اُس کے کلام سے اُمید رکھتا ہوں۔"]},{"type":"verse","number":6,"content":["پہرے دار جس شدت سے پَو پھٹنے کے انتظار میں رہتے ہیں، میری جان اُس سے بھی زیادہ شدت کے ساتھ، ہاں زیادہ شدت کے ساتھ رب کی منتظر رہتی ہے۔"]},{"type":"line_break"},{"type":"verse","number":7,"content":["اے اسرائیل، رب کی راہ دیکھتا رہ! کیونکہ رب کے پاس شفقت اور فدیہ کا ٹھوس بندوبست ہے۔"]},{"type":"verse","number":8,"content":["وہ اسرائیل کے تمام گناہوں کا فدیہ دے کر اُسے نجات دے گا۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}