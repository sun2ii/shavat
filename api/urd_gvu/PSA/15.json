{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["کون اللہ کے حضور قائم رہ سکتا ہے؟"]},{"type":"verse","number":1,"content":["داؤد کا زبور۔ اے رب، کون تیرے خیمے میں ٹھہر سکتا ہے؟ کس کو تیرے مُقدّس پہاڑ پر رہنے کی اجازت ہے؟"]},{"type":"verse","number":2,"content":["وہ جس کا چال چلن بےگناہ ہے، جو راست باز زندگی گزار کر دل سے سچ بولتا ہے۔"]},{"type":"verse","number":3,"content":["ایسا شخص اپنی زبان سے کسی پر تہمت نہیں لگاتا۔ نہ وہ اپنے پڑوسی پر زیادتی کرتا، نہ اُس کی بےعزتی کرتا ہے۔"]},{"type":"verse","number":4,"content":["وہ مردود کو حقیر جانتا لیکن خدا ترس کی عزت کرتا ہے۔ جو وعدہ اُس نے قَسم کھا کر کیا اُسے پورا کرتا ہے، خواہ اُسے کتنا ہی نقصان کیوں نہ پہنچے۔"]},{"type":"verse","number":5,"content":["وہ سود لئے بغیر اُدھار دیتا ہے اور اُس کی رشوت قبول نہیں کرتا جو بےگناہ کا حق مارنا چاہتا ہے۔ ایسا شخص کبھی ڈانواں ڈول نہیں ہو گا۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/16.json","nextChapterAudioLinks":{},"previousChapterAp