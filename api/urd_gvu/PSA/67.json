{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["تمام قومیں اللہ کی تعریف کریں"]},{"type":"verse","number":1,"content":["زبور۔ تاردار سازوں کے ساتھ گانا ہے۔ موسیقی کے راہنما کے لئے۔ اللہ ہم پر مہربانی کرے اور ہمیں برکت دے۔ وہ اپنے چہرے کا نور ہم پر چمکائے (سِلاہ)"]},{"type":"verse","number":2,"content":["تاکہ زمین پر تیری راہ اور تمام قوموں میں تیری نجات معلوم ہو جائے۔"]},{"type":"line_break"},{"type":"verse","number":3,"content":["اے اللہ، قومیں تیری ستائش کریں، تمام قومیں تیری ستائش کریں۔"]},{"type":"line_break"},{"type":"verse","number":4,"content":["اُمّتیں شادمان ہو کر خوشی کے نعرے لگائیں، کیونکہ تُو انصاف سے قوموں کی عدالت کرے گا اور زمین پر اُمّتوں کی قیادت کرے گا۔ (سِلاہ)"]},{"type":"line_break"},{"type":"verse","number":5,"content":["اے اللہ، قومیں تیری ستائش کریں، تمام قومیں تیری ستائش کریں۔"]},{"type":"line_break"},{"type":"verse","number":6,"content":["زمین اپنی فصلیں دیتی ہے۔ اللہ ہمارا خدا ہمیں برکت دے!"]},{"type":"verse","number":7,"content":["اللہ ہمیں برکت دے، اور دنیا کی انتہائیں سب اُس کا خوف مانیں۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}