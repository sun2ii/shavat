{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["دشمن سے نجات کی دعا"]},{"type":"verse","number":1,"content":["داؤد کا زبور۔ موسیقی کے راہنما کے لئے۔ یادداشت کے لئے۔ اے اللہ، جلدی سے آ کر مجھے بچا! اے رب، میری مدد کرنے میں جلدی کر!"]},{"type":"verse","number":2,"content":["میرے جانی دشمن شرمندہ ہو جائیں، اُن کی سخت رُسوائی ہو جائے۔ جو میری مصیبت دیکھنے سے لطف اُٹھاتے ہیں وہ پیچھے ہٹ جائیں، اُن کا منہ کالا ہو جائے۔"]},{"type":"verse","number":3,"content":["جو میری مصیبت دیکھ کر قہقہہ لگاتے ہیں وہ شرم کے مارے پشت دکھائیں۔"]},{"type":"verse","number":4,"content":["لیکن تیرے طالب شادمان ہو کر تیری خوشی منائیں۔ جنہیں تیری نجات پیاری ہے وہ ہمیشہ کہیں، ”اللہ عظیم ہے!“"]},{"type":"verse","number":5,"content":["لیکن مَیں ناچار اور محتاج ہوں۔ اے اللہ، جلدی سے میرے پاس آ! تُو ہی میرا سہارا اور میرا نجات دہندہ ہے۔ اے رب، دیر نہ کر!"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"