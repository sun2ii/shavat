{"translation":{"id":"urd_gvu","name":"کتابِ مقدّس","website":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdgvu","licenseNotes":null,"shortName":"GVU","englishName":"Urdu Geo Bible (Urdu Script)","language":"urd","textDirection":"rtl","sha256":"c996273eab92bb0833d6c0280511ac910f1eab57f2246f7fe220c3322616fab7","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_gvu/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30669,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_gvu","name":"زبور","commonName":"زبور","title":"زبور","order":19,"numberOfChapters":150,"sha256":"3f0706d74092062e41f5b482f82ca7515aff62b614b457897c6caf8e9451855a","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_gvu/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_gvu/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["سب سے اعلیٰ منصف"]},{"type":"verse","number":1,"content":["آسف کا زبور۔ اللہ الٰہی مجلس میں کھڑا ہے، معبودوں کے درمیان وہ عدالت کرتا ہے،"]},{"type":"verse","number":2,"content":["”تم کب تک عدالت میں غلط فیصلے کر کے بےدینوں کی جانب داری کرو گے؟ (سِلاہ)"]},{"type":"verse","number":3,"content":["پست حالوں اور یتیموں کا انصاف کرو، مصیبت زدوں اور ضرورت مندوں کے حقوق قائم رکھو۔"]},{"type":"verse","number":4,"content":["پست حالوں اور غریبوں کو بچا کر بےدینوں کے ہاتھ سے چھڑاؤ۔“"]},{"type":"line_break"},{"type":"verse","number":5,"content":["لیکن وہ کچھ نہیں جانتے، اُنہیں سمجھ ہی نہیں آتی۔ وہ تاریکی میں ٹٹول ٹٹول کر گھومتے پھرتے ہیں جبکہ زمین کی تمام بنیادیں جھومنے لگی ہیں۔"]},{"type":"verse","number":6,"content":["بےشک مَیں نے کہا، ”تم خدا ہو، سب اللہ تعالیٰ کے فرزند ہو۔"]},{"type":"verse","number":7,"content":["لیکن تم فانی انسان کی طرح مر جاؤ گے، تم دیگر حکمرانوں کی طرح گر جاؤ گے۔“"]},{"type":"line_break"},{"type":"verse","number":8,"content":["اے اللہ، اُٹھ کر زمین کی عدالت کر! کیونکہ تمام اقوام تیری ہی موروثی ملکیت ہیں۔"]}],"footnotes":[]},"thisChapterLink":"/api/urd_gvu/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_gvu/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_gvu/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}