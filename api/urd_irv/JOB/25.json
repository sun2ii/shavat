{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"JOB","translationId":"urd_irv","name":"अय्यूब","commonName":"अय्यूब","title":"अय्यूब","order":18,"numberOfChapters":42,"sha256":"cb17731565a4387e4996d6e8a244b8ab12ca7f701f6bcc370fe326dd12174f03","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/urd_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["बिलदद का अय्यूब को तिसरा जवाब"]},{"type":"verse","number":1,"content":["तब बिलदद सूखी ने जवाब दिया"]},{"type":"verse","number":2,"content":[{"text":"“हुकूमत और दबदबा उसके साथ है","poem":1},{"lineBreak":true},{"text":"वह अपने बुलन्द मक़ामों में अमन रखता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्या उसकी फ़ौजों की कोई ता'दाद है?","poem":1},{"lineBreak":true},{"text":"और कौन है जिस पर उसकी रोशनी नहीं पड़ती?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"फिर इंसान क्यूँकर ख़ुदा के सामने रास्त ठहर सकता है?","poem":1},{"lineBreak":true},{"text":"या वह जो 'औरत से पैदा हुआ है क्यूँकर पाक हो सकता है?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"देख, चाँद में भी रोशनी नहीं,","poem":1},{"lineBreak":true},{"text":"और तारे उसकी नज़र में पाक नहीं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"फिर भला इंसान का जो महज़ कीड़ा है,","poem":1},{"lineBreak":true},{"text":"और आदमज़ाद जो सिर्फ़ किरम है क्या ज़िक्र।”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}