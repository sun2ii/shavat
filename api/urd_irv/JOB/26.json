{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"JOB","translationId":"urd_irv","name":"अय्यूब","commonName":"अय्यूब","title":"अय्यूब","order":18,"numberOfChapters":42,"sha256":"cb17731565a4387e4996d6e8a244b8ab12ca7f701f6bcc370fe326dd12174f03","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/urd_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["अय्यूब का नौवां बयान: बिलदद को जवाब"]},{"type":"verse","number":1,"content":["तब अय्यूब ने जवाब दिया,"]},{"type":"verse","number":2,"content":[{"text":"“जो बे ताक़त उसकी तूने कैसी मदद की;","poem":1},{"lineBreak":true},{"text":"जिस बाज़ू में कु़व्वत न थी, उसको तू ने कैसा संभाला।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"नादान को तूने कैसी सलाह दी,","poem":1},{"lineBreak":true},{"text":"और हक़ीक़ी पहचान ख़ूब ही बताई।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू ने जो बातें कहीं?","poem":1},{"lineBreak":true},{"text":"इसलिए किस से और किसकी रूह तुझ में से हो कर निकली?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“मुर्दों की रूहें पानी और उसके रहने वालों के नीचे काँपती हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"पाताल उसके सामने खुला है,","poem":1},{"lineBreak":true},{"text":"और जहन्नुम बेपर्दा है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह शिमाल को फ़ज़ा में फैलाता है,","poem":1},{"lineBreak":true},{"text":"और ज़मीन को ख़ला में लटकाता है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह अपने पानी से भरे हुए बादलों पानी को बाँध देता","poem":1},{"lineBreak":true},{"text":"और बादल उसके बोझ से फटता नहीं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"वह अपने तख़्त को ढांक लेता है","poem":1},{"lineBreak":true},{"text":"और उसके ऊपर अपने बादल को तान देता है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"उसने रोशनी और अंधेरे के मिलने की जगह तक,","poem":1},{"lineBreak":true},{"text":"पानी की सतह पर हद बाँध दी है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"आसमान के सुतून काँपते,","poem":1},{"lineBreak":true},{"text":"और और झिड़की से हैरान होते हैं।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"वह अपनी क़ुदरत से समन्दर को तूफ़ानी करता,","poem":1},{"lineBreak":true},{"text":"और अपने फ़हम से रहब को छेद देता है।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"उसके दम से आसमान आरास्ता होता है,","poem":1},{"lineBreak":true},{"text":"उसके हाथ ने तेज़रू साँप को छेदा है।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"देखो, यह तो उसकी राहों के सिर्फ़ किनारे हैं,","poem":1},{"lineBreak":true},{"text":"और उसकी कैसी धीमी आवाज़ हम सुनते हैं।","poem":1},{"lineBreak":true},{"text":"लेकिन कौन उसकी क़ुदरत की गरज़ को समझ सकता है?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}