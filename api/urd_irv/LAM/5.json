{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"LAM","translationId":"urd_irv","name":"नोहा","commonName":"नोहा","title":"नोहा","order":25,"numberOfChapters":5,"sha256":"de3fcca8e51e12bd6d076d1954c9afdb8d0be81224b9555ca1cc762980bf2f9b","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/urd_irv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["दुआ और तजदीद"]},{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द, जो कुछ हम पर गुज़रा उसे याद कर;","poem":1},{"lineBreak":true},{"text":"नज़र कर और हमारी रुस्वाई को देख।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हमारी मीरास अजनबियों के हवाले की गई, हमारे घर बेगानों ने ले लिए।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हम यतीम हैं, हमारे बाप नहीं,","poem":1},{"lineBreak":true},{"text":"हमारी माँए बेवाओं की तरह हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हम ने अपना पानी मोल लेकर पिया;","poem":1},{"lineBreak":true},{"text":"अपनी लकड़ी भी हम ने दाम देकर ली।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हम को रगेदने वाले हमारे सिर पर हैं;","poem":1},{"lineBreak":true},{"text":"हम थके हारे और बेआराम हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"हम ने मिस्रियों और असूरियों की इता'अत क़ुबूल की ताकि रोटी से सेर और आसूदा हों।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हमारे बाप दादा गुनाह करके चल बसे,","poem":1},{"lineBreak":true},{"text":"और हम उनकी बदकिरदारी की सज़ा पा रहे हैं।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"गु़लाम हम पर हुक्मरानी करते हैं;","poem":1},{"lineBreak":true},{"text":"उनके हाथ से छुड़ाने वाला कोई नहीं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"सहरा नशीनों की तलवार के ज़रिए', हम जान पर खेलकर रोटी हासिल करते हैं।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"क़हत की झुलसाने वाली आग के ज़रिए',","poem":1},{"lineBreak":true},{"text":"हमारा चमड़ा तनूर की तरह सियाह हो गया है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"उन्होंने सिय्यून में 'औरतों को बेहुरमत किया और यहूदाह के शहरों में कुँवारी लड़कियों को।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हाकिम को उनके हाथों से लटका दिया;","poem":1},{"lineBreak":true},{"text":"बुज़ुगों की रू — दारी न की गई।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"जवानों ने चक्की पीसी,","poem":1},{"lineBreak":true},{"text":"और बच्चों ने गिरते पड़ते लकड़ियाँ ढोईं।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"बुज़ुर्ग फाटकों पर दिखाई नहीं देते, जवानों की नग़मा परदाज़ी सुनाई नहीं देती।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"हमारे दिलों से खुशी जाती रही;","poem":1},{"lineBreak":true},{"text":"हमारा रक़्स मातम से बदल गया।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ताज हमारे सिर पर से गिर पड़ा;","poem":1},{"lineBreak":true},{"text":"हम पर अफ़सोस! कि हम ने गुनाह किया।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"इसीलिए हमारे दिल बेताब हैं;","poem":1},{"lineBreak":true},{"text":"इन्हीं बातों के ज़रिए' हमारी आँखें धुंदला गई,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"कोह — ए — सिय्यून की वीरानी के ज़रिए',","poem":1},{"lineBreak":true},{"text":"उस पर गीदड़ फिरते हैं।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"लेकिन तू, ऐ ख़ुदावन्द, हमेशा तक क़ायम है;","poem":1},{"lineBreak":true},{"text":"और तेरा तख़्त नसल — दर — नसल।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"फिर तू क्यूँ हम को हमेशा के लिए भूल जाता है,","poem":1},{"lineBreak":true},{"text":"और हम को लम्बे वक़्त तक तर्क करता है?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, हम को अपनी तरफ़ फिरा, तो हम फिरेंगे;","poem":1},{"lineBreak":true},{"text":"हमारे दिन बदल दे, जैसे पहले से थे।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"क्या तू ने हमको बिल्कुल रद्द कर दिया है?","poem":1},{"lineBreak":true},{"text":"क्या तू हमसे शख़्त नाराज़ है?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}