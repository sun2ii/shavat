{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PRO","translationId":"urd_irv","name":"अम्साल","commonName":"अम्साल","title":"अम्साल","order":20,"numberOfChapters":31,"sha256":"e8e79119a4c10e1bdbf548894085d3024ae3e28d3b1ec1a4b12be8f000268fe4","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/urd_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["अक्लमंदी के फायदे"]},{"type":"verse","number":1,"content":[{"text":"ऐ मेरे बेटे, अगर तू मेरी बातों को क़ुबूल करे,","poem":1},{"lineBreak":true},{"text":"और मेरे फ़रमान को निगाह में रख्खे,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐसा कि तू हिकमत की तरफ़ कान लगाए,","poem":1},{"lineBreak":true},{"text":"और समझ से दिल लगाए,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"बल्कि अगर तू 'अक़्ल को पुकारे,","poem":1},{"lineBreak":true},{"text":"और समझ के लिए आवाज़ बलन्द करे","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"और उसको ऐसा ढूँढे जैसे चाँदी को,","poem":1},{"lineBreak":true},{"text":"और उसकी ऐसी तलाश करे जैसी पोशीदा ख़ज़ानों की;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तो तू ख़ुदावन्द के ख़ौफ़ को समझेगा,","poem":1},{"lineBreak":true},{"text":"और ख़ुदा के ज़रिए' को हासिल करेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द हिकमत बख़्शता है;","poem":1},{"lineBreak":true},{"text":"'इल्म — ओ — समझ उसी के मुँह से निकलते हैं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह रास्तबाज़ों के लिए मदद तैयार रखता है,","poem":1},{"lineBreak":true},{"text":"और रास्तरौ के लिए सिपर है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ताकि वह 'अद्ल की राहों की निगहबानी करे,","poem":1},{"lineBreak":true},{"text":"और अपने मुक़द्दसों की राह को महफ़ूज़ रख्खे।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तब तू सदाक़त और 'अद्ल और रास्ती को,","poem":1},{"lineBreak":true},{"text":"बल्कि हर एक अच्छी राह को समझेगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"क्यूँकि हिकमत तेरे दिल में दाख़िल होगी,","poem":1},{"lineBreak":true},{"text":"और 'इल्म तेरी जान को पसंद होगा,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तमीज़ तेरी निगहबान होगी,","poem":1},{"lineBreak":true},{"text":"समझ तेरी हिफ़ाज़त करेगा;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ताकि तुझे शरीर की राह से,","poem":1},{"lineBreak":true},{"text":"और कजगो से बचाएँ।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"जो रास्तबाज़ी की राह को छोड़ते हैं,","poem":1},{"lineBreak":true},{"text":"ताकि तारीकी की राहों में चलें,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"जो बदकारी से ख़ुश होते हैं,","poem":1},{"lineBreak":true},{"text":"और शरारत की कजरवी में खु़श रहते हैं,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"जिनका चाल चलन ना हमवार,","poem":1},{"lineBreak":true},{"text":"और जिनकी राहें टेढ़ी हैं।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ताकि तुझे बेगाना 'औरत से बचाएँ,","poem":1},{"lineBreak":true},{"text":"या'नी चिकनी चुपड़ी बातें करने वाली पराई 'औरत से,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"जो अपनी जवानी के साथी को छोड़ देती है,","poem":1},{"lineBreak":true},{"text":"और अपने ख़ुदा के 'अहद को भूल जाती है।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"क्यूँकि उसका घर मौत की उतराई पर है,","poem":1},{"lineBreak":true},{"text":"और उसकी राहें पाताल को जाती हैं।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"जो कोई उसके पास जाता है, वापस नहीं आता;","poem":1},{"lineBreak":true},{"text":"और ज़िन्दगी की राहों तक नहीं पहुँचता।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ताकि तू नेकों की राह पर चले,","poem":1},{"lineBreak":true},{"text":"और सादिक़ों की राहों पर क़ाईम रहे।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"क्यूँकि रास्तबाज़ मुल्क में बसेंगे,","poem":1},{"lineBreak":true},{"text":"और कामिल उसमें आबाद रहेंगे।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"लेकिन शरीर ज़मीन पर से काट डाले जाएँगे,","poem":1},{"lineBreak":true},{"text":"और दग़ाबाज़ उससे उखाड़ फेंके जाएँगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}