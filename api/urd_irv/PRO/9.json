{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PRO","translationId":"urd_irv","name":"अम्साल","commonName":"अम्साल","title":"अम्साल","order":20,"numberOfChapters":31,"sha256":"e8e79119a4c10e1bdbf548894085d3024ae3e28d3b1ec1a4b12be8f000268fe4","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/urd_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"हिकमत ने अपना घर बना लिया,","poem":1},{"lineBreak":true},{"text":"उसने अपने सातों सुतून तराश लिए हैं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"उसने अपने जानवरों को ज़बह कर लिया,","poem":1},{"lineBreak":true},{"text":"और अपनी मय मिला कर तैयार कर ली;","poem":1},{"lineBreak":true},{"text":"उसने अपना दस्तरख़्वान भी चुन लिया।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसने अपनी सहेलियों को रवाना किया है;","poem":1},{"lineBreak":true},{"text":"वह ख़ुद शहर की ऊँची जगहों पर पुकारती है,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“जो सादा दिल है,","poem":1},{"lineBreak":true},{"text":"इधर आ जाए!” और बे'अक़्ल से वह यह कहती है,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“आओ, मेरी रोटी में से खाओ,","poem":1},{"lineBreak":true},{"text":"और मेरी मिलाई हुई मय में से पियो।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ऐ सादा दिलो, बाज़ आओ और ज़िन्दा रहो,","poem":1},{"lineBreak":true},{"text":"और समझ की राह पर चलो।”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ठठ्ठा बाज़ को तम्बीह करने वाला ला'नतान उठाएगा,","poem":1},{"lineBreak":true},{"text":"और शरीर को मलामत करने वाले पर धब्बा लगेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ठठ्ठाबाज़ को मलामत न कर, ऐसा न हो कि वह तुझ से 'अदावत रखने लगे;","poem":1},{"lineBreak":true},{"text":"'अक़्लमंद को मलामत कर, और वह तुझ से मुहब्बत रख्खेगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"'अक़्लमंद की तरबियत कर, और वह और भी 'अक़्लमंद बन जाएगा;","poem":1},{"lineBreak":true},{"text":"सादिक़ को सिखा और वह 'इल्म में तरक़्क़ी करेगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द का ख़ौफ़ हिकमत का शुरू' है,","poem":1},{"lineBreak":true},{"text":"और उस क़ुद्दुस की पहचान समझ है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"क्यूँकि मेरी बदौलत तेरे दिन बढ़ जाएँगे,","poem":1},{"lineBreak":true},{"text":"और तेरी ज़िन्दगी के साल ज़्यादा होंगे।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"अगर तू 'अक़्लमंद है तो अपने लिए,","poem":1},{"lineBreak":true},{"text":"और अगर तू ठठ्ठाबाज़ है तो ख़ुद ही भुगतेगा।","poem":1}]},{"type":"heading","content":["नादान औरत का पुकारना"]},{"type":"verse","number":13,"content":[{"text":"बेवक़ूफ़ 'औरत गौग़ाई है;","poem":1},{"lineBreak":true},{"text":"वह नादान है और कुछ नहीं जानती।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"वह अपने घर के दरवाज़े पर,","poem":1},{"lineBreak":true},{"text":"शहर की ऊँची जगहों में बैठ जाती है;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ताकिआने जाने वालों को बुलाए,","poem":1},{"lineBreak":true},{"text":"जो अपने अपने रास्ते पर सीधे जा रहें हैं,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“सादा दिल इधर आ जाएँ,”","poem":1},{"lineBreak":true},{"text":"और बे'अक़्ल से वह यह कहती है,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“चोरी का पानी मीठा है,","poem":1},{"lineBreak":true},{"text":"और पोशीदगी की रोटी लज़ीज़।”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"लेकिन वह नहीं जानता कि वहाँ मुर्दे पड़े हैं,","poem":1},{"lineBreak":true},{"text":"और उस 'औरत के मेहमान पाताल की तह में हैं।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}