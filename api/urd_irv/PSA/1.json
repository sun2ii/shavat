{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"मुबारक है वह आदमी जो शरीरों की सलाह पर नहीं चलता,","poem":1},{"lineBreak":true},{"text":"और ख़ताकारों की राह में खड़ा नहीं होता;","poem":1},{"lineBreak":true},{"text":"और ठट्ठा बाज़ों की महफ़िल में नहीं बैठता।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"बल्कि ख़ुदावन्द की शरी'अत में ही उसकी ख़ुशी है;","poem":1},{"lineBreak":true},{"text":"और उसी की शरी'अत पर दिन रात उसका ध्यान रहता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह उस दरख़्त की तरह होगा, जो पानी की नदियों के पास लगाया गया है।","poem":1},{"lineBreak":true},{"text":"जो अपने वक़्त पर फलता है, और जिसका पत्ता भी नहीं मुरझाता।","poem":1},{"lineBreak":true},{"text":"इसलिए जो कुछ वह करे फलदार होगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"शरीर ऐसे नहीं, बल्कि वह भूसे की तरह हैं,","poem":1},{"lineBreak":true},{"text":"जिसे हवा उड़ा ले जाती है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"इसलिए शरीर 'अदालत में क़ाईम न रहेंगे,","poem":1},{"lineBreak":true},{"text":"न ख़ताकार सादिक़ों की जमा'अत में।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द सादिक़ो की राह जानता है","poem":1},{"lineBreak":true},{"text":"लेकिन शरीरों की राह बर्बाद हो जाएगी।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}