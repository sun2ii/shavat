{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ अहले ज़मीन, सब ख़ुदावन्द के सामने ख़ुशी का ना'रा मारो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुशी से ख़ुदावन्द की इबादत करो!","poem":1},{"lineBreak":true},{"text":"गाते हुए उसके सामने हाज़िर हों!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जान रखों ख़ुदावन्द ही ख़ुदा है!","poem":1},{"lineBreak":true},{"text":"उसी ने हम को बनाया और हम उसी के है;","poem":1},{"lineBreak":true},{"text":"हम उसके लोग और उसकी चरागाह की भेड़े हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"शुक्रगुज़ारी करते हुए उसके फाटकों में","poem":1},{"lineBreak":true},{"text":"और हम्द करते हुए उसकी बारगाहों में दाख़िल हो;","poem":1},{"lineBreak":true},{"text":"उसका शुक्र करो और उसके नाम को मुबारक कहो!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द भला है, उसकी शफ़क़त हमेशा की है,","poem":1},{"lineBreak":true},{"text":"और उसकी वफ़ादारी नसल दर नसल रहती है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}