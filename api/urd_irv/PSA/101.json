{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"मैं शफ़क़त और 'अदल का हम्द गाऊँगा;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मैं तेरी मदह सराई करूँगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं 'अक़्लमंदी से कामिल राह पर चलूँगा,","poem":1},{"lineBreak":true},{"text":"तू मेरे पास कब आएगा?","poem":1},{"lineBreak":true},{"text":"घर में मेरा चाल चलन सच्चे दिल से होगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मैं किसी ख़बासत को मद्द — ए — नज़र नहीं रखूँगा;","poem":1},{"lineBreak":true},{"text":"मुझे कज रफ़तारों के काम से नफ़रत है;","poem":1},{"lineBreak":true},{"text":"उसको मुझ से कुछ मतलब न होगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कजदिली मुझ से दूर हो जाएगी;","poem":1},{"lineBreak":true},{"text":"मैं किसी बुराई से आशना न हूँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जो दर पर्दा अपने पड़ोसी की बुराई करे,","poem":1},{"lineBreak":true},{"text":"मैं उसे हलाक कर डालूँगा;","poem":1},{"lineBreak":true},{"text":"मैं बुलन्द नज़र और मग़रूर दिल की बर्दाश्त न करूँगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मुल्क के ईमानदारों पर मेरी निगाह होगी ताकि वह मेरे साथ रहें;","poem":1},{"lineBreak":true},{"text":"जो कामिल राह पर चलता है वही मेरी ख़िदमत करेगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"दग़ाबाज़ मेरे घर में रहने न पाएगा;","poem":1},{"lineBreak":true},{"text":"दरोग़ गो को मेरे सामने क़याम न होगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैं हर सुबह मुल्क के सब शरीरों को हलाक किया करूँगा,","poem":1},{"lineBreak":true},{"text":"ताकि ख़ुदावन्द के शहर से बदकारों को काट डालूँ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}