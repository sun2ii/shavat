{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा, मेरा दिल क़ाईम है;","poem":1},{"lineBreak":true},{"text":"मैं गाऊँगा और दिल से मदहसराई करूँगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ बरबत और सितार जागो!","poem":1},{"lineBreak":true},{"text":"मैं ख़ुद भी सुबह सवेरे जाग उठूँगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मैं लोगों में तेरा शुक्र करूँगा,","poem":1},{"lineBreak":true},{"text":"मैं उम्मतों में तेरी मदहसराई करूँगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि तेरी शफ़क़त आसमान से बुलन्द है,","poem":1},{"lineBreak":true},{"text":"और तेरी सच्चाई आसमानों के बराबर है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, तू आसमानों पर सरफ़राज़ हो!","poem":1},{"lineBreak":true},{"text":"और तेरा जलाल सारी ज़मीन पर हो","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"अपने दहने हाथ से बचा और हमें जवाब दे,","poem":1},{"lineBreak":true},{"text":"ताकि तेरे महबूब बचाए जाएँ।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदा ने अपनी पाकिज़गी में यह फ़रमाया है “मैं खु़शी करूँगा,","poem":1},{"lineBreak":true},{"text":"मैं सिकम को तक़्सीम करूँगा और सुकात की वादी को बाटुँगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जिल'आद मेरा है, मनस्सी मेरा है;","poem":1},{"lineBreak":true},{"text":"इफ़्राईम मेरे सिर का खू़द है; यहूदाह मेरा 'असा है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मोआब मेरी चिलपची है, अदोम पर मैं जूता फेकूँगा,","poem":1},{"lineBreak":true},{"text":"मैं फ़िलिस्तीन पर ललकारूँगा।”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मुझे उस फ़सीलदार शहर में कौन पहुँचाएगा?","poem":1},{"lineBreak":true},{"text":"कौन मुझे अदोम तक ले गया है?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, क्या तूने हमें रद्द नहीं कर दिया?","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदा, तू हमारे लश्करों के साथ नहीं जाता।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मुख़ालिफ़ के मुक़ाबिले में हमारी मदद कर,","poem":1},{"lineBreak":true},{"text":"क्यूँकि इंसानी मदद 'बेकार है।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ख़ुदा की बदौलत हम दिलावरी करेगी;","poem":1},{"lineBreak":true},{"text":"क्यूँकि वही हमारे मुख़ालिफ़ों को पामाल करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}