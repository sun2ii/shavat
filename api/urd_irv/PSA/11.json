{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"मेरा भरोसा ख़ुदावन्द पर है तुम क्यूँकर मेरी जान से कहते हो कि चिड़िया की तरह अपने पहाड़ पर उड़ जा?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्यूँकि देखो! शरीर कमान खींचते हैं वह तीर को चिल्ले पर रखते हैं ताकि अँधेरे में रास्त दिलों पर चलायें।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अगर बुनयाद ही उखाड़ दी जाये तो सादिक़ क्या कर सकता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द अपनी पाक हैकल में है ख़ुदावन्द का तख़्त आसमान पर है। उसकी आँखें बनी आदम को देखती और उसकी पलकें उनको जाँचती हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सादिक़ को परखता है लेकिन शरीर और ज़ुल्म को पसन्द करने वाले से उसकी रूह को नफ़रत है","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह शरीरों पर फंदे बरसायेगा आग और गंधक और लू उनके प्याले का हिस्सा होगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द सादिक़ है वह सच्चाई को पसंद करता है रास्त बाज़ उसका दीदार हासिल करेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}