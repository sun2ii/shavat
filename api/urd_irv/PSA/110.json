{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा ने मेरे ख़ुदावन्द से कहा,","poem":1},{"lineBreak":true},{"text":"“जब तक कि मैं तेरे दुश्मनों को तेरे पाँव की चौकी न कर दूँ।”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तेरे ज़ोर का 'असा सिय्यून से भेजेगा।","poem":1},{"lineBreak":true},{"text":"तू अपने दुश्मनों में हुक्मरानी कर।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"लश्करकशी के दिन तेरे लोग ख़ुशी से अपने आप को पेश करते हैं;","poem":1},{"lineBreak":true},{"text":"तेरे जवान पाक आराइश में हैं,","poem":1},{"lineBreak":true},{"text":"और सुबह के बत्न से शबनम की तरह।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द ने क़सम खाई है और फिरेगा नहीं,","poem":1},{"lineBreak":true},{"text":"“तू मलिक — ए — सिद्क के तौर पर हमेशा तक काहिन है।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तेरे दहने हाथ पर","poem":1},{"lineBreak":true},{"text":"अपने कहर के दिन बादशाहों को छेद डालेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह क़ौमों में 'अदालत करेगा,","poem":1},{"lineBreak":true},{"text":"वह लाशों के ढेर लगा देगा; और बहुत से मुल्कों में सिरों को कुचलेगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह राह में नदी का पानी पिएगा;","poem":1},{"lineBreak":true},{"text":"इसलिए वह सिर को बुलन्द करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}