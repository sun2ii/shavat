{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द की हम्द करो! मैं रास्तबाज़ों की मजलिस में और जमा'अत में,","poem":1},{"lineBreak":true},{"text":"अपने सारे दिल से ख़ुदावन्द का शुक्र करूँगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के काम 'अज़ीम हैं,","poem":1},{"lineBreak":true},{"text":"जो उनमें मसरूर हैं उनकी तलाश। में रहते हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसके काम जलाली और पुर हश्मत हैं,","poem":1},{"lineBreak":true},{"text":"और उसकी सदाकत हमेशा तक क़ाईम है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उसने अपने 'अजायब की यादगार क़ाईम की है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द रहीम — ओ — करीम है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह उनको जो उससे डरते हैं खू़राक देता है;","poem":1},{"lineBreak":true},{"text":"वह अपने 'अहद को हमेशा याद रख्खेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उसने कौमों की मीरास अपने लोगों को देकर,","poem":1},{"lineBreak":true},{"text":"अपने कामों का ज़ोर उनकी दिखाया।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"उसके हाथों के काम बरहक़ और इन्साफ भरे हैं;","poem":1},{"lineBreak":true},{"text":"उसके तमाम क़वानीन रास्त है,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह हमेशा से हमेशा तक क़ाईम रहेंगे,","poem":1},{"lineBreak":true},{"text":"वह सच्चाई और रास्ती से बनाए गए हैं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"उसने अपने लोगों के लिए फ़िदिया दिया;","poem":1},{"lineBreak":true},{"text":"उसने अपना 'अहद हमेशा के लिए ठहराया है।","poem":1},{"lineBreak":true},{"text":"उसका नाम पाक और बड़ा है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द का ख़ौफ़ समझ का शुरू' है;","poem":1},{"lineBreak":true},{"text":"उसके मुताबिक 'अमल करने वाले अक़्लमंद हैं।","poem":1},{"lineBreak":true},{"text":"उसकी सिताइश हमेशा तक क़ाईम है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}