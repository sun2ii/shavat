{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द की हम्द करो!","poem":1},{"lineBreak":true},{"text":"मुबारक है वह आदमी जो ख़ुदावन्द से डरता है,","poem":1},{"lineBreak":true},{"text":"और उसके हुक्मों में खू़ब मसरूर रहता है!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"उसकी नसल ज़मीन पर ताक़तवर होगी;","poem":1},{"lineBreak":true},{"text":"रास्तबाज़ों की औलाद मुबारक होगी।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"माल — ओ — दौलत उसके घर में है;","poem":1},{"lineBreak":true},{"text":"और उसकी सदाकत हमेशा तक क़ाईम है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"रास्तबाज़ों के लिए तारीकी में नूर चमकता है;","poem":1},{"lineBreak":true},{"text":"वह रहीम — ओ — करीम और सादिक है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"रहम दिल और क़र्ज़ देने वाला आदमी फ़रमाँबरदार है;","poem":1},{"lineBreak":true},{"text":"वह अपना कारोबार रास्ती से करेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उसे कभी जुम्बिश न होगी:","poem":1},{"lineBreak":true},{"text":"सादिक की यादगार हमेशा रहेगी।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह बुरी ख़बर से न डरेगा;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द पर भरोसा करने से उसका दिल क़ाईम है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"उसका दिल बरकरार है, वह डरने का नहीं,","poem":1},{"lineBreak":true},{"text":"यहाँ तक कि वह अपने मुख़ालिफ़ों को देख लेगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"उसने बाँटा और मोहताजों को दिया,","poem":1},{"lineBreak":true},{"text":"उसकी सदाक़त हमेशा क़ाईम रहेगी;","poem":1},{"lineBreak":true},{"text":"उसका सींग इज़्ज़त के साथ बलन्द किया जाएगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"शरीर यह देखेगा और कुढ़ेगा;","poem":1},{"lineBreak":true},{"text":"वह दाँत पीसेगा और घुलेगा;","poem":1},{"lineBreak":true},{"text":"शरीरों की मुराद बर्बाद होगी।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}