{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"जब इस्राईल मिस्र से निकलआया,","poem":1},{"lineBreak":true},{"text":"या'नी या'क़ूब का घराना अजनबी ज़बान वाली क़ौम में से;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तो यहूदाह उसका हैकल,","poem":1},{"lineBreak":true},{"text":"और इस्राईल उसकी ममलुकत ठहरा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"यह देखते ही समन्दर भागा;","poem":1},{"lineBreak":true},{"text":"यरदन पीछे हट गया।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"पहाड़ मेंढों की तरह उछले,","poem":1},{"lineBreak":true},{"text":"पहाड़ियाँ भेड़ के बच्चों की तरह कूदे।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ समन्दर, तुझे क्या हुआ के तू भागता है?","poem":1},{"lineBreak":true},{"text":"ऐ यरदन, तुझे क्या हुआ कि तू पीछे हटता है?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ऐ पहाड़ो, तुम को क्या हुआ के तुम मेंढों की तरह उछलते हो?","poem":1},{"lineBreak":true},{"text":"ऐ पहाड़ियो, तुम को क्या हुआ के तुम भेड़ के बच्चों की तरह कूदती हो?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ ज़मीन, तू रब्ब के सामने,","poem":1},{"lineBreak":true},{"text":"या'क़ूब के ख़ुदा के सामने थरथरा;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जो चट्टान को झील,","poem":1},{"lineBreak":true},{"text":"और चक़माक़ की पानी का चश्मा बना देता है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}