{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"हमको नहीं, ऐ ख़ुदावन्द बल्कि तू अपने ही नाम को अपनी शफ़क़त","poem":1},{"lineBreak":true},{"text":"और सच्चाई की ख़ातिर जलाल बख़्श।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क़ौमें क्यूँ कहें, “अब उनका ख़ुदा कहाँ है?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हमारा ख़ुदा तो आसमान पर है;","poem":1},{"lineBreak":true},{"text":"उसने जो कुछ चाहा वही किया।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उनके बुत चाँदी और सोना हैं,","poem":1},{"lineBreak":true},{"text":"या'नी आदमी की दस्तकारी।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"उनके मुँह हैं लेकिन वह बोलते नहीं;","poem":1},{"lineBreak":true},{"text":"आँखें हैं लेकिन वह देखते नहीं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उनके कान हैं लेकिन वह सुनते नहीं;","poem":1},{"lineBreak":true},{"text":"नाक हैं लेकिन वह सूघते नहीं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पाँव हैं लेकीन वह चलते नहीं,","poem":1},{"lineBreak":true},{"text":"और उनके गले से आवाज़ नहीं निकलती।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"उनके बनाने वाले उन ही की तरह हो जाएँगे;","poem":1},{"lineBreak":true},{"text":"बल्कि वह सब जो उन पर भरोसा रखते हैं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ इस्राईल, ख़ुदावन्द पर भरोसा कर!","poem":1},{"lineBreak":true},{"text":"वही उनकी मदद और उनकी ढाल है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ऐ हारून के घराने, ख़ुदावन्द पर भरोसा करो।","poem":1},{"lineBreak":true},{"text":"वही उनकी मदद और उनकी ढाल है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द से डरने वालो, ख़ुदावन्द पर भरोसा करो!","poem":1},{"lineBreak":true},{"text":"वही उनकी मदद और उनकी ढाल है।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द ने हम को याद रखा,","poem":1},{"lineBreak":true},{"text":"वह बरकत देगाः वह इस्राईल के घराने को बरकत देगा;","poem":1},{"lineBreak":true},{"text":"वह हारून के घराने को बरकत देगा।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"जो ख़ुदावन्द से डरते हैं, क्या छोटे क्या बड़े,","poem":1},{"lineBreak":true},{"text":"वह उन सबको बरकत देगा।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तुम को बढ़ाए, तुम को और तुम्हारी औलाद को!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तुम ख़ुदावन्द की तरफ़ से मुबारक हो,","poem":1},{"lineBreak":true},{"text":"जिसने आसमान और ज़मीन को बनाया।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"आसमान तो ख़ुदावन्द का आसमान है,","poem":1},{"lineBreak":true},{"text":"लेकिन ज़मीन उसने बनी आदम को दी है।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मुर्दे ख़ुदावन्द की सिताइश नहीं करते,","poem":1},{"lineBreak":true},{"text":"न वह जो ख़ामोशी के 'आलम में उतर जाते हैं:","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"लेकिन हम अब से हमेशा तक,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द को मुबारक कहेंगे।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द करो।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}