{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"मैं ख़ुदावन्द से मुहब्बत रखता हूँ क्यूँकि उसने मेरी फ़रियाद और मिन्नत सुनी है","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"चुँकि उसने मेरी तरफ़ कान लगाया,","poem":1},{"lineBreak":true},{"text":"इसलिए मैं उम्र भर उससे दू'आ करूँगा","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मौत की रस्सियों ने मुझे जकड़ लिया,","poem":1},{"lineBreak":true},{"text":"और पाताल के दर्द मुझ पर आ पड़े;","poem":1},{"lineBreak":true},{"text":"मैं दुख और ग़म में गिरफ़्तार हुआ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तब मैंने ख़ुदावन्द से दुआ की,","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मैं तेरी मिन्नत करता हूँ मेरी जान की रिहाई बख्श!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सादिक़ और करीम है;","poem":1},{"lineBreak":true},{"text":"हमारा ख़ुदा रहीम है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सादा लोगों की हिफ़ाज़त करता है;","poem":1},{"lineBreak":true},{"text":"मैं पस्त हो गया था, उसी ने मुझे बचा लिया।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ मेरी जान, फिर मुत्मइन हो;","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द ने तुझ पर एहसान किया है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"इसलिए के तूने मेरी जान को मौत से,","poem":1},{"lineBreak":true},{"text":"मेरी आँखों को आँसू बहाने से,","poem":1},{"lineBreak":true},{"text":"और मेरे पाँव को फिसलने से बचाया है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मैं ज़िन्दों की ज़मीन में,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द के सामने चलता रहूँगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मैं ईमान रखता हूँ इसलिए यह कहूँगा,","poem":1},{"lineBreak":true},{"text":"मैं बड़ी मुसीबत में था।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मैंने जल्दबाज़ी से कह दिया,","poem":1},{"lineBreak":true},{"text":"कि “सब आदमी झूटे हैं।”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की सब ने'मतें जो मुझे मिलीं,","poem":1},{"lineBreak":true},{"text":"मैं उनके बदले में उसे क्या दूँ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"मैं नजात का प्याला उठाकर,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द से दुआ करूँगा।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द के सामने अपनी मन्नतें,","poem":1},{"lineBreak":true},{"text":"उसकी सारी क़ौम के सामने पूरी करूँगा।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की निगाह में,","poem":1},{"lineBreak":true},{"text":"उसके पाक लोगों की मौत गिरा क़द्र है।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"आह! ऐ ख़ुदावन्द, मैं तेरा बन्दा हूँ।","poem":1},{"lineBreak":true},{"text":"मैं तेरा बन्दा, तेरी लौंडी का बेटा हूँ।","poem":1},{"lineBreak":true},{"text":"तूने मेरे बन्धन खोले हैं।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मैं तेरे सामने शुक्रगुज़ारी की कु़र्बानी पेश करूँगा","poem":1},{"lineBreak":true},{"text":"और ख़ुदावन्द से दुआ करूँगा।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द के सामने अपनी मन्नतें,","poem":1},{"lineBreak":true},{"text":"उसकी सारी क़ौम के सामने पूरी करूँगा।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के घर की बारगाहों में,","poem":1},{"lineBreak":true},{"text":"तेरे अन्दर ऐ येरूशलेम!","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द करो।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}