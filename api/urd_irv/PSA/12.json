{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द! बचा ले क्यूँकि कोई दीनदार नहीं रहा","poem":1},{"lineBreak":true},{"text":"और अमानत दार लोग बनी आदम में से मिट गये।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वह अपने अपने पड़ोसी से झूठ बोलते हैं","poem":1},{"lineBreak":true},{"text":"वह ख़ुशामदी लबों से दो रंगी बातें करते हैं","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सब ख़ुशामदी लबों को","poem":1},{"lineBreak":true},{"text":"और बड़े बोल बोलने वाली ज़बान को काट डालेगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह कहते हैं, “हम अपनी ज़बान से जीतेंगे,","poem":1},{"lineBreak":true},{"text":"हमारे होंट हमारे ही हैं; हमारा मालिक कौन है?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ग़रीबों की तबाही और ग़रीबों कीआह की वजह से,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द फ़रमाता है, कि अब मैं उठूँगा","poem":1},{"lineBreak":true},{"text":"और जिस पर वह फुंकारते हैं उसे अम्न — ओ — अमान में रख्खूँगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द का कलाम पाक है,","poem":1},{"lineBreak":true},{"text":"उस चाँदी की तरह जो भट्टी में मिट्टी पर ताई गई,","poem":1},{"lineBreak":true},{"text":"और सात बार साफ़ की गई हो।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तू ही ऐ ख़ुदावन्द उनकी हिफ़ाज़त करेगा,","poem":1},{"lineBreak":true},{"text":"तू ही उनको इस नसल से हमेशा तक बचाए रखेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जब बनी आदम में पाजीपन की क़द्र होती है,","poem":1},{"lineBreak":true},{"text":"तो शरीर हर तरफ़ चलते फिरते हैं।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}