{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"मैं अपनी आँखें पहाड़ों की तरफ उठाऊगा;","poem":1},{"lineBreak":true},{"text":"मेरी मदद कहाँ से आएगी?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मेरी मदद ख़ुदावन्द से है,","poem":1},{"lineBreak":true},{"text":"जिसने आसमान और ज़मीन को बनाया।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह तेरे पाँव को फिसलने न देगा;","poem":1},{"lineBreak":true},{"text":"तेरा मुहाफ़िज़ ऊँघने का नहीं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"देख! इस्राईल का मुहाफ़िज़,","poem":1},{"lineBreak":true},{"text":"न ऊँघेगा, न सोएगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तेरा मुहाफ़िज़ है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द तेरे दहने हाथ पर तेरा सायबान है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"न आफ़ताब दिन को तुझे नुक़सान पहुँचाएगा,","poem":1},{"lineBreak":true},{"text":"न माहताब रात को।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द हर बला से तुझे महफूज़ रख्खेगा,","poem":1},{"lineBreak":true},{"text":"वह तेरी जान को महफूज़ रख्खेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तेरी आमद — ओ — रफ़्त में,","poem":1},{"lineBreak":true},{"text":"अब से हमेशा तक तेरी हिफ़ाज़त करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}