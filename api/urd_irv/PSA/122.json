{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"मैं ख़ुश हुआ जब वह मुझ से कहने लगे","poem":1},{"lineBreak":true},{"text":"“आओ ख़ुदावन्द के घर चलें।”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ येरूशलेम! हमारे क़दम,","poem":1},{"lineBreak":true},{"text":"तेरे फाटकों के अन्दर हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ येरूशलेम तू ऐसे शहर के तरह है जो गुनजान बना हो।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जहाँ क़बीले या'नी ख़ुदावन्द के क़बीले,","poem":1},{"lineBreak":true},{"text":"इस्राईल की शहादत के लिए, ख़ुदावन्द के नाम का शुक्र करने को जातें हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि वहाँ 'अदालत के तख़्त,","poem":1},{"lineBreak":true},{"text":"या'नी दाऊद के ख़ान्दान के तख़्त क़ाईम हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"येरूशलेम की सलामती की दुआ करो,","poem":1},{"lineBreak":true},{"text":"वह जो तुझ से मुहब्बत रखते हैं इकबालमंद होंगे।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तेरी फ़सील के अन्दर सलामती,","poem":1},{"lineBreak":true},{"text":"और तेरे महलों में इकबालमंदी हो।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैं अपने भाइयों और दोस्तों की ख़ातिर,","poem":1},{"lineBreak":true},{"text":"अब कहूँगा तुझ में सलामती रहे!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द अपने ख़ुदा के घर की ख़ातिर,","poem":1},{"lineBreak":true},{"text":"मैं तेरी भलाई का तालिब रहूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}