ले जाएगा। इस्राईल की सलामती हो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}