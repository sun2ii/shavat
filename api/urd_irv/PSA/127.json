{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"अगर ख़ुदावन्द ही घर न बनाए,","poem":1},{"lineBreak":true},{"text":"तो बनाने वालों की मेहनत' बेकार है।","poem":1},{"lineBreak":true},{"text":"अगर ख़ुदावन्द ही शहर की हिफ़ाज़त न करे,","poem":1},{"lineBreak":true},{"text":"तो निगहबान का जागना 'बेकार है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तुम्हारे लिए सवेरे उठना और देर में आराम करना,","poem":1},{"lineBreak":true},{"text":"और मशक़्क़त की रोटी खाना 'बेकार है;","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह अपने महबूब को तो नींद ही में दे देता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"देखो, औलाद ख़ुदावन्द की तरफ़ से मीरास है,","poem":1},{"lineBreak":true},{"text":"और पेट का फल उसी की तरफ़ से अज्र है,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जवानी के फ़र्ज़न्द ऐसे हैं,","poem":1},{"lineBreak":true},{"text":"जैसे ज़बरदस्त के हाथ में तीर।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुश नसीब है वह आदमी जिसका तरकश उनसे भरा है।","poem":1},{"lineBreak":true},{"text":"जब वह अपने दुश्मनों से फाटक पर बातें करेंगे तो शर्मिन्दा न होंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}