{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"मुबारक है हर एक जो ख़ुदावन्द से डरता,","poem":1},{"lineBreak":true},{"text":"और उसकी राहों पर चलता है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तू अपने हाथों की कमाई खाएगा;","poem":1},{"lineBreak":true},{"text":"तू मुबारक और फ़र्माबरदार होगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तेरी बीवी तेरे घर के अन्दर मेवादार ताक की तरह होगी,","poem":1},{"lineBreak":true},{"text":"और तेरी औलाद तेरे दस्तरख़्वान पर ज़ैतून के पौदों की तरह।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"देखो! ऐसी बरकत उसी आदमी को मिलेगी,","poem":1},{"lineBreak":true},{"text":"जो ख़ुदावन्द से डरता है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सिय्यून में से तुझ को बरकत दे,","poem":1},{"lineBreak":true},{"text":"और तू उम्र भर येरूशलेम की भलाई देखे।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"बल्कि तू अपने बच्चों के बच्चे देखे।","poem":1},{"lineBreak":true},{"text":"इस्राईल की सलामती हो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}