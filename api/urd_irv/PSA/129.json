{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"इस्राईल अब यूँ कहे,","poem":1},{"lineBreak":true},{"text":"“उन्होंने मेरी जवानी से अब तक मुझे बार बार सताया,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हाँ, उन्होंने मेरी जवानी से अब तक मुझे बार बार सताया,","poem":1},{"lineBreak":true},{"text":"तोभी वह मुझ पर ग़ालिब न आए।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हलवाहों ने मेरी पीठ पर हल चलाया,","poem":1},{"lineBreak":true},{"text":"और लम्बी लम्बी रेघारियाँ बनाई।”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सादिक़ है;","poem":1},{"lineBreak":true},{"text":"उसने शरीरों की रसियाँ काट डालीं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"सिय्यून से नफ़रत रखने वाले,","poem":1},{"lineBreak":true},{"text":"सब शर्मिन्दा और पस्पा हों।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह छत पर की घास की तरह हों,","poem":1},{"lineBreak":true},{"text":"जो बढ़ने से पहले ही सूख जाती है;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जिससे फ़सल काटने वाला अपनी मुट्ठी को,","poem":1},{"lineBreak":true},{"text":"और पूले बाँधने वाला अपने दामन को नहीं भरता,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"न आने जाने वाले यह कहते हैं,","poem":1},{"lineBreak":true},{"text":"“तुम पर ख़ुदावन्द की बरकत हो!","poem":1},{"lineBreak":true},{"text":"हम ख़ुदावन्द के नाम से तुम को दुआ देते हैं!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}