{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द, कब तक? क्या तू हमेशा मुझे भूला रहेगा?","poem":1},{"lineBreak":true},{"text":"तू कब तक अपना चेहरा मुझ से छिपाए रख्खेगा?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कब तक मैं जी ही जी में मन्सूबा बाँधता रहूँ,","poem":1},{"lineBreak":true},{"text":"और सारे दिन अपने दिल में ग़म किया करू?","poem":1},{"lineBreak":true},{"text":"कब तक मेरा दुश्मन मुझ पर सर बुलन्द रहेगा?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द मेरे ख़ुदा, मेरी तरफ़ तवज्जुह कर और मुझे जवाब दे।","poem":1},{"lineBreak":true},{"text":"मेरी आँखे रोशन कर, ऐसा न हो कि मुझे मौत की नींद आ जाए","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ऐसा न हो कि मेरा दुश्मन कहे,","poem":1},{"lineBreak":true},{"text":"कि मैं इस पर ग़ालिब आ गया। ऐसा न हो कि जब मैं जुम्बिश खाऊँ तो मेरे मुखालिफ़ ख़ुश हों।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"लेकिन मैंने तो तेरी रहमत पर भरोसा किया है;","poem":1},{"lineBreak":true},{"text":"मेरा दिल तेरी नजात से खु़श होगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द का हम्द गाऊँगा","poem":1},{"lineBreak":true},{"text":"क्यूँकि उसने मुझ पर एहसान किया है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}