{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द! मैंने गहराओ में से तेरे सामने फ़रियाद की है!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! मेरी आवाज़ सुन ले!","poem":1},{"lineBreak":true},{"text":"मेरी इल्तिजा की आवाज़ पर, तेरे कान लगे रहें।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! अगर तू बदकारी को हिसाब में लाए,","poem":1},{"lineBreak":true},{"text":"तो ऐ ख़ुदावन्द कौन क़ाईम रह सकेगा?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"लेकिन मग़फ़िरत तेरे हाथ में है,","poem":1},{"lineBreak":true},{"text":"ताकि लोग तुझ से डरें।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द का इन्तिज़ार करता हूँ।","poem":1},{"lineBreak":true},{"text":"मेरी जान मुन्तज़िर है, और मुझे उसके कलाम पर भरोसा है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"सुबह का इन्तिज़ार करने वालों से ज़्यादा,","poem":1},{"lineBreak":true},{"text":"हाँ, सुबह का इन्तिज़ार करने वालों से कहीं ज़्यादा,","poem":1},{"lineBreak":true},{"text":"मेरी जान ख़ुदावन्द की मुन्तज़िर है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ इस्राईल! ख़ुदावन्द पर भरोसा कर;","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द के हाथ में शफ़क़त है","poem":1},{"lineBreak":true},{"text":", उसी के हाथ में फ़िदिए की कसरत है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"और वही इस्राईल का फ़िदिया देकर,","poem":1},{"lineBreak":true},{"text":"उसको सारी बदकारी से छुड़ाएगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}