{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"verse","number":1,"content":[{"text":"देखो! कैसी अच्छी और खु़शी की बात है,","poem":1},{"lineBreak":true},{"text":"कि भाई एक साथ मिलकर रहें!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यह उस बेशक़ीमत तेल की तरह है,","poem":1},{"lineBreak":true},{"text":"जो सिर पर लगाया गया, और बहता हुआ दाढ़ी पर,","poem":1},{"lineBreak":true},{"text":"या'नी हारून की दाढ़ी पर आ गया;","poem":1},{"lineBreak":true},{"text":"बल्कि उसके लिबास के दामन तक जा पहुँचा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"या हरमून की ओस की तरह है,","poem":1},{"lineBreak":true},{"text":"जो सिय्यून के पहाड़ों पर पड़ती है!","poem":1},{"lineBreak":true},{"text":"क्यूँकि वहीं ख़ुदावन्द ने बरकत का,","poem":1},{"lineBreak":true},{"text":"या'नी हमेशा की ज़िन्दगी का हुक्म फ़रमाया।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/134.json","nextChapterAudioLi