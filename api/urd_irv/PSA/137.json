{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"हम बाबुल की नदियों पर बैठे,","poem":1},{"lineBreak":true},{"text":"और सिय्यून को याद करके रोए।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वहाँ बेद के दरख़्तों पर उनके वस्त में,","poem":1},{"lineBreak":true},{"text":"हम ने अपने सितारों को टाँग दिया।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि वहाँ हम को ग़ुलाम करने वालों ने हम्द गाने का हुक्म दिया,","poem":1},{"lineBreak":true},{"text":"और तबाह करने वालों ने खु़शी करने का,","poem":1},{"lineBreak":true},{"text":"और कहा, “सिय्यून के हम्दों में से हमको कोई हम्द सुनाओ!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हम परदेस में,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द का हम्द कैसे गाएँ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ येरूशलेम! अगर मैं तुझे भूलूँ,","poem":1},{"lineBreak":true},{"text":"तो मेरा दहना हाथ अपना हुनर भूल जाए।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"अगर मैं तुझे याद न रख्खूँ, अगर मैं येरूशलेम को,","poem":1},{"lineBreak":true},{"text":"अपनी बड़ी से बड़ी ख़ुशी पर तरजीह न दूँ मेरी ज़बान मेरे तालू से चिपक जाए!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! येरूशलेम के दिन को,","poem":1},{"lineBreak":true},{"text":"बनी अदोम के ख़िलाफ़ याद कर,","poem":1},{"lineBreak":true},{"text":"जो कहते थे, “इसे ढा दो, इसे बुनियाद तक ढा दो!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ बाबुल की बेटी! जो हलाक होने वाली है,","poem":1},{"lineBreak":true},{"text":"वह मुबारक होगा, जो तुझे उस सुलूक का,","poem":1},{"lineBreak":true},{"text":"जो तूने हम से किया बदला दे।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"वह मुबारक होगा, जो तेरे बच्चों को लेकर,","poem":1},{"lineBreak":true},{"text":"चट्टान पर पटक दे!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}