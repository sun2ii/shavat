{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"verse","number":1,"content":[{"text":"मैं पूरे दिल से तेरा शुक्र करूँगा;","poem":1},{"lineBreak":true},{"text":"मा'बूदों के सामने तेरी मदहसराई करूँगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं तेरी पाक हैकल की तरफ़ रुख़ कर के सिज्दा करूँगा,","poem":1},{"lineBreak":true},{"text":"और तेरी शफ़क़त औए सच्चाई की ख़ातिर तेरे नाम का शुक्र करूँगा।","poem":1},{"lineBreak":true},{"text":"क्यूँकि तूने अपने कलाम को अपने हरनाम से ज़्यादा 'अज़मत दी है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जिस दिन मैंने तुझ से दुआ की, तूने मुझे जवाब दिया,","poem":1},{"lineBreak":true},{"text":"और मेरी जान की ताक़त देकर मेरा हौसला बढ़ाया।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! ज़मीन के सब बादशाह तेरा शुक्र करेंगे,","poem":1},{"lineBreak":true},{"text":"क्यूँकि उन्होंने तेरे मुँह का कलाम सुना है;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"बल्कि वह ख़ुदावन्द की राहों का हम्द गाएंगे","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द का जलाल बड़ा है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द अगरचे बुलन्द — ओ — बाला है,","poem":1},{"lineBreak":true},{"text":"तोभी ख़ाकसार का ख़याल रखता है;","poem":1},{"lineBreak":true},{"text":"लेकिन मग़रूर को दूर ही से पहचान लेता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"चाहे मैं दुख में से गुज़रूं तू मुझे ताज़ादम करेगा,","poem":1},{"lineBreak":true},{"text":"तू मेरे दुश्मनों के क़हर के ख़िलाफ़ हाथ बढ़ाएगा,","poem":1},{"lineBreak":true},{"text":"और तेरा दहना हाथ मुझे बचा लेगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द मेरे लिए सब कुछ करेगा;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! तेरी शफ़क़त हमेशा की है।","poem":1},{"lineBreak":true},{"text":"अपनी दस्तकारी को न छोड़।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}