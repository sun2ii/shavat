{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"बेवकू़फ़ ने अपने दिल में कहा है, कि कोई ख़ुदा नहीं। वह बिगड़ गए,","poem":1},{"lineBreak":true},{"text":"उन्होंने नफ़रतअंगेज़ काम किए हैं;","poem":1},{"lineBreak":true},{"text":"कोई नेकोकार नहीं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द ने आसमान पर से बनी आदम पर निगाह की ताकि देखे कि कोई अक़्लमन्द,","poem":1},{"lineBreak":true},{"text":"कोई ख़ुदा का तालिब है या नहीं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह सब के सब गुमराह हुए, वह एक साथ नापाक हो गए,","poem":1},{"lineBreak":true},{"text":"कोई नेकोकार नहीं, एक भी नहीं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्या उन सब बदकिरदारों को कुछ'इल्म नहीं,","poem":1},{"lineBreak":true},{"text":"जो मेरे लोगों को ऐसे खा जाते हैं जैसे रोटी,","poem":1},{"lineBreak":true},{"text":"और ख़ुदावन्द का नाम नहीं लेते?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वहाँ उन पर बड़ा ख़ौफ़ छा गया,","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदा सादिक़ नसल के साथ है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुम ग़रीब की मश्वरत की हँसी उड़ाते हो;","poem":1},{"lineBreak":true},{"text":"इसलिए के ख़ुदावन्द उसकी पनाह है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"काश कि इस्राईल की नजात सिय्यून में से होती!","poem":1},{"lineBreak":true},{"text":"जब ख़ुदावन्द अपने लोगों को ग़ुलामी से लौटा लाएगा,","poem":1},{"lineBreak":true},{"text":"तो या'क़ूब ख़ुश और इस्राईल शादमान होगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}