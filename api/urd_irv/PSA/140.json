{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द! मुझे बुरे आदमी से रिहाई बख़्श;","poem":1},{"lineBreak":true},{"text":"मुझे टेढ़े आदमी से महफूज़ रख।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जो दिल में शरारत के मन्सूबे बाँधते हैं;","poem":1},{"lineBreak":true},{"text":"वह हमेशा मिलकर जंग के लिए जमा' हो जाते हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उन्होंने अपनी ज़बान साँप की तरह तेज़ कर रखी है।","poem":1},{"lineBreak":true},{"text":"उनके होटों के नीचे अज़दहा का ज़हर है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! मुझे शरीर के हाथ से बचा मुझे टेढ़े आदमी से महफूज़ रख,","poem":1},{"lineBreak":true},{"text":"जिनका इरादा है कि मेरे पाँव उखाड़ दें।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मग़रूरों ने मेरे लिए फंदे और रस्सियों को छिपाया है,","poem":1},{"lineBreak":true},{"text":"उन्होंने राह के किनारे जाल लगाया है;","poem":1},{"lineBreak":true},{"text":"उन्होंने मेरे लिए दाम बिछा रख्खे हैं। सिलाह","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैंने ख़ुदावन्द से कहा,","poem":1},{"lineBreak":true},{"text":"मेरा ख़ुदा तू ही है। ऐ ख़ुदावन्द,","poem":1},{"lineBreak":true},{"text":"मेरी इल्तिजा की आवाज़ पर कान लगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द मेरे मालिक, ऐ मेरी नजात की ताक़त,","poem":1},{"lineBreak":true},{"text":"तूने जंग के दिन मेरे सिर पर साया किया है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, शरीर की मुराद पूरी न कर,","poem":1},{"lineBreak":true},{"text":"उसके बुरे मन्सूबे को अंजाम न दे ताकि वह डींग न मारे। सिलाह","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मुझे घेरने वालों की मुँह के शरारत,","poem":1},{"lineBreak":true},{"text":"उन्हीं के सिर पर पड़े।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"उन पर अंगारे गिरें! वह आग में डाले जाएँ!","poem":1},{"lineBreak":true},{"text":"और ऐसे गढ़ों में कि फिर न उठे।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"बदज़बान आदमी की ज़मीन पर क़याम न होगा।","poem":1},{"lineBreak":true},{"text":"आफ़त टेढ़े आदमी को दौड़ा कर हलाक करेगी।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मैं जानता हूँ कि ख़ुदावन्द मुसीब तज़दा के मु'आमिले की,","poem":1},{"lineBreak":true},{"text":"और मोहताज के हक़ की ताईद करेगा।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"यक़ीनन सादिक़ तेरे नाम का शुक्र करेंगे,","poem":1},{"lineBreak":true},{"text":"और रास्तबाज़ तेरे सामने में रहेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}