{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द! मैने तेरी दुहाई दी मेरी तरफ़ जल्द आ!","poem":1},{"lineBreak":true},{"text":"जब मैं तुझ से दुआ करूँ, तो मेरी आवाज़ पर कान लगा!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मेरी दुआ तेरे सामने ख़ुशबू की तरह हो,","poem":1},{"lineBreak":true},{"text":"और मेरा हाथ उठाना शाम की कु़र्बानी की तरह!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! मेरे मुँह पर पहरा बिठा;","poem":1},{"lineBreak":true},{"text":"मेरे लबों के दरवाजे़ की निगहबानी कर।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मेरे दिल को किसी बुरी बात की तरफ़ माइल न होने दे;","poem":1},{"lineBreak":true},{"text":"कि बदकारों के साथ मिलकर, शरारत के कामों में मसरूफ़ हो जाए,","poem":1},{"lineBreak":true},{"text":"और मुझे उनके नफ़ीस खाने से दूर रख।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"सादिक़ मुझे मारे तो मेहरबानी होगी,","poem":1},{"lineBreak":true},{"text":"वह मुझे तम्बीह करे तो जैसे सिर पर रौग़न होगा।","poem":1},{"lineBreak":true},{"text":"मेरा सिर इससे इंकार न करे,","poem":1},{"lineBreak":true},{"text":"क्यूँकि उनकी शरारत में भी मैं दुआ करता रहूँगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उनके हाकिम चट्टान के किनारों पर से गिरा दिए गए हैं,","poem":1},{"lineBreak":true},{"text":"और वह मेरी बातें सुनेंगे, क्यूँकि यह शीरीन हैं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जैसे कोई हल चलाकर ज़मीन को तोड़ता है,","poem":1},{"lineBreak":true},{"text":"वैसे ही हमारी हड्डियाँ पाताल के मुँह पर बिखरी पड़ी हैं।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"क्यूँकि ऐ मालिक ख़ुदावन्द! मेरी आँखें तेरी तरफ़ हैं;","poem":1},{"lineBreak":true},{"text":"मेरा भरोसा तुझ पर है, मेरी जान को बेकस न छोड़!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मुझे उस फंदे से जो उन्होंने मेरे लिए लगाया है,","poem":1},{"lineBreak":true},{"text":"और बदकिरदारों के दाम से बचा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"शरीर आप अपने जाल में फंसें,","poem":1},{"lineBreak":true},{"text":"और मैं सलामत बच निकलूँ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}