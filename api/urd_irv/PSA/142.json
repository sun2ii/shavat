{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"मैं अपनी ही आवाज़ बुलंद करके ख़ुदावन्द से फ़रियाद करता हूँ","poem":1},{"lineBreak":true},{"text":"मै अपनी ही आवाज़ से ख़ुदावन्द से मिन्नत करता हूँ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं उसके सामने फ़रियाद करता हूँ,","poem":1},{"lineBreak":true},{"text":"मैं अपना दुख उसके सामने बयान करता हूँ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जब मुझ में मेरी जान निढाल थी,","poem":1},{"lineBreak":true},{"text":"तू मेरी राह से वाक़िफ़ था!","poem":1},{"lineBreak":true},{"text":"जिस राह पर मैं चलता हूँ उसमे उन्होंने मेरे लिए फंदा लगाया है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"दहनी तरफ़ निगाह कर और देख,","poem":1},{"lineBreak":true},{"text":"मुझे कोई नहीं पहचानता। मेरे लिए कहीं पनाह न रही,","poem":1},{"lineBreak":true},{"text":"किसी को मेरी जान की फ़िक्र नहीं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मैंने तुझ से फ़रियाद की;","poem":1},{"lineBreak":true},{"text":"मैंने कहा, तू मेरी पनाह है,","poem":1},{"lineBreak":true},{"text":"और ज़िन्दों की ज़मीन में मेरा बख़रा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मेरी फ़रियाद पर तवज्जुह कर,","poem":1},{"lineBreak":true},{"text":"क्यूँकि मैं बहुत पस्त हो गया हूँ!","poem":1},{"lineBreak":true},{"text":"मेरे सताने वालों से मुझे रिहाई बख़्श,","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह मुझ से ताक़तवर हैं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मेरी जान को कै़द से निकाल,","poem":1},{"lineBreak":true},{"text":"ताकि तेरे नाम का शुक्र करूँ सादिक़ मेरे गिर्द जमा होंगे","poem":1},{"lineBreak":true},{"text":"क्यूँकि तू मुझ पर एहसान करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}