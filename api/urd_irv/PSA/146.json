{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द की हम्द करो ऐ मेरी जान,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द कर!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं उम्र भर ख़ुदावन्द की हम्द करूँगा,","poem":1},{"lineBreak":true},{"text":"जब तक मेरा वुजूद है मैं अपने ख़ुदा की मदहसराई करूँगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"न उमरा पर भरोसा करो न आदमज़ाद पर,","poem":1},{"lineBreak":true},{"text":"वह बचा नहीं सकता।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उसका दम निकल जाता है तो वह मिट्टी में मिल जाता है;","poem":1},{"lineBreak":true},{"text":"उसी दिन उसके मन्सूबे फ़ना हो जाते हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"खु़श नसीब है वह, जिसका मददगार या'क़ूब का ख़ुदा है,","poem":1},{"lineBreak":true},{"text":"और जिसकी उम्मीद ख़ुदावन्द उसके ख़ुदा से है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जिसने आसमान और ज़मीन और समन्दर को,","poem":1},{"lineBreak":true},{"text":"और जो कुछ उनमें है बनाया;","poem":1},{"lineBreak":true},{"text":"जो सच्चाई को हमेशा क़ाईम रखता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जो मज़लूमों का इन्साफ़ करता है;","poem":1},{"lineBreak":true},{"text":"जो भूकों को खाना देता है।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द कैदियों को आज़ाद करता है;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द अन्धों की आँखें खोलता है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द झुके हुए को उठा खड़ा करता है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द सादिक़ों से मुहब्बत रखता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द परदेसियों की हिफ़ाज़त करता है;","poem":1},{"lineBreak":true},{"text":"वह यतीम और बेवा को संभालता है;","poem":1},{"lineBreak":true},{"text":"लेकिन शरीरों की राह टेढ़ी कर देता है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द, हमेशा तक सल्तनत करेगा,","poem":1},{"lineBreak":true},{"text":"ऐ सिय्यून! तेरा ख़ुदा नसल दर नसल।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द करो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}