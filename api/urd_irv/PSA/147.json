{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द की हम्द करो!","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदा की मदहसराई करना भला है;","poem":1},{"lineBreak":true},{"text":"इसलिए कि यह दिलपसंद और सिताइश ज़ेबा है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द येरूशलेम को ता'मीर करता है;","poem":1},{"lineBreak":true},{"text":"वह इस्राईल के जिला वतनों को जमा' करता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह शिकस्ता दिलों को शिफ़ा देता है,","poem":1},{"lineBreak":true},{"text":"और उनके ज़ख़्म बाँधता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह सितारों को शुमार करता है,","poem":1},{"lineBreak":true},{"text":"और उन सबके नाम रखता है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हमारा ख़ुदावन्द बुजु़र्ग और कु़दरत में 'अज़ीम है;","poem":1},{"lineBreak":true},{"text":"उसके समझ की इन्तिहा नहीं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द हलीमों को संभालता है,","poem":1},{"lineBreak":true},{"text":"वह शरीरों को ख़ाक में मिला देता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के सामने शुक्रगुज़ारी का हम्द गाओ,","poem":1},{"lineBreak":true},{"text":"सितार पर हमारे ख़ुदा की मदहसराई करो।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जो आसमान को बादलों से मुलब्बस करता है;","poem":1},{"lineBreak":true},{"text":"जो ज़मीन के लिए मेंह तैयार करता है; जो पहाड़ों पर घास उगाता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जो हैवानात को ख़ुराक देता है,","poem":1},{"lineBreak":true},{"text":"और कव्वे के बच्चे को जो काएँ काएँ करते हैं।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"घोड़े के ज़ोर में उसकी खु़शनूदी नहीं न आदमी की टाँगों से उसे कोई ख़ुशी है;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द उनसे ख़ुश है जो उससे डरते हैं,","poem":1},{"lineBreak":true},{"text":"और उनसे जो उसकी शफ़क़त के उम्मीदवार हैं।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ऐ येरूशलेम! ख़ुदावन्द की सिताइश कर!,","poem":1},{"lineBreak":true},{"text":"ऐ सिय्यून! अपने ख़ुदा की सिताइश कर।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"क्यूँकि उसने तेरे फाटकों के बेंडों को मज़बूत किया है,","poem":1},{"lineBreak":true},{"text":"उसने तेरे अन्दर तेरी औलाद को बरकत दी है।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"वह तेरी हद में अम्न रखता है!","poem":1},{"lineBreak":true},{"text":"वह तुझे अच्छे से अच्छे गेहूँ से आसूदा करता है।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"वह अपना हुक्म ज़मीन पर भेजता है,","poem":1},{"lineBreak":true},{"text":"उसका कलाम बहुत तेज़ रौ है।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"वह बर्फ़ को ऊन की तरह गिराता है,","poem":1},{"lineBreak":true},{"text":"और पाले को राख की तरह बिखेरता है।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"वह यख़ को लुक़मों की तरह फेंकता","poem":1},{"lineBreak":true},{"text":"उसकी ठंड कौन सह सकता है?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"वह अपना कलाम नाज़िल करके उनको पिघला देता है","poem":1},{"lineBreak":true},{"text":"; वह हवा चलाता है और पानी बहने लगता है।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"वह अपना कलाम या'क़ूब पर ज़ाहिर करता है,","poem":1},{"lineBreak":true},{"text":"और अपने आईन — ओ — अहकाम इस्राईल पर।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"उसने किसी और क़ौम से ऐसा सुलूक नहीं किया;","poem":1},{"lineBreak":true},{"text":"और उनके अहकाम को उन्होंने नहीं जाना।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द करो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}