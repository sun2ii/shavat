umber":6,"content":[{"lineBreak":true},{"text":"उसने इनको हमेशा से हमेशा तक के लिए क़ाईम किया है;","poem":1},{"lineBreak":true},{"text":"उसने अटल क़ानून मुक़र्रर कर दिया है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ज़मीन पर से ख़ुदावन्द की हम्द करो","poem":1},{"lineBreak":true},{"text":"ऐ अज़दहाओं और सब गहरे समन्दरो!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ आग और ओलो! ऐ बर्फ़ और कुहर ऐ तूफ़ानी हवा!","poem":1},{"lineBreak":true},{"text":"जो उसके कलाम की ता'लीम करती है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ पहाड़ो और सब टीलो!","poem":1},{"lineBreak":true},{"text":"ऐ मेवादार दरख़्तो और सब देवदारो!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ऐ जानवरो और सब चौपायो!","poem":1},{"lineBreak":true},{"text":"ऐ रेंगने वालो और परिन्दो!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ऐ ज़मीन के बादशाहो और सब उम्मतों!","poem":1},{"lineBreak":true},{"text":"ऐ उमरा और ज़मीन के सब हाकिमों!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ऐ नौजवानो और कुंवारियो!","poem":1},{"lineBreak":true},{"text":"ऐ बूढ़ों और बच्चो!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"यह सब ख़ुदावन्द के नाम की हम्द करें,","poem":1},{"lineBreak":true},{"text":"क्यूँकि सिर्फ़ उसी का नाम मुम्ताज़ है।","poem":1},{"lineBreak":true},{"text":"उसका जलाल ज़मीन और आसमान से बुलन्द है।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"और उसने अपने सब पाक लोगों या'नी","poem":1},{"lineBreak":true},{"text":"अपनी मुक़र्रब क़ौम बनी इस्राईल के फ़ख़्र के लिए,","poem":1},{"lineBreak":true},{"text":"अपनी क़ौम का सींग बुलन्द किया।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द करो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/149.json","nextC