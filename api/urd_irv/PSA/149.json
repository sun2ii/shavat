{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द की हम्द करो।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द के सामने नया हम्द गाओ,","poem":1},{"lineBreak":true},{"text":"और पाक लोगों के मजमे' में उसकी मदहसराई करो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"इस्राईल अपने ख़ालिक में ख़ुश रहे,","poem":1},{"lineBreak":true},{"text":"फ़र्ज़न्दान — ए — सिय्यून अपने बादशाह की वजह से ख़ुश हों!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह नाचते हुए उसके नाम की सिताइश करें,","poem":1},{"lineBreak":true},{"text":"वह दफ़ और सितार पर उसकी मदहसराई करें!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द अपने लोगों से खू़शनूद रहता है;","poem":1},{"lineBreak":true},{"text":"वह हलीमों को नजात से ज़ीनत बख़्शेगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"पाक लोग जलाल पर फ़ख़्र करें,","poem":1},{"lineBreak":true},{"text":"वह अपने बिस्तरों पर ख़ुशी से नग़मा सराई करें।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उनके मुँह में ख़ुदा की तम्जीद,","poem":1},{"lineBreak":true},{"text":"और हाथ में दोधारी तलवार हो,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ताकि क़ौमों से इन्तक़ाम लें,","poem":1},{"lineBreak":true},{"text":"और उम्मतों को सज़ा दें:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"उनके बादशाहों को ज़ंजीरों से जकड़ें,","poem":1},{"lineBreak":true},{"text":"और उनके सरदारों को लोहे की बेड़ियाँ पहनाएं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ताकि उनको वह सज़ा दें जो लिखी हैं!","poem":1},{"lineBreak":true},{"text":"उसके सब पाक लोगों को यह मक़ाम हासिल है।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की हम्द करो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}