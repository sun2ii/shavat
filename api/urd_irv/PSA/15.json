{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द तेरे ख़ेमे में कौन रहेगा?","poem":1},{"lineBreak":true},{"text":"तेरे पाक पहाड़ पर कौन सुकूनत करेगा?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वह जो रास्ती से चलता और सदाक़त का काम करता,","poem":1},{"lineBreak":true},{"text":"और दिल से सच बोलता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह जो अपनी ज़बान से बुहतान नहीं बांधता,","poem":1},{"lineBreak":true},{"text":"और अपने दोस्त से बदी नहीं करता,","poem":1},{"lineBreak":true},{"text":"और अपने पड़ोसी की बदनामी नहीं सुनता।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह जिसकी नज़र में रज़ील आदमी हक़ीर है,","poem":1},{"lineBreak":true},{"text":"लेकिन जो ख़ुदावन्द से डरते हैं उनकी 'इज़्ज़त करता है;","poem":1},{"lineBreak":true},{"text":"वह जो क़सम खाकर बदलता नहीं चाहे नुक़्सान ही उठाए।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह जो अपना रुपया सूद पर नहीं देता,","poem":1},{"lineBreak":true},{"text":"और बेगुनाह के ख़िलाफ़ रिश्वत नहीं लेता।","poem":1},{"lineBreak":true},{"text":"ऐसे काम करने वाला कभी जुम्बिश न खाएगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}