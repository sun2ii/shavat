{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा मेरी हिफ़ाज़त कर,","poem":1},{"lineBreak":true},{"text":"क्यूँकि मैं तुझ ही में पनाह लेता हूँ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैंने ख़ुदावन्द से कहा","poem":1},{"lineBreak":true},{"text":"“तू ही रब है तेरे अलावा मेरी भलाई नहीं।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ज़मीन के पाक लोग वह बरगुज़ीदा हैं,","poem":1},{"lineBreak":true},{"text":"जिनमें मेरी पूरी ख़ुशनूदी है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"गै़र मा'बूदों के पीछे दौड़ने वालों का ग़म बढ़ जाएगा;","poem":1},{"lineBreak":true},{"text":"मैं उनके से खू़न वाले तपावन नहीं तपाऊँगा और अपने होटों से उनके नाम नहीं लूँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द ही मेरी मीरास और मेरे प्याले का हिस्सा है;","poem":1},{"lineBreak":true},{"text":"तू मेरे बख़रे का मुहाफ़िज़ है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जरीब मेरे लिए दिलपसंद जगहों में पड़ी,","poem":1},{"lineBreak":true},{"text":"बल्कि मेरी मीरास खू़ब है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द की हम्द करूँगा,","poem":1},{"lineBreak":true},{"text":"जिसने, मुझे नसीहत दी है;","poem":1},{"lineBreak":true},{"text":"बल्कि मेरा दिल रात को मेरी तरबियत करता है","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैंने ख़ुदावन्द को हमेशा अपने सामने रख्खा है;","poem":1},{"lineBreak":true},{"text":"चूँकि वह मेरे दहने हाथ है,","poem":1},{"lineBreak":true},{"text":"इसलिए मुझे जुम्बिश न होगी।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"इसी वजह से मेरा दिल खु़श और मेरी रूह शादमान है;","poem":1},{"lineBreak":true},{"text":"मेरा जिस्म भी अम्न — ओ — अमान में रहेगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"क्यूँकि तू न मेरी जान को पाताल में रहने देगा,","poem":1},{"lineBreak":true},{"text":"न अपने मुक़द्दस को सड़ने देगा।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तू मुझे ज़िन्दगी की राह दिखाएगा;","poem":1},{"lineBreak":true},{"text":"तेरे हुज़ूरमें कामिल शादमानी है।","poem":1},{"lineBreak":true},{"text":"तेरे दहने हाथ में हमेशा की खु़शी है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}