{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"आसमान ख़ुदा का जलाल ज़ाहिर करता है;","poem":1},{"lineBreak":true},{"text":"और फ़ज़ा उसकी दस्तकारी दिखाती है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"दिन से दिन बात करता है,","poem":1},{"lineBreak":true},{"text":"और रात को रात हिकमत सिखाती है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"न बोलना है न कलाम,","poem":1},{"lineBreak":true},{"text":"न उनकी आवाज़ सुनाई देती है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उनका सुर सारी ज़मीन पर,","poem":1},{"lineBreak":true},{"text":"और उनका कलाम दुनिया की इन्तिहा तक पहुँचा है।","poem":1},{"lineBreak":true},{"text":"उसने आफ़ताब के लिए उनमें ख़ेमा लगाया है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जो दुल्हे की तरह अपने ख़िलवतख़ाने से निकलता है।","poem":1},{"lineBreak":true},{"text":"और पहलवान की तरह अपनी दौड़ में दौड़ने को खु़श है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह आसमान की इन्तिहा से निकलता है,","poem":1},{"lineBreak":true},{"text":"और उसकी गश्त उसके किनारों तक होती है;","poem":1},{"lineBreak":true},{"text":"और उसकी हरारत से कोई चीज़ बे बहरा नहीं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की शरी'अत कामिल है,","poem":1},{"lineBreak":true},{"text":"वह जान को बहाल करती है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द कि शहादत बरहक़ है नादान को दानिश बख़्शती है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के क़वानीन रास्त हैं,","poem":1},{"lineBreak":true},{"text":"वह दिल को फ़रहत पहुँचाते हैं;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द का हुक्म बे'ऐब है, वह आँखों की रौशन करता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द का ख़ौफ़ पाक है, वह अबद तक क़ाईम रहता है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द के अहकाम बरहक़ और बिल्कुल रास्त हैं।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"वह सोने से बल्कि बहुत कुन्दन से ज़्यादा पसंदीदा हैं;","poem":1},{"lineBreak":true},{"text":"वह शहद से बल्कि छत्ते के टपकों से भी शीरीन हैं।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"नीज़ उन से तेरे बन्दे को आगाही मिलती है;","poem":1},{"lineBreak":true},{"text":"उनको मानने का अज्र बड़ा है।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"कौन अपनी भूलचूक को जान सकता है?","poem":1},{"lineBreak":true},{"text":"तू मुझे पोशीदा 'ऐबों से पाक कर।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"तू अपने बंदे को बे — बाकी के गुनाहों से भी बाज़ रख;","poem":1},{"lineBreak":true},{"text":"वह मुझ पर ग़ालिब न आएँ तो मैं कामिल हूँगा, और बड़े गुनाह से बचा रहूँगा।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मेरे मुँह का कलाम और मेरे दिल का ख़याल तेरे सामने मक़्बूल ठहरे;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! ऐ मेरी चट्टान और मेरे फ़िदिया देने वाले!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}