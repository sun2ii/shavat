{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"क़ौमें किस लिए ग़ुस्से में है","poem":1},{"lineBreak":true},{"text":"और लोग क्यूँ बेकार ख़याल बाँधते हैं","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द और उसके मसीह के ख़िलाफ़ ज़मीन के बादशाह एक हो कर,","poem":1},{"lineBreak":true},{"text":"और हाकिम आपस में मशवरा करके कहते हैं,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“आओ, हम उनके बन्धन तोड़ डालें,","poem":1},{"lineBreak":true},{"text":"और उनकी रस्सियाँ अपने ऊपर से उतार फेंके।”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह जो आसमान पर तख़्त नशीन है हँसेगा,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द उनका मज़ाक़ उड़ाएगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तब वह अपने ग़ज़ब में उनसे कलाम करेगा,","poem":1},{"lineBreak":true},{"text":"और अपने ग़ज़बनाक ग़ुस्से में उनको परेशान कर देगा,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“मैं तो अपने बादशाह को,","poem":1},{"lineBreak":true},{"text":"अपने पाक पहाड़ सिय्यून पर बिठा चुका हूँ।”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मैं उस फ़रमान को बयान करूँगा:ख़ुदावन्द ने मुझ से कहा,","poem":1},{"lineBreak":true},{"text":"“तू मेरा बेटा है। आज तू मुझ से पैदा हुआ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मुझ से माँग, और मैं क़ौमों को तेरी मीरास के लिए,","poem":1},{"lineBreak":true},{"text":"और ज़मीन के आख़िरी हिस्से तेरी मिल्कियत के लिए तुझे बख़्शूँगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तू उनको लोहे के 'असा से तोड़ेगा,","poem":1},{"lineBreak":true},{"text":"कुम्हार के बर्तन की तरह तू उनको चकनाचूर कर डालेगा।”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"इसलिए अब ऐ बादशाहो,","poem":1},{"lineBreak":true},{"text":"अक़्लमंद बनो; ऐ ज़मीन की 'अदालत करने वालो, तरबियत पाओ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"डरते हुए ख़ुदावन्द की इबादत करो,","poem":1},{"lineBreak":true},{"text":"काँपते हुए ख़ुशी मनाओ।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"बेटे को चूमो, ऐसा न हो कि वह क़हर में आए,","poem":1},{"lineBreak":true},{"text":"और तुम रास्ते में हलाक हो जाओ,","poem":1},{"lineBreak":true},{"text":"क्यूँकि उसका ग़ज़ब जल्द भड़कने को है।","poem":1},{"lineBreak":true},{"text":"मुबारक हैं वह सब जिनका भरोसा उस पर है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}