{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"मुसीबत के दिन ख़ुदावन्द तेरी सुने।","poem":1},{"lineBreak":true},{"text":"या'क़ूब के ख़ुदा का नाम तुझे बुलन्दी पर क़ाईम करे!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वह मक़दिस से तेरे लिए मदद भेजे,","poem":1},{"lineBreak":true},{"text":"और सिय्यून से तुझे क़ुव्वत बख़्शे!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह तेरे सब हदियों को याद रख्खे,","poem":1},{"lineBreak":true},{"text":"और तेरी सोख़्तनी क़ुर्बानी को क़ुबूल करे! सिलाह","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह तेरे दिल की आरज़ू पूरी करे,","poem":1},{"lineBreak":true},{"text":"और तेरी सब मश्वरत पूरी करे!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हम तेरी नजात पर ख़ुशी मनाएंगे,","poem":1},{"lineBreak":true},{"text":"और अपने ख़ुदा के नाम पर झंडे खड़े करेंगे।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द तेरी तमाम दरख़्वास्तें पूरी करे!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"अब मैं जान गया कि ख़ुदावन्द अपने मम्सूह को बचा लेता है;","poem":1},{"lineBreak":true},{"text":"वह अपने दहने हाथ की नजात बख़्श ताक़त से अपने पाक आसमान पर से उसे जवाब देगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"किसी को रथों का और किसी को घोड़ों का भरोसा है,","poem":1},{"lineBreak":true},{"text":"लेकिन हम तो ख़ुदावन्द अपने ख़ुदा ही का नाम लेंगे।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह तो झुके और गिर पड़े;","poem":1},{"lineBreak":true},{"text":"लेकिन हम उठे और सीधे खड़े हैं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! बचा ले;","poem":1},{"lineBreak":true},{"text":"जिस दिन हम पुकारें, तो बादशाह हमें जवाब दे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}