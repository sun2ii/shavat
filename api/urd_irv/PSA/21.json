{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द! तेरी ताक़त से बादशाह खु़श होगा;","poem":1},{"lineBreak":true},{"text":"और तेरी नजात से उसे बहुत ख़ुशी होगी।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तूने उसके दिल की आरज़ू पूरी की है,","poem":1},{"lineBreak":true},{"text":"और उसके मुँह की दरख़्वास्त को नामंजूर नहीं किया। सिलाह;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि तू उसे 'उम्दा बरकतें बख़्शने में पेश कदमी करता,","poem":1},{"lineBreak":true},{"text":"और ख़ालिस सोने का ताज उसके सिर पर रखता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उसने तुझ से ज़िन्दगी चाही और तूने बख़्शी;","poem":1},{"lineBreak":true},{"text":"बल्कि उम्र की दराज़ी हमेशा के लिए।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तेरी नजात की वजह से उसकी शौकत 'अज़ीम है;","poem":1},{"lineBreak":true},{"text":"तू उसे हश्मत — ओ — जलाल से आरास्ता करता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क्यूँकि तू हमेशा के लिए उसे बरकतों से मालामाल करता है;","poem":1},{"lineBreak":true},{"text":"और अपने सामने उसे ख़ुश — ओ — ख़ुर्रम रखता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्यूँकि बादशाह का भरोसा ख़ुदावन्द पर है;","poem":1},{"lineBreak":true},{"text":"और हक़ता'ला की शफ़क़त की बदौलत उसे हरगिज़ जुम्बिश न होगी।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तेरा हाथ तेरे सब दुश्मनों को ढूंड निकालेगा,","poem":1},{"lineBreak":true},{"text":"तेरा दहना हाथ तुझ से कीना रखने वालों का पता लगा लेगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तू अपने क़हर के वक़्त उनको जलते तनूर की तरह कर देगा।","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द अपने ग़ज़ब में उनको निगल जाएगा,","poem":1},{"lineBreak":true},{"text":"और आग उनको खा जाएगी।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तू उनके फल को ज़मीन पर से बर्बाद कर देगा,","poem":1},{"lineBreak":true},{"text":"और उनकी नसल को बनी आदम में से।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"क्यूँकि उन्होंने तुझ से बदी करना चाहा,","poem":1},{"lineBreak":true},{"text":"उन्होंने ऐसा मन्सूबा बाँधा जिसे वह पूरा नहीं कर सकते।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"क्यूँकि तू उनका मुँह फेर देगा,","poem":1},{"lineBreak":true},{"text":"तू उनके मुक़ाबले में अपने चिल्ले चढ़ाएगा।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, तू अपनी ही ताक़त में सरबुलन्द हो!","poem":1},{"lineBreak":true},{"text":"और हम गाकर तेरी क़ुदरत की सिताइश करेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}