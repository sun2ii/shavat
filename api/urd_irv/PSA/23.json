{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द मेरा चौपान है,","poem":1},{"lineBreak":true},{"text":"मुझे कमी न होगी।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वह मुझे हरी हरी चरागाहों में बिठाता है;","poem":1},{"lineBreak":true},{"text":"वह मुझे राहत के चश्मों के पास ले जाता है;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह मेरी जान को बहाल करता है।","poem":1},{"lineBreak":true},{"text":"वह मुझे अपने नाम की ख़ातिर सदाकत की राहों पर ले चलता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"बल्कि चाहे मौत के साये की वादी में से मेरा गुज़र हो,","poem":1},{"lineBreak":true},{"text":"मैं किसी बला से नहीं डरूंगा, क्यूँकि तू मेरे साथ है;","poem":1},{"lineBreak":true},{"text":"तेरे 'असा और तेरी लाठी से मुझे तसल्ली है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तू मेरे दुश्मनों के सामने मेरे आगे दस्तरख़्वान बिछाता है;","poem":1},{"lineBreak":true},{"text":"तूने मेरे सिर पर तेल मला है, मेरा प्याला लबरेज़ होता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यक़ीनन भलाई और रहमत उम्र भर मेरे साथ साथ रहेंगी:","poem":1},{"lineBreak":true},{"text":"और मैं हमेशा ख़ुदावन्द के घर में सकूनत करूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}