{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"ज़मीन और उसकी मा'मुरी ख़ुदावन्द ही की है,","poem":1},{"lineBreak":true},{"text":"जहान और उसके बाशिन्दे भी।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्यूँकि उसने समन्दरों पर उसकी बुनियाद रख्खी","poem":1},{"lineBreak":true},{"text":"और सैलाबों पर उसे क़ाईम किया।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के पहाड़ पर कौन चढ़ेगा?","poem":1},{"lineBreak":true},{"text":"और उसके पाक मक़ाम पर कौन खड़ा होगा?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वही जिसके हाथ साफ़ हैं और जिसका दिल पाक है,","poem":1},{"lineBreak":true},{"text":"जिसने बकवास पर दिल नहीं लगाया,","poem":1},{"lineBreak":true},{"text":"और मक्र से क़सम नहीं खाई।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह ख़ुदावन्द की तरफ़ से बरकत पाएगा,","poem":1},{"lineBreak":true},{"text":"हाँ अपने नजात देने वाले ख़ुदा की तरफ़ से सदाक़त।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यही उसके तालिबों की नसल है,","poem":1},{"lineBreak":true},{"text":"यही तेरे दीदार के तलबगार हैं या'नी या'क़ूब। सिलाह","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ फाटको, अपने सिर बुलन्द करो।","poem":1},{"lineBreak":true},{"text":"ऐ अबदी दरवाज़ो, ऊँचे हो जाओ!","poem":1},{"lineBreak":true},{"text":"और जलाल का बादशाह दाख़िल होगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"यह जलाल का बादशाह कौन है?","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द जो क़वी और क़ादिर है,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द जो जंग में ताक़तवर है!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ फाटको, अपने सिर बुलन्द करो!","poem":1},{"lineBreak":true},{"text":"ऐ अबदी दरवाज़ो, उनको बुलन्द करो!","poem":1},{"lineBreak":true},{"text":"और जलाल का बादशाह दाख़िल होगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"यह जलाल का बादशाह कौन है?","poem":1},{"lineBreak":true},{"text":"लश्करों का ख़ुदावन्द, वही जलाल का बादशाह है। सिलाह।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}