{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द, मेरा इन्साफ़ कर,","poem":1},{"lineBreak":true},{"text":"क्यूँकि मैं रास्ती से चलता रहा हूँ,","poem":1},{"lineBreak":true},{"text":"और मैंने ख़ुदावन्द पर बे लग़ज़िश भरोसा किया है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मुझे जाँच और आज़मा;","poem":1},{"lineBreak":true},{"text":"मेरे दिल — ओ — दिमाग़ को परख।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि तेरी शफ़क़त मेरी आँखों के सामने है,","poem":1},{"lineBreak":true},{"text":"और मैं तेरी सच्चाई की राह पर चलता रहा हूँ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैं बेहूदा लोगों के साथ नहीं बैठा,","poem":1},{"lineBreak":true},{"text":"मैं रियाकारों के साथ कहीं नहीं जाऊँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"बदकिरदारों की जमा'अत से मुझे नफ़रत है,","poem":1},{"lineBreak":true},{"text":"मैं शरीरों के साथ नहीं बैठूँगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैं बेगुनाही में अपने हाथ धोऊँगा,","poem":1},{"lineBreak":true},{"text":"और ऐ ख़ुदावन्द, मैं तेरे मज़बह का तवाफ़ करूँगा;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ताकि शुक्रगुज़ारी की आवाज़ बुलन्द करूँ,","poem":1},{"lineBreak":true},{"text":"और तेरे सब 'अजीब कामों को बयान करूँ।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मैं तेरी सकूनतगाह,","poem":1},{"lineBreak":true},{"text":"और तेरे जलाल के ख़ेमे को 'अज़ीज़ रखता हूँ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मेरी जान को गुनहगारों के साथ,","poem":1},{"lineBreak":true},{"text":"और मेरी ज़िन्दगी को ख़ूनी आदमियों के साथ न मिला।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जिनके हाथों में शरारत है,","poem":1},{"lineBreak":true},{"text":"और जिनका दहना हाथ रिश्वतों से भरा है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"लेकिन मैं तो रास्ती से चलता रहूँगा।","poem":1},{"lineBreak":true},{"text":"मुझे छुड़ा ले और मुझ पर रहम कर।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मेरा पाँव हमवार जगह पर क़ाईम है।","poem":1},{"lineBreak":true},{"text":"मैं जमा'अतों में ख़ुदावन्द को मुबारक कहूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}