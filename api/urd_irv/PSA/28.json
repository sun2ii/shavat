{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द, मैं तुझ ही को पुकारूँगा;","poem":1},{"lineBreak":true},{"text":"ऐ मेरी चट्टान, तू मेरी तरफ़ से कान बन्द न कर;","poem":1},{"lineBreak":true},{"text":"ऐसा न हो कि अगर तू मेरी तरफ़ से खामोश रहे तो मैं उनकी तरह बन जाऊँ,","poem":1},{"lineBreak":true},{"text":"जो पाताल में जाते हैं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जब मैं तुझ से फ़रियाद करूँ,","poem":1},{"lineBreak":true},{"text":"और अपने हाथ तेरी मुक़द्दस हैकल की तरफ़ उठाऊँ,","poem":1},{"lineBreak":true},{"text":"तो मेरी मिन्नत की आवाज़ को सुन ले।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मुझे उन शरीरों और बदकिरदारों के साथ घसीट न ले जा;","poem":1},{"lineBreak":true},{"text":"जो अपने पड़ोसियों से सुलह की बातें करते हैं,","poem":1},{"lineBreak":true},{"text":"मगर उनके दिलों में बदी है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उनके अफ़'आल — ओ — आ'माल की बुराई के मुवाफ़िक़ उनको बदला दे,","poem":1},{"lineBreak":true},{"text":"उनके हाथों के कामों के मुताबिक़ उनसे सुलूक कर;","poem":1},{"lineBreak":true},{"text":"उनके किए का बदला उनको दे।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह ख़ुदावन्द के कामों","poem":1},{"lineBreak":true},{"text":"और उसकी दस्तकारी पर ध्यान नहीं करते,","poem":1},{"lineBreak":true},{"text":"इसलिए वह उनको गिरा देगा और फिर नहीं उठाएगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द मुबारक हो,","poem":1},{"lineBreak":true},{"text":"इसलिए के उसने मेरी मिन्नत की आवाज़ सुन ली।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द मेरी ताक़त और मेरी ढाल है;","poem":1},{"lineBreak":true},{"text":"मेरे दिल ने उस पर भरोसा किया है, और मुझे मदद मिली है।","poem":1},{"lineBreak":true},{"text":"इसलिए मेरा दिल बहुत ख़ुश है;","poem":1},{"lineBreak":true},{"text":"और मैं गीत गाकर उसकी सिताइश करूँगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द उनकी ताक़त है,","poem":1},{"lineBreak":true},{"text":"वह अपने मम्सूह के लिए नजात का क़िला' है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"अपनी उम्मत को बचा, और अपनी मीरास को बरकत दे;","poem":1},{"lineBreak":true},{"text":"उनकी पासबानी कर, और उनको हमेशा तक संभाले रह।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}