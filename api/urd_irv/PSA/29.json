{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ फ़रिश्तों की जमा'त ख़ुदावन्द की,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द ही की तम्जीद — ओ — ता'ज़ीम करो।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की ऐसी तम्जीद करो, जो उसके नाम के शायाँ है।","poem":1},{"lineBreak":true},{"text":"पाक आराइश के साथ ख़ुदावन्द को सिज्दा करो।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ बादलों पर है;","poem":1},{"lineBreak":true},{"text":"ख़ुदा — ए — जुलजलाल गरजता है,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द पानी से भरे बादलों पर है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ में क़ुदरत है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ में जलाल है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ देवदारों को तोड़ डालती है;","poem":1},{"lineBreak":true},{"text":"बल्कि ख़ुदावन्द लुबनान के देवदारों को टुकड़े टुकड़े कर देता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह उनको बछड़े की तरह,","poem":1},{"lineBreak":true},{"text":"लुबनान और सिरयून को जंगली बछड़े की तरह कुदाता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ आग के शो'लों को चीरती है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ वीरान को हिला देती है;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द क़ादिस के वीरान को हिला डालता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की आवाज़ से हिरनीयों के हमल गिर जाते हैं;","poem":1},{"lineBreak":true},{"text":"और वह जंगलों को बेबर्ग कर देती है;","poem":1},{"lineBreak":true},{"text":"उसकी हैकल में हर एक जलाल ही जलाल पुकारता है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तूफ़ान के वक़्त तख़्तनशीन था;","poem":1},{"lineBreak":true},{"text":"बल्कि ख़ुदावन्द हमेशा तक तख़्तनशीन है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द अपनी उम्मत को ज़ोर बख़्शेगा;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द अपनी उम्मत को सलामती की बरकत देगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}