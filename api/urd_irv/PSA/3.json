{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["मुसीबत के वक्त आखरी भरोसा"]},{"type":"hebrew_subtitle","content":["दाऊद का ज़बूर जब वह अपने बेटे अबीसलोम के सामने से भागा गया था।"]},{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द मेरे सताने वाले कितने बढ़ गए,","poem":1},{"lineBreak":true},{"text":"वह जो मेरे ख़िलाफ़ उठते हैं बहुत हैं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"बहुत से मेरी जान के बारे में कहते हैं,","poem":1},{"lineBreak":true},{"text":"कि ख़ुदा की तरफ़ से उसकी मदद न होगी। सिलाह","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"लेकिन तू ऐ ख़ुदावन्द, हर तरफ़ मेरी सिपर है।","poem":1},{"lineBreak":true},{"text":"मेरा फ़ख़्र और सरफ़राज़ करने वाला।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैं बुलन्द आवाज़ से ख़ुदावन्द के सामने फ़रियाद करता हूँ","poem":1},{"lineBreak":true},{"text":"और वह अपने पाक पहाड़ पर से मुझे जवाब देता है। सिलाह","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मैं लेट कर सो गया;","poem":1},{"lineBreak":true},{"text":"मैं जाग उठा, क्यूँकि ख़ुदावन्द मुझे संभालता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैं उन दस हज़ार आदमियों से नहीं डरने का,","poem":1},{"lineBreak":true},{"text":"जो चारों तरफ़ मेरे ख़िलाफ़ इकठ्ठा हैं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"उठ ऐ ख़ुदावन्द, ऐ मेरे ख़ुदा, मुझे बचा ले!","poem":1},{"lineBreak":true},{"text":"क्यूँकि तूने मेरे सब दुश्मनों को जबड़े पर मारा है। तूने शरीरों के दाँत तोड़ डाले हैं।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"नजात ख़ुदावन्द की तरफ़ से है।","poem":1},{"lineBreak":true},{"text":"तेरे लोगों पर तेरी बरकत हो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}