{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द, मैं तेरी तम्जीद करूँगा;","poem":1},{"lineBreak":true},{"text":"क्यूँकि तूने मुझे सरफ़राज़ किया है;","poem":1},{"lineBreak":true},{"text":"और मेरे दुश्मनों को मुझ पर खु़श होने न दिया।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द मेरे ख़ुदा!,","poem":1},{"lineBreak":true},{"text":"मैंने तुझ से फ़रियाद की और तूने मुझे शिफ़ा बख़्शी।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, तू मेरी जान को पाताल से निकाल लाया है;","poem":1},{"lineBreak":true},{"text":"तूने मुझे ज़िन्दा रख्खा है कि क़ब्र में न जाऊँ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की सिताइश करो,","poem":1},{"lineBreak":true},{"text":"ऐ उसके पाक लोगों!","poem":1},{"lineBreak":true},{"text":"और उसके पाकीज़गी को याद करके शुक्रगुज़ारी करो।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि उसका क़हर दम भर का है,","poem":1},{"lineBreak":true},{"text":"उसका करम उम्र भर का।","poem":1},{"lineBreak":true},{"text":"रात को शायद रोना पड़े पर सुबह को ख़ुशी की नौबत आती है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैंने अपनी इक़बालमंदी के वक़्त यह कहा था,","poem":1},{"lineBreak":true},{"text":"कि मुझे कभी जुम्बिश न होगी।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, तूने अपने करम से मेरे पहाड़ को क़ाईम रख्खा था;","poem":1},{"lineBreak":true},{"text":"जब तूने अपना चेहरा छिपाया तो मैं घबरा उठा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मैंने तुझ से फ़रियाद की;","poem":1},{"lineBreak":true},{"text":"मैंने ख़ुदावन्द से मिन्नत की,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जब मैं क़ब्र में जाऊँ तो मेरी मौत से क्या फ़ायदा?","poem":1},{"lineBreak":true},{"text":"क्या ख़ाक तेरी सिताइश करेगी?","poem":1},{"lineBreak":true},{"text":"क्या वह तेरी सच्चाई को बयान करेगी?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"सुन ले ऐ ख़ुदावन्द, और मुझ पर रहम कर;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, तू मेरा मददगार हो।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तूने मेरे मातम को नाच से बदल दिया;","poem":1},{"lineBreak":true},{"text":"तूने मेरा टाट उतार डाला और मुझे ख़ुशी से कमरबस्ता किया,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ताकि मेरी रूह तेरी मदहसराई करे और चुप न रहे।","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द मेरे ख़ुदा,","poem":1},{"lineBreak":true},{"text":"मैं हमेशा तेरा शुक्र करता रहूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}