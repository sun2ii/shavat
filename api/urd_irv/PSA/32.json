{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"मुबारक है वह जिसकी ख़ता बख़्शी गई,","poem":1},{"lineBreak":true},{"text":"और जिसका गुनाह ढाँका गया।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मुबारक है वह आदमी जिसकी बदकारी को ख़ुदावन्द हिसाब में नहीं लाता,","poem":1},{"lineBreak":true},{"text":"और जिसके दिल में दिखावा नहीं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जब मैं ख़ामोश रहा","poem":1},{"lineBreak":true},{"text":"तो दिन भर के कराहने से मेरी हड्डियाँ घुल गई।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि तेरा हाथ रात दिन मुझ पर भारी था;","poem":1},{"lineBreak":true},{"text":"मेरी तरावट गर्मियों की खु़श्की से बदल गई। सिलाह","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मैंने तेरे सामने अपने गुनाह को मान लिया और अपनी बदकारी को न छिपाया,","poem":1},{"lineBreak":true},{"text":"मैंने कहा, मैं ख़ुदावन्द के सामने अपनी ख़ताओं का इक़रार करूँगा","poem":1},{"lineBreak":true},{"text":"और तूने मेरे गुनाह की बुराई को मु'आफ़ किया। सिलाह","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"इसीलिए हर दीनदार तुझ से ऐसे वक़्त में दुआ करे जब तू मिल सकता है।","poem":1},{"lineBreak":true},{"text":"यक़ीनन जब सैलाब आए तो उस तक नहीं पहुँचेगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तू मेरे छिपने की जगह है; तू मुझे दुख से बचाये रख्खेगा;","poem":1},{"lineBreak":true},{"text":"तू मुझे रिहाई के नाग़मों से घेर लेगा। सिलाह","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैं तुझे ता'लीम दूँगा, और जिस राह पर तुझे चलना होगा तुझे बताऊँगा;","poem":1},{"lineBreak":true},{"text":"मैं तुझे सलाह दूँगा, मेरी नज़र तुझ पर होगी।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुम घोड़े या खच्चर की तरह न बनो जिनमें समझ नहीं,","poem":1},{"lineBreak":true},{"text":"जिनको क़ाबू में रखने का साज़ दहाना और लगाम है,","poem":1},{"lineBreak":true},{"text":"वर्ना वह तेरे पास आने के भी नहीं।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"शरीर पर बहुत सी मुसीबतें आएँगी;","poem":1},{"lineBreak":true},{"text":"पर जिसका भरोसा ख़ुदावन्द पर है,","poem":1},{"lineBreak":true},{"text":"रहमत उसे घेरे रहेगी।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ऐ सादिक़ो, ख़ुदावन्द में ख़ुश — ओ — बुर्रम रहो;","poem":1},{"lineBreak":true},{"text":"और ऐ रास्तदिलो, खु़शी से ललकारो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}