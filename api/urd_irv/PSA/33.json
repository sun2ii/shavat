{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ सादिक़ो, ख़ुदावन्द में ख़ुश रहो।","poem":1},{"lineBreak":true},{"text":"हम्द करना रास्तबाज़ों की ज़ेबा है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"सितार के साथ ख़ुदावन्द का शुक्र करो,","poem":1},{"lineBreak":true},{"text":"दस तार की बरबत के साथ उसकी सिताइश करो।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसके लिए नया गीत गाओ,","poem":1},{"lineBreak":true},{"text":"बुलन्द आवाज़ के साथ अच्छी तरह बजाओ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द का कलाम रास्त है;","poem":1},{"lineBreak":true},{"text":"और उसके सब काम बावफ़ा हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह सदाक़त और इन्साफ़ को पसंद करता है;","poem":1},{"lineBreak":true},{"text":"ज़मीन ख़ुदावन्द की शफ़क़त से मा'मूर है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"आसमान ख़ुदावन्द के कलाम से,","poem":1},{"lineBreak":true},{"text":"और उसका सारा लश्कर उसके मुँह के दम से बना।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह समन्दर का पानी तूदे की तरह जमा' करता है;","poem":1},{"lineBreak":true},{"text":"वह गहरे समन्दरों को मख़ज़नों में रखता है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"सारी ज़मीन ख़ुदावन्द से डरे,","poem":1},{"lineBreak":true},{"text":"जहान के सब बाशिन्दे उसका ख़ौफ़ रख्खें।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्यूँकि उसने फ़रमाया और हो गया;","poem":1},{"lineBreak":true},{"text":"उसने हुक्म दिया और वाके' हुआ।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द क़ौमों की मश्वरत को बेकार कर देता है;","poem":1},{"lineBreak":true},{"text":"वह उम्मतों के मन्सूबों को नाचीज़ बना देता है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की मसलहत हमेशा तक क़ाईम रहेगी,","poem":1},{"lineBreak":true},{"text":"और उसके दिल के ख़याल नसल दर नसल।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मुबारक है वह क़ौम जिसका ख़ुदा ख़ुदावन्द है,","poem":1},{"lineBreak":true},{"text":"और वह उम्मत जिसको उसने अपनी ही मीरास के लिए बरगुज़ीदा किया।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द आसमान पर से देखता है,","poem":1},{"lineBreak":true},{"text":"सब बनी आदम पर उसकी निगाह है।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"अपनी सुकूनत गाह से","poem":1},{"lineBreak":true},{"text":"वह ज़मीन के सब बाशिन्दों को देखता है।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"वही है जो उन सबके दिलों को बनाता,","poem":1},{"lineBreak":true},{"text":"और उनके सब कामों का ख़याल रखता है।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"किसी बादशाह को फ़ौज की कसरत न बचाएगी;","poem":1},{"lineBreak":true},{"text":"और किसी ज़बरदस्त आदमी को उसकी बड़ी ताक़त रिहाई न देगी।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"बच निकलने के लिए घोड़ा बेकार है,","poem":1},{"lineBreak":true},{"text":"वह अपनी शहज़ोरी से किसी को नबचाएगा।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"देखो ख़ुदावन्द की निगाह उन पर है जो उससे डरते हैं;","poem":1},{"lineBreak":true},{"text":"जो उसकी शफ़क़त के उम्मीदवार हैं,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ताकि उनकी जान मौत से बचाए,","poem":1},{"lineBreak":true},{"text":"और सूखे में उनको ज़िन्दा रख्खे।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"हमारी जान को ख़ुदावन्द की उम्मीद है;","poem":1},{"lineBreak":true},{"text":"वही हमारी मदद और हमारी ढाल है।","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"हमारा दिल उसमें ख़ुश रहेगा,","poem":1},{"lineBreak":true},{"text":"क्यूँकि हम ने उसके पाक नाम पर भरोसा किया है।","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, जैसी तुझ पर हमारी उम्मीद है,","poem":1},{"lineBreak":true},{"text":"वैसी ही तेरी रहमत हम पर हो।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}