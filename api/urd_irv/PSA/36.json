{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":[{"text":"शरीर की बदी से मेरे दिल में ख़याल आता है,","poem":1},{"lineBreak":true},{"text":"कि ख़ुदा का ख़ौफ़ उसके सामने नहीं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्यूँकि वह अपने आपको अपनी नज़र में इस ख़याल से तसल्ली देता है,","poem":1},{"lineBreak":true},{"text":"कि उसकी बदी न तो फ़ाश होगी, न मकरूह समझी जाएगी।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसके मुँह में बदी और फ़रेब की बातें हैं;","poem":1},{"lineBreak":true},{"text":"वह 'अक़्ल और नेकी से दस्तबरदार हो गया है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह अपने बिस्तर पर बदी के मन्सूबे बाँधता है;","poem":1},{"lineBreak":true},{"text":"वह ऐसी राह इख़्तियार करता है जो अच्छी नहीं;","poem":1},{"lineBreak":true},{"text":"वह बुराई से नफ़रत नहीं करता।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, आसमान में तेरी शफ़क़त है,","poem":1},{"lineBreak":true},{"text":"तेरी वफ़ादारी फ़लाक तक बुलन्द है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तेरी सदाक़त ख़ुदा के पहाड़ों की तरह है,","poem":1},{"lineBreak":true},{"text":"तेरे अहकाम बहुत गहरे हैं; ऐ ख़ुदावन्द,","poem":1},{"lineBreak":true},{"text":"तू इंसान और हैवान दोनों को महफ़ूज़ रखता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, तेरी शफ़क़त क्या ही बेशक़ीमत है!","poem":1},{"lineBreak":true},{"text":"बनी आदम तेरे बाज़ुओं के साये में पनाह लेते हैं।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह तेरे घर की ने'मतों से ख़ूब आसूदा होंगे,","poem":1},{"lineBreak":true},{"text":"तू उनको अपनी ख़ुशनूदी के दरिया में से पिलाएगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्यूँकि ज़िन्दगी का चश्मा तेरे पास है;","poem":1},{"lineBreak":true},{"text":"तेरे नूर की बदौलत हम रोशनी देखेंगे।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तेरे पहचानने वालों पर तेरी शफ़क़त हमेशा की हो,","poem":1},{"lineBreak":true},{"text":"और रास्त दिलों पर तेरी सदाकत!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मग़रूर आदमी मुझ पर लात न उठाने पाए,","poem":1},{"lineBreak":true},{"text":"और शरीर का हाथ मुझे हाँक न दे।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"बदकिरदार वहाँ गिरे पड़े हैं;","poem":1},{"lineBreak":true},{"text":"वह गिरा दिए गए हैं और फिर उठ न सकेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}