{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"जब मै पुकारूँ तो मुझे जबाब दे ऐ मेरी सदाक़त के ख़ुदा!","poem":1},{"lineBreak":true},{"text":"तंगी में तूने मुझे कुशादगी बख़्शी, मुझ पर रहम कर और मेरी दुआ सुन ले।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ बनी आदम! कब तक मेरी 'इज़्ज़त के बदले रुस्वाई होगी?","poem":1},{"lineBreak":true},{"text":"तुम कब तक बकवास से मुहब्बत रखोगे और झूट के दर पे रहोगे?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जान लो कि ख़ुदावन्द ने दीनदार को अपने लिए अलग कर रखा है;","poem":1},{"lineBreak":true},{"text":"जब मैं ख़ुदावन्द को पुकारूँगा तो वह सुन लेगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"थरथराओ और गुनाह न करो;","poem":1},{"lineBreak":true},{"text":"अपने अपने बिस्तर पर दिल में सोचो और ख़ामोश रहो।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"सदाक़त की कु़र्बानियाँ पेश करो,","poem":1},{"lineBreak":true},{"text":"और ख़ुदावन्द पर भरोसा करो।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"बहुत से कहते हैं कौन हम को कुछ भलाई दिखाएगा?","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द तू अपने चेहरे का नूर हम पर जलवह गर फ़रमा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तूने मेरे दिल को उससे ज़्यादा खु़शी बख़्शी है,","poem":1},{"lineBreak":true},{"text":"जो उनको ग़ल्ले और मय की बहुतायत से होती थी।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैं सलामती से लेट जाऊँगा और सो रहूँगाः क्यूँकि ऐ ख़ुदावन्द!","poem":1},{"lineBreak":true},{"text":"सिर्फ़ तू ही मुझे मुत्मईन रखता है!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}