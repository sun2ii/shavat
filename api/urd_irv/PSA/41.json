{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"मुबारक, है वह जो ग़रीब का ख़याल रखता है","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द मुसीबत के दिन उसे छुड़ाएगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द उसे महफू़ज़ और ज़िन्दा रख्खेगा,","poem":1},{"lineBreak":true},{"text":"और वह ज़मीन पर मुबारक होगा।","poem":1},{"lineBreak":true},{"text":"तू उसे उसके दुश्मनों की मर्ज़ी पर न छोड़।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द उसे बीमारी के बिस्तर पर संभालेगा;","poem":1},{"lineBreak":true},{"text":"तू उसकी बीमारी में उसके पूरे बिस्तर को ठीक करता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैंने कहा, “ऐ ख़ुदावन्द, मुझ पर रहम कर!","poem":1},{"lineBreak":true},{"text":"मेरी जान को शिफ़ा दे,","poem":1},{"lineBreak":true},{"text":"क्यूँकि मैं तेरा गुनहगार हूँ।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मेरे दुश्मन यह कहकर मेरी बुराई करते हैं,","poem":1},{"lineBreak":true},{"text":"कि वह कब मरेगा और उसका नाम कब मिटेगा?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जब वह मुझ से मिलने को आता है,","poem":1},{"lineBreak":true},{"text":"तो झूटी बातें बकता है;","poem":1},{"lineBreak":true},{"text":"उसका दिल अपने अन्दर बदी समेटता है;","poem":1},{"lineBreak":true},{"text":"वह बाहर जाकर उसी का ज़िक्र करता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मुझ से 'अदावत रखने वाले सब मिलकर मेरी ग़ीबत करते हैं;","poem":1},{"lineBreak":true},{"text":"वह मेरे ख़िलाफ़ मेरे नुक़सान के मन्सूबे बाँधते हैं।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह कहते हैं, “इसे तो बुरा रोग लग गया है;","poem":1},{"lineBreak":true},{"text":"अब जो वह पड़ा है तो फिर उठने का नहीं।”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"बल्कि मेरे दिली दोस्त ने जिस पर मुझे भरोसा था,","poem":1},{"lineBreak":true},{"text":"और जो मेरी रोटी खाता था, मुझ पर लात उठाई है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"लेकिन तू ऐ ख़ुदावन्द!","poem":1},{"lineBreak":true},{"text":"मुझ पर रहम करके मुझे उठा खड़ा कर,","poem":1},{"lineBreak":true},{"text":"ताकि मैं उनको बदला दूँ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"इससे मैं जान गया कि तू मुझ से ख़ुश है,","poem":1},{"lineBreak":true},{"text":"कि मेरा दुश्मन मुझ पर फ़तह नहीं पाता।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मुझे तो तू ही मेरी रास्ती में क़याम बख्शता है","poem":1},{"lineBreak":true},{"text":"और मुझे हमेशा अपने सामने क़ाईम रखता है।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द इस्राईल का ख़ुदा,","poem":1},{"lineBreak":true},{"text":"इब्तिदा से हमेशा तक मुबारक हो!","poem":1},{"lineBreak":true},{"text":"आमीन, सुम्म आमीन।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}