{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा, मेरा इन्साफ़ कर","poem":1},{"lineBreak":true},{"text":"और बेदीन क़ौम के मुक़ाबले में मेरी वकालत कर,","poem":1},{"lineBreak":true},{"text":"और दग़ाबाज़ और बेइन्साफ़ आदमी से मुझे छुड़ा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्यूँकि तू ही मेरी ताक़त का ख़ुदा है,","poem":1},{"lineBreak":true},{"text":"तूने क्यूँ मुझे छोड़ दिया?","poem":1},{"lineBreak":true},{"text":"मैं दुश्मन के ज़ुल्म की वजह से क्यूँ मातम करता फिरता हूँ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अपने नूर, अपनी सच्चाई को भेज,","poem":1},{"lineBreak":true},{"text":"वही मेरी रहबरी करें,","poem":1},{"lineBreak":true},{"text":"वही मुझ को तेरे पाक पहाड़ और तेरे घर तक पहुँचाए।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तब मैं ख़ुदा के मज़बह के पास जाऊँगा,","poem":1},{"lineBreak":true},{"text":"ख़ुदा के सामने जो मेरी कमाल ख़ुशी है;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदा! मेरे ख़ुदा! मैं सितार बजा कर तेरी सिताइश करूँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ मेरी जान! तू क्यूँ गिरी जाती है?","poem":1},{"lineBreak":true},{"text":"तू अन्दर ही अन्दर क्यूँ बेचैन है?","poem":1},{"lineBreak":true},{"text":"ख़ुदा से उम्मीद रख, क्यूँकि वह मेरे चेहरे की रौनक़ और मेरा ख़ुदा है;","poem":1},{"lineBreak":true},{"text":"मैं फिर उसकी सिताइश करूँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}