{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द हमारी पनाह और ताक़त है;","poem":1},{"lineBreak":true},{"text":"मुसीबत में मुस्त'इद मददगार।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"इसलिए हम को कुछ ख़ौफ़ नहीं चाहे ज़मीन उलट जाए,","poem":1},{"lineBreak":true},{"text":"और पहाड़ समुन्दर की तह में डाल दिए जाए","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"चाहे उसका पानी शोर मचाए और तूफ़ानी हो,","poem":1},{"lineBreak":true},{"text":"और पहाड़ उसकी लहरों से हिल जाएँ। सिलह","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"एक ऐसा दरिया है जिसकी शाख़ो से ख़ुदा के","poem":1},{"lineBreak":true},{"text":"शहर को या'नी हक़ ता'ला के पाक घर को फ़रहत होती है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदा उसमें है, उसे कभी जुम्बिश न होगी;","poem":1},{"lineBreak":true},{"text":"ख़ुदा सुबह सवेरे उसकी मदद करेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क़ौमे झुंझलाई, सल्तनतों ने जुम्बिश खाई;","poem":1},{"lineBreak":true},{"text":"वह बोल उठा, ज़मीन पिघल गई।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"लश्करों का ख़ुदावन्द हमारे साथ है;","poem":1},{"lineBreak":true},{"text":"या'क़ूब का ख़ुदा हमारी पनाह है सिलाह।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"आओ, ख़ुदावन्द के कामों को देखो,","poem":1},{"lineBreak":true},{"text":"कि उसने ज़मीन पर क्या क्या वीरानियाँ की हैं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"वह ज़मीन की इन्तिहा तक जंग बंद कराता है;","poem":1},{"lineBreak":true},{"text":"वह कमान को तोड़ता, और नेज़े के टुकड़े कर डालता है।","poem":1},{"lineBreak":true},{"text":"वह रथों को आग से जला देता है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“ख़ामोश हो जाओ, और जान लो कि मैं ख़ुदा हूँ।","poem":1},{"lineBreak":true},{"text":"मैं क़ौमों के बीच सरबुलंद हूँगा।","poem":1},{"lineBreak":true},{"text":"मैं सारी ज़मीन पर सरबुलंद हूँगा।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"लश्करों का ख़ुदावन्द हमारे साथ है;","poem":1},{"lineBreak":true},{"text":"या'क़ूब का ख़ुदा हमारी पनाह है। सिलाह","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}