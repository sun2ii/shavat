{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ सब उम्मतों, तालियाँ बजाओ!","poem":1},{"lineBreak":true},{"text":"ख़ुदा के लिए ख़ुशी की आवाज़ से ललकारो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द ता'ला बड़ा है,","poem":1},{"lineBreak":true},{"text":"वह पूरी ज़मीन का शहंशाह है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह उम्मतों को हमारे सामने पस्त करेगा,","poem":1},{"lineBreak":true},{"text":"और क़ौमें हमारे क़दमों तले हो जायेंगी।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह हमारे लिए हमारी मीरास को चुनेगा,","poem":1},{"lineBreak":true},{"text":"जो उसके महबूब या'क़ूब की हश्मत है। सिलाह","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदा ने बुलन्द आवाज़ के साथ,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द ने नरसिंगे की आवाज़ के साथ सु'ऊद फ़रमाया।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मदहसराई करो, ख़ुदा की मदहसराई करो!","poem":1},{"lineBreak":true},{"text":"मदहसराई करो, हमारे बादशाह की मदहसराई करो!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदा सारी ज़मीन का बादशाह है;","poem":1},{"lineBreak":true},{"text":"'अक़्ल से मदहसराई करो।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदा क़ौमों पर सल्तनत करता है;","poem":1},{"lineBreak":true},{"text":"ख़ुदा अपने पाक तख़्त पर बैठा है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"उम्मतों के सरदार इकट्ठे हुए हैं,","poem":1},{"lineBreak":true},{"text":"ताकि अब्रहाम के ख़ुदा की उम्मत बन जाएँ;","poem":1},{"lineBreak":true},{"text":"क्यूँकि ज़मीन की ढालें ख़ुदा की हैं,","poem":1},{"lineBreak":true},{"text":"वह बहुत बुलन्द है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}