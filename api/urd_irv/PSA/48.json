{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"हमारे ख़ुदा के शहर में,","poem":1},{"lineBreak":true},{"text":"अपने पाक पहाड़ पर ख़ुदावन्द बुज़ु़र्ग़","poem":1},{"lineBreak":true},{"text":"और बेहद सिताइश के लायक़ है!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"उत्तर की जानिब कोह — ए — सिय्यून,","poem":1},{"lineBreak":true},{"text":"जो बड़े बादशाह का शहर है,","poem":1},{"lineBreak":true},{"text":"वह बुलन्दी में खु़शनुमा और तमाम ज़मीन का फ़ख़्र है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसके महलों में ख़ुदा पनाह माना जाता है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि देखो, बादशाह इकट्ठे हुए,","poem":1},{"lineBreak":true},{"text":"वह मिलकर गुज़रे।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह देखकर दंग हो गए,","poem":1},{"lineBreak":true},{"text":"वह घबराकर भागे।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वहाँ कपकपी ने उनको आ दबाया,","poem":1},{"lineBreak":true},{"text":"और ऐसे दर्द ने जैसा पैदाइश का दर्द।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तू पूरबी हवा से तरसीस के","poem":1},{"lineBreak":true},{"text":"जहाज़ों को तोड़ डालता है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"लश्करों के ख़ुदावन्द के शहर में,","poem":1},{"lineBreak":true},{"text":"या'नी अपने ख़ुदा के शहर में,","poem":1},{"lineBreak":true},{"text":"जैसा हम ने सुना था वैसा ही हम ने देखा:","poem":1},{"lineBreak":true},{"text":"ख़ुदा उसे हमेशा बरक़रार रखेगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, तेरी हैकल के अन्दर हम ने","poem":1},{"lineBreak":true},{"text":"तेरी शफ़क़त पर ग़ौर किया है","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, जैसा तेरा नाम है","poem":1},{"lineBreak":true},{"text":"वैसी ही तेरी सिताइश ज़मीन की इन्तिहा तक है।","poem":1},{"lineBreak":true},{"text":"तेरा दहना हाथ सदाक़त से मा'मूर है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तेरे अहकाम की वजह से:कोह — ए — सिय्यून शादमान हो","poem":1},{"lineBreak":true},{"text":"यहूदाह की बेटियाँ ख़ुशी मनाए,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"सिय्यून के गिर्द फिरो","poem":1},{"lineBreak":true},{"text":"और उसका तवाफ़ करो उसके बुर्जों को गिनों,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"उसकी शहर पनाह को खू़ब देख लो,","poem":1},{"lineBreak":true},{"text":"उसके महलों पर ग़ौर करो;","poem":1},{"lineBreak":true},{"text":"ताकि तुम आने वाली नसल को उसकी ख़बर दे सको।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"क्यूँकि यही ख़ुदा हमेशा से हमेशा तक हमारा ख़ुदा है;","poem":1},{"lineBreak":true},{"text":"यही मौत तक हमारा रहनुमा रहेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}