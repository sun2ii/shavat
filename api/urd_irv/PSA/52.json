{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ज़बरदस्त, तू शरारत पर क्यूँ फ़ख़्र करता है?","poem":1},{"lineBreak":true},{"text":"ख़ुदा की शफ़क़त हमेशा की है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तेरी ज़बान महज़ शरारत ईजाद करती है;","poem":1},{"lineBreak":true},{"text":"ऐ दग़ाबाज़, वह तेज़ उस्तरे की तरह है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू बदी को नेकी से ज़्यादा पसंद करता है,","poem":1},{"lineBreak":true},{"text":"और झूट को सदाक़त की बात से।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ऐ दग़ाबाज़ ज़बान!","poem":1},{"lineBreak":true},{"text":"तू मुहलिक बातों को पसंद करती है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदा भी तुझे हमेशा के लिए हलाक कर डालेगा;","poem":1},{"lineBreak":true},{"text":"वह तुझे पकड़ कर तेरे ख़ेमे से निकाल फेंकेगा,","poem":1},{"lineBreak":true},{"text":"और ज़िन्दों की ज़मीन से तुझे उखाड़ डालेगा। सिलाह","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"सादिक़ भी इस बात को देख कर डर जाएँगे,","poem":1},{"lineBreak":true},{"text":"और उस पर हँसेंगे,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कि देखो, यह वही आदमी है जिसने ख़ुदा को अपनी पनाहगाह न बनाया,","poem":1},{"lineBreak":true},{"text":"बल्कि अपने माल की ज़यादती पर भरोसा किया,","poem":1},{"lineBreak":true},{"text":"और शरारत में पक्का हो गया।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"लेकिन मैं तो ख़ुदा के घर में जैतून के हरे दरख़्त की तरह हूँ।","poem":1},{"lineBreak":true},{"text":"मेरा भरोसा हमेशा से हमेशा तक ख़ुदा की शफ़क़त पर है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मैं हमेशा तेरी शुक्रगुज़ारी करता रहूँगा,","poem":1},{"lineBreak":true},{"text":"क्यूँकि तू ही ने यह किया है;","poem":1},{"lineBreak":true},{"text":"और मुझे तेरे ही नाम की आस होगी,","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह तेरे पाक लोगों के नज़दीक खू़ब है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}