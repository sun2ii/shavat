{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"बेवकू़फ़ ने अपने दिल में कहा है,","poem":1},{"lineBreak":true},{"text":"कि कोई ख़ुदा नहीं। वह बिगड़ गये उन्होंने नफ़रत अंगेज़ बदी की है।","poem":1},{"lineBreak":true},{"text":"कोई नेकोकार नहीं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदा ने आसमान पर से बनी आदम पर निगाह की","poem":1},{"lineBreak":true},{"text":"ताकि देखे कि कोई दानिशमंद,","poem":1},{"lineBreak":true},{"text":"कोई ख़ुदा का तालिब है या नहीं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह सब के सब फिर गए हैं,","poem":1},{"lineBreak":true},{"text":"वह एक साथ नापाक हो गए;","poem":1},{"lineBreak":true},{"text":"कोई नेकोकार नहीं, एक भी नहीं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्या उन सब बदकिरदारों को कुछ 'इल्म नहीं,","poem":1},{"lineBreak":true},{"text":"जो मेरे लोगों को ऐसे खाते हैं जैसे रोटी,","poem":1},{"lineBreak":true},{"text":"और ख़ुदा का नाम नहीं लेते?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वहाँ उन पर बड़ा ख़ौफ़ छा गया जबकि ख़ौफ़ की कोई बात न थी।","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदा ने उनकी हड्डियाँ जो तेरे ख़िलाफ़ खै़माज़न थे,","poem":1},{"lineBreak":true},{"text":"बिखेर दीं। तूने उनको शर्मिन्दा कर दिया,","poem":1},{"lineBreak":true},{"text":"इसलिए कि ख़ुदा ने उनको रद्द कर दिया है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"काश कि इस्राईल की नजात सिय्यून में से होती!","poem":1},{"lineBreak":true},{"text":"जब ख़ुदा अपने लोगों को ग़ुलामी से लौटा लाएगा;","poem":1},{"lineBreak":true},{"text":"तो या'कू़ब ख़ुश और इस्राईल शादमान होगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}