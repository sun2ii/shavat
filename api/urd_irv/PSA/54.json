{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा! अपने नाम के वसीले से मुझे बचा,","poem":1},{"lineBreak":true},{"text":"और अपनी कु़दरत से मेरा इन्साफ़ कर।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा मेरी दुआ सुन ले;","poem":1},{"lineBreak":true},{"text":"मेरे मुँह की बातों पर कान लगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि बेगाने मेरे ख़िलाफ़ उठे हैं,","poem":1},{"lineBreak":true},{"text":"और टेढ़े लोग मेरी जान के तलबगार हुए हैं;","poem":1},{"lineBreak":true},{"text":"उन्होंने ख़ुदा को अपने सामने नहीं रख्खा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"देखो, ख़ुदा मेरा मददगार है!","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द मेरी जान को संभालने वालों में है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह बुराई को मेरे दुश्मनों ही पर लौटा देगा;","poem":1},{"lineBreak":true},{"text":"तू अपनी सच्चाई की रूह से उनको फ़ना कर!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैं तेरे सामने रज़ा की कु़र्बानी चढ़ाऊँगा;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! मैं तेरे नाम की शुक्रगु़ज़ारी करूँगा","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह खू़ब है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्यूँकि उसने मुझे सब मुसीबतों से छुड़ाया है,","poem":1},{"lineBreak":true},{"text":"और मेरी आँख ने मेरे दुश्मनों को देख लिया है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}