{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा! मुझ पर रहम फ़रमा,","poem":1},{"lineBreak":true},{"text":"क्यूँकि इंसान मुझे निगलना चाहता है;","poem":1},{"lineBreak":true},{"text":"वह दिन भर लड़कर मुझे सताता है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मेरे दुश्मन दिन भर मुझे निगलना चाहते हैं,","poem":1},{"lineBreak":true},{"text":"क्यूँकि जो गु़रूर करके मुझ से लड़ते हैं, वह बहुत हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जिस वक़्त मुझे डर लगेगा,","poem":1},{"lineBreak":true},{"text":"मैं तुझ पर भरोसा करूँगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मेरा फ़ख़्र ख़ुदा पर और उसके कलाम पर है।","poem":1},{"lineBreak":true},{"text":"मेरा भरोसा ख़ुदा पर है,","poem":1},{"lineBreak":true},{"text":"मैं डरने का नहीं:बशर मेरा क्या कर सकता है?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह दिन भर मेरी बातों को मरोड़ते रहते हैं;","poem":1},{"lineBreak":true},{"text":"उनके ख़याल सरासर यही हैं, कि मुझ से बदी करें।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह इकठ्ठे होकर छिप जाते हैं;","poem":1},{"lineBreak":true},{"text":"वह मेरे नक्श — ए — क़दम को देखते भालते हैं,","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह मेरी जान की घात में हैं।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्या वह बदकारी करके बच जाएँगे?","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदा, क़हर में उम्मतों को गिरा दे!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तू मेरी आवारगी का हिसाब रखता है;","poem":1},{"lineBreak":true},{"text":"मेरे आँसुओं को अपने मश्कीज़े में रख ले।","poem":1},{"lineBreak":true},{"text":"क्या वह तेरी किताब में लिखे नहीं हैं?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तब तो जिस दिन मैं फ़रियाद करूँगा,","poem":1},{"lineBreak":true},{"text":"मेरे दुश्मन पस्पा होंगे।","poem":1},{"lineBreak":true},{"text":"मुझे यह मा'लूम है कि ख़ुदा मेरी तरफ़ है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मेरा फ़ख़्र ख़ुदा पर और उसके कलाम पर है;","poem":1},{"lineBreak":true},{"text":"मेरा फ़ख़्र ख़ुदावन्द पर और उसके कलाम पर है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मेरा भरोसा ख़ुदा पर है, मैं डरने का नहीं।","poem":1},{"lineBreak":true},{"text":"इंसान मेरा क्या कर सकता है?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! तेरी मन्नतें मुझ पर हैं;","poem":1},{"lineBreak":true},{"text":"मैं तेरे हुजू़र शुक्रगुज़ारी की कु़र्बानियाँ पेश करूँगा।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"क्यूँकि तूने मेरी जान को मौत से छुड़ाया;","poem":1},{"lineBreak":true},{"text":"क्या तूने मेरे पाँव को फिसलने से नहीं बचाया,","poem":1},{"lineBreak":true},{"text":"ताकि मैं ख़ुदा के सामने ज़िन्दों के नूर में चलूँ?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}