{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"मुझ पर रहम कर, ऐ ख़ुदा! मुझ पर रहम कर,","poem":1},{"lineBreak":true},{"text":"क्यूँकि मेरी जान तेरी पनाह लेती है।","poem":1},{"lineBreak":true},{"text":"मैं तेरे परों के साये में पनाह लूँगा,","poem":1},{"lineBreak":true},{"text":"जब तक यह आफ़तें गुज़र न जाएँ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं ख़ुदा ता'ला से फ़रियाद करूँगा;","poem":1},{"lineBreak":true},{"text":"ख़ुदा से, जो मेरे लिए सब कुछ करता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह मेरी नजात के लिए आसमान से भेजेगा;","poem":1},{"lineBreak":true},{"text":"जब वह जो मुझे निगलना चाहता है,","poem":1},{"lineBreak":true},{"text":"मलामत करता हो। सिलाह ख़ुदा अपनी शफ़क़त","poem":1},{"lineBreak":true},{"text":"और सच्चाई को भेजेगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मेरी जान बबरों के बीच है,","poem":1},{"lineBreak":true},{"text":"मैं आतिश मिज़ाज लोगों में पड़ा हूँ","poem":1},{"lineBreak":true},{"text":"या'नी ऐसे लोगों में जिनके दाँत बर्छियाँऔर तीर हैं,","poem":1},{"lineBreak":true},{"text":"जिनकी ज़बान तेज़ तलवार है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! तू आसमान पर सरफ़राज़ हो,","poem":1},{"lineBreak":true},{"text":"तेरा जलाल सारी ज़मीन पर हो!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उन्होंने मेरे पाँव के लिए जाल लगाया है;","poem":1},{"lineBreak":true},{"text":"मेरी जान 'आजिज़ आ गई।","poem":1},{"lineBreak":true},{"text":"उन्होंने मेरे आगे गढ़ा खोदा,","poem":1},{"lineBreak":true},{"text":"वह ख़ुद उसमें गिर पड़े। सिलाह","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मेरा दिल क़ाईम है, ऐ ख़ुदा! मेरा दिल क़ाईम है;","poem":1},{"lineBreak":true},{"text":"मैं गाऊँगा बल्कि मैं मदह सराई करूँगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ मेरी शौकत, बेदार हो! ऐ बर्बत और सितार जागो!","poem":1},{"lineBreak":true},{"text":"मैं ख़ुद सुबह सवेरे जाग उठूँगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! मैं लोगों में तेरा शुक्र करूँगा।","poem":1},{"lineBreak":true},{"text":"मैं उम्मतों में तेरी मदहसराई करूँगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"क्यूँकि तेरी शफ़क़त आसमान के,","poem":1},{"lineBreak":true},{"text":"और तेरी सच्चाई फ़लाक के बराबर बुलन्द है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! तू आसमान पर सरफ़राज़ हो!","poem":1},{"lineBreak":true},{"text":"तेरा जलाल सारी ज़मीन पर हो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}