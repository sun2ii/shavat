{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ बुज़ुर्गों! क्या तुम दर हक़ीक़त रास्तगोई करते हो?","poem":1},{"lineBreak":true},{"text":"ऐ बनी आदम! क्या तुम ठीक 'अदालत करते हो?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"बल्कि तुम तो दिल ही दिल में शरारत करते हो;","poem":1},{"lineBreak":true},{"text":"और ज़मीन पर अपने हाथों से जु़ल्म पैमाई करते हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"शरीर पैदाइश ही से कजरवी इख़्तियार करते हैं;","poem":1},{"lineBreak":true},{"text":"वह पैदा होते ही झूट बोलकर गुमराह हो जाते हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उनका ज़हर साँप का सा ज़हर है;","poem":1},{"lineBreak":true},{"text":"वह बहरे अज़दहे की तरह हैं जो कान बंद कर लेता है;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जो मन्तर पढ़ने वालों की आवाज़ ही नहीं सुनता,","poem":1},{"lineBreak":true},{"text":"जो चाहे वह कितनी ही होशियारी से मन्तर पढ़ें।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! तू उनके दाँत उनके मुँह में तोड़ दे,","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! बबर के बच्चों की दाढ़ें तोड़ डाल।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह घुलकर बहते पानी की तरह हो जाएँ जब वह अपने तीर चलाए,","poem":1},{"lineBreak":true},{"text":"तो वह जैसे कुन्द पैकान हों।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वह ऐसे हो जाएँ जैसे घोंघा, जो गल कर फ़ना हो जाता है;","poem":1},{"lineBreak":true},{"text":"और जैसे 'औरत का इस्कात जिसने सूरज को देखा ही नहीं।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"इससे पहले कि तुम्हारी हड्डियों को काँटों की आंच लगे","poem":1},{"lineBreak":true},{"text":"वह हरे और जलते दोनों को यकसाँ बगोले से उड़ा ले जाएगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"सादिक़ इन्तक़ाम को देखकर खु़श होगा;","poem":1},{"lineBreak":true},{"text":"वह शरीर के खू़न से अपने पाँव तर करेगा।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तब लोग कहेंगे, यक़ीनन सादिक़ के लिए अज्र है;","poem":1},{"lineBreak":true},{"text":"बेशक ख़ुदा है, जो ज़मीन पर 'अदालत करता है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}