{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा तू मुझे अपने क़हर में न झिड़क,","poem":1},{"lineBreak":true},{"text":"और अपने ग़ज़बनाक ग़ुस्से में मुझे तम्बीह न दे।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, मुझ पर रहम कर, क्यूँकि मैं अधमरा हो गया हूँ।","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदवन्द, मुझे शिफ़ा दे, क्यूँकि मेरी हडिडयों में बेक़रारी है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मेरी जान भी बहुत ही बेक़रार है;","poem":1},{"lineBreak":true},{"text":"और तू ऐ ख़ुदावन्द, कब तक?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"लौट ऐ ख़ुदावन्द, मेरी जान को छुड़ा।","poem":1},{"lineBreak":true},{"text":"अपनी शफ़क़त की ख़ातिर मुझे बचा ले।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि मौत के बाद तेरी याद नहीं होती,","poem":1},{"lineBreak":true},{"text":"क़ब्र में कौन तेरी शुक्रगुज़ारी करेगा?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैं कराहते कराहते थक गया,","poem":1},{"lineBreak":true},{"text":"मैं अपना पलंग आँसुओं से भिगोता हूँ हर रात मेरा बिस्तर तैरता है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मेरी आँख ग़म के मारे बैठी जाती हैं,","poem":1},{"lineBreak":true},{"text":"और मेरे सब मुख़ालिफ़ों की वजह से धुंधलाने लगीं।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ सब बदकिरदारो, मेरे पास से दूर हो;","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द ने मेरे रोने की आवाज़ सुन ली है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"खूदावन्द ने मेरी मिन्नत सुन ली;","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द मेरी दुआ क़ुबूल करेगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मेरे सब दुश्मन शर्मिन्दा और बहुत ही बेक़रार होंगे;","poem":1},{"lineBreak":true},{"text":"वह लौट जाएँगे, वह अचानक शर्मिन्दा होंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}