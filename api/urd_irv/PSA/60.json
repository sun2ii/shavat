{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा, तूने हमें रद्द किया;","poem":1},{"lineBreak":true},{"text":"तूने हमें शिकस्ता हाल कर दिया।","poem":1},{"lineBreak":true},{"text":"तू नाराज़ रहा है। हमें फिर बहाल कर।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तूने ज़मीन को लरज़ा दिया;","poem":1},{"lineBreak":true},{"text":"तूने उसे फाड़ डाला है।","poem":1},{"lineBreak":true},{"text":"उसके रख़्ने बन्द कर दे क्यूँकि वह लरज़ाँ है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तूने अपने लोगों को सख़्तियाँ दिखाई,","poem":1},{"lineBreak":true},{"text":"तूने हमको लड़खड़ा देने वाली मय पिलाई।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जो तुझ से डरते हैं, तूने उनको एक झंडा दिया है;","poem":1},{"lineBreak":true},{"text":"ताकि वह हक़ की ख़ातिर बुलन्द किया जाएं। सिलाह","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"अपने दहने हाथ से बचा और हमें जवाब दे,","poem":1},{"lineBreak":true},{"text":"ताकि तेरे महबूब बचाए जाएँ।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ख़ुदा ने अपनी पाकीज़गी में फ़रमाया है, “मैं ख़ुशी करूँगा;","poem":1},{"lineBreak":true},{"text":"मैं सिकम को तक़सीम करूँगा, और सुकात की वादी को बाटूँगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जिल'आद मेरा है, मनस्सी भी मेरा है;","poem":1},{"lineBreak":true},{"text":"इफ़्राईम मेरे सिर का खू़द है,","poem":1},{"lineBreak":true},{"text":"यहूदाह मेरा 'असा है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मोआब मेरी चिलमची है,","poem":1},{"lineBreak":true},{"text":"अदोम पर मैं जूता फेफूँगा;","poem":1},{"lineBreak":true},{"text":"ऐ फ़िलिस्तीन, मेरी वजह से ललकार।”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मुझे उस मुहकम शहर में कौन पहुँचाएगा?","poem":1},{"lineBreak":true},{"text":"कौन मुझे अदोम तक ले गया है?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, क्या तूने हमें रद्द नहीं कर दिया?","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदा, तू हमारे लश्करों के साथ नहीं जाता।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मुख़ालिफ़ के मुक़ाबले में हमारी मदद कर,","poem":1},{"lineBreak":true},{"text":"क्यूँकि इंसानी मदद बेकार है।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ख़ुदा की मदद से हम बहादुरी करेंगे,","poem":1},{"lineBreak":true},{"text":"क्यूँकि वही हमारे मुख़ालिफ़ों को पस्त करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}