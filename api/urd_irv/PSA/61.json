{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा, मेरी फ़रियाद सुन!","poem":1},{"lineBreak":true},{"text":"मेरी दुआ पर तवज्जुह कर।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं अपनी अफ़सुर्दा दिली में ज़मीन की इन्तिहा से तुझे पुकारूँगा;","poem":1},{"lineBreak":true},{"text":"तू मुझे उस चट्टान पर ले चल जो मुझसे ऊँची है;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि तू मेरी पनाह रहा है,","poem":1},{"lineBreak":true},{"text":"और दुश्मन से बचने के लिए ऊँचा बुर्ज।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैं हमेशा तेरे खे़मे में रहूँगा।","poem":1},{"lineBreak":true},{"text":"मैं तेरे परों के साये में पनाह लूँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि ऐ ख़ुदा तूने मेरी मिन्नतें क़ुबूल की हैं","poem":1},{"lineBreak":true},{"text":"तूने मुझे उन लोगों की सी मीरास बख़्शी है जो तेरे नाम से डरते हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तू बादशाह की उम्र दराज़ करेगा;","poem":1},{"lineBreak":true},{"text":"उसकी उम्र बहुत सी नसलों के बराबर होगी।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वह ख़ुदा के सामने हमेशा क़ाईम रहेगा;","poem":1},{"lineBreak":true},{"text":"तू शफ़क़त और सच्चाई को उसकी हिफ़ाज़त के लिए मुहय्या कर।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"यूँ मैं हमेशा तेरी मदहसराई करूँगा,","poem":1},{"lineBreak":true},{"text":"ताकि रोज़ाना अपनी मिन्नतें पूरी करूँ।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}