{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"मेरी जान को ख़ुदा ही की उम्मीद है,","poem":1},{"lineBreak":true},{"text":"मेरी नजात उसी से है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वही अकेला मेरी चट्टान और मेरी नजात है,","poem":1},{"lineBreak":true},{"text":"वही मेरा ऊँचा बुर्ज है, मुझे ज़्यादा जुम्बिश न होगी।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तुम कब तक ऐसे शख़्स पर हमला करते रहोगे,","poem":1},{"lineBreak":true},{"text":"जो झुकी हुई दीवार और हिलती बाड़ की तरह है;","poem":1},{"lineBreak":true},{"text":"ताकि सब मिलकर उसे क़त्ल करो?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह उसको उसके मर्तबे से गिरा देने ही का मश्वरा करते रहते हैं;","poem":1},{"lineBreak":true},{"text":"वह झूट से ख़ुश होते हैं।","poem":1},{"lineBreak":true},{"text":"वह अपने मुँह से तो बरकत देते हैं लेकिन दिल में ला'नत करते हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ मेरी जान, ख़ुदा ही की आस रख,","poem":1},{"lineBreak":true},{"text":"क्यूँकि उसी से मुझे उम्मीद है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वही अकेला मेरी चट्टान और मेरी नजात है;","poem":1},{"lineBreak":true},{"text":"वही मेरा ऊँचा बुर्ज है, मुझे जुम्बिश न होगी।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मेरी नजात और मेरी शौकत ख़ुदा की तरफ़ से है;","poem":1},{"lineBreak":true},{"text":"ख़ुदा ही मेरी ताक़त की चट्टान और मेरी पनाह है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ लोगो। हर वक़्त उस पर भरोसा करो;","poem":1},{"lineBreak":true},{"text":"अपने दिल का हाल उसके सामने खोल दो।","poem":1},{"lineBreak":true},{"text":"ख़ुदा हमारी पनाहगाह है। सिलाह","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"यक़ीनन अदना लोग बेसबात हैं","poem":1},{"lineBreak":true},{"text":"और आला आदमी झूटे; वह तराजू़ में हल्के निकलेंगे;","poem":1},{"lineBreak":true},{"text":"वह सब के सब बेसबाती से भी कमज़ोर हैं","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जु़ल्म पर तकिया न करो,","poem":1},{"lineBreak":true},{"text":"लूटमार करने पर न फूलो;","poem":1},{"lineBreak":true},{"text":"अगर माल बढ़ जाए तो उस पर दिल न लगाओ।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ख़ुदा ने एक बार फ़रमाया;","poem":1},{"lineBreak":true},{"text":"मैंने यह दो बार सुना,","poem":1},{"lineBreak":true},{"text":"कि कु़दरत ख़ुदा ही की है।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"शफ़क़त भी ऐ ख़ुदावन्द तेरी ही है;","poem":1},{"lineBreak":true},{"text":"क्यूँकि तू हर शख़्स को उसके 'अमल के मुताबिक़ बदला देता है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}