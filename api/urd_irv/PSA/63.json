{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा, तू मेरा ख़ुदा है,","poem":1},{"lineBreak":true},{"text":"मै दिल से तेरा तालिब हूँगा;","poem":1},{"lineBreak":true},{"text":"ख़ुश्क और प्यासी ज़मीन में जहाँ पानी नहीं,","poem":1},{"lineBreak":true},{"text":"मेरी जान तेरी प्यासी और मेरा जिस्म तेरा मुशताक़ है","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"इस तरह मैंने मक़दिस में तुझ पर निगाह की","poem":1},{"lineBreak":true},{"text":"ताकि तेरी कु़दरत और हश्मत को देखूँ।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि तेरी शफ़क़त ज़िन्दगी से बेहतर है","poem":1},{"lineBreak":true},{"text":"मेरे होंट तेरी ता'रीफ़ करेंगे।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"इसी तरह मैं उम्र भर तुझे मुबारक कहूँगा;","poem":1},{"lineBreak":true},{"text":"और तेरा नाम लेकर अपने हाथ उठाया करूँगा;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मेरी जान जैसे गूदे और चर्बी से सेर होगी,","poem":1},{"lineBreak":true},{"text":"और मेरा मुँह मसरूर लबों से तेरी ता'रीफ़ करेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जब मैं बिस्तर पर तुझे याद करूँगा,","poem":1},{"lineBreak":true},{"text":"और रात के एक एक पहर में तुझ पर ध्यान करूँगा;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"इसलिए कि तू मेरा मददगार रहा है,","poem":1},{"lineBreak":true},{"text":"और मैं तेरे परों के साये में ख़ुशी मनाऊँगा।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मेरी जान को तेरी ही धुन है;","poem":1},{"lineBreak":true},{"text":"तेरा दहना हाथ मुझे संभालता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"लेकिन जो मेरी जान की हलाकत के दर पै हैं,","poem":1},{"lineBreak":true},{"text":"वह ज़मीन के तह में चले जाएँगे।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"वह तलवार के हवाले होंगे,","poem":1},{"lineBreak":true},{"text":"वह गीदड़ों का लुक्मा बनेंगे।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"लेकिन बादशाह खु़दा में ख़ुश होगा;","poem":1},{"lineBreak":true},{"text":"जो उसकी क़सम खाता है वह फ़ख़्र करेगा;","poem":1},{"lineBreak":true},{"text":"क्यूँकि झूट बोलने वालों का मुँह बन्द कर दिया जाएगा","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}