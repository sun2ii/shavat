{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा मेरी फ़रियाद की आवाज़ सुन ले मेरी जान को","poem":1},{"lineBreak":true},{"text":"दुश्मन के ख़ौफ़ से बचाए रख।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"शरीरों के ख़ुफ़िया मश्वरे से,","poem":1},{"lineBreak":true},{"text":"और बदकिरदारों के हँगामे से मुझे छिपा ले","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जिन्होंने अपनी ज़बान तलवार की तरह तेज़ की,","poem":1},{"lineBreak":true},{"text":"और तल्ख़ बातों के तीरों का निशाना लिया है;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ताकि उनको ख़ुफ़िया मक़ामों में कामिल आदमी पर चलाएँ;","poem":1},{"lineBreak":true},{"text":"वह उनको अचानक उस पर चलाते हैं और डरते नहीं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह बुरे काम का मज़बूत इरादा करते हैं;","poem":1},{"lineBreak":true},{"text":"वह फंदे लगाने की सलाह करते हैं,","poem":1},{"lineBreak":true},{"text":"वह कहते हैं, “हम को कौन देखेगा?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह शरारतों को खोज खोज कर निकालते हैं;","poem":1},{"lineBreak":true},{"text":"वह कहते हैं, “हमने खू़ब खोज लगाया।”","poem":1},{"lineBreak":true},{"text":"उनमें से हर एक का बातिन और दिल 'अमीक है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"लेकिन ख़ुदा उन पर तीर चलाएगा;","poem":1},{"lineBreak":true},{"text":"वह अचानक तीर से ज़ख़्मी हो जाएँगे।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"और उन ही की ज़बान उनको तबाह करेगी;","poem":1},{"lineBreak":true},{"text":"जितने उनको देखेंगे सब सिर हिलाएँगे।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"और सब लोग डर जाएँगे,","poem":1},{"lineBreak":true},{"text":"और ख़ुदा के काम का बयान करेंगे;","poem":1},{"lineBreak":true},{"text":"और उसके तरीक़ — ए — 'अमल को बख़ूबी समझ लेंगे।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"सादिक़ ख़ुदावन्द में ख़ुश होगा,","poem":1},{"lineBreak":true},{"text":"और उस पर भरोसा करेगा,","poem":1},{"lineBreak":true},{"text":"और जितने रास्तदिल हैं सब फ़ख़्र करेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}