{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदा हम पर रहम करे और हम को बरक़त बख़्शे;","poem":1},{"lineBreak":true},{"text":"और अपने चेहरे को हम पर जलवागर फ़रमाए, सिलाह","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ताकि तेरी राह ज़मीन पर ज़ाहिर हो जाए,","poem":1},{"lineBreak":true},{"text":"और तेरी नजात सब क़ौमों पर।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! लोग तेरी ता'रीफ़ करें;","poem":1},{"lineBreak":true},{"text":"सब लोग तेरी ता'रीफ़ करें।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उम्मते ख़ुश हों और ख़ुशी से ललकारें,","poem":1},{"lineBreak":true},{"text":"क्यूँकि तू रास्ती से लोगों की 'अदालत करेगा,","poem":1},{"lineBreak":true},{"text":"और ज़मीन की उम्मतों पर हुकूमत करेगा सिलाह","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! लोग तेरी ता'रीफ़ करें;","poem":1},{"lineBreak":true},{"text":"सब लोग तेरी ता'रीफ़ करें।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ज़मीन ने अपनी पैदावार दे दी,","poem":1},{"lineBreak":true},{"text":"ख़ुदा या'नी हमारा ख़ुदा हम को बरकत देगा।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ख़ुदा हम को बरकत देगा;","poem":1},{"lineBreak":true},{"text":"और ज़मीन की इन्तिहा तक सब लोग उसका डर मानेंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}