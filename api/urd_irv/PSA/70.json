{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा! मुझे छुड़ाने के लिए, ऐ ख़ुदावन्द, मेरी मदद के लिए कर जल्दी कर!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जो मेरी जान को हलाक करने के दर पै हैं,","poem":1},{"lineBreak":true},{"text":"वह सब शर्मिन्दा और रुस्वा हों।","poem":1},{"lineBreak":true},{"text":"जो मेरे नुक़्सान से ख़ुश हैं,","poem":1},{"lineBreak":true},{"text":"वह पस्पा और रुस्वा हों।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अहा! हा! हा!","poem":1},{"lineBreak":true},{"text":"करने वाले अपनी रुस्वाई के वजह से पस्पा हों।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तेरे सब तालिब तुझ में ख़ुश — ओ — ख़ुर्रम हों;","poem":1},{"lineBreak":true},{"text":"तेरी नजात के 'आशिक़ हमेशा कहा करें, “ख़ुदा की तम्जीद हो!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"लेकिन मैं ग़रीब और मोहताज हूँ; ऐ ख़ुदा,","poem":1},{"lineBreak":true},{"text":"मेरे पास जल्द आ!","poem":1},{"lineBreak":true},{"text":"मेरा मददगार और छुड़ाने वाला तू ही है;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, देर न कर!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}