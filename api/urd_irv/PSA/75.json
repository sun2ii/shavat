{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा, हम तेरा शुक्र करते हैं, हम तेरा शुक्र करते हैं;","poem":1},{"lineBreak":true},{"text":"क्यूँकि तेरा नाम नज़दीक है, लोग तेरे 'अजीब कामों का ज़िक्र करते हैं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जब मेरा मु'अय्यन वक़्त आएगा,","poem":1},{"lineBreak":true},{"text":"तो मैं रास्ती से 'अदालत करूँगा।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ज़मीन और उसके सब बाशिन्दे गुदाज़ हो गए हैं,","poem":1},{"lineBreak":true},{"text":"मैंने उसके सुतूनों को क़ाईम कर दिया।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैंने मग़रूरों से कहा, गु़रूर न करो,","poem":1},{"lineBreak":true},{"text":"और शरीरों से, कि सींग ऊँचा न करो।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"अपना सींग ऊँचा न करो,","poem":1},{"lineBreak":true},{"text":"बग़ावत से बात न करो।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क्यूँकि सरफ़राज़ी न तो पूरब से न पश्चिम से,","poem":1},{"lineBreak":true},{"text":"और न दख्खिन से आती है;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"बल्कि ख़ुदा ही 'अदालत करने वाला है;","poem":1},{"lineBreak":true},{"text":"वह किसी को पस्त करता है और किसी को सरफ़राज़ी बख़्शता है।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द के हाथ में प्याला है, और मय झाग वाली है;","poem":1},{"lineBreak":true},{"text":"वह मिली हुई शराब से भरा है, और ख़ुदावन्द उसी में से उंडेलता है;","poem":1},{"lineBreak":true},{"text":"बेशक उसकी तलछट ज़मीन के सब शरीर निचोड़ निचोड़ कर पिएँगे।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"लेकिन मैं तो हमेशा ज़िक्र करता रहूँगा,","poem":1},{"lineBreak":true},{"text":"मैं या'क़ूब के ख़ुदा की मदहसराई करूँगा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"और मैं शरीरों के सब सींग काट डालूँगा","poem":1},{"lineBreak":true},{"text":"लेकिन सादिकों के सींग ऊँचे किए जाएंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}