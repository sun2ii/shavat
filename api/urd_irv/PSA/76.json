{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदा यहूदाह में मशहूर है,","poem":1},{"lineBreak":true},{"text":"उसका नाम इस्राईल में बुजु़र्ग है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"सालिम में उसका खे़मा है,","poem":1},{"lineBreak":true},{"text":"और सिय्यून में उसका घर।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वहाँ उसने बर्क़ — ए — कमान की और ढाल और तलवार,","poem":1},{"lineBreak":true},{"text":"और सामान — ए — जंग को तोड़ डाला।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू जलाली है, और शिकार के पहाड़ों से शानदार है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मज़बूत दिल लुट गए, वह गहरी नींद में पड़े हैं,","poem":1},{"lineBreak":true},{"text":"और ज़बरदस्त लोगों में से किसी का हाथ काम न आया।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ऐ या'क़ूब के ख़ुदा, तेरी झिड़की से,","poem":1},{"lineBreak":true},{"text":"रथ और घोड़े दोनों पर मौत की नींद तारी है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"सिर्फ़ तुझ ही से डरना चाहिए;","poem":1},{"lineBreak":true},{"text":"और तेरे क़हर के वक़्त कौन तेरे सामने खड़ा रह सकता है?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तूने आसमान पर से फ़ैसला सुनाया;","poem":1},{"lineBreak":true},{"text":"ज़मीन डर कर चुप हो गई।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जब ख़ुदा 'अदालत करने को उठा,","poem":1},{"lineBreak":true},{"text":"ताकि ज़मीन के सब हलीमों को बचा ले। सिलाह","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"बेशक इंसान का ग़ज़ब तेरी सिताइश का ज़रिए' होगा,","poem":1},{"lineBreak":true},{"text":"और तू ग़ज़ब के बक़िये से कमरबस्ता होगा।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द अपने ख़ुदा के लिए मन्नत मानो, और पूरी करो,","poem":1},{"lineBreak":true},{"text":"और सब जो उसके गिर्द हैं वह उसी के लिए जिससे डरना वाजिब है, हदिए लाएँ।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"वह हाकिम की रूह को क़ब्ज़ करेगा;","poem":1},{"lineBreak":true},{"text":"वह ज़मीन के बादशाहों के लिए बड़ा है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}