{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"verse","number":1,"content":[{"text":"मैं बुलन्द आवाज़ से ख़ुदा के सामने फ़रियाद करूँगा ख़ुदा ही के सामने बुलन्द आवाज़ से,","poem":1},{"lineBreak":true},{"text":"और वह मेरी तरफ़ कान लगाएगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"अपनी मुसीबत के दिन मैंने ख़ुदावन्द को ढूँढा,","poem":1},{"lineBreak":true},{"text":"मेरे हाथ रात को फैले रहे और ढीले न हुए;","poem":1},{"lineBreak":true},{"text":"मेरी जान को तस्कीन न हुई।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मैं ख़ुदा को याद करता हूँ","poem":1},{"lineBreak":true},{"text":"और बेचैन हूँ मैं वावैला करता हूँ और मेरी जान निढाल है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू मेरी आँखें खुली रखता है;","poem":1},{"lineBreak":true},{"text":"मैं ऐसा बेताब हूँ कि बोल नहीं सकता।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मैं गुज़रे दिनों पर,","poem":1},{"lineBreak":true},{"text":"या'नी क़दीम ज़माने के बरसों पर सोचता रहा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मुझे रात को अपना हम्द याद आता है;","poem":1},{"lineBreak":true},{"text":"मैं अपने दिल ही में सोचता हूँ।","poem":1},{"lineBreak":true},{"text":"मेरी रूह बड़ी तफ़्तीश में लगी है:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“क्या ख़ुदावन्द हमेशा के लिए छोड़ देगा?","poem":1},{"lineBreak":true},{"text":"क्या वह फिर कभी मेंहरबान न होगा?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"क्या उसकी शफ़क़त हमेशा के लिए जाती रही?","poem":1},{"lineBreak":true},{"text":"क्या उसका वा'दा हमेशा तक बातिल हो गया?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्या ख़ुदा करम करना भूल गया?","poem":1},{"lineBreak":true},{"text":"क्या उसने क़हर से अपनी रहमत रोक ली?” सिलाह","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"फिर मैंने कहा, “यह मेरी ही कमज़ोरी है;","poem":1},{"lineBreak":true},{"text":"मैं तो हक़ ता'ला की कुदरत के ज़माने को याद करूँगा।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द के कामों का ज़िक्र करूँगा;","poem":1},{"lineBreak":true},{"text":"क्यूँकि मुझे तेरे क़दीम 'अजाईब यादआएँगे।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मैं तेरी सारी सन'अत पर ध्यान करूँगा,","poem":1},{"lineBreak":true},{"text":"और तेरे कामों को सोचूँगा।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, तेरी राह मक़दिस में है।","poem":1},{"lineBreak":true},{"text":"कौन सा देवता ख़ुदा की तरह बड़ा है।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तू वह ख़ुदा है जो 'अजीब काम करता है,","poem":1},{"lineBreak":true},{"text":"तूने क़ौमों के बीच अपनी क़ुदरत ज़ाहिर की।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तूने अपने ही बाज़ू से अपनी क़ौम,","poem":1},{"lineBreak":true},{"text":"बनी या'क़ूब और बनी यूसुफ़ को फ़िदिया देकर छुड़ाया है।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा, समन्दरों ने तुझे देखा,","poem":1},{"lineBreak":true},{"text":"समन्दर तुझे देख कर डर गए,","poem":1},{"lineBreak":true},{"text":"गहराओ भी काँप उठे।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"बदलियों ने पानी बरसाया,","poem":1},{"lineBreak":true},{"text":"आसमानों से आवाज़ आई,","poem":1},{"lineBreak":true},{"text":"तेरे तीर भी चारों तरफ़ चले।","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"बगोले में तेरे गरज़ की आवाज़ थी,","poem":1},{"lineBreak":true},{"text":"बर्क़ ने जहान को रोशन कर दिया,","poem":1},{"lineBreak":true},{"text":"ज़मीन लरज़ी और काँपी।","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"तेरी राह समन्दर में है,","poem":1},{"lineBreak":true},{"text":"तेरे रास्ते बड़े समुन्दरों में हैं;","poem":1},{"lineBreak":true},{"text":"और तेरे नक़्श — ए — क़दम ना मा'लूम हैं।","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"तूने मूसा और हारून के वसीले से,","poem":1},{"lineBreak":true},{"text":"क़ि'ला की तरह अपने लोगों की रहनुमाई की।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}