{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द हमारे रब तेरा नाम तमाम ज़मीन पर कैसा बुज़ु़र्ग़ है!","poem":1},{"lineBreak":true},{"text":"तूने अपना जलाल आसमान पर क़ाईम किया है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तूने अपने मुखालिफ़ों की वजह से बच्चों और शीरख़्वारों के मुँह से कु़दरत को क़ाईम किया,","poem":1},{"lineBreak":true},{"text":"ताकि तू दुश्मन और इन्तक़ाम लेने वाले को ख़ामोश कर दे।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जब मैं तेरे आसमान पर जो तेरी दस्तकारी है,","poem":1},{"lineBreak":true},{"text":"और चाँद और सितारों पर जिनको तूने मुक़र्रर किया, ग़ौर करता हूँ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो फिर इंसान क्या है कि तू उसे याद रख्खे,","poem":1},{"lineBreak":true},{"text":"और बनी आदम क्या है कि तू उसकी ख़बर ले?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि तूने उसे ख़ुदा से कुछ ही कमतर बनाया है,","poem":1},{"lineBreak":true},{"text":"और जलाल और शौकत से उसे ताजदार करता है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तूने उसे अपनी दस्तकारी पर इख़्तियार बख़्शा है;","poem":1},{"lineBreak":true},{"text":"तूने सब कुछ उसके क़दमों के नीचे कर दिया है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"सब भेड़ — बकरियाँ,","poem":1},{"lineBreak":true},{"text":"गाय — बैल बल्कि सब जंगली जानवर","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हवा के परिन्दे और समन्दर की","poem":1},{"lineBreak":true},{"text":"और जो कुछ समन्दरों के रास्ते में चलता फिरता है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, हमारे रब्ब!","poem":1},{"lineBreak":true},{"text":"तेरा नाम पूरी ज़मीन पर कैसा बुज़ु़र्ग़ है!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}