{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदा के सामने जो हमारी ताक़त है, बुलन्द आवाज़ से गाओ;","poem":1},{"lineBreak":true},{"text":"या'क़ूब के ख़ुदा के सामने ख़ुशी का नारा मारो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"नग़मा छेड़ो, और दफ़ लाओ और दिलनवाज़ सितार और बरबत।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"नए चाँद और पूरे चाँद के वक़्त,","poem":1},{"lineBreak":true},{"text":"हमारी 'ईद के दिन नरसिंगा फूँको।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि यह इस्राईल के लिए क़ानून,","poem":1},{"lineBreak":true},{"text":"और या'क़ूब के ख़ुदा का हुक्म है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"इसको उसने यूसुफ़ में शहादत ठहराया,","poem":1},{"lineBreak":true},{"text":"जब वह मुल्क — ए — मिस्र के ख़िलाफ़ निकला। मैंने उसका कलाम सुना,","poem":1},{"lineBreak":true},{"text":"जिसको मैं जानता न था","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"'मैंने उसके कंधे पर से बोझ उतार दिया;","poem":1},{"lineBreak":true},{"text":"उसके हाथ टोकरी ढोने से छूट गए।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तूने मुसीबत में पुकारा और मैंने तुझे छुड़ाया;","poem":1},{"lineBreak":true},{"text":"मैंने राद के पर्दे में से तुझे जवाब दिया;","poem":1},{"lineBreak":true},{"text":"मैंने तुझे मरीबा के चश्मे पर आज़माया। सिलाह","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ मेरे लोगो, सुनो, मैं तुम को होशियार करता हूँ!","poem":1},{"lineBreak":true},{"text":"ऐ इस्राईल, काश के तू मेरी सुनता!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तेरे बीच कोई गै़र ख़ुदावन्द का मा'बूद न हो;","poem":1},{"lineBreak":true},{"text":"और तू किसी गै़रख़ुदावन्द के मा'बूद को सिज्दा न करना","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द तेरा ख़ुदा मैं हूँ,","poem":1},{"lineBreak":true},{"text":"जो तुझे मुल्क — ए — मिस्र से निकाल लाया।","poem":1},{"lineBreak":true},{"text":"तू अपना मुँह खू़ब खोल और मैं उसे भर दूँगा।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"“लेकिन मेरे लोगों ने मेरी बात न सुनी,","poem":1},{"lineBreak":true},{"text":"और इस्राईल मुझ से रज़ामंद न हुआ।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"तब मैंने उनको उनके दिल की हट पर छोड़ दिया,","poem":1},{"lineBreak":true},{"text":"ताकि वह अपने ही मश्वरों पर चलें।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"काश कि मेरे लोग मेरी सुनते,","poem":1},{"lineBreak":true},{"text":"और इस्राईल मेरी राहों पर चलता!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मैं जल्द उनके दुश्मनों को मग़लूब कर देता,","poem":1},{"lineBreak":true},{"text":"और उनके मुखालिफ़ों पर अपना हाथ चलाता।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द से 'अदावत रखने वाले उसके ताबे हो जाते,","poem":1},{"lineBreak":true},{"text":"और इनका ज़माना हमेशा तक बना रहता।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"वह इनको अच्छे से अच्छा गेहूँ खिलाता","poem":1},{"lineBreak":true},{"text":"और मैं तुझे चट्टान में के शहद से शेर करता।”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}