{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदा की जमा'अत में ख़ुदा मौजूद है।","poem":1},{"lineBreak":true},{"text":"वह इलाहों के बीच 'अदालत करता है:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“तुम कब तक बेइन्साफ़ी से 'अदालत करोगे,","poem":1},{"lineBreak":true},{"text":"और शरीरों की तरफ़दारी करोगे? सिलाह","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ग़रीब और यतीम का इन्साफ़ करो,","poem":1},{"lineBreak":true},{"text":"ग़मज़दा और मुफ़लिस के साथ इन्साफ़ से पेश आओ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ग़रीब और मोहताज को बचाओ;","poem":1},{"lineBreak":true},{"text":"शरीरों के हाथ से उनको छुड़ाओ।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"वह न तो कुछ जानते हैं न समझते हैं,","poem":1},{"lineBreak":true},{"text":"वह अंधेरे में इधर उधर चलते हैं;","poem":1},{"lineBreak":true},{"text":"ज़मीन की सब बुनियादें हिल गई हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मैंने कहा था, “तुम इलाह हो,","poem":1},{"lineBreak":true},{"text":"और तुम सब हक़ता'ला के फ़र्ज़न्द हो;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तोभी तुम आदमियों की तरह मरोगे,","poem":1},{"lineBreak":true},{"text":"और 'उमरा में से किसी की तरह गिर जाओगे।”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा! उठ ज़मीन की 'अदालत कर","poem":1},{"lineBreak":true},{"text":"क्यूँकि तू ही सब क़ौमों का मालिक होगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}