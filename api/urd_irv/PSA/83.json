{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदा! ख़ामोश न रह; ऐ ख़ुदा!","poem":1},{"lineBreak":true},{"text":"चुपचाप न हो और ख़ामोशी इख़्तियार न कर।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"क्यूँकि देख तेरे दुश्मन ऊधम मचाते हैं","poem":1},{"lineBreak":true},{"text":"और तुझ से 'अदावत रखने वालों ने सिर उठाया है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि वह तेरे लोगों के ख़िलाफ़ मक्कारी से मन्सूबा बाँधते हैं,","poem":1},{"lineBreak":true},{"text":"और उनके ख़िलाफ़ जो तेरी पनाह में हैं मशवरा करते हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उन्होंने कहा, “आओ, हम इनको काट डालें कि उनकी क़ौम ही न रहे;","poem":1},{"lineBreak":true},{"text":"और इस्राईल के नाम का फिर ज़िक्र न हो।”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्यूँकि उन्होंने एक हो कर के आपस में मश्वरा किया है,","poem":1},{"lineBreak":true},{"text":"वह तेरे ख़िलाफ़ 'अहद बाँधते हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"या'नी अदोम के अहल — ए — ख़ैमा","poem":1},{"lineBreak":true},{"text":"और इस्माईली मोआब और हाजरी,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जबल और'अम्मून और 'अमालीक़,","poem":1},{"lineBreak":true},{"text":"फ़िलिस्तीन और सूर के बाशिन्दे,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"असूर भी इनसे मिला हुआ है;","poem":1},{"lineBreak":true},{"text":"उन्होंने बनी लूत की मदद की है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तू उनसे ऐसा कर जैसा मिदियान से,","poem":1},{"lineBreak":true},{"text":"और जैसा वादी — ए — कैसून में सीसरा और याबीन से किया था।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जो 'ऐन दोर में हलाक हुए,","poem":1},{"lineBreak":true},{"text":"वह जैसे ज़मीन की खाद हो गए","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"उनके सरदारों को 'ओरेब और ज़ईब की तरह,","poem":1},{"lineBreak":true},{"text":"बल्कि उनके शाहज़ादों को ज़िबह और ज़िलमना' की तरह बना दे;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"जिन्होंने कहा है,","poem":1},{"lineBreak":true},{"text":"“आओ, हम ख़ुदा की बस्तियों पर कब्ज़ा कर लें।”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ऐ मेरे ख़ुदा, उनको बगोले की गर्द की तरह बना दे,","poem":1},{"lineBreak":true},{"text":"और जैसे हवा के आगे डंठल।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"उस आग की तरह जो जंगल को जला देती है,","poem":1},{"lineBreak":true},{"text":"उस शो'ले की तरह जो पहाड़ों मेंआग लगा देता है;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तू इसी तरह अपनी आँधी से उनका पीछा कर,","poem":1},{"lineBreak":true},{"text":"और अपने तूफ़ान से उनको परेशान कर दे।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! उनके चेहरों पर रुस्वाई तारी कर,","poem":1},{"lineBreak":true},{"text":"ताकि वह तेरे नाम के तालिब हों।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"वह हमेशा शर्मिन्दा और परेशान रहें,","poem":1},{"lineBreak":true},{"text":"बल्कि वह रुस्वा होकर हलाक हो जाएँ","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ताकि वह जान लें कि तू ही जिसका यहोवा है,","poem":1},{"lineBreak":true},{"text":"ज़मीन पर बुलन्द — ओ — बाला है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}