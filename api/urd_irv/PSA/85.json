{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"verse","number":1,"content":[{"text":"ऐ ख़ुदावन्द तू अपने मुल्क पर मेहरबान रहा है।","poem":1},{"lineBreak":true},{"text":"तू या'क़ूब को ग़ुलामी से वापस लाया है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तूने अपने लोगों की बदकारी मु'आफ़ कर दी है;","poem":1},{"lineBreak":true},{"text":"तूने उनके सब गुनाह ढाँक दिए हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तूने अपना ग़ज़ब बिल्कुल उठा लिया;","poem":1},{"lineBreak":true},{"text":"तू अपने क़हर — ए — शदीद से बाज़ आया है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ऐ हमारे नजात देने वाले ख़ुदा!","poem":1},{"lineBreak":true},{"text":"हम को बहाल कर, अपना ग़ज़ब हम से दूर कर!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"क्या तू हमेशा हम से नाराज़ रहेगा?","poem":1},{"lineBreak":true},{"text":"क्या तू अपने क़हर को नसल दर नसल जारी रख्खेगा?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"क्या तू हम को फिर ज़िन्दा न करेगा,","poem":1},{"lineBreak":true},{"text":"ताकि तेरे लोग तुझ में ख़ुश हों?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! तू अपनी शफ़क़त हमको दिखा,","poem":1},{"lineBreak":true},{"text":"और अपनी नजात हम को बख़्श।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मैं सुनूँगा कि ख़ुदावन्द ख़ुदा क्या फ़रमाता है।","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह अपने लोगों और अपने पाक लोगों से सलामती की बातें करेगा;","poem":1},{"lineBreak":true},{"text":"लेकिन वह फिर हिमाक़त की तरफ़ रुजू न करें।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"यक़ीनन उसकी नजात उससे डरने वालों के क़रीब है,","poem":1},{"lineBreak":true},{"text":"ताकि जलाल हमारे मुल्क में बसे।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"शफ़क़त और रास्ती एक साथ मिल गई हैं,","poem":1},{"lineBreak":true},{"text":"सदाक़त और सलामती ने एक दूसरे का बोसा लिया है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"रास्ती ज़मीन से निकलती है,","poem":1},{"lineBreak":true},{"text":"और सदाक़त आसमान पर से झाँकती हैं।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"जो कुछ अच्छा है वही ख़ुदावन्द अता फ़रमाएगा","poem":1},{"lineBreak":true},{"text":"और हमारी ज़मीन अपनी पैदावार देगी।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"सदाक़त उसके आगे — आगे चलेगी,","poem":1},{"lineBreak":true},{"text":"उसके नक़्श — ए — क़दम को हमारी राह बनाएगी।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}