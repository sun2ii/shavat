{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"उसकी बुनियाद पाक पहाड़ों में है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सिय्यून के फाटकों को या'क़ूब के सब घरों से ज़्यादा 'अज़ीज़ रखता है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदा के शहर!","poem":1},{"lineBreak":true},{"text":"तेरी बड़ी बड़ी खू़बियाँ बयान की जाती हैं। सिलाह","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मैं रहब और बाबुल का यूँ ज़िक्र करूँगा,","poem":1},{"lineBreak":true},{"text":"कि वह मेरे जानने वालों में हैं;","poem":1},{"lineBreak":true},{"text":"फ़िलिस्तीन और सूर और कूश को देखो, यह वहाँ पैदा हुआ था।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"बल्कि सिय्यून के बारे में कहा जाएगा,","poem":1},{"lineBreak":true},{"text":"कि फ़लाँ फ़लाँ आदमी उसमें पैदा हुए।","poem":1},{"lineBreak":true},{"text":"और हक़ता'ला ख़ुद उसको क़याम बख़्शेगा।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द क़ौमों के शुमार के वक़्त दर्ज करेगा,","poem":1},{"lineBreak":true},{"text":"कि यह शख़्स वहाँ पैदा हुआ था।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"गाने वाले और नाचने वाले यही कहेंगे कि","poem":1},{"lineBreak":true},{"text":"मेरे सब चश्में तुझ ही में हैं।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}