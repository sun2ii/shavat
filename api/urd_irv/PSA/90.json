{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"verse","number":1,"content":[{"text":"या रब्ब, नसल दर नसल, तू ही हमारी पनाहगाह रहा है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"इससे पहले के पहाड़ पैदा हुए,","poem":1},{"lineBreak":true},{"text":"या ज़मीन और दुनिया को तूने बनाया,","poem":1},{"lineBreak":true},{"text":"इब्तिदा से हमेशा तक तू ही ख़ुदा है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू इंसान को फिर ख़ाक में मिला देता है,","poem":1},{"lineBreak":true},{"text":"और फ़रमाता है, “ऐ बनी आदम, लौट आओ!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि तेरी नज़र में हज़ार बरस ऐसे हैं,","poem":1},{"lineBreak":true},{"text":"जैसे कल का दिन जो गुज़र गया,","poem":1},{"lineBreak":true},{"text":"और जैसे रात का एक पहर।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तू उनको जैसे सैलाब से बहा ले जाता है;","poem":1},{"lineBreak":true},{"text":"वह नींद की एक झपकी की तरह हैं,","poem":1},{"lineBreak":true},{"text":"वह सुबह को उगने वाली घास की तरह हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वह सुबह को लहलहाती और बढ़ती है,","poem":1},{"lineBreak":true},{"text":"वह शाम को कटती और सूख जातीहै।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्यूँकि हम तेरे क़हर से फ़ना हो गए;","poem":1},{"lineBreak":true},{"text":"और तेरे ग़ज़ब से परेशान हुए।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तूने हमारी बदकिरदारी को अपने सामने रख्खा,","poem":1},{"lineBreak":true},{"text":"और हमारे छुपे हुए गुनाहों को अपने चेहरे की रोशनी में।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्यूँकि हमारे तमाम दिन तेरे क़हर में गुज़रे,","poem":1},{"lineBreak":true},{"text":"हमारी उम्र ख़याल की तरह जाती रहती है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"हमारी उम्र की मी'आद सत्तर बरस है,","poem":1},{"lineBreak":true},{"text":"या कु़व्वत हो तो अस्सी बरस;","poem":1},{"lineBreak":true},{"text":"तो भी उनकी रौनक़ महज़ मशक्क़त और ग़म है,","poem":1},{"lineBreak":true},{"text":"क्यूँकि वह जल्द जाती रहती है और हम उड़ जाते हैं।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तेरे क़हर की शिद्दत को कौन जानता है,","poem":1},{"lineBreak":true},{"text":"और तेरे ख़ौफ़ के मुताबिक़ तेरे ग़ज़ब को?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हम को अपने दिन गिनना सिखा,","poem":1},{"lineBreak":true},{"text":"ऐसा कि हम अक़्ल दिल हासिल करें।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, बाज़ आ! कब तक?","poem":1},{"lineBreak":true},{"text":"और अपने बन्दों पर रहम फ़रमा!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"सुबह को अपनी शफ़क़त से हम को आसूदा कर,","poem":1},{"lineBreak":true},{"text":"ताकि हम उम्र भर ख़ुश — ओ — ख़ुर्रम रहें।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"जितने दिन तूने हम को दुख दिया,","poem":1},{"lineBreak":true},{"text":"और जितने बरस हम मुसीबत में रहे,","poem":1},{"lineBreak":true},{"text":"उतनी ही ख़ुशी हम को 'इनायत कर।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"तेरा काम तेरे बन्दों पर,","poem":1},{"lineBreak":true},{"text":"और तेरा जलाल उनकी औलाद पर ज़ाहिर हो।","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"और रब्ब हमारे ख़ुदा का करम हम पर साया करे।","poem":1},{"lineBreak":true},{"text":"हमारे हाथों के काम को हमारे लिए क़याम बख़्श हाँ","poem":1},{"lineBreak":true},{"text":"हमारे हाथों के काम को क़याम बख़्श दे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}