{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"जो हक़ता'ला के पर्दे में रहता है,","poem":1},{"lineBreak":true},{"text":"वह क़ादिर — ए — मुतलक़ के साये में सुकूनत करेगा।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मैं ख़ुदावन्द के बारे में कहूँगा, “वही मेरी पनाह और मेरा गढ़ है;","poem":1},{"lineBreak":true},{"text":"वह मेरा ख़ुदा है, जिस पर मेरा भरोसा है।”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि वह तुझे सय्याद के फंदे से,","poem":1},{"lineBreak":true},{"text":"और मुहलिक वबा से छुड़ाएगा।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"वह तुझे अपने परों से छिपा लेगा,","poem":1},{"lineBreak":true},{"text":"और तुझे उसके बाजु़ओं के नीचे पनाह मिलेगी,","poem":1},{"lineBreak":true},{"text":"उसकी सच्चाई ढाल और सिपर है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तू न रात के ख़ौफ़ से डरेगा,","poem":1},{"lineBreak":true},{"text":"न दिन को उड़ने वाले तीर से।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"न उस वबा से जो अंधेरे में चलती है,","poem":1},{"lineBreak":true},{"text":"न उस हलाकत से जो दोपहर को वीरान करती है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तेरे आसपास एक हज़ार गिर जाएँगे,","poem":1},{"lineBreak":true},{"text":"और तेरे दहने हाथ की तरफ़ दस हज़ार;","poem":1},{"lineBreak":true},{"text":"लेकिन वह तेरे नज़दीक न आएगी।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"लेकिन तू अपनी आँखों से निगाह करेगा,","poem":1},{"lineBreak":true},{"text":"और शरीरों के अंजाम को देखेगा।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"लेकिन तू ऐ ख़ुदावन्द, मेरी पनाह है।","poem":1},{"lineBreak":true},{"text":"तूने हक़ता'ला को अपना घर बना लिया है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तुझ पर कोई आफ़त नहीं आएगी,","poem":1},{"lineBreak":true},{"text":"और कोई वबा तेरे ख़ेमे के नज़दीक न पहुँचेगी।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"क्यूँकि वह तेरे बारे में अपने फ़रिश्तों को हुक्म देगा,","poem":1},{"lineBreak":true},{"text":"कि तेरी सब राहों में तेरी हिफ़ाज़त करें।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"वह तुझे अपने हाथों पर उठा लेंगे,","poem":1},{"lineBreak":true},{"text":"ताकि ऐसा न हो कि तेरे पाँव को पत्थर से ठेस लगे।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"तू शेर — ए — बबर और अज़दहा को रौंदेगा,","poem":1},{"lineBreak":true},{"text":"तू जवान शेर और अज़दह को पामाल करेगा।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"चूँकि उसने मुझ से दिल लगाया है, इसलिए मैं उसे छुड़ाऊँगा;","poem":1},{"lineBreak":true},{"text":"मैं उसे सरफ़राज़ करूँगा, क्यूँकि उसने मेरा नाम पहचाना है।","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"वह मुझे पुकारेगा और मैं उसे जवाब दूँगा,","poem":1},{"lineBreak":true},{"text":"मैं मुसीबत में उसके साथ रहूँगा,","poem":1},{"lineBreak":true},{"text":"मैं उसे छुड़ाऊँगा और 'इज़्ज़त बख़्शूँगा।","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"मैं उसे उम्र की दराज़ी से आसूदा कर दूँगा","poem":1},{"lineBreak":true},{"text":"और अपनी नजात उसे दिखाऊँगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}