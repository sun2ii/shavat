{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":[{"text":"क्या ही भला है, ख़ुदावन्द का शुक्र करना,","poem":1},{"lineBreak":true},{"text":"और तेरे नाम की मदहसराई करना; ऐ हक़ ता'ला!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"सुबह को तेरी शफ़क़त का इज़्हार करना,","poem":1},{"lineBreak":true},{"text":"और रात को तेरी वफ़ादारी का,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"दस तार वाले साज़ और बर्बत पर,","poem":1},{"lineBreak":true},{"text":"और सितार पर गूंजती आवाज़ के साथ।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि, ऐ ख़ुदावन्द, तूने मुझे अपने काम से ख़ुश किया;","poem":1},{"lineBreak":true},{"text":"मैं तेरी कारीगरी की वजह से ख़ुशी मनाऊँगा।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द, तेरी कारीगरी कैसी बड़ी हैं।","poem":1},{"lineBreak":true},{"text":"तेरे ख़याल बहुत 'अमीक़ हैं।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"हैवान ख़सलत नहीं जानता","poem":1},{"lineBreak":true},{"text":"और बेवक़ूफ़ इसको नहीं समझता,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जब शरीर घास की तरह उगते हैं,","poem":1},{"lineBreak":true},{"text":"और सब बदकिरदार फूलते फलते हैं,","poem":1},{"lineBreak":true},{"text":"तो यह इसी लिए है कि वह हमेशा के लिए फ़ना हों।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"लेकिन तू ऐ ख़ुदावन्द, हमेशा से हमेशा तक बुलन्द है।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्यूँकि देख, ऐ ख़ुदावन्द, तेरे दुश्मन;","poem":1},{"lineBreak":true},{"text":"देख, तेरे दुश्मन हलाक हो जाएँगे;","poem":1},{"lineBreak":true},{"text":"सब बदकिरदार तितर बितर कर दिए जाएँगे।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"लेकिन तूने मेरे सींग को जंगली साँड के सींग की तरह बलन्द किया है;","poem":1},{"lineBreak":true},{"text":"मुझ पर ताज़ा तेल मला गया है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मेरी आँख ने मेरे दुश्मनों को देख लिया,","poem":1},{"lineBreak":true},{"text":"मेरे कानों ने मेरे मुख़ालिफ़ बदकारों का हाल सुन लिया है।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"सादिक़ खजूर के दरख़्त की तरह सरसब्ज़ होगा।","poem":1},{"lineBreak":true},{"text":"वह लुबनान के देवदार की तरह बढ़ेगा।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"जो ख़ुदावन्द के घर में लगाए गए हैं,","poem":1},{"lineBreak":true},{"text":"वह हमारे ख़ुदा की बारगाहों में सरसब्ज़ होंगे।","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"वह बुढ़ापे में भी कामयाब होंगे,","poem":1},{"lineBreak":true},{"text":"वह तर — ओ — ताज़ा और सरसब्ज़ रहेंगे;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ताकि वाज़ह करें कि ख़ुदावन्द रास्त है","poem":1},{"lineBreak":true},{"text":"वही मेरी चट्टान है और उसमें न रास्ती नहीं।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}