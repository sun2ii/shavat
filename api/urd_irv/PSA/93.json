{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द सलतनत करता है वह शौकत से मुलब्बस है","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द कु़दरत से मुलब्बस है, वह उससे कमर बस्ता है","poem":1},{"lineBreak":true},{"text":"इस लिए जहान क़ाईम है और उसे जुम्बिश नहीं।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तेरा तख़्त पहले से क़ाईम है, तू इब्तिदा से है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"सैलाबों ने, ऐ ख़ुदावन्द!","poem":1},{"lineBreak":true},{"text":"सैलाबों ने शोर मचा रख्खा है, सैलाब मौजज़न हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"बहरों की आवाज़ से,","poem":1},{"lineBreak":true},{"text":"समन्दर की ज़बरदस्त मौजों से भी,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द बलन्द — ओ — क़ादिर है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तेरी शहादतें बिल्कुल सच्ची हैं;","poem":1},{"lineBreak":true},{"text":"ऐ ख़ुदावन्द हमेशा से हमेशा तक के लिए","poem":1},{"lineBreak":true},{"text":"पाकीज़गी तेरे घर को ज़ेबा है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}