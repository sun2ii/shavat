{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"आओ हम ख़ुदावन्द के सामने नग़मासराई करे!","poem":1},{"lineBreak":true},{"text":"अपनी नजात की चट्टान के सामने खु़शी से ललकारें।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"शुक्रगुज़ारी करते हुए उसके सामने में हाज़िर हों,","poem":1},{"lineBreak":true},{"text":"मज़मूर गाते हुए उसके आगे ख़ुशी से ललकारें।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द ख़ुदा — ए — 'अज़ीम है,","poem":1},{"lineBreak":true},{"text":"और सब इलाहों पर शाह — ए — 'अज़ीम है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ज़मीन के गहराव उसके क़ब्ज़े में हैं;","poem":1},{"lineBreak":true},{"text":"पहाड़ों की चोटियाँ भी उसी की हैं।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"समन्दर उसका है, उसी ने उसको बनाया,","poem":1},{"lineBreak":true},{"text":"और उसी के हाथों ने खु़श्की को भी तैयार किया।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"आओ हम झुकें और सिज्दा करें,","poem":1},{"lineBreak":true},{"text":"और अपने खालिक़ ख़ुदावन्द के सामने घुटने टेकें!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"क्यूँकि वह हमारा ख़ुदा है,","poem":1},{"lineBreak":true},{"text":"और हम उसकी चरागाह के लोग,","poem":1},{"lineBreak":true},{"text":"और उसके हाथ की भेड़ें हैं।","poem":1},{"lineBreak":true},{"text":"काश कि आज के दिन तुम उसकी आवाज़ सुनते!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तुम अपने दिल को सख़्त न करो जैसा मरीबा में,","poem":1},{"lineBreak":true},{"text":"जैसा मस्साह के दिन वीरान में किया था,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"उस वक़्त तुम्हारे बाप — दादा ने मुझे आज़माया,","poem":1},{"lineBreak":true},{"text":"और मेरा इम्तिहान किया और मेरे काम को भी देखा।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"चालीस बरस तक मैं उस नसल से बेज़ार रहा,","poem":1},{"lineBreak":true},{"text":"और मैने कहा, कि “ये वह लोग हैं जिनके दिल आवारा हैं,","poem":1},{"lineBreak":true},{"text":"और उन्होंने मेरी राहों को नहीं पहचाना।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"चुनाँचे मैने अपने ग़ज़ब में क़सम खाई कि","poem":1},{"lineBreak":true},{"text":"यह लोग मेरे आराम में दाख़िल न होंगे।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}