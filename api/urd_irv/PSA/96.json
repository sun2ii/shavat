{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द के सामने नया हम्द गाओ!","poem":1},{"lineBreak":true},{"text":"ऐ सब अहल — ए — ज़मीन! ख़ुदावन्द के सामने गाओ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के सामने गाओ, उसके नाम को मुबारक कहो;","poem":1},{"lineBreak":true},{"text":"रोज़ ब रोज़ उसकी नजात की बशारत दो।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"क़ौमों में उसके जलाल का,","poem":1},{"lineBreak":true},{"text":"सब लोगों में उसके 'अजायब का बयान करो।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द बुज़ु़र्ग़ और बहुत। सिताइश के लायक़ है;","poem":1},{"lineBreak":true},{"text":"वह सब मा'बूदों से ज़्यादा ता'ज़ीम के लायक़ है।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"इसलिए कि और क़ौमों के सब मा'बूद सिर्फ़ बुत हैं;","poem":1},{"lineBreak":true},{"text":"लेकिन ख़ुदावन्द ने आसमानों को बनाया।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"अज़मत और जलाल उसके सामने में हैं,","poem":1},{"lineBreak":true},{"text":"क़ुदरत और जमाल उसके मक़दिस में।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ऐ क़ौमों के क़बीलो! ख़ुदावन्द की,","poem":1},{"lineBreak":true},{"text":"ख़ुदावन्द ही की तम्जीद — ओ — ताज़ीम करो!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की ऐसी तम्जीद करो जो उसके नाम की शायान है;","poem":1},{"lineBreak":true},{"text":"हदिया लाओ और उसकी बारगाहों में आओ!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"पाक आराइश के साथ ख़ुदावन्द को सिज्दा करो;","poem":1},{"lineBreak":true},{"text":"ऐ सब अहल — ए — ज़मीन! उसके सामने काँपते रहो!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"क़ौमों में 'ऐलान करो, “ख़ुदावन्द सल्तनत करता है!","poem":1},{"lineBreak":true},{"text":"जहान क़ाईम है, और उसे जुम्बिश नहीं;","poem":1},{"lineBreak":true},{"text":"वह रास्ती से कौमों की 'अदालत करेगा।”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"आसमान ख़ुशी मनाए, और ज़मीन ख़ुश हो;","poem":1},{"lineBreak":true},{"text":"समन्दर और उसकी मा'मूरी शोर मचाएँ;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मैदान और जो कुछ उसमें है, बाग़ — बाग़ हों;","poem":1},{"lineBreak":true},{"text":"तब जंगल के सब दरख़्त खु़शी से गाने लगेंगे।","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के सामने, क्यूँकि वह आ रहा है;","poem":1},{"lineBreak":true},{"text":"वह ज़मीन की 'अदालत करने को रहा है।","poem":1},{"lineBreak":true},{"text":"वह सदाक़त से जहान की, और अपनी सच्चाई से क़ौमों की 'अदालत करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}