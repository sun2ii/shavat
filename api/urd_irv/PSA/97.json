{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द सल्तनत करता है, ज़मीन ख़ुश हो;","poem":1},{"lineBreak":true},{"text":"बेशुमार जज़ीरे ख़ुशी मनाएँ।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"बादल और तारीकी उसके चारों तरफ़ हैं;","poem":1},{"lineBreak":true},{"text":"सदाक़त और अदल उसके तख़्त की बुनियाद हैं।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"आग उसके आगे आगे चलती है,","poem":1},{"lineBreak":true},{"text":"और चारों तरफ़ उसके मुख़ालिफ़ो को भसम कर देती है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"उसकी बिजलियों ने जहान को रोशन कर दिया","poem":1},{"lineBreak":true},{"text":"ज़मीन ने देखा और काँप गई।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के सामने पहाड़ मोम की तरह पिघल गए,","poem":1},{"lineBreak":true},{"text":"या'नी सारी ज़मीन के ख़ुदावन्द के सामने।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"आसमान उसकी सदाक़त ज़ाहिर करता सब क़ौमों ने उसका जलाल देखा है।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"खुदी हुई मूरतों के सब पूजने वाले,","poem":1},{"lineBreak":true},{"text":"जो बुतों पर फ़ख़्र करते हैं, शर्मिन्दा हों,","poem":1},{"lineBreak":true},{"text":"ऐ मा'बूद! सब उसको सिज्दा करो।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द! सिय्यून ने सुना और खु़श हुई","poem":1},{"lineBreak":true},{"text":"और यहूदाह की बेटियाँ तेरे अहकाम से ख़ुश हुई।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"क्यूँकि ऐ ख़ुदावन्द! तू तमाम ज़मीन पर बुलंद — ओ — बाला है;","poem":1},{"lineBreak":true},{"text":"तू सब मा'बूदों से बहुत आला है।","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द से मुहब्बत रखने वालों, बदी से नफ़रत करो,","poem":1},{"lineBreak":true},{"text":"वह अपने पाक लोगों की जानों को महफ़ूज़ रखता है,","poem":1},{"lineBreak":true},{"text":"वह उनको शरीरों के हाथ से छुड़ाता है।","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"सादिक़ों के लिए नूर बोया गया है,","poem":1},{"lineBreak":true},{"text":"और रास्त दिलों के लिए खु़शी।","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ऐ सादिक़ों! ख़ुदावन्द में खु़श रहो;","poem":1},{"lineBreak":true},{"text":"उसके पाक नाम का शुक्र करो।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}