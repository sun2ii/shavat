{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द के सामने नया हम्द गाओ","poem":1},{"lineBreak":true},{"text":"क्यूँकि उसने 'अजीब काम किए हैं।","poem":1},{"lineBreak":true},{"text":"उसके दहने हाथ और उसके पाक बाज़ू ने उसके लिए फ़तह हासिल की है।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द ने अपनी नजात ज़ाहिर की है,","poem":1},{"lineBreak":true},{"text":"उसने अपनी सदाक़त क़ौमों के सामने ज़ाहिर की है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"उसने इस्राईल के घराने के हक़ में अपनी शफ़क़त — ओ — वफ़ादारी याद की है,","poem":1},{"lineBreak":true},{"text":"इन्तिहाई ज़मीन के लोगों ने हमारे ख़ुदा की नजात देखी है।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ऐ तमाम अहल — ए — ज़मीन! ख़ुदावन्द के सामने ख़ुशी का नारा मारो;","poem":1},{"lineBreak":true},{"text":"ललकारो और खु़शी से गाओ और मदहसराई करो।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द की सिताइश सितार पर करो,","poem":1},{"lineBreak":true},{"text":"सितार और सुरीली आवाज़ से।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"नरसिंगे और करना की आवाज़ से,","poem":1},{"lineBreak":true},{"text":"बादशाह या'नी ख़ुदावन्द के सामने खु़शी का नारा मारो।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"समन्दर और उसकी मा'मूरी शोर मचाएँ","poem":1},{"lineBreak":true},{"text":"और जहान और उसके बाशिंदे।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"सैलाब तालियाँ बजाएँ;","poem":1},{"lineBreak":true},{"text":"पहाड़ियाँ मिलकर ख़ुशी से गाएँ।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द के सामने, क्यूँकि वह ज़मीन की 'अदालत करने आ रहा है।","poem":1},{"lineBreak":true},{"text":"वह सदाक़त से जहान की,","poem":1},{"lineBreak":true},{"text":"रास्ती से क़ौमों की 'अदालत करेगा।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}