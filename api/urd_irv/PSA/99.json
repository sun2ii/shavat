{"translation":{"id":"urd_irv","name":"इंडियन रिवाइज्ड वर्जन (IRV) उर्दू - 2019","website":"https://ebible.org/Scriptures/details.php?id=urd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urd","licenseNotes":null,"shortName":"IRV","englishName":"Urdu IRV Bible","language":"urd","textDirection":"ltr","sha256":"6890095f5aae1905c9eb234c07f1a55e20309c2a0f15681ba879d2cd04d6bdec","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_irv","name":"ज़बूर","commonName":"ज़बूर","title":"ज़बूर","order":19,"numberOfChapters":150,"sha256":"a86554ca3f9a67d33a239b11b54c5f9571af862327ecf77484d32b0f924017fb","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"ख़ुदावन्द सलतनत करता है,","poem":1},{"lineBreak":true},{"text":"क़ौमें काँपी। वह करूबियों पर बैठता है, ज़मीन लरज़े।","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ख़ुदावन्द सिय्यून में बुज़ु़र्ग़ है;","poem":1},{"lineBreak":true},{"text":"और वह सब क़ौमों पर बुलंद — ओ — बाला है।","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"वह तेरे बुज़ुर्ग और बड़े नाम की ता'रीफ़ करें वह पाक हैं।","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"बादशाह की ताक़त इन्साफ़ पसन्द है","poem":1},{"lineBreak":true},{"text":"तू रास्ती को क़ाईम करता है तू ही ने 'अद्ल","poem":1},{"lineBreak":true},{"text":"और सदाक़त को या'क़ूब, में रायज किया।","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तुम ख़ुदावन्द हमारे ख़ुदा की तम्जीद करो,","poem":1},{"lineBreak":true},{"text":"और उसके पाँव की चौकी पर सिज्दा वह पाक है।","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"उसके काहिनों में से मूसा और हारून ने,","poem":1},{"lineBreak":true},{"text":"और उसका नाम लेनेवालों में से समुएल ने ख़ुदावन्द से दुआ की और उसने उनको जवाब दिया।","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"उसने बादल के सुतून में से उनसे कलाम किया;","poem":1},{"lineBreak":true},{"text":"उन्होंने उसकी शहादतों को और उस क़ानून को जो उनको दिया था, माना।","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ऐ ख़ुदावन्द हमारे ख़ुदा, तू उनको जवाब देता था;","poem":1},{"lineBreak":true},{"text":"तू वह ख़ुदा है जो उनको मु'आफ करता रहा,","poem":1},{"lineBreak":true},{"text":"अगरचे तूने उनके आ'माल का बदला भी दिया।","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुम ख़ुदावन्द हमारे ख़ुदा की तम्जीद करो,","poem":1},{"lineBreak":true},{"text":"और उसके पाक पहाड़ पर सिज्दा करो;","poem":1},{"lineBreak":true},{"text":"क्यूँकि ख़ुदावन्द हमारा ख़ुदा क़ुददूस है।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_irv/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_irv/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_irv/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}