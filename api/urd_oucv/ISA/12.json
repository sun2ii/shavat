{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"ISA","translationId":"urd_oucv","name":"یَشعیاہ","commonName":"یَشعیاہ","title":"یَشعیاہ کی نبُوّت","order":23,"numberOfChapters":66,"sha256":"3c7f204765e53099f14827d9c6d81294cdfa70344e92341d0916cd7fcc1c2c3d","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/urd_oucv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["سِتائش کے نغمہ"]},{"type":"verse","number":1,"content":["اُس دِن تُم کہو گے:",{"text":"”یَاہوِہ مَیں آپ کی سِتائش کروں گا","poem":1},{"text":"حالانکہ آپ مُجھ سے خفا تھا،","poem":2},{"text":"لیکن آپ کا غُصّہ ٹل گیا ہے","poem":1},{"text":"اَور آپ نے مُجھے تسلّی دی ہے۔","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یقیناً خُدا میری نَجات ہے؛","poem":1},{"text":"میں اُن پر توکّل کروں گا اَور نہ ڈروں گا۔","poem":2},{"text":"یَاہوِہ، یَاہوِہ ہی میری قُوّت اَور میرا نغمہ ہے؛","poem":1},{"text":"وہ میری نَجات بنا ہے۔“","poem":2}]},{"type":"verse","number":3,"content":[{"text":"تُم خُوش ہوکر نَجات کے چشموں سے","poem":1},{"text":"پانی بھروگے۔","poem":2}]},{"type":"verse","number":4,"content":["اُس وقت تُم کہو گے:",{"text":"”یَاہوِہ کا شُکر بجا لاؤ، اُسے اُس کے نام سے پُکارو؛","poem":1},{"text":"قوموں میں اُس کے کارناموں کا ذِکر کرو،","poem":2},{"lineBreak":true},{"text":"اَور اُس کے نام کی بڑائی کا اعلان کرو۔","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یَاہوِہ کی مدح سرائی کرو کیونکہ اُنہُوں نے جلالی کام کئے ہیں؛","poem":1},{"text":"یہ ساری دُنیا کو مَعلُوم ہو جائے۔","poem":2}]},{"type":"verse","number":6,"content":[{"text":"اَے صِیّونؔ کے لوگو، للکارو اَور خُوشی سے گاؤ،","poem":1},{"text":"کیونکہ اِسرائیل کا قُدُّوس تمہارے درمیان عظیم ہے۔“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}