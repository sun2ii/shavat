{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"JOB","translationId":"urd_oucv","name":"ایُّوب","commonName":"ایُّوب","title":"ایُّوب کی کِتاب","order":18,"numberOfChapters":42,"sha256":"3e40fcd71c45d400e8238aacaf4bb65712ce6ba695dd97dbeae5da1303373655","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/urd_oucv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["بِلددؔ"]},{"type":"verse","number":1,"content":["تَب بِلددؔ شوحی نے جَواب دیا:"]},{"type":"verse","number":2,"content":[{"text":"”خُدا سلطنت اَور دبدبہ کے مالک ہیں؛","poem":1},{"text":"وہ آسمان کی بُلندیوں میں اَمن قائِم رکھتے ہیں۔","poem":2}]},{"type":"verse","number":3,"content":[{"text":"کیا اُن کے لشکروں","poem":1},{"noteId":29},{"text":"کی تعداد گنی جا سکتی ہے؟","poem":1},{"text":"وہ کون ہے جِس پر اُن کا سُورج نہیں چمکتا؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"پھر اِنسان کیسے خُدا کے حُضُور راست ٹھہر سَکتا ہے؟","poem":1},{"text":"جو عورت سے پیدا ہُوا ہو وہ کیسے پاک ہو سَکتا ہے؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"جَب چاند بھی رَوشن نہیں","poem":1},{"text":"اَور سِتارے اُن کی نظر میں پاک نہیں،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پھر بھلا اِنسان کا کیا ذِکر جو محض کیڑا ہے،","poem":1},{"text":"ایک آدمؔ زاد چیونٹی سے زِیادہ حیثیت نہیں رکھتا!“","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"25‏:3 لشکروں یا فرشتوں","reference":{"chapter":25,"verse":3}}]},"thisChapterLink":"/api/urd_oucv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}