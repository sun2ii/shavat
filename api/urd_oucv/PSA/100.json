ہیں اَور اُن کی شفقت اَبدی ہے؛","poem":1},{"text":"اَور اُن کی وفاداری پُشت در پُشت جاری رہتی ہے۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}