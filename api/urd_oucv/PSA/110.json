{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["داویؔد کا زبُور۔"]},{"type":"verse","number":1,"content":[{"text":"یَاہوِہ نے میرے خُداوؔند سے فرمایا:","poem":1},{"lineBreak":true},{"text":"”میری داہنی طرف بیٹھو","poem":1},{"text":"جَب تک کہ مَیں تمہارے دُشمنوں کو","poem":2},{"lineBreak":true},{"text":"تمہارے پاؤں کے نیچے نہ کر دُوں۔“","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"یَاہوِہ آپ کی طاقت کا عصا صِیّونؔ سے آگے بڑھائیں گے،","poem":1},{"text":"”آپ اَپنے دُشمنوں میں حُکمرانی کریں گے!“","poem":2}]},{"type":"verse","number":3,"content":[{"text":"آپ کی لشکر کشی کے دِن","poem":1},{"text":"آپ کے لوگ اَپنی مرضی سے خدمات پیش کریں گے،","poem":2},{"text":"مُقدّس شوکت سے آراستہ ہوکر","poem":1},{"text":"اَور صُبح صادق کے بطن سے پیدا ہونے والی","poem":2},{"lineBreak":true},{"text":"جَوانی کی شبنم کی مانند۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"یَاہوِہ نے قَسم کھائی ہے،","poem":1},{"text":"اَور وہ اَپنا اِرادہ بدلیں گے نہیں:","poem":2},{"text":"”آپ ملکِ صِدقؔ کے طور پر","poem":1},{"text":"اَبد تک کاہِنؔ ہیں۔“","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"خُداوؔند آپ کے داہنے ہاتھ پر؛","poem":1},{"text":"اَپنے غضب کے دِن بادشاہوں کو کُچل ڈالیں گے۔","poem":2},{"noteId":91}]},{"type":"verse","number":6,"content":[{"text":"وہ قوموں کا اِنصاف کریں گے اَور لاشوں کے ڈھیر لگا دیں گے،","poem":1},{"text":"اَور تمام رُوئے زمین کے حُکمرانوں کو کُچل ڈالیں گے۔","poem":2}]},{"type":"verse","number":7,"content":[{"text":"وہ راہ کے کنارے کی ندی سے پانی پیئیں گے،","poem":1},{"text":"اِس لیٔے وہ اَپنے سَر کو اُونچا کریں گے۔","poem":2}]}],"footnotes":[{"noteId":91,"caller":"+","text":"110‏:5 زبُور 143‏:5‏","reference":{"chapter":110,"verse":5}}]},"thisChapterLink":"/api/urd_oucv/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}