{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"یَاہوِہ کی سِتائش کرو۔","poem":1},{"lineBreak":true},{"text":"اَے یَاہوِہ، کے خادِمو، سِتائش کرو؛","poem":1},{"text":"یَاہوِہ کے نام کی سِتائش کرو۔","poem":2}]},{"type":"verse","number":2,"content":[{"text":"اَب سے اَبد تک،","poem":1},{"text":"یَاہوِہ کا نام مُبارک ہو۔","poem":2}]},{"type":"verse","number":3,"content":[{"text":"طُلوع آفتاب سے غروب ہونے تک،","poem":1},{"text":"یَاہوِہ کے نام کی سِتائش کی جائے۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"یَاہوِہ سَب قوموں پر بُلند و بالا ہیں،","poem":1},{"text":"اُن کا جلال آسمان سے بھی اُونچا ہے۔","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یَاہوِہ ہمارے خُدا کی مانند کون ہے؟","poem":1},{"text":"جو عالمِ بالا پر تخت نشین ہیں،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"جو فروتنی سے","poem":1},{"text":"آسمان اَور زمین پر نظر کرتے ہیں؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"وہ مسکین کو خاک پر سے","poem":1},{"text":"اَور وہ ہی مُحتاج کو کُوڑے کے ڈھیر سے باہر نکالتے ہیں؛","poem":2}]},{"type":"verse","number":8,"content":[{"text":"اَور اُنہیں اُمرا کے ساتھ","poem":1},{"text":"یعنی اَپنی اُمّت کے اُمرا کے ساتھ بِٹھاتے ہیں۔","poem":2}]},{"type":"verse","number":9,"content":[{"text":"وہ بانجھ عورت کو بچّوں کی خُوشی دیتے ہیں","poem":1},{"text":"اَور اُسے اَپنے گھر میں ایک دلشاد ماں کی طرح بساتے ہیں۔","poem":2},{"lineBreak":true},{"text":"یَاہوِہ کی سِتائش کرو۔","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}