{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"جَب اِسرائیل، مُلک مِصر میں سے نکل آئے،","poem":1},{"text":"یعنی یعقوب کا گھرانا اجنبی زبان بولنے والوں میں سے نکلے،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"تَب یہُوداہؔ خُدا کا پاک مَقدِس ٹھہرا،","poem":1},{"text":"اَور اِسرائیل اُن کی مملکت۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"سمُندر یہ دیکھ کر بھاگ نِکلا،","poem":1},{"text":"اَور دریائے یردنؔ پیچھے ہٹ گیا؛","poem":2}]},{"type":"verse","number":4,"content":[{"text":"پہاڑ مینڈھوں کی مانند اُچھلے،","poem":1},{"text":"اَور پہاڑیاں برّوں کی مانند کُودنے لگیں۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"اَے سمُندر، تُمہیں کیا ہُوا جو تُم بھاگے،","poem":1},{"text":"اَور اَے یردنؔ تُم کیوں پیچھے ہٹے؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"اَے پہاڑو! تُم کیوں مینڈھوں کی مانند اُچھلے","poem":1},{"text":"اَور اَے پہاڑیو! تُمہیں کیا ہُوا کہ تُم برّوں کی مانند کوُدنے لگیں؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"اَے زمین یَاہوِہ کے سامنے،","poem":1},{"text":"یعقوب کے خُدا کے سامنے تھرتھرا،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"جِس نے چٹّان کو جھیل،","poem":1},{"text":"اَور چقماق کو پانی کا چشمہ بنا دیا۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}