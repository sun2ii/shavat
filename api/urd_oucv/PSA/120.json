]},{"type":"verse","number":6,"content":[{"text":"صُلح کے دُشمنوں کی صحبت میں رہتے ہُوئے","poem":1},{"text":"مُجھے بڑی مُدّت ہو گئی۔","poem":2}]},{"type":"verse","number":7,"content":[{"text":"میں صُلح پسند آدمی ہُوں؛","poem":1},{"text":"لیکن جَب بولتا ہُوں تو وہ لڑنے پر آمادہ ہو جاتے ہیں۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}