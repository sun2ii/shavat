ootnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}