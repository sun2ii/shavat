em":2}]},{"type":"verse","number":7,"content":[{"text":"ہم ایک چڑیا کی مانند","poem":1},{"text":"صیّاد کے جال میں سے بچ نکلے؛","poem":2},{"text":"جال ٹوٹ گیا،","poem":1},{"text":"اَور ہم بچ نکلے۔","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ہماری مدد یَاہوِہ کے نام سے ہے،","poem":1},{"text":"جو آسمان اَور زمین کے خالق ہیں۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}