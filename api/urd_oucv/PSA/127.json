{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["نغمۂ صعُود (ہیکل کی زیارت کا نغمہ)۔ اَز شُلومونؔ۔"]},{"type":"verse","number":1,"content":[{"text":"اگر یَاہوِہ گھر نہ بنائیں،","poem":1},{"text":"تو بنانے والوں کی محنت عبث ہے۔","poem":2},{"text":"اگر یَاہوِہ ہی شہر کی حِفاظت نہ کریں،","poem":1},{"text":"تو نگہبانوں کا جاگنا عبث ہے۔","poem":2}]},{"type":"verse","number":2,"content":[{"text":"تُم خوامخواہ سویرے جلد اُٹھتے ہو،","poem":1},{"text":"اَور رات کو دیر تک جاگتے رہتے ہو،","poem":2},{"text":"اَور مشقّت کی روٹی کھاتے ہو۔","poem":1},{"text":"کیونکہ جِن سے یَاہوِہ مَحَبّت رکھتے ہیں اُنہیں آرام کی نیند بھی بخشتے ہیں۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"بچے یَاہوِہ کی دی ہُوئی مِیراث ہیں،","poem":1},{"text":"اَور بچّے اُن کی طرف سے اجر ہیں۔","poem":2}]},{"type":"verse","number":4,"content":[{"text":"جَوانی کے بیٹے","poem":1},{"text":"زورآور کے ہاتھ میں تیروں کی مانند ہوتے ہیں۔","poem":2}]},{"type":"verse","number":5,"content":[{"text":"مُبارک ہے وہ آدمی،","poem":1},{"text":"جِس کا ترکش اُن سے بھرا ہوتاہے!","poem":2},{"text":"جَب وہ شہر کے پھاٹک پر اَپنے دُشمنوں سے اُلجھیں گے","poem":1},{"text":"تو شرمندہ نہ ہوں گے۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}