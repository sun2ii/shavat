{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["نغمۂ صعُود۔ عبادت کے لئے مُسافری نغمہ۔"]},{"type":"verse","number":1,"content":[{"text":"”میرے دُشمنوں نے میری جَوانی سے مُجھے بہت ستایا،“","poem":1},{"text":"اِسرائیل اَب یہ کہے؛","poem":2}]},{"type":"verse","number":2,"content":[{"text":"”میری جَوانی ہی سے اُنہُوں نے مُجھے بہت ستایا ہے،","poem":1},{"text":"لیکن وہ مُجھ پر غالب نہ آئے۔","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ہل جوتنے والوں نے میری پیٹھ پر ہل چلائے","poem":1},{"text":"اَور اَپنی ریگھاریاں لمبی بنائیں۔","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لیکن یَاہوِہ صادق ہیں؛","poem":1},{"text":"اُنہُوں نے ہی بدکار لوگوں کی رسّیاں کاٹ کر مُجھے آزاد کر دیا۔“","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"صِیّونؔ سے نفرت کرنے والے","poem":1},{"text":"سَب شرم کے مارے پسپا ہُوں۔","poem":2}]},{"type":"verse","number":6,"content":[{"text":"وہ چھت پر کی گھاس کی مانند ہوں،","poem":1},{"text":"جو بڑھنے سے پہلے ہی سُوکھ جاتی ہے؛","poem":2}]},{"type":"verse","number":7,"content":[{"text":"فصل کاٹنے والا اُس سے اَپنی مُٹّھی بھی نہیں بھر پاتا،","poem":1},{"text":"اَور نہ پُولے باندھنے والے کی باہیں بھر پاتی ہیں۔","poem":2}]},{"type":"verse","number":8,"content":[{"text":"آس پاس سے گزرنے والے یہ نہیں کہہ پاتے،","poem":1},{"text":"”تُم پر یَاہوِہ کی برکت ہو؛","poem":2},{"lineBreak":true},{"text":"ہم تُمہیں یَاہوِہ کے نام سے برکت دیتے ہیں۔“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}