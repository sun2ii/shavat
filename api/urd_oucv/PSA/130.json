{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["نغمۂ صعُود۔ عبادت کے لئے مُسافری نغمہ۔"]},{"type":"verse","number":1,"content":[{"text":"اَے یَاہوِہ، میں گہرائیوں میں سے آپ کو پُکارتا ہُوں؛","poem":1}]},{"type":"verse","number":2,"content":[{"text":"اَے خُداوؔند، میری آواز سُن لیں۔","poem":2},{"text":"میری اِلتجائے رحم پر","poem":1},{"text":"آپ کے کان متوجّہ ہوں۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"اگر آپ اَے یَاہوِہ، گُناہوں کو حِساب میں لائیں،","poem":1},{"text":"تو اَے خُداوؔند، کون کھڑا رہ سکےگا؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لیکن مغفرت آپ کے ہاتھ میں ہے؛","poem":1},{"text":"تاکہ آپ کا خوف مانا جائے۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"میں یَاہوِہ کی راہ دیکھتا ہُوں، میری جان منتظر ہے،","poem":1},{"text":"اَور مَیں اُن کے کلام پر بھروسا رکھتا ہُوں۔","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پہرےدار صُبح کا جِتنا اِنتظار کرتے ہیں","poem":1},{"text":"اُن کے صُبح کے اِنتظار سے کہیں زِیادہ،","poem":2},{"lineBreak":true},{"text":"میری جان خُداوؔند کی منتظر ہے۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"اَے اِسرائیل! یَاہوِہ پر اُمّید لگائے رکھو،","poem":1},{"text":"کیونکہ اُن کے ہاتھ میں لافانی مَحَبّت ہے","poem":2},{"lineBreak":true},{"text":"اَور اُن ہی کے پاس پُورا فدیہ ہے۔","poem":2}]},{"type":"verse","number":8,"content":[{"text":"یَاہوِہ خُود اِسرائیل کا فدیہ دے کر،","poem":1},{"text":"اُنہیں اُن کی تمام بدکاری سے چھُڑائیں گے۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}