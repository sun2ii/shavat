{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["نغمۂ صعُود۔ عبادت کے لئے مُسافری نغمہ۔ داویؔد کا زبُور۔"]},{"type":"verse","number":1,"content":[{"text":"اَے یَاہوِہ، میرا دِل مغروُر نہیں ہے،","poem":1},{"text":"اَور نہ میری آنکھیں گھمنڈی ہیں؛","poem":2},{"text":"میں بڑے بڑے مُعاملوں سے کویٔی سروکار نہیں رکھتا","poem":1},{"text":"اَور نہ اُن باتوں سے جو میری سمجھ سے باہر ہوں۔","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لیکن مَیں نے اَپنی جان کو تھپکیاں دے کر خاموش کر دیا ہے؛","poem":1},{"text":"جَیسے ایک دُودھ چھُڑایا ہُوا بچّہ اَپنی ماں کی گود میں ہوتاہے،","poem":2},{"lineBreak":true},{"text":"میری جان میرے اَندر ایک دُودھ چھُڑائے ہُوئے بچّے کے مانند ہی ہے۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"اَے اِسرائیل! اَب سے اَبد تک","poem":1},{"text":"یَاہوِہ ہی سے اَپنی اُمّید وابستہ رکھ۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}