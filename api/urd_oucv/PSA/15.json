{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["داویؔد کا زبُور۔"]},{"type":"verse","number":1,"content":[{"text":"اَے یَاہوِہ، آپ کے مَقدِس میں کون رہے گا؟","poem":1},{"text":"آپ کے مُقدّس پہاڑ پر کون سکونت کرےگا؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"اَور جِس کا کِردار بے اِلزام ہے،","poem":1},{"text":"وہ جو راستبازی پر چلتا ہے،","poem":2},{"lineBreak":true},{"text":"اَور اَپنے دِل سے سچ بولتا ہے،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"جو اَپنی زبان سے جھُوٹے اِلزام نہیں لگاتا،","poem":1},{"text":"اَور اَپنے ہمسایہ سے بدی نہیں کرتا","poem":2},{"lineBreak":true},{"text":"اَور نہ کسی پڑوسی کو بدنام کرتا ہے،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"یَاہوِہ کی نگاہ میں جو کمینے اِنسان کو حقیر جانتا ہے،","poem":1},{"text":"لیکن جو یَاہوِہ کا خوف مانتے ہیں اُن کا اِحترام کرتا ہے؛","poem":2},{"text":"جو قَسم کھا کر اُسے توڑتا نہیں","poem":1},{"text":"خواہ اُسے نُقصان ہی کیوں نہ اُٹھانا پڑے؛","poem":2}]},{"type":"verse","number":5,"content":[{"text":"جو اَپنا رُوپیہ سُود پر نہیں دیتا؛","poem":1},{"text":"اَور بے قُصُور کے خِلاف رشوت نہیں لیتا۔","poem":2},{"lineBreak":true},{"text":"اَیسے کام کرنے والا","poem":1},{"text":"کبھی جنبش نہ کھائے گا۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}