{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["داویؔد کا زبُور۔"]},{"type":"verse","number":1,"content":[{"text":"یَاہوِہ میرا چوپان ہیں، مُجھے کویٔی کمی نہ ہوگی۔","poem":1}]},{"type":"verse","number":2,"content":[{"text":"وہ مُجھے سبز و شاداب چراگاہوں","poem":2},{"noteId":17},{"text":"میں بِٹھاتے ہیں،","poem":2},{"lineBreak":true},{"text":"وہ مُجھے سکون بخش چشموں کے پاس لے جاتے ہیں،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"اَور میری جان کو بحال کرتے ہیں۔","poem":1},{"text":"وہ اَپنے نام کی خاطِر","poem":2},{"lineBreak":true},{"text":"صداقت کی راہوں پر میری رہنمائی کرتے ہیں۔","poem":2}]},{"type":"verse","number":4,"content":[{"text":"خواہ میں موت کی تاریک وادی","poem":1},{"text":"میں سے ہوکر گزروں،","poem":2},{"lineBreak":true},{"text":"تو بھی میں کسی بُلا سے نہ خوف کھاؤں گا،","poem":2},{"text":"کیونکہ آپ میرے ساتھ ہیں،","poem":1},{"text":"آپ کا عصا اَور آپ کی چھڑی،","poem":2},{"lineBreak":true},{"text":"مُجھے تسلّی بخش