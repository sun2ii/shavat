{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"اَے خُدا، میرا اِنصاف کریں،","poem":1},{"text":"اَور ایک بے دین قوم کے خِلاف","poem":2},{"lineBreak":true},{"text":"میری وکالت کریں؛","poem":2},{"text":"اَور دغاباز اَور بدکار لوگوں سے","poem":1},{"text":"مُجھے چھڑائیں۔","poem":2}]},{"type":"verse","number":2,"content":[{"text":"آپ ہی خُدا میرے محکم قلعہ ہیں،","poem":1},{"text":"آپ نے کیوں مُجھے ترک کر دیا؟","poem":2},{"text":"میں دُشمن کے ظُلم کے باعث،","poem":1},{"text":"کیوں ماتم کرتا پھروں؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"اَپنا نُور اَور اَپنی سچّائی ظاہر کریں،","poem":1},{"text":"وُہی میری رہبری کریں؛","poem":2},{"text":"وُہی مُجھے آپ کے مُقدّس پہاڑ","poem":1},{"noteId":27},{"text":"پر،","poem":1},{"text":"اَور آپ کی قِیام گاہ تک پہُنچا دیں۔","poem":2}]},{"type":"verse","number":4,"content":[{"text":"تَب میں خُدا کے مذبح کے پاس جاؤں گا،","poem":1},{"text":"اَور خُدا کے پاس جو میری خُوشی اَور میری شادمانی ہیں۔","poem":2},{"text":"اَے خُدا، میرے خُدا!","poem":1},{"text":"میں بربط پر آپ کی سِتائش کروں گا۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"اَے میری جان، تُو کیوں اُداس ہے؟","poem":1},{"text":"اَور تُو میرے اَندر اِس قدر بےچین کیوں ہے؟","poem":2},{"text":"خُدا سے اُمّید رکھ،","poem":1},{"text":"کیونکہ مَیں پھر اَپنے مُنجّی","poem":2},{"lineBreak":true},{"text":"اَور اَپنے خُدا کی سِتائش کروں گا۔","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"43‏:3 مُقدّس پہاڑ کوہِ صِیّونؔ","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/urd_oucv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}