{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["موسیقی ہدایت کار کے لیٔے۔ داویؔد کا زبُور۔ ایک درخواست۔"]},{"type":"verse","number":1,"content":[{"text":"اَے خُدا، براہِ کرم مُجھے جلد نَجات بخشیں؛","poem":1},{"text":"اَے یَاہوِہ، میری مدد کے لیٔے جلد آئیں۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"جو میری جان کے درپے ہیں","poem":1},{"text":"وہ شرمندہ اَور پریشان ہوں؛","poem":2},{"text":"اَورجو میری بربادی کے خواہاں ہیں","poem":1},{"text":"وہ سَب رُسوا ہوکر پسپا کئے جایٔیں۔","poem":2}]},{"type":"verse","number":3,"content":[{"text":"وہ جو میرے دشمن مُجھ پر، ”آہ! آہ“ کرتے ہیں!","poem":1},{"text":"وہ سَب اَپنی رُسوائی کے باعث پسپا ہو جایٔیں۔","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لیکن جو آپ کی جُستُجو میں ہیں","poem":1},{"text":"آپ میں خُوش و شادمان ہوں؛","poem":2},{"text":"اَورجو آپ کی نَجات کے مُشتاق ہیں، وہ ہمیشہ یہ کہا کریں،","poem":1},{"text":"”یَاہوِہ عظیم ہیں!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"لیکن مَیں تو مسکین اَور مُحتاج ہُوں؛","poem":1},{"text":"اَے خُدا میرے پاس جلد آئیں،","poem":2},{"text":"آپ ہی میرے مددگار اَور میرے چھُڑانے والے ہیں؛","poem":1},{"text":"اَے یَاہوِہ، اَب دیر نہ کریں۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}