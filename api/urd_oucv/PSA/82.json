{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["آسفؔ کا زبُور۔"]},{"type":"verse","number":1,"content":[{"text":"بڑی جماعت میں خُدا ہی صدرِ عدالت ہوتی ہے؛","poem":1},{"text":"اَور ”معبُودوں“ کے درمیان اِنصاف کرتے ہیں:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”تُم کب تک ناراستوں کی حمایت کروگے","poem":1},{"text":"اَور بدکار لوگوں کی طرفداری کروگے؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"مظلوموں اَور یتیموں کی حمایت؛","poem":1},{"text":"مسکینوں اَور مظلوموں کے حُقُوق کی حِفاظت کرو۔","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کمزوروں اَور مُحتاجوں کو بچاؤ؛","poem":1},{"text":"اَور اُنہیں بدکار لوگ کے ہاتھ سے چھُڑاؤ۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”وہ، ’معبُود‘ نہ تو کچھ جانتے ہیں نہ سمجھتے ہیں۔","poem":1},{"text":"اَور تاریکی میں چلتے پھرتے ہیں؛","poem":2},{"lineBreak":true},{"text":"زمین کی تمام بُنیادیں ہلتی ہیں۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”مَیں نے کہا، ’تُم ”معبُود“ ہو؛","poem":1},{"text":"تُم سَب خُداتعالیٰ کے فرزند ہو۔‘","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تو بھی تُم محض اِنسانوں کی طرح مروگے؛","poem":1},{"text":"اَور حُکمرانوں میں سے کسی کی طرح گِر جاؤگے۔“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"اَے خُدا! اُٹھیں اَور زمین کا اِنصاف کریں،","poem":1},{"text":"کیونکہ تمام قومیں آپ کی مِیراث ہیں۔","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/urd_oucv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}