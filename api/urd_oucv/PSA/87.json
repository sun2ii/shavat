{"translation":{"id":"urd_oucv","name":"Biblica® آزادانہ اردو ہم عصر ترجمہ","website":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=urdoucv","licenseNotes":null,"shortName":"OUCV","englishName":"Urdu: Biblica® آزادانہ اردو ہم عصر ترجمہ (Bible)","language":"urd","textDirection":"rtl","sha256":"8a919547236ebcc0e9fb51c7d9be800d0faab47b38de87a1a688086ae67c1218","availableFormats":["json"],"listOfBooksApiLink":"/api/urd_oucv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31099,"languageName":"اردو","languageEnglishName":"Urdu"},"book":{"id":"PSA","translationId":"urd_oucv","name":"زبُور","commonName":"زبُور","title":"زبُور کی کِتاب","order":19,"numberOfChapters":150,"sha256":"dccd170e340e9fddaeb5682d76cfa7f3ecc054d19c428d2b39e8829bc40f3fd9","firstChapterNumber":1,"firstChapterApiLink":"/api/urd_oucv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/urd_oucv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["بنی قورحؔ کی تصنیف ایک زبُور۔ ایک نغمہ۔"]},{"type":"verse","number":1,"content":[{"text":"یَاہوِہ نے اَپنی بُنیاد مُقدّس پہاڑ پر رکھی ہے؛","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"یَاہوِہ صِیّونؔ کے پھاٹکوں کو","poem":1},{"text":"یعقوب کے سَب قِیام گاہوں سے زِیادہ عزیز رکھتے ہیں۔","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"اَے خُدا کے شہر!","poem":1},{"noteId":69},{"text":"آپ کے بارے میں شاندار باتیں کہی جاتی ہیں:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"”میں راحبؔ اَور بابیل کے نام","poem":1},{"text":"اَپنے جاننے والوں کی فہرست میں درج کروں گا،","poem":2},{"text":"فلسطین اَور کُوشؔ بھی صُورؔ سمیت اُن میں شامل ہوں گے۔","poem":1},{"text":"اَور کہُوں گا، ’یہ صِیّونؔ میں پیدا ہُوا تھا۔‘ “","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بے شک، صِیّونؔ کے متعلّق یہ کہا جائے گا،","poem":1},{"text":"”فُلاں فُلاں اَشخاص اُس میں پیدا ہُوئے تھے،","poem":2},{"lineBreak":true},{"text":"اَور خُداتعالیٰ آپ اُسے قائِم کریں گے۔“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"یَاہوِہ کِتاب اَقوام میں درج کریں گے:","poem":1},{"text":"”یہ شخص صِیّونؔ میں پیدا ہُوا تھا۔“","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"جوں ہی ساز چھیڑا جائے گا لوگ گائیں گے،","poem":1},{"text":"”میرے سَب چشمے آپ ہی میں ہیں۔“","poem":2}]}],"footnotes":[{"noteId":69,"caller":"+","text":"87‏:3 خُدا کے شہر! یروشلیمؔ خُدا کا شہر کہلاتا ہے۔","reference":{"chapter":87,"verse":3}}]},"thisChapterLink":"/api/urd_oucv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/urd_oucv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/urd_oucv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}