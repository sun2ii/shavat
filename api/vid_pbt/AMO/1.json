{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"AMO","translationId":"vid_pbt","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"8c4f723460bbf177f28da84db575e3d0c7910e2c67509a25704abd6ed9107209","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/vid_pbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"heading","content":["Kuwala kikala kwa mloli Amosi"]},{"type":"verse","number":1,"content":["Ulonzi wa Amosi, yumwe wa wadimi wa kuli muji wa Tekowa. Nguluwi nakamgubulila Amosi uloli weng'ha kuwala Isilaeli, miyaka mili kung'hali kulawila limachinyina, mhela Usiya vyoyawele mndewa wa Yuda na Yeloboamu, mwana wa Yoashi, vyoyawele mndewa wa Isilaeli."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Amosi nakalonga hino,","poem":1},{"lineBreak":true},{"text":"“Mkulu Nguluwi kangubuma kulawa kuli chidunda cha Siyoni,","poem":1},{"lineBreak":true},{"text":"kangulandula lizi kulawa Yelusalemu,","poem":1},{"lineBreak":true},{"text":"mbaka honhu ha kudimila migongolo hangukala,","poem":1},{"lineBreak":true},{"text":"misolo ja kuli chidunda cha Kalimeli janguswinha.”","poem":1}]},{"type":"heading","content":["Utaguso wa Nguluwi kwa wanhu wa isi za habehi na Isilaeli"]},{"type":"heading","content":["Damasiko"]},{"type":"verse","number":3,"content":[{"text":"Mkulu Nguluwi kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Wanhu wa Damasiko nawalutilila kudita gehile,","poem":1},{"lineBreak":true},{"text":"ahyo, sileka kuwagaza,","poem":1},{"lineBreak":true},{"text":"nawawadumya ng'hatu wanhu wa Gileadi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lelo, ndodulisa chiluli kuli ng'handa ya mndewa Hasaeli,","poem":1},{"lineBreak":true},{"text":"nacho chozilakaza ng'hatu ngome za mndewa Beni-hadadi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndobenanga lwizi lweng'ha lwa muji wa Damasiko,","poem":1},{"lineBreak":true},{"text":"na kuwosa walingikala kuli ibindi lya Aweni,","poem":1},{"lineBreak":true},{"text":"hamwe na chilongozi wa Beti-edeni.","poem":1},{"lineBreak":true},{"text":"Wanhu wa Alamu wohilikwa kuli isi yinji ya Kili.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi nandonga.”","poem":1}]},{"type":"heading","content":["Filistiya"]},{"type":"verse","number":6,"content":[{"text":"Mkulu Nguluwi kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Wanhu wa Gasa nawalutilila kudita gehile,","poem":1},{"lineBreak":true},{"text":"ahyo sileka kuwagaza.","poem":1},{"lineBreak":true},{"text":"Nawawahilika wanhu wa miji jeng'ha,","poem":1},{"lineBreak":true},{"text":"nawawaguza leka wawe wapogozi ako Edomu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lelo, ndodulisa chiluli kuli ng'hanzi za muji wa Gasa,","poem":1},{"lineBreak":true},{"text":"nacho chozilakaza ng'hatu ngome za muji awo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndowosa walingikala kuli muji wa Ashidodi,","poem":1},{"lineBreak":true},{"text":"hamwe na chilongozi wa Ashikeloni.","poem":1},{"lineBreak":true},{"text":"Ndogolola moko kuli Ekiloni,","poem":1},{"lineBreak":true},{"text":"Wafilisti weng'ha wasigale wobagama.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi Mbele na Ludali nandonga.”","poem":1}]},{"type":"heading","content":["Tilo"]},{"type":"verse","number":9,"content":[{"text":"Mkulu Nguluwi kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Wanhu wa Tilo nawalutilila kudita gehile,","poem":1},{"lineBreak":true},{"text":"lelo sileka kuwagaza.","poem":1},{"lineBreak":true},{"text":"Nawawahilika wanhu wa miji jeng'ha mbaka Edomu, leka wawe wapogozi,","poem":1},{"lineBreak":true},{"text":"nawalibelenhuka ilagano lya goloko lyowaliditile.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lelo, ndodulisa chiluli kuli ng'hanzi za muji wa Tilo,","poem":1},{"lineBreak":true},{"text":"na kuzilakaza ng'hatu ngome za muji awo.”","poem":1}]},{"type":"heading","content":["Edomu"]},{"type":"verse","number":11,"content":[{"text":"Mkulu Nguluwi kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Wanhu wa Edomu nawalutilila kudita gehile,","poem":1},{"lineBreak":true},{"text":"ahyo sileka kuwagaza.","poem":1},{"lineBreak":true},{"text":"Nawaluta kwa wang'holozawo Waisilaeli kwa mipanga,","poem":1},{"lineBreak":true},{"text":"nawosa ng'hatu isungu lya hewo lyeng'ha lya chilukolo.","poem":1},{"lineBreak":true},{"text":"Ng'halazi ya hewo haiwele ya kuduma,","poem":1},{"lineBreak":true},{"text":"nawaileka ikwaka mazuwa gose.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lelo, ndodulisa chiluli kuli ng'hanzi za muji wa Temani,","poem":1},{"lineBreak":true},{"text":"na kuzilakaza ng'hatu ngome za Bosila.”","poem":1}]},{"type":"heading","content":["Amoni"]},{"type":"verse","number":13,"content":[{"text":"Mkulu Nguluwi kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Wanhu wa Amoni nawalutilila kudita gehile,","poem":1},{"lineBreak":true},{"text":"ahyo sileka kuwagaza.","poem":1},{"lineBreak":true},{"text":"Kuli ngondo ya hewo ya kuihola isi,","poem":1},{"lineBreak":true},{"text":"nawawatubula wadala wawele na himila kuli isi ya Gileadi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lelo, ndodulisa chiluli kuli ng'hanzi za muji wa Laba,","poem":1},{"lineBreak":true},{"text":"na kuzilakaza ng'hatu ngome zake.","poem":1},{"lineBreak":true},{"text":"Zuwa alyo lya ngondo kowa na iyowe likulu,","poem":1},{"lineBreak":true},{"text":"na kitowa kowa kukulu kota chivuluvumbi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mndewa wa hewo na vilongozi wa heye,","poem":1},{"lineBreak":true},{"text":"weng'ha wohilikwa kuli isi yinji.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi nandonga.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}