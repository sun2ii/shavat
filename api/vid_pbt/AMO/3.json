{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"AMO","translationId":"vid_pbt","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"8c4f723460bbf177f28da84db575e3d0c7910e2c67509a25704abd6ed9107209","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/vid_pbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Hemwe Waisilaeli, muuhulichize ulonzi uwele Mkulu Nguluwi woyalonjile kwa chiwalo cha hemwe, hemwe wanhu weng'ha wa isi yawalavile kuli isi ya Misili."]},{"type":"verse","number":2,"content":[{"text":"Nakalonga ahi, “Hali wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"hemwe ndo ndiwahagule.","poem":1},{"lineBreak":true},{"text":"Ahyo ndowagaza hemwe,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha gehile ga hemwe geng'ha.”","poem":1}]},{"type":"heading","content":["Mijito ja mloli"]},{"type":"verse","number":3,"content":[{"text":"Ndaze, wanhu weli wokwaluka majendo hamwe,","poem":1},{"lineBreak":true},{"text":"ne kikundiza tandi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndaze, isimba lyangubumaga kisolo","poem":1},{"lineBreak":true},{"text":"kuno lyahela chilyo?","poem":1},{"lineBreak":true},{"text":"Ndaze, isimba lyoweza kubuma kuli mhalika ya heye","poem":1},{"lineBreak":true},{"text":"kuno halibatile chinhu?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndaze, idiwa ne nyhule","poem":1},{"lineBreak":true},{"text":"lyogwiliza chideje?","poem":1},{"lineBreak":true},{"text":"Ndaze, idiwa lyangugwilizaga","poem":1},{"lineBreak":true},{"text":"ne kudolizwa na chinhu?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndaze, mhalamhanda ya ngondo hoipembigwa kuli muji,","poem":1},{"lineBreak":true},{"text":"wanhu hambe wadumbe?","poem":1},{"lineBreak":true},{"text":"Ndaze, muji wangufichigwa na kubagama","poem":1},{"lineBreak":true},{"text":"kohakugaligwe na Mkulu Nguluwi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndikomya, Mkulu Nguluwi hambe yadite chinhu","poem":1},{"lineBreak":true},{"text":"ne kuwagubulila vitumagwa wa heye waloli kunuwila kwa heye.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wone isimba libume,","poem":1},{"lineBreak":true},{"text":"whaani halingudumba?","poem":1},{"lineBreak":true},{"text":"Wone Mkulu Nguluwi yalonje,","poem":1},{"lineBreak":true},{"text":"whaani yoleka kulavya uloli?","poem":1}]},{"type":"heading","content":["Kudumigwa kwa Samaliya"]},{"type":"verse","number":9,"content":[{"text":"Muwikule kuli ng'handa za mndewa wa Ashidodi,","poem":1},{"lineBreak":true},{"text":"na kuli ng'handa za mndewa za isi ya Misili.","poem":1},{"lineBreak":true},{"text":"“Mikungajize kuli vidunda vilinguizunguluta isi ya Samaliya,","poem":1},{"lineBreak":true},{"text":"mkalole lunhwinhwi lukulu","poem":1},{"lineBreak":true},{"text":"na kubunza kulingukoleka amo.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Wanhu wano nawazimemeza ng'handa za hewo","poem":1},{"lineBreak":true},{"text":"vinhu vya kuhiza na kuboka.","poem":1},{"lineBreak":true},{"text":"Hawavizelele ng'hatu kudita ganojile!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ahyo, mng'honyo koizunguluta isi ya hewo,","poem":1},{"lineBreak":true},{"text":"kobomola honhu hawo ha kiyamila,","poem":1},{"lineBreak":true},{"text":"na kuzihola ngome za hewo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kota mdimi vyoyalingulisukula isimba kuli mlomo","poem":1},{"lineBreak":true},{"text":"magulu meli hela ama chihande cha ikutu lya ing'holo,","poem":1},{"lineBreak":true},{"text":"ahyo ndo vyowosulupuka wanhu wachefu hela wa Isilaeli walingikala Samaliya.","poem":1},{"lineBreak":true},{"text":"Wosigala na itendego lya chinhanda na honhu hado ha chigoda.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mkulu Nguluwi Yawele na Mong'ho kangulonga hino,","poem":1},{"lineBreak":true},{"text":"“Mhulichize, mkawakanye walelwa wa Yakobo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zuwa londiwadumya Waisilaeli","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha gehile ga hewo,","poem":1},{"lineBreak":true},{"text":"ndowifya chila honhu ha kulavila nhambiko kuli muji wa Beteli.","poem":1},{"lineBreak":true},{"text":"Ndobena mbalati za chila honhu ha kulavila nhambiko","poem":1},{"lineBreak":true},{"text":"na kuzigwisa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndoziwifya ng'handa zeng'ha za kuli muji na vijiji,","poem":1},{"lineBreak":true},{"text":"ndozibomola ng'handa zinolijigwe kwa mbalati,","poem":1},{"lineBreak":true},{"text":"ng'handa ng'hulu haisigala ne imwe.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi nandonga.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}