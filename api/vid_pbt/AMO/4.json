{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"AMO","translationId":"vid_pbt","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"8c4f723460bbf177f28da84db575e3d0c7910e2c67509a25704abd6ed9107209","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/vid_pbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Mhulichize ulonzi awu,","poem":1},{"lineBreak":true},{"text":"hemwe wadala muwele namneneha kota misenga ja Bashani","poem":1},{"lineBreak":true},{"text":"muwele ako kuli chidunda cha Samaliya,","poem":1},{"lineBreak":true},{"text":"hemwe mlinguwagaza ng'hochele,","poem":1},{"lineBreak":true},{"text":"mlinguwabunza wazunwa,","poem":1},{"lineBreak":true},{"text":"na kuwalonjela walume wa hemwe,","poem":1},{"lineBreak":true},{"text":"“Mtigalile divai tunwe!”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heni Mkulu Nguluwi mbele yelile nandilaha,","poem":1},{"lineBreak":true},{"text":"“Lole, mhela wanguya,","poem":1},{"lineBreak":true},{"text":"uwele moholigwa na ndoano,","poem":1},{"lineBreak":true},{"text":"chila yumwe wa hemwe kota somba kuli ndoano.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mobulunwa mbaka kuli lukanzi lubomoligwe,","poem":1},{"lineBreak":true},{"text":"motozigwa kunze kulutila Halimoni.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi ndangulonga.","poem":1}]},{"type":"heading","content":["Isilaeli haijesile kudita goya"]},{"type":"verse","number":4,"content":[{"text":"“Hemwe Waisilaeli,","poem":1},{"lineBreak":true},{"text":"mlute ako Beteli mkabelenhuche,","poem":1},{"lineBreak":true},{"text":"mlute Giligali leka mlutilile kudita gehile.","poem":1},{"lineBreak":true},{"text":"Mlavye nhambiko za hemwe chila mitondo,","poem":1},{"lineBreak":true},{"text":"na zaka za hemwe chila zuwa lya kadatu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mlavye mibumunda jiwichigwe usaso kota nhambiko ya kulonga malumbo,","poem":1},{"lineBreak":true},{"text":"mitogole kuwala nhambiko za hemwe za kunuwila,","poem":1},{"lineBreak":true},{"text":"mdite ahyo kwa chiwalo cha nhambiko azo, hemwe Waisilaeli,","poem":1},{"lineBreak":true},{"text":"kwa vila acho ndo chomlingugana kudita.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi nandonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Siwapele chilyo,","poem":1},{"lineBreak":true},{"text":"nanyambuza lufemba kuli chila muji,","poem":1},{"lineBreak":true},{"text":"ila mng'hali mwangulema kunyhiluchila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kahi nandiilemeza nhonya myezi jidatu kung'hali mhela wa mbena.","poem":1},{"lineBreak":true},{"text":"Nandiidita nhonya itowe kuli muji umwe,","poem":1},{"lineBreak":true},{"text":"ila nandiilemeza kutowa kuli miji jiyage.","poem":1},{"lineBreak":true},{"text":"Mgunda umwe naupata nhonya,","poem":1},{"lineBreak":true},{"text":"wunji haupatile, nawo naukala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wanhu nawalubaluba kulawa muji umwe mbaka uyage kupala mazi,","poem":1},{"lineBreak":true},{"text":"ila hawapatile ga kuhega kunwa,","poem":1},{"lineBreak":true},{"text":"ila mng'hali mwangulema kunyhiluchila.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi nandonga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nandiwagaza kwa kuvitowa vigunda vya hemwe na migunda ja hemwe ja mizabibu kwa lungwi,","poem":1},{"lineBreak":true},{"text":"nzije nazilya mitini na mizeituni ja hemwe,","poem":1},{"lineBreak":true},{"text":"ila mng'hali mwangulema kunyhiluchila.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nandiwagalila hemwe magazo","poem":1},{"lineBreak":true},{"text":"kota gala gondigahiliche kula Misili.","poem":1},{"lineBreak":true},{"text":"Nandiwakopola wasongolo wa hemwe kuli ngondo,","poem":1},{"lineBreak":true},{"text":"nandiwahola falasi wa hemwe wa ngondo.","poem":1},{"lineBreak":true},{"text":"Mitufi najimema kuli kambi za hemwe,","poem":1},{"lineBreak":true},{"text":"na kunhung'ha kwa ajo nakwali hali mhenyelo za hemwe.","poem":1},{"lineBreak":true},{"text":"Ila mng'hali mwangulema kunyhiluchila.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nandiwagwisa wamwe wa hemwe kwa kuwadumya kota vyondizidumile Sodoma na Gomola.","poem":1},{"lineBreak":true},{"text":"Wala wasulupuche hali hemwe,","poem":1},{"lineBreak":true},{"text":"nawali kota ngoda iloholigwe kuli chiluli.","poem":1},{"lineBreak":true},{"text":"Ila mng'hali mwangulema kunyhiluchila.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lelo, ago ndo gondiwaditila Waisilaeli.","poem":1},{"lineBreak":true},{"text":"Kwa vila ndodita mbuli ayo,","poem":1},{"lineBreak":true},{"text":"ahyo miwiche goya kubochela utaguso wa Nguluwi wa hemwe!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nguluwi ndo yaviditile vidunda,","poem":1},{"lineBreak":true},{"text":"na kulumba mbeho,","poem":1},{"lineBreak":true},{"text":"ndo yamzelese munhu majesa ga heye,","poem":1},{"lineBreak":true},{"text":"ndo yalingugalusa nemisi kuwa nechilo,","poem":1},{"lineBreak":true},{"text":"na kubiga vinhembenhembe vya isi.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi Yawele na Mong'ho ndo itagwa lya heye!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}