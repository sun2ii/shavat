{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"HAB","translationId":"vid_pbt","name":"Habakuki","commonName":"Habakuki","title":"Habakuki","order":35,"numberOfChapters":3,"sha256":"5d0627f19ce8c69eabd8d8da3a0ec9f91f69553fc49091c181a720ea635bb90d","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/vid_pbt/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ulonzi wa Nguluwi woyaubochele mloli Habakuki."]},{"type":"heading","content":["Habakuki kangwaluka kung'ung'uta"]},{"type":"verse","number":2,"content":[{"text":"“Gwa, Mkulu Nguluwi, mbaka hanili ndokulanda utanzi,","poem":1},{"lineBreak":true},{"text":"lekachoni hulingunyhulichiza?","poem":1},{"lineBreak":true},{"text":"Lekachoni ndangulila, ‘Kilewa,’","poem":1},{"lineBreak":true},{"text":"ila hulingulohola?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lekachoni kwangundita ndigone gehile na kubunza?","poem":1},{"lineBreak":true},{"text":"Kuwifya na kilewa vyangunzunguluta,","poem":1},{"lineBreak":true},{"text":"kitwanza na magazo vyangulutilila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ahyo malajizo gahela mong'ho,","poem":1},{"lineBreak":true},{"text":"na hachi hambe ikoleche.","poem":1},{"lineBreak":true},{"text":"Wehile wanguwazunguluta watanganiche,","poem":1},{"lineBreak":true},{"text":"ahyo utaguso wangulavigwa kwa kwajilizwa.”","poem":1}]},{"type":"heading","content":["Kwidichila kwa Nguluwi"]},{"type":"verse","number":5,"content":[{"text":"Nguluwi nakalonga,","poem":1},{"lineBreak":true},{"text":"“Uwalole wanhu wa isi zinji!","poem":1},{"lineBreak":true},{"text":"Kobubuwala na kona vinduzanduza.","poem":1},{"lineBreak":true},{"text":"Kwa vila ndodita chinhu louwa ung'hali mkomu,","poem":1},{"lineBreak":true},{"text":"hanga wahalonjelwe, hawalikunda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwa vila ndanguwapa mong'ho Wababuloni,","poem":1},{"lineBreak":true},{"text":"wanhu wa isi wawele na nhumbula zihile na walingudita chinhu himahima.","poem":1},{"lineBreak":true},{"text":"Walingukola kuli isi yeng'ha,","poem":1},{"lineBreak":true},{"text":"leka kuhola haluga ha wanhu wanji.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndo wanhu walingudumbigwa na walingukabusa,","poem":1},{"lineBreak":true},{"text":"kwa kidaya kwawo, utaguso wa hewo wangulawa mnhumbula za hewo wawo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Falasi wa hewo ndo wabewe kusinda iduma,","poem":1},{"lineBreak":true},{"text":"wang'hang'hala kusinda mibwa ja kisolo jiwele na nzala.","poem":1},{"lineBreak":true},{"text":"Falasi wa hewo wangubilima ng'hatu kulawa kutali,","poem":1},{"lineBreak":true},{"text":"wangunyonzoka himahima kota ikungule lilinguhola upelembi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Weng'ha wangugana kilewa,","poem":1},{"lineBreak":true},{"text":"vilundo vya hewo vya wamizi vyangulutilila kumwando,","poem":1},{"lineBreak":true},{"text":"kota mbeho ya kolilawilaga isanya,","poem":1},{"lineBreak":true},{"text":"kuno wangukungajiza wapogozi wa ngondo kota sangalaza.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wanguwabeza wandewa,","poem":1},{"lineBreak":true},{"text":"wanguwaseka vilongozi.","poem":1},{"lineBreak":true},{"text":"Chila ngome ndo idaba kwa hewo,","poem":1},{"lineBreak":true},{"text":"nawazenga chinhu cha misanga cha kukwinila kuli lukanzi na kuuhola muji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hamba wangukola himahima kota mbeho na kuluta kumwando,","poem":1},{"lineBreak":true},{"text":"ndo wanhu wawele na gehile,","poem":1},{"lineBreak":true},{"text":"kwa vila mong'ho wa hewo ndo mlungu wa hewo.”","poem":1}]},{"type":"heading","content":["Habakuki kangung'ung'uta kahi"]},{"type":"verse","number":12,"content":[{"text":"Gwa Mkulu Nguluwi, ndaze, hegwe hauwele wa kulawa katali?","poem":1},{"lineBreak":true},{"text":"Hegwe ndo Nguluwi wa heni, Yelile wa heni, yohambe ubagame.","poem":1},{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, nakuwahagula Wababuloni watutaguse,","poem":1},{"lineBreak":true},{"text":"hegwe italawe, nakuwakangaza leka watugaze.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hegwe kwa yelile ng'hatu, haulinguukunda wihe,","poem":1},{"lineBreak":true},{"text":"mazuwa gose haulingwimilila kulola gehile.","poem":1},{"lineBreak":true},{"text":"Lekachoni lelo kwanguwona walingudita gehile na kunyamalila?","poem":1},{"lineBreak":true},{"text":"Lekachoni kwangunyamalila wehile howowadumya","poem":1},{"lineBreak":true},{"text":"wala wanhu watanganiche kusinda hewo?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nakuwadita wanhu wawe kota somba mbahali,","poem":1},{"lineBreak":true},{"text":"kota vilumbigwe vilingutambala vilihela chilongozi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wababuloni wanguwalowa wanhu kwa ndowano,","poem":1},{"lineBreak":true},{"text":"wanguwakwega kwa utandawala wa hewo,","poem":1},{"lineBreak":true},{"text":"wanguwakungajiza weng'ha kuli utandawala wa hewo,","poem":1},{"lineBreak":true},{"text":"hamba wangusangalala na kutowa luchenze.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lelo wangulavya nhambiko kwa chiwalo cha utandawala wa hewo,","poem":1},{"lineBreak":true},{"text":"na kufunyizila ubani,","poem":1},{"lineBreak":true},{"text":"kwa vila kwa awo wanguweza kulya chilyo cha kuhega,","poem":1},{"lineBreak":true},{"text":"na kuwa na chilyo chinji lukami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ndaze, mazuwa gose hawoleka kukwega utandawala wa hewo?","poem":1},{"lineBreak":true},{"text":"Ndaze, wolutilila kuwagwiliza wanhu","poem":1},{"lineBreak":true},{"text":"na kuwadumya wanhu wa isi ne kuwonela isungu?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}