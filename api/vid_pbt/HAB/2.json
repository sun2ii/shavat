{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"HAB","translationId":"vid_pbt","name":"Habakuki","commonName":"Habakuki","title":"Habakuki","order":35,"numberOfChapters":3,"sha256":"5d0627f19ce8c69eabd8d8da3a0ec9f91f69553fc49091c181a720ea635bb90d","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/vid_pbt/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ndokwima mchanya mwa ilingo,",{"text":"siwasa leka nyhuliche choni choyondonjela Mkulu Nguluwi","poem":1},{"lineBreak":true},{"text":"na konyhidichila ndaze kuwala kung'ung'uta aku.","poem":1}]},{"type":"heading","content":["Nguluwi kangumwidichila kahi Habakuki"]},{"type":"verse","number":2,"content":[{"text":"Hamba, Mkulu Nguluwi nakedichila,","poem":1},{"lineBreak":true},{"text":"“Wandiche uloli awu,","poem":1},{"lineBreak":true},{"text":"wandiche hazelu mchanya mwa vibawo,","poem":1},{"lineBreak":true},{"text":"leka yalingukola aho yasome.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Uloli wuno wangubeteza mhela uwichigwe,","poem":1},{"lineBreak":true},{"text":"ndo uloli wa kukomya kuwala kuduma.","poem":1},{"lineBreak":true},{"text":"Wone wangoneka wangukawila, ubeteze,","poem":1},{"lineBreak":true},{"text":"ndangukomya wofika, haukawila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Uwalole walingidaya, wodumigwa,","poem":1},{"lineBreak":true},{"text":"ila watanganiche wochikala kwa makundo ga hewo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mzidi wa ago divai yangwajiliza,","poem":1},{"lineBreak":true},{"text":"yalingidaya hokwesela.","poem":1},{"lineBreak":true},{"text":"Maya ga heye ndo kota isi ya wabagame,","poem":1},{"lineBreak":true},{"text":"kota vila kubagama, halingiguta.","poem":1},{"lineBreak":true},{"text":"Kangikungajizila wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"na wanhu wanji weng'ha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Munhu kota ayo kobezigwa na chila munhu","poem":1},{"lineBreak":true},{"text":"na kumlonga kwa nhelo za idaba,","poem":1},{"lineBreak":true},{"text":"‘Kochona hegwe ulingukungajiza vinhu vyohaviwele vya hegwe","poem":1},{"lineBreak":true},{"text":"na kuhola lehani ya vinhu vya wanhu ila hulingulipa!","poem":1},{"lineBreak":true},{"text":"Kolutilila kudita ahyo mbaka nili?’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zuwa limwe walingukudayi wokwinuka baho du","poem":1},{"lineBreak":true},{"text":"na kukudita ukakame.","poem":1},{"lineBreak":true},{"text":"Nagwe kowa mpogozi wa hewo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nakuvihola vinhu vya wanhu wa isi nyinji,","poem":1},{"lineBreak":true},{"text":"ila weng'ha wawele wosulupuka, wovihola vinhu vya hegwe.","poem":1},{"lineBreak":true},{"text":"Mbuli ayo yokufika kwa vila nakukopola na kubunza kuli isi,","poem":1},{"lineBreak":true},{"text":"ena, nakudita ahyo kuli miji na kwa wenyeng'haye wake weng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kochona hegwe ulingupata lufufu kwa kubunza,","poem":1},{"lineBreak":true},{"text":"ulinguzenga ng'handa ya hegwe mchanya kuli chidunda,","poem":1},{"lineBreak":true},{"text":"ulingijesa kota kwangiwika kutali na kuwifya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ila kwa kiwika goya kwa hegwe nakuwabasa soni wanhu wa nhanzi ya hegwe.","poem":1},{"lineBreak":true},{"text":"Kwa kuwadumya wanhu wa isi nyinji,","poem":1},{"lineBreak":true},{"text":"nakuudumya ukomu wa hegwe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maganga ga kuli lukanzi gotowa iyowe","poem":1},{"lineBreak":true},{"text":"na boliti za ng'handa zokwidichila kwa iyowe kahi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kochona hegwe ulinguzenga muji kwa kukopola,","poem":1},{"lineBreak":true},{"text":"ulinguudita muji uwe nzinzili kwa wihe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi Yawele na Mong'ho,","poem":1},{"lineBreak":true},{"text":"kangwambuzaga kikangaza kwa wanhu kwajilile kuli chiluli,","poem":1},{"lineBreak":true},{"text":"na wanhu wa isi zinji wetunye hihi hela.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kwa vila isi yomemezwa na uwanzi wa ukulu wa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kota vila mazi vyogalingwenela mbahali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kochona hegwe ulinguwadita womlingikalasa habehi wagale,","poem":1},{"lineBreak":true},{"text":"kwa kuwapa divai nyinji,","poem":1},{"lineBreak":true},{"text":"leka uwone umwanzi wa hewo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Komema soni honhu ha lutogo.","poem":1},{"lineBreak":true},{"text":"Konwa gwegwe baho na kuulajila umwanzi wa hegwe!","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi yuye kokudita ugale","poem":1},{"lineBreak":true},{"text":"na soni yogubika lutogo lwa hegwe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wihe wouuditile Lebanoni wokuvaba,","poem":1},{"lineBreak":true},{"text":"nakujikopola migongolo, migongolo najo jokutinhusa.","poem":1},{"lineBreak":true},{"text":"Ago geng'ha gokufika,","poem":1},{"lineBreak":true},{"text":"kwa vila nakukopola na kubunza kuli isi,","poem":1},{"lineBreak":true},{"text":"ena, nakudita ahyo kuli miji na kwa wenyeng'haye wake weng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Limalukolo ligongomanyigwe na munhu lyotanza choni?","poem":1},{"lineBreak":true},{"text":"Limalukolo ndo chuma cha sendi nyinji chilingusungulumulwa,","poem":1},{"lineBreak":true},{"text":"ndo chinhu chilingweneza uhadi.","poem":1},{"lineBreak":true},{"text":"Yalingugongomanya limalukolo kangitumbila choyachigongomanye yuye,","poem":1},{"lineBreak":true},{"text":"limalukolo liwele halilingulonga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kochona munhu yalingulilonjela izinga, ‘Ulilimche!’","poem":1},{"lineBreak":true},{"text":"Ama iganga lyohambe lilonje, ‘Winuche!’","poem":1},{"lineBreak":true},{"text":"Ndaze, limalukolo lyoweza kumlangusa munhu?","poem":1},{"lineBreak":true},{"text":"Ulole, nalibakalizwa zahabu na sendi,","poem":1},{"lineBreak":true},{"text":"na lyahela ukomu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ila Mkulu Nguluwi ka kuli ng'handa ya heye yelile,","poem":1},{"lineBreak":true},{"text":"isi yeng'ha inyamalile hali heye.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}