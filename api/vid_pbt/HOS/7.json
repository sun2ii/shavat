{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"HOS","translationId":"vid_pbt","name":"Hoseya","commonName":"Hoseya","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"dabbe34568662d9ec1b7146f42e8b93a4fb4e6ce5ecf4d745af124e8a314eaf1","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/vid_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“chila mhela longanile kuwalohola Waisilaeli,","poem":1},{"lineBreak":true},{"text":"wihe wa wanhu wa Isilaeli nawali ugubuligwa,","poem":1},{"lineBreak":true},{"text":"madito gehile ga Samaliya nagali golawila.","poem":1},{"lineBreak":true},{"text":"Wangudita uhadi,","poem":1},{"lineBreak":true},{"text":"wahizi wangubena ng'handa,","poem":1},{"lineBreak":true},{"text":"wabokaji wanguvaba mnzila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hawalingijesa ne hado kota heni,","poem":1},{"lineBreak":true},{"text":"ndangukumbuchila gehile ga hewo geng'ha.","poem":1},{"lineBreak":true},{"text":"Lelo madito ga hewo gehile nagawazunguluta banzi zeng'ha,","poem":1},{"lineBreak":true},{"text":"geng'ha gowaditile ga kumwando kwa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Wangumdita mndewa yasangalale kwa wihe wa hewo,","poem":1},{"lineBreak":true},{"text":"wanguwadita vilongozi wasangalale kwa udesi wa hewo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Weng'ha ndo wang'hondwa,","poem":1},{"lineBreak":true},{"text":"hewo wana maya kota itanulu liwichigwe chiluli","poem":1},{"lineBreak":true},{"text":"chiwele yalingubanika mibumunda halinguganigwa kuchibwina,","poem":1},{"lineBreak":true},{"text":"kulawa hala hoyatijile utimbo","poem":1},{"lineBreak":true},{"text":"mbaka hala ibumunda holiwa goya kwa kubanichigwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuli mnvina ya mndewa,","poem":1},{"lineBreak":true},{"text":"nawawadita vilongozi wa hewo wagale ng'hatu mbaka wadeche,","poem":1},{"lineBreak":true},{"text":"naye mndewa nakehanza hamwe na walingudita idaba.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kota itanulu vyolilingwaka,","poem":1},{"lineBreak":true},{"text":"nhumbula za hewo zangwaka kwa maya,","poem":1},{"lineBreak":true},{"text":"nechilo yeng'ha ng'halazi yangulavya iyosi,","poem":1},{"lineBreak":true},{"text":"hoifika mitondo, yangwaka kota milapi ja chiluli.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Weng'ha wana ng'halazi kota itanulu lilingwaka","poem":1},{"lineBreak":true},{"text":"wanguwadumya vilongozi wa hewo.","poem":1},{"lineBreak":true},{"text":"Wandewa wa hewo weng'ha nawagwa,","poem":1},{"lineBreak":true},{"text":"haduhu ne yumwe hali hewo yalingundanda utanzi.”","poem":1}]},{"type":"heading","content":["Wanhu wa Isilaeli wangitumbila kwa wanhu wa isi zinji"]},{"type":"verse","number":8,"content":[{"text":"Nguluwi kangulutilila kulonga,","poem":1},{"lineBreak":true},{"text":"“Wanhu wa Isilaeli wangihanza na wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"wangoneka kota ibumunda liwele halipile.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wajenzi wanguhola mong'ho wa hewo,","poem":1},{"lineBreak":true},{"text":"ila hewo hawavizelele,","poem":1},{"lineBreak":true},{"text":"mbuliza nazenela kumutwi kwa hewo,","poem":1},{"lineBreak":true},{"text":"ila hewo wahela mbuli yoneche.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kidaya kwa wanhu wa Isilaeli kwangilajila hali hewo,","poem":1},{"lineBreak":true},{"text":"hanga aga geng'ha gangulawila,","poem":1},{"lineBreak":true},{"text":"ila hawangalamchile heni Mkulu Nguluwi, Nguluwi wa hewo, ne kumhala.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wanhu wa Isilaeli ndo kota ng'hunda,","poem":1},{"lineBreak":true},{"text":"wanguhadigwa chiubewe na wahela nyhala,","poem":1},{"lineBreak":true},{"text":"mhela umwenga wanguchema Misili,","poem":1},{"lineBreak":true},{"text":"mhela wunji wangugaluchila Ashulu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mhela howoluta, ndotoza utandawala wa heni mchanya mwa hewo,","poem":1},{"lineBreak":true},{"text":"ndowakwega leka wagwe kota videje.","poem":1},{"lineBreak":true},{"text":"Hondihulika mbuli kota naweting'hana, ndowagwiliza.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wochona, kwa vila nawajilila.","poem":1},{"lineBreak":true},{"text":"Kudumigwa kuwafiche, kwa vila nawambelenhuka heni.","poem":1},{"lineBreak":true},{"text":"Nangana kuwagombola, ila wangulonga udesi kwa heni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hawandilile kulawa mnhumbula za hewo,","poem":1},{"lineBreak":true},{"text":"ila wangulombocheza kuli vinhanda vya hewo.","poem":1},{"lineBreak":true},{"text":"Wangidumulaga kwa chiwalo cha kumfugamila Baali, leka wapate nyhule na divai inyale,","poem":1},{"lineBreak":true},{"text":"ila wanguhinduchila kutali na heni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hanga nandiwalangusa na kuwapa mong'ho,","poem":1},{"lineBreak":true},{"text":"ila wangunuwila kudita gehile hali heni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hawalingungalamchila Heni Mbele Kuchanya Ng'hatu,","poem":1},{"lineBreak":true},{"text":"wa kota upinde ulihela mong'ho.","poem":1},{"lineBreak":true},{"text":"Vilongozi wa hewo wobagama kwa ipanga,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha ulonzi wa hewo wa ng'halazi.","poem":1},{"lineBreak":true},{"text":"Ahyo, wobezigwa kuli isi ya Misili.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}