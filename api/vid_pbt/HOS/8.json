{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"HOS","translationId":"vid_pbt","name":"Hoseya","commonName":"Hoseya","title":"Hoseya","order":28,"numberOfChapters":14,"sha256":"dabbe34568662d9ec1b7146f42e8b93a4fb4e6ce5ecf4d745af124e8a314eaf1","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/vid_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Nongwa ng'hulu za isi ya Isilaeli za kujifugamila jimalukolo"]},{"type":"verse","number":1,"content":[{"text":"“Mpembe mhalamhanda!","poem":1},{"lineBreak":true},{"text":"Mng'honyo kanguya kota ikungule,","poem":1},{"lineBreak":true},{"text":"kuivaba ng'handa ya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila nawalibena ilagano lya heni","poem":1},{"lineBreak":true},{"text":"na kulibelenhuka ilajizo lya heni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waisilaeli wangundilila wolonga,","poem":1},{"lineBreak":true},{"text":"‘Gwa Nguluwi wa hetwe, twangukuzela.’","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ila wanhu wa Isilaeli nawazibeza mbuli zinojile,","poem":1},{"lineBreak":true},{"text":"ahyo, wang'honyo wowawinza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nawewichila wandewa ne kukundigwa na heni,","poem":1},{"lineBreak":true},{"text":"nawehagulila vilongozi ne heni kuwalonjela.","poem":1},{"lineBreak":true},{"text":"Kwa sendi za hewo na zahabu za hewo, nawegongomanyila limalukolo","poem":1},{"lineBreak":true},{"text":"mbuli iwele yowadumya hewo wawo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hemwe wanhu wa Samaliya, mtoze kutali limalukolo lya hemwe lya ilogota.","poem":1},{"lineBreak":true},{"text":"Ng'halazi ya heni yangwaka kwa hemwe.","poem":1},{"lineBreak":true},{"text":"Nili mowa mlihela nongwa?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Namwe Waisilaeli hihyo du!","poem":1},{"lineBreak":true},{"text":"Alyo limalukolo lya hemwe naligongomanyigwa na munhu hela,","poem":1},{"lineBreak":true},{"text":"haliwele Nguluwi.","poem":1},{"lineBreak":true},{"text":"Ena! Limalukolo lya ilogota lya Samaliya lyobenangwa!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Walingunyala mbeho, wobeta chivuluvumbi!","poem":1},{"lineBreak":true},{"text":"Mizuchila ja hewo ja nyhule jiwele kuli migunda","poem":1},{"lineBreak":true},{"text":"hajiweza kulela nyhule yoneche.","poem":1},{"lineBreak":true},{"text":"Wone jolela, mbeta azo wolya wajenzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Waisilaeli nawamelwa,","poem":1},{"lineBreak":true},{"text":"lelo wa hali wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"kota chinhu chisowile utanzi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kwa vila nawaluta Ashulu kulanda utanzi,","poem":1},{"lineBreak":true},{"text":"kota idogowi lya kisolo lilingulubaluba liliyeka.","poem":1},{"lineBreak":true},{"text":"Wanhu wa Isilaeli nawalipa sendi kwa wamizi wa Ashulu, leka kuwamila hewo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hanga nawagula utanzi kwa wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"ila ndowakungajiza.","poem":1},{"lineBreak":true},{"text":"Wowa ng'hochele kwa kutunyigwa na mndewa yawele na mong'ho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Hanga wanhu wa Isilaeli nawezenjela honhu ha kulavila nhambiko kwa winji, kwa chiwalo cha nhambiko za gehile,","poem":1},{"lineBreak":true},{"text":"honhu aho ha kulavila nhambiko, nahawa honhu ha kuditila gehile.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanyandika mbuli nyinji kwa chiwalo cha hewo,","poem":1},{"lineBreak":true},{"text":"kuwala malajizo ga heni, ila nawazona kota chinhu chijenzi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wangulavya nhambiko,","poem":1},{"lineBreak":true},{"text":"na kulya miwunde jake,","poem":1},{"lineBreak":true},{"text":"ila heni Mkulu Nguluwi hambe nojezwe nawo.","poem":1},{"lineBreak":true},{"text":"Ndangukumbuchila gehile ga hewo,","poem":1},{"lineBreak":true},{"text":"ndowagaza kwa gehile ga hewo,","poem":1},{"lineBreak":true},{"text":"ndowahilusa kuli upogozi kula Misili.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Waisilaeli nawamsemwa Yawalumbile,","poem":1},{"lineBreak":true},{"text":"nawezenjela ng'handa za sendi nyinji ng'hatu,","poem":1},{"lineBreak":true},{"text":"wanhu wa Yuda nawajizenjela ngome miji minji,","poem":1},{"lineBreak":true},{"text":"ila ndohilika chiluli kuli miji ajo,","poem":1},{"lineBreak":true},{"text":"na kuzilakaza ngome za hewo.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}