{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"JOL","translationId":"vid_pbt","name":"Yoeli","commonName":"Yoeli","title":"Yoeli","order":29,"numberOfChapters":3,"sha256":"9ed58dd9b25494309fc09059458236c0e98081855b1fab8a538b3da63ea376e5","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/vid_pbt/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Nguluwi kozitagusa isi"]},{"type":"verse","number":1,"content":[{"text":"“Mhela awo na mazuwa ago","poem":1},{"lineBreak":true},{"text":"hondihilusa lutogo lwa Yuda na Yelusalemu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ndowakungajiza wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"ndiwegale kuli ibindi lichemigwe,","poem":1},{"lineBreak":true},{"text":"‘Mkulu Nguluwi yataguse.’","poem":1},{"lineBreak":true},{"text":"Ako ndowatagusa wanhu wa isi azo,","poem":1},{"lineBreak":true},{"text":"kwa mbuli zowawaditile wanhu wa heni Isilaeli,","poem":1},{"lineBreak":true},{"text":"wawele ndo uhalizi wa heni.","poem":1},{"lineBreak":true},{"text":"Kwa vila wanhu wa isi azo nawawasambalula kuli isi,","poem":1},{"lineBreak":true},{"text":"na kuigawanula isi ya heni","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"na kigawila wanhu wa heni kwa simbi.","poem":1},{"lineBreak":true},{"text":"Nawawaguza wasongolo leka wawagule wang'hondwa","poem":1},{"lineBreak":true},{"text":"na wahinza leka wagule divai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Mkulu Nguluwi kangulonga na isi zinji, “Mwangugana kundita choni hemwe Tilo na Sidoni na honhu heng'ha ha Filistiya? Ndaze, mwanacho chibida kwa heni chomlingugana kunyhilulila? Wone mwanguhilusa chibida, nani ndowahilulila baho du!"]},{"type":"verse","number":5,"content":["Namhola sendi na zahabu ya heni na kupika vinhu vya heni vya sendi nyinji mbaka kuli ng'handa za milungu ja hemwe."]},{"type":"verse","number":6,"content":["Namuwahilika wanhu wa Yuda na Yelusalemu kutali na isi ya hewo, namuwaguza kwa Wagilichi."]},{"type":"verse","number":7,"content":["Lelo ndowahilusa wanhu wa heni kulawa ako komuwaguzile. Ndohilula chibida kwa hemwe kwa geng'ha gomuwaditile."]},{"type":"verse","number":8,"content":["Wana wa hemwe walume na wadala ndowadita waguzigwe kwa wanhu wa Yuda, nawo wowaguzila Washeba, wanhu wa isi ya kutali ng'hatu. Heni Mkulu Nguluwi nandonga.”"]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Muwawikulile wanhu wa isi azo mbuli ayi,","poem":1},{"lineBreak":true},{"text":"“Miwiche goya kwa ngondo,","poem":1},{"lineBreak":true},{"text":"muwacheme wadahile kitowa ngondo wa hemwe,","poem":1},{"lineBreak":true},{"text":"wamizi weng'ha wekungajize,","poem":1},{"lineBreak":true},{"text":"walute kumwando.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mihuka ja hemwe mjidite jiwe mipanga,","poem":1},{"lineBreak":true},{"text":"sengo za hemwe ziwe migoha.","poem":1},{"lineBreak":true},{"text":"Yawele ng'hochele yalonje,","poem":1},{"lineBreak":true},{"text":"‘Heni kahi ndina mong'ho wa kitowa.’","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muye himahima, hemwe wanhu wa isi za habehi,","poem":1},{"lineBreak":true},{"text":"mikungajize ako kuli ibindi.”","poem":1},{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"Wamizi wa hegwe waduliche hali hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lelo wanhu wa isi zeng'ha wewiche goya,","poem":1},{"lineBreak":true},{"text":"woye kuli ibindi lichemigwe,","poem":1},{"lineBreak":true},{"text":"“Mkulu Nguluwi yataguse.”","poem":1},{"lineBreak":true},{"text":"Ako, heni Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ndochikalisa kuwatagusa wanhu wa isi zeng'ha za habehi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lelo, mhole sengo kwa chiwalo cha kubeta,","poem":1},{"lineBreak":true},{"text":"kwa vila awu ndo mhela wa kubeta.","poem":1},{"lineBreak":true},{"text":"Mwinjile! Muwaponde kota zabibu,","poem":1},{"lineBreak":true},{"text":"ziwele zimemile hali honhu ha kugongomanyila divai.","poem":1},{"lineBreak":true},{"text":"Wihe wa hewo ndo winji lukami","poem":1},{"lineBreak":true},{"text":"kota mibiga jimemile lukami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wangufika vilundo kwa vilundo","poem":1},{"lineBreak":true},{"text":"kuli ibindi lya kutagusa,","poem":1},{"lineBreak":true},{"text":"kwa vila zuwa lya Mkulu Nguluwi lya habehi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Isanya na nyelezi vyanguwichigwa jiza,","poem":1},{"lineBreak":true},{"text":"nhondwe nazileka kulavya lumuli.","poem":1}]},{"type":"heading","content":["Nguluwi kowatambichiza wanhu wa heye"]},{"type":"verse","number":16,"content":[{"text":"Mkulu Nguluwi kangubuma ako Siyoni,","poem":1},{"lineBreak":true},{"text":"lizi lya heye lyanguhulikwa kulawa Yelusalemu,","poem":1},{"lineBreak":true},{"text":"ulanga na isi vyangukakama.","poem":1},{"lineBreak":true},{"text":"Ila Mkulu Nguluwi ndo honhu ha kubilimila kwa wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"ndo ngome ya kulohola ukomu kwa wanhu wa Isilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Gwa Isilaeli,","poem":1},{"lineBreak":true},{"text":"kovizela kota heni Mkulu Nguluwi, Nguluwi wa hegwe,","poem":1},{"lineBreak":true},{"text":"ndangikala Siyoni, chidunda cha heni chelile,","poem":1},{"lineBreak":true},{"text":"Yelusalemu wowa muji welile,","poem":1},{"lineBreak":true},{"text":"wamizi wajenzi hawokola kahi amo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mhela awo vidunda vyolavya divai inyale,","poem":1},{"lineBreak":true},{"text":"vigongo vyolavya itombo.","poem":1},{"lineBreak":true},{"text":"Nzanda zeng'ha za Yuda zomema mazi,","poem":1},{"lineBreak":true},{"text":"nzasa yolawila kuli ng'handa ya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"na kulimizila ibindi lya Shitimu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Misili yowa chihame,","poem":1},{"lineBreak":true},{"text":"Edomu yowa kugunuche,","poem":1},{"lineBreak":true},{"text":"kwa vila nawawatowa wanhu wa Yuda","poem":1},{"lineBreak":true},{"text":"nawawakopola wanhu walihela nongwa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ila wanhu wochikala kwa kikala goya ako Yuda mazuwa gose,","poem":1},{"lineBreak":true},{"text":"na Yelusalemu lulelo lweng'ha.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ndowatowa wala wawele nawabohola danda ya wanhu wa Yuda","poem":1},{"lineBreak":true},{"text":"siwaleka wawele na nongwa.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi ndilingikala Siyoni.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}