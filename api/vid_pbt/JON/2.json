{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"JON","translationId":"vid_pbt","name":"Yona","commonName":"Yona","title":"Yona","order":32,"numberOfChapters":4,"sha256":"7d0ee5fa11bc5644c49a0d638234535a5f7b201ecfbd2407f0257daf15361427","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/vid_pbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Kulanda kwa Yona"]},{"type":"verse","number":1,"content":["Lelo Yona loyawele mgati mwa lida lya somba ayo, nayali yomlanda Mkulu Nguluwi, Nguluwi wa heye,"]},{"type":"verse","number":2,"content":["yolonga,",{"text":"“Kuli magazo ga heni nandimchema Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"nagwe nakanyhulichiza,","poem":1},{"lineBreak":true},{"text":"kulawa mgati mwa chilaga nandanda utanzi,","poem":1},{"lineBreak":true},{"text":"nagwe nakuhulika kulila kwa heni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwa vila nakunhoza mgati ng'hatu mwa bahali,","poem":1},{"lineBreak":true},{"text":"hagati ha bahali,","poem":1},{"lineBreak":true},{"text":"mazi naganzunguluta chila ubanzi,","poem":1},{"lineBreak":true},{"text":"nhigu nazikola mchanya mwa heni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nandali ndijesa kota nambikwa kutali na meho ga hegwe,","poem":1},{"lineBreak":true},{"text":"ila ndolola kahi kulutila kuli ng'handa ya hegwe yelile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mazi naganzunguluta,","poem":1},{"lineBreak":true},{"text":"mgati ng'hatu mwa bahali nakunzunguluta chila ubanzi.","poem":1},{"lineBreak":true},{"text":"Mahamba ga mbahali nagangubika kumutwi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nandulika kuli misisi ja vidunda,","poem":1},{"lineBreak":true},{"text":"kuli isi iwele lwizi jake najihindigwa mazuwa gose.","poem":1},{"lineBreak":true},{"text":"Ila hegwe, gwa Mkulu Nguluwi, Nguluwi wa heni,","poem":1},{"lineBreak":true},{"text":"nakunyhilusila ukomu kulawa ako kuli ikulubila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muhe wa heni lowaluche kundeka,","poem":1},{"lineBreak":true},{"text":"nandikulanda, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kulanda kwa heni nakukufichila,","poem":1},{"lineBreak":true},{"text":"kuli ng'handa ya hegwe yelile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wanhu walingujifugamila milungu,","poem":1},{"lineBreak":true},{"text":"wangulitoza kutali igano lya kwimilila lya hegwe kwa hewo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ila heni kwa lwimbo lwa kulonga malumbo,","poem":1},{"lineBreak":true},{"text":"ndokulavila nhambiko,","poem":1},{"lineBreak":true},{"text":"na kweneza chilaho cha heni.","poem":1},{"lineBreak":true},{"text":"Ulohozi wangulawa kwa Mkulu Nguluwi.”","poem":1}]},{"type":"verse","number":10,"content":["Lelo Mkulu Nguluwi nakailajiza yila somba imdeche Yona, somba naimdeka Yona kuli isi ng'havu."]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}