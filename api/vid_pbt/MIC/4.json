{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"MIC","translationId":"vid_pbt","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"d78505b993d6b31f0219d495e91e9ecbc604b22601e62cbd49c062b0c03e09cc","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/vid_pbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Nguluwi kanguwalongoza wanhu weng'ha kwa kikala goya"]},{"type":"verse","number":1,"content":[{"text":"Mhela wokuya uwele,","poem":1},{"lineBreak":true},{"text":"chidunda cha ng'handa ya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"chowa chikulu kusinda vidunda vyeng'ha.","poem":1},{"lineBreak":true},{"text":"Ena, chokwinizwa mchanya mwa vidunda vyeng'ha.","poem":1},{"lineBreak":true},{"text":"Wanhu wenji woluta ako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wanhu wa isi nyinji wokuya na kulonga,","poem":1},{"lineBreak":true},{"text":"“Tuche, tulute kuchanya kuli chidunda cha Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kuli ng'handa ya Nguluwi wa Yakobo,","poem":1},{"lineBreak":true},{"text":"leka yatulanguse nzila za heye,","poem":1},{"lineBreak":true},{"text":"natwe tuwinze vyoyodita heye.","poem":1},{"lineBreak":true},{"text":"Kwa vila malajizo golawa ako Siyoni,","poem":1},{"lineBreak":true},{"text":"ulonzi wa Mkulu Nguluwi ako Yelusalemu.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kowadita wanhu wa isi nyinji wehanyise,","poem":1},{"lineBreak":true},{"text":"na kwamula kitwanza kwa wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"ziwele na mong'ho na ziwele kutali.","poem":1},{"lineBreak":true},{"text":"Wogongomanya mipanga ja hewo jiwe mihuka","poem":1},{"lineBreak":true},{"text":"na migoha ja hewo jiwe sengo za kutemela nhagala.","poem":1},{"lineBreak":true},{"text":"Wanhu wa isi imwe hawochitowa na wanhu wa isi iyage,","poem":1},{"lineBreak":true},{"text":"ne kilangusa ngondo kahi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chila munhu kochikala kwa kikala goya,","poem":1},{"lineBreak":true},{"text":"hanyi ha mtini na mizabibu ja heye,","poem":1},{"lineBreak":true},{"text":"haduhu munhu yowadita wadumbe,","poem":1},{"lineBreak":true},{"text":"kwa vila Mkulu Nguluwi Yawele na Mong'ho nakalonga ahyo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wanhu wa isi zinji wanguwinza nzila za hewo,","poem":1},{"lineBreak":true},{"text":"kwa kitumbila milungu ja hewo,","poem":1},{"lineBreak":true},{"text":"ila hetwe twangumuwinza Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"Nguluwi wa hetwe, mazuwa gose.","poem":1}]},{"type":"heading","content":["Waisilaeli wohiluka kulawa kuli isi ya chijenzi"]},{"type":"verse","number":6,"content":[{"text":"Mkulu Nguluwi nakalonga,","poem":1},{"lineBreak":true},{"text":"“Zuwa alyo ndowakungajiza wanhu wa heni,","poem":1},{"lineBreak":true},{"text":"ena, ndowakungajiza vyete wa wala wawele nawahilikwa kuli isi zinji,","poem":1},{"lineBreak":true},{"text":"wanhu wala wawele nandiwagaza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Awo vyete na wala wasigale wakomu, wawele nawahilikwa kuli isi ya chijenzi,","poem":1},{"lineBreak":true},{"text":"ndowadita hewo wawe wanhu wa isi inyale iwele na mong'ho.","poem":1},{"lineBreak":true},{"text":"Nani Mkulu Nguluwi ndowalongoza kuli chidunda cha Siyoni,","poem":1},{"lineBreak":true},{"text":"kwaluchila mhela awo mbaka mazuwa gose.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nagwe Yelusalemu,","poem":1},{"lineBreak":true},{"text":"hegwe ngome ya Siyoni,","poem":1},{"lineBreak":true},{"text":"mong'ho wa mwaluko wohiluswa kwa hegwe,","poem":1},{"lineBreak":true},{"text":"undewa wokuya kwa hegwe Yelusalemu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lelo, lekachoni mwangulila kwa lizi?","poem":1},{"lineBreak":true},{"text":"Ndaze, mwahela mndewa kahi?","poem":1},{"lineBreak":true},{"text":"Yalingukulonjela mbuli zinojile nakabagama?","poem":1},{"lineBreak":true},{"text":"Mwangulila kwa lizi kwa chiwalo cha usungu,","poem":1},{"lineBreak":true},{"text":"kota mamo yalinguponda!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hemwe wanhu wa Siyoni,","poem":1},{"lineBreak":true},{"text":"mlile kota mamo yalinguponda!","poem":1},{"lineBreak":true},{"text":"Kwa vila lelo mokuka kuli muji awu,","poem":1},{"lineBreak":true},{"text":"mlute kikala kugunuche,","poem":1},{"lineBreak":true},{"text":"moluta mbaka Babuloni.","poem":1},{"lineBreak":true},{"text":"Ila ako moloholigwa.","poem":1},{"lineBreak":true},{"text":"Ako Mkulu Nguluwi kowagombola hemwe,","poem":1},{"lineBreak":true},{"text":"kulawa kuli ndole za wang'honyo wa hemwe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wanhu wa isi nyinji nawekungajiza kuwatowa hemwe.","poem":1},{"lineBreak":true},{"text":"Wangidaya wolonga, “Muji wa Yelusalemu uwe ukokomoche,","poem":1},{"lineBreak":true},{"text":"natwe tugone mahame ga Siyoni!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ila hewo hawachizelele choyachiwichile goya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ne kugazela majesa ga heye.","poem":1},{"lineBreak":true},{"text":"Kwa vila nakawakungajiza hamwe,","poem":1},{"lineBreak":true},{"text":"kota nyhule hali honhu ha kupululila.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi nakalonga,","poem":1},{"lineBreak":true},{"text":"“Hemwe wanhu wa Siyoni,","poem":1},{"lineBreak":true},{"text":"mwinuche leka muwatowe wang'honyo wa hemwe!","poem":1},{"lineBreak":true},{"text":"Ndowapa hemwe mong'ho kota ibuguma,","poem":1},{"lineBreak":true},{"text":"liwele na mbalati za chuma na nzayo za shaba.","poem":1},{"lineBreak":true},{"text":"Mowabalasa wanhu wa isi nyinji,","poem":1},{"lineBreak":true},{"text":"gowopata mombichila chiuyeng'ha,","poem":1},{"lineBreak":true},{"text":"lufufu lwa hewo mondavila heni Mkulu wa isi yeng'ha.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}