{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"NAM","translationId":"vid_pbt","name":"Nahumu","commonName":"Nahumu","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"835545cea3079985aef69c2755b2cb8118e7e7ffd48b2e8142f42f6c77a7efcf","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/vid_pbt/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Kugwa kwa Ninawi"]},{"type":"verse","number":1,"content":[{"text":"Wamizi wa Ninawi wangulila,","poem":1},{"lineBreak":true},{"text":"“Yalingudumya kanguya kututowa.","poem":1},{"lineBreak":true},{"text":"Twamile ngome za hetwe!","poem":1},{"lineBreak":true},{"text":"Tuwiche wamizi mbalabala!","poem":1},{"lineBreak":true},{"text":"Tiwiche goya!","poem":1},{"lineBreak":true},{"text":"Tukungajize mong'ho wa hetwe weng'ha.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi komhilusila Yakobo ludali lwake,","poem":1},{"lineBreak":true},{"text":"ena, kowapa kahi Waisilaeli ludali lwa hewo,","poem":1},{"lineBreak":true},{"text":"hanga walinguvaba hawawalechele chinhu,","poem":1},{"lineBreak":true},{"text":"mbaka nhagala za hewo za mizabibu nawazitema.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ngawo za wamizi wa heye ndo ndung'hu,","poem":1},{"lineBreak":true},{"text":"wazidahe kitowa ngondo wa heye nawavala mivalo midung'hu.","poem":1},{"lineBreak":true},{"text":"Mituka ja hewo ja falasi jangupulika kota lumuli lwa chiluli,","poem":1},{"lineBreak":true},{"text":"kuli zuwa lyoyajiwichile goya,","poem":1},{"lineBreak":true},{"text":"migoha ja mibeloshi ja hewo jangupulika.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mituka ja falasi jangubilima kuli nzila,","poem":1},{"lineBreak":true},{"text":"jangubilima aku na kula hagati ha muji.","poem":1},{"lineBreak":true},{"text":"Jangoneka kota milapi ja chiluli.","poem":1},{"lineBreak":true},{"text":"Jangubilima kota lumwemwesa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lelo mkulu kanguwachema vilongozi wa heye,","poem":1},{"lineBreak":true},{"text":"nawo wangikwang'wala vyowalinguluta kwa heye,","poem":1},{"lineBreak":true},{"text":"wangubilimila kuli lukanzi lwa miji,","poem":1},{"lineBreak":true},{"text":"leka kuwika goya ngawo ya hewo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lwizi ja lwanda najidoholigwa,","poem":1},{"lineBreak":true},{"text":"ng'handa ya mndewa naigwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muji wa mwanzi lukami,","poem":1},{"lineBreak":true},{"text":"wanhu wanguholigwa na kuhilikwa kuli isi ya chijenzi.","poem":1},{"lineBreak":true},{"text":"Wapogozi wake wadala wangulombocheza kota ng'hunda,","poem":1},{"lineBreak":true},{"text":"na kitowa kuli mhambaga za hewo kwa masinzo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ninawi ndo kota ilamba libomoche,","poem":1},{"lineBreak":true},{"text":"wanhu wake wanguubilima.","poem":1},{"lineBreak":true},{"text":"Lizi lyanguchemeleza, “Mwime! Mwime!”","poem":1},{"lineBreak":true},{"text":"Ila haduhu yalingulola kumbele.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Walinguivaba Ninawi wangulonga,","poem":1},{"lineBreak":true},{"text":"“Mhole vinhu vya sendi,","poem":1},{"lineBreak":true},{"text":"mhole vinhu vya zahabu.","poem":1},{"lineBreak":true},{"text":"Ng'hano yake yahela kuduma.","poem":1},{"lineBreak":true},{"text":"Hana winji wa chila chinhu cha sendi nyinji.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muji wa Ninawi nauholigwa na kuwifigwa na kulechigwa uchiwa!","poem":1},{"lineBreak":true},{"text":"Wanhu wake nawatweguka nhumbula,","poem":1},{"lineBreak":true},{"text":"mafugamilo gawo gangukakama,","poem":1},{"lineBreak":true},{"text":"mong'ho wa hewo naumala, kumeho kwa hewo nakugaluka kwa chiwalo cha lunhwinhwi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wa kohi muji wula uwele kota mhalika ya misimba,","poem":1},{"lineBreak":true},{"text":"hawele ndo honhu hawo ha kivisa?","poem":1},{"lineBreak":true},{"text":"Ha ndaze aho honhu ha misimba,","poem":1},{"lineBreak":true},{"text":"hawele haduhu yawezile kujitinhusa?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Isimba ilume nalidadula miwunde ja kuhega kwa chiwalo cha myana jake,","poem":1},{"lineBreak":true},{"text":"naliwabatila misimba midala upelembi wawo,","poem":1},{"lineBreak":true},{"text":"mhalika yake naimema upelembi,","poem":1},{"lineBreak":true},{"text":"haluga hake hana vihande vinji vya miwunde.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi Yawele na Mong'ho kanguwikula,","poem":1},{"lineBreak":true},{"text":"“Lelo ndangitwanza na hemwe.","poem":1},{"lineBreak":true},{"text":"Mituka ja hemwe ja ngondo ndojidumya kwa chiluli","poem":1},{"lineBreak":true},{"text":"na kujikopola kwa ipanga myana isimba ja hemwe.","poem":1},{"lineBreak":true},{"text":"Siwalechela upelembi kuli isi.","poem":1},{"lineBreak":true},{"text":"Lizi lya wasenga wa hegwe haluhulikwa kahi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}