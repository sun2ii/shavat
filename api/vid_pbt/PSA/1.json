{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"heading","content":["Nzila mbili"]},{"type":"verse","number":1,"content":[{"text":"Nakatambichizwa yula munhu,","poem":1},{"lineBreak":true},{"text":"yohambe yalute kuli chitala cha wehile,","poem":1},{"lineBreak":true},{"text":"halinguwinza nzila za wawele na gehile,","poem":1},{"lineBreak":true},{"text":"ne kikalisa hamwe na walinguliga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ila kangunojezwa na ilajizo lya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kangijesaga ilajizo lya heye nemisi na nechilo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naye kanguwa kota igodi litopekwe hafungo ha nzanda za mazi,","poem":1},{"lineBreak":true},{"text":"lilingulela mafuza gake kwa mihela jake","poem":1},{"lineBreak":true},{"text":"ne ihamba lyake halilinguswinha.","poem":1},{"lineBreak":true},{"text":"Chila choyalingudita changulutilila goya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Haiwele kota vyowawele wehile,","poem":1},{"lineBreak":true},{"text":"hewo ndo kota mhumba ilinguwembeluka kwa mbeho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lelo wehile hambe weme nzinzili kuli utaguso,","poem":1},{"lineBreak":true},{"text":"ne wawele na gehile hali nhing'hano ya watanganiche.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwa vila Mkulu Nguluwi kanguizela nzila ya watanganiche,","poem":1},{"lineBreak":true},{"text":"ila nzila ya wehile yokwajilila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/2KI/25.json","previousChapterAudioLinks":{},"numberOfVerses":6}