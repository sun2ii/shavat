{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":10,"content":[{"type":"heading","content":["Kulanda kwa chiwalo cha hachi"]},{"type":"verse","number":1,"content":[{"text":"Gwa Mkulu Nguluwi, lekachoni kwangwima kutali?","poem":1},{"lineBreak":true},{"text":"Lekachoni kwangivisa mhela wa magazo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwa kidaya wehile wanguwagaza wazunwa,","poem":1},{"lineBreak":true},{"text":"wazunwa walingugwilizwa na hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwihe kangitogolaga kwa maya ga nhumbula ya heye,","poem":1},{"lineBreak":true},{"text":"kangumtambichizaga yawele na maya na kumliga Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuli kidaya kwa heye halingumpala Nguluwi.","poem":1},{"lineBreak":true},{"text":"Kijesa kwa heye kweng'ha ndo, “Haduhu Nguluwi.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nzila za mwihe zangusumya,","poem":1},{"lineBreak":true},{"text":"kwa heye nhaguso za hegwe za kutali na majesa ga heye,","poem":1},{"lineBreak":true},{"text":"kanguwabezaga wang'honyo wa heye weng'ha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kangijesaga mnhumbula, “Siwa na lunhwinhwi,","poem":1},{"lineBreak":true},{"text":"sifichigwa na magazo kuli ukomu wa heni.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kumlomo kwa heye nakumema upanjilo na uhadi na kubunza,","poem":1},{"lineBreak":true},{"text":"kangulongaga ulonzi wa kuzudiza na wihe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kangivisaga kuli vijiji yobeteza,","poem":1},{"lineBreak":true},{"text":"yamkopole munhu yalihela nongwa.","poem":1},{"lineBreak":true},{"text":"Ka meho kumpugajiza ng'hochele,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kangubetezaga hali honhu ha kivisa kota isimba.","poem":1},{"lineBreak":true},{"text":"Kangupugajizaga leka yawebate wazunwa,","poem":1},{"lineBreak":true},{"text":"kanguwagwilizaga kuli idiwa lya heye na kuwahola.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ng'hochele kanguhondigwa na kutozigwa hasi,","poem":1},{"lineBreak":true},{"text":"kangutozigwa kwa nhumbula yihile ya yula mwihe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mwihe kangijesaga mnhumbula ya heye,","poem":1},{"lineBreak":true},{"text":"“Nguluwi nakasemwa,","poem":1},{"lineBreak":true},{"text":"nakadinya kumeho kwa heye halingona chinhu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Winuche, gwa Mkulu Nguluwi, uwagaze,","poem":1},{"lineBreak":true},{"text":"uleche kuwasemwa awo walingubunzwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi, lekachoni mwihe kangukubeza,","poem":1},{"lineBreak":true},{"text":"na kulonga kota humgaza?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ila hegwe kwanguwonaga wawele kuli kutunywa na magazo,","poem":1},{"lineBreak":true},{"text":"nakukunda kuwabochela mmoko mwa hegwe.","poem":1},{"lineBreak":true},{"text":"Ng'hochele kangitumbila kwa hegwe, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"hegwe kwanguwaga utanzi wa walekwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ubene mong'ho wa munhu mwihe,","poem":1},{"lineBreak":true},{"text":"udumye wihe wa heye weng'ha, uleche koneka kahi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mkulu Nguluwi ndo mndewa mazuwa gose.","poem":1},{"lineBreak":true},{"text":"Wanhu wa isi zeng'ha wohawamzelele wokwajilila kuli isi ya heye.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, kwangubochela kulanda kwa ng'hochele,","poem":1},{"lineBreak":true},{"text":"kwangumkangaza na kumhulichiza.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kowaditila hachi walekwa na walingubunzwa,","poem":1},{"lineBreak":true},{"text":"leka munhu yawele ndo misanga yalemwele kigala lunhwinhwi kahi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}