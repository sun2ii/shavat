{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"heading","content":["Kulagana kwa mndewa"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Ndokwimba kuwala igano lya kwimilila lya hegwe na hachi ya hegwe,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, kwa hegwe ndokwimba lutogo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndobatilila nzila iwele inojile.","poem":1},{"lineBreak":true},{"text":"Ndaze, kokuya nili kwa heni?","poem":1},{"lineBreak":true},{"text":"Ndochikala kwa kugoloka haluga ha heni,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"sikwimilila hebu upoka.","poem":1},{"lineBreak":true},{"text":"Ndangugazudila madito ga wanhu wajilile,","poem":1},{"lineBreak":true},{"text":"mbuli za hewo haziwa hamwe na heni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwajilila koneche kula kuwe kutali na heni,","poem":1},{"lineBreak":true},{"text":"heni ndowa haduhu ng'hatu hali wihe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yalingumlonga vibi kwa uviso yawele habehi na heye, ndomdumya,","poem":1},{"lineBreak":true},{"text":"siweza kumwimilila munhu yalingidaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Meho ga heni gowa mchanya mwa wanhu wawele wa kukundigwa kuli isi,","poem":1},{"lineBreak":true},{"text":"leka wekale hamwe na heni.","poem":1},{"lineBreak":true},{"text":"Wanhu wagoloche ndo wong'holela mijito.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mhadi yoneche hochikala haluga ha heni ha undewa,","poem":1},{"lineBreak":true},{"text":"haduhu yalingulonga udesi yochikala kwa heni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zuwa mbaka zuwa ndowasumya wehile weng'ha kuli isi,","poem":1},{"lineBreak":true},{"text":"ndowawinga wehile weng'ha kuli muji wa Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}