{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"heading","content":["Kitumbila kwa Nguluwi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Kwa heye Mkulu Nguluwi ndangubilimila kikala goya.","poem":1},{"lineBreak":true},{"text":"Mwanguweza ndaze lelo kundonjela,","poem":1},{"lineBreak":true},{"text":"“Uguluche kota chideje mbaka kuli vidunda,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kwa vila wehile wangujiwika goya mipinde ja hewo,","poem":1},{"lineBreak":true},{"text":"nawawika goya misale kuli jiza,","poem":1},{"lineBreak":true},{"text":"leka wawatowe wanhu wanojile.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wone misisi ja ulongozi jowifigwa,","poem":1},{"lineBreak":true},{"text":"munhu yatanganiche kodita ndaze?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mkulu Nguluwi ka mgati mwa Ng'handa ya heye yelile,","poem":1},{"lineBreak":true},{"text":"chigoda cha undewa cha Mkulu Nguluwi cha ako kilanga.","poem":1},{"lineBreak":true},{"text":"Kwa meho ga heye kanguwalolaga wanhu,","poem":1},{"lineBreak":true},{"text":"na kuvizela chila chowalingudita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kanguwapimaga watanganiche,","poem":1},{"lineBreak":true},{"text":"ila kanguwazudilaga ng'hatu wehile walingugana kubunza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kowadulisila wehile makala ga chiluli na maganga ga chiluli,","poem":1},{"lineBreak":true},{"text":"mbeho ng'hulu yowa ndo magazo ga hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mkulu Nguluwi ndo yatanganiche na kangugana kutanganika.","poem":1},{"lineBreak":true},{"text":"Wanhu wagoloche nhumbula wochikala hamwe na heye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}