{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"heading","content":["Kuwichigwa kwa mndewa na mtambika yahaguligwe"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi kangumlonjela Mkulu wa heni,","poem":1},{"lineBreak":true},{"text":"“Wikalise ubanzi wa kudilo kwa heni,","poem":1},{"lineBreak":true},{"text":"mbaka ndiwawiche wang'honyo wa hegwe hasi ha magulu ga hegwe.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi koweneza undewa wa hegwe kulawa Siyoni,","poem":1},{"lineBreak":true},{"text":"hegwe kolongoza mchanya mwa wang'honyo wa hegwe weng'ha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wanhu wa hegwe wokuyila kwa kunuwila,","poem":1},{"lineBreak":true},{"text":"zuwa lyouluta kuwatowa wang'honyo.","poem":1},{"lineBreak":true},{"text":"Mchanya mwa vidunda vyelile wokuyila wasongolo wa hegwe,","poem":1},{"lineBreak":true},{"text":"kota nungwi ilingulawa lufuku ng'hatu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mkulu Nguluwi nakelaha, hogalula kunuwila kwa heye,","poem":1},{"lineBreak":true},{"text":"“Hegwe ndo mtambika mazuwa gose kwa kuwinza utambika wa Melekisedeki.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mkulu ka ubanzi wa hegwe wa kudilo,","poem":1},{"lineBreak":true},{"text":"kowahonda wandewa hoyozudila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kowatagusa na kuwakopola wanhu wenji wa isi zinji,","poem":1},{"lineBreak":true},{"text":"kowahonda vilongozi chila honhu muisi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mndewa konwa mazi ga mnzila,","poem":1},{"lineBreak":true},{"text":"naye kokwinula mutwi kuchanya kwa kusumya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}