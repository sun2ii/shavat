{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"heading","content":["Lutogo kwa Nguluwi yawele na ukulu"]},{"type":"verse","number":1,"content":[{"text":"Mumtogole Mkulu Nguluwi.","poem":1},{"lineBreak":true},{"text":"Hemwe vitumagwa wa Mkulu Nguluwi, mlitogole itagwa lya Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Itagwa lya Mkulu Nguluwi litogoligwe,","poem":1},{"lineBreak":true},{"text":"lehano mbaka mazuwa gose.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kulawa kolilawilaga isanya mbaka kolizinjilaga isanya,","poem":1},{"lineBreak":true},{"text":"litogoligwe itagwa lya Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi ka mchanya mwa wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"ukulu wa heye wangufika mchanya mwa ulanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Whaani yawele kota Mkulu Nguluwi, Nguluwi wa hetwe?","poem":1},{"lineBreak":true},{"text":"Heye nakekalisa mchanya kuli chigoda cha undewa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ila kangulola hasi,","poem":1},{"lineBreak":true},{"text":"yalole ulanga na isi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kangumwinulaga yalihela chinhu kulawa kuli nhimbwisi,","poem":1},{"lineBreak":true},{"text":"na kumkwiniza mzunwa kulawa kuli soni ya heye,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"na kumuwika hamwe na wakulu,","poem":1},{"lineBreak":true},{"text":"wakulu wa wanhu wa heye.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kangumtambichizaga mdala yawele mhende kusangalala kuli ng'handa ya heye,","poem":1},{"lineBreak":true},{"text":"kangumsangalazaga kwa kumtambichiza wana.","poem":1},{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}