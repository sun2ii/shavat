{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":115,"content":[{"type":"heading","content":["Nguluwi yumwe wa kukomya"]},{"type":"verse","number":1,"content":[{"text":"Hatuwele hetwe, gwa Mkulu Nguluwi, hatuwele hetwe,","poem":1},{"lineBreak":true},{"text":"ila hegwe uliyeka utogoligwe,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha igano lya kwimilila lya hegwe na kukundigwa kwa hegwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lekachoni wanhu wa isi walonje,","poem":1},{"lineBreak":true},{"text":"“Kakohi Nguluwi wa hemwe?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nguluwi wa hetwe ka kilanga,","poem":1},{"lineBreak":true},{"text":"heye kanguditaga geng'ha yalingugana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jimalukolo ja hewo ndo sendi na zahabu,","poem":1},{"lineBreak":true},{"text":"najigongomanyigwa kwa moko ga wanhu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jina milomo, ila hajilingulonga,","poem":1},{"lineBreak":true},{"text":"jina meho, ila hajilingona.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jina makutu, ila hajilinguhulika,","poem":1},{"lineBreak":true},{"text":"jina mhenyelo ila, hajilingunusa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jina moko, ila hajilingwabasa.","poem":1},{"lineBreak":true},{"text":"Jina magulu, ila hajilingujenda.","poem":1},{"lineBreak":true},{"text":"Hajiweza hebu kulavya lizi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Weng'ha walingujigongomanya wochiwhana najo,","poem":1},{"lineBreak":true},{"text":"hihyo du na weng'ha walingujitumbila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hemwe Waisilaeli mchitumbile kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"heye ndo utanzi na ngawo ya hemwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hemwe walelwa wa Aluni, watambika, mchitumbile kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"heye ndo utanzi wa hemwe na ngawo ya hemwe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hemwe mlingumdumba Mkulu Nguluwi, mchitumbile kwa heye,","poem":1},{"lineBreak":true},{"text":"heye ndo utanzi wa hemwe na ngawo ya hemwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mkulu Nguluwi kangutukumbuchila na kotutambichiza,","poem":1},{"lineBreak":true},{"text":"kowatambichiza wanhu wa Isilaeli,","poem":1},{"lineBreak":true},{"text":"kowatambichiza walelwa wa Aluni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kowatambichiza weng'ha walingumdumba Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kowatambichiza wakulu na wadodo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mkulu Nguluwi yawatambichize leka monjezeche,","poem":1},{"lineBreak":true},{"text":"yawatambichize monjezeche hemwe na walelwa wa hemwe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mtambichizwe na Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"yavilumbile ulanga na isi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ulanga uwele kuchanya ng'hatu ndo wa heye Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ila isi nakawapa wanhu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wabagame hambe wamtogole Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ne wala walingudulika kuli isi iwele tulu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ila hetwe tuwele wakomu twangumtogola Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"tomtogola sambi mbaka mazuwa gose.","poem":1},{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}