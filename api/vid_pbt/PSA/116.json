{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":116,"content":[{"type":"heading","content":["Kulonga malumbo kwa kuloholigwa kulawa kuli kubagama"]},{"type":"verse","number":1,"content":[{"text":"Ndangumgana Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila nakanyhulika,","poem":1},{"lineBreak":true},{"text":"kwa vila nakahulika chililo cha kulanda kwa heni kwa isungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nakambichila goya ikutu,","poem":1},{"lineBreak":true},{"text":"ahyo ndomlanda mhela weng'ha hondichikala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vihindo vya kubagama navinzunguluta,","poem":1},{"lineBreak":true},{"text":"kukabusa kwa isi ya wabagame nakuvaba heni,","poem":1},{"lineBreak":true},{"text":"nandali memile kusanzalima na masinzo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hamba nandimlilila Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"“Gwa Mkulu Nguluwi, undohole.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mkulu Nguluwi nakamema isungu na kutanganika,","poem":1},{"lineBreak":true},{"text":"Nguluwi wa hetwe ndo yawele na uliholile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kanguwamilaga walingunyenyetela,","poem":1},{"lineBreak":true},{"text":"londiwele kuli magazo nakandohola.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Usindamale, gwa nhumbula ya heni,","poem":1},{"lineBreak":true},{"text":"kwa vila Mkulu Nguluwi nakanditila ganojile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nakandohola kulawa kuli kubagama na kusa mahozi ga heni,","poem":1},{"lineBreak":true},{"text":"nakanyamila leka ndeche kugwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ndojenda hali heye Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kuli isi ya wanhu wawele wakomu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nandali na makundo hala hondonjile,","poem":1},{"lineBreak":true},{"text":"“Nangazika lukami.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mbaka nandonga kwa lunhwinhwi lwa heni,","poem":1},{"lineBreak":true},{"text":"“Wanhu weng'ha wangulonga udesi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndimhilusile choni Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa isungu lya heye lyeng'ha lyoyanditile?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndomlavila nhambiko ya divai kwa kundohola,","poem":1},{"lineBreak":true},{"text":"ndolanda kwa itagwa lya heye Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndomwenezela Mkulu Nguluwi chilaho cha heni,","poem":1},{"lineBreak":true},{"text":"hali wanhu wa heye weng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kubagama kwa wanhu wa kukundigwa wa Mkulu Nguluwi","poem":1},{"lineBreak":true},{"text":"haiwele mbuli ndodo hali heye.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, heni nda chitumagwa wa hegwe,","poem":1},{"lineBreak":true},{"text":"nda chitumagwa wa hegwe, mwana wa mpogozi wa hegwe,","poem":1},{"lineBreak":true},{"text":"nakuvichumula vihindo vya heni vya kubagama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ndokulavila nhambiko za kulonga malumbo","poem":1},{"lineBreak":true},{"text":"na kulanda kwa itagwa lya hegwe, Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ndomwenezela Mkulu Nguluwi chilaho cha heni,","poem":1},{"lineBreak":true},{"text":"hali wanhu wa heye weng'ha,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"wowekungajize hali ng'handa ya heye,","poem":1},{"lineBreak":true},{"text":"hagati ha Yelusalemu.","poem":1},{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}