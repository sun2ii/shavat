{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwimba kwa Sheminiti. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Ututanze, gwa Mkulu Nguluwi.","poem":1},{"lineBreak":true},{"text":"Wanhu wanojile nawamala,","poem":1},{"lineBreak":true},{"text":"wakukundigwa nawajilila hali wanhu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chila yumwe kangumdetelezaga myage,","poem":1},{"lineBreak":true},{"text":"wangulongaga kwa kudeta na kwa nhumbula ya udesi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"uzidumule azo myango za uhadi,","poem":1},{"lineBreak":true},{"text":"na ajo milomo jilingidaya lukami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hewo wangulongaga, “Kwa myango za hetwe tosumya,","poem":1},{"lineBreak":true},{"text":"milomo ja hetwe jina ludali, mkulu wa hetwe ndo whaani?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ila Mkulu Nguluwi kangulonga,","poem":1},{"lineBreak":true},{"text":"“Kwa vila wazunwa wangubunzwa,","poem":1},{"lineBreak":true},{"text":"walingugana wangulila kwa usungu,","poem":1},{"lineBreak":true},{"text":"lelo ndanguya,","poem":1},{"lineBreak":true},{"text":"nani ndowegalila kikala goya konakwali wokubeteza.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ulonzi wa Mkulu Nguluwi ndo kukomya,","poem":1},{"lineBreak":true},{"text":"ndo welile kota zahabu yelizwe kuli itanulu,","poem":1},{"lineBreak":true},{"text":"ena, kota zahabu yelizwe mala saba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kotwamila, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kotuwika kutali mazuwa gose na lulelo alu lwihile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wehile wanguzunguluta chila honhu,","poem":1},{"lineBreak":true},{"text":"kwajilila kwangutogoligwa hali wanhu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}