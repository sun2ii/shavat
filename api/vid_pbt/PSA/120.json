{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"Kuli magazo ga heni nandimchema Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"naye nakanyhidichila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, undohole","poem":1},{"lineBreak":true},{"text":"kulawa kwa wanhu wadesi na wahadi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hemwe wanhu wahadi, mopegwa choni?","poem":1},{"lineBreak":true},{"text":"Mozapigwa ndaze?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kowagaza kwa misale jing'ang'ale ja mwamizi,","poem":1},{"lineBreak":true},{"text":"na kwa makala ga chiluli ching'ang'ale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndochona kwa vila ndangikala kota mjenzi aku Mesheki,","poem":1},{"lineBreak":true},{"text":"ama kuli mihema ja Kedali.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nandikala kwa mihela minji ng'hatu","poem":1},{"lineBreak":true},{"text":"hali wanhu walinguzudila kikala goya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Heni nda munhu wa kikala goya,","poem":1},{"lineBreak":true},{"text":"ila hondilonga ahyo, hewo wangugana ngondo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}