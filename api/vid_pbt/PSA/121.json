{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":121,"content":[{"type":"heading","content":["Nguluwi kangutwamila"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"Ndangulola kuchanya kuli vidunda,","poem":1},{"lineBreak":true},{"text":"utanzi wa heni wolawa kohi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Utanzi wa heni wangulawa kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"yalumbile ulanga na isi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hokuleka ugwe,","poem":1},{"lineBreak":true},{"text":"mwamizi wa hegwe hambe yasinzile.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ena, mwamizi wa Isilaeli,","poem":1},{"lineBreak":true},{"text":"hambe yasinzile ne kuwasa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi ndo mwamizi wa hegwe,","poem":1},{"lineBreak":true},{"text":"ka ubanzi wa hegwe wa kudilo kota lubehelo kukwamila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nemisi isanya haliweza kukulumiza,","poem":1},{"lineBreak":true},{"text":"ne nyelezi mhela wa nechilo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mkulu Nguluwi kokwamila na lihile lyoneche,","poem":1},{"lineBreak":true},{"text":"kowamila goya ukomu wa hegwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kokwamila kuli mbuli za hegwe za chila zuwa,","poem":1},{"lineBreak":true},{"text":"kulawa sambi mbaka mazuwa gose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}