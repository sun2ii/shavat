{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"heading","content":["Lutogo ako Yelusalemu"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya. Lwimbo lwa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Nasangalala vyowandonjele,","poem":1},{"lineBreak":true},{"text":"“Tulute kaye kwa Mkulu Nguluwi.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lelo twa hano natwima,","poem":1},{"lineBreak":true},{"text":"mgati mwa lwizi lwa hegwe, gwa Yelusalemu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yelusalemu, muji uzenjigwe,","poem":1},{"lineBreak":true},{"text":"leka wanhu weting'hane amo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amo ndo nhanzi zilinguluta,","poem":1},{"lineBreak":true},{"text":"ena, nhanzi za Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kulonga malumbo kwa Mkulu Nguluwi kota vyoyalajize.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amo namuwichigwa chitala cha utaguso wa hachi,","poem":1},{"lineBreak":true},{"text":"chitala cha lukolo lwa chiundewa lwa Daudi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muulandile kikala goya muji wa Yelusalemu.","poem":1},{"lineBreak":true},{"text":"“Weng'ha walinguugana, mbuli za hewo zilutilile goya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mgati mwa ng'hanzi za hegwe kuwe na kikala goya,","poem":1},{"lineBreak":true},{"text":"na ngome ya hegwe iwe goya.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kwa chiwalo cha wanhu wa heni na wang'holozangu,","poem":1},{"lineBreak":true},{"text":"ndangulonga, “Gwa Yelusalemu, ndangukuganila kikala goya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kwa chiwalo cha ng'handa ya Mkulu Nguluwi, Nguluwi wa hetwe,","poem":1},{"lineBreak":true},{"text":"ndangukulandila ganojile.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}