ntent":[{"lineBreak":true},{"text":"Natiguta kwa mhela winji kubezigwa kwa wawele na lufufu,","poem":1},{"lineBreak":true},{"text":"walingidaya wangutona kota natubezigwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}