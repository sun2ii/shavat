{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":124,"content":[{"type":"heading","content":["Mkulu Nguluwi ka ubanzi wa hetwe"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya. Lwimbo lwa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"“Wone Mkulu Nguluwi yahawele haduhu ubanzi wa hetwe.”","poem":1},{"lineBreak":true},{"text":"Mlonje mweng'ha muwele kuli Isilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Wone Mkulu Nguluwi yahawele haduhu ubanzi wa hetwe,","poem":1},{"lineBreak":true},{"text":"mhela wula lotutowigwe na wang'honyo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ndangukomya twahawele tumeligwe tung'hali wakomu,","poem":1},{"lineBreak":true},{"text":"mhela ng'halazi ya hewo loitufichile.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Twahaholigwe na mazi tendema,","poem":1},{"lineBreak":true},{"text":"twahatowigwe kota mazi ga lwanda,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mazi galinguluta himahima gahatuholile.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yatogoligwe Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"yawele hatulechile kuli ndole za hewo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Natusulupuka kota chideje kuli idiwa,","poem":1},{"lineBreak":true},{"text":"idiwa nalibenigwa, natwe natuloholigwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Utanzi wa hetwe wangulawa kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"yalumbile ulanga na isi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}