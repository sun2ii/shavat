{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"heading","content":["Mkulu Nguluwi kanguwazunguluta wanhu wa heye"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"Walingitumbila kwa Mkulu Nguluwi, wa kota chidunda cha Siyoni,","poem":1},{"lineBreak":true},{"text":"chiwele hambe chitigasiche ila changupona chiwele nzinzili mazuwa gose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kota Yelusalemu vyoilinguzungulutwa na vidunda,","poem":1},{"lineBreak":true},{"text":"ndo Mkulu Nguluwi vyoyalinguwazunguluta wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"kulawa sambi na mazuwa gose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wehile hawolutilila kuilongoza isi ya watanganiche,","poem":1},{"lineBreak":true},{"text":"leka watanganiche waleche kudita gehile kota wala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, uwe unojile kwa wanhu wanojile,","poem":1},{"lineBreak":true},{"text":"kwa wala wagoloche nhumbula.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ila walingugalamka na kuwinza nzila za hewo zihile,","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi uwose hamwe na walingudita gehile.","poem":1},{"lineBreak":true},{"text":"Kikala goya kuwe na Isilaeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}