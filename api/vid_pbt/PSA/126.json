{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":126,"content":[{"type":"heading","content":["Mkulu Nguluwi utuwiche goya kahi"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi loyatuwichile goya na kutuhilula Siyoni,","poem":1},{"lineBreak":true},{"text":"natwali kota wanhu walingulota.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ahyo natwaluka kuseka,","poem":1},{"lineBreak":true},{"text":"natutowa luchenze kwa usangalalo.","poem":1},{"lineBreak":true},{"text":"Wanhu wa isi zinji nawalonga,","poem":1},{"lineBreak":true},{"text":"“Mkulu Nguluwi nakawaditila mbuli ng'hulu.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ena, Mkulu Nguluwi nakatuditila mbuli ng'hulu,","poem":1},{"lineBreak":true},{"text":"natusangalala lukami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gwa Mkulu Nguluwi, utuwiche goya kahi,","poem":1},{"lineBreak":true},{"text":"kota nhonya vyoilingigala mazi kugunuche.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Walingunyala kwa mahozi,","poem":1},{"lineBreak":true},{"text":"wobeta kwa usangalalo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Walinguluta kunyala nyhadikwa kuno wolila,","poem":1},{"lineBreak":true},{"text":"wohiluka kwa usangalalo wawele na mbena.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}