{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"heading","content":["Ne kuwa na Nguluwi, mijito ja hetwe hajiwele chinhu"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya. Lwimbo lwa Solomoni.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi wone hazenjile ng'handa,","poem":1},{"lineBreak":true},{"text":"walinguzenga wangitunya hela.","poem":1},{"lineBreak":true},{"text":"Wone Mkulu Nguluwi howamila muji,","poem":1},{"lineBreak":true},{"text":"walingwamila wanguwa meho kwa kitunya hela.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwangitunya hela kulilimka lufuku ng'hatu,","poem":1},{"lineBreak":true},{"text":"na kukawila kuluta kwesela matinazo,","poem":1},{"lineBreak":true},{"text":"mipalile chilyo kwa chituguti cha hemwe.","poem":1},{"lineBreak":true},{"text":"Nguluwi kanguwapaga chilyo wala yalinguwagana, hanga howowasa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wana ndo utambichizo kulawa kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"wana ndo ndolendole kulawa kwa heye.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wana wapondigwe kuno wahaza wa hewo wang'hali wawele na mong'ho,","poem":1},{"lineBreak":true},{"text":"woweza kuwatanza wahaza wa hewo howowa walalile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ahyo, nakatambichizwa munhu yawele na wana wenji.","poem":1},{"lineBreak":true},{"text":"Holemwela hoyowa habehi na mng'honyo hali chitala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}