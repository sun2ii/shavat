{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":128,"content":[{"type":"heading","content":["Chonolo kwa munhu yalingumdumba Nguluwi"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"Nawatambichizwa weng'ha walingumdumba Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"walingikala kwa kuwinza nzila za heye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kowa na mafuza ga chituguti cha hegwe,","poem":1},{"lineBreak":true},{"text":"kosangalala na mbuli za hegwe zolutilila goya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mchewako kowa kota mzabibu wa mafuza menji kaye kwa hegwe,","poem":1},{"lineBreak":true},{"text":"wana wa hegwe kota mizuchila ja mizeituni kuzunguluta chisaga cha hegwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ena, ndo vyoyotambichizwa,","poem":1},{"lineBreak":true},{"text":"munhu yalingumdumba Mkulu Nguluwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mkulu Nguluwi yakutambichize kulawa Siyoni.","poem":1},{"lineBreak":true},{"text":"Uzone mbuli za Yelusalemu zilutilila goya mazuwa gose ga ukomu wa hegwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wikale mbaka uwone wazukulu wa hegwe.","poem":1},{"lineBreak":true},{"text":"Kikala goya kuwe na Isilaeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}