{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":129,"content":[{"type":"heading","content":["Kulanda kulinguwala wang'honyo wa Isilaeli"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"“Nawangaza ng'hatu kulawa kuli usongolo wa heni.”","poem":1},{"lineBreak":true},{"text":"Chila munhu kuli Isilaeli yalonje,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Nawangaza ng'hatu kulawa kuli usongolo wa heni,","poem":1},{"lineBreak":true},{"text":"ila hawawezile kusumya heni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nawanhowa ng'hatu kumgongo kwa heni,","poem":1},{"lineBreak":true},{"text":"kumgongo kwangu nakuwa kota misitali ja kumgunda.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ila Mkulu Nguluwi ndo katanganika,","poem":1},{"lineBreak":true},{"text":"nakandohola kulawa kuli ng'weso za wanhu wehile.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wabasigwe soni na kuhiluswa kumbele,","poem":1},{"lineBreak":true},{"text":"wala weng'ha walinguuzudila muji wa Siyoni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wawe kota misolo jilihela mizabi milefu,","poem":1},{"lineBreak":true},{"text":"jiwele janguswinhaga lojiwa jing'hali kukula,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kuduhu munhu yalingukola mijito ja kujikungajiza,","poem":1},{"lineBreak":true},{"text":"ne kuhola kota nyinza.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Haduhuli yalingukola habehi hoyolonga,","poem":1},{"lineBreak":true},{"text":"“Mkulu Nguluwi yawatambichize.","poem":1},{"lineBreak":true},{"text":"Twanguwatambichiza kwa itagwa lya Mkulu Nguluwi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}