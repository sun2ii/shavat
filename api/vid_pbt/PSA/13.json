{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Mkulu Nguluwi, kosemwa heni mbaka hanili?","poem":1},{"lineBreak":true},{"text":"Ndaze, kosemwa heni mbaka mazuwa gose?","poem":1},{"lineBreak":true},{"text":"Mbaka hanili kokuvisa kumeho kwa hegwe?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndowa na lunhwinhwi na majesa mbaka hanili,","poem":1},{"lineBreak":true},{"text":"masinzo mnhumbula chila zuwa?","poem":1},{"lineBreak":true},{"text":"Mbaka hanili wang'honyo wa heni wosumya heni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Undole na kunyhidichila, gwa Mkulu Nguluwi, Nguluwi wa heni.","poem":1},{"lineBreak":true},{"text":"Umhe heni mong'ho kahi, leka ndeche kufichigwa na usinjizi wa kubagama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Uleche kuwadita wang'honyo wa heni walonje,","poem":1},{"lineBreak":true},{"text":"“Natumsumya ayu.”","poem":1},{"lineBreak":true},{"text":"Walingungaza waleche kusangalalila kugwa kwa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ila heni ndangitumbila igano lya hegwe lya kwimilila,","poem":1},{"lineBreak":true},{"text":"nhumbula ya heni yangusangalala kwa chiwalo cha ulohozi wa hegwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndokwimbila hegwe, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa igano lya kwimilila lya hegwe lyoulilajile kwa heni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}