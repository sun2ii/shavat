{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa kuluta kuchanya.)"]},{"type":"verse","number":1,"content":[{"text":"Kulawa kuli magazo ga heni,","poem":1},{"lineBreak":true},{"text":"ndangukulilila, gwa Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gwa Mkulu, uhuliche lizi lya heni,","poem":1},{"lineBreak":true},{"text":"uwiche goya ikutu lya hegwe uhulichize kulanda kwa heni kwa isungu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, wone wahakumbuchile wihe wa hetwe","poem":1},{"lineBreak":true},{"text":"gwa Mkulu, whaani yahawezile kusulupuka kulawa kuli kugazigwa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ila kwa hegwe twanguwa na kulechelwa,","poem":1},{"lineBreak":true},{"text":"leka hetwe tukudumbe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndangitumbila kwa Mkulu Nguluwi kwa nhumbula ya heni yeng'ha,","poem":1},{"lineBreak":true},{"text":"ndina makundo ng'hatu na ulonzi wa heye.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndangitumbila kwa Mkulu,","poem":1},{"lineBreak":true},{"text":"kusinda wamizi walingubeteza kubwemwenzuka,","poem":1},{"lineBreak":true},{"text":"kusinda wamizi walingubeteza mitondo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwa Isilaeli, witumbile kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila kwa heye Mkulu Nguluwi kuna igano lya kwimilila,","poem":1},{"lineBreak":true},{"text":"kwa heye kuna mong'ho ng'hatu wa kutugombola.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Heye kowagombola wanhu wa Isilaeli,","poem":1},{"lineBreak":true},{"text":"kulawa kuli gehile ga hewo geng'ha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}