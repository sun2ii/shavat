[]},"thisChapterLink":"/api/vid_pbt/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}