{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"heading","content":["Kulombocheza kwa Waisilaeli kuli ujenzi"]},{"type":"verse","number":1,"content":[{"text":"Hafungo ha nzanda za Babuloni, natikalisa","poem":1},{"lineBreak":true},{"text":"natwali tulila vyotukumbuchile Siyoni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuli migodi ja isi yila,","poem":1},{"lineBreak":true},{"text":"natupatika migombogombo ja hetwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Watuholile tuwe wapogozi wa ngondo nawagana tuwembile,","poem":1},{"lineBreak":true},{"text":"walingutugaza nawatugana tuwasangalaze,","poem":1},{"lineBreak":true},{"text":"“Mtwimbile lwimbo lumwe hali nzimbo za Siyoni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Toweza ndaze kwimba lwimbo lwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kuli isi ya chijenzi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwa Yelusalemu, wone ndikusemwe,","poem":1},{"lineBreak":true},{"text":"moko wa heni wa kudilo usemwe uwanzi wa kutowa igombogombo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Umyango wa heni unanahile na kulemwela kwimba,","poem":1},{"lineBreak":true},{"text":"wone sikukumbuchile hegwe, gwa Yelusalemu,","poem":1},{"lineBreak":true},{"text":"ena, wone ndogana choneche kusinda kusangalala kwa Yelusalemu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwa Mkulu Nguluwi, uleche kusemwa gowaditile Waedomu,","poem":1},{"lineBreak":true},{"text":"zuwa lila Yelusalemu vyoiholigwe kuli upogozi,","poem":1},{"lineBreak":true},{"text":"ukumbuchile gowalonjile,","poem":1},{"lineBreak":true},{"text":"“Mbomole muji wa Yelusalemu.","poem":1},{"lineBreak":true},{"text":"Mng'humbule misisi jake.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gwa Babuloni, kodumigwa.","poem":1},{"lineBreak":true},{"text":"Kotambichizwa yula yawele yokuhilusila chibida kwa gehile goutuditile,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"yula yowahola wana wa hegwe,","poem":1},{"lineBreak":true},{"text":"na kuwahondanga kuli mitalawe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}