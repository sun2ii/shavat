{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":142,"content":[{"type":"heading","content":["Kulanda kwa munhu yalechigwe mchiwa"]},{"type":"hebrew_subtitle","content":["(Ilanguso lya Daudi loyawele kuli mhalika. Kulanda.)"]},{"type":"verse","number":1,"content":[{"text":"Ndangumlilila Mkulu Nguluwi kwa lizi,","poem":1},{"lineBreak":true},{"text":"ndangumdedeza Mkulu Nguluwi kwa lizi, leka yambonele isungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndangumuwichila kung'ung'uta kwa heni,","poem":1},{"lineBreak":true},{"text":"ndangumlonjela magazo ga heni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hondiwa habehi kugozola,","poem":1},{"lineBreak":true},{"text":"hegwe kwa baho, kwangunzela vyombele.","poem":1},{"lineBreak":true},{"text":"Wang'honyo wa heni nawambichila midiwa kuli nzila ya heni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hondilola ubanzi wa kudilo na kubeteza,","poem":1},{"lineBreak":true},{"text":"ndangona haduhu munhu wa kunhanza,","poem":1},{"lineBreak":true},{"text":"ndahela kahi honhu ha kubilimila,","poem":1},{"lineBreak":true},{"text":"haduhu munhu yalingijesa kwa chiwalo cha heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gwa Mkulu Nguluwi, ndangukulilila.","poem":1},{"lineBreak":true},{"text":"Hegwe ndo honhu ha heni ha kubilimila,","poem":1},{"lineBreak":true},{"text":"hegwe ndo chila chinhu kwa heni kuli isi ya wawele wakomu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uhulichize chililo cha heni, kwa vila nhoka lukami.","poem":1},{"lineBreak":true},{"text":"Undohole kulawa kwa walingungaza, kwa vila wana mong'ho kusinda heni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Undavye amu mchinweng'ho","poem":1},{"lineBreak":true},{"text":"leka ndonje malumbo kwa hegwe.","poem":1},{"lineBreak":true},{"text":"Wanhu watanganiche wochilumba na heni","poem":1},{"lineBreak":true},{"text":"kwa vila nakunditila ganojile menji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}