{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"heading","content":["Vilumbigwe vyeng'ha vimtogole Nguluwi"]},{"type":"verse","number":1,"content":[{"text":"Mumtogole Mkulu Nguluwi.","poem":1},{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi kulawa kilanga,","poem":1},{"lineBreak":true},{"text":"mumtogole kulawa ako kuchanya ng'hatu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mumtogole, hemwe wahilisi wa heye weng'ha,","poem":1},{"lineBreak":true},{"text":"mumtogole, hemwe wamizi wa heye weng'ha wa kilanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mumtogole hemwe isanya na nyelezi,","poem":1},{"lineBreak":true},{"text":"mumtogole hemwe nhondwe zeng'ha zilingupulika.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mumtogole hemwe ulanga wa kuchanya,","poem":1},{"lineBreak":true},{"text":"na mazi gawele kuchanya mwa ulanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vyeng'ha vilitogole itagwa lya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila heye nakalajiza na vyeng'ha navilumbigwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nakaviwika honhu hawo mazuwa gose,","poem":1},{"lineBreak":true},{"text":"kwa mzilo uwele hauweza kugaluswa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mumtogole Mkulu Nguluwi kulawa muisi,","poem":1},{"lineBreak":true},{"text":"hemwe mizoka ja mbahali na mgati ng'hatu mwa bahali, mumtogole.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mumtogole hemwe lumwemwesa na nhonya ya maganga na seluji na ng'hungugu,","poem":1},{"lineBreak":true},{"text":"mbeho ya nhigu ilingweneza mzilo wa heye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mumtogole hemwe vidunda vikulu na vidunda vidodo,","poem":1},{"lineBreak":true},{"text":"migodi ja mafuza na vihulo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mumtogole hemwe migongolo ja kisolo na ja kufujigwa,","poem":1},{"lineBreak":true},{"text":"vilumbigwe vyeng'ha vilingutambala na videje vyeng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mumtogole hemwe wandewa na wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"wang'hangala na vilongozi weng'ha muisi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mumtogole hemwe wasongolo na wahinza,","poem":1},{"lineBreak":true},{"text":"wasekulu weng'ha na wana kahi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mweng'ha mlitogole itagwa lya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila itagwa lya heye yaliyeka lyangwinuligwa,","poem":1},{"lineBreak":true},{"text":"ukulu wa heye wa kuchanya ng'hatu mwa isi na ulanga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nakawagalila mong'ho wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"kuhulichizwa kwa wanhu weng'ha walingukundigwa,","poem":1},{"lineBreak":true},{"text":"wanhu wa Isilaeli yawaganile.","poem":1},{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}