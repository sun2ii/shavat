{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"heading","content":["Lwimbo lwa kusumya"]},{"type":"verse","number":1,"content":[{"text":"Mumtogole Mkulu Nguluwi.","poem":1},{"lineBreak":true},{"text":"Mumwimbile Mkulu Nguluwi lwimbo lunyale,","poem":1},{"lineBreak":true},{"text":"mumtogole kuli nhing'hano ya walingukundigwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Usangalale, gwa Isilaeli, kwa chiwalo cha yakulumbile hegwe,","poem":1},{"lineBreak":true},{"text":"wenyeng'haye wa Siyoni, mtowe luchenze kwa chiwalo cha mndewa wa hemwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mlitogole itagwa lya heye kwa ngoma,","poem":1},{"lineBreak":true},{"text":"mmwimbile na kutowa ngoma na igombogombo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwa vila Mkulu Nguluwi kangunojezwaga na wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"nakawanoliga ulohozi walingunyenyetela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wanhu walingukundigwa wangusangalala kwa kusumya,","poem":1},{"lineBreak":true},{"text":"wasangalale mbaka howalinguwasa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wawe na lutogo lukulu lwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"na mipanga jiwele na kunoleche kwili mmoko mwa hewo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"wawahilulile chibida wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"wawagaze wanhu wa isi zinji,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"wawawohe wandewa wa hewo kwa minyololo,","poem":1},{"lineBreak":true},{"text":"na vilongozi wa hewo kwa pingu za chuma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"leka weneze magazo gogalajizwe na Nguluwi.","poem":1},{"lineBreak":true},{"text":"Alo ndo lutogo lwa walingukundigwa wa Nguluwi.","poem":1},{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}