{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"heading","content":["Goloko wa Nguluwi"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Mkulu Nguluwi, whaani yoweza kikala kuli ihema lya hegwe?","poem":1},{"lineBreak":true},{"text":"Whaani yoweza kikala mchanya mwa chidunda cha hegwe chelile?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndo munhu yalingikala ne nongwa,","poem":1},{"lineBreak":true},{"text":"mhela weng'ha kangudita gatanganiche,","poem":1},{"lineBreak":true},{"text":"yalingulonga ga kukomya kulawa mnhumbula,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ndo munhu yohambe yahehe wanhu,","poem":1},{"lineBreak":true},{"text":"yohambe yamditile gehile myage,","poem":1},{"lineBreak":true},{"text":"ne kumvilizila munhu yowalingikalasa habehi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ndo munhu yalinguwabeza walinguwabunza wayao,","poem":1},{"lineBreak":true},{"text":"ila kanguwahulichiza wala walingumdumba Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ndo munhu yohambe yagalamule chilaho cha heye hanga hamba chowifya mbuli za heye,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"yohambe yaziche sendi ya heye kwa kugana mzidi ng'hatu,","poem":1},{"lineBreak":true},{"text":"ne kubochela chinhu kwa chiwalo cha kumbunza yalihela nongwa.","poem":1},{"lineBreak":true},{"text":"Munhu yalingudita ago, hotigasika.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}