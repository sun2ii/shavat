{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":16,"content":[{"type":"heading","content":["Kulanda kikala goya"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Unyamile gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila kwa hegwe ndangubilimila kikala goya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndangumlonjela Mkulu Nguluwi, “Hegwe ndo Mkulu wa heni,","poem":1},{"lineBreak":true},{"text":"ndahela linojile lyoneche ila hegwe.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwa mbuli za welile wawele muisi,","poem":1},{"lineBreak":true},{"text":"kikala na hewo ndo kusangalala kwa heni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ila walingujifugamila milungu jinji,","poem":1},{"lineBreak":true},{"text":"wowa na magazo menji.","poem":1},{"lineBreak":true},{"text":"Nhambiko ya danda sijilavila","poem":1},{"lineBreak":true},{"text":"na matagwa ga milungu ajo sigalonga hebu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gwa Mkulu Nguluwi kwanguhega kwa heni,","poem":1},{"lineBreak":true},{"text":"nakuzidita mbuli za heni zeng'ha ziwe goya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nakumha heni ndolendole zinojile ng'hatu,","poem":1},{"lineBreak":true},{"text":"ena, uhalizi wa heni unoga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndangumtogola Mkulu Nguluwi kwa kundongoza,","poem":1},{"lineBreak":true},{"text":"mbaka mhela wa nechilo nhumbula ya heni yangundagusaga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndangumuwika Mkulu Nguluwi kumwando kwa heni mazuwa gose,","poem":1},{"lineBreak":true},{"text":"ka hamwe na heni, sitigasika.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lelo nhumbula ya heni yeng'ha yangusangalala na kutowa luchenze,","poem":1},{"lineBreak":true},{"text":"lukuli lwa heni lokwesela kwa kikala goya ng'hatu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ena hegwe huuleka muhe wa heni kuli isi ya wabagame,","poem":1},{"lineBreak":true},{"text":"hambe undeche, Yelile wa hegwe, nyole mchilaga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwangundajila nzila ya ukomu,","poem":1},{"lineBreak":true},{"text":"kuwa hamwe na hegwe kwangumemeza heni usangalalo wenele,","poem":1},{"lineBreak":true},{"text":"kuli moko wa hegwe uwele na mong'ho hana usangalalo mazuwa gose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}