{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":19,"content":[{"type":"heading","content":["Ukulu wa Nguluwi kuli vilumbigwe"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Kilanga kwangiwikula ukulu wa Nguluwi,","poem":1},{"lineBreak":true},{"text":"ulanga wangutawiza mijito ja moko ga heye.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chila zuwa lyanguulonga,","poem":1},{"lineBreak":true},{"text":"chila nechilo yanguzelesa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuduhu nhelo ama ulonzi ulingulonjigwa,","poem":1},{"lineBreak":true},{"text":"ne lizi lulinguhulikwa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ila lizi lya hewo lyangulutaga kuli isi yeng'ha,","poem":1},{"lineBreak":true},{"text":"na ulonzi wa hewo kuli kuduma kwa isi yeng'ha.","poem":1},{"lineBreak":true},{"text":"Nguluwi nakaliwichila isanya honhu hake kuli ulanga,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nalyo lyangulawa kota mkasano yalingulawa kuli chihengo cha heye,","poem":1},{"lineBreak":true},{"text":"lyangusangalala kota munhu yawele na mong'ho yalingubilima kuli nzila ya heye.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lyangulawaga ubanzi umwe,","poem":1},{"lineBreak":true},{"text":"na kuzunguluta mbaka ubanzi uyage,","poem":1},{"lineBreak":true},{"text":"haduhu choweza kibagula na ivuche lyake.","poem":1}]},{"type":"heading","content":["Malajizo ga Mkulu Nguluwi"]},{"type":"verse","number":7,"content":[{"text":"Ilajizo lya Mkulu Nguluwi ndo lyenela,","poem":1},{"lineBreak":true},{"text":"kangumpaga munhu ukomu unyale.","poem":1},{"lineBreak":true},{"text":"Ulolezi wa Mkulu Nguluwi nawima nzinzili,","poem":1},{"lineBreak":true},{"text":"kanguwapaga luhala walihela uwanzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Malajizo ga Mkulu Nguluwi ndo ga hachi,","poem":1},{"lineBreak":true},{"text":"kangusangalazaga nhumbula.","poem":1},{"lineBreak":true},{"text":"Mizilo ja Mkulu Nguluwi jahela nongwa,","poem":1},{"lineBreak":true},{"text":"jangigala lumuli kuli meho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kumdumba Mkulu Nguluwi ndo welile,","poem":1},{"lineBreak":true},{"text":"na wa kikala mazuwa gose.","poem":1},{"lineBreak":true},{"text":"Nhaguso za Mkulu Nguluwi ugoloka,","poem":1},{"lineBreak":true},{"text":"zeng'ha utanganika.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zangunojeza kusinda zahabu,","poem":1},{"lineBreak":true},{"text":"kusinda zahabu inojile ng'hatu,","poem":1},{"lineBreak":true},{"text":"zinona kusinda hanombwa,","poem":1},{"lineBreak":true},{"text":"kusinda hanombwa ilawile kuli ilala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kwa malanguso ga hegwe, ndangukanyigwa,","poem":1},{"lineBreak":true},{"text":"kwa kugawinza ndangupegwa chonolo chikulu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ila whaani yalingona nongwa za heye yuye?","poem":1},{"lineBreak":true},{"text":"Gwa Nguluwi, mbiche kutali na nongwa zohambe ndizizele.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Undemeze heni chitumagwa wa hegwe ndeche kudita gehile ga kunuwila,","poem":1},{"lineBreak":true},{"text":"uleche kukunda ago gandongoze.","poem":1},{"lineBreak":true},{"text":"Aho ndowa ndilihela nongwa,","poem":1},{"lineBreak":true},{"text":"siwa na gehile ng'hatu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ulonzi wa mlomo wa heni na majesa ga nhumbula ya heni,","poem":1},{"lineBreak":true},{"text":"gakundigwe hali hegwe, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"italawe lya heni na mgombozi wa heni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}