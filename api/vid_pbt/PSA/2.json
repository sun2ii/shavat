{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":2,"content":[{"type":"heading","content":["Mndewa yahaguligwe na Nguluwi"]},{"type":"verse","number":1,"content":[{"text":"Lekachoni wanhu wa isi wangubelenhuka?","poem":1},{"lineBreak":true},{"text":"Lekachoni wanhu wangiwika goya kwa uviso kwa mbuli za hihi hela?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wandewa wa isi wangiwika goya,","poem":1},{"lineBreak":true},{"text":"na wakulu wangikungajiza hamwe","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha kihanza majesa ga kumlema Mkulu Nguluwi na yabakalizwe mafuta wa heye.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wandewa awo wangulonga, “Tiwuse kuli ulongozi wa hewo,","poem":1},{"lineBreak":true},{"text":"tutoze kutali minyololo ja hewo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yula yalingulongoza kilanga kanguwaseka,","poem":1},{"lineBreak":true},{"text":"Nguluwi kanguwabeza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hamba kanguwang'hanuchila kwa ng'halazi ya heye,","poem":1},{"lineBreak":true},{"text":"na kuwadumbiza kwa kuzudila kwa heye, yolonga,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Nani nandimuwika mndewa wa heni, mchanya mwa Siyoni,","poem":1},{"lineBreak":true},{"text":"chidunda cha heni chelile.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndowikula mzilo wa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"“Hegwe ndo mwanangu,","poem":1},{"lineBreak":true},{"text":"heni lehano nandiwa mhaza wa hegwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Undande, nani ndokupa wanhu wa isi wawe uhalizi wa hegwe,","poem":1},{"lineBreak":true},{"text":"na mbaka ja isi jowa ja hegwe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kowatowa kwa ng'hweku ya chuma,","poem":1},{"lineBreak":true},{"text":"na kuwabena kota chijilo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lelo hemwe wandewa, muwe na luhala,","poem":1},{"lineBreak":true},{"text":"hemwe wakulu wa isi, mwangukanyigwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mumkolele mijito Mkulu Nguluwi kwa kudumba na kusangalala.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mumfugamile na kukakama,","poem":1},{"lineBreak":true},{"text":"leka yaleche kuzudila na kuwadumya baho du,","poem":1},{"lineBreak":true},{"text":"kwa vila heye kanguzudilaga himahima.","poem":1},{"lineBreak":true},{"text":"Wangutambichizwa weng'ha walingubilimila kikala goya kwa heye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}