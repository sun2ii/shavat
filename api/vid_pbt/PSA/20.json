{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"heading","content":["Kulanda kusumya"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi yakwidichile houwa kuli magazo,","poem":1},{"lineBreak":true},{"text":"itagwa lya Nguluwi wa Yakobo likwamile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yakuhilichile utanzi kulawila mng'handa mwa heye,","poem":1},{"lineBreak":true},{"text":"yakutanze kulawa chidunda cha Siyoni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yazikumbuchile ndolendole za hegwe zeng'ha,","poem":1},{"lineBreak":true},{"text":"yazikunde nhambiko za hegwe za kulakazwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yakupe goulingugana mnhumbula ya hegwe,","poem":1},{"lineBreak":true},{"text":"yazidite mbuli za hegwe zeng'ha zikulutile goya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Totowa luchenze kwa chiwalo cha kusumya kwa hegwe,","poem":1},{"lineBreak":true},{"text":"tokwinula bendela kulipa ukulu itagwa lya Nguluwi wa hetwe.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi yakwenezele kulanda kwa hegwe kweng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndanguvizela kota Mkulu Nguluwi komtanza mndewa yambakalize mafuta,","poem":1},{"lineBreak":true},{"text":"komwidichila kulawa mng'handa mwa heye kilanga,","poem":1},{"lineBreak":true},{"text":"kwa moko wa heye wa kudilo komdita yasumye ng'hatu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wanji wangitumbila mituka ja hewo ja kitowela ngondo,","poem":1},{"lineBreak":true},{"text":"wanji wangitumbila falasi wa hewo.","poem":1},{"lineBreak":true},{"text":"Ila hetwe twangitumbila Mkulu Nguluwi, Nguluwi wa hetwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hewo wochikwang'wala na kugwa,","poem":1},{"lineBreak":true},{"text":"ila hetwe tokwima nzinzili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Umdite mndewa yasumye, gwa Mkulu Nguluwi!","poem":1},{"lineBreak":true},{"text":"Utwidichile hotukulanda!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}