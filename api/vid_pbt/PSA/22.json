{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":22,"content":[{"type":"heading","content":["Chililo"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwimba kwa lwimbo lwa chifuno chidala cha lufuku. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Nguluwi wa heni, Nguluwi wa heni, lekachoni nakundeka?","poem":1},{"lineBreak":true},{"text":"Lekachoni kwa kutali ng'hatu kundohola,","poem":1},{"lineBreak":true},{"text":"kutali na chililo cha heni cha magazo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi wa heni, ndangulila nemisi ila hambe widichile,","poem":1},{"lineBreak":true},{"text":"ndangutowa iyowe nechilo, ila siweza kwesela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ila, hegwe kwa yelile,","poem":1},{"lineBreak":true},{"text":"hegwe kwangulongoza kulawa kuli chigoda cha hegwe cha undewa na kutogoligwa na Waisilaeli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wasekulu wa hetwe nawetumbila kwa hegwe,","poem":1},{"lineBreak":true},{"text":"nawetumbila kwa hegwe, nagwe nakuwalohola.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nawakulilila hegwe, nawaloholigwa,","poem":1},{"lineBreak":true},{"text":"nawakutumbila nawo hawabasigwe soni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ila heni nda linhu hela, siwele munhu,","poem":1},{"lineBreak":true},{"text":"ndemigwa na kubezigwa na wanhu weng'ha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Weng'ha walingumbona wangumbeza,","poem":1},{"lineBreak":true},{"text":"wangufyonya na kutigasa vitwi vya hewo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wangulongaga, “Nakamtumbila Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"lelo, Nguluwi yamgombole.","poem":1},{"lineBreak":true},{"text":"Wone Nguluwi kangunojezwa na heye,","poem":1},{"lineBreak":true},{"text":"lelo, yamlohole.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ila hegwe ndo undavile mmunda mwa mayangu,","poem":1},{"lineBreak":true},{"text":"nakumbika hanojile kuli mhambaga ya mayangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nandikutumbila kulawa kupondigwa kwa heni.","poem":1},{"lineBreak":true},{"text":"Kulawa lomhondigwe, hegwe nawali Nguluwi wa heni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Uleche kuwa kutali na heni,","poem":1},{"lineBreak":true},{"text":"kwa vila magazo ga habehi,","poem":1},{"lineBreak":true},{"text":"haduhu wa kunhanza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wang'honyo wenji nawanzunguluta kota mibuguma,","poem":1},{"lineBreak":true},{"text":"wamema chila ubanzi wa heni kota mibuguma jing'hang'hale ja Bashani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wangugabula milomo ja hewo kota isimba,","poem":1},{"lineBreak":true},{"text":"liwele goya kuvaba heni na kundadula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Namala kota mazi gabohoche,","poem":1},{"lineBreak":true},{"text":"mizeje ja heni najiseleuka,","poem":1},{"lineBreak":true},{"text":"nhumbula ya heni ndo kota ihota,","poem":1},{"lineBreak":true},{"text":"yangusungulumuka mgati mwa heni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ikolomelo lya heni nalikala ng'hatu,","poem":1},{"lineBreak":true},{"text":"umyango wa heni wangunanahila kumlomo kwa heni.","poem":1},{"lineBreak":true},{"text":"Nakundeka kuli nimbwisi ya kubagama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Chilundo cha wehile nachinzunguluta,","poem":1},{"lineBreak":true},{"text":"nawanzunguluta kota chilundo cha mibwa,","poem":1},{"lineBreak":true},{"text":"kota isimba, nawandadula kuli moko na magulu ga heni.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mhona mizeje hela,","poem":1},{"lineBreak":true},{"text":"wang'honyo wa heni wangundola na kundonga vibi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wangigawila nguwo za heni,","poem":1},{"lineBreak":true},{"text":"wangulitowela simbi ivalo lya heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ila hegwe gwa Mkulu Nguluwi, uleche kuwa kutali na heni.","poem":1},{"lineBreak":true},{"text":"Hegwe mong'ho wa heni, uye himahima kunhanza.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Undohole kulawa kuli ipanga,","poem":1},{"lineBreak":true},{"text":"ulohole ukomu wa heni mli ndole za mibwa ajo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Undohole kumlomo mwa isimba,","poem":1},{"lineBreak":true},{"text":"undohole kulawa kuli mbalati za mibogo ajo.","poem":1}]},{"type":"heading","content":["Lwimbo lwa kulonga malumbo"]},{"type":"verse","number":22,"content":[{"text":"Ndowasimila wang'holozangu itagwa lya hegwe,","poem":1},{"lineBreak":true},{"text":"ndokutogola hali nhing'hano ya hewo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"“Hemwe mlingumdumba Mkulu Nguluwi, mumtogole.","poem":1},{"lineBreak":true},{"text":"Mumhulichize hemwe walelwa weng'ha wa Yakobo.","poem":1},{"lineBreak":true},{"text":"Mumfugamile Nguluwi hemwe walelwa weng'ha wa Isilaeli.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kwa vila heye halingubeza ne kuzudila ung'hochele wa ng'hochele,","poem":1},{"lineBreak":true},{"text":"ne kivisa kutali na heye,","poem":1},{"lineBreak":true},{"text":"ila kangumhulika hoyomlanda utanzi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kwa chiwalo cha hegwe ndokutogola,","poem":1},{"lineBreak":true},{"text":"hali nhing'hano ng'hulu ya wanhu,","poem":1},{"lineBreak":true},{"text":"ndokweneza chilaho cha heni hali hewo walingukudumba.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wazunwa wolya na kiguta,","poem":1},{"lineBreak":true},{"text":"walingumpala Mkulu Nguluwi womtogola.","poem":1},{"lineBreak":true},{"text":"Nguluwi yawatambichize kikala mazuwa gose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Isi zeng'ha zokumbuchila na kumhiluchila Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"wanhu wa isi zeng'ha womfugamila,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"kwa vila Mkulu Nguluwi ndo mndewa,","poem":1},{"lineBreak":true},{"text":"heye kanguwalongoza wanhu wa isi zeng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Wawele na lufufu weng'ha muisi, wofugama hali heye,","poem":1},{"lineBreak":true},{"text":"weng'ha wawele wobagama wofugama hali heye,","poem":1},{"lineBreak":true},{"text":"weng'ha wohambe waweze kulutiliza ukomu wa hewo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Lulelo lulinguya lwomkolela mijito,","poem":1},{"lineBreak":true},{"text":"wanhu wolusimila mbuli za Nguluwi,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"wowikula madito ga heye ga hachi.","poem":1},{"lineBreak":true},{"text":"Wanhu wowawele wang'hali kupondigwa wolonjelwa,","poem":1},{"lineBreak":true},{"text":"“Mkulu Nguluwi nakadita kwa hachi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}