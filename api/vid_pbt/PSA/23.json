{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"heading","content":["Mdimi"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi ndo mdimi wa heni,","poem":1},{"lineBreak":true},{"text":"sipunguchilwa na chinhu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hali honhu ha misolo midodi kangumbasilizaga,","poem":1},{"lineBreak":true},{"text":"hafungo ha mazi gasindamale kangundongozaga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kanguuhilusilaga muhe wa heni mong'ho unyale.","poem":1},{"lineBreak":true},{"text":"Kuli nzila ya hachi kangundongozaga,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha kuzeleka kwa heye.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hanga hondikola hali ibindi lya jiza likulu lya kubagama,","poem":1},{"lineBreak":true},{"text":"sidumba wihe woneche,","poem":1},{"lineBreak":true},{"text":"kwa vila hegwe, gwa Mkulu Nguluwi kwa hamwe na heni,","poem":1},{"lineBreak":true},{"text":"nyimbati na ng'hweku ya hegwe vyangunyamila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nakumbichila goya mnvina hali wang'honyo wa heni,","poem":1},{"lineBreak":true},{"text":"nakumbakaliza heni mafuta kumutwi,","poem":1},{"lineBreak":true},{"text":"chizombe cha heni chimema lukami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwa kukomya, kunoga kwa hegwe na igano lya kwimilila lya hegwe vyowa hamwe na heni,","poem":1},{"lineBreak":true},{"text":"kuli mazuwa geng'ha ga ukomu wa heni,","poem":1},{"lineBreak":true},{"text":"nani ndochikala kuli ng'handa ya Mkulu Nguluwi mazuwa gose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}