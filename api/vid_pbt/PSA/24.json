{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"heading","content":["Mndewa Mkulu"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Isi na vyeng'ha viwele mgati mwake ndo vya heye Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"isi na weng'ha walingikala mgati mwake ndo vya heye.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwa vila heye nakawika misisi ja isi mchanya mwa bahali,","poem":1},{"lineBreak":true},{"text":"nakajiwika nzinzili mchanya mwa nzanda za mazi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Whaani yokwina kuli chidunda cha Mkulu Nguluwi?","poem":1},{"lineBreak":true},{"text":"Whaani yochikala kuli ng'handa ya heye yelile?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Munhu yawele na madito ganojile na nhumbula nzelu,","poem":1},{"lineBreak":true},{"text":"yohambe yauwiche muhe wa heye kuli kudeta,","poem":1},{"lineBreak":true},{"text":"ne kilaha kwa udesi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Munhu ayo kobochela utambichizo kulawa kwa Mkulu Nguluwi","poem":1},{"lineBreak":true},{"text":"na hachi ya heye kulawa kwa Nguluwi wa ulohozi wa heye.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndo vyoluwele lulelo lwa walingumpala heye,","poem":1},{"lineBreak":true},{"text":"ena, wanhu walingumpala Nguluwi wa Yakobo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mchumuche hemwe lwizi,","poem":1},{"lineBreak":true},{"text":"mchumuche, hemwe lwizi lwa katali,","poem":1},{"lineBreak":true},{"text":"mndewa mkulu yaweze kwinjila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Whaani ayo Mndewa mkulu?","poem":1},{"lineBreak":true},{"text":"Ndo Mkulu Nguluwi Yawele na Mong'ho na ludali,","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi Yawele na Ludali kuli ngondo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mchumuche hemwe lwizi","poem":1},{"lineBreak":true},{"text":"mchumuche, hemwe lwizi lwa katali,","poem":1},{"lineBreak":true},{"text":"mndewa mkulu yaweze kwinjila.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Whaani ayo Mndewa mkulu?","poem":1},{"lineBreak":true},{"text":"Ndo Mkulu Nguluwi Yawele na Mong'ho,","poem":1},{"lineBreak":true},{"text":"heye ndo Mndewa wa ukulu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}