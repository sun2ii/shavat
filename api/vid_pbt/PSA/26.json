{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"heading","content":["Kulanda kwa munhu yanojile"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Mkulu Nguluwi, umhe heni hachi,","poem":1},{"lineBreak":true},{"text":"kwa vila nandikala kwa kugoloka,","poem":1},{"lineBreak":true},{"text":"nanditumbila kwa hegwe ne kukuleka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, umhugajize na kunjeza,","poem":1},{"lineBreak":true},{"text":"uitaguse nhumbula ya heni na nyhala za heni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mazuwa gose silisemwa igano lya kwimilila lya hegwe,","poem":1},{"lineBreak":true},{"text":"ndangikala kwa chiwalo cha kukundigwa kwa hegwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hambe ndilumbe hamwe na wanhu wadesi,","poem":1},{"lineBreak":true},{"text":"hambe ndihanze na wanhu wahadi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndanguzizudila nhing'hano za wajilile,","poem":1},{"lineBreak":true},{"text":"na kilumba hamwe na wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndanguhovuga moko ga heni kulajila ndahela nongwa,","poem":1},{"lineBreak":true},{"text":"na kuhahejelela honhu ha hegwe ha kulavila nhambiko, Gwa Mkulu Nguluwi,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kuno ndikwimba lwimbo lwa kuta malumbo,","poem":1},{"lineBreak":true},{"text":"na kusimila madito ga hegwe geng'ha ga kububuwaza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mkulu Nguluwi, nojezwa na ng'handa ya hegwe, honhu houlingikala,","poem":1},{"lineBreak":true},{"text":"honhu houlingikala ukulu wa hegwe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uleche kundumya hamwe na wawele na gehile,","poem":1},{"lineBreak":true},{"text":"ne kunhoza hamwe na walingukopola,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"wanhu wawele madito ga hewo ndo ga wihe mazuwa gose,","poem":1},{"lineBreak":true},{"text":"wanhu wawele wamema kugana kubochela chinhu leka kwajiliza hachi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ila heni ndangikala kwa kugoloka,","poem":1},{"lineBreak":true},{"text":"ungombole na kumbonela isungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndangwima hali honhu hawele na kikala goya,","poem":1},{"lineBreak":true},{"text":"ndomtogola Mkulu Nguluwi, kuli nhing'hano ng'hulu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}