{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":27,"content":[{"type":"heading","content":["Lwimbo lwa kumtogola Mkulu Nguluwi"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi ndo lumuli lwa heni na ulohozi wa heni,","poem":1},{"lineBreak":true},{"text":"ndimdumbe whaani?","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi ndo ngome ya ukomu wa heni,","poem":1},{"lineBreak":true},{"text":"ndimdumbe whaani?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wehile howonhowa,","poem":1},{"lineBreak":true},{"text":"na kugana kundumya,","poem":1},{"lineBreak":true},{"text":"wang'honyo na walingitwanza na heni wochikwang'wala na kugwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hanga wamizi howonzunguluta,","poem":1},{"lineBreak":true},{"text":"nhumbula ya heni haidumba chinhu,","poem":1},{"lineBreak":true},{"text":"hanga ngondo hoilawila kwa heni,","poem":1},{"lineBreak":true},{"text":"ndowa nding'hali na kitumbila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mbuli imwe nandimlanda Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ayo ndo ndilinguipala,","poem":1},{"lineBreak":true},{"text":"ndikale mng'handa mwa Mkulu Nguluwi","poem":1},{"lineBreak":true},{"text":"mazuwa geng'ha ga ukomu wa heni,","poem":1},{"lineBreak":true},{"text":"ndijese ng'hatu kunoga kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"na kupala ulongozi wa heye kuli ng'handa ya heye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kukomya, zuwa lya magazo konyamila kuli chibumuli cha heye,","poem":1},{"lineBreak":true},{"text":"kovisa heni kuli ihema lya heye,","poem":1},{"lineBreak":true},{"text":"na kumbika kwa kikala goya mchanya mwa italawe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwa kusumya nani ndolola mchanya mwa wang'honyo wa heni walingunzunguluta.","poem":1},{"lineBreak":true},{"text":"Ndomlavila nhambiko kwa kutowa luchenze mgati mwa ng'handa ya heye,","poem":1},{"lineBreak":true},{"text":"ndokwimba na kumtowela luchenze Mkulu Nguluwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwa Mkulu Nguluwi, unyhulichize hondikulilila,","poem":1},{"lineBreak":true},{"text":"umbonele isungu na kunyhidichila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nhumbula ya heni yangundonjela, “Uye umpale Nguluwi.”","poem":1},{"lineBreak":true},{"text":"Lelo, ndanguya kwa hegwe, gwa Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uleche kuleka kundola,","poem":1},{"lineBreak":true},{"text":"uleche kundema kwa ng'halazi heni chitumagwa wa hegwe.","poem":1},{"lineBreak":true},{"text":"Hegwe nawali utanzi wa heni.","poem":1},{"lineBreak":true},{"text":"Uleche kunhoza ne kundeka, gwa Nguluwi Mlohozi wa heni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hanga mhaza na mayangu howondeka,","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi kombochela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gwa Mkulu Nguluwi, undanguse nzila ya hegwe,","poem":1},{"lineBreak":true},{"text":"undongoze kuli nzila igoloche,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha wang'honyo wa heni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uleche kundeka leka wang'honyo wa heni wanditile vyowogana,","poem":1},{"lineBreak":true},{"text":"kwa vila walolezi wa udesi nawambuyila,","poem":1},{"lineBreak":true},{"text":"hewo walingulavya ulonjelezi wihile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndangukunda kota ndolyona isungu lya Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"kuli isi ya wawele wakomu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Witumbile kwa Mkulu Nguluwi.","poem":1},{"lineBreak":true},{"text":"Wime nzinzili, uleche kugozola.","poem":1},{"lineBreak":true},{"text":"Ena, witumbile kwa Mkulu Nguluwi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}