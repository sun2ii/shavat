{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi loyambilime Abusalomu, mwanage.)"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi, wang'honyo wa heni nawonjezeka!","poem":1},{"lineBreak":true},{"text":"Walingunhowa ndo wenji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndo wenji walingulonga,","poem":1},{"lineBreak":true},{"text":"“Nguluwi homlohola.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ila hegwe Mkulu Nguluwi, kwa ngawo ya heni banzi zeng'ha,","poem":1},{"lineBreak":true},{"text":"kwa hegwe ndanguwa na lutogo na kusumya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwa lizi lya heni ndangumchema Mkulu Nguluwi","poem":1},{"lineBreak":true},{"text":"naye kangwidichila kulawa kuli chidunda cha heye chelile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndanguwasa na kuwa na usinjizi,","poem":1},{"lineBreak":true},{"text":"ndangwinuka kahi kwa vila hegwe, gwa Mkulu Nguluwi kwangunyimiza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hambe ndumbe wanhu elufu na maelufu,","poem":1},{"lineBreak":true},{"text":"hanga wangunhowa banzi zeng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mkulu Nguluwi winuche!","poem":1},{"lineBreak":true},{"text":"Nguluwi wa heni undohole!","poem":1},{"lineBreak":true},{"text":"Uwatowe wang'honyo wa heni weng'ha kwa mizeje ja milomo ja hewo,","poem":1},{"lineBreak":true},{"text":"ubene mizino ja wehile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kwa vila ulohozi ndo wa Mkulu Nguluwi.","poem":1},{"lineBreak":true},{"text":"Utambichizo wa hegwe uwe mchanya mwa wanhu wa hegwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}