{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":35,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Mkulu Nguluwi, witwanze na walingitwanza na heni,","poem":1},{"lineBreak":true},{"text":"uwatowe hewo walingunhowa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uhole ngawo ya hegwe,","poem":1},{"lineBreak":true},{"text":"winuche uye unhanze.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Uwiche goya igoha na ipanga lya hegwe kwa chiwalo cha walingumbilimisa.","poem":1},{"lineBreak":true},{"text":"Undonjele kota kondohola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wabasigwe soni na kudeula,","poem":1},{"lineBreak":true},{"text":"hewo walingugana kung'hopola.","poem":1},{"lineBreak":true},{"text":"Wahiluse kumbele kwa soni,","poem":1},{"lineBreak":true},{"text":"hewo walingijesa kundumya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wawe kota mhumba hali mbeho,","poem":1},{"lineBreak":true},{"text":"lowobilimiswa na mhilisi wa Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nzila ya hewo iwe ya jiza na kutelela,","poem":1},{"lineBreak":true},{"text":"lowowinjigwa na mhilisi wa Mkulu Nguluwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwa vila ne chiwalo choneche nawambichila midiwa,","poem":1},{"lineBreak":true},{"text":"wambawila ikulubila ne nongwa yoneche.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kudumigwa kuwafiche hewo himahima,","poem":1},{"lineBreak":true},{"text":"wagwilizwe kuli idiwa hewo wawo,","poem":1},{"lineBreak":true},{"text":"wagwe mgati na kudumigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Aho ndosangalala kwa chiwalo cha Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ndotowa luchenze kwa vila heye nakandohola.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndomlonjela Mkulu Nguluwi kwa nhumbula ya heni yeng'ha,","poem":1},{"lineBreak":true},{"text":"“Gwa Mkulu Nguluwi, haduhu yawele kota hegwe.","poem":1},{"lineBreak":true},{"text":"Hegwe kwanguwalohola ng'hochele kuli ndole za wawele na mong'ho,","poem":1},{"lineBreak":true},{"text":"wazunwa na walihela chinhu mmoko mwa wabokaji.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Walolezi wajuvi wangilajila,","poem":1},{"lineBreak":true},{"text":"wangumbuza mbuli zohambe ndizizele.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wangunyhilusila gehile honhu ha ganojile,","poem":1},{"lineBreak":true},{"text":"mbaka heni ndanguwa kuli uchiwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ila hewo nalowawele watamwa,","poem":1},{"lineBreak":true},{"text":"heni navala migunila kulajila masinzo,","poem":1},{"lineBreak":true},{"text":"nandingaza kwa kuleka kulya.","poem":1},{"lineBreak":true},{"text":"Ndilanda kwa kinamiza mutwi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"kota ndangumlilila goloko wa heni ama mng'holozangu.","poem":1},{"lineBreak":true},{"text":"Nanduta nandinamiza mutwi kwa masinzo,","poem":1},{"lineBreak":true},{"text":"kota munhu yalingulombocheza kubagama kwa mayake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ila vyondikwang'hwale nawekungajiza na kusangalala.","poem":1},{"lineBreak":true},{"text":"Nawekungajiza hamwe kwa chiwalo cha heni.","poem":1},{"lineBreak":true},{"text":"Wanhu wohambe ndiwazele nawanhowa ne kuleka.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wanhu wawele wanguwabezaga mbaka vyete,","poem":1},{"lineBreak":true},{"text":"nawang'hanuchila kwa kuzudila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gwa Mkulu Nguluwi, kolola hela mbaka hanili?","poem":1},{"lineBreak":true},{"text":"Undohole kulawa kuli kudumigwa na hewo,","poem":1},{"lineBreak":true},{"text":"ulohole ukomu wa heni kulawa kuli misimba ajo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ndolonga malumbo hali nhing'hano ng'hulu ya wanhu,","poem":1},{"lineBreak":true},{"text":"ndokutogola hali wanhu wenji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uleche kuwaleka wang'honyo awo wandonje vibi,","poem":1},{"lineBreak":true},{"text":"hewo walingunzudila hela wasangalale kwa chiwalo cha magazo ga heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hambe walonje kwa kikala goya,","poem":1},{"lineBreak":true},{"text":"ila wangulonga ulonjelezi wa udesi,","poem":1},{"lineBreak":true},{"text":"kwa kitwanza na wenyeng'haye wasindamale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Wangundonjeleza kwa lizi,","poem":1},{"lineBreak":true},{"text":"“Goya! Goya! Natona gouditile.”","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ila, gwa Mkulu Nguluwi, kwanguyona mbuli ayo,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, uleche kunyamalila,","poem":1},{"lineBreak":true},{"text":"uleche kuwa kutali na heni.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Winuche, gwa Mkulu Nguluwi unhowanile,","poem":1},{"lineBreak":true},{"text":"unyamile gwa Nguluwi na Mkulu wa heni.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, Nguluwi wa heni, unhowanile,","poem":1},{"lineBreak":true},{"text":"udite kwa kiwhana na kutanganika kwa hegwe,","poem":1},{"lineBreak":true},{"text":"uleche kuwaleka wang'honyo wa heni wandonje vibi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Uleche kuwaleka wejese, “Mbuli za hetwe nazitulutila goya kota vyotuganile.”","poem":1},{"lineBreak":true},{"text":"Ama walonje, “Natumdumya ayu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Waleche hewo walingusangalalila kudumigwa kwa heni,","poem":1},{"lineBreak":true},{"text":"walemwele weng'ha na kudeula.","poem":1},{"lineBreak":true},{"text":"Hewo weng'ha walingiwona wanojile kusinda heni,","poem":1},{"lineBreak":true},{"text":"wadeule na kona soni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ila walingugana kona kota heni nda yatanganiche,","poem":1},{"lineBreak":true},{"text":"wakwinize lizi kwa kusangalala walonje mazuwa gose,","poem":1},{"lineBreak":true},{"text":"“Mkulu Nguluwi ndo mkulu ng'hatu.","poem":1},{"lineBreak":true},{"text":"Kangunojezwa na kunoga kwa chitumagwa wa heye.”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aho nani ndowikula kutanganika kwa hegwe,","poem":1},{"lineBreak":true},{"text":"ndolonga lutogo lwa hegwe nemisi yeng'ha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}