{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":4,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Kwa yula yalingwaluchiza kwimba na vinhu vya ng'weso za muziki. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi wa heni ulingundewela, ndangulanda unyidichile hondilanda.","poem":1},{"lineBreak":true},{"text":"Lombele kuli kugaya, hegwe nakunhanza,","poem":1},{"lineBreak":true},{"text":"umbonele isungu na kuhulichiza kulanda kwa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwela yoo, mowifya ukulu wa heni kwa soni mbaka nili?","poem":1},{"lineBreak":true},{"text":"Ndaze, mogana upoka na uhadi mbaka nili?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ila mvizele kota Mkulu Nguluwi nakehagulila munhu wa heye yalingumhulichiza mazuwa gose.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi kanguhulichizaga hondimchema.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mdumbe na mleche kudita gehile,","poem":1},{"lineBreak":true},{"text":"mijese ng'hatu kuli vinhanda vya hemwe na minyamalile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mlavye nhambiko za hachi,","poem":1},{"lineBreak":true},{"text":"na kitumbila kwa Mkulu Nguluwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wanhu wenji wangulongaga, “Whaani yalinguweza kutulajila ganojile?”","poem":1},{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, utulole kwa isungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ila nakumha heni kusangalala kukulu mnhumbula,","poem":1},{"lineBreak":true},{"text":"kusinda hewo wawele na divai na nyhule kwa winji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndanguwasaga na kuwa na usinjizi kwa kikala goya,","poem":1},{"lineBreak":true},{"text":"kwa vila gwa Mkulu Nguluwi, hegwe uliyeka kwangumbika honhu hanojile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}