{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":40,"content":[{"type":"heading","content":["Lwimbo lwa lutogo"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Nandimbeteza Mkulu Nguluwi kwa kwimilila,","poem":1},{"lineBreak":true},{"text":"nakanyuyila na kuhulika chililo cha heni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nakambusa kulawa kuli ikulubila likulu,","poem":1},{"lineBreak":true},{"text":"nakandavya kuli ndidi za ilamba,","poem":1},{"lineBreak":true},{"text":"nakemiza goya magulu ga heni mchanya mwa italawe,","poem":1},{"lineBreak":true},{"text":"nakagapa mong'ho magulu ga heni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nakandangusa lwimbo lunyale,","poem":1},{"lineBreak":true},{"text":"lwimbo lwa lutogo kwa Nguluwi wa hetwe.","poem":1},{"lineBreak":true},{"text":"Wenji womlola na kumdumba Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"na kitumbila kwa heye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nakatambichizwa munhu yalingitumbila kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"munhu yohambe yelumbe na wanhu walingidaya,","poem":1},{"lineBreak":true},{"text":"wala walingujifugamila milungu ja udesi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, Nguluwi wa heni, nakutuditila kwa winji,","poem":1},{"lineBreak":true},{"text":"vinduzanduza na majesa ga hegwe kwa hetwe.","poem":1},{"lineBreak":true},{"text":"Haduhu yoweza kuwhanizwa na hegwe.","poem":1},{"lineBreak":true},{"text":"Wone ndahaganile kugawikula na kugadamla,","poem":1},{"lineBreak":true},{"text":"ndo menji lukami kugawaza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hegwe hulingunojezwa na nhambiko ne nhambiko za kulakazwa,","poem":1},{"lineBreak":true},{"text":"ila nakumha heni makutu ndikuhuliche.","poem":1},{"lineBreak":true},{"text":"Nhambiko za kulakazwa na nhambiko za kusa gehile hulinguzigana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aho nandonga, “Ulole nambuya,","poem":1},{"lineBreak":true},{"text":"kuli chitabu nagandichigwa kuwala heni,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kota ndangusangalala kweneza goulingugana, gwa Nguluwi wa heni,","poem":1},{"lineBreak":true},{"text":"ilajizo lya hegwe ndangulibatilila kwa nhumbula ya heni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nasimila mbuli inojile ya kutanganika,","poem":1},{"lineBreak":true},{"text":"hali nhing'hano ng'hulu ya wanhu.","poem":1},{"lineBreak":true},{"text":"Kota vyouvizelele, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"heni hambe ndilemeze kuiwikula.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sivisile mnhumbula mwa heni kutanganika kwa hegwe,","poem":1},{"lineBreak":true},{"text":"nandiwikula kota hegwe kwa mlohozi wa kukundigwa.","poem":1},{"lineBreak":true},{"text":"Siivisile nhing'hano ng'hulu ya wanhu,","poem":1},{"lineBreak":true},{"text":"igano lya hegwe lya kwimilila na kukundigwa kwa hegwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gwa Mkulu Nguluwi, uleche kuleka kumha heni isungu lya hegwe.","poem":1},{"lineBreak":true},{"text":"Igano lya hegwe lya kwimilila na kukundigwa kwa hegwe vinyamile mazuwa gose.","poem":1}]},{"type":"heading","content":["Kulanda utanzi"]},{"type":"verse","number":12,"content":[{"text":"Kudumya kohambe kuwazigwe, kwangunzunguluta heni,","poem":1},{"lineBreak":true},{"text":"gehile ga heni gangundinya mbaka ndangulemwela kona,","poem":1},{"lineBreak":true},{"text":"ga menji kusinda mnvili kumutwi kwa heni,","poem":1},{"lineBreak":true},{"text":"nani ngozola.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, ugane kundohola,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, uye himahima kunhanza.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Walingugana kundumya,","poem":1},{"lineBreak":true},{"text":"wabasigwe soni na kudeula.","poem":1},{"lineBreak":true},{"text":"Hewo walingugana ndumile,","poem":1},{"lineBreak":true},{"text":"wahiluche kumbele na kubezigwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hewo walinguseka heni,","poem":1},{"lineBreak":true},{"text":"wabubuwale kwa kulemwela kwa hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ila wala weng'ha walingukupala hegwe,","poem":1},{"lineBreak":true},{"text":"wasangalale na kutowa luchenze kwa chiwalo cha hegwe.","poem":1},{"lineBreak":true},{"text":"Walinguugana ulohozi wa hegwe,","poem":1},{"lineBreak":true},{"text":"walonje mazuwa gose, “Mkulu Nguluwi ndo Mkulu!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nani nda mzunwa na ndilihela chinhu,","poem":1},{"lineBreak":true},{"text":"ila gwa Mkulu, hegwe kwangung'humbuka heni.","poem":1},{"lineBreak":true},{"text":"Hegwe ndo mtanzi wa heni na mlohozi wa heni,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, uye uleche kukawila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}