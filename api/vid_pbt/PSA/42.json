{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Ilanguso lya Wakola.)"]},{"type":"heading","content":["Kulanda kwa yabilimiswe kuli isi ya heye"]},{"type":"verse","number":1,"content":[{"text":"Kota ibala vyolilingugana mazi ga kazanda,","poem":1},{"lineBreak":true},{"text":"ndo vyondilingukugana, gwa Nguluwi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndina ng'halu ya Nguluwi, ng'halu ya Nguluwi yawele mkomu.","poem":1},{"lineBreak":true},{"text":"Ndofika hanili kwa heye na kukona kumeho kwa heye?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mahozi nagawa chilyo cha heni nemisi na nechilo,","poem":1},{"lineBreak":true},{"text":"lowandonjele chila zuwa,","poem":1},{"lineBreak":true},{"text":"“Kakohi Nguluwi wa hegwe?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndangukumbuka kahi mbuli azi kwa masinzo mnhumbula ya heni,","poem":1},{"lineBreak":true},{"text":"ndaze vyondutile na chilundo cha wanhu,","poem":1},{"lineBreak":true},{"text":"nandiwalongoza kuluta haluga ha Nguluwi,","poem":1},{"lineBreak":true},{"text":"wotowa luchenze lwa lutogo,","poem":1},{"lineBreak":true},{"text":"hali chilundo cha wanhu wodita mnvina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lekachoni ndangutweguka nhumbula?","poem":1},{"lineBreak":true},{"text":"Lekachoni ndangusumajila ahyo mgati mwa heni?","poem":1},{"lineBreak":true},{"text":"Ndochitumbila kwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila ndomtogola kahi","poem":1},{"lineBreak":true},{"text":"heye yawele ulohozi wa heni na Nguluwi wa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nanzungulutwa na masinzo mnhumbula mwa heni,","poem":1},{"lineBreak":true},{"text":"lelo ndangukukumbuchila hegwe, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"kulawa kuli honhu ha Yolodani,","poem":1},{"lineBreak":true},{"text":"kulawa chidunda cha Helimoni na Misali.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nafikwa na mazi tendema,","poem":1},{"lineBreak":true},{"text":"mazi tendema ga hegwe ganguchema kubuguma,","poem":1},{"lineBreak":true},{"text":"nhigu na magazo ga hegwe,","poem":1},{"lineBreak":true},{"text":"vya mchanya mwa heni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kongana heni kwa igano lya heye lya kwimilila nemisi,","poem":1},{"lineBreak":true},{"text":"nakamha heni lwimbo lwa lutogo nechilo,","poem":1},{"lineBreak":true},{"text":"lwimbo lwa kumlanda Nguluwi wa ukomu wa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndangumlonjela Nguluwi, italawe lya heni,","poem":1},{"lineBreak":true},{"text":"“Lekachoni nakusemwa heni?","poem":1},{"lineBreak":true},{"text":"Lekachoni ndute aku na ako ndilombocheza,","poem":1},{"lineBreak":true},{"text":"kwa kubunzwa na wang'honyo wa heni?”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mhondigwa kwa maligo ga hewo,","poem":1},{"lineBreak":true},{"text":"vyowombuza chila zuwa,","poem":1},{"lineBreak":true},{"text":"“Kakohi Nguluwi wa hegwe?”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lekachoni ndangutweguka nhumbula?","poem":1},{"lineBreak":true},{"text":"Lekachoni ndangusumajila ahyo mgati mwa heni?","poem":1},{"lineBreak":true},{"text":"Ndochitumbila kwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila ndomtogola kahi","poem":1},{"lineBreak":true},{"text":"heye yawele ulohozi wa heni na Nguluwi wa heni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}