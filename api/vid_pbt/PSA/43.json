{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"heading","content":["Kulanda kwa yabilimiswe kuli isi ya heye"]},{"type":"hebrew_subtitle","content":["(Lwimbo lwa 42 lwangulutilila.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, ulajile kota ndahela nongwa,","poem":1},{"lineBreak":true},{"text":"uilewele mbuli ya heni kwa wanhu wa isi yihile,","poem":1},{"lineBreak":true},{"text":"undohole kulawa kwa wanhu wadesi na wehile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndangubilimila kikala goya kwa hegwe, gwa Nguluwi.","poem":1},{"lineBreak":true},{"text":"Lekachoni kunhoza kutali?","poem":1},{"lineBreak":true},{"text":"Lekachoni ndute aku na ako ndilombocheza,","poem":1},{"lineBreak":true},{"text":"kwa kubunzwa na wang'honyo wa heni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Uhiliche lumuli na kukomya kwa hegwe vindongoze,","poem":1},{"lineBreak":true},{"text":"vifichize heni kuli chidunda cha hegwe chelile,","poem":1},{"lineBreak":true},{"text":"haluga ha hegwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hamba, Nguluwi wa heni, ndoluta hali honhu ha hegwe ha kulavila nhambiko,","poem":1},{"lineBreak":true},{"text":"ndokuya kwa hegwe, gwa Nguluwi, usangalalo wa heni ukulu.","poem":1},{"lineBreak":true},{"text":"Ndokutogola kwa igombogombo, gwa Nguluwi, Nguluwi wa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lekachoni ndangutweguka nhumbula?","poem":1},{"lineBreak":true},{"text":"Lekachoni ndangusumajila ahyo mgati mwa heni?","poem":1},{"lineBreak":true},{"text":"Ndochitumbila kwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila ndomtogola kahi","poem":1},{"lineBreak":true},{"text":"heye yawele ulohozi wa heni na Nguluwi wa heni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}