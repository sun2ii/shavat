{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":44,"content":[{"type":"heading","content":["Kulanda kwamilwa na Nguluwi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Ilanguso lya Wakola.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, hetwe natuhulika kwa makutu ga hetwe,","poem":1},{"lineBreak":true},{"text":"wasekulu wa hetwe nawatusimila","poem":1},{"lineBreak":true},{"text":"mbuli zouditile mihela ja hewo,","poem":1},{"lineBreak":true},{"text":"ena, mbuli zouditile aho katali.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwa moko wa gwegwe baho nakuwawinga wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"honhu ha hewo nakuwawika wasekulu wa hetwe,","poem":1},{"lineBreak":true},{"text":"nakuwagaza wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"nakuzidita mbuli za wasekulu wa hetwe zilutilile goya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wasekulu wa hetwe hawaiholile isi kwa mipanga ja hewo,","poem":1},{"lineBreak":true},{"text":"ne kusumya kwa mong'ho wa hewo,","poem":1},{"lineBreak":true},{"text":"ila nakuwadita wasumye kwa moko wa hegwe,","poem":1},{"lineBreak":true},{"text":"kwa kuwalangazila kumeho kwa hegwe,","poem":1},{"lineBreak":true},{"text":"kwa vila nakuwagana hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hegwe ndo mndewa wa heni na Nguluwi wa heni.","poem":1},{"lineBreak":true},{"text":"Wamule walelwa wa Yakobo wasumye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kwa mong'ho wa hegwe twanguwasumya wang'honyo wa hetwe,","poem":1},{"lineBreak":true},{"text":"kwa ludali lwa hegwe,","poem":1},{"lineBreak":true},{"text":"twanguwabiga walingututowa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heni hambe nditumbile ipinde lya heni,","poem":1},{"lineBreak":true},{"text":"ne ipanga lya heni haliweza kundohola.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hegwe ndo uwele utulohole kwa wang'honyo wa hetwe,","poem":1},{"lineBreak":true},{"text":"nakuwadita walingutuzudila wabasigwe soni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mazuwa gose tochidayila hegwe, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"tolitogola itagwa lya hegwe mazuwa gose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ila nakutuleka na kutubasa soni,","poem":1},{"lineBreak":true},{"text":"hambe ulutase kahi na chilundo cha wamizi wa hetwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nakutudita tuwabilime wang'honyo wa hetwe,","poem":1},{"lineBreak":true},{"text":"nawo nawahola lufufu lwa hetwe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nakutudita kota ming'holo jilinguhilikwa kudumuligwa singo,","poem":1},{"lineBreak":true},{"text":"nakutusambalula kuli isi zinji.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nakuwaguza wanhu wa hegwe kwa sendi nyindo,","poem":1},{"lineBreak":true},{"text":"ne kuwa na chinhu choneche cha mzidi kulawa kuli kuwaguza hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nakutudita tulonjelezwe na wotulingikalasa habehi,","poem":1},{"lineBreak":true},{"text":"nawo wangutubeza na kutuseka.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nakutudita tubezigwe na wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"wangutigasa vitwi vya hewo kwa kutubeza.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nemisi yeng'ha soni naingubika,","poem":1},{"lineBreak":true},{"text":"kumeho kwa heni kumema soni,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"kwa ulonzi na kubeza kwa walingundiga,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha wang'honyo wa heni na wahilula chibida.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Aga geng'ha nagatufika hetwe,","poem":1},{"lineBreak":true},{"text":"hanga hatukusemwile,","poem":1},{"lineBreak":true},{"text":"ne hatubenile ilagano lya hegwe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hatukubelenhuche,","poem":1},{"lineBreak":true},{"text":"ne kuzileka nzila za hegwe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ila nakutuleka tuwele tutochile ng'hatu hali honhu ha mibwa ja kisolo jing'hang'hale,","poem":1},{"lineBreak":true},{"text":"nakutuleka kuli jiza ng'hulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wone twahakusemwile hegwe Nguluwi wa hetwe,","poem":1},{"lineBreak":true},{"text":"na kumbilimila mlungu wa udesi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"gwa Nguluwi, wahavizelele mbuli ayo,","poem":1},{"lineBreak":true},{"text":"kwa vila hegwe nakuuzela uviso wa mnhumbula.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ila kwa chiwalo cha hegwe, twangukopoligwa chila zuwa,","poem":1},{"lineBreak":true},{"text":"twanguditilwa kota ming'holo jilinguhilikwa kudumuligwa singo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Gwa Mkulu, ulilimche. Lekachoni nakuwasa?","poem":1},{"lineBreak":true},{"text":"Winuche. Dedede uleche kututoza mazuwa gose.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lekachoni kwangivisa kutali na hetwe,","poem":1},{"lineBreak":true},{"text":"na kusemwa magazo na kubunzwa kwa hetwe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Natuduliswa mbaka kuli nhimbwisi,","poem":1},{"lineBreak":true},{"text":"natunanahila kuli misanga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Winuche, uye kututanza.","poem":1},{"lineBreak":true},{"text":"Utugombole kwa chiwalo cha igano lya hegwe lya kwimilila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}