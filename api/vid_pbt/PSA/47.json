{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"heading","content":["Nguluwi, Mndewa wa isi zeng'ha"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Wakola.)"]},{"type":"verse","number":1,"content":[{"text":"Hemwe wanhu weng'ha mtowe vimbamba.","poem":1},{"lineBreak":true},{"text":"Mumtogole Nguluwi kwa lizi lya kusangalala.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwa vila Mkulu Nguluwi, Nguluwi Yawele Kuchanya, kangukabusa.","poem":1},{"lineBreak":true},{"text":"Heye ndo Mndewa mkulu kuli isi zeng'ha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nakatudita tuwasumye wanhu wa isi,","poem":1},{"lineBreak":true},{"text":"nakawawika wanhu wa isi hanyi, hali magulu ga hetwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nakatuhagulila isi ayi iwe uhalizi wa hetwe,","poem":1},{"lineBreak":true},{"text":"iwele ndo lutogo lwa walelwa wa Yakobo yalingumgana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nguluwi nakenuka kuchanya hali walingutowa luchenze,","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi hali walingutowa mhalamanda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mumwimbile Nguluwi lutogo, mumwimbile.","poem":1},{"lineBreak":true},{"text":"Mumwimbile lutogo mndewa wa hetwe, mumwimbile.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mumwimbile Nguluwi lwimbo lwa lutogo,","poem":1},{"lineBreak":true},{"text":"kwa vila heye ndo mndewa wa isi zeng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nguluwi yalinguwalongoza wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"nakekala kuli chigoda cha heye cha undewa chelile.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vilongozi wa wanhu wa isi wangikungajiza,","poem":1},{"lineBreak":true},{"text":"wangilumba na wanhu wa Nguluwi wa Abulahamu,","poem":1},{"lineBreak":true},{"text":"kwa vila ludali lweng'ha lwa muisi ndo lwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"heye kana ukulu ng'hatu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}