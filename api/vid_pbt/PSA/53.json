{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":53,"content":[{"type":"heading","content":["Wihe wa wanhu"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwa kiwhana na Mahalati. Ilanguso lya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Wapoka wangilonjelaga mnhumbula,","poem":1},{"lineBreak":true},{"text":"“Haduhuli Nguluwi.”","poem":1},{"lineBreak":true},{"text":"Weng'ha nawajilila lukami,","poem":1},{"lineBreak":true},{"text":"nawadita gehile ga kuzudiza,","poem":1},{"lineBreak":true},{"text":"haduhuli ne yumwe yalingudita linojile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nguluwi kanguwalola wanhu kulawa kilanga,","poem":1},{"lineBreak":true},{"text":"yalole kota hana yoneche yawele na luhala,","poem":1},{"lineBreak":true},{"text":"kota hana yoneche yalingumuwinza Nguluwi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ila weng'ha nawabelenhuka,","poem":1},{"lineBreak":true},{"text":"weng'ha nawajilila hamwe,","poem":1},{"lineBreak":true},{"text":"haduhuli yaditile ganojile,","poem":1},{"lineBreak":true},{"text":"haduhuli ne yumwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndaze, hewo walingudita wihe wahela nyhala?","poem":1},{"lineBreak":true},{"text":"Wanguwadakula wanhu wa heni kota mhau,","poem":1},{"lineBreak":true},{"text":"hambe wamlande Nguluwi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aho wowa na kukabusa kukulu,","poem":1},{"lineBreak":true},{"text":"kukabusa kuwele hawanakona hamwande,","poem":1},{"lineBreak":true},{"text":"kwa vila Nguluwi kojisambalula mizeje ja wang'honyo,","poem":1},{"lineBreak":true},{"text":"hewo wobasigwa soni kwa vila Nguluwi nakawalema.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Twangugana ulohozi wa Isilaeli ufiche kulawa Siyoni.","poem":1},{"lineBreak":true},{"text":"Nguluwi hoyowahilula goya wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"walelwa wa Yakobo wotowa luchenze,","poem":1},{"lineBreak":true},{"text":"Waisilaeli wosangalala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}