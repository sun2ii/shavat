{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"heading","content":["Kulanda kwa kiyamila na wang'honyo"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Na vinhu vya ng'weso vya muziki. Ilanguso lya Daudi mhela munhu yumwe kulawa Sifu loyamlutile Sauli na kumzelesa kota Daudi nakevisa kwa hewo.)"]},{"type":"verse","number":1,"content":[{"text":"Undohole, gwa Nguluwi kwa itagwa lya hegwe,","poem":1},{"lineBreak":true},{"text":"kwa mong'ho wa hegwe, ulajile kota ndahela nongwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi, uhulichize kulanda kwa heni,","poem":1},{"lineBreak":true},{"text":"uhulichize ulonzi wa mlomo wa heni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wajenzi wangunhowa,","poem":1},{"lineBreak":true},{"text":"wanhu wawele na nhumbula zigagadale wanguuwinga ukomu wa heni,","poem":1},{"lineBreak":true},{"text":"wanhu wohambe wamdumbe Nguluwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndivizela Nguluwi ndo utanzi wa heni,","poem":1},{"lineBreak":true},{"text":"Mkulu ndo yalingunyimiza nzinzili.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Heye kowagaza wang'honyo wa heni kwa wihe wa hewo wawo,","poem":1},{"lineBreak":true},{"text":"kwa kukundigwa kwa hegwe, gwa Nguluwi, uwadumye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndokulavila nhambiko ya kunuwila,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, ndolitogola itagwa lya hegwe","poem":1},{"lineBreak":true},{"text":"kwa vila ndo linoga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwa vila nakundohola kuli magazo ga heni geng'ha,","poem":1},{"lineBreak":true},{"text":"nani ndiwona wang'honyo wa heni nawalemwela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}