{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":56,"content":[{"type":"heading","content":["Kitumbila kwa Nguluwi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwa kiwhana na “Ng'hunda ya Kutali Isindamale.” Zabuli ya Daudi mhela loyebatigwe na Wafilisti kula Gati.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, mbonele isungu,","poem":1},{"lineBreak":true},{"text":"kwa vila wanhu wangunhowa.","poem":1},{"lineBreak":true},{"text":"Nemisi yeng'ha wanhu wangumbunza heni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nemisi yeng'ha wanhu wangitwanza na heni,","poem":1},{"lineBreak":true},{"text":"wenji walingidaya wangunhowa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi, lunhwinhwi holukuya,","poem":1},{"lineBreak":true},{"text":"ndochitumbila kwa hegwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndanguutogola ulonzi wa Nguluwi,","poem":1},{"lineBreak":true},{"text":"ndangitumbila kwa Nguluwi hambe ndumbe.","poem":1},{"lineBreak":true},{"text":"Wanhu wohambe wekale mazuwa gose kota Nguluwi, wondita choni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nemisi yeng'ha wangulonga udesi kwa heni,","poem":1},{"lineBreak":true},{"text":"majesa ga hewo geng'ha ndo kumbunza heni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wangiting'hana kiwika goya na kumbinza chinyele,","poem":1},{"lineBreak":true},{"text":"wangupugajiza geng'ha gondilingudita,","poem":1},{"lineBreak":true},{"text":"wangugana kung'hopola.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi, uwahilusile kwa winji wa wihe wa hewo,","poem":1},{"lineBreak":true},{"text":"uwagwise wanhu wa isi azo kwa ng'halazi ya hegwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hegwe kugazela magazo ga heni,","poem":1},{"lineBreak":true},{"text":"kwanguwika kukumbuchila kwa mahozi ga heni geng'ha.","poem":1},{"lineBreak":true},{"text":"Ndaze, geng'ha hagawele kuli chitabu cha hegwe?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chila hondilanda utanzi kwa hegwe,","poem":1},{"lineBreak":true},{"text":"wang'honyo wa heni wanguhiluswa kumbele.","poem":1},{"lineBreak":true},{"text":"Ndanguvizela ndikomya Nguluwi ka ubanzi wa heni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndangitumbila kwa Nguluwi na kuutogola ulonzi wa heye.","poem":1},{"lineBreak":true},{"text":"Ndangitumbila kwa Mkulu Nguluwi na kuutogola ulonzi wa heye.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ndangitumbila kwa Nguluwi hambe ndumbe.","poem":1},{"lineBreak":true},{"text":"Munhu kondita choni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gwa Nguluwi, ndokweneza chilaho cha heni,","poem":1},{"lineBreak":true},{"text":"ndokulavila nhambiko za kulonga malumbo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kwa vila nakundohola kulawa kuli kubagama,","poem":1},{"lineBreak":true},{"text":"ena, nakunyamila leka ndeche kugwa,","poem":1},{"lineBreak":true},{"text":"leka njende hali hegwe, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"kuli lumuli lwa ukomu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}