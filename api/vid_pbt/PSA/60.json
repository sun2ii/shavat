{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":60,"content":[{"type":"heading","content":["Kusumya hala du lokukolile kulemwela"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwa kiwhana na Shushani Eduti. Lwimbo lwa Daudi lwa kulangusa, mhela loyetowile na Waalamu kulawa Nahalaimu na Soba, hala Yoabu naloyahiluche kumbele na kuwakopola Waedomu elufu kumi na mbili kuli Ibindi lya Mwino.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, nakututoza na kutuhonda,","poem":1},{"lineBreak":true},{"text":"nakuwika ng'halazi, dedede utuhilusile mong'ho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nakuidita isi ikakame na kuitula,","poem":1},{"lineBreak":true},{"text":"uhadinye hala honhu hatuliche kwa vila nahawifigwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nakuwadwika wanhu wa hegwe magazo,","poem":1},{"lineBreak":true},{"text":"nakutunweza divai ilingutudita tuzebeduche.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Uwalajile ulajilo wala walingukudumba,","poem":1},{"lineBreak":true},{"text":"waweze kuhepa msale.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Leka woulingugana waloholigwe,","poem":1},{"lineBreak":true},{"text":"ulohole kwa moko wa hegwe wa kudilo, utwidichile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nguluwi nakalonga kulawa helile ha heye,","poem":1},{"lineBreak":true},{"text":"“Lelo, hondisumya ndoigawanula Shekemu,","poem":1},{"lineBreak":true},{"text":"ibindi lya Sukoti ndolipima chila honhu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gileadi ndo ya heni na Manase ndo ya heni,","poem":1},{"lineBreak":true},{"text":"Efulaimu ndo kofia ya heni ya chuma,","poem":1},{"lineBreak":true},{"text":"na Yuda ndo ng'hweku ya heni ya undewa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moabu ndo kota chisaye cha heni cha kihovujila,","poem":1},{"lineBreak":true},{"text":"makwamba ga heni ndogatozela Edomu.","poem":1},{"lineBreak":true},{"text":"Ndotowa iyowe lya kusumya kwa chiwalo cha Filistiya.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Whaani yonyhilika kuli muji wa ngome?","poem":1},{"lineBreak":true},{"text":"Whaani yondongoza mbaka Edomu?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndaze, nakutuleka ng'hatu gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"nakuwaleka wamizi wa hetwe?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Utugalile utanzi kwa chiwalo cha walingutugaza,","poem":1},{"lineBreak":true},{"text":"kwa vila ulohozi wa munhu hauwele chinhu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwa utanzi wa Nguluwi tosumya,","poem":1},{"lineBreak":true},{"text":"heye kowabiga walingutugaza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}