{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"heading","content":["Kulanda kwamilwa"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Na vinhu vya ng'weso vya muziki. Lwimbo lwa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, uhuliche kulila kwa heni,","poem":1},{"lineBreak":true},{"text":"uhulichize kulanda kwa heni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kulawa kuli kuduma kwa isi ndangukulilila,","poem":1},{"lineBreak":true},{"text":"mbele nweguche nhumbula.","poem":1},{"lineBreak":true},{"text":"Undongoze mbaka kuchanya kuwele na italawe ikulu, hali honhu ha kubilimila kikala goya,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kwa vila hegwe ndo honhu ha heni ha kubilimila,","poem":1},{"lineBreak":true},{"text":"ngome ya heni iwele nzinzili, wang'honyo hawoweza kufika heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndangulanda ndikale kuli ihema lya hegwe mazuwa gose,","poem":1},{"lineBreak":true},{"text":"leka ndiwe hali kikala goya hanyi ha mabawa ga hegwe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi, nakuhulika chilaho cha heni,","poem":1},{"lineBreak":true},{"text":"nakumha heni uhalizi wa wala walingukudumba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wonjeze ukomu wa mndewa uwe wa mazuwa menji,","poem":1},{"lineBreak":true},{"text":"miyaka ja heye jiwe ja lulelo lwinji.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yalongoze mazuwa gose hali hegwe, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"igano lya kwimilila na kukundigwa kwa hegwe vimwamile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ahyo ndokwimbila nzimbo za kulitogola itagwa lya hegwe,","poem":1},{"lineBreak":true},{"text":"ndikweneza chilaho cha heni chila zuwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}