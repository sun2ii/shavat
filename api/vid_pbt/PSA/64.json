{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":64,"content":[{"type":"heading","content":["Kulanda kwamilwa na Nguluwi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, uhuliche kung'ung'uta kwa heni,","poem":1},{"lineBreak":true},{"text":"wamile ukomu wa heni na kukabusa kwa wang'honyo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unyamile na majesa gehile ga wehile,","poem":1},{"lineBreak":true},{"text":"na ivuche lya wanhu wehile.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wangunola umyango wa hewo kota ipanga,","poem":1},{"lineBreak":true},{"text":"wangulavya ulonzi wihile kota misale.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kulawa kuli kivisa wangumtowa munhu yagoloche,","poem":1},{"lineBreak":true},{"text":"baho du wangumtowa ne kudumba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wangilumba kuli kunuwila kwa hewo kwihile,","poem":1},{"lineBreak":true},{"text":"wangikundiza honhu ha kuvisa midiwa ja hewo,","poem":1},{"lineBreak":true},{"text":"wangulonga, “Kuduhu yoweza kujona.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wangijesaga kunuwila kwa hewo kwihile na kulonga,","poem":1},{"lineBreak":true},{"text":"“Sambi natweneza gotuganile kudita ne kulemwela.”","poem":1},{"lineBreak":true},{"text":"Kunuwila kwihile kwa uviso nakuvisigwa mnhumbula mwa munhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ila Nguluwi kowatowa kwa misale,","poem":1},{"lineBreak":true},{"text":"na kuwalumiza baho du.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wodumigwa kwa chiwalo cha ulonzi wa hewo wawo,","poem":1},{"lineBreak":true},{"text":"chila hoyowona kotigasa mutwi kwa kubeza.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aho wanhu weng'ha wodumba,","poem":1},{"lineBreak":true},{"text":"wowikula goyaditile Nguluwi,","poem":1},{"lineBreak":true},{"text":"na kijesa kwa chiwalo cha madito ga heye.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Watanganiche wosangalala kwa chiwalo cha Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"na kubilimila kikala goya kwa heye,","poem":1},{"lineBreak":true},{"text":"wanhu weng'ha wagoloche womtogola.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}