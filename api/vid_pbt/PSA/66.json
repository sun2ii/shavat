{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":66,"content":[{"type":"heading","content":["Lwimbo lwa kulonga malumbo"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Lwimbo. Zabuli.)"]},{"type":"verse","number":1,"content":[{"text":"Hemwe wanhu weng'ha muisi mumtowele luchenze Nguluwi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwimbe kwa chiwalo cha lutogo lwa itagwa lya heye,","poem":1},{"lineBreak":true},{"text":"mumlavile lutogo lukulu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mumlonjele Nguluwi, “Madito ga hegwe ndo ga kububuwaza lukami.","poem":1},{"lineBreak":true},{"text":"Ludali lwa hegwe ndo lukulu ng'hatu mbaka wang'honyo wa hegwe wangisuwata kwa kudumba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isi yeng'ha yangukufugamila,","poem":1},{"lineBreak":true},{"text":"wanhu weng'ha wangukwimbila lutogo,","poem":1},{"lineBreak":true},{"text":"wangulimbila lutogo itagwa lya hegwe.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Muye, mlole mbuli zoyaditile Nguluwi,","poem":1},{"lineBreak":true},{"text":"nakadita mbuli za kudumbiza hali wanhu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nakaidita bahali naiwa isi ikalile,","poem":1},{"lineBreak":true},{"text":"wanhu nawakola amo kwa magulu.","poem":1},{"lineBreak":true},{"text":"Muye, natwe totowa luchenze kwa chiwalo cha heye.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kangulongoza mazuwa gose kwa mong'ho wa heye,","poem":1},{"lineBreak":true},{"text":"meho ga heye ganguwalola wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"leka yoneche yalingumbelenhuka yaleche kujeza kiyinula hali heye.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mumtogole Nguluwi wa hetwe, hemwe wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"muwikule lutogo lwa heye leka luhulikwe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Heye nakalutiliza ukomu wa hetwe,","poem":1},{"lineBreak":true},{"text":"hatulechile tugwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nakutupima, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"nakutweliza kota sendi vyoilingwelizwa mchiluli.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nakutuleka tugwilizwe muutandawala,","poem":1},{"lineBreak":true},{"text":"kutupapiza magazo ga kutunya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nakuwaleka wanhu watubije,","poem":1},{"lineBreak":true},{"text":"natukolela mchiluli na mmazi.","poem":1},{"lineBreak":true},{"text":"Ila sambi nakutigala kuli honhu ha kwesela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndokuya kuli ng'handa ya hegwe na nhambiko za kulakazwa,","poem":1},{"lineBreak":true},{"text":"ndokweneza chilaho cha heni,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"chondonjile na kulagana vyombele kuli magazo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndokulavila nhambiko za kulakazwa zinonile,","poem":1},{"lineBreak":true},{"text":"hamwe na iyosi lya nhambiko za ming'holo milume,","poem":1},{"lineBreak":true},{"text":"ndolavya nhambiko za ibuguma na mhene.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hemwe mlingumdumba Nguluwi, muye mweng'ha mhulichize,","poem":1},{"lineBreak":true},{"text":"nani ndowasimila goyanditile.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nandimlilila kwa mlomo wa heni,","poem":1},{"lineBreak":true},{"text":"lutogo lwa heye nalwali kuli umyango wa heni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wone ndahalolile gehile mnhumbula,","poem":1},{"lineBreak":true},{"text":"Nguluwi yahawezile kunyhulichiza,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ila ndangukomya Nguluwi nakanyhulichiza,","poem":1},{"lineBreak":true},{"text":"ena, nakahulichiza kulanda kwa heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yatogoligwe Nguluwi,","poem":1},{"lineBreak":true},{"text":"kwa vila halemile kulanda kwa heni,","poem":1},{"lineBreak":true},{"text":"ne kusa igano lya heye lya kwimilila kwa heni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}