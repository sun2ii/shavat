{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"heading","content":["Lwimbo lwa kulonga malumbo"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwa vinhu vya ng'weso vya muziki. Zabuli. Lwimbo.)"]},{"type":"verse","number":1,"content":[{"text":"Utonele isungu, gwa Nguluwi, ututambichize,","poem":1},{"lineBreak":true},{"text":"utulajile kumeho kwa hegwe kwa kunoga,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"leka isi yeng'ha ivizele nzila ya hegwe,","poem":1},{"lineBreak":true},{"text":"wanhu wa isi zeng'ha wavizele ludali lwa hegwe lwa kulohola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wanhu weng'ha wakupe ukulu, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"wanhu weng'ha wakutogole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wanhu wa isi zeng'ha wasangalale na kwimba kwa usangalalo,","poem":1},{"lineBreak":true},{"text":"kwa vila kwanguwatagusa wanhu kwa hachi,","poem":1},{"lineBreak":true},{"text":"na kuwalongoza wanhu wa isi zeng'ha muisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wanhu weng'ha wakupe ukulu, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"wanhu weng'ha wakutogole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isi nailavya mbena zake,","poem":1},{"lineBreak":true},{"text":"Nguluwi, Nguluwi wa hetwe, nakatutambichiza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nguluwi yalutilile kututambichiza.","poem":1},{"lineBreak":true},{"text":"Wanhu weng'ha muisi wamdumbe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}