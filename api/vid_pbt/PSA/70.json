{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"heading","content":["Kulanda utanzi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Lwimbo lwa Daudi lwa kukumbuchila.)"]},{"type":"verse","number":1,"content":[{"text":"Gwa Nguluwi, undohole.","poem":1},{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, uye himahima kunhanza.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Walingugana kundumya,","poem":1},{"lineBreak":true},{"text":"wone soni na kudeula.","poem":1},{"lineBreak":true},{"text":"Awo walingugana ndumile,","poem":1},{"lineBreak":true},{"text":"walingugana ndumile, wahiluche kumbele na kubezigwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Awo walinguseka heni,","poem":1},{"lineBreak":true},{"text":"wahiluche kumbele kwa kulemwela kwa hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wala weng'ha walingukupala,","poem":1},{"lineBreak":true},{"text":"wasangalale na kutowa luchenze kwa chiwalo cha hegwe.","poem":1},{"lineBreak":true},{"text":"Walinguugana ulohozi wa hegwe,","poem":1},{"lineBreak":true},{"text":"chila yumwe yalonje mazuwa gose, “Nguluwi ndo Mkulu!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ila heni mbele mzunwa na ndilihela chinhu,","poem":1},{"lineBreak":true},{"text":"gwa Nguluwi, umbuyile himahima.","poem":1},{"lineBreak":true},{"text":"Hegwe ndo mtanzi wa heni na mlohozi wa heni,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, uleche kukawila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}