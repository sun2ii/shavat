{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"heading","content":["Nguluwi ka mtagusa"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwa kiwhana na “Uleche kuwifya.” Zabuli ya Asafu. Lwimbo.)"]},{"type":"verse","number":1,"content":[{"text":"Twangulonga malumbo, gwa Nguluwi,","poem":1},{"lineBreak":true},{"text":"twangulonga malumbo.","poem":1},{"lineBreak":true},{"text":"Twanguwikula ukulu wa itagwa lya hegwe","poem":1},{"lineBreak":true},{"text":"na kusimila mbuli za madito ga hegwe makulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nguluwi kangulonga, “Nambika mihela jondijihagule,","poem":1},{"lineBreak":true},{"text":"kuli mihela ajo ndotagusa kwa hachi chila mhela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isi hoikakama na vyeng'ha viwele amo,","poem":1},{"lineBreak":true},{"text":"heni ndo ndilingwimiza misisi jake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndanguwalonjela wawele walingidaya,","poem":1},{"lineBreak":true},{"text":"‘Mleche kidaya,’","poem":1},{"lineBreak":true},{"text":"na wehile, ‘Mleche kwinula mbalati kota namsumya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mleche kiwona kota mwa wanhu mtanganiche ng'hatu,","poem":1},{"lineBreak":true},{"text":"ne kulonga ulonzi wa kidaya.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kusumya hakulingulawa kolilawilaga isanya ne kolizinjilaga isanya,","poem":1},{"lineBreak":true},{"text":"ne kuchiwala ne kuli chidunda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nguluwi yuye ndo mtagusa,","poem":1},{"lineBreak":true},{"text":"kangumdulisaga yumwe na kumkwiniza yunji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kangibata chizombe mmoko,","poem":1},{"lineBreak":true},{"text":"chimemile divai ing'ang'ale ya ng'halazi ya heye, kanguijida.","poem":1},{"lineBreak":true},{"text":"Kukomya wehile weng'ha wanguinwa,","poem":1},{"lineBreak":true},{"text":"ena, wanguinwa mbaka kuduma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ila heni ndowikula mazuwa gose,","poem":1},{"lineBreak":true},{"text":"ndomwimbila lutogo Nguluwi wa Yakobo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kowifya ludali lweng'ha lwa wanhu wehile,","poem":1},{"lineBreak":true},{"text":"ila mong'ho wa watanganiche kowimiza nzinzili.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}