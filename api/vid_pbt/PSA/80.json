{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":80,"content":[{"type":"heading","content":["Kulanda kwa chiwalo cha wanhu wa isi"]},{"type":"hebrew_subtitle","content":["(Kwa yalingwaluchiza kwimba. Kwa kiwhana na yunjiyunji. Zabuli ya Asafu.)"]},{"type":"verse","number":1,"content":[{"text":"Uhulichize, gwa Mdimi wa Isilaeli,","poem":1},{"lineBreak":true},{"text":"ulinguwalongoza walelwa wa Yusufu kota ming'holo.","poem":1},{"lineBreak":true},{"text":"Hegwe ulingulongoza hali vilumbigwe viwele na mabawa,","poem":1},{"lineBreak":true},{"text":"ulangaze","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"hali Efulaimu na Benjamini na Manase.","poem":1},{"lineBreak":true},{"text":"Ulajile ludali lwa hegwe, uye kutulohola.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gwa Nguluwi utuhiluse,","poem":1},{"lineBreak":true},{"text":"utulole kwa kunoga, natwe toloholigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gwa Mkulu Nguluwi, Nguluwi uwele na mong'ho,","poem":1},{"lineBreak":true},{"text":"mbaka hanili kokuzudila kulanda kwa wanhu wa hegwe?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nakudita masinzo gawe chilyo cha hetwe,","poem":1},{"lineBreak":true},{"text":"nakutunweza mahozi kwa winji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nakutudita tubezigwe na wotulingikalasa habehi,","poem":1},{"lineBreak":true},{"text":"wang'honyo wa hetwe wangutuseka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwa Mkulu Nguluwi uwele na Mong'ho, utuhiluse,","poem":1},{"lineBreak":true},{"text":"utulole kwa kunoga, natwe toloholigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hegwe nakigala mzabibu kulawa Misili,","poem":1},{"lineBreak":true},{"text":"nakuwawinga wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"na kuunyala kuli isi ya hewo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nakuulolela goya leka ukule,","poem":1},{"lineBreak":true},{"text":"najo mizabi najiluta hanyi ng'hatu na kwenela kweng'ha muisi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nakuvigubika vidunda kwa isisila lyake,","poem":1},{"lineBreak":true},{"text":"nhagala zake nazigubika mielezi mikulu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nhagala zake nazenela mbaka kuli bahali,","poem":1},{"lineBreak":true},{"text":"mizuchila jake mbaka hafungo mwa lwanda lwa Eyufulate.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lekachoni nakubomola lukanzi lulinguzunguluta,","poem":1},{"lineBreak":true},{"text":"lelo chila yalingukola mnzila kangukwanyula zabibu zake?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Migubi ja kisolo janguuwifya,","poem":1},{"lineBreak":true},{"text":"na migongolo ja kisolo janguudakula.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Utuhinduchile kahi, gwa Mkulu Nguluwi uwele na Mong'ho.","poem":1},{"lineBreak":true},{"text":"Ulole kulawa kilanga, wone,","poem":1},{"lineBreak":true},{"text":"ukaulolele mzabibu awo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ulyamile izuchila lyoulinyalile kwa moko wa hegwe wa kudilo,","poem":1},{"lineBreak":true},{"text":"alyo izuchila lyoulimize nzinzili gwegwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mzabibu wa hegwe naudumuligwa na kulakazwa kwa chiluli,","poem":1},{"lineBreak":true},{"text":"vyouwang'hanuchila, wanhu wa hegwe wangudumigwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Moko wa hegwe wa kudilo umwamile ayo youmganile,","poem":1},{"lineBreak":true},{"text":"ayo youmhagule kwa chiwalo cha hegwe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hamba hatukuleka na kukubelenhuka kahi,","poem":1},{"lineBreak":true},{"text":"ututambichize ukomu, natwe tolichema itagwa lya hegwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gwa Mkulu Nguluwi uwele na Mong'ho, utuhiluse,","poem":1},{"lineBreak":true},{"text":"utulole kwa kunoga, natwe toloholigwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}