{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"heading","content":["Nguluwi chilongozi mkulu"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu.)"]},{"type":"verse","number":1,"content":[{"text":"Nguluwi kangwimilila chitala chikulu,","poem":1},{"lineBreak":true},{"text":"kangulavya utaguso kuli nhing'hano ya milungu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Mbaka hanili molutilila kutagusa ne hachi","poem":1},{"lineBreak":true},{"text":"na kuwaganilila wanhu wehile?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muwape ng'hochele na walekwa hachi za hewo,","poem":1},{"lineBreak":true},{"text":"mwamile hachi za walingubunzwa na wazunwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Muwalohole ng'hochele na wazunwa,","poem":1},{"lineBreak":true},{"text":"muwalohole kulawa kuli ndole za wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ila milungu ndo mipoka na hajivizelele.","poem":1},{"lineBreak":true},{"text":"Hewo wangujenda kuli jiza lya kwajilila,","poem":1},{"lineBreak":true},{"text":"misisi jeng'ha ja hachi kuli isi najitigaswa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heni nandonga, ‘Hemwe mwa milungu,","poem":1},{"lineBreak":true},{"text":"mweng'ha mwa wana wa Nguluwi Yawele Kuchanya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ila mobagama kota wanhu wanji,","poem":1},{"lineBreak":true},{"text":"mogwa kota mkulu yoneche.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gwa Nguluwi winuche, uzitaguse isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"kwa vila wanhu wa isi zeng'ha ndo wa hegwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}