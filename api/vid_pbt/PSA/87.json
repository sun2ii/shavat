{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":87,"content":[{"type":"heading","content":["Lutogo lwa Yelusalemu"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Wakola. Lwimbo.)"]},{"type":"verse","number":1,"content":[{"text":"Nguluwi nakazenga muji wa heye mchanya mwa chidunda cha heye chelile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kanguugana muji wa Siyoni,","poem":1},{"lineBreak":true},{"text":"kusinda kaye kuyage kwa Yakobo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbuli ng'hulu zangulonjigwa kwa chiwalo cha hegwe, gwa muji wa Nguluwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Hali wala walingunzela,","poem":1},{"lineBreak":true},{"text":"wa baho wanhu wa Misili na Babuloni,","poem":1},{"lineBreak":true},{"text":"hihyo du wanhu wa Filistiya na Tilo na Kushi,","poem":1},{"lineBreak":true},{"text":"weng'ha wolonga, ‘Ayu nakapondigwa ako Siyoni.’ ”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuwala Siyoni yolonjigwa ahi,","poem":1},{"lineBreak":true},{"text":"“Siyoni ndo mamo wa wala weng'ha,","poem":1},{"lineBreak":true},{"text":"Nguluwi Yawele Kuchanya koutawiza.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kokwandika kuli chitabu,","poem":1},{"lineBreak":true},{"text":"hoyowika kukumbuchila kwa wanhu.","poem":1},{"lineBreak":true},{"text":"“Ayu nakapondigwa ako Siyoni.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Weng'ha wanguvina ngoma na kwimba,","poem":1},{"lineBreak":true},{"text":"“Nzasa za heni zeng'ha za kwa hegwe.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}