{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":91,"content":[{"type":"heading","content":["Nguluwi mwamizi wa hetwe"]},{"type":"verse","number":1,"content":[{"text":"Heye yalingikala hali honhu ha kikala goya ha Nguluwi Yawele Kuchanya,","poem":1},{"lineBreak":true},{"text":"kokwesela kuli lubehelo lwa Nguluwi Yawele na Ludali.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndolonga kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"“Hegwe ndo honhu ha heni ha kubilimila na ngome ya heni,","poem":1},{"lineBreak":true},{"text":"Nguluwi wa heni yondilingitumbila.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ena, Nguluwi kokulohola kuli idiwa lya mpelembi,","poem":1},{"lineBreak":true},{"text":"kokwamila kuli matamwa galingukopola.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kokugubika kwa mabawa ga heye,","poem":1},{"lineBreak":true},{"text":"kowa na kikala goya hala,","poem":1},{"lineBreak":true},{"text":"kukundigwa kwa heye kokwamila kota ngawo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hulinguganigwa kudumba kukabusa kwa nechilo","poem":1},{"lineBreak":true},{"text":"ne kutowigwa na misale baho du nemisi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ne utamwa ulinguya nechilo,","poem":1},{"lineBreak":true},{"text":"ne kubagama kulingulawila nemisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hanga wanhu elufu wogwa habehi na hegwe,","poem":1},{"lineBreak":true},{"text":"ena, elufu kumi kwa moko wa hegwe wa kudilo,","poem":1},{"lineBreak":true},{"text":"ila hegwe kubagama hambe kukuhejelele.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kwa meho ga gwegwe baho,","poem":1},{"lineBreak":true},{"text":"kolola ndaze wanhu wehile vyowalingugazigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwa vila nakumdita Mkulu Nguluwi ndo honhu ha hegwe ha kubilimila,","poem":1},{"lineBreak":true},{"text":"ena, Nguluwi Yawele Kuchanya yawele ndo kaye kwa hegwe,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ahyo, hufichigwa na wihe woneche,","poem":1},{"lineBreak":true},{"text":"ihema lya hegwe halifichigwa na utamwa woneche.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwa vila Nguluwi kowalajiza wahilisi wa heye,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha hegwe, leka wakwamile koneche kouluta.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wokuwika mmoko mwawo,","poem":1},{"lineBreak":true},{"text":"leka magulu ga hegwe galeche kikwang'hwala kuli iganga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kojisumya misimba na mizoka,","poem":1},{"lineBreak":true},{"text":"kojihonda misimba na mingole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nguluwi kangulonga, “Ndomlohola yula yalingungana,","poem":1},{"lineBreak":true},{"text":"ndomwamila yula yalingunzela.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hoyonyhema nani ndomwidichila,","poem":1},{"lineBreak":true},{"text":"hoyowa kuli magazo ndowa hamwe na heye,","poem":1},{"lineBreak":true},{"text":"ndomlohola na kumhulichiza.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndomdita yasangalale kwa ukomu wa mihela minji,","poem":1},{"lineBreak":true},{"text":"ndomlajila ulohozi wa heni.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}