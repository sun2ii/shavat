{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"heading","content":["Nguluwi mndewa"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi kangulongoza,","poem":1},{"lineBreak":true},{"text":"nakevika ukulu ng'hatu.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi nakavala ukulu na mong'ho.","poem":1},{"lineBreak":true},{"text":"Nakayimiza nzinzili isi yeng'ha, nayo haitigasika hebu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chigoda cha hegwe cha undewa cha nzinzili kulawa katali,","poem":1},{"lineBreak":true},{"text":"hegwe nawali baho mihela jeng'ha lojing'hali kuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mazi menji nagalavya lizi, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ena, nagakwiniza lizi lyake,","poem":1},{"lineBreak":true},{"text":"mazi menji gangukwiniza kahi kubuma kwake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Heye ndo mkulu kusinda kubogoma kwa mazi makulu,","poem":1},{"lineBreak":true},{"text":"ndo mkulu kusinda nhigu za bahali,","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi yalingikala kuchanya kana mong'ho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gwa Mkulu Nguluwi, malajizo ga hegwe gema nzinzili,","poem":1},{"lineBreak":true},{"text":"welile wa ng'handa ya hegwe wangunojeza mazuwa gose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}