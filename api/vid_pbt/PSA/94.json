{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":94,"content":[{"type":"heading","content":["Nguluwi mtagusa wa weng'ha"]},{"type":"verse","number":1,"content":[{"text":"Gwa Mkulu Nguluwi, Nguluwi yalinguhilula chibida,","poem":1},{"lineBreak":true},{"text":"hegwe Nguluwi mhilula chibida, wilajile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wime, gwa mtagusa wa isi yeng'ha,","poem":1},{"lineBreak":true},{"text":"uwagaze walingidaya vyoilinguganigwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbaka hanili, gwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"wehile wotowa luchenze?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wangulonga ulonzi wa ujuvi,","poem":1},{"lineBreak":true},{"text":"wadita wihe weng'ha nawamema kidaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwa Mkulu Nguluwi, wanguwadumya wanhu wa hegwe,","poem":1},{"lineBreak":true},{"text":"wanguwagaza hewo uwahagule.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wanguwakopola wadala wafililwe na walume wawo na wajenzi,","poem":1},{"lineBreak":true},{"text":"wanguwakopola walekwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wangulonga, “Mkulu Nguluwi halingona hebu,","poem":1},{"lineBreak":true},{"text":"Nguluwi wa Yakobo havizelele.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hemwe wapoka wa kuduma, mijese hado.","poem":1},{"lineBreak":true},{"text":"Hemwe msowile nyhala hanili mowa na luhala?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaliditile ikutu, ndaze, howeza kuhulika?","poem":1},{"lineBreak":true},{"text":"Yalumbile iziho, ndaze, howeza kona?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndaze, yalinguwazapa wanhu wa isi howeza kugaza?","poem":1},{"lineBreak":true},{"text":"Yalinguwalangusa wanhu uwanzi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kangugazela majesa ga wanhu,","poem":1},{"lineBreak":true},{"text":"kanguvizela kota hagotanza chinhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gwa Mkulu Nguluwi, nakatambichizwa munhu ulingumzapa,","poem":1},{"lineBreak":true},{"text":"munhu ulingumlangusa malajizo ga hegwe,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"leka zuwa lya magazo yesele,","poem":1},{"lineBreak":true},{"text":"mbaka wehile wabawilwe chilaga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi howaleka wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"howatoza wahaguligwe na heye.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kwa vila nhaguso zolavigwa kwa hachi,","poem":1},{"lineBreak":true},{"text":"weng'ha wagoloche nhumbula wozibatilila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Whaani yawele yanhanzile kitwanza na munhu mwihe?","poem":1},{"lineBreak":true},{"text":"Whaani nayawele ubanzi umwe na heni kwa chiwalo cha wehile?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wone Mkulu Nguluwi yahalechile kunhanza,","poem":1},{"lineBreak":true},{"text":"ndahawele habehi kuluta kuli isi ya wabagame.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Londijesile kota ndangutelela,","poem":1},{"lineBreak":true},{"text":"gwa Mkulu Nguluwi, igano lya kwimilila lya hegwe nalinyimiza nzinzili.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kusanzalima kwa nhumbula ya heni hokuwa kwinji lukami,","poem":1},{"lineBreak":true},{"text":"hegwe kwangunyhembuliza na kusangalaza heni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hegwe huweza kihanza na watagusa wehile,","poem":1},{"lineBreak":true},{"text":"walinguwika mizilo ja kuwagaza wanhu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wangikungajiza kuwaditila wihe watanganiche,","poem":1},{"lineBreak":true},{"text":"na kuwatagusa kubagama, wanhu walihela nongwa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ila Mkulu Nguluwi ndo ngome ya heni,","poem":1},{"lineBreak":true},{"text":"Nguluwi wa heni ndo italawe lya kunyamila.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wihe wa hewo, heye kowahilusila hewo wawo,","poem":1},{"lineBreak":true},{"text":"kowadumya kwa chiwalo cha wihe wa hewo.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi, Nguluwi wa hetwe, kowadumya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}