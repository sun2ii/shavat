{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"heading","content":["Lwimbo lwa kumtogola Nguluwi"]},{"type":"verse","number":1,"content":[{"text":"Muye tumwimbile Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"tumtowele luchenze italawe lya ulohozi wa hetwe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tulute hali heye na kulonga malumbo,","poem":1},{"lineBreak":true},{"text":"tumtowele luchenze na nzimbo za lutogo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwa vila Mkulu Nguluwi, ndo Nguluwi mkulu,","poem":1},{"lineBreak":true},{"text":"heye ndo Mndewa mkulu hali milungu jeng'ha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mgati ng'hatu mwa isi kwa mmoko mwa heye,","poem":1},{"lineBreak":true},{"text":"mbaka kuli vinhembenhembe vya vidunda ndo vya heye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bahali ndo ya heye, ndo yaiditile,","poem":1},{"lineBreak":true},{"text":"kwa moko ga heye nakalumba isi ng'havu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muye tinamize na kumfugamila,","poem":1},{"lineBreak":true},{"text":"tufugame hali Mkulu Nguluwi, yatulumbile hetwe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwa vila heye ndo Nguluwi wa hetwe,","poem":1},{"lineBreak":true},{"text":"natwe twa wanhu wa heye,","poem":1},{"lineBreak":true},{"text":"ndo ming'holo ja heye yalingujidima.","poem":1},{"lineBreak":true},{"text":"Wone lehano mohulika lizi lya heye,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Mleche kuzidita nhumbula za hemwe ziwe zigagadale kota kula Meliba,","poem":1},{"lineBreak":true},{"text":"kota vyowawele kula kuchiwala Masa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wasekulu wa hemwe lowanjezile na kupima majesa ga heni,","poem":1},{"lineBreak":true},{"text":"hanga nawajona mijito ja heni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwa miyaka makumi gane nanzudizwa ng'hatu na hewo,","poem":1},{"lineBreak":true},{"text":"nandonga, ‘Ndikomya, wanhu wano nawajilila mnhumbula za hewo.","poem":1},{"lineBreak":true},{"text":"Nawo hawazizelele nzila za heni.’","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lelo nanzudila ng'hatu, nandilaha,","poem":1},{"lineBreak":true},{"text":"‘Hawokwinjila hali honhu hangu ha kwesela.’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}