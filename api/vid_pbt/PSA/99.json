{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"PSA","translationId":"vid_pbt","name":"Zabuli","commonName":"Zabuli","title":"Zabuli","order":19,"numberOfChapters":150,"sha256":"79984d95703aaf166641c14da3614d08b426aaa83e6a55572f87ac3c2908451b","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vid_pbt/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":99,"content":[{"type":"heading","content":["Nguluwi ndo mndewa mkulu"]},{"type":"verse","number":1,"content":[{"text":"Mkulu Nguluwi kangulongoza,","poem":1},{"lineBreak":true},{"text":"wanhu wa isi zeng'ha wangukakama.","poem":1},{"lineBreak":true},{"text":"Nakekalisa hagati ha vilumbigwe viwele na mabawa,","poem":1},{"lineBreak":true},{"text":"isi yangutigasika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi ndo mkulu ako Siyoni,","poem":1},{"lineBreak":true},{"text":"kangwinuligwa hali wanhu wa isi zeng'ha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Weng'ha walitogole itagwa lya heye likulu lya kukabusa.","poem":1},{"lineBreak":true},{"text":"Yelile ndo heye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gwa mndewa uwele na mong'ho, ulingugana kutanganika.","poem":1},{"lineBreak":true},{"text":"Nakutawiza hachi kuli Isilaeli,","poem":1},{"lineBreak":true},{"text":"nawigala kutanganika na hachi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi, Nguluwi wa hetwe,","poem":1},{"lineBreak":true},{"text":"mugwe chifunama hali heye.","poem":1},{"lineBreak":true},{"text":"Yelile ndo heye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa na Aluni nawali watambika wa heye,","poem":1},{"lineBreak":true},{"text":"Samweli nayali hali wala walichemile itagwa lya heye.","poem":1},{"lineBreak":true},{"text":"Nawamlilila Mkulu Nguluwi naye nakawedichila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nakalonga nawo kulawa kuli izengo lya ng'hungugu,","poem":1},{"lineBreak":true},{"text":"nawebatilila nhaguso za heye na mizilo joyawapele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gwa Mkulu Nguluwi, Nguluwi wa hetwe, hegwe nakuwedichila,","poem":1},{"lineBreak":true},{"text":"kwa hewo nawali Nguluwi uwele ulinguwalechela wanhu,","poem":1},{"lineBreak":true},{"text":"hanga nakuwagaza kwa nongwa za hewo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mumtogole Mkulu Nguluwi, Nguluwi wa hetwe,","poem":1},{"lineBreak":true},{"text":"mfugamile kuli chidunda cha heye chelile.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi, Nguluwi wa hetwe, ndo yelile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}