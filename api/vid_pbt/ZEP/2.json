{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"ZEP","translationId":"vid_pbt","name":"Sefaniya","commonName":"Sefaniya","title":"Sefaniya","order":36,"numberOfChapters":3,"sha256":"7168a8f04d972dbb06d0cc3a92c2e0a35ca8ed9ed11f0a5a6a7227dde5f03074","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/vid_pbt/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Nyhemo ya kumgalamchila Nguluwi"]},{"type":"verse","number":1,"content":[{"text":"Mikungajize, mikungajize hamwe,","poem":1},{"lineBreak":true},{"text":"hemwe wanhu wa isi mlihela soni,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kung'hali mhela uwichigwe haunafika,","poem":1},{"lineBreak":true},{"text":"zuwa lila lilinguwembelusa kota mhumba,","poem":1},{"lineBreak":true},{"text":"kung'hali ng'halazi ing'hang'hale ya Mkulu Nguluwi hainawafichila,","poem":1},{"lineBreak":true},{"text":"kung'hali zuwa lya kuzudila kwa Mkulu Nguluwi halinafika kwa hemwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mumpale Mkulu Nguluwi hemwe mweng'ha mlingunyenyetela wa isi,","poem":1},{"lineBreak":true},{"text":"hemwe muwele mwanguditaga lila yalilajize.","poem":1},{"lineBreak":true},{"text":"Mpale hachi, mpale kunyenyetela,","poem":1},{"lineBreak":true},{"text":"hanji mowichigwa kutali na zuwa lya ng'halazi ya Mkulu Nguluwi.","poem":1}]},{"type":"heading","content":["Mkulu Nguluwi kowadumya wanhu wa isi ya Filistiya"]},{"type":"verse","number":4,"content":[{"text":"Muji wa Gasa wolechigwa uchiwa,","poem":1},{"lineBreak":true},{"text":"Ashikeloni wowa mahame.","poem":1},{"lineBreak":true},{"text":"Mhela wa nemisi wanhu wa Ashidodi wowinjigwa na wang'honyo,","poem":1},{"lineBreak":true},{"text":"na wanhu wa Ekiloni wokusigwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mochona hemwe mlingikala hafungo ha bahali,","poem":1},{"lineBreak":true},{"text":"hemwe Wakeleti,","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi nakalonga kuwala hemwe,","poem":1},{"lineBreak":true},{"text":"Kanaani, isi ya Wafilisti,","poem":1},{"lineBreak":true},{"text":"“Ndowadumya, haduhu yoneche yawele kowa mkomu.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isi za hafungo ha bahali, zoditigwa kuwa honhu ha kudimila,","poem":1},{"lineBreak":true},{"text":"howa honhu ha wadimi,","poem":1},{"lineBreak":true},{"text":"na mibani ja ming'holo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yowa ya wanhu wa lukolo lwa Yuda wasigale,","poem":1},{"lineBreak":true},{"text":"wowa na honhu ha kudimila migongolo.","poem":1},{"lineBreak":true},{"text":"Mhela wa matinazo wowasa hanyi,","poem":1},{"lineBreak":true},{"text":"kuli ng'handa za Ashikeloni.","poem":1},{"lineBreak":true},{"text":"Kwa vila Mkulu Nguluwi, Nguluwi wa hewo, kowalolela","poem":1},{"lineBreak":true},{"text":"na kuwahilulila ng'hano ya hewo.","poem":1}]},{"type":"heading","content":["Mkulu Nguluwi kowadumya wanhu wa Moabu na wa Amoni"]},{"type":"verse","number":8,"content":[{"text":"Mkulu Nguluwi kangulonga,","poem":1},{"lineBreak":true},{"text":"“Nandigahulika maligo ga Moabu","poem":1},{"lineBreak":true},{"text":"na kubeza kwa Waamoni,","poem":1},{"lineBreak":true},{"text":"wawele nawawaliga wanhu wa heni,","poem":1},{"lineBreak":true},{"text":"na kuikabusa isi ya wanhu wa heni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ndikomya, kota vyondilingikala,","poem":1},{"lineBreak":true},{"text":"heni Mkulu Nguluwi Mbele na Mong'ho,","poem":1},{"lineBreak":true},{"text":"Nguluwi wa Isilaeli,","poem":1},{"lineBreak":true},{"text":"Moabu yowa kota Sodoma","poem":1},{"lineBreak":true},{"text":"na Waamoni wowa kota Gomola,","poem":1},{"lineBreak":true},{"text":"honhu ha migugu na misimo ja mwino,","poem":1},{"lineBreak":true},{"text":"isi ya uchiwa mazuwa gose.","poem":1},{"lineBreak":true},{"text":"Wanhu wa heni wasigale wovihola vinhu vya hewo,","poem":1},{"lineBreak":true},{"text":"isi ya hewo yowa isi ya wanhu wa heni wasigale.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Acho ndo wohilusilwa kwa chiwalo cha kidaya kwa hewo,","poem":1},{"lineBreak":true},{"text":"kwa kuwaliga na kuwabeza,","poem":1},{"lineBreak":true},{"text":"wanhu wa Mkulu Nguluwi Yawele na Mong'ho.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi kowakabusa,","poem":1},{"lineBreak":true},{"text":"hoyojidumya milungu jeng'ha ja isi.","poem":1},{"lineBreak":true},{"text":"Wanhu wa isi zeng'ha womfugamila,","poem":1},{"lineBreak":true},{"text":"chila yumwe kuli isi ya heye.","poem":1}]},{"type":"heading","content":["Mkulu Nguluwi kowadumya wanhu wa Kushi"]},{"type":"verse","number":12,"content":[{"text":"Namwe wanhu wa Kushi kahi","poem":1},{"lineBreak":true},{"text":"mobagama kwa ipanga lya heye.","poem":1}]},{"type":"heading","content":["Mkulu Nguluwi kowadumya wanhu wa Ashulu"]},{"type":"verse","number":13,"content":[{"text":"Kogolola moko wa heye kasikazini,","poem":1},{"lineBreak":true},{"text":"na kuidumya isi ya Ashulu.","poem":1},{"lineBreak":true},{"text":"Koudita muji wa Ninawi uwe uchiwa,","poem":1},{"lineBreak":true},{"text":"na kota kugunuche.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Vilundo vya migongolo ja kufujigwa vyowasa amo,","poem":1},{"lineBreak":true},{"text":"na chila igongolo lya kisolo.","poem":1},{"lineBreak":true},{"text":"Mikungule na mituwe jochikala mchanya mwa mizengo jake,","poem":1},{"lineBreak":true},{"text":"mituwe jolila kuli mitubuli jake,","poem":1},{"lineBreak":true},{"text":"na kuli fulemu za lwizi,","poem":1},{"lineBreak":true},{"text":"kwa vila ng'handa zake za mielezi zowa zilechigwe mwanzi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Awu ndo muji uwele nawali ulingidaya na kikala kwa kikala goya,","poem":1},{"lineBreak":true},{"text":"muji uwele nawilonjela, “Ndo heni hela, haduhu yunji!”","poem":1},{"lineBreak":true},{"text":"Ndaze vyouwele ulihela chinhu,","poem":1},{"lineBreak":true},{"text":"na kuwa haluga ha migongolo ja kisolo!","poem":1},{"lineBreak":true},{"text":"Chila hoyokola habehi kouzomela na kuubeza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}