{"translation":{"id":"vid_pbt","name":"Ilagano lya Katali, Ilagano Linyale kwa Wanhu Weng’ha","website":"https://ebible.org/Scriptures/details.php?id=vid","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vid","licenseNotes":null,"shortName":"PBT","englishName":"Vidunda NT+","language":"vid","textDirection":"ltr","sha256":"ab184473251eb3303af54303f915926f539274b8c9d96f9d8166a04f97703253","availableFormats":["json"],"listOfBooksApiLink":"/api/vid_pbt/books.json","numberOfBooks":53,"totalNumberOfChapters":846,"totalNumberOfVerses":22631,"languageName":"Vidunda","languageEnglishName":"Vidunda"},"book":{"id":"ZEP","translationId":"vid_pbt","name":"Sefaniya","commonName":"Sefaniya","title":"Sefaniya","order":36,"numberOfChapters":3,"sha256":"7168a8f04d972dbb06d0cc3a92c2e0a35ca8ed9ed11f0a5a6a7227dde5f03074","firstChapterNumber":1,"firstChapterApiLink":"/api/vid_pbt/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/vid_pbt/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Yelusalemu yangutagusigwa"]},{"type":"verse","number":1,"content":[{"text":"Mochona hemwe wanhu wa Yelusalemu,","poem":1},{"lineBreak":true},{"text":"mlingubunza na mkokomoche na mlingubelenhuka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hamlinguhulichiza makanyo","poem":1},{"lineBreak":true},{"text":"ne kukunda kukanyigwa.","poem":1},{"lineBreak":true},{"text":"Hamlingitumbila kwa Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"ne kuwa habehi na Nguluwi wa hemwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vilongozi wake ndo misimba jilingubuma,","poem":1},{"lineBreak":true},{"text":"watagusa wake ndo mibwa ja kisolo jiwele na nzala ng'hatu mhela wa matinazo,","poem":1},{"lineBreak":true},{"text":"hajilinguleka choneche kwa chiwalo cha mitondo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waloli wake hawalingudita chinhu kwa kulolela goya na walingubelenhuka.","poem":1},{"lineBreak":true},{"text":"Watambika wake nawavidita vinhu vyelile viwe vikokomoche","poem":1},{"lineBreak":true},{"text":"na kwajiliza malajizo ga Nguluwi kwa chiwalo cha hewo wawo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ila Mkulu Nguluwi yawele Yelusalemu ndo yatanganiche,","poem":1},{"lineBreak":true},{"text":"halingudita mbuli yoneche yihile.","poem":1},{"lineBreak":true},{"text":"Chila mitondo kangulajilaga hachi ya heye,","poem":1},{"lineBreak":true},{"text":"ena, chila zuwa halingulemwela,","poem":1},{"lineBreak":true},{"text":"ila wehile wahela soni ne hado.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mkulu Nguluwi kangulonga,","poem":1},{"lineBreak":true},{"text":"“Nandiwadumya wanhu wa isi zinji,","poem":1},{"lineBreak":true},{"text":"ngome za hewo nandizibomola.","poem":1},{"lineBreak":true},{"text":"Nzila zawo nandiziwifya,","poem":1},{"lineBreak":true},{"text":"haduhu yalingukola amo.","poem":1},{"lineBreak":true},{"text":"Miji jawo najiwifigwa,","poem":1},{"lineBreak":true},{"text":"haduhu ne yumwe yalechigwe mkomu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nandijesa, ‘Ndikomya Yelusalemu wondumba na kugakunda makanyo,","poem":1},{"lineBreak":true},{"text":"wahalechile kukumbuchila vyondiugazile.’","poem":1},{"lineBreak":true},{"text":"Ila wanhu wake nawali na maya lukami","poem":1},{"lineBreak":true},{"text":"ga kudita madito gawo gehile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lelo, mmbeteze,","poem":1},{"lineBreak":true},{"text":"zuwa lyondikwima kulavya ulonjelezi.","poem":1},{"lineBreak":true},{"text":"Nanyamula kuwakungajiza wanhu wa isi na undewa,","poem":1},{"lineBreak":true},{"text":"na kuwalajila kuzudila kwa heni,","poem":1},{"lineBreak":true},{"text":"na ng'halazi ya heni yeng'ha ing'hang'hale.","poem":1},{"lineBreak":true},{"text":"Isi yeng'ha yolakazwa kwa chiluli cha fihi ya ng'halazi ya heni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mhela awo ndojeliza milomo ja wanhu wa isi zeng'ha,","poem":1},{"lineBreak":true},{"text":"leka walicheme itagwa lya heni Mkulu Nguluwi,","poem":1},{"lineBreak":true},{"text":"na kung'holela mijito kwa kunuwila kumwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kulawa kumwambu mwa nzanda za Kushi","poem":1},{"lineBreak":true},{"text":"wanhu wa heni walingufugamila heni,","poem":1},{"lineBreak":true},{"text":"wanhu wa heni wawele nawasambaluka,","poem":1},{"lineBreak":true},{"text":"wongalila ndolendole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Zuwa alyo, hambasigwa soni,","poem":1},{"lineBreak":true},{"text":"kwa chiwalo cha madito ga hemwe ga kumbelenhuka,","poem":1},{"lineBreak":true},{"text":"kwa vila ndowosa hali hemwe,","poem":1},{"lineBreak":true},{"text":"wala walingidaya na kiyipa ukulu.","poem":1},{"lineBreak":true},{"text":"Namwe hamuweza kidaya kahi kuli chidunda cha heni chelile.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ndowalechela wanhu wawele liholile na walingunyenyetela,","poem":1},{"lineBreak":true},{"text":"walingitumbila kikala goya kwa itagwa lya heni Mkulu Nguluwi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waisilaeli wasigale,","poem":1},{"lineBreak":true},{"text":"hawoileka hachi ne kulonga udesi,","poem":1},{"lineBreak":true},{"text":"uhadi hauwa kuli milomo ja hewo.","poem":1},{"lineBreak":true},{"text":"Wolya na kuwasa,","poem":1},{"lineBreak":true},{"text":"haduhu munhu yoneche yawele kowadita wadumbe.”","poem":1}]},{"type":"heading","content":["Lwimbo lwa kusangalala"]},{"type":"verse","number":14,"content":[{"text":"Wimbe kwa lizi likulu, gwa Siyoni,","poem":1},{"lineBreak":true},{"text":"gwa Isilaeli ulavye lizi.","poem":1},{"lineBreak":true},{"text":"Usangalale na kutowa luchenze kwa nhumbula ya hegwe yeng'ha,","poem":1},{"lineBreak":true},{"text":"gwa Yelusalemu!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi nakawosela utaguso uwele wahawafichile,","poem":1},{"lineBreak":true},{"text":"nakawawinga wang'honyo wa hemwe.","poem":1},{"lineBreak":true},{"text":"Mkulu Nguluwi, mndewa wa Isilaeli ka hamwe na hemwe,","poem":1},{"lineBreak":true},{"text":"hamlinguganigwa kudumba magazo kahi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zuwa alyo, muji wa Yelusalemu wolonjelwa,","poem":1},{"lineBreak":true},{"text":"“Uleche kudumba, gwa Siyoni,","poem":1},{"lineBreak":true},{"text":"wikangaze ng'hatu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mkulu Nguluwi, Nguluwi wa hemwe, ka hamwe na hemwe","poem":1},{"lineBreak":true},{"text":"heye ndo yawele na mong'ho wa kulohola.","poem":1},{"lineBreak":true},{"text":"Heye kosangalala kwa chiwalo cha hemwe kwa kusangalala kukulu,","poem":1},{"lineBreak":true},{"text":"kwa igano lya heye kowadita msindamale.","poem":1},{"lineBreak":true},{"text":"Kosangalala kwa chiwalo cha hemwe kwa lwimbo lwa lizi likulu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mkulu Nguluwi kangulonga,","poem":1},{"lineBreak":true},{"text":"“Ndogosa masinzo kwa hemwe,","poem":1},{"lineBreak":true},{"text":"kuli mazuwa ga mnvina ziwichigwe,","poem":1},{"lineBreak":true},{"text":"kwa vila ago ndo itunyo na kudeula kwa hemwe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mhela awo ndowagaza weng'ha walinguwabunza hemwe.","poem":1},{"lineBreak":true},{"text":"Ndowalohola vyete na kuwakungajiza wawele nawasambaluka.","poem":1},{"lineBreak":true},{"text":"Ndowapa hewo lutogo na kuhulichizwa,","poem":1},{"lineBreak":true},{"text":"kuli chila isi iwele nawali wabasigwe soni.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mhela awo ndowakungajiza hemwe,","poem":1},{"lineBreak":true},{"text":"ndowegala haluga.","poem":1},{"lineBreak":true},{"text":"Ndowadita mzeleche na kutogoligwa,","poem":1},{"lineBreak":true},{"text":"hali wanhu weng'ha muisi,","poem":1},{"lineBreak":true},{"text":"hondiwahilulila lufufu lwa hemwe,","poem":1},{"lineBreak":true},{"text":"kuno mlola.","poem":1},{"lineBreak":true},{"text":"Heni Mkulu Nguluwi nandonga.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vid_pbt/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vid_pbt/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vid_pbt/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}