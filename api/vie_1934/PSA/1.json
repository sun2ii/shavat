{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Phước cho người nào chẳng theo mưu kế của kẻ dữ, Chẳng đứng trong đường tội nhân, Không ngồi chỗ của kẻ nhạo báng;"]},{"type":"verse","number":2,"content":["Song lấy làm vui vẻ về luật pháp của Đức Giê-hô-va, Và suy gẫm luật pháp ấy ngày và đêm."]},{"type":"verse","number":3,"content":["Người ấy sẽ như cây trồng gần dòng nước, Sanh bông trái theo thì tiết, Lá nó cũng chẳng tàn héo; Mọi sự người làm đều sẽ thạnh vượng."]},{"type":"verse","number":4,"content":["Kẻ ác chẳng như vậy đâu; Nhưng chúng nó khác nào rơm rác gió thổi bay đi."]},{"type":"verse","number":5,"content":["Bởi cớ ấy kẻ ác chẳng đứng nổi trong ngày đoán xét, Tội nhân cũng không được vào hội người công bình."]},{"type":"verse","number":6,"content":["Vì Đức Giê-hô-va biết đường người công bình, Song đường kẻ ác rồi bị diệt vong."]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}