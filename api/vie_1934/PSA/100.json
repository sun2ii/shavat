{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":["Hỡi cả trái đất, Hãy cất tiếng reo mừng cho Đức Giê-hô-va!"]},{"type":"verse","number":2,"content":["Khá hầu việc Đức Giê-hô-va cách vui mừng, Hãy hát xướng mà đến trước mặt Ngài."]},{"type":"verse","number":3,"content":["Phải biết rằng Giê-hô-va là Đức Chúa Trời. Chính Ngài đã dựng nên chúng tôi, chúng tôi thuộc về Ngài; Chúng tôi là dân sự Ngài, là bầy chiên của đồng cỏ Ngài."]},{"type":"verse","number":4,"content":["Hãy cảm tạ mà vào các cửa Ngài, Hãy ngợi khen mà vào hành lang Ngài. Khá cảm tạ Ngài, chúc tụng danh của Ngài."]},{"type":"verse","number":5,"content":["Vì Đức Giê-hô-va là thiện; sự nhân từ Ngài hằng có mãi mãi, Và sự thành tín Ngài còn đến đời đời."]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/99.json","previousChapterAudioLinks":{},"numberOfV