rLink":"/api/vie_1934/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}