{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":["Ha-lê-lu-gia! Hỡi các tôi tớ Đức Giê-hô-va, hãy ngợi khen, Hãy ngợi khen danh Đức Giê-hô-va."]},{"type":"verse","number":2,"content":["Đáng chúc tụng danh Đức Giê-hô-va. Từ bây giờ cho đến đời đời!"]},{"type":"verse","number":3,"content":["Từ nơi mặt trời mọc cho đến nơi mặt trời lặn, Khá ngợi khen danh Đức Giê-hô-va!"]},{"type":"verse","number":4,"content":["Đức Giê-hô-va vượt cao hơn các dân. Sự vinh hiển Ngài cao hơn các từng trời."]},{"type":"verse","number":5,"content":["Ai giống như Giê-hô-va Đức Chúa Trời chúng tôi? Ngôi Ngài ở trên cao;"]},{"type":"verse","number":6,"content":["Ngài hạ mình xuống Đặng xem xét trời và đất."]},{"type":"verse","number":7,"content":["Ngài nâng đỡ người khốn cùng lên khỏi bụi tro, Cất kẻ thiếu thốn khỏi đống phân,"]},{"type":"verse","number":8,"content":["Đặng để người ngồi chung với các quan trưởng, Tức với các quan trưởng của dân sự Ngài."]},{"type":"verse","number":9,"content":["Ngài khiến đàn bà son sẻ ở trong nhà, Làm mẹ vui vẻ của những con cái. Ha-lê-lu-gia!"]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}