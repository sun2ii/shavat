{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":["Tôi ngước mắt lên trên núi: Sự tiếp trợ tôi đến từ đâu?"]},{"type":"verse","number":2,"content":["Sự tiếp trợ tôi đến từ Đức Giê-hô-va, Là Đấng đã dựng nên trời và đất."]},{"type":"verse","number":3,"content":["Ngài không để cho chân ngươi xiêu tó; Đấng gìn giữ ngươi không hề buồn ngủ."]},{"type":"verse","number":4,"content":["Đấng gìn giữ Y-sơ-ra-ên Không hề nhắp mắt, cũng không buồn ngủ."]},{"type":"verse","number":5,"content":["Đức Giê-hô-va là Đấng gìn giữ ngươi; Đức Giê-hô-va là bóng che ở bên hữu ngươi."]},{"type":"verse","number":6,"content":["Mặt trời sẽ không giọi ngươi lúc ban ngày, Mặt trăng cũng không hại ngươi trong ban đêm."]},{"type":"verse","number":7,"content":["Đức Giê-hô-va sẽ gìn giữ ngươi khỏi mọi tai họa. Ngài sẽ gìn giữ linh hồn ngươi."]},{"type":"verse","number":8,"content":["Đức Giê-hô-va sẽ gìn giữ ngươi khi ra khi vào, Từ nay cho đến đời đời."]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}