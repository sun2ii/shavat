{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":["Những người tin cậy nơi Đức Giê-hô-va Khác nào núi Si-ôn không rúng động, Hằng còn đến đời đời."]},{"type":"verse","number":2,"content":["Các núi vây quanh Giê-ru-sa-lem thể nào, Đức Giê-hô-va vây phủ dân sự Ngài thể ấy. Từ rày cho đến đời đời."]},{"type":"verse","number":3,"content":["Vì cây gậy kẻ ác sẽ không được đặt Trên sản nghiệp người công bình; Hầu cho người công bình không đưa tay ra về sự gian ác."]},{"type":"verse","number":4,"content":["Hỡi Đức Giê-hô-va, xin hãy làm điều lành cho người lành, Và cho kẻ có lòng ngay thẳng."]},{"type":"verse","number":5,"content":["Còn về những kẻ trở đi theo đường cong quẹo, Đức Giê-hô-va sẽ dẫn chúng nó đi ra chung với kẻ làm ác. Nguyện bình an giáng trên Y-sơ-ra-ên!"]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/12