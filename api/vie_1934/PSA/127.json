{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":["Nếu Đức Giê-hô-va không cất nhà, Thì những thợ xây cất làm uổng công. Nhược bằng Đức Giê-hô-va không coi-giữ thành, Thì người canh thức canh luống công."]},{"type":"verse","number":2,"content":["Uổng công thay cho các ngươi thức dậy sớm, đi ngủ trễ, Và ăn bánh lao khổ; Chúa cũng ban giấc ngủ cho kẻ Ngài yêu mến bằng vậy."]},{"type":"verse","number":3,"content":["Kìa, con cái là cơ nghiệp bởi Đức Giê-hô-va mà ra; Bông trái của tử cung là phần thưởng."]},{"type":"verse","number":4,"content":["Con trai sanh trong buổi đang thì, Khác nào mũi tên nơi tay dõng sĩ."]},{"type":"verse","number":5,"content":["Phước cho người nào vắt nó đầy gùi mình! Người sẽ không hổ thẹn, Khi nói năng với kẻ thù nghịch mình tại cửa thành."]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/1