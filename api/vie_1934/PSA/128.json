{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":["Phước cho người nào kính sợ Đức Giê-hô-va, Đi trong đường lối Ngài!"]},{"type":"verse","number":2,"content":["Vì ngươi sẽ hưởng công việc của tay mình, Được phước, may mắn."]},{"type":"verse","number":3,"content":["Vợ ngươi ở trong nhà ngươi Sẽ như cây nho thạnh mậu; Con cái ngươi ở chung quanh bàn ngươi Khác nào những chồi ô-li-ve."]},{"type":"verse","number":4,"content":["Kìa, người nào kính sợ Đức Giê-hô-va Sẽ được phước là như vậy."]},{"type":"verse","number":5,"content":["Nguyện Đức Giê-hô-va từ Si-ôn ban phước cho ngươi; Nguyện trọn đời mình ngươi được thấy sự phước lành của Giê-ru-sa-lem."]},{"type":"verse","number":6,"content":["Nguyện ngươi được thấy con cháu mình! Nguyện sự bình an giáng trên Y-sơ-ra-ên!"]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_1934/PSA/