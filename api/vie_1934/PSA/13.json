{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Đức Giê-hô-va ôi! Ngài sẽ hằng quên tôi cho đến chừng nào? Ngài ẩn mặt cùng tôi cho đến bao giờ?"]},{"type":"verse","number":2,"content":["Tôi phải lo lắng nơi linh hồn tôi, Hằng ngày buồn thảm nơi lòng tôi cho đến bao giờ? Kẻ thù nghịch tôi sẽ trổi hơn tôi cho đến chừng nào?"]},{"type":"verse","number":3,"content":["Hỡi Giê-hô-va, Đức Chúa Trời tôi, xin hãy xem xét, nhậm lời tôi, Và làm cho mắt tôi được sáng, Kẻo tôi phải ngủ chết chăng."]},{"type":"verse","number":4,"content":["Kẻ thù nghịch nói rằng: Ta đã thắng hơn nó, Và kẻ cừu địch mừng rỡ khi tôi xiêu tó."]},{"type":"verse","number":5,"content":["Nhưng tôi đã tin cậy nơi sự nhân từ Chúa; Lòng tôi khoái lạc về sự cứu rỗi của Chúa."]},{"type":"verse","number":6,"content":["Tôi sẽ hát ngợi khen Đức Giê-hô-va, vì Ngài đã làm ơn cho tôi."]}],"footnotes":[]},"thisChapterLink":"/api/vie_1934/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_1934/PSA/14.jso