{"translation":{"id":"vie_1934","name":"Kinh Thánh","website":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vie1934","licenseNotes":null,"shortName":"1934","englishName":"Vietnamese Bible 1923","language":"vie","textDirection":"ltr","sha256":"14be858b669c29d177d4a503872565d094fd329cde05baadb0eaf3e02f42d46e","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_1934/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_1934","name":"THI THIÊN","commonName":"THI THIÊN","title":"Thi thiên","order":19,"numberOfChapters":150,"sha256":"ec29a56675325427853cc4d79a37b61fd47aa3dcd7b943d42d5af2706eda12cf","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_1934/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_1934/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":["Nguyện Đức Chúa Trời thương xót chúng tôi, và ban phước cho chúng tôi, Soi sáng mặt Ngài trên chúng tôi."]},{"type":"verse","number":2,"content":["Để đường lối Chúa được biết trên đất, Và sự cứu rỗi của Chúa được biết giữa các nước."]},{"type":"verse","number":3,"content":["Hỡi Đức Chúa Trời, nguyện các dân ngợi khen Chúa! Nguyện muôn dân ca tụng Chúa!"]},{"type":"verse","number":4,"content":["Các nước khá vui vẻ và hát mừng rỡ; Vì Chúa sẽ dùng sự ngay thẳng mà đoán xét các dân, Và cai trị các nước trên đất."]},{"type":"verse","number":5,"content":["Hỡi Đức Chúa Trời, nguyện các dân ngợi khen Chúa! Nguyện muôn dân ca tụng Ngài!"]},{"type":"verse","number":6,"content":["Đất đã sanh hoa lợi nó, Đức Chúa Trời là Đức Chúa Trời chúng tôi, sẽ ban phước cho chúng tôi."]},{"type":"verse","number":7,"content":["Đức Chúa Trời sẽ ban phước cho chúng tôi, Và các đầu cùng đất đều sẽ kính sợ Ngài."]}],"footnotes":[]},"thisChapterLink":"/api