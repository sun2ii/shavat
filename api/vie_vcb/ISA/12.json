{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"ISA","translationId":"vie_vcb","name":"Y-sai","commonName":"Y-sai","title":"Y-sai","order":23,"numberOfChapters":66,"sha256":"cb65803674f0ce796cd5356a6fa034ecb8c53fe0435f1c27ea9ef646e1a59e0a","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/vie_vcb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Bài Ca Tôn Vinh Chúa"]},{"type":"verse","number":1,"content":["Trong ngày ấy, ngươi sẽ nói:",{"text":"“Lạy Chúa Hằng Hữu! Con ngợi tôn Chúa,","poem":1},{"text":"Chúa đã giận con,","poem":2},{"lineBreak":true},{"text":"nhưng nay Ngài đã hết giận.","poem":2},{"text":"Vì Ngài an ủi con.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thật, Đức Chúa Trời đến để cứu con.","poem":1},{"text":"Con sẽ tin cậy Ngài và không sợ hãi,","poem":2},{"text":"Chúa Hằng Hữu, Đức Chúa Trời là sức mạnh của con","poem":1},{"text":"và bài ca của con;","poem":2},{"text":"Ngài đã ban cho con ơn cứu rỗi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Các ngươi sẽ vui mừng uống nước","poem":1},{"text":"từ giếng cứu rỗi!","poem":2}]},{"type":"verse","number":4,"content":["Trong ngày tuyệt diệu ấy, các ngươi sẽ hát:",{"text":"“Cảm tạ Chúa Hằng Hữu! Ngợi khen Danh Ngài!","poem":1},{"text":"Hãy nói với các nước những công việc Ngài đã làm.","poem":2},{"lineBreak":true},{"text":"Hãy cho họ biết quyền năng của Ngài thế nào!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hãy ca ngợi Chúa Hằng Hữu, vì Ngài đã làm những việc diệu kỳ.","poem":1},{"text":"Hãy để cả thế giới tán dương Ngài.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hỡi toàn dân Giê-ru-sa-lem hãy lớn tiếng hân hoan ca ngợi Chúa!","poem":1},{"text":"Vì sự vĩ đại là Đấng Thánh của Ít-ra-ên ngự giữa dân Ngài.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}