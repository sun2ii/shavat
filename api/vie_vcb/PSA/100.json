","poem":1},{"text":"Đức bác ái Ngài hằng còn mãi,","poem":2},{"lineBreak":true},{"text":"và đức thành tín Ngài còn đến đời đời.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}