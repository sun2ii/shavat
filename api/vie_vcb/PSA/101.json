{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Quyết Tâm Theo Đường Trọn Vẹn"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít)"]},{"type":"verse","number":1,"content":[{"text":"Con sẽ ca ngợi sự nhân từ và đức công chính Ngài, lạy Chúa Hằng Hữu.","poem":1},{"text":"Con xin dâng tiếng tụng ca Ngài.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Con sẽ sống cẩn thận theo con đường thiện hảo.","poem":1},{"text":"Khi nào Chúa sẽ đến giúp con?","poem":2},{"text":"Con sẽ cư xử trong gia đình con","poem":1},{"text":"bằng tâm hồn trọn vẹn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mắt con sẽ không","poem":1},{"text":"nhìn vào những cảnh hèn hạ, xấu xa.","poem":2},{"text":"Lòng con ghê tởm sự gian tà;","poem":1},{"text":"con sẽ không dính dấp vào điều ác.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Con sẽ loại trừ lòng hư hoại","poem":1},{"text":"và xa lánh loài gian ác.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Người nào nói xấu người thân cận, con sẽ làm cho họ câm lại.","poem":1},{"text":"Con không chấp nhận mắt kiêu căng và lòng tự đại.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nhưng con để mắt tìm người thành tín trong xứ,","poem":1},{"text":"cho họ sống chung với con.","poem":2},{"text":"Chỉ những ai sống đời trong sạch","poem":1},{"text":"sẽ phục vụ con.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Con không dung nạp người phản trắc trong nhà,","poem":1},{"text":"cũng không thứ tha miệng môi dối gạt.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mỗi buổi sáng, con diệt trừ người ác,","poem":1},{"noteId":126},{"text":"thành của Chúa Hằng Hữu không còn bọn gian tà.","poem":2}]}],"footnotes":[{"noteId":126,"caller":"+","text":"Người ác trong xứ","reference":{"chapter":101,"verse":8}}]},"thisChapterLink":"/api/vie_vcb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}