{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Chúa Là Nơi Nương Náu"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít, soạn cho nhạc trưởng)"]},{"type":"verse","number":1,"content":[{"text":"Tôi đã ẩn mình trong Chúa Hằng Hữu.","poem":1},{"text":"Sao các anh cứ nói:","poem":2},{"lineBreak":true},{"text":"“Hãy như chim bay về núi để an toàn!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vì người ác đang giương cung","poem":1},{"text":"trong bóng tối, sẵn sàng tra tên vào cung,","poem":2},{"lineBreak":true},{"text":"để bắn giết người tâm hồn ngay thẳng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nếu các nền tảng của luật pháp và trật tự bị phá hủy.","poem":1},{"text":"Người công chính biết phải làm gì?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chúa Hằng Hữu ngự trong Đền Thánh;","poem":1},{"text":"Chúa Hằng Hữu cai trị từ ngôi cao.","poem":2},{"text":"Chúa quan sát con người,","poem":1},{"text":"mắt Chúa tra xét chúng.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chúa Hằng Hữu thử nghiệm người công chính.","poem":1},{"text":"Ngài gớm ghê phường gian ác, bạo tàn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Giáng trên họ mưa lửa với lưu huỳnh,","poem":1},{"text":"thiêu đốt họ trong cơn gió cháy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vì Chúa công chính yêu điều ngay thẳng.","poem":1},{"text":"Người lành ngay sẽ nhìn thấy Thiên nhan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}