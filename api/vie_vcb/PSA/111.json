{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["Ca Ngợi Chúa vì Hay Làm Ơn"]},{"type":"verse","number":1,"content":[{"text":"Ngợi tôn Chúa Hằng Hữu!","poem":1},{"lineBreak":true},{"text":"Con sẽ hết lòng tạ ơn Chúa Hằng Hữu,","poem":1},{"text":"giữa hội chúng và cộng đồng người công chính.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Công ơn Chúa vô cùng vĩ đại!","poem":1},{"text":"Những người ham thích đáng nên học hỏi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Công tác Chúa uy nghi trác tuyệt.","poem":1},{"text":"Công nghĩa Ngài còn mãi muôn đời.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kỳ công Chúa đáng nên ghi nhớ.","poem":1},{"text":"Ngài đầy tràn ân lành và trắc ẩn biết bao!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chúa nuôi dưỡng những người tin kính;","poem":1},{"text":"và nhớ giao ước Ngài mãi mãi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chúa phô bày quyền năng kỳ diệu,","poem":1},{"text":"cho dân Ngài cơ nghiệp của các nước.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tay Chúa thực thi chân thật, công bằng,","poem":1},{"text":"mệnh lệnh Ngài thật đáng tin cậy.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Được kiên lập đời đời vĩnh cửu,","poem":1},{"text":"một cách công bằng và chân thật.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chúa đem cứu rỗi cho toàn dân.","poem":1},{"text":"Xác nhận giao ước Ngài mãi mãi.","poem":2},{"lineBreak":true},{"text":"Danh Chúa thật thánh và đáng sợ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kính sợ Chúa Hằng Hữu là nền của sự khôn ngoan.","poem":1},{"text":"Ai vâng lời Ngài sẽ lớn lên trong khôn ngoan.","poem":2},{"lineBreak":true},{"text":"Tán dương Chúa đời đời vĩnh cửu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}