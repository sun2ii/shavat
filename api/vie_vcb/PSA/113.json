xt":"Ngài khom mình xuống","poem":1},{"text":"nhìn xem mọi vật trong bầu trời và trên đất.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngài nâng người nghèo khổ từ tro bụi","poem":1},{"text":"và cứu người đói khát khỏi rác rơm.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngài đặt họ ngang hàng các hoàng tử,","poem":1},{"text":"chung với các hoàng tử của dân Ngài.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chúa ban con cái cho người hiếm muộn,","poem":1},{"text":"cho họ làm người mẹ hạnh phúc.","poem":2},{"lineBreak":true},{"text":"Chúc tôn Chúa Hằng Hữu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}