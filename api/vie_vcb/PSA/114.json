sao lại nhảy như chiên con?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Trái đất hỡi, hãy run sợ trước thánh nhan Chúa,","poem":1},{"text":"tại nơi Đức Chúa Trời nhà Gia-cốp hiện diện.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngài biến đá tảng ra ao hồ;","poem":1},{"text":"đổi đá cứng thành suối nước.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}