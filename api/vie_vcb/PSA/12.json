 Hằng Hữu phán: “Vì người cô thế bị áp bức,","poem":1},{"text":"và người đói khổ rên la,","poem":2},{"lineBreak":true},{"text":"Ta sẽ trỗi dậy bảo vệ chúng khỏi những người tác hại.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lời Chúa Hằng Hữu là lời tinh khiết,","poem":1},{"text":"như bạc luyện trong lò gốm,","poem":2},{"lineBreak":true},{"text":"được thanh tẩy bảy lần.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chúa Hằng Hữu ôi, xin bảo vệ gìn giữ,","poem":1},{"text":"chở che chúng con khỏi những người như vậy mãi mãi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"dù người ác chỉ tự do thao túng,","poem":1},{"text":"và việc đê hèn được loài người ca tụng.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}