{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Cầu Chúa Cứu Khỏi Tay Người Giả Ngụy"]},{"type":"hebrew_subtitle","content":["(Bài ca lên Đền Thờ)"]},{"type":"verse","number":1,"content":[{"text":"Lúc khốn cùng, tôi kêu cầu Chúa Hằng Hữu;","poem":1},{"text":"tôi kêu khóc, Ngài đáp lời tôi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xin Chúa Hằng Hữu cứu con khỏi môi dối trá","poem":1},{"text":"và khỏi lưỡi lừa gạt.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Này, lưỡi lừa dối, Đức Chúa Trời sẽ làm gì cho ngươi?","poem":1},{"text":"Ngài còn thêm cho ngươi điều gì nữa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hẳn là mũi tên nhọn của lính chiến,","poem":1},{"noteId":167},{"text":"với những viên than hồng từ lá chổi.","poem":2},{"noteId":168}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Khốn cho tôi vì ngụ tại Mê-siếc,","poem":1},{"text":"và trú trong lều Kê-đa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tôi ở đó quá lâu,","poem":1},{"text":"với những người ghét hòa bình,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tôi chuộng hòa bình;","poem":1},{"text":"nhưng khi tôi nói ra, họ lại muốn chiến tranh!","poem":2}]}],"footnotes":[{"noteId":167,"caller":"+","text":"Nt của người mạnh","reference":{"chapter":120,"verse":4}},{"noteId":168,"caller":"+","text":"Nt thân cây kim tước","reference":{"chapter":120,"verse":4}}]},"thisChapterLink":"/api/vie_vcb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}