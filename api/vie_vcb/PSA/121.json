{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Chúa Bảo Vệ Dân Chúa"]},{"type":"hebrew_subtitle","content":["(Bài ca lên Đền Thờ)"]},{"type":"verse","number":1,"content":[{"text":"Tôi ngước nhìn đồi núi—","poem":1},{"text":"ơn cứu giúp đến từ đâu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ơn cứu giúp từ Chúa Hằng Hữu,","poem":1},{"text":"Đấng sáng tạo đất trời!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Chúa không để chân ngươi trơn trợt;","poem":1},{"text":"Đấng canh giữ ngươi không bao giờ ngủ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Phải, Đấng canh giữ Ít-ra-ên luôn tỉnh thức,","poem":1},{"text":"Ngài không bao giờ ngủ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chúa Hằng Hữu là Đấng canh giữ ngươi!","poem":1},{"text":"Chúa Hằng Hữu đứng bên ngươi như chiếc bóng che chở.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ban ngày, mặt trời sẽ không thiêu đốt ngươi,","poem":1},{"text":"ban đêm ánh trăng cũng không làm hại.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chúa Hằng Hữu gìn giữ ngươi khỏi mọi tai họa","poem":1},{"text":"và bảo vệ mạng sống ngươi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chúa Hằng Hữu che chở ngươi khi ra khi vào,","poem":1},{"text":"từ nay đến muôn đời.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}