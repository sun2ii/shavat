{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Cầu Phước cho Giê-ru-sa-lem"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít. Bài ca lên Đền Thờ)"]},{"type":"verse","number":1,"content":[{"text":"Tôi vui khi người ta giục giã:","poem":1},{"text":"“Chúng ta cùng đi lên nhà Chúa Hằng Hữu.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hỡi Giê-ru-sa-lem,","poem":1},{"text":"chúng ta dừng chân tại cửa ngươi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Thành Giê-ru-sa-lem được xây cất;","poem":1},{"text":"liên kết nhau chặt chẽ vô cùng.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Các đại tộc Ít-ra-ên—con dân Chúa—","poem":1},{"text":"đều lên đây.","poem":2},{"text":"Y theo tục lệ Ít-ra-ên,","poem":1},{"text":"để cảm tạ Danh Chúa Hằng Hữu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vì tại đây, ngôi xét xử được thiết lập,","poem":1},{"text":"là ngôi vua nhà Đa-vít.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hãy cầu hòa bình cho Giê-ru-sa-lem.","poem":1},{"text":"Nguyện ai yêu ngươi sẽ được hưng thịnh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hỡi Giê-ru-sa-lem, nguyện cho hòa bình trong thành","poem":1},{"text":"và thịnh vượng trong lâu đài.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vì gia đình và bè bạn tôi, tôi nguyện cầu:","poem":1},{"text":"“Nguyện ngươi được an lạc.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vì nhà Chúa Hằng Hữu, Đức Chúa Trời chúng ta,","poem":1},{"text":"Tôi cầu xin phước lành cho ngươi, hỡi Giê-ru-sa-lem.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}