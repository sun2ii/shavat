{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Chúa Bảo Vệ Dân Chúa"]},{"type":"hebrew_subtitle","content":["(Bài ca lên đền thờ)"]},{"type":"verse","number":1,"content":[{"text":"Ai tin cậy Chúa Hằng Hữu sẽ giống Núi Si-ôn;","poem":1},{"text":"không dao động, nhưng bất diệt trường tồn.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Núi non bao bọc Giê-ru-sa-lem,","poem":1},{"text":"như Chúa Hằng Hữu chở che dân Ngài, từ nay cho đến muôn đời.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vì người ác không còn cầm quyền","poem":1},{"noteId":169},{"text":"trên phần đất người công chính,","poem":1},{"text":"để chúng ta khỏi bị ép buộc nhúng tay vào việc bất lương.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chúa Hằng Hữu ôi, xin ban phước cho người hiền đức,","poem":1},{"text":"là những người có lòng công chính.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Còn người đi theo đường cong queo, lạy Chúa Hằng Hữu.","poem":1},{"text":"Xin phạt họ chung với những ai làm điều ác.","poem":2},{"lineBreak":true},{"text":"Nguyện cầu thanh bình cho Ít-ra-ên!","poem":1}]}],"footnotes":[{"noteId":169,"caller":"+","text":"Nt quyền trượng người ác sẽ không đặt","reference":{"chapter":125,"verse":3}}]},"thisChapterLink":"/api/vie_vcb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}