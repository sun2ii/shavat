e","number":5,"content":[{"text":"Người gieo với nước mắt","poem":1},{"text":"sẽ gặt trong tiếng cười.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khi mang hạt giống đi gieo thì đầy nước mắt,","poem":1},{"text":"nhưng lúc gánh lúa về thì đầy tiếng reo vui.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}