em":2}]},{"type":"verse","number":5,"content":[{"text":"Phước cho người đông con!","poem":1},{"noteId":170},{"text":"Vì sẽ không bị thua sút,","poem":2},{"noteId":171},{"text":"khi","poem":2},{"lineBreak":true},{"text":"tranh chấp với kẻ thù tại cửa thành.","poem":2}]}],"footnotes":[{"noteId":170,"caller":"+","text":"Nt túi đầy tên","reference":{"chapter":127,"verse":5}},{"noteId":171,"caller":"+","text":"Nt xấu hổ","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/vie_vcb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}