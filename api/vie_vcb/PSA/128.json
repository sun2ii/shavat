},{"text":"Trọn đời ngươi thấy ân lành từ Giê-ru-sa-lem.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nguyện ngươi sẽ thấy cháu chắt mình.","poem":1},{"text":"Nguyện cầu bình an cho Giê-ru-sa-lem!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}