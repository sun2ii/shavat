{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Hy Vọng Chúa Thương Xót Tha Tội"]},{"type":"hebrew_subtitle","content":["(Bài ca lên Đền Thờ)"]},{"type":"verse","number":1,"content":[{"text":"Từ vực thẳm, lạy Chúa Hằng Hữu,","poem":1},{"text":"con kêu van cứu giúp.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xin lắng tai nghe, lạy Chúa.","poem":1},{"text":"Xin lưu ý lời con nguyện cầu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lạy Chúa Hằng Hữu, nếu Ngài ghi nhớ tội ác chúng con,","poem":1},{"text":"ai có thể đứng nổi trước mặt Ngài?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nhưng Chúa có lòng thứ tha,","poem":1},{"text":"nên Ngài đáng kính sợ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Con mong đợi Chúa Hằng Hữu;","poem":1},{"text":"linh hồn con ngóng trông Ngài.","poem":2},{"lineBreak":true},{"text":"Con hy vọng nơi lời hứa Ngài.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Linh hồn con trông mong Chúa","poem":1},{"text":"hơn người gác đêm chờ đợi bình minh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hỡi Ít-ra-ên, hãy hy vọng nơi Chúa Hằng Hữu;","poem":1},{"text":"vì Ngài có lòng nhân từ.","poem":2},{"lineBreak":true},{"text":"Ban ân cứu chuộc dồi dào.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngài sẽ cứu chuộc Ít-ra-ên,","poem":1},{"text":"khỏi mọi tội lỗi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}