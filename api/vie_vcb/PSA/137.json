{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Nỗi Buồn của Người Bị Lưu Đày"]},{"type":"verse","number":1,"content":[{"text":"Bên bờ sông Ba-by-lôn, chúng ta ngồi khóc","poem":1},{"text":"khi nhớ đến Si-ôn.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chúng ta đã treo đàn hạc,","poem":1},{"text":"trên cành liễu ven sông.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vì những người bắt chúng ta bảo phải ca hát.","poem":1},{"text":"Bọn tra tấn đánh đập chúng ta,","poem":2},{"text":"truyền lệnh bắt hoan ca","poem":1},{"text":"“Hát một ca khúc Si-ôn đi!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nhưng làm sao ca hát được bài ca của Chúa Hằng Hữu","poem":1},{"text":"trong khi ở nơi đất khách?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nếu ta quên ngươi, hỡi Giê-ru-sa-lem,","poem":1},{"text":"nguyện tay ta sẽ mất hết tài năng.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nguyện lưỡi ta sẽ bất động","poem":1},{"noteId":173},{"text":"không còn ca hát nữa.","poem":1},{"text":"Nếu ta không nhớ Giê-ru-sa-lem,","poem":2},{"lineBreak":true},{"text":"Không yêu Giê-ru-sa-lem hơn mọi điều vui thú nhất.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Cầu xin Chúa Hằng Hữu, nhớ việc quân Ê-đôm đã làm","poem":1},{"text":"trong ngày Giê-ru-sa-lem thất thủ.","poem":2},{"text":"Chúng reo hò: “Phá hủy!","poem":1},{"text":"San thành bình địa!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hỡi con gái Ba-by-lôn, các ngươi đã bị định cho diệt vong.","poem":1},{"text":"Phước cho người báo phạt Ba-by-lôn,","poem":2},{"lineBreak":true},{"text":"vì những gì các ngươi đã làm cho chúng ta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Phước cho người bắt hài nhi ngươi","poem":1},{"text":"và đập chúng vào núi đá.","poem":2}]}],"footnotes":[{"noteId":173,"caller":"+","text":"Nt dính nơi khẩu cái","reference":{"chapter":137,"verse":6}}]},"thisChapterLink":"/api/vie_vcb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}