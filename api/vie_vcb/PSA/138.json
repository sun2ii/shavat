{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Cảm Tạ Chúa Nhân Từ và Thành Tín"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít)"]},{"type":"verse","number":1,"content":[{"text":"Con hết lòng cảm tạ Chúa Hằng Hữu;","poem":1},{"text":"ca tụng Ngài trước các thần linh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hướng về Đền Thờ, con thờ lạy Chúa.","poem":1},{"text":"Nguyện tri ân thành tín, nhân từ","poem":2},{"text":"vì Danh Chúa được đề cao;","poem":1},{"text":"lời Chúa được tôn trọng vô cùng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Khi con kêu xin, Chúa đáp lời;","poem":1},{"text":"ban sinh lực, phấn khởi tâm linh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mọi vua trần gian sẽ cảm tạ Chúa Hằng Hữu,","poem":1},{"text":"vì họ được nghe lời Ngài.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Phải, họ sẽ ca tụng công việc Chúa Hằng Hữu,","poem":1},{"text":"vì vinh quang Ngài quá rực rỡ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dù Chúa Hằng Hữu cao cả, Ngài vẫn đoái thương người hèn mọn,","poem":1},{"text":"nhưng ai kiêu ngạo, Chúa liền tránh xa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lúc tai ương dồn dập,","poem":1},{"text":"Chúa sẽ bảo vệ con khỏi kẻ thù giận dữ.","poem":2},{"text":"Chúa đưa tay Ngài ra,","poem":1},{"text":"và quyền năng của tay phải Ngài giải cứu con.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chúa Hằng Hữu sẽ chu toàn mọi việc cho con—","poem":1},{"text":"vì lòng nhân từ Ngài, lạy Chúa Hằng Hữu, tồn tại muôn đời.","poem":2},{"lineBreak":true},{"text":"Xin đừng bỏ công việc của tay Ngài.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}