pe":"verse","number":6,"content":[{"text":"Hãy dùng môi miệng tung hô Đức Chúa Trời,","poem":1},{"text":"tay cầm gươm hai lưỡi—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"để báo thù các nước","poem":1},{"text":"và hình phạt các dân tộc,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"dùng xích trói các vua","poem":1},{"text":"và còng tay bọn quý tộc,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"thi hành bản án đã được ghi.","poem":1},{"text":"Đó là vinh quang cho các người thánh của Chúa.","poem":2},{"lineBreak":true},{"text":"Ngợi tôn Chúa Hằng Hữu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}