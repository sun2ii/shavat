{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Điều Kiện Để Làm Công Dân Si-ôn"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít)"]},{"type":"verse","number":1,"content":[{"text":"Lạy Chúa Hằng Hữu, ai có thể thờ phượng trong đền thánh Chúa?","poem":1},{"text":"Ai có thể bước vào sự hiện diện trên núi thánh Ngài?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Đó là người bước đi ngay thẳng,","poem":1},{"text":"sống thiện lành, suy niệm chân lý trong lòng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Người không hại bạn, không vu oan,","poem":1},{"text":"không đối xử sai trái với hàng xóm, láng giềng,","poem":2},{"lineBreak":true},{"text":"không nói lời phỉ báng.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Người ấy coi khinh người xấu xa tội ác,","poem":1},{"text":"nhưng tôn quý người kính thờ Chúa Hằng Hữu.","poem":2},{"lineBreak":true},{"text":"Người giữ lời hứa, dù bị tổn hại.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Người không cho vay tiền lấy lãi,","poem":1},{"text":"không ăn hối lộ hại dân lành.","poem":2},{"lineBreak":true},{"text":"Người như thế sẽ đứng vững vàng mãi mãi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}