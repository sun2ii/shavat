{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Xin Thắng Kẻ Thù"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít, soạn cho nhạc trưởng)"]},{"type":"verse","number":1,"content":[{"text":"Nguyện Chúa Hằng Hữu đáp lời người lúc khó khăn.","poem":1},{"text":"Cầu Đức Chúa Trời của Gia-cốp phù hộ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Từ đền thánh, xin Chúa đưa tay vùa giúp,","poem":1},{"text":"từ Si-ôn, người được đỡ nâng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xin Chúa nhớ mọi lễ vật người dâng,","poem":1},{"text":"hài lòng về những tế lễ thiêu của người.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nguyện Ngài cho người những điều mong ước","poem":1},{"text":"và hoàn thành kế hoạch người dự trù.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chúng con reo mừng nghe người được cứu,","poem":1},{"text":"nhân danh Đức Chúa Trời, giương cao ngọn cờ.","poem":2},{"lineBreak":true},{"text":"Xin Ngài đáp ứng mọi lời người cầu nguyện.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Giờ con biết Chúa Hằng Hữu cứu người được chọn.","poem":1},{"noteId":12},{"text":"Từ trời cao, Ngài đáp lời người cầu xin","poem":2},{"lineBreak":true},{"text":"người đắc thắng nhờ tay Chúa nâng đỡ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Người ta cậy binh xa, chiến mã","poem":1},{"text":"chúng con nhờ Danh Chúa Hằng Hữu, Đức Chúa Trời chúng con.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Thế nên, họ thất bại và tử trận","poem":1},{"text":"còn chúng con, vùng dậy, đứng vững vàng.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xin cứu vua chúng con, ôi Chúa Hằng Hữu!","poem":1},{"text":"Xin đáp lời khi chúng con khẩn cầu.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Nt người được xức dầu","reference":{"chapter":20,"verse":6}}]},"thisChapterLink":"/api/vie_vcb/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}