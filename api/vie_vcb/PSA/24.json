o mật thiết với Đức Chúa Trời, Đấng cứu rỗi mình.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Đó là dòng dõi của người tìm kiếm Chúa,","poem":1},{"text":"chiêm ngưỡng Thiên nhan, lạy Đức Chúa Trời của Gia-cốp.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hỡi các cửa hãy ngước đầu lên!","poem":1},{"text":"Hỡi các cánh cổng xưa hãy tung mở,","poem":2},{"lineBreak":true},{"text":"để Vua Vinh Quang vào.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vua Vinh Quang là ai?","poem":1},{"text":"Là Chúa Hằng Hữu đầy sức mạnh và quyền năng;","poem":2},{"lineBreak":true},{"text":"Chúa Hằng Hữu vô địch trong chiến trận.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hỡi các cửa hãy ngước đầu lên!","poem":1},{"text":"Hỡi các cánh cổng xưa hãy tung mở,","poem":2},{"lineBreak":true},{"text":"để Vua Vinh Quang vào.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vua Vinh Quang là ai?","poem":1},{"text":"Là Chúa Hằng Hữu Vạn Quân—","poem":2},{"lineBreak":true},{"text":"Ngài là Vua Vinh Quang.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}