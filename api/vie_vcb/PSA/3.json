{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Lời Cầu Nguyện Buổi Sáng"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít khi đi trốn Áp-sa-lôm, con trai mình)"]},{"type":"verse","number":1,"content":[{"text":"Ôi Chúa Hằng Hữu, sao kẻ thù con vô số;","poem":1},{"text":"biết bao người nổi dậy chống con.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Họ cầu mong rằng:","poem":1},{"text":"“Đức Chúa Trời sẽ không bao giờ giải cứu nó!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nhưng, lạy Chúa Hằng Hữu, Ngài là khiên thuẫn chở che con,","poem":1},{"text":"Ngài là vinh quang con, Đấng cho con ngước đầu lên.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tôi lớn tiếng kêu cầu cùng Chúa Hằng Hữu,","poem":1},{"text":"Ngài đáp lời tôi từ núi thánh Ngài.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tôi nằm xuống và ngủ yên giấc,","poem":1},{"text":"rồi thức giấc trong an toàn,","poem":2},{"lineBreak":true},{"text":"vì Chúa Hằng Hữu đỡ nâng tôi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tôi chẳng sợ sệt, kinh hoàng,","poem":1},{"text":"dù vạn người vây hãm chung quanh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chúa Hằng Hữu ôi, xin xuất hiện!","poem":1},{"text":"Xin giải cứu tôi, lạy Đức Chúa Trời tôi!","poem":2},{"text":"Xin vả mặt đoàn quân thù nghịch!","poem":1},{"text":"Xin bẻ nanh vuốt phường ác gian!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chiến thắng đến từ Ngài, lạy Chúa Hằng Hữu.","poem":1},{"text":"Xin ban phước trên con dân Ngài.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}