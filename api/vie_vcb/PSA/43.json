{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Cầu Xin Chúa Giải Cứu"]},{"type":"verse","number":1,"content":[{"text":"Lạy Đức Chúa Trời! Xin xét xử cho con.","poem":1},{"text":"Xin biện hộ cho con chống lại dân vô đạo.","poem":2},{"lineBreak":true},{"text":"Xin giải cứu con khỏi người lừa đảo xấu xa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vì Ngài là Đức Chúa Trời, là đồn lũy kiên cố của con.","poem":1},{"text":"Sao nỡ khước từ con?","poem":2},{"text":"Sao con phải đau buồn","poem":1},{"text":"vì kẻ thù áp bức?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xin chiếu rọi thần quang chân lý;","poem":1},{"text":"để soi đường dẫn lối cho con.","poem":2},{"text":"Xin dìu dắt con lên núi thánh,","poem":1},{"text":"đến nơi Ngài ngự.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Con sẽ vào trước bàn thờ Đức Chúa Trời,","poem":1},{"text":"đến với Đức Chúa Trời—là niềm vui và hạnh phúc của con.","poem":2},{"text":"Con sẽ ca ngợi Chúa bằng tiếng hạc cầm.","poem":1},{"text":"Ôi lạy Đức Chúa Trời, Đức Chúa Trời của con!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hồn ta hỡi, sao còn buồn bã?","poem":1},{"text":"Sao vẫn còn bối rối trong ta?","poem":2},{"text":"Ta sẽ đặt hy vọng nơi Đức Chúa Trời!","poem":1},{"text":"Ta sẽ còn ngợi tôn Chúa—","poem":2},{"lineBreak":true},{"text":"Đấng Cứu Rỗi và Đức Chúa Trời của ta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}