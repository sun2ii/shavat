{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Xin Chúa Bênh Vực"]},{"type":"hebrew_subtitle","content":["(Giáo huấn ca của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây, khi người Xíp đến báo Sau-lơ: “Đa-vít đang trốn trong xứ chúng tôi”)"]},{"type":"verse","number":1,"content":[{"text":"Lạy Đức Chúa Trời, xin cứu con vì Danh Chúa!","poem":1},{"text":"Xin bảo vệ","poem":2},{"noteId":49},{"text":"con với sức mạnh toàn năng.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lạy Đức Chúa Trời, xin nghe lời con khẩn nguyện.","poem":1},{"text":"Xin lắng tai nghe lời kêu cầu của con.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Người xa lạ nổi lên chống đối;","poem":1},{"text":"bọn bạo tàn tìm hại sinh mạng con.","poem":2},{"lineBreak":true},{"text":"Họ chẳng lưu tâm đến Đức Chúa Trời.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nhưng Đức Chúa Trời là Đấng cứu giúp con.","poem":1},{"text":"Chúa nâng đỡ nuôi dưỡng hồn con!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Theo đức thành tín, xin Ngài tiêu diệt.","poem":1},{"text":"Báo trả công minh những kẻ ác thù.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Con tự nguyện dâng lên Ngài tế lễ;","poem":1},{"text":"con sẽ luôn ca tụng Danh Ngài, lạy Chúa Hằng Hữu,","poem":2},{"lineBreak":true},{"text":"vì Danh Chúa thật tốt lành, đẹp đẽ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chúa giải cứu con khỏi hết gian truân,","poem":1},{"text":"trong khi con chứng kiến kẻ thù thất bại.","poem":2}]}],"footnotes":[{"noteId":49,"caller":"+","text":"Nt xét xử","reference":{"chapter":54,"verse":1}}]},"thisChapterLink":"/api/vie_vcb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}