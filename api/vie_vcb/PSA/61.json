{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Tin Cậy Chúa Phù Hộ"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít, soạn cho nhạc trưởng, dùng đàn dây)"]},{"type":"verse","number":1,"content":[{"text":"Lạy Đức Chúa Trời, xin nghe con cầu khẩn!","poem":1},{"text":"Xin lắng nghe tiếng con kêu nài!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Từ tận cùng trái đất,","poem":1},{"text":"con van xin, khẩn nguyện,","poem":2},{"lineBreak":true},{"text":"khi con khốn cùng tan nát cõi lòng.","poem":2},{"noteId":67},{"lineBreak":true},{"text":"Xin cho con tựa vầng đá muôn đời.","poem":2},{"noteId":68}]},{"type":"verse","number":3,"content":[{"text":"Chúa vốn là nơi con trú ẩn,","poem":1},{"text":"là tháp kiên cố náu nương, khỏi quân thù.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xin cho con được sống mãi trong nơi thánh Ngài,","poem":1},{"text":"đời đời nương náu dưới cánh Ngài!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vì Ngài nghe con cầu khẩn, lạy Đức Chúa Trời.","poem":1},{"text":"Chúa cho con chung cơ nghiệp với người kính sợ Danh Chúa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chúa cho vua được trường thọ!","poem":1},{"text":"Nguyện vua mãi trị vì đời nọ đời kia!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Trước mặt Đức Chúa Trời, người được sống mãi.","poem":1},{"text":"Xin chân lý, nhân từ bảo vệ vua.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mãi mãi con sẽ ca ngợi Danh Ngài,","poem":1},{"text":"giữ trọn lời khấn hứa ngày đêm.","poem":2}]}],"footnotes":[{"noteId":67,"caller":"+","text":"Nt lòng con yếu đuối","reference":{"chapter":61,"verse":2}},{"noteId":68,"caller":"+","text":"Ctd xin đưa con đến tảng đá cao hơn con","reference":{"chapter":61,"verse":2}}]},"thisChapterLink":"/api/vie_vcb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}