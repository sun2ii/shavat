{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["Xin Cứu Khỏi Âm Mưu Kẻ Thù"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít, soạn cho nhạc trưởng)"]},{"type":"verse","number":1,"content":[{"text":"Lạy Đức Chúa Trời, xin lắng tai nghe tiếng con than thở.","poem":1},{"text":"Bảo vệ mạng sống con khỏi quân thù đe dọa.","poem":2},{"noteId":74}]},{"type":"verse","number":2,"content":[{"text":"Xin che giấu con khi người ác mật bàn,","poem":1},{"text":"khi bọn gian tà nổi loạn trong cuồng nộ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Họ mài lưỡi sắc như gươm,","poem":1},{"text":"tung lời nói như bắn cung tên.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bắn lén người vô tội,","poem":1},{"noteId":75},{"text":"không ngại ngùng, bất chợt nhả tên.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chúng ngoan cố theo đuổi điều ác độc,","poem":1},{"text":"bàn mưu đặt bẫy cách âm thầm.","poem":2},{"lineBreak":true},{"text":"Tưởng rằng: “Chẳng ai biết được.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ai dò được tội ác ta làm.","poem":1},{"text":"Ta hoạch định mưu kế thần sầu.”","poem":2},{"lineBreak":true},{"text":"Tâm trí con người thật hiểm sâu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nhưng Chúa sẽ giương cung bắn trúng,","poem":1},{"text":"họ bị thương, ngã xuống bất ngờ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lưỡi họ gây họa cho họ,","poem":1},{"text":"ai thấy họ cũng đều lắc đầu chạy trốn.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mọi người sẽ kinh hoàng, thuật lại,","poem":1},{"text":"các công tác Đức Chúa Trời vừa thực hiện,","poem":2},{"lineBreak":true},{"text":"suy tư, tìm hiểu việc Ngài làm.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Người công chính sẽ vui mừng trong Chúa Hằng Hữu,","poem":1},{"text":"và ẩn náu trong Ngài.","poem":2},{"text":"Người có lòng ngay thẳng","poem":1},{"text":"sẽ ca ngợi Ngài.","poem":2}]}],"footnotes":[{"noteId":74,"caller":"+","text":"Ctd giữ mạng sống con khỏi sự sợ hãi quân thù","reference":{"chapter":64,"verse":1}},{"noteId":75,"caller":"+","text":"Ctd người trọn vẹn","reference":{"chapter":64,"verse":4}}]},"thisChapterLink":"/api/vie_vcb/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}