{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Kêu Gọi Các Dân Tộc Ca Ngợi Chúa"]},{"type":"hebrew_subtitle","content":["(Thơ soạn cho nhạc trưởng, dùng đàn dây)"]},{"type":"verse","number":1,"content":[{"text":"Nguyện Đức Chúa Trời thương xót và ban phước.","poem":1},{"text":"Xin Thiên nhan rạng rỡ trên chúng con.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nguyện đường lối Chúa được khai mở trên đất,","poem":1},{"text":"và ơn cứu rỗi nhiều người biết đến.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nguyện các dân tộc ca ngợi Chúa, lạy Đức Chúa Trời.","poem":1},{"text":"Toàn thể nhân loại tôn vinh Ngài.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nguyện các nước mừng vui ca hát,","poem":1},{"text":"vì Chúa xét xử công bằng cho dân,","poem":2},{"lineBreak":true},{"text":"và chỉ đạo mọi dân tộc trên đất.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nguyện các dân tộc ca ngợi Chúa, lạy Đức Chúa Trời.","poem":1},{"text":"Phải, toàn thể nhân loại tôn vinh Ngài.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khi ấy, đất sẽ gia tăng hoa lợi,","poem":1},{"text":"và Đức Chúa Trời là Đức Chúa Trời chúng con, sẽ ban phước lành.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Phải, Đức Chúa Trời sẽ ban phước cho chúng con,","poem":1},{"text":"và khắp đất loài người sẽ kính sợ Chúa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}