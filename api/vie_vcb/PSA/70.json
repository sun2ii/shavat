{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Xin Cứu Giúp Khỏi Bị Hà Hiếp và Sỉ Nhục"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít, soạn cho nhạc trưởng, lời cầu nguyện trong dịp Tế Lễ Kỷ Niệm)"]},{"type":"verse","number":1,"content":[{"text":"Lạy Đức Chúa Trời, xin giải cứu con!","poem":1},{"text":"Lạy Chúa Hằng Hữu, xin nhanh chóng phù hộ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nguyện những người tìm hại mạng sống con","poem":1},{"text":"đều bị hổ nhục.","poem":2},{"text":"Nguyện những người muốn thấy con bị tàn hại,","poem":1},{"text":"phải rút lui và nhục nhã.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nguyện những người cười nhạo con phải hổ thẹn,","poem":1},{"text":"vì họ đã nói: “A ha! Chúng ta đã bắt được hắn rồi!”","poem":2},{"noteId":90}]},{"type":"verse","number":4,"content":[{"text":"Nguyện tất cả những ai tìm Chúa,","poem":1},{"text":"đều hân hoan sung sướng trong Ngài.","poem":2},{"text":"Nguyện những ai yêu mến ân cứu độ,","poem":1},{"text":"mãi mãi tụng ca: “Đức Chúa Trời thật vĩ đại!”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhưng con cùng túng, nghèo khổ,","poem":1},{"text":"xin nhanh chóng đưa tay giải cứu, lạy Đức Chúa Trời.","poem":2},{"text":"Ngài là Đấng giúp đỡ và Đấng giải cứu con;","poem":1},{"text":"lạy Chúa Hằng Hữu, xin Ngài đừng chậm trễ.","poem":2}]}],"footnotes":[{"noteId":90,"caller":"+","text":"Ctd bị đẩy lùi","reference":{"chapter":70,"verse":3}}]},"thisChapterLink":"/api/vie_vcb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}