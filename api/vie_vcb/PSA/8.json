{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Vinh Quang của Chúa và Giá Trị của Con Người"]},{"type":"hebrew_subtitle","content":["(Thơ của Đa-vít, soạn cho nhạc trưởng, theo điệu Gít-ti)"]},{"type":"verse","number":1,"content":[{"text":"Lạy Chúa Hằng Hữu, Chúa của chúng con, uy danh Chúa vang lừng khắp đất!","poem":1},{"text":"Vinh quang Ngài chiếu rạng trời cao.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Từ môi miệng trẻ thơ và hài nhi,","poem":1},{"text":"Chúa đã đặt vào lời ca ngợi,","poem":2},{"lineBreak":true},{"text":"khiến quân thù câm nín.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Khi con nhìn bầu trời lúc đêm và thấy các công trình của ngón tay Chúa—","poem":1},{"text":"mặt trăng và các tinh tú mà Chúa sáng tạo—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"con không thể nào hiểu thấu,","poem":1},{"text":"con loài người là chi mà Chúa phải nhọc lòng?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chúa tạo người chỉ kém Đức Chúa Trời một chút,","poem":1},{"text":"đội lên đầu danh dự và vinh quang.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Cho người cai quản toàn vũ trụ,","poem":1},{"text":"khiến muôn loài đều phải phục tùng—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"gia súc và bầy vật","poem":1},{"text":"cùng tất cả thú rừng,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"đến các loại chim trên trời, cá dưới biển,","poem":1},{"text":"và mọi sinh vật dưới đại dương.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lạy Chúa Hằng Hữu, Chúa chúng con, uy danh Chúa vang lừng khắp đất!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}