{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Nghiêm Trách Quan Án Bất Công"]},{"type":"hebrew_subtitle","content":["(Thơ của A-sáp)"]},{"type":"verse","number":1,"content":[{"text":"Đức Chúa Trời chủ trì trong hội đồng của Ngài;","poem":1},{"text":"Ngài tuyên phán trên thiên đàng:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Các ngươi phân xử bất công","poem":1},{"text":"và thiên vị người gian tà mãi đến bao giờ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hãy xử công minh cho những người cô thế và trẻ mồ côi;","poem":1},{"text":"bảo vệ quyền lợi người bị áp bức và tuyệt vọng.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Giải cứu người nghèo khổ và khốn cùng;","poem":1},{"text":"đưa họ ra khỏi tay người ác.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhưng bọn áp bức không biết gì,","poem":1},{"text":"cũng chẳng hiểu gì!","poem":2},{"text":"Chúng cứ mò mẫm trong bóng tối,","poem":1},{"text":"tất cả nền móng trên đất đều rúng động.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta xác nhận: ‘Các ngươi là thần;","poem":1},{"text":"Tất cả đều là con trai của Đấng Chí Cao.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nhưng các ngươi sẽ chết như người phàm,","poem":1},{"text":"và ngã xuống như những người cầm quyền khác.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lạy Đức Chúa Trời, xin vùng dậy xét xử thế gian,","poem":1},{"text":"vì tất cả các dân tộc đều thuộc về Chúa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}