{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["Đặc Ân của Cư Dân Si-ôn"]},{"type":"hebrew_subtitle","content":["(Thơ của con cháu Cô-ra)"]},{"type":"verse","number":1,"content":[{"text":"Chúa Hằng Hữu xây nền móng Ngài","poem":1},{"text":"trên núi thánh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chúa mến chuộng thành Si-ôn,","poem":1},{"text":"hơn bất cứ thành nào của Gia-cốp.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ôi thành trì của Đức Chúa Trời","poem":1},{"text":"vinh quang thành Chúa được đề cao!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ta sẽ nói đến Ra-háp và Ba-by-lôn là những nơi biết Ta—","poem":1},{"text":"Phi-li-tin, Ty-rơ, và ngay cả Ê-thi-ô-pi xa xôi.","poem":2},{"lineBreak":true},{"text":"Tất cả họ sẽ trở nên công dân của Giê-ru-sa-lem!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Phải người ta sẽ nói về Si-ôn rằng:","poem":1},{"text":"“Người này