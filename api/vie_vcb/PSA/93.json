{"translation":{"id":"vie_vcb","name":"Biblica® Thiên Ban Kinh Thánh Hiện Đại™","website":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=vieovcb","licenseNotes":null,"shortName":"VCB","englishName":"Vietnamese Contemporary Bible","language":"vie","textDirection":"ltr","sha256":"2546c4b30401304ec7a8792c75439c207e4d4741ea1c7052720a82387bd86026","availableFormats":["json"],"listOfBooksApiLink":"/api/vie_vcb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31096,"languageName":"Tiếng Việt","languageEnglishName":"Vietnamese"},"book":{"id":"PSA","translationId":"vie_vcb","name":"Thi Thiên","commonName":"Thi Thiên","title":"Thi Thiên","order":19,"numberOfChapters":150,"sha256":"1ba374750e53f214fd2cb7c105fae664e9e57803d3803d2a951580909bfe56fb","firstChapterNumber":1,"firstChapterApiLink":"/api/vie_vcb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/vie_vcb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["Oai Nghi của Chúa"]},{"type":"verse","number":1,"content":[{"text":"Chúa Hằng Hữu là Vua! Ngài mặc vẻ uy nghiêm.","poem":1},{"text":"Chúa Hằng Hữu khoác áo bào, sức mạnh uy nghi.","poem":2},{"text":"Thế giới luôn bền vững,","poem":1},{"text":"và không hề lay chuyển.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Từ sáng thế, ngôi Chúa vững lập, lạy Chúa Hằng Hữu.","poem":1},{"text":"Ngài hiện hữu từ trước vô cùng.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lạy Chúa Hằng Hữu, sóng biển dâng tràn.","poem":1},{"text":"Từ vực thẳm, đại dương gào thét như sấm;","poem":2},{"lineBreak":true},{"text":"tiếng sóng thần ồ ạt dâng lên.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Chúa Hằng Hữu tể trị trên các tầng trời,","poem":1},{"text":"tiếng Ngài đánh bạt tiếng sóng gầm,","poem":2},{"lineBreak":true},{"text":"trấn át tiếng ầm ầm đại dương.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lạy Chúa Hằng Hữu, luật pháp Chúa không hề dời đổi.","poem":1},{"text":"Vương quyền Ngài, lạy Chúa Hằng Hữu, là thánh mãi đến đời đời.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/vie_vcb/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/vie_vcb/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/vie_vcb/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}