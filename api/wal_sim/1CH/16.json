{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"1CH","translationId":"wal_sim","name":"Hanidabaa Odiya Koiro Maxaafaa","commonName":"Hanidabaa Odiya Koiro Maxaafaa","title":"Hanidabaa Odiya Koiro Maxaafaa","order":13,"numberOfChapters":29,"sha256":"d99a2bc0efffc591fa985d93c487c51d494ba61800a9132f0af46f58a7d20d81","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/wal_sim/1CH/29.json","totalNumberOfVerses":931},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Eti Xoossaa Taabootaa ehiidi, Daawiti Taabootaa wottanau tolido dunkkaaniyaa giddon wottidosona. Wottidi xuuggiyo yarshshuwaanne issippetettaa yarshshuwaa Xoossaayyo yarshshidosona."]},{"type":"verse","number":2,"content":["Daawiti xuuggiyo yarshshuwaanne issippetettaa yarshshuwaa yarshshidi polidoogaappe guyyiyan, GODAA sunttan asaa anjjiis."]},{"type":"verse","number":3,"content":["Israa7eela asau ubbau, maccaunne attumau, huuphiyan huuphiyan issi issi komppo oittaa, issi issi muxo ashuwaanne woiniyaa teeraa melaappe issi issi lichchakkuwaa gishiis."]},{"type":"verse","number":4,"content":["GODAA Taabootaa sinttan oottanaadaaninne GODAA Israa7eela Xoossaa sabbanaadan, galatanaadaaninne bonchchanaadan, amarida Leewata Daawiti sunttiis."]},{"type":"verse","number":5,"content":["Leewatu halaqai Asaafa; Asaafa kaallidi naa77antto halaqai Zakkaariyaasa. Zakkaariyaasa kaallidi de7iyaageeti Yi7i7eela, SHamiraamoota, Yihi7eela, Matiitiyaa, Eli7aaba, Banaayanne Obeedi-Eedooma. Eti maazinqqiyaanne diittaa diixxanau sunttettidosona; shin Asaafi daalaa qaattanau sunttettiis."]},{"type":"verse","number":6,"content":["Qeesiyaa Banaayinne Yahaazi7eeli Xoossaa Maachchaa Taabootaa sinttan ubba wode xurumbbaa punnanau sunttettidosona."]},{"type":"verse","number":7,"content":["He gallassi Daawiti kasetidi, Asaafinne a dabboti GODAA sabbanaadan azaziis."]},{"type":"heading","content":["Galata Mazamuriyaa"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"GODAA galatite; a sunttaa xeesite.","poem":1},{"text":"I oottidobaa kawotettatu gidduwan erissite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"A sabbite; galata yettaa au yexxite.","poem":1},{"text":"A maalaalissiya oosuwaa ubbaa yootite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"A geeshsha sunttan ceeqettite;","poem":1},{"text":"GODAA koyiyaageetu wozanati ufaittona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAANNE a wolqqaa xomoosite;","poem":1},{"text":"ubbatoo a sinttaa koyite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inttenoo,","poem":1},{"lineBreak":true},{"text":"a ashkkaraa Abrahaama zerettatoo,","poem":1},{"lineBreak":true},{"text":"doorettida Yaaqooba naatoo,","poem":1},{"text":"i oottido maalaalissiyaabaa,","poem":2},{"lineBreak":true},{"text":"a malaataanne i pirddido pirddaa hassayite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"I GODAA nu Xoossaa;","poem":1},{"text":"a pirddaikka sa7aa ubbaa bollaana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I ba maachchaa merinaassi,","poem":1},{"lineBreak":true},{"text":"ba azazido qaalaa","poem":1},{"text":"sha7u yeletaa gakkanaassi naagees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hegeenne,","poem":1},{"lineBreak":true},{"text":"i Abrahaamaara maacettido maachchaa,","poem":1},{"text":"Yisaaqassi caaqqido maachchaa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaaqoobassi woga,","poem":1},{"lineBreak":true},{"text":"Israa7eelassikka merinaa maachcha","poem":1},{"lineBreak":true},{"text":"oottidi minttidoogaa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hagaadan yaagiis;","poem":1},{"lineBreak":true},{"text":"“Neeyyo Kanaane biittaa immana;","poem":1},{"text":"i ne zerettatuyyo laata gidana” yaagiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xoossaa asati qoodan qii guuttanne","poem":1},{"text":"Kanaane biittan bete gididi de7iyo wode,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"issi deriyaappe hara deriyaa,","poem":1},{"text":"issi kawotettaappe hara kawotettaa yuuyidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xoossai eta ooninne naaqqanau immibeenna;","poem":1},{"text":"eta gishshau kawota seeriiddi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Taani tiyidoogeeta bochchoppite;","poem":1},{"lineBreak":true},{"text":"ta hananabaa yootiyaageeta qohoppite” yaagiis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sa7an de7iya asau, ubbaikka GODAASSI yexxite;","poem":1},{"text":"i ashshiyo mishiraachchuwaa hachchi hachchi yootite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kawotettatu giddon a bonchchuwaabaa,","poem":1},{"text":"asaa ubbaa giddon a maalaalissiya oosuwaabaa awaajjite.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Aissi giikko, GODAI gita;","poem":1},{"lineBreak":true},{"text":"aaro galatai ayyo bessees.","poem":1},{"text":"Xoossatu ubbaappe aadhdhidi, i yayettanau bessees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hara asaa xoossati ubbai eeqata;","poem":1},{"text":"shin GODAI salota medhdhida Xoossaa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bonchchoinne anggai a yuushuwan de7ees;","poem":1},{"text":"minotettainne ufaissai a Beeta Maqidasiyan de7ees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Inttenoo, asa zaretoo ubbau,","poem":2},{"text":"GODAABAA yootite;","poem":1},{"lineBreak":true},{"text":"“Bonchchoinne wolqqai GODAABAA” giidi yootite.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"“Bonchchoi a sunttaassa” giidi","poem":1},{"lineBreak":true},{"text":"GODAABAA yootite.","poem":1},{"lineBreak":true},{"text":"Yarshshuwaa ekkidi, a sintti yiite.","poem":1},{"text":"A geeshshatettaa puulan GODAAYYO goinnite.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Biittan de7iya asau ubbau, a sinttan kokkorite.","poem":1},{"text":"Sa7ai minni eqqiis; mulekka qaaxxenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Saloti ufaittona; sa7aikka hashshu go!","poem":1},{"lineBreak":true},{"text":"Kawotettatu giddon eti, “GODAI kawotiis!” yaagona.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Abbainne a giddon kumidabati guummona.","poem":1},{"text":"SHooqainne shooqan de7iyaabati ubbati ufaittona.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hegaappe guyyiyan woran de7iya mitta ubbai","poem":1},{"lineBreak":true},{"text":"ufaissan GODAA sinttan yexxana.","poem":1},{"text":"Aissi giikko, i sa7aa bollan pirddanau yees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"GODAI keha gidiyo gishshaunne","poem":1},{"lineBreak":true},{"text":"aggenna a siiqoi merinaagaa gidiyo gishshau,","poem":1},{"text":"GODAA galatite.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hegaappe guyyiyan intte,","poem":1},{"text":"“Abeet nuna ashshiya Xoossau, nuna ashsha.","poem":2},{"text":"Nuuni ne geeshsha sunttaa galatanaadaaninne","poem":1},{"lineBreak":true},{"text":"ne bonchchuwan ceeqettanaadan,","poem":1},{"text":"kawotettatu giddoppe shiishshada ashsha” yaagite.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"GODAI Israa7eela Xoossai","poem":1},{"text":"merinaappe merinaa gakkanaayyo galatetto!","poem":2},"Hegaappe guyyiyan asai ubbai, “Amin77i” giidi, GODAA galatiis."]},{"type":"heading","content":["Yerusalaameeninne Gabaa7oonan Hanida Goinuwaa Maaraa"]},{"type":"verse","number":37,"content":["GODAA Maachchaa Taabootaa sinttan hachchi hachchi goinuwaassi koshshiyaabaa ubba wode eti oottanaadan, Daawiti Asaafanne a dabbota wottiis."]},{"type":"verse","number":38,"content":["I qassi Obeedi-Eedoomanne a dabbota usuppun tammanne hosppunata etaara oottanaadan wottiis; Yidutuuna na7aa Obeedi-Eedoomanne Hoosa penggiyaa naaganaadan wottiis."]},{"type":"verse","number":39,"content":["Qeesee Xaadooqinne aara oottiya qeeseti Gabaa7oonan de7iya xoqqa sohuwan, Dunkkaaniyaa sinttan oottanaadan yan attidosona."]},{"type":"verse","number":40,"content":["GODAI Israa7eelayyo immido higgiyan xaafettidoogaadan, eti maalladonne omarssi ubba wode xuuggiyo yarshshuwaa yarshshiyoosan yarshshoosona."]},{"type":"verse","number":41,"content":["Aggenna a siiqoi merinaagaa gidiyo gishshau, GODAA yettan galatanaadan Hemaana, Yidutuunanne doorettida haraata Daawiti etaara issippe wottiis."]},{"type":"verse","number":42,"content":["Hemaaninne Yidutuuni xurumbbaa punnoosona, daalaa qaattoosonanne galataa mazamuriyaa yexxiiddi kaa7iyo hara miishshata kaa7oosona. Yidutuuna attuma naati penggiyaa naaganau sunttettidosona."]},{"type":"verse","number":43,"content":["Hegaappe guyyiyan, asai ubbai ba soo ba soo biis. Daawitikka ba so asaa anjjanau simmiis."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":42}