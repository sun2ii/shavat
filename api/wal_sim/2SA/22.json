{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"2SA","translationId":"wal_sim","name":"Sameela Maxaafaa Naa77anttuwaa","commonName":"Sameela Maxaafaa Naa77anttuwaa","title":"Sameela Maxaafaa Naa77anttuwaa","order":10,"numberOfChapters":24,"sha256":"a35351d8320231c4858b6de73926b5bb2e6aab3cdcacd5de0d6386b1631d3c8d","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/wal_sim/2SA/24.json","totalNumberOfVerses":692},"chapter":{"number":22,"content":[{"type":"heading","content":["Daawiti Xoonidi Simmiiddi Yexxido Mazamuriyaa"]},{"type":"verse","number":1,"content":["GODAI a morkketu ubbaa kushiyaappenne Saa7oola kushiyaappe ashshido gallassi Daawiti GODAASSI ha yettaa yexxiis."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“GODAI tau wogga zaallaa;","poem":1},{"lineBreak":true},{"text":"taani olaappe naagettiyo miixaa;","poem":1},{"text":"i tana ashshiyaagaa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta Xoossai taani akko baqatiyo ta wogga zaallaa.","poem":1},{"lineBreak":true},{"text":"I ta gonddalliyaa;","poem":1},{"text":"i tana ashshiya wolqqaamaa.","poem":2},{"text":"I taani qosetta attiyo soho;","poem":1},{"text":"i tana makkalanchcha asatuppe ashshees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Galatai bessiyo GODAA taani xeesais;","poem":1},{"text":"i ta morkketuppe tana ashshees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Haiquwaa beetai ta heeran sirimettees;","poem":1},{"text":"bashshai di7odan tana muukkiis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Duufuwaa wodoroi tana qachchana hanees;","poem":1},{"text":"haiqoi piredan tana oiqqiis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tana metoi iissin GODAA xeesaas;","poem":1},{"text":"‘Tana maadda’ gaada ta Xoossaayyo waassaas.","poem":2},{"text":"I ba Beeta Maqidasiyan ta cenggurssaa siyiis;","poem":1},{"text":"taani waassido waasoi a haittan wodhdhiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Wodhdhin Xoossai hanqqettido gishshau,","poem":1},{"lineBreak":true},{"text":"biittai yaaqiyaaqidi qaaxxiis;","poem":1},{"text":"deretu xaphoi gajigajidi kokkoriis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"A siiriyaappe hanqquwaa cuwai cuwattiis;","poem":1},{"text":"a doonaappe miya tamaa lacoinne xuuggiya bonqqoi kiyiis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saluwaa i phalqqidi,","poem":1},{"text":"duge wodhdhiis.","poem":2},{"text":"He wode a gediyaappe garssaara sikkida shaarai de7ees.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Qefiyaara de7iya kiitanchchatun, kiruubetun uttidi paalliis;","poem":1},{"text":"carkkuwaa qefiyaa bollan beettiis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bana xuman kammiis;","poem":1},{"text":"a dunkkaanee iraara sikkida shaaraa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A sinttan de7iya gita poo7uwaappe","poem":1},{"text":"tamaa lacoi kiyiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Qassi GODAI dadaadan","poem":1},{"text":"saluwaappe guummiis.","poem":2},{"text":"Ubbaappe Xoqqiya Xoossai ba cenggurssaa sissiis.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ba wonddafiyaa zubbiyaa yeddidi,","poem":1},{"text":"ba morkketa laaliis.","poem":2},{"text":"Wolqqanttaa poo7uwaa kiittidi,","poem":1},{"text":"eta yedettiis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"GODAI seerido wodenne","poem":1},{"lineBreak":true},{"text":"hanqqettidi peenuqido wode,","poem":1},{"text":"abbaa haattai zin77ido biittai beettiis.","poem":2},{"text":"Qassi sa7aa baasoikka qoncciis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“GODAI bollappe kushiyaa duge yeddidi, tana oiqqiis;","poem":1},{"text":"ciimma haattaappe tana kessiis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I tana ta wolqqaama morkkiyaappenne","poem":1},{"lineBreak":true},{"text":"tana ixxiyaageetuppe ashshiis;","poem":1},{"text":"aissi giikko, eti taayyo keehi daro wolqqaama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta waayiyaa gallassi","poem":1},{"lineBreak":true},{"text":"eti ta bolli denddidosona;","poem":1},{"text":"shin GODAI tana zemppissiyaagaa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I tana aaho sohuwaa kessiis;","poem":1},{"text":"tanan ufaittido gishshau, tana ashshiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ta xillotettaadan GODAI tau qanxxiis;","poem":1},{"lineBreak":true},{"text":"ta kushiyaa geeshshatettaadan i tau zaariis.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Taani GODAA ogiyaa kaallaas;","poem":1},{"text":"taani ta Xoossaa aggada wora babeikke.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani a higgiyaa ubbaa naagaas;","poem":1},{"text":"a wogaa poliyoogaa aggabeikke.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Taani a sinttan suure de7aas;","poem":1},{"text":"taani tana nagarappe naagaas.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hegaa gishshau, GODAI tau","poem":1},{"text":"ta xillotettaadaaninne ta geeshshatettaadan zaariis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Abeet GODAU, ammanettiyaageetuyyo neeni ammanettiyaagaa;","poem":1},{"text":"suuretuyyo neenikka suure.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Geeshshatuyyo neenikka geeshsha;","poem":1},{"text":"shin geellatuyyo neeni cincca.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Banttana ziqqissiyaageeta ashshaasa;","poem":1},{"text":"shin banttana xoqqissiyaageeta ziqqissanau neeni eta xeellaasa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abeet GODAU, ta xomppee nena;","poem":1},{"text":"GODAI poo7issin, ta xumai kichchees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne maaduwan taani ta morkke olanchchatu bolli woraajjais;","poem":1},{"text":"ta Xoossan taani eta miixaa xeeraara guppa aadhdhais.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Xoossaa ogee suure.","poem":1},{"lineBreak":true},{"text":"GODAA qaalai ammanettiyaagaa.","poem":1},{"text":"Akko baqatiya ubbatussi i gonddalle.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"GODAAPPE attin, hara xoossi baawa;","poem":1},{"lineBreak":true},{"text":"nu Xoossaappe attin,","poem":1},{"text":"hara wogga zaalli baawa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Taayyo wolqqaa immiyaageenne","poem":1},{"lineBreak":true},{"text":"ta ogiyaa saro oottiyaagee","poem":1},{"text":"Xoossaattennee.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"I ta gediyaa","poem":1},{"text":"genessaa gediyaadan minttees.","poem":2},{"text":"Tana xoqqa sohotun sarotettan wottees.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"I ta kushiyaa olaa meezeyees;","poem":1},{"lineBreak":true},{"text":"hegaa gishshau, taani ta qesiyan","poem":1},{"text":"nahaasiyaa giyo birataa wonddafiyaa dafada dukkais.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"“Tana ashshiya ne gonddalliyaa","poem":1},{"lineBreak":true},{"text":"neeni taayyo immadasa;","poem":1},{"text":"ne lo77o ohettai tana gitayees.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Taani hemettiyoosaa aassaasa;","poem":1},{"text":"hegaa gishshau, ta tohoi harchchibeenna.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ta morkketa taani yedettada mentterettaas;","poem":1},{"lineBreak":true},{"text":"taani eta xaissennan de7aidda guyye simmabeikke.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Taani eta naa77antto denddennaadan shocaas;","poem":1},{"text":"eti ta tohuwan wullidosona.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Olau tana wolqqaa gixissadasa;","poem":1},{"text":"tanaara gaaddetiyaageeta taayyo gulbbatissadasa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ta morkketa ta sinttappe guyye baqatissadasa;","poem":1},{"text":"tana ixxiyaageeta taani xaissaas.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Banttana maaddiyaabaa koyidosona;","poem":1},{"text":"shin ooninne eta ashshibeenna.","poem":2},{"text":"GODAAKKA eti xeesidosona;","poem":1},{"text":"shin i etau koyibeenna.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Taani eta baanadan liiqissaas;","poem":1},{"text":"ogiyan de7iya urqqaadankka eta dirxxerettada yedhdhaas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“Ta asaa makkalaappe tana ashshadasa.","poem":1},{"lineBreak":true},{"text":"Kawotettatu bolli sunttada, tana naagadasa;","poem":1},{"text":"taani erenna asai tau haarettiis.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Allaga dere asaikka ta sinttan lahottees.","poem":1},{"lineBreak":true},{"text":"Eti ta woriyaa siyidi,","poem":1},{"text":"tau azazettoosona.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Eti wozanaa kahaa bayoosona.","poem":1},{"text":"Bantta naagettiyo miixaappe kokkoriiddi yoosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“GODAI de7ees! Xoossai,","poem":1},{"text":"ta wogga zaallai galatetto.","poem":2},{"text":"Xoossai, tana ashshiya zaallai,","poem":1},{"text":"xoqqu xoqqu go.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"I ta haluwaa kessiya Xoossaa;","poem":1},{"text":"kawotettata taappe garssaara wottiyaagaa.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Ta morkketuppe tana kessi ekkiyaagaa.","poem":1},{"lineBreak":true},{"text":"Abeet GODAU, neeni tanaara gaaddetiyaageetu bollan","poem":1},{"text":"tana xoqqu xoqqu oottaasa.","poem":2},{"text":"Makkalanchcha asatuppe neeni tana ashshaasa.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Hegaa gishshau, taani","poem":1},{"lineBreak":true},{"text":"nena kawotettatu giddon galatana;","poem":1},{"text":"taani ne sunttaakka sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Xoossai ba kawuwaassi","poem":1},{"text":"xoonuwaa bollan xoonuwaa immees.","poem":2},{"text":"Ba tiyidoogaassi, Daawitassinne a zerettaassi,","poem":1},{"text":"aggenna siiquwaa merinau bessees”","poem":2},"yaagidi yexxiis."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}