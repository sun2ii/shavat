{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"EXO","translationId":"wal_sim","name":"Kessaabaa","commonName":"Kessaabaa","title":"Kessaabaa","order":2,"numberOfChapters":40,"sha256":"9d97ce33d87fa2d18862c36eb3efd19f5afeb7570cd4e6c2279a1b45c2cd59a9","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/wal_sim/EXO/40.json","totalNumberOfVerses":1210},"chapter":{"number":15,"content":[{"type":"heading","content":["Muuse Mazamuriyaa"]},{"type":"verse","number":1,"content":["He wode Muuseenne Israa7eela asai ha mazamuriyaa GODAAYYO yexxidosona;",{"text":"“Bonchchuwan i keehi xoqqu xoqqu giido gishshau,","poem":1},{"text":"taani GODAAYYO mazamuriyaa yexxana.","poem":2},{"text":"Paraanne paraa toggidaagaa abban oliis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"GODAI ta wolqqaanne ta mazamuriyaa;","poem":1},{"text":"i tana ashshiyaagaa gidiis.","poem":2},{"text":"I ta Xoossaa;","poem":1},{"text":"taani a sabbana.","poem":2},{"text":"I ta aawaa Xoossaa;","poem":1},{"text":"taani a xoqqu xoqqu oottana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"GODAI olanchcha; a sunttaikka GODAA.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gibxxe kawuwaa para gaaretanne","poem":1},{"text":"a olanchchata abban oliis.","poem":2},{"text":"Gibxxe kawuwaa halaqati,","poem":1},{"text":"ubbaappe aadhdhi lo77iyaageeti Zo7o Abban muukettidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ciimma haattai eta kammiis;","poem":1},{"text":"eti shuchchadan ciimman mitettidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Abeet GODAU, ne ushachcha kushee","poem":1},{"text":"wolqqan goobidaagaa;","poem":2},{"text":"GODAU, ne ushachcha kushee","poem":1},{"text":"morkkiyaa mentterettiis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne bonchchuwaa gitatettan","poem":1},{"text":"nenaara gaaddetidaageeta oladasa.","poem":2},{"text":"Ne eexxiya hanqquwaa neeni yeddin,","poem":1},{"text":"i eta daladan miis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne siiriyaara kiyiya shemppuwan","poem":1},{"text":"haattai doorettiis.","poem":2},{"text":"Goggiya haattainne godadan minni eqqiis;","poem":1},{"text":"ciimma haattati abbaa gomppan irkkidi minnidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Morkkee ceeqettiiddi,","poem":1},{"lineBreak":true},{"text":"‘Taani eta yedettada oiqqana.","poem":1},{"lineBreak":true},{"text":"Taani eta aquwaa shaakkada,","poem":1},{"text":"ta koyidobaa ubbaa ekkana.","poem":2},{"text":"Taani ta bisuwaa shoddada,","poem":1},{"text":"eta xaissana’ yaagidi ceeqettiis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"SHin neeni eta","poem":1},{"lineBreak":true},{"text":"ne shemppuwan punnin,","poem":1},{"text":"abbai eta kammiis.","poem":2},{"text":"Eti wolqqaama haattan irssaasiyaa giyo biratai","poem":1},{"text":"mitettiyoogaadan mitettidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet GODAU, Xoossatu giddon","poem":1},{"text":"ne malai oonee?","poem":2},{"text":"Geeshshatettan bonchchettiyaabi,","poem":1},{"text":"bonchchuwan yayettiyaabi,","poem":2},{"lineBreak":true},{"text":"garamiyaabaa oottiyaabi ne malai oonee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni ne ushachcha kushiyaa miccin,","poem":1},{"text":"biittai eta mittiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Neeni wozido asaa","poem":1},{"text":"aggenna ne siiquwan kaalettana.","poem":2},{"text":"Neeni ne wolqqan","poem":1},{"text":"eta neeni de7iyo geeshsha sohuwaa gelissadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kawotettati hegaa siyidi","poem":1},{"text":"kokkoridosona.","poem":2},{"text":"Pilisxxeema biittaa asatikka","poem":1},{"text":"maareti oiqqidobaadan un77ettidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He wode Eedooma biittaa halaqati","poem":1},{"text":"dagammidosona.","poem":2},{"text":"Moo7aaba biittaa haariyaageeta","poem":1},{"text":"yashshai kokkorssiis.","poem":2},{"text":"Kanaane asati maashidosona.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dagamainne yashshai eta oiqqiis.","poem":1},{"lineBreak":true},{"text":"Abeet GODAU, eti ne wolqqaa gitatettaa be7idi,","poem":1},{"text":"ne asai aadhdhana gakkanaassi,","poem":2},{"lineBreak":true},{"text":"neeni wozido asai aadhdhana gakkanaassi,","poem":2},{"lineBreak":true},{"text":"shuchchadan tolettidi eqqidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neeni eta ehaada,","poem":1},{"text":"ne buzo gaden de7iya deriyaa huuphiyan tokkana.","poem":2},{"text":"Abeet Godau, he sohoi","poem":1},{"text":"neeni neeyyo de7anau oottido soho.","poem":2},{"text":"Abeet Godau, he geeshsha sohoi","poem":1},{"text":"neeni ne kushiyan minttada essido soho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"GODAI merinaappe merinau kawotana”","poem":1},{"text":"yaagidi yexxidosona.","poem":2}]},{"type":"heading","content":["Miiriyaami Mazamuriyaa"]},{"type":"verse","number":19,"content":["Gibxxe kawuwaa parati, a para gaaretinne a paraasati abban gelido wode, GODAI abbaa haattaa guyye zaaridi eta bolli ehiis; shin Israa7eelati abbaa gidduwaara mela biittaara hemettidi biidosona."]},{"type":"verse","number":20,"content":["Aaroona michchiyaa, hananabaa yootiya Miiriyaama karaabiyaa ekkaasu; maccaasai ubbai karaabiyaa baqqiiddinne yexxiiddi o kaallidosona."]},{"type":"verse","number":21,"content":["Miiriyaama etayyo mazamuriyaa yexxaidda,",{"text":"“GODAI keehi xoqqu xoqqu giido gishshau,","poem":1},{"text":"ayyo yexxite.","poem":2},{"text":"Paraanne paraa toggidaagaa","poem":1},{"text":"i abban oliis”","poem":2},{"lineBreak":true},{"text":"yaagada yexxaasu.","poem":2}]},{"type":"heading","content":["Cammiya Haattaa"]},{"type":"verse","number":22,"content":["Hegaappe guyyiyan Muusee Israa7eela Zo7o Abbaappe kaalettin, eti Suura giyo bazzuwaa biidosona. He bazzuwan eti haatta demmennan heezzu gallassaa hemettidosona."]},{"type":"verse","number":23,"content":["Eti Maara giyoosaa gakkido wode, Maara haattai camo gidido gishshau, uyana danddayibookkona; hegaa gishshau, he sohoi Maara geetettiis."]},{"type":"verse","number":24,"content":["Hegaa gishshau, asai, “Nuuni ai uyanee?” yaagidi Muuse bolli zuuzummiis."]},{"type":"verse","number":25,"content":["Zuuzummin Muusee GODAAYYO waassiis; waassin GODAI a issi mitta bessiis; Muusee he mittaa haatta giddo olin, haattai mal77iis. Yan GODAI etau awaajuwaanne higgiyaa kessiis; yan GODAI eta paacciis."]},{"type":"verse","number":26,"content":["I eta hagaadan yaagiis; “GODAI intte Xoossai odiyoobaa minttidi siyikkonne a aifiyaa sinttan likkebaa oottikko, intte a azazuwaa ezggikkonne a awaajuwaa ubbaa naagikko, taani Gibxxetu bolli ehiido harggiyaappe issuwaanne intte bolli ehiikke; aissi giikko, taani inttena pattiya GODAATTENNE” yaagiis."]},{"type":"verse","number":27,"content":["Hegaappe eti Elaama biitti yiidosona; yan tammanne naa77u haatta pulttotinne laappun tammu zambba mittati de7oosona. Eti yan haattaa doonan uttidosona."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}