{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"EZK","translationId":"wal_sim","name":"Hizqqeela","commonName":"Hizqqeela","title":"Hananabaa Yootiya Hizqqeela Maxaafaa","order":26,"numberOfChapters":48,"sha256":"6c2187e0c8aa287c66fa6f43c43746d55d38780829b79763d5bd02395ef676ec","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/wal_sim/EZK/48.json","totalNumberOfVerses":1263},"chapter":{"number":19,"content":[{"type":"heading","content":["Zilaassaa"]},{"type":"verse","number":1,"content":["GODAI Hizqqeela, “Israa7eela halaqatuyyo hagaadan yaagada zilaala;"]},{"type":"verse","number":2,"content":[{"text":"‘Intte aayyiyaa gaammotu giddon","poem":1},{"text":"a aiba gaammoo!","poem":2},{"text":"Yelaga gaammotu giddon gisada,","poem":1},{"text":"ba marata dichchaasu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A ba maratuppe issuwaa dichchin,","poem":1},{"text":"wodala gaammo kiyiis.","poem":2},{"text":"I shankkaa tamaaridi, asaa miis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kawotettati ubbai abaa siyidi,","poem":1},{"text":"ollan a gelissidi oiqqidosona.","poem":2},{"text":"Eti a hinggittan goochchidi,","poem":1},{"text":"Gibxxe biitti efiidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“‘A aayyiyaa naagoogee polettennan ixxin,","poem":1},{"lineBreak":true},{"text":"hidootai xayidoogaa be7ada,","poem":1},{"text":"ba maratuppe naa77anttuwaa dichchada,","poem":2},{"text":"wodala gaammo kessaasu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I wodala gaammo gididi,","poem":1},{"lineBreak":true},{"text":"hara gaammotu giddon","poem":1},{"text":"yaanne haanne simerettiis.","poem":2},{"text":"I shankkaa tamaaridi, asaa miis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I eta wolqqaama qatuwaa mentterettidi,","poem":1},{"text":"katamaakka bashshiis.","poem":2},{"text":"Biittainne biittan de7iya asai ubbai","poem":1},{"text":"a gudettan shabbirettiis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yuushuwan de7iya kawotettati ubbai","poem":1},{"text":"a oiqqanau piriyaa yeggidosona.","poem":2},{"text":"Bantta gitiyaakka miccidosona;","poem":1},{"text":"bantta ollan a oiqqidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eti bantta hinggittan a goochchidi,","poem":1},{"lineBreak":true},{"text":"koottadan giigida guutta keettan yeggidi,","poem":1},{"text":"Baabiloone kawuwaakko efiidosona.","poem":2},{"text":"Naa77antto a gudettai Israa7eela deretun siyettennaadan,","poem":1},{"text":"eti a qasho keettaa gelissidosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“‘Ne aayyiyaa haattaa doonan","poem":1},{"text":"tokettida woiniyaa turaa mala.","poem":2},{"text":"Daro haattai de7iyo gishshau,","poem":1},{"text":"he woiniyaa turai aifiyaa darxxaxxi uttiis;","poem":2},{"text":"qassi daro maratuura de7ees.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A maratuppe minniyaagee","poem":1},{"text":"haariyaageetu xam77aa gidiis.","poem":2},{"text":"A marai gita maratuppe aduqqidi,","poem":1},{"text":"bollau aadhdhiis.","poem":2},{"text":"Ba maratu coratettaaninne","poem":1},{"text":"xoqqatettan bollaara beettiis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"SHin he turai hanqquwan shodettidi,","poem":1},{"text":"biittan olettiis.","poem":2},{"text":"Arshsho carkkoi a aifiyaa melissiis;","poem":1},{"text":"a mino marai melin, tamai miis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ha77i qassi i haatti bainna","poem":1},{"text":"mela bazzuwan tokettiis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tamai a maratuppe issuwaa oiqqidi,","poem":1},{"text":"a aifiyaarakka dippi oottidi miis.","poem":2},{"text":"Yaatin, kawotaa xam77a gidiya","poem":1},{"text":"ai mino marikka a bollan attibeenna.","poem":2},"“‘Hagee yeeho zilaassa; hagaa zilaassadan go7ettanau bessees’ yaaga” yaagiis."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}