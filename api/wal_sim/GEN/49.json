{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"GEN","translationId":"wal_sim","name":"Doomettaabaa","commonName":"Doomettaabaa","title":"Doomettaabaa","order":1,"numberOfChapters":50,"sha256":"49de60f1d7e5323200fa155cd41f12c20bbf14a8f18ffe71480207198a3737aa","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/wal_sim/GEN/50.json","totalNumberOfVerses":1508},"chapter":{"number":49,"content":[{"type":"heading","content":["Yaaqoobi Ba Naata Anjjiis"]},{"type":"verse","number":1,"content":["Hegaappe guyyiyan, Yaaqoobi ba attuma naata xeesissidi hagaadan yaagiis; “Sinttappe intteyyo hananabaa taani intteyyo yootana mala shiiqite."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Inttenoo Yaaqooba naatoo,","poem":1},{"text":"issippe shiiqidi siyite;","poem":2},{"text":"intte aawai Israa7eeli intteyyo yootiyoobaa ezggite.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Roobeelaa, ta baira na7au,","poem":1},{"text":"neeni ta wolqqaa;","poem":2},{"lineBreak":true},{"text":"ta minotettaayyo koiruwaa.","poem":2},{"text":"Neeni bonchchuwankka wolqqankka ubbaappe aadhdhiyaagaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Neeni di7o mala; eqqosan de7akka;","poem":1},{"text":"neeni ubbaappe aadhdhiyaagaa gidakka.","poem":2},{"text":"Aissi giikko, neeni ne aawaa hiixaa kiyadasa;","poem":1},{"text":"ne awaa arssaa tunissadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Simooninne Leewi ishantta;","poem":1},{"text":"eta bisoi makkalatettau ola miishsha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani eta zoretan gelikke;","poem":1},{"text":"taani eta shiiquwankka uttikke.","poem":2},{"text":"Aissi giikko, eti bantta hanqquwan","poem":1},{"text":"asa woridosonanne banttana ekka ekka gin,","poem":2},{"lineBreak":true},{"text":"boorata gilddayidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eta suulo hanqqoinne","poem":1},{"text":"eta meqettaa iitatettai qanggettidaagaa gido!","poem":2},{"text":"Taani eta Yaaqooba asaa giddon laalana;","poem":1},{"text":"Israa7eela biittan piskki oottana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Yihudau, ne ishantti nena galatana.","poem":1},{"lineBreak":true},{"text":"Ne kushee ne morkketu piillanttiyaa oiqqana.","poem":1},{"text":"Ne aawaa naati neeyyo hokkidi ziggana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yihudau, neeni wodala gaammo.","poem":1},{"lineBreak":true},{"text":"Ta na7au, neeni shankkaappe woridi simmidi,","poem":1},{"text":"cogochchidi zin77ida gaammo mala.","poem":2},{"text":"Neeni asi bosherettanau koyenna macca gaammee mala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Haariyaagee yaana gakkanaashin,","poem":1},{"lineBreak":true},{"text":"kawotaa xam77ai Yihudaappe,","poem":1},{"text":"deriyaa haariyaageetu gatimai a toho giddoppe shaahettenna.","poem":2},{"text":"Qassi dere asai ayyo azazettana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I ba hariyaa woiniyaa anuwan,","poem":1},{"text":"ba hare maraa muruta woiniyaa turan qachchana.","poem":2},{"text":"I ba afalaa woiniyaa eessan,","poem":1},{"text":"ba maayuwaa suutta milatiya woiniyaa eessan meeccana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"A aifee woine eessaappe aadhdhi dulkkana;","poem":1},{"text":"a achchaikka maattaappe aadhdhi booxxana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Zaabiloonee abbaa doonan de7ana;","poem":1},{"text":"i abbaa doonan markkabeti eqqiyo soho gidana;","poem":2},{"text":"a zawai Sidoona gakkana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Yisaakoori mino hare;","poem":1},{"text":"caaniyo naa77u joinetuppe gidduwan zin77i bayees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I ba shemppiyoosai lo77o gidiyoogaanne","poem":1},{"text":"ba biittai ufaissiyaagaa gidiyoogaa be7iyo wode,","poem":2},{"lineBreak":true},{"text":"caanaa tookkanau ba hashiyaa ziqqi oottidi,","poem":2},{"lineBreak":true},{"text":"ailletettaa ooso oottana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Daani Israa7eela zaretuppe","poem":1},{"text":"issuwaa gidiya ba asaa bolli daannatana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Daani oge doonan de7iya shooshsha;","poem":1},{"lineBreak":true},{"text":"paraa toggidaagee guyye kunddana mala","poem":1},{"text":"paraa ginddiyaa dukkiya,","poem":2},{"lineBreak":true},{"text":"ogiyan de7iya haso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Abeet GODAU, taani neeni ashshanau naagais.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Gaadi bonqqiyaageetun deshettana;","poem":1},{"lineBreak":true},{"text":"shin ikka eta paanaa kaallidi","poem":1},{"text":"eta bonqqana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Aseera oittai ordde;","poem":1},{"text":"kawotuyyo i lo77o qumaa immana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nifttaaleemi qashettennan yeda de7iya,","poem":1},{"text":"lo77o marata yeliya genessa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yooseefi aifiyaara herxxexxida woine tura.","poem":1},{"lineBreak":true},{"text":"I pulttuwaa matan herxxexxa aifiyaara de7iya,","poem":1},{"text":"daashshaikka godaappe bollaara zaa7iyo woine tura.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wonddafiyaa dukkiyaageeti","poem":1},{"text":"a bolli woraajjidosona;","poem":2},{"text":"woraajjidi bantta zubbiyan","poem":1},{"text":"dukkidosonanne muddidosona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"A wonddafee minni uttiis;","poem":1},{"text":"a qeseekka minnidi gam77iis.","poem":2},{"text":"Hegeenne Yaaqooba Wolqqaamaa kushiyaa gaasuwaana,","poem":1},{"text":"ne henttanchchaa, Israa7eela Zaallaa gaasuwaana,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"nena maaddiya ne aawatu Xoossaa gaasuwaananne,","poem":1},{"text":"nena bolla saluwaa anjjuwan,","poem":2},{"lineBreak":true},{"text":"garssa ciimmaa anjjuwan,","poem":2},{"lineBreak":true},{"text":"xanttaa anjjuwaaninne","poem":2},{"lineBreak":true},{"text":"yeliya uluwaa anjjuwan","poem":2},{"lineBreak":true},{"text":"anjjiya,","poem":2},{"lineBreak":true},{"text":"Ubbaa Danddayiya Xoossaa gaasuwaana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne aawaa anjjoi beni deretu anjjuwaappekka","poem":1},{"text":"merinaasappe de7iya keratu anjjuwaappekka aadhdhees.","poem":2},{"text":"Hagee ubbai Yooseefa huuphiyan,","poem":1},{"text":"ba ishanttu giddon halaqa gidiyaagaa liiphiyan shemppo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Biniyaami bonqqiya wanggireello.","poem":1},{"lineBreak":true},{"text":"Ba shankkatidobaa maallado mees;","poem":1},{"text":"ba omooddidobaa omarssi shaakkees” yaagiis.","poem":2}]},{"type":"verse","number":28,"content":["Hageeti tammanne naa77u Israa7eela zareta; qassi eta aawai eta huuphiyan huuphiyan etau bessiya anjjuwaa anjjiiddi etayyo giidobai hagaa."]},{"type":"heading","content":["Yaaqooba Haiquwaa"]},{"type":"verse","number":29,"content":["Hegaappe guyyiyan, i eta hagaadan yaagidi azaziis; “Taani ta maizza asatun gaittana hanais; tana Hiitiyaa Efiroona gaden de7iya gonggoluwan, ta aawatuura moogite."]},{"type":"verse","number":30,"content":["Hegeenne Kanaane biittan, Mamire matan de7iya, Maakipheela giyo gonggoluwaa; hegee Abrahaami moogossi Hiitiyaa Efiroonappe a gadiyaara shammido gonggoluwaa."]},{"type":"verse","number":31,"content":["Abrahaaminne a keettaayyiyaa Saara yan moogettidosona; Yisaaqinne a keettaayyiyaa Ribiqa yan moogettidosona; taani qassi Liyo yan moogaas."]},{"type":"verse","number":32,"content":["He gadeenne an de7iya gonggoloi Hiitetuppe shamettidaagaa” yaagiis."]},{"type":"verse","number":33,"content":["Yaaqoobi ba naatuyyo azazuwaa wurssido wode, ba tohuwaa pude ba hiixau shiishshi ekkidi, haiqqi aggiis; haiqqidi ba maizzan gaittiis."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}