{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"HEB","translationId":"wal_sim","name":"Ibraawe","commonName":"Ibraawe","title":"PHauloosi Ibraawe Asaassi Xaafido Kiitaa","order":58,"numberOfChapters":13,"sha256":"75839825867991aee3a43c61ca1d50beee6584d69fba1f0e76cabc0523a58dfc","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/wal_sim/HEB/13.json","totalNumberOfVerses":298},"chapter":{"number":1,"content":[{"type":"heading","content":["Xoossai Ba Na7aa Baggaara Haasayiis"]},{"type":"verse","number":1,"content":["Xoossai beni wode, nu aawatuyyo hananabaa yootiyaageetu baggaara dumma dumma ogiyaaninne daro wodiyan haasayiis."]},{"type":"verse","number":2,"content":["SHin ha wurssetta wodiyan, ubbabaa a laatissidi, sa7aa a baggaara medhdhido ba Na7aa baggaara nuuyyo haasayiis."]},{"type":"verse","number":3,"content":["Na7ai Xoossaa bonchcho poo7uwaa phoolees; qassi muleerakka a meretaa ekkidi, ba wolqqaama qaalan ha sa7aa naagees; yaatidi asaa nagaraappe geeshshidi, Ubbaappe Bolla Xoossaappe ushachcha baggaara saluwan uttiis."]},{"type":"heading","content":["Xoossaa Na7ai Kiitanchchatuppe Bolla"]},{"type":"verse","number":4,"content":["Xoossai ayyo immido sunttatettai kiitanchchatuugaappe xoqqa gidiyoogaadankka, etappe a keehi xoqqu oottiis."]},{"type":"verse","number":5,"content":["Aissi giikko, Xoossai ba kiitanchchatuppe oona,",{"text":"“Neeni ta Na7aa;","poem":1},{"text":"taani hachchi neeyyo aawa gidaas”","poem":2},"giidee? Woi qassi oona,",{"text":"“Taani ayyo aawa gidana;","poem":1},{"text":"ikka taayyo na7a gidana”","poem":2},"giidee?"]},{"type":"verse","number":6,"content":["Qassi Xoossai ba baira Na7aa ha sa7aa yeddana haniiddi, “Ta kiitanchchati ubbatikka ayyo goinnona” yaagiis."]},{"type":"verse","number":7,"content":["Xoossai kiitanchchatubaa haasayiiddi,",{"text":"“Taani ta kiitanchchata carkko kessais;","poem":1},{"text":"qassi ta ashkkaratakka tama laco kessais”","poem":2},"yaagees."]},{"type":"verse","number":8,"content":["SHin ba Na7aabaa haasayiiddi,",{"text":"“Xoossau, ne kawotaa araatai","poem":1},{"text":"meri merinau de7ees.","poem":2},{"text":"Ne kawotaa xam77aikka","poem":1},{"text":"xillotettaa xam77aa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni xillotettaa siiqadasa;","poem":1},{"text":"naaquwaa ixxadasa.","poem":2},{"text":"Xoossai, ne Xoossai nena","poem":1},{"text":"ne laggetuppe aattidi,","poem":2},{"text":"ufaissa zaitiyaa tiyidoogee hegaassa”","poem":1},"yaagees."]},{"type":"verse","number":10,"content":["Xoossai hagaadan yaagees;",{"text":"“Godau, koiro neeni sa7aa medhdhadasa;","poem":1},{"text":"saluwaakka ne kushiyan medhdhadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hegeeti ubbai xayana;","poem":1},{"text":"shin neeni de7ana.","poem":2},{"text":"Eti ubbaikka afaladan wurana.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Neeni eta iirichchodan dakkoyana;","poem":1},{"text":"qassi eti afaladan laamettana.","poem":2},{"text":"SHin neeni nenakka;","poem":1},{"text":"ne laittai mulekka wurenna”","poem":2},"yaagees."]},{"type":"verse","number":13,"content":["SHin Xoossai ba kiitanchchatuppe issuwaanne,",{"text":"“Taani ne morkketa neeni","poem":1},{"text":"tohuwan yedhdhiyoobaa oottana gakkanaassi,","poem":2},{"text":"hagan taappe ushachcha baggan utta”","poem":1},"gibeenna."]},{"type":"verse","number":14,"content":["Kiitanchchati ubbai Xoossau oottanaunne atotettaa demmana asata maaddanau Xoossai kiittido ayyaanata gidokkonaayye?"]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}