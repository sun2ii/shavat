{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"ISA","translationId":"wal_sim","name":"Isiyaasa","commonName":"Isiyaasa","title":"Isiyaasa","order":23,"numberOfChapters":66,"sha256":"8af7916386a8068333e65ce7b0990ddcd298b8fbb6007e95f247fce458c58660","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wal_sim/ISA/66.json","totalNumberOfVerses":1280},"chapter":{"number":12,"content":[{"type":"heading","content":["Galataa Yettaa"]},{"type":"verse","number":1,"content":["He wode intte hagaadan yaagana;",{"lineBreak":true},{"text":"“Abeet GODAU, neeni tana hanqqettadasa;","poem":1},{"text":"hanqquwaappekka simmadasa;","poem":2},{"lineBreak":true},{"text":"yaatada tana minttettadasa.","poem":2},{"text":"Hegaa gishshau, taani nena galatais.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Be7ite, Xoossai ta atotettaa;","poem":1},{"text":"taani an ammanettada, yayyikke.","poem":2},{"text":"Aissi giikko, GODAI Xoossai","poem":1},{"text":"taayyo wolqqanne yetta.","poem":2},{"text":"I ta atotettaa gidiis”","poem":1},"yaagana."]},{"type":"verse","number":3,"content":["Ashshiya pulttotuppe haattaa intte ufaissan duuqqana."]},{"type":"verse","number":4,"content":["He gallassi qassi intte hagaadan yaagana;",{"lineBreak":true},{"text":"“GODAA galatite!","poem":1},{"text":"A sunttaakka xeesite.","poem":2},{"text":"A oosota kawotettatu ubbaa giddon erissite.","poem":1},{"text":"A sunttai xoqqu xoqqu giidoogaa awaajjite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"GODAI gita oosuwaa oottido gishshau,","poem":1},{"text":"ayyo yexxite.","poem":2},{"text":"Hagee sa7a ubban eretto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Israa7eela Geeshshai intte giddon","poem":1},{"text":"xoqqu xoqqu giido gishshau,","poem":2},{"text":"inttenoo, Xiyoonen de7iyaageetoo,","poem":1},{"text":"hombbocite! Ufaissau yexxite!”","poem":2},"yaagana."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}