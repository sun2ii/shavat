{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"ISA","translationId":"wal_sim","name":"Isiyaasa","commonName":"Isiyaasa","title":"Isiyaasa","order":23,"numberOfChapters":66,"sha256":"8af7916386a8068333e65ce7b0990ddcd298b8fbb6007e95f247fce458c58660","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wal_sim/ISA/66.json","totalNumberOfVerses":1280},"chapter":{"number":26,"content":[{"type":"heading","content":["Xoossai Ba Asaassi Xoonuwaa Immana"]},{"type":"verse","number":1,"content":["He gallassi Yihudaa biittan ha yettai yexettana.",{"lineBreak":true},{"text":"Nuuyyo mino katamai de7ees;","poem":1},{"text":"Xoossai atotettaa a yuushuwan gimbbedaaninne qatodan essees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ammanuwaa naagiya xillo kawotettai","poem":1},{"text":"gelana mala, kareta dooyite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ba qofaa nenan wottida asa","poem":1},{"lineBreak":true},{"text":"neeni polo sarotettan naagaasa;","poem":1},{"text":"aissi giikko, i nenan ammanettees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"GODAN merinau ammanetta;","poem":1},{"text":"aissi giikko, GODAI Xoossai merinaa Zaallaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoqqan de7iyaageetanne","poem":1},{"text":"eta xoqqa katamaa ziqqi oottiis;","poem":2},{"lineBreak":true},{"text":"i a kaushshees.","poem":2},{"lineBreak":true},{"text":"Duge biittaa gakkanau ziqqi oottees;","poem":2},{"lineBreak":true},{"text":"biittaa buhiyan oli bayees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hiyyeesaa gedee, metootanchchaa tohoi a yedhdhana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xillotu ogee salalla.","poem":1},{"lineBreak":true},{"text":"Abeet Xilluwau, neeni","poem":1},{"text":"xillotu ogiyaa salallissaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee GODAU, ne higgiyaa ogiyan hemettiiddi,","poem":1},{"text":"nuuni nena naagoos.","poem":2},{"text":"Nu wozanaa amoi","poem":1},{"text":"ne sunttaa bonchchanaagaa xalaala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qamman taani nena laamotais;","poem":1},{"lineBreak":true},{"text":"ta giddon de7iya ta ayyaanai","poem":1},{"text":"tumuppe nena minttidi koyees.","poem":2},{"text":"Aissi giikko, ne pirddai sa7an de7iyo wode,","poem":1},{"text":"sa7an de7iya asai xillotettaa tamaarees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iita asayyo kehatettaa oottikkokka,","poem":1},{"text":"i xillotettaa tamaarenna.","poem":2},{"text":"Suure asatu biittan iitabaa oottees;","poem":1},{"text":"GODAA gitatettaakka erenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeet GODAU, neeni","poem":1},{"lineBreak":true},{"text":"ne kushiyaa xoqqu oottadasa;","poem":1},{"text":"shin eti be7okkona.","poem":2},{"text":"Ne asau neeni mishettiyo mishuwaa","poem":1},{"text":"be7idi yeellatona.","poem":2},{"text":"Neeni ne morkketuyyo wottido tamai","poem":1},{"text":"eta mi xaisso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abeet GODAU, neeni","poem":1},{"lineBreak":true},{"text":"nuuyyo sarotettaa minttadasa;","poem":1},{"text":"nu ooso ubbaa neeni nuuyyo oottadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet GODAU, nu Xoossau,","poem":1},{"lineBreak":true},{"text":"neeppe harati nuna haaridosona;","poem":1},{"text":"shin nuuni ne sunttaa xalaalaa bonchchoos.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eti haiqqidosona;","poem":1},{"text":"simmidi paxa de7okkona.","poem":2},{"text":"Neeni qaxxayin xayido gishshau,","poem":1},{"text":"simmidi denddokkona.","poem":2},{"text":"Eti hassayettiyoobaa ubbaa qucca xaissadasa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Abeet GODAU!","poem":1},{"text":"Neeni asaa darissadasa.","poem":2},{"text":"Asaa darissada, neeni bonchchettadasa;","poem":1},{"text":"biittaa zawaa ubbaakka aassadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abeet GODAU!","poem":1},{"text":"Metuwaa wode eti nena koyidosona.","poem":2},{"text":"Neeni eta qaxxayido wode,","poem":1},{"text":"eti nena woossidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet GODAU! SHahaarida maccaasiyaa","poem":1},{"lineBreak":true},{"text":"yeliyo wodee gakkin,","poem":1},{"text":"maaretan un77ettada waassiyoogaadan,","poem":2},{"text":"nuunikka ne sinttan hegaadan hanida.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuuni shahaarida; maaretaakka ohettida;","poem":1},{"text":"shin carkkuwaa yeliyaabaa gidida.","poem":2},{"text":"Nuuni sa7au atotettaa ehibookko;","poem":1},{"text":"sa7an de7iya asaakka yelibookko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Haiqqida ne asai paxana;","poem":1},{"text":"eta ahaikka denddana.","poem":2},{"text":"Inttenoo, biittaa buhiyaa giddon de7iyaageetoo,","poem":1},{"text":"intte xaazai maallado xaazaa mala gidiyo gishshaunne,","poem":2},{"text":"sa7aikka haiqqidaageeta zaarettidi immiyo gishshau,","poem":1},{"text":"beegottitenne ufaissau yexxite.","poem":2}]},{"type":"heading","content":["Pirddaanne Omooduwaappe Simmiyoogaa"]},{"type":"verse","number":20,"content":["Ta asatoo, haa yiite; yiidi intte soo gelidi, kariyaa intte bolli gorddite. GODAA hanqqoi aadhdhana gakkanaassi, guutta wodiyaa inttena qosite."]},{"type":"verse","number":21,"content":["Biittaa bollan de7iya asaa, eta nagaraa gishshau qaxxayanau, GODAI ba de7iyoosaappe kiyidi yees. Biittaikka ba bollan gukkida suuttaa qonccissana; woridoogeetakka naa77antto genttenna."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}