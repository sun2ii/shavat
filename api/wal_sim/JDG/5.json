{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"JDG","translationId":"wal_sim","name":"Daannatu Maxaafaa","commonName":"Daannatu Maxaafaa","title":"Daannatu Maxaafaa","order":7,"numberOfChapters":21,"sha256":"9e05cde8c76dcabd9e1b3be19bd5fa541e3bf2929b8a84c9a813e9d321dccc24","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/wal_sim/JDG/21.json","totalNumberOfVerses":614},"chapter":{"number":5,"content":[{"type":"heading","content":["Deboorinne Baaraaqa Yettaa"]},{"type":"verse","number":1,"content":["He gallassi Debooranne Abino7aama na7ai Baaraaqi ha yettaa yexxidosona."]},{"type":"verse","number":2,"content":[{"text":"“Israa7eela asaa kaalettiyaageeti","poem":1},{"text":"kaalettido gishshau,","poem":2},{"text":"asaikka dosidi,","poem":1},{"text":"ba huuphiyaa aattidi immido gishshau,","poem":2},{"text":"GODAA galatite!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Inttenoo kawotoo, hagaa siyite!","poem":1},{"lineBreak":true},{"text":"Inttenoo deriyaa haariyaageetoo, ezggite!","poem":1},{"text":"Taani GODAASSI yexxana.","poem":2},{"text":"GODAASSI Israa7eela Xoossaassi","poem":1},{"text":"galataa yettaa yexxana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeet GODAU, neeni","poem":1},{"text":"Se7iira Deriyaappe denddido wode,","poem":2},{"text":"neeni Eedooma biittaappe kiyido wode,","poem":1},{"text":"biittai qaaxxiis.","poem":2},{"text":"Saluwaappe irai bukkiis;","poem":1},{"text":"ee, haattai shaaratuppe duge soosiis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"GODAA sinttan dereti qaaxxidosona;","poem":1},{"lineBreak":true},{"text":"harai attin, Siinaa Dereekka GODAA","poem":1},{"text":"Israa7eela Xoossaa sinttan kokkoriis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Anaata na7aa SHamggaara wodenne","poem":1},{"lineBreak":true},{"text":"Yaa7eeli wode caana mehiyaa laaggiya","poem":1},{"text":"zal77anchchati he biittaara kanttibookkona.","poem":2},{"text":"Ogiyaara biyaageetikka ogiyaa aggidi,","poem":1},{"text":"loossuwaara biidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israa7eela katamati","poem":1},{"text":"asi de7enna baisa gididosona.","poem":2},{"text":"Nenoo Debooraa, neeni Israa7eela asaayyo","poem":1},{"text":"aayo gidada denddana gakkanaashin onidi attidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israa7eela asai allaga xoossata","poem":1},{"lineBreak":true},{"text":"doorido wode,","poem":1},{"text":"biittan olai denddiis.","poem":2},{"text":"Oitamu sha7u Israa7eela olanchchatu giddon","poem":1},{"text":"issi gonddallee woikko issi toori beettibeenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta wozanai Israa7eela","poem":1},{"text":"ola gadaawatuura de7ees.","poem":2},{"text":"Asaa giddon dosidi banttana aattidi","poem":1},{"text":"immidaageetuura de7ees.","poem":2},{"text":"GODAA galatite!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Inttenoo, gilaasiyaa wottido","poem":1},{"lineBreak":true},{"text":"bootta hareta toggiyaageetoo,","poem":1},{"lineBreak":true},{"text":"inttenoo, ogiyaara hemettiyaageetoo,","poem":1},{"text":"hagaa siyite!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haattaa ollatu matan","poem":1},{"text":"shiiqida yettanchchatu yettaa siyite.","poem":2},{"text":"Eti GODAI xoonidoogaa yexxoosona;","poem":1},{"text":"qassi Israa7eela asai xoonidoogaa yexxoosona.","poem":2},{"text":"Hegaappe guyyiyan, GODAA asai","poem":1},{"text":"katamaa geliyo penggetukko duge wodhdhiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Debooraa! Beegotta! Beegotta!","poem":1},{"lineBreak":true},{"text":"Beegotta! Beegottada mazamuriyaa yexxa.","poem":1},{"text":"Baaraaqaa, dendda!","poem":2},{"text":"Nenoo, Abino7aama na7au,","poem":1},{"text":"ne omooduwaa ekkada ya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Hegaappe guyyiyan, attida asati","poem":1},{"text":"halaqatukko duge wodhdhidosona.","poem":2},{"text":"GODAA asati olettanau giigidi","poem":1},{"text":"Baaraaqakko yiidosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amaaleeqa zareti","poem":1},{"lineBreak":true},{"text":"beni de7ido sohuwan","poem":1},{"text":"de7iya Efireema asati yiidosona.","poem":2},{"text":"Qassi Biniyaama asati","poem":1},{"text":"eta kaallidosona.","poem":2},{"text":"Halaqati Maakira zaretuppenne,","poem":1},{"lineBreak":true},{"text":"ola gadaawati Zaabiloona zaretuppe","poem":1},{"text":"duge wodhdhidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yisaakoora halaqati","poem":1},{"lineBreak":true},{"text":"Debooriira yiidosona;","poem":1},{"text":"ee, Yisaakoora asai yiis.","poem":2},{"text":"Baaraaqikka yiis;","poem":1},{"text":"yin eti a geeduwaa kaallidi, zanggaaraa gelidosona.","poem":2},{"text":"SHin Roobeela zareti qofan shaahettidi,","poem":1},{"text":"yaanaagaa agganaagaa qachchibookkona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eti aibissi attidonaa? Dorssata heemmiyaageetu imbbiliitiyaa","poem":1},{"text":"siyanau attidonaayye?","poem":2},{"text":"Roobeela zareti qofan shaahettidi,","poem":1},{"text":"yaanaagaa agganaagaa qachchibookkona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gala7aade asati Yorddaanoosa","poem":1},{"text":"SHaafaappe hefinttan attidosona.","poem":2},{"text":"Daana zareti markkabetu matan","poem":1},{"text":"attidosona.","poem":2},{"text":"Aseera zareti bantta de7iyosan","poem":1},{"text":"Meediteraane Abbaa lanqqen attidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zaabiloona zareti","poem":1},{"lineBreak":true},{"text":"bantta shemppuwaa haiquwau","poem":1},{"text":"aattidi immida asata.","poem":2},{"text":"Nifttaaleema zaretikka etaagaadan","poem":1},{"text":"ola dembban bantta shemppuwaa aattidi immidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Kawoti yiidi, Magiddo pulttotu matan","poem":1},{"text":"de7iya Taa7inaakan olettidosona.","poem":2},{"text":"He Kanaane kawoti yan olettiiddi,","poem":1},{"text":"omooddanau aiba biranne demmibookkona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Saluwan de7iya xoolinttetikka","poem":1},{"text":"olettidosona.","poem":2},{"text":"Bantta yuuyiyo yuushshan","poem":1},{"text":"eti Sisaaraara olettidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qiishoona SHaafai, beniisappe","poem":1},{"lineBreak":true},{"text":"erettida Qiishoona SHaafai kixxidi,","poem":1},{"text":"he kawota shokkidi efiis.","poem":2},{"text":"Ta shemppee, simmi minna;","poem":1},{"text":"minnada sinttau horddofa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Hegaappe guyyiyan, paraasati","poem":1},{"text":"adaraasissiiddi yiidosona.","poem":2},{"text":"Parati bantta kottiyan","poem":1},{"text":"biittaa giirissidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“GODAA kiitanchchai,","poem":1},{"lineBreak":true},{"text":"‘Merooza qanggite!","poem":1},{"text":"Yan de7iya asaa iissidi qanggite!","poem":2},{"text":"Aissi giikko, eti GODAA","poem":1},{"text":"maaddanau yibookkona.","poem":2},{"text":"A wolqqaama morkketuura olettanau","poem":1},{"text":"kiyibookkona’ yaagiis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Qeenaa Hebeera machchiyaa","poem":1},{"lineBreak":true},{"text":"Yaa7eela macca asa ubbaappe","poem":1},{"text":"anjjettidaaro gidu.","poem":2},{"text":"Dunkkaane giddon de7iya macca","poem":1},{"text":"asa ubbaappe a anjjettidaaro gidu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sisaari o haattaa oichchin,","poem":1},{"text":"maattaa ayyo immaasu.","poem":2},{"text":"Lo77o xibbuwan meqqida maattaa ehaasu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Issi kushiyaa yeddada","poem":1},{"lineBreak":true},{"text":"dunkkaaniyaa xishiyaa, ushachcha kushiyan","poem":1},{"text":"oosanchchatu madooshaa oiqqaasu.","poem":2},{"text":"Oiqqada Sisaara huuphiyan xishaasu;","poem":1},{"text":"xishada haitta kariyaara kantta kessaasu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yaatin, i bolqqu giidi kunddiis.","poem":1},{"lineBreak":true},{"text":"I he i tohuwaa matan","poem":1},{"text":"bolqqu giidi kunddiis.","poem":2},{"text":"He kunddido sohuwan haiqqiis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Sisaara aayyiyaa","poem":1},{"text":"maskkootiyaara xeellaasu.","poem":2},{"text":"Xeellada, ‘Ta na7aa paraa gaaree","poem":1},{"text":"aibissi gam77idee?","poem":2},{"text":"Parati eesotidi aibissi simmibookkona?’","poem":1},{"text":"yaagada oichchaasu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I aadhdhida eranchcha macca asati","poem":1},{"text":"i oishaa zaaridosona.","poem":2},{"text":"SHin a ba qofan zaara zaaradakka","poem":1},{"text":"hagaadan yaagaasu;","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Eti omooddidi","poem":1},{"text":"shaakkiyoobaa demmennan aggokkona.","poem":2},{"text":"Issi issi olanchchaa issi issi woikko","poem":1},{"text":"naa77u naa77u geela7oti gakkennan aggokkona.","poem":2},{"text":"Sisaarayyo eti lo77iya maayuwaa immana;","poem":1},{"text":"qassi taayyookka qooriyan xaaxanau","poem":2},{"text":"xilifiyan alleeqettidi lo77iya maayota","poem":1},{"text":"eti ehaana’ yaagaasu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Abeet GODAU, ne morkketi ubbai","poem":1},{"text":"hegaadan haiqqona!","poem":2},{"text":"SHin ne siiqoti","poem":1},{"text":"maallado mokkiya awaadan phoolona”","poem":2},{"text":"yaagidosona.","poem":1},"Hegaappe guyyiyan, biittai oitamu laittaa woppaa demmiis."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}