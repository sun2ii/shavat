{"translation":{"id":"wal_sim","name":"Wolaytta Bible","website":"https://ebible.org/Scriptures/details.php?id=wal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wal","licenseNotes":null,"shortName":"SIM","englishName":"Wolaytta Bible","language":"wal","textDirection":"ltr","sha256":"f03676709d02064f36209ab761eb9e7fca57767793e718e9475e38f36ba8b685","availableFormats":["json"],"listOfBooksApiLink":"/api/wal_sim/books.json","numberOfBooks":58,"totalNumberOfChapters":969,"totalNumberOfVerses":26944,"languageName":"Wolaytta","languageEnglishName":"Wolaytta"},"book":{"id":"NUM","translationId":"wal_sim","name":"Qoodaabaa","commonName":"Qoodaabaa","title":"Qoodaabaa","order":4,"numberOfChapters":36,"sha256":"d808c72ee7a5a22dff746fc1c618a205a14880766004931ab21d6dabd9d35ad4","firstChapterNumber":1,"firstChapterApiLink":"/api/wal_sim/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/wal_sim/NUM/36.json","totalNumberOfVerses":1247},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Israa7eela anjjiyoogee GODAA ufaissidoogaa Balaami be7ido wode, kase i oottidoogaadan murunnanau koyibeenna; shin ba som77uwaa bazzuwaakko zaariis."]},{"type":"verse","number":2,"content":["Zaaridi xoqqu giidi xeellidi, Israa7eela asai ba zariyan zariyan dunkkaani uttidaagaa be7iis; be7in Xoossaa Ayyaanai a bolli wodhdhiis."]},{"type":"verse","number":3,"content":["Wodhdhin i ba hiraagaa hagaadan yaagidi yootiis;",{"text":"“Bi7oora na7aa Balaama hiraagai,","poem":1},{"text":"a aifee tishshi ootti xeelliyoogaa hiraagai,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossai giyoobaa siyiyaagaa hiraagai,","poem":1},{"lineBreak":true},{"text":"lichchi giidi gufannin,","poem":1},{"text":"a aifee dooyettidoogaanne","poem":2},{"lineBreak":true},{"text":"Ubbaa Danddayiya Xoossaa ajjuutaa be7iyaagaa hiraagai hagaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaaqooba zaretoo, intte dunkkaaneti,","poem":1},{"lineBreak":true},{"text":"Israa7eela asau, intte de7iyoosatikka","poem":1},{"text":"aiba lo77oo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eti micettida wombbaadan,","poem":1},{"lineBreak":true},{"text":"shaafaa doonan de7iya ataakilttiyaa sohuwaadan,","poem":1},{"text":"GODAI tokkido godare uuttaadaaninne","poem":2},{"text":"haattaa doonan de7iya zigaadan hanoosona.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Etau daro haattai pulttana;","poem":1},{"text":"eta zerettau gidiya haattai de7ana.","poem":2},{"text":"Eta kawoi Kawuwaa Agaagappe gitatana;","poem":1},{"text":"eta kawotettaikka bonchchettana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossai eta Gibxxeppe kessiis;","poem":1},{"text":"i mino menttaadan etau de7ees.","poem":2},{"text":"Eti morkke kawotettaa mittana;","poem":1},{"text":"eta meqettaakka liiqissana;","poem":2},{"lineBreak":true},{"text":"eti bantta wonddafiyaa zubbiyan eta caddana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Israa7eela asai gaammuwaadan zin77ees.","poem":1},{"text":"Macca gaammeedan eta denttanau ooni xalanee?","poem":2},{"text":"Inttena anjjiya ubbai anjjettidaagaa gidana;","poem":1},{"text":"inttena qanggiya ubbai qanggettidaagaa gidana” yaagiis.","poem":2}]},{"type":"verse","number":10,"content":["Hegaappe guyyiyan, Baalaaqi Balaama bolli hanqquwaa eexxi kiyiis. Baalaaqi ba kushiyaa dukkidi Balaama, “Ta morkketa qangganaadan taani nena xeesaas; shin neeni ha heezzutookka eta anjjadasa."]},{"type":"verse","number":11,"content":["Simmi ha77i neeni ne soo baqata; ‘Taani neeyyo darobaa woitana’ gaas; shin neeni woituwaa ekkennaadan GODAI nena diggiis” yaagiis."]},{"type":"verse","number":12,"content":["Yaagin Balaami Baalaaqa zaaridi, “Neeni taakko kiittidoogeetun,"]},{"type":"verse","number":13,"content":["‘Baalaaqi harai atto ba birainne worqqai kumido ba kawo keettaa tau immidabaa gidiyaakkonne, GODAI yootidoogaa kanttada, lo77uwaa woikko iitaa ta sheniyan oottanau danddayikke. Taani GODAI giyoobaa xalaalaa gaana’ yaagada neeyyo yootabeikkinaayye?” yaagiis."]},{"type":"heading","content":["Balaama Wurssetta Hiraagata"]},{"type":"verse","number":14,"content":["Yaagidi, “Taani ha77i ta asaakko bais; shin neeni haa ya; ha asai wurssetta wodiyan ne asaa oottanabaa taani neeyyo yootana” yaagiis."]},{"type":"verse","number":15,"content":["Yaagidi i ba hiraagaa hagaadan yaagidi yootiis;",{"text":"“Bi7oora na7aa Balaama hiraagai,","poem":1},{"text":"a aifee tishshi oottidi xeelliyoogaa hiraagai,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xoossai giyoobaa siyiyaagaanne","poem":1},{"lineBreak":true},{"text":"Ubbaappe Xoqqiya Xoossaappe","poem":1},{"text":"gidida eratettai de7iyoogaa hiraagai,","poem":2},{"text":"lichchi giidi gufannin,","poem":1},{"text":"a aifee dooyettidoogaanne","poem":2},{"lineBreak":true},{"text":"Ubbaa Danddayiya Xoossaa ajjuutaa be7iyaagaa hiraagai hagaa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani a be7ais; shin wodee ha77a gidenna;","poem":1},{"text":"taani a xeellais; shin matan gidenna.","poem":2},{"text":"Yaaqooba zariyaappe xoolinttee kiyana.","poem":1},{"text":"Israa7eelappe kawotaa xam77ai kiyana.","poem":2},{"text":"Moo7aaba asaa som77uwaa i gaacci qolana.","poem":1},{"text":"Seeta asaa ubbaa huuphiyaa i kinchchana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eedoomi xoonettana;","poem":1},{"text":"a morkkee Se7iirikka xoonettana;","poem":2},{"text":"shin Israa7eeli minni minnidi baana.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yaaqoobappe haariyaagee kiyana;","poem":1},{"text":"kiyidi eta kataman paxa attidaageeta xaissana” yaagiis.","poem":2}]},{"type":"verse","number":20,"content":["Hegaappe guyyiyan, Balaami Amaaleeqa asata be7idi, ba hiraagaa hagaadan yaagidi yootiis;",{"text":"“Kawotettatu giddon Amaaleeqi koiro;","poem":1},{"text":"shin eta wurssettai xayo” yaagiis.","poem":2}]},{"type":"verse","number":21,"content":["Qassi Balaami Qeena asata be7idi, ba hiraagaa hagaadan yaagidi yootiis;",{"text":"“Intte de7iyo sohoi saro soho gidees;","poem":1},{"text":"intte keettai zaallaa bollan keexettiis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"SHin Asooreti inttena omooddiyo wode,","poem":1},{"text":"intte Qeena asati xayana” yaagiis.","poem":2}]},{"type":"verse","number":23,"content":["Hegaappe guyyiyan, Balaami ba hiraagaa hagaadan yaagidi yootiis;",{"text":"“Aayye7ana!","poem":1},{"lineBreak":true},{"text":"Xoossai hagaa oottiyo wode","poem":1},{"text":"ooni de7ana danddayii?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Markkabeti Kitiima haruuruwaappe yaana;","poem":1},{"text":"eti Asooretanne Ebeerata huqqunnana;","poem":2},{"text":"shin qassi etikka xayana” yaagiis.","poem":1}]},{"type":"verse","number":25,"content":["Hegaappe guyyiyan, Balaami denddidi, ba soo simmiis; Baalaaqikka ba ogiyaa biis."]}],"footnotes":[]},"thisChapterLink":"/api/wal_sim/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wal_sim/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wal_sim/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}