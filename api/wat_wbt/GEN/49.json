{"translation":{"id":"wat_wbt","name":"Buk Baibel long Kaninuwa","website":"https://ebible.org/Scriptures/details.php?id=wat","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wat","licenseNotes":null,"shortName":"WBT","englishName":"Kaninuwa Bible","language":"wat","textDirection":"ltr","sha256":"133fa377d20b45f67b69353991da97a04d81b2d26e5da6ea73d6bf68f265beed","availableFormats":["json"],"listOfBooksApiLink":"/api/wat_wbt/books.json","numberOfBooks":5,"totalNumberOfChapters":105,"totalNumberOfVerses":2599,"languageName":"Kaninuwa","languageEnglishName":"Kaninuwa"},"book":{"id":"GEN","translationId":"wat_wbt","name":"Kabikona","commonName":"Kabikona","title":"Kabikona","order":1,"numberOfChapters":34,"sha256":"27811f702c142d4be4dfd9cacd6b718bcc2ca4fc83c9ec4560b6017bb79fa515","firstChapterNumber":1,"firstChapterApiLink":"/api/wat_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/wat_wbt/GEN/50.json","totalNumberOfVerses":514},"chapter":{"number":49,"content":[{"type":"heading","content":["Yakobo Yuda I Sawanuwagabubuwiya"]},{"type":"verse","number":8,"content":[{"text":"“Yuda, unaunau sina daviwa","poem":1},{"text":"keta sina koduwa neneweu.","poem":2},{"lineBreak":true},{"text":"Ka aviya kuna gikayusiya keta kuna vatanisiya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O Yuda, kwaḡa maise naiyoni mwanavauna,","poem":1},{"text":"kimoki mani yomuyomu kuna fiwanateweisiya keta kuna visimeisiya.","poem":2},{"text":"Naki naiyoni maise, tovanama ina gevagevamunuwa muninei yo ina makaviniya ina ketosebaḡa,","poem":1},{"text":"atu aitevana simo fatafatana yo ina vikasanegwanegwai?","poem":2},{"lineBreak":true},{"text":"Naki mukamokena!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tufomu yana visime kana kiwana Yuda nimanei ina fakwa","poem":1},{"text":"keta susukwana o tova kana matatafu sina vivitovisimeya","poem":2},{"text":"kana nivaniva tonikiwana ina nemiya.","poem":1},{"text":"Nokomai kunuma matatafusi sina vimogumoguwiya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":["Tovanama Yakobo natunatuna nenesiyai i nusifufukooḡa, i sioviniya keta i kenofana. Tovanama nenei yawasina i tununoviya keta i vidawana. Yakobo Itifita i fakwa manamana 17, eketa manamana kana vikatutamokeina na yawasina i fakwa o 147."]}],"footnotes":[]},"thisChapterLink":"/api/wat_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wat_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wat_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":4}