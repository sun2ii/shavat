{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"1KI","translationId":"wed_wbt","name":"1 Kings - Gulagulau Naona","commonName":"1 Kings - Gulagulau Naona","title":"1 Kings Gulagulau Naona","order":11,"numberOfChapters":13,"sha256":"498a92b25523312d3ae23105dc38e52ae4a30bf0a2fd4dae2b22ffb0450dec4a","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/1KI/2.json","lastChapterNumber":19,"lastChapterApiLink":"/api/wed_wbt/1KI/19.json","totalNumberOfVerses":185},"chapter":{"number":4,"content":[{"type":"heading","content":["Solomon i vibada kaua"]},{"type":"verse","number":20,"content":["Mai Judah ma mai Israel ai patara i maḡa dewadewa me bubu au gera. Taui ai lam ma ai uma tagotagogina ma i vinuaiai kaua."]},{"type":"verse","number":21,"content":["Ma Solomon dobuna anatapuna i vibadei. Ana parata au waira Euphrates i vikarei da i ḡaira au Philistia ma kampa da i ḡaira Egypt ana au parata. Wei ravai tax i vivimaiei gulau Solomon awarina ma i voteletelei maranai lawalawaina."]},{"type":"line_break"},{"type":"verse","number":25,"content":["Maranai Solomon i vibada mai Judah ma Israel ana nuaubai i mae, ai nuabola eḡa aiwai. Au lavaratei Dan ana dam ai au dobu i vikarei da i ḡaira au Beersheba au rauanaḡei, numa nununai ravai anatapui ai numa ma ai wapu i mae."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/1KI/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/1KI/5.json","nextChapterAudioLinks":{},"previous