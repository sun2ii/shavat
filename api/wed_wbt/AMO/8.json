{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"AMO","translationId":"wed_wbt","name":"Amos","commonName":"Amos","title":"Peroveta Amos ana buka","order":30,"numberOfChapters":2,"sha256":"ebe98b8347d2814775978cd3278acf0a1dd6cc9ee40fcdb535e7fb316206cdb9","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/AMO/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wed_wbt/AMO/8.json","totalNumberOfVerses":4},"chapter":{"number":8,"content":[{"type":"heading","content":["Tou ḡaeḡaena e nenei"]},{"type":"verse","number":4,"content":[{"text":"Ona rautaniḡana! Taumi voladaḡai o kwalekwalei","poem":1},{"text":"ma molamolakai o tugwadagwadai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O ririwa, nawaravi vouna torelana ina kwa laḡilaḡina","poem":1},{"text":"ma Sabate ina kwa.","poem":2},{"text":"Ma witi tana gimarei,","poem":1},{"text":"witi ruva aburuna tana terei ma maiana tana ḡaiḡaiei","poem":2},{"lineBreak":true},{"text":"ma sikere morumorunei tana gimagimarei.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Witi loḡiloḡii o tami da witi o tavipotoi ma o gimarei","poem":1},{"text":"ma lamnei, molamolakai o gimarai ami taunola.","poem":2},{"lineBreak":true},{"text":"Taui maiai me busi, maiana aburuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bada parivainuaḡana-bagibagina, ana wava i kauei,","poem":1},{"text":"nai wavana mai Israel e vimaeḡaeḡae,","poem":2},{"lineBreak":true},{"text":"I pa, “Ami ḡoʼapoapoei eḡa melanai nuanuau ina vuru.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":4}