 kauana-kauei da ona voteletelei.”"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/DEU/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/DEU/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/DEU/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}