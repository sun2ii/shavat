{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ECC","translationId":"wed_wbt","name":"Ecclesiastes - Tauviararamana","commonName":"Ecclesiastes - Tauviararamana","title":"Ecclesiastes Tauviararamana","order":21,"numberOfChapters":9,"sha256":"bad16357a60c4d8d693bcaa727b785be32870cbefca94b9df966f1b33492857c","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wed_wbt/ECC/12.json","totalNumberOfVerses":86},"chapter":{"number":3,"content":[{"type":"heading","content":["Aiwai anatapui ai au mara e tuputupua"]},{"type":"verse","number":1,"content":[{"text":"Mara ma iri i terei da aiwai anatapui au dobu ai au mara e tuputupua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vinatuna ana mara ma iraḡe ana mara","poem":2},{"lineBreak":true},{"text":"paewa ana mara ma tuaruta ana mara.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Viraḡena ana mara ma vilawana ana mara,","poem":2},{"lineBreak":true},{"text":"amrika ana mara ma voa ana mara.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tou ana mara ma kaka ana mara,","poem":2},{"lineBreak":true},{"text":"mogu ana mara ma ara ana mara.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ḡaima viorerena ana mara ma tama melanana ana mara,","poem":2},{"lineBreak":true},{"text":"taragwaba ana mara ma eḡa taragwaba ana mara.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Baia ana mara, ma baia voterena ana mara,","poem":2},{"lineBreak":true},{"text":"ma purapura vojijinana ana mara ma purapura vineboana ana mara.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sika ana mara ma popo ana mara,","poem":2},{"lineBreak":true},{"text":"genuana ana mara ma babani ana mara.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuavaina ana mara ma ḡoaḡai ana mara","poem":2},{"lineBreak":true},{"text":"viḡaiḡaiawa ana mara ma nuauba ana mara.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}