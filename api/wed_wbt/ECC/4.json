{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ECC","translationId":"wed_wbt","name":"Ecclesiastes - Tauviararamana","commonName":"Ecclesiastes - Tauviararamana","title":"Ecclesiastes Tauviararamana","order":21,"numberOfChapters":9,"sha256":"bad16357a60c4d8d693bcaa727b785be32870cbefca94b9df966f1b33492857c","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wed_wbt/ECC/12.json","totalNumberOfVerses":86},"chapter":{"number":4,"content":[{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rava ruaḡa i aii eḡa me rava tagogi,","poem":1},{"text":"aubaina taui ina viagu vivira ma maura ina nelaḡai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mepa da tagogi ina peu, turana e mamae da ina voepai.","poem":1},{"text":"Wate tam ainelam ma u peu lamna i apoapoe kaua,","poem":2},{"lineBreak":true},{"text":"aubaina kampa eḡa aiai da ina voaguim.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ma nanare mepa da rava ruaḡa i matave tagogi, taui eḡa inii ina ubauba.","poem":1},{"text":"Rava tagogi menanare ainela ina vibolabola-melei?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Am ḡavia, ainelam ina viḡaviem ma ina vovaiubaim, wate maranai taumi ruaḡami e viviḡaviem amapo ona vobelei.","poem":1},{"text":"Ma rava tonuḡa i virewapana kaua me ḡurava barawa tonuḡei metametanana.","poem":2},{"lineBreak":true},{"text":"Wei ḡuravana viaituinana ma kauana-avei.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":4}