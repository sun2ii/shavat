{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ECC","translationId":"wed_wbt","name":"Ecclesiastes - Tauviararamana","commonName":"Ecclesiastes - Tauviararamana","title":"Ecclesiastes Tauviararamana","order":21,"numberOfChapters":9,"sha256":"bad16357a60c4d8d693bcaa727b785be32870cbefca94b9df966f1b33492857c","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wed_wbt/ECC/12.json","totalNumberOfVerses":86},"chapter":{"number":5,"content":[{"type":"verse","number":10,"content":[{"text":"Aiavoi mane nuanuai e vaivaia eḡa melanai nuanuai ina rauei;","poem":1},{"text":"aiavoi e ḡoeḡoei da ina vipurapura;","poem":2},{"lineBreak":true},{"text":"taui eḡa melanai ai rauoḡara anatapuna ina vaia.","poem":2},{"lineBreak":true},{"text":"A inanai da wei anona eḡa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Maranai am maura e rarata,","poem":1},{"text":"lamna maranai patara e ḡeḡetai da e amam vereverem.","poem":2},{"text":"Wate wei maurana aiwai aiaina e vereverem?","poem":1},{"text":"Eḡa aiwai, anina e viatataim da tam maumauram, wate rava ḡelauna am maura ina tawanei aubaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Taunola e amam kaua bo eḡa,","poem":1},{"text":"wate e matamatave kaua.","poem":2},{"lineBreak":true},{"text":"Mane ravana eḡa nanare, tauna ana maura e notanota-maratomei.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Au dobu kaua apoapoe kaukauana a inanai;","poem":1},{"text":"Mane ma purapura ravana ana maura au anara e tereterei muriai aubaina. Wate wei lamnei, ana nuabola ḡaeḡaena i tuarui.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ana mane ma ana maura i kauana","poem":1},{"text":"labalababai ma anatapuna i vine-boai.","poem":2},{"lineBreak":true},{"text":"Natuna eḡa ana buderi ita terei.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Menanarena dobuna ta ruinei","poem":1},{"text":"nanarena tana nae me, kovakovata ma ana ura kwakwavita.","poem":2},{"text":"Amapo eḡa ata purapura, ta vopolepolei tana vinimavoei.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":6}