{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ECC","translationId":"wed_wbt","name":"Ecclesiastes - Tauviararamana","commonName":"Ecclesiastes - Tauviararamana","title":"Ecclesiastes Tauviararamana","order":21,"numberOfChapters":9,"sha256":"bad16357a60c4d8d693bcaa727b785be32870cbefca94b9df966f1b33492857c","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wed_wbt/ECC/12.json","totalNumberOfVerses":86},"chapter":{"number":7,"content":[{"type":"verse","number":15,"content":[{"text":"Au lawana kwakwavina au orana kaua ruaḡa a inanai;","poem":1},{"text":"Rava aiaina Bada ana nola e kaukauei iʼraḡe laḡilaḡina","poem":2},{"lineBreak":true},{"text":"ma ḡoʼapoapoe taukaueina God ana tarawatu e viviaigai wate ana lawana i manawa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lamna aubaina eḡa ma viḡoa aiaina guratana bo ma vinuaulaula guratana,","poem":1},{"text":"mepa da ma viraḡena-melem.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wate nanare, eḡa ma vitaniḡapota guratana","poem":1},{"text":"ma eḡa ma opa;","poem":2},{"text":"eḡa ita ai da ma iraḡe muriai da am mara.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I aii mepa da wei riwai bagibagina ma nonori","poem":1},{"text":"Aiai God e vivivirei lamna ina paina-melei","poem":2},{"lineBreak":true},{"text":"da wei kauai ruaḡai eḡa ina kauei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Rava nualaulaunana tagogi rewapana ḡaeḡaena ina verei","poem":1},{"text":"eḡa me gulagulau 10 au taon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Riwa kaua! Weka au dobu eḡa aiai tagogi kaua aiaii ava taukaueina.","poem":1},{"text":"Ma eḡa ḡoʼapoapoe ita kaukauei.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}