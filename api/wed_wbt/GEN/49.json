ine_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":4}