{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":2,"content":[{"type":"heading","content":["Bada ana ola"]},{"type":"verse","number":1,"content":["God ana pariverena, Judah ma Jerusalem aubaii wenanare, Isaiah - Amoz natuna i verei."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mara au murina,","poem":1},{"text":"ola mepa tempol marina e maimairi, ina mae-nonoa.","poem":2},{"lineBreak":true},{"text":"Ina ḡetelara kaua eḡa, me ola ḡelaui.","poem":2},{"lineBreak":true},{"text":"Dam nununai patarai ina taini kampa da ina voepaepa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dam patarai ina nei ma ina riwa,","poem":1},{"text":"“Ona nei, tana ḡae Bada ana au ola,","poem":2},{"lineBreak":true},{"text":"Jacob ana God ana au numa.","poem":2},{"lineBreak":true},{"text":"Weka ana kaua ina viararamanita","poem":2},{"text":"da au ivina tana babara.","poem":1},{"text":"Aubaina Bada Riwana au Zion da ina opu,","poem":2},{"lineBreak":true},{"text":"Bada ana tarawatu Jerusalemei ina opu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tauna dam ḡaeḡae ai viḡaiḡaiawa ina rauetarei,","poem":1},{"text":"ma ina kovoḡa.","poem":2},{"text":"Ai sod ina guda-virai da ipa uata,","poem":1},{"text":"ma ai pawasi ina guda-virai da naipi ai raḡaraḡai kosii aubaii.","poem":2},{"text":"Dam damai eḡa ina viḡaiḡaiawa vivira me,","poem":1},{"text":"bo ina vokaukaua, ḡavia aubaina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ona nei Israel natunatui, Bada ana au ravilala au ivina tana babara.”","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":5}