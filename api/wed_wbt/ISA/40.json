{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":40,"content":[{"type":"heading","content":["God ana rava ina vinuaubai."]},{"type":"verse","number":1,"content":[{"text":"Ami God e ririwa, “Au rava, ona vinuaubai!","poem":1},{"text":"Nuauba riwai ona riwei.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Riwa egolanei mai Jerusalem ona riwei","poem":1},{"text":"ona riwei da ai vinuapoapoe marana i kwa,","poem":2},{"lineBreak":true},{"text":"ai ḡoʼapoapoe i nota-tawanei.","poem":2},{"lineBreak":true},{"text":"Bada ai ḡoʼapoapoe i vimaiei mara ruaḡa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rava e viḡoreḡore;","poem":1},{"lineBreak":true},{"text":"“Bada ana aninae au mutulua ona vokaukauei!","poem":1},{"text":"Etanai jijimanina ata God aubaina au mutulua ona kauei.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gwagwa ona dobo-naiei,","poem":1},{"text":"ma ola anatapui ona ḡara tawatawanei","poem":2},{"text":"doana anatapuna ona vimataveni,","poem":1},{"text":"ona ḡara-laboḡi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bada ana boruma ina vieḡai,","poem":1},{"text":"ma rava anatapui ina inanai.","poem":2},{"lineBreak":true},{"text":"Lamna Bada gamonei i riwa!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zion, tam pariverena aiaina e garagararei.","poem":1},{"text":"Ma ḡae ola ḡaeḡaena au tepana","poem":2},{"text":"ma ponam ḡaeḡaenei,","poem":1},{"text":"pariverena aiaina ma raugugulei","poem":2},{"lineBreak":true},{"text":"ma eḡa ma rovo!","poem":2},{"text":"Taon ḡaeḡaei Judah au paratana ma pariverei,","poem":1},{"text":"“Ami God e nenei!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ona inana Bada God ana rewapanana","poem":1},{"text":"e nenei da ina vibadeta.","poem":2},{"text":"Ona inanai! Maiana, lamna rava i vivilawania, maiteni e nenei.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ana rava ina ḡamoi me sipu tauḡamoina,","poem":1},{"text":"ana sipu natunatui au nuanuana ina raparapai.","poem":2},{"text":"ma tatauvao ina ravena-kauei.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/35.json","previousChapterAudioLinks":{},"numberOfVerses":8}