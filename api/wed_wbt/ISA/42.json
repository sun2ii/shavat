{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":42,"content":[{"type":"heading","content":["Bada ana taunola."]},{"type":"verse","number":1,"content":[{"text":"Bada i riwa,","poem":1},{"text":"“Wei au taunola, a vinei,","poem":2},{"lineBreak":true},{"text":"a vovaivirewapani ma a vinuaiaiei.","poem":2},{"text":"Aruau au orana a terei","poem":1},{"text":"ma tauna lawana aiaina, ma kaua jijimanii ina neiai dobu au anatapuna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tauna eḡa ina garara","poem":1},{"text":"bo ponana ina rata au deba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rava me gonu barabarana eḡa ina gai,","poem":1},{"text":"bo rava me wiki tupona eḡa ina boi.","poem":2},{"lineBreak":true},{"text":"Wate lawana aiaina ma kaua jijimanii ina neiai dobu anatapui awarii da ai lawana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eḡa orana ina peu bo ina vokokokara,","poem":1},{"text":"lawana jijimanina ina terei au dobu;","poem":2},{"lineBreak":true},{"text":"bonabona ravai aueia nanare, e vivipaipai.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Tau Bada jijimaniu, a vinem ma ana vovaivirewapanim da lawana aiaina ma neiai;","poem":1},{"text":"ma ana raunimavoaim ma ana gagaloem.","poem":2},{"text":"Tamei, parivainuaḡana bagibagina rava anatapui au dobu maiteni ana kauei,","poem":1},{"text":"ma vilalalaina jentail awari.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma mata-potapotai matai ma vikalai;","poem":2},{"text":"ma ravai au panipani numana;","poem":1},{"text":"nai taui gimtona maemaei ma tereopunei.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":6}