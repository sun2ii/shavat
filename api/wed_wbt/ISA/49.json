{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":49,"content":[{"type":"heading","content":["Bada ana taunola"]},{"type":"verse","number":3,"content":[{"text":"Bada i riweu i pa,","poem":1},{"text":"“Israel tam au taunola ma tamei au boruma ana vieḡai.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Au manawa ma Bada i vineu da ana taunola;","poem":1},{"text":"da ana rava mai Israel kwakokwakoi ana neiana-meleiai awarina.","poem":2},{"text":"Bada i vimaeḡaeḡaeniu;","poem":1},{"text":"Tauna au rewapana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I riweu “Au Taunola,","poem":1},{"text":"Jacob ana dam ma voepana-melei ma","poem":2},{"lineBreak":true},{"text":"mai Israel kwakokwakoi ma neiana-meleiai; lamna nola aburuna.","poem":2},{"text":"Wate nola ḡaeḡaena a vereverem;","poem":1},{"text":"lalalaina ma naiei jentail awarii","poem":2},{"lineBreak":true},{"text":"ma lawana mamae-nonoana ma naiei da dobu au gia dewadewana ina ḡeta.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wate mai Jerusalem i riwa,","poem":1},{"text":"“Bada i netawaneta! Tauta nuanuana i vuru”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ma Bada i paribelei,","poem":1},{"lineBreak":true},{"text":"“Moina! Tatauvao natuna melamelana au ḡuḡuna, nuanuana ina vuru bo;","poem":1},{"text":"bo natuna i ḡuniḡunia nuanuana ina vuru","poem":2},{"text":"Mepa da alo nuanuana ina vuru,","poem":1},{"text":"wate tau, eḡa nuanuau ina vuru!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jerusalem eḡa melanai nuanuau ina vuru","poem":1},{"text":"Ona inanai! Wavami, au ura lapalapau a rurui.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}