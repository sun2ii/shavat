{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":50,"content":[{"type":"heading","content":["Bada ana taunola patupatutuna."]},{"type":"verse","number":4,"content":[{"text":"Bada God i viararamaniu aiwai ana latoni,","poem":1},{"text":"da ḡokokokarai ma peupeui ana vovairewapani.","poem":2},{"text":"Ubaubanai patapatai e ravidagudaguiu,","poem":1},{"text":"ma taniḡau a tonetonei da","poem":2},{"lineBreak":true},{"text":"ana rautaniḡanana ma ana viararamana kaua.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bada God aramana i vereu","poem":1},{"text":"ma eḡa ata pariḡaiei bo ata mae-puputei.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uporau a verei da i kwapu-kauei,","poem":1},{"text":"ma a voterei da mutuorou i amui.","poem":2},{"text":"Eḡa naou ata govaḡi maranai i vinimalamalaiu","poem":1},{"text":"ma naou i ovai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wate Bada God au muriu e maimairi,","poem":1},{"text":"lamna aubaina eḡa ita vitepaubaubaiu.","poem":2},{"text":"A vokaukaua da ana nebelei,","poem":1},{"text":"aramanei da eḡa ina vinimalamalaiu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"God au ririvau, ma ina vitaubabani aubaiu.","poem":1},{"lineBreak":true},{"text":"Tauna ina riwemi da tau eḡa aiwai ata kauana-boai.","poem":1},{"text":"Aiai ina viwavuiu?","poem":2},{"text":"Tana nae tana etara","poem":1},{"text":"Au ḡavia mepa, taumi ona nei?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anina Bada tauoina e gagagaloeiu,","poem":1},{"text":"Aiai ina riwei da tau a kauana-boai?","poem":2},{"text":"Taui anatapui ina gumaḡa me gara wadubona.","poem":1},{"text":"Komaḡana ina ambaubauni.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":6}