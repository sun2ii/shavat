{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":52,"content":[{"type":"heading","content":["Bada ana vilawana e nenei"]},{"type":"verse","number":7,"content":[{"text":"I ai ḡaḡa, taupariverena a inanai olei e taḡotaḡonai.","poem":1},{"lineBreak":true},{"text":"Riwa Aiaina e jimejimei:","poem":1},{"text":"nuauba ma nuaiaii riwai","poem":2},{"lineBreak":true},{"text":"ma Bada ana vilawana.","poem":2},{"text":"Ma Zion i riwei, “Ami God e vivibada.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ona rautaniḡana! Ami tauvineneḡana e vigaragararei;","poem":1},{"text":"ana morelanai e logologoi;","poem":2},{"text":"Taui mataiei Bada i ʼnanai","poem":1},{"text":"e nenememei au Zion.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jerusalem wanarikarikana,","poem":1},{"text":"ana morelanami ona wela-gogona Bada awarina.","poem":2},{"text":"Tauna ana rava i vinuaubai,","poem":1},{"text":"ma ana melagai Jerusalem, i vai-melei.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dobu anatapui au matai","poem":1},{"text":"ana rewapana vivivireina e vivieḡai.","poem":2},{"text":"Rava anatapui au dobu","poem":1},{"text":"Bada ana vilawana, ina inanai.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Taunola ana vinuapoapoe ma ana boruma."]},{"type":"verse","number":13,"content":[{"text":"Bada i riwa, “Au taunola ana nola ina kauana-kauei!","poem":1},{"text":"Rava tauna ina voepai au tepa dewadewana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Au naona rava maḡamaḡaui tauna i ʼnanai","poem":1},{"text":"ma i virovorovoanei.","poem":2},{"text":"I vunu-kauei ma i vitaratarai;","poem":1},{"text":"da inanana eḡa me rava.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wate marina dobu patarai ina raviḡori","poem":1},{"text":"ma gulagulau gamoi i pota tauna voepaepa aubaina.","poem":2},{"text":"Eḡa ita pariverei,","poem":1},{"text":"marina mataiei ina inanai,","poem":2},{"lineBreak":true},{"text":"ma aiwai eḡa ita nonori, ina aramanei.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":7}