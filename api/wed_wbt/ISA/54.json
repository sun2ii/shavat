{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":54,"content":[{"type":"heading","content":["Bada ana nuavaina Zion aubaina."]},{"type":"verse","number":4,"content":[{"text":"Eḡa ona rovo aubaina eḡa ina vitepa-ubaubaimi.","poem":1},{"text":"Tepami ina tora, eḡa ina vinimalamalaimi.","poem":2},{"text":"Ami laraga kauai nunuami ina vuru.","poem":1},{"text":"Ami vikaiababa nuabolana ina amoa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aubaina, taukauem lamna awam,","poem":1},{"text":"wavana Bada Vivirewapana Kaukauana.","poem":2},{"text":"Israel ana God Vivivireina am taugimaramelana,","poem":1},{"text":"Tauna dobu anatapuna ai God.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Israel, tam me wavine tavine vouvou","poem":1},{"text":"ma awam i geduaiem ma u vinuabola kaua.","poem":2},{"text":"Wate Bada ina ḡore-melem awarina ma ina pa,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“A voterem mara aburuna,","poem":1},{"text":"wate raunuapoapoe ḡaeḡaenei ana vaimelem.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Au meji i rata kaua da a mae-puputem mara aburuna.","poem":1},{"text":"Wate au nuavaina mamae-nonoanei,","poem":2},{"lineBreak":true},{"text":"ana raunuapoapoelem.”","poem":2},{"lineBreak":true},{"text":"Bada taugimaramelana i riwa me,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Awariu, wei me Noah ana au mara,","poem":1},{"text":"maranai parivainuaḡana bagibagina a kauei","poem":2},{"lineBreak":true},{"text":"da eḡa melanai wairei dobu ana purui-melei.","poem":2},{"lineBreak":true},{"text":"Marina, nanare parivainuaḡana bagibaginei a ririwem","poem":2},{"lineBreak":true},{"text":"da eḡa melana amlou ina ḡaiḡai da ana kovoḡimi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ola ina vidagu","poem":1},{"text":"ma ina amoa.","poem":2},{"text":"Wate, au nuavaina mamae-nonoana,","poem":1},{"lineBreak":true},{"text":"ma au nuauba mamae-nonoana tam awarimi ina mae-nonoa.”","poem":1},{"text":"Bada tauraunuʼapoapoelemi i riwa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}