{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":56,"content":[{"type":"heading","content":["Lawana rava anatapui aubaii"]},{"type":"verse","number":1,"content":["Bada wei e ririwei:",{"lineBreak":true},{"text":"“Aburuna ava, ana nei da ana vilawanimi","poem":1},{"text":"ma au viaiaina ana vieḡai.","poem":2},{"lineBreak":true},{"text":"Lamna aubaina, kaua aiaii","poem":1},{"text":"ma jijimanii ona kaukauei.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mai jentail, aiai da tau i vituraneu","poem":1},{"text":"ma i vitaunoleu, ma wavau","poem":2},{"text":"i vinuavainei ma i vimaeḡaeḡaeniu.","poem":1},{"text":"Au Sabate i vivirei,","poem":2},{"lineBreak":true},{"text":"ma au parivainuaḡana bagibagina e vovojijina-kauei.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taui ana neiai au ola vivivireina - Zion","poem":1},{"text":"ma nuaiai ana verei au parinumana.","poem":2},{"text":"Ma ai pulo e apuapui awariu ana vianinei.","poem":1},{"lineBreak":true},{"text":"Anina ma rava, au tempol ina ḡorei pari numana,","poem":1},{"text":"dam anatapui au dobu aubaii.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":3}