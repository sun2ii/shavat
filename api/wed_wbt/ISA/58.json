{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":58,"content":[{"type":"heading","content":["Uji ririwa kauana."]},{"type":"verse","number":7,"content":[{"text":"“Am-irairaḡei lam ona taraiḡuei,","poem":1},{"text":"ma ami numa ona votawanei,","poem":2},{"lineBreak":true},{"text":"nelabalabai ma vinuapoapoe awarii.","poem":2},{"text":"Kovakovai gara ona vioteni,","poem":1},{"text":"ma taraoim eḡa ona inana-tawanei.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Maranaina, au viaiaina ina ravilalaimi me maratomtom madeḡana,","poem":1},{"text":"ma ami doria laḡilaḡina ana vilawani.","poem":2},{"text":"Au naomi ana nae da ami aninae ana vovaijijimani,","poem":1},{"text":"ma murimiei, au boruma ina gagaloemi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nai maranaina ona viḡore ma Tau Bada, ana paribelemi.","poem":1},{"text":"Agu ona gararei ma ana riwa, ‘Tau weka.”","poem":2},{"lineBreak":true},{"text":"“Eḡa rava, vita ona verei, eḡa ona viwavuwavu","poem":1},{"text":"ma eḡa babani morumorui ona kaukauei.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maranai am-irairaḡei o viambagibagi,","poem":1},{"text":"ḡokokokarai o vovoagui.","poem":2},{"text":"Lamnei, ami lalalaina gimtona ina lalai,","poem":1},{"text":"ina ravilalai me aubenai madeḡana.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":4}