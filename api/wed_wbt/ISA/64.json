{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":64,"content":[{"type":"heading","content":["Pari agu aubaina"]},{"type":"verse","number":4,"content":[{"text":"Oo Bada wariaḡa da marina, eḡa aiai god ḡelaui ponana ita nonori, ita inanai, bo ita aramana dadanei.","poem":1},{"lineBreak":true},{"text":"Anina Tam ainelam.","poem":1},{"text":"Taui da e vivipaipaiem e vovoagui.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tam kaua aiaii ravai e vovoagui,","poem":1},{"text":"am tarawatu e vovojijini.","poem":2},{"text":"Wate maranai ta ḡoʼapoapoe ḡiriḡiri","poem":1},{"text":"tam amlom e voḡaiḡai.","poem":2},{"text":"Aiwai aubaina ma vilawaniai?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anatapuiai a ḡoʼapoapoe,","poem":1},{"text":"Au matam, ai kaua jijimanii anatapui miramirai me gara wadubona.","poem":2},{"lineBreak":true},{"text":"Anataputa ta poipoi me ai-rugurugu,","poem":2},{"lineBreak":true},{"text":"Ata ḡoʼapoapoe e kapupuana-naieta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ma eḡa aiai wavam ita voepaepai","poem":1},{"text":"bo ita voguratei da naom ita inanai.","poem":2},{"text":"Lamna aubaina tam u netawanelai","poem":1},{"text":"da ai ḡoʼapoapoei e vunuvunuiai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wate Bada, tam amaiai.","poem":1},{"text":"Tauai dogodogo ma tam nau tauvoaina.","poem":2},{"lineBreak":true},{"text":"Tam anatapuiai uramei u rauḡaroḡaroelai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lamna aubaina, eḡa ma meji guratana awariai.","poem":1},{"text":"Ma eḡa ai ḡoʼapoapoe ma nota-nonoei.","poem":2},{"lineBreak":true},{"text":"Ma i ʼnanaiai, anatapuiai tam natunatum.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":6}