{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"ISA","translationId":"wed_wbt","name":"Isaiah","commonName":"Isaiah","title":"Peroveta Isaiah ana buka","order":23,"numberOfChapters":19,"sha256":"8942f347fb883ff14eb6d7a8192e5305876521acc388a1fa5829593d167787b9","firstChapterNumber":2,"firstChapterApiLink":"/api/wed_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/wed_wbt/ISA/64.json","totalNumberOfVerses":132},"chapter":{"number":9,"content":[{"type":"heading","content":["Awarita tevera i tupua"]},{"type":"verse","number":1,"content":["Taui i vivinuʼapoapoe, ai vinuapoapoe ina kwa. Rorova dobu Zebulun ma dobu Naphtali i kwalai",{"noteId":0},"ma i vinimalamalai, wate muriai dobuna ina viboruma-kauei. Galili, jentail ai dobu, au boga Mediteranean ina vikarei da maramatanei ina nae da waira Jordan au baba ḡelauna."]},{"type":"verse","number":2,"content":[{"text":"Taui waguwaguvareina taubabarai","poem":1},{"text":"lalaina ḡaeḡaena i ʼnanai;","poem":2},{"text":"Taui gimtona taumaenina","poem":1},{"noteId":1},{"text":"awarii lalalaina i lalai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tam ai dam u vimaḡai","poem":1},{"text":"ma ai nuaiai u viratai;","poem":2},{"text":"am viturana i vinuaiaiei;","poem":1},{"text":"me tuaruta au marana e vivinuaiai,","poem":2},{"lineBreak":true},{"text":"me sorodia e vivinuaiai,","poem":2},{"lineBreak":true},{"text":"maranai, ḡavia purapurai i tuarui, e ḡutaḡutai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aubaina, awarita tevera i tupua!","poem":1},{"text":"Tevera orotona i vereta!","poem":2},{"text":"Tauna ina vibada.","poem":1},{"lineBreak":true},{"text":"Tauna ina ḡorei:","poem":1},{"text":"Tauvinuaterena Aiaii telarana, God Vivirewapanana;","poem":2},{"lineBreak":true},{"text":"Amata Maemae Nonoana; Nuauba Badana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ana vigulau ma ana nuauba ina tua,","poem":1},{"text":"eḡa damona ita mamae.","poem":2},{"text":"Noina Gulau David ana au vigulau gabuna ina kiala,","poem":1},{"text":"ma nuavainei ma jijimaninei ina vibada kaua;","poem":2},{"lineBreak":true},{"text":"Ina mae-nonoa, marina da mara au damona.","poem":2},{"text":"Bada Vivivirewapana Kaukauana","poem":1},{"text":"ana nuavainei wei anatapuna ina kauei!","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"I pupuna-naiei au Assyria i vipanipani","reference":{"chapter":9,"verse":1}},{"noteId":1,"caller":"+","text":"Iraḡe paratana","reference":{"chapter":9,"verse":2}}]},"thisChapterLink":"/api/wed_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":5}