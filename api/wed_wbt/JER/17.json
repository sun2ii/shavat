{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"JER","translationId":"wed_wbt","name":"Jeremiah","commonName":"Jeremiah","title":"Peroveta Jeremiah ana buka","order":24,"numberOfChapters":8,"sha256":"732d1a7addb45cddea98fa173a3f88aa66fb6cb314e807dcff98c569b25de442","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/wed_wbt/JER/38.json","totalNumberOfVerses":45},"chapter":{"number":17,"content":[{"type":"heading","content":["Bada ona-vitumaḡanei"]},{"type":"verse","number":5,"content":[{"text":"Bada e ririwa,","poem":1},{"lineBreak":true},{"text":"“Aiavoi da ai vitumaḡana rava ota awarii e tereterei,","poem":1},{"text":"ma ai rewapana e vitumatumaḡaneiei;","poem":2},{"text":"ma e gedugeduaieu,","poem":1},{"text":"ana parivaiapoapoeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taui me, ai podapodai au dobu dariḡaḡa","poem":1},{"text":"eḡa aiwai aiaina ita inainanai.","poem":2},{"text":"Taui dobu au paipairana ina mae, ai ma modu eḡa,","poem":1},{"text":"me au dobu au vivibogana ita mamae kampa eḡa rava ita mamae.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wate aiavoi awariu e vivipatutu ma e vivitumaḡana da","poem":1},{"text":"Bada ai tepamairi, taui ana viaiaini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taui me ai, vuvura au adana i paewi,","poem":1},{"text":"ma warami i ḡaira waira au orana.","poem":2},{"text":"Eḡa marapoi ina rovoei,","poem":1},{"text":"ma rugurugui majimajiḡai ina maimairi.","poem":2},{"text":"Ma marapoi ana au mara,","poem":1},{"text":"eḡa ua ita vovoterei.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Rava nuapoui lamna morumoru kauana, i apoapoe kaua,","poem":2},{"lineBreak":true},{"text":"aiai i aramana-kauei, da ina vilawani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tau Bada rava nuapouii","poem":1},{"text":"a tuvirevirei ma kaua govagovaḡai au orai a inana-pai.","poem":2},{"text":"Rava anatapui ai kaua ana inanai.","poem":1},{"text":"ma ai kaua awarinei ana puloi.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JER/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JER/6.json","previousChapterAudioLinks":{},"numberOfVerses":6}