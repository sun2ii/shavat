{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"JER","translationId":"wed_wbt","name":"Jeremiah","commonName":"Jeremiah","title":"Peroveta Jeremiah ana buka","order":24,"numberOfChapters":8,"sha256":"732d1a7addb45cddea98fa173a3f88aa66fb6cb314e807dcff98c569b25de442","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/wed_wbt/JER/38.json","totalNumberOfVerses":45},"chapter":{"number":38,"content":[{"type":"heading","content":["Jeremiah waira dogona au orana."]},{"type":"verse","number":4,"content":["Babadai, gulau Zedekiah i riwei, “Wei ravanana Jeremiah tana viraḡeni. Ana babaniei, sorodia ruaḡauta lawalawai ma rava ḡelaui e viviorabadoi. Tauna eḡa rava ita vovoagui wate e viviorabadoi.”"]},{"type":"verse","number":5,"content":["Gulau i paribelei, “Tauna au urami, ami ḡoana nanare ona kauei. Tau eḡa ana viḡaemi.”"]},{"type":"verse","number":6,"content":["Ma Jeremiah i vaia ma i tere-ḡairei gulau natuna Malkijah, ana au dogo, wei lamna gulau ana sorodia ai au potuma au ririvana. Ma ḡuravei Jeremiah i tere-ḡairei au",{"noteId":0},"dogo. Au orana dogodogo ava, ma Jeremiah i monu ḡaira da i mairi dogodogo orana."]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Wei lamna wapaketa dogona, viutuvana aubaina.","reference":{"chapter":38,"verse":6}}]},"thisChapterLink":"/api/wed_wbt/JER/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/LAM/1.json","ne