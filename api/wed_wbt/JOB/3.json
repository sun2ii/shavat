{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"JOB","translationId":"wed_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":7,"sha256":"c030b906395556911eb93b9b06cf42977a8c74d07dafaf94880883c5543c9e08","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wed_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":3,"content":[{"type":"heading","content":["Job ana tupua marana i parivaiapoapoeni."]},{"type":"verse","number":1,"content":["Wiki tagogi au murina Job gamona i laḡi ma ana tupua marana i parivaiapoapoeni."]},{"type":"verse","number":2,"content":["I pa,"]},{"type":"verse","number":3,"content":[{"text":"Au tupua marana ma boai,","poem":1},{"text":"ma waguvaraina i vinolanola da tevera orotona i tupua.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nai marana ina waguvarei!","poem":1},{"text":"Ma God au aidamo wei marana ina nota-tawanei,","poem":2},{"lineBreak":true},{"text":"ma au tepana eḡa ina rarana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waguvara ma gimtona potopotona wei marana ina vibadei;","poem":1},{"text":"ma lada marana ina purui","poem":2},{"lineBreak":true},{"text":"ma gimtona lalalaina ina purui.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gimtona nai waguvaraina ina viamoai","poem":1},{"text":"wei marana eḡa ma iava-melei;","poem":2},{"lineBreak":true},{"text":"madeḡana bo nawaravina.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nai waguvaraina eḡa aiai ina tupua,","poem":1},{"text":"ma eḡa nuaiai gararana ina nonori.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vijiboḡa amamai,","poem":1},{"text":"mepa da ai vijiboḡa boga bariawana ina vidagui;","poem":2},{"lineBreak":true},{"text":"taui wei marana ina vijiboḡi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maratomtom ubonana ina ḡuvai","poem":1},{"text":"ma mara karena ina paina-avei","poem":2},{"lineBreak":true},{"text":"ma madeḡa vuduna eḡa ina inanai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aubaina taui manawa metaetana eḡa ita gudui","poem":1},{"text":"ma vita maḡamaḡaui i vereu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Airake, boiboḡi ita gomuiu!","poem":1},{"text":"Bo ata i ʼraḡe maranai a tuputupua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aiwai aubaina au arona i vimataveniu","poem":1},{"text":"ma ḡuḡunei i viḡuḡuiu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Maranaina a tupua, matau ita pota;","poem":1},{"text":"ma ata matave ma ata vilauvitau.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":13}