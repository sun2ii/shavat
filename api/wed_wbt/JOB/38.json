{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"JOB","translationId":"wed_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":7,"sha256":"c030b906395556911eb93b9b06cf42977a8c74d07dafaf94880883c5543c9e08","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wed_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":38,"content":[{"type":"heading","content":["Bada Job i paribelei"]},{"type":"verse","number":1,"content":["Ma Bada labu au orana ma Job i paribelei, i pa,"]},{"type":"verse","number":2,"content":[{"text":"“Tam aiai e bababani labalababa,","poem":1},{"text":"ma au nuaulaula e paripari-virevirei?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma mairi jijimana me oroto,","poem":1},{"text":"ana vitaravirevirem","poem":2},{"lineBreak":true},{"text":"ma ma paribeleu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tam mepa maranai dobu tuatuana i tonei?","poem":1},{"text":"Ma riweu, mepa da u aramanei?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aiai dobu ana manawa ma ana dabora i terei?","poem":1},{"text":"U aramanei tapa? Ma aiai i ruvai?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aiwai dobu tuatuana e vovojijini?","poem":1},{"text":"Ma aiai dobu tuatuana i tonei,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"maranai maratomtom ubonai i wela tagogi,","poem":1},{"text":"ma Bada ana anela ana morelanai i voepaepa ma i vigaragaraei?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aiai boga ana au parata i terei","poem":1},{"text":"maranai boga manawana ana goba i wanaiwaḡi?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":8}