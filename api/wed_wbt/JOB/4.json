{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"JOB","translationId":"wed_wbt","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":7,"sha256":"c030b906395556911eb93b9b06cf42977a8c74d07dafaf94880883c5543c9e08","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wed_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":4,"content":[{"type":"heading","content":["Eliphas i babani"]},{"type":"verse","number":1,"content":["Ma Eliphas rava Temanei Job i paribelei i pa,"]},{"type":"verse","number":2,"content":[{"text":"Job eḡa amlom ina ḡaiḡai ma ana babani,","poem":1},{"text":"tau ata genuana ava, ana babani!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rava maḡamaḡaui u viararamani","poem":1},{"text":"ma ḡokokokarai u vovaivirewapani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Riwam, rava peupeui u duḡui,","poem":1},{"text":"ma ae tutui viviarai u duḡui.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wate marina nuabola i nei awarim, ma am nota i peu","poem":1},{"text":"i vodadanim ma u rovo-kaua.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Am vitumaḡana God awarina,","poem":1},{"text":"ma am lawana jijimanina.","poem":2},{"lineBreak":true},{"text":"Lamna, am rewapana, tapa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma tumairi ma ma vinua notanota!","poem":1},{"text":"Rava jijimani e irairaḡe bo?","poem":2},{"lineBreak":true},{"text":"Mara aiwai rava jijimani i kero ma iʼraḡe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"A inanai rava ḡoa apoapoe i paewi","poem":1},{"text":"ma nuabola i tuarui.","poem":2},"Job ana rava amapo da i ririwa-ḡiriḡiri da tauna kaua apoapoei i kauei aubaina wei nuabolana e nenelaḡai. Wate Job e ririwa da tauna eḡa aiwai apoapoena ita kauei."]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}