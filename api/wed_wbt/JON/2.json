{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"JON","translationId":"wed_wbt","name":"Jonah","commonName":"Jonah","title":"Peroveta Jonah ana buka","order":32,"numberOfChapters":4,"sha256":"b0eb83ed2cdb07ce622a542359ea7d86f5aae6a08af44db6d224908c3777aa8b","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/wed_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Jonah ana pari"]},{"type":"verse","number":1,"content":["Jonah iana au manawana ma i raupari Bada, ana God awarina."]},{"type":"verse","number":2,"content":["I pa,",{"text":"“Au nuabola au orana a tou Bada awarina,","poem":1},{"text":"ma i paribeleu.","poem":2},{"text":"Irairaḡei, ai au dobu","poem":1},{"lineBreak":true},{"text":"ma agu a gararei","poem":1},{"text":"ma au tou u nonori.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Au gabinou u tawana ḡaireu,","poem":1},{"text":"boga au gabaura dewadewana.","poem":2},{"lineBreak":true},{"text":"Boga i kwaviviroiu.","poem":2},{"text":"Rabamam ḡaeḡaei i viaimonumonui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oo Bada! A notai da tau u tereopuneu,","poem":1},{"text":"ma a notai da eḡa melanai am tempol vivireina ana inana-melei.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Boga i puruiu","poem":1},{"text":"lavutui i tupo","poem":2},{"lineBreak":true},{"text":"ma aragoma kolau i pani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A monu ḡaira ola au kare dewadewana,","poem":1},{"text":"a vipanipani nai au dobuna,","poem":2},{"lineBreak":true},{"text":"dobuna metaetana guduguduna maemaena.","poem":2},{"text":"Wate tam Bada au God, u vilawaniu.","poem":1},{"text":"Lawalawaiu gabinouei u sinaepaiu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Malana a vaia au lawana i opuopu,","poem":1},{"text":"ma Bada a raupari awarim,","poem":2},{"lineBreak":true},{"text":"am au tempol, ma u nonoriu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Taui kokoitau labalababa e viviborumei,","poem":1},{"text":"am nuavaina mamae-nonoana i geduaiei.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wate tau ana welem, ana voepaepaim","poem":1},{"text":"ma au pulo ana apui awarim.","poem":2},{"lineBreak":true},{"text":"Au parivainuaḡa awarim ana kauei","poem":2},{"lineBreak":true},{"text":"lawana maemae nonoana Badei e nenei.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Ma Bada iana i egari da Jonah i medana-tawanei au gera."]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}