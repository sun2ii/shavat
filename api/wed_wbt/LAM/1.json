{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"LAM","translationId":"wed_wbt","name":"Lamentation","commonName":"Lamentation","title":"Lamentation Mogu Jerusalem aubaina","order":25,"numberOfChapters":2,"sha256":"0cdcb16223eee80fe90fcd3091cbdbd6d2d6e23859ecb4e320d76de7365fe00d","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/LAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/wed_wbt/LAM/3.json","totalNumberOfVerses":22},"chapter":{"number":1,"content":[{"type":"heading","content":["Jerusalem ana nuabola"]},{"type":"verse","number":1,"content":[{"text":"Kapore! Zion wariaḡa am patara i rata ḡaḡa, marina u kwakwava.","poem":1},{"text":"Dam patarai ai voepaepa, marina i vikaiababa.","poem":2},{"text":"Wariaḡa dobuḡela gulagulaui ai voepaepa. Tauna i ʼnana ḡaei.","poem":1},{"lineBreak":true},{"text":"Marina i vitaunola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E toutou maratom,","poem":1},{"text":"jirigwegwena au navanavana e toitoi.","poem":2},{"text":"Ana nuavainana maḡamaḡaui i ruba-tomana, eḡa aiai da ina vinuaubai.","poem":1},{"text":"Ana rava","poem":2},{"noteId":0},{"text":"anatapui i mae-puputei ma i viḡaviei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Judah i pani ma i pupuna-naiei.","poem":1},{"text":"Au dobu ḡela i vivipanipani,","poem":2},{"text":"e rarau-iviapoapoelei,","poem":1},{"text":"i vitaomana au dobuḡela.","poem":2},{"text":"Ḡavia i mae-kwaviviroi,","poem":1},{"text":"menanare ina onaḡanei?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zion etanaina e mogumogu","poem":1},{"text":"eḡa aiai kampa ita nenae torela aubaina.","poem":2},{"text":"Ana anirui i kwakwava,","poem":1},{"text":"Pirisi e gunugunura,","poem":2},{"text":"ana guguini e vivitouana;","poem":1},{"text":"Nuapouna i wanagwadgwadai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ana ḡavia i vibada,","poem":1},{"text":"au urai e mamae.","poem":2},{"text":"Bada nuabola ḡaeḡaena i neiai Zion awarina","poem":1},{"lineBreak":true},{"text":"aubaina ai ḡoʼapoapoe i rata.","poem":1},{"lineBreak":true},{"text":"Natunatui i paninaiei aueia, ai ḡavia au mataii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kapore wariaḡa Zion na!","poem":1},{"text":"Wavana naenaena, vinualaulaunana marina mepa?","poem":2},{"text":"Marina, Zion ana babada lamna me","poem":1},{"text":"deer, nuanuai i arelei ma i raumolaḡau ma lam i baiana-avei.","poem":2},{"text":"Inina i garigari","poem":1},{"text":"ma eḡa tagotagogina da ai ḡavia ina rubatawanei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zion i kwakwava, ravana eḡa.","poem":1},{"text":"Ana maura, wadubona e vinuanotenotei.","poem":2},{"text":"Maranai ana rava i peu ai ḡavia au urai, eḡa aiai ita nei da ita rauagui.","poem":1},{"text":"Ana ḡavia Zion ana peu i ʼnanai ma i vinamei.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Ana eririam lamna wapu god Baal ma Aserah ma mai Judah maḡamaḡaui wei god i voepaepai. Ana rava lamna tauviḡavia mai Egypt ma nanare maiteni i viturana ma maranai ḡavia i ḡetai taui i viruberubei.","reference":{"chapter":1,"verse":2}}]},"thisChapterLink":"/api/wed_wbt/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JER/38.json","previousChapterAudioLinks":{},"numberOfVerses":7}