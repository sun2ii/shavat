{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"LAM","translationId":"wed_wbt","name":"Lamentation","commonName":"Lamentation","title":"Lamentation Mogu Jerusalem aubaina","order":25,"numberOfChapters":2,"sha256":"0cdcb16223eee80fe90fcd3091cbdbd6d2d6e23859ecb4e320d76de7365fe00d","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/LAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/wed_wbt/LAM/3.json","totalNumberOfVerses":22},"chapter":{"number":3,"content":[{"type":"verse","number":19,"content":[{"text":"Bada, A tenam nae, eḡa matave kaua, iniviara maiteni,","poem":1},{"text":"a vinuapoapoe kaua, notana i viḡora kaua.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"A notanota-maelei","poem":1},{"text":"ma au orau a toutou.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wate Bada a vinua-notenotei ma orau e vovovaivirewapani. Lamnei a vitumaḡana:","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"da Bada ana nuavaina mamae-nonoana.","poem":1},{"text":"Ma ana raunuapoapoe eḡa ina kwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ubaubanai, e raviravivouni;","poem":1},{"text":"am vipatutu i rata kaua.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"A ririwana-meleu, Bada au buderi lamna a vivitumaḡanem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Taui daBada e vivitumaḡanei ma e baibaiei, ina viaiaini.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I ai da tana volaḡota ma Bada tana paini da ina vilawanita.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"I aii da vilamolamona ma nola ma aramanei. Am au vilaraga,","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"maranai Bada e viviaramanita,","poem":1},{"text":"ma mae genuatau.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tana mae-ḡaira au debidebi,","poem":1},{"text":"mepa da agu ina nei.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Navanavami ona verei da ina ravi, ma ina vijiboḡimi.","poem":1},{"text":"Wate eḡa ona vobelei aubaina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bada eḡa ina geduaiana-nonoeta.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Avena da maraḡela nuabola e neineiai, wate ana raunua apoapoe i rata kaua.","poem":1},{"text":"Aubaina ana nuavaina i rata kaua, eḡa damona.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Wate wei kauai eḡa ita vinuaiaiei.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}