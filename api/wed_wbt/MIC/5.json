{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"MIC","translationId":"wed_wbt","name":"Micah","commonName":"Micah","title":"Peroveta Micah ana buka","order":33,"numberOfChapters":2,"sha256":"c8f94bdc9801e02f4b6f9fb52c3f7fb544bdb9528ac4b55649373772e84a2ce3","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/MIC/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/wed_wbt/MIC/5.json","totalNumberOfVerses":4},"chapter":{"number":5,"content":[{"type":"heading","content":["Gulau meiei ina nei"]},{"type":"verse","number":1,"content":[{"text":"Sorodia ona vomairi! Ona vokaukaua!","poem":1},{"text":"Ḡavia Jerusalem i matave kwaipipini.","poem":2},{"text":"Israel ana gulau ina kwapui, jiḡonei navanavana ina kwapui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tam, Bethlehem Ephrathah,","poem":1},{"text":"melaḡai aburu oina dam Judah au orai.","poem":2},{"text":"Wate awarimiei, Israel ai gulau ina opu.","poem":1},{"lineBreak":true},{"text":"Tauna wariaḡana,","poem":1},{"text":"au karena da marina.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bada mai Israel i voterei ai ḡavia au urai,","poem":1},{"text":"da wavine marina au manawa, tevera orotona ina ḡuni.","poem":2},{"text":"Ma ai rava ḡelaui a tuvai-opunei,","poem":1},{"text":"ina nememei ai au gana au Israel.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tauna Bada ana rewapanei, ina mairi ma ana sipu ina raveni,","poem":1},{"text":"ana vinualaulaunei ma Bada wavana ḡaeḡaenei.","poem":2},{"text":"Rava anatapui au dobu, Tauna ina vivirana-kauei","poem":1},{"text":"ma lamna aubaina taui kampa ina mae-kaua.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ZEC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":4}