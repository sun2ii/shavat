{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"NUM","translationId":"wed_wbt","name":"Numbers - Au Mutulua","commonName":"Numbers - Au Mutulua","title":"Numbers Au Mutulua","order":4,"numberOfChapters":12,"sha256":"ca43bc9e5d0c754526bed5498c46b41ddf9b13a2e8ca28f627bd5ae6979b1373","firstChapterNumber":6,"firstChapterApiLink":"/api/wed_wbt/NUM/6.json","lastChapterNumber":35,"lastChapterApiLink":"/api/wed_wbt/NUM/35.json","totalNumberOfVerses":150},"chapter":{"number":23,"content":[{"type":"verse","number":18,"content":["Ma Balaam wei riwana i riwei i pa,",{"text":"“Balak, Zippor natuna ma vomairi;","poem":1},{"text":"ma Ma rautaniḡana kaua.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"God eḡa rava ota, Tauna eḡa ita morumoru.","poem":1},{"text":"Bo ana nota ita viravirai.","poem":2},{"text":"Tauna aiwai i babaniei,","poem":1},{"text":"nanare ina tupua","poem":2},{"text":"Aiwai i parivainuaḡani;","poem":1},{"text":"nanare ina kauei.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I riweu da wei ravai ana viaiaini;","poem":1},{"text":"maranai God e viaiaina, tau eḡa tagotagogina da ana virai.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bada ai God","poem":1},{"text":"taui maiteni e mamae, ma taui e vovoepaepai da Tauna ai gulau.","poem":2},{"text":"Tauna eḡa nuabola bo apoapoe ita neineiai Jacob ḡoḡoḡana - mai Israel awari.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"God taui Egyptei i tere-opunei,","poem":1},{"text":"Aubaii i viḡavia me bulumakau moduei.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Eḡa aiai Israel ina ḡaḡalei,","poem":1},{"text":"bo ina baravui.","poem":2},{"text":"Marina rava ina riwa,","poem":1},{"text":"‘Ona inanai God aiwai i kauei mai Israel aubai.’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mai Israel lamna me Lion vivirewapanana.","poem":1},{"text":"E vovomairi da ana ḡavia e viviraḡeni","poem":2},{"lineBreak":true},{"text":"ma tarana e umaumai,","poem":2},{"text":"Anina ma ina rauvirai da ina matave.”","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/NUM/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/NUM/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/NUM/22.json","previousChapterAudioLinks":{},"numberOfVerses":7}