},"nextChapterApiLink":"/api/wed_wbt/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":5}