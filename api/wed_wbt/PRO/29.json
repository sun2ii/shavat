{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PRO","translationId":"wed_wbt","name":"Proverbs - Nuaulaula Riwai","commonName":"Proverbs - Nuaulaula Riwai","title":"Proverbs Nuaulaula Riwai","order":20,"numberOfChapters":14,"sha256":"2e39503ffb8a719d8e87d39e8a08218e8b9426a37810c5802abe8deb228ca91f","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wed_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":29,"content":[{"type":"verse","number":3,"content":[{"text":"Aiai ravana nuaulaula i ḡoana-guratei, nuaiai ḡaeḡaena amana e vereverei.","poem":1},{"text":"Wate aiai da etanai waivinei maiteni e nenae lamna ana mane ma ana purapura anatapuna e vikalokaloei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kwapu ma nuaterena riwai, natum nuaulaula e vereverei.","poem":1},{"text":"Wate tevera eḡa viararamanana, alona e vivitepaubaubai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Natunatumi ona vinuaterenei, da mara nonoa awarim nuauba;","poem":1},{"text":"ma oram ina vinuaiaini.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":3}