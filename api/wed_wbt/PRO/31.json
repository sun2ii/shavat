{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PRO","translationId":"wed_wbt","name":"Proverbs - Nuaulaula Riwai","commonName":"Proverbs - Nuaulaula Riwai","title":"Proverbs Nuaulaula Riwai","order":20,"numberOfChapters":14,"sha256":"2e39503ffb8a719d8e87d39e8a08218e8b9426a37810c5802abe8deb228ca91f","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wed_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":31,"content":[{"type":"heading","content":["Wavine aiaii kaukauana"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mepa nanare wavine aiaina ma egoegolana uta nelaḡai?","poem":1},{"text":"Wavinena i vinualaulauna kaua eḡa me ḡaima lebalebarina maiana ḡaeḡaena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oroto awana i vitumaḡanei,","poem":1},{"text":"ma eḡa aiwai ina voladaḡei.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wavine, kaua aiaii ma eḡa kaua apoapoe ita neneiai awana awarina","poem":1},{"text":"ana lawana au anatapuna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wavine sipu aparana ma waiape i vaia","poem":1},{"text":"ma i vinuaiai da ina rauḡaroḡaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wavine sipu aparana ma waiape ina metani","poem":1},{"text":"ma gara ina ḡauḡauri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ana numa ma orana i votawanei","poem":1},{"text":"molamolakai ma vovoladaḡai awarii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Erawa lamna kaua morumoruna","poem":1},{"text":"ma inanana aiaina ina amoa;","poem":2},{"text":"wate wavine Bada e vivivirei, rava tauna ina voepaepai.","poem":1}]},{"type":"verse","number":31,"content":[{"text":"Wavinena ina voepaepai aubaina i kauana-kauei.","poem":2},{"text":"Rava anatapui, wei wavinena ona voepaepai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":8}