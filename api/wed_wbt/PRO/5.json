{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PRO","translationId":"wed_wbt","name":"Proverbs - Nuaulaula Riwai","commonName":"Proverbs - Nuaulaula Riwai","title":"Proverbs Nuaulaula Riwai","order":20,"numberOfChapters":14,"sha256":"2e39503ffb8a719d8e87d39e8a08218e8b9426a37810c5802abe8deb228ca91f","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wed_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":5,"content":[{"type":"heading","content":["Wavine matana maḡamaḡauna ma vorei"]},{"type":"verse","number":8,"content":[{"text":"Wavine matana maḡamaḡauna ma ruba-tawanei!","poem":1},{"text":"Eḡa ma nae dadana ana au metaeta!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mepa da nanare lamna rava eḡa ina vivivirem.","poem":1},{"text":"Tam am vilaraga ma am lawana aiaina ma vitupoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bada rava ai kaua anatapui e inainanai,","poem":1},{"text":"Metauna etanaina e vaivaia, tauna kampa da e inana-vaitetem.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taniḡapota ravana ana ḡoʼapoapoelei ina waro-melei.","poem":1},{"text":"Ana ḡoʼapoapoe tauna ina tupajijini.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tauna opaopana ma eḡa ita paina-melei,","poem":1},{"text":"Ana kaua opaopai aubaii iʼraḡe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":5}