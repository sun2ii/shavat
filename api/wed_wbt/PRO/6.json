{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PRO","translationId":"wed_wbt","name":"Proverbs - Nuaulaula Riwai","commonName":"Proverbs - Nuaulaula Riwai","title":"Proverbs Nuaulaula Riwai","order":20,"numberOfChapters":14,"sha256":"2e39503ffb8a719d8e87d39e8a08218e8b9426a37810c5802abe8deb228ca91f","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wed_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":6,"content":[{"type":"heading","content":["Amam ma alom ai vinuaterenana"]},{"type":"verse","number":20,"content":[{"text":"Natu, amam ma alom ai vinuaterena anatapui ma voteletelei.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma vojijina-kauei au nuanuam; marana patapatai au uam ma gadoi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Maranai e bababara, ai vinuaterena am etanai ina rauḡadaḡadari.","poem":1},{"text":"Maranai e matamatave, ai vinuaterena ina matave-painim.","poem":2},{"lineBreak":true},{"text":"Maranai u vomairi, ai vinuaterena awarim ina babani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Aubaina wei tarawatui lamna rampa.","poem":1},{"text":"Wei viararamana lamna ravilala, etanaina e lalalai.","poem":2},{"lineBreak":true},{"text":"Nuaterena bagibagina lamna lawana aiaina etanaina.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Taui ina aguim da wavine matai maḡamaḡaui ma vorei,","poem":1},{"text":"ma wavine tavitavinena ana gwalameru.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Eḡa wavinena inana aiaina ma erawei.","poem":1},{"text":"Eḡa! Ma voterei da matanei oram ina taini da ina waroim.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}