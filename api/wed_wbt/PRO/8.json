{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PRO","translationId":"wed_wbt","name":"Proverbs - Nuaulaula Riwai","commonName":"Proverbs - Nuaulaula Riwai","title":"Proverbs Nuaulaula Riwai","order":20,"numberOfChapters":14,"sha256":"2e39503ffb8a719d8e87d39e8a08218e8b9426a37810c5802abe8deb228ca91f","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wed_wbt/PRO/31.json","totalNumberOfVerses":56},"chapter":{"number":8,"content":[{"type":"heading","content":["Bada nuaulaula i terei"]},{"type":"verse","number":22,"content":[{"text":"“Au karena, Bada tau i tereu.","poem":1},{"text":"Muriai da aiwai ḡelaui i kauei.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tau kampa au kare oina,","poem":1},{"text":"muriai da dobu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tau a tupua muriai da Bada gabinou i kauei,","poem":1},{"text":"muriai da waira vuvura i kwakwa-ḡetai.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tau a tupua muriai da ola,","poem":1},{"text":"muriai da ola muomuoi ai au gabu i terei, tau kampa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Muriai da dobu bo wapu","poem":1},{"text":"bo doa pokauna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tau kampa maranai mara ana au gabu i terei,","poem":1},{"text":"maranai parata i taini da mara au tepana ma boga au gabaura.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Maranai apau i terei au mara","poem":1},{"text":"ma vuvura doa au orana i votawanei.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tau kampa, ma boga ana parata i terei","poem":1},{"text":"ma i egari da nai paratana eḡa ina raḡoni.","poem":2},{"text":"Tau kampa, maranai dobu oḡona i tonana-naiei.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"Nai marana tau Bada au ririvana a mamae me tauvioga,","poem":2},{"text":"marana patapatai a vinuaiaini ma tau a vinuaiai.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"A vinuaiai kaua maranai dobu i kaukaueia a inanai,","poem":1},{"text":"a vinuaiai kaua maranai rava a inanai.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":10}