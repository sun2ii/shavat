":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}