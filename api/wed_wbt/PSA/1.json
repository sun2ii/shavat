{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PSA","translationId":"wed_wbt","name":"Psalm - Wela ma Pari","commonName":"Psalm - Wela ma Pari","title":"Psalm Wela ma Pari","order":19,"numberOfChapters":14,"sha256":"77a68631b7e61d619d313dbc51c1e9ae6d489b898e083b33f5a207f21aa5527e","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/wed_wbt/PSA/139.json","totalNumberOfVerses":184},"chapter":{"number":1,"content":[{"type":"heading","content":["Nuaiaii ririwa-kauana"]},{"type":"verse","number":1,"content":[{"text":"Rava viaiainana, lamna eḡa ḡoʼapoapoe ravai ita votaḡotaḡoi,","poem":1},{"text":"ma ponai eḡa ita rarautaniḡanei;","poem":2},{"lineBreak":true},{"text":"ma vivijiboḡai eḡa awarii ita kiakiala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wate Bada ana tarawatu i vinuaiaiei,","poem":1},{"text":"aupom ma marai e notanota-vaitetei.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tauna me ai, waira au adana gogogona,","poem":1},{"text":"ana au mara e rarauano;","poem":2},{"lineBreak":true},{"text":"ma rugurugui eḡa ita poipoi.","poem":2},{"text":"Wei ravanana, aiwai anatapuna e kaukauana-kauei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wate ḡoʼapoapoe ravai eḡa nanare!","poem":1},{"text":"Taui me rugurugu, ive i kapupuana-naiei;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lamna aubaina ḡoʼapoapoe taukauei Bada ana au etera ita mairi ava,","poem":1},{"text":"ma nanare ḡoa apoapoei ta kauei rava jijimani ai au dam ita mae ava.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bada ḡoa aiaii ravai e rarauetaraveni ma e paipaini;","poem":1},{"text":"wate ḡoʼapoapoe ai etanai au damona, pupui.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}