{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PSA","translationId":"wed_wbt","name":"Psalm - Wela ma Pari","commonName":"Psalm - Wela ma Pari","title":"Psalm Wela ma Pari","order":19,"numberOfChapters":14,"sha256":"77a68631b7e61d619d313dbc51c1e9ae6d489b898e083b33f5a207f21aa5527e","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/wed_wbt/PSA/139.json","totalNumberOfVerses":184},"chapter":{"number":100,"content":[{"type":"heading","content":["Voepaepa welana"]},{"type":"verse","number":1,"content":[{"text":"Rava anatapumi au dobu ona logoimi Bada awarina!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ana nuaiaimi Bada ona voepaepaei,","poem":1},{"text":"ona nei au naona ma ona welei.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ona aramanei da Bada anina God.","poem":1},{"text":"Tauna i kaueta.","poem":2},{"lineBreak":true},{"text":"Ma tauta tauna ḡarinei. Tauta tauna natunatuna. God ana sipu ma e gagaloeta me sipu taupainina.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ana welami ana au gari ona rui ma voepaepami","poem":1},{"text":"ana au aniviboru ona rui,","poem":2},{"lineBreak":true},{"text":"ma ona vimaeḡaeḡaeni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aubaina Bada i aii;","poem":1},{"text":"natunatuna e vivinuavaina-nonoei,","poem":2},{"lineBreak":true},{"text":"ana vipatutu e mamae-nonoa, kimta au anatapui.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":5}