{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PSA","translationId":"wed_wbt","name":"Psalm - Wela ma Pari","commonName":"Psalm - Wela ma Pari","title":"Psalm Wela ma Pari","order":19,"numberOfChapters":14,"sha256":"77a68631b7e61d619d313dbc51c1e9ae6d489b898e083b33f5a207f21aa5527e","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/wed_wbt/PSA/139.json","totalNumberOfVerses":184},"chapter":{"number":110,"content":[{"type":"heading","content":["Gulauna vinevinena"]},{"type":"hebrew_subtitle","content":["David ana wela"]},{"type":"verse","number":1,"content":[{"text":"Bada au bada wenanare i riwei,","poem":1},{"text":"“Au oieu ma kiala","poem":2},{"text":"da am ḡavia","poem":1},{"text":"au ae karem ana terei da ma tuvaidoedoei.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bada, am gabemani vivirewapanana Zion","poem":1},{"noteId":2},{"text":"ana parata ina viratai,","poem":1},{"text":"da am ḡavia ma vibadei.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Am laraga ana nuaii ina verena-melei da ina visorodia,","poem":1},{"text":"ma ona ḡae Bada ana ola au tepana viḡavia aubaina,","poem":2},{"text":"ma ami rewapana ina ravivouni ubaubanai patapatana me ubaubanai turuvanina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bada i parivainuaḡanim ma eḡa nuanuana ina virai;","poem":1},{"text":"“Tam pirisi maemae nonoana me Melkisedek.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bada au oiem e maimairi da e paipainim;","poem":1},{"text":"tauna gulagulau ina piaḡi maranai amlona ina ḡaiḡai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dobu nununai ai ḡoa apoapoe ina kovoḡi,","poem":1},{"text":"ma taubeu dobuna ina vioai","poem":2},{"lineBreak":true},{"text":"ma dobu gulagulaui anatapui kolai ina viaigwadagwadai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wate au etanai au vuvura ina uma","poem":1},{"text":"ma rewapana ina verei ma ina vovaiuba.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Jerusalem wavana ḡelauna.","reference":{"chapter":110,"verse":2}}]},"thisChapterLink":"/api/wed_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":7}