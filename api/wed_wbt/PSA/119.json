":"verse","number":15,"content":[{"text":"Riwam ana iavi","poem":1},{"text":"ma ana vinuanotenotei.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Am tarawatu a vinuaiaina-kauei,","poem":1},{"text":"eḡa riwam ana voteretawanei.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":8}