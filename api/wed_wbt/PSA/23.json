{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PSA","translationId":"wed_wbt","name":"Psalm - Wela ma Pari","commonName":"Psalm - Wela ma Pari","title":"Psalm Wela ma Pari","order":19,"numberOfChapters":14,"sha256":"77a68631b7e61d619d313dbc51c1e9ae6d489b898e083b33f5a207f21aa5527e","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/wed_wbt/PSA/139.json","totalNumberOfVerses":184},"chapter":{"number":23,"content":[{"type":"heading","content":["Bada taupainiu23:0 Taupainiu me sipu taupainina."]},{"type":"hebrew_subtitle","content":["David ana wela"]},{"type":"verse","number":1,"content":[{"text":"Bada taupainiu","poem":1},{"text":"ma eḡa aiwai ana voladaḡei.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gidagida majimajiḡai au tepana i vimataveniu,","poem":1},{"text":"ma i raveniu waira au raraunairina au adana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Au rewapana e raviravivouni","poem":1},{"text":"ma wavana aiaina aubaina etanai jijimaninei i raveniu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Avena da gwagwa waguwaguvareina ana naeni,","poem":1},{"text":"wate eḡa aiwai apoapoena ana rovoei.","poem":2},{"lineBreak":true},{"text":"Aubaina tam au ririvau da am kwapuei ma jiḡonei e gagagaloeu ma e vivinuaubaiu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aubaiu torela e vokaukauei au ḡavia au naoi.","poem":1},{"text":"O