{"translation":{"id":"wed_wbt","name":"Wedau Mark","website":"https://ebible.org/Scriptures/details.php?id=wed","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wed","licenseNotes":null,"shortName":"WBT","englishName":"Wedau Mark","language":"wed","textDirection":"ltr","sha256":"1f27055426f1c0ff8bea43f7f1f6c2e713ff41af86679f89c701ce97a7e55e5e","availableFormats":["json"],"listOfBooksApiLink":"/api/wed_wbt/books.json","numberOfBooks":30,"totalNumberOfChapters":273,"totalNumberOfVerses":4102,"languageName":"Wedau","languageEnglishName":"Wedau"},"book":{"id":"PSA","translationId":"wed_wbt","name":"Psalm - Wela ma Pari","commonName":"Psalm - Wela ma Pari","title":"Psalm Wela ma Pari","order":19,"numberOfChapters":14,"sha256":"77a68631b7e61d619d313dbc51c1e9ae6d489b898e083b33f5a207f21aa5527e","firstChapterNumber":1,"firstChapterApiLink":"/api/wed_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/wed_wbt/PSA/139.json","totalNumberOfVerses":184},"chapter":{"number":67,"content":[{"type":"heading","content":["Viegualau welana"]},{"type":"verse","number":1,"content":[{"text":"Oo God ma raunuʼapoapoelelai ma ma viaiainiai,","poem":1},{"text":"ma naom weka ma tereiai da ma voaguiai!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Da au dobu am kaua ina aramanei,","poem":1},{"text":"da rava anatapui au dobu ina aramanei da tam ai tauvilawana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rava ina voepaepaim Oo God,","poem":1},{"text":"rava anatapui ina vimaeḡaeḡaenim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rava anatapui au dobu ina vinuaiai ma ana morelanai ina wela,","poem":1},{"text":"aubaina tam rava anatapui au dobu, kaua jijimaninei e vivibadei","poem":2},{"lineBreak":true},{"text":"ma e paipaini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rava ina voepaepaim Oo God.","poem":1},{"text":"Rava anatapui ina voepaepaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anina ma doa maura ḡaeḡaena ina vereta","poem":1},{"text":"ma God ina viaiaina-kaueta","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Riwa kaua, God ina viaiainita","poem":1},{"text":"ma rava anatapui au dobu tauna ina vivirei.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wed_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wed_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wed_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":7}