{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"heading","content":["Pujimo Kawasana Opu i nuncana Bhanuana"]},{"type":"verse","number":1,"content":["Zaburu to kurubani kasukuru.",{"lineBreak":true},{"text":"Sambo-sambomo to KAWASANA OPU, e saangua alamu!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Sambaheamo i KAWASANA OPU tee ukaunde-undemo,","poem":2},{"lineBreak":true},{"text":"umbamo i aroana tee ulaguaka lagu-lagu momasanaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mataumea ande o KAWASANA OPU sumai o Aulataʼala.","poem":1},{"text":"Inciamo manga padhaangiana, tee ingkita o pewauana;","poem":2},{"lineBreak":true},{"text":"ingkitamo o uumatina tee dumba-dumba igembalana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pesuamo ulaloi bhambana lawana upoose ulaguaka lagu kasukuru,","poem":1},{"text":"upesua i aroana Bhanuana Aulataʼala upoose upujia.","poem":2},{"lineBreak":true},{"text":"Sukurumo i Incia tee upujimo sarona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Roonamo o KAWASANA OPU sumai amalape;","poem":1},{"text":"kaasina molagina abakaa saʼumurua,","poem":2},{"lineBreak":true},{"text":"tee Incia akeni janjina saʼumurua zamani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}