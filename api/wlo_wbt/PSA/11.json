{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":11,"content":[{"type":"heading","content":["KAWASANA OPU Tampana Peulusa"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Zaburuna Daud.",{"lineBreak":true},{"text":"Iaku kupeulu i KAWASANA OPU;","poem":1},{"text":"inda tee faʼedana upogau tee iaku,","poem":2},{"lineBreak":true},{"text":"\"Pasalaamatimea o karomu mboomo manu-manu mopolakana i gunu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Roonamo mia madhaki apekangkanamo panana","poem":1},{"text":"tee apasa matana panana","poem":2},{"lineBreak":true},{"text":"to apana mia momakatena incana i tampa momalalanda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ande o tuturana raʼeatina atopahancuru,","poem":1},{"text":"mia mobanara inda amembali apewau opeopea.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"KAWASANA OPU dhaangia i nuncana Baitulla momangkilo,","poem":1},{"text":"kauncuramakana KAWASANA OPU dhaangia i sorogaa.","poem":2},{"text":"Incia atiliki maanusia","poem":1},{"text":"tee amataua sabhara ipewauna manga incia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"KAWASANA OPU auji mia mobanara tee mia madhaki,","poem":1},{"text":"Incia abanci mia mopewauna kasega.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Incia bheapadhaangia balaa to mia madhaki tee apasapoakea tee waa morore tee walera,","poem":1},{"text":"tee ngalu imangauaka siitumo to kahukumuna mia madhaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sababuna KAWASANA OPU aʼadili,","poem":1},{"text":"Incia amaasiaka kabanara.","poem":2},{"lineBreak":true},{"text":"Mia momakatena incana bheakamata tee bheamatau Incia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}