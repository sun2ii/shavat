{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":113,"content":[{"type":"heading","content":["Kawasana Opu Apekalanga Mia Momaidhiidhi"]},{"type":"verse","number":1,"content":["Pujimea o KAWASANA OPU!",{"text":"Pujimea, e manga bhatuana KAWASANA OPU,","poem":1},{"text":"pujimea o sarona KAWASANA OPU!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bhari-bharia kapujia to sarona KAWASANA OPU,","poem":1},{"text":"sii-sii sampe saʼumurua!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pepuu minaaka i abhete matanaeo sakawana asoo matanaeo,","poem":1},{"text":"sarona KAWASANA OPU alaenga atopuji.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"KAWASANA OPU amalanga tee akokuasa i bhawona bhari-bharia lipu,","poem":1},{"text":"tee kamuliangina alabhi amalanga minaaka i laiana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Incema buaka mboomo KAWASANA OPU, Aulataʼalata,","poem":1},{"text":"mokokauncuramakana i tampa momalanga,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"tee mopaʼungkona karona to apotonto","poem":1},{"text":"i laiana tee i alamu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Incia aangka mia misikini minaaka i ngawu,","poem":1},{"text":"tee apalimba mia monarakaa minaaka i kabumbuna ngawu","poem":2}]},{"type":"verse","number":8,"content":[{"text":"to apauncura manga incia aposaangu tee manga kaogesa","poem":1},{"text":"minaaka i uumatina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Incia arahumatiakea anaana i manga bhawine mokomba,","poem":1},{"noteId":79},{"text":"sabutuna o bhawine sumai akaunde-unde i nuncana bhanuana.","poem":2},{"lineBreak":true},{"text":"Pujimea o KAWASANA OPU!","poem":2}]}],"footnotes":[{"noteId":79,"caller":"+","text":"bhawine mokomba: Bhawine inda momembalina mokoana.","reference":{"chapter":113,"verse":9}}]},"thisChapterLink":"/api/wlo_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}