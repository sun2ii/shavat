{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":116,"content":[{"type":"heading","content":["Alapa minaaka i Katapu Imateaka"]},{"type":"verse","number":1,"content":[{"text":"Iaku kumaasiaka KAWASANA OPU, sababuna Incia arango","poem":1},{"text":"goraku tee bhari-bharia iemaniku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Roonamo Incia aperangoiaku,","poem":1},{"text":"sumaimo bhekugora i Incia saʼumurua dhadiku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Manga katapu imateaka abulilingiaku,","poem":1},{"text":"kanarakaa i nuncana koburu angkakanaiku,","poem":2},{"lineBreak":true},{"text":"iaku kunamisi kaseke tee kaporo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kasiimpo kugoraaka sarona KAWASANA OPU,","poem":1},{"text":"\"E KAWASANA OPU, pasalaamatia o inyawaku!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"KAWASANA OPU satotuuna amalape tee abanara;","poem":1},{"text":"Aulataʼalata satotuuna amaasiaka uumatina.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"KAWASANA OPU ajagani manga mia inda momembalina motulungina karona.","poem":1},{"text":"Wakutuuna inda tee kakaaku, Incia mopasalaamatiaku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E ngangarandaku, tanangimo pendua","poem":1},{"text":"roonamo KAWASANA OPU padhamo apewau malape tee ingkoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"E KAWASANA OPU, Ingkoo padhamo upasalaamati inyawaku minaaka i mate,","poem":1},{"text":"ujagani mataku mamudhaakana inda kutangi,","poem":2},{"lineBreak":true},{"text":"tee upekatangka aeku mamudhaakana inda atosunu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iaku bhekudhala i aroana KAWASANA OPU,","poem":1},{"text":"i lipuna manga mia modhadhi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iaku sadhaadhaa kuparacaea, moomini wakutuuna kupogau,","poem":1},{"text":"\"Iaku kunarakaa mpuu.\"","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I wakutuuna kubingu kupogau,","poem":1},{"text":"\"Bhari-bharia mia inda amembali atoparacaea.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Opea buaka momembalina ipasombaakaku i KAWASANA OPU to kubalasiaka","poem":1},{"text":"bhari-bharia kalapena incana to karoku?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iaku bhekuangka tondena kasalaamati","poem":1},{"noteId":81},{"text":"tee kugoraaka sarona KAWASANA OPU.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iaku bhekutolosi tolauna oniku i KAWASANA OPU","poem":1},{"text":"i aroana bhari-bharia uumatina.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akoharagaa i matana KAWASANA OPU","poem":1},{"text":"matena manga mia mosaalihi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"E KAWASANA OPU, satotuuna iaku sii o bhatuamu.","poem":1},{"text":"Iakumo bhatuamu, o anana minaaka i bhatuamu bhawine.","poem":2},{"lineBreak":true},{"text":"Ingkoo padhamo urambasakaaku minaaka i kabhokeku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Iaku bhekupasombaaka kurubani sukuru to Ingkoo","poem":1},{"noteId":82},{"text":"tee kugoraaka sarona KAWASANA OPU.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iaku bhekutolosi tolauna oniku i KAWASANA OPU","poem":1},{"text":"i aroana bhari-bharia uumatina,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"i tanalapana Baitullana KAWASANA OPU,","poem":1},{"text":"i tanga-tangamu, e Yerusalem!","poem":2},{"lineBreak":true},{"text":"Pujimea o KAWASANA OPU!","poem":2}]}],"footnotes":[{"noteId":81,"caller":"+","text":"tondena kasalaamati: Miana Israel kananeana apasombaaka angguru i nuncana tonde to tandana asukuru roonamo padhamo apasalaamatia Kawasana Opu.","reference":{"chapter":116,"verse":13}},{"noteId":82,"caller":"+","text":"pasombaaka kurubani sukuru to Ingkoo: Kawasana Opu inda afaraluu opeopea to atopasombaaka i Incia (kamata Zab. 50:9-13). Bhari-bharia ipasombaaka satotuuna to amuliangi Incia, asukuru i Incia, tee mamudhaakana audhania Aulataʼala.","reference":{"chapter":116,"verse":17}}]},"thisChapterLink":"/api/wlo_wbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}