{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":119,"content":[{"type":"heading","content":["Amasanaamo Mia Moosena Hukumuna KAWASANA OPU119:0 Zaburu 119 akoantoaka manga kapujia to Hukumuna Aulataʼala idhawuakana to miana Israel alaloi Nabii Musa. Zaburu 119 apake modele akrostik (apokana tee Zaburu 9-10, 25, 34, 37, 111, 112). Polanciringana pogau akrostik asusuaka modelena kabhanti mopakena horofu Ibrani atosau-sau malape i auwalina saasaangu aeati. Jadi, walu aeati i nuncana weta bhaa-bhaana i nuncana Zaburu 119 apepuungia tee horofu Ibrani, alef; walu aeati i nuncana weta iruaanguna apepuungia tee horofu iruaanguna oni Ibrani, bet; walu aeati i nuncana weta italuanguna apepuungia tee horofu italuanguna oni Ibrani, gimel; tee mosagaanana uka.119:0 Zaburu 119 apogauakea ande manga hukumu ipakawaakana i Musa, siitumo o Taurati, giu incia sumai aminaaka i Aulataʼala, mencuana minaaka i maanusia. Kawasana Opu mokarajaaia tee mopatotapua."]},{"type":"verse","number":1,"content":[{"text":"Amasanaamo mia modhadhina inda tee kasalahana,","poem":1},{"text":"tee adhadhi aose hukumuna KAWASANA OPU.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amasanaamo mia moosena manga tuturana,","poem":1},{"text":"mopeeloa tee mpuu-mpuuna incana,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"tee inda apewau kadhaki,","poem":1},{"text":"maka adhadhi aose manga dhalana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Manga kasameamu padhamo upatotapuakea,","poem":1},{"text":"mamudhaakana atokeniaka mpuu-mpuu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maasangia o bhengkalaku amatangka","poem":1},{"text":"mamudhaakana kuosea mpuu-mpuu manga katotapumu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sumaimo, iaku inda bhekupotibhaaka kaea","poem":1},{"text":"ande iaku kuperangoi bhari-bharia parintamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iaku bhekusukuru i Ingkoo tee kakatena totona incaku","poem":1},{"text":"wakutuuna kupengkaadhariaka manga tuturamu mobanara","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iaku bhekukeniakea mpuu-mpuu manga katotapumu,","poem":1},{"text":"bholi sampeampearo ubholiaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tee opea o mia mangura ajagani pemingkuina mamudhaakana sadhaadhaa amangkilo?","poem":1},{"text":"Ajagania alaloi pemingkuina apokana tee firimanimu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iaku kupeeloko tee mpuu-mpuuna incaku;","poem":1},{"text":"bholi utaroakaaku kusaladhala minaaka i parintamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Firimanimu kudhikaia i nuncana ngangarandaku","poem":1},{"text":"mamudhaakana inda kukodosa tee Ingkoo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bhari-bharia kapujia to Ingkoo, e KAWASANA OPU!","poem":1},{"text":"Adhariakaaku manga katotapumu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tee bhiwiku kupetulat