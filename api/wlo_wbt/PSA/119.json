:83,"content":[{"text":"Moomini iaku mboomo saangu kadhuna angguru momalusa,","poem":1},{"text":"iaku inda kumalinguakea manga katotapumu.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Sakawana naepia buaka o bhatuamu tabeana bheaantagiko?","poem":1},{"text":"Naepia buaka Ingkoo bheuhukumu manga mia mopajereaku?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Manga mia mosombo padhamo aseli kabhalongko to karoku,","poem":1},{"text":"siitumo manga mia inda motaʼatina tee hukumumu.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Bhari-bharia parintamu atoparacaea.","poem":1},{"text":"Tulungiaku, roonamo manga incia apajereaku inda tee sababuna!","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Saidhepo manga incia apekamateaku,","poem":1},{"text":"maka iaku inda kubholia manga kasameamu.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Padhadhiaku apokana tee kaasimu molagina","poem":1},{"text":"mamudhaakana kukeniakea mpuu-mpuu manga tutura ipakawaakamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":89,"content":[{"text":"E KAWASANA OPU, firimanimu amatangka","poem":1},{"text":"saʼumurua i sorogaa.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Ingkoo amembali utoparacaea saʼumurua zamani;","poem":1},{"text":"Ingkoo upekatangka alamu sabutuna asadhaadhaa adhaangia.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Manga tuturamu asadhaadhaa sakawana sii-sii","poem":1},{"text":"roonamo bhari-bharia modhaangia o bhatuamu.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Ande o hukumumu inda amembali giu imasanaakana incaku,","poem":1},{"text":"sumaimo dhaanamo kubinasa i nuncana kanarakaaku.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Inda sampeampearo bhekumalinguakea manga kasameamu,","poem":1},{"text":"roonamo alaloi bhari-bharia giu incia sumai Ingkoo upadhadhiaku.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Iaku sii o