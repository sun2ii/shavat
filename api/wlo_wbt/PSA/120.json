{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":120,"content":[{"type":"heading","content":["Doʼa Emaniana Kasalaamati minaaka i Fitanaa"]},{"type":"verse","number":1,"content":["Laguna ziara.",{"noteId":83},{"lineBreak":true},{"text":"I nuncana kanarakaaku kugora i KAWASANA OPU,","poem":1},{"text":"tee Incia alawaniaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"\"E KAWASANA OPU, maasangia urambasakaaku minaaka i bhiwi mogau-gau","poem":1},{"text":"tee dhela mopekatipu.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Opea bheidhawuakana to ingkoo,","poem":1},{"text":"tee opea bheiranganina to ingkoo,","poem":2},{"lineBreak":true},{"text":"e pande tipu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Samia suludadu bheapanako tee pana momatadha","poem":1},{"text":"tee atunuakako tee weona waa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kucilakamo roonamo kumboore mboomo samia dhaga i Mesekh,","poem":1},{"text":"tee tabeana kumboore i tanga-tangana kemana miana Kedar!","poem":2},{"noteId":84}]},{"type":"verse","number":6,"content":[{"text":"Amangengemo laulau kumboore","poem":1},{"text":"kupoose tee manga mia mobancina dhadhi pomalape.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iaku gauku kudhadhi pomalape,","poem":1},{"text":"maka ande kupogau mamudhaakana ingkita tadhadhi pomalape,","poem":2},{"lineBreak":true},{"text":"manga incia gauna apotimbe.","poem":2}]}],"footnotes":[{"noteId":83,"caller":"+","text":"ziara: Aipomo manga Zaburu 120-134 ilaguakana miana Israel wakutuuna apene aziara i Kota Yerusalem i tana mokogunuana.","reference":{"chapter":120,"verse":1}},{"noteId":84,"caller":"+","text":"Mesekh ... Kedar: Miana Mesekh tee Kedar atoabhi mia masega tee inda akofeʼeli.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/wlo_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}