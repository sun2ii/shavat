{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"heading","content":["Doʼana Kasanaa to Miana Yerusalem"]},{"type":"verse","number":1,"content":["Laguna ziarana Daud.",{"lineBreak":true},{"text":"Iaku kukaunde-unde wakutuuna o mia apogau tee iaku,","poem":1},{"text":"\"Mai talingkaaka i Bhanuana KAWASANA OPU!\"","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sii-sii aemami akakaro","poem":1},{"text":"i bhambana lawamu, e Yerusalem!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusalem padhamo atopakaro","poem":1},{"text":"amembali kota mototapi momakaa tee momatangka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iwe siimo manga lipu aziara,","poem":1},{"text":"siitumo uumatina manga lipu ipilina KAWASANA OPU,","poem":2},{"lineBreak":true},{"text":"to aumba asukuru i Incia","poem":2},{"lineBreak":true},{"text":"mboomo manga tutura mopadhana iparintaakana to miana Israel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iwe siimo manga rajana Israel, siitumo manga siwuluna Raja Daud auncura i kauncuramakana","poem":1},{"text":"tee adhawuaka kambotuna moʼadili to lipuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Doʼamo to kasanaana Yerusalem,","poem":1},{"text":"\"Maasangia bhari-bharia mia momaasiakako apotibhaaka kaʼamani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maasangia dhaangia tee kasanaa i nuncana lipumu,","poem":1},{"text":"tee kaʼamani i nuncana manga bentemu.\"","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Rampaakanamo manga witinaiku tee manga sabhangkaku momboorena iwe sumai,","poem":1},{"text":"iaku bhekupogau, \"Maasangia umasanaa!\"","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rampaakanamo Bhanuana KAWASANA OPU, Aulataʼalata dhaangia iwe sumai,","poem":1},{"text":"iaku bhekupeeloakako kalape.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}