{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"heading","content":["Amani i nuncana Peulusana KAWASANA OPU"]},{"type":"verse","number":1,"content":["Laguna ziara.",{"lineBreak":true},{"text":"Manga mia moparacaeana i KAWASANA OPU,","poem":1},{"text":"mboomo Gunu Sion momatangka tee inda amembali atohudha,","poem":2},{"lineBreak":true},{"text":"tee asadhaadhaa saʼumurua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mboomo manga gunu ajagani Yerusalem,","poem":1},{"text":"mboomo uka KAWASANA OPU ajagani uumatina","poem":2},{"lineBreak":true},{"text":"pepuu sii-sii sakawana saʼumurua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Raja momadhaki inda bheakeni pamarintana saʼumurua","poem":1},{"text":"i lipuna manga mia mobanara,","poem":2},{"text":"mamudhaakana manga mia mobanara sumai inda aose","poem":1},{"text":"to apewau kadhaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E KAWASANA OPU, maasangia upewau kalape i manga mia momalape,","poem":1},{"text":"tee i manga mia momakatena incana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maka manga mia mosaladhala moosena dhalana karona mopekabelo-belo,","poem":1},{"text":"bheapadhencua KAWASANA OPU apobhawa tee manga mia mopewauna kadhaki.","poem":2},{"lineBreak":true},{"text":"Amasanaamo miana Israel!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}