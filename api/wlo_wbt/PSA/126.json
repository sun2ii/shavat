{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":126,"content":[{"type":"heading","content":["Kaharapu i nuncana Kanarakaa"]},{"type":"verse","number":1,"content":["Laguna ziara.",{"lineBreak":true},{"text":"Wakutuuna KAWASANA OPU apambuli kadhaangiana Sion","poem":1},{"noteId":86},{"text":"amembali amalape pendua,","poem":1},{"text":"ingkita mboomo mia mopongipi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wakutuu incia sumai o ngangata apotawa roonamo tamasanaa","poem":1},{"text":"tee o dhelata asambo-sambo roonamo takaunde-unde.","poem":2},{"text":"Sabutuna manga lipu mosagaanana apogau,","poem":1},{"text":"\"KAWASANA OPU padhamo apewau giu momaoge to manga incia.\"","poem":2}]},{"type":"verse","number":3,"content":[{"text":"KAWASANA OPU padhamo apewau giu momaoge to ingkita,","poem":1},{"text":"sababuna sumai takaunde-undemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E KAWASANA OPU, maasangia upambulia pendua o kadhaangiamami momalape,","poem":1},{"text":"mboomo umala i Tana Negeb akouwe pendua i bulaana wao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Manga mia mohewina apoose atangi,","poem":1},{"text":"naile itu bheatimpu tee asambo-sambo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mia molimbana minaaka i bhanua tee amaasi","poem":1},{"text":"apoose abhawa wine to ahewia,","poem":2},{"text":"dhaanamo bheambuli asambo-sambo","poem":1},{"text":"apoose abhawa hasilina timpuana.","poem":2}]}],"footnotes":[{"noteId":86,"caller":"+","text":"Sion: Sarona mosagaanana to Kota Yerusalem.","reference":{"chapter":126,"verse":1}}]},"thisChapterLink":"/api/wlo_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}