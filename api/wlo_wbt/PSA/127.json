 saangu fahala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mboomo anana pana i limana samia suludadu,","poem":1},{"text":"mboo sumaimo manga ana umane i wakutuuna amangura.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amasanaamo mia mopabukena","poem":1},{"text":"dhingkanana panana tee anana pana.","poem":2},{"text":"Incia inda bheapotibhaaka kaea,","poem":1},{"text":"wakutuuna apogau tee manga musuna i bhambana lawa kota.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}