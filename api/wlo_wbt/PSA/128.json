{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"heading","content":["Rahumatina to Mobhawana Bhanua"]},{"type":"verse","number":1,"content":["Laguna ziara.",{"lineBreak":true},{"text":"Amasanaamo o mia momaekana i KAWASANA OPU,","poem":1},{"text":"tee adhadhi aose parintana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ingkoo bheukande minaaka i hasilina kanguleana bukumu;","poem":1},{"text":"ingkoo bheumasanaa, tee o dhadhimu bheamalape.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bhawinemu bheamembali mboomo puuna angguru mosuburu","poem":1},{"text":"i nuncana bhanuamu,","poem":2},{"text":"tee manga anamu mboomo tunana puuna zaitun","poem":1},{"text":"i saripina mejamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Satotuuna, mboo sumaimo rahumati bheadhawuaka","poem":1},{"text":"to mia momaekana i KAWASANA OPU.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maasangia o KAWASANA OPU abarakatiko minaaka i Sion.","poem":1},{"text":"Maasangia ingkoo ukamata Yerusalem inda akakurangaaka opeopea","poem":2},{"lineBreak":true},{"text":"saʼumurua dhadhimu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maasangia ingkoo ukamata manga opu-opuamu minaaka i manga anamu!","poem":1},{"lineBreak":true},{"text":"Amasanaamo miana Israel!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}