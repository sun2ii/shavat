ntent":[{"text":"Taroakamo bhari-bharia mia mobancina Sion","poem":1},{"text":"asowo tee amaea.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taroakamo manga incia mboomo rumpu i bhawona padhana bhanua","poem":1},{"text":"amalau wakutuuna tangasaana atuwu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"manga pande dhodhona gandum inda awelia,","poem":1},{"text":"tee manga pande bhokena timpua inda abhokea rampaakanamo rumpu sumai inda akoguna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sabutuna manga mia molalo inda bheapogau,","poem":1},{"text":"\"Maasangia abarakatiko KAWASANA OPU,","poem":2},{"text":"Ingkami tabarakatiko i nuncana sarona KAWASANA OPU.\"","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}