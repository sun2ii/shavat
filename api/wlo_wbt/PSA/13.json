{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"heading","content":["Doʼana Mia Moparacaeana tee Kaasina Aulataʼala"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Zaburuna Daud."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sakawana naepia, e KAWASANA OPU? Saʼumurua buaka Ingkoo umalinguakaaku?","poem":1},{"text":"Sakawana naepia Ingkoo ubuniaka roumu minaaka i karoku?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sakawana naepia kutanggo kanarakaa i nuncana karoku?","poem":1},{"text":"Saeoa amaporo incaku.","poem":2},{"lineBreak":true},{"text":"Sakawana naepia akuasaiaku musuku?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E KAWASANA OPU, Aulataʼalaku, kamatea tee ulawaniakumo.","poem":1},{"text":"Pekatangkea o bukuku mamudhaakana inda kumate!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bholi utaroakea o musuku apogau, \"Kutalomea!\"","poem":1},{"text":"Tee o bhaliku akaunde-unde wakutuuna kusindoli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maka kuparacaea o kaasimu molagina,","poem":1},{"text":"Incaku akaunde-unde roonamo upasalaamatiaku.","poem":2},{"text":"Iaku gauku kulagu to KAWASANA OPU","poem":1},{"text":"roonamo Incia padhamo apewau kalape tee iaku!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}