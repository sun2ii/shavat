{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"heading","content":["Doʼa i nuncana Kanarakaa"]},{"type":"verse","number":1,"content":["Laguna ziara.",{"lineBreak":true},{"text":"Minaaka i mbolongana kanarakaa iaku kugoraakako, e KAWASANA OPU!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E Kawasana Opu, maasangia urangoa o suaraku!","poem":1},{"text":"Taroakamo uperangoia opea iemaniku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E KAWASANA OPU, ande Ingkoo utorotorosu uudhani dosamami,","poem":1},{"text":"incema bhemomembalina abebasi minaaka i kahukumumu, e Aulataʼala?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maka Ingkoo sadia usiapu to upekaʼamponi,","poem":1},{"text":"mamudhaakana o mia amembali ahoromatiko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iaku kuantagi katulungina KAWASANA OPU,","poem":1},{"text":"tee o janjina kuharapua.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngangarandaku aharapuaka Kawasana Opu","poem":1},{"lineBreak":true},{"text":"alabhi minaaka i pande jagana kota mopemeliliakana akawa o wakutuuna matanaeo akotila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E Israel harapumo i KAWASANA OPU!","poem":1},{"text":"Roonamo KAWASANA OPU dhaangia tee kaasina molagina,","poem":2},{"text":"tee Incia sadia bheamangapasalaamati.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Incia bhemopabebasina Israel","poem":1},{"text":"minaaka i bhari-bharia kasalahana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}