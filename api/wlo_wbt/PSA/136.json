 abakaa saʼumurua;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"tee Og, rajana Basan,","poem":1},{"text":"kaasina abakaa saʼumurua;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"tee adhawuakea o lipuna manga incia apamembalia pusakana uumatina,","poem":1},{"text":"kaasina abakaa saʼumurua;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"amembali pusaka to miana Israel o bhatuana sumai,","poem":1},{"text":"kaasina abakaa saʼumurua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Incia inda mangamalinguaka wakutuuna tee masaʼalata,","poem":1},{"text":"kaasina abakaa saʼumurua;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"tee mangarambasaka minaaka i limana musu,","poem":1},{"text":"kaasina abakaa saʼumurua.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Incia mopakandena bhari-bharia mahaluku,","poem":1},{"text":"kaasina abakaa saʼumurua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Sukurumo i Aulataʼala moparintana i laiana,","poem":1},{"text":"kaasina abakaa saʼumurua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}