{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"heading","content":["Kaporona Inca i Bhiwina Umala Babel"]},{"type":"verse","number":1,"content":[{"text":"I bhiwina umala Babel,","poem":1},{"text":"iwe sumakomo ingkami tauncura tee tatangi","poem":2},{"lineBreak":true},{"text":"ande taudhani Sion, mbooresana miana Israel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I manga puuna gandarusa i tampa sumai,","poem":1},{"text":"ingkami tapaloe kecapimami","poem":2}]},{"type":"verse","number":3,"content":[{"text":"roonamo iwe sumai manga miana Babel mangataangi","poem":1},{"text":"tee atumpu ingkami talaguakea,","poem":2},{"text":"mia mopisakina ingkami manga tumpu talaguakea manga lagu kaunde-unde, pogauna,","poem":1},{"text":"\"Laguakamo to ingkami sala saangu lagu minaaka i Sion.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tuaapa amembali ingkami talaguaka lagu to KAWASANA OPU","poem":1},{"text":"i lipu dhaga?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E Yerusalem, ande kumalinguakako,","poem":1},{"text":"taroakamo limaku indamo amembali amagasiaaka kecapi!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taroakamo dhelaku indamo amembali alagu","poem":1},{"text":"ande kumalinguakako,","poem":2},{"text":"tee ande inda kupamembali Yerusalem","poem":1},{"text":"tampa ikaunde-undeakaku mpuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E KAWASANA OPU, udhania o miana Edom,","poem":1},{"text":"i wakutuuna Yerusalem atopahancuru, manga incia apogau,","poem":2},{"lineBreak":true},{"text":"\"Patobhatamea! Patobhatamea sakawana i tana!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"E raʼeatina Babel, ingkomiu bheutopabinasa!","poem":1},{"text":"Amasanaamo mia mobalasina ingkomiu","poem":2},{"lineBreak":true},{"text":"roonamo pewaumu momadhaki i ingkami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amasanaamo mia morakona manga anaana maidhiidhimiu","poem":1},{"text":"tee arambitakea i bhatu!","poem":2},{"noteId":91}]}],"footnotes":[{"noteId":91,"caller":"+","text":"Amasanaamo mia morakona manga anaana maidhiidhimiu: Rua giu molaengana imatau. Bhaa-bhaana, manga lipu modhaangiana i saripina lipu Israel padhamo apewau giu mopokana to miana Israel. Sapadhana sumai, Kawasana Opu afirimani ande o Babel bheanamisi giu mopokana to amembali kabalasina pewauna manga incia.","reference":{"chapter":137,"verse":9}}]},"thisChapterLink":"/api/wlo_wbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}