{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"heading","content":["Doʼana Samia Motopajere"]},{"type":"verse","number":1,"content":["Lagu kaadharina Daud wakutuuna incia apalaiaka Saul tee aopo i nuncana lia. Saangu doʼa."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tee suara makaa kugora i KAWASANA OPU;","poem":1},{"text":"tee suara makaa kuemani kaasi i KAWASANA OPU.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I aroana kupeenci,","poem":1},{"text":"kupaumbaakea bhari-bharia kanarakaaku i Incia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wakutuuna amate akalaku,","poem":1},{"text":"Ingkoo umataua o dhalaku.","poem":2},{"text":"I dhala bheilaloiku","poem":1},{"text":"manga musuku abuniaka katapu to iaku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Poilimo i weta kaanaku tee kamatea,","poem":1},{"text":"inda samia uka mokamataaku.","poem":2},{"text":"Inda dhaangia tampana peulusaku,","poem":1},{"text":"tee inda samia uka mofaduliakaaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E KAWASANA OPU, iaku kugora i Ingkoo.","poem":1},{"lineBreak":true},{"text":"Pogauku, \"Ingkoomo tampana peulusaku,","poem":1},{"text":"tee tangkanamo Ingkoo ifaraluuku i nuncana dhadhiku sii.\"","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Perangoia o doʼaku","poem":1},{"text":"roonamo indamo tee kakaana o bukuku.","poem":2},{"text":"Pasalaamatiaku minaaka i manga musu mosikisaaku","poem":1},{"text":"roonamo manga incia alabhi kakaana minaaka i iaku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Palimbaaku minaaka i katorongku,","poem":1},{"text":"mamudhaakana kumembali kusukuru i Ingkoo.","poem":2},{"text":"Manga mia mosaalihi bheaporomu tee iaku to tapuji saromu,","poem":1},{"text":"roonamo Ingkoo padhamo upewau malape i iaku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}