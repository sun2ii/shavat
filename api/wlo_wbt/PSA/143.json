{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":143,"content":[{"type":"heading","content":["Doʼa Emaniana Kasalaamati minaaka i Musu"]},{"type":"verse","number":1,"content":["Zaburuna Daud.",{"lineBreak":true},{"text":"Maasangia urangoa o doʼaku, e KAWASANA OPU!","poem":1},{"text":"Perangoia iemaniku roonamo umembali utoparacaea;","poem":2},{"lineBreak":true},{"text":"lawaniaku i nuncana kabanaramu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bholi ubhawa bhatuamu i pangadila,","poem":1},{"text":"roonamo inda dhaangia mia inda mosala i aroamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Musuku apajereaku tee apatidhomuaku i tana;","poem":1},{"text":"incia adhikaaku i tampa momalalanda mboomo mia momangengena momate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sababuna sumai, amate akalaku,","poem":1},{"text":"tee ngangarandaku ameri mpuu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kutoudhanimo tee zamani momangenge,","poem":1},{"text":"iaku kuudhania bhari-bharia ipewaumu,","poem":2},{"lineBreak":true},{"text":"tee kufikiria bhari-bharia ipadhaangiamu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iaku kuangka limaku tee kudoʼa i Ingkoo,","poem":1},{"text":"ngangarandaku apemeliliakako mboomo tana matuu apemeliliaka wao. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E KAWASANA OPU, maasangia ulawaniaku madhei,","poem":1},{"text":"roonamo amatemo akalaku.","poem":2},{"text":"Bholi ubuniaka karomu minaaka i iaku","poem":1},{"text":"mamudhaakana iaku inda mboo manga mia mosapona i duniana mia mate.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Parangoakaaku kaasimu molagina i wakutuu saeona,","poem":1},{"text":"roonamo kuparacaea i Ingkoo.","poem":2},{"text":"Susuakaaku dhala bheilaloiku,","poem":1},{"text":"roonamo i Ingkoomo kupasaraaka ngangarandaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"E KAWASANA OPU, pasalaamatiaku minaaka i manga musuku,","poem":1},{"text":"i Ingkoomo tampaku kupalai to kupeulu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Adhariaku kupewau opea ipeelumu,","poem":1},{"text":"roonamo Ingkoomo Aulataʼalaku.","poem":2},{"text":"Taroakea o rohimu momalape sumai","poem":1},{"text":"akapalaiaku i tana morata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"E KAWASANA OPU, padhadhiaku roonamo saromu,","poem":1},{"text":"tee i nuncana kabanaramu pasalaamatiaku minaaka i kanarakaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Roonamo kaasimu molagina, pahancurumea manga musuku,","poem":1},{"text":"tee pabinasamea bhari-bharia mia mopanarakaaku","poem":2},{"lineBreak":true},{"text":"roonamo iaku o bhatuamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}