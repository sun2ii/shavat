"text":"Taroakamo uumatina akaunde-unde i nuncana kamuliangi,","poem":1},{"text":"tee alagu asambo-sambo i kolemana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taroakamo manga incia apuji Aulataʼala tee ngangana,","poem":1},{"text":"apoose akeni hancu momatadha ruaanguana matana i limana","poem":2}]},{"type":"verse","number":7,"content":[{"text":"to abalasi pewauna manga lipu i dunia sii,","poem":1},{"text":"tee ahukumu manga raʼeatina lipu i alamu sii,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"to abhokeakea ase manga raja,","poem":1},{"text":"tee abhokeakea rante ase manga kaogesana lipu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"to ahukumu manga lipu mboomo mopadhana ipatotapuakana Aulataʼala to manga incia.","poem":1},{"text":"Giu incia sumai amembali saangu giu momulia to bhari-bharia mia mosaalihi.","poem":2},{"lineBreak":true},{"text":"Pujimo KAWASANA OPU!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}