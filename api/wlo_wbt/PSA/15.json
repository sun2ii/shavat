m":2},{"text":"motaʼatina janjina,","poem":1},{"text":"moomini amarugi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Manga incia apekapaadhaaka doina tee inda aala laba,","poem":1},{"text":"tee inda atarima kasogo to aewangi mia inda mosala.","poem":2},{"lineBreak":true},{"text":"Mia mopewauna mboo sumai","poem":1},{"text":"bheamasanaa tee aʼamani saʼumurua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}