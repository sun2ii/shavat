{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":16,"content":[{"type":"heading","content":["Kasanaana Mia Mosaalihi"]},{"type":"verse","number":1,"content":["Miktam.",{"noteId":11},"Zaburuna Daud.",{"lineBreak":true},{"text":"E Aulataʼala, jaganiaku","poem":1},{"text":"roonamo Ingkoomo peulusaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iaku kupogau i KAWASANA OPU, \"Ingkoomo Kawasana Opuku,","poem":1},{"text":"inda dhaangia momalapena to iaku, tangkanamo Ingkoo.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mia momangkilo modhaangiana i alamu,","poem":1},{"text":"manga inciamo o mia momulia mosadiana ipeeluku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kanarakaana manga mia mosombana dewa mosagaanana bheahanda kabharina.","poem":1},{"text":"Iaku inda bhekulali pasombaana raana kurubanina manga incia,","poem":2},{"lineBreak":true},{"text":"atawa uka kusarongi sarona manga dewa mosagaanana i bhiwiku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E KAWASANA OPU, tangkanamo Ingkoo o pusakaku,","poem":1},{"text":"Ingkoomo motantuakana dhalana dhadhiku,","poem":2},{"lineBreak":true},{"text":"Ingkoomo mokenina katooku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ingkoomo modhawuaku manga giu momakesa","poem":1},{"text":"satotuuna kadhawumu sumai mopaunde-undeaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iaku kupuji KAWASANA OPU, mopadhana moudhaniakaaku;","poem":1},{"text":"i wakutuuna malo baatiniku aadhariaku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iaku sadia kuudhani KAWASANA OPU;","poem":1},{"text":"Incia dhaangia i saripiku, rampaakanamo sumai kumatangka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sababuna sumai, incaku amasanaa tee ngangarandaku akaunde-unde,","poem":1},{"text":"badaku aponiunto tee kuʼamani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sababuna Ingkoo inda utaroakaaku kumate,","poem":1},{"text":"mia mosaalihi inda utaroakea abinasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Upaumbaakaaku dhala moporopena i dhadhi imalapeaka,","poem":1},{"text":"i aroamu abhari mpuu kasanaa,","poem":2},{"lineBreak":true},{"text":"i lima kaanamu dhaangia kasanaa to saʼumurua.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Miktam: Sarona sala saangu zaburu mokomaʼanana kabhanti bulawa. Miktam minaaka i oni kethem i nuncana pogau Ibrani akomaʼana \"bulawa.\"","reference":{"chapter":16,"verse":1}}]},"thisChapterLink":"/api/wlo_wbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}