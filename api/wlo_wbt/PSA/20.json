{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":20,"content":[{"type":"heading","content":["Doʼa Emaniana Takana"]},{"type":"verse","number":1,"content":["To kapalana lagu. Zaburuna Daud."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Maasangia KAWASANA OPU alawaniko","poem":1},{"text":"i wakutuuna kasukara,","poem":2},{"lineBreak":true},{"text":"maasangia Aulataʼala, isombana Yakub ajaganiko!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maasangia Incia atulungiko minaaka i tampa momangkilo,","poem":1},{"text":"tee atukoko minaaka i Gunu Sion.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maasangia Incia audhani bhari-bharia pasombaamu,","poem":1},{"text":"tee atarima kurubani tunuamu. Sela","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maasangia Incia adhawuko opea ipeelumu,","poem":1},{"text":"tee apewau bhari-bharia haejatimu akohasili.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ingkami bhetasambo-sambo roonamo Ingkoo ukanamo,","poem":1},{"text":"tee tapabhale tombi to tapuji Aulataʼalamami.","poem":2},{"lineBreak":true},{"text":"Maasangia KAWASANA OPU adhawuko bhari-bharia iemanimu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sii-sii iaku kumataua ande o KAWASANA OPU mopasalaamatina","poem":1},{"text":"raja ilantina.","poem":2},{"text":"Minaaka i sorogaa momangkilo Incia bhealawani","poem":1},{"text":"tee kuasana lima kaanana mopasalaamatina.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dhaangia o mia motangkaakana manga kareta potimbeana,","poem":1},{"text":"dhaangia uka motangkaakana manga ajarana,","poem":2},{"lineBreak":true},{"text":"maka ingkita tatangkaaka sarona KAWASANA OPU, Aulataʼalata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Manga incia atosunu tee amandawu,","poem":1},{"text":"maka ingkita tabhangu takabhale-bhale tee tamatangka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"E KAWASANA OPU, pasalaamatia o raja,","poem":1},{"text":"manga lawani i wakutuuna ingkami tagora.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}