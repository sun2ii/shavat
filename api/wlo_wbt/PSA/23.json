{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"heading","content":["KAWASANA OPU o Gembalaku Momalape"]},{"type":"verse","number":1,"content":["Zaburuna Daud.",{"lineBreak":true},{"text":"KAWASANA OPU o gembalaku, iaku inda bhekukakuranga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Incia ataroakaaku kuponiunto i tana mokorumpu;","poem":1},{"text":"Incia abhawaaku i bhiwina uwe momalino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Incia apekatangkaaku,","poem":1},{"text":"tee atondaaku i dhala mobanara","poem":2},{"lineBreak":true},{"text":"rampaakanamo sifatuna mboomo gembala momalape.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Moomini kudhala i nuncana mbolonga momalalanda mpuu,","poem":1},{"text":"iaku inda kumaeka balaa roonamo Ingkoo dhaangia i saripiku;","poem":2},{"text":"Ingkoo ujaganiaku","poem":1},{"text":"mboomo gembala mojaganina dumbana,","poem":2},{"lineBreak":true},{"text":"tee katuko ibhawamu, kunamisi kutohiburu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ingkoo upasiapuakaaku kinande","poem":1},{"text":"i aroana manga bhaliku.","poem":2},{"text":"I bhaaku ujampuakea tee mina-mina mawondu;","poem":1},{"text":"tondeku uantokiakea tee giu isumpu motaralabhi-labhi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kalape tee kaasi molagina bheaoseaku","poem":1},{"text":"saʼumurua dhadhiku,","poem":2},{"text":"tee iaku bhekumboore i nuncana Bhanuamu","poem":1},{"text":"saʼumurua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}