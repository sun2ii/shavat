{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":27,"content":[{"type":"heading","content":["Amani i Nuncana Peulusana KAWASANA OPU"]},{"type":"verse","number":1,"content":["Zaburuna Daud.",{"lineBreak":true},{"text":"KAWASANA OPU o kainawa tee kasalaamatiku,","poem":1},{"text":"tee incema buaka iaku bhekumaeka?","poem":2},{"text":"KAWASANA OPU o bentena dhadiku,","poem":1},{"text":"tee incema buaka iaku bhekurengku?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wakutuuna manga parampo aumba alibuaku","poem":1},{"text":"to akande dagiku,","poem":2},{"text":"siitumo bhari-bharia bhaliku tee musuku,","poem":1},{"text":"manga inciamo mosindolina tee momandawuna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moomini alibuaku rombongana suludadu mobhari,","poem":1},{"text":"i nuncana ngangarandaku inda kumaeka.","poem":2},{"text":"Moomini dhaangia tee potimbea to moewangiaku,","poem":1},{"text":"iaku sadhaadhaa kuparacaea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tangkanamo saangu iemaniku i KAWASANA OPU,","poem":1},{"text":"siitumo ipeeluku,","poem":2},{"text":"mamudhaakana kumboore i nuncana Bhanuana KAWASANA OPU","poem":1},{"text":"saʼumurua dhadhiku,","poem":2},{"text":"to kukamataaka kalapena KAWASANA OPU","poem":1},{"text":"tee kupengkaabha-abha i nuncana Bhanuana Momangkilo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sababuna i wakutuuna kasukara,","poem":1},{"text":"KAWASANA OPU bheajaganiaku i tampana peulusana.","poem":2},{"text":"Incia bheabuniakaaku i nuncana Kemana Momangkilo,","poem":1},{"text":"tee Incia bheaangkaaku i tampa moʼamani, siitumo i bhawona gunu bhatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sumaimo, bhaaku indamo atungku","poem":1},{"text":"i aroana manga musu molibuaku,","poem":2},{"text":"tee i nuncana Kemana Momangkilo","poem":1},{"text":"iaku bhekupasombaaka kurubani isumbele tee kusambo-sambo;","poem":2},{"lineBreak":true},{"text":"iaku bhekulaguaka lagu kapujia to KAWASANA OPU.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E KAWASANA OPU, maasangia urangoa o suaraku wakutuuna kugora,","poem":1},{"text":"maasiakaaku tee ulawaniaku!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Totona incaku aose firimanimu, \"Maimo umba uʼibaadati i Iaku.\"","poem":1},{"text":"Sumaimo, kulausakamo kuumba to kuʼibaadati, e KAWASANA OPU.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bholi ubuniaka karomu wakutuuna kuʼibaadati i Ingkoo.","poem":1},{"text":"Bholi inda umaheruakea o bhatuamu sii i nuncana pamurumu.","poem":2},{"text":"Ingkoomo moagoaku,","poem":1},{"text":"bholi umendeuaku atawa ubholiaku,","poem":2},{"lineBreak":true},{"text":"e Aulataʼala, mopasalaamatiaku!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Moomini amaku tee inaku abholiaku,","poem":1},{"text":"KAWASANA OPU bheapepagoaku mboomo anana karona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E KAWASANA OPU, adhariakaaku opea ipeelumu,","poem":1},{"text":"tee ususuakaaku dhala momakate,","poem":2},{"lineBreak":true},{"text":"roonamo bhaliku tee musuku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bholi upasaraakaaku i nawusuuna bhaliku,","poem":1},{"text":"roonamo manga sakusii gau-gau akakaromo aewangiaku,","poem":2},{"lineBreak":true},{"text":"siitumo manga mia modhadhina tee feʼeli madhaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Iaku sadhaadhaa kuparacaea ande iaku bhekukamata kalapena KAWASANA OPU,","poem":1},{"text":"i lipuna manga mia modhadhi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Antagimo KAWASANA OPU!","poem":1},{"text":"Pekakaaia tee upekatangkea o incamu!","poem":2},{"lineBreak":true},{"text":"Umbe, antagimo KAWASANA OPU!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}