{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":30,"content":[{"type":"heading","content":["Doʼa Sukuru roonamo Asalaamati minaaka i Balaa"]},{"type":"verse","number":1,"content":["Zaburuna Daud to alaguaka wakutuuna lipuna Israel alimbaisi Bhanua Mangkilo."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iaku kupujiko, e KAWASANA OPU,","poem":1},{"text":"sababuna Ingkoo padhamo upasalaamatiaku","poem":2},{"lineBreak":true},{"text":"tee inda utaroaka musuku asamboakaaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E KAWASANA OPU, e Aulataʼalaku, iaku kugora i Ingkoo kuemani tulungi","poem":1},{"text":"tee Ingkoo mopauntona kapiiku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E KAWASANA OPU Ingkoo padhamo uangkaaku minaaka i alamuna koburu,","poem":1},{"text":"Ingkoo padhamo upotaangiaka dhadhiku sabutuna iaku inda kusapo i liana koburu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E manga mia mosaalihi, laguakamea manga lagu kapujia to KAWASANA OPU,","poem":1},{"text":"bhoasakamea o kasukuru to sarona momangkilona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Satotuuna o amarana sabantaramea,","poem":1},{"text":"maka o kalapena saʼumurua.","poem":2},{"text":"Moomini tatangi samaloa,","poem":1},{"text":"maka i wakutuuna saeona bhetakaunde-undemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Roonamo kumasanaa, kupogau,","poem":1},{"text":"\"Dhadhiku bheaʼamani torosu!\"","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E KAWASANA OPU, roonamo kalapena incamu,","poem":1},{"text":"Upamembaliaku mboomo gunu momatangka.","poem":2},{"text":"Maka wakutuuna ubuniaka roumu,","poem":1},{"text":"iaku kumaeka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I Ingkoo iaku kugora, e KAWASANA OPU,","poem":1},{"text":"tee i Aulataʼala kuemani kaasi,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"\"Opea o faʼedana to Ingkoo ande amabhotu inyawaku","poem":1},{"text":"tee kupesua i nuncana koburu?","poem":2},{"text":"Amembali buaka o ngawu asukuru i Ingkoo","poem":1},{"text":"tee apakoleleaka ande Ingkoo umembali utoparacaea?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E KAWASANA OPU, maasangia urangoa tee umaasiakaaku.","poem":1},{"text":"E KAWASANA OPU, tulungiaku!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tangiku ubhaliia amembali manari kaunde-unde,","poem":1},{"text":"kae kadhu tandana kaporona incaku ualea,","poem":2},{"lineBreak":true},{"text":"tee o tangaku ubhokeakea tee kasanaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sabutuna kumembali kulaguaka lagu kapujia to Ingkoo","poem":1},{"text":"tee inda soo kukatongo-tongo.","poem":2},{"text":"E KAWASANA OPU, e Aulataʼalaku, iaku gauku kusukuru i Ingkoo","poem":1},{"text":"to saʼumurua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}