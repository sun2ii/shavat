{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":31,"content":[{"type":"heading","content":["Amani i Nuncana Limana Aulataʼala"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Zaburuna Daud."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E KAWASANA OPU, Ingkoomo peulusaku,","poem":1},{"text":"bholi utaroakaaku kutopekaea.","poem":2},{"lineBreak":true},{"text":"Pasalaamatiaku roonamo kaʼadilimu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Perangoiaku,","poem":1},{"text":"tee rambasakaaku pekadhei!","poem":2},{"text":"Umembalimo gunu bhatu to tampana peulusaku,","poem":1},{"text":"mboomo bentena potaangia mopasalaamatiaku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Satotuuna, Ingkoomo gunu bhatuku tee bentena potaangiaku.","poem":1},{"text":"Rampaakanamo saromu, kapalaikiaku tee utondaaku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rambasakaaku minaaka i katapu","poem":1},{"text":"itaana musu to arakoaka iaku","poem":2},{"lineBreak":true},{"text":"roonamo Ingkoomo peulusaku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I nuncana limamu kupasaraakaaka inyawaku.","poem":1},{"text":"Ingkoo padhamo upasalaamatiaku e KAWASANA OPU, Aulataʼala momembalina motoparacaea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iaku kubanci manga mia mosombana barahala mosia-sia;","poem":1},{"text":"maka iaku samia kuparacaea i KAWASANA OPU.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iaku bhekusambo-sambo tee kukaunde-unde roonamo kaasimu molagina,","poem":1},{"text":"sababuna Ingkoo ukamata kanarakaaku","poem":2},{"lineBreak":true},{"text":"tee umatau kasukaraku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ingkoo inda upasaraakaaku i limana musu,","poem":1},{"text":"maka Ingkoo upakakaro aeku i tampa momalalesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"E KAWASANA OPU, maasiakaakupo","poem":1},{"text":"roonamo iaku i nuncana kasukara,","poem":2},{"text":"mataku amandala roonamo kutangi,","poem":1},{"text":"badaku tee inyawaku anarakaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dhadhiku atopadha i nuncana kaporona inca,","poem":1},{"text":"umuruku atopadha roonamo kupeenci;","poem":2},{"text":"kakaaku aila roonamo kasalahaku,","poem":1},{"text":"tee manga bukuku amapuromo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I aroana bhari-bharia bhaliku, iaku kumembali giu ipotawaakana manga incia,","poem":1},{"text":"tee uka manga sarimbanuaku.","poem":2},{"text":"Iaku kumembali giu imingkiriaka to manga sampomatauku,","poem":1},{"text":"tee manga mia mokamataaku i dhala apalaiakaaku.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iaku kutomalinguaka mboomo mia mate,","poem":1},{"text":"iaku kumembali mboomo bara momapasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iaku kurango mia abhari apokamuntuiakaku,","poem":1},{"text":"kamingkiri","poem":2},{"noteId":14},{"text":"adhaangia i bhari-bharia rope!","poem":2},{"text":"Manga incia apomufakati to abhaliaku,","poem":1},{"text":"tee ahaejati to apekamateaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maka iaku kuparacaeako, e KAWASANA OPU,","poem":1},{"text":"sababuna iaku kupogau, \"Ingkoomo Aulataʼala isombaku!\"","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dhadhiku dhaangia i nuncana limamu,","poem":1},{"text":"rambasakaaku minaaka i limana manga musuku","poem":2},{"lineBreak":true},{"text":"tee minaaka i manga mia mopajereaku.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taroakamo o caheana roumu akangkanai bhatuamu sii,","poem":1},{"text":"tee upasalaamatiaku roonamo kaasimu molagina.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E KAWASANA OPU, bholi utaroakea manga musuku apekaeaaku","poem":1},{"text":"roonamo iaku kugora i Ingkoo.","poem":2},{"text":"Taroakamo manga mia madhaki apotibhaaka kaea,","poem":1},{"text":"tee taroakamo manga incia asapo i duniana mia mate tee inda tee uuʼuuna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Soncongia o muncuna manga pande gau-gau,","poem":1},{"text":"mohinana tee momangkatuna mia mobanara;","poem":2},{"lineBreak":true},{"text":"manga incia asombo tee apekahina.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tapanamo kabhari o kalapemu","poem":1},{"text":"mopadhana ipasiapuakamu to manga mia momaekako,","poem":2},{"lineBreak":true},{"text":"tee ipewaumu to manga mia mopeuluna i Ingkoo,","poem":2},{"lineBreak":true},{"text":"i aroana maanusia!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ingkoo ubuniaka manga incia i nuncana peulusana kuasamu","poem":1},{"text":"minaaka i mia mosahimuakana manga incia.","poem":2},{"text":"Ingkoo ujagani manga incia i nuncana mbooresamu","poem":1},{"text":"minaaka i manga mia moraeakana manga incia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Atopujimo KAWASANA OPU","poem":1},{"text":"roonamo inda amentela mpuu kaasina molagina mopadhana isusuakana to iaku","poem":2},{"lineBreak":true},{"text":"wakutuuna kumaseke mboomo kota motolibu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Roonamo kubingu, kusarongia,","poem":1},{"text":"\"Kutopadhencumo minaaka i aroamu.\"","poem":2},{"text":"Maka satotuuna Ingkoo urangoa iemaniku","poem":1},{"text":"wakutuuna kugora kuemani tulungi i Ingkoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Maasiakea o KAWASANA OPU,","poem":1},{"text":"e bhari-bharia mia mosaalihi!","poem":2},{"text":"KAWASANA OPU ajagani mia motaʼati","poem":1},{"text":"maka Incia ahukumu totuu-totuu o mia mosombo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pekakaaia tee upekatangkea o incamu,","poem":1},{"text":"e bhari-bharia mia moharapuna i KAWASANA OPU!","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"kamingkiri: Kadhaangiana mia monamisina karona amaeka mpuu tee ameri.","reference":{"chapter":31,"verse":14}}]},"thisChapterLink":"/api/wlo_wbt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":25}