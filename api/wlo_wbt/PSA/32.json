{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":32,"content":[{"type":"heading","content":["Kasanaana Mia Motoʼamponina Dosana"]},{"type":"verse","number":1,"content":["Zaburuna Daud. Laguna kaadhari.",{"lineBreak":true},{"text":"Amasanaamo o mia motoʼamponina kasalahana,","poem":1},{"text":"tee o mia motomaʼafuakana dosana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amasanaamo o mia","poem":1},{"text":"mopewauna kasalaha, maka inda alentua o KAWASANA OPU,","poem":2},{"lineBreak":true},{"text":"tee inda amakidha apekagau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kangengena indapo kuʼakui dosaku,","poem":1},{"text":"buku-bukuku amalute roonamo kupeenci saeoa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Malo eona Ingkoo upekatamo kahukumuku.","poem":1},{"text":"Kakaaku atopadha mboomo kamba-kamba momalau roonamo akangkanaia kasodhona matanaeo. Sela","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kasiimpo kuʼakuia o dosaku i Ingkoo","poem":1},{"text":"tee inda kubuniakea o kasalahaku.","poem":2},{"text":"Kupogau, \"Iaku bhekuʼakuia manga kasalahaku i KAWASANA OPU,\"","poem":1},{"text":"tee Ingkoo uʼamponi manga kasalahana dosaku. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sababuna sumai bhari-bharia mia mosaalihi tabeana adoʼa i Ingkoo","poem":1},{"text":"wakutuuna Ingkoo dhaangiapo umembali utopokawaaka.","poem":2},{"text":"Sumaimo wakutuuna uwena mawa maoge akawa,","poem":1},{"text":"uwena mawa sumai inda amembali apabinasa incia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ingkoomo peulusaku,","poem":1},{"text":"Ingkoo mojaganiaku minaaka i kasukara,","poem":2},{"lineBreak":true},{"text":"Ingkoo modhikana lagu i nuncana ngangarandaku, roonamo padhamo upasalaamatiaku. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Iaku bhekuadhariko tee kususuakako","poem":1},{"text":"dhala molaengana idhalaikimu.","poem":2},{"text":"Iaku bhekuudhaniakako,","poem":1},{"text":"tee kujaganiko mamudhaakana sadhaadhaa uʼamani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bholi mboomo ajara atawa o siwuluna keledai","poem":1},{"text":"inda tee akalana,","poem":2},{"text":"tabeana atohelaaka tee kabhokena bhorokona tee rabutana,","poem":1},{"text":"ande inda mboo sumai, manga incia inda bheaoseko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abhari o kanarakaa inamisina mia madhaki,","poem":1},{"text":"maka o mia moparacaeana i KAWASANA OPU","poem":2},{"lineBreak":true},{"text":"ajaganiakea tee kaasina molagina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"E manga mia mobanara,","poem":1},{"text":"masanaamo tee ukaunde-undemo roonamo KAWASANA OPU!","poem":2},{"lineBreak":true},{"text":"Sambo-sambomo, e bhari-bharia mia momakatena incana!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}