{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":39,"content":[{"type":"heading","content":["Doʼana Emaniana Tulungi"]},{"type":"verse","number":1,"content":["To kapalana molaguna. To Yedutun. Zaburuna Daud."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iaku kupogau,","poem":1},{"lineBreak":true},{"text":"\"Bhekupengkaanaka kujagani karoku","poem":1},{"text":"mamudhaakana inda kukodosa tee dhelaku.","poem":2},{"text":"Iaku bhekukoputi muncuku","poem":1},{"text":"kangengena dhaangia tee mia madhaki i aroaku.\"","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iaku inda kupogau sampeampearo;","poem":1},{"text":"pogau momalape uka inda kubhoasakea,","poem":2},{"lineBreak":true},{"text":"maka o kanarakaaku ahanda amatamo,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ngangarandaku alilaho.","poem":1},{"text":"Ahanda kufikiria, ahanda amasodho ngangarandaku;","poem":2},{"lineBreak":true},{"text":"kasiimpo kupogau,","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"\"E KAWASANA OPU, paumbaakaaku naepia akawa o ajalaku","poem":1},{"text":"tee dhaangia pia eopo uka o dhadhiku","poem":2},{"lineBreak":true},{"text":"mamudhaakana kumataua ande o umuruku amampodho!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kamatea, tapanamo kampodho o umuru itantuakamu to iaku.","poem":1},{"text":"Dhadhiku mboomo inda tee maʼanana i matamu.","poem":2},{"text":"Bhari-bharia maanusia modhaangiana i dunia","poem":1},{"text":"bheamofu sakijamata mboomo poinunca. Sela","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dhadhina maanusia mboomo ngkamia-mia!","poem":1},{"text":"Ncia-nciamo maanusia moomini apepadhai tanaga,","poem":2},{"lineBreak":true},{"text":"incia arombusaka o harataa wakutuuna dhaangiapo adhadhi, maka samatena, inda amataua incema bhemoniʼimatia.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"\"Sii-sii opea bheiantagiku, e Kawasana Opu?","poem":1},{"text":"Ingkoomo iharapuku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rambasakaaku minaaka i bhari-bharia dosaku,","poem":1},{"text":"tee bholi utaroakaaku aele-eleaku mia mokabhongo-bhongo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iaku inda kukosuara tee inda kubungkale ngangaku,","poem":1},{"text":"roonamo Ingkoomo mohukumuaku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pekaridhoa o limamu to ubhebheaku,","poem":1},{"text":"sababuna saidhepo kumate roonamo kahukumumu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ingkoo uadhari maanusia tee kahukumu roonamo kasalahana,","poem":1},{"text":"Ingkoo mboomo ane upahancuru opea imaasiakamami.","poem":2},{"lineBreak":true},{"text":"Bhari-bharia maanusia tangkanamo mboomo poinunca!\" Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"\"E KAWASANA OPU, perangoia o doʼaku,","poem":1},{"text":"tee utilikiaku wakutuuna kugora kuemani tulungi.","poem":2},{"text":"Bholi inda umaheruakea ande kutangi,","poem":1},{"text":"roonamo iaku sii mboomo samia dhaga moumbana i Ingkoo,","poem":2},{"lineBreak":true},{"text":"mboomo bhari-bharia manga opu-opuaku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bholi ukamataaku tee pamurumu","poem":1},{"text":"mamudhaakana amembali kupemboi pendua","poem":2},{"lineBreak":true},{"text":"wakutuuna indapo kumate.\"","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}