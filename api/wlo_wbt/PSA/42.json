{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":42,"content":[{"type":"heading","content":["ZABURU 42--72"]},{"type":"heading","content":["Pemelili to Aulataʼala, Haakimu Moʼadili"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Lagu kaadharina miana Korah.",{"noteId":18}]},{"type":"verse","number":2,"content":[{"text":"Mboomo rusa apemeliliaka umala mokouwe,","poem":1},{"text":"mboo sumai uka iaku kupemeliliaka Ingkoo, e Aulataʼala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iaku kufaraluu mpuu Aulataʼala,","poem":1},{"text":"Aulataʼala modhadhi.","poem":2},{"text":"Naepia amembali kupoaro tee kukamata Aulataʼala?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Malo eona kutangi,","poem":1},{"text":"loluku amembali kinandeku.","poem":2},{"text":"Saeoa o musuku aele-eleaku tee apogau,","poem":1},{"text":"\"Iapai o Aulataʼalamu?\"","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Giumo incia sii iudhaniku,","poem":1},{"text":"wakutuuna kupetulatulaaka o antona ngangarandaku:","poem":2},{"text":"Tuaapa i piamo itu kulingka kupobhawa tee mia bhari wakutuu taporope i bhanuana Aulataʼala,","poem":1},{"text":"kuporiaroaaka dhala","poem":2},{"text":"poose tasambo-sambo tee tasukuru","poem":1},{"text":"i nuncana kariaa sumai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pokia ingkoo umaasi e ngangarandaku,","poem":1},{"text":"tee ulilaho i nuncana badaku?","poem":2},{"text":"Harapumo i Aulataʼala roonamo iaku uka bhekupuji Incia","poem":1},{"text":"tee kasalaamati moumbana minaaka i aroana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E Aulataʼalaku, ngangarandaku ahancuru i nuncana badaku,","poem":1},{"text":"rampaakanamo sumai iaku bhekuudhaniko","poem":2},{"text":"minaaka i lipuna Umala Yordan tee Gunu Hermon,","poem":1},{"text":"tee minaaka i Gunu Mizar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andalaoge alawani andalaoge mosagaanana","poem":1},{"text":"tee suarana momakaa o uwe momandawu minaaka i kalangaana.","poem":2},{"text":"Bhari-bharia ewo tee solomu","poem":1},{"text":"akangkanaiaku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I wakutuuna aeo KAWASANA OPU aparintaaka kaasina molagina,","poem":1},{"text":"tee i wakutuuna amalo iaku kulagu,","poem":2},{"lineBreak":true},{"text":"siitumo saangu doʼa to Aulataʼala mopadhadhiaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iaku kupogau tee Aulataʼala, gunu bhatuku,","poem":1},{"text":"\"Pokia umalinguakaaku?","poem":2},{"text":"Pokia manga musuku apisakiaku","poem":1},{"text":"sabutuna iaku sadiamo kusukara?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mboomo katobhoki imateaka i nuncana bukuku,","poem":1},{"text":"manga bhaliku aele-eleaku.","poem":2},{"text":"Manga incia saeoa aabha,","poem":1},{"text":"\"Iapai o Aulataʼalamu?\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pokia ingkoo umaasi, e ngangarandaku,","poem":1},{"text":"pokia ulilaho i nuncana badaku?","poem":2},{"text":"Harapumo i Aulataʼala roonamo iaku uka bhekupuji Incia,","poem":1},{"text":"Aulataʼalaku mopasalaamatiaku.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"miana Korah: Kolompona molaguna minaaka i siwuluna Korah (kamata Kab. 26:10), siitumo o Heman tee manga anana. Nabii Daud apatugasiaka Heman to apakawaaka kasameana nabii aoseakea gambusu tee lagu i nuncana ibaadati i Baitulla.","reference":{"chapter":42,"verse":1}}]},"thisChapterLink":"/api/wlo_wbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":12}