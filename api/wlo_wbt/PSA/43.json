{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"E Aulataʼala, dhawuakumo kaʼadili,","poem":1},{"text":"tee uewaaka parakaraku i aroana lipu modorohaka.","poem":2},{"text":"Pabebasiaku minaaka i pande pekagau tee mia madhaki,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"roonamo Ingkoomo Aulataʼala peulusaku.","poem":2},{"text":"Pokia Ingkoo umendeuaku?","poem":1},{"text":"Pokia iaku sadiamo kusukara","poem":2},{"lineBreak":true},{"text":"roonamo kapisakina musu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lambokoa o kainawamu tee kabanaramu","poem":1},{"text":"to akapalaikiaku","poem":2},{"text":"tee abhawaaku i gunumu momangkilo,","poem":1},{"text":"i tampana mbooresamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sumaimo, iaku bhekulingka kuporope i tampa tunuana kurubani to Aulataʼala,","poem":1},{"text":"iaku bhekupoaro i Aulataʼala, mopasanaaku tee mopaunde-undeaku.","poem":2},{"text":"Iaku bhekupujiko tee kecapi,","poem":1},{"text":"e Kawasana Opu, e Aulataʼalaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pokia umaasi e ngangarandaku","poem":1},{"text":"tee pokia ulilaho i nuncana badaku?","poem":2},{"text":"Uharapumo i Aulataʼala roonamo iaku uka bhekupuji Incia,","poem":1},{"text":"Aulataʼalaku mopasalaamatiaku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}