{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"heading","content":["Doʼa Emaniana Peulusa"]},{"type":"verse","number":1,"content":["To kapalana molaguna.",{"text":"Tee kagasiana kecapi. Lagu kaadharina Daud","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"wakutuuna miana Zifi aumba apogauaka i Raja Saul, \"Daud apeopo i ingkami.\"","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E Aulataʼala pasalaamatiaku roonamo saromu,","poem":1},{"text":"tee adilia parakaraku roonamo kakaamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maasangia urangoa doʼaku, e Aulataʼala,","poem":1},{"text":"rangoa manga pogau ibhoasakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Manga mia momalangana incana akakaro aewangiaku,","poem":1},{"text":"tee manga mia mosombo gauna bheaala inyawaku.","poem":2},{"lineBreak":true},{"text":"Manga incia inda afaduliaka Aulataʼala. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Satotuuna Aulataʼala motulungiaku,","poem":1},{"text":"Kawasana Opu modhambaakaaku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taroakamo kadhaki ambuli akangkanai manga musuku.","poem":1},{"text":"Roonamo kaasimu molagina, pabinasamea manga incia!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tee relana totona incaku, iaku bhekupasombaaka kurubani to Ingkoo.","poem":1},{"text":"Iaku bhekusukuru tee Ingkoo, e KAWASANA OPU, roonamo saromu amalape.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Roonamo Ingkoo padhamo urambasakaaku minaaka i sagala kanarakaa,","poem":1},{"text":"sabutuna kukamata musuku amatalo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}