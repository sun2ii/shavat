{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":55,"content":[{"type":"heading","content":["Doʼa Emani Peulusa minaaka i Kahandana Musu"]},{"type":"verse","number":1,"content":["To kapalana molaguna.",{"text":"Tee kagasiana kecapi. Lagu kaadharina Daud.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E Aulataʼala, perangoia o doʼaku,","poem":1},{"text":"tee bholi inda ufaduliakea giu iemaniku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kamataaku tee tulungiaku!","poem":1},{"text":"Kulilaho tee kupekidhei","poem":2}]},{"type":"verse","number":4,"content":[{"text":"roonamo kahandana musu","poem":1},{"text":"tee roonamo kapisakina mia madhaki.","poem":2},{"text":"Manga incia apanarakaaku,","poem":1},{"text":"manga incia aʼamaraikiaku tee abanciaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngangarandaku abagoea,","poem":1},{"text":"kamingkirina mate aoseaku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iaku kurengku tee kumaeka mpuu,","poem":1},{"text":"kamingkiri akuasaiaku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iaku kupogau, \"Ande kukopani mboomo manu-manu jarajara!","poem":1},{"text":"Iaku bhekupolaka tee kupeelo tampa momalino.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umbe, iaku bhekulingka maridho mpuu,","poem":1},{"text":"tee kumboore i tana matuu. Sela","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iaku bhekupekadhei kupeelo tampa peulusaku","poem":1},{"text":"minaaka i ngalu makaa tee garura.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"E Kawasana Opu, upabingumea manga musuku tee upapogeso-gesomea pogauna,","poem":1},{"text":"roonamo kukamata mia apewau kasega tee apogera i nuncana kota.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Malo eona manga incia apekatii-tii i bhawona rindina bente motiingina kota,","poem":1},{"text":"tee i nuncana kota apewau kadhaki tee apanarakaa mia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Manga incia apabinasa mia i tanga-tangana kota,","poem":1},{"text":"i dhaoa manga incia sadhaadhaa apekapisaki tee apekatipu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ande o musuku abanciaku,","poem":1},{"text":"amembali kukapoia,","poem":2},{"text":"ande o bhaliku ahinaaku","poem":1},{"text":"amembali kupekaridho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maka ingkoo mboomo samia witinaiku!","poem":1},{"text":"Sabhangkaku! Sampomatauku malape!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I piamo itu ingkita taposabhangka malape,","poem":1},{"text":"tee tapobhawa-bhawa talingka i bhanuana Aulataʼala i tanga-tangana mia bhari!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taroakamo manga musuku amate inda atomatau,","poem":1},{"text":"tee asapo akadhadhi-dhadhi i duniana mia mate,","poem":2},{"lineBreak":true},{"text":"roonamo kadhaki dhaangia i mbooresana tee i tanga-tangana manga incia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Maka iaku bhekugora i Aulataʼala,","poem":1},{"text":"tee KAWASANA OPU bheapasalaamatiaku.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wakutuuna konowia, saeona, tee pontanga eo,","poem":1},{"text":"kupeenci tee kupekidhei,","poem":2},{"lineBreak":true},{"text":"tee Incia uka bhearango suaraku.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Incia bheatolosiaku","poem":1},{"text":"minaaka i musu mobhaliaku,","poem":2},{"lineBreak":true},{"text":"roonamo abhari mia moewangiaku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aulataʼala, mokokauncuramakana pepuu i zamani i piamo itu,","poem":1},{"text":"bhearangoa doʼaku tee apekatalo manga incia,","poem":2},{"text":"roonamo manga incia amendeu atoba","poem":1},{"text":"tee inda amaeka i Aulataʼala. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mia mopadhana kuabhia witinaiku incia sumai apacilaka sabhangkana,","poem":1},{"text":"tee incia inda akeniakea janjina.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bhoasakana amaʼalusu mpuu to aala-ala inca,","poem":1},{"text":"maka neatina to apacilaka mia.","poem":2},{"text":"Pogauna amararo alabhi minaaka i mina,","poem":1},{"text":"maka satotuuna bhari-bharia sumai mboomo ewanga momatadha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Pasarakaakamea o bhawamu i KAWASANA OPU,","poem":1},{"text":"sumaimo Incia bheadhambaakako,","poem":2},{"lineBreak":true},{"text":"tee inda bheataroaka mia mobanara abagoea saʼumurua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Maka Ingkoo, e Aulataʼala, bheupapesua manga incia","poem":1},{"text":"i nuncana kabhalongko momandalana mpuu.","poem":2},{"text":"Manga pande pekamate tee pande pekagau","poem":1},{"text":"inda bheakawa samuntanga umuruna.","poem":2},{"text":"Maka, iaku kuparacaea i Ingkoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":24}