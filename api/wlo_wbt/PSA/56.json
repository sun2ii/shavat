{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":56,"content":[{"type":"heading","content":["I Nuncana Kanarakaa, Taharapu i Aulataʼala"]},{"type":"verse","number":1,"content":["To kapalana molaguna.",{"text":"Mboomo lagu: Manu-manu jarajara mopopoteona i puuna kau tarbantin","poem":1},{"noteId":28},{"text":"momaridho. Zaburuna Daud wakutuuna miana Filistin arako incia i Gat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E Kawasana Opu, maasiakaaku roonamo manga mia alanda-landakiaku","poem":1},{"text":"tee saeoa apisakiaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Manga musuku sadia alanda-landakiaku,","poem":1},{"text":"abhari mia moewangiaku, e Aulataʼala Momalanga!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I wakutuuna kumaeka,","poem":1},{"text":"kuparacaea i Ingkoo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iaku kupuji firimanina Aulataʼala,","poem":1},{"text":"tee kuparacaea i Aulataʼala, siitumo inda bhekumaeka.","poem":2},{"lineBreak":true},{"text":"Opea momembalina ipewauna maanusia to iaku? Inda dhaangia!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Saeoa musuku apatiipambuli pogauku,","poem":1},{"text":"bhari-bharia haejatina manga incia to iaku amadhaki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Manga incia aporomusaka tee apeopo,","poem":1},{"text":"alukuti bhengkalaku,","poem":2},{"lineBreak":true},{"text":"tee ahaejati apekamateaku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balasia manga incia to kadhakina ipewauna;","poem":1},{"text":"e Kawasana Opu, patobhatamea manga lipu tee amaramu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ingkoo umataua saopea kabharina kanarakaaku,","poem":1},{"text":"Udhika loluku i nuncana butolomu.","poem":2},{"lineBreak":true},{"text":"Buaka bhari-bharia dhaangia i nuncana kitabimu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sumaimo manga musuku bheasowo","poem":1},{"text":"i wakutuuna kugora.","poem":2},{"text":"Tee mboo sumai, kumataua","poem":1},{"text":"ande Aulataʼala aewaakaaku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iaku kupogauaka kalape to KAWASANA OPU tee kupuji firimanina,","poem":1},{"text":"roonamo Aulataʼala adhawu janji momalape.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iaku kuparacaea i Incia, siitumo iaku inda bhekumaeka.","poem":1},{"text":"Opea momembalina ipewauna maanusia to iaku?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"E Aulataʼala, kuwaajibu bhekupewaua tolauna oniku tee Ingkoo,","poem":1},{"text":"bhekupasombaaka kurubani kasukuru i Ingkoo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sababuna Ingkoo upasalaamatiaku minaaka i mate,","poem":1},{"text":"tee ujaganiaku sabutuna inda kutosunu.","poem":2},{"text":"Tee mboo sumai, iaku kumembali kulingka i aroana Aulataʼala","poem":1},{"text":"i nuncana kainawana dhadhi.","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"tarbantin: Sagiu puuna kau maoge tee rahana abhari mboomo puuna kau wuraha.","reference":{"chapter":56,"verse":1}}]},"thisChapterLink":"/api/wlo_wbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}