{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"heading","content":["Doʼa Emaniana Peulusa"]},{"type":"verse","number":1,"content":["To kapalana molaguna.",{"text":"Tee kagasiana kecapi. Zaburuna Daud.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E Aulataʼala rangoa igoraakaku,","poem":1},{"text":"perangoia o doʼaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Minaaka i tapana alamu kugoraakako","poem":1},{"text":"wakutuuna amate akalaku.","poem":2},{"lineBreak":true},{"text":"Bhawaaku i gunu bhatu","poem":1},{"text":"molabhina kalangana minaaka i karoku","poem":2}]},{"type":"verse","number":4,"content":[{"text":"roonamo Ingkoomo peulusaku,","poem":1},{"text":"munara momakaa to kupeuluaka minaaka i musuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taroakamo saʼumurua dhadhiku kumboore i nuncana Kema Momangkilomu,","poem":1},{"text":"mamudhaakana kuʼamani i nuncana peulusana panimu. Sela","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sababuna Ingkoo padhamo urango tolauna oniku, e Aulataʼala,","poem":1},{"text":"tee padhamo udhawuaku tinauraka idhawuakamu to mia momaekako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maasangia upekarambe umuruna raja,","poem":1},{"text":"mamudhaakana incia adhadhi saʼumurua.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maasangia incia amembali raja saʼumurua i aroana Aulataʼala,","poem":1},{"text":"parintaakamea o kaasimu molagina tee janjimu inda momabhotu to mojagania.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sumaimo iaku sadia bhekulaguaka lagu kapujia to saromu,","poem":1},{"text":"tee kupomea tolauna oniku saesaeo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}