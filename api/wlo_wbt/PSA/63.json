{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":63,"content":[{"type":"heading","content":["Pemelili i Kawasana Opu"]},{"type":"verse","number":1,"content":["Zaburuna Daud wakutuuna incia adhaangia i Tana Matuuna Yuda."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E Aulataʼala, Ingkoomo Aulataʼalaku, iaku kupeeloko,","poem":1},{"text":"tee gauku kupokawa tee Ingkoo.","poem":2},{"text":"Saangua badaku apemeliliakako,","poem":1},{"text":"mboomo mia molingkana i tana matuu mofaraluuna uwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mboo sumaimo kutontoko i tampamu momangkilo","poem":1},{"text":"to kukamataaka kuasamu tee kamuliangimu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Roonamo kaasimu molagina alabhi akoharagaa minaaka i dhadhi,","poem":1},{"text":"sababuna sumai kupujiko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mboo sumaimo bhekupujiko saʼumurua dhadhiku,","poem":1},{"text":"tee kuangka limaku to kumuliangi saromu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Atumpu incaku, mboomo tee kinande momambaka,","poem":1},{"text":"tee kupujiko tee bhiwiku mokaunde-unde,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"wakutuu kuudhaniko i kolemaku,","poem":1},{"text":"tee kufikiriko samaloa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Roonamo Ingkoomo motulungiaku,","poem":1},{"text":"i tambena panimu iaku kusambo-sambo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngangarandaku bheakeniakako pekatangka,","poem":1},{"text":"lima kaanamu atukoaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Maka manga mia mohaejatina mopekamateaku","poem":1},{"text":"bheapesua i tambena tana tee manga mia mate;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"manga musuku bheatopekamateaka tee hancu,","poem":1},{"text":"tee amembali kinandena serigala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maka raja bheakaunde-unde roonamo katulungina Aulataʼala;","poem":1},{"text":"bhari-bharia mia moposumpana tee Aulataʼala bheabangga,","poem":2},{"lineBreak":true},{"text":"roonamo Incia bheasoncongi ngangana manga pande gau-gau.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}