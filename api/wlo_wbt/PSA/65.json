{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":65,"content":[{"type":"heading","content":["Kasukuru to Barakati Idhawuakana Aulataʼala"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Zaburuna Daud. Laguna."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E Aulataʼala, alaengamo ingkami tapujiko i Sion,","poem":1},{"text":"tee tapomea o tolauna onimami i Ingkoo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sababuna Ingkoomo moperangoina doʼa,","poem":1},{"lineBreak":true},{"text":"i Ingkoomo bhari-bharia maanusia bheaumba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wakutuuna dosamami alabhi o katamona minaaka i kakaamami,","poem":1},{"text":"Ingkoomo moʼamponina kasalahamami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amasanaamo mia ipilimu tee ipekakasumu","poem":1},{"text":"to amboore i aroana Bhanuamu.","poem":2},{"text":"Bheapatumpu incamami tee bhari-bharia momalapena modhaangiana i Bhanuamu,","poem":1},{"text":"siitumo i nuncana Baitullamu momangkilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tee manga pewaumu moʼadili tee inda momentela","poem":1},{"text":"Ingkoo ulawani ingkami,","poem":2},{"lineBreak":true},{"text":"e Kawasana Opu, mopasalaamatina ingkami.","poem":2},{"text":"Ingkoomo iparacaeana saangua alamu","poem":1},{"text":"tee i tawo momaridho mpuu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Minaaka i kakaamu, upakaro manga gunu;","poem":1},{"text":"upakanaakea kuasamu momakaana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ingkoomo mopauntona suarana pamuruna tawo,","poem":1},{"text":"siitumo suarana pamuruna ewona,","poem":2},{"lineBreak":true},{"text":"tee karobhona manga lipu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Manga mia i saangua alamu","poem":1},{"text":"amaeka akamata manga tanda inda momentela ipewaumu.","poem":2},{"text":"Minaaka i timbu sakawana i bhara,","poem":1},{"text":"upewaua asambo-sambo tee akaunde-unde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tana sumai udhambaakea tee udhawua wao,","poem":1},{"text":"Upasuburua sabutuna hasilina abhari mpuu.","poem":2},{"text":"Umalana Aulataʼala abukeaka tee uwe,","poem":1},{"text":"tee upasadiaakea gandum to maanusia,","poem":2},{"text":"mboo sumaimo upatotapuakea.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ingkoo sadia upakouwe tana ibhingkunina,","poem":1},{"text":"tee uparatea manga tongkana tanana,","poem":2},{"text":"upekagodhea tee wao,","poem":1},{"text":"tee ubarakati manga penembulana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Roonamo kalapemu, satao-satao udhawuakea timpua,","poem":1},{"text":"I iapaipo ubhengkala, ubholi manga giu momalape.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Manga rumpu i tana matuu atuwu asuburu,","poem":1},{"text":"manga gunu akaunde-unde.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Manga tana mokorumpu abukeaka gulumana dumba,","poem":1},{"text":"tee manga mbolonga atipuaka gandum.","poem":2},{"lineBreak":true},{"text":"Bhari-bharia asambo-sambo tee alagu akaunde-unde.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}