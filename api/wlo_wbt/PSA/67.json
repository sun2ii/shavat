ext":"roonamo Ingkoo tee kaʼadili uhaakimu manga lipu,","poem":2},{"lineBreak":true},{"text":"tee utonda bhari-bharia lipu i bhawona alamu. Sela","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maasangia manga lipu apujiko, e Aulataʼala,","poem":1},{"text":"maasangia bhari-bharia lipu apujiko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alamu padhamo adhawuaka hasilina;","poem":1},{"text":"Aulataʼala, Aulataʼalata, padhamo abarakati ingkita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maasangia Aulataʼala manga barakati torosu;","poem":1},{"text":"maasangia bhari-bharia lipu i bhawona dunia amaekaia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}