{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"heading","content":["Doʼa Emaniana Katulungi"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Zaburuna Daud. Zikiri i wakutuuna pasombaana kurubanina kaudhania."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E Aulataʼala, pasalaamatiaku!","poem":1},{"text":"E KAWASANA OPU, tulungiaku pekadhei!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taroakamo manga mia mogauna mopekamateaku","poem":1},{"text":"amaea tee apalai roonamo abingu.","poem":2},{"text":"Taroakamo manga mia mogauna mopacilakaaku","poem":1},{"text":"apotibhaaka kahina tee aʼaebu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taroakamo manga mia mopogauna, \"Namisia, namisia!\" tee mopotawaikiaku","poem":1},{"text":"abhalili roonamo amaea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taroakamo bhari-bharia mia mopeeloko","poem":1},{"text":"asambo-sambo tee akaunde-unde roonamo Ingkoo.","poem":2},{"text":"Taroakamo manga mia momaasiakana kasalaamati minaaka i Ingkoo","poem":1},{"text":"sadia apogau, \"Tapanamo kalanga o Aulataʼala!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iaku sii kunarakaa tee kumisikini,","poem":1},{"text":"umbamo pekadhei, e Aulataʼala!","poem":2},{"text":"Ingkoomo motulungiaku tee mopasalaamatiaku.","poem":1},{"text":"E KAWASANA OPU bholi upekanoe-noe!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}