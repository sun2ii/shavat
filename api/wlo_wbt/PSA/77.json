{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":77,"content":[{"type":"heading","content":["Ipewauna Kawasana Opu i Piamo itu"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Zaburuna Asaf to Yedutun."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iaku kugora i Aulataʼala tee suara momandii,","poem":1},{"text":"i Aulataʼala kugora, mamudhaakana aperangoiaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I piamo itu, i eona kumaseke kupeelo Kawasana Opu,","poem":1},{"text":"tee wakutuuna amalo kutanaaka limaku inda kumangumangule;","poem":2},{"lineBreak":true},{"text":"ngangarandaku inda aunda atotautau.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ande kuudhani Aulataʼala, kupekidhei;","poem":1},{"text":"ande kupeudhaudhani,","poem":2},{"noteId":47},{"text":"ahanda amaule ngangarandaku. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ingkoo mopamembalina mataku sadhaadhaa atobungkale;","poem":1},{"text":"alilaho o namisiku sabutuna inda amembali kupogauaka opeopea.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kufikifikiriaka zamani i piamo itu,","poem":1},{"text":"tee i tao-tao molapa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iaku kuudhani laguku i wakutuuna amalo,","poem":1},{"text":"kupeudhaudhani i nuncana ngangarandaku, tee o rohiku apekaabha-abha,","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"\"Buaka Kawasana Opu bheamanga bholi to saʼumurua?","poem":1},{"text":"Tee indamo uka manga maasiaka?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Buaka atopadhamo o kaasina molagina?","poem":1},{"text":"Buaka amapupumo janjina saʼumurua?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Buaka o Aulataʼala amalingumo to manga maasiaka?","poem":1},{"text":"Buaka i nuncana pamuruna Incia atutubhi rahumatina? Sela","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kasiimpo kupogau, \"Siimo kaporona incaku","poem":1},{"text":"ande o lima kaanana Momalangana Mpuu indamo ajaganiaku.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Iaku bhekuudhani opea mopadhana ipewauna KAWASANA OPU.","poem":1},{"text":"Umbe, iaku bhekuudhani manga giu inda momentela mopadhana ipewaumu i zamani i piamo itu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iaku bhekuudhaudhania i nuncana ngangarandaku bhari-bharia ikarajaamu,","poem":1},{"text":"tee kufikifikiria bhari-bharia giu momaoge mopadhana ipewaumu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dhalamu amangkilo, e Aulataʼala,","poem":1},{"text":"Dewa iapai momaogena mboo Aulataʼalamami?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ingkoomo Aulataʼala mopewauna giu inda momentela.","poem":1},{"text":"Ingkoo padhamo ususuaka kuasamu i tanga-tangana manga lipu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tee limamu utolosi uumatimu,","poem":1},{"text":"siitumo siwuluna Yakub tee Yusuf. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"E Aulataʼala, uwe akamatako,","poem":1},{"text":"uwe akamatako tee amaeka;","poem":2},{"lineBreak":true},{"text":"umbe, andalaoge uka atorende.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taʼina ngalu apasapo wao maranca,","poem":1},{"text":"tee o laiana uka akanduu-nduu;","poem":2},{"lineBreak":true},{"text":"manga anana panamu akakila-kila.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ruuna guntumu atorango i nuncana tambusisi,","poem":1},{"text":"tee o bhibhitomu apekainawa dunia.","poem":2},{"lineBreak":true},{"text":"Alamu uka akolendu tee atorende.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dhalamu alaloi tawo,","poem":1},{"text":"tee udhala upolimba i andalaoge;","poem":2},{"lineBreak":true},{"text":"maka o tandarana aemu inda atokamata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ingkoo ugembalaaka uumatimu mboomo mia mowuluna gulumana dumba","poem":1},{"text":"tee upake limana Musa tee Harun to akapalai manga incia.","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"kupeudhaudhani: Atawa \"kupekidei;\" dhaangia giu apokana i aeati 77:7tee 77:13uka.","reference":{"chapter":77,"verse":4}}]},"thisChapterLink":"/api/wlo_wbt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}