{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"heading","content":["Mahaluku Mohina mboomo Mahaluku Momulia"]},{"type":"verse","number":1,"content":["To kapalana molaguna. Mboomo lagu Gitit.",{"noteId":6},"Zaburuna Daud."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"E KAWASANA OPU,","poem":1},{"noteId":7},{"text":"e Aulataʼalamami,","poem":1},{"text":"saromu amulia i saangua alamu!","poem":2},{"lineBreak":true},{"text":"Kaogesana kuasamu alabhi kalangana minaaka i laiana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Minaaka i ngangana manga anaana momaidhiidhi tee anaana modudu uka apuji kamuliangimu.","poem":1},{"text":"Roonamo Ingkoo padhamo upakaro bente potaangia momatangka","poem":2},{"lineBreak":true},{"text":"sabutuna o ngangana bhari-bharia musu tee bhalimu atosoncongi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ande kutonto tee kufikiri laiana ipadhaangiamu,","poem":1},{"text":"bula tee kalipopo idhikamu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"incema buaka o maanusia sumai, mbakana uudhania,","poem":1},{"text":"incema buaka o incia, mbakana udhambaakea?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maka upewau maanusia saidhepo apokana tee Aulataʼala,","poem":1},{"noteId":8},{"text":"upakanaakea tee mahakota kamuliangi tee kahoromati.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Udhawua kuasa to saangua alamu,","poem":1},{"text":"bhari-bharia ipadhaangiamu upatungkua i incia:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dumba, sapi tee bhari-bharia binata kadhambaaka,","poem":1},{"text":"tee manga binata i rumpu;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Manu-manu tee manga ikane","poem":1},{"text":"bhari-bharia mahaluku i nuncana tawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"E KAWASANA OPU, Aulataʼalamami,","poem":1},{"text":"saromu amulia i saangua alamu!","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Gitit: Zaburu incia sii aose suarana lagu tee gambusu minaaka i Gat, siitumo sala saangu kota miana Filistin. Gat sumai mopadhana imbooresina Nabii Daud wakutuuna apalaiaka karona minaaka i Raja Saul.","reference":{"chapter":8,"verse":1}},{"noteId":7,"caller":"+","text":"KAWASANA OPU: Ande atoburi tee horofu maoge, saro incia sii o sarona karona Aulataʼala i oni Ibrani atosarongi YAHWEH, sainamo ande atoburi tee horofu maidhiidhi, maʼanana o Kawasana Opu (Ibrani: Adonai).","reference":{"chapter":8,"verse":2}},{"noteId":8,"caller":"+","text":"Aulataʼala: Amembali uka maʼanana manga malaaʼekati atawa o mahalukuna sorogaa.","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/wlo_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}