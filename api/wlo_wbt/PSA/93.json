{"translation":{"id":"wlo_wbt","name":"Kitabi Momangkilona Wolio","website":"https://ebible.org/Scriptures/details.php?id=wlo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wlo","licenseNotes":null,"shortName":"WBT","englishName":"Wolio: Kitabi Momangkilona Wolio (New Testament+)","language":"wlo","textDirection":"ltr","sha256":"d32801f50faba7fa42c649f28d714066e96b3ef15ccb3252053b56a5dc2621c0","availableFormats":["json"],"listOfBooksApiLink":"/api/wlo_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":471,"totalNumberOfVerses":12473,"languageName":"Wolio","languageEnglishName":"Wolio"},"book":{"id":"PSA","translationId":"wlo_wbt","name":"ZABURU","commonName":"ZABURU","title":"Zaburu","order":19,"numberOfChapters":150,"sha256":"f96a2c679bdee48d2eea2061c5f54f7c1464ae70873075c24958095f24c4d47a","firstChapterNumber":1,"firstChapterApiLink":"/api/wlo_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wlo_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":93,"content":[{"type":"heading","content":["Kawasana Opu o Raja Saʼumurua"]},{"type":"verse","number":1,"content":[{"text":"KAWASANA OPU o Raja, Incia abukeaka kamuliangi!","poem":1},{"text":"KAWASANA OPU abukeaka kuasa, tee apatokamata kakaana.","poem":2},{"lineBreak":true},{"text":"Incia apakakaro dunia tee inda dhaangia momembalina mohudhalia.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kauncuramakamu amatangka minaaka i zamani mangenge,","poem":2},{"lineBreak":true},{"text":"tee Ingkoo udhaangiamo minaaka i dunia indapo dhaangia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Manga umala mokalua-lua ahandamo apekaoge suarana, e KAWASANA OPU,","poem":1},{"text":"manga umala mokalua-lua ahandamo apekaoge suarana,","poem":2},{"lineBreak":true},{"text":"manga umala mokalua-lua ahandamo apekaoge ruuna ewona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maka minaaka i suarana uwe momaoge,","poem":1},{"text":"tee minaaka i ewona tawo momakaa,","poem":2},{"lineBreak":true},{"text":"alabhi amaoge KAWASANA OPU i tampa momalanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E KAWASANA OPU, hukumumu abakaa saʼumurua,","poem":1},{"text":"Kangkilo alaenga i nuncana Bhanuamu saʼumurua zamani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wlo_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wlo_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wlo_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}