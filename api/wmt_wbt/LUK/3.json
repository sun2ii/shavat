. Wali piyirnwarntirlu palu ngurrpangu jularnani Jawujapkura walaku Jesus. Kilakiwarnti palurla kujarti kajalurnijangkawarnti.",{"text":"Jawujapkura ngarpu parla yini Yilayi,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yilayikura ngarpu parla yini Matat,","poem":1},{"lineBreak":true},{"text":"Matatkura ngarpu parla yini Lipayi,","poem":1},{"lineBreak":true},{"text":"Lipayikura ngarpu parla yini Milki,","poem":1},{"lineBreak":true},{"text":"Milkikura ngarpu parla yini Janayi,","poem":1},{"lineBreak":true},{"text":"Janayikura ngarpu parla Jawujapwarlany,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Jawujapkura ngarpu parla yini Matatayij,","poem":1},{"lineBreak":true},{"text":"Matatayijkura ngarpu parla yini Ramas,","poem":1},{"lineBreak":true},{"text":"Ramaskura ngarpu parla yini Niyam,","poem":1},{"lineBreak":true},{"text":"Niyamkura ngarpu parla yini Yijili,","poem":1},{"lineBreak":true},{"text":"Yijilikura ngarpu parla yini Nakayi,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nakayikura ngarpu parla yini Mayat,","poem":1},{"lineBreak":true},{"text":"Mayatkura ngarpu parla Matatayijwarlany,","poem":1},{"lineBreak":true},{"text":"Matatayijkura ngarpu parla yini Jimiyan,","poem":1},{"lineBreak":true},{"text":"Jimiyankura ngarpu parla yini Jawujik,","poem":1},{"lineBreak":true},{"text":"Jawujikkura ngarpu parla yini Jawuta,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Jawutakura ngarpu parla yini Juwanan,","poem":1},{"lineBreak":true},{"text":"Juwanankura ngarpu parla yini Rija,","poem":1},{"lineBreak":true},{"text":"Rijakura ngarpu parla yini Jarapapil,","poem":1},{"lineBreak":true},{"text":"Jarapapilkura ngarpu parla yini Jiyaljiyal,","poem":1},{"lineBreak":true},{"text":"Jiyaljiyalkura ngarpu parla yini Niri,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nirikura ngarpu parla Milkiwarlany,","p