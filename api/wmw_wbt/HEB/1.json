{"translation":{"id":"wmw_wbt","name":"Habari Ngema","website":"https://ebible.org/Scriptures/details.php?id=wmw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wmw","licenseNotes":null,"shortName":"WBT","englishName":"Mwani NT","language":"wmw","textDirection":"ltr","sha256":"ed879864791ffdb4215e7145fc6b556a6a10831481fce7b97566164797321ae1","availableFormats":["json"],"listOfBooksApiLink":"/api/wmw_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7959,"languageName":"Mwani","languageEnglishName":"Mwani"},"book":{"id":"HEB","translationId":"wmw_wbt","name":"Waebraniya","commonName":"Waebraniya","title":"Waraka ka Waebraniya","order":58,"numberOfChapters":13,"sha256":"44abeff21c7933642c16501291a227b1b13560b2c4a4c3bb607b0a87eb98b927","firstChapterNumber":1,"firstChapterApiLink":"/api/wmw_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/wmw_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Mwana wa Mwenyezimungu nkulu pakulu"]},{"type":"verse","number":1,"content":["Mida-na-midada, Mwenyezimungu kâsowera na wababu zetu mara nyingi zawenye, kwa namuna nyingi zawenye, julu ya minabii."]},{"type":"verse","number":2,"content":["Fala sambi, suku za mwinsho‑zi, kasowera nofwe julu ya Mwanawe, aturiwe na Mwenyezimungu kuwa mwenyé irati wa vinu piya, na iye ndi ire julu yake Mwenyezimungu ombire vinu piya."]},{"type":"verse","number":3,"content":["Mwana‑yo ndi nlangaza wa utukufu wa Mwenyezimungu, na atolotera kweli-kwelini vyaari Mwenyezimungu. Vinu piya mulumwengu‑mu viwankwikala kwa uwezo wa ámuri zake. Bandi yakutimiza kazi yake yakuswafi madambi, kekala nkono-nriro wa Mwenye Nkulu mbinguni,"]},{"type":"verse","number":4,"content":["kwa kuwa kantula kuwa bora pakulu sana zaida ya malaika, kamba zina raritire rakuwa na mamulaka pakulu zaida ya mazina a malaika."]},{"type":"verse","number":5,"content":["Ndi kweli konta Mwenyezimungu tangu aanamwambira laika wake mmojawapo javi",{"noteId":0},":",{"lineBreak":true},{"text":"“Uwe kuwa mwanangu,","poem":1},{"lineBreak":true},{"text":"omi rero nanza kuwa wawayo.”","poem":1},{"lineBreak":true},"Na tena, aanamwambira laika mmojawapo javi",{"noteId":1},":",{"lineBreak":true},{"text":"“Omi nukuja kuwa Baba wako","poem":1},{"lineBreak":true},{"text":"na uwe ukuja kuwa mwanangu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Visitoshe Mwenyezimungu, paawere tayari kumpereka Mwanawe ntanzi",{"noteId":2},"mulumwengu‑mu, kaamba",{"noteId":3},":",{"lineBreak":true},{"text":"“Piya malaika wa Mwenyezimungu wamwabudu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Kuhusu malaika kaamba javi",{"noteId":4},":",{"lineBreak":true},{"text":"“Mwenyezimungu awatenda malaika wawe kamba mepo,","poem":1},{"lineBreak":true},{"text":"watumisi wake wawe kamba malulimi a moto.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Fala kuhusu Mwanawe, akwamba javi",{"noteId":5},":",{"lineBreak":true},{"text":"“Uwe Mwenyezimungu, útawala daima milele.","poem":1},{"lineBreak":true},{"text":"Úwatawala wanu muufalume wako kwa shariya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kwankupenda ukamilifu na wankukukima ubaya.","poem":1},{"lineBreak":true},{"text":"Kwa javyo, omi Mwenyezimungu, Nlungu wako,","poem":1},{"lineBreak":true},{"text":"nukumiminirani mafuta a radi","poem":1},{"lineBreak":true},{"text":"pakulu koliko wenziwo piya.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Mwenyezimungu kamwambira Mwanawe tena",{"noteId":6},":",{"lineBreak":true},{"text":"“Mwenye, tangu mwanzo,","poem":1},{"lineBreak":true},{"text":"uwe ndi uturire aluserusu ya duniya,","poem":1},{"lineBreak":true},{"text":"na kwa makono ako kumba bingu piya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Evyo piya-vyo vílainika, fala uwe kuwapo daima.","poem":1},{"lineBreak":true},{"text":"Avija kufãi kinu, kamba nguwo zakupapuka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kamba zubãu ya mida, ndi vyauja kukunja,","poem":1},{"lineBreak":true},{"text":"kamba munu vyaaluriza nguwo, uwapindula.","poem":1},{"lineBreak":true},{"text":"Fala uwe ndi nowe wa daima,","poem":1},{"lineBreak":true},{"text":"kuinshi kwako akuna mwinsho.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Mwenyezimungu laikani wamwambire suku moja javi",{"noteId":7},":",{"lineBreak":true},{"text":"“Ikala mahala bora‑pa upande wangu wa nkono nriro‑wu,","poem":1},{"lineBreak":true},{"text":"mpaka maaduwi wako niwature kumaulu kwako”?","poem":1},{"lineBreak":true},"Malaika‑wo wa kinani?"]},{"type":"verse","number":14,"content":["Piya‑wo siroho zintumika Mwenyezimungu na awaperekiwe kuwasaidiya wanu waja kuvushiwa?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ona 2 Samuweli 7:14; Zaburi 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"Ona 2 Samuweli 7:14.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Ntanzi akiwa nriti wa vinu piya vya wawaye.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Ona Kumbukumbu 32:43.","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"Ona Zaburi 104:4.","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"Ona Zaburi 45:6,7.","reference":{"chapter":1,"verse":8}},{"noteId":6,"caller":"+","text":"Ona Zaburi 102:25-27.","reference":{"chapter":1,"verse":10}},{"noteId":7,"caller":"+","text":"Ona Zaburi 110:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/wmw_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wmw_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wmw_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}