{"translation":{"id":"wmw_wbt","name":"Habari Ngema","website":"https://ebible.org/Scriptures/details.php?id=wmw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wmw","licenseNotes":null,"shortName":"WBT","englishName":"Mwani NT","language":"wmw","textDirection":"ltr","sha256":"ed879864791ffdb4215e7145fc6b556a6a10831481fce7b97566164797321ae1","availableFormats":["json"],"listOfBooksApiLink":"/api/wmw_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7959,"languageName":"Mwani","languageEnglishName":"Mwani"},"book":{"id":"LUK","translationId":"wmw_wbt","name":"Luka","commonName":"Luka","title":"Habari Ngema yereze Luka","order":42,"numberOfChapters":24,"sha256":"fcf6031a57a5f93a1eb632a4cc876060dfca38601fbe489d5cae1c0c1ab5944d","firstChapterNumber":1,"firstChapterApiLink":"/api/wmw_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/wmw_wbt/LUK/24.json","totalNumberOfVerses":1151},"chapter":{"number":3,"content":[{"type":"heading","content":["Kazi ya Yahaya mwenyé Koza"]},{"type":"verse","number":1,"content":["Mwaka wa kumi na ntanu wa kutawala ka Kaisari Tiberiya, ndi wakati Pontiyu Pilatu wákiwa guvinadoru wa Yudeya, Herodi ari nfalume wa Galileya, Filipi nduye Herodi ari nfalume wa inti za Itureya na Tarakoniti, Lisaniya ari nfalume wa Abileni,"]},{"type":"verse","number":2,"content":["na Anasi na Kayafa wari wakulu wa wakulungwa wa dini. Nowo wakati‑wo, usemi wa Mwenyezimungu ukimwisukira Yahaya mwana wa Zagariya ari nlanga."]},{"type":"verse","number":3,"content":["Iye kapita inti piya zíkiwa nanyenje ya muto wa Yordani, akiwereza wanu, akamba javi: “Tubiyani, moziwe ipate Mwenyezimungu akuswamiini madambi enu.”"]},{"type":"verse","number":4,"content":["Evi ndi kamba vyavyandikiwe nkitabu ca nabii Izaya javi:",{"text":"“Munu mmojawapo kawankukuwa nlanga, kankwamba:","poem":1},{"lineBreak":true},{"text":"‘Tengezani njira mumpokerere Mwenye Nvushi","poem":1},{"noteId":7},{"text":",","poem":1},{"lineBreak":true},{"text":"olosani barabara yake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mirati piya ikwijala,","poem":1},{"lineBreak":true},{"text":"myango na makinga piya vyandaziwe,","poem":1},{"lineBreak":true},{"text":"mwa kupombonyoka molosiwe,","poem":1},{"lineBreak":true},{"text":"muri mawe mubambadiwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na wanu piya wakuja kuwona kuvusha ka Mwenyezimungu.’ ”","poem":1}]},{"type":"verse","number":7,"content":["Wanu wákuka kwake wakóziwe, Yahaya akiwambira javi:",{"text":"“Kabila ya mirába sumwe!","poem":1},{"lineBreak":true},{"text":"Nani akukumbuseni kutira hukumu ya Mwenyezimungu suku zambere?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lavyani visumo vyema vyakolóta kutubiya kwenu.","poem":1},{"noteId":8},{"lineBreak":true},{"text":"Wala musambe mmyoyo yenu: ‘Tiwa nawo wawa yetu, ndi Iburahima.’","poem":1},{"lineBreak":true},{"text":"Kamana nukwambirani kuwa anta na eya mawe‑ya,","poem":1},{"lineBreak":true},{"text":"Mwenyezimungu akidiri kutadula kuwa ujukulu wa nabii Iburahima!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Epa sambi‑pa, soka riwa panzipe wa muti, tayari kutupula.","poem":1},{"lineBreak":true},{"text":"Kwa javyo, kila muti saupa visumo vyema usinjiwa,","poem":1},{"lineBreak":true},{"text":"ukwefiwa pamoto.”","poem":1}]},{"type":"verse","number":10,"content":["Wanu ware wakindairi, wakamba: “Sambi, catijuzi kutenda kinani?”"]},{"type":"verse","number":11,"content":["Yahaya akiwajibu, akisema javi: “Ári na zubãu mbiri alavye mmoja, ampe mwenziwe saana. Ári nawo cakurya, kwa namuna moja, alavye ammere mwenziwe.”"]},{"type":"verse","number":12,"content":["Na waja novyo warípisi nsoko wamojawapo kusakula koziwa. Ewo wakindairi Yahaya: “Mwanlimu, ofwe tijuzi titende kinani?”"]},{"type":"verse","number":13,"content":["Iye akiwajibu: “Musiripise kinu tena kupundisa vyamwamuriwe.”"]},{"type":"verse","number":14,"content":["Masurudadu newo novyo wakindairi javi: “Sambi ofwe, tíjuzi titende kinani?” Yahaya akiwajibu, akamba: “Musinyang'anye munu nzuruku, wala musinlongopere kinu. Muwe radi na nshahara wenu.”"]},{"type":"verse","number":15,"content":["Wanu piya wakinrindira kuja Almasihi, wakiwaza mmyoyo yawo kuwa dalili Yahaya, wakamba: “Fala iye si Almasihi?”"]},{"type":"verse","number":16,"content":["Novyo-sivyo, Yahaya akiwambira wanu ware piya: “Kusema kweli, omi nukozani na maji, fala akuja mwengine wanguvu pakulu koliko omi. Kusema kweli, omi siri bora anta wa kunvula tamango zake. Iye akozani",{"noteId":9},"na Roho Takatifu pamoja na moto."]},{"type":"verse","number":17,"content":["Iye paa iwa mmakono mwake, apate kuwandala masansi na tirigu ature kwake-kwake. Ikisa tirigu‑yo ature nkikuti mwake, ila masansi ataya moto sauzimika.",{"noteId":10},"”"]},{"type":"verse","number":18,"content":["Basi javyo, na masowezi mengine tena, Yahaya ndi vyakiwarimbisa wanu myoyo, kuno akiwereza Habari Ngema."]},{"type":"verse","number":19,"content":["Fala nfalume Herodi, kâsutumiwa na Yahaya kwa sababu ya vitendo vyake na Herodiza muka wa nduye, pamoja na vitendo vyakunyata piya vyaatendire,"]},{"type":"verse","number":20,"content":["iye akamuru Yahaya afungiwe. Kwa javyo, Herodi akipambanya akizidisa makosa ake."]},{"type":"verse","number":21,"content":["Sambi, suku moja pawesire koziwa wanu ware piya, Insa neye novyo akoziwa. Paakitenda duwa, bingu zikifunguka"]},{"type":"verse","number":22,"content":["na Roho Takatifu akimwisukira kwa nfano wakuwoneka kamba pomba. Na ikisikirikana shauti ya kulawa mbinguni ikamba: “Uwe ndi mwanangu wanukupenda, kwako uwe niwa nawo radi pakulu!”"]},{"type":"heading","content":["Wababuze Insa"]},{"type":"verse","number":23,"content":["Insa paanzire kazi zake ákiwa na kiyasi ca myaka talatini. Akijiwikana kamba mwana wa Yusufu.",{"text":"Yusufu ákiwa mwana wa Heli,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Heli mwana wa Matati,","poem":1},{"lineBreak":true},{"text":"Matati mwana wa Lawi,","poem":1},{"lineBreak":true},{"text":"Lawi mwana wa Melki,","poem":1},{"lineBreak":true},{"text":"Melki mwana wa Yana,","poem":1},{"lineBreak":true},{"text":"Yana mwana wa Yusufu,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yusufu mwana wa Matatia,","poem":1},{"lineBreak":true},{"text":"Matatia mwana wa Amosi,","poem":1},{"lineBreak":true},{"text":"Amosi mwana wa Nahumu,","poem":1},{"lineBreak":true},{"text":"Nahumu mwana wa Eshili,","poem":1},{"lineBreak":true},{"text":"Eshili mwana wa Nagayi,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagayi mwana wa Mahati,","poem":1},{"lineBreak":true},{"text":"Mahati mwana wa Matatia,","poem":1},{"lineBreak":true},{"text":"Matatia mwana wa Simeyi,","poem":1},{"lineBreak":true},{"text":"Simeyi mwana wa Yoseku,","poem":1},{"lineBreak":true},{"text":"Yoseku mwana wa Yoda,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yoda mwana wa Yowana,","poem":1},{"lineBreak":true},{"text":"Yowana mwana wa Resa,","poem":1},{"lineBreak":true},{"text":"Resa mwana wa Zorobabeli,","poem":1},{"lineBreak":true},{"text":"Zorobabeli mwana wa Salatiyeli,","poem":1},{"lineBreak":true},{"text":"Salatiyeli mwana wa Neri,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Neri mwana wa Meliki,","poem":1},{"lineBreak":true},{"text":"Meliki mwana wa Adi,","poem":1},{"lineBreak":true},{"text":"Adi mwana wa Kosamu,","poem":1},{"lineBreak":true},{"text":"Kosamu mwana wa Elimadamu,","poem":1},{"lineBreak":true},{"text":"Elimadamu mwana wa Eru,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Eru mwana wa Yoshwa,","poem":1},{"lineBreak":true},{"text":"Yoshwa mwana wa Elizeli,","poem":1},{"lineBreak":true},{"text":"Elizeli mwana wa Yorimu,","poem":1},{"lineBreak":true},{"text":"Yorimu mwana wa Matati,","poem":1},{"lineBreak":true},{"text":"Matati mwana wa Lawi,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Lawi mwana wa Ansumani,","poem":1},{"lineBreak":true},{"text":"Ansumani mwana wa Yuda,","poem":1},{"lineBreak":true},{"text":"Yuda mwana wa Yusufu,","poem":1},{"lineBreak":true},{"text":"Yusufu mwana wa Yonamu,","poem":1},{"lineBreak":true},{"text":"Yonamu mwana wa Eliyakimu,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Eliyakimu mwana wa Meleya,","poem":1},{"lineBreak":true},{"text":"Meleya mwana wa Mena,","poem":1},{"lineBreak":true},{"text":"Mena mwana wa Matata,","poem":1},{"lineBreak":true},{"text":"Matata mwana wa Natani,","poem":1},{"lineBreak":true},{"text":"Natani mwana wa Daudi,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Daudi mwana wa Yese,","poem":1},{"lineBreak":true},{"text":"Yese mwana wa Obedi,","poem":1},{"lineBreak":true},{"text":"Obedi mwana wa Bowazi,","poem":1},{"lineBreak":true},{"text":"Bowazi mwana wa Salmoni,","poem":1},{"lineBreak":true},{"text":"Salmoni mwana wa Nashoni,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nashoni mwana wa Aminadabu,","poem":1},{"lineBreak":true},{"text":"Aminadabu mwana wa Adimini,","poem":1},{"lineBreak":true},{"text":"Adimini mwana wa Arni,","poem":1},{"lineBreak":true},{"text":"Arni mwana wa Hesironi,","poem":1},{"lineBreak":true},{"text":"Hesironi mwana wa Paresi,","poem":1},{"lineBreak":true},{"text":"Paresi mwana wa Yuda,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yuda mwana wa Yankubu,","poem":1},{"lineBreak":true},{"text":"Yankubu mwana wa Izaki,","poem":1},{"lineBreak":true},{"text":"Izaki mwana wa Iburahima,","poem":1},{"lineBreak":true},{"text":"Iburahima mwana wa Tera,","poem":1},{"lineBreak":true},{"text":"Tera mwana wa Nahori,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nahori mwana wa Serugi,","poem":1},{"lineBreak":true},{"text":"Serugi mwana wa Rehu,","poem":1},{"lineBreak":true},{"text":"Rehu mwana wa Pelegi,","poem":1},{"lineBreak":true},{"text":"Pelegi mwana wa Eberi,","poem":1},{"lineBreak":true},{"text":"Eberi mwana wa Sala,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Sala mwana wa Kenani,","poem":1},{"lineBreak":true},{"text":"Kenani mwana wa Aripakisadi,","poem":1},{"lineBreak":true},{"text":"Aripakisadi mwana wa Shemu,","poem":1},{"lineBreak":true},{"text":"Shemu mwana wa Nnu,","poem":1},{"lineBreak":true},{"text":"Nnu mwana wa Lameki,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Lameki mwana wa Metusela,","poem":1},{"lineBreak":true},{"text":"Metusela mwana wa Henoki,","poem":1},{"lineBreak":true},{"text":"Henoki mwana wa Yaredi,","poem":1},{"lineBreak":true},{"text":"Yaredi mwana wa Mahalaleli,","poem":1},{"lineBreak":true},{"text":"Mahalaleli mwana wa Kenani,","poem":1},{"lineBreak":true},{"text":"Kenani mwana wa Enoshi,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Enoshi ákiwa mwana wa Seti,","poem":1},{"lineBreak":true},{"text":"Seti ákiwa mwana wa Adamu,","poem":1},{"lineBreak":true},{"text":"na Adamu wa Mwenyezimungu.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Yahaya mwenyé Koza ndi akipita akikuwa nlanga, neye akitengeza njira ya Mwenye Insa.","reference":{"chapter":3,"verse":4}},{"noteId":8,"caller":"+","text":"Mana ake: Olotani kwa vitendo vyenu kuwa kweli-kwelini mutubiya.","reference":{"chapter":3,"verse":8}},{"noteId":9,"caller":"+","text":"Nkigeregu mana ake ndi kumpa kwa wingi.","reference":{"chapter":3,"verse":16}},{"noteId":10,"caller":"+","text":"Mana ake: “Tirigu” ndi wanu wasikiriza utuba, wakifulata. “Masansi” ndi wanu sawasikiriza.","reference":{"chapter":3,"verse":17}}]},"thisChapterLink":"/api/wmw_wbt/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wmw_wbt/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wmw_wbt/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}