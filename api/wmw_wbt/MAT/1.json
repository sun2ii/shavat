{"translation":{"id":"wmw_wbt","name":"Habari Ngema","website":"https://ebible.org/Scriptures/details.php?id=wmw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wmw","licenseNotes":null,"shortName":"WBT","englishName":"Mwani NT","language":"wmw","textDirection":"ltr","sha256":"ed879864791ffdb4215e7145fc6b556a6a10831481fce7b97566164797321ae1","availableFormats":["json"],"listOfBooksApiLink":"/api/wmw_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7959,"languageName":"Mwani","languageEnglishName":"Mwani"},"book":{"id":"MAT","translationId":"wmw_wbt","name":"Matwaya","commonName":"Matwaya","title":"Habari Ngema yereze Matwaya","order":40,"numberOfChapters":28,"sha256":"02daf4e4a1fb505f8e761415f6892cd19cf55efdf89cb972624a4b3b2d13d18c","firstChapterNumber":1,"firstChapterApiLink":"/api/wmw_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/wmw_wbt/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"heading","content":["Rikolo ra Insa Almasihi"]},{"type":"verse","number":1,"content":["Eci ndi kitabu ca rikolo ra Insa Almasihi, ujukulu wa Daudi, ujukulu wa Iburahima. Eku ndi kufulatana ka rikolo rake:"]},{"type":"verse","number":2,"content":["Iburahima kampongola Izaki,",{"text":"Izaki kampongola Yankubu,","poem":1},{"lineBreak":true},{"text":"Yankubu kampongola Yuda pamoja na wanduze,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda kampongola Paresi na Zera, wana wa Tamari;","poem":1},{"lineBreak":true},{"text":"Paresi kampongola Hesironi,","poem":1},{"lineBreak":true},{"text":"Hesironi kampongola Arama,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Arama kampongola Aminadabu,","poem":1},{"lineBreak":true},{"text":"Aminadabu kampongola Nashoni,","poem":1},{"lineBreak":true},{"text":"Nashoni kampongola Salmoni,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmoni kampongola Bowazi, mwana wa Rahabu;","poem":1},{"lineBreak":true},{"text":"Bowazi kampongola Obedi, mwana wa Ruti;","poem":1},{"lineBreak":true},{"text":"Obedi kampongola Yese,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"na Yese kampongola Daudi, ajire akiwa nfalume.","poem":1},"Daudi kampongola Selemani, mwana wa muka wa Uriya",{"noteId":0},"."]},{"type":"verse","number":7,"content":[{"text":"Selemani kampongola Rehoboyamu,","poem":1},{"lineBreak":true},{"text":"Rehoboyamu kampongola Abiya,","poem":1},{"lineBreak":true},{"text":"Abiya kampongola Asa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa kampongola Yehoshafati,","poem":1},{"lineBreak":true},{"text":"Yehoshafati kampongola Yoramu,","poem":1},{"lineBreak":true},{"text":"Yoramu kampongola Uziya,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uziya kampongola Yotamu,","poem":1},{"lineBreak":true},{"text":"Yotamu kampongola Ahazi,","poem":1},{"lineBreak":true},{"text":"Ahazi kampongola Hezekiya,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hezekiya kampongola Manase,","poem":1},{"lineBreak":true},{"text":"Manase kampongola Amoni,","poem":1},{"lineBreak":true},{"text":"Amoni kampongola Yosiya,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosiya, wakati wasamisiwe akiperekiwa Babiloniya","poem":1},{"noteId":1},{"text":",","poem":1},{"lineBreak":true},{"text":"kampongola Yekoniya na wanduze.","poem":1}]},{"type":"verse","number":12,"content":["Bandi yakusamisiwa kuka Babiloniya,",{"text":"Yekoniya kampongola Shealtiyeli,","poem":1},{"lineBreak":true},{"text":"Shealtiyeli kampongola Zerubabeli,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zerubabeli kampongola Abihudi,","poem":1},{"lineBreak":true},{"text":"Abihudi kampongola Eliyakimu,","poem":1},{"lineBreak":true},{"text":"Eliyakimu kampongola Azori,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azori kampongola Zadoki,","poem":1},{"lineBreak":true},{"text":"Zadoki kampongola Akimu,","poem":1},{"lineBreak":true},{"text":"Akimu kampongola Elihudi,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Elihudi kampongola Eleazari,","poem":1},{"lineBreak":true},{"text":"Eleazari kampongola Matani,","poem":1},{"lineBreak":true},{"text":"Matani kampongola Yankubu,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yankubu kampongola Yusufu, nlume wa Mariyamu,","poem":1},{"lineBreak":true},{"text":"ampongore Insa, etiwa Almasihi.","poem":1}]},{"type":"verse","number":17,"content":["Basi vizazi piya mwanzo wa Iburahima mpaka Daudi vipita vizazi kumi na vine. Mwanzo wa Daudi mpaka kusamisiwa kuperekiwa Babiloniya vipita vizazi kumi na vine. Na tangu ka kusamisiwa kuperekiwa Babiloniya mpaka wakati wa Almasihi vipita vizazi",{"noteId":2},"kumi na vine."]},{"type":"heading","content":["Kupongoriwa ka Insa Almasihi"]},{"type":"verse","number":18,"content":["Sambi, kupongoriwa ka Insa Almasihi",{"noteId":3},"kukuna javi: Mariyamu mamaye Insa, kâpofiwa na Yusufu, falakini saanamba kunlomba, Mariyamu kariwonerera emite kwa nguvu ya Roho Takatifu, we!"]},{"type":"verse","number":19,"content":["Yusufu nlumake, kwa kuwa mukweli na kutowa kusaka kumwanziri, akanzimiya kumwasa kisiiri-siiri."]},{"type":"verse","number":20,"content":["Falakini iye, paakiwaza kutenda javire, kwa mpunde noure, laika wa Mola kanjira akilota, akimwambira javi: “Yusufu ujukulu wa Daudi! Usofeleye kunlomba Mariyamu nkawako, konta waasaka kupongola‑yo ampongola kwa uwezo wa Roho Takatifu."]},{"type":"verse","number":21,"content":["Iye ampongola mwana nlume na ujuzi umwite zina rake Insa",{"noteId":4},", konta iye awavusha wanu wake nkati ya madambi awo.”"]},{"type":"verse","number":22,"content":["Basi piya vikuna ipate utimiziwe usowezi wasowere Mola julu ya nabii",{"noteId":5},", akamba:"]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Onani! Mwari mmoja wa bikira akuja kwimita,","poem":1},{"lineBreak":true},{"text":"ampongola mwana nlume,","poem":1},{"lineBreak":true},{"text":"na wamwita zina rake Emanueli,","poem":1},{"lineBreak":true},{"text":"mana ake: ‘Mwenyezimungu kawa pamoja nofwe.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":["Paasisimuke usingizi, Yusufu akitenda kamba vyaambiriwe na laika wa Mola ire, akimpokerera nkawake."]},{"type":"verse","number":25,"content":["Fala aamwijiwe mpaka kampongola toto nlume. Na akimwita zina rake Insa."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Daudi kâzinga na Batisheba muka wa Uriya. Ikisa wakilombana akimpongoríwa Selemani. (Ona 2 Samuweli 11.)","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"+","text":"Mayahudi wasamisiwa Iziraeli wakiperekiwa Babiloniya kwa sababu ya kubisha ámuri za Mwenyezimungu. Babiloniya rero inti ya Bugudadi.","reference":{"chapter":1,"verse":11}},{"noteId":2,"caller":"+","text":"Kizazi ndi muda mmoja wawainshi wanu mpaka piya kufwa kuja kuinshi wanu wengine.","reference":{"chapter":1,"verse":17}},{"noteId":3,"caller":"+","text":"“Almasihi” zina rengine ra Insa, mana ake Mwenye alaiziriwe kuperekiwa na Mwenyezimungu kuwavusha wanu.","reference":{"chapter":1,"verse":18}},{"noteId":4,"caller":"+","text":"“Insa” mana ake “Nvushi”.","reference":{"chapter":1,"verse":21}},{"noteId":5,"caller":"+","text":"Ona Izaya 7:14.","reference":{"chapter":1,"verse":22}}]},"thisChapterLink":"/api/wmw_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wmw_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}