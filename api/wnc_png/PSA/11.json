{"translation":{"id":"wnc_png","name":"Anututane Wam Kwikwiu Kayuk Kaknga Jesu Kraisda Takepbut Taknga Anin gatu Sam Kuupbam Lotutane Kap Taknga","website":"https://ebible.org/Scriptures/details.php?id=wnc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wnc","licenseNotes":null,"shortName":"PNG","englishName":"Wantoat NT","language":"wnc","textDirection":"ltr","sha256":"7c75ec7ee81169f7a74c3b5d373cd5fb0a5877c076312337e909b2498016c1e3","availableFormats":["json"],"listOfBooksApiLink":"/api/wnc_png/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10256,"languageName":"Wantoat","languageEnglishName":"Wantoat"},"book":{"id":"PSA","translationId":"wnc_png","name":"SAM","commonName":"SAM","title":"Lotutane Kap Taknga","order":19,"numberOfChapters":150,"sha256":"f13bdbee81dbfe9256c206235446e44929979c6cb272ae9d749bc55f42b2918c","firstChapterNumber":1,"firstChapterApiLink":"/api/wnc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wnc_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Davitda kau aaknga matakut."]},{"type":"verse","number":1,"content":[{"text":"Na Buyambam tapae gepbiatang koyuwawa ita na akgatangamik.","poem":1},{"text":"Asikaya ga apbotake ba unzingu naninggayak?","poem":2},{"lineBreak":true},{"text":"“Ga tawandakane datakunggayo. Unzing kwaiu gwenduta akgwauke datakunggak bingan.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dasingge? Wai aminda kweemna mitake","poem":1},{"text":"sakutna pake aminu noman yuaingu zikaane akusopuke yamnangge tasikaing.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tasike aminu kuupbamda kepi noman taknga gatu dua tasiwanu","poem":1},{"text":"aminu kepi noman tawake tasinggak kapata dasing siwik?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Buyambamtapa yekaune king kapa yuak.","poem":1},{"text":"Ngan, king kapa yuke aminu kuupbamu kainata akaak.","poem":2},{"lineBreak":true},{"text":"Kake sanga kuupbam tasikaingu usanzikgak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Buyambam tapata aminu noman usanzikgak.","poem":1},{"text":"Siwan ngana ita inane mama wam sandeke amak tasinangge take siknga nataing aminde asiknga bitanggak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siwan ita katau toknga siknga aknga wai aminde","poem":1},{"text":"tukngwayapbimban yasiwik.","poem":2},{"lineBreak":true},{"text":"Sike waiaknga tasikainggane buyana unin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dasingge? Anututa ina kepi noman takngakan tasinggaunin.","poem":1},{"text":"Siwan ita kepi noman tawake katak siknga usanzikgak kakngae take siknga nataak.","poem":2},{"lineBreak":true},{"text":"Ge aminu ie wam tawake tasikaingu itane nomna akaning.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wnc_png/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wnc_png/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wnc_png/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}