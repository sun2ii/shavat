{"translation":{"id":"wnc_png","name":"Anututane Wam Kwikwiu Kayuk Kaknga Jesu Kraisda Takepbut Taknga Anin gatu Sam Kuupbam Lotutane Kap Taknga","website":"https://ebible.org/Scriptures/details.php?id=wnc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wnc","licenseNotes":null,"shortName":"PNG","englishName":"Wantoat NT","language":"wnc","textDirection":"ltr","sha256":"7c75ec7ee81169f7a74c3b5d373cd5fb0a5877c076312337e909b2498016c1e3","availableFormats":["json"],"listOfBooksApiLink":"/api/wnc_png/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10256,"languageName":"Wantoat","languageEnglishName":"Wantoat"},"book":{"id":"PSA","translationId":"wnc_png","name":"SAM","commonName":"SAM","title":"Lotutane Kap Taknga","order":19,"numberOfChapters":150,"sha256":"f13bdbee81dbfe9256c206235446e44929979c6cb272ae9d749bc55f42b2918c","firstChapterNumber":1,"firstChapterApiLink":"/api/wnc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wnc_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"heading","content":["Kau aaknga Devitda matakut. Miti yot gwene kopnangge taikaing."]},{"type":"verse","number":1,"content":[{"text":"Ginu Isrel nana amin, ginda wamu anzing yanong,","poem":1},{"text":"“Buyambam tapata dua gatanimunggak gamu dasing siwan?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sike Buyambam tapata dua gatanimukut gamu","poem":1},{"text":"musiptok natapbing takngane ninu asiknga pasiwa mainam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngan. Tupa, aminda musiptou ninde natanimuke","poem":1},{"text":"amau ninkatang tasiking.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sike manggamu yanggata binga paptake","poem":1},{"text":"apu ninu pakuuwan,","poem":2},{"lineBreak":true},{"text":"ba yanggata binga paku sopuwan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siwan apaptakuu kekeknga waakngata manggamu","poem":1},{"text":"ninu kaipake kuwan gwa kumnam. Siwan ngana wena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unzingge ninda Buyambamtapa gaak kaknga asiknga inimbaknganim.","poem":1},{"text":"Ita ninu dua nindupewan iwaninda nisipa kumbumang.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ninu kwait gwenda bungeu yapundu aminu tapatuta tasike tekutna kake bepmake kukut binga peke kukumang.","poem":1},{"text":"Sike yapau wagwenu gwa dakngakutde ninu undangga akoke kukumang.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Buyambam tapa, yekapat gatu kepat pasike pekut tapata,","poem":1},{"text":"ninu ina gatanimunggak.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wnc_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wnc_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wnc_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}