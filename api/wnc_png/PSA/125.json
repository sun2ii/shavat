{"translation":{"id":"wnc_png","name":"Anututane Wam Kwikwiu Kayuk Kaknga Jesu Kraisda Takepbut Taknga Anin gatu Sam Kuupbam Lotutane Kap Taknga","website":"https://ebible.org/Scriptures/details.php?id=wnc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wnc","licenseNotes":null,"shortName":"PNG","englishName":"Wantoat NT","language":"wnc","textDirection":"ltr","sha256":"7c75ec7ee81169f7a74c3b5d373cd5fb0a5877c076312337e909b2498016c1e3","availableFormats":["json"],"listOfBooksApiLink":"/api/wnc_png/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10256,"languageName":"Wantoat","languageEnglishName":"Wantoat"},"book":{"id":"PSA","translationId":"wnc_png","name":"SAM","commonName":"SAM","title":"Lotutane Kap Taknga","order":19,"numberOfChapters":150,"sha256":"f13bdbee81dbfe9256c206235446e44929979c6cb272ae9d749bc55f42b2918c","firstChapterNumber":1,"firstChapterApiLink":"/api/wnc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wnc_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Kau Isrel aminda taike miti yot gwene kopnanga kap taknga."]},{"type":"verse","number":1,"content":[{"text":"Sike aminu Buyambam tapae banip sikaingu, waaminu tawanu Saion daka binga.","poem":1},{"text":"Tawanu wandaka miyamunu dua siknga singgak. Kekeknga siknga yuak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sike tawanu Jerusalem takumbasike yuaing.","poem":1},{"text":"Ina unzakan, apman gatu masande","poem":2},{"lineBreak":true},{"text":"Buyambam tapata aminabamu unzakan pakubasike kakuya pasiwik.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anututane aminabamdane kepna wai aminda","poem":1},{"text":"asinggan dua kayutningunin.","poem":2},{"text":"Sike unzing tasiwanu asikaya Anututane aminabamu","poem":1},{"text":"puya waiaknga atasiningunin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Buyambam tapa, gata takeakngaka take amindae atasiyamuyo.","poem":1},{"text":"Waaminu gikane mama wamu atawakaing.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siwan ngana aminu kundu kepi gutonga aknga aknga tawake gatane noman taknga ateaingu Buyambam tapata yanikwasiwan kuning.","poem":1},{"text":"Waaminkat gatu aminu inane waiakngana tawakaingkat yanikwasiwan kuning.","poem":2},{"text":"Isrel nana aminda musip kwikwik takngane yutnong.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wnc_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wnc_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wnc_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}