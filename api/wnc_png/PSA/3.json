{"translation":{"id":"wnc_png","name":"Anututane Wam Kwikwiu Kayuk Kaknga Jesu Kraisda Takepbut Taknga Anin gatu Sam Kuupbam Lotutane Kap Taknga","website":"https://ebible.org/Scriptures/details.php?id=wnc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wnc","licenseNotes":null,"shortName":"PNG","englishName":"Wantoat NT","language":"wnc","textDirection":"ltr","sha256":"7c75ec7ee81169f7a74c3b5d373cd5fb0a5877c076312337e909b2498016c1e3","availableFormats":["json"],"listOfBooksApiLink":"/api/wnc_png/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10256,"languageName":"Wantoat","languageEnglishName":"Wantoat"},"book":{"id":"PSA","translationId":"wnc_png","name":"SAM","commonName":"SAM","title":"Lotutane Kap Taknga","order":19,"numberOfChapters":150,"sha256":"f13bdbee81dbfe9256c206235446e44929979c6cb272ae9d749bc55f42b2918c","firstChapterNumber":1,"firstChapterApiLink":"/api/wnc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wnc_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Devitda Apsalom teke datakukut."]},{"type":"verse","number":1,"content":[{"text":"Buyambam tapa, natane iwana kwaapzang singgak.","poem":1},{"text":"Ngan. Aminu kwaapzangga na tasiwa maiwitde tasikaing.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tasike waaminda nae anzing nanikaing,","poem":1},{"text":"“Asikaya Anututa ga gatangamik,” ngang yakaing.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Siwan ngana, Anutu, ga tiunggu amakgane dakata binga dakngake na takusopunggayak.","poem":1},{"text":"Gata na takusopuke tasiwi natane umana buyambam siwawan nata akekekake yuat.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Siwan Anututa na gatangamikge ayatawanggat.","poem":1},{"text":"Ita enane siknga tawanu inane dakane yuke nata wamu yanggau atnatangamunggak. Natangamuke na take gatangamunggak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siwan zikaane na dapuna peke apepbotanggat.","poem":1},{"text":"Pesika gatuna enake na take yuat. Dasingge, Anututa na kakuya katak siknga nanduyuak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Natane iwana 10,000-nu kepna kepna nanata umutnawakaing.","poem":1},{"text":"Umutnawawa ngana nata ie dua gwaukgat.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Buyambam tapana, ga natane Anutuna.","poem":1},{"text":"Gata apuke na gatangamuyo.","poem":2},{"text":"Gatangamuke natane iwana atzipso.","poem":1},{"text":"Ngan, itane gena zipmanziya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Buyambam tapata ninu sandeke papan meya takngatu dua kanim.","poem":1},{"text":"Buyambam tapa, ninu gikane amindabamde kakuya take pasiwi takekan yutnim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wnc_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wnc_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wnc_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}