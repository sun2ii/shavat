{"translation":{"id":"wnc_png","name":"Anututane Wam Kwikwiu Kayuk Kaknga Jesu Kraisda Takepbut Taknga Anin gatu Sam Kuupbam Lotutane Kap Taknga","website":"https://ebible.org/Scriptures/details.php?id=wnc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wnc","licenseNotes":null,"shortName":"PNG","englishName":"Wantoat NT","language":"wnc","textDirection":"ltr","sha256":"7c75ec7ee81169f7a74c3b5d373cd5fb0a5877c076312337e909b2498016c1e3","availableFormats":["json"],"listOfBooksApiLink":"/api/wnc_png/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10256,"languageName":"Wantoat","languageEnglishName":"Wantoat"},"book":{"id":"PSA","translationId":"wnc_png","name":"SAM","commonName":"SAM","title":"Lotutane Kap Taknga","order":19,"numberOfChapters":150,"sha256":"f13bdbee81dbfe9256c206235446e44929979c6cb272ae9d749bc55f42b2918c","firstChapterNumber":1,"firstChapterApiLink":"/api/wnc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wnc_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Buyambamtapata king kapa yuak.","poem":1},{"text":"Aminu kuupbam kayuak.","poem":2},{"lineBreak":true},{"text":"Itane umana kopsa siknga aknga tauk ina usikwatanggak binga.","poem":2},{"text":"Ngan, kekekngana buyambam siknga.","poem":1},{"text":"Ita keu andaka tasiwan kekeknga siknga tangine yuak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Buyambamtapa, tapduu sangabamu dua aake yuking komune","poem":1},{"text":"ga ayukuyak. Ga asinggan asinggan yuayak. Yuke King kapa asinggan asinggan yuayak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Buyambamtapa, yanggabam gwenu amunandang siknga","poem":1},{"text":"gakngau kumzang gakngau yanggak.","poem":2},{"lineBreak":true},{"text":"Kekeknga siknga yanggak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yanggabam gwenda gakngau yanggau wa mateknga dua.","poem":1},{"text":"Siwan yanggabam gwendane sambuya enake gakngae kekeknga taku tangukgak.","poem":2},{"lineBreak":true},{"text":"Siwan ngana gatane kekekngaka buyambam siknga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sike gatane mama wamba kuupbam asinggan asinggan yuaing.","poem":1},{"text":"Siakan siknga.","poem":2},{"lineBreak":true},{"text":"Buyambamtapa, gatane yotda siknga asinggan asinggan yuak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wnc_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wnc_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wnc_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}