{"translation":{"id":"wol_inj","name":"Téereb Injiil","website":"https://ebible.org/Scriptures/details.php?id=wol2010","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wol2010","licenseNotes":null,"shortName":"INJ","englishName":"Wolof NT 2010","language":"wol","textDirection":"ltr","sha256":"a9461c25973977a4ea07c958a959a435ded9291341a41af7decfcae1183c7692","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_inj/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7918,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"MAT","translationId":"wol_inj","name":"MACË","commonName":"MACË","title":"Xibaaru jàmm bi ci Almasi bi Yeesu,ni ko Yàlla jaaralee ci MACË","order":40,"numberOfChapters":28,"sha256":"3421d1a60300ac9379a13650921e6dbdaceddf907bc2e3e15fda9672a173d8e3","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_inj/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/wol_inj/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":1,"content":[{"type":"heading","content":["Cosaanu Yeesu Kirist"]},{"type":"verse","number":1,"content":["Lii mooy cosaanu Yeesu Kirist, sëtu Daawuda, sëtu Ibraayma."]},{"type":"verse","number":2,"content":["Ibraayma moo jur Isaaxa;",{"text":"Isaaxa jur Yanqóoba;","poem":1},{"lineBreak":true},{"text":"Yanqóoba jur Yuda ak i doomi baayam;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda, Peres ak Sara ci Tamar;","poem":1},{"lineBreak":true},{"text":"Peres Esron, miy baayu Aram;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aram Aminadab;","poem":1},{"lineBreak":true},{"text":"Aminadab Nason;","poem":1},{"lineBreak":true},{"text":"Nason Salmon;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmon jur ci Raxab doom ju tudd Bowas;","poem":1},{"lineBreak":true},{"text":"Bowas am ak Ruut Obedd;","poem":1},{"lineBreak":true},{"text":"Obedd jur Isayi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"miy baayu buur bi Daawuda.","poem":1},"Daawuda moo jur Suleymaan ci ki nekkoon soxnas Uri;"]},{"type":"verse","number":7,"content":[{"text":"Suleymaan jur Robowam;","poem":1},{"lineBreak":true},{"text":"Robowam Abiya;","poem":1},{"lineBreak":true},{"text":"Abiya Asaf;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asaf Yosafat;","poem":1},{"lineBreak":true},{"text":"Yosafat Yoram, miy baayu Osiyas;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Osiyas jur Yowatam;","poem":1},{"lineBreak":true},{"text":"Yowatam Akas, miy baayu Esekiya;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Esekiya Manase;","poem":1},{"lineBreak":true},{"text":"Manase Amon;","poem":1},{"lineBreak":true},{"text":"Amon Yosiyas;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosiyas jur Yekoñas ak i doomi baayam ca jamono, ja ñu defe Yawut ya jaam, yóbbu leen Babilon.","poem":1}]},{"type":"verse","number":12,"content":["Ba ñu leen yóbboo ca Babilon,",{"text":"Yekoñas jur Salacel;","poem":1},{"lineBreak":true},{"text":"Salacel Sorobabel,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"miy baayu Abiyudd;","poem":1},{"lineBreak":true},{"text":"Abiyudd Eliyakim;","poem":1},{"lineBreak":true},{"text":"Eliyakim Asor;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asor Sadog;","poem":1},{"lineBreak":true},{"text":"Sadog Akim;","poem":1},{"lineBreak":true},{"text":"Akim Eliyudd;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliyudd Eleyasar;","poem":1},{"lineBreak":true},{"text":"Eleyasar Matan, miy baayu Yanqóoba;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yanqóoba nag moo jur Yuusufa jëkkëru Maryaama;","poem":1},{"lineBreak":true},{"text":"te ci Maryaama la Yeesu, mi ñuy wax Kirist, juddoo.","poem":1}]},{"type":"verse","number":17,"content":["Mboolem giir googu nag, la dale ca Ibraayma ba ca Daawuda, fukk lañu ak ñeent; la dale ca Daawuda ba ca njaam ga ca Babilon, fukk lañu ak ñeent; la dale njaam ga ca Babilon ba ci Kirist, fukk lañu ak ñeent."]},{"type":"heading","content":["Juddub Yeesu Kirist"]},{"type":"verse","number":18,"content":["Nii la Yeesu Kirist juddoo. Bi ñu mayee Maryaama ndeyam Yuusufa, waaye laata ñoo ànd, gis nañu ne dafa ëmb ci kàttanu Xel mu Sell mi."]},{"type":"verse","number":19,"content":["Yuusufa jëkkëram nag, nekkoon na nit ku jub te bëggu ko woona weer. Mu nara xàccook moom ci sutura."]},{"type":"verse","number":20,"content":["Waaye bi muy xalaat ci loolu, benn malaakam Boroom bi daldi ko feeñu ci gént ne ko: «Yaw Yuusufa, sëtu Daawuda, bul ragala yeggali Maryaama sa jabar, ndaxte doom ji mu ëmb, ci Xel mu Sell mi la jóge."]},{"type":"verse","number":21,"content":["Dina jur doom ju góor; nanga ko tudde Yeesu, ndaxte moo di kiy musal xeetam ci seeni bàkkaar.»"]},{"type":"verse","number":22,"content":["Loolu lépp xewoon na, ngir amal li Boroom bi wax, jaarale ko cib yonent, bi mu naan:"]},{"type":"verse","number":23,"content":[{"text":"«Janq bi dina ëmb,","poem":1},{"lineBreak":true},{"text":"jur doom ju góor,","poem":1},{"lineBreak":true},{"text":"ñu tudde ko Emanuwel,»","poem":1},"liy tekki «Yàlla ganesi na nu.»"]},{"type":"verse","number":24,"content":["Noonu Yuusufa yewwu, yeggali soxnaam, na ko ko malaakam Boroom bi sante woon."]},{"type":"verse","number":25,"content":["Waaye àndul ak moom, ba kera mu mucc, jur doom ju góor; mu tudde ko Yeesu."]}],"footnotes":[]},"thisChapterLink":"/api/wol_inj/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_inj/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}