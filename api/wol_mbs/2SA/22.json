{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"2SA","translationId":"wol_mbs","name":"2.Samiyel","commonName":"2.Samiyel","title":"2.Samiyel di téereb ñaareel bi","order":10,"numberOfChapters":24,"sha256":"374e2e6de5daa9e41a7f61848d35d0aa1a386abc9a5b176cea8e699d86674843","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/wol_mbs/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Daawuda sant na"]},{"type":"verse","number":1,"content":["Daawuda woy na Aji Sax ji gannaaw ba ko Aji Sax ji xettalee ci mboolemi noonam, xettali ko it ci Sawul. Kàdduy woy wa lii la."]},{"type":"verse","number":2,"content":["Mu ne:",{"text":"Aji Sax ji mooy sama cëslaay, moo may aar, di ma wallu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yàllaay sama cëslaay li ma yiiroo,","poem":1},{"lineBreak":true},{"text":"fegu, mucc,","poem":1},{"lineBreak":true},{"text":"làqu, raw, mucc fitna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ki yelloo cant, Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moom laa woo, mucc ci samay noon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gannaxi dee mëdd ma,","poem":1},{"lineBreak":true},{"text":"walum kasara naq ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buumi njaniiw laaw ma,","poem":1},{"lineBreak":true},{"text":"dee ne jaas, di ma fiir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma jàq, woo Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ne sama Yàlla wallóoy, mu dégge këram.","poem":1},{"lineBreak":true},{"text":"Ma yuuxu, muy dégg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mu mer, suuf yëngu, di ker-keri,","poem":1},{"lineBreak":true},{"text":"kenuy asamaan jaayu, di reg-regi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Saxaar di sël-sëlee ca wakkan ya,","poem":1},{"lineBreak":true},{"text":"sawara boye ca gémmiñ ga,","poem":1},{"lineBreak":true},{"text":"xal yu yànj tàkke ca.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mu firi asamaan, wàcc,","poem":1},{"lineBreak":true},{"text":"niir yu fatt lal tànk ya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma nga war malaakam serub, di naaw,","poem":1},{"lineBreak":true},{"text":"daayaarloo laafi ngelaw.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma nga bàddoo lëndëm,","poem":1},{"lineBreak":true},{"text":"làmboo jali ndox aki xàmbaar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Leer a ko jiitu,","poem":1},{"lineBreak":true},{"text":"ay xali sawara topp ca.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aji Sax jee dënoo asamaan.","poem":1},{"lineBreak":true},{"text":"Aji Kawe jee àddu,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"soqiy fitt ak jumi melax,","poem":1},{"lineBreak":true},{"text":"tasaare leen, fëlxe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aji Sax ji gëdd,","poem":1},{"lineBreak":true},{"text":"nokki, mu riir;","poem":1},{"lineBreak":true},{"text":"xuri géej ne fàŋŋ,","poem":1},{"lineBreak":true},{"text":"ron suuf ne duŋŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Moo yóotoo fa kaw, jàpp ma,","poem":1},{"lineBreak":true},{"text":"seppee ma ca xóotey ndox ma,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"musal ma ca noon yu mag,","poem":1},{"lineBreak":true},{"text":"ya ma bañ te man ma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ñu dajeek man, bés ba ma jàqee,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji taxawu ma,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"yaatal ma,","poem":1},{"lineBreak":true},{"text":"bége ma, ba xettali ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Aji Sax jee ma yool sama njub,","poem":1},{"lineBreak":true},{"text":"samay loxoo set, mu fey ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sàmm naa yooni Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"bonuma, di moy sama Yàlla.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dama ne jàkk ndigalam yépp,","poem":1},{"lineBreak":true},{"text":"dëdduwuma dogali yoonam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Seede na, may jëfeg mat,","poem":1},{"lineBreak":true},{"text":"di moyoo tooñ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aji Sax jee ma yool sama njub,","poem":1},{"lineBreak":true},{"text":"rafetlu sama mucc ayib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yaw Aji Sax ji, ku gore, fekk la gore;","poem":1},{"lineBreak":true},{"text":"ku matale, fekk la matale;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ku sellal, fekk la sell;","poem":1},{"lineBreak":true},{"text":"ku dëng, fekk laak say feem.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yaw yaay musal xeet wu néew doole,","poem":1},{"lineBreak":true},{"text":"kuy daŋŋiiral, nga detteel.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yaw Aji Sax ji, kay, laay niitoo,","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey leeral sama lëndëm.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Maak yaw kay, ma song gàngoor.","poem":1},{"lineBreak":true},{"text":"Maak sama Yàlla, ma tëbum tata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yàllaa mat.","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee wér te wóor.","poem":1},{"lineBreak":true},{"text":"Mooy feg képp ku ko làqoo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ana kuy Yàlla ku moy Aji Sax ji?","poem":1},{"lineBreak":true},{"text":"Ana ku mat cëslaay ku dul sunu Yàlla?","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Yàllaa may làqe dooleem,","poem":1},{"lineBreak":true},{"text":"xàllal ma, yoon mat.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Moo ma gaawal ni kéwél,","poem":1},{"lineBreak":true},{"text":"taxawal ma fu kawe.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Moo may tàggat ci xare,","poem":1},{"lineBreak":true},{"text":"may tàwwig fitt ci xalag xànjar.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaa may feg, musal ma,","poem":1},{"lineBreak":true},{"text":"yaa may nangul, darajaal ma.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Yaa ma xàllalu yoon,","poem":1},{"lineBreak":true},{"text":"ba duma tërëf.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Maay dàq noon yi, falaxe,","poem":1},{"lineBreak":true},{"text":"jekkali, doora dëpp.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ma rajaxe, nemmali, jógatuñu,","poem":1},{"lineBreak":true},{"text":"xanaa fëlëñu, ma joggi.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Sol nga ma dooley xare,","poem":1},{"lineBreak":true},{"text":"sukkal ñi ma jógal, ñu féete ma suuf.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Yaa ma won ndoddi noon,","poem":1},{"lineBreak":true},{"text":"ma boole bañ yi, bóom.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Ñu ne wallóoy, wall amul,","poem":1},{"lineBreak":true},{"text":"ñu woo Aji Sax ji, faalewu leen.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ma wol, ba ñu doon pënd,","poem":1},{"lineBreak":true},{"text":"dër, noote ni banu mbedd.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Yaa ma xettali ci bokk yiy fippu,","poem":1},{"lineBreak":true},{"text":"def ma, ma jiite ay xeet;","poem":1},{"lineBreak":true},{"text":"waaso wu ma xamul sax nangul ma,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"ku ma ci dégg, déggal ma,","poem":1},{"lineBreak":true},{"text":"ay doomi doxandéem di ma raamal,","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"ne yàcc,","poem":1},{"lineBreak":true},{"text":"génne seeni tata, di lox.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Aji Sax jeey Kiy dund! Sama cëslaay a jara sant!","poem":1},{"lineBreak":true},{"text":"Yàlla sama wéeru-mucc moo màgg!","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Mooy Yàlla ji may feyul,","poem":1},{"lineBreak":true},{"text":"di ma suufeelal xeet yi.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Xettali nga maak ku ma bañ ak ku ma jógal,","poem":1},{"lineBreak":true},{"text":"kaweel ma, ma tiim leen,","poem":1},{"lineBreak":true},{"text":"xettaleeti ma cib soxor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Kon Aji Sax ji, ma sant la ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"kañ la!","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Yaay may sa buuru ñoñ ndam lu réy,","poem":1},{"lineBreak":true},{"text":"yaay ji ngor ki nga fal,","poem":1},{"lineBreak":true},{"text":"muy man Daawuda, di sama askan ba fàww.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}