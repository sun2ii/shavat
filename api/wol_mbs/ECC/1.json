{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":1,"content":[{"type":"heading","content":["Ubbite gi"]},{"type":"verse","number":1,"content":["Lii kàdduy waarekat baa, di doomu Daawuda te di buurub Yerusalem."]},{"type":"heading","content":["Luy solos àddina?"]},{"type":"verse","number":2,"content":[{"text":"Cóolóoloo cóolóol, waru waarekat ba,","poem":1},{"lineBreak":true},{"text":"cóolóoloo cóolóol,","poem":1},{"lineBreak":true},{"text":"léppi cóolóoli neen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ana sax luy njariñu doñ-doñoo doñ-doñ","poem":1},{"lineBreak":true},{"text":"ju nit di doñ-doñi fi kaw dun bi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ag maas wéy, ag maas teew;","poem":1},{"lineBreak":true},{"text":"àddina sax ba fàww.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jant fenk, so,","poem":1},{"lineBreak":true},{"text":"ne coww dellu fa muy fenke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngelaw jëm bëj-saalum,","poem":1},{"lineBreak":true},{"text":"wiiri jëm bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"di wiir aka wiiraat,","poem":1},{"lineBreak":true},{"text":"di delluy wëndeelu, topp yoonam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dexoo dex wal, wuti géej,","poem":1},{"lineBreak":true},{"text":"te taxul géej fees.","poem":1},{"lineBreak":true},{"text":"Fa dex wal jëm,","poem":1},{"lineBreak":true},{"text":"fa lay walati, jëm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jëfoo jëf ca jëfit,","poem":1},{"lineBreak":true},{"text":"làmmiñ tuddul lépp,","poem":1},{"lineBreak":true},{"text":"bët du suur,","poem":1},{"lineBreak":true},{"text":"nopp du buur.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lu ayoon mooy ayati,","poem":1},{"lineBreak":true},{"text":"lu ñu jëfoon moom lañuy jëfati.","poem":1},{"lineBreak":true},{"text":"Dara yeesul fi kaw suuf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lëf a ngii, nit naa:","poem":1},{"lineBreak":true},{"text":"«Lii de lu bees la,»","poem":1},{"lineBreak":true},{"text":"te mu ngi fi woon lu yàgg,","poem":1},{"lineBreak":true},{"text":"lu jiitu sunu juddu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kenn du fàttaliku ñi jiitu,","poem":1},{"lineBreak":true},{"text":"ñiy ñëwit,","poem":1},{"lineBreak":true},{"text":"ñi leen topp duñu leen fàttaliku.","poem":1}]},{"type":"heading","content":["Rafet xel doyul"]},{"type":"verse","number":12,"content":[{"text":"Man waarekat bi,","poem":1},{"lineBreak":true},{"text":"buurub Israayil laa woon ci Yerusalem.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Damaa dogu ne damay gëstu,","poem":1},{"lineBreak":true},{"text":"teg ko ci xel mu rafet, di settantal","poem":1},{"lineBreak":true},{"text":"mboolem lu nit def fu jant bi tiim.","poem":1},{"lineBreak":true},{"text":"Ndaw sas wu tiis wu Yàlla sase,","poem":1},{"lineBreak":true},{"text":"ñu war koo sasoo!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gis naa jépp jëf ju jëfe ci kaw suuf,","poem":1},{"lineBreak":true},{"text":"ndeke lépp cóolóoli neen la ak nappum ngelaw.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lu wañaaru, maneesu koo jubbanti;","poem":1},{"lineBreak":true},{"text":"lu teewul, maneesu koo lim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Damaa wax ci saam xel naa:","poem":1},{"lineBreak":true},{"text":"«Man de, maa ngii di gëna xelu,","poem":1},{"lineBreak":true},{"text":"ba sut ku ma jiitu ci jalub Yerusalem.","poem":1},{"lineBreak":true},{"text":"Damaa xuus ci xel mu rafet ak xam-xam.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Noonu dogu naa xam luy xel mu rafet,","poem":1},{"lineBreak":true},{"text":"xam luy nitoodi akug ndof.","poem":1},{"lineBreak":true},{"text":"Fekk loolu it nappum ngelaw la.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ku géejal xel mu rafet, géejal naqar;","poem":1},{"lineBreak":true},{"text":"yokku xam-xam, yokku tiis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}