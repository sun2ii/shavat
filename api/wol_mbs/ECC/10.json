{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"As weñ tàbbi ci diw gu xeeñ, yàq ko;","poem":1},{"lineBreak":true},{"text":"ab dof it jëfam su tuut","poem":1},{"lineBreak":true},{"text":"neenal na xel mu rafet ak daraja.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xelu, jubal;","poem":1},{"lineBreak":true},{"text":"dofe, jàdd.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Te it ku dofe buy dox sax,","poem":1},{"lineBreak":true},{"text":"du ànd ak xelam;","poem":1},{"lineBreak":true},{"text":"ku ko gis, xam ne kii dof la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su la sa kilifa meree,","poem":1},{"lineBreak":true},{"text":"bul jóge fa ñu la teg;","poem":1},{"lineBreak":true},{"text":"tooñ yu mag, teey ba giif.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lu mettee ngii lu ma gis fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"lu mel ni njuumte lu rëcc kilifa:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ab dof bu ñu jox cér yu bare,","poem":1},{"lineBreak":true},{"text":"boroom daraja féete suuf;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ma gis baadoolo war fas,","poem":1},{"lineBreak":true},{"text":"kilifa di rung ni baadoolo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku gasum yeer, repp nga tàbbi ca;","poem":1},{"lineBreak":true},{"text":"ku bëtt ñag, repp jaan màtt la;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kuy yatt ay doj, repp nga caa gaañu;","poem":1},{"lineBreak":true},{"text":"kuy gor bant, repp nga caa loru.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Liggéeye weñ gu day te xacceesu ko,","poem":1},{"lineBreak":true},{"text":"góor-góorlu war na ca;","poem":1},{"lineBreak":true},{"text":"xelu, baaxle jariñoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jaan màtt, balees koo jat,","poem":1},{"lineBreak":true},{"text":"du njariñal jatkat ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ku xelu àddu, mu diw yiw;","poem":1},{"lineBreak":true},{"text":"ku dofe wax, sànku.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bu jëkkee wax ju amul bopp,","poem":1},{"lineBreak":true},{"text":"daaneele ndof gu sotti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ab dof a ngi wax a wax,","poem":1},{"lineBreak":true},{"text":"te kenn xamul luy xew ëllëg.","poem":1},{"lineBreak":true},{"text":"Ana ku koy xamal gannaawam?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ab dof ak kër-këreem, coonoy neen;","poem":1},{"lineBreak":true},{"text":"du xam sax yoonu taax ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngalla yeen, réew mi gone falu buur,","poem":1},{"lineBreak":true},{"text":"jawriñ ña di xëye xawaare.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ndokkalee, yeen, réew ma as gor falu,","poem":1},{"lineBreak":true},{"text":"te bu jotee, jawriñ ñay xéewlu,","poem":1},{"lineBreak":true},{"text":"ngir am doole te baña màndi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tayel, puj bu màbb;","poem":1},{"lineBreak":true},{"text":"yaafus, néeg buy senn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aw ñam bégal,","poem":1},{"lineBreak":true},{"text":"aw ñoll bànneexal,","poem":1},{"lineBreak":true},{"text":"xaalis tontu lu ne.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sam xel sax bu ca saaga buur,","poem":1},{"lineBreak":true},{"text":"sa néegu biir sax, bu fa saagaa boroom daraja.","poem":1},{"lineBreak":true},{"text":"Xamoo picc muy yóbbu sa kàddu,","poem":1},{"lineBreak":true},{"text":"mbaa njanaaw luy siiwali mbir ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}