{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":11,"content":[{"type":"heading","content":["Kenn xamul, waaye beyal sa tool"]},{"type":"verse","number":1,"content":[{"text":"Dugalal sa alal, dawloo ko;","poem":1},{"lineBreak":true},{"text":"yàgg-yàgg nga jotaat ci.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Séddal ab cér juróom ñaari nit ba juróom ñett;","poem":1},{"lineBreak":true},{"text":"xamoo safaan buy dikkal àddina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xàmbaar bu duyee, ba fees,","poem":1},{"lineBreak":true},{"text":"fi kaw suuf lay soob.","poem":1},{"lineBreak":true},{"text":"Garab, bu daanoo ndijoor mbaa càmmoñ,","poem":1},{"lineBreak":true},{"text":"fa mu daanu lay des.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuy déglu ngelaw, doo ji,","poem":1},{"lineBreak":true},{"text":"kuy seetluy niir, doo góob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xamoo yoonu ngelaw,","poem":1},{"lineBreak":true},{"text":"xamoo nu doom di sosoo ci ndeyam;","poem":1},{"lineBreak":true},{"text":"kon manoo xam lu Yàllay def,","poem":1},{"lineBreak":true},{"text":"moom miy def lépp.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xëyal, ji sa jiwu,","poem":1},{"lineBreak":true},{"text":"gont, baña tàyyi;","poem":1},{"lineBreak":true},{"text":"muy lii di lee, xamoo lu ciy nangu,","poem":1},{"lineBreak":true},{"text":"am ñaar ñépp ay bokk baax.","poem":1}]},{"type":"heading","content":["Bégal te xam ne man saxul"]},{"type":"verse","number":7,"content":[{"text":"Leer neex na,","poem":1},{"lineBreak":true},{"text":"gis jant neex na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ak lu say at baree bare,","poem":1},{"lineBreak":true},{"text":"bégeel at mu ci nekk,","poem":1},{"lineBreak":true},{"text":"waaye bàyyil xel lëndëmu bàmmeel,","poem":1},{"lineBreak":true},{"text":"lu yàgg lay doon,","poem":1},{"lineBreak":true},{"text":"te liy ñëw lépp, cóolóoli neen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xalelu góor bi, bànneexul bi ngay gone,","poem":1},{"lineBreak":true},{"text":"bégalal sa xol bi ngay ndaw.","poem":1},{"lineBreak":true},{"text":"Toppal loo namm ak loo xemmem,","poem":1},{"lineBreak":true},{"text":"waaye xamal ne loolu lépp,","poem":1},{"lineBreak":true},{"text":"Yàlla da la koy laaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Félal naqaru xol,","poem":1},{"lineBreak":true},{"text":"dàq woppi yaram;","poem":1},{"lineBreak":true},{"text":"waaye ndaw ak kawar gu ñuul, cóolóoli neen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}