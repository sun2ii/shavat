{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Bàyyil xel Ki la sàkk,","poem":1},{"lineBreak":true},{"text":"bi ngay dese ndaw,","poem":1},{"lineBreak":true},{"text":"bala bési safaan a taxaw,","poem":1},{"lineBreak":true},{"text":"ba jant ñëw, nga naa:","poem":1},{"lineBreak":true},{"text":"«Amatuma bànneex.»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fa la jant di lëndëme,","poem":1},{"lineBreak":true},{"text":"weer giim, biddiiw giim,","poem":1},{"lineBreak":true},{"text":"taw sewet, mu niru la lu xiinati.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Su bés baa wattukati kër gi di lox,","poem":1},{"lineBreak":true},{"text":"jàmbaari xare yi sëgg,","poem":1},{"lineBreak":true},{"text":"wolkat yi néew, ba wolatuñu,","poem":1},{"lineBreak":true},{"text":"ñiy séentu ci caax yi giimle,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"bunt yi féeteek mbedd mi tëje,","poem":1},{"lineBreak":true},{"text":"coowal wol dal,","poem":1},{"lineBreak":true},{"text":"as picc sab, nelaw naaw,","poem":1},{"lineBreak":true},{"text":"janq ju doon woy, selaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nga dem, ba ragal fu kawe,","poem":1},{"lineBreak":true},{"text":"am tiitaange ciw yoon,","poem":1},{"lineBreak":true},{"text":"garab tóor, ba weex furr,","poem":1},{"lineBreak":true},{"text":"soccet di yokokoki,","poem":1},{"lineBreak":true},{"text":"doomu garab tëë yékkati siddit,","poem":1},{"lineBreak":true},{"text":"nga jëm kër gu mujj,","poem":1},{"lineBreak":true},{"text":"waa dëj bi fees mbedd mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bàyyil xel Ki la sàkk,","poem":1},{"lineBreak":true},{"text":"balaa buumu xaalis bi ne tipp,","poem":1},{"lineBreak":true},{"text":"ndabal wurus wi, tasar,","poem":1},{"lineBreak":true},{"text":"njaq la ñuy roote, rajax,","poem":1},{"lineBreak":true},{"text":"poli ba ca teen ba, tàllit.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Su boobaa pënd dellu suuf, na woon;","poem":1},{"lineBreak":true},{"text":"bakkan dellu fa Yàlla ma able woon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cóolóoloo cóolóol, waru waarekat ba.","poem":1},{"lineBreak":true},{"text":"Léppi cóolóoli neen.","poem":1}]},{"type":"heading","content":["Ma daaneel"]},{"type":"verse","number":9,"content":[{"text":"Waarekat ba daa xelu,","poem":1},{"lineBreak":true},{"text":"di jàngalewaale xam-xam,","poem":1},{"lineBreak":true},{"text":"di natt aka gëstu,","poem":1},{"lineBreak":true},{"text":"di jekk-jekkal kàdduy xel yu takku.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waarekat ba daa tànn baat yu saf,","poem":1},{"lineBreak":true},{"text":"bind ko, mu jub te dëggu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waxi ku xelu day gindee, bantub sàmm la;","poem":1},{"lineBreak":true},{"text":"tënk ba diy pont, sampe ca.","poem":1},{"lineBreak":true},{"text":"Loolu ag may la, jóge ci sàmm biy kenn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Doom, leneen lu ci tegu, moytu ko:","poem":1},{"lineBreak":true},{"text":"yokki téere amul kemu,","poem":1},{"lineBreak":true},{"text":"njàng mu bare, coonoy boroom.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma daaneele fii, ndax déggees na lii lépp:","poem":1},{"lineBreak":true},{"text":"Yàlla, ragal ko;","poem":1},{"lineBreak":true},{"text":"ay santaaneem, jëfe ko;","poem":1},{"lineBreak":true},{"text":"loolu rekk mooy nit.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jépp jëf déy, la Yàlla di àtte,","poem":1},{"lineBreak":true},{"text":"ba ci lépp lu làqu,","poem":1},{"lineBreak":true},{"text":"muy lu baax, di lu bon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}