{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":3,"content":[{"type":"heading","content":["Jamono, Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Lu nekk ak jotam,","poem":1},{"lineBreak":true},{"text":"jot gu nekk ak la ca war fi jant bi tiim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Day jot nga juddu, mu jot nga dee;","poem":1},{"lineBreak":true},{"text":"mu jot nga jëmbat, mu jot nga buddi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mu jot nga rey, mu jot nga faj;","poem":1},{"lineBreak":true},{"text":"mu jot nga toj, mu jot nga tabax.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mu jot nga jooy, mu jot nga ree;","poem":1},{"lineBreak":true},{"text":"mu jot nga ñaawlu, mu jot nga dukkat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Day jot nga sànniy doj, mu jot nga dajale;","poem":1},{"lineBreak":true},{"text":"mu jot nga fóon, mu jot nga baña fóon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu jot nga sàkku, mu jot nga ñàkk;","poem":1},{"lineBreak":true},{"text":"mu jot nga sàmm, mu jot nga xalab.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mu jot nga xar, mu jot nga gaar;","poem":1},{"lineBreak":true},{"text":"mu jot nga selaw, mu jot nga wax.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu jot nga sopp, mu jot nga jéppi;","poem":1},{"lineBreak":true},{"text":"mu jot nga xare, mu jot nga jàmmoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ana lu liggéeykat biy jariñoo ciw ñaqam?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gis naa ne sas la bu Yàlla sase,","poem":1},{"lineBreak":true},{"text":"nu war koo sasoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lépp la Yàlla def,","poem":1},{"lineBreak":true},{"text":"ba bu jotee rafet.","poem":1},{"lineBreak":true},{"text":"Moo may nit muy njort ëllëg,","poem":1},{"lineBreak":true},{"text":"te taxul mu mana ràññee jëf ji Yàlla jëf,","poem":1},{"lineBreak":true},{"text":"njàlbéen ba muj ga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma gis ne nit amul lu gën","poem":1},{"lineBreak":true},{"text":"bànneex ak jàmmi bakkan cig dundam,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"te nitoo nit, su dee lekk aka naan,","poem":1},{"lineBreak":true},{"text":"di ñaq, jariñoo,","poem":1},{"lineBreak":true},{"text":"loolu mayu Yàllaa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma xam ne lu Yàlla def,","poem":1},{"lineBreak":true},{"text":"loola day sax ba fàww.","poem":1},{"lineBreak":true},{"text":"Deesu ci yokk, mbaa di wàññi dara;","poem":1},{"lineBreak":true},{"text":"Yàllaa ko def, ngir nit di ko wormaal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lu ay tey, ayoon na,","poem":1},{"lineBreak":true},{"text":"lu ay ëllëg it ayoon na.","poem":1},{"lineBreak":true},{"text":"Yàllaay namma indi la woon.","poem":1}]},{"type":"heading","content":["Yaakaar feyul boroom"]},{"type":"verse","number":16,"content":[{"text":"Ma dellu gis fi kaw suuf ne:","poem":1},{"lineBreak":true},{"text":"«Fu yoon moom, fa la njubadi ne,","poem":1},{"lineBreak":true},{"text":"fa njub moom it, fa la njubadi ne.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Saam xel ne ma:","poem":1},{"lineBreak":true},{"text":"«Ku jub ak ku bon la Yàlla di boole àtte,","poem":1},{"lineBreak":true},{"text":"ngir mbir mu ne ak jëf ju ne ak bésam.»","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Saam xel neeti ma:","poem":1},{"lineBreak":true},{"text":"«Nun doom aadama, Yàllaa nuy nattu,","poem":1},{"lineBreak":true},{"text":"nu gis ne ay mala doŋŋ lanu.»","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dogalu doom aadama ji","poem":1},{"lineBreak":true},{"text":"ak dogalu mala mi,","poem":1},{"lineBreak":true},{"text":"benn dogal bee;","poem":1},{"lineBreak":true},{"text":"ni kii di deewe la kee di deewe,","poem":1},{"lineBreak":true},{"text":"genn noo gee, nu bokk ko.","poem":1},{"lineBreak":true},{"text":"Lu nit ëpplee mala, neen na,","poem":1},{"lineBreak":true},{"text":"ñoom ñépp, cóolóoli neen.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ñoom ñépp a bokk jëm benn béreb ba,","poem":1},{"lineBreak":true},{"text":"bokk jóge pëndub suuf,","poem":1},{"lineBreak":true},{"text":"bokk dellu suuf.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ana ku mu wóor ne","poem":1},{"lineBreak":true},{"text":"bakkanu nit day yéeg asamaan,","poem":1},{"lineBreak":true},{"text":"bakkanu mala tàbbi suuf?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ma gis nag ne nit amul lu gën","poem":1},{"lineBreak":true},{"text":"di bànneexoo ñaqam, loolooy wàllam.","poem":1},{"lineBreak":true},{"text":"Ana ku koy xamal gannaawam?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}