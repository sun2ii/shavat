{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":4,"content":[{"type":"heading","content":["Alal doyul boroom"]},{"type":"verse","number":1,"content":[{"text":"Ma seetlooti gépp nootaange gu am fi kaw suuf.","poem":1},{"lineBreak":true},{"text":"Ndeke néew-doolee ngi jooy,","poem":1},{"lineBreak":true},{"text":"amul ku ko dëfal.","poem":1},{"lineBreak":true},{"text":"Ki koy noot a am doole,","poem":1},{"lineBreak":true},{"text":"te néew-doole ji amul ku ko dëfal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dama ne ndokkalee, yeen ñi dee jeeg,","poem":1},{"lineBreak":true},{"text":"nde raw ngeen ñiy dund!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ki leen taneeti yeen ñépp di ki juddoogul sax,","poem":1},{"lineBreak":true},{"text":"moom mi gisul jëf ju bon fi kaw suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma gis ne nit ak kër-këram jépp","poem":1},{"lineBreak":true},{"text":"ak bépp manoorey liggéey,","poem":1},{"lineBreak":true},{"text":"iñaanantee ko waral.","poem":1},{"lineBreak":true},{"text":"Loolu it, cóolóoli neen ak nappum ngelaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dof banki loxoom, sànk boppam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waaye benn ŋëb bu ànd ak dal","poem":1},{"lineBreak":true},{"text":"moo gën ñaari ŋëbi doñ-doñ ci nappum ngelaw.","poem":1}]},{"type":"heading","content":["Wéttalikoo gën wéet"]},{"type":"verse","number":7,"content":[{"text":"Ma seetlu leneen luy cóolóoli neen fi kaw suuf.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kenn a ngii, kenn ñaareelu ko,","poem":1},{"lineBreak":true},{"text":"du doom, du mbokk.","poem":1},{"lineBreak":true},{"text":"Doñ-doñam du dakk, te du doylu,","poem":1},{"lineBreak":true},{"text":"mujj mu naan: «Kan laay doñ-doñil,","poem":1},{"lineBreak":true},{"text":"di xañ sama bopp bànneex?»","poem":1},{"lineBreak":true},{"text":"Loolu it, cóolóoli neen, di sas wu tiis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ñaar a man kenn;","poem":1},{"lineBreak":true},{"text":"doñ-doñoondoo, yoolu bu baax.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kenn daanu,","poem":1},{"lineBreak":true},{"text":"moroom ma may ko loxo.","poem":1},{"lineBreak":true},{"text":"Waaye ngalla ku daanu","poem":1},{"lineBreak":true},{"text":"te amuloo ku la may loxo!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bu ñu tëddee di ñaar it,","poem":1},{"lineBreak":true},{"text":"mana bokk nugglu.","poem":1},{"lineBreak":true},{"text":"Waaye soo dee kenn, nooy nuggloo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fu ñu mane kenn,","poem":1},{"lineBreak":true},{"text":"ñaar taxaw fa, jéngu,","poem":1},{"lineBreak":true},{"text":"te buumu ñetti xànc gaawula dog.","poem":1}]},{"type":"heading","content":["Kilifteef saxul"]},{"type":"verse","number":13,"content":[{"text":"Kuy ndaw, génne kaso,","poem":1},{"lineBreak":true},{"text":"tàmbalee nguuru fa mu juddoo woon mbaadoolo,","poem":1},{"lineBreak":true},{"text":"ndaw loolu su dee baadoolo te xelu it,","poem":1},{"lineBreak":true},{"text":"moo gën buur bu màggat, dofe, dégguli artu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma gis mboolem luy dund","poem":1},{"lineBreak":true},{"text":"tey dox fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"di topp ndaw la wuutu buur.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mbooloo ngii mu janool,","poem":1},{"lineBreak":true},{"text":"bare lool ba wees ab lim,","poem":1},{"lineBreak":true},{"text":"te ña leen wuutu bégewuñu ki wuutu buur.","poem":1},{"lineBreak":true},{"text":"Loolu it di cóolóoli neen ak nappum ngelaw.","poem":1}]},{"type":"heading","content":["Ragalal Yàlla"]},{"type":"verse","number":17,"content":[{"text":"Moytul sa bopp booy dem kër Yàlla.","poem":1},{"lineBreak":true},{"text":"Duggal te déglu,","poem":1},{"lineBreak":true},{"text":"bala ngay def saraxi dof bu xamul ne mu ngi def lu bon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}