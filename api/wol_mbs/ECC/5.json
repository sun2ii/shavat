{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Bul rattax làmmiñ,","poem":1},{"lineBreak":true},{"text":"bul gaawa dikke Yàlla mbir.","poem":1},{"lineBreak":true},{"text":"Yàllaa ngi kaw asamaan,","poem":1},{"lineBreak":true},{"text":"yaw yaa ngi fi suuf.","poem":1},{"lineBreak":true},{"text":"Kon na say kàddu néew.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bu xalaat baree, indi gént;","poem":1},{"lineBreak":true},{"text":"bu wax baree, waxi dof jib.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Boo digook Yàlla,","poem":1},{"lineBreak":true},{"text":"bu ko yeexe.","poem":1},{"lineBreak":true},{"text":"Daray foontukat neexul,","poem":1},{"lineBreak":true},{"text":"defal li nga dige.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baña digee gën dige loo deful.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bu la sa làmmiñ yóbbe bàkkaar,","poem":1},{"lineBreak":true},{"text":"ba ngay layal ndawal Yàlla la, naan lii njuumte la woon.","poem":1},{"lineBreak":true},{"text":"Ana lu jar Yàlla di la meree sa kàddu,","poem":1},{"lineBreak":true},{"text":"bay neenal saw ñaq?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wax ju bare, caaxaani neen;","poem":1},{"lineBreak":true},{"text":"mook gént yu baree yem.","poem":1},{"lineBreak":true},{"text":"Kon, Yàlla, ragal ko.","poem":1}]},{"type":"heading","content":["Nguur bare na àq"]},{"type":"verse","number":7,"content":[{"text":"Boo gisee ñuy noot néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"di jalgati dëgg ak yoon cib gox,","poem":1},{"lineBreak":true},{"text":"bumu la jaaxal;","poem":1},{"lineBreak":true},{"text":"kilifa gi, kilifaam a ko yiir;","poem":1},{"lineBreak":true},{"text":"ñoom it seen kilifaa leen yiir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xanaa ndax buur suqal mbey mi,","poem":1},{"lineBreak":true},{"text":"ba ñépp jariñoo suuf si.","poem":1}]},{"type":"heading","content":["Alal coono la"]},{"type":"verse","number":9,"content":[{"text":"Bëggkatu xaalis du doyal xaalis,","poem":1},{"lineBreak":true},{"text":"bëggkatu alal du doyal tono,","poem":1},{"lineBreak":true},{"text":"te loolu it, cóolóoli neen.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bu koom yokkoo,","poem":1},{"lineBreak":true},{"text":"ña cay lekk yokku.","poem":1},{"lineBreak":true},{"text":"Ana lu muy jariñ boroom koom ga,","poem":1},{"lineBreak":true},{"text":"xanaa di ko duufale bëtam?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Surga, lekkam néew, bare,","poem":1},{"lineBreak":true},{"text":"mu nelaw, ba fàttey boram;","poem":1},{"lineBreak":true},{"text":"boroom alal regg,","poem":1},{"lineBreak":true},{"text":"du noppalu, du nelaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Naqar wu réy laa gis fi kaw suuf:","poem":1},{"lineBreak":true},{"text":"alal ju boroom dajale ba loru,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mbaa pexeem moy, mu sànkule;","poem":1},{"lineBreak":true},{"text":"ba bu amee doom it, du ko wacce dara.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nga juddoo ci sa ndey loxoy neen,","poem":1},{"lineBreak":true},{"text":"walbatiku dellu na nga dikke woon.","poem":1},{"lineBreak":true},{"text":"Du dara loo ñaqoon ba yóbbaale ko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dikke ni, delloo ni,","poem":1},{"lineBreak":true},{"text":"loolu it tiis wu réy la.","poem":1},{"lineBreak":true},{"text":"Doñ-doñi, ngelawal neen,","poem":1},{"lineBreak":true},{"text":"ana jariñ la?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ngay dunde tiis bésoo bés,","poem":1},{"lineBreak":true},{"text":"ak naqar ak wopp ak xol bu tàng!","poem":1}]},{"type":"heading","content":["Bànneexu bakkan, Yàlla"]},{"type":"verse","number":17,"content":[{"text":"Lii daal laa ci gis, man.","poem":1},{"lineBreak":true},{"text":"Li gën te jaadu ci nit: na lekk, naan","poem":1},{"lineBreak":true},{"text":"te bànneexoo ñaqam wu mu ñaqe kaw suuf","poem":1},{"lineBreak":true},{"text":"giiru dund gi ko Yàlla may.","poem":1},{"lineBreak":true},{"text":"Loolu mooy céram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Alal ak koom, ku ko Yàlla may,","poem":1},{"lineBreak":true},{"text":"may ko mu tal koo xéewloo,","poem":1},{"lineBreak":true},{"text":"mu nangu céram, bànneexoo ñaqam,","poem":1},{"lineBreak":true},{"text":"loolu mayu Yàllaa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yàllaa koy bànneexal,","poem":1},{"lineBreak":true},{"text":"ba du tiisoo ay fanam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":19}