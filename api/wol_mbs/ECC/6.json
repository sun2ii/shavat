{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":6,"content":[{"type":"heading","content":["Alal, na la jariñ"]},{"type":"verse","number":1,"content":[{"text":"Aw tiis a ngi wu ma gis fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"di tiis wu diis doom aadama:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"nit ku Yàlla may alal, koom ak daraja,","poem":1},{"lineBreak":true},{"text":"te mboolem lu mu namm, ñàkku ca lenn,","poem":1},{"lineBreak":true},{"text":"waaye Yàlla mayu ko mu tal caa lekk,","poem":1},{"lineBreak":true},{"text":"xanaa jàmbur di ko xéewloo—","poem":1},{"lineBreak":true},{"text":"loolu cóolóoli neen la, di naqar wu tar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ku giir téeméeri doom,","poem":1},{"lineBreak":true},{"text":"dund ati at,","poem":1},{"lineBreak":true},{"text":"ak lu at ya baree bare,","poem":1},{"lineBreak":true},{"text":"su bégewul teraanga ja mu am","poem":1},{"lineBreak":true},{"text":"te amul njëgu bàmmeelam sax,","poem":1},{"lineBreak":true},{"text":"kooku lumb wu tuuroo ko tane.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lumb wa ñëw na moos ci neen,","poem":1},{"lineBreak":true},{"text":"bàddoo lëndëm, turam sàngoo lëndëm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gisul jant, xamu ko,","poem":1},{"lineBreak":true},{"text":"waaye noflaay moo ko ëpple mag ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"bu dundoon junniy junniy at sax","poem":1},{"lineBreak":true},{"text":"te amul jàmm.","poem":1},{"lineBreak":true},{"text":"Xanaa du benn béreb la ñépp jëm?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nit ak doñ-doñam jépp, biiram,","poem":1},{"lineBreak":true},{"text":"te taxul mu doylu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ana lu boroom xel ëpplee ku dofe?","poem":1},{"lineBreak":true},{"text":"Nga ñàkk, xam doxalin,","poem":1},{"lineBreak":true},{"text":"lu mu lay jariñ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Doyloo li nga gis a gën di wéye xemmem.","poem":1},{"lineBreak":true},{"text":"Loolu it, cóolóoli neen ak nappum ngelaw.","poem":1}]},{"type":"heading","content":["Nit dogalul"]},{"type":"verse","number":10,"content":[{"text":"Lu masa ay, dees koo tuddoon;","poem":1},{"lineBreak":true},{"text":"lu doom aadama doon, xamees na ko,","poem":1},{"lineBreak":true},{"text":"te kenn du layook ku la sut.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Loo ci wax wax,","poem":1},{"lineBreak":true},{"text":"solo sa gëna néew.","poem":1},{"lineBreak":true},{"text":"Kon ana loo ci jële?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana ku xam lu gën ci nit ak fanam ni cóolóol,","poem":1},{"lineBreak":true},{"text":"toogadi ni takkndeer?","poem":1},{"lineBreak":true},{"text":"Ku koy wax luy am gannaawam fi kaw suuf?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}