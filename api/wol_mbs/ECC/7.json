{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":7,"content":[{"type":"heading","content":["Nit am na pexe ciw tiisam"]},{"type":"verse","number":1,"content":[{"text":"Jëw bu rafet a gën diw gu xeeñ,","poem":1},{"lineBreak":true},{"text":"bésub dee a gën bésub juddu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dem dëj a gën wàlli bernde,","poem":1},{"lineBreak":true},{"text":"mooy muju képp.","poem":1},{"lineBreak":true},{"text":"Kuy dund, sóoraale ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naqar a gën xaxaloo;","poem":1},{"lineBreak":true},{"text":"aw tiis ñagasal kanam, rafetal xol.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ku xelu, xalaat kërug dëj;","poem":1},{"lineBreak":true},{"text":"ku dofe, xalaat kërug puukare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Déglu ku xelu di la artu","poem":1},{"lineBreak":true},{"text":"moo gën déglu dof bu lay woy.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ab dof day tex-texi","poem":1},{"lineBreak":true},{"text":"ni dég yuy retete taal bu cin tege.","poem":1},{"lineBreak":true},{"text":"Loolu it di cóolóoli neen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Foqarñi kay day dofloo boroom xel,","poem":1},{"lineBreak":true},{"text":"te ab ger da lay gëlëmal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fa mbir mujjee gën fa mu doore,","poem":1},{"lineBreak":true},{"text":"te muñ a gën réy-réylu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bul gaawa mer;","poem":1},{"lineBreak":true},{"text":"mer, xolub dof la samp këram.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bul ne lu tax démb dàq tey,","poem":1},{"lineBreak":true},{"text":"loolu, laaj ko du xel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xel mu rafet daa neex ni ndono,","poem":1},{"lineBreak":true},{"text":"njariñ la ci kuy dund.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xel mu rafet kiiraay la,","poem":1},{"lineBreak":true},{"text":"xaalis kiiraay la;","poem":1},{"lineBreak":true},{"text":"njariñu xam-xam mooy","poem":1},{"lineBreak":true},{"text":"xelu, mucc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xoolal ci li Yàlla def:","poem":1},{"lineBreak":true},{"text":"ana ku mana jubbanti lu mu dëngal?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Su neexee, bànneexul;","poem":1},{"lineBreak":true},{"text":"su mettee, xoolal ne lu ci ne, Yàllaa ko def","poem":1},{"lineBreak":true},{"text":"ngir jaam bi umple gannaawam.","poem":1}]},{"type":"heading","content":["Lu ëpp tuuru"]},{"type":"verse","number":15,"content":[{"text":"Lu ne laa gis","poem":1},{"lineBreak":true},{"text":"ci sama dund gu lënt!","poem":1},{"lineBreak":true},{"text":"Nit a ngii jub, teewu koo sànkook njubam;","poem":1},{"lineBreak":true},{"text":"nit bon, ànd ak mbonam, gudd fan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bul jub ba mu ëpp,","poem":1},{"lineBreak":true},{"text":"bul wóolu sam xel ba mu ëpp,","poem":1},{"lineBreak":true},{"text":"lu ko moy nga yàqule.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bu la mbon jiital,","poem":1},{"lineBreak":true},{"text":"te bul dofe.","poem":1},{"lineBreak":true},{"text":"Jàppool lii,","poem":1},{"lineBreak":true},{"text":"te baña wacc lee, mooy li gën,","poem":1},{"lineBreak":true},{"text":"lu ko moy nga dee te sa àpp jotul.","poem":1},{"lineBreak":true},{"text":"Ku ragal Yàlla kat","poem":1},{"lineBreak":true},{"text":"sàmm yooyu ñaar.","poem":1}]},{"type":"heading","content":["Xel mu rafet réer na ma"]},{"type":"verse","number":19,"content":[{"text":"Xel mu rafet day dooleel boroom,","poem":1},{"lineBreak":true},{"text":"ba mu man fukki kàngam cib dëkk.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amul moos ku jub ci kaw suuf,","poem":1},{"lineBreak":true},{"text":"kuy def lu baax te du bàkkaar.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Te it du lépp lu ñu wax,","poem":1},{"lineBreak":true},{"text":"ngay bàyyi xel.","poem":1},{"lineBreak":true},{"text":"Kon doo dégg surga bu la ŋàññ,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ndax xam nga xéll ne yaw it","poem":1},{"lineBreak":true},{"text":"ŋàññe nga ay yooni yoon.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Loolu lépp maa ko natte xel mu rafet,","poem":1},{"lineBreak":true},{"text":"te naan: «Naa xelu,»","poem":1},{"lineBreak":true},{"text":"ndeke mbir ma sore na ma.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Li wara am daa sore, te xóota xóot;","poem":1},{"lineBreak":true},{"text":"ana ku ko mana daj?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ma walbatiku, di jéema xam,","poem":1},{"lineBreak":true},{"text":"di wut, di càmbar, di sàkkum piri,","poem":1},{"lineBreak":true},{"text":"ngir xam li bon cig ndof,","poem":1},{"lineBreak":true},{"text":"ak li dofe cig ndof.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ma seetlu lenn lu gëna naqari dee:","poem":1},{"lineBreak":true},{"text":"muy ndaw su la fiir.","poem":1},{"lineBreak":true},{"text":"Kooku cofeelam mbaal la,","poem":1},{"lineBreak":true},{"text":"loxo ya dib jéng.","poem":1},{"lineBreak":true},{"text":"Ku Yàlla gërëm a koy rëcc,","poem":1},{"lineBreak":true},{"text":"bàkkaarkat bi lay jàpp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Waarekat ba nee: «Xoolal li ma gis,","poem":1},{"lineBreak":true},{"text":"benn-bennal ko, ngir gis lu muy firi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ma seet a seet, gisuma.","poem":1},{"lineBreak":true},{"text":"Genn góor laa ràññee ci junniy góor,","poem":1},{"lineBreak":true},{"text":"ràññeewuma kenn ci jigéen ñi ñépp.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lenn daal laa ràññee:","poem":1},{"lineBreak":true},{"text":"Yàlla daa sàkk nit, jubal ko,","poem":1},{"lineBreak":true},{"text":"nit di wuta fëlle fu ne.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":28}