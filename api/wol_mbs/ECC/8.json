{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ECC","translationId":"wol_mbs","name":"Kàdduy waare","commonName":"Kàdduy waare","title":"Kàdduy waare muy téere bu ëmb ay gëstu ci solos dundu nit","order":21,"numberOfChapters":12,"sha256":"22ec84350e5580f6561518dc4987d8b8882f8f2398333e154524362859784de0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/wol_mbs/ECC/12.json","totalNumberOfVerses":220},"chapter":{"number":8,"content":[{"type":"heading","content":["Ana ku rafet xel?"]},{"type":"verse","number":1,"content":[{"text":"Ana ku rafet xel nu muy mel?","poem":1},{"lineBreak":true},{"text":"Ana ku xam piri?","poem":1},{"lineBreak":true},{"text":"Am xel rafet, kanam leer, gëna lewet.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dama ne déggalal Buur,","poem":1},{"lineBreak":true},{"text":"yaa ko giñoon ci Yàlla.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bul gaawa won Buur gannaaw;","poem":1},{"lineBreak":true},{"text":"bul saxoo lu Buur bëggul;","poem":1},{"lineBreak":true},{"text":"Buur, lu ko neex lay def.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kàddug Buur kilifteef la.","poem":1},{"lineBreak":true},{"text":"Ana ku ko naan: «Looy def nii?»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ku dégg ndigal","poem":1},{"lineBreak":true},{"text":"doo am lu la soof.","poem":1},{"lineBreak":true},{"text":"Ku xelu, xam lu jot,","poem":1},{"lineBreak":true},{"text":"xam doxalin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mbir mu mu doon kat ak jotam ak doxalinam,","poem":1},{"lineBreak":true},{"text":"waaye nit am na tiis wu ko diis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kenn xamul luy xew ëllëg,","poem":1},{"lineBreak":true},{"text":"kenn manula wax luy xew ëllëg.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kenn moomul bakkanam, ba man koo dese,","poem":1},{"lineBreak":true},{"text":"kenn amul sañ-sañ ci bésub deewam,","poem":1},{"lineBreak":true},{"text":"kenn muccul ci boobu xare,","poem":1},{"lineBreak":true},{"text":"te mbon du ca wallu boroom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Loolu lépp gis naa ko,","poem":1},{"lineBreak":true},{"text":"ba may xalaat ci jépp jëfi kaw suuf;","poem":1},{"lineBreak":true},{"text":"fi nit di yilife nit, muy loraange.","poem":1}]},{"type":"heading","content":["Bul roy lu bon"]},{"type":"verse","number":10,"content":[{"text":"Ma gis itam ñu bon ñu ñu rob,","poem":1},{"lineBreak":true},{"text":"ñu daan yaale kër Yàlla ga,","poem":1},{"lineBreak":true},{"text":"ñu di leen gërëme tey seeni jëf ca dëkk ba.","poem":1},{"lineBreak":true},{"text":"Loolu it, cóolóoli neen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jëf ñaaw na, mbugal ma yeex,","poem":1},{"lineBreak":true},{"text":"ba tax doom aadama sóobu ci mbon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nit bàkkaar na téeméeri yoon,","poem":1},{"lineBreak":true},{"text":"te teewul mu gudd fan.","poem":1},{"lineBreak":true},{"text":"Xam naa it ne nee ñu","poem":1},{"lineBreak":true},{"text":"ngëneel a ñeel ku ragal Yàlla,","poem":1},{"lineBreak":true},{"text":"ndax wormaal ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ku bon, du am lu baax,","poem":1},{"lineBreak":true},{"text":"fanam du màgg ni ker,","poem":1},{"lineBreak":true},{"text":"ndax wormaalul Yàlla.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Waaye cóolóoli neen a ngi am fi kaw suuf:","poem":1},{"lineBreak":true},{"text":"ku jub jot yoolu ku bon,","poem":1},{"lineBreak":true},{"text":"ku bon jot yoolu ku jub.","poem":1},{"lineBreak":true},{"text":"Ma ne loolu it cóolóoli neen la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Man daal damay digle bànneex,","poem":1},{"lineBreak":true},{"text":"ndax nit amul lu gën fi kaw suuf","poem":1},{"lineBreak":true},{"text":"di lekk aka naan aka bànneexu,","poem":1},{"lineBreak":true},{"text":"muñe ko doñ-doñam,","poem":1},{"lineBreak":true},{"text":"fan yi ko Yàlla may fi kaw suuf.","poem":1}]},{"type":"heading","content":["Yàlla, kenn xamu ko"]},{"type":"verse","number":16,"content":[{"text":"Ma walbatiku xalaat, di jéema xam fu xel rafete,","poem":1},{"lineBreak":true},{"text":"di xoolaat li nit jàppoo fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"ba guddeek bëccëg, gëmmul bët.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma daldi gis li Yàlla def lépp.","poem":1},{"lineBreak":true},{"text":"Nit kay xel ma du daj liy xew fi kaw suuf.","poem":1},{"lineBreak":true},{"text":"Day seet ba sonn, du ko daj.","poem":1},{"lineBreak":true},{"text":"Boroom xel bu wax ne xam na ko it,","poem":1},{"lineBreak":true},{"text":"du ko daj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ECC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/7.json","previousChapterAudioLinks":{},"numberOfVerses":17}