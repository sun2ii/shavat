{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"EZK","translationId":"wol_mbs","name":"Esekiyel","commonName":"Esekiyel","title":"Téereb Yonent Yàlla Esekiyel","order":26,"numberOfChapters":48,"sha256":"9347f533daeb839ee0c99da4c620d2d7cf56b638b000131c4b94b439d20eb808","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/wol_mbs/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":15,"content":[{"type":"heading","content":["Bantu reseñ matul matt"]},{"type":"verse","number":1,"content":["Gannaaw loolu kàddug Aji Sax ji dikkal na ma ne ma:"]},{"type":"verse","number":2,"content":[{"text":"«Yaw nit ki, ana lu bantu reseñ gëne ci bant yi,","poem":1},{"lineBreak":true},{"text":"ak mboolem caru garab bu mu doon ci gott bi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndax dees na ca sàkk bant, liggéeye ko?","poem":1},{"lineBreak":true},{"text":"Am dees na ca sàkke wékkukaay, wékk ca lenn?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xanaa sànni cib taal, xambe,","poem":1},{"lineBreak":true},{"text":"ñaari cat ya lakk, digg ba xoyomu.","poem":1},{"lineBreak":true},{"text":"Ana lu deeti njariñam?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndegam ba mu nee ñumm,","poem":1},{"lineBreak":true},{"text":"lees ci dul liggéey dara,","poem":1},{"lineBreak":true},{"text":"gën ba mu jàppee ba xoyomu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kon nag Boroom bi Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"Dees na xamb caru reseñ,","poem":1},{"lineBreak":true},{"text":"mu bokk ci banti garab yi ma joxe, ñu xamb lépp,","poem":1},{"lineBreak":true},{"text":"te noonu laay xambe waa Yerusalem.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maay jànkoonteek ñoom,","poem":1},{"lineBreak":true},{"text":"ñu rëcc sawara,","poem":1},{"lineBreak":true},{"text":"sawara lakk leen.","poem":1},{"lineBreak":true},{"text":"Bu ma jànkoonteek ñoom,","poem":1},{"lineBreak":true},{"text":"dingeen xam ne maay Aji Sax ji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maay gental réew mi,","poem":1},{"lineBreak":true},{"text":"ñoo def jëfi ñàkk worma.","poem":1},{"lineBreak":true},{"text":"Kàddug Boroom bi Aji Sax jee.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}