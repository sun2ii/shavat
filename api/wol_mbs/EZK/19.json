{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"EZK","translationId":"wol_mbs","name":"Esekiyel","commonName":"Esekiyel","title":"Téereb Yonent Yàlla Esekiyel","order":26,"numberOfChapters":48,"sha256":"9347f533daeb839ee0c99da4c620d2d7cf56b638b000131c4b94b439d20eb808","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/wol_mbs/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":19,"content":[{"type":"heading","content":["Jooy garmiy Israayil war na"]},{"type":"verse","number":1,"content":["Aji Sax ji ne ma: «Yaw nag jooyal garmiy Israayil."]},{"type":"verse","number":2,"content":["Neel:",{"text":"“Céy sa ndey, ndaw gaynde, fi biir gaynde yi!","poem":1},{"lineBreak":true},{"text":"Moo goor fi biir gaynde yu ndaw yi,","poem":1},{"lineBreak":true},{"text":"di fa yar ay doomam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moo tàggat kenn ciy goneem","poem":1},{"noteId":16},{"text":",","poem":1},{"lineBreak":true},{"text":"ba muy waxambaane gaynde,","poem":1},{"lineBreak":true},{"text":"mana pàdd pàddam,","poem":1},{"lineBreak":true},{"text":"di yàpp doom aadama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ba ko xeet ya déggee, dañu koo fexeel,","poem":1},{"lineBreak":true},{"text":"mu sërëx ca seenum yeer,","poem":1},{"lineBreak":true},{"text":"ñu lonk, yóbbu réewum Misra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«“Ndey gaynde xaar a xaar,","poem":1},{"lineBreak":true},{"text":"ba gis ne yaakaar jee na,","poem":1},{"lineBreak":true},{"text":"mu jël keneen ciy goneem","poem":1},{"noteId":17},{"text":",","poem":1},{"lineBreak":true},{"text":"def ko waxambaane gaynde.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu ànd ak moroomi gayndeem,","poem":1},{"lineBreak":true},{"text":"màgg, mat,","poem":1},{"lineBreak":true},{"text":"ba mana pàdd am pàddam,","poem":1},{"lineBreak":true},{"text":"di yàpp doom aadama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mu tëdde seeni jëtun,","poem":1},{"lineBreak":true},{"text":"gental seen dëkk yu mag,","poem":1},{"lineBreak":true},{"text":"réew maak la ca biiram tiit ca coowal ŋaram.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Teewul xeeti diiwaan ya ko séq ànd,","poem":1},{"lineBreak":true},{"text":"dal fa kawam,","poem":1},{"lineBreak":true},{"text":"laaw ko seenum caax,","poem":1},{"lineBreak":true},{"text":"sërxal ca seenum yeer.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ñu lonk, dugal cib kaaf,","poem":1},{"lineBreak":true},{"text":"yóbbul ko buuru Babilon,","poem":1},{"lineBreak":true},{"text":"tëj ko ca biir ab tata,","poem":1},{"lineBreak":true},{"text":"ba kenn déggatuli ŋaram fa kaw tundi Israayil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«“Sa ndey a la niru, mel ni reseñ","poem":1},{"lineBreak":true},{"text":"gu ñu jëmbat fi wetu ndox,","poem":1},{"lineBreak":true},{"text":"meññ, sëq lipp, ndax ndox mu ne xéew.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mu am car yu dëgër yu man yeti nguur,","poem":1},{"lineBreak":true},{"text":"daldi màgg ba àkki niir ya,","poem":1},{"lineBreak":true},{"text":"ràññiku ci taxawaay ak sëqaay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waaye am sànj a ko buddi, sànni fi suuf,","poem":1},{"lineBreak":true},{"text":"ngelawal penku wowal doom ya,","poem":1},{"lineBreak":true},{"text":"bànqaasam yu dëgër ya fàq, lax,","poem":1},{"lineBreak":true},{"text":"sawara xoyom ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tey mu ngi jëmbate fi màndiŋ mi,","poem":1},{"lineBreak":true},{"text":"ci réew mu wow, maral.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sawaraa tàkke fa bànqaasam,","poem":1},{"lineBreak":true},{"text":"xoyom njebbit ak meññeef.","poem":1},{"lineBreak":true},{"text":"Du car bu dëgër bu ca des","poem":1},{"lineBreak":true},{"text":"bu mana doon yetu nguur.”","poem":1},{"lineBreak":true},{"text":"Woyu dëj a ngii wu ñuy jooyeb dëj.»","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"19.3 Wax ji ci Buur Yowaxas la jëm. Seetal ci 2.Buur ya 23.31-34.","reference":{"chapter":19,"verse":3}},{"noteId":17,"caller":"+","text":"19.5 Wax ji ci Buur Cedesyas la jëm. Seetal ci 2.Buur ya 24.18-20; 25.1-7.","reference":{"chapter":19,"verse":5}}]},"thisChapterLink":"/api/wol_mbs/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}