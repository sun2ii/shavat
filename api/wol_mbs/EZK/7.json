{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"EZK","translationId":"wol_mbs","name":"Esekiyel","commonName":"Esekiyel","title":"Téereb Yonent Yàlla Esekiyel","order":26,"numberOfChapters":48,"sha256":"9347f533daeb839ee0c99da4c620d2d7cf56b638b000131c4b94b439d20eb808","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/wol_mbs/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":7,"content":[{"type":"heading","content":["Jeexle dikk na"]},{"type":"verse","number":1,"content":["Gannaaw loolu kàddug Aji Sax ji da maa dikkal, ne ma:"]},{"type":"verse","number":2,"content":["«Léegi nag, yaw nit ki, Boroom bi Aji Sax ji dafa wax réewum Israayil ne ko:",{"text":"Jeex na tàkk!","poem":1},{"lineBreak":true},{"text":"Jeexal dikkal na ñeenti weti réew mi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jeexal nga nag léegi!","poem":1},{"lineBreak":true},{"text":"Maay yebal sama mer fi sa kaw.","poem":1},{"lineBreak":true},{"text":"Maa lay mbugale say jëfin,","poem":1},{"lineBreak":true},{"text":"yool la sa jépp jëf ju siblu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Duma la xool bëtu ñéeblu,","poem":1},{"lineBreak":true},{"text":"duma ñeewante kenn.","poem":1},{"lineBreak":true},{"text":"Say jëfin laa lay yool,","poem":1},{"lineBreak":true},{"text":"sa jëf ju siblu ji ci sa biir.","poem":1},{"lineBreak":true},{"text":"Su boobaa ngeen xam ne man maay Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Boroom bi Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"Céy wii ay, guléet wii ay!","poem":1},{"lineBreak":true},{"text":"Mu ngii di dikk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jeexlee ngoog, jeexle dikk na,","poem":1},{"lineBreak":true},{"text":"jekki, yewwul la.","poem":1},{"lineBreak":true},{"text":"Mu ngii, di dikk!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaw nitu réew mee, sànkute dikkal na la.","poem":1},{"lineBreak":true},{"text":"Àpp mat,","poem":1},{"lineBreak":true},{"text":"bés dëgmal,","poem":1},{"lineBreak":true},{"text":"tiitaange wuutu ca mbéx fa kaw tund ya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Du yàgg dara ma xëpp la sama xadar,","poem":1},{"lineBreak":true},{"text":"ŋaccal la sama mer,","poem":1},{"lineBreak":true},{"text":"mbugale la say jëfin,","poem":1},{"lineBreak":true},{"text":"yool la sa jépp jëf ju siblu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Duma xoole bëtu ñéeblu,","poem":1},{"lineBreak":true},{"text":"duma ñeewante.","poem":1},{"lineBreak":true},{"text":"Say jëfin laa lay yool","poem":1},{"lineBreak":true},{"text":"ak sa jëf ju siblu ji ci sa biir.","poem":1},{"lineBreak":true},{"text":"Su boobaa ngeen xam ne maay Aji Sax jiy dumaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Bés baa ngii, mu ngooguy dikk,","poem":1},{"lineBreak":true},{"text":"sànkute sàqi na,","poem":1},{"lineBreak":true},{"text":"yetu njubadee tóor,","poem":1},{"lineBreak":true},{"text":"reewande jebbi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fitnaa taxaw, di yet wuy dóoral coxor.","poem":1},{"lineBreak":true},{"text":"Seen lenn du des,","poem":1},{"lineBreak":true},{"text":"du seen mbooloo,","poem":1},{"lineBreak":true},{"text":"du seen alal,","poem":1},{"lineBreak":true},{"text":"du seen daraja.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Àpp mat,","poem":1},{"lineBreak":true},{"text":"bés jege.","poem":1},{"lineBreak":true},{"text":"Bu ca jëndkat tala bég,","poem":1},{"lineBreak":true},{"text":"bu ca jaaykat tala naqarlu!","poem":1},{"lineBreak":true},{"text":"Am sànj a dikkal askan wépp.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bu jaaykat bi muccee it,","poem":1},{"lineBreak":true},{"text":"du jotaat ca njaayam.","poem":1},{"lineBreak":true},{"text":"Peeñu mi jëm ci askan wépp, daal, du toxu,","poem":1},{"lineBreak":true},{"text":"ku nekk ñaawtéefam lay dunde,","poem":1},{"lineBreak":true},{"text":"ba du leqaliku.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Liitu xareey jib, ba lépp jekk ngir xare,","poem":1},{"lineBreak":true},{"text":"te kenn du xareji,","poem":1},{"lineBreak":true},{"text":"sama sànj a dikkal askan wépp.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Saamar biti,","poem":1},{"lineBreak":true},{"text":"mbas akub xiif ci biir,","poem":1},{"lineBreak":true},{"text":"ki ci àll bi deewe xare,","poem":1},{"lineBreak":true},{"text":"ki ci biir dëkk bi, xiif ak mbas rey ko.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ña rëcc, rawi ca tund ya,","poem":1},{"lineBreak":true},{"text":"waru pitaxi xur ya,","poem":1},{"lineBreak":true},{"text":"ñooy binneendoo ndax seeni tooñ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Loxo yépp yoqi,","poem":1},{"lineBreak":true},{"text":"tànk tooy xepp.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ñooy sol ay saaku di ko ñaawloo,","poem":1},{"lineBreak":true},{"text":"seen yaram wépp daw,","poem":1},{"lineBreak":true},{"text":"gépp kanam sëlmoo gàcce,","poem":1},{"lineBreak":true},{"text":"bopp ya di nel yu set wecc.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Seen xaalis, ñu sànni ci mbedd yi,","poem":1},{"lineBreak":true},{"text":"seen wurus di leen saf sagaru sobe.","poem":1},{"lineBreak":true},{"text":"Keroog bésub sànjum Aji Sax ja,","poem":1},{"lineBreak":true},{"text":"du xaalis, du wurus wu leen di xettali.","poem":1},{"lineBreak":true},{"text":"Du leen fajal xiif,","poem":1},{"lineBreak":true},{"text":"du leen reggal,","poem":1},{"lineBreak":true},{"text":"xanaa tàbbal leen cig njubadi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ñoo doon sagoo seen gànjar gu yànj,","poem":1},{"lineBreak":true},{"text":"di ci sàkk jëmmi tuur yu jara bañ te jomblu,","poem":1},{"lineBreak":true},{"text":"ba tax ma defal leen ko sagaru sobe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Maa koy teg ci loxoy doxandéem, ñu foqati ko,","poem":1},{"lineBreak":true},{"text":"muy alal ju sagari niti àddina sëxëtoo,","poem":1},{"lineBreak":true},{"text":"ñàkk ko wormaal.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Maa leen di dummóoyu,","poem":1},{"lineBreak":true},{"text":"maay bàyyi nit ñi teddadil sama ngëneelu béreb,","poem":1},{"lineBreak":true},{"text":"ay sàcc a cay tàbbi, teddadil ko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Waajalleen càllala yi,","poem":1},{"lineBreak":true},{"text":"tuur nañu deret ba réew mi fees,","poem":1},{"lineBreak":true},{"text":"dëkk bi fees ak fitna.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Maay indi xeet yi gëna néeg,","poem":1},{"lineBreak":true},{"text":"ñu nangu seeni kër,","poem":1},{"lineBreak":true},{"text":"ma daldi sàggi sagu boroom doole yi,","poem":1},{"lineBreak":true},{"text":"sobeel seen béreb yu sell.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tiitaangee ngi dikk,","poem":1},{"lineBreak":true},{"text":"ñuy sàkku jàmm, jàmm réer.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ay ci kaw ay a ngi dikk,","poem":1},{"lineBreak":true},{"text":"xibaar ci kaw xibaar,","poem":1},{"lineBreak":true},{"text":"ñuy sàkku peeñum yonent ci neen,","poem":1},{"lineBreak":true},{"text":"ndigalu yoon réer sarxalkat,","poem":1},{"lineBreak":true},{"text":"pexe réer mag.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Buur dina tiislu,","poem":1},{"lineBreak":true},{"text":"garmi làmboo séri ñaawlu,","poem":1},{"lineBreak":true},{"text":"baadoolay réew mi di kat-kati.","poem":1},{"lineBreak":true},{"text":"Seeni jëfin laay jëfeek ñoom,","poem":1},{"lineBreak":true},{"text":"seeni àtte laa leen di àttee,","poem":1},{"lineBreak":true},{"text":"ñu xam ne maay Aji Sax ji!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}