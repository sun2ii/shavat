{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HAB","translationId":"wol_mbs","name":"Abakug","commonName":"Abakug","title":"Téereb Yonent Yàlla Abakug","order":35,"numberOfChapters":3,"sha256":"f38da77075187d52f1899a70b11b4751ea48a3b09e1e5d203f6d1ba55659078b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/wol_mbs/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"heading","content":["Ubbite gi"]},{"type":"verse","number":1,"content":["Ab yéenee ngii bu ñu won Yonent Yàlla Abakug."]},{"type":"heading","content":["Abakug tàmbali naa jooy"]},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, foo àppal lii?","poem":1},{"lineBreak":true},{"text":"May woote wall, dégluwoo ma!","poem":1},{"lineBreak":true},{"text":"Ma di la jooy aw ay, te walloowoo!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ana loo may wone lu bon,","poem":1},{"lineBreak":true},{"text":"tey seetaan nooteel?","poem":1},{"lineBreak":true},{"text":"Yàquteeku ay fi sama kanam,","poem":1},{"lineBreak":true},{"text":"xuloo di wéy, ŋaayoo jolli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moo tax yoon lafañ,","poem":1},{"lineBreak":true},{"text":"te àtteb dëgg du feeñ mukk.","poem":1},{"lineBreak":true},{"text":"Ku bon a tanc ku jub,","poem":1},{"lineBreak":true},{"text":"ba tax ab àtte jalgatiku.","poem":1}]},{"type":"heading","content":["Aji Sax ji tontu na"]},{"type":"verse","number":5,"content":[{"text":"«Xoolleen ci biir xeet yi ba gis,» la Aji Sax ji wax.","poem":1},{"lineBreak":true},{"text":"«Jommileen jommeet, nde jëf a ngi jëfe ci seeni jant,","poem":1},{"lineBreak":true},{"text":"su ñu leen ko waxoon sax, dungeen ko gëm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa ngii di dooleel waa Babilon,","poem":1},{"lineBreak":true},{"text":"xeet wu wex, ràkkaaju,","poem":1},{"lineBreak":true},{"text":"di wër déndi àddina,","poem":1},{"lineBreak":true},{"text":"di nangu màkkaani jàmbur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñu ñàng, raglu,","poem":1},{"lineBreak":true},{"text":"te di dogalal seen bopp àtteb yoon ak sañ-sañ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Seeni fas a gëna gaawi segg,","poem":1},{"lineBreak":true},{"text":"gëna aay tilli timis.","poem":1},{"lineBreak":true},{"text":"Fu sore la seeni gawar jóge, tëbal,","poem":1},{"lineBreak":true},{"text":"naaw nig jaxaay","poem":1},{"lineBreak":true},{"text":"ju ne jàyy, lekkum rëbbam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aw ay lañuy dikke, ñoom ñépp,","poem":1},{"lineBreak":true},{"text":"buurandoo, jubal màkk seen kanam,","poem":1},{"lineBreak":true},{"text":"te ñi ñuy jàpp njaam bare ni feppi suuf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñooñu ay buur lañuy ñaawal,","poem":1},{"lineBreak":true},{"text":"boroomi daraja di seen reetaanukaay;","poem":1},{"lineBreak":true},{"text":"ñii lépp luy tata lañuy kekku,","poem":1},{"lineBreak":true},{"text":"jalal ko suuf, nangu ko.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jàll, wéy lañu cay teg ni ngelaw,","poem":1},{"lineBreak":true},{"text":"tegoog tooñ, te seen doole di seen yàlla.»","poem":1}]},{"type":"heading","content":["Abakug jooyati na"]},{"type":"verse","number":12,"content":[{"text":"Waaye Aji Sax ji, xanaa du yaa masa nekk?","poem":1},{"lineBreak":true},{"text":"Sama Yàlla sama Aji Sell ji, doo saay.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, ab àtte nga tabbe ñii,","poem":1},{"lineBreak":true},{"text":"yaw sama cëslaay, mbugal nga fi dëje ñii.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sa gët yu sell jomb naa niir lu bon,","poem":1},{"lineBreak":true},{"text":"te manoo seetaan nooteel!","poem":1},{"lineBreak":true},{"text":"Ana looy seetaan ay workat?","poem":1},{"lineBreak":true},{"text":"Looy noppi te ku bon di mëdd","poem":1},{"lineBreak":true},{"text":"moroomam mu ko gëna jub?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaa def doom aadama mel niw jën,","poem":1},{"lineBreak":true},{"text":"mbaa ndiiraanu ndundat lu amul njiit,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"te ñoom ñépp la ku bon di korandoo,","poem":1},{"lineBreak":true},{"text":"diri leen ciy mbaalam,","poem":1},{"lineBreak":true},{"text":"dajale ciy caaxam,","poem":1},{"lineBreak":true},{"text":"ba tax ko di bég aka bànneexu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Moo tax muy rendil mbaalam ab sarax,","poem":1},{"lineBreak":true},{"text":"di taalal ab caaxam saraxu cuuraay,","poem":1},{"lineBreak":true},{"text":"te naan moo niinal njëlam,","poem":1},{"lineBreak":true},{"text":"duunal ab dundam.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mbaa du nii lay yuree mbaalam,","poem":1},{"lineBreak":true},{"text":"di wéye fàllas ay xeet te yërëmul?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}