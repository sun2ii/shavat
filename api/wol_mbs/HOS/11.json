{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Cofeel la Aji Sax ji tontoo fippug Israayil"]},{"type":"verse","number":1,"content":[{"text":"«Maa soppoon Israayil ba muy ndaw,","poem":1},{"lineBreak":true},{"text":"Misra laa woowe sama doom, mu génne fa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lu ñu leen gëna woo,","poem":1},{"lineBreak":true},{"text":"ñu gën maa sore.","poem":1},{"lineBreak":true},{"text":"Ay tuuri Baal lañuy defal ay sarax,","poem":1},{"lineBreak":true},{"text":"te ay xërëm lañuy taalal cuuraay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndaxam man maa tette Efrayim, fab ko,","poem":1},{"lineBreak":true},{"text":"te ràññeewuñu ne maa leen toppatoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ay goji nit laa leen ñoddee,","poem":1},{"lineBreak":true},{"text":"ay buumi cofeel.","poem":1},{"lineBreak":true},{"text":"Maay ki leen yolomalal ŋalaabi ŋaam,","poem":1},{"lineBreak":true},{"text":"sëgg, leel leen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Duñu dellu réewum Misra","poem":1},{"noteId":17},{"text":".","poem":1},{"lineBreak":true},{"text":"Waa Asiri ñooy doon seen buur,","poem":1},{"lineBreak":true},{"text":"nde ñoo baña délsi fi man.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ab saamar ay wëndeelu ca seen dëkk yu mag,","poem":1},{"lineBreak":true},{"text":"dàjji seen bunti dëkk,","poem":1},{"lineBreak":true},{"text":"ba warax leen ndax seeni mébét.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sama ñoñ dañoo làggi ci ñàkke ma kóllëre,","poem":1},{"lineBreak":true},{"text":"woowees na leen fa kaw,","poem":1},{"lineBreak":true},{"text":"te kenn ci ñoom jógul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Efrayim, ana nu ma lay dëddoo;","poem":1},{"lineBreak":true},{"text":"yaw Israayil laa ne, nu ma lay tege ciy loxo?","poem":1},{"lineBreak":true},{"text":"Ana nu ma lay defe ni Adma?","poem":1},{"lineBreak":true},{"text":"Nu ma lay yemaleek Ceboyim","poem":1},{"noteId":18},{"text":"?","poem":1},{"lineBreak":true},{"text":"Sama xol a bëpp,","poem":1},{"lineBreak":true},{"text":"sama yërmandee yëngu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Duma wéye di tàkkal sama mer,","poem":1},{"lineBreak":true},{"text":"duma yàqateeti Efrayim,","poem":1},{"lineBreak":true},{"text":"ndax maay Yàlla, duma nit,","poem":1},{"lineBreak":true},{"text":"maay Aji Sell ji ci seen biir,","poem":1},{"lineBreak":true},{"text":"duma dikke am sànj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dees na topp ci gannaaw Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"muy yëmmu ni gaynde.","poem":1},{"lineBreak":true},{"text":"Mooy yëmmu moos ni gaynde,","poem":1},{"lineBreak":true},{"text":"ay doomam di lox, jóge sowu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ni njanaaw lañuy loxe, jóge Misra,","poem":1},{"lineBreak":true},{"text":"mel nim pitax, bawoo Asiri.","poem":1},{"lineBreak":true},{"text":"Maa leen di dëël seeni kër.»","poem":1},{"lineBreak":true},{"text":"Aji Sax jee ko wax.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"11.5 Loolu mooy duñu dellu ci njaam ga ñu nekke woon ca Misra.","reference":{"chapter":11,"verse":5}},{"noteId":18,"caller":"+","text":"11.8 Adma ak Ceboyim ñooy ñaari dëkk yu Yàlla boole ak Sodom ak Gomor, dëkk ya ñu dendaloon, tas leen.","reference":{"chapter":11,"verse":8}}]},"thisChapterLink":"/api/wol_mbs/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":11}