{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"heading","content":["Aji Sax ji layoo na ak Israayil ak Yuda"]},{"type":"verse","number":1,"content":[{"text":"«Efrayim, ay fen la ma gawe,","poem":1},{"lineBreak":true},{"text":"waa kër Israayil laa ne,","poem":1},{"lineBreak":true},{"text":"ñoo ma yéewe ag njublaŋ,","poem":1},{"lineBreak":true},{"text":"te Yudaa ngi fippu ci kaw Yàlla ba tey,","poem":1},{"lineBreak":true},{"text":"di fecci kóllëreem ak Ku sell ki.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Efrayim mooy sàmmkatub ngelaw,","poem":1},{"lineBreak":true},{"text":"yendoo topp ngelawal penku,","poem":1},{"lineBreak":true},{"text":"di yokki fen ak fitna,","poem":1},{"lineBreak":true},{"text":"fasoo kóllëre ak Asiri,","poem":1},{"lineBreak":true},{"text":"yónnee yóbbalu diw ba Misra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji moo séq ak Yuda ab layoo,","poem":1},{"lineBreak":true},{"text":"mooy mbugale Yanqóoba ay jëfinam,","poem":1},{"lineBreak":true},{"text":"añale ko ay jëfam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ci biiru ndeyam la kii suufoo ab seexam;","poem":1},{"lineBreak":true},{"text":"kii moo tollu ci dooleem, bëreek Yàlla.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kee bëreek malaaka, ba génn ca,","poem":1},{"lineBreak":true},{"text":"kee jooy di sàkku aw yiwam.","poem":1},{"lineBreak":true},{"text":"Fa Betel la ko fekk,","poem":1},{"lineBreak":true},{"text":"te foofa la Yàlla waxeek nun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax ji Yàlla Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee di turu bàkkam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaw nag, ca sa Yàlla nga wara dellu,","poem":1},{"lineBreak":true},{"text":"ngor ak njub, sàmm ko,","poem":1},{"lineBreak":true},{"text":"te nga saxoo yaakaar sa Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ni Kanaaneen biy jula, ni la Efrayim","poem":1},{"lineBreak":true},{"text":"yore màndaxekaayu njublaŋ cib loxoom,","poem":1},{"lineBreak":true},{"text":"bëgga naxe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efrayim a ngi naan: «Woomle naa,","poem":1},{"lineBreak":true},{"text":"maa amal sama bopp alal,","poem":1},{"lineBreak":true},{"text":"te mboolem samaw ñaq, giseesu ci","poem":1},{"lineBreak":true},{"text":"tooñaange ju di bàkkaar.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Man Aji Sax ji dale di sa Yàlla ca Misra,","poem":1},{"lineBreak":true},{"text":"maa lay dëëlaat ciy xayma,","poem":1},{"lineBreak":true},{"text":"na woon ca bésub ndaje.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maa wax ak yonent yi,","poem":1},{"lineBreak":true},{"text":"yokk peeñu yi,","poem":1},{"lineBreak":true},{"text":"te yonent yi, maa leen léeb ay misaal.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Su Galàdd dee dëkkub defkati ñaawtéef,","poem":1},{"lineBreak":true},{"text":"dañoo tekkiwul dara.","poem":1},{"lineBreak":true},{"text":"Fa Gilgal lees di rendee ay saraxi yëkk,","poem":1},{"lineBreak":true},{"text":"te seeni sarxalukaay ni jali xeer lay mel","poem":1},{"lineBreak":true},{"text":"ci ay tooboy tool.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yanqóobaa dawoon ba réewum Siri,","poem":1},{"lineBreak":true},{"text":"Israayil laa ne, moo liggéey ngir am jabar,","poem":1},{"lineBreak":true},{"text":"wut jabar tax koo sàmm ag jur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ci loxol yonent la Aji Sax ji génnee Israayil Misra,","poem":1},{"lineBreak":true},{"text":"te ab yonent la sàmmloo Israayil.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waaye Efrayim moomoo ko merloo,","poem":1},{"lineBreak":true},{"text":"naqaral ko.","poem":1},{"lineBreak":true},{"text":"Deret ji mu tuur la Boroomam di këpp ci kawam,","poem":1},{"lineBreak":true},{"text":"añub tooñam la koy fey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":15}