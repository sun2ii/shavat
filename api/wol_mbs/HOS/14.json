{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"«Dees na topp waa Samari,","poem":1},{"lineBreak":true},{"text":"nde ñoo fippu ci seen kaw Yàlla.","poem":1},{"lineBreak":true},{"text":"Saamar lañuy faate,","poem":1},{"lineBreak":true},{"text":"seeni doom, ñu rajaxe leen,","poem":1},{"lineBreak":true},{"text":"seen jigéeni wérul, ñu butti.»","poem":1}]},{"type":"heading","content":["Dëpp, am njéggal"]},{"type":"verse","number":2,"content":[{"text":"Israayiloo, dellul ci sa Yàlla Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"fakkastaloo nga sag ñaawtéef.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waajalleen ay kàddu te dellu ci Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ne ko: «Baal nu mboolem ñaawtéef","poem":1},{"lineBreak":true},{"text":"te nangul nu,","poem":1},{"lineBreak":true},{"text":"nu yékkati kàdduy màggal","poem":1},{"lineBreak":true},{"text":"yu wuutu saraxi yëkk.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asiri du nu xettali,","poem":1},{"lineBreak":true},{"text":"ay fasi xare it, dunu ko war,","poem":1},{"lineBreak":true},{"text":"te dootunu wax lu nu sàkke sunuy loxo, ne ko:","poem":1},{"lineBreak":true},{"text":"“Yaw yaa di sunu Yàlla.”","poem":1},{"lineBreak":true},{"text":"Li nuy wax kay mooy yaw yaay kiy yërëm jirim.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aji Sax ji nee: «Maay garabal seenug déggadi,","poem":1},{"lineBreak":true},{"text":"maa leen di bëggal sama bopp,","poem":1},{"lineBreak":true},{"text":"nde mereetuma leen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maay mel nib lay buy guusal Israayil,","poem":1},{"lineBreak":true},{"text":"ñu focci ni tóor-tóor,","poem":1},{"lineBreak":true},{"text":"seeni reen sampu ni garabi Libaŋ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"car ya law, yànj nig oliw,","poem":1},{"lineBreak":true},{"text":"xeeñ ni gottub Libaŋ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñooy délsi, keppaaroo ko,","poem":1},{"lineBreak":true},{"text":"dellu ji, pepp dundaat.","poem":1},{"lineBreak":true},{"text":"Dañuy giir nig reseñ,","poem":1},{"lineBreak":true},{"text":"am bayre ni biiñu Libaŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Yeen Efrayim, lu ma masa séq ak jëmmi tuur?","poem":1},{"lineBreak":true},{"text":"Man maa leen di nangul, di leen wattu,","poem":1},{"lineBreak":true},{"text":"di leen keral ni garab gu naat gu dul ruus,","poem":1},{"lineBreak":true},{"text":"sa meññeef bawoo fi man.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ku rafet xel, na dégg lii,","poem":1},{"lineBreak":true},{"text":"kuy ràññee na ko xam.","poem":1},{"lineBreak":true},{"text":"Yooni Aji Sax ji kat day jub,","poem":1},{"lineBreak":true},{"text":"te kuy jubal jaare ca,","poem":1},{"lineBreak":true},{"text":"ab jàddkat moo cay tërëf.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}