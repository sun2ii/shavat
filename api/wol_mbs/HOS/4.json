{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Aji Sax ji tiiñal na kilifay ñoñam"]},{"type":"verse","number":1,"content":["Yeen bànni Israayil, dégluleen kàddug Aji Sax ji,",{"text":"Aji Sax ji kat moo séq ab layoo ak waa réew mi:","poem":1},{"lineBreak":true},{"text":"«Du worma, du ngor, du gennug ràññee Yàlla","poem":1},{"lineBreak":true},{"text":"ci réew mi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xanaa ay móolu aki wor, bóome, càcc ak njaaloo.","poem":1},{"lineBreak":true},{"text":"Dañoo ràkkaaju, di tuur deret ci kaw deret.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moo tax réew mi wowal,","poem":1},{"lineBreak":true},{"text":"mboolem lu fi dëkke ràgg,","poem":1},{"lineBreak":true},{"text":"ba ci rabi àll yi ak njanaaw yi,","poem":1},{"lineBreak":true},{"text":"jëni géej itam day réer.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Waaye bu ci kenn layoo,","poem":1},{"lineBreak":true},{"text":"bu ci kenn sikke,","poem":1},{"lineBreak":true},{"text":"ndax sa bokk yee mel ni ñuy layook sarxalkat yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dingeen tërëf bëccëg,","poem":1},{"lineBreak":true},{"text":"yonent yi ànd ak yeen tërëf guddi,","poem":1},{"lineBreak":true},{"text":"te maay sànk seen ndey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sama ñoñ a sànku ndax ñàkka xam;","poem":1},{"lineBreak":true},{"text":"yeen, xam-xam ngeen gàntal,","poem":1},{"lineBreak":true},{"text":"ma gàntal seenug carxal.","poem":1},{"lineBreak":true},{"text":"Yeena fàtte seen yoonu Yàlla,","poem":1},{"lineBreak":true},{"text":"man it maay fàtte seeni doom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sarxalkat yi ñu gëna baree, gën ma nee moye,","poem":1},{"lineBreak":true},{"text":"seenub sag, gàcce laa koy soppi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sama saraxi póotum bàkkaari ñoñ","poem":1},{"text":"lañuy dunde","poem":2},{"noteId":2},{"text":",","poem":2},{"text":"tey yàkkamti ñu def njubadi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waaye niki askan wi, niki sarxalkat yi,","poem":1},{"lineBreak":true},{"text":"maa leen di dikke seen añu jikko,","poem":1},{"lineBreak":true},{"text":"maa leen di fey seeni jëf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñooy lekk te duñu regg,","poem":1},{"lineBreak":true},{"text":"di gànctu te duñu giir,","poem":1},{"lineBreak":true},{"text":"nde Aji Sax ji lañu noppee topp.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ngànctu ak biiñ bu yàgg ak bu bees","poem":1},{"lineBreak":true},{"text":"moo yóbbu seenum xel.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sama ñoñ, seen bant lañuy seetéey!","poem":1},{"lineBreak":true},{"text":"Seenu yet di leen waxaléey!","poem":1},{"lineBreak":true},{"text":"Xelum ngànctu moo leen wacc,","poem":1},{"lineBreak":true},{"text":"ñooy gànctu, lajje fa seen Yàlla.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ca kaw tund yu mag ya lañuy rendee ay sarax,","poem":1},{"lineBreak":true},{"text":"cuuraay, ñu taale ca tund yu ndaw ya,","poem":1},{"lineBreak":true},{"text":"ak ca taatu gii garab gu mag, ba ca gee,","poem":1},{"lineBreak":true},{"text":"fa ker ga neexe.","poem":1},{"lineBreak":true},{"text":"Moo tax seeni doom di gànctu,","poem":1},{"lineBreak":true},{"text":"seen séeti doom di njaaloo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Duma mbugal seeni doom","poem":1},{"lineBreak":true},{"text":"ndax li ñuy gànctu","poem":1},{"lineBreak":true},{"text":"mbaa seen séeti doom","poem":1},{"lineBreak":true},{"text":"ndax li ñuy njaaloo,","poem":1},{"lineBreak":true},{"text":"ndax ñoom sarxalkat yi ci seen bopp,","poem":1},{"lineBreak":true},{"text":"ay gànc lañuy teggeendool","poem":1},{"lineBreak":true},{"text":"te gànc yi ci jaamookaayi xërëm yi,","poem":1},{"lineBreak":true},{"text":"ñoom lañuy indeendool ay sarax.","poem":1},{"lineBreak":true},{"text":"Askan wu amulug dégg, sànku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Yeena ngi gànctu, yeen bànni Israayil,","poem":1},{"lineBreak":true},{"text":"waaye na Yuda mucc ci googu tooñ.","poem":1},{"lineBreak":true},{"text":"Buleen dugg Gilgal","poem":1},{"noteId":3},{"text":",","poem":1},{"lineBreak":true},{"text":"buleen yéegi Bet Awen","poem":1},{"noteId":4},{"lineBreak":true},{"text":"di giñ ci Aji Sax jiy dund.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndegam ni aw nag tëwe ni la Israayil tëwe,","poem":1},{"lineBreak":true},{"text":"ndax léegi Aji Sax jee leen di foral","poem":1},{"lineBreak":true},{"text":"nim xar ci parlu mu ne màww?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Efrayim","poem":1},{"noteId":5},{"text":"googu laa ne, moo lëngook jëmmi tuur!","poem":1},{"lineBreak":true},{"text":"Seetaan leen.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Seenu ñoll giiful sax, ñuy gànctoo gànctu,","poem":1},{"lineBreak":true},{"text":"te gàccee gënal seeni kilifa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Callweer a leen di wal,","poem":1},{"lineBreak":true},{"text":"ñu kersawoo seen saraxi tuur yi.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"4.8 Seetal ci Sarxalkat yi 6.19-22.","reference":{"chapter":4,"verse":8}},{"noteId":3,"caller":"+","text":"4.15 Gilgal, béreb la bu ñu daan bokkaalee, ba tur wi mujj taxawe jikkoy dëddu Aji Sax ji.","reference":{"chapter":4,"verse":15}},{"noteId":4,"caller":"+","text":"4.15 Bet Awen: li muy firi mooy Kërug Ñaawtéef. Muy tur wu waxi kókkali dendale ak Bet El, tur wi firi Kër Yàlla.","reference":{"chapter":4,"verse":15}},{"noteId":5,"caller":"+","text":"4.17 Efrayim, genn la ci giiri Israayil ga ca bëj-gànnaar, moom la Ose faral di woowe réewum Israayil gépp.","reference":{"chapter":4,"verse":17}}]},"thisChapterLink":"/api/wol_mbs/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}