{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Njiiti Israayil lajj nañu"]},{"type":"verse","number":1,"content":[{"text":"«Dégluleen lii, yeen sarxalkat yi!","poem":1},{"lineBreak":true},{"text":"Teeyluleen, yeen waa kër Israayil!","poem":1},{"lineBreak":true},{"text":"Teewluleen, yeen waa kër buur!","poem":1},{"lineBreak":true},{"text":"Yeen la àtte bi ñeel.","poem":1},{"lineBreak":true},{"text":"Ag fiir ngeen tegoon ca Mispa,","poem":1},{"lineBreak":true},{"text":"ab caax ngeen laloon ca tundu Tabor,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fippukat yi gën nañoo xuus ci seen bóome,","poem":1},{"lineBreak":true},{"text":"waaye maa leen di yar, ñoom ñépp.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maa xam Efrayim miy Israayil,","poem":1},{"lineBreak":true},{"text":"umpu ma.","poem":1},{"lineBreak":true},{"text":"Efrayim, yaa gànctu,","poem":1},{"lineBreak":true},{"text":"Israayil laa ne, yaa sobeel sa bopp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Seeni jëf a leen mayul ñu dellu ci seen Yàlla,","poem":1},{"lineBreak":true},{"text":"nde ngelawal ngànctoo wale fa seen biir,","poem":1},{"lineBreak":true},{"text":"te Aji Sax ji, faalewuñu ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Israayil, ag reewandeem a ko tiiñal,","poem":1},{"lineBreak":true},{"text":"Israayil, ak Efrayim sax, dinañu fakkastaloo seenug ñaawtéef,","poem":1},{"lineBreak":true},{"text":"Yuda it ànd ak ñoom fakkastalu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Seen jur gu gudd ak gu gàtt lañuy àndal,","poem":1},{"lineBreak":true},{"text":"di seet Aji Sax ji, duñu ko gis,","poem":1},{"lineBreak":true},{"text":"te moo leen dëddu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax ji lañu wor,","poem":1},{"lineBreak":true},{"text":"nde doomi po lañu jur.","poem":1},{"lineBreak":true},{"text":"Léegi la leen màggalug Terutel weer","poem":1},{"lineBreak":true},{"text":"di booleek seen suuf, sànk leen.","poem":1}]},{"type":"heading","content":["Yàlla dëkk na Israayil ak Yuda"]},{"type":"verse","number":8,"content":[{"text":"«Walleen bufta bi ca Gibeya,","poem":1},{"lineBreak":true},{"text":"jibal liit gi ca Raama","poem":1},{"lineBreak":true},{"text":"te yéene ca Bet Awen","poem":1},{"noteId":6},{"text":".","poem":1},{"lineBreak":true},{"text":"Moytul sa gannaaw, Beñamin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efrayim day gental kera bésu mbugal,","poem":1},{"lineBreak":true},{"text":"maa xamle ci biir giiri Israayil lu wér péŋŋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kàngami Yuda mujj mel ni","poem":1},{"lineBreak":true},{"text":"ñuy toxal màndargam làccu suuf.","poem":1},{"lineBreak":true},{"text":"Ci seen kaw laay yuri sama sànj nim ndox.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efrayim lees di noot,","poem":1},{"lineBreak":true},{"text":"joggati ay yelleefam,","poem":1},{"lineBreak":true},{"text":"nde moo dogoo topp yoonu caaxaan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Man nag ni gunóoru ñaawat laay mel ci Efrayim,","poem":1},{"lineBreak":true},{"text":"te ni bant bu nëb laay mel ci Yuda.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ba Efrayim gisee jàngoroom,","poem":1},{"lineBreak":true},{"text":"Yuda gis ab danaam,","poem":1},{"lineBreak":true},{"text":"Efrayim a dem Asiri,","poem":1},{"lineBreak":true},{"text":"yónnee ca Buur Yareb","poem":1},{"noteId":7},{"text":".","poem":1},{"lineBreak":true},{"text":"Waaye manu koo wéral,","poem":1},{"lineBreak":true},{"text":"mbaa di ko fajal ab danaam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Man déy ni gaynde laay mel ak Efrayim,","poem":1},{"lineBreak":true},{"text":"ni gaynde gu mat laay mel ak waa kër Yuda.","poem":1},{"lineBreak":true},{"text":"Man, man mii maay xotat, wéy,","poem":1},{"lineBreak":true},{"text":"maay yóbbu te kenn du wallu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma daldi ñibbi, ba ñu nangu seenug tooñ,","poem":1},{"lineBreak":true},{"text":"seet fu ma féete.","poem":1},{"lineBreak":true},{"text":"Bu ñu jàqee lañuy daw wutsi ma.»","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5.8 Seetal ci 4.15.","reference":{"chapter":5,"verse":8}},{"noteId":7,"caller":"+","text":"5.13 Yareb man naa tekki «xeexkat».","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/wol_mbs/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}