{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Wooteb tuub jib na"]},{"type":"verse","number":1,"content":[{"text":"Ca ngeen naan: «Nan dellu ci Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Moo nu xotat, te moo nuy wéral.","poem":1},{"lineBreak":true},{"text":"Moo nu duma, te moo nuy takkal sunuy góom.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ñaari fan, mu leqali nu,","poem":1},{"lineBreak":true},{"text":"ñetteel ba mu yékkati nu,","poem":1},{"lineBreak":true},{"text":"nuy dund fi kanamam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nan ràññee, di saxoo faale Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Ni jant bu fenk la dikkam wóore,","poem":1},{"lineBreak":true},{"text":"ni ab taw la nuy dikkale,","poem":1},{"lineBreak":true},{"text":"ni ab tawu mujjantal buy seral suuf.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax jee tontu: «Ana nu ma lay def, yaw Efrayim?","poem":1},{"lineBreak":true},{"text":"Nu ma lay def, yaw Yuda?","poem":1},{"lineBreak":true},{"text":"Te sa ngor di xiinu suba,","poem":1},{"lineBreak":true},{"text":"mbaa ab lay, jekki ne mes.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moo tax yonent yi laa leen di dumaa,","poem":1},{"lineBreak":true},{"text":"sama kàdduy gémmiñ laa leen di reye.","poem":1},{"lineBreak":true},{"text":"Seen àttee leen di leeral ni ceeñeeru njël.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndax ngor laa namm, dub sarax,","poem":1},{"lineBreak":true},{"text":"ràññee Yàllaa ma gënal saraxi rendi-dóomal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Waaye ñoom ca dëkk ba ñuy wax Aadama lañu feccee kóllëre,","poem":1},{"lineBreak":true},{"text":"foofa lañu ma wore.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galàdd mooy dëkkub defkati ñaawtéef,","poem":1},{"lineBreak":true},{"text":"taq ripp ak deret.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni saay-saay siy tëroo,","poem":1},{"lineBreak":true},{"text":"ni la sarxalkat yi lëkkoo,","poem":1},{"lineBreak":true},{"text":"di bóome ca yoonu Sikem.","poem":1},{"lineBreak":true},{"text":"Ndaw jëf ju ñaaw!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ci kërug Israayil laa gis lu yées:","poem":1},{"lineBreak":true},{"text":"fa la Efrayim di gànctoo,","poem":1},{"lineBreak":true},{"text":"Israayil googu laa ne moo sobeel boppam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yuda yaw it, sam ngóob ma ngay taxawe,","poem":1},{"lineBreak":true},{"text":"kera bu may tijji sama wërsëgu ñoñ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}