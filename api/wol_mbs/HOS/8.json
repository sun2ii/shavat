{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"HOS","translationId":"wol_mbs","name":"Ose","commonName":"Ose","title":"Téereb Yonent Yàlla Ose","order":28,"numberOfChapters":14,"sha256":"133ba08ab72cb09449e4eb4d01118fad6af0101eda46aafb8a3fe5c9dcea909b","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Ku ji as ngelaw, yaay góob ngëlén"]},{"type":"verse","number":1,"content":[{"text":"«Sexleen bufta bi!","poem":1},{"lineBreak":true},{"text":"Noon ni jaxaay jàyy ci waa kër Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"nde ñoo fecci sama kóllëreek ñoom,","poem":1},{"lineBreak":true},{"text":"samaw yoon lañu gàntal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Man la Israayil xaacu, ne ma:","poem":1},{"lineBreak":true},{"text":"“Éy sama Yàlla, maa la ràññee!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israayil a xalab lu baax,","poem":1},{"lineBreak":true},{"text":"ba ab noon dàq ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ñoo fal ay buur te du sama ndigal,","poem":1},{"lineBreak":true},{"text":"ñoo tabb ay kàngam, te yéguma.","poem":1},{"lineBreak":true},{"text":"Seen xaalis ak seen wurus lañu sàkke jëmmi tuur,","poem":1},{"lineBreak":true},{"text":"muy seen sànkute.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeen waa Samari, seen jëmmu wëllu wi","poem":1},{"noteId":11},{"text":"dàqu na!","poem":1},{"lineBreak":true},{"text":"Sama mer tàkkal na leen.","poem":1},{"lineBreak":true},{"text":"Lu ngeen deeti xaar ci mucc ayib?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Israayil la lii jóge,","poem":1},{"lineBreak":true},{"text":"te ab liggéeykat moo ko sàkk.","poem":1},{"lineBreak":true},{"text":"Kon lii du Yàlla!","poem":1},{"lineBreak":true},{"text":"Ay tojit la wëlluw Samari di mujje.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«As ngelaw lañu ji, ñooy góob ngëlén.","poem":1},{"lineBreak":true},{"text":"Gub du jóg, pepp du focci,","poem":1},{"lineBreak":true},{"text":"te bu pepp amoon it,","poem":1},{"lineBreak":true},{"text":"jàmbur a koy wann.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dees na wann Israayil;","poem":1},{"lineBreak":true},{"text":"tey ñu ngi ci biir xeeti jàmbur yi,","poem":1},{"lineBreak":true},{"text":"mel ni ndab lu kenn bëggul.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ñoo demal seen bopp Asiri.","poem":1},{"lineBreak":true},{"text":"Mbaamu àll day beru yoonam,","poem":1},{"lineBreak":true},{"text":"waaye waa kër Efrayim ñooy jënd ay far.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ci xeeti jàmbur ñi lañuy jënde,","poem":1},{"lineBreak":true},{"text":"waaye du tee ma dajale leen.","poem":1},{"lineBreak":true},{"text":"Léegi ñu tegoo nootaangey buur aki kàngam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efrayim a yokk ay sarxalukaay ngir moy,","poem":1},{"lineBreak":true},{"text":"ñu doon ay sarxalukaayi moyukaay doŋŋ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Naa ko bindal sama fukki junniy ndigali yoon,","poem":1},{"lineBreak":true},{"text":"yëfi jàmbur lees koy jàppe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñooy rendi jur gi ñu may sarxal,","poem":1},{"lineBreak":true},{"text":"lekk yàpp wi,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji bëggu ci dara.","poem":1},{"lineBreak":true},{"text":"Maay bàyyi xel ci seen ñaawtéef,","poem":1},{"lineBreak":true},{"text":"mbugale leen seeni moy,","poem":1},{"lineBreak":true},{"text":"te ñoom Misra lañuy dellu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Israayil moo fàtte ki ko sàkk,","poem":1},{"lineBreak":true},{"text":"di tabax kër yu yànj.","poem":1},{"lineBreak":true},{"text":"Yuda moom yokki dëkk yu tata wër.","poem":1},{"lineBreak":true},{"text":"Maay yebal sawara ci kawi dëkkam,","poem":1},{"lineBreak":true},{"text":"mu xoyom ay tataam.»","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"8.5 jëmmu wëllu wi: seetal ci 1.Buur ya 12.25-30.","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/wol_mbs/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}