{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":1,"content":[{"type":"heading","content":["Ubbite gi"]},{"type":"verse","number":1,"content":["Lii moo di peeñum Esayi doomu Amocc, di lu mu gis ci mbirum Yuda ak Yerusalem ci janti buuri Yuda yi ñuy wax Osiyas",{"noteId":0},"ak Yotam ak Axas ak Esekiyas."]},{"type":"heading","content":["Aji Sax ji sikk na waa Yuda"]},{"type":"verse","number":2,"content":[{"text":"Asamaan, déglul; suuf, teewlul,","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey àddu:","poem":1},{"lineBreak":true},{"text":"«Ay gone laa yar, màggloo leen,","poem":1},{"lineBreak":true},{"text":"ñoom, ñu gàntal ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aw yëkk xam na boroomam,","poem":1},{"lineBreak":true},{"text":"mbaam-sëf xam gàmb bi ko boroomam di xonte,","poem":1},{"lineBreak":true},{"text":"waaye Israayil xamul,","poem":1},{"lineBreak":true},{"text":"sama ñoñ ñii xàmmeewuñu.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wóoy wii xeetu moykat,","poem":1},{"lineBreak":true},{"text":"wii askan wu diisu ñaawtéef,","poem":1},{"lineBreak":true},{"text":"mii njurum defkati mbon,","poem":1},{"lineBreak":true},{"text":"yii doomi yàqute!","poem":1},{"lineBreak":true},{"text":"Ñoo wacc Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ñoo sofental Aji Sell ju Israayil,","poem":1},{"lineBreak":true},{"text":"dëddu ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xanaa dungeen wéye fippu,","poem":1},{"lineBreak":true},{"text":"ñu gën leena duma,","poem":1},{"lineBreak":true},{"text":"te bopp di góomi neen,","poem":1},{"lineBreak":true},{"text":"xol jeex tàkk?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bopp ba téstën, fenn jagul.","poem":1},{"lineBreak":true},{"text":"Xanaa gaañu-gaañu aki dagg-dagg rekk,","poem":1},{"lineBreak":true},{"text":"ak góom yuy nàcc,","poem":1},{"lineBreak":true},{"text":"fajeesu ko, takkeesu ko,","poem":1},{"lineBreak":true},{"text":"gajfaleesu kook ag diw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Seenum réew gental,","poem":1},{"lineBreak":true},{"text":"seeni dëkk xoyomu,","poem":1},{"lineBreak":true},{"text":"seen suuf, doxandéem yi lekk fi seen kanam,","poem":1},{"lineBreak":true},{"text":"muy gent bu doxandéem tas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siyoŋ, dëkk bu taaru baa ngi wéet","poem":1},{"lineBreak":true},{"text":"ni mbaarum tóokër mbaa dalub toolu xaal.","poem":1},{"lineBreak":true},{"text":"Mbete dëkk bu ñu gaw!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu nu Aji Sax ju gàngoor yi","poem":1},{"text":"waccalul woon li nu deseek as néew,","poem":2},{"text":"ni Sodom","poem":1},{"noteId":1},{"text":"lanuy mel,","poem":1},{"lineBreak":true},{"text":"Gomor lanuy neexool.","poem":1}]},{"type":"heading","content":["Aji Sax ji bañ na ngistal"]},{"type":"verse","number":10,"content":[{"text":"Dégluleen kàddug Aji Sax ji, yeen njiiti Sodom,","poem":1},{"lineBreak":true},{"text":"teewluleen sunu yoonu Yàlla, yeen askanu Gomor.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"«Lu may doye seen sarax yu bare?» la Aji Sax ji wax.","poem":1},{"lineBreak":true},{"text":"«Damaa suur seen saraxi rendi-dóomali kuuy,","poem":1},{"lineBreak":true},{"text":"suur nebbonu juru yar gi,","poem":1},{"lineBreak":true},{"text":"deretu yëkk ak xar ak sikket it, safu ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bu ngeen dikkee, teewsi fi sama kanam,","poem":1},{"lineBreak":true},{"text":"ana ku leen sant ñu joggat-joggatee nii sama ëttu kër?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Buleen fi indeeti saraxi caaxaan,","poem":1},{"text":"seen saraxu cuuraay, lu ma seexlu la.","poem":2},{"text":"Terutel weer ak bésub Noflaay","poem":1},{"text":"ak wooteb ndajee ci yem!","poem":2},{"text":"Duma mana dékku ndajem diine mu rax njubadi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Seeni Terutel weer ak seen bési màggal","poem":1},{"text":"laa bañ ci sama xol;","poem":2},{"text":"yooyu màggal a ma diis ba àttanatuma ko.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bu ngeen ma tàllaleey yoxo,","poem":1},{"lineBreak":true},{"text":"ma fuuyu.","poem":1},{"lineBreak":true},{"text":"Bu ngeen doon ñaan-ñaanee it,","poem":1},{"lineBreak":true},{"text":"du maa leen di déglu:","poem":1},{"lineBreak":true},{"text":"seeni loxo, deret la taq ripp.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Raxasuleen ba set wecc,","poem":1},{"lineBreak":true},{"text":"jëleleen seeni jëf ju bon fi sama kanam,","poem":1},{"lineBreak":true},{"text":"te ngeen ba lu bon.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jàngleen di def lu baax,","poem":1},{"lineBreak":true},{"text":"sàkku njub,","poem":1},{"lineBreak":true},{"text":"waññi ab nootkat,","poem":1},{"lineBreak":true},{"text":"àtte dëgg ab jirim,","poem":1},{"lineBreak":true},{"text":"sàmm àqu jëtun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Kaayleen, nu waxtaan ba juboo,» la Aji Sax ji wax.","poem":1},{"lineBreak":true},{"text":"«Li seeni bàkkaar di xonq lépp,","poem":1},{"lineBreak":true},{"text":"tàll lay weexeji.","poem":1},{"lineBreak":true},{"text":"Li muy xonq curr lépp,","poem":1},{"lineBreak":true},{"text":"weex furr lay mujje.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Su ngeen ma nangoo déggal,","poem":1},{"lineBreak":true},{"text":"ngëneelu réew mi ngeen di xéewloo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Waaye su ngeen lànkee, fippu,","poem":1},{"lineBreak":true},{"text":"saamar a leen di xéewloo.»","poem":1},{"lineBreak":true},{"text":"Aji Sax ji déy a ko wax ci gémmiñam.","poem":1}]},{"type":"heading","content":["Mbugal mooy setal Yerusalem"]},{"type":"verse","number":21,"content":[{"text":"Ana nu biib dëkk yàqoo, mbeteb gànc,","poem":1},{"lineBreak":true},{"text":"te nekkoon dëkkub kóllëre,","poem":1},{"lineBreak":true},{"text":"yoon mate fa,","poem":1},{"lineBreak":true},{"text":"njubte lal fa panaan,","poem":1},{"lineBreak":true},{"text":"tey ñu diy bóomkat!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sa xaalis doon na raxit,","poem":1},{"lineBreak":true},{"text":"sa biiñ xormbet.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Seeni njiit të,","poem":1},{"lineBreak":true},{"text":"xejjoo ay sàcc,","poem":1},{"lineBreak":true},{"text":"ñoom ñépp sopp ger,","poem":1},{"lineBreak":true},{"text":"di dàq ay neexal;","poem":1},{"lineBreak":true},{"text":"ab jirim, sàmmuñu àtteem,","poem":1},{"lineBreak":true},{"text":"àqu jëtun soxalu leen.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Moo tax, kàddug Boroom bee,","poem":1},{"lineBreak":true},{"text":"Aji Sax ju gàngoor yi,","poem":1},{"lineBreak":true},{"text":"Jàmbaaru Israayil:","poem":1},{"lineBreak":true},{"text":"«Maay lijjanti samay bañ, ngalla ñoom!","poem":1},{"lineBreak":true},{"text":"Maay fey samay noon!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yerusalem, maa lay teg loxo,","poem":1},{"lineBreak":true},{"text":"maay seeyal sa raxit ni xeme,","poem":1},{"lineBreak":true},{"text":"ba dindi sa mbuubit mépp.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Maay waññi say àttekat, ñu mel na woon,","poem":1},{"lineBreak":true},{"text":"ñi lay digal it dellu mel ni bu njëkkoon.","poem":1},{"lineBreak":true},{"text":"Su boobaa ñu woowe la Dëkkub Yoon","poem":1},{"lineBreak":true},{"text":"ak Dëkkub Kóllëre.»","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Siyoŋ dëppook yoon, mucc,","poem":1},{"lineBreak":true},{"text":"ay tuubkatam wormaal njub, raw;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"moykat ak bàkkaarkat yàqoondoo,","poem":1},{"lineBreak":true},{"text":"dëddukati Aji Sax ji sànkoondoo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yeenay rus moos ci garab yu mag,","poem":1},{"text":"yi ngeen soppoona daje, di xërëmtu.","poem":2},{"text":"Yeenay am gàcce ci tóokër","poem":1},{"text":"yi ngeen taamu woona daje, di bokkaale.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yeenay meli ni garab gu mag gu xob ya lax,","poem":1},{"lineBreak":true},{"text":"mbaa tóokër bu amul siitum ndox.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Boroom doole mel ni boob,","poem":1},{"lineBreak":true},{"text":"la mu liggéey di ferñent,","poem":1},{"lineBreak":true},{"text":"ànd ak moom ne jéppét,","poem":1},{"lineBreak":true},{"text":"te kenn du fey sawara wa.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 Osiyas mooy Asaryaa ba tey.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"1.9 Seetal ci Njàlbéen ga 19.23-29.","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/wol_mbs/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}