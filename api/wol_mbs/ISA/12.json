{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Cant jib na"]},{"type":"verse","number":1,"content":[{"text":"Bésub keroog dees na ne:","poem":1},{"lineBreak":true},{"text":"«Aji Sax ji, sant naa la;","poem":1},{"lineBreak":true},{"text":"yaa ma mere woon, meddi, dëfal ma.»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma ne: «Yàllaa may wallu,","poem":1},{"lineBreak":true},{"text":"ma dallu, duma tiit.","poem":1},{"lineBreak":true},{"text":"Sama dooleek sama kaaraange mooy Ki Sax,","poem":1},{"lineBreak":true},{"text":"di Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te mooy sama wall.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbégte ngeen di rooteji","poem":1},{"lineBreak":true},{"text":"fa wali mucc ya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bésub keroog ngeen ne:","poem":1},{"lineBreak":true},{"text":"«Santleen Aji Sax ji, tudd turam,","poem":1},{"lineBreak":true},{"text":"xamley jalooreem ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"fàttali màggaayu turam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Woyleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo kawey jëf!","poem":1},{"lineBreak":true},{"text":"Na lii siiw biir àddina sépp.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yeen waa Siyoŋ, serleen te sarxolleel","poem":1},{"text":"Ku màgg ki fi seen biir,","poem":2},{"text":"Aji Sell ju Israayil.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}