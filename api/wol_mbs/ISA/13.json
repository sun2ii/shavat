{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":13,"content":[{"type":"heading","content":["Yéeneb waxyu dal na Babilon"]},{"type":"verse","number":1,"content":["Yéene bii ñeel na Babilon",{"noteId":5},",",{"text":"muy peeñum Esayi doomu Amocc:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yéegeleen ab raaya kaw tund wu ne duŋŋ,","poem":1},{"lineBreak":true},{"text":"joorleen ñii,","poem":1},{"lineBreak":true},{"text":"tàllalleen loxo,","poem":1},{"lineBreak":true},{"text":"ñu jàlle bunti kàngam yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maa jox ndigal ñi ma beral sama bopp,","poem":1},{"lineBreak":true},{"text":"maa woo sama jàmbaar ñiy réy-réylu,","poem":1},{"lineBreak":true},{"text":"ne leen ñu sottal mbugal mi sama sànj laaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Coowal mbooloo ngoog ca tund ya,","poem":1},{"lineBreak":true},{"text":"mel ni ñu baree bare!","poem":1},{"lineBreak":true},{"text":"Riirum nguuri nguur yu daje, di xeeti xeet!","poem":1},{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi","poem":1},{"lineBreak":true},{"text":"mooy dajale gàngooru xare.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mooy bawoo fu sore,","poem":1},{"lineBreak":true},{"text":"fa asamaan digalook suuf.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji laak gàngoor gi muy mbugale,","poem":1},{"lineBreak":true},{"text":"ngir yàqatesi réew mi mépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yuuxuleen! Bésub Aji Sax ji moo dëgmal,","poem":1},{"lineBreak":true},{"text":"te ni sànkute gu bawoo fa ci Aji Man ji lay dikke.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moo tax loxoo loxo yoqi,","poem":1},{"lineBreak":true},{"text":"xoloo xol jeex,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ñu tiit a tiit,","poem":1},{"lineBreak":true},{"text":"yaram di fuddooka metti,","poem":1},{"lineBreak":true},{"text":"ñuy baddaañu ni kuy matu;","poem":1},{"lineBreak":true},{"text":"ku ne jàq, di xulli sa moroom,","poem":1},{"lineBreak":true},{"text":"kanam ya sël-sëleendoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bésub Aji Sax jaa ngii di ñëw,","poem":1},{"lineBreak":true},{"text":"bés bu néeg, bésub mer ak sànj muy tàkk,","poem":1},{"lineBreak":true},{"text":"nara gental suuf,","poem":1},{"lineBreak":true},{"text":"te bàkkaarkat ya la fay faxas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Biddiiw mbaa dëllooñ dootul leeral;","poem":1},{"lineBreak":true},{"text":"jant ay fenke lëndëm,","poem":1},{"lineBreak":true},{"text":"weer dakkal leeram.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maay delloo àddina mbonam,","poem":1},{"lineBreak":true},{"text":"yool ku bon tooñam,","poem":1},{"lineBreak":true},{"text":"maay sàggi sagub ku reew,","poem":1},{"lineBreak":true},{"text":"detteel puukarey ku néeg.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Maay def nit gëna jafee gis wurus,","poem":1},{"lineBreak":true},{"text":"ba doom aadama raw wurusu Ofir.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Moo tax maay gësëm asamaan,","poem":1},{"lineBreak":true},{"text":"suuf yëngoo fa mu tege","poem":1},{"lineBreak":true},{"text":"ndax sànjum Aji Sax ji","poem":1},{"lineBreak":true},{"text":"Boroom gàngoori xare yi,","poem":1},{"lineBreak":true},{"text":"keroog ba meram di tàkk.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku nekk ay fekkiy bokkam,","poem":1},{"lineBreak":true},{"text":"rawi cam réewam,","poem":1},{"lineBreak":true},{"text":"mbete kéwél gu ñuy rëbb,","poem":1},{"lineBreak":true},{"text":"mbaa xar mu amul sàmm.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ku ñu ci gis, jam la,","poem":1},{"lineBreak":true},{"text":"ku ñu jàpp, saamar rey la;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"seeni doom, ñu moxoñe fi seen kanam,","poem":1},{"lineBreak":true},{"text":"seeni kër, ñu sëxëtoo,","poem":1},{"lineBreak":true},{"text":"seeni jabar, ñu tëdde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Maa ngii di xabtal fi seen kaw waa Medd,","poem":1},{"lineBreak":true},{"text":"ñi xintewoowul xaalis,","poem":1},{"lineBreak":true},{"text":"faalewuñu wurus.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Seeni fitt lañuy rajaxee xalelu góor,","poem":1},{"lineBreak":true},{"text":"duñu ñeewante gone,","poem":1},{"lineBreak":true},{"text":"duñu xool tuut-tànk gëti yërmande.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Babilon nag, mooy gànjaru réew yi ko wër,","poem":1},{"lineBreak":true},{"text":"di teraanga ji Kaldeen ñiy sagoo,","poem":1},{"lineBreak":true},{"text":"waaye Yàllaa koy tas,","poem":1},{"lineBreak":true},{"text":"mu ne tasar ni Sodom ak Gomor.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Deesatu fa dëkk,","poem":1},{"lineBreak":true},{"text":"xanaa gental ba fàww.","poem":1},{"lineBreak":true},{"text":"Màngaan dootu fa samp xayma,","poem":1},{"lineBreak":true},{"text":"sàmm dootu fa gooral.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ay rabi àll a fay goore,","poem":1},{"lineBreak":true},{"text":"kër ya fees aki looy,","poem":1},{"lineBreak":true},{"text":"bànjóoli dëkke fa,","poem":1},{"lineBreak":true},{"text":"bëyi àll di fa curpee.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bukki mooy sabe fa tata ya,","poem":1},{"lineBreak":true},{"text":"till nangu kër yu bakkane ya.","poem":1},{"lineBreak":true},{"text":"Àppu Babilon jege na, ay fanam du fi wees.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"13.1 Babilon tollu na ay jant yu mu mujj di puukarey xeet yi, ngir dooleem, te moo mujj yóbbu Yuda ngàllo.","reference":{"chapter":13,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}