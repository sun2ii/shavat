{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":15,"content":[{"type":"heading","content":["Ab yéeneb waxyu ñeel na Mowab"]},{"type":"verse","number":1,"content":["Yéene bii ñeel na Mowab:",{"text":"Genn guddi déy la Ar Mowab, dëkk ba tas, ne mes!","poem":1},{"lineBreak":true},{"text":"Genn guddi déy la Kir Mowab tas, ne mes!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nit ñaa ngi yéeg jëm kërug jaamookaay ga ca Dibon,","poem":1},{"text":"ngir jooyi ca bérebi jaamookaay ya,","poem":2},{"text":"Mowab a ngay yuuxoo kaw tundu Nebo ak Medeba,","poem":1},{"lineBreak":true},{"text":"boppoo bopp dib nel,","poem":1},{"lineBreak":true},{"text":"sikkimoo sikkim xuufu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"nit ña sol saaku, di ñaawlu fa mbedd ya,","poem":1},{"lineBreak":true},{"text":"ak kaw taax yaak pénc ya,","poem":1},{"lineBreak":true},{"text":"ku ne di jooy ba say rongooñ wale.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waa Esbon ak Elalee ngi yuuxu,","poem":1},{"lineBreak":true},{"text":"seen baat àkki ba Yaxacc,","poem":1},{"lineBreak":true},{"text":"xarekati Mowab dégg ca, yuuxoo,","poem":1},{"lineBreak":true},{"text":"ne yàcc ne yasar!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maay jooy Mowab jooyi xol,","poem":1},{"lineBreak":true},{"text":"nit ñaa nga fay dawe ba Cowar,","poem":1},{"lineBreak":true},{"text":"àkki ba Eglat Selisiya.","poem":1},{"lineBreak":true},{"text":"Ña ngay yéeg jëm Luxit, di jooyoo,","poem":1},{"lineBreak":true},{"text":"awe yoonu Oronayim, di yuuxu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dexu Nimrim wow na,","poem":1},{"lineBreak":true},{"text":"ñax wow, gàncax lax,","poem":1},{"lineBreak":true},{"text":"dara naatatul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Jël nañu lu ñu deseek lu ñu dencoon,","poem":1},{"lineBreak":true},{"text":"yóbbu, jàll ca wàllaa xuru Garab ya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuux déy maase na réewum Mowab,","poem":1},{"lineBreak":true},{"text":"jooyoo ya ba Eglayim,","poem":1},{"lineBreak":true},{"text":"jooyoo ya ba Beer Elim.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dexu Dimon déy fees na ak deret,","poem":1},{"lineBreak":true},{"text":"te ma nara wàcceel Dimon lu ko raw,","poem":1},{"lineBreak":true},{"text":"ba ku rëcce Mowab,","poem":1},{"lineBreak":true},{"text":"ak ku des ci réew mi, ma booleek gaynde!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}