{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":18,"content":[{"type":"heading","content":["Ab yéeneb waxyu ñeel na réewum Kuus"]},{"type":"verse","number":1,"content":[{"text":"Wóoy ngalla réew ma gunóor yay riire,","poem":1},{"lineBreak":true},{"text":"ca tàkkal dexi réewum Kuus.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yeen ñiy yónni biir géej, ay ndaw,","poem":1},{"lineBreak":true},{"text":"ci gaali barax yu war mbeex mi;","poem":1},{"lineBreak":true},{"text":"yeen ndaw yu gaaw yi, demleen,","poem":1},{"lineBreak":true},{"text":"fekki xeet wu siggi, rattax yaram,","poem":1},{"lineBreak":true},{"text":"askan wu ñu ragale fu jegeek fu sore,","poem":1},{"lineBreak":true},{"text":"xeet wu am doole, di falaxee,","poem":1},{"lineBreak":true},{"text":"te seenum réew defi wal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yeen waa àddina wërngal këpp,","poem":1},{"lineBreak":true},{"text":"yeen ñi dëkke suuf si,","poem":1},{"lineBreak":true},{"text":"séentuleen raaya ba sampe fa tund ya,","poem":1},{"lineBreak":true},{"text":"dégluleen bufta ba ñuy wali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji kat da maa wax ne:","poem":1},{"lineBreak":true},{"text":"«Maa ngi fi ma tollu di xool, ne tekk,","poem":1},{"lineBreak":true},{"text":"ni tàngooru jant bu ne ràññ,","poem":1},{"lineBreak":true},{"text":"mbaa lay bu defu niir ci tàngooru ngóob.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bala ngóob di jot, te fekk lépp tóor,","poem":1},{"lineBreak":true},{"text":"ba tóor-tóor def reseñ ju xaay,","poem":1},{"lineBreak":true},{"text":"mu jël ab sàrt, dog car yu ndaw yi,","poem":1},{"lineBreak":true},{"text":"tenqi car yu mag ya, sànni;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ñu boole waccal njanaawi tund ya","poem":1},{"lineBreak":true},{"text":"ak rabi àll yi,","poem":1},{"lineBreak":true},{"text":"tan yi nawetoo ko,","poem":1},{"lineBreak":true},{"text":"rabi àll yépp nooroo ko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Su boobaa ñu indil Aji Sax ji Boroom gàngoor yi,","poem":1},{"text":"galag bu bawoo ci xeet wu siggi, rattax yaram,","poem":2},{"text":"askan wu ñu ragale fu jegeek fu sore,","poem":1},{"lineBreak":true},{"text":"xeet wu am doole, di falaxee,","poem":1},{"lineBreak":true},{"text":"te seenum réew defi wal,","poem":1},{"lineBreak":true},{"text":"galag ba agsi ba tundu Siyoŋ,","poem":1},{"lineBreak":true},{"text":"fa Aji Sax ji Boroom gàngoori xare yi dëël turam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}