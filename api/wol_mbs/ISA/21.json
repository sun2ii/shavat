{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":21,"content":[{"type":"heading","content":["Ab yéeneb waxyu ñeel na Babilon"]},{"type":"verse","number":1,"content":["Yéene bii moo wàccal màndiŋ ma feggook géej ga:",{"text":"Ni ag ngëlén di riddee jaare Negew,","poem":1},{"lineBreak":true},{"text":"ni la noon di bawoo màndiŋ ma,","poem":1},{"lineBreak":true},{"text":"jóge réew mu raglu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Peeñu mu ñàng lañu ma ci wax.","poem":1},{"lineBreak":true},{"text":"Workat biy wor, yàqkat biy yàq.","poem":1},{"lineBreak":true},{"text":"Yeen waa Elam","poem":1},{"noteId":9},{"text":", songleen; yeen waa Medd, gawleen leen.","poem":1},{"lineBreak":true},{"text":"Dakkal naa mboolem onk yu ñu sabab.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lii a waral sama njàqareg xol,","poem":1},{"lineBreak":true},{"text":"mitit jàpp ma, mel ni mititu mat,","poem":1},{"lineBreak":true},{"text":"ma jaaxle ba déggatuma,","poem":1},{"lineBreak":true},{"text":"jàq ba gisatuma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bopp ubu, tiitaange jàpp ma;","poem":1},{"lineBreak":true},{"text":"sama ngoonug bànneex","poem":1},{"lineBreak":true},{"text":"soppiku guddi gu raglu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndab taaje, laltan lale,","poem":1},{"lineBreak":true},{"text":"ñuy lekk aka naan.","poem":1},{"lineBreak":true},{"text":"Ñu jekki ne: «Yeen kilifa yi, jógleen!","poem":1},{"lineBreak":true},{"text":"Diwleen pakk yi!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boroom bi kat da maa wax, ne ma:","poem":1},{"lineBreak":true},{"text":"«Doxal taxawal ab wattukat,","poem":1},{"lineBreak":true},{"text":"lu mu gis, wax ko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu gisee gawar ci watiiru ñaari fas,","poem":1},{"lineBreak":true},{"text":"ak ñu wari mbaam ak ñu wari giléem,","poem":1},{"lineBreak":true},{"text":"na teewloo teewlu bu baax.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wattukat ba àddu ca kaw ne:","poem":1},{"lineBreak":true},{"text":"«Sang bi, maa ngii yendoo séentu,","poem":1},{"lineBreak":true},{"text":"fanaane wattu fii ma taxaw.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma ne gawar a ngii,","poem":1},{"lineBreak":true},{"text":"war watiiru ñaari fas.","poem":1},{"lineBreak":true},{"text":"Nee: “Daanu nañoo, Babilon daanu na,","poem":1},{"lineBreak":true},{"text":"jëmmi tuuram yépp tasaaroo fi suuf!”»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yeen bokk yi ñu bàcc ni pepp ca sama dàgga ja,","poem":1},{"lineBreak":true},{"text":"la ma dégge ci Aji Sax ji Yàllay Israayil, Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"wax naa leen ko.","poem":1}]},{"type":"heading","content":["Ab yéeneb waxyu ñeel na Duuma"]},{"type":"verse","number":11,"content":["Yéene bii moo wàccal Duuma",{"noteId":10},":",{"text":"Nit a ngi may woowe tundu Seyir, naan:","poem":1},{"lineBreak":true},{"text":"Wattukat bi, lu des ci guddi gi?","poem":1},{"lineBreak":true},{"text":"Éy wattukat bi, lu desati ci guddi gi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wattukat bi ne:","poem":1},{"lineBreak":true},{"text":"«Bët set, mu guddeeti rekk;","poem":1},{"lineBreak":true},{"text":"boo amee looy laaj, délsil laajaat ko.»","poem":1}]},{"type":"heading","content":["Ab yéeneb waxyu ñeel na Arabi"]},{"type":"verse","number":13,"content":["Yéene bii moo wàccal Arabi:",{"text":"Yeen cëggi askanu Dedan","poem":1},{"noteId":11},{"text":",","poem":1},{"lineBreak":true},{"text":"mbooyum Arabi ngeen di fanaane.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yeen waa Tema, dajejileen ak ña mar,","poem":1},{"lineBreak":true},{"text":"yóbbul leen am ndox.","poem":1},{"lineBreak":true},{"text":"Dogileen ñay daw,","poem":1},{"lineBreak":true},{"text":"may leen ñu lekk.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ay saamar de lañuy daw;","poem":1},{"lineBreak":true},{"text":"saamar bu ñu xàcc","poem":1},{"lineBreak":true},{"text":"ak fitt gu ñu leen diir","poem":1},{"lineBreak":true},{"text":"ak tàngooru xare.","poem":1}]},{"type":"verse","number":16,"content":["Aji Sax ji de da maa wax ne ma: «Fileek menn at mu surga bu ñu bind waññ, sagub dëkk bii di Kedar dina sàggiku,"]},{"type":"verse","number":17,"content":["li des ci jàmbaari fittkati Kedar di lu néew.» Aji Sax ji Yàllay Israayil wax na ko."]}],"footnotes":[{"noteId":9,"caller":"+","text":"21.2 Elam, am réew la mu bokkoon ci nguurug Pers, te di ab diiwaan ci réewum Iraan mu jamonoy tey.","reference":{"chapter":21,"verse":2}},{"noteId":10,"caller":"+","text":"21.11 Duuma, ci Arabi la féete, feggook Seyir mbaa Edom. Baat la itam buy tekki «selaw» ci làkku yawut.","reference":{"chapter":21,"verse":11}},{"noteId":11,"caller":"+","text":"21.13 Dedan ak Tema ak Kedar, ay xur la yu waa Arabi dëkke. Seetal it ci aaya 14-17 (21.14-17).","reference":{"chapter":21,"verse":13}}]},"thisChapterLink":"/api/wol_mbs/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}