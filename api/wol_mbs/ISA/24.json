{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"heading","content":["Mbugal daj na àddina"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax jaa ngii di tas àddina,","poem":1},{"lineBreak":true},{"text":"tasaare ko,","poem":1},{"lineBreak":true},{"text":"salfaañe li fi dénd bi,","poem":1},{"lineBreak":true},{"text":"wasaare ñi ko dëkke:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"sarxalkat beek baadoolo bi,","poem":1},{"lineBreak":true},{"text":"sang akub jaam,","poem":1},{"lineBreak":true},{"text":"njaatige lu jigéen ak ab janqam,","poem":1},{"lineBreak":true},{"text":"jaaykat ak jëndkat,","poem":1},{"lineBreak":true},{"text":"ablekat ak àbbkat,","poem":1},{"lineBreak":true},{"text":"leblekat ak lebkat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àddinaa ne duŋŋ duŋŋaaral,","poem":1},{"lineBreak":true},{"text":"dees koo futti ba mu ne furaas!","poem":1},{"lineBreak":true},{"text":"Aji Sax ji kat wax na kàddu gii!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Suuf a ngi wowa wow, ne sereŋ,","poem":1},{"lineBreak":true},{"text":"àddina ne làcc, ne sereŋ,","poem":1},{"lineBreak":true},{"text":"kàngami xeeti àddina ne làcc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Suuf si la ñi ko dëkke sobeel,","poem":1},{"lineBreak":true},{"text":"ñoo wàcc yoon yi,","poem":1},{"lineBreak":true},{"text":"xëtt ndigal,","poem":1},{"lineBreak":true},{"text":"fecci kóllëre gi sax dàkk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo tax alkànde yàq suuf,","poem":1},{"lineBreak":true},{"text":"ñi ko dëkke gàddu àq ji.","poem":1},{"lineBreak":true},{"text":"Moo tax waa àddina raaf,","poem":1},{"lineBreak":true},{"text":"ba ñi des di lu néew.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Biiñ ñàkk na,","poem":1},{"lineBreak":true},{"text":"garabu reseñ lax,","poem":1},{"lineBreak":true},{"text":"bépp xol bu tooyoon, binni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tabala ju xumb selaw na,","poem":1},{"lineBreak":true},{"text":"ña daa xaxaloo dal,","poem":1},{"lineBreak":true},{"text":"mbégtem buumi xalam dakk.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kenn naanatul, di woy,","poem":1},{"lineBreak":true},{"text":"ñoll wex na ka koy naan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dëkk bu gental tasaaroo na,","poem":1},{"lineBreak":true},{"text":"kër yépp tëje, kenn duggul.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mbedd maa ngi soowaloo,","poem":1},{"lineBreak":true},{"text":"ndax biiñ bu ñàkk,","poem":1},{"lineBreak":true},{"text":"gépp mbégte fey,","poem":1},{"lineBreak":true},{"text":"bànneexu àddina dëddu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tojiti neen a des ci dëkk bi,","poem":1},{"lineBreak":true},{"text":"bunt ba rajaxoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Noonu lay deme ci àddina,","poem":1},{"text":"ci biir xeet yi,","poem":2},{"text":"mbete benn-benni doomi oliw gu ñu gësëm,","poem":1},{"lineBreak":true},{"text":"mbaa doomi reseñ yu des ca ndey ja,","poem":1},{"lineBreak":true},{"text":"gannaaw bu ñu wittee ba sottal.","poem":1}]},{"type":"heading","content":["Ndes wi rëcc mbugal a ngi sant"]},{"type":"verse","number":14,"content":[{"text":"Ña ngay xaacu di sarxolle,","poem":1},{"lineBreak":true},{"text":"waa sowu di sàbbaal ci màggug Aji Sax ji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yeen waa penku, sargalleen Aji Sax ji boog,","poem":1},{"lineBreak":true},{"text":"yeen waa duni géej, teralleen Aji Sax ji Yàllay Israayil.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Cati àddina lay woy di jibe, nu dégg ñu naa:","poem":1},{"lineBreak":true},{"text":"«Màggaay ñeel na Aji Jub ji!»","poem":1},"Coono jeexul",{"text":"Waaye man dama ne: «Jeexle naa!","poem":1},{"lineBreak":true},{"text":"Jeexle naa, wóoy man!","poem":1},{"lineBreak":true},{"text":"Workat yaa ngi wor a wor,","poem":1},{"lineBreak":true},{"text":"ba far làggi ci wor.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yeen waa àddina,","poem":1},{"lineBreak":true},{"text":"kat-kat, pax akub caax dëgmal na leen.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nga déggi yuux, daw,","poem":1},{"lineBreak":true},{"text":"tàbbi biir pax,","poem":1},{"lineBreak":true},{"text":"génne pax,","poem":1},{"lineBreak":true},{"text":"laawoob caax.","poem":1},{"lineBreak":true},{"text":"Mbàndi kaw kat ubbi na,","poem":1},{"lineBreak":true},{"text":"suufu àddina di rëŋ-rëŋi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Suuf daa loroo loru,","poem":1},{"lineBreak":true},{"text":"fett a fett,","poem":1},{"lineBreak":true},{"text":"salfaañoo salfaañu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Suuf a ngi jang a jang ni màndikat,","poem":1},{"lineBreak":true},{"text":"ba joy ni mbaar,","poem":1},{"lineBreak":true},{"text":"moyam diis ko gann,","poem":1},{"lineBreak":true},{"text":"mu daanu te du jógati.","poem":1}]},{"type":"heading","content":["Aji Sax jeey nguuru fa Siyoŋ"]},{"type":"verse","number":21,"content":[{"text":"Bu bésub keroogee","poem":1},{"lineBreak":true},{"text":"Aji Sax ji dikke mbugal","poem":1},{"text":"gàngoor ya fa kaw-a-kaw,","poem":2},{"text":"ak buuri àddina yi fi suuf.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dees leen di boole denc cim pax,","poem":1},{"lineBreak":true},{"text":"ne leen ràpp tëj,","poem":1},{"lineBreak":true},{"text":"ba mu am ay fani fan, ñu mbugal leen.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kersa la weer wiy am,","poem":1},{"lineBreak":true},{"text":"gàcce ñeel jant bi;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi daal","poem":1},{"lineBreak":true},{"text":"mooy nguuru Yerusalem, kaw tundu Siyoŋ,","poem":1},{"lineBreak":true},{"text":"leeram ga jollee fa kanam magi ñoñam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}