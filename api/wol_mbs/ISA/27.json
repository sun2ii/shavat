{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":27,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Bésub keroog Aji Sax ji dikke saamaram","poem":1},{"text":"bu jàmbaare, ñàng te réy,","poem":2},{"text":"ba dal ci kaw Lewiyatan, jaan ja ca xél wa,","poem":1},{"lineBreak":true},{"text":"Lewiyatan jaan jay wañaaruy dem,","poem":1},{"lineBreak":true},{"text":"ninki-nankay géej jooju lay rey.","poem":1}]},{"type":"heading","content":["Aji Sax ji juboo naak ñoñam"]},{"type":"verse","number":2,"content":[{"text":"Bésub keroog, tóokëru reseñ ju neex am,","poem":1},{"lineBreak":true},{"text":"nangeen ko woy,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"te man Aji Sax ji maa koy toppatoo,","poem":1},{"lineBreak":true},{"text":"di ko suuxat saa su ne,","poem":1},{"lineBreak":true},{"text":"di ko wattu guddeek bëccëg,","poem":1},{"lineBreak":true},{"text":"bala koo kenn a song.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mereetuma tóokër bii,","poem":1},{"lineBreak":true},{"text":"waaye lu ciy dég aki dagg,","poem":1},{"lineBreak":true},{"text":"ma dox wuti ko, xareek moom,","poem":1},{"lineBreak":true},{"text":"boole lépp xoyom.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xanaa ku langaamoo sama kiiraay","poem":1},{"lineBreak":true},{"text":"te jàmmook man,","poem":1},{"lineBreak":true},{"text":"ba jàmmook man.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ay bés a ngi ñëw Yanqóoba saxi reen,","poem":1},{"lineBreak":true},{"text":"Israayil moomooy tóor, law,","poem":1},{"lineBreak":true},{"text":"ba feesal déndu àddinaak meññeef.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Defe ngeen ne Aji Sax ji duma na Israayil,","poem":1},{"lineBreak":true},{"text":"na mu dumaa ña leen duma woon?","poem":1},{"lineBreak":true},{"text":"Am bóomal na leen lu tollook","poem":1},{"text":"la seeni bóomkat bóomoon?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndànk-ndànk la jëflanteek ñoom,","poem":1},{"lineBreak":true},{"text":"ba mu leen toxalee,","poem":1},{"lineBreak":true},{"text":"dàqe leen noowam gu mag,","poem":1},{"text":"bésu ngelawal penku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nii la Yanqóoba jotoo ñaawtéefam,","poem":1},{"lineBreak":true},{"text":"nii la mujje am njéggalu bàkkaaram:","poem":1},{"lineBreak":true},{"text":"day boole doji sarxalukaay bi yépp,","poem":1},{"lineBreak":true},{"text":"rajaxe ni doji kew,","poem":1},{"lineBreak":true},{"text":"xer wu ñuy jaamoo Asera dootu fa sampe,","poem":1},{"lineBreak":true},{"text":"mbaa sarxalukaayi suurukaay.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dëkk bu ñu dàbbali mooy wéet,","poem":1},{"lineBreak":true},{"text":"gental, ne wëyëŋ!","poem":1},{"lineBreak":true},{"text":"Fa la nag di fore,","poem":1},{"lineBreak":true},{"text":"fa lay goor, di lekk cari garab ya,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"car ya wow, damm,","poem":1},{"lineBreak":true},{"text":"jigéen ñi dikk, xambe.","poem":1},{"lineBreak":true},{"text":"Dañu di xeet wu dul dégg,","poem":1},{"lineBreak":true},{"text":"ba tax ki leen sàkk yërëmu leen,","poem":1},{"lineBreak":true},{"text":"moo leen bind te ñeewantewu leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bésub keroog Aji Sax ji bàcc,","poem":1},{"lineBreak":true},{"text":"dale ca dexu Efraat ba ca walum Misra,","poem":1},{"lineBreak":true},{"text":"te yeen bànni Israayil, dees na leen for","poem":1},{"text":"kenn-kenn, ba ngeen daj.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bésub keroog bufta bu mag jib,","poem":1},{"lineBreak":true},{"text":"ña laŋoon réewum Asiri délsi,","poem":1},{"lineBreak":true},{"text":"ànd ak ña ñu tasaare woon biir réewum Misra,","poem":1},{"lineBreak":true},{"text":"ba sujjóotalsi Aji Sax ji fa Yerusalem,","poem":1},{"lineBreak":true},{"text":"fa kaw tund wu sell wa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}