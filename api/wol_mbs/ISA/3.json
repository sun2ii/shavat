{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":3,"content":[{"type":"heading","content":["Yuda salfaañoo na"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax ji Boroom bi, Aji Sax ju gàngoor yi kat,","poem":1},{"lineBreak":true},{"text":"mu ngi nii di jële Yerusalem ak Yuda,","poem":1},{"lineBreak":true},{"text":"lu doon wéeruwaay, di cëslaay,","poem":1},{"lineBreak":true},{"text":"muy dugub ju ñu yaakaaroon,","poem":1},{"lineBreak":true},{"text":"di ndox mu ñu yaakaaroon","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ak jàmbaar ak ñeyu xare","poem":1},{"lineBreak":true},{"text":"akub àttekat akub yonent","poem":1},{"lineBreak":true},{"text":"ak gisaanekat ak magum pénc","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ak njiitu juróom fukki dag akub kàngam","poem":1},{"lineBreak":true},{"text":"ak kiy xelal buur ak ndaanaanu liggéeykat","poem":1},{"lineBreak":true},{"text":"ak jatkat bu xareñ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Maay def ay gone jiite leen,","poem":1},{"lineBreak":true},{"text":"di ñu yaroo seen sago, yilif leen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nit ñiy soxorante,","poem":1},{"lineBreak":true},{"text":"ku nekk ak moroomam, ku nekk ak dëkkandoom,","poem":1},{"lineBreak":true},{"text":"ndaw di ñàkke mag kersa,","poem":1},{"lineBreak":true},{"text":"sagaru nit sofental boroom daraja.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nit dina ne nikk mbokk ma,","poem":1},{"lineBreak":true},{"text":"ca biir kër baayam, ne ko:","poem":1},{"lineBreak":true},{"text":"“Yaw mi dese mbubb, jiite nu,","poem":1},{"lineBreak":true},{"text":"ba lu bokk ci sunu gent bii, di sa kilifteef.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Keroog kooka àddu ne ko:","poem":1},{"lineBreak":true},{"text":"“Duma leen mana fajal dara!","poem":1},{"lineBreak":true},{"text":"Du dugub, du mbubb fa sama kër,","poem":1},{"lineBreak":true},{"text":"dungeen ma def njiit!”»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yerusalem day téqtalu,","poem":1},{"lineBreak":true},{"text":"Yuda fëlëñu.","poem":1},{"lineBreak":true},{"text":"Ñooy wax aka jëf lu neexul Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di gàntal leeram gi teew.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Seen dëgër bët tuumaal na leen,","poem":1},{"lineBreak":true},{"text":"ñuy bàkkaar ni waa Sodom,","poem":1},{"lineBreak":true},{"text":"làquwuñu sax.","poem":1},{"lineBreak":true},{"text":"Wóoy, ngalla ñoom!","poem":1},{"lineBreak":true},{"text":"nde ñoo lor seen bopp.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Neleen aji jub ji mooy baaxle,","poem":1},{"lineBreak":true},{"text":"mooy yooloo añam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waaye wóoy ku bon, nde mooy bonle;","poem":1},{"lineBreak":true},{"text":"la mu def rekk lees koy def.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bokk yi, ñu xalele ñoo leen di noot,","poem":1},{"lineBreak":true},{"text":"ay jigéen yilif leen.","poem":1},{"lineBreak":true},{"text":"Bokk yi, seeni njiit a ngi leen di sànk,","poem":1},{"lineBreak":true},{"text":"lëndëmal nañu seeni yoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aji Sax jaa ngi ci jataayu layoo,","poem":1},{"lineBreak":true},{"text":"moo jóg di àtte ay xeet.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aji Sax jeey yékkati kàddug sikkaange,","poem":1},{"lineBreak":true},{"text":"jëme ci magi ñoñam ak seeni kàngam.","poem":1},{"lineBreak":true},{"text":"«Yeena sëxëtoo tóokëru reseñ bi,","poem":1},{"lineBreak":true},{"text":"la ñu foqatee ci néew-ji-doolee nga seeni kër.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lu waral ngeen di dëggaate sama ñoñ,","poem":1},{"lineBreak":true},{"text":"nappaaje néew-doole yi?»","poem":1},{"lineBreak":true},{"text":"Kàddug Boroom bee, Aji Sax ji ci gàngoor yi.","poem":1}]},{"type":"heading","content":["Puukare sànk na jigéeni Siyoŋ"]},{"type":"verse","number":16,"content":[{"text":"Aji Sax ji da ne:","poem":1},{"lineBreak":true},{"text":"«Jigéeni Siyoŋ a ngi daŋŋiiral,","poem":1},{"lineBreak":true},{"text":"di goŋeet-goŋeeti,","poem":1},{"lineBreak":true},{"text":"di regejooka rékk-rékkal,","poem":1},{"lineBreak":true},{"text":"sampum ndaag,","poem":1},{"lineBreak":true},{"text":"keleŋal lami wëq.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Moo tax Boroom beey wat jigéeni Siyoŋ nel,","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey muri seen jë.","poem":1}]},{"type":"verse","number":18,"content":["Bésub keroog Boroom bi xañ leen gànjari tànk ak takkaay yu bindoo ni jant ak yu bindoo ni weer wu feeñ"]},{"type":"verse","number":19,"content":["aki loŋ-loŋ aki caq aki muuraay."]},{"type":"verse","number":20,"content":["Moo leen di xañ ay tañlaay ak lami përëg aki ngañaay ak téere yu xeeñ aki gàllaaj,"]},{"type":"verse","number":21,"content":["xañ leen jaaroy torlu ak jaaroy bakkan,"]},{"type":"verse","number":22,"content":["ak mbubbi xew aki mëlfë ak séri càngaay ak saagi loxo,"]},{"type":"verse","number":23,"content":["ba ci yérey sooy ak yérey lẽe aki musóor aki kol."]},{"type":"verse","number":24,"content":[{"text":"Su boobaa lu xasaw wuutu lu xeeñ,","poem":1},{"lineBreak":true},{"text":"buum wuutu ngañaay,","poem":1},{"lineBreak":true},{"text":"nel bu set wuutuy létt,","poem":1},{"lineBreak":true},{"text":"yérey saaku wuutu ndoket bu rafet,","poem":1},{"lineBreak":true},{"text":"toroxte wuutub taar.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yerusalem, say góor ay saamar lañu leen faate,","poem":1},{"lineBreak":true},{"text":"say jàmbaar des xare.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Su boobaa sa bunti dëkk sax di ñaawlooka jooy,","poem":1},{"lineBreak":true},{"text":"mel ni ndaw su ñu futti,","poem":1},{"lineBreak":true},{"text":"mu ne dett fi suuf.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}