{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":32,"content":[{"type":"heading","content":["Dëgg ay mujj"]},{"type":"verse","number":1,"content":[{"text":"Buur a ngii, dëgg lay nguuroo,","poem":1},{"lineBreak":true},{"text":"jawriñ ñi it, yoon lañuy yilifee;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ku ci nekk mel ni seelukaayu ngelaw,","poem":1},{"lineBreak":true},{"text":"di kiiraay ci ngëlén,","poem":1},{"lineBreak":true},{"text":"mel ni wali ndox ci suuf su ne sereŋ,","poem":1},{"lineBreak":true},{"text":"mbaa keppaaru doj wu mag ci àll bu mar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Su boobaa gëti njàccaar yi dootuñu gëmm,","poem":1},{"lineBreak":true},{"text":"te noppi ñiy dégg dañuy teewlu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ku yàkkamti di ràññee, ba mana xam,","poem":1},{"lineBreak":true},{"text":"làmmiñu ku dër gaawa wax lu leer.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Booba deesatul woowe ab dof «gor si»,","poem":1},{"lineBreak":true},{"text":"te njublaŋ dootul dégg «ku tedd ki».","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ab dof, waxi dof lay wax,","poem":1},{"lineBreak":true},{"text":"xel ma di nas ñaawtéef,","poem":1},{"lineBreak":true},{"text":"mu nar jëf ju teddadi.","poem":1},{"lineBreak":true},{"text":"Lu ñaaw lay wax, jëme ci Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di xiifal ku xiif,","poem":1},{"lineBreak":true},{"text":"di xañ ku mar lu mu naan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ab njublaŋ, ay pexeem musiba la.","poem":1},{"lineBreak":true},{"text":"Njekkar lay nas,","poem":1},{"lineBreak":true},{"text":"ba bu néew-ji-doole sàkkoo dëgg it,","poem":1},{"lineBreak":true},{"text":"mu fen ba lor ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Waaye gor si, ngor lay mébét,","poem":1},{"lineBreak":true},{"text":"te ngor lay wéye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yeen jigéen ñi dal xel,","poem":1},{"lineBreak":true},{"text":"taxawleen temm, déglu ma;","poem":1},{"lineBreak":true},{"text":"yeen janq ji féex,","poem":1},{"lineBreak":true},{"text":"teewluleen ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yeen jigéen ñi dal xel,","poem":1},{"lineBreak":true},{"text":"fi leek at aki fan ngeen jàq;","poem":1},{"lineBreak":true},{"text":"witt mi du baax, ngóob du taxaw.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jigéen ñi dal xel, ragalleen;","poem":1},{"lineBreak":true},{"text":"yeen ñi féex laa ne, tiitleen!","poem":1},{"lineBreak":true},{"text":"Futtikuleen, ba ne duŋŋ;","poem":1},{"lineBreak":true},{"text":"gembooy saaku, ñaawloo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fëggleen seen dënn,","poem":1},{"lineBreak":true},{"text":"jooy tooli bànneex ya,","poem":1},{"lineBreak":true},{"text":"jooyleen reseñ ju nangu ja,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ak sama suufas bokk ya ay dég aki dagg nangu.","poem":1},{"lineBreak":true},{"text":"Jooyleen kay kër ya ca mbégte ma,","poem":1},{"lineBreak":true},{"text":"ak dëkk bu xumb ba.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kër gu rafet sax, dees koy wacc,","poem":1},{"lineBreak":true},{"text":"dëkk baak riiram, dees koy dëddu;","poem":1},{"lineBreak":true},{"text":"tund ak tóoju doon ay xunt ba fàww,","poem":1},{"lineBreak":true},{"text":"mbaamu àll ne ca finaax, jur ga di ca fore,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ba keroog Boroom bi ëf ci nun ag noowam,","poem":1},{"lineBreak":true},{"text":"màndiŋ mi soppalikub tóokër,","poem":1},{"lineBreak":true},{"text":"tóokër meññ, ba ñu ne ab gott la.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Su boobaa yoon dëkke màndiŋ mi,","poem":1},{"lineBreak":true},{"text":"dëgg tooge tóokër bi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Su boobaa àtteb dëgg ay jur jàmm,","poem":1},{"lineBreak":true},{"text":"àtteb yoon di dalal tey aare ba fàww,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ba sama bokk yi dëkke sancub jàmm,","poem":1},{"lineBreak":true},{"text":"ci dëkkuwaay yu wóor,","poem":1},{"lineBreak":true},{"text":"ci dalluwaay yu dal xel,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"doonte gott bi day daanu ci tawub doji yuur,","poem":1},{"lineBreak":true},{"text":"dëkk bi detteelu ba ne dett.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Waaye ndokkalee yeen ñi tala ji fépp fuy ndox","poem":1},{"lineBreak":true},{"text":"te saña afal nag ak mbaam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}