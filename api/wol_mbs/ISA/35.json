{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":35,"content":[{"type":"heading","content":["Yoonu ñibbi Siyoŋ taxaw na"]},{"type":"verse","number":1,"content":[{"text":"Màndiŋ ak suuf su ne sereŋ dina bég,","poem":1},{"lineBreak":true},{"text":"joor gu wow bànneexu, tóor ba ne ràññ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Day tóor a tóor,","poem":1},{"lineBreak":true},{"text":"di bànneexu, bay sarxolle,","poem":1},{"lineBreak":true},{"text":"ba jagoo darajay gottub Libaŋ","poem":1},{"lineBreak":true},{"text":"ak taaru àllub Karmel ak Saron.","poem":1},{"lineBreak":true},{"text":"Foofa lees di gise darajay Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sunu taaru Yàlla.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ku yoqi, dooleelleen ko,","poem":1},{"lineBreak":true},{"text":"ku óom yay fenqe, jàppaleleen ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ku fitam rëcc, ne leen ko:","poem":1},{"lineBreak":true},{"text":"«Dëgërlul te bul tiit.","poem":1},{"lineBreak":true},{"text":"Sa Yàllaa ngii di la feyul,","poem":1},{"lineBreak":true},{"text":"ba yool say noon.","poem":1},{"lineBreak":true},{"text":"Moom mooy dikk, wallusi la.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Su boobaa gëti silmaxa muriku,","poem":1},{"lineBreak":true},{"text":"noppi tëx sikkliku.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Su boobaa ab làggi ne jàyy ni kéwél,","poem":1},{"lineBreak":true},{"text":"ab luu sarxolle.","poem":1},{"lineBreak":true},{"text":"Am ndox ay fettaxe màndiŋ ma,","poem":1},{"lineBreak":true},{"text":"ay wal wale joor gu wow,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"suuf su wow doonub déeg,","poem":1},{"lineBreak":true},{"text":"joor gu maral ballal bëti ndox.","poem":1},{"lineBreak":true},{"text":"Fa till fàkkoon, di fa goore,","poem":1},{"lineBreak":true},{"text":"gattax ak barax a fay sëqe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Foofa law yoon di jaare,","poem":1},{"lineBreak":true},{"text":"ñu di ko woowe Yoon wu sell wi.","poem":1},{"lineBreak":true},{"text":"Ku sobewu du fa jaare,","poem":1},{"lineBreak":true},{"text":"ñi moom woowu yoon,","poem":1},{"lineBreak":true},{"text":"ñooy ñi koy topp.","poem":1},{"lineBreak":true},{"text":"Ab dof sax du fa lajje.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gaynde du fa am,","poem":1},{"lineBreak":true},{"text":"rab wu aay du fa dox,","poem":1},{"lineBreak":true},{"text":"du lenn lees fay gis,","poem":1},{"lineBreak":true},{"text":"ku ñu jot rekk a fay jaare.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñi Aji Sax ji goreel, nii lañuy dellusee,","poem":1},{"lineBreak":true},{"text":"agsaaley sarxolle fa Siyoŋ,","poem":1},{"lineBreak":true},{"text":"kaalawoo mbég mu sax,","poem":1},{"lineBreak":true},{"text":"mbégteek bànneex wàllsi,","poem":1},{"lineBreak":true},{"text":"naqar aku tiis daw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}