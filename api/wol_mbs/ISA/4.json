{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Su bés baa, juróom ñaari jigéen ŋoyaalu genn góor, ne ko:","poem":1},{"lineBreak":true},{"text":"«Sunub dund, nun a,","poem":1},{"lineBreak":true},{"text":"sunu koddaay, nun a!","poem":1},{"lineBreak":true},{"text":"Jox nu sag buum rekk,","poem":1},{"lineBreak":true},{"text":"teggil nu gàcce.»","poem":1}]},{"type":"heading","content":["Aji Sax ji aar na ndesu Yerusalem"]},{"type":"verse","number":2,"content":[{"text":"Su bés baa njebbitum Aji Sax ji","poem":1},{"lineBreak":true},{"text":"doon lu yànj, darajawu,","poem":1},{"lineBreak":true},{"text":"meññeefum réew mi di teraanga, dib sag,","poem":1},{"lineBreak":true},{"text":"ñeel ñi dese bakkan fi Israayil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Su boobaa ku mucc fa Siyoŋ","poem":1},{"lineBreak":true},{"text":"ak ku des fa Yerusalem,","poem":1},{"lineBreak":true},{"text":"ku sell ki lees lay woowe,","poem":1},{"lineBreak":true},{"text":"muy képp ku ñu bind turam,","poem":1},{"lineBreak":true},{"text":"te mu wara dese bakkan ci Yerusalem.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boroom beey wal noowal mbugal,","poem":1},{"lineBreak":true},{"text":"noo guy lakk, sellal,","poem":1},{"lineBreak":true},{"text":"fóote ko jonkani jigéeni Siyoŋ,","poem":1},{"lineBreak":true},{"text":"fetee ko deret ji ci Yerusalem, ba mu set.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Su boobaa tundu Siyoŋ bépp,","poem":1},{"lineBreak":true},{"text":"fépp fu ñuy dajee,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji sàkk fa niiru saxaar bëccëg,","poem":1},{"lineBreak":true},{"text":"guddi mu def tàkk-tàkk bu ne ràññ;","poem":1},{"lineBreak":true},{"text":"leeru Aji Sax ji di kiiraay, tiim lépp,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"di mbaar mu ñuy féexloo tàngooru bëccëg,","poem":1},{"lineBreak":true},{"text":"di ko seeloob taw ak waame.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}