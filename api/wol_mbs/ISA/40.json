{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":40,"content":[{"type":"heading","content":["Xibaaru jàmm ñeel na Israayil"]},{"type":"verse","number":1,"content":[{"text":"Dëfalleen a dëfal sama ñoñ,","poem":1},{"lineBreak":true},{"text":"la seen Yàlla wax!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waxleen lu dalal xelu Yerusalem, yéeneleen","poem":1},{"lineBreak":true},{"text":"ne leen seen xare jeex na,","poem":1},{"lineBreak":true},{"text":"seen mbugal mat na.","poem":1},{"lineBreak":true},{"text":"Ñoo nangoo ci loxol Aji Sax ji","poem":1},{"lineBreak":true},{"text":"lu fey ñaari yoon seen bépp bàkkaar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Baat a ngi jib, naan:","poem":1},{"text":"«Nangeen xàll yoonu Aji Sax ji ci màndiŋ mi,","poem":2},{"text":"fàkkalleen sunu Yàlla","poem":1},{"lineBreak":true},{"text":"xàll wu jub fi joor gi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wépp xur lees di kaweel,","poem":1},{"lineBreak":true},{"text":"tund wu mag ak wu ndaw lees di suufeel;","poem":1},{"lineBreak":true},{"text":"ba fu tunde mujj dig joor,","poem":1},{"lineBreak":true},{"text":"fu ñagasoon maase,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"darajay Aji Sax ji daldi feeñ,","poem":1},{"lineBreak":true},{"text":"àddina sépp bokk gis ko.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee ko wax ci làmmiñam.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Baat a ngi naa: «Yéeneel!»","poem":1},{"lineBreak":true},{"text":"Ma ne: «Lu may yéene?»","poem":1},{"lineBreak":true},{"text":"Mu ne: «Neel:","poem":1},{"lineBreak":true},{"text":"Nit am ñax doŋŋ la;","poem":1},{"lineBreak":true},{"text":"gépp ngoram mel ni tóor-tóoru àll.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñax ma wow,","poem":1},{"lineBreak":true},{"text":"tóor-tóor ma lax","poem":1},{"lineBreak":true},{"text":"fa ko Aji Sax ji yónnee mbóoyo.","poem":1},{"lineBreak":true},{"text":"Askan wi kay, am ñax doŋŋ la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Am ñax day wow;","poem":1},{"lineBreak":true},{"text":"tóor-tóor day lax.","poem":1},{"lineBreak":true},{"text":"Waaye sunu kàddug Yàlla","poem":1},{"text":"mooy sax ba fàww.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaw Siyoŋ, xibaarkatu jàmm bi,","poem":1},{"lineBreak":true},{"text":"doxal yéegi tund wu kawe,","poem":1},{"lineBreak":true},{"text":"te xaacook doole.","poem":1},{"lineBreak":true},{"text":"Yaw Yerusalem, xibaarkatu jàmm bi,","poem":1},{"lineBreak":true},{"text":"xaacul te bul ragal!","poem":1},{"lineBreak":true},{"text":"Neel dëkki Yuda yi:","poem":1},{"lineBreak":true},{"text":"«Seen Yàllaa ngii!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Boroom bi, Aji Sax jaa ngii,","poem":1},{"lineBreak":true},{"text":"dikkaale doole","poem":1},{"lineBreak":true},{"text":"ak kàttanu kilifteefam.","poem":1},{"lineBreak":true},{"text":"Mu ngii ànd ak ñi mu yooloo,","poem":1},{"lineBreak":true},{"text":"ñu dig peyam, dox jiitu ko.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mooy sàmm géttam bii ni kuy sàmmug juram,","poem":1},{"lineBreak":true},{"text":"boole mbote yi cib loxoom,","poem":1},{"lineBreak":true},{"text":"taf cib dënnam, yóbbu;","poem":1},{"lineBreak":true},{"text":"xar yiy nàmpal, mu wommat.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ana ku natte géej biir loxoom?","poem":1},{"lineBreak":true},{"text":"Ku xaymaa asamaan yaatuwaayu loxo?","poem":1},{"lineBreak":true},{"text":"Ku mana fab suuf sépp, sol cib nattukaay?","poem":1},{"lineBreak":true},{"text":"Ana ku natte ab màndaxekaay tund wu mag?","poem":1},{"lineBreak":true},{"text":"Mbaa mu tam-tamal tund wu ndaw?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ana ku mana nànd xelum Aji Sax ji?","poem":1},{"lineBreak":true},{"text":"Mbaa nga dib xejjam, ba di ko digal?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ana ku mu diisool, ba kooka tegtal ko,","poem":1},{"lineBreak":true},{"text":"jàngal ko yoonu njub,","poem":1},{"lineBreak":true},{"text":"jàngal ko xam-xam,","poem":1},{"lineBreak":true},{"text":"xamal ko yoonu dég-dég?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xeet yaa ngii, mel ni aw toq ci biir bagaan,","poem":1},{"lineBreak":true},{"text":"jàppeesu leen lu moy diisaayu feppu suuf!","poem":1},{"lineBreak":true},{"text":"Dun yi lay yékkati ni pëndub suuf!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gottub Libaŋ xambul taalu sarxalukaayam,","poem":1},{"lineBreak":true},{"text":"te mala ya ca ne doyu ko saraxu rendi-dóomal!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xeetoo xeet du tus fi kanamam,","poem":1},{"lineBreak":true},{"text":"te jàppewu leen lu moy neenug neen.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ana kan ngeen di niruleek Yàlla,","poem":1},{"lineBreak":true},{"text":"ak nataal bu ngeen koy dendaleel?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Xanaa du jëmmu tuur ju liggéeykat móol,","poem":1},{"lineBreak":true},{"text":"ab tëgg xoobe ko wurus,","poem":1},{"lineBreak":true},{"text":"takk ca caqi xaalis?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ku néewle ba amul may gu ni tollu,","poem":1},{"lineBreak":true},{"text":"mooy tànn bant bu dul nëb,","poem":1},{"lineBreak":true},{"text":"seeti liggéeykat bu xareñ","poem":1},{"lineBreak":true},{"text":"bu ko ci sàkkal jëmmu tuur ju dëgër!","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Xanaa dangeena xamul lii?","poem":1},{"lineBreak":true},{"text":"Am dangeena déggul lii?","poem":1},{"lineBreak":true},{"text":"Dees leena waxul ca njàlbéen,","poem":1},{"lineBreak":true},{"text":"am seen xel a jàppul nan la àddina sosoo?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Moom moo tooge ca kaw wërngalu suuf,","poem":1},{"lineBreak":true},{"text":"ñi ko dëkke mel niy soccet,","poem":1},{"lineBreak":true},{"text":"moo tàllal asamaan ni ndimo,","poem":1},{"lineBreak":true},{"text":"firi ko nib xayma, daldi dëkke.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mooy sànk kilifa,","poem":1},{"lineBreak":true},{"text":"di neenal njiitu àddina.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ba ñu sampoogul,","poem":1},{"lineBreak":true},{"text":"toogaguñu sax,","poem":1},{"lineBreak":true},{"text":"ba seeni reen di riigu,","poem":1},{"lineBreak":true},{"text":"ca la leen Aji Sax jiy wal, ñu wow,","poem":1},{"lineBreak":true},{"text":"ngëlén buub, yóbbu ni boob.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aji Sell ji ne:","poem":1},{"lineBreak":true},{"text":"«Ana ku ngeen may nirooleel,","poem":1},{"lineBreak":true},{"text":"ba may moroomam?»","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Séentuleen kaw, xoolleen Ki sàkk biddiiw yii!","poem":1},{"lineBreak":true},{"text":"Xanaa kiy daaguloo leeri asamaan ni gàngoor gu mat,","poem":1},{"lineBreak":true},{"text":"ñoom ñépp lay woo ci seen tur,","poem":1},{"lineBreak":true},{"text":"ci kawewaayu dooleem ak màggaayu kàttanam,","poem":1},{"lineBreak":true},{"text":"te kenn du ci wuute.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yeen askanu Yanqóoba, lu ngeen di jàmbat?","poem":1},{"lineBreak":true},{"text":"Yeen Israayil laa ne, lu ngeen di jooy,","poem":1},{"lineBreak":true},{"text":"naa: «Aji Sax ji gisul li nu dal,","poem":1},{"lineBreak":true},{"text":"sunu Yàlla daal, daa réere sunu àq!»","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Dangeena xamul,","poem":1},{"lineBreak":true},{"text":"am dangeena déggul","poem":1},{"lineBreak":true},{"text":"ne Aji Sax jeey Yàlla ba fàww,","poem":1},{"lineBreak":true},{"text":"sàkk suuf cat ba cat,","poem":1},{"lineBreak":true},{"text":"du sonn, du tàyyi,","poem":1},{"lineBreak":true},{"text":"te am xelam nattuwul?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mooy dooleel ku loof,","poem":1},{"lineBreak":true},{"text":"di kàttanal ku jeele.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Waxambaane sonn, loof;","poem":1},{"lineBreak":true},{"text":"xalelu góor di tërëf a tërëf,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"kiy yaakaar Aji Sax ji moom, di yeeslu doole;","poem":1},{"lineBreak":true},{"text":"da naa fëyy ni jaxaay juy naaw,","poem":1},{"lineBreak":true},{"text":"di xélu te du xiix,","poem":1},{"lineBreak":true},{"text":"di dox te du xoox.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}