{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":43,"content":[{"type":"heading","content":["Jotkatub Israayil kenn la"]},{"type":"verse","number":1,"content":[{"text":"Léegi nag yaw Yanqóoba,","poem":1},{"lineBreak":true},{"text":"yaw Israayil mii,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji la sàkk tabax la, dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Bul tiit, jot naa la.","poem":1},{"lineBreak":true},{"text":"Dama laa woo ci sa tur.","poem":1},{"lineBreak":true},{"text":"Maa la séddoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Booy xuus cim ndox,","poem":1},{"lineBreak":true},{"text":"maa ngi ànd ak yaw;","poem":1},{"lineBreak":true},{"text":"ag dex du la mëdd.","poem":1},{"lineBreak":true},{"text":"Booy dox cib taal, doo lakk,","poem":1},{"lineBreak":true},{"text":"sawara du la xoyom.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Man Aji Sax ji, maay sa Yàlla;","poem":1},{"lineBreak":true},{"text":"man Aji Sell ju Israayil,","poem":1},{"lineBreak":true},{"text":"maa lay musal.","poem":1},{"lineBreak":true},{"text":"Maa joxe Misra, feye la;","poem":1},{"lineBreak":true},{"text":"ak Kuus ak Saba, ma weccikoo la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fonk la, teral la ak sopp la,","poem":1},{"lineBreak":true},{"text":"moo tax ma joxey nit, weccikoo la;","poem":1},{"lineBreak":true},{"text":"ay askan dee, wuutu sa bakkan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bul tiit, yaw laa àndal,","poem":1},{"lineBreak":true},{"text":"maay jële saw askan penku,","poem":1},{"lineBreak":true},{"text":"dajalee leen sowub jant.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa naa bëj-gànnaar: “Bàyyi leen!”","poem":1},{"lineBreak":true},{"text":"ne bëj-saalum: “Bu leen téye!”","poem":1},{"lineBreak":true},{"text":"Jëleel sama doom yu góor fu sore, delloosi,","poem":1},{"lineBreak":true},{"text":"te jëleji sama doom yu jigéen fa cati àddina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Delloosil képp ku ñu ma tudde,","poem":1},{"lineBreak":true},{"text":"te ma sàkk leen ngir ñu màggal ma,","poem":1},{"lineBreak":true},{"text":"tabax leen, sottal leen.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Indileen ñii diy silmaxa te ami gët;","poem":1},{"lineBreak":true},{"text":"tëx te ami nopp.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na xeet yépp daje,","poem":1},{"lineBreak":true},{"text":"askan yépp teewandoo.","poem":1},{"lineBreak":true},{"text":"Ana ku nu ci yégaloon lii xew,","poem":1},{"lineBreak":true},{"text":"mbaa mu xamal nu la wees?","poem":1},{"lineBreak":true},{"text":"Na seen seede teew, dëggal leen;","poem":1},{"lineBreak":true},{"text":"ba ñu dégg leen, ne noonu la.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"«Yeen sama ñoñ, yeenay samay seede.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee.","poem":1},{"lineBreak":true},{"text":"«Yeenay sama jaam bi ma tànn,","poem":1},{"lineBreak":true},{"text":"ngir ngeen xam, ba gëm ma,","poem":1},{"lineBreak":true},{"text":"ba ràññee ne maay moom.","poem":1},{"lineBreak":true},{"text":"Sàkkeesul yàlla ju ma jiitu,","poem":1},{"lineBreak":true},{"text":"mbaa ju may wuutuji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aji Sax ji, mennum man a;","poem":1},{"lineBreak":true},{"text":"amul jotkat bu ma moy.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Maay dogal texe, sottal ko, biral ko,","poem":1},{"lineBreak":true},{"text":"ba tuuru doxandéem nekkagul seen biir.","poem":1},{"lineBreak":true},{"text":"Yeen nag, yeenay samay seede.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee.","poem":1},{"lineBreak":true},{"text":"«Man maay Yàlla,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"maa masa doon kenn ki,","poem":1},{"lineBreak":true},{"text":"te sama loxo, maneesu cee musle.","poem":1},{"lineBreak":true},{"text":"Su ma defee, kuy dindi?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aji Sax jiy seen jotkat,","poem":1},{"lineBreak":true},{"text":"Aji Sell ju Israayil dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Yeena tax ma yebal ku songsi Babilon,","poem":1},{"lineBreak":true},{"text":"ba dàjji lu fay tëjukaay,","poem":1},{"lineBreak":true},{"text":"ba xaxalooy Kaldeen ñooñu diy jooyoo","poem":1},{"noteId":28},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Maay Aji Sax ji, seen Ku sell ki;","poem":1},{"lineBreak":true},{"text":"maa sàkk Israayil, di seen buur.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aji Sax ji dafa wax,","poem":1},{"lineBreak":true},{"text":"moom mi sàkk yoon biir géej,","poem":1},{"lineBreak":true},{"text":"rëddu xàll, digg mbeex mu ne xéew;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"xabtal watiiri xare aki fas,","poem":1},{"lineBreak":true},{"text":"ak gàngooru ñeyi xare,","poem":1},{"lineBreak":true},{"text":"ñu bokk tëdd, jógatuñu,","poem":1},{"lineBreak":true},{"text":"xanaa fey kamaj nib làmp.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mu ne: «Buleen geesu la woon,","poem":1},{"lineBreak":true},{"text":"buleen seet ca la wees.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Maa ngii di def lu yees,","poem":1},{"lineBreak":true},{"text":"te mu ngii di feeñ xaat!","poem":1},{"lineBreak":true},{"text":"Ràññeewuleen koo?","poem":1},{"lineBreak":true},{"text":"Biir màndiŋ mi kay laay xàllu yoon;","poem":1},{"lineBreak":true},{"text":"fa ne sereŋ, ma walal ay dex;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ndundati àll bi di ma sàbbaal,","poem":1},{"text":"ñook njabootug bànjóoli,","poem":2},{"text":"nde maa mayem ndox fi màndiŋ mi,","poem":1},{"lineBreak":true},{"text":"dex ya wale fu noon sereŋ,","poem":1},{"lineBreak":true},{"text":"ma nàndale sama ñoñ, sama tànnéef,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"xeet wii ma bindal sama bopp,","poem":1},{"lineBreak":true},{"text":"te ñooy siiwal sama woy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Moona Yanqóoba, woowuloo ma,","poem":1},{"lineBreak":true},{"text":"yaw Israayil laa ne, sàppi naa la.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Du xar mu ndaw moo ma defal saraxu rendi-dóomal,","poem":1},{"lineBreak":true},{"text":"mbaa sarax yoo ma terale,","poem":1},{"lineBreak":true},{"text":"te du sarax su ma la teg it,","poem":1},{"lineBreak":true},{"text":"mbaa saraxu cuuraay bu ma la sonale.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Du xaalis boo ma jëndale barax bu xeeñ,","poem":1},{"lineBreak":true},{"text":"du nebbonu sarax boo ma reggale.","poem":1},{"lineBreak":true},{"text":"Xanaa lakkal maak say bàkkaar,","poem":1},{"lineBreak":true},{"text":"sonal maak say ñaawtéef.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mennum man mii maay far say moy ngir man,","poem":1},{"lineBreak":true},{"text":"ba dootuma fàttaliku bàkkaar.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fàttali ma saw lay, nu bokk layoo;","poem":1},{"lineBreak":true},{"text":"waxal boog yaw, ndax nga yey!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sa maam a njëkka bàkkaar,","poem":1},{"lineBreak":true},{"text":"ñi lay teewal teg ca gàntal ma,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ba tax ma sobeel kilifay kër gu sell gi,","poem":1},{"lineBreak":true},{"text":"sànk Yanqóoba,","poem":1},{"lineBreak":true},{"text":"wacce Israayil ŋàññi noon.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"43.14 Li ñu wax fii ci làkku ebrë am na werante.","reference":{"chapter":43,"verse":14}}]},"thisChapterLink":"/api/wol_mbs/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}