{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":44,"content":[{"type":"heading","content":["Aji Sax jee mat cëslaay"]},{"type":"verse","number":1,"content":[{"text":"«Yaw Yanqóoba, sama jaam bi, déglul boog,","poem":1},{"lineBreak":true},{"text":"yaw Israayil sama tànnéef laa wax.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax ji dafa wax, moom mi la sàkk,","poem":1},{"lineBreak":true},{"text":"mooñ la fa sa biiru ndey,","poem":1},{"lineBreak":true},{"text":"di la dimbali.","poem":1},{"lineBreak":true},{"text":"Ma ne: Yaw Yanqóoba sama jaam bi,","poem":1},{"lineBreak":true},{"text":"yaw Yesurun","poem":1},{"noteId":29},{"text":"sama tànnéef laa wax,","poem":1},{"lineBreak":true},{"text":"bul tiit.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maay sottim ndox suuf su mar,","poem":1},{"lineBreak":true},{"text":"ak wal yu waleg joor gu wow.","poem":1},{"lineBreak":true},{"text":"Maay sotti saw askan samag noo,","poem":1},{"lineBreak":true},{"text":"sama barke sottikul ñi nga meññ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ñu màgg ni garabu saab-saab,","poem":1},{"lineBreak":true},{"text":"nirook garab yu mag yu feggook ndox.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kii nee: “Aji Sax jee ma moom.”","poem":1},{"lineBreak":true},{"text":"Kee di tuddoo turu Yanqóoba,","poem":1},{"lineBreak":true},{"text":"kale bind ca loxo ba: “Maa ñeel Aji Sax ji”","poem":1},{"lineBreak":true},{"text":"tey wuyoo turu Israayil.»","poem":1}]},{"type":"heading","content":["Aji Sax ji dëkk na yàllantu yi"]},{"type":"verse","number":6,"content":[{"text":"Aji Sax ji dafa wax,","poem":1},{"lineBreak":true},{"text":"moom buurub Israayil, jotkatam,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"mu ne: «Maa njëkk, maa mujj,","poem":1},{"lineBreak":true},{"text":"te Yàlla amul ndare man.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ana ku mel ni man? Na àddu!","poem":1},{"lineBreak":true},{"text":"Na biral firndeem te taajal ma","poem":1},{"text":"la amoon ba may sos xeet wu yàgg wa,","poem":2},{"text":"ak li dikkagul.","poem":1},{"lineBreak":true},{"text":"Na ko wax!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buleen tiit, buleen ragal.","poem":1},{"lineBreak":true},{"text":"Dama leena biralul lii bu yàgg, yégal leen ko?","poem":1},{"lineBreak":true},{"text":"Yeenay samay seede.","poem":1},{"lineBreak":true},{"text":"Yàlla daa am ju ma moy?","poem":1},{"lineBreak":true},{"text":"Cëslaay amul, xawma ci kenn!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Képp kuy tabax jëmmi tuur, doo tus,","poem":1},{"lineBreak":true},{"text":"xërëm yooyu ñu safoo amul njariñ.","poem":1},{"lineBreak":true},{"text":"Ñooñu ñu defi seede","poem":1},{"lineBreak":true},{"text":"te gisuñu, yéguñu,","poem":1},{"lineBreak":true},{"text":"muy seen gàcce!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sàkk sam tuur,","poem":1},{"lineBreak":true},{"text":"móol sa jëmmu tuur,","poem":1},{"lineBreak":true},{"text":"te jariñu la tus!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Képp ku ca bokk","poem":1},{"lineBreak":true},{"text":"sa gàcce lay doon,","poem":1},{"lineBreak":true},{"text":"ña koy yatt sax ay nit doŋŋ lañu.","poem":1},{"lineBreak":true},{"text":"Nañu daje ñoom ñépp, taxaw,","poem":1},{"lineBreak":true},{"text":"bokk tiitaangeek gàcce.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ab tëgg jël jumtukaayam,","poem":1},{"lineBreak":true},{"text":"liggéey weñ ca taal ba,","poem":1},{"lineBreak":true},{"text":"wàkk a wàkk, jëmmal;","poem":1},{"lineBreak":true},{"text":"def ci kem kàttanam,","poem":1},{"lineBreak":true},{"text":"teg ca xiif, doole jeex,","poem":1},{"lineBreak":true},{"text":"naanul it ba tax mu loof.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Liggéeykatu bant tàllal buumu nattukaay,","poem":1},{"lineBreak":true},{"text":"jël kew, nataale,","poem":1},{"lineBreak":true},{"text":"xacc, rëdde rëddukaayu wërngal,","poem":1},{"lineBreak":true},{"text":"jox ko bindu nit,","poem":1},{"lineBreak":true},{"text":"jekkal ba mu mel ni nit,","poem":1},{"lineBreak":true},{"text":"nar koo fat cib néeg,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ba tax mu gor garabi seedar,","poem":1},{"lineBreak":true},{"text":"sàkk banti sippar ak yu ni mel,","poem":1},{"lineBreak":true},{"text":"tànn ci garabi gott bi,","poem":1},{"lineBreak":true},{"text":"mbaa mu jëmbat garab yu dëkke naat,","poem":1},{"lineBreak":true},{"text":"ab taw màggal,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"nit xambe, sàkk ci, jaaroo;","poem":1},{"lineBreak":true},{"text":"taal, lakke mburu;","poem":1},{"lineBreak":true},{"text":"sàkkaale ci jëmmu tuur, sujjóotal ko,","poem":1},{"lineBreak":true},{"text":"muy jëmm ju mu defar, di ko sukkal;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"xaaju matt ma lay taal,","poem":1},{"lineBreak":true},{"text":"toggew yàppam, lekk,","poem":1},{"lineBreak":true},{"text":"wàjj, xéewloo ba suur,","poem":1},{"lineBreak":true},{"text":"jaaruwaale te naan:","poem":1},{"lineBreak":true},{"text":"«Mii njaar mu neex!","poem":1},{"lineBreak":true},{"text":"bii tàkk-tàkk bu yànj!»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ndesu matt ma lay sàkke jëmmu tuuram,","poem":1},{"lineBreak":true},{"text":"sukkal ko,","poem":1},{"lineBreak":true},{"text":"sujjóotal ko, ñaan ko, naa:","poem":1},{"lineBreak":true},{"text":"«Yaay sama Yàlla, xettali ma!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ñii xamuñu, xàmmeewuñu,","poem":1},{"lineBreak":true},{"text":"seeni gët lañu lëndëmal, ba gisatuñu;","poem":1},{"lineBreak":true},{"text":"fatt seenum xel, ba xelootuñu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ku mel nii du delloosim xelam,","poem":1},{"lineBreak":true},{"text":"ba xam, ràññee ne:","poem":1},{"lineBreak":true},{"text":"«Xaaju matt mi laa taal,","poem":1},{"lineBreak":true},{"text":"lakke mburu,","poem":1},{"lineBreak":true},{"text":"wàjje yàpp, lekk;","poem":1},{"lineBreak":true},{"text":"mu des, ma di ko sàkke lu seexluwu lii?","poem":1},{"lineBreak":true},{"text":"Ab dogu bant laay sukkal?»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kee di jur gu dunde dóomu-taal,","poem":1},{"lineBreak":true},{"text":"xelam nax ko, sànk ko.","poem":1},{"lineBreak":true},{"text":"Du keey musal bakkanam de!","poem":1},{"lineBreak":true},{"text":"Du kee naa: «Xanaa duy caaxaan laa yore nii?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Aji Sax ji nee: «Yanqóoba, baal xel ci lii!","poem":1},{"lineBreak":true},{"text":"Ma ne Israayil, fàttalikul, yaa di sama jaam!","poem":1},{"lineBreak":true},{"text":"Ma bind la, ngay sama jaam,","poem":1},{"lineBreak":true},{"text":"yaw Israayil, duma la fàtte!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Maa far say moy, mu naaxsaay niw niir,","poem":1},{"lineBreak":true},{"text":"say bàkkaar ne mes nib lay.","poem":1},{"lineBreak":true},{"text":"Délsil fi man, jot naa la.»","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Asamaan, sarxolleel, Aji Sax ji dikk na!","poem":1},{"lineBreak":true},{"text":"Yeen xóotey suuf, xaaculeen!","poem":1},{"lineBreak":true},{"text":"Yeen tund yi, neleen réllet, sarxolleendoo,","poem":1},{"lineBreak":true},{"text":"ak yaw gott beek sa bépp garab!","poem":1},{"lineBreak":true},{"text":"Aji Sax jee jot Yanqóoba,","poem":1},{"lineBreak":true},{"text":"te moom Israayil lay fésale darajaam.","poem":1}]},{"type":"heading","content":["Dees na dëkkewaat Yerusalem"]},{"type":"verse","number":24,"content":[{"text":"Aji Sax ji sa jotkat dafa wax,","poem":1},{"lineBreak":true},{"text":"moom mi la bind ba ngay sosu,","poem":1},{"lineBreak":true},{"text":"ne: «Man maay Aji Sax ji sàkk lépp.","poem":1},{"lineBreak":true},{"text":"Man doŋŋ maa tàllal asamaan,","poem":1},{"lineBreak":true},{"text":"lal suuf, kenn wéttaliwu ma ca.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Maay neenal firndey maaman,","poem":1},{"lineBreak":true},{"text":"dofloo gisaanekat.","poem":1},{"lineBreak":true},{"text":"Maay weddi boroom xel mu rafet,","poem":1},{"lineBreak":true},{"text":"def xam-xamam mu dig ndof.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Maay dëggal sama kàddug jaam,","poem":1},{"lineBreak":true},{"text":"di sottal sama ndéeyal ndaw.","poem":1},{"lineBreak":true},{"text":"Maa naan ci Yerusalem:","poem":1},{"lineBreak":true},{"text":"“Dees na ko dëkke,”","poem":1},{"lineBreak":true},{"text":"dëkki Yuda, ma ne:","poem":1},{"lineBreak":true},{"text":"“Dees na leen tabaxaat,","poem":1},{"lineBreak":true},{"text":"ma dekkali gentam bi.”","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Maa naa xóotey mbeex mi: “Wowal,","poem":1},{"lineBreak":true},{"text":"te maay ŋiisal say dex.”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Maa naa ci Sirus","poem":1},{"noteId":30},{"text":": “Sama sàmm bi!","poem":1},{"lineBreak":true},{"text":"Mooy matal sama bépp nammeel,","poem":1},{"lineBreak":true},{"text":"te it moo naa ci Yerusalem:","poem":1},{"lineBreak":true},{"text":"‘Nees ko tabaxaat,’","poem":1},{"lineBreak":true},{"text":"kër gu sell gi, la ne:","poem":1},{"lineBreak":true},{"text":"‘Nees ko yékkatiwaat!’”»","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"44.2 Yesurun: tur wii ak Yanqóoba itam dees na ko woowe Israayil.","reference":{"chapter":44,"verse":2}},{"noteId":30,"caller":"+","text":"44.28 Sirus mooy buuru Pers.","reference":{"chapter":44,"verse":28}}]},"thisChapterLink":"/api/wol_mbs/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}