{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":45,"content":[{"type":"heading","content":["Aji Sax ji dooleel na Buur Sirus"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax ji dafa wax ki mu fal,","poem":1},{"lineBreak":true},{"text":"Buur Sirus mi mu jàpp ci loxol ndijooram,","poem":1},{"lineBreak":true},{"text":"ngir nangulal ko xeet yi,","poem":1},{"lineBreak":true},{"text":"yolomal ngañaayal buur yi,","poem":1},{"lineBreak":true},{"text":"lafal koy bunt,","poem":1},{"lineBreak":true},{"text":"ba bunti dëkk du tëje,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"mu ne: «Man maa lay jiitu,","poem":1},{"lineBreak":true},{"text":"maasale mbartal,","poem":1},{"lineBreak":true},{"text":"rajaxe buntu xànjar,","poem":1},{"lineBreak":true},{"text":"damm tëjukaayu weñ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maa lay jagleel denc yu ruqe,","poem":1},{"lineBreak":true},{"text":"ak alal ju làqe,","poem":1},{"lineBreak":true},{"text":"ba nga xam ne maay Aji Sax ji lay woowe sa tur,","poem":1},{"lineBreak":true},{"text":"man Yàllay Israayil.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Te Yanqóoba sama jaam bi,","poem":1},{"lineBreak":true},{"text":"Israayil moomu di sama tànnéef moo tax","poem":1},{"lineBreak":true},{"text":"ma woowe la saw tur,","poem":1},{"lineBreak":true},{"text":"takkal la ndombol tànk,","poem":1},{"lineBreak":true},{"text":"te xamuloo ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax ji man a, du keneen;","poem":1},{"lineBreak":true},{"text":"kenn du Yàlla ku dul man.","poem":1},{"lineBreak":true},{"text":"Maa la gemb,","poem":1},{"lineBreak":true},{"text":"te xamuloo ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ngir xamees penku ba sowu,","poem":1},{"lineBreak":true},{"text":"ne lu dul man neen la.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji man a, du keneen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maay bind leer,","poem":1},{"lineBreak":true},{"text":"di def lëndëm.","poem":1},{"lineBreak":true},{"text":"Maay indi jàmm,","poem":1},{"lineBreak":true},{"text":"di def safaan.","poem":1},{"lineBreak":true},{"text":"Maay Aji Sax jiy def lii lépp!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na asamaan wis-wisal,","poem":1},{"lineBreak":true},{"text":"niir tawal dëgg ak yoon;","poem":1},{"lineBreak":true},{"text":"suuf fett, meññal wall,","poem":1},{"lineBreak":true},{"text":"boole ci jebbil dëgg ak yoon.","poem":1},{"lineBreak":true},{"text":"Man Aji Sax ji, maa def lii!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wóoy ngalla kuy diiŋat ka la tabax","poem":1},{"lineBreak":true},{"text":"te di ndabal xandeer ci biir ndabi xandeer!","poem":1},{"lineBreak":true},{"text":"Ana ban ak di wax tabaxkatam,","poem":1},{"lineBreak":true},{"text":"naa ko: «Looy def nii?","poem":1},{"lineBreak":true},{"text":"Yaw amulooy loxo.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wóoy ngalla ku naan baayu nit,","poem":1},{"lineBreak":true},{"text":"«Moo, lu sa geño meññ nii?»","poem":1},{"lineBreak":true},{"text":"Mbaa ku naan ndeyu nit,","poem":1},{"lineBreak":true},{"text":"«Li nga wasin lu mu?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Aji Sax ji, Aji Sell ju Israayil dafa wax,","poem":1},{"lineBreak":true},{"text":"moom mi ko bind,","poem":1},{"lineBreak":true},{"text":"mu ne: «Lu dikkagul, nu ngeen ma ko ñemee laaje;","poem":1},{"lineBreak":true},{"text":"am dangeen may jox ndigal ci samay doom,","poem":1},{"lineBreak":true},{"text":"jox ma ko ci li ma liggéeye samay loxo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Man maa amal suuf,","poem":1},{"lineBreak":true},{"text":"sàkk doom aadama fi kaw suuf.","poem":1},{"lineBreak":true},{"text":"Man mii la samay loxo firi asamaan,","poem":1},{"lineBreak":true},{"text":"te maay jox gàngoori asamaan lépp ndigal.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Man maay yékkati Buur Sirus ci àtteb dëgg,","poem":1},{"lineBreak":true},{"text":"xàllu yoonam.","poem":1},{"lineBreak":true},{"text":"Man maay yékkati Buur Sirus ngir mu doxal yoon,","poem":1},{"lineBreak":true},{"text":"maa koy xàllal yoon.","poem":1},{"lineBreak":true},{"text":"Moom mooy tabax sama dëkk,","poem":1},{"lineBreak":true},{"text":"yiwi sama ñoñ ñi ñu toxal,","poem":1},{"lineBreak":true},{"text":"te du laaj pey mbaa neexal.»","poem":1},{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yee ko wax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Muy ñaqu Misra, di koomu waa Kuus,","poem":1},{"lineBreak":true},{"text":"ak waa Seba ñu njol ñi,","poem":1},{"lineBreak":true},{"text":"ñoom ñépp ay jàllsi, nga jagoo.","poem":1},{"lineBreak":true},{"text":"Sa gannaaw lañuy topp,","poem":1},{"lineBreak":true},{"text":"yeewe, jàllsi;","poem":1},{"lineBreak":true},{"text":"sujjóotal la, di ñaan naan:","poem":1},{"lineBreak":true},{"text":"“Fi yaw daal la Yàlla ne,","poem":1},{"lineBreak":true},{"text":"du feneen,","poem":1},{"lineBreak":true},{"text":"te tuur neen la.”»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaw déy, yaa di Yàlla ju làqu,","poem":1},{"lineBreak":true},{"text":"yaw Yàllay Israayil ji koy wallu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yattkati xërëm yaa ngoogu, rus,","poem":1},{"lineBreak":true},{"text":"torox, riixleendoo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Israayil, yaay mucc fa Aji Sax ji","poem":1},{"lineBreak":true},{"text":"mucc gu sax dàkk!","poem":1},{"lineBreak":true},{"text":"Doo rus, doo torox","poem":1},{"lineBreak":true},{"text":"fii ak ëllëg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Aji Sax ji kat dafa wax,","poem":1},{"lineBreak":true},{"text":"moom mi sàkk asamaan,","poem":1},{"lineBreak":true},{"text":"moom Yàlla mi bind suuf,","poem":1},{"lineBreak":true},{"text":"tabax ko, dëj ko,","poem":1},{"lineBreak":true},{"text":"sàkkewu ko maraas,","poem":1},{"lineBreak":true},{"text":"xanaa tabaxal ñu ko dëkke.","poem":1},{"lineBreak":true},{"text":"Mu ne: «Aji Sax ji, man a, du keneen.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Làquwuma, di waxe béreb bu lëndëm.","poem":1},{"lineBreak":true},{"text":"Newuma it askanu Yanqóoba:","poem":1},{"lineBreak":true},{"text":"“Wërleen ma ci neen.”","poem":1},{"lineBreak":true},{"text":"Man Aji Sax ji maay wax dëgg,","poem":1},{"lineBreak":true},{"text":"di biral liy yoon.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yeen daw-làquy xeet yi,","poem":1},{"lineBreak":true},{"text":"dajeleen, dikk,","poem":1},{"lineBreak":true},{"text":"ànd, jegesi.","poem":1},{"lineBreak":true},{"text":"Képp ku gàddu tuuru bantam,","poem":1},{"lineBreak":true},{"text":"ak kuy ñaan tuur mu ko dul wallu,","poem":1},{"lineBreak":true},{"text":"kooka xamul dara.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Àdduleen, layoosi,","poem":1},{"lineBreak":true},{"text":"diisooleen fi seen biir kay!","poem":1},{"lineBreak":true},{"text":"Ana ku xamle woon lii bu yàgg,","poem":1},{"lineBreak":true},{"text":"yégle woon ko booba?","poem":1},{"lineBreak":true},{"text":"Xanaa du man Aji Sax ji?","poem":1},{"lineBreak":true},{"text":"Kenn du Yàlla ku dul man!","poem":1},{"lineBreak":true},{"text":"Yàlla ju jub, di walloo,","poem":1},{"lineBreak":true},{"text":"du kenn ku dul man!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yeen waa àddina, catoo cat,","poem":1},{"lineBreak":true},{"text":"walbatikuleen fi man, mucc.","poem":1},{"lineBreak":true},{"text":"Man maay Yàlla, du keneen.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Giñ naa ko ci man mii,","poem":1},{"lineBreak":true},{"text":"sama gémmiñ, dëgg a ciy jibe,","poem":1},{"lineBreak":true},{"text":"di kàddu gu dul randu.","poem":1},{"lineBreak":true},{"text":"Man la ñépp di sukkal seen bëti óom,","poem":1},{"lineBreak":true},{"text":"man it la bépp boroom làmmiñ di giñe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dees na ma waxal ne:","poem":1},{"lineBreak":true},{"text":"«Aji Sax ji rekk a jagoo àtte ak doole!»","poem":1},{"lineBreak":true},{"text":"Mboolem ñi ma mereey ànd,","poem":1},{"lineBreak":true},{"text":"sëgg, fekksi ma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ci Aji Sax ji la askanu Israayil gépp yeye,","poem":1},{"text":"bay damu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}