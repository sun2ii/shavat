{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":46,"content":[{"type":"heading","content":["Yii yàlla bootu, jii Yàlla di boote"]},{"type":"verse","number":1,"content":[{"text":"Tuur ma ñu naa Bel toqi na,","poem":1},{"lineBreak":true},{"text":"tuur ma ñu naa Nebo sukk,","poem":1},{"lineBreak":true},{"text":"mala ya féetewoo seeni jëmm,","poem":1},{"lineBreak":true},{"text":"ñoom lees daan gàddu","poem":1},{"noteId":31},{"text":", tey jur gi jagoo,","poem":1},{"lineBreak":true},{"text":"di leen sëf ba loof.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuur yaa ngay sukk, bokk toqi;","poem":1},{"lineBreak":true},{"text":"manuñoo wallu seen jëmm ya,","poem":1},{"lineBreak":true},{"text":"xanaa doxal seen bopp, dugg cig njaam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji nee na: «Dégluleen yeen waa kër Yanqóoba,","poem":1},{"lineBreak":true},{"text":"yeen ndesu kër Israayil gépp,","poem":1},{"lineBreak":true},{"text":"yeen ñi ma dale yor ba ngeen juddoo,","poem":1},{"lineBreak":true},{"text":"di leen fab ba ngeen génnee seen biiru ndey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ba ba ngeen di magal, man la,","poem":1},{"lineBreak":true},{"text":"ba keroog ngeen di bijjaaw, maa leen di boot.","poem":1},{"lineBreak":true},{"text":"Maa sàkk, maay yor,","poem":1},{"lineBreak":true},{"text":"maay boot, xettali!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ana ku ngeen may niruleel,","poem":1},{"lineBreak":true},{"text":"di ma nàttableeka méngaleek moom,","poem":1},{"lineBreak":true},{"text":"ba ñu niroo lenn?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ñii déy a yullee wurus ci mbuus,","poem":1},{"lineBreak":true},{"text":"sàkk xaalis, natt diisaay ba,","poem":1},{"lineBreak":true},{"text":"fey tëgg bu leen ci tëggal am tuur","poem":1},{"text":"mu ñuy sukkal aka sujjóotal,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"yékkati teg ci mbagg,","poem":1},{"lineBreak":true},{"text":"yóbbu, teg béreb, mu des fa;","poem":1},{"lineBreak":true},{"text":"du jóge fa mu tege,","poem":1},{"lineBreak":true},{"text":"ku ko woo wall it, du wuyu,","poem":1},{"lineBreak":true},{"text":"ba jot ko ci njàqare.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fàttalikuleen lii te dëgërluwaat!","poem":1},{"lineBreak":true},{"text":"Yeen bàkkaarkat yi, defleen lii ci seen xel.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fàttalikuleen cosaan la woon.","poem":1},{"lineBreak":true},{"text":"Man mii maay Yàlla, du keneen.","poem":1},{"lineBreak":true},{"text":"Amul Yàlla ju mel ni man!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maay yégle muj ca ndoorte la,","poem":1},{"lineBreak":true},{"text":"ak jëf ju amagul, lu jiitu bu yàgg.","poem":1},{"lineBreak":true},{"text":"Maa naa sama mébét a ngii, day am,","poem":1},{"lineBreak":true},{"text":"sama bépp nammeel sotti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maay woowe jaxaay penku,","poem":1},{"lineBreak":true},{"text":"woowe réew mu sore, kuy sottal sama mébét.","poem":1},{"lineBreak":true},{"text":"Maay àddu, amal;","poem":1},{"lineBreak":true},{"text":"maay nas, sottal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Dégluleen maa, yeen dëgër bopp yi!","poem":1},{"lineBreak":true},{"text":"Yeenaka dëddu njub!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maa jegeñal sama àtte, soreetul;","poem":1},{"lineBreak":true},{"text":"sama wall a ngii, yàggatul.","poem":1},{"lineBreak":true},{"text":"Maay maye wall fi Siyoŋ gii,","poem":1},{"lineBreak":true},{"text":"ba Israayil gii di sama gànjar.»","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"46.1 Waa Babilon a doon gàddu seeni tuur, gannaaw ba leen Buur Sirus songee.","reference":{"chapter":46,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}