{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":47,"content":[{"type":"heading","content":["Babilon falu, fëlëñu"]},{"type":"verse","number":1,"content":[{"text":"Yaw janq Babilon,","poem":1},{"lineBreak":true},{"text":"wàccal, toog ci pënd bi.","poem":1},{"lineBreak":true},{"text":"Yaw dëkkub Kaldeen bi ci taar bi laa ne,","poem":1},{"lineBreak":true},{"text":"toogal fi suuf, amatoob jal.","poem":1},{"lineBreak":true},{"text":"Dootoo dégg: «Lewet, ndaw su xay.»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fabal wolukaay, wol sunguf.","poem":1},{"lineBreak":true},{"text":"Dindil sa muuraay gi,","poem":1},{"lineBreak":true},{"text":"wogos sa mbubb,","poem":1},{"lineBreak":true},{"text":"ëñ sas kumba,","poem":1},{"lineBreak":true},{"text":"xuus, jàll dex yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na sa yaram feeñ,","poem":1},{"lineBreak":true},{"text":"say cér ne fàŋŋ.","poem":1},{"lineBreak":true},{"text":"Damay feyu,","poem":1},{"lineBreak":true},{"text":"te duma baale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sunu jotkat ay Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"Aji Sell ju Israayil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaw dëkkub Kaldeen bi ci taar bi,","poem":1},{"lineBreak":true},{"text":"toogal ne cell te fatu cig lëndëm,","poem":1},{"lineBreak":true},{"text":"deesatu la woowe lingeeru réew yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa mere woon sama ñoñ,","poem":1},{"lineBreak":true},{"text":"sobeel sama séddoo ñii,","poem":1},{"lineBreak":true},{"text":"teg leen ci sa loxo,","poem":1},{"lineBreak":true},{"text":"te wonoo leen yërmande,","poem":1},{"lineBreak":true},{"text":"ba mag sax, nga teg ko lu diisa diis,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"te naa: «Ba fàww maay lingeer!»","poem":1},{"lineBreak":true},{"text":"ba tax bàyyiwoo xel ca la ngay def;","poem":1},{"lineBreak":true},{"text":"xalaatoo la muy jur.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Diryànke bee, déglul lii:","poem":1},{"lineBreak":true},{"text":"Yaa ngi ne finaax te naa ci sam xel:","poem":1},{"lineBreak":true},{"text":"«Maa ko yor, man rekk, du keneen.","poem":1},{"lineBreak":true},{"text":"Duma jooy jëkkër, duma jooy doom!»","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Te ñaar yooyoo lay dikkal ci benn bés.","poem":1},{"lineBreak":true},{"text":"Jooy doom, jooy jëkkër ay yembandoo,","poem":1},{"lineBreak":true},{"text":"dal fi sa kaw ci sa biir xërëmtu yi ne xas,","poem":1},{"lineBreak":true},{"text":"ak sa jat yu dul jeex.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dangaa yaakaaroon sa pexe yu bon,","poem":1},{"lineBreak":true},{"text":"naan, «Kenn gisu ma!»","poem":1},{"lineBreak":true},{"text":"Sam xel ak sa xam-xam a la wacc,","poem":1},{"lineBreak":true},{"text":"ba tax nga naa: «Maa ko yor, awma moroom.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Musibaa lay dikkal,","poem":1},{"lineBreak":true},{"text":"te doo xam fu mu fenke.","poem":1},{"lineBreak":true},{"text":"Njaaxum a lay dal,","poem":1},{"lineBreak":true},{"text":"te du looy mana fanq.","poem":1},{"lineBreak":true},{"text":"Sànkuteey jekki dale la foo yégul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jàppool say jat rekk","poem":1},{"lineBreak":true},{"text":"ak sa xërëm yu ne xas","poem":1},{"text":"yoo dale sonn ba ngay ndaw.","poem":2},{"text":"Jombul mu amal la njariñ,","poem":1},{"lineBreak":true},{"text":"mbaa ñu ragale la ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaaka sonn ci tegtali maa-man!","poem":1},{"lineBreak":true},{"text":"Nañ taxaw boog, wallu la!","poem":1},{"lineBreak":true},{"text":"Ñii di rëdd nataalu asamaan,","poem":1},{"lineBreak":true},{"text":"di niiri biddiiw,","poem":1},{"lineBreak":true},{"text":"ak di xool weer wu feeñ,","poem":1},{"lineBreak":true},{"text":"xamle ca loo dikkleegul.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ñu ngoog bokk demin ak boob bu sawara jafal,","poem":1},{"lineBreak":true},{"text":"duñu musal seen bakkan ca sawara sa,","poem":1},{"lineBreak":true},{"text":"te du doon ab taal bu ñuy lakke mburu","poem":1},{"lineBreak":true},{"text":"mbaa xal wooy uuf di jaaru.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lii moo di muju ña la taxoon di sonn.","poem":1},{"lineBreak":true},{"text":"Ña nga dale jëflanteel ba ngay ndaw,","poem":1},{"lineBreak":true},{"text":"ña ngay tambaambalu tey, ku nekk ak yoonam,","poem":1},{"lineBreak":true},{"text":"kenn walluwu la ci.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}