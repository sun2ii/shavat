{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":5,"content":[{"type":"heading","content":["Woyu cofeel rax na"]},{"type":"verse","number":1,"content":[{"text":"Naa woy sama soppe","poem":1},{"lineBreak":true},{"text":"woyu cofeel wu solowoo tóokëram.","poem":1},{"lineBreak":true},{"text":"Sama soppee fi amoon tóokër,","poem":1},{"lineBreak":true},{"text":"kaw tund wu suuf sa nangu lool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mu gàbb ko, dindi doj ya,","poem":1},{"lineBreak":true},{"text":"jëmbat ca ngëneeli reseñ,","poem":1},{"lineBreak":true},{"text":"tabax tóojub doj fa digg ba,","poem":1},{"lineBreak":true},{"text":"ba yatt ca mbalkam nalukaayu reseñ,","poem":1},{"lineBreak":true},{"text":"tey yaakaar reseñ ju neex,","poem":1},{"lineBreak":true},{"text":"mu meññ, wex.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Léegi yeen waa Yerusalem","poem":1},{"lineBreak":true},{"text":"ak yeen waa Yuda,","poem":1},{"lineBreak":true},{"text":"ngalla àtteleen maak sama tóokër.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lu may defalati sama tóokër bi,","poem":1},{"lineBreak":true},{"text":"lu ma ca defuloon?","poem":1},{"lineBreak":true},{"text":"Lu waral ma di ko yaakaare reseñ ju neex,","poem":1},{"lineBreak":true},{"text":"mu meññ, wex xàtt?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma xamal leen nag","poem":1},{"lineBreak":true},{"text":"li ma naral sama tóokër bi.","poem":1},{"lineBreak":true},{"text":"Ñàggib ñagam, mu dim parlu;","poem":1},{"lineBreak":true},{"text":"màbb miiram, ñu dëggaate ko, jàll.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dama koy gental,","poem":1},{"lineBreak":true},{"text":"mu saxi dég aki dagg,","poem":1},{"lineBreak":true},{"text":"deesu ko tenqi, deesu ko bey;","poem":1},{"lineBreak":true},{"text":"niir yi it, ma sant leen","poem":1},{"lineBreak":true},{"text":"ñu bañ koo tawal.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tóokëru Aji Sax ji Boroom gàngoor yi kat,","poem":1},{"lineBreak":true},{"text":"mooy waa kër Israayil.","poem":1},{"lineBreak":true},{"text":"Niti Yuda it","poem":1},{"lineBreak":true},{"text":"ñooy njëmbat li mu safoo.","poem":1},{"lineBreak":true},{"text":"Mu di ko yaakaare njub,","poem":1},{"lineBreak":true},{"text":"njubadi ne jaas.","poem":1},{"lineBreak":true},{"text":"Mu yaakaar njekk,","poem":1},{"lineBreak":true},{"text":"yuuxi njekkar ne jaas.","poem":1}]},{"type":"heading","content":["Alkànde ñeel na kàngami Yuda"]},{"type":"verse","number":8,"content":[{"text":"Wóoy ngalla ñii di dajale kër ak kër,","poem":1},{"lineBreak":true},{"text":"tool akub tool,","poem":1},{"lineBreak":true},{"text":"aakimoo fépp,","poem":1},{"lineBreak":true},{"text":"ba des ñoomu neen ci réew mi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Maa dégg Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"mu ne: «Giñ naa ne","poem":1},{"lineBreak":true},{"text":"kër yu bareey gental déy,","poem":1},{"lineBreak":true},{"text":"kër yu yaa, rafet, kenn dëkku ca.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tóokërub ñetti egtaar déy","poem":1},{"lineBreak":true},{"text":"du meññ juróom fukki liitari biiñ,","poem":1},{"lineBreak":true},{"text":"te jiwum téeméeri kiloy bele it,","poem":1},{"lineBreak":true},{"text":"fukki kilo doŋŋ a cay génne.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wóoy ngalla ñiy teela xëy,","poem":1},{"lineBreak":true},{"text":"daw wutiw ñoll,","poem":1},{"lineBreak":true},{"text":"gonte biiñ ba tàng jérr.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xalam yaak tabala yaak toxoro ya jolli,","poem":1},{"lineBreak":true},{"text":"biiñ xelli ca xawaare ja.","poem":1},{"lineBreak":true},{"text":"Seetluwuñu sax li Aji Sax ji def,","poem":1},{"lineBreak":true},{"text":"xooluñu li mu jo loxoom.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Moo tax ñuy gàddaayloo ñoñi Aji Sax ji","poem":1},{"lineBreak":true},{"text":"ndax li ñu ñàkk xam-xam.","poem":1},{"lineBreak":true},{"text":"Seen kàngam ay deek xiif,","poem":1},{"lineBreak":true},{"text":"seen baadoolo deek mar.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moo tax njaniiw di yàkkali ag bóli,","poem":1},{"lineBreak":true},{"text":"gémmiñ ga ne ŋafeet, amul kersa,","poem":1},{"lineBreak":true},{"text":"boroom darajaak baadoolay Yerusalem","poem":1},{"lineBreak":true},{"text":"doon xaxaloo, far tàbbi ca.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Doom aadama torox na,","poem":1},{"lineBreak":true},{"text":"nit detteelu na,","poem":1},{"lineBreak":true},{"text":"ku doon regeju, detteelu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi, ab àtteem lay fésale màggaayam,","poem":1},{"lineBreak":true},{"text":"Yàlla ju sell ji, ab àtteb yoon lay firndeele sellaayam.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Am xar a nara fore biir dëkk bi, mbetem parlu,","poem":1},{"lineBreak":true},{"text":"màngaan lekke gentub boroom alal.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wóoy ngalla ñiy ràngooy buum,","poem":1},{"lineBreak":true},{"text":"di diri ñaawtéefi neen,","poem":1},{"lineBreak":true},{"text":"ràngooy goj di diri seeni tooñ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ña nga naa: «Na Aji Sax ji gaaw!","poem":1},{"lineBreak":true},{"text":"Na baral liggéeyam, nu gis.","poem":1},{"lineBreak":true},{"text":"Na Aji Sell ju Israayil sottal mébétam,","poem":1},{"lineBreak":true},{"text":"mu sotti, nu xam.»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wóoy ngalla ñiy gis lu bon, ne lu baax la;","poem":1},{"lineBreak":true},{"text":"gis lu baax, ne lu bon la;","poem":1},{"lineBreak":true},{"text":"lëndëm, ñu tudde leer,","poem":1},{"lineBreak":true},{"text":"leer, ñu tudde lëndëm;","poem":1},{"lineBreak":true},{"text":"lu wex, ñu ne neex na,","poem":1},{"lineBreak":true},{"text":"lu neex, ñu ne wex na.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wóoy ngalla ñii defe ne ñoo xam,","poem":1},{"lineBreak":true},{"text":"yaakaar ne ñoo muus.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wóoy ngalla ñiy jàmbaari naan biiñ,","poem":1},{"lineBreak":true},{"text":"diy ndaanaan ci njafaanu ñoll,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"di dëggal ku sikk ndax ab ger,","poem":1},{"lineBreak":true},{"text":"tey xañ boroom dëgg àqam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Moo tax ni boob di jeexe ci sawara,","poem":1},{"lineBreak":true},{"text":"ngooñ xoyomoo ko cib taal,","poem":1},{"lineBreak":true},{"text":"ni la seenub reen di seeye ni lu maxe,","poem":1},{"lineBreak":true},{"text":"seeni tóor-tóor naaw ni pënd.","poem":1},{"lineBreak":true},{"text":"Ñoo gàntal yoonu Aji Sax ji ci gàngoor yi,","poem":1},{"lineBreak":true},{"text":"ñoo sofental kàddug Aji Sell ju Israayil.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Moo tax merum Aji Sax ji tàkkal ñoñam,","poem":1},{"lineBreak":true},{"text":"mu xàcc loxoom, duma leen,","poem":1},{"lineBreak":true},{"text":"ba tund yi jaayu,","poem":1},{"lineBreak":true},{"text":"seeni néew wetar ni mbalit fi mbedd yi.","poem":1},{"lineBreak":true},{"text":"Teewul Aji Sax ji xàcc loxoom,","poem":1},{"lineBreak":true},{"text":"meddiwul ba tey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Aji Sax jeey yékkatil raaya xeet wu sore,","poem":1},{"lineBreak":true},{"text":"walug liit, woowe leen fa cati àddina,","poem":1},{"lineBreak":true},{"text":"ñu jekki ne jaas, dikkal leen.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kenn sonnu ci, kenn tërëfu ci,","poem":1},{"lineBreak":true},{"text":"kenn dajjantul mbaa muy nelaw;","poem":1},{"lineBreak":true},{"text":"ngañaay yolomul, waruw dàll dogul.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Seeni fitt ñaw na,","poem":1},{"lineBreak":true},{"text":"seen xala yépp noppi na,","poem":1},{"lineBreak":true},{"text":"seen wewi tànki fas ni xeer.","poem":1},{"lineBreak":true},{"text":"Bu tànki watiir ya dawee,","poem":1},{"lineBreak":true},{"text":"nga defe ne callweer a.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dañuy ŋar ni gaynde,","poem":1},{"lineBreak":true},{"text":"ŋarati ni gaynde gu mat;","poem":1},{"lineBreak":true},{"text":"yëmmu, ŋank rëbbam,","poem":1},{"lineBreak":true},{"text":"yóbbu te kenn du wallu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Bésub keroog ñu ŋaral Yuda,","poem":1},{"lineBreak":true},{"text":"ŋar yu mel ni géej gu sàmbaraax!","poem":1},{"lineBreak":true},{"text":"Foo geesu ci réew mi, xool,","poem":1},{"lineBreak":true},{"text":"doo gis lu moy lëndëm ak njàqare,","poem":1},{"lineBreak":true},{"text":"xàmbaar maase, ba leer giim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}