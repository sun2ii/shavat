{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":51,"content":[{"type":"heading","content":["Barke ñeel na ñoñi Aji Sax ji"]},{"type":"verse","number":1,"content":[{"text":"Dégluleen maa, yeen ñiy wuta doxee yoon,","poem":1},{"lineBreak":true},{"text":"wuta déggal Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Xoolleen doj wi ñu leen yatte,","poem":1},{"lineBreak":true},{"text":"xool xóotey kàmb gi ñu leen seppee:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"seen maam Ibraayma laa ne, moom ngeen di xool,","poem":1},{"lineBreak":true},{"text":"xool ci Saarata mi leen meññ.","poem":1},{"lineBreak":true},{"text":"Ba muy kenn laa ko woo,","poem":1},{"lineBreak":true},{"text":"barkeel ko, ful ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax jeey dëfal Siyoŋ moos,","poem":1},{"lineBreak":true},{"text":"dëfalaale fépp fu fa dib gent,","poem":1},{"lineBreak":true},{"text":"ba def màndiŋam ni toolub Àjjana,","poem":1},{"lineBreak":true},{"text":"jooram gu wow mel ni toolub Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"mbégteek bànneex teew fa,","poem":1},{"lineBreak":true},{"text":"ak cantug woy feelu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yeen sama ñoñ, teewluleen ma,","poem":1},{"lineBreak":true},{"text":"yeen sama ñoñ, dégluleen ma.","poem":1},{"lineBreak":true},{"text":"Fi man la téereb yoon di bawoo,","poem":1},{"lineBreak":true},{"text":"te maay fettaxal sama àtte,","poem":1},{"lineBreak":true},{"text":"muy leeru xeet yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sama wall jege na,","poem":1},{"lineBreak":true},{"text":"sama àtte dëgmal na,","poem":1},{"lineBreak":true},{"text":"ma nara àttee xeet yi sama dooley përëg.","poem":1},{"lineBreak":true},{"text":"Man la waa dun yiy xaar,","poem":1},{"lineBreak":true},{"text":"sama dooley përëg lañu yaakaar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Séentuleen asamaan","poem":1},{"lineBreak":true},{"text":"te xool suuf si mu tiim.","poem":1},{"lineBreak":true},{"text":"Asamaan ay tasaaroo ni saxaar,","poem":1},{"lineBreak":true},{"text":"suuf ràpp ni mbubb,","poem":1},{"lineBreak":true},{"text":"ñi ko dëkke dee niy weñ,","poem":1},{"lineBreak":true},{"text":"te du tee sama wall di sax ba fàww,","poem":1},{"lineBreak":true},{"text":"sama doxalinu yoon it du dagg.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yeen ñi xam liy yoon, dégluleen ma,","poem":1},{"lineBreak":true},{"text":"yeen, askan wi sama yoon yebu ci seen xol.","poem":1},{"lineBreak":true},{"text":"Buleen ragal nit ku leen sewal,","poem":1},{"lineBreak":true},{"text":"buleen tiit seeni xaste.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sax a leen di lekk ni mbubb,","poem":1},{"lineBreak":true},{"text":"max ŋeeñ leen ni ndimol kawaru gàtt;","poem":1},{"lineBreak":true},{"text":"te du tee sama doxalinu yoon sax dàkk,","poem":1},{"lineBreak":true},{"text":"sama wall saxal maasoo maas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Aji Sax ji, yewwul, ngalla yewwul;","poem":1},{"lineBreak":true},{"text":"wone sa doole!","poem":1},{"lineBreak":true},{"text":"Yewwul na bu njëkkoon,","poem":1},{"lineBreak":true},{"text":"bu yàgga yàgg.","poem":1},{"lineBreak":true},{"text":"Xanaa du yaa falaxe Raxab?","poem":1},{"lineBreak":true},{"text":"Du yaa jam ninki-nanka jooja?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xanaa du yaa wowal géej","poem":1},{"lineBreak":true},{"text":"ak ndoxum xuram wu ne màww,","poem":1},{"lineBreak":true},{"text":"def xóotey géej aw yoon,","poem":1},{"lineBreak":true},{"text":"ña nga jot jàlle ca?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ñi Aji Sax ji goreel, nii lañuy dellusee,","poem":1},{"lineBreak":true},{"text":"agsaaley sarxolle fa Siyoŋ,","poem":1},{"lineBreak":true},{"text":"kaalawoo mbég mu sax,","poem":1},{"lineBreak":true},{"text":"mbégteek bànneex wàllsi,","poem":1},{"lineBreak":true},{"text":"naqar aku tiis daw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Man ci sama bopp maa leen di dëfal.","poem":1},{"lineBreak":true},{"text":"Ana lu ngeen di ragal ci nit kuy dee,","poem":1},{"lineBreak":true},{"text":"doom aadama ju bokk aw demin akum ñax?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dangeena fàtte Aji Sax ji leen sàkk,","poem":1},{"lineBreak":true},{"text":"ki firi asamaan, lal suuf?","poem":1},{"lineBreak":true},{"text":"Dangeen di dëkke bésoo bés,","poem":1},{"lineBreak":true},{"text":"di tiit xadaru boroom doole buy waaja sànke?","poem":1},{"lineBreak":true},{"text":"Ana fu xadaru boroom doole mujje?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku diisoon ba waaf léegi nga féex;","poem":1},{"lineBreak":true},{"text":"doo deewe pax ma nga tëje,","poem":1},{"lineBreak":true},{"text":"te doo ñàkk loo lekk.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Man maay seen Yàlla Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"kiy yëngal géej, riiral gannaxam,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi di sama tur.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Maa la sexal samay kàddu,","poem":1},{"lineBreak":true},{"text":"yiire la sama keru loxo,","poem":1},{"lineBreak":true},{"text":"aj asamaan, lal suuf,","poem":1},{"lineBreak":true},{"text":"ne Siyoŋ: «Yeenay sama ñoñ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yewwulee, yewwul, Yerusalemee jógal,","poem":1},{"lineBreak":true},{"text":"yaw mi Aji Sax ji nàndal kaasu mbugalam.","poem":1},{"lineBreak":true},{"text":"Kaas bu wex bay miirloo,","poem":1},{"lineBreak":true},{"text":"taat wa, yaa ko siitaatu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amul ci ñi nga jur, kenn koo dese","poem":1},{"lineBreak":true},{"text":"ku lay wommat.","poem":1},{"lineBreak":true},{"text":"Amul ci doom yi nga yar, kenn","poem":1},{"lineBreak":true},{"text":"ku lay jàpp ci loxo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yii yaar de dikkal na la:","poem":1},{"lineBreak":true},{"text":"yàquleek sànkule.","poem":1},{"lineBreak":true},{"text":"Ana kuy bokk ak yaw saw naqar?","poem":1},{"lineBreak":true},{"text":"Xiif ak loraangey saamar!","poem":1},{"lineBreak":true},{"text":"Ana nu ma lay dëfale?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sa doom yi ne lasar,","poem":1},{"lineBreak":true},{"text":"mbete kooba yu fiir jàpp,","poem":1},{"lineBreak":true},{"text":"ñu ne lareet fépp fu mbedd daje,","poem":1},{"lineBreak":true},{"text":"këppoo sànjum Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sa Yàlla ji leen rëbb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rikk déglul nag lii, yaw mi musiba dal,","poem":1},{"lineBreak":true},{"text":"nga màndi te du biiñ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sa boroom Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sa Yàlla jiy layool ñoñam","poem":1},{"lineBreak":true},{"text":"dafa wax ne: «Mu ngoog, maa jële ci sa loxo,","poem":1},{"lineBreak":true},{"text":"kaas bu wex biy miirloo;","poem":1},{"lineBreak":true},{"text":"taatu kaas ba def sama mbugal,","poem":1},{"lineBreak":true},{"text":"dootoo ko naan.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Maa koy teg ci loxol ñi la doon naqaral,","poem":1},{"lineBreak":true},{"text":"te naan la: “Sëggal, nu joggi, jàll,”","poem":1},{"lineBreak":true},{"text":"nga def sa gannaaw gi aw yoon,","poem":1},{"lineBreak":true},{"text":"ñu joggi, wéy.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}