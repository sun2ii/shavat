{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":52,"content":[{"type":"heading","content":["Yerusalem dina suqaliku"]},{"type":"verse","number":1,"content":[{"text":"Yewwulee, yewwul,","poem":1},{"lineBreak":true},{"text":"Siyoŋee, làmbool sa doole!","poem":1},{"lineBreak":true},{"text":"Yerusalem, dëkk bu sell bi,","poem":1},{"lineBreak":true},{"text":"solul ba ne ràññ!","poem":1},{"lineBreak":true},{"text":"Ndax du kenn ku xaraful mbaa ku sobewu","poem":1},{"lineBreak":true},{"text":"ku lay songati.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaw Yerusalem, mi ñu jàpp njaam,","poem":1},{"lineBreak":true},{"text":"jógal fëgtu,","poem":1},{"lineBreak":true},{"text":"yaw janq Siyoŋ mu taaru mi ñu jàpp njaam laa ne,","poem":1},{"lineBreak":true},{"text":"tikkil buum gi ci sa baat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji déy dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Dees leena wànteeroon ci dara,","poem":1},{"lineBreak":true},{"text":"te du xaalis lees leen di jotaate.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boroom bi Aji Sax ji déy dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Misra la sama ñoñ njëkka wàcc, dali fa,","poem":1},{"lineBreak":true},{"text":"Asiri door leena noot ci dara.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Léegi nag ana lu fiy sama wàll?»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee.","poem":1},{"lineBreak":true},{"text":"Mu ne: «Jàpp nañ sama ñoñ njaam ci dara;","poem":1},{"lineBreak":true},{"text":"seeni sang a ngi tëggu,","poem":1},{"lineBreak":true},{"text":"di dëkke ñàkke teggin sama tur.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Moo tax sama ñoñ di xam maay kan;","poem":1},{"lineBreak":true},{"text":"moo tax bésub keroog","poem":1},{"lineBreak":true},{"text":"ñu xam ne maay wax te maa ngii!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndaw leeka rafeti tànk,","poem":1},{"lineBreak":true},{"text":"kee bartaloo tund yi,","poem":1},{"lineBreak":true},{"text":"di la dégtalsi jàmm,","poem":1},{"lineBreak":true},{"text":"di la xibaar lu neex,","poem":1},{"lineBreak":true},{"text":"àgge la ag mucc,","poem":1},{"lineBreak":true},{"text":"ne la: «Éey, Siyoŋ,","poem":1},{"lineBreak":true},{"text":"sa Yàllaay Buur!»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Déglul sa wattukat yi,","poem":1},{"lineBreak":true},{"text":"ña ngay xaacu, sarxolleendoo.","poem":1},{"lineBreak":true},{"text":"Ñoo gisal seen bopp","poem":1},{"text":"Aji Sax ji di ñibbisi Siyoŋ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeen genti Yerusalem, àndleen sarxolle;","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey dëfal ñoñam,","poem":1},{"lineBreak":true},{"text":"mooy jot Yerusalem gii!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aji Sax jee wone dooleem ju sell ji,","poem":1},{"lineBreak":true},{"text":"xeet yépp di gis,","poem":1},{"lineBreak":true},{"text":"ba ca cati àddina.","poem":1},{"lineBreak":true},{"text":"Ñépp ay gis sunu wallub Yàlla.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Génnleen, génnleen foofa!","poem":1},{"lineBreak":true},{"text":"lu sobewu, buleen ko laal!","poem":1},{"lineBreak":true},{"text":"Yeen ñiy yóbbu ndab yu sell yu Aji Sax ji","poem":1},{"noteId":33},{"text":",","poem":1},{"lineBreak":true},{"text":"setluleen te génn foofa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dungeen gaawtu déy, di dem;","poem":1},{"lineBreak":true},{"text":"duy xél moos ngeen fay génne.","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey dox jiitu leen,","poem":1},{"lineBreak":true},{"text":"te Yàllay Israayil laa ne, moo leen di féete gannaaw.","poem":1}]},{"type":"heading","content":["Teraangay jaam bi wuutu na coonoom"]},{"type":"verse","number":13,"content":[{"text":"Aji Sax ji nee: «Sama jaam baa ngii,","poem":1},{"lineBreak":true},{"text":"mooy baaxle, kawe,","poem":1},{"lineBreak":true},{"text":"dees na ko yékkati, darajaal ko lool.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moo dawoon yaramu ñu bare,","poem":1},{"lineBreak":true},{"text":"ndax yàqu ba nirootul nit,","poem":1},{"lineBreak":true},{"text":"bindootul woon ni doom aadama,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"waaye noonu it lay waare ay xeeti xeet","poem":1},{"noteId":34},{"text":",","poem":1},{"lineBreak":true},{"text":"ba buur yi ne cell,","poem":1},{"lineBreak":true},{"text":"ngir lu ñu leen waxuloon, ñu gis ko,","poem":1},{"lineBreak":true},{"text":"lu ñu dégguloon, ñu mujj koo ràññee.»","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"52.11 Seetal ci 2.Buur ya 25.13-15.","reference":{"chapter":52,"verse":11}},{"noteId":34,"caller":"+","text":"52.15 Manees na koo tekkee nii itam: xeet yu bare lay wis-wisalum ndox, setale leen ko.","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/wol_mbs/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}