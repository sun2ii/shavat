{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":53,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ana ku gëm sunub dégtal?","poem":1},{"lineBreak":true},{"text":"Dooley loxol Aji Sax ji ana ku mu ko won?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kii màgge fi kanamam ni njëmbat,","poem":1},{"lineBreak":true},{"text":"te nirook reen bu fette ag kekk.","poem":1},{"lineBreak":true},{"text":"Dub taar, du yànjaay bu nu koy niire,","poem":1},{"lineBreak":true},{"text":"du meloom wu nu koy soppe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dees na ko xeeb, daw ko,","poem":1},{"lineBreak":true},{"text":"muy nit ku bare mitit","poem":1},{"lineBreak":true},{"text":"te miin naqar.","poem":1},{"lineBreak":true},{"text":"Mu mel ni ku ñuy dummóoyu,","poem":1},{"lineBreak":true},{"text":"dees koo xeeb te nawloowuñu ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndaxam moom sunu wopp la yenu,","poem":1},{"lineBreak":true},{"text":"sunuy mitit la sëfoo.","poem":1},{"lineBreak":true},{"text":"Nun nu foog ne dees koo mbugal,","poem":1},{"lineBreak":true},{"text":"foog ne Yàllaa ko duma, toroxal ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Te moom sunuy tooñ a waral ñu jamat ko;","poem":1},{"lineBreak":true},{"text":"sunuy ñaawtéef a waral ñu dëggaate ko.","poem":1},{"lineBreak":true},{"text":"Yar yi nu jàmmal moom la dal,","poem":1},{"lineBreak":true},{"text":"te mooy ki nu wére ciy góomam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nun ñépp a lajj niy xar,","poem":1},{"lineBreak":true},{"text":"ku nekk walbatiku topp yoonam,","poem":1},{"lineBreak":true},{"text":"te Aji Sax jee ko sëf mbugal mi nu wara dékku nun ñépp.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dees koo néewal doole, mitital ko","poem":1},{"lineBreak":true},{"text":"te ubbiwul gémmiñam,","poem":1},{"lineBreak":true},{"text":"xanaa mel ni xar mu ñuy rendiji,","poem":1},{"lineBreak":true},{"text":"ne cell ni xar mu ñuy wat,","poem":1},{"lineBreak":true},{"text":"ubbiwul gémmiñam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àttewuñu ko dëgg, yóbbu,","poem":1},{"lineBreak":true},{"text":"te ag maasam kenn teewluwul ne","poem":1},{"lineBreak":true},{"text":"tooñ gu sama bokk yi tooñ","poem":1},{"lineBreak":true},{"text":"lees ko génne ci réewum aji dund ñi,","poem":1},{"lineBreak":true},{"text":"te loolu lees ko faate.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni ñuy robe saay-saay lañu ko robe,","poem":1},{"lineBreak":true},{"text":"denc ko ci bàmmeelu boroom alal,","poem":1},{"lineBreak":true},{"text":"soxorul, fenul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Moona Aji Sax ji la soob, mu dëggaate jaamam bii,","poem":1},{"lineBreak":true},{"text":"teg koy naqar,","poem":1},{"lineBreak":true},{"text":"su nangoo doon saraxu peyug tooñ,","poem":1},{"lineBreak":true},{"text":"gis askanam, aw fanam gudd,","poem":1},{"lineBreak":true},{"text":"te coobarey Aji Sax ji ci moom lay sottee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mooy sonn ba gisug leer, doyloo ko.","poem":1},{"lineBreak":true},{"text":"Ñu bareey xam sama jaam bii di Aji Jub,","poem":1},{"lineBreak":true},{"text":"mu def ñu bare, ñu ñu limal njub,","poem":1},{"lineBreak":true},{"text":"ndax li mu sëfoo seeni ñaawtéef.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moo tax ma di ko jox ab cér","poem":1},{"text":"ci biir ñu bare,","poem":2},{"text":"mu séddoo ak ay kàngam alalu xareem,","poem":1},{"lineBreak":true},{"text":"ngir moo jébbale bakkanu boppam,","poem":1},{"lineBreak":true},{"text":"ñu limaale kooki tooñkat,","poem":1},{"lineBreak":true},{"text":"moo gàddu bàkkaaru ñu bare","poem":1},{"lineBreak":true},{"text":"te mooy tinul moykat yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}