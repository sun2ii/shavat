{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":55,"content":[{"type":"heading","content":["Aji Sax ji woote na njéggal"]},{"type":"verse","number":1,"content":[{"text":"«Éey, yeen ñi mar ñépp,","poem":1},{"lineBreak":true},{"text":"dikkleen ci ndox mi,","poem":1},{"lineBreak":true},{"text":"ba ci ku amul xaalis sax!","poem":1},{"lineBreak":true},{"text":"Dikkleen jënd pepp, lekk!","poem":1},{"lineBreak":true},{"text":"Dikkleen jënd pepp mu xaalis jëndul,","poem":1},{"lineBreak":true},{"text":"ak biiñ ak meew mu amul pey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ana lu ngeen di waññe xaalis,","poem":1},{"lineBreak":true},{"text":"di ko jënde lu dul aw ñam?","poem":1},{"lineBreak":true},{"text":"Ana lu ngeen di sonn,","poem":1},{"lineBreak":true},{"text":"di jënde lu dul reggal?","poem":1},{"lineBreak":true},{"text":"Dégluleen maa déglu, ba lekk lu leen di dundal,","poem":1},{"lineBreak":true},{"text":"di xéewloo seen ngëneelu bakkan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teewluleen te dikk fi man.","poem":1},{"lineBreak":true},{"text":"Dégluleen, ba mana dund,","poem":1},{"lineBreak":true},{"text":"ma fas ak yeen kóllëre gu sax","poem":1},{"text":"gi ma ji Daawuda ci ngor gu wóor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ab seedee ngoog, ñeel xeet yi,","poem":1},{"lineBreak":true},{"text":"muy njiit, yilif xeet yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma ne, aw xeet woo xamul ngay woowi,","poem":1},{"lineBreak":true},{"text":"xeet wu la xamul ay dawsi ba ci yaw,","poem":1},{"lineBreak":true},{"text":"ngir sa Yàlla Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"Aji Sell ju Israayil,","poem":1},{"lineBreak":true},{"text":"nde moo la teral.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wërleen Aji Sax ji ci bi ngeen koy mana gis,","poem":1},{"lineBreak":true},{"text":"wooleen ko ci bi muy jege.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na ku bon ba jëfinam,","poem":1},{"lineBreak":true},{"text":"kuy def lu ñaaw fomm mébétam,","poem":1},{"lineBreak":true},{"text":"te walbatiku ci Aji Sax ji sunu Yàlla,","poem":1},{"lineBreak":true},{"text":"mu yërëm ko, yaatal njéggalam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Samay xalaat déy du seeni xalaat,","poem":1},{"lineBreak":true},{"text":"te samay jëfin du seeni jëfin.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mu ne: «Ni asamaan tiime suuf,","poem":1},{"lineBreak":true},{"text":"ni la samay jëfin tiime seeni jëfin,","poem":1},{"lineBreak":true},{"text":"samay xalaat it tiime ko seeni xalaat.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ab taw ak tawub yuur ay wàcce asamaan,","poem":1},{"lineBreak":true},{"text":"du fa dellu,","poem":1},{"lineBreak":true},{"text":"te suuxatul suuf,","poem":1},{"lineBreak":true},{"text":"saxal ko, meññal ko,","poem":1},{"lineBreak":true},{"text":"ba kuy ji, mu may la jiwu;","poem":1},{"lineBreak":true},{"text":"kuy lekk, mu may lam pepp.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sama kàddu giy bawoo sama gémmiñ it, noonu la.","poem":1},{"lineBreak":true},{"text":"Du délsee ag neen ci man","poem":1},{"lineBreak":true},{"text":"te deful li ma namm,","poem":1},{"lineBreak":true},{"text":"ba sottal li ma ko yebal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Mbégte déy, ngeen di génne,","poem":1},{"lineBreak":true},{"text":"ñu yóbbu leen ci jàmm,","poem":1},{"lineBreak":true},{"text":"tund yu mag yeek yu ndaw yi","poem":1},{"lineBreak":true},{"text":"di leen sarxolleel,","poem":1},{"lineBreak":true},{"text":"garabi àll bi yépp tàccoondoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Garab gu dul ruus ay wuutub gajj,","poem":1},{"lineBreak":true},{"text":"garab gu dëkke naat wuutub taxas,","poem":1},{"lineBreak":true},{"text":"muy woyu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te di firnde ju sax,","poem":1},{"lineBreak":true},{"text":"du dog mukk.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}