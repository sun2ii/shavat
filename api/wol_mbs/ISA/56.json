{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":56,"content":[{"type":"heading","content":["Xeet yépp la Aji Sax jiy ñoñoo"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Sàmmleen yoon, di def dëgg.","poem":1},{"lineBreak":true},{"text":"Sama wall kat a ngi dikk léegi,","poem":1},{"lineBreak":true},{"text":"sama àtte laa ne, léegi mu teew.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndokkalee kuy jëfe lii,","poem":1},{"lineBreak":true},{"text":"ndokkalee doom aadama ju jàppoo lii,","poem":1},{"lineBreak":true},{"text":"di sàmm bésub Noflaay,","poem":1},{"lineBreak":true},{"text":"bañ koo ñàkke worma,","poem":1},{"lineBreak":true},{"text":"di sàmm loxoom ci jépp jëf ju bon.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Doomu doxandéem bu jokku ci Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"bumu ne: «Aji Sax jee may beddee beddi ci ñoñam.»","poem":1},{"lineBreak":true},{"text":"Jaam bu ñu xañ ngóora it bumu ne:","poem":1},{"lineBreak":true},{"text":"«Man garab gu jaasir doŋŋ laa.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji kat dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Jaam yi ñu xañ ngóora,","poem":1},{"lineBreak":true},{"text":"su ñu sàmmee sama bési Noflaay,","poem":1},{"lineBreak":true},{"text":"taamu sama coobare,","poem":1},{"lineBreak":true},{"text":"tey feddali sama kóllëre,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"maa leen di may ci sama biir kër, sama biir ëtt,","poem":1},{"lineBreak":true},{"text":"doj wu ñu leen di fàttalikoo","poem":1},{"lineBreak":true},{"text":"ak tur wu leen di gënal doom yu góor ak yu jigéen.","poem":1},{"lineBreak":true},{"text":"Tur wu sax dàkk laay may","poem":1},{"text":"jaam yi ñu xañ ngóora,","poem":2},{"text":"te du fey mukk","poem":1},{"noteId":35},{"text":".","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Doomi doxandéem yi ànd ak Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ngir liggéeyal ko,","poem":1},{"lineBreak":true},{"text":"ngir sopp turu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te di ay jaamam,","poem":1},{"lineBreak":true},{"text":"muy képp kuy sàmm bésub Noflaay,","poem":1},{"lineBreak":true},{"text":"baña ñàkke worma bés bi,","poem":1},{"lineBreak":true},{"text":"xanaa di feddali sama kóllëre,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ñooñu, maa leen di yóbbu","poem":1},{"text":"sama kaw tund wu sell,","poem":2},{"text":"bànneexale leen sama biir kërug ñaan.","poem":1},{"lineBreak":true},{"text":"Seen saraxu rendi-dóomal ak yeneen sarax,","poem":1},{"lineBreak":true},{"text":"dees na leen ko nangul sama kaw sarxalukaay;","poem":1},{"lineBreak":true},{"text":"ndaxte sama kër gi, kërug ñaan lees ko tudde,","poem":1},{"text":"ñeel xeetoo xeet.»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kàddug Boroom bi Aji Sax jaa ngii,","poem":1},{"lineBreak":true},{"text":"kiy dajale giiri Israayil yi tasaaroo,","poem":1},{"lineBreak":true},{"text":"mu ne: «Maay dajaleeti,","poem":1},{"lineBreak":true},{"text":"dolli ca la ma dajale woon.»","poem":1}]},{"type":"heading","content":["Ab daan ñeel na njiit yi"]},{"type":"verse","number":9,"content":[{"text":"Yeen rabi àll yi,","poem":1},{"lineBreak":true},{"text":"dikkleen ci bernde ji,","poem":1},{"lineBreak":true},{"text":"yeen rabi gott bi yépp.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wattukati Israayil yépp a silmaxa,","poem":1},{"lineBreak":true},{"text":"te xamuñu dara.","poem":1},{"lineBreak":true},{"text":"Ñoom ñépp a diy xaj yu luu,","poem":1},{"lineBreak":true},{"text":"manuñoo baw,","poem":1},{"lineBreak":true},{"text":"xanaa tëdd di jeneer,","poem":1},{"lineBreak":true},{"text":"soppi nelaw.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xaj yu tiit a tiit lañu,","poem":1},{"lineBreak":true},{"text":"xamuñu suur,","poem":1},{"lineBreak":true},{"text":"te ñooy sàmm yéey!","poem":1},{"lineBreak":true},{"text":"Ñoom ñépp, kenn manu cee xam dara,","poem":1},{"lineBreak":true},{"text":"seen yoonu bopp lañu topp,","poem":1},{"lineBreak":true},{"text":"ak seen amin wu lewul.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ña nga naa: «Dikkleen, ma indi biiñ,","poem":1},{"lineBreak":true},{"text":"nu màndeew ñoll tey ak ëllëg,","poem":1},{"lineBreak":true},{"text":"li fi des du jeex.»","poem":1}]}],"footnotes":[{"noteId":35,"caller":"+","text":"56.5 Seetal ci Sarxalkat yi 21.16-20.","reference":{"chapter":56,"verse":5}}]},"thisChapterLink":"/api/wol_mbs/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}