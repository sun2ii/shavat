{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":57,"content":[{"type":"heading","content":["Ab daan ñeel na moykat yi"]},{"type":"verse","number":1,"content":[{"text":"Aji jub ñaa ngi dee,","poem":1},{"lineBreak":true},{"text":"te kenn yégalu ko yaramam.","poem":1},{"lineBreak":true},{"text":"Gor ñaa ngi faatu,","poem":1},{"lineBreak":true},{"text":"te kenn ràññeewul","poem":1},{"lineBreak":true},{"text":"ne aji jub ji, faatoom, musiba la koy moyale.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kiy am jàmm ëllëg,","poem":1},{"lineBreak":true},{"text":"di am noflaay ci biir tëraayam,","poem":1},{"lineBreak":true},{"text":"mooy kiy wéye njub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waaye yeen, dikkleen fii,","poem":1},{"lineBreak":true},{"text":"yeen doomi xërëmkat yi,","poem":1},{"lineBreak":true},{"text":"yeen askanu njaalookat yiy gànctu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ana ku ngeen di ñaawal?","poem":1},{"lineBreak":true},{"text":"Ana ku ngeen di ŋóobi,","poem":1},{"lineBreak":true},{"text":"ak di ko kókkali?","poem":1},{"lineBreak":true},{"text":"Xanaa dungeen doomi moykat,","poem":1},{"lineBreak":true},{"text":"di askanu workat,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"di xabtaloo bànneex","poem":1},{"lineBreak":true},{"text":"ci ker garab yu mag yi,","poem":1},{"lineBreak":true},{"text":"ak ker garaboo garab gu naat,","poem":1},{"lineBreak":true},{"text":"di rendi seeni doom ci yoonu ndox yi,","poem":1},{"lineBreak":true},{"text":"ak xarantey doj yi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw Israayil, jëlal doj yu rattax","poem":1},{"text":"yi ci yoonu ndox wi, séddoo,","poem":2},{"text":"muy sa cér, nga muurloo!","poem":1},{"lineBreak":true},{"text":"Ñoom ngay tuural,","poem":1},{"lineBreak":true},{"text":"di leen defal ay saraxi pepp.","poem":1},{"lineBreak":true},{"text":"Waaye Aji Sax ji nee:","poem":1},{"lineBreak":true},{"text":"«Ndax damay jéllale?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tund wu mag te kawe,","poem":1},{"lineBreak":true},{"text":"nga fàkk fa tëraay,","poem":1},{"lineBreak":true},{"text":"yéeg fa, di fa sarxalal.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaa takk say baaxantal","poem":1},{"lineBreak":true},{"text":"ci sa lafu bunt ak sa jëni bunt,","poem":1},{"lineBreak":true},{"text":"yaa ma wacc, di ñorikoo feneen,","poem":1},{"lineBreak":true},{"text":"yéeg sab lal, yaatal.","poem":1},{"lineBreak":true},{"text":"Yaa takktook ñii nga soppa tëddal","poem":1},{"lineBreak":true},{"text":"te safoo di niir seeni cér.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaa tukki ba ca buur ba, yóbbaaleg diw,","poem":1},{"lineBreak":true},{"text":"ak cuuraay lu ne gàññ,","poem":1},{"lineBreak":true},{"text":"yebal say ndaw fu sore,","poem":1},{"lineBreak":true},{"text":"ba ñu àkki njaniiw.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tukki bu sore bu la sonal sax","poem":1},{"lineBreak":true},{"text":"taxu la ne: «Fomm naa.»","poem":1},{"lineBreak":true},{"text":"Bànneex bi ngay séentu ngay leqalikoo,","poem":1},{"lineBreak":true},{"text":"ba tax sonnuloo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Aji Sax ji nee: «Ana kooy tiit,","poem":1},{"lineBreak":true},{"text":"ak koo ragal ba di ma wor,","poem":1},{"lineBreak":true},{"text":"fàttalikootoo ma,","poem":1},{"lineBreak":true},{"text":"faaleetoo ma?","poem":1},{"lineBreak":true},{"text":"Damaa noppi lu yàgg daal,","poem":1},{"lineBreak":true},{"text":"ba tax ragalatoo ma?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Defe nga ne yoon nga defee,","poem":1},{"lineBreak":true},{"text":"waaye dinaa la weer,","poem":1},{"lineBreak":true},{"text":"te sa jëf du la jariñ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Boo wootee wall,","poem":1},{"lineBreak":true},{"text":"na la sa gàngooru tuur xettali.","poem":1},{"lineBreak":true},{"text":"Ñoom ñépp la ngelaw di buub,","poem":1},{"lineBreak":true},{"text":"callweer yóbbu leen.","poem":1},{"lineBreak":true},{"text":"Waaye ku ma làqoo,","poem":1},{"lineBreak":true},{"text":"kookooy moom réew mi,","poem":1},{"lineBreak":true},{"text":"séddoo sama tund wu sell wi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dees na ne: «Maasaleleenoo, maasaleleen,","poem":1},{"lineBreak":true},{"text":"yaatalleen yoon wi,","poem":1},{"lineBreak":true},{"text":"te jële luy pakk ci sama yoonu ñoñ.»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ku màgg, Ku kawe ki,","poem":1},{"lineBreak":true},{"text":"ki màkkaanam sax dàkk","poem":1},{"lineBreak":true},{"text":"te turam sell, daa wax ne:","poem":1},{"lineBreak":true},{"text":"«Fu kawe te sell laa màkkaanoo,","poem":1},{"lineBreak":true},{"text":"maa dëkk ak boroom xol bu mokk te toroxlu,","poem":1},{"lineBreak":true},{"text":"ngir leqali ku toroxlu,","poem":1},{"lineBreak":true},{"text":"leqali boroom xol bu mokk.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Duma wéye di sikke ba fàww,","poem":1},{"lineBreak":true},{"text":"duma saxoo di mer,","poem":1},{"lineBreak":true},{"text":"lu ko moy képp ku ma sàkk","poem":1},{"lineBreak":true},{"text":"day tàggook bakkanam.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ñaawtéefi Israayil ak alalam ju lewul","poem":1},{"text":"moo ma merloo,","poem":2},{"text":"ma duma ko, xañ ko sama kanam,","poem":1},{"lineBreak":true},{"text":"waaye mu të ticc, topp xolam.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xam naa jikkoom,","poem":1},{"lineBreak":true},{"text":"waaye maa koy faj,","poem":1},{"lineBreak":true},{"text":"wommat ko,","poem":1},{"lineBreak":true},{"text":"dëfale koy xéewal,","poem":1},{"lineBreak":true},{"text":"mook ñiy ñaawloondook moom.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Maay teg ci seen làmmiñ kàddug cant.","poem":1},{"lineBreak":true},{"text":"Jàmm, na jàmm ñeel ñépp,","poem":1},{"lineBreak":true},{"text":"ku soreek ku jege.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee.","poem":1},{"lineBreak":true},{"text":"Mu ne: «Maa leen di faj.»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Waaye ñu bon ñi, mbete géej","poem":1},{"text":"gu sàmbaraax, tëë dal,","poem":2},{"text":"gannax yay baaje ban ak suuf.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sama Yàlla nee:","poem":1},{"lineBreak":true},{"text":"«Jàmm du ñeel ñu bon ñi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}