{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Ni sawara di jafale boob,","poem":1},{"lineBreak":true},{"text":"baxale ko am ndox,","poem":1},{"lineBreak":true},{"text":"ni ngay xamalsee say noon saw tur,","poem":1},{"lineBreak":true},{"text":"ba yooyu xeet di lox fi sa kanam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ba ngay def kiraama ya ñu séentuwuloon,","poem":1},{"lineBreak":true},{"text":"yaa wàcc, tund yi yëngu fi sa kanam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ca cosaan ba tey maseesula dégg,","poem":1},{"lineBreak":true},{"text":"nopp masula dégmati,","poem":1},{"lineBreak":true},{"text":"bët masula gis yàlla ju la moy,","poem":1},{"lineBreak":true},{"text":"mu defal nii ku ko yaakaar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaay gatandu kiy bége njekk gi muy jëfe","poem":1},{"lineBreak":true},{"text":"te di ba xel say yoon","poem":1},{"text":"yi ñu mas di jaare, ba mucc.","poem":2},{"text":"Waaye kat, yaa nu mere, ndax noo bàkkaar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nun ñépp a mujj mel ni sobe,","poem":1},{"lineBreak":true},{"text":"ni sagaru sobe la sunu gépp njekk mel.","poem":1},{"lineBreak":true},{"text":"Nu ngii nun ñépp mel ni xob wu lax,","poem":1},{"lineBreak":true},{"text":"sunuy tooñ buub nu, yóbbu ni ngelaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Du kenn kuy wormaal sa tur,","poem":1},{"lineBreak":true},{"text":"mbaa mu yewwu ba jàpp ci yaw,","poem":1},{"lineBreak":true},{"text":"yaa nu làq saw yiw,","poem":1},{"lineBreak":true},{"text":"yaa nu def ban bu tooy","poem":1},{"lineBreak":true},{"text":"ci sunu biir ñaawtéef yi nu tanc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waaye déy, Aji Sax ji, yaa di sunu baay;","poem":1},{"lineBreak":true},{"text":"noo di ban, yaw ngay tabaxkatu njaq,","poem":1},{"lineBreak":true},{"text":"nun ñépp di sa liggéeyu loxo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, bul mer lool,","poem":1},{"lineBreak":true},{"text":"bul bàyyi xel fàww ci ñaawtéef.","poem":1},{"lineBreak":true},{"text":"Ngalla seetal ne nooy sa ñoñ, nun ñépp.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Say dëkk yu sell doon nañu màndiŋ,","poem":1},{"lineBreak":true},{"text":"Siyoŋ ca la, doon na màndiŋ.","poem":1},{"lineBreak":true},{"text":"Yerusalem laa ne, gental na!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sunu kërug jaamookaay gu sell ga te tedd,","poem":1},{"lineBreak":true},{"text":"fa la sunuy maam daa màggale,","poem":1},{"lineBreak":true},{"text":"sawara xoyom na ko,","poem":1},{"lineBreak":true},{"text":"mboolem lu nu soppoon yàqu yaxeet.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, lii lépp xanaa doo ci téye sa loxo?","poem":1},{"lineBreak":true},{"text":"Xanaa doo ci seleŋlu, teg nu gàcce gu réy?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}