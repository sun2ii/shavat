{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ISA","translationId":"wol_mbs","name":"Esayi","commonName":"Esayi","title":"Téereb Yonent Yàlla Esayi","order":23,"numberOfChapters":66,"sha256":"7e422775fad0a6227a0f5cf762e61092d6a4d51a2b4bb7844d18dd52382c94c1","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/wol_mbs/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":8,"content":[{"type":"heading","content":["Asiri workat la, matul wéeruwaay"]},{"type":"verse","number":1,"content":["Gannaaw gi, Aji Sax ji ne ma: «Jëlal àlluwa ju mag, ak xalima gu jàppandi, nga bind ci lii: “Mayer Salal Xas Bas” (muy firi Sëxëtoo këfit foqet).»"]},{"type":"verse","number":2,"content":["Ma wut ci seede, won àlluwa ja ñaar ñu mat seede: ñuy Uri sarxalkat ba, ak Sàkkaryaa doomu Yeberekiya."]},{"type":"verse","number":3,"content":["Ba loolu weesoo ma jaxasoo ak sama soxna, yonent bu jigéen ba, mu ëmb, gannaaw gi mu am ca doom ju góor. Aji Sax ji ne ma: «Tudde ko “Mayer Salal Xas Bas.”"]},{"type":"verse","number":4,"content":["Bala xale bee man ne “Baay” mbaa “Yaay” déy, dees na yóbbul buurub Asiri alal ju ñu foqatee Damaas ak lël ju ñu këfe Samari, nangu ko.»"]},{"type":"verse","number":5,"content":[{"text":"Aji Sax ji dellu ne ma:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Gannaaw askan wee teddadil ndoxum Silowe","poem":1},{"text":"mi ci wal mu teey mi,","poem":2},{"text":"di bége Reccin ak doomu Remalya,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Boroom baa ngii di leen sottisi","poem":1},{"lineBreak":true},{"text":"dexu Efraat gi ne xéew ak dooleem,","poem":1},{"lineBreak":true},{"text":"te mooy buurub Asiri ak mboolem darajaam.","poem":1},{"lineBreak":true},{"text":"Dex gi mooy génn xuram,","poem":1},{"lineBreak":true},{"text":"fees fépp fu dig tàkkam,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"wal-wali jàll Yuda,","poem":1},{"lineBreak":true},{"text":"mbënn ma wal, taañaañal,","poem":1},{"lineBreak":true},{"text":"yéeg ba tollu ko ci put,","poem":1},{"lineBreak":true},{"text":"firiku niy laaf ba dajal sam réew, yaw Emanuwel.»","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yeen xeet yi, xaaculeen, dees na leen rajaxe.","poem":1},{"lineBreak":true},{"text":"Yeen waa cati àddina, teewluleen!","poem":1},{"lineBreak":true},{"text":"Gañoo gañu, ñu rajaxe leen!","poem":1},{"lineBreak":true},{"text":"Ma ne: Gañoo gañu, ñu rajaxe leen!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ngeen mébét, dara!","poem":1},{"lineBreak":true},{"text":"Ngeen diisoo, diisoo, tus!","poem":1},{"lineBreak":true},{"text":"Yàllaa ànd ak nun!","poem":1}]},{"type":"heading","content":["Aji Sax jee jara ragal"]},{"type":"verse","number":11,"content":[{"text":"Aji Sax ji moo wax ak man,","poem":1},{"lineBreak":true},{"text":"ba mu ma nee nikk, artu ma,","poem":1},{"lineBreak":true},{"text":"ngir ma baña roy askan wii. Mu ne ma:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"«Bul tudde wor,","poem":1},{"lineBreak":true},{"text":"lenn lu askan wii tudde wor;","poem":1},{"lineBreak":true},{"text":"lu ñu ragal it, bu ko ragal,","poem":1},{"lineBreak":true},{"text":"bu ko tiit.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi daal ngay sellal,","poem":1},{"lineBreak":true},{"text":"moom ngay ragal,","poem":1},{"lineBreak":true},{"text":"moom ngay tiit.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mu doon seen kër gu sell,","poem":1},{"lineBreak":true},{"text":"di itam doj wuy fakkastale,","poem":1},{"lineBreak":true},{"text":"xeer wuy daaneel, ci ñaari këri Israayil,","poem":1},{"lineBreak":true},{"text":"te dim yeer, dig fiir,","poem":1},{"lineBreak":true},{"text":"ñeel ku dëkk Yerusalem.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñu baree cay tërëf,","poem":1},{"lineBreak":true},{"text":"daanu, damm,","poem":1},{"lineBreak":true},{"text":"mbaa ñu sërëx, keppu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dencal seede bii,","poem":1},{"lineBreak":true},{"text":"jëlal lii ndigal, tay cib tayu,","poem":1},{"lineBreak":true},{"text":"dénk ko samay dongo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Maa ngi séentu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"mu ngi won waa kër Yanqóoba gannaaw,","poem":1},{"lineBreak":true},{"text":"waaye maa ngi koy yaakaar.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Man de, maa ngii, maak xale yi ma Aji Sax ji may,","poem":1},{"lineBreak":true},{"text":"nu diy firnde fi Israayil te diy tegtal","poem":1},{"text":"yu bàyyikoo fa Aji Sax ji Boroom gàngoor yi,","poem":2},{"lineBreak":true},{"text":"ki dëkke tundu Siyoŋ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Am na ñu naan:","poem":1},{"lineBreak":true},{"text":"«Laajleen boroomi rawaan,","poem":1},{"lineBreak":true},{"text":"ak ñiy gisaane nit ñu dee te di kebetooka ŋun-ŋuni.","poem":1},{"lineBreak":true},{"text":"Aw xeet sañ nañoo gisaanee seeni tuur,","poem":1},{"lineBreak":true},{"text":"tey diis ñi dee mbiri ñiy dund.»","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kon waxleen ne leen: «Ayca, delluleen ca ndigali yoon ya,","poem":1},{"text":"ak seedey kàdduy waxyu ya.","poem":2},{"text":"Kuy wax googu kàddu, ag leer fenkalu la.»","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nit ñi dinañu taxawaalu ci réew mi,","poem":1},{"lineBreak":true},{"text":"boole njàqareekub xiif,","poem":1},{"lineBreak":true},{"text":"te bu ñu xiifee, ñéññ,","poem":1},{"lineBreak":true},{"text":"téen, xool kaw,","poem":1},{"lineBreak":true},{"text":"saaga seen buur, saaga Yàlla,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"dellu xool fi suuf,","poem":1},{"lineBreak":true},{"text":"yem ciw tiis, ak lëndëmu njàqare,","poem":1},{"lineBreak":true},{"text":"sóoboo guddi gu fatt taraj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Waaye lëndëm googu du sax","poem":1},{"lineBreak":true},{"text":"ci réew mii jàq tey.","poem":1},{"lineBreak":true},{"text":"Démb Aji Sax ji toroxal na","poem":1},{"text":"réewum Sabulon ak réewum Neftali,","poem":2},{"text":"waaye ëllëg mu teral waa foofa,","poem":1},{"lineBreak":true},{"text":"dale ko diiwaanu tefesu géej,","poem":1},{"lineBreak":true},{"text":"ba ca wàllaa dexu Yurdan,","poem":1},{"lineBreak":true},{"text":"boole ca sax Galile ga ca doxandéem ya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}