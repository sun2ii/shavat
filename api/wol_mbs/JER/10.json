{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":10,"content":[{"type":"heading","content":["Aji Sax ji du moroomu xërëm"]},{"type":"verse","number":1,"content":[{"text":"Yeen bànni Israayil, dégluleen kàddu","poem":1},{"lineBreak":true},{"text":"gi leen Aji Sax ji dégtal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Jikkoy xeeti yéefar yi, buleen ko roy;","poem":1},{"lineBreak":true},{"text":"màndargam asamaan, buleen ko tiit;","poem":1},{"lineBreak":true},{"text":"na ko yéefar yi tiit.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aaday xeet yi kat neen la.","poem":1},{"lineBreak":true},{"text":"Garab lañuy gore ca gott ba,","poem":1},{"lineBreak":true},{"text":"ab yattkat yatte ko sémmiñ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"rafetale xaalis ak wurus,","poem":1},{"lineBreak":true},{"text":"daaj koy pont, dëgëral,","poem":1},{"lineBreak":true},{"text":"ba du yëngu;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"muy saf kuñeental ci biir tóokërub xaal.","poem":1},{"lineBreak":true},{"text":"Du wax, du séqi jéego,","poem":1},{"lineBreak":true},{"text":"ñu di ko jaŋat-jaŋatee.","poem":1},{"lineBreak":true},{"text":"Buleen ko ragal, du lore, du jariñe.»","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Aji Sax ji, kenn melul ni yaw,","poem":1},{"lineBreak":true},{"text":"yaaka màgg, jàmbaare, màggu tur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaw Buuru xeet yi, ana ku la dul ragal?","poem":1},{"lineBreak":true},{"text":"Yaw déy yaa yelloo ragal.","poem":1},{"lineBreak":true},{"text":"Mboolem ñi xelu ci xeet yi","poem":1},{"lineBreak":true},{"text":"ak mboolem seeni buur,","poem":1},{"lineBreak":true},{"text":"kenn melul ni yaw.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñoom ñépp a bokk dofe, ñàkk bopp:","poem":1},{"lineBreak":true},{"text":"xam-xamu kasara, bant kese!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xaalis lañuy jële Tarsis, xoobe ko bant,","poem":1},{"lineBreak":true},{"text":"wurus wu jóge Ufas, ñu boole ca,","poem":1},{"lineBreak":true},{"text":"ndaanaan liggéey ko,","poem":1},{"lineBreak":true},{"text":"tëggu gànjar yatt ko,","poem":1},{"lineBreak":true},{"text":"ñu solal ko ndimo lu yolet","poem":1},{"lineBreak":true},{"text":"ak lu xonq curr,","poem":1},{"lineBreak":true},{"text":"lépp di liggéeyu ràbb yu xareñ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waaye Aji Sax jeey Yàlla dëgg.","poem":1},{"lineBreak":true},{"text":"Mooy Yàlla jiy dund,","poem":1},{"lineBreak":true},{"text":"di buur ba fàww,","poem":1},{"lineBreak":true},{"text":"xadaram gësëm àddina,","poem":1},{"lineBreak":true},{"text":"meram man xeet yi.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"«Lii nag, nangeen ko siiwal:","poem":1},{"lineBreak":true},{"text":"“Seen yàlla yi sàkkul asamaan, sàkkuñu suuf,","poem":1},{"lineBreak":true},{"text":"ñooy sànku, jóge fi suuf ak fi asamaan tiim.”»","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Suuf, Aji Sax jee ko sàkke kàttanam;","poem":1},{"lineBreak":true},{"text":"dun bi, mu sampem xelam;","poem":1},{"lineBreak":true},{"text":"asamaan, mu lale xam-xamam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bu àddoo, ndoxum asamaan riir;","poem":1},{"lineBreak":true},{"text":"mu yéegey niir fa cati àddina,","poem":1},{"lineBreak":true},{"text":"riddee ngelaw fa dencam ya,","poem":1},{"lineBreak":true},{"text":"daldi melax, taw.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nitoo nit dim sanax, sore xam-xam,","poem":1},{"lineBreak":true},{"text":"te képp kuy tëgg sa jëmmu tuur, yaa añe gàcce.","poem":1},{"lineBreak":true},{"text":"Sa jëmmi weñ ji nga xelli, di neenug neen,","poem":1},{"lineBreak":true},{"text":"noowug bakkan, tus!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cóolóolu neen, liggéeyu caaxaan;","poem":1},{"lineBreak":true},{"text":"bu bésam taxawee, mu sànku.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ki séddoo Yanqóoba déy wuute naak yii caaxaan.","poem":1},{"lineBreak":true},{"text":"Kee bind lépp,","poem":1},{"lineBreak":true},{"text":"te Israayil di giir gi mu séddoo.","poem":1},{"lineBreak":true},{"text":"Kookooy Aji Sax ji Boroom gàngoori xare yi!","poem":1}]},{"type":"heading","content":["Mbugal dikk na"]},{"type":"verse","number":17,"content":[{"text":"Yerusalemee, yeen ñi ñu gaw,","poem":1},{"lineBreak":true},{"text":"forleen seen ëmb.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aji Sax ji déy dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Maa ngii naa xërr waa réew mi bii yoon,","poem":1},{"lineBreak":true},{"text":"teg leen njàqare, ba ñu yég ko.»","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Wóoy man, yàqu naa!","poem":1},{"lineBreak":true},{"text":"Ndaw góom bu metti!","poem":1},{"lineBreak":true},{"text":"Dama noon lii jàngoro doŋŋ a,","poem":1},{"lineBreak":true},{"text":"naa muñ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Xayma xotatoo,","poem":1},{"lineBreak":true},{"text":"buumi xayma xëttandoo,","poem":1},{"lineBreak":true},{"text":"samay doom wacc ma, ne mes;","poem":1},{"lineBreak":true},{"text":"kenn sampatul sama xayma, firi ko.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Sàmmi xeet weeka dofe:","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, diisoowuñook moom.","poem":1},{"lineBreak":true},{"text":"Moo leen taxa bonle,","poem":1},{"lineBreak":true},{"text":"seen jur gépp tasaaroo","poem":1},{"noteId":15},{"text":".","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Xibaar a ngoog, di ñëw,","poem":1},{"lineBreak":true},{"text":"riir mu réy a yëngoo réewum bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"nara gental dëkki Yuda yu mag yi,","poem":1},{"lineBreak":true},{"text":"till yi dëkke.","poem":1}]},{"type":"heading","content":["Yeremi tinu na Aji Sax ji"]},{"type":"verse","number":23,"content":[{"text":"Aji Sax ji, maa xam ne","poem":1},{"lineBreak":true},{"text":"nit moomul yoonam,","poem":1},{"lineBreak":true},{"text":"kuy dox moomuli jéegoom.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yar ma lu yem,","poem":1},{"lineBreak":true},{"text":"te bañ maa yare mer,","poem":1},{"lineBreak":true},{"text":"di ma semmal.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Xëppal sa xadar yéefar yi la yégul,","poem":1},{"lineBreak":true},{"text":"ak làng yi la tuddul.","poem":1},{"lineBreak":true},{"text":"Ñoo mëdd giirug Yanqóoba,","poem":1},{"lineBreak":true},{"text":"mëdd leen, bóom leen,","poem":1},{"lineBreak":true},{"text":"gental seen dëkkuwaay.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"10.21 Seetal ci saar 23.","reference":{"chapter":10,"verse":21}}]},"thisChapterLink":"/api/wol_mbs/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}