{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":17,"content":[{"type":"heading","content":["Aji Sax ji sikk na waa Yuda"]},{"type":"verse","number":1,"content":[{"text":"«Bàkkaaru waa Yuda lañu binde xaccug weñ","poem":1},{"lineBreak":true},{"text":"gu cat la di doj wu dëgër.","poem":1},{"lineBreak":true},{"text":"Dees koo ñaas ci seen àlluway xol,","poem":1},{"lineBreak":true},{"text":"ñaas ko ci seen béjjéni sarxalukaay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Seeni doom sax di bàyyi xel seeni sarxalukaay","poem":1},{"lineBreak":true},{"text":"ak seen xer yi ñuy màggale tuurum Asera","poem":1},{"lineBreak":true},{"text":"fi ker garab yu naat yeek","poem":1},{"lineBreak":true},{"text":"kaw tund yu mag yi","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ak kaw tund yi ci àll bi.","poem":1},{"lineBreak":true},{"text":"Seen alal ak seen denc yépp","poem":1},{"lineBreak":true},{"text":"laay joxe, ñu lël ko,","poem":1},{"lineBreak":true},{"text":"booleek seen bérebi jaamookaay","poem":1},{"lineBreak":true},{"text":"ndax seen moy yi dajal réew mi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dingeen xañ seen bopp cér bi ma leen séddoon,","poem":1},{"lineBreak":true},{"text":"ma def leen seen jaami noon","poem":1},{"lineBreak":true},{"text":"ci réew mu ngeen xamul,","poem":1},{"lineBreak":true},{"text":"ndax merloo ngeen ma","poem":1},{"lineBreak":true},{"text":"mer mu dul fey mukk.»","poem":1}]},{"type":"heading","content":["Aji Sax jee jara yaakaar"]},{"type":"verse","number":5,"content":[{"text":"Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Alkànde ñeel na ku yaakaar doom aadama","poem":1},{"lineBreak":true},{"text":"ak képp kuy doolewoo nit,","poem":1},{"lineBreak":true},{"text":"dëddu Aji Sax ji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Day mel ni gajjub ndànd-foyfoy,","poem":1},{"lineBreak":true},{"text":"du gis ngëneel luy dikk!","poem":1},{"lineBreak":true},{"text":"Day dëkk ci màndiŋ mu wow koŋŋ,","poem":1},{"lineBreak":true},{"text":"suufas xorom su kenn dëkkul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waaye barke ñeel na ku wóolu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"yaakaar Aji Sax ji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Day mel ni garab gu saxe wetu ndox,","poem":1},{"lineBreak":true},{"text":"lawal ay reenam ca wal ma,","poem":1},{"lineBreak":true},{"text":"ragalul tàngoor wu dikk,","poem":1},{"lineBreak":true},{"text":"xob ya di naat.","poem":1},{"lineBreak":true},{"text":"Du tiit atum maral,","poem":1},{"lineBreak":true},{"text":"du ñàkk meññeef.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Dara gënula dëng xelum nit,","poem":1},{"lineBreak":true},{"text":"laago la ci moom.","poem":1},{"lineBreak":true},{"text":"Ana ku ko mana xam?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maay Aji Sax jiy seetlu xel,","poem":1},{"lineBreak":true},{"text":"di natt ab xol,","poem":1},{"lineBreak":true},{"text":"di yool ku nekk jëfinam,","poem":1},{"lineBreak":true},{"text":"la yellook añam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kuy jagoo alal ju lewul,","poem":1},{"lineBreak":true},{"text":"mooy picc mu toj lu mu nenul.","poem":1},{"lineBreak":true},{"text":"Kookooy tollu digg dooleem, alal ja dëddu,","poem":1},{"lineBreak":true},{"text":"mu mujj dof.»","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Sunu kër gu sell gi,","poem":1},{"lineBreak":true},{"text":"mooy ngànguney daraja, daa masa kawe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaw Aji Sax ji yaakaaru Israayil,","poem":1},{"lineBreak":true},{"text":"ku la wacc, torox;","poem":1},{"lineBreak":true},{"text":"ku la dëddu daa repp.","poem":1},{"lineBreak":true},{"text":"Moo wacc Aji Sax ji, bëtu ndox miy dund.","poem":1}]},{"type":"heading","content":["Yeremi ñaan na Yàlla wall"]},{"type":"verse","number":14,"content":[{"text":"Éy Aji Sax ji, faj ma, ma faju;","poem":1},{"lineBreak":true},{"text":"musal ma, ma mucc,","poem":1},{"lineBreak":true},{"text":"samag cant, yaw a.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñu ngii naa ma:","poem":1},{"lineBreak":true},{"text":"«Ana la Aji Sax ji waxoon?","poem":1},{"lineBreak":true},{"text":"Na dikk boog!»","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Man de, bañuma laa sàmmal, topp la;","poem":1},{"lineBreak":true},{"text":"bésub tiis it dagaanuma ko.","poem":1},{"lineBreak":true},{"text":"Yaw de xam nga ko.","poem":1},{"lineBreak":true},{"text":"Li ma wax it fi sa kanam la.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bu ma teg tiitaange,","poem":1},{"lineBreak":true},{"text":"yaay sama rawtu bésub safaan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ngalla gàcceelal ñi ma topp,","poem":1},{"lineBreak":true},{"text":"te bu ma gàcceel;","poem":1},{"lineBreak":true},{"text":"yal nañu tiit, ñoom,","poem":1},{"lineBreak":true},{"text":"te man, ma baña tiit.","poem":1},{"lineBreak":true},{"text":"Rikk dikke leen bésub safaan,","poem":1},{"lineBreak":true},{"text":"rajaxe leen ñaari yoon.","poem":1}]},{"type":"heading","content":["Bésub Noflaay ñeel na Aji Sax ji"]},{"type":"verse","number":19,"content":["Aji Sax ji da maa wax ne ma: «Demal taxawi ca buntu Doomi réew mi, fa buurub Yuda di duggeeka génne. Te nga taxaw itam ca mboolem bunti Yerusalem ya ca des."]},{"type":"verse","number":20,"content":["Nga ne leen: “Dégluleen kàddug Aji Sax ji, yeen buuri Yuda ak yeen waa Yuda gépp ak képp ku dëkk Yerusalem, di jaare ci bunt yii."]},{"type":"verse","number":21,"content":["Aji Sax ji dafa wax ne: Moytuleen seen bopp ba baña gàddu lenn ci bésub Noflaay, di ko jaarale bunti Yerusalem."]},{"type":"verse","number":22,"content":["Buleen génne seeni kër lenn ci bésub Noflaay te buleen ci liggéey lenn. Waaye nangeen sellal bésub Noflaay, muy la ma santoon seeni maam."]},{"type":"verse","number":23,"content":["Ndaxam dégluwuñu ma, teewluwuñu ma, xanaa të ticc, baña dégg, di gàntal ndigal."]},{"type":"verse","number":24,"content":["Waaye su ngeen ma dégloo ba déglu ma, kàddug Aji Sax jee, baña gàddu lenn di jaare bunti dëkk bii bésub Noflaay, xanaa di sellal bésub Noflaay, bañ cee liggéey lenn,"]},{"type":"verse","number":25,"content":["su boobaa buur yiy tooge jalub Daawuda, tey dawal watiir aki fas, ñook seeni kàngam, duñu noppee jaare ci bunti dëkk bii, feggook seeni kàngam. Waa Yudaak waa Yerusalem it di jaare ci bunt yii, su ko defee dëkk bi sax dàkk."]},{"type":"verse","number":26,"content":["Dees na bàyyikoo dëkki Yuda ak li wër Yerusalem ak diiwaanu Beñamin, ca suufu tund waak kaw tund ya ak ca diiwaanu Negew. Am na ñuy indi ci kër Aji Sax ji ay saraxi rendi-dóomal ak yeneen saraxi jur ak saraxu pepp ak cuuraay. Am ñuy indi ci kër Aji Sax ji saraxi cant."]},{"type":"verse","number":27,"content":["Waaye su ngeen ma déggalul, baña sellal bésub Noflaay, baña moytoo gàddu lenn, di jaare bunti Yerusalem bésub Noflaay, su boobaa dinaa taal dëkk bi taal buy xoyom këri Yerusalem yu yànj yi, te du fey.”»"]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}