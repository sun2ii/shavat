{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"«Yaw Israayil, sooy waññiku,","poem":1},{"lineBreak":true},{"text":"waññikul fi man.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Soo jëlee fi sama kanam","poem":1},{"lineBreak":true},{"text":"sa jëf ju siblu,","poem":1},{"lineBreak":true},{"text":"te jenguloo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"xanaa nga waat ci Aji Sax jiy dund,","poem":1},{"lineBreak":true},{"text":"def ko ci dëgg ak yoon ak njub,","poem":1},{"lineBreak":true},{"text":"kon xeet yi dinañu barkeeloo Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di ko sagoo.»","poem":1}]},{"type":"verse","number":3,"content":["Aji Sax ji déy dafa wax waa Yudaak Yerusalem, ne leen:",{"text":"«Ruujleen seen tool,","poem":1},{"lineBreak":true},{"text":"buleen ji ciy dég.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yeen waa Yudaak Yerusalem, deeleen xaraf ngir Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"dogleen seen mbuñukay xol,","poem":1},{"lineBreak":true},{"text":"balaa sama xadar ne jippét ni sawara,","poem":1},{"lineBreak":true},{"text":"di tàkk te deesu ko fey","poem":1},{"lineBreak":true},{"text":"ndax seen jëf ju bon.","poem":1}]},{"type":"heading","content":["Xare jib na"]},{"type":"verse","number":5,"content":[{"text":"«Nangeen yégle lii fa Yuda,","poem":1},{"lineBreak":true},{"text":"dégtale ko fa Yerusalem,","poem":1},{"lineBreak":true},{"text":"yéenee koob bufta bi biir réew mi","poem":1},{"lineBreak":true},{"text":"te xaacu seen kem kàttan ne leen:","poem":1},{"lineBreak":true},{"text":"“Dajeleen, nu dem ca dëkk ya tata wër.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yékkatileen raaya, jubale Siyoŋ,","poem":1},{"lineBreak":true},{"text":"làqujileen, buleen taxaw,","poem":1},{"lineBreak":true},{"text":"musiba déy laay jële bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"muy safaan bu réy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Gayndee fëlle geeram,","poem":1},{"lineBreak":true},{"text":"yàqkatu xeet yee jóg, génne këram,","poem":1},{"lineBreak":true},{"text":"nara gental seeni dëkk,","poem":1},{"lineBreak":true},{"text":"ba ñu di gent yu kenn dëkkul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kon nag solleeni saaku, ñaawloo te yuuxu ne:","poem":1},{"lineBreak":true},{"text":"“Merum Aji Sax ji tàng na kat te moyu nu.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bésub keroog,» kàddug Aji Sax jee,","poem":1},{"lineBreak":true},{"text":"«xolu buur jeex, kàngam ne yàcc,","poem":1},{"lineBreak":true},{"text":"sarxalkat waaru, yonent jommi.»","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Ma ne: Éy Boroom bi Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"yaa naxlu askan wii nax yu metti,","poem":1},{"lineBreak":true},{"text":"ba nga nee: «Yerusalem jàmm lay am,»","poem":1},{"lineBreak":true},{"text":"te saamar tege ci putam.","poem":1}]},{"type":"heading","content":["Mbugal taxaw na"]},{"type":"verse","number":11,"content":[{"text":"Janti keroog dees na wax askanu Yerusalem wii, ne leen:","poem":1},{"lineBreak":true},{"text":"«Jaas bu tàng a uppe kaw tund ya ne faraas ca màndiŋ ma,","poem":1},{"lineBreak":true},{"text":"wuti sama ñoñ.","poem":1},{"lineBreak":true},{"text":"Du doon ngelaw lees di bàcceeka beese.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ngelaw lu ko ëpp doole laay indi.","poem":1},{"lineBreak":true},{"text":"Léegi maa leen di biral sama kàddug mbugal.»","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Noon baa ngii, di jóg niy niir,","poem":1},{"lineBreak":true},{"text":"watiiri xareem ni ngëlén,","poem":1},{"lineBreak":true},{"text":"fasam ya gëna gaawi jaxaay.","poem":1},{"lineBreak":true},{"text":"Wóoy ngalla nun, yàqu nan!","poem":1}]},{"type":"verse","number":14,"content":[{"text":"«Éey Yerusalem, fóotal sa xol, jële ci lu bon,","poem":1},{"lineBreak":true},{"text":"ndax nga mucc.","poem":1},{"lineBreak":true},{"text":"Foo àppal sa mébéti xol yu bon?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kàddug yéenee ngi jibe Dan,","poem":1},{"lineBreak":true},{"text":"musiba dégtu na, bawoo tundu Efrayim.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jottalileen ko xeet yi,","poem":1},{"lineBreak":true},{"text":"neleen Yerusalem:","poem":1},{"lineBreak":true},{"text":"“Songkat yaa ngii riire réew mu sore ma,","poem":1},{"lineBreak":true},{"text":"xaacoondoo fi kaw dëkki Yuda.”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ñooy gaw Yerusalem ni wattukati tool,","poem":1},{"lineBreak":true},{"text":"ndax man la gàntal.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"«Sa jëfin ak say jëf a la yóbbe lii,","poem":1},{"lineBreak":true},{"text":"sa musibaa ngoog, wex la xàtt,","poem":1},{"lineBreak":true},{"text":"di dagg sa xol.»","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Maaka jàq a jàq bay jal-jali,","poem":1},{"lineBreak":true},{"text":"sama xol biy fuddu!","poem":1},{"lineBreak":true},{"text":"Éy wii mititu xol!","poem":1},{"lineBreak":true},{"text":"Duma mana noppi,","poem":1},{"lineBreak":true},{"text":"maa dégg wooteb bufta","poem":1},{"text":"ak yuuxi xare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yéenees na rajaxoo ci kaw rajaxoo,","poem":1},{"lineBreak":true},{"text":"réew mi mépp ne tasar kay!","poem":1},{"lineBreak":true},{"text":"Jekki-jekki samay xayma tasaaroo.","poem":1},{"lineBreak":true},{"text":"Xef-xippi ndimoy xayma ya xotatoo!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xanaa duma gis ba fàww raayab noon,","poem":1},{"lineBreak":true},{"text":"buftab xare di ko feelu?","poem":1}]},{"type":"verse","number":22,"content":[{"text":"«Dofe la sama ñoñ def.","poem":1},{"lineBreak":true},{"text":"Man, xamuñu maay kan,","poem":1},{"lineBreak":true},{"text":"mbetey gone yu dul xalaat dara;","poem":1},{"lineBreak":true},{"text":"dég-dég, tus;","poem":1},{"lineBreak":true},{"text":"seen xel mépp, lu bon rekk,","poem":1},{"lineBreak":true},{"text":"lu baax, xamuñu ci tus.»","poem":1}]},{"type":"verse","number":23,"content":[{"text":"Maa xool suuf,","poem":1},{"lineBreak":true},{"text":"ndeke ma nga ne maraas, ne wëyëŋ;","poem":1},{"lineBreak":true},{"text":"ma xool asamaan,","poem":1},{"lineBreak":true},{"text":"leer amatu ca.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ma xool tund yu mag yi,","poem":1},{"lineBreak":true},{"text":"ndeke ñu ngi yëngu,","poem":1},{"lineBreak":true},{"text":"tund yu ndaw yépp di jaayu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma xoolaat, gisuma nit,","poem":1},{"lineBreak":true},{"text":"njanaaw yépp daw.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ma xool, gis suuf su nangu sa","poem":1},{"lineBreak":true},{"text":"di ndànd-foyfoy,","poem":1},{"lineBreak":true},{"text":"dëkk yépp raaf","poem":1},{"lineBreak":true},{"text":"ndax Aji Sax jeek tàngaayu sànjam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Aji Sax ji déy dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Duma tas lépp tasar,","poem":1},{"lineBreak":true},{"text":"waaye réew mi mépp ay gental.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Loolooy tax suuf di ñaawlu,","poem":1},{"lineBreak":true},{"text":"asamaan di lëndëm.","poem":1},{"lineBreak":true},{"text":"Maa ko wax, maa ko dogu;","poem":1},{"lineBreak":true},{"text":"duma dëpp, duma deltu gannaaw.»","poem":1}]},{"type":"heading","content":["Yerusalem dugg na fitna"]},{"type":"verse","number":29,"content":[{"text":"Gawar ak fittkat riir,","poem":1},{"lineBreak":true},{"text":"waa dëkk yépp fëx,","poem":1},{"lineBreak":true},{"text":"ñii tàbbiy gajj,","poem":1},{"lineBreak":true},{"text":"ñee ñalgu ci kawi doj,","poem":1},{"lineBreak":true},{"text":"ñu won dëkkoo dëkk gannaaw,","poem":1},{"lineBreak":true},{"text":"kenn desatu ca.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yaw Yerusalem mu tas mi,","poem":1},{"lineBreak":true},{"text":"ana looy def nii,","poem":1},{"lineBreak":true},{"text":"di solu ba yànj,","poem":1},{"lineBreak":true},{"text":"gànjaroo wurus,","poem":1},{"lineBreak":true},{"text":"tusngalu, yàkkleey gët?","poem":1},{"lineBreak":true},{"text":"Yaa ngi sañse ci neen:","poem":1},{"lineBreak":true},{"text":"say xéddkat wacc nañu la,","poem":1},{"lineBreak":true},{"text":"sa bakkan lañuy wut.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Baatu ndaw su jagadi laa dégg,","poem":1},{"lineBreak":true},{"text":"ma nga jàq, di matub taawam.","poem":1},{"lineBreak":true},{"text":"Baatub Siyoŋ, dëkk bu taaru baa!","poem":1},{"lineBreak":true},{"text":"Ma ngay àppaat, tàllal loxo ya,","poem":1},{"lineBreak":true},{"text":"naan: «Wóoy, ngalla man;","poem":1},{"lineBreak":true},{"text":"ne yàcc ci loxol bóomkat yi!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}