"lineBreak":true},{"text":"Jaru ko!","poem":1},{"lineBreak":true},{"text":"Maa ngii di wàcceel musiba képp kuy noyyi.","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee!","poem":1},{"lineBreak":true},{"text":"Waaye may naa la sa bakkan di sa yoolu xare,","poem":1},{"lineBreak":true},{"text":"fépp foo jëm.”»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}