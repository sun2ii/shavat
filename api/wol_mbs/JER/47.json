{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":47,"content":[{"type":"heading","content":["Lu jëm ci Filisteen ñi"]},{"type":"verse","number":1,"content":["Kàddug Aji Sax ji dikkaloon na Yonent Yàlla Yeremi jëm ci Filisteen ñi, balaa Firawna di song dëkkub Filisteen ba ñuy wax Gasa."]},{"type":"verse","number":2,"content":["Aji Sax ji dafa wax ne:",{"text":"«Ndox a ngay fuddoo bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"diy waame, walsi,","poem":1},{"lineBreak":true},{"text":"walal réew meek li ci biiram","poem":1},{"lineBreak":true},{"text":"akub dëkk ak ku ci biiram;","poem":1},{"lineBreak":true},{"text":"doom aadama yuuxu,","poem":1},{"lineBreak":true},{"text":"waa réew mépp serandoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Booba fas yaa ràmbal,","poem":1},{"lineBreak":true},{"text":"watiir ya riir,","poem":1},{"lineBreak":true},{"text":"mbegey watiir ya kar-kareendoo,","poem":1},{"lineBreak":true},{"text":"loxo yoqi, ba baay geesuwul doom,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"bésub sànkute dikkal képp kuy Filisteen,","poem":1},{"lineBreak":true},{"text":"ba dagge ci dëkk yii di Tir ak Sidon","poem":1},{"lineBreak":true},{"text":"ndimbal lu ñu dese woon.","poem":1},{"lineBreak":true},{"text":"Aji Sax jaa ngay sànk Filisteen ña des","poem":1},{"lineBreak":true},{"text":"te cosaanoo dun bu ñuy wax Keret.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Watu nel, ñaawloo dikkal na Gasa,","poem":1},{"lineBreak":true},{"text":"te wedamloo nañu Askalon.","poem":1},{"lineBreak":true},{"text":"Yeen ñi dese joor gi,","poem":1},{"lineBreak":true},{"text":"fu ngeen àppal seen yaram wi ngeen di daggat, di ko ñaawloo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngeen naa: “Wóoy saamaru Aji Sax jii,","poem":1},{"lineBreak":true},{"text":"xanaa doo noppee reye?","poem":1},{"lineBreak":true},{"text":"Dellul ci sa mbar, boog,","poem":1},{"lineBreak":true},{"text":"dallu, ne tekk!”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waaye yaw saamar, naka nga mana selaŋloo","poem":1},{"lineBreak":true},{"text":"te Aji Sax ji yebal la","poem":1},{"lineBreak":true},{"text":"ci kaw Askalon ak waa tefesu géej,","poem":1},{"lineBreak":true},{"text":"fa mu ko dogale?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}