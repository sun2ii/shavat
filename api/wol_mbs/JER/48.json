{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":48,"content":[{"type":"heading","content":["Lu jëm ci réewum Mowab"]},{"type":"verse","number":1,"content":["Lu jëm ci Mowab: Aji Sax ji Yàllay Israayil, Boroom gàngoori xare yi dafa wax ne:",{"text":"«Ngalla waa Nebo, seen dëkk ba yàqu na!","poem":1},{"lineBreak":true},{"text":"Kiryaatayim, ñu toroxal, nangu ko;","poem":1},{"lineBreak":true},{"text":"tata ja daanu, tasaaroo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mowab amatul woy,","poem":1},{"lineBreak":true},{"text":"fa Esbon la leen noon ya fexeel lu bon,","poem":1},{"lineBreak":true},{"text":"ne: “Aycaleen nu raafal wii xeet!”","poem":1},{"lineBreak":true},{"text":"Yeen waa Madmen it, ñu wedamal;","poem":1},{"lineBreak":true},{"text":"saamar topp leen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuux jibe na Oronayim,","poem":1},{"lineBreak":true},{"text":"ndaw salfaañook rajaxoo ju réy!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mowab tas, ay fereem serandoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ñay yéeg jëm Luxit, di jooyoo.","poem":1},{"lineBreak":true},{"text":"Ña ngay yéeg, di jooyoo.","poem":1},{"lineBreak":true},{"text":"Ñay wàcci Oronayim di dégg aji jàq jiy yuuxoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ñu naan: “Dawleen, rawale seen bakkan,","poem":1},{"lineBreak":true},{"text":"ba tumurànkeji ni gajju màndiŋ!”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mowab, yeena yaakaar dooleek alal,","poem":1},{"lineBreak":true},{"text":"yeen it, dees na leen jàpp;","poem":1},{"lineBreak":true},{"text":"Kemos seen tuur mi duggi ngàllo,","poem":1},{"lineBreak":true},{"text":"mooki sarxalkatam aki kàngamam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dëkkoo dëkk ay yàqtoo,","poem":1},{"lineBreak":true},{"text":"benn dëkk du mucc!","poem":1},{"lineBreak":true},{"text":"Waa xur wii sànku,","poem":1},{"lineBreak":true},{"text":"waa joor gee yàqtoo.»","poem":1},{"lineBreak":true},{"text":"Muy la Aji Sax ji wax.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Gasalleen Mowab,","poem":1},{"lineBreak":true},{"text":"day sànku moos,","poem":1},{"lineBreak":true},{"text":"ay dëkkam gental,","poem":1},{"lineBreak":true},{"text":"kenn du fa des!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alkànde ñeel na kuy sàggane liggéeyu Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Alkànde ñeel na kuy xañ deret saamaru Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Mowab a dale féex cag ndawam,","poem":1},{"lineBreak":true},{"text":"kenn jàppu ko njaam, yóbbu,","poem":1},{"lineBreak":true},{"text":"sotteesu ko ndab ak ndab,","poem":1},{"lineBreak":true},{"text":"xanaa mu ne degg ni biiñ bu taaje,","poem":1},{"lineBreak":true},{"text":"di saf, di xeeñ ba tey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moo tax ay bés a ngii di ñëw,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«maa leen di yónnee ay nit ñu sotti diw gi,","poem":1},{"lineBreak":true},{"text":"ndab, soteet; njaq, rajax.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaakaaru Mowab ci Kemos tuur mi tas,","poem":1},{"lineBreak":true},{"text":"ni yaakaaru waa kër Israayil ci Betel ma ñu wóolu tase woon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Yaw réewu Mowab, du yaay kañu,","poem":1},{"lineBreak":true},{"text":"naan jàmbaar nga,","poem":1},{"lineBreak":true},{"text":"diy ñeyi xare?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Song nañu Mowab, yàqate ay dëkkam;","poem":1},{"lineBreak":true},{"text":"la man ci ay ndawam daanu dee.»","poem":1},{"lineBreak":true},{"text":"Kàddug Buur Aji Sax jee, Boroom gàngoori xare yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Musibay Mowab a ngi jegesi,","poem":1},{"lineBreak":true},{"text":"safaanam làbbaleeti, wuti ko.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mboolem yeen ñi wër xeet wii, jooyleen ko;","poem":1},{"lineBreak":true},{"text":"yeen ñi dégg turam ñépp, jooyleen ko.","poem":1},{"lineBreak":true},{"text":"Neleen: “Moo, nu gii nguur mana foqe,","poem":1},{"lineBreak":true},{"text":"ba foqaale jii daraja?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Yeen waa Dibon, dëkk bu taaru bi,","poem":1},{"lineBreak":true},{"text":"wàccleen seen teraanga ju kawe","poem":1},{"lineBreak":true},{"text":"te toog ci digg maral;","poem":1},{"lineBreak":true},{"text":"kiy yàqatesi Mowab kat song na leen,","poem":1},{"lineBreak":true},{"text":"di màbbsi seeni tata.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yeen waa Arower,","poem":1},{"lineBreak":true},{"text":"taxawleen fi yoon wi te teewlu;","poem":1},{"lineBreak":true},{"text":"góor gu fi jaare mbaa ndaw su rëcc, di daw,","poem":1},{"lineBreak":true},{"text":"ngeen laaj ko ne ko: “Lu xew?”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ñu ne: “Gàcce ñeel na Mowab gii tas!”","poem":1},{"lineBreak":true},{"text":"Yuuxooleen, ne wóoy!","poem":1},{"lineBreak":true},{"text":"Yéeneleen fa tàkkal dexu Arnon,","poem":1},{"lineBreak":true},{"text":"ne Mowab tas na!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mbugal dikkal joor gi,","poem":1},{"lineBreak":true},{"text":"dikkal dëkk yii di Olon, Yaxacc ak Mefaat","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ak Dibon ak Nebo ak Bet Diblatayim","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ak Kiryaatayim ak Bet Gamul ak Bet Mewon","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ak Keryot ak Boccara,","poem":1},{"lineBreak":true},{"text":"mboolem dëkki Mowab daal,","poem":1},{"lineBreak":true},{"text":"fu jegeek fu sore.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sidditu Mowab day dog,","poem":1},{"lineBreak":true},{"text":"loxoom damm.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"«Du Mowab a doon diir Aji Sax ji mbagg?","poem":1},{"lineBreak":true},{"text":"Nañu leen màndal sànjum Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ba ñu waccu, di ca xuus,","poem":1},{"lineBreak":true},{"text":"ba ñoom it, ñu di leen ree.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Waa Mowabee, du yeena doon ree Israayil?","poem":1},{"lineBreak":true},{"text":"Dangeen leena fekk ci biiri sàcc,","poem":1},{"lineBreak":true},{"text":"ba fu ngeen leen tudde, wëcc bopp?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yeen waa Mowab,","poem":1},{"lineBreak":true},{"text":"baleen dëkk yi, dëkke paxi doj.","poem":1},{"lineBreak":true},{"text":"Defleen niy xati,","poem":1},{"lineBreak":true},{"text":"tàgge peggi xunt.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Noo dégg ni Mowab bewe,","poem":1},{"lineBreak":true},{"text":"bew lool,","poem":1},{"lineBreak":true},{"text":"réy, reew, di damu;","poem":1},{"lineBreak":true},{"text":"ne daŋŋ-daŋŋiiral.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Maa xam seen reewande,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«seeni kañu neen la,","poem":1},{"lineBreak":true},{"text":"seeni jëf di neen.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Moo tax may jooy Mowab,","poem":1},{"lineBreak":true},{"text":"di wooteel wall Mowab gépp,","poem":1},{"lineBreak":true},{"text":"di yuuxul waa Kir Eres.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yaw reseñu Sibma gi,","poem":1},{"lineBreak":true},{"text":"ma jooyal la lu raw la ma jooyal Yaser.","poem":1},{"lineBreak":true},{"text":"Yaw la say car jàlloon géej,","poem":1},{"lineBreak":true},{"text":"àkki géeju Yaser,","poem":1},{"lineBreak":true},{"text":"sa figg jeek sa reseñ, noon yàqate.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tukkal nañu mbégteek bànneex","poem":1},{"lineBreak":true},{"text":"fi tóokëri réewum Mowab.","poem":1},{"lineBreak":true},{"text":"Maa ŋacc mbàndi biiñ ya,","poem":1},{"lineBreak":true},{"text":"kenn nalatu fa reseñ, di soowoo","poem":1},{"lineBreak":true},{"text":"coowal mbégte, xanaa ay yuux.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yuux jibe na Esbon, ba Elale, àkki ba Yaxacc","poem":1},{"lineBreak":true},{"text":"ak Cowar ba Oronayim ak Eglat Selisiya.","poem":1},{"lineBreak":true},{"text":"Ndoxi Nimrim sax ŋiis na.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Maay bóome biir Mowab.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Maay bóom kuy joxe sarax ci bérebi jaamookaay yi,","poem":1},{"lineBreak":true},{"text":"di taalal am tuuram cuuraay.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Naa jooy Mowab jooyi xol","poem":1},{"lineBreak":true},{"text":"yu toxoro di jooye ab dëj,","poem":1},{"lineBreak":true},{"text":"na toxoro di jooye dëju waa Kir Eres.","poem":1},{"lineBreak":true},{"text":"Lu ñu dajale woon sànku na!","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ñoom ñépp a nelu,","poem":1},{"lineBreak":true},{"text":"wat seeni sikkim,","poem":1},{"lineBreak":true},{"text":"daggat seeni loxo,","poem":1},{"lineBreak":true},{"text":"sol ay saaku, di ko ñaawloo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kaw taaxi Mowab yépp aki péncam,","poem":1},{"lineBreak":true},{"text":"fépp ay yuuxoo di jib.","poem":1},{"lineBreak":true},{"text":"Maa toj Mowab","poem":1},{"lineBreak":true},{"text":"ni ndab lu kenn soxlaatul.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"«Yuuxooleen, ne leen: “Céy gii yàqtoo!","poem":1},{"lineBreak":true},{"text":"Mowab gii wone gannaaw! Mowab rus na.”","poem":1},{"lineBreak":true},{"text":"Ñi ko wër ñépp a koy reetaan, di ci raf.»","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Aji Sax ji déy dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Lu mel ni jaxaay a ngii naa jàyy,","poem":1},{"lineBreak":true},{"text":"firiy laafam, këfsi Mowab.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Dees na teg Keryot ga ca Mowab loxo,","poem":1},{"lineBreak":true},{"text":"ne tata ya taral;","poem":1},{"lineBreak":true},{"text":"su keroogee fitu jàmbaar ne tërit,","poem":1},{"lineBreak":true},{"text":"mu mel ni kuy matu.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Mowab day sànku, ba xeetam fey.","poem":1},{"lineBreak":true},{"text":"Ñoo doon diir Aji Sax ji mbagg.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Yeen waa Mowab,","poem":1},{"lineBreak":true},{"text":"pat-pati rekk, di tàbbiy pax aki yeer.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"«Pat-patiy daw, tàbbim pax;","poem":1},{"lineBreak":true},{"text":"génnum pax, tàbbim yeer.","poem":1},{"lineBreak":true},{"text":"Maay yen Mowab, maa leen di yen moos","poem":1},{"lineBreak":true},{"text":"seen atum mbugal.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"«Fa keppaaru Esbon lañuy daw taxawi,","poem":1},{"lineBreak":true},{"text":"doole dëddu.","poem":1},{"lineBreak":true},{"text":"Booba sawaraa tàkke Esbon, di law;","poem":1},{"lineBreak":true},{"text":"sël-sëlee foofa ca péeyu Buur Sixon,","poem":1},{"lineBreak":true},{"text":"ba dajal réewum Mowab, nitu coow ña,","poem":1},{"lineBreak":true},{"text":"boole jë akum kaaŋ xoyom.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Wóoy, waa Mowab, ngalla yeen!","poem":1},{"lineBreak":true},{"text":"Yeen ñiy jaamu Kemos, sànku ngeen!","poem":1},{"lineBreak":true},{"text":"Dees na jàpp seen doom yu góor njaam;","poem":1},{"lineBreak":true},{"text":"jigéen ñi it, njaam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"«Du tee fan yu mujj ya,","poem":1},{"lineBreak":true},{"text":"ma tijji wërsëgu Mowab.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"Fii la àtteb Mowab yem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}