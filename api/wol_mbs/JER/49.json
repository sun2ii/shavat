{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":49,"content":[{"type":"heading","content":["Lu jëm ci Amoneen ñi"]},{"type":"verse","number":1,"content":["Lu jëm ci Amoneen ñi: Aji Sax ji dafa wax ne:",{"text":"«Xanaa Israayil daa amuli doom?","poem":1},{"lineBreak":true},{"text":"Am daa amul dono?","poem":1},{"lineBreak":true},{"text":"Lu tax Milkom tuur mi donn suufas Gàdd","poem":1},{"noteId":34},{"text":",","poem":1},{"lineBreak":true},{"text":"ba ay jaamukatam sanc dëkki Gàdd?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moo tax ay bés a ngii di ñëw,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«maay dégtal Raba, dëkku Amoneen ñi,","poem":1},{"lineBreak":true},{"text":"coowal xare ci seen biir,","poem":1},{"lineBreak":true},{"text":"tund wa gental,","poem":1},{"lineBreak":true},{"text":"dëkk-dëkkaan ya tàkk ba jeex,","poem":1},{"lineBreak":true},{"text":"ba keroog Israayil futti ñooña ko futti woon.»","poem":1},{"lineBreak":true},{"text":"Aji Sax jee ko wax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Éy waa Esbon, Ayi seen dëkk bi tas na, yuuxuleen!","poem":1},{"lineBreak":true},{"text":"Yeen waa dëkk yi séq Raba,","poem":1},{"lineBreak":true},{"text":"solleeni saaku, ñaawloo,","poem":1},{"lineBreak":true},{"text":"jaab diggante tata yi, tiisloo.","poem":1},{"lineBreak":true},{"text":"Milkom seen tuur mi déy duggi na ngàllo,","poem":1},{"lineBreak":true},{"text":"ànd aki sarxalkatam aki kàngamam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Céy Raba, bii dëkk bu taaru, toogadi,","poem":1},{"lineBreak":true},{"text":"ndax yeena doon damoo xur yi,","poem":1},{"lineBreak":true},{"text":"ba ci seen xur wu naat wii?","poem":1},{"lineBreak":true},{"text":"Yeena yaakaaroon seeni denc,","poem":1},{"lineBreak":true},{"text":"naan: “Ku ñemee dal ci sunu kaw?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maa ngii di wàcce njàqare ci yeen,»","poem":1},{"lineBreak":true},{"text":"kàddug Boroom bi Aji Sax jee, Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"«njàqare luy bawoo fi leen wër fépp,","poem":1},{"lineBreak":true},{"text":"dàq leen, ku ne jubal yoonam,","poem":1},{"lineBreak":true},{"text":"du kenn kuy dajaleeti daw-làqu yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waaye bu loolu weesoo,","poem":1},{"lineBreak":true},{"text":"ma tijji wërsëgu Amoneen ñi.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"heading","content":["Lu jëm ci Edomeen ñi"]},{"type":"verse","number":7,"content":["Lu jëm ci Edomeen ñi: Aji Sax ji Boroom gàngoor yi dafa wax ne:",{"text":"«Xanaa boroom xel amatul fi Teman?","poem":1},{"lineBreak":true},{"text":"Xanaa ndigal a réer xamkat yi?","poem":1},{"lineBreak":true},{"text":"Am seen bopp a yàqu?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeen waa Dedan,","poem":1},{"lineBreak":true},{"text":"walbatikuleen daw, ruuru ci seeni pax.","poem":1},{"lineBreak":true},{"text":"Maa ngi wàcce ci askanu Esawu","poem":1},{"noteId":35},{"text":"safaan,","poem":1},{"lineBreak":true},{"text":"seen mbugal taxaw na!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Su leen wittkati reseñ dikkalee, xanaa dinañu ca wacc ay doom?","poem":1},{"lineBreak":true},{"text":"Su leen ay sàcci guddi dikkalee,","poem":1},{"lineBreak":true},{"text":"du la leen doy lañuy sëxëtoo?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waaye yeen askanu Esawu,","poem":1},{"lineBreak":true},{"text":"man maa leen di ñori, ba ngeen ne duŋŋ.","poem":1},{"lineBreak":true},{"text":"Maay siiwal seeni rawtu,","poem":1},{"lineBreak":true},{"text":"ba dootuleen mana làqu;","poem":1},{"lineBreak":true},{"text":"seeni goneek seeni bokk, ñépp ay sànku,","poem":1},{"lineBreak":true},{"text":"seeni dëkkandoo sax, kenn du ca des ku naan:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"“Jirim yi ngeen bàyyi,","poem":1},{"lineBreak":true},{"text":"maa leen di dundal,","poem":1},{"lineBreak":true},{"text":"te seeni jëtun man nañu maa yaakaar.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ndegam ñi yeyoowul mbugal","poem":1},{"lineBreak":true},{"text":"ñooy jolu kaasu mbugal,","poem":1},{"lineBreak":true},{"text":"nees leen di ñàkka toppe, yeen?","poem":1},{"lineBreak":true},{"text":"Dees na leen topp moos,","poem":1},{"lineBreak":true},{"text":"ngeen jolu kaasu mbugal.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Giñ naa ko ci man mii, déy,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«Boccara, dëkk bii day mujj di gent bu ñu doyadal,","poem":1},{"lineBreak":true},{"text":"ndànd-foyfoy gu ñuy móoloo,","poem":1},{"lineBreak":true},{"text":"dëkk-dëkkaanam yépp gental ba fàww.»","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ab dégtal laa dégg, mu bawoo fa Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ndaw la yebal ci biir xeet yi, ne leen:","poem":1},{"lineBreak":true},{"text":"«Dajeleen waajal xare te song Edom xare!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yeen waa Edom, tuutal leen laay def ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"ñu xeeblu ngeen di doon ci biir doom aadama yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Seen ragluwaay ak seen reewande sànk na leen,","poem":1},{"lineBreak":true},{"text":"yeen ñi dëkke xunti doj,","poem":1},{"lineBreak":true},{"text":"féetewoo colli tund yi.","poem":1},{"lineBreak":true},{"text":"Waaye su ngeen ajee seenum tàgg ni jaxaay it,","poem":1},{"lineBreak":true},{"text":"fa laa leen di àjjee.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"«Edom day mujj gental,","poem":1},{"lineBreak":true},{"text":"ku fa jaare waaru,","poem":1},{"lineBreak":true},{"text":"di muslu ci seen mbugal yépp.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Edom day tas ni Sodom ak Gomor ak la ko wër.»","poem":1},{"lineBreak":true},{"text":"Aji Sax jee ko wax.","poem":1},{"lineBreak":true},{"text":"«Nit du ca dëkk,","poem":1},{"lineBreak":true},{"text":"doom aadama du fa dal.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Maa ngii di fëlle gottub Yurdan ni gaynde,","poem":1},{"lineBreak":true},{"text":"wuti mbooy gu naat.","poem":1},{"lineBreak":true},{"text":"Xef ak xippi déy, ma fëxale fa ñépp,","poem":1},{"lineBreak":true},{"text":"ba tabb fa ki ma tànn.","poem":1},{"lineBreak":true},{"text":"Ana moos ku mel ni man?","poem":1},{"lineBreak":true},{"text":"Ku am sañ-sañ ci man?","poem":1},{"lineBreak":true},{"text":"Ana njiit luy taxaw fi sama kanam?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kon dégluleen pexe mi Aji Sax ji waajal Edom,","poem":1},{"lineBreak":true},{"text":"mébét yi mu mébétal waa Teman ñooñu!","poem":1},{"lineBreak":true},{"text":"Na leen wóor ne deesu leen wommat ni seen gàtt yu ndaw, yóbbu,","poem":1},{"lineBreak":true},{"text":"ba yàq seen parlu yaxeet.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Seen jéll day réy ba riiral suuf,","poem":1},{"lineBreak":true},{"text":"seeni yuux àkki géeju Barax ya.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lu mel ni jaxaay a ngii, naan fëyy,","poem":1},{"lineBreak":true},{"text":"firiy laafam, këfsi Boccara.","poem":1},{"lineBreak":true},{"text":"Bésub keroog fitu jàmbaari Edom ne tërit,","poem":1},{"lineBreak":true},{"text":"mel ni kuy matu.»","poem":1}]},{"type":"heading","content":["Lu jëm ci Damaas"]},{"type":"verse","number":23,"content":["Lu jëm ci Damaas:",{"text":"«Dëkk yu mag ya ko wër,","poem":1},{"lineBreak":true},{"text":"di Amat ak Arpàdd, jàq nañu;","poem":1},{"lineBreak":true},{"text":"dég-dég bu tiis ba ñu dégg la.","poem":1},{"lineBreak":true},{"text":"Dañu ne yàcc, jaxasoo,","poem":1},{"lineBreak":true},{"text":"mbete géej gu sàmbaraax, deesu ko dalal.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Damaas a ne yasar, ne wërëñ, di daw;","poem":1},{"lineBreak":true},{"text":"tiitaange ne leen nuus,","poem":1},{"lineBreak":true},{"text":"njàqareeku mitit ne leen taral","poem":1},{"lineBreak":true},{"text":"ni kuy matu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lu tee ñu gental bii dëkk bu siiw,","poem":1},{"lineBreak":true},{"text":"di taax yii ma saf?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Su bés baa kay, seeni waxambaane fëlëñoo pénc yi,","poem":1},{"lineBreak":true},{"text":"seeni xarekat wedam.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee, Boroom gàngoor yi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"«Maay taal ca tatay Damaas","poem":1},{"lineBreak":true},{"text":"sawara wu xoyom këri Buur Ben Addàd.»","poem":1}]},{"type":"heading","content":["Lu jëm ci Arabi Kedar ak Àccor yi"]},{"type":"verse","number":28,"content":["Lu jëm ci giiru Kedar ak nguuri Àccor yi Nebukatnecar buuru Babilon nangu woon: Aji Sax ji dafa wax ne:",{"text":"«Ñokket ci kaw Kedar,","poem":1},{"lineBreak":true},{"text":"ba tas waa penku yooyu,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"nangu xaymaaki jur,","poem":1},{"lineBreak":true},{"text":"ak kiiraay ak luy jumtukaay,","poem":1},{"lineBreak":true},{"text":"yóbbu seeni giléem,","poem":1},{"lineBreak":true},{"text":"te biral leen, ne leen:","poem":1},{"lineBreak":true},{"text":"“Musiba ubale na!”","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yeen waa Àccor,","poem":1},{"lineBreak":true},{"text":"fëxleen te daw a daw,","poem":1},{"lineBreak":true},{"text":"ruurooji ci seeni pax.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"Mu ne: «Nebukatnecar buuru Babilon déy,","poem":1},{"lineBreak":true},{"text":"lalal na leen pexe,","poem":1},{"lineBreak":true},{"text":"mébal leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«Ayca ci kaw xeet wii ne finaax,","poem":1},{"lineBreak":true},{"text":"dëkke xel mu dal!»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Du bunt, du galanu weñ gu ñu fegoo,","poem":1},{"lineBreak":true},{"text":"te ñoom rekk a dëkk.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Dees na nangu seeni giléem,","poem":1},{"lineBreak":true},{"text":"tonni seen juroo jur,","poem":1},{"lineBreak":true},{"text":"ma tasaare ñooñuy wat seen peggu kawaru bopp,","poem":1},{"lineBreak":true},{"text":"ngelaw lu jóg, buub leen, yóbbu,","poem":1},{"lineBreak":true},{"text":"ma yéewe leen seen musiba, wetoo wet.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"«Àccor day doon dëkkub till,","poem":1},{"lineBreak":true},{"text":"gental ba fàww;","poem":1},{"lineBreak":true},{"text":"nit du fa dëkk,","poem":1},{"lineBreak":true},{"text":"doom aadama du fa dal.»","poem":1}]},{"type":"heading","content":["Lu jëm ci Elameen ñi"]},{"type":"verse","number":34,"content":["Kàddug Aji Sax ji dikkaloon na Yonent Yàlla Yeremi, jëm ci Elameen ñi, ci njàlbéenu nguurug Cedesyas buurub Yuda. Mu ne:"]},{"type":"verse","number":35,"content":["Aji Sax ji Boroom gàngoori xare yi dafa wax ne:",{"text":"«Damay damm fittu Elam,","poem":1},{"lineBreak":true},{"text":"seen ngëneelu ngànnaay.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Maay ngelawe ñeenti weti asamaan,","poem":1},{"lineBreak":true},{"text":"dal fi kaw Elam,","poem":1},{"lineBreak":true},{"text":"tasaare leen fépp fu ngelaw jublu,","poem":1},{"lineBreak":true},{"text":"ba daw-làquy Elam, du am wenn xeet wu ñu dul làquji.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Maa leen di xoqtal fi seen kanami noon,","poem":1},{"lineBreak":true},{"text":"yiy wut seen bakkan,","poem":1},{"lineBreak":true},{"text":"alage leen sama tàngooru mer.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Maa leen di toppe saamar,","poem":1},{"lineBreak":true},{"text":"ba raafal leen.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Maay déjjatee Elam buur ak bummi,","poem":1},{"lineBreak":true},{"text":"samp fa samab jal.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"«Waaye fan yu mujj ya,","poem":1},{"lineBreak":true},{"text":"maay ubbiwaat wërsëgu Elam.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"49.1 Milkom, tuuru Amoneen ñi la woon, te Gàdd ci suufas Israayil la bokkoon.","reference":{"chapter":49,"verse":1}},{"noteId":35,"caller":"+","text":"49.8 Esawu ak Edom, kenn ki la. Askanu Esawu ñoo dëkke woon réewum Edom.","reference":{"chapter":49,"verse":8}}]},"thisChapterLink":"/api/wol_mbs/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}