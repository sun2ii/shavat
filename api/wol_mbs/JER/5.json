{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":5,"content":[{"type":"heading","content":["Mbugal war na"]},{"type":"verse","number":1,"content":[{"text":"«Wërleen mbeddi Yerusalem,","poem":1},{"lineBreak":true},{"text":"xoolleen, seet ciy péncam rekk ba xam","poem":1},{"lineBreak":true},{"text":"ndegam dingeen gis kenn,","poem":1},{"lineBreak":true},{"text":"kenn kepp kuy def njub,","poem":1},{"lineBreak":true},{"text":"di sàmm worma,","poem":1},{"lineBreak":true},{"text":"ma daldi leen baal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bu ñu nee sax: “Giñ naa ko ci Aji Sax jiy dund,”","poem":1},{"lineBreak":true},{"text":"ay fen lañuy giñ.»","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Aji Sax ji, xanaa du worma ngay sàkku?","poem":1},{"lineBreak":true},{"text":"Dóor nga leen, safu leen;","poem":1},{"lineBreak":true},{"text":"nga làbbali, ñu tanqamlu,","poem":1},{"lineBreak":true},{"text":"wowle ba raw doj, baña dëpp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Man nag, ma noon: «Ñii de ay baadoolo rekk lañu,","poem":1},{"lineBreak":true},{"text":"di def jëfi dof,","poem":1},{"lineBreak":true},{"text":"xamuñu yoonu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"xamuñu lu seen àtteb Yàlla laaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kon naa dem seeti kàngam yi,","poem":1},{"lineBreak":true},{"text":"wax ak ñoom.","poem":1},{"lineBreak":true},{"text":"Xanaa ñoom dinañu xam yoonu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"xam lu seen àtteb Yàlla laaj.»","poem":1},{"lineBreak":true},{"text":"Waaye ñoo bokk daggook Yàlla,","poem":1},{"lineBreak":true},{"text":"dogook moom.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo tax gaynde di génne ci gott bi, fàdd leen,","poem":1},{"lineBreak":true},{"text":"bukkiy màndiŋ mi di leen yàpp,","poem":1},{"lineBreak":true},{"text":"segg di tëru seeni dëkk,","poem":1},{"lineBreak":true},{"text":"ku ca génne, dees na la xotat.","poem":1},{"lineBreak":true},{"text":"Seeni moy a bare,","poem":1},{"lineBreak":true},{"text":"te seen ñàkk worma réy.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"«Yerusalem, ana lu tax ma di la baal,","poem":1},{"lineBreak":true},{"text":"te say doom wacc ma,","poem":1},{"lineBreak":true},{"text":"di giñe lu dul Yàlla.","poem":1},{"lineBreak":true},{"text":"Ma reggal leen, teewul ñuy njaaloo,","poem":1},{"lineBreak":true},{"text":"riixle, jëm kër gànc ya!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mbete fas yu suur, tukkal,","poem":1},{"lineBreak":true},{"text":"ku ne ŋexal, jëm ca sa jabaru moroom.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lii, duma leen ko dumaa?»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Wii xeet, ndax duma ko fey yoolam?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Yéegleen seeni tata, yàqate,","poem":1},{"lineBreak":true},{"text":"waaye buleen leen jeexal tàkk.","poem":1},{"lineBreak":true},{"text":"Tenqileen lawit yi,","poem":1},{"lineBreak":true},{"text":"ñooñoo bokkul ci Aji Sax ji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waa kër Israayil ak waa kër Yuda kat,","poem":1},{"lineBreak":true},{"text":"ñoo ma wor a wor!»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«Ñoo fenal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"naan: “Moom du def dara,","poem":1},{"lineBreak":true},{"text":"musiba du nu dal,","poem":1},{"lineBreak":true},{"text":"saamaroo, xiifoo, dunu ci gis dara.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yonent yi daal, ngelawal neen!","poem":1},{"lineBreak":true},{"text":"Kàddug Yàlla newul ci ñoom;","poem":1},{"lineBreak":true},{"text":"li ñuy wax, na leen yenu!”»","poem":1}]},{"type":"heading","content":["Aji Sax ji artu na xeet wi"]},{"type":"verse","number":14,"content":[{"text":"Moo tax Aji Sax ji Boroom gàngoor yi dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Gannaaw wax jii lañu wax,","poem":1},{"lineBreak":true},{"text":"maa ngii di def samay wax di sawara ci sa gémmiñ,","poem":1},{"lineBreak":true},{"text":"muy xoyom askan wii mel ni matt.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Éey waa kër Israayil,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«maa ngii di indi fi seen kaw xeet wu bawoo fu sore.","poem":1},{"lineBreak":true},{"text":"Xeet wu am kàttan lañu,","poem":1},{"lineBreak":true},{"text":"xeet wu yàgga yàgg,","poem":1},{"lineBreak":true},{"text":"wu ngeen xamul seen làmmiñ,","poem":1},{"lineBreak":true},{"text":"te dégguleen seeni wax.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Seen mbari fitt ŋafal paxum bàmmeel,","poem":1},{"lineBreak":true},{"text":"ñoom ñépp di ñeyi xare.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ñooy dikk, warax seen meññeef ak seen ñam,","poem":1},{"lineBreak":true},{"text":"jeexal seeni doom, góor ak jigéen,","poem":1},{"lineBreak":true},{"text":"lekk seen jur gu gudd ak gu gàtt,","poem":1},{"lineBreak":true},{"text":"saax-saaxee seeni reseñ ak seeni figg;","poem":1},{"lineBreak":true},{"text":"te dëkk yi ngeen yaakaare seeni tata,","poem":1},{"lineBreak":true},{"text":"dooley saamar a koy tas.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Waaye bési keroog it,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«duma leen jeexal tàkk.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bu ñu nee:","poem":1},{"lineBreak":true},{"text":"“Ana lu waral sunu Yàlla Aji Sax ji teg nu lii lépp?”","poem":1},{"lineBreak":true},{"text":"ne leen: “Yàlla nee:","poem":1},{"lineBreak":true},{"text":"Ni ngeen ma dëddoo, di jaamu yàllay jàmbur ci seenum réew,","poem":1},{"lineBreak":true},{"text":"ni ngeen di jaamujee ay jàmbur","poem":1},{"lineBreak":true},{"text":"biir réew mu ngeen moomul.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Jottalileen lii waa kër Yanqóoba,","poem":1},{"lineBreak":true},{"text":"biralleen ko fa Yuda, ne leen:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"“Ngalla dégluleen lii,","poem":1},{"lineBreak":true},{"text":"xeet wu dofe, ñàkk xel wi ngeen doon,","poem":1},{"lineBreak":true},{"text":"ami gët te dungeen gis,","poem":1},{"lineBreak":true},{"text":"ami nopp te dungeen dégg!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Man daal, ndax dangeen maa ragalul,","poem":1},{"lineBreak":true},{"text":"am dungeen raf ci sama kanam?”»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Man mi teg gannuus, yemalee ko géej,","poem":1},{"lineBreak":true},{"text":"dogalal ko ko dàkk te du ko jàll,","poem":1},{"lineBreak":true},{"text":"lu mu wañax wañax, du ko man;","poem":1},{"lineBreak":true},{"text":"gannax ya day riir, te du jàll!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Waaye wii xeet a dëgër bopp te déggadi.","poem":1},{"lineBreak":true},{"text":"Dëddu nañu ma ba wéy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Seen xel demul sax ba ne:","poem":1},{"lineBreak":true},{"text":"“Tee noo ragal sunu Yàlla Aji Sax","poem":1},{"lineBreak":true},{"text":"jiy jot, mu tawal nu,","poem":1},{"lineBreak":true},{"text":"taw yu jëkk ak yu mujj yi,","poem":1},{"lineBreak":true},{"text":"àppal nu ayi bési ngóob,","poem":1},{"lineBreak":true},{"text":"sédde nu?”","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yooyii seeni ñaawtéef a ko waññi,","poem":1},{"lineBreak":true},{"text":"seen bàkkaar a leen xañ ngëneel.","poem":1}]},{"type":"heading","content":["Mbon maase na ci xeet wi"]},{"type":"verse","number":26,"content":[{"text":"«Waaw! Daa am ñu bon ci sama ñoñ,","poem":1},{"lineBreak":true},{"text":"ñuy tërooka fiire","poem":1},{"lineBreak":true},{"text":"mbete nappkati picc.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ni kaaf di feeseeki picc,","poem":1},{"lineBreak":true},{"text":"ni la seeni kër di feese alali càcc,","poem":1},{"lineBreak":true},{"text":"ba tax ñu yokku ba woomle,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"yaflu, di nes-nesi.","poem":1},{"lineBreak":true},{"text":"Seenug mbon it amul kem:","poem":1},{"lineBreak":true},{"text":"duñu defal jirim njub,","poem":1},{"lineBreak":true},{"text":"duñu àtte néew-ji-doole dëgg.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lii, ndax duma leen ko dumaa?»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Xeet wu mel nii ndax duma ko fey yoolam?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Lu siblu te yées am na ci réew mi:","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yonent yiy wax kàdduy fen,","poem":1},{"lineBreak":true},{"text":"sarxalkat yiy jiitee seen coobare,","poem":1},{"lineBreak":true},{"text":"te sama ñoñ soppe ko ni!","poem":1},{"lineBreak":true},{"text":"Moo, ca muj ga, nu ngeen di def?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}