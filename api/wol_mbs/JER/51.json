{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Aji Sax ji dafa wax ne:",{"text":"«Maa ngii di yebal ngelawal yàqkat fi kaw Babilon,","poem":1},{"lineBreak":true},{"text":"fi kaw waa Lew Kamay gii","poem":1},{"noteId":37},{"text":",","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maay yónnee Babilon ay beeskat","poem":1},{"lineBreak":true},{"text":"yu ko bees, tonni réew ma, ba mu set.","poem":1},{"lineBreak":true},{"text":"Keroog bésu safaan ba déy,","poem":1},{"lineBreak":true},{"text":"fu ne lañu koy songe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buleen leen may fu ñu taxaweek seen kiiraay, di fitte;","poem":1},{"lineBreak":true},{"text":"buleen ñéeblu seeni waxambaane,","poem":1},{"lineBreak":true},{"text":"faagaagalleen seen gàngoor gépp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ñii dee, ne wetar réewum Babilon;","poem":1},{"lineBreak":true},{"text":"ñee gaañu, ne lasar ca mbedd ya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Israayil ak Yuda ñàkkuñu seen Yàlla,","poem":1},{"text":"Aji Sax ji Boroom gàngoor yi,","poem":2},{"text":"te réewum Babilon fees naaki moy","poem":1},{"lineBreak":true},{"text":"yu ñu moy Yàlla Aji Sell ji séddoo Israayil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Yeen gan ñi, génnleen Babilon,","poem":1},{"lineBreak":true},{"text":"ku ne rawaleji sa bakkan.","poem":1},{"lineBreak":true},{"text":"Buleen ñaawtéefu jàmbur sànkaale;","poem":1},{"lineBreak":true},{"text":"lii àppu mbugal la bu Aji Sax ji matal;","poem":1},{"lineBreak":true},{"text":"seen añ la, bu mu leen añale.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax jee yor Babilon ci loxoom, muy kaasu wurus bu def xadaru xeet ya,","poem":1},{"lineBreak":true},{"text":"di màndal mboolem àddina;","poem":1},{"lineBreak":true},{"text":"xeet ya naan ca,","poem":1},{"lineBreak":true},{"text":"ba tax ñuy say.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Teewul Babilon jekki daanu, tasaaroo.","poem":1},{"lineBreak":true},{"text":"Jooyleen ko,","poem":1},{"lineBreak":true},{"text":"dàmp ko, seral mititam,","poem":1},{"lineBreak":true},{"text":"jombul mu wér.»","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Bu nu sañoon faj Babilon, mu wér,","poem":1},{"lineBreak":true},{"text":"waaye wérul.","poem":1},{"lineBreak":true},{"text":"Nan ko ba te dem,","poem":1},{"lineBreak":true},{"text":"ku ne ñibbim réewam.","poem":1},{"lineBreak":true},{"text":"Àtteb Babilon kat àgg na asamaan,","poem":1},{"lineBreak":true},{"text":"àkki na fa kaw niir ya.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Aji Sax ji jox na nu dëgg.","poem":1},{"lineBreak":true},{"text":"Nanu yeggeji waa Siyoŋ","poem":1},{"lineBreak":true},{"text":"jaloorey Aji Sax ji, sunu Yàlla.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"«Nàmmleen fitt yi, feesale mbar yi!","poem":1},{"lineBreak":true},{"text":"Aji Sax ji xabtal na buuri Medd fi kaw Babilon,","poem":1},{"lineBreak":true},{"text":"nar koo tas.","poem":1},{"lineBreak":true},{"text":"Lii mbugalu Aji Sax jee,","poem":1},{"lineBreak":true},{"text":"mbugal mi këram waral.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yékkatilleen tatay Babilon raayab xare,","poem":1},{"lineBreak":true},{"text":"yokkleen wattukat yi,","poem":1},{"lineBreak":true},{"text":"taxawal leen fa ñuy wattoo,","poem":1},{"lineBreak":true},{"text":"te waajal tërukat yi.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji def na li mu waxoon","poem":1},{"lineBreak":true},{"text":"ne dina ko def waa Babilon.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yeen ñi dëkke weti ndox yu ne xéew,","poem":1},{"lineBreak":true},{"text":"seen alal ne xéew,","poem":1},{"lineBreak":true},{"text":"seen muj taxaw na,","poem":1},{"lineBreak":true},{"text":"seen buumu bakkan dog na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi giñ na ci boppam:","poem":1},{"lineBreak":true},{"text":"Maa leen di same ay nit niy njéeréer,","poem":1},{"lineBreak":true},{"text":"ñu xaacu, song leen.»","poem":1}]},{"type":"heading","content":["Cant, ñeel ki bind lépp"]},{"type":"verse","number":15,"content":[{"text":"Suuf, Aji Sax jee ko sàkke kàttanam;","poem":1},{"lineBreak":true},{"text":"dun bi, mu sampem xelam;","poem":1},{"lineBreak":true},{"text":"asamaan, mu lale xam-xamam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bu àddoo, ndoxum asamaan riir;","poem":1},{"lineBreak":true},{"text":"mu yéegey niir fa cati àddina,","poem":1},{"lineBreak":true},{"text":"riddee ngelaw fa dencam ya,","poem":1},{"lineBreak":true},{"text":"daldi melax, taw.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nitoo nit dim sanax, sore xam-xam,","poem":1},{"lineBreak":true},{"text":"te képp kuy tëgg sa jëmmu tuur, yaa añe gàcce.","poem":1},{"lineBreak":true},{"text":"Sa jëmmi weñ ji nga xelli, di neenug neen,","poem":1},{"lineBreak":true},{"text":"noowug bakkan, tus!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cóolóolu neen, liggéeyu caaxaan;","poem":1},{"lineBreak":true},{"text":"bu bésam taxawee, mu sànku.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ki séddoo Yanqóoba déy wuute naak yii caaxaan.","poem":1},{"lineBreak":true},{"text":"Kee bind lépp,","poem":1},{"lineBreak":true},{"text":"bind giir gi mu séddoo.","poem":1},{"lineBreak":true},{"text":"Kookooy Aji Sax ji Boroom gàngoori xare yi!","poem":1}]},{"type":"verse","number":20,"content":[{"text":"«Yaw Babilon, yaa doon sama wàkku,","poem":1},{"lineBreak":true},{"text":"sama marto biy sama ngànnaay,","poem":1},{"lineBreak":true},{"text":"ma di la dóore xeet yi,","poem":1},{"lineBreak":true},{"text":"rajaxee la réew yi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"dóore la fas ak gawaram,","poem":1},{"lineBreak":true},{"text":"dóore la watiir ak dawalkatam,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"dóore la góor ak jigéen,","poem":1},{"lineBreak":true},{"text":"dóore la mag ak ndaw,","poem":1},{"lineBreak":true},{"text":"dóore la waxambaaneekub janq,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"dóore la sàmm ak géttam,","poem":1},{"lineBreak":true},{"text":"dóore la beykat ak nag ya mu lëkkale,","poem":1},{"lineBreak":true},{"text":"dóore la kàngam ak jawriñ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Waaye mboolem lu Babilon ak waa réew mépp def ci Siyoŋ,","poem":1},{"lineBreak":true},{"text":"maa leen koy fey, ngeen di gis, yeen Yudeen ñi.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"«Maa ngii déy, fi sa kaw, yaw Babilon, ponkalum yàqkat bi,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«yaw miy yàq àddina sépp.","poem":1},{"lineBreak":true},{"text":"Maay tàllal sama loxo fi sa kaw,","poem":1},{"lineBreak":true},{"text":"taxañe la fa kaw doj ya,","poem":1},{"lineBreak":true},{"text":"def la ponkalum jalu dóomu-taal.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Deesul seppee fi yaw doju koñu tabax bi,","poem":1},{"lineBreak":true},{"text":"mbaa doju tabax wu bokk ci fondmaa,","poem":1},{"lineBreak":true},{"text":"nde gent ngay doon ba fàww.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"«Yékkatileenub raaya fi réew mi","poem":1},{"lineBreak":true},{"text":"te wal ay bufta, yégal xeet yi xare.","poem":1},{"lineBreak":true},{"text":"Dajaleleen xeet yi fi kaw Babilon,","poem":1},{"lineBreak":true},{"text":"te xabtal fi kawam réew yii:","poem":1},{"lineBreak":true},{"text":"Araraat ak Minni ak Askenas.","poem":1},{"lineBreak":true},{"text":"Tabballeen ko njiitu xare mu ko song,","poem":1},{"lineBreak":true},{"text":"indil koy fas yu saf ndiiraani njéeréer.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Dajaleleen xeet yi fi kaw Babilon,","poem":1},{"lineBreak":true},{"text":"wooleen buuri Medd ak kàngam ya","poem":1},{"text":"ak jawriñ ñaak mboolem réew mu ñu moom.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Suuf a fuddu, wañaaru,","poem":1},{"lineBreak":true},{"text":"mébéti Aji Sax jeey sottalal Babilon,","poem":1},{"lineBreak":true},{"text":"ngir réew ma dib gent bu kenn nekkul.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Jàmbaari Babilon xareetuñu,","poem":1},{"lineBreak":true},{"text":"ña nga des ca seeni tata,","poem":1},{"lineBreak":true},{"text":"doole ŋiis, ñu mel niy jigéen.","poem":1},{"lineBreak":true},{"text":"Bunti dëkk bi dàjjiku, kër ya jàpp.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Xélukat dab xélukat;","poem":1},{"lineBreak":true},{"text":"ndaw jottali ndaw xibaar","poem":1},{"lineBreak":true},{"text":"bu ñu yeggeji buuru Babilon, ne ko","poem":1},{"lineBreak":true},{"text":"nangu nañu dëkkam ba wetoo wet,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"nangu jàllukaayi dex ya,","poem":1},{"lineBreak":true},{"text":"taal barax ya,","poem":1},{"lineBreak":true},{"text":"xarekat ya raj-rajloo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aji Sax ji Yàllay Israayil, Boroom gàngoori xare yi déy dafa wax ne:","poem":1},{"lineBreak":true},{"text":"Ñu ngi dëggaate Babilon mu taaru mi,","poem":1},{"lineBreak":true},{"text":"ni ñuy dëggaatee dàgga ju ñuy bàccesi.","poem":1},{"lineBreak":true},{"text":"Balaa yàgg ngóobu Babilon taxaw.»","poem":1}]},{"type":"verse","number":34,"content":[{"text":"Buuru Babilon warax na ma.","poem":1},{"lineBreak":true},{"text":"Da maa muucu,","poem":1},{"lineBreak":true},{"text":"ñiit ma, ba ma set ni ndab.","poem":1},{"lineBreak":true},{"text":"Da maa modd ni ninki-nanka,","poem":1},{"lineBreak":true},{"text":"sole kollam li gën ci man,","poem":1},{"lineBreak":true},{"text":"yàbbi la ca des.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Waa Siyoŋ ne: «Yal na sama yàpp ak sama coono topp Babilon.»","poem":1},{"lineBreak":true},{"text":"Yerusalem ne: «Yal na sama deret topp waa Babilon!»","poem":1}]},{"type":"verse","number":36,"content":["Aji Sax ji nag dafa wax ne:",{"text":"«Maa ngii di leen layool seen layoo,","poem":1},{"lineBreak":true},{"text":"ba feyul leen.","poem":1},{"lineBreak":true},{"text":"Maay ŋeeral géejam,","poem":1},{"lineBreak":true},{"text":"ŋiisal am walam,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Babilon def jali doj,","poem":1},{"lineBreak":true},{"text":"di paxum till,","poem":1},{"lineBreak":true},{"text":"di gent bu ñuy muslu,","poem":1},{"lineBreak":true},{"text":"kenn du ko dëkke.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ñu ngi ŋarandoo niy gaynde,","poem":1},{"lineBreak":true},{"text":"di xiiroo ni gaynde yu ndaw.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ñu tàng bay bëgga dee,","poem":1},{"lineBreak":true},{"text":"ma may leen ñu naan a naan,","poem":1},{"lineBreak":true},{"text":"màndal leen, ñu mana xawaare,","poem":1},{"lineBreak":true},{"text":"tëdd nelaw nelaw yuy wéy abadan,","poem":1},{"lineBreak":true},{"text":"duñu yewwooti.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Aji Sax ji nee: «Maa leen di wommat","poem":1},{"lineBreak":true},{"text":"niy xar ba ca rendikaay ba,","poem":1},{"lineBreak":true},{"text":"ñu mel niy kuuy aki sikket.","poem":1}]},{"type":"heading","content":["Ngalla Babilon"]},{"type":"verse","number":41,"content":[{"text":"«Ãa! Ana nees mana nangoo Sesag","poem":1},{"noteId":38},{"text":"?","poem":1},{"lineBreak":true},{"text":"Nees mana tege loxo ki àddina sépp di kañ?","poem":1},{"lineBreak":true},{"text":"Ana nu Babilon mana gente fi digg xeet yi?","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Géej ay mëdd Babilon,","poem":1},{"lineBreak":true},{"text":"mu sàngoo gannaxam yu jallaañoo,","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"ay dëkkam gental,","poem":1},{"lineBreak":true},{"text":"réew mi ne sereŋ, di ndànd-foyfoy,","poem":1},{"lineBreak":true},{"text":"kenn du ko dëkke,","poem":1},{"lineBreak":true},{"text":"doom aadama du fa jaare.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Maay dikke mbugal Bel,","poem":1},{"lineBreak":true},{"text":"tuur mi ci Babilon,","poem":1},{"lineBreak":true},{"text":"yàbbiloo kob lancam.","poem":1},{"lineBreak":true},{"text":"Xeet yi noppee defum wal, wuti ko,","poem":1},{"lineBreak":true},{"text":"tatay Babilon it màbb.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Yeen sama ñoñ, génnleen fi seen biir,","poem":1},{"lineBreak":true},{"text":"na ku ne rawale sa bakkan,","poem":1},{"lineBreak":true},{"text":"ba mucc tàngooru sànjum Aji Sax ji.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Bu seen fit rëcc,","poem":1},{"lineBreak":true},{"text":"ngeen di tiit xibaar yi ñuy yéene ci réew mi:","poem":1},{"lineBreak":true},{"text":"ren yéene jib,","poem":1},{"lineBreak":true},{"text":"déwén yéene jibati,","poem":1},{"lineBreak":true},{"text":"fitna law ci réew mi,","poem":1},{"lineBreak":true},{"text":"njiit ne njiit dann.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Kon ay bés a ngii di ñëw,","poem":1},{"lineBreak":true},{"text":"yu may dikke mbugal tuuri Babilon,","poem":1},{"lineBreak":true},{"text":"réew mépp torox,","poem":1},{"lineBreak":true},{"text":"ña ñu bóom ñépp wetaroo fa biir.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Su boobaa asamaan ak suuf","poem":1},{"text":"ak mboolem li ci biiram","poem":2},{"text":"sarxolleendoo, di bége li dal Babilon.","poem":1},{"lineBreak":true},{"text":"Bëj-gànnaar kay la yàqkat yay bawoo.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Waa Babilon it dinañu daanu","poem":1},{"lineBreak":true},{"text":"ngir waa Israayil ñi ñu bóom,","poem":1},{"lineBreak":true},{"text":"ba ñu yem ak mboolem waa àddina yi ñu bóom,","poem":1},{"lineBreak":true},{"text":"te ñu daanu ndax Babilon.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ée yeen ñi rëcc saamar,","poem":1},{"lineBreak":true},{"text":"buleen taxaw, demleen,","poem":1},{"lineBreak":true},{"text":"di fàttalikoo Aji Sax ji fu sore,","poem":1},{"lineBreak":true},{"text":"tey bàyyi xel Yerusalem.","poem":1}]},{"type":"verse","number":51,"content":[{"text":"Nooka rus ci saaga yi nu dégg,","poem":1},{"lineBreak":true},{"text":"ak gàcce gi nu sëlmoo","poem":1},{"lineBreak":true},{"text":"ndax doxandéem yi dugg","poem":1},{"lineBreak":true},{"text":"ci biir béreb yu sell yi ci kër Aji Sax ji.","poem":1}]},{"type":"verse","number":52,"content":[{"text":"«Moo tax, bés a ngii di ñëw,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«maay dikke mbugal seen jëmmi tuur yi, ñoom,","poem":1},{"lineBreak":true},{"text":"ñi ñu jam di binnee fi réew mi mépp.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Su Babilon yéegoon asamaan,","poem":1},{"lineBreak":true},{"text":"dàbbali fa tata ju ne kekk sax,","poem":1},{"lineBreak":true},{"text":"du tee ay yàqkat bawoo fi man, dal ci kawam.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Yuuxi njàqare fa Babilon,","poem":1},{"lineBreak":true},{"text":"réewum Kaldeen ñooñaa toj ba tojatoo.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Aji Sax jee niy yàqatee Babilon,","poem":1},{"lineBreak":true},{"text":"tukkal fa riir mu réy.","poem":1},{"lineBreak":true},{"text":"Gàngoori noon yaa ngay buur ni gannaxi géej,","poem":1},{"lineBreak":true},{"text":"seen riirum kàddu jolli.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Yàqkat déy dikkal na Babilon,","poem":1},{"lineBreak":true},{"text":"jàpp ay jàmbaaram,","poem":1},{"lineBreak":true},{"text":"dammatey fittam.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji déy mooy Yàlla jiy yoole,","poem":1},{"lineBreak":true},{"text":"di fey pey gu mat sëkk.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Mu ne: «Maay màndal seeni kilifaak seeni kaaŋ","poem":1},{"lineBreak":true},{"text":"ak seeni kàngam ak seeni jawriñ ak seeni jàmbaar,","poem":1},{"lineBreak":true},{"text":"ñu tëdd nelaw nelaw yuy wéy abadan,","poem":1},{"lineBreak":true},{"text":"duñu yewwooti.»","poem":1},{"lineBreak":true},{"text":"Kàddug Buur a, Aji Sax ji Boroom gàngoor yi.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Tatay Babilon yu mag yi","poem":1},{"lineBreak":true},{"text":"dees koy màbb a màbb;","poem":1},{"lineBreak":true},{"text":"bunt yu kawe ya lakk ba jeex.","poem":1},{"lineBreak":true},{"text":"Xeet yee ñaq ci neen,","poem":1},{"lineBreak":true},{"text":"waaso yee sawara sonnal leen.»","poem":1}]},{"type":"heading","content":["Yeremi santaane na misaal"]},{"type":"verse","number":59,"content":["Ndigal yii ñooy ndigal yi Yonent Yàlla Yeremi jox Seraya doomu Nerya doomu Maxseya, ba mu àndee ak Buur Cedesyas ca Babilon ca ñeenteelu atu nguuram. Seraya moo doon bëkk-néegam."]},{"type":"verse","number":60,"content":["Fekk na Yeremi bind cib téere bu ñu taxañ mboolem safaan yiy dikkal Babilon, di mboolem mbir yooyu jëm ci Babilon."]},{"type":"verse","number":61,"content":["Yeremi sant Seraya, ne ko: «Boo àggee Babilon, fexeel ba biral kàddu yii yépp."]},{"type":"verse","number":62,"content":["Te nga wax ne: “Aji Sax ji, yaw déy, yaa xamle ne dëkk bii dina tas, dara du ci dëkkati, du doom aadama, du rab. Ab gent lay doon ba fàww.”"]},{"type":"verse","number":63,"content":["Boo jàngee téere bu ñu taxañ bii ba noppi, nanga ci takk aw xeer, sànni ko ci biir dexu Efraat."]},{"type":"verse","number":64,"content":["Su ko defee nga ne: “Nii la Babilon di diige te du jógati ndax safaan bi may wàcce fi seen kaw, ba ñu sonn.”» Fii la kàdduy Yeremi yem."]}],"footnotes":[{"noteId":37,"caller":"+","text":"51.1 Lew Kamay: li muy tekki ci làkku ebrë mooy «xolu noon yi», di turu kumpa wu bànni Israayil daan woowe waa Babilon.","reference":{"chapter":51,"verse":1}},{"noteId":38,"caller":"+","text":"51.41 Sesag turu kumpa la, di Babilon ba tey.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/wol_mbs/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}