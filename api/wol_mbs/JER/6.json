{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":6,"content":[{"type":"heading","content":["Gawub Yerusalem nuyoo na"]},{"type":"verse","number":1,"content":[{"text":"«Yeen askanu Beñamin, fëxleen,","poem":1},{"lineBreak":true},{"text":"génn Yerusalem.","poem":1},{"lineBreak":true},{"text":"Walleen bufta bi fa Tekowa,","poem":1},{"lineBreak":true},{"text":"jafaleleen jum yi Bet Kerem, artoo ko,","poem":1},{"lineBreak":true},{"text":"musiba kat a ngi yëre bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"di safaan bu réy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaw Siyoŋ, dëkk bu taaru bi te xejj,","poem":1},{"lineBreak":true},{"text":"dama lay dammat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ay sàmm ak seeni gétt ci sa kaw,","poem":1},{"lineBreak":true},{"text":"ñu samp seeni xayma, wër la,","poem":1},{"lineBreak":true},{"text":"di foral, ku nekk ak pàccam.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ñii ne: «Waajalleen xare baak ñoom,","poem":1},{"lineBreak":true},{"text":"nu songi leen digg bëccëg.","poem":1},{"lineBreak":true},{"text":"Waaye wóoy nun, jant a ngi lang,","poem":1},{"lineBreak":true},{"text":"keru ngoon di law!»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ñee ne: «Nan song congum guddi boog,","poem":1},{"lineBreak":true},{"text":"ba rajaxe seen kër yu yànj yi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aji Sax ji Boroom gàngoor yi déy da ne:","poem":1},{"lineBreak":true},{"text":"«Gorleeni bant,","poem":1},{"lineBreak":true},{"text":"sëkke Yerusalem, gaw ko!","poem":1},{"lineBreak":true},{"text":"Dëkk bii dees koy mbugal,","poem":1},{"lineBreak":true},{"text":"àqu nooteel la fees dell.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni bëtu ndox di dawe,","poem":1},{"lineBreak":true},{"text":"ni lañuy dawale seenug coxor.","poem":1},{"lineBreak":true},{"text":"Fitnaak salfaañooy riir ci dëkk bi,","poem":1},{"lineBreak":true},{"text":"gisuma lu moy jagadeek loraange!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeen waa Yerusalem, deeleen dégg","poem":1},{"lineBreak":true},{"text":"bala ma leena dëddu,","poem":1},{"lineBreak":true},{"text":"ba gental réew mi","poem":1},{"lineBreak":true},{"text":"gent bu kenn dëkkul.»","poem":1}]},{"type":"heading","content":["Askan wa të na"]},{"type":"verse","number":9,"content":[{"text":"Aji Sax ji Boroom gàngoor yi dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Nañu witt a witt ndesu Israayil,","poem":1},{"lineBreak":true},{"text":"ni ñuy witte reseñ,","poem":1},{"lineBreak":true},{"text":"ba nga dawalaat say loxo ca car ya.»","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Moo kan laay waxal,","poem":1},{"lineBreak":true},{"text":"artu ko ba mu déglu?","poem":1},{"lineBreak":true},{"text":"Seeni nopp a fatt ba manatuñoo sax teewlu.","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jaa ngii,","poem":1},{"lineBreak":true},{"text":"mel ni lu ñu rus,","poem":1},{"lineBreak":true},{"text":"lu ñu safoowul!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maa ngi fees dell ak merum Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ba manatuma koo dékku.","poem":1},"Yàllaay wax",{"text":"«Sippi ko tuut-tànk yi ci mbedd mi,","poem":1},{"lineBreak":true},{"text":"sippiwaale ko waxambaane yi daje,","poem":1},{"lineBreak":true},{"text":"mu laawaale jëkkër ak jabar,","poem":1},{"lineBreak":true},{"text":"mag ak màggat,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"seeni kër doon alali jàmbur,","poem":1},{"lineBreak":true},{"text":"ak seeni tool it ak seeni jabar.","poem":1},{"lineBreak":true},{"text":"Maay xàcc sama loxo déy,","poem":1},{"lineBreak":true},{"text":"dal ci kaw waa réew mi.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«Ndax ki gëna tuut ba ki gëna mag,","poem":1},{"lineBreak":true},{"text":"ñépp a ngi lewal lu lewul.","poem":1},{"lineBreak":true},{"text":"Yonent akub sarxalkat,","poem":1},{"lineBreak":true},{"text":"ñépp a ngi wor.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sofental nañu sama pajum ñoñ ñi dammatoo,","poem":1},{"lineBreak":true},{"text":"naan: “Jàmm, lépp jàmm!”","poem":1},{"lineBreak":true},{"text":"te jàmm amul.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñu wara am gàcce ci seen jëf ju siblu,","poem":1},{"lineBreak":true},{"text":"te gàcce gàcceelu leen.","poem":1},{"lineBreak":true},{"text":"Xamuñu sax luy kersa!","poem":1},{"lineBreak":true},{"text":"Moo tax ñuy fëlëñoondook ñiy fëlëñu.","poem":1},{"lineBreak":true},{"text":"Kera ba ma leen di dikkal, ñooy tërëf.»","poem":1},{"lineBreak":true},{"text":"Aji Sax jee ko wax.","poem":1}]},{"type":"heading","content":["Pexey askan wi jur na musiba"]},{"type":"verse","number":16,"content":[{"text":"Aji Sax ji dafa wax ñoñam ne:","poem":1},{"lineBreak":true},{"text":"«Taxawleen ca selebe yoon wa, xool,","poem":1},{"lineBreak":true},{"text":"te laajte yoon ya woon,","poem":1},{"lineBreak":true},{"text":"ne: “Ana yoonu mbaax?”","poem":1},{"lineBreak":true},{"text":"Ngeen awe ca, am noflaayu bakkan.»","poem":1},{"lineBreak":true},{"text":"Ñu lànk ne: «Awunu ca.»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Ma tabbal leeni wattukat","poem":1},{"lineBreak":true},{"text":"ne: “Teewluleen bufta bu jib.”»","poem":1},{"lineBreak":true},{"text":"Ñu lànk ne: «Teewluwunu.»","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"«Moo tax yeen xeet yi, dégluleen;","poem":1},{"lineBreak":true},{"text":"yeen waaso yi, seedeleen liy xaar ñii.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yeen waa àddina, dégluleen!","poem":1},{"lineBreak":true},{"text":"Maa ngii di indil askan wii musiba","poem":1},{"lineBreak":true},{"text":"mi leen seeni pexe jural.","poem":1},{"lineBreak":true},{"text":"Ñoo faalewul samay kàddu,","poem":1},{"lineBreak":true},{"text":"gàntal sama yoon.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lu may doye lii?","poem":1},{"lineBreak":true},{"text":"Ndàbb lu jóge Seba","poem":1},{"noteId":7},{"text":",","poem":1},{"lineBreak":true},{"text":"diw gu xeeñ, bawoo réew mu sore?","poem":1},{"lineBreak":true},{"text":"Seeni saraxi rendi-dóomal safu ma;","poem":1},{"lineBreak":true},{"text":"seen saraxi jur, bëgguma.»","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Moo tax Aji Sax ji wax ne:","poem":1},{"lineBreak":true},{"text":"«Maa ngii di tegal askan wii","poem":1},{"lineBreak":true},{"text":"ay pakk, ñu fakkastaloondoo,","poem":1},{"lineBreak":true},{"text":"baay ak doom,","poem":1},{"lineBreak":true},{"text":"dëkkandookub xarit,","poem":1},{"lineBreak":true},{"text":"ñépp sànku.»","poem":1}]},{"type":"heading","content":["Noon sàqee na bëj-gànnaar"]},{"type":"verse","number":22,"content":[{"text":"Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"«Aw askan a ngii bàyyikoo réewum bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"xeet wu mag lañuy doon, sàqee fa cati àddina.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Fitt aku xeej lañuy ŋëb,","poem":1},{"lineBreak":true},{"text":"néeg lool, duñu yërëm;","poem":1},{"lineBreak":true},{"text":"seen coow ni riirum géej,","poem":1},{"lineBreak":true},{"text":"ñu war seeni fas, rëpptal,","poem":1},{"lineBreak":true},{"text":"làng-déral leen,","poem":1},{"lineBreak":true},{"text":"yeen waa Siyoŋ, dëkk bu taaru bi.»","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Danoo dégg riir mi,","poem":1},{"lineBreak":true},{"text":"sunuy yoxo yoqi,","poem":1},{"lineBreak":true},{"text":"njàqare ne nu taral,","poem":1},{"lineBreak":true},{"text":"ni mititu mat.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kii naa: «Bul génn ci àll bi!»","poem":1},{"lineBreak":true},{"text":"Kee naa: «Bul jaar ci yoon wi!»","poem":1},{"lineBreak":true},{"text":"Saamar kay a nga ca loxol noon ba,","poem":1},{"lineBreak":true},{"text":"tiitaange dajal fépp!","poem":1}]},{"type":"verse","number":26,"content":[{"text":"Éey bokk yi, solleeni saaku,","poem":1},{"lineBreak":true},{"text":"diwoo dóomu-taal, ñaawloo ko.","poem":1},{"lineBreak":true},{"text":"Ñaawluleen ni kuy dëj benn bàjjo","poem":1},{"lineBreak":true},{"text":"te jooy jooy yu metti,","poem":1},{"lineBreak":true},{"text":"nde yàqkat bi day jekki,","poem":1},{"lineBreak":true},{"text":"ne sunu kaw dàll!","poem":1}]},{"type":"verse","number":27,"content":[{"text":"«Maa la def sama nattukatu ñoñ,","poem":1},{"lineBreak":true},{"text":"nga di leen nattu ni ñuy nattoo xaalis,","poem":1},{"lineBreak":true},{"text":"te war leena seetlu, nemmiku seen jikko.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ñoom ñépp a di fippukat yu fétteeral,","poem":1},{"lineBreak":true},{"text":"wër di sos,","poem":1},{"lineBreak":true},{"text":"dëgërle ni xànjar ak weñ gu ñuul.","poem":1},{"lineBreak":true},{"text":"Ñoom ñépp di yàqkat.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tëgg wal taalam, mu yànj;","poem":1},{"lineBreak":true},{"text":"sawara seeyal betteex.","poem":1},{"lineBreak":true},{"text":"Xellees na koo xelli ci neen,","poem":1},{"lineBreak":true},{"text":"taxul li ci bon génn.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dees na leen woowe mbuubitum xaalis,","poem":1},{"lineBreak":true},{"text":"nde Aji Sax ji buub na leen, sànni.»","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"6.20 Seba, am réew la wu bokk ci sowu Arabi, fa féete suuf.","reference":{"chapter":6,"verse":20}}]},"thisChapterLink":"/api/wol_mbs/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}