{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JER","translationId":"wol_mbs","name":"Yeremi","commonName":"Yeremi","title":"Téereb Yonent Yàlla Yeremi","order":24,"numberOfChapters":52,"sha256":"82106715198642d187afec8e873eeeb2a0784833e510c185b51a4c5c08ff6405","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/wol_mbs/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"«Su boobaa déy,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«noon yeey sulli yaxi buuri Yuda","poem":1},{"lineBreak":true},{"text":"ak yaxi kàngam yi","poem":1},{"lineBreak":true},{"text":"ak yaxi sarxalkat yi","poem":1},{"lineBreak":true},{"text":"ak yaxi yonent yi","poem":1},{"lineBreak":true},{"text":"ak yaxi waa Yerusalem,","poem":1},{"lineBreak":true},{"text":"fa seeni bàmmeel,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"weer leen ci naaj week weer wi","poem":1},{"lineBreak":true},{"text":"ak mboolem biddiiw yi ñu soppoon,","poem":1},{"lineBreak":true},{"text":"di leen jaamu, di leen wut aka topp,","poem":1},{"lineBreak":true},{"text":"di leen sukkal.","poem":1},{"lineBreak":true},{"text":"Deesu ko dajale, deesu ko suul;","poem":1},{"lineBreak":true},{"text":"day mel niy jonkan fi kaw suuf si.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dee mooy gënal dund","poem":1},{"lineBreak":true},{"text":"mboolem ku des ci njaboot gu bon gii,","poem":1},{"lineBreak":true},{"text":"ak mboolem fu ñu dese fa ma leen tasaare woon.»","poem":1},{"text":"Kàddug Aji Sax jee, Boroom gàngoor yi.","poem":2}]},{"type":"heading","content":["Askan wi të na ticc"]},{"type":"verse","number":4,"content":[{"text":"«Nanga leen wax ne leen:","poem":1},{"lineBreak":true},{"text":"“Aji Sax ji dafa wax ne:","poem":1},{"lineBreak":true},{"text":"Xanaa ku daanu, da dul jógaat?","poem":1},{"lineBreak":true},{"text":"Am ku lajj, du délsi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lu tax xeet wii dëddu?","poem":1},{"lineBreak":true},{"text":"Lu tax Yerusalem gii lajj, baña délsi?","poem":1},{"lineBreak":true},{"text":"Ñu ngi langaamoo naxi neen,","poem":1},{"lineBreak":true},{"text":"baña délsi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Teewlu naa, déglu naa;","poem":1},{"lineBreak":true},{"text":"du lu jaadu lañu wax.","poem":1},{"lineBreak":true},{"text":"Kenn tuubu ci mbonam,","poem":1},{"lineBreak":true},{"text":"ba ne: ‘Lu ma def nii?’","poem":1},{"lineBreak":true},{"text":"Ku nekk a topp yoonam,","poem":1},{"lineBreak":true},{"text":"ni fas wu màmm cib xare.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ag xodd sax xam na bésub demam,","poem":1},{"lineBreak":true},{"text":"pitax, wetwet ak mbelaar it dem,","poem":1},{"lineBreak":true},{"text":"tey sàmm seen bésub délsi.","poem":1},{"lineBreak":true},{"text":"Waaye sama ñoñ faalewuñu àtteb Aji Sax ji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nu ngeen mane ne: ‘Am nan xel,","poem":1},{"lineBreak":true},{"text":"nu ngeek yoonu Aji Sax ji,’","poem":1},{"lineBreak":true},{"text":"te xalimay yoonalkat soppi ko fen?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dees na gàcceel boroom xel yi,","poem":1},{"lineBreak":true},{"text":"ñu jàq, jataŋe.","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jaa ngii ñu dëddu ko,","poem":1},{"lineBreak":true},{"text":"ana seenum xel?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«“Kon nag maay jël seeni jabar, jox ñeneen,","poem":1},{"lineBreak":true},{"text":"jox seeni tool ay foqatikat,","poem":1},{"lineBreak":true},{"text":"ndax ki gëna tuut ba ci ki gëna mag,","poem":1},{"lineBreak":true},{"text":"ñépp a ngi lewal lu lewul.","poem":1},{"lineBreak":true},{"text":"Ab yonent akub sarxalkat, ñépp a ngi wor!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sofental nañu sama pajum ñoñ ñi dammatoo,","poem":1},{"lineBreak":true},{"text":"naan: ‘Jàmm, lépp jàmm!’","poem":1},{"lineBreak":true},{"text":"te jàmm amul.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñu wara am gàcce ci seen jëf ju siblu,","poem":1},{"lineBreak":true},{"text":"te gàcce gàcceelu leen.","poem":1},{"lineBreak":true},{"text":"Xamuñu sax luy kersa!","poem":1},{"lineBreak":true},{"text":"Moo tax ñuy fëlëñoondook ñiy fëlëñu.","poem":1},{"lineBreak":true},{"text":"Bu ma leen dikkalee, dinañu tërëf.”»","poem":1},{"lineBreak":true},{"text":"Aji Sax jee ko wax.","poem":1}]},{"type":"heading","content":["Yaakaar tas na"]},{"type":"verse","number":13,"content":[{"text":"«Maa leen di witt a witt.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2},{"text":"«Garabu reseñ du dese doom,","poem":1},{"lineBreak":true},{"text":"figg du dese doom,»","poem":1},{"text":"kàddug Aji Sax jee,","poem":2},{"text":"«xob ya sax day wow.","poem":1},{"lineBreak":true},{"text":"Lu ma leen joxoon, rëcc na leen.»","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ana lu nuy toog?","poem":1},{"lineBreak":true},{"text":"Fabuleen, nu dem ca dëkk ya tata wër,","poem":1},{"lineBreak":true},{"text":"deewi fa.","poem":1},{"lineBreak":true},{"text":"Sunu Yàlla Aji Sax ji nar na sunu dee;","poem":1},{"lineBreak":true},{"text":"moo nu nàndal tookey mbugal,","poem":1},{"lineBreak":true},{"text":"nde noo tooñ Aji Sax ji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuy yaakaar jàmm,","poem":1},{"lineBreak":true},{"text":"dara baaxul;","poem":1},{"lineBreak":true},{"text":"nuy séentum paj,","poem":1},{"lineBreak":true},{"text":"tiitaange ne jaas!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Seen noowi fas yaa dégtoo bëj-gànnaar fa Dan,","poem":1},{"lineBreak":true},{"text":"seen fasi naaru-góor di ŋexal, suuf sépp yëngu.","poem":1},{"lineBreak":true},{"text":"Ñu dikk, tas réew mi tasar,","poem":1},{"lineBreak":true},{"text":"booleek li ci biiram,","poem":1},{"lineBreak":true},{"text":"ak dëkk beek ñi ci biiram.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"«Maa ngii déy di leen yónnee","poem":1},{"lineBreak":true},{"text":"jaani ñàngóor yu déggul jat,","poem":1},{"lineBreak":true},{"text":"ñu di leen màtt.»","poem":1},{"text":"Kàddug Aji Sax jee.","poem":2}]},{"type":"heading","content":["Yeremi am na naqar"]},{"type":"verse","number":18,"content":[{"text":"Ndaw naqar wu tiis,","poem":1},{"lineBreak":true},{"text":"ndaw xol bu diis!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sama bokk yaa ngooguy yuuxu","poem":1},{"lineBreak":true},{"text":"yuux yu àkki fu sore,","poem":1},{"lineBreak":true},{"text":"naan: «Moo xanaa Aji Sax ji daa newul Siyoŋ?","poem":1},{"lineBreak":true},{"text":"Xanaa Buurub Siyoŋ da fee nekkatul?»","poem":1},"Yàllaay wax",{"text":"«Lu tax ñuy yékkati sama xol","poem":1},{"lineBreak":true},{"text":"ak seen jëmmi tuur yii,","poem":1},{"lineBreak":true},{"text":"seen yàllay doxandéem yi tekkiwul dara?»","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Ngóob wéy na, jamonoom wees,","poem":1},{"lineBreak":true},{"text":"te nun de muccagunu.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Sama bokk yi seen xol jeex","poem":1},{"lineBreak":true},{"text":"tax na sama xol jeex,","poem":1},{"lineBreak":true},{"text":"may tiislu, tancoo njàqare!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Moo ndax diwu pajtal amul Galàdd","poem":1},{"noteId":12},{"text":"?","poem":1},{"lineBreak":true},{"text":"Am fajkat a fi amul?","poem":1},{"lineBreak":true},{"text":"Ana lu tax ba bokk yi taneeguñu?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aka neexoon sama bopp soppaliku ndox,","poem":1},{"lineBreak":true},{"text":"saay gët di seyaan buy xelliy rongooñ","poem":1},{"lineBreak":true},{"text":"yu ma jooye guddeek bëccëg","poem":1},{"lineBreak":true},{"text":"bokk yi ñu bóom!","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"8.22 Galàdd, ab gox la bu féete dexu Yurdan penku te nekkoon fu bare gàncaxi pajtal.","reference":{"chapter":8,"verse":22}}]},"thisChapterLink":"/api/wol_mbs/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}