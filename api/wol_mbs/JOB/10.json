{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"heading","content":["Ayóoba nee lu mu def Yàlla?"]},{"type":"verse","number":1,"content":[{"text":"Maaka bañ sama dund gii!","poem":1},{"lineBreak":true},{"text":"Naa afal sama kàddug tawat,","poem":1},{"lineBreak":true},{"text":"di àddoo naqaru xol.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dama naa Yàlla: Bu ma toppug tooñ.","poem":1},{"lineBreak":true},{"text":"Xamal ma kay li nga may toppe, lu mu!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ana lu la noote di jariñ,","poem":1},{"lineBreak":true},{"text":"ba ngay bañ li nga sàkke sa loxol bopp,","poem":1},{"lineBreak":true},{"text":"tey àntal pexem ku bon?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xanaa gëti nit doŋŋ nga am,","poem":1},{"lineBreak":true},{"text":"am ni nit di gise rekk ngay gise?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Say fan daa tollook fani doom aadama,","poem":1},{"lineBreak":true},{"text":"am say at daa yem ak ati nit,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ba ngay seet fu ma ñaawe,","poem":1},{"lineBreak":true},{"text":"di liñbat fu ma moye?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moona xam nga xéll ne tooñuma,","poem":1},{"lineBreak":true},{"text":"te amul kenn kuy xettali nit ci sa loxo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Say loxoo ma mooñ, tabax ma ba ma mat sëkk,","poem":1},{"lineBreak":true},{"text":"léegi nga di ma yàq yaxeet!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rikk fàttalikul ne yaa ma tabax, ni bu ma doon ban,","poem":1},{"lineBreak":true},{"text":"xanaa doo ma delloo xaat ci pëndub suuf?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xanaa du yaa ma xelli woon ni meew","poem":1},{"lineBreak":true},{"text":"ci sama biiru ndey,","poem":1},{"lineBreak":true},{"text":"wayal ma nim soow,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"wodde ma der ak suux,","poem":1},{"lineBreak":true},{"text":"ràbbe ma yax aki siddit?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yaa ma may bakkan, won ma ngor,","poem":1},{"lineBreak":true},{"text":"yaa sàmme sa yégeel samag noo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndeke yoo lii nga dencoon ci sa xol,","poem":1},{"lineBreak":true},{"text":"xam naa ne lii nga naroon:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ne ma dann, ba su ma bàkkaaree,","poem":1},{"lineBreak":true},{"text":"doo ma baal samag tooñ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Su ma defee lu bon, ngalla man,","poem":1},{"lineBreak":true},{"text":"te bi ma defee lu jekk it, sañumaa siggi,","poem":1},{"lineBreak":true},{"text":"gàcce laa suure, sangoo toroxte.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Waaye su may siggi rekk,","poem":1},{"lineBreak":true},{"text":"nga mel ni gaynde, di ma rëbb,","poem":1},{"lineBreak":true},{"text":"dellu di ma lore say kiraama,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"yónneeti ma say seede,","poem":1},{"lineBreak":true},{"text":"gën maa songati,","poem":1},{"lineBreak":true},{"text":"ay gàngoor di wuutante fi sama kaw.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ana loo ma doon génnee sama biiru ndey?","poem":1},{"lineBreak":true},{"text":"Doon naa dee te bët du ma gis!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Doon naa mel ni ku masula am,","poem":1},{"lineBreak":true},{"text":"jóge ci biir, ñu yóbbu bàmmeel.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Xanaa du fan yu néew laa dese? Ba ma boog!","poem":1},{"lineBreak":true},{"text":"Xiddil, ma leqaliku,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"bala may dëddu, délseetuma,","poem":1},{"lineBreak":true},{"text":"bala may tàbbi réew mu lëndëm ga ne këruus,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"réewum lëndëm,","poem":1},{"lineBreak":true},{"text":"mu ne këruus, salfaañoo,","poem":1},{"lineBreak":true},{"text":"ag leer sax, saf fa lëndëm!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}