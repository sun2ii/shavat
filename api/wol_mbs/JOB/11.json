{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Cofar nee: Tuub, raw"]},{"type":"verse","number":1,"content":["Cofar ma bàyyikoo Naama àddu, ne:"]},{"type":"verse","number":2,"content":[{"text":"Yii kàddu yu wale, deesu ko tontoo?","poem":1},{"lineBreak":true},{"text":"Ndax wax ju bare tax na nit a yey?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa kebetu yii wedamal na kenn a?","poem":1},{"lineBreak":true},{"text":"Am dangay ñaawle te deesu la tiiñal?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nee nga sa àlluwa wér na péŋŋ,","poem":1},{"lineBreak":true},{"text":"sa jëw rafet, Yàlla seede.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Éy su Yàlla nammoona wax,","poem":1},{"lineBreak":true},{"text":"ba àddu, wax ak yaw,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"àgge la kumpay xelam mu rafet,","poem":1},{"lineBreak":true},{"text":"mi wees dég-dég,","poem":1},{"lineBreak":true},{"text":"kon nga xam ne Yàlla jéllale na sa lenni tooñ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dangaa mana gëstu mbóoti Yàlla, ba gis ko?","poem":1},{"lineBreak":true},{"text":"Am yaa xam Aji Man ji, ba ñédd ko?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lu gëna kawe kaw, ana loo ci man?","poem":1},{"lineBreak":true},{"text":"Lu gëna xóot njaniiw, ana loo ci xam?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Màggaayu Yàllaa sut suuf,","poem":1},{"lineBreak":true},{"text":"gëna yaatu géej!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Su dikkee, tëj nit,","poem":1},{"lineBreak":true},{"text":"woo ko péncum àtte, ku ci man dara?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Moom mi xàmmee ñi dul niti dara,","poem":1},{"lineBreak":true},{"text":"mooy gis lu bon, te du laaj mu teewlu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waaye ku boppam feesul, bu muusee,","poem":1},{"lineBreak":true},{"text":"mbaamu àll a judduwaale nangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Waaye yaw soo defee sa xel ci Yàlla,","poem":1},{"lineBreak":true},{"text":"dékk ko say loxo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"fabal say ñaawtéef, sànni,","poem":1},{"lineBreak":true},{"text":"te baña xajal njubadi sa biir xayma,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kon déy, nga mucc gàkk, siggi;","poem":1},{"lineBreak":true},{"text":"dëju te doo tiit,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"sa coonob tey ngay fàtte;","poem":1},{"lineBreak":true},{"text":"ni waltan mu wal ba wéy doŋŋ, ni nga koy fàttalikoo,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"te yaay gëna leer jantub njolloor,","poem":1},{"lineBreak":true},{"text":"ba lëndëm di saf leeru njël.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kon nga am yaakaar ak kóolute,","poem":1},{"lineBreak":true},{"text":"aaru, soo tëddee, nelaw,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"jaaxaan, kenn du la lëjal,","poem":1},{"lineBreak":true},{"text":"ñu bare di la leewaayu;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ku bon jàq, ba gët ya giim,","poem":1},{"lineBreak":true},{"text":"rawtu réer ko,","poem":1},{"lineBreak":true},{"text":"yaakaaratul lu moy noowam gu mujj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}