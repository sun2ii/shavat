{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Ayóoba nee: Yàlla lu ko neex lay def"]},{"type":"verse","number":1,"content":["Ayóoba àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Yeen daal yeenay nit;","poem":1},{"lineBreak":true},{"text":"ngeen dee, xel mu rafet dee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndaxam man it am naam xel ni yeen,","poem":1},{"lineBreak":true},{"text":"duma seen cuune fenn,","poem":1},{"lineBreak":true},{"text":"te lii ngeen wax, kenn umplewu ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maay reetaanu xarit,","poem":1},{"lineBreak":true},{"text":"te daan woo Yàlla, muy wuyu;","poem":1},{"lineBreak":true},{"text":"tey ñuy reetaan ku jub, mucc ayib!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ku neexlee ngi ñaawal ku safaan dab,","poem":1},{"lineBreak":true},{"text":"defe ne safaan, ku tarxiis lay bëmëx.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jàmm a nga ca xaymay yàqkat ya,","poem":1},{"lineBreak":true},{"text":"te xel mu dal di céru tooñkati Yàlla yooyu,","poem":1},{"lineBreak":true},{"text":"yor seen tuuri yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Laajal rekk rab yi, ñu xamal la;","poem":1},{"lineBreak":true},{"text":"mbaa njanaaw yi, ñu wax la;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mbaa nga diisook suuf, mu xamal la;","poem":1},{"lineBreak":true},{"text":"mbaa jëni géej, ñu nettali la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ana ku umple ci mboolem ñii,","poem":1},{"lineBreak":true},{"text":"ne loxol Aji Sax jee def lii lépp?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moo yor ci loxoom lépp luy dund,","poem":1},{"lineBreak":true},{"text":"yor noowal képp kuy noyyi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xanaa du nopp ay natt baat bu jib,","poem":1},{"lineBreak":true},{"text":"denqleñ di mosu ñam?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mag ak xel mu rafet,","poem":1},{"lineBreak":true},{"text":"fan wu gudd ak ràññee.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waaye Yàllaa boole xel ak doole,","poem":1},{"lineBreak":true},{"text":"moom pexeek ràññee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mu ngoog, keey màbb te deesul tabaxaat,","poem":1},{"lineBreak":true},{"text":"di tëj nit, te deesul tijji.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mu ngoog, keey aj am ndox, mu maral,","poem":1},{"lineBreak":true},{"text":"mu afal am ndox, mu salfaañe àddina.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kee am doole, keey sottal,","poem":1},{"lineBreak":true},{"text":"di boroom aji réer ak ka ko réeral.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Keey futti kàngam,","poem":1},{"lineBreak":true},{"text":"dofloo kilifa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Keey foq mbaxanam buur,","poem":1},{"lineBreak":true},{"text":"jox ko ngemb, mu gemboo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Keey futti sarxalkat,","poem":1},{"lineBreak":true},{"text":"jàllarbi njiit lu riigu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Keey wedamal ku ñu wóolu,","poem":1},{"lineBreak":true},{"text":"xañ mag xelum ràññee.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Keey toroxal garmi,","poem":1},{"lineBreak":true},{"text":"yolomal ngañaayu boroom doole.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Keey ñori lu làqoo xóotey lëndëm,","poem":1},{"lineBreak":true},{"text":"leeral lu noon këruus.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Keey màggal aw xeet, teg ca sànk leen;","poem":1},{"lineBreak":true},{"text":"keey lawal aw xeet, teg ca toxal leen.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Keey xañ njiitu xeet am xelam,","poem":1},{"lineBreak":true},{"text":"wërloo ko ndànd-foyfoy gu yoon amul,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"muy làmbatoo lëndëm gu genn leer amul,","poem":1},{"lineBreak":true},{"text":"moo koy wërloo ni màndikat.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}