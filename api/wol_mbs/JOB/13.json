{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"heading","content":["Ayóoba nee: Su layoo, yey"]},{"type":"verse","number":1,"content":[{"text":"Dama ne, lii lépp maa ko gis,","poem":1},{"lineBreak":true},{"text":"dégg ko, xam ko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Li ngeen xam, man it xam naa ko;","poem":1},{"lineBreak":true},{"text":"duma seen cuune fenn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waaye man Aji Man ji laay waxal,","poem":1},{"lineBreak":true},{"text":"layook Yàlla laa namm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yeen nag yeenay rafetalkati fen,","poem":1},{"lineBreak":true},{"text":"yeen ñépp di fajkati caaxaan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Céy su ngeen noon cell,","poem":1},{"lineBreak":true},{"text":"muy seen rafet xel!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngalla dégluleen sama tawat,","poem":1},{"lineBreak":true},{"text":"teewluleen sama kàddug layoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndax Yàlla ngeen di waxal waxi njubadi,","poem":1},{"lineBreak":true},{"text":"di ko duural?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndax Yàlla ngeen faral,","poem":1},{"lineBreak":true},{"text":"walla Yàlla ngeen di layool?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ndax bu leen Yàlla luqatu woon dina baax?","poem":1},{"lineBreak":true},{"text":"Am ni ñuy naxe nit ngeen koy naxe?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Su ngeen ko faraloon ci kumpa sax,","poem":1},{"lineBreak":true},{"text":"du tee mu sikk leen moos.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xanaa màggaayu Yàlla tiitalu leen?","poem":1},{"lineBreak":true},{"text":"Am ragluwaayam ëlëmu leen?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Seeni tari, léebi neen,","poem":1},{"lineBreak":true},{"text":"seeni tont, kiiraayu boob.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xeremluleen, ba ma wax man","poem":1},{"lineBreak":true},{"text":"ak lu ma mana dal.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amul dara lu mu ma jaralul,","poem":1},{"lineBreak":true},{"text":"ba ci jaay sama bakkan.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Su ma Yàlla doon rey it, moom laay yaakaar,","poem":1},{"lineBreak":true},{"text":"maay janook moom, layool sama bopp.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Loolu it sama mucc a ngi ci,","poem":1},{"lineBreak":true},{"text":"ndax ab yéefar du dikk di janook moom.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dégluleen a déglu sama baat,","poem":1},{"lineBreak":true},{"text":"sama kàddu ci seeni nopp.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dégluleen maa, ma lañal ab layoo,","poem":1},{"lineBreak":true},{"text":"bir na ma ne maay yey.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ana ku may yey cib layoo?","poem":1},{"lineBreak":true},{"text":"Kon de ma wedam te dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Xanaa nga may ma ñaar rekk,","poem":1},{"lineBreak":true},{"text":"ba du jar ma di la làqu:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ngalla teggi ma sa loxo,","poem":1},{"lineBreak":true},{"text":"te buma dabeeti tiitaange joo sabab.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wooteel, ma wuyu,","poem":1},{"lineBreak":true},{"text":"mbaa ma wax, nga àddu ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ana luy sama ñaawtéef aki moy?","poem":1},{"lineBreak":true},{"text":"Xamal ma samag tooñ ak sama moy.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ana loo may làqe sa leeru kanam?","poem":1},{"lineBreak":true},{"text":"Danga maa jàppe sab noon?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Xob wuy wéy ngay xoqtal?","poem":1},{"lineBreak":true},{"text":"Ana boob buy naaw, loo ciy topp?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yaa ma bindal dogal yu wex,","poem":1},{"lineBreak":true},{"text":"añale ma sama ñaawtéefi ndaw!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yaa ma jéng,","poem":1},{"lineBreak":true},{"text":"di sàmm fépp fu ma jaare,","poem":1},{"lineBreak":true},{"text":"topp sama tànk!","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Sama bakkan a ngi ruus ni bant bu fënëx,","poem":1},{"lineBreak":true},{"text":"mbaa mbubb mu maxe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}