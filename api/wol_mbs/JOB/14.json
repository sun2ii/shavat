{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["Àddinaa gàtt, barew tiis"]},{"type":"verse","number":1,"content":[{"text":"Ku jigéen jur,","poem":1},{"lineBreak":true},{"text":"yaa néewi fan, géejal coono!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dangay tóor rekk, lax,","poem":1},{"lineBreak":true},{"text":"wéy ni takkndeer, doo toog.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mooy kii nag nga teg bët,","poem":1},{"lineBreak":true},{"text":"mooy man mii nga nara layool!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lu sobewu, ana ku ci mana am lu laab?","poem":1},{"lineBreak":true},{"text":"Du kenn!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndegam yaa dogalal nit ay fanam,","poem":1},{"lineBreak":true},{"text":"lim ay weeram,","poem":1},{"lineBreak":true},{"text":"dogal àpp ba, te du jaas,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"teggi ko boog say gët, mu dallu,","poem":1},{"lineBreak":true},{"text":"ni liggéeykat bu jaanam wàcc ci bés.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Garab sax ñàkkul yaakaar.","poem":1},{"lineBreak":true},{"text":"Boo goree, mu jebbiwaat,","poem":1},{"lineBreak":true},{"text":"ba du ñàkk ay njebbit.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Reen ba man naa màggat,","poem":1},{"lineBreak":true},{"text":"ëkk ba deewe biir suuf,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"mu yégum ndox rekk, jebbi,","poem":1},{"lineBreak":true},{"text":"saxaat nim njëmbat.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waaye nit dee, doole réer,","poem":1},{"lineBreak":true},{"text":"bakkan rot, mu ne mes.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Day mel ni déeg bu ŋiis,","poem":1},{"lineBreak":true},{"text":"mbaa dex gu wow ba jeex.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Doom aadama it tëdd, du jógati,","poem":1},{"lineBreak":true},{"text":"du yewwooti, asamaan fekke,","poem":1},{"lineBreak":true},{"text":"du jógeeti ciy nelaw.","poem":1}]},{"type":"heading","content":["Làq ma sa mer, ba giif"]},{"type":"verse","number":13,"content":[{"text":"Éy soo ma nëbboon biir njaniiw,","poem":1},{"lineBreak":true},{"text":"làq ma, ba sa mer giif,","poem":1},{"lineBreak":true},{"text":"dogalal ma àpp, te bañ maa fàtte!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndax dees na dee, di dundati?","poem":1},{"lineBreak":true},{"text":"Doon naa ko muñe sama fani coono yépp,","poem":1},{"lineBreak":true},{"text":"ba keroog sama kuutaay yiwisi ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Doon nga ma woo, ma wuyu,","poem":1},{"lineBreak":true},{"text":"te kon nga namm sa càkkéefu loxo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Doon nga wóoral samay jéego,","poem":1},{"lineBreak":true},{"text":"te doo ma toppe samay bàkkaar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Konoon samag tooñ yebe ci mbuus mu takke;","poem":1},{"lineBreak":true},{"text":"sama ñaawtéef, nga muure ko malaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Waaye aw tund day màbb, ruus;","poem":1},{"lineBreak":true},{"text":"aw doj di toxu,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"am ndox di jonji xeer ba mu jeex,","poem":1},{"lineBreak":true},{"text":"waame buub suuf, yóbbu,","poem":1},{"lineBreak":true},{"text":"te noonu ngay neenale yaakaaru doom aadama,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"man ko, mu dëddu fàww,","poem":1},{"lineBreak":true},{"text":"kanam ga soppiku, nga jalax.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Doom ya tedd, yégul;","poem":1},{"lineBreak":true},{"text":"ñu tekkeedi, tinul.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nit yégul lu moy mititu boppam","poem":1},{"lineBreak":true},{"text":"te bakkanu boppam lay tiisoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}