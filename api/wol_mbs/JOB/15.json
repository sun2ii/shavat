{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Elifas nee: Lu waay def, boppam"]},{"type":"verse","number":1,"content":["Elifas àddu, ne:"]},{"type":"verse","number":2,"content":[{"text":"Ayóoba, ku xelu dina tontoo kàdduy ngelaw,","poem":1},{"lineBreak":true},{"text":"mbel-mbelam nib jaas bu fees dënnam a?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ku xelu du layoo waxi caaxaan,","poem":1},{"lineBreak":true},{"text":"kàddu yu amul benn njariñ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaw de, yaa ngi neenal worma,","poem":1},{"lineBreak":true},{"text":"di yàq njàngat mi war fa Yàlla.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Saw làmmiñ déy, sa ndëngtee koy sa,","poem":1},{"lineBreak":true},{"text":"yaa taamu di wax njublaŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Du man de, sa gémmiñu bopp a la teg daan,","poem":1},{"lineBreak":true},{"text":"sa làmmiñu bopp a la tuumaal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xanaa yaa njëkka juddu ci nit?","poem":1},{"lineBreak":true},{"text":"Am balaa tund yee sosu lañu la jur?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ba Yàllay féncoo yaa doon déglu,","poem":1},{"lineBreak":true},{"text":"ba mana aakimoo xel mu rafet?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ana loo xam lu nu xamul","poem":1},{"lineBreak":true},{"text":"ak dég-dég boo am, te nu rafle ko?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Boroom bijjaaw ak màggat a ngi sunu biir,","poem":1},{"lineBreak":true},{"text":"di ñu sut sa baay aw fan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kàddu yi la Yàlla di mas-sawoo da laa doyul?","poem":1},{"lineBreak":true},{"text":"Boole ci li ñu lay waxe teeyug bakkan?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana looy waxe xol,","poem":1},{"lineBreak":true},{"text":"di saxaaral kanam nii?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ngay sippi Yàlla sa mer,","poem":1},{"lineBreak":true},{"text":"di ko wax lu mel nii!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ana nit ku mana jub xocc?","poem":1},{"lineBreak":true},{"text":"Ana ku laab ku jigéen jur?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yàlla wóoluwul sax ñu sellam ña ca asamaan,","poem":1},{"lineBreak":true},{"text":"te asamaan sellul ba doy ko,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"rawatina nit, moom mi jara seexlu, yàqu jikko,","poem":1},{"lineBreak":true},{"text":"di def njubadi ni ndoxum naan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Déglu ma, ma wax la,","poem":1},{"lineBreak":true},{"text":"xamal la li ma gis,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"muy lu ñu rafet xel ñi jottali,","poem":1},{"lineBreak":true},{"text":"jële ko ca seeni maam, te làquñu ko.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ñoom, seeni maam doŋŋ a jagoo woon réew mi,","poem":1},{"lineBreak":true},{"text":"ba leen doxandéem raxaguloon.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bésoo bés ku bon ay bittarñikoo biir njàqare,","poem":1},{"lineBreak":true},{"text":"te diirub at yi ñu àppal ku néeg,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"coowal musiba mooy buur nopp ya,","poem":1},{"lineBreak":true},{"text":"yàqkat bette ko biir jàmm.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dootul yaakaara mucc musiba,","poem":1},{"lineBreak":true},{"text":"saamar a koy yoot,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"muy taxawaalu, tan ya mujj xontoo,","poem":1},{"lineBreak":true},{"text":"mu xam ne bésub safaan taxaw na.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Njàqareek tiitaangee koy ëlëm,","poem":1},{"lineBreak":true},{"text":"song ko ni buur bu jekku xare.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Moo xàcc loxoom jëme ci Yàlla,","poem":1},{"lineBreak":true},{"text":"di jaay Aji Man ji njàmbaar,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"daŋŋiiral, buur, wuti ko,","poem":1},{"lineBreak":true},{"text":"yiiroo dëllaayu pakkam,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"te fekk ko yaflu ba gët suulu,","poem":1},{"lineBreak":true},{"text":"pooj ya duuf bay lob-lobi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ku ni mel ay dëkke dëkk yu gental,","poem":1},{"lineBreak":true},{"text":"ci kër yu kenn dul dëkke,","poem":1},{"lineBreak":true},{"text":"kër yu nara doon jali tojit.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ku bon kooku du woomle, alalam du toog,","poem":1},{"lineBreak":true},{"text":"te koomam du lawe miim réew.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Du mucc musiba,","poem":1},{"lineBreak":true},{"text":"mooy garab gu daay xoyom car yu yees ya,","poem":1},{"lineBreak":true},{"text":"Yàlla wal, mu ne mes.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bumu yaakaar naxi neen, di nax boppam,","poem":1},{"lineBreak":true},{"text":"nde neen ay doon ab añam.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Balaa jantam a lang mu jot añam,","poem":1},{"lineBreak":true},{"text":"te caram dootul naat.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Day mel ni reseñ gu doom yay yolax,","poem":1},{"lineBreak":true},{"text":"mbaa oliw gu tóor-tóor yay ruus.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Waa làngu yéefar yi duñu am kuutaay,","poem":1},{"lineBreak":true},{"text":"te xaymay ñiy lekk ger la sawara di xoyom.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ñooy sos joote, di wasin ñaawtéef,","poem":1},{"lineBreak":true},{"text":"ñoom la seen biir di ëmb wuruj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}