{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Ayóoba gisatul yaakaar"]},{"type":"verse","number":1,"content":["Ayóoba àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Kàddu yu mel nii, dégg naa ko lu bare.","poem":1},{"lineBreak":true},{"text":"Dëfalkati yokk joote yi ngeen doon, yeen ñépp!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa waxi ngelaw yii da dul jeex?","poem":1},{"lineBreak":true},{"text":"Ana lu la cuq, ba ngay wax rekk?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su ngeen doon man, may yeen,","poem":1},{"lineBreak":true},{"text":"kon it ma mana wax ni yeen,","poem":1},{"lineBreak":true},{"text":"tuur leen baati tuuma,","poem":1},{"lineBreak":true},{"text":"wëcc leen bopp.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waaye su doon man, ma wax ak yeen, ba dëfal leen,","poem":1},{"lineBreak":true},{"text":"mas-sawu leen, ba ngeen giif.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waaye su ma waxee, mitit du giif;","poem":1},{"lineBreak":true},{"text":"su ma noppee, du tax mu sore.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yàlla kay a jeexal sama doole,","poem":1},{"lineBreak":true},{"text":"tas sama gàngoor.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moo ma jàpp, semmal ma;","poem":1},{"lineBreak":true},{"text":"samab jeexaay seedeel ma tuuma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Meram la ma daggatee, jéppi ma,","poem":1},{"lineBreak":true},{"text":"di yéyu ci sama kaw,","poem":1},{"lineBreak":true},{"text":"daasal ma gëti noon, ne ma jàkk.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nit ñaa ngi ŋa ŋàpp fi sama kaw,","poem":1},{"lineBreak":true},{"text":"sewal ma, di ma talaata,","poem":1},{"lineBreak":true},{"text":"dajaloo, sam ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yàlla da maa wacce ab kàccoor,","poem":1},{"lineBreak":true},{"text":"rattax ma ci loxoy ñu bon ñi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Féexoon naa, mu falaxe ma;","poem":1},{"lineBreak":true},{"text":"sëq sama ndodd, rajaxe ma,","poem":1},{"lineBreak":true},{"text":"def ma diirukaayam,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ay fittkatam gaw ma,","poem":1},{"lineBreak":true},{"text":"mu di ma butti te yërëmul,","poem":1},{"lineBreak":true},{"text":"di tuur sama sébbriit fi suuf.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mooy buur ni xarekat fi sama kaw,","poem":1},{"lineBreak":true},{"text":"di ma jamat.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ab saaku laa ñaw, taqoo,","poem":1},{"lineBreak":true},{"text":"torox, ne dett fi suuf.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sama kanam a ngi xonq curr aki jooy,","poem":1},{"lineBreak":true},{"text":"sama mbari bët bàddoo lëndëm.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Moona saay loxo jëfewul coxor,","poem":1},{"lineBreak":true},{"text":"te samag ñaan lal na worma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Suufoo, bul làq sama deret ji tuuru,","poem":1},{"lineBreak":true},{"text":"te yal na sama yuux jollee fu af.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma ne, tey fi tey, am naa ab seede kaw asamaan,","poem":1},{"lineBreak":true},{"text":"sama seede kay a nga fa kaw.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Samay xarit ñoo may kókkali,","poem":1},{"lineBreak":true},{"text":"waaye Yàlla laay tinu, ba sama bët di xelliy rongooñ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Na ab seede layool nit fa Yàlla,","poem":1},{"lineBreak":true},{"text":"ni doom aadama di layool moroom ma fi kaw suuf!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"At yu néew déy a ci des,","poem":1},{"lineBreak":true},{"text":"ma dem yoon wu ma dul délsi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}