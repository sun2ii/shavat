{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Sama xol jeex,","poem":1},{"lineBreak":true},{"text":"samay fan tàggoo,","poem":1},{"lineBreak":true},{"text":"bàmmeel di ma xaar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fu ma jublu ñu di ma ree,","poem":1},{"lineBreak":true},{"text":"di ma ñaawal, may gis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngalla Yàlla, gàddul mab daan sama digg ak yaw;","poem":1},{"lineBreak":true},{"text":"su dul yaw, ana ku may gàddu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaa fatt xelu ñii,","poem":1},{"lineBreak":true},{"text":"kon nag bu leen may ndam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nee ñu, ku njariñ tax nga wor xarit,","poem":1},{"lineBreak":true},{"text":"say doom a cay loru.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Man la nit ñi def léebukaay,","poem":1},{"lineBreak":true},{"text":"di ma tifli ci kanam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Naqar tax na saay gët giim,","poem":1},{"lineBreak":true},{"text":"saa cér yépp jeex ba mel ni takkndeer.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ku jub a ngii jommi ci lii ma dal,","poem":1},{"lineBreak":true},{"text":"ku dul tooñ a ngi xabtalu fi kaw yéefar yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waaye aji jub a ngi topp yoonam,","poem":1},{"lineBreak":true},{"text":"boroom loxo yu set a ngi gëna am kàttan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waaye yeen ñépp, waxaatleen, ma dégg,","poem":1},{"text":"boroom xel daal duma ko gis ci seen biir!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Samay fan wéy na,","poem":1},{"lineBreak":true},{"text":"mébét yàqu,","poem":1},{"lineBreak":true},{"text":"yaakaar yàkki.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñii guddi lañu def bëccëg,","poem":1},{"lineBreak":true},{"text":"naan leer sorewul, te lëndëm teew.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndegam kërug njaniiw laa yaakaarati,","poem":1},{"lineBreak":true},{"text":"te biir lëndëm laa nara tëri,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ndegam maa naa paxum yàqute ma: «Yaay sama baay!»","poem":1},{"lineBreak":true},{"text":"naa saxu bàmmeel: «Yaay bóoy!» mbaa «Jigéen sama!»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kon ana sama yaakaar?","poem":1},{"lineBreak":true},{"text":"Ana ku gisati sama yaakaar?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xanaa day ànd ak man tàbbi bàmmeel,","poem":1},{"lineBreak":true},{"text":"nu bokk tëraayu pënd.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}