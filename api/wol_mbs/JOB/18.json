{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Bildàdd buurati na"]},{"type":"verse","number":1,"content":["Bildàdd mu Suwa àddu, ne:"]},{"type":"verse","number":2,"content":[{"text":"Xanaa dungeen noppi mukk?","poem":1},{"lineBreak":true},{"text":"Àndleen ak xel, nu wax.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndax ay mala lañu nu teg daal,","poem":1},{"lineBreak":true},{"text":"def nu ay naataxóona?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaw nag yaa topp sa mer ba loru!","poem":1},{"lineBreak":true},{"text":"Ayóobaa, àddina day gental ngir yaw a?","poem":1},{"lineBreak":true},{"text":"Am aw doj ay toxal boppam ngir yaw?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ku bon kay lag leeram di fey,","poem":1},{"lineBreak":true},{"text":"te taalam du jolli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xaymaam day lëndëm,","poem":1},{"lineBreak":true},{"text":"làmpam ba ko tiim ne kamaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu daa waaxu démb, di temp tey,","poem":1},{"lineBreak":true},{"text":"ay mébétam di ko mbas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moo dox ba tàbbi cib caax,","poem":1},{"lineBreak":true},{"text":"wëndeeloo biir mbaal,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tànk ba téqtaloog fiir,","poem":1},{"lineBreak":true},{"text":"ab racctal ne ko ràtt.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buum ga koy lonk a nga suulu,","poem":1},{"lineBreak":true},{"text":"am yeer di ko xaare aw ñall.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lu ragloo koy darey mbetteel,","poem":1},{"lineBreak":true},{"text":"ne ko dann.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mooy xiif ba doole réer ko,","poem":1},{"lineBreak":true},{"text":"musiba taxaw, xejjoo ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Jàngoro di ko ŋacc,","poem":1},{"lineBreak":true},{"text":"woppi dee di lekk cér ya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku bon lees di ñoddee fa jàmmi xaymaam,","poem":1},{"lineBreak":true},{"text":"diri ko ba fa kanam buuru musiba yi,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"manees naa dëkke xaymaam, moomatu ko,","poem":1},{"lineBreak":true},{"text":"tamarax lees fay suy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ku bon mooy garab gu dee kaw ak suuf,","poem":1},{"lineBreak":true},{"text":"reen wow, xob lax.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Turam tukkee kaw suuf,","poem":1},{"lineBreak":true},{"text":"ba deesatu ko tuddem pénc.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dees koy bëmëxeg leer, tàbbal lëndëm,","poem":1},{"lineBreak":true},{"text":"dàqe ko àddina.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Du doom, du askan wu muy waccey bokkam,","poem":1},{"lineBreak":true},{"text":"te kenn du desey dalam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Waa sowu jommi cig mujam,","poem":1},{"lineBreak":true},{"text":"waa penku di rasu naa:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"«Dalub kàccoor déy, lee di mujam,","poem":1},{"lineBreak":true},{"text":"ku faalewul Yàlla, nii la màkkaanam!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}