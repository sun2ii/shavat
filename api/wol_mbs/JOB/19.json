{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Yàllaa may jot"]},{"type":"verse","number":1,"content":["Ayóoba àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Dungeen ma noppee xañ jàmmi bakkan,","poem":1},{"lineBreak":true},{"text":"di ma sëf wax ju dul jeex?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fukki yoon a ngii ngeen di ma saaga,","poem":1},{"lineBreak":true},{"text":"te rusuleen maa sonal.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su ma moyoon dëgg sax,","poem":1},{"lineBreak":true},{"text":"maay bokk ak sama moy fanaan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Defe ngeen ne yeena ma gën,","poem":1},{"lineBreak":true},{"text":"ba di ma sikke musiba mii ma dal?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waaye xamleen ne Yàllaa ma tooñ,","poem":1},{"lineBreak":true},{"text":"ab caaxam a ma dar kepp.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"May woote wall, wuyeesu ma,","poem":1},{"lineBreak":true},{"text":"ma ñaan ndimbal, àtteesu ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manumaa jàll, Yàllaa fatt sama yoon,","poem":1},{"lineBreak":true},{"text":"lëndëmal samay jaaruwaay,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"sàggi sama sag,","poem":1},{"lineBreak":true},{"text":"foq sama kaala,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"tojat ma wetoo wet ba ma tàggoo,","poem":1},{"lineBreak":true},{"text":"déjjati sama yaakaar ni garab,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"jafalal mam sànjam,","poem":1},{"lineBreak":true},{"text":"boole ma ciy noonam,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ay gàngooram dikkandoo,","poem":1},{"lineBreak":true},{"text":"yékkatiy jal, gawe ma,","poem":1},{"lineBreak":true},{"text":"dal fi wër sama xayma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Samay bokk, mu soreleek man,","poem":1},{"lineBreak":true},{"text":"samay xame sax ñooru ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jegeñaale ba ma,","poem":1},{"lineBreak":true},{"text":"xame fàtte ma,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"sama gani démb def ma ni jàmbur tey,","poem":1},{"lineBreak":true},{"text":"samay mbindaan it noonu,","poem":1},{"lineBreak":true},{"text":"ñu def ma ni doxandéem.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Su ma doon woo sama surga, ba di ko tinu sax,","poem":1},{"lineBreak":true},{"text":"da may tanqamlu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sama xetu gémmiñ dàq na sama jabar,","poem":1},{"lineBreak":true},{"text":"sama doomi ndey sax seexlu ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gone yi sax a ngi may sewal,","poem":1},{"lineBreak":true},{"text":"su ma jógee di dem, ñu di ma baatal.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sama wóllërey démb yépp a ma seexlu,","poem":1},{"lineBreak":true},{"text":"ma sopp leen, tey ñu dëddu ma.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Der aki yax laa dese,","poem":1},{"lineBreak":true},{"text":"daanaka dee naa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yërmandee, yërmande, yeen samay xarit,","poem":1},{"lineBreak":true},{"text":"Yàllaa xàcc, dal ci sama kaw!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lu ngeen ma toŋale nii ni Yàlla?","poem":1},{"lineBreak":true},{"text":"Xanaa yàppuleen ma, ba suur?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Éy su samay kàddu tënku woon ci mbind!","poem":1},{"lineBreak":true},{"text":"Éy su ñu manoona xacc mbind ma cib téere,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"xacce ko xalimag weñ ak betteex","poem":1},{"lineBreak":true},{"text":"mu ñaase fàww ciw doj!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Waaye man xam naa ne sama Jotkat a ngi dund,","poem":1},{"lineBreak":true},{"text":"te mooy mujje taxaw fi kaw suuf.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bu sama der bi lekkoo sax,","poem":1},{"lineBreak":true},{"text":"du tee ma dese suux wu ma xoole Yàlla,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"xoolal ko sama bopp,","poem":1},{"lineBreak":true},{"text":"te du doon sama gan.","poem":1},{"lineBreak":true},{"text":"Maaka namm lii ci sama xol!","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yeena ngi naan: «Ana nu nu koy toŋale,","poem":1},{"lineBreak":true},{"text":"ba am lay wu ko tiiñal?»","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ragalleen saamar!","poem":1},{"lineBreak":true},{"text":"Seen xadar jii ñaawtéef la, saamar ay àtteem,","poem":1},{"lineBreak":true},{"text":"xamleen ne àtte am na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}