{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Cofar nee: Ku musiba dab, yaa tooñ"]},{"type":"verse","number":1,"content":["Cofar mu Naama àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Kon ma àddooti ndax jaaxle,","poem":1},{"lineBreak":true},{"text":"ba xol jallaañoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dégg naa kàddug yedde gi nga may saagaa,","poem":1},{"lineBreak":true},{"text":"waaye samam xel a ma déey sa tont.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xanaa xamoo lii? La dale ca cosaan,","poem":1},{"lineBreak":true},{"text":"ba nit tegoo kaw suuf ba tey,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"xamoo ne ku bon, ag sarxolleem àggul fenn,","poem":1},{"lineBreak":true},{"text":"te bànneexu yéefar yàggul?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu màggoon ba tollook asamaan it,","poem":1},{"lineBreak":true},{"text":"ba bopp ba àkki fa kaw-a-kaw,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"day mujj seey fàww niy jonkanam;","poem":1},{"lineBreak":true},{"text":"ña ko daa gis naa: «Ana mu?»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kenn du ko gisati, day réer ni gént,","poem":1},{"lineBreak":true},{"text":"mbaa njeneeru guddi ju dàqu, wéy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bët bu ko gisoon du ko tóllanti,","poem":1},{"lineBreak":true},{"text":"dëkkuwaayam dootu ko séen,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ay doomam ay dàmp néew-ji-doole yi,","poem":1},{"lineBreak":true},{"text":"ba delloo seen alal.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mooy ànd ak dooley ndawam,","poem":1},{"lineBreak":true},{"text":"tëri biir bàmmeel.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lu bon la daa tàqamtikoo,","poem":1},{"lineBreak":true},{"text":"log ko, làq ca suufu làmmiñ wa,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"di ko siiramtal te du ko wacc,","poem":1},{"lineBreak":true},{"text":"xanaa taf ko ca digg denqleñ ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Waaye la muy lekk ay soppiku ca biiram,","poem":1},{"lineBreak":true},{"text":"doon daŋaru ñàngóor ca butit ya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moo dërëxoon alal, moo koy goqi,","poem":1},{"lineBreak":true},{"text":"ca biiram la ko Yàlla di yuree.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndeke tookey ñàngóor la muucu,","poem":1},{"lineBreak":true},{"text":"mu rey ko ni mat-matu saamaan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yàlla bumu niir wali dex","poem":1},{"lineBreak":true},{"text":"ak waltani lem ak soow.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dina delloo lu mu amoon, du ko warax;","poem":1},{"lineBreak":true},{"text":"te alali jula, du ko jariñoo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Moo dëggaate néew-ji-doole, dëddu ko;","poem":1},{"lineBreak":true},{"text":"aakimoo kër jàmbur te tabaxu ko.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Biir ba du wéet,","poem":1},{"lineBreak":true},{"text":"lu mu xemmem, du rëcc.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dara du rëcc ab kollam,","poem":1},{"lineBreak":true},{"text":"moo tax xéewalam du toog.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fa mu regge lay jàqe,","poem":1},{"lineBreak":true},{"text":"mépp musiba këppu ci kawam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ba muy sol kollam","poem":1},{"lineBreak":true},{"text":"la ko Yàlla di yónnee tàngooru sànjam,","poem":1},{"lineBreak":true},{"text":"tawal ko ko lu fees déqam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mu daw ngànnaayu weñ,","poem":1},{"lineBreak":true},{"text":"fittu xànjar bëtt ko,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"jam ko ba fëll,","poem":1},{"lineBreak":true},{"text":"cat la bëtt xol ba, di melax fa mu sare,","poem":1},{"lineBreak":true},{"text":"tiitaangey dee ne ko taral.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mboolem lëndëm a làqu di ko xaar,","poem":1},{"lineBreak":true},{"text":"te sawara wu loxo jafalul a koy xoyom,","poem":1},{"lineBreak":true},{"text":"lakkaale lu desoon ca xaymaam.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Asamaan ay weer ñaawtéefam,","poem":1},{"lineBreak":true},{"text":"suuf jóg, seedeel ko tuuma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Koomum këram day tukki, ne mes,","poem":1},{"lineBreak":true},{"text":"keroog sànjum Yàlla ma.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lii moo di wàllu nit ku bon, fa Yàlla,","poem":1},{"lineBreak":true},{"text":"muy cér bu ko Yàlla dogalal.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}