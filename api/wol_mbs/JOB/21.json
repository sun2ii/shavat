{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["Ayóoba weddi na àlluway xarit ya"]},{"type":"verse","number":1,"content":["Ayóoba àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Dégluleen maa, dégluleen sama baat,","poem":1},{"lineBreak":true},{"text":"te mas-sawoo ma seenug teewlu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muñalleen ma boog, ma wax, man,","poem":1},{"lineBreak":true},{"text":"balaa nit a reeti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sama tawat lii, da di maak nit a?","poem":1},{"lineBreak":true},{"text":"Gannaaw du nit, ana lu ma tee xàddi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Geesuleen ma, waaru,","poem":1},{"lineBreak":true},{"text":"ba loxo ub gémmiñ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Su ma ko xalaatee, damay tiit,","poem":1},{"lineBreak":true},{"text":"di kat-kati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lu tax ku bon di dund,","poem":1},{"lineBreak":true},{"text":"bay magal sax, di ànd ak doole?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Doomam day toog, mu fekke,","poem":1},{"lineBreak":true},{"text":"bay xool ay sëtam,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"këram nekke jàmm, mucc safaan,","poem":1},{"lineBreak":true},{"text":"te yetu Yàlla du ko dal.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ku bon, yëkkam day tëb te du moy,","poem":1},{"lineBreak":true},{"text":"nagam di jur te du xàcc.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Day gis ay xaleem di bajantu,","poem":1},{"lineBreak":true},{"text":"goneem yépp di tëbantu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Day xaacoondookum tëgg aki xalam,","poem":1},{"lineBreak":true},{"text":"di bége baatub toxoro,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ku bon ay matal ay fanam ci biir teraanga,","poem":1},{"lineBreak":true},{"text":"doora jekki wàcci njaniiw.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moona kee noon Yàlla: «Xiddi ma!","poem":1},{"lineBreak":true},{"text":"Xam saw yoon soxalu ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ana kuy Aji Man ji sax, ba ma di ko jaamu?","poem":1},{"lineBreak":true},{"text":"Su ma ko tinoo, ana lu mu may jariñ?»","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kii xanaa du teraangaam a ngi ciy loxoom?","poem":1},{"lineBreak":true},{"text":"Ndaxam taxul ma roy ko fenn!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ku bon, ana fu ag xuyyam kamaje?","poem":1},{"lineBreak":true},{"text":"Fu ko musiba dikkale?","poem":1},{"lineBreak":true},{"text":"Fu Yàlla mere, ba sédd ko safaan?","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ana fu ku bon mele nim ñax mu ngelaw wal,","poem":1},{"lineBreak":true},{"text":"mbaa mboob mu callweer yóbbu?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ngeen ne, «Ku bon daal ay tooñ, Yàlla dencal doomam añ ba.»","poem":1},{"lineBreak":true},{"text":"Ki tooñ kay, na ko fey, mu xam,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"gisal boppam sànkuteem,","poem":1},{"lineBreak":true},{"text":"ba jolu merum Aji Man ji!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ana luy yoonu ku bon ci waa këram, gannaawam,","poem":1},{"lineBreak":true},{"text":"te fekk limu fanam jeex?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ana kuy jàngal Yàlla xam-xam,","poem":1},{"lineBreak":true},{"text":"moom miy àtte ñu kawe ña?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kii a ngi deewaale dooleem,","poem":1},{"lineBreak":true},{"text":"xel ma dal, tiitul dara,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"yaram wa niin,","poem":1},{"lineBreak":true},{"text":"yax ya naat.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kee deewe naqaru xol,","poem":1},{"lineBreak":true},{"text":"masula ñam bànneex,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"te ñooy tëddandoo biir suuf,","poem":1},{"lineBreak":true},{"text":"bokk sàngooy sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mu ngoog! Maaka xam li ngeen foog,","poem":1},{"lineBreak":true},{"text":"te di ma ko fexee fitnaale!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ngeen ne: «Ana fu kër kàngam di mujje?","poem":1},{"lineBreak":true},{"text":"Ana xayma ba ku bon ka dëkke?»","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Xanaa laajuloo tukkikat yi?","poem":1},{"lineBreak":true},{"text":"Am gëmuloo seeni seede?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Bésub safaan ku bon ay mucc,","poem":1},{"lineBreak":true},{"text":"bésub mbugal it, mooy raw.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ana kuy janook moom, sikke ko jikkoom?","poem":1},{"lineBreak":true},{"text":"La mu def, ana ku ko koy fey?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Moom de bu deewee, sëg ya lees koy robi,","poem":1},{"lineBreak":true},{"text":"te bàmmeelam, dees na ko wattu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Liy topp néew ba, day bare,","poem":1},{"lineBreak":true},{"text":"liy dox jiitu ko wees ab lim,","poem":1},{"lineBreak":true},{"text":"te suufu xur wa sax da koy sedde.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Kon seeni mas-sawu, cóolóoli neen!","poem":1},{"lineBreak":true},{"text":"Seeni tont, jinigali kese!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}