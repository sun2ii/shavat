{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifas nee: Tuub a war Ayóoba"]},{"type":"verse","number":1,"content":["Ba loolu amee Elifas ma cosaanoo Teman àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Yàlla, ana lu ko nit mana jariñ?","poem":1},{"lineBreak":true},{"text":"Xanaa ku xelu jariñ boppam!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ana lu sag njub mana yokk Aji Man ji?","poem":1},{"lineBreak":true},{"text":"Lu ko sag mucc ayib mana indil?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndax sag am diine la lay dumaa,","poem":1},{"lineBreak":true},{"text":"bay àgg ak yaw ci layoo?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xanaa du sag mbon gu réy a la ko yóbbe,","poem":1},{"lineBreak":true},{"text":"ak say tooñ yu amul kem?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaa lebal mbokk, aakimoo tayleem ci dara,","poem":1},{"lineBreak":true},{"text":"bay nangu mbubbam néew-ji-doole, mu ne duŋŋ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaa mayul ku mar ndox mu naan,","poem":1},{"lineBreak":true},{"text":"mbaa nga xañ ku xiif lu mu lekk.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Boroom doole jagoo réew mi,","poem":1},{"lineBreak":true},{"text":"ku ñu beral loxo dëkke.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaa bàyyi jëtun, mu deme loxoy neen,","poem":1},{"lineBreak":true},{"text":"tey néewal doole ab jirim.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moo tax ay ndëgg-sërëx di la dar kepp,","poem":1},{"lineBreak":true},{"text":"musiba jekki ne la taral,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"mbaa lëndëm gu la teree gis,","poem":1},{"lineBreak":true},{"text":"mbàmbulaan dikk, mëdd la.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xanaa Yàlla sutul asamaan?","poem":1},{"lineBreak":true},{"text":"Xoolal biddiiw ya gëna kawe!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nga naa: «Ana lu Yàlla xam?","poem":1},{"lineBreak":true},{"text":"Ana nu muy àttee ci gii lëndëm gu tar?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Niir yee ko làq ba du nu gis,","poem":1},{"lineBreak":true},{"text":"fa muy doxantoo ca kaw taaxum asamaan!»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xanaa dangaa nara topp ñallu démb","poem":1},{"text":"wa nit ñu bon ña ñalloon?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ñoo buube, ne mes te seen àpp jotul,","poem":1},{"lineBreak":true},{"text":"ni fondmaa bu màbb, wéy nim wal,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"te ñoo doon wax Yàlla, naan ko: «Xiddi nu!»","poem":1},{"lineBreak":true},{"text":"Ñii ana lu leen Aji Man ji di def?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Moona moo feesaloon seeni kër ay teraanga,","poem":1},{"lineBreak":true},{"text":"waaye ñu bon ñii, royuma leen fenn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aji jub ñeey gis sànkutey ñii, bég;","poem":1},{"lineBreak":true},{"text":"ñu mucc tuuma ñaa leen di kókkali,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"naan: «Ña nu jógaloon sànkuwuñoo am?","poem":1},{"lineBreak":true},{"text":"Seen koom a xoyomuwul a?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jubool ak Yàlla rekk, am jàmm,","poem":1},{"lineBreak":true},{"text":"ngëneel dikkal la.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nangool ndigal ci làmmiñam,","poem":1},{"lineBreak":true},{"text":"te dëxëñi kàddoom ci sa biir xol.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dellul ci Aji Man ji rekk, ba taxawaat,","poem":1},{"lineBreak":true},{"text":"te nga sorele sa xayma njubadi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tegal wurus ci suuf,","poem":1},{"lineBreak":true},{"text":"wacce wurusu ngalam doji xur,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"te Aji Man ji di sa wurus,","poem":1},{"lineBreak":true},{"text":"di sa jali xaalis.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Su boobaa nga bége Aji Man ji,","poem":1},{"lineBreak":true},{"text":"mana siggi, séentu Yàlla,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"di ko ñaan, mu di la nangul,","poem":1},{"lineBreak":true},{"text":"yaw it ngay wàccook say dige,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"loo dogu, mu sotti,","poem":1},{"lineBreak":true},{"text":"foo jaare, mu leer,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ba bu nit detteeloo, nga yékkati ko,","poem":1},{"lineBreak":true},{"text":"te ku toroxlu, Yàlla wallu la.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ku ñàkkula tooñ sax, mu xettali la,","poem":1},{"lineBreak":true},{"text":"te sag ñàkk sikk lees koy xettalee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}