{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Ayóoba nee: Yàlla noppi na"]},{"type":"verse","number":1,"content":["Ba loolu amee Ayóoba àddu, ne:"]},{"type":"verse","number":2,"content":[{"text":"Ba tey maa ngi jooy jooy yu metti,","poem":1},{"lineBreak":true},{"text":"di onk bay ub gémmiñ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Éy bu ma xamoon fa may gise Yàlla,","poem":1},{"lineBreak":true},{"text":"ba àkki péncam,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"diis ko sama mbir,","poem":1},{"lineBreak":true},{"text":"àgge ko lépp lu may tawat,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ba xam lu di tontam,","poem":1},{"lineBreak":true},{"text":"dégg li mu may wax.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndax dooleem ju bare la may yeye?","poem":1},{"lineBreak":true},{"text":"Déedéet xanaa! Dina ma teewlu moos,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ba ku jub layoo faak moom,","poem":1},{"lineBreak":true},{"text":"ma daldi mucc sama àttekat fàww.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Seet naa wetu penku, Yàlla nekku fa,","poem":1},{"lineBreak":true},{"text":"ma seet sowu, gisuma ko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu jàppee fa wetu bëj-gànnaar, gisuma ko fa,","poem":1},{"lineBreak":true},{"text":"bu jàllee bëj-saalum, séenuma ko fa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndaxam moo xam fi ma jaare,","poem":1},{"lineBreak":true},{"text":"te bu ma nattoo, ma génn ci ni wurus wu ñu xelli.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tànkam, sama tànk,","poem":1},{"lineBreak":true},{"text":"yoonam laa tegu, moyuma ko.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dëdduwuma ay santaaneem,","poem":1},{"lineBreak":true},{"text":"sama biir xol laa denc ay kàddoom.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yàlla de kenn la, ana ku koy waññi?","poem":1},{"lineBreak":true},{"text":"Coobarey bakkanam lay def.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mooy sottal lu mu ma dogalal,","poem":1},{"lineBreak":true},{"text":"te bare na lu mu ma nasal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lee tax su ma janook moom, tiit,","poem":1},{"lineBreak":true},{"text":"te lu ma gëna xalaat, gën koo ragal.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yàlla daal a rëccal samaw fit,","poem":1},{"lineBreak":true},{"text":"Aji Man jee ma tiital!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Du lëndëm gi ma nekke moo ma wedamal,","poem":1},{"lineBreak":true},{"text":"du lëndëm gii ma muur.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}