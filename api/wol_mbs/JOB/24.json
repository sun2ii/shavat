{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"heading","content":["Ayóoba nee: Yàllaa ngi tanqamlu"]},{"type":"verse","number":1,"content":[{"text":"Lu tee Aji Man ji àppal nit bési mbugal,","poem":1},{"lineBreak":true},{"text":"ba ku ràññee Aji Sax ji fekke yooyu bésam?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nit a ngi toxal kemu suuf,","poem":1},{"lineBreak":true},{"text":"nit a ngi sàccug jur, foral leen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbaamu jirim, ñu wommat, yóbbu;","poem":1},{"lineBreak":true},{"text":"nagu jëtun, ñu jël kob tayle.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Néew-ji-doole, ñu buuxe ko ciw yoon,","poem":1},{"lineBreak":true},{"text":"baadoolo yi far bokk làquji.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Néew-ji-doole yaa ngii mel niy mbaami àll ci màndiŋ mi,","poem":1},{"lineBreak":true},{"text":"di fortaatu lu ñu lekk,","poem":1},{"lineBreak":true},{"text":"àll bu wow bi yor seen xontu njaboot.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tooli jàmbur lañuy góobaani,","poem":1},{"lineBreak":true},{"text":"di wittaani reseñ ca tóokëri ñu bon ña.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Duŋŋ lañuy fanaane ndax rafle,","poem":1},{"lineBreak":true},{"text":"sàngoo seen der ci sedd bi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñooy tawtee tund ya,","poem":1},{"lineBreak":true},{"text":"di làqoo xunt yu ñu seeloo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xoncees na jirim ci weenu ndeyam,","poem":1},{"lineBreak":true},{"text":"jëlees na tayle alalu néew-ji-doole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Duŋŋ lañuy wéye ndax rafle,","poem":1},{"lineBreak":true},{"text":"biir wéet, ñuy gàdduy sabaar,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"di nal diwu oliw ci tooli jàmbur,","poem":1},{"lineBreak":true},{"text":"di dër reseñ ju ñu dul naan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Biir dëkk ba la nit ñay binnee,","poem":1},{"lineBreak":true},{"text":"ña ñu gaañ di woote wall,","poem":1},{"lineBreak":true},{"text":"te Yàlla toppul kenn tooñ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñee noonoog leer,","poem":1},{"lineBreak":true},{"text":"faalewuñu yoonu bëccëg","poem":1},{"lineBreak":true},{"text":"te duñu fa taxawaaloo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bët di set, bóomkat jóg,","poem":1},{"lineBreak":true},{"text":"bóom baadoolo bi néew doole,","poem":1},{"lineBreak":true},{"text":"guddi jot mu dib sàcc.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moykat bu góor a ngi yeeru timis,","poem":1},{"lineBreak":true},{"text":"fab ndimo, kaalawoo,","poem":1},{"lineBreak":true},{"text":"naan bët du ko gis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ñu ngi lëndëmtu, di toj kër yi,","poem":1},{"lineBreak":true},{"text":"bëccëg ñu tëju,","poem":1},{"lineBreak":true},{"text":"xamuñug leer.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ñoom ñépp ñuulaayu guddeey seen bëccëg,","poem":1},{"lineBreak":true},{"text":"lëndëm gu ne këruus lañu xejjool.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yal nañu wéye walum ndox,","poem":1},{"lineBreak":true},{"text":"te suuf sa ñu séddoo alku,","poem":1},{"lineBreak":true},{"text":"ba kenn dootul dëgmal tóokëru reseñ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yal na maral ak tàngoor ŋiisal seen ndoxum taw,","poem":1},{"lineBreak":true},{"text":"te njaniiw mëdd ña bàkkaar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yal na leen seen ndey sax fàtte,","poem":1},{"lineBreak":true},{"text":"sax yi muucu leen,","poem":1},{"lineBreak":true},{"text":"ñu fàtte leen,","poem":1},{"lineBreak":true},{"text":"ba njubadi déjjatiku ni garab.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ñu ni mel ay lekk alalu jigéen ju tëlee jur,","poem":1},{"lineBreak":true},{"text":"te duñu baaxe jëtun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Waaye Yàllaa mana dàq boroom doole,","poem":1},{"lineBreak":true},{"text":"su nee tëll, mu xalaat bakkanam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Moo leen di may ñu wéeroo seen cëslaay,","poem":1},{"lineBreak":true},{"text":"tey xool fa ñuy jaare.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dañuy jóg, nes tuut ñu ne mes,","poem":1},{"lineBreak":true},{"text":"wadd, ñu boole for,","poem":1},{"lineBreak":true},{"text":"ñu daldi lax niy gub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Su dul noonu, ana ku may fenloo?","poem":1},{"lineBreak":true},{"text":"Ana ku mana neenal samay wax?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}