i gënul gasax.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}