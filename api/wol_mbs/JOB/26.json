{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Ayóoba ne Bildàdd: Yaa mat wall"]},{"type":"verse","number":1,"content":["Ayóoba àddu, ne:"]},{"type":"verse","number":2,"content":[{"text":"Ndaw ndimbal lu réy ci ku néew doole!","poem":1},{"lineBreak":true},{"text":"Yaaka mana wallu ku amul kàttan!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaaka mana xelal ku xeluwul","poem":1},{"lineBreak":true},{"text":"ak xam-xam bu yaa bi nga fi xamle!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ana ci koo jële sa kàddu yii sax?","poem":1},{"lineBreak":true},{"text":"Ak ku la xelal miim xel?","poem":1}]},{"type":"heading","content":["Ayóoba nee: Yàlla kenn xamu ko"]},{"type":"verse","number":5,"content":[{"text":"Ndem-si-yàlla yaa ngay lox","poem":1},{"text":"ca ron ndoxi biir suuf, ñook ña fa dëkke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Fàŋŋ la njaniiw def fa kanam Yàlla;","poem":1},{"lineBreak":true},{"text":"du genn kiiraay gu ko làq paxum sànkute.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kee firi asamaan fu dara amul,","poem":1},{"lineBreak":true},{"text":"sanjamtal suuf fu dara newul.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kee gëndaley ndox ciy xàmbaaram,","poem":1},{"lineBreak":true},{"text":"te taxul niir wa ñu laloo fàcc.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Keey firi aw niiram,","poem":1},{"lineBreak":true},{"text":"yiire ngànguneem.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kee rëdd digu wërngal fi kaw géej yi,","poem":1},{"lineBreak":true},{"text":"fa cat la leer ak lëndëm digaloo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kenuy asamaan jaayu,","poem":1},{"lineBreak":true},{"text":"di jommi ci kàddu yi muy gëddee.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dooleem la mane géej,","poem":1},{"lineBreak":true},{"text":"manooreem la rajaxee Raxab miy ninki-nankay géej.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Noowam wal, asamaan leer,","poem":1},{"lineBreak":true},{"text":"loxoom jam jaan jay balaw-balawi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lii de, mooy lenni jalooreem!","poem":1},{"lineBreak":true},{"text":"Ndaw ndéey lu tuut lu nu ci déggandeem!","poem":1},{"lineBreak":true},{"text":"Ana ku mana xam riiru dooleem?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}