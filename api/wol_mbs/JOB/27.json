{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Ayóoba bañ na"]},{"type":"verse","number":1,"content":["Ayóoba yékkateeti baatam, ne:"]},{"type":"verse","number":2,"content":[{"text":"Yàlla miy dund seede na, moom mi ma xañ dëgg","poem":1},{"lineBreak":true},{"text":"moom Aji Man ji ma teg naqaru xol,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ne li feek may ànd ak bakkan,","poem":1},{"lineBreak":true},{"text":"di noyyee noowal Yàlla,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"sama gémmiñ gii du wax njubadi,","poem":1},{"lineBreak":true},{"text":"sama làmmiñ wii laa ne, du tudd ay fen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yàlla buma leen jox dëgg,","poem":1},{"lineBreak":true},{"text":"ba ba may dee duma weddi samag mucc sikk.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ci sama dëgg laay ŋoy, duma ko ba,","poem":1},{"lineBreak":true},{"text":"sama giiru dund sama xel du ma yedd.","poem":1}]},{"type":"heading","content":["Ayóoba neeti: Yéene néeg la"]},{"type":"verse","number":7,"content":[{"text":"Yal na noon bokk ak ku bon demin,","poem":1},{"lineBreak":true},{"text":"ku may fexeel bokk ak kàccoor ag muj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ana lu yéefar biy yaakaarati bu ko Yàlla beddee,","poem":1},{"lineBreak":true},{"text":"ba Yàlla moom bakkanam?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu ko njàqare di dikkal,","poem":1},{"lineBreak":true},{"text":"Yàlla day dégg yuuxam a?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndax Aji Man ji la daan bége,","poem":1},{"lineBreak":true},{"text":"am daan na tudd Yàlla fu mu tollu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ma xamal leen boog li ci dooley Yàlla,","poem":1},{"lineBreak":true},{"text":"duma leen nëbb li Aji Man ji namm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dama ne, yeen ñépp a ko gisal seen bopp sax,","poem":1},{"lineBreak":true},{"text":"kon lu leen yebuloo nii ci neenug neen?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lii mooy cér bi Yàlla sédd ku bon,","poem":1},{"lineBreak":true},{"text":"mooy wàll wi Aji Man ji dencal ku néeg.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Njabootam ne xas, saamar jagoo,","poem":1},{"lineBreak":true},{"text":"te balaa booba duñu lekk ba suur.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ña koy wuutu, mbas a leen di rey,","poem":1},{"lineBreak":true},{"text":"te ay jëtunam duñu ko jooy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Su doon jal xaalis ni suuf,","poem":1},{"lineBreak":true},{"text":"yére yomb ko ni feppi suuf,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"mooy dajale, aji jub sol;","poem":1},{"lineBreak":true},{"text":"xaalis ba, ku dul tooñ séddoo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mooy tabax kër gu tanewul mbaarum wattukatu tool,","poem":1},{"lineBreak":true},{"text":"te lëndu jargoñ gën koo dëgër.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Keey tëraale alal ju mu dul gisati;","poem":1},{"lineBreak":true},{"text":"day xippi, fekk mu ne mes.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tiitaangee koy dab nim wal,","poem":1},{"lineBreak":true},{"text":"ngëlénu guddi këf, yóbbu,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ngelawal penku déjjatee ko këram,","poem":1},{"lineBreak":true},{"text":"jalax, mu wéy.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dees na ko diir, bañ koo ñéeblu,","poem":1},{"lineBreak":true},{"text":"mu daw, di wuta rëcc dooley saan ya.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dees na ko tacc-taccali loxo,","poem":1},{"lineBreak":true},{"text":"di ko ciipoo fa këram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}