{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Xel mu rafet, fa Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Xaalis déy am na mbellam,","poem":1},{"lineBreak":true},{"text":"wurus am bérebu seggukaayam,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"weñ gu ñuul ci suuf lees ko jële,","poem":1},{"lineBreak":true},{"text":"te xànjar, ay doj lees di xelli, ba am ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dees na taal, dàqug lëndëm,","poem":1},{"lineBreak":true},{"text":"di gëstu ba fu gëna làqu doji biir lëndëm gu ne këruus.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nit a ngi gas ay xunt fu soreeki dëkkuwaay,","poem":1},{"lineBreak":true},{"text":"di sandaamtalooka jaayu fu kenn newul,","poem":1},{"lineBreak":true},{"text":"te tànk jaarewu fa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaw suuf day meññ ab dund,","poem":1},{"lineBreak":true},{"text":"xóote ya mel ni lu sawara salfaañe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Doj ya ca biir la peri safiir màkkaanoo,","poem":1},{"lineBreak":true},{"text":"te pëndaxu wurus ñàkku fa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wii yoon, tan xamu ko,","poem":1},{"lineBreak":true},{"text":"bëtu jaxaay du ko gis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabu àll du fa joggi,","poem":1},{"lineBreak":true},{"text":"te gaynde sax du fa jaare.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Loxol nit ay song doju kekk,","poem":1},{"lineBreak":true},{"text":"buddi reeni tund, jàllarbi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ci biir xeer yi lay yattey xunt,","poem":1},{"lineBreak":true},{"text":"ba bëtam di gis lu cay alal.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nit a ngi dogale wali ndox,","poem":1},{"lineBreak":true},{"text":"ba lu làqu woon, mu leeral nàññ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waaye xel mu rafet fees koy jële,","poem":1},{"lineBreak":true},{"text":"ak fu ag dégg màkkaanoo?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Doom aadama xamul njëgam,","poem":1},{"lineBreak":true},{"text":"te amul biir réewum aji dund ñi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xóote ya nee: «Xel mu rafet dëkku fi de!»","poem":1},{"lineBreak":true},{"text":"Géej ne: «Nekku fi de!»","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wurus mayewu ko,","poem":1},{"lineBreak":true},{"text":"xaalis wecciwul njëgam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Deesu ko weccee wurusu ngalam it,","poem":1},{"lineBreak":true},{"text":"mbaa peri onigsë ak safiir.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Deesu ko méngaleek wurus ak ngën-gi-per yuy tàkk,","poem":1},{"lineBreak":true},{"text":"te ngën-gi-gànjari wurus wecciwu ko,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"waxeesuli xor ak yeneen xeeti per;","poem":1},{"lineBreak":true},{"text":"xel mu rafet a gën per yu gëna jafe,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"du moroomu peru topaas ba ca réewum Kuus,","poem":1},{"lineBreak":true},{"text":"te wurusu ngalam daal wecciwu ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Xel mu rafet, ana fu mu jóge,","poem":1},{"lineBreak":true},{"text":"ak fu ag dégg màkkaanoo?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ump na bëtu lépp luy dund;","poem":1},{"lineBreak":true},{"text":"njanaaw la fa kaw sax gisu ko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Paxum sànkutee ngi àddoondook dee naan:","poem":1},{"lineBreak":true},{"text":"«Dégmati nanu ub jëwam de!»","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yàllaa ràññee yoon wa jëm xel mu rafet,","poem":1},{"lineBreak":true},{"text":"te moo xam màkkaanam.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kii daal ay jéer ba fa cati àddina,","poem":1},{"lineBreak":true},{"text":"di gis mboolem lu asamaan tiim.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ba Yàlla àppalee ngelaw diisaayam,","poem":1},{"lineBreak":true},{"text":"nattal ndox ab dayoom,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ba mu sàkkalee ab taw dogalu yoonam,","poem":1},{"lineBreak":true},{"text":"sàkkal melax ak dënu aw ñallam,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ca la nemmiku xel mu rafet, xamle ko,","poem":1},{"lineBreak":true},{"text":"samp ko, gëstu ko,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"daldi ne doom aadama:","poem":1},{"lineBreak":true},{"text":"«Ragal Boroom bi daal, mooy xel mu rafet,","poem":1},{"lineBreak":true},{"text":"te dëddu lu bon mooy amug dégg.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}