{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Ayóoba jooy na démbam"]},{"type":"verse","number":1,"content":["Ayóoba yékkateeti baatam, ne:"]},{"type":"verse","number":2,"content":[{"text":"Éy ku ma doon delloo jamono ya woon,","poem":1},{"lineBreak":true},{"text":"fan ya ma Yàlla daa wattoo;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ba mu may tiim, di ma niital,","poem":1},{"lineBreak":true},{"text":"may doxe ag leeram ci biir lëndëm,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ba ma tolloo sama digg doole,","poem":1},{"lineBreak":true},{"text":"te Yàlla xejjoo sama xayma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Booba Aji Man jaa ngeek man ba tey,","poem":1},{"lineBreak":true},{"text":"sama gone yu góor yéew ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"may jàngoom niw,","poem":1},{"lineBreak":true},{"text":"seggukaay di ma walal ag diw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ma génnaa ba ca buntu dëkk ba,","poem":1},{"lineBreak":true},{"text":"digg pénc ma laay jekkasndikoo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"waxambaane gis ma, ñooru,","poem":1},{"lineBreak":true},{"text":"mag ña jóg, taxawal ma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kàngam ne xerem,","poem":1},{"lineBreak":true},{"text":"ub gémmiñam,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"garmi ne selaw,","poem":1},{"lineBreak":true},{"text":"làmmiñam taqoo denqleñam,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"nopp dégg ma, ndokkeel ma,","poem":1},{"lineBreak":true},{"text":"bët gis ma, seedeel ma yiw.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Néew-ji-doole woote, ma wallu,","poem":1},{"lineBreak":true},{"text":"boole ci jirim bu tumurànke.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñaanu ku naroona sànku di ma dal,","poem":1},{"lineBreak":true},{"text":"may tooyal xolu jëtun.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Njekk laa woddoo woon, njekk wodd ma,","poem":1},{"lineBreak":true},{"text":"te dëgg laa defoon mbubb ak kaala.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Silmaxa, maa dooni gëtam;","poem":1},{"lineBreak":true},{"text":"ab lafañ, ma diy tànkam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Néew-ji-doole, maa doon baayam,","poem":1},{"lineBreak":true},{"text":"ku ma xamul sax, may seet àqam.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ku jubadi, ma dammi ŋaamam,","poem":1},{"lineBreak":true},{"text":"foqatee am pàddam cay sellam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ma noon samay fan dina neexook feppi suuf,","poem":1},{"lineBreak":true},{"text":"ma doora deewe sama biir njaboot.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma noon su ma doon garab samay reen fëllem ndox,","poem":1},{"lineBreak":true},{"text":"ab lay fanaanee faam car ya.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma noon darajaa may yeesalal nganam,","poem":1},{"lineBreak":true},{"text":"may gëna daŋalati xala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Man lees daa déglu, di ma xaar;","poem":1},{"lineBreak":true},{"text":"ne cell, di taataan samam xel.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Samay kàddoo leen di dal, genn-genn,","poem":1},{"lineBreak":true},{"text":"te su ma àddoo ba daaneel, kàddu jeex.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Booba lees ma daa séentu nib taw;","poem":1},{"lineBreak":true},{"text":"ŋa ŋàpp, di nég waamey waxset.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Samay ree gëmeesu ko woon,","poem":1},{"lineBreak":true},{"text":"xanaa ne siiwa gis sama kanam gu leer.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Maa jiite woon, di dogal doxalin,","poem":1},{"lineBreak":true},{"text":"toog toogaayu buur ci biir gàngooram,","poem":1},{"lineBreak":true},{"text":"te di leen dëfal ci seen naqar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}