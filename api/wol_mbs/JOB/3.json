{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Ayóoba rëbb na bésub juddoom"]},{"type":"verse","number":1,"content":["Gannaaw loolu Ayóoba àddu, ma ngay móolu bés ba mu juddoo."]},{"type":"verse","number":2,"content":["Mu ne:"]},{"type":"verse","number":3,"content":[{"text":"Sànkute ñeel na bés ba ma juddoo,","poem":1},{"lineBreak":true},{"text":"ba ca guddi ga noon: «Sosees na góor!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boobu bés yal na di lëndëmu neen,","poem":1},{"lineBreak":true},{"text":"di bés bu Yàlla ma fa kaw faaleedi,","poem":1},{"lineBreak":true},{"text":"te genn leer du ko leeralati.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yal na lëndëmu njaniiw aakimoo boobu bés,","poem":1},{"lineBreak":true},{"text":"xàmbaar mbaaral ko,","poem":1},{"lineBreak":true},{"text":"muy guddig digg bëccëg gu raglu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Googu guddi yal na ko lëndëm moom,","poem":1},{"lineBreak":true},{"text":"yàlla bumu bége fi digg bési at mi,","poem":1},{"lineBreak":true},{"text":"yàlla bees ko limaaleeti ci weer yi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Googu guddi kay yàlla bu ci gone sosooti,","poem":1},{"lineBreak":true},{"text":"yàlla bu ci sarxolle jolleeti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yal na alagkati bés yi alag googu guddi,","poem":1},{"lineBreak":true},{"text":"alagkat yu mana xabtal ninki-nanka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yal na biddiiwi njëlam giim,","poem":1},{"lineBreak":true},{"text":"muy séentug leer te du am;","poem":1},{"lineBreak":true},{"text":"yàlla bumu gis fu njël di xippee,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"gannaaw moo tëjul sama biiru ndey,","poem":1},{"lineBreak":true},{"text":"ba làq saay gët coono.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Moo, lu ma tee woona juddu rekk, dellu?","poem":1},{"lineBreak":true},{"text":"Lu ma tee génne sama biiru yaay, noqi rekk, dog, boog?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana lu may óom doon uufe?","poem":1},{"lineBreak":true},{"text":"Ana lu ma doon nàmpey ween?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tëdd koon naak jàmm biir bàmmeel,","poem":1},{"lineBreak":true},{"text":"di nelaw, noppaloondook","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"buur yeek jawriñi àddina,","poem":1},{"lineBreak":true},{"text":"yi tabaxal seen bopp këri buur yu gental tey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Noppalu koon naak garmi yay boroom wurus,","poem":1},{"lineBreak":true},{"text":"te daan feesal seeni kër xaalis.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mbaa ma mel koon ni lumb wu làqu biir suuf,","poem":1},{"lineBreak":true},{"text":"mbaa cuux mu jotula gisug leer.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Biir bàmmeel la ñu bon ñiy noppee sonle,","poem":1},{"lineBreak":true},{"text":"fa la ña jeele doole noppaloo,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ña ñu tëjoon ne finaax,","poem":1},{"lineBreak":true},{"text":"déggatuñu coowal ku leen di sas,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ku tuut ak ku mag di fa benn,","poem":1},{"lineBreak":true},{"text":"jaam noppi faa jaamu sangam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Boroom tiis, ana lees koy maye leeru kaw suuf?","poem":1},{"lineBreak":true},{"text":"Lu boroom naqar di doye bakkan?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ku ni mel ku yàkkamti dee gu dikkul,","poem":1},{"lineBreak":true},{"text":"te gëna sàkku dee alal ju làqu,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ba bu gisoon bàmmeel,","poem":1},{"lineBreak":true},{"text":"di tex-texi ci biir mbég ak bànneex.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ngóor sii aw yoonam làqu,","poem":1},{"text":"ana lu muy doye dund, te Yàlla dar kepp ko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Samay binni di samaw ñam,","poem":1},{"lineBreak":true},{"text":"samay yuux fettax nim ndox.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tiitaange déy a ma dikkal,","poem":1},{"lineBreak":true},{"text":"li ma ragaloon kay a ma dab.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Du jàmm, dug dal, du noflaay bu ma am,","poem":1},{"lineBreak":true},{"text":"jallaañoo dikk na!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}