{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"heading","content":["Ayóoba jooy na coono"]},{"type":"verse","number":1,"content":[{"text":"Tey ñi may diijoo ngii, te ñoo ma féete ndaw,","poem":1},{"lineBreak":true},{"text":"seeni baay a tekkiwuloon tus,","poem":1},{"text":"ba ma siide leena jël, ñuy sàmmandook samay xaj.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ana njariñ lu ñu ma amaloon sax?","poem":1},{"lineBreak":true},{"text":"Yooyu kooñoor yu jeele?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ñii ndóol, xiif, desey yax,","poem":1},{"lineBreak":true},{"text":"di ŋeeñaatoo biir àll,","poem":1},{"lineBreak":true},{"text":"fu lëndëm, gental, maral,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"di witt ñax mu saxe ciy tan","poem":1},{"lineBreak":true},{"text":"aka gasi reen, di dunde.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ñooñu lees dàqe fi biir nit ñi,","poem":1},{"lineBreak":true},{"text":"di leen yuuxoo niy sàcc,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ñu dëkkey xur,","poem":1},{"lineBreak":true},{"text":"ci biiri pax aki doj,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"di ŋaaxe biir gajj gi,","poem":1},{"lineBreak":true},{"text":"dankaloo ci ron dég yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñu sew lañu, ñu kenn yégul,","poem":1},{"lineBreak":true},{"text":"xanaa caw leen, génne réew mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tey nag ñoo may woyantoo,","poem":1},{"lineBreak":true},{"text":"di ma léeboo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dañu maa seexlu, ñooru ma,","poem":1},{"lineBreak":true},{"text":"néeg maa serati ci kanam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yàllaa ma nasaxal, toroxal ma,","poem":1},{"lineBreak":true},{"text":"ba amatuñook man yemukaay.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mii njurum baadoola mu féete ndijoor, di ma téqtal,","poem":1},{"lineBreak":true},{"text":"di ma xàllal yooni sànkute.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñu ngi may dogale, nar maa musibaal,","poem":1},{"lineBreak":true},{"text":"te soxlawuñu ci ndimbal.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fu yaa lañu bëtte,","poem":1},{"lineBreak":true},{"text":"buure jali tojit, ne jàyy fi sama kaw.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Musiba da maa ëlëm,","poem":1},{"lineBreak":true},{"text":"sama daraja naaw ni ngelaw,","poem":1},{"lineBreak":true},{"text":"sama teraanga naaxsaay niw niir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tey maa ngii sama bakkan di ŋiis,","poem":1},{"lineBreak":true},{"text":"bési njàqare ne ma taral.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Guddi dikk di bënn samay yax, muy rot,","poem":1},{"lineBreak":true},{"text":"mitit di ŋereñ te du selaw.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kii ne nikk sama mbubb,","poem":1},{"lineBreak":true},{"text":"ne ràtt sama baatu mbubb,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"xalab ma ci biir ban bi,","poem":1},{"lineBreak":true},{"text":"may nirook pënd akub dóomu-taal.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Woo naa la wall, wuyuwoo ma,","poem":1},{"lineBreak":true},{"text":"ma taxaw, nga niir ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yaa soppiku, néege ma,","poem":1},{"lineBreak":true},{"text":"di ma soxoree sa diisaayu loxo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yaa ma ne siféet, waral ma ngelaw,","poem":1},{"lineBreak":true},{"text":"pamti-pamtee ma biir ngëlén.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xam naa xéll ne ci dee nga ma jëme,","poem":1},{"lineBreak":true},{"text":"te mooy kërug ndajem képp kuy dund.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku sànkule du tàllal loxoo?","poem":1},{"lineBreak":true},{"text":"Ku musiba dab du woote wall?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Moona sama rongooñ a daan tuurul boroom tiis,","poem":1},{"lineBreak":true},{"text":"sama xol di tiisoo aji ñàkk ji.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lu baax laa yaakaar, lu bon ne jalañ,","poem":1},{"lineBreak":true},{"text":"leer laa séentu, guddi ne jaas,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"sama xol lëmbaajoo, tëë dal,","poem":1},{"lineBreak":true},{"text":"bési naqar dogale ma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Maa ngi wéye ñuulaay bu ma tàngoor tegul,","poem":1},{"lineBreak":true},{"text":"di taxawe biir ndaje, di woote wall.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Damaa mujj bokk ak till,","poem":1},{"lineBreak":true},{"text":"neexook looy,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ñuul, yaram di xub,","poem":1},{"lineBreak":true},{"text":"tàng, di bax,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"sama xalam tiisal,","poem":1},{"lineBreak":true},{"text":"sama toxoro jooy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}