{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Léegi Baay Ayóoba, ngalla déglul samay wax","poem":1},{"lineBreak":true},{"text":"te teewlu sama kàddu yépp.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xaaral, ma àddu boog,","poem":1},{"lineBreak":true},{"text":"ba sama làmmiñ tudd li may bëgga wax.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xel mu dëggu laay waxe,","poem":1},{"lineBreak":true},{"text":"samay kàddu di xam-xam bu wóor.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ngelawal Yàllaa ma sos,","poem":1},{"lineBreak":true},{"text":"noowal Aji Man ji daal a ma may bakkan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Soo manee, tontu ma;","poem":1},{"lineBreak":true},{"text":"defarul, janook man.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa ngii, yem ak yaw fa Yàlla;","poem":1},{"lineBreak":true},{"text":"ci ban lañu ma mooñe man itam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Du sama ñàngaay bu lay tiital,","poem":1},{"lineBreak":true},{"text":"du sama daraja ju la diis.","poem":1}]},{"type":"heading","content":["Yàlla du moroom"]},{"type":"verse","number":8,"content":[{"text":"Yaa wax déy, ma dégg,","poem":1},{"lineBreak":true},{"text":"te dégg naa bu baax say kàddu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nga ne: «Set laa def, tooñuma;","poem":1},{"lineBreak":true},{"text":"mucc ayib laa def, ñaawuma fenn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waaye Yàllaa ngii di ma wuta taqal,","poem":1},{"lineBreak":true},{"text":"def ma ab noonam,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"jéng ma,","poem":1},{"lineBreak":true},{"text":"di xool fépp fu ma jaare.»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Foofu déy, moy nga dëgg, ma wax la ko,","poem":1},{"lineBreak":true},{"text":"Yàllaa sut doom aadama.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ana loo koy sikke,","poem":1},{"lineBreak":true},{"text":"naan du layoo lenn ci mboolemi jëfam?","poem":1}]},{"type":"heading","content":["Yàlla dina wax ciy gént"]},{"type":"verse","number":14,"content":[{"text":"Yàlla déy, dees koo teewluwul,","poem":1},{"lineBreak":true},{"text":"waaye day wax benn yoon ba ñaar","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ci biir peeñum géntu guddi,","poem":1},{"lineBreak":true},{"text":"fa nelaw dabe nit,","poem":1},{"lineBreak":true},{"text":"ba mu yàndoore kaw lalam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mu ne ko rukk ndéey,","poem":1},{"lineBreak":true},{"text":"boole kook màndarga, artoo ko ko,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ngir dëdduloo doom aadama ji ay jëfam,","poem":1},{"lineBreak":true},{"text":"musal jàmbaar cig réy,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"sorale bakkanam pax,","poem":1},{"lineBreak":true},{"text":"ba ab xeej du ko bóom","poem":1},{"noteId":2},{"text":".","poem":1}]},{"type":"heading","content":["Eliyu nee: Mitit ndéey la"]},{"type":"verse","number":19,"content":[{"text":"Nit dina mbugaloo mitit wu ko tëral,","poem":1},{"lineBreak":true},{"text":"muy kat-kati rekk.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Day bañ dugub,","poem":1},{"lineBreak":true},{"text":"seexlu ñam wu ko gënoona neex,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"jeex tàkk bay réer aka feeñ,","poem":1},{"lineBreak":true},{"text":"yaxam ya ne fàŋŋ te sàngu woon,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"dundam dëgmal dee,","poem":1},{"lineBreak":true},{"text":"bakkanam di jegeji pax.","poem":1}]},{"type":"heading","content":["Eliyu nee: Njotlaay du ñàkk"]},{"type":"verse","number":23,"content":[{"text":"Waaye su nit ki amee malaakam àttekat,","poem":1},{"lineBreak":true},{"text":"nay kenn sax ci junniy malaaka,","poem":1},{"lineBreak":true},{"text":"ngir xamal nit ki li ko war,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"da koy baaxe, daldi ne Yàlla:","poem":1},{"lineBreak":true},{"text":"«Musal ko ba du wàccagum biir pax.","poem":1},{"lineBreak":true},{"text":"Maa ngeek njotlaayam.»","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yaram wa jotaat tooyaayu ndaw,","poem":1},{"lineBreak":true},{"text":"mu amaat dooley ngoneem;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"bu ñaanee Yàlla, mu nangul ko,","poem":1},{"lineBreak":true},{"text":"geesu ko, mu sarxolle,","poem":1},{"lineBreak":true},{"text":"nde Yàllaay fey nit njekkam,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"nit ki seedeeli ko ca nit ña, ne:","poem":1},{"lineBreak":true},{"text":"«Maa bàkkaar, maa xëtt njub,","poem":1},{"lineBreak":true},{"text":"te feyeesu ma ko sax!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yàllaa ma jot ba jàlluma, jëm pax,","poem":1},{"lineBreak":true},{"text":"xanaa dellu di gisug leer.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Lii lépp déy, la Yàlla di def,","poem":1},{"lineBreak":true},{"text":"mook nit ñaari yoon ba ñett,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ngir sorale bakkanam pax,","poem":1},{"lineBreak":true},{"text":"bàyyee ko leeraangey àddina.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Baay Ayóoba, teewlul, déglu ma,","poem":1},{"lineBreak":true},{"text":"neel cell, ma wax la, man.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Soo amee lenn loo wax, àddul;","poem":1},{"lineBreak":true},{"text":"waxal, ngir bëgg naa laa dëggal.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Lu ko moy nag, yaa may déglu,","poem":1},{"lineBreak":true},{"text":"ne cell, ma jàngal la xam-xam.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"33.18 Manees na koo jànge nii itam: ba du jàllagum dexu dee.","reference":{"chapter":33,"verse":18}}]},"thisChapterLink":"/api/wol_mbs/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}