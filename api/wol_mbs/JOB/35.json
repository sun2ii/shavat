{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Eliyu dellu ne:"]},{"type":"verse","number":2,"content":[{"text":"Defe nga ne lii yoon la?","poem":1},{"lineBreak":true},{"text":"Nga ne: «Maa am dëgg fi kanam Yàlla,»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"te naan ko: «Ana lu ma ci soxal man,","poem":1},{"lineBreak":true},{"text":"ak lu ma ñàkka bàkkaar di jariñ?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Man mii nag maa lay tontu,","poem":1},{"lineBreak":true},{"text":"yaak say xarit.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Séentul asamaan te xool,","poem":1},{"lineBreak":true},{"text":"niiral niir yii la tiim!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Soo bàkkaaree, lu muy wàññi Yàlla?","poem":1},{"lineBreak":true},{"text":"Man ngaa tooñ, tooñati ba def ko dara?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ana njub goo def ba may ko lenn,","poem":1},{"lineBreak":true},{"text":"ak lu muy jële sax ci say loxo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sag mbon, sa moroomu nit lay lor,","poem":1},{"lineBreak":true},{"text":"sag njub it doom aadama ni yaw lay jariñ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nooteel law na ba nit ñiy yuuxu,","poem":1},{"lineBreak":true},{"text":"di woote ku leen wallu ci loxol boroom doole.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Waaye kenn du ci ne: «Wóoy ana Yàlla mi ma sàkk,","poem":1},{"lineBreak":true},{"text":"kiy fentloo woyi cant ci biir guddi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"di nu xamal lu rabu àll xamul?","poem":1},{"lineBreak":true},{"text":"di nu may xel mu njanaaw amul?»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bu nit ñu bon ñiy woote wall, du wuyu","poem":1},{"lineBreak":true},{"text":"ngir seenug réy.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Neen lañuy woote, ndax Yàlla du leen déglu,","poem":1},{"lineBreak":true},{"text":"Aji Man ji du leen faale.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kon ngalla yaw mi ne gisoo ko,","poem":1},{"lineBreak":true},{"text":"te ne diis nga ko sa mbir, di ko xaar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nga neeti Yàlla du mer, di mbugale,","poem":1},{"lineBreak":true},{"text":"te yoonam newul ci njubadiy nit.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ayóoba mii de, cóolóolu neen lay wax,","poem":1},{"lineBreak":true},{"text":"mbel-mbel ju àndul ak xam-xam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}