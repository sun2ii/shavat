{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"heading","content":["Eliyu nee: Coonoy àddina am njàng la"]},{"type":"verse","number":1,"content":["Eliyu dellu ne:"]},{"type":"verse","number":2,"content":[{"text":"Négal tuuti, ma xamal la;","poem":1},{"lineBreak":true},{"text":"ay kàddoo ngeeti yu may waxal Yàlla.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fu xóot laay jukkee sama xam-xam,","poem":1},{"lineBreak":true},{"text":"ba delloo dëgg Ki ma sàkk.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sikk déy, nekkul ci li ma lay wax;","poem":1},{"lineBreak":true},{"text":"ku buural xam-xam a janook yaw nii!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dama ne, Yàllaa màgg te du jalaxe,","poem":1},{"lineBreak":true},{"text":"moo màgg te réyum xel.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Du ba ku bon, mu dund,","poem":1},{"lineBreak":true},{"text":"te mooy jox néew-ji-doole àqam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Du noppee xool aji jub ñi,","poem":1},{"lineBreak":true},{"text":"xanaa di leen dëj ci jali buur yi,","poem":1},{"lineBreak":true},{"text":"saxal seen toogaay, màggal leen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu ñu demee ba ñu jéng leen,","poem":1},{"lineBreak":true},{"text":"mbaa buumi njàqare ŋodaar leen,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yàllaa leen koy artoo ci seeni jëf,","poem":1},{"lineBreak":true},{"text":"seen tooñi reewande.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Da leen di dégtal ndigal,","poem":1},{"lineBreak":true},{"text":"ne leen ñu dëddu ñaawtéef.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Su ñu ko dégloo, déggal ko,","poem":1},{"lineBreak":true},{"text":"jeexale bés yu rafet,","poem":1},{"lineBreak":true},{"text":"mujje ati bànneex.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Su ñu dégluwul, jàlli dexu dee,","poem":1},{"lineBreak":true},{"text":"faatu ndax xamadi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ab yéefar day denc mer,","poem":1},{"lineBreak":true},{"text":"te mbugal du tax mu woote wall.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku ni mel ay deewe ndaw,","poem":1},{"lineBreak":true},{"text":"ay fanam jeexe biir gàcce.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yàllaay wallu boroom tiis ciw tiisam,","poem":1},{"lineBreak":true},{"text":"di tege coono, ba ñu déglu ko.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Moom it moo lay xettali ci njàqare,","poem":1},{"lineBreak":true},{"text":"weccee la ko fu yaa fu la dara xatalul,","poem":1},{"lineBreak":true},{"text":"taajal la ñam wu duun te niin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Waaye añu ku bon duunal na la,","poem":1},{"lineBreak":true},{"text":"dëgg ak yoon ne la taral.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bu la kenn xiirtale alal,","poem":1},{"lineBreak":true},{"text":"te bu la ger bu réy jengloo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kon déy doo yuuxu ba mucc ci njàqare,","poem":1},{"lineBreak":true},{"text":"kër-këreek doole it du la ca génne.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bul yàkkamti guddi;","poem":1},{"lineBreak":true},{"text":"ca law xeet di jekki buuboo seenum réew.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Moytula walbatiku di def ñaawtéef,","poem":1},{"lineBreak":true},{"text":"moo tax nattu dikkal la.","poem":1}]},{"type":"heading","content":["Yàlla mooy Buur"]},{"type":"verse","number":22,"content":[{"text":"Yàlla, kay, mooy ki dooleem kaweel!","poem":1},{"lineBreak":true},{"text":"Ana ku mana jàngale ni moom?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ana ku ko masa rëddal yoonam?","poem":1},{"lineBreak":true},{"text":"Ak ku ko ne: «Def nga naka-su-dul-noonu?»","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bul di fàttee màggal jëfam,","poem":1},{"text":"yi ko nit ñiy woye.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mboolem doom aadama gis na ko;","poem":1},{"lineBreak":true},{"text":"nitoo nit séene ko fu sore.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yàlla kay, daa màgg ba wees xam-xam,","poem":1},{"lineBreak":true},{"text":"te ay atam, deesul xayma lim ba.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Keey ñoddi toqi ndox,","poem":1},{"lineBreak":true},{"text":"mu defub lay, tawal,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"niir yi sotti,","poem":1},{"lineBreak":true},{"text":"baawaanal doom aadama.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ana ku xam ni aw xiin di firikoo,","poem":1},{"lineBreak":true},{"text":"ba dënu fettaxe xaymab Yàlla ba?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Keey taal melaxam, mu dajal asamaan,","poem":1},{"lineBreak":true},{"text":"sàng xóotey géej.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Noonu lay saytoo xeet yi,","poem":1},{"lineBreak":true},{"text":"ba maye ñam wu ne gàññ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ñaari loxoom lay ŋëbe melax gi,","poem":1},{"lineBreak":true},{"text":"dalal ko fa mu ko sant,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"kàddu yéene ab taw,","poem":1},{"lineBreak":true},{"text":"jur gi yég ne mu ngi dikk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}