{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"Lii déy a rëccal sama fit,","poem":1},{"lineBreak":true},{"text":"muy tëf-tëfee fa mu sax.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dégluleen a déglu dënoom gay ràndaŋ,","poem":1},{"lineBreak":true},{"text":"kàddu gay rëkke fa gémmiñam,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"muy riiral fépp fu asamaan tiim,","poem":1},{"lineBreak":true},{"text":"di fettaxal melaxam ba cati àddina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ca lay yëmmu,","poem":1},{"lineBreak":true},{"text":"dënoo kàddoom gu màgg,","poem":1},{"lineBreak":true},{"text":"te dootul téye melax yi,","poem":1},{"lineBreak":true},{"text":"li feek baatam di jib.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yàllaay dënu kéemtaan,","poem":1},{"lineBreak":true},{"text":"di def kiraama yu nu wees.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kee naan tawub yuur mu sóobal suuf,","poem":1},{"lineBreak":true},{"text":"di yebal taw ba ci waame yiy sóobe doole,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"daldi téye loxol képp ku doon liggéey,","poem":1},{"lineBreak":true},{"text":"ngir képp ku mu sàkk xam jëfam;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rabu àll duggi biir xuntam,","poem":1},{"lineBreak":true},{"text":"goori biir paxam,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ngëlén bawoo néegam,","poem":1},{"lineBreak":true},{"text":"sedd ba tukkee fa ngelawi bëj-gànnaar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yàllaay nokki, ndox mi soppi galaas,","poem":1},{"lineBreak":true},{"text":"wali ndox rasu, ne kekk.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Keey sëf xàmbaar, mu guux,","poem":1},{"lineBreak":true},{"text":"keey tasaare niir yi làmboo melaxam,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ñu jargandalu ci ndigalam","poem":1},{"lineBreak":true},{"text":"di fexee sottal mboolem santaaneem","poem":1},{"lineBreak":true},{"text":"ci kaw àddina wërngal këpp,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mu mel ni yet wu muy bantale waa àddinaam,","poem":1},{"lineBreak":true},{"text":"mbaa mu firndeele leen ko ngoram.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaw Baay Ayóoba, teewlul lii,","poem":1},{"lineBreak":true},{"text":"neel tekk te jàngat kéemaani Yàlla yi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dangaa xam nu Yàlla di sosey niiram,","poem":1},{"lineBreak":true},{"text":"ba melaxal melax gi ci niiram?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dangaa xam nu niir yiy ajoo ci jaww ji,","poem":1},{"lineBreak":true},{"text":"kiraamay ku buural xam-xam a ngoog!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yaw mi say yére di tàng,","poem":1},{"lineBreak":true},{"text":"bu ngelawu bëj-saalum di upp, suuf ne tekk,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ndax yaa ko lalle woon déndub asamaan,","poem":1},{"lineBreak":true},{"text":"mu dëgër ni weñ gu ñu xelli?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Xamal nu boog lu nuy wax Yàlla!","poem":1},{"lineBreak":true},{"text":"Dunu mana lay ndax ñàkka xam.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ndax dees koy yégal ne maay waaja wax?","poem":1},{"lineBreak":true},{"text":"Ana nit kuy ñaan sànkutey boppam?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kenn manula xool jant bu ne ràññ,","poem":1},{"lineBreak":true},{"text":"gannaaw bu ngelaw walee niir yi ba mu set.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bëj-gànnaar la leeru wurus di dikke,","poem":1},{"lineBreak":true},{"text":"booba Yàllaa làmboo darajaam ju raglu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aji Man ji nu dul daj daa bare doole,","poem":1},{"lineBreak":true},{"text":"dëggu, di boroom njub, du noote.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Moo tax ñu ragal ko,","poem":1},{"lineBreak":true},{"text":"faalewul kenn ku nawum xelam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}