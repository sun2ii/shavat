{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Aji Sax ji àddu na"]},{"type":"verse","number":1,"content":["Ba loolu amee Aji Sax ji àddoo fa ngëlén la, ne Ayóoba:"]},{"type":"verse","number":2,"content":[{"text":"Ana koo doon, bay lëntal samay dogal,","poem":1},{"lineBreak":true},{"text":"di wax loo xamul dara?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Takkul boog te góor-góorlu,","poem":1},{"lineBreak":true},{"text":"ma laaj la, nga xamal ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ana foo nekkoon ba may lal suuf?","poem":1},{"lineBreak":true},{"text":"Waxal su la ko sam xel mayee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ana ku dogal dayo ya; umpu la?","poem":1},{"lineBreak":true},{"text":"Ku tàllal buum, natte ko ko?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ana fu kenuy àddina ya sampe?","poem":1},{"lineBreak":true},{"text":"Ak ku teg doju koñ ba,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ba biddiiwi njël sarxolleendoo,","poem":1},{"lineBreak":true},{"text":"goney Yàlla yépp xaacoondoo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ana ku tëjoon lafi buntu géej,","poem":1},{"lineBreak":true},{"text":"ba muy buccikoo xóote ya, fettax,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ba ma solal ko aw niir, mbubb,","poem":1},{"lineBreak":true},{"text":"laltaaye ko lëndëm,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"dagg aw xélam, àppal ko kemu,","poem":1},{"lineBreak":true},{"text":"dogalee ko bunt bu tëje ràpp,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ba ne ko: «Fii ngay yem, doo fi wees.","poem":1},{"lineBreak":true},{"text":"Fii la say gannax di noppee buure»?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana foo masa joxe suba ndigal,","poem":1},{"lineBreak":true},{"text":"ba xamal njël bérebam,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ngir mu jàppe cati àddina, ag leeram,","poem":1},{"lineBreak":true},{"text":"yëlëbe ca ñu bon ñi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"àddina mel ni ban bu ñu teg torluwaay,","poem":1},{"lineBreak":true},{"text":"tey saamandaay mbubb mu ñu suub.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñu bon ñi, ñu xañ leen seenug leer,","poem":1},{"lineBreak":true},{"text":"ba loxo ba ñu xàccoon damm?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yaa àkki ba fa géej bënne?","poem":1},{"lineBreak":true},{"text":"Am yaa daagoo ruqi xóotey géej?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dees laa won bunti dee?","poem":1},{"lineBreak":true},{"text":"Am yaa gis bunt ya jëm lëndëmu njaniiw?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dangaa ràññee yaatuwaayu suuf si?","poem":1},{"lineBreak":true},{"text":"Waxal, ndegam xam nga lii lépp!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ana yoon wa jëm fa leer dëkke,","poem":1},{"lineBreak":true},{"text":"ak fa lëndëm màkkaanoo,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ba nga man leena yóbbu fa ñu digaloo,","poem":1},{"lineBreak":true},{"text":"te ràññee seen yooni kër?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xam nga ko moos, fekk na la juddu;","poem":1},{"lineBreak":true},{"text":"dund nga ay fani fan!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yaa àkki ba fa mbàndi tawu yuur ya?","poem":1},{"lineBreak":true},{"text":"Am yaa gis mbàndi waamey donj yu sedd","poem":1}]},{"type":"verse","number":23,"content":[{"text":"ya may dencal jamonoy njàqare","poem":2},{"lineBreak":true},{"text":"ngir bésub ndajem xare?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ana yoon wu jëm fa leer di tasaaroo?","poem":1},{"lineBreak":true},{"text":"Ak fu ngelawal penku di xàjjalikoo, ba dajal suuf si?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ana ku xàllal waame,","poem":1},{"lineBreak":true},{"text":"ak ku sàkkal melax ak dënu aw yoon,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"di taw fu kenn newul,","poem":1},{"lineBreak":true},{"text":"ci màndiŋ mu nit amul,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"di suuxat gent bu maral,","poem":1},{"lineBreak":true},{"text":"ba saxal fam ñax?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ab taw, ndax am na baay?","poem":1},{"lineBreak":true},{"text":"Ana ku geñoom sos toqi lay?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ana ku wasin galaas,","poem":1},{"lineBreak":true},{"text":"ak ku jur layub asamaan bu sedd ba wow,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ba wali ndox yi dëgër niw doj,","poem":1},{"lineBreak":true},{"text":"déndu géej fasu, ne kekk?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yaay faste genn dëllooñ gu ndaw gi ci digg asamaan?","poem":1},{"lineBreak":true},{"text":"Am yaay yiwi dëllooñ gu mag ga mu dendal?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yaay def bu jotee, nga feeñal biddiiw yi?","poem":1},{"lineBreak":true},{"text":"Am yaay wommat dëllooñu bëj-gànnaar","poem":1},{"lineBreak":true},{"text":"ak njabootam gu sew?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Dangaa xam dogali yoon yi yor asamaan?","poem":1},{"lineBreak":true},{"text":"Am yaay saytu kilifteefam fi kaw suuf?","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yaay yékkatil niir yi kàddug ndigal,","poem":1},{"lineBreak":true},{"text":"rekk waame sang la?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yaay yebal melax yi ñu dem,","poem":1},{"lineBreak":true},{"text":"melaxi, délsi, ne la: «Nu ngii, ak fan nag?»","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ana ku yeb xel mu rafet cib dënn,","poem":1},{"lineBreak":true},{"text":"ak ku may ab xol dég-dég?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ana ku xareñ ba waññ niir yi?","poem":1},{"lineBreak":true},{"text":"Ak kuy jolal mbuusi asamaan,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ba suuf di bàq, dankaloo,","poem":1},{"lineBreak":true},{"text":"defi donj, taqaloo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Yaay rëbbal gaynde?","poem":1},{"lineBreak":true},{"text":"Am yaay reggal doomu gaynde","poem":1}]},{"type":"verse","number":40,"content":[{"text":"ju goore biir paxam,","poem":2},{"text":"mbaa mu waafem ngeer, di tëroo?","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ana kuy xont baaxoñ,","poem":1},{"lineBreak":true},{"text":"fa doom yay woowe Yàlla wall,","poem":1},{"lineBreak":true},{"text":"di tërëf ndaxub xiif?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}