{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"Yaa xam jamono ju kéwéli tund di jur?","poem":1},{"lineBreak":true},{"text":"Am yaa gis fu kéwél di ame doom?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaa lim weer yi muy ëmb,","poem":1},{"lineBreak":true},{"text":"am yaa xam fu njuram jote,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ba mu sukk, jur,","poem":1},{"lineBreak":true},{"text":"tàggook mititu matam,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ak fa doom jay leqalikooka màgg ci àll bi,","poem":1},{"lineBreak":true},{"text":"ba dem, te du délsi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ana ku yóbbu fasu àll, afal ko?","poem":1},{"lineBreak":true},{"text":"Ana ku yiwi mbaamu àll, wacc ko?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moom mi ma jox màndiŋ mi, mu dëkke,","poem":1},{"lineBreak":true},{"text":"ak jooru xorom, mu màkkaanoo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yégul riirum taax,","poem":1},{"lineBreak":true},{"text":"déggul coowal dawalkat.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tund yi lay wërem poram,","poem":1},{"lineBreak":true},{"text":"di fa seete gépp gàncax gu tooy.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ndax nagu àll a lay nangoo liggéeyal?","poem":1},{"lineBreak":true},{"text":"Mbaa mu di la fanaanal ci sa ngédd?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Man ngaa takk nagu àll cim rijji,","poem":1},{"lineBreak":true},{"text":"ba mu topp la, rijjil lab tool?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaa koy yaakaare dooleem ju bare,","poem":1},{"lineBreak":true},{"text":"ba dénk ko sab liggéey?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yaay yaakaar mu fatal la jiwu,","poem":1},{"lineBreak":true},{"text":"jëlil la ko ca dàgga ja?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bànjóolee ngi tëf-tëflu,","poem":1},{"lineBreak":true},{"text":"te xodd gën koy laaf.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mooy wacci nenam fi suuf,","poem":1},{"lineBreak":true},{"text":"bàyyee ko tàngooru suuf.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xalaatul tànk bu ci joggi","poem":1},{"lineBreak":true},{"text":"ak rabu àll wu ko dëggaate.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Day soxore doom yi ni lu mu jurul,","poem":1},{"lineBreak":true},{"text":"coonoom neen, yoonam.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yàllaa ko xañ xam-xam,","poem":1},{"lineBreak":true},{"text":"te séddu ko xelum ràññee.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Waaye bu sàqee, ba sàqi,","poem":1},{"lineBreak":true},{"text":"faalewul fas ak gawaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndax yaa may aw fas kàttan?","poem":1},{"lineBreak":true},{"text":"Am yaa solal ndodd ma ciiriir?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Am yaa koy tëbloo nim soccet,","poem":1},{"lineBreak":true},{"text":"bu fiiroo, fit rëcc?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Fas a ngi bége dooleem, di curpee xur wa,","poem":1},{"lineBreak":true},{"text":"riddi, dajeek ngànnaay.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yégul tiitaange, ragalul,","poem":1},{"lineBreak":true},{"text":"dawul saamar.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mbarum fitt a ngay keseŋ-keseŋi fa kawam,","poem":1},{"lineBreak":true},{"text":"fa xeej ak jaasi lerxatandoo,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"mu buure xadar, taxañ suuf si,","poem":1},{"lineBreak":true},{"text":"téyeetul boppam ndax bufta ba","poem":1},{"noteId":3},{"text":"jolli,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"mu feeloo ko coowal wakkan ya.","poem":1},{"lineBreak":true},{"text":"Fu sore lay xeeñtoo xare ba,","poem":1},{"lineBreak":true},{"text":"ak kàdduy njiiti xare ya riirandook xaacu ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ndax sam xel la céeliy daayaarloo,","poem":1},{"lineBreak":true},{"text":"ba firiy laafam, jëm bëj-saalum?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Am yaa sant jaxaay mu naaw ba fa kaw,","poem":1},{"lineBreak":true},{"text":"di tàgge kawte ya?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aw doj, mu màkkaanoo,","poem":1},{"lineBreak":true},{"text":"di fanaan kaw catu doj wu ko kenn dul jote.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Fa lay yeeroo am rëbbam,","poem":1},{"lineBreak":true},{"text":"di ko niire fu sore.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ku ñu bóom, ma nga fa teew,","poem":1},{"lineBreak":true},{"text":"doom yay xab deret ja.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"39.24 bufta, ab béjjénu kuuy la, bu ñu bënn ñaari wet yi, ngir man cee wal.","reference":{"chapter":39,"verse":24}}]},"thisChapterLink":"/api/wol_mbs/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}