{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifas nee: Yaru Yàlla du ñàkk"]},{"type":"verse","number":1,"content":["Elifas waa Teman ba àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Ma jéema àddu boog, soo ma talee!","poem":1},{"lineBreak":true},{"text":"Ndaxam noppeeti, maneesu ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaw de, ñu bare jàngal nga leen,","poem":1},{"lineBreak":true},{"text":"loxo yu toqi woon, nga dooleel,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ku jangoon, nga wax, mu taxaw,","poem":1},{"lineBreak":true},{"text":"kuy óomam dammoon, nga dëgëral.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Léegi muy yaw, nga yoqi;","poem":1},{"lineBreak":true},{"text":"mbir mi dal fi sa kaw, nga jànnaxe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xanaa du sag ragal Yàllaay sa cëslaay,","poem":1},{"lineBreak":true},{"text":"sag màndute di sa yaakaar?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Seetal rekk, ana jàmburu Yàlla bu masa sànku?","poem":1},{"lineBreak":true},{"text":"Ana foo gis ku jub ku mujje yàqu?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li ma gis daal, ku bey ñaawtéef,","poem":1},{"text":"ji coono, yaa koy góob.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yàllaay wal noowam, nga sànku,","poem":1},{"lineBreak":true},{"text":"sànjam gelaw, nga jeele.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gaynde ŋar, segg xiiru,","poem":1},{"lineBreak":true},{"text":"selli waxambaaney gaynde tojandoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gaynde ga ñàkkum pàdd, dee,","poem":1},{"lineBreak":true},{"text":"doomi gaynde ga tasaaroo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Man la kàddu dikkal ci kumpa,","poem":1},{"lineBreak":true},{"text":"sama nopp taataan ndéey la,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ci géntu guddi, fa xalaat di jaxasoo,","poem":1},{"lineBreak":true},{"text":"nelaw yu xóot dikkal boroom.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tiitaange ne ma taral, may lox,","poem":1},{"lineBreak":true},{"text":"cér yépp di kat-kati.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ngelaw lu sew jaare sama kanam,","poem":1},{"lineBreak":true},{"text":"sama kawari yaram ne sàyy-sàyyaaral.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mu def ku taxaw, te xàmmeewuma ko,","poem":1},{"lineBreak":true},{"text":"di jëmm ju janook man, may gis.","poem":1},{"lineBreak":true},{"text":"Mu jëkke ne cell, mujje àddu, ma dégg.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mu ne: «Ndax nit man naa am dëgg fa kanam Yàlla?","poem":1},{"lineBreak":true},{"text":"Am man naa laab fi kanam Ki ko sàkk?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ndegam surgaam ya ca asamaan sax wóoluwu leen,","poem":1},{"lineBreak":true},{"text":"ay malaakaam sax, mu sikk leen,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"gën ñi dëkke këri ban,","poem":1},{"lineBreak":true},{"text":"cosaanoo ci pëndub neen,","poem":1},{"lineBreak":true},{"text":"gëna neexa nappaaje gunóor.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Diggante subaak ngoon, ñu moxoñoo,","poem":1},{"lineBreak":true},{"text":"bala ngaa yég, ñu sànku fàww,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"seen buumi xayma foqatiku,","poem":1},{"lineBreak":true},{"text":"ñu dee ci biir ag umple.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}