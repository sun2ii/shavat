{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Aji Sax ji dellu ne Ayóoba:"]},{"type":"verse","number":2,"content":[{"text":"Yaw miy layook Aji Man ji, dangay diiŋat?","poem":1},{"lineBreak":true},{"text":"Yaw miy weranteek Yàlla, doo tontu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayóoba àddu ne Aji Sax ji:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Man mi tekkiwul dara, nu ma lay tontoo?","poem":1},{"lineBreak":true},{"text":"Sama loxo laa ube sama gémmiñ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maa waxoon benn yoon, waxatuma;","poem":1},{"lineBreak":true},{"text":"maa tóllanti woon, dootul am.","poem":1}]},{"type":"heading","content":["Yàlla dëkk na Ayóoba"]},{"type":"verse","number":6,"content":[{"text":"Aji Sax ji daldi àddoo fa ngëlén la, ne Ayóoba:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Takkul boog te góor-góorlu,","poem":1},{"lineBreak":true},{"text":"ma laaj la, nga xamal ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sañ nga maa teg tooñ daal,","poem":1},{"lineBreak":true},{"text":"di ma sikkal, ba am dëgg?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dangaa am dooley Yàlla,","poem":1},{"lineBreak":true},{"text":"mbaa kàddu guy dënu ni gosam?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ràngool boog màggaay ak teraanga,","poem":1},{"lineBreak":true},{"text":"te làmboo dayook daraja.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yuril sa mer,","poem":1},{"lineBreak":true},{"text":"te xool képp ku bew, detteel ko,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"xoolal képp ku bew, toroxal ko,","poem":1},{"lineBreak":true},{"text":"te dëggaate ku bon fa mu taxaw.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Boole leen làq biir suuf,","poem":1},{"lineBreak":true},{"text":"tëjleen ràpp fu làqu fa,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kon déy man maa lay sargal,","poem":1},{"lineBreak":true},{"text":"muy ndam lu la sa doole may.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Beyemot rab wu réy","poem":1},{"noteId":4},{"text":"waa ngii, maa ko sàkk, sàkk la,","poem":1},{"lineBreak":true},{"text":"ñax lay lekk niw nag.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Doole jaa ngoogu ca ndigg la,","poem":1},{"lineBreak":true},{"text":"kàttan ga laloo suuxi biir ba,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"geen ga ne kàdd ni garabu seedar,","poem":1},{"lineBreak":true},{"text":"sidditi lupp ya ñabaloo,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"yax ya di ponki xànjar,","poem":1},{"lineBreak":true},{"text":"cér ya mel ni yeti weñ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Moo gëna yéeme ci li Yàlla sàkk,","poem":1},{"lineBreak":true},{"text":"te ki ko sàkk doŋŋ a koy boccil saamar.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Xontam déy tund yee ko yor,","poem":1},{"lineBreak":true},{"text":"rabi àll yépp di fowe fa wetam.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Keppaaru déem lay goore,","poem":1},{"lineBreak":true},{"text":"làqoo barax ak ban,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"déem ya keral ko,","poem":1},{"lineBreak":true},{"text":"garabi tàkk ga yéew ko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dex gu fees jaaxalu ko,","poem":1},{"lineBreak":true},{"text":"gannaxi dexu Yurdan di ko talaata, mu ne tekk.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ana ku koy jàpp te muy xoole?","poem":1},{"lineBreak":true},{"text":"Ak ku koy nos, ba téye ko?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ninki-nanka","poem":1},{"noteId":5},{"text":"nag yaa koy nappe oos?","poem":1},{"lineBreak":true},{"text":"Am yaay yeewe làmmiñ wa ag buum?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yaay nase wakkan ya ag buum?","poem":1},{"lineBreak":true},{"text":"Am yaay bëtt ŋaam wa, we ca lonku?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Xanaa ca la lay tinoo tinu,","poem":1},{"lineBreak":true},{"text":"di la lewetali kàddoom?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Xanaa kon mooy digook yaw,","poem":1},{"lineBreak":true},{"text":"ngir nga def ko jaam ba fàww?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Am yaa koy fowe ni picc,","poem":1},{"lineBreak":true},{"text":"takkal ko sa janq ji, ñu di ko seetaan?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dees na ko waxaaleendoo?","poem":1},{"lineBreak":true},{"text":"Am ay julaa koy séddoo?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Yaa koy jamati xepp a?","poem":1},{"lineBreak":true},{"text":"Am yaa koy xaañ xeeju nappkat?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Teg ko loxo, seet;","poem":1},{"lineBreak":true},{"text":"dootoo fàtte boobu xeex,","poem":1},{"lineBreak":true},{"text":"te doo ko dolleeti.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"40.15 rab wu réy wii am na ñu jàpp ne léebéer la.","reference":{"chapter":40,"verse":15}},{"noteId":5,"caller":"+","text":"40.25 ninki-nanka jii am na ñu jàpp ne jasig la.","reference":{"chapter":40,"verse":25}}]},"thisChapterLink":"/api/wol_mbs/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":32}