{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Wii rab, yaakaar koo jàpp nax sa bopp la;","poem":1},{"lineBreak":true},{"text":"bu nee jaas, nga jóoru.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kenn ñàngul, ba sañ koo merloo.","poem":1},{"lineBreak":true},{"text":"Kon ana kuy taxaw fi sama kanam man?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ana ku ma abal lenn ba ma war koo delloo?","poem":1},{"lineBreak":true},{"text":"Lépp lu mboolem asamaan tiim, maay boroom!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rab wii, duma noppee waxtaaney céram","poem":1},{"lineBreak":true},{"text":"ak kiraamay dooleem ak jekkaayu bindam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ana ku mana summib turkeem?","poem":1},{"lineBreak":true},{"text":"Ana ku mana bëtt kiiraayu ñaar-caam?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ana ku koy ŋaal,","poem":1},{"lineBreak":true},{"text":"ak sellam yu dajal te raglu?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gannaaw gi ay sàppey pakk la,","poem":1},{"lineBreak":true},{"text":"di ab tay bu tëje ràpp,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"dugglante benn-benn,","poem":1},{"lineBreak":true},{"text":"ba ngelaw sax xaju ca,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"xanaa ñu ne ñàpp, ku ne taq sa moroom,","poem":1},{"lineBreak":true},{"text":"te duñu teqalikoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bu tislee, melax ne ràyy,","poem":1},{"lineBreak":true},{"text":"mu xippi, nga ne fajar ay xapp-xappal.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jumi sawaraay tàkke ca gémmiñ ga,","poem":1},{"lineBreak":true},{"text":"ferñent ya jiitu,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"saxaar di sël-sëlee ca wakkan ya,","poem":1},{"lineBreak":true},{"text":"mbete cóolóolu cin luy bax.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ngelawal bakkanam jafal nay xal,","poem":1},{"lineBreak":true},{"text":"sawara ne jippét, tàkke ca gémmiñam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndoddam la doole daloo,","poem":1},{"lineBreak":true},{"text":"te fu mu dëgmal tëbum tiitaange fa la.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ay ndombo la der ba def, dankalikoo,","poem":1},{"lineBreak":true},{"text":"ne këcc, ne degg.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dënn baa nga dëgër niw doj,","poem":1},{"lineBreak":true},{"text":"ne këcc ni doju wolukaay.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bu jógee, jàmbaar ñi tiit,","poem":1},{"lineBreak":true},{"text":"muy rajaxe, ñu jommi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nga jam ko saamar, du dugg;","poem":1},{"lineBreak":true},{"text":"xepp akug fitt akub xeej, noonu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Weñ gu ñuul di ko safum mboob,","poem":1},{"lineBreak":true},{"text":"xànjar niru ko matt mu nëb.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ndawal fitt dawloowu ko,","poem":1},{"lineBreak":true},{"text":"doju mbaq di ngooñ mu koy ñiramtal.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bolde di ko saf ñax gu wow,","poem":1},{"lineBreak":true},{"text":"ab xeej riir, def koy ree.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lu mel ni tojitu xandeer a lal biir ba,","poem":1},{"lineBreak":true},{"text":"di rijji bañ bi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mooy baxloo xóote yi ni cin,","poem":1},{"lineBreak":true},{"text":"di fuural géej ni njaq lu garab xooje.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gannaawam ay def xàll wuy lerxat,","poem":1},{"lineBreak":true},{"text":"mbàmbulaan miy saf bijjaaw.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amul niruwaale fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"mii mbindeef mu dul tiit.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Képp ku réy, mu xool la bëtu suufe,","poem":1},{"lineBreak":true},{"text":"képp ku bew, muy sa buur.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":26}