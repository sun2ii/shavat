{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Rikk wooteel, ndegam am na ku lay wallu!","poem":1},{"lineBreak":true},{"text":"Ana ci ñu sell ñi, kan ngay sàkku ndimbal?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Am sanax déy, naqari deret a koy rey,","poem":1},{"lineBreak":true},{"text":"ab téxét, xéraangee koy faat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maa gis am sanax, mu saxi reen,","poem":1},{"lineBreak":true},{"text":"ma jekki ñaan alkàndey dëkkuwaayam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ay doomam ay sore yoonu mucc,","poem":1},{"lineBreak":true},{"text":"ñu di leen dëggaate ca pénc ma,","poem":1},{"lineBreak":true},{"text":"te kenn du leen xettali.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Am ngóobam, ku xiif a koy lekk,","poem":1},{"lineBreak":true},{"text":"ba lekkaale la saxe biir dég ya,","poem":1},{"lineBreak":true},{"text":"te alalam, ku mar a koy ŋaf-ŋafee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aw ay du garab, bay fëlle biir suuf,","poem":1},{"lineBreak":true},{"text":"coono du jekki, jebbi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ku juddu, coono nga juddul,","poem":1},{"lineBreak":true},{"text":"mooy ferñent, kaw rekk la jëm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Man de su ma doon yaw damay sàkku Yàlla,","poem":1},{"lineBreak":true},{"text":"te kon Yàlla laay diis sama mbir.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Keey def jëf ju màgg ju nattuwul,","poem":1},{"lineBreak":true},{"text":"di def kiraama yu limuwul.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Keey taw, suuxat suuf,","poem":1},{"lineBreak":true},{"text":"yónnee ndox, nàndal àll.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Keey kaweel ku suufe,","poem":1},{"lineBreak":true},{"text":"kuy ñaawlu siggee mbégte.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Keey neenal pexem ku muus,","poem":1},{"lineBreak":true},{"text":"ba mébétam du sotti.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Keey jàpp boroom xel cig muusam,","poem":1},{"lineBreak":true},{"text":"ba pexem ndëngteem teela sooy.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ñu ni mel, bëccëg ñu dajeek lëndëm,","poem":1},{"lineBreak":true},{"text":"di làmbatoo digg bëccëg ni bu doon guddi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yàllaay musal néew-ji-doole ci saamaru làmmiñ","poem":1},{"lineBreak":true},{"text":"ak loxol boroom doole,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"néew-ji-doole jagoo yaakaar,","poem":1},{"lineBreak":true},{"text":"defkatu njekkar ub gémmiñug boppam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ma ne, ndokkalee ku Yàlla jubbanti,","poem":1},{"lineBreak":true},{"text":"kon bul bañ yarub Aji Kawe ji.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Moom kat mooy mitital, di fajtal;","poem":1},{"lineBreak":true},{"text":"mooy gaañe, di wérale loxol boppam.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Juróom benni njàqare teew, mu xettali la ca,","poem":1},{"lineBreak":true},{"text":"ba ko juróom ñaareel sax, doo ca loru.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ab xiif, moo la cay jote ba doo dee,","poem":1},{"lineBreak":true},{"text":"ab xare, nga mucc ñawkay saamar,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"aayteefu làmmiñ, nga fegu ca,","poem":1},{"lineBreak":true},{"text":"te yàqule guy dikk, doo ko ragal.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yàquleek xiif, nga kekku;","poem":1},{"lineBreak":true},{"text":"rabu àll, doo ko ragal.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Doji àll bi sax, kóllëreg jàmm ngay séq ak ñoom,","poem":1},{"lineBreak":true},{"text":"te rabi àll yi dañuy jàmmook yaw,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"nga xam ne sa xayma, jàmm,","poem":1},{"lineBreak":true},{"text":"soo nemmikoo sa parlu, dara du ca wuute.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dangay ràññee ni saw askan di yaatoo,","poem":1},{"lineBreak":true},{"text":"say sët di law ni gàncax.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ni pepp di ñore, ñu door koo góob,","poem":1},{"lineBreak":true},{"text":"ni ngay màggataale doole, doora dëgmal bàmmeel.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Lii kat lanu gis, te lii rekk la.","poem":1},{"lineBreak":true},{"text":"Dégg, jariñu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}