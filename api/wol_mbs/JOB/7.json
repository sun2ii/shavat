{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Xanaa du fani doom aadama fi kaw suuf","poem":1},{"text":"àppu doñ-doñ la,","poem":2},{"text":"dundam di dundu liggéeykat bu ñu bind?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Daa mel ni jaam bu namm keppaar","poem":1},{"lineBreak":true},{"text":"mbaa mbindaan mu yàkkamtig peyam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noonu laa séddoo ay weeri mititu neen,","poem":1},{"lineBreak":true},{"text":"jagoo ni ay guddiy coono.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Damay tëdd te naa:","poem":1},{"lineBreak":true},{"text":"«Kañ laay jóg nag?»","poem":1},{"lineBreak":true},{"text":"Waaye guddi gudda gudd,","poem":1},{"lineBreak":true},{"text":"walbatiku ba fajar xar génnliku na ma!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maa ngi sàngooy sax ak àkki ban,","poem":1},{"lineBreak":true},{"text":"sama der biy xar, di wal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kukkub ràbb sax","poem":1},{"text":"ni samay fan di jeexee ko gaaw,","poem":2},{"text":"poqe di jeex, te yaakaar amul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Éy Yàlla, bul fàtte ne sama dund gii,","poem":1},{"text":"ag noo doŋŋ la,","poem":2},{"text":"te dootuma teg bët ngëneel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bët bi may gis tey du ma gisati,","poem":1},{"lineBreak":true},{"text":"dinga ma niir, fekk nekkatuma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niir wu naaxsaay, ne mes,","poem":1},{"lineBreak":true},{"text":"mooy ku wàcci njaniiw, du yéegati!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Du ñibbeeti këram,","poem":1},{"lineBreak":true},{"text":"dëkkuwaayam dootu ko fat.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Moo tax duma téye sama làmmiñ,","poem":1},{"lineBreak":true},{"text":"xanaa di waxe biir njàqare,","poem":1},{"lineBreak":true},{"text":"di jooye biir naqar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dama di Géej menn mbaa Ninki-nanka,","poem":1},{"lineBreak":true},{"text":"ba nga di ma booleek ku may wattu?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dama naan: «Naa noppaloo tëraayub laltu,","poem":1},{"lineBreak":true},{"text":"ba yennikoo ab lal sama tawat,»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nga di ma tiitale ay gént,","poem":1},{"lineBreak":true},{"text":"di ma xoqtale ay jeneer,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ba ku ma xojoon sax, ma jël,","poem":1},{"lineBreak":true},{"text":"nde dee a ma gënal dese yii yax.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Doy na sëkk! Dunduma ba fàww;","poem":1},{"lineBreak":true},{"text":"ba ma, samay fan genn noo la!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Luy nit ba nga di ko jox bii gëddë,","poem":1},{"lineBreak":true},{"text":"bay def sam xel ci moom,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"di ko nemmiku saa yoo xëyee,","poem":1},{"lineBreak":true},{"text":"di ko nattu saa su ne?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Doo ma dummóoyu boog,","poem":1},{"lineBreak":true},{"text":"may ma sax fu ma wonaasoo?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yaw miy seetlu jaam ñi,","poem":1},{"text":"ma bàkkaar, lu mu lay wàññi?","poem":2},{"text":"Ana lu tax nga di ma diiral sa bopp nii,","poem":1},{"lineBreak":true},{"text":"ba ma mujj diis la gann?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lu tee kon nga baal ma samag moy,","poem":1},{"lineBreak":true},{"text":"jéggal ma samag tooñ?","poem":1},{"lineBreak":true},{"text":"Léegi tey ma tëri biir suuf,","poem":1},{"lineBreak":true},{"text":"nga di ma seet a seet, fekk nekkatuma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}