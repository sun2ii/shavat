{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOB","translationId":"wol_mbs","name":"Ayóoba","commonName":"Ayóoba","title":"Ayóoba","order":18,"numberOfChapters":42,"sha256":"15134a029e588bffa2fdf36bb8832e0d1075f7e34f608d2dbaeacb844491b957","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/wol_mbs/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Bildàdd nee: Musiba, añu boroom"]},{"type":"verse","number":1,"content":["Bildàdd ma bàyyikoo Suwa, àddu ne:"]},{"type":"verse","number":2,"content":[{"text":"Ana foo àppal sa wax jii?","poem":1},{"lineBreak":true},{"text":"Ngay mbel-mbeli ni callweer!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ana Yàllaak safaan yoon?","poem":1},{"lineBreak":true},{"text":"Ana Aji Man jeek safaan àtteb dëgg?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bu ko sa doom yi moyee, kay,","poem":1},{"lineBreak":true},{"text":"mu ba leen ak seen añub tooñ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaw nag soo sàkkoo Yàlla,","poem":1},{"lineBreak":true},{"text":"dagaan Aji Man ji aw yiwam,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"soo muccee ayib te jub,","poem":1},{"lineBreak":true},{"text":"day daldi taxaw temm ci say mbir,","poem":1},{"lineBreak":true},{"text":"delloo la sa kër gi nga yelloo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nga yokkoo yokku ëllëg,","poem":1},{"lineBreak":true},{"text":"ba xeeb sa démb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Laajal rekk maas gi nu jiitu,","poem":1},{"lineBreak":true},{"text":"te teewlu seen gëstuy maam ya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nun xamunu, démb rekk lanu,","poem":1},{"lineBreak":true},{"text":"sunu fani kaw suuf di takkndeer suy wéy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñi ñu jiitoo lay xamal, wax la,","poem":1},{"lineBreak":true},{"text":"tibbe seen xol yii kàddu, dénk la:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"«Ndax jàqaar dina naate fu dul ban bu tooy,","poem":1},{"lineBreak":true},{"text":"am barax dina saxe fu amul ndox?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bu ndox ma ŋiisee, mooy njëkka lax,","poem":1},{"lineBreak":true},{"text":"te du ñoragum bay mata dog.»","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Loolooy muju képp ku fàtte Yàlla,","poem":1},{"lineBreak":true},{"text":"yaakaaru yéefar, tas rekk,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"cëslaayam màbb,","poem":1},{"lineBreak":true},{"text":"làquwaayam di lëndu jargoñ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mu wéeroo këram, kër gay yëngu;","poem":1},{"lineBreak":true},{"text":"mu ŋoyu ca, muy jaayu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ku gëmadee ngi mel ni garab gu jant biy jam, mu naat;","poem":1},{"lineBreak":true},{"text":"car yay lawe tool ba mu saxe,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"reen ya rawaasoo ci biir jalub xeer,","poem":1},{"lineBreak":true},{"text":"muy kërug dojam gu mu ŋoy.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nga buddee ko béreb ba mu sax,","poem":1},{"lineBreak":true},{"text":"béreb ba jàmbu ko, ne ko: «Masuma laa gis!»","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Geneen garab ay jebbi, wuutu ko.","poem":1},{"lineBreak":true},{"text":"Mu ngoog, ab yéefar, nii la mujam di rafete!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dama ne: Yàlla du gàntal ku màndu,","poem":1},{"lineBreak":true},{"text":"te du dooleel kuy def lu bon.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Moo lay may loo ree,","poem":1},{"lineBreak":true},{"text":"bay sarxolle,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"say bañ gàccoo gàcce,","poem":1},{"lineBreak":true},{"text":"xaymab ñu bon ña gental.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}