{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JOL","translationId":"wol_mbs","name":"Yowel","commonName":"Yowel","title":"Téereb Yonent Yàlla Yowel","order":29,"numberOfChapters":4,"sha256":"418e3df484edacb8571ac5670397125010fdc7632d1ea7f9c53f4b3f44114838","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/wol_mbs/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Ñépp la Aji Sax ji di sotti ag noowam"]},{"type":"verse","number":1,"content":[{"text":"«Gannaaw loolu maay tuur samag noo ci kaw ñépp,","poem":1},{"lineBreak":true},{"text":"seeni doom, góor ak jigéen di biral kàdduy waxyu,","poem":1},{"lineBreak":true},{"text":"seeni màggat di gént ay gént,","poem":1},{"lineBreak":true},{"text":"seeni xale yu góor di gis ay peeñu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kera jant yooyu, jaam yi sax, góor ak jigéen,","poem":1},{"lineBreak":true},{"text":"maa leen di tuur samag noo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maay def ay kiraama fi asamaan ak fi suuf;","poem":1},{"lineBreak":true},{"text":"deret ak sawara ak saxaar su jolli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jant beey soppaliku ag lëndëm,","poem":1},{"lineBreak":true},{"text":"weer wi doon deret,","poem":1},{"lineBreak":true},{"text":"bésub Aji Sax ji doora taxawe màggaay ak daraja!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Su boobaa képp ku woo Aji Sax ji wall ciw turam,","poem":1},{"lineBreak":true},{"text":"dinga raw.","poem":1},{"lineBreak":true},{"text":"Tundu Siyoŋ ak biir Yerusalem kay","poem":1},{"lineBreak":true},{"text":"fa la aw ndes di ame,","poem":1},{"lineBreak":true},{"text":"na ko Aji Sax ji waxe woon,","poem":1},{"lineBreak":true},{"text":"te ñi Aji Sax ji woo ñooy bokk ci ñi dese bakkan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}