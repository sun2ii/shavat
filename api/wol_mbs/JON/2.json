{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"JON","translationId":"wol_mbs","name":"Yunus","commonName":"Yunus","title":"Téereb Yonent Yàlla Yunus","order":32,"numberOfChapters":4,"sha256":"1e9ca3cc25a1e9bc4425304aa69aca60867fbbfc789ebfbe502acd7ea1906c30","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/wol_mbs/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yunus a ngi tinu"]},{"type":"verse","number":1,"content":["Ci kaw loolu Aji Sax ji yebal jën wu mag, mu wann Yunus. Mu nekk ca biiru jën wa ñetti bëccëg ak ñetti guddi."]},{"type":"verse","number":2,"content":["Yunus ñaan ci Yàllaam Aji Sax ji, fa mu tollu ca biir jën wa."]},{"type":"verse","number":3,"content":["Mu ne:",{"text":"Maa jàq, woo Aji Sax ji, mu wuyu ma.","poem":1},{"lineBreak":true},{"text":"Ca xóotey njaniiw laa wootee wall, nga dégg ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaa ma xalab xóotey xolu géej, ndaw ma mëdd ma.","poem":1},{"lineBreak":true},{"text":"Say wal ak say gannax, lépp a jaare sama kaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Man nag ma naan: «Dàqees na ma, ba ma sore la,","poem":1},{"lineBreak":true},{"text":"waaye maay dellu gis sa kër gu sell ga!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndox maa ma tanc ba ci put,","poem":1},{"lineBreak":true},{"text":"xóotey géej mëdd ma,","poem":1},{"lineBreak":true},{"text":"waag ba laxasu sama bopp.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ca reeni tund ya laa suuxi,","poem":1},{"lineBreak":true},{"text":"caabiy suuf féete ma gannaaw ba fàww,","poem":1},{"lineBreak":true},{"text":"waaye ca kan ma nga jukkee sama bakkan,","poem":1},{"lineBreak":true},{"text":"yaw, sama Yàlla Aji Sax ji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Noowal bakkan a nga may rëcc,","poem":1},{"lineBreak":true},{"text":"sama xel ne yarr ci yaw, Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sama ñaan àgg fa yaw,","poem":1},{"lineBreak":true},{"text":"ca sa kër gu sell ga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ñiy wormaal neenug neen daal,","poem":1},{"lineBreak":true},{"text":"ñoo dëddu seen yiw fa Yàlla.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Man nag, ci biir cant laa lay sarxale.","poem":1},{"lineBreak":true},{"text":"Li ma xas laay sottal.","poem":1},{"lineBreak":true},{"text":"Wall, fa Aji Sax ji!","poem":1}]},{"type":"verse","number":11,"content":["Ci kaw loolu Aji Sax ji wax ak jën wa, mu goqi Yunus ca tefes ga."]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}