{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"LAM","translationId":"wol_mbs","name":"Jooytu","commonName":"Jooytu","title":"Kàdduy jooytu","order":25,"numberOfChapters":5,"sha256":"91bcbecad67f5077cc32863acfeafe3d19e0ce906a2ca81be7eea62681434f61","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/wol_mbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ndeysaan! Dëkk beeka wéet tey!","poem":1},{"lineBreak":true},{"text":"Te ñoñam noon gàññ démb.","poem":1},{"lineBreak":true},{"text":"Ndeysaan! Mu ngi mel nib jëtun tey,","poem":1},{"lineBreak":true},{"text":"te noon ràññ fi biir xeet yi!","poem":1},{"lineBreak":true},{"text":"Moo doon lingeeru diiwaan yi,","poem":1},{"lineBreak":true},{"text":"tey, mu sasoo liggéeyu sañul-bañ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Day fanaanee jooy a jooy,","poem":1},{"lineBreak":true},{"text":"rongooñ yay bas-basi,","poem":1},{"lineBreak":true},{"text":"te du kenn ku koy dëfal","poem":1},{"lineBreak":true},{"text":"ci mboolemi soppeem.","poem":1},{"lineBreak":true},{"text":"Xaritoo xarit wor ko,","poem":1},{"lineBreak":true},{"text":"walbatiku diy noonam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngàllo lañu yóbbu Yuda,","poem":1},{"lineBreak":true},{"text":"ci biir naqar ak njaam gu metti.","poem":1},{"lineBreak":true},{"text":"Ci biiri jàmbur lañu dëkk,","poem":1},{"lineBreak":true},{"text":"amuñu fu ñu noppaloo,","poem":1},{"lineBreak":true},{"text":"mboolem ña leen dàq a leen dab,","poem":1},{"lineBreak":true},{"text":"ba tance leen ca ruq ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yoon yi jëm Siyoŋ","poem":1},{"noteId":0},{"text":"jooy na wéet,","poem":1},{"lineBreak":true},{"text":"kenn jaareetu ca màggalsi.","poem":1},{"lineBreak":true},{"text":"Pénc yépp a gental,","poem":1},{"lineBreak":true},{"text":"sarxalkat yay binni,","poem":1},{"lineBreak":true},{"text":"janq ja jàq,","poem":1},{"lineBreak":true},{"text":"Siyoŋ gépp di naqarlu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Seen noon yaa jiite tey,","poem":1},{"lineBreak":true},{"text":"seen bañ yooyoo ne finaax,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee mbugale waa Siyoŋ","poem":1},{"lineBreak":true},{"text":"seeni tooñ yu bare,","poem":1},{"lineBreak":true},{"text":"seeni doom duggig njaam,","poem":1},{"lineBreak":true},{"text":"di moomeelub noon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lu doon sagub Siyoŋ, dëkk bu taaru bi,","poem":1},{"lineBreak":true},{"text":"tey, sàggiku na.","poem":1},{"lineBreak":true},{"text":"Seeni garmee ngi mel ni kéwél","poem":1},{"lineBreak":true},{"text":"yu amul parlu,","poem":1},{"lineBreak":true},{"text":"di koyoŋ-koyoŋiy daw,","poem":1},{"lineBreak":true},{"text":"te rëbb ne leen dann.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tey ci janti toroxte ak tumurànke,","poem":1},{"lineBreak":true},{"text":"la Yerusalem di fàttalikoo","poem":1},{"lineBreak":true},{"text":"mboolem ngëneeli démbam.","poem":1},{"lineBreak":true},{"text":"Aw askanam a tàbbi ci loxol noon,","poem":1},{"lineBreak":true},{"text":"te wall amul,","poem":1},{"lineBreak":true},{"text":"noon ba gis leen,","poem":1},{"lineBreak":true},{"text":"di tex-texi ci seenug yàqule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalem a moy a moy,","poem":1},{"lineBreak":true},{"text":"ba tax koo mujj di sobe;","poem":1},{"lineBreak":true},{"text":"ku ko teraloon, sofental ko,","poem":1},{"lineBreak":true},{"text":"ndax gis ko, mu ne duŋŋ.","poem":1},{"lineBreak":true},{"text":"Moom ci boppam mu ngi binni,","poem":1},{"lineBreak":true},{"text":"fuuylu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sobey Siyoŋ ca pendalam,","poem":1},{"lineBreak":true},{"text":"te bàyyiwul xel ag mujam.","poem":1},{"lineBreak":true},{"text":"Jéllam ba yéeme na,","poem":1},{"lineBreak":true},{"text":"te amul ku ko dëfal.","poem":1},{"lineBreak":true},{"text":"Siyoŋ nee: «Éy Aji Sax ji, xoolal sama njàqare;","poem":1},{"lineBreak":true},{"text":"noon bi déy, am na ndam!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Loxo la noon bi teg ci","poem":1},{"lineBreak":true},{"text":"ngëneeli Siyoŋ gépp.","poem":1},{"lineBreak":true},{"text":"Siyoŋ kay a gis yéefar yi songsi","poem":1},{"lineBreak":true},{"text":"këram gu sell gi,","poem":1},{"lineBreak":true},{"text":"te ci ñoom nga santaane woon, ne","poem":1},{"lineBreak":true},{"text":"buñu dugg sam ndaje","poem":1},{"noteId":1},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waa Siyoŋ gépp a ngi binni,","poem":1},{"lineBreak":true},{"text":"di wut ab dund","poem":1},{"noteId":2},{"text":",","poem":1},{"lineBreak":true},{"text":"seeni ngëneel lañuy weccikoo aw ñam","poem":1},{"lineBreak":true},{"text":"wu ñu leqalikoo.","poem":1},"Yerusalem àddu na",{"text":"Gisal Aji Sax ji, seetal","poem":1},{"lineBreak":true},{"text":"ni ma mujj tekkeedee!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yeen mboolem ñiy jaare yoon wi,","poem":1},{"lineBreak":true},{"text":"lii safu leen,","poem":1},{"lineBreak":true},{"text":"waaye seetleen rekk ba gis","poem":1},{"lineBreak":true},{"text":"ndax wenn mitit dab na","poem":1},{"lineBreak":true},{"text":"mitit wi ñu ma teg,","poem":1},{"lineBreak":true},{"text":"te Aji Sax ji naqarale ma ko","poem":1},{"lineBreak":true},{"text":"ci jantub tàkktel sànjam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Fa kaw la Aji Sax ji sànnee sawara","poem":1},{"lineBreak":true},{"text":"ci sama biiri yax,","poem":1},{"lineBreak":true},{"text":"moo laaw ab caax ngir fakkastal ma,","poem":1},{"lineBreak":true},{"text":"waññi ma, jànnaxe ma,","poem":1},{"lineBreak":true},{"text":"ma dëkke yoggooral.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Samay tooñ la Aji Sax ji ëmb,","poem":1},{"lineBreak":true},{"text":"fastee ko loxoom,","poem":1},{"lineBreak":true},{"text":"mu tege sama kaw ndodd,","poem":1},{"lineBreak":true},{"text":"ba jeexal sama doole.","poem":1},{"lineBreak":true},{"text":"Boroom bee ma tàbbal","poem":1},{"lineBreak":true},{"text":"ci loxo yu ma manula të.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ku doon jàmbaar fi sama biir,","poem":1},{"lineBreak":true},{"text":"la Boroom bi xalab.","poem":1},{"lineBreak":true},{"text":"Am ndaje la ma wooteel,","poem":1},{"lineBreak":true},{"text":"ngir falaxe sama ndaw yu góor.","poem":1},{"lineBreak":true},{"text":"Boroom bee dëggaate Yuda, janq ju taaru ji,","poem":1},{"lineBreak":true},{"text":"ni reseñ ci biir nalukaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Looloo ma tax di jooy,","poem":1},{"lineBreak":true},{"text":"rongooñ di wal-wali,","poem":1},{"lineBreak":true},{"text":"te ku may dëfal sore ma,","poem":1},{"lineBreak":true},{"text":"mook kuy seral sama xol.","poem":1},{"lineBreak":true},{"text":"Samay doom a ngi jaaxle,","poem":1},{"lineBreak":true},{"text":"nde noon bi daan na.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Siyoŋ tàllal na loxoom,","poem":1},{"lineBreak":true},{"text":"waaye amul ku ko dëfal.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee wool askanu Yanqóoba","poem":1},{"lineBreak":true},{"text":"seeni noon yi leen wër,","poem":1},{"lineBreak":true},{"text":"ba Yerusalem mujj di sobe fi seen biir.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"Aji Sax ji moo yey,","poem":1},{"lineBreak":true},{"text":"kàddoom laa gàntal.","poem":1},{"lineBreak":true},{"text":"Yeen, xeetoo xeet, ngalla dégluleen","poem":1},{"lineBreak":true},{"text":"te xool samaw tiis.","poem":1},{"lineBreak":true},{"text":"Samay ndaw yu góor ak yu jigéen,","poem":1},{"lineBreak":true},{"text":"ñoo duggi ngàllo!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Samay soppe laa woo wall,","poem":1},{"lineBreak":true},{"text":"ñoom ñu wor ma.","poem":1},{"lineBreak":true},{"text":"Samay sarxalkat ak samay mag di wuti ab dund","poem":1},{"lineBreak":true},{"text":"bu ñu leqalikoo,","poem":1},{"lineBreak":true},{"text":"far faatu ci biir dëkk bi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Éy Aji Sax ji, xoolal sama njàqare,","poem":1},{"lineBreak":true},{"text":"samay butit di fuddu,","poem":1},{"lineBreak":true},{"text":"sama biir xol salfaañoo ndaxu tiis.","poem":1},{"lineBreak":true},{"text":"Man de maa gàntal ba gàntaaral,","poem":1},{"lineBreak":true},{"text":"ba fa biti, saamar di fa bóome,","poem":1},{"lineBreak":true},{"text":"te biir kër it di dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dégg nañu may binni,","poem":1},{"lineBreak":true},{"text":"te awma ku ma dëfal.","poem":1},{"lineBreak":true},{"text":"Noon yépp a dégg samaw ay","poem":1},{"lineBreak":true},{"text":"te di ko bége, nde yaa ko def.","poem":1},{"lineBreak":true},{"text":"Ngalla indil bés bi nga dige,","poem":1},{"lineBreak":true},{"text":"ba ñu daj li ma daj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yal na seen gépp mbon teew fi sa kanam,","poem":1},{"lineBreak":true},{"text":"ba nga mbugal leen","poem":1},{"lineBreak":true},{"text":"ni nga ma mbugale","poem":1},{"lineBreak":true},{"text":"ndax mboolem samay tooñ.","poem":1},{"lineBreak":true},{"text":"Samay onk bare na,","poem":1},{"lineBreak":true},{"text":"sama xol jeex tàkk.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.4 Siyoŋ mooy Yerusalem itam.","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"1.10 Seetal ci Baamtug yoon wi  23.4.","reference":{"chapter":1,"verse":10}},{"noteId":2,"caller":"+","text":"1.11 wut ab dund: li leen xañ ab dund mooy gaw bu yàgg bu ñu leen gaw, ba ñu mujj xiif lool. Seetal ci 2.Buur ya 25.1-3.","reference":{"chapter":1,"verse":11}}]},"thisChapterLink":"/api/wol_mbs/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}