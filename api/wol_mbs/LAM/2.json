{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"LAM","translationId":"wol_mbs","name":"Jooytu","commonName":"Jooytu","title":"Kàdduy jooytu","order":25,"numberOfChapters":5,"sha256":"91bcbecad67f5077cc32863acfeafe3d19e0ce906a2ca81be7eea62681434f61","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/wol_mbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndeysaan Boroom bee mer ba xiinal Siyoŋ,","poem":1},{"lineBreak":true},{"text":"dëkk bu taaru bi.","poem":1},{"lineBreak":true},{"text":"Fa asamaan la rattaxe sagu Israayil fa suuf.","poem":1},{"lineBreak":true},{"text":"Keroog bésu meram ma, bàyyiwul xel,","poem":1},{"lineBreak":true},{"text":"ne këram googoo di ndëggastalam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Boroom bee modd te yërëmul","poem":1},{"lineBreak":true},{"text":"mboolem sanci Yanqóoba.","poem":1},{"lineBreak":true},{"text":"Ca meram ma la màbbe","poem":1},{"lineBreak":true},{"text":"tatay Yuda réew mu taaru ma.","poem":1},{"lineBreak":true},{"text":"Moo detteel nguur ga aki garmeem,","poem":1},{"lineBreak":true},{"text":"sobeel leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tàngooru sànjam la daane","poem":1},{"lineBreak":true},{"text":"gépp kàttanu Israayil.","poem":1},{"lineBreak":true},{"text":"Fa kanam noon ba la roccee","poem":1},{"lineBreak":true},{"text":"dooley ndijooram.","poem":1},{"lineBreak":true},{"text":"Moo tàkkal Yanqóoba","poem":1},{"lineBreak":true},{"text":"ni sawara wuy sël-sëli,","poem":1},{"lineBreak":true},{"text":"ba xoyom mboolem la ko wër.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Boroom bee tàwwi ag fittam","poem":1},{"lineBreak":true},{"text":"mel ni ab noon,","poem":1},{"lineBreak":true},{"text":"moo diire ndijooram, mel ni bañ,","poem":1},{"lineBreak":true},{"text":"moo bóom mboolem lu neexa xool.","poem":1},{"lineBreak":true},{"text":"Ci biir xaymab Siyoŋ dëkk bu taaru ba","poem":1},{"lineBreak":true},{"text":"la yuri am sànjam ni sawara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Boroom bee mel nib noon,","poem":1},{"lineBreak":true},{"text":"modd Israayil,","poem":1},{"lineBreak":true},{"text":"moddaale këram yu taaru yépp,","poem":1},{"lineBreak":true},{"text":"tas ay tataam,","poem":1},{"lineBreak":true},{"text":"ba fulal Yuda mu taaru ma,","poem":1},{"lineBreak":true},{"text":"ay yuux aki jooy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moo tas mbaaram ni bu doon mbaarum tool,","poem":1},{"lineBreak":true},{"text":"moo rajaxe bérebu ndajeem.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji moo fàtteloo waa Siyoŋ","poem":1},{"lineBreak":true},{"text":"màggal ak bésub Noflaay,","poem":1},{"lineBreak":true},{"text":"te tàngooru meram la xalabe buur ak sarxalkat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aji Sax jee jañax sarxalukaayam,","poem":1},{"lineBreak":true},{"text":"gedd.","poem":1},{"lineBreak":true},{"text":"Moo teg ci loxol noon tatay këram yi.","poem":1},{"lineBreak":true},{"text":"Biir kër Aji Sax ji la baat xaacoo,","poem":1},{"lineBreak":true},{"text":"ni bu doon bésu màggal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aji Sax jee dogoo rajaxe","poem":1},{"lineBreak":true},{"text":"tatam Siyoŋ mu taaru ma.","poem":1},{"lineBreak":true},{"text":"Moo tàllal buumu nattukaay, ngir tas ko,","poem":1},{"lineBreak":true},{"text":"bankul loxoom it te màbbu ko.","poem":1},{"lineBreak":true},{"text":"Moo jooyloo tata ak tabaxub fegukaay,","poem":1},{"lineBreak":true},{"text":"ñu ànd tojatoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bunti dëkk ba suulu na,","poem":1},{"lineBreak":true},{"text":"te moo yàqate, dammate weñi tëjukaay ya.","poem":1},{"lineBreak":true},{"text":"Buuram aki garmeem a tumurànkeji","poem":1},{"lineBreak":true},{"text":"ca yéefar ya,","poem":1},{"lineBreak":true},{"text":"te téereb yoon amul,","poem":1},{"lineBreak":true},{"text":"yonent it gisatul peeñu","poem":1},{"lineBreak":true},{"text":"mu bawoo fa Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Magi Siyoŋ dëkk bu taaru ba ña nga toog, xeremlu,","poem":1},{"lineBreak":true},{"text":"xëppoo suuf, sol ay saaku, di ñaawlu.","poem":1},{"lineBreak":true},{"text":"Janqi Yerusalem sëgg, seen bopp jëm suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Samay gët a giim ndaxi rongooñ,","poem":1},{"lineBreak":true},{"text":"samay butit fuddu,","poem":1},{"lineBreak":true},{"text":"xol ŋiis, jeex tàkk:","poem":1},{"lineBreak":true},{"text":"ci tasteg samaw askan;","poem":1},{"lineBreak":true},{"text":"xale yeek gone yiy nàmp","poem":1},{"lineBreak":true},{"text":"ne lasar fi mbedd yi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Seen yaay lañu naan:","poem":1},{"lineBreak":true},{"text":"«Ana fu nuy lekke, ba naan?»","poem":1},{"lineBreak":true},{"text":"te ne lasiim ci mbeddi dëkk bi,","poem":1},{"lineBreak":true},{"text":"ni ñu gaañoo xare,","poem":1},{"lineBreak":true},{"text":"bakkan di tàggoo fa ñu uufoo","poem":1},{"lineBreak":true},{"text":"ca weenu yaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaw Yerusalem, dëkk bu taaru bi,","poem":1},{"lineBreak":true},{"text":"lu ma lay wax? Ku ma lay méngaleel?","poem":1},{"lineBreak":true},{"text":"Siyoŋ, janq ju taaru ji laa ne,","poem":1},{"lineBreak":true},{"text":"ana ku ma lay dendaleel, ba seral sa xol?","poem":1},{"lineBreak":true},{"text":"Yaw mi sab góom yaa ni géej,","poem":1},{"lineBreak":true},{"text":"ana ku lay faj?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ag neen aki caaxaan","poem":1},{"lineBreak":true},{"text":"la la say yonent gisal,","poem":1},{"lineBreak":true},{"text":"te biraluñu sag ñaawtéef,","poem":1},{"lineBreak":true},{"text":"ngir tijji sa wërsëg,","poem":1},{"lineBreak":true},{"text":"xanaa di la yéeneel waxyuy caaxaan aki nax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mboolem ñi fi jaareey tacc-taccali loxo,","poem":1},{"lineBreak":true},{"text":"ciipu, wëcc bopp ci gentub Yerusalem mu taaru ma,","poem":1},{"lineBreak":true},{"text":"te naan: «Xanaa du biib dëkk lañu doon tudd","poem":1},{"lineBreak":true},{"text":"“Taar bu sotti,”","poem":1},{"lineBreak":true},{"text":"te muy mbégtem àddina sépp?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sa noon yépp a lay ñaawal,","poem":1},{"lineBreak":true},{"text":"di la kókkaleeka kekku,","poem":1},{"lineBreak":true},{"text":"te naan: «Sànk nanu leen nag!","poem":1},{"lineBreak":true},{"text":"Bii bés lanu yàggoona séentu,","poem":1},{"lineBreak":true},{"text":"te noo ko fekke tey.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Aji Sax jee def la mu nammoon,","poem":1},{"lineBreak":true},{"text":"moo sottal kàddoom","poem":1},{"lineBreak":true},{"text":"ga mu santaane woon janti démb.","poem":1},{"lineBreak":true},{"text":"Moo faat te yërëmul,","poem":1},{"lineBreak":true},{"text":"ba may noon bége leen,","poem":1},{"lineBreak":true},{"text":"te moo kaweel sa kàttanu bañ yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Askan waa ngi jooy jooyi xol","poem":1},{"lineBreak":true},{"text":"fi kanam Boroom bi.","poem":1},{"lineBreak":true},{"text":"Éy yaw tatay Siyoŋ, dëkk bu taaru bi,","poem":1},{"lineBreak":true},{"text":"sottil say rongooñ ni walum dex guddeek bëccëg;","poem":1},{"lineBreak":true},{"text":"bul noppalu, bul feral say rongooñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jógal guddi, xaacu:","poem":1},{"lineBreak":true},{"text":"ndoortel wattub guddi, ngay yuri sab xol","poem":1},{"lineBreak":true},{"text":"nim ndox, jàkkaarlook Boroom bi.","poem":1},{"lineBreak":true},{"text":"Tàllal koy loxo, ngir sa bakkani doom","poem":1},{"lineBreak":true},{"text":"yi xiif tax ne lasiim fi boppu mbeddoo mbedd.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Éy Aji Sax ji, xoolal, seetal rekk","poem":1},{"lineBreak":true},{"text":"ki nga def nii!","poem":1},{"lineBreak":true},{"text":"Xanaa du ndey mooy dem ba yàpp doomu boppam,","poem":1},{"lineBreak":true},{"text":"doom ju mu sukk jur, di ko toppatoo?","poem":1},{"lineBreak":true},{"text":"Xanaa du sarxalkat akub yonent lañuy bóom","poem":1},{"lineBreak":true},{"text":"fi kër gu sell gi ñeel Aji Sax ji?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mag ak ndaw a ngi ne lareet fi suuf ci mbedd yi;","poem":1},{"lineBreak":true},{"text":"sama janq jeek sama xale yu góor yi tëdd,","poem":1},{"lineBreak":true},{"text":"saamar faat leen.","poem":1},{"lineBreak":true},{"text":"Yaa rey ci sa bésub mer,","poem":1},{"lineBreak":true},{"text":"yaa rendi te yërëmoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaa woote ni su doon bésu màggal,","poem":1},{"lineBreak":true},{"text":"tiitaange dar kepp ma.","poem":1},{"lineBreak":true},{"text":"Bésub merum Aji Sax ji, kenn rëccul,","poem":1},{"lineBreak":true},{"text":"kenn muccul.","poem":1},{"lineBreak":true},{"text":"Doom yi ma jur, yar leen,","poem":1},{"lineBreak":true},{"text":"noon bi rey leen!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}