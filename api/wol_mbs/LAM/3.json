{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"LAM","translationId":"wol_mbs","name":"Jooytu","commonName":"Jooytu","title":"Kàdduy jooytu","order":25,"numberOfChapters":5,"sha256":"91bcbecad67f5077cc32863acfeafe3d19e0ce906a2ca81be7eea62681434f61","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/wol_mbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Man maay nit ki gisu naqar,","poem":1},{"lineBreak":true},{"text":"naqar wu ko yarub sànjum Aji Sax ji teg.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Man la jañax, te lëndëm la ma doxloo,","poem":1},{"lineBreak":true},{"text":"dug leer.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Man doŋŋ lay yen aka yenaat loxoom,","poem":1},{"lineBreak":true},{"text":"bésoo bés.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Moo ràppal sama der ak samaw suux,","poem":1},{"lineBreak":true},{"text":"tas samay yax.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moo tabax fi sama kaw, tanc ma,","poem":1},{"lineBreak":true},{"text":"gawe ma tooke ak coono.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Béreb yu lëndëm la ma dëël,","poem":1},{"lineBreak":true},{"text":"ni ña dee bu yàgg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Moo ma ñag ba manumaa bëtt,","poem":1},{"lineBreak":true},{"text":"te jéng yu diis la ma jénge.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Su ma yuuxoo, woote wall it,","poem":1},{"lineBreak":true},{"text":"mu tanqamlu samag ñaan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ay doji yatt la ñage samay yoon,","poem":1},{"lineBreak":true},{"text":"te moo lajjal samay ñall.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Moo di rab wu aay wu may tëru,","poem":1},{"lineBreak":true},{"text":"di gaynde gu waafe làquwaayam.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Samaw yoon la ma wàcce, xotat ma,","poem":1},{"lineBreak":true},{"text":"tumurànkeel ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moo ma bankal xalaam,","poem":1},{"lineBreak":true},{"text":"diire mag fittam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sama xóotey xol la soqil ay fittam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Maa mujj di reetaanukaayu bokk yépp,","poem":1},{"lineBreak":true},{"text":"di seen woyu bés bu nekk.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moo ma reggal wextan,","poem":1},{"lineBreak":true},{"text":"màndal ma lu mel ni xay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yéyloo na may doj,","poem":1},{"lineBreak":true},{"text":"dëggaate ma ci pënd bi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jàmmi xol a ma réer,","poem":1},{"lineBreak":true},{"text":"ma fàtte sax luy mbégte.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ca laa ne sama muñukaay a jeex","poem":1},{"lineBreak":true},{"text":"ak it sama yaakaar ci Aji Sax ji!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bàyyil xel sama naqar ak sama tumurànke,","poem":1},{"lineBreak":true},{"text":"mbete wextan akug tooke!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dama ciy xalaat aka xalaataat,","poem":1},{"lineBreak":true},{"text":"sama xol jeex tàkk!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Waaye li may dëkke bàyyi xel,","poem":1},{"lineBreak":true},{"text":"ba dese yaakaar mooy lii:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aji Sax ji, ngoram du dakk,","poem":1},{"lineBreak":true},{"text":"te yërmandeem du jeex.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xanaa di yeeslu jant bu nekk.","poem":1},{"lineBreak":true},{"text":"Kee bare kóllëre!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"«Samab séddoo, Aji Sax jee,»","poem":1},{"lineBreak":true},{"text":"la sama xol wax,","poem":1},{"lineBreak":true},{"text":"te moo tax ma di ko xaar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Aji Sax jee baax ci ñi ko yaakaar,","poem":1},{"lineBreak":true},{"text":"baax ci ki ko wóolu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Li baax mooy muñ,","poem":1},{"lineBreak":true},{"text":"xeremluy xaar wallub Aji Sax ji.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Li baax ci nit mooy","poem":1},{"lineBreak":true},{"text":"nga nangoo muñ ba ngay ndaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bu la Aji Sax ji tegee nattu,","poem":1},{"lineBreak":true},{"text":"berul te muñ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dëppal sa jë ci suuf,","poem":1},{"lineBreak":true},{"text":"jombul yaakaar am.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dékkalub lex ku lay mbej,","poem":1},{"lineBreak":true},{"text":"di la tifaare ay saaga, ba nga tooy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Boroom bi déy","poem":1},{"lineBreak":true},{"text":"du la wacc ba fàww.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bu la tegee naqar it, yërëm la,","poem":1},{"lineBreak":true},{"text":"ngoram a ni baree.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Du bànneexam lay tege coono,","poem":1},{"lineBreak":true},{"text":"aka naqaral doom aadama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Bu ñuy dëggaate","poem":1},{"lineBreak":true},{"text":"mboolem ñi ñu tëj cim réew,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"di jalgati yelleefu nit","poem":1},{"lineBreak":true},{"text":"fi kanam Aji Kawe ji,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"di been dëgg cib layoom,","poem":1},{"lineBreak":true},{"text":"xanaa Boroom bi da ko dul gis?","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ana ku wax, mu am,","poem":1},{"lineBreak":true},{"text":"te Boroom bi dogalu ko?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Muy lu baax, di lu aay,","poem":1},{"lineBreak":true},{"text":"xanaa du Aji Kawe jeey àddu, amal?","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Kuy dund, ana loo deeti jàmbat,","poem":1},{"lineBreak":true},{"text":"bu ñu la añalee sa bàkkaar?","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Nan càmbar, ba xoolaat jikko yi","poem":1},{"lineBreak":true},{"text":"te dellu ci Aji Sax ji.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Nan tàllal sunu xol ak sunuy loxo","poem":1},{"lineBreak":true},{"text":"Yàlla ja fa asamaan,","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"noo tooñ, noo fippu,","poem":1},{"lineBreak":true},{"text":"ba tax yaw jéggalewoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Sam sànj nga làmboo, topp nu,","poem":1},{"lineBreak":true},{"text":"di rey te ñéebluwoo,","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"aw niir nga sàngoo,","poem":1},{"lineBreak":true},{"text":"ba ag ñaan du ko jàll.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Mbuubitum sën nga nu def","poem":1},{"lineBreak":true},{"text":"fi biir xeet yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Sunu noon yépp a nuy waxal,","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"tiitaange ak pax dikkal na nu,","poem":1},{"lineBreak":true},{"text":"ak yàquteek sànkute.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Saay gët a ngi wal","poem":1},{"lineBreak":true},{"text":"ndax sama askan wi rajaxoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Saay gët a ngi rogalaat,","poem":1},{"lineBreak":true},{"text":"du fer, du ŋiis,","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"ba keroog Aji Sax ji séentoo asamaan, ba gis.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Bi ma gisee li dal jigéeni dëkk bi yépp,","poem":1},{"lineBreak":true},{"text":"la sama xol jeex.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Ñi ma bañ ci dara","poem":1},{"lineBreak":true},{"text":"ñoo ma këpptal a këpptal ni picc.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Cib teen lañu ma tàbbal,","poem":1},{"lineBreak":true},{"text":"ube kow doj, te may dund,","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"ndox ma mëdd ma,","poem":1},{"lineBreak":true},{"text":"ma ne: «Sànku naa.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Aji Sax ji, fa xóotey pax ma","poem":1},{"lineBreak":true},{"text":"laa la woowe.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Sama baat nga dégg, ma ne la:","poem":1},{"lineBreak":true},{"text":"«Bul fattal sab nopp","poem":1},{"lineBreak":true},{"text":"samay onk ak samay yuux.»","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Bés ba ma la woowee nga dikk,","poem":1},{"lineBreak":true},{"text":"ne ma: «Bul tiit.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Boroom bi, yaa sàmm sama àq,","poem":1},{"lineBreak":true},{"text":"yaa jot sama bakkan.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaa gis ni ñu ma tooñe,","poem":1},{"lineBreak":true},{"text":"jox ma sama àtte.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"Yaa gis seen mboolem mébétu feyu,","poem":1},{"lineBreak":true},{"text":"seen mboolem pexe yi ñu may lalal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Aji Sax ji, yaa dégg seeni kókkalee,","poem":1},{"lineBreak":true},{"text":"ak mboolem pexe yi ñu may lalal.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Ci man la noon yiy diisoo aka déeyoo,","poem":1},{"lineBreak":true},{"text":"bés bu nekk.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"Xoolal, bu ñu toogee ak bu ñu jógee,","poem":1},{"lineBreak":true},{"text":"man lañuy léeboo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Aji Sax ji, jox leen seenub añ,","poem":1},{"lineBreak":true},{"text":"seen kemu liggéeyu loxo.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"Dërkiisalal seen xol,","poem":1},{"lineBreak":true},{"text":"na leen sag alkànde ñeel.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Toppe leen sa mer, te nga sànke leen","poem":1},{"lineBreak":true},{"text":"mboolem fu asamaanu Aji Sax ji tiim.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}