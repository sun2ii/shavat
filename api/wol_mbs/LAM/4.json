{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"LAM","translationId":"wol_mbs","name":"Jooytu","commonName":"Jooytu","title":"Kàdduy jooytu","order":25,"numberOfChapters":5,"sha256":"91bcbecad67f5077cc32863acfeafe3d19e0ce906a2ca81be7eea62681434f61","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/wol_mbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ndeysaan, wurus wa giim na!","poem":1},{"lineBreak":true},{"text":"Ngëneelu wurus soppiku na.","poem":1},{"lineBreak":true},{"text":"Doj yu sell yaa wasaaroo,","poem":1},{"lineBreak":true},{"text":"ca boppu mbedd yépp.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Doomi Siyoŋ yu góor yu jar ya!","poem":1},{"lineBreak":true},{"text":"Wurus lees leen daan nàttablee,","poem":1},{"lineBreak":true},{"text":"ndeysaan tey, ñu jàppe leen ni njaqu ban","poem":1},{"lineBreak":true},{"text":"lu tabaxkatu njaq liggéeye loxoom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ag till sax joxe na weenam,","poem":1},{"lineBreak":true},{"text":"nàmpal doomam,","poem":1},{"lineBreak":true},{"text":"te sama bokk yi mujj néeg","poem":1},{"lineBreak":true},{"text":"ba mel ni bànjóolig màndiŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Luy nàmp a nga mar a mar,","poem":1},{"lineBreak":true},{"text":"ba làmmiñ taqoo denqleñ.","poem":1},{"lineBreak":true},{"text":"Gone yaa ngi ñaan mburu,","poem":1},{"lineBreak":true},{"text":"te kenn daggalu leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ñi daan xéewloo ay bernde,","poem":1},{"lineBreak":true},{"text":"tey ñoo xiif, ne lasar ca mbedd ya.","poem":1},{"lineBreak":true},{"text":"Ña yaroo woon yérey tànnéef,","poem":1},{"lineBreak":true},{"text":"tey ñoo goore jalu mbuubit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sama ñaawtéefu askan wee màgg,","poem":1},{"lineBreak":true},{"text":"ba raw ñaawtéefu waa Sodom,","poem":1},{"lineBreak":true},{"text":"dëkk ba jekki jàllarbiku,","poem":1},{"lineBreak":true},{"text":"te loxo laalu ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sunu kàngam ya setoon wecc,","poem":1},{"lineBreak":true},{"text":"seen yaram mucc gàkk,","poem":1},{"lineBreak":true},{"text":"di lerxat bay tàkk,","poem":1},{"lineBreak":true},{"text":"wér péŋŋ, leer nàññ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tey ñu gëna lëndëm bànqanoos,","poem":1},{"lineBreak":true},{"text":"xàmmeesu leen ci mbedd yi,","poem":1},{"lineBreak":true},{"text":"ñu ngi lax, di yaxi neen,","poem":1},{"lineBreak":true},{"text":"der wow koŋŋ ni matt!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ña saamar rey a gënu demin","poem":1},{"lineBreak":true},{"text":"ña deek xiif,","poem":1},{"lineBreak":true},{"text":"jeex tàkk, ne lasar,","poem":1},{"lineBreak":true},{"text":"ndax ñàkk meññatum tool.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndey ak xolu njureelam,","poem":1},{"lineBreak":true},{"text":"moo togge loxoom doomu boppam,","poem":1},{"lineBreak":true},{"text":"def ko njëlam,","poem":1},{"lineBreak":true},{"text":"ci sama biir toskareg askan wi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Aji Sax jee xëpp am sànjam,","poem":1},{"lineBreak":true},{"text":"sotti tàngooru meram,","poem":1},{"lineBreak":true},{"text":"moo jafal sawara fi Siyoŋ,","poem":1},{"lineBreak":true},{"text":"ba xoyom kenu ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Du benn buur fi kaw suuf bu gëmoon,","poem":1},{"lineBreak":true},{"text":"du kenn ci mboolem waa àddina","poem":1},{"lineBreak":true},{"text":"kuy foog ne ab bañ mbaa noon dina dem","poem":1},{"lineBreak":true},{"text":"ba bëtt bunti Yerusalem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Seen bàkkaari yonent yaa,","poem":1},{"lineBreak":true},{"text":"seen ñaawtéefi sarxalkat yaa;","poem":1},{"lineBreak":true},{"text":"ñoo tuur fa digg dëkk ba","poem":1},{"lineBreak":true},{"text":"deretu aji jub ñi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ña ngay tëñëx-tëñëxi","poem":1},{"lineBreak":true},{"text":"niy gumba ci mbedd yi,","poem":1},{"lineBreak":true},{"text":"deret ja sobeel leen","poem":1},{"lineBreak":true},{"text":"ba maneesula laal seeni yére.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ñoom lañuy gëdd naan:","poem":1},{"lineBreak":true},{"text":"«Soreleen nu, nit ñu sobewu ñi!","poem":1},{"lineBreak":true},{"text":"Soreleen, soreleen, buleen nu laal.»","poem":1},{"lineBreak":true},{"text":"Ñu daw di tambaambalu ba ca yeneen xeet;","poem":1},{"lineBreak":true},{"text":"ñooña ne leen: «Dootul fii!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aji Sax ji ci boppam moo leen tasaare,","poem":1},{"lineBreak":true},{"text":"faaleetu leen;","poem":1},{"lineBreak":true},{"text":"cér lees séddul sarxalkat,","poem":1},{"lineBreak":true},{"text":"te teraleesul mag.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Ba tey sunu gët a ngi giim,","poem":1},{"lineBreak":true},{"text":"ndax ndimbal lu nuy séentu ci dara.","poem":1},{"lineBreak":true},{"text":"Fa sunuy tata lanu séentoo wenn xeet","poem":1},{"lineBreak":true},{"text":"wu nu manula wallu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sunuy tànk lees di topp,","poem":1},{"lineBreak":true},{"text":"ba manatunoo daagoo sunuy mbedd;","poem":1},{"lineBreak":true},{"text":"sunu bés jege,","poem":1},{"lineBreak":true},{"text":"sunu àpp di matal,","poem":1},{"lineBreak":true},{"text":"sunu saa taxaw!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ñi ñuy dàq a gëna gaaw ay jaxaay,","poem":1},{"lineBreak":true},{"text":"ci kaw tund yi lañu nu ne dann,","poem":1},{"lineBreak":true},{"text":"màndiŋ mi, ñu di nu fa tëroo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ki nuy noyyee, Buur bi Aji Sax ji fal,","poem":1},{"lineBreak":true},{"text":"ca seeni yeer la tance,","poem":1},{"lineBreak":true},{"text":"te nu noon ci keppaaram","poem":1},{"lineBreak":true},{"text":"lanuy dëkke fi digg xeet yi.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Bégleen te bànneexooy,","poem":1},{"lineBreak":true},{"text":"Edom réew mu taaru mi, yeen Edomeen","poem":1},{"noteId":3},{"text":"ñi dëkk réewum Ucc,","poem":1},{"lineBreak":true},{"text":"ci yeen it la kaasu mbugal di jàllsi,","poem":1},{"lineBreak":true},{"text":"ngeen màndi, futteeku, ne duŋŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaw Siyoŋ, dëkk bu taaru ba, sa mbugal mat na,","poem":1},{"lineBreak":true},{"text":"deesatu la yóbbu ngàllo;","poem":1},{"lineBreak":true},{"text":"yaw Edom laa ne,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee lay fey sa ñaawtéef,","poem":1},{"lineBreak":true},{"text":"feeñal say bàkkaar.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"4.21 Edomeen ñaa nga bàyyikoo fa bëj-saalumu Yuda jàpp penku. Ñu ngi soqikoo ci Esawu, magu Yanqóoba, kon bokki Israayil lañu woon, waaye dañoo faroon ak nooni Israayil.","reference":{"chapter":4,"verse":21}}]},"thisChapterLink":"/api/wol_mbs/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}