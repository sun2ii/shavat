{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"LAM","translationId":"wol_mbs","name":"Jooytu","commonName":"Jooytu","title":"Kàdduy jooytu","order":25,"numberOfChapters":5,"sha256":"91bcbecad67f5077cc32863acfeafe3d19e0ce906a2ca81be7eea62681434f61","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/wol_mbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Éy Aji Sax ji, bàyyil xel li nu dal,","poem":1},{"lineBreak":true},{"text":"xoolal, gisal sunu toroxte!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sunu suuf toxu ciy jàmbur,","poem":1},{"lineBreak":true},{"text":"sunuy kër ñeel ay doxandéem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baay dëddu, nu diy jirim;","poem":1},{"lineBreak":true},{"text":"ndey dib jëtun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sunum ndox, xaalis lanu koy feye, naan,","poem":1},{"lineBreak":true},{"text":"sunu matt ak njëgam la mu nuy dikke.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sunuw loos lañu ràng,","poem":1},{"lineBreak":true},{"text":"nu loof, te noppaleesu nu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nu nangul Misra,","poem":1},{"lineBreak":true},{"text":"nangul Asiri ngir ab dund.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sunuy maam a moyoon, nekkatuñu tey;","poem":1},{"lineBreak":true},{"text":"nun, noo gàddu seeni mbugal.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ay surgaa nu yilif, te amunu","poem":1},{"lineBreak":true},{"text":"ku nu wallu ci seeni loxo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bu nu lekkee, sunu bakkan lanu jaay,","poem":1},{"lineBreak":true},{"text":"nde saamar a ngi ci màndiŋ mi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sunu yaram nib taal la tànge","poem":1},{"lineBreak":true},{"text":"ndax tàngoorub xiif.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jigéeni Siyoŋ lañuy tëdde,","poem":1},{"lineBreak":true},{"text":"ak janqi dëkki Yuda.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kàngam yi, ñu jàpp, wékk;","poem":1},{"lineBreak":true},{"text":"te mag ñi, teraleesu leen.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waxambaane yee yenu doji wolukaay,","poem":1},{"lineBreak":true},{"text":"gone yu góor yi sëfoo sayi matt, di tërëf.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mag dakkal na jataayu pénc,","poem":1},{"lineBreak":true},{"text":"te waxambaane talatula xalam.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xol nux-nuxeetul,","poem":1},{"lineBreak":true},{"text":"te ay rongooñ a wuutuy pooj.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sunu mbaxana foq na!","poem":1},{"lineBreak":true},{"text":"Wóoy ngalla nun ñi moy!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lee jeexal sunu xol,","poem":1},{"lineBreak":true},{"text":"lii moo nu jooyloo, ba gët giim:","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"tundu Siyoŋ wi gental,","poem":1},{"lineBreak":true},{"text":"ba till yi di fi daagoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yaw Aji Sax ji, yaay toog ba fàww,","poem":1},{"lineBreak":true},{"text":"sab jal, sët ba sëtaat.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ana lu waral nga fàtte nu fàww,","poem":1},{"lineBreak":true},{"text":"bàyyi nu diir bu yàgge nii?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, delloosi nu fi yaw, nu dellusi,","poem":1},{"lineBreak":true},{"text":"yeesalal sunuy jant, mu mel na woon.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Xanaa doo nu wacc a wacc,","poem":1},{"lineBreak":true},{"text":"mere nu mer mu amul kemu?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}