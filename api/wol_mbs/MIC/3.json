{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"MIC","translationId":"wol_mbs","name":"Mise","commonName":"Mise","title":"Téereb Yonent Yàlla Mise","order":33,"numberOfChapters":7,"sha256":"7bc8fb1a4f6f8e80b4f7b3588db2736ea708a742ef6e977476a4150ede33f4cf","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/wol_mbs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Aji Sax ji tiiñal na njiiti Israayil"]},{"type":"verse","number":1,"content":[{"text":"Dama ne:","poem":1},{"lineBreak":true},{"text":"«Ngalla dégluleen yeen njiiti Yanqóoba,","poem":1},{"lineBreak":true},{"text":"yeen kilifay kër Israayil!","poem":1},{"lineBreak":true},{"text":"Xanaa du yeena wara xam yoon?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Te yeenay bañ-kati lu baax,","poem":1},{"lineBreak":true},{"text":"di bëggkati lu bon.","poem":1},{"lineBreak":true},{"text":"Yeenay fees sama ñoñ te ñuy dund,","poem":1},{"lineBreak":true},{"text":"yeenay rocci suux wi sàng seeni yax.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yeenay yàpp samay bokk,","poem":1},{"lineBreak":true},{"text":"fulli seen der,","poem":1},{"lineBreak":true},{"text":"damm seeni yax, dogat,","poem":1},{"lineBreak":true},{"text":"def ko ni toggug kawdir,","poem":1},{"lineBreak":true},{"text":"mel ni ndawal ci cin.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lee tax noggatukat yii di woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"te du leen wuyu,","poem":1},{"lineBreak":true},{"text":"kanamam la leen di làq, bésub keroog,","poem":1},{"lineBreak":true},{"text":"ndax ñoo bonal seeni jëf.","poem":1}]},{"type":"heading","content":["Aji Sax ji artu na yonent yu bëgge yi"]},{"type":"verse","number":5,"content":[{"text":"Lii la Aji Sax ji wax ci yonent yiy lajjal samay bokk:","poem":1},{"lineBreak":true},{"text":"«Bu ñu sàqamee ab lanc, yéene jàmm;","poem":1},{"lineBreak":true},{"text":"ku leen leelul, ñu waajal xare.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo tax yeen, guddi moo leen di ñeel, ba peeñu réer,","poem":1},{"lineBreak":true},{"text":"lëndëm a leen di dikkal, ba am ngis tukkil leen,","poem":1},{"lineBreak":true},{"text":"jant mooy sowal yonent yi,","poem":1},{"lineBreak":true},{"text":"bëccëg lëndëmal leen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Seetkat yi dañuy rus,","poem":1},{"lineBreak":true},{"text":"boroom peeñu yi torox,","poem":1},{"lineBreak":true},{"text":"ñoom ñépp jàpp seen gémmiñ;","poem":1},{"lineBreak":true},{"text":"ndax Yàllaa leen dul faale.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Teewul man, may fees ak doole,","poem":1},{"lineBreak":true},{"text":"fees ak noowug Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ak dëgg ak njàmbaarte,","poem":1},{"lineBreak":true},{"text":"ngir biralal askanu Yanqóoba bàkkaaram,","poem":1},{"lineBreak":true},{"text":"ngir tuddal bànni Israayil googu moyam.","poem":1}]},{"type":"heading","content":["Aji Sax ji tiiñalaat na njiiti Israayil"]},{"type":"verse","number":9,"content":[{"text":"Ngalla dégluleen lii, yeen njiiti kër Yanqóoba;","poem":1},{"lineBreak":true},{"text":"yeen kilifay kër Israayil.","poem":1},{"lineBreak":true},{"text":"Yeen ñi seexlu dëgg,","poem":1},{"lineBreak":true},{"text":"lunkal wépp yoonu njub.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Deret ngeen tabaxe Siyoŋ,","poem":1},{"lineBreak":true},{"text":"njubadi ngeen tabaxe Yerusalem googu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Seeni njiit, alalu ger lañuy àttee,","poem":1},{"lineBreak":true},{"text":"seeni sarxalkat di feyeeku am njàngale,","poem":1},{"lineBreak":true},{"text":"seeni yonent di weccikoo xaalis seenum ngisaane,","poem":1},{"lineBreak":true},{"text":"te Aji Sax ji lañuy dëgërloo, naan:","poem":1},{"lineBreak":true},{"text":"«Xanaa du Aji Sax jaa ngi ci sunu biir?","poem":1},{"lineBreak":true},{"text":"Musiba du nu dab!»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kon nag yeena tax dees na gàbb Siyoŋ nib tool,","poem":1},{"lineBreak":true},{"text":"Yerusalem googu diy tojit, jale,","poem":1},{"lineBreak":true},{"text":"tundu kërug Yàlla gaay doon gajj bu kawe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}