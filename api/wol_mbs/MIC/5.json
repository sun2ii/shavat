{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"MIC","translationId":"wol_mbs","name":"Mise","commonName":"Mise","title":"Téereb Yonent Yàlla Mise","order":33,"numberOfChapters":7,"sha256":"7bc8fb1a4f6f8e80b4f7b3588db2736ea708a742ef6e977476a4150ede33f4cf","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/wol_mbs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"«Yaw Betleyem Efrata,","poem":1},{"lineBreak":true},{"text":"lu tuut ci làngi Yuda,","poem":1},{"lineBreak":true},{"text":"ci yaw la ku may yilifal Israayil di génne,","poem":1},{"lineBreak":true},{"text":"cosaanam di jant yu yàgga yàgg,","poem":1},{"lineBreak":true},{"text":"bu njëkkoon.»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moo tax Aji Sax ji di leen wacc","poem":1},{"lineBreak":true},{"text":"ba keroog kiy matu mucc.","poem":1},{"lineBreak":true},{"text":"Ca la bokkam ya dese bakkan di dellu,","poem":1},{"lineBreak":true},{"text":"fekki seen bokki bànni Israayil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kilifa gaay taxaw, sàmme ci dooley Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ci màggug turu Yàllaam Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ba ñu dëkke jàmm,","poem":1},{"lineBreak":true},{"text":"nde léegi lay doon Ku màgg,","poem":1},{"lineBreak":true},{"text":"ba turam dajal cati àddina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kookooy doon buntu jàmm,","poem":1},{"lineBreak":true},{"text":"ba bu waa Asiri songee sunum réew,","poem":1},{"lineBreak":true},{"text":"ba daagoo sunu kawi tata,","poem":1},{"lineBreak":true},{"text":"juróom ñaari njiit lanu koy yékkatil,","poem":1},{"lineBreak":true},{"text":"ba juróom ñetti garmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ab saamar la ñooñuy yilife Asiri,","poem":1},{"lineBreak":true},{"text":"réewum Nimrodd mooma ca biiri buntam.","poem":1},{"lineBreak":true},{"text":"Kilifa gi ñu dige moo nuy xettaleek Asiri,","poem":1},{"lineBreak":true},{"text":"bu ñu nu songee,","poem":1},{"lineBreak":true},{"text":"ba joggati sunu suuf.","poem":1}]},{"type":"heading","content":["Ndesu Israayil dina am doole"]},{"type":"verse","number":6,"content":[{"text":"Ci biir askan yu bare la ndesu Yanqóoba di nekk,","poem":1},{"lineBreak":true},{"text":"mel nib lay bu bawoo fa Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"nirook waame wu wàccal gàncax,","poem":1},{"lineBreak":true},{"text":"xaarul lenni nit,","poem":1},{"lineBreak":true},{"text":"lenni doom aadama la séentuwul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ci biir askan yu bare la ndesu Yanqóoba di nekk,","poem":1},{"lineBreak":true},{"text":"ci biir xeeti àddina,","poem":1},{"lineBreak":true},{"text":"mbete gaynde ci biir rabi àll yi,","poem":1},{"lineBreak":true},{"text":"nirook gaynde gu mat ci biiri gàtt;","poem":1},{"lineBreak":true},{"text":"fu mu jaare, joggati, xotat,","poem":1},{"lineBreak":true},{"text":"te kenn du wallu.","poem":1}]},{"type":"heading","content":["Cëslaay réer na bokkaalekat"]},{"type":"verse","number":8,"content":[{"text":"Aji Sax ji, sa loxo ca kaw, tiim say bañ,","poem":1},{"lineBreak":true},{"text":"mboolem say noon lees di jële ci kaw suuf.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Bésub keroog,» kàddug Aji Sax jee,","poem":1},{"lineBreak":true},{"text":"«maay sànke fi saw askan say fasi xare,","poem":1},{"lineBreak":true},{"text":"te maay sànk sa watiiri xare.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maa fiy yàqe sa dëkki réew mi,","poem":1},{"lineBreak":true},{"text":"màbb sa tata yépp.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maay foqatee ay xërëm ci sa loxo,","poem":1},{"lineBreak":true},{"text":"te ay gisaanekat, dootuloo ko am.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Maay jële fi saw askan say tuur,","poem":1},{"lineBreak":true},{"text":"ak say tuuri doj,","poem":1},{"lineBreak":true},{"text":"te dootoo sujjóotal loo sàkke say loxo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maay buddee fi saw askan xeri jaamookaayi Asera tuur mi,","poem":1},{"lineBreak":true},{"text":"te maay yàq say jëmmi tuur.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mer akum sànj laay feye xeeti yéefar","poem":1},{"lineBreak":true},{"text":"yi déggul ndigal.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}