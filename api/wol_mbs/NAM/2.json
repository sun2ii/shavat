{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"NAM","translationId":"wol_mbs","name":"Nawum","commonName":"Nawum","title":"Téereb Yonent Yàlla Nawum","order":34,"numberOfChapters":3,"sha256":"38d5ab8fa77c4170cdfe6fbfb7cfe9e8c4ba66d176200f6e5ca7576478cc11a0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/wol_mbs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndaw a ngii dawe kaw tund ya,","poem":1},{"lineBreak":true},{"text":"di indi kàddu, xibaaru jàmm.","poem":1},{"lineBreak":true},{"text":"Yaw Yuda, bégeel sa bési màggal,","poem":1},{"lineBreak":true},{"text":"te wàccook say xas.","poem":1},{"lineBreak":true},{"text":"Nit ku bon ki dootul jaare fi yaw;","poem":1},{"lineBreak":true},{"text":"léppam lees di dagg, sànni.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ki lay falaxe buur na, wutsi la!","poem":1},{"lineBreak":true},{"text":"Sàmmal sab tata, wattu saw yoon,","poem":1},{"lineBreak":true},{"text":"takkal sa ndigg, te dëgërlu bu baax.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Aji Sax ji moo yeesal darajay Yanqóoba,","poem":1},{"lineBreak":true},{"text":"darajay Israayil moomu.","poem":1},{"lineBreak":true},{"text":"Ay taskat a ko tasoon,","poem":1},{"lineBreak":true},{"text":"yàqate ay caram.","poem":1}]},{"type":"heading","content":["Dëkkub noon daanu na"]},{"type":"verse","number":4,"content":[{"text":"Pakki jàmbaaram ña lañu suub xonq,","poem":1},{"lineBreak":true},{"text":"ñeyi xare ya sol lu xonq curr,","poem":1},{"lineBreak":true},{"text":"watiiri xare yay melax ni luy tàkk,","poem":1},{"lineBreak":true},{"text":"ca bés ba ñu waajal xare,","poem":1},{"lineBreak":true},{"text":"xeej ya jóg.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ca mbedd ya la watiiri xare yay riire,","poem":1},{"lineBreak":true},{"text":"riddi jaare pénc ya,","poem":1},{"lineBreak":true},{"text":"mel niy jum,","poem":1},{"lineBreak":true},{"text":"di ray-rayi niy melax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ca la njiit la di woolu kàngami xareem,","poem":1},{"lineBreak":true},{"text":"ñuy gaawtu bay tërëf","poem":1},{"noteId":0},{"text":".","poem":1},{"lineBreak":true},{"text":"Tata ja lañuy gaaw wutali,","poem":1},{"lineBreak":true},{"text":"ba yékkati ay kiiraay.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bunt ya jëm dex ga ñooy jekki ubbiku,","poem":1},{"lineBreak":true},{"text":"kër buur màbb.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Futtees na jongama","poem":1},{"noteId":1},{"text":", yóbbu,","poem":1},{"lineBreak":true},{"text":"janqam jay binni niy xati,","poem":1},{"lineBreak":true},{"text":"di fëgg seen dënn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niniw la ay nitam di daw, mu mel ni mbànd","poem":1},{"lineBreak":true},{"text":"mu ndox may senn,","poem":1},{"lineBreak":true},{"text":"ñu naan leen: «Taxawleen, taxawleen,»","poem":1},{"lineBreak":true},{"text":"te kenn geestuwul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sëxëtooleen xaalis, sëxëtoo wurus,","poem":1},{"lineBreak":true},{"text":"alal du fi jeex te mboolem gànjar a jale.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dëkk bi lees di raatale, maasale,","poem":1},{"lineBreak":true},{"text":"mu ne faraas,","poem":1},{"lineBreak":true},{"text":"fit rëcc, óom yiy fenqe,","poem":1},{"lineBreak":true},{"text":"ndigg yépp di kal-kali,","poem":1},{"lineBreak":true},{"text":"kanam yépp di sël-sëli.","poem":1}]},{"type":"heading","content":["Doole réer na gaynde"]},{"type":"verse","number":12,"content":[{"text":"Moo ana paxum gaynde ga?","poem":1},{"lineBreak":true},{"text":"Ana àllub gaynde yu ndaw ya,","poem":1},{"lineBreak":true},{"text":"fa góoru gaynde daa daagoo,","poem":1},{"lineBreak":true},{"text":"mook jeegub gayndeem ak doom ya,","poem":1},{"lineBreak":true},{"text":"te dara tiitalu leen!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gaynde di fa fàdd lu doy ay doomam,","poem":1},{"lineBreak":true},{"text":"reyal ay jeegi gayndeem,","poem":1},{"lineBreak":true},{"text":"feesal xuntam akum rëbbam,","poem":1},{"lineBreak":true},{"text":"feesal paxam akum pàddam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Maa ngii fi sa kaw,»","poem":1},{"lineBreak":true},{"text":"kàddug Aji Sax jee, Boroom gàngoor yi.","poem":1},{"lineBreak":true},{"text":"«Say watiiri xare laay lakk, saxaaral,","poem":1},{"lineBreak":true},{"text":"sa gaynde yu ndaw, saamar lekk leen,","poem":1},{"lineBreak":true},{"text":"te sam pàdd laay jële ci réew mi,","poem":1},{"lineBreak":true},{"text":"ba deesul déggati baatu ndaw loo yebal.»","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.6 Seetal ci 3.3.","reference":{"chapter":2,"verse":6}},{"noteId":1,"caller":"+","text":"2.8 jongama ji, jombul jëmmu tuur la mu ñu ne mooy nangul am njur. Man naa doon it dëkk bi ci boppam.","reference":{"chapter":2,"verse":8}}]},"thisChapterLink":"/api/wol_mbs/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}