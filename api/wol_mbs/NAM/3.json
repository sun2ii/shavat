{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"NAM","translationId":"wol_mbs","name":"Nawum","commonName":"Nawum","title":"Téereb Yonent Yàlla Nawum","order":34,"numberOfChapters":3,"sha256":"38d5ab8fa77c4170cdfe6fbfb7cfe9e8c4ba66d176200f6e5ca7576478cc11a0","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/wol_mbs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"line_break"},{"type":"heading","content":["Ab safaan ñeel na Niniw"]},{"type":"verse","number":1,"content":[{"text":"Wóoy, ngalla dëkkub tuurkatu deret bi,","poem":1},{"lineBreak":true},{"text":"ñépp di fen, fees aku ay,","poem":1},{"lineBreak":true},{"text":"te foqati alalu jàmbur du dakk!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kàcciri dal,","poem":1},{"lineBreak":true},{"text":"ay mbege riir,","poem":1},{"lineBreak":true},{"text":"fas rëpptal,","poem":1},{"lineBreak":true},{"text":"watiir kar-kari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gawar buur,","poem":1},{"lineBreak":true},{"text":"saamar melax,","poem":1},{"lineBreak":true},{"text":"xeej lerxat,","poem":1},{"lineBreak":true},{"text":"ñu bare ne lasiim,","poem":1},{"lineBreak":true},{"text":"ñi dee jale,","poem":1},{"lineBreak":true},{"text":"néew ya tëë jeex,","poem":1},{"lineBreak":true},{"text":"ñuy fakkastaloo néew ya.","poem":1}]},{"type":"heading","content":["Aw léeb ñeel na Niniw, gànc biy xërëmtu"]},{"type":"verse","number":4,"content":[{"text":"Lépp ndax ngànctu gu bare gi gànc bi nekke!","poem":1},{"lineBreak":true},{"text":"Jekk tànkee, boroom xërëm yi,","poem":1},{"lineBreak":true},{"text":"ci ngànctu nga jaaye ay xeet,","poem":1},{"lineBreak":true},{"text":"te xërëmtu nga naxe ay giir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Maa ngii fi sa kaw,»","poem":1},{"lineBreak":true},{"text":"kàddug Aji Sax jee, Boroom gàngoor yi.","poem":1},{"lineBreak":true},{"text":"«Sa pendal laay ñori,","poem":1},{"lineBreak":true},{"text":"ba muur sa xar-kanam,","poem":1},{"lineBreak":true},{"text":"won xeeti jàmbur yi sa yaramu neen,","poem":1},{"lineBreak":true},{"text":"gisloo waa réew yi sa gàcce.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa lay xëpp mbalit, sewal la,","poem":1},{"lineBreak":true},{"text":"def lam ceetaan,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ku la gis, daw la","poem":1},{"lineBreak":true},{"text":"te naan: “Niniw tas na!","poem":1},{"lineBreak":true},{"text":"Moo ku koy jooy?”","poem":1},{"lineBreak":true},{"text":"Ana fu ma koy wutale ñu ko dëfal?»","poem":1}]},{"type":"heading","content":["Niniw du gën dëkku No Amon demin"]},{"type":"verse","number":8,"content":[{"text":"Moo Niniw, dangaa gën No Amon","poem":1},{"noteId":2},{"text":", péeyub Misraa?","poem":1},{"lineBreak":true},{"text":"Dëkk ba dëju fa digg wali Niil ya,","poem":1},{"lineBreak":true},{"text":"am ndox wër ko,","poem":1},{"lineBreak":true},{"text":"am tataam di géej,","poem":1},{"lineBreak":true},{"text":"miiram di ndox mu wale géej,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"réewum Kuus di ndëgërlaayam,","poem":1},{"lineBreak":true},{"text":"Misra di ko dooleele doole ju dul jeex,","poem":1},{"lineBreak":true},{"text":"réewum Puut ak Libi di ko jàppale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Teewul ñu gàddaayloo ko, yóbbu cig njaam;","poem":1},{"lineBreak":true},{"text":"ay goneem, ñu falaxe leen ci mboolem selebe yoon;","poem":1},{"lineBreak":true},{"text":"ay kàngamam, ñu tegoo bant;","poem":1},{"lineBreak":true},{"text":"kilifaam yépp, ñu jéng leen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Niniw yaw it dinga bilimbaane,","poem":1},{"lineBreak":true},{"text":"jànnaxe, di wuta raw ab noon.","poem":1}]},{"type":"heading","content":["Doole réer na Niniw"]},{"type":"verse","number":12,"content":[{"text":"Sa tata yépp ni garabi figg","poem":1},{"lineBreak":true},{"text":"yu ñoral ndoortel meññeef lay mel,","poem":1},{"lineBreak":true},{"text":"soo yëlëbee, doom ya rot,","poem":1},{"lineBreak":true},{"text":"ca gémmiñ ga ka namma lekk.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Say gàngoor a ngii diy jigéen fi sa biir,","poem":1},{"lineBreak":true},{"text":"sa bunti réew lafal say noon,","poem":1},{"lineBreak":true},{"text":"ne ŋàpp-ŋàppaaral,","poem":1},{"lineBreak":true},{"text":"sawara xoyom tëjukaay ya!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Niniwee, ndox moo fàggoo ab gaw,","poem":1},{"lineBreak":true},{"text":"ngay rooti te dàbbali say tata.","poem":1},{"lineBreak":true},{"text":"Duggal ci bàq bi, noote ban bi,","poem":1},{"lineBreak":true},{"text":"te ne cas móolukaay bi!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fa la la sawara di xoyome,","poem":1},{"lineBreak":true},{"text":"saamar xottee la fa,","poem":1},{"lineBreak":true},{"text":"raafal la ni soccet di def.","poem":1},"Niniw day raaf",{"text":"Fulal saw nit niy soccet,","poem":1},{"lineBreak":true},{"text":"ñu tollu niy njéeréer.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ay jula nga barele,","poem":1},{"lineBreak":true},{"text":"ba ñu ëpp biddiiwi asamaan,","poem":1},{"lineBreak":true},{"text":"te ñoo mel niy soccet, tojtal, naaw.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Say kàngam it niy soccet,","poem":1},{"lineBreak":true},{"text":"say jawriñ ni naaxu gunóor","poem":1},{"lineBreak":true},{"text":"yu dale kaw tata, bésub sedd,","poem":1},{"lineBreak":true},{"text":"jant bi jóg, ñu daw,","poem":1},{"lineBreak":true},{"text":"te deesul xam fu ñu nekk.","poem":1}]},{"type":"heading","content":["Woykat jooy na Niniw"]},{"type":"verse","number":18,"content":[{"text":"Buurub Asiree, say sàmm a saay,","poem":1},{"lineBreak":true},{"text":"say garmi nelaw,","poem":1},{"lineBreak":true},{"text":"sa gàngoor tasaaroo kaw tund wa,","poem":1},{"lineBreak":true},{"text":"te ku leen dajale wuute.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sa damm-damm amul paj,","poem":1},{"lineBreak":true},{"text":"sab góom metti,","poem":1},{"lineBreak":true},{"text":"ba mboolem ñi dégg li la dal","poem":1},{"lineBreak":true},{"text":"di tàccu ci sa kaw,","poem":1},{"lineBreak":true},{"text":"nde ana ku sa mbon gi dul jeex lorul?","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"3.8 No Amon moy dëkk bi Asiri duma ci 663 at lu jiitu Almasi bi.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/wol_mbs/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}