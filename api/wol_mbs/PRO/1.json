{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":1,"content":[{"type":"heading","content":["Li tax téere bi jóg"]},{"type":"verse","number":1,"content":["Kàddu yu xelu yu Suleymaan buurub Israayil, di doomu Daawuda."]},{"type":"verse","number":2,"content":["Li ko taxa jóg di nit ñi am xel mu rafet, am ab yar, ngir xam wax ju lal dég-dég,"]},{"type":"verse","number":3,"content":["ngir yaru ci jëfe xel ak njub ak yoon, di jubal,"]},{"type":"verse","number":4,"content":["ndax ab téxét di foog, ndaw li it xam tey xalaat."]},{"type":"verse","number":5,"content":["Na boroom xel mu rafet déglu, yokk dég-dégam, te kiy ràññee di jariñoo ay tegtal,"]},{"type":"verse","number":6,"content":["ngir mana xam aw léeb aku taas ak kàddug boroomi xel yu rafet ak seeni cax."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ragal Aji Sax ji di njàlbéenu xam-xam,","poem":1},{"lineBreak":true},{"text":"te xel mu rafet akub yar, dof yaa ko xeeb.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Doom, toppal yaru baay,","poem":1},{"lineBreak":true},{"text":"te bul wacc ndigalu yaay.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kaala gu jekk la ci bopp,","poem":1},{"lineBreak":true},{"text":"di gànjar ci baat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Doom, bàkkaarkat bu la xiirtal, lànkal.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dañu la naan: «Dikkal, nu tëruji bakkan,","poem":1},{"lineBreak":true},{"text":"yeeruji jàmbur bu deful dara.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanu mel ni njaniiw, mëdd kuy dund,","poem":1},{"lineBreak":true},{"text":"mu jekki tàbbi biir bàmmeel.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mboolem alal ju réy, nu jagoo,","poem":1},{"lineBreak":true},{"text":"yeb sunu biir kër, mu fees.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dikkal nu far,","poem":1},{"lineBreak":true},{"text":"mbuus miy benn, nu bokk.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Doom, bul ànd ak ñoom ciw yoon,","poem":1},{"lineBreak":true},{"text":"bul jaare fa ñuy jaar,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ngir dañuy xélu, nar musiba,","poem":1},{"lineBreak":true},{"text":"di gaawtuy sànk bakkan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Doo firib caax,","poem":1},{"lineBreak":true},{"text":"ba jàpp njanaaw luy xoole.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ñii kat seen bopp lañuy fiir,","poem":1},{"lineBreak":true},{"text":"seen bakkanu bopp lañu sànk.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Képp kuy lekk lu lewul, nii lay mujje:","poem":1},{"lineBreak":true},{"text":"wutin wu lewul jël bakkanu boroom.","poem":1}]},{"type":"heading","content":["Xel mu Rafet woote na"]},{"type":"verse","number":20,"content":[{"text":"Xel mu Rafet a ngay woote ca mbedd ma,","poem":1},{"lineBreak":true},{"text":"di xaacu ca pénc ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma ngay wootee béreb yu gëna xumb,","poem":1},{"lineBreak":true},{"text":"di dégtaley kàddoom ca buntu dëkk ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma nga naan: «Moo téxét bi, foo àppal sa téxét gi?","poem":1},{"lineBreak":true},{"text":"Ñaawlekat bi, foo àppal sa ñaawle bi?","poem":1},{"lineBreak":true},{"text":"Dof bi, ñaata yoon ngay bañ xam-xam?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Soo dëppee ba déglu, ma artu la.","poem":1},{"lineBreak":true},{"text":"Ma ne, kon ma xellil la samam xel,","poem":1},{"lineBreak":true},{"text":"xamal la samay kàddu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Damaa woote, nga gàntal,","poem":1},{"lineBreak":true},{"text":"ma tàllal loxo, faaleesu ma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sofental nga samay digle,","poem":1},{"lineBreak":true},{"text":"nanguwoo samay artu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kon boo sëngéemee, man it ma ree,","poem":1},{"lineBreak":true},{"text":"njàqare dab la, may tex-texi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Njàqare di ngëlén, dab la,","poem":1},{"lineBreak":true},{"text":"sa musiba def callweer, buub la,","poem":1},{"lineBreak":true},{"text":"njekkar ak fitna dal la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Keroog nga woo ma wall, duma wuyu,","poem":1},{"lineBreak":true},{"text":"nga seet ma, seet, doo ma gis.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Daa fekk nga baña xam,","poem":1},{"lineBreak":true},{"text":"te ragal Yàlla du loo tànn.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dégluwoo samay digle it,","poem":1},{"lineBreak":true},{"text":"xanaa xeeb samay artu yépp.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Waaye loo ci góobe, gar ko,","poem":1},{"lineBreak":true},{"text":"say pexe suur la këll.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Déggadi sànk ab téxét,","poem":1},{"lineBreak":true},{"text":"naagu rey ab dof.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Waaye déggal ma, dëkke jàmm,","poem":1},{"lineBreak":true},{"text":"tàggook njekkar ak safaan.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}