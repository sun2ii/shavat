{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Kàddu yu xelu yu Suleymaan.","poem":1},{"lineBreak":true},{"text":"Doom rafet xel, baay ba bég;","poem":1},{"lineBreak":true},{"text":"doom dof, ndey ja tiis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Alal ju lewul du jariñ;","poem":1},{"lineBreak":true},{"text":"jub, mucc ci gàtt fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aji Sax ji du seetaan kiy def njekk, di xiif,","poem":1},{"lineBreak":true},{"text":"waaye day xañ ab soxor la mu xemmem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaafus, walaakaana;","poem":1},{"lineBreak":true},{"text":"farlu, woomle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ku ngóob jot, nga góob, xelu nga;","poem":1},{"lineBreak":true},{"text":"ngóob taxaw, ngay nelaw, gàcce la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jub, barkeelu;","poem":1},{"lineBreak":true},{"text":"ku soxor, wax ja làq fitna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku jëfe njekk barkeel, saw tur du fey;","poem":1},{"lineBreak":true},{"text":"ab soxor, turam seey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku rafet xel day jëfe santaane,","poem":1},{"lineBreak":true},{"text":"ab dof wax a wax, ba loru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Màndu, fegu;","poem":1},{"lineBreak":true},{"text":"dëng, weeru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Piiseek làq-làqal, sabab njàqare;","poem":1},{"lineBreak":true},{"text":"ab dof wax a wax, ba loru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kàdduy ku jub bëtu ndox la, day naatal;","poem":1},{"lineBreak":true},{"text":"waaye ku soxor, wax ja làq fitna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mbañeel ak ayoo;","poem":1},{"lineBreak":true},{"text":"cofeel ak jéggale bépp tooñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuy dégg, say wax rafet;","poem":1},{"lineBreak":true},{"text":"te ku ñàkk bopp, yelloo yetu gannaaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ku rafet xel day xam, ne cell;","poem":1},{"lineBreak":true},{"text":"bu dof noppiwul, yàqule teew.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alal day aar boroom ni ab tata,","poem":1},{"lineBreak":true},{"text":"ñàkk di lor baadoolo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kiy jëfe njekk jot peyam, dunde;","poem":1},{"lineBreak":true},{"text":"ab soxor di bàkkaare alalam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yaru, gudd fan;","poem":1},{"lineBreak":true},{"text":"sàgganey artu, sànku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku la nëbbal mbañeel, da lay fen;","poem":1},{"lineBreak":true},{"text":"kuy wër di sos, ab dof la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wax ju bare, moy ñàkku ca;","poem":1},{"lineBreak":true},{"text":"ku moom sa làmmiñ, xelu nga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kàddug boroom njekk di ngën-gi-xaalis,","poem":1},{"lineBreak":true},{"text":"xelum coxor amul solo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kàdduy boroom njekk jariñ na ñu bare,","poem":1},{"lineBreak":true},{"text":"dof ñàkk na bopp, ba far dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Barkeb Aji Sax jeey maye alal,","poem":1},{"lineBreak":true},{"text":"kër-këri taxula barele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Jëf ju bon la dof di fowe;","poem":1},{"lineBreak":true},{"text":"ku am dég-dég safoo lu xelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ab soxor, li mu ragal moo koy dab;","poem":1},{"lineBreak":true},{"text":"nammeelu kiy def njekk nag day sotti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bu ngëlén walee, ab soxor ne mes;","poem":1},{"lineBreak":true},{"text":"kiy def njekk, sab reen sax ba fàww.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ndaw lu tayel ca ka yónnee","poem":1},{"lineBreak":true},{"text":"daa mel ni lu forox ciy gëñ mbaa saxaar ciy gët.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ragal Aji Sax ji, gudd fan;","poem":1},{"lineBreak":true},{"text":"soxor, gàtt fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kiy def njekk day séentu mbégte, gis ko;","poem":1},{"lineBreak":true},{"text":"ab soxor yaakaar, yàkki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Aji Sax jeeki nammeelam rawtu la ci ku mat,","poem":1},{"lineBreak":true},{"text":"di sànkute ci kuy def lu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kiy def njekk deesu ko daaneel mukk,","poem":1},{"lineBreak":true},{"text":"ku soxor du yàgg cim réew.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kàddug boroom njekk day jur xel mu rafet,","poem":1},{"lineBreak":true},{"text":"ku wax njekkar ñu tëj sa gémmiñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Boroom njekk day xam wax ju yiw;","poem":1},{"lineBreak":true},{"text":"ab soxor sàlloo waxi njekkar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}