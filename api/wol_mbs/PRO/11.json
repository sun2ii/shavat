{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Aji Sax ji bañ na njublaŋ ci nattub diisaay,","poem":1},{"lineBreak":true},{"text":"ay nattukaay na mat, muy bànneexam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ku réy-réylu rus;","poem":1},{"lineBreak":true},{"text":"woyofal ndax nga xelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuy jubal, jiital mat.","poem":1},{"lineBreak":true},{"text":"Njublaŋ ak wor, detteelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alal du jariñ bésu mbugal;","poem":1},{"lineBreak":true},{"text":"jub, mucc ci gàtt fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ku mat, dëgg xàllal la;","poem":1},{"lineBreak":true},{"text":"coxor daaneel boroom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jubalal, sa jëfi njekk musal la;","poem":1},{"lineBreak":true},{"text":"ab workat day bëgge, ba far keppu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ab soxor saay, yaakaaram seey,","poem":1},{"lineBreak":true},{"text":"rawatina yaakaar ju sës ci alal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku jub mucc ci njàqare,","poem":1},{"lineBreak":true},{"text":"ab soxor wuutu ko ca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ay sos la yéefar di loree dëkkandoom,","poem":1},{"lineBreak":true},{"text":"waaye kiy jëfe njekk, xam-xam la cay mucce.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kiy jëfe njekk baaxle, waa dëkkam bànneexu;","poem":1},{"lineBreak":true},{"text":"ab saay-saay saay, mbégte dim riir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Barkeb kiy jëfe njekk teral nab dëkk,","poem":1},{"lineBreak":true},{"text":"kàddug ku soxor tas nab dëkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waxi xeebaate ñàkk bopp la,","poem":1},{"lineBreak":true},{"text":"ku am ag dégg day noppi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuy wër di sos dangay wuññi sutura,","poem":1},{"lineBreak":true},{"text":"ku jara wóolu dangay am bàmmeelu biir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tegtal tumurànke, am réew suux;","poem":1},{"lineBreak":true},{"text":"digle bare, ndam dikk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bul gàddul kenn bor, di loru;","poem":1},{"lineBreak":true},{"text":"bañ koo dige, daldi am jàmm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jigéen, na yiw, ñu sagal ko;","poem":1},{"lineBreak":true},{"text":"góor gu néeg, alal doŋŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku baax, boppam;","poem":1},{"lineBreak":true},{"text":"ku bon, boppam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Coxor feyul boroom, day naxe;","poem":1},{"lineBreak":true},{"text":"deel def njekk, sag pey wóor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Saxoo njekk, dund;","poem":1},{"lineBreak":true},{"text":"sàlloo mbon, dee rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aji Sax ji bañ na njublaŋ,","poem":1},{"lineBreak":true},{"text":"safoo ki mat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ab soxor mbugalam du jaas, wóor na;","poem":1},{"lineBreak":true},{"text":"te ku jëfe njekk, saw askan mucc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Taaru jongama ju xel maa gàtt,","poem":1},{"lineBreak":true},{"text":"mooy jaaro wurus ci noppu mbaam-xuux.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kiy jëfe njekk, lu baax rekk lay sàkku;","poem":1},{"lineBreak":true},{"text":"soxor biy yaakaar, mujje mbugal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nit a ngi tabe, di yokkule;","poem":1},{"lineBreak":true},{"text":"nit di nëŋ-nëŋi, gëna ñàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ku yéwén, woomle;","poem":1},{"lineBreak":true},{"text":"kuy suuxat, suuxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Nit a ngi móolu kuy denc pepp, ba mu ñàkkee,","poem":1},{"lineBreak":true},{"text":"di gërëm ka koy jaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Wutal a wut lu baax, ñu nawloo la;","poem":1},{"lineBreak":true},{"text":"ku sàkku lu bon, yaa koy yenu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ku yaakaar sa alal sab jéll a ngi ñëw,","poem":1},{"lineBreak":true},{"text":"ku jub day juble ni gàncax gu naat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kuy fitnaal sa waa kër doo donn dara,","poem":1},{"lineBreak":true},{"text":"ku dof, boroom xel yilif la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kuy jëfe njekk mbete garab guy taxa dund,","poem":1},{"lineBreak":true},{"text":"ku rafet xel am nit ñi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kuy jëfe njekk, jot yoolam ci kaw suuf,","poem":1},{"lineBreak":true},{"text":"ku soxor keek bàkkaarkat bi it daw raw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}