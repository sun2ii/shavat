{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Ku bëgga xam, bëgg ku la yedd;","poem":1},{"lineBreak":true},{"text":"ku bañ ku la artu, bàyyima nga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ku baax, Aji Sax ji bége la;","poem":1},{"lineBreak":true},{"text":"kuy fexe lu bon, mu daan la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ab soxor, taxawaayam du yàgg;","poem":1},{"lineBreak":true},{"text":"kuy jëfe njekk garab la, reen ba ne kekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jeeg bu jàmbaare day teral jëkkër ja,","poem":1},{"lineBreak":true},{"text":"jeeg buy rusloo day semmal jëkkër ja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Boroom njekk, lu jekk lay mébét;","poem":1},{"lineBreak":true},{"text":"ab soxor di lal pexey wor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ab soxor, waxam am tëru la, day reye;","poem":1},{"lineBreak":true},{"text":"kàdduy kiy jubal di musle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ab soxor bu daanoo, jeex na;","poem":1},{"lineBreak":true},{"text":"ku jub, sa kër taxaw, ne këcc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xel mu ñaw, jëw bu rafet;","poem":1},{"lineBreak":true},{"text":"sam xel jekkadi, ñu xeeb la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Woyof mbubb, am benn surga doŋŋ,","poem":1},{"lineBreak":true},{"text":"moo gën réyal turki tey dee ak xiif.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ku jub day toppatoo ag juram,","poem":1},{"lineBreak":true},{"text":"ab soxor néeg cig juram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Beyal sab tool, sab dund doy;","poem":1},{"lineBreak":true},{"text":"topp ay caaxaan ñàkk bopp la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ab soxor ay xemmem alal ju lewul,","poem":1},{"lineBreak":true},{"text":"kiy jëfe njekk garab la, reen baa ko meññal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bàkkaaru làmmiñ dugal na boroom,","poem":1},{"lineBreak":true},{"text":"ku jub mucc ci njàqare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Làmmiñ reggal na boroom;","poem":1},{"lineBreak":true},{"text":"ñaq, jariñu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Na dof di jëfe, njub la ci moom;","poem":1},{"lineBreak":true},{"text":"dégg ndigal rafetum xel la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ab dof bu meree, mu gaawa feeñ;","poem":1},{"lineBreak":true},{"text":"ku teey, tanqamlu saaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku dëggu, seede dëgg;","poem":1},{"lineBreak":true},{"text":"seede bu bon, fen rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Làmmiñu waxkat, jam-jami jaasi;","poem":1},{"lineBreak":true},{"text":"kàddu gu xelu, garab la ci.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kàdduy dëgg, day sax dàkk;","poem":1},{"lineBreak":true},{"text":"fen, xef-xippi, mu wéy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kuy ràbb lu bon lal pexey wor,","poem":1},{"lineBreak":true},{"text":"kuy digle jàmm, am mbégte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku jub du ami ay,","poem":1},{"lineBreak":true},{"text":"ab soxor du tàggook musiba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Aji Sax ji sib na fen-kat,","poem":1},{"lineBreak":true},{"text":"safoo ku dëggu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nit ku ñaw day xam, ba ca;","poem":1},{"lineBreak":true},{"text":"ab dof siiwal waxi dofam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Njaxlaf, jiitu;","poem":1},{"lineBreak":true},{"text":"yaafus, des gannaaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Njàqare day jeexal xolu boroom,","poem":1},{"lineBreak":true},{"text":"wax ju neex di tooyal xolam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ku jub day xool ku muy xaritool","poem":1},{"noteId":1},{"text":";","poem":1},{"lineBreak":true},{"text":"soxor bi, jikkoom a koy sànk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ab yaafus bu rëbbee, sooy;","poem":1},{"lineBreak":true},{"text":"cawarte koom la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Jaaral ci njub, ba gudd fan;","poem":1},{"lineBreak":true},{"text":"yoon wu baax deesu fa deewe.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"12.26 Mbaa: Ku jub day teg moroomam ciw yoon;","reference":{"chapter":12,"verse":26}}]},"thisChapterLink":"/api/wol_mbs/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}