{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Doom ju xelu dégg yaru baay,","poem":1},{"lineBreak":true},{"text":"kuy ñaawle faalewuli artu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wax ju rafet yool na boroom,","poem":1},{"lineBreak":true},{"text":"workat fitna la namm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Moom sa làmmiñ, sàmm sa bakkan;","poem":1},{"lineBreak":true},{"text":"rattaxle, yàqule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ab yaafus day yaakaar, du am;","poem":1},{"lineBreak":true},{"text":"ab njaxlaf sàkku, woomle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ku jub bañ na ay fen,","poem":1},{"lineBreak":true},{"text":"ku soxor di indi gàcceek yeraange.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ku mat day jub, ba fegu;","poem":1},{"lineBreak":true},{"text":"moykat soxor, ba sànku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nit a ngi am-amlu, amul dara;","poem":1},{"lineBreak":true},{"text":"nit di dee-deelu te fees dell.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku am ay feye alalam, ba mucc;","poem":1},{"lineBreak":true},{"text":"ku amul deesu ko tëkku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ku jub day leer nàññ,","poem":1},{"lineBreak":true},{"text":"ab soxor mel ni taal bu fey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Réy-réylu jote rekk lay jur,","poem":1},{"lineBreak":true},{"text":"ku dégg ndigal a xelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alal ju lewul day naaw;","poem":1},{"lineBreak":true},{"text":"foral benn-benn, ba barele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaakaar ju tas day jeexal xol,","poem":1},{"lineBreak":true},{"text":"aajo ju faju di garab guy taxa dund.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ku sofental ndigalu Yàlla, yàqule;","poem":1},{"lineBreak":true},{"text":"ku jëfe santaane Yàlla, yoolu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Njàngale mu xelu day suuxat bakkan,","poem":1},{"lineBreak":true},{"text":"ba boroom du tàbbi ci fiiri dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dangay xam lu jaadu, ñu naw la;","poem":1},{"lineBreak":true},{"text":"yoonu workat day metti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Képp ku teey jëfe xam-xam;","poem":1},{"lineBreak":true},{"text":"ab dof ay siiwal ndofam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndaw lu bon day loru.","poem":1},{"lineBreak":true},{"text":"Ndaw lu wóor garab la ci nit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku sàggane yoonu yar, séddoo ñàkk ak gàcce;","poem":1},{"lineBreak":true},{"text":"kuy déggi artu, am teraanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Aajo ju faju tooyal na xol,","poem":1},{"lineBreak":true},{"text":"te ab dof jomb naa dëddu mbon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Àndal ak ku xelu, sam xel rafet;","poem":1},{"lineBreak":true},{"text":"ku lëngookub dof, loru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ay topp na moykat,","poem":1},{"lineBreak":true},{"text":"ku jub juble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ku baax, donale ba cay sëtam;","poem":1},{"lineBreak":true},{"text":"alalu moykat, muuru ku jub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ku néewle bey na, meññeef ne gàññ,","poem":1},{"lineBreak":true},{"text":"ñu àtte ko ñàkkal, mu ñàkk ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku dul bantal sa doom, bëggoo ko.","poem":1},{"lineBreak":true},{"text":"Ku bëgg sa doom teel koo yar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ku jub day lekk ba regg,","poem":1},{"lineBreak":true},{"text":"soxor ba dëkke xiif.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}