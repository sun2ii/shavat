{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Jigéen, rafet xel, dimbali waa këram,","poem":1},{"lineBreak":true},{"text":"su deeb dof, tas këram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuy jubal day ragal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ku dëng teddadil nga ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ab dof a ngi réy-réylu, làmmiñam yar ko;","poem":1},{"lineBreak":true},{"text":"ku rafet xel, sa kàddu aar la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Su yëkk takkul, bey, sàq wéet;","poem":1},{"lineBreak":true},{"text":"mu beye dooleem, meññeef ne gàññ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Seede bu dëggu, dëgg rekk,","poem":1},{"lineBreak":true},{"text":"seede bu dëgguwul, fen rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ab ñaawlekat day wut xel mu rafet, mu réer ko;","poem":1},{"lineBreak":true},{"text":"ku amug dégg, xam yomb la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dàndal ab dof,","poem":1},{"lineBreak":true},{"text":"dof du la yokk xam-xam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku ñaw day xelu, xam li muy def;","poem":1},{"lineBreak":true},{"text":"ab dof di nax boppam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ab dof, su bàkkaaree, yoonam!","poem":1},{"lineBreak":true},{"text":"Te ñay jubal a séq yiwu Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tiisu xol, boroom a ko xam;","poem":1},{"lineBreak":true},{"text":"mbégte ma it jàmbur bokku ca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ab soxor, këram day tas,","poem":1},{"lineBreak":true},{"text":"mbaarum ku jub di naat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yoon a ngii, nit defe ne jub na,","poem":1},{"lineBreak":true},{"text":"te mu jëme ko ci dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nit a ngi ree, xol ba tiis,","poem":1},{"lineBreak":true},{"text":"te mbégte mujje na njàqare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ku def njekkar sab añ mat,","poem":1},{"lineBreak":true},{"text":"ku baax gën law demin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ab téxét, loo wax mu gëm;","poem":1},{"lineBreak":true},{"text":"ku ñaw xam fi ngay jaare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ku xelu day ragal, di dëddu lu bon;","poem":1},{"lineBreak":true},{"text":"ab dof day ràkkaaju, du tiit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku gaawa mer, def jëfi dof,","poem":1},{"lineBreak":true},{"text":"te kuy fexeel nit, ñu bañ la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ab téxét ndof ay céram,","poem":1},{"lineBreak":true},{"text":"ku ñaw jagoo xam-xam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ku bon sujjóotal ku baax;","poem":1},{"lineBreak":true},{"text":"ku soxor ay yaakaar ku jub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ku ñàkk, say dëkk sax bañ la;","poem":1},{"lineBreak":true},{"text":"ku barele, barey xarit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku xeeb sa dëkkandoo, bàkkaar nga;","poem":1},{"lineBreak":true},{"text":"ku baaxe ku ñàkk, mbégte ñeel la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kuy mébét lu bon daa réer,","poem":1},{"lineBreak":true},{"text":"kuy mébét lu baax am nga ngor ak worma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kër-këri, jariñu;","poem":1},{"lineBreak":true},{"text":"waxi neen, loxoy neen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku rafet xel jagoo alal,","poem":1},{"lineBreak":true},{"text":"ab dof ràngoo ndofam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Seede bu dëggu day jot bakkan,","poem":1},{"lineBreak":true},{"text":"kuy fen day wore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ragal Aji Sax ji kaaraange gu wér la ci nit,","poem":1},{"lineBreak":true},{"text":"di rawtu ciy doomam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ragal Aji Sax ji day suuxat bakkan,","poem":1},{"lineBreak":true},{"text":"ba boroom du tàbbi ci fiiri dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Su mbooloo baree, buur am ndam;","poem":1},{"lineBreak":true},{"text":"fu nit ña néew, kilifa du fa dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Muñ mer, déggin wu yaa;","poem":1},{"lineBreak":true},{"text":"gaawa tàng, gënatee dof.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Xel mu dal, yaram wu naat;","poem":1},{"lineBreak":true},{"text":"fiiraange semmal boroom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ku sonal ku ñàkk, tooñ nga Ka ko sàkk;","poem":1},{"lineBreak":true},{"text":"ku baaxe ku néewle, teral nga Ka ko sàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Coxor detteel boroom;","poem":1},{"lineBreak":true},{"text":"ku jub fegoo mànduteem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Kuy dégg, sam xel saxoo rafet;","poem":1},{"lineBreak":true},{"text":"ab dof sax xam na lu xelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Àtteb dëgg day teral aw xeet,","poem":1},{"lineBreak":true},{"text":"moy di gàcceel aw askan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Buur day bége jawriñ ju xelu,","poem":1},{"lineBreak":true},{"text":"di mbugal nitu gàcce.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}