{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Tont lu neex day giifal,","poem":1},{"lineBreak":true},{"text":"baat bu ñagas di jógal xol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ku xelu àddu, xam-xam rafet;","poem":1},{"lineBreak":true},{"text":"ab dof di talalali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aji Sax ji moo gis lépp,","poem":1},{"lineBreak":true},{"text":"di xool ku baax ak ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wax ju neex mooy garab guy taxa dund,","poem":1},{"lineBreak":true},{"text":"kàddu yu jekkadi di jeexal xol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ab dof day xeeb yaru baay ba,","poem":1},{"lineBreak":true},{"text":"kuy dégg waxi artu, xelu nga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kër ku jub, koom gu yaa;","poem":1},{"lineBreak":true},{"text":"ku jubadi, alalam jur fitna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku xelu àddu, xam-xam law;","poem":1},{"lineBreak":true},{"text":"ab dof amul xelam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Saraxub ku soxor, Aji Sax ji bañ na ko;","poem":1},{"lineBreak":true},{"text":"ñaanu kuy jubal da koy bége.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jëfi ku bon, Aji Sax ji seexlu na ko;","poem":1},{"lineBreak":true},{"text":"ku sàlloo jëf ju baax, safoo na la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mbugal tar na, ñeel ku wacc yoon;","poem":1},{"lineBreak":true},{"text":"ku bañ waxi artu, dangay dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Njaniiw ak biir suuf, Aji Sax ji di gis,","poem":1},{"lineBreak":true},{"text":"xolu doom aadama waxi noppi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kuy ñaawle bëggul ku ko artu,","poem":1},{"lineBreak":true},{"text":"te du laaji ku rafet xel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xol bu sedd, kanam gu leer;","poem":1},{"lineBreak":true},{"text":"xol bu tiis, boroom ne yogg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ku amug dégg sàkku xam-xam,","poem":1},{"lineBreak":true},{"text":"ab dof di toppi caaxaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xol bu tiis, naqar wu sax;","poem":1},{"lineBreak":true},{"text":"xol bu neex, bànneex bu sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Néewle te ragal Aji Sax ji","poem":1},{"lineBreak":true},{"text":"moo gën barele, sa bopp ubu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Njëlu ñetti xob fa ñu la soppe","poem":1},{"lineBreak":true},{"text":"moo dàq yàpp wu duuf fu ñu la bañe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Naqari deret, taalu ay.","poem":1},{"lineBreak":true},{"text":"Teey, fey fitna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yoonu yaafus, dégi neen;","poem":1},{"lineBreak":true},{"text":"kuy jubal, saw xàll yaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Doom rafet xel, baay ba bég;","poem":1},{"lineBreak":true},{"text":"te ab dof ay xeeb ndey ja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jëfi dof a neex ku ñàkk bopp,","poem":1},{"lineBreak":true},{"text":"ku amug dégg def njub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Diisoo ñàkk, pexe sànku;","poem":1},{"lineBreak":true},{"text":"digle yu takku, pexe àntu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nit bége na tontam lu dal,","poem":1},{"lineBreak":true},{"text":"kàddu gu jib fa mu ñoree neex!","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku rafet xel, jubal nga yoonu gudd fan,","poem":1},{"lineBreak":true},{"text":"moyu teggi, ba jëm njaniiw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ku bew, Aji Sax ji màbb sa kër;","poem":1},{"lineBreak":true},{"text":"ab jëtun, Aji Sax ji ñoŋal pàkkam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Aji Sax ji bañ na mébét mu bon,","poem":1},{"lineBreak":true},{"text":"te wax ju yiw daa sell fa moom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Wutin wu lewul, sonal sa waa kër;","poem":1},{"lineBreak":true},{"text":"ku bañ alalu ger gudd fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ku jub day teeylu tontam;","poem":1},{"lineBreak":true},{"text":"ab soxor, wax ju ñaaw rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Aji Sax ji day dëddu ab soxor,","poem":1},{"lineBreak":true},{"text":"di nangu ñaanu ku jub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kanam gu leer day seral xol;","poem":1},{"lineBreak":true},{"text":"xibaaru jàmm, jàmmu yaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kuy dégg artu yu koy musal,","poem":1},{"lineBreak":true},{"text":"ku rafet xel a ngoog.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Xalab waxi yar, fowe sa bopp la;","poem":1},{"lineBreak":true},{"text":"deel déggi artu, yokk sam xel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ragal Aji Sax ji day rafetal xel;","poem":1},{"lineBreak":true},{"text":"jëkke woyof, mujje tedd.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}