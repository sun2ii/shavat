{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Nit ay dogu ci xolam,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji dogal, mu sotti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lu waay def, daa jekk ca moom,","poem":1},{"lineBreak":true},{"text":"waaye Aji Sax jeey natt xol yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Loo bëgga def, diis ko Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"say mébét sotti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lu Aji Sax ji sàkk, mbir la ca namm,","poem":1},{"lineBreak":true},{"text":"ba ci ku soxor ak bésu mbugalam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aji Sax ji sib na ku réy,","poem":1},{"lineBreak":true},{"text":"da koy mbugal ci lu wér.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ku jiital ngor ak worma, Yàlla jéggal la;","poem":1},{"lineBreak":true},{"text":"ku ragal Aji Sax ji, dëddu lu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku Aji Sax ji rafetlu say jëf,","poem":1},{"lineBreak":true},{"text":"say bañ sax, mu jubaleek yaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Néewle te jub","poem":1},{"lineBreak":true},{"text":"moo gën barele te jubadi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nit ay sumb yoonam,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji sottal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Su buur àddoo cib àtte,","poem":1},{"lineBreak":true},{"text":"muy kàddu gu Yàlla dogal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nattub diisaay aki ndabam, na jub ngir Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Moo sàkk mboolem nattukaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Buur daa sib kuy def lu bon,","poem":1},{"lineBreak":true},{"text":"ndax njub mooy dëgëral nguuram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wax ju dëggu, buur safoo boroom;","poem":1},{"lineBreak":true},{"text":"ku jub, buur bëgg sa kàddu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Merum buur ndaw la, dee a ko yónni;","poem":1},{"lineBreak":true},{"text":"ku rafetum xel, giifal ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Buur, na kanam ga leer, sa bakkan mucc,","poem":1},{"lineBreak":true},{"text":"su la baaxee, mu mel ni taw bu toppum nji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wutal xel mu rafet, bàyyi wurus;","poem":1},{"lineBreak":true},{"text":"taamul ag dégg, wacc xaalis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yoonu kuy jubal day moyu lu bon,","poem":1},{"lineBreak":true},{"text":"ku teeylu sa jëfin, sàmm sa bakkan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Réy, yàqule;","poem":1},{"lineBreak":true},{"text":"xeebaate, jóoru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Woyof, ànd ak ku néewle","poem":1},{"lineBreak":true},{"text":"moo gën séddook ku bew la mu lewal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ku teewlu mbir, baaxle;","poem":1},{"lineBreak":true},{"text":"ku wóolu Aji Sax ji, bég.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ki rafet xel mooy kiy ràññee,","poem":1},{"lineBreak":true},{"text":"te su wax rafetee, dég-dég yomb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Xel mu ñaw day suuxat bakkan,","poem":1},{"lineBreak":true},{"text":"te ab dof jëfi dofam a koy yar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ku rafet xel, say kàddu xelu;","poem":1},{"lineBreak":true},{"text":"soo waxee, yey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Wax ju yiw di lem juy xelli,","poem":1},{"lineBreak":true},{"text":"neexa ñam, di jàmmi yaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yoon a ngii, nit defe ne jub na,","poem":1},{"lineBreak":true},{"text":"te mu jëme ko ci dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ku bëgg lu neex, liggéey;","poem":1},{"lineBreak":true},{"text":"ku bëgga faj sab xiif, njaxlaf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sagaru nit mooy sulli lu bon,","poem":1},{"lineBreak":true},{"text":"ay waxam sax sawara la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Nitu njekkar day yokk réeroo,","poem":1},{"lineBreak":true},{"text":"ab soskat di féewaley xarit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ab soxor day yóbbaale dëkkandoom,","poem":1},{"lineBreak":true},{"text":"jëme ko ci lu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Piise, ku nar njekkar;","poem":1},{"lineBreak":true},{"text":"màttu, ku def lu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bijjaawu bopp kaala gu yànj la,","poem":1},{"lineBreak":true},{"text":"topp yoonu njub a koy joxe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Muñ mer, moo gën njàmbaar;","poem":1},{"lineBreak":true},{"text":"tënk sa bakkan moo raw nangub dëkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Tegoo bant nit a koy def,","poem":1},{"lineBreak":true},{"text":"dogal ba Aji Sax ji la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}