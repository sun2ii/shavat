{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Feppu dugub wu ànd ak dal","poem":1},{"lineBreak":true},{"text":"moo gën lu ne gàññ kërug ayoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Surga, bu rafetee xel, tiim doom juy rusloo,","poem":1},{"lineBreak":true},{"text":"séddu ni doom ci alalu sangam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xaalis ak wurus sawaraa koy xelli,","poem":1},{"lineBreak":true},{"text":"waaye nit, ab xolam, Aji Sax jee koy nattu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ku bon ay déglu wax ju bon,","poem":1},{"lineBreak":true},{"text":"fen-kat di teewlu ay sos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuy ñaawal ku ñàkk, tooñ nga Ka ko sàkk;","poem":1},{"lineBreak":true},{"text":"kuy reetaan ku jàq, mbugalam du jaas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Teraangay maam, sët ba;","poem":1},{"lineBreak":true},{"text":"sagu doom, baay ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Waxi teggin jekkul cib dof,","poem":1},{"lineBreak":true},{"text":"ay fen ci as gor waxi noppi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alalu ger njiglaay la ca ka koy joxe,","poem":1},{"lineBreak":true},{"text":"ba fu mu jublu, mu nooy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Baale tooñ, yokk cofeel;","poem":1},{"lineBreak":true},{"text":"sulliw ay, tas xarit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ku amug dégg ngay yedd benn yoon,","poem":1},{"lineBreak":true},{"text":"ab dof téeméeri yar du ko waññi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ku bon fippu doŋŋ lay jéem,","poem":1},{"lineBreak":true},{"text":"te musibaa koy dikkal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Taseek gaynde gu ñàkki doomam","poem":1},{"lineBreak":true},{"text":"moo gën taseek dof ak yëfi dofam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuy feye mbon jëf ju baax,","poem":1},{"lineBreak":true},{"text":"lu bon du jóge sa kër.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ndoortel ay di wal mu tàmbali,","poem":1},{"lineBreak":true},{"text":"luy indib xuloo, bàyyil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dëggal ku sikk, daan ku jub,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji sib na yooyu ñaar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ab dof du am xaalis, jënde xel mu rafet;","poem":1},{"lineBreak":true},{"text":"bëggu ca dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Xarit du bëgg, di bañ;","poem":1},{"lineBreak":true},{"text":"mbokk day bokk ak yaw say coono.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku ñàkk bopp ay dige feyal jàmbur,","poem":1},{"lineBreak":true},{"text":"di ko gàddul boram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ku bëggu ay bëggi tooñ;","poem":1},{"lineBreak":true},{"text":"damu, yàqule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ku njublaŋ du baaxle,","poem":1},{"lineBreak":true},{"text":"kuy wax njekkar añe musiba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku jur ab dof, am naqar;","poem":1},{"lineBreak":true},{"text":"ab dof waajuram du bég.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Xol bu sedd day garabal,","poem":1},{"lineBreak":true},{"text":"xol bu tiis day semmal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ku bon day nangu alalu ger ca suuf,","poem":1},{"lineBreak":true},{"text":"nara jalgati yoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku amug dégg ne jàkk ci xel mu rafet,","poem":1},{"lineBreak":true},{"text":"ab dof ne xóll, xel ma sore lool.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Doom ju dof di tiisu baay ba","poem":1},{"lineBreak":true},{"text":"ak naqaru ndey ja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ku deful dara, feyloo kob daan, dug njub;","poem":1},{"lineBreak":true},{"text":"dóor as gor du yoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ku moom sa làmmiñ am nga xam-xam,","poem":1},{"lineBreak":true},{"text":"te ku teey am ngag dégg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ab dof sax bu noppee, nirook boroom xel;","poem":1},{"lineBreak":true},{"text":"ku ne cell, ñu fooge lag muus.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}