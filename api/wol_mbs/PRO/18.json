{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Ab siis, bànneexu boppam rekk,","poem":1},{"lineBreak":true},{"text":"loo ko digal mu xalab.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ab dof wutul ag dégg,","poem":1},{"lineBreak":true},{"text":"li muy def kay mooy jaay ag muus.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bu mbon nuyoo, xeebeel topp ca;","poem":1},{"lineBreak":true},{"text":"jëf ju ñaaw, gàcce rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waxi nit ndox mu xóot la,","poem":1},{"lineBreak":true},{"text":"bu bënnee, xelli, ñu di ca xelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Faral ku tooñ baaxul,","poem":1},{"lineBreak":true},{"text":"bul xañ dëgg ku deful dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ab dof, làmmiñam sooke naw ay,","poem":1},{"lineBreak":true},{"text":"ay waxam di sàkku yeti gannaaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ab dof, waxam a koy sànk,","poem":1},{"lineBreak":true},{"text":"làmmiñu boppam a koy dugal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waxi jëwkat di ñam wu neex","poem":1},{"lineBreak":true},{"text":"wuy seey, jàll ca biir-a-biir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kuy sàggane sa liggéey,","poem":1},{"lineBreak":true},{"text":"yaak kuy yàq a bokk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Turu Aji Sax ji rawtu bu mag la.","poem":1},{"lineBreak":true},{"text":"Ku jub daw làqu ca, raw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alal day aar boroom ni ab tata,","poem":1},{"lineBreak":true},{"text":"mu foog ne maneesu koo bëtt.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bew, yàqule;","poem":1},{"lineBreak":true},{"text":"jëkke woyof, mujje tedd.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tontu te déggagoo,","poem":1},{"lineBreak":true},{"text":"ndof la, ak ñàkk kersa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ku bëgga dund, dékku woppi yaram,","poem":1},{"lineBreak":true},{"text":"waaye xol bu jeex maneesu koo wéye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ku amug dégg wut xam-xam,","poem":1},{"lineBreak":true},{"text":"ku rafet xel sàkku xam-xam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Deel maye, da lay ubbil bunt,","poem":1},{"lineBreak":true},{"text":"di la àggale ci boroom daraja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku njëkk a layoo, ñu ne yaa yey,","poem":1},{"lineBreak":true},{"text":"ba keroog ka nga joteel weddi la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tegoo bant day feyu ay,","poem":1},{"lineBreak":true},{"text":"di àtte boroom doole yu jote.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jubook mbokk moo tooñ, jéggi tataa ko gëna yomb,","poem":1},{"lineBreak":true},{"text":"mbaa ubbi bunt yu tëje ràpp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Làmmiñ feesal na biiru boroom,","poem":1},{"lineBreak":true},{"text":"yoolu kàddu suur na boroom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dund ak dee a ngi ci làmmiñ,","poem":1},{"lineBreak":true},{"text":"te wax garab la, ku ko bëgg, lekk ca doom ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ku am jabar, am nga ngëneel,","poem":1},{"lineBreak":true},{"text":"am nga yiwu Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ku ñàkk a ngi leewaayu,","poem":1},{"lineBreak":true},{"text":"boroom alal di ko jànni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Barey àndandoo lor a ngi ci,","poem":1},{"lineBreak":true},{"text":"waaye xarit a ngi gëna taq nit mbokkam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}