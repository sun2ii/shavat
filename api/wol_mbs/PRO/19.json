{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Ñàkk te mat,","poem":1},{"lineBreak":true},{"text":"moo gën dof, di wax njekkar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Teeyadi baaxul,","poem":1},{"lineBreak":true},{"text":"ku yàkkamti moy saw yoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nit def na jëfi dof, ba sànku,","poem":1},{"lineBreak":true},{"text":"walbatiku mere Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ku barele, barey xarit;","poem":1},{"lineBreak":true},{"text":"ku ñàkk, sab xarit dagg la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Seede buy fen muccul mbugalam,","poem":1},{"lineBreak":true},{"text":"kuy noyyee ay fen du rëcc àtteem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ñu baree ngi wuta neex boroom daraja,","poem":1},{"lineBreak":true},{"text":"ku nekk a bëgga xaritook kuy joxe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku ñàkk, sa bokk yépp dëddu la,","poem":1},{"lineBreak":true},{"text":"sab xarit gën laa soreeti,","poem":1},{"lineBreak":true},{"text":"ngay wax ak ñoom, dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kuy sàkku xel, bëgg nga sa bopp;","poem":1},{"lineBreak":true},{"text":"kuy wut ag dégg day baaxle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Seede buy fen muccul mbugalam,","poem":1},{"lineBreak":true},{"text":"kuy noyyee ay fen, mujje sànku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dund gu neex jekkul cib dof,","poem":1},{"lineBreak":true},{"text":"surga buy jiite kilifa it moo yées.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ku xam lu jaadu, muñ mer,","poem":1},{"lineBreak":true},{"text":"tanqamlu ku la tooñ ngay damoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Merum buur ni gaynde gu ŋar;","poem":1},{"lineBreak":true},{"text":"yërmandey buur ni lay cig mbooy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Doom ju dof naqaru baay baa,","poem":1},{"lineBreak":true},{"text":"te jabar ju pànk mooy senn bu dakkul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kër ak alal ngay donne ci baay;","poem":1},{"lineBreak":true},{"text":"jabar ju xelu, Aji Sax jee koy maye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ab yaafus, nelaw yu xóot,","poem":1},{"lineBreak":true},{"text":"te ku yàccaaral xiif.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ku jëfe ndigal, sàmm sa bakkan;","poem":1},{"lineBreak":true},{"text":"ku moytuwul sa bopp, dangay dee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku baaxe ku ñàkk, lebal nga Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te moo lay yool.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yaral sa doom ba muy teel,","poem":1},{"lineBreak":true},{"text":"waaye bul topp sa xol, ba rey ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ku naqari deret, sonal nga sa bopp;","poem":1},{"lineBreak":true},{"text":"ku la xettali, tóllanti ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Déggal ndigal te yaru,","poem":1},{"lineBreak":true},{"text":"ndax ëllëg nga xelu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bare na lu xol di mébét,","poem":1},{"lineBreak":true},{"text":"waaye Aji Sax jeey dogal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Li ñu sopp ci nit mooy ngor,","poem":1},{"lineBreak":true},{"text":"néewle moo gën fen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ragalal Aji Sax ji ndax nga gudd fan,","poem":1},{"lineBreak":true},{"text":"noppalu te baña loru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ab yaafus day yeb loxoom ci ndab,","poem":1},{"lineBreak":true},{"text":"tàyyi ko yékkati, sex.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Boo ñefee ab ñaawlekat, téxét ba jànge ca;","poem":1},{"lineBreak":true},{"text":"nga yedd kuy dégg, mu xame ca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kuy yàqal sa baay, di dàq sa ndey,","poem":1},{"lineBreak":true},{"text":"yaay indi gàcceek yeraange.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Doom, soo noppee déglu ku lay yar,","poem":1},{"lineBreak":true},{"text":"sore nga kàdduy xam-xam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Seedeb naaféq faalewul yoon,","poem":1},{"lineBreak":true},{"text":"ab soxor lu bon lay tàqamtikoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Na ñaawlekat bi séentu mbugal;","poem":1},{"lineBreak":true},{"text":"ab dof, yeti gannaaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}