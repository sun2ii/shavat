{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["Muus, mucc"]},{"type":"verse","number":1,"content":[{"text":"Sama doom, déggal samay wax,","poem":1},{"lineBreak":true},{"text":"fonk samay santaane.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Teewlul xel mu rafet,","poem":1},{"lineBreak":true},{"text":"sam xel di dégg.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ngalla wutala dégg,","poem":1},{"lineBreak":true},{"text":"wool dég-dég wall.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sàkkul xel mu rafet ni xaalis,","poem":1},{"lineBreak":true},{"text":"wut ko ni alal ju làqu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kon nga xam luy ragal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"xam Yàllaa di kan;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ndax Aji Sax jeey maye xel mu rafet,","poem":1},{"lineBreak":true},{"text":"kàddoom di taxa xam, di dégg.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Day dencalal ndam kiy jubal,","poem":1},{"lineBreak":true},{"text":"di yiir ku mat.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Day wattu ku jub fu mu jaare,","poem":1},{"lineBreak":true},{"text":"di sàmm wóllëreem ciw yoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kon nga xam njub ak yoon,","poem":1},{"lineBreak":true},{"text":"xam jubal ak mboolem yoonu mbaax.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndax xel mu rafet miy tàbbi sa xol,","poem":1},{"lineBreak":true},{"text":"nga xam, sa xol tooy,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"nga foog, fegu,","poem":1},{"lineBreak":true},{"text":"amug dégg, raw,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"mucc ci yoonu ku bon","poem":1},{"lineBreak":true},{"text":"ak kuy wax lu jekkadi,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mucc ci kuy wacc yoonu njub,","poem":1},{"lineBreak":true},{"text":"di jaare mbedd yu lëndëm.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kon nga mucc ci kuy def lu bon,","poem":1},{"lineBreak":true},{"text":"tey bànneexoo lu jekkadi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yoonu ku ni mel day lunk,","poem":1},{"lineBreak":true},{"text":"jaaruwaayam dëng.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xel mu rafet da lay musal ci jigéenu njaalookat,","poem":1},{"lineBreak":true},{"text":"bokk feneen, di wax lu neex.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Day dëddu wóllëreem, ba muy ndaw,","poem":1},{"lineBreak":true},{"text":"fàtte kóllëreem ak Yàllaam.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Këram day joy wuti dee,","poem":1},{"lineBreak":true},{"text":"ay jaaruwaayam jëm njaniiw.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ku dem ca moom dootoo délsi,","poem":1},{"lineBreak":true},{"text":"doo gisati yoonu dund mukk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kon nag aweel mbeddum waa ju baax,","poem":1},{"lineBreak":true},{"text":"toppal yoonu defkatu njekk,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ndax kuy jubal ay dëkke réew mi,","poem":1},{"lineBreak":true},{"text":"te ku mat a fiy des.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ku bon, ñu génne réew mi;","poem":1},{"lineBreak":true},{"text":"kuy fecci worma, ñu buddi, sànni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}