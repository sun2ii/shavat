{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Naan biiñ ak ñaawle, naan ñoll, tanqale,","poem":1},{"lineBreak":true},{"text":"ku mu nax xeluwoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Buur mer lool, mel ni gayndee ŋar;","poem":1},{"lineBreak":true},{"text":"boo ko merloo, dangay xaru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Moytuw ay, ndam la;","poem":1},{"lineBreak":true},{"text":"dof boo gis day bëgg xuloo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ab yaafus du gàbb ba mu jotee,","poem":1},{"lineBreak":true},{"text":"day wut am ngóob, du am dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mébétu jàmbur day teen bu xóot,","poem":1},{"lineBreak":true},{"text":"ku amug dégg a cay root.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ñu baree ngi naa: «Gore naa,»","poem":1},{"lineBreak":true},{"text":"waaye kuy boroom kóllëre dëgg?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku jub, di jëfeg mat,","poem":1},{"lineBreak":true},{"text":"doom ju la wuutu bég na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Su buur toogee di àtte,","poem":1},{"lineBreak":true},{"text":"day gis, di ràññee mboolem ayib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ana ku man ne fóot na xolam,","poem":1},{"lineBreak":true},{"text":"ba tàggook bàkkaar?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nattu diisaay yu yemul ak lu ni mel,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji bañ na ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gone sax day jëf, nga gis jikkoom;","poem":1},{"lineBreak":true},{"text":"bu naree dëggu te jub, nga xam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nopp buy dégg ak bët buy gis,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee sàkk lu ci nekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bul bëggi nelaw, ba ñàkk dab la;","poem":1},{"lineBreak":true},{"text":"boo njaxlafee, lekk ba desal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kuy waxaalee ngi naan: «Baaxul de!»","poem":1},{"lineBreak":true},{"text":"Bu nee wërëñ, di damu naan: «Aka jar!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wurus am na ak gànjar yu bare,","poem":1},{"lineBreak":true},{"text":"waaye kàdduy xam-xam a gën per yu jafe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ku gàddul jàmbur bor, jëlal mbubbam;","poem":1},{"lineBreak":true},{"text":"tayle ko, moo dige feyal jàmbur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Njublaŋ, lekk, jëkke neex,","poem":1},{"lineBreak":true},{"text":"mujj mel ni lancub suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pexe, ndigal a koy lal;","poem":1},{"lineBreak":true},{"text":"xare, ay tegtal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kuy wër di jëw, wuññi sutura;","poem":1},{"lineBreak":true},{"text":"ku réy làmmiñ, bul déeyook moom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ku saaga sa ndey mbaa sa baay","poem":1},{"lineBreak":true},{"text":"añe lëndëmu bàmmeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Alal ju gaaw","poem":1},{"lineBreak":true},{"text":"du mujje barkeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bul feyantook ku la tooñ;","poem":1},{"lineBreak":true},{"text":"dénkul ci Aji Sax ji, mu wallu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Aji Sax ji bañ na nattu diisaay yu wuute,","poem":1},{"lineBreak":true},{"text":"njublaŋ ci natti diisaay baaxul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Jéegoy jaam Aji Sax jee ko yor,","poem":1},{"lineBreak":true},{"text":"kenn xamul foo jëm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bul gaawtuy digeek Yàlla, di dugal sa bopp;","poem":1},{"lineBreak":true},{"text":"bul giñ, di réccu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Buur, bu xeloo, ràññee ku bon,","poem":1},{"lineBreak":true},{"text":"mbugal ko, te du ko ñéeblu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Xelum nit làmp la bu Aji Sax ji taal,","poem":1},{"lineBreak":true},{"text":"da koy niital ba ca biir xolam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ngor ak worma day aar buur,","poem":1},{"lineBreak":true},{"text":"ngor ay saxal ab jalam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sagu ndaw, doole ja;","poem":1},{"lineBreak":true},{"text":"gànjaru mag, bijjaaw ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Dóor yu la gaañ faj na sag mbon,","poem":1},{"lineBreak":true},{"text":"ay yar fóot na xolu boroom.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}