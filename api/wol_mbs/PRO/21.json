{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Xolu buur walum ndox la ci loxol Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"fu ko soob mu jëme ko fa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lu waay def, daa jub ca moom,","poem":1},{"lineBreak":true},{"text":"waaye Aji Sax jeey natt xol yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Deel def dëgg ak lu jub,","poem":1},{"lineBreak":true},{"text":"moo gënal Aji Sax ji ab sarax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xeebaateek réy-réylu","poem":1},{"lineBreak":true},{"text":"mooy bàkkaar yi ñuy ràññee ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Farlu, woomle;","poem":1},{"lineBreak":true},{"text":"ku gaawtu, mujj néewle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alal ju la fen may,","poem":1},{"lineBreak":true},{"text":"cóolóol la, day naaw, wut ko xaru la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Coxor day sànk boroom,","poem":1},{"lineBreak":true},{"text":"ndax day baña def njub.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ab saay-saay day dëngal,","poem":1},{"lineBreak":true},{"text":"nit ku dëggu di jubal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dëkkeb ruq cim sàq","poem":1},{"lineBreak":true},{"text":"moo gën jabar ju pànk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ab soxor day namma lore,","poem":1},{"lineBreak":true},{"text":"te du yërëm moroomam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Boo mbugalee kuy ñaawle, ab téxét jànge ca;","poem":1},{"lineBreak":true},{"text":"nga jàngal ku rafet xel, mu yokku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aji Jub ji Yàlla xam na la ne ca biir kër ku bon,","poem":1},{"lineBreak":true},{"text":"te mooy sànk ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ku tanqamlu jooyi ku ñàkk","poem":1},{"lineBreak":true},{"text":"dina woote wall, wall ñàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ku mer, may ko ci sutura, mu giif;","poem":1},{"lineBreak":true},{"text":"boroom xadar, boqal ko neexal, mu dal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bu yoon amee, ku jub bég;","poem":1},{"lineBreak":true},{"text":"kuy def lu bon jàq.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ku noppee jëfe xel,","poem":1},{"lineBreak":true},{"text":"noppaluji njaniiw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku topp sa bànneex, mujje ñàkk;","poem":1},{"lineBreak":true},{"text":"ku sopp biiñ ak lu niin du woomle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku bon këppoo ayu ku baax,","poem":1},{"lineBreak":true},{"text":"workat gàddu musibam kuy jubal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dëkke ndànd-foyfoy","poem":1},{"lineBreak":true},{"text":"moo gën jabar ju tàng, bare ay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ku xelu denc këram ngëneeli alal aku diw,","poem":1},{"lineBreak":true},{"text":"ab dof saax-saaxee josam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku saxoo njekk ak ngor,","poem":1},{"lineBreak":true},{"text":"am fan wu gudd, naataangeek daraja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ku ñaw mana daan jàmbaari dëkk bu mag,","poem":1},{"lineBreak":true},{"text":"ba màbb tata ja ñu yaakaaroon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ub sa gémmiñ, moom sa làmmiñ,","poem":1},{"lineBreak":true},{"text":"mucc ci njàqare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku réy te bew, mooy ñaawle,","poem":1},{"lineBreak":true},{"text":"day reew, ba jéggi dayo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ab yaafus day bëgg lu mu amul ba dee,","poem":1},{"lineBreak":true},{"text":"ndax du nangoo liggéey,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"day yendoo xemmem, te du am;","poem":1},{"lineBreak":true},{"text":"kay jëfe njekk di joxeeka joxewaat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Saraxu nit ku bon ñaawtéef la,","poem":1},{"lineBreak":true},{"text":"rawatina bu ci jubloo lu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Seede buy fen day sànku,","poem":1},{"lineBreak":true},{"text":"kuy dégg, sa kàddu sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ku bon day ñeme-ñemelu,","poem":1},{"lineBreak":true},{"text":"ku jub la muy def da koy wóor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nit xeluwul, amulug dégg ak pexe,","poem":1},{"lineBreak":true},{"text":"ba manal Aji Sax ji dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nit ay takk, bésub xare,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji di maye ndam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}