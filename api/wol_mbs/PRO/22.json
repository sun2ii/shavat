{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Jëw bu rafet a gën barele,","poem":1},{"lineBreak":true},{"text":"wegeel gën xaalis ak wurus.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ku am ak ku ñàkk a bokk lenn:","poem":1},{"lineBreak":true},{"text":"Aji Sax jee leen boole sàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuy foog, gisu ay, làqu;","poem":1},{"lineBreak":true},{"text":"ab téxét ne ca tëñëx, loru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Woyofal te ragal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"am alal, gudd fan ak daraja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yoonu njublaŋ, ay dég aki fiir;","poem":1},{"lineBreak":true},{"text":"ku sàmm sa bakkan sore ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tegal gone ciw yoon;","poem":1},{"lineBreak":true},{"text":"ba bu màggee, du ko wacc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku am ay yilif ku ñàkk,","poem":1},{"lineBreak":true},{"text":"koo leb di surgaam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku ji njubadi, góob fitna,","poem":1},{"lineBreak":true},{"text":"yet wa muy dóore, damm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ku tabe am barke,","poem":1},{"lineBreak":true},{"text":"mooy kiy sédd ku ñàkk cib dundam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dàqal kuy ñaawle, ay jeex;","poem":1},{"lineBreak":true},{"text":"xulooki saaga dakk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ku dëggu, wax ja yiw,","poem":1},{"lineBreak":true},{"text":"buur di xaritam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aji Sax jeey sàmm liy dëgg,","poem":1},{"lineBreak":true},{"text":"di weddi waxi fen-kat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bul yaafus, ba naan: «Gayndee ngi ci biti,","poem":1},{"lineBreak":true},{"text":"dañu may rey ci mbedd mi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Waxi jigéenu njaalookat am yeer la,","poem":1},{"lineBreak":true},{"text":"ku Aji Sax ji rëbb moo cay tàbbi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yëfi dof daa sax ci xolu gone,","poem":1},{"lineBreak":true},{"text":"boo bantalee, mu tàggook moom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Noot néew-ji-doole ngir yokkule,","poem":1},{"lineBreak":true},{"text":"mbaa may boroom alal,","poem":1},{"lineBreak":true},{"text":"loo ci def mu wàññi la.","poem":1}]},{"type":"heading","content":["Fanweeri tegtal a ngii"]},{"type":"verse","number":17,"content":[{"text":"Teewlul te déglu li boroom xel yi wax.","poem":1},{"lineBreak":true},{"text":"Defal sam xel ci li ma lay xamal.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Soo mokkalee, ba man koo tari,","poem":1},{"lineBreak":true},{"text":"muy sa mbégte.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yaw laa koy xamal tey jii,","poem":1},{"lineBreak":true},{"text":"ndax nga wóolu Aji Sax ji.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dama laa bindal fanweeri dénkaane,","poem":1},{"lineBreak":true},{"text":"ci wàllu ndigal ak xam-xam,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ngir xamal la lu wér te dëggu,","poem":1},{"lineBreak":true},{"text":"nga yóbbaale kàdduy dëgg,","poem":1},{"lineBreak":true},{"text":"yoo tontoo ña la yebal.","poem":1}]},{"type":"heading","content":["[1]"]},{"type":"verse","number":22,"content":[{"text":"Bul xañ néew-ji-doole ndax li muy néew-ji-doole.","poem":1},{"lineBreak":true},{"text":"Ku tumurànke, bu ko soxore cib àtte,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aji Sax ji da koy taxawu,","poem":1},{"lineBreak":true},{"text":"ku ko xañ, mu xañ la bakkan.","poem":1}]},{"type":"heading","content":["[2]"]},{"type":"verse","number":24,"content":[{"text":"Bul xaritook ku gaawa mer,","poem":1},{"lineBreak":true},{"text":"bul ànd ak ku tàng bopp.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lu ko moy nga mel ni moom,","poem":1},{"lineBreak":true},{"text":"te kon nga lonku.","poem":1}]},{"type":"heading","content":["[3]"]},{"type":"verse","number":26,"content":[{"text":"Bul bokk ci ñiy dige,","poem":1},{"lineBreak":true},{"text":"di gàddul nit bor.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Soo amul loo ko feyale,","poem":1},{"lineBreak":true},{"text":"ñu yékkatee la sab lal, nangu ko.","poem":1}]},{"type":"heading","content":["[4]"]},{"type":"verse","number":28,"content":[{"text":"Bul toxal màndargam cosaan ci làccu suuf","poem":1},{"lineBreak":true},{"text":"te say maam tegoon ko fa démb.","poem":1}]},{"type":"heading","content":["[5]"]},{"type":"verse","number":29,"content":[{"text":"Seetlul ku man liggéeyam,","poem":1},{"lineBreak":true},{"text":"buur lay liggéeyal,","poem":1},{"lineBreak":true},{"text":"du liggéeyal baadoolo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}