{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":23,"content":[{"type":"heading","content":["[6]"]},{"type":"verse","number":1,"content":[{"text":"Soo bokkeek kilifa ndab,","poem":1},{"lineBreak":true},{"text":"xamal bu baax ni ngay lekke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Soo dee ku bëgg lekk,","poem":1},{"lineBreak":true},{"text":"téyeel sa loxo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bul xemmem daraam lu neex,","poem":1},{"lineBreak":true},{"text":"ñam woowu la lay naxe.","poem":1}]},{"type":"heading","content":["[7]"]},{"type":"verse","number":4,"content":[{"text":"Bul rey sa bopp ci wut alal,","poem":1},{"lineBreak":true},{"text":"bu ko xalaat sax.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndax xef ak xippi mu wéy,","poem":1},{"lineBreak":true},{"text":"mel ni lu saxi laaf,","poem":1},{"lineBreak":true},{"text":"ne fëyy, naaw ni jaxaay.","poem":1}]},{"type":"heading","content":["[8]"]},{"type":"verse","number":6,"content":[{"text":"Ab nay, bul lekke këram,","poem":1},{"lineBreak":true},{"text":"bul xemmem daraam lu neex.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma ngay xool la ngay lekk, nu mu tollu,","poem":1},{"lineBreak":true},{"text":"naan la: «Lekkal, naanal!»","poem":1},{"lineBreak":true},{"text":"Te xol ba àndu ca.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndog soo ca lekk, waccu ko,","poem":1},{"lineBreak":true},{"text":"yiw woo ko wax daldi neen.","poem":1}]},{"type":"heading","content":["[9]"]},{"type":"verse","number":9,"content":[{"text":"Bul wax akub dof,","poem":1},{"lineBreak":true},{"text":"day xeeb sam xel.","poem":1}]},{"type":"heading","content":["[10]"]},{"type":"verse","number":10,"content":[{"text":"Bul toxal màndargam cosaan ci làccu suuf,","poem":1},{"lineBreak":true},{"text":"bul aakimoo suufas jirim.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ki koy aar màgg na,","poem":1},{"lineBreak":true},{"text":"da koy taxawu, dal ci sa kaw.","poem":1}]},{"type":"heading","content":["[11]"]},{"type":"verse","number":12,"content":[{"text":"Defal sam xel ci yar,","poem":1},{"lineBreak":true},{"text":"te teewlu kàdduy xam-xam.","poem":1}]},{"type":"heading","content":["[12]"]},{"type":"verse","number":13,"content":[{"text":"Bul ñéebloo yar gone,","poem":1},{"lineBreak":true},{"text":"bantal ko taxu koo dee.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Soo ko bantalee,","poem":1},{"lineBreak":true},{"text":"mu mana mucc.","poem":1}]},{"type":"heading","content":["[13]"]},{"type":"verse","number":15,"content":[{"text":"Sama doom, soo xeloo,","poem":1},{"lineBreak":true},{"text":"sama xol neex.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ngay wax njub,","poem":1},{"lineBreak":true},{"text":"ma bég.","poem":1}]},{"type":"heading","content":["[14]"]},{"type":"verse","number":17,"content":[{"text":"Bul ñee bàkkaarkat,","poem":1},{"lineBreak":true},{"text":"saxool ragal Aji Sax ji,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ndax kat moo am muj,","poem":1},{"lineBreak":true},{"text":"te kon sa yaakaar du tas.","poem":1}]},{"type":"heading","content":["[15]"]},{"type":"verse","number":19,"content":[{"text":"Déglul, doom, muusal","poem":1},{"lineBreak":true},{"text":"te yebu ci yoonu njub.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bul bokk ci ñiy lekk lu ëpp","poem":1},{"lineBreak":true},{"text":"aka màndi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ndax ku bëgg lekk aka màndi, ñàkk dab la,","poem":1},{"lineBreak":true},{"text":"dajjant it, rafle rekk.","poem":1}]},{"type":"heading","content":["[16]"]},{"type":"verse","number":22,"content":[{"text":"Déglul sa baay bi la jur.","poem":1},{"lineBreak":true},{"text":"Bu sa ndey màggatee, bu ko sàggane.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Jëndal dëgg te bu ko jaay.","poem":1},{"lineBreak":true},{"text":"Sàkkul xel mu rafet ak yar akug dégg.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Su doom jubee, seral xolu baay.","poem":1},{"lineBreak":true},{"text":"Boo juree ku rafet xel, am nga bànneex.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Deel bégal ndey ak baay,","poem":1},{"lineBreak":true},{"text":"rawatina ndey ji la jur.","poem":1}]},{"type":"heading","content":["[17]"]},{"type":"verse","number":26,"content":[{"text":"Doom, teewloo ma xel te roy ma.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ab gànc yeer mu xóot la,","poem":1},{"lineBreak":true},{"text":"jabaru jàmbur di teen bu xat.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ma ngay tëroo nib sàcc,","poem":1},{"lineBreak":true},{"text":"góor ñu bare lay fecciloo worma.","poem":1}]},{"type":"heading","content":["[18]"]},{"type":"verse","number":29,"content":[{"text":"Ana kuy tiislu, naan: «Wóoy, ngalla man!»","poem":1},{"lineBreak":true},{"text":"Ana kuy xulooka jàmbat,","poem":1},{"lineBreak":true},{"text":"di gaañu ci dara,","poem":1},{"lineBreak":true},{"text":"bët ya xonq curr?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Xanaa kiy naan-naane biiñ,","poem":1},{"lineBreak":true},{"text":"di mosi yeneen njafaan?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bul xool biiñ ak xonqaayam.","poem":1},{"lineBreak":true},{"text":"Aka yànj cib kaas","poem":1},{"lineBreak":true},{"text":"te neexa jolu!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bu weesoo mu màtt la ni jaan,","poem":1},{"lineBreak":true},{"text":"ne la càppit ni ñàngóor.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Dangay mel ni kuy gis lu doy waar,","poem":1},{"lineBreak":true},{"text":"sam xel di ràbb lu jekkadi.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Nga mel ni ku tëdd biir géej,","poem":1},{"lineBreak":true},{"text":"di jaayu ca biir gaal ga,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"nga naan: «Dañu maa dóor te gaañuwuma,","poem":1},{"lineBreak":true},{"text":"duma ma te yéguma ko.","poem":1},{"lineBreak":true},{"text":"Moo! Duma yewwu nag,","poem":1},{"lineBreak":true},{"text":"ba naaneeti?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}