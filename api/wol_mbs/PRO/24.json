{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"heading","content":["[19]"]},{"type":"verse","number":1,"content":[{"text":"Bul ñee ku bon,","poem":1},{"lineBreak":true},{"text":"bul wuta ànd ak moom,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ndax coxor lay nas ci xolam,","poem":1},{"lineBreak":true},{"text":"te fitna la ay waxam di yee.","poem":1}]},{"type":"heading","content":["[20]"]},{"type":"verse","number":3,"content":[{"text":"Xel mu rafet ay tabax kër,","poem":1},{"lineBreak":true},{"text":"rafet déggin a koy samp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xam-xam ay feesal néeg ya","poem":1},{"lineBreak":true},{"text":"ak mboolem alal ju jafe te yànj.","poem":1}]},{"type":"heading","content":["[21]"]},{"type":"verse","number":5,"content":[{"text":"Ku rafet xel di boroom doole,","poem":1},{"lineBreak":true},{"text":"ku xam, gëna man;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"tegtal yu xelu lañuy xaree,","poem":1},{"lineBreak":true},{"text":"diisoo bu yaatooy maye ndam.","poem":1}]},{"type":"heading","content":["[22]"]},{"type":"verse","number":7,"content":[{"text":"Wax ju xelu sut nab dof,","poem":1},{"lineBreak":true},{"text":"jataayu pénc du fa àddoo.","poem":1}]},{"type":"heading","content":["[23]"]},{"type":"verse","number":8,"content":[{"text":"Kuy mébét lu bon,","poem":1},{"lineBreak":true},{"text":"ñu ne yaay rambaaj bi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pexem dof bàkkaar la,","poem":1},{"lineBreak":true},{"text":"te kuy ñaawle, ñu sib la.","poem":1}]},{"type":"heading","content":["[24]"]},{"type":"verse","number":10,"content":[{"text":"Bu mettee, nga yoqi,","poem":1},{"lineBreak":true},{"text":"sa doolee néew.","poem":1}]},{"type":"heading","content":["[25]"]},{"type":"verse","number":11,"content":[{"text":"Wallul ku ñuy reyi te tooñul,","poem":1},{"lineBreak":true},{"text":"xettalil kuy tërëf, ñu di ko reyi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Soo nee sa yoon nekku ci it,","poem":1},{"lineBreak":true},{"text":"kiy natt xol yi, xam na,","poem":1},{"lineBreak":true},{"text":"moom miy wattu sa bakkan, xam na,","poem":1},{"lineBreak":true},{"text":"te kat mooy fey nit jëfam.","poem":1}]},{"type":"heading","content":["[26]"]},{"type":"verse","number":13,"content":[{"text":"Doom, deel lekk lem, baax na,","poem":1},{"lineBreak":true},{"text":"lem ju xelli, boo sexee, mu tem-temi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xamal ne xel mu rafet ni la neexe;","poem":1},{"lineBreak":true},{"text":"soo xeloo, sa muj rafet,","poem":1},{"lineBreak":true},{"text":"te sa yaakaar du tas.","poem":1}]},{"type":"heading","content":["[27]"]},{"type":"verse","number":15,"content":[{"text":"Soxor bi, bul tëru boroom njekk ci këram,","poem":1},{"lineBreak":true},{"text":"bul yàq dëkkuwaayam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Boroom njekk day daanu juróom ñaari yoon, jógaat,","poem":1},{"lineBreak":true},{"text":"ab soxor sërëx ci njekkar.","poem":1}]},{"type":"heading","content":["[28]"]},{"type":"verse","number":17,"content":[{"text":"Bu sab noon daanoo, bu ko bànneexoo,","poem":1},{"lineBreak":true},{"text":"bu tërëfee, bu ko bége.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lu ko moy Aji Sax ji gis la, ñaawlu ko,","poem":1},{"lineBreak":true},{"text":"daldi giif, dootu ko mbugal.","poem":1}]},{"type":"heading","content":["[29]"]},{"type":"verse","number":19,"content":[{"text":"Bu sa xol tàng ci ku bon,","poem":1},{"lineBreak":true},{"text":"bul ñee ku soxor.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ku bon amul muj,","poem":1},{"lineBreak":true},{"text":"ku soxor day mel ni taal bu fey.","poem":1}]},{"type":"heading","content":["[30]"]},{"type":"verse","number":21,"content":[{"text":"Doom, ragalal Aji Sax ji, wormaal buur.","poem":1},{"lineBreak":true},{"text":"Bul lëngook kuy fippu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yàllaak buur a koy bette mbugal,","poem":1},{"lineBreak":true},{"text":"te kenn xamul musiba mu muy doon.","poem":1}]},{"type":"heading","content":["Yeneen tegtal a ngii"]},{"type":"verse","number":23,"content":[{"text":"Lii it ñi rafet xel a ko wax.","poem":1},{"lineBreak":true},{"text":"Par-parloo cib àtte baaxul.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ku ne defkatu lu bon: «Yaw, tooñoo,»","poem":1},{"lineBreak":true},{"text":"aw nit móolu la, mbooloo ŋàññ la;","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ku ko ne: «Yaa tooñ,» yaay baaxle,","poem":1},{"lineBreak":true},{"text":"taasoo barke bu yaa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ki lay wax dëgg","poem":1},{"lineBreak":true},{"text":"sa soppe la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ruujal sab tool, ji ko,","poem":1},{"lineBreak":true},{"text":"doora tabax sa kër.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bul tuumaal nit ci neen,","poem":1},{"lineBreak":true},{"text":"te bu ko seedeel ay fen.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bul ne: «Li mu ma def laa koy def,","poem":1},{"lineBreak":true},{"text":"damay feyu li mu ma def.»","poem":1}]},{"type":"heading","content":["Yaafus amul njariñ"]},{"type":"verse","number":30,"content":[{"text":"Toolub ku yaafus laa jaare,","poem":1},{"lineBreak":true},{"text":"ak tóokërub nit ku ñàkk bopp.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ndeke lépp a nga saxi dég,","poem":1},{"lineBreak":true},{"text":"fépp fees akum ñax,","poem":1},{"lineBreak":true},{"text":"tabaxu doj ba ko wër màbb.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Maa ko gis, di xalaat,","poem":1},{"lineBreak":true},{"text":"xoolaat ko, jànge ca.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Booy dajjant aka for bët,","poem":1},{"lineBreak":true},{"text":"di tegley loxooka jaaxaan,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"néewlee ngi lay dikkal nib sàcc,","poem":1},{"lineBreak":true},{"text":"ñàkk gànnaayul la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}