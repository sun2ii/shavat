{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Lii it ay kàddu yu xelu la, di yu Suleymaan, ay niti Esekiyas buurub Yuda sotti ko."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Màggug Yàllaa ngi ci li mu làq,","poem":1},{"lineBreak":true},{"text":"darajay buur a ngi ci li mu feeñal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maneesula daj li ci xelu buur,","poem":1},{"lineBreak":true},{"text":"xalaatam daa kawe ni asamaan, xóote ni suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xellil xaalis, tonni lu ca rax,","poem":1},{"lineBreak":true},{"text":"ba ab tëgg man caa am ndab.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ab soxor it, dàqal, mu sore buur,","poem":1},{"lineBreak":true},{"text":"ngir njubte law, jalam sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bul réy-réylu fi kanam buur,","poem":1},{"lineBreak":true},{"text":"bul tooge jataayu boroom daraja,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ndax ñu ne la: «Yéegal, jegesi fii,»","poem":1},{"lineBreak":true},{"text":"moo gën ñu toroxal la ci kanam kilifa.","poem":1},{"lineBreak":true},{"text":"Boo gisalee sa bopp it,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"bul gaawa layooji,","poem":1},{"lineBreak":true},{"text":"ana nooy def ëllëg, bu ñu la yeyee?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ñaarool ak ki nga joteel,","poem":1},{"lineBreak":true},{"text":"te bul jéebaane jàmbur.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lu ko moy ñu dégg ko, rusloo la,","poem":1},{"lineBreak":true},{"text":"sab der yàqu yaxeet.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wax ju ñor di nataalu wurus","poem":1},{"lineBreak":true},{"text":"wu tege ci xaalis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kàddu yu lay yedd ci kuy dégg,","poem":1},{"lineBreak":true},{"text":"jaarob wurus la mbaa gànjaru ngalam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndaw lu wóor day seral xolu njaatigeem,","poem":1},{"lineBreak":true},{"text":"mooy ndox mu sedd ci tàngooru ngóob.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kuy dige te doo joxe,","poem":1},{"lineBreak":true},{"text":"yaay xiin wu ngelaw, mu naaxsaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Muñ mer ay nax kilifa,","poem":1},{"lineBreak":true},{"text":"te wax ju neex, fu mu jaar, mu nooy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Boo gisee lem, lekkal lu yem;","poem":1},{"lineBreak":true},{"text":"bu ëppee, nga waccu ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Na sa tànk di gëj kër dëkkandoo;","poem":1},{"lineBreak":true},{"text":"boo ko sàppee, mu jéppi la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku seedeel sa moroom ay fen,","poem":1},{"lineBreak":true},{"text":"yen nga ko aw njur mbaa saamar mbaa fitt.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bul wóolu workat bésub njàqare,","poem":1},{"lineBreak":true},{"text":"mooy bëñ bu bon mbaa tànk bu nasax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kuy woy, boroom tiisu xol di dégg,","poem":1},{"lineBreak":true},{"text":"yaa futti mbubbam cib sedd,","poem":1},{"lineBreak":true},{"text":"mbaa nga jonj xorom ci góomam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bu sab noon xiifee, jox ko mu lekk,","poem":1},{"lineBreak":true},{"text":"bu maree, may ko mu naan,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"day rus ba mel ni koo yeni xal,","poem":1},{"lineBreak":true},{"text":"te Aji Sax jee lay fey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Jëw, mer a cay topp;","poem":1},{"lineBreak":true},{"text":"mooy ngelawal taw, taw a cay topp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dëkkeb ruq cim sàq","poem":1},{"lineBreak":true},{"text":"moo gën jabar ju pànk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Xibaaru jàmm, bawoo fu sore","poem":1},{"lineBreak":true},{"text":"mooy ndox mu sedd ci ku loof.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ku jub bu dee nangul ku bon, yàqu na,","poem":1},{"lineBreak":true},{"text":"ni seyaan bu nëx mbaa teen bu xàbb.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Lekk lem ju ëpp baaxul,","poem":1},{"lineBreak":true},{"text":"te wut waaw-góor du ngóora.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ku dul ànd ak sa sago,","poem":1},{"lineBreak":true},{"text":"yaa neexa song ni dëkk bu dara wërul.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}