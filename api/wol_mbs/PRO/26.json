{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":26,"content":[{"type":"heading","content":["Ràññeel ab dof"]},{"type":"verse","number":1,"content":[{"text":"Teraanga jekkul cib dof,","poem":1},{"lineBreak":true},{"text":"mooy seddub nawet mbaa taw cim ngóob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ñaan-yàlla, soo tooñul, du la dal,","poem":1},{"lineBreak":true},{"text":"day mel ni picc muy naaw, tëë toŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xiir, aw fas; laab, mbaam;","poem":1},{"lineBreak":true},{"text":"yetu gannaaw, ab dof.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bul topp ab dof cig ndofam,","poem":1},{"lineBreak":true},{"text":"lu ko moy nga mel ni moom.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waaye toppal ab dof cig ndofam,","poem":1},{"lineBreak":true},{"text":"lu ko moy mu defe ne daa muus.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ku yóbbante ab dof kàddu,","poem":1},{"lineBreak":true},{"text":"yaa woo fitna, gor say tànk.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kàddu gu xelu ci gémmiñug dof,","poem":1},{"lineBreak":true},{"text":"mooy tànki lafañ, amalu ko njariñ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuy teral ab dof,","poem":1},{"lineBreak":true},{"text":"jël ngaw doj, takk ko ci mbaq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kàddu gu xelu ci gémmiñug dof","poem":1},{"lineBreak":true},{"text":"mooy car aki dégam, màndikat xàcc.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Njaatige luy liggéeyloo ab dof ak kuy romb,","poem":1},{"lineBreak":true},{"text":"daa mel ni fittkat buy gaañ ku ne.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dof day def jëfi dof, dellu ca,","poem":1},{"lineBreak":true},{"text":"mooy xaj, bu waccoo, lekkaat ko.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana koo gis mu ne: «Maa xelu»?","poem":1},{"lineBreak":true},{"text":"Kooku ab dof a ko gën demin.","poem":1}]},{"type":"heading","content":["Ab yaafus a ngii"]},{"type":"verse","number":13,"content":[{"text":"Ab yaafus da naan: «Gayndee ngi ci yoon wi!","poem":1},{"lineBreak":true},{"text":"Gayndee ngi ci mbedd mi!»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ab yaafus day tëdd aka walbatiku,","poem":1},{"lineBreak":true},{"text":"mooy bunt, day jaayu, demul fenn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ab yaafus day yeb loxoom ci ndab,","poem":1},{"lineBreak":true},{"text":"waaye yékkati ko, sex, da koy sonal.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ab yaafus day foog ne moo gëna muus","poem":1},{"lineBreak":true},{"text":"juróom ñaari boroom xel yu xam tont.","poem":1}]},{"type":"heading","content":["Ay nit ñuy loree ngii"]},{"type":"verse","number":17,"content":[{"text":"Kuy xuloo lu sa yoon newul,","poem":1},{"lineBreak":true},{"text":"yaa jàpp ci noppi xaj buy romb.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nit kuy naxe,","poem":1},{"lineBreak":true},{"text":"naan: «Damay fo!»","poem":1},{"lineBreak":true},{"text":"yaay dof buy sànniy jum,","poem":1},{"lineBreak":true},{"text":"di fitteeka reye.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bu matt amul, ab taal fey,","poem":1},{"lineBreak":true},{"text":"fu soskat amul it, xuloo jeex fa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Këriñ defi xal, matt xambub taal,","poem":1},{"lineBreak":true},{"text":"ab xulookat di xambu ay.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Waxi jëwkat di ñam wu neex,","poem":1},{"lineBreak":true},{"text":"wuy seey, jàll ca biir-a-biir.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kuy wax lu neex, tey mébét lu bon,","poem":1},{"lineBreak":true},{"text":"yaay xaalis bu rax, ñu xoob ca ndabal xandeer.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ab noon làqoo na ay waxam,","poem":1},{"lineBreak":true},{"text":"lal pexey wor ca xolam.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Buy wax lu neex, bul gëm,","poem":1},{"lineBreak":true},{"text":"ñaawtéef la xol ba fees dell.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Su la nëbbalee mbañeel, di la nax it,","poem":1},{"lineBreak":true},{"text":"ag mbonam mujj bir ñépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ku gasal nit am yeer, yaa cay daanu;","poem":1},{"lineBreak":true},{"text":"ku béraŋu doj, ngir tance, yaay tancu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kuy fen, dangaa bañ ka nga fenal,","poem":1},{"lineBreak":true},{"text":"te boroom làmmiñ wu neex day sànke.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}