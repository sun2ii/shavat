{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":27,"content":[{"type":"heading","content":["Yeneen diglee ngi"]},{"type":"verse","number":1,"content":[{"text":"Bul damoo ëllëg,","poem":1},{"lineBreak":true},{"text":"ndax xamoo luy xew tey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bul tëggu, bàyyil ñu tagg la,","poem":1},{"lineBreak":true},{"text":"muy waxi keneen; yaw, bu ko wax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Doj diis na, suuf dib sëf,","poem":1},{"lineBreak":true},{"text":"waaye fitnay dof a ko raw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xadar day ñàng, mer di wal mu baawaan,","poem":1},{"lineBreak":true},{"text":"waaye fiiraange amul moroom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Artu yu ñu la biralal","poem":1},{"lineBreak":true},{"text":"moo gën cofeel gu la boroom ñooru.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Soppe, bu lay gaañ sax, wóolu ko.","poem":1},{"lineBreak":true},{"text":"Nit bañ na la, te di la fóon lu bare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku suur, bañ lem ju xelli,","poem":1},{"lineBreak":true},{"text":"waaye boo xiifee, lu wex lu ne neex la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku sore fa nga bokk,","poem":1},{"lineBreak":true},{"text":"dangay mel ni picc mu sore tàggam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Diwook suuru day naatal xol;","poem":1},{"lineBreak":true},{"text":"waaye li neex cib xarit, xol la lay digale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bul fàtte sab xarit mbaa sa xaritu baay,","poem":1},{"lineBreak":true},{"text":"boo jàqee, bul seeti sa mbokk;","poem":1},{"lineBreak":true},{"text":"dëkkandoo bu jegee gën mbokk mu sore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Muusal, doom, ma bég,","poem":1},{"lineBreak":true},{"text":"ba mana tontu ku ma sikk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kuy foog, gisu ay, làqu;","poem":1},{"lineBreak":true},{"text":"ab téxét ne ca tëñëx, loru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ku gàddul jàmbur bor, jëlal mbubbam;","poem":1},{"lineBreak":true},{"text":"tayle ko, moo dige feyal jàmbur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nuyoo bu xumb, suba teel","poem":1},{"lineBreak":true},{"text":"mooki saagaa yem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Jabar ju pànk","poem":1},{"lineBreak":true},{"text":"mooy senn bu dakkul, cib taw;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ku ko mana yemale,","poem":1},{"lineBreak":true},{"text":"mana téye ngelaw mbaa nga ŋëb ag diw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Weñ ay nàmm weñ,","poem":1},{"lineBreak":true},{"text":"nit ay nàmm xelu moroom ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku aar garab, lekk ca doom ya;","poem":1},{"lineBreak":true},{"text":"ku toppatoo sa sang, am ngërëm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ku xool cim ndox, gis sa kanam,","poem":1},{"lineBreak":true},{"text":"nga xool sab xol, gis sa jikko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Njaniiw ak biir suuf du fees,","poem":1},{"lineBreak":true},{"text":"bët it du doylu mukk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Xaalis ak wurus sawaraa koy xelli,","poem":1},{"lineBreak":true},{"text":"waaye àtteb nit ca taggam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Soo jëloonub dof, yeb ci gënn,","poem":1},{"lineBreak":true},{"text":"booleek pepp, wol,","poem":1},{"lineBreak":true},{"text":"du tax ndof ga deñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Xamal bu baax lu say gàtt nekke,","poem":1},{"lineBreak":true},{"text":"te def sa xel ci say gétt,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ndax alal wéyul fàww,","poem":1},{"lineBreak":true},{"text":"ag pal du ñeel sëtoo sët.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gannaaw bu ñu gubee,","poem":1},{"lineBreak":true},{"text":"ba ñax saxaat,","poem":1},{"lineBreak":true},{"text":"ñu dajale ngooñ ma ca tund ya","poem":1},{"noteId":2},{"text":",","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"say xar da lay amal koddaay,","poem":1},{"lineBreak":true},{"text":"bëy yi génneel la njëgu tool.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Meewum bëy daldi am, ba doy la dund,","poem":1},{"lineBreak":true},{"text":"yaak sa waa kër","poem":1},{"lineBreak":true},{"text":"ak sa surga yu jigéen.","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"27.25 Ca Israayil tund yaa ëpp lu muy taw, te fa la ñax ma ëppe.","reference":{"chapter":27,"verse":25}}]},"thisChapterLink":"/api/wol_mbs/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}