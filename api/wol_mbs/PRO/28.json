{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Ku bon daw na te dàqeesu ko,","poem":1},{"lineBreak":true},{"text":"ku jub ñeme ni gaynde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bu am réew dee fippu, kilifa ya bare;","poem":1},{"lineBreak":true},{"text":"réew mu jàmm sax, kilifa gaa am déggin ak xam-xam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ku ñàkk, su jekkoo ab ndóol,","poem":1},{"lineBreak":true},{"text":"du ko bàyyil fepp, day mel ni waame.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ku wacc yoon, gërëm ku bon;","poem":1},{"lineBreak":true},{"text":"ku wormaal yoon, jànkoonteek ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ku bon xamul njub,","poem":1},{"lineBreak":true},{"text":"kuy wut Aji Sax ji, xam nga njub bu wér.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ñàkk te mat","poem":1},{"lineBreak":true},{"text":"moo gën barele te dëng.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gone gu sàmm yoon am nag dégg,","poem":1},{"lineBreak":true},{"text":"ku ànd ak sagaru nit gàcceel sa baay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kiy leble di tege, ba barele,","poem":1},{"lineBreak":true},{"text":"kay yéwéne néew-ji-doole lay dencal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Soo dee tanqamlu yoon,","poem":1},{"lineBreak":true},{"text":"sag ñaan sax Yàlla suur na ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ku yóbbe bàkkaar nit kuy jubal,","poem":1},{"lineBreak":true},{"text":"yeer ma nga gas, yaa cay tàbbi,","poem":1},{"lineBreak":true},{"text":"waaye ku mat di jagoo ngëneel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waay a ngi barele, defe ne xelu na;","poem":1},{"lineBreak":true},{"text":"ku néewle amug dégg, gis ne xeluwul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bu kuy jëfe njekk amee ndam, mbégte mu réy la;","poem":1},{"lineBreak":true},{"text":"ab soxor falu, ñépp làquji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuy làq say tooñ doo baaxle,","poem":1},{"lineBreak":true},{"text":"ku koy nangu, tuub ko, am yërmandey Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mbégte ñeel na ku saxoo ragal Yàlla,","poem":1},{"lineBreak":true},{"text":"waaye ku dëgër bopp tàbbi ci njekkar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kilifa guy soxore néew-ji-doole","poem":1},{"lineBreak":true},{"text":"mook gaynde guy yëmmoo yem, mbaa rab wuy songe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kilifa gu amulug dégg, day foqati rekk,","poem":1},{"lineBreak":true},{"text":"waaye ku bañ lu lewul, gudd fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ku bóom nit, daw, ba tàbbi njaniiw;","poem":1},{"lineBreak":true},{"text":"bu ko kenn taxawu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mat, mucc;","poem":1},{"lineBreak":true},{"text":"dëng, dàll daanu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Beyal sab tool, sab dund doy;","poem":1},{"lineBreak":true},{"text":"topp ay caaxaan, ndóol ba doyal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Boroom worma, bare barke;","poem":1},{"lineBreak":true},{"text":"ku yàkkamtee woomle, sa mbugal du jaas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Par-parloo baaxul,","poem":1},{"lineBreak":true},{"text":"waaye dogu mburu moyloo na kilifa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ab nay day yàkkamtee barele,","poem":1},{"lineBreak":true},{"text":"te xamul, ba ko ñàkk di dab.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Boo artoo nit, mu baaxe la ëllëg;","poem":1},{"lineBreak":true},{"text":"yaa koy gënal ku ko doon jay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku xañ say waajur seen alal","poem":1},{"lineBreak":true},{"text":"te defe ne tooñoo,","poem":1},{"lineBreak":true},{"text":"yaa neexook saay-saayu yàqkat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ku bëgge day sooke ay,","poem":1},{"lineBreak":true},{"text":"te ku wóolu Aji Sax ji, woomle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ku doyloo sam xel, dof nga;","poem":1},{"lineBreak":true},{"text":"ku jëfe xel mu rafet, mucc nga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kuy jox néew-ji-doole, doo ñàkk;","poem":1},{"lineBreak":true},{"text":"nga gëmm ne gisoo, bare ku la móolu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bu ab soxor faloo, ñépp làquji,","poem":1},{"lineBreak":true},{"text":"bu daanoo, kuy jëfe njekk teg tànk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}