{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Ku ñuy artu, nga të ticc,","poem":1},{"lineBreak":true},{"text":"dangay jekki yàqu, ba wees am paj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuy jëfe njekk falu, baadoolo bég;","poem":1},{"lineBreak":true},{"text":"ab soxor jiite, baadoolo binni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuy jëfe xel, bégal sa baay;","poem":1},{"lineBreak":true},{"text":"nga ànd aki gànc, yàq alal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Buur jub, am réew dëgër;","poem":1},{"lineBreak":true},{"text":"mu bëggi galag, réew ma sànku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuy jay sa moroom,","poem":1},{"lineBreak":true},{"text":"yaa ngi koy dugal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ku bon day moy, ba dugal boppam;","poem":1},{"lineBreak":true},{"text":"ku jub di woy aka bànneexu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Boroom njekk a xam àqu néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"ab soxor xamu ca dara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ñaawlekat a ngi taal ab dëkk,","poem":1},{"lineBreak":true},{"text":"ku xelu di giifal mer.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Boroom xel, buy layookub dof,","poem":1},{"lineBreak":true},{"text":"bu mereek buy ree, jàmm du am.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ab bóomkat day sib ku mat,","poem":1},{"lineBreak":true},{"text":"di wuta bóom kuy jubal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ab dof day mer, sàmbaar;","poem":1},{"lineBreak":true},{"text":"ku xelu, mer, ànd ak sagoom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kilifa dégluy fen,","poem":1},{"lineBreak":true},{"text":"jawriñ yépp di ñu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ku ñàkk ak ka ko nennoo bokk lenn,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee leen boole sàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Buur àtte way-ñàkk ci dëgg,","poem":1},{"lineBreak":true},{"text":"ab jalam sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Deel bantal aka yedde, day rafetal xel;","poem":1},{"lineBreak":true},{"text":"gone goo bay-bayal, mu gàcceel ndeyam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bu ku bon féetee kaw, ag moy law,","poem":1},{"lineBreak":true},{"text":"waaye kiy jëfe njekk ay fekke jéllam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yaral sa doom, mu noppal la,","poem":1},{"lineBreak":true},{"text":"bànneexal la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Fu Yàlla feeñoowul, nit ña fétteeral,","poem":1},{"lineBreak":true},{"text":"waaye ku topp yoon, am mbégte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waxi neen yarul surga,","poem":1},{"lineBreak":true},{"text":"da lay dégg te du la déggal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ana koo gis, mu rattaxle?","poem":1},{"lineBreak":true},{"text":"Kooku ab dof a ko gën demin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku yàq sab surga ba muy ndaw,","poem":1},{"lineBreak":true},{"text":"bu ëllëgee mu defe ne doom la","poem":1},{"noteId":3},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Boroom xadar day sooke ay,","poem":1},{"lineBreak":true},{"text":"te ku tàng bopp moy, moyati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Réy-réylu, detteelu rekk;","poem":1},{"lineBreak":true},{"text":"woyofal, ñu naw la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ku ànd akub sàcc, sa noonu bopp nga:","poem":1},{"lineBreak":true},{"text":"soo waxee dëgg, yoon topp la;","poem":1},{"lineBreak":true},{"text":"soo ko miimee, Yàlla topp la","poem":1},{"noteId":4},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ragal nit dugal sa bopp la,","poem":1},{"lineBreak":true},{"text":"ku wóolu Aji Sax ji, fegu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ñu baree ngi sàkku kilifa baaxe leen,","poem":1},{"lineBreak":true},{"text":"moona Aji Sax jeey àtteb jaam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ku jub day sib ku dëng,","poem":1},{"lineBreak":true},{"text":"ku bon sib kuy jubal.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"29.21 Mbaa: bu ëllëgee mu jaaxal la.","reference":{"chapter":29,"verse":21}},{"noteId":4,"caller":"+","text":"29.24 Yàlla topp la: seetal ci Sarxalkat yi 5.1: Bu nit bàkkaaree ndax lu mu dégg wooteb seede cib àtte, ba noppi baña wax la mu gis mbaa mu xam ko ca mbir ma, dees na ko ko topp.","reference":{"chapter":29,"verse":24}}]},"thisChapterLink":"/api/wol_mbs/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}