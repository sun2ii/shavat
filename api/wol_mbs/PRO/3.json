{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["Wóolul Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Doom, bul fàtte sama njàngale,","poem":1},{"lineBreak":true},{"text":"defal sa xel ci saay santaane,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ngir fan wi gudd lool,","poem":1},{"lineBreak":true},{"text":"nga gëna am jàmm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bu la ngor ak worma dëddu,","poem":1},{"lineBreak":true},{"text":"booleel takk ci sa baat,","poem":1},{"lineBreak":true},{"text":"bind ko ci sa àlluway xol.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kon nga xam lu jaadu,","poem":1},{"lineBreak":true},{"text":"neex Yàllaak doom aadama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanga wóoloo Aji Sax ji sa léppi xol,","poem":1},{"lineBreak":true},{"text":"te bul wéeru ci saw déggin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Loo mébét, bàyyil Yàlla xel,","poem":1},{"lineBreak":true},{"text":"mu xàllal la yoon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bul doyloo sa xel mu rafet,","poem":1},{"lineBreak":true},{"text":"ragalal Aji Sax ji, dëddu mbon;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"sa yaram wér,","poem":1},{"lineBreak":true},{"text":"say cér naat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Teralal Aji Sax ji ci sa alal","poem":1},{"lineBreak":true},{"text":"ak loo njëkka meññle,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"say sàq day fees, ne xéew,","poem":1},{"lineBreak":true},{"text":"say mbàndi ndoxi reseñ di wal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Doom, bul xeeb yaru Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"bul bañ mu waññi la,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ndax Aji Sax ji, ku mu sopp, yar la,","poem":1},{"lineBreak":true},{"text":"ni baay, ak doom ju ko neex.","poem":1}]},{"type":"heading","content":["Li xel mu rafet di jariñ"]},{"type":"verse","number":13,"content":[{"text":"Mbégtee ñeel ku daj xel mu rafet","poem":1},{"lineBreak":true},{"text":"ak ku amug dégg.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Am koo gën am xaalis,","poem":1},{"lineBreak":true},{"text":"te njariñ laa raw wurus.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xel mu rafet a gën gànjar;","poem":1},{"lineBreak":true},{"text":"loo mana bëgg moo ko raw.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gudd fan, mu joxee ndijoor;","poem":1},{"lineBreak":true},{"text":"càmmoñ ba, alal ak teraanga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa muy jaare yiw la,","poem":1},{"lineBreak":true},{"text":"fu mu awe jàmm la.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mooy garab giy taxa dund","poem":1},{"lineBreak":true},{"text":"ci ku ko jàpp,","poem":1},{"lineBreak":true},{"text":"di mbégtey ku ca ŋoy.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aji Sax ji xel mu rafet la sose suuf,","poem":1},{"lineBreak":true},{"text":"lale asamaan ag dégg.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ci xam-xamam la ndoxi xóote ya ne jàyy,","poem":1},{"lineBreak":true},{"text":"ay niir di lay.","poem":1}]},{"type":"heading","content":["Rafet xel barke la"]},{"type":"verse","number":21,"content":[{"text":"Sama doom, saxool xelu akug foog,","poem":1},{"lineBreak":true},{"text":"dee ci xool foo tollu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Day guddal saw fan,","poem":1},{"lineBreak":true},{"text":"di rafetal sa jikko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kon sab dox wóor,","poem":1},{"lineBreak":true},{"text":"doo fakkastalu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Soo tëddee doo tiit;","poem":1},{"lineBreak":true},{"text":"say nelaw day neex.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kon doo ragal njàqare lu bette","poem":1},{"lineBreak":true},{"text":"ak saay-saay buy songe,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ndax Aji Sax ji da lay yiir,","poem":1},{"lineBreak":true},{"text":"di la musal cig fiir.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bul xañ njekk ku ko yelloo,","poem":1},{"lineBreak":true},{"text":"ndegam man nga ko.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bul ne say dëkk: «Demal ba beneen, ma jox la,»","poem":1},{"lineBreak":true},{"text":"te fekk la yor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bul fexeel dëkkandoo","poem":1},{"lineBreak":true},{"text":"bu dëkk ak yaw ci kóolute.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Bul joteek kenn ci neen,","poem":1},{"lineBreak":true},{"text":"te tooñu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bul ñee ku néeg,","poem":1},{"lineBreak":true},{"text":"te bu ko roy fenn.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Aji Sax ji daa sib ku dëng,","poem":1},{"lineBreak":true},{"text":"xejjoo kuy jubal.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aji Sax ji day alag kër ku bon,","poem":1},{"lineBreak":true},{"text":"di barkeel waa kër ku jub.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Kuy ñaawle, moo lay ñaawal,","poem":1},{"lineBreak":true},{"text":"ku toroxlu, mu may law yiw.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Teraanga di céru ku rafet xel,","poem":1},{"lineBreak":true},{"text":"ab dof gàccoo gàcce.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}