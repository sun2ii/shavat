{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Lii waxi Agur la, góor gay doomu Yake mu Maasa",{"noteId":5},". Góor ga daa wax ak Itiyel, wax ak Itiyel ak Ukal. Mu ne:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Maa dofe dëgg, ba yées ci nit ñi,","poem":1},{"lineBreak":true},{"text":"dég-dégu nit sax awma ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jànguma, ba am xel mu rafet,","poem":1},{"lineBreak":true},{"text":"awma xam-xam ci Aji Sell ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ana ku yéegoon asamaan, ba wàcc?","poem":1},{"lineBreak":true},{"text":"Mbaa mu masa ŋëb ngelaw ciy loxoom?","poem":1},{"lineBreak":true},{"text":"Ana ku masa ëmb ndox ci ndimo?","poem":1},{"lineBreak":true},{"text":"Mbaa mu rëdd mboolem kemi àddina?","poem":1},{"lineBreak":true},{"text":"Nu mu tudd ak nu doomam tudd?","poem":1},{"lineBreak":true},{"text":"Wax ma, yaw mi ko xam!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lu Yàlla wax, mat na sëkk,","poem":1},{"lineBreak":true},{"text":"mooy yiir ku ko làqoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bul yokk ay waxam,","poem":1},{"lineBreak":true},{"text":"mu weddi say fen, nga weeru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Éy Yàlla, ñaar laa la ñaan,","poem":1},{"lineBreak":true},{"text":"ngalla may ma ko sama giiru dund:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"caaxaan aki fen, yal na ma sore,","poem":1},{"lineBreak":true},{"text":"néewleek barele, bu ma ci may lenn,","poem":1},{"lineBreak":true},{"text":"leel ma lu ma doy;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"lu ko moy ma regg, weddi la,","poem":1},{"lineBreak":true},{"text":"ba naan: «Kuy Aji Sax ji?»","poem":1},{"lineBreak":true},{"text":"Mbaa ma ñàkk bay sàcc,","poem":1},{"lineBreak":true},{"text":"di la ñàkke worma, yaw sama Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bul sikkal ab surga ca njaatigeem,","poem":1},{"lineBreak":true},{"text":"da lay ñaan-yàlla, mu dal la.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ag maas a ngi saaga baay,","poem":1},{"lineBreak":true},{"text":"te wormaaluñu ndey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ag maas a ngi defe ne set nañu,","poem":1},{"lineBreak":true},{"text":"te taq ripp ak bàkkaar.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ag maas a ngi daŋŋiiral;","poem":1},{"lineBreak":true},{"text":"aka ñoo mana xeeloo!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ag maas a ngi, seeni sell niy saamar,","poem":1},{"lineBreak":true},{"text":"seeni gëñ niy paaka,","poem":1},{"lineBreak":true},{"text":"ñuy lekk néew-ji-doole, ba raafal leen ci réew mi,","poem":1},{"lineBreak":true},{"text":"ba ku ñàkk jeex ci biir nit ñi.","poem":1}]},{"type":"heading","content":["Ay kàddoo ngii yu ànd ak lim"]},{"type":"verse","number":15,"content":[{"text":"Saxu watar","poem":1},{"noteId":6},{"text":"du suur, ñaar ñu jigéen la am:","poem":1},{"lineBreak":true},{"text":"Jox Ma ak Jox Ma.","poem":1},{"lineBreak":true},{"text":"Ñett a ngii ñu dul suur,","poem":1},{"lineBreak":true},{"text":"ba ci ñeent ñu dul ne doy na mukk:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"njaniiw,","poem":1},{"lineBreak":true},{"text":"jigéen ju jaasir,","poem":1},{"lineBreak":true},{"text":"suuf, du màndi ndox,","poem":1},{"lineBreak":true},{"text":"sawara, du ne doy na mukk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kuy xeelu sa baay,","poem":1},{"lineBreak":true},{"text":"di siidee déggal sa ndey,","poem":1},{"lineBreak":true},{"text":"baaxoñ génne ciw xur, luqi sa bët,","poem":1},{"lineBreak":true},{"text":"tan ya lekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ñett a ngii, yéem na ma,","poem":1},{"lineBreak":true},{"text":"ba ci ñeent yu ma xamul:","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"yoonu jaxaay ci asamaan,","poem":1},{"lineBreak":true},{"text":"yoonu jaan ci kawi doj,","poem":1},{"lineBreak":true},{"text":"yoonu gaal ci diggu géej,","poem":1},{"lineBreak":true},{"text":"yoon wi góor di jaar as ndaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Jikkoy jigéenu moykat a ngii:","poem":1},{"lineBreak":true},{"text":"day lekk, wommiku, te naan:","poem":1},{"lineBreak":true},{"text":"«Defuma dara lu aay!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ñett a ngii, day yëngal suuf,","poem":1},{"lineBreak":true},{"text":"ba ci ñeent yu suuf àttanul:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"jaam bu falu buur,","poem":1},{"lineBreak":true},{"text":"dof bu regg,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ndaw su bon su for jëkkër,","poem":1},{"lineBreak":true},{"text":"jigéen ju wuutu sangam bu jigéen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ñeent a ngii, di lu tuut ci kaw suuf,","poem":1},{"lineBreak":true},{"text":"te am xel, yaroo xel:","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"xorondom, néew na doole,","poem":1},{"lineBreak":true},{"text":"waaye bu jotee, mu denc dundam;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"daman","poem":1},{"noteId":7},{"text":", barewul kàttan,","poem":1},{"lineBreak":true},{"text":"te day dëkk ciy doj;","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"soccet, amul buur,","poem":1},{"lineBreak":true},{"text":"teewul ñuy àndandoo, diy gàngoor;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"sindax, manees na koo ŋëb,","poem":1},{"lineBreak":true},{"text":"teewul ma nga biir kër buur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ñett a ngii, ñu jekkum ndaag,","poem":1},{"lineBreak":true},{"text":"ba ci ñeent ñu jekk doxin:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"gaynde, mooy buuru rab yi,","poem":1},{"lineBreak":true},{"text":"ragalul kenn;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"séq daagu, jekk taxawaay;","poem":1},{"lineBreak":true},{"text":"ab sikket,","poem":1},{"lineBreak":true},{"text":"ak buur ci biiri dagam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Boo sàgganee bay tëggu,","poem":1},{"lineBreak":true},{"text":"mbaa ngay mébét lu bon,","poem":1},{"lineBreak":true},{"text":"nanga téye saw làmmiñ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ndax ku ruux soow, am ca dax,","poem":1},{"lineBreak":true},{"text":"ku wañaar bakkan, mu nàcc,","poem":1},{"lineBreak":true},{"text":"te lu jógal xol, indiw ay.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"30.1 Maasa, béreb la bu genn giirug Israayil sancoon ca bëj-gànnaaru Arabi.","reference":{"chapter":30,"verse":1}},{"noteId":6,"caller":"+","text":"30.15 watar sax la wu nekk ci ndox, di manq deret.","reference":{"chapter":30,"verse":15}},{"noteId":7,"caller":"+","text":"30.26 daman xaw naa nirook njomboor.","reference":{"chapter":30,"verse":26}}]},"thisChapterLink":"/api/wol_mbs/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}