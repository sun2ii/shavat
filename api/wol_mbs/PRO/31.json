{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Lii waxi Lemuyel la, buuru Maasa",{"noteId":8},", te ndeyam jàngal ko ko. Mu ne:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngóor si doom, saa doomi bopp!","poem":1},{"lineBreak":true},{"text":"Yaa di ñaan gu nangu, doom!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bul jox jigéen ñi sa doole,","poem":1},{"lineBreak":true},{"text":"bul jox say siddit jigéen ñiy sànk buur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buur moomul di naan biiñ, Lemuyel,","poem":1},{"lineBreak":true},{"text":"buur moomu ko;","poem":1},{"lineBreak":true},{"text":"kilifa moomul di sàkku ñoll.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lu ko moy mu naan, ba fàtte lu yoon tëral,","poem":1},{"lineBreak":true},{"text":"xañ néew-ji-doole ju ne àqam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bàyyeel ñoll kuy sànku,","poem":1},{"lineBreak":true},{"text":"bàyyeel biiñ boroom naqar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ñu naanee, fàtte seen néewle,","poem":1},{"lineBreak":true},{"text":"ba dootuñu fàttaliku seenu tiis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nanga àddul ku amul kàddu,","poem":1},{"lineBreak":true},{"text":"ku sësul fenn, nga ñoŋal àqam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Deel àddu, di àtte njub;","poem":1},{"lineBreak":true},{"text":"ku ñàkk ak ku néewle, nga sàmm àqam.","poem":1}]},{"type":"heading","content":["Jeeg bu ragal Aji Sax ji nii lay mel"]},{"type":"verse","number":10,"content":[{"text":"Jeeg bu jàmbaare, ndaw lu jafe,","poem":1},{"lineBreak":true},{"text":"ba rawati gànjar!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jëkkër ja da koy wóolu,","poem":1},{"lineBreak":true},{"text":"te jëkkër ja day am xéewal, du ko ñàkk.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Day defal jëkkëram lu baax, du ko lor,","poem":1},{"lineBreak":true},{"text":"te di ànd ak bakkan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Day wut kawari gàtt aki wëñ,","poem":1},{"lineBreak":true},{"text":"di ca liggéeye mbégte.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Day mel ni gaalu jula,","poem":1},{"lineBreak":true},{"text":"di jëli dundam fu sore.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Day jóg te bët setul,","poem":1},{"lineBreak":true},{"text":"di waajal njëlu njabootam,","poem":1},{"lineBreak":true},{"text":"aka sas ay janqam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Day seetlu ab tool, jënd ko,","poem":1},{"lineBreak":true},{"text":"sàkk ciw ñaqam, jëmbat tóokër.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Day gañu di góor-góorlu","poem":1},{"lineBreak":true},{"text":"aka dëgëral përëg ya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Day gis njartel liggéeyam,","poem":1},{"lineBreak":true},{"text":"te làmpam du fey guddi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma ngay yor poqe","poem":1},{"lineBreak":true},{"text":"ak këccu, di ëcc.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Day jox ku ñàkk,","poem":1},{"lineBreak":true},{"text":"di sàkkal néew-ji-doole.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tiitul ci njaboot gi sedd bu metti,","poem":1},{"lineBreak":true},{"text":"ndax ñoom ñépp ay tegley yére.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mooy sàkkal boppam ay malaan,","poem":1},{"lineBreak":true},{"text":"ay yéreem mucc ayib te yànj.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dees na ràññee jëkkëram ca pénc ma,","poem":1},{"lineBreak":true},{"text":"fa muy toog ca magi réew ma.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ndaw su ni mel day ràbb ay yére, di jaay,","poem":1},{"lineBreak":true},{"text":"aki gañaay, di jox jaaykat yi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Faaydaak jom la làmboo,","poem":1},{"lineBreak":true},{"text":"te ëllëg ubul boppam.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Day wax lu xelu,","poem":1},{"lineBreak":true},{"text":"di digle ngor.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Jigéen jooju mooy bàyyi xel ci njabootam,","poem":1},{"lineBreak":true},{"text":"te du nangoo yàccaaral.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Doom ya dañu ko naan: «Jarawlakk!»","poem":1},{"lineBreak":true},{"text":"Jëkkër ja di ko gërëm naan:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"«Jeeg bu jàmbaare bare na,","poem":1},{"lineBreak":true},{"text":"waaye yaw, yaa ci raw.»","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Melokaan wu jekk day naxe, taar day wéy,","poem":1},{"lineBreak":true},{"text":"waaye jigéen ju ragal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"kookoo jara gërëm.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Joxleen ko njukkalu ñaqam,","poem":1},{"lineBreak":true},{"text":"jëfam di woyam ca pénc ma.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"31.1 Maasa, béreb la bu genn giirug Israayil sancoon ca bëj-gànnaaru Arabi.","reference":{"chapter":31,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}