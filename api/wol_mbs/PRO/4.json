{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["Ku dégg ndigal, jariñu"]},{"type":"verse","number":1,"content":[{"text":"Gone yi, tee ngeena dégg yaru baay,","poem":1},{"lineBreak":true},{"text":"te déglu, ba amug dégg.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maa ngi leen di jàngal lu baax,","poem":1},{"lineBreak":true},{"text":"buleen fàtte sama njàngale.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Man it amoon naa baay,","poem":1},{"lineBreak":true},{"text":"di benn bàjjo ci saa ndey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baay digal ma, ne ma:","poem":1},{"lineBreak":true},{"text":"«Jàppal samay wax ci sam xel,","poem":1},{"lineBreak":true},{"text":"di jëfe samay santaane, ba dund.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amal xel mu rafet akug dégg.","poem":1},{"lineBreak":true},{"text":"Bul fàtte te bul moy samay wax.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bul dëddu xel mu rafet, da lay aar;","poem":1},{"lineBreak":true},{"text":"sopp ko, mu sàmm la.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Njàlbéenu xel mu rafet mooy sàkku ko;","poem":1},{"lineBreak":true},{"text":"ak loo mana am, amalug dégg.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nawal xel mu rafet, mu darajaal la;","poem":1},{"lineBreak":true},{"text":"tafoo ko, mu teral la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Da lay takkal kaala gu jekk,","poem":1},{"lineBreak":true},{"text":"solal la mbaxanam buur.»","poem":1}]},{"type":"heading","content":["Moytul yoonu ku bon"]},{"type":"verse","number":10,"content":[{"text":"Déglul, doom, te dégg saay wax,","poem":1},{"lineBreak":true},{"text":"ndax nga gudd fan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yoon wu xelu laa la teg,","poem":1},{"lineBreak":true},{"text":"jaarloo la yoonu njub.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Doo dox ba tërëf,","poem":1},{"lineBreak":true},{"text":"doo daw, téqtalu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ŋoyal cib yar, bul yoqi,","poem":1},{"lineBreak":true},{"text":"sàmm ko, moo yor sa bakkan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yoonu ku bon, bu ci tegu;","poem":1},{"lineBreak":true},{"text":"fu ab soxor di jaar, bu fa dox.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moyul, bu fa jaare;","poem":1},{"lineBreak":true},{"text":"mbasal te wéy!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ku bon du nelaw te lorewul,","poem":1},{"lineBreak":true},{"text":"du dajjant ba kera muy téqe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Daa bon, def ko lekk,","poem":1},{"lineBreak":true},{"text":"di màndee coxoram.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yoonu ku jub day leer,","poem":1},{"lineBreak":true},{"text":"ba ne ràññ ni bëccëg.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yoonu ku bon ne këruus,","poem":1},{"lineBreak":true},{"text":"du xam lu muy téqtaloo.","poem":1}]},{"type":"heading","content":["Saxal ci lu baax"]},{"type":"verse","number":20,"content":[{"text":"Doom, déglul samay kàddu,","poem":1},{"lineBreak":true},{"text":"teewlul samay wax.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bu ci noppee ja jàkk,","poem":1},{"lineBreak":true},{"text":"te jàpp ko ci sa biir xel.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mooy dundloo ku ci jàpp,","poem":1},{"lineBreak":true},{"text":"di wéral jëmmam jépp.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Sàmmal a sàmm sab xol,","poem":1},{"lineBreak":true},{"text":"nde xalaati xol ngay jëfe.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Dàqal wor, mu sore la;","poem":1},{"lineBreak":true},{"text":"kàdduy naxe, na la dànd.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Xooleel, sa bët ne jàkk,","poem":1},{"lineBreak":true},{"text":"ngay xool sa kanam màkk.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Seetlul fi ngay teg tànk,","poem":1},{"lineBreak":true},{"text":"ba foo awe, mu wóor.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Bul jàdd, ndijoor mbaa càmmoñ,","poem":1},{"lineBreak":true},{"text":"na sa tànk moyu lu bon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}