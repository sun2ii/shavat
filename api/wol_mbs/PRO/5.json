{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["Moytul njaaloo"]},{"type":"verse","number":1,"content":[{"text":"Sama doom, déglul sama xel mu rafet,","poem":1},{"lineBreak":true},{"text":"teewlul sama déggin,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kon nga saxoo foog,","poem":1},{"lineBreak":true},{"text":"say wax tegu ci xam-xam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lu mel ni lem la jigéenu njaalookat di wax,","poem":1},{"lineBreak":true},{"text":"làmmiñ wa ni diw gu ñu lay raay.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Muj ga mu wex xàtt,","poem":1},{"lineBreak":true},{"text":"di gaañe ni ñawkay saamar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tànk ya day bartalu wuti dee,","poem":1},{"lineBreak":true},{"text":"ay jéegoom àkki njaniiw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rëddul yoonu dund,","poem":1},{"lineBreak":true},{"text":"daa lajj, te xamu ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kon, samay doom, dégluleen ma,","poem":1},{"lineBreak":true},{"text":"buleen wacc samay kàddu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Soreel ndaw soosu,","poem":1},{"lineBreak":true},{"text":"bul jege bunt këram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kon nga ñàkk daraja, keneen jagoo;","poem":1},{"lineBreak":true},{"text":"ku néeg bóom la.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jàmbur jariñoo sa doole,","poem":1},{"lineBreak":true},{"text":"doxandéem jagoo saw ñaq.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ngay mujje onk,","poem":1},{"lineBreak":true},{"text":"desey yax, jeex tàkk.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nga naan: «Su ma yégoon, sopp ab yar","poem":1},{"lineBreak":true},{"text":"te baña sofental waxi artu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lu ma tee woona dégg ku may digal,","poem":1},{"lineBreak":true},{"text":"tey teewlu sama waxi sëriñ ya?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuuti ma yàqu yaxeet","poem":1},{"lineBreak":true},{"text":"fi kanam ñépp!»","poem":1}]},{"type":"heading","content":["Yemal ci sa jabar"]},{"type":"verse","number":15,"content":[{"text":"Naanal ci sa mbalkam bopp,","poem":1},{"lineBreak":true},{"text":"ndox ma balle sa teenu bopp.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xanaa doo wasaare sa bëti ndox ca biti,","poem":1},{"lineBreak":true},{"text":"mu def ay wal ca pénc ya?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nay sa alal, yaw doŋŋ,","poem":1},{"lineBreak":true},{"text":"ku bokk feneen bokkul.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yal na sa naanukaay barkeel,","poem":1},{"lineBreak":true},{"text":"nga bànneexoo kiy sa jabar ba ngay ndaw.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aka sopplu te jekk!","poem":1},{"lineBreak":true},{"text":"Na lay céram doy foo tollu,","poem":1},{"lineBreak":true},{"text":"na la xañ sago saa su ne.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Doom, ana looy xemmeme keneen,","poem":1},{"lineBreak":true},{"text":"bay fowe céri jàmbur?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lu waay jëf, Aji Sax ji gis,","poem":1},{"lineBreak":true},{"text":"di xool mboolem fu mu jaare.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Jëf ju bon day fiir ka ko sàlloo,","poem":1},{"lineBreak":true},{"text":"bàkkaaram di mbaal, jàpp ko.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ñàkk yar, dee;","poem":1},{"lineBreak":true},{"text":"ndof gu réy, sànku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}