{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":6,"content":[{"type":"heading","content":["Bul gàddul kenn bor"]},{"type":"verse","number":1,"content":[{"text":"Doom, dangaa gàddul nit bor,","poem":1},{"lineBreak":true},{"text":"dige feyal jàmbur,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"saw làmmiñ yeb la cim pax,","poem":1},{"lineBreak":true},{"text":"nga keppu?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaa ngi ci sa loxoy moroom,","poem":1},{"lineBreak":true},{"text":"kon defal nii, doom, ba rëcc:","poem":1},{"lineBreak":true},{"text":"doxal tinuji ko,","poem":1},{"lineBreak":true},{"text":"raamali ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bul gëmm,","poem":1},{"lineBreak":true},{"text":"bul nelaw!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dawal ni kéwél gu rëccub rëbb,","poem":1},{"lineBreak":true},{"text":"ne fërr ni picc mu raw ab fiirkat.","poem":1}]},{"type":"heading","content":["Bul yaafus"]},{"type":"verse","number":6,"content":[{"text":"Yaafus bee, xoolal xorondom,","poem":1},{"lineBreak":true},{"text":"seetal ci moom, ba muus.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Du ku ko yilif mbaa ku koy sas,","poem":1},{"lineBreak":true},{"text":"te jiiteesu ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu jotee mu denc ab dundam,","poem":1},{"lineBreak":true},{"text":"mu jot, mu for lekkam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moo yaafus bi, foo àppal tëraay bi?","poem":1},{"lineBreak":true},{"text":"Loo deeti xaar ci yewwu?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ngay dajjant aka for bët,","poem":1},{"lineBreak":true},{"text":"di tegley loxooka jaaxaan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Néewlee ngi lay dikkal nib sàcc,","poem":1},{"lineBreak":true},{"text":"ñàkk gànnaayul la.","poem":1}]},{"type":"heading","content":["Ku dëng, nii lay mel"]},{"type":"verse","number":12,"content":[{"text":"Ku tekkeedi te bon,","poem":1},{"lineBreak":true},{"text":"day wër di fen,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"day piis, di wokkeb tànk,","poem":1},{"lineBreak":true},{"text":"di waxe baaraam,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"jekkadiy xalaat, di mébét lu bon","poem":1},{"lineBreak":true},{"text":"aka yokku ay.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moo tax musiba di jekki dal ko,","poem":1},{"lineBreak":true},{"text":"mu jekki yàqu, ba wees paj.","poem":1}]},{"type":"heading","content":["Aji Sax ji bañ na lii"]},{"type":"verse","number":16,"content":[{"text":"Juróom benn a ngii yu Aji Sax ji bañ,","poem":1},{"lineBreak":true},{"text":"ba ci juróom ñaar yu mu seexlu:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"kuy daŋŋiiral,","poem":1},{"lineBreak":true},{"text":"kuy fen,","poem":1},{"lineBreak":true},{"text":"kuy rey nit ku deful dara,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"kuy fexe lu bon ci xolam,","poem":1},{"lineBreak":true},{"text":"kuy gaawtuy def lu ñaaw,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"seede buy fen rekk,","poem":1},{"lineBreak":true},{"text":"rawatina kuy yokku ay ci biiri bokk.","poem":1}]},{"type":"heading","content":["Ku njaaloo gis ko"]},{"type":"verse","number":20,"content":[{"text":"Doom, defal li la baay sant,","poem":1},{"lineBreak":true},{"text":"te bul wacc ndigalal yaay.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Takkal foo tollu, taf ci sa xol,","poem":1},{"lineBreak":true},{"text":"fas ko ci sa baat.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Booy dox mu di la jiite,","poem":1},{"lineBreak":true},{"text":"nga tëdd, mu di la sàmm,","poem":1},{"lineBreak":true},{"text":"nga yewwu, mu di la waxal.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Santaane da lay niital, ndigal leeralal la,","poem":1},{"lineBreak":true},{"text":"artookub yar di yoonu dund.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Da lay aar ci ndaw su bon","poem":1},{"lineBreak":true},{"text":"ak jabaru jàmbur ak làmmiñam wu neex.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bu ko xemmeme taaram,","poem":1},{"lineBreak":true},{"text":"bumu la fiir aki lamsal.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dogu mburu fey nab gànc;","poem":1},{"lineBreak":true},{"text":"waaye jabaru jàmbur, bakkanu lëmm.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Te ku ne sawara cas, tafoo,","poem":1},{"lineBreak":true},{"text":"lakk say yére.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ku dox ciy xal it,","poem":1},{"lineBreak":true},{"text":"say tànk ñor.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mooy ànd ak jabaru jàmbur,","poem":1},{"lineBreak":true},{"text":"ku ko def gis ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Deesul sikk ku sàcc aw ñam,","poem":1},{"lineBreak":true},{"text":"def ci biiram ndax xiif.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Waaye bu feeñee, fey boroom juróom ñaari yoon,","poem":1},{"lineBreak":true},{"text":"joxe alalu këram yépp.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Njaaloo di ñàkk bopp,","poem":1},{"lineBreak":true},{"text":"kuy sànk bakkanam a koy def.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mbugal ak toroxte dib añam,","poem":1},{"lineBreak":true},{"text":"te gàcceem du deñ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Fiiraange day feesal xolu góor,","poem":1},{"lineBreak":true},{"text":"te du ñéeblu buy feyu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Du faale ndàmpaay,","poem":1},{"lineBreak":true},{"text":"loo ko may, may, du giif.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}