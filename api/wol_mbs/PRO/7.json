{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["Jigéenu njaalookat da lay fiir"]},{"type":"verse","number":1,"content":[{"text":"Doom, sàmmal samay wax,","poem":1},{"lineBreak":true},{"text":"fonk samay santaane.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jëfeel samay santaane, ba dund,","poem":1},{"lineBreak":true},{"text":"jàppal samay ndigal sa fukki loxo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Takkal ci say waaraam,","poem":1},{"lineBreak":true},{"text":"bind ko ci sa àlluway xol.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Safool xel mu rafet, muy sab jigéen,","poem":1},{"lineBreak":true},{"text":"te nga xejjoo dég-dég ni sa mbokk lenqe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dina la aar ci jigéenu njaalookat,","poem":1},{"lineBreak":true},{"text":"bokk feneen, di wax lu neex.","poem":1}]},{"type":"heading","content":["Jigéenu njaalookat woote na"]},{"type":"verse","number":6,"content":[{"text":"Damaa tollu sama palanteer,","poem":1},{"lineBreak":true},{"text":"séentu ca xarante ya,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"séen ca biir téxét ya,","poem":1},{"lineBreak":true},{"text":"ku ma seetlu ca xale yu góor ya,","poem":1},{"lineBreak":true},{"text":"muy ku ñàkk bopp.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Muy dem ba fa ndaw say taxaw, ca selebe yoon wa,","poem":1},{"lineBreak":true},{"text":"daldi wuti kër ndaw sa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ngoonug suuf la, jant biy lang,","poem":1},{"lineBreak":true},{"text":"muy lëndëm di gëna guddi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndaw si jekki dajeek moom,","poem":1},{"lineBreak":true},{"text":"sol yérey gànc, lal pexeem.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Daa xumb, të,","poem":1},{"lineBreak":true},{"text":"du toog këram.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma nga ca mbedd ma, ne ca pénc ya,","poem":1},{"lineBreak":true},{"text":"ruqoo ruq, ma ngay yeeroo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndaw sa ne ko katam, fóon,","poem":1},{"lineBreak":true},{"text":"ne wajj, ne ko:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"«Tey matal naa la ma digoon Yàlla,","poem":1},{"lineBreak":true},{"text":"yàppu bernde waa nga kër ga, saraxu cant la","poem":1},{"noteId":0},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moo ma taxa dikk dajeek yaw.","poem":1},{"lineBreak":true},{"text":"Seet naa laa seet, ba gis la.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lal naa saab lal, ba mu jekk,","poem":1},{"lineBreak":true},{"text":"di malaan yu yànj, bawoo Misra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lal ba, ma xeeñal, mu ne bann,","poem":1},{"lineBreak":true},{"text":"di ndàbb, cuuraay ak xas mu neex.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dikkal, nu baanee baane, ba bët set,","poem":1},{"lineBreak":true},{"text":"te bànneexu ci mbëggeel.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sama jëkkër newu fa,","poem":1},{"lineBreak":true},{"text":"daa dem yoon wu sore.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mbuusum xaalis la ŋàbb, yóbbu,","poem":1},{"lineBreak":true},{"text":"du ñibbisi ndare weer wi fees dell.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Muy mocc aka moccaat, ba nax ko,","poem":1},{"lineBreak":true},{"text":"di wax lu neex, ba man ko.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Waa ja jekki, topp ko,","poem":1},{"lineBreak":true},{"text":"mbete yëkk wu ñuy rendiji,","poem":1},{"lineBreak":true},{"text":"mbaa dof bu ñu jéng, di ko yari.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mooy picc mu tàbbi cig fiir.","poem":1},{"lineBreak":true},{"text":"Du xam ne day dee,","poem":1},{"lineBreak":true},{"text":"ba keroog fitt jam ko ci xol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kon nag, samay doom, dégluleen ma,","poem":1},{"lineBreak":true},{"text":"teewluleen samay wax.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bu leen soosu ndaw xiir ci moy,","poem":1},{"lineBreak":true},{"text":"buleen teggi, topp ko.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bare na ku dee, moo ko rey,","poem":1},{"lineBreak":true},{"text":"maneesula waññ ñi mu rey ñépp.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Këram yoonu njaniiw la,","poem":1},{"lineBreak":true},{"text":"daa bartalu, tàbbi néegi dee.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"7.14 saraxu cant: ku masaana rendi gàtt bu mu def saraxu cant ci biir jàmm, dangay jël lenn ci yàpp wi, bokk kook sa njaboot, lekk. Ci lekk googa la ndaw siy woo xale bu góor bi.","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/wol_mbs/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}