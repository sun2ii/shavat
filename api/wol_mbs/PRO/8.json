{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Déggal! Xel mu Rafet di soxna saa ngi woote,","poem":1},{"lineBreak":true},{"text":"moom soxna si Am Dégg di xaacu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma nga taxaw ca selebe yoon ya,","poem":1},{"lineBreak":true},{"text":"fu gëna kawe ca yoon wa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma nga ca buntu dëkk ba, taxaw;","poem":1},{"lineBreak":true},{"text":"fa nit ñay jaare lay xaacoo naan:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Yeen mbooloo yi laay woo,","poem":1},{"lineBreak":true},{"text":"doom aadama yi laay joor.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Téxét bi, deel foog,","poem":1},{"lineBreak":true},{"text":"dof bi, déggal ndéey lu xelu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Déglul, ma wax la lu am solo,","poem":1},{"lineBreak":true},{"text":"dégtal la njub.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dëgg laay wax,","poem":1},{"lineBreak":true},{"text":"di bañ wax ju bon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lu ma wax njub la.","poem":1},{"lineBreak":true},{"text":"Amul lu dëng mbaa lu jekkadi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lépp a dëggu ci ku amug dégg,","poem":1},{"lineBreak":true},{"text":"te jub ci ku for xam-xam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na la samab yar gënal xaalis,","poem":1},{"lineBreak":true},{"text":"xam-xam dàqal la ngën-gi-wurus.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ndax man, Xel mu Rafet, maa gën gànjar,","poem":1},{"lineBreak":true},{"text":"loo bëgg maa ko raw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Man, Xel mu Rafet, foog di sama kër;","poem":1},{"lineBreak":true},{"text":"xam-xam ak pexe, ma for.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ragal Aji Sax ji mooy bañ lu bon.","poem":1},{"lineBreak":true},{"text":"Réy, xeebaate, yoonu mbon,","poem":1},{"lineBreak":true},{"text":"ak wax ju jekkadi, ma boole bañ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Maa moomi digle, di maye gis-gis;","poem":1},{"lineBreak":true},{"text":"maa amug dégg, di boroom doole.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Samay pexe la buur di jiitee,","poem":1},{"lineBreak":true},{"text":"kilifa di ci àttee dëgg.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ci samay pexe la njiit di saytoo,","poem":1},{"lineBreak":true},{"text":"ñook kàngam yeek ñiy àtte dëgg ñépp.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Maa sopp ku ma sopp,","poem":1},{"lineBreak":true},{"text":"ku ma seet tigi, gis ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alal ak teraangaa ngi fi man,","poem":1},{"lineBreak":true},{"text":"am-am bu sax it ak yoolu njekk.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Li may mayee gën wurus, muy wurus wa gën,","poem":1},{"lineBreak":true},{"text":"sama njariñ wees xaalis ba gën.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yoonu njub laay jaare,","poem":1},{"lineBreak":true},{"text":"di dox ci li jaadu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ku ma sopp, ma nàddil la,","poem":1},{"lineBreak":true},{"text":"feesal sab denc.»","poem":1}]},{"type":"heading","content":["Xel mu Rafet a mag lépp"]},{"type":"verse","number":22,"content":[{"text":"Soxna si, Xel mu Rafet nee na:","poem":1},{"lineBreak":true},{"text":"«Aji Sax ji jagoo na ma ca njàlbéen,","poem":1},{"lineBreak":true},{"text":"ma jiitu ca jëfam ya woon.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bu yàgg lañu ma dëj,","poem":1},{"lineBreak":true},{"text":"ca ndoorte la, bala suuf a sosu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ba may dikk, géej amul,","poem":1},{"lineBreak":true},{"text":"ndox ballul bay fees, di wal-wali.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dikk naa bala tund yu mag yee sampu,","poem":1},{"lineBreak":true},{"text":"lu jiitu tund yu ndaw yi,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"laata Yàllaa sàkk suuf aki àllam","poem":1},{"lineBreak":true},{"text":"ak feppu pënd ci àddina.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ba muy taxawal asamaan, maa nga fa,","poem":1},{"lineBreak":true},{"text":"ak ba muy rëdd fa asamaan taseek géej,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ak ba muy teg niir ya fa kaw,","poem":1},{"lineBreak":true},{"text":"ak ba muy dooleel ndoxi xóotey géej,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ak ba muy sàkkal géej kemoom,","poem":1},{"lineBreak":true},{"text":"ba du jàll fa mu wax.","poem":1},{"lineBreak":true},{"text":"Ba muy rëdd fa muy samp àddina,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"man, Xel mu Rafet, maa doon ku xareñ ci wetam,","poem":1},{"lineBreak":true},{"text":"di ko bànneexal bés bu ne,","poem":1},{"lineBreak":true},{"text":"tey bànneexu fi kanamam.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"May bége wërngalu àddinaam,","poem":1},{"lineBreak":true},{"text":"di bànneexoo doomi aadama.","poem":1}]},{"type":"heading","content":["Xel mu Rafet dénkaane na"]},{"type":"verse","number":32,"content":[{"text":"«Kon nag, samay doom, dégluleen ma.","poem":1},{"lineBreak":true},{"text":"Mbégte ñeel na ki may topp.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nangeen déglu ku leen di yar, daldi muus.","poem":1},{"lineBreak":true},{"text":"Buleen ko sàggane!","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Mbégte ñeel na ki may déglu,","poem":1},{"lineBreak":true},{"text":"di teewlu ca sama bunt bés bu nekk,","poem":1},{"lineBreak":true},{"text":"di ma toogaanu sama bunt kër.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ku ma daj, gudd fan,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji bége la.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ku ma moy loru,","poem":1},{"lineBreak":true},{"text":"ku ma bañ, daa repp.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}