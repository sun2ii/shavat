{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PRO","translationId":"wol_mbs","name":"Kàddu yu xelu","commonName":"Kàddu yu xelu","title":"Kàddu yu xelu","order":20,"numberOfChapters":31,"sha256":"03ac2aeb769ac1a7a3a3b19c1139778ea9ea01168d4d388fcf9c6ce9374447ab","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/wol_mbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["Xel mu Rafet a ngi berndeel"]},{"type":"verse","number":1,"content":[{"text":"Soxna si, Xel mu Rafet daa tabax këram,","poem":1},{"lineBreak":true},{"text":"yatt juróom ñaari kenoom.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mu rendi ag juram, njafaan ay biiñam, xelli,","poem":1},{"lineBreak":true},{"text":"taaj ay ndabam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xel mu Rafet yónni ay janqam,","poem":1},{"lineBreak":true},{"text":"di wootee fu kawee kawe ca dëkk ba,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"naan: «Képp ku téxét, jàddal ba fii!»","poem":1},{"lineBreak":true},{"text":"Ku ñàkk bopp, mu ne ko:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"«Kaay, ma may la, nga lekk,","poem":1},{"lineBreak":true},{"text":"xellil la biiñ bi ma njafaan, nga naan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dëddul jëfi téxét ba dund,","poem":1},{"lineBreak":true},{"text":"di jubal ci yoonu dégg.»","poem":1}]},{"type":"heading","content":["Kuy xeloo ngii ak kuy ñaawle"]},{"type":"verse","number":7,"content":[{"text":"Artu kuy ñaawle, feyoo saaga rekk,","poem":1},{"lineBreak":true},{"text":"yedd ab soxor, yooloo loraange.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bul yedd kuy ñaawle, da lay jéppi;","poem":1},{"lineBreak":true},{"text":"yeddal ku rafet xel, mu naw la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xelalal ku xelu, mu yokku.","poem":1},{"lineBreak":true},{"text":"Xamalal ku jub, mu yokk njàngam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ragal Aji Sax ji di njàlbéenu rafet xel,","poem":1},{"lineBreak":true},{"text":"xam Aji Sell ji di amug dégg.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maay Xel mu Rafet, ku ma topp gudd fan,","poem":1},{"lineBreak":true},{"text":"dund, dundati.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rafet xel, jariñu,","poem":1},{"lineBreak":true},{"text":"kuy kókkalee, wéetook sa añ.","poem":1}]},{"type":"heading","content":["Jigéen ju Dofee ngi berndeel"]},{"type":"verse","number":13,"content":[{"text":"Soxna si, Jigéen ju Dof day xumb,","poem":1},{"lineBreak":true},{"text":"reew, du xam lu xew.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Day toog bunt këram,","poem":1},{"lineBreak":true},{"text":"mbaa fu kawee kawe ca dëkk ba,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"di woo ña fay jaare","poem":1},{"lineBreak":true},{"text":"te jubal seenu yoon.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma nga naa: «Képp ku téxét, jàddal ba fii!»","poem":1},{"lineBreak":true},{"text":"Ku ñàkk bopp, mu ne ko:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Ndox mu lewul a neex,","poem":1},{"lineBreak":true},{"text":"ñamu làqu-lekk dàqati.»","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Waaye kooka du xam ne waa njaniiw a nga fa,","poem":1},{"lineBreak":true},{"text":"te ku wuyuji, tàbbi biir bàmmeel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}