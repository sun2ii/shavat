{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":10,"content":[{"type":"heading","content":["Néew-ji-doole sàkku na yoon"]},{"type":"verse","number":1,"content":[{"text":"Éy Aji Sax ji, lu la taxa sore?","poem":1},{"lineBreak":true},{"text":"Xanaa dangay làqu, bésub njàqare?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ku bon naagu na, ne dann néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"lal ay pexeem, ba jàpp ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ku bon déy a ngi tëggoo bànneexu bakkanam,","poem":1},{"lineBreak":true},{"text":"ku bëgge di ñàkke wormaaka teddadil Aji Sax ji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ku bon daŋŋiiral, seetul dara,","poem":1},{"lineBreak":true},{"text":"xalaatam yépp mooy Yàlla amul.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Saa yu fexee, juble,","poem":1},{"lineBreak":true},{"text":"te gisul sa ndigali yoon yi ko tiim.","poem":1},{"lineBreak":true},{"text":"Ma ngay ciipu bañam yépp.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma nga naan ca xelam: «Duma tërëf,","poem":1},{"lineBreak":true},{"text":"safaan du ma dab tey ak ëllëg.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ay móolu la gémmiñ ga fees ak fen ak noote,","poem":1},{"lineBreak":true},{"text":"njekkar ak ñaawtéef lal làmmiñ wa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Day tëroo ciy dëkk-dëkkaan,","poem":1},{"lineBreak":true},{"text":"làqu di bóom ku deful dara,","poem":1},{"lineBreak":true},{"text":"nëbbu di wootal néew-ji-doole.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Day làqu béreb, di yeeroo ni gaynde cim xuntam,","poem":1},{"lineBreak":true},{"text":"di yeeru aji ñàkk, ba jàpp ko,","poem":1},{"lineBreak":true},{"text":"laaw ko, ñoddi, yóbbu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma ngay sëgg aka waaf,","poem":1},{"lineBreak":true},{"text":"ba aji ñàkk daanu ci loxoom.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mu naa ca xelam: «Yàlla fàtte na,","poem":1},{"lineBreak":true},{"text":"dummóoyu na, du xoolati.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aji Sax ji, jógal!","poem":1},{"lineBreak":true},{"text":"Éy Yàlla, xàccal sa loxo.","poem":1},{"lineBreak":true},{"text":"Bul fàtte néew-ji-doole.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bul may ku bon mu sofental la,","poem":1},{"lineBreak":true},{"text":"te naan ci xelam: «Yàlla du ma ko topp.»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaw de yaay ki nemmiku,","poem":1},{"lineBreak":true},{"text":"di gis njekkar ak naqar,","poem":1},{"lineBreak":true},{"text":"ku mu dal, nga sàmm àqam.","poem":1},{"lineBreak":true},{"text":"Néew-ji-doole wéeroo la,","poem":1},{"lineBreak":true},{"text":"ab jirim, nga dimbali.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ngalla dammal loxol ku soxor ak ku bon,","poem":1},{"lineBreak":true},{"text":"topp leen seen coxor gi ñu yaakaaroon ne du feeñ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aji Sax jee di Buur ba fàww!","poem":1},{"lineBreak":true},{"text":"Xeet yeey sànku, jeex cim réewam.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaay dégg dagaanu néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"yaay dalal xelam, teewlu ko,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ngir sàmm àqu jirim ak néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"ba nit kiy suufu kese dootul xëbale.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}