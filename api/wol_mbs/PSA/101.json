{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":101,"content":[{"type":"heading","content":["Buur a ngi jaayanteek Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda, dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Ngor ak yoon laay woy.","poem":1},{"lineBreak":true},{"text":"Yaw Aji Sax ji laay joobe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naa teewlu yoonu màndute.","poem":1},{"lineBreak":true},{"text":"Ana kañ nga may dikkal?","poem":1},{"lineBreak":true},{"text":"Naa doxe màndute","poem":1},{"lineBreak":true},{"text":"fi sama biir waa kër.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Caaxaani neen, xooluma;","poem":1},{"lineBreak":true},{"text":"jëf ju wàcc yoon, bëgguma,","poem":1},{"lineBreak":true},{"text":"taqu ma fenn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuy nas njekkar, sore ma;","poem":1},{"lineBreak":true},{"text":"lu bon, xawma ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuy jëw moroomam, ma wedamal;","poem":1},{"lineBreak":true},{"text":"ku daŋŋiiral ak ku reew, muñaluma la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ku dëggu ci réew mi, ma geesu,","poem":1},{"lineBreak":true},{"text":"ngir fat ko.","poem":1},{"lineBreak":true},{"text":"Te kuy wéye màndute,","poem":1},{"lineBreak":true},{"text":"kookoo may liggéeyal.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuy njublaŋ du tooge sama kër,","poem":1},{"lineBreak":true},{"text":"kuy fen du taxaw sama kanam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maay xëy, sànk képp ku bon ci réew mi,","poem":1},{"lineBreak":true},{"text":"ngir génne ci dëkkub Aji Sax jii képp kuy def lu ñaaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}