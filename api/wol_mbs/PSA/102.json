{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":102,"content":[{"type":"heading","content":["Yàlla, bu ma rey"]},{"type":"verse","number":1,"content":[{"text":"Di ñaani néew-ji-doole ju sonn, bay diis Aji Sax ji njàqareem.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, déglul, ma ñaan la;","poem":1},{"lineBreak":true},{"text":"yal na sama yuux àgg fa yaw.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bu ma dummóoyu bésub njàqare;","poem":1},{"lineBreak":true},{"text":"teewlu ma,","poem":1},{"lineBreak":true},{"text":"gaawe ma sama bésub woote!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Samay fan a ngi wéy ni saxaar,","poem":1},{"lineBreak":true},{"text":"sama yax yi mel nib taal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sama xol bi wow ni ñax mu xuur,","poem":1},{"lineBreak":true},{"text":"ba lekk safatu ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Damaa jàq, di onk a onk,","poem":1},{"lineBreak":true},{"text":"ba desey yax.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma mel nim tan ci màndiŋ mi,","poem":1},{"lineBreak":true},{"text":"mbete looy cib gent.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nelaw të;","poem":1},{"lineBreak":true},{"text":"ma mel ni picc mu wéetoo puju néeg.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bés bu ne noon yi di ma sewal;","poem":1},{"lineBreak":true},{"text":"ñi may ñaawal di móoloo sama tur.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lekkuma xanaa di diwoob dóom, toroxloo;","poem":1},{"lineBreak":true},{"text":"te lu ma naan, tuur ca rongooñ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"te sa mer ak sa xadar a tax,","poem":1},{"lineBreak":true},{"text":"nde yaa ma fab, xalab.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ker a ngi law, nara mëdd samay fan.","poem":1},{"lineBreak":true},{"text":"Maa ngi wowat nim ñax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Waaye yaw Aji Sax ji, yaay des ba fàww,","poem":1},{"lineBreak":true},{"text":"saw tur saxal maasoo maas.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaw yaay taxaw, ñeewante Siyoŋ,","poem":1},{"lineBreak":true},{"text":"ndax baaxe ko jot na,","poem":1},{"lineBreak":true},{"text":"àpp ba kay mat na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sa jaam ñeeka sopp doji dëkk bii ñu màbb,","poem":1},{"lineBreak":true},{"text":"ñoo ñeewante tojiti gentam bii.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Na xeet yi wormaal turu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"buuri àddina sépp wormaal darajaam,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"nde Aji Sax jeey tabaxaat Siyoŋ,","poem":1},{"lineBreak":true},{"text":"nara feeñeg leeram.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mooy nangul aji tumurànke,","poem":1},{"lineBreak":true},{"text":"xeebul ñaanam.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nañu bindal lii maasug ëllëg,","poem":1},{"lineBreak":true},{"text":"ba xeet wu sosoogul màggal Ki Sax,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"nde Aji Sax jeey jéere fu sellam fa ca kaw,","poem":1},{"lineBreak":true},{"text":"di niire suuf fa asamaan,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ngir teewlu onki ñi ñu tëj,","poem":1},{"lineBreak":true},{"text":"nara ubbi ñi dee di seen àtte,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ba ñu siiwal turu Aji Sax ji fi Siyoŋ,","poem":1},{"lineBreak":true},{"text":"màggale ko fi Yerusalem,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"kera ba xeet yiy bokk daje,","poem":1},{"lineBreak":true},{"text":"ñook réew yi, ngir jaamu Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Sama digg doole la ma semmale,","poem":1},{"lineBreak":true},{"text":"gàttal samaw fan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma ne: «Éy sama Yàlla, maasoo maas, say at du jeex.","poem":1},{"lineBreak":true},{"text":"Bu ma yóbboo sama diggi fan.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bu yàgg nga samp suuf,","poem":1},{"lineBreak":true},{"text":"sàkke asamaan say loxo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yooyu day réer,","poem":1},{"lineBreak":true},{"text":"waaye yaw yaay sax,","poem":1},{"lineBreak":true},{"text":"lépp ay ràpp ni mbubb,","poem":1},{"lineBreak":true},{"text":"nga soppi leen niy yére, sànni;","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"te yaw ngay kenn ki,","poem":1},{"lineBreak":true},{"text":"te say at amul kem.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sa doomi jaam ñeey dëkk;","poem":1},{"lineBreak":true},{"text":"seen askan sax fi sa kanam.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":29}