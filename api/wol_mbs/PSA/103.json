{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":103,"content":[{"type":"heading","content":["Ma sant Aji Sax ji"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Naa sant Aji Sax ji ci saa xol bii,","poem":1},{"lineBreak":true},{"text":"saa jëmm jépp di sàbbaal sellaayu turam!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naa sant Aji Sax ji ci saa xol bii,","poem":1},{"lineBreak":true},{"text":"te baña fàtte mboolem xéewalam!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moo lay baal foo ñaawe,","poem":1},{"lineBreak":true},{"text":"di la wéral foo woppe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mooy jot sa bakkan,","poem":1},{"lineBreak":true},{"text":"kaalaa la ngor ak yërmande,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"di reggal sa bakkan bànneex,","poem":1},{"lineBreak":true},{"text":"yeesalal lag ndaw,","poem":1},{"lineBreak":true},{"text":"nga màggataale doole nig jaxaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aji Sax jeey àtte njub,","poem":1},{"lineBreak":true},{"text":"di àtte dëgg jépp néew-ji-doole.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moo xamal Musaa ay nammeelam,","poem":1},{"lineBreak":true},{"text":"xamal bànni Israayil ay jëfam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yiw ak yërmande, fa Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Moo muñ mer te bare ngor.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Saxoowul di toppe,","poem":1},{"lineBreak":true},{"text":"dencul mer ba fàww.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Du sunuy bàkkaar la nu mbugal,","poem":1},{"lineBreak":true},{"text":"du sunuy ñaawtéef la nu fey.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ni asamaan tiime suuf,","poem":1},{"lineBreak":true},{"text":"ni la ngoram yiire ku ko ragal.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ni penku soree sowu,","poem":1},{"lineBreak":true},{"text":"ni la nu soreleek sunu mbugali tooñ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ni baay yërëme doom,","poem":1},{"lineBreak":true},{"text":"ni la Aji Sax ji yërëme ku ko ragal.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moo xam sunu bind,","poem":1},{"lineBreak":true},{"text":"di bàyyi xel ne pënd lanu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nit aki fanam di saxyaay","poem":1},{"text":"suy law ni tóor-tóoru àll;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ngelaw li wal, mu ne mes,","poem":1},{"lineBreak":true},{"text":"mel ni masu faa nekk.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Waaye ngorug Aji Sax ji naka jekk","poem":1},{"lineBreak":true},{"text":"ñeel na fàww ku ko ragal;","poem":1},{"lineBreak":true},{"text":"àtteb dëggam ñeel sëtaati","poem":1}]},{"type":"verse","number":18,"content":[{"text":"kuy sàmm kóllëreem,","poem":2},{"lineBreak":true},{"text":"di saxoo jëfe tegtali yoonam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Aji Sax jee samp asamaan ab jalam,","poem":1},{"lineBreak":true},{"text":"nguuram ŋank lépp.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yeen malaaka yi, santleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"yeen jàmbaar yu mag yiy jëfe ndigalam,","poem":1},{"lineBreak":true},{"text":"di sàmm kàddoom.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Santleen Aji Sax ji, yeen gàngoori xareem yépp,","poem":1},{"lineBreak":true},{"text":"yeen dagam yiy jëfe coobareem.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yeen mbindeef yépp, nangeen sante Aji Sax ji","poem":1},{"lineBreak":true},{"text":"fépp fu mu tiim.","poem":1},{"lineBreak":true},{"text":"Naa sant Aji Sax ji ci saa xol bii!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}