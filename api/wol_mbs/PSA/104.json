{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":104,"content":[{"type":"heading","content":["Màggalleen Ki sàkk lépp"]},{"type":"verse","number":1,"content":[{"text":"Naa sant Aji Sax ji ci saa xol bii!","poem":1},{"lineBreak":true},{"text":"Aji Sax ji sama Yàlla, yaaka màgga màgg.","poem":1},{"lineBreak":true},{"text":"Teddngaak","poem":1},{"noteId":27},{"text":"daraja nga soloo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"làmboo leer ni mbubb,","poem":1},{"lineBreak":true},{"text":"firi asamaan ni ndimo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"xadd say néegi kaw ci biir ndox mi,","poem":1},{"lineBreak":true},{"text":"def niir yi say waruwaay,","poem":1},{"lineBreak":true},{"text":"di daagoo kaw laafi ngelaw,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"def ngelaw yi say ndaw,","poem":1},{"lineBreak":true},{"text":"ay sawara boy, di say jawriñ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaa dëj suuf ci fondmaam,","poem":1},{"lineBreak":true},{"text":"deesu ko yëngal ba fàww.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaa ko sànge xóotey géej ni mbubb,","poem":1},{"lineBreak":true},{"text":"ndox ma taxaw, tiim tund ya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nga gëdd, ndox ma fëx;","poem":1},{"lineBreak":true},{"text":"nga dënu, mu daw,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"wale kaw tund ya, wàccsi xur ya,","poem":1},{"lineBreak":true},{"text":"di béreb ba nga ko beral.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ag kemu nga teg, du ko wees,","poem":1},{"lineBreak":true},{"text":"te dootul muur suuf si.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yaa ballal bëti ndox ya ca xur ya,","poem":1},{"lineBreak":true},{"text":"ñuy wale digg tund ya,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ngay nàndal bépp ndundatu àll,","poem":1},{"lineBreak":true},{"text":"di wëgg mbaamu àll,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"njanaaw dëkke ca wet ga,","poem":1},{"lineBreak":true},{"text":"baatam jibe fa garab ya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaa suuxate tund ya fa sa néegi kaw,","poem":1},{"lineBreak":true},{"text":"sa liggéey reggal suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yaa saxalal jur gi ñax","poem":1},{"lineBreak":true},{"text":"ak gàncax gu doom aadama di bey,","poem":1},{"lineBreak":true},{"text":"ba génnee ab dund fi suuf,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"dugub di ko dooleel,","poem":1},{"lineBreak":true},{"text":"biiñ di bégal xolam,","poem":1},{"lineBreak":true},{"text":"ag diw di leeral kanamam.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Garabi Aji Sax ja, seedari Libaŋ","poem":1},{"text":"ya mu jëmbat, regg nañu,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"picc tàgge ca,","poem":1},{"lineBreak":true},{"text":"xodd dëkke garab gu dul ruus,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"tund wu mag ñeel kéwéli àll,","poem":1},{"lineBreak":true},{"text":"doj yi di rawtub daman","poem":1},{"noteId":28},{"text":".","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yaa sàkk weer, muy takku jamono,","poem":1},{"lineBreak":true},{"text":"sàkk jant, mu xam waxtuw fatoom.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yaa def lëndëm, mu guddi;","poem":1},{"lineBreak":true},{"text":"bépp rabu àll di ca dox,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"gaynde gu mat ŋaral am pàddam,","poem":1},{"lineBreak":true},{"text":"di sàkkoo dundam fa Yàlla.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bu jant fenkee, ñu dellu,","poem":1},{"lineBreak":true},{"text":"goori ca seeni pax,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"doom aadama tàmbali kër-këram,","poem":1},{"lineBreak":true},{"text":"di yendoo liggéey ba ngoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Éy Aji Sax ji, yaa bare loo liggéey,","poem":1},{"lineBreak":true},{"text":"te lépp di xel mu rafet.","poem":1},{"lineBreak":true},{"text":"Suuf daa fees ak say càkkéef.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Géej a ngee réy te yaa,","poem":1},{"lineBreak":true},{"text":"la fay yëngu maneesu koo lim,","poem":1},{"lineBreak":true},{"text":"muy ndundat lu mag ak lu ndaw.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fa la gaal di daw,","poem":1},{"lineBreak":true},{"text":"ak ngaaka la nga bind, mu di fa fowe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ñoom ñépp yaw lañuy séentu,","poem":1},{"lineBreak":true},{"text":"ngir bu jotee, nga leel leen,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"may leen lu ñu for;","poem":1},{"lineBreak":true},{"text":"ŋëbal leen, ñu suur ngëneel.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Soo leen làqoo, ñu tiit;","poem":1},{"lineBreak":true},{"text":"nga rocci seen noo, ñu saay,","poem":1},{"lineBreak":true},{"text":"dellu di pënd.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yaay yónnee sag noo, ñu nekk;","poem":1},{"lineBreak":true},{"text":"te yaay yeesal li ci kaw suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yal na darajay Aji Sax ji sax,","poem":1},{"lineBreak":true},{"text":"yal na Aji Sax ji bégey jalooreem.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kee naan jàkk suuf, muy lox;","poem":1},{"lineBreak":true},{"text":"mu laal tund yi, ñuy saxaar!","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Naa woy Aji Sax ji li feek may dund,","poem":1},{"lineBreak":true},{"text":"naa kañ sama Yàlla li feek may tooy.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Sama xalaat bii, yal na ko neex.","poem":1},{"lineBreak":true},{"text":"Man de maa ngi bége Aji Sax ji!","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yal na bàkkaarkat raaf fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"te ku bon noppee nekk.","poem":1},{"lineBreak":true},{"text":"Naa sant Aji Sax ji ci saa xol bii.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"104.1 Teddnga mooy teraanga ju bare lool.","reference":{"chapter":104,"verse":1}},{"noteId":28,"caller":"+","text":"104.18 daman xaw naa nirook njomboor.","reference":{"chapter":104,"verse":18}}]},"thisChapterLink":"/api/wol_mbs/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}