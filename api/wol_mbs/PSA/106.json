{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":106,"content":[{"type":"heading","content":["Israayil di wor, Yàlla di ku wóor"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Santleen Aji Sax ji, kee baax,","poem":1},{"lineBreak":true},{"text":"kee saxoo ngoram!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ana ku mana tudd jaloorey Aji Sax ji?","poem":1},{"lineBreak":true},{"text":"Ana ku mana teesal woyam?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndokkalee kuy sàmm yoon,","poem":1},{"lineBreak":true},{"text":"di def njekk fu mu tollu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, séddaale ma ci sa yiwu ñoñ,","poem":1},{"lineBreak":true},{"text":"ngalla, dikke ma sag wall,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ma gis ngëneelu ñi nga tànn,","poem":1},{"lineBreak":true},{"text":"di bànneexoo sa bànneexu xeet wi,","poem":1},{"lineBreak":true},{"text":"tey damoondook ñoom ñi nga séddoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Noo bàkkaar, nook sunuy maam;","poem":1},{"lineBreak":true},{"text":"noo def lu ñaaw, def lu bon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sunuy maam seetuñu ca say kéemaan ca Misra,","poem":1},{"lineBreak":true},{"text":"bàyyiwuñu xel ca sa ngor lu réy,","poem":1},{"lineBreak":true},{"text":"xanaa di fippu ca géej ga, géeju Barax ya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Teewul Yàlla wallu leen ngir turam,","poem":1},{"lineBreak":true},{"text":"ba xamle njàmbaaram.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dafa gëdd géeju Barax ya, mu ne sereŋ;","poem":1},{"lineBreak":true},{"text":"xóotey géej mel ni màndiŋ, mu jàlle leen,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"musal leen ci loxol bañaale,","poem":1},{"lineBreak":true},{"text":"jote leen ca loxol noon ba,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ndox ma mëdd bañ ya,","poem":1},{"lineBreak":true},{"text":"kenn desu ca.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ca lañu gëm ay waxam,","poem":1},{"lineBreak":true},{"text":"woy ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nes tuut ñu fàtte jëfam ja,","poem":1},{"lineBreak":true},{"text":"xaaratuñu ndigalam,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"di ŋaf-ŋafi ca màndiŋ ma,","poem":1},{"lineBreak":true},{"text":"di diiŋat Yàlla ca àll ba.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yàlla jox leen la ñuy sàkku,","poem":1},{"lineBreak":true},{"text":"wàccaaleel leen woppi ràgg.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ba ñu demee ba iñaane Musaa ca dal ba,","poem":1},{"lineBreak":true},{"text":"boole ca Aaróona mu sell ma, nitu Aji Sax ja,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"suuf a ne ŋafeet, wann Datan","poem":1},{"noteId":30},{"text":",","poem":1},{"lineBreak":true},{"text":"mëddaale gàngooru Abiram;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"sawara ne jippét fa seen biir,","poem":1},{"lineBreak":true},{"text":"tàkk ba lakk ñu bon ñooña.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tëgg nañu aw nag ca tundu Xoreb,","poem":1},{"lineBreak":true},{"text":"di sujjóotal jëmm ju ñu móol,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"di jënde seen darajay Yàlla ja","poem":1},{"lineBreak":true},{"text":"jëmmu nag wuy forum ñax.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dañoo fàtte Yàlla ma leen di musal","poem":1},{"lineBreak":true},{"text":"te def jaloore ca Misra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mooy kéemaan ya fa réewum Xam","poem":1},{"noteId":31},{"text":",","poem":1},{"lineBreak":true},{"text":"kiraama ya ca géeju Barax ya.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yàlla da leen doon sànk,","poem":1},{"lineBreak":true},{"text":"bu dul woon ak Musaa, xejjam","poem":1},{"lineBreak":true},{"text":"ba ko kar, àtte leen,","poem":1},{"lineBreak":true},{"text":"mu giif, ba faru leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dañoo gàntal réew mu neex,","poem":1},{"lineBreak":true},{"text":"gëmuñu kàddug Yàlla,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"xanaa di xultoo seen biiri xayma,","poem":1},{"lineBreak":true},{"text":"baña déggal Aji Sax ji.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Moo tax mu giñal leen","poem":1},{"lineBreak":true},{"text":"ne dina leen tëral fa màndiŋ ma,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"tëral seen askan ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"wasaare leen ci réew yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ñuy darook tuurum Baal Pewor,","poem":1},{"lineBreak":true},{"text":"di lekk lu ñu sarxal ay yàlla yu amul bakkan,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"di merloo Yàlla ci seeni jëf,","poem":1},{"lineBreak":true},{"text":"ba mbas ne dàll fa seen biir.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Fineyas taxaw, àtte;","poem":1},{"lineBreak":true},{"text":"mbas ma dal,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"muy àtteb njub bu ñu ko waññal","poem":1},{"lineBreak":true},{"text":"tey ak ëllëg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ñu merlooti Yàlla ca ndoxum Meriba ma,","poem":1},{"lineBreak":true},{"text":"muy loraangey Musaa te ñoo ko waral.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ñoo naqaral Musaa,","poem":1},{"lineBreak":true},{"text":"ba mu wax wax ju ko rëcc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Te it faagaagaluñu yéefar","poem":1},{"text":"ya leen Aji Sax ji waxoon,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"xanaa di jaxasook yéefar yooya,","poem":1},{"lineBreak":true},{"text":"di roy seeni jëf,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"di jaamu seeni tuur,","poem":1},{"lineBreak":true},{"text":"mu mujj dig fiir ca ñoom.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ñuy rendil rab ya","poem":1},{"lineBreak":true},{"text":"seen doom yu góor ak yu jigéen,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"di tuur deretu ñu deful dara,","poem":1},{"lineBreak":true},{"text":"te muy seen deretu doom yu góor ak yu jigéen","poem":1},{"text":"ya ñu sarxalal tuuri Kanaaneen ña,","poem":2},{"text":"deret ja sobeel réew ma,","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"seeni jëf sobeel leen,","poem":1},{"lineBreak":true},{"text":"ndax seen bokkaale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Aji Sax ji mere ñoñam,","poem":1},{"lineBreak":true},{"text":"sib xeet woowu mu séddoo,","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"ba tax mu teg leen ca loxol yéefar ya,","poem":1},{"lineBreak":true},{"text":"seeni bañ yilif leen,","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"seen noon ya noot leen,","poem":1},{"lineBreak":true},{"text":"ñu torox ca seeni loxo.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ay yooni yoon la leen xettali,","poem":1},{"lineBreak":true},{"text":"teewul ñuy nas pexey fippu,","poem":1},{"lineBreak":true},{"text":"ba suux ci seeni ñaawtéef.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Mu gis nag seen njàqare,","poem":1},{"lineBreak":true},{"text":"dégg seeni tinu,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"bàyyi xel ci kóllëreem ak ñoom,","poem":1},{"lineBreak":true},{"text":"topp ngoram lu réy, ba giif,","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"xiir ña leen jàpp ñépp,","poem":1},{"lineBreak":true},{"text":"ñu yërëm leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Éy Aji Sax ji, sunu Yàlla, wallu nu,","poem":1},{"lineBreak":true},{"text":"génnee nu ci xeet yi, dajale nu,","poem":1},{"lineBreak":true},{"text":"nu sante laak sa tur wu sell,","poem":1},{"lineBreak":true},{"text":"di sagoo sa teddaay.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Santleen Aji Sax ji Yàllay Israayil","poem":1},{"lineBreak":true},{"text":"cant gu sax dàkk, ba fàww.","poem":1},{"lineBreak":true},{"text":"Na mbooloo ma mépp ne: «Amiin!»","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"106.17 Datan: seetal ci Màndiŋ ma 16.27, 31-33.","reference":{"chapter":106,"verse":17}},{"noteId":31,"caller":"+","text":"106.22 réewum Xam mooy Misra ba tey.","reference":{"chapter":106,"verse":22}}]},"thisChapterLink":"/api/wol_mbs/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}