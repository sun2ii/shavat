{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":107,"content":[{"type":"heading","content":["Aji Sax jeey xettalee"]},{"type":"verse","number":1,"content":[{"text":"Santleen Aji Sax ji, kee baax,","poem":1},{"lineBreak":true},{"text":"kee saxoo ngoram!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waxleen lii, yeen ñi Aji Sax ji jot,","poem":1},{"lineBreak":true},{"text":"jote leen ci loxol bañ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"dajalee leen fa réew ya,","poem":1},{"lineBreak":true},{"text":"jële leen penkook sowu,","poem":1},{"lineBreak":true},{"text":"ak bëj-gànnaar ak wetu géej.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ñee ngi taxawaaloo màndiŋ mu wéet,","poem":1},{"lineBreak":true},{"text":"gisuñu dëkkuwaay,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"boole xiif ak mar,","poem":1},{"lineBreak":true},{"text":"ba bakkan di tàggoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ñu jàq, woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"mu xettali leen ci seen njàqare,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"jaarale leen ci yoon wu jub,","poem":1},{"lineBreak":true},{"text":"ngir ñu àgg cib dëkk.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nañu sante Aji Sax ji ngoram","poem":1},{"lineBreak":true},{"text":"ak kéemaanam yi ñeel doom aadama yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mooy màndal put gu wow,","poem":1},{"lineBreak":true},{"text":"di feesal ngëneel biir bu wéet.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ñee ngi dëkke lëndëm gu tar,","poem":1},{"lineBreak":true},{"text":"ñu yeewe leen jéngi weñ yu tar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ñoo gàntal waxi Yàlla,","poem":1},{"lineBreak":true},{"text":"néewal ndigalal Aji Kawe ji.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu teg leen naqar, ba toroxal leen,","poem":1},{"lineBreak":true},{"text":"ñu ne nërëm te kenn walluwu leen.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñu jàq, woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"mu wallu leen ci seen njàqare,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"xar seeni jéng ñaar,","poem":1},{"lineBreak":true},{"text":"génnee leen lëndëm gu tar.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nañu sante Aji Sax ji ngoram","poem":1},{"lineBreak":true},{"text":"ak kéemaanam yi ñeel doom aadama yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Moo rajaxe bunti xànjar,","poem":1},{"lineBreak":true},{"text":"damm galani weñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ñu dofe ñalee ngi topp yoonu moy,","poem":1},{"lineBreak":true},{"text":"loroo seeni ñaawtéef,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"bàyyi luy ñam di daw seen yaram,","poem":1},{"lineBreak":true},{"text":"ñu jege bunti dee.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ñu jàq, woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"mu wallu leen ci seen njàqare.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Daa yónnee kàddoom, wéral leen,","poem":1},{"lineBreak":true},{"text":"këfe leen cim yeer.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nañu sante Aji Sax ji ngoram","poem":1},{"lineBreak":true},{"text":"ak kéemaanam yi ñeel doom aadama yi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nañ ko sarxal saraxi cant","poem":1},{"lineBreak":true},{"text":"tey sarxolle, siiwale koy jalooreem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ña ca des a ngi war gaal, dugg géej,","poem":1},{"lineBreak":true},{"text":"di liggéeye mbeex mu ne xéew.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ñooñoo seede jaloorey Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ak kéemaanam ya fa xóote ya.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Day àddu, sant ngëlén,","poem":1},{"lineBreak":true},{"text":"mu yékkati gannax yi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gannax ya fettax ba ca kaw-a-kaw,","poem":1},{"lineBreak":true},{"text":"xàwweekoo fa, tàbbi xóote ya.","poem":1},{"lineBreak":true},{"text":"Ñu jàq ba fit ne soyox,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"di jang, di kayaŋ-kayaŋi niy màndikat,","poem":1},{"lineBreak":true},{"text":"pexe jeex.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ñu jàq, woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"mu génne leen ci seen njàqare,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"dalal ngëlén la,","poem":1},{"lineBreak":true},{"text":"gannax ya selaw,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ne tekk, ñu bég,","poem":1},{"lineBreak":true},{"text":"mu gindi leen ba fa ñu bëgga teer.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nañu sante Aji Sax ji ngoram","poem":1},{"lineBreak":true},{"text":"ak kéemaanam yi ñeel doom aadama yi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nañu ko kañe ndajem mbooloo mi,","poem":1},{"lineBreak":true},{"text":"di ko màggale péncum mag ñi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Mooy soppi wali ndox màndiŋ,","poem":1},{"lineBreak":true},{"text":"soppi bëti ndox suuf su ne sereŋ,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"suuf su nangu doon jooru xorom","poem":1},{"lineBreak":true},{"text":"ndax mbonug ña ko dëkke.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Mooy soppi màndiŋ it, ndox ya taa,","poem":1},{"lineBreak":true},{"text":"soppi suuf su ne sereŋ bëti ndox;","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"dëël fa ñu xiif,","poem":1},{"lineBreak":true},{"text":"ñu sanc fab dëkk, dëkke,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"ji ay tool, jëmbat ay reseñ,","poem":1},{"lineBreak":true},{"text":"mu meññ, ñoral,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Aji Sax ji barkeel, ñu giir a giir,","poem":1},{"lineBreak":true},{"text":"te wàññiwul seenug jur.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Bu ñu wàññikoo, ba néew doole","poem":1},{"lineBreak":true},{"text":"ndax nooteel ak coonooku tiis,","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Aji Sax ji sib seen njiit yi leen noot,","poem":1},{"lineBreak":true},{"text":"wërloo leen àll bu amul yoon.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Waaye mooy teggil néew-ji-doole coonoom,","poem":1},{"lineBreak":true},{"text":"ful njabootam nig jur,","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"aji jub ñi gis ko, bég;","poem":1},{"lineBreak":true},{"text":"mboolem ku bon wedam.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ku xelu ku ne, na ràññee lii","poem":1},{"lineBreak":true},{"text":"te seede li Aji Sax ji jëfe ngoram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}