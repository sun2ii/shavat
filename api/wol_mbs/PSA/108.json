{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":108,"content":[{"type":"heading","content":["Yàlla, may nu ndam"]},{"type":"verse","number":1,"content":[{"text":"Di woyu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yàlla, dogu naa,","poem":1},{"lineBreak":true},{"text":"damay woy, di la kañ;","poem":1},{"lineBreak":true},{"text":"sama jëmm jépp di la woy.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na xalam ak moroom ma yewwu,","poem":1},{"lineBreak":true},{"text":"ma yee leeru njël.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji, dama lay gërëm ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"kañ la ci biir waaso yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa ngor a màgg ba sut asamaan,","poem":1},{"lineBreak":true},{"text":"sa worma àkki fa kaw-a-kaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Éy Yàlla, yaa màgg ba sut asamaan,","poem":1},{"lineBreak":true},{"text":"sag leer tiim suuf sépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Walloo nu sa ndijoor,","poem":1},{"lineBreak":true},{"text":"nangul ma,","poem":1},{"lineBreak":true},{"text":"ba say soppe xettaliku.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yàllaa àddoo fa këram gu sell,","poem":1},{"lineBreak":true},{"text":"ne: «Maay damu, dogat suufas Sikem,","poem":1},{"lineBreak":true},{"text":"séddale xuru Sukkót.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Maa moom diiwaanu Galàdd, moom Manase,","poem":1},{"lineBreak":true},{"text":"Efrayim di sama mbaxanam xare,","poem":1},{"lineBreak":true},{"text":"Yuda di sama yetu nguur,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"réewum Mowab di sama ndabal raxasukaay,","poem":1},{"lineBreak":true},{"text":"Edom, ma teg tànk;","poem":1},{"lineBreak":true},{"text":"Filisti, ma xaacoo fa.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Éy Yàlla, ana ku may yóbbu dëkk ba tata wër?","poem":1},{"lineBreak":true},{"text":"Ku may jiite ba Edom?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàlla, xanaa du yaa nu wacc?","poem":1},{"lineBreak":true},{"text":"Éy Yàlla, yaa baña ànd ak sunu mboolooy xare?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ngalla dimbali nu ci bañaale;","poem":1},{"lineBreak":true},{"text":"doom aadama, wallam neen la.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nook Yàlla, nu def njàmbaar;","poem":1},{"lineBreak":true},{"text":"moom mooy noot sunuy noon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}