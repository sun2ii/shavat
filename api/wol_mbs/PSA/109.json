{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":109,"content":[{"type":"heading","content":["Yal na Yàlla mbugal noon bi"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ñeel Daawuda, dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Éy Yàlla mi may sant, bul tanqamlu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ku bon ak kuy fen a ma waxal,","poem":1},{"lineBreak":true},{"text":"sosal ma,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tance ma kàdduy mbañeel,","poem":1},{"lineBreak":true},{"text":"song ma ci dara.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma ji nit cofeel, mu sosal ma;","poem":1},{"lineBreak":true},{"text":"te man ma di ko ñaanal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sama jëf ju baax, loraange lañu ma ko feye,","poem":1},{"lineBreak":true},{"text":"sama cofeel, ñu feye ma ko mbañeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yal nanga fal ku bon ci kaw kii,","poem":1},{"lineBreak":true},{"text":"ab soskat féete ko ndijoor.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ñu koy àtte, yal nañu ko yey,","poem":1},{"lineBreak":true},{"text":"te yal na ñaanam walbatiku di bàkkaar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yal naw fanam gàtt,","poem":1},{"lineBreak":true},{"text":"keneen jagoo sasam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yal nay doomam diy jirim,","poem":1},{"lineBreak":true},{"text":"jabaram dib jëtun,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ay doomam di tambaambaluy yalwaan,","poem":1},{"lineBreak":true},{"text":"dëddu seeni gent, dem tàllal ay yoxo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yal na ko kuy feyeeku futti,","poem":1},{"lineBreak":true},{"text":"ay doxandéem foqati ñaqam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàlla bu ko kenn ji ngor,","poem":1},{"lineBreak":true},{"text":"yàlla bu kenn baaxe jirim yi ko wuutu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yal na askanam seey.","poem":1},{"lineBreak":true},{"text":"Balaa geneen maas a wéy, yal na seenu tur fey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yal na Aji Sax ji bàyyi xel ñaawtéefi maamam.","poem":1},{"lineBreak":true},{"text":"Yàlla bu bàkkaaru ndeyam faru.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yal na seeni moy sax fi kanam Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Yal na seen tur fare fi kaw suuf.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Moo séddul ngor,","poem":1},{"lineBreak":true},{"text":"di topp ku néewle te sonn,","poem":1},{"lineBreak":true},{"text":"seen xol jeex, mu bóom.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Moo soppoon di móoloo, yal na ko këppoo;","poem":1},{"lineBreak":true},{"text":"soppul ag ñaan it, yal na ko barke sore.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Móolook sol mbubb la yemale,","poem":1},{"lineBreak":true},{"text":"yal nañu duy ay móoloom ci yaramam nim ndox,","poem":1},{"lineBreak":true},{"text":"mu seeb ci biiri yaxam nig diw.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yal nay móoloom di mbubbam,","poem":1},{"lineBreak":true},{"text":"te di laxasaay gu mu saxoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lii, yal na ko Aji Sax ji feye ñi may sosal,","poem":1},{"lineBreak":true},{"text":"di teg lu ñaaw ci sama der.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Waaye Boroom bi Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"defal ma li sa tur laaj.","poem":1},{"lineBreak":true},{"text":"Yaa baax, gore, xettali ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Damaa néewle te sonn,","poem":1},{"lineBreak":true},{"text":"sama xol dagg, ba jeex tàkk.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Maa ngi tàggoo ni keru ngoon,","poem":1},{"lineBreak":true},{"text":"ñu di ma fél ni soccet.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Samay óom a ngi nasax ndax ñàkka lekk,","poem":1},{"lineBreak":true},{"text":"desewuma lu moy yaxi neen.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Maa ngii, ñu di ma sewal,","poem":1},{"lineBreak":true},{"text":"ku ma gis, wëcc bopp.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, sama Yàlla, dimbali ma,","poem":1},{"lineBreak":true},{"text":"walloo ma sa ngor,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ba ñu xam ne lii sa loxoo,","poem":1},{"lineBreak":true},{"text":"xam ne yaw Aji Sax ji, yaa ko def.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ñooy móolu, yaw nga barkeel;","poem":1},{"lineBreak":true},{"text":"ñoo ma jógal, ñooy torox,","poem":1},{"lineBreak":true},{"text":"man, ma bég, Sang bi!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yal na ñi may sosal sàngoo toroxte,","poem":1},{"lineBreak":true},{"text":"làmboo gàcce ni mbubb.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ma àddu, sant a sant Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di ko màggale digg mbooloo mu yaa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mooy féete ndijoor néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"musal ko ci ku koy teg àtteb dee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}