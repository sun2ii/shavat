{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":11,"content":[{"type":"heading","content":["Ma làqoo Aji Sax ji"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji laa làqoo.","poem":1},{"lineBreak":true},{"text":"Ana lu ngeen ma naa: «Neel fëyy ni picc, toŋi sa kaw tund.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xanaa du ñu soxor ñaa ngii, bank seen xala,","poem":1},{"lineBreak":true},{"text":"nas seenu fitt,","poem":1},{"lineBreak":true},{"text":"nara lëndëmtu, jam ku jub?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bu ponki dëgg màbbee,","poem":1},{"lineBreak":true},{"text":"nu aji jub ñi di def?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax jaa nga ca këram gu sell.","poem":1},{"lineBreak":true},{"text":"Aji Sax jaa nga ca asamaan, ca kaw jalam,","poem":1},{"lineBreak":true},{"text":"ne jàkk doom aadama, di ko seetlu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax ji day seetlu ku jub;","poem":1},{"lineBreak":true},{"text":"ku soxor, bëgg fitna, mu bañ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Day tawal ku bon ay mbugal;","poem":1},{"lineBreak":true},{"text":"sawaraak tamarax akub jaas dib añam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax jee jub, sopp njub;","poem":1},{"lineBreak":true},{"text":"kuy jubal, gis yiwam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}