{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":110,"content":[{"type":"heading","content":["Yàlla fal na nitam"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda, dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji daa wax sama Sang, ne ko:","poem":1},{"lineBreak":true},{"text":"«Toogeel sama ndijoor,","poem":1},{"lineBreak":true},{"text":"ba ma def say noon sa ndëggastal.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sa nguur la Aji Sax ji saxal, dale ko fa Siyoŋ.","poem":1},{"lineBreak":true},{"text":"Yilifal noon yi la wër!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa mboolooy taxawal seen bopp,","poem":1},{"lineBreak":true},{"text":"sa bésub xare.","poem":1},{"lineBreak":true},{"text":"Ñu sol darajaak cellte,","poem":1},{"lineBreak":true},{"text":"faboo fa njël sosoo,","poem":1},{"lineBreak":true},{"text":"diy ndaw, wàccsil la, nib lay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax jee ko giñ,","poem":1},{"lineBreak":true},{"text":"te du dellu gannaaw:","poem":1},{"lineBreak":true},{"text":"«Yaa dib sarxalkat ba fàww,","poem":1},{"lineBreak":true},{"text":"topp dayob Melkiccedeg","poem":1},{"noteId":32},{"text":".»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sang baa ngi fi sa ndijoor","poem":1},{"lineBreak":true},{"text":"te mooy rajaxe buur yi, bés bu meree.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mooy mbugal xeet yi, jal seeni néew,","poem":1},{"lineBreak":true},{"text":"di rajaxe kilifay àddina, ba mu daj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Déeg ba feggook yoon wa, Buur a cay naan,","poem":1},{"lineBreak":true},{"text":"te moo ko tax di siggi.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"110.4 Melkiccedeg, buurub Salem la woon, di sarxalkat bu Yàlla faloon ci jamonoy Ibraayma, maanaam ñeenti téeméeri at laata Aaróonaa doon ab sarxalkat.","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/wol_mbs/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}