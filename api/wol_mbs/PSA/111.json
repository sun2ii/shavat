{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":111,"content":[{"type":"heading","content":["Yàlla la ay mbiram sax"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Naa sante Aji Sax ji léppi xol","poem":1},{"lineBreak":true},{"text":"ci biir ñu jub ñi bokk jataay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Liggéeyi Aji Sax ji réy na,","poem":1},{"lineBreak":true},{"text":"ku ko safoo di ko gëstu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jëfam di teddngaak","poem":1},{"noteId":33},{"text":"daraja,","poem":1},{"lineBreak":true},{"text":"njubteem di sax ba fàww.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moo dogal ñuy fàttalikuy kéemaanam;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji boroom yiw ak yërmande.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mooy leel ku ko ragal,","poem":1},{"lineBreak":true},{"text":"di bàyyi xel kóllëreem gi ba fàww.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Won na ñoñam dooley jëfam,","poem":1},{"lineBreak":true},{"text":"ba mu leen joxee suufu xeet yi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ay jëfam dëgg laak yoon,","poem":1},{"lineBreak":true},{"text":"tegtalam yépp mata wóolu,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"laloo dëgg ak njub,","poem":1},{"lineBreak":true},{"text":"te sax dàkk ba fàww.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moo yónnee xeetam wall,","poem":1},{"lineBreak":true},{"text":"fas ak ñoom kóllëre gu sax.","poem":1},{"lineBreak":true},{"text":"Kee sell te jara ragal!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ragal Aji Sax ji di njàlbéenu rafet xel,","poem":1},{"lineBreak":true},{"text":"dég-dég bu rafet ñeel ku koy wéye.","poem":1},{"lineBreak":true},{"text":"Moo yeyoo cant ba fàww.","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"111.3 teddnga mooy teraanga ju bare lool.","reference":{"chapter":111,"verse":3}}]},"thisChapterLink":"/api/wol_mbs/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}