{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":112,"content":[{"type":"heading","content":["Ku ragal Yàlla gis mbaaxam"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Ndokkalee ku ragal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di tàqamtikoo ay santaaneem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aw askanam ay am doole ci réew mi.","poem":1},{"lineBreak":true},{"text":"Ku jub saw xeet barkeel,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"alal ak koom am sa kër,","poem":1},{"lineBreak":true},{"text":"sag jëf yu jekk sax dàkk.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ceeñeeru biir lëndëm jollil na ku jub","poem":1},{"lineBreak":true},{"text":"ak ku baax, di boroom yërmande ak njubte.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ki baaxle mooy ki laabiir, di leble,","poem":1},{"lineBreak":true},{"text":"di jëflante cig njub.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ku jub du tërëf mukk,","poem":1},{"lineBreak":true},{"text":"te dees na ko fàttaliku ba fàww.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Du ragal dég-dég bu tiis,","poem":1},{"lineBreak":true},{"text":"xel ma day dal, mu wóolu Aji Sax ji,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"fit wa toog, du ragal,","poem":1},{"lineBreak":true},{"text":"ba kera muy gis noonam jóoru.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moo yéwén ci li muy may néew-doole yi,","poem":1},{"lineBreak":true},{"text":"njekkam sax dàkk,","poem":1},{"lineBreak":true},{"text":"dooleem di yokku, ànd ak daraja.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Soxor bi da koy gis, mer,","poem":1},{"lineBreak":true},{"text":"iñaan bay yéyu, jeex tàkk;","poem":1},{"lineBreak":true},{"text":"nde soxor, yaakaar ju tas rekk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}