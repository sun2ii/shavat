oog,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"di jéer asamaan ak suuf?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mooy yékkatee ku néewle fa suuf,","poem":1},{"lineBreak":true},{"text":"di seppee ku sonn cib sën,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"bokkal ko jataayu kilifa","poem":1},{"text":"ya jiite xeetam.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mooy dëël jigéen ju tële woona jur,","poem":1},{"lineBreak":true},{"text":"may ko mbégtem njureel.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}