{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":114,"content":[{"type":"heading","content":["Yàllaay walloo dooleem"]},{"type":"verse","number":1,"content":[{"text":"Ba Israayil bàyyikoo fa Misra,","poem":1},{"lineBreak":true},{"text":"ba waa kër Yanqóoba dëddu askan woowu di làkk,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ca la Yuda doon kër Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"giirug Israayil googu doon ab jagleem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Géej gaa leen gis, daw,","poem":1},{"lineBreak":true},{"text":"dexu Yurdan a deltu gannaaw,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tund yu mag yiy curpi niy kuuy,","poem":1},{"lineBreak":true},{"text":"di curpeendook tund yu ndaw yi niy mbote.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Moo géej, loo xewle bay daw?","poem":1},{"lineBreak":true},{"text":"Yaw, dexu Yurdan, looy deltu gannaaw?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tund yu mag yee, lu ngeen di curpi niy kuuy?","poem":1},{"lineBreak":true},{"text":"Yeen, tund yu ndaw yi, lu ngeen di curpi niy mbote?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Suufee, loxalal Boroom bi,","poem":1},{"lineBreak":true},{"text":"Yàllay Yanqóoba mii,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ki soppaliw doj ndox mu taa,","poem":1},{"lineBreak":true},{"text":"xeer wu ne sereŋ, mu def bëtu ndox.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}