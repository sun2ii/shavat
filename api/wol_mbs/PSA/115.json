{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":115,"content":[{"type":"heading","content":["Ku wóolu Yàlla barkeel"]},{"type":"verse","number":1,"content":[{"text":"Bu muy nun, Aji Sax ji, bu muy nun,","poem":1},{"lineBreak":true},{"text":"saw tur nga wara teral,","poem":1},{"lineBreak":true},{"text":"ngir sa ngor ak sa worma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bu yéefar yi ne mukk:","poem":1},{"lineBreak":true},{"text":"«Moo ñii, ana seen Yàlla?»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Te yaw sunu Yàlla, yaa ngi asamaan,","poem":1},{"lineBreak":true},{"text":"di def lu la soob.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Seeni tuur xaalis laak wurus,","poem":1},{"lineBreak":true},{"text":"loxoo ko sàkk:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"am gémmiñ te du wax,","poem":1},{"lineBreak":true},{"text":"ami gët te du gis,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ami nopp, du dégg,","poem":1},{"lineBreak":true},{"text":"am bakkan, du xeeñtu,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ami loxo it te du yég,","poem":1},{"lineBreak":true},{"text":"ami tànk it te du dox,","poem":1},{"lineBreak":true},{"text":"du xàddamiku sax.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñi sàkk yii tuur, yal nañu mel ni ñoom,","poem":1},{"lineBreak":true},{"text":"ñook ñi leen wóolu ñépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Éy Israayil, wóolul Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo lay jàppale, di la aar.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yeen waa kër Aaróona, wóoluleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo leen di jàppale, di leen aar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yeen ñi ragal Aji Sax ji, wóoluleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo leen di jàppale, di leen aar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aji Sax jee nuy bàyyi xel, di nu barkeel,","poem":1},{"lineBreak":true},{"text":"di barkeel kër Israayil,","poem":1},{"lineBreak":true},{"text":"di barkeel kër Aaróona.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aji Sax jeey barkeel ku ko ragal,","poem":1},{"lineBreak":true},{"text":"mag ak ndaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yal na leen Yàlla ful,","poem":1},{"lineBreak":true},{"text":"ful seeni doom.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yal nangeen barkeelu ci Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"Ki sàkk asamaan ak suuf.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Asamaan, asamaanu Aji Sax jee,","poem":1},{"lineBreak":true},{"text":"suuf la dénk doom aadama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Du ku dee mooy màggal Ki Sax,","poem":1},{"lineBreak":true},{"text":"du kenn ku tàbbi réewum tàbbi-selaw!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nun, nooy sargal Ki Sax,","poem":1},{"lineBreak":true},{"text":"tey ak ëllëg.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}