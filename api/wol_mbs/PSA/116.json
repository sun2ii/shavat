{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":116,"content":[{"type":"heading","content":["Ma sant Yàlla mi ma xettali"]},{"type":"verse","number":1,"content":[{"text":"Maa bëgg Aji Sax ji: maa ko woo,","poem":1},{"lineBreak":true},{"text":"dagaan ko, mu dégg ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Teewlu na ma moos,","poem":1},{"lineBreak":true},{"text":"dama koy woo li feek may dund.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buumi dee a ma laawoon,","poem":1},{"lineBreak":true},{"text":"njàqarey njaniiw dab ma,","poem":1},{"lineBreak":true},{"text":"ma dajeek naqar aku tiis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma woo Aji Sax ji wall, ne ko:","poem":1},{"lineBreak":true},{"text":"«Ngalla Aji Sax ji, xettali ma!»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax jeey boroom yiw ak njub,","poem":1},{"lineBreak":true},{"text":"sunu Yàllaay boroom yërmande.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax jeey aar ku xamul àddina;","poem":1},{"lineBreak":true},{"text":"tumurànke woon naa, mu wallu ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ma yeboo sama xel dal,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji baaxe na ma!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xettali nga ma, ba deewuma,","poem":1},{"lineBreak":true},{"text":"jàppale ma, ba tërëfuma,","poem":1},{"lineBreak":true},{"text":"feral nga it samay rongooñ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Damay topp Aji Sax ji","poem":1},{"lineBreak":true},{"text":"ci biir réewum aji dund ñi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ba ma wax: «Torox naa ba toskare,»","poem":1},{"lineBreak":true},{"text":"teewul may ànd ak ngëm.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maa jàqoon ba naan:","poem":1},{"lineBreak":true},{"text":"«Ñépp ay fen-kat lañu!»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana lu may njukkale Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"li mu ma baaxe lépp?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xanaa ma yékkati kaasu Aji Sax","poem":1},{"lineBreak":true},{"text":"jiy misaal wallam,","poem":1},{"lineBreak":true},{"text":"te may tudd turam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Samay digeek Aji Sax ji laay matal","poem":1},{"lineBreak":true},{"text":"fi kanam ñoñam ñépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wóllërey Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"deewam day doon lu muy naqarlu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aji Sax ji, maay sab jaam,","poem":1},{"lineBreak":true},{"text":"maay sab jaam, di sa doomu jaam bi ma sukk jur.","poem":1},{"lineBreak":true},{"text":"Yaa yiwi samay buum,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"yaw laay sarxalal saraxu cant,","poem":1},{"lineBreak":true},{"text":"woo la ci sa tur, Aji Sax ji.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Samay digeek Aji Sax ji laay matal","poem":1},{"lineBreak":true},{"text":"fi kanam ñoñam ñépp,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"fi ëtti kër Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"fi digg Yerusalem.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}