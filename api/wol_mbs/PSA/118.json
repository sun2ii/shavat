{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":118,"content":[{"type":"heading","content":["Aji Sax jeek man, ma daan"]},{"type":"verse","number":1,"content":[{"text":"Santleen Aji Sax ji, kee baax,","poem":1},{"lineBreak":true},{"text":"kee saxoo ngoram!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rikk Israayil, neleen:","poem":1},{"lineBreak":true},{"text":"«Kee saxoo ngoram!»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rikk waa kër Aaróona, neleen:","poem":1},{"lineBreak":true},{"text":"«Kee saxoo ngoram!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rikk yeen ñi ragal Aji Sax ji, neleen:","poem":1},{"lineBreak":true},{"text":"«Kee saxoo ngoram!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ci xat-xat laa woowe Ki Sax wall,","poem":1},{"lineBreak":true},{"text":"Ki Sax wuyu ma, yaatal ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax jeek man, duma tiit.","poem":1},{"lineBreak":true},{"text":"Ana lees ma manal?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax jeek man, di ma dimbali,","poem":1},{"lineBreak":true},{"text":"may seetaan bañ yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Làqoo Aji Sax jee gën","poem":1},{"lineBreak":true},{"text":"wóolu doom aadama.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Làqoo Aji Sax jee gën","poem":1},{"lineBreak":true},{"text":"wóolu garmi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yéefar yépp a ma sam,","poem":1},{"lineBreak":true},{"text":"ma bëmëx leen ci dooley Aji Sax ji.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ñu sam maa sam;","poem":1},{"lineBreak":true},{"text":"ma bëmëx leen ci dooley Aji Sax ji.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Naka lañu ma sam niy yamb,","poem":1},{"lineBreak":true},{"text":"jekki ne kamaj ni taalu boob;","poem":1},{"lineBreak":true},{"text":"ma bëmëx ci dooley Aji Sax ji.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dees maa jañax, jañax, ma ter-teri,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji dimbali ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sama doole, sama kaaraange, Ki Sax a;","poem":1},{"lineBreak":true},{"text":"te mooy sama wall tey.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndam aki sarxolle ca xaymay ñu jub ña,","poem":1},{"lineBreak":true},{"text":"ndijooru Aji Sax jee def njàmbaar!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndijoor la Aji Sax ji xàcc,","poem":1},{"lineBreak":true},{"text":"ndijooru Aji Sax jee def njàmbaar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Duma dee moos, xanaa dund,","poem":1},{"lineBreak":true},{"text":"ba nettali jaloorey Ki Sax.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ki Sax mbugal na maa mbugal,","poem":1},{"lineBreak":true},{"text":"waaye waccu ma, ma dee.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ubbilleen ma bunti ñi jub,","poem":1},{"lineBreak":true},{"text":"ma dugg santi Ki Sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Buntu Aji Sax jaa ngii;","poem":1},{"lineBreak":true},{"text":"ñu jub ñee ciy dugge.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dama lay sant, yaa ma nangul,","poem":1},{"lineBreak":true},{"text":"wallu ma tey.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Doj wi tabaxkat yi beddi woon,","poem":1},{"lineBreak":true},{"text":"moo mujj di doju koñu tabax bi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lii de, Aji Sax jee ko def,","poem":1},{"lineBreak":true},{"text":"nu gis ko, yéemu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bésub tey jii, Aji Sax jee ko sos,","poem":1},{"lineBreak":true},{"text":"nan ko bége, bànneexoo ko.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ngalla Aji Sax ji, wallu nu.","poem":1},{"lineBreak":true},{"text":"Ngalla Aji Sax ji, may nu ndam.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Na barke wàcc ci ki dikk ci turu Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Nu ngi leen di ñaanale fi néegu Aji Sax ji.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Aji Sax jee di Yàlla, di nu leeral.","poem":1},{"lineBreak":true},{"text":"Jëlleen car yi, màggale,","poem":1},{"lineBreak":true},{"text":"te dox ba ca béjjéni sarxalukaay ba.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Yaa di sama Yàlla, ma di la sant;","poem":1},{"lineBreak":true},{"text":"céy sama Yàlla, dama lay kañ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Santleen Aji Sax ji, kee baax,","poem":1},{"lineBreak":true},{"text":"kee saxoo ngoram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}