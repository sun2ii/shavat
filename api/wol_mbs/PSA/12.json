{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":12,"content":[{"type":"heading","content":["Kàddug Yàllaa wóor"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd ak xalamu juróom ñetti buum, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wallóoy, Aji Sax ji, ngor jee na!","poem":1},{"lineBreak":true},{"text":"Kóolute réer na doom aadama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dañuy fenante,","poem":1},{"lineBreak":true},{"text":"làmmiñ dig lem, xol ba njuuy la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yal na Aji Sax ji tëj gémmiñu kuy naxe,","poem":1},{"lineBreak":true},{"text":"ak kuy làmmiñuy tëggu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ñu ngi naa: «Sunu làmmiñ lanuy daane,","poem":1},{"lineBreak":true},{"text":"nook sunu kàddu; ku nu manal dara?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ku ñàkk a ngii, ñu futti,","poem":1},{"lineBreak":true},{"text":"mu ngi binni, di néew-ji-doole.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji nee: «Maa ngii, di ci jóg,","poem":1},{"lineBreak":true},{"text":"teg leen fi rawtu gu ñu ne siiw.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kàddug Aji Sax ji, kàddu gu sell la,","poem":1},{"lineBreak":true},{"text":"ni xaalis bu ñu xelli ci taalu ban,","poem":1},{"lineBreak":true},{"text":"settali ko juróom ñaari yoon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ngalla Aji Sax ji, sàmmal ku néewle,","poem":1},{"lineBreak":true},{"text":"aar ko saa su ne ci nitu tey.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ñu bon ñaa ngi taxawaalu fu ne,","poem":1},{"lineBreak":true},{"text":"jikko ju sew falu ci biir doom aadama yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}