{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":120,"content":[{"type":"heading","content":["Ma ñaan ci biir tuuma"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla.","descriptive":true},{"lineBreak":true},{"text":"Ci sama njàqare laa woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"mu wuyu ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, musal ma ci gémmiñu fen-kat,","poem":1},{"lineBreak":true},{"text":"ak làmmiñu njublaŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaw boroom làmmiñu njublaŋ,","poem":1},{"lineBreak":true},{"text":"ana lu ñu lay añale","poem":1},{"lineBreak":true},{"text":"ak lu ñu lay dolli?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xanaa fitti mbër yu ñaw","poem":1},{"lineBreak":true},{"text":"ak xal yu yànj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wóoy man mi ganeyaani baadooloy Meseg ya","poem":1},{"lineBreak":true},{"text":"tey dali fa xaymay waa Kedar ñu xayadi ña!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yàgg naa lool","poem":1},{"lineBreak":true},{"text":"ci biir nit ñi bañ jàmm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Man may wut jàmm,","poem":1},{"lineBreak":true},{"text":"te su ma waxee, ñoom ñuy ayoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}