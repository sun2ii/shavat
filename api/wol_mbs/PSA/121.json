{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":121,"content":[{"type":"heading","content":["Ana ku may sàmm?"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla.","descriptive":true},{"lineBreak":true},{"text":"Damaa séentu tund ya,","poem":1},{"lineBreak":true},{"text":"te naan fu wall di jóge?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sama wall a nga fa Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"Ki sàkk asamaan ak suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kii du la bàyyi nga tërëf,","poem":1},{"lineBreak":true},{"text":"sa sàmm bii gëmmul.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiy sàmm Israayil kay","poem":1},{"lineBreak":true},{"text":"gëmmul, nelawul.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax jee lay sàmm,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee lay yiir,","poem":1},{"lineBreak":true},{"text":"féete la ndijoor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Du naaj wu lay dal bëccëg,","poem":1},{"lineBreak":true},{"text":"mbaa leer gu ndaw guddi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax jee lay sàmm ci gépp loraange,","poem":1},{"lineBreak":true},{"text":"di sàmm sa bakkan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax jee lay sàmm, dem ak dikk,","poem":1},{"lineBreak":true},{"text":"tey ak ëllëg.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}