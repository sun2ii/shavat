{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":122,"content":[{"type":"heading","content":["Nu ñaanal Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Maaka bég, ba ñu ma nee:","poem":1},{"lineBreak":true},{"text":"«Kër Aji Sax ji lanu jëm.»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaw Yerusalem, noo ngii taxaw ci sa bunt.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Céy, Yerusalem, dëkkub tabax bu baax","poem":1},{"text":"bi booloo, di benn.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Fii la giiri Israayil di yéegsi,","poem":1},{"lineBreak":true},{"text":"di giir yi Ki Sax séddoo.","poem":1},{"lineBreak":true},{"text":"Ñu ngi santsi Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ni ko Israayil warloo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fii la ngànguney Israayil tege,","poem":1},{"lineBreak":true},{"text":"askanu Daawuda toog ca, di àtte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dagaanleen jàmmi Yerusalem:","poem":1},{"lineBreak":true},{"text":"«Yerusalem, yal na sa xeli soppe dal,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"jàmm ne ñoyy fi say tata wër,","poem":1},{"lineBreak":true},{"text":"te xel dal ci biir këri Buur.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mbokk ak xarit a waral","poem":1},{"lineBreak":true},{"text":"may ñaan jàmmi Yerusalem.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sunu kër Yàlla Aji Sax jee ma tax","poem":1},{"lineBreak":true},{"text":"di sàkku ngëneelu Yerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}