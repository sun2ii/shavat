ees,","poem":1},{"lineBreak":true},{"text":"ñu bew ñaa ngi nuy sewal.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}