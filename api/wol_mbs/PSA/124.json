{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":124,"content":[{"type":"heading","content":["Nanu sante Aji Sax ji wallam"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Éy su dul woon ak Aji Sax ji nu nekkal!","poem":1},{"lineBreak":true},{"text":"Israayiloo, waxati ko:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"su dul woon ak Aji Sax ji nu nekkal,","poem":1},{"lineBreak":true},{"text":"ba ñu nu jógalee,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ba nit ña xadaroo sunu kaw,","poem":1},{"lineBreak":true},{"text":"dañu nu doon wann, nuy dund,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"dañu nu doon mëdd nim ndox,","poem":1},{"lineBreak":true},{"text":"defum wal, buub nu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"def waame wuy wal-wali,","poem":1},{"lineBreak":true},{"text":"buub nu, yóbbu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Cant ñeel na Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ki nu bàyyiwul, noon yi yàpp nu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Danu ne fërr, nim picc mu rëcc fiiru rëbb,","poem":1},{"lineBreak":true},{"text":"fiir ga toj, nu raw.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sunu ndimbal a ngi ci turu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"Ki sàkk asamaan ak suuf.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}