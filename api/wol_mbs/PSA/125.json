 baaxeel ku baax,","poem":1},{"lineBreak":true},{"text":"ak kuy mébét njub.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waaye kuy topp yoonu ndëngte,","poem":1},{"lineBreak":true},{"text":"Aji Sax jee koy sànk,","poem":1},{"lineBreak":true},{"text":"boole kook kuy def lu bon.","poem":1},{"lineBreak":true},{"text":"Yal na jàmm dal ci Israayil.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}