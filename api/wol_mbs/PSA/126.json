{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":126,"content":[{"type":"heading","content":["Yàlla, delloo nu"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla.","descriptive":true},{"lineBreak":true},{"text":"Ba Aji Sax ji delloo waa Siyoŋ seen réew,","poem":1},{"lineBreak":true},{"text":"danoo meloon ni ñuy gént,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"di reeka sarxolle rekk.","poem":1},{"lineBreak":true},{"text":"Yéefar yi naa:","poem":1},{"lineBreak":true},{"text":"«Lu réy la Aji Sax ji defal ñii.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lu réy la nu Aji Sax ji defal moos,","poem":1},{"lineBreak":true},{"text":"nu bég.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax ji, rikk delloo nu na woon,","poem":1},{"lineBreak":true},{"text":"ni ngay delloo wal yu ŋiis, mu walaat ca àllub Negew.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuy ji di jooy,","poem":1},{"lineBreak":true},{"text":"yal na góob, di sarxolle.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ku doon wéy a wéy, di jooy;","poem":1},{"lineBreak":true},{"text":"yor mbuusum jiwoom,","poem":1},{"lineBreak":true},{"text":"yal na dikk a dikk, di woy,","poem":1},{"lineBreak":true},{"text":"ñibbiwaale sabaaram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}