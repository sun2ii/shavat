{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":127,"content":[{"type":"heading","content":["Barkeb Yàllaa wóor"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla, ñeel Suleymaan.","descriptive":true},{"lineBreak":true},{"text":"Kër, su ko Aji Sax ji tabaxul,","poem":1},{"lineBreak":true},{"text":"ku ko tabax, neen nga doñ-doñi.","poem":1},{"lineBreak":true},{"text":"Ab dëkk, su ko Aji Sax ji wattuwul,","poem":1},{"lineBreak":true},{"text":"ku ko wattu, neen nga teewlu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Neen it la nit di teela jóg","poem":1},{"lineBreak":true},{"text":"aka guddee tëdd,","poem":1},{"lineBreak":true},{"text":"di doñ-doñi lu mu lekk:","poem":1},{"lineBreak":true},{"text":"Aji Sax ji leel na soppeem lu ni day,","poem":1},{"lineBreak":true},{"text":"fekk ko muy nelaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma ne, doom Aji Sax jee koy sédde,","poem":1},{"lineBreak":true},{"text":"njurum doom yool la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Doom joo jure ndaw,","poem":1},{"lineBreak":true},{"text":"mooy fitt ci loxol jàmbaar;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ndokkalee ku ci mbuusam fees,","poem":1},{"lineBreak":true},{"text":"ba bu ñu taseekub noon ca pénc ma,","poem":1},{"lineBreak":true},{"text":"duñu am gàcce mukk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}