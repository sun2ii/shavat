{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":129,"content":[{"type":"heading","content":["Noon manul Israayil"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla.","descriptive":true},{"lineBreak":true},{"text":"Ba may ndaw ba tey, ñu ngi may sonal a sonal.","poem":1},{"lineBreak":true},{"text":"Israayiloo, waxati ko:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ba may ndaw ba tey, ñu ngi may sonal a sonal,","poem":1},{"lineBreak":true},{"text":"te taxul ñu man ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sama gannaaw gi lañu gàbb a gàbb,","poem":1},{"lineBreak":true},{"text":"rëdd koo rëdd nib tool.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waaye àtteb Aji Sax ji mooy dëgg,","poem":1},{"lineBreak":true},{"text":"dog na buumi ñu bon ña.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Képp ku noonoo Siyoŋ,","poem":1},{"lineBreak":true},{"text":"yal nañu ko dëpp, gàcceel ko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yal nañu mel ni ñax mu saxem xadd,","poem":1},{"lineBreak":true},{"text":"balaa law, lax.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Du doyub ŋëb ku ko dog;","poem":1},{"lineBreak":true},{"text":"du doyub say ku ko for.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ku fa jaare it du ko ne:","poem":1},{"lineBreak":true},{"text":"«Jaajëf, Aji Sax ji barkeel;","poem":1},{"lineBreak":true},{"text":"jaajëfe yaw, yal na Aji Sax ji barkeel.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}