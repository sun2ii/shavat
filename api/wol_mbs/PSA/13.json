{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":13,"content":[{"type":"heading","content":["Aji Sax ji, loo deeti xaar?"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Céy Aji Sax ji, loo deeti xaar?","poem":1},{"lineBreak":true},{"text":"Xanaa doo ma tanqamlu ba fàww?","poem":1},{"lineBreak":true},{"text":"Loo deeti xaar, bañ maa geesu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ba ma tàggook bopp bu ubu","poem":1},{"lineBreak":true},{"text":"ak njàqarey xol bu sax,","poem":1},{"lineBreak":true},{"text":"ba noon dootu ma man?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Céy Aji Sax ji sama Yàlla, geesu ma, wuyu ma,","poem":1},{"lineBreak":true},{"text":"leqali ma, bala ma ne sërëx ci nelawi dee,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"noon ba naan: «Daan naa ko,»","poem":1},{"lineBreak":true},{"text":"bañ yay bége saab jéll.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Man de maa ngi dénkoo sa ngor,","poem":1},{"lineBreak":true},{"text":"di bànneexoo sag wall.","poem":1},{"lineBreak":true},{"text":"Naa woy Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ki may baaxe xéewalam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}