{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":130,"content":[{"type":"heading","content":["Nu séentu njotug Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji, ci ay xóote laa lay woowe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Boroom bi, déglu ma,","poem":1},{"lineBreak":true},{"text":"teewlu ma, ma tinu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ki Sax, yaw, soo doon lim bàkkaar,","poem":1},{"lineBreak":true},{"text":"Boroom bi, ana kuy taxaw?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waaye yaay jéggale,","poem":1},{"lineBreak":true},{"text":"ñu ragal la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Damay xaar Aji Sax ji, di ko xaare xol,","poem":1},{"lineBreak":true},{"text":"di yaakaar kàddoom.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wattukat bi yàkkamti njël,","poem":1},{"lineBreak":true},{"text":"wattukat bi yàkkamti njël, laa ne,","poem":1},{"lineBreak":true},{"text":"ni ma yàkkamtee Aji Sax jee ko raw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Éey Israayil, négandikul Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee gore,","poem":1},{"lineBreak":true},{"text":"te yaatug njot.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mooy jot Israayil ci ñaawtéefam yépp.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}