{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":132,"content":[{"type":"heading","content":["Yàlla digoo naak ki mu fal"]},{"type":"verse","number":1,"content":[{"text":"Di woy yu ñuy yéege ca tund ya, di ko màggale Yàlla.","descriptive":true},{"lineBreak":true},{"text":"Éy Aji Sax ji, bàyyil xel Daawuda,","poem":1},{"lineBreak":true},{"text":"ak gépp njàqareem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moo giñaloon Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo digook Mbërum Yanqóoba ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mu ne: «Duma ñibbi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"duma tëddi ca sama kaw lal ba,","poem":1},{"lineBreak":true},{"text":"duma nelaw, duma gëmm sax bët,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"li feek sàkkaluma Aji Sax ji béreb,","poem":1},{"lineBreak":true},{"text":"ba dëkkal Mbërum Yanqóoba ma.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma ne, Efrata lanu dégg gaalu Yàlla ga,","poem":1},{"lineBreak":true},{"text":"fekk ko ca àll ya wër dëkku Yaar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nan dem ba këram,","poem":1},{"lineBreak":true},{"text":"sujjóotali ndëggastalu tànkam ya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax ji, jógal agsi sa dalluwaay,","poem":1},{"lineBreak":true},{"text":"yaak gaal gi jëmmal sa doole.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Say sarxalkat, yal nañu soloo njubte,","poem":1},{"lineBreak":true},{"text":"sa wóllëre yi sarxolleendoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xoolal ci Daawuda, sa jaam ba,","poem":1},{"lineBreak":true},{"text":"ngalla bul gàntu ki nga fal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Aji Sax ji daa giñal Daawuda","poem":1},{"lineBreak":true},{"text":"dëgg gu mu dul dëddu,","poem":1},{"lineBreak":true},{"text":"ne ko: «Ku jóge ci sa geño","poem":1},{"lineBreak":true},{"text":"laay teg ci sa jal,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"te say doom, bu ñu sàmmee sama kóllëre,","poem":1},{"lineBreak":true},{"text":"ak sama kàdduy seede yi ma leen di xamal,","poem":1},{"lineBreak":true},{"text":"seeni doom it ñooy tooge sa jal ba fàww","poem":1},{"noteId":34},{"text":".»","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aji Sax ji kat a tànn Siyoŋ,","poem":1},{"lineBreak":true},{"text":"taamu faa dëkke.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mu ne: «Fii laay dalloo ba fàww,","poem":1},{"lineBreak":true},{"text":"fii laay dëkk, maa ko taamu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dund bi, ma barkeel a barkeel,","poem":1},{"lineBreak":true},{"text":"néew-ji-doole yi, ma reggal;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"sarxalkat yi, ma wodde texe;","poem":1},{"lineBreak":true},{"text":"wóllëre yi di sarxollee sarxolle.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fa laay dooleele Daawuda,","poem":1},{"lineBreak":true},{"text":"ni jum bu dul fey mukk, maay jafal nguuru ki ma fal.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ay noonam, ma wodde gàcce;","poem":1},{"lineBreak":true},{"text":"moom, kaalaam ne ràññ.»","poem":1}]}],"footnotes":[{"noteId":34,"caller":"+","text":"132.12 Seetal ci 2.Samiyel 7.12-16.","reference":{"chapter":132,"verse":12}}]},"thisChapterLink":"/api/wol_mbs/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}