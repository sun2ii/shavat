/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}