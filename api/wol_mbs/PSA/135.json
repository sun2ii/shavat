{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":135,"content":[{"type":"heading","content":["Lu Yàlla namm lay def"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Màggalleen turu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"éey jaami Aji Sax ji, màggalleen,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"yeen ñi taxaw ci kër Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"fi sunu biir ëttu Yàlla bi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Màggalleen Ki Sax, Aji Sax jee baax!","poem":1},{"lineBreak":true},{"text":"Kañleen ko, kee sopplu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ki Sax a tànn Yanqóoba,","poem":1},{"lineBreak":true},{"text":"muy Israayil mi mu séddoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maa xam ne Aji Sax ji màgg na!","poem":1},{"lineBreak":true},{"text":"Sunu Boroom a sut lépp lu ñuy jaamu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lépp lu Aji Sax ji namm,","poem":1},{"lineBreak":true},{"text":"moom lay def asamaan ak suuf,","poem":1},{"lineBreak":true},{"text":"ak biir géej ak xóote yépp.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mooy yékkateey niir fa cati àddina,","poem":1},{"lineBreak":true},{"text":"sàkkal taw ay melax,","poem":1},{"lineBreak":true},{"text":"yebbee ngelaw cay dencam,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"faat luy taaw fa Misra,","poem":1},{"lineBreak":true},{"text":"doom aadama, ba ci mala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yeen waa Misra, moo yónnee ay firndeeki kéemaan fi seen biir,","poem":1},{"lineBreak":true},{"text":"ñeel Firawnaak jawriñam ñépp.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moo duma ay xeeti xeet,","poem":1},{"lineBreak":true},{"text":"bóom buur yu mag yi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"muy Sixon buurub Amoreen ña,","poem":1},{"lineBreak":true},{"text":"ak Og buuru Basan,","poem":1},{"lineBreak":true},{"text":"ak buuri Kanaan yépp.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moo nangu seen réew, séddale,","poem":1},{"lineBreak":true},{"text":"bànni Israayil ñiy ñoñam séddoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aji Sax ji, sa tur ba fàww;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, sa woy a saxal maasoo maas.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aji Sax ji kay ay àtte ñoñam ñi,","poem":1},{"lineBreak":true},{"text":"di ñeewante jaamam ñi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tuuri yéefar yi, xaalis laak wurus,","poem":1},{"lineBreak":true},{"text":"loxoo ko sàkk.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Am gémmiñ te du wax,","poem":1},{"lineBreak":true},{"text":"ami gët te du gis,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ami nopp te du dégg,","poem":1},{"lineBreak":true},{"text":"du sax noowal bakkan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ñi sàkk yii tuur, yal nañu mel ni ñoom,","poem":1},{"lineBreak":true},{"text":"ñook ñi leen wóolu ñépp.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Éey waa kër Israayil, santleen Aji Sax ji!","poem":1},{"lineBreak":true},{"text":"Éey waa kër Aaróona, santleen Aji Sax ji!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Éey waa kër Lewi, santleen Aji Sax ji!","poem":1},{"lineBreak":true},{"text":"Yeen ñi ragal Aji Sax ji, santleen Aji Sax ji!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nañuy sant Aji Sax ji ci Siyoŋ,","poem":1},{"lineBreak":true},{"text":"moom mi dëkke Yerusalem.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}