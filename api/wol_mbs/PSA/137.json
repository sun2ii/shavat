{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":137,"content":[{"type":"heading","content":["Jooye nanu àll"]},{"type":"verse","number":1,"content":[{"text":"Ca tàkkal dexi Babilon,","poem":1},{"lineBreak":true},{"text":"foofa lanu daa toog,","poem":1},{"lineBreak":true},{"text":"fàttaliku Siyoŋ, jooy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ca garab ya","poem":1},{"lineBreak":true},{"text":"lanu daa wékk sunuy xalam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fa la nu sunuy sang daa woyloo,","poem":1},{"lineBreak":true},{"text":"noot nu, bëgg nu bégal leen,","poem":1},{"lineBreak":true},{"text":"naan: «Woyalleen nu ci woyi Siyoŋ.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moo! Nu nuy woye woyu Aji Sax ji","poem":1},{"lineBreak":true},{"text":"kaw suufas yéefar?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Éy Yerusalem, su ma la naree fàtte,","poem":1},{"lineBreak":true},{"text":"yal na ma doole dëddu!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yerusalem, su ma la fàttalikuwul,","poem":1},{"lineBreak":true},{"text":"fonk la, ba gën laa bége lépp,","poem":1},{"lineBreak":true},{"text":"yal na sama làmmiñ tafoo sama denqleñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aji Sax ji, fàttalikul Edomeen ña,","poem":1},{"lineBreak":true},{"text":"keroog jantub Yerusalem,","poem":1},{"lineBreak":true},{"text":"ba ñu naan: «Màbbleen a màbb,","poem":1},{"lineBreak":true},{"text":"ba suuf sa dëkk bi sampe siiñ!»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeen waa Babilon gi ñu nara fàllas,","poem":1},{"lineBreak":true},{"text":"ndokkalee ku leen fey jëf ja ngeen nu def!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ndokkalee ku ne cas seeni fere,","poem":1},{"lineBreak":true},{"text":"tas ciw doj!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}