{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":138,"content":[{"type":"heading","content":["Aji Sax ji waccu ma"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Ma sante la sama léppi xol,","poem":1},{"lineBreak":true},{"text":"woy la, gàngooru Yàlla ga ca kaw seede.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma sujjóot jublook sa kër gu sell gi,","poem":1},{"lineBreak":true},{"text":"di wormaal saw tur,","poem":1},{"lineBreak":true},{"text":"ngir sa ngor ak sa worma.","poem":1},{"lineBreak":true},{"text":"Màggal nga sa tur ak sa kàddu,","poem":1},{"lineBreak":true},{"text":"ba mu tiim lépp.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bés ba ma wootee, yaa ma wuyu,","poem":1},{"lineBreak":true},{"text":"ñemeel ma, dooleel ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax ji, na la buuri àddina yépp màggal,","poem":1},{"lineBreak":true},{"text":"ñoo dégg kàddu yi nga wax.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nañu woy say jaloore, naan:","poem":1},{"lineBreak":true},{"text":"«Aji Sax jeeka màgg ndam!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax jee kawe!","poem":1},{"lineBreak":true},{"text":"Ku toroxlu, mu niir;","poem":1},{"lineBreak":true},{"text":"ku réy, mu ñooru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma wéye njàqare,","poem":1},{"lineBreak":true},{"text":"nga musal ma,","poem":1},{"lineBreak":true},{"text":"dogalee sa loxo merum noon,","poem":1},{"lineBreak":true},{"text":"walloo ma sa ndijoor.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax jee may feyul.","poem":1},{"lineBreak":true},{"text":"Éy Aji Sax ji, yaa saxoo ngor!","poem":1},{"lineBreak":true},{"text":"Bul wacc ñi nga binde sa loxo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}