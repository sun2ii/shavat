{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":139,"content":[{"type":"heading","content":["Aji Sax jee ma xam, ba jeexal ma"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ñeel Daawuda, dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji, yaa ma natt, xam ma;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"yaa xam sama toogaay ak sama taxawaay,","poem":1},{"lineBreak":true},{"text":"di ràññee fu sore samay xalaat,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"di càmbar samab dox ak sama tëraay,","poem":1},{"lineBreak":true},{"text":"yittewoo lépp lu may def.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji, bala maa wax baat,","poem":1},{"lineBreak":true},{"text":"ndeke yaw, xam nga lépp.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kanam ak gannaaw nga ma dare,","poem":1},{"lineBreak":true},{"text":"teg ma sa loxo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni nga ma xame daa yéeme,","poem":1},{"lineBreak":true},{"text":"xóot lool, ba wees ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fu ma jëm, ba sore la?","poem":1},{"lineBreak":true},{"text":"Fu ma daw jëm, foo teewul?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma ñalgu ba asamaan, yaa nga fa!","poem":1},{"lineBreak":true},{"text":"Ma tëri njaniiw, ndeke yaa nga fa!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma war laafi njël,","poem":1},{"lineBreak":true},{"text":"dëkki wàllaa géej,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"nga tettee ma fa ba tey,","poem":1},{"lineBreak":true},{"text":"téyee ma sa ndijoor.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Su ma noon: «Na ma lëndëm mëdd boog,","poem":1},{"lineBreak":true},{"text":"ba leer gi far guddil ma,»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"du tax lëndëm lëndëmal la dara.","poem":1},{"lineBreak":true},{"text":"Guddi da laa leeralal ni bëccëg,","poem":1},{"lineBreak":true},{"text":"lëndëm dig leer fi yaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaa ma sàkkal xol ak xalaat,","poem":1},{"lineBreak":true},{"text":"ràbbe ma sama biiru ndey.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Naa la sante sama bind bu raglu bii te yéeme,","poem":1},{"lineBreak":true},{"text":"say jalooree di kéemaan, bir na ma!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sama jëmm jii umpu la,","poem":1},{"lineBreak":true},{"text":"ba muy bindu ci kumpa,","poem":1},{"lineBreak":true},{"text":"mel ni lu ñu ràbbe ci xóotey suuf.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gis nga ma, ba ma diw lumb;","poem":1},{"lineBreak":true},{"text":"sa téere lim na fan yi nga ma àppal,","poem":1},{"lineBreak":true},{"text":"ba ca benn dooragul.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yàlla, say xalaat aka maa yéem!","poem":1},{"lineBreak":true},{"text":"Ndaw lim bu réy!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Su ma ko doon waññ, moo ëpp feppi suuf.","poem":1},{"lineBreak":true},{"text":"Maa ngii yewwu, nekk feek yaw ba tey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Éy sama Yàlla, soo reyoon ñu bon ñii!","poem":1},{"lineBreak":true},{"text":"Yeen bóomkat yi, soreleen ma!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ñii sa tur lañuy luubale,","poem":1},{"lineBreak":true},{"text":"noonoo la, di tudd sa tur ciy caaxaan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aji Sax ji, maaka bañ ñi la bañ","poem":1},{"lineBreak":true},{"text":"te sib ñi lay gàntal.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dama leena bañ ba fa mbañeel yem;","poem":1},{"lineBreak":true},{"text":"samay noon dëgg lañu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yàlla, seetlu ma, ba ràññee sama xol;","poem":1},{"lineBreak":true},{"text":"natt ma, ba ràññee sama xalaati xol.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Xoolal ndax maa ngi doxe yoon wu aay,","poem":1},{"lineBreak":true},{"text":"te nga teg ma ci yoon wi sax.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}