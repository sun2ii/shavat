{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":140,"content":[{"type":"heading","content":["Ku ñu toŋal a ngi ñaan"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, xettali ma ci ku bon,","poem":1},{"lineBreak":true},{"text":"musal ma ci nitu fitna,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kuy nas lu bon,","poem":1},{"lineBreak":true},{"text":"tey saxoo di sookey xare,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"daas làmmiñam ni jaan,","poem":1},{"lineBreak":true},{"text":"guux daŋaru ñàngóor. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Éy Aji Sax ji, aar ma ci loxol ku bon,","poem":1},{"lineBreak":true},{"text":"musal ma ci nitu fitna,","poem":1},{"lineBreak":true},{"text":"ku may fexee fakkastal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ñu bew ñee ma làqali yeer,","poem":1},{"lineBreak":true},{"text":"lalal may buum aki caax,","poem":1},{"lineBreak":true},{"text":"feggal ma seeni fiir ci yoon wi. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dama ne Aji Sax ji, yaay sama Yàlla;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, teewlul, ma dagaan la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom bi may walloo doole,","poem":1},{"lineBreak":true},{"text":"yaa ma yiir keroog bésub xare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Aji Sax ji, bul may ku bon nammeelam,","poem":1},{"lineBreak":true},{"text":"bul matal pexeem, muy yékkatiku. Selaw.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñi ma sam, yal na seen ayu làmmiñ","poem":1},{"lineBreak":true},{"text":"këppu ci seen kaw bopp.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yal nañu këppoo xali sawara,","poem":1},{"lineBreak":true},{"text":"tàbbi ciy pax te dootuñu jóg.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kuy yàq der, yàlla bumu toog ci réew mi.","poem":1},{"lineBreak":true},{"text":"Nitu fitna, yal na ko ay topp, ba dal ci kawam.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xam naa ne Aji Sax jeey jox néew-ji-doole dëgg;","poem":1},{"lineBreak":true},{"text":"di sàmm àqu baadoolo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku jëfe njekk kay moo lay sant;","poem":1},{"lineBreak":true},{"text":"ku jub dëkke saw yiw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}