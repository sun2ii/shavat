{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":141,"content":[{"type":"heading","content":["Yàlla, sàmmal sama làmmiñ"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji, woo naa la, gaawe ma!","poem":1},{"lineBreak":true},{"text":"Bu ma lay woo, teewlu ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yal nanga ma nangul samag ñaan","poem":1},{"lineBreak":true},{"text":"ni cuuraay lu ñu la taalal,","poem":1},{"lineBreak":true},{"text":"loxo yi ma la tàllal di saraxu ngoon soo gërëm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aji Sax ji, sàmmal ma sama làmmiñ,","poem":1},{"lineBreak":true},{"text":"saytul ma sama kàddu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bu ma xiir ci lu aay,","poem":1},{"lineBreak":true},{"text":"may jëfe jëf ju bon,","poem":1},{"lineBreak":true},{"text":"ànd ceek ñiy jëf lu ñaaw,","poem":1},{"lineBreak":true},{"text":"di wàlli seeni bernde.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuy déggal Yàlla, man na maa dóor,","poem":1},{"lineBreak":true},{"text":"bantal ma ci ngor.","poem":1},{"lineBreak":true},{"text":"Loolu ngëneelu cuuraay la, duma ko bañ.","poem":1},{"lineBreak":true},{"text":"Waaye maa ngi saxoo ñaan pexey noon moy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yal nañu fenqe seeni njiit ciw doj,","poem":1},{"lineBreak":true},{"text":"ba noon yi xam ne dëgg laa wax.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni ñuy gàbbe suuf ba mu ne ŋafeet,","poem":1},{"lineBreak":true},{"text":"ni la njaniiw di ŋaye,","poem":1},{"lineBreak":true},{"text":"aw seeni yax yu tasaaroo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aji Sax ji Boroom bi, yaw laa wékki gët,","poem":1},{"lineBreak":true},{"text":"yaw laa làqoo,","poem":1},{"lineBreak":true},{"text":"bu ma seetaan, ma dee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Musal ma ci yeer yi ñu ma gasal,","poem":1},{"lineBreak":true},{"text":"ak fiir yi ma defkati ñaawtéef yi tegal.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yal na ku bon tàbbi cig fiiram,","poem":1},{"lineBreak":true},{"text":"te man ma teggi, wéy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}