{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":143,"content":[{"type":"heading","content":["Aji Sax jeey sama yaakaar"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Éy Aji Sax ji, déglul, ma ñaan la;","poem":1},{"lineBreak":true},{"text":"teewlul, ma tinu la;","poem":1},{"lineBreak":true},{"text":"nangul ma ci sa wormaak sa àtteb dëgg.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sang bi, bul layook man;","poem":1},{"lineBreak":true},{"text":"kenn jubul fi sa kanam, du kuy dund.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noon a ma sambal,","poem":1},{"lineBreak":true},{"text":"daane ma, joggati,","poem":1},{"lineBreak":true},{"text":"dëël ma ci lëndëm","poem":1},{"lineBreak":true},{"text":"ni ku dee bu yàgg.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sama doole jeex tàkk,","poem":1},{"lineBreak":true},{"text":"sama xol jeex, ma ne yàcc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"May fàttaliku bu njëkkoon,","poem":1},{"lineBreak":true},{"text":"di xalaat sa jaloore yépp,","poem":1},{"lineBreak":true},{"text":"seetaat li nga def.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma tàllal lay loxo,","poem":1},{"lineBreak":true},{"text":"soxla la, ni suuf su mar di soxlaa ndox. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aji Sax ji, gaawal wuyu ma;","poem":1},{"lineBreak":true},{"text":"sama xol a jeex, ma ne yàcc,","poem":1},{"lineBreak":true},{"text":"bu ma xañ sa yiw,","poem":1},{"lineBreak":true},{"text":"ma yem ak kuy tàbbiji biir pax.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xëye ma sa ngor,","poem":1},{"lineBreak":true},{"text":"yaw laa wóolu;","poem":1},{"lineBreak":true},{"text":"xamal ma fu may doxe,","poem":1},{"lineBreak":true},{"text":"yaw laa wékk sama bakkan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji Sax ji, musal ma ci noon yi,","poem":1},{"lineBreak":true},{"text":"yaw laa làqoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jàngal ma, ma jëfe sa coobare;","poem":1},{"lineBreak":true},{"text":"yaa di sama Yàlla.","poem":1},{"lineBreak":true},{"text":"Yal na ma sam xel jiitee mbaax","poem":1},{"lineBreak":true},{"text":"ci yoon wu tàlli.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aji Sax ji, musal ma ngir sa tur,","poem":1},{"lineBreak":true},{"text":"jëfeel sa àtte, teggil ma njàqarey bakkan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sànkal ma noon yi ci sa ngor,","poem":1},{"lineBreak":true},{"text":"bóomal ma bépp mbañ.","poem":1},{"lineBreak":true},{"text":"Man de, maay sab jaam!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}