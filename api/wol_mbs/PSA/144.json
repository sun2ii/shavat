{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":144,"content":[{"type":"heading","content":["Aji Sax ji, laggsil"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Cant ñeel na Aji Sax ji sama cëslaay,","poem":1},{"lineBreak":true},{"text":"mu di ma jàngal xeex,","poem":1},{"lineBreak":true},{"text":"di ma tàggat ci xare,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"di sama wóllëre, di ma yiir,","poem":1},{"lineBreak":true},{"text":"di ma làq, di ma xettali,","poem":1},{"lineBreak":true},{"text":"di ma aar, ma di ko làqoo,","poem":1},{"lineBreak":true},{"text":"mu di ma nangulal ay xeet.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji, luy nit, ba nga di ko ràññee?","poem":1},{"lineBreak":true},{"text":"luy doom aadama, ba nga di ko faale?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nit ni ngelaw,","poem":1},{"lineBreak":true},{"text":"ay fanam di takkndeer, wéy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax ji, firil asamaan, wàcc;","poem":1},{"lineBreak":true},{"text":"laal tund yi, ñu saxaar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Melaxal, falaxe noon yi;","poem":1},{"lineBreak":true},{"text":"fittal, ñu fëlxoo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nga yóotoo ma fu kawe,","poem":1},{"lineBreak":true},{"text":"xettali ma, wallu ma ci doxandéem","poem":1},{"text":"yi def wali wal fi sama kaw,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"di fen, di giñ ay fen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yàlla, naa la woyal woy wu yees,","poem":1},{"lineBreak":true},{"text":"xalamal la xalamu fukki buum.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yaay may buur yi ndam,","poem":1},{"lineBreak":true},{"text":"yaa musal sa jaam ba, Daawuda, ci saamar bu aay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Musal ma, xettali ma ci loxol doxandéem","poem":1},{"text":"yiy fen, di giñ ay fen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Su boobaa sunu doom yu góor","poem":1},{"text":"màgge ndaw, ni gàncax gu mat sëkk;","poem":2},{"text":"sunuy janq jekk ni doji yatt yu ñu tabaxe kër buur.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sunuy sàq feese wirgoy wirgo,","poem":1},{"lineBreak":true},{"text":"sunuy gàtt jur junni,","poem":1},{"lineBreak":true},{"text":"ba fukki junni (10 000) ci parlu yi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nag yi ëmb ba diis,","poem":1},{"lineBreak":true},{"text":"du mbas, du biir bu yàqu,","poem":1},{"lineBreak":true},{"text":"te deesu fi yuuxoo pénc ya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ndokkalee xeet wu am lii!","poem":1},{"lineBreak":true},{"text":"Ndokkalee xeet wu yàllawoo Aji Sax ji!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}