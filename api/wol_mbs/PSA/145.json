{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":145,"content":[{"type":"heading","content":["Ma kañ Buur Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Di woyu màggal, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Sama Yàlla, Buur bi, naa la màggal,","poem":1},{"lineBreak":true},{"text":"teral sa tur ba fàww.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bésoo bés ma di la sant,","poem":1},{"lineBreak":true},{"text":"di màggal sa tur ba fàww!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax jee màgg te jara màggal a màggal,","poem":1},{"lineBreak":true},{"text":"kii màggam amul kemu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Na maasoo maas di màggal say jaloore,","poem":1},{"lineBreak":true},{"text":"di biral sa njàmbaarte.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa leeraayu ndam li ne ràññ,","poem":1},{"lineBreak":true},{"text":"ak sa jëf ju yéeme laay jàngat!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa dooley jëf ju raglu dees na ko jottali,","poem":1},{"lineBreak":true},{"text":"te sa màggaay maa koy yéene.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sa mbaax gu réy, dees na ko tari,","poem":1},{"lineBreak":true},{"text":"te sag njubte, dees na ko woy.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yiw ak yërmande, fa Aji Sax ji;","poem":1},{"lineBreak":true},{"text":"kee muñ mer te bare ngor!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji Sax jee baaxe ñépp,","poem":1},{"lineBreak":true},{"text":"di yërëm lu mu sàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aji Sax ji, lépp loo sàkk a lay gërëm,","poem":1},{"lineBreak":true},{"text":"sa wóllëre yi di la sant,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"di tudd sa darajay nguur,","poem":1},{"lineBreak":true},{"text":"tey dégtale sag njàmbaar,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"doom aadama xam say jaloore","poem":1},{"lineBreak":true},{"text":"ak sa darajay nguur gu màgg gi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sa nguur ay nguur gu sax dàkk,","poem":1},{"lineBreak":true},{"text":"sa kilifteef ñeel maasoo maas.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji daa sàmm ay waxam,","poem":1},{"lineBreak":true},{"text":"gore ciy jëfam.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku daanu, Aji Sax ji wallu;","poem":1},{"lineBreak":true},{"text":"ku sëgg, mu siggil.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñépp a la wékk bët, di yaakaar,","poem":1},{"lineBreak":true},{"text":"te bu jotee, yaa leen di leel,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"tàllal sa loxo,","poem":1},{"lineBreak":true},{"text":"reggal luy dund, ba xolam sedd.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aji Sax ji, jëfinam jépp njekk la,","poem":1},{"lineBreak":true},{"text":"jëfam jépp ngor la.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aji Sax ji, képp ku ko woo wall, mu jege la,","poem":1},{"lineBreak":true},{"text":"képp ku ko woo wall te muy dëgg.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nammeelu ku ko ragal, mu sottal;","poem":1},{"lineBreak":true},{"text":"yuuxam, mu dégg, musal.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aji Sax jeey sàmm kuy soppeem,","poem":1},{"lineBreak":true},{"text":"di sànk képp ku bon.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Naa sàlloo sant Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"na luy dund saxoo dàkk di màggal sellaayu turam!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}