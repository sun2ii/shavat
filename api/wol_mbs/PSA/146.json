{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":146,"content":[{"type":"heading","content":["Buur Yàllaa jara wóolu"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Naa màggale Aji Sax ji xol,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"fii ak may dund, di ko kañ,","poem":1},{"lineBreak":true},{"text":"fii ak may noyyi, di woy sama Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Buleen wóolu kilifa,","poem":1},{"lineBreak":true},{"text":"doom aadama amul wall.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Noo ga day rëcc, mu dellu suuf;","poem":1},{"lineBreak":true},{"text":"bu bés baa, pexeem jeex.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndokkalee kuy dimbalikoo Yàllay Yanqóoba;","poem":1},{"lineBreak":true},{"text":"di yaakaar Yàllaam Aji Sax ji,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ki sàkk kaw ak suuf,","poem":1},{"lineBreak":true},{"text":"géej ak lépp li ci biir,","poem":1},{"lineBreak":true},{"text":"di sàmm dëgg ba fàww,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"di àtte néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"di leel ku xiif.","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey tijji ku ñu tëj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax jeey xippil silmaxa,","poem":1},{"lineBreak":true},{"text":"di siggil ku sëgg.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee sopp ku jub.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji Sax jeey sàmm doxandéem,","poem":1},{"lineBreak":true},{"text":"taxawu jirim ak jëtun,","poem":1},{"lineBreak":true},{"text":"waaye mooy lajjal pexem ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aji Sax jeey nguuru ba fàww.","poem":1},{"lineBreak":true},{"text":"Yaw Siyoŋ, sa Yàllaa ñeel maasoo maas.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}