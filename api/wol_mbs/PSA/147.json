{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":147,"content":[{"type":"heading","content":["Yàllaa gën ci àddina, gën ci nit"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Kañ sunu Yàllaa baax,","poem":1},{"lineBreak":true},{"text":"màggal koo neex te war.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax jaa ngi tabaxaat Yerusalem,","poem":1},{"lineBreak":true},{"text":"di delloosi ña ñu dàqe Israayil,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"di faj naqaru xol,","poem":1},{"lineBreak":true},{"text":"fajtal góomi boroom.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mooy lim biddiiw yi,","poem":1},{"lineBreak":true},{"text":"tudd bu ci nekk.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sunu Boroom a màgg, bare doole;","poem":1},{"lineBreak":true},{"text":"am xelam wees kemu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax ji, néew-ji-doole, mu siggil;","poem":1},{"lineBreak":true},{"text":"ku bon, mu daane ci suuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Woyeleen Aji Sax ji kàddug cant,","poem":1},{"lineBreak":true},{"text":"kañeleen sunu Yàlla jii ay xalam;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mooy sànge asamaan ay niir,","poem":1},{"lineBreak":true},{"text":"tawal suuf,","poem":1},{"lineBreak":true},{"text":"saxal tund yi am ñax,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"leel mala,","poem":1},{"lineBreak":true},{"text":"xol liiru baaxoñ bu jooy.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kii nawul dooley fas,","poem":1},{"lineBreak":true},{"text":"gërëmul kàttanu jàmbaar.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ki Aji Sax ji gërëm mooy ki ko ragal","poem":1},{"lineBreak":true},{"text":"te di ko yaakaare ngoram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yerusalem, sargalleen Aji Sax ji!","poem":1},{"lineBreak":true},{"text":"yeen waa Siyoŋ laa ne, màggalleen seen Yàlla!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mooy tëj ràpp seen bunti dëkk,","poem":1},{"lineBreak":true},{"text":"barkeel seen askan wa ca biir,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"jàmmal seen suufas réew,","poem":1},{"lineBreak":true},{"text":"reggal leen ngëneelu pepp,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"yónnee suuf ndigalam,","poem":1},{"lineBreak":true},{"text":"kàddoom ne coww, daw ca.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mooy taw donji yuur yu weexe ni wëttéen.","poem":1},{"lineBreak":true},{"text":"di lay lay bu sedd, mel ni pënd ci suuf.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mooy yuri tawub yuuram niy doj.","poem":1},{"lineBreak":true},{"text":"Bu ni seddee, ana kuy taxaw?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mu yebal kàddoom, seeyal;","poem":1},{"lineBreak":true},{"text":"wal ngelawam, ndox walalaan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mooy wax Yanqóoba kàddoom,","poem":1},{"lineBreak":true},{"text":"dogalam yaak ndigali yoonam ñeel Israayil.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Loolu defalu ko wenn xeet;","poem":1},{"lineBreak":true},{"text":"kenn xamu ci ndigali yoonam.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}