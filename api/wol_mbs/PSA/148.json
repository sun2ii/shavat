màggal turu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"kii kat a santaane, lii lépp am.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo leen samp, ñu sax ba fàww,","poem":1},{"lineBreak":true},{"text":"mu dogal ko, te du toxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nangeen màggale Aji Sax ji fa kaw suuf,","poem":1},{"lineBreak":true},{"text":"yeen ninki-nankay géej ak xóote yépp,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ba ca melax yaak doj yu sedd yay taw,","poem":1},{"lineBreak":true},{"text":"ak tawub yuur akub lay,","poem":1},{"lineBreak":true},{"text":"ba ca ngëlén yu mag yay def ndigalam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Màggalleen ko yeen tund yu mag yeek","poem":1},{"lineBreak":true},{"text":"yu ndaw yépp,","poem":1},{"lineBreak":true},{"text":"ba ci garab yiy meññ ak garabi seedar yi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ba ci mala yépp, yu àll ak gépp jur","poem":1},{"lineBreak":true},{"text":"ak luy raam ak njanaaw,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ak buuri àddinaak xeet yépp,","poem":1},{"lineBreak":true},{"text":"ak kilifa yeek njiiti àddina yépp,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"xale bu góor ak bu jigéen,","poem":1},{"lineBreak":true},{"text":"mag ak ndaw.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Màggalleen turu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moom doŋŋ la turam kawe,","poem":1},{"lineBreak":true},{"text":"darajaam tiim asamaan ak suuf.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moo dooleel ñoñam,","poem":1},{"lineBreak":true},{"text":"wóllëreem ñiy mbooloom bànni Israayil,","poem":1},{"lineBreak":true},{"text":"xeet wi mu xejjoo, di ko màggal.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}