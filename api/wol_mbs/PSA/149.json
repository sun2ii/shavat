{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":149,"content":[{"type":"heading","content":["Na Israayil màggal Ki Sax"]},{"type":"verse","number":1,"content":[{"text":"Màggalleen Ki Sax!","poem":1},{"lineBreak":true},{"text":"Woyleen Aji Sax ji woy wu yees,","poem":1},{"lineBreak":true},{"text":"màggal ko fi ndajem wóllëreem ñi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na Israayil bége Kii ko sàkk,","poem":1},{"lineBreak":true},{"text":"doomi Siyoŋ, laa ne, ñu bànneexoo seen buur bii.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nañu màggale turam am pecc,","poem":1},{"lineBreak":true},{"text":"tëggal ko, xalamal ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax jee safoo ñoñam,","poem":1},{"lineBreak":true},{"text":"di terale néew-ji-doole ag mucc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Na wóllërey Yàlla bànneexoo seen ndam,","poem":1},{"lineBreak":true},{"text":"bu ñu tëddee sax, di sarxolle,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"di xaacuy kañ Yàlla,","poem":1},{"lineBreak":true},{"text":"ŋàbbaale saamaru ñaari ñawka,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ngir duma yéefar yi,","poem":1},{"lineBreak":true},{"text":"mbugale ko yooyu xeet,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"yeewe seeni buur ay càllala,","poem":1},{"lineBreak":true},{"text":"jénge seeni njiit jéngi weñ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ngir sottalal leen àtte bi ñu bind,","poem":1},{"lineBreak":true},{"text":"muy ndamu wóllërey Yàlla yépp.","poem":1},{"lineBreak":true},{"text":"Màggalleen Ki Sax!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}