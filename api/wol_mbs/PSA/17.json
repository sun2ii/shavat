{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":17,"content":[{"type":"heading","content":["Aji Sax ji, jox ma dëgg"]},{"type":"verse","number":1,"content":[{"text":"Di ñaanu Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Éy Aji Sax ji, déglul liy dëgg,","poem":1},{"lineBreak":true},{"text":"déglul, ma woote!","poem":1},{"lineBreak":true},{"text":"Teewlul, ma dagaane la","poem":1},{"lineBreak":true},{"text":"làmmiñ wu mucc fen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yal na sama àtte bawoo fi yaw,","poem":1},{"lineBreak":true},{"text":"nga gis sama njubte.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Natt nga saab xol, niir ma guddi,","poem":1},{"lineBreak":true},{"text":"settantal ma, gisoo dara.","poem":1},{"lineBreak":true},{"text":"Dogu naa ne duma moye wax.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su may jëf it, di sàmm sa kàddu.","poem":1},{"lineBreak":true},{"text":"Maay moyu yoonu ku bon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa tànk, sama tànk,","poem":1},{"lineBreak":true},{"text":"jàdduma fenn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Éy Yàlla, maa lay woo, nga di ma wuyu;","poem":1},{"lineBreak":true},{"text":"teewlu ma te déglu ma!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na sa ngor feeñ,","poem":1},{"lineBreak":true},{"text":"yaw miy walloo sa doole","poem":1},{"lineBreak":true},{"text":"ku la làqooy noonam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sàmm ma ni peru bët;","poem":1},{"lineBreak":true},{"text":"làqe ma sa ker,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ma rëcc ñu bon ñi ma song,","poem":1},{"lineBreak":true},{"text":"noon ñii ma gaw, nar maa bóom.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Seen xol dàq yërmande,","poem":1},{"lineBreak":true},{"text":"seeni wax di reewande.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tanc nañu nu fépp,","poem":1},{"lineBreak":true},{"text":"ne nu jàkk, nar noo tëral.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mbete gaynde gu namma fàdde,","poem":1},{"lineBreak":true},{"text":"gaynde gu mat guy tëroo!","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Éy Aji Sax ji, jógal dajeek moom, detteel ko.","poem":1},{"lineBreak":true},{"text":"Xettalee ma sa saamar, ma rëcc ku bon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, walloo ma sa doole,","poem":1},{"lineBreak":true},{"text":"ma rëcc ñi séddoo dundu àddina.","poem":1},{"lineBreak":true},{"text":"Say soppe, nga reggal,","poem":1},{"lineBreak":true},{"text":"seeni doom regg,","poem":1},{"lineBreak":true},{"text":"desalal seeni doom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Man nag ma am dëgg, ne la jàkk,","poem":1},{"lineBreak":true},{"text":"yewwu, regge sa jëmm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}