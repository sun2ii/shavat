{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":19,"content":[{"type":"heading","content":["Aji Sax ji màgg na"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Asamaan nee Yàlla màgg na,","poem":1},{"lineBreak":true},{"text":"kaw ne màww, biral liggéeyu loxoom!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bésoo bés kàddu seede ko,","poem":1},{"lineBreak":true},{"text":"guddee guddi xamle ca mbir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Du làkk, duy wax,","poem":1},{"lineBreak":true},{"text":"du baat bu dégtu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"suuf sépp la seen ndéey jibal,","poem":1},{"lineBreak":true},{"text":"seen kàddoo àkki cati àddina.","poem":1},{"lineBreak":true},{"text":"Kaw la Yàlla sampal jant xayma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mu mel ni boroom séet, génne néegam,","poem":1},{"lineBreak":true},{"text":"bég ni dawkat biy xélu cib joŋante.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asamaan lay fenke cat lii,","poem":1},{"lineBreak":true},{"text":"wëndeelu, sowi cat lee;","poem":1},{"lineBreak":true},{"text":"amul lu rëcc tàngooram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yoonu Aji Sax jee mat,","poem":1},{"lineBreak":true},{"text":"di leqali bakkan.","poem":1},{"lineBreak":true},{"text":"Lu Aji Sax ji seede dëgg la,","poem":1},{"lineBreak":true},{"text":"day xelal ku xeluwul.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lu Aji Sax ji tegtale, njub la,","poem":1},{"lineBreak":true},{"text":"di bégal xol.","poem":1},{"lineBreak":true},{"text":"Lu Aji Sax ji santaane, leeraange la,","poem":1},{"lineBreak":true},{"text":"di leeral gis-gis.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Santaaneb ragal Aji Sax ji mooy li sell","poem":1},{"lineBreak":true},{"text":"te sax ba fàww.","poem":1},{"lineBreak":true},{"text":"Lu Aji Sax ji digle, dëgg la,","poem":1},{"lineBreak":true},{"text":"ak njub gu sotti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Moo dàq wurus,","poem":1},{"lineBreak":true},{"text":"raw wurusu ngalam wu ne xas;","poem":1},{"lineBreak":true},{"text":"dàqati lem,","poem":1},{"lineBreak":true},{"text":"ëpp tem-tem.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Man, Sang bi, ci laay leerloo,","poem":1},{"lineBreak":true},{"text":"ku ko sàmm yokku yool.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nit juum na, umple ko,","poem":1},{"lineBreak":true},{"text":"baal ma tooñ gu ma umple.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Te Sang bi, musal ma ci bàkkaaru teyeef,","poem":1},{"lineBreak":true},{"text":"mu bañ maa jiital,","poem":1},{"lineBreak":true},{"text":"ma mana màndu,","poem":1},{"lineBreak":true},{"text":"mucc moy gu réy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Éy Aji Sax ji, lu saaw làmmiñ tudd","poem":1},{"lineBreak":true},{"text":"mbaa sama xol déey ma ko,","poem":1},{"lineBreak":true},{"text":"yal nay loo gërëm,","poem":1},{"lineBreak":true},{"text":"yaa may aar, yaa ma jot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":15}