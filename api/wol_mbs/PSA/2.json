{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":2,"content":[{"type":"heading","content":["Yàlla fal na buur"]},{"type":"verse","number":1,"content":[{"text":"Ana lu xeeti àddina di riire,","poem":1},{"lineBreak":true},{"text":"lu xeet yiy lale pexey neen?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buuri àddinaa jógandoo,","poem":1},{"lineBreak":true},{"text":"kilifa yee lëkkoo,","poem":1},{"lineBreak":true},{"text":"di fexeel Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"mook ki mu fal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ña nga naan: «Nanu dagg càllala yi,","poem":1},{"lineBreak":true},{"text":"sànni jéng yi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ki ci jalub asamaan a ngay ree,","poem":1},{"lineBreak":true},{"text":"Boroom baa nga leen di kókkali,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mer, ba gëdd leen,","poem":1},{"lineBreak":true},{"text":"xadaru, tiital leen ne:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«Man maa tabb buur, fal ko ci Siyoŋ,","poem":1},{"lineBreak":true},{"text":"sama tund wu sell.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Buur ne: «Ma biral dogalu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moom mi ma ne: “Yaa di sama doom,","poem":1},{"lineBreak":true},{"text":"bés niki tey, maa la jur","poem":1},{"noteId":0},{"text":".","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñaan ma xeeti àddina, ma sédd la ko,","poem":1},{"lineBreak":true},{"text":"nga moom ba ca cati àddina,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"jiitee leen yetu weñ,","poem":1},{"lineBreak":true},{"text":"rajaxe leen ni njaqal xandeer.”»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kon yeen buur yi, muusleen,","poem":1},{"lineBreak":true},{"text":"kilifay àddina, fàgguleen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jaamuleen Aji Sax ji, ragal ko,","poem":1},{"lineBreak":true},{"text":"di ko bége, ba yaram daw.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sujjóotalleen doom ji, bala moo mer,","poem":1},{"lineBreak":true},{"text":"ngeen sànkoo seenu yoon;","poem":1},{"lineBreak":true},{"text":"meram day jekki ne jippét,","poem":1},{"lineBreak":true},{"text":"waaye ndokkalee képp ku ko làqoo!","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.7 jur: su Yàlla nee moo jur buur bi, waxin la rekk. Bés bi ñuy fal buur bi la Yàlla di biral ne jàppe na buur bi ni doomam. Ni doom di teewale baayam, ni la buur biy teewale Yàlla ci kaw suuf. Ni baay di sàmme doomam it, ni la Yàlla di sàmme buur bi, ngir mu am ndam. Seetal ci 2.Samiyel 7.12-16.","reference":{"chapter":2,"verse":7}}]},"thisChapterLink":"/api/wol_mbs/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}