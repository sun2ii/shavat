{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":20,"content":[{"type":"heading","content":["Yal na Buur daan"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Buur, yal na la Aji Sax ji nangul bésu njàqare,","poem":1},{"lineBreak":true},{"text":"yal na la turu Yàllay Yanqóoba aj fu kawe,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"yal na la yónnee wallam fa këram,","poem":1},{"lineBreak":true},{"text":"jàppalee la fa, ca Siyoŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yal na xool loo ko jébbal,","poem":1},{"lineBreak":true},{"text":"di rafetlu sarax soo ko lakkal. Selaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yal na la may li nga namm,","poem":1},{"lineBreak":true},{"text":"di sottal loo mébét,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ngay daan, nuy ree,","poem":1},{"lineBreak":true},{"text":"yéege sunu raaya, màggal sunu Yàlla.","poem":1},{"lineBreak":true},{"text":"Yal na Aji Sax ji nangu loo dagaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aji Sax jeey musal ki mu fal, bir na ma tey.","poem":1},{"lineBreak":true},{"text":"Moo koy nangule fa asamaan su sell sa,","poem":1},{"lineBreak":true},{"text":"ci dooley ndijooram biy musle.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñiiki watiir,","poem":1},{"lineBreak":true},{"text":"ñeeki fas,","poem":1},{"lineBreak":true},{"text":"nun sunu turu Yàlla Aji Sax ji lanuy tudd.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ñoom ñooy jeng aka jóoru,","poem":1},{"lineBreak":true},{"text":"nun, nu jóg, taxaw jonn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Éy Aji Sax ji, mayal Buur mu daan,","poem":1},{"lineBreak":true},{"text":"te bés bu nu ko ñaane, mu nangul nu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}