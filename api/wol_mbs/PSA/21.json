{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":21,"content":[{"type":"heading","content":["Aji Sax ji baaxe na Buur"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Céy Aji Sax ji, Buur a ngi bége sa doole,","poem":1},{"lineBreak":true},{"text":"di bànneexoo sag wall rekk.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaa ko may nammeeli xolam,","poem":1},{"lineBreak":true},{"text":"gàntuwulooy dagaanam. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaa ko gatandoo barkey ngëneel,","poem":1},{"lineBreak":true},{"text":"kaalaa ko wurusu ngalam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mu ñaan mucc,","poem":1},{"lineBreak":true},{"text":"nga saxal jalam fàww,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"sag wall a ko sagal a sagal!","poem":1},{"lineBreak":true},{"text":"Teraangaak daraja nga ko sédd,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"jagleel ko barke bu sax dàkk,","poem":1},{"lineBreak":true},{"text":"bégale ko sa kanam, mu bànneexu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buur wóolu na Aji Sax ji, moos,","poem":1},{"lineBreak":true},{"text":"du tërëf, Aji Kawe jee gore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Buur, yaa naan sa noon yépp céex,","poem":1},{"lineBreak":true},{"text":"ne say bañ taral.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Soo nee jalañ, jafal, ñu boy.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji mer, sànk leen,","poem":1},{"lineBreak":true},{"text":"sawara xoyom leen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaay raafal seeni giir fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"fey seen askan ci doom aadama yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñoo la mébal lu bon,","poem":1},{"lineBreak":true},{"text":"nasal la pexe, àntuwul.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nga di leen diir fittu kanam,","poem":1},{"lineBreak":true},{"text":"ñu wone gannaaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aji Sax ji, jógal ak sa manoore,","poem":1},{"lineBreak":true},{"text":"nu joobe la, woy sa jaloore.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}