{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":22,"content":[{"type":"heading","content":["Jëkke jàq, mujje sant"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda, dëppook galan bi ñu dippee Kéwélu fajar.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sama Yàlla, sama Yàlla, lu tax nga wacc ma?","poem":1},{"lineBreak":true},{"text":"Ma binni, binneeti, wall sore.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Éy sama Yàlla, ma woote bëccëg, wuyuwoo;","poem":1},{"lineBreak":true},{"text":"woote guddi, noppaloo ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaw de, yaay ku sell, tooge sab jal,","poem":1},{"lineBreak":true},{"text":"Israayil di la kañ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaw la sunuy maam wóolu woon,","poem":1},{"lineBreak":true},{"text":"wóolu la, nga xettali leen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw lañu daa woo wall, mucc;","poem":1},{"lineBreak":true},{"text":"yaw lañu wóolu woon te rusuñu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Man nag aw sax rekk laa, matuma nit.","poem":1},{"lineBreak":true},{"text":"Doom aadama sewal ma, aw xeet tuutal ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ku ma gis ñaawal ma,","poem":1},{"lineBreak":true},{"text":"biiñ ma, xeelu ma, naa:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Na wéeru ci Aji Sax ji, mu xettali ko;","poem":1},{"lineBreak":true},{"text":"su ko soppee, na ko wallu.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yaw de yaa ma roccee sama biiru ndey,","poem":1},{"lineBreak":true},{"text":"naxe ma sama weenu yaay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaw laa dénkoo ba may juddu,","poem":1},{"lineBreak":true},{"text":"ba ma juddu ci sama ndey, ngay sama Yàlla.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bul ma sore,","poem":1},{"lineBreak":true},{"text":"musiba teew na, wall amul!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Noon yaa ngi ma gaw ni coggalu yëkk,","poem":1},{"lineBreak":true},{"text":"dar ma ni ponkali yëkk ya fa Basan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ñu ŋa ma, ŋàpp,","poem":1},{"lineBreak":true},{"text":"ni gaynde guy yëmmooka fàdde.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Doole ŋiis,","poem":1},{"lineBreak":true},{"text":"yax yoqi,","poem":1},{"lineBreak":true},{"text":"fit ne soyox, seey.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Làmmiñ taqoo denqleñ,","poem":1},{"lineBreak":true},{"text":"doole jeex, ma wow koŋŋ,","poem":1},{"lineBreak":true},{"text":"nga tëral ma buntu bàmmeel.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ay xaj a ma wër,","poem":1},{"lineBreak":true},{"text":"di gàngooru saay-saay, dar ma kepp,","poem":1},{"lineBreak":true},{"text":"bëtt samay loxook samay tànk.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Maa ngii, mana waññ sama yax yépp,","poem":1},{"lineBreak":true},{"text":"ñoom ñuy xoole, di ma seetaan,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"séddoo samay yére,","poem":1},{"lineBreak":true},{"text":"tegoo bant sama mbubb.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Waaye yaw, Aji Sax ji, bul sore;","poem":1},{"lineBreak":true},{"text":"yaa may dooleel, gaawe ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xettalil sama bakkan ci saamar,","poem":1},{"lineBreak":true},{"text":"ba sama benn bakkan bii mucc ci selli xaj!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Musal ma ci pàddum gaynde ak ndañum nagu àll.","poem":1},{"lineBreak":true},{"text":"Yaa ma wallu woon!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Maay siiwali saw tur ci samay bokk,","poem":1},{"lineBreak":true},{"text":"maa lay kañ fi digg mbooloo mi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yeen ñi ragal Aji Sax ji, santleen ko.","poem":1},{"lineBreak":true},{"text":"Yeen askanu Yanqóoba wépp, màggalleen ko.","poem":1},{"lineBreak":true},{"text":"Yeen bànni Israayil gépp, wormaalleen ko.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Moom de sàgganewul mbaa xeebul boroom tiis,","poem":1},{"lineBreak":true},{"text":"làqu ko kanamam,","poem":1},{"lineBreak":true},{"text":"ba mu wootee, wuyu na ko.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yaw laay sante ndaje mu mag,","poem":1},{"lineBreak":true},{"text":"sottalal la samay dige","poem":1},{"noteId":5},{"text":", ñi la ragal seede.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ku woyof a cay lekk ba doyal,","poem":1},{"lineBreak":true},{"text":"kuy wut Aji Sax ji, sant ko.","poem":1},{"lineBreak":true},{"text":"«Guddleen a gudd fan!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Àddina wërngal këpp ay fàttaliku,","poem":1},{"lineBreak":true},{"text":"walbatiku ci Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Làngi xeet yépp sukkalsi ko.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aji Sax jeey boroom nguur,","poem":1},{"lineBreak":true},{"text":"moo yilif xeet yi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Boroom barke xéewlu, sujjóotal ko,","poem":1},{"lineBreak":true},{"text":"ku jëm pax it, te bakkanam di lang,","poem":1},{"lineBreak":true},{"text":"di ko sukkal.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Askan wu dikkagul dina jaamu Boroom bi,","poem":1},{"lineBreak":true},{"text":"ñiy ñëw te juddooguñu dees na leen wax ay mbiram.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ñu dikk, biral njubteem,","poem":1},{"lineBreak":true},{"text":"jottali xeet wu sosoogul jalooreem.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"22.26 sottalal la samay dige: dige yooyu ay saraxi cant la yu ñuy bokk lekk. Ki koy joxe mooy ñaanal ñi mu ci woo jàmm ak wér ak barke.","reference":{"chapter":22,"verse":26}}]},"thisChapterLink":"/api/wol_mbs/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":32}