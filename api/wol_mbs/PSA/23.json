{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":23,"content":[{"type":"heading","content":["Aji Sax jee may sàmm"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda, dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax jee may sàmm,","poem":1},{"lineBreak":true},{"text":"du lenn lu ma ñàkk.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Parlu mu naat la may gooral,","poem":1},{"lineBreak":true},{"text":"wal mu dal, mu tette ma ca,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"leqali ma,","poem":1},{"lineBreak":true},{"text":"teg ma ci yooni njub","poem":1},{"lineBreak":true},{"text":"ngir teraangay turam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su may jaare xuru dee wu ne këruus it,","poem":1},{"lineBreak":true},{"text":"duma ragal loraange:","poem":1},{"lineBreak":true},{"text":"yaw laak man,","poem":1},{"lineBreak":true},{"text":"sa bantu sàmm ak sa nguul,","poem":1},{"lineBreak":true},{"text":"yooyoo may dalal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa ma berndeel,","poem":1},{"lineBreak":true},{"text":"noon yi gis,","poem":1},{"lineBreak":true},{"text":"nga diwal ma saa bopp, terale ma,","poem":1},{"lineBreak":true},{"text":"saab kaas rembat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mbaax ak ngor kay la ma Aji Sax jiy dare sama giiru dund,","poem":1},{"lineBreak":true},{"text":"ma dëkke këram ba fàww.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}