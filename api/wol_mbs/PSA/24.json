{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":24,"content":[{"type":"heading","content":["Ana kuy màggal Buur Yàlla?"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda, dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax jee moom suuf ak li ko fees,","poem":1},{"lineBreak":true},{"text":"ak àddina ak li ci biiram.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moo samp suuf biir géej,","poem":1},{"lineBreak":true},{"text":"dëj ko ci kaw wal mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ana kuy yéegi tundu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"kuy taxawi bérebam bu sell ba?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xanaa ku mucc ayib te xolam laab,","poem":1},{"lineBreak":true},{"text":"xemmemul caaxaani neen,","poem":1},{"lineBreak":true},{"text":"du giñey fen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kookooy jagoo barkeb Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ak àtteb dëggu Yàlla mi koy musal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ñooñooy waa làng gi lay wut,","poem":1},{"lineBreak":true},{"text":"di maasug Yanqóoba giy sàkku sa yiw. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Neleen bunt yi kulbét,","poem":1},{"lineBreak":true},{"text":"ubbileen bunti cosaan yi,","poem":1},{"lineBreak":true},{"text":"Buur, Boroom ndam duggsi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buur, Boroom ndam booboo di kan?","poem":1},{"lineBreak":true},{"text":"Xanaa Aji Sax ji Boroom dooleek njàmbaar,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji jàmbaaru xare ji.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Neleen bunt yi kulbét,","poem":1},{"lineBreak":true},{"text":"ubbileen bunti cosaan yi,","poem":1},{"lineBreak":true},{"text":"Buur, Boroom ndam duggsi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buur, Boroom ndam booboo di kan?","poem":1},{"lineBreak":true},{"text":"Xanaa Aji Sax ju gàngoor yi.","poem":1},{"lineBreak":true},{"text":"Kookooy Buur, Boroom ndam. Selaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}