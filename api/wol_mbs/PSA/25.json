{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":25,"content":[{"type":"heading","content":["Aji Sax jeey gindee, di yiire"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji, yaw laay diis sama bakkan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sama Yàlla, yaw laa yaakaar.","poem":1},{"lineBreak":true},{"text":"Yàlla buma rus,","poem":1},{"lineBreak":true},{"text":"noon yi ree.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Deesu la séentu, ba rus.","poem":1},{"lineBreak":true},{"text":"Kuy wor ci neen mooy rus.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Éy, Aji Sax ji, won ma saw yoon,","poem":1},{"lineBreak":true},{"text":"xamal ma fi nga ma jaarloo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jiitee ma sag dëgg, jàngal ma.","poem":1},{"lineBreak":true},{"text":"Yaw yaay Yàlla ji may musal,","poem":1},{"lineBreak":true},{"text":"ma di la yendoo yaakaar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax ji, bàyyil xel sa yërmandeek sa ngor,","poem":1},{"lineBreak":true},{"text":"sa jikkoo ngi fés ba nëgëni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bul xool li ma bàkkaare ndaw ak li ma moy.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, xoole ma sa ngor ngir sag mbaax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aji Sax jee baax, rafeti dogal,","poem":1},{"lineBreak":true},{"text":"di gindi moykat ci yoon wi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"di jiite ku woyof mbubb ci njubte,","poem":1},{"lineBreak":true},{"text":"di ko xamal aw yoonam.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aji Sax ji ngor ak dëgg rekk lay jiitee","poem":1},{"lineBreak":true},{"text":"kuy sàmm kóllëreem ak seedey yoonam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Éy Aji Sax ji, tooñ naa lool,","poem":1},{"lineBreak":true},{"text":"jéggal ma ngir sa tur.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ana kuy wormaal Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"mu won ko yoon wi mata tànn,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"muy dunde ngëneel,","poem":1},{"lineBreak":true},{"text":"askanam moom réew mi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndéeyu Aji Sax ji, jagley ku ko ragal.","poem":1},{"lineBreak":true},{"text":"Kóllëreem la koy xamal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Samay gët jàkk rekk ci Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo may xettali ci fiiru noon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngalla geesu ma, baaxe ma,","poem":1},{"lineBreak":true},{"text":"maa wéet, néew doole,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"sama xol feesey xalaat.","poem":1},{"lineBreak":true},{"text":"Rikk, teggil ma njàqare!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xoolal sama naqar ak sama tiis,","poem":1},{"lineBreak":true},{"text":"te baal ma bépp bàkkaar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Xoolal noon yi ne gàññ,","poem":1},{"lineBreak":true},{"text":"bañ ma mbañeelu fitna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Éy, aar ma, musal ma!","poem":1},{"lineBreak":true},{"text":"Bu ma rusloo,","poem":1},{"lineBreak":true},{"text":"yaw laa làqoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yal na ma mànduteek njub taxawu,","poem":1},{"lineBreak":true},{"text":"maa ngii, di la xaar.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Éy Yàlla, teggilal Israayil tiisoo tiis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}