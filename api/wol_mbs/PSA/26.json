{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":26,"content":[{"type":"heading","content":["Ma waajal ndajem kër Aji Sax ji"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax ji, àtte ma,","poem":1},{"lineBreak":true},{"text":"man de màndu laa wéye,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji laa wóolu, jenguma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax ji, nattu ma, seetlu ma,","poem":1},{"lineBreak":true},{"text":"seggal xel ak xol.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maa ngi janook sa ngor,","poem":1},{"lineBreak":true},{"text":"di doxe sa dëgg.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Toogumaak naxekat,","poem":1},{"lineBreak":true},{"text":"lëngoowumaak naaféq,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"sib naa gàngooru saay-saay,","poem":1},{"lineBreak":true},{"text":"toogumaak ku bon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax ji, maay jàpp ci biir mucc ayib,","poem":1},{"lineBreak":true},{"text":"di wër sa sarxalukaay,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"àddu, sant la,","poem":1},{"lineBreak":true},{"text":"lim sa jépp jaloore.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax ji, maa sopp sa dëkkuwaay,","poem":1},{"lineBreak":true},{"text":"bëgg béreb bi sag leer teew.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bu ma buubaaleek bàkkaarkat, sànni,","poem":1},{"lineBreak":true},{"text":"di ma booleek bóomkat, bóom.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Seeni loxoo nga sóobu ci mbon,","poem":1},{"lineBreak":true},{"text":"ndijoor ya fees aki ger.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Man nag màndu laay wéye,","poem":1},{"lineBreak":true},{"text":"tee nga maa jot, baaxe ma?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ndokk bi ma taxawee joor gu wóor.","poem":1},{"lineBreak":true},{"text":"Ma màggal Aji Sax ji fi ndajey way-ngëm ñi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}