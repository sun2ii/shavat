{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":27,"content":[{"type":"heading","content":["Xare jib, ma ànd ak Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Aji Sax jee may leeral, di ma wallu.","poem":1},{"lineBreak":true},{"text":"Ana ku may ragal?","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey aar sama bakkan.","poem":1},{"lineBreak":true},{"text":"Ana ku may tiit?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ab soxor wutsi ma,","poem":1},{"lineBreak":true},{"text":"nar maa yàpp,","poem":1},{"lineBreak":true},{"text":"noonoo ma, bañ ma;","poem":1},{"lineBreak":true},{"text":"mooy tërëf, fëlëñu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bu gàngoor booloo sama kaw,","poem":1},{"lineBreak":true},{"text":"duma raf.","poem":1},{"lineBreak":true},{"text":"Ab xare jib,","poem":1},{"lineBreak":true},{"text":"ma ànd ak Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lenn laa ñaan Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"lii laay sàkku:","poem":1},{"lineBreak":true},{"text":"dëkk kër Aji Sax ji","poem":1},{"lineBreak":true},{"text":"sama giiru dund,","poem":1},{"lineBreak":true},{"text":"di niir taaru Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te yéemoo këram.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bésub fitna, mu yiire ma mbaaram,","poem":1},{"lineBreak":true},{"text":"làq ma, ma làqoo xaymaam,","poem":1},{"lineBreak":true},{"text":"aj ma ciw doj, ma raw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma doxe fa siggi,","poem":1},{"lineBreak":true},{"text":"tiim noon yi ma wër,","poem":1},{"lineBreak":true},{"text":"di sarxali fa xaymaam saraxi sarxolle.","poem":1},{"lineBreak":true},{"text":"Naa woyal Aji Sax ji, joobe ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Éy Aji Sax ji, déglul, ma woote!","poem":1},{"lineBreak":true},{"text":"Ngalla baaxe ma, nangul ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaw la sam xel ne ma, ma jaamu la,","poem":1},{"lineBreak":true},{"text":"te it yaw Aji Sax ji laay jaamu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sang bi, bu ma làqu,","poem":1},{"lineBreak":true},{"text":"bul mer, jañax ma.","poem":1},{"lineBreak":true},{"text":"Yaa ma daa wallu.","poem":1},{"lineBreak":true},{"text":"Bu ma wacc, bu ma ba,","poem":1},{"lineBreak":true},{"text":"yaay Yàlla mi may musal.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndey ak baay man nañu maa wacc,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji fat ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, joxoñ ma saw yoon,","poem":1},{"lineBreak":true},{"text":"jaarale ma joor gu wóor,","poem":1},{"lineBreak":true},{"text":"ngir ñi may tëru.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bu ma bàyyee bànneexu noon.","poem":1},{"lineBreak":true},{"text":"Seedey naaféq a ma jógal,","poem":1},{"lineBreak":true},{"text":"di sos fitna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maay dajeek ngëneelu Aji Sax ji","poem":1},{"lineBreak":true},{"text":"fi kaw suuf sii.","poem":1},{"lineBreak":true},{"text":"Lii wóor na ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaakaaral Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"dëgërlul te amu fit,","poem":1},{"lineBreak":true},{"text":"te yaakaarati Aji Sax ji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}