{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":28,"content":[{"type":"heading","content":["Aji Sax jeey àtte ñoñam"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Éy Aji Sax ji, yaw laay woo,","poem":1},{"lineBreak":true},{"text":"di la wéeroo, bu ma tanqamlu.","poem":1},{"lineBreak":true},{"text":"Soo nee cell,","poem":1},{"lineBreak":true},{"text":"ma xawa tàbbim pax.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ngalla déglul, ma tinu la,","poem":1},{"lineBreak":true},{"text":"woo la wall,","poem":1},{"lineBreak":true},{"text":"dékk lay loxo,","poem":1},{"lineBreak":true},{"text":"jublu sa néegu biir bu sell ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bu ma sànkaaleek ab soxor,","poem":1},{"lineBreak":true},{"text":"di ma booleek kuy def lu bon,","poem":1},{"lineBreak":true},{"text":"di wax moroom ma jàmm,","poem":1},{"lineBreak":true},{"text":"te dencal ko ay ca xolam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fey leen seen liggéey,","poem":1},{"lineBreak":true},{"text":"seen kemu jëf ju bon.","poem":1},{"lineBreak":true},{"text":"Jox leen seen añu jëf,","poem":1},{"lineBreak":true},{"text":"yool leen seen yelleef.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xooluñu Aji Sax jeeki jëfam,","poem":1},{"lineBreak":true},{"text":"ak liggéey bi mu def.","poem":1},{"lineBreak":true},{"text":"Da leen di yàqate,","poem":1},{"lineBreak":true},{"text":"te dootu leen yékkati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jaajëfe Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ki ma nangul samay dagaan!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax jee may dooleel, di ma feg.","poem":1},{"lineBreak":true},{"text":"Moom laa wóolu, mu wallu ma,","poem":1},{"lineBreak":true},{"text":"sama xol tooy,","poem":1},{"lineBreak":true},{"text":"ma woy, sante ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax jeey dooleel ñoñam.","poem":1},{"lineBreak":true},{"text":"Mooy làq, di musal buur bi mu fal.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ngalla musalal sa mbooloo,","poem":1},{"lineBreak":true},{"text":"barkeelal sa ñoñ ñii,","poem":1},{"lineBreak":true},{"text":"sàmm leen, boot ba fàww.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}