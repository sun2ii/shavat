{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":3,"content":[{"type":"heading","content":["Aji jub a ngi woote wall"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Daawuda, ba muy daw Absalom doomam ju góor","descriptive":true},{"noteId":1},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, noon yeeka bare!","poem":1},{"lineBreak":true},{"text":"Ñu baree may jógal,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ñu baree may tooge naa:","poem":1},{"lineBreak":true},{"text":"«Yàlla du ko wallu!» Selaw","poem":1},{"noteId":2},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waaye yaw Aji Sax ji, yaa may feg,","poem":1},{"lineBreak":true},{"text":"di ma teral, di ma siggil.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maay woo Aji Sax ji wall,","poem":1},{"lineBreak":true},{"text":"mu walloo ma fa tundam wu sell wa. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maay tëdd nelaw, yewwu;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji di ma aar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñu dul jeex a ma jógal, gaw ma,","poem":1},{"lineBreak":true},{"text":"te duma ragal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Éy Aji Sax ji sama Yàlla,","poem":1},{"lineBreak":true},{"text":"jógal, wallu ma!","poem":1},{"lineBreak":true},{"text":"Yaa toj kaabaabi noon yu bon yépp,","poem":1},{"lineBreak":true},{"text":"foq seeni sell.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaa moom wall,","poem":1},{"lineBreak":true},{"text":"sa mbooloo jagoo sa barke. Selaw.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"3.1 Seetal ci 2.Samiyel saar 15—16.","reference":{"chapter":3,"verse":1}},{"noteId":2,"caller":"+","text":"3.3 Selaw: jàpp nañu ne ndigal la luy taxawloo woykat yi, te jombul xalam yi wéy ba tey. Waaye man naa nekk itam ndigal ngir xalam yeek woykat yi gëna xumbal.","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/wol_mbs/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}