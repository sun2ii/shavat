{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":30,"content":[{"type":"heading","content":["Mucc, bég"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Daawuda ca daloob kër Yàlla ga.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aji Sax ji, dama lay kañ.","poem":1},{"lineBreak":true},{"text":"Yaa ma yékkati,","poem":1},{"lineBreak":true},{"text":"ba noon reetaanu ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji sama Yàlla, maa la woo wall,","poem":1},{"lineBreak":true},{"text":"nga faj ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaa ma jukkee njaniiw,","poem":1},{"lineBreak":true},{"text":"may ma bakkan, ma tàggook ñiy tàbbi njaniiw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yeen aji gëm ñi, woyleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"njukkale ko sellaayam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meram di lu gàtt,","poem":1},{"lineBreak":true},{"text":"aw yiwam sax dàkk.","poem":1},{"lineBreak":true},{"text":"Rongooñ gane, fanaan,","poem":1},{"lineBreak":true},{"text":"ay ree xëysi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Man damaa baaxle woon, ba ne:","poem":1},{"lineBreak":true},{"text":"«Deesu ma rëññeel mukk.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax ji, booba yaa ma baaxe,","poem":1},{"lineBreak":true},{"text":"dëj ma, ma ne kekk niw tund.","poem":1},{"lineBreak":true},{"text":"Nga fuuyu, ma jàq.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaw laa woo wall;","poem":1},{"lineBreak":true},{"text":"Boroom bi, yaw laa ñaanu yiw,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ne la: «Ma dee, tàbbi bàmmeel,","poem":1},{"lineBreak":true},{"text":"ana lu mu lay jariñ?","poem":1},{"lineBreak":true},{"text":"Nu la pëndu pax di sante,","poem":1},{"lineBreak":true},{"text":"bay biral sa kóllëre?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aji Sax ji, déglul, baaxe ma;","poem":1},{"lineBreak":true},{"text":"éy Aji Sax ji, dimbali ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yaa ma soppil samay rongooñ ay ree,","poem":1},{"lineBreak":true},{"text":"summi sama yérey tiis, solal ma bànneex.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Naa la woye xol, baña selaw.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, sama Yàlla, ma sant la ba fàww!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}