{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":31,"content":[{"type":"heading","content":["Naa siggi, noon sëgg"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aji Sax ji, yaw laa làqoo,","poem":1},{"lineBreak":true},{"text":"yàlla buma rus mukk.","poem":1},{"lineBreak":true},{"text":"Yiwee ma sa àtteb dëgg.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teewlu ma,","poem":1},{"lineBreak":true},{"text":"gaawe ma,","poem":1},{"lineBreak":true},{"text":"Yal nangay sama cëslaay, sama rawtu.","poem":1},{"lineBreak":true},{"text":"Aar ma, ma mucc.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaay sama cëslaay, sama rawtu.","poem":1},{"lineBreak":true},{"text":"Jiite ma, wommat ma ngir sa tur.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Génne ma fiir gi ñu may tëroo;","poem":1},{"lineBreak":true},{"text":"yaw yaa di sama rawtu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw laa jébbal samag noo.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, Yàlla miy dëgg, ngalla jot ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maa bañ kuy topp tuuri neen.","poem":1},{"lineBreak":true},{"text":"Man, Aji Sax ji laa wóolu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Damay bég, di bànneexoo sa ngor,","poem":1},{"lineBreak":true},{"text":"li nga xoole samaw tiis.","poem":1},{"lineBreak":true},{"text":"Ràññee nga sama njàqarey xol.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waccoo ma ci loxol noon,","poem":1},{"lineBreak":true},{"text":"danga maa taxawal fu ma yaatoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Éy Aji Sax ji, baaxe ma, jàq naa!","poem":1},{"lineBreak":true},{"text":"Samay gët a ngi giim ndaxu tiis,","poem":1},{"lineBreak":true},{"text":"xol jeex, yaram jeex.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naqar a ngi may rey,","poem":1},{"lineBreak":true},{"text":"tiis di wàññi samay fan,","poem":1},{"lineBreak":true},{"text":"sama doole ŋiis ndax sama njubadi,","poem":1},{"lineBreak":true},{"text":"samay yax semm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Noonoo noon a ma sewal,","poem":1},{"lineBreak":true},{"text":"dëkkandoo waxi noppi,","poem":1},{"lineBreak":true},{"text":"xame seexlu ma,","poem":1},{"lineBreak":true},{"text":"ku ma gis biti, di ma daw.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kenn xalaatu ma, xanaa fàtte ma ni ku dee,","poem":1},{"lineBreak":true},{"text":"ma mel ni ndab lu yàqu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Damaa dégg jëw yu bare,","poem":1},{"lineBreak":true},{"text":"lu raglu dar ma kepp.","poem":1},{"lineBreak":true},{"text":"Ñu ngi mànkoo, di ma fexeel,","poem":1},{"lineBreak":true},{"text":"di wut sama bakkan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Man nag Aji Sax ji, ci yaw laa dénku.","poem":1},{"lineBreak":true},{"text":"Ma ne: «Yaay sama Yàlla.»","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yaa yor sama àpp.","poem":1},{"lineBreak":true},{"text":"Xettali maak ku ma noonoo","poem":1},{"lineBreak":true},{"text":"ak ku may sonal.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Leeralal ma sa kanam, Sang bi,","poem":1},{"lineBreak":true},{"text":"walloo ma sa ngor.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, woo naa la wall,","poem":1},{"lineBreak":true},{"text":"yàlla buma rus.","poem":1},{"lineBreak":true},{"text":"Yal na ku bon rus,","poem":1},{"lineBreak":true},{"text":"ne xerem biir njaniiw.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yal nanga tëj gémmiñu fen-kat","poem":1},{"lineBreak":true},{"text":"buy wax aji jub waxi reewande,","poem":1},{"lineBreak":true},{"text":"di réy-réylooka xeebaate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yàlla yaa yaatu ngëneel","poem":1},{"lineBreak":true},{"text":"loo dencal ku la ragal,","poem":1},{"lineBreak":true},{"text":"defal ko ku la làqoo,","poem":1},{"lineBreak":true},{"text":"doom aadama seede.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yaa koy làq fa nga làqu,","poem":1},{"lineBreak":true},{"text":"fa pexey nit àggul.","poem":1},{"lineBreak":true},{"text":"Nga yiir ko, mu yiiru","poem":1},{"lineBreak":true},{"text":"ci ayu làmmiñ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Cant ñeel na Aji Sax ji!","poem":1},{"lineBreak":true},{"text":"Ndaw kéemtaan ci ngor li mu ma jiwe","poem":1},{"lineBreak":true},{"text":"biir dëkk bu ñu gaw.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Man nag saalitoon naa ne:","poem":1},{"lineBreak":true},{"text":"«Yàlla dagg na ma, sànni!»","poem":1},{"lineBreak":true},{"text":"Ndeke ba ma lay woo,","poem":1},{"lineBreak":true},{"text":"dégg nga samay dagaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Képp kuy aji gëm, soppal Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey sàmm ku ko gëm,","poem":1},{"lineBreak":true},{"text":"di yool, ba wis kuy réy-réylu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Képp ku yaakaar Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"dëgërlul te amu fit.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":25}