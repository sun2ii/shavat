{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":32,"content":[{"type":"heading","content":["Njéggal barke la"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu yeete, ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Ndokkalee yaw mi ñu baal ag moy,","poem":1},{"lineBreak":true},{"text":"jéggal la bàkkaar.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndokkalee yaw mi Aji Sax ji toppul say tooñ,","poem":1},{"lineBreak":true},{"text":"te amoo xelum njublaŋ it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ba ma nee cell,","poem":1},{"lineBreak":true},{"text":"damaa ràgg,","poem":1},{"lineBreak":true},{"text":"dëkke naqar.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guddeek bëccëg","poem":1},{"lineBreak":true},{"text":"sa loxo diis gann ci man.","poem":1},{"lineBreak":true},{"text":"Sama doole ŋiis","poem":1},{"lineBreak":true},{"text":"ni ndox mu jaas upp. Selaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma xamal la ne moy naa,","poem":1},{"lineBreak":true},{"text":"làqatuma la sama ñaawtéef.","poem":1},{"lineBreak":true},{"text":"Ma ne: «Naa àgge Aji Sax ji sama bàkkaar.»","poem":1},{"lineBreak":true},{"text":"Yaw nga baal ma peyug tooñ. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nii la, kuy aji gëm di ñaane,","poem":1},{"lineBreak":true},{"text":"bu ñaan jotee.","poem":1},{"lineBreak":true},{"text":"Mbënn mu baawaan, di wal sax,","poem":1},{"lineBreak":true},{"text":"du ko laal fenn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaw laay làqoo,","poem":1},{"lineBreak":true},{"text":"nga di ma aar ciw ay,","poem":1},{"lineBreak":true},{"text":"may ma ba ñi ma wër, di ko bége. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nga ne ma: «Dama laa xelal,","poem":1},{"lineBreak":true},{"text":"xamal la fi ngay jaar,","poem":1},{"lineBreak":true},{"text":"digal la, di la bàyyi xel.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buleen mel ni fas mbaa berkelle","poem":1},{"lineBreak":true},{"text":"mi amul ag dégg,","poem":1},{"lineBreak":true},{"text":"laab ak tarka di ko téye,","poem":1},{"lineBreak":true},{"text":"mu doora yem fi seen wet.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ku bon barew tiis.","poem":1},{"lineBreak":true},{"text":"Ku wóolu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"mu yiire la ngoram.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yaw aji jub ji, bégal te bànneexoo Aji Sax ji.","poem":1},{"lineBreak":true},{"text":"Képp kuy def njub, sarxolleel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}