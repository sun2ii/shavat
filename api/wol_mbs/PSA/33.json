{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":33,"content":[{"type":"heading","content":["Nan woy Boroom bi nu sàkk"]},{"type":"verse","number":1,"content":[{"text":"Yeen aji jub ñi, sarxolleleen ci Aji Sax ji;","poem":1},{"lineBreak":true},{"text":"kuy jubal, màggal war na la.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xalamleen, sante Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"xalamalleen ko xalamu fukki buum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fentalleen ko woy,","poem":1},{"lineBreak":true},{"text":"xalam, mu neex, sarxolle jib.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax jee jub kàddu.","poem":1},{"lineBreak":true},{"text":"Mooy jëfe lépp kóllëre.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moo bëgg dëgg ak yoon.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, ngoram a fees àddina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kàddug Aji Sax ji la asamaan sosoo,","poem":1},{"lineBreak":true},{"text":"ci baatam la gàngoori asamaan yépp sàkkoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moo boole ndoxi géej, jal,","poem":1},{"lineBreak":true},{"text":"yeb xóotey géej ciy mbànd.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeen waa àddina sépp, ragalleen Aji Sax ji;","poem":1},{"lineBreak":true},{"text":"yeen àddina wërngal këpp, wormaalleen ko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moo àddu, mu am;","poem":1},{"lineBreak":true},{"text":"santaane, mu sotti.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aji Sax jeey neenal li xeet yiy fexe,","poem":1},{"lineBreak":true},{"text":"di gàntal li mbooloo yiy mébét;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aji Sax ji nas, mu àntu ba fàww,","poem":1},{"lineBreak":true},{"text":"mu mébét, mu sottil maasoo maas.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ndokkalee yeen xeet wi Aji Sax ji di seen Yàlla,","poem":1},{"lineBreak":true},{"text":"yeen askan wi Aji Sax ji séddoo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asamaan la Aji Sax jiy jéere,","poem":1},{"lineBreak":true},{"text":"di gis doom aadama yépp.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Jal ba mu tooge","poem":1},{"lineBreak":true},{"text":"lay niire waa àddina sépp.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Moo tabax seen xol, ñoom ñépp;","poem":1},{"lineBreak":true},{"text":"lu ñu def, xam na ko.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mbooloo mu réy mayul Buur ndam,","poem":1},{"lineBreak":true},{"text":"doole ju bare walluwul jàmbaar.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yaakaar aw fas nax sa bopp la,","poem":1},{"lineBreak":true},{"text":"kàttanu fas dug wall.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma ne, Aji Sax jee naa jàkk ku ko ragal","poem":1},{"lineBreak":true},{"text":"tey wéeroo ngoram.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Day bakkanam,","poem":1},{"lineBreak":true},{"text":"di ko dundal cib xiif.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nu ngi séentu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"moo nuy taxawu, di nu feg.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ci moom la sunu xol di sedde,","poem":1},{"lineBreak":true},{"text":"turam wu sell lanu wóolu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aji Sax ji, ngalla baaxe nu sa ngor,","poem":1},{"lineBreak":true},{"text":"moom lanu yaakaar fi yaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}