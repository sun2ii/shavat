{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":34,"content":[{"type":"heading","content":["Aji Sax ji du tanqamlu aji jub"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda. Mooy ba muy wayadi-wayadilu ca kanam Buur Abimeleg, ba Abimeleg dàq ko, mu dem","descriptive":true},{"noteId":7},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Naa màggal Aji Sax ji saa su ne,","poem":1},{"lineBreak":true},{"text":"di ko sant fu ma tollu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji laay sagoo,","poem":1},{"lineBreak":true},{"text":"néew-ji-doole dégg, bég.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kañleen Aji Sax ji, ànd ceek man,","poem":1},{"lineBreak":true},{"text":"nu bokk wormaal turam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maa topp Aji Sax ji, mu nangul ma,","poem":1},{"lineBreak":true},{"text":"tàggale maak lépp lu ma ragal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ku yaakaar Aji Sax ji bég, leer nàññ,","poem":1},{"lineBreak":true},{"text":"gàcce du ko sëlëm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Néew-ji-doole woote, Aji Sax ji wuyu,","poem":1},{"lineBreak":true},{"text":"musal ko fu mu jàqe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ku ragal Aji Sax ji, malaakaam yiir la,","poem":1},{"lineBreak":true},{"text":"di la wallu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mosleen, xam ne Aji Sax jee baax,","poem":1},{"lineBreak":true},{"text":"ndokkalee yaw mi ko làqoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ragalleen Aji Sax ji, yeen nitam ñu sell ñi;","poem":1},{"lineBreak":true},{"text":"ku ko ragal doo ñàkk dara.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gaynde man naa ndóol, xiif,","poem":1},{"lineBreak":true},{"text":"nit kiy jaamu Aji Sax ji ñàkkul lenn lu baax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dikkal doom, déglu ma,","poem":1},{"lineBreak":true},{"text":"ma jàngal la ni ñuy ragale Aji Sax ji.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ana ku dund neex,","poem":1},{"lineBreak":true},{"text":"mu bëgga fekke bés bu rafet, ba gis ngëneel?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Na làmmiñam daw lu aay,","poem":1},{"lineBreak":true},{"text":"dawi fen.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Na dëddu lu bon tey def lu baax,","poem":1},{"lineBreak":true},{"text":"sàkku jàmm, saxoo ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ay gët la Aji Sax ji ne jàkk aji jub ñi,","poem":1},{"lineBreak":true},{"text":"te ay noppam la dékk seeni woote wall.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aji Sax jeey won gannaaw ñiy def lu bon,","poem":1},{"lineBreak":true},{"text":"ngir dagge leen kaw suuf, far seeni tur.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ñi jub yuuxu, Aji Sax ji dégg,","poem":1},{"lineBreak":true},{"text":"fu ñu jàqe, mu musal leen.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Seen yaakaar tas, Aji Sax ji jege leen,","poem":1},{"lineBreak":true},{"text":"seen xol jeex, Aji Sax ji wallu leen.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Musiba bare naa dal ku jub,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji musal ko ci lépp,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"di ko sàmm,","poem":1},{"lineBreak":true},{"text":"ba benn yaxam du damm.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Musiba nag day rey ku bon,","poem":1},{"lineBreak":true},{"text":"te ku bañ aji jub, yoon dab na la.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aji Sax jeey musal ab jaamam,","poem":1},{"lineBreak":true},{"text":"képp ku ko làqoo, yoon du la dab.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"34.1 Seetal ci 1.Samiyel 21.11-16. Akis buurub Gaat mooy Abimeleg ba tey.","reference":{"chapter":34,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":23}