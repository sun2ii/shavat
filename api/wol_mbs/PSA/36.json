{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":36,"content":[{"type":"heading","content":["Nit ñaaw, Aji Sax ji gore"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ñeel Daawuda jaamub Aji Sax ji.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kàddug tooñ ga ku bon wax mu ngi ci sama xel mi.","poem":1},{"lineBreak":true},{"text":"Mu ne: «Ana lu may ragal ci Yàlla?»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Day gis boppam, naagu,","poem":1},{"lineBreak":true},{"text":"ba du gis sikkam, sib ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ay waxam coxor aki fen,","poem":1},{"lineBreak":true},{"text":"jëfeetul lu rafet ak lu baax.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Day mébét lu ñaaw cib lalam,","poem":1},{"lineBreak":true},{"text":"taxawe yoon wu dëddu mbaax,","poem":1},{"lineBreak":true},{"text":"te du bañ lu bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Céy Aji Sax ji, gore nga ba kaw asamaan,","poem":1},{"lineBreak":true},{"text":"dëggu ba ci kaw-li-kaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sa njubtee tiim tund yu mag yi,","poem":1},{"lineBreak":true},{"text":"sa àtte ne xéew ni xóotey géej.","poem":1},{"lineBreak":true},{"text":"Céy Aji Sax ji, nit ak mala, nga boole sàmm!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Céy Yàlla, yaa wéet ngor,","poem":1},{"lineBreak":true},{"text":"doom aadama yiiroo sa keppaar, yiiru;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"yafloo sa njël lu duun,","poem":1},{"lineBreak":true},{"text":"sa xéewal wal, nga nàndale ko.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ci yaw la dund di balle,","poem":1},{"lineBreak":true},{"text":"te sag leer lanuy leerloo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jotaleel sa ngor ku la xam,","poem":1},{"lineBreak":true},{"text":"jotale sa njubte kuy nas njub.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàlla bu ma ku reew teg tànk;","poem":1},{"lineBreak":true},{"text":"loxo ku bon, yàlla bumu ma taxa daw.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Defkati mbon yaa ngii, daanu,","poem":1},{"lineBreak":true},{"text":"ne lareet, tëlee jóg.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}