{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":37,"content":[{"type":"heading","content":["Bu sa xol jóg"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Bu sa xol jóg ci ku bon,","poem":1},{"lineBreak":true},{"text":"bul ñee kuy def njombe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Léegi mu wow nim ñax,","poem":1},{"lineBreak":true},{"text":"lax ni gàncax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dénkul ci Aji Sax ji, di def lu baax,","poem":1},{"lineBreak":true},{"text":"ba des ci réew meek jàmm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Deel bànneexoo Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"mu may la say nammeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jébbalul ci Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"dénku ci moom, mooy sottal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Day setal sab der ni jant bu fenk;","poem":1},{"lineBreak":true},{"text":"sab àtte ne ràññ ni njolloor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Neel tekk, xaar Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"yaakaar ko.","poem":1},{"lineBreak":true},{"text":"Bu sa xol jóg ci kuy baaxle","poem":1},{"lineBreak":true},{"text":"tey lal ay pexe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Baal mer, dëddu xadar.","poem":1},{"lineBreak":true},{"text":"Xol bu jóg, loraangey neen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ku bon, ñu dagg, sànni;","poem":1},{"lineBreak":true},{"text":"ku yaakaar Aji Sax ji, jagoo réew mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nes tuut, ku bon ne mes,","poem":1},{"lineBreak":true},{"text":"nga seet, seet, mu réer.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waaye néew-dooleey jagoo réew mi;","poem":1},{"lineBreak":true},{"text":"jàmm ne ñoyy, ñu bége.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ku bon fexeel ku jub,","poem":1},{"lineBreak":true},{"text":"di ko màttu,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Buur Yàlla di ko ree,","poem":1},{"lineBreak":true},{"text":"xam ne bésam a ngi ñëw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ku bon bocci saamar,","poem":1},{"lineBreak":true},{"text":"tàwwig fitt,","poem":1},{"lineBreak":true},{"text":"nara rey ku ñàkk, néewle,","poem":1},{"lineBreak":true},{"text":"nara bóom kuy jubal;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"far jam boppam saamaru xol,","poem":1},{"lineBreak":true},{"text":"fittam damm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aji jub, as tuutam","poem":1},{"lineBreak":true},{"text":"moo gën koomu ku bon.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ku bon kat, sa doole dëddu la;","poem":1},{"lineBreak":true},{"text":"ku jub, Aji Sax ji wallu la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ku màndu, Aji Sax ji yég la,","poem":1},{"lineBreak":true},{"text":"sab cér sax.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bu mettee doo rus,","poem":1},{"lineBreak":true},{"text":"te bésub xiif dangay regg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ku bon sànku;","poem":1},{"lineBreak":true},{"text":"noonub Aji Sax ji, taaru tool bu naat la,","poem":1},{"lineBreak":true},{"text":"bu tàkkee, jeex tàkk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku bon leb, du fey;","poem":1},{"lineBreak":true},{"text":"ku jub yéwén, di joxe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aji Sax ji barkeel la, nga jagoo réew mi moos;","poem":1},{"lineBreak":true},{"text":"mu alag la, nga dog.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bu Aji Sax ji rafetloo saw yoon,","poem":1},{"lineBreak":true},{"text":"mooy jiite say jéego.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Soo tërëfee it, doo daanu.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee lay walloo loxoom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ba may ndaw, ba tey may mag,","poem":1},{"lineBreak":true},{"text":"gisuma ku jub ñàkk ndimbal,","poem":1},{"lineBreak":true},{"text":"mbaa askanam di dunde yalwaan.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Day saxoo tabe, di leble,","poem":1},{"lineBreak":true},{"text":"askanam barkeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Dëddul mbon, di jëfe mbaax,","poem":1},{"lineBreak":true},{"text":"ba dëkke réew mi fàww.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Aji Sax ji kat dafa jiital yoon,","poem":1},{"lineBreak":true},{"text":"te du wacc jaamam bu gore.","poem":1},{"lineBreak":true},{"text":"Day fegu ba fàww;","poem":1},{"lineBreak":true},{"text":"askanu ku bon dog.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Aji jub ay jagoo réew mi,","poem":1},{"lineBreak":true},{"text":"dëkke ko ba fàww.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kàddug aji jub day xelu,","poem":1},{"lineBreak":true},{"text":"wax ja jub;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"yoonu Yàllaam a nga ca xol ba,","poem":1},{"lineBreak":true},{"text":"du dox ba tërëf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ku bon a ngi yeeru ku jub,","poem":1},{"lineBreak":true},{"text":"di ko wuta bóom.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Waaye Aji Sax ji du ko bàyyeek moom,","poem":1},{"lineBreak":true},{"text":"te deesu ko daan cib layoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Yaakaaral Aji Sax ji, sàmm yoonam,","poem":1},{"lineBreak":true},{"text":"mu teral la, nga jagoo réew mi,","poem":1},{"lineBreak":true},{"text":"ku bon sànku, ngay gis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Damaa gis ku bon di noote,","poem":1},{"lineBreak":true},{"text":"te sëq ni garab gu naat fa mu fekk baax,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ma jaareeti fa, ndeke wuute na,","poem":1},{"lineBreak":true},{"text":"ma seet ko, gisuma ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Bàyyil xel ku màndu, xool ku jub;","poem":1},{"lineBreak":true},{"text":"muj, fa nitu jàmm.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Moykat yeey sànkoondoo,","poem":1},{"lineBreak":true},{"text":"ku bon amul muj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Aji Sax jeey musal ku jub,","poem":1},{"lineBreak":true},{"text":"di ko aar bésub njàqare.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Aji Sax jee koy taxawu, wallu ko,","poem":1},{"lineBreak":true},{"text":"wallu ko ci ku bon, musal ko,","poem":1},{"lineBreak":true},{"text":"ndax li mu ko làqoo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}