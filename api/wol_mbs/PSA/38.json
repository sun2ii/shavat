{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":38,"content":[{"type":"heading","content":["Maa wopp, tuub, di jooy"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant buy fàttalee, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, bul mer, di ma rëbb;","poem":1},{"lineBreak":true},{"text":"bul xadaru, di ma mbugal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji, fitt nga maa fitt,","poem":1},{"lineBreak":true},{"text":"dóor nga ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Danga maa mere, ma wéradi;","poem":1},{"lineBreak":true},{"text":"maa bàkkaar, ba jagadi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Samay ñaawtéef mëdd ma,","poem":1},{"lineBreak":true},{"text":"diisa diis, ba àttanuma ko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa defug ndof,","poem":1},{"lineBreak":true},{"text":"ba am dana yu bédd, ba xasaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Maa ngi sëgg, ne yàcc, ne yasar,","poem":1},{"lineBreak":true},{"text":"di wéye tiis,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"yaram tàng, di bax,","poem":1},{"lineBreak":true},{"text":"ma wéradi, ne làcc.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sama yaram dee goyy, ma ne lasar,","poem":1},{"lineBreak":true},{"text":"jàq, di binni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Boroom bi, yaa ngi ne jàkk ci samay nammeel,","poem":1},{"lineBreak":true},{"text":"samay onk umpu la.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sama fit a ngi tëf-tëfi, doole ŋiis,","poem":1},{"lineBreak":true},{"text":"gët giim.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Samay dana tax xarit ak dëkkandoo di ma daw,","poem":1},{"lineBreak":true},{"text":"mbokk dànd ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñi may wuta rey a ngi may fiir,","poem":1},{"lineBreak":true},{"text":"di ma jéema lor, di ma waxal musiba,","poem":1},{"lineBreak":true},{"text":"yendu maa lalal pexe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Man, ma mel nib tëx, dégguma,","poem":1},{"lineBreak":true},{"text":"mel ni luu, àdduwuma,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"di saf ku dul dégg,","poem":1},{"lineBreak":true},{"text":"bay layoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Aji Sax ji, yaw laa yaakaar;","poem":1},{"lineBreak":true},{"text":"Boroom bi, sama Yàlla, yaa may nangul.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma ne, ngalla buñu ma ree,","poem":1},{"lineBreak":true},{"text":"di damoo samab jéll.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Maa ngii di waaja daanu,","poem":1},{"lineBreak":true},{"text":"dëkke mitit.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma ne, aylayéwén def naa lu ñaaw,","poem":1},{"lineBreak":true},{"text":"sama bàkkaar tiital na ma.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Noon yaa ngi ne jonn ak seen doole,","poem":1},{"lineBreak":true},{"text":"bare na ñu ma bañ ci neen.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma ji leen njekk, ñu fey ma njekkar;","poem":1},{"lineBreak":true},{"text":"may sàkku lu baax, ñu di ma sikk.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji sama Yàlla, bu ma wacc,","poem":1},{"lineBreak":true},{"text":"bu ma sore.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ngalla gaawe ma;","poem":1},{"lineBreak":true},{"text":"Boroom bi, yaa may musal.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}