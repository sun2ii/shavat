{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":39,"content":[{"type":"heading","content":["Dund yàggul"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci Yedutun, njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dama noon: «Damay moyu ba duma moye làmmiñ.»","poem":1},{"lineBreak":true},{"text":"Li feek ku bon di teew,","poem":1},{"lineBreak":true},{"text":"may ŋalaab sama gémmiñ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dama noon cell, ne patt,","poem":1},{"lineBreak":true},{"text":"noppi, ba mu ëpp;","poem":1},{"lineBreak":true},{"text":"sama njàqare yokku,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"sama xol diis,","poem":1},{"lineBreak":true},{"text":"xel di xelaat, xol diis gann;","poem":1},{"lineBreak":true},{"text":"ma mujj àddu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ne: «Éy Aji Sax ji, xamal ma sama muj","poem":1},{"lineBreak":true},{"text":"ak sama àppi fan,","poem":1},{"lineBreak":true},{"text":"ma xam ni sama dund gàtte.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaatuwaayu loxo nga ma àppal ciy fan,","poem":1},{"lineBreak":true},{"text":"sama giiru dund du dara fi yaw.","poem":1},{"lineBreak":true},{"text":"Képp ku taxaw di cóolóolu neen. Selaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nit du lu moy takkndeer buy dem,","poem":1},{"lineBreak":true},{"text":"cóolóolu neen lay kër-këri.","poem":1},{"lineBreak":true},{"text":"Nit a ngi dajale, xamul kuy for.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Éy Boroom bi, lu may xaarati?","poem":1},{"lineBreak":true},{"text":"Sama yaakaar yaw a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Musal ma ci sama mbugali tooñoo tooñ,","poem":1},{"lineBreak":true},{"text":"bu ma bàyyi, dof di ma reetaan!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Noppi naa, dootuma wax,","poem":1},{"lineBreak":true},{"text":"yaw yaa dogal lii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waaye ngalla teggil sab yar,","poem":1},{"lineBreak":true},{"text":"sa diisaayu loxoo ngi may jekkali.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yaay mbugal ku bàkkaar, yar ko,","poem":1},{"lineBreak":true},{"text":"ronq la mu gëna fonk, ni max.","poem":1},{"lineBreak":true},{"text":"Nitoo nit, cóolóolu neen. Selaw.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, déglul, ma ñaan la,","poem":1},{"lineBreak":true},{"text":"teewlul, ma woo la wall;","poem":1},{"lineBreak":true},{"text":"bul tanqamlu sama yuux,","poem":1},{"lineBreak":true},{"text":"doxandéem doŋŋ laa fi yaw,","poem":1},{"lineBreak":true},{"text":"di gan ni maam yépp.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ngalla xiddi ma, ma muuñ,","poem":1},{"lineBreak":true},{"text":"bala maa dëddu, réer.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}