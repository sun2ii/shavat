{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":4,"content":[{"type":"heading","content":["Ma yendoo ñaan"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki xalam, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, yaw mi may àtte dëgg,","poem":1},{"lineBreak":true},{"text":"maa ngi woote, wuyu ma;","poem":1},{"lineBreak":true},{"text":"maa xatoon, nga yaatal ma.","poem":1},{"lineBreak":true},{"text":"Ngalla baaxe ma, nangul ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yeen boroom daraja yi,","poem":1},{"lineBreak":true},{"text":"buleen yàqati sama der,","poem":1},{"lineBreak":true},{"text":"buleen sopp caaxaan, di sos. Selaw.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xamleen ne Aji Sax ji day séddoo ku ko ragal,","poem":1},{"lineBreak":true},{"text":"te bu ma woowee Aji Sax ji, mu dégg.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Loxleen te baña bàkkaar,","poem":1},{"lineBreak":true},{"text":"waxtaanleen ak seen ngegenaay te noppi. Selaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rendileen seen sarax yi war,","poem":1},{"lineBreak":true},{"text":"te wóolu Aji Sax ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bare na ñu naan: «Ana ku nuy won lu baax?»","poem":1},{"lineBreak":true},{"text":"Éy Aji Sax ji, baaxe nu saw yiw!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"May nga ma bànneexu xol","poem":1},{"lineBreak":true},{"text":"bu raw seen pepp mu tuurook biiñ bu wal.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Jàmm laay tëdde, nelaw,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, yaw doŋŋ yaa may dëël fu wóor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}