{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":41,"content":[{"type":"heading","content":["Jarag bu ñu toŋal a ngi ñaan"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndokkalee yaw mi yég néew-ji-doole.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee lay xettali, bésub njàqare.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax jee lay aar, di sàmm sa bakkan,","poem":1},{"lineBreak":true},{"text":"nga jagoo barke ci réew mi,","poem":1},{"lineBreak":true},{"text":"te du la bàyyi noon def la lu ko neex.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax jee lay dooleel soo woppee,","poem":1},{"lineBreak":true},{"text":"di soppi bu baax sa tëraay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dama ne: «Aji Sax ji, tooñ naa la;","poem":1},{"lineBreak":true},{"text":"baaxe ma, faj ma.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Noon yaa ngi may yéene lu bon,","poem":1},{"lineBreak":true},{"text":"naan: «Xanaa kii du dee, ba ñu fàtte ko?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ku dikk, di ma seet, di jinigal","poem":1},{"lineBreak":true},{"text":"tey fenti sos ci xolam,","poem":1},{"lineBreak":true},{"text":"bu génnee, tasaare ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bañ yépp a ngi may déeyoo,","poem":1},{"lineBreak":true},{"text":"di ma fexeel lu bon,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"naan: «Musiba dal na ko, du jógati!»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sama am-di-jàmm bu ma wóolu sax jógal na ma,","poem":1},{"lineBreak":true},{"text":"te daan lekk samaw ñam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Waaye ngalla Aji Sax ji, baaxe ma,","poem":1},{"lineBreak":true},{"text":"yékkati ma, ma fey leen.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Su noon damuwul ci sama kaw,","poem":1},{"lineBreak":true},{"text":"ma doora xam ne bége nga ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Man, damaa màndu, nga taxawu ma,","poem":1},{"lineBreak":true},{"text":"dëj ma fi sa kanam ba fàww.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Cant ñeel na Aji Sax ji Yàllay Israayil.","poem":1},{"lineBreak":true},{"text":"Moo masa yelloo cant ba fàww.","poem":1},{"lineBreak":true},{"text":"Amiin, Amiin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}