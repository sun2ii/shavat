{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":42,"content":[{"type":"heading","content":["Maa namm Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu yeete bu ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yaw Yàlla, ni kéwél di sàkkoo walum ndox,","poem":1},{"lineBreak":true},{"text":"maa la koy sàkkoo xol.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maa mar Yàlla,","poem":1},{"lineBreak":true},{"text":"Yàlla jiy dund!","poem":1},{"lineBreak":true},{"text":"Kañ laay teewi fa kanam Yàlla?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rongooñ laay dunde","poem":1},{"lineBreak":true},{"text":"guddeek bëccëg,","poem":1},{"lineBreak":true},{"text":"noon yi di ma dëkke naa:","poem":1},{"lineBreak":true},{"text":"«Ana sa Yàlla ji?»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lii laay fàttaliku, sama xol jeex:","poem":1},{"lineBreak":true},{"text":"dama daan jàll, jiite mbooloo ma,","poem":1},{"lineBreak":true},{"text":"jëm kër Yàlla ga, di sarxolleeka sant,","poem":1},{"lineBreak":true},{"text":"ñu booloo di màggal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo man, lu may xàddi, ne yogg?","poem":1},{"lineBreak":true},{"text":"Lu may jàq nii?","poem":1},{"lineBreak":true},{"text":"Tee maa yaakaar Yàlla, ba santati ko,","poem":1},{"lineBreak":true},{"text":"moom sama Yàlla mi may wallu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maa ngi ne yogg,","poem":1},{"lineBreak":true},{"text":"ba di la fàttalikoo fa réewum Yurdan","poem":1},{"lineBreak":true},{"text":"ak tundi Ermon ak Miccar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sa wal ya sotti, xóote awu moroom ma;","poem":1},{"lineBreak":true},{"text":"say wal ak say gannax, lépp a jaare sama kaw.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bëccëg Aji Sax ji baaxe ma ngoram,","poem":1},{"lineBreak":true},{"text":"guddi ma fanaane koo woy,","poem":1},{"lineBreak":true},{"text":"di ñaan Yàlla mi may dundal.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naa wax Yàlla sama cëslaay, ne ko:","poem":1},{"lineBreak":true},{"text":"«Lu tax nga fàtte ma,","poem":1},{"lineBreak":true},{"text":"noon di ma fitnaal,","poem":1},{"lineBreak":true},{"text":"may wéye tiis?»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Noon yaa ngi may ñaawal,","poem":1},{"lineBreak":true},{"text":"di ma yendoo naa:","poem":1},{"lineBreak":true},{"text":"«Ana sa Yàlla ji?»","poem":1},{"lineBreak":true},{"text":"Ma ne yàcc, ne yasar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moo man, lu may xàddi, ne yogg?","poem":1},{"lineBreak":true},{"text":"Lu may jàq nii?","poem":1},{"lineBreak":true},{"text":"Tee maa yaakaar Yàlla, ba santati ko,","poem":1},{"lineBreak":true},{"text":"moom sama Yàlla mi may wallu?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":12}