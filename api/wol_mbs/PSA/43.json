{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":43,"content":[{"type":"heading","content":["Éy Yàlla, àtte ma"]},{"type":"verse","number":1,"content":[{"text":"Éy Yàlla, àtte ma,","poem":1},{"lineBreak":true},{"text":"layool maak xeet wu gorewul,","poem":1},{"lineBreak":true},{"text":"xettali maak ku njublaŋ te dëng.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaw Yàlla kat yaay sama rawtu.","poem":1},{"lineBreak":true},{"text":"Lu tax nga wacc ma,","poem":1},{"lineBreak":true},{"text":"may wéye tiis,","poem":1},{"lineBreak":true},{"text":"ci nooteelu noon?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ngalla yónneel sag leer ak sa dëgg,","poem":1},{"lineBreak":true},{"text":"yal na ma yooyu jiite,","poem":1},{"lineBreak":true},{"text":"yóbbu ma sa tund wu sell,","poem":1},{"lineBreak":true},{"text":"sa màkkaan ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kon Yàlla, naa àgg ca sa sarxalukaay;","poem":1},{"lineBreak":true},{"text":"yaw Yàlla, yaay sama mbégte, di sama bànneex.","poem":1},{"lineBreak":true},{"text":"Yaw Yàlla, sama Yàlla,","poem":1},{"lineBreak":true},{"text":"naa la màggale xalam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moo man, lu may xàddi, ne yogg?","poem":1},{"lineBreak":true},{"text":"Lu may jàq nii?","poem":1},{"lineBreak":true},{"text":"Tee maa yaakaar Yàlla, ba santati ko,","poem":1},{"lineBreak":true},{"text":"moom sama Yàlla mi may wallu?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}