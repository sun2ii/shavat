{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":44,"content":[{"type":"heading","content":["Xeet waa ngi jooy"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu yeete bu ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, noo déggal sunu bopp,","poem":1},{"lineBreak":true},{"text":"sunuy maam a nu wax","poem":1},{"lineBreak":true},{"text":"jëf ja nga jëf ca seeni jant,","poem":1},{"lineBreak":true},{"text":"bu yàgga yàgg.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaw ci sa bopp yaa dàq xeet yi,","poem":1},{"lineBreak":true},{"text":"jëmbat fa maam ya;","poem":1},{"lineBreak":true},{"text":"yaa mbugal xeet yi,","poem":1},{"lineBreak":true},{"text":"ñoom, nga yiwi leen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Du seen saamar lañu nangoo réew mi moos,","poem":1},{"lineBreak":true},{"text":"seen dooley bopp it mayu leen ndam.","poem":1},{"lineBreak":true},{"text":"Yaa ko defe kàttan ak doole,","poem":1},{"lineBreak":true},{"text":"geesoo leen sa leeru kanam,","poem":1},{"lineBreak":true},{"text":"ngir sa cofeel ci ñoom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaay kiy sama buur, di sama Yàlla,","poem":1},{"lineBreak":true},{"text":"mayal askanu Yanqóoba ay ndam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw lanuy dàqe bañ yi,","poem":1},{"lineBreak":true},{"text":"sa tur lanuy dëggaatee ñi nu song.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Du fitt laa wóolu,","poem":1},{"lineBreak":true},{"text":"du saamar a may may ndam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaa nuy musal ci bañ yi,","poem":1},{"lineBreak":true},{"text":"yaay gàcceel noon ñi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yàlla lanuy damoo bésoo bés,","poem":1},{"lineBreak":true},{"text":"di màggal turam ba fàww. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waaye danga noo wacc,","poem":1},{"lineBreak":true},{"text":"toroxal nu,","poem":1},{"lineBreak":true},{"text":"ba àndulook sunu mboolooy xare.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waññi nga nu, nu won noon yi gannaaw,","poem":1},{"lineBreak":true},{"text":"ñu bañ nu, ba futti nu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ni gàtt yu ñuy yàpp, ni nga nu joxee,","poem":1},{"lineBreak":true},{"text":"tasaare nu ci biir xeet yi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Jaay nga sa mbooloo ci dara,","poem":1},{"lineBreak":true},{"text":"te jariñu la tus.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tax nga sunuy dëkk di nu ree,","poem":1},{"lineBreak":true},{"text":"ñi nu séq di nu kókkaleeka ñaawal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tax nga xeet yi di nu léeboo,","poem":1},{"lineBreak":true},{"text":"jàmbur yaa ngi nuy wëcc bopp!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Damaa dëkke gàcce,","poem":1},{"lineBreak":true},{"text":"sëlmoo kersa","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ndax kókkali yeek xastey nit","poem":1},{"lineBreak":true},{"text":"ñi ma bañ, di feyoonteek man.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lii lépp dal na nu,","poem":1},{"lineBreak":true},{"text":"te fàttewunu la, fecciwunu la kóllëre.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dëdduwunu la,","poem":1},{"lineBreak":true},{"text":"waccunu saw yoon,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"teewul nga noot nu, wacce nu xaj ya,","poem":1},{"lineBreak":true},{"text":"këpp nu lëndëmu dee.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Su nu la fàtte woon yaw, sunu Yàlla,","poem":1},{"lineBreak":true},{"text":"ba tàllal tuuri doxandéem yi loxo,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"du la ump, yaw Yàlla,","poem":1},{"lineBreak":true},{"text":"mi xam kumpay xol.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yaa tax ñu yendu noo bóom,","poem":1},{"lineBreak":true},{"text":"dees noo jàppe ni xar yu ñuy tër.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Éy Aji Sax ji, jógal! Looy nelaw?","poem":1},{"lineBreak":true},{"text":"Yewwul, bu nu wacc ba fàww.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Loo nu làqe saw yiw,","poem":1},{"lineBreak":true},{"text":"di fàtte sunu njàqareek sunu coono?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nu ngi ne ñàyy ci pënd bi,","poem":1},{"lineBreak":true},{"text":"di watat koll fi suuf.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Wallusi nu, jot nu ngir sa ngor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":27}