{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":45,"content":[{"type":"heading","content":["Buur a ngi séetal"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bu ñuy wax Tóor-tóor, ñeel askanu Kore wu góor, dib taalifu yeete, te di woyu mbëggeel.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Woy wu neex a fees sama xol,","poem":1},{"lineBreak":true},{"text":"may taalifal Buur,","poem":1},{"lineBreak":true},{"text":"sama làmmiñ ni xalimag bindkatu ndaanaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaa gëna góorayiwe ci àddina,","poem":1},{"lineBreak":true},{"text":"sa kàddu diw yiw,","poem":1},{"lineBreak":true},{"text":"ndax Yàllaa la barkeel ba fàww!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jàmbaaroo, takkal sa saamar,","poem":1},{"lineBreak":true},{"text":"te yànj, am daraja;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ànd ak daraja, dawal ba am ndam,","poem":1},{"lineBreak":true},{"text":"di dawal dëgg ak yërmande ji war,","poem":1},{"lineBreak":true},{"text":"ba mana def ay jaloore.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw Buur, say fitt a ñaw,","poem":1},{"lineBreak":true},{"text":"di jam say noon ci xol,","poem":1},{"lineBreak":true},{"text":"ay xeet daanu, nga tiim.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaw Yàlla, sab jal a sax dàkk ba fàww.","poem":1},{"lineBreak":true},{"text":"sa yetu buur njub la,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"yaa sopp dëgg, bañ lu bon,","poem":1},{"lineBreak":true},{"text":"ba Yàlla, sa Yàlla diwe la diwu mbég,","poem":1},{"lineBreak":true},{"text":"nga tiim say moroom:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"sa yére yépp di gilli ndàbbu miir, ak alowes akum kanel,","poem":1},{"lineBreak":true},{"text":"ñu di la bégale xalam,","poem":1},{"lineBreak":true},{"text":"ca sa biir kër yu yànj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ay doomi buur a ngi ci jigéen ñi nga teral,","poem":1},{"lineBreak":true},{"text":"sab lingeer féete la ndijoor,","poem":1},{"lineBreak":true},{"text":"takkoo ngëneelu wurus.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Janq doom, gisal, déglul te teewlu ma,","poem":1},{"lineBreak":true},{"text":"fàtteel say bokk, fàtte sa kër baay,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Buur xemmeme la sab taar;","poem":1},{"lineBreak":true},{"text":"mooy sab sang, wormaal ko.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Waa Tir a lay yótsiy may,","poem":1},{"lineBreak":true},{"text":"ay boroom alal di wut lu la neex.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Séetu Buur duggsi na, ne ràññ,","poem":1},{"lineBreak":true},{"text":"sol mbubb mu wurus way tàkk.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ñu yóbbul ko Buur, mu ne boyy,","poem":1},{"lineBreak":true},{"text":"janq ja ànd ak moom, diy toppam, ñu indil leen Buur,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ñu duggsi kër buur,","poem":1},{"lineBreak":true},{"text":"ci biir mbégteek bànneex.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yaw Buur, yal na la sa doom yu góor wuutu ci seen jalu maam,","poem":1},{"lineBreak":true},{"text":"nga def leeni kàngam ci réew mi mépp.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Maa lay joobe ba sa tur du fey mukk,","poem":1},{"lineBreak":true},{"text":"xeet yi saxoo laa sant ba fàww.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":18}