{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":46,"content":[{"type":"heading","content":["Aji Sax jee ànd ak man"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, di woy wu ñeel askanu Kore wu góor, dëppook galan bu ñuy wax Baatu jigéen.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sunu Yàllaa nuy rawale, di nu dooleel,","poem":1},{"lineBreak":true},{"text":"di nu wallu fu nu jaaxlee,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ba dunu tiit suuf su yëngu sax,","poem":1},{"lineBreak":true},{"text":"ba tund yiy tàbbi biir géej,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mbaa gannax yuy riir, di fuur","poem":1},{"lineBreak":true},{"text":"aka fuddu bay gësëm tund yi. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ag dex a ngi defi wal, di bànneexal dëkku Yàlla,","poem":1},{"lineBreak":true},{"text":"sellaayu màkkaanu Aji Kawe ji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yàllaa ngi ci biir dëkk bi, du raf;","poem":1},{"lineBreak":true},{"text":"Yàllaa koy dimbali ba jant fenkee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ay giir a riir, ay réew yëngu;","poem":1},{"lineBreak":true},{"text":"mu àddu, suuf seey!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yee ànd ak nun,","poem":1},{"lineBreak":true},{"text":"Yàllay Yanqóoba jee nuy rawale. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dikkleen gis jaloorey Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"ak yàqute gi mu dogal ci kaw suuf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mu ngi fey xare ci àddina sépp,","poem":1},{"lineBreak":true},{"text":"dog fitt, damm xeej, lakk pakk.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mu ne: «Dalleen te xam ne maay Yàlla,","poem":1},{"lineBreak":true},{"text":"màgg ci biir xeet yi, màgg fi kaw suuf.»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yee ànd ak nun,","poem":1},{"lineBreak":true},{"text":"Yàllay Yanqóoba jee nuy rawale. Selaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":12}