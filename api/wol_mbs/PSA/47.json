{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":47,"content":[{"type":"heading","content":["Yàllaay Buur"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Na xeetoo xeet tàccu,","poem":1},{"lineBreak":true},{"text":"xaacu, sarxolleel Yàlla!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji, Aji Kawe jee jara ragal,","poem":1},{"lineBreak":true},{"text":"mooy buur bu mag bi tiim àddina sépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Moo nu nangulal xeet yi,","poem":1},{"lineBreak":true},{"text":"nu teg tànk gàngoor yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moo nu tànnal céru suuf,","poem":1},{"lineBreak":true},{"text":"muy sagu askanu Yanqóoba wii mu sopp. Selaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yàllaa yéeg, kàddu riir.","poem":1},{"lineBreak":true},{"text":"Aji Sax jee yéeg, bufta","poem":1},{"noteId":8},{"text":"jolli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Woyleen Yàlla, woyleen,","poem":1},{"lineBreak":true},{"text":"woyleen Yàlla sunu buur, woyleen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yàllaay buuru àddina sépp;","poem":1},{"lineBreak":true},{"text":"taalifleen, woy ko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yàllaa di buuru xeet yi,","poem":1},{"lineBreak":true},{"text":"Yàllaa tooge jalam bu sell.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kàngami xeet yeey daje,","poem":1},{"lineBreak":true},{"text":"ànd ak ñoñi Yàllay Ibraayma;","poem":1},{"lineBreak":true},{"text":"Yàllaa moom buur yi yiir àddina,","poem":1},{"lineBreak":true},{"text":"te moo kawee kawe.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"47.6 bufta, ab béjjénu kuuy la, bu ñu bënn ñaari wet yi, ngir man cee wal.","reference":{"chapter":47,"verse":6}}]},"thisChapterLink":"/api/wol_mbs/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}