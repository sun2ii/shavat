{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":48,"content":[{"type":"heading","content":["Aji Sax ji aar na Siyoŋ"]},{"type":"verse","number":1,"content":[{"text":"Di woyu cant, ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aji Sax jee màgg, jara màggal a màggal","poem":1},{"lineBreak":true},{"text":"ca sunu biir dëkku Yàlla, kaw tundam wu sell.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jekk taxawaayee tundu Siyoŋ, catu bëj-gànnaar,","poem":1},{"lineBreak":true},{"text":"dëkku Buur bu mag bi,","poem":1},{"lineBreak":true},{"text":"di mbégtem àddina sépp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yàllaa wone kaaraangeem","poem":1},{"lineBreak":true},{"text":"ca biir tatay dëkk ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Buur yaa ngoog daje,","poem":1},{"lineBreak":true},{"text":"àndandoo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nun noo gis, jommi,","poem":1},{"lineBreak":true},{"text":"tiit, fëx,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ne fay pat-pati,","poem":1},{"lineBreak":true},{"text":"jàq ni kuy matu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ngelawal penku, moom ngay tase","poem":1},{"lineBreak":true},{"text":"gaal gu mag.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"La nu déggoon de lanu gis","poem":1},{"lineBreak":true},{"text":"ca dëkkub Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"sunu dëkku Yàlla ba.","poem":1},{"lineBreak":true},{"text":"Yàllaa koy dëgëral ba fàww. Selaw.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Céy Yàlla, nu ngi sa biir kër,","poem":1},{"lineBreak":true},{"text":"di xalaat sa ngor.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Céy Yàlla, sa tur ay sa woy","poem":1},{"lineBreak":true},{"text":"ba ca cati àddina.","poem":1},{"lineBreak":true},{"text":"Njubte la sa loxo fees.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yal na waa tundu Siyoŋ bég,","poem":1},{"lineBreak":true},{"text":"waa Yuda bànneexoo say àtte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Doxleen biir Siyoŋ, wër ko,","poem":1},{"lineBreak":true},{"text":"waññleen ay sooroori tataam,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nemmikuy tataam,","poem":1},{"lineBreak":true},{"text":"doxantoo këri buur,","poem":1},{"lineBreak":true},{"text":"ba man koo yegge maasug ëllëg,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ne leen kii ay Yàlla, sunu Yàlla,","poem":1},{"lineBreak":true},{"text":"tey ak ëllëg.","poem":1},{"lineBreak":true},{"text":"Moo nuy jiite ba saa taxaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}