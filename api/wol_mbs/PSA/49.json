{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":49,"content":[{"type":"heading","content":["Alal day naxe"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yeen, xeetoo xeet, dégluleen;","poem":1},{"lineBreak":true},{"text":"yeen, waa àddina yépp, teewluleen,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ngay ku tuut di ku mag,","poem":1},{"lineBreak":true},{"text":"nga bareleek nga néewle.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li may wax xel la,","poem":1},{"lineBreak":true},{"text":"di xalaat yu déggu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Damay teewlu kàddu yu xelu,","poem":1},{"lineBreak":true},{"text":"xalamal la sama tekkiteb cax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ana lu may tiit bés yu metti,","poem":1},{"lineBreak":true},{"text":"yu ma njublaŋ yéewe seeni ñaawtéef,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"di ñu wóolu seen am-am,","poem":1},{"lineBreak":true},{"text":"di kañoo alal ju bare?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ana ku mana jot a jot sa bakkanu moroom,","poem":1},{"lineBreak":true},{"text":"mbaa mu di ko feyal Yàlla njot ga?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Njotug bakkan jafe na,","poem":1},{"lineBreak":true},{"text":"bu ci jéem dara.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ana kuy dund ba fàww,","poem":1},{"lineBreak":true},{"text":"ba doo gis bàmmeel?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xanaa gis ngeen ne xelu, dee;","poem":1},{"lineBreak":true},{"text":"dof, dee; naataxóona it faatu rekk,","poem":1},{"lineBreak":true},{"text":"wacce keneen alalam.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sa bàmmeel di sa kër ba fàww,","poem":1},{"lineBreak":true},{"text":"di sa dëkkuwaay bu sax dàkk,","poem":1},{"lineBreak":true},{"text":"boo tudde woon sa bopp ay suuf sax.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nit ak darajaam fanaanul,","poem":1},{"lineBreak":true},{"text":"mook aw rab a yem, sànku rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nii la ku wóolu boppam di mujje,","poem":1},{"lineBreak":true},{"text":"mook ku ko topp, di safooy waxam. Selaw.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nara dee rekk niy xar,","poem":1},{"lineBreak":true},{"text":"dee wommat, yóbbu,","poem":1},{"lineBreak":true},{"text":"njub fenk nib jant, ku jub moom leen,","poem":1},{"lineBreak":true},{"text":"njaniiw mëdd seen jëmm,","poem":1},{"lineBreak":true},{"text":"fu sore kërug daraja.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Waaye Yàllaa may musal ci dooley njaniiw,","poem":1},{"lineBreak":true},{"text":"jot sama bakkan, ba jël ma. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Buleen yéemu ci ku barele,","poem":1},{"lineBreak":true},{"text":"teraangay këram di yokku.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Du dee ba yóbbaale dara,","poem":1},{"lineBreak":true},{"text":"teraangaam du ko topp biir bàmmeel.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Na bége bànneexu bakkanam,","poem":1},{"lineBreak":true},{"text":"ñu di ko kañe koomam,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ba tey, day dee, fekkiy maamam,","poem":1},{"lineBreak":true},{"text":"ña dootul gisug leer ba fàww.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nit ak darajaam te amul dégg,","poem":1},{"lineBreak":true},{"text":"mook aw rab a yem, sànku rekk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":21}