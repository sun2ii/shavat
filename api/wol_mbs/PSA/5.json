{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":5,"content":[{"type":"heading","content":["Ma njëlu di ñaan"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki toxoro, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, maa ngi àddu, déglu ma,","poem":1},{"lineBreak":true},{"text":"maa ngi onk, teewlu ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sama Buur, sama Yàlla, déglul, ma ne wallóoy!","poem":1},{"lineBreak":true},{"text":"Yaw laay ñaan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji, ag suba, ngay dégg sama baat,","poem":1},{"lineBreak":true},{"text":"suba su ne ma diis la samay dagaan,","poem":1},{"lineBreak":true},{"text":"di séentu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Doo Yàlla ju safoo coxor,","poem":1},{"lineBreak":true},{"text":"yaw lu bon du la daloo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ku réy du taxaw fi sa kanam,","poem":1},{"lineBreak":true},{"text":"kuy def lu ñaaw, bañ nga ko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaay sànk kuy fen,","poem":1},{"lineBreak":true},{"text":"seexlu kuy bóomeek kuy wore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Man nag, sa ngor lu yaa laa saña dugge sa kër,","poem":1},{"lineBreak":true},{"text":"sujjóotal sa béreb bu sell, wormaale la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, wommate ma sa yoonu njub ndaxi noon,","poem":1},{"lineBreak":true},{"text":"te xàllal ma saw yoon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ñii, li ñu wax, wérul,","poem":1},{"lineBreak":true},{"text":"seen xol a mébét njekkar,","poem":1},{"lineBreak":true},{"text":"seenug bóli di bàmmeel bu ne ŋàpp,","poem":1},{"lineBreak":true},{"text":"ñuy naxe làmmiñ wu neex.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Éy Yàlla, topp leen,","poem":1},{"lineBreak":true},{"text":"ñu fakkastaloo seeni pexe;","poem":1},{"lineBreak":true},{"text":"xalabal ñooñu barey moy,","poem":1},{"lineBreak":true},{"text":"ñoo la gàntal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Képp ku la làqoo, yal na bég,","poem":1},{"lineBreak":true},{"text":"di saxoo sarxolle, nga di ko yiir,","poem":1},{"lineBreak":true},{"text":"te ku la sopp di la bége.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aji Sax ji yaw kat, yaay barkeel ku jub,","poem":1},{"lineBreak":true},{"text":"yiire ko saw yiw, fege ko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}