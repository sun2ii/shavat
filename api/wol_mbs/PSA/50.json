{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":50,"content":[{"type":"heading","content":["Aji Sax ji xol lay gërëm"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Asaf.","descriptive":true},{"lineBreak":true},{"text":"Yàlla, Aji Sax ji Yàlla àddu na,","poem":1},{"lineBreak":true},{"text":"di woo àddina, penku ba sowu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ca Siyoŋ, dëkk ba ca taar ba","poem":1},{"lineBreak":true},{"text":"la Yàlla feeñe ni leer gu jolli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sunu Yàllaa ngi ñëw te du ne cell,","poem":1},{"lineBreak":true},{"text":"sawaraa ko jiitu, di xoyome,","poem":1},{"lineBreak":true},{"text":"ngëlén lu mag wër ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma ngay woo seede asamaan ak suuf,","poem":1},{"lineBreak":true},{"text":"ngir àtte ñoñam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mu ne: «Dajaleel ma sama wóllëre","poem":1},{"text":"yiy sarxal, di ko fasee sama kóllëreek ñoom.»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asamaan a ngi biral àtteb Yàlla,","poem":1},{"lineBreak":true},{"text":"ndaxte mooy Kiy àtte. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Yeen sama ñoñ, dégluleen, ma wax leen;","poem":1},{"lineBreak":true},{"text":"yeen waa Israayil, ma sikk leen.","poem":1},{"lineBreak":true},{"text":"Maa di Yàlla, seen Yàlla.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Du seeni sarax laa leen di sikke,","poem":1},{"lineBreak":true},{"text":"mbaa seen saraxi rendi-dóomal yi sax fi sama kanam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Soxlawuma yëkku yar ak sikketu gétt.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maay boroom raboo rabu àll,","poem":1},{"lineBreak":true},{"text":"ak junniy nag yuy fore tund ya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xam naa njanaawi tund yi,","poem":1},{"lineBreak":true},{"text":"luy ag jur ci tool yi maa ko moom.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Su ma xiifoon, duma leen ko wax,","poem":1},{"lineBreak":true},{"text":"maa moom àddinaak li ci biiram.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndax damay lekk yàppu nag","poem":1},{"lineBreak":true},{"text":"aka naan deretu sikket?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Deel jaajëfal Yàlla, sarxale ko,","poem":1},{"lineBreak":true},{"text":"di fey Aji Kawe ji loo dige,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"di ma woo bésub njàqare,","poem":1},{"lineBreak":true},{"text":"ma wallu la, nga màggal ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ñu bon ñi, Yàlla ne leen:","poem":1},{"lineBreak":true},{"text":"«Lu ngeen di tari sama dogali yoon,","poem":1},{"lineBreak":true},{"text":"di waxe sama kóllëre?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yeena ngii, bañ sama yar,","poem":1},{"lineBreak":true},{"text":"xalab samay kàddu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fu ngeen gisub sàcc, neexook moom,","poem":1},{"lineBreak":true},{"text":"ab njaalookat, ngeen lëngool.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dangeena afal seen gémmiñ ci mbon,","poem":1},{"lineBreak":true},{"text":"seen làmmiñ taqoo fen,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ngeen di tooge seen mbokk,","poem":1},{"lineBreak":true},{"text":"di yàq deru doomu ndey.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lii yeena ko def! Damay noppi,","poem":1},{"lineBreak":true},{"text":"ngeen defe ne damaa mel ni yeen?","poem":1},{"lineBreak":true},{"text":"Dama leen di sikk, tuumaal leen, ngeen gis!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Yeen fàttekati Yàlla yi, déggleen lii,","poem":1},{"lineBreak":true},{"text":"bala maa xotat te kenn du wallu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ki may sarxale jaajëf moo ma teral;","poem":1},{"lineBreak":true},{"text":"ku topp yoon, ma won ko wallub Yàlla.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}