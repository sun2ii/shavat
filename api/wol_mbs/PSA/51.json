{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":51,"content":[{"type":"heading","content":["Yàlla, yërëm ma"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiitu woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mooy ba ko Yonent Yàlla Natan seetsee, gannaaw ba Daawuda tëddee ndaw sa ñuy wax Batseba","descriptive":true},{"noteId":9},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Éy Yàlla, ni nga goree, baaxe ma ni,","poem":1},{"lineBreak":true},{"text":"faral samag tooñ ngir sa yërmande ju yaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fóotal maa fóotal sama ñaawtéef,","poem":1},{"lineBreak":true},{"text":"raxasal ma sama moy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xam naa ne maa tooñ,","poem":1},{"lineBreak":true},{"text":"sama moy a ngi janook man saa su ne.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw laa moy, yaw doŋŋ.","poem":1},{"lineBreak":true},{"text":"Li nga ñaawlu laa def.","poem":1},{"lineBreak":true},{"text":"Kon boo waxee, am dëgg,","poem":1},{"lineBreak":true},{"text":"te soo àttee, yey.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñaawtéef daal laa judduwaale,","poem":1},{"lineBreak":true},{"text":"te sama ndey ëmbaale ma bàkkaar.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dëgg daal nga namm, dëggu reenu xol,","poem":1},{"lineBreak":true},{"text":"kon déey ma fa xel mu rafet.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wis ma ndox, ma sell;","poem":1},{"lineBreak":true},{"text":"sang ma, ma set wecc.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yal nanga ma dégtal mbég ak bànneex,","poem":1},{"lineBreak":true},{"text":"ma bégati, gannaaw ba nga ma dammatee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bul xool samay moy,","poem":1},{"lineBreak":true},{"text":"faral sama ñaawtéef yépp.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Éy Yàlla, sàkkal ma xol bu sell,","poem":1},{"lineBreak":true},{"text":"yeesalal ma pastéefu xol.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bu ma xalab,","poem":1},{"lineBreak":true},{"text":"bu ma xañ sa noo gu sell.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"May ma, ma bégeeti sag wall,","poem":1},{"lineBreak":true},{"text":"te dundale ma xol bu tàlli,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ma xamal tooñkat sa yoon wi nga tëral,","poem":1},{"lineBreak":true},{"text":"ba moykat dellu ci yaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Céy Yàlla, yaw Yàlla mi may musal,","poem":1},{"lineBreak":true},{"text":"baal ma deret ji ma tuur,","poem":1},{"lineBreak":true},{"text":"ma sarxolle sa njubte.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Boroom bi, may ma, ma wax,","poem":1},{"lineBreak":true},{"text":"ma delloo la njukkal.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sàkkuwuloo sarax, nde kon ma indi;","poem":1},{"lineBreak":true},{"text":"te soppuloo saraxu rendi-dóomal.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Saraxi Yàlla, xol bu tuub la,","poem":1},{"lineBreak":true},{"text":"yaw Yàlla, xol bu tuub ba mokk, doo gàntal boroom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngalla baaxeel Siyoŋ,","poem":1},{"lineBreak":true},{"text":"yal nanga tabax tatay Yerusalem.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Su boobaa nga nangu sarax yi war,","poem":1},{"lineBreak":true},{"text":"di saraxu rendi-dóomal.","poem":1},{"lineBreak":true},{"text":"Su boobaa ñu rendi ay yëkk ca sa sarxalukaay.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"51.2 Seetal ci 2.Samiyel 11.1—12.25.","reference":{"chapter":51,"verse":2}}]},"thisChapterLink":"/api/wol_mbs/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":21}