{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":52,"content":[{"type":"heading","content":["Yàllaa man boroom doole"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu yeete bu ñeel Daawuda.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mooy ba Doweg, Edomeen ba, demee ca Sawul, ne ko Daawuda dem na kër Aximeleg","descriptive":true},{"noteId":10},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Moo! Jàmbaar ji, looy damoo jëfi coxor?","poem":1},{"lineBreak":true},{"text":"Yàlla, ngoram, bés bu nekk la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ak sa làmmiñ wi ngay sose loraange,","poem":1},{"lineBreak":true},{"text":"mel ni saatu su ñu xacc,","poem":1},{"lineBreak":true},{"text":"rambaaj bi!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lu bon a la gënal lu baax,","poem":1},{"lineBreak":true},{"text":"fen a la gënal wax dëgg. Selaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaa bëgg jépp wax juy yàq,","poem":1},{"lineBreak":true},{"text":"waabajiiba bi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yàlla da lay sànk ba fàww,","poem":1},{"lineBreak":true},{"text":"fëkke la sab xayma, yóbbu,","poem":1},{"lineBreak":true},{"text":"déjjatee la réewum aji dund. Selaw.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji jub gis ko, yéemu,","poem":1},{"lineBreak":true},{"text":"di la ree, naa:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Xoolleen jàmbaar ji làqoowul Yàlla,","poem":1},{"lineBreak":true},{"text":"xanaa di yaakaar alalam ju bare,","poem":1},{"lineBreak":true},{"text":"di yokkoo loraange.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Man, ma mel ni garabu oliw gu naat","poem":1},{"text":"fa biir kër Yàlla,","poem":2},{"text":"di wóoloo Yàlla ngoram tey ak ëllëg.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naa la sante sa jëf ba fàww,","poem":1},{"lineBreak":true},{"text":"naa biral sa tur wu baax,","poem":1},{"lineBreak":true},{"text":"say wóllëre teew.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"52.2 Seetal ci 1.Samiyel saar 21—22.","reference":{"chapter":52,"verse":2}}]},"thisChapterLink":"/api/wol_mbs/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}