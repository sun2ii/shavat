{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":53,"content":[{"type":"heading","content":["Mbon maase na"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bu ñuy wax Maxalat, dib taalifu yeete bu ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ab dof a nga naa ca xelam:","poem":1},{"lineBreak":true},{"text":"«Yàlla amul,»","poem":1},{"lineBreak":true},{"text":"Ñu ni mel ay def njekkar,","poem":1},{"lineBreak":true},{"text":"seeni jëf siblu,","poem":1},{"lineBreak":true},{"text":"kenn defu ci lu baax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yàllaa tollu asamaan, jéer doom aadama,","poem":1},{"lineBreak":true},{"text":"di seet ku ci xelu, tey wut Yàlla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ñépp a dëddu,","poem":1},{"lineBreak":true},{"text":"bokk yàqu yaxeet.","poem":1},{"lineBreak":true},{"text":"Kenn deful lu baax,","poem":1},{"lineBreak":true},{"text":"du kenn sax.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yàlla nee: «Xanaa ñiy def lu bon, xamuñu dara?","poem":1},{"lineBreak":true},{"text":"Ñuy lekk sama ñoñ niw ñam,","poem":1},{"lineBreak":true},{"text":"te wutuñu Yàlla.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waaye ñooy tiit a tiit","poem":1},{"lineBreak":true},{"text":"fu tiitaange amul.","poem":1},{"lineBreak":true},{"text":"Yàllaay tasaare néewi nit ñi la gaw.","poem":1},{"lineBreak":true},{"text":"Yàllaa leen wacc, nga gàcceel leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ana kuy tollu Siyoŋ, xettali Israayil?","poem":1},{"lineBreak":true},{"text":"Éy, bés bu Yàlla tijjee wërsëgu ñoñam,","poem":1},{"lineBreak":true},{"text":"ndaw mbégte ci giirug Yanqóoba!","poem":1},{"lineBreak":true},{"text":"Ndaw bànneex laa ne, ci Israayil gii!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}