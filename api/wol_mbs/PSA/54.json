{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":54,"content":[{"type":"heading","content":["Yàlla, dimbali ma"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki xalam, dib taalifu yeete bu ñeel Daawuda.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mooy ba waa Sif demee ca Sawul, ne ko Daawudaa nga làqu ca seenum réew","descriptive":true},{"noteId":11},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Éy Yàlla, musal ma ngir sa tur,","poem":1},{"lineBreak":true},{"text":"jox ma dëgg, ci sa kàttan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Éy Yàlla, déglul, ma ñaan,","poem":1},{"lineBreak":true},{"text":"teewlul, ma wax la.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ay doxandéem a ma jógal,","poem":1},{"lineBreak":true},{"text":"di ñu néeg, bëgga jël sama bakkan,","poem":1},{"lineBreak":true},{"text":"te seetuñu ci Yàlla. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yàllaa ngii, moo may dimbali;","poem":1},{"lineBreak":true},{"text":"Boroom bee yor sama bakkan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yal na ay wi këppu ci ñi may tëru,","poem":1},{"lineBreak":true},{"text":"yal na leen sa dëgg sànk.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xol bu tàlli laa lay sarxale.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, yaa baax, ma sant la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lépp luy njàqare, yaa ma ci jële,","poem":1},{"lineBreak":true},{"text":"ma tiim samay noon.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"54.2 Seetal ci 1.Samiyel 23.14-28; 26.1-5.","reference":{"chapter":54,"verse":2}}]},"thisChapterLink":"/api/wol_mbs/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}