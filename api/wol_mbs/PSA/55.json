{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":55,"content":[{"type":"heading","content":["Xarit wor na ma"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki xalam, dib taalifu yeete, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, déglul, ma ñaan la,","poem":1},{"lineBreak":true},{"text":"bul làqu, dama lay dagaan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teewlu ma, nangul ma.","poem":1},{"lineBreak":true},{"text":"Li may tawat a ma xañ jàmm, ub sama bopp;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"coowal noon yee","poem":1},{"lineBreak":true},{"text":"ak coonob ñu bon ñi.","poem":1},{"lineBreak":true},{"text":"Dañu maa teg fitna,","poem":1},{"lineBreak":true},{"text":"di ma songe xadar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sama fit a ngi rëcc, di tëf-tëfi;","poem":1},{"lineBreak":true},{"text":"tiitaangey dee ne ma taral.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Njàqaree ma dugg, may kat-kati,","poem":1},{"lineBreak":true},{"text":"musiba mëdd ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dama ne: «Éy ku may may laafi xati,","poem":1},{"lineBreak":true},{"text":"ma ne fërr, noppaluji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xanaa ma naaw, ba sore,","poem":1},{"lineBreak":true},{"text":"fanaani màndiŋ ma. Selaw.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naa gaawtu, seeluji","poem":1},{"lineBreak":true},{"text":"ngelaw lu riddi ak ngëlén.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Éy, Boroom bi, beenal seeni wax, neenal leen.","poem":1},{"lineBreak":true},{"text":"Damaa gis fitnaak xuloo ci dëkk bi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"guddeek bëccëg ñuy wër,","poem":1},{"lineBreak":true},{"text":"ñaawtéef ak ayib wéttali leen.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàq a nga ca biir,","poem":1},{"lineBreak":true},{"text":"te nooteel ak njublaŋ jógul ca pénc ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Su doon noon bu may ñaawal,","poem":1},{"lineBreak":true},{"text":"ma muñ ko,","poem":1},{"lineBreak":true},{"text":"mbaa muy bañ bu may won ab dayo,","poem":1},{"lineBreak":true},{"text":"ma daw ko.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Waaye yaw la, sama nawle,","poem":1},{"lineBreak":true},{"text":"di sama wóllëre, ma xam la.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nu daan bokk bànneexu diisoo,","poem":1},{"lineBreak":true},{"text":"ànd ak mbooloo, di jaamuji kër Yàlla ga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yal na leen dee bett,","poem":1},{"lineBreak":true},{"text":"ñu jekki tàbbi njaniiw,","poem":1},{"lineBreak":true},{"text":"ngir mbon ga ci seen biir ak seen dëkkuwaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Waaye man, Yàlla laay woo wall,","poem":1},{"lineBreak":true},{"text":"te Aji Sax jee may wallu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Subaak ngoon ak njolloor,","poem":1},{"lineBreak":true},{"text":"may ñaxtooka ñurumtu,","poem":1},{"lineBreak":true},{"text":"mu dégg ma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Moo may jot ak jàmm,","poem":1},{"lineBreak":true},{"text":"ba ma mucc ci xare ya ma ñu bare di songe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yàllaay dégg, duma leen,","poem":1},{"lineBreak":true},{"text":"moom mi nguuram yàgga sax. Selaw.","poem":1},{"lineBreak":true},{"text":"Soppikuwuñu fenn te ragaluñu Yàlla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Workat baa ngi xàcc loxoom jëme ci ñi mu takktool,","poem":1},{"lineBreak":true},{"text":"di fecci kóllëre,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"làmmiñ wa daa neex ni lem,","poem":1},{"lineBreak":true},{"text":"te xare lal xol ba;","poem":1},{"lineBreak":true},{"text":"kàddu ya gëna nooy ag oliw","poem":1},{"lineBreak":true},{"text":"te di saamar bu génn mbaram.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sippikul Aji Sax ji lu la diis,","poem":1},{"lineBreak":true},{"text":"moom moo lay taxawu.","poem":1},{"lineBreak":true},{"text":"Du bàyyi mukk aji jub, muy tërëf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Waaye yaw Yàlla, yaa leen di tàbbal,","poem":1},{"lineBreak":true},{"text":"bóomkat ak naaféq ci pax mu xóota xóot,","poem":1},{"lineBreak":true},{"text":"te seen dund xaajul.","poem":1},{"lineBreak":true},{"text":"Man nag, ma di la wóolu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":24}