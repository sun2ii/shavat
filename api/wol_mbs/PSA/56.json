{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":56,"content":[{"type":"heading","content":["Yàlla laa wóolu, ragaluma nit"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bi ñu dippee Pitax mu luu, dëkk fu sore; diy ñaan, ñeel Daawuda, ba ko Filisteen ña jàppee ca Gaat","descriptive":true},{"noteId":12},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, baaxe ma,","poem":1},{"lineBreak":true},{"text":"nit a ngi may lakkal,","poem":1},{"lineBreak":true},{"text":"ab xeexkat a ma yendoo sonal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Noon yee ma yendoo lakkal,","poem":1},{"lineBreak":true},{"text":"bare lool di xareek man.","poem":1},{"lineBreak":true},{"text":"Ku màgg ki,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"bés bu ma tiitee,","poem":1},{"lineBreak":true},{"text":"yaw laay wóolu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yàlla laay màggal kàddoom,","poem":1},{"lineBreak":true},{"text":"Yàlla laa wóolu, ragaluma.","poem":1},{"lineBreak":true},{"text":"Lu ma nit manal?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bésoo bés ñu ngi jalgati samay wax,","poem":1},{"lineBreak":true},{"text":"seen mépp mébét di sama loraange.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñu ngi mànkoo, di ma yeeru,","poem":1},{"lineBreak":true},{"text":"topp samay tànk,","poem":1},{"lineBreak":true},{"text":"di wut sama bakkan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Éy gii ñaawtéef! Ñii nu ñu mana mucce?","poem":1},{"lineBreak":true},{"text":"Éy Yàlla, yal na leen sa mer dal!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tumurànke naa, nga gis.","poem":1},{"lineBreak":true},{"text":"Duyal samay rongooñ ci sa mbuus.","poem":1},{"lineBreak":true},{"text":"Du lim nga lépp?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bés bu ma wootee wall,","poem":1},{"lineBreak":true},{"text":"dees na waññi noon yi,","poem":1},{"lineBreak":true},{"text":"ma xam ne Yàllaa ànd ak man.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yàlla laay màggal kàddoom,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji laay màggal kàddoom,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàlla laa wóolu, ragaluma.","poem":1},{"lineBreak":true},{"text":"Ana lu ma nit manal?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Éy Yàlla, maa tegoo la ma la giñal,","poem":1},{"lineBreak":true},{"text":"maa lay defal saraxi cant.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaa ma rawale, ba deewuma,","poem":1},{"lineBreak":true},{"text":"te duma tërëf.","poem":1},{"lineBreak":true},{"text":"Damay daagu fi kanam Yàlla,","poem":1},{"lineBreak":true},{"text":"ci biir leeru àddina.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"56.1 Seetal ci 1.Samiyel 21.11-16.","reference":{"chapter":56,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}