{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":57,"content":[{"type":"heading","content":["Yàlla jógal, wallu ma!"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bi ñuy woowe Bul yàq, diy ñaan, ñeel Daawuda, gannaaw ba mu dawee Buur Sawul, ba dugg ca xunt ma","descriptive":true},{"noteId":13},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, baaxe ma, ngalla baaxe ma,","poem":1},{"lineBreak":true},{"text":"fi yaw laay làqu,","poem":1},{"lineBreak":true},{"text":"yiiroo sa kiiraay,","poem":1},{"lineBreak":true},{"text":"ba musiba yi jàll.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma woo Yàlla, Aji Kawe ji,","poem":1},{"lineBreak":true},{"text":"Yàlla, mi may matalal.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mooy yónnee fa asamaan, musal ma,","poem":1},{"lineBreak":true},{"text":"dumaal ma ku may noot. Selaw.","poem":1},{"lineBreak":true},{"text":"Yàllaay yónnee jëfi ngoram ak wormaam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Maa ngi tëdd ci biiri noon","poem":1},{"lineBreak":true},{"text":"yu mel niy gaynde, di yàpp doom aadama.","poem":1},{"lineBreak":true},{"text":"Seeni sell niy xeej aki fitt,","poem":1},{"lineBreak":true},{"text":"seen làmmiñ di saamar yu ñaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Éy Yàlla, yaa màgg, ba sut asamaan,","poem":1},{"lineBreak":true},{"text":"sag leer tiim suuf sépp.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noon yi di ma fiir,","poem":1},{"lineBreak":true},{"text":"sama xol jeex.","poem":1},{"lineBreak":true},{"text":"Ñu gasal mam pax,","poem":1},{"lineBreak":true},{"text":"far tàbbi ca. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yàlla, dogu naa,","poem":1},{"lineBreak":true},{"text":"dogu naa woy, di la kañ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na sama jëmm jépp yewwu,","poem":1},{"lineBreak":true},{"text":"xalam ak moroom ma yewwu;","poem":1},{"lineBreak":true},{"text":"ma yee leeru njël.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Boroom bi, naa lay gërëm ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"kañ la ci biir waaso yi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sa ngor a màgg, ba àkki asamaan,","poem":1},{"lineBreak":true},{"text":"sa worma àkki fa kaw-a-kaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Éy Yàlla, yaa màgg, ba sut asamaan,","poem":1},{"lineBreak":true},{"text":"sag leer tiim suuf sépp.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"57.1 Seetal ci 1.Samiyel saar 24.","reference":{"chapter":57,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}