{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":58,"content":[{"type":"heading","content":["Yàllaa mana mbugal"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bi ñuy woowe Bul yàq, diy ñaan, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yeen daal, su ngeen waxee, dëgg selaw.","poem":1},{"lineBreak":true},{"text":"Mbaa yeena ngi àtte nit ñi ci yoon?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yeena ngi mébét njubadi,","poem":1},{"lineBreak":true},{"text":"di lawal fitna ci réew mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ku bon day sosu rekk, dëng;","poem":1},{"lineBreak":true},{"text":"juddu, teggi yoon, dib fen-kat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Day am daŋar ni ñàngóor,","poem":1},{"lineBreak":true},{"text":"fatti noppam ni jaan ju tëx:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"du dégg baatu jatkat,","poem":1},{"lineBreak":true},{"text":"mbaa jati ñeengokat bu ñàng.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yàlla, ngalla tojal seeni gëñ;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, foqal seen selli gaynde yii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yal nañu ne mes ni ndox muy wal,","poem":1},{"lineBreak":true},{"text":"yal nañu diir seen fitt, mu damm,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"yal nañu mel ni ngumbaan-tooye buy dox, di seey,","poem":1},{"lineBreak":true},{"text":"mbaa lumb wu jigéen tuur, gisul jant.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Balaa seen cin a yég tàngooru gajj,","poem":1},{"lineBreak":true},{"text":"muy gu tooy, muy guy boy,","poem":1},{"lineBreak":true},{"text":"yal na leen fekk sànku","poem":1},{"noteId":14},{"text":".","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Aji jub day gis ñu feyul ko, mu bég,","poem":1},{"lineBreak":true},{"text":"muy jàngoo deretu ku bon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ku ne naan: «Ku jub jot sab yool moos!","poem":1},{"lineBreak":true},{"text":"Te Yàllaa ngi fi moos, di àtte àddina!»","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"58.10 Li ñu wax fii ci làkku ebrë am na werante.","reference":{"chapter":58,"verse":10}}]},"thisChapterLink":"/api/wol_mbs/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}