{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":59,"content":[{"type":"heading","content":["Wallu maak ñu bon ñi"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bi ñuy woowe Bul yàq, diy ñaan, ñeel Daawuda. Mooy ba Buur Sawul yónnee ay nit ñu ko xoolal kër Daawuda, ngir rey ko","descriptive":true},{"noteId":15},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy sama Yàlla, xettali maak noon yi,","poem":1},{"lineBreak":true},{"text":"làq ma ñi ma jógal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xettali maak ñiiy def lu bon,","poem":1},{"lineBreak":true},{"text":"wallu maak bóomkat yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax ji, ñu ngii di ma tëru, nar maa rey,","poem":1},{"lineBreak":true},{"text":"di ma songe seen doole,","poem":1},{"lineBreak":true},{"text":"te tooñuma, moyuma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Defuma lu ñaaw, ñuy xélu, di ma waajal;","poem":1},{"lineBreak":true},{"text":"ngalla, jógal taxawusi ma, ba gis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax ji Yàllay Israayil, Yàlla Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"yewwul, dikkeel xeeti yéefar yépp, mbugal!","poem":1},{"lineBreak":true},{"text":"Workat yu bon yi, bu leen yërëm! Selaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ngoonee ñu wàccsi,","poem":1},{"lineBreak":true},{"text":"di xiiru niy xaj, di wër dëkk bi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Déglul li ñuy yebbee ci seen gémmiñ,","poem":1},{"lineBreak":true},{"text":"seen làmmiñ niy saamar,","poem":1},{"lineBreak":true},{"text":"ñu defe ne kenn déggu leen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Te yaw Aji Sax ji, yaa ngi leen di ree,","poem":1},{"lineBreak":true},{"text":"yaa ngi kekku yéefar yii yépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yaay sama doole, ma di la séentu,","poem":1},{"lineBreak":true},{"text":"yaw Yàlla, yaay sama rawtu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sama Yàlla ju goree may gatandu.","poem":1},{"lineBreak":true},{"text":"Moo may may ndam ci noon yi, ma gis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàlla, bu leen rey,","poem":1},{"lineBreak":true},{"text":"lu ko moy samaw xeet fàtte.","poem":1},{"lineBreak":true},{"text":"Tasaaree leen sa doole, daane leen.","poem":1},{"lineBreak":true},{"text":"Boroom bi, yaa nuy feg.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bàkkaar lañuy wax,","poem":1},{"lineBreak":true},{"text":"seeni kàddu, bàkkaari neen.","poem":1},{"lineBreak":true},{"text":"Yal nañu bew ba daanu,","poem":1},{"lineBreak":true},{"text":"yooloo ko seeni saagaak seeni fen.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Meral, jeexal leen,","poem":1},{"lineBreak":true},{"text":"jeexal leen, ba ñu jeex tàkk,","poem":1},{"lineBreak":true},{"text":"ba ñépp xam ne Yàllaay Buur ci giirug Yanqóoba,","poem":1},{"lineBreak":true},{"text":"ba ca cati àddina. Selaw.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bu ngoonee ñu wàccsi,","poem":1},{"lineBreak":true},{"text":"di xiiru niy xaj, di wër dëkk bi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ñuy wër di wut lu ñu lekk,","poem":1},{"lineBreak":true},{"text":"su ñu suurul, di ñurumtu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Maa lay woye sa doole,","poem":1},{"lineBreak":true},{"text":"xëy, di sarxolle ngir sa ngor.","poem":1},{"lineBreak":true},{"text":"Yaay sama rawtu,","poem":1},{"lineBreak":true},{"text":"di sama làquwaay bésub njàqare.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sama doole yaw a, naa la woy,","poem":1},{"lineBreak":true},{"text":"Yàlla, sama rawtu, Yàlla, boroom ngor.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"59.1 Seetal ci 1.Samiyel 19.11-17.","reference":{"chapter":59,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":18}