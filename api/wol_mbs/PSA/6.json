{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":6,"content":[{"type":"heading","content":["Jarag a ngi woote wall"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd ak xalamu juróom ñetti buum, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, bul mer, ba di ma rëbb,","poem":1},{"lineBreak":true},{"text":"bul xadaru, ba di ma mbugal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji, damaa néew doole, yërëm ma!","poem":1},{"lineBreak":true},{"text":"Éy Aji Sax ji, sama yaram a tas, dàmp ma!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sama xol a jeex tàkk.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, loo deeti xaar nag?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, délsil, xettali ma!","poem":1},{"lineBreak":true},{"text":"Walloo ma sa ngor.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Deesul dee ba fàttaliku la;","poem":1},{"lineBreak":true},{"text":"ku dugg njaniiw, nu mu lay sante?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Onk naa ba loof, di fanaanee jooy,","poem":1},{"lineBreak":true},{"text":"sama lal di féey,","poem":1},{"lineBreak":true},{"text":"ba far seeye rongooñ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Saay gët a ngi xóot ndaxu naqar,","poem":1},{"lineBreak":true},{"text":"boole ci giim ndax tooñi noonoo noon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yeen, defkati ñaawtéef yépp, xiddileen ma!","poem":1},{"lineBreak":true},{"text":"Aji Sax ji dégg na saay jooy,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aji Sax ji dégg na saay dagaan,","poem":1},{"lineBreak":true},{"text":"Aji Sax jii nangu na samag ñaan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Noon yépp a am gàcce, ba jàq lool,","poem":1},{"lineBreak":true},{"text":"ne wërëñ ak gàcceg mbetteel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}