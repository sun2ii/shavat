{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":60,"content":[{"type":"heading","content":["Yàllaa yor sunu mucc"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bu ñuy wax Seedeb tóor-tóor, diy ñaan, ñeel Daawuda.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mooy ba Daawuda di xareek waa Siri ña ca Mesopotami ak waa Siri ña ca Coba te ba ñu ca bàyyikoo, Yowab duma fukki junniy Edomeen ak ñaar (12 000) ca xuru Xorom wa","descriptive":true},{"noteId":16},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Éy Yàlla, wacc nga nu, bëtt sunu kiiraay.","poem":1},{"lineBreak":true},{"text":"Mer nga, waaye ngalla xettali nu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yëngal nga suuf, xar ko;","poem":1},{"lineBreak":true},{"text":"ngalla jagalal, mu tëju, mu ngi jaayu!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Won nga sa mbooloo lu metti,","poem":1},{"lineBreak":true},{"text":"nàndal nu biiñu mbugal, ba nu miir.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sampal nga ab raaya ñi lay ragal,","poem":1},{"lineBreak":true},{"text":"ngir ñu mucc ci fitt yi. Selaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Walloo nu sa ndijoor, nangul nu,","poem":1},{"lineBreak":true},{"text":"ba say soppe xettaliku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yàllaa àddoo fa këram gu sell,","poem":1},{"lineBreak":true},{"text":"ne: «Maay damu, dogat suufas Sikem,","poem":1},{"lineBreak":true},{"text":"séddale xuru Sukkót.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Maa moom diiwaanu Galàdd, moom Manase,","poem":1},{"lineBreak":true},{"text":"Efrayim di sama mbaxanam xare,","poem":1},{"lineBreak":true},{"text":"Yuda di sama yetu nguur,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"réewum Mowab di sama ndabal raxasukaay,","poem":1},{"lineBreak":true},{"text":"Edom, ma teg tànk;","poem":1},{"lineBreak":true},{"text":"Filisti, ma xaacoo fa.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Éy Yàlla, ana ku may yóbbu dëkk ba tata wër?","poem":1},{"lineBreak":true},{"text":"Ku may jiite ba Edom?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xanaa kay du yaw, Yàlla mi nu wacc,","poem":1},{"lineBreak":true},{"text":"yaw Yàlla mi baña ànd ak sunu mboolooy xare?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngalla dimbali nu ci bañaale;","poem":1},{"lineBreak":true},{"text":"doom aadama, wallam neen la.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nook Yàlla, nu def njàmbaar;","poem":1},{"lineBreak":true},{"text":"moom mooy noot sunuy noon.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"60.2 Seetal ci 2.Samiyel 8.3-14; 1.Jaar-jaar ya 18.3-13.","reference":{"chapter":60,"verse":2}}]},"thisChapterLink":"/api/wol_mbs/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":14}