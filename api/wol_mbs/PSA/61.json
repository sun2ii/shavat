{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":61,"content":[{"type":"heading","content":["Naa woote wall"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki xalam, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngalla Yàlla, déglul, maa ne wallóoy,","poem":1},{"lineBreak":true},{"text":"teewlul, ma dagaan la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àll laa lay woowe,","poem":1},{"lineBreak":true},{"text":"sama xol jeex;","poem":1},{"lineBreak":true},{"text":"yéege ma doju rawtu wu ma jotul.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaw laa làqoo,","poem":1},{"lineBreak":true},{"text":"ngay tata ju dëgër, fegal ma noon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naa dëkke sa xayma ba fàww;","poem":1},{"lineBreak":true},{"text":"làqoo sa kiiraay. Selaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yàlla, yaa dégg samay dige,","poem":1},{"lineBreak":true},{"text":"sédd ma céru ñi wormaal sa tur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngalla féqal fani Buur,","poem":1},{"lineBreak":true},{"text":"ay atam bare, sët ba sëtaat.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Éy Yàlla, yal na Buur toog ba fàww fi sa kanam,","poem":1},{"lineBreak":true},{"text":"nga sédd ko sa ngor ak sa worma, mu fegoo;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kon ma woy la ba fàww,","poem":1},{"lineBreak":true},{"text":"di jëfe samay dige bésoo bés.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}