{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":62,"content":[{"type":"heading","content":["Yaakaar, fa Yàlla"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci Yedutun, njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yàlla doŋŋ ay dalal sama xel,","poem":1},{"lineBreak":true},{"text":"moo may wallu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moom doŋŋ mooy sama wéeru-mucc,","poem":1},{"lineBreak":true},{"text":"di ma rawale, ba duma sànku!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xanaa dungeen bàyyee songandoo nit,","poem":1},{"lineBreak":true},{"text":"nar koo sànk,","poem":1},{"lineBreak":true},{"text":"ni kuy màbb tabax bu joy,","poem":1},{"lineBreak":true},{"text":"mbaa ngay bàddi per mu ràpp?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Seeni mébét, wàcce boroom daraja doŋŋ;","poem":1},{"lineBreak":true},{"text":"yeena ngi bége ay fen,","poem":1},{"lineBreak":true},{"text":"seeni kàddu diw yiw,","poem":1},{"lineBreak":true},{"text":"seen xalaat diy saaga. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yal na Yàlla doŋŋ di dalal sama xel,","poem":1},{"lineBreak":true},{"text":"moom mi ma yaakaar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moom doŋŋ a di sama wéeru-mucc,","poem":1},{"lineBreak":true},{"text":"di sama rawtu, duma tërëf.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yàllaa may musal, di ma sagal,","poem":1},{"lineBreak":true},{"text":"ma di ko doolewoo.","poem":1},{"lineBreak":true},{"text":"Sama kiiraay, Yàllaa!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bokk yi, wóoluleen ko fu ngeen tollu,","poem":1},{"lineBreak":true},{"text":"diisleen ko seen xol,","poem":1},{"lineBreak":true},{"text":"Yàllaay sunu kiiraay. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Doom aadama, ngelawal neen;","poem":1},{"lineBreak":true},{"text":"nit, naxi neen.","poem":1},{"lineBreak":true},{"text":"Booleel teg ci lu ñuy natte diisaay,","poem":1},{"lineBreak":true},{"text":"kaw la jëm.","poem":1},{"lineBreak":true},{"text":"Ñooy gëna woyof ngelaw!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bul wóolu ribaa,","poem":1},{"lineBreak":true},{"text":"bul yaakaar alalu càcc, neen la.","poem":1},{"lineBreak":true},{"text":"Bu sa alal yokku, nga taf ci sa xol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Benn yoon la Yàlla wax,","poem":1},{"lineBreak":true},{"text":"ñaari yoon laa dégg, ñu ne;","poem":1},{"lineBreak":true},{"text":"«Doole, fa Yàlla.»","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Boroom bi, ngor, yaay boroom,","poem":1},{"lineBreak":true},{"text":"yaw daal, yaay yool nit jëfam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}