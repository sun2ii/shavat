{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":63,"content":[{"type":"heading","content":["Maa namm Aji Sax ji"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Daawuda. Mooy ba mu nekkee ca màndiŋu Yuda","descriptive":true},{"noteId":17},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yaw Yàlla, yaay sama Yàlla,","poem":1},{"lineBreak":true},{"text":"ma xëy di la wër,","poem":1},{"lineBreak":true},{"text":"sama bakkan mar la,","poem":1},{"lineBreak":true},{"text":"sama jëmm namm la,","poem":1},{"lineBreak":true},{"text":"fu suuf mare ndox, ne sereŋ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moo tax kër gu sell ga laa la séentoo,","poem":1},{"lineBreak":true},{"text":"ngir niir sa doole ak sa leer.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xéewloo sa ngor moo dàq dundu bakkan;","poem":1},{"lineBreak":true},{"text":"ma àddu boog, kañ la!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dama lay sant, sama giiru dund kay,","poem":1},{"lineBreak":true},{"text":"tàllal la ay loxo, sàbbaale la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sama xol di sedd, ni ku ñam wu duun suural,","poem":1},{"lineBreak":true},{"text":"ma bég, sarxolle, màggal la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Su ma tëddee, fàttaliku la,","poem":1},{"lineBreak":true},{"text":"waxtuw guddi dama lay xalaat.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaay sama ndimbal,","poem":1},{"lineBreak":true},{"text":"may làqoo sa kiiraay,","poem":1},{"lineBreak":true},{"text":"di sarxolle.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sama xol taq la,","poem":1},{"lineBreak":true},{"text":"nga téyee ma sa ndijoor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waaye ñiy wuta faat sama bakkan","poem":1},{"lineBreak":true},{"text":"ñoo jëm xóotey njaniiw.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ñu jébbal leen ñawkay saamar,","poem":1},{"lineBreak":true},{"text":"till séddoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Buur moom, di bége Yàlla;","poem":1},{"lineBreak":true},{"text":"képp ku koy giñe di ko kañoo,","poem":1},{"lineBreak":true},{"text":"fen-kat ne xerem.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"63.1 Seetal ci 1.Samiyel 23.14; 24.2; 2.Samiyel 15.23.","reference":{"chapter":63,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}