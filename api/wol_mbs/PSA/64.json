{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":64,"content":[{"type":"heading","content":["Yàllaa man ag fitt"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, déglul sama kàddug tawat;","poem":1},{"lineBreak":true},{"text":"ngalla aaral sama bakkan ci noon bu raglu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Làq ma pexey ku bon,","poem":1},{"lineBreak":true},{"text":"ma rëcc gàngooru defkati ñaawtéef.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ñu ngi daas seen làmmiñ niy saamar,","poem":1},{"lineBreak":true},{"text":"di fitte seeni kàdduy wextan,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"di jam ku ñu tëru te deful dara;","poem":1},{"lineBreak":true},{"text":"jekki jam ko, te tiituñu ci dara.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dañoo dogu ca lu bon la ñu nar,","poem":1},{"lineBreak":true},{"text":"di diisoo na ñuy làqe ay fiir,","poem":1},{"lineBreak":true},{"text":"te naan: «Kenn du ko gis!»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dañuy lal pexem njubadi te naan:","poem":1},{"lineBreak":true},{"text":"«Lal nanu pexe mu mat sëkk.»","poem":1},{"lineBreak":true},{"text":"Nit aka xóot xel te xóoti mbóot!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waaye Yàllaa leen di jamu fittam,","poem":1},{"lineBreak":true},{"text":"ñu jekki daanu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Seen làmmiñ a leen di fakkastal,","poem":1},{"lineBreak":true},{"text":"ba ku leen xool wëcc bopp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ñépp a ciy am tiitaange,","poem":1},{"lineBreak":true},{"text":"bay siiwal la Yàlla def,","poem":1},{"lineBreak":true},{"text":"tey xalaataat jëfam jooju.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ku jub bége Aji Sax ji, làqoo ko.","poem":1},{"lineBreak":true},{"text":"Képp ku namm njub, damu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}