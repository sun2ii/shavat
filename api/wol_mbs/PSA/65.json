{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":65,"content":[{"type":"heading","content":["Yàllaay nangul suuf"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, di woyu cant, ñeel Daawuda.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, yaa jagoo cant fa Siyoŋ,","poem":1},{"lineBreak":true},{"text":"yaw lees di jëfeel ab dige.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaw miy nangug ñaan,","poem":1},{"lineBreak":true},{"text":"yaw la képp di wuyusi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Samay ñaawtéef man na ma,","poem":1},{"lineBreak":true},{"text":"waaye sunuy tooñ, yaa nu koy baal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndokkalee koo tànn, woo ko,","poem":1},{"lineBreak":true},{"text":"mu dale say ëtt,","poem":1},{"lineBreak":true},{"text":"di xéewloo sa ngëneeli kër,","poem":1},{"lineBreak":true},{"text":"ak sa sellaayu dëkkuwaay.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Defal nga nuy kéemaan,","poem":1},{"lineBreak":true},{"text":"nangug ñaan ci njekk,","poem":1},{"lineBreak":true},{"text":"yaw Yàlla mi nuy wallu,","poem":1},{"lineBreak":true},{"text":"di yaakaaru àddina wërngal këpp,","poem":1},{"lineBreak":true},{"text":"ba ca géej gu sore ga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaa dëje tund yu mag yi doole,","poem":1},{"lineBreak":true},{"text":"gañoo sa kàttan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"di dalal riirum géej aki gannaxam,","poem":1},{"lineBreak":true},{"text":"ak coowal xeet yi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ba waa cati àddina yéemoo say firnde,","poem":1},{"lineBreak":true},{"text":"waa penkook sowu di sarxolle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yaa dikke suuf am wal,","poem":1},{"lineBreak":true},{"text":"nangul koo nangul.","poem":1},{"lineBreak":true},{"text":"Dexu Yàllaa fees ndox,","poem":1},{"lineBreak":true},{"text":"ngay may nit peppam,","poem":1},{"lineBreak":true},{"text":"ni nga ko waajale suuf si,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"di suuxat ngàbb mi,","poem":1},{"lineBreak":true},{"text":"maasalee ko jal yi,","poem":1},{"lineBreak":true},{"text":"sottiy waame, mu mokk,","poem":1},{"lineBreak":true},{"text":"cax ma, nga barkeel.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yaay tëje mbeyum at mi say ngëneel,","poem":1},{"lineBreak":true},{"text":"foo jaare, xéewal walangaan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Parluy màndiŋ yaa ngi walangaan,","poem":1},{"lineBreak":true},{"text":"li wër tund yu ndaw yi di xumbéen.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Joor gaa ngi, jur gi muur,","poem":1},{"lineBreak":true},{"text":"xur yi sàngoo pepp,","poem":1},{"lineBreak":true},{"text":"lépp di xaacooka woy.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}