{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":66,"content":[{"type":"heading","content":["Yàllaay aar nitam"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, di woyu cant.","descriptive":true},{"lineBreak":true},{"text":"Yeen waa àddina sépp, sarxolleelleen Yàlla,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"woyleen màggaayu turam,","poem":1},{"lineBreak":true},{"text":"darajaalleen cantam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Neleen Yàlla: «Yaaka yéemey jaloore!","poem":1},{"lineBreak":true},{"text":"Sa doolee bare, ba say noon rasu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"àddina sépp di la sujjóotal,","poem":1},{"lineBreak":true},{"text":"di la woy, di joobe sa tur.» Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dikkleen gis li Yàlla def,","poem":1},{"lineBreak":true},{"text":"jëf la ju yéeme, ñeel doom aadama yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo soppi géej ag joor,","poem":1},{"lineBreak":true},{"text":"maam ya dox jàll.","poem":1},{"lineBreak":true},{"text":"Nanu ko bége foofa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mooy nguuroo njàmbaaram ba fàww,","poem":1},{"lineBreak":true},{"text":"di topp xeet yeek bët.","poem":1},{"lineBreak":true},{"text":"Ku koy diiŋat, yàlla boo damu! Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yeen xeet yi, santleen sunu Yàlla,","poem":1},{"lineBreak":true},{"text":"te biral cantam!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moo sàmm sunu bakkan,","poem":1},{"lineBreak":true},{"text":"te waccu nu, nu tërëf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Éy Yàlla, nattu nga nu,","poem":1},{"lineBreak":true},{"text":"xelli nu, ni ñuy xellee xaalis;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"laaw nga nu,","poem":1},{"lineBreak":true},{"text":"teg nu njàqare.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"May nga noon noot nu,","poem":1},{"lineBreak":true},{"text":"nu jaare sawara, jaarem ndox;","poem":1},{"lineBreak":true},{"text":"nga génne nu, yaatal nu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Maay duggaale sa kër ay saraxi rendi-dóomal,","poem":1},{"lineBreak":true},{"text":"defal la samay dige","poem":1}]},{"type":"verse","number":14,"content":[{"text":"yi ma waxoon ci sama gémmiñ,","poem":2},{"text":"sama làmmiñ tudd ko, ba ma jàqee.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Jurug yafal, ma defal la saraxu rendi-dóomal,","poem":1},{"lineBreak":true},{"text":"saxaar sa jollee ca kuuyu sarax ya,","poem":1},{"lineBreak":true},{"text":"ma boole ca saraxu nag ak sikket. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Képp ku ragal Yàlla dikkal, déglu,","poem":1},{"lineBreak":true},{"text":"ma limal la li mu ma defal.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Moom laa woo wall,","poem":1},{"lineBreak":true},{"text":"àddu, màggal ko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Su ma naroon ñaawtéef,","poem":1},{"lineBreak":true},{"text":"Boroom bi du ma déglu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Waaye Yàlla dégg na ma,","poem":1},{"lineBreak":true},{"text":"teewlu na samag ñaan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Cant ñeel na Yàlla,","poem":1},{"lineBreak":true},{"text":"gàntuwul samay ñaan,","poem":1},{"lineBreak":true},{"text":"xañu ma ngoram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}