{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":67,"content":[{"type":"heading","content":["Yal na nu Yàlla barkeel"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki xalam, di woyu cant.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Yàlla, yéwéne nu, barkeel nu,","poem":1},{"lineBreak":true},{"text":"te geesoo nu sa leeru kanam, Selaw.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ba ñu ràññee sa loxo fi kaw suuf,","poem":1},{"lineBreak":true},{"text":"gis sag wall fi biir xeet yépp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaw Yàlla, na la xeet yi sant,","poem":1},{"lineBreak":true},{"text":"na la xeet yépp sant.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na xeet yiy bég, di sarxolle;","poem":1},{"lineBreak":true},{"text":"loo dogalal xeet yi njub la,","poem":1},{"lineBreak":true},{"text":"te yaay wommat xeet yi ci kaw suuf. Selaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw Yàlla, na la xeet yi sant,","poem":1},{"lineBreak":true},{"text":"na la xeet yépp sant.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Suuf si nangu na,","poem":1},{"lineBreak":true},{"text":"yal na nu Yàlla sunu Yàllay barkeel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yal na nu Yàllay barkeel,","poem":1},{"lineBreak":true},{"text":"ba àddina wërngal këpp ragal ko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}