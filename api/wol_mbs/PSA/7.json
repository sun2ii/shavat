{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":7,"content":[{"type":"heading","content":["Boroom tuumaa ngi woote wall"]},{"type":"verse","number":1,"content":[{"text":"Di woyu njàmbat, ñeel Daawuda. Mu woyaloon ko Aji Sax ji ci mbirum kàddu yu tukkee woon ca Kuus, ma bokkoon ci giirug Beñamin.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, sama Yàlla, yaw laay làqoo!","poem":1},{"lineBreak":true},{"text":"Musal ma, xettali maak ñi may dàq ñépp.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lu ko moy ñu fàdd ma ni gaynde,","poem":1},{"lineBreak":true},{"text":"daggate ma te kenn du wallu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aji Sax ji sama Yàlla, ndegam maa def lii,","poem":1},{"lineBreak":true},{"text":"ndegam maa taq fenn lu ñaaw,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ndegam ku ma jàmmal laa feye aw ay,","poem":1},{"lineBreak":true},{"text":"mbaa ma dimbali ku ko noonoo te defu ko dara,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"yal na ma noon rëbb,","poem":1},{"lineBreak":true},{"text":"dab ma, dëggaate ma,","poem":1},{"lineBreak":true},{"text":"sàggi saab sag, tëral ci pëndub suuf. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aji Sax ji, meral, jóg,","poem":1},{"lineBreak":true},{"text":"dajeel maak xadaru noon yi!","poem":1},{"lineBreak":true},{"text":"Ngalla teewlu ma; yaw, yoon nga santaane.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yal na xeet yi daje, wër la,","poem":1},{"lineBreak":true},{"text":"nga délsi tiim leen fu kawe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yal na Aji Sax ji àtte xeet yi;","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, seetal ci sama njubteek sama màndute te dëggal ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yal na mbonug ku bon tees,","poem":1},{"lineBreak":true},{"text":"te nga saxal ku nekk ci dëgg.","poem":1},{"lineBreak":true},{"text":"Yaw Yàlla Boroom dëgg, yaay natt xel ak xol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sama kaaraange, fa Yàlla","poem":1},{"lineBreak":true},{"text":"miy musal boroom xol bu dëggu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yàllaay àtte dëgg.","poem":1},{"lineBreak":true},{"text":"Yàllaay rëbbe bés bu ne.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ku tuubul, Yàlla nàmm saamaram,","poem":1},{"lineBreak":true},{"text":"tàwwig fittam, diir la.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moom la waajalal ngànnaayi dee,","poem":1},{"lineBreak":true},{"text":"def ko fitt yuy boy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ku bon a ngoog, di matu doomu ñaawtéef.","poem":1},{"lineBreak":true},{"text":"Day sos njombe, di wasin njublaŋ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Am kan lay gas, ba mu xóot,","poem":1},{"lineBreak":true},{"text":"te pax ma mu gas, moo ca tàbbi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Fitnaam, këpp ci boppam;","poem":1},{"lineBreak":true},{"text":"coxoram, xàŋŋ cim kaaŋam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Naa sante Aji Sax ji njubteem,","poem":1},{"lineBreak":true},{"text":"ma woy Aji Sax jiy Aji Kawe ji.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}