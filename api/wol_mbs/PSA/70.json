{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":70,"content":[{"type":"heading","content":["Yàlla, gaawe ma"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ñeel Daawuda, di woy wuy fàttalee.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yàlla, wallu ma!","poem":1},{"lineBreak":true},{"text":"Éy Aji Sax ji, gaawe ma!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuy wut sama bakkan,","poem":1},{"lineBreak":true},{"text":"yal na rus, torox ne tott.","poem":1},{"lineBreak":true},{"text":"Kuy bége sama loraange,","poem":1},{"lineBreak":true},{"text":"yal nañu ko duma, waññi ko, mu ne yàcc.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuy ñaawalaate,","poem":1},{"lineBreak":true},{"text":"yal nañu ko toroxal, mu daw, dellu gannaaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Képp ku la wër,","poem":1},{"lineBreak":true},{"text":"yal na bég, di la bànneexoo.","poem":1},{"lineBreak":true},{"text":"Képp ku safoo sag wall,","poem":1},{"lineBreak":true},{"text":"yal na jàppoo: «Yàlla màgg na!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Man de, néew naa doole, ñàkk naa.","poem":1},{"lineBreak":true},{"text":"Éy Yàlla, gaawe ma.","poem":1},{"lineBreak":true},{"text":"Yaw yaa may wallu, xettali ma.","poem":1},{"lineBreak":true},{"text":"Éy Aji Sax ji, bu ma yeexe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}