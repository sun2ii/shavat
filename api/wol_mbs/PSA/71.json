{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":71,"content":[{"type":"heading","content":["Mag a ngi séentu Yàlla àtte ko dëgg"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax ji, yaw laa làqoo,","poem":1},{"lineBreak":true},{"text":"yàlla buma rus mukk.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xettalee ma sa àtteb dëgg, yiwi ma;","poem":1},{"lineBreak":true},{"text":"ngalla teewlu ma, te wallu ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yal nangay sama cëslaay, sama rawtu","poem":1},{"lineBreak":true},{"text":"bu may rawesi saa su ne,","poem":1},{"lineBreak":true},{"text":"te nga dogal sama mucc.","poem":1},{"lineBreak":true},{"text":"Yaay sama cëslaay, sama rawtu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Éy sama Yàlla, musal ma ci dooley ku bon","poem":1},{"lineBreak":true},{"text":"ak ab saay-saay ak ab néeg.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Boroom bi Aji Sax ji, yaw de laa yaakaar,","poem":1},{"lineBreak":true},{"text":"dale laa wóolu ba may ndaw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaw laa wéeroo ba may juddu;","poem":1},{"lineBreak":true},{"text":"yaw yaa ma roccee sama biiru ndey.","poem":1},{"lineBreak":true},{"text":"Yaa yelloo sama cant fàww.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Firndey alkànde la ma ñu bare xoole woon,","poem":1},{"lineBreak":true},{"text":"te yaw ngay sama rawtu bu wóor.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Samay kàddu sag cant la fees","poem":1},{"lineBreak":true},{"text":"ak di la saxoo darajaal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngalla bu ma wacc, mag laa;","poem":1},{"lineBreak":true},{"text":"bu ma ba fi doole jeexe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Noon yaa nga may tooge,","poem":1},{"lineBreak":true},{"text":"ñi may tëroo ngay diisoo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"naan: «Yàlla wacc na ko,","poem":1},{"lineBreak":true},{"text":"nan ko dàq, jàpp;","poem":1},{"lineBreak":true},{"text":"kenn du ko wallu.»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Éy Yàlla, bu ma sore.","poem":1},{"lineBreak":true},{"text":"Sama Yàlla, gaawe ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ñi may tuumaal,","poem":1},{"lineBreak":true},{"text":"yal nañu leen rusloo, sànk leen.","poem":1},{"lineBreak":true},{"text":"Ñi may wuta lor,","poem":1},{"lineBreak":true},{"text":"yal nañu leen gàcceel, sewal leen.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Man may saxoo yaakaar,","poem":1},{"lineBreak":true},{"text":"di la sant, di santati.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"May siiwal sa àtteb dëgg,","poem":1},{"lineBreak":true},{"text":"di yendoo waxtaane say wall,","poem":1},{"lineBreak":true},{"text":"doonte lim ba wees na ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Boroom bi Aji Sax ji, ma dikke la sag njàmbaar,","poem":1},{"lineBreak":true},{"text":"di tudd sa àtte dëgg gu wéet.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Éy Yàlla, ba may ndaw, nga ma xamal say kéemaan,","poem":1},{"lineBreak":true},{"text":"te ba tey jii maa ngi koy biral.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Éy Yàlla, bu ma bijjaawee ba weex tàll it, bu ma wacc,","poem":1},{"lineBreak":true},{"text":"ba keroog may xamal maasu tey sa doole,","poem":1},{"lineBreak":true},{"text":"xamal ñi ciy topp ñépp sag njàmbaar.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Céy Yàlla, sa àtteb dëgg àkki na fa kaw-a-kaw.","poem":1},{"lineBreak":true},{"text":"Def nga lu réy.","poem":1},{"lineBreak":true},{"text":"Yaw Yàlla, ana ku mel ni yaw?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Won nga ma ay yoon coonooki tiis,","poem":1},{"lineBreak":true},{"text":"waaye yaa may dundalaat,","poem":1},{"lineBreak":true},{"text":"ma mucc xóotey suuf.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yal nanga ma gëna sagal,","poem":1},{"lineBreak":true},{"text":"geesu, dëfal ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Man it sama Yàlla, ma xalam, sant la","poem":1},{"lineBreak":true},{"text":"ngir sa kóllëre.","poem":1},{"lineBreak":true},{"text":"Aji Sell ji séddoo Israayil,","poem":1},{"lineBreak":true},{"text":"dama lay woy aki xalam,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"sarxolle, woy la,","poem":1},{"lineBreak":true},{"text":"bége sag wall.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"May yendoo siiwal sa àtteb dëgg","poem":1},{"lineBreak":true},{"text":"nde ña ma doon wuta lor","poem":1},{"lineBreak":true},{"text":"lañu rusloo, sewal leen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}