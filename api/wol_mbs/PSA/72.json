{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":72,"content":[{"type":"heading","content":["Nu ñaanal Buur"]},{"type":"verse","number":1,"content":[{"text":"Ñeel Suleymaan.","descriptive":true},{"lineBreak":true},{"text":"Céy Yàlla, mayal Buur sa xelum àtte,","poem":1},{"lineBreak":true},{"text":"mayal doomu Buur bii sa xelum njub,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"muy àttee sa mbooloo njub,","poem":1},{"lineBreak":true},{"text":"di àttee sa néew-ji-doole ñi yoon,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tooli tund yu mag yi indil mbooloo mi jàmm,","poem":1},{"lineBreak":true},{"text":"tooli tund yu ndaw yi xéewale leen àtteb dëgg,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buur di àtte néew-ji-dooley xeet wi,","poem":1},{"lineBreak":true},{"text":"di wallu doomi néew-ji-doole","poem":1},{"lineBreak":true},{"text":"tey dëggaate kiy nennoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yal nañu la wormaal feek jant biy am,","poem":1},{"lineBreak":true},{"text":"feek weer wiy feq, sët ba sëtaat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yal na Buur di xéewalu réewam nib taw cig ruujeef,","poem":1},{"lineBreak":true},{"text":"mbaa waame wuy suuxat suuf.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Janti Buur aji jub day woomle,","poem":1},{"lineBreak":true},{"text":"te ba keroog weer wiy fey, jàmm di law,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mu yilif géej ba géej","poem":1},{"lineBreak":true},{"text":"ak dexu Efraat ba ca cati àddina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waa màndiŋ mi di ko sukkal,","poem":1},{"lineBreak":true},{"text":"ay noonam mëq suuf,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"buuri Tarsis ak dun ya","poem":1},{"lineBreak":true},{"text":"di ko indil ay galag;","poem":1},{"lineBreak":true},{"text":"buuri Seba ak Saba","poem":1},{"lineBreak":true},{"text":"di ko yótsi yóbbal,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"buuroo buur di ko sujjóotal,","poem":1},{"lineBreak":true},{"text":"xeetoo xeet di ko surgawu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mooy xettaliji aji tumurànke bu woote wall","poem":1},{"lineBreak":true},{"text":"ak aji néewle ju sësul fenn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mooy yërëm ku néewleek ku tumurànke,","poem":1},{"lineBreak":true},{"text":"di sàmm bakkanu aji tumurànke,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"boole leen jot ci nootaangeek loraange,","poem":1},{"lineBreak":true},{"text":"ngir fonk seen bakkan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yal na Buur gudd fan,","poem":1},{"lineBreak":true},{"text":"yal nañu ko may wurusu Seba.","poem":1},{"lineBreak":true},{"text":"Nañu koy ñaanal saa su ne,","poem":1},{"lineBreak":true},{"text":"di ko saxoo, mu barkeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yal na pepp ne gàññ ci réew mi,","poem":1},{"lineBreak":true},{"text":"yal na gub yay jaayu ca tund ya ni gottub Libaŋ;","poem":1},{"lineBreak":true},{"text":"dëkk yu mag yi sëqi nit ba law,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"yal na turam sax,","poem":1},{"lineBreak":true},{"text":"ba law fu jant tiim,","poem":1},{"lineBreak":true},{"text":"yal na xeet yépp barkeele ci moom,","poem":1},{"lineBreak":true},{"text":"te di ko ndokkale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Cant ñeel na Yàlla Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"Yàllay Israayil, mi wéetooy jalooreem.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cant ñeel na màggaayam, ba fàww,","poem":1},{"lineBreak":true},{"text":"yal na màggaayam dajal suuf sépp!","poem":1},{"lineBreak":true},{"text":"Amiin, Amiin!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ñaani Daawuda doomu Yese jeexe fii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}