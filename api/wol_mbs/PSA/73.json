{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":73,"content":[{"type":"heading","content":["Am Yàllaa gën"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Asaf.","descriptive":true},{"lineBreak":true},{"text":"Yàlla kay baax na ci Israayil,","poem":1},{"lineBreak":true},{"text":"baax ci ku rafet xol.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Waaye man de tuuti kon ma lajj,","poem":1},{"lineBreak":true},{"text":"tuuti ma tarxiis,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ngir maa ñee ku bew,","poem":1},{"lineBreak":true},{"text":"ndax gis mu baaxle te di ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amuñu mitit,","poem":1},{"lineBreak":true},{"text":"xanaa ne faaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Doñ-doñu nit dabu leen,","poem":1},{"lineBreak":true},{"text":"coonoy doom aadama dalu leen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moo leen taxa ràngoo reewande,","poem":1},{"lineBreak":true},{"text":"làmboo coxor.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dañoo suur ba gët suulu,","poem":1},{"lineBreak":true},{"text":"seen xalaati xel xëtt yoon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dañuy ñaawle, di wax lu bon,","poem":1},{"lineBreak":true},{"text":"di réy-réylu, boole ci kàdduy jaay-doole.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Seen ŋalŋal àkki asamaan,","poem":1},{"lineBreak":true},{"text":"làmmiñ dajal suuf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moo tax ñoñi Yàlla walbatiku ci ñoom,","poem":1},{"lineBreak":true},{"text":"di jolu seen wax nim ndox","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"te naan: «Lu ci Yàlla xam?","poem":1},{"lineBreak":true},{"text":"Ana xam-xam fa Aji Kawe ji?»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ñu bon ñaa ngoog!","poem":1},{"lineBreak":true},{"text":"Ne finaax, di gëna woomle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Man kay maa sellal ci neen,","poem":1},{"lineBreak":true},{"text":"di sàmm sama der.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bés bu ne yar dal ma,","poem":1},{"lineBreak":true},{"text":"saa yu ma xëyee, jot mbugal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Su ma noon: «Naa waxe ni ñoom,»","poem":1},{"lineBreak":true},{"text":"kon de, ma wor sa askanu mbooloo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naka laay jéema ràññee lii,","poem":1},{"lineBreak":true},{"text":"mbir mi ëlëm ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ba ma àggee sa kër gu sell ga,","poem":1},{"lineBreak":true},{"text":"laa doora gis muju ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yoonu tarxiis kay, nga leen teg,","poem":1},{"lineBreak":true},{"text":"daane leen, ñu sànku,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yàquleeka leena bett!","poem":1},{"lineBreak":true},{"text":"Musibaa leen ne fuuf, ñu ne mes!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Day mel ni gént goo yewwoo.","poem":1},{"lineBreak":true},{"text":"Céy Boroom bi, boo xippee, jëmmu gént ga soof la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naqar laa amoon,","poem":1},{"lineBreak":true},{"text":"sama xol di dagg.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Booba ngaaka laa, xawma dara;","poem":1},{"lineBreak":true},{"text":"rab laa woon fi sa kanam.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Teewul ma des ak yaw,","poem":1},{"lineBreak":true},{"text":"nga jàpp sama loxol ndijoor.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Danga maa gindee sam xel,","poem":1},{"lineBreak":true},{"text":"teg ca dalale ma sa teraanga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ana ku ma am asamaan ku la moy?","poem":1},{"lineBreak":true},{"text":"Ku ma safoo kaw suuf ku la moy?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kàttan ak pexe jeex,","poem":1},{"lineBreak":true},{"text":"Yàlla di ma dooleel,","poem":1},{"lineBreak":true},{"text":"ma séddoo ko fàww.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ku la sore kat, sànku;","poem":1},{"lineBreak":true},{"text":"képp ku la wor, nga bóom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Man de, jege Yàllaa ma gënal.","poem":1},{"lineBreak":true},{"text":"Boroom bi Aji Sax ji, yaw laa def kiiraay,","poem":1},{"lineBreak":true},{"text":"ngir siiwal sa jépp jëf.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}