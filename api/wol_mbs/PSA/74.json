{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":74,"content":[{"type":"heading","content":["Yàlla, bu la noon ree"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu yeete, ñeel Asaf.","descriptive":true},{"lineBreak":true},{"text":"Éy Yàlla, lu tax nga wacc nu fàww,","poem":1},{"lineBreak":true},{"text":"di dal ak xol bu tàng","poem":1},{"lineBreak":true},{"text":"ci sa xari parlu yii?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bàyyil xel askan wi nga jënd bu yàgg,","poem":1},{"lineBreak":true},{"text":"yaa jot gii giir, séddoo leen.","poem":1},{"lineBreak":true},{"text":"Bàyyil xel tundu Siyoŋ, fa nga dëkke woon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dikkal, xool gent bu yaa bii dul jeex,","poem":1},{"lineBreak":true},{"text":"noon yàq lépp ci biir kër gu sell gi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Say bañ xaacu nañu fa sa digg bérebu ndaje ma,","poem":1},{"lineBreak":true},{"text":"samp seen raaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sémmiñ dal, wàkku awu.","poem":1},{"lineBreak":true},{"text":"Mbete ñu xàcc sémmiñ, di gori geer,","poem":1},{"lineBreak":true},{"text":"ba lu fa doon liggéeyu yatt, tas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dañoo taal sa kër gu sell,","poem":1},{"lineBreak":true},{"text":"sa dëkkuwaayu tur lañu daaneel, ba sobeel ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñu namm noo noot ba nu nooy,","poem":1},{"lineBreak":true},{"text":"fuy bérebu ndajem Yàlla ci réew mi, ñu lakk.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sunuy takk réer na nu,","poem":1},{"lineBreak":true},{"text":"yonent amatul,","poem":1},{"lineBreak":true},{"text":"te kenn xamul fu lii di àkki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Éy Yàlla, fu reetaani noon di dakke?","poem":1},{"lineBreak":true},{"text":"Xanaa bañ yi duñu la ñàkke kersa ba fàww?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Looy téye sa loxol ndijoor?","poem":1},{"lineBreak":true},{"text":"Na sa loxo jóge sa dënn, nga buube leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yàlla, yaa masa doon sama buur,","poem":1},{"lineBreak":true},{"text":"di ma walloo ci digg réew mi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaa xàjjale géej gi ci sa doole,","poem":1},{"lineBreak":true},{"text":"toj boppi ninki-nanka ja ca ndox ma,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yaa rajaxe kaaŋi rab woowu,","poem":1},{"lineBreak":true},{"text":"leele ko rabi màndiŋ ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaa fettaxal fii bëti ndox akum wal,","poem":1},{"lineBreak":true},{"text":"ŋiisal dex yu masa wal.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yaa moom bëccëg, moom guddi,","poem":1},{"lineBreak":true},{"text":"teg fi weer week jant bi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yaa rëdd mboolem digi suuf,","poem":1},{"lineBreak":true},{"text":"sàkk noor ak nawet.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kon xoolal, Aji Sax ji, noon a ngi ree,","poem":1},{"lineBreak":true},{"text":"xeet wu amul bopp a lay sewal.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bul wacce rabu àll sam xati,","poem":1},{"lineBreak":true},{"text":"bul sàggane sa néew-doole yi mukk.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ngalla xoolal ci kóllëre gi,","poem":1},{"lineBreak":true},{"text":"fu làqu ci réew mi, fitna dale fa ba dajal.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yàlla bu néew-doole ñibbiwaale gàcce,","poem":1},{"lineBreak":true},{"text":"yal na ku ñàkk ak ku néewle di la santandoo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Éy Yàlla, jógal ñoŋal sa dëgg,","poem":1},{"lineBreak":true},{"text":"bàyyil xel dof bi la dëkkee sewal.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bul tanqamlu sa coowal noon yi,","poem":1},{"lineBreak":true},{"text":"ñii la jógal, seenum riir a ngi jolli saa su ne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":22}