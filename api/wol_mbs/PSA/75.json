{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":75,"content":[{"type":"heading","content":["Yàllaay àtte"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bi ñu dippee Bul yàq, di woyu cant, ñeel Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yàlla, nu sant la, santati la;","poem":1},{"lineBreak":true},{"text":"sa tur a ngii jege nu,","poem":1},{"lineBreak":true},{"text":"nuy siiwal say jaloore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yàlla nee: «Maay takk ab àpp,","poem":1},{"lineBreak":true},{"text":"àtte ca njub.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bu suuf di yëngu mook ñi ko dëkke ñépp,","poem":1},{"lineBreak":true},{"text":"maay kiy téye ay kenoom. Selaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dama ne ku réy: “Bul réy-réylu,”","poem":1},{"lineBreak":true},{"text":"ne ku bon: “Bul bew,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"bul bew a bew,","poem":1},{"lineBreak":true},{"text":"bay waxe reewande.”»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Du penku, du sowu,","poem":1},{"lineBreak":true},{"text":"te du màndiŋ ma la daraja di jóge.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yàllaay àtte:","poem":1},{"lineBreak":true},{"text":"kii mu detteel, kee mu kaweel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Merum Aji Sax ji dib kaas ci loxoom,","poem":1},{"lineBreak":true},{"text":"biiñu njafaan bu wex di ca fuur,","poem":1},{"lineBreak":true},{"text":"mu jol ko képp ku bon ci àddina,","poem":1},{"lineBreak":true},{"text":"mu naan ba naanaale ginjriit ga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Man may biral jëfam ba fàww.","poem":1},{"lineBreak":true},{"text":"Damay woy Yàllay Yanqóoba.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mu ne: «Jépp dooley ku bon, ma neenal;","poem":1},{"lineBreak":true},{"text":"dooley ku jub yokku.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}