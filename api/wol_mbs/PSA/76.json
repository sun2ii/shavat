{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":76,"content":[{"type":"heading","content":["Yàllaa moom xare"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd aki xalam, di woyu cant, ñeel Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yàlla siiw na fa Yuda,","poem":1},{"lineBreak":true},{"text":"aw turam màgg fa Israayil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xaymaam a nga Salem,","poem":1},{"lineBreak":true},{"text":"di xuntam ma fa Siyoŋ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa la rajaxee fitt yuy boy","poem":1},{"lineBreak":true},{"text":"ak pakk ak saamar ak ngànnaayal xare. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yàlla yaa ne ràññ te darajawu,","poem":1},{"lineBreak":true},{"text":"ba raw tundi rëbbkat yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Futtees nay boroom fit,","poem":1},{"lineBreak":true},{"text":"ñu ne nërëm, nelaw;","poem":1},{"lineBreak":true},{"text":"kuy ñeyi xare, say loxo nasax.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaw Yàllay Yanqóoba, yaa gëdd,","poem":1},{"lineBreak":true},{"text":"gawar ak fasam nelaw.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaw mii, yaa mata ragal;","poem":1},{"lineBreak":true},{"text":"boo meree, ana kuy taxaw fi sa kanam?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fa asamaan nga biraleb àtte;","poem":1},{"lineBreak":true},{"text":"suuf tiit, ne cell.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ca la Yàllay jóg, ngir àtte,","poem":1},{"lineBreak":true},{"text":"ba wallu kuy néew dooley àddina. Selaw.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Doom aadamaak xadaram rafetal sa woy;","poem":1},{"lineBreak":true},{"text":"desu xadaram, nga gañoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Seen Yàlla Aji Sax ji, digooleen ak moom","poem":1},{"lineBreak":true},{"text":"te jëfe ko.","poem":1},{"lineBreak":true},{"text":"Kee jara ragal.","poem":1},{"lineBreak":true},{"text":"Na ñi ko wër ñépp indi teraanga.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mooy sàggi sagu kilifa yi,","poem":1},{"lineBreak":true},{"text":"di tiitaangey buuri àddina.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}