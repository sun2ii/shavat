{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":77,"content":[{"type":"heading","content":["Yàllaa ngi seetaan"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci Yedutun, njiital woykat yi, dib taalifu cant, ñeel Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Naa xaacu, woo Yàlla,","poem":1},{"lineBreak":true},{"text":"sama baat fa Yàlla, ngir mu déglu ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bëccëg, ma jàq, sàkku ndimbalal Boroom bi;","poem":1},{"lineBreak":true},{"text":"guddi, ma tàllal loxo, toqiwuma.","poem":1},{"lineBreak":true},{"text":"Sama xol tëë sedd.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma bàyyi Yàlla xel, binni,","poem":1},{"lineBreak":true},{"text":"xalaat, xol jeex. Selaw.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Éy Yàlla, tere nga maa gëmm bët,","poem":1},{"lineBreak":true},{"text":"ma jaaxle ba waxatuma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"xanaa xalaat janti démb,","poem":1},{"lineBreak":true},{"text":"at ya woon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guddi may fàttaliku sama woy,","poem":1},{"lineBreak":true},{"text":"di waxtaan ak sama ngegenaay,","poem":1},{"lineBreak":true},{"text":"sama xel di jéex te naa:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Boroom bi da may gàntal ba fàww,","poem":1},{"lineBreak":true},{"text":"ba du ma baaxeeti mukk a?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xanaa daa jeexal ngor tàkk?","poem":1},{"lineBreak":true},{"text":"Am kàddoom a deñ ba fàww?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moo, mbaa du Yàlla daa fàtte ñeewante?","poem":1},{"lineBreak":true},{"text":"Am meram a tëj buntu yërmandeem?» Selaw.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma ne, sama naqar daal","poem":1},{"lineBreak":true},{"text":"mooy Aji Kawe ji daa soppi loxoom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waaye naa fàttaliku jaloorey Ki Sax rekk,","poem":1},{"lineBreak":true},{"text":"fàttaliku kéemaanam ya woon.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Naa xalaat sa bépp liggéey,","poem":1},{"lineBreak":true},{"text":"di jàngat say jëf.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Céy Yàlla, yaa sell jikko!","poem":1},{"lineBreak":true},{"text":"Jan yàllaa màgg ni Yàlla?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaa di Yàlla juy jëfi kéemaan,","poem":1},{"lineBreak":true},{"text":"yaa siiwal sa doole ci biir xeet yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kàttan nga jote sa mbooloo ma,","poem":1},{"lineBreak":true},{"text":"sëti Yanqóobaak Yuusufa. Selaw.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yàlla, ndox maa la gis,","poem":1},{"lineBreak":true},{"text":"ndox maa la gis, di lox;","poem":1},{"lineBreak":true},{"text":"xóote yaa say,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"niir ya yuri,","poem":1},{"lineBreak":true},{"text":"kàddu riire asamaan,","poem":1},{"lineBreak":true},{"text":"say fitt, fettaxandoo,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"nga dënoo biir callweer,","poem":1},{"lineBreak":true},{"text":"melax yi taal àddina,","poem":1},{"lineBreak":true},{"text":"suuf di lox, di reg-regi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Biir géej di saw yoon;","poem":1},{"lineBreak":true},{"text":"saw xàll ci digg ndox mu ne xéew,","poem":1},{"lineBreak":true},{"text":"te kenn gisul foo teg tànk!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wommat nga sa mbooloo ni ag jur,","poem":1},{"lineBreak":true},{"text":"Musaak Aaróona jiite.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}