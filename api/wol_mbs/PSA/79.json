{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":79,"content":[{"type":"heading","content":["Yàlla, feyul nu"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Asaf.","descriptive":true},{"lineBreak":true},{"text":"Céy Yàlla, yéefar yi song nañu sa moomeel,","poem":1},{"lineBreak":true},{"text":"teddadil nañu sa kër gu sell,","poem":1},{"lineBreak":true},{"text":"gental nañu Yerusalem.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Leel nañu tan yi sa néewi jaam ñi,","poem":1},{"lineBreak":true},{"text":"leel nañu rabi àll yi sa suuxi wóllëre ñooñu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ñu tuur seen deret nim ndox,","poem":1},{"lineBreak":true},{"text":"ba Yerusalem daj,","poem":1},{"lineBreak":true},{"text":"te amul kuy rob néew yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Noo ngi nii di mbalitu dëkkandoo yi;","poem":1},{"lineBreak":true},{"text":"ñu séqe nu ay kókkaleeki kekku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Céy Aji Sax ji, loo deeti xaar?","poem":1},{"lineBreak":true},{"text":"Xanaa doo nu mere ba fàww,","poem":1},{"lineBreak":true},{"text":"sa fiiraange ni sawara ci sunu kaw?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sippil sa mer yéefar yi la xamul,","poem":1},{"lineBreak":true},{"text":"ak réew yi wormaalul sa tur.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ñoo sëxëtoo giirug Yanqóoba,","poem":1},{"lineBreak":true},{"text":"gental dëkkuwaayam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bul nu topp ñaawtéef ya woon,","poem":1},{"lineBreak":true},{"text":"ngalla gaaw noo gatandoo sa yërmande.","poem":1},{"lineBreak":true},{"text":"Danu ne dàll, ba ne dett.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Éy Yàlla, yaa nuy musal, wallu nu,","poem":1},{"lineBreak":true},{"text":"ba sa seede rafet.","poem":1},{"lineBreak":true},{"text":"Xettali nu te baal nu sunuy bàkkaar,","poem":1},{"lineBreak":true},{"text":"ba sa woy rafet.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bul tax yéefar yi naa:","poem":1},{"lineBreak":true},{"text":"«Ana seen Yàlla?»","poem":1},{"lineBreak":true},{"text":"May nu, nu gis ni ngay mbugale yéefar yi,","poem":1},{"lineBreak":true},{"text":"feye leen sa deretu jaam yi tuuru.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ñi ñu jàpp, yal na seeni onk àkki fa yaw.","poem":1},{"lineBreak":true},{"text":"Ñi ci tànki dee, yal nanga leen musale sa doole ju màgg ji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Boroom bi, sewal gi la sunuy dëkkandoo sewal,","poem":1},{"lineBreak":true},{"text":"këpp leen ko juróom ñaari yoon,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"te nun ñiy sa mbooloo, di sa gétt gi ngay foral,","poem":1},{"lineBreak":true},{"text":"nu di la sant ba fàww,","poem":1},{"lineBreak":true},{"text":"di biral sa ngërëm sët ba sëtaat.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}