{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":8,"content":[{"type":"heading","content":["Aji Sax ji teral na nit"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd ak xalam gu ñuy wax gitiit","descriptive":true},{"noteId":3},{"text":", ñeel Daawuda, dib taalifu cant.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aji Sax ji sunu Boroom,","poem":1},{"lineBreak":true},{"text":"sa tur aka màgg ci kaw suuf sépp!","poem":1},{"lineBreak":true},{"text":"Sag leer tiim asamaan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Làmmiñu tuut-tànk, ba ci luy nàmp,","poem":1},{"lineBreak":true},{"text":"feeñal nga ca sa kàttan, ngir jaxase say noon,","poem":1},{"lineBreak":true},{"text":"bañaaleek feyukat ne xerem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Damay xool sa asamaan si nga móol,","poem":1},{"lineBreak":true},{"text":"ak weer week biddiiw yi nga fi teg.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moo, luy nit, ba nga di ko bàyyi xel?","poem":1},{"lineBreak":true},{"text":"Luy doom aadamaak loo koy yége?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaa ko def mu gëna suufe as lëf malaaka yi,","poem":1},{"lineBreak":true},{"text":"yaa ko kaalaa teraanga ak daraja,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"fal ko ci kaw loo bind,","poem":1},{"lineBreak":true},{"text":"jox ko lépp, mu teg tànk:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"jur gépp, gu gudd ak gu gàtt,","poem":1},{"lineBreak":true},{"text":"rabi àll it ca la,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ak njanaaw ak jën","poem":1},{"lineBreak":true},{"text":"ak luy jaare yooni géej.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aji Sax ji sunu Boroom,","poem":1},{"lineBreak":true},{"text":"sa tur aka màgg ci kaw suuf sépp!","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"8.1 gitiit tur la wu réer ci làkku ebrë. Man na doon xeetu xalam gu cosaanoo dëkk ba ñuy wax Gaat ci réewu Filisti. Man na nekk it galan bu ñu daan woye ci jamono bu ñuy witt reseñ, di ko nal.","reference":{"chapter":8,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}